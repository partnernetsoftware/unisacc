#pragma unisa use text.utf8
/* stage0 host unit: UJS-1_ship → \0asm. Product path only (.cx + prelude).
 * Build: ./unisacc.com -run ujs/product/build.cx  (-DUJS_HOST)
 * No #include. No freestanding libc stubs (would clash with cx.h).
 */
enum { TAG_I64 = 2, TAG_F64 = 3, TAG_STR = 4, TAG_LIST = 5, TAG_DICT = 6,
        HEAP0 = 4096, GBASE = 2048, SCRATCH0 = 1024,
        HOST_SCRATCH = 950000, STORE_WIN = 1015808, MEM_PAGES = 128, MAXSTRLIT = GBASE - SCRATCH0,
        PERSIST_BASE = 948976, PERSIST_STRIDE = 16 };
enum { PERSIST_SPAN = 64 * PERSIST_STRIDE };
enum { UX_BUFFER_BASE = 2097152, UX_BUFFER_SIZE = 6291456 };
enum { UX_U8 = 1, UX_U16, UX_U32, UX_F32, UX_I32, UX_F64 };

static int ux_width(int kind) {
  if (kind == UX_U8) return 1;
  if (kind == UX_U16) return 2;
  return kind == UX_F64 ? 8 : 4;
}

static const char *ux_read_names[] = {
  "", "ux_u8", "ux_u16", "ux_u32", "ux_f32", "ux_i32", "ux_f64"
};
static const char *ux_write_names[] = {
  "", "ux_u8_put", "ux_u16_put", "ux_u32_put", "ux_f32_put", "ux_i32_put", "ux_f64_put"
};
enum { PERSIST_FIT = 1 / (int)(PERSIST_BASE + PERSIST_SPAN <= HOST_SCRATCH && PERSIST_BASE > HEAP0 && PERSIST_BASE > GBASE && PERSIST_BASE + PERSIST_SPAN <= STORE_WIN) };
enum { TY_ERR = 0, TY_I64 = 1, TY_F64 = 2, TY_LIST = 3, TY_DICT = 4, TY_STR = 5, TY_FN = 7 };
enum { TY_CLOSURE_BASE = 16 };

static uint8_t  g_heap[256 * 1024];
static uint32_t g_bump;
static uint32_t g_out_ptr, g_out_len, g_meta_ptr, g_meta_len, g_err_ptr, g_err_len;
static int g_need_gpu;
static int g_need_ux;
static int g_abi_imports;
#ifdef UJS_HOST
static int g_legacy_inline;

void ujs_host_legacy_inline(int enabled) { g_legacy_inline = enabled != 0; }
#endif
static uint32_t hall(uint32_t n) {
  if (g_bump < 64) g_bump = 64;
  uint32_t p = g_bump;
  uint32_t nx = (g_bump + n + 7u) & ~7u;
  if (nx > sizeof(g_heap)) return 0;
  g_bump = nx;
  return p;
}
#ifdef UJS_HOST
/* Host: API uses g_heap offsets (wasm32 linear addrs truncate on 64-bit). */
static uint32_t poff(uint32_t o) { return o; }
#else
static uint32_t poff(uint32_t o) { return (uint32_t)(uintptr_t)(g_heap + o); }
#endif

#ifndef UJS_HOST
__attribute__((export_name("alloc")))
#endif
uint32_t alloc(uint32_t n) { uint32_t o = hall(n); return o ? poff(o) : 0; }
#ifndef UJS_HOST
__attribute__((export_name("out_ptr")))
#endif
uint32_t out_ptr(void)  { return g_out_ptr; }
#ifndef UJS_HOST
__attribute__((export_name("out_len")))
#endif
uint32_t out_len(void)  { return g_out_len; }
#ifndef UJS_HOST
__attribute__((export_name("meta_ptr")))
#endif
uint32_t meta_ptr(void) { return g_meta_ptr; }
#ifndef UJS_HOST
__attribute__((export_name("meta_len")))
#endif
uint32_t meta_len(void) { return g_meta_len; }
#ifndef UJS_HOST
__attribute__((export_name("err_ptr")))
#endif
uint32_t err_ptr(void)  { return g_err_ptr; }
#ifndef UJS_HOST
__attribute__((export_name("err_len")))
#endif
uint32_t err_len(void)  { return g_err_len; }

#ifdef UJS_HOST
void ujs_host_write(uint32_t off, const void *p, uint32_t n) {
  if (off + n > sizeof(g_heap)) return;
  memcpy(g_heap + off, p, n);
}
const uint8_t *ujs_host_mem(void) { return g_heap; }
uint32_t ujs_host_mem_size(void) { return (uint32_t)sizeof(g_heap); }
#endif

static void set_err(const char *m) {
  uint32_t n = (uint32_t)strlen(m);
  uint32_t o = hall(n + 1);
  if (!o) { g_err_ptr = g_err_len = 0; return; }
  memcpy(g_heap + o, m, n + 1);
  g_err_ptr = poff(o); g_err_len = n;
}

/* ---- buf ---- */
typedef struct { uint32_t off, n, cap; } Buf;
static uint8_t *bd(Buf *b) { return g_heap + b->off; }
static int binit(Buf *b, uint32_t cap) {
  uint32_t o = hall(cap); if (!o) return 0;
  b->off = o; b->n = 0; b->cap = cap; return 1;
}
static int bres(Buf *b, uint32_t need) {
  if (b->n + need <= b->cap) return 1;
  uint32_t nc = b->cap ? b->cap * 2 : 256;
  while (nc < b->n + need) nc *= 2;
  uint32_t o = hall(nc); if (!o) return 0;
  memcpy(g_heap + o, bd(b), b->n);
  b->off = o; b->cap = nc; return 1;
}
static int bu8(Buf *b, uint8_t v) { if (!bres(b,1)) return 0; bd(b)[b->n++] = v; return 1; }
static int bleu(Buf *b, uint32_t v) {
  for (;;) {
    uint8_t x = (uint8_t)(v & 0x7f); v >>= 7;
    if (v) x |= 0x80;
    if (!bu8(b, x)) return 0;
    if (!v) return 1;
  }
}
static int blei64(Buf *b, int64_t v) {
  for (;;) {
    uint8_t x = (uint8_t)(v & 0x7f); v >>= 7;
    int done = ((v == 0) && !(x & 0x40)) || ((v == -1) && (x & 0x40));
    if (!done) x |= 0x80;
    if (!bu8(b, x)) return 0;
    if (done) return 1;
  }
}
static int blei32(Buf *b, int32_t v) {
  for (;;) {
    uint8_t x = (uint8_t)(v & 0x7f); v >>= 7;
    int done = ((v == 0) && !(x & 0x40)) || ((v == -1) && (x & 0x40));
    if (!done) x |= 0x80;
    if (!bu8(b, x)) return 0;
    if (done) return 1;
  }
}

static int bi32(Buf *b, int32_t v) {
  return bu8(b, 0x41) && blei32(b, v);
}
static int braw(Buf *b, const uint8_t *s, uint32_t n) {
  if (!bres(b, n)) return 0; memcpy(bd(b) + b->n, s, n); b->n += n; return 1;
}
static int bstr(Buf *b, const char *s) {
  uint32_t n = (uint32_t)strlen(s); if (!bleu(b, n)) return 0; return braw(b, (const uint8_t *)s, n);
}
static int bf64(Buf *b, int64_t bits) {
  uint8_t u[8];
  uint64_t x = (uint64_t)bits;
  for (int i = 0; i < 8; i++) { u[i] = (uint8_t)(x & 0xff); x >>= 8; }
  return braw(b, u, 8);
}
static int sect(Buf *m, uint8_t id, Buf *body) {
  if (!bu8(m, id) || !bleu(m, body->n)) return 0;
  return braw(m, bd(body), body->n);
}
static int wcall(Buf *c, uint32_t n) {
  return bu8(c, 0x10) && bleu(c, n + (uint32_t)(g_need_gpu + g_abi_imports));
}

static int64_t d_bits(double d) {
  union { double d; int64_t i; } u; u.d = d; return u.i;
}

/* ---- lex ---- */
enum {
  T_EOF, T_NUM, T_FNUM, T_ID, T_LET, T_WHILE, T_RETURN, T_IF, T_ELSE,
  T_SWITCH, T_CASE, T_DEFAULT, T_NULL, T_FOR, T_OF, T_FUNCTION,
  T_LP, T_RP, T_LB, T_RB, T_LS, T_RS, T_COMMA, T_COLON, T_DOT, T_SEMI, T_EQ,
  T_PLUS, T_MINUS, T_STAR, T_SLASH, T_PCT, T_ARROW, T_ELLIPSIS,
  T_LT, T_GT, T_LE, T_GE, T_EQEQ, T_NE, T_NOT, T_AND, T_OR, T_QMARK, T_QQ, T_STR, T_PERSIST, T_BAD
};
typedef struct {
  const char *src; uint32_t len, pos, tok_start;
  int tok; int64_t num; double fnum; char id[64]; char str[MAXSTRLIT + 1];
} Lex;
static int id0(char c) {
  return (c>='a'&&c<='z')||(c>='A'&&c<='Z')||c=='_';
}
static int idc(char c) { return id0(c)||(c>='0'&&c<='9'); }
static int dig(char c) { return c>='0'&&c<='9'; }
static int spc(char c) { return c==' '||c=='\t'||c=='\n'||c=='\r'; }

#ifdef UJS_HOST
static int g_lex_ok;
static int g_lex_feed[10];
static int g_lex_w2[16];
static int lex_net_load(void) {
  FILE *f;
  char line[256];
  int nfeed = 0, i;
  if (g_lex_ok) return 1;
  for (i = 0; i < 10; i++) g_lex_feed[i] = -1;
  for (i = 0; i < 16; i++) g_lex_w2[i] = -1;
  f = fopen("ujs/weights/nets/lex.net.tsv", "rb");
  if (!f) return 0;
  while (fgets(line, (int)sizeof line, f)) {
    if (!strncmp(line, "feed\t", 5)) {
      const char *p = line + 5;
      int u = -1;
      while (*p && *p != '\t' && *p != '\n') p++;
      if (*p == '\t') {
        p++;
        if (*p >= '0' && *p <= '9') {
          u = 0;
          while (*p >= '0' && *p <= '9') { u = u * 10 + (*p - '0'); p++; }
        }
      }
      if (nfeed < 10) g_lex_feed[nfeed] = u;
      nfeed++;
    } else if (!strncmp(line, "w2\t", 3)) {
      const char *p = line + 3;
      int hid = 0, cl = 0;
      while (*p >= '0' && *p <= '9') { hid = hid * 10 + (*p - '0'); p++; }
      if (*p == '\t') p++;
      while (*p >= '0' && *p <= '9') { cl = cl * 10 + (*p - '0'); p++; }
      if (hid >= 0 && hid < 16) g_lex_w2[hid] = cl;
    }
  }
  fclose(f);
  g_lex_ok = (nfeed >= 10);
  return g_lex_ok;
}
static int lex_byte_cc(unsigned char c) {
  if (c == '\n') return 1;
  if (spc((char)c)) return 2;
  if (id0((char)c)) return 3;
  if (dig((char)c)) return 4;
  if (c == '"') return 5;
  if (c == '\'') return 6;
  if (c=='{'||c=='}'||c=='('||c==')'||c=='['||c==']'||c==';'||c==','||c==':'||c=='.'||c=='?')
    return 7;
  if (c=='='||c=='<'||c=='>'||c=='!'||c=='+'||c=='-'||c=='*'||c=='/'||c=='%'||c=='&'||c=='|'||c=='.')
    return 8;
  return 9;
}
static int lex_net_cls(unsigned char c) {
  int cc, h;
  if (!lex_net_load()) return -1;
  cc = lex_byte_cc(c);
  if (cc < 0 || cc >= 10 || g_lex_feed[cc] < 0) return 8;
  h = g_lex_feed[cc];
  if (h < 0 || h >= 16 || g_lex_w2[h] < 0) return 8;
  return g_lex_w2[h];
}

enum { PN_HMAX = 48, PN_CMAX = 80, PN_FMAX = 20, PN_CLS = 40 };
static int g_pn_ok, g_pn_H, g_pn_ncls, g_pn_b1[PN_HMAX];
static int g_pn_fn[PN_CMAX], g_pn_fu[PN_CMAX][PN_FMAX];
static int g_pn_w2c[PN_HMAX], g_pn_w2w[PN_HMAX];
static char g_pn_cls[PN_CLS][16];
static int pn_feeds(int coord, int unit) {
  int k;
  if (coord < 0 || coord >= PN_CMAX) return 0;
  for (k = 0; k < g_pn_fn[coord]; k++) if (g_pn_fu[coord][k] == unit) return 1;
  return 0;
}
static int pn_load(void) {
  FILE *f;
  char line[1024];
  int i;
  if (g_pn_ok) return 1;
  for (i = 0; i < PN_CMAX; i++) g_pn_fn[i] = 0;
  f = fopen("ujs/weights/nets/parse.net.tsv", "rb");
  if (!f) return 0;
  g_pn_H = 0; g_pn_ncls = 0;
  while (fgets(line, (int)sizeof line, f)) {
    if (!strncmp(line, "class\t", 6)) {
      char *p = line + 6;
      g_pn_ncls = 0;
      while (*p && *p != '\n' && g_pn_ncls < PN_CLS) {
        char *q = p; int n;
        while (*p && *p != '\t' && *p != '\n') p++;
        n = (int)(p - q);
        if (n <= 0 || n >= 16) { fclose(f); return 0; }
        memcpy(g_pn_cls[g_pn_ncls], q, (size_t)n);
        g_pn_cls[g_pn_ncls][n] = 0;
        g_pn_ncls++;
        if (*p == '\t') p++;
      }
    } else if (!strncmp(line, "H\t", 2)) {
      g_pn_H = atoi(line + 2);
      if (g_pn_H <= 0 || g_pn_H > PN_HMAX) { fclose(f); return 0; }
    } else if (!strncmp(line, "b1\t", 3)) {
      char *p = line + 3; int j = 0;
      while (*p && *p != '\n' && j < g_pn_H) {
        g_pn_b1[j++] = atoi(p);
        while (*p && *p != '\t' && *p != '\n') p++;
        if (*p == '\t') p++;
      }
    } else if (!strncmp(line, "feed\t", 5)) {
      char *p = line + 5; int coord, u, k = 0;
      coord = atoi(p);
      while (*p && *p != '\t' && *p != '\n') p++;
      if (*p == '\t') p++;
      while (*p && *p != '\n' && k < PN_FMAX) {
        if (*p >= '0' && *p <= '9') {
          u = atoi(p);
          g_pn_fu[coord][k++] = u;
          while (*p && *p != '\t' && *p != '\n') p++;
          if (*p == '\t') p++;
        } else break;
      }
      if (coord >= 0 && coord < PN_CMAX) g_pn_fn[coord] = k;
    } else if (!strncmp(line, "w2\t", 3)) {
      char *p = line + 3; int h, c, w;
      h = atoi(p);
      while (*p && *p != '\t') p++;
      if (*p != '\t') { fclose(f); return 0; }
      p++;
      c = atoi(p);
      while (*p && *p != '\t') p++;
      if (*p != '\t') { fclose(f); return 0; }
      p++;
      w = atoi(p);
      if (h >= 0 && h < PN_HMAX) { g_pn_w2c[h] = c; g_pn_w2w[h] = w; }
    }
  }
  fclose(f);
  g_pn_ok = (g_pn_H > 0 && g_pn_ncls > 0);
  return g_pn_ok;
}
static int pn_tok_ix(int tok) {
  switch (tok) {
  case T_EOF: return 0; case T_ID: return 1; case T_NUM: case T_FNUM: return 2;
  case T_STR: return 3; case T_NULL: return 4;
  case T_LET: return 7; case T_FUNCTION: return 8; case T_IF: return 9;
  case T_ELSE: return 10; case T_WHILE: return 11; case T_FOR: return 12;
  case T_RETURN: return 13; case T_SWITCH: return 16; case T_CASE: return 17;
  case T_DEFAULT: return 18; case T_OF: return 21;
  case T_LB: return 22; case T_RB: return 23; case T_LP: return 24; case T_RP: return 25;
  case T_LS: return 26; case T_RS: return 27; case T_SEMI: return 28; case T_COMMA: return 29;
  case T_COLON: return 30; case T_DOT: return 31; case T_QMARK: return 32; case T_EQ: return 33;
  default: return -1;
  }
}
static const char *parse_net_cls(int nt, int tok) {
  int ti, j, hv, c, best = -1, bestv = -999999, logit[PN_CLS];
  if (!pn_load()) return 0;
  ti = pn_tok_ix(tok);
  if (ti < 0) return 0;
  for (c = 0; c < g_pn_ncls; c++) logit[c] = 0;
  for (j = 0; j < g_pn_H; j++) {
    hv = g_pn_b1[j];
    if (pn_feeds(nt, j)) hv++;
    if (pn_feeds(6 + ti, j)) hv++;
    if (hv > 0) logit[g_pn_w2c[j]] += g_pn_w2w[j];
  }
  for (c = 0; c < g_pn_ncls; c++) {
    if (best < 0 || logit[c] > bestv) { best = c; bestv = logit[c]; }
  }
  return best >= 0 ? g_pn_cls[best] : 0;
}
static int parse_net_is_bad(int nt, int tok) {
  const char *a = parse_net_cls(nt, tok);
  return a && !strcmp(a, "bad");
}
static int parse_net_top_is_bad(int tok) { return parse_net_is_bad(0, tok); }
#endif

static void next(Lex *L) {
  for (;;) {
    while (L->pos < L->len && spc(L->src[L->pos])) L->pos++;
    if (L->pos + 1 < L->len && L->src[L->pos] == '/' && L->src[L->pos + 1] == '/') {
      L->pos += 2;
      while (L->pos < L->len && L->src[L->pos] != '\n') L->pos++;
      continue;
    }
    break;
  }
  if (L->pos >= L->len) { L->tok = T_EOF; return; }
  L->tok_start = L->pos;
  char c = L->src[L->pos];
  int y = -1;
#ifdef UJS_HOST
  y = lex_net_cls((unsigned char)c);
  if (y == 8) { L->tok = T_BAD; L->pos++; return; }
#endif
  if (y == 4 || (y < 0 && dig(c))) {
    int64_t iv = 0;
    while (L->pos < L->len && dig(L->src[L->pos]))
      iv = iv * 10 + (L->src[L->pos++] - '0');
    if (L->pos < L->len && L->src[L->pos] == '.') {
      L->pos++;
      /* ratio tnum/fden — avoids place*=0.1 ulp drift vs exact IEEE */
      int64_t tnum = iv, fden = 1;
      while (L->pos < L->len && dig(L->src[L->pos])) {
        tnum = tnum * 10 + (L->src[L->pos++] - '0');
        fden *= 10;
      }
      L->fnum = (double)tnum / (double)fden; L->tok = T_FNUM; return;
    }
    L->num = iv; L->tok = T_NUM; return;
  }
  if (y == 5 || (y < 0 && c == '"')) {
    L->pos++;
    uint32_t n = 0;
    while (L->pos < L->len && L->src[L->pos] != '"') {
      char ch = L->src[L->pos];
      if (ch == '\\') { L->tok = T_BAD; return; }
      if (ch == 0) { L->tok = T_BAD; return; } /* NUL not in ship str domain */
      long end = L->pos;
      unsigned codepoint;
      if (tx_utf8_next(L->src, L->len, &end, &codepoint) != 1 ||
          n + (uint32_t)(end - L->pos) > MAXSTRLIT) { L->tok = T_BAD; return; }
      while (L->pos < (uint32_t)end) L->str[n++] = L->src[L->pos++];
    }
    if (L->pos >= L->len) { L->tok = T_BAD; return; }
    L->str[n] = 0;
    L->pos++;
    L->tok = T_STR;
    return;
  }
  if (y == 3 || (y < 0 && id0(c))) {
    uint32_t n = 0;
    while (L->pos < L->len && idc(L->src[L->pos]) && n + 1 < sizeof L->id)
      L->id[n++] = L->src[L->pos++];
    L->id[n] = 0;
    {
      const char *t = L->id;
      if (t[0]=='h'&&t[1]=='o'&&t[2]=='s'&&t[3]=='t'&&t[4]=='_'&&t[5]=='g'&&t[6]=='p'&&t[7]=='u'&&t[8]=='_'&&t[9]=='s'&&t[10]=='u'&&t[11]=='b'&&t[12]=='m'&&t[13]=='i'&&t[14]=='t'&&t[15]==0)
        g_need_gpu = 1;
    }
    if (!strcmp(L->id,"let")) L->tok = T_LET;
    else if (!strcmp(L->id,"while")) L->tok = T_WHILE;
    else if (!strcmp(L->id,"return")) L->tok = T_RETURN;
    else if (!strcmp(L->id,"if")) L->tok = T_IF;
    else if (!strcmp(L->id,"else")) L->tok = T_ELSE;
    else if (!strcmp(L->id,"switch")) L->tok = T_SWITCH;
    else if (!strcmp(L->id,"case")) L->tok = T_CASE;
    else if (!strcmp(L->id,"default")) L->tok = T_DEFAULT;
    else if (!strcmp(L->id,"null")) L->tok = T_NULL;
    else if (!strcmp(L->id,"for")) L->tok = T_FOR;
    else if (!strcmp(L->id,"of")) L->tok = T_OF;
    else if (!strcmp(L->id,"function")) L->tok = T_FUNCTION;
    else if (L->id[0]=='p'&&L->id[1]=='e'&&L->id[2]=='r'&&L->id[3]=='s'&&L->id[4]=='i'&&L->id[5]=='s'&&L->id[6]=='t'&&L->id[7]==0) L->tok = T_PERSIST;
    else L->tok = T_ID;
    return;
  }
  L->pos++;
  if (c=='('){L->tok=T_LP;return;} if (c==')'){L->tok=T_RP;return;}
  if (c=='{'){L->tok=T_LB;return;} if (c=='}'){L->tok=T_RB;return;}
  if (c=='['){L->tok=T_LS;return;} if (c==']'){L->tok=T_RS;return;}
  if (c==','){L->tok=T_COMMA;return;}
  if (c==':'){L->tok=T_COLON;return;}
  if (c=='.'){
    if (L->pos + 1 < L->len && L->src[L->pos]=='.' && L->src[L->pos+1]=='.') {
      L->pos += 2; L->tok = T_ELLIPSIS; return;
    }
    L->tok=T_DOT; return;
  }
  if (c==';'){L->tok=T_SEMI;return;}
  if (c=='+'){L->tok=T_PLUS;return;} if (c=='*'){L->tok=T_STAR;return;}
  if (c=='/'){L->tok=T_SLASH;return;} if (c=='%'){L->tok=T_PCT;return;}
  if (c=='-'){L->tok=T_MINUS;return;}
  if (c=='<'){ if (L->pos<L->len&&L->src[L->pos]=='='){L->pos++;L->tok=T_LE;} else L->tok=T_LT; return; }
  if (c=='>'){ if (L->pos<L->len&&L->src[L->pos]=='='){L->pos++;L->tok=T_GE;} else L->tok=T_GT; return; }
  if (c=='='){
    if (L->pos<L->len&&L->src[L->pos]=='>'){ L->pos++; L->tok=T_ARROW; return; }
    if (L->pos<L->len&&L->src[L->pos]=='='){
      L->pos++;
      if (L->pos<L->len&&L->src[L->pos]=='=') L->pos++; /* === */
      L->tok=T_EQEQ;
    } else L->tok=T_EQ;
    return;
  }
  if (c=='!'){
    if (L->pos<L->len && L->src[L->pos]=='='){ L->pos++; L->tok = T_NE; return; }
    L->tok = T_NOT; return;
  }
  if (c=='&' && L->pos<L->len && L->src[L->pos]=='&'){ L->pos++; L->tok = T_AND; return; }
  if (c=='|' && L->pos<L->len && L->src[L->pos]=='|'){ L->pos++; L->tok = T_OR; return; }
  if (c=='?'){
    if (L->pos < L->len && L->src[L->pos] == '?') { L->pos++; L->tok = T_QQ; return; }
    L->tok = T_QMARK; return;
  }
  L->tok = T_BAD;
}

/* ---- IR ---- */
enum {
  OP_CONST, OP_FCONST, OP_LOAD, OP_STORE,
  OP_ADD, OP_SUB, OP_MUL, OP_DIV, OP_MOD,
  OP_FADD, OP_FSUB, OP_FMUL, OP_FDIV,
  OP_LT, OP_GT, OP_LE, OP_GE, OP_EQ, OP_NE, OP_NEG, OP_FNEG, OP_NOT,
  OP_WBEGIN, OP_WCOND, OP_WEND,
  OP_IF0, OP_IF1, OP_IF2,
  OP_BOXI, OP_BOXF, OP_MKLIST, OP_MKLIST_DYN, OP_LSET, OP_IDXGET, OP_IDXSET, OP_LEN, OP_IWRAP,
  OP_GLOAD, OP_GSTORE,
  OP_MKDICT, OP_DSET, OP_DOT, OP_SCONST, OP_STRADD, OP_STRSLICE,
  OP_I2F, OP_I2F_R, OP_F2I,
  OP_FLT, OP_FGT, OP_FLE, OP_FGE, OP_FEQ, OP_FNE,
  OP_RET, OP_FRET, OP_HRET, OP_GPU, OP_STOREBYTES, OP_PLET,
  OP_UX_ADDR, OP_UX_SPAN, OP_UX_LOAD, OP_UX_STORE, OP_UX_BYTE, OP_FSQRT,
  OP_ABI_CALL, OP_ABI_RET, OP_I32_BITS, OP_FLOOR_I64, OP_NATIVE_CALL
};
enum { MAXC = 16384, MAXL = 256, MAXG = 64, MAXN = 32, MAXSDATA = 8192, MAXFN = 128 };
enum { MAX_CALL_ARGS = 32 };
enum { ABI_MAX_IMPORTS = 8, ABI_MAX_ARGS = 8, ABI_MAX_ALIASES = 8, ABI_TYPE_BASE = 14 };
enum { MAX_LAYOUTS = 24, MAX_LAYOUT_FIELDS = 24 };
enum { MAX_NATIVE = 128, MAX_NATIVE_DEPTH = 8 };
typedef struct {
  char name[MAXN];
  int offset, nested;
} LayoutField;
typedef struct {
  char name[MAXN];
  LayoutField fields[MAX_LAYOUT_FIELDS];
  int count, size, align;
} Layout;
typedef struct {
  char name[MAXN], module[MAXN];
  uint8_t args[ABI_MAX_ARGS];
  int count, result;
} AbiFn;
typedef struct {
  AbiFn sig;
  char params[ABI_MAX_ARGS][MAXN];
  uint32_t off, len;
  int inline_count, depth;
} NativeFn;
typedef struct {
  AbiFn signature;
  int64_t bound[ABI_MAX_ARGS];
  int count;
} AbiAlias;
typedef struct { uint8_t op; int64_t a; } Ins;
/* stage0 fn: call-site inline (no extra wasm funcs). kind 0=expr arrow, 1=block. */
typedef struct {
  char name[MAXN];
  char p0[MAXN];
  char rest[MAXN];
  int has_p0;   /* 1 if p0 used */
  int has_rest;
  int kind;
  uint32_t off, len; /* body bytes in Prog.src */
} FnDef;
typedef struct {
  Ins code[MAXC]; int nc;
  char names[MAXL][MAXN]; uint8_t lty[MAXL]; uint8_t lety[MAXL]; int nl;
  uint16_t local_scope[MAXL];
  int legacy_inline;
  char gnames[MAXG][MAXN]; uint8_t gty[MAXG]; uint8_t glety[MAXG]; uint8_t gpersist[MAXG]; int ng;
  uint8_t sdata[MAXSDATA]; uint32_t sn; /* string pool for OP_SCONST */
  int scratch; /* i32 temp for list/dict init, or -1 */
  int fscratch; /* f64 temp for i64→f64 under, or -1 */
  int lscratch; /* i64 temp for && / || short-circuit, or -1 */
  int uxaddr; /* i32 temporary for the bounded UX span */
  int list_elem_ty; /* TY_I64/TY_F64 of last list literal */
  const char *src; uint32_t srclen;
  FnDef fns[MAXFN]; int nfn;
  Layout layouts[MAX_LAYOUTS]; int nlayouts;
  int in_fn; /* >0 while inlining a user fn body */
  int fn_ret; /* local holding return value when in_fn, or -1 */
  int fn_did_ret;
  AbiFn imports[ABI_MAX_IMPORTS], api;
  AbiAlias aliases[ABI_MAX_ALIASES];
  int import_count, alias_count, abi_version;
  NativeFn natives[MAX_NATIVE];
  int native_count, native_visible, native_result, native_params, native_base, native_depth, native_return;
  const char *err;
} Prog;

static int emit(Prog *P, uint8_t op, int64_t a) {
  if (P->nc >= MAXC) { P->err = "code overflow"; return 0; }
  P->code[P->nc].op = op; P->code[P->nc].a = a; P->nc++; return 1;
}
/* OP_SCONST a = (pool_off << 16) | len; bytes at P->sdata[off..]. */
static int emit_sconst_bytes(Prog *P, const char *s, uint32_t n) {
  if (n > MAXSTRLIT) { P->err = "string too long"; return 0; }
  if (P->sn + n > MAXSDATA) { P->err = "string pool overflow"; return 0; }
  uint32_t off = P->sn;
  for (uint32_t i = 0; i < n; i++) P->sdata[P->sn++] = (uint8_t)s[i];
  return emit(P, OP_SCONST, ((int64_t)off << 16) | (int64_t)n);
}
static int emit_sconst_cstr(Prog *P, const char *s) {
  uint32_t n = 0;
  while (s[n]) n++;
  return emit_sconst_bytes(P, s, n);
}
enum { LOCAL_RESERVED = 65535 };
static int intrinsic_name(const char *actual, const char *expected);

static int fresh_local(Prog *P, const char *name) {
  if (P->nl >= MAXL) { P->err = "too many locals"; return -1; }
  strncpy(P->names[P->nl], name, MAXN - 1);
  P->names[P->nl][MAXN - 1] = 0;
  P->lty[P->nl] = TY_I64;
  P->lety[P->nl] = TY_I64;
  P->local_scope[P->nl] = (uint16_t)(P->in_fn + 1);
  return P->nl++;
}

static int local_here(Prog *P, const char *name) {
  for (int i = 0; i < P->nl; i++)
    if ((P->legacy_inline || P->local_scope[i] == P->in_fn + 1) && intrinsic_name(P->names[i], name)) return i;
  return -1;
}

static int reuse_local(Prog *P, const char *name, int type) {
  if (P->legacy_inline) return -1;
  for (int i = 0; i < P->nl; i++)
    if (!P->local_scope[i] && (!type || P->lty[i] == type) && intrinsic_name(P->names[i], name)) return i;
  return -1;
}

static int loc(Prog *P, const char *name, int create) {
  if (P->legacy_inline) {
    int i = local_here(P, name);
    return i >= 0 || !create ? i : fresh_local(P, name);
  }
  if (create) {
    int i = local_here(P, name);
    return i >= 0 ? i : fresh_local(P, name);
  }
  int best = -1;
  int scope = 0;
  for (int i = 0; i < P->nl; i++) {
    int candidate = P->local_scope[i];
    if (candidate > scope && candidate <= P->in_fn + 1 && intrinsic_name(P->names[i], name)) {
      scope = candidate;
      best = i;
    }
  }
  return best;
}

static int bind_local(Prog *P, const char *name, int type) {
  int i = local_here(P, name);
  if (i >= 0) {
    if (P->lty[i] == type) return i;
    if (P->legacy_inline) { P->lty[i] = (uint8_t)type; return i; }
    P->err = "local redeclaration changes type"; return -1;
  }
  i = reuse_local(P, name, type);
  if (i < 0) i = fresh_local(P, name);
  if (i >= 0) {
    P->lty[i] = (uint8_t)type;
    P->local_scope[i] = (uint16_t)(P->in_fn + 1);
  }
  return i;
}
static int glob(Prog *P, const char *name, int create) {
  if (P->native_result) { P->err = "native function requires an explicit local"; return -1; }
  for (int i = 0; i < P->ng; i++) if (!strcmp(P->gnames[i], name)) return i;
  if (!create) return -1;
  if (P->ng >= MAXG) { P->err = "too many globals"; return -1; }
  strncpy(P->gnames[P->ng], name, MAXN - 1);
  P->gnames[P->ng][MAXN - 1] = 0;
  P->gty[P->ng] = TY_F64; /* inject-friendly; assign overrides */
  P->glety[P->ng] = TY_F64;
  return P->ng++;
}
static int ensure_scratch(Prog *P) {
  if (P->scratch >= 0) return P->scratch;
  if (P->nl >= MAXL) { P->err = "too many locals"; return -1; }
  P->names[P->nl][0] = 0;
  P->lty[P->nl] = TY_LIST;
  P->lety[P->nl] = TY_I64;
  P->scratch = P->nl;
  return P->nl++;
}
static int ensure_fscratch(Prog *P) {
  if (P->fscratch >= 0) return P->fscratch;
  if (P->nl >= MAXL) { P->err = "too many locals"; return -1; }
  P->names[P->nl][0] = 0;
  P->lty[P->nl] = TY_F64;
  P->lety[P->nl] = TY_F64;
  P->fscratch = P->nl;
  return P->nl++;
}
static int ensure_lscratch(Prog *P) {
  if (P->lscratch >= 0) return P->lscratch;
  if (P->nl >= MAXL) { P->err = "too many locals"; return -1; }
  P->names[P->nl][0] = 0;
  P->lty[P->nl] = TY_I64;
  P->lety[P->nl] = TY_I64;
  P->lscratch = P->nl;
  return P->nl++;
}

static int ensure_uxaddr(Prog *P) {
  if (P->uxaddr >= 0) return P->uxaddr;
  if (P->nl >= MAXL) { P->err = "too many locals"; return -1; }
  P->names[P->nl][0] = 0;
  P->lty[P->nl] = TY_LIST;
  P->uxaddr = P->nl;
  return P->nl++;
}

/* emit_sconst_* copies into Prog.sdata; OP_SCONST a = off<<16|len. */

static int pexpr(Lex *L, Prog *P);
static int pstmt(Lex *L, Prog *P);
static int invoke_fn(Lex *L, Prog *P, int fi);
static int invoke_bound_fn(Lex *L, Prog *P, int fi, int receiver);
static int find_native(Prog *P, const char *name);

static int expect(Lex *L, int t, Prog *P, const char *m) {
  if (L->tok != t) { P->err = m; return 0; }
  next(L); return 1;
}

static int find_fn(Prog *P, const char *name) {
  int i;
  for (i = 0; i < P->nfn; i++) if (!strcmp(P->fns[i].name, name)) return i;
  return -1;
}

/* Capture body span starting at current token; leave L on terminator (SEMI or RB). */
static int capture_expr_body(Lex *L, Prog *P, FnDef *F) {
  int depth = 0;
  uint32_t start = L->tok_start;
  for (;;) {
    if (L->tok == T_EOF) { P->err = "fn body"; return 0; }
    if (L->tok == T_LP || L->tok == T_LB || L->tok == T_LS) depth++;
    else if (L->tok == T_RP || L->tok == T_RB || L->tok == T_RS) {
      if (depth) depth--;
    } else if (L->tok == T_SEMI && depth == 0) break;
    next(L);
  }
  F->off = start;
  F->len = L->tok_start - start;
  F->kind = 0;
  return 1;
}

static int capture_block_body(Lex *L, Prog *P, FnDef *F) {
  /* L at `{` */
  int depth = 0;
  uint32_t start;
  if (!expect(L, T_LB, P, "fn {")) return 0;
  start = L->tok_start; /* first token inside, or RB */
  if (L->tok == T_RB) {
    F->off = start; F->len = 0; F->kind = 1;
    return 1; /* leave on RB */
  }
  depth = 1;
  for (;;) {
    if (L->tok == T_EOF) { P->err = "fn }"; return 0; }
    if (L->tok == T_LB) depth++;
    else if (L->tok == T_RB) {
      depth--;
      if (depth == 0) break;
    }
    next(L);
  }
  F->off = start;
  F->len = L->tok_start - start;
  F->kind = 1;
  return 1; /* leave on RB */
}

static int register_fn(Prog *P, FnDef *tmp) {
  if (P->nfn >= MAXFN) { P->err = "too many fns"; return -1; }
  if (find_fn(P, tmp->name) >= 0 || find_native(P, tmp->name) >= 0) { P->err = "dup fn"; return -1; }
  P->fns[P->nfn] = *tmp;
  return P->nfn++;
}

static int invocation_slot(Prog *P, int type) {
  if (P->nl >= MAXL) { P->err = "too many locals"; return -1; }
  P->names[P->nl][0] = 0;
  P->lty[P->nl] = (uint8_t)type;
  P->lety[P->nl] = TY_I64;
  return P->nl++;
}

static int invoke_bound_fn(Lex *L, Prog *P, int fi, int receiver) {
  FnDef *F = &P->fns[fi];
  int narg = 0, i, ty = 0, ret_local, scratch;
  int arg_slot[MAX_CALL_ARGS];
  int outer_ret = P->fn_ret, outer_did_ret = P->fn_did_ret;
  if (receiver >= 0) {
    int slot = invocation_slot(P, TY_LIST);
    if (slot < 0 || !emit(P, OP_LOAD, receiver) || !emit(P, OP_STORE, slot)) return 0;
    arg_slot[narg++] = slot;
  }
  /* L at `(` */
  if (!expect(L, T_LP, P, "call (")) return 0;
  if (L->tok != T_RP) {
    for (;;) {
      if (narg >= MAX_CALL_ARGS) { P->err = "too many args"; return 0; }
      int arg_type = pexpr(L, P);
      if (!arg_type) return 0;
      int slot = invocation_slot(P, arg_type);
      if (slot < 0 || !emit(P, OP_STORE, slot)) return 0;
      arg_slot[narg] = slot;
      narg++;
      if (L->tok == T_COMMA) { next(L); continue; }
      break;
    }
  }
  if (!expect(L, T_RP, P, "call )")) return 0;
  /* Bind parameters from each invocation's typed temporaries. */
  P->in_fn++;
  if (F->has_p0) {
    int pi, ai;
    if (narg < 1) { P->err = "missing arg"; return 0; }
    ai = arg_slot[0];
    if (P->legacy_inline) {
      pi = loc(P, F->p0, 0);
      if (pi >= 0 && P->lty[pi] != P->lty[ai]) { P->err = "fn parameter type changed"; return 0; }
    }
    pi = bind_local(P, F->p0, P->lty[ai]);
    if (pi < 0) return 0;
    P->lty[pi] = P->lty[ai];
    if (!emit(P, OP_LOAD, ai)) return 0;
    if (!emit(P, OP_STORE, pi)) return 0;
  }
  if (F->has_rest) {
    int ri, rest_n = F->has_p0 ? (narg - 1) : narg;
    int base = F->has_p0 ? 1 : 0;
    int rest_type = rest_n ? P->lty[arg_slot[base]] : TY_I64;
    if (rest_n < 0) rest_n = 0;
    ri = bind_local(P, F->rest, TY_LIST); if (ri < 0) return 0;
    scratch = invocation_slot(P, TY_LIST); if (scratch < 0) return 0;
    if (!emit(P, OP_MKLIST, rest_n)) return 0;
    if (!emit(P, OP_STORE, scratch)) return 0;
    for (i = 0; i < rest_n; i++) {
      int ai = arg_slot[base + i];
      if (P->lty[ai] != rest_type) rest_type = TY_I64;
      if (!emit(P, OP_LOAD, scratch)) return 0;
      if (!emit(P, OP_LOAD, ai)) return 0;
      if (P->lty[ai] == TY_F64) { if (!emit(P, OP_BOXF, 0)) return 0; }
      else if (P->lty[ai] == TY_I64) { if (!emit(P, OP_BOXI, 0)) return 0; }
      else { P->err = "rest elem"; return 0; }
      if (!emit(P, OP_LSET, i)) return 0;
    }
    if (!emit(P, OP_LOAD, scratch)) return 0;
    P->lty[ri] = TY_LIST;
    P->lety[ri] = (uint8_t)rest_type;
    P->list_elem_ty = rest_type;
    if (!emit(P, OP_STORE, ri)) return 0;
  } else if (F->has_p0 && narg != 1) {
    P->err = "arity"; return 0;
  } else if (!F->has_p0 && !F->has_rest && narg != 0) {
    P->err = "arity"; return 0;
  }
  ret_local = invocation_slot(P, TY_I64); if (ret_local < 0) return 0;
  P->fn_ret = ret_local;
  P->fn_did_ret = 0;
  {
    Lex B;
    B.src = P->src + F->off;
    B.len = F->len;
    B.pos = 0;
    next(&B);
    if (F->kind == 0) {
      ty = pexpr(&B, P); if (!ty) { P->in_fn--; return 0; }
      P->lty[ret_local] = (uint8_t)ty;
      if (!emit(P, OP_STORE, ret_local)) { P->in_fn--; return 0; }
      P->fn_did_ret = 1;
    } else {
      while (B.tok != T_EOF) {
        if (!pstmt(&B, P)) { P->in_fn--; return 0; }
      }
      if (!P->fn_did_ret) { P->err = "fn no return"; P->in_fn--; return 0; }
      ty = P->lty[ret_local];
    }
  }
  for (i = 0; i < P->nl; i++)
    if (P->local_scope[i] == P->in_fn + 1) P->local_scope[i] = 0;
  P->in_fn--;
  P->fn_ret = outer_ret;
  P->fn_did_ret = outer_did_ret;
  if (!emit(P, OP_LOAD, ret_local)) return 0;
  return ty ? ty : TY_I64;
}

static int invoke_fn(Lex *L, Prog *P, int fi) {
  return invoke_bound_fn(L, P, fi, -1);
}

static int bin_finish(Prog *P, int ty, int ty2, uint8_t oi, uint8_t of) {
  if (!ty || !ty2) return 0;
  if (ty == ty2) {
    if (ty != TY_I64 && ty != TY_F64) { P->err = "bad bin"; return 0; }
    if (!emit(P, ty == TY_F64 ? of : oi, 0)) return 0;
    return ty;
  }
  /* i64/f64 mix → f64; emit OP_I2F on the i64 side before op via marker */
  if (!((ty == TY_I64 && ty2 == TY_F64) || (ty == TY_F64 && ty2 == TY_I64))) {
    P->err = "mixed num types"; return 0;
  }
  if (ty == TY_I64) {
    if (ensure_fscratch(P) < 0) return 0;
    if (!emit(P, OP_I2F_R, 0)) return 0;
  } else {
    if (!emit(P, OP_I2F, 0)) return 0;
  }
  if (!emit(P, of, 0)) return 0;
  return TY_F64;
}

static int intrinsic_name(const char *actual, const char *expected) {
  while (*actual && *actual == *expected) { actual++; expected++; }
  return *actual == *expected;
}

static int abi_name_copy(char *dst, const char *src);

static int string_slice_expr(Lex *L, Prog *P) {
  int source = invocation_slot(P, TY_STR), start = invocation_slot(P, TY_I64);
  int end = invocation_slot(P, TY_I64), length = invocation_slot(P, TY_LIST);
  if (source < 0 || start < 0 || end < 0 || length < 0) return 0;
  next(L);
  if (!expect(L, T_LP, P, "str_slice (")) return 0;
  if (pexpr(L, P) != TY_STR) { P->err = "str_slice requires a string"; return 0; }
  if (!emit(P, OP_STORE, source) || !expect(L, T_COMMA, P, "str_slice start")) return 0;
  if (pexpr(L, P) != TY_I64) { P->err = "str_slice requires start i64"; return 0; }
  if (!emit(P, OP_STORE, start) || !expect(L, T_COMMA, P, "str_slice end")) return 0;
  if (pexpr(L, P) != TY_I64) { P->err = "str_slice requires end i64"; return 0; }
  if (!emit(P, OP_STORE, end) || !expect(L, T_RP, P, "str_slice )")) return 0;
  return emit(P, OP_STRSLICE, source | start << 8 | end << 16 | (int64_t)length << 24) ? TY_STR : 0;
}

static int closure_expr(Lex *L, Prog *P) {
  next(L);
  if (!expect(L, T_LP, P, "closure (")) return 0;
  int fn = L->tok == T_ID ? find_fn(P, L->id) : -1;
  if (fn < 0 || !P->fns[fn].has_p0) {
    P->err = "closure callback requires a capture parameter"; return 0;
  }
  int scratch = invocation_slot(P, TY_LIST), at = P->nc;
  if (scratch < 0 || !emit(P, OP_MKLIST, 0) || !emit(P, OP_STORE, scratch)) return 0;
  next(L);
  int count = 0;
  while (L->tok == T_COMMA) {
    if (count >= 16) { P->err = "closure capture limit"; return 0; }
    next(L);
    if (!emit(P, OP_LOAD, scratch)) return 0;
    if (pexpr(L, P) != TY_I64) { P->err = "closure capture requires i64"; return 0; }
    if (!emit(P, OP_BOXI, 0) || !emit(P, OP_LSET, count++)) return 0;
  }
  P->code[at].a = count;
  if (!expect(L, T_RP, P, "closure )") || !emit(P, OP_LOAD, scratch)) return 0;
  return TY_CLOSURE_BASE + fn;
}

static int layout_find(Prog *P, const char *name) {
  for (int i = 0; i < P->nlayouts; i++)
    if (intrinsic_name(name, P->layouts[i].name)) return i;
  return -1;
}

static int layout_field(Layout *layout, const char *name) {
  for (int i = 0; i < layout->count; i++)
    if (intrinsic_name(name, layout->fields[i].name)) return i;
  return -1;
}

static int layout_scalar_width(const char *name) {
  static const char *names[] = {"", "u8", "u16", "u32", "f32", "i32", "f64"};
  for (int kind = UX_U8; kind <= UX_F64; kind++)
    if (intrinsic_name(name, names[kind])) return ux_width(kind);
  return 0;
}

static int layout_decl(Lex *L, Prog *P) {
  next(L);
  if (P->nlayouts == MAX_LAYOUTS) { P->err = "struct layout limit"; return 0; }
  if (L->tok != T_ID || layout_find(P, L->id) >= 0 || layout_scalar_width(L->id)) {
    P->err = "struct duplicate or invalid name"; return 0;
  }
  Layout *layout = &P->layouts[P->nlayouts];
  if (!abi_name_copy(layout->name, L->id)) { P->err = "struct name length"; return 0; }
  layout->align = 1;
  next(L);
  if (!expect(L, T_LB, P, "struct {")) return 0;
  while (L->tok != T_RB) {
    if (layout->count == MAX_LAYOUT_FIELDS) { P->err = "struct field limit"; return 0; }
    if (L->tok != T_ID || layout_field(layout, L->id) >= 0 ||
        intrinsic_name(L->id, "size") || intrinsic_name(L->id, "align")) {
      P->err = "struct duplicate or invalid field"; return 0;
    }
    LayoutField *field = &layout->fields[layout->count];
    if (!abi_name_copy(field->name, L->id)) { P->err = "struct field name length"; return 0; }
    next(L);
    if (!expect(L, T_COLON, P, "struct field :")) return 0;
    if (L->tok != T_ID) { P->err = "struct field type"; return 0; }
    int size = layout_scalar_width(L->id), alignment = size;
    field->nested = layout_find(P, L->id);
    if (field->nested >= 0) {
      size = P->layouts[field->nested].size;
      alignment = P->layouts[field->nested].align;
    }
    if (!size) { P->err = "struct unknown or recursive type"; return 0; }
    int offset = (layout->size + alignment - 1) / alignment * alignment;
    if (offset > UX_BUFFER_SIZE - size) { P->err = "struct layout size"; return 0; }
    field->offset = offset;
    layout->size = offset + size;
    if (alignment > layout->align) layout->align = alignment;
    layout->count++;
    next(L);
    if (!expect(L, T_SEMI, P, "struct field ;")) return 0;
  }
  if (!layout->count) { P->err = "struct empty layout"; return 0; }
  layout->size = (layout->size + layout->align - 1) / layout->align * layout->align;
  next(L);
  P->nlayouts++;
  return 1;
}

static int layout_constant(Lex *L, Prog *P, int layout_id) {
  int offset = 0;
  while (L->tok == T_DOT && layout_id >= 0) {
    Layout *layout = &P->layouts[layout_id];
    next(L);
    if (L->tok != T_ID) { P->err = "struct field name"; return 0; }
    if (intrinsic_name(L->id, "size") || intrinsic_name(L->id, "align")) {
      const int value = intrinsic_name(L->id, "size") ? layout->size : layout->align;
      next(L);
      if (L->tok == T_DOT) { P->err = "struct scalar path"; return 0; }
      return emit(P, OP_CONST, value) ? TY_I64 : 0;
    }
    int index = layout_field(layout, L->id);
    if (index < 0) { P->err = "struct unknown field"; return 0; }
    offset += layout->fields[index].offset;
    layout_id = layout->fields[index].nested;
    next(L);
  }
  if (L->tok == T_DOT) { P->err = "struct scalar path"; return 0; }
  return emit(P, OP_CONST, offset) ? TY_I64 : 0;
}

static int abi_name_copy(char *dst, const char *src) {
  int n = 0;
  if (!id0(src[0])) return 0;
  while (src[n] && n < MAXN - 1) {
    if (!idc(src[n])) return 0;
    dst[n] = src[n];
    n++;
  }
  dst[n] = 0;
  return !src[n];
}

static int abi_type(Lex *L, Prog *P) {
  int type = 0;
  if (L->tok == T_ID) {
    if (intrinsic_name(L->id, "i64")) type = TY_I64;
    if (intrinsic_name(L->id, "f64")) type = TY_F64;
  }
  if (!type) { P->err = "abi requires i64 or f64"; return 0; }
  next(L);
  return type;
}

static int find_native(Prog *P, const char *name) {
  for (int i = 0; i < P->native_count; i++)
    if (intrinsic_name(name, P->natives[i].sig.name)) return i;
  return -1;
}

static int native_decl(Lex *L, Prog *P) {
  if (P->native_count == MAX_NATIVE) { P->err = "native function limit"; return 0; }
  NativeFn *fn = &P->natives[P->native_count];
  next(L);
  if (!expect(L, T_FUNCTION, P, "native function keyword")) return 0;
  if (L->tok != T_ID || !abi_name_copy(fn->sig.name, L->id) ||
      find_fn(P, L->id) >= 0 || find_native(P, L->id) >= 0) {
    P->err = "native function name"; return 0;
  }
  for (int i = 0; i < P->import_count; i++) {
    if (intrinsic_name(L->id, P->imports[i].name)) { P->err = "native function shadows import"; return 0; }
  }
  next(L);
  if (!expect(L, T_LP, P, "native function (")) return 0;
  if (L->tok != T_RP) for (;;) {
    int idx = fn->sig.count;
    if (idx == ABI_MAX_ARGS) { P->err = "native parameter limit"; return 0; }
    if (L->tok != T_ID || !abi_name_copy(fn->params[idx], L->id)) {
      P->err = "native parameter name"; return 0;
    }
    for (int i = 0; i < idx; i++)
      if (intrinsic_name(fn->params[i], L->id)) { P->err = "native duplicate parameter"; return 0; }
    next(L);
    if (!expect(L, T_COLON, P, "native parameter :")) return 0;
    int type = abi_type(L, P);
    if (!type) return 0;
    fn->sig.args[fn->sig.count++] = (uint8_t)type;
    if (L->tok != T_COMMA) break;
    next(L);
  }
  if (!expect(L, T_RP, P, "native function )")) return 0;
  fn->sig.result = abi_type(L, P);
  FnDef span;
  if (!fn->sig.result || !capture_block_body(L, P, &span) ||
      !expect(L, T_RB, P, "native function }")) return 0;
  fn->off = span.off;
  fn->len = span.len;
  fn->inline_count = P->nfn;
  P->native_count++;
  return 1;
}

static int native_invoke(Lex *L, Prog *P, int index) {
  NativeFn *fn = &P->natives[index];
  if (P->native_result && index >= P->native_visible) {
    P->err = "native call cycle or forward reference"; return 0;
  }
  if (P->native_result) {
    int depth = fn->depth + 1;
    if (depth > MAX_NATIVE_DEPTH) { P->err = "native call depth limit"; return 0; }
    if (depth > P->native_depth) P->native_depth = depth;
  }
  if (!expect(L, T_LP, P, "native call (")) return 0;
  for (int i = 0; i < fn->sig.count; i++) {
    if (i && !expect(L, T_COMMA, P, "native call ,")) return 0;
    int type = pexpr(L, P);
    if (!type) return 0;
    if (type != fn->sig.args[i]) { P->err = "native argument type"; return 0; }
  }
  if (!expect(L, T_RP, P, "native call )") || !emit(P, OP_NATIVE_CALL, index)) return 0;
  return fn->sig.result;
}

static int abi_import_module(const char *name) {
  const char *prefix = "uxe_";
  if (intrinsic_name(name, "env")) return 1;
  while (*prefix && *name == *prefix) { name++; prefix++; }
  if (*prefix || *name < 'a' || *name > 'z') return 0;
  const char *version = name;
  for (; *name; name++) {
    if (*name == '_' && name[1] == 'v') version = name + 1;
    if (!dig(*name) && *name != '_' && (*name < 'a' || *name > 'z')) return 0;
  }
  if (*version++ != 'v' || *version < '1' || *version > '9') return 0;
  int value = 0;
  while (dig(*version)) {
    value = value * 10 + (*version++ - '0');
    if (value > 255) return 0;
  }
  return !*version;
}

static int abi_export_name(const char *name) {
  return name[0] == 'u' && name[1] == 'x' && name[2] == 'e' &&
      name[3] == '_' && name[4] && !intrinsic_name(name, "uxe_abi_version");
}

static int abi_alias(Lex *L, Prog *P) {
  if (!P->abi_version || P->alias_count == ABI_MAX_ALIASES) {
    P->err = "abi alias declaration limit"; return 0;
  }
  next(L);
  AbiAlias *alias = &P->aliases[P->alias_count];
  char *name = alias->signature.name;
  if (L->tok != T_ID || !abi_name_copy(name, L->id) || !abi_export_name(name) ||
      intrinsic_name(name, P->api.name)) { P->err = "abi alias export name"; return 0; }
  for (int i = 0; i < P->alias_count; i++)
    if (intrinsic_name(name, P->aliases[i].signature.name)) { P->err = "abi duplicate alias"; return 0; }
  for (int i = 0; i < P->import_count; i++)
    if (intrinsic_name(name, P->imports[i].name)) { P->err = "abi alias shadows import"; return 0; }
  next(L);
  if (!expect(L, T_LP, P, "abi alias (")) return 0;
  for (;;) {
    int index = alias->count;
    if (index >= P->api.count || P->api.args[index] != TY_I64 || L->tok != T_NUM) {
      P->err = "abi alias binding requires i64 literal"; return 0;
    }
    alias->bound[alias->count++] = L->num;
    next(L);
    if (L->tok != T_COMMA) break;
    next(L);
  }
  if (!expect(L, T_RP, P, "abi alias )") || !expect(L, T_SEMI, P, "abi alias ;")) return 0;
  alias->signature.result = P->api.result;
  for (int i = alias->count; i < P->api.count; i++)
    alias->signature.args[alias->signature.count++] = P->api.args[i];
  P->alias_count++;
  return 1;
}

static int abi_decl(Lex *L, Prog *P, int exports) {
  AbiFn *f;
  if (!exports && P->abi_version) { P->err = "abi imports precede export"; return 0; }
  if ((exports && P->abi_version) || (!exports && P->import_count == ABI_MAX_IMPORTS)) {
    P->err = "abi declaration limit"; return 0;
  }
  f = exports ? &P->api : &P->imports[P->import_count];
  next(L);
  if (L->tok != T_ID || !abi_name_copy(f->name, L->id)) { P->err = "abi name"; return 0; }
  if (exports && !abi_export_name(f->name)) {
    P->err = "abi export name"; return 0;
  }
  for (int i = 0; i < P->import_count; i++) {
    if (intrinsic_name(P->imports[i].name, f->name)) { P->err = "abi duplicate name"; return 0; }
  }
  next(L);
  if (!exports) {
    if (L->tok != T_ID || !intrinsic_name(L->id, "from")) { P->err = "abi import from"; return 0; }
    next(L);
    if (L->tok != T_STR || !abi_import_module(L->str) || !abi_name_copy(f->module, L->str) ||
        intrinsic_name(f->name, "host_gpu_submit")) { P->err = "abi import module or name"; return 0; }
    next(L);
  }
  if (!expect(L, T_LP, P, "abi declaration (")) return 0;
  if (L->tok != T_RP) for (;;) {
    int param = -1, type;
    if (f->count == ABI_MAX_ARGS) { P->err = "abi too many parameters"; return 0; }
    if (exports) {
      char name[MAXN];
      if (L->tok != T_ID || !abi_name_copy(name, L->id) || loc(P, name, 0) >= 0) {
        P->err = "abi parameter name"; return 0;
      }
      param = loc(P, name, 1);
      if (param < 0) return 0;
      next(L);
      if (!expect(L, T_COLON, P, "abi parameter :")) return 0;
    }
    type = abi_type(L, P);
    if (!type) return 0;
    f->args[f->count++] = (uint8_t)type;
    if (exports) P->lty[param] = (uint8_t)type;
    if (L->tok != T_COMMA) break;
    next(L);
  }
  if (!expect(L, T_RP, P, "abi declaration )")) return 0;
  f->result = abi_type(L, P);
  if (!f->result) return 0;
  if (exports) {
    if (L->tok != T_ID || !intrinsic_name(L->id, "version")) { P->err = "abi version"; return 0; }
    next(L);
    if (L->tok != T_NUM || L->num < 1 || L->num > 255) { P->err = "abi version range"; return 0; }
    P->abi_version = (int)L->num;
    next(L);
  } else {
    P->import_count++;
  }
  return expect(L, T_SEMI, P, "abi declaration ;");
}

static int abi_invoke(Lex *L, Prog *P, int which) {
  AbiFn *f = &P->imports[which];
  if (!expect(L, T_LP, P, "abi call (")) return 0;
  for (int i = 0; i < f->count; i++) {
    if (i && !expect(L, T_COMMA, P, "abi call ,")) return 0;
    if (pexpr(L, P) != f->args[i]) { P->err = "abi argument type"; return 0; }
  }
  if (!expect(L, T_RP, P, "abi call )") || !emit(P, OP_ABI_CALL, which)) return 0;
  return f->result;
}

enum { I32_SIGNED = 256, I32_UNARY = 512 };
static int i32_opcode(const char *name) {
  static const struct { const char *name; int op; } ops[] = {
    {"wrap", I32_UNARY}, {"add", 0x6a}, {"sub", 0x6b}, {"mul", 0x6c},
    {"and", 0x71}, {"or", 0x72}, {"xor", 0x73}, {"shl", 0x74},
    {"shr", 0x76}, {"rotl", 0x77}, {"rotr", 0x78}
  };
  if ((name[0] != 'u' && name[0] != 'i') || name[1] != '3' ||
      name[2] != '2' || name[3] != '_') return 0;
  const int sign = name[0] == 'i' ? I32_SIGNED : 0;
  for (uint32_t i = 0; i < sizeof ops / sizeof ops[0]; i++) {
    if (intrinsic_name(name + 4, ops[i].name))
      return (sign && ops[i].op == 0x76 ? 0x75 : ops[i].op) | sign;
  }
  return 0;
}

static int pprim(Lex *L, Prog *P) {
  const char *uact = 0;
  const char *pact = 0;
#ifdef UJS_HOST
  uact = parse_net_cls(2, L->tok);
  if (uact && !strcmp(uact, "bad")) { P->err = "parse-net"; return 0; }
  pact = parse_net_cls(4, L->tok);
  if (pact && !strcmp(pact, "bad") && L->tok != T_MINUS && L->tok != T_NOT) {
    P->err = "parse-net"; return 0;
  }
#endif
  if (L->tok == T_STR && (!pact || !strcmp(pact, "string"))) {
    uint32_t n = 0;
    while (L->str[n]) n++;
    if (!emit_sconst_bytes(P, L->str, n)) return 0;
    next(L);
    return TY_STR;
  }
  if (L->tok == T_NUM && (!pact || !strcmp(pact, "number"))) {
    if (!emit(P, OP_CONST, L->num)) return 0; next(L); return TY_I64;
  }
  if (L->tok == T_FNUM && (!pact || !strcmp(pact, "number"))) {
    if (!emit(P, OP_FCONST, d_bits(L->fnum))) return 0; next(L); return TY_F64;
  }
  if (L->tok == T_LS && (!pact || !strcmp(pact, "list"))) {
    /* [e, e, ...] — homogeneous i64 or f64 elems */
    next(L);
    int scratch = ensure_scratch(P); if (scratch < 0) return 0;
    int n = 0;
    if (L->tok == T_RS) {
      next(L);
      if (!emit(P, OP_MKLIST, 0)) return 0;
      P->list_elem_ty = TY_I64;
      return TY_LIST;
    }
    uint32_t save_pos = L->pos; int save_tok = L->tok;
    int64_t save_num = L->num; double save_fnum = L->fnum;
    char save_id[64]; strncpy(save_id, L->id, 64);
    n = 1;
    int depth = 0;
    for (;;) {
      if (L->tok == T_EOF) { P->err = "list]"; return 0; }
      if (L->tok == T_LS || L->tok == T_LP || L->tok == T_LB) depth++;
      else if (L->tok == T_RS || L->tok == T_RP || L->tok == T_RB) {
        if (depth == 0) {
          if (L->tok == T_RS) break;
          P->err = "list delimiter"; return 0;
        }
        depth--;
      } else if (L->tok == T_COMMA && depth == 0) n++;
      next(L);
    }
    L->pos = save_pos; L->tok = save_tok; L->num = save_num; L->fnum = save_fnum;
    strncpy(L->id, save_id, 64);
    if (n > 256) { P->err = "list too long"; return 0; }
    if (!emit(P, OP_MKLIST, n)) return 0;
    if (!emit(P, OP_STORE, scratch)) return 0;
    int elem_ty = 0;
    for (int i = 0; i < n; i++) {
      if (!emit(P, OP_LOAD, scratch)) return 0;
      int ty = pexpr(L, P); if (!ty) return 0;
      if (ty != TY_I64 && ty != TY_F64) { P->err = "list elem"; return 0; }
      if (!elem_ty) elem_ty = ty;
      else if (ty != elem_ty) { P->err = "list mixed"; return 0; }
      if (!emit(P, ty == TY_F64 ? OP_BOXF : OP_BOXI, 0)) return 0;
      if (!emit(P, OP_LSET, i)) return 0;
      if (i + 1 < n) {
        if (!expect(L, T_COMMA, P, "list ,")) return 0;
      }
    }
    if (!expect(L, T_RS, P, "list ]")) return 0;
    if (!emit(P, OP_LOAD, scratch)) return 0;
    P->list_elem_ty = elem_ty;
    P->lety[scratch] = (uint8_t)elem_ty;
    return TY_LIST;
  }
  if (L->tok == T_LB && (!pact || !strcmp(pact, "dict"))) {
    /* { k: v, ... } — ID keys, i64/f64 vals */
    next(L);
    int scratch = ensure_scratch(P); if (scratch < 0) return 0;
    if (L->tok == T_RB) {
      next(L);
      if (!emit(P, OP_MKDICT, 0)) return 0;
      return TY_DICT;
    }
    /* count pairs */
    uint32_t save_pos = L->pos; int save_tok = L->tok;
    int64_t save_num = L->num; double save_fnum = L->fnum;
    char save_id[64]; strncpy(save_id, L->id, 64);
    int n = 1, depth = 0;
    for (;;) {
      if (L->tok == T_EOF) { P->err = "dict}"; return 0; }
      if (L->tok == T_LB || L->tok == T_LS) depth++;
      else if (L->tok == T_RB || L->tok == T_RS) {
        if (depth == 0 && L->tok == T_RB) break;
        if (depth) depth--;
      } else if (L->tok == T_COMMA && depth == 0) n++;
      next(L);
    }
    L->pos = save_pos; L->tok = save_tok; L->num = save_num; L->fnum = save_fnum;
    strncpy(L->id, save_id, 64);
    if (n > 32) { P->err = "dict too long"; return 0; }
    if (!emit(P, OP_MKDICT, n)) return 0;
    if (!emit(P, OP_STORE, scratch)) return 0;
    for (int i = 0; i < n; i++) {
      if (L->tok != T_ID) { P->err = "dict key"; return 0; }
      /* RT dict_get compares ≤8 payload bytes (i64); longer keys collide — reject. */
      uint32_t kn = 0;
      while (L->id[kn]) kn++;
      if (kn > 8) { P->err = "dict key too long"; return 0; }
      char kbuf[64];
      strncpy(kbuf, L->id, 63); kbuf[63] = 0;
      next(L);
      if (!expect(L, T_COLON, P, "dict :")) return 0;
      if (!emit(P, OP_LOAD, scratch)) return 0;
      if (!emit_sconst_cstr(P, kbuf)) return 0;
      int vty = pexpr(L, P); if (!vty) return 0;
      if (vty == TY_I64) { if (!emit(P, OP_BOXI, 0)) return 0; }
      else if (vty == TY_F64) { if (!emit(P, OP_BOXF, 0)) return 0; }
      else if (vty != TY_LIST && vty != TY_DICT) { P->err = "dict val"; return 0; }
      if (!emit(P, OP_DSET, i)) return 0;
      if (i + 1 < n) {
        if (!expect(L, T_COMMA, P, "dict ,")) return 0;
      }
    }
    if (!expect(L, T_RB, P, "dict }")) return 0;
    if (!emit(P, OP_LOAD, scratch)) return 0;
    return TY_DICT;
  }
  if (L->tok == T_ID && (!pact || !strcmp(pact, "ident"))) {
    if (intrinsic_name(L->id, "closure")) return closure_expr(L, P);
    if (intrinsic_name(L->id, "str_slice")) return string_slice_expr(L, P);
    int bit_op = i32_opcode(L->id);
    if (bit_op) {
      next(L);
      if (!expect(L, T_LP, P, "i32 intrinsic (")) return 0;
      if (pexpr(L, P) != TY_I64) { P->err = "i32 intrinsic requires i64"; return 0; }
      if (!emit(P, OP_IWRAP, 0)) return 0;
      if (!(bit_op & I32_UNARY)) {
        if (!expect(L, T_COMMA, P, "i32 intrinsic ,")) return 0;
        if (pexpr(L, P) != TY_I64) { P->err = "i32 intrinsic requires i64"; return 0; }
        if (!emit(P, OP_IWRAP, 0)) return 0;
      }
      if (!expect(L, T_RP, P, "i32 intrinsic )") || !emit(P, OP_I32_BITS, bit_op)) return 0;
      return TY_I64;
    }
    if (!strcmp(L->id, "len")) {
      next(L);
      if (!expect(L, T_LP, P, "len (")) return 0;
      /* len(name) on inject global → mark LIST before load */
      if (L->tok == T_ID) {
        int li = loc(P, L->id, 0);
        if (li < 0) {
          int g = glob(P, L->id, 1); if (g < 0) return 0;
          P->gty[g] = TY_LIST;
          P->list_elem_ty = P->glety[g] ? P->glety[g] : TY_F64;
          if (!emit(P, OP_GLOAD, (int64_t)g | ((int64_t)P->gty[g] << 16))) return 0;
          next(L);
          if (!expect(L, T_RP, P, "len )")) return 0;
          if (!emit(P, OP_LEN, 0)) return 0;
          return TY_I64;
        }
      }
      int ty = pexpr(L, P); if (!ty) return 0;
      if (ty != TY_LIST && ty != TY_DICT && ty != TY_STR) { P->err = "len(list or string)"; return 0; }
      if (!expect(L, T_RP, P, "len )")) return 0;
      if (!emit(P, OP_LEN, 0)) return 0;
      return TY_I64;
    }
    if (intrinsic_name(L->id, "f64_floor_i64")) {
      next(L);
      if (!expect(L, T_LP, P, "f64_floor_i64 (")) return 0;
      if (pexpr(L, P) != TY_F64) { P->err = "f64_floor_i64 requires f64"; return 0; }
      if (!expect(L, T_RP, P, "f64_floor_i64 )") || !emit(P, OP_FLOOR_I64, 0)) return 0;
      return TY_I64;
    }
    if (intrinsic_name(L->id, "f64_sqrt")) {
      next(L);
      if (!expect(L, T_LP, P, "f64_sqrt (")) return 0;
      if (pexpr(L, P) != TY_F64) { P->err = "f64_sqrt requires f64"; return 0; }
      if (!expect(L, T_RP, P, "f64_sqrt )") || !emit(P, OP_FSQRT, 0)) return 0;
      return TY_F64;
    }
    {
      int kind = 0, put = 0;
      for (int k = UX_U8; k <= UX_F64; k++) {
        if (intrinsic_name(L->id, ux_read_names[k])) { kind = k; break; }
        if (intrinsic_name(L->id, ux_write_names[k])) { kind = k; put = 1; break; }
      }
      int span = intrinsic_name(L->id, "ux_span");
      if (kind || span) {
        g_need_ux = 1;
        int width = span ? 0 : ux_width(kind);
        int type = (kind == UX_F32 || kind == UX_F64) ? TY_F64 : TY_I64;
        int tmp = ensure_lscratch(P);
        if (tmp < 0) return 0;
        next(L);
        if (!expect(L, T_LP, P, "ux buffer (")) return 0;
        if (pexpr(L, P) != TY_I64) { P->err = "ux buffer offset requires i64"; return 0; }
        if (!emit(P, OP_UX_ADDR, tmp * 256 + width)) return 0;
        if (put) {
          if (!expect(L, T_COMMA, P, "ux buffer ,")) return 0;
          if (pexpr(L, P) != type) {
            P->err = "ux buffer value type"; return 0;
          }
          if (kind == UX_U8) {
            if (!emit(P, OP_UX_BYTE, tmp)) return 0;
          } else if (type == TY_I64 && !emit(P, OP_IWRAP, 0)) return 0;
          if (!emit(P, OP_UX_STORE, kind) || !emit(P, OP_CONST, 0)) return 0;
        } else if (span) {
          int addr = ensure_uxaddr(P);
          if (addr < 0 || !expect(L, T_COMMA, P, "ux span ,")) return 0;
          if (pexpr(L, P) != TY_I64) { P->err = "ux span count requires i64"; return 0; }
          if (!emit(P, OP_UX_SPAN, tmp * 256 + addr)) return 0;
        } else if (!emit(P, OP_UX_LOAD, kind)) return 0;
        if (!expect(L, T_RP, P, "ux buffer )")) return 0;
        return put || span ? TY_I64 : type;
      }
    }
    /* list(n) → zeroed list of length n (i64 elems); for inject buffers */
    if (!strcmp(L->id, "list")) {
      next(L);
      if (!expect(L, T_LP, P, "list (")) return 0;
      int ty = pexpr(L, P); if (!ty) return 0;
      if (ty != TY_I64) { P->err = "list(n) i64"; return 0; }
      if (!expect(L, T_RP, P, "list )")) return 0;
      if (!emit(P, OP_IWRAP, 0)) return 0; /* i32 for mk_list */
      if (!emit(P, OP_MKLIST_DYN, 0)) return 0;
      P->list_elem_ty = TY_I64;
      return TY_LIST;
    }
    {
      const char *t = L->id;
      const char *k = "store_bytes";
      int hi = 0;
      while (k[hi] && t[hi] == k[hi]) hi++;
      if (!k[hi] && !t[hi]) {
        int ty;
        next(L);
        if (!expect(L, T_LP, P, "store_bytes (")) return 0;
        ty = pexpr(L, P); if (!ty) return 0;
        if (ty != TY_LIST) { P->err = "store_bytes list"; return 0; }
        if (!expect(L, T_RP, P, "store_bytes )")) return 0;
        if (!emit(P, OP_STOREBYTES, 0)) return 0;
        return TY_I64;
      }
    }
    {
      const char *t = L->id;
      const char *k = "host_gpu_submit";
      int hi = 0;
      while (k[hi] && t[hi] == k[hi]) hi++;
      if (!k[hi] && !t[hi]) {
        int a, b;
        next(L);
        if (!expect(L, T_LP, P, "gpu (")) return 0;
        a = pexpr(L, P); if (!a) return 0;
        if (a != TY_I64) { P->err = "gpu ptr"; return 0; }
        if (!emit(P, OP_IWRAP, 0)) return 0;
        if (!expect(L, T_COMMA, P, "gpu ,")) return 0;
        b = pexpr(L, P); if (!b) return 0;
        if (b != TY_I64) { P->err = "gpu len"; return 0; }
        if (!emit(P, OP_IWRAP, 0)) return 0;
        if (!expect(L, T_RP, P, "gpu )")) return 0;
        if (!emit(P, OP_GPU, 0)) return 0;
        if (!emit(P, OP_CONST, 0)) return 0;
        return TY_I64;
      }
    }
    {
      char nbuf[MAXN];
      int i, fi, g;
      strncpy(nbuf, L->id, MAXN - 1); nbuf[MAXN - 1] = 0;
      fi = find_fn(P, nbuf);
      next(L);
      if (L->tok == T_LP) {
        int native = find_native(P, nbuf);
        if (native >= 0) return native_invoke(L, P, native);
        for (int j = 0; j < P->import_count; j++)
          if (intrinsic_name(nbuf, P->imports[j].name)) return abi_invoke(L, P, j);
      }
      if (L->tok == T_LP && fi >= 0) return invoke_fn(L, P, fi);
      i = loc(P, nbuf, 0);
      if (i >= 0) {
        if (P->lty[i] >= TY_CLOSURE_BASE && L->tok == T_LP)
          return invoke_bound_fn(L, P, P->lty[i] - TY_CLOSURE_BASE, i);
        if (P->lty[i] == TY_FN && L->tok == T_LP) {
          if (fi < 0) { P->err = "fn idx"; return 0; }
          return invoke_fn(L, P, fi);
        }
        if (P->lty[i] == TY_LIST) P->list_elem_ty = P->lety[i];
        if (!emit(P, OP_LOAD, i)) return 0;
        return P->lty[i];
      }
      if (L->tok == T_DOT && (i = layout_find(P, nbuf)) >= 0)
        return layout_constant(L, P, i);
      g = glob(P, nbuf, 1); if (g < 0) return 0;
      if (L->tok == T_LS && P->gty[g] != TY_LIST && P->gty[g] != TY_DICT)
        P->gty[g] = TY_LIST;
      if (P->gty[g] == TY_LIST) P->list_elem_ty = P->glety[g] ? P->glety[g] : TY_F64;
      if (!emit(P, OP_GLOAD, (int64_t)g | ((int64_t)P->gty[g] << 16))) return 0;
      return P->gty[g];
    }
  }
  if (L->tok == T_LP && (!pact || !strcmp(pact, "paren"))) {
    next(L); int ty = pexpr(L, P); if (!ty) return 0;
    if (!expect(L, T_RP, P, "expected )")) return 0;
    return ty;
  }
  if (L->tok == T_MINUS && (!uact || !strcmp(uact, "neg"))) {
    next(L); int ty = pprim(L, P); if (!ty) return 0;
    if (!emit(P, ty == TY_F64 ? OP_FNEG : OP_NEG, 0)) return 0;
    return ty;
  }
  if (L->tok == T_NOT && (!uact || !strcmp(uact, "not"))) {
    next(L); int ty = pprim(L, P); if (!ty) return 0;
    if (ty != TY_I64) { P->err = "! needs i64"; return 0; }
    if (!emit(P, OP_NOT, 0)) return 0;
    return TY_I64;
  }
  P->err = "bad primary"; return 0;
}

static int ppostfix(Lex *L, Prog *P) {
  int ty = pprim(L, P); if (!ty) return 0;
  for (;;) {
    const char *xact = 0;
#ifdef UJS_HOST
    xact = parse_net_cls(3, L->tok);
    if (xact && !strcmp(xact, "bad")) { P->err = "parse-net"; return 0; }
    if (xact && !strcmp(xact, "done")) break;
#endif
    if (L->tok == T_LS && (!xact || !strcmp(xact, "index"))) {
      if (ty != TY_LIST) { P->err = "index non-list"; return 0; }
      next(L);
      int ity = pexpr(L, P); if (!ity) return 0;
      if (ity != TY_I64) { P->err = "index type"; return 0; }
      if (!expect(L, T_RS, P, "expected ]")) return 0;
      /* a = elem type hint in OP_IDXGET: 0=i64 1=f64 — set from list_elem_ty / lety */
      int et = P->list_elem_ty ? P->list_elem_ty : TY_I64;
      if (!emit(P, OP_IDXGET, et == TY_F64 ? 1 : 0)) return 0;
      ty = et;
    } else if (L->tok == T_DOT && (!xact || !strcmp(xact, "dot"))) {
      if (ty != TY_DICT) { P->err = "dot non-dict"; return 0; }
      next(L);
      if (L->tok != T_ID) { P->err = "dot name"; return 0; }
      {
        uint32_t kn = 0;
        while (L->id[kn]) kn++;
        if (kn > 8) { P->err = "dict key too long"; return 0; }
      }
      if (!emit_sconst_cstr(P, L->id)) return 0;
      next(L);
      if (!emit(P, OP_DOT, 0)) return 0;
      ty = TY_I64; /* subset: dot yields unboxed i64 (or f64 via tag — i64 for fold) */
    } else break;
  }
  return ty;
}
static int pmul(Lex *L, Prog *P) {
  int ty = ppostfix(L, P); if (!ty) return 0;
  for (;;) {
    uint8_t oi, of;
    if (L->tok==T_STAR) { oi=OP_MUL; of=OP_FMUL; }
    else if (L->tok==T_SLASH) { oi=OP_DIV; of=OP_FDIV; }
    else if (L->tok==T_PCT) {
      if (ty == TY_F64) { P->err = "f64 mod"; return 0; }
      oi=OP_MOD; of=OP_MOD;
    } else break;
    next(L); int ty2 = ppostfix(L, P); if (!ty2) return 0;
    if (oi == OP_MOD && ty2 == TY_F64) { P->err = "f64 mod"; return 0; }
    ty = bin_finish(P, ty, ty2, oi, of); if (!ty) return 0;
  }
  return ty;
}
static int padd(Lex *L, Prog *P) {
  int ty = pmul(L, P); if (!ty) return 0;
  for (;;) {
    uint8_t oi, of;
    if (L->tok==T_PLUS) { oi=OP_ADD; of=OP_FADD; }
    else if (L->tok==T_MINUS) { oi=OP_SUB; of=OP_FSUB; }
    else break;
    next(L); int ty2 = pmul(L, P); if (!ty2) return 0;
    if (ty == TY_STR || ty2 == TY_STR) {
      if (oi != OP_ADD || ty != TY_STR || ty2 != TY_STR) {
        P->err = "bad bin"; return 0;
      }
      if (!emit(P, OP_STRADD, 0)) return 0;
      ty = TY_STR;
      continue;
    }
    ty = bin_finish(P, ty, ty2, oi, of); if (!ty) return 0;
  }
  return ty;
}
static int pcmp(Lex *L, Prog *P) {
  int ty = padd(L, P); if (!ty) return 0;
  uint8_t opi, opf;
  if (L->tok==T_LT) { opi=OP_LT; opf=OP_FLT; }
  else if (L->tok==T_GT) { opi=OP_GT; opf=OP_FGT; }
  else if (L->tok==T_LE) { opi=OP_LE; opf=OP_FLE; }
  else if (L->tok==T_GE) { opi=OP_GE; opf=OP_FGE; }
  else if (L->tok==T_EQEQ) { opi=OP_EQ; opf=OP_FEQ; }
  else if (L->tok==T_NE) { opi=OP_NE; opf=OP_FNE; }
  else return ty;
  next(L); int ty2 = padd(L, P); if (!ty2) return 0;
  if (ty == TY_I64 && ty2 == TY_I64) {
    if (!emit(P, opi, 0)) return 0;
    return TY_I64;
  }
  if (ty == TY_I64 && ty2 == TY_F64) {
    if (ensure_fscratch(P) < 0) return 0;
    if (!emit(P, OP_I2F_R, 0)) return 0;
  } else if (ty == TY_F64 && ty2 == TY_I64) {
    if (!emit(P, OP_I2F, 0)) return 0;
  } else if (!(ty == TY_F64 && ty2 == TY_F64)) {
    P->err = "mixed num types"; return 0;
  }
  if (!emit(P, opf, 0)) return 0;
  return TY_I64;
}
/* a && b / a || b — short-circuit via IF0/IF1/IF2 + i64 scratch (JS-ish values) */
static int pand(Lex *L, Prog *P) {
  int ty = pcmp(L, P); if (!ty) return 0;
  while (L->tok == T_AND) {
    if (ty != TY_I64) { P->err = "&& needs i64"; return 0; }
    int sc = ensure_lscratch(P); if (sc < 0) return 0;
    next(L);
    if (!emit(P, OP_STORE, sc)) return 0;
    if (!emit(P, OP_LOAD, sc)) return 0;
    if (!emit(P, OP_IF0, 0)) return 0;
    int ty2 = pcmp(L, P); if (!ty2) return 0;
    if (ty2 != TY_I64) { P->err = "&& needs i64"; return 0; }
    if (!emit(P, OP_STORE, sc)) return 0;
    if (!emit(P, OP_IF1, 0)) return 0;
    if (!emit(P, OP_IF2, 0)) return 0;
    if (!emit(P, OP_LOAD, sc)) return 0;
    ty = TY_I64;
  }
  return ty;
}
static int por(Lex *L, Prog *P) {
  int ty = pand(L, P); if (!ty) return 0;
  while (L->tok == T_OR) {
    if (ty != TY_I64) { P->err = "|| needs i64"; return 0; }
    int sc = ensure_lscratch(P); if (sc < 0) return 0;
    next(L);
    if (!emit(P, OP_STORE, sc)) return 0;
    if (!emit(P, OP_LOAD, sc)) return 0;
    if (!emit(P, OP_IF0, 0)) return 0;
    if (!emit(P, OP_IF1, 0)) return 0;
    int ty2 = pand(L, P); if (!ty2) return 0;
    if (ty2 != TY_I64) { P->err = "|| needs i64"; return 0; }
    if (!emit(P, OP_STORE, sc)) return 0;
    if (!emit(P, OP_IF2, 0)) return 0;
    if (!emit(P, OP_LOAD, sc)) return 0;
    ty = TY_I64;
  }
  return ty;
}
/* cond ? then : else — i64 only (stage0); uses IF0/1/2 + scratch.
   null ?? e — stage0: only literal null on the left (corpus). */
static int pexpr(Lex *L, Prog *P) {
  int ty;
  if (L->tok == T_NULL) {
    next(L);
    if (L->tok != T_QQ) { P->err = "null needs ??"; return 0; }
    next(L);
    return pexpr(L, P);
  }
  ty = por(L, P); if (!ty) return 0;
  if (L->tok != T_QMARK) return ty;
  if (ty != TY_I64) { P->err = "?: cond needs i64"; return 0; }
  {
    int sc = ensure_lscratch(P); if (sc < 0) return 0;
    int t1, t2;
    next(L);
    if (!emit(P, OP_IF0, 0)) return 0;
    t1 = por(L, P); if (!t1) return 0;
    if (t1 != TY_I64) { P->err = "?: then needs i64"; return 0; }
    if (!emit(P, OP_STORE, sc)) return 0;
    if (!expect(L, T_COLON, P, "expected :")) return 0;
    if (!emit(P, OP_IF1, 0)) return 0;
    t2 = por(L, P); if (!t2) return 0;
    if (t2 != TY_I64) { P->err = "?: else needs i64"; return 0; }
    if (!emit(P, OP_STORE, sc)) return 0;
    if (!emit(P, OP_IF2, 0)) return 0;
    if (!emit(P, OP_LOAD, sc)) return 0;
    return TY_I64;
  }
}

static int pblock(Lex *L, Prog *P) {
  if (!expect(L, T_LB, P, "expected {")) return 0;
  while (L->tok != T_RB && L->tok != T_EOF)
    if (!pstmt(L, P)) return 0;
  return expect(L, T_RB, P, "expected }");
}

static int pstmt(Lex *L, Prog *P) {
  const char *act = 0;
  if (L->tok == T_BAD) { P->err = "bad token"; return 0; }
#ifdef UJS_HOST
  act = parse_net_cls(1, L->tok);
  if (act && !strcmp(act, "bad")) { P->err = "parse-net"; return 0; }
#endif
  if (L->tok == T_FUNCTION && (!act || !strcmp(act, "fn"))) {
    FnDef F;
    int fi, li;
    memset(&F, 0, sizeof F);
    next(L);
    if (L->tok != T_ID) { P->err = "fn name"; return 0; }
    strncpy(F.name, L->id, MAXN - 1); F.name[MAXN - 1] = 0;
    next(L);
    if (!expect(L, T_LP, P, "fn (")) return 0;
    if (L->tok == T_ELLIPSIS) {
      next(L);
      if (L->tok != T_ID) { P->err = "rest name"; return 0; }
      strncpy(F.rest, L->id, MAXN - 1); F.rest[MAXN - 1] = 0;
      F.has_rest = 1;
      next(L);
    } else if (L->tok == T_ID) {
      strncpy(F.p0, L->id, MAXN - 1); F.p0[MAXN - 1] = 0;
      F.has_p0 = 1;
      next(L);
      if (L->tok == T_COMMA) {
        next(L);
        if (L->tok != T_ELLIPSIS) { P->err = "only ...rest after param"; return 0; }
        next(L);
        if (L->tok != T_ID) { P->err = "rest name"; return 0; }
        strncpy(F.rest, L->id, MAXN - 1); F.rest[MAXN - 1] = 0;
        F.has_rest = 1;
        next(L);
      }
    }
    if (!expect(L, T_RP, P, "fn )")) return 0;
    if (!capture_block_body(L, P, &F)) return 0;
    if (!expect(L, T_RB, P, "fn }")) return 0;
    fi = register_fn(P, &F); if (fi < 0) return 0;
    li = bind_local(P, F.name, TY_FN); if (li < 0) return 0;
    P->lty[li] = TY_FN;
    if (!emit(P, OP_CONST, fi)) return 0;
    if (!emit(P, OP_STORE, li)) return 0;
    return 1;
  }
  if (L->tok == T_PERSIST) {
    next(L);
    if (L->tok != T_LET) { P->err = "persist let"; return 0; }
    next(L);
    if (L->tok != T_ID) { P->err = "let name"; return 0; }
    {
      int g, tmp, ty;
      g = glob(P, L->id, 1); if (g < 0) return 0;
      P->gpersist[g] = 1;
      next(L);
      if (!expect(L, T_EQ, P, "expected =")) return 0;
      ty = pexpr(L, P); if (!ty) return 0;
      if (ty >= TY_CLOSURE_BASE) { P->err = "closure cannot persist across ABI calls"; return 0; }
      P->gty[g] = (uint8_t)ty;
      tmp = (ty == TY_F64) ? ensure_fscratch(P) : ensure_lscratch(P);
      if (tmp < 0) return 0;
      if (!emit(P, OP_PLET, (int64_t)g | ((int64_t)ty << 16) | ((int64_t)tmp << 32))) return 0;
      return expect(L, T_SEMI, P, "expected ;");
    }
  }

  if (L->tok == T_LET && (!act || !strcmp(act, "let"))) {
    next(L);
    if (L->tok != T_ID) { P->err = "let name"; return 0; }
    {
      char nm[MAXN];
      int i;
      strncpy(nm, L->id, MAXN - 1); nm[MAXN - 1] = 0;
      next(L);
      if (!expect(L, T_EQ, P, "expected =")) return 0;
      /* let f = x => …  /  let f = x => { … } */
      if (L->tok == T_ID) {
        uint32_t save_pos = L->pos; int save_tok = L->tok;
        int64_t save_num = L->num; double save_fnum = L->fnum;
        uint32_t save_ts = L->tok_start;
        char save_id[64]; strncpy(save_id, L->id, 64);
        char pname[MAXN];
        strncpy(pname, L->id, MAXN - 1); pname[MAXN - 1] = 0;
        next(L);
        if (L->tok == T_ARROW) {
          FnDef F;
          int fi, li;
          memset(&F, 0, sizeof F);
          strncpy(F.name, nm, MAXN - 1); F.name[MAXN - 1] = 0;
          strncpy(F.p0, pname, MAXN - 1); F.p0[MAXN - 1] = 0;
          F.has_p0 = 1;
          next(L);
          if (L->tok == T_LB) {
            if (!capture_block_body(L, P, &F)) return 0;
            if (!expect(L, T_RB, P, "arrow }")) return 0;
            if (!expect(L, T_SEMI, P, "expected ;")) return 0;
          } else {
            if (!capture_expr_body(L, P, &F)) return 0;
            if (!expect(L, T_SEMI, P, "expected ;")) return 0;
          }
          fi = register_fn(P, &F); if (fi < 0) return 0;
          li = bind_local(P, nm, TY_FN); if (li < 0) return 0;
          P->lty[li] = TY_FN;
          if (!emit(P, OP_CONST, fi)) return 0;
          if (!emit(P, OP_STORE, li)) return 0;
          return 1;
        }
        L->pos = save_pos; L->tok = save_tok; L->num = save_num; L->fnum = save_fnum;
        L->tok_start = save_ts; strncpy(L->id, save_id, 64);
      }
      int previous = local_here(P, nm);
      int dormant = previous < 0 ? reuse_local(P, nm, TY_ERR) : -1;
      i = previous >= 0 ? previous : dormant;
      if (i < 0) i = fresh_local(P, nm);
      if (i < 0) return 0;
      if (previous < 0) P->local_scope[i] = LOCAL_RESERVED;
      {
        int ty = pexpr(L, P); if (!ty) return 0;
        // The emitter uses one Wasm local type per slot, including all earlier stores.
        if (previous >= 0 && P->lty[previous] != ty) {
          P->err = "local redeclaration changes type"; return 0;
        }
        if (dormant >= 0 && P->lty[dormant] != ty) {
          P->local_scope[dormant] = 0;
          i = bind_local(P, nm, ty);
          if (i < 0) return 0;
        }
        P->local_scope[i] = (uint16_t)(P->in_fn + 1);
        P->lty[i] = (uint8_t)ty;
        if (ty == TY_LIST) P->lety[i] = (uint8_t)P->list_elem_ty;
        if (!emit(P, OP_STORE, i)) return 0;
        return expect(L, T_SEMI, P, "expected ;");
      }
    }
  }
  if (L->tok == T_WHILE && (!act || !strcmp(act, "while"))) {
    next(L);
    if (!emit(P, OP_WBEGIN, 0)) return 0;
    if (!expect(L, T_LP, P, "while (")) return 0;
    int ty = pexpr(L, P); if (!ty) return 0;
    if (ty != TY_I64) { P->err = "while cond"; return 0; }
    if (!expect(L, T_RP, P, "while )")) return 0;
    if (!emit(P, OP_WCOND, 0)) return 0;
    if (!pblock(L, P)) return 0;
    return emit(P, OP_WEND, 0);
  }
  /* for (let x of listExpr) { … } → while index walk (no iterator protocol) */
  if (L->tok == T_FOR && (!act || !strcmp(act, "for"))) {
    static int fo_gen;
    char an[MAXN], in[MAXN], xn[MAXN];
    int xa, ia, va, ty, et;
    next(L);
    if (!expect(L, T_LP, P, "for (")) return 0;
    if (!expect(L, T_LET, P, "for let")) return 0;
    if (L->tok != T_ID) { P->err = "for name"; return 0; }
    strncpy(xn, L->id, MAXN - 1); xn[MAXN - 1] = 0;
    next(L);
    if (!expect(L, T_OF, P, "for of")) return 0;
    ty = pexpr(L, P); if (!ty) return 0;
    if (ty != TY_LIST) { P->err = "for-of list"; return 0; }
    et = P->list_elem_ty ? P->list_elem_ty : TY_I64;
    if (!expect(L, T_RP, P, "for )")) return 0;
    snprintf(an, sizeof an, "#a%d", fo_gen);
    snprintf(in, sizeof in, "#i%d", fo_gen);
    fo_gen++;
    xa = bind_local(P, an, TY_LIST); if (xa < 0) return 0;
    ia = bind_local(P, in, TY_I64); if (ia < 0) return 0;
    va = bind_local(P, xn, et); if (va < 0) return 0;
    P->lty[xa] = TY_LIST; P->lety[xa] = (uint8_t)et;
    P->lty[ia] = TY_I64;
    P->lty[va] = (uint8_t)et;
    if (!emit(P, OP_STORE, xa)) return 0;
    if (!emit(P, OP_CONST, 0)) return 0;
    if (!emit(P, OP_STORE, ia)) return 0;
    if (!emit(P, OP_WBEGIN, 0)) return 0;
    if (!emit(P, OP_LOAD, ia)) return 0;
    if (!emit(P, OP_LOAD, xa)) return 0;
    if (!emit(P, OP_LEN, 0)) return 0;
    if (!emit(P, OP_LT, 0)) return 0;
    if (!emit(P, OP_WCOND, 0)) return 0;
    if (!emit(P, OP_LOAD, xa)) return 0;
    if (!emit(P, OP_LOAD, ia)) return 0;
    P->list_elem_ty = et;
    if (!emit(P, OP_IDXGET, et == TY_F64 ? 1 : 0)) return 0;
    if (!emit(P, OP_STORE, va)) return 0;
    if (!pblock(L, P)) return 0;
    if (!emit(P, OP_LOAD, ia)) return 0;
    if (!emit(P, OP_CONST, 1)) return 0;
    if (!emit(P, OP_ADD, 0)) return 0;
    if (!emit(P, OP_STORE, ia)) return 0;
    return emit(P, OP_WEND, 0);
  }
  if (L->tok == T_IF && (!act || !strcmp(act, "if"))) {
    next(L);
    if (!expect(L, T_LP, P, "if (")) return 0;
    int ty = pexpr(L, P); if (!ty) return 0;
    if (ty != TY_I64) { P->err = "if cond"; return 0; }
    if (!expect(L, T_RP, P, "if )")) return 0;
    if (!emit(P, OP_IF0, 0)) return 0;
    if (!pblock(L, P)) return 0;
    if (!emit(P, OP_IF1, 0)) return 0;
    if (L->tok == T_ELSE) {
      next(L);
      /* else if (...) … — reuse if path; else still requires { block */
      if (L->tok == T_IF) {
        if (!pstmt(L, P)) return 0;
      } else {
        if (!pblock(L, P)) return 0;
      }
    }
    return emit(P, OP_IF2, 0);
  }
  /* switch (i64) { case N: … default: … } — no fallthrough; bodies usually return */
  if (L->tok == T_SWITCH && (!act || !strcmp(act, "switch"))) {
    int sc, ty;
    next(L);
    if (!expect(L, T_LP, P, "switch (")) return 0;
    ty = pexpr(L, P); if (!ty) return 0;
    if (ty != TY_I64) { P->err = "switch needs i64"; return 0; }
    if (!expect(L, T_RP, P, "switch )")) return 0;
    if (!expect(L, T_LB, P, "switch {")) return 0;
    sc = ensure_lscratch(P); if (sc < 0) return 0;
    if (!emit(P, OP_STORE, sc)) return 0;
    for (;;) {
      const char *sact = 0;
#ifdef UJS_HOST
      sact = parse_net_cls(5, L->tok);
      if (sact && !strcmp(sact, "bad")) { P->err = "parse-net"; return 0; }
      if (sact && !strcmp(sact, "done")) break;
#endif
      if (L->tok == T_CASE && (!sact || !strcmp(sact, "case"))) {
        next(L);
        if (L->tok != T_NUM) { P->err = "case int"; return 0; }
        {
          int64_t cv = L->num;
          next(L);
          if (!expect(L, T_COLON, P, "case :")) return 0;
          if (!emit(P, OP_LOAD, sc)) return 0;
          if (!emit(P, OP_CONST, cv)) return 0;
          if (!emit(P, OP_EQ, 0)) return 0;
          if (!emit(P, OP_IF0, 0)) return 0;
          while (L->tok != T_CASE && L->tok != T_DEFAULT && L->tok != T_RB && L->tok != T_EOF)
            if (!pstmt(L, P)) return 0;
          if (!emit(P, OP_IF1, 0)) return 0;
          if (!emit(P, OP_IF2, 0)) return 0;
        }
        continue;
      }
      if (L->tok == T_DEFAULT && (!sact || !strcmp(sact, "default"))) {
        next(L);
        if (!expect(L, T_COLON, P, "default :")) return 0;
        while (L->tok != T_RB && L->tok != T_EOF)
          if (!pstmt(L, P)) return 0;
        break;
      }
      break;
    }
    return expect(L, T_RB, P, "switch }");
  }
  if (L->tok == T_RETURN && (!act || !strcmp(act, "return"))) {
    next(L);
    int ty = pexpr(L, P); if (!ty) return 0;
    if (P->in_fn > 0) {
      if (P->fn_ret < 0) { P->err = "fn ret"; return 0; }
      if (P->fn_did_ret && P->lty[P->fn_ret] != ty) { P->err = "fn return type changed"; return 0; }
      P->lty[P->fn_ret] = (uint8_t)ty;
      if (!emit(P, OP_STORE, P->fn_ret)) return 0;
      P->fn_did_ret = 1;
      return expect(L, T_SEMI, P, "expected ;");
    }
    if (P->abi_version || P->native_result) {
      int result_type = P->native_result ? P->native_result : P->api.result;
      if (ty != result_type) { P->err = P->native_result ? "native return type" : "abi return type"; return 0; }
      P->native_return = 1;
      if (!emit(P, OP_ABI_RET, 0)) return 0;
      return expect(L, T_SEMI, P, "expected ;");
    }
    {
      uint8_t op = OP_RET;
      if (ty == TY_F64) op = OP_FRET;
      else if (ty >= TY_CLOSURE_BASE) { P->err = "closure cannot cross the host ABI"; return 0; }
      else if (ty == TY_LIST || ty == TY_DICT || ty == TY_STR) op = OP_HRET;
      if (!emit(P, op, 0)) return 0;
      return expect(L, T_SEMI, P, "expected ;");
    }
  }
  if (L->tok == T_ID) {
    char name[MAXN];
    strncpy(name, L->id, MAXN - 1); name[MAXN - 1] = 0;
    next(L);
    if (L->tok == T_LS) {
      /* xs[i] = e  (local or global list) */
      int is_g = 0;
      int li = loc(P, name, 0);
      if (li < 0) {
        li = glob(P, name, 1); if (li < 0) return 0;
        is_g = 1;
        if (P->gty[li] != TY_LIST && P->gty[li] != TY_I64) {
          /* first use as list via setidx — mark as list */
        }
        P->gty[li] = TY_LIST;
      } else if (P->lty[li] != TY_LIST) { P->err = "setidx non-list"; return 0; }
      if (!emit(P, is_g ? OP_GLOAD : OP_LOAD,
                is_g ? ((int64_t)li | ((int64_t)P->gty[li] << 16)) : (int64_t)li)) return 0;
      next(L);
      int ity = pexpr(L, P); if (!ity) return 0;
      if (ity != TY_I64) { P->err = "index type"; return 0; }
      if (!emit(P, OP_IWRAP, 0)) return 0;
      if (!expect(L, T_RS, P, "expected ]")) return 0;
      if (!expect(L, T_EQ, P, "expected =")) return 0;
      int vty = pexpr(L, P); if (!vty) return 0;
      int et = is_g ? P->glety[li] : P->lety[li];
      if (!et) et = TY_I64;
      if (vty != et && !(et == TY_I64 && vty == TY_I64)) {
        if (vty != TY_I64 && vty != TY_F64) { P->err = "setidx val"; return 0; }
        /* allow setting elem type on first write */
        if (is_g) P->glety[li] = (uint8_t)vty; else P->lety[li] = (uint8_t)vty;
        et = vty;
      }
      if (vty != et) { P->err = "setidx val"; return 0; }
      if (!emit(P, vty == TY_F64 ? OP_BOXF : OP_BOXI, 0)) return 0;
      if (!emit(P, OP_IDXSET, 0)) return 0;
      return expect(L, T_SEMI, P, "expected ;");
    }
    {
      const char *k = "host_gpu_submit";
      int hi = 0;
      while (k[hi] && name[hi] == k[hi]) hi++;
      if (!k[hi] && !name[hi] && L->tok == T_LP) {
        int a, b;
        next(L);
        a = pexpr(L, P); if (!a) return 0;
        if (a != TY_I64) { P->err = "gpu ptr"; return 0; }
        if (!emit(P, OP_IWRAP, 0)) return 0;
        if (!expect(L, T_COMMA, P, "gpu ,")) return 0;
        b = pexpr(L, P); if (!b) return 0;
        if (b != TY_I64) { P->err = "gpu len"; return 0; }
        if (!emit(P, OP_IWRAP, 0)) return 0;
        if (!expect(L, T_RP, P, "gpu )")) return 0;
        if (!emit(P, OP_GPU, 0)) return 0;
        return expect(L, T_SEMI, P, "expected ;");
      }
    }
    {
      int plus_eq = 0;
      int is_g = 0;
      int i, ty;
      if (L->tok == T_PLUS) {
        next(L);
        if (L->tok != T_EQ) { P->err = "expected ="; return 0; }
        plus_eq = 1;
      } else if (L->tok != T_EQ) { P->err = "expected ="; return 0; }
      i = loc(P, name, 0);
      if (i < 0) {
        i = glob(P, name, 1); if (i < 0) return 0;
        is_g = 1;
      }
      next(L);
      if (plus_eq) {
        if (is_g) {
          if (!emit(P, OP_GLOAD, (int64_t)i | ((int64_t)P->gty[i] << 16))) return 0;
        } else {
          if (!emit(P, OP_LOAD, i)) return 0;
        }
      }
      ty = pexpr(L, P); if (!ty) return 0;
      if (plus_eq) {
        if (ty != TY_I64) { P->err = "+= needs i64"; return 0; }
        if (!is_g && (int)P->lty[i] != TY_I64) { P->err = "+= needs i64"; return 0; }
        if (is_g && P->gty[i] != TY_I64) { P->err = "+= needs i64"; return 0; }
        if (!emit(P, OP_ADD, 0)) return 0;
        ty = TY_I64;
      } else if (is_g) {
        if (ty >= TY_CLOSURE_BASE) { P->err = "closure assignment requires a local"; return 0; }
        P->gty[i] = (uint8_t)ty;
        if (ty == TY_LIST) P->glety[i] = (uint8_t)P->list_elem_ty;
      } else {
        /* inject list elems are f64; allow trunc into i64 locals (char codes) */
        if (ty == TY_F64 && (int)P->lty[i] == TY_I64) {
          if (!emit(P, OP_F2I, 0)) return 0;
          ty = TY_I64;
        } else if (ty != (int)P->lty[i]) { P->err = "assign type"; return 0; }
      }
      if (!emit(P, is_g ? OP_GSTORE : OP_STORE,
                is_g ? ((int64_t)i | ((int64_t)P->gty[i] << 16)) : (int64_t)i)) return 0;
      return expect(L, T_SEMI, P, "expected ;");
    }
  }
  P->err = "bad stmt"; return 0;
}

/* ---- wasm binary ---- */
static int emit_cmp(Buf *c, uint8_t op) {
  uint8_t w;
  switch (op) {
  case OP_LT: w=0x53; break; case OP_GT: w=0x55; break;
  case OP_LE: w=0x57; break; case OP_GE: w=0x59; break;
  case OP_EQ: w=0x51; break; case OP_NE: w=0x52; break;
  default: return 0;
  }
  if (!bu8(c, w)) return 0;
  return bu8(c, 0xad); /* i64.extend_i32_u */
}

static int ux_trap_if(Buf *c) {
  return bu8(c, 0x04) && bu8(c, 0x40) && bu8(c, 0x00) && bu8(c, 0x0b);
}

static int ux_check_limit(Buf *c, int64_t limit) {
  return bu8(c, 0x42) && blei64(c, limit) && bu8(c, 0x56) && ux_trap_if(c);
}

static int str_byte_address(Buf *c, uint32_t source, uint32_t index) {
  return bu8(c, 0x20) && bleu(c, source) && bi32(c, 8) && bu8(c, 0x6a) &&
      bu8(c, 0x20) && bleu(c, index) && bu8(c, 0xa7) && bu8(c, 0x6a);
}

static int str_slice_boundary(Buf *c, uint32_t source, uint32_t index, uint32_t length) {
  return bu8(c, 0x20) && bleu(c, index) && bu8(c, 0xa7) &&
      bu8(c, 0x20) && bleu(c, length) && bu8(c, 0x47) &&
      bu8(c, 0x04) && bu8(c, 0x40) &&
      str_byte_address(c, source, index) && bu8(c, 0x2d) && bleu(c, 0) && bleu(c, 0) &&
      bi32(c, 0xc0) && bu8(c, 0x71) && bi32(c, 0x80) && bu8(c, 0x46) &&
      ux_trap_if(c) && bu8(c, 0x0b);
}

static int emit_string_slice(Buf *c, uint32_t args) {
  uint32_t source = args & 255, start = (args >> 8) & 255;
  uint32_t end = (args >> 16) & 255, length = args >> 24;
  if (!(bu8(c, 0x20) && bleu(c, source) && wcall(c, 10) &&
        bu8(c, 0x22) && bleu(c, length) && bu8(c, 0xad) &&
        bu8(c, 0x20) && bleu(c, end) && bu8(c, 0x54) && ux_trap_if(c))) return 0;
  if (!(bu8(c, 0x20) && bleu(c, start) && bu8(c, 0x20) && bleu(c, end) &&
        bu8(c, 0x56) && ux_trap_if(c))) return 0;
  return str_slice_boundary(c, source, start, length) &&
      str_slice_boundary(c, source, end, length) && str_byte_address(c, source, start) &&
      bu8(c, 0x20) && bleu(c, end) && bu8(c, 0x20) && bleu(c, start) &&
      bu8(c, 0x7d) && bu8(c, 0xa7) && wcall(c, 11);
}

static int emit_ops(Buf *c, Prog *P) {
  for (int i = 0; i < P->nc; i++) {
    Ins *ins = &P->code[i];
    switch (ins->op) {
    case OP_FLOOR_I64:
      if (!bu8(c, 0x9c) || !bu8(c, 0xb0)) return 0;
      break;
    case OP_I32_BITS:
      if (!(ins->a & I32_UNARY) && !bu8(c, (uint8_t)ins->a)) return 0;
      if (!bu8(c, ins->a & I32_SIGNED ? 0xac : 0xad)) return 0;
      break;
    case OP_ABI_CALL:
      if (!bu8(c, 0x10) || !bleu(c, (uint32_t)(g_need_gpu + ins->a))) return 0;
      break;
    case OP_NATIVE_CALL:
      if (!wcall(c, (uint32_t)(P->native_base + ins->a))) return 0;
      break;
    case OP_ABI_RET:
      if (!bu8(c, 0x0f)) return 0;
      break;
    case OP_FSQRT:
      if (!bu8(c, 0x9f)) return 0;
      break;
    case OP_UX_ADDR: {
      uint32_t offset = (uint32_t)ins->a >> 8;
      int width = (int)(ins->a & 255);
      if (!bu8(c, 0x22) || !bleu(c, offset) || !ux_check_limit(c, UX_BUFFER_SIZE - width)) return 0;
      if (!bu8(c, 0x20) || !bleu(c, offset) || !bu8(c, 0xa7)) return 0;
      if (!bi32(c, UX_BUFFER_BASE) || !bu8(c, 0x6a)) return 0;
      break;
    }
    case OP_UX_BYTE:
      if (!bu8(c, 0x22) || !bleu(c, (uint32_t)ins->a) || !ux_check_limit(c, 255)) return 0;
      if (!bu8(c, 0x20) || !bleu(c, (uint32_t)ins->a) || !bu8(c, 0xa7)) return 0;
      break;
    case OP_UX_SPAN: {
      uint32_t count = (uint32_t)ins->a >> 8;
      uint32_t addr = (uint32_t)ins->a & 255;
      if (!bu8(c, 0x21) || !bleu(c, count) || !bu8(c, 0x21) || !bleu(c, addr)) return 0;
      if (!bu8(c, 0x20) || !bleu(c, count)) return 0;
      if (!bu8(c, 0x42) || !blei64(c, UX_BUFFER_BASE + UX_BUFFER_SIZE)) return 0;
      if (!bu8(c, 0x20) || !bleu(c, addr) || !bu8(c, 0xad) || !bu8(c, 0x7d)) return 0;
      if (!bu8(c, 0x56) || !ux_trap_if(c)) return 0;
      if (!bu8(c, 0x20) || !bleu(c, addr) || !bu8(c, 0xad)) return 0;
      break;
    }
    case OP_UX_LOAD: {
      static const uint8_t load[] = {0, 0x2d, 0x2f, 0x28, 0x2a, 0x28, 0x2b};
      if (!bu8(c, load[ins->a]) || !bu8(c, 0) || !bleu(c, 0)) return 0;
      if (ins->a != UX_F64 &&
          !bu8(c, ins->a == UX_F32 ? 0xbb : ins->a == UX_I32 ? 0xac : 0xad)) return 0;
      break;
    }
    case OP_UX_STORE: {
      static const uint8_t store[] = {0, 0x3a, 0x3b, 0x36, 0x38, 0x36, 0x39};
      if (ins->a == UX_F32 && !bu8(c, 0xb6)) return 0;
      if (!bu8(c, store[ins->a]) || !bu8(c, 0) || !bleu(c, 0)) return 0;
      break;
    }
    case OP_CONST:
      if (!bu8(c, 0x42) || !blei64(c, ins->a)) return 0; break;
    case OP_FCONST:
      if (!bu8(c, 0x44) || !bf64(c, ins->a)) return 0; break;
    case OP_LOAD:
      if (!bu8(c, 0x20) || !bleu(c, (uint32_t)ins->a)) return 0; break;
    case OP_STORE:
      if (!bu8(c, 0x21) || !bleu(c, (uint32_t)ins->a)) return 0; break;
    case OP_ADD: if (!bu8(c, 0x7c)) return 0; break;
    case OP_SUB: if (!bu8(c, 0x7d)) return 0; break;
    case OP_MUL: if (!bu8(c, 0x7e)) return 0; break;
    case OP_DIV: if (!bu8(c, 0x7f)) return 0; break;
    case OP_MOD: if (!bu8(c, 0x81)) return 0; break;
    case OP_FADD: if (!bu8(c, 0xa0)) return 0; break;
    case OP_FSUB: if (!bu8(c, 0xa1)) return 0; break;
    case OP_FMUL: if (!bu8(c, 0xa2)) return 0; break;
    case OP_FDIV: if (!bu8(c, 0xa3)) return 0; break;
    case OP_LT: case OP_GT: case OP_LE: case OP_GE: case OP_EQ: case OP_NE:
      if (!emit_cmp(c, ins->op)) return 0; break;
    case OP_NEG:
      if (!bu8(c, 0x42) || !blei64(c, -1) || !bu8(c, 0x7e)) return 0; break;
    case OP_FNEG:
      if (!bu8(c, 0x9a)) return 0; break; /* f64.neg */
    case OP_NOT:
      if (!bu8(c, 0x50)) return 0; /* i64.eqz */
      if (!bu8(c, 0xad)) return 0; /* i64.extend_i32_u */
      break;
    case OP_WBEGIN:
      if (!bu8(c, 0x02) || !bu8(c, 0x40)) return 0;
      if (!bu8(c, 0x03) || !bu8(c, 0x40)) return 0;
      break;
    case OP_WCOND:
      if (!bu8(c, 0xa7)) return 0;
      if (!bu8(c, 0x45)) return 0;
      if (!bu8(c, 0x0d) || !bleu(c, 1)) return 0;
      break;
    case OP_WEND:
      if (!bu8(c, 0x0c) || !bleu(c, 0)) return 0;
      if (!bu8(c, 0x0b) || !bu8(c, 0x0b)) return 0;
      break;
    case OP_IF0:
      if (!bu8(c, 0xa7)) return 0;
      if (!bu8(c, 0x04) || !bu8(c, 0x40)) return 0;
      break;
    case OP_IF1:
      if (!bu8(c, 0x05)) return 0;
      break;
    case OP_IF2:
      if (!bu8(c, 0x0b)) return 0;
      break;
    case OP_BOXI:
      if (!wcall(c, 0)) return 0; /* call mk_i64 */
      break;
    case OP_BOXF:
      if (!wcall(c, 4)) return 0; /* call mk_f64 */
      break;
    case OP_MKLIST:
      if (!bu8(c, 0x41) || !blei32(c, (int32_t)ins->a)) return 0;
      if (!wcall(c, 6)) return 0; /* call mk_list */
      break;
    case OP_MKLIST_DYN:
      /* n already i32 on stack */
      if (!wcall(c, 6)) return 0;
      break;
    case OP_LSET:
      if (!bu8(c, 0x41) || !blei32(c, (int32_t)ins->a)) return 0;
      if (!wcall(c, 8)) return 0;
      break;
    case OP_IDXGET:
      if (!bu8(c, 0xa7)) return 0;
      if (!wcall(c, 7)) return 0; /* list_get */
      if (ins->a)
        { if (!wcall(c, 5)) return 0; } /* f64_of */
      else
        { if (!wcall(c, 3)) return 0; } /* i64_of */
      break;
    case OP_IWRAP:
      if (!bu8(c, 0xa7)) return 0;
      break;
    case OP_I2F:
      if (!bu8(c, 0xb9)) return 0;
      break;
    case OP_F2I:
      if (!bu8(c, 0xb0)) return 0; /* i64.trunc_f64_s */
      break;
    case OP_I2F_R: {
      int fs = ensure_fscratch(P); if (fs < 0) return 0;
      /* stack i64 f64 → local.set fs; convert; local.get fs */
      if (!bu8(c, 0x21) || !bleu(c, (uint32_t)fs)) return 0;
      if (!bu8(c, 0xb9)) return 0;
      if (!bu8(c, 0x20) || !bleu(c, (uint32_t)fs)) return 0;
      break;
    }
    case OP_FLT: case OP_FGT: case OP_FLE: case OP_FGE: case OP_FEQ: case OP_FNE: {
      uint8_t w = 0x63; /* f64.lt */
      if (ins->op == OP_FGT) w = 0x64;
      else if (ins->op == OP_FLE) w = 0x65;
      else if (ins->op == OP_FGE) w = 0x66;
      else if (ins->op == OP_FEQ) w = 0x61;
      else if (ins->op == OP_FNE) w = 0x62;
      if (!bu8(c, w)) return 0;
      if (!bu8(c, 0xad)) return 0; /* extend to i64 */
      break;
    }
    case OP_IDXSET:
      if (!wcall(c, 9)) return 0;
      break;
    case OP_LEN:
      if (!wcall(c, 10)) return 0;
      if (!bu8(c, 0xad)) return 0;
      break;
    case OP_GLOAD: {
      uint32_t slot = (uint32_t)(ins->a & 0xffff);
      uint8_t ty = (uint8_t)((ins->a >> 16) & 0xff);
      if (!ty) ty = P->gty[slot];
      if (slot < MAXG && P->gpersist[slot]) {
        uint32_t pa = (uint32_t)PERSIST_BASE + slot * (uint32_t)PERSIST_STRIDE + 8u;
        if (!bi32(c, (int32_t)pa)) return 0;
        if (ty == TY_F64) {
          if (!bu8(c, 0x2b) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
        } else {
          if (!bu8(c, 0x29) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
        }
        break;
      }
      {
        uint32_t addr = GBASE + slot * 4u;
        if (!bi32(c, (int32_t)addr)) return 0;
        if (!bu8(c, 0x28) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
        if (ty == TY_F64) {
          if (!wcall(c, 5)) return 0;
        } else if (ty == TY_I64) {
          if (!wcall(c, 3)) return 0;
        }
      }
      break;
    }
    case OP_GSTORE: {
      uint32_t slot = (uint32_t)(ins->a & 0xffff);
      uint8_t ty = (uint8_t)((ins->a >> 16) & 0xff);
      if (!ty) ty = P->gty[slot];
      if (slot < MAXG && P->gpersist[slot]) {
        int tmp;
        uint32_t pa = (uint32_t)PERSIST_BASE + slot * (uint32_t)PERSIST_STRIDE + 8u;
        if (ty == TY_F64) {
          tmp = P->fscratch;
          if (tmp < 0) { tmp = ensure_fscratch(P); if (tmp < 0) return 0; }
          if (!bu8(c, 0x21) || !bleu(c, (uint32_t)tmp)) return 0;
          if (!bi32(c, (int32_t)pa)) return 0;
          if (!bu8(c, 0x20) || !bleu(c, (uint32_t)tmp)) return 0;
          if (!bu8(c, 0x39) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
        } else {
          tmp = P->lscratch;
          if (tmp < 0) { tmp = ensure_lscratch(P); if (tmp < 0) return 0; }
          if (!bu8(c, 0x21) || !bleu(c, (uint32_t)tmp)) return 0;
          if (!bi32(c, (int32_t)pa)) return 0;
          if (!bu8(c, 0x20) || !bleu(c, (uint32_t)tmp)) return 0;
          if (!bu8(c, 0x37) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
        }
        break;
      }
      if (ty == TY_I64) {
        if (!wcall(c, 0)) return 0;
      } else if (ty == TY_F64) {
        if (!wcall(c, 4)) return 0;
      }
      if (!bi32(c, (int32_t)slot)) return 0;
      if (!wcall(c, 15)) return 0;
      break;
    }
    case OP_STRADD:
      if (!wcall(c, 18)) return 0;
      break;
    case OP_STRSLICE:
      if (!emit_string_slice(c, (uint32_t)ins->a)) return 0;
      break;
    case OP_SCONST: {
      /* a = (pool_off << 16) | len → bytes at SCRATCH0, call mk_str */
      uint64_t v = (uint64_t)ins->a;
      uint32_t n = (uint32_t)(v & 0xffff);
      uint32_t off = (uint32_t)(v >> 16);
      if (off + n > P->sn) return 0;
      for (uint32_t i = 0; i < n; i++) {
        uint8_t ch = P->sdata[off + i];
        if (!bi32(c, (int32_t)(SCRATCH0 + i))) return 0;
        if (!bi32(c, (int32_t)(ch))) return 0;
        if (!bu8(c, 0x3a) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
      }
      if (!bi32(c, (int32_t)(SCRATCH0))) return 0;
      if (!bi32(c, (int32_t)(n))) return 0;
      if (!wcall(c, 11)) return 0; /* mk_str */
      break;
    }
    case OP_MKDICT:
      if (!bu8(c, 0x41) || !blei32(c, (int32_t)ins->a)) return 0;
      if (!wcall(c, 12)) return 0; /* mk_dict */
      break;
    case OP_DSET:
      /* stack h k v → push i → dict_set_hkvi */
      if (!bu8(c, 0x41) || !blei32(c, (int32_t)ins->a)) return 0;
      if (!wcall(c, 16)) return 0;
      break;
    case OP_DOT:
      /* stack d k → dict_get → i64_of */
      if (!wcall(c, 17)) return 0; /* dict_get */
      if (!wcall(c, 3)) return 0; /* i64_of */
      break;
    case OP_RET:
      if (!wcall(c, 0)) return 0;
      if (!bu8(c, 0x0f)) return 0;
      break;
    case OP_FRET:
      if (!wcall(c, 4)) return 0;
      if (!bu8(c, 0x0f)) return 0;
      break;
    case OP_HRET:
      if (!bu8(c, 0x0f)) return 0;
      break;
    case OP_GPU:
      if (!g_need_gpu) return 0;
      if (!bu8(c, 0x10) || !bleu(c, 0)) return 0;
      break;
    case OP_STOREBYTES:
      if (!wcall(c, 33)) return 0;
      if (!bu8(c, 0xad)) return 0;
      break;
    case OP_PLET: {
      uint32_t slot = (uint32_t)(ins->a & 0xffff);
      uint8_t ty = (uint8_t)((ins->a >> 16) & 0xff);
      uint32_t tmp = (uint32_t)((ins->a >> 32) & 0xffff);
      uint32_t base = (uint32_t)PERSIST_BASE + slot * (uint32_t)PERSIST_STRIDE;
      if (!bu8(c, 0x21) || !bleu(c, tmp)) return 0;
      if (!bi32(c, (int32_t)(base + 1u))) return 0;
      if (!bu8(c, 0x2d) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
      if (!bu8(c, 0x45)) return 0;
      if (!bu8(c, 0x04) || !bu8(c, 0x40)) return 0;
      if (!bi32(c, (int32_t)(base + 8u))) return 0;
      if (!bu8(c, 0x20) || !bleu(c, tmp)) return 0;
      if (ty == TY_F64) {
        if (!bu8(c, 0x39) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
      } else {
        if (!bu8(c, 0x37) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
      }
      if (!bi32(c, (int32_t)base)) return 0;
      if (!bi32(c, (int32_t)ty)) return 0;
      if (!bu8(c, 0x3a) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
      if (!bi32(c, (int32_t)(base + 1u))) return 0;
      if (!bi32(c, 1)) return 0;
      if (!bu8(c, 0x3a) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
      if (!bu8(c, 0x0b)) return 0;
      break;
    }
    default: return 0;
    }
  }
  return 1;
}

/* Keep the legacy heap below the persist and ABI buffers in UX modules. */
static int ux_guard_heap(Buf *c, int pointer, int count, int unit, int header) {
  if (!g_need_ux) return 1;
  if (!bu8(c, 0x20) || !bleu(c, pointer) || !bu8(c, 0xad)) return 0;
  if (count >= 0) {
    if (!bu8(c, 0x20) || !bleu(c, count) || !bu8(c, 0xad)) return 0;
    if (!bu8(c, 0x42) || !blei64(c, unit) || !bu8(c, 0x7e) || !bu8(c, 0x7c)) return 0;
  }
  return bu8(c, 0x42) && blei64(c, header) && bu8(c, 0x7c) && ux_check_limit(c, PERSIST_BASE);
}

static int mk_num_body(Buf *c, int is_f64) {
  /* (param i64|f64)(result i32)(local i32) — param type already in type section */
  if (!bleu(c, 1) || !bleu(c, 1) || !bu8(c, 0x7f)) return 0;
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x28) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x22) || !bleu(c, 1)) return 0;
  if (!bu8(c, 0x45)) return 0;
  if (!bu8(c, 0x04) || !bu8(c, 0x40)) return 0;
  if (!bi32(c, (int32_t)(HEAP0))) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 1)) return 0;
  if (!bu8(c, 0x0b)) return 0;
  if (!ux_guard_heap(c, 1, -1, 0, 16)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(is_f64 ? TAG_F64 : TAG_I64))) return 0;
  if (!bu8(c, 0x3a) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (is_f64) {
    if (!bu8(c, 0x39) || !bu8(c, 0x03) || !bleu(c, 0)) return 0; /* f64.store */
  } else {
    if (!bu8(c, 0x37) || !bu8(c, 0x03) || !bleu(c, 0)) return 0; /* i64.store */
  }
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(16))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, (int32_t)(7))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, -8)) return 0;
  if (!bu8(c, 0x71)) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  return bu8(c, 0x0b);
}

static int emit_locals(Buf *c, Prog *P) {
  int params = P->native_result ? P->native_params : P->abi_version ? P->api.count : 0;
  if (!bleu(c, (uint32_t)(P->nl - params))) return 0;
  for (int i = params; i < P->nl; i++) {
    if (!bleu(c, 1)) return 0;
    uint8_t wt = 0x7e; /* i64 */
    if (P->lty[i] == TY_F64) wt = 0x7c;
    else if (P->lty[i] == TY_LIST || P->lty[i] == TY_DICT || P->lty[i] == TY_STR ||
             P->lty[i] >= TY_CLOSURE_BASE)
      wt = 0x7f;
    if (!bu8(c, wt)) return 0;
  }
  return 1;
}

/* mk_list(n): tag LIST, len at +2, n × i32 slots at +8 */
static int mk_list_body(Buf *c) {
  /* locals: p, i  (params: n = local 0) */
  if (!bleu(c, 1) || !bleu(c, 2) || !bu8(c, 0x7f)) return 0;
  /* p = freep; if eqz p = HEAP0 */
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x28) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x22) || !bleu(c, 1)) return 0;
  if (!bu8(c, 0x45)) return 0;
  if (!bu8(c, 0x04) || !bu8(c, 0x40)) return 0;
  if (!bi32(c, (int32_t)(HEAP0))) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 1)) return 0;
  if (!bu8(c, 0x0b)) return 0;
  if (!ux_guard_heap(c, 1, 0, 4, 8)) return 0;
  /* store tag + len */
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(TAG_LIST))) return 0;
  if (!bu8(c, 0x3a) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(4))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0; /* i32.store len */
  /* freep = align(p + 8 + n*4) */
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(2))) return 0;
  if (!bu8(c, 0x74)) return 0; /* i32.shl n<<2 */
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, (int32_t)(7))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, -8)) return 0;
  if (!bu8(c, 0x71)) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  /* zero slots: i=0; loop */
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 2)) return 0;
  if (!bu8(c, 0x02) || !bu8(c, 0x40)) return 0; /* block */
  if (!bu8(c, 0x03) || !bu8(c, 0x40)) return 0; /* loop */
  if (!bu8(c, 0x20) || !bleu(c, 2)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x4f)) return 0; /* i32.ge_u */
  if (!bu8(c, 0x0d) || !bleu(c, 1)) return 0; /* br_if block */
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 2)) return 0;
  if (!bi32(c, (int32_t)(2))) return 0;
  if (!bu8(c, 0x74)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 2)) return 0;
  if (!bi32(c, (int32_t)(1))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 2)) return 0;
  if (!bu8(c, 0x0c) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x0b) || !bu8(c, 0x0b)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  return bu8(c, 0x0b);
}

static int list_get_body(Buf *c) {
  /* (param h i) (result i32) — load h+8+i*4 */
  if (!bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(2))) return 0;
  if (!bu8(c, 0x74)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x28) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  return bu8(c, 0x0b);
}

static int list_set_body(Buf *c, int hvi) {
  /* hvi=1: params h,v,i ; hvi=0: params h,i,v */
  if (!bleu(c, 0)) return 0;
  uint32_t ph = 0, pi = hvi ? 2 : 1, pv = hvi ? 1 : 2;
  if (!bu8(c, 0x20) || !bleu(c, ph)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, pi)) return 0;
  if (!bi32(c, (int32_t)(2))) return 0;
  if (!bu8(c, 0x74)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, pv)) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  return bu8(c, 0x0b);
}


static int len_of_body(Buf *c) {
  /* u32 length at +4 (was u16 at +2; SRC can exceed 65535) */
  if (!bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(4))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x28) || !bu8(c, 0x02) || !bleu(c, 0)) return 0; /* i32.load */
  return bu8(c, 0x0b);
}

static int mk_str_body(Buf *c) {
  /* (param src n)(result i32)(local p i) — locals at 2,3 */
  if (!bleu(c, 1) || !bleu(c, 2) || !bu8(c, 0x7f)) return 0;
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x28) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x22) || !bleu(c, 2)) return 0;
  if (!bu8(c, 0x45)) return 0;
  if (!bu8(c, 0x04) || !bu8(c, 0x40)) return 0;
  if (!bi32(c, (int32_t)(HEAP0))) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 2)) return 0;
  if (!bu8(c, 0x0b)) return 0;
  if (!ux_guard_heap(c, 2, 1, 1, 8)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 2)) return 0;
  if (!bi32(c, (int32_t)(TAG_STR))) return 0;
  if (!bu8(c, 0x3a) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 2)) return 0;
  if (!bi32(c, (int32_t)(4))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0; /* i32.store len */
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 2)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, (int32_t)(7))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, -8)) return 0;
  if (!bu8(c, 0x71)) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  /* zero 8 payload bytes so short-key i64 compare is stable */
  if (!bu8(c, 0x20) || !bleu(c, 2)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x42) || !blei64(c, 0)) return 0;
  if (!bu8(c, 0x37) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 3)) return 0;
  if (!bu8(c, 0x02) || !bu8(c, 0x40)) return 0;
  if (!bu8(c, 0x03) || !bu8(c, 0x40)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 3)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bu8(c, 0x4f)) return 0;
  if (!bu8(c, 0x0d) || !bleu(c, 1)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 2)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 3)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 3)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x2d) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x3a) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 3)) return 0;
  if (!bi32(c, (int32_t)(1))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 3)) return 0;
  if (!bu8(c, 0x0c) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x0b) || !bu8(c, 0x0b)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 2)) return 0;
  return bu8(c, 0x0b);
}

/* mk_dict like mk_list but 8-byte pairs */
static int mk_dict_body(Buf *c) {
  if (!bleu(c, 1) || !bleu(c, 2) || !bu8(c, 0x7f)) return 0;
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x28) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x22) || !bleu(c, 1)) return 0;
  if (!bu8(c, 0x45)) return 0;
  if (!bu8(c, 0x04) || !bu8(c, 0x40)) return 0;
  if (!bi32(c, (int32_t)(HEAP0))) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 1)) return 0;
  if (!bu8(c, 0x0b)) return 0;
  if (!ux_guard_heap(c, 1, 0, 8, 8)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(TAG_DICT))) return 0;
  if (!bu8(c, 0x3a) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(4))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0; /* i32.store len */
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(3))) return 0;
  if (!bu8(c, 0x74)) return 0; /* n<<3 */
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, (int32_t)(7))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, -8)) return 0;
  if (!bu8(c, 0x71)) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 2)) return 0;
  if (!bu8(c, 0x02) || !bu8(c, 0x40)) return 0;
  if (!bu8(c, 0x03) || !bu8(c, 0x40)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 2)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x4f)) return 0;
  if (!bu8(c, 0x0d) || !bleu(c, 1)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 2)) return 0;
  if (!bi32(c, (int32_t)(3))) return 0;
  if (!bu8(c, 0x74)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 2)) return 0;
  if (!bi32(c, (int32_t)(3))) return 0;
  if (!bu8(c, 0x74)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, (int32_t)(4))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 2)) return 0;
  if (!bi32(c, (int32_t)(1))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 2)) return 0;
  if (!bu8(c, 0x0c) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x0b) || !bu8(c, 0x0b)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  return bu8(c, 0x0b);
}

static int gstore_body(Buf *c, int kind) {
  /* (param val, slot) — kind 0=i64 1=f64 2=i32-handle; slots are i32 handles at GBASE+slot*4 */
  if (!bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(GBASE))) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(2))) return 0;
  if (!bu8(c, 0x74)) return 0; /* slot<<2 */
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (kind == 0) {
    /* legacy: store i64 raw — unused for handle path */
    if (!bu8(c, 0x37) || !bu8(c, 0x03) || !bleu(c, 0)) return 0;
  } else if (kind == 1) {
    if (!bu8(c, 0x39) || !bu8(c, 0x03) || !bleu(c, 0)) return 0;
  } else {
    if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  }
  return bu8(c, 0x0b);
}

static int dict_set_hkvi_body(Buf *c) {
  /* (param h k v i) store key at h+8+i*8, val at +4 */
  if (!bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 3)) return 0;
  if (!bi32(c, (int32_t)(3))) return 0;
  if (!bu8(c, 0x74)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 3)) return 0;
  if (!bi32(c, (int32_t)(3))) return 0;
  if (!bu8(c, 0x74)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, (int32_t)(4))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 2)) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  return bu8(c, 0x0b);
}

static int dict_get_body(Buf *c) {
  /* (param d key)(result i32)(local n i k) — linear scan, str eq by len+bytes */
  if (!bleu(c, 1) || !bleu(c, 3) || !bu8(c, 0x7f)) return 0;
  /* n = len_of(d) */
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(4))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x28) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 2)) return 0;
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 3)) return 0;
  if (!bu8(c, 0x02) || !bu8(c, 0x40)) return 0;
  if (!bu8(c, 0x03) || !bu8(c, 0x40)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 3)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 2)) return 0;
  if (!bu8(c, 0x4f)) return 0;
  if (!bu8(c, 0x0d) || !bleu(c, 1)) return 0;
  /* k = load key handle */
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 3)) return 0;
  if (!bi32(c, (int32_t)(3))) return 0;
  if (!bu8(c, 0x74)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x28) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 4)) return 0;
  /* compare len */
  if (!bu8(c, 0x20) || !bleu(c, 4)) return 0;
  if (!bi32(c, (int32_t)(4))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x28) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(4))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x28) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x46)) return 0; /* i32.eq */
  if (!bu8(c, 0x04) || !bu8(c, 0x40)) return 0;
  /* byte-compare: first 8 payload bytes as i64 (mk_str zero-pads).
   * Keys longer than 8 are rejected at compile; do not silently prefix-match. */
  if (!bu8(c, 0x20) || !bleu(c, 4)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x29) || !bu8(c, 0x00) || !bleu(c, 0)) return 0; /* i64.load align0 */
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x29) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x51)) return 0; /* i64.eq */
  if (!bu8(c, 0x04) || !bu8(c, 0x7f)) return 0; /* if result i32 */
  /* return val */
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 3)) return 0;
  if (!bi32(c, (int32_t)(3))) return 0;
  if (!bu8(c, 0x74)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, (int32_t)(4))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x28) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x0f)) return 0; /* return */
  if (!bu8(c, 0x05)) return 0;
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x0b)) return 0; /* end if i64.eq */
  if (!bu8(c, 0x1a)) return 0; /* drop */
  if (!bu8(c, 0x0b)) return 0; /* end if len eq */
  if (!bu8(c, 0x20) || !bleu(c, 3)) return 0;
  if (!bi32(c, (int32_t)(1))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 3)) return 0;
  if (!bu8(c, 0x0c) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x0b) || !bu8(c, 0x0b)) return 0;
  if (!bi32(c, (int32_t)(0))) return 0;
  return bu8(c, 0x0b);
}



static int clear_slots_body(Buf *c, int ng) {
  /* zero ng handle slots; leave freep alone */
  if (!bleu(c, 1) || !bleu(c, 1) || !bu8(c, 0x7f)) return 0;
  if (!bi32(c, 0)) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x02) || !bu8(c, 0x40)) return 0;
  if (!bu8(c, 0x03) || !bu8(c, 0x40)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(ng > 0 ? ng : 1))) return 0;
  if (!bu8(c, 0x4f)) return 0;
  if (!bu8(c, 0x0d) || !bleu(c, 1)) return 0;
  if (!bi32(c, GBASE)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, 2)) return 0;
  if (!bu8(c, 0x74)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, 0)) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, 1)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x0c) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x0b) || !bu8(c, 0x0b)) return 0;
  if (!bi32(c, 0)) return 0;
  return bu8(c, 0x0b);
}

static int host_reset_body(Buf *c, int ng) {
  /* freep = HEAP0; clear ng global handle slots */
  if (!bleu(c, 1) || !bleu(c, 1) || !bu8(c, 0x7f)) return 0; /* local i */
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bi32(c, (int32_t)(HEAP0))) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x02) || !bu8(c, 0x40)) return 0;
  if (!bu8(c, 0x03) || !bu8(c, 0x40)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(ng > 0 ? ng : 1))) return 0;
  if (!bu8(c, 0x4f)) return 0;
  if (!bu8(c, 0x0d) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(GBASE))) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(2))) return 0;
  if (!bu8(c, 0x74)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(1))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x0c) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x0b) || !bu8(c, 0x0b)) return 0;
  if (!bi32(c, (int32_t)(0))) return 0;
  return bu8(c, 0x0b);
}

static int host_reset_globals_body(Buf *c) {
  if (!bleu(c, 1) || !bleu(c, 2) || !bu8(c, 0x7f)) return 0;
  if (!bi32(c, 0)) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x02) || !bu8(c, 0x40)) return 0;
  if (!bu8(c, 0x03) || !bu8(c, 0x40)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, 64)) return 0;
  if (!bu8(c, 0x4f)) return 0;
  if (!bu8(c, 0x0d) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)PERSIST_BASE)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, 4)) return 0;
  if (!bu8(c, 0x74)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 1)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, 0)) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, 4)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, 0)) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, 8)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x42) || !bu8(c, 0)) return 0;
  if (!bu8(c, 0x37) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, 1)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x0c) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x0b) || !bu8(c, 0x0b)) return 0;
  if (!bi32(c, 0)) return 0;
  return bu8(c, 0x0b);
}

static int host_set_global_body(Buf *c, int ng) {
  /* (param i h) — store h at GBASE+i*4 if i < ng */
  if (!bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)ng)) return 0;
  if (!bu8(c, 0x4f)) return 0; /* ge_u */
  if (!bu8(c, 0x04) || !bu8(c, 0x40)) return 0;
  if (!bu8(c, 0x0f)) return 0; /* return */
  if (!bu8(c, 0x0b)) return 0;
  if (!bi32(c, (int32_t)(GBASE))) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(2))) return 0;
  if (!bu8(c, 0x74)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  return bu8(c, 0x0b);
}

static int host_get_global_body(Buf *c, int ng) {
  if (!bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)ng)) return 0;
  if (!bu8(c, 0x4f)) return 0;
  if (!bu8(c, 0x04) || !bu8(c, 0x7f)) return 0;
  if (!bi32(c, (int32_t)(0))) return 0;
  if (!bu8(c, 0x05)) return 0;
  if (!bi32(c, (int32_t)(GBASE))) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(2))) return 0;
  if (!bu8(c, 0x74)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x28) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x0b)) return 0;
  return bu8(c, 0x0b);
}

static int run_step_body(Buf *c) {
  /* call main (func 1) */
  if (!bleu(c, 0)) return 0;
  if (!wcall(c, 1)) return 0;
  return bu8(c, 0x0b);
}

