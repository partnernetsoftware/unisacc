  if (!bu8(c, 0x0b)) return 0;
  return bu8(c, 0x0b);
}


static int str_cat_body(Buf *c) {
  /* After locals: call defined len_of (idx 10). wcall adds import offset. */
  static const uint8_t rest[] = {
    0x41, 0x00, 0x28, 0x02, 0x00, 0x21, 0x06, 0x20, 0x06, 0x45, 0x04, 0x40, 0x41, 0x80, 0x20,
    0x21, 0x06, 0x0b, 0x20, 0x06, 0x21, 0x04, 0x20, 0x04, 0x41, 0x04, 0x3a, 0x00, 0x00,
    0x20, 0x04, 0x41, 0x04, 0x6a, 0x20, 0x02, 0x20, 0x03, 0x6a, 0x36, 0x02, 0x00, 0x41, 0x00,
    0x21, 0x05, 0x02, 0x40, 0x03, 0x40, 0x20, 0x05, 0x20, 0x02, 0x4f, 0x0d, 0x01, 0x20, 0x04,
    0x41, 0x08, 0x6a, 0x20, 0x05, 0x6a, 0x20, 0x00, 0x41, 0x08, 0x6a, 0x20, 0x05, 0x6a, 0x2d,
    0x00, 0x00, 0x3a, 0x00, 0x00, 0x20, 0x05, 0x41, 0x01, 0x6a, 0x21, 0x05, 0x0c, 0x00, 0x0b,
    0x0b, 0x41, 0x00, 0x21, 0x05, 0x02, 0x40, 0x03, 0x40, 0x20, 0x05, 0x20, 0x03, 0x4f, 0x0d,
    0x01, 0x20, 0x04, 0x41, 0x08, 0x6a, 0x20, 0x02, 0x6a, 0x20, 0x05, 0x6a, 0x20, 0x01, 0x41,
    0x08, 0x6a, 0x20, 0x05, 0x6a, 0x2d, 0x00, 0x00, 0x3a, 0x00, 0x00, 0x20, 0x05, 0x41, 0x01,
    0x6a, 0x21, 0x05, 0x0c, 0x00, 0x0b, 0x0b, 0x20, 0x04, 0x41, 0x08, 0x20, 0x02, 0x20, 0x03,
    0x6a, 0x6a, 0x6a, 0x41, 0x07, 0x6a, 0x41, 0x78, 0x71, 0x21, 0x06, 0x41, 0x00, 0x20, 0x06,
    0x36, 0x02, 0x00, 0x20, 0x04, 0x0b
  };
  if (!bleu(c, 1) || !bleu(c, 5) || !bu8(c, 0x7f)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!wcall(c, 10)) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 2)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!wcall(c, 10)) return 0;
  if (!bu8(c, 0x21) || !bleu(c, 3)) return 0;
  return braw(c, rest, (uint32_t)sizeof rest);
}

static int host_dict_set_body(Buf *c) {
  /* (param h i k v) — emit_wasm / run_step order */
  if (!bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(3))) return 0;
  if (!bu8(c, 0x74)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 2)) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 0)) return 0;
  if (!bi32(c, (int32_t)(8))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 1)) return 0;
  if (!bi32(c, (int32_t)(3))) return 0;
  if (!bu8(c, 0x74)) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bi32(c, (int32_t)(4))) return 0;
  if (!bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, 3)) return 0;
  if (!bu8(c, 0x36) || !bu8(c, 0x02) || !bleu(c, 0)) return 0;
  return bu8(c, 0x0b);
}

/* (param h i32)(result i32) defined idx 33. Trap on n>4096 or byte not 0..255. */
static int store_bytes_body(Buf *c) {
  enum { L_H = 0, L_N = 1, L_I = 2, L_EH = 3, L_V = 4 };
  if (!bleu(c, 2)) return 0;
  if (!bleu(c, 3) || !bu8(c, 0x7f)) return 0;
  if (!bleu(c, 1) || !bu8(c, 0x7e)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, L_H)) return 0;
  if (!wcall(c, 10)) return 0;
  if (!bu8(c, 0x21) || !bleu(c, L_N)) return 0;
  if (!bi32(c, 0) || !bu8(c, 0x21) || !bleu(c, L_I)) return 0;
  if (!bu8(c, 0x02) || !bu8(c, 0x40)) return 0;
  if (!bu8(c, 0x02) || !bu8(c, 0x40)) return 0;
  if (!bu8(c, 0x03) || !bu8(c, 0x40)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, L_N)) return 0;
  if (!bi32(c, 4096) || !bu8(c, 0x4b) || !bu8(c, 0x0d) || !bleu(c, 2)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, L_I)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, L_N)) return 0;
  if (!bu8(c, 0x4f) || !bu8(c, 0x0d) || !bleu(c, 1)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, L_H)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, L_I)) return 0;
  if (!wcall(c, 7)) return 0;
  if (!bu8(c, 0x21) || !bleu(c, L_EH)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, L_EH)) return 0;
  if (!bu8(c, 0x2d) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
  if (!bi32(c, TAG_I64) || !bu8(c, 0x47) || !bu8(c, 0x0d) || !bleu(c, 2)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, L_EH)) return 0;
  if (!bi32(c, 8) || !bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x29) || !bu8(c, 0x03) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x21) || !bleu(c, L_V)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, L_V)) return 0;
  if (!bu8(c, 0x42) || !blei64(c, 255) || !bu8(c, 0x55) || !bu8(c, 0x0d) || !bleu(c, 2)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, L_V)) return 0;
  if (!bu8(c, 0x42) || !blei64(c, 0) || !bu8(c, 0x53) || !bu8(c, 0x0d) || !bleu(c, 2)) return 0;
  if (!bi32(c, (int32_t)STORE_WIN)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, L_I) || !bu8(c, 0x6a)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, L_V) || !bu8(c, 0xa7)) return 0;
  if (!bu8(c, 0x3a) || !bu8(c, 0x00) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x20) || !bleu(c, L_I)) return 0;
  if (!bi32(c, 1) || !bu8(c, 0x6a) || !bu8(c, 0x21) || !bleu(c, L_I)) return 0;
  if (!bu8(c, 0x0c) || !bleu(c, 0)) return 0;
  if (!bu8(c, 0x0b) || !bu8(c, 0x0b)) return 0;
  if (!bi32(c, (int32_t)STORE_WIN)) return 0;
  if (!bu8(c, 0x0f)) return 0;
  if (!bu8(c, 0x0b)) return 0;
  if (!bi32(c, 0)) return 0;
  return bu8(c, 0x0b);
}

static int abi_wasm_type(Buf *types, AbiFn *f) {
  if (!bu8(types, 0x60) || !bleu(types, f->count)) return 0;
  for (int i = 0; i < f->count; i++)
    if (!bu8(types, f->args[i] == TY_I64 ? 0x7e : 0x7c)) return 0;
  return bleu(types, 1) && bu8(types, f->result == TY_I64 ? 0x7e : 0x7c);
}

static int abi_alias_body(Buf *code, const AbiAlias *alias, int target) {
  if (!bleu(code, 0)) return 0;
  for (int i = 0; i < alias->count; i++)
    if (!bu8(code, 0x42) || !blei64(code, alias->bound[i])) return 0;
  for (int i = 0; i < alias->signature.count; i++)
    if (!bu8(code, 0x20) || !bleu(code, (uint32_t)i)) return 0;
  return wcall(code, (uint32_t)target) && bu8(code, 0x0b);
}

static void init_prog(Prog *p, const char *source, uint32_t len) {
  memset(p, 0, sizeof *p);
  p->scratch = p->fscratch = p->lscratch = p->uxaddr = p->fn_ret = -1;
  p->src = source;
  p->srclen = len;
}

static int native_body(Prog *owner, Buf *body, int index) {
  static Prog frame;
  NativeFn *fn = &owner->natives[index];
  init_prog(&frame, owner->src, owner->srclen);
  frame.legacy_inline = owner->legacy_inline;
  frame.native_count = owner->native_count;
  frame.native_visible = index;
  frame.native_result = fn->sig.result;
  frame.native_params = fn->sig.count;
  frame.native_base = owner->native_base;
  frame.native_depth = 1;
  frame.nfn = fn->inline_count;
  frame.nlayouts = owner->nlayouts;
  frame.import_count = owner->import_count;
  for (int i = 0; i < frame.native_count; i++) frame.natives[i] = owner->natives[i];
  for (int i = 0; i < frame.nfn; i++) frame.fns[i] = owner->fns[i];
  for (int i = 0; i < frame.nlayouts; i++) frame.layouts[i] = owner->layouts[i];
  for (int i = 0; i < frame.import_count; i++) frame.imports[i] = owner->imports[i];
  for (int i = 0; i < frame.native_params; i++) {
    int local = loc(&frame, fn->params[i], 1);
    if (local < 0) { owner->err = frame.err; return 0; }
    frame.lty[local] = fn->sig.args[i];
  }
  Lex lex;
  lex.src = owner->src + fn->off;
  lex.len = fn->len;
  lex.pos = 0;
  next(&lex);
  while (lex.tok != T_EOF) {
    if (!pstmt(&lex, &frame)) { owner->err = frame.err; return 0; }
  }
  if (!frame.native_return) { owner->err = "native function missing return"; return 0; }
  for (int i = 0; i < frame.native_params; i++) {
    if (frame.lty[i] != fn->sig.args[i]) { owner->err = "native parameter type changed"; return 0; }
  }
  fn->depth = frame.native_depth;
  return emit_locals(body, &frame) && emit_ops(body, &frame) && bu8(body, 0x00) && bu8(body, 0x0b);
}

static int build_mod(Prog *P, Buf *mod) {
  Buf types, funcs, mems, exps, codes;
  Buf cs[37 + ABI_MAX_ALIASES + MAX_NATIVE];
  int i, ng = P->ng > 0 ? P->ng : 1;
  enum { NCORE = 19, NHOST = 16, NFUNCS = NCORE + NHOST };
  int api = P->abi_version != 0;
  int alias_start = NFUNCS + 2 * api;
  int alias_type = ABI_TYPE_BASE + P->import_count + api;
  int native_type = alias_type + P->alias_count;
  P->native_base = alias_start + P->alias_count;
  int nfuncs = P->native_base + P->native_count;
  int nimports = g_need_gpu + P->import_count;
  if (!binit(&types,160)||!binit(&funcs,48)||!binit(&mems,16)||!binit(&exps,512)||!binit(&codes,16384))
    return 0;
  for (i = 0; i < nfuncs; i++)
    if (!binit(&cs[i], i == 1 || i == NFUNCS ? 8192 : 256)) return 0;

  for (i = 0; i < P->native_count; i++)
    if (!native_body(P, &cs[P->native_base + i], i)) return 0;
  if (!bleu(&types, native_type + P->native_count)) return 0;
  if (!bu8(&types,0x60)||!bleu(&types,1)||!bu8(&types,0x7e)||!bleu(&types,1)||!bu8(&types,0x7f)) return 0;
  if (!bu8(&types,0x60)||!bleu(&types,0)||!bleu(&types,1)||!bu8(&types,0x7f)) return 0;
  if (!bu8(&types,0x60)||!bleu(&types,1)||!bu8(&types,0x7f)||!bleu(&types,1)||!bu8(&types,0x7f)) return 0;
  if (!bu8(&types,0x60)||!bleu(&types,1)||!bu8(&types,0x7f)||!bleu(&types,1)||!bu8(&types,0x7e)) return 0;
  if (!bu8(&types,0x60)||!bleu(&types,1)||!bu8(&types,0x7c)||!bleu(&types,1)||!bu8(&types,0x7f)) return 0;
  if (!bu8(&types,0x60)||!bleu(&types,1)||!bu8(&types,0x7f)||!bleu(&types,1)||!bu8(&types,0x7c)) return 0;
  if (!bu8(&types,0x60)||!bleu(&types,2)||!bu8(&types,0x7f)||!bu8(&types,0x7f)||!bleu(&types,1)||!bu8(&types,0x7f)) return 0;
  if (!bu8(&types,0x60)||!bleu(&types,3)||!bu8(&types,0x7f)||!bu8(&types,0x7f)||!bu8(&types,0x7f)||!bleu(&types,0)) return 0;
  if (!bu8(&types,0x60)||!bleu(&types,2)||!bu8(&types,0x7f)||!bu8(&types,0x7f)||!bleu(&types,1)||!bu8(&types,0x7f)) return 0;
  if (!bu8(&types,0x60)||!bleu(&types,2)||!bu8(&types,0x7e)||!bu8(&types,0x7f)||!bleu(&types,0)) return 0;
  if (!bu8(&types,0x60)||!bleu(&types,2)||!bu8(&types,0x7c)||!bu8(&types,0x7f)||!bleu(&types,0)) return 0;
  if (!bu8(&types,0x60)||!bleu(&types,2)||!bu8(&types,0x7f)||!bu8(&types,0x7f)||!bleu(&types,0)) return 0;
  if (!bu8(&types,0x60)||!bleu(&types,4)||!bu8(&types,0x7f)||!bu8(&types,0x7f)||!bu8(&types,0x7f)||!bu8(&types,0x7f)||!bleu(&types,0)) return 0;
  if (!bu8(&types,0x60)||!bleu(&types,2)||!bu8(&types,0x7f)||!bu8(&types,0x7f)||!bleu(&types,1)||!bu8(&types,0x7f)) return 0;

  for (i = 0; i < P->import_count; i++) if (!abi_wasm_type(&types, &P->imports[i])) return 0;
  if (api && !abi_wasm_type(&types, &P->api)) return 0;
  for (i = 0; i < P->alias_count; i++)
    if (!abi_wasm_type(&types, &P->aliases[i].signature)) return 0;
  for (i = 0; i < P->native_count; i++)
    if (!abi_wasm_type(&types, &P->natives[i].sig)) return 0;
  if (!bleu(&funcs, nfuncs)) return 0;
  uint8_t fty[NFUNCS] = {
    0,1,2,3,4,5,2,6,7,7,2, 8,2, 9,10,11, 12,13, 6,
    1, 1, 1, 11, 2, 6, 6, 1, 1, 1, 2, 2,
    12,
    1,
    2,
    1
  };
  for (i = 0; i < NFUNCS; i++) if (!bu8(&funcs, fty[i])) return 0;
  if (api && (!bu8(&funcs, ABI_TYPE_BASE + P->import_count) || !bu8(&funcs, 1))) return 0;
  for (i = 0; i < P->alias_count; i++)
    if (!bleu(&funcs, alias_type + i)) return 0;
  for (i = 0; i < P->native_count; i++)
    if (!bleu(&funcs, native_type + i)) return 0;
  if (!bleu(&mems,1)||!bu8(&mems,0)||!bleu(&mems, MEM_PAGES)) return 0;

  /* exports */
  if (!bleu(&exps, 28 + 2 * api + P->alias_count)) return 0;
  #define EXP(name, kind, idx) do { \
    uint32_t _i = ((kind) == 0) ? (uint32_t)(idx) + (uint32_t)nimports : (uint32_t)(idx); \
    if (!bstr(&exps, name)||!bu8(&exps, kind)||!bleu(&exps, _i)) return 0; \
  } while (0)
  EXP("memory", 0x02, 0);
  EXP("main_export", 0x00, 1);
  EXP("tag_of_export", 0x00, 2);
  EXP("i64_of_export", 0x00, 3);
  EXP("f64_of_export", 0x00, 5);
  EXP("run_step", 0x00, 20);
  EXP("host_run", 0x00, 21);
  EXP("host_reset", 0x00, 19);
  EXP("clear_slots", 0x00, 28);
  EXP("host_set_global", 0x00, 22);
  EXP("host_get_global", 0x00, 23);
  EXP("host_mk_i64", 0x00, 0);
  EXP("host_mk_f64", 0x00, 4);
  EXP("host_mk_list", 0x00, 6);
  EXP("host_list_get", 0x00, 7);
  EXP("host_list_set", 0x00, 9);
  EXP("host_len", 0x00, 10);
  EXP("host_mk_str", 0x00, 11);
  EXP("host_mk_dict", 0x00, 12);
  EXP("host_dict_set", 0x00, 31);
  EXP("host_dict_key", 0x00, 24);
  EXP("host_dict_val", 0x00, 25);
  EXP("host_scratch", 0x00, 26);
  EXP("mem_base", 0x00, 27);
  EXP("str_ptr_export", 0x00, 29);
  EXP("str_len_export", 0x00, 30);
  EXP("host_mk_null", 0x00, 32);
  EXP("host_reset_globals", 0x00, 34);
  if (api) {
    EXP(P->api.name, 0x00, NFUNCS);
    EXP("uxe_abi_version", 0x00, NFUNCS + 1);
  }
  for (i = 0; i < P->alias_count; i++) {
    EXP(P->aliases[i].signature.name, 0x00, alias_start + i);
    if (!abi_alias_body(&cs[alias_start + i], &P->aliases[i], NFUNCS)) return 0;
  }

  if (!mk_num_body(&cs[0], 0)) return 0;
  if (api) {
    if (!bleu(&cs[1], 0)) return 0; /* Typed entry modules refuse the legacy main_export. */
    if (!emit_locals(&cs[NFUNCS], P) || !emit_ops(&cs[NFUNCS], P)) return 0;
    if (!bu8(&cs[NFUNCS], 0x00) || !bu8(&cs[NFUNCS], 0x0b)) return 0;
    if (!const_i32_ret_body(&cs[NFUNCS + 1], P->abi_version)) return 0;
  } else if (!emit_locals(&cs[1], P) || !emit_ops(&cs[1], P)) return 0;
  if (!bu8(&cs[1], 0x00) || !bu8(&cs[1], 0x0b)) return 0;
  if (!bleu(&cs[2],0)) return 0;
  if (!bu8(&cs[2],0x20)||!bleu(&cs[2],0)) return 0;
  if (!bu8(&cs[2],0x2d)||!bu8(&cs[2],0x00)||!bleu(&cs[2],0)||!bu8(&cs[2],0x0b)) return 0;
  if (!bleu(&cs[3],0)) return 0;
  if (!bu8(&cs[3],0x20)||!bleu(&cs[3],0)) return 0;
  if (!bu8(&cs[3],0x41)||!bleu(&cs[3],8)||!bu8(&cs[3],0x6a)) return 0;
  if (!bu8(&cs[3],0x29)||!bu8(&cs[3],0x03)||!bleu(&cs[3],0)||!bu8(&cs[3],0x0b)) return 0;
  if (!mk_num_body(&cs[4], 1)) return 0;
  /* as_f64: i64 handles coerce (JSON 3.0 → host_mk_i64) */
  if (!bleu(&cs[5],0)) return 0;
  if (!bu8(&cs[5],0x20)||!bleu(&cs[5],0)) return 0; /* h */
  if (!bu8(&cs[5],0x2d)||!bu8(&cs[5],0x00)||!bleu(&cs[5],0)) return 0; /* load8_u tag */
  if (!bi32(&cs[5], TAG_F64)) return 0;
  if (!bu8(&cs[5],0x46)) return 0; /* i32.eq */
  if (!bu8(&cs[5],0x04)||!bu8(&cs[5],0x7c)) return 0; /* if f64 */
  if (!bu8(&cs[5],0x20)||!bleu(&cs[5],0)) return 0;
  if (!bi32(&cs[5], 8)) return 0;
  if (!bu8(&cs[5],0x6a)) return 0;
  if (!bu8(&cs[5],0x2b)||!bu8(&cs[5],0x03)||!bleu(&cs[5],0)) return 0; /* f64.load */
  if (!bu8(&cs[5],0x05)) return 0;
  if (!bu8(&cs[5],0x20)||!bleu(&cs[5],0)) return 0;
  if (!bi32(&cs[5], 8)) return 0;
  if (!bu8(&cs[5],0x6a)) return 0;
  if (!bu8(&cs[5],0x29)||!bu8(&cs[5],0x03)||!bleu(&cs[5],0)) return 0; /* i64.load */
  if (!bu8(&cs[5],0xb9)) return 0; /* f64.convert_i64_s */
  if (!bu8(&cs[5],0x0b)) return 0; /* end if */
  if (!bu8(&cs[5],0x0b)) return 0;
  if (!mk_list_body(&cs[6])) return 0;
  if (!list_get_body(&cs[7])) return 0;
  if (!list_set_body(&cs[8], 1)) return 0;
  if (!list_set_body(&cs[9], 0)) return 0;
  if (!len_of_body(&cs[10])) return 0;
  if (!mk_str_body(&cs[11])) return 0;
  if (!mk_dict_body(&cs[12])) return 0;
  if (!gstore_body(&cs[13], 0)) return 0;
  if (!gstore_body(&cs[14], 1)) return 0;
  if (!gstore_body(&cs[15], 2)) return 0;
  if (!dict_set_hkvi_body(&cs[16])) return 0;
  if (!dict_get_body(&cs[17])) return 0;
  if (!str_cat_body(&cs[18])) return 0;

  if (!host_reset_body(&cs[19], ng)) return 0;
  if (!run_step_body(&cs[20])) return 0;
  if (!run_step_body(&cs[21])) return 0; /* host_run */
  if (!host_set_global_body(&cs[22], ng)) return 0;
  if (!host_get_global_body(&cs[23], ng)) return 0;
  if (!host_dict_key_body(&cs[24])) return 0;
  if (!host_dict_val_body(&cs[25])) return 0;
  if (!const_i32_ret_body(&cs[26], HOST_SCRATCH)) return 0;
  if (!const_i32_ret_body(&cs[27], 0)) return 0; /* mem_base */
  if (!clear_slots_body(&cs[28], ng)) return 0;
  if (!str_ptr_body(&cs[29])) return 0;
  if (!len_of_body(&cs[30])) return 0;
  if (!host_dict_set_body(&cs[31])) return 0;
  if (!const_i32_ret_body(&cs[32], 0)) return 0;
  if (!store_bytes_body(&cs[33])) return 0;
  if (!host_reset_globals_body(&cs[34])) return 0;

  if (!bleu(&codes, nfuncs)) return 0;
  for (i = 0; i < nfuncs; i++) {
    if (!bleu(&codes, cs[i].n) || !braw(&codes, bd(&cs[i]), cs[i].n)) return 0;
  }
  if (!binit(mod, 32768)) return 0;
  static const uint8_t hdr[] = {0,0x61,0x73,0x6d,1,0,0,0};
  if (!braw(mod, hdr, 8)) return 0;
  if (!sect(mod,1,&types)) return 0;
  if (nimports) {
    Buf imps;
    if (!binit(&imps, 64) || !bleu(&imps, nimports)) return 0;
    if (g_need_gpu) {
      if (!bstr(&imps, "env") || !bstr(&imps, "host_gpu_submit")) return 0;
      if (!bu8(&imps, 0) || !bleu(&imps, 11)) return 0;
    }
    for (i = 0; i < P->import_count; i++) {
      AbiFn *f = &P->imports[i];
      if (!bstr(&imps, f->module) || !bstr(&imps, f->name) ||
          !bu8(&imps, 0) || !bleu(&imps, ABI_TYPE_BASE + i)) return 0;
    }
    if (!sect(mod,2,&imps)) return 0;
  }
  if (!sect(mod,3,&funcs)) return 0;
  if (!sect(mod,5,&mems)) return 0;
  if (!sect(mod,7,&exps)) return 0;
  if (!sect(mod,10,&codes)) return 0;
  {
    Buf custom;
    static const uint8_t nm[] = {'u','j','s','m','e','t','a'};
    if (!g_meta_len || !g_meta_ptr) return 1;
    if (!binit(&custom, 1024)) return 0;
    if (!bleu(&custom, 7)) return 0;
    if (!braw(&custom, nm, 7)) return 0;
    if (!braw(&custom, g_heap + g_meta_ptr, g_meta_len)) return 0;
    if (!sect(mod, 0, &custom)) return 0;
  }
  return 1;
}

static int write_meta(Prog *P) {
  char buf[(2 * MAXL + MAXG) * (MAXN + 2) + 64];
  uint32_t n = 0;
  int first;
  buf[n++] = '{';
  memcpy(buf + n, "\"locals\":[", 10); n += 10;
  first = 1;
  for (int i = 0; i < P->nl; i++) {
    if (!P->names[i][0]) continue;
    if (!first) buf[n++] = ',';
    first = 0;
    buf[n++] = '"';
    for (const char *p = P->names[i]; *p; p++) buf[n++] = *p;
    buf[n++] = '"';
  }
  memcpy(buf + n, "],\"globals\":[", 13); n += 13;
  first = 1;
  for (int i = 0; i < P->ng; i++) {
    if (!first) buf[n++] = ',';
    first = 0;
    buf[n++] = '"';
    for (const char *p = P->gnames[i]; *p; p++) buf[n++] = *p;
    buf[n++] = '"';
  }
  memcpy(buf + n, "],\"slots\":[", 11); n += 11;
  first = 1;
  for (int i = 0; i < P->nl; i++) {
    if (!P->names[i][0]) continue;
    if (!first) buf[n++] = ',';
    first = 0;
    buf[n++] = '"';
    for (const char *p = P->names[i]; *p; p++) buf[n++] = *p;
    buf[n++] = '"';
  }
  buf[n++] = ']'; buf[n++] = '}'; buf[n] = 0;
  uint32_t o = hall(n + 1);
  if (!o) return 0;
  memcpy(g_heap + o, buf, n + 1);
  g_meta_ptr = poff(o); g_meta_len = n;
  return 1;
}

#ifndef UJS_HOST
__attribute__((export_name("compile")))
#endif
int32_t compile(uint32_t src_ptr, uint32_t src_len) {
  static char native_source[100000];
  g_bump = 64;
  g_need_gpu = 0;
  g_need_ux = 0;
  g_abi_imports = 0;
  g_out_ptr = g_out_len = g_meta_ptr = g_meta_len = g_err_ptr = g_err_len = 0;
  if (src_len > 100000) { g_need_gpu = 0; set_err("src too large"); return 1; }
#ifdef UJS_HOST
  if (src_ptr + src_len > sizeof(g_heap)) { g_need_gpu = 0; set_err("bad src"); return 1; }
  const char *src = (const char *)(g_heap + src_ptr);
#else
  const char *src = (const char *)(uintptr_t)src_ptr;
#endif

  Prog P;
  init_prog(&P, src, src_len);
#ifdef UJS_HOST
  P.legacy_inline = g_legacy_inline;
#endif
  Lex L; L.src = src; L.len = src_len; L.pos = 0;
  next(&L);
  while (L.tok == T_ID && (intrinsic_name(L.id, "import") || intrinsic_name(L.id, "export"))) {
    if (!abi_decl(&L, &P, intrinsic_name(L.id, "export"))) {
      set_err(P.err ? P.err : "abi declaration"); return 1;
    }
  }
  while (L.tok == T_ID && intrinsic_name(L.id, "alias")) {
    if (!abi_alias(&L, &P)) { set_err(P.err); return 1; }
  }
#ifdef UJS_HOST
  if (parse_net_top_is_bad(L.tok)) { g_need_gpu = 0; set_err("parse-net"); return 1; }
#endif
  while (L.tok != T_EOF) {
    int is_layout = L.tok == T_ID && intrinsic_name(L.id, "struct");
    int is_native = L.tok == T_ID && intrinsic_name(L.id, "native");
    if (!(is_layout ? layout_decl(&L, &P) : is_native ? native_decl(&L, &P) : pstmt(&L, &P))) {
      g_need_gpu = 0; set_err(P.err ? P.err : "parse"); return 1;
    }
  }
  for (int i = 0; i < P.api.count; i++) {
    if (P.lty[i] != P.api.args[i]) { set_err("abi parameter type changed"); return 1; }
  }
  if (P.native_count) {
    // The emitter reuses the input arena for section buffers.
    for (uint32_t i = 0; i < src_len; i++) native_source[i] = src[i];
    P.src = native_source;
  }
  if (!write_meta(&P)) { g_need_gpu = 0; set_err("meta"); return 1; }
  Buf mod;
  g_abi_imports = P.import_count;
  if (!build_mod(&P, &mod)) { g_need_gpu = 0; set_err(P.err ? P.err : "emit"); return 1; }
  g_out_ptr = poff(mod.off); g_out_len = mod.n;
  g_need_gpu = 0;
  (void)PERSIST_FIT;
  return 0;
}
