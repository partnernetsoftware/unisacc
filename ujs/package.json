{
  "name": "ujs",
  "version": "0.0.4",
  "description": "UJS practice spine (wasm_run / UXE). Product host is ujs.com (no Python under ujs/).",
  "type": "module",
  "main": "./practice/core/index.js",
  "exports": {
    ".": "./practice/core/index.js",
    "./wasm_run.js": "./practice/core/wasm_run.js",
    "./compiler.js": "./practice/core/compiler.js",
    "./package.json": "./package.json"
  },
  "files": [
    "practice/core/index.js",
    "practice/core/wasm_run.js",
    "practice/core/compiler.js",
    "practice/core/compiler.gen.js",
    "practice/core/ujs_full.wasm",
    "practice/core/jspi.js",
    "practice/core/BUILD.json",
    "practice/core/README.md",
    "ARCHITECTURE.md",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"console.error('build: the Python web-build is archived (archive/ujs-legacy-py-c/); no node builder yet'); process.exit(1)\"",
    "test": "cd .. && ./tests/ujs.sh",
    "demo": "node scripts/static-serve.mjs 8765 .",
    "test:game": "perl -e 'alarm 45; exec @ARGV' node web/game/_selftest.mjs",
    "test:game:browser": "perl -e 'alarm 55; exec @ARGV' node web/game/_browser_probe.mjs",
    "test:uxe": "perl -e 'alarm 55; exec @ARGV' node uxe/demo/_probe.mjs",
    "test:uxe:packet": "perl -e 'alarm 20; exec @ARGV' node uxe/_packet_selftest.mjs",
    "test:uxe:input": "perl -e 'alarm 15; exec @ARGV' node uxe/_input_selftest.mjs",
    "ship:engine": "bash scripts/ship-engine.sh",
    "ship:drone": "perl -e 'alarm 120; exec @ARGV' node uxe/ship/build-drone-pages.mjs",
    "ship:pages": "bash scripts/ship-pages.sh",
    "test:uxe:ship": "perl -e 'alarm 55; exec @ARGV' node uxe/ship/_probe.mjs",
    "test:uxe:drone": "perl -e 'alarm 55; exec @ARGV' node uxe/demo/drone/_probe.mjs",
    "test:uxe:drone:rules": "perl -e 'alarm 25; exec @ARGV' node uxe/demo/drone/_rules.mjs",
    "test:uxe:drone:ship": "perl -e 'alarm 55; exec @ARGV' node uxe/ship/drone/_probe.mjs",
    "test:uxe:snap": "perl -e 'alarm 95; exec @ARGV' node uxe/_snap_interact.mjs",
    "test:uxe:all": "bash scripts/uxe-gate.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["wasm", "javascript", "ujs", "wasm_run", "uxe"],
  "license": "UNLICENSED"
}
