#!/usr/bin/env -S unisacc.com -run
/* Small UJS gold stages: scope irsel isel enc reloc shape.
   sh ./unisacc.com ujs/product/gold-rest.cx -- --check|--write [stage]
   Default all stages. Host1 does not ask these tables.
*/
static const char *CTX[] = { "mod", "fn", "block", "switch", "for", "expr", 0 };
static const char *KIND[] = { "bind", "load", "store", "param", "rest", "label", "break", "continue", 0 };
static const char *FAMILY[] = { "arith", "cmp", "logic", "mem", "ctrl", "call", "data", "ic", "host", 0 };
static const char *FLAVOR[] = {
    "i64", "f64", "bool", "str", "list", "dict", "any",
    "br", "br_if", "ret", "switch", "enter", "print", 0
};
static const char *JOPS[] = {
    "nop", "const", "load_l", "store_l", "load_g", "store_g", "drop",
    "add", "sub", "mul", "div", "mod",
    "lt", "le", "gt", "ge", "eq", "ne",
    "and", "or", "not",
    "idx", "setidx", "dot", "len", "keys", "in",
    "mklist", "mkdict", "mktup",
    "jump", "jumpz", "jumpnz",
    "call", "ret", "spread", "restpack",
    "typeof", "shapeof", "switch", "ic_enter", "print", 0
};
static const char *FORMS[] = {
    "nop", "i64_bin", "f64_bin", "i64_cmp", "f64_cmp",
    "bool_logic", "local", "global", "const",
    "br", "br_if", "call", "ret",
    "poly_bin", "heap", "typeof", "host", "trap", 0
};
static const char *IMM[] = { "none", "i64", "f64", "bool", "str_ix", "slot", "label", "count", 0 };
static const char *JMP[] = { "br", "br_if", "call", "switch", 0 };
static const char *TYS[] = { "null", "bool", "i64", "f64", "str", "list", "dict", "fn", "tup", 0 };
static const char *KEYSIG[] = { "empty", "k1", "k2", "k3", "k4", "open", 0 };

static int eq(const char *a, const char *b) { return !strcmp(a, b); }
static int nstr(const char **a) { int n = 0; while (a[n]) n++; return n; }
static int one_of(const char *t, const char **xs) {
    int i; for (i = 0; xs[i]; i++) if (eq(t, xs[i])) return 1; return 0;
}

static const char *scope_label(const char *ctx, const char *kind) {
    static const char *bindok[] = { "mod", "fn", "block", "for", 0 };
    static const char *loopok[] = { "for", "switch", "block", 0 };
    if (eq(kind, "bind")) return one_of(ctx, bindok) ? "ok" : "illegal";
    if (eq(kind, "param") || eq(kind, "rest")) return eq(ctx, "fn") ? "ok" : "illegal";
    if (eq(kind, "load")) return "ok";
    if (eq(kind, "store")) return eq(ctx, "expr") ? "illegal" : "ok";
    if (eq(kind, "label")) return eq(ctx, "switch") ? "ok" : "illegal";
    if (eq(kind, "break") || eq(kind, "continue"))
        return one_of(ctx, loopok) ? "ok" : "illegal";
    return "illegal";
}

static const char *irsel_label(const char *fam, const char *flav) {
    if (eq(fam, "arith") && (eq(flav, "i64") || eq(flav, "str") || eq(flav, "any"))) return "op_add";
    if (eq(fam, "arith") && eq(flav, "f64")) return "op_div";
    if (eq(fam, "cmp") && (eq(flav, "i64") || eq(flav, "f64") || eq(flav, "str") || eq(flav, "bool") || eq(flav, "any")))
        return "op_cmp";
    if (eq(fam, "logic") && (eq(flav, "bool") || eq(flav, "any"))) return "op_logic";
    if (eq(fam, "mem") && eq(flav, "any")) return "op_load";
    if (eq(fam, "mem") && (eq(flav, "list") || eq(flav, "dict") || eq(flav, "str"))) return "op_idx";
    if (eq(fam, "ctrl") && (eq(flav, "br") || eq(flav, "br_if") || eq(flav, "switch"))) return "op_jump";
    if (eq(fam, "ctrl") && eq(flav, "ret")) return "op_ret";
    if (eq(fam, "call") && eq(flav, "any")) return "op_call";
    if (eq(fam, "data") && (eq(flav, "list") || eq(flav, "dict") || eq(flav, "any"))) return "op_mk";
    if (eq(fam, "ic") && eq(flav, "enter")) return "op_ic";
    if (eq(fam, "host") && eq(flav, "print")) return "op_host";
    return "bad";
}

static const char *isel_label(const char *op) {
    static const char *nop[] = { "nop", "drop", "ic_enter", 0 };
    static const char *i64b[] = { "sub", "mul", "mod", 0 };
    static const char *cmp[] = { "lt", "le", "gt", "ge", "eq", "ne", 0 };
    static const char *logic[] = { "and", "or", "not", 0 };
    static const char *loc[] = { "load_l", "store_l", 0 };
    static const char *glob[] = { "load_g", "store_g", 0 };
    static const char *brif[] = { "jumpz", "jumpnz", "switch", 0 };
    static const char *heap[] = {
        "idx", "setidx", "dot", "len", "keys", "in",
        "mklist", "mkdict", "mktup", "spread", "restpack", 0
    };
    static const char *ty[] = { "typeof", "shapeof", 0 };
    if (one_of(op, nop)) return "nop";
    if (eq(op, "add")) return "poly_bin";
    if (one_of(op, i64b)) return "i64_bin";
    if (eq(op, "div")) return "f64_bin";
    if (one_of(op, cmp)) return "i64_cmp";
    if (one_of(op, logic)) return "bool_logic";
    if (one_of(op, loc)) return "local";
    if (one_of(op, glob)) return "global";
    if (eq(op, "const")) return "const";
    if (eq(op, "jump")) return "br";
    if (one_of(op, brif)) return "br_if";
    if (eq(op, "call")) return "call";
    if (eq(op, "ret")) return "ret";
    if (one_of(op, heap)) return "heap";
    if (one_of(op, ty)) return "typeof";
    if (eq(op, "print")) return "host";
    return "trap";
}

static const char *enc_label(const char *form, const char *imm) {
    static const char *oponly[] = {
        "i64_bin", "f64_bin", "i64_cmp", "f64_cmp", "bool_logic",
        "poly_bin", "typeof", "call", "ret", 0
    };
    if (eq(form, "nop")) return "empty";
    if (eq(form, "trap")) return "trap";
    if (eq(form, "host")) return "op_host";
    if (eq(form, "br") || eq(form, "br_if")) return "op_label";
    if (eq(form, "local") || eq(form, "global")) return "op_slot";
    if (eq(form, "const")) return eq(imm, "none") ? "op" : "op_imm";
    if (one_of(form, oponly)) return "op";
    if (eq(form, "heap")) {
        if (eq(imm, "count") || eq(imm, "str_ix")) return "op_imm";
        if (eq(imm, "slot")) return "op_slot";
        return "op";
    }
    return "trap";
}

static const char *reloc_label(const char *kind) {
    if (eq(kind, "br") || eq(kind, "br_if") || eq(kind, "switch")) return "br_target";
    if (eq(kind, "call")) return "fn_ref";
    return "none";
}

static const char *shape_label(const char *ty, const char *ks) {
    if (eq(ks, "empty")) {
        if (eq(ty, "null")) return "s_null";
        if (eq(ty, "bool")) return "s_bool";
        if (eq(ty, "i64")) return "s_i64";
        if (eq(ty, "f64")) return "s_f64";
        if (eq(ty, "str")) return "s_str";
        if (eq(ty, "list")) return "s_list";
        if (eq(ty, "tup")) return "s_tup";
        if (eq(ty, "fn")) return "s_fn";
        if (eq(ty, "dict")) return "s_dict_empty";
    }
    if (eq(ty, "dict")) {
        if (eq(ks, "k1")) return "s_dict_k1";
        if (eq(ks, "k2")) return "s_dict_k2";
        if (eq(ks, "k3")) return "s_dict_k3";
        if (eq(ks, "k4")) return "s_dict_k4";
        if (eq(ks, "open")) return "s_dict_open";
    }
    return "s_unknown";
}

static int slurp(const char *path, char *dst, int cap, int *out_n) {
    FILE *f = fopen(path, "rb");
    long sz; size_t k;
    if (!f) return 1;
    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return 1; }
    sz = ftell(f);
    if (sz < 0 || sz + 1 > cap) { fclose(f); return 1; }
    if (fseek(f, 0, SEEK_SET) != 0) { fclose(f); return 1; }
    k = fread(dst, 1, (size_t)sz, f);
    fclose(f);
    if (k != (size_t)sz) return 1;
    dst[k] = 0; *out_n = (int)k; return 0;
}

static int emit_pairs(char *dst, int cap, const char *hdr,
                      const char **A, const char **B,
                      const char *(*lab)(const char *, const char *),
                      int *out_n, int *out_k) {
    int i, j, n = 0, k = 0, na = nstr(A), nb = B ? nstr(B) : 1;
    n += sprintf(dst + n, "%s", hdr);
    for (i = 0; i < na; i++) {
        if (!B) {
            n += sprintf(dst + n, "%s\t%s\n", A[i], lab(A[i], ""));
            k++;
        } else {
            for (j = 0; j < nb; j++) {
                n += sprintf(dst + n, "%s\t%s\t%s\n", A[i], B[j], lab(A[i], B[j]));
                k++;
                if (n + 64 >= cap) { *out_n = -1; return 1; }
            }
        }
    }
    *out_n = n; *out_k = k; return 0;
}

static const char *scope1(const char *a, const char *b) { return scope_label(a, b); }
static const char *irsel1(const char *a, const char *b) { return irsel_label(a, b); }
static const char *isel1(const char *a, const char *b) { (void)b; return isel_label(a); }
static const char *enc1(const char *a, const char *b) { return enc_label(a, b); }
static const char *reloc1(const char *a, const char *b) { (void)b; return reloc_label(a); }
static const char *shape1(const char *a, const char *b) { return shape_label(a, b); }

static int do_stage(const char *st, int write) {
    static char want[65536], have[65536];
    char path[128];
    int wn = 0, hn = 0, keys = 0;
    FILE *f;
    sprintf(path, "ujs/weights/gold/%s.tsv", st);
    if (eq(st, "scope"))
        emit_pairs(want, (int)sizeof want,
                   "# ujs/weights/gold/scope.tsv\nctx\tkind\ty\n",
                   CTX, KIND, scope1, &wn, &keys);
    else if (eq(st, "irsel"))
        emit_pairs(want, (int)sizeof want,
                   "# ujs/weights/gold/irsel.tsv\nfamily\tflavor\ty\n",
                   FAMILY, FLAVOR, irsel1, &wn, &keys);
    else if (eq(st, "isel"))
        emit_pairs(want, (int)sizeof want,
                   "# ujs/weights/gold/isel.tsv\nop\ty\n",
                   JOPS, 0, isel1, &wn, &keys);
    else if (eq(st, "enc"))
        emit_pairs(want, (int)sizeof want,
                   "# ujs/weights/gold/enc.tsv\nform\timm\ty\n",
                   FORMS, IMM, enc1, &wn, &keys);
    else if (eq(st, "reloc"))
        emit_pairs(want, (int)sizeof want,
                   "# ujs/weights/gold/reloc.tsv\nkind\ty\n",
                   JMP, 0, reloc1, &wn, &keys);
    else if (eq(st, "shape"))
        emit_pairs(want, (int)sizeof want,
                   "# ujs/weights/gold/shape.tsv\nty\tkeysig\ty\n",
                   TYS, KEYSIG, shape1, &wn, &keys);
    else {
        fprintf(stderr, "gold-rest.cx: unknown stage %s\n", st);
        return 2;
    }
    if (wn <= 0) {
        fprintf(stderr, "gold-rest.cx: emit overflow %s\n", st);
        return 1;
    }
    if (write) {
        f = fopen(path, "wb");
        if (!f) { fprintf(stderr, "gold-rest.cx: cannot write %s\n", path); return 1; }
        if ((int)fwrite(want, 1, (size_t)wn, f) != wn) { fclose(f); return 1; }
        fclose(f);
        printf("gold-rest.cx: wrote %s bytes=%d keys=%d\n", path, wn, keys);
        return 0;
    }
    if (slurp(path, have, (int)sizeof have, &hn) != 0) {
        fprintf(stderr, "gold-rest.cx: missing %s\n", path);
        return 1;
    }
    if (hn != wn || memcmp(have, want, (size_t)wn) != 0) {
        fprintf(stderr, "gold-rest.cx: STALE %s\n", path);
        return 1;
    }
    printf("gold-rest.cx: ok %s keys=%d bytes=%d\n", st, keys, wn);
    return 0;
}

int main(int argc, char **argv) {
    static const char *ALL[] = { "scope", "irsel", "isel", "enc", "reloc", "shape", 0 };
    int write = 0, i, rc = 0, nsel = 0;
    const char *sel[8];
    for (i = 1; i < argc; i++) {
        if (eq(argv[i], "--write")) write = 1;
        else if (eq(argv[i], "--check")) ;
        else if (argv[i][0] != '-' && nsel < 7) sel[nsel++] = argv[i];
        else {
            fprintf(stderr, "gold-rest.cx: unknown %s\n", argv[i]);
            return 2;
        }
    }
    if (!nsel) {
        for (i = 0; ALL[i]; i++) {
            int r = do_stage(ALL[i], write);
            if (r) rc = r;
        }
        return rc;
    }
    for (i = 0; i < nsel; i++) {
        int r = do_stage(sel[i], write);
        if (r) rc = r;
    }
    return rc;
}
