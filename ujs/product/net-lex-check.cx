#!/usr/bin/env -S unisacc.com -run
/* Check ujs/weights/nets/lex.net.tsv predicts gold/lex.tsv on all 100 keys.
   sh ./unisacc.com ujs/product/net-lex-check.cx
   Host1 does not ask this net.
*/
static const char *CHARC[] = {
    "eof", "nl", "ws", "A", "D", "Q", "S", "P", "O", "other"
};
static const char *CLASS[] = {
    "eof", "ws", "nl", "id", "num", "str", "punct", "op", "bad"
};
static const char *lex_label(int c) {
    static const char *Y[] = {
        "eof", "nl", "ws", "id", "num", "str", "str", "punct", "op", "bad"
    };
    return Y[c];
}

static int tok_eq(const char *a, const char *b, int n) {
    int i;
    for (i = 0; i < n; i++) if (a[i] != b[i]) return 0;
    return a[n] == 0 || b[n] == 0 ? a[n] == b[n] : 0;
}

static int find_name(const char **tab, int n, const char *s, int sl) {
    int i;
    for (i = 0; i < n; i++) {
        int k = (int)strlen(tab[i]);
        if (k == sl && !memcmp(tab[i], s, (size_t)sl)) return i;
    }
    return -1;
}

static int parse_feed_unit(const char *line, int *unit) {
    const char *p = line;
    int u = -1;
    if (strncmp(p, "feed\t", 5) != 0) return 1;
    p += 5;
    while (*p && *p != '\t' && *p != '\n') p++;
    if (*p == '\t') {
        p++;
        if (*p >= '0' && *p <= '9') {
            u = 0;
            while (*p >= '0' && *p <= '9') { u = u * 10 + (*p - '0'); p++; }
        }
    }
    *unit = u;
    return 0;
}

static int parse_w2(const char *line, int *hid, int *cls, int *wt) {
    const char *p = line;
    int h = 0, c = 0, w = 0;
    if (strncmp(p, "w2\t", 3) != 0) return 1;
    p += 3;
    if (*p < '0' || *p > '9') return 1;
    while (*p >= '0' && *p <= '9') { h = h * 10 + (*p - '0'); p++; }
    if (*p != '\t') return 1;
    p++;
    if (*p < '0' || *p > '9') return 1;
    while (*p >= '0' && *p <= '9') { c = c * 10 + (*p - '0'); p++; }
    if (*p != ':') return 1;
    p++;
    if (*p < '0' || *p > '9') return 1;
    while (*p >= '0' && *p <= '9') { w = w * 10 + (*p - '0'); p++; }
    *hid = h; *cls = c; *wt = w;
    return 0;
}

int main(void) {
    FILE *f;
    char line[256];
    int feed_c[10];
    int w2cls[16];
    int i, nfeed = 0, nw2 = 0, ok = 0, fail = 0;
    for (i = 0; i < 10; i++) feed_c[i] = -1;
    for (i = 0; i < 16; i++) w2cls[i] = -1;

    f = fopen("ujs/weights/nets/lex.net.tsv", "rb");
    if (!f) {
        fprintf(stderr, "net-lex-check.cx: missing net\n");
        return 1;
    }
    while (fgets(line, (int)sizeof line, f)) {
        if (!strncmp(line, "feed\t", 5)) {
            int u = -1;
            if (parse_feed_unit(line, &u)) { fclose(f); return 1; }
            if (nfeed < 10) feed_c[nfeed] = u;
            nfeed++;
        } else if (!strncmp(line, "w2\t", 3)) {
            int h = 0, c = 0, w = 0;
            if (parse_w2(line, &h, &c, &w)) { fclose(f); return 1; }
            if (h < 0 || h >= 16) { fclose(f); return 1; }
            w2cls[h] = c;
            nw2++;
        }
    }
    fclose(f);
    if (nfeed < 10) {
        fprintf(stderr, "net-lex-check.cx: feed rows=%d\n", nfeed);
        return 1;
    }
    for (i = 0; i < 10; i++) {
        int h, c, j;
        const char *y;
        if (feed_c[i] < 0) {
            fprintf(stderr, "net-lex-check.cx: empty feed c=%s\n", CHARC[i]);
            return 1;
        }
        h = feed_c[i];
        if (h < 0 || h >= 16 || w2cls[h] < 0) {
            fprintf(stderr, "net-lex-check.cx: no w2 for h=%d\n", h);
            return 1;
        }
        c = w2cls[h];
        if (c < 0 || c >= 9) {
            fprintf(stderr, "net-lex-check.cx: class %d\n", c);
            return 1;
        }
        y = lex_label(i);
        if (strcmp(CLASS[c], y) != 0) {
            fprintf(stderr, "net-lex-check.cx: c=%s net=%s gold=%s\n",
                    CHARC[i], CLASS[c], y);
            fail++;
        } else ok++;
        (void)j;
        (void)find_name;
        (void)tok_eq;
    }
    if (fail) {
        fprintf(stderr, "net-lex-check.cx: fail=%d\n", fail);
        return 1;
    }
    printf("net-lex-check.cx: ok keys=10 (c only; peek unused) matched=%d w2=%d\n",
           ok, nw2);
    return 0;
}
