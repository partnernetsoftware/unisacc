#!/usr/bin/env -S unisacc.com -run
/* Enumerate UJS ic gold. SHAPES x IC_OPS x GUARDS.
   sh ./unisacc.com ujs/product/gold-ic.cx -- --check|--write
*/
static const char *SHAPES[] = {
    "s_null", "s_bool", "s_i64", "s_f64", "s_str",
    "s_list", "s_tup", "s_fn",
    "s_dict_empty", "s_dict_k1", "s_dict_k2", "s_dict_k3", "s_dict_k4",
    "s_dict_open", "s_unknown",
    0
};
static const char *IC_OPS[] = {
    "add", "sub", "mul", "div", "mod",
    "lt", "eq", "idx", "setidx", "dot", "call", "len", "in",
    0
};
static const char *GUARDS[] = { "none", "type_ok", "len_ok", "key_ok", "mono", 0 };

static int eq(const char *a, const char *b) { return !strcmp(a, b); }
static int nstr(const char **a) { int n = 0; while (a[n]) n++; return n; }
static int gok(const char *g) { return eq(g, "type_ok") || eq(g, "mono"); }
static int dict(const char *s) { return !strncmp(s, "s_dict", 6); }

static const char *ic_label(const char *shape, const char *op, const char *guard) {
    if (eq(guard, "none") || eq(shape, "s_unknown")) return "interp";
    if (eq(op, "add")) {
        if (eq(shape, "s_i64") && gok(guard)) return "add_i64";
        if (eq(shape, "s_f64") && gok(guard)) return "add_f64";
        return "interp";
    }
    if (eq(op, "sub") && eq(shape, "s_i64") && gok(guard)) return "sub_i64";
    if (eq(op, "mul") && eq(shape, "s_i64") && gok(guard)) return "mul_i64";
    if (eq(op, "div") && eq(shape, "s_f64") && gok(guard)) return "div_f64";
    if (eq(op, "lt") || eq(op, "eq")) {
        if (eq(shape, "s_i64") && gok(guard)) return "cmp_i64";
        if (eq(shape, "s_f64") && gok(guard)) return "cmp_f64";
        return "interp";
    }
    if (eq(op, "idx")) {
        if (eq(shape, "s_list") && (gok(guard) || eq(guard, "len_ok"))) return "idx_list";
        if (dict(shape) && (gok(guard) || eq(guard, "key_ok"))) return "idx_dict";
        if (eq(shape, "s_str") && (gok(guard) || eq(guard, "len_ok"))) return "idx_str";
        return "interp";
    }
    if (eq(op, "setidx")) {
        if (eq(shape, "s_list") && (gok(guard) || eq(guard, "len_ok"))) return "set_list";
        if (dict(shape) && (gok(guard) || eq(guard, "key_ok"))) return "set_dict";
        return "interp";
    }
    if (eq(op, "dot") && dict(shape) && (gok(guard) || eq(guard, "key_ok")))
        return "dot_dict";
    if (eq(op, "call") && eq(shape, "s_fn") && gok(guard)) return "call_fn";
    if (eq(op, "len")) {
        if (eq(shape, "s_list") && gok(guard)) return "len_list";
        if (eq(shape, "s_str") && gok(guard)) return "len_str";
        return "interp";
    }
    if (eq(op, "in") && dict(shape) && (gok(guard) || eq(guard, "key_ok")))
        return "in_dict";
    return "interp";
}

static int slurp(const char *path, char *dst, int cap, int *out_n) {
    FILE *f = fopen(path, "rb");
    long sz; size_t k;
    if (!f) return 1;
    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return 1; }
    sz = ftell(f);
    if (sz < 0 || sz + 1 > cap) { fclose(f); return 1; }
    if (fseek(f, 0, SEEK_SET) != 0) { fclose(f); return 1; }
    k = fread(dst, 1, (size_t)sz, f);
    fclose(f);
    if (k != (size_t)sz) return 1;
    dst[k] = 0; *out_n = (int)k; return 0;
}

int main(int argc, char **argv) {
    static char want[131072], have[131072];
    int wn = 0, hn = 0, write = 0, i, j, k, keys = 0;
    int ns = nstr(SHAPES), no = nstr(IC_OPS), ng = nstr(GUARDS);
    const char *path = "ujs/weights/gold/ic.tsv";
    FILE *f;
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--write")) write = 1;
        else if (!strcmp(argv[i], "--check")) ;
        else { fprintf(stderr, "gold-ic.cx: unknown %s\n", argv[i]); return 2; }
    }
    wn += sprintf(want + wn, "# ujs/weights/gold/ic.tsv -- SHAPES x IC_OPS x GUARDS\n");
    wn += sprintf(want + wn, "shape\top\tguard\ty\n");
    for (i = 0; i < ns; i++) {
        for (j = 0; j < no; j++) {
            for (k = 0; k < ng; k++) {
                wn += sprintf(want + wn, "%s\t%s\t%s\t%s\n",
                              SHAPES[i], IC_OPS[j], GUARDS[k],
                              ic_label(SHAPES[i], IC_OPS[j], GUARDS[k]));
                keys++;
                if (wn + 80 >= (int)sizeof want) {
                    fprintf(stderr, "gold-ic.cx: overflow\n");
                    return 1;
                }
            }
        }
    }
    if (write) {
        f = fopen(path, "wb");
        if (!f) { fprintf(stderr, "gold-ic.cx: cannot write\n"); return 1; }
        if ((int)fwrite(want, 1, (size_t)wn, f) != wn) { fclose(f); return 1; }
        fclose(f);
        printf("gold-ic.cx: wrote %s bytes=%d keys=%d\n", path, wn, keys);
        return 0;
    }
    if (slurp(path, have, (int)sizeof have, &hn) != 0) {
        fprintf(stderr, "gold-ic.cx: missing %s\n", path);
        return 1;
    }
    if (hn != wn || memcmp(have, want, (size_t)wn) != 0) {
        fprintf(stderr, "gold-ic.cx: STALE\n");
        return 1;
    }
    printf("gold-ic.cx: ok keys=%d bytes=%d\n", keys, wn);
    return 0;
}
