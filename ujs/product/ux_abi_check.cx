#pragma unisa module ux_abi_check
#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text
#pragma unisa use text.num

typedef struct {
    char dir[256], source[280], wasm[280];
} UxProbe;

static int prepare_probe(UxProbe *probe) {
    if (sy_mkdtemp("/tmp", "ujs-ux-abi-", probe->dir, sizeof probe->dir)) return 1;
    tx_snprintf(probe->source, sizeof probe->source, "%s/test.ujs", probe->dir);
    tx_snprintf(probe->wasm, sizeof probe->wasm, "%s/test.wasm", probe->dir);
    return 0;
}

static void remove_probe(UxProbe *probe) {
    sy_unlink(probe->source);
    sy_unlink(probe->wasm);
    sy_rmdir(probe->dir);
}

static int ux_probe(UxProbe *probe, const char *library, const char *body, double gold, double tolerance, int trap) {
    char source[4096], *out = 0, *end = 0;
    char *args[] = {"./ujs/ujs2wasm.com", probe->source, "-o", probe->wasm, "--run", 0};
    const char marker[] = "\"value\":";
    const char err[] = "unreachable";
    size_t n = 0;
    int size = tx_snprintf(source, sizeof source, "%s\n%s\n", library, body);
    int rc, pass = 0;
    long at;
    if (size < 0 || size >= (int)sizeof source || sy_write_file(probe->source, source, size, 0600)) return 0;
    rc = cx_runv_timeout(args, 8, &out, &n);
    if (trap) {
        pass = rc == 1 && out && tx_contains(out, n, err, sizeof err - 1);
    } else if (!rc && out && (at = tx_find(out, n, marker, sizeof marker - 1)) >= 0) {
        const char *start = out + at + sizeof marker - 1;
        double value = tx_strtod(start, &end);
        pass = end > start && *end == ',' && value >= gold - tolerance && value <= gold + tolerance;
    }
    if (!pass) fprintf(stderr, "UX_ABI probe failed rc=%d source=%s output=%s\n", rc, body, out ? out : "");
    mm_free(out);
    return pass;
}

int check_ux_abi(int mutate) {
    UxProbe probe;
    unsigned char *math = 0, *text = 0;
    int64_t math_n = 0, text_n = 0;
    int checks = 0, passed = 0;
    if (sy_read_file("ujs/practice/uxe/base/math.ujs", &math, &math_n, 2048) ||
        sy_read_file("ujs/practice/uxe/base/text.ujs", &text, &text_n, 2048) ||
        prepare_probe(&probe)) {
        mm_free(math);
        mm_free(text);
        return 1;
    }
    const char *angles[] = {"return ux_sin(0.5235987755982988);",
        "return ux_sin(0.0 - 1.5707963267948966);",
        "return ux_sin(1000.0);", "return ux_sin(1.0471975511965976 + 1.5707963267948966);"};
    const double sine_gold[] = {0.5, -1.0, 0.8268795405320026, 0.5};
    for (int i = 0; i < 4; i++) {
        passed += ux_probe(&probe, (char *)math, angles[i], sine_gold[i], 0.000000002, 0);
        checks++;
    }
    passed += ux_probe(&probe, "", mutate ? "return f64_sqrt(3.0);" : "return f64_sqrt(2.0);",
        1.4142135623730951, 0.000000000000001, 0);
    checks++;
    passed += ux_probe(&probe, "", "let z = f64_sqrt(0.0 - 1.0); return z != z;", 1, 0, 0);
    checks++;
    passed += ux_probe(&probe, "", "let w = ux_f32_put(6291452, 1.1); return ux_f32(6291452);",
        1.100000023841858, 0.000000000000001, 0);
    checks++;
    passed += ux_probe(&probe, "",
        "let w = ux_f32_put(6291452, 1.1); return ux_u8(6291452) + ux_u8(6291453) * 256 + ux_u8(6291454) * 65536 + ux_u8(6291455) * 16777216;",
        1066192077, 0, 0);
    checks++;
    passed += ux_probe(&probe, "", "return ux_span(6291456, 0);", 8388608, 0, 0);
    checks++;
    passed += ux_probe(&probe, "", "let xs = [ux_span(4, 8), ux_span(20, 8)]; return xs[1] - xs[0];",
        16, 0, 0);
    checks++;
    const char *bad[] = {mutate ? "return ux_u8(6291455);" : "return ux_u8(6291456);",
        "return ux_f32(6291453);", "return ux_u8(0 - 1);",
        "return ux_u8(4294967296);", "return ux_u8_put(0, 256);", "return ux_span(6291455, 2);",
        "return ux_span(0, 0 - 1);", "return ux_span(0, 9223372036854775807);",
        "let p = ux_span(0, 4); let xs = list(500000); return len(xs);"};
    for (int i = 0; i < 9; i++) {
        passed += ux_probe(&probe, "", bad[i], 0, 0, 1);
        checks++;
    }
    const int bytes[][4] = {{65, 0, 0, 0}, {0, 0, 0, 0}, {194, 162, 0, 0}, {226, 130, 172, 0},
        {240, 159, 140, 138}, {192, 175, 0, 0}, {237, 160, 128, 0}, {244, 144, 128, 128},
        {226, 130, 0, 0}, {128, 0, 0, 0}, {224, 159, 128, 0}, {226, 65, 172, 0}};
    const int lengths[] = {0, 1, 2, 3, 4, 2, 3, 4, 2, 1, 3, 3};
    for (int i = 0; i < 12; i++) {
        char body[300];
        tx_snprintf(body, sizeof body,
            "let a = ux_u8_put(8, %d); let b = ux_u8_put(9, %d); let c = ux_u8_put(10, %d); let d = ux_u8_put(11, %d); return ux_utf8(8, %d);",
            bytes[i][0], mutate && i == 11 ? 130 : bytes[i][1], bytes[i][2], bytes[i][3], lengths[i]);
        passed += ux_probe(&probe, (char *)text, body, i < 5, 0, 0);
        checks++;
    }
    mm_free(math);
    mm_free(text);
    remove_probe(&probe);
    printf("CHECK_UX_ABI checks=%d passed=%d failed=%d\n", checks, passed, checks - passed);
    return passed != checks;
}

static unsigned noise_hash(int x, int y, int seed) {
    uint32_t n = (((uint32_t)x + 17u) * 374761393u) ^
        (((uint32_t)y + 29u) * 668265263u) ^ ((uint32_t)seed * 1442695041u);
    n = (n ^ (n >> 13)) * 1274126177u;
    return (n ^ (n >> 16)) & 255u;
}

int check_u32(int mutate) {
    const int points[][3] = {
        {0,0,7}, {63,127,7}, {127,63,10}, {255,255,12}, {0,0,31}, {1,0,12},
        {0,1,31}, {426,239,86}, {1023,1023,7}, {1023,0,86}, {-17,-29,7}, {-23,81,91}
    };
    UxProbe probe;
    int checks = 0, passed = 0;
    if (prepare_probe(&probe)) return 1;
    for (int i = 0; i < (int)(sizeof points / sizeof points[0]); i++) {
        char body[512];
        int x = points[i][0], y = points[i][1], seed = points[i][2];
        int n = tx_snprintf(body, sizeof body,
            "let n = u32_xor(u32_xor(u32_mul(%d + 17, 374761393), u32_mul(%d + 29, 668265263)), u32_mul(%d, 1442695041));"
            "n = u32_mul(u32_xor(n, u32_shr(n, %d)), 1274126177);"
            "return u32_and(u32_xor(n, u32_shr(n, 16)), 255);", x, y, seed, mutate && !i ? 12 : 13);
        if (n > 0 && n < (int)sizeof body) passed += ux_probe(&probe, "", body, noise_hash(x, y, seed), 0, 0);
        checks++;
    }
    passed += ux_probe(&probe, "", "return u32_shr(0 - 1, 45);", 524287, 0, 0);
    passed += ux_probe(&probe, "", "return u32_mul(4294967295, 4294967295);", 1, 0, 0);
    checks += 2;
    remove_probe(&probe);
    printf("CHECK_UJS_U32 checks=%d passed=%d failed=%d\n", checks, passed, checks - passed);
    return passed != checks;
}
