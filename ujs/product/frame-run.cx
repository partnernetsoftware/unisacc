#!/usr/bin/env -S unisacc.com -run
#pragma unisa use sys.fs
#pragma unisa use mem.heap
/* Same-process N-frame host1_vm. No libc.
   ./unisacc.com ujs/product/frame-run.cx ujs/product/host1_vm.cx -- /tmp/frame.wasm 4
   Or after -o bin: ./bin WASM FRAMES
*/
int host1_wasm_run_frames2(const unsigned char *wasm, unsigned int wasm_n, int frames, int rg,
                          char *out, unsigned int out_cap);
unsigned int host1_last_freep(void);

int main(int argc, char **argv) {
  unsigned char *buf;
  int64_t n;
  int frames, rc, i, rg, dump;
  char out[2048];
  const char *path;
  if (argc < 2) return 2;
  path = argv[1];
  frames = 4;
  rg = 0;
  dump = 0;
  if (argc >= 3) {
    frames = 0;
    for (i = 0; argv[2][i]; i++) {
      if (argv[2][i] >= '0' && argv[2][i] <= '9') frames = frames * 10 + (argv[2][i] - '0');
      else if (argv[2][i] == 'g') rg = 1;
      else if (argv[2][i] == 'p') dump = 1;
    }
  }
  if (frames < 1) frames = 1;
  rc = sy_read_file(path, &buf, &n, 200000);
  if (rc < 0 || !buf || n < 8) return 1;
  rc = host1_wasm_run_frames2(buf, (unsigned int)n, frames, rg, out, (unsigned int)sizeof out);
  mm_free(buf);
  for (i = 0; out[i]; i++) {}
  sy_write_all(1, out, (int64_t)i);
  sy_write_all(1, "\n", 1);
  if (dump && rc == 0) {
    unsigned int fp = host1_last_freep();
    char d[16];
    int nd = 0, k;
    unsigned int x = fp;
    char line[24];
    int ln = 0;
    const char *pre = "freep=";
    while (pre[ln]) { line[ln] = pre[ln]; ln++; }
    if (x == 0) d[nd++] = '0';
    while (x) { d[nd++] = (char)('0' + (x % 10u)); x /= 10u; }
    k = nd;
    while (k) line[ln++] = d[--k];
    line[ln++] = '\n';
    sy_write_all(1, line, (int64_t)ln);
  }
  return rc != 0 ? 1 : 0;
}
