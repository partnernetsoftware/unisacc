#!/usr/bin/env -S unisacc.com -run
/* Ask each ujs net on every gold key.
   sh ./unisacc.com ujs/product/net-gold-check.cx
   hv = b1[j] + hits; if hv>0 add each W2 pair once.
*/
enum { HMAX = 64, CMAX = 96, CLSMAX = 48, FMAX = 48, NFMAX = 4, W2MAX = 8 };
static int H, ncls, nfield, ncoord;
static int b1[HMAX], offs[NFMAX], nval[NFMAX];
static int feedn[CMAX];
static int feedu[CMAX][FMAX];
static int w2n[HMAX], w2c[HMAX][W2MAX], w2w[HMAX][W2MAX];
static char cls[CLSMAX][32];
static char fval[NFMAX][64][32];
static char fname[NFMAX][32];

static int feeds(int coord, int unit) {
    int k;
    if (coord < 0 || coord >= CMAX) return 0;
    for (k = 0; k < feedn[coord]; k++) if (feedu[coord][k] == unit) return 1;
    return 0;
}

static int lookup(int f, const char *s) {
    int i;
    for (i = 0; i < nval[f]; i++) if (!strcmp(fval[f][i], s)) return i;
    return -1;
}

static int ask(const int *idx) {
    int j, c, hv, best = -1, bestv = -999999, logit[CLSMAX], p;
    for (c = 0; c < ncls; c++) logit[c] = 0;
    for (j = 0; j < H; j++) {
        hv = b1[j];
        for (c = 0; c < nfield; c++) {
            if (feeds(offs[c] + idx[c], j)) hv++;
        }
        if (hv > 0) {
            for (p = 0; p < w2n[j]; p++) logit[w2c[j][p]] += w2w[j][p];
        }
    }
    for (c = 0; c < ncls; c++) {
        if (best < 0 || logit[c] > bestv) { best = c; bestv = logit[c]; }
    }
    return best;
}

static int split_tabs(char *line, char **out, int cap) {
    int n = 0;
    char *p = line;
    while (*p == '\n' || *p == '\r') return 0;
    while (*p && n < cap) {
        out[n++] = p;
        while (*p && *p != '\t' && *p != '\n' && *p != '\r') p++;
        if (*p == '\t') { *p++ = 0; }
        else { *p = 0; break; }
    }
    return n;
}

static int load_net(const char *path) {
    FILE *f = fopen(path, "rb");
    char line[2048];
    int i;
    if (!f) return 1;
    for (i = 0; i < CMAX; i++) feedn[i] = 0;
    for (i = 0; i < HMAX; i++) w2n[i] = 0;
    ncoord = 0; H = 0; ncls = 0; nfield = 0;
    while (fgets(line, (int)sizeof line, f)) {
        if (!strncmp(line, "field\t", 6)) {
            char *tok[80]; int nt, f, k;
            char buf[2048];
            memcpy(buf, line, strlen(line) + 1);
            nt = split_tabs(buf, tok, 80);
            if (nt < 3 || nfield >= NFMAX) { fclose(f); return 1; }
            f = nfield;
            strncpy(fname[f], tok[1], 31); fname[f][31] = 0;
            nval[f] = nt - 2;
            if (nval[f] > 64) { fclose(f); return 1; }
            for (k = 0; k < nval[f]; k++) {
                strncpy(fval[f][k], tok[k + 2], 31); fval[f][k][31] = 0;
            }
            nfield++;
        } else if (!strncmp(line, "class\t", 6)) {
            char *tok[80]; int nt, k;
            char buf[2048];
            memcpy(buf, line, strlen(line) + 1);
            nt = split_tabs(buf, tok, 80);
            ncls = nt - 1;
            if (ncls <= 0 || ncls > CLSMAX) { fclose(f); return 1; }
            for (k = 0; k < ncls; k++) {
                strncpy(cls[k], tok[k + 1], 31); cls[k][31] = 0;
            }
        } else if (!strncmp(line, "H\t", 2)) {
            H = atoi(line + 2);
            if (H <= 0 || H > HMAX) { fclose(f); return 1; }
        } else if (!strncmp(line, "offs\t", 5)) {
            char *p = line + 5; int j = 0;
            while (*p && *p != '\n' && j < NFMAX) {
                offs[j++] = atoi(p);
                while (*p && *p != '\t' && *p != '\n') p++;
                if (*p == '\t') p++;
            }
        } else if (!strncmp(line, "b1\t", 3)) {
            char *p = line + 3; int j = 0;
            while (*p && *p != '\n' && j < H) {
                b1[j++] = atoi(p);
                while (*p && *p != '\t' && *p != '\n') p++;
                if (*p == '\t') p++;
            }
            if (j != H) { fclose(f); return 1; }
        } else if (!strncmp(line, "feed\t", 5)) {
            char *p = line + 5; int coord, u, k = 0;
            coord = atoi(p);
            while (*p && *p != '\t' && *p != '\n') p++;
            if (*p == '\t') p++;
            while (*p && *p != '\n' && k < FMAX) {
                if (*p >= '0' && *p <= '9') {
                    u = atoi(p);
                    feedu[coord][k++] = u;
                    while (*p && *p != '\t' && *p != '\n') p++;
                    if (*p == '\t') p++;
                } else break;
            }
            if (coord < 0 || coord >= CMAX) { fclose(f); return 1; }
            feedn[coord] = k;
            if (coord + 1 > ncoord) ncoord = coord + 1;
        } else if (!strncmp(line, "w2\t", 3)) {
            char *p = line + 3; int h, np = 0;
            h = atoi(p);
            while (*p && *p != '\t') p++;
            if (*p != '\t') { fclose(f); return 1; }
            p++;
            if (h < 0 || h >= H) { fclose(f); return 1; }
            while (*p && *p != '\n' && np < W2MAX) {
                int c, w;
                c = atoi(p);
                while (*p && *p != ':') p++;
                if (*p != ':') break;
                p++;
                w = atoi(p);
                w2c[h][np] = c; w2w[h][np] = w; np++;
                while (*p && *p != '\t' && *p != '\n') p++;
                if (*p == '\t') p++;
            }
            w2n[h] = np;
        }
    }
    fclose(f);
    if (nfield > 0 && offs[0] != 0) return 1;
    return (H > 0 && ncls > 0 && nfield > 0) ? 0 : 1;
}

static int check_stage(const char *st) {
    char npath[128], gpath[128], line[512];
    FILE *g;
    int keys = 0, fail = 0, hdr = 0;
    sprintf(npath, "ujs/weights/nets/%s.net.tsv", st);
    sprintf(gpath, "ujs/weights/gold/%s.tsv", st);
    if (load_net(npath)) {
        fprintf(stderr, "net-gold-check.cx: load %s failed\n", npath);
        return 1;
    }
    g = fopen(gpath, "rb");
    if (!g) {
        fprintf(stderr, "net-gold-check.cx: missing %s\n", gpath);
        return 1;
    }
    while (fgets(line, (int)sizeof line, g)) {
        char buf[512]; char *tok[8]; int nt, idx[NFMAX], pred, f;
        if (line[0] == '#' || line[0] == '\n') continue;
        memcpy(buf, line, strlen(line) + 1);
        nt = split_tabs(buf, tok, 8);
        if (!hdr) { hdr = 1; continue; }
        if (nt != nfield + 1) {
            fprintf(stderr, "net-gold-check.cx: %s cols=%d fields=%d\n", st, nt, nfield);
            fclose(g); return 1;
        }
        for (f = 0; f < nfield; f++) {
            idx[f] = lookup(f, tok[f]);
            if (idx[f] < 0) {
                fprintf(stderr, "net-gold-check.cx: %s unknown %s\n", st, tok[f]);
                fclose(g); return 1;
            }
        }
        pred = ask(idx);
        if (pred < 0 || pred >= ncls || strcmp(cls[pred], tok[nfield]) != 0) {
            if (fail < 5) {
                fprintf(stderr, "net-gold-check.cx: %s gold=%s net=%s\n",
                        st, tok[nfield],
                        (pred >= 0 && pred < ncls) ? cls[pred] : "?");
            }
            fail++;
        }
        keys++;
    }
    fclose(g);
    if (fail) {
        fprintf(stderr, "net-gold-check.cx: %s fail=%d keys=%d\n", st, fail, keys);
        return 1;
    }
    printf("net-gold-check.cx: ok %s keys=%d H=%d\n", st, keys, H);
    return 0;
}

int main(int argc, char **argv) {
    static const char *ALL[] = {
        "lex", "parse", "scope", "irsel", "isel", "enc", "reloc", "shape",
        "type", "ic", 0
    };
    int i, rc = 0, nsel = 0;
    const char *sel[12];
    for (i = 1; i < argc; i++) {
        if (argv[i][0] != '-') sel[nsel++] = argv[i];
        else {
            fprintf(stderr, "net-gold-check.cx: unknown %s\n", argv[i]);
            return 2;
        }
    }
    if (!nsel) {
        for (i = 0; ALL[i]; i++) {
            int r = check_stage(ALL[i]);
            if (r) rc = r;
        }
        return rc;
    }
    for (i = 0; i < nsel; i++) {
        int r = check_stage(sel[i]);
        if (r) rc = r;
    }
    return rc;
}
