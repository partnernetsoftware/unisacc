/* ujs.com — ujs+wasm productivity host (stage0 / UJS_HOST). No #include.
 * Build: ./unisacc.com -run ujs/product/build.cx
 *     APE: ./unisacc.com -run ujs/product/build-ape.cx | complete.cx
 * Contract: FILE.ujs [-o OUT.wasm] -> \\0asm (default OUT = FILE.wasm).
 *           --verify FILE.wasm -> structure check (host1 验面).
 */
uint32_t alloc(uint32_t n);
int32_t compile(uint32_t src_ptr, uint32_t src_len);
uint32_t out_ptr(void);
uint32_t out_len(void);
uint32_t err_ptr(void);
uint32_t err_len(void);
void ujs_host_write(uint32_t off, const void *p, uint32_t n);
const uint8_t *ujs_host_mem(void);

static const char *VERSION = "ujs.com 0.0.6";
int host1_wasm_run(const uint8_t *wasm, uint32_t wasm_n, char *out, uint32_t out_cap);

static void usage(FILE *f) {
  fprintf(f, "%s\n", VERSION);
  fprintf(f, "ujs.com — ujs+wasm productivity tool (host image, stage0)\n");
  fprintf(f, "usage:\n");
  fprintf(f, "  ujs.com --version | -V\n");
  fprintf(f, "  ujs.com --help | -h\n");
  fprintf(f, "  ujs.com --verify FILE.wasm\n");
  fprintf(f, "  ujs.com --verify-list MANIFEST PREFIX\n");
  fprintf(f, "  ujs.com --run FILE.wasm\n");
  fprintf(f, "  ujs.com FILE.ujs [-o OUT.wasm]\n");
  fprintf(f, "  ujs.com FILE.ujs --run [-o OUT.wasm]\n");
  fprintf(f, "contract:\n");
  fprintf(f, "  compile closed UJS-1_ship subset to \\0asm (bridge=stage0-host)\n");
  fprintf(f, "  default -o: same path with .ujs replaced by .wasm\n");
  fprintf(f, "  out-of-table input: refuse (no wasm)\n");
  fprintf(f, "  --verify / --verify-list: structure + required exports\n");
  fprintf(f, "  --run FILE.wasm: host1 mini-VM execute main_export (tag=host1_package)\n");
  fprintf(f, "  FILE.ujs --run: compile and execute in one process; stdout is host1 JSON\n");
  fprintf(f, "  -o with FILE.ujs --run still writes wasm; without -o no wasm file is written\n");
  fprintf(f, "not this binary: M3/compiler_core, construct IntNet, Pages/UXE\n");
}

static int ends_with(const char *s, const char *suf) {
  size_t n, m;
  if (!s || !suf) return 0;
  n = strlen(s);
  m = strlen(suf);
  if (m > n) return 0;
  return memcmp(s + (n - m), suf, m) == 0;
}

static int default_out_path(const char *src, char *buf, size_t cap) {
  size_t n;
  if (!ends_with(src, ".ujs")) return 0;
  n = strlen(src);
  if (n < 4 || n - 4 + 5 >= cap) return 0;
  memcpy(buf, src, n - 4);
  memcpy(buf + (n - 4), ".wasm", 6);
  return 1;
}

static int read_file(const char *path, uint8_t **out, size_t *out_n) {
  FILE *f;
  long sz;
  uint8_t *buf;
  size_t n;
  f = fopen(path, "rb");
  if (!f) return 0;
  if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return 0; }
  sz = ftell(f);
  if (sz < 0 || sz > 100000) { fclose(f); return 0; }
  if (fseek(f, 0, SEEK_SET) != 0) { fclose(f); return 0; }
  buf = (uint8_t *)malloc((size_t)sz + 1);
  if (!buf) { fclose(f); return 0; }
  n = fread(buf, 1, (size_t)sz, f);
  fclose(f);
  if (n != (size_t)sz) { free(buf); return 0; }
  buf[n] = 0;
  *out = buf;
  *out_n = n;
  return 1;
}

static int write_file(const char *path, const uint8_t *p, size_t n) {
  FILE *f = fopen(path, "wb");
  size_t w;
  if (!f) return 0;
  w = fwrite(p, 1, n, f);
  if (fclose(f) != 0) return 0;
  return w == n;
}

static int read_uleb(const uint8_t *p, size_t n, size_t *ioff, uint32_t *out) {
  uint32_t r = 0;
  unsigned shift = 0;
  size_t i = *ioff;
  for (;;) {
    uint8_t b;
    if (i >= n) return 0;
    b = p[i++];
    r |= (uint32_t)(b & 0x7fu) << shift;
    if ((b & 0x80u) == 0) {
      *ioff = i;
      *out = r;
      return 1;
    }
    shift += 7;
    if (shift > 28) return 0;
  }
}

/* Structural host1 wasm check. Returns 0 ok, 1 bad. quiet=1 skips JSON line. */
static int verify_wasm_bytes(const uint8_t *p, size_t n, const char *path, int quiet) {
  size_t i = 0;
  int has_type = 0, has_func = 0, has_mem = 0, has_export = 0, has_code = 0;
  int has_memory_name = 0, has_main_export = 0;

  if (n < 8 || p[0] != 0 || p[1] != 0x61 || p[2] != 0x73 || p[3] != 0x6d) {
    fprintf(stderr, "ujs.com: verify not \\0asm: %s\n", path);
    return 1;
  }
  /* binary version = u32 LE 1 */
  if (p[4] != 1 || p[5] != 0 || p[6] != 0 || p[7] != 0) {
    fprintf(stderr, "ujs.com: verify bad version: %s\n", path);
    return 1;
  }
  i = 8;

  while (i < n) {
    uint8_t sid;
    uint32_t sz;
    size_t pay;
    if (i >= n) break;
    sid = p[i++];
    if (!read_uleb(p, n, &i, &sz)) {
      fprintf(stderr, "ujs.com: verify bad section size: %s\n", path);
      return 1;
    }
    if (sz > n - i) {
      fprintf(stderr, "ujs.com: verify truncated section %u: %s\n", (unsigned)sid, path);
      return 1;
    }
    pay = i;
    if (sid == 1) has_type = 1;
    else if (sid == 3) has_func = 1;
    else if (sid == 5) has_mem = 1;
    else if (sid == 10) has_code = 1;
    else if (sid == 7) {
      uint32_t ne, k;
      size_t j = pay;
      has_export = 1;
      if (!read_uleb(p, pay + sz, &j, &ne)) {
        fprintf(stderr, "ujs.com: verify bad export count: %s\n", path);
        return 1;
      }
      for (k = 0; k < ne; k++) {
        uint32_t nl, idx;
        uint8_t kind;
        if (!read_uleb(p, pay + sz, &j, &nl) || j + nl > pay + sz) {
          fprintf(stderr, "ujs.com: verify bad export name: %s\n", path);
          return 1;
        }
        if (nl == 6 && memcmp(p + j, "memory", 6) == 0) has_memory_name = 1;
        if (nl == 11 && memcmp(p + j, "main_export", 11) == 0) has_main_export = 1;
        j += nl;
        if (j >= pay + sz) {
          fprintf(stderr, "ujs.com: verify export truncated: %s\n", path);
          return 1;
        }
        kind = p[j++];
        if (!read_uleb(p, pay + sz, &j, &idx)) {
          fprintf(stderr, "ujs.com: verify bad export idx: %s\n", path);
          return 1;
        }
        (void)kind;
        (void)idx;
      }
      if (j != pay + sz) {
        fprintf(stderr, "ujs.com: verify export section slack: %s\n", path);
        return 1;
      }
    }
    i = pay + sz;
  }
  if (i != n) {
    fprintf(stderr, "ujs.com: verify trailing garbage: %s\n", path);
    return 1;
  }
  if (!has_type || !has_func || !has_mem || !has_export || !has_code) {
    fprintf(stderr, "ujs.com: verify missing required sections: %s\n", path);
    return 1;
  }
  if (!has_memory_name || !has_main_export) {
    fprintf(stderr, "ujs.com: verify missing required exports: %s\n", path);
    return 1;
  }
  if (!quiet)
    printf("{\"verify\":\"ok\",\"wasm\":\"%s\",\"bytes\":%u,\"tag\":\"host1_package\"}\n",
           path, (unsigned)n);
  return 0;
}

static int cmd_verify(const char *path) {
  uint8_t *buf = 0;
  size_t n = 0;
  int rc;
  if (!read_file(path, &buf, &n)) {
    fprintf(stderr, "ujs.com: cannot read %s\n", path);
    return 1;
  }
  rc = verify_wasm_bytes(buf, n, path, 0);
  free(buf);
  return rc;
}

/* MANIFEST basenames; path = prefix + name + ".wasm" */
static int cmd_verify_list(const char *manifest, const char *prefix) {
  FILE *f;
  char line[256];
  char path[512];
  int ok = 0, bad = 0;
  size_t L, plen;
  plen = strlen(prefix);
  f = fopen(manifest, "rb");
  if (!f) {
    fprintf(stderr, "ujs.com: cannot open %s\n", manifest);
    return 1;
  }
  while (fgets(line, sizeof line, f)) {
    uint8_t *buf = 0;
    size_t n = 0;
    L = strlen(line);
    while (L && (line[L - 1] == '\n' || line[L - 1] == '\r')) line[--L] = 0;
    if (!L || line[0] == '#') continue;
    if (plen + L + 6 >= sizeof path) {
      fprintf(stderr, "ujs.com: path too long for %s\n", line);
      bad++;
      continue;
    }
    memcpy(path, prefix, plen);
    memcpy(path + plen, line, L);
    memcpy(path + plen + L, ".wasm", 6);
    if (!read_file(path, &buf, &n)) {
      fprintf(stderr, "ujs.com: cannot read %s\n", path);
      bad++;
      continue;
    }
    if (verify_wasm_bytes(buf, n, path, 1) != 0) bad++;
    else ok++;
    free(buf);
  }
  fclose(f);
  if (bad) {
    fprintf(stderr, "ujs.com: verify-list bad=%d ok=%d\n", bad, ok);
    return 1;
  }
  printf("{\"verify-list\":\"ok\",\"count\":%d,\"tag\":\"host1_package\"}\n", ok);
  return 0;
}

/* Copy a successful compile. Does not write a file and does not print. */
static int compile_to_mem(const char *src_path, uint8_t **out, size_t *out_n) {
  uint8_t *src = 0;
  size_t src_n = 0;
  uint32_t ptr;
  int32_t st;
  uint32_t op, ol, ep, el;
  const uint8_t *mem;
  uint8_t *copy;

  *out = 0;
  *out_n = 0;
  if (!read_file(src_path, &src, &src_n)) {
    fprintf(stderr, "ujs.com: cannot read %s\n", src_path);
    return 1;
  }
  ptr = alloc((uint32_t)src_n + 1u);
  if (!ptr) {
    fprintf(stderr, "ujs.com: alloc failed\n");
    free(src);
    return 1;
  }
  ujs_host_write(ptr, src, (uint32_t)src_n + 1u);
  free(src);
  st = compile(ptr, (uint32_t)src_n);
  mem = ujs_host_mem();
  if (st != 0) {
    ep = err_ptr();
    el = err_len();
    if (el && ep + el <= 256u * 1024u)
      fprintf(stderr, "ujs.com: %.*s\n", (int)el, (const char *)(mem + ep));
    else
      fprintf(stderr, "ujs.com: compile failed\n");
    return 1;
  }
  op = out_ptr();
  ol = out_len();
  if (ol < 4 || op + ol > 256u * 1024u ||
      mem[op] != 0 || mem[op + 1] != 0x61 ||
      mem[op + 2] != 0x73 || mem[op + 3] != 0x6d) {
    fprintf(stderr, "ujs.com: not \\0asm\n");
    return 1;
  }
  copy = (uint8_t *)malloc(ol);
  if (!copy) {
    fprintf(stderr, "ujs.com: alloc failed\n");
    return 1;
  }
  memcpy(copy, mem + op, ol);
  *out = copy;
  *out_n = ol;
  return 0;
}

static int emit_run_json(const uint8_t *buf, size_t n) {
  char json[2048];
  int rc;
  if (n < 8 || buf[0] || buf[1] != 0x61 || buf[2] != 0x73 || buf[3] != 0x6d) {
    fprintf(stderr, "ujs.com: --run not \\0asm\n");
    return 1;
  }
  rc = host1_wasm_run(buf, (uint32_t)n, json, (uint32_t)sizeof json);
  puts(json);
  return rc != 0 ? 1 : 0;
}

static int cmd_compile(const char *src_path, const char *out_path) {
  uint8_t *wasm = 0;
  size_t n = 0;
  if (compile_to_mem(src_path, &wasm, &n) != 0) return 1;
  if (!write_file(out_path, wasm, n)) {
    fprintf(stderr, "ujs.com: cannot write %s\n", out_path);
    free(wasm);
    return 1;
  }
  printf("{\"wasm\":\"%s\",\"bytes\":%u,\"bridge\":\"stage0-host\",\"tag\":\"host1_package\"}\n",
         out_path, (unsigned)n);
  free(wasm);
  return 0;
}

/* FILE.ujs --run. out_path NULL writes no file. stdout is host1 JSON only. */
static int cmd_compile_run(const char *src_path, const char *out_path) {
  uint8_t *wasm = 0;
  size_t n = 0;
  int rc;
  if (compile_to_mem(src_path, &wasm, &n) != 0) return 1;
  if (out_path && !write_file(out_path, wasm, n)) {
    fprintf(stderr, "ujs.com: cannot write %s\n", out_path);
    free(wasm);
    return 1;
  }
  rc = emit_run_json(wasm, n);
  free(wasm);
  return rc;
}

int main(int argc, char **argv) {
  const char *src = 0;
  const char *out_wasm = 0;
  const char *verify_path = 0;
  char def_out[4096];
  int i;

  if (argc < 2) {
    usage(stderr);
    return 2;
  }
  if (!strcmp(argv[1], "--version") || !strcmp(argv[1], "-V")) {
    puts(VERSION);
    return 0;
  }
  if (!strcmp(argv[1], "--help") || !strcmp(argv[1], "-h")) {
    usage(stdout);
    return 0;
  }
  if (!strcmp(argv[1], "--verify")) {
    if (argc != 3) {
      fprintf(stderr, "ujs.com: --verify needs FILE.wasm\n");
      return 2;
    }
    verify_path = argv[2];
    if (!ends_with(verify_path, ".wasm")) {
      fprintf(stderr, "ujs.com: --verify expects .wasm\n");
      return 2;
    }
    return cmd_verify(verify_path);
  }
  if (!strcmp(argv[1], "--verify-list")) {
    if (argc != 4) {
      fprintf(stderr, "ujs.com: --verify-list needs MANIFEST PREFIX\n");
      return 2;
    }
    return cmd_verify_list(argv[2], argv[3]);
  }
  if (!strcmp(argv[1], "--run")) {
    uint8_t *buf = 0;
    size_t n = 0;
    char json[2048];
    int rc;
    if (argc != 3) {
      fprintf(stderr, "ujs.com: --run needs FILE.wasm\n");
      return 2;
    }
    if (!ends_with(argv[2], ".wasm")) {
      fprintf(stderr, "ujs.com: --run expects .wasm\n");
      return 2;
    }
    if (!read_file(argv[2], &buf, &n)) {
      fprintf(stderr, "ujs.com: cannot read %s\n", argv[2]);
      return 1;
    }
    if (n < 8 || buf[0] || buf[1] != 0x61 || buf[2] != 0x73 || buf[3] != 0x6d) {
      fprintf(stderr, "ujs.com: --run not \\0asm\n");
      free(buf);
      return 1;
    }
    rc = emit_run_json(buf, n);
    free(buf);
    return rc;
  }

  {
  int do_run = 0;
  for (i = 1; i < argc; i++) {
    if (!strcmp(argv[i], "-o")) {
      if (i + 1 >= argc) {
        fprintf(stderr, "ujs.com: -o needs a path\n");
        return 2;
      }
      out_wasm = argv[++i];
    } else if (!strcmp(argv[i], "--run")) {
      do_run = 1;
    } else if (argv[i][0] == '-') {
      fprintf(stderr, "ujs.com: unknown flag %s\n", argv[i]);
      usage(stderr);
      return 2;
    } else if (!src) {
      src = argv[i];
    } else {
      fprintf(stderr, "ujs.com: extra argument %s\n", argv[i]);
      return 2;
    }
  }

  if (!src) {
    usage(stderr);
    return 2;
  }
  if (!ends_with(src, ".ujs")) {
    fprintf(stderr, "ujs.com: input should be FILE.ujs\n");
    return 2;
  }
  if (do_run) return cmd_compile_run(src, out_wasm);
  if (!out_wasm) {
    if (!default_out_path(src, def_out, sizeof def_out)) {
      fprintf(stderr, "ujs.com: cannot derive default -o\n");
      return 2;
    }
    out_wasm = def_out;
  }
  return cmd_compile(src, out_wasm);
  }
}
