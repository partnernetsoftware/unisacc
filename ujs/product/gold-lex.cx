#!/usr/bin/env -S unisacc.com -run
/* Enumerate UJS lex gold. CHARC x CHARC = 100 keys.
   sh ./unisacc.com ujs/product/gold-lex.cx -- --check|--write
   Table: ujs/weights/gold/lex.tsv
   Not an IntNet. Does not change host1.
*/
#pragma unisa use text.text

static const char *CHARC[] = {
    "eof", "nl", "ws", "A", "D", "Q", "S", "P", "O", "other", 0
};
static const char *LEXACT[] = {
    "eof", "ws", "nl", "id", "num", "str", "punct", "op", "bad", 0
};

static const char *lex_label(const char *c, const char *peek) {
    (void)peek;
    if (!strcmp(c, "eof")) return "eof";
    if (!strcmp(c, "ws")) return "ws";
    if (!strcmp(c, "nl")) return "nl";
    if (!strcmp(c, "A")) return "id";
    if (!strcmp(c, "D")) return "num";
    if (!strcmp(c, "Q") || !strcmp(c, "S")) return "str";
    if (!strcmp(c, "P")) return "punct";
    if (!strcmp(c, "O")) return "op";
    return "bad";
}

static int nclass(void) {
    int n = 0;
    while (CHARC[n]) n++;
    return n;
}

static void emit_body(char *dst, int cap, int *out_n) {
    int i, j, n = 0;
    int nc = nclass();
    n += sprintf(dst + n,
                 "# ujs/weights/gold/lex.tsv -- lex gold CHARC x CHARC\n");
    n += sprintf(dst + n, "c\tpeek\ty\n");
    for (i = 0; i < nc; i++) {
        for (j = 0; j < nc; j++) {
            n += sprintf(dst + n, "%s\t%s\t%s\n",
                             CHARC[i], CHARC[j], lex_label(CHARC[i], CHARC[j]));
        }
    }
    *out_n = n;
}

static int slurp(const char *path, char *dst, int cap, int *out_n) {
    FILE *f = fopen(path, "rb");
    long sz;
    size_t k;
    if (!f) return 1;
    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return 1; }
    sz = ftell(f);
    if (sz < 0 || sz + 1 > cap) { fclose(f); return 1; }
    if (fseek(f, 0, SEEK_SET) != 0) { fclose(f); return 1; }
    k = fread(dst, 1, (size_t)sz, f);
    fclose(f);
    if (k != (size_t)sz) return 1;
    dst[k] = 0;
    *out_n = (int)k;
    return 0;
}

int main(int argc, char **argv) {
    char want[8192];
    char have[8192];
    int wn = 0, hn = 0;
    int write = 0, check = 0;
    int i;
    const char *path = "ujs/weights/gold/lex.tsv";
    FILE *f;

    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--write")) write = 1;
        else if (!strcmp(argv[i], "--check")) check = 1;
        else {
            fprintf(stderr, "gold-lex.cx: unknown %s\n", argv[i]);
            return 2;
        }
    }
    if (!write && !check) check = 1;
    emit_body(want, (int)sizeof want, &wn);
    if (wn <= 0 || wn >= (int)sizeof want) {
        fprintf(stderr, "gold-lex.cx: emit overflow\n");
        return 1;
    }
    if (write) {
        f = fopen(path, "wb");
        if (!f) {
            fprintf(stderr, "gold-lex.cx: cannot write %s\n", path);
            return 1;
        }
        if ((int)fwrite(want, 1, (size_t)wn, f) != wn) {
            fclose(f);
            return 1;
        }
        fclose(f);
        printf("gold-lex.cx: wrote %s bytes=%d keys=100\n", path, wn);
        return 0;
    }
    if (slurp(path, have, (int)sizeof have, &hn) != 0) {
        fprintf(stderr, "gold-lex.cx: missing %s\n", path);
        return 1;
    }
    if (hn != wn || memcmp(have, want, (size_t)wn) != 0) {
        fprintf(stderr, "gold-lex.cx: STALE %s\n", path);
        return 1;
    }
    printf("gold-lex.cx: ok keys=100 bytes=%d\n", wn);
    (void)LEXACT;
    return 0;
}
