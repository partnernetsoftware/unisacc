#!/usr/bin/env -S unisacc.com -run
/* Enumerate UJS parse gold. NT x TOKS.
   sh ./unisacc.com ujs/product/gold-parse.cx -- --check|--write
   Table: ujs/weights/gold/parse.tsv
   Not an IntNet. Host1 does not ask this table.
*/
static const char *NT[] = {
    "top", "stmt", "unary", "postfix", "primary", "pswitch", 0
};
static const char *TOKS[] = {
    "eof", "id", "num", "str", "null", "true", "false",
    "let", "function", "if", "else", "while", "for", "return",
    "break", "continue", "switch", "case", "default",
    "typeof", "of", "in",
    "{", "}", "(", ")", "[", "]", ";", ",", ":", ".", "?",
    "=", "==", "!=", "<", ">", "<=", ">=",
    "+", "-", "*", "/", "%", "&&", "||", "!", "??",
    "=>", "+=", "-=", "*=", "/=",
    "...",
    0
};

static int eq(const char *a, const char *b) { return !strcmp(a, b); }

static int one_of(const char *t, const char *const *xs) {
    int i;
    for (i = 0; xs[i]; i++) if (eq(t, xs[i])) return 1;
    return 0;
}

static const char *parse_label(const char *nt, const char *tok) {
    static const char *stmt_kw[] = {
        "if", "while", "for", "switch", "return",
        "break", "continue", "let", 0
    };
    static const char *cd[] = { "case", "default", 0 };
    static const char *lit[] = { "null", "true", "false", 0 };
    static const char *ps[] = { "case", "default", "}", 0 };
    if (eq(nt, "top")) {
        if (eq(tok, "eof")) return "end";
        if (eq(tok, "function")) return "fn";
        if (eq(tok, "let")) return "let";
        return "expr";
    }
    if (eq(nt, "stmt")) {
        if (eq(tok, "{")) return "block";
        if (eq(tok, "function")) return "fn";
        if (one_of(tok, stmt_kw)) return tok;
        if (one_of(tok, cd)) return tok;
        return "expr";
    }
    if (eq(nt, "unary")) {
        if (eq(tok, "-")) return "neg";
        if (eq(tok, "!")) return "not";
        if (eq(tok, "...")) return "spread";
        if (eq(tok, "typeof")) return "typeof";
        return "prim";
    }
    if (eq(nt, "postfix")) {
        if (eq(tok, "[")) return "index";
        if (eq(tok, "(")) return "call";
        if (eq(tok, ".")) return "dot";
        return "done";
    }
    if (eq(nt, "primary")) {
        if (eq(tok, "id")) return "ident";
        if (eq(tok, "num")) return "number";
        if (eq(tok, "str")) return "string";
        if (one_of(tok, lit)) return tok;
        if (eq(tok, "[")) return "list";
        if (eq(tok, "{")) return "dict";
        if (eq(tok, "(")) return "paren";
        return "bad";
    }
    if (eq(nt, "pswitch")) {
        if (!one_of(tok, ps)) return "bad";
        if (eq(tok, "}")) return "done";
        return tok;
    }
    return "expr";
}

static int nstr(const char **a) {
    int n = 0;
    while (a[n]) n++;
    return n;
}

static void emit_body(char *dst, int cap, int *out_n) {
    int i, j, n = 0;
    int nn = nstr(NT), nt = nstr(TOKS);
    n += sprintf(dst + n, "# ujs/weights/gold/parse.tsv -- parse gold NT x TOKS\n");
    n += sprintf(dst + n, "nt\ttok\ty\n");
    for (i = 0; i < nn; i++) {
        for (j = 0; j < nt; j++) {
            n += sprintf(dst + n, "%s\t%s\t%s\n",
                         NT[i], TOKS[j], parse_label(NT[i], TOKS[j]));
            if (n + 64 >= cap) { *out_n = -1; return; }
        }
    }
    *out_n = n;
}

static int slurp(const char *path, char *dst, int cap, int *out_n) {
    FILE *f = fopen(path, "rb");
    long sz;
    size_t k;
    if (!f) return 1;
    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return 1; }
    sz = ftell(f);
    if (sz < 0 || sz + 1 > cap) { fclose(f); return 1; }
    if (fseek(f, 0, SEEK_SET) != 0) { fclose(f); return 1; }
    k = fread(dst, 1, (size_t)sz, f);
    fclose(f);
    if (k != (size_t)sz) return 1;
    dst[k] = 0;
    *out_n = (int)k;
    return 0;
}

int main(int argc, char **argv) {
    static char want[65536];
    static char have[65536];
    int wn = 0, hn = 0, write = 0, check = 0, i;
    const char *path = "ujs/weights/gold/parse.tsv";
    FILE *f;
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--write")) write = 1;
        else if (!strcmp(argv[i], "--check")) check = 1;
        else {
            fprintf(stderr, "gold-parse.cx: unknown %s\n", argv[i]);
            return 2;
        }
    }
    if (!write && !check) check = 1;
    emit_body(want, (int)sizeof want, &wn);
    if (wn <= 0) {
        fprintf(stderr, "gold-parse.cx: emit overflow\n");
        return 1;
    }
    if (write) {
        f = fopen(path, "wb");
        if (!f) {
            fprintf(stderr, "gold-parse.cx: cannot write %s\n", path);
            return 1;
        }
        if ((int)fwrite(want, 1, (size_t)wn, f) != wn) { fclose(f); return 1; }
        fclose(f);
        printf("gold-parse.cx: wrote %s bytes=%d keys=%d\n",
               path, wn, nstr(NT) * nstr(TOKS));
        return 0;
    }
    if (slurp(path, have, (int)sizeof have, &hn) != 0) {
        fprintf(stderr, "gold-parse.cx: missing %s\n", path);
        return 1;
    }
    if (hn != wn || memcmp(have, want, (size_t)wn) != 0) {
        fprintf(stderr, "gold-parse.cx: STALE %s\n", path);
        return 1;
    }
    printf("gold-parse.cx: ok keys=%d bytes=%d\n", nstr(NT) * nstr(TOKS), wn);
    return 0;
}
