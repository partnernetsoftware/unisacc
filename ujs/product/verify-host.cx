#!/usr/bin/env -S unisacc.com -run
/* host1 验面闸：一批 --verify-list（复用 corpus 写出的 /tmp/ujs-corpus-*.wasm）
   + 冒充实文件拒绝。须先跑 corpus-host（smoke／complete 已保证顺序）。
   ./unisacc.com -run ujs/product/verify-host.cx
*/
static int exists(const char *p) {
    FILE *f = fopen(p, "rb");
    if (!f) return 0;
    fclose(f);
    return 1;
}

static int enter_root(const char *argv0) {
    char dir[4096];
    size_t l;
    char *sl;
    if (exists("./ujs/tests/host1-pass.txt")) return 0;
    if (!argv0 || !argv0[0]) return -1;
    l = strlen(argv0);
    if (l >= sizeof dir) return -1;
    memcpy(dir, argv0, l + 1);
    sl = strrchr(dir, '/');
    if (!sl) return -1;
    *sl = 0;
    if (chdir(dir) != 0) return -1;
    return chdir("../..");
}

static int run_host(char **av, int timeout_s) {
    char *cap = 0;
    size_t n = 0;
    int rc;
    rc = cx_runv_timeout(av, timeout_s, &cap, &n);
    if (cap && n) fwrite(cap, 1, n, stdout);
    free(cap);
    if (rc != 127) return rc;
    {
        char *shav[8];
        int i;
        shav[0] = "sh";
        for (i = 0; av[i] && i < 6; i++) shav[i + 1] = av[i];
        shav[i + 1] = 0;
        cap = 0;
        n = 0;
        rc = cx_runv_timeout(shav, timeout_s, &cap, &n);
        if (cap && n) fwrite(cap, 1, n, stdout);
        free(cap);
        return rc;
    }
}

static int refuse_bogus(void) {
    char *av[4];
    FILE *f = fopen("/tmp/ujs-verify-bogus.wasm", "wb");
    if (!f) return 1;
    fwrite("notwasm", 1, 7, f);
    fclose(f);
    av[0] = "./ujs/ujs.com";
    av[1] = "--verify";
    av[2] = "/tmp/ujs-verify-bogus.wasm";
    av[3] = 0;
    if (run_host(av, 10) == 0) {
        fprintf(stderr, "verify-host.cx: bogus wasm should refuse\n");
        return 1;
    }
    return 0;
}

int main(int argc, char **argv) {
    char *av[5];
    (void)argc;
    if (enter_root(argv[0]) != 0) {
        fprintf(stderr, "verify-host.cx: need repo root\n");
        return 2;
    }
    if (!exists("./ujs/ujs.com")) {
        fprintf(stderr, "verify-host.cx: build host first\n");
        return 2;
    }
    if (!exists("/tmp/ujs-corpus-arith.ujs.wasm")) {
        fprintf(stderr, "verify-host.cx: missing corpus wasm (run corpus-host.cx first)\n");
        return 2;
    }
    av[0] = "./ujs/ujs.com";
    av[1] = "--verify-list";
    av[2] = "ujs/tests/host1-pass.txt";
    av[3] = "/tmp/ujs-corpus-";
    av[4] = 0;
    if (run_host(av, 30) != 0) {
        fprintf(stderr, "verify-host.cx: verify-list failed\n");
        return 1;
    }
    if (refuse_bogus() != 0) return 1;
    printf("verify-host.cx: ok verify-list + bogus_refuse (host1_package)\n");
    return 0;
}
