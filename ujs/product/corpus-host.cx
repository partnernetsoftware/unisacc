#!/usr/bin/env -S unisacc.com -run
/* host1 oracle: ujs/tests/host1-pass.txt + host1-refuse.txt only.
   Never opens expect.json or Node runners. Pure .cx.
   ./unisacc.com -run ujs/product/corpus-host.cx
*/
enum { MAX_NAMES = 64, MAX_NAME = 64, EXPECT_PASS = 28 };

static char pass_names[MAX_NAMES][MAX_NAME];
static char refuse_names[MAX_NAMES][MAX_NAME];
static int n_pass, n_refuse;

static int exists(const char *p) {
    FILE *f = fopen(p, "rb");
    if (!f) return 0;
    fclose(f);
    return 1;
}

static int enter_root(const char *argv0) {
    char dir[4096];
    size_t l;
    char *sl;
    if (exists("./ujs/tests/host1-pass.txt")) return 0;
    if (!argv0 || !argv0[0]) return -1;
    l = strlen(argv0);
    if (l >= sizeof dir) return -1;
    memcpy(dir, argv0, l + 1);
    sl = strrchr(dir, '/');
    if (!sl) return -1;
    *sl = 0;
    if (chdir(dir) != 0) return -1;
    return chdir("../..");
}

/* Load basenames from a manifest; skip blank/# lines. */
static int load_list(const char *path, char names[][MAX_NAME], int *out_n) {
    FILE *f;
    char line[256];
    int n = 0;
    size_t L;
    f = fopen(path, "rb");
    if (!f) {
        fprintf(stderr, "corpus-host.cx: cannot open %s\n", path);
        return -1;
    }
    while (fgets(line, sizeof line, f)) {
        L = strlen(line);
        while (L && (line[L - 1] == '\n' || line[L - 1] == '\r')) line[--L] = 0;
        if (!L || line[0] == '#') continue;
        if (L >= MAX_NAME) {
            fprintf(stderr, "corpus-host.cx: name too long in %s\n", path);
            fclose(f);
            return -1;
        }
        if (n >= MAX_NAMES) {
            fprintf(stderr, "corpus-host.cx: too many names in %s\n", path);
            fclose(f);
            return -1;
        }
        memcpy(names[n], line, L + 1);
        n++;
    }
    fclose(f);
    *out_n = n;
    return 0;
}

static int run_one(const char *dir, const char *base, int want_ok) {
    char src[512], outp[512];
    char *av[6];
    char *cap = 0;
    size_t n = 0;
    int rc;
    snprintf(src, sizeof src, "%s/%s", dir, base);
    snprintf(outp, sizeof outp, "/tmp/ujs-corpus-%s.wasm", base);
    if (!exists(src)) {
        fprintf(stderr, "missing %s\n", src);
        return 1;
    }
    unlink(outp);
    av[0] = "./ujs/ujs.com";
    av[1] = src;
    av[2] = "-o";
    av[3] = outp;
    av[4] = 0;
    rc = cx_runv_timeout(av, 30, &cap, &n);
    free(cap); cap = 0; n = 0;
    if (rc == 127) {
        av[0] = "sh";
        av[1] = "./ujs/ujs.com";
        av[2] = src;
        av[3] = "-o";
        av[4] = outp;
        av[5] = 0;
        rc = cx_runv_timeout(av, 30, &cap, &n);
        free(cap);
    }
    if (want_ok) {
        if (rc != 0 || !exists(outp)) {
            fprintf(stderr, "expected PASS %s rc=%d\n", base, rc);
            return 1;
        }
        return 0;
    }
    if (rc == 0 && exists(outp)) {
        fprintf(stderr, "expected REFUSE %s but wrote wasm\n", base);
        return 1;
    }
    return 0;
}

int main(int argc, char **argv) {
    int i, bad = 0;
    (void)argc;
    if (enter_root(argv[0]) != 0) {
        fprintf(stderr, "corpus-host.cx: need repo root\n");
        return 2;
    }
    /* Ship oracle never opens tests/ujs2wasm/expect.json or *.mjs */
    if (!exists("./ujs/ujs.com")) {
        fprintf(stderr, "corpus-host.cx: build host first (build.cx)\n");
        return 2;
    }
    if (load_list("ujs/tests/host1-pass.txt", pass_names, &n_pass) != 0) return 2;
    if (load_list("ujs/tests/host1-refuse.txt", refuse_names, &n_refuse) != 0) return 2;
    if (n_pass != EXPECT_PASS) {
        fprintf(stderr, "corpus-host.cx: host1-pass count=%d want=%d\n", n_pass, EXPECT_PASS);
        return 1;
    }
    for (i = 0; i < n_pass; i++)
        bad += run_one("ujs/tests/corpus", pass_names[i], 1);
    for (i = 0; i < n_refuse; i++)
        bad += run_one("ujs/tests/neg", refuse_names[i], 0);
    if (bad) {
        fprintf(stderr, "corpus-host.cx: %d mismatches\n", bad);
        return 1;
    }
    /* 一批验面：一次 ujs.com 进程（避免 28×fork） */
    {
        char *av[5];
        char *cap = 0;
        size_t n = 0;
        int rc;
        av[0] = "./ujs/ujs.com";
        av[1] = "--verify-list";
        av[2] = "ujs/tests/host1-pass.txt";
        av[3] = "/tmp/ujs-corpus-";
        av[4] = 0;
        rc = cx_runv_timeout(av, 30, &cap, &n);
        if (cap && n) fwrite(cap, 1, n, stdout);
        free(cap); cap = 0; n = 0;
        if (rc == 127) {
            char *shav[6];
            shav[0] = "sh";
            shav[1] = "./ujs/ujs.com";
            shav[2] = "--verify-list";
            shav[3] = "ujs/tests/host1-pass.txt";
            shav[4] = "/tmp/ujs-corpus-";
            shav[5] = 0;
            rc = cx_runv_timeout(shav, 30, &cap, &n);
            if (cap && n) fwrite(cap, 1, n, stdout);
            free(cap);
        }
        if (rc != 0) {
            fprintf(stderr, "corpus-host.cx: verify-list failed rc=%d\n", rc);
            return 1;
        }
    }
    /* 冒充实文件必须拒绝 */
    {
        char *av[4];
        char *cap = 0;
        size_t n = 0;
        int rc;
        FILE *bf = fopen("/tmp/ujs-verify-bogus.wasm", "wb");
        if (!bf) {
            fprintf(stderr, "corpus-host.cx: cannot write bogus\n");
            return 1;
        }
        fwrite("notwasm", 1, 7, bf);
        fclose(bf);
        av[0] = "./ujs/ujs.com";
        av[1] = "--verify";
        av[2] = "/tmp/ujs-verify-bogus.wasm";
        av[3] = 0;
        rc = cx_runv_timeout(av, 10, &cap, &n);
        free(cap); cap = 0; n = 0;
        if (rc == 127) {
            char *shav[5];
            shav[0] = "sh";
            shav[1] = "./ujs/ujs.com";
            shav[2] = "--verify";
            shav[3] = "/tmp/ujs-verify-bogus.wasm";
            shav[4] = 0;
            rc = cx_runv_timeout(shav, 10, &cap, &n);
            free(cap);
        }
        if (rc == 0) {
            fprintf(stderr, "corpus-host.cx: bogus wasm should refuse\n");
            return 1;
        }
    }
    printf("corpus-host.cx: ok pass=%d refuse_catalog=%d verify_list=1 bogus_refuse=1 (host1_package)\n",
           n_pass, n_refuse);
    return 0;
}
