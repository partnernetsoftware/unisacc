#!/usr/bin/env -S unisacc.com -run
/* Ask ujs/weights/nets/parse.net.tsv on every NT x TOKS key.
   hv = b1[j] + 1 per active coord that feeds j; if hv>0 add W2 once.
   sh ./unisacc.com ujs/product/net-parse-check.cx
*/
static const char *NT[] = {
    "top", "stmt", "unary", "postfix", "primary", "pswitch", 0
};
static const char *TOKS[] = {
    "eof", "id", "num", "str", "null", "true", "false",
    "let", "function", "if", "else", "while", "for", "return",
    "break", "continue", "switch", "case", "default",
    "typeof", "of", "in",
    "{", "}", "(", ")", "[", "]", ";", ",", ":", ".", "?",
    "=", "==", "!=", "<", ">", "<=", ">=",
    "+", "-", "*", "/", "%", "&&", "||", "!", "??",
    "=>", "+=", "-=", "*=", "/=",
    "...",
    0
};

static int eq(const char *a, const char *b) { return !strcmp(a, b); }
static int one_of(const char *t, const char *const *xs) {
    int i; for (i = 0; xs[i]; i++) if (eq(t, xs[i])) return 1; return 0;
}
static const char *parse_label(const char *nt, const char *tok) {
    static const char *stmt_kw[] = {
        "if", "while", "for", "switch", "return",
        "break", "continue", "let", 0
    };
    static const char *cd[] = { "case", "default", 0 };
    static const char *lit[] = { "null", "true", "false", 0 };
    static const char *ps[] = { "case", "default", "}", 0 };
    if (eq(nt, "top")) {
        if (eq(tok, "eof")) return "end";
        if (eq(tok, "function")) return "fn";
        if (eq(tok, "let")) return "let";
        return "expr";
    }
    if (eq(nt, "stmt")) {
        if (eq(tok, "{")) return "block";
        if (eq(tok, "function")) return "fn";
        if (one_of(tok, stmt_kw)) return tok;
        if (one_of(tok, cd)) return tok;
        return "expr";
    }
    if (eq(nt, "unary")) {
        if (eq(tok, "-")) return "neg";
        if (eq(tok, "!")) return "not";
        if (eq(tok, "...")) return "spread";
        if (eq(tok, "typeof")) return "typeof";
        return "prim";
    }
    if (eq(nt, "postfix")) {
        if (eq(tok, "[")) return "index";
        if (eq(tok, "(")) return "call";
        if (eq(tok, ".")) return "dot";
        return "done";
    }
    if (eq(nt, "primary")) {
        if (eq(tok, "id")) return "ident";
        if (eq(tok, "num")) return "number";
        if (eq(tok, "str")) return "string";
        if (one_of(tok, lit)) return tok;
        if (eq(tok, "[")) return "list";
        if (eq(tok, "{")) return "dict";
        if (eq(tok, "(")) return "paren";
        return "bad";
    }
    if (eq(nt, "pswitch")) {
        if (!one_of(tok, ps)) return "bad";
        if (eq(tok, "}")) return "done";
        return tok;
    }
    return "expr";
}
static int nstr(const char **a) { int n = 0; while (a[n]) n++; return n; }

enum { HMAX = 64, CMAX = 80, CLSMAX = 48, FMAX = 16 };
static int H, ncls, ncoord;
static int b1[HMAX];
static int feedn[CMAX];
static int feedu[CMAX][FMAX];
static int w2c[HMAX], w2w[HMAX];
static char cls[CLSMAX][32];

static int feeds(int coord, int unit) {
    int k;
    for (k = 0; k < feedn[coord]; k++) if (feedu[coord][k] == unit) return 1;
    return 0;
}

static int ask(int ni, int ti) {
    int j, c, hv, best = -1, bestv = -999999, logit[CLSMAX];
    int a0 = ni, a1 = 6 + ti;
    for (c = 0; c < ncls; c++) logit[c] = 0;
    for (j = 0; j < H; j++) {
        hv = b1[j];
        if (feeds(a0, j)) hv++;
        if (feeds(a1, j)) hv++;
        if (hv > 0) logit[w2c[j]] += w2w[j];
    }
    for (c = 0; c < ncls; c++) {
        if (best < 0 || logit[c] > bestv) { best = c; bestv = logit[c]; }
    }
    return best;
}

static int load_net(void) {
    FILE *f = fopen("ujs/weights/nets/parse.net.tsv", "rb");
    char line[1024];
    int i;
    if (!f) return 1;
    for (i = 0; i < CMAX; i++) feedn[i] = 0;
    ncoord = 0; H = 0; ncls = 0;
    while (fgets(line, (int)sizeof line, f)) {
        if (!strncmp(line, "class\t", 6)) {
            char *p = line + 6;
            ncls = 0;
            while (*p && *p != '\n' && ncls < CLSMAX) {
                char *q = p; int n;
                while (*p && *p != '\t' && *p != '\n') p++;
                n = (int)(p - q);
                if (n <= 0 || n >= 32) { fclose(f); return 1; }
                memcpy(cls[ncls], q, (size_t)n); cls[ncls][n] = 0;
                ncls++;
                if (*p == '\t') p++;
            }
        } else if (!strncmp(line, "H\t", 2)) {
            H = atoi(line + 2);
            if (H <= 0 || H > HMAX) { fclose(f); return 1; }
        } else if (!strncmp(line, "b1\t", 3)) {
            char *p = line + 3; int j = 0;
            while (*p && *p != '\n' && j < H) {
                b1[j++] = atoi(p);
                while (*p && *p != '\t' && *p != '\n') p++;
                if (*p == '\t') p++;
            }
            if (j != H) { fclose(f); return 1; }
        } else if (!strncmp(line, "feed\t", 5)) {
            char *p = line + 5; int coord, u, k = 0;
            coord = atoi(p);
            while (*p && *p != '\t' && *p != '\n') p++;
            if (*p == '\t') p++;
            while (*p && *p != '\n' && k < FMAX) {
                if (*p >= '0' && *p <= '9') {
                    u = atoi(p);
                    feedu[coord][k++] = u;
                    while (*p && *p != '\t' && *p != '\n') p++;
                    if (*p == '\t') p++;
                } else break;
            }
            if (coord < 0 || coord >= CMAX) { fclose(f); return 1; }
            feedn[coord] = k;
            if (coord + 1 > ncoord) ncoord = coord + 1;
        } else if (!strncmp(line, "w2\t", 3)) {
            char *p = line + 3; int h, c, w;
            h = atoi(p);
            while (*p && *p != '\t') p++;
            if (*p != '\t') { fclose(f); return 1; }
            p++;
            c = atoi(p);
            while (*p && *p != ':') p++;
            if (*p != ':') { fclose(f); return 1; }
            p++;
            w = atoi(p);
            if (h < 0 || h >= H) { fclose(f); return 1; }
            w2c[h] = c; w2w[h] = w;
        }
    }
    fclose(f);
    return (H > 0 && ncls > 0 && ncoord >= 61) ? 0 : 1;
}

int main(void) {
    int ni, ti, nn, nt, pred, fail = 0, ok = 0;
    const char *want;
    nn = nstr(NT); nt = nstr(TOKS);
    if (load_net()) {
        fprintf(stderr, "net-parse-check.cx: load failed\n");
        return 1;
    }
    for (ni = 0; ni < nn; ni++) {
        for (ti = 0; ti < nt; ti++) {
            want = parse_label(NT[ni], TOKS[ti]);
            pred = ask(ni, ti);
            if (pred < 0 || pred >= ncls || strcmp(cls[pred], want) != 0) {
                if (fail < 8) {
                    fprintf(stderr, "net-parse-check.cx: %s %s gold=%s net=%s\n",
                            NT[ni], TOKS[ti], want,
                            (pred >= 0 && pred < ncls) ? cls[pred] : "?");
                }
                fail++;
            } else ok++;
        }
    }
    if (fail) {
        fprintf(stderr, "net-parse-check.cx: fail=%d ok=%d keys=%d\n", fail, ok, nn * nt);
        return 1;
    }
    printf("net-parse-check.cx: ok keys=%d H=%d classes=%d\n", ok, H, ncls);
    return 0;
}
