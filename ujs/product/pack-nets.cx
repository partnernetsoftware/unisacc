#!/usr/bin/env -S unisacc.com -run
/* Pack ten net files into P 2 (0 models, 0 stages, 10 resources).
   sh ./unisacc.com ujs/product/pack-nets.cx -- --write|--check
   Out: ujs/weights/ujs-nets.pkg
*/
static const char *NAMES[] = {
    "enc", "ic", "irsel", "isel", "lex", "parse", "reloc", "scope", "shape", "type",
    0
};

static int slurp(const char *path, unsigned char **out, int *out_n) {
    FILE *f = fopen(path, "rb");
    long sz; unsigned char *p; size_t k;
    if (!f) return 1;
    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return 1; }
    sz = ftell(f);
    if (sz < 0 || sz > 8 * 1024 * 1024) { fclose(f); return 1; }
    if (fseek(f, 0, SEEK_SET) != 0) { fclose(f); return 1; }
    p = (unsigned char *)malloc((size_t)sz + 1);
    if (!p) { fclose(f); return 1; }
    k = fread(p, 1, (size_t)sz, f);
    fclose(f);
    if (k != (size_t)sz) { free(p); return 1; }
    *out = p; *out_n = (int)sz; return 0;
}

static int nstr(const char **a) { int n = 0; while (a[n]) n++; return n; }

int main(int argc, char **argv) {
    int write = 0, i, n = nstr(NAMES);
    unsigned char *body[12];
    int bn[12];
    char key[12][64];
    int kn[12];
    unsigned char *pkg; int pn = 0, cap = 0;
    const char *outp = "ujs/weights/ujs-nets.pkg";
    FILE *f;
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--write")) write = 1;
        else if (!strcmp(argv[i], "--check")) ;
        else {
            fprintf(stderr, "pack-nets.cx: unknown %s\n", argv[i]);
            return 2;
        }
    }
    for (i = 0; i < n; i++) {
        char path[128];
        sprintf(path, "ujs/weights/nets/%s.net.tsv", NAMES[i]);
        if (slurp(path, &body[i], &bn[i]) != 0) {
            fprintf(stderr, "pack-nets.cx: missing %s\n", path);
            return 1;
        }
        kn[i] = sprintf(key[i], "nets/%s.net.tsv", NAMES[i]);
        cap += kn[i] + bn[i] + 64;
    }
    cap += 64;
    pkg = (unsigned char *)malloc((size_t)cap);
    if (!pkg) return 1;
    pn += sprintf((char *)pkg + pn, "P 2 0 0 %d\n", n);
    for (i = 0; i < n; i++) {
        pn += sprintf((char *)pkg + pn, "F %d %d\n", kn[i], bn[i]);
        memcpy(pkg + pn, key[i], (size_t)kn[i]); pn += kn[i];
        memcpy(pkg + pn, body[i], (size_t)bn[i]); pn += bn[i];
    }
    if (write) {
        f = fopen(outp, "wb");
        if (!f) { fprintf(stderr, "pack-nets.cx: cannot write %s\n", outp); return 1; }
        if ((int)fwrite(pkg, 1, (size_t)pn, f) != pn) { fclose(f); return 1; }
        fclose(f);
        printf("pack-nets.cx: wrote %s bytes=%d resources=%d\n", outp, pn, n);
    } else {
        unsigned char *have; int hn;
        if (slurp(outp, &have, &hn) != 0) {
            fprintf(stderr, "pack-nets.cx: missing %s\n", outp);
            return 1;
        }
        if (hn != pn || memcmp(have, pkg, (size_t)pn) != 0) {
            fprintf(stderr, "pack-nets.cx: STALE %s\n", outp);
            free(have);
            return 1;
        }
        free(have);
        if (pn < 4 || memcmp(pkg, "P 2 ", 4) != 0) {
            fprintf(stderr, "pack-nets.cx: not P 2\n");
            return 1;
        }
        printf("pack-nets.cx: ok bytes=%d resources=%d\n", pn, n);
    }
    for (i = 0; i < n; i++) free(body[i]);
    free(pkg);
    return 0;
}
