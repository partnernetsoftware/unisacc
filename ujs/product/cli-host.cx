#!/usr/bin/env -S unisacc.com -run
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use ux_abi_check
/* 0.0.7 daily chain: FILE.ujs --run, -o, help, four refuses.
   ./unisacc.com -run ujs/product/cli-host.cx
   Prints cli-host.cx: ok. No Python / Node.
*/
static int exists(const char *p) {
    FILE *f = fopen(p, "rb");
    if (!f) return 0;
    fclose(f);
    return 1;
}

static int enter_root(const char *argv0) {
    char dir[4096];
    size_t l;
    char *sl;
    if (exists("./ujs/tests/corpus/arith.ujs")) return 0;
    if (!argv0 || !argv0[0]) return -1;
    l = strlen(argv0);
    if (l >= sizeof dir) return -1;
    memcpy(dir, argv0, l + 1);
    sl = strrchr(dir, '/');
    if (!sl) return -1;
    *sl = 0;
    if (chdir(dir) != 0) return -1;
    return chdir("../..");
}

static int run_bin(char **av, int nac, char **outp, size_t *np) {
    int rc;
    char *cap = 0;
    size_t n = 0;
    rc = cx_runv_timeout(av, 30, &cap, &n);
    if (rc == 127) {
        char *shav[8];
        int i;
        free(cap); cap = 0; n = 0;
        shav[0] = "sh";
        for (i = 0; i < nac && i < 6; i++) shav[i + 1] = av[i];
        shav[nac + 1] = 0;
        rc = cx_runv_timeout(shav, 30, &cap, &n);
    }
    *outp = cap;
    *np = n;
    return rc;
}

static int capture(char **av, int nac, char *buf, size_t cap, size_t *n_out) {
    char *out = 0;
    size_t n = 0;
    int rc = run_bin(av, nac, &out, &n);
    if (rc != 0 || !out) {
        free(out);
        return -1;
    }
    if (n >= cap) n = cap - 1;
    memcpy(buf, out, n);
    buf[n] = 0;
    *n_out = n;
    free(out);
    return 0;
}

static int refuse(const char *cmd, const char *wasm_path) {
    char shcmd[1200];
    char *av[4];
    char *cap = 0;
    size_t n = 0;
    int rc;
    FILE *f;
    char err[512];
    size_t got;
    unlink("/tmp/ujs06-out.txt");
    unlink("/tmp/ujs06-err.txt");
    if (wasm_path) unlink(wasm_path);
    snprintf(shcmd, sizeof shcmd, "%s > /tmp/ujs06-out.txt 2> /tmp/ujs06-err.txt", cmd);
    av[0] = "sh";
    av[1] = "-c";
    av[2] = shcmd;
    av[3] = 0;
    rc = cx_runv_timeout(av, 30, &cap, &n);
    free(cap);
    if (rc == 0) {
        fprintf(stderr, "cli-host.cx: expected non-zero: %s\n", cmd);
        return 1;
    }
    f = fopen("/tmp/ujs06-err.txt", "rb");
    if (!f) {
        fprintf(stderr, "cli-host.cx: no stderr for %s\n", cmd);
        return 1;
    }
    got = fread(err, 1, sizeof err - 1, f);
    fclose(f);
    err[got] = 0;
    if (got < 8 || memcmp(err, "ujs.com:", 8) != 0) {
        fprintf(stderr, "cli-host.cx: stderr prefix: [%s]\n", err);
        return 1;
    }
    if (wasm_path && exists(wasm_path)) {
        fprintf(stderr, "cli-host.cx: wasm left behind %s\n", wasm_path);
        return 1;
    }
    return 0;
}

static int compiler_entry(void) {
    const char *gold_path = "ujs/practice/uxe/test/d1-flight.wasm";
    char dir[256], first_path[300], second_path[300], rejected_path[300];
    char gold[2048], *out = 0;
    unsigned char *first = 0, *second = 0, *expected = 0;
    int64_t first_n = 0, second_n = 0, expected_n = 0;
    size_t out_n = 0;
    sy_stat_t rejected_stat;
    const char heading[] = "\"tag\":\"i64\",\"value\":0,";
    const char packet[] = "\"gpu_len\":11,\"gpu_sum\":341,\"gpu_fnv\":3878376924,";
    char *compile[] = {"./ujs/ujs2wasm.com", "ujs/tests/d1-flight.ujs", "-o", first_path, 0};
    char *run[] = {"./ujs/ujs2wasm.com", "--run", first_path, 0};
    int same = 0, compatible = 0, replay = 0, rejected = 0;
    if (sy_mkdtemp("/tmp", "ujs2wasm-cli-", dir, sizeof dir)) return 1;
    tx_snprintf(first_path, sizeof first_path, "%s/first.wasm", dir);
    tx_snprintf(second_path, sizeof second_path, "%s/second.wasm", dir);
    tx_snprintf(rejected_path, sizeof rejected_path, "%s/rejected.wasm", dir);
    if (run_bin(compile, 4, &out, &out_n) == 0) {
        sy_read_file(first_path, &first, &first_n, 65536);
    }
    mm_free(out);
    compile[3] = second_path;
    if (run_bin(compile, 4, &out, &out_n) == 0) {
        sy_read_file(second_path, &second, &second_n, 65536);
    }
    mm_free(out);
    sy_read_file(gold_path, &expected, &expected_n, 65536);
    same = first && second && first_n && first_n == second_n && !mm_cmp(first, second, first_n);
    compatible = first && expected && first_n && first_n == expected_n && !mm_cmp(first, expected, first_n);
    replay = capture(run, 3, gold, sizeof gold, &out_n) == 0 &&
        tx_contains(gold, out_n, heading, sizeof heading - 1) &&
        tx_contains(gold, out_n, packet, sizeof packet - 1);
    compile[1] = "ujs/tests/neg/bad_lex.ujs";
    compile[3] = rejected_path;
    rejected = run_bin(compile, 4, &out, &out_n) == 1 &&
        sy_lstat(rejected_path, &rejected_stat) == -ENOENT;
    mm_free(out);
    mm_free(first);
    mm_free(second);
    mm_free(expected);
    sy_unlink(first_path);
    sy_unlink(second_path);
    sy_unlink(rejected_path);
    sy_rmdir(dir);
    printf("UJS2WASM_CLI deterministic=%d compatible=%d d1_gold=%d rejects_invalid=%d\n",
        same, compatible, replay, rejected);
    return !(same && compatible && replay && rejected);
}

int main(int argc, char **argv) {
    char *av[8];
    char ver[64], help[2048], two[2048], one[2048], both[2048];
    char *junk = 0;
    size_t nv = 0, nh = 0, ntwo = 0, none = 0, nboth = 0, jn = 0;
    FILE *f;
    int side_before;
    ver[0] = help[0] = two[0] = one[0] = both[0] = 0;
    (void)argc;

    if (enter_root(argv[0]) != 0 || !exists("./ujs/ujs.com")) {
        fprintf(stderr, "cli-host.cx: need repo root and ujs/ujs.com\n");
        return 2;
    }
    if (argc == 2 && tx_eq(argv[1], "--mutate-ux-abi", sizeof "--mutate-ux-abi")) return check_ux_abi(1);
    if (argc == 2 && tx_eq(argv[1], "--ux-views", sizeof "--ux-views")) return check_ux_views(0);
    if (argc == 2 && tx_eq(argv[1], "--mutate-ux-views", sizeof "--mutate-ux-views")) return check_ux_views(1);
    if (argc == 2 && tx_eq(argv[1], "--f64-math", sizeof "--f64-math")) return check_f64_math(0);
    if (argc == 2 && tx_eq(argv[1], "--mutate-f64-math", sizeof "--mutate-f64-math")) return check_f64_math(1);
    if (argc == 2 && tx_eq(argv[1], "--mutate-u32", sizeof "--mutate-u32")) return check_u32(1);
    if (argc == 2 && tx_eq(argv[1], "--mutate-floor", sizeof "--mutate-floor")) return check_floor(1);
    if (argc == 2 && tx_eq(argv[1], "--mutate-branch", sizeof "--mutate-branch")) return check_branch_depth(1);
    if (argc == 2 && tx_eq(argv[1], "--mutate-locals", sizeof "--mutate-locals")) return check_locals(1);

    av[0] = "./ujs/ujs.com";
    av[1] = "--version";
    av[2] = 0;
    if (capture(av, 2, ver, sizeof ver, &nv) != 0 || strcmp(ver, "ujs.com 0.0.7\n") != 0) {
        fprintf(stderr, "cli-host.cx: version [%s]\n", ver);
        return 1;
    }

    av[1] = "--help";
    if (capture(av, 2, help, sizeof help, &nh) != 0 ||
        !strstr(help, "ujs.com 0.0.7") || !strstr(help, "FILE.ujs --run")) {
        fprintf(stderr, "cli-host.cx: help missing chain or version\n");
        return 1;
    }

    side_before = exists("ujs/tests/corpus/arith.wasm");
    av[1] = "ujs/tests/corpus/arith.ujs";
    av[2] = "-o";
    av[3] = "/tmp/ujs06-two.wasm";
    av[4] = 0;
    if (run_bin(av, 4, &junk, &jn) != 0 || !exists("/tmp/ujs06-two.wasm")) {
        fprintf(stderr, "cli-host.cx: two-step compile failed\n");
        free(junk);
        return 1;
    }
    free(junk);
    av[1] = "--run";
    av[2] = "/tmp/ujs06-two.wasm";
    av[3] = 0;
    if (capture(av, 3, two, sizeof two, &ntwo) != 0 || !strstr(two, "\"tag\":\"i64\"") ||
        !strstr(two, "\"value\":7")) {
        fprintf(stderr, "cli-host.cx: two-step run [%s]\n", two);
        return 1;
    }

    av[1] = "ujs/tests/corpus/arith.ujs";
    av[2] = "--run";
    av[3] = 0;
    if (capture(av, 3, one, sizeof one, &none) != 0 || ntwo != none ||
        memcmp(two, one, ntwo) != 0) {
        fprintf(stderr, "cli-host.cx: one-shot mismatch\n[%s]\n[%s]\n", two, one);
        return 1;
    }
    if (exists("ujs/tests/corpus/arith.wasm") != side_before) {
        fprintf(stderr, "cli-host.cx: FILE.ujs --run wrote a default wasm\n");
        return 1;
    }

    av[1] = "ujs/tests/corpus/arith.ujs";
    av[2] = "-o";
    av[3] = "/tmp/ujs06-o.wasm";
    av[4] = "--run";
    av[5] = 0;
    if (capture(av, 5, both, sizeof both, &nboth) != 0 || !exists("/tmp/ujs06-o.wasm") ||
        nboth != ntwo || memcmp(both, two, ntwo) != 0) {
        fprintf(stderr, "cli-host.cx: -o --run mismatch [%s]\n", both);
        return 1;
    }
    av[1] = "--run";
    av[2] = "/tmp/ujs06-o.wasm";
    av[3] = 0;
    if (capture(av, 3, one, sizeof one, &none) != 0 || none != nboth ||
        memcmp(one, both, nboth) != 0) {
        fprintf(stderr, "cli-host.cx: --run of -o file mismatch\n");
        return 1;
    }

    if (refuse("./ujs/ujs.com /tmp/ujs06-missing-no-such.ujs --run -o /tmp/ujs06-miss.wasm",
               "/tmp/ujs06-miss.wasm"))
        return 1;
    f = fopen("/tmp/ujs06-notujs.txt", "wb");
    if (!f) return 1;
    fputs("nope\n", f);
    fclose(f);
    if (refuse("./ujs/ujs.com /tmp/ujs06-notujs.txt --run -o /tmp/ujs06-badext.wasm",
               "/tmp/ujs06-badext.wasm"))
        return 1;
    if (refuse("./ujs/ujs.com ujs/tests/corpus/arith.ujs --bogus -o /tmp/ujs06-unk.wasm",
               "/tmp/ujs06-unk.wasm"))
        return 1;
    if (refuse("./ujs/ujs.com ujs/tests/neg/bad_lex.ujs --run -o /tmp/ujs06-neg.wasm",
               "/tmp/ujs06-neg.wasm"))
        return 1;

    if (compiler_entry() || check_ux_abi(0) || check_ux_views(0) || check_f64_math(0) || check_u32(0) || check_floor(0) ||
        check_branch_depth(0) || check_locals(0)) return 1;
    printf("cli-host.cx: ok\n");
    return 0;
}
