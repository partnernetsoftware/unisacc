#!/usr/bin/env -S unisacc.com -run
/* Emit host1 ujs.com for all six -b targets (native images, not APE polyglot).
   unisacc.com + .cx only. No #include.
   Usage: ./unisacc.com -run ujs/product/build-six.cx [-- DIR]
   Default DIR=/tmp/ujs-six-out
*/
static const char *TARGETS[] = {
    "lnx/x86_64", "lnx/arm64",
    "osx/x86_64", "osx/arm64",
    "win/x86_64", "win/arm64",
    0
};

static int exists(const char *p) {
    FILE *f = fopen(p, "rb");
    if (!f) return 0;
    fclose(f);
    return 1;
}

static int enter_root(const char *argv0) {
    char dir[4096];
    size_t l;
    char *sl;
    if (!argv0 || !argv0[0]) return -1;
    l = strlen(argv0);
    if (l >= sizeof dir) return -1;
    memcpy(dir, argv0, l + 1);
    sl = strrchr(dir, '/');
    if (!sl) return -1;
    *sl = 0;
    if (chdir(dir) != 0) return -1;
    if (chdir("../..") != 0) return -1;
    return 0;
}

static void slash_to_dash(const char *t, char *safe, size_t cap) {
    size_t i;
    for (i = 0; t[i] && i + 1 < cap; i++)
        safe[i] = (t[i] == '/') ? '-' : t[i];
    safe[i] = 0;
}

int main(int argc, char **argv) {
    const char *outdir = "/tmp/ujs-six-out";
    char *out = 0;
    size_t n = 0;
    int i, rc, fails = 0;
    char path[512], safe[64], mk[640];
    char *av[12];

    if (enter_root(argv[0]) != 0 && !exists("./unisacc.com")) {
        fprintf(stderr, "build-six.cx: need repo root\n");
        return 2;
    }
    if (!exists("./unisacc.com")) {
        fprintf(stderr, "build-six.cx: missing ./unisacc.com\n");
        return 2;
    }
    for (i = 1; i < argc; i++) {
        if (argv[i][0] != '-') {
            outdir = argv[i];
            break;
        }
    }

    snprintf(mk, sizeof mk, "mkdir -p '%s'", outdir);
    av[0] = "sh"; av[1] = "-c"; av[2] = mk; av[3] = 0;
    rc = cx_runv_timeout(av, 5, &out, &n);
    free(out);
    out = 0;
    n = 0;
    if (rc != 0) {
        fprintf(stderr, "build-six.cx: mkdir failed\n");
        return 1;
    }

    for (i = 0; TARGETS[i]; i++) {
        slash_to_dash(TARGETS[i], safe, sizeof safe);
        snprintf(path, sizeof path, "%s/ujs-%s.com", outdir, safe);
        av[0] = "sh";
        av[1] = "./unisacc.com";
        av[2] = "-DUJS_HOST";
        av[3] = "ujs/product/ujs_main.cx";
        av[4] = "ujs/product/host1_vm.cx";
        av[5] = "ujs/seed/stage0/compiler_min.cx";
        av[6] = "-b";
        av[7] = (char *)TARGETS[i];
        av[8] = "-o";
        av[9] = path;
        av[10] = 0;
        rc = cx_runv_timeout(av, 60, &out, &n);
        if (rc != 0 || !exists(path)) {
            fprintf(stderr, "build-six.cx: FAIL %s rc=%d\n", TARGETS[i], rc);
            if (out && n) fwrite(out, 1, n, stderr);
            fails++;
        } else {
            printf("OK %s -> %s\n", TARGETS[i], path);
        }
        free(out);
        out = 0;
        n = 0;
    }

    if (fails) {
        fprintf(stderr, "build-six.cx: %d target(s) failed\n", fails);
        return 1;
    }

    /* smoke host triple only when image is this machine */
    snprintf(path, sizeof path, "%s/ujs-lnx-x86_64.com", outdir);
    if (exists(path)) {
        av[0] = path;
        av[1] = "ujs/tests/corpus/arith.ujs";
        av[2] = "-o";
        av[3] = "/tmp/ujs-six-build-arith.wasm";
        av[4] = 0;
        rc = cx_runv_timeout(av, 30, &out, &n);
        if (out && n) fwrite(out, 1, n, stdout);
        free(out);
        if (rc != 0 || !exists("/tmp/ujs-six-build-arith.wasm")) {
            fprintf(stderr, "build-six.cx: lnx/x86_64 smoke failed rc=%d\n", rc);
            return 1;
        }
    }
    printf("build-six.cx: ok (6 native targets; APE via build-ape.cx)\n");
    return 0;
}
