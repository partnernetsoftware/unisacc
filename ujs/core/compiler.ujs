// M3 compiler core — real wasm emit aligned with stage0 bodies.
// v10: v9 + f64 global default/promote; sim body≡stage0; OPS/OUT 32k.
// Host splices OUT[0..OUTN) into RT.

let pos = 0;
let n = 0;
let ch = 0;
let ok = 1;
let kn = 0;
let k = 0;
let mul = 0;
let i = 0;
let j = 0;
let tnum = 0;
let outn = 0;
let opsn = 0;
let slot = 0;
let found = 0;
let done = 0;
let cd = 0;
let finished = 0;
let want = 0;
let op = 0;
let prec = 0;
let bsp = 0;
let st = 0;
let dst = 0;
let lx = 0;
let depth = 0;
let csp = 0;
let ety = 1;
let gn = 0;
let gs = 0;
let idx_slot = 0;
let idx_g = 0;
let iphase = 0;
let elem_f = 0;
let fneg = 0;
let fbits = 0;
let fden = 0;
let fexp = 0;
let fsc = -1;
let fl = 0;
let dsc = -1;
let dpn = 0;
let dpi = 0;
let dkn = 0;
let dsave = 0;
let DKEY = list(8);
let TWO52 = 4503599627370496;

let OUT = list(32768);
let OPS = list(32768);
let KEYS = list(96);
let LTY = list(96);
let GKEYS = list(16);
let GTY = list(16);
let ST = list(128);
let SOP = list(128);
let SPR = list(128);
let CST = list(64);

n = len(SRC);

finished = 0;
while (finished == 0) {
  if (ok != 1) { finished = 1; }
  else {
    // skip ws + //
    done = 0;
    while (done == 0) {
      if (pos >= n) { done = 1; }
      else {
        ch = SRC[pos];
        if (ch == 32) { pos = pos + 1; }
        else {
          if (ch == 9) { pos = pos + 1; }
          else {
            if (ch == 10) { pos = pos + 1; }
            else {
              if (ch == 13) { pos = pos + 1; }
              else {
                if (ch == 47) {
                  if (pos + 1 < n) {
                    if (SRC[pos + 1] == 47) {
                      pos = pos + 2;
                      cd = 0;
                      while (cd == 0) {
                        if (pos >= n) { cd = 1; }
                        else {
                          if (SRC[pos] == 10) { pos = pos + 1; cd = 1; }
                          else { pos = pos + 1; }
                        }
                      }
                    } else { done = 1; }
                  } else { done = 1; }
                } else { done = 1; }
              }
            }
          }
        }
      }
    }

    if (pos >= n) {
      if (depth == 0) { finished = 1; }
      else { ok = 0; finished = 1; }
    } else {
      if (SRC[pos] == 125) {
        pos = pos + 1;
        if (depth <= 0) { ok = 0; finished = 1; }
        else {
          if (csp <= 0) { ok = 0; finished = 1; }
          else {
            depth = depth - 1;
            csp = csp - 1;
            op = CST[csp];
            if (op == 1) {
              OPS[opsn] = 12; opsn = opsn + 1;
              OPS[opsn] = 0; opsn = opsn + 1;
              OPS[opsn] = 11; opsn = opsn + 1;
              OPS[opsn] = 11; opsn = opsn + 1;
            } else {
              if (op == 2) {
                done = 0;
                while (done == 0) {
                  if (pos >= n) { done = 1; }
                  else {
                    ch = SRC[pos];
                    if (ch == 32) { pos = pos + 1; }
                    else {
                      if (ch == 9) { pos = pos + 1; }
                      else {
                        if (ch == 10) { pos = pos + 1; }
                        else {
                          if (ch == 13) { pos = pos + 1; }
                          else { done = 1; }
                        }
                      }
                    }
                  }
                }
                found = 0;
                if (pos + 3 < n) {
                  if (SRC[pos] == 101) {
                    if (SRC[pos + 1] == 108) {
                      if (SRC[pos + 2] == 115) {
                        if (SRC[pos + 3] == 101) { found = 1; }
                      }
                    }
                  }
                }
                if (found == 1) {
                  pos = pos + 4;
                  done = 0;
                  while (done == 0) {
                    if (pos >= n) { done = 1; }
                    else {
                      ch = SRC[pos];
                      if (ch == 32) { pos = pos + 1; }
                      else {
                        if (ch == 9) { pos = pos + 1; }
                        else {
                          if (ch == 10) { pos = pos + 1; }
                          else {
                            if (ch == 13) { pos = pos + 1; }
                            else { done = 1; }
                          }
                        }
                      }
                    }
                  }
                  if (pos >= n) { ok = 0; finished = 1; }
                  else {
                    if (SRC[pos] != 123) { ok = 0; finished = 1; }
                    else {
                      pos = pos + 1;
                      OPS[opsn] = 5; opsn = opsn + 1;
                      CST[csp] = 3; csp = csp + 1;
                      depth = depth + 1;
                    }
                  }
                } else {
                  // stage0 always emits empty else before end
                  OPS[opsn] = 5; opsn = opsn + 1;
                  OPS[opsn] = 11; opsn = opsn + 1;
                }
              } else {
                if (op == 3) {
                  OPS[opsn] = 11; opsn = opsn + 1;
                } else { ok = 0; finished = 1; }
              }
            }
          }
        }
      } else {
      if (iphase == 1) {
        want = 7;
        iphase = 0;
      } else {
      want = 0;
      // let_// let_
      if (pos + 3 < n) {
        if (SRC[pos] == 108) {
          if (SRC[pos + 1] == 101) {
            if (SRC[pos + 2] == 116) {
              ch = SRC[pos + 3];
              if (ch == 32) { want = 1; }
              if (ch == 9) { want = 1; }
              if (ch == 10) { want = 1; }
            }
          }
        }
      }
      // return
      if (want == 0) {
        if (pos + 5 < n) {
          if (SRC[pos] == 114) {
            if (SRC[pos + 1] == 101) {
              if (SRC[pos + 2] == 116) {
                if (SRC[pos + 3] == 117) {
                  if (SRC[pos + 4] == 114) {
                    if (SRC[pos + 5] == 110) { want = 2; }
                  }
                }
              }
            }
          }
        }
      }
      
      // while
      if (want == 0) {
        if (pos + 5 < n) {
          if (SRC[pos] == 119) {
            if (SRC[pos + 1] == 104) {
              if (SRC[pos + 2] == 105) {
                if (SRC[pos + 3] == 108) {
                  if (SRC[pos + 4] == 101) {
                    ch = SRC[pos + 5];
                    if (ch == 32) { want = 4; }
                    if (ch == 9) { want = 4; }
                    if (ch == 40) { want = 4; }
                  }
                }
              }
            }
          }
        }
      }
      // if
      if (want == 0) {
        if (pos + 2 < n) {
          if (SRC[pos] == 105) {
            if (SRC[pos + 1] == 102) {
              ch = SRC[pos + 2];
              if (ch == 32) { want = 5; }
              if (ch == 9) { want = 5; }
              if (ch == 40) { want = 5; }
            }
          }
        }
      }
      // assign if ident
      if (want == 0) { want = 3; }
      }

      if (want == 1) {
        pos = pos + 3;
      }
      if (want == 2) {
        pos = pos + 6;
      }
      if (want == 4) {
        pos = pos + 5;
      }
      if (want == 5) {
        pos = pos + 2;
      }

      // skip ws
      done = 0;
      while (done == 0) {
        if (pos >= n) { done = 1; }
        else {
          ch = SRC[pos];
          if (ch == 32) { pos = pos + 1; }
          else {
            if (ch == 9) { pos = pos + 1; }
            else {
              if (ch == 10) { pos = pos + 1; }
              else {
                if (ch == 13) { pos = pos + 1; }
                else { done = 1; }
              }
            }
          }
        }
      }

      slot = 0;
      if (want == 1) {
        // parse new ident → slot
        k = 0; mul = 1; i = 0; done = 0;
        while (done == 0) {
          if (pos >= n) { done = 1; }
          else {
            if (i >= 8) { done = 1; }
            else {
              ch = SRC[pos];
              cd = 0;
              if (ch >= 97) { if (ch <= 122) { cd = 1; } }
              if (ch >= 65) { if (ch <= 90) { cd = 1; } }
              if (ch == 95) { cd = 1; }
              if (i > 0) { if (ch >= 48) { if (ch <= 57) { cd = 1; } } }
              if (cd == 0) { done = 1; }
              else {
                k = k + ch * mul;
                mul = mul * 256;
                pos = pos + 1;
                i = i + 1;
              }
            }
          }
        }
        if (i == 0) { ok = 0; finished = 1; }
        else {
          found = 0; j = 0;
          while (j < kn) {
            if (KEYS[j] == k) { found = 1; slot = j; }
            j = j + 1;
          }
          if (found == 0) { slot = kn; KEYS[kn] = k; LTY[kn] = 126; kn = kn + 1; }
          dst = slot;
          done = 0;
          while (done == 0) {
            if (pos >= n) { done = 1; }
            else {
              ch = SRC[pos];
              if (ch == 32) { pos = pos + 1; }
              else {
                if (ch == 9) { pos = pos + 1; }
                else {
                  if (ch == 10) { pos = pos + 1; }
                  else {
                    if (ch == 13) { pos = pos + 1; }
                    else { done = 1; }
                  }
                }
              }
            }
          }
          if (pos >= n) { ok = 0; finished = 1; }
          else {
            if (SRC[pos] != 61) { ok = 0; finished = 1; }
            else { pos = pos + 1; }
          }
        }
      }

      if (want == 3) {
        if (ok == 1) {
          if (finished == 0) {
            k = 0; mul = 1; i = 0; done = 0;
            while (done == 0) {
              if (pos >= n) { done = 1; }
              else {
                if (i >= 8) { done = 1; }
                else {
                  ch = SRC[pos];
                  cd = 0;
                  if (ch >= 97) { if (ch <= 122) { cd = 1; } }
                  if (ch >= 65) { if (ch <= 90) { cd = 1; } }
                  if (ch == 95) { cd = 1; }
                  if (i > 0) { if (ch >= 48) { if (ch <= 57) { cd = 1; } } }
                  if (cd == 0) { done = 1; }
                  else {
                    k = k + ch * mul;
                    mul = mul * 256;
                    pos = pos + 1;
                    i = i + 1;
                  }
                }
              }
            }
            if (i == 0) { ok = 0; finished = 1; }
            else {
              found = 0; j = 0; dst = 0;
              while (j < kn) {
                if (KEYS[j] == k) { found = 1; dst = j; }
                j = j + 1;
              }
              if (found == 0) {
                // global assign e.g. OUTN =
                found = 0; j = 0; gs = 0;
                while (j < gn) {
                  if (GKEYS[j] == k) { found = 1; gs = j; }
                  j = j + 1;
                }
                if (found == 0) {
                  gs = gn; GKEYS[gn] = k; GTY[gn] = 2; gn = gn + 1;
                }
                dst = gs;
                done = 0;
                while (done == 0) {
                  if (pos >= n) { done = 1; }
                  else {
                    ch = SRC[pos];
                    if (ch == 32) { pos = pos + 1; }
                    else {
                      if (ch == 9) { pos = pos + 1; }
                      else {
                        if (ch == 10) { pos = pos + 1; }
                        else {
                          if (ch == 13) { pos = pos + 1; }
                          else { done = 1; }
                        }
                      }
                    }
                  }
                }
                if (pos >= n) { ok = 0; finished = 1; }
                else {
                  if (SRC[pos] == 91) {
                    want = 6;
                    idx_slot = dst;
                    idx_g = 1;
                    GTY[dst] = 3;
                    pos = pos + 1;
                  } else {
                    want = 8;
                    if (SRC[pos] != 61) { ok = 0; finished = 1; }
                    else { pos = pos + 1; }
                  }
                }
              } else {
                done = 0;
                while (done == 0) {
                  if (pos >= n) { done = 1; }
                  else {
                    ch = SRC[pos];
                    if (ch == 32) { pos = pos + 1; }
                    else {
                      if (ch == 9) { pos = pos + 1; }
                      else {
                        if (ch == 10) { pos = pos + 1; }
                        else {
                          if (ch == 13) { pos = pos + 1; }
                          else { done = 1; }
                        }
                      }
                    }
                  }
                }
                if (pos >= n) { ok = 0; finished = 1; }
                else {
                  if (SRC[pos] == 91) {
                    want = 6;
                    idx_slot = dst;
                    idx_g = 0;
                    pos = pos + 1;
                  } else {
                    if (SRC[pos] != 61) { ok = 0; finished = 1; }
                    else { pos = pos + 1; }
                  }
                }
              }
            }
          }
        }
      }

      // while/if: expect '(' before expr
      if (want == 4) {
        if (ok == 1) {
          if (finished == 0) {
            if (pos >= n) { ok = 0; finished = 1; }
            else {
              if (SRC[pos] != 40) { ok = 0; finished = 1; }
              else {
                pos = pos + 1;
                OPS[opsn] = 2; opsn = opsn + 1;
                OPS[opsn] = 64; opsn = opsn + 1;
                OPS[opsn] = 3; opsn = opsn + 1;
                OPS[opsn] = 64; opsn = opsn + 1;
              }
            }
          }
        }
      }
      if (want == 5) {
        if (ok == 1) {
          if (finished == 0) {
            if (pos >= n) { ok = 0; finished = 1; }
            else {
              if (SRC[pos] != 40) { ok = 0; finished = 1; }
              else { pos = pos + 1; }
            }
          }
        }
      }

      // setidx: load list then parse index
      if (want == 6) {
        if (ok == 1) {
          if (finished == 0) {
            if (idx_g == 1) {
              tnum = 2048 + idx_slot * 4;
              OPS[opsn] = 65; opsn = opsn + 1;
              i = tnum; done = 0;
              while (done == 0) {
                ch = i % 128; i = i / 128;
                if (i == 0) { OPS[opsn] = ch; opsn = opsn + 1; done = 1; }
                else { OPS[opsn] = ch + 128; opsn = opsn + 1; }
              }
              OPS[opsn] = 40; opsn = opsn + 1;
              OPS[opsn] = 2; opsn = opsn + 1;
              OPS[opsn] = 0; opsn = opsn + 1;
            } else {
              OPS[opsn] = 32; opsn = opsn + 1;
              OPS[opsn] = idx_slot; opsn = opsn + 1;
            }
          }
        }
      }

      // parse expression → OPS (want 1/2/3/4/5/6/8)
      if (ok == 1) {
        if (finished == 0) {
          bsp = 0;
          ST[0] = 1;
          SPR[0] = 0;
          bsp = 1;
          while (bsp > 0) {
            if (ok != 1) { bsp = 0; }
            else {
              st = ST[bsp - 1];
              if (st == 1) {
                // primary
                done = 0;
                while (done == 0) {
                  if (pos >= n) { done = 1; }
                  else {
                    ch = SRC[pos];
                    if (ch == 32) { pos = pos + 1; }
                    else {
                      if (ch == 9) { pos = pos + 1; }
                      else {
                        if (ch == 10) { pos = pos + 1; }
                        else {
                          if (ch == 13) { pos = pos + 1; }
                          else { done = 1; }
                        }
                      }
                    }
                  }
                }
                if (pos >= n) { ok = 0; bsp = 0; }
                else {
                  if (SRC[pos] == 40) {
                    pos = pos + 1;
                    ST[bsp - 1] = 3;
                    ST[bsp] = 1;
                    SPR[bsp] = 0;
                    bsp = bsp + 1;
                  } else {
                    found = 0;
                    if (pos + 4 < n) {
                      if (SRC[pos] == 108) {
                        if (SRC[pos + 1] == 105) {
                          if (SRC[pos + 2] == 115) {
                            if (SRC[pos + 3] == 116) {
                              if (SRC[pos + 4] == 40) { found = 10; }
                            }
                          }
                        }
                      }
                    }
                    if (found == 0) {
                      if (pos + 3 < n) {
                        if (SRC[pos] == 108) {
                          if (SRC[pos + 1] == 101) {
                            if (SRC[pos + 2] == 110) {
                              if (SRC[pos + 3] == 40) { found = 11; }
                            }
                          }
                        }
                      }
                    }
                    if (found == 10) {
                      pos = pos + 5;
                      ST[bsp - 1] = 5;
                      ST[bsp] = 1; SPR[bsp] = 0; bsp = bsp + 1;
                    } else {
                    if (found == 11) {
                      pos = pos + 4;
                      ST[bsp - 1] = 6;
                      ST[bsp] = 1; SPR[bsp] = 0; bsp = bsp + 1;
                    } else {
                    if (SRC[pos] == 123) {
                      // dict { k: v, ... }
                      pos = pos + 1;
                      done = 0;
                      while (done == 0) {
                        if (pos >= n) { done = 1; }
                        else {
                          ch = SRC[pos];
                          if (ch == 32) { pos = pos + 1; }
                          else {
                            if (ch == 9) { pos = pos + 1; }
                            else {
                              if (ch == 10) { pos = pos + 1; }
                              else {
                                if (ch == 13) { pos = pos + 1; }
                                else { done = 1; }
                              }
                            }
                          }
                        }
                      }
                      if (pos >= n) { ok = 0; bsp = 0; }
                      else {
                        if (SRC[pos] == 125) {
                          pos = pos + 1;
                          if (dsc < 0) {
                            dsc = kn; KEYS[kn] = 0; LTY[kn] = 127; kn = kn + 1;
                          }
                          OPS[opsn] = 65; opsn = opsn + 1;
                          OPS[opsn] = 0; opsn = opsn + 1;
                          OPS[opsn] = 16; opsn = opsn + 1;
                          OPS[opsn] = 12; opsn = opsn + 1;
                          ety = 3; elem_f = 0;
                          ST[bsp - 1] = 2;
                        } else {
                          dsave = pos;
                          dpn = 1; dpi = 0; cd = 0;
                          while (cd == 0) {
                            if (pos >= n) { cd = 1; ok = 0; }
                            else {
                              ch = SRC[pos];
                              if (ch == 123) { dpi = dpi + 1; pos = pos + 1; }
                              else {
                                if (ch == 91) { dpi = dpi + 1; pos = pos + 1; }
                                else {
                                  if (ch == 125) {
                                    if (dpi == 0) { cd = 1; }
                                    else { dpi = dpi - 1; pos = pos + 1; }
                                  } else {
                                    if (ch == 93) {
                                      if (dpi > 0) { dpi = dpi - 1; }
                                      pos = pos + 1;
                                    } else {
                                      if (ch == 44) {
                                        if (dpi == 0) { dpn = dpn + 1; }
                                        pos = pos + 1;
                                      } else { pos = pos + 1; }
                                    }
                                  }
                                }
                              }
                            }
                          }
                          if (ok != 1) { bsp = 0; }
                          else {
                            pos = dsave;
                            if (dsc < 0) {
                              dsc = kn; KEYS[kn] = 0; LTY[kn] = 127; kn = kn + 1;
                            }
                            OPS[opsn] = 65; opsn = opsn + 1;
                            i = dpn; done = 0;
                            while (done == 0) {
                              ch = i % 128; i = i / 128;
                              if (i == 0) { OPS[opsn] = ch; opsn = opsn + 1; done = 1; }
                              else { OPS[opsn] = ch + 128; opsn = opsn + 1; }
                            }
                            OPS[opsn] = 16; opsn = opsn + 1;
                            OPS[opsn] = 12; opsn = opsn + 1;
                            OPS[opsn] = 33; opsn = opsn + 1;
                            OPS[opsn] = dsc; opsn = opsn + 1;
                            dpi = 0;
                            ST[bsp - 1] = 13;
                            SPR[bsp - 1] = dpn;
                          }
                        }
                      }
                    } else {
                    ch = SRC[pos];
                    cd = 0;
                    fneg = 0;
                    if (ch == 45) {
                      if (pos + 1 < n) {
                        j = SRC[pos + 1];
                        if (j >= 48) {
                          if (j <= 57) {
                            fneg = 1;
                            pos = pos + 1;
                            ch = SRC[pos];
                          }
                        }
                      }
                    }
                    if (ch >= 48) { if (ch <= 57) { cd = 1; } }
                    if (cd == 1) {
                        tnum = 0; done = 0;
                        while (done == 0) {
                          if (pos >= n) { done = 1; }
                          else {
                            ch = SRC[pos];
                            if (ch < 48) { done = 1; }
                            else {
                              if (ch > 57) { done = 1; }
                              else {
                                tnum = tnum * 10 + (ch - 48);
                                pos = pos + 1;
                              }
                            }
                          }
                        }
                        fl = 0; fden = 1;
                        if (pos < n) {
                          if (SRC[pos] == 46) {
                            fl = 1;
                            pos = pos + 1;
                            done = 0;
                            while (done == 0) {
                              if (pos >= n) { done = 1; }
                              else {
                                ch = SRC[pos];
                                if (ch < 48) { done = 1; }
                                else {
                                  if (ch > 57) { done = 1; }
                                  else {
                                    tnum = tnum * 10 + (ch - 48);
                                    fden = fden * 10;
                                    pos = pos + 1;
                                  }
                                }
                              }
                            }
                          }
                        }
                        if (fl == 1) {
                          i = tnum; j = fden; fexp = 0;
                          if (i == 0) { fbits = 0; }
                          else {
                            while (i < j) { i = i * 2; fexp = fexp - 1; }
                            while (i >= j * 2) { j = j * 2; fexp = fexp + 1; }
                            mul = (i - j) * TWO52;
                            fbits = mul / j;
                            k = mul - fbits * j;
                            if (k * 2 > j) { fbits = fbits + 1; }
                            else {
                              if (k * 2 == j) {
                                if (fbits - (fbits / 2) * 2 == 1) { fbits = fbits + 1; }
                              }
                            }
                            if (fbits == TWO52) { fbits = 0; fexp = fexp + 1; }
                            fbits = (fexp + 1023) * TWO52 + fbits;
                          }
                          OPS[opsn] = 68; opsn = opsn + 1;
                          i = 0;
                          while (i < 8) {
                            k = fbits / 256;
                            OPS[opsn] = fbits - k * 256;
                            fbits = k;
                            opsn = opsn + 1;
                            i = i + 1;
                          }
                          if (fneg == 1) {
                            OPS[opsn] = 154; opsn = opsn + 1;
                          }
                          ety = 2; elem_f = 0;
                          ST[bsp - 1] = 2;
                        } else {
                          OPS[opsn] = 66; opsn = opsn + 1;
                          i = tnum; done = 0;
                          while (done == 0) {
                            ch = i % 128;
                            i = i / 128;
                            if (i == 0) {
                              if (ch > 63) {
                                OPS[opsn] = ch + 128; opsn = opsn + 1;
                                OPS[opsn] = 0; opsn = opsn + 1;
                              } else {
                                OPS[opsn] = ch; opsn = opsn + 1;
                              }
                              done = 1;
                            } else {
                              OPS[opsn] = ch + 128; opsn = opsn + 1;
                            }
                          }
                          if (fneg == 1) {
                            OPS[opsn] = 66; opsn = opsn + 1;
                            OPS[opsn] = 127; opsn = opsn + 1;
                            OPS[opsn] = 126; opsn = opsn + 1;
                          }
                          ety = 1;
                          elem_f = 0;
                          ST[bsp - 1] = 2;
                        }
                    } else {
                      k = 0; mul = 1; i = 0; done = 0;
                      while (done == 0) {
                        if (pos >= n) { done = 1; }
                        else {
                          if (i >= 8) { done = 1; }
                          else {
                            ch = SRC[pos];
                            cd = 0;
                            if (ch >= 97) { if (ch <= 122) { cd = 1; } }
                            if (ch >= 65) { if (ch <= 90) { cd = 1; } }
                            if (ch == 95) { cd = 1; }
                            if (i > 0) { if (ch >= 48) { if (ch <= 57) { cd = 1; } } }
                            if (cd == 0) { done = 1; }
                            else {
                              k = k + ch * mul;
                              mul = mul * 256;
                              pos = pos + 1;
                              i = i + 1;
                            }
                          }
                        }
                      }
                      if (i == 0) { ok = 0; bsp = 0; }
                      else {
                        found = 0; j = 0; lx = 0;
                        while (j < kn) {
                          if (KEYS[j] == k) { found = 1; lx = j; }
                          j = j + 1;
                        }
                        if (found == 1) {
                          OPS[opsn] = 32; opsn = opsn + 1;
                          OPS[opsn] = lx; opsn = opsn + 1;
                          if (LTY[lx] == 127) { ety = 3; elem_f = 0; }
                          else {
                            if (LTY[lx] == 124) { ety = 2; elem_f = 0; }
                            else { ety = 1; elem_f = 0; }
                          }
                          ST[bsp - 1] = 2;
                        } else {
                          found = 0; j = 0; gs = 0;
                          while (j < gn) {
                            if (GKEYS[j] == k) { found = 1; gs = j; }
                            j = j + 1;
                          }
                          if (found == 0) {
                            gs = gn; GKEYS[gn] = k; GTY[gn] = 2; gn = gn + 1;
                          }
                          // promote to list: xs[i] or len(xs)
                          done = 0;
                          while (done == 0) {
                            if (pos >= n) { done = 1; }
                            else {
                              ch = SRC[pos];
                              if (ch == 32) { pos = pos + 1; }
                              else {
                                if (ch == 9) { pos = pos + 1; }
                                else {
                                  if (ch == 10) { pos = pos + 1; }
                                  else {
                                    if (ch == 13) { pos = pos + 1; }
                                    else { done = 1; }
                                  }
                                }
                              }
                            }
                          }
                          if (pos < n) {
                            if (SRC[pos] == 91) { GTY[gs] = 3; }
                          }
                          if (bsp > 1) {
                            if (ST[bsp - 2] == 6) { GTY[gs] = 3; }
                          }
                          tnum = 2048 + gs * 4;
                          OPS[opsn] = 65; opsn = opsn + 1;
                          i = tnum; done = 0;
                          while (done == 0) {
                            ch = i % 128; i = i / 128;
                            if (i == 0) { OPS[opsn] = ch; opsn = opsn + 1; done = 1; }
                            else { OPS[opsn] = ch + 128; opsn = opsn + 1; }
                          }
                          OPS[opsn] = 40; opsn = opsn + 1;
                          OPS[opsn] = 2; opsn = opsn + 1;
                          OPS[opsn] = 0; opsn = opsn + 1;
                          if (GTY[gs] == 3) {
                            ety = 3; elem_f = 1;
                          } else {
                            if (GTY[gs] == 1) {
                              OPS[opsn] = 16; opsn = opsn + 1;
                              OPS[opsn] = 3; opsn = opsn + 1;
                              ety = 1; elem_f = 0;
                            } else {
                              OPS[opsn] = 16; opsn = opsn + 1;
                              OPS[opsn] = 5; opsn = opsn + 1;
                              ety = 2; elem_f = 0;
                            }
                          }
                          ST[bsp - 1] = 2;
                        }
                      }
                    }
                    }
                    }
                    }
                  }
                }
              } else {
                if (st == 3) {
                  // expect )
                  done = 0;
                  while (done == 0) {
                    if (pos >= n) { done = 1; }
                    else {
                      ch = SRC[pos];
                      if (ch == 32) { pos = pos + 1; }
                      else {
                        if (ch == 9) { pos = pos + 1; }
                        else {
                          if (ch == 10) { pos = pos + 1; }
                          else {
                            if (ch == 13) { pos = pos + 1; }
                            else { done = 1; }
                          }
                        }
                      }
                    }
                  }
                  if (pos >= n) { ok = 0; bsp = 0; }
                  else {
                    if (SRC[pos] != 41) { ok = 0; bsp = 0; }
                    else {
                      pos = pos + 1;
                      ST[bsp - 1] = 2;
                    }
                  }
                } else {
                  if (st == 2) {
                    // binop or index or done
                    done = 0;
                    while (done == 0) {
                      if (pos >= n) { done = 1; }
                      else {
                        ch = SRC[pos];
                        if (ch == 32) { pos = pos + 1; }
                        else {
                          if (ch == 9) { pos = pos + 1; }
                          else {
                            if (ch == 10) { pos = pos + 1; }
                            else {
                              if (ch == 13) { pos = pos + 1; }
                              else { done = 1; }
                            }
                          }
                        }
                      }
                    }
                    if (pos < n) {
                      if (SRC[pos] == 91) {
                        if (ety == 3) {
                          pos = pos + 1;
                          SOP[bsp - 1] = elem_f;
                          ST[bsp - 1] = 7;
                          ST[bsp] = 1; SPR[bsp] = 0; bsp = bsp + 1;
                          op = 99;
                        }
                      }
                    }
                    if (op == 99) {
                      op = 0;
                    } else {
                    op = 0; prec = 0;
                    if (pos < n) {
                      ch = SRC[pos];
                      if (ch == 42) { op = 126; prec = 20; }
                      if (ch == 47) { op = 127; prec = 20; }
                      if (ch == 37) { op = 129; prec = 20; }
                      if (ch == 43) { op = 124; prec = 10; }
                      if (ch == 45) { op = 125; prec = 10; }
                      if (ch == 60) {
                        if (pos + 1 < n) {
                          if (SRC[pos + 1] == 61) { op = 87; prec = 5; }
                          else { op = 83; prec = 5; }
                        } else { op = 83; prec = 5; }
                      }
                      if (ch == 62) {
                        if (pos + 1 < n) {
                          if (SRC[pos + 1] == 61) { op = 89; prec = 5; }
                          else { op = 85; prec = 5; }
                        } else { op = 85; prec = 5; }
                      }
                      if (ch == 61) {
                        if (pos + 1 < n) {
                          if (SRC[pos + 1] == 61) { op = 81; prec = 5; }
                        }
                      }
                      if (ch == 33) {
                        if (pos + 1 < n) {
                          if (SRC[pos + 1] == 61) { op = 82; prec = 5; }
                        }
                      }
                    }
                    if (op == 0) {
                      bsp = bsp - 1;
                    } else {
                      if (prec < SPR[bsp - 1]) {
                        bsp = bsp - 1;
                      } else {
                        if (op == 87) { pos = pos + 2; }
                        else {
                          if (op == 89) { pos = pos + 2; }
                          else {
                            if (op == 81) {
                              pos = pos + 2;
                              // ===
                              if (pos < n) {
                                if (SRC[pos] == 61) { pos = pos + 1; }
                              }
                            } else {
                              if (op == 82) { pos = pos + 2; }
                              else { pos = pos + 1; }
                            }
                          }
                        }
                        ST[bsp - 1] = 4;
                        fl = 0;
                        if (elem_f == 1) { fl = 1; }
                        else {
                          if (ety == 2) { fl = 1; }
                        }
                        SOP[bsp - 1] = op + fl * 256;
                        ST[bsp] = 1;
                        SPR[bsp] = prec + 1;
                        bsp = bsp + 1;
                      }
                    }
                    }
                  } else {
                    if (st == 4) {
                      op = SOP[bsp - 1];
                      lx = op / 256;
                      op = op - lx * 256;
                      fl = 0;
                      if (ety == 2) { fl = 1; }
                      if (elem_f == 1) { fl = 1; }
                      cd = 0;
                      if (op >= 81) {
                        if (op <= 89) { cd = 1; }
                      }
                      if (cd == 1) {
                        // compare
                        if (lx == 1) {
                          if (fl == 0) {
                            if (ety == 1) { OPS[opsn] = 185; opsn = opsn + 1; }
                          }
                          if (op == 81) { OPS[opsn] = 97; opsn = opsn + 1; }
                          else {
                            if (op == 82) { OPS[opsn] = 98; opsn = opsn + 1; }
                            else {
                              if (op == 83) { OPS[opsn] = 99; opsn = opsn + 1; }
                              else {
                                if (op == 85) { OPS[opsn] = 100; opsn = opsn + 1; }
                                else {
                                  if (op == 87) { OPS[opsn] = 101; opsn = opsn + 1; }
                                  else {
                                    if (op == 89) { OPS[opsn] = 102; opsn = opsn + 1; }
                                    else { OPS[opsn] = op; opsn = opsn + 1; }
                                  }
                                }
                              }
                            }
                          }
                          OPS[opsn] = 173; opsn = opsn + 1;
                        } else {
                          if (fl == 1) {
                            if (fsc < 0) {
                              fsc = kn; KEYS[kn] = 0; LTY[kn] = 124; kn = kn + 1;
                            }
                            OPS[opsn] = 33; opsn = opsn + 1;
                            OPS[opsn] = fsc; opsn = opsn + 1;
                            OPS[opsn] = 185; opsn = opsn + 1;
                            OPS[opsn] = 32; opsn = opsn + 1;
                            OPS[opsn] = fsc; opsn = opsn + 1;
                            if (op == 81) { OPS[opsn] = 97; opsn = opsn + 1; }
                            else {
                              if (op == 82) { OPS[opsn] = 98; opsn = opsn + 1; }
                              else {
                                if (op == 83) { OPS[opsn] = 99; opsn = opsn + 1; }
                                else {
                                  if (op == 85) { OPS[opsn] = 100; opsn = opsn + 1; }
                                  else {
                                    if (op == 87) { OPS[opsn] = 101; opsn = opsn + 1; }
                                    else {
                                      if (op == 89) { OPS[opsn] = 102; opsn = opsn + 1; }
                                      else { OPS[opsn] = op; opsn = opsn + 1; }
                                    }
                                  }
                                }
                              }
                            }
                            OPS[opsn] = 173; opsn = opsn + 1;
                          } else {
                            OPS[opsn] = op; opsn = opsn + 1;
                            OPS[opsn] = 173; opsn = opsn + 1;
                          }
                        }
                        ety = 1;
                        elem_f = 0;
                      } else {
                        // arith
                        if (lx == 1) {
                          if (fl == 0) {
                            if (ety == 1) { OPS[opsn] = 185; opsn = opsn + 1; }
                          }
                          if (op == 124) { OPS[opsn] = 160; opsn = opsn + 1; }
                          else {
                            if (op == 125) { OPS[opsn] = 161; opsn = opsn + 1; }
                            else {
                              if (op == 126) { OPS[opsn] = 162; opsn = opsn + 1; }
                              else {
                                if (op == 127) { OPS[opsn] = 163; opsn = opsn + 1; }
                                else { OPS[opsn] = op; opsn = opsn + 1; }
                              }
                            }
                          }
                          ety = 2; elem_f = 0;
                        } else {
                          if (fl == 1) {
                            if (fsc < 0) {
                              fsc = kn; KEYS[kn] = 0; LTY[kn] = 124; kn = kn + 1;
                            }
                            OPS[opsn] = 33; opsn = opsn + 1;
                            OPS[opsn] = fsc; opsn = opsn + 1;
                            OPS[opsn] = 185; opsn = opsn + 1;
                            OPS[opsn] = 32; opsn = opsn + 1;
                            OPS[opsn] = fsc; opsn = opsn + 1;
                            if (op == 124) { OPS[opsn] = 160; opsn = opsn + 1; }
                            else {
                              if (op == 125) { OPS[opsn] = 161; opsn = opsn + 1; }
                              else {
                                if (op == 126) { OPS[opsn] = 162; opsn = opsn + 1; }
                                else {
                                  if (op == 127) { OPS[opsn] = 163; opsn = opsn + 1; }
                                  else { OPS[opsn] = op; opsn = opsn + 1; }
                                }
                              }
                            }
                            ety = 2; elem_f = 0;
                          } else {
                            OPS[opsn] = op; opsn = opsn + 1;
                          }
                        }
                      }
                      ST[bsp - 1] = 2;
                    } else {
                      if (st == 5) {
                        // after list(expr) expect )
                        done = 0;
                        while (done == 0) {
                          if (pos >= n) { done = 1; }
                          else {
                            ch = SRC[pos];
                            if (ch == 32) { pos = pos + 1; }
                            else {
                              if (ch == 9) { pos = pos + 1; }
                              else {
                                if (ch == 10) { pos = pos + 1; }
                                else {
                                  if (ch == 13) { pos = pos + 1; }
                                  else { done = 1; }
                                }
                              }
                            }
                          }
                        }
                        if (pos >= n) { ok = 0; bsp = 0; }
                        else {
                          if (SRC[pos] != 41) { ok = 0; bsp = 0; }
                          else {
                            pos = pos + 1;
                            OPS[opsn] = 167; opsn = opsn + 1;
                            OPS[opsn] = 16; opsn = opsn + 1;
                            OPS[opsn] = 6; opsn = opsn + 1;
                            ety = 3;
                            ST[bsp - 1] = 2;
                          }
                        }
                      } else {
                        if (st == 6) {
                          done = 0;
                          while (done == 0) {
                            if (pos >= n) { done = 1; }
                            else {
                              ch = SRC[pos];
                              if (ch == 32) { pos = pos + 1; }
                              else {
                                if (ch == 9) { pos = pos + 1; }
                                else {
                                  if (ch == 10) { pos = pos + 1; }
                                  else {
                                    if (ch == 13) { pos = pos + 1; }
                                    else { done = 1; }
                                  }
                                }
                              }
                            }
                          }
                          if (pos >= n) { ok = 0; bsp = 0; }
                          else {
                            if (SRC[pos] != 41) { ok = 0; bsp = 0; }
                            else {
                              pos = pos + 1;
                              OPS[opsn] = 16; opsn = opsn + 1;
                              OPS[opsn] = 10; opsn = opsn + 1;
                              OPS[opsn] = 173; opsn = opsn + 1;
                              ety = 1;
                              elem_f = 0;
                              ST[bsp - 1] = 2;
                            }
                          }
                        } else {
                          if (st == 7) {
                            // after list[index] expect ]
                            done = 0;
                            while (done == 0) {
                              if (pos >= n) { done = 1; }
                              else {
                                ch = SRC[pos];
                                if (ch == 32) { pos = pos + 1; }
                                else {
                                  if (ch == 9) { pos = pos + 1; }
                                  else {
                                    if (ch == 10) { pos = pos + 1; }
                                    else {
                                      if (ch == 13) { pos = pos + 1; }
                                      else { done = 1; }
                                    }
                                  }
                                }
                              }
                            }
                            if (pos >= n) { ok = 0; bsp = 0; }
                            else {
                              if (SRC[pos] != 93) { ok = 0; bsp = 0; }
                              else {
                                pos = pos + 1;
                                OPS[opsn] = 167; opsn = opsn + 1;
                                OPS[opsn] = 16; opsn = opsn + 1;
                                OPS[opsn] = 7; opsn = opsn + 1;
                                OPS[opsn] = 16; opsn = opsn + 1;
                                elem_f = SOP[bsp - 1];
                                if (elem_f == 1) {
                                  OPS[opsn] = 5; opsn = opsn + 1;
                                  ety = 3;
                                } else {
                                  OPS[opsn] = 3; opsn = opsn + 1;
                                  ety = 1;
                                }
                                ST[bsp - 1] = 2;
                              }
                            }
                          } else {
                            if (st == 13) {
                              // dict pair: key : value
                              done = 0;
                              while (done == 0) {
                                if (pos >= n) { done = 1; }
                                else {
                                  ch = SRC[pos];
                                  if (ch == 32) { pos = pos + 1; }
                                  else {
                                    if (ch == 9) { pos = pos + 1; }
                                    else {
                                      if (ch == 10) { pos = pos + 1; }
                                      else {
                                        if (ch == 13) { pos = pos + 1; }
                                        else { done = 1; }
                                      }
                                    }
                                  }
                                }
                              }
                              dkn = 0;
                              done = 0;
                              while (done == 0) {
                                if (pos >= n) { done = 1; }
                                else {
                                  if (dkn >= 8) { done = 1; }
                                  else {
                                    ch = SRC[pos]; cd = 0;
                                    if (ch >= 97) { if (ch <= 122) { cd = 1; } }
                                    if (ch >= 65) { if (ch <= 90) { cd = 1; } }
                                    if (ch == 95) { cd = 1; }
                                    if (dkn > 0) { if (ch >= 48) { if (ch <= 57) { cd = 1; } } }
                                    if (cd == 0) { done = 1; }
                                    else {
                                      DKEY[dkn] = ch;
                                      dkn = dkn + 1;
                                      pos = pos + 1;
                                    }
                                  }
                                }
                              }
                              if (dkn == 0) { ok = 0; bsp = 0; }
                              else {
                                OPS[opsn] = 32; opsn = opsn + 1;
                                OPS[opsn] = dsc; opsn = opsn + 1;
                                i = 0;
                                while (i < dkn) {
                                  OPS[opsn] = 65; opsn = opsn + 1;
                                  j = 1024 + i; done = 0;
                                  while (done == 0) {
                                    ch = j % 128; j = j / 128;
                                    if (j == 0) { OPS[opsn] = ch; opsn = opsn + 1; done = 1; }
                                    else { OPS[opsn] = ch + 128; opsn = opsn + 1; }
                                  }
                                  OPS[opsn] = 65; opsn = opsn + 1;
                                  k = DKEY[i];
                                  if (k > 63) {
                                    OPS[opsn] = k + 128; opsn = opsn + 1;
                                    OPS[opsn] = 0; opsn = opsn + 1;
                                  } else {
                                    OPS[opsn] = k; opsn = opsn + 1;
                                  }
                                  OPS[opsn] = 58; opsn = opsn + 1;
                                  OPS[opsn] = 0; opsn = opsn + 1;
                                  OPS[opsn] = 0; opsn = opsn + 1;
                                  i = i + 1;
                                }
                                OPS[opsn] = 65; opsn = opsn + 1;
                                OPS[opsn] = 128; opsn = opsn + 1;
                                OPS[opsn] = 8; opsn = opsn + 1;
                                OPS[opsn] = 65; opsn = opsn + 1;
                                OPS[opsn] = dkn; opsn = opsn + 1;
                                OPS[opsn] = 16; opsn = opsn + 1;
                                OPS[opsn] = 11; opsn = opsn + 1;
                                done = 0;
                                while (done == 0) {
                                  if (pos >= n) { done = 1; }
                                  else {
                                    ch = SRC[pos];
                                    if (ch == 32) { pos = pos + 1; }
                                    else {
                                      if (ch == 9) { pos = pos + 1; }
                                      else {
                                        if (ch == 10) { pos = pos + 1; }
                                        else {
                                          if (ch == 13) { pos = pos + 1; }
                                          else { done = 1; }
                                        }
                                      }
                                    }
                                  }
                                }
                                if (pos >= n) { ok = 0; bsp = 0; }
                                else {
                                  if (SRC[pos] != 58) { ok = 0; bsp = 0; }
                                  else {
                                    pos = pos + 1;
                                    // stack: dict, key — parse value under st=14
                                    ST[bsp - 1] = 14;
                                    SOP[bsp - 1] = dpi;
                                    ST[bsp] = 1; SPR[bsp] = 0; bsp = bsp + 1;
                                  }
                                }
                              }
                            } else {
                              if (st == 14) {
                                // after dict value
                                if (ety == 1) {
                                  OPS[opsn] = 16; opsn = opsn + 1;
                                  OPS[opsn] = 0; opsn = opsn + 1;
                                } else {
                                  if (ety == 2) {
                                    OPS[opsn] = 16; opsn = opsn + 1;
                                    OPS[opsn] = 4; opsn = opsn + 1;
                                  }
                                }
                                OPS[opsn] = 65; opsn = opsn + 1;
                                OPS[opsn] = SOP[bsp - 1]; opsn = opsn + 1;
                                OPS[opsn] = 16; opsn = opsn + 1;
                                OPS[opsn] = 16; opsn = opsn + 1;
                                dpi = SOP[bsp - 1] + 1;
                                dpn = SPR[bsp - 1];
                                if (dpi < dpn) {
                                  done = 0;
                                  while (done == 0) {
                                    if (pos >= n) { done = 1; }
                                    else {
                                      ch = SRC[pos];
                                      if (ch == 32) { pos = pos + 1; }
                                      else {
                                        if (ch == 9) { pos = pos + 1; }
                                        else {
                                          if (ch == 10) { pos = pos + 1; }
                                          else {
                                            if (ch == 13) { pos = pos + 1; }
                                            else { done = 1; }
                                          }
                                        }
                                      }
                                    }
                                  }
                                  if (pos >= n) { ok = 0; bsp = 0; }
                                  else {
                                    if (SRC[pos] != 44) { ok = 0; bsp = 0; }
                                    else {
                                      pos = pos + 1;
                                      ST[bsp - 1] = 13;
                                      SPR[bsp - 1] = dpn;
                                    }
                                  }
                                } else {
                                  done = 0;
                                  while (done == 0) {
                                    if (pos >= n) { done = 1; }
                                    else {
                                      ch = SRC[pos];
                                      if (ch == 32) { pos = pos + 1; }
                                      else {
                                        if (ch == 9) { pos = pos + 1; }
                                        else {
                                          if (ch == 10) { pos = pos + 1; }
                                          else {
                                            if (ch == 13) { pos = pos + 1; }
                                            else { done = 1; }
                                          }
                                        }
                                      }
                                    }
                                  }
                                  if (pos >= n) { ok = 0; bsp = 0; }
                                  else {
                                    if (SRC[pos] != 125) { ok = 0; bsp = 0; }
                                    else {
                                      pos = pos + 1;
                                      OPS[opsn] = 32; opsn = opsn + 1;
                                      OPS[opsn] = dsc; opsn = opsn + 1;
                                      ety = 3; elem_f = 0;
                                      ST[bsp - 1] = 2;
                                    }
                                  }
                                }
                              } else {
                                ok = 0; bsp = 0;
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }

      // setidx: after index expr → ] = value
      if (want == 6) {
        if (ok == 1) {
          if (finished == 0) {
            done = 0;
            while (done == 0) {
              if (pos >= n) { done = 1; }
              else {
                ch = SRC[pos];
                if (ch == 32) { pos = pos + 1; }
                else {
                  if (ch == 9) { pos = pos + 1; }
                  else {
                    if (ch == 10) { pos = pos + 1; }
                    else {
                      if (ch == 13) { pos = pos + 1; }
                      else { done = 1; }
                    }
                  }
                }
              }
            }
            if (pos >= n) { ok = 0; finished = 1; }
            else {
              if (SRC[pos] != 93) { ok = 0; finished = 1; }
              else {
                pos = pos + 1;
                done = 0;
                while (done == 0) {
                  if (pos >= n) { done = 1; }
                  else {
                    ch = SRC[pos];
                    if (ch == 32) { pos = pos + 1; }
                    else {
                      if (ch == 9) { pos = pos + 1; }
                      else {
                        if (ch == 10) { pos = pos + 1; }
                        else {
                          if (ch == 13) { pos = pos + 1; }
                          else { done = 1; }
                        }
                      }
                    }
                  }
                }
                if (pos >= n) { ok = 0; finished = 1; }
                else {
                  if (SRC[pos] != 61) { ok = 0; finished = 1; }
                  else {
                    pos = pos + 1;
                    OPS[opsn] = 167; opsn = opsn + 1;
                    // defer value to want=7 (full expr: f64, %, (), global index)
                    iphase = 1;
                  }
                }
              }
            }
          }
        }
      }

      // finish stmt
      if (ok == 1) {
        if (finished == 0) {
          if (iphase == 1) {
            // value deferred to next iter (want=7)
          } else {
          if (want == 1) {
            if (elem_f == 1) {
              if (LTY[dst] == 126) {
                OPS[opsn] = 176; opsn = opsn + 1;
              }
              LTY[dst] = 126;
              elem_f = 0;
            } else {
              if (ety == 3) { LTY[dst] = 127; }
              else {
                if (ety == 2) { LTY[dst] = 124; }
                else { LTY[dst] = 126; }
              }
            }
            OPS[opsn] = 33; opsn = opsn + 1;
            OPS[opsn] = dst; opsn = opsn + 1;
          }
          if (want == 3) {
            if (elem_f == 1) {
              if (LTY[dst] == 126) {
                OPS[opsn] = 176; opsn = opsn + 1;
              }
              elem_f = 0;
            } else {
              if (ety == 2) {
                if (LTY[dst] == 126) {
                  // f64 into i64 local — trunc
                  OPS[opsn] = 176; opsn = opsn + 1;
                } else {
                  LTY[dst] = 124;
                }
              }
            }
            OPS[opsn] = 33; opsn = opsn + 1;
            OPS[opsn] = dst; opsn = opsn + 1;
          }
          if (want == 8) {
            // GSTORE
            if (ety == 2) {
              OPS[opsn] = 16; opsn = opsn + 1;
              OPS[opsn] = 4; opsn = opsn + 1;
            } else {
              OPS[opsn] = 16; opsn = opsn + 1;
              OPS[opsn] = 0; opsn = opsn + 1;
            }
            OPS[opsn] = 65; opsn = opsn + 1;
            OPS[opsn] = dst; opsn = opsn + 1;
            OPS[opsn] = 16; opsn = opsn + 1;
            OPS[opsn] = 15; opsn = opsn + 1;
            if (ety == 2) { GTY[dst] = 2; }
            else { GTY[dst] = 1; }
          }
          if (want == 2) {
            if (ety == 3) {
              OPS[opsn] = 15; opsn = opsn + 1;
            } else {
              if (ety == 2) {
                OPS[opsn] = 16; opsn = opsn + 1;
                OPS[opsn] = 4; opsn = opsn + 1;
                OPS[opsn] = 15; opsn = opsn + 1;
              } else {
                OPS[opsn] = 16; opsn = opsn + 1;
                OPS[opsn] = 0; opsn = opsn + 1;
                OPS[opsn] = 15; opsn = opsn + 1;
              }
            }
          }
          if (want == 4) {
            OPS[opsn] = 167; opsn = opsn + 1;
            OPS[opsn] = 69; opsn = opsn + 1;
            OPS[opsn] = 13; opsn = opsn + 1;
            OPS[opsn] = 1; opsn = opsn + 1;
          }
          if (want == 5) {
            OPS[opsn] = 167; opsn = opsn + 1;
            OPS[opsn] = 4; opsn = opsn + 1;
            OPS[opsn] = 64; opsn = opsn + 1;
          }
          if (want == 4) {
            done = 0;
            while (done == 0) {
              if (pos >= n) { done = 1; }
              else {
                ch = SRC[pos];
                if (ch == 32) { pos = pos + 1; }
                else {
                  if (ch == 9) { pos = pos + 1; }
                  else {
                    if (ch == 10) { pos = pos + 1; }
                    else {
                      if (ch == 13) { pos = pos + 1; }
                      else { done = 1; }
                    }
                  }
                }
              }
            }
            if (pos >= n) { ok = 0; finished = 1; }
            else {
              if (SRC[pos] != 41) { ok = 0; finished = 1; }
              else {
                pos = pos + 1;
                done = 0;
                while (done == 0) {
                  if (pos >= n) { done = 1; }
                  else {
                    ch = SRC[pos];
                    if (ch == 32) { pos = pos + 1; }
                    else {
                      if (ch == 9) { pos = pos + 1; }
                      else {
                        if (ch == 10) { pos = pos + 1; }
                        else {
                          if (ch == 13) { pos = pos + 1; }
                          else { done = 1; }
                        }
                      }
                    }
                  }
                }
                if (pos >= n) { ok = 0; finished = 1; }
                else {
                  if (SRC[pos] != 123) { ok = 0; finished = 1; }
                  else {
                    pos = pos + 1;
                    CST[csp] = 1; csp = csp + 1;
                    depth = depth + 1;
                  }
                }
              }
            }
          } else {
            if (want == 5) {
              done = 0;
              while (done == 0) {
                if (pos >= n) { done = 1; }
                else {
                  ch = SRC[pos];
                  if (ch == 32) { pos = pos + 1; }
                  else {
                    if (ch == 9) { pos = pos + 1; }
                    else {
                      if (ch == 10) { pos = pos + 1; }
                      else {
                        if (ch == 13) { pos = pos + 1; }
                        else { done = 1; }
                      }
                    }
                  }
                }
              }
              if (pos >= n) { ok = 0; finished = 1; }
              else {
                if (SRC[pos] != 41) { ok = 0; finished = 1; }
                else {
                  pos = pos + 1;
                  done = 0;
                  while (done == 0) {
                    if (pos >= n) { done = 1; }
                    else {
                      ch = SRC[pos];
                      if (ch == 32) { pos = pos + 1; }
                      else {
                        if (ch == 9) { pos = pos + 1; }
                        else {
                          if (ch == 10) { pos = pos + 1; }
                          else {
                            if (ch == 13) { pos = pos + 1; }
                            else { done = 1; }
                          }
                        }
                      }
                    }
                  }
                  if (pos >= n) { ok = 0; finished = 1; }
                  else {
                    if (SRC[pos] != 123) { ok = 0; finished = 1; }
                    else {
                      pos = pos + 1;
                      CST[csp] = 2; csp = csp + 1;
                      depth = depth + 1;
                    }
                  }
                }
              }
            } else {
              if (want == 7) {
                OPS[opsn] = 16; opsn = opsn + 1;
                if (ety == 2) {
                  OPS[opsn] = 4; opsn = opsn + 1;
                } else {
                  OPS[opsn] = 0; opsn = opsn + 1;
                }
                OPS[opsn] = 16; opsn = opsn + 1;
                OPS[opsn] = 9; opsn = opsn + 1;
              }
              done = 0;
              while (done == 0) {
                if (pos >= n) { done = 1; }
                else {
                  ch = SRC[pos];
                  if (ch == 32) { pos = pos + 1; }
                  else {
                    if (ch == 9) { pos = pos + 1; }
                    else {
                      if (ch == 10) { pos = pos + 1; }
                      else {
                        if (ch == 13) { pos = pos + 1; }
                        else { done = 1; }
                      }
                    }
                  }
                }
              }
              if (pos >= n) { ok = 0; finished = 1; }
              else {
                if (SRC[pos] != 59) { ok = 0; finished = 1; }
                else {
                  pos = pos + 1;
                  if (want == 2) {
                    if (depth == 0) { finished = 1; }
                  }
                }
              }
            }
          }
          }
        }
      }
      }
    }
  }
}

outn = 0;
if (ok == 1) {
  OUT[outn] = kn; outn = outn + 1;
  i = 0;
  while (i < kn) {
    OUT[outn] = 1; outn = outn + 1;
    OUT[outn] = LTY[i]; outn = outn + 1;
    i = i + 1;
  }
  i = 0;
  while (i < opsn) {
    OUT[outn] = OPS[i]; outn = outn + 1;
    i = i + 1;
  }
  OUT[outn] = 0; outn = outn + 1;
  OUT[outn] = 11; outn = outn + 1;
} else {
  OUT[0] = 255;
  OUT[1] = pos % 256;
  i = pos / 256;
  OUT[2] = i % 256;
  i = i / 256;
  OUT[3] = i % 256;
  OUT[4] = kn;
  OUT[5] = want;
  OUT[6] = depth;
  OUT[7] = 11;
  outn = 8;
}

OUTN = outn;
return OUT;
