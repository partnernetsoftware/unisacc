/* release-check.cx -- release helpers for ujs/scripts/release-artifacts.sh (the Python
   heredocs it had before b230ade92f, now CX). Run from the repo root:
     sh ./unisacc.com ujs/scripts/release-check.cx -- version PKG_JSON
         print package.json "version"
     sh ./unisacc.com ujs/scripts/release-check.cx -- fingerprint CORE PKG_JSON
         CORE/BUILD.json "version" == the package version; every BUILD.json "artifacts"
         entry (name -> {sha256, bytes}) is a regular file CORE/name with that sha256 and
         size; prints "fingerprint OK VERSION GIT"
     sh ./unisacc.com ujs/scripts/release-check.cx -- note STAGE
         write STAGE/RELEASE.txt: a fixed text plus a note object whose "build" member is
         STAGE/core/BUILD.json, laid out as Python json.dumps(indent=2)
   A failed check prints its reason on stderr and exits 1.
   The JSON support is only what these files need: a cursor reader over the text and a
   re-printer with the indent=2 layout (", " is never used with indent, ": " between key
   and value, empty {} and []); strings, numbers and literals are re-emitted verbatim, so
   the layout equals json.dumps for ASCII input without redundant escapes. */
#pragma unisa use sys.fs
#pragma unisa use text.text

#define OUTCAP (1 << 20)
#define PATHCAP 4096
#define VALCAP 1024
#define MAXDEPTH 64

static char out[OUTCAP];
static long on;
static int over;
static int depth;

static void put(const char *s, long n) {
    long i;
    if (n < 0 || on + n > OUTCAP) { over = 1; return; }
    for (i = 0; i < n; i++) out[on + i] = s[i];
    on += n;
}
static void putz(const char *s) { put(s, tx_len(s, OUTCAP)); }

static int fail2(const char *what, const char *a) {
    fprintf(stderr, "%s %s\n", what, a);
    return 1;
}

/* ---- JSON reader: positions into the text s[0..n) ---- */
static long ws(const char *s, long n, long i) {
    while (i < n && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r')) i++;
    return i;
}
static int scalar_byte(int c) {
    return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '-' || c == '+' || c == '.';
}
static long skip(const char *s, long n, long i);

/* One element of the object (OBJ) or array whose interior cursor is *POS. 1 with *KEY (objects:
   the key's opening quote) and *VAL (the value's first byte) set and *POS after the value;
   0 at the closing bracket (*POS after it); -1 on malformed text. */
static int elem(const char *s, long n, long *pos, int obj, long *key, long *val) {
    long i = ws(s, n, *pos), e;
    char close = obj ? '}' : ']';
    if (i < n && s[i] == ',') i = ws(s, n, i + 1);
    if (i >= n) return -1;
    if (s[i] == close) { *pos = i + 1; return 0; }
    if (obj) {
        if (s[i] != '"') return -1;
        *key = i;
        e = skip(s, n, i);
        if (e < 0) return -1;
        i = ws(s, n, e);
        if (i >= n || s[i] != ':') return -1;
        i++;
    }
    i = ws(s, n, i);
    *val = i;
    e = skip(s, n, i);
    if (e < 0) return -1;
    *pos = e;
    return 1;
}

/* The end of the value starting at (or after whitespace from) s[i], or -1. */
static long skip(const char *s, long n, long i) {
    long st, k, v;
    int r, obj;
    i = ws(s, n, i);
    if (i >= n) return -1;
    if (s[i] == '"') {
        for (i++; i < n; i++) {
            if (s[i] == '\\') i++;
            else if (s[i] == '"') return i + 1;
        }
        return -1;
    }
    if (s[i] == '{' || s[i] == '[') {
        if (depth >= MAXDEPTH) return -1;
        depth++;
        obj = s[i] == '{';
        st = i + 1;
        while ((r = elem(s, n, &st, obj, &k, &v)) == 1) {}
        depth--;
        return r == 0 ? st : -1;
    }
    st = i;
    while (i < n && scalar_byte((unsigned char)s[i])) i++;
    return i > st ? i : -1;
}

static int hexval(int c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return -1;
}

/* Decode the JSON string at s[i] into DST (CAP bytes, terminated). Its length, or -1. */
static long jstr(const char *s, long n, long i, char *dst, long cap) {
    long o = 0;
    int c, k, u, h;
    if (i >= n || s[i] != '"') return -1;
    for (i++; i < n && s[i] != '"'; i++) {
        c = (unsigned char)s[i];
        if (c == '\\') {
            if (++i >= n) return -1;
            c = s[i];
            if (c == 'n') c = '\n';
            else if (c == 't') c = '\t';
            else if (c == 'r') c = '\r';
            else if (c == 'b') c = '\b';
            else if (c == 'f') c = '\f';
            else if (c == 'u') {
                for (u = 0, k = 1; k <= 4; k++) {
                    if (i + k >= n || (h = hexval((unsigned char)s[i + k])) < 0) return -1;
                    u = u * 16 + h;
                }
                i += 4;
                if (u >= 0x80) {   /* UTF-8; surrogate halves are not paired here */
                    if (o + 3 >= cap) return -1;
                    if (u < 0x800) { dst[o++] = (char)(0xc0 | u >> 6); }
                    else { dst[o++] = (char)(0xe0 | u >> 12); dst[o++] = (char)(0x80 | (u >> 6 & 63)); }
                    c = 0x80 | (u & 63);
                } else c = u;
            }
        }
        if (o + 1 >= cap) return -1;
        dst[o++] = (char)c;
    }
    if (i >= n) return -1;
    dst[o] = 0;
    return o;
}

/* The value of member NAME of the object at s[obj] (the last one when repeated), or -1. */
static long member(const char *s, long n, long obj, const char *name) {
    char key[VALCAP];
    long pos, k, v, got = -1, nl = tx_len(name, VALCAP), kl;
    int r;
    obj = ws(s, n, obj);
    if (obj < 0 || obj >= n || s[obj] != '{') return -1;
    pos = obj + 1;
    while ((r = elem(s, n, &pos, 1, &k, &v)) == 1) {
        kl = jstr(s, n, k, key, sizeof key);
        if (kl >= 0 && tx_same(key, kl, name, nl)) got = v;
    }
    return r == 0 ? got : -1;
}

/* Python str() of the value at s[v] into DST: a string decoded, null/true/false as
   None/True/False, a number verbatim; a missing value (v < 0) is None. 0, or -1. */
static int show(const char *s, long n, long v, char *dst, long cap) {
    long e;
    if (v < 0) return tx_copy(dst, cap, "None", 4) ? -1 : 0;
    if (s[v] == '"') return jstr(s, n, v, dst, cap) < 0 ? -1 : 0;
    e = skip(s, n, v);
    if (e < 0) return -1;
    if (tx_same(s + v, e - v, "null", 4)) return tx_copy(dst, cap, "None", 4) ? -1 : 0;
    if (tx_same(s + v, e - v, "true", 4)) return tx_copy(dst, cap, "True", 4) ? -1 : 0;
    if (tx_same(s + v, e - v, "false", 5)) return tx_copy(dst, cap, "False", 5) ? -1 : 0;
    return tx_copy(dst, cap, s + v, e - v) ? -1 : 0;
}

/* ---- json.dumps(indent=2) layout ---- */
static void indent(int d) {
    int k;
    for (k = 0; k < d; k++) put("  ", 2);
}

/* Re-emit the value at s[i] at nesting depth D. 0, or -1 on malformed text. */
static int pretty(const char *s, long n, long i, int d) {
    long pos, k, v, e;
    int r, obj, first = 1;
    i = ws(s, n, i);
    if (i >= n) return -1;
    if (s[i] == '{' || s[i] == '[') {
        if (d >= MAXDEPTH) return -1;
        obj = s[i] == '{';
        pos = i + 1;
        while ((r = elem(s, n, &pos, obj, &k, &v)) == 1) {
            put(first ? (obj ? "{" : "[") : ",", 1);
            first = 0;
            put("\n", 1);
            indent(d + 1);
            if (obj) {
                e = skip(s, n, k);
                put(s + k, e - k);
                put(": ", 2);
            }
            if (pretty(s, n, v, d + 1)) return -1;
        }
        if (r < 0) return -1;
        if (first) put(obj ? "{}" : "[]", 2);
        else {
            put("\n", 1);
            indent(d);
            put(obj ? "}" : "]", 1);
        }
        return 0;
    }
    e = skip(s, n, i);
    if (e < 0) return -1;
    put(s + i, e - i);
    return 0;
}

/* A fixed ASCII text as a JSON string (json.dumps escapes). */
static void jput(const char *z) {
    static const char hx[] = "0123456789abcdef";
    char u[7];
    long i, n = tx_len(z, OUTCAP);
    put("\"", 1);
    for (i = 0; i < n; i++) {
        int c = (unsigned char)z[i];
        if (c == '"') put("\\\"", 2);
        else if (c == '\\') put("\\\\", 2);
        else if (c == '\n') put("\\n", 2);
        else if (c == '\r') put("\\r", 2);
        else if (c == '\t') put("\\t", 2);
        else if (c == '\b') put("\\b", 2);
        else if (c == '\f') put("\\f", 2);
        else if (c < 0x20) {
            u[0] = '\\'; u[1] = 'u'; u[2] = '0'; u[3] = '0'; u[4] = hx[c >> 4]; u[5] = hx[c & 15];
            put(u, 6);
        } else put(z + i, 1);
    }
    put("\"", 1);
}

/* ---- files ---- */
static int join(char *dst, const char *dir, const char *name) {
    long dn = tx_len(dir, PATHCAP);
    if (dn < 0) return -1;
    while (dn > 1 && dir[dn - 1] == '/') dn--;
    if (dn == 1 && dir[0] == '/') return cx_fmt(dst, PATHCAP, "/%s", name);
    return cx_fmt(dst, PATHCAP, "%.*s/%s", (int)dn, dir, name);
}

/* The whole file at PATH as JSON text whose first value is an object; NULL with a reason on stderr. */
static char *load(const char *path, long *len) {
    size_t n = 0;
    char *b = cx_read(path, &n);
    if (!b) { fail2("cannot read", path); return 0; }
    *len = (long)n;
    if (skip(b, *len, 0) < 0 || b[ws(b, *len, 0)] != '{') { fail2("not a JSON object:", path); return 0; }
    return b;
}

static int digits(const char *s, long n, long *v) {
    long i, x = 0;
    if (n < 1 || n > 18) return -1;
    for (i = 0; i < n; i++) {
        if (s[i] < '0' || s[i] > '9') return -1;
        x = x * 10 + (s[i] - '0');
    }
    *v = x;
    return 0;
}

static int cmd_version(const char *pkg) {
    char v[VALCAP];
    long n;
    char *p = load(pkg, &n);
    if (!p) return 1;
    if (show(p, n, member(p, n, 0, "version"), v, sizeof v)) return fail2("bad version in", pkg);
    printf("%s\n", v);
    return 0;
}

static int cmd_fingerprint(const char *core, const char *pkg) {
    char path[PATHCAP], bv[VALCAP], pv[VALCAP], git[VALCAP], name[VALCAP], want[VALCAP], hex[65];
    long bn, pn, arts, pos, k, v, sv, zv, ze, bytes, flen;
    size_t fn;
    sy_stat_t st;
    int r;
    char *b, *p, *f;
    if (join(path, core, "BUILD.json")) return fail2("path too long:", core);
    if (!(b = load(path, &bn)) || !(p = load(pkg, &pn))) return 1;
    if (show(b, bn, member(b, bn, 0, "version"), bv, sizeof bv) || show(p, pn, member(p, pn, 0, "version"), pv, sizeof pv))
        return fail2("bad version in", path);
    if (!tx_eq(bv, pv, VALCAP)) {
        fprintf(stderr, "version mismatch %s %s\n", bv, pv);
        return 1;
    }
    arts = member(b, bn, 0, "artifacts");
    if (arts < 0 || b[arts] != '{') return fail2("no artifacts object in", path);
    pos = arts + 1;
    while ((r = elem(b, bn, &pos, 1, &k, &v)) == 1) {
        if (jstr(b, bn, k, name, sizeof name) < 0) return fail2("bad artifact name in", path);
        if (join(path, core, name)) return fail2("path too long:", name);
        if (sy_stat(path, &st) != 0 || st.kind != 'f') return fail2("missing", path);
        f = cx_read(path, &fn);
        if (!f) return fail2("missing", path);
        flen = (long)fn;
        cx_sha256_hex(f, (size_t)flen, hex);
        sv = member(b, bn, v, "sha256");
        if (show(b, bn, sv, want, sizeof want)) return fail2("bad sha256 for", name);
        if (sv < 0 || b[sv] != '"' || !tx_eq(hex, want, VALCAP)) {
            fprintf(stderr, "sha mismatch %s %s %s\n", name, hex, want);
            return 1;
        }
        zv = member(b, bn, v, "bytes");
        ze = zv < 0 ? -1 : skip(b, bn, zv);
        if (ze < 0 || digits(b + zv, ze - zv, &bytes) || bytes != st.size) return fail2("size mismatch", name);
    }
    if (r < 0) return fail2("bad artifacts object in", path);
    if (show(b, bn, member(b, bn, 0, "git"), git, sizeof git)) return fail2("bad git in", path);
    printf("fingerprint OK %s %s\n", bv, git);
    return 0;
}

static int cmd_note(const char *stage) {
    char core[PATHCAP], path[PATHCAP], ver[VALCAP], git[VALCAP], created[VALCAP];
    long bn;
    char *b;
    if (join(core, stage, "core") || join(path, core, "BUILD.json")) return fail2("path too long:", stage);
    if (!(b = load(path, &bn))) return 1;
    if (member(b, bn, 0, "version") < 0 || member(b, bn, 0, "git") < 0 || member(b, bn, 0, "created") < 0)
        return fail2("BUILD.json lacks version, git or created:", path);
    if (show(b, bn, member(b, bn, 0, "version"), ver, sizeof ver) || show(b, bn, member(b, bn, 0, "git"), git, sizeof git) ||
        show(b, bn, member(b, bn, 0, "created"), created, sizeof created))
        return fail2("bad version, git or created in", path);
    putz("UJS "); putz(ver); putz(" artifacts\n");
    putz("git="); putz(git); putz(" created="); putz(created); putz("\n");
    putz("Core: core/ujs_full.wasm + core/compiler.gen.js (+ hand-written ESM).\n");
    putz("Do not commit this zip to git; attach to the GitHub Release.\n");
    putz("\n{\n  \"how\": ");
    jput("Upload this zip as a GitHub Release asset for tag/version matching package.json.");
    putz(",\n  \"verify\": ");
    jput("sha256 of core/ujs_full.wasm and core/compiler.gen.js must match core/BUILD.json");
    putz(",\n  \"boot\": ");
    jput("import { bootRuntime, wasm_run } from './core/wasm_run.js'; await bootRuntime(new URL('./core/ujs_full.wasm', import.meta.url));");
    putz(",\n  \"build\": ");
    if (pretty(b, bn, 0, 1)) return fail2("malformed JSON:", path);
    putz("\n}\n");
    if (over) return fail2("note too large for", path);
    if (join(path, stage, "RELEASE.txt")) return fail2("path too long:", stage);
    if (cx_write(path, out, (size_t)on)) return fail2("cannot write", path);
    return 0;
}

int main(int argc, char **argv) {
    const char *mode = argc > 1 ? argv[1] : "";
    if (tx_eq(mode, "version", 16) && argc == 3) return cmd_version(argv[2]);
    if (tx_eq(mode, "fingerprint", 16) && argc == 4) return cmd_fingerprint(argv[2], argv[3]);
    if (tx_eq(mode, "note", 16) && argc == 3) return cmd_note(argv[2]);
    fprintf(stderr, "usage: release-check.cx version PKG | fingerprint CORE PKG | note STAGE\n");
    return 1;
}
