// Drone FP cockpit — one sim step (UJS-1).
// Mode A: missile (host sets thit when locked shot hits) — ammo mirrored as ammo.
// Mode B: suicide — host sets suicide=1 on detonate; wipe thit[] in radius then die.
//
// In: px,py,pz, score, alive, ammo, ix,iy, dt, suicide, speed_mul,
//     fx,fy,fz, rx,ry,rz, txs,tys,tzs,thp, thit
// Out: pose, score, alive, ammo, thp, nk

let n = len(txs);
let i = 0;
let speed = 26.0;
let thrust = 0.0;
let strafe = 0.0;
let climb = 0.0;
let nk = 0;

if (alive === 0) {
  return {
    px: px, py: py, pz: pz, score: score, alive: 0, ammo: ammo,
    txs: txs, tys: tys, tzs: tzs, thp: thp, nk: 0, n: n
  };
}

thrust = 0.0 - iy;
strafe = ix;
// slight look-climb: nose up/down bleeds into altitude while thrusting
climb = fy * thrust * 0.35;
speed = 26.0 * speed_mul;
px = px + (fx * thrust + rx * strafe) * speed * dt;
py = py + (fy * thrust * 0.55 + climb + ry * strafe) * speed * dt;
pz = pz + (fz * thrust + rz * strafe) * speed * dt;
if (py < 2.5) { py = 2.5; }
if (py > 55.0) { py = 55.0; }

i = 0;
while (i < n) {
  if (thit[i] === 1) {
    if (thp[i] > 0.0) {
      thp[i] = 0.0;
      nk = nk + 1;
      score = score + 500.0;
    }
  }
  i = i + 1;
}

if (suicide === 1) {
  alive = 0;
  score = score + 150.0;
}

return {
  px: px, py: py, pz: pz, score: score, alive: alive, ammo: ammo,
  txs: txs, tys: tys, tzs: tzs, thp: thp, nk: nk, n: n
};
