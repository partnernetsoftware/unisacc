// Asteroid Rush -- one simulation step (UJS-1).
// Globals in: xs,ys,zs,vxs,vys,vzs,rs, px,py,pz, ix,iy, dt, score, alive
// Return: updated state dict (host renders; do not draw here).

let n = len(xs);
let i = 0;
let hit = 0;
let sx = 0.0;
let sy = 0.0;

if (alive === 0) {
  return {
    xs: xs, ys: ys, zs: zs,
    vxs: vxs, vys: vys, vzs: vzs, rs: rs,
    px: px, py: py, pz: pz,
    score: score, alive: 0, hit: 0, n: n
  };
}

// player strafe + fly forward (-Z)
// UXIN: W/↑ / stick-up → iy=-1 (same as drone thrust). World +Y is screen-up
// under the chase cam, so negate iy when integrating py.
px = px + ix * 20.0 * dt;
py = py - iy * 20.0 * dt;
pz = pz - 42.0 * dt;
if (px > 18.0) { px = 18.0; }
if (px < -18.0) { px = -18.0; }
if (py > 12.0) { py = 12.0; }
if (py < -12.0) { py = -12.0; }

i = 0;
while (i < n) {
  xs[i] = xs[i] + vxs[i] * dt;
  ys[i] = ys[i] + vys[i] * dt;
  zs[i] = zs[i] + vzs[i] * dt;

  // recycle rocks that passed the ship; keep a soft center corridor
  if (zs[i] > pz + 8.0) {
    zs[i] = pz - 70.0 - (i % 23) * 1.7;
    sx = ((i * 13) % 37) - 18.0;
    sy = ((i * 7) % 25) - 12.0;
    if (sx > -3.5) {
      if (sx < 3.5) {
        if (sy > -3.5) {
          if (sy < 3.5) {
            sx = sx + 7.0;
          }
        }
      }
    }
    xs[i] = sx;
    ys[i] = sy;
    vxs[i] = ((i % 5) - 2) * 0.55;
    vys[i] = ((i % 3) - 1) * 0.4;
    vzs[i] = 8.0 + (i % 11) * 0.35;
    rs[i] = 0.55 + (i % 5) * 0.22;
  }

  let dx = xs[i] - px;
  let dy = ys[i] - py;
  let dz = zs[i] - pz;
  let rr = rs[i] + 0.7;
  if (dx * dx + dy * dy + dz * dz < rr * rr) {
    hit = 1;
  }
  i = i + 1;
}

if (hit === 1) {
  alive = 0;
}

score = score + dt * 10.0;

return {
  xs: xs, ys: ys, zs: zs,
  vxs: vxs, vys: vys, vzs: vzs, rs: rs,
  px: px, py: py, pz: pz,
  score: score, alive: alive, hit: hit, n: n
};
