#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    const int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char *target="ujs/practice/uxe/base/gpu-shadow-compare-generated.ujs";
    const char *expressions[]={"0","reference<stored","reference==stored","reference<=stored",
        "reference>stored","reference!=stored","reference>=stored","1"};
    unsigned char *facts=0,*upstream=0,*stored=0;
    int64_t size=0,reference=0,old=0;
    int failed=sy_read_file("ujs/practice/uxe/base/gpu-state-constants.tsv",&facts,&size,16000) ||
        sy_read_file("ujs/practice/web/game/three.module.js",&upstream,&reference,4000000);
    char output[2200];
    int used=tx_snprintf(output,sizeof output,
        "// Generated by gen-gpu-shadow-compare.cx.\n"
        "native function GpuShadow_compare(mode:i64,reference:f64,stored:f64) i64 {\n"
        "  if(!(reference>=0.0 && reference<=1.0 && stored>=0.0 && stored<=1.0)) { return 0-1; }\n");
    int count=0;
    for(int64_t row=0;!failed && row<size;) {
        int64_t end=row;
        while(end<size && facts[end]!='\n') end++;
        if(tx_prefix((const char *)facts+row,end-row,"compare\t",8)) {
            int64_t tab=row+8;
            while(tab<end && facts[tab]!='\t') tab++;
            char name[64],decl[100],*after=0;
            const int n=tx_snprintf(name,sizeof name,"%.*s",(int)(tab-row-8),facts+row+8);
            long mode=tab<end?tx_strtol((const char *)facts+tab+1,&after,10):-1;
            if(count>=8 || n<1 || n>=sizeof name || mode!=512+count ||
               !after || end-(after-(char *)facts)!=2 || *after!='\t' || after[1]!='0') { failed=1; break; }
            const int declaration=tx_snprintf(decl,sizeof decl,"const %s = %ld;",name,mode);
            if(declaration<1 || !tx_contains((const char *)upstream,reference,decl,declaration)) { failed=1; break; }
            const char *expression=expressions[mutate && count==3?1:count];
            const int emitted=tx_snprintf(output+used,sizeof output-used,
                "  if(mode==%ld) { return %s; } // %s\n",mode,expression,name);
            if(emitted<0 || emitted>=(int)sizeof output-used) { failed=1; break; }
            used+=emitted;
            count++;
        }
        row=end+1;
    }
    if(!failed && count==8) {
        used+=tx_snprintf(output+used,sizeof output-used,"  return 0-2;\n}\n");
        failed=write?sy_write_file(target,output,used,0644)!=0:
            sy_read_file(target,&stored,&old,sizeof output) || !tx_same((const char *)stored,old,output,used);
    } else failed=1;
    mm_free(facts); mm_free(upstream); mm_free(stored);
    printf("GPU_SHADOW_COMPARE modes=%d failed=%d\n",count,failed);
    return failed;
}
