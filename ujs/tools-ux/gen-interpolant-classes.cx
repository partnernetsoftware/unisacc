#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    const int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char *path="ujs/practice/uxe/base/interpolant-classes-generated.ujs";
    const char header[]="name\tkind\n";
    unsigned char *facts=0,*old=0,*ref=0;
    int64_t bytes=0,oldBytes=0,refBytes=0;
    int failed=sy_read_file("ujs/practice/uxe/base/interpolant-classes.tsv",&facts,&bytes,1024) ||
        sy_read_file("ujs/practice/web/game/three.module.js",&ref,&refBytes,4000000);
    if(!failed && (bytes<sizeof header-1 || !tx_prefix((const char *)facts,bytes,header,sizeof header-1))) failed=1;
    char code[4096],name[64],declaration[100];
    int used=tx_snprintf(code,sizeof code,"// Generated by gen-interpolant-classes.cx.\n");
    int count=0;
    for(int64_t at=sizeof header-1;!failed && at<bytes;) {
        int64_t tab=at;
        while(tab<bytes && facts[tab]!='\t' && facts[tab]!='\n') tab++;
        if(tab==at || tab-at>=sizeof name || tab+2>=bytes || facts[tab]!='\t' ||
           facts[tab+1]!='0'+count || facts[tab+2]!='\n' || count>=5) { failed=1; break; }
        tx_snprintf(name,sizeof name,"%.*s",(int)(tab-at),facts+at);
        const int d=tx_snprintf(declaration,sizeof declaration,"class %s ",name);
        if(d<0 || !tx_contains((const char *)ref,refBytes,declaration,d)) { failed=1; break; }
        const int n=tx_snprintf(code+used,sizeof code-used,
            "native function %s_new(state:i64,view:i64,result:i64) i64 {\n"
            "  return Interpolant_initArray(state,view,result,%d);\n}\n",name,count+(mutate && count==2));
        if(n<0 || n>=sizeof code-used) { failed=1; break; }
        used+=n;
        count++;
        at=tab+3;
    }
    if(!failed && count==5)
        failed=write?sy_write_file(path,code,used,0644)!=0:
            sy_read_file(path,&old,&oldBytes,4096) || !tx_same((const char *)old,oldBytes,code,used);
    else failed=1;
    printf("INTERPOLANT_CLASSES rows=%d failed=%d\n",count,failed);
    mm_free(old);
    mm_free(ref);
    mm_free(facts);
    return failed;
}
