#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

static const char facts[]="ujs/practice/uxe/base/object-layouts.tsv";
static const char declarations[]="ujs/practice/uxe/base/object-layouts.ujs";
static const char scene_prefix[]="ujs/practice/uxe/base/object3d-layout.ujs";
static const char geometry_prefix[]="ujs/practice/uxe/base/geometry-load-layout.ujs";
static const char curve_prefix[]="ujs/practice/uxe/base/curve-control-layout.ujs";
static const char offsets[]="ujs/practice/uxe/base/object-offsets.tsv";
static const char json_facts[]="ujs/practice/uxe/base/object-json-tokens.tsv";
static const char json_source[]="ujs/practice/uxe/base/object-json-tokens.ujs";

typedef struct { char *name,*type; int offset,size; } Field;
typedef struct { char *name; Field fields[24]; int count,end,alignment; } Layout;
static Layout layouts[24];
static int count;
static char source[20000],table[32000];
static int source_n,table_n;

static int ident(const char *s) {
    int i=0;
    for(;s[i];i++) {
        int c=s[i];
        if(!((c>='a' && c<='z') || (c>='A' && c<='Z') || c=='_' ||
             (i && c>='0' && c<='9'))) return 0;
    }
    return i>0 && i<32;
}

static Layout *lookup(const char *name) {
    for(int i=0;i<count;i++) if(tx_eqz(layouts[i].name,name)) return layouts+i;
    return 0;
}

static int align_to(int value,int alignment) {
    return (value+alignment-1)/alignment*alignment;
}

static int parse_row(char *row) {
    char *parent=row;
    while(*parent && *parent!='\t') parent++;
    if(!*parent) return 1;
    *parent++=0;
    char *fields=parent;
    while(*fields && *fields!='\t') fields++;
    if(!*fields) return 1;
    *fields++=0;
    if(!ident(row) || lookup(row) || count==24) return 1;
    Layout *next=layouts+count;
    next->alignment=1;
    if(!tx_eqz(parent,"-")) {
        Layout *base=lookup(parent);
        if(!base) return 1;
        *next=*base;
        // Preserve the complete base prefix, including trailing padding.
        int prefix=align_to(base->end,base->alignment);
        if(prefix!=base->end && !tx_eqz(fields,"-")) return 1;
    }
    next->name=row;
    if(!tx_eqz(fields,"-")) while(*fields) {
        char *name=fields;
        while(*fields && *fields!=':' && *fields!=' ') fields++;
        if(*fields!=':') return 1;
        *fields++=0;
        char *type=fields;
        while(*fields && *fields!=' ') fields++;
        if(*fields) *fields++=0;
        if(!ident(name) || next->count==24) return 1;
        for(int i=0;i<next->count;i++) if(tx_eqz(name,next->fields[i].name)) return 1;
        int width=0;
        if(tx_eqz(type,"u32") || tx_eqz(type,"i32") || tx_eqz(type,"f32")) width=4;
        if(tx_eqz(type,"f64")) width=8;
        if(!width) return 1;
        int offset=align_to(next->end,width);
        next->fields[next->count++]=(Field){name,type,offset,width};
        next->end=offset+width;
        if(width>next->alignment) next->alignment=width;
    }
    if(!next->count) return 1;
    count++;
    return 0;
}

static int render(void) {
    source_n=tx_snprintf(source,sizeof source,"// Generated by gen-object-layouts.cx.\n");
    table_n=tx_snprintf(table,sizeof table,"layout\tfield\ttype\toffset\tsize\n");
    for(int i=0;i<count;i++) {
        Layout *l=layouts+i;
        source_n+=tx_snprintf(source+source_n,sizeof source-source_n,"struct %s {\n",l->name);
        for(int j=0;j<l->count;j++) {
            Field *f=l->fields+j;
            source_n+=tx_snprintf(source+source_n,sizeof source-source_n,"  %s: %s;\n",f->name,f->type);
            table_n+=tx_snprintf(table+table_n,sizeof table-table_n,"%s\t%s\t%s\t%d\t%d\n",
                l->name,f->name,f->type,f->offset,f->size);
            if(source_n>=(int)sizeof source-64 || table_n>=(int)sizeof table-64) return 1;
        }
        source_n+=tx_snprintf(source+source_n,sizeof source-source_n,"}\n");
        table_n+=tx_snprintf(table+table_n,sizeof table-table_n,"%s\t-\trecord\t0\t%d\n",
            l->name,align_to(l->end,l->alignment));
    }
    return 0;
}

static int verify(const char *path,const char *expected,int size,int write) {
    if(write) return sy_write_file(path,expected,size,0644)!=0;
    unsigned char *actual=0;
    int64_t bytes=0;
    int failed=sy_read_file(path,&actual,&bytes,32000) ||
        !tx_same((char *)actual,bytes,expected,size);
    mm_free(actual);
    return failed;
}

static int render_record_subset(const char **names) {
    int n=tx_snprintf(source,sizeof source,"// Generated by gen-object-layouts.cx.\n");
    for(int j=0;names[j];j++) {
        Layout *node=lookup(names[j]);
        if(!node) return -1;
        n+=tx_snprintf(source+n,sizeof source-n,"struct %s {\n",node->name);
        for(int i=0;i<node->count;i++) {
            Field *field=node->fields+i;
            n+=tx_snprintf(source+n,sizeof source-n,"  %s: %s;\n",field->name,field->type);
        }
        n+=tx_snprintf(source+n,sizeof source-n,"}\n");
    }
    return n;
}

static int render_json_tokens(unsigned char *raw,int64_t bytes) {
    const char header[]="name\ttext\n";
    char *names[48],*tokens[48];
    int size[48],classes[48],counts[3]={0},rows=0,n=0;
    const char *layout[]={"ObjectJsonToken","ObjectJsonType","CurveJsonToken"};
    const char *prefix[]={"","ObjectJsonToken.size+","ObjectJsonToken.size+ObjectJsonType.size+"};
    if(bytes<(int)sizeof header-1 || !tx_prefixz((char *)raw,header,sizeof header-1)) return -1;
    char *at=(char *)raw+sizeof header-1,*end=(char *)raw+bytes;
    while(at<end) {
        char *name=at;
        if(rows==48) return -1;
        while(at<end && *at!='\t' && *at!='\n') at++;
        if(at==end || *at!='\t') return -1;
        *at++=0;
        int kind=0;
        if(tx_prefixz(name,"Type_",5)) { kind=1; name+=5; }
        else if(tx_prefixz(name,"Curve_",6)) { kind=2; name+=6; }
        if(!ident(name) || counts[kind]==24) return -1;
        for(int i=0;i<rows;i++) if(classes[i]==kind && tx_eqz(name,names[i])) return -1;
        char *token=at;
        while(at<end && *at>=' ' && *at<='~') at++;
        if(at==end || *at!='\n' || at==token || at-token>120) return -1;
        names[rows]=name;
        tokens[rows]=token;
        classes[rows]=kind;
        counts[kind]++;
        size[rows++]=(int)(at-token);
        at++;
    }
    n=tx_snprintf(source,sizeof source,"// Generated by gen-object-layouts.cx.\n");
    for(int kind=0;kind<3;kind++) {
        if(!counts[kind]) return -1;
        n+=tx_snprintf(source+n,sizeof source-n,"struct %s {\n",layout[kind]);
        for(int i=0;i<rows;i++) if(classes[i]==kind)
            n+=tx_snprintf(source+n,sizeof source-n,"  %s: u32;\n",names[i]);
        n+=tx_snprintf(source+n,sizeof source-n,"}\n");
    }
    n+=tx_snprintf(source+n,sizeof source-n,"native function json_write_token(dst:i64,end:i64,id:i64) i64 {\n"
        "  if(dst<0 || end<dst || end>6291456) { return 0-1; }\n");
    for(int i=0;i<rows;i++) {
        if(n<0 || n+700>=(int)sizeof source) return -1;
        int kind=classes[i];
        n+=tx_snprintf(source+n,sizeof source-n,
            "  if(id==%s%s.%s) {\n    if(end-dst<%d) { return 0-1; }\n    let bytes=[",
            prefix[kind],layout[kind],names[i],size[i]);
        for(int j=0;j<size[i];j++) n+=tx_snprintf(source+n,sizeof source-n,"%s%d",j?",":"",tokens[i][j]);
        n+=tx_snprintf(source+n,sizeof source-n,
            "];\n    let i=0;\n    while(i<%d) {\n"
            "      let byte=ux_u8_put(dst+i,bytes[i]);\n      i=i+1;\n    }\n    return dst+%d;\n  }\n",
            size[i],size[i]);
    }
    n+=tx_snprintf(source+n,sizeof source-n,"  return 0-1;\n}\n");
    if(!rows || n>=(int)sizeof source) return -1;
    return n;
}

int main(int argc,char **argv) {
    int write=argc==2 && tx_eqz(argv[1],"--write");
    if(!write && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    unsigned char *raw=0;
    int64_t bytes=0;
    const char header[]="layout\tparent\tfields\n";
    if(sy_read_file(facts,&raw,&bytes,16000)) return 1;
    int failed=bytes<(int)sizeof header-1 || !tx_prefixz((char *)raw,header,sizeof header-1);
    char *at=(char *)raw+sizeof header-1;
    char *end=(char *)raw+bytes;
    while(!failed && at<end) {
        char *line=at;
        while(at<end && *at!='\n') at++;
        if(at==end) { failed=1; break; }
        *at++=0;
        failed=parse_row(line);
    }
    if(!failed) failed=!count || render() || verify(declarations,source,source_n,write) ||
        verify(offsets,table,table_n,write);
    if(!failed) {
        const char *scene_names[]={"Object3D",0};
        int n=render_record_subset(scene_names);
        failed=n<0 || verify(scene_prefix,source,n,write);
    }
    if(!failed) {
        const char *geometry_names[]={"BufferAttribute","BufferGeometry","GeometryJsonLoad",
            "InterleavedBuffer","InterleavedBufferAttribute",0};
        int n=render_record_subset(geometry_names);
        failed=n<0 || verify(geometry_prefix,source,n,write);
    }
    if(!failed) {
        const char *curve_names[]={"CurveControl",0};
        int n=render_record_subset(curve_names);
        failed=n<0 || verify(curve_prefix,source,n,write);
    }
    mm_free(raw);
    raw=0;
    if(!failed) {
        failed=sy_read_file(json_facts,&raw,&bytes,12000);
        if(!failed) {
            int n=render_json_tokens(raw,bytes);
            failed=n<0 || verify(json_source,source,n,write);
        }
        mm_free(raw);
    }
    printf("GEN_OBJECT_LAYOUTS layouts=%d failed=%d\n",count,failed);
    return failed;
}
