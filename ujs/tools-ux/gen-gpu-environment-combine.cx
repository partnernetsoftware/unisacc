#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    const int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char *target="ujs/practice/uxe/base/gpu-environment-combine-generated.ujs";
    unsigned char *table=0,*reference=0,*previous=0;
    int64_t bytes=0,ref_bytes=0,old=0;
    int failed=sy_read_file("ujs/practice/uxe/base/gpu-environment-combine.tsv",&table,&bytes,1000) ||
        sy_read_file("ujs/practice/web/game/three.module.js",&reference,&ref_bytes,4000000);
    const char header[]="name\tvalue\tformula\n";
    if(!failed) failed=bytes<(int64_t)sizeof header || !tx_same((const char *)table,sizeof header-1,header,sizeof header-1);
    char output[1500];
    int used=tx_snprintf(output,sizeof output,
        "// Generated by gen-gpu-environment-combine.cx.\n"
        "native function GpuEnv_combine(mode:i64,base:f64,env:f64,weight:f64) f64 {\n");
    int count=0;
    for(int64_t row=sizeof header-1;!failed && row<bytes;) {
        int64_t end=row,tab=row;
        while(end<bytes && table[end]!='\n') end++;
        while(tab<end && table[tab]!='\t') tab++;
        char name[64],decl[96],*after=0;
        const int n=tx_snprintf(name,sizeof name,"%.*s",(int)(tab-row),table+row);
        const long mode=tab<end?tx_strtol((const char *)table+tab+1,&after,10):-1;
        if(count>=3 || n<1 || n>=sizeof name || mode!=count || !after || *after!='\t') { failed=1; break; }
        const int declaration=tx_snprintf(decl,sizeof decl,"const %s = %ld;",name,mode);
        if(declaration<1 || !tx_contains((const char *)reference,ref_bytes,decl,declaration)) { failed=1; break; }
        const char *formula=after+1;
        int length=(int)(end-(formula-(const char *)table));
        if(length<1 || length>80) { failed=1; break; }
        const char allowed[]="baseenvweight012+-.()*";
        for(int i=0;i<length;i++) if(!tx_contains(allowed,sizeof allowed-1,formula+i,1)) failed=1;
        if(failed) break;
        if(mutate && count==2) { formula="base"; length=4; }
        const int emitted=tx_snprintf(output+used,sizeof output-used,
            "  if(mode==%ld) { return %.*s; } // %s\n",mode,length,formula,name);
        if(emitted<0 || emitted>=(int)sizeof output-used) { failed=1; break; }
        used+=emitted;
        count++;
        row=end+1;
    }
    if(!failed && count==3) {
        used+=tx_snprintf(output+used,sizeof output-used,"  return 0.0-1.0;\n}\n");
        failed=write?sy_write_file(target,output,used,0644)!=0:
            sy_read_file(target,&previous,&old,sizeof output) || !tx_same((const char *)previous,old,output,used);
    } else failed=1;
    mm_free(table); mm_free(reference); mm_free(previous);
    printf("GPU_ENVIRONMENT_COMBINE modes=%d failed=%d\n",count,failed);
    return failed;
}
