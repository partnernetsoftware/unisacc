#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    const int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char *path="ujs/practice/uxe/base/gpu-legacy-srgb-generated.ujs";
    const char marker[]="\nconst _SRGBAFormat = ";
    unsigned char *reference=0,*previous=0;
    int64_t bytes=0,old=0;
    int failed=sy_read_file("ujs/practice/web/game/three.module.js",&reference,&bytes,4000000);
    const long pos=failed?-1:tx_find((const char *)reference,bytes,marker,sizeof marker-1);
    const char *value=pos<0?0:(const char *)reference+pos+sizeof marker-1;
    char *end=0;
    const long mode=value?tx_strtol(value,&end,10):-1;
    if(mode<1 || mode>65535 || !end || *end!=';') failed=1;
    char output[1000];
    const int length=tx_snprintf(output,sizeof output,
        "// Generated by gen-gpu-legacy-srgb.cx.\n"
        "native function GpuLegacySrgb_sample(format:i64,address:i64,width:i64,height:i64,u:f64,v:f64) i64 {\n"
        "  if(format==%ld) { return gpu_legacy_srgb_pixel(address,width,height,u,v); } // _SRGBAFormat\n"
        "  return 0-2;\n}\n",mode+mutate);
    failed=failed || length<1 || length>=sizeof output ||
        (write?sy_write_file(path,output,length,0644)!=0:
         sy_read_file(path,&previous,&old,sizeof output) || !tx_same((const char *)previous,old,output,length));
    mm_free(reference); mm_free(previous);
    printf("GPU_LEGACY_SRGB failed=%d\n",failed);
    return failed;
}
