#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

static const char target[]="ujs/practice/uxe/base/bufferconstants.ujs";
static const char *const exports[]={
    "StaticDrawUsage","StaticReadUsage","StaticCopyUsage","DynamicDrawUsage","DynamicReadUsage",
    "DynamicCopyUsage","StreamDrawUsage","StreamReadUsage","StreamCopyUsage","UnsignedByteType",
    "ByteType","ShortType","UnsignedShortType","IntType","UnsignedIntType","FloatType","HalfFloatType",
    "UnsignedShort4444Type","UnsignedShort5551Type","UnsignedInt248Type"
};

int main(int argc,char **argv) {
    int write=argc==2 && tx_eqz(argv[1],"--write");
    if(!write && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    unsigned char *source=0;
    int64_t size=0;
    if(sy_read_file("ujs/practice/web/game/three.module.js",&source,&size,4000000)) return 1;
    char out[5000]="// Generated by gen-buffer-constants.cx from the pinned r160 exports.\n";
    int used=tx_len(out,sizeof out),failed=0;
    int count=sizeof exports/sizeof exports[0];
    for(int i=0;i<count;i++) {
        char prefix[80];
        int n=tx_snprintf(prefix,sizeof prefix,"\nconst %s = ",exports[i]);
        long at=tx_find((char *)source,size,prefix,n);
        if(at<0) { failed=1; break; }
        long start=at+n,end=start;
        while(end<size && source[end]>='0' && source[end]<='9') end++;
        if(end==start || end-start>6 || end>=size || source[end]!=';') { failed=1; break; }
        int added=tx_snprintf(out+used,sizeof out-used,"function %s() { return %.*s; }\n",
            exports[i],(int)(end-start),(char *)source+start);
        if(added<0 || added>=(int)sizeof out-used) { failed=1; break; }
        used+=added;
    }
    mm_free(source);
    if(!failed && write) failed=sy_write_file(target,out,used,0644)!=0;
    if(!failed && !write) {
        unsigned char *previous=0;
        int64_t bytes=0;
        failed=sy_read_file(target,&previous,&bytes,sizeof out) || !tx_same((char *)previous,bytes,out,used);
        mm_free(previous);
    }
    printf("GEN_BUFFER_CONSTANTS rows=%d failed=%d\n",count,failed);
    return failed;
}
