#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    const int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char *generated="ujs/practice/uxe/base/gpu-cube-map-generated.ujs";
    unsigned char *table=0,*reference=0,*previous=0;
    int64_t bytes=0,ref_size=0,old=0;
    int failed=sy_read_file("ujs/practice/uxe/base/gpu-cube-map.tsv",&table,&bytes,800) ||
        sy_read_file("ujs/practice/web/game/three.module.js",&reference,&ref_size,4000000);
    const char header[]="name\tvalue\tmode\n";
    if(!failed) failed=bytes<(int64_t)sizeof header || !tx_same((const char *)table,sizeof header-1,header,sizeof header-1);
    const char *names[]={"CubeReflectionMapping","CubeRefractionMapping"};
    char output[1000];
    int used=tx_snprintf(output,sizeof output,
        "// Generated by gen-gpu-cube-map.cx.\n"
        "native function GpuCubeMap_face(mode:i64,incident:i64,normal:i64,eta:f64,flipX:i64) i64 {\n");
    int count=0;
    for(int64_t row=sizeof header-1;!failed && row<bytes;) {
        int64_t tab=row,end=row;
        while(end<bytes && table[end]!='\n') end++;
        while(tab<end && table[tab]!='\t') tab++;
        if(count>=2 || tab==end || !tx_same((const char *)table+row,tab-row,names[count],tx_len(names[count],40))) {
            failed=1;
            break;
        }
        char *after=0,decl[96];
        const long value=tx_strtol((const char *)table+tab+1,&after,10);
        const int n=tx_snprintf(decl,sizeof decl,"const %s = %ld;",names[count],value);
        if(value<1 || value>65535 || end-(after-(char *)table)!=2 || *after!='\t' ||
           after[1]!='0'+count || !tx_contains((const char *)reference,ref_size,decl,n)) { failed=1; break; }
        const int emitted=tx_snprintf(output+used,sizeof output-used,
            "  if(mode==%ld) { return gpu_cube_map_face(%d,incident,normal,eta,flipX); } // %s\n",
            value,mutate?1-count:count,names[count]);
        if(emitted<0 || emitted>=(int)sizeof output-used) { failed=1; break; }
        used+=emitted;
        count++;
        row=end+1;
    }
    if(!failed && count==2) {
        used+=tx_snprintf(output+used,sizeof output-used,"  return 0-2;\n}\n");
        failed=write?sy_write_file(generated,output,used,0644)!=0:
            sy_read_file(generated,&previous,&old,sizeof output) || !tx_same((const char *)previous,old,output,used);
    } else failed=1;
    mm_free(table); mm_free(reference); mm_free(previous);
    printf("GPU_CUBE_MAP mappings=%d failed=%d\n",count,failed);
    return failed;
}
