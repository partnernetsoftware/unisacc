#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

static int encoding(const char *facts,int64_t bytes,const char *ref,int64_t ref_bytes,const char *name) {
    char row[64],decl[80];
    const int n=tx_snprintf(row,sizeof row,"\nB\t%s\t",name);
    const long at=tx_find(facts,bytes,row,n);
    if(at<0 || tx_find(facts+at+n,bytes-at-n,row,n)>=0) return -1;
    const char *start=facts+at+n;
    char *end=0;
    const long value=tx_strtol(start,&end,10);
    if(end==start || *end!='\t' || value<0 || value>65535) return -1;
    const int d=tx_snprintf(decl,sizeof decl,"const %s = %ld;",name,value);
    return tx_contains(ref,ref_bytes,decl,d)?(int)value:-1;
}

static int publish(const char *path,const char *data,int size,int write) {
    if(write) return sy_write_file(path,data,size,0644)!=0;
    unsigned char *old=0;
    int64_t bytes=0;
    int fail=sy_read_file(path,&old,&bytes,8192) || !tx_same((const char *)old,bytes,data,size);
    mm_free(old);
    return fail;
}

int main(int argc,char **argv) {
    int write=argc==2 && tx_eqz(argv[1],"--write");
    int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    unsigned char *facts=0,*ref=0;
    int64_t bytes=0,ref_bytes=0;
    int bad=sy_read_file("ujs/plans/ux-three-b-semantic-facts.tsv",&facts,&bytes,16000) ||
        sy_read_file("ujs/practice/web/game/three.module.js",&ref,&ref_bytes,4000000);
    int linear=bad?-1:encoding((const char *)facts,bytes,(const char *)ref,ref_bytes,"LinearEncoding");
    int srgb=bad?-1:encoding((const char *)facts,bytes,(const char *)ref,ref_bytes,"sRGBEncoding");
    char output[960];
    const int n=tx_snprintf(output,sizeof output,
        "// Generated by gen-gpu-color-encoding.cx.\n"
        "native function GpuColor_fromLegacyEncoding(color:i64,value:i64,target:i64) i64 {\n"
        "  if(color<0 || color%%8!=0 || color>6291456-24 || target<1 || target>4) { return 0-1; }\n"
        "  if(value==%d) { return ColorManagement_convert(1,color,%d,target); } // LinearEncoding\n"
        "  if(value==%d) { return ColorManagement_convert(1,color,2,target); } // sRGBEncoding\n"
        "  return 0-2;\n}\n",linear,mutate?2:0,srgb);
    const char notes[]="name\tstate\tcategory\tmilestone\tpriority\tmethods\tevidence\n"
        "LinearEncoding,sRGBEncoding\t已有\t渲染常量\tM5\tP2\t-\t"
        "G-struct GPU_COLOR_ENCODING；r160 Texture.encoding 映射和实际颜色变换，独立金值与两种互换篡改\n";
    bad=bad || linear<0 || srgb<0 || linear==srgb || n<0 || n>=sizeof output ||
        publish("ujs/practice/uxe/base/gpu-color-encoding-generated.ujs",output,n,write) ||
        publish("ujs/practice/uxe/base/gpu-color-encoding-annotations.tsv",notes,sizeof notes-1,write);
    printf("GPU_COLOR_ENCODING generated=2 failed=%d\n",bad);
    mm_free(facts); mm_free(ref);
    return bad;
}
