#pragma unisa use text.text

typedef struct {
    const char *name;
    const char *cache_env;
    const char *gate;
} LinkedWasmGate;

static const LinkedWasmGate gate[]={
    {"jpeg","UXE_JPEG_WASM_CACHE","ujs/tests/jpeg-progressive-color-io.cx"},
    {"geometry","UXE_GEOMETRY_WASM_CACHE","ujs/tests/geometry-json-load-struct.cx"}
};

static int cache_path_ok(const char *path) {
    if(path[0]!='/' || tx_len(path,512)>=512) return 0;
    for(int i=0;path[i];i++) {
        char c=path[i];
        if((c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9') ||
           c=='/' || c=='-' || c=='_' || c=='.') continue;
        return 0;
    }
    return 1;
}

int main(int argc,char **argv) {
    if(argc!=3 || !cache_path_ok(argv[1])) {
        fprintf(stderr,"用法：cx ujs/tools-ux/linked-wasm-flow.cx -- /已创建的缓存目录 jpeg|geometry\n");
        return 2;
    }
    for(int i=0;i<(int)(sizeof gate/sizeof gate[0]);i++) {
        if(!tx_eqz(argv[2],gate[i].name)) continue;
        printf("prepare\texec\t-\ta0=env;a1=%s=%s;a2=cx;a3=%s;a4=--;a5=--prepare;timeout_ms=55000\n",
            gate[i].cache_env,argv[1],gate[i].gate);
        printf("gate\texec\tprepare\ta0=env;a1=%s=%s;a2=cx;a3=%s;timeout_ms=55000\n",
            gate[i].cache_env,argv[1],gate[i].gate);
        return 0;
    }
    return 2;
}
