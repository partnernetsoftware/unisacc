#pragma unisa use text.text

typedef struct {
    const char *name;
    const char *cache_env;
    const char *gate;
} LinkedWasmGate;

static const LinkedWasmGate gate[]={
    {"jpeg","UXE_JPEG_WASM_CACHE","ujs/tests/jpeg-progressive-color-io.cx"},
    {"geometry","UXE_GEOMETRY_WASM_CACHE","ujs/tests/geometry-json-load-struct.cx"},
    {"gpu-flat","UXE_GPU_LINK_CACHE","ujs/tests/gpu-linked-flat-pixel.cx"},
    {"gpu-material","UXE_GPU_LINK_MATERIAL_CACHE","ujs/tests/gpu-linked-material-pixel.cx"},
    {"gpu-light","UXE_GPU_LINK_LIGHT_CACHE","ujs/tests/gpu-linked-light-pixel.cx"},
    {"gpu-tail","UXE_GPU_LINK_TAIL_CACHE","ujs/tests/gpu-linked-tail-pixel.cx"},
    {"jpeg-color","UXE_JPEG_COLOR_WASM_CACHE","ujs/tests/jpeg-color-io.cx"},
    {"jpeg-gray","UXE_JPEG_GRAY_WASM_CACHE","ujs/tests/jpeg-progressive-gray-io.cx"},
    {"loader-png","UXE_PNG_LOADER_WASM_CACHE","ujs/tests/loader-family-png-linked.cx"},
    {"light-public","UXE_LIGHT_WASM_CACHE","ujs/tests/light-class-public-linked.cx"},
    {"plane-public","UXE_PLANE_PUBLIC_WASM_CACHE","ujs/tests/geometry-plane-public.cx"},
    {"box-circle-public","UXE_BOX_CIRCLE_WASM_CACHE","ujs/tests/geometry-box-circle-public.cx"}
};

static int cache_path_ok(const char *path) {
    if(path[0]!='/' || tx_len(path,512)>=512) return 0;
    for(int i=0;path[i];i++) {
        char c=path[i];
        if((c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9') ||
           c=='/' || c=='-' || c=='_' || c=='.') continue;
        return 0;
    }
    return 1;
}

int main(int argc,char **argv) {
    if(argc!=3 || !cache_path_ok(argv[1])) {
        fprintf(stderr,"用法：cx ujs/tools-ux/linked-wasm-flow.cx -- /已创建的缓存目录 jpeg|geometry|gpu-flat|gpu-material|gpu-light|gpu-tail|jpeg-color|jpeg-gray|loader-png|light-public|plane-public|box-circle-public|all\n");
        return 2;
    }
    const int all=tx_eqz(argv[2],"all");
    int found=0;
    for(int i=0;i<(int)(sizeof gate/sizeof gate[0]);i++) {
        if(!all && !tx_eqz(argv[2],gate[i].name)) continue;
        printf("prepare%d\texec\t-\ta0=env;a1=%s=%s;a2=cx;a3=%s;a4=--;a5=--prepare;timeout_ms=55000\n",
            i,gate[i].cache_env,argv[1],gate[i].gate);
        printf("gate%d\texec\tprepare%d\ta0=env;a1=%s=%s;a2=cx;a3=%s;timeout_ms=55000\n",
            i,i,gate[i].cache_env,argv[1],gate[i].gate);
        found=1;
    }
    if(all) printf("gpu_union\texec\tgate2,gate3,gate4,gate5\ta0=cx;a1=ujs/tests/gpu-linked-union.cx;timeout_ms=55000\n");
    return found?0:2;
}
