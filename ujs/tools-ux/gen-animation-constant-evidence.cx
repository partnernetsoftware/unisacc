#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    const int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char *path="ujs/practice/uxe/base/animation-constant-annotations.tsv";
    const char *names[]={"InterpolateDiscrete","InterpolateLinear","InterpolateSmooth",
        "ZeroCurvatureEnding","ZeroSlopeEnding","WrapAroundEnding"};
    const int values[]={2300,2301,2302,2400,2401,2402};
    unsigned char *facts=0,*ref=0,*old=0;
    int64_t factsSize=0,refSize=0,oldSize=0;
    int failed=sy_read_file("ujs/plans/ux-three-b-semantic-facts.tsv",&facts,&factsSize,16000) ||
        sy_read_file("ujs/practice/web/game/three.module.js",&ref,&refSize,4000000);
    char data[2400],line[160];
    int used=tx_snprintf(data,sizeof data,"name\tstate\tcategory\tmilestone\tpriority\tmethods\tevidence\n");
    int count=0;
    for(int i=0;!failed && i<6;i++) {
        const int value=values[i]+(mutate && i==5);
        const int declaration=tx_snprintf(line,sizeof line,"const %s = %d;",names[i],value);
        failed=declaration<0 || !tx_contains((const char *)ref,refSize,line,declaration);
        const int fact=tx_snprintf(line,sizeof line,"\nB\t%s\t%d\t%s\t%d\t",
            names[i],value,i<3?"KeyframeTrack.interpolation":"Interpolant.settings",value);
        failed|=fact<0 || !tx_contains((const char *)facts,factsSize,line,fact);
        if(failed) break;
        const int added=tx_snprintf(data+used,sizeof data-used,
            "%s\t已有\t动画常量\tM8\tP2\t-\tG-anim %s\n",names[i],
            i<3?"TRACK_FACTORY；r160 NumberKeyframeTrack 在半帧切换三种插值，独立 .cx 金值与反例":
                "CUBIC_ENDINGS；r160 CubicInterpolant 读取首尾区间，独立 .cx 金值与反例");
        if(added<0 || added>=sizeof data-used) { failed=1; break; }
        used+=added;
        count++;
    }
    if(!failed) {
        failed=write?sy_write_file(path,data,used,0644)!=0:
            sy_read_file(path,&old,&oldSize,2400) || !tx_same((const char *)old,oldSize,data,used);
    }
    printf("ANIMATION_CONSTANT_EVIDENCE rows=%d failed=%d\n",count,failed);
    mm_free(old);
    mm_free(ref);
    mm_free(facts);
    return failed;
}
