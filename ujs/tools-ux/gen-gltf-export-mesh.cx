#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    if(!write && (argc!=2 || !tx_eqz(argv[1],"--check"))) return 2;
    const char *source="ujs/practice/uxe/base/gltf-export-mesh.json.in";
    const char *target="ujs/practice/uxe/base/gltf-export-manifest.ujs";
    unsigned char *input=0,*actual=0;
    int64_t n=0,actual_n=0;
    if(sy_read_file(source,&input,&n,4096) || n<2 || input[n-1]!='\n') { mm_free(input); return 2; }
    n--;
    char output[16384];
    int out=tx_snprintf(output,sizeof output,
        "// Generated by gen-gltf-export-mesh.cx from gltf-export-mesh.json.in.\n"
        "native function gltf_export_word(at:i64,end:i64,word:i64,size:i64) i64 {\n"
        "  if(at<0 || end>6291456 || end-at<size) { return 0-1; }\n"
        "  let i=0;\n"
        "  while(i<size) {\n"
        "    let put=ux_u8_put(at+i,word%%256);\n"
        "    word=word/256;\n"
        "    i=i+1;\n"
        "  }\n"
        "  return at+size;\n"
        "}\n\n"
        "native function gltf_export_manifest(dst:i64,end:i64,values:i64,scratch:i64) i64 {\n");
    int index=0;
    int invalid=0;
    for(int i=0;i<n && !invalid;) {
        if(out<0 || out>=(int)sizeof output-160) { invalid=1; break; }
        if(input[i]=='@') {
            i++;
            int start=i,field=0;
            while(i<n && input[i]>='0' && input[i]<='9' && i-start<2) {
                field=10*field+input[i]-'0'; i++;
            }
            if(i==start || field!=index) { invalid=1; break; }
            out+=tx_snprintf(output+out,sizeof output-out,
                "  dst=json_write_f64(dst,end,ux_f64(values+%d),scratch);\n",8*field);
            index++;
        } else {
            unsigned long long packed=0;
            int size=0;
            while(i<n && input[i]!='@' && size<6) {
                if(input[i]<0x20 || input[i]>0x7e) { invalid=1; break; }
                packed|=(unsigned long long)input[i++]<<(8*size++);
            }
            out+=tx_snprintf(output+out,sizeof output-out,
                "  dst=gltf_export_word(dst,end,%llu,%d);\n",packed,size);
        }
    }
    mm_free(input);
    if(invalid || index!=19 || out<0 || out>=(int)sizeof output-40) return 2;
    out+=tx_snprintf(output+out,sizeof output-out,"  return dst;\n}\n");
    int failed=write?sy_write_file(target,output,out,0644):
        (sy_read_file(target,&actual,&actual_n,sizeof output) || !tx_same(output,out,(char*)actual,actual_n));
    mm_free(actual);
    printf("GLTF_EXPORT_MANIFEST fields=%d failed=%d\n",index,!!failed);
    return !!failed;
}
