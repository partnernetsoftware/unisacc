#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use crypto.sha256
#pragma unisa use text.fmt
#pragma unisa use text.text

enum { MAX_TYPES=500, MAX_METHODS=192, MAX_PARTIAL=200, FAMILY_COUNT=11 };
typedef struct { const char *data; int n; } Word;
typedef struct { Word name,parent,method[MAX_METHODS]; int count; } Api;
typedef struct {
    char **field;
    Word missing[MAX_METHODS];
    int count, known, groups, gates, dependencies;
} Partial;

static Api types[MAX_TYPES];
static Partial tasks[MAX_PARTIAL];
static char *fields[MAX_PARTIAL][9];
static int type_count, task_count;
static char output[220000];
static const char inventory[]="ujs/practice/uxe/three-inventory.tsv";
static const char source[]="ujs/practice/web/game/three.module.js";
static const char destination[]="ujs/plans/ux-three-burndown.tsv";
static const char pin[]="76dea8151bc9352aef3528b4262e249b2604f62543828328db978d060d61a495";
static const char *family[FAMILY_COUNT]={
    "构造","生命周期","序列化","变换","边界","资源装载","拾取","渲染与管线",
    "其他公开接口","语义门","上游签名未展开"
};

static int identifier(int c) {
    return (c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9') || c=='_' || c=='$';
}

static Word name(const char *at,const char *end) {
    Word word={at,0};
    while(at+word.n<end && identifier(at[word.n])) word.n++;
    return word;
}

static int same(Word a,Word b) { return a.n==b.n && a.n && tx_same(a.data,a.n,b.data,b.n); }
static int is(Word a,const char *b) { return tx_same(a.data,a.n,b,tx_len(b,100)); }
static int starts(Word a,const char *b) {
    long n=tx_len(b,100);
    return n<=a.n && tx_same(a.data,n,b,n);
}
static int includes(const Word *words,int count,Word value) {
    for(int i=0;i<count;i++) if(same(words[i],value)) return 1;
    return 0;
}
static int find(Word word) {
    for(int i=0;i<type_count;i++) if(same(types[i].name,word)) return i;
    return -1;
}
static int add(Api *api,Word member) {
    if(!member.n || member.data[0]=='_' || includes(api->method,api->count,member)) return 0;
    if(api->count==MAX_METHODS) return 1;
    api->method[api->count++]=member;
    return 0;
}

// r160 is pinned to the formatted ES module used by the inventory generator.
// Capture class-scope methods and accessor names, plus constructor-installed functions.
static int index_api(const char *text,long size) {
    const char *end=text+size;
    int active=-1;
    int namespace_object=0;
    for(const char *at=text;at<end;) {
        const char *line=at;
        while(at<end && *at!='\n') at++;
        const char *tail=at;
        if(at<end) at++;
        if(tail-line>7 && tx_same(line,6,"class ",6)) {
            if(type_count==MAX_TYPES) return 1;
            Word type=name(line+6,tail);
            if(!type.n || find(type)>=0) return 1;
            active=type_count++;
            namespace_object=0;
            types[active].name=type;
            const char *after=type.data+type.n;
            if(tail-after>=9 && tx_same(after,9," extends ",9))
                types[active].parent=name(after+9,tail);
            continue;
        }
        const char utils[]="const AnimationUtils = {";
        if(tx_same(line,tail-line,utils,sizeof utils-1)) {
            if(type_count==MAX_TYPES || find(name(line+6,tail))>=0) return 1;
            active=type_count++;
            namespace_object=1;
            types[active].name=name(line+6,tail);
            continue;
        }
        if(active<0 || line==tail) continue;
        if(line[0]=='}') { active=-1; continue; }
        if(tail-line>7 && tx_same(line,7,"\t\tthis.",7)) {
            Word member=name(line+7,tail);
            const char *after=member.data+member.n;
            if(tail-after>=11 && tx_same(after,11," = function",11))
                if(add(types+active,member)) return 1;
        }
        if(line[0]!='\t' || line+1==tail || line[1]=='\t') continue;
        const char *start=line+1;
        if(namespace_object) {
            Word member=name(start,tail);
            if(start+member.n<tail && start[member.n]==':' && add(types+active,member)) return 1;
            continue;
        }
        if(tail-start>=7 && tx_same(start,7,"static ",7)) start+=7;
        if(tail-start>=4 && (tx_same(start,4,"get ",4)||tx_same(start,4,"set ",4))) start+=4;
        Word member=name(start,tail);
        const char *after=start+member.n;
        while(after<tail && *after==' ') after++;
        if(after<tail && *after=='(')
            if(add(types+active,member)) return 1;
    }
    return type_count<100;
}

static int listed(const char *list,Word method) {
    for(const char *at=list;*at;) {
        Word member=name(at,at+tx_len(at,12000));
        if(same(member,method)) return 1;
        while(*at && *at!=',') at++;
        if(*at) at++;
    }
    return 0;
}

static int classify(Word method) {
    if(is(method,"constructor")) return 0;
    if(is(method,"copy")||is(method,"clone")||is(method,"dispose")||is(method,"equals")) return 1;
    if(is(method,"toJSON")||is(method,"fromJSON")||is(method,"serialize")) return 2;
    if(starts(method,"applyMatrix")||starts(method,"rotate")||starts(method,"translate")||
       starts(method,"scale")||starts(method,"updateMatrix")||is(method,"lookAt")) return 3;
    if(starts(method,"computeBounding")||starts(method,"intersects")||is(method,"containsPoint")) return 4;
    if(starts(method,"load")||is(method,"parse")||is(method,"parseAsync")) return 5;
    if(is(method,"raycast")||starts(method,"intersectObject")) return 6;
    if(starts(method,"render")||starts(method,"compile")||starts(method,"setRenderTarget")) return 7;
    return 8;
}

static int collect(Partial *task,int mutate) {
    char **f=task->field;
    Word type={f[2],tx_len(f[2],100)};
    int api=find(type), walked=0;
    int proof=tx_contains(f[4],tx_len(f[4],2000),".cx",3);
    if(f[0][0]=='B') {
        task->known=1;
        task->groups=1<<9;
        if(tx_eqz(f[1],"阴影常量")) task->groups|=1<<7;
    } else if(api<0) task->groups=1<<10;
    for(;api>=0;api=find(types[api].parent)) {
        if(++walked>MAX_TYPES) return 1;
        task->known=1;
        for(int i=0;i<types[api].count;i++) {
            Word method=types[api].method[i];
            int found=proof && !mutate && listed(f[7],method);
            if(proof && !mutate && is(method,"constructor"))
                found|=tx_contains(f[7],tx_len(f[7],12000),"generate",8) ||
                       tx_contains(f[7],tx_len(f[7],12000),"init",4);
            if(found || includes(task->missing,task->count,method)) continue;
            if(task->count==MAX_METHODS) return 1;
            task->missing[task->count++]=method;
            task->groups|=1<<classify(method);
            if(is(types[api].name,"Object3D")) task->dependencies|=1<<2;
        }
    }
    // A partial entry still needs semantic closure even when all names have coverage.
    if(task->known) task->groups|=1<<9;
    if(task->groups&(1<<5)) task->dependencies|=1<<9;
    if(task->groups&(1<<6)) task->dependencies|=1<<10;
    if(task->groups&(1<<7)) task->dependencies|=1<<4;
    for(int i=1;i<=12;i++) {
        char own[8];
        tx_snprintf(own,sizeof own,"M%d",i);
        if(tx_eqz(f[6],own)) task->dependencies&=~(1<<i);
    }
    for(int i=0;i<FAMILY_COUNT;i++) if(task->groups&(1<<i)) task->gates++;
    return 0;
}

static int parse_inventory(char *text,int mutate) {
    char *at=text;
    while(*at && *at!='\n') at++;
    if(!*at) return 1;
    at++;
    while(*at) {
        char *row[9];
        for(int i=0;i<9;i++) {
            row[i]=at;
            while(*at && *at!='\n' && *at!='\t') at++;
            if(*at!=(i==8?'\n':'\t')) return 1;
            *at++=0;
        }
        if(!tx_eqz(row[3],"部分")) continue;
        if(task_count==MAX_PARTIAL) return 1;
        Partial *task=tasks+task_count;
        task->field=fields[task_count++];
        for(int i=0;i<9;i++) task->field[i]=row[i];
        if(collect(task,mutate)) return 1;
    }
    return !task_count;
}

static int before(const Partial *a,const Partial *b) {
    if(a->known!=b->known) return a->known>b->known;
    if(a->gates!=b->gates) return a->gates<b->gates;
    if((a->dependencies!=0)!=(b->dependencies!=0)) return !a->dependencies;
    return a->count<b->count;
}

static int generate(void) {
    int sorted[MAX_PARTIAL];
    for(int i=0;i<task_count;i++) {
        int at=i;
        while(at && before(tasks+i,tasks+sorted[at-1])) { sorted[at]=sorted[at-1]; at--; }
        sorted[at]=i;
    }
    int used=tx_snprintf(output,sizeof output,
        "rank\tlane\tmilestone\tname\tmissing_families\tmissing_methods\testimated_gates\tdependencies\tcurrent_gate\n");
    for(int i=0;i<task_count;i++) {
        const Partial *task=tasks+sorted[i];
        char **f=task->field;
        char groups[320],methods[7000],deps[80],gates[20];
        int g=0,m=0,d=0;
        for(int k=0;k<FAMILY_COUNT;k++) if(task->groups&(1<<k))
            g+=tx_snprintf(groups+g,sizeof groups-g,"%s%s",g?",":"",family[k]);
        for(int k=0;k<task->count;k++)
            m+=tx_snprintf(methods+m,sizeof methods-m,"%s%.*s",m?",":"",
                task->missing[k].n,task->missing[k].data);
        for(int k=1;k<=12;k++) if(task->dependencies&(1<<k)) {
            char dep[8];
            tx_snprintf(dep,sizeof dep,"M%d",k);
            if(!tx_eqz(f[6],dep)) d+=tx_snprintf(deps+d,sizeof deps-d,"%s%s",d?",":"",dep);
        }
        tx_snprintf(gates,sizeof gates,task->known?"%d":"未估",task->gates);
        int n=tx_snprintf(output+used,sizeof output-used,"%d\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
            i+1,f[0],f[6],f[2],g?groups:"-",m?methods:"-",gates,d?deps:"-",f[4]);
        if(n<0 || n>=(int)sizeof output-used) return -1;
        used+=n;
    }
    return used;
}

int main(int argc,char **argv) {
    int write=argc==2 && tx_eqz(argv[1],"--write");
    int check=(argc==2 || argc==3) && tx_eqz(argv[1],"--check");
    int mutate=argc==3 && check && tx_eqz(argv[2],"--mutate");
    if((!write && !check) || (argc==3 && !mutate)) return 2;
    unsigned char *module=0,*tsv=0,*saved=0;
    int64_t module_n=0,tsv_n=0,saved_n=0;
    char sha[65];
    int failed=sy_read_file(source,&module,&module_n,3000000) ||
        cs_sha256_hex(module,module_n,sha) || !tx_eqz(sha,pin) ||
        sy_read_file(inventory,&tsv,&tsv_n,300000) || index_api((const char *)module,module_n) ||
        parse_inventory((char *)tsv,mutate);
    int bytes=failed?-1:generate();
    if(bytes<0) failed=1;
    else if(write) failed=sy_write_file(destination,output,bytes,0644)!=0;
    else failed=sy_read_file(destination,&saved,&saved_n,sizeof output) || saved_n!=bytes ||
        !tx_same((char *)saved,saved_n,output,bytes);
    int unresolved=0;
    for(int i=0;i<task_count;i++) unresolved+=!tasks[i].known;
    printf("THREE_BURNDOWN rows=%d classes=%d unresolved=%d failed=%d\n",task_count,type_count,unresolved,failed!=0);
    mm_free(module); mm_free(tsv); mm_free(saved);
    return failed!=0;
}
