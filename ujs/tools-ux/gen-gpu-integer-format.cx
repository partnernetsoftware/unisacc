#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    const int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char *target="ujs/practice/uxe/base/gpu-integer-format-generated.ujs";
    unsigned char *facts=0,*upstream=0,*stored=0;
    int64_t length=0,reference=0,old=0;
    int failed=sy_read_file("ujs/practice/uxe/base/gpu-integer-format.tsv",&facts,&length,1000) ||
        sy_read_file("ujs/practice/web/game/three.module.js",&upstream,&reference,4000000);
    const char header[]="name\tvalue\tchannels\n";
    if(!failed) failed=length<(int64_t)sizeof header || !tx_same((const char *)facts,sizeof header-1,header,sizeof header-1);
    char output[1500];
    int size=tx_snprintf(output,sizeof output,
        "// Generated by gen-gpu-integer-format.cx.\n"
        "native function GpuIntTexture_component(format:i64,image:i64,width:i64,height:i64,"
        "u:f64,v:f64,component:i64) i64 {\n");
    int count=0,mask=0;
    const char *row=failed?0:(const char *)facts+sizeof header-1;
    const char *limit=failed?0:(const char *)facts+length;
    while(!failed && row<limit) {
        const char *tab=row;
        while(tab<limit && *tab!='\t' && *tab!='\n') tab++;
        if(tab==limit || *tab!='\t' || tab-row>40) { failed=1; break; }
        char *end=0;
        long value=tx_strtol(tab+1,&end,10);
        if(end==tab+1 || end>=limit || *end!='\t' || value<1 || value>65535) { failed=1; break; }
        char name[72],decl[100];
        tx_snprintf(name,sizeof name,"%.*s",(int)(tab-row),row);
        int expected=tx_eqz(name,"RedIntegerFormat")?1:tx_eqz(name,"RGIntegerFormat")?2:tx_eqz(name,"RGBAIntegerFormat")?4:0;
        const char *start=end+1;
        const long channels=tx_strtol(start,&end,10);
        int n=tx_snprintf(decl,sizeof decl,"const %s = %ld;",name,value);
        if(!expected || channels!=expected || (mask&expected) || end>=limit || *end!='\n' ||
           !tx_contains((const char *)upstream,reference,decl,n)) { failed=1; break; }
        mask|=expected;
        n=tx_snprintf(output+size,sizeof output-size,
            "  if(format==%ld) { return gpu_integer_component(%ld,image,width,height,u,v,component); } // %s\n",
            value,channels+(mutate && count==0),name);
        if(n<0 || n>=(int)sizeof output-size) { failed=1; break; }
        size+=n;
        count++;
        row=end+1;
    }
    if(!failed) {
        size+=tx_snprintf(output+size,sizeof output-size,"  return 0-2;\n}\n");
        failed=mask!=7 || count!=3 || (write?sy_write_file(target,output,size,0644)!=0:
            sy_read_file(target,&stored,&old,sizeof output) || !tx_same((const char *)stored,old,output,size));
    }
    mm_free(facts); mm_free(upstream); mm_free(stored);
    printf("GPU_INTEGER_FORMAT formats=%d failed=%d\n",count,failed);
    return failed;
}
