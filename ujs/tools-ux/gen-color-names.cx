#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

enum { named_count=148 };
static const char facts[]="ujs/practice/uxe/base/color-names.tsv";
static const char product[]="ujs/practice/uxe/base/color-names.ujs";

static int hex_digit(int c) {
    if(c>='0' && c<='9') return c-'0';
    if(c>='a' && c<='f') return c-'a'+10;
    return -1;
}

int main(int argc,char **argv) {
    int write=argc==2 && tx_eqz(argv[1],"--write");
    if(!write && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    unsigned char *input=0;
    int64_t bytes=0;
    if(sy_read_file(facts,&input,&bytes,8192)) return 1;
    const char *at=(const char *)input;
    const char *end=at+bytes;
    int64_t words[3][named_count];
    char previous[21]={0};
    int count=0,failed=0,previous_len=0;
    if(bytes<9 || !tx_prefixz(at,"name\trgb\n",9)) failed=1;
    if(!failed) at+=9;
    while(!failed && at<end && count<named_count) {
        char name[21];
        int32_t rgb=0;
        int64_t low=0,high=0;
        int len=0;
        while(at<end && *at>='a' && *at<='z' && len<20) {
            int c=*at-'a'+1;
            if(len<10) low=low*32+c;
            else high=high*32+c;
            name[len++]=*at++;
        }
        name[len]=0;
        if(!len || end-at<8 || *at++!='\t' || tx_cmp(previous,previous_len,name,len)>=0) { failed=1; break; }
        for(int i=0;i<6;i++) {
            int d=hex_digit(*at++);
            if(d<0) failed=1;
            rgb=rgb*16+d;
        }
        if(*at++!='\n') failed=1;
        for(int i=0;i<=len;i++) previous[i]=name[i];
        previous_len=len;
        words[0][count]=low;
        words[1][count]=high;
        words[2][count]=rgb;
        count++;
    }
    if(at!=end || count!=named_count) failed=1;
    mm_free(input);
    char out[12000];
    int used=tx_snprintf(out,sizeof out,
        "// Generated by gen-color-names.cx from the CSS opaque named color facts.\n"
        "native function Color_lookupName(c_name_a:i64,c_name_b:i64) i64 {\n");
    const char *array_names[]={"c_name_low","c_name_high","c_name_rgb"};
    for(int col=0;!failed && col<3;col++) {
        int n=tx_snprintf(out+used,sizeof out-used,"  let %s=[",array_names[col]);
        if(n<0 || n>=(int)sizeof out-used) { failed=1; break; }
        used+=n;
        for(int i=0;i<count;i++) {
            n=tx_snprintf(out+used,sizeof out-used,"%s%lld",i==0?"":(i%8==0?",\n      ":","),(long long)words[col][i]);
            if(n<0 || n>=(int)sizeof out-used) { failed=1; break; }
            used+=n;
        }
        if(!failed) {
            n=tx_snprintf(out+used,sizeof out-used,"];\n");
            if(n<0 || n>=(int)sizeof out-used) failed=1;
            else used+=n;
        }
    }
    if(!failed) {
        int n=tx_snprintf(out+used,sizeof out-used,
            "  let c_name_index=0;\n"
            "  while(c_name_index<148) {\n"
            "    if(c_name_low[c_name_index]==c_name_a && c_name_high[c_name_index]==c_name_b) {\n"
            "      return c_name_rgb[c_name_index];\n"
            "    }\n"
            "    c_name_index=c_name_index+1;\n"
            "  }\n"
            "  return 0-1;\n"
            "}\n");
        if(n<0 || n>=(int)sizeof out-used) failed=1;
        else used+=n;
    }
    if(!failed && write) failed=sy_write_file(product,out,used,0644)!=0;
    if(!failed && !write) {
        unsigned char *existing=0;
        int64_t size=0;
        failed=sy_read_file(product,&existing,&size,sizeof out) || size!=used ||
            !tx_same((const char *)existing,size,out,used);
        mm_free(existing);
    }
    printf("GEN_COLOR_NAMES rows=%d failed=%d\n",count,failed);
    return failed;
}
