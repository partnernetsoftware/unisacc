#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

static int packed_tag(const char *facts,int64_t bytes,const char *ref,int64_t ref_bytes,const char *name,int64_t *value) {
    char key[64],decl[96];
    const int n=tx_snprintf(key,sizeof key,"\nB\t%s\t",name);
    const long at=tx_find(facts,bytes,key,n);
    if(at<0 || tx_find(facts+at+n,bytes-at-n,key,n)>=0) return 1;
    const char *start=facts+at+n;
    const long count=tx_find(start,bytes-(start-facts),"\t",1);
    if(count<1 || count>6) return 1;
    int len=(int)count;
    if(len==2 && tx_same(start,2,"''",2)) len=0;
    const int d=tx_snprintf(decl,sizeof decl,"const %s = '%.*s';",name,len,start);
    int64_t pack=0,scale=1;
    for(int i=0;i<len;i++) {
        const int c=(unsigned char)start[i];
        if(!((c>='a' && c<='z') || (c>='0' && c<='9'))) return 1;
        pack+=scale*c;
        scale*=256;
    }
    if(!tx_contains(ref,ref_bytes,decl,d)) return 1;
    *value=pack;
    return 0;
}

static int publish(const char *path,const char *bytes,int count,int write) {
    if(write) return sy_write_file(path,bytes,count,0644)!=0;
    unsigned char *old=0;
    int64_t size=0;
    int bad=sy_read_file(path,&old,&size,8192) || !tx_same((const char *)old,size,bytes,count);
    mm_free(old);
    return bad;
}

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    const int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    unsigned char *facts=0,*ref=0;
    int64_t bytes=0,ref_bytes=0;
    int bad=sy_read_file("ujs/plans/ux-three-b-semantic-facts.tsv",&facts,&bytes,15000) ||
        sy_read_file("ujs/practice/web/game/three.module.js",&ref,&ref_bytes,4000000);
    const char *names[]={"NoColorSpace","LinearTransfer","SRGBTransfer","Rec709Primaries","P3Primaries"};
    int64_t tags[5]={0};
    for(int i=0;!bad && i<5;i++) bad=packed_tag((const char *)facts,bytes,(const char *)ref,ref_bytes,names[i],tags+i);
    char source[3200];
    const int n=tx_snprintf(source,sizeof source,
        "// Generated by gen-gpu-color-tags.cx.\n"
        "native function GpuColor_fromColorSpace(color:i64,tag:i64,length:i64,target:i64) i64 {\n"
        "  if(!gpu_color_record_valid(color) || tag<0 || tag>6291456 || target<1 || target>4) { return 0-1; }\n"
        "  if(length==%lld) { return ColorManagement_convert(1,color,0,target); } // NoColorSpace\n"
        "  let space=GpuColor_outputSpaceTag(tag,length);\n"
        "  if(space<0) { return space; }\n"
        "  return ColorManagement_convert(1,color,space,target);\n"
        "}\n"
        "native function GpuColor_decodeTransfer(tag:i64,length:i64,value:f64) f64 {\n"
        "  let key=gpu_color_tag(tag,length);\n"
        "  if(key==%lld) { return value; } // LinearTransfer\n"
        "  if(key==%lld) { return Color_srgbToLinear(value); } // SRGBTransfer\n"
        "  return 0.0/0.0;\n"
        "}\n"
        "native function gpu_color_primaries(tag:i64,length:i64) i64 {\n"
        "  let key=gpu_color_tag(tag,length);\n"
        "  if(key==%lld) { return 1; } // Rec709Primaries\n"
        "  if(key==%lld) { return 3; } // P3Primaries\n"
        "  return 0-1;\n"
        "}\n"
        "native function GpuColor_convertPrimaries(color:i64,src:i64,srcLen:i64,dst:i64,dstLen:i64) i64 {\n"
        "  if(!gpu_color_record_valid(color)) { return 0-1; }\n"
        "  let from=gpu_color_primaries(src,srcLen);\n"
        "  let to=gpu_color_primaries(dst,dstLen);\n"
        "  if(from<0 || to<0) { return 0-2; }\n"
        "  return ColorManagement_convert(1,color,from,to);\n"
        "}\n",(long long)tags[0],(long long)tags[mutate?2:1],(long long)tags[2],
        (long long)tags[3],(long long)tags[4]);
    const char notes[]="name\tstate\tcategory\tmilestone\tpriority\tmethods\tevidence\n"
        "NoColorSpace,LinearTransfer,SRGBTransfer,Rec709Primaries,P3Primaries\t已有\t渲染常量\tM5\tP2\t-\t"
        "G-struct GPU_COLOR_TAGS；空色域、传递曲线与线性原色矩阵的实际样值，r160 和独立金值，逐语义篡改\n";
    bad=bad || tags[0]!=0 || tags[1]==tags[2] || tags[3]==tags[4] || n<0 || n>=sizeof source ||
        publish("ujs/practice/uxe/base/gpu-color-tags-generated.ujs",source,n,write) ||
        publish("ujs/practice/uxe/base/gpu-color-tags-annotations.tsv",notes,sizeof notes-1,write);
    printf("GPU_COLOR_TAGS generated=5 failed=%d\n",bad);
    mm_free(facts); mm_free(ref);
    return bad;
}
