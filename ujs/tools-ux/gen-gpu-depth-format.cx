#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

static int value(const char *blob,int64_t bytes,const char *prefix,char separator) {
    const long n=tx_len(prefix,96);
    const long at=tx_find(blob,bytes,prefix,n);
    if(at<0) return -1;
    const char *start=blob+at+n;
    char *end=0;
    const long number=tx_strtol(start,&end,10);
    return end>start && end<blob+bytes && *end==separator && number>=1 && number<65536?(int)number:-1;
}

static int publish(const char *path,const char *data,int n,int write) {
    if(write) return sy_write_file(path,data,n,0644)!=0;
    unsigned char *previous=0;
    int64_t size=0;
    int bad=sy_read_file(path,&previous,&size,4096) || !tx_same((const char *)previous,size,data,n);
    mm_free(previous);
    return bad;
}

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    const int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    unsigned char *facts=0,*r160=0;
    int64_t size=0,ref_size=0;
    int bad=sy_read_file("ujs/plans/ux-three-b-semantic-facts.tsv",&facts,&size,16000) ||
        sy_read_file("ujs/practice/web/game/three.module.js",&r160,&ref_size,4000000);
    int plain=bad?-1:value((const char *)facts,size,"\nB\tDepthFormat\t",'\t');
    int packed=bad?-1:value((const char *)facts,size,"\nB\tDepthStencilFormat\t",'\t');
    int narrow=bad?-1:value((const char *)r160,ref_size,"\nconst UnsignedShortType = ",';');
    int wide=bad?-1:value((const char *)r160,ref_size,"\nconst UnsignedInt248Type = ",';');
    bad=bad || plain<0 || packed<0 || narrow<0 || wide<0 || plain==packed || narrow==wide ||
        plain!=value((const char *)r160,ref_size,"\nconst DepthFormat = ",';') ||
        packed!=value((const char *)r160,ref_size,"\nconst DepthStencilFormat = ",';');
    char data[1600];
    const int n=tx_snprintf(data,sizeof data,
        "// Generated by gen-gpu-depth-format.cx.\n"
        "native function GpuDepthFormat_sample(at:i64,format:i64,kind:i64) f64 {\n"
        "  if(format==%d && kind==%d) { return gpu_depth16(at); }\n"
        "  if(format==%d && kind==%d) { return gpu_depth24(at); }\n"
        "  return 0.0-1.0;\n}\n"
        "native function GpuDepthFormat_stencil(at:i64,format:i64,kind:i64) i64 {\n"
        "  if(format!=%d || kind!=%d) { return 0-1; }\n"
        "  return gpu_stencil8(at);\n}\n",plain,narrow,packed,wide,mutate?plain:packed,wide);
    const char notes[]="name\tstate\tcategory\tmilestone\tpriority\tmethods\tevidence\n"
        "DepthFormat,DepthStencilFormat\t已有\t渲染常量\tM4\tP2\t-\t"
        "G-struct GPU_DEPTH_FORMAT；Wasm 两种位布局读回，r160 DepthTexture WebGL2 真实深度和模板对照及双篡改\n";
    bad=bad || n<0 || n>=sizeof data ||
        publish("ujs/practice/uxe/base/gpu-depth-format-generated.ujs",data,n,write) ||
        publish("ujs/practice/uxe/base/gpu-depth-format-annotations.tsv",notes,sizeof notes-1,write);
    printf("GPU_DEPTH_FORMAT generated=2 failed=%d\n",bad);
    mm_free(facts); mm_free(r160);
    return bad;
}
