#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use text.fmt
#pragma unisa use text.text

static const char inventory[]="ujs/practice/uxe/three-inventory.tsv";
static const char source[]="ujs/practice/web/game/three.module.js";
static const char facts[]="ujs/practice/uxe/three-r160-annotations.tsv";
static const char addon[]="ujs/practice/uxe/three-r160-addons.tsv";
static int failed,asserts;
static int includes(const char *out,size_t n,const char *word) {
    return tx_contains(out,n,word,tx_len(word,256));
}

static void check(int ok,const char *name) {
    printf("%s\t%s\n",ok?"PASS":"FAIL",name);
    asserts++;
    if(!ok) failed++;
}

static int run_check(const char *unisacc,const char *generator,int expected,int baseline) {
    char *cmd[]={"sh",(char *)unisacc,(char *)generator,"--","--check",0};
    char *out=0;
    size_t n=0;
    int rc=cx_runv_timeout(cmd,12,&out,&n);
    int ok=rc==expected && out && includes(out,n,expected?"failed=1":"rows=446 failed=0");
    if(!expected && baseline) {
        const char *a="lane=A total=215 eligible=214 ready=75 partial=124 excluded=1 percent=35.05";
        const char *b="lane=B total=201 eligible=200 ready=133 partial=6 excluded=1 percent=66.50";
        const char *c="lane=C total=30 eligible=30 ready=0 partial=13";
        ok=ok && includes(out,n,a) && includes(out,n,b) && includes(out,n,c) &&
            includes(out,n,"milestone=M1 rows=21 ready=21");
    }
    if(!ok) printf("CHECK_THREE_INVENTORY expected_rc=%d actual_rc=%d output=%.*s\n",expected,rc,(int)n,out?out:"");
    mm_free(out);
    return ok;
}

static int flip(const char *path) {
    unsigned char *raw=0;
    int64_t size=0;
    if(sy_read_file(path,&raw,&size,4000000) || size<2) { mm_free(raw); return 1; }
    raw[0]^=1;
    int rc=sy_write_file(path,raw,size,0600)!=0;
    mm_free(raw);
    return rc;
}

static int mutate_family(void) {
    static const char names[]="QuadraticBezierCurve,QuadraticBezierCurve3,CubicBezierCurve,CubicBezierCurve3\t";
    unsigned char *raw=0;
    int64_t size=0;
    if(sy_read_file(facts,&raw,&size,64000)) return 1;
    long offset=tx_find((const char *)raw,size,names,sizeof names-1);
    if(offset<0) { mm_free(raw); return 1; }
    raw[offset+sizeof names-3]='X';
    int rc=sy_write_file(facts,raw,size,0600)!=0;
    mm_free(raw);
    return rc;
}

