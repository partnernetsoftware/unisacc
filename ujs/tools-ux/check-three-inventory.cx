int main(void) {
    char root[256],cwd[512],unisacc[600],generator[600],original[1024];
    if(!getcwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-r160-inventory-",root,sizeof root)) return 2;
    tx_snprintf(unisacc,sizeof unisacc,"%s/unisacc.com",cwd);
    tx_snprintf(generator,sizeof generator,"%s/ujs/tools-ux/gen-three-inventory.cx",cwd);
    if(!install(cwd,root) && !sy_chdir(root)) {
        check(run_check(unisacc,generator,0,1),"独立统计");
        check(!mutate_family() && run_check(unisacc,generator,1,0),"家族中未知的导出名拒绝");
        tx_snprintf(original,sizeof original,"%s/%s",cwd,facts);
        check(!sy_copy(original,facts,0600) && run_check(unisacc,generator,0,1),"家族事实恢复");
        check(!flip(inventory) && run_check(unisacc,generator,1,0),"磁盘表篡改");
        tx_snprintf(original,sizeof original,"%s/%s",cwd,inventory);
        check(!sy_copy(original,inventory,0600) && run_check(unisacc,generator,0,1),"表恢复");
        check(!sy_unlink("ujs/tests/vector2-math.cx") && run_check(unisacc,generator,1,0),"已有项缺金值门");
        tx_snprintf(original,sizeof original,"%s/ujs/tests/vector2-math.cx",cwd);
        check(!sy_copy(original,"ujs/tests/vector2-math.cx",0600) && run_check(unisacc,generator,0,1),"金值门恢复");
        check(!sy_unlink("ujs/practice/uxe/test/gpu-output-r160.html") &&
            run_check(unisacc,generator,1,0),"输出色域缺原站对照");
        tx_snprintf(original,sizeof original,"%s/ujs/practice/uxe/test/gpu-output-r160.html",cwd);
        check(!sy_copy(original,"ujs/practice/uxe/test/gpu-output-r160.html",0600) &&
            run_check(unisacc,generator,0,1),"输出色域对照恢复");
        check(!sy_unlink("ujs/practice/uxe/base/control-constants.ujs") &&
            run_check(unisacc,generator,1,0),"控制常量缺生成接口");
        tx_snprintf(original,sizeof original,"%s/ujs/practice/uxe/base/control-constants.ujs",cwd);
        check(!sy_copy(original,"ujs/practice/uxe/base/control-constants.ujs",0600) &&
            run_check(unisacc,generator,0,1),"控制常量接口恢复");
        const char *lifecycle="ujs/tests/linecurve3-lifecycle-struct.cx";
        check(!sy_unlink(lifecycle) && run_check(unisacc,generator,1,0),"直线生命周期缺验收");
        tx_snprintf(original,sizeof original,"%s/%s",cwd,lifecycle);
        check(!sy_copy(original,lifecycle,0600) && run_check(unisacc,generator,0,1),"直线生命周期验收恢复");
        check(!flip(source) && run_check(unisacc,generator,1,0),"上游源篡改");
    } else failed++;
    if(sy_chdir(cwd)) return 2;
    char *clean[]={"rm","-rf","--",root,0};
    char *out=0;
    size_t n=0;
    if(cx_runv_timeout(clean,5,&out,&n)) failed++;
    mm_free(out);
    printf("CHECK_THREE_INVENTORY asserts=%d failed=%d\n",asserts,failed);
    return failed || asserts!=14;
}
