#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use text.fmt
#pragma unisa use text.text

static const char inventory[]="ujs/practice/uxe/three-inventory.tsv";
static const char source[]="ujs/practice/web/game/three.module.js";
static const char facts[]="ujs/practice/uxe/three-r160-annotations.tsv";
static const char addon[]="ujs/practice/uxe/three-r160-addons.tsv";
static int failed,asserts;
static int includes(const char *out,size_t n,const char *word) {
    return tx_contains(out,n,word,tx_len(word,256));
}

static void check(int ok,const char *name) {
    printf("%s\t%s\n",ok?"PASS":"FAIL",name);
    asserts++;
    if(!ok) failed++;
}

static int run_check(const char *unisacc,const char *generator,int expected,int baseline) {
    char *cmd[]={"sh",(char *)unisacc,(char *)generator,"--","--check",0};
    char *out=0;
    size_t n=0;
    int rc=cx_runv_timeout(cmd,12,&out,&n);
    int ok=rc==expected && out && includes(out,n,expected?"failed=1":"rows=446 failed=0");
    if(!expected && baseline) {
        const char *a="lane=A total=215 eligible=214 ready=25 partial=13 excluded=1 percent=11.68";
        const char *b="lane=B total=201 eligible=200 ready=20 partial=0 excluded=1 percent=10.00";
        const char *c="lane=C total=30 eligible=30 ready=0";
        ok=ok && includes(out,n,a) && includes(out,n,b) && includes(out,n,c) &&
            includes(out,n,"milestone=M1 rows=21 ready=21");
    }
    mm_free(out);
    return ok;
}

static int flip(const char *path) {
    unsigned char *raw=0;
    int64_t size=0;
    if(sy_read_file(path,&raw,&size,4000000) || size<2) { mm_free(raw); return 1; }
    raw[0]^=1;
    int rc=sy_write_file(path,raw,size,0600)!=0;
    mm_free(raw);
    return rc;
}

static int install(const char *cwd,const char *root) {
    const char *dirs[]={"ujs/practice/uxe/base","ujs/practice/web/game","ujs/tests","ujs/practice/uxe/test"};
    const char *paths[]={inventory,source,facts,addon,"ujs/practice/uxe/base/vector2.ujs",
        "ujs/tests/vector2-math.cx","ujs/practice/uxe/test/vector2-r160.html",
        "ujs/practice/uxe/base/vector3.ujs","ujs/tests/vector3-math.cx","ujs/practice/uxe/test/vector3-r160.html",
        "ujs/practice/uxe/base/vector4.ujs","ujs/tests/vector4-math.cx","ujs/practice/uxe/test/vector4-r160.html",
        "ujs/practice/uxe/base/matrix3.ujs","ujs/tests/matrix3-math.cx","ujs/practice/uxe/test/matrix3-r160.html",
        "ujs/practice/uxe/base/matrix4.ujs","ujs/tests/matrix4-math.cx","ujs/practice/uxe/test/matrix4-r160.html",
        "ujs/practice/uxe/base/quaternion.ujs","ujs/tests/quaternion-math.cx","ujs/practice/uxe/test/quaternion-r160.html",
        "ujs/practice/uxe/base/euler.ujs","ujs/tests/euler-math.cx","ujs/practice/uxe/test/euler-r160.html",
        "ujs/practice/uxe/base/color.ujs","ujs/tests/color-math.cx","ujs/practice/uxe/test/color-r160.html",
        "ujs/practice/uxe/base/color-style.ujs","ujs/tests/color-style-math.cx","ujs/practice/uxe/test/color-style-r160.html",
        "ujs/practice/uxe/base/colormanagement.ujs","ujs/tests/colormanagement-math.cx","ujs/practice/uxe/test/colormanagement-r160.html",
        "ujs/practice/uxe/base/box2.ujs","ujs/tests/box2-math.cx","ujs/practice/uxe/test/box2-r160.html",
        "ujs/practice/uxe/base/box3.ujs","ujs/tests/box3-math.cx","ujs/practice/uxe/test/box3-r160.html",
        "ujs/tests/box3-scene-math.cx","ujs/practice/uxe/test/box3-scene-r160.html",
        "ujs/practice/uxe/base/sphere.ujs","ujs/tests/sphere-math.cx","ujs/practice/uxe/test/sphere-r160.html",
        "ujs/practice/uxe/base/plane.ujs","ujs/tests/plane-math.cx","ujs/practice/uxe/test/plane-r160.html",
        "ujs/practice/uxe/base/ray.ujs","ujs/tests/ray-math.cx","ujs/practice/uxe/test/ray-r160.html",
        "ujs/practice/uxe/base/triangle.ujs","ujs/tests/triangle-math.cx","ujs/practice/uxe/test/triangle-r160.html",
        "ujs/practice/uxe/base/frustum.ujs","ujs/tests/frustum-math.cx","ujs/practice/uxe/test/frustum-r160.html",
        "ujs/tests/frustum-scene-math.cx","ujs/practice/uxe/test/frustum-scene-r160.html",
        "ujs/practice/uxe/base/line3.ujs","ujs/tests/line3-math.cx","ujs/practice/uxe/test/line3-r160.html",
        "ujs/practice/uxe/base/cylindrical.ujs","ujs/tests/cylindrical-math.cx","ujs/practice/uxe/test/cylindrical-r160.html",
        "ujs/practice/uxe/base/spherical.ujs","ujs/tests/spherical-math.cx","ujs/practice/uxe/test/spherical-r160.html",
        "ujs/practice/uxe/base/sphericalharmonics3.ujs","ujs/tests/sphericalharmonics3-math.cx","ujs/practice/uxe/test/sphericalharmonics3-r160.html",
        "ujs/practice/uxe/base/mathutils.ujs","ujs/tests/mathutils-math.cx","ujs/practice/uxe/test/mathutils-r160.html",
        "ujs/practice/uxe/base/layers.ujs","ujs/tests/layers-struct.cx","ujs/practice/uxe/test/layers-r160.html",
        "ujs/practice/uxe/base/clock.ujs","ujs/tests/clock-struct.cx","ujs/practice/uxe/test/clock-r160.html",
        "ujs/practice/uxe/base/datautils.ujs","ujs/tests/datautils-struct.cx","ujs/practice/uxe/test/datautils-r160.html",
        "ujs/practice/uxe/base/bufferconstants.ujs","ujs/tests/bufferconstants-struct.cx","ujs/practice/uxe/test/bufferconstants-r160.html",
        "ujs/practice/uxe/base/cache.ujs","ujs/tests/cache-struct.cx","ujs/practice/uxe/test/cache-r160.html"};
    const char *links[]={"cx","ext","cxroot.tsv"};
    char from[1024],to[1024];
    for(int i=0;i<(int)(sizeof dirs/sizeof dirs[0]);i++) {
        tx_snprintf(to,sizeof to,"%s/%s",root,dirs[i]);
        if(sy_mkdir_all(to,0700)) return 1;
    }
    for(int i=0;i<(int)(sizeof paths/sizeof paths[0]);i++) {
        tx_snprintf(to,sizeof to,"%s/%s",root,paths[i]);
        if(sy_copy(paths[i],to,0600)) return 1;
    }
    for(int i=0;i<3;i++) {
        tx_snprintf(from,sizeof from,"%s/%s",cwd,links[i]);
        tx_snprintf(to,sizeof to,"%s/%s",root,links[i]);
        if(sy_symlink(from,to)) return 1;
    }
    return 0;
}

int main(void) {
    char root[256],cwd[512],unisacc[600],generator[600],original[1024];
    if(!getcwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-r160-inventory-",root,sizeof root)) return 2;
    tx_snprintf(unisacc,sizeof unisacc,"%s/unisacc.com",cwd);
    tx_snprintf(generator,sizeof generator,"%s/ujs/tools-ux/gen-three-inventory.cx",cwd);
    if(!install(cwd,root) && !sy_chdir(root)) {
        check(run_check(unisacc,generator,0,1),"独立统计");
        check(!flip(inventory) && run_check(unisacc,generator,1,0),"磁盘表篡改");
        tx_snprintf(original,sizeof original,"%s/%s",cwd,inventory);
        check(!sy_copy(original,inventory,0600) && run_check(unisacc,generator,0,1),"表恢复");
        check(!sy_unlink("ujs/tests/vector2-math.cx") && run_check(unisacc,generator,1,0),"已有项缺金值门");
        tx_snprintf(original,sizeof original,"%s/ujs/tests/vector2-math.cx",cwd);
        check(!sy_copy(original,"ujs/tests/vector2-math.cx",0600) && run_check(unisacc,generator,0,1),"金值门恢复");
        check(!flip(source) && run_check(unisacc,generator,1,0),"上游源篡改");
    } else failed++;
    if(sy_chdir(cwd)) return 2;
    char *clean[]={"rm","-rf","--",root,0};
    char *out=0;
    size_t n=0;
    if(cx_runv_timeout(clean,5,&out,&n)) failed++;
    mm_free(out);
    printf("CHECK_THREE_INVENTORY asserts=%d failed=%d\n",asserts,failed);
    return failed || asserts!=6;
}
