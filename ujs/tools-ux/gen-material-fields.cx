#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

static int pack(const char *text,int size,uint64_t *word) {
    *word=0;
    if(size<0 || size>8) return 1;
    for(int i=0;i<size;i++) {
        unsigned char c=text[i];
        if(!((c>='a' && c<='z') || (c>='A' && c<='Z'))) return 1;
        *word|=(uint64_t)c<<(8*i);
    }
    return 0;
}

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    const int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char *dest="ujs/practice/uxe/base/material-fields-generated.ujs";
    unsigned char *raw=0,*old=0;
    int64_t rawSize=0,oldSize=0;
    if(sy_read_file("ujs/practice/uxe/base/material-fields.tsv",&raw,&rawSize,4096)) return 2;
    const char header[]="field\tdefault\tmax\tjson\n";
    char setters[7600],json[7600],readers[7600],result[22000];
    int read=tx_snprintf(readers,sizeof readers,
        "native function material_read_entries(at:i64,end:i64,material:i64,scratch:i64) i64 {\n"
        "  if(!material_span(material) || at<0 || at>=end || end>6291456 ||\n"
        "     scratch<0 || scratch%%8!=0 || scratch>6291456-216 ||\n"
        "     (scratch<end && at<scratch+216) ||\n"
        "     (material<end && at<material+Material.size) ||\n"
        "     (scratch<material+Material.size && material<scratch+216)) { return 0-1; }\n"
        "  let start=json_space(at,end);\n"
        "  if(start>=end || ux_u8(start)!=123) { return 0-1; }\n"
        "  let finish=json_value_end(start,end);\n"
        "  if(finish<0 || json_space(finish,end)!=end) { return 0-1; }\n"
        "  let row=scratch+24;\n"
        "  let value=0.0;\n"
        "  let stored=0;\n");
    int set=tx_snprintf(setters,sizeof setters,
        "// Generated by gen-material-fields.cx.\n"
        "native function material_field(at:i64,key:i64,value:f64,apply:i64) i64 {\n");
    int out=tx_snprintf(json,sizeof json,
        "native function Material_writeFields(at:i64,end:i64,material:i64,scratch:i64) i64 {\n"
        "  if(!material_span(material) || at<0 || end<at || end>6291456 ||\n"
        "     (at<material+Material.size && material<end) || scratch<0 || scratch%%8!=0 ||\n"
        "     scratch>6291456-1104 || (scratch<material+Material.size && material<scratch+1104) ||\n"
        "     (at<scratch+1104 && scratch<end)) { return 0-1; }\n"
        "  let value=0.0;\n");
    int failed=!tx_prefix((const char *)raw,rawSize,header,sizeof header-1);
    int rows=0,alphaKey=0;
    char *src=(char *)raw;
    for(int64_t row=sizeof header-1;!failed && row<rawSize;) {
        int64_t tab[3]={0},end=row;
        int columns=0;
        while(end<rawSize && src[end]!='\n') {
            if(src[end]=='\t') {
                if(columns==3) { failed=1; break; }
                tab[columns++]=end;
            }
            end++;
        }
        if(failed || columns!=3 || end==rawSize) { failed=1; break; }
        const int len=tab[0]-row;
        char name[20],*after=0;
        uint64_t low=0,high=0,tail=0;
        if(len<1 || len>=sizeof name || pack(src+row,len<8?len:8,&low) ||
           (len>8 && pack(src+row+8,len<16?len-8:8,&high)) ||
           (len>16 && pack(src+row+16,len-16,&tail))) { failed=1; break; }
        tx_snprintf(name,sizeof name,"%.*s",len,src+row);
        const long def=tx_strtol(src+tab[0]+1,&after,10);
        if(after!=src+tab[1] || def<0 || def>7) { failed=1; break; }
        const int real=tab[2]-tab[1]==2 && src[tab[1]+1]=='-';
        const long max=real?0:tx_strtol(src+tab[1]+1,&after,10);
        if(!real && (after!=src+tab[2] || max<def || max>7)) { failed=1; break; }
        const char *rule=src+tab[2]+1;
        const int size=end-tab[2]-1;
        const int boolean=tx_same(rule,size,"bool",4);
        const int lower=tx_same(rule,size,"lt",2);
        const int greater=tx_same(rule,size,"gt",2);
        if(!(boolean || lower || greater || tx_same(rule,size,"num",3)) ||
           (real!=(lower || greater))) { failed=1; break; }
        if(tx_eqz(name,"alphaTest")) {
            if(alphaKey || !real) { failed=1; break; }
            alphaKey=rows+1;
        }
        int n;
        if(real) n=tx_snprintf(setters+set,sizeof setters-set,
            "  if(key==%d) {\n    if(value-value!=0.0) { return 0-1; }\n"
            "    if(!apply) { return 0; }\n    return %s;\n  }\n",rows+1,
            tx_eqz(name,"alphaTest")?"Material_setAlphaTest(at,value)":"ux_f64_put(at+Material.opacity,value)");
        else n=tx_snprintf(setters+set,sizeof setters-set,
            "  if(key==%d) {\n    if(value!=value || value<0.0 || value>%ld.0) { return 0-1; }\n"
            "    let integer=f64_floor_i64(value);\n    if(value!=integer) { return 0-1; }\n"
            "    if(!apply) { return 0; }\n    return ux_u32_put(at+Material.%s,integer);\n  }\n",rows+1,max,name);
        if(n<0 || n>=sizeof setters-set) { failed=1; break; }
        set+=n;
        n=tx_snprintf(json+out,sizeof json-out,
            "  value=%s(material+Material.%s);\n"
            "  if(value%s%ld.0) { at=material_json_field(at,end,%llu,%llu,%llu,%d,value,scratch); }\n"
            "  if(at<0) { return at; }\n",real?"ux_f64":"0.0+ux_u32",name,
            lower?"<":greater?">":"!=",def+(mutate && rows==0),
            (unsigned long long)low,(unsigned long long)high,(unsigned long long)tail,len*2+boolean);
        if(n<0 || n>=sizeof json-out) { failed=1; break; }
        out+=n;
        n=tx_snprintf(readers+read,sizeof readers-read,
            "  value=material_json_read(start,finish,scratch,%llu,%llu,%llu,%d,%ld.0);\n"
            "  stored=ux_u32_put(row,%d);\n"
            "  stored=ux_u32_put(row+4,0);\n"
            "  stored=ux_f64_put(row+8,value);\n"
            "  row=row+16;\n",
            (unsigned long long)low,(unsigned long long)high,(unsigned long long)tail,
            len*2+boolean,def,rows+1);
        if(n<0 || n>=sizeof readers-read) { failed=1; break; }
        read+=n;
        rows++;
        row=end+1;
    }
    if(!failed && rows==12 && alphaKey) {
        const int len=tx_snprintf(result,sizeof result,
            "%s  return 0-2;\n}\nnative function Material_alphaKey() i64 { return %d; }\n"
            "%s  return at;\n}\n%s  return %d;\n}\n",
            setters,alphaKey,json,readers,rows);
        if(len<0 || len>=sizeof result) failed=1;
        else failed=write?sy_write_file(dest,result,len,0644)!=0:
            sy_read_file(dest,&old,&oldSize,sizeof result) || !tx_same((const char *)old,oldSize,result,len);
    } else failed=1;
    printf("MATERIAL_FIELDS rows=%d failed=%d\n",rows,failed);
    mm_free(raw);
    mm_free(old);
    return failed;
}
