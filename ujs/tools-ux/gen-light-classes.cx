#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

static int light_wire_generate(char names[8][32],char *out,int capacity,int mutate) {
    unsigned char *facts=0;
    int64_t bytes=0;
    const char header[]="key\tmember\tkinds\tformat\n";
    if(sy_read_file("ujs/practice/uxe/base/light-class-json-fields.tsv",&facts,&bytes,4096) ||
       bytes<sizeof header-1 || !tx_prefix((const char *)facts,bytes,header,sizeof header-1)) { mm_free(facts); return -1; }
    char keys[40][25],members[40][40];
    int masks[40],formats[40];
    const char *labels[]={"token","u32","f64","bool","array","object"};
    int count=0,failed=0;
    for(int64_t at=sizeof header-1;!failed && at<bytes;) {
        int64_t end=at;
        while(end<bytes && facts[end]!='\n') end++;
        int64_t fields[4]={at,0,0,0};
        int cols=1;
        for(int64_t i=at;i<end;i++) {
            if(facts[i]=='\t' && cols<4) fields[cols++]=i+1;
        }
        if(count>=32 || end==bytes || cols!=4 || fields[1]-at<2 || fields[1]-at>25 ||
           fields[2]-fields[1]<2 || fields[2]-fields[1]>40) { failed=1; break; }
        char *last=0;
        long mask=tx_strtol((const char *)facts+fields[2],&last,10);
        if(last!=(char *)facts+fields[3]-1 || mask<1 || mask>255) { failed=1; break; }
        int format=-1;
        for(int i=0;i<6;i++) if(tx_same(labels[i],tx_len(labels[i],16),(const char *)facts+fields[3],end-fields[3])) format=i;
        if(format<0) { failed=1; break; }
        tx_snprintf(keys[count],sizeof keys[0],"%.*s",(int)(fields[1]-at-1),facts+at);
        tx_snprintf(members[count],sizeof members[0],"%.*s",(int)(fields[2]-fields[1]-1),facts+fields[1]);
        masks[count]=(int)mask-(mutate && tx_eqz(keys[count],"bias")?8:0);
        formats[count]=format;
        count++;
        at=end+1;
    }
    mm_free(facts);
    if(failed || count!=32) return -1;
    for(int i=0;i<8;i++) tx_snprintf(keys[32+i],sizeof keys[0],"%s",names[i]);
    int used=tx_snprintf(out,capacity,"// Generated by gen-light-classes.cx.\nstruct LightWireRoot {\n");
    if(used<0 || used>=capacity) return -1;
    for(int i=0;i<32;i++) {
        int n=tx_snprintf(out+used,capacity-used,"%s  %s: u8;\n",i==15?"}\n\nstruct LightWireShadow {\n":"",keys[i]);
        if(n<0 || n>=capacity-used) return -1;
        used+=n;
    }
    int n=tx_snprintf(out+used,capacity-used,"}\n\nnative function light_wire_metadata(key:i64,col:i64) i64 {\n");
    if(n<0 || n>=capacity-used) return -1;
    used+=n;
    for(int i=0;i<32;i++) {
        char offset[80];
        if(tx_eqz(members[i],"-")) tx_snprintf(offset,sizeof offset,"0-1");
        else tx_snprintf(offset,sizeof offset,"LightJson.%s",members[i]);
        n=tx_snprintf(out+used,capacity-used,"  if(key==%d) { if(col==0) { return %d; } if(col==1) { return %d; } return %s; }\n",i,masks[i],formats[i],offset);
        if(n<0 || n>=capacity-used) return -1;
        used+=n;
    }
    n=tx_snprintf(out+used,capacity-used,"  return 0-1;\n}\n\nnative function light_wire_word(key:i64,col:i64) i64 {\n");
    if(n<0 || n>=capacity-used) return -1;
    used+=n;
    for(int i=0;i<40;i++) {
        int len=tx_len(keys[i],sizeof keys[i]);
        int64_t words[3]={0,0,0};
        for(int j=0;j<len;j++) words[j/8]|=(int64_t)(unsigned char)keys[i][j]<<(j%8*8);
        n=tx_snprintf(out+used,capacity-used,"  if(key==%d) { let row=[%d,%lld,%lld,%lld]; return row[col]; }\n",i,len,
            (long long)words[0],(long long)words[1],(long long)words[2]);
        if(n<0 || n>=capacity-used) return -1;
        used+=n;
    }
    n=tx_snprintf(out+used,capacity-used,"  return 0-1;\n}\n");
    if(n<0 || n>=capacity-used) return -1;
    return used+n;
}

int main(int argc,char **argv) {
    int write=argc==2 && tx_eqz(argv[1],"--write");
    int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    int mutate_wire=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate-wire");
    if(!write && !mutate && !mutate_wire && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char *path="ujs/practice/uxe/base/light-classes-generated.ujs";
    const char *constructors_path="ujs/practice/uxe/base/light-classes-constructors.ujs";
    const char *wire_path="ujs/practice/uxe/base/light-class-json-fields-generated.ujs";
    const char header[]="class\tkind\tup\ttarget\tshadowFov\n";
    unsigned char *facts=0,*reference=0,*generated=0;
    int64_t bytes=0,reference_bytes=0,generated_bytes=0;
    int failed=sy_read_file("ujs/practice/uxe/base/light-classes.tsv",&facts,&bytes,4096) ||
        sy_read_file("ujs/practice/web/game/three.module.js",&reference,&reference_bytes,4000000);
    if(!failed && (bytes<sizeof header-1 || !tx_prefix((const char *)facts,bytes,header,sizeof header-1))) failed=1;
    char code[8192];
    int used=tx_snprintf(code,sizeof code,"// Generated by gen-light-classes.cx.\nstruct LightKind {\n");
    char names[8][32];
    int profile[8][3];
    int rows=0;
    for(int64_t at=sizeof header-1;!failed && at<bytes;) {
        int64_t tab=at;
        while(tab<bytes && facts[tab]!='\t' && facts[tab]!='\n') tab++;
        if(rows>=8 || tab==at || tab-at>=32 || tab+7>=bytes || facts[tab]!='\t' ||
            facts[tab+1]!='1'+rows || facts[tab+2]!='\t' || facts[tab+4]!='\t' || facts[tab+6]!='\t' ||
            (facts[tab+3]!='0' && facts[tab+3]!='1') || (facts[tab+5]!='0' && facts[tab+5]!='1')) { failed=1; break; }
        char *end=0;
        long fov=tx_strtol((const char *)facts+tab+7,&end,10);
        if(end==(char *)facts+tab+7 || end>=(char *)facts+bytes || *end!='\n' || fov< -1 || fov>180) { failed=1; break; }
        tx_snprintf(names[rows],sizeof names[rows],"%.*s",(int)(tab-at),facts+at);
        char declaration[80];
        int d=tx_snprintf(declaration,sizeof declaration,"class %s extends %s {",names[rows],rows?"Light":"Object3D");
        if(d<0 || !tx_contains((const char *)reference,reference_bytes,declaration,d)) { failed=1; break; }
        profile[rows][0]=facts[tab+3]-'0';
        profile[rows][1]=facts[tab+5]-'0';
        profile[rows][2]=(int)fov;
        int n=tx_snprintf(code+used,sizeof code-used,"  %s: u8;\n",names[rows]);
        if(n<0 || n>=sizeof code-used) { failed=1; break; }
        used+=n;
        rows++;
        at=end-(char *)facts+1;
    }
    if(!failed && rows==8) {
        int n=tx_snprintf(code+used,sizeof code-used,"}\n\nnative function light_profile(kind:i64,field:i64) i64 {\n");
        if(n<0 || n>=sizeof code-used) failed=1;
        else used+=n;
    } else failed=1;
    for(int i=0;!failed && i<rows;i++) {
        int n=tx_snprintf(code+used,sizeof code-used,
            "  if(kind==LightKind.%s+1) {\n"
            "    if(field==0) { return %d; }\n"
            "    if(field==1) { return %d; }\n"
            "    return %d;\n  }\n",names[i],profile[i][0],profile[i][1],profile[i][2]+(mutate && i==5));
        if(n<0 || n>=sizeof code-used) failed=1;
        else used+=n;
    }
    if(!failed) {
        int n=tx_snprintf(code+used,sizeof code-used,"  return 0;\n}\n");
        if(n<0 || n>=sizeof code-used) failed=1;
        else used+=n;
    }
    char constructors[4096];
    int constructor_used=tx_snprintf(constructors,sizeof constructors,"// Generated by gen-light-classes.cx.\n");
    for(int i=0;!failed && i<rows;i++) {
        int n=tx_snprintf(constructors+constructor_used,sizeof constructors-constructor_used,
            "\nnative function %s_new(light:i64,arena:i64,color:i64,intensity:f64) i64 {\n"
            "  return light_new(light,arena,LightKind.%s+1,color,intensity);\n}\n",names[i],names[i]);
        if(n<0 || n>=sizeof constructors-constructor_used) failed=1;
        else constructor_used+=n;
    }
    if(!failed) failed=write?sy_write_file(path,code,used,0644)!=0:
        sy_read_file(path,&generated,&generated_bytes,8192) || !tx_same((const char *)generated,generated_bytes,code,used);
    mm_free(generated);
    generated=0;
    if(!failed) failed=write?sy_write_file(constructors_path,constructors,constructor_used,0644)!=0:
        sy_read_file(constructors_path,&generated,&generated_bytes,4096) ||
        !tx_same((const char *)generated,generated_bytes,constructors,constructor_used);
    mm_free(generated);
    generated=0;
    char wire[12288];
    int wire_used=failed?-1:light_wire_generate(names,wire,sizeof wire,mutate_wire);
    if(!failed) failed=wire_used<0 || (write?sy_write_file(wire_path,wire,wire_used,0644)!=0:
        sy_read_file(wire_path,&generated,&generated_bytes,sizeof wire) ||
        !tx_same((const char *)generated,generated_bytes,wire,wire_used));
    printf("LIGHT_CLASSES rows=%d failed=%d\n",rows,failed);
    mm_free(facts);
    mm_free(reference);
    mm_free(generated);
    return failed;
}
