#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

static int mode_value(const char *table, int64_t size, const char *name) {
    char key[80];
    int length=tx_snprintf(key,sizeof key,"\ndepth\t%s\t",name);
    long offset=tx_find(table,size,key,length);
    if(offset<0) return -1;
    const char *begin=table+offset+length;
    char *end=0;
    long value=tx_strtol(begin,&end,10);
    if(end==begin || *end!='\t' || value<0 || value>65535 ||
       tx_find(end,size-(end-table),key,length)>=0) return -1;
    return (int)value;
}

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    const int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char *path="ujs/practice/uxe/base/gpu-depth-packing-generated.ujs";
    unsigned char *table=0,*previous=0;
    int64_t size=0,old=0;
    if(sy_read_file("ujs/practice/uxe/base/gpu-state-constants.tsv",&table,&size,32000)) return 1;
    const int basic=mode_value((const char *)table,size,"BasicDepthPacking");
    const int rgba=mode_value((const char *)table,size,"RGBADepthPacking");
    mm_free(table);
    if(basic<0 || rgba<0 || basic==rgba) return 1;
    char output[2000];
    const int bytes=tx_snprintf(output,sizeof output,
        "// Generated by gen-gpu-depth-packing.cx.\n"
        "native function GpuDepth_pack(mode:i64,z:f64,opacity:f64) i64 {\n"
        "  if(!(z>=0.0 && z<=1.0 && opacity>=0.0 && opacity<=1.0)) { return 0-1; }\n"
        "  if(mode==%d) {\n"
        "    let gray=f64_floor_i64((1.0-z)*255.0+0.5);\n"
        "    let alpha=f64_floor_i64(opacity*255.0+0.5);\n"
        "    return gray*65793+alpha*16777216;\n"
        "  }\n"
        "  if(mode==%d) {\n"
        "    if(z==1.0) { return 4278190080; }\n"
        "    let word=f64_floor_i64(z*4294967296.0);\n"
        "    let withoutAlpha=word%%16777216;\n"
        "    let red=withoutAlpha%%256;\n"
        "    if(z*4294967296.0>=0.5+word && red<255) { word=word+1; }\n"
        "    return word;\n"
        "  }\n"
        "  return 0-2;\n"
        "}\n",mutate?rgba:basic,rgba);
    if(bytes<0 || bytes>=sizeof output) return 1;
    const int bad=write?sy_write_file(path,output,bytes,0644)!=0:
        sy_read_file(path,&previous,&old,sizeof output) || !tx_same((const char *)previous,old,output,bytes);
    mm_free(previous);
    printf("GPU_DEPTH_PACKING generated=2 failed=%d\n",bad);
    return bad;
}
