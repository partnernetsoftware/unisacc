            capability_contains("ujs/practice/uxe/base/light-class.ujs","native function Light_clone(","native function Light_dispose(") &&
            capability_contains("ujs/practice/uxe/base/light-class-json-runtime.ujs","native function Light_fromJSON(","light_new(") &&
            capability_contains("ujs/tests/light-class-json-struct.cx","--mutate","LightJson_read(") &&
            capability_contains("ujs/tests/light-class-struct.cx","Light_copy(","Light_dispose(") &&
            capability_contains("ujs/tests/light-class-public-linked.cx","--prepare","--mutate") &&
