            tx_snprintf(proof,sizeof proof,"\n%s\t",r->name);
            return capability_contains("ujs/practice/uxe/test/gpu-depth-functions-generated.tsv",proof,"name\tvalue") &&
                capability_contains("ujs/practice/uxe/base/gpu-depth-functions-generated.ujs","function GpuDepthFunction_apply(","GpuRenderState.depth") &&
                capability_contains("ujs/tests/gpu-depth-functions-pixel.cx","--mutate","int passes(") &&
                capability_contains("ujs/practice/uxe/test/gpu-depth-functions-r160.html","setMaterial(","uxe_depth_function(");
        }
        if(tx_eqz(r->milestone,"M4") && tx_eqz(methods,"-") && starts(evidence,"G-pixel GPU_BLEND_EQUATIONS")) {
            tx_snprintf(proof,sizeof proof,"\n%s\t",r->name);
            return capability_contains("ujs/practice/uxe/test/gpu-blend-equations-generated.tsv",proof,"name\tvalue") &&
                capability_contains("ujs/practice/uxe/base/gpu-blend-equations-generated.ujs","function GpuBlendEquation_apply(","GpuRenderState.equationRgb") &&
                capability_contains("ujs/tests/gpu-blend-equations-pixel.cx","--mutate","int equation(") &&
                capability_contains("ujs/practice/uxe/test/gpu-blend-equations-r160.html","setMaterial(","uxe_blend_equation(");
        }
        if(tx_eqz(r->milestone,"M4") && tx_eqz(methods,"-") && starts(evidence,"G-pixel GPU_BLEND_FACTORS")) {
            tx_snprintf(proof,sizeof proof,"\n%s\t",r->name);
            return capability_contains("ujs/practice/uxe/test/gpu-blend-factors-generated.tsv",proof,"name\tvalue") &&
                capability_contains("ujs/practice/uxe/base/gpu-blend-factors-generated.ujs","function GpuBlendFactor_apply(","GpuRenderState.sourceRgb") &&
                capability_contains("ujs/tests/gpu-blend-factors-pixel.cx","--mutate","int factor(") &&
