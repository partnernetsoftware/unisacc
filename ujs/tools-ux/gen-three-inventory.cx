        tx_snprintf(proof,sizeof proof,"function %s_new(",r->name);
        return starts(evidence,"G-anim interpolant-numeric-anim.cx") &&
            tx_eqz(methods,"constructor,evaluate,copySampleValue,getSettings") &&
            capability_contains("ujs/practice/uxe/base/interpolant-classes-generated.ujs",proof,"Interpolant_initArray(") &&
            capability_contains("ujs/practice/uxe/base/interpolant-family-class.ujs","function Interpolant_evaluate(","function Interpolant_copySampleValue(") &&
            capability_contains("ujs/practice/uxe/base/interpolant-family-class.ujs","function Interpolant_getSettings(","function Interpolant_locate(") &&
            capability_contains("ujs/tests/interpolant-numeric-anim.cx","--integer-mutate","g_math_near(") &&
            capability_contains("ujs/tests/interpolant-base-anim.cx","--mutate","Interpolant_locate(") &&
            capability_contains("ujs/practice/uxe/test/interpolant-numeric-r160.html",r->name,".evaluate(");
    }
    if(r->lane=='A' && tx_eqz(r->milestone,"M8") && tx_eqz(r->name,"PropertyMixer")) {
        const char *base="ujs/practice/uxe/base/propertymixer-bound.ujs";
