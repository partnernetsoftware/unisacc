            capability_contains("ujs/tests/shadow-material-object-json.cx","--mutate","shadow-material-object-r160.html");
    }
    if(r->lane=='A' && tx_eqz(r->milestone,"M5") && tx_eqz(r->name,"LineDashedMaterial"))
        return tx_eqz(methods,"constructor,setValues,writeFields,readFields,copy,clone,dispose") && starts(evidence,"G-pixel line-dashed-material-object.cx") &&
            capability_contains("ujs/practice/uxe/base/line-dashed-material-object.ujs","LineDashedObject_clone(","LineDashedObject_dispose(") &&
            capability_contains("ujs/practice/uxe/base/line-dashed-material-object-json.ujs","LineDashedObject_writeJSON(","LineDashedObject_readJSON(") &&
            capability_contains("ujs/tests/line-dashed-material-object.cx","--mutate","229") &&
            capability_contains("ujs/practice/uxe/test/line-dashed-material-object-r160.html","LineDashedMaterial","readPixels(");
    if(r->lane=='A' && tx_eqz(r->milestone,"M5") &&
       one_of(r->name,"|Material|MeshBasicMaterial|MeshLambertMaterial|MeshPhongMaterial|MeshNormalMaterial|MeshDepthMaterial|MeshStandardMaterial|MeshToonMaterial|MeshMatcapMaterial|MeshDistanceMaterial|")) {
        tx_snprintf(proof,sizeof proof,"native function %s_new(",r->name);
        return tx_eqz(methods,"constructor,setValues,writeFields,readFields,copy,clone,dispose") &&
            starts(evidence,"G-struct material-fields-struct.cx") &&
            capability_contains("ujs/practice/uxe/base/material-classes-generated.ujs",proof,"Material_init(") &&
