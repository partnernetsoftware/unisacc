            capability_contains("ujs/tests/compressedtextureloader-dds.cx","--mutate","compressedtextureloader-dds-r160.html");
    }
    if(r->lane=='A' && tx_eqz(r->name,"BufferGeometryLoader")) {
        return tx_eqz(methods,"load,loadAsync,parse") &&
            capability_contains("ujs/practice/uxe/base/buffergeometryloader-async.ujs","BufferGeomLoader_decodeAsync(","BufferGeometryLoader_parse(") &&
            capability_contains("ujs/practice/uxe/base/loader-family.ujs","kind==11 || kind==13","LoaderFamily_receiveAsync(") &&
            capability_contains("ujs/tests/buffergeometryloader-async.cx","--mutate","buffergeometryloader-async-r160.html");
    }
    if(r->lane=='A' && tx_eqz(r->name,"AnimationLoader")) {
        return tx_eqz(methods,"load,loadAsync,parse") &&
            capability_contains("ujs/practice/uxe/base/animationloader-async.ujs","AnimationLoader_decodeAsync(","AnimationLoader_parse(") &&
            capability_contains("ujs/practice/uxe/base/loader-family.ujs","kind==10 || kind==11","LoaderFamily_beginAsync(") &&
            capability_contains("ujs/tests/animationloader-async.cx","--mutate","animationloader-async-r160.html");
    }
    if(r->lane=='A' && tx_eqz(r->name,"MeshPhysicalMaterial")) {
        return tx_eqz(methods,"init,toJSON,fromJSON,coat,direct") &&
            capability_contains("ujs/practice/uxe/base/material-physical-object.ujs","PhysicalObject_init(","PhysicalObject_coatParams(") &&
            capability_contains("ujs/practice/uxe/base/material-physical-object-json.ujs","PhysicalObject_writeJSON(","PhysicalObject_readJSON(") &&
            capability_contains("ujs/tests/material-physical-object.cx","--mutate","material-physical-object-r160.html");
    }
    if(r->lane=='A' && tx_eqz(r->name,"ShadowMaterial")) {
