static const char target[]="ujs/practice/uxe/three-inventory.tsv";
static const char annotations[]="ujs/practice/uxe/three-r160-annotations.tsv";
static const char blendAnnotations[]="ujs/practice/uxe/base/gpu-blend-factors-annotations.tsv";
static const char equationAnnotations[]="ujs/practice/uxe/base/gpu-blend-equations-annotations.tsv";
static const char depthAnnotations[]="ujs/practice/uxe/base/gpu-depth-functions-annotations.tsv";
static const char stencilAnnotations[]="ujs/practice/uxe/base/gpu-stencil-functions-annotations.tsv";
static const char stencilOpsAnnotations[]="ujs/practice/uxe/base/gpu-stencil-ops-annotations.tsv";
static const char cullAnnotations[]="ujs/practice/uxe/base/gpu-cull-faces-annotations.tsv";
static const char blendModeAnnotations[]="ujs/practice/uxe/base/gpu-blend-modes-annotations.tsv";
static const char sideAnnotations[]="ujs/practice/uxe/base/gpu-material-sides-annotations.tsv";
static const char wrapAnnotations[]="ujs/practice/uxe/base/gpu-texture-wraps-annotations.tsv";
static const char filterAnnotations[]="ujs/practice/uxe/base/gpu-texture-filters-annotations.tsv";
static const char animationAnnotations[]="ujs/practice/uxe/base/animation-constant-annotations.tsv";
