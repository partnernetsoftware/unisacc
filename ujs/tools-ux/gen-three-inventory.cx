        const char *life="ujs/practice/uxe/base/curve-family-lifecycle.ujs";
        const char *classGate="ujs/tests/curve-family-class-struct.cx";
        const char *edgeGate="ujs/tests/curve-family-line-edge-struct.cx";
        const char *lifeGate="ujs/tests/curve-family-lifecycle-struct.cx";
        return starts(evidence,"G-struct curve-family-class-struct.cx") &&
            tx_eqz(methods,"constructor,getPoint,getPointAt,getPoints,getSpacedPoints,getLength,getLengths,updateArcLengths,getUtoTmapping,getTangent,getTangentAt,computeFrenetFrames,copy,clone,toJSON,fromJSON") &&
            capability_contains("ujs/practice/uxe/base/curve-family-classes.ujs","function LineCurveClass_init(","CurveFamily_init(") &&
            capability_contains(classGate,"--class","G_STRUCT Curve family class") &&
            capability_contains(edgeGate,"--frames","--mutate") &&
            capability_contains(lifeGate,"--class","--mutate") &&
            capability_contains(life,"function CurveFamily_copy(","function CurveFamily_clone(") &&
            capability_contains(life,"function CurveFamily_toJSON(","function CurveFamily_fromJSON(") &&
            capability_contains("ujs/practice/uxe/test/curve-family-line-edge-r160.html","LineCurve","computeFrenetFrames(") &&
            capability_contains("ujs/practice/uxe/test/curve-family-lifecycle-r160.html","LineCurve","fromJSON(");
    }
    if(r->lane=='A' && tx_eqz(r->milestone,"M3") && tx_eqz(r->name,"LineCurve3")) {
        const char *record="ujs/practice/uxe/base/linecurve3-class.ujs";
        const char *lifecycle="ujs/practice/uxe/base/linecurve3-lifecycle.ujs";
        const char *check="ujs/tests/linecurve3-lifecycle-struct.cx";
        return starts(evidence,"G-struct LineCurve3") &&
            tx_eqz(methods,"getPoint,getPointAt,getPoints,getSpacedPoints,getLengths,getLength,getTangent,getTangentAt,copy,clone,toJSON,fromJSON,updateArcLengths,constructor,getUtoTmapping,computeFrenetFrames") &&
            capability_contains(record,"function LineCurve3_init(","function LineCurve3_getUtoTmapping(") &&
            capability_contains(record,"function LineCurve3_computeFrenetFrames(","struct LineCurve3Record") &&
            capability_contains(lifecycle,"function LineCurve3_recordPointAt(","function LineCurve3_recordTangentAt(") &&
            capability_contains(lifecycle,"function LineCurve3_recordSpacedPoints(","function LineCurve3_recordLength(") &&
            capability_contains(lifecycle,"function LineCurve3_recordLengths(","function LineCurve3_updateArcLengths(") &&
            capability_contains(lifecycle,"function LineCurve3_copy(","function LineCurve3_clone(") &&
            capability_contains(lifecycle,"function LineCurve3_toJSON(","function LineCurve3_fromJSON(") &&
            capability_contains(check,"--identity-mutate","--json-mutate") &&
            capability_contains(check,"curve-control-layout.ujs","uxe_linecurve3_v1") &&
            capability_contains("ujs/practice/uxe/test/linecurve3-lifecycle-r160.html","new LineCurve3(","product.uxe_linecurve3_read");
    }
    if(r->lane!='A' || (!structure && !tx_eqz(r->milestone,"M1"))) return 0;
    tx_snprintf(proof,sizeof proof,"%s %s",structure?"G-struct":"G-math",r->name);
    if(!starts(evidence,proof)) return 0;
    int i=0;
    for(;r->name[i];i++) {
        char c=r->name[i];
        stem[i]=c>='A' && c<='Z' ? c+'a'-'A' : c;
    }
    stem[i]=0;
    tx_snprintf(path,sizeof path,"ujs/practice/uxe/base/%s.ujs",stem);
    int ok=!sy_read_file(path,&source_bytes,&source_size,100000) && capability_fixture(stem,r->name,structure);
    if(ok && tx_eqz(r->name,"Color")) {
        ok=!sy_read_file("ujs/practice/uxe/base/color-style.ujs",&extra,&extra_size,100000) &&
            capability_fixture("color-style","Color CSS",0);
    }
    if(ok && tx_eqz(r->name,"Box3")) ok=capability_fixture("box3-scene","Box3 objects",0);
    if(ok && tx_eqz(r->name,"Frustum")) ok=capability_fixture("frustum-scene","Frustum objects",0);
    if(ok && curve) {
        ok=!sy_read_file("ujs/practice/uxe/base/curve-json.ujs",&extra,&extra_size,100000) &&
            capability_fixture("curve-json","Curve JSON",1) &&
            capability_fixture("curve-frames","Curve Frenet",1) &&
            capability_contains("ujs/tests/curve-frames-struct.cx","--closed-mutate","curve-closed") &&
            capability_contains("ujs/practice/uxe/test/curve-closed-r160.html","computeFrenetFrames","r160");
    }
    if(ok && shape_path) {
        ok=tx_eqz(methods,"init,moveTo,lineTo,quadraticCurveTo,bezierCurveTo,splineThru,toShapes") &&
            capability_fixture("shapepath-spline","ShapePath spline",1) &&
            capability_fixture("shapepath-winding","ShapePath winding",1) &&
            capability_fixture("shapepath-holes","ShapePath hole ownership",1) &&
            capability_fixture("shapepath-boundary","ShapePath boundary",1) &&
            capability_contains("ujs/tests/shapepath-spline-struct.cx","--mutate","Path_clone") &&
            capability_contains("ujs/tests/shapepath-holes-struct.cx","--mutate","ShapePath_toShapes") &&
            capability_contains("ujs/tests/shapepath-boundary-struct.cx","--mutate","ShapePath_toShapes");
    }
    const char *at=methods;
    while(ok && *at) {
        const char *end=at;
        while(identifier(*end)) end++;
        if(end==at || (*end && *end!=',')) { ok=0; break; }
        tx_snprintf(proof,sizeof proof,"function %s_%.*s(",r->name,(int)(end-at),at);
        long length=tx_len(proof,sizeof proof);
        ok=tx_contains((const char *)source_bytes,source_size,proof,length) ||
            (extra && tx_contains((const char *)extra,extra_size,proof,length));
        if(!ok && curve && tx_same(at,end-at,"computeFrenetFrames",19))
            ok=capability_contains("ujs/practice/uxe/base/curve-frames.ujs",proof,"if(closed!=0)");
        at=*end?end+1:end;
    }
    mm_free(source_bytes); mm_free(extra);
    return ok;
}

static int read_facts(const char *path,unsigned char **data,int addon) {
    int64_t n=0;
    const char *fields=addon?"name\tcategory\tmilestone\tpriority\tr160_module\n":
        "name\tstate\tcategory\tmilestone\tpriority\tmethods\tevidence\n";
    if(sy_read_file(path,data,&n,64000) || !starts((char *)*data,fields)) return 1;
    char *at=(char *)*data+tx_len(fields,128);
    while(*at) {
        char *f[7];
        int cols=addon?5:7;
        for(int i=0;i<cols;i++) {
            f[i]=at;
            char sep=i==cols-1?'\n':'\t';
            while(*at && *at!='\n' && *at!='\t' && *at!='\r') at++;
            if(at==f[i] || *at!=sep) return 1;
            *at++=0;
        }
        if(addon) {
            Row *r=add(f[0],'C');
            if(!r || r->annotated || !good_milestone(f[2]) || !good_priority(f[3]) ||
               !ends(f[4],".js") || !contains(f[4],"/")) return 1;
            // Add-on membership is separate from implementation evidence.
            r->category=f[1];
            r->milestone=f[2];
            r->priority=f[3];
            r->evidence=f[4];
            continue;
        }
        if(!good_milestone(f[3]) || !good_priority(f[4]) ||
           !one_of(f[1],"|缺|部分|不适用|已有|")) return 1;
        // A family fact supplies the same contract to each named export.
        // Every member is independently resolved and checked for evidence.
        char *name=f[0];
        for(;;) {
            char *end=name;
            while(identifier(*end)) end++;
            if(end==name || (*end && *end!=',')) return 1;
            int more=*end==',';
            *end=0;
            Row *r=find_row(name);
            if(!r || r->annotated) return 1;
            r->category=f[2];
            r->milestone=f[3];
            r->priority=f[4];
            if(tx_eqz(f[1],"已有") && !capability_evidence(r,f[5],f[6])) {
                printf("THREE_INVENTORY evidence_not_verified=%s\n",r->name);
                return 1;
            }
            if(tx_eqz(f[1],"不适用") &&
               !one_of(r->name,"|WebGL1Renderer|WebGPUCoordinateSystem|")) return 1;
            r->annotated=1;
            r->state=f[1];
            r->methods=f[5];
            r->evidence=f[6];
            if(!more) break;
            name=end+1;
        }
    }
    return 0;
}

static int method_mapping(const Row *r,char *out,int cap) {
    if(r->lane=='B' || tx_eqz(r->state,"不适用") || tx_eqz(r->methods,"待展开")) {
        return tx_snprintf(out,cap,"-")!=1;
    }
    if(r->lane=='A' && tx_eqz(r->name,"InstancedInterleavedBuffer") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"InstancedInterleavedBuffer_new,InstancedInterleavedBuffer_copy,"
            "InstancedInterleaved_clone,InstancedInterleaved_toJSON");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->state,"已有") && one_of(r->name,"|TetrahedronGeometry|OctahedronGeometry|IcosahedronGeometry|DodecahedronGeometry|")) {
        int n=tx_snprintf(out,cap,"SolidGeometry_create,SolidGeometry_fromJSON,SolidGeometry_copy,"
            "SolidGeometry_clone,SolidGeometry_dispose,SolidGeometry_toJSON");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"PMREMGenerator") && tx_eqz(r->methods,"fromCubemap,dispose")) {
        int n=tx_snprintf(out,cap,"GpuPmremBuild_fromCubemap,GpuPmremBuild_release");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && one_of(r->name,"|LineBasicMaterial|PointsMaterial|SpriteMaterial|") && tx_eqz(r->state,"已有")) {
        const char *draw=tx_eqz(r->name,"LineBasicMaterial")?"LineBasicMaterial_drawPrimitive":
            tx_eqz(r->name,"PointsMaterial")?"PointsMaterial_pointSize,PointsMaterial_drawPoints":"SpriteMaterial_rotation,SpriteMaterial_drawBillboard";
        int n=tx_snprintf(out,cap,"%s_init,PointLineSprite_copy,PointLineSprite_writeJSON,PointLineSprite_readJSON,%s",r->name,draw);
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && one_of(r->name,"|ShaderMaterial|RawShaderMaterial|") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"%s_init,ShaderMaterial_writeJSON,ShaderMaterial_readJSON,%s_vertexShader,%s_fragmentShader",r->name,r->name,r->name);
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"FileLoader") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"FileLoader_begin,FileLoader_receive,FileLoader_release");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"AnimationAction") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"AnimationAction_initTimed,AnimationAction_startAt,AnimationAction_fadeIn,AnimationAction_fadeOut,"
            "AnimationAction_stopFading,AnimationAction_setWeight,AnimationAction_getWeight,AnimationAction_tickTimed");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"PropertyBinding") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"PropertyBinding_bind,PropertyBinding_bindNamed,PropertyBinding_findNamed,PropertyBinding_transfer");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"DataTextureLoader") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"LoaderFamily_beginAsync,LoaderFamily_receiveAsync,DataTextureLoader_decodeAsync,DataTextureLoader_rgba8");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"CompressedTextureLoader") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"CompressedTextureLoader_dds,CompressedTextureLoader_level");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"BufferGeometryLoader") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"LoaderFamily_beginAsync,LoaderFamily_receiveAsync,BufferGeomLoader_decodeAsync,BufferGeometryLoader_parse");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"AnimationLoader") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"LoaderFamily_beginAsync,LoaderFamily_receiveAsync,AnimationLoader_decodeAsync,AnimationLoader_parse");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"MeshPhysicalMaterial") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"PhysicalObject_init,PhysicalObject_writeJSON,PhysicalObject_readJSON,MeshPhysicalMaterial_coat,MeshPhysicalMaterial_direct");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"ShadowMaterial") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"ShadowMaterial_init,ShadowMaterial_copy,ShadowMaterial_writeJSON,ShadowMaterial_readJSON,ShadowMaterial_shadowOpacity");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"LineDashedMaterial") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"LineDashedObject_init,LineDashedObject_set,LineDashedObject_writeJSON,"
            "LineDashedObject_readJSON,LineDashedObject_copy,LineDashedObject_clone,LineDashedObject_dispose");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->state,"已有") && one_of(r->name,"|Data3DTexture|DataArrayTexture|")) {
        int n=tx_snprintf(out,cap,"LayeredTextureObject_init,LayeredTextureObject_copy,LayeredTextureObject_clone,"
            "LayeredTextureObject_json,LayeredTextureObject_readJSON,LayeredTextureObject_dispose");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->state,"已有") && tx_eqz(r->name,"AudioAnalyser")) {
        int n=tx_snprintf(out,cap,"AudioAnalyser_prepareByteData,bindAudioAnalyser.getFrequencyData,AudioAnalyser_averageFrequency");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->state,"已有") && tx_eqz(r->name,"AnimationObjectGroup")) {
        int n=tx_snprintf(out,cap,"AnimationObjectGroup_init,AnimGroup_updateBindings,AnimGroup_updateBindings,"
            "AnimGroup_updateBindings,AnimGroup_subscribe,AnimGroup_unsubscribe");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && one_of(r->name,"|CompressedArrayTexture|CompressedCubeTexture|CompressedTexture|") && tx_eqz(r->state,"部分")) {
        const char *decode=tx_eqz(r->name,"CompressedTexture")?",CompressedTexture_decodeBC1":"";
        int n=tx_snprintf(out,cap,"CompressedTextureSoft_init,CompressedTextureSoft_read,CompressedTextureSoft_dispose%s",decode);
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && one_of(r->name,"|EdgesGeometry|WireframeGeometry|") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"%s_generate,LineGeometry_create,LineGeometry_toJSON,LineGeometry_fromJSON",r->name);
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"InstancedBufferGeometry") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"InstancedBufferGeometry_init,InstancedBufferGeometry_setCount,InstancedBufferGeometry_getCount,InstancedGeometry_toJSON,InstancedGeometry_fromJSON");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"CameraHelper") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"CameraHelper_init,HelperLineObject_toJSON,HelperLineObject_fromJSON");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && one_of(r->name,"|DirectionalLightHelper|HemisphereLightHelper|PointLightHelper|SpotLightHelper|") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"%s_init,%s_update,%s_dispose,LightHelperObject_writeJSON,LightHelperObject_readJSON",r->name,r->name,r->name);
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->state,"已有") &&
       one_of(r->name,"|WebGL3DRenderTarget|WebGLArrayRenderTarget|WebGLCubeRenderTarget|WebGLMultipleRenderTargets|")) {
        int n=tx_snprintf(out,cap,"RenderTarget_create,RenderTarget_configure,RenderTarget_bind,RenderTarget_setSize,RenderTarget_copy,RenderTarget_clone,RenderTarget_dispose");
        return n<0 || (size_t)n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"WebGLRenderTarget") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"RenderTarget_create,RenderTarget_bind,RenderTarget_setSize,RenderTarget_copy,RenderTarget_clone,RenderTarget_dispose");
        return n<0 || (size_t)n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"DataTexture") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"DataTexture_init,DataTexture_clone,DataTexture_texel,DataTexture_writeImageJSON,DataTexture_bindJSONSource,Texture_writeParametersJSON,Texture_readParametersJSON");
        return n<0 || (size_t)n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"SkeletonHelper") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"SkeletonHelper_init,SkeletonHelper_update,SkeletonHelper_dispose,HelperLineObject_toJSON,HelperLineObject_fromJSON");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && one_of(r->name,"|BoxHelper|Box3Helper|") && tx_eqz(r->state,"已有")) {
        const char *name=r->name;
        int n=tx_snprintf(out,cap,"%s_init,%s_%s,%s_dispose,%s_copy,%s_clone,HelperLineObject_toJSON,HelperLineObject_fromJSON",
            name,name,tx_eqz(name,"Box3Helper")?"pose":"update",name,name,name);
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && one_of(r->name,"|GridHelper|PolarGridHelper|AxesHelper|") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"HelperLineObject_toJSON,HelperLineObject_fromJSON");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"Loader") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"Loader_family,LoaderFamily_setPath,LoaderFamily_setResourcePath,"
            "LoaderFamily_setCrossOrigin,LoaderFamily_setWithCredentials,LoaderFamily_setRequestHeader");
        return n<0 || n>=cap;
    }
    if(r->lane=='A' && tx_eqz(r->name,"AnimationUtils") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"AnimationUtils_getOrder,AnimationUtils_sortedArray,AnimationUtils_convertArray,"
            "AnimationUtils_isTypedArray,AnimationUtils_flattenJSON,AnimationUtils_subclip,AnimationUtils_makeClipAdditive");
        return n<0 || n>=cap;
    }
    const char *at=r->methods;
    int used=0;
    for(;;) {
        const char *end=at;
        while(identifier(*end)) end++;
        if(end==at || (*end && *end!=',')) return 1;
        const char *prefix=r->name;
        if(r->lane=='A' && scalar_attribute(r->name)) {
            if(tx_same(at,end-at,"toJSON",6) || tx_same(at,end-at,"fromJSON",8)) prefix="Attribute";
            else if(!tx_same(at,end-at,"init",4)) prefix="BufferAttribute";
            else if(!tx_eqz(r->name,"BufferAttribute")) {
                int n=tx_snprintf(out+used,cap-used,"%s%s_new",used?",":"",r->name);
                if(n<1 || n>=cap-used) return 1;
                used+=n;
                if(!*end) return 0;
                at=end+1;
                continue;
            }
        }
        int n=tx_snprintf(out+used,cap-used,"%s%s_%.*s",used?",":"",prefix,(int)(end-at),at);
        if(n<1 || n>=cap-used) return 1;
        used+=n;
        if(!*end) return 0;
        at=end+1;
    }
}

static int render(void) {
    int n=tx_snprintf(result,sizeof result,"%s",header);
    for(int i=0;i<count;i++) {
        Row *r=rows+i;
        char mapping[4096];
        if(method_mapping(r,mapping,sizeof mapping)) return -1;
        int w=tx_snprintf(result+n,sizeof result-n,"%c\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
            r->lane,r->category,r->name,r->state,r->evidence,r->priority,r->milestone,r->methods,mapping);
        if(w<0 || w>=(int)sizeof result-n) return -1;
        n+=w;
    }
    return n;
}
static int matches(const char *file,int n) {
    unsigned char *raw=0;
    int64_t size=0;
    int ok=!sy_read_file(file,&raw,&size,sizeof result) && tx_same((const char *)raw,size,result,n);
    mm_free(raw);
    return ok;
}

int main(int argc,char **argv) {
    if(argc!=2 || !one_of(argv[1],"|--write|--check|")) return 2;
    unsigned char *a=0,*b=0,*c=0,*d=0,*e=0,*s=0,*o=0,*k=0,*m=0,*i=0,*w=0,*t=0,*j=0,*format=0,*encoding=0,*color_tags=0,*draw_modes=0,*depth_formats=0,*depth_packing=0,*target_textures=0,*uniforms=0,*integer_formats=0,*shadow_compare=0,*public_geometry=0,*environment_combine=0,*legacy_formats=0,*shader_library=0,*cube_mapping=0,*target_revision=0,*webgl_utils=0,*glsl_versions=0,*two_pass=0,*normal_modes=0,*core_json=0,*target_family=0;
    int rc=core() || read_facts(addons,&c,1) || read_facts(annotations,&a,0) ||
        read_facts(blendAnnotations,&b,0) || read_facts(equationAnnotations,&d,0) ||
        read_facts(depthAnnotations,&e,0) || read_facts(stencilAnnotations,&s,0) ||
        read_facts(stencilOpsAnnotations,&o,0) || read_facts(cullAnnotations,&k,0) ||
        read_facts(blendModeAnnotations,&m,0) || read_facts(sideAnnotations,&i,0) || read_facts(wrapAnnotations,&w,0) ||
        read_facts(filterAnnotations,&t,0) || read_facts(animationAnnotations,&j,0) ||
        read_facts("ujs/practice/uxe/base/gpu-texture-format-annotations.tsv",&format,0) ||
        read_facts("ujs/practice/uxe/base/gpu-color-encoding-annotations.tsv",&encoding,0) ||
        read_facts("ujs/practice/uxe/base/gpu-color-tags-annotations.tsv",&color_tags,0) ||
        read_facts("ujs/practice/uxe/base/gpu-draw-mode-annotations.tsv",&draw_modes,0) ||
        read_facts("ujs/practice/uxe/base/gpu-depth-format-annotations.tsv",&depth_formats,0) ||
        read_facts("ujs/practice/uxe/base/gpu-depth-packing-annotations.tsv",&depth_packing,0) ||
        read_facts("ujs/practice/uxe/base/target-texture-annotations.tsv",&target_textures,0) ||
        read_facts("ujs/practice/uxe/base/uniforms-lib-annotations.tsv",&uniforms,0) ||
        read_facts("ujs/practice/uxe/base/gpu-integer-format-annotations.tsv",&integer_formats,0) ||
        read_facts("ujs/practice/uxe/base/gpu-shadow-compare-annotations.tsv",&shadow_compare,0) ||
        read_facts("ujs/practice/uxe/base/geometry-public-annotations.tsv",&public_geometry,0) ||
        read_facts("ujs/practice/uxe/base/gpu-environment-combine-annotations.tsv",&environment_combine,0) ||
        read_facts("ujs/practice/uxe/base/gpu-legacy-format-annotations.tsv",&legacy_formats,0) ||
        read_facts("ujs/practice/uxe/base/shader-library-annotations.tsv",&shader_library,0) ||
        read_facts("ujs/practice/uxe/base/gpu-cube-map-annotations.tsv",&cube_mapping,0) ||
        read_facts("ujs/practice/uxe/base/three-target-revision-annotations.tsv",&target_revision,0) ||
        read_facts("ujs/practice/uxe/base/webgl-utils-annotations.tsv",&webgl_utils,0) ||
        read_facts("ujs/practice/uxe/base/target-family-annotations.tsv",&target_family,0) ||
        read_facts("ujs/practice/uxe/base/gpu-glsl-version-annotations.tsv",&glsl_versions,0) ||
        read_facts("ujs/practice/uxe/base/gpu-material-two-pass-annotations.tsv",&two_pass,0) ||
        read_facts("ujs/practice/uxe/base/gpu-normal-map-annotations.tsv",&normal_modes,0) ||
        read_facts("ujs/practice/uxe/base/core-json-annotations.tsv",&core_json,0) || count!=446;
    int n=rc?-1:render();
    if(n<0) rc=1;
    if(!rc) rc=tx_eqz(argv[1],"--write")?sy_write_file(target,result,n,0644)!=0:!matches(target,n);
    if(n>=0) for(char lane='A';lane<='C';lane++) {
        int total=0,done=0,excluded=0,partial=0;
        for(int j=0;j<count;j++) if(rows[j].lane==lane) {
            total++;
            done+=tx_eqz(rows[j].state,"已有");
            excluded+=tx_eqz(rows[j].state,"不适用");
            partial+=tx_eqz(rows[j].state,"部分");
        }
        printf("THREE_INVENTORY lane=%c total=%d eligible=%d ready=%d partial=%d excluded=%d percent=%.2f\n",
            lane,total,total-excluded,done,partial,excluded,100.0*done/(total-excluded));
    }
    if(n>=0) {
        int math=0,verified=0;
        for(int i=0;i<count;i++) if(rows[i].lane=='A' && tx_eqz(rows[i].milestone,"M1")) {
            math++;
            verified+=tx_eqz(rows[i].state,"已有");
        }
        printf("THREE_INVENTORY milestone=M1 rows=%d ready=%d\n",math,verified);
    }
    printf("THREE_INVENTORY rows=%d failed=%d\n",count,rc);
    mm_free(a);
    mm_free(b);
    mm_free(c);
    mm_free(d);
    mm_free(e);
    mm_free(s);
    mm_free(o);
    mm_free(k);
    mm_free(m);
    mm_free(i);
    mm_free(w);
    mm_free(t);
    mm_free(j);
    mm_free(format);
    mm_free(encoding);
    mm_free(color_tags);
    mm_free(draw_modes);
    mm_free(depth_formats);
    mm_free(depth_packing);
    mm_free(target_textures);
    mm_free(uniforms);
    mm_free(integer_formats);
    mm_free(shadow_compare);
    mm_free(public_geometry);
    mm_free(environment_combine);
    mm_free(legacy_formats);
    mm_free(shader_library);
    mm_free(cube_mapping);
    mm_free(target_revision);
    mm_free(webgl_utils);
    mm_free(target_family);
    mm_free(glsl_versions);
    mm_free(two_pass);
    mm_free(normal_modes);
    mm_free(core_json);
    return rc;
}
