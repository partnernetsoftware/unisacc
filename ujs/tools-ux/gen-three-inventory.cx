        }
        if(tx_eqz(r->milestone,"M5") && tx_eqz(methods,"-") &&
           one_of(r->name,"|LinearToneMapping|ReinhardToneMapping|")) {
            return starts(evidence,"G-math ToneModes") && capability_fixture("tone-modes","ToneModes",0) &&
                capability_contains("ujs/practice/uxe/base/gpu-material-tone.ujs",
                    "function GpuMaterial_toneChannel(","if(mode==1)") &&
                capability_contains("ujs/tests/gpu-packet-struct.cx","--tone-mutate","GPU_PACKET") &&
