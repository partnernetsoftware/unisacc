    if(r->lane=='A' && tx_eqz(r->milestone,"M6") &&
       one_of(r->name,"|Light|AmbientLight|HemisphereLight|DirectionalLight|PointLight|SpotLight|RectAreaLight|LightProbe|")) {
        tx_snprintf(proof,sizeof proof,"native function %s_new(",r->name);
        return tx_eqz(methods,"constructor,toJSON,fromJSON,copy,clone,dispose") &&
            starts(evidence,"G-struct light-class-public-linked.cx") &&
