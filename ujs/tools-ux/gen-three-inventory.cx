        }
        if(tx_eqz(r->milestone,"M10") && one_of(r->name,"|MOUSE|TOUCH|")) {
            int mouse=tx_eqz(r->name,"MOUSE");
            if(!starts(evidence,"G-struct control-constants-struct.cx") ||
               !tx_eqz(methods,mouse?"LEFT,MIDDLE,RIGHT,ROTATE,DOLLY,PAN":"ROTATE,PAN,DOLLY_PAN,DOLLY_ROTATE") ||
               !capability_contains("ujs/tests/control-constants-struct.cx","G_STRUCT control exports",mouse?"--mutate-mouse":"--mutate") ||
               !capability_contains("ujs/practice/uxe/test/control-constants-r160.html","Object.values(MOUSE)","Object.values(TOUCH)") ||
               !capability_contains("ujs/tests/orbitcontrols-browser-io.cx","Input.dispatchMouseEvent","Input.dispatchTouchEvent")) return 0;
            const char *at=methods;
