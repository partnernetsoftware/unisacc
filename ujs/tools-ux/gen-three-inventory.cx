static const char digest[]="76dea8151bc9352aef3528b4262e249b2604f62543828328db978d060d61a495";
static const char header[]="lane\tcategory\tname\tstate\tevidence\tpriority\tmilestone\tmethods\tuxe_api\n";

typedef struct {
    char lane;
    char name[100];
    const char *category,*state,*evidence,*priority,*milestone,*methods;
    int annotated;
} Row;
static Row rows[446];
static int count;
static char result[160000];

static int starts(const char *s,const char *p) {
    return tx_prefixz(s,p,tx_len(p,256));
}
static int ends(const char *s,const char *tail) {
    long n=tx_len(s,16000),k=tx_len(tail,16000);
    return n>=0 && k>=0 && n>=k && tx_eqz(s+n-k,tail);
}
static int contains(const char *s,const char *word) {
    return tx_contains(s,tx_len(s,16000),word,tx_len(word,16000));
}
static int one_of(const char *s,const char *names) {
    char key[110];
    int n=tx_snprintf(key,sizeof key,"|%s|",s);
    return n>0 && n<(int)sizeof key && contains(names,key);
}
static int identifier(int c) {
    return (c>='A' && c<='Z') || (c>='a' && c<='z') || (c>='0' && c<='9') || c=='_';
}
static Row *find_row(const char *name) {
    for(int i=0;i<count;i++) if(tx_eqz(rows[i].name,name)) return rows+i;
    return 0;
}
static Row *add(const char *name,char lane) {
    if(count==(int)(sizeof rows/sizeof rows[0]) || find_row(name)) return 0;
    Row *r=rows+count;
    int n=tx_snprintf(r->name,sizeof r->name,"%s",name);
    if(n<=0 || n>=(int)sizeof r->name) return 0;
    count++;
    r->lane=lane;
    r->state="缺";
    r->priority="P2";
    r->evidence="未登记可复用接口与独立门";
    r->methods=lane=='B'?"-":"待展开";
    return r;
}

static void classify(Row *r) {
    const char *n=r->name;
    r->category=r->lane=='B'?"通用常量":"核心";
    r->milestone="M2";
    if(r->lane=='B') {
        if(ends(n,"Usage") || ends(n,"Type")) return;
        if(ends(n,"BlendMode") || starts(n,"Loop") || starts(n,"Interpolate") || ends(n,"Ending")) {
            r->category="动画常量"; r->milestone="M8"; return;
        }
        if(ends(n,"BindMode")) { r->category="网格常量"; r->milestone="M7"; return; }
        if(tx_eqz(n,"MOUSE") || tx_eqz(n,"TOUCH")) { r->category="输入常量"; r->milestone="M10"; return; }
        if(ends(n,"ShadowMap")) { r->category="阴影常量"; r->milestone="M6"; return; }
        if(ends(n,"Format") || ends(n,"Mapping") || ends(n,"Wrapping") || ends(n,"Filter") ||
           ends(n,"ColorSpace") || ends(n,"Encoding") || ends(n,"Transfer") || ends(n,"Primaries") ||
           ends(n,"NormalMap")) { r->category="材质纹理常量"; r->milestone="M5"; return; }
        if(!tx_eqz(n,"REVISION")) { r->category="渲染常量"; r->milestone="M4"; }
        return;
    }
    if(ends(n,"Loader") || ends(n,"LoadingManager") || tx_eqz(n,"LoaderUtils")) {
        r->category="加载"; r->milestone="M9";
    } else if(contains(n,"Camera")) {
        r->category="相机"; r->milestone=ends(n,"Helper")?"M11":"M3";
    } else if(ends(n,"Helper") || starts(n,"Audio") || tx_eqz(n,"PositionalAudio")) {
        r->category=ends(n,"Helper")?"辅助":"音频"; r->milestone="M11";
    } else if(ends(n,"Geometry") || contains(n,"Curve") || one_of(n,"|Path|Shape|ShapePath|ShapeUtils|")) {
        if(!starts(n,"Buffer") && !starts(n,"Instanced")) { r->category="几何"; r->milestone="M3"; }
    } else if(ends(n,"Material") || ends(n,"Texture") || one_of(n,"|ColorManagement|ImageUtils|")) {
        r->category=ends(n,"Texture")?"纹理":"材质"; r->milestone="M5";
    } else if(ends(n,"Light") || starts(n,"Fog") || one_of(n,"|LightProbe|PMREMGenerator|")) {
        r->category="灯光"; r->milestone="M6";
    } else if(starts(n,"Animation") || ends(n,"KeyframeTrack") || starts(n,"Property") || ends(n,"Interpolant")) {
        r->category="动画"; r->milestone="M8";
    } else if(ends(n,"Mesh") || one_of(n,"|LOD|Bone|Skeleton|Sprite|Points|Line|LineSegments|LineLoop|")) {
        r->category="网格"; r->milestone="M7";
    } else if(tx_eqz(n,"Raycaster")) {
        r->category="拾取"; r->milestone="M10";
    } else if(starts(n,"WebGL") || starts(n,"Shader") || starts(n,"Uniforms") ||
              one_of(n,"|RenderTarget|createCanvasElement|")) {
        r->category="渲染"; r->milestone="M4";
    } else if(starts(n,"Vector") || starts(n,"Matrix") ||
              one_of(n,"|Box2|Box3|Color|Cylindrical|Euler|Frustum|Line3|MathUtils|Plane|Quaternion|Ray|Sphere|Spherical|SphericalHarmonics3|Triangle|")) {
        r->category="数学"; r->milestone="M1";
    }
}

static void classify_declarations(const char *s,const char *limit) {
    const char *line=s;
    while(line<limit) {
        const char *start=0;
        if(starts(line,"class ")) start=line+6;
        if(starts(line,"function ")) start=line+9;
        if(start) {
            const char *end=start;
            char name[100];
            while(identifier(*end)) end++;
            if(end>start && end-start<(long)sizeof name) {
                tx_snprintf(name,sizeof name,"%.*s",(int)(end-start),start);
                Row *r=find_row(name);
                if(r) { r->lane='A'; r->methods="待展开"; }
            }
        }
        while(line<limit && *line!='\n') line++;
        if(line<limit) line++;
    }
}

static int core(void) {
    unsigned char *raw=0;
    int64_t size=0;
    char hash[65];
    int rc=1;
    if(sy_read_file(source,&raw,&size,4000000)) return 1;
    const char *s=(const char *)raw;
    if(sy_sha256_any_hex(raw,size,hash) || !tx_eqz(hash,digest) ||
       !tx_contains(s,size,"const REVISION = '160';",23)) goto done;
    long offset=tx_find(s,size,"\nexport { ",10);
    if(offset<0) goto done;
    const char *at=s+offset+10;
    for(;;) {
        char name[100];
        const char *start=at;
        while(identifier(*at)) at++;
        if(at==start || at-start>=(long)sizeof name) goto done;
        tx_snprintf(name,sizeof name,"%.*s",(int)(at-start),start);
        int namespace=one_of(name,"|AnimationUtils|Cache|ColorManagement|DataUtils|DefaultLoadingManager|MathUtils|ShaderChunk|ShaderLib|UniformsLib|UniformsUtils|");
        if(!add(name,namespace?'A':'B')) goto done;
        if(*at==' ' && at[1]=='}' && at[2]==';') break;
        if(*at!=',' || at[1]!=' ') goto done;
        at+=2;
    }
    classify_declarations(s,s+offset);
    for(int i=0;i<count;i++) classify(rows+i);
    rc=count!=416;
done:
    mm_free(raw);
    return rc;
}

static int good_priority(const char *s) {
    return s[0]=='P' && s[1]>='0' && s[1]<='2' && !s[2];
}
static int good_milestone(const char *s) {
    return one_of(s,"|M1|M2|M3|M4|M5|M6|M7|M8|M9|M10|M11|M12|");
}

static int capability_fixture(const char *stem,const char *label,int structure) {
    char path[220],proof[145];
    unsigned char *gate=0,*reference=0;
    int64_t gate_size=0,reference_size=0;
    tx_snprintf(path,sizeof path,"ujs/tests/%s-%s.cx",stem,structure?"struct":"math");
    int ok=!sy_read_file(path,&gate,&gate_size,100000);
    tx_snprintf(path,sizeof path,"ujs/practice/uxe/test/%s-r160.html",stem);
    ok=ok && !sy_read_file(path,&reference,&reference_size,100000);
    if(ok) {
        tx_snprintf(proof,sizeof proof,"%s %s",structure?"G_STRUCT":"G_MATH",label);
        ok=tx_contains((const char *)gate,gate_size,proof,tx_len(proof,sizeof proof)) &&
            tx_contains((const char *)reference,reference_size,"three.module.js",15);
    }
    mm_free(gate); mm_free(reference);
    return ok;
}

static int capability_contains(const char *path,const char *first,const char *second) {
    unsigned char *text=0;
    int64_t size=0;
    int ok=!sy_read_file(path,&text,&size,100000) &&
        tx_contains((const char *)text,size,first,tx_len(first,200)) &&
        tx_contains((const char *)text,size,second,tx_len(second,200));
    mm_free(text);
    return ok;
}

static int capability_evidence(const Row *r, const char *methods, const char *evidence) {
    char stem[100], path[220], proof[145];
    unsigned char *source_bytes=0,*extra=0;
    int64_t source_size=0,extra_size=0;
    if(r->lane=='A' && tx_eqz(r->milestone,"M5") &&
       one_of(r->name,"|Material|MeshBasicMaterial|MeshLambertMaterial|MeshPhongMaterial|MeshNormalMaterial|MeshDepthMaterial|MeshStandardMaterial|MeshToonMaterial|MeshMatcapMaterial|MeshDistanceMaterial|")) {
        tx_snprintf(proof,sizeof proof,"native function %s_new(",r->name);
        return tx_eqz(methods,"constructor,setValues,writeFields,readFields,copy,clone,dispose") &&
            starts(evidence,"G-struct material-fields-struct.cx") &&
            capability_contains("ujs/practice/uxe/base/material-classes-generated.ujs",proof,"Material_init(") &&
            capability_contains("ujs/practice/uxe/base/material-class.ujs","native function Material_clone(","native function Material_dispose(") &&
            capability_contains("ujs/practice/uxe/base/material-set-values.ujs","native function Material_readFields(","native function Material_setValues(") &&
            capability_contains("ujs/tests/material-fields-struct.cx","--mutate","Material_readFields(") &&
            capability_contains("ujs/tests/material-class-struct.cx","Material_copy(","Material_dispose(") &&
            capability_contains("ujs/practice/uxe/test/material-fields-r160.html","REVISION","MaterialLoader");
    }
    if(r->lane=='A' && tx_eqz(r->milestone,"M6") &&
       one_of(r->name,"|AmbientLight|HemisphereLight|DirectionalLight|PointLight|SpotLight|RectAreaLight|LightProbe|")) {
        tx_snprintf(proof,sizeof proof,"native function %s_new(",r->name);
        return tx_eqz(methods,"constructor,toJSON,fromJSON,copy,clone,dispose") &&
            starts(evidence,"G-struct light-class-public-linked.cx") &&
            capability_contains("ujs/practice/uxe/base/light-classes-constructors.ujs",proof,"light_new(") &&
            capability_contains("ujs/practice/uxe/base/light-class.ujs","native function Light_clone(","native function Light_dispose(") &&
            capability_contains("ujs/practice/uxe/base/light-class-json-runtime.ujs","native function Light_fromJSON(","light_new(") &&
            capability_contains("ujs/tests/light-class-json-struct.cx","--mutate","LightJson_read(") &&
            capability_contains("ujs/tests/light-class-struct.cx","Light_copy(","Light_dispose(") &&
            capability_contains("ujs/tests/light-class-public-linked.cx","--prepare","--mutate") &&
            capability_contains("ujs/practice/uxe/test/light-class-public-r160.html",r->name,"ObjectLoader");
    }
    if(r->lane=='A' && tx_eqz(r->milestone,"M9") &&
       one_of(r->name,"|AudioLoader|MaterialLoader|ImageLoader|")) {
        const int image=tx_eqz(r->name,"ImageLoader");
        const int audio=tx_eqz(r->name,"AudioLoader");
        const char *source=image?"ujs/practice/uxe/base/loader-family-image-png.ujs":
            audio?"ujs/practice/uxe/base/loader-family-audio.ujs":"ujs/practice/uxe/base/loader-family-material.ujs";
        const char *gate=image?"ujs/tests/loader-family-png-linked.cx":"ujs/tests/loader-family-async.cx";
        const char *reference=image?"ujs/practice/uxe/test/loader-family-png-linked-r160.html":
            "ujs/practice/uxe/test/loader-family-async-r160.html";
        tx_snprintf(proof,sizeof proof,"native function %s_family(",r->name);
        return tx_eqz(methods,"constructor,loadAsync") &&
            starts(evidence,image?"G-io loader-family-png-linked.cx":"G-io loader-family-async.cx") &&
            capability_contains("ujs/practice/uxe/base/loader-family-classes.ujs",proof,"loader_family_init(") &&
            capability_contains("ujs/practice/uxe/base/loader-family.ujs","LoaderFamily_beginAsync(","LoaderFamily_receiveAsync(") &&
            capability_contains(source,audio?"AudioLoader_decodeAsync(":image?"ImageLoader_decodeAsyncPng(":
                "MaterialLoader_decodeAsync(","FileLoader_release(") &&
            capability_contains(gate,"--mutate",image?"--prepare":"G_IO Loader family async") &&
            capability_contains(reference,r->name,"REVISION");
    }
    if(r->lane=='A' && tx_eqz(r->milestone,"M3") && one_of(r->name,"|BoxGeometry|CircleGeometry|")) {
        const int box=tx_eqz(r->name,"BoxGeometry");
        const char *base=box?"ujs/practice/uxe/base/geometry-box-class.ujs":"ujs/practice/uxe/base/geometry-circle-class.ujs";
        const char *codec=box?"ujs/practice/uxe/base/geometry-box-parameter-json.ujs":"ujs/practice/uxe/base/geometry-circle-parameter-json.ujs";
        return tx_eqz(methods,"generate,fromJSON,copy,clone,dispose,toJSON") &&
            starts(evidence,"G-struct geometry-box-circle-public.cx") &&
            capability_contains(base,box?"BoxGeometry_clone(":"CircleGeometry_clone(",
                box?"BoxGeometry_dispose(":"CircleGeometry_dispose(") &&
            capability_contains(codec,box?"BoxGeometry_toJSON(":"CircleGeometry_toJSON(",
                box?"BoxGeometry_fromJSON(":"CircleGeometry_fromJSON(") &&
            capability_contains("ujs/tests/geometry-box-circle-public.cx","--mutate-circle","--prepare") &&
            capability_contains("ujs/practice/uxe/test/geometry-box-circle-public-r160.html",r->name,"toJSON(");
    }
    if(r->lane=='A' && tx_eqz(r->milestone,"M3") && tx_eqz(r->name,"PlaneGeometry"))
        return tx_eqz(methods,"generate,fromJSON,copy,clone,dispose,toJSON") &&
            starts(evidence,"G-struct geometry-plane-public.cx") &&
            capability_contains("ujs/practice/uxe/base/geometry-plane-class.ujs","PlaneGeometry_clone(","PlaneGeometry_dispose(") &&
            capability_contains("ujs/practice/uxe/base/geometry-plane-tojson.ujs","PlaneGeometry_toJSON(","geometry_parameter_header(") &&
            capability_contains("ujs/practice/uxe/base/geometry-family-plane-json.ujs","PlaneGeometry_fromJSON(","PlaneGeometry_generate(") &&
            capability_contains("ujs/tests/geometry-plane-public.cx","--mutate-dispose","--prepare") &&
            capability_contains("ujs/practice/uxe/test/geometry-plane-public-r160.html","PlaneGeometry","toJSON(");
    if(r->lane=='A' && tx_eqz(r->milestone,"M2") && tx_eqz(r->name,"InstancedInterleavedBuffer")) {
        const char *base="ujs/practice/uxe/base/instancedinterleavedbuffer.ujs";
        return tx_eqz(methods,"constructor,copy,clone,toJSON") &&
            starts(evidence,"G-struct instancedinterleavedbuffer-struct.cx") &&
            capability_contains(base,"InstancedInterleavedBuffer_new(","InstancedInterleavedBuffer_row(") &&
            capability_contains(base,"InstancedInterleavedBuffer_copy(","InstancedInterleaved_clone(") &&
            capability_contains(base,"InstancedInterleaved_toJSON(","InterleavedBuffer_toJSON(") &&
            capability_contains("ujs/tests/instancedinterleavedbuffer-struct.cx","--mutate","meshPerAttribute") &&
            capability_contains("ujs/practice/uxe/test/instancedinterleavedbuffer-r160.html","InstancedInterleavedBuffer","toJSON(");
    }
    int curve=tx_eqz(r->milestone,"M3") && tx_eqz(r->name,"Curve");
    int shape_path=tx_eqz(r->milestone,"M3") && tx_eqz(r->name,"ShapePath");
    int structure=curve || shape_path || tx_eqz(r->milestone,"M2") ||
        (tx_eqz(r->milestone,"M6") && one_of(r->name,"|Fog|FogExp2|"));
    if(r->lane=='B') {
        if(tx_eqz(r->milestone,"M5") && tx_eqz(r->name,"NoToneMapping") && tx_eqz(methods,"-"))
            return starts(evidence,"G-struct gpu-no-tone-struct.cx") &&
                capability_contains("ujs/practice/uxe/base/gpu-tone-rgb.ujs","GpuMaterial_toneRgb(","gain") &&
                capability_contains("ujs/tests/gpu-no-tone-struct.cx","--mutate","GpuMaterial_toneRgb(") &&
                capability_contains("ujs/practice/uxe/test/gpu-no-tone-r160.html","renderer.toneMapping=NoToneMapping","readRenderTargetPixels(");
        if(tx_eqz(r->milestone,"M5") && tx_eqz(methods,"-") &&
           one_of(r->name,"|NoColorSpace|LinearTransfer|SRGBTransfer|Rec709Primaries|P3Primaries|") &&
           starts(evidence,"G-struct GPU_COLOR_TAGS"))
            return capability_contains("ujs/practice/uxe/base/gpu-color-tags-generated.ujs",
                    "GpuColor_decodeTransfer(","GpuColor_convertPrimaries(") &&
                capability_contains("ujs/tests/gpu-color-tags-struct.cx","--mutate-p3","GpuColor_fromColorSpace(") &&
                capability_contains("ujs/practice/uxe/test/gpu-color-tags-r160.html",r->name,"ColorManagement.convert(");
        if(tx_eqz(r->milestone,"M5") && tx_eqz(methods,"-") &&
           one_of(r->name,"|LinearEncoding|sRGBEncoding|") && starts(evidence,"G-struct GPU_COLOR_ENCODING"))
            return capability_contains("ujs/practice/uxe/base/gpu-color-encoding-generated.ujs",
                    "GpuColor_fromLegacyEncoding(","ColorManagement_convert(") &&
                capability_contains("ujs/tests/gpu-color-encoding-struct.cx","--mutate-linear","GpuColor_fromLegacyEncoding(") &&
                capability_contains("ujs/practice/uxe/test/gpu-color-encoding-r160.html",r->name,"texture.encoding=");
        if(tx_eqz(r->milestone,"M4") && tx_eqz(methods,"-") &&
           one_of(r->name,"|RGBAFormat|UVMapping|RedFormat|RGFormat|") && starts(evidence,"G-struct GPU_TEXTURE_FORMAT"))
            return capability_contains("ujs/practice/uxe/base/gpu-texture-format-generated.ujs",
                    "GpuTexture_readFormat(","GpuTexture_mapUv(") &&
                capability_contains("ujs/tests/gpu-texture-format-struct.cx","--mutate-format","packed(") &&
                capability_contains("ujs/practice/uxe/test/gpu-texture-format-r160.html",r->name,"transformUv(");
        if(tx_eqz(r->milestone,"M8") && tx_eqz(methods,"-")) {
            if(starts(evidence,"G-anim TRACK_FACTORY") &&
                one_of(r->name,"|InterpolateDiscrete|InterpolateLinear|InterpolateSmooth|"))
                return capability_contains("ujs/tests/keyframe-track-factory-anim.cx","--mutate","g_math_near(") &&
                    capability_contains("ujs/practice/uxe/test/keyframe-track-factory-r160.html",r->name,"createInterpolant(");
            if(starts(evidence,"G-anim CUBIC_ENDINGS") &&
                one_of(r->name,"|ZeroCurvatureEnding|ZeroSlopeEnding|WrapAroundEnding|"))
                return capability_contains("ujs/tests/cubicinterpolant-anim.cx","--mutate","CubicInterpolant_evaluate(") &&
                    capability_contains("ujs/practice/uxe/test/cubicinterpolant-r160.html",r->name,"f.evaluate(");
        }
        if(tx_eqz(r->milestone,"M4") && tx_eqz(methods,"-") && starts(evidence,"G-pixel GPU_TEXTURE_FILTERS")) {
            tx_snprintf(proof,sizeof proof,"\n%s\t",r->name);
            return capability_contains("ujs/practice/uxe/test/gpu-texture-filters-generated.tsv",proof,"name\tvalue") &&
                capability_contains("ujs/practice/uxe/base/gpu-texture-filters-generated.ujs","function GpuTextureFilter_apply(","GpuTextureSource.filter") &&
                capability_contains("ujs/tests/gpu-texture-filters-pixel.cx","--mutate","int filter_gold(") &&
                capability_contains("ujs/practice/uxe/test/gpu-texture-filters-r160.html","texture.minFilter","uxe_texture_filter(");
        }
        if(tx_eqz(r->milestone,"M4") && tx_eqz(methods,"-") && starts(evidence,"G-pixel GPU_TEXTURE_WRAPS")) {
            tx_snprintf(proof,sizeof proof,"\n%s\t",r->name);
            return capability_contains("ujs/practice/uxe/test/gpu-texture-wraps-generated.tsv",proof,"name\tvalue") &&
                capability_contains("ujs/practice/uxe/base/gpu-texture-wraps-generated.ujs","function GpuTextureWrap_apply(","GpuTextureSource.wrapS") &&
                capability_contains("ujs/tests/gpu-texture-wraps-pixel.cx","--mutate","int texel(") &&
                capability_contains("ujs/practice/uxe/test/gpu-texture-wraps-r160.html","transformUv(","uxe_texture_wrap(");
        }
        if(tx_eqz(r->milestone,"M4") && tx_eqz(methods,"-") && starts(evidence,"G-pixel GPU_MATERIAL_SIDES")) {
            tx_snprintf(proof,sizeof proof,"\n%s\t",r->name);
            return capability_contains("ujs/practice/uxe/test/gpu-material-sides-generated.tsv",proof,"name\tvalue") &&
                capability_contains("ujs/practice/uxe/base/gpu-material-sides-generated.ujs","function GpuMaterialSide_apply(","GpuRenderState.cull") &&
                capability_contains("ujs/tests/gpu-material-sides-pixel.cx","--mutate","int visible(") &&
                capability_contains("ujs/practice/uxe/test/gpu-material-sides-r160.html","setMaterial(","uxe_material_side(");
        }
        if(tx_eqz(r->milestone,"M4") && tx_eqz(methods,"-") && starts(evidence,"G-pixel GPU_BLEND_MODES")) {
            tx_snprintf(proof,sizeof proof,"\n%s\t",r->name);
            return capability_contains("ujs/practice/uxe/test/gpu-blend-modes-generated.tsv",proof,"name\tvalue") &&
                capability_contains("ujs/practice/uxe/base/gpu-blend-modes-generated.ujs","function GpuBlendMode_apply(","gpu_blend_preset") &&
                capability_contains("ujs/practice/uxe/base/gpu-blend-presets.ujs","function gpu_blend_preset(","GpuRenderState.blend") &&
                capability_contains("ujs/tests/gpu-blend-modes-pixel.cx","--mutate","int blend(") &&
                capability_contains("ujs/practice/uxe/test/gpu-blend-modes-r160.html","setMaterial(","uxe_blend_mode(");
        }
        if(tx_eqz(r->milestone,"M4") && tx_eqz(methods,"-") && starts(evidence,"G-pixel GPU_CULL_FACES")) {
            tx_snprintf(proof,sizeof proof,"\n%s\t",r->name);
            return capability_contains("ujs/practice/uxe/test/gpu-cull-faces-generated.tsv",proof,"name\tvalue") &&
                capability_contains("ujs/practice/uxe/base/gpu-cull-faces-generated.ujs","function GpuCullFace_apply(","GpuRenderState.cull") &&
