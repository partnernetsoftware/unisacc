    }
    if(r->lane=='A' && tx_eqz(r->milestone,"M9") && tx_eqz(r->name,"LoadingManager")) {
        const char *base="ujs/practice/uxe/base/loadingmanager-class.ujs";
        return starts(evidence,"G-io loadingmanager-class-io.cx") &&
            tx_eqz(methods,"constructor,itemStart,itemEnd,itemError,resolveURL,setURLModifier,addHandler,removeHandler,getHandler") &&
            capability_contains(base,"function LoadingManager_new(","function LoadingManager_itemStart(") &&
            capability_contains(base,"function LoadingManager_itemEnd(","function LoadingManager_itemError(") &&
            capability_contains(base,"function LoadingManager_resolveURL(","function LoadingManager_setURLModifier(") &&
            capability_contains(base,"function LoadingManager_addHandler(","function LoadingManager_removeHandler(") &&
            capability_contains(base,"function LoadingManager_getHandler(","function LoadingManager_setCallback(") &&
            capability_contains("ujs/tests/loadingmanager-class-io.cx","LoadingManager","mutate") &&
            capability_contains("ujs/tests/loadingmanager-fileloader-io.cx","--split-default-mutate","--raw-url-mutate") &&
            capability_contains("ujs/tests/loadingmanager-linked-io.cx","G_IO LoadingManager C6 linked product","--mutate") &&
            capability_contains("ujs/practice/uxe/base/loadingmanager-base-abi.ujs","export uxe_loadingmanager(","version 1") &&
            capability_contains("ujs/practice/uxe/test/loadingmanager-linked-product.ujs","import uxe_loadingmanager from","uxe_loading_manager_v1");
    }
    if(r->lane=='A' && tx_eqz(r->milestone,"M9") && tx_eqz(r->name,"DefaultLoadingManager")) {
        const char *base="ujs/practice/uxe/base/loader-base.ujs";
        return tx_eqz(methods,"init") && starts(evidence,"G-io loader-base-io.cx") &&
            capability_contains(base,"function LoaderBase_default(","return DefaultLoadingManager_get(") &&
            capability_contains(base,"function Loader_initWithBase(","function FileLoader_initWithBase(") &&
            capability_contains("ujs/tests/loader-base-io.cx","G_IO DefaultLoadingManager loader base","--mutate") &&
            capability_contains("ujs/practice/uxe/test/loader-base-r160.html","new FileLoader()","isolated.DefaultLoadingManager");
    }
    if(r->lane=='A' && tx_eqz(r->milestone,"M9") && tx_eqz(r->name,"LoaderUtils")) {
        return starts(evidence,"G-io loaderutils-io.cx") &&
            tx_eqz(methods,"extractUrlBase,decodeText,resolveURL") &&
            capability_contains("ujs/practice/uxe/base/loaderutils.ujs","function LoaderUtils_extractUrlBase(","function LoaderUtils_decodeText(") &&
            capability_contains("ujs/practice/uxe/base/loaderutils.ujs","function LoaderUtils_resolveURL(","function loader_utf8_width(") &&
            capability_contains("ujs/tests/loaderutils-io.cx","G_IO LoaderUtils","--mutate") &&
            capability_contains("ujs/tests/loaderutils-text-io.cx","G_IO LoaderUtilsText","--mutate") &&
            capability_contains("ujs/practice/uxe/test/loaderutils-r160.html","extractUrlBase","three.module.js") &&
            capability_contains("ujs/practice/uxe/test/loaderutils-text-r160.html","LoaderUtils.decodeText","LoaderUtils.resolveURL");
    }
    if(r->lane=='A' && tx_eqz(r->milestone,"M3") &&
       one_of(r->name,"|QuadraticBezierCurve|QuadraticBezierCurve3|CubicBezierCurve|CubicBezierCurve3|")) {
        const char *frames="ujs/tests/curve-family-bezier-frames-struct.cx";
        const char *fixture="ujs/practice/uxe/test/curve-family-bezier-frames-r160.html";
        const char *life="ujs/practice/uxe/base/curve-family-lifecycle.ujs";
        tx_snprintf(proof,sizeof proof,"function %sClass_init(",r->name);
        return starts(evidence,"G-struct curve-family-class-struct.cx") &&
            tx_eqz(methods,"constructor,getPoint,getPointAt,getPoints,getSpacedPoints,getLength,getLengths,updateArcLengths,getUtoTmapping,getTangent,getTangentAt,computeFrenetFrames,copy,clone,toJSON,fromJSON") &&
            capability_contains("ujs/practice/uxe/base/curve-family-classes.ujs",proof,"CurveFamily_init(") &&
            capability_contains("ujs/tests/curve-family-class-struct.cx","--class","G_STRUCT Curve family class") &&
            capability_contains("ujs/tests/curve-family-lifecycle-struct.cx","--class","--mutate") &&
            capability_contains(life,"function CurveFamily_copy(","function CurveFamily_clone(") &&
            capability_contains(life,"function CurveFamily_toJSON(","function CurveFamily_fromJSON(") &&
            capability_contains(frames,"--class","--mutate") && capability_contains(fixture,r->name,"computeFrenetFrames(");
    }
    if(r->lane=='A' && tx_eqz(r->milestone,"M3") && tx_eqz(r->name,"LineCurve")) {
        const char *life="ujs/practice/uxe/base/curve-family-lifecycle.ujs";
        const char *classGate="ujs/tests/curve-family-class-struct.cx";
        const char *edgeGate="ujs/tests/curve-family-line-edge-struct.cx";
        const char *lifeGate="ujs/tests/curve-family-lifecycle-struct.cx";
        return starts(evidence,"G-struct curve-family-class-struct.cx") &&
            tx_eqz(methods,"constructor,getPoint,getPointAt,getPoints,getSpacedPoints,getLength,getLengths,updateArcLengths,getUtoTmapping,getTangent,getTangentAt,computeFrenetFrames,copy,clone,toJSON,fromJSON") &&
            capability_contains("ujs/practice/uxe/base/curve-family-classes.ujs","function LineCurveClass_init(","CurveFamily_init(") &&
            capability_contains(classGate,"--class","G_STRUCT Curve family class") &&
            capability_contains(edgeGate,"--frames","--mutate") &&
            capability_contains(lifeGate,"--class","--mutate") &&
            capability_contains(life,"function CurveFamily_copy(","function CurveFamily_clone(") &&
            capability_contains(life,"function CurveFamily_toJSON(","function CurveFamily_fromJSON(") &&
            capability_contains("ujs/practice/uxe/test/curve-family-line-edge-r160.html","LineCurve","computeFrenetFrames(") &&
            capability_contains("ujs/practice/uxe/test/curve-family-lifecycle-r160.html","LineCurve","fromJSON(");
    }
    if(r->lane=='A' && tx_eqz(r->milestone,"M3") && tx_eqz(r->name,"LineCurve3")) {
        const char *record="ujs/practice/uxe/base/linecurve3-class.ujs";
        const char *lifecycle="ujs/practice/uxe/base/linecurve3-lifecycle.ujs";
        const char *check="ujs/tests/linecurve3-lifecycle-struct.cx";
        return starts(evidence,"G-struct LineCurve3") &&
            tx_eqz(methods,"getPoint,getPointAt,getPoints,getSpacedPoints,getLengths,getLength,getTangent,getTangentAt,copy,clone,toJSON,fromJSON,updateArcLengths,constructor,getUtoTmapping,computeFrenetFrames") &&
            capability_contains(record,"function LineCurve3_init(","function LineCurve3_getUtoTmapping(") &&
            capability_contains(record,"function LineCurve3_computeFrenetFrames(","struct LineCurve3Record") &&
            capability_contains(lifecycle,"function LineCurve3_recordPointAt(","function LineCurve3_recordTangentAt(") &&
            capability_contains(lifecycle,"function LineCurve3_recordSpacedPoints(","function LineCurve3_recordLength(") &&
            capability_contains(lifecycle,"function LineCurve3_recordLengths(","function LineCurve3_updateArcLengths(") &&
            capability_contains(lifecycle,"function LineCurve3_copy(","function LineCurve3_clone(") &&
            capability_contains(lifecycle,"function LineCurve3_toJSON(","function LineCurve3_fromJSON(") &&
            capability_contains(check,"--identity-mutate","--json-mutate") &&
            capability_contains(check,"curve-control-layout.ujs","uxe_linecurve3_v1") &&
            capability_contains("ujs/practice/uxe/test/linecurve3-lifecycle-r160.html","new LineCurve3(","product.uxe_linecurve3_read");
    }
    if(r->lane!='A' || (!structure && !tx_eqz(r->milestone,"M1"))) return 0;
    tx_snprintf(proof,sizeof proof,"%s %s",structure?"G-struct":"G-math",r->name);
    if(!starts(evidence,proof)) return 0;
    int i=0;
    for(;r->name[i];i++) {
        char c=r->name[i];
        stem[i]=c>='A' && c<='Z' ? c+'a'-'A' : c;
    }
    stem[i]=0;
    tx_snprintf(path,sizeof path,"ujs/practice/uxe/base/%s.ujs",stem);
    int ok=!sy_read_file(path,&source_bytes,&source_size,100000) && capability_fixture(stem,r->name,structure);
    if(ok && tx_eqz(r->name,"Color")) {
        ok=!sy_read_file("ujs/practice/uxe/base/color-style.ujs",&extra,&extra_size,100000) &&
            capability_fixture("color-style","Color CSS",0);
    }
    if(ok && tx_eqz(r->name,"Box3")) ok=capability_fixture("box3-scene","Box3 objects",0);
    if(ok && tx_eqz(r->name,"Frustum")) ok=capability_fixture("frustum-scene","Frustum objects",0);
    if(ok && curve) {
        ok=!sy_read_file("ujs/practice/uxe/base/curve-json.ujs",&extra,&extra_size,100000) &&
            capability_fixture("curve-json","Curve JSON",1) &&
            capability_fixture("curve-frames","Curve Frenet",1) &&
            capability_contains("ujs/tests/curve-frames-struct.cx","--closed-mutate","curve-closed") &&
            capability_contains("ujs/practice/uxe/test/curve-closed-r160.html","computeFrenetFrames","r160");
    }
    if(ok && shape_path) {
        ok=tx_eqz(methods,"init,moveTo,lineTo,quadraticCurveTo,bezierCurveTo,splineThru,toShapes") &&
            capability_fixture("shapepath-spline","ShapePath spline",1) &&
            capability_fixture("shapepath-winding","ShapePath winding",1) &&
            capability_fixture("shapepath-holes","ShapePath hole ownership",1) &&
            capability_fixture("shapepath-boundary","ShapePath boundary",1) &&
            capability_contains("ujs/tests/shapepath-spline-struct.cx","--mutate","Path_clone") &&
            capability_contains("ujs/tests/shapepath-holes-struct.cx","--mutate","ShapePath_toShapes") &&
            capability_contains("ujs/tests/shapepath-boundary-struct.cx","--mutate","ShapePath_toShapes");
    }
    const char *at=methods;
    while(ok && *at) {
        const char *end=at;
        while(identifier(*end)) end++;
        if(end==at || (*end && *end!=',')) { ok=0; break; }
        tx_snprintf(proof,sizeof proof,"function %s_%.*s(",r->name,(int)(end-at),at);
        long length=tx_len(proof,sizeof proof);
        ok=tx_contains((const char *)source_bytes,source_size,proof,length) ||
            (extra && tx_contains((const char *)extra,extra_size,proof,length));
        if(!ok && curve && tx_same(at,end-at,"computeFrenetFrames",19))
            ok=capability_contains("ujs/practice/uxe/base/curve-frames.ujs",proof,"if(closed!=0)");
        at=*end?end+1:end;
    }
    mm_free(source_bytes); mm_free(extra);
    return ok;
}

static int read_facts(const char *path,unsigned char **data,int addon) {
    int64_t n=0;
    const char *fields=addon?"name\tcategory\tmilestone\tpriority\tr160_module\n":
        "name\tstate\tcategory\tmilestone\tpriority\tmethods\tevidence\n";
    if(sy_read_file(path,data,&n,64000) || !starts((char *)*data,fields)) return 1;
    char *at=(char *)*data+tx_len(fields,128);
    while(*at) {
        char *f[7];
        int cols=addon?5:7;
        for(int i=0;i<cols;i++) {
            f[i]=at;
            char sep=i==cols-1?'\n':'\t';
            while(*at && *at!='\n' && *at!='\t' && *at!='\r') at++;
            if(at==f[i] || *at!=sep) return 1;
            *at++=0;
        }
        if(addon) {
            Row *r=add(f[0],'C');
            if(!r || r->annotated || !good_milestone(f[2]) || !good_priority(f[3]) ||
               !ends(f[4],".js") || !contains(f[4],"/")) return 1;
            // Add-on membership is separate from implementation evidence.
            r->category=f[1];
            r->milestone=f[2];
            r->priority=f[3];
            r->evidence=f[4];
            continue;
        }
        if(!good_milestone(f[3]) || !good_priority(f[4]) ||
           !one_of(f[1],"|缺|部分|不适用|已有|")) return 1;
        // A family fact supplies the same contract to each named export.
        // Every member is independently resolved and checked for evidence.
        char *name=f[0];
        for(;;) {
            char *end=name;
            while(identifier(*end)) end++;
            if(end==name || (*end && *end!=',')) return 1;
            int more=*end==',';
            *end=0;
            Row *r=find_row(name);
            if(!r || r->annotated) return 1;
            r->category=f[2];
            r->milestone=f[3];
            r->priority=f[4];
            if(tx_eqz(f[1],"已有") && !capability_evidence(r,f[5],f[6])) return 1;
            if(tx_eqz(f[1],"不适用") &&
               !one_of(r->name,"|WebGL1Renderer|WebGPUCoordinateSystem|")) return 1;
            r->annotated=1;
            r->state=f[1];
            r->methods=f[5];
            r->evidence=f[6];
            if(!more) break;
            name=end+1;
        }
    }
    return 0;
}

static int method_mapping(const Row *r,char *out,int cap) {
    if(r->lane=='B' || tx_eqz(r->state,"不适用") || tx_eqz(r->methods,"待展开")) {
        return tx_snprintf(out,cap,"-")!=1;
    }
    if(r->lane=='A' && tx_eqz(r->name,"InstancedInterleavedBuffer") && tx_eqz(r->state,"已有")) {
        int n=tx_snprintf(out,cap,"InstancedInterleavedBuffer_new,InstancedInterleavedBuffer_copy,"
            "InstancedInterleaved_clone,InstancedInterleaved_toJSON");
        return n<0 || n>=cap;
    }
    const char *at=r->methods;
    int used=0;
    for(;;) {
        const char *end=at;
        while(identifier(*end)) end++;
        if(end==at || (*end && *end!=',')) return 1;
        int n=tx_snprintf(out+used,cap-used,"%s%s_%.*s",used?",":"",r->name,(int)(end-at),at);
        if(n<1 || n>=cap-used) return 1;
        used+=n;
        if(!*end) return 0;
        at=end+1;
    }
}

static int render(void) {
    int n=tx_snprintf(result,sizeof result,"%s",header);
    for(int i=0;i<count;i++) {
        Row *r=rows+i;
        char mapping[4096];
        if(method_mapping(r,mapping,sizeof mapping)) return -1;
        int w=tx_snprintf(result+n,sizeof result-n,"%c\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
            r->lane,r->category,r->name,r->state,r->evidence,r->priority,r->milestone,r->methods,mapping);
        if(w<0 || w>=(int)sizeof result-n) return -1;
        n+=w;
    }
    return n;
}
static int matches(const char *file,int n) {
    unsigned char *raw=0;
    int64_t size=0;
    int ok=!sy_read_file(file,&raw,&size,sizeof result) && tx_same((const char *)raw,size,result,n);
    mm_free(raw);
    return ok;
}

int main(int argc,char **argv) {
    if(argc!=2 || !one_of(argv[1],"|--write|--check|")) return 2;
    unsigned char *a=0,*b=0,*c=0,*d=0,*e=0,*s=0,*o=0,*k=0,*m=0,*i=0,*w=0,*t=0,*j=0,*format=0,*encoding=0,*color_tags=0;
    int rc=core() || read_facts(addons,&c,1) || read_facts(annotations,&a,0) ||
        read_facts(blendAnnotations,&b,0) || read_facts(equationAnnotations,&d,0) ||
        read_facts(depthAnnotations,&e,0) || read_facts(stencilAnnotations,&s,0) ||
        read_facts(stencilOpsAnnotations,&o,0) || read_facts(cullAnnotations,&k,0) ||
        read_facts(blendModeAnnotations,&m,0) || read_facts(sideAnnotations,&i,0) || read_facts(wrapAnnotations,&w,0) ||
        read_facts(filterAnnotations,&t,0) || read_facts(animationAnnotations,&j,0) ||
        read_facts("ujs/practice/uxe/base/gpu-texture-format-annotations.tsv",&format,0) ||
        read_facts("ujs/practice/uxe/base/gpu-color-encoding-annotations.tsv",&encoding,0) ||
        read_facts("ujs/practice/uxe/base/gpu-color-tags-annotations.tsv",&color_tags,0) || count!=446;
    int n=rc?-1:render();
    if(n<0) rc=1;
    if(!rc) rc=tx_eqz(argv[1],"--write")?sy_write_file(target,result,n,0644)!=0:!matches(target,n);
    if(n>=0) for(char lane='A';lane<='C';lane++) {
        int total=0,done=0,excluded=0,partial=0;
        for(int j=0;j<count;j++) if(rows[j].lane==lane) {
            total++;
            done+=tx_eqz(rows[j].state,"已有");
            excluded+=tx_eqz(rows[j].state,"不适用");
            partial+=tx_eqz(rows[j].state,"部分");
        }
        printf("THREE_INVENTORY lane=%c total=%d eligible=%d ready=%d partial=%d excluded=%d percent=%.2f\n",
            lane,total,total-excluded,done,partial,excluded,100.0*done/(total-excluded));
    }
    if(n>=0) {
        int math=0,verified=0;
        for(int i=0;i<count;i++) if(rows[i].lane=='A' && tx_eqz(rows[i].milestone,"M1")) {
            math++;
            verified+=tx_eqz(rows[i].state,"已有");
        }
        printf("THREE_INVENTORY milestone=M1 rows=%d ready=%d\n",math,verified);
    }
    printf("THREE_INVENTORY rows=%d failed=%d\n",count,rc);
    mm_free(a);
    mm_free(b);
    mm_free(c);
    mm_free(d);
    mm_free(e);
    mm_free(s);
    mm_free(o);
    mm_free(k);
    mm_free(m);
    mm_free(i);
    mm_free(w);
    mm_free(t);
    mm_free(j);
    mm_free(format);
    mm_free(encoding);
    mm_free(color_tags);
    return rc;
}
