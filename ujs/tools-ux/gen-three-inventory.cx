                capability_contains("ujs/tests/tone-modes-math.cx",cineon?"--cineon-mutate":agx?"--agx-mutate":"--aces-mutate","GpuMaterial_toneRgb") &&
                capability_contains("ujs/tests/gpu-packet-struct.cx","--tone-suite-mutate","GPU_PACKET") &&
                capability_contains("ujs/practice/uxe/test/gpu-packet-r160.html",r->name,"renderer.toneMapping = mapping");
        }
        if(!structure || !tx_eqz(methods,"-") ||
            !(ends(r->name,"Usage") || ends(r->name,"Type")) ||
            !starts(evidence,"G-struct BufferConstants")) return 0;
        tx_snprintf(proof,sizeof proof,"function %s()",r->name);
        int ok=!sy_read_file("ujs/practice/uxe/base/bufferconstants.ujs",&source_bytes,&source_size,10000) &&
            tx_contains((const char *)source_bytes,source_size,proof,tx_len(proof,sizeof proof)) &&
