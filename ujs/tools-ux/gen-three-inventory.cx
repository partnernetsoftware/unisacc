            tx_eqz(methods,"constructor,saveOriginalState,accumulate,accumulateAdditive,apply,restoreOriginalState") &&
            capability_contains(base,"function PropertyMixer_construct(","function PropertyMixer_saveBound(") &&
            capability_contains(base,"function PropertyMixer_addBound(","function PropertyMixer_applyBound(") &&
            capability_contains(base,"function PropertyMixer_restoreBound(","PropertyMixer_quaternionAdd(") &&
