static const char header[]="lane\tcategory\tname\tstate\tevidence\tpriority\tmilestone\tmethods\tuxe_api\n";

typedef struct {
    char lane;
    char name[100];
    const char *category,*state,*evidence,*priority,*milestone,*methods;
    int annotated;
} Row;
static Row rows[446];
static int count;
static char result[160000];

static int starts(const char *s,const char *p) {
    return tx_prefixz(s,p,tx_len(p,256));
}
static int ends(const char *s,const char *tail) {
    long n=tx_len(s,16000),k=tx_len(tail,16000);
    return n>=0 && k>=0 && n>=k && tx_eqz(s+n-k,tail);
}
static int contains(const char *s,const char *word) {
    return tx_contains(s,tx_len(s,16000),word,tx_len(word,16000));
}
static int one_of(const char *s,const char *names) {
    char key[110];
    int n=tx_snprintf(key,sizeof key,"|%s|",s);
    return n>0 && n<(int)sizeof key && contains(names,key);
}
static int identifier(int c) {
    return (c>='A' && c<='Z') || (c>='a' && c<='z') || (c>='0' && c<='9') || c=='_';
}
static Row *find_row(const char *name) {
    for(int i=0;i<count;i++) if(tx_eqz(rows[i].name,name)) return rows+i;
    return 0;
}
static Row *add(const char *name,char lane) {
    if(count==(int)(sizeof rows/sizeof rows[0]) || find_row(name)) return 0;
    Row *r=rows+count;
    int n=tx_snprintf(r->name,sizeof r->name,"%s",name);
    if(n<=0 || n>=(int)sizeof r->name) return 0;
    count++;
    r->lane=lane;
    r->state="缺";
    r->priority="P2";
    r->evidence="未登记可复用接口与独立门";
    r->methods=lane=='B'?"-":"待展开";
    return r;
}

static void classify(Row *r) {
    const char *n=r->name;
    r->category=r->lane=='B'?"通用常量":"核心";
    r->milestone="M2";
    if(r->lane=='B') {
        if(ends(n,"Usage") || ends(n,"Type")) return;
        if(ends(n,"BlendMode") || starts(n,"Loop") || starts(n,"Interpolate") || ends(n,"Ending")) {
            r->category="动画常量"; r->milestone="M8"; return;
        }
        if(ends(n,"BindMode")) { r->category="网格常量"; r->milestone="M7"; return; }
        if(tx_eqz(n,"MOUSE") || tx_eqz(n,"TOUCH")) { r->category="输入常量"; r->milestone="M10"; return; }
        if(ends(n,"ShadowMap")) { r->category="阴影常量"; r->milestone="M6"; return; }
        if(ends(n,"Format") || ends(n,"Mapping") || ends(n,"Wrapping") || ends(n,"Filter") ||
           ends(n,"ColorSpace") || ends(n,"Encoding") || ends(n,"Transfer") || ends(n,"Primaries") ||
           ends(n,"NormalMap")) { r->category="材质纹理常量"; r->milestone="M5"; return; }
        if(!tx_eqz(n,"REVISION")) { r->category="渲染常量"; r->milestone="M4"; }
        return;
    }
    if(ends(n,"Loader") || ends(n,"LoadingManager") || tx_eqz(n,"LoaderUtils")) {
        r->category="加载"; r->milestone="M9";
    } else if(contains(n,"Camera")) {
        r->category="相机"; r->milestone=ends(n,"Helper")?"M11":"M3";
    } else if(ends(n,"Helper") || starts(n,"Audio") || tx_eqz(n,"PositionalAudio")) {
        r->category=ends(n,"Helper")?"辅助":"音频"; r->milestone="M11";
    } else if(ends(n,"Geometry") || contains(n,"Curve") || one_of(n,"|Path|Shape|ShapePath|ShapeUtils|")) {
        if(!starts(n,"Buffer") && !starts(n,"Instanced")) { r->category="几何"; r->milestone="M3"; }
    } else if(ends(n,"Material") || ends(n,"Texture") || one_of(n,"|ColorManagement|ImageUtils|")) {
        r->category=ends(n,"Texture")?"纹理":"材质"; r->milestone="M5";
    } else if(ends(n,"Light") || starts(n,"Fog") || one_of(n,"|LightProbe|PMREMGenerator|")) {
        r->category="灯光"; r->milestone="M6";
    } else if(starts(n,"Animation") || ends(n,"KeyframeTrack") || starts(n,"Property") || ends(n,"Interpolant")) {
        r->category="动画"; r->milestone="M8";
    } else if(ends(n,"Mesh") || one_of(n,"|LOD|Bone|Skeleton|Sprite|Points|Line|LineSegments|LineLoop|")) {
        r->category="网格"; r->milestone="M7";
    } else if(tx_eqz(n,"Raycaster")) {
        r->category="拾取"; r->milestone="M10";
    } else if(starts(n,"WebGL") || starts(n,"Shader") || starts(n,"Uniforms") ||
              one_of(n,"|RenderTarget|createCanvasElement|")) {
        r->category="渲染"; r->milestone="M4";
    } else if(starts(n,"Vector") || starts(n,"Matrix") ||
              one_of(n,"|Box2|Box3|Color|Cylindrical|Euler|Frustum|Line3|MathUtils|Plane|Quaternion|Ray|Sphere|Spherical|SphericalHarmonics3|Triangle|")) {
        r->category="数学"; r->milestone="M1";
    }
}

static void classify_declarations(const char *s,const char *limit) {
    const char *line=s;
    while(line<limit) {
        const char *start=0;
        if(starts(line,"class ")) start=line+6;
        if(starts(line,"function ")) start=line+9;
        if(start) {
            const char *end=start;
            char name[100];
            while(identifier(*end)) end++;
            if(end>start && end-start<(long)sizeof name) {
                tx_snprintf(name,sizeof name,"%.*s",(int)(end-start),start);
                Row *r=find_row(name);
                if(r) { r->lane='A'; r->methods="待展开"; }
            }
        }
        while(line<limit && *line!='\n') line++;
        if(line<limit) line++;
    }
}

static int core(void) {
    unsigned char *raw=0;
    int64_t size=0;
    char hash[65];
    int rc=1;
    if(sy_read_file(source,&raw,&size,4000000)) return 1;
    const char *s=(const char *)raw;
    if(sy_sha256_any_hex(raw,size,hash) || !tx_eqz(hash,digest) ||
       !tx_contains(s,size,"const REVISION = '160';",23)) goto done;
    long offset=tx_find(s,size,"\nexport { ",10);
    if(offset<0) goto done;
    const char *at=s+offset+10;
    for(;;) {
        char name[100];
        const char *start=at;
        while(identifier(*at)) at++;
        if(at==start || at-start>=(long)sizeof name) goto done;
        tx_snprintf(name,sizeof name,"%.*s",(int)(at-start),start);
        int namespace=one_of(name,"|AnimationUtils|Cache|ColorManagement|DataUtils|DefaultLoadingManager|MathUtils|ShaderChunk|ShaderLib|UniformsLib|UniformsUtils|");
        if(!add(name,namespace?'A':'B')) goto done;
        if(*at==' ' && at[1]=='}' && at[2]==';') break;
        if(*at!=',' || at[1]!=' ') goto done;
        at+=2;
    }
    classify_declarations(s,s+offset);
    for(int i=0;i<count;i++) classify(rows+i);
    rc=count!=416;
done:
    mm_free(raw);
    return rc;
}

static int good_priority(const char *s) {
    return s[0]=='P' && s[1]>='0' && s[1]<='2' && !s[2];
}
static int good_milestone(const char *s) {
    return one_of(s,"|M1|M2|M3|M4|M5|M6|M7|M8|M9|M10|M11|M12|");
}

static int capability_fixture(const char *stem,const char *label,int structure) {
    char path[220],proof[145];
    unsigned char *gate=0,*reference=0;
    int64_t gate_size=0,reference_size=0;
    tx_snprintf(path,sizeof path,"ujs/tests/%s-%s.cx",stem,structure?"struct":"math");
    int ok=!sy_read_file(path,&gate,&gate_size,100000);
    tx_snprintf(path,sizeof path,"ujs/practice/uxe/test/%s-r160.html",stem);
    ok=ok && !sy_read_file(path,&reference,&reference_size,100000);
    if(ok) {
        tx_snprintf(proof,sizeof proof,"%s %s",structure?"G_STRUCT":"G_MATH",label);
        ok=tx_contains((const char *)gate,gate_size,proof,tx_len(proof,sizeof proof)) &&
            tx_contains((const char *)reference,reference_size,"three.module.js",15);
    }
    mm_free(gate); mm_free(reference);
    return ok;
}

static int capability_contains(const char *path,const char *first,const char *second) {
    unsigned char *text=0;
    int64_t size=0;
    int ok=!sy_read_file(path,&text,&size,100000) &&
        tx_contains((const char *)text,size,first,tx_len(first,200)) &&
        tx_contains((const char *)text,size,second,tx_len(second,200));
    mm_free(text);
    return ok;
}

static int scalar_attribute(const char *name) {
    return one_of(name,"|BufferAttribute|Uint8BufferAttribute|Int8BufferAttribute|Uint8ClampedBufferAttribute|Uint16BufferAttribute|Int16BufferAttribute|Uint32BufferAttribute|Int32BufferAttribute|Float16BufferAttribute|Float32BufferAttribute|Float64BufferAttribute|");
}

static int capability_evidence(const Row *r, const char *methods, const char *evidence) {
    char stem[100], path[220], proof[145];
    unsigned char *source_bytes=0,*extra=0;
    int64_t source_size=0,extra_size=0;
    if(r->lane=='A' && one_of(r->name,"|LineBasicMaterial|PointsMaterial|SpriteMaterial|")) {
        return tx_find(methods,tx_len(methods,512),"init,copy,toJSON,fromJSON,",26)==0 &&
            capability_contains("ujs/practice/uxe/base/point-line-sprite-material.ujs","native function PointsMaterial_init(","native function PointLineSprite_copy(") &&
            capability_contains("ujs/practice/uxe/base/point-line-sprite-material-json.ujs","native function PointLineSprite_writeJSON(","native function PointLineSprite_readJSON(") &&
            capability_contains("ujs/tests/point-line-sprite-material-json.cx","--mutate","count=420");
    }
    if(r->lane=='A' && one_of(r->name,"|ShaderMaterial|RawShaderMaterial|")) {
        return tx_eqz(methods,"init,toJSON,fromJSON,vertexShader,fragmentShader") &&
            capability_contains("ujs/practice/uxe/base/shader-material-object.ujs","ShaderMaterial_init(","RawShaderMaterial_init(") &&
            capability_contains("ujs/practice/uxe/base/shader-material-object-json.ujs","ShaderMaterial_writeJSON(","ShaderMaterial_readJSON(") &&
            capability_contains("ujs/tests/shader-material-object-json.cx","--mutate","shader-material-object-r160.html");
    }
    if(r->lane=='A' && tx_eqz(r->name,"FileLoader")) {
        return tx_eqz(methods,"load,loadAsync") &&
            capability_contains("ujs/practice/uxe/base/fileloader.ujs","FileLoader_begin(","FileLoader_receive(") &&
            capability_contains("ujs/tests/fileloader-io.cx","--mutate","FileLoader_release(") &&
            capability_contains("ujs/practice/uxe/test/fileloader-r160.html","new FileLoader(",".loadAsync(");
    }
    if(r->lane=='A' && one_of(r->name,"|NumberKeyframeTrack|VectorKeyframeTrack|ColorKeyframeTrack|QuaternionKeyframeTrack|BooleanKeyframeTrack|StringKeyframeTrack|")) {
        return tx_eqz(methods,"createInterpolant,toJSON,fromJSON") &&
            starts(evidence,"G-anim keyframe-track-json-anim.cx") &&
            capability_contains("ujs/practice/uxe/base/keyframe-track-json-read.ujs",
                "KeyframeTrack_fromJSON(","KeyframeTrack_init(") &&
            capability_contains("ujs/practice/uxe/base/keyframe-track-json-write.ujs",
                "KeyframeTrack_toJSON(","KeyframeTrack.interpolation") &&
            capability_contains("ujs/tests/keyframe-track-json-anim.cx","--mutate","KeyframeTrack_fromJSON") &&
            capability_contains("ujs/practice/uxe/test/keyframe-track-json-r160.html",r->name,"AnimationClip.parse(");
    }
    if(r->lane=='A' && tx_eqz(r->name,"ArrayCamera")) {
        return tx_eqz(methods,"init,getCamera,clone,toJSON,fromJSON") &&
            starts(evidence,"G-struct arraycamera-object-json-struct.cx") &&
            capability_contains("ujs/practice/uxe/base/arraycamera-object-json.ujs",
                "ArrayCamera_toJSON(","ArrayCamera_fromJSON(") &&
            capability_contains("ujs/tests/arraycamera-object-json-struct.cx","--mutate","r160_wait_read(") &&
            capability_contains("ujs/practice/uxe/test/arraycamera-object-json-base.ujs","ArrayCamera_getCamera(","selected_case==6") &&
            capability_contains("ujs/practice/uxe/test/arraycamera-object-json-r160.html","new ArrayCamera(","source.cameras");
    }
    if(r->lane=='A' && tx_eqz(r->name,"OrthographicCamera")) {
        return tx_eqz(methods,"init,updateProjectionMatrix,copy,clone,toJSON,fromJSON") &&
            starts(evidence,"G-struct orthographiccamera-object-json-struct.cx") &&
            capability_contains("ujs/practice/uxe/base/orthographiccamera-object-json.ujs",
                "OrthographicCamera_toJSON(","OrthographicCamera_fromJSON(") &&
            capability_contains("ujs/tests/orthographiccamera-object-json-struct.cx","--mutate","OrthographicCamera_updateProjectionMatrix(") &&
            capability_contains("ujs/practice/uxe/test/orthographiccamera-object-json-r160.html","new OrthographicCamera(","new ObjectLoader()");
    }
    if(r->lane=='A' && tx_eqz(r->name,"PerspectiveCamera")) {
        return tx_eqz(methods,"init,updateProjectionMatrix,copy,clone,toJSON,fromJSON") &&
            starts(evidence,"G-struct perspectivecamera-object-json-struct.cx") &&
            capability_contains("ujs/practice/uxe/base/perspectivecamera-object-json.ujs",
                "PerspectiveCamera_toJSON(","PerspectiveCamera_fromJSON(") &&
            capability_contains("ujs/tests/perspectivecamera-object-json-struct.cx","--mutate","PerspectiveCamera_updateProjectionMatrix(") &&
            capability_contains("ujs/practice/uxe/test/perspectivecamera-object-json-r160.html","new PerspectiveCamera(","new ObjectLoader()");
    }
    if(r->lane=='A' && tx_eqz(r->name,"Camera")) {
        return tx_eqz(methods,"init,copy,clone,syncObject,toJSON,fromJSON") &&
            starts(evidence,"G-struct camera-object-json-struct.cx") &&
            capability_contains("ujs/practice/uxe/base/camera-object-json.ujs","Camera_toJSON(","Camera_fromJSON(") &&
            capability_contains("ujs/tests/camera-object-json-struct.cx","--mutate","Camera_syncObject(") &&
            capability_contains("ujs/practice/uxe/test/camera-object-json-r160.html","new Camera()","new ObjectLoader()");
    }
    if(r->lane=='A' && tx_eqz(r->name,"AnimationMixer")) {
        return tx_eqz(methods,"update,setTime,stopAllAction") && starts(evidence,"G-anim animationmixer-anim.cx") &&
            capability_contains("ujs/practice/uxe/base/animationmixer-object-api.ujs",
                "AnimationMixer_setTime(","AnimationMixer_update(") &&
            capability_contains("ujs/tests/animationmixer-anim.cx","--seek-mutate","AnimationMixer_setTime(") &&
            capability_contains("ujs/practice/uxe/test/animationmixer-r160.html","mixer.setTime(","mixer.clipAction(");
