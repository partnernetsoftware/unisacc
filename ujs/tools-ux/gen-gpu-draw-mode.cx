#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

static int publish(const char *path,const char *data,int n,int write) {
    if(write) return sy_write_file(path,data,n,0644)!=0;
    unsigned char *previous=0;
    int64_t bytes=0;
    int bad=sy_read_file(path,&previous,&bytes,4096) || !tx_same((const char *)previous,bytes,data,n);
    mm_free(previous);
    return bad;
}

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    const int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char *names[]={"TrianglesDrawMode","TriangleStripDrawMode","TriangleFanDrawMode"};
    unsigned char *facts=0,*r160=0;
    int64_t size=0,ref_size=0;
    int bad=sy_read_file("ujs/plans/ux-three-b-semantic-facts.tsv",&facts,&size,16000) ||
        sy_read_file("ujs/practice/web/game/three.module.js",&r160,&ref_size,4000000);
    char text[1900],pattern[100];
    int n=tx_snprintf(text,sizeof text,
        "// Generated by gen-gpu-draw-mode.cx.\n"
        "native function GpuDraw_triangleList(mode:i64,vertices:i64,indices:i64,width:i64,count:i64,out:i64,capacity:i64) i64 {\n");
    for(int i=0;!bad && i<3;i++) {
        int len=tx_snprintf(pattern,sizeof pattern,"\nB\t%s\t%d\t",names[i],i);
        const long at=tx_find((const char *)facts,size,pattern,len);
        len=tx_snprintf(pattern,sizeof pattern,"const %s = %d;",names[i],i);
        if(at<0 || !tx_contains((const char *)r160,ref_size,pattern,len)) { bad=1; break; }
        len=tx_snprintf(text+n,sizeof text-n,
            "  if(mode==%d) { return GltfLoader_triangles(%d,vertices,indices,width,count,out,capacity); } // %s\n",
            i,4+i+(mutate && i==1),names[i]);
        if(len<=0 || len>=sizeof text-n) { bad=1; break; }
        n+=len;
    }
    if(!bad) {
        int end=tx_snprintf(text+n,sizeof text-n,"  return 0-1;\n}\n");
        if(end<=0 || end>=sizeof text-n) bad=1;
        else n+=end;
    }
    const char notes[]="name\tstate\tcategory\tmilestone\tpriority\tmethods\tevidence\n"
        "TrianglesDrawMode,TriangleStripDrawMode,TriangleFanDrawMode\t已有\t渲染常量\tM4\tP2\t-\t"
        "G-struct GPU_TRIANGLE_MODES；r160 转换后的两个三角面索引读回，独立绕向金值与逐模式篡改\n";
    bad=bad || publish("ujs/practice/uxe/base/gpu-draw-mode-generated.ujs",text,n,write) ||
        publish("ujs/practice/uxe/base/gpu-draw-mode-annotations.tsv",notes,sizeof notes-1,write);
    printf("GPU_TRIANGLE_MODES generated=3 failed=%d\n",bad);
    mm_free(facts); mm_free(r160);
    return bad;
}
