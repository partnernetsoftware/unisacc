#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

static int find_value(const char *facts,int64_t size,const char *ref,int64_t ref_size,const char *name) {
    char key[64],decl[96];
    const int n=tx_snprintf(key,sizeof key,"\nB\t%s\t",name);
    const long pos=tx_find(facts,size,key,n);
    if(pos<0) return -1;
    const char *start=facts+pos+n;
    char *end=0;
    const long value=tx_strtol(start,&end,10);
    if(end==start || *end!='\t' || value<1 || value>65535 ||
       tx_find(end,size-(end-facts),key,n)>=0) return -1;
    const int bytes=tx_snprintf(decl,sizeof decl,"const %s = %ld;",name,value);
    return bytes>0 && tx_contains(ref,ref_size,decl,bytes)?(int)value:-1;
}

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    const int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char *path="ujs/practice/uxe/base/gpu-texture-format-generated.ujs";
    unsigned char *facts=0,*reference=0,*previous=0;
    int64_t size=0,ref_size=0,old=0;
    int bad=sy_read_file("ujs/plans/ux-three-b-semantic-facts.tsv",&facts,&size,14000) ||
        sy_read_file("ujs/practice/web/game/three.module.js",&reference,&ref_size,4000000);
    int rgba=bad?-1:find_value((const char *)facts,size,(const char *)reference,ref_size,"RGBAFormat");
    int uv=bad?-1:find_value((const char *)facts,size,(const char *)reference,ref_size,"UVMapping");
    char output[2500];
    const int bytes=tx_snprintf(output,sizeof output,
        "// Generated by gen-gpu-texture-format.cx.\n"
        "native function GpuTexture_readFormat(format:i64,address:i64,width:i64,height:i64,u:f64,v:f64) i64 {\n"
        "  if(format!=%d) { return 0-2; } // RGBAFormat\n"
        "  return GpuTexture_nearestRgba8(address,width,height,u,v);\n"
        "}\n"
        "native function GpuTexture_mapUv(mapping:i64,out:i64,matrix:i64,u:f64,v:f64) i64 {\n"
        "  if(mapping==%d) { return GpuTexture_transformUv(out,matrix,u,v); } // UVMapping\n"
        "  if(out<0 || out%%8!=0 || out>6291456-16) { return 0-1; }\n"
        "  let x=ux_f64_put(out,u);\n  let y=ux_f64_put(out+8,v);\n  return out;\n"
        "}\n",rgba+mutate,uv);
    bad=bad || rgba<0 || uv<0 || bytes<0 || bytes>=sizeof output;
    if(!bad) bad=write?sy_write_file(path,output,bytes,0644)!=0:
        sy_read_file(path,&previous,&old,sizeof output) || !tx_same((const char *)previous,old,output,bytes);
    const char notes[]="name\tstate\tcategory\tmilestone\tpriority\tmethods\tevidence\n"
        "RGBAFormat,UVMapping\t已有\t渲染常量\tM4\tP2\t-\t"
        "G-struct GPU_TEXTURE_FORMAT；RGBA8 纹素和 UV 矩阵同输入 r160 对照，"
        "独立金值和两个语义篡改\n";
    const char *annotation="ujs/practice/uxe/base/gpu-texture-format-annotations.tsv";
    if(!bad) {
        mm_free(previous);
        previous=0;
        bad=write?sy_write_file(annotation,notes,sizeof notes-1,0644)!=0:
            sy_read_file(annotation,&previous,&old,sizeof notes) ||
            !tx_same((const char *)previous,old,notes,sizeof notes-1);
    }
    printf("GPU_TEXTURE_FORMAT generated=2 failed=%d\n",bad);
    mm_free(facts); mm_free(reference); mm_free(previous);
    return bad;
}
