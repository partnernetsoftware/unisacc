#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

static int publish(const char *path,const char *data,int n,int write) {
    if(write) return sy_write_file(path,data,n,0644)!=0;
    unsigned char *old=0;
    int64_t bytes=0;
    const int fail=sy_read_file(path,&old,&bytes,16000) || !tx_same((const char *)old,bytes,data,n);
    mm_free(old);
    return fail;
}

static int add(char *dst,int cap,int used,const char *text) {
    const int n=tx_snprintf(dst+used,cap-used,"%s",text);
    return n<0 || n>=cap-used?-1:used+n;
}

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    const int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    unsigned char *facts=0,*r160=0;
    int64_t bytes=0,refBytes=0;
    int failed=sy_read_file("ujs/plans/ux-three-b-semantic-facts.tsv",&facts,&bytes,12000) ||
        sy_read_file("ujs/practice/web/game/three.module.js",&r160,&refBytes,4000000);
    char source[4096],fixture[1600],notes[2600],line[220];
    int used=tx_snprintf(source,sizeof source,
        "// Generated by gen-gpu-material-sides.cx.\n"
        "native function GpuMaterialSide_apply(state:i64,value:i64) i64 {\n"
        "  if(state<0 || state%%4!=0 || state>6291456-GpuRenderState.size) { return 0-1; }\n");
    int listed=tx_snprintf(fixture,sizeof fixture,"name\tvalue\n");
    int count=0;
    int noteSize=tx_snprintf(notes,sizeof notes,"name\tstate\tcategory\tmilestone\tpriority\tmethods\tevidence\n");
    for(int64_t row=0;!failed && row<bytes;) {
        int64_t end=row;
        while(end<bytes && facts[end]!='\n') end++;
        const char field[]="\tGpuRenderState.cull\t";
        if(tx_contains((const char *)facts+row,end-row,field,sizeof field-1)) {
            int64_t suffix=row+2;
            while(suffix<end && facts[suffix]!='\t') suffix++;
            char name[64],*after=0;
            const int nn=tx_snprintf(name,sizeof name,"%.*s",(int)(suffix-row-2),facts+row+2);
            const long number=suffix<end?tx_strtol((const char *)facts+suffix+1,&after,10):-1;
            if(nn<=0 || nn>=sizeof name || number!=count || !after ||
               !tx_prefix(after,end-(after-(char *)facts),field,sizeof field-1)) { failed=1; break; }
            char *mappedEnd=0;
            const long actual=tx_strtol(after+sizeof field-1,&mappedEnd,10);
            if(!mappedEnd || *mappedEnd!='\t' || actual<0 || actual>2) { failed=1; break; }
            const int declaration=tx_snprintf(line,sizeof line,"const %s = %ld;",name,number);
            if(declaration<1 || !tx_contains((const char *)r160,refBytes,line,declaration)) {
                failed=1; break;
            }
            const long mapped=mutate && number==2?1:actual;
            tx_snprintf(line,sizeof line,"  if(value==%ld) { return ux_u32_put(state+GpuRenderState.cull,%ld); }\n",number,mapped);
            used=add(source,sizeof source,used,line);
            tx_snprintf(line,sizeof line,"%s\t%ld\n",name,number);
            listed=add(fixture,sizeof fixture,listed,line);
            tx_snprintf(line,sizeof line,"%s%s",count?",":"",name);
            noteSize=add(notes,sizeof notes,noteSize,line);
            if(used<0 || listed<0 || noteSize<0) { failed=1; break; }
            count++;
        }
        row=end+1;
    }
    const char legacy[]="const TwoPassDoubleSide = 2;";
    if(!failed && !tx_contains((const char *)r160,refBytes,legacy,sizeof legacy-1)) failed=1;
    if(!failed && count==3) {
        used=add(source,sizeof source,used,"  return 0-2;\n}\n");
        if(used>=0) used=add(source,sizeof source,used,
            "native function GpuMaterial_twoPassTag() i64 { return 2; }\n");
        noteSize=add(notes,sizeof notes,noteSize,
            "\t已有\t渲染常量\tM4\tP2\t-\tG-pixel GPU_MATERIAL_SIDES；正反绕序三角形的 WebGL2 与 r160 逐通道对照，独立 .cx 金值，等价映射篡改与像素反例非零\n");
        failed=used<0 || noteSize<0 ||
            publish("ujs/practice/uxe/base/gpu-material-sides-generated.ujs",source,used,write) ||
            publish("ujs/practice/uxe/test/gpu-material-sides-generated.tsv",fixture,listed,write) ||
            publish("ujs/practice/uxe/base/gpu-material-sides-annotations.tsv",notes,noteSize,write);
    } else failed=1;
    printf("GPU_MATERIAL_SIDES_GEN rows=%d failed=%d\n",count,failed);
    mm_free(facts);
    mm_free(r160);
    return failed;
}
