#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    const int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char *target="ujs/practice/uxe/base/gpu-legacy-format-generated.ujs";
    unsigned char *table=0,*reference=0,*previous=0;
    int64_t size=0,ref_size=0,old=0;
    int failed=sy_read_file("ujs/practice/uxe/base/gpu-legacy-format.tsv",&table,&size,1500) ||
        sy_read_file("ujs/practice/web/game/three.module.js",&reference,&ref_size,4000000);
    const char header[]="name\tvalue\tchannels\tred\tgreen\tblue\talpha\n";
    if(!failed) failed=size<(int64_t)sizeof header || !tx_same((const char *)table,sizeof header-1,header,sizeof header-1);
    char output[1400];
    int used=tx_snprintf(output,sizeof output,
        "// Generated by gen-gpu-legacy-format.cx.\n"
        "native function GpuLegacyTexture_sample(format:i64,address:i64,width:i64,height:i64,u:f64,v:f64) i64 {\n");
    const char *names[]={"AlphaFormat","LuminanceFormat","LuminanceAlphaFormat"};
    int count=0;
    for(int64_t row=sizeof header-1;!failed && row<size;) {
        int64_t end=row,tab=row;
        while(end<size && table[end]!='\n') end++;
        while(tab<end && table[tab]!='\t') tab++;
        if(count>=3 || tab==end || !tx_same((const char *)table+row,tab-row,names[count],tx_len(names[count],40))) {
            failed=1;
            break;
        }
        long values[6]={0};
        const char *at=(const char *)table+tab+1;
        for(int i=0;i<6;i++) {
            char *after=0;
            values[i]=tx_strtol(at,&after,10);
            if(after==at || after-(const char *)table>end || *after!=(i==5?'\n':'\t')) {
                failed=1;
                break;
            }
            at=after+1;
        }
        const long width=values[1];
        char decl[96];
        const int n=tx_snprintf(decl,sizeof decl,"const %s = %ld;",names[count],values[0]);
        if(failed || width<1 || width>2 || values[0]<1 || values[0]>65535 ||
           !tx_contains((const char *)reference,ref_size,decl,n)) { failed=1; break; }
        long layout=width-1,scale=2;
        for(int i=2;i<6;i++) {
            if(values[i]<-2 || values[i]>=width) failed=1;
            layout+=(values[i]+2)*scale;
            scale*=4;
        }
        if(failed) break;
        if(mutate && count==0) layout=0;
        const int emitted=tx_snprintf(output+used,sizeof output-used,
            "  if(format==%ld) { return gpu_legacy_texture_pixel(%ld,address,width,height,u,v); } // %s\n",
            values[0],layout,names[count]);
        if(emitted<0 || emitted>=(int)sizeof output-used) { failed=1; break; }
        used+=emitted;
        count++;
        row=end+1;
    }
    if(!failed && count==3) {
        used+=tx_snprintf(output+used,sizeof output-used,"  return 0-2;\n}\n");
        failed=write?sy_write_file(target,output,used,0644)!=0:
            sy_read_file(target,&previous,&old,sizeof output) || !tx_same((const char *)previous,old,output,used);
    } else failed=1;
    mm_free(table); mm_free(reference); mm_free(previous);
    printf("GPU_LEGACY_FORMAT formats=%d failed=%d\n",count,failed);
    return failed;
}
