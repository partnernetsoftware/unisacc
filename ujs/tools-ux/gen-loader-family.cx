#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

static const char facts[]="ujs/practice/uxe/base/loader-family-layout.tsv";
static const char generated[]="ujs/practice/uxe/base/loader-family-classes.ujs";

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    if(!write && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    unsigned char *raw=0;
    int64_t bytes=0;
    if(sy_read_file(facts,&raw,&bytes,2048)) return 2;
    const char header[]="kind\tclass\n";
    if(bytes<(int64_t)sizeof header || !tx_same((char *)raw,sizeof header-1,header,sizeof header-1)) {
        mm_free(raw);
        return 2;
    }
    const char *line=(char *)raw+sizeof header-1;
    const char *end=(char *)raw+bytes;
    const char *names[13]={0};
    long lengths[13]={0};
    char output[4096];
    int used=tx_snprintf(output,sizeof output,
        "// Generated by gen-loader-family.cx from loader-family-layout.tsv.\n");
    int count=0;
    while(line<end && count<13) {
        const long newline=tx_find(line,end-line,"\n",1);
        char *tab=0;
        const long kind=tx_strtol(line,&tab,10);
        if(newline<0 || kind!=count+1 || tab==line || *tab!='\t') break;
        const char *name=tab+1;
        const long length=line+newline-name;
        if(length<6 || length>24 || !tx_same(name+length-6,6,"Loader",6)) break;
        int valid=name[0]>='A' && name[0]<='Z';
        for(int i=1;i<length;i++) {
            if(!((name[i]>='A' && name[i]<='Z') || (name[i]>='a' && name[i]<='z'))) valid=0;
        }
        for(int i=0;i<count;i++) if(tx_same(name,length,names[i],lengths[i])) valid=0;
        if((kind==1 && !tx_same(name,length,"Loader",6)) ||
           (kind==2 && !tx_same(name,length,"FileLoader",10)) || !valid) break;
        const int result=tx_snprintf(output+used,sizeof output-used,
            "native function %.*s_family(instance:i64,base:i64,manager:i64) i64 {\n"
            "  return loader_family_init(instance,base,manager,%ld);\n}\n",
            (int)length,name,kind);
        if(result<0 || result>=(int)sizeof output-used) break;
        used+=result;
        names[count]=name;
        lengths[count]=length;
        count++;
        line+=newline+1;
    }
    const int valid=count==13 && line==end;
    mm_free(raw);
    if(!valid) return 2;
    if(write) return sy_write_file(generated,output,used,0644)!=0;
    if(sy_read_file(generated,&raw,&bytes,sizeof output)) return 1;
    const int failed=!tx_same((char *)raw,bytes,output,used);
    mm_free(raw);
    printf("LOADER_FAMILY_GENERATED classes=%d failed=%d\n",count,failed);
    return failed;
}
