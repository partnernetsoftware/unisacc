#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

static const char facts[]="ujs/practice/uxe/base/curve-family-layout.tsv";
static const char product[]="ujs/practice/uxe/base/curve-family-classes.ujs";

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    if(!write && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    unsigned char *raw=0;
    int64_t bytes=0;
    if(sy_read_file(facts,&raw,&bytes,1024)) return 2;
    const char header[]="kind\tclass\tdimensions\tpoints\n";
    if(bytes<sizeof header || !tx_same((char *)raw,sizeof header-1,header,sizeof header-1)) {
        mm_free(raw);
        return 2;
    }
    char output[18000];
    int length=tx_snprintf(output,sizeof output,"// Generated by curve-family-gen.cx from curve-family-layout.tsv.\n");
    const char *line=(char *)raw+sizeof header-1,*end=(char *)raw+bytes;
    int kinds=0,failed=0;
    while(line<end) {
        const long newline=tx_find(line,end-line,"\n",1);
        char *tab=0;
        const long kind=tx_strtol(line,&tab,10);
        if(newline<0 || tab==line || *tab!='\t' || kind<0 || kind==1 || kind>5 || (kinds&(1<<kind))) { failed=1; break; }
        const char *name=tab+1;
        const long n=tx_find(name,line+newline-name,"\t",1);
        if(n<=0 || n>40 || n+4!=line+newline-name ||
           name[n+1]!='0'+2+kind%2 || name[n+2]!='\t' || name[n+3]!='0'+2+kind/2) { failed=1; break; }
        for(int i=0;i<n;i++) if(!((name[i]>='A'&&name[i]<='Z') ||
            (name[i]>='a'&&name[i]<='z') || (i>0&&name[i]>='0'&&name[i]<='9'))) failed=1;
        if(failed) break;
        kinds|=1<<kind;
        const int points=2+kind/2;
        const char *args=points==2?"a:i64,b:i64":points==3?"a:i64,b:i64,c:i64":"a:i64,b:i64,c:i64,d:i64";
        const char *refs=points==2?"a,b,0-1,0-1":points==3?"a,b,c,0-1":"a,b,c,d";
        length+=tx_snprintf(output+length,sizeof output-length,
            "native function %.*sClass_init(instance:i64,%s) i64 {\n"
            "  return CurveFamily_init(instance,%ld,%s);\n}\n", (int)n,name,args,kind,refs);
        line+=newline+1;
    }
    mm_free(raw);
    if(failed || kinds!=61 || length<=0 || length>=(int)sizeof output) return 2;
    if(write) return sy_write_file(product,output,length,0644)!=0;
    if(sy_read_file(product,&raw,&bytes,sizeof output)) return 1;
    failed=!tx_same((char *)raw,bytes,output,length);
    mm_free(raw);
    printf("CURVE_FAMILY_GENERATED kinds=%d failed=%d\n",kinds,failed);
    return failed;
}
