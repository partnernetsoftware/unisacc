#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

static const char facts[]="ujs/practice/uxe/base/bufferattribute-family.tsv";
static const char target[]="ujs/practice/uxe/base/bufferattribute-family-classes.ujs";

static int identifier(const char *text,int n) {
    if(n<=0 || n>45) return 0;
    for(int i=0;i<n;i++) {
        int c=text[i];
        if(!((c>='A' && c<='Z') || (c>='a' && c<='z') || (i>0 && c>='0' && c<='9'))) return 0;
    }
    return 1;
}

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    if(!write && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    unsigned char *raw=0;
    int64_t size=0;
    if(sy_read_file(facts,&raw,&size,6000)) return 2;
    const char header[]="kind\tclass\tarrayToken\twidth\n";
    if(size<(int)sizeof header || !tx_same((char *)raw,sizeof header-1,header,sizeof header-1)) {
        mm_free(raw);
        return 2;
    }
    const char *position=(char *)raw+sizeof header-1,*end=(char *)raw+size;
    char text[12000],token[1200];
    int used=tx_snprintf(text,sizeof text,"// Generated by bufferattribute-family-gen.cx from bufferattribute-family.tsv.\n");
    int tokens=0,k=1;
    const int widths[]={1,1,1,2,2,4,4,2,4,8};
    while(position<end && k<=10) {
        char *kindEnd=0;
        const long kind=tx_strtol(position,&kindEnd,10);
        const long newline=tx_find(position,end-position,"\n",1);
        if(kind!=k || kindEnd==position || *kindEnd!='\t' || newline<=0) break;
        const char *cls=kindEnd+1;
        const char *last=position+newline;
        const long cn=tx_find(cls,last-cls,"\t",1);
        if(cn<=0 || !identifier(cls,cn)) break;
        const char *name=cls+cn+1;
        const long tn=tx_find(name,last-name,"\t",1);
        if(tn<=0 || !identifier(name,tn) || last-name!=tn+2 || name[tn+1]!='0'+widths[k-1]) break;
        used+=tx_snprintf(text+used,sizeof text-used,
            "native function %.*s_new(state:i64,attribute:i64,data:i64,count:i64,size:i64,normalized:i64,ranges:i64) i64 {\n"
            "  return Attribute_init(state,attribute,data,count,size,%d,normalized,ranges);\n}\n",
            (int)cn,cls,k);
        tokens+=tx_snprintf(token+tokens,sizeof token-tokens,"%sObjectJsonType.%.*s",k==1?"":",",(int)tn,name);
        position=last+1; k++;
    }
    const int valid=k==11 && position==end;
    mm_free(raw);
    if(!valid) return 2;
    used+=tx_snprintf(text+used,sizeof text-used,
        "native function Attribute_arrayType(kind:i64) i64 {\n"
        "  if(kind<1 || kind>10) { return 0-1; }\n"
        "  let typed=[%s];\n  return ObjectJsonToken.size+typed[kind-1];\n}\n",token);
    if(used<0 || used>=(int)sizeof text) return 2;
    if(write) return sy_write_file(target,text,used,0644)!=0;
    if(sy_read_file(target,&raw,&size,sizeof text)) return 1;
    const int failed=!tx_same((char *)raw,size,text,used);
    mm_free(raw);
    printf("BUFFER_ATTRIBUTE_FAMILY kinds=10 failed=%d\n",failed);
    return failed;
}
