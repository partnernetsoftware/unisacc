#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

static const char facts[]="ujs/practice/uxe/base/helper-geometry.tsv";
static const char product[]="ujs/practice/uxe/base/helper-geometry.ujs";
static const char *const names[]={"plane_outline","plane_fill","directional_plane","directional_line","spot_spokes"};
static const int counts[]={8,6,5,2,10};

static int read_vertex(const char **row,const char *end,const char *name,int *values) {
    const char *at=*row;
    const int n=tx_len(name,32);
    if(end-at<n+7 || !tx_same(at,n,name,n)) return 1;
    at+=n;
    for(int i=0;i<3;i++) {
        if(at==end || *at++!='\t' || at==end) return 1;
        if(*at=='-') {
            at++;
            if(at==end || *at++!='1') return 1;
            values[i]=0;
        } else {
            if(*at!='0' && *at!='1') return 1;
            values[i]=1+*at++-'0';
        }
    }
    if(at==end || *at++!='\n') return 1;
    *row=at;
    return 0;
}

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    if(!write && !((argc==2 || argc==3) && tx_eqz(argv[1],"--check"))) return 2;
    unsigned char *input=0;
    int64_t bytes=0;
    if(sy_read_file(facts,&input,&bytes,2048)) return 1;
    const char header[]="template\tx\ty\tz\n";
    const char *at=(const char *)input;
    const char *end=at+bytes;
    int failed=bytes<(long)sizeof header-1 || !tx_same(at,sizeof header-1,header,sizeof header-1);
    if(!failed) at+=sizeof header-1;
    int rows=0;
    char out[4096];
    int used=tx_snprintf(out,sizeof out,
        "// Generated by gen-helper-geometry.cx from the pinned r160 vertex facts.\n");
    for(int group=0;!failed && group<(int)(sizeof counts/sizeof counts[0]);group++) {
        int appended=tx_snprintf(out+used,sizeof out-used,
            "\nnative function helper_%s(dst:i64,scale:f64) i64 {\n  let xyz=[",names[group]);
        if(appended<0 || appended>=(int)sizeof out-used) { failed=1; break; }
        used+=appended;
        for(int i=0;i<counts[group];i++) {
            int values[3];
            if(read_vertex(&at,end,names[group],values)) { failed=1; break; }
            appended=tx_snprintf(out+used,sizeof out-used,"%s%d,%d,%d",i?",":"",values[0],values[1],values[2]);
            if(appended<0 || appended>=(int)sizeof out-used) { failed=1; break; }
            used+=appended;
            rows++;
        }
        if(failed) break;
        appended=tx_snprintf(out+used,sizeof out-used,
            "];\n  let i=0;\n  while(i<%d) {\n"
            "    let value=0.0;\n    if(xyz[i]!=1) { value=(xyz[i]-1)*scale; }\n"
            "    let wrote=ux_f32_put(dst+i*4,value);\n    i=i+1;\n  }\n  return dst;\n}\n",counts[group]*3);
        if(appended<0 || appended>=(int)sizeof out-used) { failed=1; break; }
        used+=appended;
    }
    if(at!=end) failed=1;
    mm_free(input);
    if(!failed && write) failed=sy_write_atomic(product,out,used,0644)!=0;
    if(!failed && !write) {
        unsigned char *previous=0;
        int64_t length=0;
        failed=sy_read_file(argc==3?argv[2]:product,&previous,&length,sizeof out) ||
            !tx_same((const char *)previous,length,out,used);
        mm_free(previous);
    }
    printf("GEN_HELPER_GEOMETRY rows=%d failed=%d\n",rows,failed);
    return failed;
}
