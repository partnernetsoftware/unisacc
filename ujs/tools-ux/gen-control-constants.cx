#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

static const char target[]="ujs/practice/uxe/base/control-constants.ujs";
static const char *const mouse_keys[]={"LEFT","MIDDLE","RIGHT","ROTATE","DOLLY","PAN"};
static const char *const touch_keys[]={"ROTATE","PAN","DOLLY_PAN","DOLLY_ROTATE"};

static int append_group(char *out,int capacity,const char *source,long size,
                        const char *group,const char *const *keys,int count) {
    char buffer[80];
    int n=tx_snprintf(buffer,sizeof buffer,"\nconst %s = { ",group);
    long at=tx_find(source,size,buffer,n);
    if(at<0) return -1;
    at+=n;
    int used=0;
    for(int i=0;i<count;i++) {
        n=tx_snprintf(buffer,sizeof buffer,"%s: ",keys[i]);
        if(n<0 || at+n+3>size || !tx_same(source+at,n,buffer,n)) return -1;
        at+=n;
        const char value=source[at++];
        if(value<'0' || value>'9') return -1;
        const char *end=i+1==count?" };":", ";
        const int end_bytes=i+1==count?3:2;
        if(at+end_bytes>size || !tx_same(source+at,end_bytes,end,end_bytes)) return -1;
        at+=end_bytes;
        int added=tx_snprintf(out+used,capacity-used,"function %s_%s() { return %c; }\n",group,keys[i],value);
        if(added<0 || added>=capacity-used) return -1;
        used+=added;
    }
    return used;
}

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    if(!write && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    unsigned char *source=0;
    int64_t size=0;
    if(sy_read_file("ujs/practice/web/game/three.module.js",&source,&size,4000000)) return 1;
    char out[1000]="// Generated by gen-control-constants.cx from the pinned r160 exports.\n";
    const int start=tx_len(out,sizeof out);
    const int mouse=append_group(out+start,sizeof out-start,(char *)source,size,"MOUSE",mouse_keys,6);
    int touch=mouse<0?-1:append_group(out+start+mouse,sizeof out-start-mouse,(char *)source,size,"TOUCH",touch_keys,4);
    mm_free(source);
    int failed=mouse<0 || touch<0;
    const int used=start+mouse+touch;
    if(!failed && write) failed=sy_write_file(target,out,used,0644)!=0;
    if(!failed && !write) {
        unsigned char *previous=0;
        int64_t bytes=0;
        failed=sy_read_file(target,&previous,&bytes,sizeof out) || !tx_same((char *)previous,bytes,out,used);
        mm_free(previous);
    }
    printf("GEN_CONTROL_CONSTANTS rows=%d failed=%d\n",failed?0:10,failed);
    return failed;
}

