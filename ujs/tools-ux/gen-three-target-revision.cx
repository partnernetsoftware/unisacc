#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    const int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char *target="ujs/practice/uxe/base/three-target-revision.ujs";
    const char marker[]="\nconst REVISION = '";
    unsigned char *upstream=0,*previous=0;
    int64_t size=0,old=0;
    int failed=sy_read_file("ujs/practice/web/game/three.module.js",&upstream,&size,4000000);
    const long position=failed?-1:tx_find((const char *)upstream,size,marker,sizeof marker-1);
    const int64_t start=position+sizeof marker-1;
    if(position<0 || start>size-6 || upstream[start+3]!='\'' || upstream[start+4]!=';' ||
       tx_find((const char *)upstream+start,size-start,marker,sizeof marker-1)>=0) failed=1;
    if(!failed) for(int i=0;i<3;i++) if(upstream[start+i]<'0' || upstream[start+i]>'9') failed=1;
    if(!failed) {
        char output[900];
        const int bytes=tx_snprintf(output,sizeof output,
            "// Generated by gen-three-target-revision.cx. This identifies the comparison target.\n"
            "native function UxeThree_targetRevision(out:i64,capacity:i64) i64 {\n"
            "  if(out<0 || out>6291456-3 || capacity<3) { return 0-1; }\n"
            "  let first=ux_u8_put(out,%d);\n"
            "  let middle=ux_u8_put(out+1,%d);\n"
            "  let last=ux_u8_put(out+2,%d);\n"
            "  return 3;\n"
            "}\n",upstream[start],upstream[start+1],upstream[start+2]+mutate);
        failed=bytes<1 || bytes>=sizeof output || (write?sy_write_file(target,output,bytes,0644)!=0:
            sy_read_file(target,&previous,&old,sizeof output) || !tx_same((const char *)previous,old,output,bytes));
    }
    mm_free(upstream); mm_free(previous);
    printf("THREE_TARGET_REVISION failed=%d\n",failed);
    return failed;
}
