native function BufferGeometryLoader_parse(file:i64,geo:i64,options:i64) i64 {
  if(!loading_span(file,FileLoader.size) || ux_u32(file+FileLoader.state)!=2) { return 0-1; }
  let input=ux_u32(file+FileLoader.bytes);
  let count=ux_u32(file+FileLoader.length);
  if(input>6291456-count || !file_disjoint(input,count,geo,BufferGeometry.size) ||
     !file_disjoint(input,count,options,GeometryJsonLoad.size)) { return 0-1; }
  return BufferGeometry_fromJSON(geo,input,input+count,options);
}
