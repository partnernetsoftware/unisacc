native function SplineCurve_getPoint(dst:i64,points:i64,count:i64,t:f64) i64 {
  if(count<2 || t<0.0 || t>1.0) { return 0-1; }
  let parameter=t*(count-1);
  let index=f64_floor_i64(parameter);
  let local=parameter-index;
  let prev=index-1;
  if(prev<0) { prev=0; }
  let next=index+1;
  if(next>=count) { next=count-1; }
  let after=next+1;
  if(after>=count) { after=count-1; }
  let axis=0;
  while(axis<16) {
    let a=ux_f64(points+16*prev+axis);
    let b=ux_f64(points+16*index+axis);
    let c=ux_f64(points+16*next+axis);
    let d=ux_f64(points+16*after+axis);
    let result=curve_hermite(local,b,c,(c-a)*0.5,(d-b)*0.5);
    let written=ux_f64_put(dst+axis,result);
    axis=axis+8;
  }
  return dst;
}
