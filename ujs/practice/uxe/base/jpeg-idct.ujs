native function jpeg_idct_basis(basis:i64) i64 {
  let sample=0;
  while(sample<8) {
    let f=0;
    while(f<8) {
      let coefficient=0.7071067811865476;
      if(f>0) { coefficient=ux_math_cos(0.19634954084936207*(2*sample+1)*f); }
      let a=ux_f64_put(basis+(sample*8+f)*8,coefficient*0.5);
      f=f+1;
    }
    sample=sample+1;
  }
  return basis;
}

native function jpeg_idct_block(coefficients:i64,basis:i64,work:i64,out:i64) i64 {
  let row=0;
  while(row<8) {
    let x=0;
    while(x<8) {
      let sum=0.0;
      let f=0;
      while(f<8) {
        sum=sum+ux_f64(basis+(x*8+f)*8)*ux_i32(coefficients+(row*8+f)*4);
        f=f+1;
      }
      let a=ux_f64_put(work+(row*8+x)*8,sum);
      x=x+1;
    }
    row=row+1;
  }
  let y=0;
  while(y<8) {
    let x=0;
    while(x<8) {
      let sum=128.5;
      let f=0;
      while(f<8) {
        sum=sum+ux_f64(basis+(y*8+f)*8)*ux_f64(work+(f*8+x)*8);
        f=f+1;
      }
      if(sum<0.0) { sum=0.0; }
      if(sum>255.0) { sum=255.0; }
      let a=ux_u8_put(out+y*8+x,f64_floor_i64(sum));
      x=x+1;
    }
    y=y+1;
  }
  return out;
}
