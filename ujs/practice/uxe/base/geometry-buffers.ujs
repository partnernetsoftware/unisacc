struct GeometryBuffers {
  vertices: u32;
  vertexCapacity: u32;
  indices: u32;
  indexCapacity: u32;
  vertexCount: u32;
  indexCount: u32;
}

// Each vertex owns eight f32 channels: xyz position, xyz normal, uv.
// Indices use u32 in generated meshes and can be narrowed at upload.
native function GeometryBuffers_init(buffer:i64,vertices:i64,vertex_cap:i64,
                                    indices:i64,index_cap:i64) i64 {
  if(buffer<0 || buffer>6291456-GeometryBuffers.size || buffer%4!=0 ||
     vertices<0 || vertices>6291456 || vertices%4!=0 ||
     indices<0 || indices>6291456 || indices%4!=0 ||
     vertex_cap<0 || vertex_cap>(6291456-vertices)/32 ||
     index_cap<0 || index_cap>(6291456-indices)/4) { return 0-1; }
  let vertex_end=vertices+vertex_cap*32;
  let index_end=indices+index_cap*4;
  let record_end=buffer+GeometryBuffers.size;
  if((vertex_cap!=0 && vertices<record_end && buffer<vertex_end) ||
     (index_cap!=0 && indices<record_end && buffer<index_end) ||
     (vertex_cap!=0 && index_cap!=0 && vertices<index_end && indices<vertex_end)) { return 0-1; }
  let v=ux_u32_put(buffer+GeometryBuffers.vertices,vertices);
  let vc=ux_u32_put(buffer+GeometryBuffers.vertexCapacity,vertex_cap);
  let i=ux_u32_put(buffer+GeometryBuffers.indices,indices);
  let ic=ux_u32_put(buffer+GeometryBuffers.indexCapacity,index_cap);
  let used_v=ux_u32_put(buffer+GeometryBuffers.vertexCount,0);
  let used_i=ux_u32_put(buffer+GeometryBuffers.indexCount,0);
  return buffer;
}

function GeometryBuffers_fits(fit,...fit_counts) {
  return fit>=0 && fit<=6291456-GeometryBuffers.size &&
    fit_counts[0]>=0 && fit_counts[0]<=ux_u32(fit+GeometryBuffers.vertexCapacity) &&
    fit_counts[1]>=0 && fit_counts[1]<=ux_u32(fit+GeometryBuffers.indexCapacity);
}

function GeometryBuffers_commit(commit,...commit_counts) {
  let geo_vertex_written=ux_u32_put(commit+GeometryBuffers.vertexCount,commit_counts[0]);
  let geo_index_written=ux_u32_put(commit+GeometryBuffers.indexCount,commit_counts[1]);
  return commit;
}

native function geometry_point(point:i64,x:f64,y:f64,z:f64,nx:f64,ny:f64,nz:f64,u:f64) i64 {
  let px=ux_f32_put(point,x);
  let py=ux_f32_put(point+4,y);
  let pz=ux_f32_put(point+8,z);
  let dx=ux_f32_put(point+12,nx);
  let dy=ux_f32_put(point+16,ny);
  let dz=ux_f32_put(point+20,nz);
  let uvx=ux_f32_put(point+24,u);
  return point+28;
}

function GeometryBuffers_vertex(vertex,...channels) {
  let uv_v=geometry_point(vertex,channels[0],channels[1],channels[2],
    channels[3],channels[4],channels[5],channels[6]);
  let written=ux_f32_put(uv_v,channels[7]);
  return vertex+32;
}

native function geometry_quad(quad:i64,a:i64,b:i64,c:i64,d:i64) i64 {
  let i0=ux_u32_put(quad,a);
  let i1=ux_u32_put(quad+4,b);
  let i2=ux_u32_put(quad+8,d);
  let i3=ux_u32_put(quad+12,b);
  let i4=ux_u32_put(quad+16,c);
  let i5=ux_u32_put(quad+20,d);
  return quad+24;
}
