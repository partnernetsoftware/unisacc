native function curve_bezier(dst:i64,points:i64,dims:i64,order:i64,t:f64) i64 {
  let u=1.0-t;
  let stride=dims*8;
  let i=0;
  while(i<stride) {
    let a=ux_f64(points+i);
    let b=ux_f64(points+i+stride);
    let c=ux_f64(points+i+2*stride);
    let value=u*u*a+2.0*u*t*b+t*t*c;
    if(order==3) {
      let d=ux_f64(points+i+3*stride);
      value=u*u*u*a+3.0*u*u*t*b+3.0*u*t*t*c+t*t*t*d;
    }
    let written=ux_f64_put(dst+i,value);
    i=i+8;
  }
  return dst;
}
