// Portable little-endian snapshot: magic, kind, surfaces, levels, followed
// by surface-major {width,height,format,bytes,payload} mip records.
native function CompressedTex_writeSnapshot(at:i64,out:i64,capacity:i64) i64 {
  if(!loading_span(at,CompressedTextureSoftware.size) || !loading_span(out,capacity) ||
     capacity<16 || !file_disjoint(at,CompressedTextureSoftware.size,out,capacity) ||
     ux_u32(at+CompressedTextureSoftware.live)!=1) { return 0-1; }
  let kind=ux_u32(at+CompressedTextureSoftware.kind);
  let surfaces=ux_u32(at+CompressedTextureSoftware.surfaces);
  let levels=ux_u32(at+CompressedTextureSoftware.levels);
  let table=ux_u32(at+CompressedTextureSoftware.table);
  let rows=surfaces*levels;
  let tableBytes=rows*CompressedMip.size;
  if(surfaces<1 || surfaces>2048 || levels<1 || levels>15 ||
     !loading_span(table,tableBytes) || !file_disjoint(table,tableBytes,out,capacity)) { return 0-1; }
  let length=16;
  let i=0;
  while(i<rows) {
    let mip=table+i*CompressedMip.size;
    let bytes=ux_u32(mip+CompressedMip.bytes);
    let data=ux_u32(mip+CompressedMip.data);
    if(bytes<1 || bytes%4!=0 || bytes>capacity-length-16 || data>6291456-bytes ||
       !file_disjoint(data,bytes,out,capacity)) { return 0-1; }
    length=length+16+bytes;
    i=i+1;
  }
  let magic=ux_u32_put(out,827610197);
  let tag=ux_u32_put(out+4,kind);
  let count=ux_u32_put(out+8,surfaces);
  let depth=ux_u32_put(out+12,levels);
  let cursor=out+16;
  i=0;
  while(i<rows) {
    let mip=table+i*CompressedMip.size;
    let bytes=ux_u32(mip+CompressedMip.bytes);
    let data=ux_u32(mip+CompressedMip.data);
    let width=ux_u32_put(cursor,ux_u32(mip+CompressedMip.width));
    let height=ux_u32_put(cursor+4,ux_u32(mip+CompressedMip.height));
    let format=ux_u32_put(cursor+8,ux_u32(mip+CompressedMip.format));
    let stored=ux_u32_put(cursor+12,bytes);
    let j=0;
    while(j<bytes) { let saved=ux_u8_put(cursor+16+j,ux_u8(data+j)); j=j+1; }
    cursor=cursor+16+bytes;
    i=i+1;
  }
  return length;
}

// Restored mip descriptors borrow bytes from the immutable snapshot.
// The caller supplies a fresh descriptor table, which is scratch until init succeeds.
native function CompressedTex_readSnapshot(at:i64,table:i64,tableCapacity:i64,input:i64,bytes:i64) i64 {
  if(!loading_span(at,CompressedTextureSoftware.size) || !loading_span(input,bytes) ||
     !loading_span(table,tableCapacity) ||
     !file_disjoint(at,CompressedTextureSoftware.size,input,bytes) ||
     !file_disjoint(at,CompressedTextureSoftware.size,table,tableCapacity) ||
     !file_disjoint(input,bytes,table,tableCapacity) || bytes<16 ||
     ux_u32(input)!=827610197) { return 0-1; }
  let kind=ux_u32(input+4);
  let surfaces=ux_u32(input+8);
  let levels=ux_u32(input+12);
  if(kind<1 || kind>3 || surfaces<1 || surfaces>2048 || levels<1 || levels>15 ||
     (kind==1 && surfaces!=1) || (kind==3 && surfaces!=6)) { return 0-1; }
  let rows=surfaces*levels;
  if(rows*CompressedMip.size>tableCapacity) { return 0-1; }
  let cursor=input+16;
  let end=input+bytes;
  let i=0;
  while(i<rows) {
    if(cursor>end-16) { return 0-1; }
    let size=ux_u32(cursor+12);
    if(size<1 || size%4!=0 || size>end-cursor-16) { return 0-1; }
    let mip=table+i*CompressedMip.size;
    let width=ux_u32_put(mip+CompressedMip.width,ux_u32(cursor));
    let height=ux_u32_put(mip+CompressedMip.height,ux_u32(cursor+4));
    let format=ux_u32_put(mip+CompressedMip.format,ux_u32(cursor+8));
    let stored=ux_u32_put(mip+CompressedMip.bytes,size);
    let data=ux_u32_put(mip+CompressedMip.data,cursor+16);
    cursor=cursor+16+size;
    i=i+1;
  }
  if(cursor!=end) { return 0-1; }
  return CompressedTextureSoft_init(at,kind,surfaces,levels,table);
}
