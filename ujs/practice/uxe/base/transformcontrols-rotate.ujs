native function transform_rotation_angle(delta:i64,camera:i64,axis:i64,snap:f64) f64 {
  let cx=ux_f64(camera);
  let cy=ux_f64(camera+8);
  let cz=ux_f64(camera+16);
  let distance=f64_sqrt(cx*cx+cy*cy+cz*cz);
  let tx=0.0;
  let ty=0.0;
  let tz=0.0;
  if(axis==1) { ty=0.0-cz; tz=cy; }
  if(axis==2) { tx=cz; tz=0.0-cx; }
  if(axis==4) { tx=0.0-cy; ty=cx; }
  let length=f64_sqrt(tx*tx+ty*ty+tz*tz);
  if(length<=0.0 || distance-distance!=0.0) { return 0.0/0.0; }
  let distanceAlong=(ux_f64(delta)*tx+ux_f64(delta+8)*ty+ux_f64(delta+16)*tz)/length;
  return transform_world_axis(0.0,0.0,0.0,distanceAlong*20.0/distance,snap);
}

// The caller supplies the world hit delta and camera offset from the
// object. A principal world rotation is applied to the starting quaternion
// in an unrotated parent frame. The output packs quaternion then angle.
native function TransformControls_rotate(out:i64,start:i64,delta:i64,camera:i64,axis:i64,snap:f64) i64 {
  if(out<0 || out%8!=0 || out>6291456-40 || start<0 || start%8!=0 || start>6291456-32 ||
     !transform_vec3_valid(delta) || !transform_vec3_valid(camera) ||
     (axis!=1 && axis!=2 && axis!=4) || snap<0.0 || snap-snap!=0.0) { return 0-1; }
  let angle=transform_rotation_angle(delta,camera,axis,snap);
  if(angle-angle!=0.0 || angle<0.0-1000000000.0 || angle>1000000000.0) { return 0-1; }
  let x=ux_f64(start);
  let y=ux_f64(start+8);
  let z=ux_f64(start+16);
  let w=ux_f64(start+24);
  let length=f64_sqrt(x*x+y*y+z*z+w*w);
  if(length<=0.0 || length-length!=0.0) { return 0-1; }
  let s=ux_math_sin(angle*0.5);
  let c=ux_math_cos(angle*0.5);
  let rx=0.0;
  let ry=0.0;
  let rz=0.0;
  if(axis==1) { rx=s; }
  if(axis==2) { ry=s; }
  if(axis==4) { rz=s; }
  let a=ux_f64_put(out,(c*x+rx*w+ry*z-rz*y)/length);
  let b=ux_f64_put(out+8,(c*y-rx*z+ry*w+rz*x)/length);
  let d=ux_f64_put(out+16,(c*z+rx*y-ry*x+rz*w)/length);
  let e=ux_f64_put(out+24,(c*w-rx*x-ry*y-rz*z)/length);
  let f=ux_f64_put(out+32,angle);
  return out;
}
