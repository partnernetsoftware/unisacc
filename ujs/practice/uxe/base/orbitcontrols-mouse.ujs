struct OrbitMouse {
  x: f64;
  y: f64;
  pointer: u32;
  mode: u32;
}

native function orbit_mouse_valid(mouse:i64) i64 {
  return mouse>=0 && mouse%8==0 && mouse<=6291456-OrbitMouse.size;
}

native function OrbitControls_initMouse(mouse:i64) i64 {
  if(!orbit_mouse_valid(mouse)) { return 0-1; }
  let cleared=ux_u32_put(mouse+OrbitMouse.mode,0);
  return mouse;
}

// action 1=down, 2=move, 3=up/cancel, 4=wheel. Down encodes the button
// in binding 0..2, plus three if Ctrl, Meta or Shift was held.
// Move and wheel use binding as the integral device pixel ratio.
native function OrbitControls_mousePerspective(control:i64,contacts:i64,mouse:i64,action:i64,pointer:i64,
  x:f64,y:f64,binding:i64) i64 {
  if(!orbit_valid(control) || !orbit_touch_valid(contacts) || !orbit_mouse_valid(mouse) ||
     action<1 || action>4 || pointer<0 || pointer>4294967295 || x-x!=0.0 || y-y!=0.0) { return 0-1; }
  let mode=ux_u32(mouse+OrbitMouse.mode);
  if(action==4) {
    if(mode!=0 || ux_u32(contacts+OrbitTouch.mode)!=0) { return 0; }
    return OrbitControls_wheel(control,y,binding);
  }
  if(action==1) {
    if(binding<0 || binding>5) { return 0; }
    if(mode!=0 || ux_u32(contacts+OrbitTouch.first+OrbitTouchContact.active)!=0 ||
       ux_u32(contacts+OrbitTouch.second+OrbitTouchContact.active)!=0) { return 0; }
    mode=1+OrbitControls_mouseBinding(ux_u32(contacts+OrbitTouch.map),binding%3,binding/3);
    if(mode==1) {
      let captured=OrbitControls_pointer(control,1,pointer,x,y);
      if(captured<=0) { return captured; }
    }
    let id=ux_u32_put(mouse+OrbitMouse.pointer,pointer);
    let active=ux_u32_put(mouse+OrbitMouse.mode,mode);
  } else {
    if(mode==0 || ux_u32(mouse+OrbitMouse.pointer)!=pointer) { return 0; }
    if(action==3) {
      if(mode==1) { let released=OrbitControls_pointer(control,3,pointer,x,y); }
      let ended=ux_u32_put(mouse+OrbitMouse.mode,0);
      return 1;
    }
    let status=0;
    if(mode==1) {
      status=OrbitControls_pointer(control,2,pointer,x,y);
    } else {
      let dx=x-ux_f64(mouse+OrbitMouse.x);
      let dy=y-ux_f64(mouse+OrbitMouse.y);
      if(mode==2) {
        status=OrbitControls_wheel(control,dy,binding);
      } else {
        status=OrbitControls_panPerspective(control,ux_u32(contacts+OrbitTouch.right),ux_u32(contacts+OrbitTouch.up),
          1-ux_u32(contacts+OrbitTouch.map),dx,dy,ux_f64(contacts+OrbitTouch.fov));
      }
    }
    if(status<0) { return status; }
  }
  let a=ux_f64_put(mouse+OrbitMouse.x,x);
  let b=ux_f64_put(mouse+OrbitMouse.y,y);
  return 1;
}
