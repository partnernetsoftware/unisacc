struct AudioMasterGain {
  time: f64;
  previous: f64;
  target: f64;
}

native function AudioListener_initMasterGain(state:i64,time:f64) i64 {
  if(!audio_play_span(state,AudioMasterGain.size,8) || time<0.0 || time-time!=0.0) { return 0-1; }
  let at=ux_f64_put(state+AudioMasterGain.time,time);
  let a=ux_f64_put(state+AudioMasterGain.previous,1.0);
  let b=ux_f64_put(state+AudioMasterGain.target,1.0);
  return state;
}

// r160 uses setTargetAtTime with a 10 millisecond time constant.
native function AudioListener_masterVolume(state:i64,time:f64) f64 {
  if(!audio_play_span(state,AudioMasterGain.size,8) || time<0.0 || time-time!=0.0) { return 0.0/0.0; }
  let start=ux_f64(state+AudioMasterGain.time);
  let previous=ux_f64(state+AudioMasterGain.previous);
  let target=ux_f64(state+AudioMasterGain.target);
  if(start<0.0 || start-start!=0.0 || previous-previous!=0.0 || target-target!=0.0) { return 0.0/0.0; }
  if(time<=start) { return previous; }
  let delta=time-start;
  if(delta>=10.0) { return target; }
  let weight=ux_math_exp((0.0-100.0)*delta);
  return (1.0-weight)*target+weight*previous;
}

native function AudioListener_setMasterVolume(state:i64,target:f64,time:f64) i64 {
  if(!audio_play_span(state,AudioMasterGain.size,8) ||
     target-target!=0.0 || time<ux_f64(state+AudioMasterGain.time)) { return 0-1; }
  let current=AudioListener_masterVolume(state,time);
  if(current-current!=0.0) { return 0-1; }
  let at=ux_f64_put(state+AudioMasterGain.time,time);
  let a=ux_f64_put(state+AudioMasterGain.previous,current);
  let b=ux_f64_put(state+AudioMasterGain.target,target);
  return state;
}
