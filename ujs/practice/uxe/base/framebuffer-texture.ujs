// Framebuffer pixels use bottom-left origin and tightly packed RGBA8.
native function fb_texture_span(addr:i64,width:i64,height:i64) i64 {
  if(addr<0 || addr%4!=0 || width<1 || width>4096 || height<1 || height>4096) { return 0; }
  return addr<=6291456-4*width*height;
}

native function FramebufferTexture_capture(dst:i64,width:i64,height:i64,src:i64,srcWidth:i64,srcHeight:i64,x:i64,y:i64) i64 {
  if(!fb_texture_span(dst,width,height) || !fb_texture_span(src,srcWidth,srcHeight)) { return 0-1; }
  if(x<0 || y<0 || x>srcWidth-width || y>srcHeight-height) { return 0-2; }
  if(dst<src+4*srcWidth*srcHeight && src<dst+4*width*height) { return 0-3; }
  let row=0;
  while(row<height) {
    let col=0;
    while(col<width) {
      let pixel=ux_u32(src+4*((y+row)*srcWidth+x+col));
      let stored=ux_u32_put(dst+4*(row*width+col),pixel);
      col=col+1;
    }
    row=row+1;
  }
  return dst;
}
