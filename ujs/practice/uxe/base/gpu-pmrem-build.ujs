struct GpuPmremBuild {
  pixels: u32;
  width: u32;
  height: u32;
  bytes: u32;
  layers: u32;
  live: u32;
}

native function GpuPmremBuild_atlasBytes(size:i64) i64 {
  if(size==256) { return 3145728; }
  if(size!=16 && size!=32 && size!=64) { return 0-1; }
  return 5376*size;
}

native function GpuPmremBuild_bytes() i64 { return 86016; }
native function GpuPmremBuild_scratchBytes() i64 { return 24896; }

native function GpuPmremBuild_workBytes(size:i64) i64 {
  if(size==256) { return 1573120; }
  if(size==64) { return 98560; }
  if(size==16 || size==32) { return GpuPmremBuild_scratchBytes(); }
  return 0-1;
}

native function pmrem_build_range(at:i64,bytes:i64) i64 {
  return at>=0 && bytes>=0 && at<=6291456 && bytes<=6291456-at;
}

native function pmrem_build_overlap(a:i64,an:i64,b:i64,bn:i64) i64 {
  return a<b+bn && b<a+an;
}

native function GpuPmremBuild_init(state:i64) i64 {
  if(state%4!=0 || pmrem_build_range(state,GpuPmremBuild.size)==0) { return 0-1; }
  let at=0;
  while(at<GpuPmremBuild.size) { let clear=ux_u32_put(state+at,0); at=at+4; }
  return state;
}

native function pmrem_build_direction(out:i64,face:i64,px:i64,py:i64,size:i64) i64 {
  let u=2.0*(px-0.5)/(size-2)-1.0;
  let v=2.0*(py-0.5)/(size-2)-1.0;
  let x=1.0;
  let y=v;
  let z=u;
  if(face==1 || face==4) {
    x=0.0-u; y=1.0; z=0.0-v;
    if(face==4) { y=0.0-1.0; z=v; }
  } else if(face==2 || face==5) {
    x=0.0-u; z=1.0;
    if(face==5) { x=u; z=0.0-1.0; }
  } else if(face==3) { x=0.0-1.0; z=0.0-u; }
  let a=ux_f64_put(out,x);
  let b=ux_f64_put(out+8,y);
  let c=ux_f64_put(out+16,z);
  return out;
}

native function pmrem_build_tile(base:i64,band:i64) i64 {
  let face=base;
  let i=0;
  while(i<band && face>16) { face=face/2; i=i+1; }
  return face;
}

native function pmrem_build_column(base:i64,band:i64) i64 {
  let first=0;
  if(base==32) { first=1; }
  if(base==64) { first=2; }
  if(base==256) { first=4; }
  if(band<=first) { return 0; }
  return 48*(band-first);
}

native function pmrem_build_sigma(base:i64,band:i64) f64 {
  if(band==0) { return 0.0; }
  let first=0;
  if(base==32) { first=1; }
  if(base==64) { first=2; }
  if(base==256) { first=4; }
  if(band<=first) { return 1.0/pmrem_build_tile(base,band); }
  let sigmas=[0.0,0.125,0.215,0.35,0.446,0.526,0.582];
  return sigmas[band-first];
}

native function pmrem_build_weights(scratch:i64,step:f64,sigma:f64,initial:i64) i64 {
  let taps=1+f64_floor_i64(3.0*sigma/step);
  let sineAt=160;
  let cosineAt=224;
  if(initial!=0) {
    sineAt=256;
    cosineAt=416;
    if(taps>20) { taps=20; }
  }
  let total=0.0;
  let at=0;
  while(at<taps) {
    let theta=step*at;
    let normal=theta/sigma;
    let weight=ux_math_exp((0.0-0.5)*normal*normal);
    let w=ux_f64_put(scratch+96+at*8,weight);
    let s=ux_f64_put(scratch+sineAt+at*8,ux_math_sin(theta));
    let c=ux_f64_put(scratch+cosineAt+at*8,ux_math_cos(theta));
    total=total+weight;
    if(at!=0) { total=total+weight; }
    at=at+1;
  }
  at=0;
  while(at<taps) {
    let k=scratch+96+at*8;
    let normalized=ux_f64_put(k,ux_f64(k)/total);
    at=at+1;
  }
  return taps;
}


native function pmrem_build_kernel_pass(scratch:i64,band:i64,base:i64,pass:i64) i64 {
  let tile=pmrem_build_tile(base,band-1+pass);
  let step=1.5707963267948966/(tile-1);
  let previous=pmrem_build_sigma(base,band-1);
  let current=pmrem_build_sigma(base,band);
  let sigma=f64_sqrt(current*current-previous*previous);
  return pmrem_build_weights(scratch,step,sigma,0);
}

native function pmrem_build_kernel(scratch:i64,band:i64,base:i64) i64 {
  return pmrem_build_kernel_pass(scratch,band,base,0);
}

// CubeUV orders positive faces before negative ones. Imported cube textures
// also invert the x coordinate during conversion.
native function pmrem_build_input_face(face:i64) i64 {
  if(face==0) { return 1; }
  if(face==1) { return 2; }
  if(face==2) { return 4; }
  if(face==3) { return 0; }
  if(face==4) { return 3; }
  return 5;
}

native function pmrem_build_rgb(start:i64,width:i64,height:i64,u:f64,v:f64) i64 {
  if(u<0.0) { u=0.0; }
  if(v<0.0) { v=0.0; }
  if(u>=width-1) { u=0.0+width-1; }
  if(v>=height-1) { v=0.0+height-1; }
  let col=f64_floor_i64(u);
  let row=f64_floor_i64(v);
  let nextCol=col+(col<width-1);
  let nextRow=row+(row<height-1);
  let fx=u-col;
  let fy=v-row;
  let rgb=0;
  let scale=1;
  let channel=0;
  while(channel<3) {
    let a=ux_u8(start+(row*width+col)*4+channel);
    let b=ux_u8(start+(row*width+nextCol)*4+channel);
    let c=ux_u8(start+(nextRow*width+col)*4+channel);
    let d=ux_u8(start+(nextRow*width+nextCol)*4+channel);
    let top=a+(b-a)*fx;
    let bottom=c+(d-c)*fx;
    let value=f64_floor_i64(top+(bottom-top)*fy+0.5);
    rgb=rgb+scale*value;
    scale=scale*256;
    channel=channel+1;
  }
  return rgb;
}

native function pmrem_build_texel(faces:i64,face:i64,direction:i64,size:i64) i64 {
  let x=0.0-ux_f64(direction);
  let y=ux_f64(direction+8);
  let z=ux_f64(direction+16);
  let axis=ux_math_abs(x);
  let s=z;
  let t=0.0-y;
  if(face==0) { s=0.0-z; }
  if(face==2 || face==3) {
    axis=ux_math_abs(y); s=x; t=z;
    if(face==3) { t=0.0-z; }
  }
  if(face>=4) {
    axis=ux_math_abs(z); s=x;
    if(face==5) { s=0.0-x; }
  }
  return pmrem_build_rgb(faces+face*size*size*4,size,size,(size-1)*0.5+0.5*size*s/axis,(size-1)*0.5+0.5*size*t/axis);
}

native function pmrem_build_eq_texel(source:i64,direction:i64) i64 {
  let x=ux_f64(direction);
  let y=ux_f64(direction+8);
  let z=ux_f64(direction+16);
  let length=f64_sqrt(x*x+y*y+z*z);
  let longitude=ux_math_atan2(z,x);
  let latitude=ux_math_asin(y/length);
  return pmrem_build_rgb(source,64,32,31.5+longitude*10.185916357881302,15.5+latitude*10.185916357881302);
}

native function pmrem_build_base(atlas:i64,faces:i64,scratch:i64,full:i64,size:i64) i64 {
  let i=0;
  let area=size*size;
  while(i<6*area) {
    let face=i/area;
    let x=i%size;
    let y=i%area/size;
    let direction=pmrem_build_direction(scratch,face,x,y,size);
    let plan=GpuPmrem_plan(scratch+32,4,direction,0.0);
    let source_face=pmrem_build_input_face(ux_u32(plan+GpuPmremSample.face));
    let at=atlas+4*((face/3*size+y)*336+face%3*size+x);
    let source=ux_u32(faces+4*source_face);
    if(full==2) { source=pmrem_build_texel(faces,source_face,direction,size); }
    if(full==3) { source=pmrem_build_eq_texel(faces,direction); }
    if((full==1 || full==2) && (x==0 || x==size-1) && (y==0 || y==size-1)) {
      let chosen=ux_u32(plan+GpuPmremSample.face)%3;
      let axis=0;
      if(chosen==1) { axis=8; }
      if(chosen==2) { axis=16; }
      let reduced=ux_f64_put(direction+axis,ux_f64(direction+axis)*0.99);
      let next=GpuPmrem_plan(scratch+32,4,direction,0.0);
      let adjacent=pmrem_build_input_face(ux_u32(next+GpuPmremSample.face));
      let neighbor=ux_u32(faces+4*adjacent);
      if(full==2) { neighbor=pmrem_build_texel(faces,adjacent,direction,size); }
      let r=(source%256+neighbor%256+1)/2;
      let g=(source/256%256+neighbor/256%256+1)/2;
      let b=(source/65536%256+neighbor/65536%256+1)/2;
      source=r+256*g+65536*b;
    }
    let saved=ux_u32_put(at,source%16777216+4278190080);
    i=i+1;
  }
  return atlas;
}

native function pmrem_build_channel(image:i64,index:i64,channel:i64,pass:i64) f64 {
  if(pass==0) { return 0.0+ux_u8(image+index*4+channel); }
  if(pass==2) { return ux_u16(image+index*6+channel*2)/256.0; }
  if(pass==3) { return DataUtils_fromHalfFloat(ux_u16(image+index*8+channel*2)); }
  return ux_f32(image+index*16+channel*4);
}

native function pmrem_build_linear(image:i64,x:f64,y:f64,channel:i64,pass:i64,width:i64) f64 {
  let ix=f64_floor_i64(x-0.5);
  let iy=f64_floor_i64(y-0.5);
  let fx=x-0.5-ix;
  let fy=y-0.5-iy;
  let index=iy*width+ix;
  let p=pmrem_build_channel(image,index,channel,pass);
  let strideX=1;
  let strideY=width;
  if(pass==3 && width==64 && ix==63) { strideX=0; }
  if(pass==3 && width==64 && iy==31) { strideY=0; }
  let q=pmrem_build_channel(image,index+strideX,channel,pass);
  let r=pmrem_build_channel(image,index+strideY,channel,pass);
  let s=pmrem_build_channel(image,index+strideY+strideX,channel,pass);
  return (p+(q-p)*fx)*(1.0-fy)+(r+(s-r)*fx)*fy;
}

// Round the normalized ping-pong target to a binary16 step before
// continuing the second blur pass in byte-scaled arithmetic.
native function pmrem_build_half(value:f64) f64 {
  let sample=value/255.0;
  let scale=1024.0;
  let normalized=sample;
  while(normalized<1.0 && scale<16777216.0) {
    normalized=normalized*2.0;
    scale=scale*2.0;
  }
  return 255.0*f64_floor_i64(sample*scale+0.5)/scale;
}

native function pmrem_build_f32(at:i64,value:f64) f64 {
  let stored=ux_f32_put(at,value);
  return ux_f32(at);
}

native function pmrem_build_rotate32(at:i64,v:f64,cross:f64,axis:f64,sine:f64,cosine:f64,axial:f64) f64 {
  let a=pmrem_build_f32(at,v*cosine);
  let b=pmrem_build_f32(at,cross*sine);
  let c=pmrem_build_f32(at,axis*axial);
  let sum=pmrem_build_f32(at,a+b);
  return pmrem_build_f32(at,sum+c);
}

native function pmrem_build_blur(atlas:i64,scratch:i64,pass:i64,band:i64,taps:i64,full:i64,base:i64) i64 {
  let size=pmrem_build_tile(base,band);
  let previous=pmrem_build_tile(base,band-1);
  let sourceSize=previous;
  let sourceX=pmrem_build_column(base,band-1);
  let sourceY=4*(base-previous);
  let atlasWidth=336;
  if(base==256) { atlasWidth=768; }
  let stride=atlasWidth;
  if(pass!=0) { sourceSize=size; sourceX=0; sourceY=0; stride=3*size; }
  let targetX=pmrem_build_column(base,band);
  let targetY=4*(base-size);
  let area=size*size;
  let temp=scratch+320;
  if(band==1) { temp=scratch+256; }
  let readMode=pass;
  if(full==2 && pass==0) { readMode=3; }
  let sineAt=160;
  let cosineAt=224;
  if(band==0) {
    temp=scratch+576;
    sineAt=256;
    cosineAt=416;
    if(pass!=0) { readMode=2; }
  }
  let sampled=atlas;
  if(pass!=0) { sampled=temp; }
  let i=0;
  while(i<6*area) {
    let face=i/area;
    let px=i%size;
    let py=i%area/size;
    let direction=pmrem_build_direction(scratch,face,px,py,size);
    let x=ux_f64(direction);
    let y=ux_f64(direction+8);
    let z=ux_f64(direction+16);
    if(full!=0) {
      // Reproduce Float32Array geometry and vertex-stage roundoff before
      // interpolation. At cube edges a one-ULP delta can choose another face.
      let left=pmrem_build_f32(scratch+24,(0.0+face%3)*2.0/3.0-1.0);
      let right=pmrem_build_f32(scratch+24,(1.0+face%3)*2.0/3.0-1.0);
      let min=pmrem_build_f32(scratch+24,(0.0-1.0)/(size-2));
      let max=pmrem_build_f32(scratch+24,1.0+1.0/(size-2));
      let lx=((0.5+size*(face%3)+px)/(1.5*size)-1.0-left)/(right-left);
      let ly=(0.5+py)/size;
      let edgeMin=pmrem_build_f32(scratch+24,2.0*min-1.0);
      let edgeMax=pmrem_build_f32(scratch+24,2.0*max-1.0);
      let u=pmrem_build_f32(scratch+24,edgeMin+lx*(edgeMax-edgeMin));
      let v=pmrem_build_f32(scratch+24,edgeMin+ly*(edgeMax-edgeMin));
      if(face==0 || face==3) { y=v; z=u; if(face==3) { z=0.0-u; } }
      if(face==1 || face==4) { x=0.0-u; z=v; if(face==1) { z=0.0-v; } }
      if(face==2 || face==5) { y=v; x=u; if(face==2) { x=0.0-u; } }
    }
    let ax=1.0;
    let ay=1.0;
    let az=1.0;
    if(band==0) { ax=0.0; az=0.0; }
    if(band==2 || band==4) { ax=-1.0; }
    if(band==3 || band==4) { az=-1.0; }
    if(band==5 || band==6) { ax=0.0; ay=1.618033988749895; az=0.6180339887498948; }
    if(band==6) { az=-az; }
    if(band==7 || band==8) { ax=0.6180339887498948; ay=0.0; az=1.618033988749895; }
    if(band==8) { ax=-ax; }
    if(band>=9) { ax=1.618033988749895; ay=0.6180339887498948; az=0.0; }
    if(band==10) { ax=-ax; }
    if(pass!=0) {
      let crossAxisX=ay*z-az*y;
      let crossAxisY=az*x-ax*z;
      let crossAxisZ=ax*y-ay*x;
      ax=crossAxisX; ay=crossAxisY; az=crossAxisZ;
    }
    let length=f64_sqrt(ax*ax+ay*ay+az*az);
    if(length==0.0) { ax=z; ay=0.0; az=0.0-x; length=f64_sqrt(z*z+x*x); }
    ax=ax/length; ay=ay/length; az=az/length;
    let cross_x=ay*z-az*y;
    let cross_y=az*x-ax*z;
    let cross_z=ax*y-ay*x;
    let dot=ax*x+ay*y+az*z;
    let red=0.0;
    let green=0.0;
    let blue=0.0;
    let tap=1-taps;
    while(tap<taps) {
      let k=tap;
      if(k<0) { k=0-k; }
      let w=ux_f64(scratch+96+k*8);
      let sine=ux_f64(scratch+sineAt+k*8);
      if(tap<0) { sine=0.0-sine; }
      let cosine=ux_f64(scratch+cosineAt+k*8);
      let axial=dot*(1.0-cosine);
      let dx=ux_f64_put(scratch,x*cosine+cross_x*sine+ax*axial);
      let dy=ux_f64_put(scratch+8,y*cosine+cross_y*sine+ay*axial);
      let dz=ux_f64_put(scratch+16,z*cosine+cross_z*sine+az*axial);
      // The base and first blur bands both have 16x16 tiles. The temporary
      // band starts at x=0, so its coordinates agree with mip 4's tiles.
      if(full!=0) {
        // Cube face selection in the shader compares float32 components.
        let fx=pmrem_build_rotate32(scratch+24,x,cross_x,ax,sine,cosine,axial);
        let fy=pmrem_build_rotate32(scratch+24,y,cross_y,ay,sine,cosine,axial);
        let fz=pmrem_build_rotate32(scratch+24,z,cross_z,az,sine,cosine,axial);
        let rx=ux_f64_put(scratch,fx);
        let ry=ux_f64_put(scratch+8,fy);
        let rz=ux_f64_put(scratch+16,fz);
      }
      let plan=GpuPmrem_plan(scratch+32,4,scratch,0.0);
      let sourceFace=ux_u32(plan+GpuPmremSample.face);
      let u=(ux_f64(plan+GpuPmremSample.x0)-16*(sourceFace%3)-1.0)/14.0;
      let v=(ux_f64(plan+GpuPmremSample.y0)-16*(sourceFace/3)-1.0)/14.0;
      let sx=sourceX+(sourceFace%3)*sourceSize+1.0+(sourceSize-2)*u;
      let sy=sourceY+(sourceFace/3)*sourceSize+1.0+(sourceSize-2)*v;
      red=red+w*pmrem_build_linear(sampled,sx,sy,0,readMode,stride);
      green=green+w*pmrem_build_linear(sampled,sx,sy,1,readMode,stride);
      blue=blue+w*pmrem_build_linear(sampled,sx,sy,2,readMode,stride);
      tap=tap+1;
    }
    let row=face/3*size+py;
    let col=face%3*size+px;
    if(pass==0 && band==0) {
      let at=temp+(row*3*size+col)*6;
      let rr=pmrem_build_half(red);
      let gg=pmrem_build_half(green);
      let bb=pmrem_build_half(blue);
      let r=ux_u16_put(at,f64_floor_i64(rr*256.0+0.5));
      let g=ux_u16_put(at+2,f64_floor_i64(gg*256.0+0.5));
      let b=ux_u16_put(at+4,f64_floor_i64(bb*256.0+0.5));
    } else if(pass==0) {
      let at=temp+(row*3*size+col)*16;
      if(full==1) {
        red=pmrem_build_half(red);
        green=pmrem_build_half(green);
        blue=pmrem_build_half(blue);
      }
      let r=ux_f32_put(at,red);
      let g=ux_f32_put(at+4,green);
      let b=ux_f32_put(at+8,blue);
      let alpha=ux_f32_put(at+12,255.0);
    } else {
      let index=(row+targetY)*atlasWidth+col+targetX;
      if(full==2) {
        let at=atlas+index*8;
        let r=ux_u16_put(at,DataUtils_toHalfFloat(red,scratch+24));
        let g=ux_u16_put(at+2,DataUtils_toHalfFloat(green,scratch+24));
        let b=ux_u16_put(at+4,DataUtils_toHalfFloat(blue,scratch+24));
        let a=ux_u16_put(at+6,15360);
      } else {
        let at=atlas+index*4;
        let r=ux_u8_put(at,f64_floor_i64(red+0.5));
        let g=ux_u8_put(at+1,f64_floor_i64(green+0.5));
        let b=ux_u8_put(at+2,f64_floor_i64(blue+0.5));
        let alpha=ux_u8_put(at+3,255);
      }
    }
    i=i+1;
  }
  return atlas;
}

// First prefilter band for six solid 16x16 RGBA8 faces, input order
// +X,-X,+Y,-Y,+Z,-Z. RGB is linear. The caller retains both buffers.
native function pmrem_build_cube(state:i64,atlas:i64,capacity:i64,scratch:i64,work:i64,faces:i64,size:i64,mode:i64) i64 {
  if(size!=16 && size!=32 && size!=64) { return 0-1; }
  if((mode==1 || mode==8) && size!=16) { return 0-1; }
  let bands=6;
  if(size==32) { bands=7; }
  if(size==64) { bands=8; }
  let inputBytes=24;
  if(mode==1) { bands=1; }
  if(mode==7) { inputBytes=24*size*size; }
  if(mode==8) { inputBytes=8192; }
  let bytes=GpuPmremBuild_atlasBytes(size);
  let needed=GpuPmremBuild_workBytes(size);
  if(bands==1) { needed=24832; }
  if(capacity<bytes || work<needed || state%4!=0 || atlas%4!=0 || scratch%8!=0 || faces%4!=0 ||
     pmrem_build_range(state,GpuPmremBuild.size)==0 || pmrem_build_range(atlas,capacity)==0 ||
     pmrem_build_range(scratch,work)==0 || pmrem_build_range(faces,inputBytes)==0 || ux_u32(state+GpuPmremBuild.live)!=0 ||
     pmrem_build_overlap(state,GpuPmremBuild.size,atlas,bytes)!=0 || pmrem_build_overlap(state,GpuPmremBuild.size,scratch,needed)!=0 ||
     pmrem_build_overlap(state,GpuPmremBuild.size,faces,inputBytes)!=0 || pmrem_build_overlap(atlas,bytes,scratch,needed)!=0 ||
     pmrem_build_overlap(atlas,bytes,faces,inputBytes)!=0 || pmrem_build_overlap(scratch,needed,faces,inputBytes)!=0) { return 0-1; }
  let i=0;
  while(i<bytes) { let reset=ux_u32_put(atlas+i,0); i=i+4; }
  let sourceMode=bands>1;
  if(mode==7) { sourceMode=2; }
  if(mode==8) { sourceMode=3; }
  let base=pmrem_build_base(atlas,faces,scratch,sourceMode,size);
  let band=1;
  while(band<=bands) {
    let taps=pmrem_build_kernel(scratch,band,size);
    let first=pmrem_build_blur(atlas,scratch,0,band,taps,bands>1,size);
    let crossTaps=pmrem_build_kernel_pass(scratch,band,size,1);
    let second=pmrem_build_blur(atlas,scratch,1,band,crossTaps,bands>1,size);
    band=band+1;
  }
  let data=ux_u32_put(state+GpuPmremBuild.pixels,atlas);
  let width=ux_u32_put(state+GpuPmremBuild.width,336);
  let height=ux_u32_put(state+GpuPmremBuild.height,4*size);
  let length=ux_u32_put(state+GpuPmremBuild.bytes,bytes);
  let layers=ux_u32_put(state+GpuPmremBuild.layers,bands+1);
  let open=ux_u32_put(state+GpuPmremBuild.live,1);
  return state;
}

native function GpuPmremBuild_fromCubemap(state:i64,atlas:i64,capacity:i64,scratch:i64,work:i64,faces:i64,size:i64) i64 {
  return pmrem_build_cube(state,atlas,capacity,scratch,work,faces,size,1);
}

native function GpuPmremBuild_fromCubemapFull(state:i64,atlas:i64,capacity:i64,scratch:i64,work:i64,faces:i64,size:i64) i64 {
  return pmrem_build_cube(state,atlas,capacity,scratch,work,faces,size,6);
}

native function GpuPmremBuild_fromCubePixels(state:i64,atlas:i64,capacity:i64,scratch:i64,work:i64,faces:i64,size:i64) i64 {
  return pmrem_build_cube(state,atlas,capacity,scratch,work,faces,size,7);
}

// Linear 64x32 RGBA8 panorama producing a 16x16 face atlas.
native function GpuPmremBuild_fromEquirect(state:i64,atlas:i64,capacity:i64,scratch:i64,work:i64,pixels:i64,size:i64) i64 {
  return pmrem_build_cube(state,atlas,capacity,scratch,work,pixels,size,8);
}

// Capture supplies the first 768x512 pixels in CubeUV face order in-place.
// An initial blur needs a full-size packed RGB intermediate.
native function GpuPmremBuild_sceneWork(sigma:f64) i64 {
  if(!(sigma>=0.0 && sigma<=1.0)) { return 0-1; }
  if(sigma==0.0) { return GpuPmremBuild_workBytes(256); }
  return 2359872;
}

native function GpuPmremBuild_sceneSigma(state:i64,atlas:i64,capacity:i64,scratch:i64,work:i64,sigma:f64) i64 {
  let bytes=GpuPmremBuild_atlasBytes(256);
  let needed=GpuPmremBuild_sceneWork(sigma);
  if(needed<0) { return 0-1; }
  if(capacity<bytes || work<needed || state%4!=0 || atlas%4!=0 || scratch%8!=0 ||
     !pmrem_build_range(state,GpuPmremBuild.size) || !pmrem_build_range(atlas,capacity) ||
     !pmrem_build_range(scratch,work) || ux_u32(state+GpuPmremBuild.live)!=0 ||
     pmrem_build_overlap(state,GpuPmremBuild.size,atlas,bytes) ||
     pmrem_build_overlap(state,GpuPmremBuild.size,scratch,needed) ||
     pmrem_build_overlap(atlas,bytes,scratch,needed)) { return 0-1; }
  let at=1572864;
  while(at<bytes) {
    let clear=ux_u32_put(atlas+at,0);
    at=at+4;
  }
  if(sigma>0.0) {
    let initialTaps=pmrem_build_weights(scratch,1.5707963267948966/255.0,sigma,1);
    let first=pmrem_build_blur(atlas,scratch,0,0,initialTaps,1,256);
    let second=pmrem_build_blur(atlas,scratch,1,0,initialTaps,1,256);
  }
  let band=1;
  while(band<=10) {
    let taps=pmrem_build_kernel(scratch,band,256);
    let horizontal=pmrem_build_blur(atlas,scratch,0,band,taps,1,256);
    let crossTaps=pmrem_build_kernel_pass(scratch,band,256,1);
    let vertical=pmrem_build_blur(atlas,scratch,1,band,crossTaps,1,256);
    band=band+1;
  }
  let data=ux_u32_put(state+GpuPmremBuild.pixels,atlas);
  let width=ux_u32_put(state+GpuPmremBuild.width,768);
  let height=ux_u32_put(state+GpuPmremBuild.height,1024);
  let length=ux_u32_put(state+GpuPmremBuild.bytes,bytes);
  let layers=ux_u32_put(state+GpuPmremBuild.layers,11);
  let open=ux_u32_put(state+GpuPmremBuild.live,1);
  return state;
}

native function GpuPmremBuild_sceneAtlas(state:i64,atlas:i64,capacity:i64,scratch:i64,work:i64) i64 {
  return GpuPmremBuild_sceneSigma(state,atlas,capacity,scratch,work,0.0);
}

native function pmrem_build_hdr_base(atlas:i64,source:i64,scratch:i64) i64 {
  let i=0;
  while(i<1536) {
    let face=i/256;
    let px=i%16;
    let py=i%256/16;
    let direction=pmrem_build_direction(scratch,face,px,py,16);
    let x=ux_f64(direction);
    let y=ux_f64(direction+8);
    let z=ux_f64(direction+16);
    let length=f64_sqrt(x*x+y*y+z*z);
    let longitude=ux_math_atan2(z,x);
    let latitude=ux_math_asin(y/length);
    let u=32.0+longitude*10.185916357881302;
    let v=16.0+latitude*10.185916357881302;
    if(u<0.5) { u=0.5; }
    if(u>63.5) { u=63.5; }
    if(v<0.5) { v=0.5; }
    if(v>31.5) { v=31.5; }
    let at=atlas+8*((face/3*16+py)*336+face%3*16+px);
    let channel=0;
    while(channel<3) {
      let rgb=pmrem_build_linear(source,u,v,channel,3,64);
      let bits=DataUtils_toHalfFloat(rgb,scratch+24);
      let stored=ux_u16_put(at+channel*2,bits);
      channel=channel+1;
    }
    let alpha=ux_u16_put(at+6,15360);
    i=i+1;
  }
  return atlas;
}

// Packed 64x32 RGBA16F panorama.
// Reject non-finite input prior to touching the atlas and keep HDR channels.
native function GpuPmremBuild_equirectHDR(state:i64,atlas:i64,capacity:i64,scratch:i64,work:i64,source:i64) i64 {
  let bytes=172032;
  let sourceLen=16384;
  let need=24896;
  if(capacity<bytes || work<need || state%4!=0 || atlas%4!=0 || scratch%8!=0 || source%2!=0 ||
     !pmrem_build_range(state,GpuPmremBuild.size) || !pmrem_build_range(atlas,capacity) ||
     !pmrem_build_range(scratch,work) || !pmrem_build_range(source,sourceLen) ||
     ux_u32(state+GpuPmremBuild.live)!=0 || pmrem_build_overlap(state,GpuPmremBuild.size,atlas,bytes) ||
     pmrem_build_overlap(state,GpuPmremBuild.size,scratch,need) || pmrem_build_overlap(state,GpuPmremBuild.size,source,sourceLen) ||
     pmrem_build_overlap(atlas,bytes,scratch,need) || pmrem_build_overlap(atlas,bytes,source,sourceLen) ||
     pmrem_build_overlap(scratch,need,source,sourceLen)) { return 0-1; }
  let at=0;
  while(at<sourceLen) {
    let bits=ux_u16(source+at);
    if(bits/1024%32==31) { return 0-2; }
    at=at+2;
  }
  at=0;
  while(at<bytes) { let clear=ux_u32_put(atlas+at,0); at=at+4; }
  let base=pmrem_build_hdr_base(atlas,source,scratch);
  let band=1;
  while(band<=6) {
    let taps=pmrem_build_kernel(scratch,band,16);
    let first=pmrem_build_blur(atlas,scratch,0,band,taps,2,16);
    let second=pmrem_build_blur(atlas,scratch,1,band,taps,2,16);
    band=band+1;
  }
  let data=ux_u32_put(state+GpuPmremBuild.pixels,atlas);
  let width=ux_u32_put(state+GpuPmremBuild.width,336);
  let height=ux_u32_put(state+GpuPmremBuild.height,64);
  let length=ux_u32_put(state+GpuPmremBuild.bytes,bytes);
  let layers=ux_u32_put(state+GpuPmremBuild.layers,7);
  let open=ux_u32_put(state+GpuPmremBuild.live,1);
  return state;
}

native function GpuPmremBuild_hasMip(state:i64,mip:i64) i64 {
  if(state%4!=0 || pmrem_build_range(state,GpuPmremBuild.size)==0 || ux_u32(state+GpuPmremBuild.live)!=1) { return 0; }
  let maxMip=4;
  let height=ux_u32(state+GpuPmremBuild.height);
  if(height==128) { maxMip=5; }
  if(height==256) { maxMip=6; }
  if(height==1024) { maxMip=8; }
  return mip<=maxMip && mip>maxMip-ux_u32(state+GpuPmremBuild.layers);
}

native function GpuPmremBuild_release(state:i64) i64 {
  if(GpuPmremBuild_hasMip(state,4)==0) { return 0-1; }
  return GpuPmremBuild_init(state);
}
