// The base record writes its inherited fields into a caller-owned JSON object.
native function material_json_field(at:i64,end:i64,key0:i64,key1:i64,key2:i64,format:i64,value:f64,scratch:i64) i64 {
  let keyBytes=format/2;
  let boolean=format%2;
  if(at<0 || end-at<keyBytes+4 || end>6291456) { return 0-1; }
  let comma=ux_u8_put(at,44);
  let quote=ux_u8_put(at+1,34);
  let i=0;
  let word=key0;
  while(i<keyBytes) {
    if(i==8) { word=key1; }
    if(i==16) { word=key2; }
    let byte=ux_u8_put(at+2+i,word%256);
    word=word/256;
    i=i+1;
  }
  let close=ux_u8_put(at+keyBytes+2,34);
  let colon=ux_u8_put(at+keyBytes+3,58);
  at=at+keyBytes+4;
  if(!boolean) { return json_write_f64(at,end,value,scratch); }
  let wordSize=5;
  let literal=435728179558;
  if(value!=0.0) { wordSize=4; literal=1702195828; }
  if(end-at<wordSize) { return 0-1; }
  i=0;
  while(i<wordSize) {
    let byte=ux_u8_put(at+i,literal%256);
    literal=literal/256;
    i=i+1;
  }
  return at+wordSize;
}
