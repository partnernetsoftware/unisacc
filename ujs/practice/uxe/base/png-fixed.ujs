native function png_bits(src:i64,limit:i64,bit:i64,count:i64,msb:i64) i64 {
  if(bit<0 || count<0 || count>16 || bit>limit-count) { return 0-1; }
  let value=0;
  let place=1;
  let i=0;
  while(i<count) {
    let at=bit+i;
    let low=u32_shr(ux_u8(src+at/8),at%8)%2;
    if(msb==0) { value=value+place*low; place=place*2; }
    else { value=value*2+low; }
    i=i+1;
  }
  return value;
}

native function png_fixed_symbol(src:i64,limit:i64,bit:i64) i64 {
  let a=png_bits(src,limit,bit,7,1);
  if(a<0) { return a; }
  if(a<24) { return 7*512+256+a; }
  let extra=png_bits(src,limit,bit+7,1,1);
  if(extra<0) { return extra; }
  let b=a*2+extra;
  if(b>=48 && b<=191) { return 8*512+b-48; }
  if(b>=192 && b<=199) { return 8*512+b+88; }
  let tail=png_bits(src,limit,bit+8,1,1);
  if(tail<0) { return tail; }
  return 9*512+b*2+tail-256;
}

native function png_fixed_block(src:i64,limit:i64,input:i64,out:i64,size:i64,start:i64) i64 {
  let lengthBase=[3,4,5,6,7,8,9,10,11,13,15,17,19,23,27,31,35,43,51,59,67,83,99,115,131,163,195,227,258];
  let distanceBase=[1,2,3,4,5,7,9,13,17,25,33,49,65,97,129,193,257,385,513,769,1025,1537,2049,3073,4097,6145,8193,12289,16385,24577];
  let bit=input;
  let written=start;
  while(bit<limit) {
    let packed=png_fixed_symbol(src,limit,bit);
    if(packed<0) { return 0-6; }
    bit=bit+packed/512;
    let symbol=packed%512;
    if(symbol==256) { return bit*8388608+written; }
    if(symbol<256) {
      if(written==size) { return 0-6; }
      let saved=ux_u8_put(out+written,symbol);
      written=written+1;
    } else {
      if(symbol>285) { return 0-6; }
      let index=symbol-257;
      let lengthBits=0;
      if(index>=8 && index<28) { lengthBits=index/4-1; }
      let offset=png_bits(src,limit,bit,lengthBits,0);
      if(offset<0) { return 0-6; }
      bit=bit+lengthBits;
      let length=lengthBase[index]+offset;
      let code=png_bits(src,limit,bit,5,1);
      if(code<0 || code>29) { return 0-6; }
      bit=bit+5;
      let extraBits=0;
      if(code>=4) { extraBits=code/2-1; }
      let extra=png_bits(src,limit,bit,extraBits,0);
      if(extra<0) { return 0-6; }
      bit=bit+extraBits;
      let distance=distanceBase[code]+extra;
      if(distance>written || length>size-written) { return 0-6; }
      let i=0;
      while(i<length) {
        let byte=ux_u8(out+written-distance);
        let saved=ux_u8_put(out+written,byte);
        written=written+1;
        i=i+1;
      }
    }
  }
  return 0-6;
}
