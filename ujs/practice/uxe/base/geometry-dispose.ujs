// Dispose emits the public event. Geometry and subscriptions remain valid.
// The snapshot is caller-owned storage disjoint from geometry data.
native function geometry_dispose_event(geo:i64,target:i64,event:i64,out:i64,limit:i64) i64 {
  if(geo%4!=0 || !geometry_public_span(geo,BufferGeometry.size) || event<0 || event>4294967295 ||
     out%4!=0 || limit<0 || limit>1572862 || !geometry_public_span(out,8+4*limit) ||
     !geometry_public_disjoint(out,8+4*limit,geo,BufferGeometry.size)) { return 0-1; }
  let rows=ux_u32(geo+BufferGeometry.listeners);
  let count=ux_u32(geo+BufferGeometry.listenerCount);
  let capacity=ux_u32(geo+BufferGeometry.listenerCapacity);
  if(rows%4!=0 || count>capacity || !geometry_public_span(rows,8*capacity) ||
     !geometry_public_disjoint(out,8+4*limit,rows,8*capacity)) { return 0-1; }
  let attr=ux_u32(geo+BufferGeometry.attributes);
  let groups=ux_u32(geo+BufferGeometry.groups);
  if(!geometry_public_span(attr,8) || !geometry_public_span(groups,8) ||
     !geometry_public_disjoint(out,8+4*limit,attr,8+8*ux_u32(attr+4)) ||
     !geometry_public_disjoint(out,8+4*limit,groups,8+12*ux_u32(groups+4))) { return 0-1; }
  return EventDispatcher_dispatchEvent(geo,event,target,out,limit);
}

native function BufferGeometry_dispose(geo:i64,event:i64,out:i64,limit:i64) i64 {
  return geometry_dispose_event(geo,geo,event,out,limit);
}
