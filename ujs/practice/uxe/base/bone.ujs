native function Bone_create(arena:i64) i64 {
  let node=Object3D_create(arena);
  if(node<0) { return node; }
  let address=Object3D_address(arena,node);
  let kind=ux_u32_put(address+Scene.size,4);
  return node;
}

native function Bone_isBone(arena:i64,node:i64) i64 {
  let address=Object3D_address(arena,node);
  if(address<0) { return 0; }
  return ux_u32(address+Scene.size)==4;
}
