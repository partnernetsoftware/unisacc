struct DirectionalLightHelper {
  plane: u32;
  targetLine: u32;
  matrix: u32;
  active: u32;
  lookX: f64;
  lookY: f64;
  lookZ: f64;
  lineScaleZ: f64;
  red: f64;
  green: f64;
  blue: f64;
}

native function directional_light_helper_update(helper:i64,light:i64,target:i64,rgb:i64) i64 {
  if(!light_helper_rgb_valid(rgb) || !light_helper_disjoint(helper,DirectionalLightHelper.size,rgb,24) ||
     !light_helper_disjoint(helper,DirectionalLightHelper.size,light,128) ||
     !light_helper_disjoint(helper,DirectionalLightHelper.size,target,128)) { return 0-1; }
  let look=light_helper_look(helper+DirectionalLightHelper.lookX,light,target);
  if(look<0) { return 0-1; }
  let c=light_helper_rgb_copy(helper+DirectionalLightHelper.red,rgb);
  return helper;
}

// The caller supplies updated world matrices and optional linear RGB override.
native function DirectionalLightHelper_update(helper:i64,target:i64,lightRGB:i64,overrideRGB:i64) i64 {
  if(!light_helper_span(helper,DirectionalLightHelper.size,8) ||
     ux_u32(helper+DirectionalLightHelper.active)!=1) { return 0-1; }
  let rgb=overrideRGB;
  if(rgb==0-1) { rgb=lightRGB; }
  return directional_light_helper_update(helper,ux_u32(helper+DirectionalLightHelper.matrix),target,rgb);
}

native function DirectionalLightHelper_init(helper:i64,plane:i64,line:i64,light:i64,target:i64,size:f64,
    lightRGB:i64,overrideRGB:i64) i64 {
  let rgb=overrideRGB;
  if(rgb==0-1) { rgb=lightRGB; }
  if(!light_helper_span(helper,DirectionalLightHelper.size,8) || !light_helper_span(plane,60,4) ||
     !light_helper_span(line,24,4) || !light_helper_span(light,128,8) || !light_helper_span(target,128,8) ||
     !light_helper_rgb_valid(rgb) || size-size!=0.0 ||
     !light_helper_disjoint(helper,DirectionalLightHelper.size,plane,60) ||
     !light_helper_disjoint(helper,DirectionalLightHelper.size,line,24) ||
     !light_helper_disjoint(plane,60,line,24) || !light_helper_disjoint(plane,60,light,128) ||
     !light_helper_disjoint(plane,60,target,128) || !light_helper_disjoint(plane,60,rgb,24) ||
     !light_helper_disjoint(line,24,light,128) || !light_helper_disjoint(line,24,target,128) ||
     !light_helper_disjoint(line,24,rgb,24)) { return 0-1; }
  let look=directional_light_helper_update(helper,light,target,rgb);
  if(look<0) { return 0-1; }
  let planeData=helper_directional_plane(plane,size);
  let lineData=helper_directional_line(line,1.0);
  let p=ux_u32_put(helper+DirectionalLightHelper.plane,plane);
  let l=ux_u32_put(helper+DirectionalLightHelper.targetLine,line);
  let m=ux_u32_put(helper+DirectionalLightHelper.matrix,light);
  let a=ux_u32_put(helper+DirectionalLightHelper.active,1);
  return helper;
}

native function DirectionalLightHelper_dispose(helper:i64) i64 {
  if(!light_helper_span(helper,DirectionalLightHelper.size,8) ||
     ux_u32(helper+DirectionalLightHelper.active)!=1) { return 0-1; }
  let a=ux_u32_put(helper+DirectionalLightHelper.active,0);
  return 0;
}
