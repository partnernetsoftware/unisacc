struct GpuRenderState {
  depth: u32;
  depthWrite: u32;
  blend: u32;
  equationRgb: u32;
  equationAlpha: u32;
  sourceRgb: u32;
  destinationRgb: u32;
  sourceAlpha: u32;
  destinationAlpha: u32;
  blendColor: u32;
  stencil: u32;
  stencilReference: u32;
  stencilReadMask: u32;
  stencilWriteMask: u32;
  stencilFail: u32;
  stencilDepthFail: u32;
  stencilPass: u32;
  cull: u32;
  clockwise: u32;
  polygonOffset: u32;
  polygonFactor: f32;
  polygonUnits: f32;
  colorMask: u32;
}

native function GpuPacket_setRenderState(packet:i64,capacity:i64,state:i64) i64 {
  if(state<0 || state%4!=0 || state>6291456-GpuRenderState.size ||
     (state<packet+capacity && packet<state+GpuRenderState.size)) { return 0-1; }
  let bytes=8+GpuRenderState.size;
  let command=gpu_packet_slot(packet,capacity,bytes);
  if(command<0) { return command; }
  let opcode=ux_u32_put(command,6);
  let span=ux_u32_put(command+4,bytes);
  let copied=uxe_copy_record(command+8,state,GpuRenderState.size);
  return gpu_packet_publish(packet,bytes);
}
