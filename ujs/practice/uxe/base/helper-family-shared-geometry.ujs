// Version ownership follows the shared color buffer. Keep its original
// version word allocated until every copied view has been retired.
native function AxesHelper_getColorVersion(helper:i64) i64 {
  if(!axes_span(helper,AxesHelper.size) ||
     ux_u32(helper+AxesHelper.active)!=1) { return 0-1; }
  let ref=ux_u32(helper+AxesHelper.colorVersionRef);
  if(!axes_span(ref,4)) { return 0-1; }
  return ux_u32(ref);
}

native function AxesHelper_copy(dst:i64,src:i64) i64 {
  if(!axes_span(src,AxesHelper.size) || !axes_span(dst,AxesHelper.size) ||
     ux_u32(src+AxesHelper.active)!=1) { return 0-1; }
  if(dst==src) { return dst; }
  let positions=ux_u32(src+AxesHelper.positions);
  let colors=ux_u32(src+AxesHelper.colors);
  let ref=ux_u32(src+AxesHelper.colorVersionRef);
  let count=ux_u32(src+AxesHelper.count);
  if(count!=6 || !axes_span(positions,72) || !axes_span(colors,72) || !axes_span(ref,4) ||
     !axes_disjoint(dst,AxesHelper.size,src,AxesHelper.size) ||
     !axes_disjoint(dst,AxesHelper.size,positions,72) ||
     !axes_disjoint(dst,AxesHelper.size,colors,72) ||
     (ref!=dst+AxesHelper.colorVersion && !axes_disjoint(dst,AxesHelper.size,ref,4))) { return 0-1; }
  let p=ux_u32_put(dst+AxesHelper.positions,positions);
  let c=ux_u32_put(dst+AxesHelper.colors,colors);
  let n=ux_u32_put(dst+AxesHelper.count,count);
  let v=ux_u32_put(dst+AxesHelper.colorVersionRef,ref);
  let a=ux_u32_put(dst+AxesHelper.active,1);
  return dst;
}

native function AxesHelper_clone(dst:i64,src:i64) i64 {
  if(dst==src) { return 0-1; }
  return AxesHelper_copy(dst,src);
}

// r160 copies the Line resources without replacing the destination's Box3.
// The constructor invoked by clone has no Box3 until the caller binds one.
native function box3_helper_copy_views(dst:i64,src:i64,box:i64) i64 {
  let positions=ux_u32(src+Box3Helper.positions);
  let indices=ux_u32(src+Box3Helper.indices);
  let source_box=ux_u32(src+Box3Helper.box);
  if(!boxh_span(positions,96,4) || !boxh_span(indices,48,2) ||
     boxh_overlap(dst,Box3Helper.size,src,Box3Helper.size) ||
     boxh_overlap(dst,Box3Helper.size,positions,96) ||
     boxh_overlap(dst,Box3Helper.size,indices,48) ||
     boxh_overlap(dst,Box3Helper.size,source_box,48) ||
     boxh_overlap(dst,Box3Helper.size,box,48)) { return 0-1; }
  let b=ux_u32_put(dst+Box3Helper.box,box);
  let p=ux_u32_put(dst+Box3Helper.positions,positions);
  let i=ux_u32_put(dst+Box3Helper.indices,indices);
  let a=ux_u32_put(dst+Box3Helper.active,1);
  return dst;
}

native function Box3Helper_copy(dst:i64,src:i64) i64 {
  if(!boxh_span(dst,Box3Helper.size,4) || !boxh_span(src,Box3Helper.size,4) ||
     ux_u32(dst+Box3Helper.active)!=1 || ux_u32(src+Box3Helper.active)!=1) { return 0-1; }
  if(dst==src) { return dst; }
  return box3_helper_copy_views(dst,src,ux_u32(dst+Box3Helper.box));
}

native function Box3Helper_clone(dst:i64,src:i64) i64 {
  if(!boxh_span(dst,Box3Helper.size,4) || !boxh_span(src,Box3Helper.size,4) ||
     ux_u32(src+Box3Helper.active)!=1) { return 0-1; }
  return box3_helper_copy_views(dst,src,4294967295);
}

native function Box3Helper_bindBox(helper:i64,box:i64) i64 {
  if(!boxh_span(helper,Box3Helper.size,4) || ux_u32(helper+Box3Helper.active)!=1 ||
     !boxh_span(box,48,8) || boxh_overlap(helper,Box3Helper.size,box,48) ||
     boxh_overlap(ux_u32(helper+Box3Helper.positions),96,box,48) ||
     boxh_overlap(ux_u32(helper+Box3Helper.indices),48,box,48)) { return 0-1; }
  let linked=ux_u32_put(helper+Box3Helper.box,box);
  return helper;
}
