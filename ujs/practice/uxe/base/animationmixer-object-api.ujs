// Public entry points for compositions without AnimationObjectGroup.
native function AnimationMixer_update(mixer:i64,dt:f64) i64 {
  return mixer_update_object(mixer,dt,0);
}

native function AnimationMixer_setTime(mixer:i64,time:f64) i64 {
  return mixer_update_object(mixer,time,1);
}

native function AnimationMixer_stopAllAction(mixer:i64) i64 {
  return mixer_stop_object(mixer);
}
