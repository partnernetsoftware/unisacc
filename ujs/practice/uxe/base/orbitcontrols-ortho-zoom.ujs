// Consume the same pending dolly as the perspective controller, applying
// it to the lens before the normal orbit frame consumes angular and pan deltas.
native function OrbitControls_zoomOrthographic(control:i64,lens:i64,camera:i64,minZoom:f64,maxZoom:f64) i64 {
  if(!orbit_valid(control) || lens<0 || lens%8!=0 || lens>6291456-OrthographicCamera.size ||
     camera<0 || camera%8!=0 || camera>6291456-Camera.size ||
     minZoom<0.0 || minZoom-minZoom!=0.0 || maxZoom<minZoom || maxZoom!=maxZoom) { return 0-1; }
  let zoom=ux_f64(lens+OrthographicCamera.zoom);
  let scale=ux_f64(control+OrbitControls.zoomScale);
  if(zoom<=0.0 || zoom-zoom!=0.0 || scale<=0.0 || scale-scale!=0.0) { return 0-1; }
  let next=vector_limit(zoom/scale,minZoom,maxZoom);
  if(next<=0.0 || next-next!=0.0) { return 0-1; }
  let changed=ux_f64_put(lens+OrthographicCamera.zoom,next);
  let projection=ortho_project(lens,camera);
  if(projection<0) {
    let restored=ux_f64_put(lens+OrthographicCamera.zoom,zoom);
    return projection;
  }
  let consumed=ux_f64_put(control+OrbitControls.zoomScale,1.0);
  return 1;
}
