// Consume the same pending dolly as the perspective controller, applying
// it to the lens before the normal orbit frame consumes angular and pan deltas.
native function OrbitControls_zoomOrthographic(control:i64,lens:i64,camera:i64,minZoom:f64,maxZoom:f64) i64 {
  if(!orbit_valid(control) || lens<0 || lens%8!=0 || lens>6291456-OrthographicCamera.size ||
     camera<0 || camera%8!=0 || camera>6291456-Camera.size ||
     minZoom<0.0 || minZoom-minZoom!=0.0 || maxZoom<minZoom || maxZoom!=maxZoom) { return 0-1; }
  let zoom=ux_f64(lens+OrthographicCamera.zoom);
  let scale=ux_f64(control+OrbitControls.zoomScale);
  if(zoom<=0.0 || zoom-zoom!=0.0 || scale<=0.0 || scale-scale!=0.0) { return 0-1; }
  let next=vector_limit(zoom/scale,minZoom,maxZoom);
  if(next<=0.0 || next-next!=0.0) { return 0-1; }
  let changed=ux_f64_put(lens+OrthographicCamera.zoom,next);
  let projection=ortho_project(lens,camera);
  if(projection<0) {
    let restored=ux_f64_put(lens+OrthographicCamera.zoom,zoom);
    return projection;
  }
  let consumed=ux_f64_put(control+OrbitControls.zoomScale,1.0);
  return 1;
}

// anchor is the world-space offset from the frustum center at unit zoom.
// It excludes the center bias, which is unchanged by orthographic zoom.
native function OrbitControls_zoomOrthoCursor(control:i64,lens:i64,camera:i64,anchor:i64,minZoom:f64,maxZoom:f64) i64 {
  if(!orbit_valid(control) || lens<0 || lens%8!=0 || lens>6291456-OrthographicCamera.size ||
     anchor<0 || anchor%8!=0 || anchor>6291456-24) { return 0-1; }
  let oldZoom=ux_f64(lens+OrthographicCamera.zoom);
  let scale=ux_f64(control+OrbitControls.zoomScale);
  if(scale==1.0) { return 0; }
  if(oldZoom<=0.0 || scale<=0.0 || minZoom<0.0 || maxZoom<minZoom) { return 0-1; }
  let nextZoom=vector_limit(oldZoom/scale,minZoom,maxZoom);
  if(nextZoom<=0.0 || nextZoom-nextZoom!=0.0) { return 0-1; }
  let delta=1.0/oldZoom-1.0/nextZoom;
  let dx=delta*ux_f64(anchor);
  let dy=delta*ux_f64(anchor+8);
  let dz=delta*ux_f64(anchor+16);
  let x=ux_f64(control+OrbitControls.x)+dx;
  let y=ux_f64(control+OrbitControls.y)+dy;
  let z=ux_f64(control+OrbitControls.z)+dz;
  let tx=ux_f64(control+OrbitControls.targetX)+dx;
  let ty=ux_f64(control+OrbitControls.targetY)+dy;
  let tz=ux_f64(control+OrbitControls.targetZ)+dz;
  if(x-x!=0.0 || y-y!=0.0 || z-z!=0.0 || tx-tx!=0.0 || ty-ty!=0.0 || tz-tz!=0.0) { return 0-1; }
  let zoomed=OrbitControls_zoomOrthographic(control,lens,camera,minZoom,maxZoom);
  if(zoomed!=1) { return zoomed; }
  let a=ux_f64_put(control+OrbitControls.x,x);
  let b=ux_f64_put(control+OrbitControls.y,y);
  let c=ux_f64_put(control+OrbitControls.z,z);
  let d=ux_f64_put(control+OrbitControls.targetX,tx);
  let e=ux_f64_put(control+OrbitControls.targetY,ty);
  let f=ux_f64_put(control+OrbitControls.targetZ,tz);
  return 1;
}
