// Each inlined helper uses distinct locals until the compiler has lexical frames.
function ux_math_abs(a_x) {
  let a_y = a_x;
  if (a_x < 0.0 || (a_x == 0.0 && 1.0 / a_x < 0.0)) { a_y = 0.0 - a_x; }
  return a_y;
}

function ux_math_sin(b_x) {
  let b_y = 0.0 / 0.0;
  if (b_x == 0.0) {
    b_y = b_x;
  } else if (ux_math_abs(b_x) <= 1048576.0) {
    let b_turns = f64_floor_i64(b_x * 0.15915494309189535 + 0.5);
    let b_t = (b_x - b_turns * 6.28125) - b_turns * 0.001935307179586477;
    if (b_t > 1.5707963267948966) { b_t = 3.141592653589793 - b_t; }
    if (b_t < 0.0 - 1.5707963267948966) { b_t = (0.0 - 3.141592653589793) - b_t; }
    let b_q = b_t * b_t;
    let b_term = b_t;
    let b_n = 2;
    b_y = b_t;
    while (b_n <= 20) {
      b_term = (0.0 - b_term) * b_q / (b_n * (b_n + 1));
      b_y = b_y + b_term;
      b_n = b_n + 2;
    }
  }
  return b_y;
}

function ux_math_cos(c_x) {
  let c_y = 0.0 / 0.0;
  if (ux_math_abs(c_x) <= 1048576.0) {
    let c_turns = f64_floor_i64(c_x * 0.15915494309189535 + 0.5);
    let c_t = (c_x - c_turns * 6.28125) - c_turns * 0.001935307179586477;
    let c_sign = 1.0;
    if (c_t > 1.5707963267948966) { c_t = 3.141592653589793 - c_t; c_sign = 0.0 - 1.0; }
    if (c_t < 0.0 - 1.5707963267948966) { c_t = (0.0 - 3.141592653589793) - c_t; c_sign = 0.0 - 1.0; }
    let c_q = c_t * c_t;
    let c_term = 1.0;
    let c_n = 1;
    c_y = c_term;
    while (c_n <= 19) {
      c_term = (0.0 - c_term) * c_q / (c_n * (c_n + 1));
      c_y = c_y + c_term;
      c_n = c_n + 2;
    }
    c_y = c_y * c_sign;
  }
  return c_y;
}

function ux_math_tan(d_x) {
  return ux_math_sin(d_x) / ux_math_cos(d_x);
}

function ux_math_atan(e_x) {
  let e_t = ux_math_abs(e_x);
  let e_offset = 0.0;
  if (e_t > 2.414213562373095) {
    e_offset = 1.5707963267948966;
    e_t = (0.0 - 1.0) / e_t;
  } else if (e_t > 0.41421356237309503) {
    e_offset = 0.7853981633974483;
    e_t = (e_t - 1.0) / (e_t + 1.0);
  }
  let e_square = (0.0 - e_t) * e_t;
  let e_term = e_t;
  let e_sum = e_t;
  let e_n = 3;
  while (e_n <= 43) {
    e_term = e_term * e_square;
    e_sum = e_sum + e_term / e_n;
    e_n = e_n + 2;
  }
  let e_y = e_sum + e_offset;
  if (e_x < 0.0) { e_y = 0.0 - e_y; }
  if (e_x == 0.0) { e_y = e_x; }
  return e_y;
}

function ux_math_atan2(f_y, ...f_args) {
  let f_x = f_args[0];
  let f_a = 0.0 / 0.0;
  if (f_x == f_x && f_y == f_y) {
    let f_x_negative = f_x < 0.0 || (f_x == 0.0 && 1.0 / f_x < 0.0);
    let f_y_negative = f_y < 0.0 || (f_y == 0.0 && 1.0 / f_y < 0.0);
    let f_ax = ux_math_abs(f_x);
    let f_ay = ux_math_abs(f_y);
    f_a = 0.0;
    if (f_ax == 1.0 / 0.0 && f_ay == f_ax) {
      f_a = 0.7853981633974483;
    } else if (f_ay > f_ax) {
      f_a = 1.5707963267948966 - ux_math_atan(f_ax / f_ay);
    } else if (f_ax > 0.0) {
      f_a = ux_math_atan(f_ay / f_ax);
    }
    if (f_x_negative) { f_a = 3.141592653589793 - f_a; }
    if (f_y_negative) { f_a = f_a * (0.0 - 1.0); }
  }
  return f_a;
}

function ux_math_asin(g_x) {
  let g_result = g_x;
  if (g_x != 0.0) {
    g_result = ux_math_atan2(g_x, f64_sqrt((1.0 - g_x) * (1.0 + g_x)));
  }
  return g_result;
}

function ux_math_acos(h_x) {
  return ux_math_atan2(f64_sqrt((1.0 - h_x) * (1.0 + h_x)), h_x);
}

function ux_math_exp(i_x) {
  let i_y = i_x;
  if (i_x > 709.782712893384) {
    i_y = 1.0 / 0.0;
  } else if (i_x < 0.0 - 745.1332191019411) {
    i_y = 0.0;
  } else if (i_x == i_x) {
    let i_n = f64_floor_i64(i_x * 1.4426950408889634 + 0.5);
    let i_r = (i_x - i_n * 0.6931471803691238) - i_n * (0.19082149292705877 / 1000000000.0);
    let i_term = 1.0;
    let i_k = 1;
    i_y = i_term;
    while (i_k <= 17) {
      i_term = i_term * i_r / i_k;
      i_y = i_y + i_term;
      i_k = i_k + 1;
    }
    while (i_n >= 32) { i_y = i_y * 4294967296.0; i_n = i_n - 32; }
    while (i_n <= 0 - 32) { i_y = i_y / 4294967296.0; i_n = i_n + 32; }
    while (i_n > 0) { i_y = i_y * 2.0; i_n = i_n - 1; }
    while (i_n < 0) { i_y = i_y * 0.5; i_n = i_n + 1; }
  }
  return i_y;
}

function ux_math_log(j_x) {
  let j_y = 0.0 / 0.0;
  if (j_x == 0.0) {
    j_y = (0.0 - 1.0) / 0.0;
  } else if (j_x == 1.0 / 0.0) {
    j_y = j_x;
  } else if (j_x > 0.0) {
    let j_e = 0;
    let j_m = j_x;
    while (j_m >= 4294967296.0) { j_m = j_m / 4294967296.0; j_e = j_e + 32; }
    while (j_m < 1.0 / 4294967296.0) { j_m = j_m * 4294967296.0; j_e = j_e - 32; }
    while (j_m >= 1.4142135623730951) { j_m = j_m * 0.5; j_e = j_e + 1; }
    while (j_m < 0.7071067811865476) { j_m = j_m * 2.0; j_e = j_e - 1; }
    let j_u = (j_m - 1.0) / (j_m + 1.0);
    let j_q = j_u * j_u;
    let j_term = j_u;
    let j_n = 3;
    let j_sum = j_u;
    while (j_n <= 23) {
      j_term = j_term * j_q;
      j_sum = j_sum + j_term / j_n;
      j_n = j_n + 2;
    }
    j_y = j_e * 0.6931471803691238 + (2.0 * j_sum + j_e * (0.19082149292705877 / 1000000000.0));
  }
  return j_y;
}

function ux_math_hypot(k_x, ...k_args) {
  let k_a = ux_math_abs(k_x);
  let k_b = ux_math_abs(k_args[0]);
  let k_y = 0.0 / 0.0;
  if (k_a == 1.0 / 0.0 || k_b == 1.0 / 0.0) {
    k_y = 1.0 / 0.0;
  } else if (k_a == k_a && k_b == k_b) {
    if (k_b > k_a) { let k_t = k_a; k_a = k_b; k_b = k_t; }
    k_y = k_a;
    if (k_a != 0.0) { let k_q = k_b / k_a; k_y = k_a * f64_sqrt(1.0 + k_q * k_q); }
  }
  return k_y;
}

function ux_math_cbrt(l_x) {
  let l_y = l_x;
  let l_a = ux_math_abs(l_x);
  if (l_a > 0.0 && l_a < 1.0 / 0.0) {
    let l_scale = 1.0;
    while (l_a >= 8.0) { l_a = l_a * 0.125; l_scale = l_scale * 2.0; }
    while (l_a < 1.0) { l_a = l_a * 8.0; l_scale = l_scale * 0.5; }
    let l_r = (l_a + 2.0) / 3.0;
    let l_n = 0;
    while (l_n < 9) {
      l_r = (2.0 * l_r + l_a / (l_r * l_r)) / 3.0;
      l_n = l_n + 1;
    }
    l_y = l_r * l_scale;
    if (l_x < 0.0) { l_y = 0.0 - l_y; }
  }
  return l_y;
}

function ux_math_pow(m_x, ...m_args) {
  let m_e = m_args[0];
  let m_a = ux_math_abs(m_x);
  let m_y = 0.0 / 0.0;
  if (m_e == 0.0) {
    m_y = 1.0;
  } else if (m_x == m_x && m_e == m_e) {
    let m_odd = 0;
    let m_integer = 0;
    let m_magnitude = ux_math_abs(m_e);
    if (m_magnitude < 9007199254740992.0) {
      let m_i = f64_floor_i64(m_e);
      m_integer = m_i == m_e;
      if (m_integer) { m_odd = m_i % 2 != 0; }
    } else {
      m_integer = 1;
    }
    if (m_magnitude == 1.0 / 0.0) {
      if (m_a != 1.0) {
        m_y = 0.0;
        if ((m_a > 1.0 && m_e > 0.0) || (m_a < 1.0 && m_e < 0.0)) { m_y = 1.0 / 0.0; }
      }
    } else if (m_a == 0.0 || m_a == 1.0 / 0.0) {
      m_y = 0.0;
      if ((m_a == 0.0 && m_e < 0.0) || (m_a != 0.0 && m_e > 0.0)) { m_y = 1.0 / 0.0; }
      if (m_odd && (m_x < 0.0 || 1.0 / m_x < 0.0)) { m_y = m_y * (0.0 - 1.0); }
    } else if (m_x > 0.0 || m_integer) {
      m_y = ux_math_exp(m_e * ux_math_log(m_a));
      if (m_odd && m_x < 0.0) { m_y = 0.0 - m_y; }
    }
  }
  return m_y;
}
