struct StereoEyeRecord {
  camera: u32;
  lens: u32;
  world: u32;
  layerMask: u32;
  matrixAutoUpdate: u32;
}

// Materialize a standalone Camera and a default PerspectiveCamera lens.
// The stereo update affects the eye projection and world matrices.
native function StereoCamera_readEye(stereo:i64,eye:i64,out:i64,capacity:i64) i64 {
  let storage=704;
  if(stereo<0 || stereo%8!=0 || stereo>6291456-StereoCamera.size ||
     out<0 || out%8!=0 || out>6291456-storage || capacity<storage || eye<0 || eye>1 ||
     Camera_blocksOverlap(out,storage,stereo,StereoCamera.size) ||
     ux_u32(stereo+StereoCamera.cached)==0) { return 0-1; }
  let projection=ux_u32(stereo+StereoCamera.leftProjection+eye*4);
  let world=ux_u32(stereo+StereoCamera.leftWorld+eye*4);
  if(projection%8!=0 || world%8!=0 || projection>6291456-128 || world>6291456-128 ||
     Camera_blocksOverlap(out,storage,projection,128) ||
     Camera_blocksOverlap(out,storage,world,128)) { return 0-1; }
  let camera=Camera_init(out+32,out+192);
  if(camera<0) { return camera; }
  let lens=PerspectiveCamera_init(out+56,50.0,1.0,0.1,2000.0);
  let view=Matrix4_copy(out+576,world);
  let copy=Matrix4_copy(ux_u32(camera+Camera.projectionMatrix),projection);
  let inverse=Camera_updateProjectionInverse(camera);
  let viewInverse=Camera_updateMatrixWorld(camera,view);
  let a=ux_u32_put(out+StereoEyeRecord.camera,camera);
  let b=ux_u32_put(out+StereoEyeRecord.lens,lens);
  let c=ux_u32_put(out+StereoEyeRecord.world,view);
  let mask=ux_u32(stereo+StereoCamera.leftMask+eye*4);
  let auto=ux_u32(stereo+StereoCamera.leftAutoUpdate+eye*4);
  let d=ux_u32_put(out+StereoEyeRecord.layerMask,mask);
  let e=ux_u32_put(out+StereoEyeRecord.matrixAutoUpdate,auto);
  return out;
}
