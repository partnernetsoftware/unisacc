struct EffectComposer {
  read: u32;
  write: u32;
  passes: u32;
  count: u32;
  capacity: u32;
  width: u32;
  height: u32;
  screen: u32;
  epoch: u32;
}

struct ComposerPass {
  id: u32;
  flags: u32;
}

struct ComposerStep {
  id: u32;
  read: u32;
  write: u32;
  screen: u32;
  flags: u32;
}

struct ComposerPlan {
  count: u32;
  read: u32;
  write: u32;
  epoch: u32;
}

native function composer_span(at:i64,size:i64) i64 {
  return at>=0 && at%4==0 && size>=0 && at<=6291456-size;
}

native function composer_alias(a:i64,bytes:i64,b:i64,size:i64) i64 {
  return bytes>0 && size>0 && a<b+size && b<a+bytes;
}

native function composer_live(composer:i64) i64 {
  if(!composer_span(composer,EffectComposer.size) || ux_u32(composer+EffectComposer.epoch)==0) { return 0; }
  let passes=ux_u32(composer+EffectComposer.passes);
  let count=ux_u32(composer+EffectComposer.count);
  let capacity=ux_u32(composer+EffectComposer.capacity);
  return count<=capacity && capacity<=1024 && composer_span(passes,capacity*ComposerPass.size) &&
    !composer_alias(composer,EffectComposer.size,passes,capacity*ComposerPass.size);
}

native function EffectComposer_init(composer:i64,read:i64,write:i64,passes:i64,capacity:i64,width:i64,height:i64) i64 {
  if(!composer_span(composer,EffectComposer.size) || read<1 || read>4294967295 ||
     write<1 || write>4294967295 || read==write || capacity<0 || capacity>1024 ||
     width<1 || width>65535 || height<1 || height>65535 ||
     !composer_span(passes,capacity*ComposerPass.size) ||
     composer_alias(composer,EffectComposer.size,passes,capacity*ComposerPass.size)) { return 0-1; }
  let a=ux_u32_put(composer+EffectComposer.read,read);
  let b=ux_u32_put(composer+EffectComposer.write,write);
  let c=ux_u32_put(composer+EffectComposer.passes,passes);
  let d=ux_u32_put(composer+EffectComposer.count,0);
  let e=ux_u32_put(composer+EffectComposer.capacity,capacity);
  let f=ux_u32_put(composer+EffectComposer.width,width);
  let g=ux_u32_put(composer+EffectComposer.height,height);
  let h=ux_u32_put(composer+EffectComposer.screen,1);
  let epoch=ux_u32_put(composer+EffectComposer.epoch,1);
  return composer;
}

native function composer_advance(composer:i64) i64 {
  let next=ux_u32(composer+EffectComposer.epoch)+1;
  if(next>4294967295) { return 0-1; }
  let saved=ux_u32_put(composer+EffectComposer.epoch,next);
  return composer;
}

// Flags use bit 0 enabled, bit 1 needsSwap and bit 2 clear.
native function EffectComposer_addPass(composer:i64,id:i64,flags:i64) i64 {
  if(!composer_live(composer) || id<1 || id>4294967295 || flags<0 || flags>7) { return 0-1; }
  let count=ux_u32(composer+EffectComposer.count);
  if(count>=ux_u32(composer+EffectComposer.capacity)) { return 0-2; }
  if(composer_advance(composer)<0) { return 0-1; }
  let row=ux_u32(composer+EffectComposer.passes)+count*ComposerPass.size;
  let a=ux_u32_put(row+ComposerPass.id,id);
  let b=ux_u32_put(row+ComposerPass.flags,flags);
  let c=ux_u32_put(composer+EffectComposer.count,count+1);
  return count;
}

native function EffectComposer_resize(composer:i64,width:i64,height:i64) i64 {
  if(!composer_live(composer) || width<1 || width>65535 || height<1 || height>65535) { return 0-1; }
  if(ux_u32(composer+EffectComposer.width)==width && ux_u32(composer+EffectComposer.height)==height) { return 0; }
  if(composer_advance(composer)<0) { return 0-1; }
  let a=ux_u32_put(composer+EffectComposer.width,width);
  let b=ux_u32_put(composer+EffectComposer.height,height);
  return 1;
}

native function EffectComposer_screen(composer:i64,on:i64) i64 {
  if(!composer_live(composer) || (on!=0 && on!=1)) { return 0-1; }
  if(composer_advance(composer)<0) { return 0-1; }
  let a=ux_u32_put(composer+EffectComposer.screen,on);
  return composer;
}

native function EffectComposer_plan(composer:i64,plan:i64,steps:i64,capacity:i64) i64 {
  if(!composer_live(composer) || !composer_span(plan,ComposerPlan.size) ||
     capacity<0 || capacity>1024 || !composer_span(steps,capacity*ComposerStep.size)) { return 0-1; }
  let count=ux_u32(composer+EffectComposer.count);
  let rows=ux_u32(composer+EffectComposer.passes);
  let pass_bytes=ux_u32(composer+EffectComposer.capacity)*ComposerPass.size;
  let step_bytes=capacity*ComposerStep.size;
  if(composer_alias(composer,EffectComposer.size,plan,ComposerPlan.size) ||
     composer_alias(rows,pass_bytes,plan,ComposerPlan.size) ||
     composer_alias(composer,EffectComposer.size,steps,step_bytes) ||
     composer_alias(rows,pass_bytes,steps,step_bytes) ||
     composer_alias(plan,ComposerPlan.size,steps,step_bytes)) { return 0-1; }
  let enabled=0;
  let i=0;
  while(i<count) {
    let flags=ux_u32(rows+i*ComposerPass.size+ComposerPass.flags);
    if(flags>7 || ux_u32(rows+i*ComposerPass.size+ComposerPass.id)==0) { return 0-1; }
    enabled=enabled+u32_and(flags,1);
    i=i+1;
  }
  if(enabled>capacity) { return 0-2; }
  let read=ux_u32(composer+EffectComposer.read);
  let write=ux_u32(composer+EffectComposer.write);
  let screen=ux_u32(composer+EffectComposer.screen);
  if(read==0 || write==0 || read==write || screen>1) { return 0-1; }
  let step=0;
  i=0;
  while(i<count) {
    let row=rows+i*ComposerPass.size;
    let flags=ux_u32(row+ComposerPass.flags);
    if(u32_and(flags,1)!=0) {
      let at=steps+step*ComposerStep.size;
      let a=ux_u32_put(at+ComposerStep.id,ux_u32(row+ComposerPass.id));
      let b=ux_u32_put(at+ComposerStep.read,read);
      let c=ux_u32_put(at+ComposerStep.write,write);
      let d=ux_u32_put(at+ComposerStep.screen,screen!=0 && step+1==enabled);
      let e=ux_u32_put(at+ComposerStep.flags,flags);
      if(u32_and(flags,2)!=0) {
        let temporary=read;
        read=write;
        write=temporary;
      }
      step=step+1;
    }
    i=i+1;
  }
  let a=ux_u32_put(plan+ComposerPlan.count,enabled);
  let b=ux_u32_put(plan+ComposerPlan.read,read);
  let c=ux_u32_put(plan+ComposerPlan.write,write);
  let d=ux_u32_put(plan+ComposerPlan.epoch,ux_u32(composer+EffectComposer.epoch));
  return enabled;
}

// A successful renderer submission consumes the plan. A failed submission
// leaves the composer pair unchanged, so the caller can retry.
native function EffectComposer_commit(composer:i64,plan:i64) i64 {
  if(!composer_live(composer) || !composer_span(plan,ComposerPlan.size) ||
     composer_alias(composer,EffectComposer.size,plan,ComposerPlan.size) ||
     ux_u32(composer+EffectComposer.epoch)!=ux_u32(plan+ComposerPlan.epoch)) { return 0-1; }
  let a=ux_u32(composer+EffectComposer.read);
  let b=ux_u32(composer+EffectComposer.write);
  let read=ux_u32(plan+ComposerPlan.read);
  let write=ux_u32(plan+ComposerPlan.write);
  if(!((a==read && b==write) || (a==write && b==read)) || composer_advance(composer)<0) { return 0-1; }
  let r=ux_u32_put(composer+EffectComposer.read,read);
  let w=ux_u32_put(composer+EffectComposer.write,write);
  return composer;
}
