// Convert a validated node transform record to the column-major Matrix4
// representation shared by the render paths.
native function GltfLoader_transformMatrix(record:i64,out:i64) i64 {
  if(record%8!=0 || out%8!=0 || !loading_span(record,136) ||
     !loading_span(out,128) || !file_disjoint(record,136,out,128)) { return 0-1; }
  let kind=ux_u32(record);
  if(kind>1 || ux_u32(record+4)!=0) { return 0-2; }
  let src=record+8;
  if(kind==1) {
    let copied=uxe_copy_record(out,src,128);
    return out;
  }
  return Matrix4_compose(out,src,src+24,src+56);
}
