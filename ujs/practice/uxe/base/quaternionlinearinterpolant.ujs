native function QuatLinearInterpolant_evaluate(view:i64,t:f64,out:i64,scratch:i64) i64 {
  let stride=animation_sample_output(view,out);
  if(stride<4 || stride%4!=0 || t!=t) { return 0-1; }
  let times=ux_u32(view+AnimationSamples.times);
  let count=ux_u32(view+AnimationSamples.count);
  let upper=animation_sample_upper(times,count,t);
  if(upper==0 || upper==count) { return DiscreteInterpolant_evaluate(view,t,out); }
  let values=ux_u32(view+AnimationSamples.values);
  if(!animation_span(scratch,96) || scratch%8!=0 ||
     animation_overlap(scratch,96,view,AnimationSamples.size) || animation_overlap(scratch,96,out,stride*4) ||
     animation_overlap(scratch,96,times,count*4) || animation_overlap(scratch,96,values,count*stride*4)) { return 0-1; }
  let lower=upper-1;
  let begin=ux_f32(times+lower*4);
  let end=ux_f32(times+upper*4);
  let fraction=(t-begin)/(end-begin);
  let lane=0;
  while(lane<stride) {
    let a=values+(lower*stride+lane)*4;
    let b=values+(upper*stride+lane)*4;
    let q0=Quaternion_set(scratch,ux_f32(a),ux_f32(a+4),ux_f32(a+8),ux_f32(a+12));
    let q1=Quaternion_set(scratch+32,ux_f32(b),ux_f32(b+4),ux_f32(b+8),ux_f32(b+12));
    let result=Quaternion_slerpQuaternions(scratch+64,q0,q1,fraction);
    let i=0;
    while(i<4) {
      // r160 uses a fixed destination offset, even for multiple quaternions.
      let cell=ux_f32_put(out+i*4,ux_f64(result+i*8));
      i=i+1;
    }
    lane=lane+4;
  }
  return out;
}
