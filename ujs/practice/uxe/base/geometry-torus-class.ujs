struct TorusGeometryParameters {
  radius: f64;
  tube: f64;
  radialSegments: f64;
  tubularSegments: f64;
  arc: f64;
}

native function TorusGeometry_create(at:i64,raw:i64,arena:i64,bytes:i64,params:i64) i64 {
  if(params%8!=0 || !geometry_primitive_raw(at,raw,arena,bytes,params,TorusGeometryParameters.size)) { return 0-1; }
  let radius=ux_f64(params+TorusGeometryParameters.radius);
  let tube=ux_f64(params+TorusGeometryParameters.tube);
  let radial=ux_f64(params+TorusGeometryParameters.radialSegments);
  let tubular=ux_f64(params+TorusGeometryParameters.tubularSegments);
  let arc=ux_f64(params+TorusGeometryParameters.arc);
  let outside=radius+tube;
  let inside=radius-tube;
  if(outside-outside!=0.0 || inside-inside!=0.0 || arc-arc!=0.0 ||
     !(radial>=1.0 && radial<262145.0) || !(tubular>=1.0 && tubular<262145.0)) { return 0-1; }
  let generated=TorusGeometry_generate(raw,radius,tube,f64_floor_i64(radial),f64_floor_i64(tubular),arc);
  if(generated<0) { return generated; }
  let installed=GeometryBuffers_asGeometry(raw,GeometryPrimitive_geometry(at),arena,bytes,7,0,0);
  if(installed<0) { return installed; }
  return geometry_primitive_store(at,6,radius,tube,radial,tubular,arc,0.0);
}

native function TorusGeometry_copy(dst:i64,src:i64,arena:i64,bytes:i64) i64 {
  return geometry_primitive_copy(dst,src,arena,bytes,6);
}

native function TorusGeometry_clone(dst:i64,src:i64,arena:i64,bytes:i64) i64 {
  return geometry_primitive_clone(dst,src,arena,bytes,6);
}

native function TorusGeometry_dispose(at:i64,event:i64,out:i64,limit:i64) i64 {
  return geometry_primitive_dispose(at,event,out,limit,6);
}
