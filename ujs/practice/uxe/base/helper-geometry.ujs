native function helper_plane_outline(dst:i64,scale:f64) i64 {
  let xyz=[2,0,1,0,2,1,0,0,1,2,2,1,0,2,1,0,0,1,2,0,1,2,2,1];
  let i=0;
  while(i<24) {
    let value=0.0;
    if(xyz[i]!=1) { value=(xyz[i]-1)*scale; }
    let wrote=ux_f32_put(dst+i*4,value);
    i=i+1;
  }
  return dst;
}

