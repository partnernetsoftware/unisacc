native function AudioLoader_decodeAsync(instance:i64,id:i64,clip:i64,pcm:i64,capacity:i64) i64 {
  if(loader_family_kind(instance)!=9 || !loader_family_decode_range(instance,clip,AudioResource.size) ||
     !loader_family_decode_range(instance,pcm,capacity)) { return 0-1; }
  let file=loader_family_ready(instance,id);
  if(file<0) { return file; }
  let result=AudioLoader_decodeWav(file,clip,pcm,capacity);
  let released=FileLoader_release(file,id);
  return result;
}
