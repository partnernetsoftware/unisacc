struct Shape {
  contour: u32;
  holes: u32;
  capacity: u32;
  count: u32;
}

struct ShapeHolePoints {
  points: u32;
  capacity: u32;
  count: u32;
}

native function Shape_init(shape:i64,contour:i64,holes:i64,capacity:i64) i64 {
  if(shape<0 || shape>6291456-Shape.size || shape%4!=0 ||
     holes<0 || holes>6291456 || holes%4!=0 || capacity<0 || capacity>(6291456-holes)/4 ||
     (capacity!=0 && shape<holes+capacity*4 && holes<shape+Shape.size)) { return 0-1; }
  let outer=ux_u32_put(shape+Shape.contour,contour);
  let table=ux_u32_put(shape+Shape.holes,holes);
  let bound=ux_u32_put(shape+Shape.capacity,capacity);
  let count=ux_u32_put(shape+Shape.count,0);
  return shape;
}

native function Shape_addHole(shape:i64,hole:i64) i64 {
  let count=ux_u32(shape+Shape.count);
  if(count>=ux_u32(shape+Shape.capacity)) { return 0-1; }
  let table=ux_u32(shape+Shape.holes);
  let entry=ux_u32_put(table+count*4,hole);
  let size=ux_u32_put(shape+Shape.count,count+1);
  return shape;
}

native function Shape_getPointsHoles(shape:i64,views:i64,divisions:i64,scratch:i64) i64 {
  let count=ux_u32(shape+Shape.count);
  let table=ux_u32(shape+Shape.holes);
  if(views<0 || views>6291456 || views%4!=0 || count>(6291456-views)/ShapeHolePoints.size) { return 0-1; }
  let i=0;
  while(i<count) {
    let view=views+i*ShapeHolePoints.size;
    let entry=ux_u32(table+i*4);
    let points=Path_getPoints(entry,ux_u32(view+ShapeHolePoints.points),
      ux_u32(view+ShapeHolePoints.capacity),divisions,scratch);
    if(points<0) { return points; }
    let written=ux_u32_put(view+ShapeHolePoints.count,points);
    i=i+1;
  }
  return count;
}

function Shape_extractPoints(shape,...shape_points) {
  let outer=Path_getPoints(ux_u32(shape+Shape.contour),shape_points[0],shape_points[1],
    shape_points[3],shape_points[4]);
  let result=0-1;
  if(outer>=0 && Shape_getPointsHoles(shape,shape_points[2],shape_points[3],shape_points[4])>=0) {
    result=outer;
  }
  return result;
}
