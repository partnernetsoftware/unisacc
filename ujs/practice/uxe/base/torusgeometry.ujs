native function TorusGeometry_generate(torus:i64,radius:f64,tube:f64,radial:i64,
                                       tubular:i64,arc:f64) i64 {
  if(radial<1 || tubular<1 || radial>262144 || tubular>262144) { return 0-1; }
  let columns=tubular+1;
  let points=columns*(radial+1);
  let cells=6*radial*tubular;
  if(!GeometryBuffers_fits(torus,points,cells)) { return 0-1; }
  let vertex=ux_u32(torus+GeometryBuffers.vertices);
  let index=ux_u32(torus+GeometryBuffers.indices);
  let sign=1.0;
  if(tube<0.0) { sign=0.0-1.0; }
  if(tube==0.0) { sign=0.0; }
  let row=0;
  while(row<=radial) {
    let v=row*1.0/radial;
    let pitch=v*6.283185307179586;
    let c=ux_math_cos(pitch);
    let s=ux_math_sin(pitch);
    let ring=radius+tube*c;
    let column=0;
    while(column<=tubular) {
      let u=column*1.0/tubular;
      let yaw=u*arc;
      let x=ux_math_cos(yaw);
      let y=ux_math_sin(yaw);
      vertex=GeometryBuffers_vertex(vertex,x*ring,y*ring,tube*s,sign*c*x,sign*c*y,sign*s,u,v);
      if(row<radial && column<tubular) {
        let upper=row*columns+column;
        index=geometry_quad(index,upper+columns,upper,upper+1,upper+columns+1);
      }
      column=column+1;
    }
    row=row+1;
  }
  return GeometryBuffers_commit(torus,points,cells);
}
