native function ellipse_json_key(scratch:i64,field:i64) i64 {
  let bytes=[97,88,0,
    97,89,0,
    120,82,97,100,105,117,115,0,
    121,82,97,100,105,117,115,0,
    97,83,116,97,114,116,65,110,103,108,101,0,
    97,69,110,100,65,110,103,108,101,0,
    97,82,111,116,97,116,105,111,110,0,
    97,67,108,111,99,107,119,105,115,101,0,
    97,114,99,76,101,110,103,116,104,68,105,118,105,115,105,111,110,115,0,
    116,121,112,101,0];
  let starts=[0,3,6,14,22,34,44,54,65,84];
  let offset=starts[field];
  let size=0;
  while(bytes[offset+size]!=0) {
    let saved=ux_u8_put(scratch+size,bytes[offset+size]);
    size=size+1;
  }
  return size;
}

native function ellipse_json_span(shape:i64,at:i64,end:i64,scratch:i64,work:i64) i64 {
  return helper_buffer_span(shape,EllipseCurve.size,8) && end>at &&
    helper_buffer_span(at,end-at,1) && helper_buffer_span(scratch,work,8) &&
    helper_buffer_disjoint(shape,EllipseCurve.size,at,end-at) &&
    helper_buffer_disjoint(shape,EllipseCurve.size,scratch,work) &&
    helper_buffer_disjoint(at,end-at,scratch,work);
}

native function ellipse_json_type(scratch:i64,circle:i64) i64 {
  let ellipse=[69,108,108,105,112,115,101,67,117,114,118,101];
  let arc=[65,114,99,67,117,114,118,101];
  let size=12;
  if(circle) { size=8; }
  let i=0;
  while(i<size) {
    let byte=ellipse[i];
    if(circle) { byte=arc[i]; }
    let saved=ux_u8_put(scratch+i,byte);
    i=i+1;
  }
  return size;
}

native function ellipse_json_write(shape:i64,dst:i64,end:i64,scratch:i64,divisions:i64,circle:i64) i64 {
  if(!ellipse_json_span(shape,dst,end,scratch,1136) || divisions<1 || divisions>65535 ||
     ux_u32(shape+EllipseCurve.clockwise)>1) { return 0-1; }
  let header=[123,34,109,101,116,97,100,97,116,97,34,58,123,34,118,101,114,115,105,111,110,34,58,52,46,54,44,34,116,121,112,101,34,58,34,67,117,114,118,101,34,44,34,103,101,110,101,114,97,116,111,114,34,58,34,67,117,114,118,101,46,116,111,74,83,79,78,34,125];
  let p=dst;
  let j=0;
  while(j<69) { p=json_byte(p,end,header[j]); j=j+1; }
  let i=0;
  while(i<10) {
    p=json_byte(p,end,44);
    let keyBytes=ellipse_json_key(scratch,i);
    p=json_write_string(p,end,scratch,keyBytes);
    p=json_byte(p,end,58);
    if(i<7) {
      let value=ux_f64(shape+i*8);
      if(circle && i==3) { value=ux_f64(shape+EllipseCurve.radiusX); }
      if(circle && i==6) { value=0.0; }
      p=json_write_f64(p,end,value,scratch+32);
    } else if(i==7) {
      let label=[102,97,108,115,101];
      let length=5;
      if(ux_u32(shape+EllipseCurve.clockwise)) { label=[116,114,117,101,0]; length=4; }
      j=0;
      while(j<length) { p=json_byte(p,end,label[j]); j=j+1; }
    } else if(i==8) {
      p=json_write_f64(p,end,0.0+divisions,scratch+32);
    } else {
      let size=ellipse_json_type(scratch,circle);
      p=json_write_string(p,end,scratch,size);
    }
    i=i+1;
  }
  return json_byte(p,end,125);
}

native function ellipse_json_read(shape:i64,input:i64,end:i64,scratch:i64,circle:i64) i64 {
  if(!ellipse_json_span(shape,input,end,scratch,96)) { return 0-1; }
  let root=json_space(input,end);
  let stop=json_value_end(root,end);
  if(stop<0 || json_space(stop,end)!=end) { return 0-1; }
  let divisions=0;
  let clockwise=0;
  let i=0;
  while(i<10) {
    let size=ellipse_json_key(scratch,i);
    let token=json_find_key(root,stop,scratch,size);
    if(token<0) { return 0-1; }
    if(i==9) {
      let typeBytes=ellipse_json_type(scratch,circle);
      let got=Json_decodeString(token,stop,scratch+16,12);
      if(got!=typeBytes) { return 0-1; }
      let j=0;
      while(j<got) {
        if(ux_u8(scratch+j)!=ux_u8(scratch+16+j)) { return 0-1; }
        j=j+1;
      }
    } else if(i==7) {
      let tail=json_scalar_end(token,stop);
      if(tail-token==4 && ux_u8(token)==116) { clockwise=1; }
      else if(tail-token!=5 || ux_u8(token)!=102) { return 0-1; }
    } else {
      let value=json_read_number(token,stop);
      if(!(value-value==0.0)) { return 0-1; }
      if(i==8) {
        if(value<1.0 || value>65535.0) { return 0-1; }
        divisions=f64_floor_i64(value);
        if(value!=0.0+divisions) { return 0-1; }
      } else {
        let saved=ux_f64_put(scratch+32+i*8,value);
      }
    }
    i=i+1;
  }
  if(circle && (ux_f64(scratch+48)!=ux_f64(scratch+56) || ux_f64(scratch+80)!=0.0)) { return 0-1; }
  i=0;
  while(i<7) { let saved=ux_f64_put(shape+8*i,ux_f64(scratch+32+8*i)); i=i+1; }
  let flag=ux_u32_put(shape+EllipseCurve.clockwise,clockwise);
  return divisions;
}

native function ellipse_curve_length(shape:i64,sample:i64,divisions:i64,circle:i64) f64 {
  if(!helper_buffer_span(shape,EllipseCurve.size,8) || !helper_buffer_span(sample,16,8) ||
     !helper_buffer_disjoint(shape,EllipseCurve.size,sample,16) ||
     divisions<1 || divisions>65535) { return 0.0-1.0; }
  let first=ellipse_point(sample,shape,0.0,circle);
  let x=ux_f64(sample);
  let y=ux_f64(sample+8);
  let length=0.0;
  let i=1;
  while(i<=divisions) {
    let next=ellipse_point(sample,shape,(0.0+i)/(0.0+divisions),circle);
    let dx=ux_f64(sample)-x;
    let dy=ux_f64(sample+8)-y;
    length=length+f64_sqrt(dx*dx+dy*dy);
    x=ux_f64(sample);
    y=ux_f64(sample+8);
    i=i+1;
  }
  return length;
}

native function ArcCurve_toJSON(shape:i64,dst:i64,end:i64,scratch:i64,divisions:i64) i64 {
  return ellipse_json_write(shape,dst,end,scratch,divisions,1);
}

native function ArcCurve_fromJSON(shape:i64,input:i64,end:i64,scratch:i64) i64 {
  return ellipse_json_read(shape,input,end,scratch,1);
}

native function ArcCurve_getLength(shape:i64,sample:i64,divisions:i64) f64 {
  return ellipse_curve_length(shape,sample,divisions,1);
}

native function EllipseCurve_toJSON(shape:i64,dst:i64,end:i64,scratch:i64,divisions:i64) i64 {
  return ellipse_json_write(shape,dst,end,scratch,divisions,0);
}

native function EllipseCurve_fromJSON(shape:i64,input:i64,end:i64,scratch:i64) i64 {
  return ellipse_json_read(shape,input,end,scratch,0);
}

native function EllipseCurve_getLength(shape:i64,sample:i64,divisions:i64) f64 {
  return ellipse_curve_length(shape,sample,divisions,0);
}
