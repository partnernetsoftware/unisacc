native function GpuMaterial_passCount(side:i64,transparent:i64,singlePass:i64) i64 {
  if(side<0 || side>2 || transparent<0 || transparent>1 || singlePass<0 || singlePass>1) { return 0-1; }
  if(side==GpuMaterial_twoPassTag() && transparent==1 && singlePass==0) { return 2; }
  return 1;
}

native function GpuMaterial_passSide(side:i64,transparent:i64,singlePass:i64,pass:i64) i64 {
  let count=GpuMaterial_passCount(side,transparent,singlePass);
  if(pass<0 || pass>=count) { return 0-1; }
  if(count==2) { return 1-pass; }
  return side;
}
