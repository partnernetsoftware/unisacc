// Serialize smoothed magnitudes into Web Audio's byte decibel range.
// This read does not advance smoothing or depend on the browser clock.
native function AudioAnalyser_getFrequencyData(history:i64,bins:i64,out:i64,length:i64,minDb:f64,maxDb:f64) i64 {
  if(bins<16 || bins>16384 || !audio_window_size(bins*2) ||
     !audio_play_span(history,bins*8,8) || !audio_play_span(out,length,1) ||
     audio_play_overlap(history,bins*8,out,length) || minDb-minDb!=0.0 || maxDb-maxDb!=0.0 ||
     maxDb<=minDb || (maxDb-minDb)-(maxDb-minDb)!=0.0) { return 0-1; }
  let count=length;
  if(count>bins) { count=bins; }
  let i=0;
  while(i<count) {
    let magnitude=ux_f64(history+i*8);
    if(magnitude<0.0 || magnitude-magnitude!=0.0) { return 0-2; }
    i=i+1;
  }
  i=0;
  while(i<count) {
    let magnitude=ux_f64(history+i*8);
    let byte=0;
    if(magnitude>0.0) {
      let db=8.685889638065036*ux_math_log(magnitude);
      if(db>=maxDb) { byte=255; }
      else if(db>minDb) { byte=f64_floor_i64(255.0*((db-minDb)/(maxDb-minDb))); }
    }
    let put=ux_u8_put(out+i,byte);
    i=i+1;
  }
  return count;
}
