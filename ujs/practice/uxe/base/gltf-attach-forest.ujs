// This initial adapter consumes empty, live Object3D nodes created in glTF
// node order. Graph validation and ordered edge staging run before any
// attachment. The selected scene's root order is published separately.
native function GltfLoader_attachForest(glb:i64,arena:i64,handles:i64,count:i64,key:i64,work:i64,space:i64) i64 {
  if(!loading_span(glb,GlbResource.size) || count<1 || count>256 ||
     arena<0 || arena%8!=0 || arena>6291448 || handles%4!=0 || work%4!=0 ||
     !loading_span(handles,count*4) || !loading_span(work,space) || space<count*24 ||
     !loading_span(key,16) || !file_disjoint(handles,count*4,work,space) ||
     !file_disjoint(handles,count*4,key,16) || !file_disjoint(work,space,key,16) ||
     !file_disjoint(work,space,glb,GlbResource.size)) { return 0-1; }
  let slots=ux_u32(arena);
  let arenaBytes=8+slots*424;
  if(slots<count || arena>6291456-arenaBytes ||
     !file_disjoint(arena,arenaBytes,glb,GlbResource.size) || !file_disjoint(arena,arenaBytes,handles,count*4) ||
     !file_disjoint(arena,arenaBytes,key,16) || !file_disjoint(arena,arenaBytes,work,space)) { return 0-1; }
  let json=ux_u32(glb+GlbResource.json);
  let jsonBytes=ux_u32(glb+GlbResource.jsonBytes);
  let bin=ux_u32(glb+GlbResource.bin);
  let binBytes=ux_u32(glb+GlbResource.binBytes);
  if(!loading_span(json,jsonBytes) || !loading_span(bin,binBytes) ||
     !file_disjoint(work,space,json,jsonBytes) || !file_disjoint(work,space,bin,binBytes) ||
     !file_disjoint(arena,arenaBytes,json,jsonBytes) || !file_disjoint(arena,arenaBytes,bin,binBytes)) { return 0-1; }
  let parent=work;
  let scratch=parent+count*4;
  let children=scratch+count*8;
  let edges=children+count*4;
  let verified=GltfLoader_nodeParents(glb,parent,count,scratch,count*5,key);
  if(verified!=count) { return 0-2; }
  let i=0;
  let previous=0;
  let total=0;
  while(i<count) {
    let handle=ux_u32(handles+i*4);
    let at=Object3D_address(arena,handle);
    if(handle<=previous || at<0 || ux_u32(at+Object3D.parent)!=0 ||
       ux_u32(at+Object3D.firstChild)!=0 || ux_u32(at+Object3D.lastChild)!=0 ||
       ux_u32(at+Object3D.nextSibling)!=0 || ux_u32(at+Object3D.prevSibling)!=0) { return 0-3; }
    previous=handle;
    let childrenCount=GltfLoader_nodeChildren(glb,i,children,count,key);
    if(childrenCount<0 || total+childrenCount>count) { return 0-2; }
    let j=0;
    while(j<childrenCount) {
      let child=ux_u32(children+j*4);
      if(ux_u32(parent+child*4)!=i) { return 0-2; }
      let a=ux_u32_put(edges+total*8,handle);
      let b=ux_u32_put(edges+total*8+4,ux_u32(handles+child*4));
      total=total+1;
      j=j+1;
    }
    i=i+1;
  }
  i=0;
  while(i<total) {
    let attached=Object3D_add(arena,ux_u32(edges+i*8),ux_u32(edges+i*8+4));
    if(attached<0) { return attached; }
    i=i+1;
  }
  return total;
}
