// Bind the read attachment as source and one scalar as u_amount.
native function ShaderPass_render(step:i64,generation:i64,shader:i64,amount:f64) i64 {
  if(amount-amount!=0.0 || amount>65536.0 || amount<0.0-65536.0) { return 0-1; }
  let write=native_sample_write(step,generation,shader);
  if(write<0) { return write; }
  return host_gpu_native_filter(generation,ux_u32(step+ComposerStep.read),write,shader,amount);
}
