// LDR constant-color blocks across the 14 two-dimensional ASTC footprints.
native function astc_footprint(format:i64,vertical:i64) i64 {
  let id=format-37808;
  if(id>=32) { id=id-32; }
  if(id<0 || id>=14) { return 0; }
  if(!vertical) {
    if(id==0) { return 4; }
    if(id<=2) { return 5; }
    if(id<=4) { return 6; }
    if(id<=7) { return 8; }
    if(id<=11) { return 10; }
    return 12;
  }
  if(id<=1) { return 4; }
  if(id==2 || id==3 || id==5 || id==8) { return 5; }
  if(id==4 || id==6 || id==9) { return 6; }
  if(id==7 || id==10) { return 8; }
  if(id<=12) { return 10; }
  return 12;
}

native function astc_extent(at:i64,shift:i64) i64 {
  let value=ux_u8(at)+ux_u8(at+1)*256+ux_u8(at+2)*65536;
  return u32_shr(value,shift)%8192;
}

native function astc_ldr_constant(at:i64) i64 {
  if((ux_u8(at)+256*ux_u8(at+1))%4096!=3580) { return 0; }
  if(ux_u32(at)==4294966780 && ux_u32(at+4)==4294967295) { return 1; }
  let s0=astc_extent(at+1,4);
  let s1=astc_extent(at+3,1);
  let t0=astc_extent(at+4,6);
  let t1=u32_shr(ux_u8(at+6)+256*ux_u8(at+7),3);
  return s0<s1 && t0<t1;
}

native function CompressedTexture_astcRGBA8(level:i64,dst:i64,capacity:i64) i64 {
  if(!loading_span(level,CompressedMip.size)) { return 0-1; }
  let format=ux_u32(level+CompressedMip.format);
  let blockWidth=astc_footprint(format,0);
  let blockHeight=astc_footprint(format,1);
  if(!blockWidth) { return 0-2; }
  let width=ux_u32(level+CompressedMip.width);
  let height=ux_u32(level+CompressedMip.height);
  let data=ux_u32(level+CompressedMip.data);
  let size=ux_u32(level+CompressedMip.bytes);
  let columns=(width+blockWidth-1)/blockWidth;
  if(width<1 || width>16384 || height<1 || height>16384 ||
     size!=columns*((height+blockHeight-1)/blockHeight)*16 || data>6291456-size) { return 0-3; }
  let count=width*height*4;
  if(dst<0 || dst>6291456-count || capacity<count ||
     !file_disjoint(level,CompressedMip.size,data,size) ||
     !file_disjoint(dst,count,level,CompressedMip.size) ||
     !file_disjoint(dst,count,data,size)) { return 0-1; }
  let at=data;
  while(at<data+size) {
    if(!astc_ldr_constant(at)) { return 0-4; }
    at=at+16;
  }
  let y=0;
  while(y<height) {
    let x=0;
    while(x<width) {
      let block=data+(y/blockHeight*columns+x/blockWidth)*16;
      let pixel=dst+(y*width+x)*4;
      let red=ux_u8_put(pixel,ux_u8(block+9));
      let green=ux_u8_put(pixel+1,ux_u8(block+11));
      let blue=ux_u8_put(pixel+2,ux_u8(block+13));
      let alpha=ux_u8_put(pixel+3,ux_u8(block+15));
      x=x+1;
    }
    y=y+1;
  }
  return count;
}
