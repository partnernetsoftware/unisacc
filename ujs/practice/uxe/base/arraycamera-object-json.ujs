// r160 writes the inherited PerspectiveCamera object and omits cameras.
// UXE's root-level cameras extension contains indices in a caller-owned registry.
struct ArrayCameraJson {
  uuid: u32;
  uuidBytes: u32;
  registry: u32;
  registryCount: u32;
  output: u32;
  capacity: u32;
}

native function array_camera_json_key(dst:i64,end:i64) i64 {
  let p=camera_json_word(dst,end,1633886764,4);
  p=camera_json_word(p,end,1634887021,4);
  return camera_json_word(p,end,1530536563,4);
}

native function ArrayCamera_toJSON(node:i64,lens:i64,array:i64,settings:i64,dst:i64,end:i64,scratch:i64) i64 {
  if(!camera_json_disjoint(settings,ArrayCameraJson.size,dst,end) ||
     !camera_json_disjoint(settings,ArrayCameraJson.size,scratch,scratch+1104) ||
     !camera_json_disjoint(array,ArrayCamera.size,dst,end) ||
     !camera_json_disjoint(array,ArrayCamera.size,scratch,scratch+1104)) { return 0-1; }
  let registry=ux_u32(settings+ArrayCameraJson.registry);
  let available=ux_u32(settings+ArrayCameraJson.registryCount);
  let count=ux_u32(array+ArrayCamera.count);
  let handles=ux_u32(array+ArrayCamera.cameras);
  if(available>64 || count>64 || registry%4!=0 || handles%4!=0 ||
     !camera_json_disjoint(registry,available*4,dst,end) ||
     !camera_json_disjoint(registry,available*4,scratch,scratch+1104) ||
     !camera_json_disjoint(handles,count*4,dst,end) ||
     !camera_json_disjoint(handles,count*4,scratch,scratch+1104)) { return 0-1; }
  let p=PerspectiveCamera_toJSON(node,lens,ux_u32(settings+ArrayCameraJson.uuid),
    ux_u32(settings+ArrayCameraJson.uuidBytes),dst,end,scratch);
  if(p<0) { return p; }
  p=array_camera_json_key(p-1,end);
  let i=0;
  while(i<count && p>=0) {
    let handle=ux_u32(handles+i*4);
    let index=0;
    while(index<available && ux_u32(registry+index*4)!=handle) { index=index+1; }
    if(handle==0 || index>=available) { return 0-2; }
    if(i>0) { p=json_byte(p,end,44); }
    p=json_write_f64(p,end,0.0+index,scratch);
    i=i+1;
  }
  p=json_byte(p,end,93);
  return json_byte(p,end,125);
}

native function array_camera_json_read(input:i64,end:i64,settings:i64,scratch:i64) i64 {
  let key=LoaderJson_find(json_space(input,end),end,scratch,1701667171,7561586,0,7);
  if(key==0-2) { return 0; }
  if(key<0 || ux_u8(key)!=91) { return 0-2; }
  let registry=ux_u32(settings+ArrayCameraJson.registry);
  let available=ux_u32(settings+ArrayCameraJson.registryCount);
  let capacity=ux_u32(settings+ArrayCameraJson.capacity);
  let at=json_space(key+1,end);
  let count=0;
  while(at>=0 && at<end && ux_u8(at)!=93) {
    if(count>=capacity) { return 0-2; }
    let index=LoaderJson_uint(at,end,0-1);
    if(index<0 || index>=available) { return 0-2; }
    let handle=ux_u32(registry+index*4);
    if(handle==0) { return 0-2; }
    let saved=ux_u32_put(scratch+320+count*4,handle);
    count=count+1;
    at=json_space(json_value_end(at,end),end);
    if(at<0 || at>=end) { return 0-2; }
    if(ux_u8(at)==44) { at=json_space(at+1,end); }
    else if(ux_u8(at)!=93) { return 0-2; }
  }
  if(at<0 || at>=end) { return 0-2; }
  return count;
}

native function ArrayCamera_fromJSON(node:i64,lens:i64,array:i64,settings:i64,input:i64,end:i64,scratch:i64) i64 {
  if(input<0 || end<=input || end>6291456 ||
     !camera_json_disjoint(node,Object3D.size,input,end) ||
     !camera_json_disjoint(settings,ArrayCameraJson.size,scratch,scratch+576) ||
     !camera_json_disjoint(array,ArrayCamera.size,input,end) ||
     !camera_json_disjoint(array,ArrayCamera.size,scratch,scratch+576) ||
     !camera_json_disjoint(array,ArrayCamera.size,settings,settings+ArrayCameraJson.size) ||
     !camera_json_disjoint(scratch,576,input,end)) { return 0-1; }
  let registry=ux_u32(settings+ArrayCameraJson.registry);
  let output=ux_u32(settings+ArrayCameraJson.output);
  let available=ux_u32(settings+ArrayCameraJson.registryCount);
  let capacity=ux_u32(settings+ArrayCameraJson.capacity);
  let matrix=ux_u32(node+Object3D.localMatrix);
  if(available>64 || capacity>64 || array%4!=0 || registry%4!=0 || output%4!=0 ||
     !camera_json_disjoint(node,Object3D.size,scratch,scratch+576) ||
     !camera_json_disjoint(lens,PerspectiveCamera.size,scratch,scratch+576) ||
     !camera_json_disjoint(matrix,128,scratch,scratch+576) ||
     !camera_json_disjoint(array,ArrayCamera.size,node,node+Object3D.size) ||
     !camera_json_disjoint(array,ArrayCamera.size,lens,lens+PerspectiveCamera.size) ||
     !camera_json_disjoint(array,ArrayCamera.size,matrix,matrix+128) ||
     !camera_json_disjoint(registry,available*4,scratch,scratch+576) ||
     !camera_json_disjoint(output,capacity*4,scratch,scratch+576) ||
     !camera_json_disjoint(output,capacity*4,registry,registry+available*4) ||
     !camera_json_disjoint(output,capacity*4,array,array+ArrayCamera.size) ||
     !camera_json_disjoint(output,capacity*4,node,node+Object3D.size) ||
     !camera_json_disjoint(output,capacity*4,lens,lens+PerspectiveCamera.size) ||
     !camera_json_disjoint(output,capacity*4,matrix,matrix+128) ||
     !camera_json_disjoint(output,capacity*4,settings,settings+ArrayCameraJson.size) ||
     !camera_json_disjoint(output,capacity*4,input,end)) { return 0-1; }
  let count=array_camera_json_read(input,end,settings,scratch);
  if(count<0) { return count; }
  let base=PerspectiveCamera_fromJSON(node,lens,input,end,scratch);
  if(base<0) { return base; }
  if(count>0) { let copies=uxe_copy_record(output,scratch+320,count*4); }
  return ArrayCamera_init(array,output,count);
}
