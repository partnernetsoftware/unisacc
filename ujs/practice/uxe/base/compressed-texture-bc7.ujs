// Khronos Data Format 1.4, BPTC BC7 mode 6 (one RGBA subset).
native function bc7_bits(block:i64,offset:i64,limit:i64) i64 {
  let byte=block+offset/8;
  let shift=offset%8;
  let word=ux_u8(byte);
  if(u32_shr(256,shift)<limit) { word=word+256*ux_u8(byte+1); }
  return u32_shr(word,shift)%limit;
}

native function bc7_endpoint(block:i64,endpoint:i64,pbit:i64) i64 {
  let offset=7+endpoint*7;
  let red=2*bc7_bits(block,offset,128)+pbit;
  let green=2*bc7_bits(block,offset+14,128)+pbit;
  let blue=2*bc7_bits(block,offset+28,128)+pbit;
  let alpha=2*bc7_bits(block,offset+42,128)+pbit;
  return red+256*green+65536*blue+16777216*alpha;
}

native function bc7_interp(first:i64,second:i64,weight:i64) i64 {
  return ((64-weight)*first+weight*second+32)/64;
}

native function CompressedTexture_bc7Level(level:i64,data:i64,bytes:i64,width:i64,height:i64,format:i64) i64 {
  if(format!=36492) { return 0-2; }
  if(!loading_span(level,CompressedMip.size) || data<0 || bytes<0 || data>6291456-bytes ||
     !file_disjoint(level,CompressedMip.size,data,bytes)) { return 0-1; }
  if(width<1 || width>16384 || height<1 || height>16384 ||
     bytes!=((width+3)/4)*((height+3)/4)*16) { return 0-3; }
  let a=ux_u32_put(level+CompressedMip.data,data);
  let b=ux_u32_put(level+CompressedMip.bytes,bytes);
  let c=ux_u32_put(level+CompressedMip.width,width);
  let d=ux_u32_put(level+CompressedMip.height,height);
  let e=ux_u32_put(level+CompressedMip.format,format);
  return level;
}

// The RGBA8 result retains encoded RGB bytes. Color-space transfer belongs to the caller.
native function CompressedTexture_decodeBC7(level:i64,dst:i64,capacity:i64) i64 {
  if(!loading_span(level,CompressedMip.size)) { return 0-1; }
  if(ux_u32(level+CompressedMip.format)!=36492) { return 0-2; }
  let width=ux_u32(level+CompressedMip.width);
  let height=ux_u32(level+CompressedMip.height);
  let data=ux_u32(level+CompressedMip.data);
  let size=ux_u32(level+CompressedMip.bytes);
  if(width<1 || width>16384 || height<1 || height>16384) { return 0-3; }
  let columns=(width+3)/4;
  let rows=(height+3)/4;
  let output=width*height*4;
  if(size!=columns*rows*16 || data>6291456-size) { return 0-3; }
  if(capacity<output || dst<0 || dst>6291456-output ||
     !file_disjoint(dst,output,level,CompressedMip.size) ||
     !file_disjoint(dst,output,data,size) ||
     !file_disjoint(data,size,level,CompressedMip.size)) { return 0-1; }
  let block=data;
  while(block<data+size) {
    if(ux_u8(block)%128!=64) { return 0-4; }
    block=block+16;
  }
  let by=0;
  while(by<rows) {
    let bx=0;
    while(bx<columns) {
      block=data+(by*columns+bx)*16;
      let first=bc7_endpoint(block,0,bc7_bits(block,63,2));
      let second=bc7_endpoint(block,1,bc7_bits(block,64,2));
      let y=0;
      while(y<4 && by*4+y<height) {
        let x=0;
        while(x<4 && bx*4+x<width) {
          let texel=y*4+x;
          let index=0;
          if(texel==0) { index=bc7_bits(block,65,8); }
          else { index=bc7_bits(block,64+texel*4,16); }
          let weight=(64*index+7)/15;
          let r=bc7_interp(first%256,second%256,weight);
          let g=bc7_interp(first/256%256,second/256%256,weight);
          let b=bc7_interp(first/65536%256,second/65536%256,weight);
          let a=bc7_interp(first/16777216,second/16777216,weight);
          let pixel=dst+((by*4+y)*width+bx*4+x)*4;
          let put=ux_u32_put(pixel,r+256*g+65536*b+16777216*a);
          x=x+1;
        }
        y=y+1;
      }
      bx=bx+1;
    }
    by=by+1;
  }
  return output;
}
