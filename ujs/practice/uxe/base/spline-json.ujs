// Caller-owned points are consecutive f64 Vector2 or Vector3 records.
struct SplineJson {
  points: u32;
  count: u32;
  capacity: u32;
  divisions: u32;
  closed: u32;
  kind: u32;
  tension: f64;
}

native function spline_json_key(work:i64,field:i64) i64 {
  let bytes=[116,121,112,101,0,97,114,99,76,101,110,103,116,104,68,105,118,105,115,105,111,110,115,0,112,111,105,110,116,115,0,99,108,111,115,101,100,0,99,117,114,118,101,84,121,112,101,0,116,101,110,115,105,111,110,0];
  let offsets=[0,5,24,31,38,48];
  let index=offsets[field];
  let n=0;
  while(bytes[index+n]!=0) {
    let saved=ux_u8_put(work+n,bytes[index+n]);
    n=n+1;
  }
  return n;
}

native function spline_json_label(work:i64,code:i64) i64 {
  let bytes=[83,112,108,105,110,101,67,117,114,118,101,0,67,97,116,109,117,108,108,82,111,109,67,117,114,118,101,51,0,99,97,116,109,117,108,108,114,111,109,0,99,101,110,116,114,105,112,101,116,97,108,0,99,104,111,114,100,97,108,0];
  let offsets=[0,12,29,40,52];
  let index=offsets[code];
  let n=0;
  while(bytes[index+n]!=0) { let saved=ux_u8_put(work+n,bytes[index+n]); n=n+1; }
  return n;
}

native function spline_json_field(p:i64,end:i64,work:i64,field:i64) i64 {
  let n=spline_json_key(work,field);
  p=json_byte(p,end,44);
  p=json_write_string(p,end,work,n);
  return json_byte(p,end,58);
}

native function spline_json_space(shape:i64,io:i64,end:i64,work:i64,dim:i64) i64 {
  if(!helper_buffer_span(shape,SplineJson.size,8) || end<=io ||
     !helper_buffer_span(io,end-io,1) || !helper_buffer_span(work,1152,8)) { return 0; }
  let points=ux_u32(shape+SplineJson.points);
  let count=ux_u32(shape+SplineJson.capacity);
  let bytes=count*dim*8;
  if(count<2 || count>65535 || !helper_buffer_span(points,bytes,8)) { return 0; }
  let addresses=[shape,io,work,points];
  let sizes=[SplineJson.size,end-io,1152,bytes];
  let i=0;
  while(i<4) {
    let j=0;
    while(j<i) {
      if(!helper_buffer_disjoint(addresses[i],sizes[i],addresses[j],sizes[j])) { return 0; }
      j=j+1;
    }
    i=i+1;
  }
  return 1;
}

native function spline_json_write(shape:i64,dst:i64,end:i64,work:i64,dim:i64) i64 {
  if(!spline_json_space(shape,dst,end,work,dim)) { return 0-1; }
  let n=ux_u32(shape+SplineJson.count);
  let divisions=ux_u32(shape+SplineJson.divisions);
  let kind=ux_u32(shape+SplineJson.kind);
  let closed=ux_u32(shape+SplineJson.closed);
  let tension=ux_f64(shape+SplineJson.tension);
  if(n<2 || n>ux_u32(shape+SplineJson.capacity) || divisions<1 || divisions>65535 ||
    (dim==3 && (kind>2 || closed>1 || !(tension-tension==0.0)))) { return 0-1; }
  let header=[123,34,109,101,116,97,100,97,116,97,34,58,123,34,118,101,114,115,105,111,110,34,58,52,46,54,44,34,116,121,112,101,34,58,34,67,117,114,118,101,34,44,34,103,101,110,101,114,97,116,111,114,34,58,34,67,117,114,118,101,46,116,111,74,83,79,78,34,125];
  let p=dst;
  let i=0;
  while(i<69) { p=json_byte(p,end,header[i]); i=i+1; }
  p=spline_json_field(p,end,work,1);
  p=json_write_f64(p,end,0.0+divisions,work+32);
  p=spline_json_field(p,end,work,0);
  let typeBytes=spline_json_label(work,dim-2);
  p=json_write_string(p,end,work,typeBytes);
  p=spline_json_field(p,end,work,2);
  p=json_byte(p,end,91);
  let points=ux_u32(shape+SplineJson.points);
  i=0;
  while(i<n && p>=0) {
    if(i!=0) { p=json_byte(p,end,44); }
    p=json_byte(p,end,91);
    let j=0;
    while(j<dim) {
      if(j!=0) { p=json_byte(p,end,44); }
      p=json_write_f64(p,end,ux_f64(points+8*(i*dim+j)),work+32);
      j=j+1;
    }
    p=json_byte(p,end,93);
    i=i+1;
  }
  p=json_byte(p,end,93);
  if(dim==3) {
    p=spline_json_field(p,end,work,3);
    let flag=[102,97,108,115,101];
    let length=5;
    if(closed) { flag=[116,114,117,101,0]; length=4; }
    i=0;
    while(i<length) { p=json_byte(p,end,flag[i]); i=i+1; }
    p=spline_json_field(p,end,work,4);
    let name=spline_json_label(work,2+kind);
    p=json_write_string(p,end,work,name);
    p=spline_json_field(p,end,work,5);
    p=json_write_f64(p,end,tension,work+32);
  }
  return json_byte(p,end,125);
}

native function spline_json_find(at:i64,end:i64,work:i64,field:i64) i64 {
  let n=spline_json_key(work,field);
  return json_find_key(at,end,work,n);
}

native function spline_json_matches(token:i64,end:i64,work:i64,code:i64) i64 {
  if(token<0) { return 0; }
  let expected=spline_json_label(work,code);
  let n=Json_decodeString(token,end,work+32,24);
  if(n!=expected) { return 0; }
  let i=0;
  while(i<n) {
    if(ux_u8(work+i)!=ux_u8(work+32+i)) { return 0; }
    i=i+1;
  }
  return 1;
}

native function spline_json_points(token:i64,end:i64,points:i64,capacity:i64,dim:i64,apply:i64) i64 {
  if(token<0 || ux_u8(token)!=91) { return 0-1; }
  let p=json_space(token+1,end);
  let count=0;
  while(p>=0 && p<end && ux_u8(p)!=93) {
    if(count>=capacity || ux_u8(p)!=91) { return 0-1; }
    p=json_space(p+1,end);
    let j=0;
    while(j<dim) {
      if(p<0 || p>=end) { return 0-1; }
      let value=json_read_number(p,end);
      if(!(value-value==0.0)) { return 0-1; }
      p=json_space(json_scalar_end(p,end),end);
      if(p<0 || p>=end || ux_u8(p)!=44+49*(j+1==dim)) { return 0-1; }
      if(apply) { let saved=ux_f64_put(points+8*(count*dim+j),value); }
      p=json_space(p+1,end);
      j=j+1;
    }
    count=count+1;
    if(p<0 || p>=end) { return 0-1; }
    if(ux_u8(p)==93) { return count; }
    if(ux_u8(p)!=44) { return 0-1; }
    p=json_space(p+1,end);
    if(p<0 || p>=end || ux_u8(p)==93) { return 0-1; }
  }
  return 0-1;
}

native function spline_json_read(shape:i64,input:i64,end:i64,work:i64,dim:i64) i64 {
  if(!spline_json_space(shape,input,end,work,dim)) { return 0-1; }
  let root=json_space(input,end);
  let stop=json_value_end(root,end);
  if(stop<0 || json_space(stop,end)!=end) { return 0-1; }
  let type=spline_json_find(root,stop,work,0);
  if(!spline_json_matches(type,stop,work,dim-2)) { return 0-1; }
  let div=spline_json_find(root,stop,work,1);
  let value=json_read_number(div,stop);
  if(!(value>=1.0 && value<=65535.0)) { return 0-1; }
  let divisions=f64_floor_i64(value);
  if(value!=0.0+divisions) { return 0-1; }
  let closed=0;
  let mode=0;
  let tension=0.5;
  if(dim==3) {
    let flag=spline_json_find(root,stop,work,3);
    let tail=json_scalar_end(flag,stop);
    if(flag<0 || tail<0) { return 0-1; }
    if(tail-flag==4 && ux_u8(flag)==116) { closed=1; }
    else if(tail-flag!=5 || ux_u8(flag)!=102) { return 0-1; }
    let name=spline_json_find(root,stop,work,4);
    while(mode<3 && !spline_json_matches(name,stop,work,2+mode)) { mode=mode+1; }
    if(mode==3) { return 0-1; }
    let field=spline_json_find(root,stop,work,5);
    tension=json_read_number(field,stop);
    if(!(tension-tension==0.0)) { return 0-1; }
  }
  let token=spline_json_find(root,stop,work,2);
  let points=ux_u32(shape+SplineJson.points);
  let capacity=ux_u32(shape+SplineJson.capacity);
  let count=spline_json_points(token,stop,points,capacity,dim,0);
  if(count<2) { return 0-1; }
  let read=spline_json_points(token,stop,points,capacity,dim,1);
  let n=ux_u32_put(shape+SplineJson.count,read);
  let d=ux_u32_put(shape+SplineJson.divisions,divisions);
  let f=ux_u32_put(shape+SplineJson.closed,closed);
  let k=ux_u32_put(shape+SplineJson.kind,mode);
  let t=ux_f64_put(shape+SplineJson.tension,tension);
  return shape;
}

native function SplineCurve_toJSON(shape:i64,dst:i64,end:i64,scratch:i64) i64 {
  return spline_json_write(shape,dst,end,scratch,2);
}
native function SplineCurve_fromJSON(shape:i64,input:i64,end:i64,scratch:i64) i64 {
  return spline_json_read(shape,input,end,scratch,2);
}
native function CatmullRomCurve3_toJSON(shape:i64,dst:i64,end:i64,scratch:i64) i64 {
  return spline_json_write(shape,dst,end,scratch,3);
}
native function CatmullRomCurve3_fromJSON(shape:i64,input:i64,end:i64,scratch:i64) i64 {
  return spline_json_read(shape,input,end,scratch,3);
}

native function spline_curve_length(shape:i64,sample:i64,dim:i64) f64 {
  if(!helper_buffer_span(shape,SplineJson.size,8) || !helper_buffer_span(sample,24,8) ||
     !helper_buffer_disjoint(shape,SplineJson.size,sample,24)) { return 0.0-1.0; }
  let points=ux_u32(shape+SplineJson.points);
  let count=ux_u32(shape+SplineJson.count);
  let divisions=ux_u32(shape+SplineJson.divisions);
  if(count<2 || count>65535 || divisions<1 || divisions>65535 ||
     !helper_buffer_span(points,count*dim*8,8) ||
     !helper_buffer_disjoint(points,count*dim*8,sample,24)) { return 0.0-1.0; }
  let closed=ux_u32(shape+SplineJson.closed);
  let kind=ux_u32(shape+SplineJson.kind);
  let tension=ux_f64(shape+SplineJson.tension);
  let x=ux_f64(points);
  let y=ux_f64(points+8);
  let z=0.0;
  if(dim==3) { z=ux_f64(points+16); }
  let length=0.0;
  let i=1;
  while(i<=divisions) {
    let t=(0.0+i)/(0.0+divisions);
    let next=0;
    if(dim==2) { next=SplineCurve_getPoint(sample,points,count,t); }
    else { next=CatmullRomCurve3_getPoint(sample,points,count,t,closed,kind,tension); }
    if(next<0) { return 0.0-1.0; }
    let dx=ux_f64(sample)-x;
    let dy=ux_f64(sample+8)-y;
    let dz=0.0;
    if(dim==3) { dz=ux_f64(sample+16)-z; z=ux_f64(sample+16); }
    length=length+f64_sqrt(dx*dx+dy*dy+dz*dz);
    x=ux_f64(sample);
    y=ux_f64(sample+8);
    i=i+1;
  }
  return length;
}

native function SplineCurve_getLength(shape:i64,sample:i64) f64 {
  return spline_curve_length(shape,sample,2);
}
native function CatmullRomCurve3_getLength(shape:i64,sample:i64) f64 {
  return spline_curve_length(shape,sample,3);
}
