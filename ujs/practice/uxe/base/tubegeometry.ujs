// Each input frame has center, unit normal and unit binormal as nine f64 values.
native function TubeGeometry_generate(mesh:i64,frames:i64,tubular:i64,radial:i64,
                                       radius:f64,closed:i64) i64 {
  if(frames<0 || frames>6291456 || frames%8!=0 || tubular<1 || radial<1 ||
     tubular+1>(6291456-frames)/72 || radial>262144) { return 0-1; }
  let stride=radial+1;
  let points=(tubular+1)*stride;
  let cells=tubular*radial*6;
  if(!GeometryBuffers_fits(mesh,points,cells)) { return 0-1; }
  let vertex=ux_u32(mesh+GeometryBuffers.vertices);
  let index=ux_u32(mesh+GeometryBuffers.indices);
  let row=0;
  while(row<=tubular) {
    let section=row;
    if(closed!=0 && row==tubular) { section=0; }
    let basis=frames+section*72;
    let col=0;
    while(col<=radial) {
      let v=col*1.0/radial;
      let angle=v*6.283185307179586;
      let s=ux_math_sin(angle);
      let c=0.0-ux_math_cos(angle);
      let nx=c*ux_f64(basis+24)+s*ux_f64(basis+48);
      let ny=c*ux_f64(basis+32)+s*ux_f64(basis+56);
      let nz=c*ux_f64(basis+40)+s*ux_f64(basis+64);
      let length=f64_sqrt(nx*nx+ny*ny+nz*nz);
      if(length!=0.0) { nx=nx/length; ny=ny/length; nz=nz/length; }
      vertex=GeometryBuffers_vertex(vertex,ux_f64(basis)+radius*nx,ux_f64(basis+8)+radius*ny,
        ux_f64(basis+16)+radius*nz,nx,ny,nz,row*1.0/tubular,v);
      if(row<tubular && col<radial) {
        let first=row*stride+col;
        index=geometry_quad(index,first,first+stride,first+stride+1,first+1);
      }
      col=col+1;
    }
    row=row+1;
  }
  return GeometryBuffers_commit(mesh,points,cells);
}
