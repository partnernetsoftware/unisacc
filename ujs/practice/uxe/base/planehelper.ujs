struct PlaneHelper {
  outline: u32;
  fill: u32;
  outlineCount: u32;
  fillCount: u32;
  color: u32;
  active: u32;
  sizeValue: f64;
}

native function plane_helper_span(at:i64,bytes:i64,align:i64) i64 {
  return at>=0 && at%align==0 && at<=6291456-bytes;
}

native function plane_helper_disjoint(a:i64,n:i64,b:i64,m:i64) i64 {
  return a+n<=b || b+m<=a;
}

native function PlaneHelper_init(helper:i64,outline:i64,fill:i64,size:f64,hex:i64) i64 {
  if(!plane_helper_span(helper,PlaneHelper.size,8) || !plane_helper_span(outline,96,4) ||
     !plane_helper_span(fill,72,4) || !plane_helper_disjoint(helper,PlaneHelper.size,outline,96) ||
     !plane_helper_disjoint(helper,PlaneHelper.size,fill,72) || !plane_helper_disjoint(outline,96,fill,72) ||
     size-size!=0.0 || hex<0 || hex>16777215) { return 0-1; }
  let outlineData=helper_plane_outline(outline,1.0);
  let fillData=helper_plane_fill(fill,1.0);
  let o=ux_u32_put(helper+PlaneHelper.outline,outline);
  let f=ux_u32_put(helper+PlaneHelper.fill,fill);
  let on=ux_u32_put(helper+PlaneHelper.outlineCount,8);
  let fn=ux_u32_put(helper+PlaneHelper.fillCount,6);
  let rgb=ux_u32_put(helper+PlaneHelper.color,hex);
  let s=ux_f64_put(helper+PlaneHelper.sizeValue,size);
  let active=ux_u32_put(helper+PlaneHelper.active,1);
  return helper;
}

// Produce the column-major unparented world matrix using the default up vector.
native function PlaneHelper_updateMatrixWorld(helper:i64,matrix:i64,x:f64,y:f64,z:f64,constant:f64) i64 {
  if(!plane_helper_span(helper,PlaneHelper.size,8) || ux_u32(helper+PlaneHelper.active)!=1 ||
     !plane_helper_span(matrix,128,8) || !plane_helper_disjoint(helper,PlaneHelper.size,matrix,128) ||
     constant-constant!=0.0) { return 0-1; }
  let outline=ux_u32(helper+PlaneHelper.outline);
  let fill=ux_u32(helper+PlaneHelper.fill);
  if(!plane_helper_span(outline,96,4) || !plane_helper_span(fill,72,4) ||
     !plane_helper_disjoint(outline,96,matrix,128) ||
     !plane_helper_disjoint(fill,72,matrix,128)) { return 0-1; }
  let length=f64_sqrt(x*x+y*y+z*z);
  if(length-length!=0.0) { return 0-1; }
  if(length==0.0) { x=0.0; y=0.0; z=1.0; length=1.0; }
  x=x/length;
  y=y/length;
  z=z/length;
  let horizontal=f64_sqrt(x*x+z*z);
  if(horizontal==0.0) {
    z=0.0001;
    length=f64_sqrt(y*y+z*z);
    y=y/length;
    z=z/length;
    horizontal=z;
  }
  let rx=z/horizontal;
  let rz=0.0-x/horizontal;
  let half=ux_f64(helper+PlaneHelper.sizeValue)*0.5;
  if(half-half!=0.0) { return 0-1; }
  let a=ux_f64_put(matrix,rx*half);
  let b=ux_f64_put(matrix+8,0.0);
  let c=ux_f64_put(matrix+16,rz*half);
  let d=ux_f64_put(matrix+24,0.0);
  let e=ux_f64_put(matrix+32,y*rz*half);
  let f=ux_f64_put(matrix+40,(z*rx-x*rz)*half);
  let g=ux_f64_put(matrix+48,0.0-y*rx*half);
  let h=ux_f64_put(matrix+56,0.0);
  let i=ux_f64_put(matrix+64,x);
  let j=ux_f64_put(matrix+72,y);
  let k=ux_f64_put(matrix+80,z);
  let l=ux_f64_put(matrix+88,0.0);
  let m=ux_f64_put(matrix+96,0.0-x*constant);
  let n=ux_f64_put(matrix+104,0.0-y*constant);
  let o=ux_f64_put(matrix+112,0.0-z*constant);
  let p=ux_f64_put(matrix+120,1.0);
  return helper;
}

native function PlaneHelper_dispose(helper:i64) i64 {
  if(!plane_helper_span(helper,PlaneHelper.size,8) || ux_u32(helper+PlaneHelper.active)!=1) { return 0-1; }
  let gone=ux_u32_put(helper+PlaneHelper.active,0);
  return 0;
}
