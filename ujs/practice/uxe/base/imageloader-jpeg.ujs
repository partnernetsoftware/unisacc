// Decode a completed response. Keep the previous descriptor on any failure.
native function ImageLoader_decodeJpeg(file:i64,image:i64,rgba:i64,capacity:i64,scratch:i64,space:i64) i64 {
  if(!image_file_ready(file,image,rgba,capacity,scratch,space)) { return 0-1; }
  let src=ux_u32(file+FileLoader.bytes);
  let bytes=ux_u32(file+FileLoader.length);
  if(scratch<0 || space<JpegHeader.size || scratch>6291456-space ||
     rgba<0 || capacity<0 || rgba>6291456-capacity ||
     jpeg_overlap(scratch,space,rgba,capacity)) { return 0-1; }
  let header=JpegHeader_probe(src,bytes,scratch);
  if(header<0) { return header; }
  let mode=ux_u32(header+JpegHeader.components);
  let progressive=ux_u32(header+JpegHeader.frame)==194;
  let result=0-4;
  if(mode==1) {
    if(progressive) { result=JpegDecode_progressiveGray(src,bytes,rgba,capacity,scratch,space); }
    else { result=JpegDecode_gray(src,bytes,rgba,capacity,scratch,space); }
  } else if(mode==3) {
    if(progressive) { result=JpegDecode_progressiveColor(src,bytes,rgba,capacity,scratch,space); }
    else { result=JpegDecode_color(src,bytes,rgba,capacity,scratch,space); }
  }
  if(result<0) { return result; }
  return image_file_publish(image,rgba,ux_u32(scratch+JpegHeader.width),ux_u32(scratch+JpegHeader.height));
}
