// ABI v1: all addresses are logical addresses in the base memory.
// Operations 0/1 construct an explicit/canonical default manager from a
// caller-reserved state and handler table. Subsequent calls use the manager
// address and opaque host handles; no product memory pointer is dereferenced.
if(op==0) { return LoadingManager_new(manager,x,y,0,0,0); }
if(op==1) { return LoadingManager_defaultClass(manager,x,y); }
if(op==2) { return LoadingManager_setCallback(manager,x,y); }
if(op==3) { return LoadingManager_setURLModifier(manager,x); }
if(op==4) { return LoadingManager_resolveURL(manager,x); }
if(op==5) { return LoadingManager_addHandler(manager,x,y,z); }
if(op==6) { return LoadingManager_removeHandler(manager,x); }
if(op==7) { return LoadingManager_getHandler(manager,x); }
if(op==8) { return LoadingManager_itemStart(manager,x); }
if(op==9) { return LoadingManager_itemError(manager,x); }
if(op==10) { return LoadingManager_itemEnd(manager,x); }
return 0-1;
