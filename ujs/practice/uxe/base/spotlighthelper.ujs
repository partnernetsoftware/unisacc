struct SpotLightHelper {
  positions: u32;
  count: u32;
  matrix: u32;
  active: u32;
  lookX: f64;
  lookY: f64;
  lookZ: f64;
  targetDistance: f64;
  width: f64;
  length: f64;
  red: f64;
  green: f64;
  blue: f64;
}

native function spot_light_helper_update(helper:i64,light:i64,target:i64,distance:f64,angle:f64,rgb:i64) i64 {
  if(!light_helper_rgb_valid(rgb) || !light_helper_disjoint(helper,SpotLightHelper.size,rgb,24) ||
     !light_helper_disjoint(helper,SpotLightHelper.size,light,128) ||
     !light_helper_disjoint(helper,SpotLightHelper.size,target,128) ||
     distance-distance!=0.0 || angle-angle!=0.0) { return 0-1; }
  let length=distance;
  if(length==0.0) { length=1000.0; }
  let width=length*ux_math_tan(angle);
  if(width-width!=0.0) { return 0-1; }
  let look=light_helper_look(helper+SpotLightHelper.lookX,light,target);
  if(look<0) { return 0-1; }
  let w=ux_f64_put(helper+SpotLightHelper.width,width);
  let l=ux_f64_put(helper+SpotLightHelper.length,length);
  let c=light_helper_rgb_copy(helper+SpotLightHelper.red,rgb);
  return helper;
}

native function SpotLightHelper_update(helper:i64,target:i64,distance:f64,angle:f64,lightRGB:i64,overrideRGB:i64) i64 {
  if(!light_helper_span(helper,SpotLightHelper.size,8) ||
     ux_u32(helper+SpotLightHelper.active)!=1) { return 0-1; }
  let rgb=overrideRGB;
  if(rgb==0-1) { rgb=lightRGB; }
  return spot_light_helper_update(helper,ux_u32(helper+SpotLightHelper.matrix),target,distance,angle,rgb);
}

native function SpotLightHelper_init(helper:i64,positions:i64,light:i64,target:i64,distance:f64,angle:f64,
    lightRGB:i64,overrideRGB:i64) i64 {
  let rgb=overrideRGB;
  if(rgb==0-1) { rgb=lightRGB; }
  if(!light_helper_span(helper,SpotLightHelper.size,8) || !light_helper_span(positions,888,4) ||
     !light_helper_span(light,128,8) || !light_helper_span(target,128,8) || !light_helper_rgb_valid(rgb) ||
     !light_helper_disjoint(helper,SpotLightHelper.size,positions,888) ||
     !light_helper_disjoint(positions,888,light,128) || !light_helper_disjoint(positions,888,target,128) ||
     !light_helper_disjoint(positions,888,rgb,24)) { return 0-1; }
  let update=spot_light_helper_update(helper,light,target,distance,angle,rgb);
  if(update<0) { return 0-1; }
  let spokes=helper_spot_spokes(positions,1.0);
  let i=0;
  while(i<64) {
    let step=i/2+i%2;
    let phi=step*6.283185307179586/32.0;
    let dst=positions+120+i*12;
    let x=ux_f32_put(dst,ux_math_cos(phi));
    let y=ux_f32_put(dst+4,ux_math_sin(phi));
    let z=ux_f32_put(dst+8,1.0);
    i=i+1;
  }
  let p=ux_u32_put(helper+SpotLightHelper.positions,positions);
  let n=ux_u32_put(helper+SpotLightHelper.count,74);
  let m=ux_u32_put(helper+SpotLightHelper.matrix,light);
  let a=ux_u32_put(helper+SpotLightHelper.active,1);
  return helper;
}

native function SpotLightHelper_dispose(helper:i64) i64 {
  if(!light_helper_span(helper,SpotLightHelper.size,8) ||
     ux_u32(helper+SpotLightHelper.active)!=1) { return 0-1; }
  let a=ux_u32_put(helper+SpotLightHelper.active,0);
  return 0;
}
