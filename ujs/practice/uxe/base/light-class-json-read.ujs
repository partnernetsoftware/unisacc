native function light_wire_find(src:i64,end:i64,key:i64,scratch:i64) i64 {
  let name_end=light_wire_name(scratch,scratch+24,key);
  if(name_end<0) { return 0-1; }
  return json_find_key(src,end,scratch,name_end-scratch);
}

native function light_wire_match(src:i64,end:i64,token:i64,scratch:i64) i64 {
  let stop=json_scan_string(src,end);
  let name_end=light_wire_name(scratch,scratch+24,token);
  if(stop<0 || name_end<0 || stop-src!=name_end-scratch+2) { return 0; }
  let i=0;
  while(scratch+i<name_end) {
    if(ux_u8(src+1+i)!=ux_u8(scratch+i)) { return 0; }
    i=i+1;
  }
  return 1;
}

// For ordinary decimals, divide by an exact power of ten. Multiplying by
// successive rounded powers of 0.1 changes values such as 0.125 by one ULP.
native function light_wire_decimal(src:i64,end:i64) f64 {
  let stop=json_scalar_end(src,end);
  if(stop<0) { return 0.0/0.0; }
  let p=src;
  let sign=1.0;
  if(ux_u8(p)==45) { p=p+1; sign=0.0-1.0; }
  let value=0;
  let digits=0;
  let scale=0;
  let decimal=0;
  while(p<stop) {
    let c=ux_u8(p);
    if(c==46) { decimal=1; }
    else {
      if(c<48 || c>57 || digits==15 || scale==22) { return json_read_number(src,end); }
      digits=digits+1;
      value=value*10+c-48;
      scale=scale+decimal;
    }
    p=p+1;
  }
  let divisor=1.0;
  while(scale>0) { divisor=divisor*10.0; scale=scale-1; }
  return (0.0+value)*sign/divisor;
}

native function light_wire_read_array(dst:i64,src:i64,end:i64,count:i64) i64 {
  if(src<0 || src>=end || ux_u8(src)!=91) { return 0-1; }
  let p=json_space(src+1,end);
  let i=0;
  while(i<count && p>=0 && p<end) {
    let value=light_wire_decimal(p,end);
    if(value-value!=0.0) { return 0-1; }
    let stored=ux_f64_put(dst+i*8,value);
    p=json_space(json_scalar_end(p,end),end);
    i=i+1;
    if(i<count) {
      if(p<0 || p>=end || ux_u8(p)!=44) { return 0-1; }
      p=json_space(p+1,end);
    }
  }
  if(i!=count || p<0 || p>=end || ux_u8(p)!=93) { return 0-1; }
  return p+1;
}

native function light_wire_read_numeric(stage:i64,src:i64,end:i64,key:i64) i64 {
  let number=light_wire_decimal(src,end);
  if(number-number!=0.0) { return 0-1; }
  let off=light_wire_metadata(key,2);
  if(off<0) { return 0-1; }
  if(light_wire_metadata(key,1)==2) {
    let value=ux_f64_put(stage+off,number);
  } else {
    let normalized=number;
    let max=16777215.0;
    if(key==LightWireRoot.layers) {
      if(number<0.0 && number>=0.0-2147483648.0) { normalized=number+4294967296.0; }
      max=4294967295.0;
    }
    if(normalized<0.0 || normalized>max || 0.0+f64_floor_i64(normalized)!=normalized) { return 0-1; }
    let value=ux_u32_put(stage+off,f64_floor_i64(normalized));
  }
  return stage;
}

native function light_wire_read_shadow(stage:i64,src:i64,end:i64,kind:i64,scratch:i64) i64 {
  let base=LightWireRoot.size;
  let camera=light_wire_find(src,end,base+LightWireShadow.camera,scratch);
  if(camera==0-1) { return camera; }
  if(camera>=0) {
    let type=light_wire_find(camera,end,LightWireRoot.type,scratch);
    let expected=base+LightWireShadow.PerspectiveCamera;
    if(kind==4) { expected=base+LightWireShadow.OrthographicCamera; }
    if(type>=0 && light_wire_match(type,end,expected,scratch)==0 || type==0-1) { return 0-1; }
    let key=base+LightWireShadow.fov;
    while(key<=base+LightWireShadow.far) {
      if(light_wire_mask_has(kind,key)!=0) {
        let data=light_wire_find(camera,end,key,scratch);
        if(data==0-1 || data>=0 && light_wire_read_numeric(stage,data,end,key)<0) { return 0-1; }
      }
      key=key+1;
    }
  }
  let key=base+LightWireShadow.bias;
  while(key<=base+LightWireShadow.radius) {
    let data=light_wire_find(src,end,key,scratch);
    if(data==0-1 || data>=0 && light_wire_read_numeric(stage,data,end,key)<0) { return 0-1; }
    key=key+1;
  }
  let map=light_wire_find(src,end,base+LightWireShadow.mapSize,scratch);
  if(map==0-1 || map>=0 && light_wire_read_array(stage+LightJson.shadow.mapWidth,map,end,2)<0) { return 0-1; }
  return stage;
}

native function light_wire_defaults(stage:i64,kind:i64) i64 {
  let i=0;
  while(i<LightJson.size) { let clear=ux_u32_put(stage+i,0); i=i+4; }
  let wire_kind=kind;
  if(kind==8) { wire_kind=1; }
  let type=ux_u32_put(stage+LightJson.kind,wire_kind);
  let color=ux_u32_put(stage+LightJson.color,16777215);
  let visible=ux_u32_put(stage+LightJson.visible,1);
  let layers=ux_u32_put(stage+LightJson.layers,1);
  let intensity=ux_f64_put(stage+LightJson.intensity,1.0);
  if(kind==3) {
    let flag=ux_u8_put(stage+LightJson.fields.groundColor,1);
    let ground=ux_u32_put(stage+LightJson.groundColor,16777215);
  }
  if(kind==4 || kind==5 || kind==6) {
    let flag=ux_u8_put(stage+LightJson.fields.shadow,1);
    let fov=0.0+light_profile(kind,2);
    let field=ux_f64_put(stage+LightJson.shadow.cameraFov,fov);
    let near=ux_f64_put(stage+LightJson.shadow.cameraNear,0.5);
    let far=ux_f64_put(stage+LightJson.shadow.cameraFar,500.0);
    let radius=ux_f64_put(stage+LightJson.shadow.radius,1.0);
    let width=ux_f64_put(stage+LightJson.shadow.mapWidth,512.0);
    let height=ux_f64_put(stage+LightJson.shadow.mapHeight,512.0);
  }
  if(kind==5 || kind==6) {
    let pf=ux_u8_put(stage+LightJson.fields.distance,1);
    let pe=ux_u8_put(stage+LightJson.fields.decay,1);
    let decay=ux_f64_put(stage+LightJson.decay,2.0);
  }
  if(kind==6) {
    let pf=ux_u8_put(stage+LightJson.fields.angle,1);
    let pp=ux_u8_put(stage+LightJson.fields.penumbra,1);
    let angle=ux_f64_put(stage+LightJson.angle,1.0471975511965976);
  }
  if(kind==7) {
    let flag=ux_u8_put(stage+LightJson.fields.dimensions,1);
    let width=ux_f64_put(stage+LightJson.width,10.0);
    let height=ux_f64_put(stage+LightJson.height,10.0);
  }
  if(kind==8) { let flag=ux_u8_put(stage+LightJson.fields.sh,1); }
  return stage;
}

// Accept either a bare r160 light object or the root envelope. Stage the
// complete result before publishing it. Scratch needs LightJson.size+24 bytes.
native function LightJson_read(out:i64,src:i64,end:i64,stage:i64) i64 {
  let bytes=LightJson.size+24;
  if(out<0 || out>6291456-LightJson.size || out%8!=0 || src<0 || end<=src || end>6291456 ||
      stage<0 || stage>6291456-bytes || stage%8!=0 ||
      light_wire_overlap(out,LightJson.size,stage,bytes)!=0 ||
      light_wire_overlap(src,end-src,stage,bytes)!=0 || light_wire_overlap(src,end-src,out,LightJson.size)!=0) { return 0-1; }
  let last=json_value_end(src,end);
  if(last<0 || json_space(last,end)!=end) { return 0-1; }
  let scratch=stage+LightJson.size;
  let body=light_wire_find(src,end,LightWireRoot.object,scratch);
  if(body==0-2) { body=src; }
  if(body<0) { return 0-1; }
  let id=light_wire_find(body,end,LightWireRoot.type,scratch);
  if(id<0) { return 0-1; }
  let kind=1;
  let found=0;
  let base=LightWireRoot.size+LightWireShadow.size;
  while(kind<=8 && found==0) {
    found=light_wire_match(id,end,base+kind-1,scratch);
    if(found==0) { kind=kind+1; }
  }
  if(found==0) { return 0-1; }
  let sh=light_wire_find(body,end,LightWireRoot.sh,scratch);
  if(kind==1 && sh>=0) { kind=8; }
  if(kind==8 && sh<0) { return 0-1; }
  let init=light_wire_defaults(stage,kind);
  let key=LightWireRoot.color;
  while(key<LightWireRoot.object) {
    if(light_wire_mask_has(kind,key)!=0) {
      let data=light_wire_find(body,end,key,scratch);
      if(data==0-1) { return 0-1; }
      if(data>=0) {
        let format=light_wire_metadata(key,1);
        let off=light_wire_metadata(key,2);
        if(format==1 || format==2) {
          if(light_wire_read_numeric(stage,data,end,key)<0) { return 0-1; }
        } else if(format==3) {
          let byte=ux_u8(data);
          if(byte!=116 && byte!=102) { return 0-1; }
          let written=ux_u32_put(stage+off,byte==116);
        } else if(format==4) {
          if(light_wire_read_array(stage+off,data,end,27)<0) { return 0-1; }
        } else if(format==5) {
          if(light_wire_read_shadow(stage,data,end,kind,scratch)<0) { return 0-1; }
        }
      }
    }
    key=key+1;
  }
  return uxe_copy_record(out,stage,LightJson.size);
}
