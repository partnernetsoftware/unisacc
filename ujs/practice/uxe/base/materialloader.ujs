struct LoadedMaterial {
  kind: u32;
  srgbHex: u32;
  transparent: u32;
  opacity: f64;
  roughness: f64;
  metalness: f64;
}

native function material_kind(text:i64,end:i64) i64 {
  let close=json_scan_string(text,end);
  if(close<0) { return 0-1; }
  let length=close-text-10;
  if(length<5 || ux_u32(close-9)!=1702125901 || ux_u32(close-5)!=1818323314) { return 0-1; }
  if(ux_u32(text+1)==1752393037) {
    if(length==9 && ux_u32(text+5)==1769169218 && ux_u8(text+9)==99) { return 1; } // MeshBasicMaterial
    if(length==12 && ux_u32(text+5)==1851880531 && ux_u32(text+9)==1685217636) { return 2; } // MeshStandardMaterial
    if(length==11 && ux_u32(text+5)==1651335500 && ux_u8(text+9)==101 && ux_u8(text+10)==114 && ux_u8(text+11)==116) { return 3; } // MeshLambertMaterial
    if(length==9 && ux_u32(text+5)==1852794960 && ux_u8(text+9)==103) { return 4; } // MeshPhongMaterial
    if(length==8 && ux_u32(text+5)==1852796756) { return 5; } // MeshToonMaterial
    if(length==10 && ux_u32(text+5)==1836216142 && ux_u8(text+9)==97 && ux_u8(text+10)==108) { return 6; } // MeshNormalMaterial
    if(length==9 && ux_u32(text+5)==1953523012 && ux_u8(text+9)==104) { return 7; } // MeshDepthMaterial
    if(length==12 && ux_u32(text+5)==1953720644 && ux_u32(text+9)==1701015137) { return 8; } // MeshDistanceMaterial
    if(length==10 && ux_u32(text+5)==1668571469 && ux_u8(text+9)==97 && ux_u8(text+10)==112) { return 9; } // MeshMatcapMaterial
    if(length==12 && ux_u32(text+5)==1937336400 && ux_u32(text+9)==1818321769) { return 17; } // MeshPhysicalMaterial
    return 0-1;
  }
  if(length==6 && ux_u32(text+1)==1852403536 && ux_u8(text+5)==116 && ux_u8(text+6)==115) { return 10; } // PointsMaterial
  if(length==9 && ux_u32(text+1)==1701734732 && ux_u32(text+5)==1769169218 && ux_u8(text+9)==99) { return 11; } // LineBasicMaterial
  if(length==10 && ux_u32(text+1)==1701734732 && ux_u32(text+5)==1752392004 && ux_u8(text+9)==101 && ux_u8(text+10)==100) { return 12; } // LineDashedMaterial
  if(length==6 && ux_u32(text+1)==1769107539 && ux_u8(text+5)==116 && ux_u8(text+6)==101) { return 13; } // SpriteMaterial
  if(length==6 && ux_u32(text+1)==1684105299 && ux_u8(text+5)==111 && ux_u8(text+6)==119) { return 14; } // ShadowMaterial
  if(length==6 && ux_u32(text+1)==1684105299 && ux_u8(text+5)==101 && ux_u8(text+6)==114) { return 15; } // ShaderMaterial
  if(length==9 && ux_u32(text+1)==1400332626 && ux_u32(text+5)==1701077352 && ux_u8(text+9)==114) { return 16; } // RawShaderMaterial
  return 0-1;
}

native function MaterialLoader_parse(file:i64,out:i64,key:i64) i64 {
  if(!loading_span(file,FileLoader.size) || ux_u32(file+FileLoader.state)!=2 || !loading_span(out,LoadedMaterial.size) ||
     out%8!=0 || !loading_span(key,12) || !file_disjoint(file,FileLoader.size,key,12) ||
     !file_disjoint(file,FileLoader.size,out,LoadedMaterial.size) || !file_disjoint(out,LoadedMaterial.size,key,12)) { return 0-1; }
  let input=ux_u32(file+FileLoader.bytes);
  let bytes=ux_u32(file+FileLoader.length);
  if(input>6291456-bytes || !file_disjoint(input,bytes,key,12) || !file_disjoint(input,bytes,out,LoadedMaterial.size)) { return 0-1; }
  let end=input+bytes;
  let parsed=json_value_end(input,end);
  if(parsed<0 || json_space(parsed,end)!=end) { return 0-2; }
  let kind=material_kind(LoaderJson_find(input,end,key,1701869940,0,0,4),end);
  if(kind<0) { return 0-3; }
  let color=LoaderJson_number(LoaderJson_find(input,end,key,1869377379,114,0,5),end,16777215.0);
  let alpha=LoaderJson_number(LoaderJson_find(input,end,key,1667330159,7959657,0,7),end,1.0);
  let rough=LoaderJson_number(LoaderJson_find(input,end,key,1735749490,1936027240,115,9),end,1.0);
  let metal=LoaderJson_number(LoaderJson_find(input,end,key,1635018093,1936027244,115,9),end,0.0);
  if(color-color!=0.0 || color<0.0 || color>16777215.0 || alpha-alpha!=0.0 || rough-rough!=0.0 || metal-metal!=0.0) { return 0-3; }
  let hex=f64_floor_i64(color);
  if(color!=0.0+hex) { return 0-3; }
  let flag=LoaderJson_find(input,end,key,1851880052,1918988403,7630437,11);
  let transparent=0;
  if(flag>=0) {
    let first=ux_u8(flag);
    if(first!=102 && first!=116) { return 0-3; }
    transparent=first==116;
  }
  let a=ux_u32_put(out+LoadedMaterial.kind,kind);
  let b=ux_u32_put(out+LoadedMaterial.srgbHex,hex);
  let c=ux_u32_put(out+LoadedMaterial.transparent,transparent);
  let d=ux_f64_put(out+LoadedMaterial.opacity,alpha);
  let e=ux_f64_put(out+LoadedMaterial.roughness,rough);
  let f=ux_f64_put(out+LoadedMaterial.metalness,metal);
  return out;
}
