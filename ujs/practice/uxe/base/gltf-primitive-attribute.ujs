struct GltfPrimitiveAttributeRequest {
  mesh: u32;
  primitive: u32;
  semantic: u32;
  semanticBytes: u32;
}

// Resolve any literal attribute name. Dense descriptors borrow the GLB
// buffer. Sparse descriptors point at the supplied owned target.
native function GltfLoader_primitiveAttribute(glb:i64,query:i64,out:i64,target:i64,capacity:i64,key:i64) i64 {
  if(!loading_span(glb,GlbResource.size) || !loading_span(query,GltfPrimitiveAttributeRequest.size) ||
     !loading_span(out,GltfAccessor.size) || !loading_span(target,capacity) || !loading_span(key,16) ||
     !file_disjoint(glb,GlbResource.size,key,16) || !file_disjoint(glb,GlbResource.size,out,GltfAccessor.size) ||
     !file_disjoint(query,GltfPrimitiveAttributeRequest.size,key,16) ||
     !file_disjoint(query,GltfPrimitiveAttributeRequest.size,out,GltfAccessor.size) ||
     !file_disjoint(query,GltfPrimitiveAttributeRequest.size,target,capacity) ||
     !file_disjoint(out,GltfAccessor.size,key,16) ||
     !file_disjoint(target,capacity,key,16)) { return 0-1; }
  let json=ux_u32(glb+GlbResource.json);
  let bytes=ux_u32(glb+GlbResource.jsonBytes);
  let bin=ux_u32(glb+GlbResource.bin);
  let bin_bytes=ux_u32(glb+GlbResource.binBytes);
  let semantic=ux_u32(query+GltfPrimitiveAttributeRequest.semantic);
  let size=ux_u32(query+GltfPrimitiveAttributeRequest.semanticBytes);
  if(size<1 || size>64 || semantic>6291456-size || !loading_span(json,bytes) || !loading_span(bin,bin_bytes) ||
     !file_disjoint(semantic,size,key,16) || !file_disjoint(semantic,size,out,GltfAccessor.size) ||
     !file_disjoint(semantic,size,target,capacity) ||
     !file_disjoint(json,bytes,key,16) || !file_disjoint(bin,bin_bytes,key,16)) { return 0-1; }
  let end=json+bytes;
  let mesh=LoaderJson_item(LoaderJson_find(json,end,key,1752393069,29541,0,6),end,
      ux_u32(query+GltfPrimitiveAttributeRequest.mesh));
  let prim=LoaderJson_item(LoaderJson_find(mesh,end,key,1835627120,1986622569,29541,10),end,
      ux_u32(query+GltfPrimitiveAttributeRequest.primitive));
  if(prim<0) { return 0-2; }
  let attrs=LoaderJson_find(prim,end,key,1920234593,1953849961,29541,10);
  let field=json_find_key(attrs,end,semantic,size);
  let index=LoaderJson_uint(field,end,0-1);
  if(field==0-2) { return 0-8; }
  if(index<0) { return 0-3; }
  let dense=GltfLoader_accessor(glb,index,out,key);
  if(dense!=0-7) { return dense; }
  return GltfLoader_sparseAccessor(glb,index,out,target,capacity,key);
}
