// Shared keys for perspective, array and orthographic lenses.
native function camera_lens_key(scratch:i64,id:i64) i64 {
  if(id==0) { // fov
    let word0=ux_u32_put(scratch+0,7761766);
    return 3;
  }
  if(id==1) { // aspect
    let word0=ux_u32_put(scratch+0,1701868385);
    let word1=ux_u32_put(scratch+4,29795);
    return 6;
  }
  if(id==2) { // near
    let word0=ux_u32_put(scratch+0,1918985582);
    return 4;
  }
  if(id==3) { // far
    let word0=ux_u32_put(scratch+0,7496038);
    return 3;
  }
  if(id==4) { // zoom
    let word0=ux_u32_put(scratch+0,1836019578);
    return 4;
  }
  if(id==5) { // filmGauge
    let word0=ux_u32_put(scratch+0,1835821414);
    let word1=ux_u32_put(scratch+4,1735745863);
    let word2=ux_u32_put(scratch+8,101);
    return 9;
  }
  if(id==6) { // filmOffset
    let word0=ux_u32_put(scratch+0,1835821414);
    let word1=ux_u32_put(scratch+4,1936090703);
    let word2=ux_u32_put(scratch+8,29797);
    return 10;
  }
  if(id==7) { // focus
    let word0=ux_u32_put(scratch+0,1969450854);
    let word1=ux_u32_put(scratch+4,115);
    return 5;
  }
  if(id==8) { // view
    let word0=ux_u32_put(scratch+0,2003134838);
    return 4;
  }
  if(id==9) { // enabled
    let word0=ux_u32_put(scratch+0,1650552421);
    let word1=ux_u32_put(scratch+4,6579564);
    return 7;
  }
  if(id==10) { // fullWidth
    let word0=ux_u32_put(scratch+0,1819047270);
    let word1=ux_u32_put(scratch+4,1952737623);
    let word2=ux_u32_put(scratch+8,104);
    return 9;
  }
  if(id==11) { // fullHeight
    let word0=ux_u32_put(scratch+0,1819047270);
    let word1=ux_u32_put(scratch+4,1734960456);
    let word2=ux_u32_put(scratch+8,29800);
    return 10;
  }
  if(id==12) { // offsetX
    let word0=ux_u32_put(scratch+0,1936090735);
    let word1=ux_u32_put(scratch+4,5796965);
    return 7;
  }
  if(id==13) { // offsetY
    let word0=ux_u32_put(scratch+0,1936090735);
    let word1=ux_u32_put(scratch+4,5862501);
    return 7;
  }
  if(id==14) { // width
    let word0=ux_u32_put(scratch+0,1952737655);
    let word1=ux_u32_put(scratch+4,104);
    return 5;
  }
  if(id==15) { // height
    let word0=ux_u32_put(scratch+0,1734960488);
    let word1=ux_u32_put(scratch+4,29800);
    return 6;
  }
  if(id==16) { // left
    let lo=ux_u32_put(scratch,1952867692);
    return 4;
  }
  if(id==17) { // right
    let lo=ux_u32_put(scratch,1751607666);
    let hi=ux_u32_put(scratch+4,116);
    return 5;
  }
  if(id==18) { // top
    let lo=ux_u32_put(scratch,7368564);
    return 3;
  }
  if(id==19) { // bottom
    let lo=ux_u32_put(scratch,1953787746);
    let hi=ux_u32_put(scratch+4,28015);
    return 6;
  }
  return 0-1;
}

native function camera_lens_field(p:i64,end:i64,scratch:i64,id:i64) i64 {
  let bytes=camera_lens_key(scratch,id);
  return json_find_key(p,end,scratch,bytes);
}

native function camera_lens_key_write(p:i64,end:i64,scratch:i64,id:i64) i64 {
  let bytes=camera_lens_key(scratch,id);
  let key=json_write_string(p,end,scratch,bytes);
  return json_byte(key,end,58);
}

native function camera_lens_number(p:i64,end:i64,scratch:i64,id:i64,value:f64) i64 {
  let field=camera_lens_key_write(p,end,scratch,id);
  return json_write_f64(field,end,value,scratch);
}

native function camera_lens_view_write(p:i64,end:i64,scratch:i64,fields:i64) i64 {
  p=json_byte(p,end,44);
  p=camera_lens_key_write(p,end,scratch,8);
  p=json_byte(p,end,123);
  p=camera_lens_key_write(p,end,scratch,9);
  p=camera_json_word(p,end,1702195828,4);
  let i=0;
  while(i<6 && p>=0) {
    p=json_byte(p,end,44);
    p=camera_lens_number(p,end,scratch,10+i,ux_f64(fields+i*8));
    i=i+1;
  }
  return json_byte(p,end,125);
}

native function camera_lens_view_read(object:i64,end:i64,key:i64,work:i64) i64 {
  let view=camera_lens_field(object,end,key,8);
  if(view==0-2) { return 0; }
  if(view<0 || ux_u8(view)!=123) { return 0-1; }
  let limit=json_value_end(view,end);
  let flag=camera_lens_field(view,limit,key,9);
  if(flag<0) { return 0-1; }
  let token=ux_u8(flag);
  if(token!=102 && token!=116) { return 0-1; }
  let i=0;
  while(i<6) {
    let at=camera_lens_field(view,limit,key,10+i);
    let value=json_read_number(at,limit);
    if(value-value!=0.0 || ((i<2 || i>=4) && value<=0.0)) { return 0-1; }
    let field=ux_f64_put(work+i*8,value);
    i=i+1;
  }
  return token==116;
}
