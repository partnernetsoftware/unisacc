native function GpuSprite_billboard(out:i64,x:f64,y:f64,z:f64,width:f64,height:f64,angle:f64,rgba:i64) i64 {
  if(out<0 || out%4!=0 || out>6291456-168 || width<=0.0 || height<=0.0 ||
     x!=x || y!=y || z!=z || width!=width || height!=height || angle!=angle ||
     rgba<0 || rgba>4294967295) { return 0-1; }
  let cosine=ux_math_cos(angle);
  let sine=ux_math_sin(angle);
  let corners=[0,1,2,0,2,3];
  let red=(rgba%256)*0.00392156862745098;
  let green=(rgba/256%256)*0.00392156862745098;
  let blue=(rgba/65536%256)*0.00392156862745098;
  let alpha=(rgba/16777216)*0.00392156862745098;
  let i=0;
  while(i<6) {
    let corner=corners[i];
    let dx=0.0-width*0.5;
    let dy=0.0-height*0.5;
    if(corner==1 || corner==2) { dx=width*0.5; }
    if(corner>=2) { dy=height*0.5; }
    let address=out+28*i;
    let px=ux_f32_put(address,x+dx*cosine-dy*sine);
    let py=ux_f32_put(address+4,y+dx*sine+dy*cosine);
    let pz=ux_f32_put(address+8,z);
    let r=ux_f32_put(address+12,red);
    let g=ux_f32_put(address+16,green);
    let b=ux_f32_put(address+20,blue);
    let a=ux_f32_put(address+24,alpha);
    i=i+1;
  }
  return 6;
}
