native function light_helper_span(at:i64,size:i64,align:i64) i64 {
  return at>=0 && at%align==0 && at<=6291456-size;
}

native function light_helper_disjoint(a:i64,n:i64,b:i64,m:i64) i64 {
  return a+n<=b || b+m<=a;
}

native function light_helper_rgb_valid(rgb:i64) i64 {
  if(!light_helper_span(rgb,24,8)) { return 0; }
  let r=ux_f64(rgb);
  let g=ux_f64(rgb+8);
  let b=ux_f64(rgb+16);
  return r-r==0.0 && g-g==0.0 && b-b==0.0;
}

native function light_helper_rgb_copy(dst:i64,src:i64) i64 {
  let r=ux_f64(src);
  let g=ux_f64(src+8);
  let b=ux_f64(src+16);
  let a=ux_f64_put(dst,r);
  let c=ux_f64_put(dst+8,g);
  let d=ux_f64_put(dst+16,b);
  return dst;
}

struct LightHelperLook {
  x: f64;
  y: f64;
  z: f64;
  distance: f64;
}

// World-space forward axis for a line or mesh with the default up vector.
native function light_helper_direction(dst:i64,x:f64,y:f64,z:f64) i64 {
  let length=f64_sqrt(x*x+y*y+z*z);
  if(length-length!=0.0) { return 0-1; }
  let distance=length;
  if(length==0.0) { z=1.0; length=1.0; }
  x=x/length;
  y=y/length;
  z=z/length;
  if(x==0.0 && z==0.0) {
    z=0.0001;
    length=f64_sqrt(y*y+z*z);
    y=y/length;
    z=z/length;
  }
  let a=ux_f64_put(dst+LightHelperLook.x,x);
  let b=ux_f64_put(dst+LightHelperLook.y,y);
  let c=ux_f64_put(dst+LightHelperLook.z,z);
  let d=ux_f64_put(dst+LightHelperLook.distance,distance);
  return dst;
}

native function light_helper_look(dst:i64,matrix:i64,target:i64) i64 {
  if(!light_helper_span(matrix,128,8) || !light_helper_span(target,128,8)) { return 0-1; }
  return light_helper_direction(dst,ux_f64(target+96)-ux_f64(matrix+96),
     ux_f64(target+104)-ux_f64(matrix+104),ux_f64(target+112)-ux_f64(matrix+112));
}
