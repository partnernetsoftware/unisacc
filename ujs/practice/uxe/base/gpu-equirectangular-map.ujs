struct GpuEquirectangularUv { u: f64; v: f64; }

native function gpu_equirectangular_vector(at:i64) i64 {
  return at>=0 && at%8==0 && at<=6291456-24;
}

// Converted cubemaps are render-target textures, which use an unflipped x.
native function GpuEquirectangularMap_face(mode:i64,incident:i64,normal:i64,eta:f64) i64 {
  let cube=GpuEquirectangularMap_cubeMode(mode);
  if(cube<0) { return cube; }
  return GpuCubeMap_face(cube,incident,normal,eta,1);
}

// Convert a mapped direction to the original equirectangular UV domain.
// A total-internal-reflection ray has no valid sample direction.
native function GpuEquirectangularMap_uv(out:i64,mode:i64,incident:i64,normal:i64,eta:f64) i64 {
  let operation=gpu_equirectangular_operation(mode);
  if(operation<0) { return operation; }
  if(out<0 || out%8!=0 || out>6291456-GpuEquirectangularUv.size ||
     gpu_equirectangular_vector(incident)==0 || gpu_equirectangular_vector(normal)==0 ||
     !(eta>=0.0 && eta<=16.0)) { return 0-1; }
  let ix=ux_f64(incident);
  let iy=ux_f64(incident+8);
  let iz=ux_f64(incident+16);
  let nx=ux_f64(normal);
  let ny=ux_f64(normal+8);
  let nz=ux_f64(normal+16);
  let i2=ix*ix+iy*iy+iz*iz;
  let n2=nx*nx+ny*ny+nz*nz;
  if(!(i2>=0.999999 && i2<=1.000001 && n2>=0.999999 && n2<=1.000001)) { return 0-1; }
  let dot=ix*nx+iy*ny+iz*nz;
  let scale=1.0;
  let k=2.0*dot;
  if(operation==1) {
    let discriminant=1.0-eta*eta*(1.0-dot*dot);
    if(discriminant<0.0) { return 0-3; }
    scale=eta;
    k=eta*dot+f64_sqrt(discriminant);
  }
  let x=ix*scale-k*nx;
  let y=iy*scale-k*ny;
  let z=iz*scale-k*nz;
  let length=f64_sqrt(x*x+y*y+z*z);
  if(!(length>0.0)) { return 0-3; }
  let latitude=y/length;
  if(latitude>1.0) { latitude=1.0; }
  if(latitude<0.0-1.0) { latitude=0.0-1.0; }
  let longitude=0.0;
  if(x!=0.0 || z!=0.0) { longitude=ux_math_atan2(z,x); }
  let u=ux_f64_put(out+GpuEquirectangularUv.u,0.5+longitude*0.15915494309189535);
  let v=ux_f64_put(out+GpuEquirectangularUv.v,0.5+ux_math_asin(latitude)*0.3183098861837907);
  return out;
}

// A tightly packed non-flipped RGBA8 image with clamp-to-edge and nearest
// filtering. This operation samples the original image, independently of the
// finite-face filtering chosen by a renderer's cubemap conversion.
native function GpuEquirectangularMap_rgba(uv:i64,image:i64,width:i64,height:i64) i64 {
  if(uv<0 || uv%8!=0 || uv>6291456-GpuEquirectangularUv.size || image<0 || image%4!=0 || image>6291456 ||
     width<=0 || height<=0 || width>(6291456-image)/4 || height>(6291456-image)/4/width) { return 0-1; }
  let u=ux_f64(uv+GpuEquirectangularUv.u);
  let v=ux_f64(uv+GpuEquirectangularUv.v);
  if(!(u>=0.0 && u<=1.0 && v>=0.0 && v<=1.0)) { return 0-1; }
  let x=f64_floor_i64(u*width);
  let y=f64_floor_i64(v*height);
  if(x==width) { x=x-1; }
  if(y==height) { y=y-1; }
  return ux_u32(image+4*(y*width+x));
}
