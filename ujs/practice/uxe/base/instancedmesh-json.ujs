native function inst_json_token(dst:i64,end:i64,kind:i64) i64 {
  if(dst<0 || end>6291456 || end<dst) { return 0-1; }
  if(kind==0) {
    let bytes=[123,34,99,111,117,110,116,34,58];
    if(end-dst<9) { return 0-1; }
    let i=0;
    while(i<9) { let saved=ux_u8_put(dst+i,bytes[i]); i=i+1; }
    return dst+9;
  }
  if(kind==1) {
    let bytes=[44,34,105,110,115,116,97,110,99,101,77,97,116,114,105,120,34,58];
    if(end-dst<18) { return 0-1; }
    let i=0;
    while(i<18) { let saved=ux_u8_put(dst+i,bytes[i]); i=i+1; }
    return dst+18;
  }
  if(kind==2) {
    let bytes=[44,34,105,110,115,116,97,110,99,101,67,111,108,111,114,34,58];
    if(end-dst<17) { return 0-1; }
    let i=0;
    while(i<17) { let saved=ux_u8_put(dst+i,bytes[i]); i=i+1; }
    return dst+17;
  }
  if(kind==3) {
    let bytes=[123,34,105,116,101,109,83,105,122,101,34,58];
    if(end-dst<12) { return 0-1; }
    let i=0;
    while(i<12) { let saved=ux_u8_put(dst+i,bytes[i]); i=i+1; }
    return dst+12;
  }
  if(kind==4) {
    let bytes=[44,34,116,121,112,101,34,58,34,70,108,111,97,116,51,50,65,114,114,97,121,34,44,34,97,114,114,97,121,34,58,91];
    if(end-dst<32) { return 0-1; }
    let i=0;
    while(i<32) { let saved=ux_u8_put(dst+i,bytes[i]); i=i+1; }
    return dst+32;
  }
  if(kind==5) {
    let bytes=[93,44,34,110,111,114,109,97,108,105,122,101,100,34,58,102,97,108,115,101,44,34,109,101,115,104,80,101,114,65,116,116,114,105,98,117,116,101,34,58,49,44,34,105,115,73,110,115,116,97,110,99,101,100,66,117,102,102,101,114,65,116,116,114,105,98,117,116,101,34,58,116,114,117,101,125];
    if(end-dst<76) { return 0-1; }
    let i=0;
    while(i<76) { let saved=ux_u8_put(dst+i,bytes[i]); i=i+1; }
    return dst+76;
  }
  return 0-1;
}

native function inst_json_attribute(p:i64,end:i64,data:i64,count:i64,size:i64,scratch:i64) i64 {
  p=inst_json_token(p,end,3);
  p=json_write_f64(p,end,0.0+size,scratch);
  p=inst_json_token(p,end,4);
  let i=0;
  while(p>=0 && i<count*size) {
    if(i>0) { p=json_byte(p,end,44); }
    p=json_write_f64(p,end,ux_f32(data+i*4),scratch);
    i=i+1;
  }
  return inst_json_token(p,end,5);
}

// Serializes the instance payload, to be included in the common Object3D envelope.
native function InstancedMesh_toJSON(self:i64,dst:i64,end:i64,scratch:i64) i64 {
  if(!instance_valid(self) || !instance_arrays_valid(self) || dst<0 ||
     end<=dst || end>6291456 || scratch<0 || scratch%8!=0 || scratch>6290352 ||
     instance_overlaps(dst,end-dst,scratch,1104) ||
     instance_overlaps(self,InstancedMesh.size,dst,end-dst) ||
     instance_overlaps(self,InstancedMesh.size,scratch,1104)) { return 0-1; }
  let capacity=ux_u32(self+InstancedMesh.capacity);
  let count=ux_u32(self+InstancedMesh.count);
  let matrices=ux_u32(self+InstancedMesh.matrices);
  let colors=ux_u32(self+InstancedMesh.colors);
  if(instance_overlaps(matrices,capacity*64,dst,end-dst) ||
     instance_overlaps(matrices,capacity*64,scratch,1104) ||
     instance_overlaps(colors,capacity*12,dst,end-dst) ||
     instance_overlaps(colors,capacity*12,scratch,1104)) { return 0-1; }
  let p=inst_json_token(dst,end,0);
  p=json_write_f64(p,end,0.0+count,scratch);
  p=inst_json_token(p,end,1);
  p=inst_json_attribute(p,end,matrices,capacity,16,scratch);
  if(ux_u32(self+InstancedMesh.hasColors)!=0) {
    p=inst_json_token(p,end,2);
    p=inst_json_attribute(p,end,colors,capacity,3,scratch);
  }
  return json_byte(p,end,125);
}
