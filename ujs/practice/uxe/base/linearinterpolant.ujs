native function LinearInterpolant_evaluate(view:i64,t:f64,out:i64) i64 {
  let stride=animation_sample_output(view,out);
  if(stride<0 || t!=t) { return 0-1; }
  let times=ux_u32(view+AnimationSamples.times);
  let count=ux_u32(view+AnimationSamples.count);
  let upper=animation_sample_upper(times,count,t);
  let values=ux_u32(view+AnimationSamples.values);
  let lower=upper-1;
  if(upper==0) { lower=0; }
  if(upper==count) { upper=lower; }
  let lo=values+lower*stride*4;
  let hi=values+upper*stride*4;
  let fraction=0.0;
  if(lower!=upper) {
    let t0=ux_f32(times+lower*4);
    let t1=ux_f32(times+upper*4);
    fraction=(t-t0)/(t1-t0);
  }
  let i=0;
  while(i<stride) {
    if(lower==upper) {
      let cell=ux_u32_put(out+i*4,ux_u32(lo+i*4));
    } else {
      let cell=ux_f32_put(out+i*4,ux_f32(lo+i*4)*(1.0-fraction)+ux_f32(hi+i*4)*fraction);
    }
    i=i+1;
  }
  return out;
}
