native function gpu_cube_face(x:f64,y:f64,z:f64) i64 {
  let ax=x;
  let ay=y;
  let az=z;
  if(x<0.0) { ax=0.0-x; }
  if(y<0.0) { ay=0.0-y; }
  if(z<0.0) { az=0.0-z; }
  if(ax==0.0 && ay==0.0 && az==0.0) { return 0-3; }
  if(ax>ay && ax>az) {
    if(x<0.0) { return 1; }
    return 0;
  }
  if(ay>ax && ay>az) {
    if(y<0.0) { return 3; }
    return 2;
  }
  if(az>ax && az>ay) {
    if(z<0.0) { return 5; }
    return 4;
  }
  return 0-3;
}

// The incident direction and surface normal are unit vectors supplied by the material pipeline.
native function gpu_cube_map_face(mode:i64,incident:i64,normal:i64,eta:f64,flipX:i64) i64 {
  if(incident<0 || incident%8!=0 || incident>6291456-24 ||
     normal<0 || normal%8!=0 || normal>6291456-24 ||
     (flipX!=1 && flipX!=0-1) || !(eta>=0.0 && eta<=16.0)) { return 0-1; }
  let ix=ux_f64(incident);
  let iy=ux_f64(incident+8);
  let iz=ux_f64(incident+16);
  let nx=ux_f64(normal);
  let ny=ux_f64(normal+8);
  let nz=ux_f64(normal+16);
  let i2=ix*ix+iy*iy+iz*iz;
  let n2=nx*nx+ny*ny+nz*nz;
  if(!(i2>=0.999999 && i2<=1.000001 && n2>=0.999999 && n2<=1.000001)) { return 0-1; }
  let dot=ix*nx+iy*ny+iz*nz;
  if(mode==0) {
    let k=2.0*dot;
    return gpu_cube_face((ix-k*nx)*flipX,iy-k*ny,iz-k*nz);
  }
  if(mode==1) {
    let discriminant=1.0-eta*eta*(1.0-dot*dot);
    if(discriminant<0.0) { return 0-3; }
    let k=eta*dot+f64_sqrt(discriminant);
    return gpu_cube_face((eta*ix-k*nx)*flipX,eta*iy-k*ny,eta*iz-k*nz);
  }
  return 0-2;
}
