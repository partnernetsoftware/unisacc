// The Object3D arena owns the node. Mesh owns its morph rows, while geometry,
// material and morph attributes are shared with other mesh instances.
struct Mesh {
  node: u32;
  geometry: u32;
  material: u32;
  morphRows: u32;
  morphCapacity: u32;
  morphCount: u32;
  morphRelative: u32;
}

native function mesh_valid(mesh:i64) i64 {
  return mesh>=0 && mesh<=6291456-Mesh.size && mesh%4==0;
}
