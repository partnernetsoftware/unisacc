struct GridHelper {
  positions: u32;
  colors: u32;
  count: u32;
  active: u32;
}

native function grid_span(at:i64,size:i64) i64 {
  return at>=0 && at%4==0 && at<=6291456-size;
}

native function grid_disjoint(a:i64,n:i64,b:i64,m:i64) i64 {
  return a+n<=b || b+m<=a;
}

// Colors are two consecutive linear RGB triples.
native function GridHelper_init(grid:i64,positions:i64,colors:i64,capacity:i64,rgb:i64,size:f64,divisions:i64) i64 {
  if(divisions<1 || divisions>4096 || size-size!=0.0) { return 0-1; }
  let count=(divisions+1)*4;
  let bytes=count*12;
  if(capacity<count || !grid_span(grid,GridHelper.size) || !grid_span(rgb,24) ||
     !grid_span(positions,bytes) || !grid_span(colors,bytes) ||
     !grid_disjoint(grid,GridHelper.size,rgb,24) ||
     !grid_disjoint(grid,GridHelper.size,positions,bytes) ||
     !grid_disjoint(grid,GridHelper.size,colors,bytes) ||
     !grid_disjoint(colors,bytes,positions,bytes) ||
     !grid_disjoint(rgb,24,positions,bytes) || !grid_disjoint(rgb,24,colors,bytes)) { return 0-1; }
  let half=size*0.5;
  let step=size/(0.0+divisions);
  let k=0.0-half;
  let i=0;
  while(i<=divisions) {
    let shade=rgb+12;
    if(i*2==divisions) { shade=rgb; }
    let j=0;
    while(j<12) {
      let value=0.0;
      if(j==0 || j==8) { value=0.0-half; }
      if(j==3 || j==11) { value=half; }
      if(j==2 || j==5 || j==6 || j==9) { value=k; }
      let at=(i*12+j)*4;
      let p=ux_f32_put(positions+at,value);
      let c=ux_u32_put(colors+at,ux_u32(shade+j%3*4));
      j=j+1;
    }
    k=k+step;
    i=i+1;
  }
  let p=ux_u32_put(grid+GridHelper.positions,positions);
  let c=ux_u32_put(grid+GridHelper.colors,colors);
  let n=ux_u32_put(grid+GridHelper.count,count);
  let a=ux_u32_put(grid+GridHelper.active,1);
  return grid;
}

native function GridHelper_dispose(grid:i64) i64 {
  if(!grid_span(grid,GridHelper.size) || ux_u32(grid+GridHelper.active)!=1) { return 0-1; }
  let gone=ux_u32_put(grid+GridHelper.active,0);
  return 0;
}
