function ux_utf8(start, ...lengths) {
  let length = lengths[0];
  let checked = ux_span(start, length);
  let at = start;
  let end = start + length;
  let good = 1;
  while (at < end && good == 1) {
    let lead = ux_u8(at);
    let remain = 0;
    let lower = 128;
    let upper = 191;
    at = at + 1;
    if (lead >= 194 && lead <= 223) {
      remain = 1;
    } else if (lead >= 224 && lead <= 239) {
      remain = 2;
      if (lead == 224) { lower = 160; }
      if (lead == 237) { upper = 159; }
    } else if (lead >= 240 && lead <= 244) {
      remain = 3;
      if (lead == 240) { lower = 144; }
      if (lead == 244) { upper = 143; }
    } else if (lead >= 128) {
      good = 0;
    }
    if (remain > end - at) { good = 0; }
    while (remain > 0 && good == 1) {
      let continuation = ux_u8(at);
      if (continuation < lower || continuation > upper) { good = 0; }
      lower = 128;
      upper = 191;
      at = at + 1;
      remain = remain - 1;
    }
  }
  return good;
}
