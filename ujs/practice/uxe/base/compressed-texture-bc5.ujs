// BC5 uses the BC4 RGTC decoder with adjacent red and green component blocks.
native function CompressedTexture_bc5Level(level:i64,data:i64,bytes:i64,width:i64,height:i64,format:i64) i64 {
  if(format!=36285 && format!=36286) { return 0-2; }
  return bc_rgtc_level(level,data,bytes,width,height,format,16);
}

native function CompressedTexture_decodeBC5(level:i64,dst:i64,capacity:i64) i64 {
  return bc_rgtc_decode(level,dst,capacity,36285,16);
}
