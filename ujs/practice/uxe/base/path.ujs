struct Path {
  segments: u32;
  capacity: u32;
  count: u32;
  startX: f64;
  startY: f64;
  x: f64;
  y: f64;
}

// Each segment owns an 8-byte kind prefix followed by up to eight f64 coordinates.
native function Path_init(path:i64,segments:i64,capacity:i64) i64 {
  if(path<0 || path>6291456-Path.size || path%8!=0 || segments<0 || segments>6291456 ||
     segments%8!=0 || capacity<0 || capacity>(6291456-segments)/72 ||
     (capacity!=0 && path<segments+capacity*72 && segments<path+Path.size)) { return 0-1; }
  let data=ux_u32_put(path+Path.segments,segments);
  let cap=ux_u32_put(path+Path.capacity,capacity);
  let count=ux_u32_put(path+Path.count,0);
  let a=ux_f64_put(path+Path.startX,0.0);
  let b=ux_f64_put(path+Path.startY,0.0);
  let x=ux_f64_put(path+Path.x,0.0);
  let y=ux_f64_put(path+Path.y,0.0);
  return path;
}

native function Path_moveTo(path:i64,x:f64,y:f64) i64 {
  let a=ux_f64_put(path+Path.startX,x);
  let b=ux_f64_put(path+Path.startY,y);
  let current_x=ux_f64_put(path+Path.x,x);
  let current_y=ux_f64_put(path+Path.y,y);
  return path;
}

native function path_add(path:i64,kind:i64,x:f64,y:f64,ax:f64,ay:f64,bx:f64,by:f64) i64 {
  let n=ux_u32(path+Path.count);
  if(n>=ux_u32(path+Path.capacity)) { return 0-1; }
  let at=ux_u32(path+Path.segments)+72*n;
  let mark=ux_u32_put(at,kind);
  let begin_x=ux_f64_put(at+8,ux_f64(path+Path.x));
  let begin_y=ux_f64_put(at+16,ux_f64(path+Path.y));
  let next=at+24;
  if(kind>=2) {
    let a_x=ux_f64_put(next,ax);
    let a_y=ux_f64_put(next+8,ay);
    next=next+16;
  }
  if(kind==3) {
    let b_x=ux_f64_put(next,bx);
    let b_y=ux_f64_put(next+8,by);
    next=next+16;
  }
  let end_x=ux_f64_put(next,x);
  let end_y=ux_f64_put(next+8,y);
  let current_x=ux_f64_put(path+Path.x,x);
  let current_y=ux_f64_put(path+Path.y,y);
  let count=ux_u32_put(path+Path.count,n+1);
  return path;
}

native function Path_lineTo(path:i64,x:f64,y:f64) i64 {
  return path_add(path,1,x,y,0.0,0.0,0.0,0.0);
}

native function Path_quadraticCurveTo(path:i64,ax:f64,ay:f64,x:f64,y:f64) i64 {
  return path_add(path,2,x,y,ax,ay,0.0,0.0);
}

native function Path_bezierCurveTo(path:i64,ax:f64,ay:f64,bx:f64,by:f64,x:f64,y:f64) i64 {
  return path_add(path,3,x,y,ax,ay,bx,by);
}

native function Path_closePath(path:i64) i64 {
  let x=ux_f64(path+Path.startX);
  let y=ux_f64(path+Path.startY);
  if(ux_f64(path+Path.x)!=x || ux_f64(path+Path.y)!=y) {
    return Path_lineTo(path,x,y);
  }
  return path;
}

native function path_spline_address(segment:i64,index:i64) i64 {
  return segment+(index/4)*72+8+(index%4)*16;
}

// A spline owns four points per consecutive segment slot, including the
// current point. The initial slot stores the point count in its prefix.
native function Path_splineThru(path:i64,points:i64,count:i64) i64 {
  if(path<0 || path>6291456-Path.size || path%8!=0 || points<0 || points%8!=0 ||
     count<1 || count>4095 || points>6291456-count*16 ||
     (path<points+count*16 && points<path+Path.size)) { return 0-1; }
  let data=ux_u32(path+Path.segments);
  let capacity=ux_u32(path+Path.capacity);
  let used=ux_u32(path+Path.count);
  let slots=(count+4)/4;
  if(data%8!=0 || data>6291456 || capacity>(6291456-data)/72 || used>capacity ||
     slots>capacity-used) { return 0-1; }
  let at=data+used*72;
  if(at<points+count*16 && points<at+slots*72) { return 0-1; }
  let i=0;
  while(i<count*2) {
    let coordinate=ux_f64(points+i*8);
    if(coordinate-coordinate!=0.0) { return 0-2; }
    i=i+1;
  }
  let kind=ux_u32_put(at,4);
  let length=ux_u32_put(at+4,count+1);
  let x=ux_f64_put(at+8,ux_f64(path+Path.x));
  let y=ux_f64_put(at+16,ux_f64(path+Path.y));
  i=0;
  while(i<count) {
    let dst=path_spline_address(at,i+1);
    let a=ux_f64_put(dst,ux_f64(points+i*16));
    let b=ux_f64_put(dst+8,ux_f64(points+i*16+8));
    i=i+1;
  }
  let last=points+(count-1)*16;
  let a=ux_f64_put(path+Path.x,ux_f64(last));
  let b=ux_f64_put(path+Path.y,ux_f64(last+8));
  let total=ux_u32_put(path+Path.count,used+slots);
  return path;
}

native function path_spline_point(out:i64,segment:i64,t:f64) i64 {
  let count=ux_u32(segment+4);
  let p=t*(count-1);
  let index=f64_floor_i64(p);
  let local=p-index;
  let previous=index;
  let following=index;
  let after=index;
  if(index>0) { previous=index-1; }
  if(index+1<count) { following=index+1; }
  after=following;
  if(following+1<count) { after=following+1; }
  let pa=path_spline_address(segment,previous);
  let pb=path_spline_address(segment,index);
  let pc=path_spline_address(segment,following);
  let pd=path_spline_address(segment,after);
  let axis=0;
  while(axis<16) {
    let a=ux_f64(pa+axis);
    let b=ux_f64(pb+axis);
    let c=ux_f64(pc+axis);
    let d=ux_f64(pd+axis);
    let v0=(c-a)*0.5;
    let v1=(d-b)*0.5;
    let square=local*local;
    let cube=square*local;
    let value=(2.0*b-2.0*c+v0+v1)*cube+(-3.0*b+3.0*c-2.0*v0-v1)*square+v0*local+b;
    let written=ux_f64_put(out+axis,value);
    axis=axis+8;
  }
  return out;
}

native function path_sample(point:i64,segment:i64,t:f64) i64 {
  let kind=ux_u32(segment);
  if(kind==1) { return curve_line_point(point,segment+8,2,t); }
  if(kind==4) { return path_spline_point(point,segment,t); }
  return curve_bezier(point,segment+8,2,kind,t);
}

// One sample per straight edge and divisions samples per Bezier segment.
native function Path_getPoints(path:i64,output:i64,capacity:i64,divisions:i64,scratch:i64) i64 {
  if(output<0 || output>6291456 || output%8!=0 || capacity<0 ||
     capacity>(6291456-output)/16 || divisions<1 || divisions>4096 ||
     scratch<0 || scratch>6291456-16 || scratch%8!=0 ||
     (output<scratch+16 && scratch<output+capacity*16)) { return 0-1; }
  let last_x=0.0;
  let last_y=0.0;
  let count=0;
  let total=ux_u32(path+Path.count);
  let at=ux_u32(path+Path.segments);
  let segment=0;
  while(segment<total) {
    let steps=divisions;
    let slots=1;
    let kind=ux_u32(at);
    if(kind==1) { steps=1; }
    if(kind==4) {
      let points=ux_u32(at+4);
      if(points<2 || points>4096) { return 0-1; }
      slots=(points+3)/4;
      if(slots>total-segment) { return 0-1; }
      steps=divisions*points;
    }
    let i=0;
    while(i<=steps) {
      let point=path_sample(scratch,at,i*1.0/steps);
      let x=ux_f64(point);
      let y=ux_f64(point+8);
      if(count==0 || x!=last_x || y!=last_y) {
        if(count>=capacity) { return 0-1; }
        let px=ux_f64_put(output+count*16,x);
        let py=ux_f64_put(output+count*16+8,y);
        last_x=x; last_y=y;
        count=count+1;
      }
      i=i+1;
    }
    at=at+72*slots;
    segment=segment+slots;
  }
  return count;
}
