function GLBufferAttribute_init(gl_dst,...gl_args) {
  let gl_span=ux_span(gl_dst,GLBufferAttribute.size);
  let gl_set_buf=ux_u32_put(gl_dst+GLBufferAttribute.buffer,gl_args[0]);
  let gl_set_type=ux_u32_put(gl_dst+GLBufferAttribute.componentType,gl_args[1]);
  let gl_set_size=ux_u32_put(gl_dst+GLBufferAttribute.itemSize,gl_args[2]);
  let gl_set_elem=ux_u32_put(gl_dst+GLBufferAttribute.elementSize,gl_args[3]);
  let gl_set_count=ux_u32_put(gl_dst+GLBufferAttribute.count,gl_args[4]);
  let gl_set_ver=ux_u32_put(gl_dst+GLBufferAttribute.version,0);
  return gl_dst;
}

function GLBufferAttribute_setBuffer(gl_buffer,...gl_buffer_args) {
  let gl_buffer_put=ux_u32_put(gl_buffer+GLBufferAttribute.buffer,gl_buffer_args[0]);
  return gl_buffer;
}

function GLBufferAttribute_setType(gl_type,...gl_type_args) {
  let gl_type_put=ux_u32_put(gl_type+GLBufferAttribute.componentType,gl_type_args[0]);
  let gl_element_put=ux_u32_put(gl_type+GLBufferAttribute.elementSize,gl_type_args[1]);
  return gl_type;
}

function GLBufferAttribute_setItemSize(gl_item,...gl_item_args) {
  let gl_item_put=ux_u32_put(gl_item+GLBufferAttribute.itemSize,gl_item_args[0]);
  return gl_item;
}

function GLBufferAttribute_setCount(gl_count,...gl_count_args) {
  let gl_count_put=ux_u32_put(gl_count+GLBufferAttribute.count,gl_count_args[0]);
  return gl_count;
}

function GLBufferAttribute_needsUpdate(gl_update,...gl_update_args) {
  if(gl_update_args[0]!=0) {
    let gl_version=gl_update+GLBufferAttribute.version;
    let gl_bump=ux_u32_put(gl_version,ux_u32(gl_version)+1);
  }
  return gl_update;
}
