// Adapt the numeric AnimationArrayView domains without copying their elements.
native function interpolant_token_valid(token:i64) i64 {
  if(!animation_span(token,AnimationArrayView.size)) { return 0; }
  let width=interpolant_width(ux_u32(token+AnimationArrayView.kind));
  let data=ux_u32(token+AnimationArrayView.data);
  let count=ux_u32(token+AnimationArrayView.count);
  return interpolant_span(data,count,width) &&
    !animation_overlap(token,AnimationArrayView.size,data,count*width);
}

native function InterpolantView_fromArrays(view:i64,timeToken:i64,valueToken:i64,stride:i64) i64 {
  if(!interpolant_token_valid(timeToken) || !interpolant_token_valid(valueToken) || stride<1 || stride>64 ||
     animation_overlap(view,InterpolantNumericView.size,timeToken,AnimationArrayView.size) ||
     animation_overlap(view,InterpolantNumericView.size,valueToken,AnimationArrayView.size)) { return 0-1; }
  let count=ux_u32(timeToken+AnimationArrayView.count);
  let valueCount=ux_u32(valueToken+AnimationArrayView.count);
  let valueWidth=interpolant_width(ux_u32(valueToken+AnimationArrayView.kind));
  if(valueCount<count*stride || animation_overlap(view,InterpolantNumericView.size,
     ux_u32(valueToken+AnimationArrayView.data),valueCount*valueWidth)) { return 0-1; }
  return InterpolantNumericView_init(view,ux_u32(timeToken+AnimationArrayView.data),
    ux_u32(valueToken+AnimationArrayView.data),count,stride,ux_u32(timeToken+AnimationArrayView.kind),
    ux_u32(valueToken+AnimationArrayView.kind));
}

native function Interpolant_initArray(state:i64,view:i64,resultToken:i64,kind:i64) i64 {
  if(resultToken==0-1) { return Interpolant_initNumeric(state,view,0-1,0-1,kind); }
  if(!animation_span(view,InterpolantNumericView.size) || !interpolant_token_valid(resultToken)) { return 0-1; }
  let stride=ux_u32(view+InterpolantNumericView.stride);
  let width=interpolant_width(ux_u32(view+InterpolantNumericView.valueKind));
  if(ux_u32(resultToken+AnimationArrayView.count)<stride ||
     animation_overlap(state,InterpolantState.size+stride*width,resultToken,AnimationArrayView.size)) { return 0-1; }
  return Interpolant_initNumeric(state,view,ux_u32(resultToken+AnimationArrayView.data),
    ux_u32(resultToken+AnimationArrayView.kind),kind);
}

native function Interpolant_setResultArray(state:i64,resultToken:i64) i64 {
  if(resultToken==0-1) { return Interpolant_setResultKind(state,0-1,0-1); }
  if(!interpolant_alive(state) || !interpolant_token_valid(resultToken)) { return 0-1; }
  let view=ux_u32(state+InterpolantState.view);
  if(!animation_span(view,AnimationSamples.size)) { return 0-1; }
  let stride=ux_u32(view+AnimationSamples.stride);
  let width=interpolant_width(ux_u32(state+InterpolantState.valueKind));
  if(ux_u32(resultToken+AnimationArrayView.count)<stride ||
     animation_overlap(state,InterpolantState.size+stride*width,resultToken,AnimationArrayView.size)) { return 0-1; }
  return Interpolant_setResultKind(state,ux_u32(resultToken+AnimationArrayView.data),
    ux_u32(resultToken+AnimationArrayView.kind));
}
