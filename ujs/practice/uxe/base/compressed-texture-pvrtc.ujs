// PVRTC1 upload geometry follows WEBGL_compressed_texture_pvrtc.
native function CompressedTexture_pvrtcInfo(format:i64,w:i64,h:i64) i64 {
    if (format<35840 || format>35843) { return 0-1; }
    if (w<1 || h<1 || w>65536 || h>65536) { return 0-2; }
    let x=w;
    let y=h;
    while (x>1 && x%2==0) { x=x/2; }
    while (y>1 && y%2==0) { y=y/2; }
    if (x!=1 || y!=1) { return 0-2; }
    let blockWidth=4;
    if (format%2==1) { blockWidth=8; }
    let columns=w/blockWidth;
    let rows=h/4;
    if (columns<2) { columns=2; }
    if (rows<2) { rows=2; }
    let alpha=(format-35840)/2;
    // Low nibble: block width. Next nibble: height. Bit 8: alpha.
    // Remaining bits: validated byte footprint.
    return columns*rows*8*512+alpha*256+4*16+blockWidth;
}
