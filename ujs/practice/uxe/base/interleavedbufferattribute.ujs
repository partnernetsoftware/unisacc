function InterleavedBufferAttribute_init(ia_dst,...ia_args) {
  let ia_backing=ia_args[0];
  let ia_size=ia_args[1];
  let ia_offset=ia_args[2];
  let ia_kind=ux_u32(ia_backing+InterleavedBuffer.componentType);
  let ia_stride=ux_u32(ia_backing+InterleavedBuffer.stride);
  let ia_width=BufferAttribute_width(ia_kind);
  let ia_result=0-1;
  if(ia_width>0 && ia_offset>=0 && ia_size>0 && ia_offset+ia_size<=ia_stride/ia_width) {
    let ia_data=ux_u32(ia_backing+InterleavedBuffer.data)+ia_offset*ia_width;
    ia_result=BufferAttribute_init(ia_dst,ia_data,ux_u32(ia_backing+InterleavedBuffer.count),ia_size,ia_kind,ia_args[3]);
    if(ia_result>=0) {
      let ia_layout_stride=ux_u32_put(ia_dst+BufferAttribute.stride,ia_stride);
      let ia_buffer_ref=ux_u32_put(ia_dst+InterleavedBufferAttribute.buffer,ia_backing);
      let ia_source_offset=ux_u32_put(ia_dst+InterleavedBufferAttribute.offset,ia_offset);
    }
  }
  return ia_result;
}

function InterleavedBufferAttribute_needsUpdate(ia_update,...ia_update_args) {
  let ia_update_buffer=ux_u32(ia_update+InterleavedBufferAttribute.buffer);
  let ia_did_update=InterleavedBuffer_needsUpdate(ia_update_buffer,ia_update_args[0]);
  return ia_update;
}
