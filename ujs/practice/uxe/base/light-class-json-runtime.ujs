// Construct from a validated LightJson snapshot. Heap addresses and target
// handles never cross the JSON boundary.
native function Light_fromJSON(out:i64,arena:i64,state:i64) i64 {
  if(light_block(state,LightJson.size)==0 || light_ready(out,arena)==0 ||
      light_overlap(out,Light.size,state,LightJson.size)!=0 ||
      light_overlap(arena,light_arena_size(arena),state,LightJson.size)!=0) { return 0-1; }
  let kind=ux_u32(state+LightJson.kind);
  if(kind==1 && ux_u8(state+LightJson.fields.sh)!=0) { kind=8; }
  let color=ux_u32(state+LightJson.color);
  let ground=ux_u32(state+LightJson.groundColor);
  if(color>16777215 || ground>16777215) { return 0-1; }
  let ready=light_new(out,arena,kind,color,ux_f64(state+LightJson.intensity));
  if(ready<0) { return ready; }
  let handle=Light_object(out);
  let address=Object3D_address(arena,handle);
  let visible=ux_u32_put(address+Object3D.visible,ux_u32(state+LightJson.visible)!=0);
  let layers=ux_u32_put(address+Object3D.layerMask,ux_u32(state+LightJson.layers));
  let fields=state+LightJson.fields;
  if(ux_u8(fields+LightJsonField.groundColor)!=0) {
    let rgb=Color_setHex(out+Light.groundColor,ground,1);
  }
  if(ux_u8(fields+LightJsonField.distance)!=0) {
    let data=ux_f64_put(out+Light.distance,ux_f64(state+LightJson.distance));
  }
  if(ux_u8(fields+LightJsonField.decay)!=0) {
    let data=ux_f64_put(out+Light.decay,ux_f64(state+LightJson.decay));
  }
  if(ux_u8(fields+LightJsonField.angle)!=0) {
    let data=ux_f64_put(out+Light.angle,ux_f64(state+LightJson.angle));
  }
  if(ux_u8(fields+LightJsonField.penumbra)!=0) {
    let data=ux_f64_put(out+Light.penumbra,ux_f64(state+LightJson.penumbra));
  }
  if(ux_u8(fields+LightJsonField.dimensions)!=0) {
    let width=ux_f64_put(out+Light.width,ux_f64(state+LightJson.width));
    let height=ux_f64_put(out+Light.height,ux_f64(state+LightJson.height));
  }
  if(ux_u8(fields+LightJsonField.shadow)!=0) {
    let shadow=uxe_copy_record(out+Light.shadow,state+LightJson.shadow,LightShadowJson.size);
  }
  if(ux_u8(fields+LightJsonField.sh)!=0) {
    let coeff=uxe_copy_record(out+Light.sh,state+LightJson.sh,LightSH.size);
  }
  return out;
}
