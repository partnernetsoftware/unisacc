struct LoadedMaterialState {
  side: u32;
  depthFunction: u32;
  depthTest: u32;
  depthWrite: u32;
  colorWrite: u32;
  alphaTest: f64;
}

native function material_json_bool(at:i64,otherwise:i64) i64 {
  if(at==0-2) { return otherwise; }
  if(at<0) { return 0-1; }
  let token=ux_u8(at);
  if(token==102) { return 0; }
  if(token==116) { return 1; }
  return 0-1;
}

native function MaterialLoader_parseState(file:i64,out:i64,key:i64) i64 {
  if(!loading_span(file,FileLoader.size) || ux_u32(file+FileLoader.state)!=2 ||
     !loading_span(out,LoadedMaterialState.size) || out%8!=0 || !loading_span(key,12) ||
     !file_disjoint(file,FileLoader.size,key,12) || !file_disjoint(file,FileLoader.size,out,LoadedMaterialState.size) ||
     !file_disjoint(out,LoadedMaterialState.size,key,12)) { return 0-1; }
  let input=ux_u32(file+FileLoader.bytes);
  let bytes=ux_u32(file+FileLoader.length);
  if(input>6291456-bytes || !file_disjoint(input,bytes,key,12) ||
     !file_disjoint(input,bytes,out,LoadedMaterialState.size)) { return 0-1; }
  let end=input+bytes;
  let parsed=json_value_end(input,end);
  if(parsed<0 || json_space(parsed,end)!=end || ux_u8(json_space(input,end))!=123) { return 0-2; }
  let side=LoaderJson_uint(LoaderJson_find(input,end,key,1701079411,0,0,4),end,0);
  let func=LoaderJson_uint(LoaderJson_find(input,end,key,1953523044,1853179496,99,9),end,3);
  let depth=material_json_bool(LoaderJson_find(input,end,key,1953523044,1936020584,116,9),1);
  let write=material_json_bool(LoaderJson_find(input,end,key,1953523044,1769101160,25972,10),1);
  let color=material_json_bool(LoaderJson_find(input,end,key,1869377379,1769101170,25972,10),1);
  let alpha=LoaderJson_number(LoaderJson_find(input,end,key,1752198241,1936020577,116,9),end,0.0);
  if(side<0 || side>2 || func<0 || func>7 || depth<0 || write<0 || color<0 ||
     alpha-alpha!=0.0) { return 0-3; }
  let a=ux_u32_put(out+LoadedMaterialState.side,side);
  let b=ux_u32_put(out+LoadedMaterialState.depthFunction,func);
  let c=ux_u32_put(out+LoadedMaterialState.depthTest,depth);
  let d=ux_u32_put(out+LoadedMaterialState.depthWrite,write);
  let e=ux_u32_put(out+LoadedMaterialState.colorWrite,color);
  let f=ux_f64_put(out+LoadedMaterialState.alphaTest,alpha);
  return out;
}
