native function BooleanKeyframeTrack_init(track:i64,name:i64,bytes:i64,view:i64) i64 {
  let at=KeyframeTrack_init(track,name,bytes,view);
  if(at<0) { return at; }
  return KeyframeTrack_setInterpolation(at,2300);
}

native function BoolTrack_setInterpolation(track:i64,mode:i64) i64 {
  if(!keyframe_track_at(track)) { return 0-1; }
  if(mode==2300) { return KeyframeTrack_setInterpolation(track,mode); }
  return track;
}

native function BoolTrack_evaluate(track:i64,t:f64,out:i64) i64 {
  let lanes=KeyframeTrack_getValueSize(track);
  if(lanes<1 || lanes>64 || t!=t || !animation_span(out,lanes*4) ||
     animation_overlap(out,lanes*4,track,KeyframeTrack.size) ||
     animation_overlap(out,lanes*4,ux_u32(track+KeyframeTrack.name),ux_u32(track+KeyframeTrack.nameBytes))) { return 0-1; }
  let view=ux_u32(track+KeyframeTrack.samples);
  if(animation_sample_output(view,out)!=lanes) { return 0-1; }
  let times=ux_u32(view+AnimationSamples.times);
  let count=ux_u32(view+AnimationSamples.count);
  let position=animation_sample_upper(times,count,t);
  if(position>0) { position=position-1; }
  let row=ux_u32(view+AnimationSamples.values)+position*lanes*4;
  let i=0;
  while(i<lanes) {
    if(ux_u32(row+i*4)>1) { return 0-2; }
    i=i+1;
  }
  return DiscreteInterpolant_evaluate(view,t,out);
}
