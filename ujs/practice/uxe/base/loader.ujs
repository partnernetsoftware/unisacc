struct Loader {
  manager: u32;
  path: u32;
  pathBytes: u32;
  resourcePath: u32;
  resourcePathBytes: u32;
  credentials: u32;
}

native function Loader_init(loader:i64,manager:i64) i64 {
  if(!loading_span(loader,Loader.size) || !loading_span(manager,LoadingManager.size) ||
     (loader<manager+LoadingManager.size && manager<loader+Loader.size)) { return 0-1; }
  let i=0;
  while(i<Loader.size) {
    let zero=ux_u32_put(loader+i,0);
    i=i+4;
  }
  let saved=ux_u32_put(loader+Loader.manager,manager);
  return loader;
}

// Paths are borrowed byte spans; zero length clears the selected path.
native function Loader_setPath(loader:i64,path:i64,bytes:i64,resource:i64) i64 {
  if(!loading_span(loader,Loader.size) || path<0 || bytes<0 || bytes>65535 || path>6291456-bytes ||
     (bytes>0 && loader<path+bytes && path<loader+Loader.size) || (resource!=0 && resource!=1)) { return 0-1; }
  let field=Loader.path;
  let length=Loader.pathBytes;
  if(resource!=0) { field=Loader.resourcePath; length=Loader.resourcePathBytes; }
  let pointer=ux_u32_put(loader+field,path);
  let saved=ux_u32_put(loader+length,bytes);
  return loader;
}

native function Loader_setWithCredentials(loader:i64,enabled:i64) i64 {
  if(!loading_span(loader,Loader.size) || (enabled!=0 && enabled!=1)) { return 0-1; }
  let saved=ux_u32_put(loader+Loader.credentials,enabled);
  return loader;
}
