// A nonnegative result is a byte offset for ux_u16, ux_u32, ux_i32,
// ux_f32 or ux_f64 and their _put counterparts.
// UX_VIEW_BOUNDS = -1, UX_VIEW_ALIGNMENT = -2.
function ux_typed_index(base, ...args) {
  let count = args[0];
  let index = args[1];
  let width = args[2];
  let result = 0 - 1;
  if (width == 2 || width == 4 || width == 8) {
    if (base >= 0 && base <= 6291456 && count >= 0) {
      if (count <= (6291456 - base) / width) {
        if (base % width != 0) {
          result = 0 - 2;
        } else if (index >= 0 && index < count) {
          result = base + index * width;
        }
      }
    }
  }
  return result;
}

// DataView addresses bytes in a bounded window and permits unaligned access.
// The underlying scalar primitives read and write in little-endian order.
function ux_data_offset(base, ...args) {
  let bytes = args[0];
  let offset = args[1];
  let width = args[2];
  let result = 0 - 1;
  if (width == 1 || width == 2 || width == 4 || width == 8) {
    if (base >= 0 && base <= 6291456 && bytes >= width) {
      if (bytes <= 6291456 - base && offset >= 0 && offset <= bytes - width) {
        result = base + offset;
      }
    }
  }
  return result;
}

// An aligned record array uses Layout.size for stride and Layout.align.
function ux_record_index(record_base, ...record_args) {
  let record_count = record_args[0];
  let record_index = record_args[1];
  let record_size = record_args[2];
  let record_align = record_args[3];
  let record_address = 0 - 1;
  if (record_align == 1 || record_align == 2 || record_align == 4 || record_align == 8) {
    if (record_size > 0 && record_size % record_align == 0 &&
        record_base >= 0 && record_base <= 6291456 && record_count >= 0) {
      if (record_count <= (6291456 - record_base) / record_size) {
        if (record_base % record_align != 0) {
          record_address = 0 - 2;
        } else if (record_index >= 0 && record_index < record_count) {
          record_address = record_base + record_index * record_size;
        }
      }
    }
  }
  return record_address;
}
