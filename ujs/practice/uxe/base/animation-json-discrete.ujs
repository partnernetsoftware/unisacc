struct AnimationJsonDiscreteRows {
  times: u32;
  values: u32;
  text: u32;
  capacity: u32;
  textCapacity: u32;
  count: u32;
  textBytes: u32;
  valueCapacity: u32;
  valueCount: u32;
}

native function animation_json_region(at:i64,size:i64,input:i64,bytes:i64,key:i64,keyBytes:i64,out:i64,work:i64) i64 {
  return animation_span(at,size) &&
    !animation_json_overlap(at,size,input,bytes) && !animation_json_overlap(at,size,key,keyBytes) &&
    !animation_json_overlap(at,size,out,AnimationJsonDiscreteRows.size) && !animation_json_overlap(at,size,work,4);
}

// Kind 1 yields boolean u32 values; kind 2 yields UTF-8 address/length pairs.
native function AnimationUtils_flattenDiscrete(input:i64,bytes:i64,key:i64,keyBytes:i64,
                                               kind:i64,out:i64,work:i64) i64 {
  if(input<0 || bytes<2 || input>6291456-bytes || key<0 || keyBytes<1 || keyBytes>255 ||
     key>6291456-keyBytes || kind<1 || kind>2 || !animation_span(out,AnimationJsonDiscreteRows.size) ||
     !animation_span(work,4) || animation_json_overlap(out,AnimationJsonDiscreteRows.size,input,bytes) ||
     animation_json_overlap(out,AnimationJsonDiscreteRows.size,key,keyBytes) ||
     animation_json_overlap(out,AnimationJsonDiscreteRows.size,work,4) ||
     animation_json_overlap(work,4,input,bytes) || animation_json_overlap(work,4,key,keyBytes)) { return 0-1; }
  let times=ux_u32(out+AnimationJsonDiscreteRows.times);
  let values=ux_u32(out+AnimationJsonDiscreteRows.values);
  let text=ux_u32(out+AnimationJsonDiscreteRows.text);
  let capacity=ux_u32(out+AnimationJsonDiscreteRows.capacity);
  let textCapacity=ux_u32(out+AnimationJsonDiscreteRows.textCapacity);
  let valueCapacity=ux_u32(out+AnimationJsonDiscreteRows.valueCapacity);
  if(valueCapacity==0) { valueCapacity=capacity; }
  let valueBytes=valueCapacity*kind*4;
  let timeBytes=capacity*4;
  if(!animation_json_region(times,timeBytes,input,bytes,key,keyBytes,out,work) ||
     !animation_json_region(values,valueBytes,input,bytes,key,keyBytes,out,work) ||
     !animation_json_region(text,textCapacity,input,bytes,key,keyBytes,out,work) ||
     animation_json_overlap(times,timeBytes,values,valueBytes) ||
     animation_json_overlap(times,timeBytes,text,textCapacity) ||
     animation_json_overlap(values,valueBytes,text,textCapacity)) { return 0-1; }
  let end=input+bytes;
  let begin=json_space(input,end);
  let parsed=json_value_end(begin,end);
  if(begin<0 || begin>=end || ux_u8(begin)!=91 || parsed<0 || json_space(parsed,end)!=end) { return 0-2; }
  let timeKey=ux_u32_put(work,1701669236);
  let pass=0;
  let count=0;
  let valueCount=0;
  let textBytes=0;
  while(pass<2) {
    count=0;
    valueCount=0;
    textBytes=0;
    let cursor=json_space(begin+1,end);
    while(cursor>=0 && cursor<parsed-1) {
      if(ux_u8(cursor)!=123) { return 0-2; }
      let after=json_value_end(cursor,end);
      let item=json_find_key(cursor,after,key,keyBytes);
      if(item!=0-2) {
        if(item<0 || count>=capacity) { return 0-3; }
        let time=json_read_number(json_find_key(cursor,after,work,4),after);
        let scale=4294967296.0;
        let bound=(2.0-1.0/8388608.0)*2147483648.0*scale*scale*scale;
        if(time-time!=0.0 || time>bound || time<0.0-bound) { return 0-3; }
        let array=ux_u8(item)==91;
        let field=item;
        if(array) { field=json_space(item+1,after); }
        let finished=0;
        while(!finished && field>=0 && field<after && ux_u8(field)!=93) {
          if(valueCount>=valueCapacity) { return 0-3; }
          if(kind==1) {
            let token=ux_u8(field);
            if(token!=102 && token!=116) { return 0-3; }
            if(pass!=0) { let saved=ux_u32_put(values+valueCount*4,token==116); }
          } else {
            let length=Json_stringBytes(field,after);
            if(length<0 || length>textCapacity-textBytes) { return 0-3; }
            if(pass!=0) {
              let copied=Json_decodeString(field,after,text+textBytes,length);
              let addr=ux_u32_put(values+valueCount*8,text+textBytes);
              let size=ux_u32_put(values+valueCount*8+4,length);
            }
            textBytes=textBytes+length;
          }
          valueCount=valueCount+1;
          if(array) {
            field=json_space(json_value_end(field,after),after);
            if(ux_u8(field)==44) { field=json_space(field+1,after); }
          } else { finished=1; }
        }
        if(pass!=0) { let timeAt=ux_f32_put(times+count*4,time); }
        count=count+1;
      }
      cursor=json_space(after,end);
      if(ux_u8(cursor)==44) { cursor=json_space(cursor+1,end); }
    }
    pass=pass+1;
  }
  let a=ux_u32_put(out+AnimationJsonDiscreteRows.count,count);
  let b=ux_u32_put(out+AnimationJsonDiscreteRows.textBytes,textBytes);
  let c=ux_u32_put(out+AnimationJsonDiscreteRows.valueCount,valueCount);
  return out;
}
