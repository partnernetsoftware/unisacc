struct CompressedMip {
  data: u32;
  bytes: u32;
  width: u32;
  height: u32;
  format: u32;
}

// One decoded container level, in the format expected by a block upload.
native function CompressedTextureLoader_level(level:i64,data:i64,bytes:i64,width:i64,height:i64,format:i64) i64 {
  if(!loading_span(level,CompressedMip.size) || width<1 || width>16384 || height<1 || height>16384 ||
     data<0 || bytes<0 || data>6291456-bytes || !file_disjoint(level,CompressedMip.size,data,bytes)) { return 0-1; }
  let block=8;
  if(format==33778 || format==33779) { block=16; }
  else if(format!=33776 && format!=33777) { return 0-2; }
  if((width+3)/4*((height+3)/4)*block!=bytes) { return 0-3; }
  let p=ux_u32_put(level+CompressedMip.data,data);
  let n=ux_u32_put(level+CompressedMip.bytes,bytes);
  let w=ux_u32_put(level+CompressedMip.width,width);
  let h=ux_u32_put(level+CompressedMip.height,height);
  let f=ux_u32_put(level+CompressedMip.format,format);
  return level;
}
