struct FogExp2 {
  name: u32;
  nameBytes: u32;
  red: f64;
  green: f64;
  blue: f64;
  density: f64;
}

struct FogExp2Json {
  kind: u32;
  name: u32;
  nameBytes: u32;
  color: u32;
  density: f64;
}

native function FogExp2_init(out:i64,color:i64,density:f64) i64 {
  if(out<0 || out%8!=0 || out>6291456-FogExp2.size ||
     color<0 || color%8!=0 || color>6291456-24) { return 0-1; }
  let rgb=Color_copy(out+FogExp2.red,color);
  let n=ux_u32_put(out+FogExp2.name,0);
  let nb=ux_u32_put(out+FogExp2.nameBytes,0);
  let d=ux_f64_put(out+FogExp2.density,density);
  return out;
}

native function FogExp2_initDefault(out:i64,color:i64) i64 {
  return FogExp2_init(out,color,0.00025);
}

// The caller owns the immutable UTF-8 bytes throughout the record's lifetime.
native function FogExp2_setName(fog:i64,text:i64,bytes:i64) i64 {
  if(fog<0 || fog%8!=0 || fog>6291456-FogExp2.size ||
     text<0 || bytes<0 || bytes>255 || text>6291456-bytes) { return 0-1; }
  let address=ux_u32_put(fog+FogExp2.name,text);
  let length=ux_u32_put(fog+FogExp2.nameBytes,bytes);
  return fog;
}

native function FogExp2_clone(out:i64,fog:i64) i64 {
  if(fog<0 || fog%8!=0 || fog>6291456-FogExp2.size) { return 0-1; }
  return FogExp2_init(out,fog+FogExp2.red,ux_f64(fog+FogExp2.density));
}

native function FogExp2_toJSON(out:i64,fog:i64) i64 {
  if(out<0 || out%8!=0 || out>6291456-FogExp2Json.size ||
     fog<0 || fog%8!=0 || fog>6291456-FogExp2.size) { return 0-1; }
  let label=ux_u32(fog+FogExp2.name);
  let bytes=ux_u32(fog+FogExp2.nameBytes);
  let color=Color_getHex(fog+FogExp2.red,1);
  let density=ux_f64(fog+FogExp2.density);
  let kind=ux_u32_put(out+FogExp2Json.kind,2);
  let name=ux_u32_put(out+FogExp2Json.name,label);
  let size=ux_u32_put(out+FogExp2Json.nameBytes,bytes);
  let hex=ux_u32_put(out+FogExp2Json.color,color);
  let amount=ux_f64_put(out+FogExp2Json.density,density);
  return out;
}

native function FogExp2_factor(fog:i64,depth:f64) f64 {
  if(fog<0 || fog%8!=0 || fog>6291456-FogExp2.size) { return 0.0-1.0; }
  return GpuFog_exponentialFactor(depth,ux_f64(fog+FogExp2.density));
}
