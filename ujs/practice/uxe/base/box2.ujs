struct Box2 { minX: f64; minY: f64; maxX: f64; maxY: f64; }

native function Box2_set(b2_dst:i64,b2_min_source:i64,b2_max_source:i64) i64 {
  let b2_min_x=ux_f64(b2_min_source);
  let b2_min_y=ux_f64(b2_min_source+8);
  let b2_max_x=ux_f64(b2_max_source);
  let b2_max_y=ux_f64(b2_max_source+8);
  let b2_min_written=Vector2_set(b2_dst,b2_min_x,b2_min_y);
  let b2_max_written=Vector2_set(b2_dst+16,b2_max_x,b2_max_y);
  return b2_dst;
}

function Box2_copy(b2_copy_dst,...b2_copy_args) {
  return Box2_set(b2_copy_dst,b2_copy_args[0],b2_copy_args[0]+16);
}

function Box2_clone(b2_clone_dst,...b2_clone_args) {
  return Box2_copy(b2_clone_dst,b2_clone_args[0]);
}

native function Box2_makeEmpty(b2_empty:i64) i64 {
  let b2_positive=1.0/0.0;
  let b2_negative=0.0-b2_positive;
  let b2_empty_min=Vector2_set(b2_empty,b2_positive,b2_positive);
  let b2_empty_max=Vector2_set(b2_empty+16,b2_negative,b2_negative);
  return b2_empty;
}

function Box2_isEmpty(b2_empty_test) {
  return ux_f64(b2_empty_test+16)<ux_f64(b2_empty_test) ||
      ux_f64(b2_empty_test+24)<ux_f64(b2_empty_test+8);
}

native function Box2_expandByPoint(b2_point_box:i64,b2_point:i64) i64 {
  let b2_point_min=Vector2_min(b2_point_box,b2_point);
  let b2_point_max=Vector2_max(b2_point_box+16,b2_point);
  return b2_point_box;
}

native function Box2_setFromPoints(b2_points_box:i64,b2_points_start:i64,b2_points_count:i64) i64 {
  let b2_points_result=0-1;
  if(b2_points_start>=0 && b2_points_start<=6291456 && b2_points_count>=0 &&
      b2_points_count<=(6291456-b2_points_start)/16) {
    b2_points_result=Box2_makeEmpty(b2_points_box);
    let b2_points_index=0;
    while(b2_points_index<b2_points_count) {
      let b2_points_expanded=Box2_expandByPoint(b2_points_result,b2_points_start+b2_points_index*16);
      b2_points_index=b2_points_index+1;
    }
  }
  return b2_points_result;
}

function Box2_setFromCenterAndSize(b2_size_box,...b2_size_args) {
  let b2_center=b2_size_args[0];
  let b2_size=b2_size_args[1];
  let b2_center_x=ux_f64(b2_center);
  let b2_center_y=ux_f64(b2_center+8);
  let b2_half_x=ux_f64(b2_size)*0.5;
  let b2_half_y=ux_f64(b2_size+8)*0.5;
  let b2_center_min=Vector2_set(b2_size_box,b2_center_x-b2_half_x,b2_center_y-b2_half_y);
  let b2_center_max=Vector2_set(b2_size_box+16,b2_center_x+b2_half_x,b2_center_y+b2_half_y);
  return b2_size_box;
}

function Box2_getCenter(b2_get_center_dst,...b2_get_center_args) {
  let b2_center_src=b2_get_center_args[0];
  let b2_center_result=b2_get_center_dst;
  if(Box2_isEmpty(b2_center_src)) { b2_center_result=Vector2_set(b2_get_center_dst,0.0,0.0); }
  else {
    b2_center_result=Vector2_set(b2_get_center_dst,
        (ux_f64(b2_center_src)+ux_f64(b2_center_src+16))*0.5,
        (ux_f64(b2_center_src+8)+ux_f64(b2_center_src+24))*0.5);
  }
  return b2_center_result;
}

function Box2_getSize(b2_get_size_dst,...b2_get_size_args) {
  let b2_get_size=b2_get_size_args[0];
  let b2_size_result=b2_get_size_dst;
  if(Box2_isEmpty(b2_get_size)) { b2_size_result=Vector2_set(b2_get_size_dst,0.0,0.0); }
  else {
    b2_size_result=Vector2_set(b2_get_size_dst,
        ux_f64(b2_get_size+16)-ux_f64(b2_get_size),
        ux_f64(b2_get_size+24)-ux_f64(b2_get_size+8));
  }
  return b2_size_result;
}

function Box2_expandByVector(b2_vector_box,...b2_vector_args) {
  let b2_vector=b2_vector_args[0];
  let b2_expand_min=Vector2_sub(b2_vector_box,b2_vector);
  let b2_expand_max=Vector2_add(b2_vector_box+16,b2_vector);
  return b2_vector_box;
}

native function Box2_expandByScalar(b2_scalar_box:i64,b2_scalar:f64) i64 {
  let b2_scalar_min=Vector2_addScalar(b2_scalar_box,0.0-b2_scalar);
  let b2_scalar_max=Vector2_addScalar(b2_scalar_box+16,b2_scalar);
  return b2_scalar_box;
}

function Box2_containsPoint(b2_contains_box,...b2_contains_args) {
  let b2_contains=b2_contains_args[0];
  let b2_contains_x=ux_f64(b2_contains);
  let b2_contains_y=ux_f64(b2_contains+8);
  return !(b2_contains_x<ux_f64(b2_contains_box) || b2_contains_x>ux_f64(b2_contains_box+16) ||
      b2_contains_y<ux_f64(b2_contains_box+8) || b2_contains_y>ux_f64(b2_contains_box+24));
}

function Box2_containsBox(b2_outer,...b2_outer_args) {
  let b2_inner=b2_outer_args[0];
  return ux_f64(b2_outer)<=ux_f64(b2_inner) && ux_f64(b2_outer+8)<=ux_f64(b2_inner+8) &&
      ux_f64(b2_outer+16)>=ux_f64(b2_inner+16) && ux_f64(b2_outer+24)>=ux_f64(b2_inner+24);
}

function Box2_getParameter(b2_parameter_dst,...b2_parameter_args) {
  let b2_parameter_box=b2_parameter_args[0];
  let b2_parameter_point=b2_parameter_args[1];
  let b2_parameter_minx=ux_f64(b2_parameter_box);
  let b2_parameter_miny=ux_f64(b2_parameter_box+8);
  return Vector2_set(b2_parameter_dst,
      (ux_f64(b2_parameter_point)-b2_parameter_minx)/(ux_f64(b2_parameter_box+16)-b2_parameter_minx),
      (ux_f64(b2_parameter_point+8)-b2_parameter_miny)/(ux_f64(b2_parameter_box+24)-b2_parameter_miny));
}

function Box2_intersectsBox(b2_intersects,...b2_intersects_args) {
  let b2_other=b2_intersects_args[0];
  return !(ux_f64(b2_other+16)<ux_f64(b2_intersects) || ux_f64(b2_other)>ux_f64(b2_intersects+16) ||
      ux_f64(b2_other+24)<ux_f64(b2_intersects+8) || ux_f64(b2_other+8)>ux_f64(b2_intersects+24));
}

function Box2_clampPoint(b2_clamp_dst,...b2_clamp_args) {
  let b2_clamp_box=b2_clamp_args[0];
  let b2_clamp_point=b2_clamp_args[1];
  return Vector2_set(b2_clamp_dst,
      vector_limit(ux_f64(b2_clamp_point),ux_f64(b2_clamp_box),ux_f64(b2_clamp_box+16)),
      vector_limit(ux_f64(b2_clamp_point+8),ux_f64(b2_clamp_box+8),ux_f64(b2_clamp_box+24)));
}

function Box2_distanceToPoint(b2_dist_box,...b2_dist_args) {
  let b2_dist_point=b2_dist_args[0];
  let b2_dist_x=ux_f64(b2_dist_point);
  let b2_dist_y=ux_f64(b2_dist_point+8);
  let b2_dist_dx=vector_limit(b2_dist_x,ux_f64(b2_dist_box),ux_f64(b2_dist_box+16))-b2_dist_x;
  let b2_dist_dy=vector_limit(b2_dist_y,ux_f64(b2_dist_box+8),ux_f64(b2_dist_box+24))-b2_dist_y;
  return f64_sqrt(b2_dist_dx*b2_dist_dx+b2_dist_dy*b2_dist_dy);
}

function Box2_intersect(b2_cut,...b2_cut_args) {
  let b2_cut_other=b2_cut_args[0];
  let b2_cut_min=Vector2_max(b2_cut,b2_cut_other);
  let b2_cut_max=Vector2_min(b2_cut+16,b2_cut_other+16);
  return b2_cut;
}

function Box2_union(b2_union,...b2_union_args) {
  let b2_union_other=b2_union_args[0];
  let b2_union_min=Vector2_min(b2_union,b2_union_other);
  let b2_union_max=Vector2_max(b2_union+16,b2_union_other+16);
  return b2_union;
}

function Box2_translate(b2_translate,...b2_translate_args) {
  let b2_offset=b2_translate_args[0];
  let b2_translate_min=Vector2_add(b2_translate,b2_offset);
  let b2_translate_max=Vector2_add(b2_translate+16,b2_offset);
  return b2_translate;
}

function Box2_equals(b2_eq,...b2_eq_args) {
  let b2_eq_other=b2_eq_args[0];
  return Vector2_equals(b2_eq,b2_eq_other) && Vector2_equals(b2_eq+16,b2_eq_other+16);
}
