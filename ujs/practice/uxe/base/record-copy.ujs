native function uxe_copy_record(dst:i64,src:i64,size:i64) i64 {
  if(dst<0 || dst>6291456 || src<0 || src>6291456 || size<0 ||
     size>6291456-dst || size>6291456-src) { return 0-1; }
  if(dst==src) { return dst; }
  let i=0;
  let step=1;
  if(dst>src && dst-src<size) {
    i=size-1;
    step=0-1;
  }
  while(i>=0 && i<size) {
    let copied=ux_u8_put(dst+i,ux_u8(src+i));
    i=i+step;
  }
  return dst;
}
