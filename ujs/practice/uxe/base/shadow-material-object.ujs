struct ShadowMaterialFields {
  color: u32;
  fog: u32;
}

native function shadow_object_size() i64 { return Material.size+ShadowMaterialFields.size; }

native function shadow_object_split(a:i64,n:i64,b:i64,m:i64) i64 {
  return a+n<=b || b+m<=a;
}

native function shadow_object_live(at:i64) i64 {
  return material_span(at) && at<=6291456-shadow_object_size() &&
    ux_u32(at+Material.id)>0 && ux_u32(at+Material.type)==14;
}

native function ShadowMaterial_set(at:i64,color:i64,fog:i64) i64 {
  if(!shadow_object_live(at) || color<0 || color>16777215 || fog<0 || fog>1) { return 0-1; }
  let a=ux_u32_put(at+Material.size+ShadowMaterialFields.color,color);
  let b=ux_u32_put(at+Material.size+ShadowMaterialFields.fog,fog);
  return at;
}

native function ShadowMaterial_init(at:i64,id:i64,dispatch:i64) i64 {
  if(!material_span(at) || at>6291456-shadow_object_size() || dispatch<0 ||
     dispatch>6291456-EventDispatcher.size ||
     !shadow_object_split(at,shadow_object_size(),dispatch,EventDispatcher.size)) { return 0-1; }
  let init=Material_init(at,id,14,dispatch);
  if(init<0) { return init; }
  let alpha=ux_u32_put(at+Material.transparent,1);
  return ShadowMaterial_set(at,0,1);
}

native function ShadowMaterial_copy(dst:i64,src:i64) i64 {
  if(!shadow_object_live(dst) || !shadow_object_live(src) ||
     (dst!=src && !shadow_object_split(dst,shadow_object_size(),src,shadow_object_size()))) { return 0-1; }
  let color=ux_u32(src+Material.size+ShadowMaterialFields.color);
  let fog=ux_u32(src+Material.size+ShadowMaterialFields.fog);
  if(color>16777215 || fog>1) { return 0-1; }
  let copied=Material_copy(dst,src);
  if(copied<0) { return copied; }
  return ShadowMaterial_set(dst,color,fog);
}
