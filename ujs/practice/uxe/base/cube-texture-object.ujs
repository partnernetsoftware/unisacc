// Face order follows WebGL: +X, -X, +Y, -Y, +Z, -Z.
native function cube_texture_face_bytes(descriptor:i64) i64 {
  if(!gpu_texture_source_valid(descriptor)) { return 0-1; }
  let side=ux_u32(descriptor+GpuTextureSource.width);
  if(side!=ux_u32(descriptor+GpuTextureSource.height)) { return 0-1; }
  let size=side*side*4;
  if(ux_u32(descriptor+GpuTextureSource.rgba)>6291456-6*size) { return 0-1; }
  return size;
}

native function CubeTexture_init(at:i64,table:i64,descriptor:i64) i64 {
  let size=cube_texture_face_bytes(descriptor);
  if(size<0) { return size; }
  let data=ux_u32(descriptor+GpuTextureSource.rgba);
  if(!texture_object_disjoint(at,Texture.size,data,6*size)) { return 0-1; }
  return Texture_init(at,table,descriptor);
}

native function CubeTexture_face(texture:i64,face:i64) i64 {
  if(!texture_object_valid(texture) || face<0 || face>=6) { return 0-1; }
  let descriptor=gpu_texture_source(ux_u32(texture+Texture.table),ux_u32(texture+Texture.handle));
  let size=cube_texture_face_bytes(descriptor);
  if(size<0) { return size; }
  return ux_u32(descriptor+GpuTextureSource.rgba)+face*size;
}

native function CubeTexture_clone(dst:i64,src:i64) i64 {
  let last=CubeTexture_face(src,5);
  if(last<0) { return last; }
  let descriptor=gpu_texture_source(ux_u32(src+Texture.table),ux_u32(src+Texture.handle));
  let size=cube_texture_face_bytes(descriptor);
  if(!texture_object_disjoint(dst,Texture.size,last-5*size,6*size)) { return 0-1; }
  return Texture_clone(dst,src);
}

native function CubeTexture_draw(texture:i64,packet:i64,capacity:i64,vertices:i64,count:i64,shader:i64) i64 {
  if(!texture_object_valid(texture)) { return 0-1; }
  let descriptor=gpu_texture_source(ux_u32(texture+Texture.table),ux_u32(texture+Texture.handle));
  return GpuPacket_drawCubeTexture(packet,capacity,vertices,count,shader,descriptor);
}
