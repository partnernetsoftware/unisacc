struct GltfTextureSource {
  bytes: u32;
  length: u32;
  mime: u32;
  sampler: u32;
}

native function gltf_image_mime(at:i64,end:i64) i64 {
  let close=json_scan_string(at,end);
  if(close<0 || close-at<11 || ux_u32(at+1)!=1734438249) { return 0; }
  if(close-at==11 && ux_u32(at+5)==1852845925 && ux_u8(at+9)==103) { return 1; }
  if(close-at==12 && ux_u32(at+5)==1886007141 && ux_u8(at+9)==101 && ux_u8(at+10)==103) { return 2; }
  return 0;
}

// Returns a borrowed PNG or JPEG span from the embedded GLB buffer.
native function GltfLoader_textureSource(glb:i64,index:i64,out:i64,key:i64) i64 {
  if(!loading_span(glb,GlbResource.size) || !loading_span(out,GltfTextureSource.size) ||
     !loading_span(key,12) || !file_disjoint(glb,GlbResource.size,key,12) ||
     !file_disjoint(glb,GlbResource.size,out,GltfTextureSource.size) ||
     !file_disjoint(out,GltfTextureSource.size,key,12)) { return 0-1; }
  let json=ux_u32(glb+GlbResource.json);
  let bytes=ux_u32(glb+GlbResource.jsonBytes);
  let bin=ux_u32(glb+GlbResource.bin);
  let binBytes=ux_u32(glb+GlbResource.binBytes);
  if(json>6291456-bytes || bin<1 || bin>6291456-binBytes ||
     !file_disjoint(json,bytes,key,12) || !file_disjoint(json,bytes,out,GltfTextureSource.size) ||
     !file_disjoint(bin,binBytes,key,12) || !file_disjoint(bin,binBytes,out,GltfTextureSource.size)) { return 0-1; }
  let end=json+bytes;
  let texture=LoaderJson_item(LoaderJson_find(json,end,key,1954047348,1936028277,0,8),end,index);
  if(texture<0) { return 0-2; }
  let src=LoaderJson_uint(LoaderJson_find(texture,end,key,1920298867,25955,0,6),end,0-1);
  let sampler=LoaderJson_uint(LoaderJson_find(texture,end,key,1886216563,7497068,0,7),end,4294967295);
  let image=LoaderJson_item(LoaderJson_find(json,end,key,1734438249,29541,0,6),end,src);
  if(image<0 || sampler<0) { return 0-2; }
  let mime=gltf_image_mime(LoaderJson_find(image,end,key,1701669229,1701869908,0,8),end);
  let viewIndex=LoaderJson_uint(LoaderJson_find(image,end,key,1717990754,1767273061,30565,10),end,0-1);
  let view=LoaderJson_item(LoaderJson_find(json,end,key,1717990754,1767273061,7567205,11),end,viewIndex);
  if(view<0 || mime==0 || LoaderJson_uint(LoaderJson_find(view,end,key,1717990754,29285,0,6),end,0-1)!=0) { return 0-3; }
  let offset=LoaderJson_uint(LoaderJson_find(view,end,key,1702132066,1936090703,29797,10),end,0);
  let length=LoaderJson_uint(LoaderJson_find(view,end,key,1702132066,1735288140,26740,10),end,0-1);
  if(offset<0 || length<1 || offset>binBytes-length) { return 0-4; }
  let a=ux_u32_put(out+GltfTextureSource.bytes,bin+offset);
  let b=ux_u32_put(out+GltfTextureSource.length,length);
  let c=ux_u32_put(out+GltfTextureSource.mime,mime);
  let d=ux_u32_put(out+GltfTextureSource.sampler,sampler);
  return out;
}
