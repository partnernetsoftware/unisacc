// Matrices are column-major. The caller supplies an inverse-transpose
// object-to-view normal matrix and an oriented view-space tangent frame.
// The object side sign applies to the sampled object-space normal only.
native function GpuNormalMap_transform(out:i64,mode:i64,rgba:i64,normal_matrix:i64,tbn:i64,sx:f64,sy:f64,side:i64) i64 {
  let op=gpu_normal_map_operation(mode);
  if(op<0) { return op; }
  if(out<0 || out%8!=0 || out>6291456-24 || rgba<0 || rgba>4294967295 || (side!=1 && side!=0-1)) { return 0-1; }
  let matrix=normal_matrix;
  if(op==0) { matrix=tbn; }
  if(matrix<0 || matrix%8!=0 || matrix>6291456-72 || (out<matrix+72 && matrix<out+24)) { return 0-1; }
  let x=rgba%256*(2.0/255.0)-1.0;
  let y=rgba/256%256*(2.0/255.0)-1.0;
  let z=rgba/65536%256*(2.0/255.0)-1.0;
  if(op==0) {
    if(sx-sx!=0.0 || sy-sy!=0.0) { return 0-1; }
    x=x*sx;
    y=y*sy;
  } else {
    x=x*side;
    y=y*side;
    z=z*side;
  }
  let vx=ux_f64(matrix)*x+ux_f64(matrix+24)*y+ux_f64(matrix+48)*z;
  let vy=ux_f64(matrix+8)*x+ux_f64(matrix+32)*y+ux_f64(matrix+56)*z;
  let vz=ux_f64(matrix+16)*x+ux_f64(matrix+40)*y+ux_f64(matrix+64)*z;
  let scale=f64_sqrt(vx*vx+vy*vy+vz*vz);
  if(!(scale>0.0) || scale-scale!=0.0) { return 0-3; }
  let a=ux_f64_put(out,vx/scale);
  let b=ux_f64_put(out+8,vy/scale);
  let c=ux_f64_put(out+16,vz/scale);
  return out;
}
