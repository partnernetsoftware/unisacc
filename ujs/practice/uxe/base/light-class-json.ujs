// Structured JSON fields, following the base Fog JSON record convention.
// Zero present fields indicate keys omitted from the three.js light object.
native function Light_toJSON(out:i64,light:i64) i64 {
  let handle=Light_object(light);
  if(handle<0 || light_block(out,LightJson.size)==0) { return 0-1; }
  let arena=ux_u32(light+Light.arena);
  if(light_overlap(out,LightJson.size,light,Light.size)!=0 ||
      light_overlap(out,LightJson.size,arena,light_arena_size(arena))!=0) { return 0-1; }
  let address=Object3D_address(arena,handle);
  let kind=ux_u32(light+Light.kind);
  let at=0;
  while(at<LightJson.size) {
    let clear=ux_u32_put(out+at,0);
    at=at+4;
  }
  let k=kind;
  if(kind==LightKind.LightProbe+1) { k=LightKind.Light+1; }
  let type=ux_u32_put(out+LightJson.kind,k);
  let color=ux_u32_put(out+LightJson.color,Color_getHex(light+Light.color,1));
  let visible=ux_u32_put(out+LightJson.visible,ux_u32(address+Object3D.visible));
  let layers=ux_u32_put(out+LightJson.layers,ux_u32(address+Object3D.layerMask));
  let strength=ux_f64_put(out+LightJson.intensity,ux_f64(light+Light.intensity));
  let fields=out+LightJson.fields;
  if(kind==LightKind.HemisphereLight+1) {
    let present=ux_u8_put(fields+LightJsonField.groundColor,1);
    let ground=ux_u32_put(out+LightJson.groundColor,Color_getHex(light+Light.groundColor,1));
  }
  if(kind==LightKind.PointLight+1 || kind==LightKind.SpotLight+1) {
    let pd=ux_u8_put(fields+LightJsonField.distance,1);
    let pe=ux_u8_put(fields+LightJsonField.decay,1);
    let distance=ux_f64_put(out+LightJson.distance,ux_f64(light+Light.distance));
    let decay=ux_f64_put(out+LightJson.decay,ux_f64(light+Light.decay));
  }
  if(kind==LightKind.SpotLight+1) {
    let pa=ux_u8_put(fields+LightJsonField.angle,1);
    let pp=ux_u8_put(fields+LightJsonField.penumbra,1);
    let angle=ux_f64_put(out+LightJson.angle,ux_f64(light+Light.angle));
    let penumbra=ux_f64_put(out+LightJson.penumbra,ux_f64(light+Light.penumbra));
  }
  if(light_profile(kind,2)!=0) {
    let ps=ux_u8_put(fields+LightJsonField.shadow,1);
    let shadow=uxe_copy_record(out+LightJson.shadow,light+Light.shadow,LightShadowJson.size);
  }
  if(kind==LightKind.RectAreaLight+1) {
    let pz=ux_u8_put(fields+LightJsonField.dimensions,1);
    let width=ux_f64_put(out+LightJson.width,ux_f64(light+Light.width));
    let height=ux_f64_put(out+LightJson.height,ux_f64(light+Light.height));
  }
  if(kind==LightKind.LightProbe+1) {
    let ph=ux_u8_put(fields+LightJsonField.sh,1);
    let sh=uxe_copy_record(out+LightJson.sh,light+Light.sh,LightSH.size);
  }
  return out;
}
