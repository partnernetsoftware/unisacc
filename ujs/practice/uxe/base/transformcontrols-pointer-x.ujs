struct TransformXInput {
  centerX: f64;
  centerY: f64;
  pixelsPerUnit: f64;
  hitStart: f64;
  hitEnd: f64;
  hitRadius: f64;
  snap: f64;
  position: f64;
  startPixel: f64;
  startPosition: f64;
  pointer: u32;
  dragging: u32;
  hover: u32;
  starts: u32;
  moves: u32;
  ends: u32;
}

native function transform_x_valid(state:i64) i64 {
  return state>=0 && state%8==0 && state<=6291456-TransformXInput.size;
}

// A front-facing orthographic view supplies the projected X handle span.
native function TransformControls_initX(state:i64,cx:f64,cy:f64,scale:f64,lo:f64,hi:f64,radius:f64,snap:f64) i64 {
  if(!transform_x_valid(state) || cx-cx!=0.0 || cy-cy!=0.0 || scale<=0.0 || scale-scale!=0.0 ||
     lo<=0.0 || hi<=lo || hi-hi!=0.0 || radius<=0.0 || radius-radius!=0.0 || snap<0.0 || snap-snap!=0.0) { return 0-1; }
  let a=ux_f64_put(state+TransformXInput.centerX,cx);
  let b=ux_f64_put(state+TransformXInput.centerY,cy);
  let c=ux_f64_put(state+TransformXInput.pixelsPerUnit,scale);
  let d=ux_f64_put(state+TransformXInput.hitStart,lo);
  let e=ux_f64_put(state+TransformXInput.hitEnd,hi);
  let f=ux_f64_put(state+TransformXInput.hitRadius,radius);
  let g=ux_f64_put(state+TransformXInput.snap,snap);
  let h=ux_f64_put(state+TransformXInput.position,0.0);
  let i=ux_u32_put(state+TransformXInput.dragging,0);
  let j=ux_u32_put(state+TransformXInput.hover,0);
  let k=ux_u32_put(state+TransformXInput.starts,0);
  let l=ux_u32_put(state+TransformXInput.moves,0);
  let m=ux_u32_put(state+TransformXInput.ends,0);
  return state;
}

native function transform_hit_x(state:i64,x:f64,y:f64) i64 {
  let dx=x-ux_f64(state+TransformXInput.centerX)-
    ux_f64(state+TransformXInput.position)*ux_f64(state+TransformXInput.pixelsPerUnit);
  let dy=y-ux_f64(state+TransformXInput.centerY);
  let r=ux_f64(state+TransformXInput.hitRadius);
  return dx>=ux_f64(state+TransformXInput.hitStart) && dx<=ux_f64(state+TransformXInput.hitEnd) &&
    dy>=0.0-r && dy<=r;
}

// Actions 0..3 are hover, primary down, held move and up/cancel.
native function TransformControls_pointerX(state:i64,action:i64,id:i64,x:f64,y:f64) i64 {
  if(!transform_x_valid(state) || action<0 || action>3 || id<0 || id>4294967295 ||
     x-x!=0.0 || y-y!=0.0) { return 0-1; }
  let running=ux_u32(state+TransformXInput.dragging);
  if(action<=1) {
    if(running) { return 0; }
    let hit=transform_hit_x(state,x,y);
    let hover=ux_u32_put(state+TransformXInput.hover,hit);
    if(!hit || action==0) { return hit; }
    let pointer=ux_u32_put(state+TransformXInput.pointer,id);
    let active=ux_u32_put(state+TransformXInput.dragging,1);
    let start=ux_f64_put(state+TransformXInput.startPixel,x);
    let remembered=ux_f64_put(state+TransformXInput.startPosition,ux_f64(state+TransformXInput.position));
    let count=ux_u32_put(state+TransformXInput.starts,1+ux_u32(state+TransformXInput.starts));
    return 1;
  }
  if(!running || id!=ux_u32(state+TransformXInput.pointer)) { return 0; }
  if(action==3) {
    let stopped=ux_u32_put(state+TransformXInput.dragging,0);
    let clear=ux_u32_put(state+TransformXInput.hover,0);
    let count=ux_u32_put(state+TransformXInput.ends,1+ux_u32(state+TransformXInput.ends));
    return 1;
  }
  let delta=(x-ux_f64(state+TransformXInput.startPixel))/ux_f64(state+TransformXInput.pixelsPerUnit);
  let position=transform_world_axis(ux_f64(state+TransformXInput.startPosition),0.0,0.0,delta,
    ux_f64(state+TransformXInput.snap));
  if(position-position!=0.0) { return 0-1; }
  let saved=ux_f64_put(state+TransformXInput.position,position);
  let count=ux_u32_put(state+TransformXInput.moves,1+ux_u32(state+TransformXInput.moves));
  return 1;
}
