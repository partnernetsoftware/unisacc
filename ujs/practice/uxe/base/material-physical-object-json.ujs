    if(part==3) { return 16; }
    return 0;
  }
  if(row==4) {
    if(part==0) { return 7311146989661023589; }
    if(part==1) { return 8388362698939985481; }
    if(part==2) { return 121; }
    if(part==3) { return 34; }
    return 0;
  }
  if(row==5) {
    if(part==0) { return 7947006580685696613; }
    if(part==1) { return 34186468438992244; }
    if(part==3) { return 30; }
    return 0;
  }
  if(row==6) {
    if(part==0) { return 8030609107581496929; }
    if(part==1) { return 31088; }
    if(part==3) { return 20; }
    return 0;
  }
  if(row==7) {
    if(part==0) { return 8030609107581496929; }
    if(part==1) { return 7598805623992646000; }
    if(part==2) { return 28271; }
    if(part==3) { return 36; }
    return 0;
  }
  if(row==8) {
    if(part==0) { return 7020939687005351011; }
    if(part==1) { return 116; }
    if(part==3) { return 18; }
    return 0;
  }
  if(row==9) {
    if(part==0) { return 7020939687005351011; }
    if(part==1) { return 7308894038830043764; }
    if(part==2) { return 29555; }
    if(part==3) { return 36; }
    return 0;
  }
  if(row==10) {
    if(part==0) { return 7598807758542366066; }
    if(part==1) { return 2037672310; }
    if(part==3) { return 24; }
    return 0;
