// The wire names are packed in little-endian eight-byte words, matching
// the shared Material field codec. Row 25 is the iridescence range array.
native function phys_obj_key(row:i64,part:i64) i64 {
  if(row==0) {
    if(part==0) { return 491495649123; }
    if(part==3) { return 10; }
    return 0;
  }
  if(row==1) {
    if(part==0) { return 8315173681700892530; }
    if(part==1) { return 115; }
    if(part==3) { return 18; }
    return 0;
  }
  if(row==2) {
    if(part==0) { return 8315173698780030317; }
    if(part==1) { return 115; }
    if(part==3) { return 18; }
