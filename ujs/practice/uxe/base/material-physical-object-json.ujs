native function phys_obj_json_spans(at:i64,end:i64,obj:i64,scratch:i64) i64 {
  return phys_obj_valid(obj) && at>=0 && end>at && end<=6291456 &&
    scratch>=0 && scratch%8==0 && scratch<=6291456-1104 &&
    phys_obj_disjoint(at,end-at,obj,PhysicalObject_size()) &&
    phys_obj_disjoint(at,end-at,scratch,1104) &&
    phys_obj_disjoint(scratch,1104,obj,PhysicalObject_size());
}

native function phys_obj_write_range(p:i64,end:i64,fields:i64,scratch:i64) i64 {
  let prefix=[44,34,105,114,105,100,101,115,99,101,110,99,101,84,104,105,99,107,110,101,115,115,82,97,110,103,101,34,58,91];
  let i=0;
  while(i<30) {
    p=json_byte(p,end,prefix[i]);
    i=i+1;
  }
  p=json_write_f64(p,end,ux_f64(fields+PhysicalObjectFields.size+PhysicalObjectVolume.iridescenceMin),scratch);
  p=json_byte(p,end,44);
  p=json_write_f64(p,end,ux_f64(fields+PhysicalObjectFields.size+PhysicalObjectVolume.iridescenceMax),scratch);
  return json_byte(p,end,93);
}

native function PhysicalObject_writeJSON(at:i64,end:i64,obj:i64,scratch:i64) i64 {
  if(!phys_obj_json_spans(at,end,obj,scratch) || end-at<30) { return 0-1; }
  let fields=obj+Material.size;
  let i=0;
  while(i<27) {
    if(!phys_obj_value_valid(i,ux_f64(fields+i*8))) { return 0-1; }
    i=i+1;
  }
  let prefix=[123,34,116,121,112,101,34,58,34,77,101,115,104,80,104,121,115,105,99,97,108,77,97,116,101,114,105,97,108,34];
  i=0;
  while(i<30) {
    let saved=ux_u8_put(at+i,prefix[i]);
    i=i+1;
  }
  let p=Material_writeFields(at+30,end,obj,scratch);
  i=0;
  while(p>=0 && i<25) {
    let value=ux_f64(fields+i*8);
    let role=phys_obj_role(i);
    let encode=1;
    if(role==2 && value==phys_obj_default(i)) { encode=0; }
    if(role==4 && value==1.0/0.0) { encode=0; }
    if(role==5 && (value==0.0 || value==1.0)) { encode=0; }
    if(encode) {
      p=material_json_field(p,end,phys_obj_key(i,0),phys_obj_key(i,1),phys_obj_key(i,2),
        phys_obj_key(i,3)+(role==2),value,scratch);
    }
    i=i+1;
  }
  p=phys_obj_write_range(p,end,fields,scratch);
  return json_byte(p,end,125);
}

native function phys_obj_match_type(input:i64,end:i64,scratch:i64) i64 {
  let key=ux_u32_put(scratch,1701869940);
  let value=json_find_key(input,end,scratch,4);
  let expected=[77,101,115,104,80,104,121,115,105,99,97,108,77,97,116,101,114,105,97,108];
  if(value<0 || Json_decodeString(value,end,scratch,20)!=20) { return 0; }
  let i=0;
  while(i<20) {
    if(ux_u8(scratch+i)!=expected[i]) { return 0; }
    i=i+1;
  }
  return 1;
}

native function phys_obj_read_range(at:i64,end:i64,staged:i64) i64 {
  if(at<0 || ux_u8(at)!=91) { return 0; }
  let p=json_space(at+1,end);
  let lo=json_read_number(p,end);
  p=json_space(json_scalar_end(p,end),end);
  if(p<0 || p>=end || ux_u8(p)!=44) { return 0; }
  p=json_space(p+1,end);
  let hi=json_read_number(p,end);
  p=json_space(json_scalar_end(p,end),end);
  if(p<0 || p>=end || ux_u8(p)!=93 || lo-lo!=0.0 || hi-hi!=0.0) { return 0; }
  let min=ux_f64_put(staged+200,lo);
  let max=ux_f64_put(staged+208,hi);
  return 1;
}

native function phys_obj_field_row(at:i64,keyBytes:i64) i64 {
  let row=0;
  while(row<26) {
    let size=phys_obj_key(row,3);
    if(row==25) { size=50; }
    if(size==keyBytes*2) {
      let i=0;
      let word=0;
      let same=1;
      while(i<keyBytes && same) {
        if(i%8==0) { word=phys_obj_key(row,i/8); }
        same=ux_u8(at+i)==word%256;
        word=word/256;
        i=i+1;
      }
      if(same) { return row; }
    }
    row=row+1;
  }
  return 0-1;
}

native function phys_obj_stage(input:i64,end:i64,staged:i64) i64 {
  let i=0;
  while(i<27) {
    let fallback=ux_f64_put(staged+i*8,phys_obj_default(i));
    i=i+1;
  }
  let p=json_space(input+1,end);
  while(p<end && ux_u8(p)!=125) {
    let keyEnd=json_scan_string(p,end);
    if(keyEnd<0) { return 0; }
    let row=phys_obj_field_row(p+1,keyEnd-p-2);
    let at=json_space(json_space(keyEnd,end)+1,end);
    let next=json_value_end(at,end);
    if(next<0) { return 0; }
    if(row==25) {
      if(!phys_obj_read_range(at,next,staged)) { return 0; }
    } else if(row>=0) {
      let value=0.0/0.0;
      if(phys_obj_role(row)==2) {
        if(ux_u8(at)==116 && next-at==4) { value=1.0; }
        else if(ux_u8(at)==102 && next-at==5) { value=0.0; }
      } else {
        value=json_read_number(at,next);
      }
      if(!phys_obj_value_valid(row,value)) { return 0; }
      let stored=ux_f64_put(staged+row*8,value);
    }
    p=json_space(next,end);
    if(ux_u8(p)==44) { p=json_space(p+1,end); }
  }
  return 1;
}

native function PhysicalObject_readJSON(input:i64,end:i64,obj:i64,scratch:i64) i64 {
  if(!phys_obj_json_spans(input,end,obj,scratch)) { return 0-1; }
  let start=json_space(input,end);
  let finish=json_value_end(start,end);
  if(finish<0 || json_space(finish,end)!=end || !phys_obj_match_type(start,finish,scratch)) { return 0-1; }
  let staged=scratch+256;
  if(!phys_obj_stage(start,finish,staged)) { return 0-1; }
  let fields=obj+Material.size;
  let changes=0;
  let i=0;
  while(i<25) {
    if(phys_obj_role(i)==1 && (ux_f64(fields+i*8)>0.0)!=(ux_f64(staged+i*8)>0.0)) { changes=changes+1; }
    i=i+1;
  }
  let alpha=material_json_read(start,finish,scratch,8315145064350248033,116,0,18,0.0);
  let alphaChanges=(ux_f64(obj+Material.alphaTest)>0.0)!=(alpha>0.0);
  if(ux_u32(obj+Material.version)+changes+alphaChanges>4294967295) { return 0-2; }
  let base=Material_readFields(start,finish,obj,scratch);
  if(base<0) { return base; }
  let version=ux_u32_put(obj+Material.version,ux_u32(obj+Material.version)+changes);
  let published=uxe_copy_record(fields,staged,PhysicalObjectFields.size+PhysicalObjectVolume.size);
  return obj;
}
