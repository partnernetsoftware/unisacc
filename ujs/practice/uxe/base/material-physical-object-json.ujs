  if(row==11) {
    if(part==0) { return 7305809899838599785; }
    if(part==1) { return 6644590; }
    if(part==3) { return 22; }
    return 0;
  }
  if(row==12) {
    if(part==0) { return 7305809899838599785; }
    if(part==1) { return 90500487275374; }
    if(part==3) { return 28; }
    return 0;
  }
  if(row==13) {
    if(part==0) { return 474147547251; }
    if(part==3) { return 10; }
    return 0;
  }
  if(row==14) {
    if(part==0) { return 7813538019937708147; }
    if(part==1) { return 29295; }
    if(part==3) { return 20; }
    return 0;
  }
  if(row==15) {
    if(part==0) { return 8462072858953476211; }
    if(part==1) { return 126939460167783; }
    if(part==3) { return 28; }
    return 0;
  }
  if(row==16) {
    if(part==0) { return 8316298529456878196; }
    if(part==1) { return 1852795251; }
    if(part==3) { return 24; }
    return 0;
  }
  if(row==17) {
    if(part==0) { return 8315173694517897332; }
    if(part==1) { return 115; }
    if(part==3) { return 18; }
    return 0;
  }
  if(row==18) {
    if(part==0) { return 8386113098149557345; }
    if(part==1) { return 7022364614934294377; }
    if(part==2) { return 6644590; }
    if(part==3) { return 38; }
    return 0;
  }
  if(row==19) {
    if(part==0) { return 8386113098149557345; }
    if(part==1) { return 8245928667867148137; }
    if(part==3) { return 32; }
    return 0;
  }
  if(row==20) {
    if(part==0) { return 8241988044499284083; }
    if(part==1) { return 8388362698939985481; }
    if(part==2) { return 121; }
    if(part==3) { return 34; }
