// The caller keeps the f64 Vector2 pairs alive and immutable for the object lifetime.
struct LatheGeometryParameters {
  segments: f64;
  phiStart: f64;
  phiLength: f64;
}

native function LatheGeometry_create(at:i64,raw:i64,arena:i64,bytes:i64,profile:i64,count:i64,params:i64) i64 {
  if(params%8!=0 || profile%8!=0 || count<2 || count>393216 ||
     !geometry_primitive_raw(at,raw,arena,bytes,params,LatheGeometryParameters.size) ||
     !geometry_primitive_raw(at,raw,arena,bytes,profile,count*16) ||
     !geometry_public_disjoint(params,LatheGeometryParameters.size,profile,count*16)) { return 0-1; }
  let segments=ux_f64(params+LatheGeometryParameters.segments);
  let start=ux_f64(params+LatheGeometryParameters.phiStart);
  let length=ux_f64(params+LatheGeometryParameters.phiLength);
  if(!(segments>=1.0 && segments<262145.0) || start-start!=0.0 || length-length!=0.0) { return 0-1; }
  // Largest finite f32, expressed without an exponent literal.
  let word=4294967296.0;
  let maxFloat=word*word*word*word*(1.0-1.0/16777216.0);
  let i=0;
  while(i<count*2) {
    let value=ux_f64(profile+8*i);
    if(!(value>=0.0-maxFloat && value<=maxFloat)) { return 0-1; }
    i=i+1;
  }
  let generated=LatheGeometry_generate(raw,profile,count,f64_floor_i64(segments),start,length);
  if(generated<0) { return generated; }
  let installed=GeometryBuffers_asGeometry(raw,GeometryPrimitive_geometry(at),arena,bytes,7,0,0);
  if(installed<0) { return installed; }
  return geometry_primitive_store(at,14,segments,start,length,0.0+profile,0.0+count,0.0);
}
