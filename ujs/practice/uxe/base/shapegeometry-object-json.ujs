native function sg_word(at:i64,end:i64,word:i64,size:i64) i64 {
  if(at<0 || size>end-at) { return 0-1; }
  let i=0;
  while(i<size) {
    let saved=ux_u8_put(at+i,word%256);
    word=word/256;
    i=i+1;
  }
  return at+size;
}

native function sg_token(at:i64,end:i64,key:i64) i64 {
  // {"geometries":[{"uuid":
  if(key==0) {
    at=sg_word(at,end,8387230206257472123,8);
    at=sg_word(at,end,8888762209185130866,8);
    return sg_word(at,end,16363363310597410,7);
  }
  // ,"type":"ShapeGeometry","curveSegments":
  if(key==1) {
    at=sg_word(at,end,4189022137156379180,8);
    at=sg_word(at,end,7297913254522147618,8);
    at=sg_word(at,end,3180237819363028335,8);
    at=sg_word(at,end,7301290980298548002,8);
    return sg_word(at,end,4189037547313524071,8);
  }
  // ,"shapes":[
  if(key==2) {
    at=sg_word(at,end,8315175850676003372,8);
    return sg_word(at,end,5978658,3);
  }
  // ]}],"shapes":[{
  if(key==3) {
    at=sg_word(at,end,7018986609867324765,8);
    return sg_word(at,end,34721727379629424,7);
  }
  // "arcLengthDivisions":200,"type":"Shape","autoClose":false,"curves":[
  if(key==4) {
    at=sg_word(at,end,7453005812105109794,8);
    at=sg_word(at,end,7598532953597306996,8);
    at=sg_word(at,end,3472330537970134639,8);
    at=sg_word(at,end,4189022137156379180,8);
    at=sg_word(at,end,3180215820221960994,8);
    at=sg_word(at,end,8028866381669032226,8);
    at=sg_word(at,end,8317129703536354675,8);
    at=sg_word(at,end,7311156893582503013,8);
    return sg_word(at,end,1530536563,4);
  }
  // {"metadata":{"version":4.6,"type":"Curve","generator":"Curve.toJSON"},"arcLengthDivisions":200,"type":"Path","autoClose":false,"curves":[
  if(key==5) {
    at=sg_word(at,end,7017841271895827067,8);
    at=sg_word(at,end,7311068957734232436,8);
    at=sg_word(at,end,3763358296332399474,8);
    at=sg_word(at,end,7309475734918805038,8);
    at=sg_word(at,end,7311156893045635618,8);
    at=sg_word(at,end,8243116074772605986,8);
    at=sg_word(at,end,4837492869372540001,8);
    at=sg_word(at,end,5363633423841129077,8);
    at=sg_word(at,end,6999205686845263699,8);
    at=sg_word(at,end,7526754601086509938,8);
    at=sg_word(at,end,7957695010998479172,8);
    at=sg_word(at,end,2462396079824052851,8);
    at=sg_word(at,end,5774241591647566196,8);
    at=sg_word(at,end,8458079148129678433,8);
    at=sg_word(at,end,2478514092332248948,8);
    at=sg_word(at,end,2462454642678785594,8);
    at=sg_word(at,end,4189037483024086371,8);
    return sg_word(at,end,91,1);
  }
  // {"metadata":{"version":4.6,"type":"Curve","generator":"Curve.toJSON"},"arcLengthDivisions":200,"type":"LineCurve","v1":
  if(key==6) {
    at=sg_word(at,end,7017841271895827067,8);
    at=sg_word(at,end,7311068957734232436,8);
    at=sg_word(at,end,3763358296332399474,8);
    at=sg_word(at,end,7309475734918805038,8);
    at=sg_word(at,end,7311156893045635618,8);
    at=sg_word(at,end,8243116074772605986,8);
    at=sg_word(at,end,4837492869372540001,8);
    at=sg_word(at,end,5363633423841129077,8);
    at=sg_word(at,end,6999205686845263699,8);
    at=sg_word(at,end,7526754601086509938,8);
    at=sg_word(at,end,7957695010998479172,8);
    at=sg_word(at,end,2462396079824052851,8);
    at=sg_word(at,end,5486011215495854452,8);
    at=sg_word(at,end,7311156893050039913,8);
    return sg_word(at,end,16363144479910946,7);
  }
  // ,"v2":
  if(key==7) {
    return sg_word(at,end,63918549901868,6);
  }
  // ],"currentPoint":
  if(key==8) {
    at=sg_word(at,end,7310030993675660381,8);
    at=sg_word(at,end,2482730693706151022,8);
    return sg_word(at,end,58,1);
  }
  // ,"uuid":
  if(key==9) {
    return sg_word(at,end,4189021007512937004,8);
  }
  // ,"holes":[
  if(key==10) {
    at=sg_word(at,end,2482439336011244076,8);
    return sg_word(at,end,23354,2);
  }
  // ]}]}
  if(key==11) {
    return sg_word(at,end,2103278941,4);
  }
  return 0-1;
}

native function sg_uuid(at:i64) i64 {
  let i=0;
  while(i<36) {
    let c=ux_u8(at+i);
    if(i==8 || i==13 || i==18 || i==23) {
      if(c!=45) { return 0; }
    } else if(!(c>=48 && c<=57) && !(c>=97 && c<=102)) { return 0; }
    i=i+1;
  }
  return 1;
}

native function sg_same_bytes(a:i64,b:i64,n:i64) i64 {
  let i=0;
  while(i<n) {
    if(ux_u8(a+i)!=ux_u8(b+i)) { return 0; }
    i=i+1;
  }
  return 1;
}

native function sg_write_xy(p:i64,end:i64,point:i64,scratch:i64) i64 {
  p=json_byte(p,end,91);
  p=json_write_f64(p,end,ux_f64(point),scratch);
  p=json_byte(p,end,44);
  p=json_write_f64(p,end,ux_f64(point+8),scratch);
  return json_byte(p,end,93);
}

native function sg_write_ring(p:i64,end:i64,ring:i64,n:i64,scratch:i64) i64 {
  let i=0;
  while(i<n && p>=0) {
    if(i!=0) { p=json_byte(p,end,44); }
    p=sg_token(p,end,6);
    p=sg_write_xy(p,end,ring+i*16,scratch);
    p=sg_token(p,end,7);
    p=sg_write_xy(p,end,ring+((i+1)%n)*16,scratch);
    p=json_byte(p,end,125);
    i=i+1;
  }
  p=sg_token(p,end,8);
  return sg_write_xy(p,end,ring,scratch);
}

native function ShapeGeometry_toJSON(record:i64,dst:i64,end:i64,scratch:i64) i64 {
  if(end<=dst || !sg_json_storage(record,dst,end-dst,scratch,1104)) { return 0-1; }
  let rings=ux_u32(record+ShapeGeometryJson.rings);
  let segments=ux_u32(record+ShapeGeometryJson.curveSegments);
  let gid=ux_u32(record+ShapeGeometryJson.geometryId);
  let sid=ux_u32(record+ShapeGeometryJson.shapeId);
  if(rings<1 || rings>5 || segments<1 || segments>4096 || !sg_uuid(gid) || !sg_uuid(sid)) { return 0-1; }
  let n=sg_json_count(record);
  if(n<3) { return 0-1; }
  let counts=ux_u32(record+ShapeGeometryJson.ringCounts);
  let points=ux_u32(record+ShapeGeometryJson.points);
  let i=0;
  while(i<n*2) {
    let value=ux_f64(points+i*8);
    if(!sg_json_coord_valid(value)) { return 0-1; }
    i=i+1;
  }
  let p=sg_token(dst,end,0);
  p=json_write_string(p,end,gid,36);
  p=sg_token(p,end,1);
  p=json_write_f64(p,end,0.0+segments,scratch);
  p=sg_token(p,end,2);
  p=json_write_string(p,end,sid,36);
  p=sg_token(p,end,3);
  p=sg_token(p,end,4);
  p=sg_write_ring(p,end,points,ux_u32(counts),scratch);
  p=sg_token(p,end,9);
  p=json_write_string(p,end,sid,36);
  p=sg_token(p,end,10);
  let off=ux_u32(counts);
  i=1;
  while(i<rings && p>=0) {
    if(i>1) { p=json_byte(p,end,44); }
    p=sg_token(p,end,5);
    let size=ux_u32(counts+i*4);
    p=sg_write_ring(p,end,points+off*16,size,scratch);
    p=json_byte(p,end,125);
    off=off+size;
    i=i+1;
  }
  return sg_token(p,end,11);
}

// The enclosing document already passed the shared JSON grammar scanner.
// Skip nested values here without allocating a boxed parser stack per key.
native function sg_value_end(at:i64,end:i64) i64 {
  if(at<0 || at>=end) { return 0-1; }
  let first=ux_u8(at);
  if(first==34) { return json_scan_string(at,end); }
  if(first!=123 && first!=91) { return json_scalar_end(at,end); }
  let p=at;
  let depth=0;
  while(p>=0 && p<end) {
    let c=ux_u8(p);
    if(c==34) { p=json_scan_string(p,end); }
    else {
      if(c==123 || c==91) { depth=depth+1; }
      if(c==125 || c==93) { depth=depth-1; }
      p=p+1;
      if(depth==0) { return p; }
    }
  }
  return 0-1;
}

native function sg_find(at:i64,end:i64,scratch:i64,first:i64,second:i64,size:i64) i64 {
  let prefix=size;
  if(size>8) { prefix=8; }
  let p=sg_word(scratch,scratch+16,first,prefix);
  if(size>8) { p=sg_word(p,scratch+16,second,size-8); }
  p=json_space(at,end);
  if(p<0 || p>=end || ux_u8(p)!=123) { return 0-1; }
  p=json_space(p+1,end);
  while(p>=0 && p<end && ux_u8(p)==34) {
    let close=json_scan_string(p,end);
    let colon=json_space(close,end);
    if(colon<0 || colon>=end || ux_u8(colon)!=58) { return 0-1; }
    let value=json_space(colon+1,end);
    if(close-p==size+2 && sg_same_bytes(p+1,scratch,size)) { return value; }
    let tail=json_space(sg_value_end(value,end),end);
    if(tail<0 || tail>=end || ux_u8(tail)!=44) { return 0-1; }
    p=json_space(tail+1,end);
  }
  return 0-1;
}

native function sg_only_item(at:i64,end:i64) i64 {
  if(at<0 || ux_u8(at)!=91) { return 0-1; }
  let p=json_space(at+1,end);
  let next=sg_value_end(p,end);
  if(next<0) { return 0-1; }
  let close=json_space(next,end);
  if(close<0 || close>=end || ux_u8(close)!=93) { return 0-1; }
  return p;
}

native function sg_read_id(at:i64,end:i64,out:i64) i64 {
  if(at<0 || json_scan_string(at,end)!=at+38 || !sg_uuid(at+1)) { return 0; }
  let copied=uxe_copy_record(out,at+1,36);
  return 1;
}

native function sg_type(at:i64,end:i64,scratch:i64,token0:i64,token1:i64,size:i64) i64 {
  let value=sg_find(at,end,scratch,1701869940,0,4);
  if(value<0 || json_scan_string(value,end)!=value+size+2) { return 0; }
  let first=size;
  if(size>8) { first=8; }
  let p=sg_word(scratch,scratch+16,token0,first);
  if(size>8) { p=sg_word(p,scratch+16,token1,size-8); }
  return sg_same_bytes(value+1,scratch,size);
}

native function sg_read_xy(at:i64,end:i64,point:i64) i64 {
  if(at<0 || ux_u8(at)!=91) { return 0; }
  let p=json_space(at+1,end);
  let x=json_read_number(p,end);
  p=json_space(json_scalar_end(p,end),end);
  if(p<0 || p>=end || ux_u8(p)!=44) { return 0; }
  p=json_space(p+1,end);
  let y=json_read_number(p,end);
  p=json_space(json_scalar_end(p,end),end);
  if(p<0 || p>=end || ux_u8(p)!=93 || !sg_json_coord_valid(x) || !sg_json_coord_valid(y)) { return 0; }
  let a=ux_f64_put(point,x);
  let b=ux_f64_put(point+8,y);
  return 1;
}

native function sg_read_ring(at:i64,end:i64,points:i64,capacity:i64,scratch:i64) i64 {
  let arrayAt=sg_find(at,end,scratch,126879616103779,0,6);
  if(arrayAt<0 || ux_u8(arrayAt)!=91) { return 0-1; }
  let p=json_space(arrayAt+1,end);
  let i=0;
  let last=scratch+752;
  while(p>=0 && p<end && ux_u8(p)==123 && i<capacity) {
    let finish=sg_value_end(p,end);
    if(finish<0 || !sg_type(p,finish,scratch,8535013176145504588,101,9)) { return 0-1; }
    let start=sg_find(p,finish,scratch,12662,0,2);
    let target=sg_find(p,finish,scratch,12918,0,2);
    let point=points+i*16;
    if(!sg_read_xy(start,finish,point) || (i!=0 && !shape_same_point(last,point)) ||
       !sg_read_xy(target,finish,last) || shape_same_point(last,point)) { return 0-1; }
    i=i+1;
    p=json_space(finish,end);
    if(p<0 || p>=end) { return 0-1; }
    if(ux_u8(p)==93) {
      if(!shape_same_point(points,last)) {
        if(i>=capacity) { return 0-1; }
        let close=uxe_copy_record(points+i*16,last,16);
        i=i+1;
      }
      if(i<3) { return 0-1; }
      return i;
    }
    if(ux_u8(p)!=44) { return 0-1; }
    p=json_space(p+1,end);
  }
  return 0-1;
}

native function sg_read_holes(at:i64,end:i64,points:i64,capacity:i64,total:i64,scratch:i64) i64 {
  let arrayAt=sg_find(at,end,scratch,495622844264,0,5);
  if(arrayAt<0 || ux_u8(arrayAt)!=91) { return 0-1; }
  let p=json_space(arrayAt+1,end);
  if(ux_u8(p)==93) { return 1; }
  let ring=1;
  while(ring<5 && p>=0 && p<end) {
    let finish=sg_value_end(p,end);
    if(finish<0 || !sg_type(p,finish,scratch,1752457552,0,4)) { return 0-1; }
    let measured=sg_read_ring(p,finish,points+total*16,capacity-total,scratch);
    if(measured<0) { return measured; }
    let saved=ux_u32_put(scratch+640+ring*4,measured);
    total=total+measured;
    ring=ring+1;
    p=json_space(finish,end);
    if(p<0 || p>=end) { return 0-1; }
    if(ux_u8(p)==93) { return ring; }
    if(ux_u8(p)!=44) { return 0-1; }
    p=json_space(p+1,end);
  }
  return 0-1;
}

native function ShapeGeometry_fromJSON(record:i64,input:i64,end:i64,scratch:i64) i64 {
  if(end<=input || end-input>16384 || !sg_json_storage(record,input,end-input,scratch,1104)) { return 0-1; }
  let start=json_space(input,end);
  let doc=json_value_end(start,end);
  if(doc<0 || json_space(doc,end)!=end) { return 0-1; }
  let geo=sg_only_item(sg_find(start,doc,scratch,7598263500303983975,29541,10),doc);
  let shape=sg_only_item(sg_find(start,doc,scratch,126879514323059,0,6),doc);
  if(geo<0 || shape<0) { return 0-1; }
  let geoEnd=sg_value_end(geo,doc);
  let shapeEnd=sg_value_end(shape,doc);
  if(!sg_type(geo,geoEnd,scratch,8026900411860478035,521611273581,13) ||
     !sg_type(shape,shapeEnd,scratch,435677128787,0,5)) { return 0-1; }
  let gid=sg_find(geo,geoEnd,scratch,1684632949,0,4);
  let sid=sg_find(shape,shapeEnd,scratch,1684632949,0,4);
  let ref=sg_only_item(sg_find(geo,geoEnd,scratch,126879514323059,0,6),geoEnd);
  if(!sg_read_id(gid,geoEnd,scratch+672) || !sg_read_id(sid,shapeEnd,scratch+712) ||
     ref<0 || json_scan_string(ref,geoEnd)!=ref+38 || !sg_same_bytes(ref+1,scratch+712,36)) { return 0-1; }
  let seg=sg_find(geo,geoEnd,scratch,7450452853798368611,495874631021,13);
  let divisions=json_read_number(seg,geoEnd);
  if(!(divisions>=1.0 && divisions<=4096.0)) { return 0-1; }
  let segments=f64_floor_i64(divisions);
  if(divisions!=segments) { return 0-1; }
  let capacity=ux_u32(record+ShapeGeometryJson.capacity);
  let points=scratch+128;
  let outer=sg_read_ring(shape,shapeEnd,points,capacity,scratch);
  if(outer<0) { return outer; }
  let first=ux_u32_put(scratch+640,outer);
  let rings=sg_read_holes(shape,shapeEnd,points,capacity,outer,scratch);
  if(rings<0) { return rings; }
  let i=0;
  let total=0;
  while(i<rings) {
    total=total+ux_u32(scratch+640+i*4);
    i=i+1;
  }
  let coords=uxe_copy_record(ux_u32(record+ShapeGeometryJson.points),points,total*16);
  let counts=uxe_copy_record(ux_u32(record+ShapeGeometryJson.ringCounts),scratch+640,rings*4);
  let savedGeo=uxe_copy_record(ux_u32(record+ShapeGeometryJson.geometryId),scratch+672,36);
  let savedShape=uxe_copy_record(ux_u32(record+ShapeGeometryJson.shapeId),scratch+712,36);
  let count=ux_u32_put(record+ShapeGeometryJson.rings,rings);
  let divisionsSaved=ux_u32_put(record+ShapeGeometryJson.curveSegments,segments);
  return record;
}
