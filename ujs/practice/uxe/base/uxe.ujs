import host_input_read from "env"() i64;
import host_frame_present from "env"(i64, i64, i64) i64;
import host_asset_read from "env"(i64, i64, i64) i64;
import host_audio_write from "env"(i64, i64) i64;
import host_time from "env"() f64;
export uxe_dispatch(op:i64, a:i64, b:i64) i64 version 1;

persist let width = 0;
persist let height = 0;
let pixels = width * height;

if (op == 0) {
  return host_input_read();
}
if (op == 1) {
  if (a < 1 || b < 1 || a > 4096 || b > 4096) { return 0 - 1; }
  if (a * b > 1048576) { return 0 - 1; }
  width = a;
  height = b;
  return width * height;
}
if (op == 2 || op == 9) {
  if (b < 0 || b > 4294967295 || pixels == 0) { return 0 - 1; }
  let start = 0;
  let end = pixels;
  if (op == 2) {
    if (a < 0 || a >= pixels) { return 0 - 1; }
    start = a;
    end = a + 1;
  }
  let red = b % 256;
  let green = (b / 256) % 256;
  let blue = (b / 65536) % 256;
  let alpha = b / 16777216;
  while (start < end) {
    let at = start * 4;
    let r = ux_u8_put(at, red);
    let g = ux_u8_put(at + 1, green);
    let u = ux_u8_put(at + 2, blue);
    let t = ux_u8_put(at + 3, alpha);
    start = start + 1;
  }
  return 0;
}
if (op == 3) {
  if (pixels == 0) { return 0 - 1; }
  return host_frame_present(ux_span(0, pixels * 4), width, height);
}
if (op == 4) {
  if (a < 0 || b < 0 || b > 1048576) { return 0 - 1; }
  return host_asset_read(a, ux_span(4194304, b), b);
}
if (op == 5) {
  if (a < 0 || a >= 48000 || b < 0 - 32768 || b > 32767) { return 0 - 1; }
  let sample = ux_f32_put(5242880 + a * 4, b / 32768.0);
  return 0;
}
if (op == 6) {
  if (a < 1 || a > 48000) { return 0 - 1; }
  return host_audio_write(ux_span(5242880, a * 4), a);
}
if (op == 7) {
  let micros = 0;
  micros = host_time() * 1000.0;
  return micros;
}
if (op == 8) {
  if (a < 0 || a >= 1048576) { return 0 - 1; }
  return ux_u8(4194304 + a);
}
return 0 - 1;
