import host_input_read from "env"() i64;
import host_frame_present from "env"(i64, i64, i64) i64;
import host_asset_read from "env"(i64, i64, i64) i64;
import host_audio_write from "env"(i64, i64) i64;
import host_time from "env"() f64;
export uxe_dispatch(op:i64, a:i64, b:i64) i64 version 1;

persist let width = 0;
persist let height = 0;
persist let assetReadBytes = 0;
let pixels = width * height;

if (op == 0) {
  return host_input_read();
}
if (op == 1) {
  if (a < 1 || b < 1 || a > 4096 || b > 4096) { return 0 - 1; }
  if (a * b > 1048576) { return 0 - 1; }
  width = a;
  height = b;
  return width * height;
}
if (op == 2 || op == 9 || op == 10 || op == 11) {
  if (b < 0 || b > 4294967295 || pixels == 0) { return 0 - 1; }
  let start = 0;
  let end = pixels;
  let stride = 1;
  if (op == 2) {
    if (a < 0 || a >= pixels) { return 0 - 1; }
    start = a;
    end = a + 1;
  }
  if (op == 10 || op == 11) {
    if (a < 0 || a >= 68719476736) { return 0 - 1; }
    let column = a % 4096;
    let row = (a / 4096) % 4096;
    let lastPixel = a / 16777216;
    if (column >= width || row >= height) { return 0 - 1; }
    start = row * width + column;
    if (op == 10) {
      if (lastPixel < row || lastPixel >= height) { return 0 - 1; }
      stride = width;
      end = (lastPixel + 1) * width + column;
    } else {
      if (lastPixel < column || lastPixel >= width) { return 0 - 1; }
      end = row * width + lastPixel + 1;
    }
  }
  let red = b % 256;
  let green = (b / 256) % 256;
  let blue = (b / 65536) % 256;
  let alpha = b / 16777216;
  while (start < end) {
    let at = start * 4;
    let r = ux_u8_put(at, red);
    let g = ux_u8_put(at + 1, green);
    let u = ux_u8_put(at + 2, blue);
    let t = ux_u8_put(at + 3, alpha);
    start = start + stride;
  }
  return 0;
}
if (op == 3) {
  if (pixels == 0) { return 0 - 1; }
  return host_frame_present(ux_span(0, pixels * 4), width, height);
}
if (op == 4) {
  if (a < 0 || b < 0 || b > 1048576) { return 0 - 1; }
  assetReadBytes = host_asset_read(a, ux_span(4194304, b), b);
  return assetReadBytes;
}
if (op == 5) {
  if (a < 0 || a >= 48000 || b < 0 - 32768 || b > 32767) { return 0 - 1; }
  let sample = ux_f32_put(5242880 + a * 4, b / 32768.0);
  return 0;
}
if (op == 6) {
  if (a < 1 || a > 48000) { return 0 - 1; }
  return host_audio_write(ux_span(5242880, a * 4), a);
}
if (op == 7) {
  let micros = 0;
  micros = host_time() * 1000.0;
  return micros;
}
if (op == 8) {
  if (a < 0 || a >= 1048576) { return 0 - 1; }
  return ux_u8(4194304 + a);
}
// Draw an RGBA asset from the resource buffer, rotated about its center.
if (op == 12) {
  if (a < 0 || a >= 281474976710656 || b < 0 - 1570 || b > 1570 || pixels == 0) { return 0 - 1; }
  let centerX = a % 4096;
  let centerY = (a / 4096) % 4096;
  let assetWidth = (a / 16777216) % 4096;
  let assetHeight = a / 68719476736;
  if (assetWidth < 1 || assetHeight < 1 || assetWidth * assetHeight * 4 > assetReadBytes) { return 0 - 1; }
  let rot = b / 1000.0;
  let rot2 = rot * rot;
  let sine = rot * (1.0 - rot2 / 6.0 + rot2 * rot2 / 120.0 - rot2 * rot2 * rot2 / 5040.0);
  let cosine = 1.0 - rot2 / 2.0 + rot2 * rot2 / 24.0 - rot2 * rot2 * rot2 / 720.0;
  let assetY = 0;
  while (assetY < assetHeight) {
    let assetX = 0;
    while (assetX < assetWidth) {
      let sourcePixel = 4194304 + 4 * (assetY * assetWidth + assetX);
      if (ux_u8(sourcePixel + 3) == 255) {
        let localX = assetX - assetWidth / 2;
        let localY = assetY - assetHeight / 2;
        let drawX = f64_floor_i64(centerX + 0.5 + localX * cosine - localY * sine);
        let drawY = f64_floor_i64(centerY + 0.5 + localX * sine + localY * cosine);
        if (drawX >= 0 && drawX < width && drawY >= 0 && drawY < height) {
          let targetPixel = (drawY * width + drawX) * 4;
          let wroteR = ux_u8_put(targetPixel, ux_u8(sourcePixel));
          let wroteG = ux_u8_put(targetPixel + 1, ux_u8(sourcePixel + 1));
          let wroteB = ux_u8_put(targetPixel + 2, ux_u8(sourcePixel + 2));
          let wroteA = ux_u8_put(targetPixel + 3, 255);
        }
      }
      assetX = assetX + 1;
    }
    assetY = assetY + 1;
  }
  return 0;
}
// A filled rectangle or a 3 x 5 bitmap glyph, including the decimal atlas.
if (op == 13 || op == 14) {
  if (a < 0 || a >= 281474976710656 || b < 0 || b > 4294967295 || pixels == 0) { return 0 - 1; }
  let inkX = a % 4096;
  let inkY = (a / 4096) % 4096;
  let inkW = (a / 16777216) % 4096;
  let inkH = a / 68719476736;
  let inkMask = a / 16777216;
  if (op == 14) {
    if (inkMask > 32777) { return 0 - 1; }
    if (inkMask == 32768) { inkMask = 31599; }
    if (inkMask == 32769) { inkMask = 29850; }
    if (inkMask == 32770) { inkMask = 29671; }
    if (inkMask == 32771) { inkMask = 31207; }
    if (inkMask == 32772) { inkMask = 18925; }
    if (inkMask == 32773) { inkMask = 31183; }
    if (inkMask == 32774) { inkMask = 31694; }
    if (inkMask == 32775) { inkMask = 9383; }
    if (inkMask == 32776) { inkMask = 31727; }
    if (inkMask == 32777) { inkMask = 14831; }
    inkW = 3;
    inkH = 5;
  }
  if (inkW < 1 || inkH < 1 || inkX + inkW > width || inkY + inkH > height) { return 0 - 1; }
  let inkR = b % 256;
  let inkG = (b / 256) % 256;
  let inkB = (b / 65536) % 256;
  let inkA = b / 16777216;
  let inkRow = 0;
  while (inkRow < inkH) {
    let inkCol = 0;
    while (inkCol < inkW) {
      if (op == 13 || inkMask % 2 == 1) {
        let inkPixel = ((inkY + inkRow) * width + inkX + inkCol) * 4;
        let inkOutR = ux_u8_put(inkPixel, inkR);
        let inkOutG = ux_u8_put(inkPixel + 1, inkG);
        let inkOutB = ux_u8_put(inkPixel + 2, inkB);
        let inkOutA = ux_u8_put(inkPixel + 3, inkA);
      }
      inkMask = inkMask / 2;
      inkCol = inkCol + 1;
    }
    inkRow = inkRow + 1;
  }
  return 0;
}
return 0 - 1;
