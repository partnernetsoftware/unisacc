// Fog range is packed as two unsigned 16-bit depths; zero disables fog.
if (op == 21) {
  if (a < 0 || a > 4294967295 || b < 0 || b > 16777215) { return 0 - 1; }
  let fogStart = a % 65536;
  let fogEnd = a / 65536;
  if (a != 0 && fogEnd <= fogStart) { return 0 - 1; }
  sceneFogStart = fogStart;
  sceneFogEnd = fogEnd;
  sceneFogColor = b;
  return 0;
}
// Preserve explicit unshaded material support; toon materials use three bands.
if (op == 22) {
  if (a < 0 || a > 255 || b < 0 || b > 1) { return 0 - 1; }
  sceneLight = a;
  if (b == 1) {
    sceneLight = 112;
    if (a >= 80) { sceneLight = 192; }
    if (a >= 176) { sceneLight = 255; }
  }
  return 0;
}
// World camera uses signed 16-bit coordinates and an arbitrary forward vector.
if (op == 23 || op == 24) {
  if (b < 0 || b >= 281474976710656) { return 0 - 1; }
  let axisX = b % 65536 - 32768;
  let axisY = b / 65536 % 65536 - 32768;
  let axisZ = b / 4294967296 - 32768;
  if (op == 23) {
    worldEyeX = axisX;
    worldEyeY = axisY;
    worldEyeZ = axisZ;
    return 0;
  }
  let horizontal = f64_sqrt((axisX * axisX + axisZ * axisZ) * 1.0);
  if (horizontal == 0.0) { worldBasisReady = 0; return 0 - 1; }
  let length = f64_sqrt(horizontal * horizontal + axisY * axisY);
  let orthX = (0.0 - axisZ) / horizontal;
  let orthZ = axisX / horizontal;
  let basisWrite = ux_f32_put(5480000, orthX);
  basisWrite = ux_f32_put(5480004, orthZ);
  basisWrite = ux_f32_put(5480008, (0.0 - orthZ) * axisY / length);
  basisWrite = ux_f32_put(5480012, horizontal / length);
  basisWrite = ux_f32_put(5480016, orthX * axisY / length);
  basisWrite = ux_f32_put(5480020, axisX / length);
  basisWrite = ux_f32_put(5480024, axisY / length);
  basisWrite = ux_f32_put(5480028, axisZ / length);
  worldBasisReady = 1;
  return 0;
}
// Two-sided toon sun. A value of 256 for a disables it; otherwise a is ambient light.
if (op == 26) {
  if (a < 0 || a > 256 || b < 0 || b >= 281474976710656) { return 0 - 1; }
  if (a == 256) { sunEnabled = 0; return 0; }
  let sunX = b % 65536 - 32768;
  let sunY = b / 65536 % 65536 - 32768;
  let sunZ = b / 4294967296 - 32768;
  let sunLength = f64_sqrt((sunX * sunX + sunY * sunY + sunZ * sunZ) * 1.0);
  if (sunLength == 0.0) { return 0 - 1; }
  let sunWrite = ux_f32_put(5480068, sunX / (sunLength * 1.0));
  sunWrite = ux_f32_put(5480072, sunY / (sunLength * 1.0));
  sunWrite = ux_f32_put(5480076, sunZ / (sunLength * 1.0));
  sunAmbient = a;
  sunEnabled = 1;
  return 0;
}
// Bind an RGBA8 texture inside the last resource read. Zero dimensions unbind it.
if (op == 27) {
  if (a < 0 || a > 8388607 || b < 0) { return 0 - 1; }
  if (a == 0) { textureWidth = 0; return 0; }
  let columns = a % 2048;
  let rows = a / 2048 % 2048;
  if (columns < 1 || rows < 1 || b > assetReadBytes || 4 * columns * rows > assetReadBytes - b) { return 0 - 1; }
  textureWidth = columns;
  textureHeight = rows;
  textureOffset = b;
  textureWash = a / 4194304;
  return 0;
}
// Per-vertex normalized UV, as two unsigned 16-bit values.
if (op == 28) {
  if (a < 0 || a > 2 || b < 0 || b > 4294967295) { return 0 - 1; }
  let uv = ux_f32_put(5480080 + 8 * a, (b % 65536) / 65535.0);
  uv = ux_f32_put(5480084 + 8 * a, (b / 65536) / 65535.0);
  return 0;
}
// Begin a shadow map over a 96 by 96 world grid. Set a to 0 to disable it.
if (op == 29) {
  if (a < 0 || a > 1024 || b < 0 || b > 255) { return 0 - 1; }
  if (a == 0) { shadowCell = 0; return 0; }
  let sunUp = ux_f32(5480072);
  if (sunEnabled == 0 || sunUp < 0.05) { return 0 - 1; }
  let shadowSetup = ux_f32_put(5480104, ux_f32(5480068) / sunUp);
  shadowSetup = ux_f32_put(5480108, ux_f32(5480076) / sunUp);
  shadowCell = a;
  shadowDark = b;
  let cell = 0;
  while (cell < 9216) {
    shadowSetup = ux_f32_put(5440000 + cell * 4, 0.0 - 65536.0);
    cell = cell + 1;
  }
  return 0;
}
// Stretch an RGBA backdrop over the framebuffer without writing scene depth.
if (op == 31) {
  if (a < 1 || a > 4194303 || b < 0 || pixels == 0) { return 0 - 1; }
  let sourceWidth = a % 2048;
  let sourceHeight = a / 2048;
  if (sourceWidth == 0 || sourceHeight == 0 || b > assetReadBytes ||
      4 * sourceWidth * sourceHeight > assetReadBytes - b) { return 0 - 1; }
  let destY = 0;
  while (destY < height) {
    let sourceRow = 4194304 + b + 4 * (destY * sourceHeight / height) * sourceWidth;
    let destX = 0;
    while (destX < width) {
      let texel = sourceRow + 4 * (destX * sourceWidth / width);
      let dest = 4 * (destY * width + destX);
      let rgba = ux_u8_put(dest, ux_u8(texel));
      rgba = ux_u8_put(dest + 1, ux_u8(texel + 1));
      rgba = ux_u8_put(dest + 2, ux_u8(texel + 2));
      rgba = ux_u8_put(dest + 3, 255);
      destX = destX + 1;
    }
    destY = destY + 1;
  }
  return 0;
}
// Load a rail of signed 32-bit little-endian records: distance, eye xyz, forward xyz.
if (op == 32) {
  if (a < 2 || a > 32 || b < 0 || b > assetReadBytes || a * 28 > assetReadBytes - b) { return 0 - 1; }
  railRows = 0;
  let railCell = 0;
  let previousMark = 0 - 1;
  while (railCell < 7 * a) {
    let sourceAt = 4194304 + b + railCell * 4;
    let entry = ux_u8(sourceAt) + 256 * ux_u8(sourceAt + 1)
      + 65536 * ux_u8(sourceAt + 2) + 16777216 * ux_u8(sourceAt + 3);
    if (entry >= 2147483648) { entry = entry - 4294967296; }
    if (entry < 0 - 10000000 || entry > 10000000) { return 0 - 1; }
    if (railCell % 7 == 0) {
      if (entry <= previousMark) { return 0 - 1; }
      previousMark = entry;
    }
    let railWrite = ux_f32_put(5480200 + railCell * 4, entry * 1.0);
    railCell = railCell + 1;
  }
  railRows = a;
  return 0;
}
// Evaluate one channel in thousandths of the track units, clamped to the endpoints.
if (op == 33) {
  if (railRows < 2 || b < 1 || b > 6) { return 0 - 1; }
  let railDistance = a;
  let first = f64_floor_i64(ux_f32(5480200));
  let last = f64_floor_i64(ux_f32(5480200 + 28 * (railRows - 1)));
  if (railDistance < first) { railDistance = first; }
  if (railDistance > last) { railDistance = last; }
  let edge = 1;
  while (edge < railRows - 1 && ux_f32(5480200 + 28 * edge) <= railDistance) {
    edge = edge + 1;
  }
  let end = 5480200 + edge * 28;
  let start = end - 28;
  let from = f64_floor_i64(ux_f32(start));
  let span = f64_floor_i64(ux_f32(end)) - from;
  let delta = railDistance - from;
  let low = f64_floor_i64(ux_f32(start + b * 4));
  let high = f64_floor_i64(ux_f32(end + b * 4));
  return 1000 * (low * (span - delta) + high * delta) / span;
}
return 0 - 1;
