function Scene_create(scene_arena) {
  let scene_handle=Object3D_create(scene_arena);
  if(scene_handle>0) {
    let scene_at=Object3D_address(scene_arena,scene_handle);
    let scene_mark=ux_u32_put(scene_at+Scene.size,3);
  }
  return scene_handle;
}

function Scene_isScene(scene_test,...scene_test_args) {
  let scene_test_at=Object3D_address(scene_test,scene_test_args[0]);
  let scene_matches=0;
  if(scene_test_at>=0) { scene_matches=ux_u32(scene_test_at+Scene.size)==3; }
  return scene_matches;
}

function Scene_setResources(scene_set,...scene_resource_args) {
  let scene_resource_at=Object3D_address(scene_set,scene_resource_args[0]);
  let scene_result=0-1;
  if(scene_resource_at>=0 && ux_u32(scene_resource_at+Scene.size)==3) {
    let scene_bg=ux_u32_put(scene_resource_at+Scene.background,scene_resource_args[1]);
    let scene_env=ux_u32_put(scene_resource_at+Scene.environment,scene_resource_args[2]);
    let scene_fog=ux_u32_put(scene_resource_at+Scene.fog,scene_resource_args[3]);
    let scene_override=ux_u32_put(scene_resource_at+Scene.overrideMaterial,scene_resource_args[4]);
    scene_result=scene_resource_args[0];
  }
  return scene_result;
}

function Scene_add(scene_add,...scene_add_args) {
  return Object3D_add(scene_add,scene_add_args[0],scene_add_args[1]);
}

function Scene_remove(scene_remove,...scene_remove_args) {
  return Object3D_remove(scene_remove,scene_remove_args[0],scene_remove_args[1]);
}

function Scene_traverse(scene_walk,...scene_walk_args) {
  return Object3D_traverse(scene_walk,scene_walk_args[0],scene_walk_args[1],scene_walk_args[2]);
}

function Scene_updateMatrixWorld(scene_update,...scene_update_args) {
  return Object3D_updateMatrixWorld(scene_update,scene_update_args[0],scene_update_args[1]);
}
