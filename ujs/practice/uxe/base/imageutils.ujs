native function image_linear_byte(value:i64,canvas:i64) i64 {
  let scaled=Color_srgbToLinear(value/255.0)*255.0;
  let byte=f64_floor_i64(scaled);
  let fraction=scaled-byte;
  if(canvas!=0 && (fraction>0.5 || (fraction==0.5 && byte%2!=0))) { byte=byte+1; }
  return byte;
}

// Convert typed image channels into separate caller-owned storage.
// kind 1 is u8, 3 is clamped u8, 9 is f32 and 10 is f64.
native function image_to_linear(img_dst:i64,img_src:i64,img_channels:i64,img_kind:i64,canvas:i64) i64 {
  if(img_channels<0 || (img_kind!=1 && img_kind!=3 && img_kind!=9 && img_kind!=10)) { return 0-1; }
  let img_width=1;
  if(img_kind==9) { img_width=4; }
  if(img_kind==10) { img_width=8; }
  if(img_src<0 || img_dst<0 || img_src>6291456 || img_dst>6291456 ||
    img_channels>(6291456-img_src)/img_width || img_channels>(6291456-img_dst)/img_width) { return 0-1; }
  let img_size=img_channels*img_width;
  if(img_size>0 && img_src<img_dst+img_size && img_dst<img_src+img_size) { return 0-1; }
  let img_i=0;
  while(img_i<img_size) {
    if(img_width==1) {
      let img_byte=ux_u8_put(img_dst+img_i,image_linear_byte(ux_u8(img_src+img_i),canvas));
    } else if(img_kind==9) {
      let img_float=ux_f32_put(img_dst+img_i,Color_srgbToLinear(ux_f32(img_src+img_i)));
    } else {
      let img_double=ux_f64_put(img_dst+img_i,Color_srgbToLinear(ux_f64(img_src+img_i)));
    }
    img_i=img_i+img_width;
  }
  return img_dst;
}

native function ImageUtils_sRGBToLinear(img_dst:i64,img_src:i64,img_channels:i64,img_kind:i64) i64 {
  return image_to_linear(img_dst,img_src,img_channels,img_kind,0);
}

// Canvas ImageData converts to Uint8ClampedArray with ties to even.
native function ImageUtils_canvasToLinear(dst:i64,src:i64,channels:i64) i64 {
  if(channels%4!=0) { return 0-1; }
  return image_to_linear(dst,src,channels,3,1);
}

// Retain an already encoded URI as a view, including URLs over the string ABI limit.
native function image_data_uri(img_uri:i64,img_length:i64) i64 {
  if(img_length<5 || img_uri<0 || img_uri>6291456 || img_length>6291456-img_uri) { return 0; }
  if(u32_or(ux_u8(img_uri),32)==100 && u32_or(ux_u8(img_uri+1),32)==97 &&
     u32_or(ux_u8(img_uri+2),32)==116 && u32_or(ux_u8(img_uri+3),32)==97 && ux_u8(img_uri+4)==58) { return 1; }
  return 0;
}

function ImageUtils_getDataURL(img_uri,...img_uri_args) {
  let img_result=0-1;
  if(image_data_uri(img_uri,img_uri_args[0])) { img_result=img_uri; }
  return img_result;
}
