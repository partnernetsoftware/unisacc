native function PlaneGeometry_generate(plane:i64,width:f64,height:f64,gx:i64,gy:i64) i64 {
  if(gx<1 || gy<1 || gx>262144 || gy>262144) { return 0-1; }
  let columns=gx+1;
  let points=columns*(gy+1);
  let cells=gx*gy*6;
  if(!GeometryBuffers_fits(plane,points,cells)) { return 0-1; }
  let vertex=ux_u32(plane+GeometryBuffers.vertices);
  let index=ux_u32(plane+GeometryBuffers.indices);
  let py=0;
  while(py<=gy) {
    let px=0;
    while(px<=gx) {
      let u=(px*1.0)/gx;
      let v=1.0-(py*1.0)/gy;
      let end=geometry_point(vertex,px*(width/gx)-width*0.5,height*0.5-py*(height/gy),
        0.0,0.0,0.0,1.0,u);
      let uv_y=ux_f32_put(end,v);
      vertex=end+4;
      if(px<gx && py<gy) {
        let a=py*columns+px;
        index=geometry_quad(index,a,a+columns,a+columns+1,a+1);
      }
      px=px+1;
    }
    py=py+1;
  }
  return GeometryBuffers_commit(plane,points,cells);
}
