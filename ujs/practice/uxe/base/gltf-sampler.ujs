struct GltfSampler {
  magFilter: u32;
  minFilter: u32;
  wrapS: u32;
  wrapT: u32;
}

native function gltf_sampler_wrap(mode:i64) i64 {
  return mode==10497 || mode==33071 || mode==33648;
}

// Store WebGL enum values used by glTF. UINT32_MAX is the implicit sampler.
native function GltfLoader_sampler(glb:i64,index:i64,out:i64,key:i64) i64 {
  if(!loading_span(glb,GlbResource.size) || !loading_span(out,GltfSampler.size) ||
     !loading_span(key,12) || !file_disjoint(glb,GlbResource.size,key,12) ||
     !file_disjoint(glb,GlbResource.size,out,GltfSampler.size) ||
     !file_disjoint(out,GltfSampler.size,key,12)) { return 0-1; }
  let json=ux_u32(glb+GlbResource.json);
  let bytes=ux_u32(glb+GlbResource.jsonBytes);
  let bin=ux_u32(glb+GlbResource.bin);
  let bin_bytes=ux_u32(glb+GlbResource.binBytes);
  if(!loading_span(json,bytes) || !loading_span(bin,bin_bytes) ||
     !file_disjoint(json,bytes,key,12) || !file_disjoint(bin,bin_bytes,key,12) ||
     !file_disjoint(json,bytes,out,GltfSampler.size) || !file_disjoint(bin,bin_bytes,out,GltfSampler.size)) { return 0-1; }
  let mag=9729;
  let min=9987;
  let wrap_s=10497;
  let wrap_t=10497;
  if(index!=4294967295) {
    let end=json+bytes;
    let sampler=LoaderJson_item(LoaderJson_find(json,end,key,1886216563,1936876908,0,8),end,index);
    if(sampler<0 || ux_u8(sampler)!=123) { return 0-2; }
    mag=LoaderJson_uint(LoaderJson_find(sampler,end,key,1181180269,1702128745,114,9),end,mag);
    min=LoaderJson_uint(LoaderJson_find(sampler,end,key,1181641069,1702128745,114,9),end,min);
    wrap_s=LoaderJson_uint(LoaderJson_find(sampler,end,key,1885434487,83,0,5),end,wrap_s);
    wrap_t=LoaderJson_uint(LoaderJson_find(sampler,end,key,1885434487,84,0,5),end,wrap_t);
    if((mag!=9728 && mag!=9729) || (min!=9728 && min!=9729 && (min<9984 || min>9987)) ||
       !gltf_sampler_wrap(wrap_s) || !gltf_sampler_wrap(wrap_t)) { return 0-3; }
  }
  let a=ux_u32_put(out+GltfSampler.magFilter,mag);
  let b=ux_u32_put(out+GltfSampler.minFilter,min);
  let c=ux_u32_put(out+GltfSampler.wrapS,wrap_s);
  let d=ux_u32_put(out+GltfSampler.wrapT,wrap_t);
  return out;
}
