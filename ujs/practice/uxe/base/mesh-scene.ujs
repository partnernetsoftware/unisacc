// Records are indexed by the low 16 bits of an Object3D handle minus one.
// Zero leaves a slot unbound. The stored generation must match the visible node.
native function MeshScene_collect(arena:i64,root:i64,records:i64,walk:i64,out:i64) i64 {
  if(arena<0 || arena%8!=0 || arena>6291448) { return 0-1; }
  let count=ux_u32(arena);
  if(count<1 || count>(6291448-arena)/424) { return 0-1; }
  let bytes=count*4;
  if(records<0 || records%4!=0 || records>6291456-bytes ||
     walk<0 || walk%4!=0 || walk>6291456-bytes ||
     out<0 || out%4!=0 || out>6291456-bytes) { return 0-1; }
  let end=arena+8+424*count;
  if((records<end && arena<records+bytes) || (walk<end && arena<walk+bytes) ||
     (out<end && arena<out+bytes) ||
     (records<walk+bytes && walk<records+bytes) ||
     (records<out+bytes && out<records+bytes) || (walk<out+bytes && out<walk+bytes)) { return 0-1; }
  let scan=0;
  while(scan<count) {
    let record=ux_u32(records+scan*4);
    if(record!=0 && (!mesh_valid(record) ||
       (record<walk+bytes && walk<record+Mesh.size) ||
       (record<out+bytes && out<record+Mesh.size))) { return 0-1; }
    scan=scan+1;
  }
  let nodes=Object3D_walk(arena,root,walk,count,1);
  if(nodes<0) { return nodes; }
  let i=0;
  let written=0;
  while(i<nodes) {
    let handle=ux_u32(walk+i*4);
    let mesh=ux_u32(records+(handle%65536-1)*4);
    if(mesh!=0 && ux_u32(mesh+Mesh.node)==handle) {
      let saved=ux_u32_put(out+written*4,mesh);
      written=written+1;
    }
    i=i+1;
  }
  return written;
}
