native function CircleGeometry_create(circle:i64,raw:i64,arena:i64,bytes:i64,radius:f64,segments:f64,start:f64,length:f64) i64 {
  if(!geometry_primitive_raw(circle,raw,arena,bytes,0,0) ||
     radius-radius!=0.0 || start-start!=0.0 || length-length!=0.0 ||
     segments-segments!=0.0 || segments>262144.0) { return 0-1; }
  let count=3;
  if(segments>3.0) {
    count=f64_floor_i64(segments);
    // The native generator has an integer grid. r160 uses a fractional
    // denominator for segments above 3, which is outside this grid contract.
    if(segments!=0.0+count) { return 0-1; }
  }
  let generated=CircleGeometry_generate(raw,radius,count,start,length);
  if(generated<0) { return generated; }
  let installed=GeometryBuffers_asGeometry(raw,GeometryPrimitive_geometry(circle),arena,bytes,7,0,0);
  if(installed<0) { return installed; }
  return geometry_primitive_store(circle,2,radius,segments,start,length,0.0,0.0);
}

native function CircleGeometry_copy(dst:i64,src:i64,arena:i64,bytes:i64) i64 {
  return geometry_primitive_copy(dst,src,arena,bytes,2);
}

native function CircleGeometry_clone(dst:i64,src:i64,arena:i64,bytes:i64) i64 {
  return geometry_primitive_clone(dst,src,arena,bytes,2);
}

native function CircleGeometry_dispose(circle:i64,event:i64,out:i64,limit:i64) i64 {
  return geometry_primitive_dispose(circle,event,out,limit,2);
}
