native function SkinnedMesh_copy(dst:i64,dstArena:i64,src:i64,srcArena:i64,recursive:i64) i64 {
  if(!skinned_valid(dst) || !skinned_valid(src) ||
     skeleton_overlap(dst,SkinnedMesh.size,src,SkinnedMesh.size)) { return 0-1; }
  let to=ux_u32(dst+SkinnedMesh.mesh);
  let from=ux_u32(src+SkinnedMesh.mesh);
  if(!mesh_valid(to) || !mesh_valid(from) || skeleton_overlap(to,Mesh.size,from,Mesh.size)) { return 0-1; }
  let bind=ux_u32(dst+SkinnedMesh.bindMatrix);
  let inverse=ux_u32(dst+SkinnedMesh.bindInverse);
  let sourceBind=ux_u32(src+SkinnedMesh.bindMatrix);
  let sourceInverse=ux_u32(src+SkinnedMesh.bindInverse);
  if(bind>6291456-128 || inverse>6291456-128 || sourceBind>6291456-128 || sourceInverse>6291456-128 ||
     skeleton_overlap(bind,128,sourceBind,128) || skeleton_overlap(bind,128,sourceInverse,128) ||
     skeleton_overlap(inverse,128,sourceBind,128) || skeleton_overlap(inverse,128,sourceInverse,128) ||
     (dstArena==srcArena && ux_u32(to+Mesh.node)==ux_u32(from+Mesh.node))) { return 0-1; }
  let copy=Mesh_copy(to,dstArena,from,srcArena,recursive);
  if(copy<0) { return copy; }
  let a=Matrix4_copy(bind,sourceBind);
  let b=Matrix4_copy(inverse,sourceInverse);
  let c=ux_u32_put(dst+SkinnedMesh.skeleton,ux_u32(src+SkinnedMesh.skeleton));
  let d=ux_u32_put(dst+SkinnedMesh.bindMode,ux_u32(src+SkinnedMesh.bindMode));
  return dst;
}

function SkinnedMesh_clone(skin_destination,...skin_clone_args) {
  return SkinnedMesh_copy(skin_destination,skin_clone_args[0],skin_clone_args[1],skin_clone_args[2],skin_clone_args[3]);
}
