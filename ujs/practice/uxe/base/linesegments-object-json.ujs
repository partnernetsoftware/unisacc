native function LineSegments_toJSON(line:i64,arena:i64,ids:i64,dst:i64,end:i64,scratch:i64) i64 {
  return renderable_toJSON(line,arena,ids,dst,end,scratch,14);
}

native function LineSegments_fromJSON(line:i64,arena:i64,input:i64,end:i64,scratch:i64,bindings:i64) i64 {
  return renderable_fromJSON(line,arena,input,end,scratch,bindings,14);
}

native function LineSegments_clone(dst:i64,dstArena:i64,src:i64,srcArena:i64,recursive:i64) i64 {
  return Mesh_clone(dst,dstArena,src,srcArena,recursive);
}

native function LineSegments_dispose(line:i64,arena:i64) i64 {
  return Mesh_dispose(line,arena);
}
