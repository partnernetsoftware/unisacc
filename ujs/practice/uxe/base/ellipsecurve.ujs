struct EllipseCurve {
  centerX: f64;
  centerY: f64;
  radiusX: f64;
  radiusY: f64;
  start: f64;
  finish: f64;
  rotation: f64;
  clockwise: u32;
}

native function ellipse_offset_time(start:f64,finish:f64,clockwise:i64,t:f64) f64 {
  let tau=6.283185307179586;
  let delta=finish-start;
  let epsilon=0.0000000000000002220446049250313;
  let same=delta>0.0-epsilon && delta<epsilon;
  if(delta<0.0 || delta>tau) { delta=delta-tau*f64_floor_i64(delta/tau); }
  if(delta<epsilon) {
    delta=tau;
    if(same) { delta=0.0; }
  }
  if(clockwise!=0 && !same) {
    if(delta==tau) { delta=0.0-tau; }
    else { delta=delta-tau; }
  }
  return start+t*delta;
}

native function ellipse_point(dst:i64,ellipse:i64,t:f64,circle:i64) i64 {
  let cx=ux_f64(ellipse+EllipseCurve.centerX);
  let cy=ux_f64(ellipse+EllipseCurve.centerY);
  let rx=ux_f64(ellipse+EllipseCurve.radiusX);
  let ry=ux_f64(ellipse+EllipseCurve.radiusY);
  let rotate=ux_f64(ellipse+EllipseCurve.rotation);
  if(circle!=0) { ry=rx; rotate=0.0; }
  let angle=ellipse_offset_time(ux_f64(ellipse+EllipseCurve.start),ux_f64(ellipse+EllipseCurve.finish),
    ux_u32(ellipse+EllipseCurve.clockwise),t);
  let x=rx*ux_math_cos(angle);
  let y=ry*ux_math_sin(angle);
  if(rotate!=0.0) {
    let cosine=ux_math_cos(rotate);
    let sine=ux_math_sin(rotate);
    let turns=x*cosine-y*sine;
    y=x*sine+y*cosine;
    x=turns;
  }
  let px=ux_f64_put(dst,cx+x);
  let py=ux_f64_put(dst+8,cy+y);
  return dst;
}

native function EllipseCurve_getPoint(dst:i64,ellipse:i64,t:f64) i64 {
  return ellipse_point(dst,ellipse,t,0);
}
