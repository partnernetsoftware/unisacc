// The temporary image descriptor and pixel data share the caller's raster buffer.
native function ImageUtils_displayDataURL(image:i64,width:i64,height:i64,raster:i64,out:i64,capacity:i64,work:i64,space:i64) i64 {
  if(width<1 || width>4096 || height<1 || height>4096 || width*height>1048576) { return 0-1; }
  let room=ImageResource.size+width*height*4;
  if(raster<0 || raster%4!=0 || room<ImageResource.size || raster>6291456-room ||
     out<0 || capacity<0 || out>6291456-capacity || work<0 || space<0 || work>6291456-space ||
     image_source_overlap(raster,room,out,capacity) || image_source_overlap(raster,room,work,space)) { return 0-1; }
  if(image<0 || image%4!=0 || image>6291456-ImageResource.size ||
     image_source_overlap(image,ImageResource.size,raster,room)) { return 0-1; }
  let source=ux_u32(image+ImageResource.rgba);
  let sourceWidth=ux_u32(image+ImageResource.width);
  let sourceHeight=ux_u32(image+ImageResource.height);
  let stride=ux_u32(image+ImageResource.rowBytes);
  if(sourceWidth<1 || sourceWidth>4096 || sourceHeight<1 || sourceHeight>4096 || stride<sourceWidth*4 ||
     source>6291456-sourceWidth*4 || sourceHeight-1>(6291456-source-sourceWidth*4)/stride ||
     image_source_overlap(source,(sourceHeight-1)*stride+sourceWidth*4,raster,ImageResource.size)) { return 0-1; }
  let pixels=raster+ImageResource.size;
  let count=ImageUtils_displayRaster(image,width,height,pixels,room-ImageResource.size);
  if(count<0) { return count; }
  let a=ux_u32_put(raster+ImageResource.rgba,pixels);
  let b=ux_u32_put(raster+ImageResource.width,width);
  let c=ux_u32_put(raster+ImageResource.height,height);
  let d=ux_u32_put(raster+ImageResource.rowBytes,width*4);
  return ImageUtils_canvasDataURL(raster,out,capacity,work,space);
}
