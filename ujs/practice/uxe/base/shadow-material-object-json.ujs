native function shadow_json_spans(obj:i64,at:i64,end:i64,scratch:i64) i64 {
  return shadow_object_live(obj) && at>=0 && end>at && end<=6291456 &&
    scratch>=0 && scratch%8==0 && scratch<=6291456-1104 &&
    shadow_object_split(obj,shadow_object_size(),at,end-at) &&
    shadow_object_split(obj,shadow_object_size(),scratch,1104) &&
    shadow_object_split(at,end-at,scratch,1104);
}

native function ShadowMaterial_writeJSON(obj:i64,at:i64,end:i64,scratch:i64) i64 {
  if(!shadow_json_spans(obj,at,end,scratch) || end-at<24) { return 0-1; }
  let color=ux_u32(obj+Material.size+ShadowMaterialFields.color);
  let fog=ux_u32(obj+Material.size+ShadowMaterialFields.fog);
  if(color>16777215 || fog>1) { return 0-1; }
  let prefix=[123,34,116,121,112,101,34,58,34,83,104,97,100,111,119,77,97,116,101,114,105,97,108,34];
  let i=0;
  while(i<24) { let byte=ux_u8_put(at+i,prefix[i]); i=i+1; }
  let p=Material_writeFields(at+24,end,obj,scratch);
  p=material_json_field(p,end,491495649123,0,0,10,0.0+color,scratch);
  if(fog==0) { p=material_json_field(p,end,6778726,0,0,7,0.0,scratch); }
  return json_byte(p,end,125);
}

native function shadow_json_kind(at:i64,end:i64,scratch:i64) i64 {
  let key=ux_u32_put(scratch,1701869940);
  let type=json_find_key(at,end,scratch,4);
  if(type<0 || Json_decodeString(type,end,scratch,14)!=14) { return 0; }
  let label=[83,104,97,100,111,119,77,97,116,101,114,105,97,108];
  let i=0;
  while(i<14) {
    if(ux_u8(scratch+i)!=label[i]) { return 0; }
    i=i+1;
  }
  return 1;
}

native function ShadowMaterial_readJSON(obj:i64,at:i64,end:i64,scratch:i64) i64 {
  if(!shadow_json_spans(obj,at,end,scratch)) { return 0-1; }
  let start=json_space(at,end);
  let stop=json_value_end(start,end);
  if(stop<0 || json_space(stop,end)!=end || !shadow_json_kind(start,stop,scratch)) { return 0-1; }
  let color=material_json_read(start,stop,scratch,491495649123,0,0,10,0.0);
  let fog=material_json_read(start,stop,scratch,6778726,0,0,7,1.0);
  let transparent=material_json_read(start,stop,scratch,8241992434140148340,7630437,0,23,1.0);
  if(!(color>=0.0 && color<=16777215.0) || fog!=fog || transparent!=transparent) { return 0-1; }
  let packed=f64_floor_i64(color);
  if(packed!=color) { return 0-1; }
  let base=Material_readFields(start,stop,obj,scratch);
  if(base<0) { return base; }
  let alpha=ux_u32_put(obj+Material.transparent,f64_floor_i64(transparent));
  return ShadowMaterial_set(obj,packed,f64_floor_i64(fog));
}
