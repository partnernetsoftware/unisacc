// Flat geometry from a sampled simple contour. Each vertex gets position,
// surface normal and unscaled planar UV; the workspace holds 24 bytes per point.
native function ShapeGeometry_generate(mesh:i64,contour:i64,count:i64,work:i64) i64 {
  if(contour<0 || contour>6291456 || contour%8!=0 || count<3 || count>4096 ||
     count>(6291456-contour)/16 || work<0 || work>6291456 || work%8!=0 ||
     count>(6291456-work)/24 || (contour<work+count*24 && work<contour+count*16)) { return 0-1; }
  if(!GeometryBuffers_fits(mesh,count,3*(count-2))) { return 0-1; }
  let vertices=ux_u32(mesh+GeometryBuffers.vertices);
  let indices=ux_u32(mesh+GeometryBuffers.indices);
  let area=ShapeUtils_area(contour,count);
  if(area==0.0) { return 0-1; }
  let i=0;
  while(i<count) {
    let j=i;
    if(area>0.0) { j=count-1-i; }
    let point=contour+j*16;
    let x=ux_f64(point);
    let y=ux_f64(point+8);
    let work_x=ux_f64_put(work+i*16,x);
    let work_y=ux_f64_put(work+i*16+8,y);
    vertices=GeometryBuffers_vertex(vertices,x,y,0.0,0.0,0.0,1.0,x,y);
    i=i+1;
  }
  let faces=ShapeUtils_triangulateShape(work,count,indices,3*(count-2),work+count*16);
  if(faces<0) { return faces; }
  return GeometryBuffers_commit(mesh,count,faces);
}
