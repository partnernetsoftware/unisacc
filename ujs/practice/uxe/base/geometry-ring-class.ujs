struct RingGeometryParameters {
  innerRadius: f64;
  outerRadius: f64;
  thetaSegments: f64;
  phiSegments: f64;
  thetaStart: f64;
  thetaLength: f64;
}

native function RingGeometry_create(at:i64,raw:i64,arena:i64,bytes:i64,params:i64) i64 {
  if(params%8!=0 || !geometry_primitive_raw(at,raw,arena,bytes,params,RingGeometryParameters.size)) { return 0-1; }
  let inner=ux_f64(params+RingGeometryParameters.innerRadius);
  let outer=ux_f64(params+RingGeometryParameters.outerRadius);
  let theta=ux_f64(params+RingGeometryParameters.thetaSegments);
  let phi=ux_f64(params+RingGeometryParameters.phiSegments);
  let start=ux_f64(params+RingGeometryParameters.thetaStart);
  let length=ux_f64(params+RingGeometryParameters.thetaLength);
  let width=outer-inner;
  let end=start+length;
  if(width-width!=0.0 || end-end!=0.0 || outer==0.0 ||
     theta-theta!=0.0 || phi-phi!=0.0 || theta>262144.0 || phi>262144.0) { return 0-1; }
  let rings=1;
  let columns=3;
  if(theta>3.0) {
    columns=f64_floor_i64(theta);
    if(theta!=0.0+columns) { return 0-1; }
  }
  if(phi>1.0) {
    rings=f64_floor_i64(phi);
    if(phi!=0.0+rings) { return 0-1; }
  }
  let generated=RingGeometry_generate(raw,inner,outer,columns,rings,start,length);
  if(generated<0) { return generated; }
  let installed=GeometryBuffers_asGeometry(raw,GeometryPrimitive_geometry(at),arena,bytes,7,0,0);
  if(installed<0) { return installed; }
  return geometry_primitive_store(at,7,inner,outer,theta,phi,start,length);
}

native function RingGeometry_copy(dst:i64,src:i64,arena:i64,bytes:i64) i64 {
  return geometry_primitive_copy(dst,src,arena,bytes,7);
}

native function RingGeometry_clone(dst:i64,src:i64,arena:i64,bytes:i64) i64 {
  return geometry_primitive_clone(dst,src,arena,bytes,7);
}

native function RingGeometry_dispose(at:i64,event:i64,out:i64,limit:i64) i64 {
  return geometry_primitive_dispose(at,event,out,limit,7);
}
