struct GpuTarget {
  kind: u32;
  id: u32;
  width: u32;
  height: u32;
  layers: u32;
  colors: u32;
  depth: u32;
}

struct GpuTargetRead {
  id: u32;
  layer: u32;
  color: u32;
  x: u32;
  y: u32;
  width: u32;
  height: u32;
  output: u32;
}

native function gpu_target_record(packet:i64,capacity:i64,opcode:i64,record:i64,size:i64) i64 {
  if(record%4!=0 || !gpu_draw_range(record,size,packet,capacity)) { return 0-1; }
  let span=8+size;
  let command=gpu_packet_slot(packet,capacity,span);
  if(command<0) { return command; }
  let op=ux_u32_put(command,opcode);
  let bytes=ux_u32_put(command+4,span);
  let copied=uxe_copy_record(command+8,record,size);
  return gpu_packet_publish(packet,span);
}

native function GpuTarget_create(packet:i64,capacity:i64,descriptor:i64) i64 {
  return gpu_target_record(packet,capacity,9,descriptor,GpuTarget.size);
}

native function GpuTarget_read(packet:i64,capacity:i64,descriptor:i64) i64 {
  return gpu_target_record(packet,capacity,11,descriptor,GpuTargetRead.size);
}

native function GpuTarget_bind(packet:i64,capacity:i64,id:i64,layer:i64) i64 {
  if(id<0 || id>1024 || layer<0 || layer>255) { return 0-1; }
  let command=gpu_packet_slot(packet,capacity,16);
  if(command<0) { return command; }
  let op=ux_u32_put(command,10);
  let bytes=ux_u32_put(command+4,16);
  let key=ux_u32_put(command+8,id);
  let slice=ux_u32_put(command+12,layer);
  return gpu_packet_publish(packet,16);
}

native function GpuTarget_dispose(packet:i64,capacity:i64,id:i64) i64 {
  if(id<1 || id>1024) { return 0-1; }
  let command=gpu_packet_slot(packet,capacity,12);
  if(command<0) { return command; }
  let op=ux_u32_put(command,12);
  let bytes=ux_u32_put(command+4,12);
  let key=ux_u32_put(command+8,id);
  return gpu_packet_publish(packet,12);
}
