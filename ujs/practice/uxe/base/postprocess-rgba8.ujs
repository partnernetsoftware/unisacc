struct ColorCorrectionSettings {
  powR:f64;
  powG:f64;
  powB:f64;
  mulR:f64;
  mulG:f64;
  mulB:f64;
  addR:f64;
  addG:f64;
  addB:f64;
}

native function post_span(offset:i64,bytes:i64) i64 {
  return offset>=0 && bytes>0 && offset<=6291456-bytes;
}

native function post_overlap(a:i64,an:i64,b:i64,bn:i64) i64 {
  return a<b+bn && b<a+an;
}

native function post_rgba8(color:f64) i64 {
  if(color<=0.0) { return 0; }
  if(color>=255.0) { return 255; }
  return f64_floor_i64(color+0.5);
}

// Applies the r160 RGB operation to linear RGBA8. Exact in-place use is
// supported. All settings are finite: power (0,16], gain [0,16], bias [0,1].
// Returns the pixel count, or -1 before writing for invalid arguments.
native function ColorCorrection_applyRGBA8(src:i64,dst:i64,pixels:i64,settings:i64) i64 {
  if(pixels<1 || pixels>1572864) { return 0-1; }
  let bytes=pixels*4;
  if(!post_span(src,bytes) || !post_span(dst,bytes) ||
     settings%8!=0 || !post_span(settings,ColorCorrectionSettings.size) ||
     (src!=dst && post_overlap(src,bytes,dst,bytes)) ||
     post_overlap(settings,ColorCorrectionSettings.size,dst,bytes)) { return 0-1; }
  let channel=0;
  while(channel<3) {
    let power=ux_f64(settings+ColorCorrectionSettings.powR+channel*8);
    let gain=ux_f64(settings+ColorCorrectionSettings.mulR+channel*8);
    let bias=ux_f64(settings+ColorCorrectionSettings.addR+channel*8);
    if(!(power>0.0 && power<=16.0) || !(gain>=0.0 && gain<=16.0) ||
       !(bias>=0.0 && bias<=1.0)) { return 0-1; }
    channel=channel+1;
  }
  let offset=0;
  while(offset<bytes) {
    channel=0;
    while(channel<3) {
      let power=ux_f64(settings+ColorCorrectionSettings.powR+channel*8);
      let gain=ux_f64(settings+ColorCorrectionSettings.mulR+channel*8);
      let bias=ux_f64(settings+ColorCorrectionSettings.addR+channel*8);
      let base=ux_u8(src+offset+channel)/255.0+bias;
      let stored=ux_u8_put(dst+offset+channel,post_rgba8(255.0*gain*ux_math_pow(base,power)));
      channel=channel+1;
    }
    let alpha=ux_u8_put(dst+offset+3,ux_u8(src+offset+3));
    offset=offset+4;
  }
  return pixels;
}

