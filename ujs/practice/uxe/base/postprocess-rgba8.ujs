native function fxaa_sample(src:i64,width:i64,height:i64,x:i64,y:i64) i64 {
  if(x<0) { x=0; }
  if(y<0) { y=0; }
  if(x>=width) { x=width-1; }
  if(y>=height) { y=height-1; }
  return src+4*(y*width+x);
}

native function fxaa_contrast(a:i64,b:i64) i64 {
  let largest=0;
  let channel=0;
  while(channel<4) {
    let difference=ux_u8(a+channel)-ux_u8(b+channel);
    if(difference<0) { difference=0-difference; }
    if(difference>largest) { largest=difference; }
    channel=channel+1;
  }
  return largest;
}

native function fxaa_mix(dst:i64,center:i64,edge:i64,weight:f64) i64 {
  let channel=0;
  while(channel<4) {
    let value=ux_u8(center+channel)*(1.0-weight)+ux_u8(edge+channel)*weight;
    let saved=ux_u8_put(dst+channel,post_rgba8(value));
    channel=channel+1;
  }
  return 0;
}

native function fxaa_pixel(src:i64,dst:i64,width:i64,height:i64,x:i64,y:i64) i64 {
  let center=fxaa_sample(src,width,height,x,y);
  let north=fxaa_sample(src,width,height,x,y-1);
  let south=fxaa_sample(src,width,height,x,y+1);
  let east=fxaa_sample(src,width,height,x+1,y);
  let west=fxaa_sample(src,width,height,x-1,y);
  let cn=fxaa_contrast(center,north);
  let cs=fxaa_contrast(center,south);
  let ce=fxaa_contrast(center,east);
  let cw=fxaa_contrast(center,west);
  if(cn<51 && cs<51 && ce<51 && cw<51) { return fxaa_mix(dst,center,center,0.0); }
  let tilt=cn+cs-ce-cw;
  if(tilt>=0-15 && tilt<=15) {
    let dx=0-1;
    let dy=0-1;
    if(ce>cw) { dx=1; }
    if(cs>cn) { dy=1; }
    let across=fxaa_sample(src,width,height,x+dx,y-dy);
    let along=fxaa_sample(src,width,height,x-dx,y+dy);
    tilt=fxaa_contrast(center,along)-fxaa_contrast(center,across);
    if(tilt>=0-15 && tilt<=15) {
      let channel=0;
      while(channel<4) {
        let neighbors=ux_u8(north+channel)+ux_u8(south+channel)+ux_u8(east+channel)+ux_u8(west+channel);
        let value=(6*ux_u8(center+channel)+neighbors)/10.0;
        let saved=ux_u8_put(dst+channel,post_rgba8(value));
        channel=channel+1;
      }
      return 0;
    }
  }
  let tx=0;
  let ty=1;
  let edge=east;
  if(cw>ce) { edge=west; }
  if(tilt>0) {
    tx=1;
    ty=0;
    edge=south;
    if(cn>cs) { edge=north; }
  }
  let step=1;
  let distance=0;
  while(step<=5) {
    distance=distance+step;
    let a=fxaa_sample(src,width,height,x+tx*distance,y+ty*distance);
    let b=fxaa_sample(src,width,height,x-tx*distance,y-ty*distance);
    if(fxaa_contrast(a,center)>fxaa_contrast(a,edge) || fxaa_contrast(b,center)>fxaa_contrast(b,edge)) {
      let weight=(1.0-f64_sqrt((step-1)/4.0))*0.5;
      return fxaa_mix(dst,center,edge,weight);
    }
    step=step+1;
  }
  return fxaa_mix(dst,center,center,0.0);
}

// Full-frame pixel centers at resolution=(1/width,1/height), clamp-to-edge.
// The source and destination must be disjoint because the filter reads neighbors.
// Returns the pixel count, or -1 before writing for invalid arguments.
native function FXAA_applyRGBA8(src:i64,dst:i64,width:i64,height:i64) i64 {
  if(width<1 || width>1572864 || height<1 || height>1572864 || width*height>1572864) { return 0-1; }
  let bytes=width*height*4;
  if(!post_span(src,bytes) || !post_span(dst,bytes) || post_overlap(src,bytes,dst,bytes)) { return 0-1; }
  let y=0;
  while(y<height) {
    let x=0;
    while(x<width) {
      let done=fxaa_pixel(src,dst+4*(y*width+x),width,height,x,y);
      x=x+1;
    }
    y=y+1;
  }
  return width*height;
}
