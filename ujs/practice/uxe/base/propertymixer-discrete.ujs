// Reuse the mixer storage for boolean or string handle lanes. f64 represents
// each u32 handle exactly; selection does not perform interpolation on it.
native function PropertyMixer_select(mixer:i64,incoming:i64,weight:f64,blend:i64) i64 {
  let lanes=property_mixer_lanes(mixer);
  if(lanes<0 || incoming%8!=0 || !animation_span(incoming,lanes*8) ||
     weight-weight!=0.0 || weight<0.0 || (blend!=2500 && blend!=2501)) { return 0-1; }
  let rows=ux_u32(mixer+PropertyMixer.rows);
  if(animation_overlap(incoming,lanes*8,rows,lanes*32) ||
     animation_overlap(incoming,lanes*8,mixer,PropertyMixer.size)) { return 0-1; }
  if(weight==0.0) { return mixer; }
  let slot=PropertyMixer.weight;
  let target=rows+lanes*8;
  if(blend==2501) { slot=PropertyMixer.addWeight; target=rows+lanes*16; }
  let old=ux_f64(mixer+slot);
  let total=old+weight;
  if(total-total!=0.0) { return 0-2; }
  let write=old==0.0 || weight/total>=0.5;
  if(blend==2501) { write=weight>=0.5; }
  let i=0;
  while(i<lanes) {
    let handle=ux_f64(incoming+i*8);
    if(handle-handle!=0.0 || handle<0.0 || handle>4294967295.0 ||
       handle!=0.0+f64_floor_i64(handle)) { return 0-2; }
    i=i+1;
  }
  if(write) { let copy=uxe_copy_record(target,incoming,lanes*8); }
  else if(old==0.0) { let copy=uxe_copy_record(target,rows,lanes*8); }
  let saved=ux_f64_put(mixer+slot,total);
  return mixer;
}

native function PropertyMixer_applySelection(mixer:i64) i64 {
  let lanes=property_mixer_lanes(mixer);
  if(lanes<0) { return 0-1; }
  let rows=ux_u32(mixer+PropertyMixer.rows);
  let source=rows;
  if(ux_f64(mixer+PropertyMixer.weight)>0.5) { source=rows+lanes*8; }
  if(ux_f64(mixer+PropertyMixer.addWeight)>0.0) { source=rows+lanes*16; }
  let result=uxe_copy_record(rows+lanes*24,source,lanes*8);
  let a=ux_f64_put(mixer+PropertyMixer.weight,0.0);
  let b=ux_f64_put(mixer+PropertyMixer.addWeight,0.0);
  return result;
}
