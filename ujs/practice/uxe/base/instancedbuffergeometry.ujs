function InstancedBufferGeometry_init(ig_dst,...ig_args) {
  let ig_base=BufferGeometry_init(ig_dst,ig_args[0],ig_args[1],ig_args[2],ig_args[3]);
  if(ig_base>=0) { let ig_all=ux_u32_put(ig_dst+InstancedBufferGeometry.instanceCount,4294967295); }
  return ig_base;
}

function InstancedBufferGeometry_setCount(ig_count,...ig_count_args) {
  let ig_out=0-1;
  if(ig_count_args[0]>=0 && ig_count_args[0]<=4294967295) {
    let ig_write=ux_u32_put(ig_count+InstancedBufferGeometry.instanceCount,ig_count_args[0]);
    ig_out=ig_count;
  }
  return ig_out;
}

function InstancedBufferGeometry_getCount(ig_get) {
  return ux_u32(ig_get+InstancedBufferGeometry.instanceCount);
}
