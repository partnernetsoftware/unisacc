// Write the modeled public fields with an externally assigned Source UUID.
native function LayeredTextureObject_json(at:i64,dst:i64,end:i64,uuid:i64,bytes:i64,scratch:i64) i64 {
  if(!layer_obj_valid(at) || dst<0 || end<dst || end>6291456 || end-dst<9 ||
     uuid<0 || uuid>6291456 || bytes<=0 || bytes>6291456-uuid ||
     !layer_obj_span(scratch,1104) || scratch%8!=0 ||
     !layer_obj_split(at,LayeredTextureObject.size,dst,end-dst) ||
     !layer_obj_split(at,LayeredTextureObject.size,scratch,1104) ||
     !layer_obj_split(dst,end-dst,scratch,1104) || !layer_obj_split(uuid,bytes,dst,end-dst) ||
     !layer_obj_split(uuid,bytes,scratch,1104)) { return 0-1; }
  let source=ux_u32(at+LayeredTextureObject.source);
  let dispatch=ux_u32(at+LayeredTextureObject.dispatcher);
  if(!layer_obj_event_space(dst,end-dst,dispatch,source) ||
     !layer_obj_event_space(scratch,1104,dispatch,source) ||
     !layer_obj_source_space(source,dst,end-dst) ||
     !layer_obj_source_space(source,scratch,1104)) { return 0-1; }
  let prefix=[123,34,105,109,97,103,101,34,58];
  let i=0;
  while(i<9) { let byte=ux_u8_put(dst+i,prefix[i]); i=i+1; }
  let p=json_write_string(dst+9,end,uuid,bytes);
  let wrap=[44,34,119,114,97,112,34,58,91];
  i=0;
  while(i<9) { p=json_byte(p,end,wrap[i]); i=i+1; }
  p=json_write_f64(p,end,0.0+ux_u32(at+LayeredTextureObject.wrapS),scratch);
  p=json_byte(p,end,44);
  p=json_write_f64(p,end,0.0+ux_u32(at+LayeredTextureObject.wrapT),scratch);
  p=json_byte(p,end,93);
  let space=[44,34,99,111,108,111,114,83,112,97,99,101,34,58,34,34];
  i=0;
  while(i<16) { p=json_byte(p,end,space[i]); i=i+1; }
  p=material_json_field(p,end,29113321738232173,0,0,14,300.0,scratch); // mapping
  p=material_json_field(p,end,30510822457436259,0,0,14,0.0,scratch); // channel
  p=material_json_field(p,end,127961796865894,0,0,12,0.0+ux_u32(at+LayeredTextureObject.format),scratch);
  p=material_json_field(p,end,1701869940,0,0,8,1009.0,scratch); // type
  p=material_json_field(p,end,7310587294538164589,114,0,18,0.0+ux_u32(at+LayeredTextureObject.minFilter),scratch);
  p=material_json_field(p,end,7310587294537703789,114,0,18,0.0+ux_u32(at+LayeredTextureObject.magFilter),scratch);
  p=material_json_field(p,end,8030609107581496929,31088,0,20,1.0,scratch); // anisotropy
  p=material_json_field(p,end,384138046566,0,0,11,0.0+ux_u32(at+LayeredTextureObject.flipY),scratch);
  p=material_json_field(p,end,7310575239085057383,32493186071947597,0,31,0.0+ux_u32(at+LayeredTextureObject.generateMipmaps),scratch);
  p=material_json_field(p,end,7598817722883207792,7018983629514173552,0,33,0.0+ux_u32(at+LayeredTextureObject.premultiplyAlpha),scratch);
  p=material_json_field(p,end,7800634104163102325,32772479205140329,0,30,0.0+ux_u32(at+LayeredTextureObject.unpackAlignment),scratch);
  return json_byte(p,end,125);
}
