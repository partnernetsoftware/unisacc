native function torus_knot_geometry_keys(at:i64) i64 {
  let labels=[84,111,114,117,115,75,110,111,116,71,101,111,109,101,116,114,121,
    114,97,100,105,117,115,116,117,98,101,
    116,117,98,117,108,97,114,83,101,103,109,101,110,116,115,
    114,97,100,105,97,108,83,101,103,109,101,110,116,115,112,113];
  let i=0;
  while(i<58) {
    let byte=ux_u8_put(at+i,labels[i]);
    i=i+1;
  }
  return at;
}

native function TorusKnotGeometry_toJSON(knot:i64,dst:i64,end:i64,uuid:i64,uuidBytes:i64,scratch:i64) i64 {
  if(geometry_primitive_ready(knot,8)<0 ||
     !geometry_primitive_json_io(knot,dst,end,uuid,uuidBytes,scratch,58)) { return 0-1; }
  let keys=torus_knot_geometry_keys(scratch+1104);
  let next=geometry_primitive_json_head(knot,dst,end,uuid,uuidBytes,keys,17);
  next=geometry_parameter_number(next,end,keys+17,6,ux_f64(knot+GeometryPrimitiveRecord.first),scratch);
  next=geometry_parameter_number(next,end,keys+23,4,ux_f64(knot+GeometryPrimitiveRecord.second),scratch);
  next=geometry_parameter_number(next,end,keys+27,15,ux_f64(knot+GeometryPrimitiveRecord.third),scratch);
  next=geometry_parameter_number(next,end,keys+42,14,ux_f64(knot+GeometryPrimitiveRecord.fourth),scratch);
  next=geometry_parameter_number(next,end,keys+56,1,ux_f64(knot+GeometryPrimitiveRecord.fifth),scratch);
  next=geometry_parameter_number(next,end,keys+57,1,ux_f64(knot+GeometryPrimitiveRecord.sixth),scratch);
  return json_byte(next,end,125);
}

native function TorusKnotGeometry_fromJSON(knot:i64,raw:i64,arena:i64,bytes:i64,input:i64,end:i64,scratch:i64,work:i64) i64 {
  let space=TorusKnotGeometryParameters.size+58;
  if(scratch%8!=0 || work%8!=0 || end<=input ||
     !geometry_primitive_raw(knot,raw,arena,bytes,input,end-input) ||
     !geometry_primitive_raw(knot,raw,arena,bytes,scratch,space) ||
     !geometry_primitive_raw(knot,raw,arena,bytes,work,120) ||
     !geometry_public_disjoint(input,end-input,scratch,space) ||
     !geometry_public_disjoint(input,end-input,work,120) ||
     !geometry_public_disjoint(scratch,space,work,120) ||
     !geometry_primitive_json_object(input,end)) { return 0-1; }
  let keys=torus_knot_geometry_keys(scratch+TorusKnotGeometryParameters.size);
  let a=ux_f64_put(scratch+TorusKnotGeometryParameters.radius,geometry_primitive_json_number(input,end,keys+17,6,1.0));
  let b=ux_f64_put(scratch+TorusKnotGeometryParameters.tube,geometry_primitive_json_number(input,end,keys+23,4,0.4));
  let c=ux_f64_put(scratch+TorusKnotGeometryParameters.tubularSegments,geometry_primitive_json_number(input,end,keys+27,15,64.0));
  let d=ux_f64_put(scratch+TorusKnotGeometryParameters.radialSegments,geometry_primitive_json_number(input,end,keys+42,14,8.0));
  let e=ux_f64_put(scratch+TorusKnotGeometryParameters.p,geometry_primitive_json_number(input,end,keys+56,1,2.0));
  let f=ux_f64_put(scratch+TorusKnotGeometryParameters.q,geometry_primitive_json_number(input,end,keys+57,1,3.0));
  return TorusKnotGeometry_create(knot,raw,arena,bytes,scratch,work);
}
