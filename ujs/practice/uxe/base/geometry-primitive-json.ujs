native function geometry_primitive_json_io(at:i64,dst:i64,end:i64,uuid:i64,uuidBytes:i64,scratch:i64,labels:i64) i64 {
  let bytes=end-dst;
  let name=ux_u32(at+GeometryPrimitiveRecord.name);
  let nameBytes=ux_u32(at+GeometryPrimitiveRecord.nameBytes);
  let space=1104+labels;
  return geometry_public_span(dst,bytes) && geometry_public_span(uuid,uuidBytes) &&
    geometry_public_span(name,nameBytes) && scratch%8==0 && geometry_public_span(scratch,space) &&
    geometry_public_disjoint(dst,bytes,scratch,space) &&
    geometry_public_disjoint(dst,bytes,at,GeometryPrimitive_size()) &&
    geometry_public_disjoint(scratch,space,at,GeometryPrimitive_size()) &&
    geometry_public_disjoint(dst,bytes,uuid,uuidBytes) &&
    geometry_public_disjoint(dst,bytes,name,nameBytes) &&
    geometry_public_disjoint(scratch,space,uuid,uuidBytes) &&
    geometry_public_disjoint(scratch,space,name,nameBytes);
}

native function geometry_primitive_json_head(at:i64,dst:i64,end:i64,uuid:i64,uuidBytes:i64,kind:i64,kindBytes:i64) i64 {
  return geometry_parameter_header(dst,end,uuid,uuidBytes,kind,kindBytes,
    ux_u32(at+GeometryPrimitiveRecord.name),ux_u32(at+GeometryPrimitiveRecord.nameBytes));
}

native function geometry_primitive_json_number(input:i64,end:i64,key:i64,size:i64,fallback:f64) f64 {
  let value=json_find_key(input,end,key,size);
  if(value==0-2) { return fallback; }
  return json_read_number(value,end);
}

native function geometry_primitive_json_object(input:i64,end:i64) i64 {
  let start=json_space(input,end);
  if(start<0 || start>=end || ux_u8(start)!=123) { return 0; }
  let tail=json_value_end(start,end);
  return tail>=0 && json_space(tail,end)==end;
}
