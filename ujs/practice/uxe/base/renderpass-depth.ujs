// r160 clears depth on the currently bound framebuffer before binding the
// RenderPass destination. The clear and bind share one packet transaction.
native function RenderPass_beginDepth(packet:i64,capacity:i64,step:i64,mask:i64,rgba:i64,depth:f64,stencil:i64,clearDepth:i64) i64 {
  if(clearDepth==0) { return RenderPass_begin(packet,capacity,step,mask,rgba,depth,stencil); }
  if(clearDepth!=1 || gpu_packet_slot(packet,capacity,12)<0) { return 0-1; }
  let bytes=ux_u32(packet+GpuPacket.bytes);
  let commands=ux_u32(packet+GpuPacket.commands);
  let cleared=GpuPacket_clearDepth(packet,capacity,1.0);
  if(cleared<0) { return cleared; }
  let begun=RenderPass_begin(packet,capacity,step,mask,rgba,depth,stencil);
  if(begun<0) {
    let oldBytes=ux_u32_put(packet+GpuPacket.bytes,bytes);
    let oldCount=ux_u32_put(packet+GpuPacket.commands,commands);
  }
  return begun;
}
