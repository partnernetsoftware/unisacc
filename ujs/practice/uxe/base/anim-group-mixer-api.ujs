// The group tag is outside the valid single-binding slot count range.
native function AnimationMixer_initGroup(mixer:i64,batch:i64) i64 {
  if(!animation_span(mixer,AnimationMixer.size) || mixer%8!=0 ||
     group_batch_validate(batch,mixer)<0) { return 0-1; }
  let target=ux_u32_put(mixer+AnimationMixer.binding,batch);
  let tag=ux_u32_put(mixer+AnimationMixer.count,4294967295);
  let time=ux_f64_put(mixer+AnimationMixer.time,0.0);
  return mixer;
}

native function AnimationMixer_update(mixer:i64,dt:f64) i64 {
  if(!animation_span(mixer,AnimationMixer.size) || mixer%8!=0) { return 0-1; }
  if(ux_u32(mixer+AnimationMixer.count)!=4294967295) { return mixer_update_object(mixer,dt,0); }
  let time=ux_f64(mixer+AnimationMixer.time)+dt;
  if(time-time!=0.0) { return 0-1; }
  let result=group_mixer_batch_step(ux_u32(mixer+AnimationMixer.binding),dt,0,mixer);
  if(result<0) { return result; }
  let saved=ux_f64_put(mixer+AnimationMixer.time,time);
  return mixer;
}

native function AnimationMixer_stopAllAction(mixer:i64) i64 {
  if(!animation_span(mixer,AnimationMixer.size) || mixer%8!=0) { return 0-1; }
  if(ux_u32(mixer+AnimationMixer.count)!=4294967295) { return mixer_stop_object(mixer); }
  let result=group_mixer_batch_step(ux_u32(mixer+AnimationMixer.binding),0.0,1,mixer);
  if(result<0) { return result; }
  return mixer;
}
