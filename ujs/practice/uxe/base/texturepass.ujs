// The source is a 2D GPU color attachment. A TexturePass draws without swapping.
native function TexturePass_render(step:i64,generation:i64,source:i64,shader:i64,opacity:f64) i64 {
  if(!composer_span(step,ComposerStep.size) || !composer_span(shader,GpuShaderSource.size) ||
     generation<1 || generation>4294967295 || source<1 || source>1024 ||
     opacity!=opacity || opacity<0.0 || opacity>1.0) { return 0-1; }
  let screen=ux_u32(step+ComposerStep.screen);
  let output=ux_u32(step+ComposerStep.read);
  if(ux_u32(step+ComposerStep.flags)!=1 || screen>1 || output<1 || output>1024) { return 0-1; }
  if(screen==1) { output=0; }
  if(output==source) { return 0-1; }
  return host_gpu_native_overlay(generation,source,output,shader,opacity);
}
