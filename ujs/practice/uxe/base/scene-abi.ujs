// The module owns its tree and matrices. Consumers receive scalars.
export uxe_scene(op:i64, first:i64, second:i64, x:f64, y:f64, z:f64) f64 version 1;

if(op==0) {
  let arena=Object3D_initArena(0,first);
  if(arena<0) { return 0.0-1.0; }
  return 0.0+Scene_create(arena);
}
if(op==1) {
  let child=Object3D_create(0);
  if(child<0) { return 0.0+child; }
  let node=Object3D_address(0,child);
  let pose=ux_u32(node+Object3D.position);
  let dx=ux_f64_put(pose,x);
  let dy=ux_f64_put(pose+8,y);
  let dz=ux_f64_put(pose+16,z);
  let parent=Object3D_add(0,first,child);
  if(parent<0) {
    let removed=Object3D_destroy(0,child);
    return 0.0+parent;
  }
  return 0.0+child;
}
if(op==2) { return 0.0+Object3D_updateWorldMatrix(0,first,1,1); }
if(op==3) {
  let source=Object3D_address(0,first);
  if(source<0 || second<0 || second>=16) { return 0.0/0.0; }
  return ux_f64(ux_u32(source+Object3D.worldMatrix)+second*8);
}
if(op==4) { return 0.0+Object3D_traverseNext(0,first,second,1); }
return 0.0/0.0;
