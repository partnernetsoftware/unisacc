native function BoxGeometry_generate(box:i64,width:f64,height:f64,depth:f64,
                                     sx:i64,sy:i64,sz:i64) i64 {
  if(sx<1 || sy<1 || sz<1 || sx>131072 || sy>131072 || sz>131072) { return 0-1; }
  let box_points=2*((sx+1)*(sy+1)+(sy+1)*(sz+1)+(sz+1)*(sx+1));
  let box_cells=12*(sx*sy+sy*sz+sz*sx);
  if(!GeometryBuffers_fits(box,box_points,box_cells)) { return 0-1; }
  let box_vertex=ux_u32(box+GeometryBuffers.vertices);
  let box_index=ux_u32(box+GeometryBuffers.indices);
  let box_face=0;
  let box_first=0;
  while(box_face<6) {
    let face_axis=box_face/2;
    let face_sign=1.0-2.0*(box_face%2);
    let face_u_sign=1.0;
    let face_v_sign=0.0-1.0;
    let face_cols=sx;
    let face_rows=sy;
    let face_width=width;
    let face_height=height;
    let face_offset=depth*face_sign*0.5;
    if(face_axis==0) {
      face_cols=sz;
      face_width=depth;
      face_u_sign=0.0-face_sign;
      face_offset=width*face_sign*0.5;
    }
    if(face_axis==1) {
      face_rows=sz;
      face_height=depth;
      face_v_sign=face_sign;
      face_offset=height*face_sign*0.5;
    }
    if(face_axis==2) { face_u_sign=face_sign; }
    let box_normal=1.0;
    if(face_offset<=0.0) { box_normal=0.0-1.0; }
    let face_row=0;
    while(face_row<=face_rows) {
      let face_v=face_row*1.0/face_rows;
      let face_y=(face_v-0.5)*face_height*face_v_sign;
      let face_col=0;
      while(face_col<=face_cols) {
        let face_u=face_col*1.0/face_cols;
        let face_x=(face_u-0.5)*face_width*face_u_sign;
        let box_x=face_x;
        let box_y=face_y;
        let box_z=face_offset;
        let box_nx=0.0;
        let box_ny=0.0;
        let box_nz=box_normal;
        if(face_axis==0) {
          box_x=face_offset;
          box_z=face_x;
          box_nx=box_normal;
          box_nz=0.0;
        }
        if(face_axis==1) {
          box_y=face_offset;
          box_z=face_y;
          box_ny=box_normal;
          box_nz=0.0;
        }
        box_vertex=GeometryBuffers_vertex(box_vertex,box_x,box_y,box_z,box_nx,box_ny,box_nz,face_u,1.0-face_v);
        if(face_col<face_cols && face_row<face_rows) {
          let start=box_first+face_row*(face_cols+1)+face_col;
          box_index=geometry_quad(box_index,start,start+face_cols+1,start+face_cols+2,start+1);
        }
        face_col=face_col+1;
      }
      face_row=face_row+1;
    }
    box_first=box_first+(face_cols+1)*(face_rows+1);
    box_face=box_face+1;
  }
  return GeometryBuffers_commit(box,box_points,box_cells);
}
