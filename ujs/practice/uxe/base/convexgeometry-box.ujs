// Exact box hull for a set containing all eight corners. Redundant interior
// and face points are accepted. Other clouds use the general-position entry.
native function ConvexGeometry_boxHull(mesh:i64,points:i64,count:i64) i64 {
  if(mesh<0 || mesh%4!=0 || mesh>6291456-GeometryBuffers.size || points<0 || points%8!=0 ||
     count<8 || count>4096 || points>6291456-24*count || !GeometryBuffers_fits(mesh,36,0)) { return 0-1; }
  let out=ux_u32(mesh+GeometryBuffers.vertices);
  if(out>6291456-1152 || out%4!=0 ||
     (out<points+24*count && points<out+1152) ||
     (out<mesh+GeometryBuffers.size && mesh<out+1152) ||
     (mesh<points+24*count && points<mesh+GeometryBuffers.size)) { return 0-1; }
  let loX=ux_f64(points); let hiX=loX;
  let loY=ux_f64(points+8); let hiY=loY;
  let loZ=ux_f64(points+16); let hiZ=loZ;
  let i=0;
  while(i<count) {
    let at=points+24*i;
    let x=ux_f64(at); let y=ux_f64(at+8); let z=ux_f64(at+16);
    if(x-x!=0.0 || y-y!=0.0 || z-z!=0.0) { return 0-2; }
    if(x<loX) { loX=x; } if(x>hiX) { hiX=x; }
    if(y<loY) { loY=y; } if(y>hiY) { hiY=y; }
    if(z<loZ) { loZ=z; } if(z>hiZ) { hiZ=z; }
    i=i+1;
  }
  if(loX==hiX || loY==hiY || loZ==hiZ) { return 0-2; }
  let covered=0;
  i=0;
  while(i<count) {
    let at=points+24*i;
    let x=ux_f64(at); let y=ux_f64(at+8); let z=ux_f64(at+16);
    if((x==loX || x==hiX) && (y==loY || y==hiY) && (z==loZ || z==hiZ)) {
      let corner=(x==hiX)+2*(y==hiY)+4*(z==hiZ);
      covered=u32_or(covered,u32_shl(1,corner));
    }
    i=i+1;
  }
  if(covered!=255) { return 0-2; }
  let triangles=[0,4,6,0,6,2,1,3,7,1,7,5,0,1,5,0,5,4,
                 2,6,7,2,7,3,0,2,3,0,3,1,4,5,7,4,7,6];
  i=0;
  while(i<36) {
    let corner=triangles[i];
    let x=loX; let y=loY; let z=loZ;
    if(corner%2) { x=hiX; }
    if((corner/2)%2) { y=hiY; }
    if(corner>=4) { z=hiZ; }
    let axis=i/12;
    let sign=1.0;
    if((i/6)%2==0) { sign=0.0-1.0; }
    let pushed=GeometryBuffers_vertex(out+32*i,x,y,z,
      sign*(axis==0),sign*(axis==1),sign*(axis==2),0.0,0.0);
    i=i+1;
  }
  return GeometryBuffers_commit(mesh,36,0);
}
