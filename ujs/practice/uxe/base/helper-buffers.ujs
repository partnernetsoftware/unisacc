native function helper_buffer_span(at:i64,bytes:i64,align:i64) i64 {
  return at>=0 && at%align==0 && at<=6291456-bytes;
}

native function helper_buffer_disjoint(a:i64,n:i64,b:i64,m:i64) i64 {
  return n==0 || m==0 || a+n<=b || b+m<=a;
}

native function helper_f32_fits(value:f64) i64 {
  // Largest finite f32, (2^24 - 1) * 2^104.
  let bound=16777215.0*1099511627776.0*1099511627776.0*16777216.0;
  return value>=0.0-bound && value<=bound;
}
