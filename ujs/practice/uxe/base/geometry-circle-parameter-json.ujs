native function circle_geometry_keys(at:i64) i64 {
  let labels=[67,105,114,99,108,101,71,101,111,109,101,116,114,121,
    114,97,100,105,117,115,115,101,103,109,101,110,116,115,
    116,104,101,116,97,83,116,97,114,116,116,104,101,116,97,76,101,110,103,116,104];
  let i=0;
  while(i<49) {
    let byte=ux_u8_put(at+i,labels[i]);
    i=i+1;
  }
  return at;
}

native function CircleGeometry_toJSON(circle:i64,dst:i64,end:i64,uuid:i64,uuidBytes:i64,scratch:i64) i64 {
  if(geometry_primitive_ready(circle,2)<0 ||
     !geometry_primitive_json_io(circle,dst,end,uuid,uuidBytes,scratch,49)) { return 0-1; }
  let keys=circle_geometry_keys(scratch+1104);
  let p=geometry_primitive_json_head(circle,dst,end,uuid,uuidBytes,keys,14);
  p=geometry_parameter_number(p,end,keys+14,6,ux_f64(circle+GeometryPrimitiveRecord.first),scratch);
  p=geometry_parameter_number(p,end,keys+20,8,ux_f64(circle+GeometryPrimitiveRecord.second),scratch);
  p=geometry_parameter_number(p,end,keys+28,10,ux_f64(circle+GeometryPrimitiveRecord.third),scratch);
  p=geometry_parameter_number(p,end,keys+38,11,ux_f64(circle+GeometryPrimitiveRecord.fourth),scratch);
  return json_byte(p,end,125);
}

native function CircleGeometry_fromJSON(circle:i64,raw:i64,arena:i64,bytes:i64,input:i64,end:i64,scratch:i64) i64 {
  if(end<=input || !geometry_primitive_raw(circle,raw,arena,bytes,input,end-input) ||
     !geometry_primitive_raw(circle,raw,arena,bytes,scratch,49) ||
     !geometry_public_disjoint(input,end-input,scratch,49) ||
     !geometry_primitive_json_object(input,end)) { return 0-1; }
  let keys=circle_geometry_keys(scratch);
  return CircleGeometry_create(circle,raw,arena,bytes,
    geometry_primitive_json_number(input,end,keys+14,6,1.0),
    geometry_primitive_json_number(input,end,keys+20,8,32.0),
    geometry_primitive_json_number(input,end,keys+28,10,0.0),
    geometry_primitive_json_number(input,end,keys+38,11,6.283185307179586));
}
