// On success the caller owns the descriptor. For a sparse index stream
// the caller also owns target; otherwise the descriptor borrows GLB bytes.
// Return -8 for an implicit stream.
native function GltfLoader_primitiveIndex(glb:i64,mesh:i64,primitive:i64,out:i64,target:i64,capacity:i64,key:i64) i64 {
  if(!loading_span(glb,GlbResource.size) || !loading_span(out,GltfAccessor.size) ||
     !loading_span(key,16) || !loading_span(target,capacity) ||
     !file_disjoint(glb,GlbResource.size,key,16) || !file_disjoint(key,16,out,GltfAccessor.size) ||
     !file_disjoint(key,16,target,capacity)) { return 0-1; }
  let json=ux_u32(glb+GlbResource.json);
  let bytes=ux_u32(glb+GlbResource.jsonBytes);
  let bin=ux_u32(glb+GlbResource.bin);
  let binBytes=ux_u32(glb+GlbResource.binBytes);
  if(!loading_span(json,bytes) || !loading_span(bin,binBytes) ||
     !file_disjoint(json,bytes,key,16) || !file_disjoint(bin,binBytes,key,16)) { return 0-1; }
  let end=json+bytes;
  let meshRow=LoaderJson_item(LoaderJson_find(json,end,key,1752393069,29541,0,6),end,mesh);
  let row=LoaderJson_item(LoaderJson_find(meshRow,end,key,1835627120,1986622569,29541,10),end,primitive);
  if(row<0) { return 0-2; }
  let token=LoaderJson_find(row,end,key,1768189545,7562595,0,7);
  if(token==0-2) { return 0-8; }
  let number=LoaderJson_uint(token,end,0-1);
  if(number<0) { return 0-3; }
  let dense=GltfLoader_accessor(glb,number,out,key);
  if(dense!=0-7) { return dense; }
  return GltfLoader_sparseAccessor(glb,number,out,target,capacity,key);
}
