struct TorusKnotGeometryParameters {
  radius: f64;
  tube: f64;
  tubularSegments: f64;
  radialSegments: f64;
  p: f64;
  q: f64;
}

native function TorusKnotGeometry_create(at:i64,raw:i64,arena:i64,bytes:i64,params:i64,work:i64) i64 {
  if(params%8!=0 || work%8!=0 ||
     !geometry_primitive_raw(at,raw,arena,bytes,params,TorusKnotGeometryParameters.size) ||
     !geometry_primitive_raw(at,raw,arena,bytes,work,120) ||
     !geometry_public_disjoint(params,TorusKnotGeometryParameters.size,work,120)) { return 0-1; }
  let radius=ux_f64(params+TorusKnotGeometryParameters.radius);
  let tube=ux_f64(params+TorusKnotGeometryParameters.tube);
  let tubular=ux_f64(params+TorusKnotGeometryParameters.tubularSegments);
  let radial=ux_f64(params+TorusKnotGeometryParameters.radialSegments);
  let p=ux_f64(params+TorusKnotGeometryParameters.p);
  let q=ux_f64(params+TorusKnotGeometryParameters.q);
  let bound=3.0*radius;
  if(!(radius>0.0) || bound-bound!=0.0 || tube-tube!=0.0 || p==0.0 ||
     !(tubular>=1.0 && tubular<262145.0) || !(radial>=1.0 && radial<262145.0)) { return 0-1; }
  let end=p*6.283185307179586;
  let twist=q*6.283185307179586;
  let ratio=q/p;
  let endTwist=(end+0.01)*ratio;
  if(end-end!=0.0 || twist-twist!=0.0 || ratio-ratio!=0.0 ||
     endTwist-endTwist!=0.0) { return 0-1; }
  let generated=TorusKnotGeometry_generate(raw,work,radius,tube,f64_floor_i64(tubular),f64_floor_i64(radial),p,q);
  if(generated<0) { return generated; }
  let installed=GeometryBuffers_asGeometry(raw,GeometryPrimitive_geometry(at),arena,bytes,7,0,0);
  if(installed<0) { return installed; }
  return geometry_primitive_store(at,8,radius,tube,tubular,radial,p,q);
}

native function TorusKnotGeometry_copy(dst:i64,src:i64,arena:i64,bytes:i64) i64 {
  return geometry_primitive_copy(dst,src,arena,bytes,8);
}

native function TorusKnotGeometry_clone(dst:i64,src:i64,arena:i64,bytes:i64) i64 {
  return geometry_primitive_clone(dst,src,arena,bytes,8);
}

native function TorusKnotGeometry_dispose(at:i64,event:i64,out:i64,limit:i64) i64 {
  return geometry_primitive_dispose(at,event,out,limit,8);
}
