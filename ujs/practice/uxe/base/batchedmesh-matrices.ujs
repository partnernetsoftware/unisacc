// Rows match the four RGBA texels per geometry used by r160 BatchedMesh.
native function batch_matrix_row(batch:i64,id:i64,storage:i64,bytes:i64) i64 {
  if(!batch_valid(batch) || id<0 || id>=ux_u32(batch+BatchedMesh.count) ||
     storage<0 || storage%4!=0 || bytes<0 || storage>6291456-bytes ||
     id>=bytes/64) { return 0-1; }
  if(BatchedMesh_getRange(batch,id)<0) { return 0-1; }
  let row=storage+id*64;
  let geometry=ux_u32(batch+BatchedMesh.rows);
  let capacity=ux_u32(batch+BatchedMesh.capacity);
  if((row<batch+BatchedMesh.size && batch<row+64) ||
     (row<geometry+capacity*BatchGeometry.size && geometry<row+64)) { return 0-1; }
  return row;
}

native function BatchedMesh_setMatrixAt(batch:i64,id:i64,storage:i64,bytes:i64,matrix:i64) i64 {
  let row=batch_matrix_row(batch,id,storage,bytes);
  if(row<0 || matrix<0 || matrix%8!=0 || matrix>6291328 ||
     (matrix<row+64 && row<matrix+128)) { return 0-1; }
  let i=0;
  while(i<16) {
    let saved=ux_f32_put(row+i*4,ux_f64(matrix+i*8));
    i=i+1;
  }
  return batch;
}

native function BatchedMesh_getMatrixAt(batch:i64,id:i64,storage:i64,bytes:i64,matrix:i64) i64 {
  let row=batch_matrix_row(batch,id,storage,bytes);
  if(row<0 || matrix<0 || matrix%8!=0 || matrix>6291328 ||
     (matrix<storage+bytes && storage<matrix+128) ||
     (matrix<batch+BatchedMesh.size && batch<matrix+128)) { return 0-1; }
  let geometry=ux_u32(batch+BatchedMesh.rows);
  let capacity=ux_u32(batch+BatchedMesh.capacity);
  if(matrix<geometry+capacity*BatchGeometry.size && geometry<matrix+128) { return 0-1; }
  let i=0;
  while(i<16) {
    let saved=ux_f64_put(matrix+i*8,ux_f32(row+i*4));
    i=i+1;
  }
  return matrix;
}
