native function gltf_sparse_view(json:i64,end:i64,key:i64,description:i64) i64 {
  let index=LoaderJson_uint(LoaderJson_find(description,end,key,1717990754,1767273061,30565,10),end,0-1);
  return LoaderJson_item(LoaderJson_find(json,end,key,1717990754,1767273061,7567205,11),end,index);
}

native function gltf_sparse_span(glb:i64,view:i64,relative:i64,count:i64,stride:i64,element:i64,alignment:i64,key:i64) i64 {
  let end=ux_u32(glb+GlbResource.json)+ux_u32(glb+GlbResource.jsonBytes);
  if(view<0 || relative<0 || count<=0 || stride<element ||
     LoaderJson_uint(LoaderJson_find(view,end,key,1717990754,29285,0,6),end,0-1)!=0) { return 0-3; }
  let offset=LoaderJson_uint(LoaderJson_find(view,end,key,1702132066,1936090703,29797,10),end,0);
  let length=LoaderJson_uint(LoaderJson_find(view,end,key,1702132066,1735288140,26740,10),end,0-1);
  let total=ux_u32(glb+GlbResource.binBytes);
  if(offset<0 || length<element || offset>total-length || relative>length-element ||
     (offset+relative)%alignment!=0 || count-1>(length-relative-element)/stride) { return 0-3; }
  return ux_u32(glb+GlbResource.bin)+offset+relative;
}

native function gltf_sparse_index(at:i64,width:i64) i64 {
  if(width==1) { return ux_u8(at); }
  if(width==2) { return ux_u16(at); }
  return ux_u32(at);
}

// Materialize a sparse accessor into owned, tightly packed storage. Validate
// every range and patch index before writing either samples or the descriptor.
native function GltfLoader_sparseAccessor(glb:i64,index:i64,out:i64,target:i64,capacity:i64,key:i64) i64 {
  if(!loading_span(glb,GlbResource.size) || !loading_span(out,GltfAccessor.size) ||
     !loading_span(target,capacity) || target%4!=0 || !loading_span(key,16) ||
     !file_disjoint(out,GltfAccessor.size,target,capacity) ||
     !file_disjoint(out,GltfAccessor.size,key,16) || !file_disjoint(target,capacity,key,16) ||
     !file_disjoint(glb,GlbResource.size,out,GltfAccessor.size) ||
     !file_disjoint(glb,GlbResource.size,target,capacity) || !file_disjoint(glb,GlbResource.size,key,16)) { return 0-1; }
  let json=ux_u32(glb+GlbResource.json);
  let json_bytes=ux_u32(glb+GlbResource.jsonBytes);
  let bin=ux_u32(glb+GlbResource.bin);
  let bin_bytes=ux_u32(glb+GlbResource.binBytes);
  if(!loading_span(json,json_bytes) || bin<1 || !loading_span(bin,bin_bytes) ||
     !file_disjoint(json,json_bytes,out,GltfAccessor.size) || !file_disjoint(bin,bin_bytes,out,GltfAccessor.size) ||
     !file_disjoint(json,json_bytes,target,capacity) || !file_disjoint(bin,bin_bytes,target,capacity) ||
     !file_disjoint(json,json_bytes,key,16) || !file_disjoint(bin,bin_bytes,key,16)) { return 0-1; }
  let end=json+json_bytes;
  let accessor=LoaderJson_item(LoaderJson_find(json,end,key,1701012321,1919906675,115,9),end,index);
  if(accessor<0) { return 0-2; }
  let sparse=LoaderJson_find(accessor,end,key,1918988403,25971,0,6);
  let patch_count=LoaderJson_uint(LoaderJson_find(sparse,end,key,1853189987,116,0,5),end,0-1);
  let count=LoaderJson_uint(LoaderJson_find(accessor,end,key,1853189987,116,0,5),end,0-1);
  let shape=gltf_shape(LoaderJson_find(accessor,end,key,1701869940,0,0,4),end);
  let suffix=ux_u8_put(key+12,101);
  let component=LoaderJson_uint(LoaderJson_find(accessor,end,key,1886220131,1852141167,1886999668,13),end,0-1);
  if(count<1 || patch_count<1 || patch_count>count || shape<0 ||
     component<5120 || component>5126 || component==5124) { return 0-2; }
  let unit=1;
  if(component==5122 || component==5123) { unit=2; }
  if(component>=5125) { unit=4; }
  let flag=LoaderJson_find(accessor,end,key,1836216174,2053729377,25701,10);
  let normalized=0;
  if(flag>=0) {
    if(ux_u8(flag)!=116 && ux_u8(flag)!=102) { return 0-2; }
    normalized=ux_u8(flag)==116;
    if(normalized && unit==4) { return 0-2; }
  }
  let lanes=shape;
  let element=lanes*unit;
  let alignment=unit;
  if(shape>=32) {
    let columns=shape/16;
    lanes=columns*columns;
    element=(unit*columns+3)/4*4*columns;
    alignment=4;
  }
  if(count>capacity/element) { return 0-4; }
  let base=0;
  let stride=element;
  let relative=LoaderJson_uint(LoaderJson_find(accessor,end,key,1702132066,1936090703,29797,10),end,0);
  let base_view=gltf_sparse_view(json,end,key,accessor);
  if(base_view>=0) {
    let stride_token=LoaderJson_find(base_view,end,key,1702132066,1769108563,25956,10);
    stride=LoaderJson_uint(stride_token,end,element);
    if(relative<0 || relative%unit!=0 || stride<element || stride>252 ||
       (stride_token>=0 && stride%4!=0)) { return 0-3; }
    base=gltf_sparse_span(glb,base_view,relative,count,stride,element,alignment,key);
    if(base<0) { return base; }
  } else if(relative!=0 || LoaderJson_find(accessor,end,key,1717990754,1767273061,30565,10)!=0-2) { return 0-3; }
  let indices=LoaderJson_find(sparse,end,key,1768189545,7562595,0,7);
  let index_view=gltf_sparse_view(json,end,key,indices);
  let index_offset=LoaderJson_uint(LoaderJson_find(indices,end,key,1702132066,1936090703,29797,10),end,0);
  let component_tail=ux_u8_put(key+12,101);
  let index_kind=LoaderJson_uint(LoaderJson_find(indices,end,key,1886220131,1852141167,1886999668,13),end,0-1);
  let width=1;
  if(index_kind==5123) { width=2; }
  else if(index_kind==5125) { width=4; }
  else if(index_kind!=5121) { return 0-3; }
  if(index_offset<0 || index_offset%width!=0 || LoaderJson_find(index_view,end,key,1702132066,1769108563,25956,10)!=0-2) { return 0-3; }
  let offset=gltf_sparse_span(glb,index_view,index_offset,patch_count,width,width,width,key);
  if(offset<0) { return offset; }
  let values=LoaderJson_find(sparse,end,key,1970037110,29541,0,6);
  let value_view=gltf_sparse_view(json,end,key,values);
  let value_offset=LoaderJson_uint(LoaderJson_find(values,end,key,1702132066,1936090703,29797,10),end,0);
  if(value_offset<0 || value_offset%unit!=0 || LoaderJson_find(value_view,end,key,1702132066,1769108563,25956,10)!=0-2) { return 0-3; }
  let source=gltf_sparse_span(glb,value_view,value_offset,patch_count,element,element,alignment,key);
  if(source<0) { return source; }
  let previous=0-1;
  let i=0;
  while(i<patch_count) {
    let slot=gltf_sparse_index(offset+i*width,width);
    if(slot<=previous || slot>=count) { return 0-5; }
    previous=slot;
    i=i+1;
  }
  i=0;
  while(i<count) {
    let j=0;
    while(j<element) {
      let value=0;
      if(base!=0) { value=ux_u8(base+i*stride+j); }
      let saved=ux_u8_put(target+i*element+j,value);
      j=j+1;
    }
    i=i+1;
  }
  i=0;
  while(i<patch_count) {
    let slot=gltf_sparse_index(offset+i*width,width);
    let j=0;
    while(j<element) {
      let saved=ux_u8_put(target+slot*element+j,ux_u8(source+i*element+j));
      j=j+1;
    }
    i=i+1;
  }
  let a=ux_u32_put(out+GltfAccessor.bytes,target);
  let b=ux_u32_put(out+GltfAccessor.count,count);
  let c=ux_u32_put(out+GltfAccessor.stride,element);
  let d=ux_u32_put(out+GltfAccessor.elementBytes,element);
  let e=ux_u32_put(out+GltfAccessor.component,component);
  let f=ux_u32_put(out+GltfAccessor.lanes,lanes);
  let g=ux_u32_put(out+GltfAccessor.normalized,normalized);
  return out;
}
