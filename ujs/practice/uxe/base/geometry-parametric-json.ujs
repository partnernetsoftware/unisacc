native function geometry_parameter_header(dst:i64,end:i64,uuid:i64,uuidBytes:i64,kind:i64,kindBytes:i64,name:i64,nameBytes:i64) i64 {
  let p=json_write_token(dst,end,ObjectJsonToken.geometryHeader);
  p=json_write_string(p,end,uuid,uuidBytes);
  if(p<0 || end-p<8) { return 0-1; }
  let typeKey=[44,34,116,121,112,101,34,58];
  let i=0;
  while(i<8) {
    let byte=ux_u8_put(p+i,typeKey[i]);
    i=i+1;
  }
  p=json_write_string(p+8,end,kind,kindBytes);
  if(nameBytes>0) {
    p=json_write_token(p,end,ObjectJsonToken.nameField);
    p=json_write_string(p,end,name,nameBytes);
  }
  return p;
}

native function geometry_parameter_number(dst:i64,end:i64,key:i64,keyBytes:i64,value:f64,scratch:i64) i64 {
  let p=json_byte(dst,end,44);
  p=json_write_string(p,end,key,keyBytes);
  p=json_byte(p,end,58);
  return json_write_f64(p,end,value,scratch);
}
