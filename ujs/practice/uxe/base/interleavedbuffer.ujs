// Width and stride are byte values. Rows are a caller-owned strided view.
function InterleavedBuffer_init(ib_dst,...ib_args) {
  let ib_base=ib_args[0];
  let ib_count=ib_args[1];
  let ib_stride=ib_args[2];
  let ib_type=ib_args[3];
  let ib_width=BufferAttribute_width(ib_type);
  let ib_out=0-1;
  if(ib_width>0 && ib_base>=0 && ib_base<=6291456 && ib_count>=0 && ib_stride>0) {
    if(ib_base%ib_width==0 && ib_stride%ib_width==0 && ib_count<=(6291456-ib_base)/ib_stride) {
      let ib_span=ux_span(ib_dst,InterleavedBuffer.size);
      let ib_store_base=ux_u32_put(ib_dst+InterleavedBuffer.data,ib_base);
      let ib_store_count=ux_u32_put(ib_dst+InterleavedBuffer.count,ib_count);
      let ib_store_stride=ux_u32_put(ib_dst+InterleavedBuffer.stride,ib_stride);
      let ib_store_type=ux_u32_put(ib_dst+InterleavedBuffer.componentType,ib_type);
      let ib_store_usage=ux_u32_put(ib_dst+InterleavedBuffer.usage,35044);
      let ib_store_version=ux_u32_put(ib_dst+InterleavedBuffer.version,0);
      ib_out=ib_dst;
    }
  }
  return ib_out;
}

function InterleavedBuffer_setUsage(ib_usage,...ib_usage_args) {
  let ib_usage_write=ux_u32_put(ib_usage+InterleavedBuffer.usage,ib_usage_args[0]);
  return ib_usage;
}

function InterleavedBuffer_needsUpdate(ib_update,...ib_update_args) {
  if(ib_update_args[0]!=0) {
    let ib_version=ib_update+InterleavedBuffer.version;
    let ib_bumped=ux_u32_put(ib_version,ux_u32(ib_version)+1);
  }
  return ib_update;
}

function InterleavedBuffer_copy(ib_copy,...ib_copy_args) {
  let ib_source=ib_copy_args[0];
  let ib_rows=ux_u32(ib_source+InterleavedBuffer.count);
  let ib_row_bytes=ux_u32(ib_source+InterleavedBuffer.stride);
  let ib_source_data=ux_u32(ib_source+InterleavedBuffer.data);
  let ib_usage_in=ux_u32(ib_source+InterleavedBuffer.usage);
  let ib_result=0-1;
  if(ib_rows*ib_row_bytes<=ib_copy_args[2]) {
    ib_result=InterleavedBuffer_init(ib_copy,ib_copy_args[1],ib_rows,ib_row_bytes,ux_u32(ib_source+InterleavedBuffer.componentType));
    if(ib_result>=0) {
      let ib_data_copy=BufferAttribute_copyBytes(ib_copy_args[1],ib_source_data,ib_rows*ib_row_bytes);
      let ib_usage_copy=InterleavedBuffer_setUsage(ib_copy,ib_usage_in);
    }
  }
  return ib_result;
}

function InterleavedBuffer_clone(ib_clone,...ib_clone_args) {
  return InterleavedBuffer_copy(ib_clone,ib_clone_args[0],ib_clone_args[1],ib_clone_args[2]);
}
