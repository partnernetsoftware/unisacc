function Clock_init(clock,...clock_init_args) {
  let clock_span=ux_span(clock,Clock.size);
  let clock_start=ux_f64_put(clock+Clock.startTime,0.0);
  let clock_old=ux_f64_put(clock+Clock.oldTime,0.0);
  let clock_elapsed=ux_f64_put(clock+Clock.elapsedTime,0.0);
  let clock_off=ux_u32_put(clock+Clock.running,0);
  let clock_auto=ux_u32_put(clock+Clock.autoStart,clock_init_args[0]!=0);
  return clock;
}

// The caller supplies the monotonic timestamp in seconds.
native function Clock_start(clock_start_self:i64,clock_now:f64) i64 {
  let clock_new_start=ux_f64_put(clock_start_self+Clock.startTime,clock_now);
  let clock_new_old=ux_f64_put(clock_start_self+Clock.oldTime,clock_now);
  let clock_reset=ux_f64_put(clock_start_self+Clock.elapsedTime,0.0);
  let clock_on=ux_u32_put(clock_start_self+Clock.running,1);
  return clock_start_self;
}

native function Clock_getDelta(clock_delta:i64,clock_sample:f64) f64 {
  if(ux_u32(clock_delta+Clock.running)==0) {
    if(ux_u32(clock_delta+Clock.autoStart)!=0) { let clock_started=Clock_start(clock_delta,clock_sample); }
    return 0.0;
  }
  let clock_diff=clock_sample-ux_f64(clock_delta+Clock.oldTime);
  let clock_new_sample=ux_f64_put(clock_delta+Clock.oldTime,clock_sample);
  let clock_sum=ux_f64_put(clock_delta+Clock.elapsedTime,ux_f64(clock_delta+Clock.elapsedTime)+clock_diff);
  return clock_diff;
}

native function Clock_getElapsedTime(clock_total:i64,clock_total_sample:f64) f64 {
  let clock_update=Clock_getDelta(clock_total,clock_total_sample);
  return ux_f64(clock_total+Clock.elapsedTime);
}

native function Clock_stop(clock_stop_self:i64,clock_stop_at:f64) i64 {
  let clock_stop_update=Clock_getElapsedTime(clock_stop_self,clock_stop_at);
  let clock_stopped=ux_u32_put(clock_stop_self+Clock.running,0);
  let clock_disable_auto=ux_u32_put(clock_stop_self+Clock.autoStart,0);
  return clock_stop_self;
}
