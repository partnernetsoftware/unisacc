native function GpuMaterial_toneChannel(mode:i64,value:f64,exposure:f64) f64 {
  if(mode<0 || mode>2 || exposure!=exposure || exposure<0.0 || value!=value || value<0.0) { return 0.0-1.0; }
  if(mode==0) { return value; }
  let exposed=value*exposure;
  if(mode==1) {
    if(exposed>1.0) { return 1.0; }
    return exposed;
  }
  if(exposed>1.0) { return 1.0-1.0/(1.0+exposed); }
  return exposed/(1.0+exposed);
}
