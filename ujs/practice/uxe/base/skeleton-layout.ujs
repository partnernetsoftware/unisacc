struct Skeleton {
  bones: u32;
  inverses: u32;
  palette: u32;
  count: u32;
}

native function skeleton_overlap(a:i64,bytes:i64,b:i64,size:i64) i64 {
  return bytes>0 && size>0 && a<b+size && b<a+bytes;
}

native function skeleton_valid(skeleton:i64) i64 {
  return skeleton>=0 && skeleton<=6291456-Skeleton.size && skeleton%4==0;
}
