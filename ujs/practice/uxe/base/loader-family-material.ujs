native function MaterialLoader_decodeAsync(instance:i64,id:i64,out:i64,key:i64) i64 {
  if(loader_family_kind(instance)!=10 || !loader_family_decode_range(instance,out,LoadedMaterial.size) ||
     !loader_family_decode_range(instance,key,12)) { return 0-1; }
  let file=loader_family_ready(instance,id);
  if(file<0) { return file; }
  let result=MaterialLoader_parse(file,out,key);
  let released=FileLoader_release(file,id);
  return result;
}
