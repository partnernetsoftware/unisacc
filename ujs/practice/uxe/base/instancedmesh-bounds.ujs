native function InstancedMesh_computeBox(instance:i64,local:i64,out:i64,scratch:i64) i64 {
  if(!instance_valid(instance) || local<0 || local>6291456-48 || local%8!=0 ||
     out<0 || out>6291456-48 || out%8!=0 || scratch<0 || scratch>6291456-200 || scratch%8!=0 ||
     instance_overlaps(local,48,out,48) || instance_overlaps(local,48,scratch,200) ||
     instance_overlaps(out,48,scratch,200) ||
     instance_overlaps(instance,InstancedMesh.size,out,48) ||
     instance_overlaps(instance,InstancedMesh.size,scratch,200)) { return 0-1; }
  let n=ux_u32(instance+InstancedMesh.count);
  let matrices=ux_u32(instance+InstancedMesh.matrices);
  if(instance_overlaps(matrices,64*n,out,48) ||
     instance_overlaps(matrices,64*n,scratch,200)) { return 0-1; }
  let empty=Box3_makeEmpty(out);
  let i=0;
  while(i<n) {
    let matrix=InstancedMesh_getMatrixAt(instance,i,scratch);
    if(matrix<0) { return matrix; }
    let bounds=Box3_copy(scratch+128,local);
    let transformed=Box3_applyMatrix4(bounds,matrix,scratch+176);
    let merged=Box3_union(out,transformed);
    i=i+1;
  }
  return out;
}
