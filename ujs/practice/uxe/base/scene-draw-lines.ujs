struct SceneLineStream {
  positions: u32;
  positionStride: u32;
  colors: u32;
  colorStride: u32;
  vertexCount: u32;
  indices: u32;
  indexCount: u32;
  indexBytes: u32;
  viewProjection: u32;
  topology: u32;
}

native function scene_line_input(at:i64,bytes:i64,align:i64,packet:i64,capacity:i64,out:i64,outBytes:i64) i64 {
  return at%align==0 && gpu_draw_range(at,bytes,packet,capacity) &&
    !scene_render_overlap(at,bytes,out,outBytes);
}

native function scene_line_index(indices:i64,width:i64,i:i64) i64 {
  if(width==2) { return ux_u16(indices+i*2); }
  if(width==4) { return ux_u32(indices+i*4); }
  return i;
}

// RGB triples may be interleaved, planar, or constant (colorStride == 0).
// A zero index width uses the position order. Widths two and four expand
// unsigned indices into the shared GPU packet position/RGBA vertex layout.
native function scene_line_project(draw:i64,stream:i64,out:i64,maxVertices:i64,packet:i64,capacity:i64) i64 {
  if(maxVertices<2 || maxVertices>2340 || out%4!=0 ||
     !gpu_draw_range(out,maxVertices*28,packet,capacity) ||
     !scene_line_input(draw,SceneDrawItem.size,4,packet,capacity,out,maxVertices*28) ||
     !scene_line_input(stream,SceneLineStream.size,4,packet,capacity,out,maxVertices*28)) { return 0-1; }
  let vertexCount=ux_u32(stream+SceneLineStream.vertexCount);
  let topology=ux_u32(stream+SceneLineStream.topology);
  let width=ux_u32(stream+SceneLineStream.indexBytes);
  let indexCount=ux_u32(stream+SceneLineStream.indexCount);
  let indices=ux_u32(stream+SceneLineStream.indices);
  let count=vertexCount;
  if(width!=0) { count=indexCount; }
  if(vertexCount<1 || vertexCount>524288 || topology<2 || topology>4 ||
     count<2 || count>maxVertices || (topology==2 && count%2!=0)) { return 0-1; }
  if(width==0) {
    if(indexCount!=0) { return 0-1; }
  } else if((width!=2 && width!=4) ||
    !scene_line_input(indices,indexCount*width,width,packet,capacity,out,maxVertices*28)) { return 0-1; }

  let positions=ux_u32(stream+SceneLineStream.positions);
  let colors=ux_u32(stream+SceneLineStream.colors);
  let positionStride=ux_u32(stream+SceneLineStream.positionStride);
  let colorStride=ux_u32(stream+SceneLineStream.colorStride);
  let world=ux_u32(draw+SceneDrawItem.worldMatrix);
  let projection=ux_u32(stream+SceneLineStream.viewProjection);
  if(positionStride<12 || positionStride%4!=0 || positionStride>6291456 ||
     (colorStride!=0 && colorStride<12) || colorStride%4!=0 || colorStride>6291456 ||
     !scene_line_input(positions,(vertexCount-1)*positionStride+12,4,packet,capacity,out,maxVertices*28) ||
     !scene_line_input(colors,(vertexCount-1)*colorStride+12,4,packet,capacity,out,maxVertices*28) ||
     !scene_line_input(world,128,8,packet,capacity,out,maxVertices*28) ||
     !scene_line_input(projection,128,8,packet,capacity,out,maxVertices*28)) { return 0-1; }
  if(ux_f64(world+24)!=0.0 || ux_f64(world+56)!=0.0 ||
     ux_f64(world+88)!=0.0 || ux_f64(world+120)!=1.0) { return 0-2; }
  let i=0;
  while(i<count) {
    let source=scene_line_index(indices,width,i);
    if(source>=vertexCount) { return 0-1; }
    let color=colors+source*colorStride;
    let r=ux_f32(color);
    let g=ux_f32(color+4);
    let b=ux_f32(color+8);
    if(r-r!=0.0 || g-g!=0.0 || b-b!=0.0 ||
       draw_project_vertex(positions+source*positionStride,world,projection,0,0)<0) { return 0-2; }
    i=i+1;
  }
  i=0;
  while(i<count) {
    let source=scene_line_index(indices,width,i);
    let color=colors+source*colorStride;
    let at=out+i*28;
    let projected=draw_project_vertex(positions+source*positionStride,world,projection,at,1);
    let red=ux_u32_put(at+12,ux_u32(color));
    let green=ux_u32_put(at+16,ux_u32(color+4));
    let blue=ux_u32_put(at+20,ux_u32(color+8));
    let a=ux_f32_put(at+24,1.0);
    i=i+1;
  }
  return count;
}

native function SceneLine_projectPacked(draw:i64,stream:i64,out:i64,maxVertices:i64) i64 {
  return scene_line_project(draw,stream,out,maxVertices,0,0);
}

// Use the same CPU projection and GPU vertex/command format as flat draws.
// The shared packed layout carries NDC, so RGB interpolation is screen-space.
native function SceneDraw_gpuLines(packet:i64,capacity:i64,draw:i64,stream:i64,out:i64,maxVertices:i64,shader:i64) i64 {
  if(gpu_packet_slot(packet,capacity,0)<0 || maxVertices<2 || maxVertices>2340 ||
     !scene_line_input(shader,GpuShaderSource.size,4,packet,capacity,out,maxVertices*28)) { return 0-1; }
  let vs=ux_u32(shader+GpuShaderSource.vertex);
  let vn=ux_u32(shader+GpuShaderSource.vertexBytes);
  let fs=ux_u32(shader+GpuShaderSource.fragment);
  let fn=ux_u32(shader+GpuShaderSource.fragmentBytes);
  if(vn<1 || vn>4096 || fn<1 || fn>4096 ||
     !scene_line_input(vs,vn,1,packet,capacity,out,maxVertices*28) ||
     !scene_line_input(fs,fn,1,packet,capacity,out,maxVertices*28)) { return 0-1; }
  let count=scene_line_project(draw,stream,out,maxVertices,packet,capacity);
  if(count<0) { return count; }
  return GpuPacket_drawPrimitive(packet,capacity,out,count,shader,ux_u32(stream+SceneLineStream.topology));
}
