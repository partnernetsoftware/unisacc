native function RingGeometry_generate(ring:i64,inner:f64,outer:f64,theta_steps:i64,
                                     radial_steps:i64,start:f64,length:f64) i64 {
  if(theta_steps<3) { theta_steps=3; }
  if(radial_steps<1) { radial_steps=1; }
  if(outer==0.0 || theta_steps>262144 || radial_steps>262144) { return 0-1; }
  let columns=theta_steps+1;
  let points=columns*(radial_steps+1);
  let cells=6*theta_steps*radial_steps;
  if(!GeometryBuffers_fits(ring,points,cells)) { return 0-1; }
  let vertices=ux_u32(ring+GeometryBuffers.vertices);
  let indices=ux_u32(ring+GeometryBuffers.indices);
  let row=0;
  while(row<=radial_steps) {
    let radius=inner+(outer-inner)*row/radial_steps;
    let column=0;
    while(column<=theta_steps) {
      let angle=start+length*column/theta_steps;
      let x=radius*ux_math_cos(angle);
      let y=radius*ux_math_sin(angle);
      vertices=GeometryBuffers_vertex(vertices,x,y,0.0,0.0,0.0,1.0,
        0.5+x/(2.0*outer),0.5+y/(2.0*outer));
      if(row<radial_steps && column<theta_steps) {
        let first=row*columns+column;
        indices=geometry_quad(indices,first,first+columns,first+columns+1,first+1);
      }
      column=column+1;
    }
    row=row+1;
  }
  return GeometryBuffers_commit(ring,points,cells);
}
