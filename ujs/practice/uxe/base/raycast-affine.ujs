// Transform the origin and direction by the inverse affine transform without
// constructing a second matrix. Used for r160's local-space thresholds.
native function ray_local_affine(out:i64,ray:i64,world:i64) i64 {
  if(ux_f64(world+24)!=0.0 || ux_f64(world+56)!=0.0 ||
     ux_f64(world+88)!=0.0 || ux_f64(world+120)!=1.0) { return 0-1; }
  let a=ux_f64(world); let b=ux_f64(world+32); let c=ux_f64(world+64);
  let d=ux_f64(world+8); let e=ux_f64(world+40); let f=ux_f64(world+72);
  let g=ux_f64(world+16); let h=ux_f64(world+48); let i=ux_f64(world+80);
  let m00=e*i-f*h; let m01=c*h-b*i; let m02=b*f-c*e;
  let m10=f*g-d*i; let m11=a*i-c*g; let m12=c*d-a*f;
  let m20=d*h-e*g; let m21=b*g-a*h; let m22=a*e-b*d;
  let determinant=a*m00+b*m10+c*m20;
  if(determinant==0.0 || determinant-determinant!=0.0) { return 0-1; }
  let x=ux_f64(ray)-ux_f64(world+96);
  let y=ux_f64(ray+8)-ux_f64(world+104);
  let z=ux_f64(ray+16)-ux_f64(world+112);
  let ox=(x*m00+y*m01+z*m02)/determinant;
  let oy=(x*m10+y*m11+z*m12)/determinant;
  let oz=(x*m20+y*m21+z*m22)/determinant;
  let dx=ux_f64(ray+24);
  let dy=ux_f64(ray+32);
  let dz=ux_f64(ray+40);
  let nx=(dx*m00+dy*m01+dz*m02)/determinant;
  let ny=(dx*m10+dy*m11+dz*m12)/determinant;
  let nz=(dx*m20+dy*m21+dz*m22)/determinant;
  let length=f64_sqrt(nx*nx+ny*ny+nz*nz);
  if(ox-ox!=0.0 || oy-oy!=0.0 || oz-oz!=0.0 || length-length!=0.0) { return 0-1; }
  if(length==0.0) { length=1.0; }
  let origin=Vector3_set(out,ox,oy,oz);
  let direction=Vector3_set(out+24,nx/length,ny/length,nz/length);
  return out;
}
