native function Bone_toJSON(arena:i64,handle:i64,uuid:i64,uuidBytes:i64,dst:i64,end:i64,scratch:i64) i64 {
  if(!Bone_isBone(arena,handle)) { return 0-1; }
  let node=Object3D_address(arena,handle);
  let root=camera_json_begin(node,uuid,uuidBytes,dst,end,scratch,18);
  let object=json_byte(root,end,125);
  return json_byte(object,end,125);
}

native function Bone_fromJSON(arena:i64,handle:i64,input:i64,end:i64,scratch:i64) i64 {
  if(!Bone_isBone(arena,handle)) { return 0-1; }
  let node=Object3D_address(arena,handle);
  let restored=camera_json_restore(node,input,end,scratch,18);
  if(restored<0) { return restored; }
  return handle;
}

native function Bone_clone(dstArena:i64,srcArena:i64,source:i64,recursive:i64) i64 {
  if(!Bone_isBone(srcArena,source)) { return 0-1; }
  return Object3D_clone(dstArena,srcArena,source,recursive);
}

native function Bone_dispose(arena:i64,handle:i64) i64 {
  if(!Bone_isBone(arena,handle)) { return 0-1; }
  return Object3D_destroy(arena,handle);
}
