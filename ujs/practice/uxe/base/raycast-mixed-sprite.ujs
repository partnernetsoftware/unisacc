// Sprite has no per-vertex index. The canonical row borrows its native UV hit.
native function Raycaster_stageSpriteHit(node:i64,source:i64,out:i64) i64 {
  if(node<=0 || node>4294967295 || !raycaster_span(source,RaySpriteHit.size) ||
     !raycaster_span(out,RayMixedHit.size) || raycaster_overlap(out,RayMixedHit.size,source,RaySpriteHit.size)) { return 0-1; }
  let distance=ux_f64(source+RaySpriteHit.distance);
  if(distance<0.0 || distance-distance!=0.0) { return 0-1; }
  let copied=uxe_copy_record(out,source,32);
  let a=ux_u32_put(out+RayMixedHit.kind,3);
  let b=ux_u32_put(out+RayMixedHit.node,node);
  let c=ux_u32_put(out+RayMixedHit.index,4294967295);
  let d=ux_u32_put(out+RayMixedHit.source,source);
  return 1;
}

// Staged rows start in scene traversal order. Preflight preserves them
// on refusal. The supplied sort scratch is disjoint from the staged rows.
native function Raycaster_sortMixedRows(rows:i64,count:i64,work:i64,space:i64) i64 {
  if(count<0 || count>65536) { return 0-1; }
  let bytes=count*RayMixedHit.size;
  if(space<bytes || !raycaster_span(rows,bytes) || !raycaster_span(work,space) ||
     raycaster_overlap(rows,bytes,work,space)) { return 0-1; }
  let i=0;
  while(i<count) {
    let row=rows+i*RayMixedHit.size;
    let kind=ux_u32(row+RayMixedHit.kind);
    let distance=ux_f64(row+RayMixedHit.distance);
    let nativeHit=ux_u32(row+RayMixedHit.source);
    let stride=RaySpriteHit.size;
    if(kind!=3) { stride=ray_mixed_stride(kind); }
    if(stride==0 || ux_u32(row+RayMixedHit.node)==0 || distance<0.0 || distance-distance!=0.0 ||
       !raycaster_span(nativeHit,stride) || raycaster_overlap(nativeHit,stride,rows,bytes) ||
       raycaster_overlap(nativeHit,stride,work,space)) { return 0-1; }
    i=i+1;
  }
  return ray_sort_hits(rows,work,count,RayMixedHit.size,RayMixedHit.distance);
}
