native function LineLoop_toJSON(object:i64,arena:i64,ids:i64,dst:i64,end:i64,scratch:i64) i64 {
  return renderable_toJSON(object,arena,ids,dst,end,scratch,15);
}

native function LineLoop_fromJSON(object:i64,arena:i64,input:i64,end:i64,scratch:i64,bindings:i64) i64 {
  return renderable_fromJSON(object,arena,input,end,scratch,bindings,15);
}

native function LineLoop_clone(dst:i64,dstArena:i64,src:i64,srcArena:i64,recursive:i64) i64 {
  return Mesh_clone(dst,dstArena,src,srcArena,recursive);
}

native function LineLoop_dispose(object:i64,arena:i64) i64 {
  return Mesh_dispose(object,arena);
}
