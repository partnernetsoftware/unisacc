// Each parameter is emitted before returning, as in r160's parameter branch.
// The mesh is not serialized. UUID and the instance name borrow UTF-8 bytes.
native function PlaneGeometry_toJSON(plane:i64,dst:i64,end:i64,uuid:i64,uuidBytes:i64,scratch:i64) i64 {
  let geo=plane_geometry_ready(plane);
  if(geo<0) { return 0-1; }
  let name=ux_u32(plane+PlaneGeometryRecord.name);
  let nameBytes=ux_u32(plane+PlaneGeometryRecord.nameBytes);
  let length=end-dst;
  let scratchBytes=1155;
  if(!geometry_public_span(dst,length) || !geometry_public_span(uuid,uuidBytes) ||
     !geometry_public_span(name,nameBytes) || scratch%8!=0 ||
     !geometry_public_span(scratch,scratchBytes) ||
     !geometry_public_disjoint(dst,length,scratch,scratchBytes) ||
     !geometry_public_disjoint(dst,length,plane,PlaneGeometry_size()) ||
     !geometry_public_disjoint(scratch,scratchBytes,plane,PlaneGeometry_size()) ||
     !geometry_public_disjoint(dst,length,uuid,uuidBytes) ||
     !geometry_public_disjoint(dst,length,name,nameBytes) ||
     !geometry_public_disjoint(scratch,scratchBytes,uuid,uuidBytes) ||
     !geometry_public_disjoint(scratch,scratchBytes,name,nameBytes)) { return 0-1; }
  let labels=[80,108,97,110,101,71,101,111,109,101,116,114,121,
    119,105,100,116,104,104,101,105,103,104,116,
    119,105,100,116,104,83,101,103,109,101,110,116,115,
    104,101,105,103,104,116,83,101,103,109,101,110,116,115];
  let keys=scratch+1104;
  let i=0;
  while(i<51) {
    let byte=ux_u8_put(keys+i,labels[i]);
    i=i+1;
  }
  let p=geometry_parameter_header(dst,end,uuid,uuidBytes,keys,13,name,nameBytes);
  p=geometry_parameter_number(p,end,keys+13,5,ux_f64(plane+PlaneGeometryRecord.width),scratch);
  p=geometry_parameter_number(p,end,keys+18,6,ux_f64(plane+PlaneGeometryRecord.height),scratch);
  p=geometry_parameter_number(p,end,keys+24,13,ux_f64(plane+PlaneGeometryRecord.widthSegments),scratch);
  p=geometry_parameter_number(p,end,keys+37,14,ux_f64(plane+PlaneGeometryRecord.heightSegments),scratch);
  return json_byte(p,end,125);
}
