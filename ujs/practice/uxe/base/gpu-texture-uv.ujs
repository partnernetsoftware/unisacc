native function GpuTexture_transformUv(out:i64,matrix:i64,u:f64,v:f64) i64 {
  if(out<0 || out%8!=0 || out>6291456-16 || matrix<0 || matrix%8!=0 || matrix>6291456-72) { return 0-1; }
  let x=ux_f64(matrix)*u+ux_f64(matrix+24)*v+ux_f64(matrix+48);
  let y=ux_f64(matrix+8)*u+ux_f64(matrix+32)*v+ux_f64(matrix+56);
  let writtenU=ux_f64_put(out,x);
  let writtenV=ux_f64_put(out+8,y);
  return out;
}
