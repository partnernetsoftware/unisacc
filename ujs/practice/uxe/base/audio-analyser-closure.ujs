// Reserve reusable byte storage in the caller's audio arena.
native function AudioAnalyser_prepareByteData(out:i64,bins:i64,capacity:i64) i64 {
  if(bins<16 || bins>16384 || !audio_window_size(bins*2) ||
     capacity<bins || !audio_play_span(out,capacity,1)) { return 0-1; }
  let i=0;
  while(i<bins) {
    let cleared=ux_u8_put(out+i,0);
    i=i+1;
  }
  return ux_span(out,bins);
}

// Pass native memory ranges and WebAudio's byte-bin count through the bridge.
native function AudioAnalyser_byteCommand(op:i64,out:i64,bins:i64,capacity:i64) f64 {
  if(op==0) { return 0.0+AudioAnalyser_prepareByteData(out,bins,capacity); }
  if(op==1) {
    if(capacity<bins) { return 0.0-1.0; }
    return AudioAnalyser_averageFrequency(out,bins);
  }
  return 0.0-1.0;
}
