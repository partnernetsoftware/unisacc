// One direct-light color channel with a Charlie sheen lobe.
native function MeshPhysicalMaterial_sheen(base:f64,shade:f64,peak:f64,roughness:f64,nl:f64,nv:f64,nh:f64,light:f64) f64 {
  if(!mesh_phys_unit(shade) || !mesh_phys_unit(peak) || peak<shade || !mesh_phys_unit(roughness) ||
     !mesh_phys_unit(nl) || !mesh_phys_unit(nv) || !mesh_phys_unit(nh) ||
     !(base>=0.0 && base-base==0.0) || !(light>=0.0 && light<=65536.0)) { return -1.0; }
  let attenuated=base*(1.0-0.157*peak);
  if(shade==0.0 || nl==0.0) { return attenuated; }
  if(roughness<0.07) { roughness=0.07; }
  let alpha=1.0/(roughness*roughness);
  let sineSquared=1.0-nh*nh;
  if(sineSquared<0.0078125) { sineSquared=0.0078125; }
  let distribution=(2.0+alpha)*ux_math_pow(sineSquared,0.5*alpha)/6.283185307179586;
  let visibility=1.0/(4.0*(nl+nv-nl*nv));
  if(visibility>1.0) { visibility=1.0; }
  return attenuated+light*nl*shade*distribution*visibility;
}
