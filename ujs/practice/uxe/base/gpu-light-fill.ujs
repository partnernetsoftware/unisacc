native function GpuLight_ambientDiffuse(channel:f64,ambient:f64,intensity:f64) f64 {
  return GpuMaterial_lambertDiffuse(channel,1.0,ambient*intensity);
}

native function GpuLight_hemisphereDiffuse(channel:f64,sky:f64,ground:f64,dotNL:f64,intensity:f64) f64 {
  let weight=dotNL*0.5+0.5;
  if(weight<0.0) { weight=0.0; }
  if(weight>1.0) { weight=1.0; }
  return GpuLight_ambientDiffuse(channel,ground+(sky-ground)*weight,intensity);
}

native function GpuLight_spotAttenuation(cosine:f64,outer:f64,inner:f64) f64 {
  if(inner<outer || cosine!=cosine || outer!=outer || inner!=inner) { return 0.0-1.0; }
  if(cosine<=outer) { return 0.0; }
  if(cosine>=inner) { return 1.0; }
  let t=(cosine-outer)/(inner-outer);
  return t*t*(3.0-2.0*t);
}
