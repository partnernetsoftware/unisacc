native function inst_json_read_array(obj:i64,end:i64,scratch:i64,dst:i64,n:i64,size:i64,commit:i64) i64 {
  if(obj<0 || obj>=end || ux_u8(obj)!=123) { return 0-1; }
  let close=json_value_end(obj,end);
  if(close<0) { return 0-1; }
  let item=LoaderJson_find(obj,close,scratch,1835365481,1702521171,0,8);
  let kind=LoaderJson_find(obj,close,scratch,1701869940,0,0,4);
  let array=LoaderJson_find(obj,close,scratch,1634890337,121,0,5);
  let norm=LoaderJson_find(obj,close,scratch,1836216174,2053729377,25701,10);
  if(LoaderJson_uint(item,close,0)!=size || kind<0 || array<0 || norm<0 ||
     ux_u8(array)!=91 || ux_u8(norm)!=102 || json_value_end(kind,close)-kind!=14) { return 0-1; }
  let label=[34,70,108,111,97,116,51,50,65,114,114,97,121,34];
  let j=0;
  while(j<14) {
    if(ux_u8(kind+j)!=label[j]) { return 0-1; }
    j=j+1;
  }
  let p=json_space(array+1,close);
  let i=0;
  while(i<n*size && p>=0 && p<close && ux_u8(p)!=93) {
    let value=json_read_number(p,close);
    let maximum=3.4028234663852886*10000000000000000000.0*10000000000000000000.0;
    if(!(value>=0.0-maximum && value<=maximum)) { return 0-1; }
    if(commit!=0) { let saved=ux_f32_put(dst+i*4,value); }
    i=i+1;
    p=json_space(json_value_end(p,close),close);
    if(p<0 || p>=close) { return 0-1; }
    if(ux_u8(p)!=93) {
      if(ux_u8(p)!=44) { return 0-1; }
      p=json_space(p+1,close);
      if(p<0 || p>=close || ux_u8(p)==93) { return 0-1; }
    }
  }
  if(p<0 || p>=close || ux_u8(p)!=93 || i%size!=0) { return 0-1; }
  return i/size;
}

native function InstancedMesh_fromJSON(self:i64,input:i64,end:i64,scratch:i64) i64 {
  if(!instance_valid(self) || !instance_arrays_valid(self) || input<0 || end<=input ||
     end>6291456 || scratch<0 || scratch>6291336 ||
     instance_overlaps(input,end-input,scratch,120) ||
     instance_overlaps(self,InstancedMesh.size,scratch,120) ||
     instance_overlaps(self,InstancedMesh.size,input,end-input)) { return 0-1; }
  let capacity=ux_u32(self+InstancedMesh.capacity);
  let matrices=ux_u32(self+InstancedMesh.matrices);
  let colors=ux_u32(self+InstancedMesh.colors);
  if(instance_overlaps(matrices,capacity*64,input,end-input) ||
     instance_overlaps(matrices,capacity*64,scratch,120) ||
     instance_overlaps(colors,capacity*12,input,end-input) ||
     instance_overlaps(colors,capacity*12,scratch,120)) { return 0-1; }
  let close=json_value_end(input,end);
  if(close<0 || json_space(close,end)!=end) { return 0-1; }
  let countAt=LoaderJson_find(input,close,scratch,1853189987,116,0,5);
  let label=[105,110,115,116,97,110,99,101,77,97,116,114,105,120];
  let j=0;
  while(j<14) { let saved=ux_u8_put(scratch+j,label[j]); j=j+1; }
  let matrixAt=json_find_key(input,close,scratch,14);
  let colorKey=[105,110,115,116,97,110,99,101,67,111,108,111,114];
  j=0;
  while(j<13) { let saved=ux_u8_put(scratch+j,colorKey[j]); j=j+1; }
  let colorAt=json_find_key(input,close,scratch,13);
  let count=LoaderJson_uint(countAt,close,0);
  if(countAt<0 || count<0 || count>capacity || matrixAt<0 || colorAt==0-1) { return 0-1; }
  let slots=inst_json_read_array(matrixAt,close,scratch,matrices,capacity,16,0);
  if(slots!=capacity) { return 0-3; }
  if(colorAt>=0 && inst_json_read_array(colorAt,close,scratch,colors,capacity,3,0)!=capacity) { return 0-4; }
  let m=inst_json_read_array(matrixAt,close,scratch,matrices,capacity,16,1);
  if(colorAt>=0) { let c=inst_json_read_array(colorAt,close,scratch,colors,capacity,3,1); }
  let active=ux_u32_put(self+InstancedMesh.count,count);
  let colored=ux_u32_put(self+InstancedMesh.hasColors,colorAt>=0);
  return self;
}
