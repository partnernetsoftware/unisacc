struct ShapePath {
  paths: u32;
  capacity: u32;
  count: u32;
}

function ShapePath_init(shape_path,...shape_path_args) {
  let path_entries=ux_u32_put(shape_path+ShapePath.paths,shape_path_args[0]);
  let capacity=ux_u32_put(shape_path+ShapePath.capacity,shape_path_args[1]);
  let count=ux_u32_put(shape_path+ShapePath.count,0);
  return shape_path;
}

function ShapePath_add(shape_path,...shape_path_args) {
  let count=ux_u32(shape_path+ShapePath.count);
  let result=0-1;
  if(count<ux_u32(shape_path+ShapePath.capacity)) {
    let row=ux_u32(shape_path+ShapePath.paths)+count*4;
    let written=ux_u32_put(row,shape_path_args[0]);
    let updated=ux_u32_put(shape_path+ShapePath.count,count+1);
    result=shape_path;
  }
  return result;
}

native function shape_path_current(shape:i64) i64 {
  let count=ux_u32(shape+ShapePath.count);
  if(count==0) { return 0-1; }
  return ux_u32(ux_u32(shape+ShapePath.paths)+(count-1)*4);
}

native function ShapePath_moveTo(shape:i64,path:i64,segments:i64,capacity:i64,x:f64,y:f64) i64 {
  if(ux_u32(shape+ShapePath.count)>=ux_u32(shape+ShapePath.capacity)) { return 0-1; }
  let initialized=Path_init(path,segments,capacity);
  if(initialized<0) { return initialized; }
  let moved=Path_moveTo(path,x,y);
  return ShapePath_add(shape,path);
}

native function ShapePath_lineTo(shape:i64,x:f64,y:f64) i64 {
  let path=shape_path_current(shape);
  if(path<0 || Path_lineTo(path,x,y)<0) { return 0-1; }
  return shape;
}

native function ShapePath_quadraticCurveTo(shape:i64,ax:f64,ay:f64,x:f64,y:f64) i64 {
  let path=shape_path_current(shape);
  if(path<0 || Path_quadraticCurveTo(path,ax,ay,x,y)<0) { return 0-1; }
  return shape;
}

native function ShapePath_bezierCurveTo(shape:i64,ax:f64,ay:f64,bx:f64,by:f64,x:f64,y:f64) i64 {
  let path=shape_path_current(shape);
  if(path<0 || Path_bezierCurveTo(path,ax,ay,bx,by,x,y)<0) { return 0-1; }
  return shape;
}

native function ShapePath_splineThru(shape:i64,points:i64,count:i64) i64 {
  let path=shape_path_current(shape);
  if(path<0) { return path; }
  let appended=Path_splineThru(path,points,count);
  if(appended<0) { return appended; }
  return shape;
}

function ShapePath_signedArea(shape_points,...shape_area_args) {
  let n=shape_area_args[0];
  let result=0.0;
  if(n>=3) {
    let prev=shape_points+(n-1)*16;
    let next=shape_points;
    while(next<shape_points+n*16) {
      result=result+ux_f64(prev)*ux_f64(next+8)-ux_f64(next)*ux_f64(prev+8);
      prev=next;
      next=next+16;
    }
  }
  return result*0.5;
}

// Assemble ordered outlines and holes using winding. Each solid owns a fixed
// number of slots in the supplied hole table. Leading holes join the first solid.
native function shape_path_solids(entries:i64,paths:i64,result:i64,capacity:i64,holes:i64,perShape:i64) i64 {
  if(paths>capacity) { return 0-1; }
  let i=0;
  while(i<paths) {
    let path=ux_u32(entries+i*4);
    let written=Shape_init(result+i*Shape.size,path,holes+4*i*perShape,perShape);
    if(written<0) { return written; }
    i=i+1;
  }
  return paths;
}

function ShapePath_toShapes(shape_path,...shape_build) {
  let result=shape_build[0];
  let result_cap=shape_build[1];
  let holes=shape_build[2];
  let holes_per_shape=shape_build[3];
  let samples=shape_build[4];
  let sample_cap=shape_build[5];
  let scratch=shape_build[6];
  let divisions=shape_build[7];
  let is_ccw=shape_build[8];
  let entries=ux_u32(shape_path+ShapePath.paths);
  let paths=ux_u32(shape_path+ShapePath.count);
  let solid_count=0;
  let i=0;
  let failed=0;
  let leading=0;
  while(i<paths && !failed) {
    let path=ux_u32(entries+i*4);
    let count=Path_getPoints(path,samples,sample_cap,divisions,scratch);
    if(count<3) {
      failed=1;
    } else {
      let area=ShapePath_signedArea(samples,count);
      let solid=area<0.0;
      if(is_ccw!=0) { solid=area>0.0; }
      if(solid || paths==1) {
        if(solid_count>=result_cap) {
          failed=1;
        } else {
          let at=result+solid_count*Shape.size;
          let base=holes+4*solid_count*holes_per_shape;
          let written=Shape_init(at,path,base,holes_per_shape);
          if(written<0) { failed=1; }
          if(solid_count==0) {
            let j=0;
            while(j<leading && !failed) {
              let added=Shape_addHole(at,ux_u32(entries+j*4));
              if(added<0) { failed=1; }
              j=j+1;
            }
          }
          solid_count=solid_count+1;
        }
      } else if(solid_count==0) {
        leading=leading+1;
      } else {
        let entry=Shape_addHole(result+(solid_count-1)*Shape.size,path);
        if(entry<0) { failed=1; }
      }
    }
    i=i+1;
  }
  // When no ring has the chosen winding, r160 treats each ring as a solid.
  if(!failed && solid_count==0 && paths>0) {
    solid_count=shape_path_solids(entries,paths,result,result_cap,holes,holes_per_shape);
  }
  if(failed) { solid_count=0-1; }
  return solid_count;
}
