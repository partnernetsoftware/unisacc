native function GpuColor_output(out:i64,r:f64,g:f64,b:f64,space:i64) i64 {
  if(out<0 || out%8!=0 || out>6291456-24 || space<1 || space>4 || r!=r || g!=g || b!=b) { return 0-1; }
  let color=Color_setRGB(out,r,g,b);
  return ColorManagement_convert(1,color,1,space);
}

native function GpuColor_outputSpaceTag(offset:i64,bytes:i64) i64 {
  if(offset<0 || bytes<4 || bytes>17 || offset>6291456-bytes) { return 0-1; }
  let srgb=[115,114,103,98];
  let display=[100,105,115,112,108,97,121,45,112,51];
  let linear=[45,108,105,110,101,97,114];
  let shortTag=bytes==4 || bytes==11;
  let displayTag=bytes==10 || bytes==17;
  if(!shortTag && !displayTag) { return 0-1; }
  let prefix=4;
  if(displayTag) { prefix=10; }
  let i=0;
  while(i<prefix) {
    let expected=0;
    if(shortTag) { expected=srgb[i]; }
    else { expected=display[i]; }
    if(ux_u8(offset+i)!=expected) { return 0-1; }
    i=i+1;
  }
  while(i<bytes) {
    if(ux_u8(offset+i)!=linear[i-prefix]) { return 0-1; }
    i=i+1;
  }
  if(displayTag) {
    if(bytes==17) { return 3; }
    return 4;
  }
  if(bytes==11) { return 1; }
  return 2;
}
