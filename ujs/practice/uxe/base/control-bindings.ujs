// DOM buttons and the r160 MOUSE actions share values, but represent
// different inputs. Return -1 when no binding is present.
native function OrbitControls_mouseBinding(map:i64,button:i64,modified:i64) i64 {
  if(map<0 || map>1 || button<0 || button>2 || modified<0 || modified>1) { return 0-1; }
  if(button==1) { return 1; }
  if(map!=modified) { return 2-button; }
  return button;
}

// TOUCH values are ROTATE=0, PAN=1, DOLLY_PAN=2, DOLLY_ROTATE=3.
native function OrbitControls_touchBinding(map:i64,count:i64) i64 {
  if(map<0 || map>1) { return 0-1; }
  if(count==1) { return map; }
  if(count==2) { return 2+map; }
  return 0-1;
}
