struct LightSH {
  c0: Color;
  c1: Color;
  c2: Color;
  c3: Color;
  c4: Color;
  c5: Color;
  c6: Color;
  c7: Color;
  c8: Color;
}

struct LightJsonField {
  groundColor: u8;
  distance: u8;
  angle: u8;
  penumbra: u8;
  decay: u8;
  shadow: u8;
  dimensions: u8;
  sh: u8;
}

struct LightShadowJson {
  cameraFov: f64;
  cameraNear: f64;
  cameraFar: f64;
  bias: f64;
  normalBias: f64;
  radius: f64;
  mapWidth: f64;
  mapHeight: f64;
}

struct LightJson {
  kind: u32;
  color: u32;
  groundColor: u32;
  visible: u32;
  layers: u32;
  fields: LightJsonField;
  intensity: f64;
  distance: f64;
  angle: f64;
  penumbra: f64;
  decay: f64;
  width: f64;
  height: f64;
  shadow: LightShadowJson;
  sh: LightSH;
}
