native function torus_geometry_keys(at:i64) i64 {
  let labels=[84,111,114,117,115,71,101,111,109,101,116,114,121,
    114,97,100,105,117,115,116,117,98,101,
    114,97,100,105,97,108,83,101,103,109,101,110,116,115,
    116,117,98,117,108,97,114,83,101,103,109,101,110,116,115,97,114,99];
  let i=0;
  while(i<55) {
    let byte=ux_u8_put(at+i,labels[i]);
    i=i+1;
  }
  return at;
}

native function TorusGeometry_toJSON(torus:i64,dst:i64,end:i64,uuid:i64,uuidBytes:i64,scratch:i64) i64 {
  if(geometry_primitive_ready(torus,6)<0 ||
     !geometry_primitive_json_io(torus,dst,end,uuid,uuidBytes,scratch,55)) { return 0-1; }
  let keys=torus_geometry_keys(scratch+1104);
  let p=geometry_primitive_json_head(torus,dst,end,uuid,uuidBytes,keys,13);
  p=geometry_parameter_number(p,end,keys+13,6,ux_f64(torus+GeometryPrimitiveRecord.first),scratch);
  p=geometry_parameter_number(p,end,keys+19,4,ux_f64(torus+GeometryPrimitiveRecord.second),scratch);
  p=geometry_parameter_number(p,end,keys+23,14,ux_f64(torus+GeometryPrimitiveRecord.third),scratch);
  p=geometry_parameter_number(p,end,keys+37,15,ux_f64(torus+GeometryPrimitiveRecord.fourth),scratch);
  p=geometry_parameter_number(p,end,keys+52,3,ux_f64(torus+GeometryPrimitiveRecord.fifth),scratch);
  return json_byte(p,end,125);
}

native function TorusGeometry_fromJSON(torus:i64,raw:i64,arena:i64,bytes:i64,input:i64,end:i64,scratch:i64) i64 {
  let space=TorusGeometryParameters.size+55;
  if(scratch%8!=0 || end<=input ||
     !geometry_primitive_raw(torus,raw,arena,bytes,input,end-input) ||
     !geometry_primitive_raw(torus,raw,arena,bytes,scratch,space) ||
     !geometry_public_disjoint(input,end-input,scratch,space) ||
     !geometry_primitive_json_object(input,end)) { return 0-1; }
  let keys=torus_geometry_keys(scratch+TorusGeometryParameters.size);
  let a=ux_f64_put(scratch+TorusGeometryParameters.radius,geometry_primitive_json_number(input,end,keys+13,6,1.0));
  let b=ux_f64_put(scratch+TorusGeometryParameters.tube,geometry_primitive_json_number(input,end,keys+19,4,0.4));
  let c=ux_f64_put(scratch+TorusGeometryParameters.radialSegments,geometry_primitive_json_number(input,end,keys+23,14,12.0));
  let d=ux_f64_put(scratch+TorusGeometryParameters.tubularSegments,geometry_primitive_json_number(input,end,keys+37,15,48.0));
  let e=ux_f64_put(scratch+TorusGeometryParameters.arc,geometry_primitive_json_number(input,end,keys+52,3,6.283185307179586));
  return TorusGeometry_create(torus,raw,arena,bytes,scratch);
}
