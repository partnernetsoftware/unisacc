native function AttachedBindMode_parse(bytes:i64,length:i64) i64 {
  if(length!=8 || bytes<0 || bytes>6291456-8) { return 0-1; }
  let name=[97,116,116,97,99,104,101,100];
  let i=0;
  while(i<8) {
    if(ux_u8(bytes+i)!=name[i]) { return 0-1; }
    i=i+1;
  }
  return 1;
}

native function DetachedBindMode_parse(bytes:i64,length:i64) i64 {
  if(length!=8 || bytes<0 || bytes>6291456-8) { return 0-1; }
  let name=[100,101,116,97,99,104,101,100];
  let i=0;
  while(i<8) {
    if(ux_u8(bytes+i)!=name[i]) { return 0-1; }
    i=i+1;
  }
  return 2;
}

native function SkinnedMesh_updateBind(skin:i64,world:i64,mode:i64) i64 {
  if((mode!=1 && mode!=2) || !skinned_valid(skin)) { return 0-1; }
  let source=world;
  if(mode==2) { source=ux_u32(skin+SkinnedMesh.bindMatrix); }
  if(source<0 || source>6291456-128 || source%8!=0) { return 0-1; }
  let inverse=ux_u32(skin+SkinnedMesh.bindInverse);
  if(skeleton_overlap(source,128,inverse,128)) { return 0-1; }
  let copied=Matrix4_copy(inverse,source);
  return Matrix4_invert(copied);
}
