native function legacy_texture_channel(address:i64,channel:i64) i64 {
  if(channel==0-2) { return 255; }
  if(channel==0-1) { return 0; }
  return ux_u8(address+channel);
}

native function gpu_legacy_texture_pixel(layout:i64,address:i64,width:i64,height:i64,u:f64,v:f64) i64 {
  let channels=1+layout%2;
  let texel=gpu_texture_texel(address,width,height,u,v,channels);
  if(texel<0) { return texel; }
  let red=(layout/2)%4-2;
  let green=(layout/8)%4-2;
  let blue=(layout/32)%4-2;
  let alpha=(layout/128)%4-2;
  return legacy_texture_channel(texel,red)+256*legacy_texture_channel(texel,green)+
    65536*legacy_texture_channel(texel,blue)+16777216*legacy_texture_channel(texel,alpha);
}
