struct Spherical { radius: f64; phi: f64; theta: f64; }

native function Spherical_set(sp_dst:i64,sp_r:f64,sp_p:f64,sp_t:f64) i64 {
  let sp_span=ux_span(sp_dst,Spherical.size);
  let sp_r_write=ux_f64_put(sp_dst,sp_r);
  let sp_p_write=ux_f64_put(sp_dst+8,sp_p);
  let sp_t_write=ux_f64_put(sp_dst+16,sp_t);
  return sp_dst;
}

function Spherical_copy(sp_copy,...sp_copy_args) {
  let sp_src=sp_copy_args[0];
  return Spherical_set(sp_copy,ux_f64(sp_src),ux_f64(sp_src+8),ux_f64(sp_src+16));
}

function Spherical_clone(sp_clone,...sp_clone_args) {
  return Spherical_copy(sp_clone,sp_clone_args[0]);
}

function Spherical_makeSafe(sp_safe) {
  let sp_epsilon=0.000001;
  let sp_phi=vector_limit(ux_f64(sp_safe+8),sp_epsilon,3.141592653589793-sp_epsilon);
  let sp_safe_write=ux_f64_put(sp_safe+8,sp_phi);
  return sp_safe;
}

native function Spherical_fromXYZ(sp_cart:i64,sp_x:f64,sp_y:f64,sp_z:f64) i64 {
  let sp_len=f64_sqrt(sp_x*sp_x+sp_y*sp_y+sp_z*sp_z);
  if(sp_len==0.0) { return Spherical_set(sp_cart,0.0,0.0,0.0); }
  let sp_azimuth=ux_math_atan2(sp_x,sp_z);
  let sp_polar=ux_math_acos(vector_limit(sp_y/sp_len,0.0-1.0,1.0));
  return Spherical_set(sp_cart,sp_len,sp_polar,sp_azimuth);
}

function Spherical_setFromCartesianCoords(sp_coord,...sp_args) {
  return Spherical_fromXYZ(sp_coord,sp_args[0],sp_args[1],sp_args[2]);
}

function Spherical_setFromVector3(sp_vector,...sp_vector_args) {
  let sp_v=sp_vector_args[0];
  return Spherical_fromXYZ(sp_vector,ux_f64(sp_v),ux_f64(sp_v+8),ux_f64(sp_v+16));
}
