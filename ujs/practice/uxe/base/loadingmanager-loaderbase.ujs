// Class-capable bases reserve the legacy slot followed by the extended state.
// The legacy plain Loader may still query that already initialized slot.
native function LoaderBaseClass_size() i64 {
  return DefaultLoadingManager.size+LoadingManagerState.size;
}

native function Loader_initManagedWithBase(loader:i64,base:i64,manager:i64,table:i64,capacity:i64) i64 {
  let reserved=LoaderBaseClass_size();
  if(!loading_span(loader,Loader.size) || !loading_span(base,reserved) ||
     !file_disjoint(loader,Loader.size,base,reserved)) { return 0-1; }
  let defaultManager=base+DefaultLoadingManager.size;
  if(manager==0-1 || manager==defaultManager) {
    if(capacity<1 || capacity>524288 || !loading_span(table,capacity*LoadingHandler.size) ||
       !file_disjoint(loader,Loader.size,table,capacity*LoadingHandler.size)) { return 0-1; }
    manager=LoadingManager_defaultClass(base,table,capacity);
  } else if(!lm_state(manager) || !lm_file_range(base,reserved,manager)) { return 0-1; }
  if(!lm_state(manager) || !lm_file_range(loader,Loader.size,manager)) { return 0-1; }
  return Loader_init(loader,manager);
}

// Bind the native FileLoader to the same canonical manager as its Loader
// configuration. Managed begin/receive are required for the callback route.
native function FileLoader_bindFromLoader(file:i64,route:i64,loader:i64,base:i64,table:i64,capacity:i64) i64 {
  let reserved=LoaderBaseClass_size();
  if(!loading_span(loader,Loader.size) || !loading_span(file,FileLoader.size) ||
     !loading_span(route,LoadingFileRoute.size) || !loading_span(base,reserved) ||
     !file_disjoint(loader,Loader.size,file,FileLoader.size) ||
     !file_disjoint(loader,Loader.size,route,LoadingFileRoute.size) ||
     !file_disjoint(loader,Loader.size,base,reserved)) { return 0-1; }
  let manager=ux_u32(loader+Loader.manager);
  if(!lm_state(manager) || !lm_file_range(loader,Loader.size,manager)) { return 0-1; }
  return FileLoader_bindManaged(file,route,base,manager,table,capacity);
}
