struct Line3 { ax: f64; ay: f64; az: f64; bx: f64; by: f64; bz: f64; }

native function Line3_set(l_dst:i64,l_start:i64,l_end:i64) i64 {
  let l_span=ux_span(l_dst,Line3.size);
  let l_values=[ux_f64(l_start),ux_f64(l_start+8),ux_f64(l_start+16),ux_f64(l_end),ux_f64(l_end+8),ux_f64(l_end+16)];
  let l_index=0;
  while(l_index<6) {
    let l_write=ux_f64_put(l_dst+l_index*8,l_values[l_index]);
    l_index=l_index+1;
  }
  return l_dst;
}

function Line3_copy(l_copy,...l_copy_args) {
  return Line3_set(l_copy,l_copy_args[0],l_copy_args[0]+24);
}

function Line3_clone(l_clone,...l_clone_args) {
  return Line3_copy(l_clone,l_clone_args[0]);
}

native function Line3_at(l_at:i64,l_line:i64,l_t:f64) i64 {
  let l_x=ux_f64(l_line); let l_y=ux_f64(l_line+8); let l_z=ux_f64(l_line+16);
  return Vector3_set(l_at,l_x+(ux_f64(l_line+24)-l_x)*l_t,
    l_y+(ux_f64(l_line+32)-l_y)*l_t,l_z+(ux_f64(l_line+40)-l_z)*l_t);
}

function Line3_getCenter(l_middle,...l_middle_args) {
  return Line3_at(l_middle,l_middle_args[0],0.5);
}

function Line3_delta(l_delta,...l_delta_args) {
  let l_endpoints=l_delta_args[0];
  return Vector3_set(l_delta,ux_f64(l_endpoints+24)-ux_f64(l_endpoints),
    ux_f64(l_endpoints+32)-ux_f64(l_endpoints+8),ux_f64(l_endpoints+40)-ux_f64(l_endpoints+16));
}

function Line3_distanceSq(l_squared) {
  return Vector3_distanceToSquared(l_squared,l_squared+24);
}

function Line3_distance(l_distance) {
  return f64_sqrt(Line3_distanceSq(l_distance));
}

native function Line3_projectParameter(l_closest:i64,l_point:i64,l_clamp:i64) f64 {
  let l_numerator=0.0; let l_denominator=0.0; let l_dim=0;
  while(l_dim<24) {
    let l_origin=ux_f64(l_closest+l_dim);
    let l_dir=ux_f64(l_closest+l_dim+24)-l_origin;
    l_numerator=l_numerator+(ux_f64(l_point+l_dim)-l_origin)*l_dir;
    l_denominator=l_denominator+l_dir*l_dir;
    l_dim=l_dim+8;
  }
  let l_parameter=l_numerator/l_denominator;
  if(l_clamp!=0) { l_parameter=vector_limit(l_parameter,0.0,1.0); }
  return l_parameter;
}

function Line3_closestPointToPointParameter(l_param,...l_param_args) {
  return Line3_projectParameter(l_param,l_param_args[0],l_param_args[1]);
}

function Line3_closestPointToPoint(l_target,...l_target_args) {
  let l_segment=l_target_args[0];
  return Line3_at(l_target,l_segment,Line3_projectParameter(l_segment,l_target_args[1],l_target_args[2]));
}

function Line3_applyMatrix4(l_transform,...l_transform_args) {
  let l_mat=l_transform_args[0];
  let l_a=Vector3_applyMatrix4(l_transform,l_mat);
  let l_b=Vector3_applyMatrix4(l_transform+24,l_mat);
  return l_transform;
}

function Line3_equals(l_equal,...l_equal_args) {
  let l_other=l_equal_args[0];
  return Vector3_equals(l_equal,l_other) && Vector3_equals(l_equal+24,l_other+24);
}
