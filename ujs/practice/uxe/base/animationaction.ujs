struct AnimationAction {
  duration: f64;
  time: f64;
  sampleTime: f64;
  timeScale: f64;
  loop: u32;
  repetitions: i32;
  loopCount: i32;
  enabled: u32;
  paused: u32;
  clamp: u32;
  event: u32;
  eventValue: i32;
}

native function AnimationAction_init(action:i64,duration:f64,loop:i64,repetitions:i64,clamp:i64) i64 {
  if(!animation_span(action,AnimationAction.size) || action%8!=0 || duration-duration!=0.0 ||
     duration<0.0 || (duration==0.0 && loop!=2200) || loop<2200 || loop>2202 ||
     repetitions< -1 || repetitions>2147483647) { return 0-1; }
  let a=ux_f64_put(action+AnimationAction.duration,duration);
  let b=ux_f64_put(action+AnimationAction.time,0.0);
  let c=ux_f64_put(action+AnimationAction.sampleTime,0.0);
  let d=ux_f64_put(action+AnimationAction.timeScale,1.0);
  let e=ux_u32_put(action+AnimationAction.loop,loop);
  let f=ux_i32_put(action+AnimationAction.repetitions,repetitions);
  let g=ux_i32_put(action+AnimationAction.loopCount,-1);
  let h=ux_u32_put(action+AnimationAction.enabled,1);
  let j=ux_u32_put(action+AnimationAction.paused,0);
  let k=ux_u32_put(action+AnimationAction.clamp,clamp!=0);
  let l=ux_u32_put(action+AnimationAction.event,0);
  let m=ux_i32_put(action+AnimationAction.eventValue,0);
  return action;
}

// Event 1 carries signed loopDelta. Event 2 carries the finish direction.
native function AnimationAction_step(action:i64,elapsed:f64) i64 {
  if(!animation_span(action,AnimationAction.size) || action%8!=0 || elapsed-elapsed!=0.0) { return 0-1; }
  let delta=elapsed*ux_f64(action+AnimationAction.timeScale);
  if(ux_u32(action+AnimationAction.paused)!=0 || ux_u32(action+AnimationAction.enabled)==0) { delta=0.0; }
  let duration=ux_f64(action+AnimationAction.duration);
  let time=ux_f64(action+AnimationAction.time)+delta;
  let loop=ux_u32(action+AnimationAction.loop);
  let count=ux_i32(action+AnimationAction.loopCount);
  let event=0;
  let value=0;
  let stored=count;
  if(time-time!=0.0 || duration-duration!=0.0 || duration<0.0 || loop<2200 || loop>2202) { return 0-1; }
  if(delta!=0.0) {
    if(loop==2200) {
      count=0;
      stored=0;
      if(time>=duration) { time=duration; event=2; }
      else if(time<0.0) { time=0.0; event=2; }
    } else if(duration==0.0) { return 0-1; }
    else {
      if(count==-1 && delta>0.0) { count=0; }
      if(time>=duration || time<0.0) {
        let quotient=time/duration;
        if(quotient< -2147483647.0 || quotient>2147483647.0) { return 0-2; }
        let loops=f64_floor_i64(quotient);
        time=time-duration*loops;
        let crossed=loops;
        if(crossed<0) { crossed=0-crossed; }
        count=count+crossed;
        if(count>2147483647) { return 0-2; }
        let limit=ux_i32(action+AnimationAction.repetitions);
        if(limit>=0 && count>=limit) {
          time=0.0;
          if(delta>0.0) { time=duration; }
          event=2;
        } else {
          stored=count;
          event=1;
          value=loops;
        }
      }
    }
  }
  if(event==2) {
    value=1;
    if(delta<0.0) { value=0-1; }
    if(ux_u32(action+AnimationAction.clamp)!=0) { let paused=ux_u32_put(action+AnimationAction.paused,1); }
    else { let disabled=ux_u32_put(action+AnimationAction.enabled,0); }
  }
  let sample=time;
  if(loop==2202 && count%2==1) { sample=duration-time; }
  let a=ux_f64_put(action+AnimationAction.time,time);
  let b=ux_f64_put(action+AnimationAction.sampleTime,sample);
  let c=ux_i32_put(action+AnimationAction.loopCount,stored);
  let d=ux_u32_put(action+AnimationAction.event,event);
  let e=ux_i32_put(action+AnimationAction.eventValue,value);
  return action;
}
