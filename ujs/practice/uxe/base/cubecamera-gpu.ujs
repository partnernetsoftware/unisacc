// Record six level-zero face passes. The scene callback records into the
// same packet and receives the local face orientation as six f64 values.
function CubeCamera_update(render_face,...cube_update_args) {
  let cube_packet=cube_update_args[0];
  let cube_capacity=cube_update_args[1];
  let cube_target=cube_update_args[2];
  let cube_restore=cube_update_args[3];
  let cube_layer=cube_update_args[4];
  let cube_directions=cube_update_args[5];
  let cube_coordinateSystem=cube_update_args[6];
  let cube_result=0-1;
  if(cube_target>=1 && cube_target<=1024 && cube_restore>=0 && cube_restore<=1024 &&
     cube_layer>=0 && cube_layer<=255 &&
     gpu_packet_slot(cube_packet,cube_capacity,112)>=0 &&
     gpu_draw_range(cube_directions,288,cube_packet,cube_capacity) &&
     cube_face_coordinates(cube_directions,cube_coordinateSystem)>=0) {
    let cube_length=ux_u32(cube_packet+GpuPacket.bytes);
    let cube_commands=ux_u32(cube_packet+GpuPacket.commands);
    let cube_face=0;
    let cube_status=0;
    while(cube_face<6 && cube_status>=0) {
      cube_status=GpuTarget_bind(cube_packet,cube_capacity,cube_target,cube_face);
      if(cube_status>=0) { cube_status=render_face(cube_face,cube_directions+48*cube_face); }
      cube_face=cube_face+1;
    }
    if(cube_status>=0) { cube_status=GpuTarget_bind(cube_packet,cube_capacity,cube_restore,cube_layer); }
    if(cube_status<0) {
      let truncated=ux_u32_put(cube_packet+GpuPacket.bytes,cube_length);
      let removed=ux_u32_put(cube_packet+GpuPacket.commands,cube_commands);
      cube_result=cube_status;
    } else {
      cube_result=6;
    }
  }
  return cube_result;
}
