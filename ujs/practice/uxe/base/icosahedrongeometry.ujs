// The workspace contains the parameter record, 12 vertices, 20 faces and a triangle scratch area.
native function IcosahedronGeometry_generate(mesh:i64,work:i64,radius:f64,detail:i64) i64 {
  if(work<0 || work>6291456-632 || work%8!=0) { return 0-1; }
  let source=work+32;
  let indices=work+320;
  let phi=(1.0+f64_sqrt(5.0))*0.5;
  let i=0;
  while(i<12) {
    let short_value=2.0*(i%2)-1.0;
    let long_value=phi*(1.0-2.0*((i%4)/2));
    let axis=i/4;
    let coord=0;
    while(coord<3) {
      let value=0.0;
      if(coord==axis) { value=short_value; }
      if(coord==(axis+1)%3) { value=long_value; }
      let write=ux_f64_put(source+i*24+coord*8,value);
      coord=coord+1;
    }
    i=i+1;
  }
  let faces=[1105,501,107,710,1011,10509,51104,111002,100706,70108,
    30904,30402,30206,30608,30809,40905,20411,60210,80607,90801];
  let face=0;
  while(face<20) {
    let code=faces[face];
    let at=indices+face*12;
    let a=ux_u32_put(at,code/10000);
    let b=ux_u32_put(at+4,(code/100)%100);
    let c=ux_u32_put(at+8,code%100);
    face=face+1;
  }
  let config=PolyhedronGeometry_init(work,source,12,indices,60,work+560);
  return PolyhedronGeometry_generate(mesh,config,radius,detail);
}
