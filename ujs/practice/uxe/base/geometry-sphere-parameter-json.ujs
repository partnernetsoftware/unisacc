native function sphere_geometry_keys(at:i64) i64 {
  let labels=[83,112,104,101,114,101,71,101,111,109,101,116,114,121,
    114,97,100,105,117,115,
    119,105,100,116,104,83,101,103,109,101,110,116,115,
    104,101,105,103,104,116,83,101,103,109,101,110,116,115,
    112,104,105,83,116,97,114,116,112,104,105,76,101,110,103,116,104,
    116,104,101,116,97,83,116,97,114,116,116,104,101,116,97,76,101,110,103,116,104];
  let i=0;
  while(i<85) {
    let byte=ux_u8_put(at+i,labels[i]);
    i=i+1;
  }
  return at;
}

native function SphereGeometry_toJSON(sphere:i64,dst:i64,end:i64,uuid:i64,uuidBytes:i64,scratch:i64) i64 {
  if(SphereGeometry_geometry(sphere)<0 || geometry_primitive_ready(sphere,5)<0 ||
     !geometry_primitive_json_io(sphere,dst,end,uuid,uuidBytes,scratch,85)) { return 0-1; }
  let tail=sphere+GeometryPrimitive_size();
  if(!geometry_public_disjoint(tail,8,dst,end-dst) ||
     !geometry_public_disjoint(tail,8,scratch,1189)) { return 0-1; }
  let keys=sphere_geometry_keys(scratch+1104);
  let p=geometry_primitive_json_head(sphere,dst,end,uuid,uuidBytes,keys,14);
  p=geometry_parameter_number(p,end,keys+14,6,ux_f64(sphere+GeometryPrimitiveRecord.first),scratch);
  p=geometry_parameter_number(p,end,keys+20,13,ux_f64(sphere+GeometryPrimitiveRecord.second),scratch);
  p=geometry_parameter_number(p,end,keys+33,14,ux_f64(sphere+GeometryPrimitiveRecord.third),scratch);
  p=geometry_parameter_number(p,end,keys+47,8,ux_f64(sphere+GeometryPrimitiveRecord.fourth),scratch);
  p=geometry_parameter_number(p,end,keys+55,9,ux_f64(sphere+GeometryPrimitiveRecord.fifth),scratch);
  p=geometry_parameter_number(p,end,keys+64,10,ux_f64(sphere+GeometryPrimitiveRecord.sixth),scratch);
  p=geometry_parameter_number(p,end,keys+74,11,ux_f64(tail),scratch);
  return json_byte(p,end,125);
}

native function SphereGeometry_fromJSON(sphere:i64,raw:i64,arena:i64,bytes:i64,input:i64,end:i64,scratch:i64) i64 {
  let space=SphereGeometryParameters.size+85;
  if(scratch%8!=0 || end<=input ||
     !sphere_geometry_raw(sphere,raw,arena,bytes,input,end-input) ||
     !sphere_geometry_raw(sphere,raw,arena,bytes,scratch,space) ||
     !geometry_public_disjoint(input,end-input,scratch,space) ||
     !geometry_primitive_json_object(input,end)) { return 0-1; }
  let keys=sphere_geometry_keys(scratch+SphereGeometryParameters.size);
  let a=ux_f64_put(scratch+SphereGeometryParameters.radius,geometry_primitive_json_number(input,end,keys+14,6,1.0));
  let b=ux_f64_put(scratch+SphereGeometryParameters.widthSegments,geometry_primitive_json_number(input,end,keys+20,13,32.0));
  let c=ux_f64_put(scratch+SphereGeometryParameters.heightSegments,geometry_primitive_json_number(input,end,keys+33,14,16.0));
  let d=ux_f64_put(scratch+SphereGeometryParameters.phiStart,geometry_primitive_json_number(input,end,keys+47,8,0.0));
  let e=ux_f64_put(scratch+SphereGeometryParameters.phiLength,geometry_primitive_json_number(input,end,keys+55,9,6.283185307179586));
  let f=ux_f64_put(scratch+SphereGeometryParameters.thetaStart,geometry_primitive_json_number(input,end,keys+64,10,0.0));
  let g=ux_f64_put(scratch+SphereGeometryParameters.thetaLength,geometry_primitive_json_number(input,end,keys+74,11,3.141592653589793));
  return SphereGeometry_create(sphere,raw,arena,bytes,scratch);
}
