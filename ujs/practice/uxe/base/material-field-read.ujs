// Return NaN for an invalid field value so Material_setValues can reject atomically.
native function material_json_read(at:i64,end:i64,scratch:i64,key0:i64,key1:i64,key2:i64,format:i64,fallback:f64) f64 {
  let size=format/2;
  let word=key0;
  let i=0;
  while(i<size) {
    if(i==8) { word=key1; }
    if(i==16) { word=key2; }
    let stored=ux_u8_put(scratch+i,word%256);
    word=word/256;
    i=i+1;
  }
  let value=json_find_key(at,end,scratch,size);
  if(value==0-2) { return fallback; }
  if(value<0) { return 0.0/0.0; }
  if(format%2==0) { return json_read_number(value,end); }
  let next=json_scalar_end(value,end);
  if(next-value==4 && ux_u8(value)==116) { return 1.0; }
  if(next-value==5 && ux_u8(value)==102) { return 0.0; }
  return 0.0/0.0;
}
