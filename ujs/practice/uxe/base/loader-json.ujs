// The caller reserves 12 disjoint scratch bytes for small ASCII schema keys.
native function LoaderJson_find(obj:i64,end:i64,key:i64,lo:i64,mid:i64,hi:i64,bytes:i64) i64 {
  let a=ux_u32_put(key,lo);
  let b=ux_u32_put(key+4,mid);
  let c=ux_u32_put(key+8,hi);
  return json_find_key(obj,end,key,bytes);
}

native function LoaderJson_number(at:i64,end:i64,fallback:f64) f64 {
  if(at==0-2) { return fallback; }
  return json_read_number(at,end);
}

native function LoaderJson_uint(at:i64,end:i64,fallback:i64) i64 {
  if(at==0-2) { return fallback; }
  let value=json_read_number(at,end);
  if(value!=value || value<0.0 || value>4294967295.0) { return 0-1; }
  let integer=f64_floor_i64(value);
  if(value!=0.0+integer) { return 0-1; }
  return integer;
}

native function LoaderJson_item(at:i64,end:i64,index:i64) i64 {
  if(at<0 || at>=end || index<0 || index>65535 || ux_u8(at)!=91) { return 0-1; }
  let item=json_space(at+1,end);
  let i=0;
  while(item>=0 && item<end && ux_u8(item)!=93) {
    let next=json_space(json_value_end(item,end),end);
    if(next<0 || next>=end) { return 0-1; }
    if(i==index) { return item; }
    if(ux_u8(next)!=44) { return 0-1; }
    item=json_space(next+1,end);
    i=i+1;
  }
  return 0-1;
}

// Each immutable resource row holds a UUID span and a nonzero typed handle.
native function object_load_reference(token:i64,end:i64,table:i64,count:i64) i64 {
  let close=json_scan_string(token,end);
  if(close<0 || close-token<3) { return 0-1; }
  let i=0;
  let result=0;
  while(i<count) {
    let row=table+i*12;
    let address=ux_u32(row);
    let size=ux_u32(row+4);
    if(size<1 || size>128 || address>6291456-size) { return 0-1; }
    let same=size==close-token-2;
    let j=0;
    while(same && j<size) {
      same=ux_u8(address+j)==ux_u8(token+1+j);
      j=j+1;
    }
    if(same) {
      if(result!=0 || ux_u32(row+8)==0) { return 0-1; }
      result=ux_u32(row+8);
    }
    i=i+1;
  }
  if(result==0) { return 0-1; }
  return result;
}
