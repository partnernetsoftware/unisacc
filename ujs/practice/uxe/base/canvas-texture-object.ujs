// The host supplies an RGBA8 snapshot from its canvas. The texture object never
// reads host state directly, and each accepted refresh publishes one version.
native function CanvasTexture_init(at:i64,table:i64,descriptor:i64) i64 {
  let texture=Texture_init(at,table,descriptor);
  if(texture<0) { return texture; }
  let updated=Texture_needsUpdate(texture);
  return texture;
}

function CanvasTexture_refresh(canvas_texture) {
  return Texture_needsUpdate(canvas_texture);
}

function CanvasTexture_clone(canvas_destination,...canvas_clone_args) {
  return Texture_clone(canvas_destination,canvas_clone_args[0]);
}
