native function GpuMaterial_phongSpecular(specular:f64,dotNL:f64,dotNH:f64,dotVH:f64,shine:f64,light:f64) f64 {
  if(dotNL<=0.0 || dotNH<=0.0 || light<=0.0 || shine<0.0) { return 0.0; }
  let fresnel=specular+(1.0-specular)*ux_math_pow(2.0,(-5.55473*dotVH-6.98316)*dotVH);
  let distribution=(shine*0.5+1.0)*ux_math_pow(dotNH,shine)*0.3183098861837907;
  return dotNL*light*fresnel*0.25*distribution;
}
