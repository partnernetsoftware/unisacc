// Keep geometry records in the consumer module and copy only the world
// matrix scalars from the owning scene module.
import uxe_scene from "uxe_scene_v1" (i64,i64,i64,f64,f64,f64) f64;

function SceneBounds_readWorld(sb_matrix,...sb_args) {
  let sb_cell=0;
  while(sb_cell<16) {
    let sb_value=uxe_scene(3,sb_args[0],sb_cell,0.0,0.0,0.0);
    let sb_written=ux_f64_put(sb_matrix+8*sb_cell,sb_value);
    sb_cell=sb_cell+1;
  }
  return sb_matrix;
}

// Each bound record is prepared by the consumer and retains its local
// geometry pointers. Traversal supplies the world matrix in preorder.
function SceneBounds_fillRows(sb_root,...sb_rows_args) {
  let sb_row_base=sb_rows_args[0];
  let sb_matrices=sb_rows_args[1];
  let sb_capacity=sb_rows_args[2];
  let sb_sync=uxe_scene(2,sb_root,0,0.0,0.0,0.0);
  let sb_node=f64_floor_i64(uxe_scene(4,sb_root,sb_root,0.0,0.0,0.0));
  let sb_row_count=0;
  while(sb_node>0 && sb_row_count<sb_capacity) {
    let sb_at=sb_row_base+28*sb_row_count;
    let sb_mat=SceneBounds_readWorld(sb_matrices+128*sb_row_count,sb_node);
    let sb_bind=ux_u32_put(sb_at,sb_mat);
    sb_row_count=sb_row_count+1;
    sb_node=f64_floor_i64(uxe_scene(4,sb_root,sb_node,0.0,0.0,0.0));
  }
  let sb_result=sb_row_count;
  if(sb_node!=0 || sb_sync<0.0) { sb_result=0-1; }
  return sb_result;
}
