struct AxesHelper {
  positions: u32;
  colors: u32;
  count: u32;
  colorVersion: u32;
  active: u32;
}

native function axes_span(at:i64,bytes:i64) i64 {
  return at>=0 && at%4==0 && at<=6291456-bytes;
}

native function axes_disjoint(at:i64,bytes:i64,other:i64,size:i64) i64 {
  return at+bytes<=other || other+size<=at;
}

native function AxesHelper_init(helper:i64,positions:i64,colors:i64,size:f64) i64 {
  if(!axes_span(helper,AxesHelper.size) || !axes_span(positions,72) || !axes_span(colors,72) ||
     !axes_disjoint(helper,AxesHelper.size,positions,72) || !axes_disjoint(helper,AxesHelper.size,colors,72) ||
     !axes_disjoint(positions,72,colors,72) || size-size!=0.0) { return 0-1; }
  let i=0;
  while(i<18) {
    let axis=i/6;
    let coordinate=i%3;
    let endpoint=i%6>=3;
    let point=0.0;
    let color=0.0;
    if(coordinate==axis) {
      color=1.0;
      if(endpoint) { point=size; }
    }
    if(endpoint && ((axis==1 && coordinate==0) || (axis!=1 && coordinate==1))) { color=0.6; }
    let p=ux_f32_put(positions+i*4,point);
    let c=ux_f32_put(colors+i*4,color);
    i=i+1;
  }
  let p=ux_u32_put(helper+AxesHelper.positions,positions);
  let c=ux_u32_put(helper+AxesHelper.colors,colors);
  let n=ux_u32_put(helper+AxesHelper.count,6);
  let v=ux_u32_put(helper+AxesHelper.colorVersion,0);
  let a=ux_u32_put(helper+AxesHelper.active,1);
  return helper;
}

// The caller supplies three colors already converted to linear RGB.
native function AxesHelper_setColors(helper:i64,source:i64) i64 {
  if(!axes_span(helper,AxesHelper.size) || ux_u32(helper+AxesHelper.active)!=1 || !axes_span(source,36)) { return 0-1; }
  let colors=ux_u32(helper+AxesHelper.colors);
  let version=ux_u32(helper+AxesHelper.colorVersion);
  if(!axes_span(colors,72) || !axes_disjoint(colors,72,source,36) ||
     !axes_disjoint(colors,72,helper,AxesHelper.size) || version==4294967295) { return 0-1; }
  let i=0;
  while(i<9) {
    let value=ux_f32(source+i*4);
    if(value-value!=0.0) { return 0-1; }
    i=i+1;
  }
  i=0;
  while(i<9) {
    let color=ux_u32(source+i*4);
    let at=colors+(i/3*6+i%3)*4;
    let a=ux_u32_put(at,color);
    let b=ux_u32_put(at+12,color);
    i=i+1;
  }
  let v=ux_u32_put(helper+AxesHelper.colorVersion,version+1);
  return helper;
}

native function AxesHelper_dispose(helper:i64) i64 {
  if(!axes_span(helper,AxesHelper.size) || ux_u32(helper+AxesHelper.active)!=1) { return 0-1; }
  let gone=ux_u32_put(helper+AxesHelper.active,0);
  return 0;
}
