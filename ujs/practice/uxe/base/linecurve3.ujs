native function LineCurve3_getPoint(dst:i64,ends:i64,t:f64) i64 {
  return curve_line_point(dst,ends,3,t);
}
native function LineCurve3_getPointAt(dst:i64,ends:i64,t:f64) i64 {
  return LineCurve3_getPoint(dst,ends,t);
}
native function LineCurve3_getLength(ends:i64) f64 {
  return curve_line_length(ends,3);
}
native function LineCurve3_getTangent(dst:i64,ends:i64) i64 {
  return curve_line_tangent(dst,ends,3);
}

native function LineCurve3_getTangentAt(dst:i64,ends:i64) i64 {
  return LineCurve3_getTangent(dst,ends);
}

native function LineCurve3_getPoints(out:i64,ends:i64,steps:i64) i64 {
  return curve_line_collect(out,ends,steps,3);
}

native function LineCurve3_getSpacedPoints(out:i64,ends:i64,steps:i64) i64 {
  return LineCurve3_getPoints(out,ends,steps);
}

native function LineCurve3_getLengths(out:i64,ends:i64,steps:i64) i64 {
  return curve_line_lengths(out,ends,steps,3);
}
