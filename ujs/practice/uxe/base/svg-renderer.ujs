// Convert one already ordered, projected triangle to an SVG M-L-L-z descriptor.
// src holds three NDC triples and dst holds three SVG coordinate pairs (f64).
// This is the r160 face stage at overdraw=0. A rejected face leaves dst intact.
// Return 1 for a descriptor, 0 for clipping, and -1 for invalid input.
native function SVGRenderer_projectedFace(src:i64,dst:i64,width:i64,height:i64) i64 {
  if(width<1 || height<1 || width>2147483647 || height>2147483647 ||
     src<0 || src>6291384 || dst<0 || dst>6291408 ||
     (src<dst+48 && dst<src+72)) { return 0-1; }

  let halfWidth=(0.0+width)*0.5;
  let halfHeight=(0.0+height)*0.5;
  let x1=ux_f64(src)*halfWidth;
  let x2=ux_f64(src+24)*halfWidth;
  let x3=ux_f64(src+48)*halfWidth;
  let y1=ux_f64(src+8)*(0.0-halfHeight);
  let y2=ux_f64(src+32)*(0.0-halfHeight);
  let y3=ux_f64(src+56)*(0.0-halfHeight);
  let z1=ux_f64(src+16);
  let z2=ux_f64(src+40);
  let z3=ux_f64(src+64);
  if(x1-x1!=0.0 || x2-x2!=0.0 || x3-x3!=0.0 ||
     y1-y1!=0.0 || y2-y2!=0.0 || y3-y3!=0.0 ||
     z1-z1!=0.0 || z2-z2!=0.0 || z3-z3!=0.0) { return 0-1; }

  if(z1<0.0-1.0 || z1>1.0 || z2<0.0-1.0 || z2>1.0 ||
     z3<0.0-1.0 || z3>1.0) { return 0; }
  if((x1<0.0-halfWidth && x2<0.0-halfWidth && x3<0.0-halfWidth) ||
     (x1>halfWidth && x2>halfWidth && x3>halfWidth) ||
     (y1<0.0-halfHeight && y2<0.0-halfHeight && y3<0.0-halfHeight) ||
     (y1>halfHeight && y2>halfHeight && y3>halfHeight)) { return 0; }

  let putX1=ux_f64_put(dst,x1);
  let putY1=ux_f64_put(dst+8,y1);
  let putX2=ux_f64_put(dst+16,x2);
  let putY2=ux_f64_put(dst+24,y2);
  let putX3=ux_f64_put(dst+32,x3);
  let putY3=ux_f64_put(dst+40,y3);
  return 1;
}
