struct SSAOOrthographicInput {
  width:u32;
  height:u32;
  depth:u32;
  samples:u32;
  count:u32;
  minDistance:u32;
  maxDistance:u32;
}

struct SSAOProjectedSample {
  xBiased:u32;
  yBiased:u32;
  towardCamera:u32;
}

native function ssao_range(at:i64, size:i64) i64 {
  return at>=0 && at<=6291456-size;
}

native function ssao_overlap(a:i64, aBytes:i64, b:i64, bBytes:i64) i64 {
  return a<b+bBytes && b<a+aBytes;
}

native function ssao_clamp_index(value:i64, size:i64) i64 {
  if(value<0) { return 0; }
  if(value>=size) { return size-1; }
  return value;
}

// Orthographic, constant-normal raw SSAO with nearest depth sampling.
// Depth and distance use units of 1/256 of camera range. Sample XY shifts
// are preprojected whole texels encoded with bias 8. The Z shift is toward the camera.
// A power-of-two sample count keeps the raw value exact in an RGBA16F target.
native function ssao_texel(at:f64,size:i64) i64 {
  let i=0;
  while(i+1<size && at>=1.0*(i+1)) { i=i+1; }
  return i;
}

// Model the float depth texture and shader arithmetic at comparison boundaries.
native function ssao_distance(z:i64, scratch:i64) f64 {
  let a=ux_f32_put(scratch,(1.0-32.0/(32+z))*1.125);
  let b=ux_f32_put(scratch,8.0*ux_f32(scratch)-9.0);
  let c=ux_f32_put(scratch,-9.0/ux_f32(scratch));
  return ux_f32(scratch);
}

native function ssao_raw(input:i64, out:i64, perspective:i64) i64 {
  if(!ssao_range(input,SSAOOrthographicInput.size)) { return 0-1; }
  let width=ux_u32(input+SSAOOrthographicInput.width);
  let height=ux_u32(input+SSAOOrthographicInput.height);
  let depth=ux_u32(input+SSAOOrthographicInput.depth);
  let samples=ux_u32(input+SSAOOrthographicInput.samples);
  let count=ux_u32(input+SSAOOrthographicInput.count);
  let minimum=ux_u32(input+SSAOOrthographicInput.minDistance);
  let maximum=ux_u32(input+SSAOOrthographicInput.maxDistance);
  if(width<1 || width>64 || height<1 || height>64 ||
     (count!=1 && count!=2 && count!=4 && count!=8 && count!=16 && count!=32) ||
     maximum<=minimum || maximum>256) { return 0-1; }
  let area=width*height;
  let sampleBytes=count*SSAOProjectedSample.size;
  if(!ssao_range(depth,area*4) || !ssao_range(samples,sampleBytes) || !ssao_range(out,area*4) ||
     ssao_overlap(out,area*4,depth,area*4) || ssao_overlap(out,area*4,samples,sampleBytes) ||
     ssao_overlap(out,area*4,input,SSAOOrthographicInput.size)) { return 0-1; }
  let i=0;
  while(i<area) {
    if(ux_u32(depth+i*4)>256) { return 0-1; }
    i=i+1;
  }
  i=0;
  while(i<count) {
    let s=samples+i*SSAOProjectedSample.size;
    if(ux_u32(s+SSAOProjectedSample.xBiased)>16 || ux_u32(s+SSAOProjectedSample.yBiased)>16 ||
       ux_u32(s+SSAOProjectedSample.towardCamera)>256) { return 0-1; }
    i=i+1;
  }
  if(perspective!=0) {
    let nearest=288;
    i=0;
    while(i<area) {
      let z=ux_u32(depth+i*4);
      if(z<nearest) { nearest=z; }
      i=i+1;
    }
    i=0;
    while(i<count) {
      if(ux_u32(samples+i*SSAOProjectedSample.size+SSAOProjectedSample.towardCamera)>=32+nearest) { return 0-1; }
      i=i+1;
    }
  }
  let y=0;
  while(y<height) {
    let x=0;
    while(x<width) {
      let at=(y*width+x)*4;
      let center=ux_u32(depth+at);
      let covered=0;
      if(center!=256) {
        i=0;
        while(i<count) {
          let s=samples+i*SSAOProjectedSample.size;
          let sx=ssao_clamp_index(x+ux_u32(s+SSAOProjectedSample.xBiased)-8,width);
          let sy=ssao_clamp_index(y+ux_u32(s+SSAOProjectedSample.yBiased)-8,height);
          let shift=ux_u32(s+SSAOProjectedSample.towardCamera);
          if(perspective!=0) {
            let view=32+center;
            let sampleView=view-shift;
            let ux=ux_u32(s+SSAOProjectedSample.xBiased);
            let uy=ux_u32(s+SSAOProjectedSample.yBiased);
            if(sampleView<=0) { return 0-1; }
            let px=0.5*width+(0.5*(2*x+1-width)*view+160.0*(ux-8))/(1.0*sampleView);
            let py=0.5*height+(0.5*(2*y+1-height)*view+160.0*(uy-8))/(1.0*sampleView);
            sx=ssao_texel(px,width);
            sy=ssao_texel(py,height);
          }
          let neighbor=ux_u32(depth+(sy*width+sx)*4);
          if(perspective==0) {
            let delta=center-shift-neighbor;
            if(delta>minimum && delta<maximum) { covered=covered+1; }
          } else {
            let sampleDistance=ssao_distance(center,out+at);
            let sampledDepth=ssao_distance(neighbor,out+at);
            let rounded=ux_f32_put(out+at,sampleDistance-0.03125*shift);
            let difference=ux_f32_put(out+at,ux_f32(out+at)-sampledDepth);
            let deltaF=32.0*ux_f32(out+at);
            if(perspective==2) { deltaF=0.0-deltaF; }
            if(deltaF>1.0*minimum && deltaF<1.0*maximum) { covered=covered+1; }
          }
          i=i+1;
        }
      }
      let brightness=((count-covered)*255*2+count)/(count*2);
      let rgba=ux_u32_put(out+at,4278190080+65793*brightness);
      x=x+1;
    }
    y=y+1;
  }
  return 0;
}

native function SSAO_rawOrthographic(input:i64, out:i64) i64 {
  let status=ssao_raw(input,out,0);
  return status;
}

// Perspective projection uses a symmetric frustum with a 90 degree vertical
// field of view and aspect width/height, with near 1 and far 9.
native function SSAO_rawPerspective(input:i64, out:i64) i64 {
  let status=ssao_raw(input,out,1);
  return status;
}
