// The base selects the GLSL through a GpuShaderSource record. The source and
// intermediate destination must be same-sized RGBA8 2D targets.
native function NativeTargetCopy_step(step:i64,generation:i64,shader:i64) i64 {
  if(!composer_span(step,ComposerStep.size) || !composer_span(shader,GpuShaderSource.size) ||
     generation<1 || generation>4294967295) { return 0-1; }
  let vs=ux_u32(shader+GpuShaderSource.vertex);
  let fs=ux_u32(shader+GpuShaderSource.fragment);
  let vn=ux_u32(shader+GpuShaderSource.vertexBytes);
  let fn=ux_u32(shader+GpuShaderSource.fragmentBytes);
  if(vn<1 || vn>4096 || fn<1 || fn>4096 || vs>6291456-vn || fs>6291456-fn) { return 0-1; }
  let read=ux_u32(step+ComposerStep.read);
  let write=ux_u32(step+ComposerStep.write);
  let flags=ux_u32(step+ComposerStep.flags);
  let screen=ux_u32(step+ComposerStep.screen);
  if(read<1 || read>1024 || write<1 || write>1024 || read==write || screen>1 ||
     flags>7 || u32_and(flags,3)!=3) { return 0-1; }
  if(screen==1) { write=0; }
  return host_gpu_native_copy(generation,read,write,shader);
}
