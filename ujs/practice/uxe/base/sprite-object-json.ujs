// Sprite keeps its shared material and an independent anchor.
native function Sprite_clone(dst:i64,dstArena:i64,src:i64,srcArena:i64,recursive:i64) i64 {
  if(!sprite_valid(dst) || !sprite_valid(src) || (dst<src+Sprite.size && src<dst+Sprite.size)) { return 0-1; }
  let from=ux_u32(src+Sprite.node);
  let to=ux_u32(dst+Sprite.node);
  if(dstArena==srcArena && from==to) { return 0-1; }
  let node=Object3D_copy(dstArena,to,srcArena,from,recursive);
  if(node<0) { return node; }
  let m=ux_u32_put(dst+Sprite.material,ux_u32(src+Sprite.material));
  let x=ux_f64_put(dst+Sprite.centerX,ux_f64(src+Sprite.centerX));
  let y=ux_f64_put(dst+Sprite.centerY,ux_f64(src+Sprite.centerY));
  return dst;
}

native function Sprite_dispose(sprite:i64,arena:i64) i64 {
  if(!sprite_valid(sprite)) { return 0-1; }
  let released=Object3D_destroy(arena,ux_u32(sprite+Sprite.node));
  if(released<0) { return released; }
  let node=ux_u32_put(sprite+Sprite.node,0);
  return released;
}

native function Sprite_toJSON(sprite:i64,arena:i64,ids:i64,dst:i64,end:i64,scratch:i64) i64 {
  if(!sprite_valid(sprite) || !camera_json_disjoint(sprite,Sprite.size,dst,end) ||
     !camera_json_disjoint(sprite,Sprite.size,scratch,scratch+1104) || ids%4!=0 ||
     !camera_json_disjoint(ids,16,dst,end) || !camera_json_disjoint(ids,16,scratch,scratch+1104)) { return 0-1; }
  let node=Object3D_address(arena,ux_u32(sprite+Sprite.node));
  let material=ux_u32(ids+8);
  let length=ux_u32(ids+12);
  if(node<0 || length<1 || !camera_json_disjoint(material,length,dst,end) ||
     !camera_json_disjoint(material,length,scratch,scratch+1104)) { return 0-1; }
  let p=camera_json_begin(node,ux_u32(ids),ux_u32(ids+4),dst,end,scratch,17);
  p=camera_json_word(p,end,1634542124,4);
  p=camera_json_word(p,end,1769104756,4);
  p=camera_json_word(p,end,975334497,4);
  p=json_write_string(p,end,material,length);
  p=json_byte(p,end,125);
  return json_byte(p,end,125);
}

native function Sprite_fromJSON(sprite:i64,arena:i64,input:i64,end:i64,scratch:i64,table:i64,count:i64) i64 {
  if(!sprite_valid(sprite) || input<0 || end<=input || end>6291456 ||
     !camera_json_disjoint(scratch,160,input,end) || scratch%8!=0 ||
     !camera_json_disjoint(sprite,Sprite.size,input,end) ||
     !camera_json_disjoint(sprite,Sprite.size,scratch,scratch+160) ||
     table%4!=0 || count<1 || count>65535 ||
     !camera_json_disjoint(table,count*12,scratch,scratch+160)) { return 0-1; }
  let node=Object3D_address(arena,ux_u32(sprite+Sprite.node));
  if(node<0 || !camera_json_disjoint(node,Object3D.size,scratch,scratch+160)) { return 0-1; }
  let i=0;
  while(i<count) {
    let entry=table+i*12;
    if(!camera_json_disjoint(ux_u32(entry),ux_u32(entry+4),scratch,scratch+160)) { return 0-1; }
    i=i+1;
  }
  let root=json_space(input,end);
  let object=LoaderJson_find(root,end,scratch,1701470831,29795,0,6);
  let limit=json_value_end(object,end);
  if(object<0 || limit<0) { return 0-2; }
  let token=LoaderJson_find(object,limit,scratch,1702125933,1818323314,0,8);
  let material=object_load_reference(token,limit,table,count);
  if(material<0) { return 0-2; }
  let restored=camera_json_restore(node,input,end,scratch,17);
  if(restored<0) { return restored; }
  let m=ux_u32_put(sprite+Sprite.material,material);
  let x=ux_f64_put(sprite+Sprite.centerX,0.5);
  let y=ux_f64_put(sprite+Sprite.centerY,0.5);
  return sprite;
}
