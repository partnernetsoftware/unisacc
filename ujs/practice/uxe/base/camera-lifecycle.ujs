// Lens and Camera records are independently allocated. Lens records must not
// overlap either Camera record or any of its matrix storage.
native function camera_lens_copy(dst:i64,src:i64,size:i64,dst_camera:i64,src_camera:i64) i64 {
  if(dst%8!=0 || src%8!=0 || dst_camera<0 || dst_camera>6291456-Camera.size ||
     dst_camera%4!=0 || src_camera<0 || src_camera>6291456-Camera.size ||
     src_camera%4!=0) { return 0-1; }
  let lens=uxe_copy_record(dst,src,size);
  if(lens<0) { return lens; }
  let matrices=Camera_copy(dst_camera,src_camera);
  return lens;
}

native function camera_lens_clone(dst:i64,src:i64,size:i64,dst_camera:i64,src_camera:i64,matrices:i64) i64 {
  if(dst<0 || dst>6291456-size || dst%8!=0 || src<0 || src>6291456-size || src%8!=0 ||
     Camera_blocksOverlap(dst,size,dst_camera,Camera.size) ||
     Camera_blocksOverlap(dst,size,matrices,384) ||
     Camera_blocksOverlap(src,size,dst_camera,Camera.size) ||
     Camera_blocksOverlap(src,size,matrices,384)) { return 0-1; }
  let cloned=Camera_clone(dst_camera,src_camera,matrices);
  if(cloned<0) { return cloned; }
  return uxe_copy_record(dst,src,size);
}

native function PerspectiveCamera_copy(dst:i64,src:i64,dst_camera:i64,src_camera:i64) i64 {
  return camera_lens_copy(dst,src,PerspectiveCamera.size,dst_camera,src_camera);
}

native function PerspectiveCamera_clone(dst:i64,src:i64,dst_camera:i64,src_camera:i64,matrices:i64) i64 {
  return camera_lens_clone(dst,src,PerspectiveCamera.size,dst_camera,src_camera,matrices);
}

native function OrthographicCamera_copy(dst:i64,src:i64,dst_camera:i64,src_camera:i64) i64 {
  return camera_lens_copy(dst,src,OrthographicCamera.size,dst_camera,src_camera);
}

native function OrthographicCamera_clone(dst:i64,src:i64,dst_camera:i64,src_camera:i64,matrices:i64) i64 {
  return camera_lens_clone(dst,src,OrthographicCamera.size,dst_camera,src_camera,matrices);
}

// The inherited copy preserves the destination list. A newly constructed
// ArrayCamera has an empty list even when its projection copies the source.
native function ArrayCamera_clone(dst_array:i64,dst_lens:i64,src_lens:i64,dst_camera:i64,
                                  src_camera:i64,matrices:i64) i64 {
  if(dst_array<0 || dst_array>6291456-ArrayCamera.size || dst_array%4!=0 ||
     Camera_blocksOverlap(dst_array,ArrayCamera.size,dst_lens,PerspectiveCamera.size) ||
     Camera_blocksOverlap(dst_array,ArrayCamera.size,src_lens,PerspectiveCamera.size) ||
     Camera_blocksOverlap(dst_array,ArrayCamera.size,dst_camera,Camera.size) ||
     Camera_blocksOverlap(dst_array,ArrayCamera.size,matrices,384)) { return 0-1; }
  let clone=PerspectiveCamera_clone(dst_lens,src_lens,dst_camera,src_camera,matrices);
  if(clone<0) { return clone; }
  return ArrayCamera_init(dst_array,0,0);
}
