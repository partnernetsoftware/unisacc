native function TextureLoader_decodeAsyncPng(instance:i64,id:i64,image:i64,rgba:i64,capacity:i64,scratch:i64,space:i64,source:i64) i64 {
  if(loader_family_kind(instance)!=5 || !loader_family_decode_range(instance,source,GpuTextureSource.size) ||
     !loader_family_decode_range(instance,image,ImageResource.size) ||
     !loader_family_decode_range(instance,rgba,capacity) ||
     !loader_family_decode_range(instance,scratch,space) ||
     !file_disjoint(source,GpuTextureSource.size,image,ImageResource.size) ||
     !file_disjoint(source,GpuTextureSource.size,rgba,capacity) ||
     !file_disjoint(source,GpuTextureSource.size,scratch,space)) { return 0-1; }
  let file=loader_family_ready(instance,id);
  if(file<0 || !file_disjoint(source,GpuTextureSource.size,
      ux_u32(file+FileLoader.bytes),ux_u32(file+FileLoader.length))) { return 0-1; }
  let decoded=ImageLoader_decodePng(file,image,rgba,capacity,scratch,space);
  let released=FileLoader_release(file,id);
  if(decoded<0) { return decoded; }
  return TextureLoader_fromImage(image,source);
}
