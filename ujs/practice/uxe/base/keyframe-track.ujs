struct KeyframeTrack {
  name: u32;
  nameBytes: u32;
  samples: u32;
  interpolation: u32;
}

native function keyframe_track_at(track:i64) i64 {
  return animation_span(track,KeyframeTrack.size);
}

native function KeyframeTrack_init(track:i64,name:i64,bytes:i64,view:i64) i64 {
  if(!keyframe_track_at(track) || bytes<1 || bytes>65535 || name<0 || name>6291456-bytes ||
     !animation_span(view,AnimationSamples.size) || animation_overlap(track,KeyframeTrack.size,name,bytes) ||
     animation_overlap(track,KeyframeTrack.size,view,AnimationSamples.size)) { return 0-1; }
  let n=ux_u32(view+AnimationSamples.count);
  let stride=ux_u32(view+AnimationSamples.stride);
  if(n<1 || n>65536 || stride<1 || stride>64) { return 0-1; }
  let times=ux_u32(view+AnimationSamples.times);
  let values=ux_u32(view+AnimationSamples.values);
  if(!animation_span(times,n*4) || !animation_span(values,n*stride*4) ||
     animation_overlap(track,KeyframeTrack.size,times,n*4) ||
     animation_overlap(track,KeyframeTrack.size,values,n*stride*4)) { return 0-1; }
  let a=ux_u32_put(track+KeyframeTrack.name,name);
  let b=ux_u32_put(track+KeyframeTrack.nameBytes,bytes);
  let c=ux_u32_put(track+KeyframeTrack.samples,view);
  let d=ux_u32_put(track+KeyframeTrack.interpolation,2301);
  return track;
}

native function KeyframeTrack_setInterpolation(track:i64,mode:i64) i64 {
  if(!keyframe_track_at(track)) { return 0-1; }
  if(mode>=2300 && mode<=2302) { let saved=ux_u32_put(track+KeyframeTrack.interpolation,mode); }
  return track;
}

native function KeyframeTrack_getInterpolation(track:i64) i64 {
  if(!keyframe_track_at(track)) { return 0-1; }
  return ux_u32(track+KeyframeTrack.interpolation);
}

native function KeyframeTrack_getValueSize(track:i64) i64 {
  if(!keyframe_track_at(track)) { return 0-1; }
  let view=ux_u32(track+KeyframeTrack.samples);
  if(!animation_span(view,AnimationSamples.size)) { return 0-1; }
  return ux_u32(view+AnimationSamples.stride);
}
