native function gpu_blend_preset(state:i64,mode:i64,premultiplied:i64) i64 {
  let enabled=ux_u32_put(state+GpuRenderState.blend,5*(mode!=0));
  if(mode==0 || mode==5) { return enabled; }
  let rgb=ux_u32_put(state+GpuRenderState.equationRgb,100);
  let alpha=ux_u32_put(state+GpuRenderState.equationAlpha,100);
  let src=200;
  let dst=205;
  let sa=200;
  let da=205;
  if(mode==1 || mode==2) {
    src=204-3*premultiplied;
    sa=201;
  }
  if(mode==2) {
    dst=201;
    da=201;
    sa=src;
  }
  if(mode==3) {
    dst=203;
    da=201;
  }
  if(mode==4) {
    dst=202;
    da=204;
  }
  let a=ux_u32_put(state+GpuRenderState.sourceRgb,src);
  let b=ux_u32_put(state+GpuRenderState.destinationRgb,dst);
  let c=ux_u32_put(state+GpuRenderState.sourceAlpha,sa);
  return ux_u32_put(state+GpuRenderState.destinationAlpha,da);
}
