struct RayPointsHit {
  x: f64;
  y: f64;
  z: f64;
  distance: f64;
  distanceToRay: f64;
  index: u32;
}

native function Raycaster_intersectPointsBuffer(state:i64,query:i64,out:i64,capacity:i64,work:i64,space:i64) i64 {
  if(!raycaster_span(state,RaycasterState.size) || !raycaster_span(query,RayPointsBuffer.size) ||
     !raycaster_span(work,space) || capacity<0) { return 0-1; }
  if(u32_and(ux_u32(state+RaycasterState.layerMask),ux_u32(query+RayPointsBuffer.layerMask))==0) { return 0; }
  let stop=ray_vertex_range_end(query);
  if(stop<0) { return stop; }
  let start=ux_u32(query+RayPointsBuffer.drawStart);
  if(stop<=start) { return 0; }
  let result_bytes=(stop-start)*RayPointsHit.size;
  if(capacity<stop-start || space<96+result_bytes || !raycaster_span(out,result_bytes) ||
     raycaster_overlap(out,result_bytes,work,space) ||
     !ray_vertex_writable(out,result_bytes,state,query) || !ray_vertex_writable(work,space,state,query)) { return 0-1; }
  let positions=ux_u32(query+RayPointsBuffer.positions);
  let stride=ux_u32(query+RayPointsBuffer.stride);
  let indices=ux_u32(query+RayPointsBuffer.indices);
  let width=ux_u32(query+RayPointsBuffer.indexBytes);
  let world=ux_u32(query+RayPointsBuffer.world);
  let scale=ux_u32(query+RayPointsBuffer.scale);
  let near=ux_f64(state+RaycasterState.near);
  let far=ux_f64(state+RaycasterState.far);
  let threshold=ux_f64(state+RaycasterState.pointThreshold);
  let average=(ux_f64(scale)+ux_f64(scale+8)+ux_f64(scale+16))/3.0;
  if(near<0.0 || near-near!=0.0 || far!=far || far<near || threshold<0.0 ||
     threshold-threshold!=0.0 || average==0.0 || average-average!=0.0) { return 0-1; }
  if(!ray_vertex_indices_valid(query,start,stop)) { return 0-2; }
  let local=ray_local_affine(work,state,world);
  if(local<0) { return 0-1; }
  let pos=work+48;
  let closest=work+72;
  let local_threshold=threshold/average;
  let squared=local_threshold*local_threshold;
  let count_hit=0;
  let i=start;
  while(i<stop) {
    let index=ray_vertex_index(indices,width,i);
    let at=positions+index*stride;
    let point=Vector3_set(pos,ux_f32(at),ux_f32(at+4),ux_f32(at+8));
    let distance_sq=Ray_distanceSqToPoint(local,point);
    if(distance_sq<squared) {
      let nearest=Ray_closestPointToPoint(closest,local,point);
      let hit=Vector3_applyMatrix4(nearest,world);
      let distance=Vector3_distanceTo(hit,state);
      if(distance>=near && distance<=far) {
        let row=out+count_hit*RayPointsHit.size;
        let saved=uxe_copy_record(row,hit,24);
        let a=ux_f64_put(row+RayPointsHit.distance,distance);
        let b=ux_f64_put(row+RayPointsHit.distanceToRay,f64_sqrt(distance_sq));
        let c=ux_u32_put(row+RayPointsHit.index,index);
        count_hit=count_hit+1;
      }
    }
    i=i+1;
  }
  return ray_sort_hits(out,work+96,count_hit,RayPointsHit.size,RayPointsHit.distance);
}
