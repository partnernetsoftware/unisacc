native function BatchedMesh_copy(dst:i64,src:i64) i64 {
  if(!batch_valid(dst) || !batch_valid(src) ||
     (dst<src+BatchedMesh.size && src<dst+BatchedMesh.size)) { return 0-1; }
  let count=ux_u32(src+BatchedMesh.count);
  let from=ux_u32(src+BatchedMesh.rows);
  let to=ux_u32(dst+BatchedMesh.rows);
  let used=count*BatchGeometry.size;
  let vertices=ux_u32(src+BatchedMesh.vertexUsed);
  let indices=ux_u32(src+BatchedMesh.indexUsed);
  if(count>ux_u32(src+BatchedMesh.capacity) || from%4!=0 || to%4!=0 ||
     from>6291456-used || to>6291456-used) { return 0-1; }
  if(count>ux_u32(dst+BatchedMesh.capacity) || vertices>ux_u32(dst+BatchedMesh.vertexLimit) ||
     indices>ux_u32(dst+BatchedMesh.indexLimit)) { return 0-2; }
  if(used>0 && ((to<from+used && from<to+used) ||
     (to<src+BatchedMesh.size && src<to+used) ||
     (dst<from+used && from<dst+BatchedMesh.size))) { return 0-1; }
  let rows=uxe_copy_record(to,from,used);
  let v=ux_u32_put(dst+BatchedMesh.vertexUsed,vertices);
  let ix=ux_u32_put(dst+BatchedMesh.indexUsed,indices);
  let mode=ux_u32_put(dst+BatchedMesh.indexed,ux_u32(src+BatchedMesh.indexed));
  let active=ux_u32_put(dst+BatchedMesh.count,count);
  return dst;
}

native function BatchedMesh_clone(dst:i64,src:i64) i64 {
  if(!batch_valid(dst) || ux_u32(dst+BatchedMesh.count)!=0) { return 0-1; }
  return BatchedMesh_copy(dst,src);
}
