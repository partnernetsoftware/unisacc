function Group_create(group_arena) {
  let group_handle=Object3D_create(group_arena);
  if(group_handle>0) {
    let group_at=Object3D_address(group_arena,group_handle);
    let group_mark=ux_u32_put(group_at+Scene.size,2);
  }
  return group_handle;
}

function Group_isGroup(group_test,...group_test_args) {
  let group_test_at=Object3D_address(group_test,group_test_args[0]);
  let group_matches=0;
  if(group_test_at>=0) { group_matches=ux_u32(group_test_at+Scene.size)==2; }
  return group_matches;
}

function Group_add(group_add,...group_add_args) {
  return Object3D_add(group_add,group_add_args[0],group_add_args[1]);
}

function Group_remove(group_remove,...group_remove_args) {
  return Object3D_remove(group_remove,group_remove_args[0],group_remove_args[1]);
}

function Group_traverse(group_walk,...group_walk_args) {
  return Object3D_traverse(group_walk,group_walk_args[0],group_walk_args[1],group_walk_args[2]);
}
