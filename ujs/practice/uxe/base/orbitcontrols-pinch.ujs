// The caller supplies successive distances from the same two contact IDs.
// A degenerate sample returns zero so callers can rebase the gesture.
native function OrbitControls_pinch(control:i64,previous:f64,current:f64) i64 {
  if(!orbit_valid(control) || previous<0.0 || current<0.0 ||
     previous-previous!=0.0 || current-current!=0.0) { return 0-1; }
  if(previous==0.0 || current==0.0 || previous==current) { return 0; }
  let factor=ux_math_pow(current/previous,ux_f64(control+OrbitControls.zoomSpeed));
  let scale=ux_f64(control+OrbitControls.zoomScale)/factor;
  if(scale<=0.0 || scale-scale!=0.0) { return 0-1; }
  let saved=ux_f64_put(control+OrbitControls.zoomScale,scale);
  return 1;
}
