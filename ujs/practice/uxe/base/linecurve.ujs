native function LineCurve_getPoint(dst:i64,ends:i64,t:f64) i64 {
  return curve_line_point(dst,ends,2,t);
}
native function LineCurve_getPointAt(dst:i64,ends:i64,t:f64) i64 {
  return LineCurve_getPoint(dst,ends,t);
}
native function LineCurve_getLength(ends:i64) f64 {
  return curve_line_length(ends,2);
}
native function LineCurve_getTangent(dst:i64,ends:i64) i64 {
  return curve_line_tangent(dst,ends,2);
}
