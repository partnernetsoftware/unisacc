native function gpu_srgb_channel(byte:i64) i64 {
  return f64_floor_i64(Color_srgbToLinear(byte/255.0)*255.0+0.5);
}

native function gpu_legacy_srgb_pixel(address:i64,width:i64,height:i64,u:f64,v:f64) i64 {
  let texel=gpu_texture_texel(address,width,height,u,v,4);
  if(texel<0) { return texel; }
  let red=gpu_srgb_channel(ux_u8(texel));
  let green=gpu_srgb_channel(ux_u8(texel+1));
  let blue=gpu_srgb_channel(ux_u8(texel+2));
  return red+256*green+65536*blue+16777216*ux_u8(texel+3);
}
