// Line.copy retains the source geometry. The grid record has no mutable
// geometry state of its own, so the destination owns only a new record.
native function grid_helper_copy_record(dst:i64,src:i64) i64 {
  if(!helper_buffer_span(src,GridHelper.size,4) ||
     !helper_buffer_span(dst,GridHelper.size,4) ||
     ux_u32(src+GridHelper.active)!=1) { return 0-1; }
  if(dst==src) { return dst; }
  let positions=ux_u32(src+GridHelper.positions);
  let colors=ux_u32(src+GridHelper.colors);
  let count=ux_u32(src+GridHelper.count);
  let bytes=count*12;
  if(!helper_buffer_span(positions,bytes,4) || !helper_buffer_span(colors,bytes,4) ||
     !helper_buffer_disjoint(dst,GridHelper.size,src,GridHelper.size) ||
     !helper_buffer_disjoint(dst,GridHelper.size,positions,bytes) ||
     !helper_buffer_disjoint(dst,GridHelper.size,colors,bytes)) { return 0-1; }
  let p=ux_u32_put(dst+GridHelper.positions,positions);
  let c=ux_u32_put(dst+GridHelper.colors,colors);
  let n=ux_u32_put(dst+GridHelper.count,count);
  let a=ux_u32_put(dst+GridHelper.active,1);
  return dst;
}

native function GridHelper_copy(dst:i64,src:i64) i64 {
  return grid_helper_copy_record(dst,src);
}

native function GridHelper_clone(dst:i64,src:i64) i64 {
  if(dst==src) { return 0-1; }
  return GridHelper_copy(dst,src);
}

native function PolarGridHelper_copy(dst:i64,src:i64) i64 {
  if(PolarGridHelper.size!=GridHelper.size || PolarGridHelper.positions!=GridHelper.positions ||
     PolarGridHelper.colors!=GridHelper.colors || PolarGridHelper.count!=GridHelper.count ||
     PolarGridHelper.active!=GridHelper.active) { return 0-1; }
  return grid_helper_copy_record(dst,src);
}

native function PolarGridHelper_clone(dst:i64,src:i64) i64 {
  if(dst==src) { return 0-1; }
  return PolarGridHelper_copy(dst,src);
}
