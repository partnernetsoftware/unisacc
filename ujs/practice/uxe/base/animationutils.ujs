native function AnimationUtils_getOrder(times:i64,count:i64,out:i64) i64 {
  if(count<0 || count>4096 || !animation_span(times,count*4) || !animation_span(out,count*4) ||
     animation_overlap(times,count*4,out,count*4)) { return 0-1; }
  let i=0;
  while(i<count) {
    let t=ux_f32(times+i*4);
    if(t-t!=0.0) { return 0-2; }
    i=i+1;
  }
  i=0;
  while(i<count) {
    let t=ux_f32(times+i*4);
    let j=i;
    let moving=1;
    while(j>0 && moving!=0) {
      let earlier=ux_u32(out+(j-1)*4);
      if(ux_f32(times+earlier*4)>t) {
        let moved=ux_u32_put(out+j*4,earlier);
        j=j-1;
      } else { moving=0; }
    }
    let saved=ux_u32_put(out+j*4,i);
    i=i+1;
  }
  return out;
}

native function AnimationUtils_sortedArray(values:i64,count:i64,stride:i64,order:i64,out:i64) i64 {
  if(count<0 || count>65536 || stride<1 || stride>64) { return 0-1; }
  let bytes=count*stride*4;
  if(!animation_span(values,bytes) || !animation_span(order,count*4) || !animation_span(out,bytes) ||
     animation_overlap(values,bytes,out,bytes) || animation_overlap(order,count*4,out,bytes)) { return 0-1; }
  let i=0;
  while(i<count) {
    if(ux_u32(order+i*4)>=count) { return 0-2; }
    i=i+1;
  }
  i=0;
  while(i<count) {
    let row=ux_u32(order+i*4);
    let j=0;
    while(j<stride) {
      let saved=ux_u32_put(out+(i*stride+j)*4,ux_u32(values+(row*stride+j)*4));
      j=j+1;
    }
    i=i+1;
  }
  return out;
}
