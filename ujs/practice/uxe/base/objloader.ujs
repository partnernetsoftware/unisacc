// Single-mesh OBJ parser. Corners carry packed f32 position, normal and UV values.
// A group row has u32 start, count, source name offset, and source name length.
// Header words hold group count and whether any corner has an explicit UV.
// Scratch is three banks of slots f64 triples, one bank per source attribute.
// A failed parse changes only scratch. Names borrow the input bytes.
native function obj_white(byte:i64) i64 {
  return byte==32 || byte==9 || byte==13;
}

native function obj_skip(p:i64,end:i64) i64 {
  while(p<end && obj_white(ux_u8(p))) { p=p+1; }
  return p;
}

native function obj_token(p:i64,end:i64) i64 {
  while(p<end && !obj_white(ux_u8(p))) { p=p+1; }
  return p;
}

native function obj_digit(byte:i64) i64 {
  return byte>=48 && byte<=57;
}

native function obj_number(p:i64,end:i64) f64 {
  let sign=1.0;
  if(p<end && (ux_u8(p)==43 || ux_u8(p)==45)) {
    if(ux_u8(p)==45) { sign=0.0-1.0; }
    p=p+1;
  }
  let value=0.0;
  let digits=0;
  let used=0;
  let scale=0;
  let decimal=0;
  while(p<end && (obj_digit(ux_u8(p)) || (!decimal && ux_u8(p)==46))) {
    let byte=ux_u8(p);
    if(byte==46) { decimal=1; }
    else {
      digits=digits+1;
      if(used<17 && (used>0 || byte!=48)) {
        value=value*10.0+(byte-48);
        used=used+1;
        if(decimal) { scale=scale-1; }
      } else if(decimal && used==0) { scale=scale-1; }
      else if(!decimal && used==17) { scale=scale+1; }
    }
    p=p+1;
  }
  if(digits==0) { return 0.0/0.0; }
  if(p<end && (ux_u8(p)==69 || ux_u8(p)==101)) {
    p=p+1;
    let expSign=1;
    if(p<end && (ux_u8(p)==43 || ux_u8(p)==45)) {
      if(ux_u8(p)==45) { expSign=0-1; }
      p=p+1;
    }
    let expStart=p;
    let exponent=0;
    while(p<end && obj_digit(ux_u8(p))) {
      if(exponent<10000000) { exponent=exponent*10+ux_u8(p)-48; }
      p=p+1;
    }
    if(p==expStart) { return 0.0/0.0; }
    scale=scale+expSign*exponent;
  }
  if(p!=end || (value!=0.0 && scale>308)) { return 0.0/0.0; }
  if(value==0.0 || scale<0-400) { return sign*0.0; }
  while(scale<0-300) { value=value*0.00000000000000000001; scale=scale+20; }
  let factor=10.0;
  if(scale<0) { factor=0.1; scale=0-scale; }
  while(scale>0) {
    if(scale%2==1) { value=value*factor; }
    scale=scale/2;
    if(scale>0) { factor=factor*factor; }
  }
  return sign*value;
}

native function obj_source(p:i64,end:i64,row:i64,width:i64) i64 {
  let i=0;
  while(i<width) {
    p=obj_skip(p,end);
    let next=obj_token(p,end);
    let value=obj_number(p,next);
    if(value!=value || value>(3.4028234663852886*1000000000.0*1000000000.0*1000000000.0*1000000000.0*100.0) || value<0.0-(3.4028234663852886*1000000000.0*1000000000.0*1000000000.0*1000000000.0*100.0)) { return 0; }
    let stored=ux_f64_put(row+8*i,value);
    i=i+1;
    p=next;
  }
  return obj_skip(p,end)==end;
}

native function obj_index(p:i64,end:i64,count:i64) i64 {
  let negative=0;
  if(p<end && (ux_u8(p)==43 || ux_u8(p)==45)) {
    negative=ux_u8(p)==45;
    p=p+1;
  }
  let value=0;
  while(p<end && obj_digit(ux_u8(p))) {
    value=value*10+ux_u8(p)-48;
    if(value>count) { return 0; }
    p=p+1;
  }
  if(value==0 || p!=end) { return 0; }
  if(negative) { return count+1-value; }
  return value;
}

native function obj_corner(p:i64,end:i64,nv:i64,nt:i64,nn:i64) i64 {
  let slash=p;
  while(slash<end && ux_u8(slash)!=47) { slash=slash+1; }
  let vertex=obj_index(p,slash,nv);
  if(vertex==0 || slash==end) { return vertex; }
  let start=slash+1;
  slash=start;
  while(slash<end && ux_u8(slash)!=47) { slash=slash+1; }
  let uv=0;
  if(start<slash) {
    uv=obj_index(start,slash,nt);
    if(uv==0) { return 0; }
  }
  if(slash==end) {
    if(uv==0) { return 0; }
    return vertex+131072*uv;
  }
  let normal=obj_index(slash+1,end,nn);
  if(normal==0) { return 0; }
  return vertex+131072*uv+17179869184*normal;
}

native function obj_position(vertices:i64,corner:i64) i64 {
  return vertices+24*(corner%131072-1);
}

native function obj_shape(corner:i64) i64 {
  return (corner/131072%131072!=0)+2*(corner/17179869184!=0);
}

native function obj_emit(out:i64,vertices:i64,uvs:i64,normals:i64,a:i64,b:i64,c:i64) i64 {
  let ap=obj_position(vertices,a);
  let bp=obj_position(vertices,b);
  let cp=obj_position(vertices,c);
  let ux=ux_f64(cp)-ux_f64(bp);
  let uy=ux_f64(cp+8)-ux_f64(bp+8);
  let uz=ux_f64(cp+16)-ux_f64(bp+16);
  let vx=ux_f64(ap)-ux_f64(bp);
  let vy=ux_f64(ap+8)-ux_f64(bp+8);
  let vz=ux_f64(ap+16)-ux_f64(bp+16);
  let nx=uy*vz-uz*vy;
  let ny=uz*vx-ux*vz;
  let nz=ux*vy-uy*vx;
  let size=f64_sqrt(nx*nx+ny*ny+nz*nz);
  if(size!=0.0) { nx=nx/size; ny=ny/size; nz=nz/size; }
  let i=0;
  while(i<3) {
    let corner=a;
    if(i==1) { corner=b; }
    else if(i==2) { corner=c; }
    let p=obj_position(vertices,corner);
    let row=out+32*i;
    let x=ux_f32_put(row,ux_f64(p));
    let y=ux_f32_put(row+4,ux_f64(p+8));
    let z=ux_f32_put(row+8,ux_f64(p+16));
    let n=corner/17179869184;
    if(n>0) {
      let normal=normals+24*(n-1);
      nx=ux_f64(normal);
      ny=ux_f64(normal+8);
      nz=ux_f64(normal+16);
    }
    let xn=ux_f32_put(row+12,nx);
    let yn=ux_f32_put(row+16,ny);
    let zn=ux_f32_put(row+20,nz);
    let u=0.0;
    let v=0.0;
    let t=corner/131072%131072;
    if(t>0) {
      let uv=uvs+24*(t-1);
      u=ux_f64(uv);
      v=ux_f64(uv+8);
    }
    let ut=ux_f32_put(row+24,u);
    let vt=ux_f32_put(row+28,v);
    i=i+1;
  }
  return 1;
}

native function obj_group(row:i64,first:i64,stop:i64,name:i64,length:i64) i64 {
  let a=ux_u32_put(row,first);
  let b=ux_u32_put(row+4,stop-first);
  let c=ux_u32_put(row+8,name);
  let d=ux_u32_put(row+12,length);
  return 1;
}

native function obj_parse_pass(input:i64,end:i64,out:i64,capacity:i64,groups:i64,groupMode:i64,
                              scratch:i64,slots:i64) i64 {
  let groupCap=groupMode/2;
  let emit=groupMode%2;
  let vertices=scratch;
  let uvs=vertices+24*slots;
  let normals=uvs+24*slots;
  let nv=0;
  let nt=0;
  let nn=0;
  let corners=0;
  let hasUv=0;
  let count=0;
  let first=0;
  let name=input;
  let nameLength=0;
  let p=input;
  while(p<end) {
    let line=p;
    while(p<end && ux_u8(p)!=10) { p=p+1; }
    let limit=p;
    p=p+1;
    while(limit>line && obj_white(ux_u8(limit-1))) { limit=limit-1; }
    line=obj_skip(line,limit);
    if(line<limit && ux_u8(line)!=35) {
      let tag=obj_token(line,limit);
      let tagLength=tag-line;
      let body=obj_skip(tag,limit);
      let command=ux_u8(line);
      if(command==118 && tagLength==1) {
        if(nv==slots) { return 0-3; }
        if(!obj_source(body,limit,vertices+24*nv,3)) { return 0-1; }
        nv=nv+1;
      } else if(command==118 && tagLength==2 && ux_u8(line+1)==116) {
        if(nt==slots) { return 0-3; }
        if(!obj_source(body,limit,uvs+24*nt,2)) { return 0-1; }
        nt=nt+1;
      } else if(command==118 && tagLength==2 && ux_u8(line+1)==110) {
        if(nn==slots) { return 0-3; }
        if(!obj_source(body,limit,normals+24*nn,3)) { return 0-1; }
        nn=nn+1;
      } else if(command==102 && tagLength==1) {
        let next=obj_token(body,limit);
        let a=obj_corner(body,next,nv,nt,nn);
        body=obj_skip(next,limit);
        next=obj_token(body,limit);
        let b=obj_corner(body,next,nv,nt,nn);
        body=obj_skip(next,limit);
        let shape=obj_shape(a);
        if(a==0 || b==0 || obj_shape(b)!=shape || body==limit) { return 0-1; }
        while(body<limit) {
          next=obj_token(body,limit);
          let c=obj_corner(body,next,nv,nt,nn);
          if(c==0 || obj_shape(c)!=shape) { return 0-1; }
          if(corners>capacity-3) { return 0-3; }
          if(emit) { let ok=obj_emit(out+32*corners,vertices,uvs,normals,a,b,c); }
          corners=corners+3;
          b=c;
          body=obj_skip(next,limit);
        }
        if(shape%2!=0) { hasUv=1; }
      } else if(tagLength==6 && command==117 && ux_u8(line+1)==115 && ux_u8(line+2)==101 &&
                ux_u8(line+3)==109 && ux_u8(line+4)==116 && ux_u8(line+5)==108) {
        if(body==limit) { return 0-1; }
        if(corners!=first) {
          if(count==groupCap) { return 0-3; }
          if(emit) { let ok=obj_group(groups+8+16*count,first,corners,name-input,nameLength); }
          count=count+1;
        }
        first=corners;
        name=body;
        nameLength=limit-body;
      } else { return 0-2; }
    }
  }
  if(corners!=first) {
    if(count==groupCap) { return 0-3; }
    if(emit) { let ok=obj_group(groups+8+16*count,first,corners,name-input,nameLength); }
    count=count+1;
  }
  if(nv>0 && corners==0) { return 0-2; } // The addon builds Points in this case.
  if(emit) {
    let a=ux_u32_put(groups,count);
    let b=ux_u32_put(groups+4,hasUv);
  }
  return corners;
}

native function obj_span(at:i64,length:i64) i64 {
  return at>=0 && length>=0 && at<=6291456-length;
}

native function obj_disjoint(a:i64,an:i64,b:i64,bn:i64) i64 {
  return a+an<=b || b+bn<=a;
}

// Returns expanded corner count, or -1 malformed, -2 unsupported, -3 capacity.
native function OBJLoader_parse(input:i64,bytes:i64,out:i64,capacity:i64,groups:i64,groupCap:i64,
                                scratch:i64,slots:i64) i64 {
  if(capacity<0 || capacity>196608 || groupCap<0 || groupCap>393215 || slots<1 || slots>87381) { return 0-3; }
  let rows=32*capacity;
  let runs=8+16*groupCap;
  let work=72*slots;
  if(!obj_span(input,bytes) || !obj_span(out,rows) || !obj_span(groups,runs) || !obj_span(scratch,work) ||
     !obj_disjoint(input,bytes,out,rows) || !obj_disjoint(input,bytes,groups,runs) ||
     !obj_disjoint(input,bytes,scratch,work) || !obj_disjoint(out,rows,groups,runs) ||
     !obj_disjoint(out,rows,scratch,work) || !obj_disjoint(groups,runs,scratch,work)) { return 0-1; }
  let checked=obj_parse_pass(input,input+bytes,out,capacity,groups,2*groupCap,scratch,slots);
  if(checked<0) { return checked; }
  return obj_parse_pass(input,input+bytes,out,capacity,groups,2*groupCap+1,scratch,slots);
}
