struct AudioContextBinding {
  registered: u32;
  handle: u32;
}

native function audio_context_bindable(at:i64) i64 {
  return at>=0 && at%4==0 && at<=6291456-AudioContextBinding.size &&
    ux_u32(at+AudioContextBinding.registered)<=1;
}

native function AudioContext_getContext(at:i64) i64 {
  if(!audio_context_bindable(at)) { return 0-1; }
  if(ux_u32(at+AudioContextBinding.registered)==1) {
    return ux_u32(at+AudioContextBinding.handle);
  }
  let handle=host_context_identity(0,0);
  if(handle<=0 || handle>4294967295) { return 0-2; }
  let persisted=ux_u32_put(at+AudioContextBinding.handle,handle);
  let state=ux_u32_put(at+AudioContextBinding.registered,1);
  return handle;
}

// -1 is an explicit undefined value. Zero represents a registered null.
native function AudioContext_setContext(at:i64,handle:i64) i64 {
  if(!audio_context_bindable(at) || handle<0-1 || handle>4294967295) { return 0-1; }
  if(handle>0 && host_context_identity(1,handle)!=1) { return 0-2; }
  let normalized=handle;
  let registered=1;
  if(handle<0) {
    normalized=0;
    registered=0;
  }
  let first=ux_u32_put(at+AudioContextBinding.handle,normalized);
  let state=ux_u32_put(at+AudioContextBinding.registered,registered);
  return at;
}
