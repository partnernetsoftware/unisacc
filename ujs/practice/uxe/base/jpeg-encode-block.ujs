struct JpegWriteBits {
  next: u32;
  end: u32;
  byte: u32;
  used: u32;
}

native function jpeg_encode_order(out:i64) i64 {
  let order=[0,1,8,16,9,2,3,10,17,24,32,25,18,11,4,5,12,19,26,33,40,48,41,34,27,20,13,6,7,14,21,28,
    35,42,49,56,57,50,43,36,29,22,15,23,30,37,44,51,58,59,52,45,38,31,39,46,53,60,61,54,47,55,62,63];
  let i=0;
  while(i<64) { let saved=ux_u8_put(out+i,order[i]); i=i+1; }
  return out;
}

// Scratch coefficient order follows the byte order of the quantization table.
native function jpeg_fdct_quantize(block:i64,basis:i64,quant:i64,work:i64,coeff:i64,order:i64) i64 {
  let y=0;
  while(y<8) {
    let f=0;
    while(f<8) {
      let sum=0.0;
      let x=0;
      while(x<8) {
        sum=sum+ux_f64(basis+8*(x*8+f))*(0.0+ux_u8(block+y*8+x)-128.0);
        x=x+1;
      }
      let stored=ux_f64_put(work+8*(y*8+f),sum);
      f=f+1;
    }
    y=y+1;
  }
  let k=0;
  while(k<64) {
    let scale=ux_u8(quant+k);
    if(scale==0) { return 0-4; }
    let f=ux_u8(order+k);
    let sum=0.0;
    let y=0;
    while(y<8) {
      sum=sum+ux_f64(basis+8*(y*8+f/8))*ux_f64(work+8*(y*8+f%8));
      y=y+1;
    }
    let value=sum/scale;
    let rounded=f64_floor_i64(value+0.5);
    if(value<0.0) { rounded=0-f64_floor_i64(0.5-value); }
    let stored=ux_i32_put(coeff+4*k,rounded);
    k=k+1;
  }
  return coeff;
}

// Writes into private staging storage. Escape FF before emitting further bits.
native function jpeg_put_bits(writer:i64,value:i64,width:i64) i64 {
  if(width<0 || width>16 || value<0 || value>=u32_shl(1,width)) { return 0-4; }
  let fill=ux_u32(writer+JpegWriteBits.used);
  let byte=ux_u32(writer+JpegWriteBits.byte);
  let cursor=ux_u32(writer+JpegWriteBits.next);
  let limit=ux_u32(writer+JpegWriteBits.end);
  while(width>0) {
    width=width-1;
    byte=byte*2+u32_shr(value,width)%2;
    fill=fill+1;
    if(fill==8) {
      if(cursor>=limit || (byte==255 && cursor>=limit-1)) { return 0-1; }
      let stored=ux_u8_put(cursor,byte);
      cursor=cursor+1;
      if(byte==255) { let zero=ux_u8_put(cursor,0); cursor=cursor+1; }
      byte=0;
      fill=0;
    }
  }
  let position=ux_u32_put(writer+JpegWriteBits.next,cursor);
  let pending=ux_u32_put(writer+JpegWriteBits.byte,byte);
  let count=ux_u32_put(writer+JpegWriteBits.used,fill);
  return cursor;
}

native function jpeg_category(value:i64) i64 {
  if(value<0) { value=0-value; }
  let width=0;
  while(value>0) { value=value/2; width=width+1; }
  return width;
}

native function jpeg_write_amplitude(writer:i64,value:i64,width:i64) i64 {
  if(value<0) { value=value+u32_shl(1,width)-1; }
  return jpeg_put_bits(writer,value,width);
}

// Canonical tables use four-bit DC codes 0..11 and eight-bit AC codes.
native function jpeg_encode_block(writer:i64,coeff:i64,previous:i64) i64 {
  let dc=ux_i32(coeff);
  let delta=dc-previous;
  let width=jpeg_category(delta);
  if(width>11) { return 0-4; }
  let code=jpeg_put_bits(writer,width,4);
  if(code<0) { return code; }
  let amplitude=jpeg_write_amplitude(writer,delta,width);
  if(amplitude<0) { return amplitude; }
  let run=0;
  let k=1;
  while(k<64) {
    let value=ux_i32(coeff+4*k);
    if(value==0) { run=run+1; }
    else {
      while(run>=16) {
        let zrl=jpeg_put_bits(writer,1,8);
        if(zrl<0) { return zrl; }
        run=run-16;
      }
      let size=jpeg_category(value);
      if(size>10) { return 0-4; }
      let ac=jpeg_put_bits(writer,2+10*run+size-1,8);
      if(ac<0) { return ac; }
      let remainder=jpeg_write_amplitude(writer,value,size);
      if(remainder<0) { return remainder; }
      run=0;
    }
    k=k+1;
  }
  if(run>0) {
    let eob=jpeg_put_bits(writer,0,8);
    if(eob<0) { return eob; }
  }
  return dc+65536;
}
