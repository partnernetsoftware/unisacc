native function QuatTrack_setInterpolation(track:i64,mode:i64) i64 {
  if(!keyframe_track_at(track)) { return 0-1; }
  if(mode==2300 || mode==2301) { return KeyframeTrack_setInterpolation(track,mode); }
  return track;
}

native function QuatTrack_evaluate(track:i64,t:f64,out:i64,scratch:i64) i64 {
  if(KeyframeTrack_getValueSize(track)!=4 || !animation_span(out,16)) { return 0-1; }
  let name=ux_u32(track+KeyframeTrack.name);
  let bytes=ux_u32(track+KeyframeTrack.nameBytes);
  if(animation_overlap(out,16,track,KeyframeTrack.size) || animation_overlap(out,16,name,bytes)) { return 0-1; }
  let view=ux_u32(track+KeyframeTrack.samples);
  let mode=KeyframeTrack_getInterpolation(track);
  if(mode==2300) { return DiscreteInterpolant_evaluate(view,t,out); }
  if(mode!=2301 || animation_overlap(scratch,96,track,KeyframeTrack.size) ||
     animation_overlap(scratch,96,name,bytes)) { return 0-1; }
  return QuatLinearInterpolant_evaluate(view,t,out,scratch);
}
