native function frame_put(point:i64,x:f64,y:f64,z:f64) i64 {
  let px=ux_f64_put(point,x);
  let py=ux_f64_put(point+8,y);
  let pz=ux_f64_put(point+16,z);
  return point;
}

native function frame_combine(dst:i64,a:i64,b:i64,sign:f64) i64 {
  return frame_put(dst,ux_f64(a)+sign*ux_f64(b),ux_f64(a+8)+sign*ux_f64(b+8),
    ux_f64(a+16)+sign*ux_f64(b+16));
}

native function frame_cross(dst:i64,a:i64,b:i64) i64 {
  let x=ux_f64(a+8)*ux_f64(b+16)-ux_f64(a+16)*ux_f64(b+8);
  let y=ux_f64(a+16)*ux_f64(b)-ux_f64(a)*ux_f64(b+16);
  let z=ux_f64(a)*ux_f64(b+8)-ux_f64(a+8)*ux_f64(b);
  return frame_put(dst,x,y,z);
}

native function frame_normalize(point:i64) i64 {
  let x=ux_f64(point);
  let y=ux_f64(point+8);
  let z=ux_f64(point+16);
  let norm=f64_sqrt(x*x+y*y+z*z);
  if(norm==0.0) { return point; }
  return frame_put(point,x/norm,y/norm,z/norm);
}
