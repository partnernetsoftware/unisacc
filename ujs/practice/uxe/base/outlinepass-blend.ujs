// Composites a straight-alpha OutlinePass overlay into its read buffer.
// The pass does not swap buffers. The ranges must be disjoint.
native function OutlinePass_blendRGBA8(src:i64,dst:i64,pixels:i64) i64 {
  if(pixels<1 || pixels>1572864) { return 0-1; }
  let bytes=pixels*4;
  if(!post_span(src,bytes) || !post_span(dst,bytes) ||
     post_overlap(src,bytes,dst,bytes)) { return 0-1; }
  let at=0;
  while(at<bytes) {
    let alpha=ux_u8(src+at+3);
    let c=0;
    while(c<4) {
      let value=ux_u8(dst+at+c)+ux_u8(src+at+c)*alpha/255.0;
      let write=ux_u8_put(dst+at+c,post_rgba8(value));
      c=c+1;
    }
    at=at+4;
  }
  return pixels;
}

