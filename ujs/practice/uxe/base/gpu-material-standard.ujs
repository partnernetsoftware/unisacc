native function GpuMaterial_ggxSpecular(f0:f64,dotNL:f64,dotNV:f64,dotNH:f64,dotVH:f64,roughness:f64,light:f64) f64 {
  if(dotNL<=0.0 || dotNV<=0.0 || light<=0.0) { return 0.0; }
  let rough=roughness;
  if(rough<0.0525) { rough=0.0525; }
  if(rough>1.0) { rough=1.0; }
  let alpha=rough*rough;
  let alpha2=alpha*alpha;
  let denom=dotNH*dotNH*(alpha2-1.0)+1.0;
  let distribution=0.3183098861837907*alpha2/(denom*denom);
  let projectedView=dotNL*f64_sqrt(alpha2+(1.0-alpha2)*dotNV*dotNV);
  let projectedLight=dotNV*f64_sqrt(alpha2+(1.0-alpha2)*dotNL*dotNL);
  let visibility=0.5/(projectedView+projectedLight);
  let fresnel=f0+(1.0-f0)*ux_math_pow(2.0,(-5.55473*dotVH-6.98316)*dotVH);
  return light*dotNL*fresnel*visibility*distribution;
}
