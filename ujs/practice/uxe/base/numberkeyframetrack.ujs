native function NumberKeyframeTrack_evaluate(track:i64,t:f64,out:i64) i64 {
  if(KeyframeTrack_getValueSize(track)!=1 || !animation_span(out,4) ||
     animation_overlap(out,4,track,KeyframeTrack.size) ||
     animation_overlap(out,4,ux_u32(track+KeyframeTrack.name),ux_u32(track+KeyframeTrack.nameBytes))) { return 0-1; }
  let view=ux_u32(track+KeyframeTrack.samples);
  let mode=KeyframeTrack_getInterpolation(track);
  if(mode==2300) { return DiscreteInterpolant_evaluate(view,t,out); }
  if(mode==2301) { return LinearInterpolant_evaluate(view,t,out); }
  if(mode==2302) { return CubicInterpolant_evaluate(view,t,out,2400,2400); }
  return 0-1;
}
