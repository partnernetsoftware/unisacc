native function image_file_ready(file:i64,image:i64,rgba:i64,capacity:i64,scratch:i64,space:i64) i64 {
  if(!loading_span(file,FileLoader.size) || ux_u32(file+FileLoader.state)!=2 || !loading_span(image,ImageResource.size)) { return 0; }
  let src=ux_u32(file+FileLoader.bytes);
  let bytes=ux_u32(file+FileLoader.length);
  return file_disjoint(file,FileLoader.size,image,ImageResource.size) &&
     file_disjoint(file,FileLoader.size,rgba,capacity) && file_disjoint(file,FileLoader.size,scratch,space) &&
     file_disjoint(image,ImageResource.size,src,bytes) && file_disjoint(image,ImageResource.size,rgba,capacity) &&
     file_disjoint(image,ImageResource.size,scratch,space);
}

native function image_file_publish(image:i64,rgba:i64,width:i64,height:i64) i64 {
  let a=ux_u32_put(image+ImageResource.rgba,rgba);
  let b=ux_u32_put(image+ImageResource.width,width);
  let c=ux_u32_put(image+ImageResource.height,height);
  let d=ux_u32_put(image+ImageResource.rowBytes,width*4);
  return image;
}
