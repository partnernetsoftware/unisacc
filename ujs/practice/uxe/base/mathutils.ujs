function MathUtils_clamp(mu_value,...mu_bounds) {
  return vector_limit(mu_value,mu_bounds[0],mu_bounds[1]);
}

native function MathUtils_euclideanModulo(mu_n:f64,mu_m:f64) f64 {
  let mu_remainder=ux_math_abs(mu_n);
  let mu_modulus=ux_math_abs(mu_m);
  if(mu_modulus==0.0 || mu_modulus==1.0/0.0 || mu_remainder==1.0/0.0 ||
      mu_modulus!=mu_modulus || mu_remainder!=mu_remainder) { return 0.0/0.0; }
  let mu_divisor=mu_modulus;
  while(mu_divisor<=mu_remainder*0.5) { mu_divisor=mu_divisor*2.0; }
  while(mu_divisor>=mu_modulus) {
    if(mu_remainder>=mu_divisor) { mu_remainder=mu_remainder-mu_divisor; }
    mu_divisor=mu_divisor*0.5;
  }
  if(mu_n<0.0) { mu_remainder=0.0-mu_remainder; }
  let mu_shifted=mu_remainder+mu_m;
  if(mu_shifted==1.0/0.0 || mu_shifted==0.0-1.0/0.0) { return 0.0/0.0; }
  if(ux_math_abs(mu_shifted)>=mu_modulus) { mu_shifted=mu_shifted-mu_m; }
  if(ux_math_abs(mu_shifted)>=mu_modulus) { mu_shifted=mu_shifted-mu_m; }
  return mu_shifted;
}

function MathUtils_mapLinear(mu_map_x,...mu_map_args) {
  return mu_map_args[2]+(mu_map_x-mu_map_args[0])*(mu_map_args[3]-mu_map_args[2])/(mu_map_args[1]-mu_map_args[0]);
}

function MathUtils_inverseLerp(mu_inverse_a,...mu_inverse_args) {
  let mu_inverse_b=mu_inverse_args[0];
  let mu_inverse_result=0.0;
  if(mu_inverse_a!=mu_inverse_b) { mu_inverse_result=(mu_inverse_args[1]-mu_inverse_a)/(mu_inverse_b-mu_inverse_a); }
  return mu_inverse_result;
}

function MathUtils_lerp(mu_lerp_a,...mu_lerp_args) {
  return (1.0-mu_lerp_args[1])*mu_lerp_a+mu_lerp_args[1]*mu_lerp_args[0];
}

native function MathUtils_damp(mu_damp_a:f64,mu_damp_b:f64,mu_lambda:f64,mu_dt:f64) f64 {
  let mu_damping=ux_math_exp(0.0-mu_lambda*mu_dt);
  return MathUtils_lerp(mu_damp_a,mu_damp_b,1.0-mu_damping);
}

function MathUtils_pingpong(mu_ping,...mu_ping_args) {
  let mu_period=mu_ping_args[0];
  return mu_period-ux_math_abs(MathUtils_euclideanModulo(mu_ping,2.0*mu_period)-mu_period);
}

function MathUtils_smoothstep(mu_smooth,...mu_smooth_args) {
  let mu_t=vector_limit((mu_smooth-mu_smooth_args[0])/(mu_smooth_args[1]-mu_smooth_args[0]),0.0,1.0);
  let mu_smoothed=mu_t*mu_t*(3.0-2.0*mu_t);
  if(mu_smooth>=mu_smooth_args[1]) { mu_smoothed=1.0; }
  if(mu_smooth<=mu_smooth_args[0]) { mu_smoothed=0.0; }
  return mu_smoothed;
}

function MathUtils_smootherstep(mu_smoother,...mu_smoother_args) {
  let mu_s=vector_limit((mu_smoother-mu_smoother_args[0])/(mu_smoother_args[1]-mu_smoother_args[0]),0.0,1.0);
  let mu_smoother_value=mu_s*mu_s*mu_s*(mu_s*(6.0*mu_s-15.0)+10.0);
  if(mu_smoother>=mu_smoother_args[1]) { mu_smoother_value=1.0; }
  if(mu_smoother<=mu_smoother_args[0]) { mu_smoother_value=0.0; }
  return mu_smoother_value;
}

// Random helpers consume caller-provided samples in [0, 1).
function MathUtils_randInt(mu_int_low,...mu_int_args) {
  return mu_int_low+f64_floor_i64(mu_int_args[1]*(mu_int_args[0]-mu_int_low+1.0));
}

function MathUtils_randFloat(mu_float_low,...mu_float_args) {
  return mu_float_low+mu_float_args[1]*(mu_float_args[0]-mu_float_low);
}

function MathUtils_randFloatSpread(mu_spread,...mu_spread_args) {
  return mu_spread*(0.5-mu_spread_args[0]);
}

native function MathUtils_seededRandom(mu_state:i64) f64 {
  let mu_progress=u32_and(ux_u32(mu_state)+1831565813,4294967295);
  let mu_commit=ux_u32_put(mu_state,mu_progress);
  let mu_mix=u32_mul(u32_xor(mu_progress,u32_shr(mu_progress,15)),u32_or(mu_progress,1));
  mu_mix=u32_xor(mu_mix,mu_mix+u32_mul(u32_xor(mu_mix,u32_shr(mu_mix,7)),u32_or(mu_mix,61)));
  return u32_xor(mu_mix,u32_shr(mu_mix,14))/4294967296.0;
}

function MathUtils_degToRad(mu_degrees) {
  return mu_degrees*0.017453292519943295;
}

function MathUtils_radToDeg(mu_radians) {
  return mu_radians*57.29577951308232;
}

function MathUtils_isPowerOfTwo(mu_power) {
  return mu_power!=0 && u32_and(mu_power,mu_power-1)==0;
}

native function MathUtils_roundPow2(mu_power_in:f64,mu_round_up:i64) f64 {
  if(mu_power_in==0.0 || mu_power_in==1.0/0.0 || mu_power_in!=mu_power_in) { return mu_power_in; }
  if(mu_power_in<0.0) { return 0.0/0.0; }
  let mu_power_value=1.0;
  while(mu_power_value>mu_power_in) { mu_power_value=mu_power_value*0.5; }
  while(mu_power_value*2.0<=mu_power_in) { mu_power_value=mu_power_value*2.0; }
  if(mu_round_up!=0 && mu_power_value<mu_power_in) { mu_power_value=mu_power_value*2.0; }
  return mu_power_value;
}

function MathUtils_ceilPowerOfTwo(mu_ceil) { return MathUtils_roundPow2(mu_ceil,1); }
function MathUtils_floorPowerOfTwo(mu_floor_power) { return MathUtils_roundPow2(mu_floor_power,0); }

// Format four i32 entropy samples with the UUID version and variant fields set.
function MathUtils_generateUUID(mu_words) {
  let mu_uuid="";
  let mu_alphabet="0123456789abcdef";
  let mu_index=0;
  while(mu_index<16) {
    let mu_word=ux_u32(mu_words+4*(mu_index/4));
    let mu_byte=u32_and(u32_shr(mu_word,8*(mu_index%4)),255);
    if(mu_index==6) { mu_byte=u32_or(u32_and(mu_byte,15),64); }
    if(mu_index==8) { mu_byte=u32_or(u32_and(mu_byte,63),128); }
    if(mu_index==4 || mu_index==6 || mu_index==8 || mu_index==10) { mu_uuid=mu_uuid+"-"; }
    let mu_high=mu_byte/16; let mu_low=mu_byte%16;
    mu_uuid=mu_uuid+str_slice(mu_alphabet,mu_high,mu_high+1)+str_slice(mu_alphabet,mu_low,mu_low+1);
    mu_index=mu_index+1;
  }
  return mu_uuid;
}

// Orders 0..5 correspond to XYX, YZY, ZXZ, XZX, YXY, ZYZ.
native function MathUtils_properEuler(mu_qdst:i64,mu_a:f64,mu_b:f64,mu_c:f64,mu_order:i64) i64 {
  if(mu_order<0 || mu_order>=6) { return 0-1; }
  let mu_axis=mu_order%3;
  let mu_middle=(mu_axis+1)%3;
  let mu_remaining=(mu_axis+2)%3;
  let mu_parity=1.0;
  if(mu_order>=3) {
    mu_middle=(mu_axis+2)%3; mu_remaining=(mu_axis+1)%3;
    mu_parity=0.0-1.0;
  }
  let mu_cos_b=ux_math_cos(mu_b*0.5);
  let mu_sin_b=ux_math_sin(mu_b*0.5);
  let mu_sum=(mu_a+mu_c)*0.5;
  let mu_difference=(mu_a-mu_c)*0.5;
  let mu_components=[0.0,0.0,0.0];
  mu_components[mu_axis]=mu_cos_b*ux_math_sin(mu_sum);
  mu_components[mu_middle]=mu_sin_b*ux_math_cos(mu_difference);
  mu_components[mu_remaining]=mu_parity*mu_sin_b*ux_math_sin(mu_difference);
  let mu_span=ux_span(mu_qdst,32);
  let mu_qx=ux_f64_put(mu_qdst,mu_components[0]);
  let mu_qy=ux_f64_put(mu_qdst+8,mu_components[1]);
  let mu_qz=ux_f64_put(mu_qdst+16,mu_components[2]);
  let mu_qw=ux_f64_put(mu_qdst+24,mu_cos_b*ux_math_cos(mu_sum));
  return mu_qdst;
}

function MathUtils_setQuaternionFromProperEuler(mu_euler_dst,...mu_euler_args) {
  return MathUtils_properEuler(mu_euler_dst,mu_euler_args[0],mu_euler_args[1],mu_euler_args[2],
    f64_floor_i64(mu_euler_args[3]));
}

// Kinds 0..6 are Float32, Uint32, Uint16, Uint8, Int32, Int16, Int8.
native function MathUtils_normalize(mu_normalize:f64,mu_type:i64) f64 {
  if(mu_type<0 || mu_type>6) { return 0.0/0.0; }
  if(mu_type==0) { return mu_normalize; }
  let mu_maxima=[1.0,4294967295.0,65535.0,255.0,2147483647.0,32767.0,127.0];
  return vector_roundValue(mu_normalize*mu_maxima[mu_type],2.0);
}

native function MathUtils_denormalize(mu_decode:f64,mu_kind:i64) f64 {
  if(mu_kind<0 || mu_kind>6) { return 0.0/0.0; }
  let mu_divisors=[1.0,4294967295.0,65535.0,255.0,2147483647.0,32767.0,127.0];
  let mu_fraction=mu_decode/mu_divisors[mu_kind];
  if(mu_kind>=4 && mu_fraction<0.0-1.0) { mu_fraction=0.0-1.0; }
  return mu_fraction;
}
