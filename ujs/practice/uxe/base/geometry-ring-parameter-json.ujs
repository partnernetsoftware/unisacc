native function ring_geometry_keys(at:i64) i64 {
  let labels=[82,105,110,103,71,101,111,109,101,116,114,121,
    105,110,110,101,114,82,97,100,105,117,115,111,117,116,101,114,82,97,100,105,117,115,
    116,104,101,116,97,83,101,103,109,101,110,116,115,112,104,105,83,101,103,109,101,110,116,115,
    116,104,101,116,97,83,116,97,114,116,116,104,101,116,97,76,101,110,103,116,104];
  let i=0;
  while(i<79) {
    let byte=ux_u8_put(at+i,labels[i]);
    i=i+1;
  }
  return at;
}

native function RingGeometry_toJSON(ring:i64,dst:i64,end:i64,uuid:i64,uuidBytes:i64,scratch:i64) i64 {
  if(geometry_primitive_ready(ring,7)<0 ||
     !geometry_primitive_json_io(ring,dst,end,uuid,uuidBytes,scratch,79)) { return 0-1; }
  let keys=ring_geometry_keys(scratch+1104);
  let p=geometry_primitive_json_head(ring,dst,end,uuid,uuidBytes,keys,12);
  p=geometry_parameter_number(p,end,keys+12,11,ux_f64(ring+GeometryPrimitiveRecord.first),scratch);
  p=geometry_parameter_number(p,end,keys+23,11,ux_f64(ring+GeometryPrimitiveRecord.second),scratch);
  p=geometry_parameter_number(p,end,keys+34,13,ux_f64(ring+GeometryPrimitiveRecord.third),scratch);
  p=geometry_parameter_number(p,end,keys+47,11,ux_f64(ring+GeometryPrimitiveRecord.fourth),scratch);
  p=geometry_parameter_number(p,end,keys+58,10,ux_f64(ring+GeometryPrimitiveRecord.fifth),scratch);
  p=geometry_parameter_number(p,end,keys+68,11,ux_f64(ring+GeometryPrimitiveRecord.sixth),scratch);
  return json_byte(p,end,125);
}

native function RingGeometry_fromJSON(ring:i64,raw:i64,arena:i64,bytes:i64,input:i64,end:i64,scratch:i64) i64 {
  let space=RingGeometryParameters.size+79;
  if(scratch%8!=0 || end<=input ||
     !geometry_primitive_raw(ring,raw,arena,bytes,input,end-input) ||
     !geometry_primitive_raw(ring,raw,arena,bytes,scratch,space) ||
     !geometry_public_disjoint(input,end-input,scratch,space) ||
     !geometry_primitive_json_object(input,end)) { return 0-1; }
  let keys=ring_geometry_keys(scratch+RingGeometryParameters.size);
  let a=ux_f64_put(scratch+RingGeometryParameters.innerRadius,geometry_primitive_json_number(input,end,keys+12,11,0.5));
  let b=ux_f64_put(scratch+RingGeometryParameters.outerRadius,geometry_primitive_json_number(input,end,keys+23,11,1.0));
  let c=ux_f64_put(scratch+RingGeometryParameters.thetaSegments,geometry_primitive_json_number(input,end,keys+34,13,32.0));
  let d=ux_f64_put(scratch+RingGeometryParameters.phiSegments,geometry_primitive_json_number(input,end,keys+47,11,1.0));
  let e=ux_f64_put(scratch+RingGeometryParameters.thetaStart,geometry_primitive_json_number(input,end,keys+58,10,0.0));
  let f=ux_f64_put(scratch+RingGeometryParameters.thetaLength,geometry_primitive_json_number(input,end,keys+68,11,6.283185307179586));
  return RingGeometry_create(ring,raw,arena,bytes,scratch);
}
