// The workspace contains the parameter record, 20 vertices, 36 triangles and triangle scratch.
native function DodecahedronGeometry_generate(mesh:i64,work:i64,radius:f64,detail:i64) i64 {
  if(work<0 || work>6291456-1016 || work%8!=0) { return 0-1; }
  let source=work+32;
  let indices=work+512;
  let phi=(1.0+f64_sqrt(5.0))*0.5;
  let inv=1.0/phi;
  let i=0;
  while(i<20) {
    let x=2.0*(i/4)-1.0;
    let y=2.0*((i/2)%2)-1.0;
    let z=2.0*(i%2)-1.0;
    if(i>=8) {
      let s=2.0*((i/2)%2)-1.0;
      let t=2.0*(i%2)-1.0;
      x=0.0; y=s*inv; z=t*phi;
      if(i>=12) { x=s*inv; y=t*phi; z=0.0; }
      if(i>=16) {
        x=t*phi; y=0.0; z=s*inv;
      }
    }
    let at=source+i*24;
    let px=ux_f64_put(at,x);
    let py=ux_f64_put(at+8,y);
    let pz=ux_f64_put(at+16,z);
    i=i+1;
  }
  let faces=[31107,30715,31513,71917,71706,70615,170408,170810,171006,
    80016,81602,80210,1201,118,1816,61002,60213,61315,21618,21803,20313,
    180109,180911,181103,41412,41200,40008,110905,110519,111907,190514,191404,190417,
    11214,11405,10509];
  let face=0;
  while(face<36) {
    let code=faces[face];
    let at=indices+face*12;
    let a=ux_u32_put(at,code/10000);
    let b=ux_u32_put(at+4,(code/100)%100);
    let c=ux_u32_put(at+8,code%100);
    face=face+1;
  }
  let config=PolyhedronGeometry_init(work,source,20,indices,108,work+944);
  return PolyhedronGeometry_generate(mesh,config,radius,detail);
}
