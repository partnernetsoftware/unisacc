// RGBA8 rows are tightly packed. A descriptor is separately caller-owned.
native function DataTexture_rgba8Source(at:i64,bytes:i64,width:i64,height:i64) i64 {
  if(at<0 || at%4!=0 || at>6291456-GpuTextureSource.size ||
     width<1 || width>4096 || height<1 || height>4096 || bytes<0 ||
     bytes>6291456-width*height*4 ||
     !texture_object_disjoint(at,GpuTextureSource.size,bytes,width*height*4)) { return 0-1; }
  let w=ux_u32_put(at+GpuTextureSource.width,width);
  let h=ux_u32_put(at+GpuTextureSource.height,height);
  let filter=ux_u32_put(at+GpuTextureSource.filter,0);
  let wrapS=ux_u32_put(at+GpuTextureSource.wrapS,0);
  let wrapT=ux_u32_put(at+GpuTextureSource.wrapT,0);
  let pixels=ux_u32_put(at+GpuTextureSource.rgba,bytes);
  return at;
}

function DataTexture_init(data_texture,...data_texture_args) {
  return Texture_init(data_texture,data_texture_args[0],data_texture_args[1]);
}

function DataTexture_clone(data_texture,...data_clone_args) {
  return Texture_clone(data_texture,data_clone_args[0]);
}

native function DataTexture_texel(texture:i64,x:i64,y:i64) i64 {
  if(!texture_object_valid(texture)) { return 0-1; }
  let descriptor=gpu_texture_source(ux_u32(texture+Texture.table),ux_u32(texture+Texture.handle));
  if(descriptor<0) { return descriptor; }
  let width=ux_u32(descriptor+GpuTextureSource.width);
  if(x<0 || x>=width || y<0 || y>=ux_u32(descriptor+GpuTextureSource.height)) { return 0-1; }
  return ux_u32(descriptor+GpuTextureSource.rgba)+4*(y*width+x);
}
