function InstancedBufferAttribute_init(iba_dst,...iba_args) {
  let iba_result=0-1;
  if(iba_args[5]>0 && iba_args[5]<=4294967295) {
    iba_result=BufferAttribute_init(iba_dst,iba_args[0],iba_args[1],iba_args[2],iba_args[3],iba_args[4]);
    if(iba_result>=0) {
      let iba_instance=ux_u32_put(iba_dst+InstancedBufferAttribute.meshPerAttribute,iba_args[5]);
    }
  }
  return iba_result;
}

function InstancedBufferAttribute_clone(iba_clone,...iba_clone_args) {
  let iba_src=iba_clone_args[0];
  let iba_copy=BufferAttribute_copy(iba_clone,iba_src,iba_clone_args[1],iba_clone_args[2]);
  if(iba_copy>=0) {
    let iba_instance_copy=ux_u32_put(iba_clone+InstancedBufferAttribute.meshPerAttribute,
      ux_u32(iba_src+InstancedBufferAttribute.meshPerAttribute));
  }
  return iba_copy;
}
