native function transform_vec3_valid(address:i64) i64 {
  return address>=0 && address%8==0 && address<=6291456-24;
}

native function transform_world_axis(position:f64,parent:f64,start:f64,end:f64,snap:f64) f64 {
  let translated=position+(end-start);
  if(snap==0.0) { return translated; }
  let grid=(translated+parent)/snap;
  if(grid-grid!=0.0) { return 0.0/0.0; }
  // Above this magnitude a binary64 value already has no fractional part.
  if(grid>0.0-4503599627370496.0 && grid<4503599627370496.0) {
    let below=f64_floor_i64(grid);
    let round=below;
    if(grid-below>=0.5) { round=round+1; }
    grid=round*1.0;
  }
  return grid*snap-parent;
}

// The pick plane supplies world-space start and end hits. Axis bits X=1,
// Y=2 and Z=4 mask the delta. The parent can translate the local origin.
native function TransformControls_translate(out:i64,position:i64,parent:i64,start:i64,end:i64,axes:i64,snap:f64) i64 {
  if(!transform_vec3_valid(out) || !transform_vec3_valid(position) || !transform_vec3_valid(parent) ||
     !transform_vec3_valid(start) || !transform_vec3_valid(end) ||
     axes<1 || axes>7 || snap<0.0 || snap-snap!=0.0) { return 0-1; }
  let x=ux_f64(position);
  let y=ux_f64(position+8);
  let z=ux_f64(position+16);
  if(axes%2==1) { x=transform_world_axis(x,ux_f64(parent),ux_f64(start),ux_f64(end),snap); }
  if((axes/2)%2==1) { y=transform_world_axis(y,ux_f64(parent+8),ux_f64(start+8),ux_f64(end+8),snap); }
  if(axes>=4) { z=transform_world_axis(z,ux_f64(parent+16),ux_f64(start+16),ux_f64(end+16),snap); }
  if(x-x!=0.0 || y-y!=0.0 || z-z!=0.0) { return 0-1; }
  let a=ux_f64_put(out,x);
  let b=ux_f64_put(out+8,y);
  let c=ux_f64_put(out+16,z);
  return out;
}
