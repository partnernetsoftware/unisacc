struct DefaultLoadingManager {
  initialized: u32;
  manager: u32;
}

// Each base instance reserves one zero-initialized slot and one manager record.
// Every loader in that instance resolves the same pair of addresses.
native function DefaultLoadingManager_get(slot:i64,manager:i64) i64 {
  if(!loading_span(slot,DefaultLoadingManager.size) || !loading_span(manager,LoadingManager.size) ||
     (slot<manager+LoadingManager.size && manager<slot+DefaultLoadingManager.size)) { return 0-1; }
  let ready=ux_u32(slot+DefaultLoadingManager.initialized);
  if(ready==0) {
    let initialized=LoadingManager_init(manager);
    let pointer=ux_u32_put(slot+DefaultLoadingManager.manager,initialized);
    let published=ux_u32_put(slot+DefaultLoadingManager.initialized,1);
  } else if(ready!=1 || ux_u32(slot+DefaultLoadingManager.manager)!=manager) { return 0-1; }
  return manager;
}
