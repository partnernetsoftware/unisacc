struct InterpolantState {
  view: u32;
  kind: u32;
  result: u32;
  timeKind: u32;
  valueKind: u32;
  resultKind: u32;
  inputBytes: u32;
  settings: u32;
  defaultStart: u32;
  defaultEnd: u32;
  cached: u32;
  previous: u32;
  next: u32;
  weightPrevious: f64;
  weightNext: f64;
}

struct InterpolantSettings {
  endingStart: u32;
  endingEnd: u32;
}

struct InterpolantNumericView {
  times: u32;
  values: u32;
  count: u32;
  stride: u32;
  timeKind: u32;
  valueKind: u32;
}

// Match AnimationArrayView kinds: dense Number Array, Float32Array, Float64Array.
native function interpolant_width(kind:i64) i64 {
  if(kind==0 || kind==10) { return 8; }
  if(kind>=1 && kind<=3) { return 1; }
  if(kind>=4 && kind<=5) { return 2; }
  if(kind==6 || kind==7 || kind==9) { return 4; }
  return 0;
}

native function interpolant_span(at:i64,count:i64,width:i64) i64 {
  return width>0 && at>=0 && at%width==0 && count>=0 && count<=(6291456-at)/width && at<=6291456;
}

native function interpolant_read(at:i64,kind:i64) f64 {
  if(kind==0 || kind==10) { return ux_f64(at); }
  if(kind==9) { return ux_f32(at); }
  if(kind==6) { return 0.0+ux_u32(at); }
  if(kind==7) { return 0.0+ux_i32(at); }
  if(kind==4 || kind==5) {
    let word=ux_u16(at);
    if(kind==5 && word>=32768) { word=word-65536; }
    return 0.0+word;
  }
  let byte=ux_u8(at);
  if(kind==2 && byte>=128) { byte=byte-256; }
  return 0.0+byte;
}

native function interpolant_write(at:i64,kind:i64,value:f64) i64 {
  if(kind==0 || kind==10) { return ux_f64_put(at,value); }
  if(kind==9) { return ux_f32_put(at,value); }
  if(kind==3) {
    if(value!=value || value<=0.0) { return ux_u8_put(at,0); }
    if(value>=255.0) { return ux_u8_put(at,255); }
    let whole=f64_floor_i64(value);
    let rest=value-whole;
    if(rest>0.5 || (rest==0.5 && whole%2!=0)) { whole=whole+1; }
    return ux_u8_put(at,whole);
  }
  let word=0;
  let limit=1099511627776.0*17592186044416.0;
  if(value==value && value<limit && value>0.0-limit) {
    let magnitude=value;
    let sign=1;
    if(value<0.0) { magnitude=0.0-value; sign=0-1; }
    let blocks=f64_floor_i64(magnitude/4294967296.0);
    word=sign*f64_floor_i64(magnitude-blocks*4294967296.0);
  }
  if(word<0) { word=word+4294967296; }
  if(kind<=2) { return ux_u8_put(at,word%256); }
  if(kind<=5) { return ux_u16_put(at,word%65536); }
  return ux_u32_put(at,word);
}

native function interpolant_numeric_shape(view:i64,timeKind:i64,valueKind:i64,inputBytes:i64) i64 {
  if((inputBytes!=AnimationSamples.size && inputBytes!=InterpolantNumericView.size) ||
     !animation_span(view,inputBytes)) { return 0-1; }
  let count=ux_u32(view+AnimationSamples.count);
  let stride=ux_u32(view+AnimationSamples.stride);
  let times=ux_u32(view+AnimationSamples.times);
  let values=ux_u32(view+AnimationSamples.values);
  let tw=interpolant_width(timeKind);
  let vw=interpolant_width(valueKind);
  if(count<1 || count>65536 || stride<1 || stride>64 ||
     !interpolant_span(times,count,tw) || !interpolant_span(values,count*stride,vw) ||
     animation_overlap(view,inputBytes,times,count*tw) ||
     animation_overlap(view,inputBytes,values,count*stride*vw)) { return 0-1; }
  return stride;
}

native function InterpolantNumericView_init(view:i64,times:i64,values:i64,count:i64,stride:i64,timeKind:i64,valueKind:i64) i64 {
  let tw=interpolant_width(timeKind);
  let vw=interpolant_width(valueKind);
  let bytes=InterpolantNumericView.size;
  if(count<1 || count>65536 || stride<1 || stride>64 || !animation_span(view,bytes) ||
     !interpolant_span(times,count,tw) || !interpolant_span(values,count*stride,vw) ||
     animation_overlap(view,bytes,times,count*tw) ||
     animation_overlap(view,bytes,values,count*stride*vw)) { return 0-1; }
  let last=interpolant_read(times,timeKind);
  let i=0;
  while(i<count) {
    let t=interpolant_read(times+i*tw,timeKind);
    if(t-t!=0.0 || t<last) { return 0-2; }
    last=t; i=i+1;
  }
  let storedTimes=ux_u32_put(view+InterpolantNumericView.times,times);
  let v=ux_u32_put(view+InterpolantNumericView.values,values);
  let c=ux_u32_put(view+InterpolantNumericView.count,count);
  let n=ux_u32_put(view+InterpolantNumericView.stride,stride);
  let a=ux_u32_put(view+InterpolantNumericView.timeKind,timeKind);
  let b=ux_u32_put(view+InterpolantNumericView.valueKind,valueKind);
  return view;
}

// Each record reserves an inline result matching the sample width.
// A caller-provided result may independently select any supported kind.
native function interpolant_storage(state:i64,view:i64,result:i64,timeKind:i64,valueKind:i64,resultKind:i64,inputBytes:i64) i64 {
  let stride=interpolant_numeric_shape(view,timeKind,valueKind,inputBytes);
  if(stride<1 || state%8!=0) { return 0-1; }
  let tw=interpolant_width(timeKind);
  let vw=interpolant_width(valueKind);
  let rw=interpolant_width(resultKind);
  let total=InterpolantState.size+stride*vw;
  let count=ux_u32(view+AnimationSamples.count);
  let times=ux_u32(view+AnimationSamples.times);
  let values=ux_u32(view+AnimationSamples.values);
  if(!animation_span(state,total) || !interpolant_span(result,stride,rw) ||
     animation_overlap(state,total,view,inputBytes) ||
     animation_overlap(state,total,times,count*tw) ||
     animation_overlap(state,total,values,count*stride*vw) ||
     animation_overlap(result,stride*rw,view,inputBytes) ||
     animation_overlap(result,stride*rw,times,count*tw) ||
     animation_overlap(result,stride*rw,values,count*stride*vw) ||
     (animation_overlap(state,total,result,stride*rw) &&
       (result!=state+InterpolantState.size || resultKind!=valueKind))) { return 0-1; }
  return stride;
}

native function interpolant_init(state:i64,view:i64,result:i64,kind:i64,timeKind:i64,valueKind:i64,resultKind:i64,inputBytes:i64) i64 {
  let explicit=result!=0-1;
  if(resultKind==0-1) { resultKind=valueKind; }
  if(result==0-1) {
    if(resultKind!=valueKind) { return 0-1; }
    result=state+InterpolantState.size;
  }
  let stride=interpolant_storage(state,view,result,timeKind,valueKind,resultKind,inputBytes);
  if(stride<1 || kind<0 || kind>4 || (kind==3 && stride%4!=0)) { return 0-1; }
  let v=ux_u32_put(state+InterpolantState.view,view);
  let k=ux_u32_put(state+InterpolantState.kind,kind+1);
  let r=ux_u32_put(state+InterpolantState.result,result);
  let ti=ux_u32_put(state+InterpolantState.timeKind,timeKind);
  let va=ux_u32_put(state+InterpolantState.valueKind,valueKind);
  let ro=ux_u32_put(state+InterpolantState.resultKind,resultKind);
  let ib=ux_u32_put(state+InterpolantState.inputBytes,inputBytes);
  let s=ux_u32_put(state+InterpolantState.settings,0);
  let ds=ux_u32_put(state+InterpolantState.defaultStart,2400);
  let de=ux_u32_put(state+InterpolantState.defaultEnd,2400);
  let c=ux_u32_put(state+InterpolantState.cached,0);
  let p=ux_u32_put(state+InterpolantState.previous,0);
  let n=ux_u32_put(state+InterpolantState.next,0);
  let w=ux_f64_put(state+InterpolantState.weightPrevious,0.0);
  let x=ux_f64_put(state+InterpolantState.weightNext,0.0);
  let bytes=stride*interpolant_width(valueKind);
  let i=0;
  while(i<bytes && (explicit==0 || result!=state+InterpolantState.size)) {
    let clear=ux_u8_put(state+InterpolantState.size+i,0);
    i=i+1;
  }
  return state;
}

// The base class copies boundary samples and has no interior interpolation.
native function Interpolant_init(state:i64,view:i64,result:i64) i64 {
  return interpolant_init(state,view,result,4,9,9,9,AnimationSamples.size);
}

native function LinearInterpolant_init(state:i64,view:i64,result:i64) i64 {
  return interpolant_init(state,view,result,0,9,9,9,AnimationSamples.size);
}
native function DiscreteInterpolant_init(state:i64,view:i64,result:i64) i64 {
  return interpolant_init(state,view,result,1,9,9,9,AnimationSamples.size);
}
native function CubicInterpolant_init(state:i64,view:i64,result:i64) i64 {
  return interpolant_init(state,view,result,2,9,9,9,AnimationSamples.size);
}
native function QuatLinearInterpolant_init(state:i64,view:i64,result:i64) i64 {
  return interpolant_init(state,view,result,3,9,9,9,AnimationSamples.size);
}

// Kinds 0 through 4 are Linear, Discrete, Cubic, QuaternionLinear and abstract base.
native function Interpolant_initNumeric(state:i64,view:i64,result:i64,resultKind:i64,kind:i64) i64 {
  if(!animation_span(view,InterpolantNumericView.size)) { return 0-1; }
  return interpolant_init(state,view,result,kind,ux_u32(view+InterpolantNumericView.timeKind),
    ux_u32(view+InterpolantNumericView.valueKind),resultKind,InterpolantNumericView.size);
}

native function interpolant_settings_ok(state:i64,view:i64,result:i64,stride:i64,settings:i64,resultKind:i64) i64 {
  if(settings==0-1) { return 1; }
  let bytes=InterpolantSettings.size;
  let count=ux_u32(view+AnimationSamples.count);
  let tw=interpolant_width(ux_u32(state+InterpolantState.timeKind));
  let vw=interpolant_width(ux_u32(state+InterpolantState.valueKind));
  let rw=interpolant_width(resultKind);
  return animation_span(settings,bytes) &&
    !animation_overlap(settings,bytes,state,InterpolantState.size+stride*vw) &&
    !animation_overlap(settings,bytes,result,stride*rw) &&
    !animation_overlap(settings,bytes,view,ux_u32(state+InterpolantState.inputBytes)) &&
    !animation_overlap(settings,bytes,ux_u32(view+AnimationSamples.times),count*tw) &&
    !animation_overlap(settings,bytes,ux_u32(view+AnimationSamples.values),count*stride*vw);
}

native function interpolant_alive(state:i64) i64 {
  if(!animation_span(state,InterpolantState.size) || state%8!=0) { return 0; }
  let kind=ux_u32(state+InterpolantState.kind);
  return kind>=1 && kind<=5;
}

native function Interpolant_setSettings(state:i64,settings:i64) i64 {
  if(!interpolant_alive(state)) { return 0-1; }
  let view=ux_u32(state+InterpolantState.view);
  let result=ux_u32(state+InterpolantState.result);
  let resultKind=ux_u32(state+InterpolantState.resultKind);
  let stride=interpolant_storage(state,view,result,ux_u32(state+InterpolantState.timeKind),
    ux_u32(state+InterpolantState.valueKind),resultKind,ux_u32(state+InterpolantState.inputBytes));
  if(stride<1 || !interpolant_settings_ok(state,view,result,stride,settings,resultKind)) { return 0-1; }
  let saved=ux_u32_put(state+InterpolantState.settings,settings+1);
  return state;
}

native function Interpolant_getSettings(state:i64) i64 {
  if(!interpolant_alive(state)) { return 0-1; }
  let settings=ux_u32(state+InterpolantState.settings);
  if(settings!=0) { return settings-1; }
  return state+InterpolantState.defaultStart;
}

native function Interpolant_setResultKind(state:i64,result:i64,resultKind:i64) i64 {
  if(!interpolant_alive(state)) { return 0-1; }
  let valueKind=ux_u32(state+InterpolantState.valueKind);
  if(resultKind==0-1) { resultKind=valueKind; }
  if(result==0-1) {
    if(resultKind!=valueKind) { return 0-1; }
    result=state+InterpolantState.size;
  }
  let view=ux_u32(state+InterpolantState.view);
  let stride=interpolant_storage(state,view,result,ux_u32(state+InterpolantState.timeKind),
    valueKind,resultKind,ux_u32(state+InterpolantState.inputBytes));
  let settings=ux_u32(state+InterpolantState.settings)-1;
  if(stride<1 || !interpolant_settings_ok(state,view,result,stride,settings,resultKind)) { return 0-1; }
  let saved=ux_u32_put(state+InterpolantState.result,result);
  let tagged=ux_u32_put(state+InterpolantState.resultKind,resultKind);
  return result;
}

native function Interpolant_setResult(state:i64,result:i64) i64 {
  if(!interpolant_alive(state)) { return 0-1; }
  let kind=ux_u32(state+InterpolantState.resultKind);
  if(result==0-1) { kind=0-1; }
  return Interpolant_setResultKind(state,result,kind);
}

native function interpolant_copy_row(result:i64,row:i64,count:i64,resultKind:i64,valueKind:i64) i64 {
  let rw=interpolant_width(resultKind);
  let vw=interpolant_width(valueKind);
  if(resultKind==valueKind || (rw==8 && vw==8)) { return uxe_copy_record(result,row,count*vw); }
  let i=0;
  while(i<count) {
    let saved=interpolant_write(result+i*rw,resultKind,interpolant_read(row+i*vw,valueKind));
    i=i+1;
  }
  return result;
}

native function interpolant_upper(times:i64,count:i64,timeKind:i64,t:f64) i64 {
  let width=interpolant_width(timeKind);
  let lo=0; let hi=count;
  while(lo<hi) {
    let mid=(lo+hi)/2;
    if(t<interpolant_read(times+mid*width,timeKind)) { hi=mid; }
    else { lo=mid+1; }
  }
  return lo;
}

native function interpolant_cubic_seek(state:i64,times:i64,count:i64,upper:i64,settings:i64,timeKind:i64) i64 {
  let tw=interpolant_width(timeKind);
  let start=ux_u32(state+InterpolantState.defaultStart);
  let end=ux_u32(state+InterpolantState.defaultEnd);
  if(settings>=0) {
    start=ux_u32(settings+InterpolantSettings.endingStart);
    end=ux_u32(settings+InterpolantSettings.endingEnd);
  }
  let previous=upper-2; let next=upper+1;
  let t0=interpolant_read(times+(upper-1)*tw,timeKind);
  let t1=interpolant_read(times+upper*tw,timeKind);
  let past=t1; let future=t0;
  if(previous>=0) { past=interpolant_read(times+previous*tw,timeKind); }
  else {
    previous=upper;
    if(start==2401) { past=2.0*t0-t1; }
    if(start==2402) {
      previous=count-2;
      past=t0+interpolant_read(times+previous*tw,timeKind)-interpolant_read(times+(previous+1)*tw,timeKind);
    }
  }
  if(next<count) { future=interpolant_read(times+next*tw,timeKind); }
  else {
    next=upper-1;
    if(end==2401) { next=upper; future=2.0*t1-t0; }
    if(end==2402) { next=1; future=t1+interpolant_read(times+tw,timeKind)-interpolant_read(times,timeKind); }
  }
  let half=(t1-t0)*0.5;
  let p=ux_u32_put(state+InterpolantState.previous,previous);
  let n=ux_u32_put(state+InterpolantState.next,next);
  let wp=ux_f64_put(state+InterpolantState.weightPrevious,half/(t0-past));
  let wn=ux_f64_put(state+InterpolantState.weightNext,half/(future-t1));
  return upper;
}

native function interpolant_cubic_output(state:i64,values:i64,stride:i64,upper:i64,result:i64,p:f64,valueKind:i64,resultKind:i64) i64 {
  let vw=interpolant_width(valueKind);
  let rw=interpolant_width(resultKind);
  let previous=ux_u32(state+InterpolantState.previous)*stride*vw;
  let next=ux_u32(state+InterpolantState.next)*stride*vw;
  let wp=ux_f64(state+InterpolantState.weightPrevious);
  let wn=ux_f64(state+InterpolantState.weightNext);
  let pp=p*p; let ppp=pp*p;
  let sP=0.0-wp*ppp+2.0*wp*pp-wp*p;
  let s0=(1.0+wp)*ppp+(-1.5-2.0*wp)*pp+(-0.5+wp)*p+1.0;
  let s1=(-1.0-wn)*ppp+(1.5+wn)*pp+0.5*p;
  let sN=wn*ppp-wn*pp;
  let offset=(upper-1)*stride*vw;
  let lane=0;
  while(lane<stride) {
    let at=values+lane*vw;
    let cell=interpolant_write(result+lane*rw,resultKind,sP*interpolant_read(at+previous,valueKind)+s0*interpolant_read(at+offset,valueKind)+
      s1*interpolant_read(at+offset+stride*vw,valueKind)+sN*interpolant_read(at+next,valueKind));
    lane=lane+1;
  }
  return result;
}

native function interpolant_quaternion_flat(result:i64,lo:i64,hi:i64,t:f64,valueKind:i64,resultKind:i64) i64 {
  let vw=interpolant_width(valueKind);
  let rw=interpolant_width(resultKind);
  if(t==0.0) { return interpolant_copy_row(result,lo,4,resultKind,valueKind); }
  if(t==1.0) { return interpolant_copy_row(result,hi,4,resultKind,valueKind); }
  let x=interpolant_read(lo,valueKind); let y=interpolant_read(lo+vw,valueKind); let z=interpolant_read(lo+2*vw,valueKind); let w=interpolant_read(lo+3*vw,valueKind);
  let a=interpolant_read(hi,valueKind); let b=interpolant_read(hi+vw,valueKind); let c=interpolant_read(hi+2*vw,valueKind); let d=interpolant_read(hi+3*vw,valueKind);
  if(x!=a || y!=b || z!=c || w!=d) {
    let s=1.0-t;
    let cos=x*a+y*b+z*c+w*d;
    let dir=1.0;
    if(cos<0.0) { dir=0.0-1.0; }
    let sqrSin=1.0-cos*cos;
    if(sqrSin>0.0000000000000002220446049250313) {
      let sin=f64_sqrt(sqrSin);
      let angle=ux_math_atan2(sin,cos*dir);
      s=ux_math_sin(s*angle)/sin;
      t=ux_math_sin(t*angle)/sin;
    }
    let signed=t*dir;
    x=x*s+a*signed; y=y*s+b*signed; z=z*s+c*signed; w=w*s+d*signed;
    if(s==1.0-t) {
      let length=1.0/f64_sqrt(x*x+y*y+z*z+w*w);
      x=x*length; y=y*length; z=z*length; w=w*length;
    }
  }
  let u=interpolant_write(result,resultKind,x);
  let v=interpolant_write(result+rw,resultKind,y);
  let o=interpolant_write(result+2*rw,resultKind,z);
  let p=interpolant_write(result+3*rw,resultKind,w);
  return result;
}

native function Interpolant_copySampleValue(state:i64,index:i64) i64 {
  if(!interpolant_alive(state)) { return 0-1; }
  let view=ux_u32(state+InterpolantState.view);
  let result=ux_u32(state+InterpolantState.result);
  let timeKind=ux_u32(state+InterpolantState.timeKind);
  let valueKind=ux_u32(state+InterpolantState.valueKind);
  let resultKind=ux_u32(state+InterpolantState.resultKind);
  let stride=interpolant_storage(state,view,result,timeKind,valueKind,resultKind,ux_u32(state+InterpolantState.inputBytes));
  if(stride<1 || index<0 || index>=ux_u32(view+AnimationSamples.count)) { return 0-1; }
  let vw=interpolant_width(valueKind);
  let src=ux_u32(view+AnimationSamples.values)+index*stride*vw;
  return interpolant_copy_row(result,src,stride,resultKind,valueKind);
}

// Product-defined evaluators use the same interval and cache as built-in kinds.
native function interpolant_locate(state:i64,times:i64,count:i64,timeKind:i64,t:f64) i64 {
  let tw=interpolant_width(timeKind);
  let cached=ux_u32(state+InterpolantState.cached);
  if(cached>count) { return 0-1; }
  let hit=0;
  if(cached==0) { hit=t<interpolant_read(times,timeKind); }
  else if(cached==count) { hit=!(t<interpolant_read(times+(count-1)*tw,timeKind)); }
  else { hit=t>=interpolant_read(times+(cached-1)*tw,timeKind) && t<interpolant_read(times+cached*tw,timeKind); }
  if(hit) { return cached*2; }
  let upper=interpolant_upper(times,count,timeKind,t);
  let saved=ux_u32_put(state+InterpolantState.cached,upper);
  return upper*2+(upper>0 && upper<count);
}

// Returns twice the upper index plus a bit requesting intervalChanged_.
// Upper indices zero and count denote boundary copies with no change callback.
native function Interpolant_locate(state:i64,t:f64) i64 {
  if(!interpolant_alive(state) || ux_u32(state+InterpolantState.kind)!=5) { return 0-1; }
  let view=ux_u32(state+InterpolantState.view);
  let timeKind=ux_u32(state+InterpolantState.timeKind);
  let stride=interpolant_numeric_shape(view,timeKind,ux_u32(state+InterpolantState.valueKind),
    ux_u32(state+InterpolantState.inputBytes));
  if(stride<1) { return 0-1; }
  return interpolant_locate(state,ux_u32(view+AnimationSamples.times),
    ux_u32(view+AnimationSamples.count),timeKind,t);
}

native function Interpolant_evaluate(state:i64,t:f64) i64 {
  if(!interpolant_alive(state)) { return 0-1; }
  let kind=ux_u32(state+InterpolantState.kind)-1;
  let view=ux_u32(state+InterpolantState.view);
  let result=ux_u32(state+InterpolantState.result);
  let settings=ux_u32(state+InterpolantState.settings)-1;
  let timeKind=ux_u32(state+InterpolantState.timeKind);
  let valueKind=ux_u32(state+InterpolantState.valueKind);
  let resultKind=ux_u32(state+InterpolantState.resultKind);
  let tw=interpolant_width(timeKind); let vw=interpolant_width(valueKind); let rw=interpolant_width(resultKind);
  let stride=interpolant_storage(state,view,result,timeKind,valueKind,resultKind,ux_u32(state+InterpolantState.inputBytes));
  if(stride<1 || kind>4 || (kind==3 && stride%4!=0) ||
     !interpolant_settings_ok(state,view,result,stride,settings,resultKind)) { return 0-1; }
  let times=ux_u32(view+AnimationSamples.times);
  let values=ux_u32(view+AnimationSamples.values);
  let count=ux_u32(view+AnimationSamples.count);
  let located=interpolant_locate(state,times,count,timeKind,t);
  if(located<0) { return located; }
  let upper=located/2;
  if(located%2 && kind==2) {
    let changed=interpolant_cubic_seek(state,times,count,upper,settings,timeKind);
  }
  let lower=upper-1;
  if(upper==0) { lower=0; }
  let lo=values+lower*stride*vw;
  if(upper==0 || upper==count || kind==1) { return interpolant_copy_row(result,lo,stride,resultKind,valueKind); }
  if(kind==4) { return 0-3; }
  let hi=lo+stride*vw;
  let t0=interpolant_read(times+lower*tw,timeKind);
  let p=(t-t0)/(interpolant_read(times+upper*tw,timeKind)-t0);
  if(kind==2) { return interpolant_cubic_output(state,values,stride,upper,result,p,valueKind,resultKind); }
  let lane=0;
  while(lane<stride) {
    let at=lane*vw;
    if(kind==3) {
      // r160 writes at destination offset zero for every quaternion.
      let cell=interpolant_quaternion_flat(result,lo+at,hi+at,p,valueKind,resultKind);
      lane=lane+4;
    } else {
      let cell=interpolant_write(result+lane*rw,resultKind,interpolant_read(lo+at,valueKind)*(1.0-p)+interpolant_read(hi+at,valueKind)*p);
      lane=lane+1;
    }
  }
  return result;
}
