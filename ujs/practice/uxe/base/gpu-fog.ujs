native function GpuFog_linearFactor(depth:f64,near:f64,far:f64) f64 {
  if(depth!=depth || near!=near || far!=far || far<=near) { return 0.0-1.0; }
  if(depth<=near) { return 0.0; }
  if(depth>=far) { return 1.0; }
  let t=(depth-near)/(far-near);
  return t*t*(3.0-2.0*t);
}

native function GpuFog_exponentialFactor(depth:f64,density:f64) f64 {
  if(depth!=depth || density!=density || density<0.0) { return 0.0-1.0; }
  let optical=depth*density;
  let exponent=optical*optical;
  if(exponent>=40.0) { return 1.0; }
  return 1.0-ux_math_exp(0.0-exponent);
}
