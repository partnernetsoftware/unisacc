native function box_geometry_keys(at:i64) i64 {
  let labels=[66,111,120,71,101,111,109,101,116,114,121,
    119,105,100,116,104,104,101,105,103,104,116,100,101,112,116,104,
    119,105,100,116,104,83,101,103,109,101,110,116,115,
    104,101,105,103,104,116,83,101,103,109,101,110,116,115,
    100,101,112,116,104,83,101,103,109,101,110,116,115];
  let i=0;
  while(i<67) {
    let byte=ux_u8_put(at+i,labels[i]);
    i=i+1;
  }
  return at;
}

native function BoxGeometry_toJSON(box:i64,dst:i64,end:i64,uuid:i64,uuidBytes:i64,scratch:i64) i64 {
  if(geometry_primitive_ready(box,1)<0 ||
     !geometry_primitive_json_io(box,dst,end,uuid,uuidBytes,scratch,67)) { return 0-1; }
  let keys=box_geometry_keys(scratch+1104);
  let p=geometry_primitive_json_head(box,dst,end,uuid,uuidBytes,keys,11);
  p=geometry_parameter_number(p,end,keys+11,5,ux_f64(box+GeometryPrimitiveRecord.first),scratch);
  p=geometry_parameter_number(p,end,keys+16,6,ux_f64(box+GeometryPrimitiveRecord.second),scratch);
  p=geometry_parameter_number(p,end,keys+22,5,ux_f64(box+GeometryPrimitiveRecord.third),scratch);
  p=geometry_parameter_number(p,end,keys+27,13,ux_f64(box+GeometryPrimitiveRecord.fourth),scratch);
  p=geometry_parameter_number(p,end,keys+40,14,ux_f64(box+GeometryPrimitiveRecord.fifth),scratch);
  p=geometry_parameter_number(p,end,keys+54,13,ux_f64(box+GeometryPrimitiveRecord.sixth),scratch);
  return json_byte(p,end,125);
}

native function BoxGeometry_fromJSON(box:i64,raw:i64,arena:i64,bytes:i64,input:i64,end:i64,scratch:i64,groups:i64) i64 {
  let space=BoxGeometryParameters.size+67;
  if(scratch%8!=0 || end<=input ||
     !geometry_primitive_raw(box,raw,arena,bytes,input,end-input) ||
     !geometry_primitive_raw(box,raw,arena,bytes,scratch,space) ||
     !geometry_primitive_raw(box,raw,arena,bytes,groups,72) ||
     !geometry_public_disjoint(input,end-input,scratch,space) ||
     !geometry_public_disjoint(input,end-input,groups,72) ||
     !geometry_public_disjoint(scratch,space,groups,72) ||
     !geometry_primitive_json_object(input,end)) { return 0-1; }
  let keys=box_geometry_keys(scratch+BoxGeometryParameters.size);
  let a=ux_f64_put(scratch+BoxGeometryParameters.width,geometry_primitive_json_number(input,end,keys+11,5,1.0));
  let b=ux_f64_put(scratch+BoxGeometryParameters.height,geometry_primitive_json_number(input,end,keys+16,6,1.0));
  let c=ux_f64_put(scratch+BoxGeometryParameters.depth,geometry_primitive_json_number(input,end,keys+22,5,1.0));
  let d=ux_f64_put(scratch+BoxGeometryParameters.widthSegments,geometry_primitive_json_number(input,end,keys+27,13,1.0));
  let e=ux_f64_put(scratch+BoxGeometryParameters.heightSegments,geometry_primitive_json_number(input,end,keys+40,14,1.0));
  let f=ux_f64_put(scratch+BoxGeometryParameters.depthSegments,geometry_primitive_json_number(input,end,keys+54,13,1.0));
  return BoxGeometry_create(box,raw,arena,bytes,scratch,groups);
}
