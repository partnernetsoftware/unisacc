struct Fog {
  name: u32;
  nameBytes: u32;
  red: f64;
  green: f64;
  blue: f64;
  near: f64;
  far: f64;
}

struct FogJson {
  kind: u32;
  name: u32;
  nameBytes: u32;
  color: u32;
  near: f64;
  far: f64;
}

native function Fog_init(out:i64,color:i64,near:f64,far:f64) i64 {
  if(out<0 || out%8!=0 || out>6291456-Fog.size ||
     color<0 || color%8!=0 || color>6291456-24) { return 0-1; }
  let red=ux_f64(color);
  let green=ux_f64(color+8);
  let blue=ux_f64(color+16);
  let n=ux_u32_put(out+Fog.name,0);
  let nb=ux_u32_put(out+Fog.nameBytes,0);
  let r=ux_f64_put(out+Fog.red,red);
  let g=ux_f64_put(out+Fog.green,green);
  let b=ux_f64_put(out+Fog.blue,blue);
  let mn=ux_f64_put(out+Fog.near,near);
  let mx=ux_f64_put(out+Fog.far,far);
  return out;
}

native function Fog_initDefault(out:i64,color:i64) i64 {
  return Fog_init(out,color,1.0,1000.0);
}

// The caller owns the immutable UTF-8 bytes throughout the record's lifetime.
native function Fog_setName(fog:i64,text:i64,bytes:i64) i64 {
  if(fog<0 || fog%8!=0 || fog>6291456-Fog.size ||
     text<0 || bytes<0 || bytes>255 || text>6291456-bytes) { return 0-1; }
  let address=ux_u32_put(fog+Fog.name,text);
  let length=ux_u32_put(fog+Fog.nameBytes,bytes);
  return fog;
}

native function Fog_clone(out:i64,fog:i64) i64 {
  if(fog<0 || fog%8!=0 || fog>6291456-Fog.size) { return 0-1; }
  return Fog_init(out,fog+Fog.red,ux_f64(fog+Fog.near),ux_f64(fog+Fog.far));
}

native function Fog_toJSON(out:i64,fog:i64) i64 {
  if(out<0 || out%8!=0 || out>6291456-FogJson.size ||
     fog<0 || fog%8!=0 || fog>6291456-Fog.size) { return 0-1; }
  let label=ux_u32(fog+Fog.name);
  let bytes=ux_u32(fog+Fog.nameBytes);
  let color=Color_getHex(fog+Fog.red,1);
  let near=ux_f64(fog+Fog.near);
  let far=ux_f64(fog+Fog.far);
  let kind=ux_u32_put(out+FogJson.kind,1);
  let name=ux_u32_put(out+FogJson.name,label);
  let size=ux_u32_put(out+FogJson.nameBytes,bytes);
  let hex=ux_u32_put(out+FogJson.color,color);
  let minimum=ux_f64_put(out+FogJson.near,near);
  let maximum=ux_f64_put(out+FogJson.far,far);
  return out;
}

native function Fog_factor(fog:i64,depth:f64) f64 {
  if(fog<0 || fog%8!=0 || fog>6291456-Fog.size) { return 0.0-1.0; }
  return GpuFog_linearFactor(depth,ux_f64(fog+Fog.near),ux_f64(fog+Fog.far));
}
