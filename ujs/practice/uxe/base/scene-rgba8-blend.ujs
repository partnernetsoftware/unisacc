// Composite straight RGBA8 colors in source-over order.
native function SceneRaster_sourceOver(destination:i64,source:i64) i64 {
  if(destination<0 || destination>4294967295 || source<0 || source>4294967295) { return 0-1; }
  let sa=source/16777216;
  let da=destination/16777216;
  if(sa==0) { return destination; }
  if(sa==255 || da==0) { return source; }
  let sw=sa*255;
  let dw=da*(255-sa);
  let weight=sw+dw;
  let result=((weight+127)/255)*16777216;
  let channel=1;
  while(channel<16777216) {
    let sc=(source/channel)%256;
    let dc=(destination/channel)%256;
    let value=(sc*sw+dc*dw+weight/2)/weight;
    result=result+value*channel;
    channel=channel*256;
  }
  return result;
}

