struct ComposerViewport {
  logicalWidth:u32;
  logicalHeight:u32;
  pixelRatio:f64;
}

// Apply CSS size and pixel ratio together, as a host resize transaction.
// GPU targets must be resized or recreated before drawing with the new size.
native function EffectComposer_setViewport(composer:i64,viewport:i64,width:i64,height:i64,ratio:f64) i64 {
  if(!composer_live(composer) || !composer_span(viewport,ComposerViewport.size) || viewport%8!=0 ||
     composer_alias(composer,EffectComposer.size,viewport,ComposerViewport.size) ||
     composer_alias(ux_u32(composer+EffectComposer.passes),ux_u32(composer+EffectComposer.capacity)*ComposerPass.size,
                    viewport,ComposerViewport.size) ||
     width<1 || width>65535 || height<1 || height>65535 || ratio<=0.0 || ratio-ratio!=0.0) { return 0-1; }
  let w=width*ratio;
  let h=height*ratio;
  if(w<1.0 || w>=65536.0 || h<1.0 || h>=65536.0) { return 0-1; }
  let effectiveW=f64_floor_i64(w);
  let effectiveH=f64_floor_i64(h);
  let changed=EffectComposer_resize(composer,effectiveW,effectiveH);
  if(changed<0) { return changed; }
  let a=ux_u32_put(viewport+ComposerViewport.logicalWidth,width);
  let b=ux_u32_put(viewport+ComposerViewport.logicalHeight,height);
  let c=ux_f64_put(viewport+ComposerViewport.pixelRatio,ratio);
  return changed;
}

// Read the current resize dimensions for a registered pass.
native function EffectComposer_passViewport(composer:i64,index:i64,axis:i64) i64 {
  if(!composer_live(composer) || index<0 || index>=ux_u32(composer+EffectComposer.count) ||
     (axis!=0 && axis!=1)) { return 0-1; }
  if(axis==0) { return ux_u32(composer+EffectComposer.width); }
  return ux_u32(composer+EffectComposer.height);
}
