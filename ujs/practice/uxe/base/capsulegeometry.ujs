// The scratch space holds the two quarter arcs consumed by LatheGeometry.
native function CapsuleGeometry_generate(capsule:i64,scratch:i64,radius:f64,length:f64,
                                          cap_segments:i64,radial_segments:i64) i64 {
  if(cap_segments<1 || cap_segments>131071 || scratch<0 || scratch%8!=0 ||
     scratch>6291456 || 2*(2*cap_segments+1)>(6291456-scratch)/16) { return 0-1; }
  let arcs=2*cap_segments;
  let side=0;
  while(side<2) {
    let arc_point=0;
    while(arc_point<=arcs) {
      let angle=(arc_point*1.0/arcs+side-1.0)*1.5707963267948966;
      let point=scratch+(side*(arcs+1)+arc_point)*16;
      let r=ux_f64_put(point,radius*ux_math_cos(angle));
      let y=ux_f64_put(point+8,radius*ux_math_sin(angle)+(side-0.5)*length);
      arc_point=arc_point+1;
    }
    side=side+1;
  }
  return LatheGeometry_generate(capsule,scratch,2*(arcs+1),radial_segments,0.0,6.283185307179586);
}
