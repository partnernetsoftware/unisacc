struct OrthographicCamera {
  left: f64;
  right: f64;
  top: f64;
  bottom: f64;
  near: f64;
  far: f64;
  zoom: f64;
  viewFullWidth: f64;
  viewFullHeight: f64;
  viewX: f64;
  viewY: f64;
  viewWidth: f64;
  viewHeight: f64;
  viewEnabled: u32;
}

function OrthographicCamera_init(ortho,...ortho_args) {
  let left=ux_f64_put(ortho+OrthographicCamera.left,ortho_args[0]);
  let right=ux_f64_put(ortho+OrthographicCamera.right,ortho_args[1]);
  let top=ux_f64_put(ortho+OrthographicCamera.top,ortho_args[2]);
  let bottom=ux_f64_put(ortho+OrthographicCamera.bottom,ortho_args[3]);
  let near=ux_f64_put(ortho+OrthographicCamera.near,ortho_args[4]);
  let far=ux_f64_put(ortho+OrthographicCamera.far,ortho_args[5]);
  let zoom=ux_f64_put(ortho+OrthographicCamera.zoom,1.0);
  let view=ux_u32_put(ortho+OrthographicCamera.viewEnabled,0);
  return ortho;
}

function OrthographicCamera_setViewOffset(ortho_view,...ortho_view_args) {
  let full_w=ux_f64_put(ortho_view+OrthographicCamera.viewFullWidth,ortho_view_args[0]);
  let full_h=ux_f64_put(ortho_view+OrthographicCamera.viewFullHeight,ortho_view_args[1]);
  let x=ux_f64_put(ortho_view+OrthographicCamera.viewX,ortho_view_args[2]);
  let y=ux_f64_put(ortho_view+OrthographicCamera.viewY,ortho_view_args[3]);
  let w=ux_f64_put(ortho_view+OrthographicCamera.viewWidth,ortho_view_args[4]);
  let h=ux_f64_put(ortho_view+OrthographicCamera.viewHeight,ortho_view_args[5]);
  let enabled=ux_u32_put(ortho_view+OrthographicCamera.viewEnabled,1);
  return ortho_view;
}

function OrthographicCamera_clearViewOffset(ortho_clear) {
  let disabled=ux_u32_put(ortho_clear+OrthographicCamera.viewEnabled,0);
  return ortho_clear;
}

native function ortho_project(ortho_lens:i64,camera:i64) i64 {
  let left=ux_f64(ortho_lens+OrthographicCamera.left);
  let right=ux_f64(ortho_lens+OrthographicCamera.right);
  let top=ux_f64(ortho_lens+OrthographicCamera.top);
  let bottom=ux_f64(ortho_lens+OrthographicCamera.bottom);
  let zoom=ux_f64(ortho_lens+OrthographicCamera.zoom);
  let near=ux_f64(ortho_lens+OrthographicCamera.near);
  let far=ux_f64(ortho_lens+OrthographicCamera.far);
  if(zoom<=0.0 || far<=near || left==right || top==bottom) { return 0-1; }
  let half_width=(right-left)/(2.0*zoom);
  let half_height=(top-bottom)/(2.0*zoom);
  let cx=(left+right)*0.5;
  let cy=(top+bottom)*0.5;
  left=cx-half_width;
  right=cx+half_width;
  top=cy+half_height;
  bottom=cy-half_height;
  if(ux_u32(ortho_lens+OrthographicCamera.viewEnabled)!=0) {
    let full_w=ux_f64(ortho_lens+OrthographicCamera.viewFullWidth);
    let full_h=ux_f64(ortho_lens+OrthographicCamera.viewFullHeight);
    let w=ux_f64(ortho_lens+OrthographicCamera.viewWidth);
    let h=ux_f64(ortho_lens+OrthographicCamera.viewHeight);
    if(full_w<=0.0 || full_h<=0.0 || w<=0.0 || h<=0.0) { return 0-1; }
    let unit_x=2.0*half_width/full_w;
    let unit_y=2.0*half_height/full_h;
    left=left+unit_x*ux_f64(ortho_lens+OrthographicCamera.viewX);
    right=left+unit_x*w;
    top=top-unit_y*ux_f64(ortho_lens+OrthographicCamera.viewY);
    bottom=top-unit_y*h;
  }
  let projection=Matrix4_makeOrthographic(ux_u32(camera+Camera.projectionMatrix),
    left,right,top,bottom,near,far,ux_u32(camera+Camera.coordinateSystem)*1.0);
  if(projection<0) { return projection; }
  return Camera_updateProjectionInverse(camera);
}

function OrthographicCamera_updateProjectionMatrix(projection_lens,...projection_args) {
  return ortho_project(projection_lens,projection_args[0]);
}
