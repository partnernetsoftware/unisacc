// Pack short ASCII wire tags without allocating string storage.
native function gpu_color_tag(at:i64,length:i64) i64 {
  if(at<0 || length<1 || length>6 || at>6291456-length) { return 0-1; }
  let i=0;
  let factor=1;
  let code=0;
  while(i<length) {
    let byte=ux_u8(at+i);
    if(byte<32 || byte>126) { return 0-1; }
    code=code+byte*factor;
    factor=factor*256;
    i=i+1;
  }
  return code;
}

native function gpu_color_record_valid(at:i64) i64 {
  return at>=0 && at%8==0 && at<=6291456-24;
}
