native function curve_line_point(dst:i64,ends:i64,dimensions:i64,t:f64) i64 {
  let axis=0;
  while(axis<dimensions) {
    let a=ux_f64(ends+axis*8);
    let b=ux_f64(ends+(axis+dimensions)*8);
    let value=a+(b-a)*t;
    if(t==1.0) { value=b; }
    let written=ux_f64_put(dst+axis*8,value);
    axis=axis+1;
  }
  return dst;
}

native function curve_line_length(ends:i64,dimensions:i64) f64 {
  let axis=0;
  let sum=0.0;
  while(axis<dimensions) {
    let delta=ux_f64(ends+(axis+dimensions)*8)-ux_f64(ends+axis*8);
    sum=sum+delta*delta;
    axis=axis+1;
  }
  return f64_sqrt(sum);
}

native function curve_line_tangent(dst:i64,ends:i64,dimensions:i64) i64 {
  let distance=curve_line_length(ends,dimensions);
  if(distance==0.0) { distance=1.0; }
  let axis=0;
  while(axis<dimensions) {
    let delta=ux_f64(ends+(axis+dimensions)*8)-ux_f64(ends+axis*8);
    let written=ux_f64_put(dst+axis*8,delta/distance);
    axis=axis+1;
  }
  return dst;
}
