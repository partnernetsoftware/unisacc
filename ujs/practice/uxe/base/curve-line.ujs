native function curve_line_point(dst:i64,ends:i64,dimensions:i64,t:f64) i64 {
  let axis=0;
  while(axis<dimensions) {
    let a=ux_f64(ends+axis*8);
    let b=ux_f64(ends+(axis+dimensions)*8);
    let value=a+(b-a)*t;
    if(t==1.0) { value=b; }
    let written=ux_f64_put(dst+axis*8,value);
    axis=axis+1;
  }
  return dst;
}

native function curve_line_length(ends:i64,dimensions:i64) f64 {
  let axis=0;
  let sum=0.0;
  while(axis<dimensions) {
    let delta=ux_f64(ends+(axis+dimensions)*8)-ux_f64(ends+axis*8);
    sum=sum+delta*delta;
    axis=axis+1;
  }
  return f64_sqrt(sum);
}

native function curve_line_tangent(dst:i64,ends:i64,dimensions:i64) i64 {
  let distance=curve_line_length(ends,dimensions);
  if(distance==0.0) { distance=1.0; }
  let axis=0;
  while(axis<dimensions) {
    let delta=ux_f64(ends+(axis+dimensions)*8)-ux_f64(ends+axis*8);
    let written=ux_f64_put(dst+axis*8,delta/distance);
    axis=axis+1;
  }
  return dst;
}

native function curve_line_collect(out:i64,ends:i64,steps:i64,dims:i64) i64 {
  let stride=dims*8;
  if(out<0 || out>6291456 || out%8!=0 || ends<0 || ends>6291456-2*stride || ends%8!=0 ||
     steps<=0 || steps>=(6291456-out)/stride ||
     (out<ends+2*stride && ends<out+(steps+1)*stride)) { return 0-1; }
  let i=0;
  while(i<=steps) {
    let point=curve_line_point(out+i*stride,ends,dims,i*1.0/steps);
    i=i+1;
  }
  return i;
}

native function curve_line_lengths(out:i64,ends:i64,steps:i64,dims:i64) i64 {
  if(out<0 || out>6291456 || out%8!=0 || ends<0 || ends>6291456-16*dims || ends%8!=0 ||
     steps<=0 || steps>=(6291456-out)/8 ||
     (out<ends+16*dims && ends<out+(steps+1)*8)) { return 0-1; }
  let total=curve_line_length(ends,dims);
  let i=0;
  while(i<=steps) {
    let at=ux_f64_put(out+8*i,total*i/steps);
    i=i+1;
  }
  return out;
}
