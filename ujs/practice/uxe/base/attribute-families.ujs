// Typed constructors bind the component representation of a caller-owned view.
function Uint8BufferAttribute_init(a1_dst,...a1_args) {
  return BufferAttribute_init(a1_dst,a1_args[0],a1_args[1],a1_args[2],1,a1_args[3]);
}

