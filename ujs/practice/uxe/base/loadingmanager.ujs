struct LoadingManager {
  total: u32;
  loaded: u32;
}

struct LoadingEvent {
  kind: u32;
  request: u32;
  loaded: u32;
  total: u32;
}

native function loading_span(at:i64,bytes:i64) i64 {
  return at>=0 && at%4==0 && bytes>=0 && at<=6291456-bytes;
}

native function LoadingManager_init(at:i64) i64 {
  if(!loading_span(at,LoadingManager.size)) { return 0-1; }
  let a=ux_u32_put(at+LoadingManager.total,0);
  let b=ux_u32_put(at+LoadingManager.loaded,0);
  return at;
}

native function loading_event(out:i64,kind:i64,request:i64,loaded:i64,total:i64) i64 {
  let a=ux_u32_put(out+LoadingEvent.kind,kind);
  let b=ux_u32_put(out+LoadingEvent.request,request);
  let c=ux_u32_put(out+LoadingEvent.loaded,loaded);
  let d=ux_u32_put(out+LoadingEvent.total,total);
  return out;
}

// Operations 1, 2 and 3 are start, end and error. The output holds up to
// two events: start, progress, error, and load (kinds 1 through 4).
native function LoadingManager_item(at:i64,op:i64,request:i64,out:i64) i64 {
  if(!loading_span(at,LoadingManager.size) || !loading_span(out,2*LoadingEvent.size) ||
     (at<out+2*LoadingEvent.size && out<at+LoadingManager.size) ||
     op<1 || op>3 || request<1 || request>4294967295) { return 0-1; }
  let total=ux_u32(at+LoadingManager.total);
  let loaded=ux_u32(at+LoadingManager.loaded);
  if(loaded>total) { return 0-1; }
  if(op==1) {
    if(total==4294967295) { return 0-2; }
    let count=ux_u32_put(at+LoadingManager.total,total+1);
    if(loaded==total) { let event=loading_event(out,1,request,loaded,total+1); return 1; }
    return 0;
  }
  if(op==3) { let error=loading_event(out,3,request,loaded,total); return 1; }
  if(loaded==total) { return 0-2; }
  loaded=loaded+1;
  let count=ux_u32_put(at+LoadingManager.loaded,loaded);
  let progress=loading_event(out,2,request,loaded,total);
  if(loaded==total) { let done=loading_event(out+LoadingEvent.size,4,0,loaded,total); return 2; }
  return 1;
}
