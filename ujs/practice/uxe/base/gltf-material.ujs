struct GltfMaterial {
  red: f64;
  green: f64;
  blue: f64;
  alpha: f64;
  metalness: f64;
  roughness: f64;
  cutoff: f64;
  alphaMode: u32;
  doubleSided: u32;
}

native function gltf_factor(value:f64) i64 {
  return value-value==0.0 && value>=0.0 && value<=1.0;
}

native function gltf_alpha_mode(at:i64,end:i64) i64 {
  if(at==0-2) { return 0; }
  let close=json_scan_string(at,end);
  if(close<0) { return 0-1; }
  if(close-at==8 && ux_u32(at+1)==1363234895 && ux_u8(at+5)==85 && ux_u8(at+6)==69) { return 0; }
  if(close-at==6 && ux_u32(at+1)==1263747405) { return 1; }
  if(close-at==7 && ux_u32(at+1)==1313164354 && ux_u8(at+5)==68) { return 2; }
  return 0-1;
}

native function GltfLoader_material(glb:i64,index:i64,out:i64,key:i64) i64 {
  if(!loading_span(glb,GlbResource.size) || !loading_span(out,GltfMaterial.size) || out%8!=0 ||
     !loading_span(key,20) || !file_disjoint(glb,GlbResource.size,key,20) ||
     !file_disjoint(glb,GlbResource.size,out,GltfMaterial.size) ||
     !file_disjoint(out,GltfMaterial.size,key,20)) { return 0-1; }
  let json=ux_u32(glb+GlbResource.json);
  let bytes=ux_u32(glb+GlbResource.jsonBytes);
  let bin=ux_u32(glb+GlbResource.bin);
  let binBytes=ux_u32(glb+GlbResource.binBytes);
  if(json>6291456-bytes || bin>6291456-binBytes || !file_disjoint(json,bytes,key,20) ||
     !file_disjoint(json,bytes,out,GltfMaterial.size) || !file_disjoint(bin,binBytes,key,20) ||
     !file_disjoint(bin,binBytes,out,GltfMaterial.size)) { return 0-1; }
  let end=json+bytes;
  let rows=LoaderJson_find(json,end,key,1702125933,1818323314,115,9);
  let item=LoaderJson_item(rows,end,index);
  if(item<0 || ux_u8(item)!=123) { return 0-2; }
  let tail=ux_u32_put(key+12,1751610735);
  let tail2=ux_u32_put(key+16,1936942446);
  let pbr=LoaderJson_find(item,end,key,1299341936,1818326117,1382246764,20);
  let r=1.0;
  let g=1.0;
  let b=1.0;
  let a=1.0;
  let metal=1.0;
  let rough=1.0;
  if(pbr!=0-2) {
    if(pbr<0 || ux_u8(pbr)!=123) { return 0-3; }
    let t=ux_u32_put(key+12,7499636);
    let color=LoaderJson_find(pbr,end,key,1702060386,1869377347,1667319410,15);
    if(color!=0-2) {
      let c0=LoaderJson_item(color,end,0);
      let c1=LoaderJson_item(color,end,1);
      let c2=LoaderJson_item(color,end,2);
      let c3=LoaderJson_item(color,end,3);
      if(c0<0 || c1<0 || c2<0 || c3<0 || LoaderJson_item(color,end,4)>=0) { return 0-3; }
      r=json_read_number(c0,end);
      g=json_read_number(c1,end);
      b=json_read_number(c2,end);
      a=json_read_number(c3,end);
    }
    let m=ux_u32_put(key+12,29295);
    metal=LoaderJson_number(LoaderJson_find(pbr,end,key,1635018093,1667853420,1952670022,14),end,1.0);
    let q=ux_u32_put(key+12,7499636);
    rough=LoaderJson_number(LoaderJson_find(pbr,end,key,1735749490,1936027240,1667319411,15),end,1.0);
  }
  let mode=gltf_alpha_mode(LoaderJson_find(item,end,key,1752198241,1685015905,101,9),end);
  let cutoff=LoaderJson_number(LoaderJson_find(item,end,key,1752198241,1953842017,6710895,11),end,0.5);
  let side=LoaderJson_find(item,end,key,1651863396,1767073132,6579556,11);
  let both=0;
  if(side!=0-2) {
    if(side<0 || (ux_u8(side)!=116 && ux_u8(side)!=102)) { return 0-3; }
    both=ux_u8(side)==116;
  }
  if(mode<0 || !gltf_factor(r) || !gltf_factor(g) || !gltf_factor(b) || !gltf_factor(a) ||
     !gltf_factor(metal) || !gltf_factor(rough) || cutoff-cutoff!=0.0 || cutoff<0.0) { return 0-3; }
  let w0=ux_f64_put(out+GltfMaterial.red,r);
  let w1=ux_f64_put(out+GltfMaterial.green,g);
  let w2=ux_f64_put(out+GltfMaterial.blue,b);
  let w3=ux_f64_put(out+GltfMaterial.alpha,a);
  let w4=ux_f64_put(out+GltfMaterial.metalness,metal);
  let w5=ux_f64_put(out+GltfMaterial.roughness,rough);
  let w6=ux_f64_put(out+GltfMaterial.cutoff,cutoff);
  let w7=ux_u32_put(out+GltfMaterial.alphaMode,mode);
  let w8=ux_u32_put(out+GltfMaterial.doubleSided,both);
  return out;
}
