struct ArrowHelperPose {
  qx: f64;
  qy: f64;
  qz: f64;
  qw: f64;
  shaftScaleY: f64;
  headPositionY: f64;
  headScaleY: f64;
  headScaleXZ: f64;
}

native function arrow_pose_valid(pose:i64) i64 {
  return pose>=0 && pose%8==0 && pose<=6291456-ArrowHelperPose.size;
}

// Match r160's normalized-direction contract and pole conventions.
native function ArrowHelper_setDirection(pose:i64,x:f64,y:f64,z:f64) i64 {
  if(!arrow_pose_valid(pose) || x-x!=0.0 || y-y!=0.0 || z-z!=0.0 || y<0.0-1.0 || y>1.0) { return 0-1; }
  let qx=0.0;
  let qz=0.0;
  let qw=1.0;
  if(y<0.0-0.99999) {
    qx=1.0;
    qw=0.0;
  } else if(y<=0.99999) {
    let horizontal=f64_sqrt(x*x+z*z);
    if(horizontal==0.0 || horizontal-horizontal!=0.0) { return 0-1; }
    let s=f64_sqrt((1.0-y)*0.5)/horizontal;
    qx=z*s;
    qz=0.0-x*s;
    qw=f64_sqrt((1.0+y)*0.5);
  }
  let a=ux_f64_put(pose+ArrowHelperPose.qx,qx);
  let b=ux_f64_put(pose+ArrowHelperPose.qy,0.0);
  let c=ux_f64_put(pose+ArrowHelperPose.qz,qz);
  let d=ux_f64_put(pose+ArrowHelperPose.qw,qw);
  return pose;
}

native function ArrowHelper_setLength(pose:i64,length:f64,head:f64,width:f64) i64 {
  if(!arrow_pose_valid(pose) || length-length!=0.0 || head-head!=0.0 || width-width!=0.0) { return 0-1; }
  let shaft=length-head;
  if(shaft-shaft!=0.0) { return 0-1; }
  if(shaft<0.0001) { shaft=0.0001; }
  let a=ux_f64_put(pose+ArrowHelperPose.shaftScaleY,shaft);
  let b=ux_f64_put(pose+ArrowHelperPose.headPositionY,length);
  let c=ux_f64_put(pose+ArrowHelperPose.headScaleY,head);
  let d=ux_f64_put(pose+ArrowHelperPose.headScaleXZ,width);
  return pose;
}

native function ArrowHelper_setDefaultLength(pose:i64,length:f64) i64 {
  let head=length*0.2;
  return ArrowHelper_setLength(pose,length,head,head*0.2);
}
