// Three hundred and forty-four bytes of caller-owned working storage.
native function OctahedronGeometry_generate(mesh:i64,work:i64,radius:f64,detail:i64) i64 {
  if(work<0 || work>6291456-344 || work%8!=0) { return 0-1; }
  let positions=work+32;
  let indices=work+176;
  let vertex=0;
  while(vertex<6) {
    let axis=0;
    while(axis<3) {
      let value=0.0;
      if(axis==vertex/2) { value=1.0-2.0*(vertex%2); }
      let written=ux_f64_put(positions+vertex*24+axis*8,value);
      axis=axis+1;
    }
    vertex=vertex+1;
  }
  let face=0;
  while(face<8) {
    let ring=face%4;
    let start=2+ring/2+2*(ring%2);
    if(ring==2) { start=3; }
    if(ring==3) { start=5; }
    let end=4;
    if(ring==1) { end=3; }
    if(ring==2) { end=5; }
    if(ring==3) { end=2; }
    if(face>=4) {
      if(start>=4) { start=9-start; }
      if(end>=4) { end=9-end; }
    }
    let ptr=indices+face*12;
    let a=ux_u32_put(ptr,face/4);
    let b=ux_u32_put(ptr+4,start);
    let c=ux_u32_put(ptr+8,end);
    face=face+1;
  }
  let config=PolyhedronGeometry_init(work,positions,6,indices,24,work+272);
  return PolyhedronGeometry_generate(mesh,config,radius,detail);
}
