native function png_overlap(a:i64,bytes:i64,b:i64,size:i64) i64 {
  return bytes>0 && size>0 && a<b+size && b<a+bytes;
}

native function png_idat(src:i64,bytes:i64,out:i64,capacity:i64,color:i64,depth:i64,palette:i64) i64 {
  let chunk=33;
  let written=0;
  let closed=0;
  let seen=0;
  if(color==3) {
    let a=ux_u32_put(palette,0);
    let b=ux_u32_put(palette+4,0);
    let c=ux_u32_put(palette+8,0);
    let d=ux_u32_put(palette+12,0);
  }
  while(chunk<=bytes-12) {
    let at=src+chunk;
    let length=png_u32be(at);
    if(length>bytes-chunk-12) { return 0-5; }
    let kind=png_u32be(at+4);
    if(png_crc32(at+4,4+length)!=png_u32be(at+8+length)) { return 0-3; }
    if(color==2 && kind==1951551059) { return 0-4; }
    if(kind==1229278788) {
      if(length!=0 || chunk+12!=bytes || written==0) { return 0-5; }
      return written;
    }
    if(kind==1229209940) {
      if(closed!=0 || length>capacity-written || (color==3 && ux_u32(palette)==0)) { return 0-5; }
      let copied=uxe_copy_record(out+written,at+8,length);
      written=written+length;
      seen=1;
    } else {
      if(seen!=0) { closed=1; }
      if(kind==1347179589) {
        if(seen!=0 || length<3 || length>768 || length%3!=0) { return 0-5; }
        if(color==3) {
          if(ux_u32(palette)!=0 || length/3>u32_shl(1,depth)) { return 0-5; }
          let entries=ux_u32_put(palette,at+8);
          let count=ux_u32_put(palette+4,length/3);
        }
      } else if(color==3 && kind==1951551059) {
        if(seen!=0 || ux_u32(palette)==0 || ux_u32(palette+8)!=0 || length<1 || length>ux_u32(palette+4)) { return 0-5; }
        let alpha=ux_u32_put(palette+8,at+8);
        let count=ux_u32_put(palette+12,length);
      } else if(ux_u8(at+4)/32%2==0) { return 0-5; }
    }
    chunk=chunk+12+length;
  }
  return 0-5;
}

native function png_palette_index(row:i64,x:i64,depth:i64) i64 {
  let bit=x*depth;
  return u32_shr(ux_u8(row+bit/8),8-depth-bit%8)%u32_shl(1,depth);
}

native function png_palette_check(raw:i64,row:i64,width:i64,height:i64,depth:i64,count:i64) i64 {
  let y=0;
  while(y<height) {
    let from=raw+y*(row+1)+1;
    let x=0;
    while(x<width) {
      if(png_palette_index(from,x,depth)>=count) { return 0-5; }
      x=x+1;
    }
    y=y+1;
  }
  return 0;
}

native function png_palette_pixel(dst:i64,index:i64,palette:i64) i64 {
  let colors=ux_u32(palette);
  let alpha=ux_u32(palette+8);
  let rgb=uxe_copy_record(dst,colors+index*3,3);
  let opacity=255;
  if(index<ux_u32(palette+12)) { opacity=ux_u8(alpha+index); }
  return ux_u8_put(dst+3,opacity);
}

native function png_palette_rows(raw:i64,row:i64,width:i64,height:i64,depth:i64,palette:i64,out:i64) i64 {
  let valid=png_palette_check(raw,row,width,height,depth,ux_u32(palette+4));
  if(valid<0) { return valid; }
  let y=0;
  while(y<height) {
    let from=raw+y*(row+1)+1;
    let x=0;
    while(x<width) {
      let index=png_palette_index(from,x,depth);
      let dst=out+4*(y*width+x);
      let saved=png_palette_pixel(dst,index,palette);
      x=x+1;
    }
    y=y+1;
  }
  return width*height*4;
}

native function png_adam_publish(raw:i64,plan:i64,out:i64,width:i64,depth:i64,channels:i64,palette:i64) i64 {
  let i=0;
  if(channels==1) {
    while(i<7) {
      let pass=plan+i*PngPass.size;
      let valid=png_palette_check(raw+ux_u32(pass+PngPass.offset),ux_u32(pass+PngPass.stride),
        ux_u32(pass+PngPass.columns),ux_u32(pass+PngPass.rows),depth,ux_u32(palette+4));
      if(valid<0) { return valid; }
      i=i+1;
    }
  }
  i=0;
  while(i<7) {
    let pass=plan+i*PngPass.size;
    let bytes=ux_u32(pass+PngPass.stride);
    let rows=ux_u32(pass+PngPass.rows);
    let cols=ux_u32(pass+PngPass.columns);
    let first=raw+ux_u32(pass+PngPass.offset)+1;
    let x0=ux_u32(pass+PngPass.x);
    let y0=ux_u32(pass+PngPass.y);
    let dx=ux_u32(pass+PngPass.dx);
    let dy=ux_u32(pass+PngPass.dy);
    let y=0;
    while(y<rows) {
      let from=first+y*(bytes+1);
      let dst=out+4*((y0+y*dy)*width+x0);
      let x=0;
      while(x<cols) {
        let to=dst+x*dx*4;
        if(channels==1) {
          let pixel=png_palette_pixel(to,png_palette_index(from,x,depth),palette);
        } else {
          let color=uxe_copy_record(to,from+x*channels,channels);
          if(channels==3) { let alpha=ux_u8_put(to+3,255); }
        }
        x=x+1;
      }
      y=y+1;
    }
    i=i+1;
  }
  return 0;
}

native function png_inflate(src:i64,bytes:i64,out:i64,size:i64,huffman:i64,workspace:i64) i64 {
  if(bytes<8) { return 0-6; }
  let cmf=ux_u8(src);
  let flags=ux_u8(src+1);
  if(cmf%16!=8 || cmf/16>7 || (cmf*256+flags)%31!=0 || flags/32%2!=0) { return 0-6; }
  let bit=16;
  let limit=(bytes-4)*8;
  let output=0;
  let last=0;
  while(last==0) {
    let block=png_bits(src,limit,bit,3,0);
    if(block<0) { return 0-6; }
    bit=bit+3;
    last=block%2;
    if((block/2==1 || block/2==2) && huffman!=0) {
      let literals=0-1;
      let distances=0-1;
      if(block/2==2) {
        if(workspace<0) { return 0-1; }
        bit=png_dynamic_tables(src,limit,bit,workspace);
        if(bit<0) { return bit; }
        literals=workspace+320;
        distances=literals+1344;
      }
      let done=png_code_block(src,limit,bit,out,size,output,literals,distances);
      if(done<0) { return done; }
      bit=done/8388608;
      output=done%8388608;
    } else {
      if(block/2!=0) { return 0-7; }
      let input=(bit+7)/8;
      if(input>bytes-8) { return 0-6; }
      let length=ux_u8(src+input)+256*ux_u8(src+input+1);
      let inverse=ux_u8(src+input+2)+256*ux_u8(src+input+3);
      input=input+4;
      if(length+inverse!=65535 || length>bytes-4-input || length>size-output) { return 0-6; }
      let copied=uxe_copy_record(out+output,src+input,length);
      bit=(input+length)*8;
      output=output+length;
    }
  }
  if((bit+7)/8!=bytes-4 || output!=size) { return 0-6; }
  let s1=1;
  let s2=0;
  let i=0;
  while(i<output) {
    s1=(s1+ux_u8(out+i))%65521;
    s2=(s2+s1)%65521;
    i=i+1;
  }
  if(png_u32be(src+bytes-4)!=s2*65536+s1) { return 0-6; }
  return output;
}

// Decode RGBA8, RGB8 or indexed PNG to RGBA8. Scratch is
// exclusive and may change on error. The RGBA output is published last.
native function png_decode(src:i64,bytes:i64,out:i64,cap:i64,scratch:i64,space:i64,huffman:i64) i64 {
  if(src<0 || bytes<33 || bytes>4194304 || src>6291456-bytes || out<0 || cap<0 || out>6291456-cap ||
     scratch<0 || scratch%4!=0 || space<PngHeader.size || scratch>6291456-space ||
     png_overlap(src,bytes,out,cap) || png_overlap(src,bytes,scratch,space) || png_overlap(out,cap,scratch,space)) { return 0-1; }
  let header=PngHeader_probe(src,bytes,scratch);
  if(header<0) { return header; }
  let color=ux_u32(header+PngHeader.color);
  let depth=ux_u32(header+PngHeader.depth);
  let indexed=color==3 && huffman!=0;
  let interlace=ux_u32(header+PngHeader.interlace);
  if((!indexed && (depth!=8 || (color!=6 && (color!=2 || huffman==0)))) || (interlace!=0 && huffman==0)) { return 0-4; }
  let channels=4;
  if(color==2) { channels=3; }
  if(indexed) { channels=1; }
  let width=ux_u32(header+PngHeader.width);
  let row=width*channels;
  let prefix=PngHeader.size;
  if(indexed) { row=(width*depth+7)/8; prefix=prefix+16; }
  let rgbaRow=width*4;
  let height=ux_u32(header+PngHeader.height);
  let plan=scratch+prefix;
  if(interlace!=0) { prefix=prefix+7*PngPass.size; }
  if(space<prefix || height>cap/rgbaRow) { return 0-1; }
  let raw=scratch+prefix;
  let size=height*(row+1);
  if(interlace!=0) { size=png_adam_plan(plan,width,height,depth*channels); }
  if(size>space-prefix) { return 0-1; }
  let compressed=raw+size;
  let palette=scratch+PngHeader.size;
  let packed=png_idat(src,bytes,compressed,space-prefix-size,color,depth,palette);
  if(packed<0) { return packed; }
  let workspace=(compressed+packed+3)/4*4;
  if(workspace>scratch+space-3008) { workspace=0-1; }
  let made=png_inflate(compressed,packed,raw,size,huffman,workspace);
  if(made<0) { return made; }
  if(interlace!=0) {
    let restored=png_adam_restore(raw,plan,channels);
    if(restored<0) { return restored; }
    let published=png_adam_publish(raw,plan,out,width,depth,channels,palette);
    if(published<0) { return published; }
    return height*rgbaRow;
  }
  let restored=PngScanlines_restore(raw,size,row,height,channels);
  if(restored<0) { return restored; }
  if(indexed) { return png_palette_rows(raw,row,width,height,depth,palette,out); }
  let y=0;
  while(y<height) {
    let from=raw+y*(row+1)+1;
    let to=out+y*rgbaRow;
    if(channels==4) { let copied=uxe_copy_record(to,from,row); }
    else {
      let x=0;
      while(x<width) {
        let copy=uxe_copy_record(to+x*4,from+x*3,3);
        let alpha=ux_u8_put(to+x*4+3,255);
        x=x+1;
      }
    }
    y=y+1;
  }
  return height*rgbaRow;
}

native function PngDecode_stored(src:i64,bytes:i64,out:i64,cap:i64,scratch:i64,space:i64) i64 {
  return png_decode(src,bytes,out,cap,scratch,space,0);
}

native function PngDecode_rgba8(src:i64,bytes:i64,out:i64,cap:i64,scratch:i64,space:i64) i64 {
  return png_decode(src,bytes,out,cap,scratch,space,1);
}
