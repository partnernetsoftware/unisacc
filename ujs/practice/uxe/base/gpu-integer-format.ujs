// Read an unsigned integer sampler component from a tightly packed U16 image.
native function gpu_integer_component(channels:i64,image:i64,width:i64,height:i64,u:f64,v:f64,component:i64) i64 {
  if(component<0 || component>3 || image%2!=0) { return 0-1; }
  let address=gpu_texture_texel(image,width,height,u,v,channels*2);
  if(address<0) { return address; }
  if(component>=channels) {
    if(component==3) { return 1; }
    return 0;
  }
  let offset=address+2*component;
  return ux_u8(offset)+256*ux_u8(offset+1);
}
