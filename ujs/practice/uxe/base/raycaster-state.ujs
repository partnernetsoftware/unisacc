// The first 48 bytes share Ray's binary layout.
struct RaycasterState {
  ox: f64;
  oy: f64;
  oz: f64;
  dx: f64;
  dy: f64;
  dz: f64;
  near: f64;
  far: f64;
  layerMask: u32;
  lineThreshold: f64;
  pointThreshold: f64;
}

native function raycaster_finite_vector(vector:i64) i64 {
  let x=ux_f64(vector);
  let y=ux_f64(vector+8);
  let z=ux_f64(vector+16);
  return x-x==0.0 && y-y==0.0 && z-z==0.0;
}

native function Raycaster_set(state:i64,origin:i64,direction:i64) i64 {
  if(!raycaster_span(state,RaycasterState.size) || !raycaster_span(origin,24) || !raycaster_span(direction,24) ||
     !raycaster_finite_vector(origin) || !raycaster_finite_vector(direction)) { return 0-1; }
  return Ray_set(state,origin,direction);
}

native function raycaster_init_params(state:i64,near:f64,far:f64) i64 {
  let n=ux_f64_put(state+RaycasterState.near,near);
  let f=ux_f64_put(state+RaycasterState.far,far);
  let layers=ux_u32_put(state+RaycasterState.layerMask,1);
  let line=ux_f64_put(state+RaycasterState.lineThreshold,1.0);
  let points=ux_f64_put(state+RaycasterState.pointThreshold,1.0);
  return state;
}

native function Raycaster_init(state:i64,origin:i64,direction:i64,near:f64,far:f64) i64 {
  if(near<0.0 || near-near!=0.0 || far!=far || far<near) { return 0-1; }
  let valid=Raycaster_set(state,origin,direction);
  if(valid<0) { return valid; }
  return raycaster_init_params(state,near,far);
}

native function Raycaster_default(state:i64) i64 {
  if(!raycaster_span(state,RaycasterState.size)) { return 0-1; }
  let origin=Vector3_set(state,0.0,0.0,0.0);
  let direction=Vector3_set(state+24,0.0,0.0,0.0-1.0);
  return raycaster_init_params(state,0.0,1.0/0.0);
}
