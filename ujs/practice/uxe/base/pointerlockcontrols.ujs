struct PointerLockControls {
  x: f64;
  y: f64;
  z: f64;
  yaw: f64;
  pitch: f64;
  speed: f64;
  minPolar: f64;
  maxPolar: f64;
  locked: u32;
  lockEvents: u32;
  unlockEvents: u32;
  changeEvents: u32;
}

native function pointer_lock_valid(control:i64) i64 {
  return control>=0 && control%8==0 && control<=6291456-PointerLockControls.size;
}

native function PointerLockControls_init(control:i64,x:f64,y:f64,z:f64) i64 {
  if(!pointer_lock_valid(control) || x-x!=0.0 || y-y!=0.0 || z-z!=0.0) { return 0-1; }
  let a=ux_f64_put(control+PointerLockControls.x,x);
  let b=ux_f64_put(control+PointerLockControls.y,y);
  let c=ux_f64_put(control+PointerLockControls.z,z);
  let d=ux_f64_put(control+PointerLockControls.yaw,0.0);
  let e=ux_f64_put(control+PointerLockControls.pitch,0.0);
  let f=ux_f64_put(control+PointerLockControls.speed,1.0);
  let g=ux_f64_put(control+PointerLockControls.minPolar,0.0);
  let h=ux_f64_put(control+PointerLockControls.maxPolar,3.141592653589793);
  let i=ux_u32_put(control+PointerLockControls.locked,0);
  let j=ux_u32_put(control+PointerLockControls.lockEvents,0);
  let k=ux_u32_put(control+PointerLockControls.unlockEvents,0);
  let l=ux_u32_put(control+PointerLockControls.changeEvents,0);
  return control;
}

// A browser lock request is an effect in the host ABI. Only the confirmed
// pointerlockchange event changes the state consumed by the motion code.
native function PointerLockControls_hostState(control:i64,locked:i64) i64 {
  if(!pointer_lock_valid(control) || (locked!=0 && locked!=1)) { return 0-1; }
  let field=control+PointerLockControls.unlockEvents;
  if(locked==1) { field=control+PointerLockControls.lockEvents; }
  let a=ux_u32_put(field,u32_and(ux_u32(field)+1,4294967295));
  let b=ux_u32_put(control+PointerLockControls.locked,locked);
  return locked+1;
}

native function PointerLockControls_pointer(control:i64,x:f64,y:f64) i64 {
  if(!pointer_lock_valid(control) || x-x!=0.0 || y-y!=0.0) { return 0-1; }
  if(ux_u32(control+PointerLockControls.locked)==0) { return 0; }
  let speed=ux_f64(control+PointerLockControls.speed)*0.002;
  let yaw=ux_f64(control+PointerLockControls.yaw)-x*speed;
  let pitch=ux_f64(control+PointerLockControls.pitch)-y*speed;
  if(yaw!=yaw || yaw<0.0-1000000000.0 || yaw>1000000000.0 || pitch-pitch!=0.0) { return 0-1; }
  let half=1.5707963267948966;
  pitch=vector_limit(pitch,half-ux_f64(control+PointerLockControls.maxPolar),
    half-ux_f64(control+PointerLockControls.minPolar));
  yaw=yaw-6.283185307179586*f64_floor_i64((yaw+3.141592653589793)/6.283185307179586);
  let a=ux_f64_put(control+PointerLockControls.yaw,yaw);
  let b=ux_f64_put(control+PointerLockControls.pitch,pitch);
  let event=control+PointerLockControls.changeEvents;
  let c=ux_u32_put(event,u32_and(ux_u32(event)+1,4294967295));
  return 1;
}

native function PointerLockControls_direction(control:i64,out:i64) i64 {
  if(!pointer_lock_valid(control) || out<0 || out%8!=0 || out>6291456-24 ||
     (out<control+PointerLockControls.size && control<out+24)) { return 0-1; }
  let yaw=ux_f64(control+PointerLockControls.yaw);
  let pitch=ux_f64(control+PointerLockControls.pitch);
  let horizontal=ux_math_cos(pitch);
  let a=ux_f64_put(out,0.0-ux_math_sin(yaw)*horizontal);
  let b=ux_f64_put(out+8,ux_math_sin(pitch));
  let c=ux_f64_put(out+16,0.0-ux_math_cos(yaw)*horizontal);
  return out;
}

native function PointerLockControls_move(control:i64,forward:f64,right:f64) i64 {
  if(!pointer_lock_valid(control) || forward-forward!=0.0 || right-right!=0.0) { return 0-1; }
  let yaw=ux_f64(control+PointerLockControls.yaw);
  let s=ux_math_sin(yaw);
  let c=ux_math_cos(yaw);
  let x=ux_f64(control+PointerLockControls.x)+right*c-forward*s;
  let z=ux_f64(control+PointerLockControls.z)-right*s-forward*c;
  if(x-x!=0.0 || z-z!=0.0) { return 0-1; }
  let ax=ux_f64_put(control+PointerLockControls.x,x);
  let az=ux_f64_put(control+PointerLockControls.z,z);
  return control;
}
