// Six face offsets, each holding direction xyz followed by up xyz as f64.
native function cube_face_coordinates(faces:i64,coords:i64) i64 {
  if(faces<0 || faces>6291456-288 || faces%8!=0 ||
     (coords!=2000 && coords!=2001)) { return 0-1; }
  let face=0;
  while(face<6) {
    let axis=face/2;
    let positive=1.0-2.0*(face%2);
    let up_axis=1;
    let up_sign=1.0;
    if(axis==1) { up_axis=2; up_sign=0.0-positive; }
    if(coords==2001) {
      up_sign=0.0-up_sign;
      if(axis==0) { positive=0.0-positive; }
    }
    let component=0;
    while(component<3) {
      let direction=0.0;
      let up=0.0;
      if(component==axis) { direction=positive; }
      if(component==up_axis) { up=up_sign; }
      let destination=faces+face*48+component*8;
      let toward=ux_f64_put(destination,direction);
      let upward=ux_f64_put(destination+24,up);
      component=component+1;
    }
    face=face+1;
  }
  return faces;
}

function CubeCamera_updateCoordinateSystem(cube_faces,...cube_coordinate_args) {
  return cube_face_coordinates(cube_faces,cube_coordinate_args[0]);
}
