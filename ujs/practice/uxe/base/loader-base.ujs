// Each base's zeroed storage is one DefaultLoadingManager slot followed by
// one LoadingManager record. Constructors interpret -1 as the omitted manager.
// Explicit selection of the default record goes through the same lazy slot.
native function LoaderBase_size() i64 {
  return DefaultLoadingManager.size+LoadingManager.size;
}

native function LoaderBase_default(base:i64) i64 {
  if(!loading_span(base,LoaderBase_size())) { return 0-1; }
  return DefaultLoadingManager_get(base,base+DefaultLoadingManager.size);
}

native function loader_base_manager(owner:i64,bytes:i64,base:i64,manager:i64) i64 {
  let baseBytes=LoaderBase_size();
  if(!loading_span(owner,bytes) || !loading_span(base,baseBytes) ||
     (owner<base+baseBytes && base<owner+bytes)) { return 0-1; }
  if(manager==0-1 || manager==base+DefaultLoadingManager.size) { return LoaderBase_default(base); }
  if(!loading_span(manager,LoadingManager.size) ||
     (manager<base+baseBytes && base<manager+LoadingManager.size) ||
     (manager<owner+bytes && owner<manager+LoadingManager.size)) { return 0-1; }
  return manager;
}

native function Loader_initWithBase(loader:i64,base:i64,manager:i64) i64 {
  let selected=loader_base_manager(loader,Loader.size,base,manager);
  if(selected<0) { return selected; }
  return Loader_init(loader,selected);
}

native function FileLoader_initWithBase(file:i64,base:i64,manager:i64) i64 {
  let selected=loader_base_manager(file,FileLoader.size,base,manager);
  if(selected<0) { return selected; }
  return FileLoader_init(file,selected);
}

