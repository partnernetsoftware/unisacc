native function GpuTexture_nearestRgba8(address:i64,width:i64,height:i64,u:f64,v:f64) i64 {
  if(address<0 || width<1 || width>4096 || height<1 || height>4096 ||
     address>6291456-width*height*4 || u!=u || v!=v) { return 0-1; }
  let x=0;
  let y=0;
  if(u>=1.0) { x=width-1; }
  else if(u>0.0) { x=f64_floor_i64(u*width); }
  if(v>=1.0) { y=height-1; }
  else if(v>0.0) { y=f64_floor_i64(v*height); }
  let texel=address+(y*width+x)*4;
  return ux_u8(texel)+256*ux_u8(texel+1)+65536*ux_u8(texel+2)+16777216*ux_u8(texel+3);
}
