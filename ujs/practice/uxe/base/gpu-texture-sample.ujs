native function gpu_texture_texel(address:i64,width:i64,height:i64,u:f64,v:f64,channels:i64) i64 {
  if(address<0 || width<1 || width>4096 || height<1 || height>4096 ||
     address>6291456-width*height*channels || u!=u || v!=v) { return 0-1; }
  let x=0;
  let y=0;
  if(u>=1.0) { x=width-1; }
  else if(u>0.0) { x=f64_floor_i64(u*width); }
  if(v>=1.0) { y=height-1; }
  else if(v>0.0) { y=f64_floor_i64(v*height); }
  return address+(y*width+x)*channels;
}

native function GpuTexture_nearestRgba8(address:i64,width:i64,height:i64,u:f64,v:f64) i64 {
  let texel=gpu_texture_texel(address,width,height,u,v,4);
  if(texel<0) { return texel; }
  return ux_u8(texel)+256*ux_u8(texel+1)+65536*ux_u8(texel+2)+16777216*ux_u8(texel+3);
}

native function GpuTexture_nearestRedRg8(channels:i64,address:i64,width:i64,height:i64,u:f64,v:f64) i64 {
  if(channels!=1 && channels!=2) { return 0-1; }
  let texel=gpu_texture_texel(address,width,height,u,v,channels);
  if(texel<0) { return texel; }
  let green=0;
  if(channels==2) { green=ux_u8(texel+1); }
  return ux_u8(texel)+256*green+4278190080;
}
