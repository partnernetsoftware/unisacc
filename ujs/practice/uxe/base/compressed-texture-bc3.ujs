native function bc3_alpha(block:i64,texel:i64) i64 {
  let first=ux_u8(block);
  let second=ux_u8(block+1);
  let bit=texel*3;
  let address=block+2+bit/8;
  let shift=bit%8;
  let bits=ux_u8(address);
  if(shift>5) { bits=bits+256*ux_u8(address+1); }
  let index=u32_shr(bits,shift)%8;
  if(index==0) { return first; }
  if(index==1) { return second; }
  if(first>second) { return ((8-index)*first+(index-1)*second)/7; }
  if(index==6) { return 0; }
  if(index==7) { return 255; }
  return ((6-index)*first+(index-1)*second)/5;
}

native function CompressedTexture_decodeBC3(level:i64,dst:i64,capacity:i64) i64 {
  let count=bc_rgba_output(level,dst,capacity,33779);
  if(count<0) { return count; }
  let width=ux_u32(level+CompressedMip.width);
  let height=ux_u32(level+CompressedMip.height);
  let data=ux_u32(level+CompressedMip.data);
  let columns=(width+3)/4;
  let y=0;
  while(y<height) {
    let x=0;
    while(x<width) {
      let block=data+(y/4*columns+x/4)*16;
      let row=y%4;
      let column=x%4;
      let alpha=bc3_alpha(block,row*4+column);
      let pixel=bc_rgba_pixel(block+8,row,column,dst+(y*width+x)*4,alpha);
      x=x+1;
    }
    y=y+1;
  }
  return count;
}
