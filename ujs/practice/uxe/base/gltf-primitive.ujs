struct GltfPrimitive {
  position: u32;
  index: u32;
  vertices: u32;
  indexCount: u32;
  material: u32;
}

// Leaves accessor descriptors in the caller's arena. The GLB bytes must stay
// live until the product copies or uploads the streams.
native function GltfLoader_trianglePrimitive(glb:i64,meshIndex:i64,primitiveIndex:i64,out:i64,work:i64) i64 {
  if(!loading_span(glb,GlbResource.size) || !loading_span(out,GltfPrimitive.size) ||
     !loading_span(work,80) || !file_disjoint(glb,GlbResource.size,work,80) ||
     !file_disjoint(glb,GlbResource.size,out,GltfPrimitive.size) ||
     !file_disjoint(work,80,out,GltfPrimitive.size)) { return 0-1; }
  let json=ux_u32(glb+GlbResource.json);
  let jsonBytes=ux_u32(glb+GlbResource.jsonBytes);
  let bin=ux_u32(glb+GlbResource.bin);
  let binBytes=ux_u32(glb+GlbResource.binBytes);
  if(json>6291456-jsonBytes || bin>6291456-binBytes ||
     !file_disjoint(json,jsonBytes,work,80) || !file_disjoint(json,jsonBytes,out,GltfPrimitive.size) ||
     !file_disjoint(bin,binBytes,work,80) || !file_disjoint(bin,binBytes,out,GltfPrimitive.size)) { return 0-1; }
  let key=work+64;
  let end=json+jsonBytes;
  let mesh=LoaderJson_item(LoaderJson_find(json,end,key,1752393069,29541,0,6),end,meshIndex);
  if(mesh<0) { return 0-2; }
  let prim=LoaderJson_item(LoaderJson_find(mesh,end,key,1835627120,1986622569,29541,10),end,primitiveIndex);
  if(prim<0) { return 0-2; }
  if(LoaderJson_uint(LoaderJson_find(prim,end,key,1701080941,0,0,4),end,4)!=4) { return 0-3; }
  let attrs=LoaderJson_find(prim,end,key,1920234593,1953849961,29541,10);
  let posIndex=LoaderJson_uint(LoaderJson_find(attrs,end,key,1230196560,1313818964,0,8),end,0-1);
  let indexToken=LoaderJson_find(prim,end,key,1768189545,7562595,0,7);
  let wrappedMaterial=LoaderJson_uint(LoaderJson_find(prim,end,key,1702125933,1818323314,0,8),end,4294967295);
  if(posIndex<0 || wrappedMaterial<0) { return 0-3; }
  let pos=GltfLoader_accessor(glb,posIndex,work,key);
  if(pos<0 || ux_u32(pos+GltfAccessor.component)!=5126 || ux_u32(pos+GltfAccessor.lanes)!=3) { return 0-4; }
  let vertices=ux_u32(pos+GltfAccessor.count);
  let index=0;
  let count=0;
  if(indexToken!=0-2) {
    let indexNumber=LoaderJson_uint(indexToken,end,0-1);
    index=GltfLoader_accessor(glb,indexNumber,work+32,key);
    if(index<0 || ux_u32(index+GltfAccessor.lanes)!=1 || ux_u32(index+GltfAccessor.normalized)!=0) { return 0-5; }
    let format=ux_u32(index+GltfAccessor.component);
    if(format!=5121 && format!=5123 && format!=5125) { return 0-5; }
    let stride=ux_u32(index+GltfAccessor.stride);
    if(stride!=ux_u32(index+GltfAccessor.elementBytes)) { return 0-5; }
    let bytes=ux_u32(index+GltfAccessor.bytes);
    count=ux_u32(index+GltfAccessor.count);
    if(count%3!=0) { return 0-5; }
    let i=0;
    while(i<count) {
      let at=bytes+i*stride;
      let value=ux_u8(at);
      if(format==5123) { value=value+256*ux_u8(at+1); }
      if(format==5125) { value=ux_u32(at); }
      if(value>=vertices) { return 0-5; }
      i=i+1;
    }
  } else {
    if(vertices%3!=0) { return 0-5; }
  }
  let a=ux_u32_put(out+GltfPrimitive.position,pos);
  let b=ux_u32_put(out+GltfPrimitive.index,index);
  let c=ux_u32_put(out+GltfPrimitive.vertices,vertices);
  let d=ux_u32_put(out+GltfPrimitive.indexCount,count);
  let e=ux_u32_put(out+GltfPrimitive.material,wrappedMaterial);
  return out;
}
