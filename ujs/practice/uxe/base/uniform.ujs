function Uniform_init(uniform,...uniform_args) {
  let uniform_store=ux_u32_put(uniform+Uniform.value,uniform_args[0]);
  return uniform;
}

// Values with their own clone operation pass the cloned value handle explicitly.
function Uniform_clone(uniform_clone,...uniform_clone_args) {
  let uniform_value=uniform_clone_args[1];
  if(uniform_value<0) { uniform_value=ux_u32(uniform_clone_args[0]+Uniform.value); }
  return Uniform_init(uniform_clone,uniform_value);
}
