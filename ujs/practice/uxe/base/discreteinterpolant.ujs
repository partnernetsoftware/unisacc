native function DiscreteInterpolant_evaluate(view:i64,t:f64,out:i64) i64 {
  let stride=animation_sample_output(view,out);
  if(stride<0 || t!=t) { return 0-1; }
  let times=ux_u32(view+AnimationSamples.times);
  let count=ux_u32(view+AnimationSamples.count);
  let offset=animation_sample_upper(times,count,t);
  if(offset>0) { offset=offset-1; }
  let row=ux_u32(view+AnimationSamples.values)+offset*stride*4;
  let i=0;
  while(i<stride) {
    let cell=ux_u32_put(out+i*4,ux_u32(row+i*4));
    i=i+1;
  }
  return out;
}
