// Entries are two words of identity/padding followed by one f64.
struct MaterialValue {
  key: u32;
  reserved: u32;
  value: f64;
}

native function Material_setValues(at:i64,entries:i64,count:i64) i64 {
  if(!material_span(at) || entries<0 || entries%8!=0 || count<0 || count>128 ||
     entries>6291456-count*MaterialValue.size ||
     (count>0 && entries<at+Material.size && at<entries+count*MaterialValue.size)) { return 0-1; }
  let version=ux_u32(at+Material.version);
  let alpha=ux_f64(at+Material.alphaTest)>0.0;
  let i=0;
  while(i<count) {
    let row=entries+i*MaterialValue.size;
    let key=ux_u32(row+MaterialValue.key);
    let value=ux_f64(row+MaterialValue.value);
    if(ux_u32(row+MaterialValue.reserved)!=0) { return 0-1; }
    let checked=material_field(at,key,value,0);
    if(checked<0) { return checked; }
    if(key==Material_alphaKey()) {
      let next=value>0.0;
      version=version+(alpha!=next);
      alpha=next;
    }
    i=i+1;
  }
  if(version>4294967295) { return 0-2; }
  i=0;
  while(i<count) {
    let row=entries+i*MaterialValue.size;
    let stored=material_field(at,ux_u32(row+MaterialValue.key),ux_f64(row+MaterialValue.value),1);
    if(stored<0) { return stored; }
    i=i+1;
  }
  return at;
}
