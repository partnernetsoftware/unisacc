native function image_base64_digit(value:i64) i64 {
  if(value<26) { return value+65; }
  if(value<52) { return value+71; }
  if(value<62) { return value-4; }
  if(value==62) { return 43; }
  return 47;
}

native function image_encoded_data_url(src:i64,bytes:i64,out:i64,capacity:i64,jpeg:i64) i64 {
  if(src<0 || bytes<1 || src>6291456-bytes || out<0 || capacity<0 || out>6291456-capacity ||
     (capacity>0 && out<src+bytes && src<out+capacity)) { return 0-1; }
  let prefix=22;
  if(jpeg!=0) { prefix=23; }
  let total=prefix+4*((bytes+2)/3);
  if(capacity<total) { return 0-2; }
  let png=[100,97,116,97,58,105,109,97,103,101,47,112,110,103,59,98,97,115,101,54,52,44];
  let jpg=[100,97,116,97,58,105,109,97,103,101,47,106,112,101,103,59,98,97,115,101,54,52,44];
  let i=0;
  while(i<prefix) {
    let mime=0;
    if(jpeg!=0) { mime=jpg[i]; }
    else { mime=png[i]; }
    let written=ux_u8_put(out+i,mime);
    i=i+1;
  }
  let input=0;
  let output=out+prefix;
  while(input<bytes) {
    let count=bytes-input;
    let a=ux_u8(src+input);
    let b=0;
    let c=0;
    if(count>1) { b=ux_u8(src+input+1); }
    if(count>2) { c=ux_u8(src+input+2); }
    let third=61;
    let fourth=61;
    if(count>1) { third=image_base64_digit((b%16)*4+c/64); }
    if(count>2) { fourth=image_base64_digit(c%64); }
    let w0=ux_u8_put(output,image_base64_digit(a/4));
    let w1=ux_u8_put(output+1,image_base64_digit((a%4)*16+b/16));
    let w2=ux_u8_put(output+2,third);
    let w3=ux_u8_put(output+3,fourth);
    input=input+3;
    output=output+4;
  }
  return total;
}
