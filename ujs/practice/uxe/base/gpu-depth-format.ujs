// Software readback of the two WebGL depth texture layouts.
native function gpu_depth16(at:i64) f64 {
  if(at<0 || at%2!=0 || at>6291454) { return 0.0-1.0; }
  return ux_u16(at)/65535.0;
}

native function gpu_depth24(at:i64) f64 {
  if(at<0 || at%4!=0 || at>6291452) { return 0.0-1.0; }
  return u32_shr(ux_u32(at),8)/16777215.0;
}

native function gpu_stencil8(at:i64) i64 {
  if(at<0 || at%4!=0 || at>6291452) { return 0-1; }
  return ux_u32(at)%256;
}
