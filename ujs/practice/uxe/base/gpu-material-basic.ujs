native function GpuMaterial_outputChannel(value:f64) f64 {
  if(value<=0.0) { return 0.0; }
  if(value>=1.0) { return 1.0; }
  if(value<=0.0031308) { return 12.92*value; }
  return 1.055*ux_math_pow(value,0.4166666666666667)-0.055;
}

native function GpuMaterial_basicVertex(address:i64,x:f64,y:f64,z:f64,r:f64,g:f64,b:f64,a:f64) i64 {
  let px=ux_f32_put(address,x);
  let py=ux_f32_put(address+4,y);
  let pz=ux_f32_put(address+8,z);
  let cr=ux_f32_put(address+12,GpuMaterial_outputChannel(r));
  let cg=ux_f32_put(address+16,GpuMaterial_outputChannel(g));
  let cb=ux_f32_put(address+20,GpuMaterial_outputChannel(b));
  let opacity=ux_f32_put(address+24,a);
  return address+28;
}
