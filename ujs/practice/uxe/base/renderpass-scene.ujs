// Emit a RenderPass prefix and its flat opaque scene together. A failed
// scene restores the packet length and command count from before the bind.
native function RenderPass_gpuScene(packet:i64,capacity:i64,step:i64,batch:i64,mask:i64,rgba:i64,depth:f64,stencil:i64) i64 {
  if(gpu_packet_slot(packet,capacity,0)<0 || batch%4!=0 ||
     !gpu_draw_range(batch,SceneGpuBatch.size,packet,capacity)) { return 0-1; }
  let before=ux_u32(packet+GpuPacket.bytes);
  let commands=ux_u32(packet+GpuPacket.commands);
  let started=RenderPass_begin(packet,capacity,step,mask,rgba,depth,stencil);
  if(started<0) { return started; }
  let count=SceneGpu_drawBatch(packet,capacity,batch);
  if(count<0) {
    let restore=ux_u32_put(packet+GpuPacket.bytes,before);
    let restoreCount=ux_u32_put(packet+GpuPacket.commands,commands);
    return count;
  }
  return ux_u32(packet+GpuPacket.bytes);
}
