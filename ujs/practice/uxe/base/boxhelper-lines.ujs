// BoxHelper writes world-space corners and stores its tint as an sRGB hex.
native function BoxHelper_bindLineStream(helper:i64,draw:i64,stream:i64,identity:i64,projection:i64,tint:i64) i64 {
  if(!helper_buffer_span(helper,BoxHelper.size,8) || !helper_buffer_span(projection,128,8) ||
     ux_u32(helper+BoxHelper.active)!=1 || ux_u32(helper+BoxHelper.positionVersion)==0) { return 0-1; }
  let positions=ux_u32(helper+BoxHelper.positions);
  let indices=ux_u32(helper+BoxHelper.indices);
  let bounds=ux_u32(helper+BoxHelper.box);
  let hex=ux_u32(helper+BoxHelper.color);
  if(!helper_buffer_span(positions,96,4) || !helper_buffer_span(indices,48,2) ||
     !helper_buffer_span(bounds,48,8) || hex>16777215) { return 0-1; }
  let outputs=[draw,stream,identity,tint];
  let sizes=[SceneDrawItem.size,SceneLineStream.size,128,12];
  let align=[4,4,8,4];
  let i=0;
  while(i<4) {
    let at=outputs[i];
    let bytes=sizes[i];
    if(!helper_buffer_span(at,bytes,align[i]) ||
       !helper_buffer_disjoint(at,bytes,helper,BoxHelper.size) ||
       !helper_buffer_disjoint(at,bytes,positions,96) ||
       !helper_buffer_disjoint(at,bytes,indices,48) ||
       !helper_buffer_disjoint(at,bytes,bounds,48) ||
       !helper_buffer_disjoint(at,bytes,projection,128)) { return 0-1; }
    let j=0;
    while(j<i) {
      if(!helper_buffer_disjoint(at,bytes,outputs[j],sizes[j])) { return 0-1; }
      j=j+1;
    }
    i=i+1;
  }
  i=0;
  while(i<16) {
    let element=ux_f64_put(identity+i*8,(i%5==0)*1.0);
    i=i+1;
  }
  let r=ux_f32_put(tint,Color_srgbToLinear((hex/65536)*1.0/255.0));
  let g=ux_f32_put(tint+4,Color_srgbToLinear(((hex/256)%256)*1.0/255.0));
  let b=ux_f32_put(tint+8,Color_srgbToLinear((hex%256)*1.0/255.0));
  let m=ux_u32_put(draw+SceneDrawItem.worldMatrix,identity);
  let a=ux_u32_put(stream+SceneLineStream.positions,positions);
  let p=ux_u32_put(stream+SceneLineStream.positionStride,12);
  let c=ux_u32_put(stream+SceneLineStream.colors,tint);
  let s=ux_u32_put(stream+SceneLineStream.colorStride,0);
  let v=ux_u32_put(stream+SceneLineStream.vertexCount,8);
  let x=ux_u32_put(stream+SceneLineStream.indices,indices);
  let n=ux_u32_put(stream+SceneLineStream.indexCount,24);
  let w=ux_u32_put(stream+SceneLineStream.indexBytes,2);
  let q=ux_u32_put(stream+SceneLineStream.viewProjection,projection);
  let t=ux_u32_put(stream+SceneLineStream.topology,2);
  return stream;
}
