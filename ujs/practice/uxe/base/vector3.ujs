struct Vector3 { x: f64; y: f64; z: f64; }

function Vector3_set(v3_destination, ...v3_coordinates) {
  let v3_storage = ux_span(v3_destination, Vector3.size);
  let v3_write_x = ux_f64_put(v3_destination + Vector3.x, v3_coordinates[0]);
  let v3_write_y = ux_f64_put(v3_destination + Vector3.y, v3_coordinates[1]);
  let v3_write_z = ux_f64_put(v3_destination + Vector3.z, v3_coordinates[2]);
  return v3_destination;
}

function Vector3_copy(v3_copy_dst, ...v3_copy_args) {
  let v3_copy_src = v3_copy_args[0];
  return Vector3_set(v3_copy_dst, ux_f64(v3_copy_src), ux_f64(v3_copy_src + Vector3.y),
      ux_f64(v3_copy_src + Vector3.z));
}

function Vector3_add(v3_add_dst, ...v3_add_args) {
  let v3_add_src = v3_add_args[0];
  return Vector3_set(v3_add_dst, ux_f64(v3_add_dst) + ux_f64(v3_add_src),
      ux_f64(v3_add_dst + Vector3.y) + ux_f64(v3_add_src + Vector3.y),
      ux_f64(v3_add_dst + Vector3.z) + ux_f64(v3_add_src + Vector3.z));
}

function Vector3_sub(v3_sub_dst, ...v3_sub_args) {
  let v3_sub_src = v3_sub_args[0];
  return Vector3_set(v3_sub_dst, ux_f64(v3_sub_dst) - ux_f64(v3_sub_src),
      ux_f64(v3_sub_dst + Vector3.y) - ux_f64(v3_sub_src + Vector3.y),
      ux_f64(v3_sub_dst + Vector3.z) - ux_f64(v3_sub_src + Vector3.z));
}

function Vector3_multiplyScalar(v3_scale_dst, ...v3_scale_args) {
  let v3_scale = v3_scale_args[0];
  return Vector3_set(v3_scale_dst, ux_f64(v3_scale_dst) * v3_scale,
      ux_f64(v3_scale_dst + Vector3.y) * v3_scale,
      ux_f64(v3_scale_dst + Vector3.z) * v3_scale);
}

function Vector3_dot(v3_dot_a, ...v3_dot_args) {
  let v3_dot_b = v3_dot_args[0];
  return ux_f64(v3_dot_a) * ux_f64(v3_dot_b) +
      ux_f64(v3_dot_a + Vector3.y) * ux_f64(v3_dot_b + Vector3.y) +
      ux_f64(v3_dot_a + Vector3.z) * ux_f64(v3_dot_b + Vector3.z);
}

function Vector3_crossVectors(v3_cross_dst, ...v3_cross_args) {
  let v3_cross_a = v3_cross_args[0];
  let v3_cross_b = v3_cross_args[1];
  let v3_ax = ux_f64(v3_cross_a);
  let v3_ay = ux_f64(v3_cross_a + Vector3.y);
  let v3_az = ux_f64(v3_cross_a + Vector3.z);
  let v3_bx = ux_f64(v3_cross_b);
  let v3_by = ux_f64(v3_cross_b + Vector3.y);
  let v3_bz = ux_f64(v3_cross_b + Vector3.z);
  return Vector3_set(v3_cross_dst, v3_ay * v3_bz - v3_az * v3_by,
      v3_az * v3_bx - v3_ax * v3_bz, v3_ax * v3_by - v3_ay * v3_bx);
}

function Vector3_cross(v3_cross_inout, ...v3_cross_other) {
  return Vector3_crossVectors(v3_cross_inout, v3_cross_inout, v3_cross_other[0]);
}

function Vector3_lengthSq(v3_sq_dst) {
  return Vector3_dot(v3_sq_dst, v3_sq_dst);
}

function Vector3_length(v3_length_dst) {
  return f64_sqrt(Vector3_lengthSq(v3_length_dst));
}

function Vector3_normalize(v3_normal_dst) {
  let v3_normal_length = Vector3_length(v3_normal_dst);
  if (v3_normal_length == 0.0 || v3_normal_length != v3_normal_length) { v3_normal_length = 1.0; }
  return Vector3_multiplyScalar(v3_normal_dst, 1.0 / v3_normal_length);
}

function Vector3_distanceToSquared(v3_dist_a, ...v3_dist_args) {
  let v3_dist_b = v3_dist_args[0];
  let v3_dist_x = ux_f64(v3_dist_a) - ux_f64(v3_dist_b);
  let v3_dist_y = ux_f64(v3_dist_a + Vector3.y) - ux_f64(v3_dist_b + Vector3.y);
  let v3_dist_z = ux_f64(v3_dist_a + Vector3.z) - ux_f64(v3_dist_b + Vector3.z);
  return v3_dist_x * v3_dist_x + v3_dist_y * v3_dist_y + v3_dist_z * v3_dist_z;
}

function Vector3_distanceTo(v3_dist_vector, ...v3_dist_other) {
  return f64_sqrt(Vector3_distanceToSquared(v3_dist_vector, v3_dist_other[0]));
}

function Vector3_applyMatrix3(v3_matrix_dst, ...v3_matrix_args) {
  let v3_matrix = v3_matrix_args[0];
  let v3_matrix_x = ux_f64(v3_matrix_dst);
  let v3_matrix_y = ux_f64(v3_matrix_dst + Vector3.y);
  let v3_matrix_z = ux_f64(v3_matrix_dst + Vector3.z);
  return Vector3_set(v3_matrix_dst,
      ux_f64(v3_matrix) * v3_matrix_x + ux_f64(v3_matrix + 24) * v3_matrix_y + ux_f64(v3_matrix + 48) * v3_matrix_z,
      ux_f64(v3_matrix + 8) * v3_matrix_x + ux_f64(v3_matrix + 32) * v3_matrix_y + ux_f64(v3_matrix + 56) * v3_matrix_z,
      ux_f64(v3_matrix + 16) * v3_matrix_x + ux_f64(v3_matrix + 40) * v3_matrix_y + ux_f64(v3_matrix + 64) * v3_matrix_z);
}

function Vector3_applyNormalMatrix(v3_normal_matrix_dst, ...v3_normal_matrix_args) {
  let v3_normal_transformed = Vector3_applyMatrix3(v3_normal_matrix_dst, v3_normal_matrix_args[0]);
  return Vector3_normalize(v3_normal_transformed);
}

function Vector3_applyMatrix4(v3_matrix4_dst, ...v3_matrix4_args) {
  let v3_mat4_ptr = v3_matrix4_args[0];
  let v3_mat4_x = ux_f64(v3_matrix4_dst);
  let v3_mat4_y = ux_f64(v3_matrix4_dst + Vector3.y);
  let v3_mat4_z = ux_f64(v3_matrix4_dst + Vector3.z);
  let v3_mat4_w = 1.0 / (ux_f64(v3_mat4_ptr + 24) * v3_mat4_x +
      ux_f64(v3_mat4_ptr + 56) * v3_mat4_y + ux_f64(v3_mat4_ptr + 88) * v3_mat4_z + ux_f64(v3_mat4_ptr + 120));
  return Vector3_set(v3_matrix4_dst,
      (ux_f64(v3_mat4_ptr) * v3_mat4_x + ux_f64(v3_mat4_ptr + 32) * v3_mat4_y +
          ux_f64(v3_mat4_ptr + 64) * v3_mat4_z + ux_f64(v3_mat4_ptr + 96)) * v3_mat4_w,
      (ux_f64(v3_mat4_ptr + 8) * v3_mat4_x + ux_f64(v3_mat4_ptr + 40) * v3_mat4_y +
          ux_f64(v3_mat4_ptr + 72) * v3_mat4_z + ux_f64(v3_mat4_ptr + 104)) * v3_mat4_w,
      (ux_f64(v3_mat4_ptr + 16) * v3_mat4_x + ux_f64(v3_mat4_ptr + 48) * v3_mat4_y +
          ux_f64(v3_mat4_ptr + 80) * v3_mat4_z + ux_f64(v3_mat4_ptr + 112)) * v3_mat4_w);
}

function Vector3_transformDirection(v3_dir_dst, ...v3_dir_args) {
  let v3_dir_matrix = v3_dir_args[0];
  let v3_dir_x = ux_f64(v3_dir_dst);
  let v3_dir_y = ux_f64(v3_dir_dst + Vector3.y);
  let v3_dir_z = ux_f64(v3_dir_dst + Vector3.z);
  let v3_dir_transformed = Vector3_set(v3_dir_dst,
      ux_f64(v3_dir_matrix) * v3_dir_x + ux_f64(v3_dir_matrix + 32) * v3_dir_y + ux_f64(v3_dir_matrix + 64) * v3_dir_z,
      ux_f64(v3_dir_matrix + 8) * v3_dir_x + ux_f64(v3_dir_matrix + 40) * v3_dir_y + ux_f64(v3_dir_matrix + 72) * v3_dir_z,
      ux_f64(v3_dir_matrix + 16) * v3_dir_x + ux_f64(v3_dir_matrix + 48) * v3_dir_y + ux_f64(v3_dir_matrix + 80) * v3_dir_z);
  return Vector3_normalize(v3_dir_transformed);
}

function Vector3_project(v3_project_dst, ...v3_project_args) {
  let v3_view_dst = Vector3_applyMatrix4(v3_project_dst, v3_project_args[0]);
  return Vector3_applyMatrix4(v3_view_dst, v3_project_args[1]);
}

function Vector3_unproject(v3_unproject_dst, ...v3_unproject_args) {
  let v3_camera_dst = Vector3_applyMatrix4(v3_unproject_dst, v3_unproject_args[0]);
  return Vector3_applyMatrix4(v3_camera_dst, v3_unproject_args[1]);
}

function Vector3_quaternionValues(v3_rotation_dst, ...v3_rotation_quat) {
  let v3_qx = v3_rotation_quat[0];
  let v3_qy = v3_rotation_quat[1];
  let v3_qz = v3_rotation_quat[2];
  let v3_qw = v3_rotation_quat[3];
  let v3_rx = ux_f64(v3_rotation_dst);
  let v3_ry = ux_f64(v3_rotation_dst + Vector3.y);
  let v3_rz = ux_f64(v3_rotation_dst + Vector3.z);
  let v3_tx = 2.0 * (v3_qy * v3_rz - v3_qz * v3_ry);
  let v3_ty = 2.0 * (v3_qz * v3_rx - v3_qx * v3_rz);
  let v3_tz = 2.0 * (v3_qx * v3_ry - v3_qy * v3_rx);
  return Vector3_set(v3_rotation_dst, v3_rx + v3_qw * v3_tx + (v3_qy * v3_tz - v3_qz * v3_ty),
      v3_ry + v3_qw * v3_ty + (v3_qz * v3_tx - v3_qx * v3_tz),
      v3_rz + v3_qw * v3_tz + (v3_qx * v3_ty - v3_qy * v3_tx));
}

function Vector3_applyQuaternion(v3_quat_dst, ...v3_quat_args) {
  let v3_quat = v3_quat_args[0];
  return Vector3_quaternionValues(v3_quat_dst, ux_f64(v3_quat), ux_f64(v3_quat + 8),
      ux_f64(v3_quat + 16), ux_f64(v3_quat + 24));
}

function Vector3_applyAxisAngle(v3_axis_dst, ...v3_axis_args) {
  let v3_axis = f64_floor_i64(v3_axis_args[0]);
  let v3_half_angle = v3_axis_args[1] * 0.5;
  let v3_axis_sin = ux_math_sin(v3_half_angle);
  return Vector3_quaternionValues(v3_axis_dst, ux_f64(v3_axis) * v3_axis_sin,
      ux_f64(v3_axis + Vector3.y) * v3_axis_sin, ux_f64(v3_axis + Vector3.z) * v3_axis_sin,
      ux_math_cos(v3_half_angle));
}

function Vector3_applyEulerAxis(v3_euler_axis_dst, ...v3_euler_axis_args) {
  let v3_euler_angle = v3_euler_axis_args[0] * 0.5;
  let v3_euler_axis = v3_euler_axis_args[1];
  let v3_euler_sine = ux_math_sin(v3_euler_angle);
  let v3_euler_cosine = ux_math_cos(v3_euler_angle);
  let v3_euler_qx = 0.0;
  let v3_euler_qy = 0.0;
  let v3_euler_qz = 0.0;
  if (v3_euler_axis == 0.0) { v3_euler_qx = v3_euler_sine; }
  if (v3_euler_axis == 1.0) { v3_euler_qy = v3_euler_sine; }
  if (v3_euler_axis == 2.0) { v3_euler_qz = v3_euler_sine; }
  return Vector3_quaternionValues(v3_euler_axis_dst, v3_euler_qx, v3_euler_qy, v3_euler_qz, v3_euler_cosine);
}

// Euler layout: three f64 angles followed by the u32 order XYZ, YXZ, ZXY, ZYX, YZX, XZY.
function Vector3_applyEuler(v3_euler_dst, ...v3_euler_args) {
  let v3_euler = v3_euler_args[0];
  let v3_ex = ux_f64(v3_euler);
  let v3_ey = ux_f64(v3_euler + 8);
  let v3_ez = ux_f64(v3_euler + 16);
  let v3_euler_order = ux_u32(v3_euler + 24);
  let v3_euler_status = 0 - 1;
  if (v3_euler_order < 6) {
    let v3_euler_angles = [v3_ex, v3_ey, v3_ez];
    let v3_euler_axes = [2,1,0, 2,0,1, 1,0,2, 0,1,2, 0,2,1, 1,2,0];
    let v3_euler_step = v3_euler_order * 3;
    let v3_euler_end = v3_euler_step + 3;
    v3_euler_status = v3_euler_dst;
    while (v3_euler_step < v3_euler_end) {
      let v3_euler_selected = v3_euler_axes[v3_euler_step];
      let v3_euler_part = v3_euler_angles[v3_euler_selected];
      v3_euler_status = Vector3_applyEulerAxis(v3_euler_status, v3_euler_part, 0.0 + v3_euler_selected);
      v3_euler_step = v3_euler_step + 1;
    }
  }
  return v3_euler_status;
}

function Vector3_multiply(v3_mul_dst, ...v3_mul_args) {
  let v3_mul_src = v3_mul_args[0];
  return Vector3_set(v3_mul_dst, ux_f64(v3_mul_dst) * ux_f64(v3_mul_src),
      ux_f64(v3_mul_dst + Vector3.y) * ux_f64(v3_mul_src + Vector3.y),
      ux_f64(v3_mul_dst + Vector3.z) * ux_f64(v3_mul_src + Vector3.z));
}

function Vector3_divide(v3_div_dst, ...v3_div_args) {
  let v3_div_src = v3_div_args[0];
  return Vector3_set(v3_div_dst, ux_f64(v3_div_dst) / ux_f64(v3_div_src),
      ux_f64(v3_div_dst + Vector3.y) / ux_f64(v3_div_src + Vector3.y),
      ux_f64(v3_div_dst + Vector3.z) / ux_f64(v3_div_src + Vector3.z));
}

function Vector3_projectOnVector(v3_proj_dst, ...v3_proj_args) {
  let v3_proj_axis = v3_proj_args[0];
  let v3_proj_sq = Vector3_lengthSq(v3_proj_axis);
  let v3_proj_scale = 0.0;
  let v3_proj_x = 0.0;
  let v3_proj_y = 0.0;
  let v3_proj_z = 0.0;
  if (v3_proj_sq != 0.0) {
    v3_proj_scale = Vector3_dot(v3_proj_dst, v3_proj_axis) / v3_proj_sq;
    v3_proj_x = ux_f64(v3_proj_axis) * v3_proj_scale;
    v3_proj_y = ux_f64(v3_proj_axis + Vector3.y) * v3_proj_scale;
    v3_proj_z = ux_f64(v3_proj_axis + Vector3.z) * v3_proj_scale;
  }
  return Vector3_set(v3_proj_dst, v3_proj_x, v3_proj_y, v3_proj_z);
}

function Vector3_projectOnPlane(v3_plane_dst, ...v3_plane_args) {
  let v3_plane_normal = v3_plane_args[0];
  let v3_plane_square = Vector3_lengthSq(v3_plane_normal);
  let v3_plane_coef = 0.0;
  let v3_plane_x = ux_f64(v3_plane_dst);
  let v3_plane_y = ux_f64(v3_plane_dst + Vector3.y);
  let v3_plane_z = ux_f64(v3_plane_dst + Vector3.z);
  if (v3_plane_square != 0.0) {
    v3_plane_coef = Vector3_dot(v3_plane_dst, v3_plane_normal) / v3_plane_square;
    v3_plane_x = v3_plane_x - ux_f64(v3_plane_normal) * v3_plane_coef;
    v3_plane_y = v3_plane_y - ux_f64(v3_plane_normal + Vector3.y) * v3_plane_coef;
    v3_plane_z = v3_plane_z - ux_f64(v3_plane_normal + Vector3.z) * v3_plane_coef;
  }
  return Vector3_set(v3_plane_dst, v3_plane_x, v3_plane_y, v3_plane_z);
}

function Vector3_reflect(v3_reflect_dst, ...v3_reflect_args) {
  let v3_reflect_normal = v3_reflect_args[0];
  let v3_reflect_scale = 2.0 * Vector3_dot(v3_reflect_dst, v3_reflect_normal);
  return Vector3_set(v3_reflect_dst,
      ux_f64(v3_reflect_dst) - ux_f64(v3_reflect_normal) * v3_reflect_scale,
      ux_f64(v3_reflect_dst + Vector3.y) - ux_f64(v3_reflect_normal + Vector3.y) * v3_reflect_scale,
      ux_f64(v3_reflect_dst + Vector3.z) - ux_f64(v3_reflect_normal + Vector3.z) * v3_reflect_scale);
}

function Vector3_angleTo(v3_angle_a, ...v3_angle_args) {
  let v3_angle_b = v3_angle_args[0];
  let v3_angle_denominator = f64_sqrt(Vector3_lengthSq(v3_angle_a) * Vector3_lengthSq(v3_angle_b));
  let v3_angle_value = 1.5707963267948966;
  if (v3_angle_denominator != 0.0) {
    let v3_angle_ratio = Vector3_dot(v3_angle_a, v3_angle_b) / v3_angle_denominator;
    if (v3_angle_ratio < 0.0 - 1.0) { v3_angle_ratio = 0.0 - 1.0; }
    if (v3_angle_ratio > 1.0) { v3_angle_ratio = 1.0; }
    v3_angle_value = ux_math_acos(v3_angle_ratio);
  }
  return v3_angle_value;
}

function Vector3_lerp(v3_lerp_dst, ...v3_lerp_args) {
  let v3_lerp_other = f64_floor_i64(v3_lerp_args[0]);
  let v3_lerp_alpha = v3_lerp_args[1];
  let v3_lerp_x = ux_f64(v3_lerp_dst);
  let v3_lerp_y = ux_f64(v3_lerp_dst + Vector3.y);
  let v3_lerp_z = ux_f64(v3_lerp_dst + Vector3.z);
  return Vector3_set(v3_lerp_dst,
      v3_lerp_x + (ux_f64(v3_lerp_other) - v3_lerp_x) * v3_lerp_alpha,
      v3_lerp_y + (ux_f64(v3_lerp_other + Vector3.y) - v3_lerp_y) * v3_lerp_alpha,
      v3_lerp_z + (ux_f64(v3_lerp_other + Vector3.z) - v3_lerp_z) * v3_lerp_alpha);
}

function Vector3_manhattanLength(v3_taxicab_dst) {
  return ux_math_abs(ux_f64(v3_taxicab_dst)) + ux_math_abs(ux_f64(v3_taxicab_dst + Vector3.y)) +
      ux_math_abs(ux_f64(v3_taxicab_dst + Vector3.z));
}

function Vector3_manhattanDistanceTo(v3_taxi_a, ...v3_taxi_args) {
  let v3_taxi_b = v3_taxi_args[0];
  return ux_math_abs(ux_f64(v3_taxi_a) - ux_f64(v3_taxi_b)) +
      ux_math_abs(ux_f64(v3_taxi_a + Vector3.y) - ux_f64(v3_taxi_b + Vector3.y)) +
      ux_math_abs(ux_f64(v3_taxi_a + Vector3.z) - ux_f64(v3_taxi_b + Vector3.z));
}

function Vector3_setLength(v3_set_length_dst, ...v3_set_length_args) {
  let v3_length_normalized = Vector3_normalize(v3_set_length_dst);
  return Vector3_multiplyScalar(v3_length_normalized, v3_set_length_args[0]);
}

function Vector3_setFromSphericalCoords(v3_spherical_dst, ...v3_spherical_args) {
  let v3_spherical_radius = v3_spherical_args[0];
  let v3_phi = v3_spherical_args[1];
  let v3_spherical_theta = v3_spherical_args[2];
  let v3_radial = ux_math_sin(v3_phi) * v3_spherical_radius;
  return Vector3_set(v3_spherical_dst, v3_radial * ux_math_sin(v3_spherical_theta),
      ux_math_cos(v3_phi) * v3_spherical_radius, v3_radial * ux_math_cos(v3_spherical_theta));
}

function Vector3_setFromCylindricalCoords(v3_cylinder_dst, ...v3_cylinder_args) {
  let v3_cylinder_radius = v3_cylinder_args[0];
  let v3_cylinder_theta = v3_cylinder_args[1];
  return Vector3_set(v3_cylinder_dst, v3_cylinder_radius * ux_math_sin(v3_cylinder_theta),
      v3_cylinder_args[2], v3_cylinder_radius * ux_math_cos(v3_cylinder_theta));
}

function Vector3_equals(v3_equal_a, ...v3_equal_args) {
  let v3_equal_b = v3_equal_args[0];
  return ux_f64(v3_equal_a) == ux_f64(v3_equal_b) &&
      ux_f64(v3_equal_a + Vector3.y) == ux_f64(v3_equal_b + Vector3.y) &&
      ux_f64(v3_equal_a + Vector3.z) == ux_f64(v3_equal_b + Vector3.z);
}

function Vector3_clone(v3_clone_dst, ...v3_clone_args) {
  return Vector3_copy(v3_clone_dst, v3_clone_args[0]);
}

function Vector3_setScalar(v3_fill_dst, ...v3_fill_args) {
  let v3_fill = v3_fill_args[0];
  return Vector3_set(v3_fill_dst, v3_fill, v3_fill, v3_fill);
}

function Vector3_setComponent(v3_component_dst, ...v3_component_args) {
  let v3_component = v3_component_args[0];
  let v3_component_status = 0 - 1;
  if (v3_component == 0.0 || v3_component == 1.0 || v3_component == 2.0) {
    let v3_component_span = ux_span(v3_component_dst, Vector3.size);
    let v3_component_write = ux_f64_put(v3_component_dst + f64_floor_i64(v3_component) * 8, v3_component_args[1]);
    v3_component_status = v3_component_dst;
  }
  return v3_component_status;
}

function Vector3_getComponent(v3_read_dst, ...v3_read_args) {
  let v3_read_index = v3_read_args[0];
  let v3_read_value = 0.0 / 0.0;
  if (v3_read_index >= 0 && v3_read_index < 3) {
    v3_read_value = ux_f64(v3_read_dst + v3_read_index * 8);
  }
  return v3_read_value;
}

function Vector3_setX(v3_setx_dst, ...v3_setx_args) {
  return Vector3_setComponent(v3_setx_dst, 0.0, v3_setx_args[0]);
}

function Vector3_setY(v3_sety_dst, ...v3_sety_args) {
  return Vector3_setComponent(v3_sety_dst, 1.0, v3_sety_args[0]);
}

function Vector3_setZ(v3_setz_dst, ...v3_setz_args) {
  return Vector3_setComponent(v3_setz_dst, 2.0, v3_setz_args[0]);
}

function Vector3_addScalar(v3_adds_dst, ...v3_adds_args) {
  let v3_adds_value = v3_adds_args[0];
  return Vector3_set(v3_adds_dst, ux_f64(v3_adds_dst) + v3_adds_value,
      ux_f64(v3_adds_dst + Vector3.y) + v3_adds_value, ux_f64(v3_adds_dst + Vector3.z) + v3_adds_value);
}

function Vector3_subScalar(v3_subs_dst, ...v3_subs_args) {
  let v3_subs_value = v3_subs_args[0];
  return Vector3_set(v3_subs_dst, ux_f64(v3_subs_dst) - v3_subs_value,
      ux_f64(v3_subs_dst + Vector3.y) - v3_subs_value, ux_f64(v3_subs_dst + Vector3.z) - v3_subs_value);
}

function Vector3_vectorOperation(v3_op_dst, ...v3_op_args) {
  let v3_op_a = v3_op_args[0];
  let v3_op_b = v3_op_args[1];
  let v3_operation = v3_op_args[2];
  let v3_op_ax = ux_f64(v3_op_a);
  let v3_op_ay = ux_f64(v3_op_a + Vector3.y);
  let v3_op_az = ux_f64(v3_op_a + Vector3.z);
  let v3_op_bx = ux_f64(v3_op_b);
  let v3_op_by = ux_f64(v3_op_b + Vector3.y);
  let v3_op_bz = ux_f64(v3_op_b + Vector3.z);
  if (v3_operation == 0) {
    v3_op_ax = v3_op_ax + v3_op_bx; v3_op_ay = v3_op_ay + v3_op_by; v3_op_az = v3_op_az + v3_op_bz;
  } else if (v3_operation == 1) {
    v3_op_ax = v3_op_ax - v3_op_bx; v3_op_ay = v3_op_ay - v3_op_by; v3_op_az = v3_op_az - v3_op_bz;
  } else {
    v3_op_ax = v3_op_ax * v3_op_bx; v3_op_ay = v3_op_ay * v3_op_by; v3_op_az = v3_op_az * v3_op_bz;
  }
  return Vector3_set(v3_op_dst, v3_op_ax, v3_op_ay, v3_op_az);
}

function Vector3_addVectors(v3_sum_dst, ...v3_sum_args) {
  return Vector3_vectorOperation(v3_sum_dst, v3_sum_args[0], v3_sum_args[1], 0);
}

function Vector3_subVectors(v3_diff_dst, ...v3_diff_args) {
  return Vector3_vectorOperation(v3_diff_dst, v3_diff_args[0], v3_diff_args[1], 1);
}

function Vector3_multiplyVectors(v3_product_dst, ...v3_product_args) {
  return Vector3_vectorOperation(v3_product_dst, v3_product_args[0], v3_product_args[1], 2);
}

function Vector3_addScaledVector(v3_as_dst, ...v3_as_args) {
  let v3_as_src = f64_floor_i64(v3_as_args[0]);
  let v3_as_scale = v3_as_args[1];
  return Vector3_set(v3_as_dst, ux_f64(v3_as_dst) + ux_f64(v3_as_src) * v3_as_scale,
      ux_f64(v3_as_dst + Vector3.y) + ux_f64(v3_as_src + Vector3.y) * v3_as_scale,
      ux_f64(v3_as_dst + Vector3.z) + ux_f64(v3_as_src + Vector3.z) * v3_as_scale);
}

function Vector3_divideScalar(v3_divs_dst, ...v3_divs_args) {
  return Vector3_multiplyScalar(v3_divs_dst, 1.0 / v3_divs_args[0]);
}

function Vector3_negate(v3_negate_dst) {
  return Vector3_multiplyScalar(v3_negate_dst, 0.0 - 1.0);
}

function Vector3_lerpVectors(v3_blend_dst, ...v3_blend_args) {
  let v3_blend_a = f64_floor_i64(v3_blend_args[0]);
  let v3_blend_b = f64_floor_i64(v3_blend_args[1]);
  let v3_blend_alpha = v3_blend_args[2];
  let v3_blend_x = ux_f64(v3_blend_a);
  let v3_blend_y = ux_f64(v3_blend_a + Vector3.y);
  let v3_blend_z = ux_f64(v3_blend_a + Vector3.z);
  return Vector3_set(v3_blend_dst,
      v3_blend_x + (ux_f64(v3_blend_b) - v3_blend_x) * v3_blend_alpha,
      v3_blend_y + (ux_f64(v3_blend_b + Vector3.y) - v3_blend_y) * v3_blend_alpha,
      v3_blend_z + (ux_f64(v3_blend_b + Vector3.z) - v3_blend_z) * v3_blend_alpha);
}

function Vector3_setFromMatrixPosition(v3_position_dst, ...v3_position_args) {
  return Vector3_copy(v3_position_dst, v3_position_args[0] + 96);
}

function Vector3_setFromMatrixScale(v3_mscale_dst, ...v3_mscale_args) {
  let v3_mscale_matrix = v3_mscale_args[0];
  return Vector3_set(v3_mscale_dst, Vector3_length(v3_mscale_matrix),
      Vector3_length(v3_mscale_matrix + 32), Vector3_length(v3_mscale_matrix + 64));
}

function Vector3_setFromMatrixColumn(v3_column_dst, ...v3_column_args) {
  let v3_column_index = v3_column_args[1];
  let v3_column_status = 0 - 1;
  if (v3_column_index >= 0 && v3_column_index < 4) {
    v3_column_status = Vector3_copy(v3_column_dst, v3_column_args[0] + v3_column_index * 32);
  }
  return v3_column_status;
}

function Vector3_setFromMatrix3Column(v3_col3_dst, ...v3_col3_args) {
  let v3_col3_index = v3_col3_args[1];
  let v3_col3_status = 0 - 1;
  if (v3_col3_index >= 0 && v3_col3_index < 3) {
    v3_col3_status = Vector3_copy(v3_col3_dst, v3_col3_args[0] + v3_col3_index * 24);
  }
  return v3_col3_status;
}

function Vector3_setFromEuler(v3_from_euler_dst, ...v3_from_euler_args) {
  return Vector3_copy(v3_from_euler_dst, v3_from_euler_args[0]);
}

function Vector3_setFromColor(v3_color_dst, ...v3_color_args) {
  return Vector3_copy(v3_color_dst, v3_color_args[0]);
}

function Vector3_setFromSpherical(v3_sphere_dst, ...v3_sphere_args) {
  let v3_sphere = v3_sphere_args[0];
  return Vector3_setFromSphericalCoords(v3_sphere_dst, ux_f64(v3_sphere), ux_f64(v3_sphere + 8),
      ux_f64(v3_sphere + 16));
}

function Vector3_setFromCylindrical(v3_cyl_dst, ...v3_cyl_args) {
  let v3_cyl = v3_cyl_args[0];
  return Vector3_setFromCylindricalCoords(v3_cyl_dst, ux_f64(v3_cyl), ux_f64(v3_cyl + 8), ux_f64(v3_cyl + 16));
}

function Vector3_arrayOffset(v3_array_base, ...v3_array_args) {
  let v3_array_result = 0 - 1;
  if (v3_array_base >= 0 && v3_array_base <= 6291432) {
    let v3_array_capacity = (6291432 - v3_array_base) / 8 + 1;
    v3_array_result = ux_typed_index(v3_array_base, v3_array_capacity, v3_array_args[0], 8);
  }
  return v3_array_result;
}

function Vector3_fromArray(v3_array_dst, ...v3_from_array_args) {
  let v3_array_source = Vector3_arrayOffset(v3_from_array_args[0], v3_from_array_args[1]);
  let v3_array_read = v3_array_source;
  if (v3_array_source >= 0) { v3_array_read = Vector3_copy(v3_array_dst, v3_array_source); }
  return v3_array_read;
}

function Vector3_toArray(v3_array_src, ...v3_to_array_args) {
  let v3_array_target = Vector3_arrayOffset(v3_to_array_args[0], v3_to_array_args[1]);
  let v3_array_written = v3_array_target;
  if (v3_array_target >= 0) { v3_array_written = Vector3_copy(v3_array_target, v3_array_src); }
  return v3_array_written;
}

function Vector3_fromBufferAttribute(v3_attr_dst, ...v3_attr_args) {
  let v3_attr_stride = v3_attr_args[3];
  let v3_attr_offset = 0 - 1;
  if (v3_attr_stride >= 12) {
    v3_attr_offset = ux_record_index(v3_attr_args[0], v3_attr_args[1], v3_attr_args[2], v3_attr_stride, 4);
  }
  let v3_attr_status = v3_attr_offset;
  if (v3_attr_offset >= 0) {
    v3_attr_status = Vector3_set(v3_attr_dst, ux_f32(v3_attr_offset), ux_f32(v3_attr_offset + 4),
        ux_f32(v3_attr_offset + 8));
  }
  return v3_attr_status;
}

function Vector3_random(v3_random_dst, ...v3_random_args) {
  return Vector3_set(v3_random_dst, v3_random_args[0], v3_random_args[1], v3_random_args[2]);
}

function Vector3_randomDirection(v3_randdir_dst, ...v3_randdir_args) {
  let v3_randdir_z = (v3_randdir_args[0] - 0.5) * 2.0;
  let v3_randdir_angle = v3_randdir_args[1] * 6.283185307179586;
  let v3_randdir_radius = f64_sqrt(1.0 - v3_randdir_z * v3_randdir_z);
  return Vector3_set(v3_randdir_dst, v3_randdir_radius * ux_math_cos(v3_randdir_angle),
      v3_randdir_radius * ux_math_sin(v3_randdir_angle), v3_randdir_z);
}

function Vector3_min(v3_min_dst, ...v3_min_args) {
  let v3_min_other = v3_min_args[0];
  let v3_min_floor = (0.0 - 1.0) / 0.0;
  return Vector3_set(v3_min_dst,
      vector_limit(ux_f64(v3_min_dst), v3_min_floor, ux_f64(v3_min_other)),
      vector_limit(ux_f64(v3_min_dst + Vector3.y), v3_min_floor, ux_f64(v3_min_other + Vector3.y)),
      vector_limit(ux_f64(v3_min_dst + Vector3.z), v3_min_floor, ux_f64(v3_min_other + Vector3.z)));
}

function Vector3_max(v3_max_dst, ...v3_max_args) {
  let v3_max_other = v3_max_args[0];
  let v3_max_ceiling = 1.0 / 0.0;
  return Vector3_set(v3_max_dst,
      vector_limit(ux_f64(v3_max_dst), ux_f64(v3_max_other), v3_max_ceiling),
      vector_limit(ux_f64(v3_max_dst + Vector3.y), ux_f64(v3_max_other + Vector3.y), v3_max_ceiling),
      vector_limit(ux_f64(v3_max_dst + Vector3.z), ux_f64(v3_max_other + Vector3.z), v3_max_ceiling));
}

function Vector3_clamp(v3_clamp_dst, ...v3_clamp_args) {
  let v3_clamp_low = v3_clamp_args[0];
  let v3_clamp_high = v3_clamp_args[1];
  return Vector3_set(v3_clamp_dst,
      vector_limit(ux_f64(v3_clamp_dst), ux_f64(v3_clamp_low), ux_f64(v3_clamp_high)),
      vector_limit(ux_f64(v3_clamp_dst + Vector3.y), ux_f64(v3_clamp_low + Vector3.y), ux_f64(v3_clamp_high + Vector3.y)),
      vector_limit(ux_f64(v3_clamp_dst + Vector3.z), ux_f64(v3_clamp_low + Vector3.z), ux_f64(v3_clamp_high + Vector3.z)));
}

function Vector3_clampScalar(v3_clamps_dst, ...v3_clamps_args) {
  let v3_clamps_low = v3_clamps_args[0];
  let v3_clamps_high = v3_clamps_args[1];
  return Vector3_set(v3_clamps_dst,
      vector_limit(ux_f64(v3_clamps_dst), v3_clamps_low, v3_clamps_high),
      vector_limit(ux_f64(v3_clamps_dst + Vector3.y), v3_clamps_low, v3_clamps_high),
      vector_limit(ux_f64(v3_clamps_dst + Vector3.z), v3_clamps_low, v3_clamps_high));
}

function Vector3_clampLength(v3_clampl_dst, ...v3_clampl_args) {
  let v3_clampl_len = Vector3_length(v3_clampl_dst);
  let v3_clampl_divisor = v3_clampl_len;
  if (v3_clampl_divisor == 0.0 || v3_clampl_divisor != v3_clampl_divisor) { v3_clampl_divisor = 1.0; }
  let v3_clampl_unit = Vector3_divideScalar(v3_clampl_dst, v3_clampl_divisor);
  return Vector3_multiplyScalar(v3_clampl_unit, vector_limit(v3_clampl_len, v3_clampl_args[0], v3_clampl_args[1]));
}

function Vector3_rounding(v3_round_dst, ...v3_round_args) {
  let v3_round_mode = v3_round_args[0];
  return Vector3_set(v3_round_dst,
      vector_roundValue(ux_f64(v3_round_dst), v3_round_mode),
      vector_roundValue(ux_f64(v3_round_dst + Vector3.y), v3_round_mode),
      vector_roundValue(ux_f64(v3_round_dst + Vector3.z), v3_round_mode));
}

function Vector3_floor(v3_floor_dst) {
  return Vector3_rounding(v3_floor_dst, 0.0);
}

function Vector3_ceil(v3_ceil_dst) {
  return Vector3_rounding(v3_ceil_dst, 1.0);
}

function Vector3_round(v3_round_mutable) {
  return Vector3_rounding(v3_round_mutable, 2.0);
}

function Vector3_roundToZero(v3_trunc_dst) {
  return Vector3_rounding(v3_trunc_dst, 3.0);
}
