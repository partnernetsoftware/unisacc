native function ImageLoader_decodeAsyncPng(instance:i64,id:i64,image:i64,rgba:i64,capacity:i64,scratch:i64,space:i64) i64 {
  if(loader_family_kind(instance)!=3 || !loader_family_decode_range(instance,image,ImageResource.size) ||
     !loader_family_decode_range(instance,rgba,capacity) ||
     !loader_family_decode_range(instance,scratch,space)) { return 0-1; }
  let file=loader_family_ready(instance,id);
  if(file<0) { return file; }
  let result=ImageLoader_decodePng(file,image,rgba,capacity,scratch,space);
  let released=FileLoader_release(file,id);
  return result;
}
