struct Cylindrical { radius: f64; theta: f64; y: f64; }

native function Cylindrical_set(cyl_dst:i64,cyl_r:f64,cyl_angle:f64,cyl_y:f64) i64 {
  let cyl_span=ux_span(cyl_dst,Cylindrical.size);
  let cyl_write_r=ux_f64_put(cyl_dst,cyl_r);
  let cyl_write_theta=ux_f64_put(cyl_dst+8,cyl_angle);
  let cyl_write_y=ux_f64_put(cyl_dst+16,cyl_y);
  return cyl_dst;
}

function Cylindrical_copy(cyl_copy,...cyl_copy_args) {
  let cyl_src=cyl_copy_args[0];
  return Cylindrical_set(cyl_copy,ux_f64(cyl_src),ux_f64(cyl_src+8),ux_f64(cyl_src+16));
}

function Cylindrical_clone(cyl_clone,...cyl_clone_args) {
  return Cylindrical_copy(cyl_clone,cyl_clone_args[0]);
}

native function Cylindrical_fromXYZ(cyl_cart:i64,cyl_x:f64,cyl_h:f64,cyl_z:f64) i64 {
  return Cylindrical_set(cyl_cart,f64_sqrt(cyl_x*cyl_x+cyl_z*cyl_z),ux_math_atan2(cyl_x,cyl_z),cyl_h);
}

function Cylindrical_setFromCartesianCoords(cyl_coord,...cyl_args) {
  return Cylindrical_fromXYZ(cyl_coord,cyl_args[0],cyl_args[1],cyl_args[2]);
}

function Cylindrical_setFromVector3(cyl_vector,...cyl_vector_args) {
  let cyl_point=cyl_vector_args[0];
  return Cylindrical_fromXYZ(cyl_vector,ux_f64(cyl_point),ux_f64(cyl_point+8),ux_f64(cyl_point+16));
}
