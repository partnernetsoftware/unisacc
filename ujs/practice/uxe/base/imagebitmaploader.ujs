// Option bit 0 flips Y. Bit 1 stores premultiplied RGB. Source and output
// spaces are disjoint so a failed size check leaves the original bitmap intact.
native function ImageBitmapLoader_copy(image:i64,output:i64,cap:i64,options:i64) i64 {
  if(!loading_span(image,ImageResource.size) || output<0 || cap<0 || output>6291456-cap ||
     options<0 || options>3 || !file_disjoint(image,ImageResource.size,output,cap)) { return 0-1; }
  let width=ux_u32(image+ImageResource.width);
  let height=ux_u32(image+ImageResource.height);
  let stride=ux_u32(image+ImageResource.rowBytes);
  let rgba=ux_u32(image+ImageResource.rgba);
  if(width<1 || width>1572864 || height<1 || stride<width*4 || rgba>6291456 ||
     height>(6291456-rgba)/stride || height>cap/(width*4) ||
     !file_disjoint(rgba,stride*height,output,cap)) { return 0-1; }
  let y=0;
  while(y<height) {
    let row=y;
    if(options%2!=0) { row=height-y-1; }
    let src=rgba+row*stride;
    let dst=output+y*width*4;
    if(options<2) { let copied=uxe_copy_record(dst,src,width*4); }
    else {
      let x=0;
      while(x<width) {
        let at=src+x*4;
        let placed=dst+x*4;
        let alpha=ux_u8(at+3);
        let r=ux_u8_put(placed,(alpha*ux_u8(at)+127)/255);
        let g=ux_u8_put(placed+1,(alpha*ux_u8(at+1)+127)/255);
        let b=ux_u8_put(placed+2,(alpha*ux_u8(at+2)+127)/255);
        let a=ux_u8_put(placed+3,alpha);
        x=x+1;
      }
    }
    y=y+1;
  }
  return width*height*4;
}
