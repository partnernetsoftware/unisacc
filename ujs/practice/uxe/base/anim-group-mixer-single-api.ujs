native function AnimationMixer_groupUpdate(route:i64,dt:f64) i64 {
  let output=group_mixer_prepare(route,0);
  if(output<0) { return output; }
  let mixer=ux_u32(route+GroupMixerRoute.mixer);
  let lanes=property_mixer_lanes(ux_u32(mixer+AnimationMixer.property));
  let x=ux_f64(output);
  let y=0.0; let z=0.0; let w=0.0;
  if(lanes>=2) { y=ux_f64(output+8); }
  if(lanes>=3) { z=ux_f64(output+16); }
  if(lanes==4) { w=ux_f64(output+24); }
  let frame=mixer_update_object(mixer,dt,0);
  if(frame<0) { return frame; }
  let changed=x!=ux_f64(output);
  if(lanes>=2 && y!=ux_f64(output+8)) { changed=1; }
  if(lanes>=3 && z!=ux_f64(output+16)) { changed=1; }
  if(lanes==4 && w!=ux_f64(output+24)) { changed=1; }
  if(changed && group_mixer_publish(route,output,lanes)<0) { return 0-1; }
  return frame;
}

native function AnimationMixer_groupStop(route:i64) i64 {
  let original=group_mixer_prepare(route,1);
  if(original<0) { return original; }
  let mixer=ux_u32(route+GroupMixerRoute.mixer);
  let lanes=property_mixer_lanes(ux_u32(mixer+AnimationMixer.property));
  let stopped=mixer_stop_object(mixer);
  if(stopped<0) { return stopped; }
  if(group_mixer_publish(route,original,lanes)<0) { return 0-1; }
  let synced=uxe_copy_record(original+lanes*24,original,lanes*8);
  return stopped;
}
