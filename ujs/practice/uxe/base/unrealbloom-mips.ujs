struct UnrealBloomMip {
  width:u32;
  height:u32;
  radius:u32;
}

// Writes the five bright/blur pyramid extents, largest to smallest.
native function UnrealBloom_planMips(out:i64,capacity:i64,width:i64,height:i64) i64 {
  if(out<0 || out%4!=0 || capacity<5 || out>6291456-5*UnrealBloomMip.size ||
     width<1 || height<1 || width>16384 || height>16384) { return 0-1; }
  let i=0;
  while(i<5) {
    width=(width+1)/2;
    height=(height+1)/2;
    let row=out+i*UnrealBloomMip.size;
    let a=ux_u32_put(row+UnrealBloomMip.width,width);
    let b=ux_u32_put(row+UnrealBloomMip.height,height);
    let c=ux_u32_put(row+UnrealBloomMip.radius,3+2*i);
    i=i+1;
  }
  return 5;
}
