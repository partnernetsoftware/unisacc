// Work with a nonpositive magnitude so the minimum i64 is representable.
function ux_format_i64(format_input) {
  let format_negative = format_input < 0;
  let format_remaining = format_input;
  let format_result = "";
  if (format_remaining > 0) { format_remaining = 0 - format_remaining; }
  if (format_remaining == 0) { format_result = "0"; }
  while (format_remaining < 0) {
    let format_digit = 0 - format_remaining % 10;
    format_result = str_slice("0123456789", format_digit, format_digit + 1) + format_result;
    format_remaining = format_remaining / 10;
  }
  if (format_negative) { format_result = "-" + format_result; }
  return format_result;
}
