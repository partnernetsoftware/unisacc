// Subtract a sampled scalar or vector reference from each numeric f32 row.
// Output belongs to the caller. Quaternion tracks use a separate composition.
native function AnimationUtils_numericDelta(view:i64,reference:i64,out:i64,capacity:i64) i64 {
  if(!animation_span(view,AnimationSamples.size) || !animation_span(out,capacity)) { return 0-1; }
  let lanes=ux_u32(view+AnimationSamples.stride);
  let count=ux_u32(view+AnimationSamples.count);
  if(count<1 || count>65536 || lanes<1 || lanes>64) { return 0-1; }
  let size=count*lanes*4;
  if(capacity<size) { return 0-2; }
  let values=ux_u32(view+AnimationSamples.values);
  let times=ux_u32(view+AnimationSamples.times);
  if(!animation_span(reference,lanes*4) || !animation_span(values,size) || !animation_span(times,count*4) ||
     animation_overlap(out,size,view,AnimationSamples.size) || animation_overlap(out,size,reference,lanes*4) ||
     animation_overlap(out,size,values,size) || animation_overlap(out,size,times,count*4)) { return 0-1; }
  let i=0;
  let scale=4294967296.0;
  let max=(2.0-1.0/8388608.0)*2147483648.0*scale*scale*scale;
  while(i<count*lanes) {
    let delta=ux_f32(values+i*4)-ux_f32(reference+(i%lanes)*4);
    if(delta-delta!=0.0 || delta>max || delta<0.0-max) { return 0-3; }
    i=i+1;
  }
  i=0;
  while(i<count*lanes) {
    let delta=ux_f32(values+i*4)-ux_f32(reference+(i%lanes)*4);
    let value=ux_f32_put(out+i*4,delta);
    i=i+1;
  }
  return size;
}
