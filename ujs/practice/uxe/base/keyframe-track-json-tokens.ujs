// Shared r160 track schema and type tags.
native function track_json_token(at:i64,id:i64) i64 {
  if(id==1) { let w0=ux_u32_put(at+0,1651340654); let w1=ux_u32_put(at+4,29285); return 6; }
  if(id==2) { let w0=ux_u32_put(at+0,1952671094); let w1=ux_u32_put(at+4,29295); return 6; }
  if(id==3) { let w0=ux_u32_put(at+0,1869377379); let w1=ux_u32_put(at+4,114); return 5; }
  if(id==4) { let w0=ux_u32_put(at+0,1952544113); let w1=ux_u32_put(at+4,1768845925); let w2=ux_u32_put(at+8,28271); return 10; }
  if(id==5) { let w0=ux_u32_put(at+0,1819242338); return 4; }
  if(id==6) { let w0=ux_u32_put(at+0,1769108595); let w1=ux_u32_put(at+4,26478); return 6; }
  if(id==7) { let w0=ux_u32_put(at+0,1701667182); return 4; }
  if(id==8) { let w0=ux_u32_put(at+0,1701669236); let w1=ux_u32_put(at+4,115); return 5; }
  if(id==9) { let w0=ux_u32_put(at+0,1970037110); let w1=ux_u32_put(at+4,29541); return 6; }
  if(id==10) { let w0=ux_u32_put(at+0,1702129257); let w1=ux_u32_put(at+4,1819242610); let w2=ux_u32_put(at+8,1869182049); let w3=ux_u32_put(at+12,110); return 13; }
  if(id==11) { let w0=ux_u32_put(at+0,1701869940); return 4; }
  if(id==12) { let w0=ux_u32_put(at+0,1936482662); let w1=ux_u32_put(at+4,101); return 5; }
  if(id==13) { let w0=ux_u32_put(at+0,1702195828); return 4; }
  return 0-1;
}

native function track_json_field(obj:i64,end:i64,scratch:i64,id:i64) i64 {
  let size=track_json_token(scratch,id);
  return json_find_key(obj,end,scratch,size);
}

native function track_json_key(dst:i64,end:i64,scratch:i64,id:i64) i64 {
  let size=track_json_token(scratch,id);
  let name=json_write_string(dst,end,scratch,size);
  return json_byte(name,end,58);
}

native function track_json_type(at:i64,end:i64,scratch:i64) i64 {
  let length=Json_stringBytes(at,end);
  if(length<1 || length>10) { return 0-1; }
  let copied=Json_decodeString(at,end,scratch+16,length);
  if(copied!=length) { return 0-1; }
  let kind=1;
  while(kind<=6) {
    let size=track_json_token(scratch,kind);
    let i=0;
    while(i<size && i<length && ux_u8(scratch+i)==ux_u8(scratch+16+i)) { i=i+1; }
    if(i==size && i==length) { return kind; }
    kind=kind+1;
  }
  return 0-1;
}
