// Storage begins with capacity, followed by uniform handles. Clone inputs
// contain already cloned value handles in the same order.
function UniformsGroup_init(ug_dst,...ug_args) {
  let ug_store=ug_args[0];
  let ug_capacity=ug_args[1];
  let ug_result=0-1;
  if(ug_capacity>=0 && ug_capacity<=1572863) {
    let ug_range=ux_span(ug_store,4+4*ug_capacity);
    let ug_limit=ux_u32_put(ug_store,ug_capacity);
    let ug_data=ux_u32_put(ug_dst+UniformsGroup.uniforms,ug_store);
    let ug_empty=ux_u32_put(ug_dst+UniformsGroup.count,0);
    let ug_default=ux_u32_put(ug_dst+UniformsGroup.usage,35044);
    let ug_blank=ux_u32_put(ug_dst+UniformsGroup.name,0);
    let ug_ap=ux_u32_put(ug_dst+EventDispatcher.listeners,0);
    let ug_an=ux_u32_put(ug_dst+EventDispatcher.listenerCount,0);
    let ug_ac=ux_u32_put(ug_dst+EventDispatcher.listenerCapacity,0);
    ug_result=ug_dst;
  }
  return ug_result;
}

native function UniformsGroup_add(ug_add:i64,ug_handle:i64) i64 {
  let ug_storage=ux_u32(ug_add+UniformsGroup.uniforms);
  let ug_count=ux_u32(ug_add+UniformsGroup.count);
  if(ug_count>=ux_u32(ug_storage)) { return 0-2; }
  let ug_push=ux_u32_put(ug_storage+4+4*ug_count,ug_handle);
  let ug_grow=ux_u32_put(ug_add+UniformsGroup.count,ug_count+1);
  return ug_add;
}

native function UniformsGroup_remove(ug_remove:i64,ug_removed:i64) i64 {
  let ug_rows=ux_u32(ug_remove+UniformsGroup.uniforms)+4;
  let ug_n=ux_u32(ug_remove+UniformsGroup.count);
  let ug_i=0;
  while(ug_i<ug_n && ux_u32(ug_rows+4*ug_i)!=ug_removed) { ug_i=ug_i+1; }
  if(ug_i==ug_n) { return ug_remove; }
  while(ug_i+1<ug_n) {
    let ug_previous=ux_u32_put(ug_rows+4*ug_i,ux_u32(ug_rows+4*ug_i+4));
    ug_i=ug_i+1;
  }
  let ug_shrink=ux_u32_put(ug_remove+UniformsGroup.count,ug_n-1);
  return ug_remove;
}

function UniformsGroup_setName(ug_name,...ug_name_args) {
  let ug_name_write=ux_u32_put(ug_name+UniformsGroup.name,ug_name_args[0]);
  return ug_name;
}

function UniformsGroup_setUsage(ug_usage,...ug_usage_args) {
  let ug_usage_write=ux_u32_put(ug_usage+UniformsGroup.usage,ug_usage_args[0]);
  return ug_usage;
}

function UniformsGroup_copy(ug_copy,...ug_copy_args) {
  let ug_copy_source=ug_copy_args[0];
  let ug_copy_values=ug_copy_args[1];
  let ug_copy_n=ux_u32(ug_copy_source+UniformsGroup.count);
  let ug_copy_storage=ux_u32(ug_copy+UniformsGroup.uniforms);
  let ug_copy_result=0-2;
  if(ug_copy_n<=ux_u32(ug_copy_storage)) {
    let ug_copy_range=ux_span(ug_copy_values,4*ug_copy_n);
    let ug_copy_i=0;
    while(ug_copy_i<ug_copy_n) {
      let ug_next_value=ux_u32_put(ug_copy_storage+4+4*ug_copy_i,ux_u32(ug_copy_values+4*ug_copy_i));
      ug_copy_i=ug_copy_i+1;
    }
    let ug_copy_count=ux_u32_put(ug_copy+UniformsGroup.count,ug_copy_n);
    let ug_copy_name=UniformsGroup_setName(ug_copy,ux_u32(ug_copy_source+UniformsGroup.name));
    ug_copy_result=UniformsGroup_setUsage(ug_copy,ux_u32(ug_copy_source+UniformsGroup.usage));
  }
  return ug_copy_result;
}

function UniformsGroup_clone(ug_clone,...ug_clone_args) {
  return UniformsGroup_copy(ug_clone,ug_clone_args[0],ug_clone_args[1]);
}

function UniformsGroup_addEventListener(group,...event) {
  return EventDispatcher_addListener(group,event[0],event[1]);
}
function UniformsGroup_hasEventListener(group,...event) {
  return EventDispatcher_find(group,event[0],event[1])>=0;
}

function UniformsGroup_removeEventListener(group,...event) {
  return EventDispatcher_removeListener(group,event[0],event[1]);
}

function UniformsGroup_dispatchEvent(group,...event) {
  return EventDispatcher_dispatchEvent(group,event[0],event[1],event[2],event[3]);
}

function UniformsGroup_dispose(ug_dispose,...ug_dispose_args) {
  return UniformsGroup_dispatchEvent(ug_dispose,ug_dispose_args[0],ug_dispose_args[1],
    ug_dispose_args[2],ug_dispose_args[3]);
}
