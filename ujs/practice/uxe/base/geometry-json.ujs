struct GeometryJsonIdentity {
  uuid: u32;
  uuidBytes: u32;
  name: u32;
  nameBytes: u32;
  names: u32;
  nameCount: u32;
}

native function geometry_json_attribute(dst:i64,end:i64,scratch:i64,view:i64,index:i64) i64 {
  if(view<0 || view>6291456-BufferAttribute.size || view%4!=0) { return 0-1; }
  let kind=ux_u32(view+BufferAttribute.componentType);
  let items=ux_u32(view+BufferAttribute.itemSize);
  let data=ux_u32(view+BufferAttribute.data);
  let count=ux_u32(view+BufferAttribute.count);
  let stride=ux_u32(view+BufferAttribute.stride);
  let width=4;
  if(kind<1 || kind>10 || items<1 || data>6291456) { return 0-1; }
  if(kind<=3) { width=1; }
  else if(kind<=5 || kind==8) { width=2; }
  else if(kind==10) { width=8; }
  if(stride!=items*width || data%width!=0 || count>(6291456-data)/stride) { return 0-1; }
  let types=[ObjectJsonType.uint8,ObjectJsonType.int8,ObjectJsonType.uint8Clamped,
    ObjectJsonType.uint16,ObjectJsonType.int16,ObjectJsonType.uint32,ObjectJsonType.int32,
    ObjectJsonType.uint16,ObjectJsonType.float32,ObjectJsonType.float64];
  let p=dst;
  if(index==0) {
    p=json_write_token(p,end,ObjectJsonToken.itemSize);
    p=json_write_f64(p,end,0.0+items,scratch);
    p=json_write_token(p,end,ObjectJsonToken.typedField);
  } else {
    if(items!=1 || (kind!=1 && kind!=4 && kind!=6)) { return 0-1; }
    p=json_write_token(p,end,ObjectJsonToken.indexField);
    p=json_write_token(p,end,ObjectJsonToken.typeField);
  }
  p=json_write_token(p,end,ObjectJsonToken.size+types[kind-1]);
  p=json_write_token(p,end,ObjectJsonToken.values);
  let i=0;
  let values=count*items;
  while(p>=0 && i<values) {
    if(i!=0) { p=json_byte(p,end,44); }
    p=json_write_f64(p,end,json_typed_value(data+i*width,kind),scratch);
    i=i+1;
  }
  p=json_byte(p,end,93);
  if(index==0) {
    p=json_write_token(p,end,ObjectJsonToken.normalized);
    let truth=ObjectJsonToken.boolFalse;
    if(ux_u32(view+BufferAttribute.normalized)!=0) { truth=ObjectJsonToken.boolTrue; }
    p=json_write_token(p,end,truth);
    let usage=ux_u32(view+BufferAttribute.usage);
    if(usage!=0 && usage!=35044) {
      p=json_write_token(p,end,ObjectJsonToken.usage);
      p=json_write_f64(p,end,0.0+usage,scratch);
    }
  }
  return json_byte(p,end,125);
}

// Identity names are provided as UTF-8. Each attribute name row stores a
// semantic ID, byte address and byte length. Output and scratch are disjoint
// from source descriptors and arrays. Rejected writes have no usable length.
native function BufferGeometry_toJSON(geo:i64,dst:i64,end:i64,identity:i64,scratch:i64) i64 {
  if(geo<0 || geo>6291456-BufferGeometry.size || geo%4!=0 ||
     identity<0 || identity>6291456-GeometryJsonIdentity.size || identity%4!=0) { return 0-1; }
  let names=ux_u32(identity+GeometryJsonIdentity.names);
  let name_count=ux_u32(identity+GeometryJsonIdentity.nameCount);
  let attr=ux_u32(geo+BufferGeometry.attributes);
  let groups=ux_u32(geo+BufferGeometry.groups);
  if(names>6291456 || names%4!=0 || name_count>(6291456-names)/12 ||
     attr>6291448 || attr%4!=0 || groups>6291448 || groups%4!=0) { return 0-1; }
  let count=ux_u32(attr);
  let group_count=ux_u32(groups);
  if(count>(6291448-attr)/8 || group_count>(6291448-groups)/12) { return 0-1; }
  let p=json_write_token(dst,end,ObjectJsonToken.geometryHeader);
  p=json_write_string(p,end,ux_u32(identity+GeometryJsonIdentity.uuid),ux_u32(identity+GeometryJsonIdentity.uuidBytes));
  p=json_write_token(p,end,ObjectJsonToken.geometryType);
  let name_size=ux_u32(identity+GeometryJsonIdentity.nameBytes);
  if(name_size!=0) {
    p=json_write_token(p,end,ObjectJsonToken.nameField);
    p=json_write_string(p,end,ux_u32(identity+GeometryJsonIdentity.name),name_size);
  }
  p=json_write_token(p,end,ObjectJsonToken.data);
  let i=0;
  while(p>=0 && i<count) {
    let item=attr+8+i*8;
    let semantic=ux_u32(item);
    let n=0;
    while(n<name_count && ux_u32(names+n*12)!=semantic) { n=n+1; }
    if(n==name_count) { return 0-2; }
    let row=names+n*12;
    if(i!=0) { p=json_byte(p,end,44); }
    p=json_write_string(p,end,ux_u32(row+4),ux_u32(row+8));
    p=json_byte(p,end,58);
    p=geometry_json_attribute(p,end,scratch,ux_u32(item+4),0);
    i=i+1;
  }
  p=json_byte(p,end,125);
  let index=ux_u32(geo+BufferGeometry.index)-1;
  if(index>=0) { p=geometry_json_attribute(p,end,scratch,index,1); }
  if(group_count>0) {
    p=json_write_token(p,end,ObjectJsonToken.groups);
    i=0;
    while(p>=0 && i<group_count) {
      let group=groups+8+i*12;
      if(i!=0) { p=json_byte(p,end,44); }
      p=json_write_token(p,end,ObjectJsonToken.groupStart);
      p=json_write_f64(p,end,0.0+ux_u32(group),scratch);
      p=json_write_token(p,end,ObjectJsonToken.groupCount);
      p=json_write_f64(p,end,0.0+ux_u32(group+4),scratch);
      p=json_write_token(p,end,ObjectJsonToken.groupMaterial);
      p=json_write_f64(p,end,0.0+ux_u32(group+8),scratch);
      p=json_byte(p,end,125);
      i=i+1;
    }
    p=json_byte(p,end,93);
  }
  let sphere=ux_u32(geo+BufferGeometry.boundingSphere)-1;
  if(sphere>=0) {
    if(sphere>6291424 || sphere%8!=0) { return 0-1; }
    p=json_write_token(p,end,ObjectJsonToken.sphere);
    p=json_write_f64(p,end,ux_f64(sphere),scratch);
    p=json_byte(p,end,44);
    p=json_write_f64(p,end,ux_f64(sphere+8),scratch);
    p=json_byte(p,end,44);
    p=json_write_f64(p,end,ux_f64(sphere+16),scratch);
    p=json_write_token(p,end,ObjectJsonToken.radius);
    p=json_write_f64(p,end,ux_f64(sphere+24),scratch);
    p=json_byte(p,end,125);
  }
  p=json_byte(p,end,125);
  return json_byte(p,end,125);
}
