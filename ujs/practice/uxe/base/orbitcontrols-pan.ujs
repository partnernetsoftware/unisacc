// right and up are packed f64 camera matrix columns. The plane mode
// projects vertical screen motion using the standard Y-up camera up axis.
native function orbit_pan_world(control:i64,right:i64,up:i64,screen:i64,left:f64,rise:f64) i64 {
  if(right<0 || up<0 || right%8!=0 || up%8!=0 ||
     right>6291456-24 || up>6291456-24 || screen<0 || screen>1) { return 0-1; }
  let rx=ux_f64(right);
  let ry=ux_f64(right+8);
  let rz=ux_f64(right+16);
  let ux=rz;
  let uy=0.0;
  let uz=0.0-rx;
  if(screen==1) {
    ux=ux_f64(up);
    uy=ux_f64(up+8);
    uz=ux_f64(up+16);
  }
  let pan=control+OrbitControls.size;
  let x=ux_f64(pan+OrbitPanOffset.x)-left*rx+rise*ux;
  let y=ux_f64(pan+OrbitPanOffset.y)-left*ry+rise*uy;
  let z=ux_f64(pan+OrbitPanOffset.z)-left*rz+rise*uz;
  if(x-x!=0.0 || y-y!=0.0 || z-z!=0.0) { return 0-1; }
  let a=ux_f64_put(pan+OrbitPanOffset.x,x);
  let b=ux_f64_put(pan+OrbitPanOffset.y,y);
  let c=ux_f64_put(pan+OrbitPanOffset.z,z);
  return 1;
}

native function OrbitControls_panPerspective(control:i64,right:i64,up:i64,screen:i64,dx:f64,dy:f64,fov:f64) i64 {
  if(!orbit_valid(control) || fov<=0.0 || fov>=180.0 || fov-fov!=0.0) { return 0-1; }
  let radians=fov*0.008726646259971648;
  let distance=ux_f64(control+OrbitControls.radius);
  let rate=2.0*distance*ux_math_sin(radians)/ux_math_cos(radians)/ux_f64(control+OrbitControls.height);
  return orbit_pan_world(control,right,up,screen,dx*rate,dy*rate);
}

// width and height are visible world dimensions after camera zoom. The
// caller provides width per viewport pixel and height per viewport pixel.
native function OrbitControls_panOrthographic(control:i64,right:i64,up:i64,screen:i64,dx:f64,dy:f64,xRate:f64,yRate:f64) i64 {
  if(!orbit_valid(control) || xRate<=0.0 || yRate<=0.0) { return 0-1; }
  return orbit_pan_world(control,right,up,screen,dx*xRate,dy*yRate);
}
