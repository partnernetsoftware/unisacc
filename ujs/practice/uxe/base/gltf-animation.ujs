struct GltfAnimationChannel {
  samples: u32;
  node: u32;
  interpolation: u32;
}

native function gltf_interpolation(at:i64,end:i64) i64 {
  if(at==0-2) { return 2301; }
  let close=json_scan_string(at,end);
  if(close<0) { return 0-1; }
  if(close-at==6 && ux_u32(at+1)==1346720851) { return 2300; }
  if(close-at==8 && ux_u32(at+1)==1162758476 && ux_u8(at+5)==65 && ux_u8(at+6)==82) { return 2301; }
  return 0-1;
}

native function GltfLoader_translationChannel(glb:i64,animation:i64,channel:i64,nodes:i64,out:i64,work:i64) i64 {
  if(!loading_span(glb,GlbResource.size) || !loading_span(out,GltfAnimationChannel.size) ||
     !loading_span(work,96) || work%4!=0 || !file_disjoint(glb,GlbResource.size,out,GltfAnimationChannel.size) ||
     !file_disjoint(glb,GlbResource.size,work,96) || !file_disjoint(out,GltfAnimationChannel.size,work,96)) { return 0-1; }
  let json=ux_u32(glb+GlbResource.json);
  let bytes=ux_u32(glb+GlbResource.jsonBytes);
  let bin=ux_u32(glb+GlbResource.bin);
  let binBytes=ux_u32(glb+GlbResource.binBytes);
  if(json>6291456-bytes || bin>6291456-binBytes || !file_disjoint(json,bytes,work,96) ||
     !file_disjoint(json,bytes,out,GltfAnimationChannel.size) || !file_disjoint(bin,binBytes,work,96) ||
     !file_disjoint(bin,binBytes,out,GltfAnimationChannel.size)) { return 0-1; }
  let end=json+bytes;
  let clip=LoaderJson_item(LoaderJson_find(json,end,work,1835626081,1869182049,29550,10),end,animation);
  if(clip<0) { return 0-2; }
  let row=LoaderJson_item(LoaderJson_find(clip,end,work,1851877475,1936483694,0,8),end,channel);
  if(row<0) { return 0-2; }
  let target=LoaderJson_find(row,end,work,1735549300,29797,0,6);
  let node=LoaderJson_uint(LoaderJson_find(target,end,work,1701080942,0,0,4),end,0-1);
  if(node<0 || node>=nodes) { return 0-3; }
  let path=LoaderJson_find(target,end,work,1752457584,0,0,4);
  if(path<0 || json_scan_string(path,end)!=path+13 || ux_u32(path+1)!=1851880052 ||
     ux_u32(path+5)!=1952541811 || ux_u8(path+9)!=105 || ux_u8(path+10)!=111 || ux_u8(path+11)!=110) { return 0-3; }
  let samplerIndex=LoaderJson_uint(LoaderJson_find(row,end,work,1886216563,7497068,0,7),end,0-1);
  let sampler=LoaderJson_item(LoaderJson_find(clip,end,work,1886216563,1936876908,0,8),end,samplerIndex);
  if(sampler<0) { return 0-4; }
  let tail=ux_u8_put(work+12,110);
  let mode=gltf_interpolation(LoaderJson_find(sampler,end,work,1702129257,1819242610,1869182049,13),end);
  if(mode<0) { return 0-4; }
  let input=LoaderJson_uint(LoaderJson_find(sampler,end,work,1970302569,116,0,5),end,0-1);
  let output=LoaderJson_uint(LoaderJson_find(sampler,end,work,1886680431,29813,0,6),end,0-1);
  let times=GltfLoader_accessor(glb,input,work+16,work);
  let points=GltfLoader_accessor(glb,output,work+48,work);
  if(times<0 || points<0 || ux_u32(times+GltfAccessor.component)!=5126 ||
     ux_u32(points+GltfAccessor.component)!=5126 || ux_u32(times+GltfAccessor.lanes)!=1 ||
     ux_u32(points+GltfAccessor.lanes)!=3 || ux_u32(times+GltfAccessor.stride)!=4 ||
     ux_u32(points+GltfAccessor.stride)!=12) { return 0-5; }
  let count=ux_u32(times+GltfAccessor.count);
  if(count!=ux_u32(points+GltfAccessor.count)) { return 0-5; }
  let timeBytes=ux_u32(times+GltfAccessor.bytes);
  if(ux_f32(timeBytes)<0.0) { return 0-5; }
  let samples=AnimationSamples_init(work+80,timeBytes,ux_u32(points+GltfAccessor.bytes),count,3);
  if(samples<0) { return 0-5; }
  let a=ux_u32_put(out+GltfAnimationChannel.samples,samples);
  let b=ux_u32_put(out+GltfAnimationChannel.node,node);
  let c=ux_u32_put(out+GltfAnimationChannel.interpolation,mode);
  return out;
}
