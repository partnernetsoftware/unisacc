// Two hundred and forty-eight bytes of caller-owned working storage.
native function TetrahedronGeometry_generate(mesh:i64,work:i64,radius:f64,detail:i64) i64 {
  if(work<0 || work>6291456-248 || work%8!=0) { return 0-1; }
  let positions=work+32;
  let indices=work+128;
  let vertex=0;
  while(vertex<4) {
    let x=0.0-1.0;
    let y=1.0-2.0*(vertex%2);
    let z=1.0-2.0*(vertex/2);
    if(vertex==0 || vertex==3) { x=1.0; }
    let at=positions+vertex*24;
    let wx=ux_f64_put(at,x);
    let wy=ux_f64_put(at+8,y);
    let wz=ux_f64_put(at+16,z);
    vertex=vertex+1;
  }
  let face=0;
  while(face<4) {
    let tuple=6;
    if(face==1) { tuple=44; }
    if(face==2) { tuple=13; }
    if(face==3) { tuple=30; }
    let ptr=indices+face*12;
    let a=ux_u32_put(ptr,tuple%4);
    let b=ux_u32_put(ptr+4,(tuple/4)%4);
    let c=ux_u32_put(ptr+8,tuple/16);
    face=face+1;
  }
  let config=PolyhedronGeometry_init(work,positions,4,indices,12,work+176);
  return PolyhedronGeometry_generate(mesh,config,radius,detail);
}
