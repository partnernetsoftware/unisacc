// Decode the fetched PNG to caller-owned staging storage, then copy its
// pixels to the separate output buffer with the selected bitmap options.
struct ImageBitmapOutput {
  pixels: u32;
  capacity: u32;
  options: u32;
}

native function ImageBitmapLoader_decodePng(instance:i64,id:i64,image:i64,rgba:i64,capacity:i64,scratch:i64,space:i64,target:i64) i64 {
  if(loader_family_kind(instance)!=4 || !loader_family_decode_range(instance,target,ImageBitmapOutput.size)) { return 0-1; }
  let output=ux_u32(target+ImageBitmapOutput.pixels);
  let cap=ux_u32(target+ImageBitmapOutput.capacity);
  let options=ux_u32(target+ImageBitmapOutput.options);
  if(options>3 || !file_disjoint(target,ImageBitmapOutput.size,output,cap) ||
     !loader_family_decode_range(instance,image,ImageResource.size) ||
     !loader_family_decode_range(instance,rgba,capacity) ||
     !loader_family_decode_range(instance,scratch,space) ||
     !loader_family_decode_range(instance,output,cap) ||
     !file_disjoint(output,cap,image,ImageResource.size) ||
     !file_disjoint(output,cap,rgba,capacity) ||
     !file_disjoint(output,cap,scratch,space)) { return 0-1; }
  let file=loader_family_ready(instance,id);
  if(file<0 || !file_disjoint(output,cap,ux_u32(file+FileLoader.bytes),ux_u32(file+FileLoader.length))) { return 0-1; }
  let decoded=ImageLoader_decodePng(file,image,rgba,capacity,scratch,space);
  let released=FileLoader_release(file,id);
  if(decoded<0) { return decoded; }
  return ImageBitmapLoader_copy(image,output,cap,options);
}
