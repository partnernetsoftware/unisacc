// Values are boolean words or UTF-8 address/length pairs. The result packs the
// value word count in the low seven bits and the owned UTF-8 byte count above.
native function animation_batch_discrete(array:i64,end:i64,values:i64,text:i64,limit:i64,kind:i64) i64 {
  if(array<0 || array>=end || ux_u8(array)!=91 || text>limit) { return 0-3; }
  let item=json_space(array+1,end);
  let words=0;
  let bytes=0;
  while(item>=0 && item<end) {
    if(ux_u8(item)==93) { return words+bytes*128; }
    let after=json_value_end(item,end);
    if(after<0 || after>=end) { return 0-3; }
    if(kind==5) {
      let token=ux_u8(item);
      if(words>=64 || (token!=102 && token!=116)) { return 0-3; }
      let saved=ux_u32_put(values+words*4,token==116);
      words=words+1;
    } else {
      if(words>=64) { return 0-3; }
      let length=Json_stringBytes(item,end);
      if(length<0) { return 0-3; }
      if(length>limit-text-bytes) { return 0-1; }
      let copied=Json_decodeString(item,end,text+bytes,length);
      if(copied!=length) { return 0-3; }
      let address=ux_u32_put(values+words*4,text+bytes);
      let size=ux_u32_put(values+words*4+4,length);
      words=words+2;
      bytes=bytes+length;
    }
    let next=json_space(after,end);
    if(next<0 || next>=end) { return 0-3; }
    if(ux_u8(next)==93) { return words+bytes*128; }
    if(ux_u8(next)!=44) { return 0-3; }
    item=json_space(next+1,end);
  }
  return 0-3;
}
