function Source_init(source_dst,...source_args) {
  let source_data=ux_u32_put(source_dst+Source.data,source_args[0]);
  let source_ver=ux_u32_put(source_dst+Source.version,0);
  let source_ready=ux_u32_put(source_dst+Source.dataReady,1);
  return source_dst;
}

function Source_needsUpdate(source_update,...source_update_args) {
  if(source_update_args[0]!=0) {
    let source_ver_at=source_update+Source.version;
    let source_bump=ux_u32_put(source_ver_at,ux_u32(source_ver_at)+1);
  }
  return source_update;
}

function Source_setData(source_set,...source_set_args) {
  let source_payload=ux_u32_put(source_set+Source.data,source_set_args[0]);
  let source_set_ready=ux_u32_put(source_set+Source.dataReady,source_set_args[1]!=0);
  return source_set;
}
