// Consume a queued perspective dolly along the world-space ray from the camera.
// Call with the current camera ray after applying any pending orbit and pan.
native function OrbitControls_zoomCursor(control:i64,rx:f64,ry:f64,rz:f64,screen:i64) i64 {
  if(!orbit_valid(control) || screen<0 || screen>1) { return 0-1; }
  let scale=ux_f64(control+OrbitControls.zoomScale);
  if(scale==1.0) { return 0; }
  let rayLength=f64_sqrt(rx*rx+ry*ry+rz*rz);
  let x=ux_f64(control+OrbitControls.x);
  let y=ux_f64(control+OrbitControls.y);
  let z=ux_f64(control+OrbitControls.z);
  let tx=ux_f64(control+OrbitControls.targetX);
  let ty=ux_f64(control+OrbitControls.targetY);
  let tz=ux_f64(control+OrbitControls.targetZ);
  let dx=tx-x;
  let dy=ty-y;
  let dz=tz-z;
  let radius=f64_sqrt(dx*dx+dy*dy+dz*dz);
  if(scale<=0.0 || scale-scale!=0.0 || rayLength<=0.0 || rayLength-rayLength!=0.0 ||
     radius<=0.0 || radius-radius!=0.0) { return 0-1; }
  let next=vector_limit(radius*scale,ux_f64(control+OrbitControls.minRadius),ux_f64(control+OrbitControls.maxRadius));
  let move=(radius-next)/rayLength;
  x=x+rx*move; y=y+ry*move; z=z+rz*move;
  if(screen==1) {
    tx=x+dx*(next/radius); ty=y+dy*(next/radius); tz=z+dz*(next/radius);
  } else if(ux_math_abs(dy/radius)>=0.3420201433256688) {
    let along=(ty-y)/dy;
    if(along>=0.0) { tx=x+dx*along; tz=z+dz*along; }
  }
  dx=x-tx; dy=y-ty; dz=z-tz;
  let distance=f64_sqrt(dx*dx+dy*dy+dz*dz);
  if(distance<=0.0 || distance-distance!=0.0 || next-next!=0.0) { return 0-1; }
  let theta=ux_math_atan2(dx,dz);
  let phi=ux_math_acos(vector_limit(dy/distance,0.0-1.0,1.0));
  let a=ux_f64_put(control+OrbitControls.x,x);
  let b=ux_f64_put(control+OrbitControls.y,y);
  let c=ux_f64_put(control+OrbitControls.z,z);
  let d=ux_f64_put(control+OrbitControls.targetX,tx);
  let e=ux_f64_put(control+OrbitControls.targetY,ty);
  let f=ux_f64_put(control+OrbitControls.targetZ,tz);
  let g=ux_f64_put(control+OrbitControls.radius,distance);
  let h=ux_f64_put(control+OrbitControls.theta,theta);
  let i=ux_f64_put(control+OrbitControls.phi,phi);
  let j=ux_f64_put(control+OrbitControls.zoomScale,1.0);
  return 1;
}
