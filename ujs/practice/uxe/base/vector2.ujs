struct Vector2 { x: f64; y: f64; }

// Mutable vectors occupy two consecutive little-endian f64 cells.
function Vector2_set(dst, ...set_components) {
  let set_span = ux_span(dst, Vector2.size);
  let set_x = ux_f64_put(dst + Vector2.x, set_components[0]);
  let set_y = ux_f64_put(dst + Vector2.y, set_components[1]);
  return dst;
}

function Vector2_add(add_dst, ...add_arguments) {
  let add_src = add_arguments[0];
  return Vector2_set(add_dst, ux_f64(add_dst) + ux_f64(add_src),
      ux_f64(add_dst + Vector2.y) + ux_f64(add_src + Vector2.y));
}

function Vector2_sub(sub_dst, ...sub_arguments) {
  let sub_src = sub_arguments[0];
  return Vector2_set(sub_dst, ux_f64(sub_dst) - ux_f64(sub_src),
      ux_f64(sub_dst + Vector2.y) - ux_f64(sub_src + Vector2.y));
}

function Vector2_multiply(mul_dst, ...mul_arguments) {
  let mul_src = mul_arguments[0];
  return Vector2_set(mul_dst, ux_f64(mul_dst) * ux_f64(mul_src),
      ux_f64(mul_dst + Vector2.y) * ux_f64(mul_src + Vector2.y));
}

function Vector2_divide(div_dst, ...div_arguments) {
  let div_src = div_arguments[0];
  return Vector2_set(div_dst, ux_f64(div_dst) / ux_f64(div_src),
      ux_f64(div_dst + Vector2.y) / ux_f64(div_src + Vector2.y));
}

function Vector2_dot(dot_a, ...dot_arguments) {
  let dot_b = dot_arguments[0];
  return ux_f64(dot_a) * ux_f64(dot_b) + ux_f64(dot_a + Vector2.y) * ux_f64(dot_b + Vector2.y);
}

function Vector2_cross(cross_a, ...cross_arguments) {
  let cross_b = cross_arguments[0];
  return ux_f64(cross_a) * ux_f64(cross_b + Vector2.y) - ux_f64(cross_a + Vector2.y) * ux_f64(cross_b);
}

function Vector2_lengthSq(length_sq) {
  let ls_x = ux_f64(length_sq);
  let ls_y = ux_f64(length_sq + Vector2.y);
  return ls_x * ls_x + ls_y * ls_y;
}

function Vector2_length(length_vector) {
  return f64_sqrt(Vector2_lengthSq(length_vector));
}

function Vector2_normalize(normal_vector) {
  let normal_length = Vector2_length(normal_vector);
  if (normal_length == 0.0 || normal_length != normal_length) { normal_length = 1.0; }
  let normal_inverse = 1.0 / normal_length;
  return Vector2_set(normal_vector, ux_f64(normal_vector) * normal_inverse,
      ux_f64(normal_vector + Vector2.y) * normal_inverse);
}

function Vector2_distanceToSquared(distance_a, ...distance_arguments) {
  let distance_b = distance_arguments[0];
  let distance_x = ux_f64(distance_a) - ux_f64(distance_b);
  let distance_y = ux_f64(distance_a + Vector2.y) - ux_f64(distance_b + Vector2.y);
  return distance_x * distance_x + distance_y * distance_y;
}

function Vector2_distanceTo(dist_a, ...dist_arguments) {
  return f64_sqrt(Vector2_distanceToSquared(dist_a, dist_arguments[0]));
}

function Vector2_applyMatrix3(matrix_dst, ...matrix_arguments) {
  let matrix_ptr = matrix_arguments[0];
  let matrix_x = ux_f64(matrix_dst);
  let matrix_y = ux_f64(matrix_dst + Vector2.y);
  return Vector2_set(matrix_dst,
      ux_f64(matrix_ptr) * matrix_x + ux_f64(matrix_ptr + 24) * matrix_y + ux_f64(matrix_ptr + 48),
      ux_f64(matrix_ptr + 8) * matrix_x + ux_f64(matrix_ptr + 32) * matrix_y + ux_f64(matrix_ptr + 56));
}

function Vector2_copy(copy_dst, ...copy_arguments) {
  let copy_src = copy_arguments[0];
  return Vector2_set(copy_dst, ux_f64(copy_src), ux_f64(copy_src + Vector2.y));
}

function Vector2_getComponent(component_vector, ...component_arguments) {
  let component_index = component_arguments[0];
  let component_value = 0.0 / 0.0;
  if (component_index == 0 || component_index == 1) {
    component_value = ux_f64(component_vector + component_index * 8);
  }
  return component_value;
}

function Vector2_setComponent(component_dst, ...component_values) {
  // Index and storage are expressed as f64 here so rest arguments remain homogeneous.
  let write_component = component_values[0];
  let write_status = 0 - 1;
  if (write_component == 0.0 || write_component == 1.0) {
    let write_offset = f64_floor_i64(write_component) * 8;
    let write_value = ux_f64_put(component_dst + write_offset, component_values[1]);
    write_status = component_dst;
  }
  return write_status;
}

function Vector2_setScalar(scalar_dst, ...scalar_arguments) {
  let fill_value = scalar_arguments[0];
  return Vector2_set(scalar_dst, fill_value, fill_value);
}

function Vector2_addScalar(add_scalar_dst, ...add_scalar_arguments) {
  let add_scalar = add_scalar_arguments[0];
  return Vector2_set(add_scalar_dst, ux_f64(add_scalar_dst) + add_scalar,
      ux_f64(add_scalar_dst + Vector2.y) + add_scalar);
}

function Vector2_multiplyScalar(scale_dst, ...scale_arguments) {
  let scale_value = scale_arguments[0];
  return Vector2_set(scale_dst, ux_f64(scale_dst) * scale_value,
      ux_f64(scale_dst + Vector2.y) * scale_value);
}

function Vector2_setLength(target_dst, ...target_arguments) {
  let target_normal = Vector2_normalize(target_dst);
  return Vector2_multiplyScalar(target_normal, target_arguments[0]);
}

function Vector2_lerp(lerp_dst, ...lerp_arguments) {
  // Pack the source offset as f64 alongside alpha, checking through the f64 conversion.
  let lerp_src = f64_floor_i64(lerp_arguments[0]);
  let lerp_ratio = lerp_arguments[1];
  let lerp_x = ux_f64(lerp_dst);
  let lerp_y = ux_f64(lerp_dst + Vector2.y);
  return Vector2_set(lerp_dst, lerp_x + (ux_f64(lerp_src) - lerp_x) * lerp_ratio,
      lerp_y + (ux_f64(lerp_src + Vector2.y) - lerp_y) * lerp_ratio);
}

function Vector2_clamp(clamp_dst, ...clamp_arguments) {
  let clamp_lo = clamp_arguments[0];
  let clamp_hi = clamp_arguments[1];
  return Vector2_set(clamp_dst,
      Vector2_limit(ux_f64(clamp_dst), ux_f64(clamp_lo), ux_f64(clamp_hi)),
      Vector2_limit(ux_f64(clamp_dst + Vector2.y), ux_f64(clamp_lo + Vector2.y), ux_f64(clamp_hi + Vector2.y)));
}

function Vector2_angle(angle_vector) {
  let angle_x = ux_f64(angle_vector);
  let angle_y = ux_f64(angle_vector + Vector2.y);
  return ux_math_atan2((0.0 - 1.0) * angle_y, (0.0 - 1.0) * angle_x) + 3.141592653589793;
}

function Vector2_angleTo(angle_to_a, ...angle_to_arguments) {
  let angle_to_b = angle_to_arguments[0];
  let angle_denom = f64_sqrt(Vector2_lengthSq(angle_to_a) * Vector2_lengthSq(angle_to_b));
  let angle_result = 1.5707963267948966;
  if (angle_denom != 0.0) {
    let angle_cos = Vector2_dot(angle_to_a, angle_to_b) / angle_denom;
    if (angle_cos < 0.0 - 1.0) { angle_cos = 0.0 - 1.0; }
    if (angle_cos > 1.0) { angle_cos = 1.0; }
    angle_result = ux_math_acos(angle_cos);
  }
  return angle_result;
}

function Vector2_rotateAround(rotate_dst, ...rotate_arguments) {
  let rotate_center = f64_floor_i64(rotate_arguments[0]);
  let rotate_angle = rotate_arguments[1];
  let rotate_cos = ux_math_cos(rotate_angle);
  let rotate_sin = ux_math_sin(rotate_angle);
  let rotate_center_x = ux_f64(rotate_center);
  let rotate_center_y = ux_f64(rotate_center + Vector2.y);
  let rotate_x = ux_f64(rotate_dst) - rotate_center_x;
  let rotate_y = ux_f64(rotate_dst + Vector2.y) - rotate_center_y;
  return Vector2_set(rotate_dst, rotate_x * rotate_cos - rotate_y * rotate_sin + rotate_center_x,
      rotate_x * rotate_sin + rotate_y * rotate_cos + rotate_center_y);
}

function Vector2_manhattanLength(manhattan_dst) {
  return ux_math_abs(ux_f64(manhattan_dst)) + ux_math_abs(ux_f64(manhattan_dst + Vector2.y));
}

function Vector2_manhattanDistanceTo(manhattan_a, ...manhattan_arguments) {
  let manhattan_b = manhattan_arguments[0];
  return ux_math_abs(ux_f64(manhattan_a) - ux_f64(manhattan_b)) +
      ux_math_abs(ux_f64(manhattan_a + Vector2.y) - ux_f64(manhattan_b + Vector2.y));
}

function Vector2_equals(equals_a, ...equals_arguments) {
  let equals_b = equals_arguments[0];
  return ux_f64(equals_a) == ux_f64(equals_b) && ux_f64(equals_a + Vector2.y) == ux_f64(equals_b + Vector2.y);
}

function Vector2_roundValue(round_value, ...round_arguments) {
  let round_kind = round_arguments[0];
  let round_result = round_value;
  if (round_value != 0.0 && round_value > 0.0 - 4503599627370496.0 &&
      round_value < 4503599627370496.0) {
    let round_down = 0.0 + f64_floor_i64(round_value);
    round_result = round_down;
    if (round_kind == 2.0 && round_value - round_down >= 0.5) {
      round_result = round_result + 1.0;
    }
    if ((round_kind == 1.0 || (round_kind == 3.0 && round_value < 0.0)) &&
        round_value != round_down) {
      round_result = round_result + 1.0;
    }
    if (round_value < 0.0 && round_result == 0.0) {
      round_result = (0.0 - 1.0) * 0.0;
    }
  }
  return round_result;
}

function Vector2_rounding(round_dst, ...round_mode) {
  return Vector2_set(round_dst, Vector2_roundValue(ux_f64(round_dst), round_mode[0]),
      Vector2_roundValue(ux_f64(round_dst + Vector2.y), round_mode[0]));
}

function Vector2_fromArray(array_dst, ...array_read) {
  let array_base = array_read[0];
  let array_start = Vector2_arrayStart(array_base, array_read[1]);
  let array_status = array_start;
  if (array_start >= 0) { array_status = Vector2_copy(array_dst, array_start); }
  return array_status;
}

function Vector2_toArray(array_src, ...array_write) {
  let array_target = Vector2_arrayStart(array_write[0], array_write[1]);
  let array_written = array_target;
  if (array_target >= 0) { array_written = Vector2_copy(array_target, array_src); }
  return array_written;
}

function Vector2_arrayStart(array_offset, ...array_index) {
  let array_at = 0 - 1;
  if (array_offset >= 0 && array_offset <= 6291440) {
    let array_ends = (6291440 - array_offset) / 8;
    array_at = ux_typed_index(array_offset, array_ends + 1, array_index[0], 8);
  }
  return array_at;
}

function Vector2_fromBufferAttribute(attribute_dst, ...attribute_args) {
  let attribute_base = attribute_args[0];
  let attribute_count = attribute_args[1];
  let attribute_index = attribute_args[2];
  let attribute_stride = attribute_args[3];
  let attribute_offset = 0 - 1;
  if (attribute_stride >= 8) {
    attribute_offset = ux_record_index(attribute_base, attribute_count, attribute_index, attribute_stride, 4);
  }
  let attribute_status = attribute_offset;
  if (attribute_offset >= 0) {
    attribute_status = Vector2_set(attribute_dst, ux_f32(attribute_offset), ux_f32(attribute_offset + 4));
  }
  return attribute_status;
}

function Vector2_addVectors(sum_dst, ...sum_args) {
  let sum_a = sum_args[0];
  let sum_b = sum_args[1];
  return Vector2_set(sum_dst, ux_f64(sum_a) + ux_f64(sum_b),
      ux_f64(sum_a + Vector2.y) + ux_f64(sum_b + Vector2.y));
}

function Vector2_subVectors(diff_dst, ...diff_args) {
  let diff_a = diff_args[0];
  let diff_b = diff_args[1];
  return Vector2_set(diff_dst, ux_f64(diff_a) - ux_f64(diff_b),
      ux_f64(diff_a + Vector2.y) - ux_f64(diff_b + Vector2.y));
}

function Vector2_addScaledVector(scaled_dst, ...scaled_args) {
  let scaled_src = f64_floor_i64(scaled_args[0]);
  let scaled_factor = scaled_args[1];
  return Vector2_set(scaled_dst, ux_f64(scaled_dst) + ux_f64(scaled_src) * scaled_factor,
      ux_f64(scaled_dst + Vector2.y) + ux_f64(scaled_src + Vector2.y) * scaled_factor);
}

function Vector2_subScalar(sub_scalar_dst, ...sub_scalar_args) {
  let sub_scalar_value = sub_scalar_args[0];
  return Vector2_set(sub_scalar_dst, ux_f64(sub_scalar_dst) - sub_scalar_value,
      ux_f64(sub_scalar_dst + Vector2.y) - sub_scalar_value);
}

function Vector2_divideScalar(div_scalar_dst, ...div_scalar_args) {
  return Vector2_multiplyScalar(div_scalar_dst, 1.0 / div_scalar_args[0]);
}

function Vector2_negate(negate_dst) {
  return Vector2_multiplyScalar(negate_dst, 0.0 - 1.0);
}

function Vector2_lerpVectors(blend_dst, ...blend_args) {
  let blend_a = f64_floor_i64(blend_args[0]);
  let blend_b = f64_floor_i64(blend_args[1]);
  let blend_alpha = blend_args[2];
  let blend_ax = ux_f64(blend_a);
  let blend_ay = ux_f64(blend_a + Vector2.y);
  return Vector2_set(blend_dst, blend_ax + (ux_f64(blend_b) - blend_ax) * blend_alpha,
      blend_ay + (ux_f64(blend_b + Vector2.y) - blend_ay) * blend_alpha);
}

function Vector2_limit(limit_value, ...limit_args) {
  let limit_low = limit_args[0];
  let limit_high = limit_args[1];
  let limit_result = limit_value;
  if (limit_value > limit_high || (limit_value == 0.0 && limit_high == 0.0 &&
      1.0 / limit_value > 1.0 / limit_high)) { limit_result = limit_high; }
  if (limit_result < limit_low || (limit_result == 0.0 && limit_low == 0.0 &&
      1.0 / limit_result < 1.0 / limit_low)) { limit_result = limit_low; }
  if (limit_low != limit_low || limit_high != limit_high) { limit_result = 0.0 / 0.0; }
  return limit_result;
}

function Vector2_clampScalar(clamp_scalar_dst, ...clamp_scalar_args) {
  return Vector2_set(clamp_scalar_dst,
      Vector2_limit(ux_f64(clamp_scalar_dst), clamp_scalar_args[0], clamp_scalar_args[1]),
      Vector2_limit(ux_f64(clamp_scalar_dst + Vector2.y), clamp_scalar_args[0], clamp_scalar_args[1]));
}

function Vector2_clampLength(clamp_length_dst, ...clamp_length_args) {
  let clamp_length_actual = Vector2_length(clamp_length_dst);
  let clamp_length_divisor = clamp_length_actual;
  if (clamp_length_divisor == 0.0 || clamp_length_divisor != clamp_length_divisor) {
    clamp_length_divisor = 1.0;
  }
  let clamp_length_normal = Vector2_divideScalar(clamp_length_dst, clamp_length_divisor);
  return Vector2_multiplyScalar(clamp_length_normal,
      Vector2_limit(clamp_length_actual, clamp_length_args[0], clamp_length_args[1]));
}

function Vector2_setX(set_x_dst, ...set_x_args) {
  return Vector2_setComponent(set_x_dst, 0.0, set_x_args[0]);
}

function Vector2_setY(set_y_dst, ...set_y_args) {
  return Vector2_setComponent(set_y_dst, 1.0, set_y_args[0]);
}

function Vector2_min(min_dst, ...min_args) {
  let min_src = min_args[0];
  let min_bottom = (0.0 - 1.0) / 0.0;
  return Vector2_set(min_dst,
      Vector2_limit(ux_f64(min_dst), min_bottom, ux_f64(min_src)),
      Vector2_limit(ux_f64(min_dst + Vector2.y), min_bottom, ux_f64(min_src + Vector2.y)));
}

function Vector2_max(max_dst, ...max_args) {
  let max_src = max_args[0];
  return Vector2_set(max_dst,
      Vector2_limit(ux_f64(max_dst), ux_f64(max_src), 1.0 / 0.0),
      Vector2_limit(ux_f64(max_dst + Vector2.y), ux_f64(max_src + Vector2.y), 1.0 / 0.0));
}

function Vector2_random(random_dst, ...random_args) {
  return Vector2_set(random_dst, random_args[0], random_args[1]);
}

function Vector2_clone(clone_dst, ...clone_args) {
  return Vector2_copy(clone_dst, clone_args[0]);
}

function Vector2_floor(floor_dst) {
  return Vector2_rounding(floor_dst, 0.0);
}

function Vector2_ceil(ceil_dst) {
  return Vector2_rounding(ceil_dst, 1.0);
}

function Vector2_round(round_mutable) {
  return Vector2_rounding(round_mutable, 2.0);
}

function Vector2_roundToZero(truncate_dst) {
  return Vector2_rounding(truncate_dst, 3.0);
}
