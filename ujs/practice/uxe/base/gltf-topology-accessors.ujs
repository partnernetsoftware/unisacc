// Accept either an owned sparse descriptor or a borrowed dense descriptor.
// hasIndex distinguishes an implicit stream from a descriptor at address 0.
native function GltfLoader_accessorTriangles(mode:i64,position:i64,index:i64,hasIndex:i64,out:i64,capacity:i64) i64 {
  if(!loading_span(position,GltfAccessor.size) || (hasIndex!=0 && hasIndex!=1) ||
     capacity<0 || capacity>6291456/4 || !loading_span(out,capacity*4) ||
     !file_disjoint(out,capacity*4,position,GltfAccessor.size)) { return 0-1; }
  if(ux_u32(position+GltfAccessor.component)!=5126 || ux_u32(position+GltfAccessor.lanes)!=3 ||
     ux_u32(position+GltfAccessor.normalized)!=0 || ux_u32(position+GltfAccessor.elementBytes)!=12) { return 0-1; }
  let vertices=ux_u32(position+GltfAccessor.count);
  let pos=ux_u32(position+GltfAccessor.bytes);
  let stride=ux_u32(position+GltfAccessor.stride);
  if(vertices<1 || stride<12 || pos>6291456-12 || vertices-1>(6291456-pos-12)/stride ||
     !file_disjoint(out,capacity*4,pos,(vertices-1)*stride+12)) { return 0-1; }
  if(hasIndex==0) { return GltfLoader_triangles(mode,vertices,0,0,vertices,out,capacity); }
  if(!loading_span(index,GltfAccessor.size) || !file_disjoint(out,capacity*4,index,GltfAccessor.size) ||
     ux_u32(index+GltfAccessor.normalized)!=0 || ux_u32(index+GltfAccessor.lanes)!=1) { return 0-1; }
  let component=ux_u32(index+GltfAccessor.component);
  let width=0;
  if(component==5121) { width=1; }
  if(component==5123) { width=2; }
  if(component==5125) { width=4; }
  if(width==0 || ux_u32(index+GltfAccessor.elementBytes)!=width || ux_u32(index+GltfAccessor.stride)!=width) { return 0-1; }
  return GltfLoader_triangles(mode,vertices,ux_u32(index+GltfAccessor.bytes),width,
    ux_u32(index+GltfAccessor.count),out,capacity);
}
