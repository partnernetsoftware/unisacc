// Publish the descriptor only after the complete file has decoded. On error
// the caller retains its previous image and may release the FileLoader slot.
native function ImageLoader_decodePng(file:i64,image:i64,rgba:i64,capacity:i64,scratch:i64,space:i64) i64 {
  if(!loading_span(file,FileLoader.size) || ux_u32(file+FileLoader.state)!=2 || !loading_span(image,ImageResource.size)) { return 0-1; }
  let src=ux_u32(file+FileLoader.bytes);
  let bytes=ux_u32(file+FileLoader.length);
  if(!file_disjoint(file,FileLoader.size,image,ImageResource.size) ||
     !file_disjoint(file,FileLoader.size,rgba,capacity) || !file_disjoint(file,FileLoader.size,scratch,space) ||
     !file_disjoint(image,ImageResource.size,src,bytes) || !file_disjoint(image,ImageResource.size,rgba,capacity) ||
     !file_disjoint(image,ImageResource.size,scratch,space)) { return 0-1; }
  let result=PngDecode_rgba8(src,bytes,rgba,capacity,scratch,space);
  if(result<0) { return result; }
  let width=ux_u32(scratch+PngHeader.width);
  let height=ux_u32(scratch+PngHeader.height);
  let a=ux_u32_put(image+ImageResource.rgba,rgba);
  let b=ux_u32_put(image+ImageResource.width,width);
  let c=ux_u32_put(image+ImageResource.height,height);
  let d=ux_u32_put(image+ImageResource.rowBytes,width*4);
  return image;
}
