// Publish the descriptor only after the complete file has decoded. On error
// the caller retains its previous image and may release the FileLoader slot.
native function ImageLoader_decodePng(file:i64,image:i64,rgba:i64,capacity:i64,scratch:i64,space:i64) i64 {
  if(!image_file_ready(file,image,rgba,capacity,scratch,space)) { return 0-1; }
  let src=ux_u32(file+FileLoader.bytes);
  let bytes=ux_u32(file+FileLoader.length);
  let result=PngDecode_rgba8(src,bytes,rgba,capacity,scratch,space);
  if(result<0) { return result; }
  return image_file_publish(image,rgba,ux_u32(scratch+PngHeader.width),ux_u32(scratch+PngHeader.height));
}
