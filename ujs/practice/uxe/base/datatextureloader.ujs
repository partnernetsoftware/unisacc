// The selected parser supplies packed RGBA8 bytes. No format is inferred.
native function DataTextureLoader_rgba8(data:i64,bytes:i64,width:i64,height:i64,source:i64) i64 {
  if(!loading_span(source,GpuTextureSource.size) || data<0 || bytes<0 || data>6291456-bytes ||
     width<1 || width>4096 || height<1 || height>4096 || bytes!=width*height*4 ||
     !file_disjoint(data,bytes,source,GpuTextureSource.size)) { return 0-1; }
  let w=ux_u32_put(source+GpuTextureSource.width,width);
  let h=ux_u32_put(source+GpuTextureSource.height,height);
  let f=ux_u32_put(source+GpuTextureSource.filter,1);
  let s=ux_u32_put(source+GpuTextureSource.wrapS,0);
  let t=ux_u32_put(source+GpuTextureSource.wrapT,0);
  let p=ux_u32_put(source+GpuTextureSource.rgba,data);
  return source;
}
