// Inserts the base's GLSL configuration after the version line. Returns the
// byte count for a GpuShaderSource fragment, or -1 without changing output.
native function NativeColorCorrection_config(fragment:i64,fragmentBytes:i64,config:i64,configBytes:i64,out:i64,capacity:i64) i64 {
  if(fragmentBytes<=16 || fragmentBytes>4096 || configBytes<1 || configBytes>4096 ||
     capacity<1 || capacity>4096 || fragmentBytes+configBytes>capacity ||
     fragment<0 || fragment>6291456-fragmentBytes ||
     config<0 || config>6291456-configBytes || out<0 || out>6291456-capacity ||
     composer_alias(out,capacity,fragment,fragmentBytes) ||
     composer_alias(out,capacity,config,configBytes)) { return 0-1; }
  let version=[35,118,101,114,115,105,111,110,32,51,48,48,32,101,115,10];
  let i=0;
  while(i<16) {
    if(ux_u8(fragment+i)!=version[i]) { return 0-1; }
    i=i+1;
  }
  if(ux_u8(config+configBytes-1)!=10) { return 0-1; }
  let prefix=uxe_copy_record(out,fragment,16);
  let inserted=uxe_copy_record(out+16,config,configBytes);
  let body=uxe_copy_record(out+16+configBytes,fragment+16,fragmentBytes-16);
  return fragmentBytes+configBytes;
}
