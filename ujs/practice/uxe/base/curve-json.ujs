native function Curve_toJSON(curve:i64,dst:i64,end:i64,scratch:i64) i64 {
  if(curve<0 || curve>6291456-CurveArcCache.size || curve%4!=0 ||
     scratch<0 || scratch>6291456-1104 || scratch%8!=0 ||
     (dst<curve+CurveArcCache.size && curve<end) ||
     (scratch<curve+CurveArcCache.size && curve<scratch+1104)) { return 0-1; }
  let divisions=ux_u32(curve+CurveArcCache.arcLengthDivisions);
  let token_base=ObjectJsonToken.size+ObjectJsonType.size;
  let p=json_write_token(dst,end,token_base+CurveJsonToken.header);
  p=json_write_f64(p,end,0.0+divisions,scratch);
  p=json_write_token(p,end,ObjectJsonToken.typedField);
  p=json_write_token(p,end,token_base+CurveJsonToken.base);
  return json_byte(p,end,125);
}

native function Curve_fromJSON(curve:i64,input:i64,end:i64,scratch:i64) i64 {
  if(curve<0 || curve>6291456-CurveArcCache.size || curve%4!=0 ||
     input<0 || input>=end || end>6291456 || scratch<0 || scratch>6291456-120 ||
     (scratch<end && input<scratch+120) ||
     (scratch<curve+CurveArcCache.size && curve<scratch+120)) { return 0-1; }
  let last=json_value_end(input,end);
  if(last<0 || json_space(last,end)!=end) { return 0-1; }
  let header=ObjectJsonToken.size+ObjectJsonType.size+CurveJsonToken.header;
  let written=json_write_token(scratch,scratch+120,header);
  let field=json_find_key(input,end,written-20,18);
  let value=json_read_number(field,end);
  if(value!=value || value<1.0 || value>4294967295.0) { return 0-1; }
  let divisions=f64_floor_i64(value);
  if(value!=0.0+divisions) { return 0-1; }
  let updated=ux_u32_put(curve+CurveArcCache.arcLengthDivisions,divisions);
  return curve;
}
