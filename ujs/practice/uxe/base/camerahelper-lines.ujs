native function camera_helper_line_source(at:i64,bytes:i64,align:i64,draw:i64,stream:i64) i64 {
  return helper_buffer_span(at,bytes,align) && helper_buffer_disjoint(at,bytes,draw,SceneDrawItem.size) &&
    helper_buffer_disjoint(at,bytes,stream,SceneLineStream.size);
}

// A CameraHelper is an unindexed list of colored segments. The helper's
// world matrix is borrowed, so moving the camera does not rebuild geometry.
native function CameraHelper_bindLineStream(helper:i64,draw:i64,stream:i64,projection:i64) i64 {
  if(!helper_buffer_span(draw,SceneDrawItem.size,4) || !helper_buffer_span(stream,SceneLineStream.size,4) ||
     !helper_buffer_disjoint(draw,SceneDrawItem.size,stream,SceneLineStream.size) ||
     !camera_helper_line_source(helper,CameraHelper.size,4,draw,stream) ||
     !camera_helper_line_source(projection,128,8,draw,stream) ||
     ux_u32(helper+CameraHelper.active)!=1 || ux_u32(helper+CameraHelper.count)!=50) { return 0-1; }
  let positions=ux_u32(helper+CameraHelper.positions);
  let colors=ux_u32(helper+CameraHelper.colors);
  let world=ux_u32(helper+CameraHelper.matrix);
  if(!camera_helper_line_source(positions,600,4,draw,stream) ||
     !camera_helper_line_source(colors,600,4,draw,stream) ||
     !camera_helper_line_source(world,128,8,draw,stream)) { return 0-1; }
  let m=ux_u32_put(draw+SceneDrawItem.worldMatrix,world);
  let a=ux_u32_put(stream+SceneLineStream.positions,positions);
  let b=ux_u32_put(stream+SceneLineStream.positionStride,12);
  let c=ux_u32_put(stream+SceneLineStream.colors,colors);
  let d=ux_u32_put(stream+SceneLineStream.colorStride,12);
  let e=ux_u32_put(stream+SceneLineStream.vertexCount,50);
  let f=ux_u32_put(stream+SceneLineStream.indices,0);
  let g=ux_u32_put(stream+SceneLineStream.indexCount,0);
  let h=ux_u32_put(stream+SceneLineStream.indexBytes,0);
  let i=ux_u32_put(stream+SceneLineStream.viewProjection,projection);
  let j=ux_u32_put(stream+SceneLineStream.topology,2);
  return stream;
}
