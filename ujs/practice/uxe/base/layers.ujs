function Layers_init(layer_dst) {
  let layer_initialized=ux_u32_put(layer_dst+Layers.mask,1);
  return layer_dst;
}

function Layers_set(layer_set,...layer_set_args) {
  let layer_set_write=ux_u32_put(layer_set+Layers.mask,u32_shl(1,layer_set_args[0]));
  return layer_set;
}

function Layers_enable(layer_enable,...layer_enable_args) {
  let layer_enabled=ux_u32_put(layer_enable+Layers.mask,
    u32_or(ux_u32(layer_enable+Layers.mask),u32_shl(1,layer_enable_args[0])));
  return layer_enable;
}

function Layers_enableAll(layer_all) {
  let layer_all_write=ux_u32_put(layer_all+Layers.mask,4294967295);
  return layer_all;
}

function Layers_toggle(layer_toggle,...layer_toggle_args) {
  let layer_toggled=ux_u32_put(layer_toggle+Layers.mask,
    u32_xor(ux_u32(layer_toggle+Layers.mask),u32_shl(1,layer_toggle_args[0])));
  return layer_toggle;
}

function Layers_disable(layer_disable,...layer_disable_args) {
  let layer_bit=u32_shl(1,layer_disable_args[0]);
  let layer_disabled=ux_u32_put(layer_disable+Layers.mask,
    u32_and(ux_u32(layer_disable+Layers.mask),u32_xor(4294967295,layer_bit)));
  return layer_disable;
}

function Layers_disableAll(layer_none) {
  let layer_none_write=ux_u32_put(layer_none+Layers.mask,0);
  return layer_none;
}

function Layers_test(layer_test,...layer_test_args) {
  return u32_and(ux_u32(layer_test+Layers.mask),ux_u32(layer_test_args[0]+Layers.mask))!=0;
}

function Layers_isEnabled(layer_query,...layer_query_args) {
  return u32_and(ux_u32(layer_query+Layers.mask),u32_shl(1,layer_query_args[0]))!=0;
}
