// A portable cube target descriptor. Live GPU ids are supplied by the caller.
struct CubeCameraTargetJson {
  edge: u32;
  faces: u32;
}

native function cube_target_json_key(at:i64,field:i64) i64 {
  let names=[115,105,122,101,102,97,99,101,115];
  let from=field*4;
  let count=4+field;
  let i=0;
  while(i<count) { let saved=ux_u8_put(at+i,names[from+i]); i=i+1; }
  return count;
}

native function cube_target_json_valid(size:i64,faces:i64) i64 {
  return size>=1 && size<=2048 && faces==6;
}

native function CubeCamera_writeTargetJSON(at:i64,dst:i64,end:i64,scratch:i64) i64 {
  if(!helper_buffer_span(at,8,4) || end<=dst || !helper_buffer_span(dst,end-dst,1) ||
     !helper_buffer_span(scratch,1120,8) || !helper_buffer_disjoint(at,8,dst,end-dst) ||
     !helper_buffer_disjoint(at,8,scratch,1120) ||
     !helper_buffer_disjoint(dst,end-dst,scratch,1120)) { return 0-1; }
  let size=ux_u32(at);
  let faces=ux_u32(at+4);
  if(!cube_target_json_valid(size,faces)) { return 0-1; }
  let p=json_byte(dst,end,123);
  let i=0;
  while(i<2) {
    if(i>0) { p=json_byte(p,end,44); }
    let bytes=cube_target_json_key(scratch,i);
    p=json_write_string(p,end,scratch,bytes);
    p=json_byte(p,end,58);
    let value=ux_u32(at+i*4);
    p=json_write_f64(p,end,0.0+value,scratch+16);
    if(p<0) { return 0-1; }
    i=i+1;
  }
  return json_byte(p,end,125);
}

native function CubeCamera_readTargetJSON(at:i64,input:i64,end:i64,scratch:i64) i64 {
  if(!helper_buffer_span(at,8,4) || end<=input || !helper_buffer_span(input,end-input,1) ||
     !helper_buffer_span(scratch,8,4) || !helper_buffer_disjoint(at,8,input,end-input) ||
     !helper_buffer_disjoint(at,8,scratch,8) ||
     !helper_buffer_disjoint(input,end-input,scratch,8)) { return 0-1; }
  let root=json_space(input,end);
  let stop=json_value_end(root,end);
  if(root<0 || stop<0 || json_space(stop,end)!=end) { return 0-1; }
  let values=[0,0];
  let i=0;
  while(i<2) {
    let bytes=cube_target_json_key(scratch,i);
    let valueAt=json_find_key(root,stop,scratch,bytes);
    if(valueAt<0) { return 0-1; }
    let number=json_read_number(valueAt,stop);
    if(!(number>=1.0 && number<=2048.0)) { return 0-1; }
    let value=f64_floor_i64(number);
    if(number!=0.0+value) { return 0-1; }
    values[i]=value;
    i=i+1;
  }
  if(!cube_target_json_valid(values[0],values[1])) { return 0-1; }
  let size=ux_u32_put(at,values[0]);
  let faces=ux_u32_put(at+4,values[1]);
  return at;
}
