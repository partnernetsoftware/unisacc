// Sample the SMAA 1x axis-aligned area table. Distances are square-rooted
// by the search stage. Crossing edge values are quarter-strength buckets.
native function SMAAPass_areaWeights(src:i64,dx:f64,dy:f64,ex:i64,ey:i64) i64 {
  if(src<0 || src>6291456-160*560*4 || !(dx>=0.0 && dx<16.0 && dy>=0.0 && dy<16.0) ||
     ex<0 || ex>4 || ey<0 || ey>4) { return 0-1; }
  let x=16*ex+f64_floor_i64(dx);
  let y=16*ey+f64_floor_i64(dy);
  let fx=dx-1.0*f64_floor_i64(dx);
  let fy=dy-1.0*f64_floor_i64(dy);
  let i=src+4*(y*160+x);
  let channel=0;
  let packed=0;
  while(channel<2) {
    let a=ux_u8(i+channel);
    let b=ux_u8(i+channel+4);
    let c=ux_u8(i+channel+640);
    let d=ux_u8(i+channel+644);
    let top=1.0*a+fx*(b-a);
    let bottom=1.0*c+fx*(d-c);
    let component=f64_floor_i64(top+fy*(bottom-top)+0.5);
    packed=packed+component*(1+255*channel);
    channel=channel+1;
  }
  return packed;
}
