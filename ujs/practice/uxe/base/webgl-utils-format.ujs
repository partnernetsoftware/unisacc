// WebGL2 texture upload enums. The three fields are published together only
// for a supported combination; refusals preserve the previous result.
struct WebGLTextureFormat {
  internal: u32;
  external: u32;
  dataType: u32;
}

native function webgl_utils_write(out:i64,internal:i64,external:i64,dataType:i64) i64 {
  let a=ux_u32_put(out+WebGLTextureFormat.internal,internal);
  let b=ux_u32_put(out+WebGLTextureFormat.external,external);
  let c=ux_u32_put(out+WebGLTextureFormat.dataType,dataType);
  return out;
}
