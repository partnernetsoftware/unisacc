// Stable merge order preserves traversal order for equal distances.
native function ray_sort_hits(out:i64,work:i64,count:i64,stride:i64,distance:i64) i64 {
  let read=out;
  let write=work;
  let width=1;
  while(width<count) {
    let first=0;
    while(first<count) {
      let middle=first+width;
      let end=middle+width;
      if(middle>count) { middle=count; }
      if(end>count) { end=count; }
      let left=first;
      let right=middle;
      let i=first;
      while(i<end) {
        let chosen=right;
        if(left<middle && (right>=end ||
           ux_f64(read+left*stride+distance)<=ux_f64(read+right*stride+distance))) {
          chosen=left;
          left=left+1;
        } else { right=right+1; }
        let copied=uxe_copy_record(write+i*stride,read+chosen*stride,stride);
        i=i+1;
      }
      first=end;
    }
    let before=read;
    read=write;
    write=before;
    width=width*2;
  }
  if(read!=out) { let copy=uxe_copy_record(out,read,count*stride); }
  return count;
}
