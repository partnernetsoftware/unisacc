struct ArrayCamera {
  cameras: u32;
  count: u32;
}

// Camera handles are read from caller-owned contiguous u32 storage.
native function ArrayCamera_init(array:i64,cameras:i64,count:i64) i64 {
  if(array<0 || array>6291456-ArrayCamera.size || array%4!=0 ||
     cameras<0 || cameras>6291456 || cameras%4!=0 ||
     count<0 || count>(6291456-cameras)/4 ||
     (count!=0 && array<cameras+count*4 && cameras<array+ArrayCamera.size)) { return 0-1; }
  let pointer=ux_u32_put(array+ArrayCamera.cameras,cameras);
  let size=ux_u32_put(array+ArrayCamera.count,count);
  return array;
}

native function ArrayCamera_getCamera(array_get:i64,array_index:i64) i64 {
  if(array_index<0 || array_index>=ux_u32(array_get+ArrayCamera.count)) { return 0-1; }
  return ux_u32(ux_u32(array_get+ArrayCamera.cameras)+array_index*4);
}
