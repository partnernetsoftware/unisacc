function ux_sin(angle) {
  let radians = angle;
  let sum = 0.0 / 0.0;
  if (radians >= 0.0 - 2048.0 && radians <= 2048.0) {
    while (radians > 3.141592653589793) {
      radians = radians - 6.283185307179586;
    }
    while (radians < 0.0 - 3.141592653589793) {
      radians = radians + 6.283185307179586;
    }
    let square = radians * radians;
    let term = radians;
    sum = radians;
    let n = 2;
    while (n <= 22) {
      term = (0.0 - term) * square / (n * (n + 1));
      sum = sum + term;
      n = n + 2;
    }
  }
  return sum;
}
