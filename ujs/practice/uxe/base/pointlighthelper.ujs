struct PointLightHelper {
  geometry: u32;
  matrix: u32;
  active: u32;
  red: f64;
  green: f64;
  blue: f64;
}

// The caller updates lightMatrix before update and supplies linear RGB.
// A negative-one override uses the light's current color.
native function PointLightHelper_update(helper:i64,lightRGB:i64,overrideRGB:i64) i64 {
  if(!light_helper_span(helper,PointLightHelper.size,8) ||
     ux_u32(helper+PointLightHelper.active)!=1) { return 0-1; }
  let rgb=overrideRGB;
  if(rgb==0-1) { rgb=lightRGB; }
  if(!light_helper_rgb_valid(rgb)) { return 0-1; }
  let c=light_helper_rgb_copy(helper+PointLightHelper.red,rgb);
  return helper;
}

// GeometryBuffers and the live light world matrix remain caller-owned.
native function PointLightHelper_init(helper:i64,geometry:i64,vertices:i64,indices:i64,
    lightMatrix:i64,size:f64,lightRGB:i64,overrideRGB:i64) i64 {
  let rgb=overrideRGB;
  if(rgb==0-1) { rgb=lightRGB; }
  if(!light_helper_span(helper,PointLightHelper.size,8) ||
     !light_helper_span(geometry,GeometryBuffers.size,4) || !light_helper_span(vertices,480,4) ||
     !light_helper_span(indices,96,4) || !light_helper_span(lightMatrix,128,8) ||
     !light_helper_rgb_valid(rgb) || size-size!=0.0 ||
     !light_helper_disjoint(helper,PointLightHelper.size,geometry,GeometryBuffers.size) ||
     !light_helper_disjoint(helper,PointLightHelper.size,vertices,480) ||
     !light_helper_disjoint(helper,PointLightHelper.size,indices,96) ||
     !light_helper_disjoint(helper,PointLightHelper.size,lightMatrix,128) ||
     !light_helper_disjoint(helper,PointLightHelper.size,rgb,24) ||
     !light_helper_disjoint(geometry,GeometryBuffers.size,lightMatrix,128) ||
     !light_helper_disjoint(vertices,480,lightMatrix,128) || !light_helper_disjoint(indices,96,lightMatrix,128) ||
     !light_helper_disjoint(geometry,GeometryBuffers.size,rgb,24) ||
     !light_helper_disjoint(vertices,480,rgb,24) || !light_helper_disjoint(indices,96,rgb,24)) { return 0-1; }
  let buffers=GeometryBuffers_init(geometry,vertices,15,indices,24);
  if(buffers<0) { return 0-1; }
  let mesh=SphereGeometry_generate(buffers,size,4,2,0.0,6.283185307179586,0.0,3.141592653589793);
  if(mesh<0) { return 0-1; }
  let g=ux_u32_put(helper+PointLightHelper.geometry,geometry);
  let w=ux_u32_put(helper+PointLightHelper.matrix,lightMatrix);
  let c=light_helper_rgb_copy(helper+PointLightHelper.red,rgb);
  let a=ux_u32_put(helper+PointLightHelper.active,1);
  return helper;
}

native function PointLightHelper_dispose(helper:i64) i64 {
  if(!light_helper_span(helper,PointLightHelper.size,8) ||
     ux_u32(helper+PointLightHelper.active)!=1) { return 0-1; }
  let a=ux_u32_put(helper+PointLightHelper.active,0);
  return 0;
}
