// Prepares the selected-surface mask using a packed scene-depth texel.
// viewDistance is -viewPosition.z. Background remains the caller's clear color.
native function OutlinePass_depthMask(packed:i64,viewDistance:f64,near:f64,far:f64,perspective:i64) i64 {
  if(packed<0 || packed>4294967295 ||
     !(near>0.0 && far>near && far-far==0.0) ||
     !(viewDistance>=near && viewDistance<=far) ||
     (perspective!=0 && perspective!=1)) { return 0-1; }
  let r=packed%256;
  let g=(packed/256)%256;
  let b=(packed/65536)%256;
  let a=packed/16777216;
  let depth=(a+b/256.0+g/65536.0+r/16777216.0)/256.0;
  let sceneDistance=near+(far-near)*depth;
  if(perspective==1) {
    sceneDistance=near/(1.0-depth*(1.0-near/far));
  }
  if(viewDistance>sceneDistance) { return 4294967040; }
  return 4294901760;
}
