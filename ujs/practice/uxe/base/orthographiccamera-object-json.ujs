native function ortho_json_key(index:i64) i64 {
  if(index<4) { return 16+index; }
  return index-2;
}

native function OrthographicCamera_toJSON(node:i64,lens:i64,uuid:i64,bytes:i64,dst:i64,end:i64,scratch:i64) i64 {
  if(lens%8!=0 || !camera_json_disjoint(lens,OrthographicCamera.size,dst,end) ||
     !camera_json_disjoint(lens,OrthographicCamera.size,scratch,scratch+1104)) { return 0-1; }
  let p=camera_json_begin(node,uuid,bytes,dst,end,scratch,8);
  let i=0;
  while(i<7 && p>=0) {
    p=json_byte(p,end,44);
    let key=ortho_json_key(i);
    p=camera_lens_number(p,end,scratch,key,ux_f64(lens+i*8));
    i=i+1;
  }
  if(ux_u32(lens+OrthographicCamera.viewEnabled)) {
    p=camera_lens_view_write(p,end,scratch,lens+OrthographicCamera.viewFullWidth);
  }
  p=json_byte(p,end,125);
  return json_byte(p,end,125);
}

native function OrthographicCamera_fromJSON(node:i64,lens:i64,input:i64,end:i64,scratch:i64) i64 {
  if(input<0 || end<=input || end>6291456 || lens%8!=0 || scratch%8!=0 ||
     !camera_json_disjoint(scratch,320,input,end) ||
     !camera_json_disjoint(lens,OrthographicCamera.size,input,end) ||
     !camera_json_disjoint(lens,OrthographicCamera.size,scratch,scratch+320) ||
     !camera_json_disjoint(node,Object3D.size,scratch,scratch+320) ||
     !camera_json_disjoint(lens,OrthographicCamera.size,node,node+Object3D.size)) { return 0-1; }
  let matrix=ux_u32(node+Object3D.localMatrix);
  if(!camera_json_disjoint(matrix,128,scratch,scratch+320) ||
     !camera_json_disjoint(lens,OrthographicCamera.size,matrix,matrix+128)) { return 0-1; }
  let object=LoaderJson_find(json_space(input,end),end,scratch,1701470831,29795,0,6);
  let limit=json_value_end(object,end);
  if(object<0 || limit<0) { return 0-2; }
  let staged=scratch+160;
  let i=0;
  while(i<7) {
    let id=ortho_json_key(i);
    let at=camera_lens_field(object,limit,scratch,id);
    let value=json_read_number(at,limit);
    if(value-value!=0.0) { return 0-2; }
    let field=ux_f64_put(staged+i*8,value);
    i=i+1;
  }
  if(ux_f64(staged+OrthographicCamera.zoom)<=0.0 ||
     ux_f64(staged+OrthographicCamera.far)<=ux_f64(staged+OrthographicCamera.near) ||
     ux_f64(staged+OrthographicCamera.left)==ux_f64(staged+OrthographicCamera.right) ||
     ux_f64(staged+OrthographicCamera.top)==ux_f64(staged+OrthographicCamera.bottom)) { return 0-2; }
  let enabled=camera_lens_view_read(object,limit,scratch,staged+OrthographicCamera.viewFullWidth);
  if(enabled<0) { return 0-2; }
  let flag=ux_u32_put(staged+OrthographicCamera.viewEnabled,enabled);
  if(camera_json_restore(node,input,end,scratch,8)<0) { return 0-2; }
  return uxe_copy_record(lens,staged,OrthographicCamera.size);
}
