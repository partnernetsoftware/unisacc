// Attribute and group tables start with count and capacity. Attribute rows
// are (semantic, view); group rows are (start, count, material).
native function BufferGeometry_init(g_dst:i64,g_attributes:i64,g_attribute_cap:i64,
    g_groups:i64,g_group_cap:i64) i64 {
  if(g_attribute_cap<0 || g_attribute_cap>786431 || g_group_cap<0 || g_group_cap>524287) { return 0-1; }
  let g_record=ux_span(g_dst,BufferGeometry.size);
  let g_attrs=ux_span(g_attributes,8+8*g_attribute_cap);
  let g_group_span=ux_span(g_groups,8+12*g_group_cap);
  let g_slot=0;
  while(g_slot<BufferGeometry.size) {
    let g_zero=ux_u32_put(g_dst+g_slot,0);
    g_slot=g_slot+4;
  }
  let g_attributes_at=ux_u32_put(g_dst+BufferGeometry.attributes,g_attributes);
  let g_groups_at=ux_u32_put(g_dst+BufferGeometry.groups,g_groups);
  let g_no_attributes=ux_u32_put(g_attributes,0);
  let g_attr_room=ux_u32_put(g_attributes+4,g_attribute_cap);
  let g_no_groups=ux_u32_put(g_groups,0);
  let g_group_room=ux_u32_put(g_groups+4,g_group_cap);
  let g_all=ux_u32_put(g_dst+BufferGeometry.drawCount,4294967295);
  return g_dst;
}

native function BufferGeometry_find(g_find:i64,g_token:i64) i64 {
  let g_table=ux_u32(g_find+BufferGeometry.attributes);
  let g_end=ux_u32(g_table);
  let g_row=0;
  while(g_row<g_end) {
    let g_entry=g_table+8+8*g_row;
    if(ux_u32(g_entry)==g_token) { return g_entry; }
    g_row=g_row+1;
  }
  return 0-1;
}

native function BufferGeometry_setAttribute(g_set:i64,g_name:i64,g_view:i64) i64 {
  if(g_name<0 || g_name>4294967295 || g_view<0 || g_view>6291456-BufferAttribute.size) { return 0-1; }
  let g_attr_table=ux_u32(g_set+BufferGeometry.attributes);
  let g_attr_count=ux_u32(g_attr_table);
  let g_attr_row=BufferGeometry_find(g_set,g_name);
  if(g_attr_row<0) {
    if(g_attr_count==ux_u32(g_attr_table+4)) { return 0-2; }
    g_attr_row=g_attr_table+8+8*g_attr_count;
    let g_wrote_name=ux_u32_put(g_attr_row,g_name);
    let g_new_count=ux_u32_put(g_attr_table,g_attr_count+1);
  }
  let g_wrote=ux_u32_put(g_attr_row+4,g_view);
  return g_set;
}

function BufferGeometry_getAttribute(g_get,...g_get_args) {
  let g_get_row=BufferGeometry_find(g_get,g_get_args[0]);
  let g_get_result=0-1;
  if(g_get_row>=0) { g_get_result=ux_u32(g_get_row+4); }
  return g_get_result;
}

function BufferGeometry_hasAttribute(g_has,...g_has_args) {
  return BufferGeometry_find(g_has,g_has_args[0])>=0;
}

function BufferGeometry_deleteAttribute(g_del,...g_del_args) {
  let g_del_row=BufferGeometry_find(g_del,g_del_args[0]);
  if(g_del_row>=0) {
    let g_del_table=ux_u32(g_del+BufferGeometry.attributes);
    let g_del_count=ux_u32(g_del_table)-1;
    let g_del_last=g_del_table+8+8*g_del_count;
    let g_del_name=ux_u32_put(g_del_row,ux_u32(g_del_last));
    let g_del_view=ux_u32_put(g_del_row+4,ux_u32(g_del_last+4));
    let g_del_publish=ux_u32_put(g_del_table,g_del_count);
  }
  return g_del;
}

function BufferGeometry_setIndex(g_index,...g_index_args) {
  let g_index_write=ux_u32_put(g_index+BufferGeometry.index,g_index_args[0]+1);
  return g_index;
}

function BufferGeometry_getIndex(g_index_get) {
  return ux_u32(g_index_get+BufferGeometry.index)-1;
}

native function BufferGeometry_addGroup(g_group:i64,g_start:i64,g_count:i64,g_material:i64) i64 {
  let g_group_table=ux_u32(g_group+BufferGeometry.groups);
  let g_group_count=ux_u32(g_group_table);
  if(g_group_count>=ux_u32(g_group_table+4)) { return 0-2; }
  let g_group_row=g_group_table+8+12*g_group_count;
  let g_wrote_start=ux_u32_put(g_group_row,g_start);
  let g_wrote_count=ux_u32_put(g_group_row+4,g_count);
  let g_wrote_material=ux_u32_put(g_group_row+8,g_material);
  let g_publish=ux_u32_put(g_group_table,g_group_count+1);
  return g_group;
}

function BufferGeometry_clearGroups(g_clear) {
  let g_wipe=ux_u32_put(ux_u32(g_clear+BufferGeometry.groups),0);
  return g_clear;
}

function BufferGeometry_setDrawRange(g_draw,...g_draw_args) {
  let g_draw_start=ux_u32_put(g_draw+BufferGeometry.drawStart,g_draw_args[0]);
  let g_draw_count=ux_u32_put(g_draw+BufferGeometry.drawCount,g_draw_args[1]);
  return g_draw;
}

native function BufferGeometry_coordinate(g_coordinate:i64,g_coordinate_kind:i64) f64 {
  if(g_coordinate_kind==9) { return ux_f32(g_coordinate); }
  return ux_f64(g_coordinate);
}

// The caller selects the position semantic; optional destinations use -1.
native function BufferGeometry_bounds(g_bounds:i64,g_semantic:i64,g_box:i64,g_sphere:i64) i64 {
  let g_position=BufferGeometry_getAttribute(g_bounds,g_semantic);
  if(g_position<0) { return 0-1; }
  let g_kind=ux_u32(g_position+BufferAttribute.componentType);
  if(ux_u32(g_position+BufferAttribute.itemSize)<3 || (g_kind!=9 && g_kind!=10)) { return 0-1; }
  let g_base=ux_u32(g_position+BufferAttribute.data);
  let g_stride=ux_u32(g_position+BufferAttribute.stride);
  let g_points=ux_u32(g_position+BufferAttribute.count);
  let g_width=4;
  if(g_kind==10) { g_width=8; }
  let g_inf=1.0/0.0;
  let g_low=[g_inf,g_inf,g_inf];
  let g_high=[0.0-g_inf,0.0-g_inf,0.0-g_inf];
  let g_i=0;
  while(g_i<g_points) {
    let g_axis=0;
    while(g_axis<3) {
      let g_v=BufferGeometry_coordinate(g_base+g_i*g_stride+g_axis*g_width,g_kind);
      if(g_v<g_low[g_axis]) { g_low[g_axis]=g_v; }
      if(g_v>g_high[g_axis]) { g_high[g_axis]=g_v; }
      g_axis=g_axis+1;
    }
    g_i=g_i+1;
  }
  if(g_box>=0) {
    let g_out_axis=0;
    while(g_out_axis<3) {
      let g_store_low=ux_f64_put(g_box+8*g_out_axis,g_low[g_out_axis]);
      let g_store_high=ux_f64_put(g_box+24+8*g_out_axis,g_high[g_out_axis]);
      g_out_axis=g_out_axis+1;
    }
    let g_box_field=ux_u32_put(g_bounds+BufferGeometry.boundingBox,g_box+1);
  }
  if(g_sphere>=0) {
    let g_center=[0.0,0.0,0.0];
    if(g_points>0) {
      g_center[0]=(g_low[0]+g_high[0])*0.5;
      g_center[1]=(g_low[1]+g_high[1])*0.5;
      g_center[2]=(g_low[2]+g_high[2])*0.5;
    }
    let g_max_squared=0.0;
    let g_s=0;
    while(g_s<g_points) {
      let g_at=g_base+g_s*g_stride;
      let g_x=BufferGeometry_coordinate(g_at,g_kind)-g_center[0];
      let g_y=BufferGeometry_coordinate(g_at+g_width,g_kind)-g_center[1];
      let g_z=BufferGeometry_coordinate(g_at+2*g_width,g_kind)-g_center[2];
      let g_length2=g_x*g_x+g_y*g_y+g_z*g_z;
      if(g_length2>g_max_squared) { g_max_squared=g_length2; }
      g_s=g_s+1;
    }
    let g_sx=ux_f64_put(g_sphere,g_center[0]);
    let g_sy=ux_f64_put(g_sphere+8,g_center[1]);
    let g_sz=ux_f64_put(g_sphere+16,g_center[2]);
    let g_radius=ux_f64_put(g_sphere+24,f64_sqrt(g_max_squared));
    let g_sphere_field=ux_u32_put(g_bounds+BufferGeometry.boundingSphere,g_sphere+1);
  }
  return g_bounds;
}

function BufferGeometry_computeBoundingBox(g_compute_box,...g_compute_box_args) {
  return BufferGeometry_bounds(g_compute_box,g_compute_box_args[0],g_compute_box_args[1],0-1);
}

function BufferGeometry_computeBoundingSphere(g_compute_sph,...g_compute_sph_args) {
  return BufferGeometry_bounds(g_compute_sph,g_compute_sph_args[0],0-1,g_compute_sph_args[1]);
}
