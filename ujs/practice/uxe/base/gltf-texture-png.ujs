native function GltfLoader_decodeTexturePng(source:i64,image:i64,rgba:i64,capacity:i64,scratch:i64,space:i64) i64 {
  if(!loading_span(source,GltfTextureSource.size) || ux_u32(source+GltfTextureSource.mime)!=1 ||
     !loading_span(image,ImageResource.size) ||
     !file_disjoint(source,GltfTextureSource.size,image,ImageResource.size) ||
     !file_disjoint(source,GltfTextureSource.size,rgba,capacity) ||
     !file_disjoint(source,GltfTextureSource.size,scratch,space) ||
     !file_disjoint(image,ImageResource.size,rgba,capacity) ||
     !file_disjoint(image,ImageResource.size,scratch,space)) { return 0-1; }
  let bytes=ux_u32(source+GltfTextureSource.bytes);
  let length=ux_u32(source+GltfTextureSource.length);
  if(!file_disjoint(bytes,length,image,ImageResource.size)) { return 0-1; }
  let decoded=PngDecode_rgba8(bytes,length,rgba,capacity,scratch,space);
  if(decoded<0) { return decoded; }
  let width=ux_u32(scratch+PngHeader.width);
  let height=ux_u32(scratch+PngHeader.height);
  let a=ux_u32_put(image+ImageResource.rgba,rgba);
  let b=ux_u32_put(image+ImageResource.width,width);
  let c=ux_u32_put(image+ImageResource.height,height);
  let d=ux_u32_put(image+ImageResource.rowBytes,width*4);
  return image;
}
