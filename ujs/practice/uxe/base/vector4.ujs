struct Vector4 { x: f64; y: f64; z: f64; w: f64; }

function Vector4_set(v4_destination, ...v4_coordinates) {
  let v4_storage = ux_span(v4_destination, Vector4.size);
  let v4_write_x = ux_f64_put(v4_destination + Vector4.x, v4_coordinates[0]);
  let v4_write_y = ux_f64_put(v4_destination + Vector4.y, v4_coordinates[1]);
  let v4_write_z = ux_f64_put(v4_destination + Vector4.z, v4_coordinates[2]);
  let v4_write_w = ux_f64_put(v4_destination + Vector4.w, v4_coordinates[3]);
  return v4_destination;
}

function Vector4_copy(v4_copy_dst, ...v4_copy_args) {
  let v4_copy_src = v4_copy_args[0];
  return Vector4_set(v4_copy_dst, ux_f64(v4_copy_src), ux_f64(v4_copy_src + Vector4.y),
      ux_f64(v4_copy_src + Vector4.z), ux_f64(v4_copy_src + Vector4.w));
}

function Vector4_componentOperation(v4_op_left, ...v4_op_args) {
  let v4_op_right = v4_op_args[0];
  let v4_operation = v4_op_args[1];
  let v4_op_value = v4_op_left * v4_op_right;
  if (v4_operation == 0.0) { v4_op_value = v4_op_left + v4_op_right; }
  if (v4_operation == 1.0) { v4_op_value = v4_op_left - v4_op_right; }
  return v4_op_value;
}

function Vector4_vectorOperation(v4_binary_dst, ...v4_binary_args) {
  let v4_binary_a = v4_binary_args[0];
  let v4_binary_b = v4_binary_args[1];
  let v4_binary_op = 0.0 + v4_binary_args[2];
  return Vector4_set(v4_binary_dst,
      Vector4_componentOperation(ux_f64(v4_binary_a), ux_f64(v4_binary_b), v4_binary_op),
      Vector4_componentOperation(ux_f64(v4_binary_a + Vector4.y), ux_f64(v4_binary_b + Vector4.y), v4_binary_op),
      Vector4_componentOperation(ux_f64(v4_binary_a + Vector4.z), ux_f64(v4_binary_b + Vector4.z), v4_binary_op),
      Vector4_componentOperation(ux_f64(v4_binary_a + Vector4.w), ux_f64(v4_binary_b + Vector4.w), v4_binary_op));
}

function Vector4_add(v4_add_dst, ...v4_add_args) {
  return Vector4_vectorOperation(v4_add_dst, v4_add_dst, v4_add_args[0], 0);
}

function Vector4_addVectors(v4_sum_dst, ...v4_sum_args) {
  return Vector4_vectorOperation(v4_sum_dst, v4_sum_args[0], v4_sum_args[1], 0);
}

function Vector4_sub(v4_sub_dst, ...v4_sub_args) {
  return Vector4_vectorOperation(v4_sub_dst, v4_sub_dst, v4_sub_args[0], 1);
}

function Vector4_subVectors(v4_difference_dst, ...v4_difference_args) {
  return Vector4_vectorOperation(v4_difference_dst, v4_difference_args[0], v4_difference_args[1], 1);
}

function Vector4_multiply(v4_multiply_dst, ...v4_multiply_args) {
  return Vector4_vectorOperation(v4_multiply_dst, v4_multiply_dst, v4_multiply_args[0], 2);
}

function Vector4_dot(v4_dot_a, ...v4_dot_args) {
  let v4_dot_b = v4_dot_args[0];
  return ux_f64(v4_dot_a) * ux_f64(v4_dot_b) +
      ux_f64(v4_dot_a + Vector4.y) * ux_f64(v4_dot_b + Vector4.y) +
      ux_f64(v4_dot_a + Vector4.z) * ux_f64(v4_dot_b + Vector4.z) +
      ux_f64(v4_dot_a + Vector4.w) * ux_f64(v4_dot_b + Vector4.w);
}

function Vector4_lengthSq(v4_sq_ptr) {
  return Vector4_dot(v4_sq_ptr, v4_sq_ptr);
}

function Vector4_length(v4_length_ptr) {
  return f64_sqrt(Vector4_lengthSq(v4_length_ptr));
}

function Vector4_scalarOperation(v4_scalar_dst, ...v4_scalar_args) {
  let v4_scalar_value = v4_scalar_args[0];
  let v4_scalar_kind = v4_scalar_args[1];
  return Vector4_set(v4_scalar_dst,
      Vector4_componentOperation(ux_f64(v4_scalar_dst), v4_scalar_value, v4_scalar_kind),
      Vector4_componentOperation(ux_f64(v4_scalar_dst + Vector4.y), v4_scalar_value, v4_scalar_kind),
      Vector4_componentOperation(ux_f64(v4_scalar_dst + Vector4.z), v4_scalar_value, v4_scalar_kind),
      Vector4_componentOperation(ux_f64(v4_scalar_dst + Vector4.w), v4_scalar_value, v4_scalar_kind));
}

function Vector4_addScalar(v4_add_scalar_dst, ...v4_add_scalar_args) {
  return Vector4_scalarOperation(v4_add_scalar_dst, v4_add_scalar_args[0], 0.0);
}

function Vector4_subScalar(v4_sub_scalar_dst, ...v4_sub_scalar_args) {
  return Vector4_scalarOperation(v4_sub_scalar_dst, v4_sub_scalar_args[0], 1.0);
}

function Vector4_multiplyScalar(v4_scale_dst, ...v4_scale_args) {
  return Vector4_scalarOperation(v4_scale_dst, v4_scale_args[0], 2.0);
}

function Vector4_divideScalar(v4_div_dst, ...v4_div_args) {
  return Vector4_multiplyScalar(v4_div_dst, 1.0 / v4_div_args[0]);
}

function Vector4_negate(v4_negate_dst) {
  return Vector4_multiplyScalar(v4_negate_dst, 0.0 - 1.0);
}

function Vector4_addScaledVector(v4_scaled_dst, ...v4_scaled_args) {
  let v4_scaled_src = f64_floor_i64(v4_scaled_args[0]);
  let v4_scaled_factor = v4_scaled_args[1];
  return Vector4_set(v4_scaled_dst, ux_f64(v4_scaled_dst) + ux_f64(v4_scaled_src) * v4_scaled_factor,
      ux_f64(v4_scaled_dst + Vector4.y) + ux_f64(v4_scaled_src + Vector4.y) * v4_scaled_factor,
      ux_f64(v4_scaled_dst + Vector4.z) + ux_f64(v4_scaled_src + Vector4.z) * v4_scaled_factor,
      ux_f64(v4_scaled_dst + Vector4.w) + ux_f64(v4_scaled_src + Vector4.w) * v4_scaled_factor);
}

function Vector4_normalize(v4_normal_dst) {
  let v4_normal_len = Vector4_length(v4_normal_dst);
  if (v4_normal_len == 0.0 || v4_normal_len != v4_normal_len) { v4_normal_len = 1.0; }
  return Vector4_divideScalar(v4_normal_dst, v4_normal_len);
}

function Vector4_setLength(v4_set_length_dst, ...v4_set_length_args) {
  let v4_normalized = Vector4_normalize(v4_set_length_dst);
  return Vector4_multiplyScalar(v4_normalized, v4_set_length_args[0]);
}

function Vector4_manhattanLength(v4_taxicab) {
  return ux_math_abs(ux_f64(v4_taxicab)) + ux_math_abs(ux_f64(v4_taxicab + Vector4.y)) +
      ux_math_abs(ux_f64(v4_taxicab + Vector4.z)) + ux_math_abs(ux_f64(v4_taxicab + Vector4.w));
}

function Vector4_setScalar(v4_fill_dst, ...v4_fill_args) {
  let v4_fill_value = v4_fill_args[0];
  return Vector4_set(v4_fill_dst, v4_fill_value, v4_fill_value, v4_fill_value, v4_fill_value);
}

function Vector4_setComponent(v4_component_dst, ...v4_component_args) {
  let v4_component_at = v4_component_args[0];
  let v4_component_status = 0 - 1;
  if (v4_component_at == 0.0 || v4_component_at == 1.0 ||
      v4_component_at == 2.0 || v4_component_at == 3.0) {
    let v4_component_span = ux_span(v4_component_dst, Vector4.size);
    let v4_component_store = ux_f64_put(v4_component_dst + f64_floor_i64(v4_component_at) * 8, v4_component_args[1]);
    v4_component_status = v4_component_dst;
  }
  return v4_component_status;
}

function Vector4_getComponent(v4_read_dst, ...v4_read_args) {
  let v4_read_at = v4_read_args[0];
  let v4_read_value = 0.0 / 0.0;
  if (v4_read_at >= 0 && v4_read_at < 4) { v4_read_value = ux_f64(v4_read_dst + v4_read_at * 8); }
  return v4_read_value;
}

function Vector4_setX(v4_setx_dst, ...v4_setx_args) {
  return Vector4_setComponent(v4_setx_dst, 0.0, v4_setx_args[0]);
}

function Vector4_setY(v4_sety_dst, ...v4_sety_args) {
  return Vector4_setComponent(v4_sety_dst, 1.0, v4_sety_args[0]);
}

function Vector4_setZ(v4_setz_dst, ...v4_setz_args) {
  return Vector4_setComponent(v4_setz_dst, 2.0, v4_setz_args[0]);
}

function Vector4_setW(v4_setw_dst, ...v4_setw_args) {
  return Vector4_setComponent(v4_setw_dst, 3.0, v4_setw_args[0]);
}

function Vector4_clone(v4_clone_dst, ...v4_clone_args) {
  return Vector4_copy(v4_clone_dst, v4_clone_args[0]);
}

function Vector4_lerpVectors(v4_blend_dst, ...v4_blend_args) {
  let v4_blend_a = f64_floor_i64(v4_blend_args[0]);
  let v4_blend_b = f64_floor_i64(v4_blend_args[1]);
  let v4_blend_alpha = v4_blend_args[2];
  let v4_blend_ax = ux_f64(v4_blend_a);
  let v4_blend_ay = ux_f64(v4_blend_a + Vector4.y);
  let v4_blend_az = ux_f64(v4_blend_a + Vector4.z);
  let v4_blend_aw = ux_f64(v4_blend_a + Vector4.w);
  return Vector4_set(v4_blend_dst, v4_blend_ax + (ux_f64(v4_blend_b) - v4_blend_ax) * v4_blend_alpha,
      v4_blend_ay + (ux_f64(v4_blend_b + Vector4.y) - v4_blend_ay) * v4_blend_alpha,
      v4_blend_az + (ux_f64(v4_blend_b + Vector4.z) - v4_blend_az) * v4_blend_alpha,
      v4_blend_aw + (ux_f64(v4_blend_b + Vector4.w) - v4_blend_aw) * v4_blend_alpha);
}

function Vector4_lerp(v4_lerp_dst, ...v4_lerp_args) {
  return Vector4_lerpVectors(v4_lerp_dst, 0.0 + v4_lerp_dst, v4_lerp_args[0], v4_lerp_args[1]);
}

function Vector4_equals(v4_equal_a, ...v4_equals_args) {
  let v4_equal_b = v4_equals_args[0];
  return ux_f64(v4_equal_a) == ux_f64(v4_equal_b) &&
      ux_f64(v4_equal_a + Vector4.y) == ux_f64(v4_equal_b + Vector4.y) &&
      ux_f64(v4_equal_a + Vector4.z) == ux_f64(v4_equal_b + Vector4.z) &&
      ux_f64(v4_equal_a + Vector4.w) == ux_f64(v4_equal_b + Vector4.w);
}

function Vector4_applyMatrix4(v4_matrix_dst, ...v4_matrix_args) {
  let v4_matrix = v4_matrix_args[0];
  let v4_matrix_x = ux_f64(v4_matrix_dst);
  let v4_matrix_y = ux_f64(v4_matrix_dst + Vector4.y);
  let v4_matrix_z = ux_f64(v4_matrix_dst + Vector4.z);
  let v4_matrix_w = ux_f64(v4_matrix_dst + Vector4.w);
  return Vector4_set(v4_matrix_dst,
      ux_f64(v4_matrix) * v4_matrix_x + ux_f64(v4_matrix + 32) * v4_matrix_y +
          ux_f64(v4_matrix + 64) * v4_matrix_z + ux_f64(v4_matrix + 96) * v4_matrix_w,
      ux_f64(v4_matrix + 8) * v4_matrix_x + ux_f64(v4_matrix + 40) * v4_matrix_y +
          ux_f64(v4_matrix + 72) * v4_matrix_z + ux_f64(v4_matrix + 104) * v4_matrix_w,
      ux_f64(v4_matrix + 16) * v4_matrix_x + ux_f64(v4_matrix + 48) * v4_matrix_y +
          ux_f64(v4_matrix + 80) * v4_matrix_z + ux_f64(v4_matrix + 112) * v4_matrix_w,
      ux_f64(v4_matrix + 24) * v4_matrix_x + ux_f64(v4_matrix + 56) * v4_matrix_y +
          ux_f64(v4_matrix + 88) * v4_matrix_z + ux_f64(v4_matrix + 120) * v4_matrix_w);
}

function Vector4_axisAngleValues(v4_angle_dst, ...v4_angle_args) {
  let v4_quat_scalar = v4_angle_args[3];
  let v4_angle = 2.0 * ux_math_acos(v4_quat_scalar);
  let v4_half_sin = f64_sqrt(1.0 - v4_quat_scalar * v4_quat_scalar);
  let v4_axis_x = 1.0;
  let v4_axis_y = 0.0;
  let v4_axis_z = 0.0;
  if (v4_half_sin >= 0.0001 || v4_half_sin != v4_half_sin) {
    v4_axis_x = v4_angle_args[0] / v4_half_sin;
    v4_axis_y = v4_angle_args[1] / v4_half_sin;
    v4_axis_z = v4_angle_args[2] / v4_half_sin;
  }
  return Vector4_set(v4_angle_dst, v4_axis_x, v4_axis_y, v4_axis_z, v4_angle);
}

function Vector4_setAxisAngleFromQuaternion(v4_quat_dst, ...v4_quat_args) {
  let v4_quat = v4_quat_args[0];
  return Vector4_axisAngleValues(v4_quat_dst, ux_f64(v4_quat), ux_f64(v4_quat + 8),
      ux_f64(v4_quat + 16), ux_f64(v4_quat + 24));
}

function Vector4_setAxisAngleFromRotationMatrix(v4_rotation_dst, ...v4_rotation_args) {
  let v4_rotation = v4_rotation_args[0];
  let v4_mxx = ux_f64(v4_rotation);
  let v4_mxy = ux_f64(v4_rotation + 32);
  let v4_mxz = ux_f64(v4_rotation + 64);
  let v4_myx = ux_f64(v4_rotation + 8);
  let v4_myy = ux_f64(v4_rotation + 40);
  let v4_myz = ux_f64(v4_rotation + 72);
  let v4_mzx = ux_f64(v4_rotation + 16);
  let v4_mzy = ux_f64(v4_rotation + 48);
  let v4_mzz = ux_f64(v4_rotation + 80);
  let v4_trace = v4_mxx + v4_myy + v4_mzz;
  let v4_symmetric = ux_math_abs(v4_mxy - v4_myx) < 0.01 &&
      ux_math_abs(v4_mxz - v4_mzx) < 0.01 && ux_math_abs(v4_myz - v4_mzy) < 0.01;
  let v4_identity = v4_symmetric && ux_math_abs(v4_trace - 3.0) < 0.1 &&
      ux_math_abs(v4_mxy + v4_myx) < 0.1 && ux_math_abs(v4_mxz + v4_mzx) < 0.1 &&
      ux_math_abs(v4_myz + v4_mzy) < 0.1;
  // A symmetric half turn gives the axis from a column of (R + I) / 2.
  let v4_rot_x = 0.0;
  let v4_rot_y = 0.0;
  let v4_rot_z = 0.0;
  let v4_rot_w = 1.0;
  if (v4_identity) {
    v4_rot_w = 1.0;
  } else if (v4_symmetric) {
    v4_rot_w = 0.0;
    if (v4_mxx > v4_myy && v4_mxx > v4_mzz) {
      v4_rot_x = f64_sqrt(0.5 * (1.0 + v4_mxx));
      v4_rot_y = (v4_myx + v4_mxy) * 0.25 / v4_rot_x;
      v4_rot_z = (v4_mzx + v4_mxz) * 0.25 / v4_rot_x;
    } else if (v4_myy > v4_mzz) {
      v4_rot_y = f64_sqrt(0.5 * (1.0 + v4_myy));
      v4_rot_x = (v4_myx + v4_mxy) * 0.25 / v4_rot_y;
      v4_rot_z = (v4_mzy + v4_myz) * 0.25 / v4_rot_y;
    } else {
      v4_rot_z = f64_sqrt(0.5 * (1.0 + v4_mzz));
      v4_rot_x = (v4_mzx + v4_mxz) * 0.25 / v4_rot_z;
      v4_rot_y = (v4_mzy + v4_myz) * 0.25 / v4_rot_z;
    }
  } else if (v4_trace > 0.0) {
    let v4_trace_scale = 2.0 * f64_sqrt(v4_trace + 1.0);
    v4_rot_w = 0.25 * v4_trace_scale;
    v4_rot_x = (v4_mzy - v4_myz) / v4_trace_scale;
    v4_rot_y = (v4_mxz - v4_mzx) / v4_trace_scale;
    v4_rot_z = (v4_myx - v4_mxy) / v4_trace_scale;
  } else if (v4_mxx > v4_myy && v4_mxx > v4_mzz) {
    let v4_xscale = 2.0 * f64_sqrt(1.0 + v4_mxx - v4_myy - v4_mzz);
    v4_rot_w = (v4_mzy - v4_myz) / v4_xscale;
    v4_rot_x = 0.25 * v4_xscale;
    v4_rot_y = (v4_mxy + v4_myx) / v4_xscale;
    v4_rot_z = (v4_mxz + v4_mzx) / v4_xscale;
  } else if (v4_myy > v4_mzz) {
    let v4_yscale = 2.0 * f64_sqrt(1.0 + v4_myy - v4_mxx - v4_mzz);
    v4_rot_w = (v4_mxz - v4_mzx) / v4_yscale;
    v4_rot_x = (v4_mxy + v4_myx) / v4_yscale;
    v4_rot_y = 0.25 * v4_yscale;
    v4_rot_z = (v4_myz + v4_mzy) / v4_yscale;
  } else {
    let v4_zscale = 2.0 * f64_sqrt(1.0 + v4_mzz - v4_mxx - v4_myy);
    v4_rot_w = (v4_myx - v4_mxy) / v4_zscale;
    v4_rot_x = (v4_mxz + v4_mzx) / v4_zscale;
    v4_rot_y = (v4_myz + v4_mzy) / v4_zscale;
    v4_rot_z = 0.25 * v4_zscale;
  }
  if (v4_rot_w < 0.0) {
    v4_rot_x = 0.0 - v4_rot_x; v4_rot_y = 0.0 - v4_rot_y;
    v4_rot_z = 0.0 - v4_rot_z; v4_rot_w = 0.0 - v4_rot_w;
  }
  if (v4_rot_w > 1.0) { v4_rot_w = 1.0; }
  return Vector4_axisAngleValues(v4_rotation_dst, v4_rot_x, v4_rot_y, v4_rot_z, v4_rot_w);
}

function Vector4_limitVectors(v4_limited_dst, ...v4_limited_args) {
  let v4_limit_lo = v4_limited_args[0];
  let v4_limit_hi = v4_limited_args[1];
  let v4_limit_mode = v4_limited_args[2];
  let v4_limited_data = [0.0,0.0,0.0,0.0];
  let v4_limit_index = 0;
  while (v4_limit_index < 4) {
    let v4_limit_offset = v4_limit_index * 8;
    let v4_limit_min = (0.0 - 1.0) / 0.0;
    let v4_limit_max = 1.0 / 0.0;
    if (v4_limit_mode != 1) { v4_limit_min = ux_f64(v4_limit_lo + v4_limit_offset); }
    if (v4_limit_mode != 2) { v4_limit_max = ux_f64(v4_limit_hi + v4_limit_offset); }
    v4_limited_data[v4_limit_index] = vector_limit(ux_f64(v4_limited_dst + v4_limit_offset), v4_limit_min, v4_limit_max);
    v4_limit_index = v4_limit_index + 1;
  }
  return Vector4_set(v4_limited_dst, v4_limited_data[0], v4_limited_data[1], v4_limited_data[2], v4_limited_data[3]);
}

function Vector4_clamp(v4_clamp_dst, ...v4_clamp_args) {
  return Vector4_limitVectors(v4_clamp_dst, v4_clamp_args[0], v4_clamp_args[1], 0);
}

function Vector4_min(v4_min_dst, ...v4_min_args) {
  return Vector4_limitVectors(v4_min_dst, 0, v4_min_args[0], 1);
}

function Vector4_max(v4_max_dst, ...v4_max_args) {
  return Vector4_limitVectors(v4_max_dst, v4_max_args[0], 0, 2);
}

function Vector4_clampScalar(v4_clamps_dst, ...v4_clamps_args) {
  let v4_low = v4_clamps_args[0];
  let v4_high = v4_clamps_args[1];
  return Vector4_set(v4_clamps_dst, vector_limit(ux_f64(v4_clamps_dst), v4_low, v4_high),
      vector_limit(ux_f64(v4_clamps_dst + Vector4.y), v4_low, v4_high),
      vector_limit(ux_f64(v4_clamps_dst + Vector4.z), v4_low, v4_high),
      vector_limit(ux_f64(v4_clamps_dst + Vector4.w), v4_low, v4_high));
}

function Vector4_clampLength(v4_clampl_dst, ...v4_clampl_args) {
  let v4_clampl_length = Vector4_length(v4_clampl_dst);
  let v4_clampl_divisor = v4_clampl_length;
  if (v4_clampl_divisor == 0.0 || v4_clampl_divisor != v4_clampl_divisor) { v4_clampl_divisor = 1.0; }
  let v4_clampl_norm = Vector4_divideScalar(v4_clampl_dst, v4_clampl_divisor);
  return Vector4_multiplyScalar(v4_clampl_norm, vector_limit(v4_clampl_length, v4_clampl_args[0], v4_clampl_args[1]));
}

function Vector4_rounding(v4_round_dst, ...v4_round_args) {
  let v4_round_mode = v4_round_args[0];
  return Vector4_set(v4_round_dst, vector_roundValue(ux_f64(v4_round_dst), v4_round_mode),
      vector_roundValue(ux_f64(v4_round_dst + Vector4.y), v4_round_mode),
      vector_roundValue(ux_f64(v4_round_dst + Vector4.z), v4_round_mode),
      vector_roundValue(ux_f64(v4_round_dst + Vector4.w), v4_round_mode));
}

function Vector4_floor(v4_floor_dst) { return Vector4_rounding(v4_floor_dst, 0.0); }
function Vector4_ceil(v4_ceil_dst) { return Vector4_rounding(v4_ceil_dst, 1.0); }
function Vector4_round(v4_round_mutable) { return Vector4_rounding(v4_round_mutable, 2.0); }
function Vector4_roundToZero(v4_trunc_dst) { return Vector4_rounding(v4_trunc_dst, 3.0); }

function Vector4_arrayOffset(v4_array_base, ...v4_array_args) {
  let v4_array_result = 0 - 1;
  if (v4_array_base >= 0 && v4_array_base <= 6291424) {
    v4_array_result = ux_typed_index(v4_array_base, (6291424 - v4_array_base) / 8 + 1, v4_array_args[0], 8);
  }
  return v4_array_result;
}

function Vector4_fromArray(v4_array_dst, ...v4_from_array_args) {
  let v4_array_source = Vector4_arrayOffset(v4_from_array_args[0], v4_from_array_args[1]);
  let v4_array_read = v4_array_source;
  if (v4_array_source >= 0) { v4_array_read = Vector4_copy(v4_array_dst, v4_array_source); }
  return v4_array_read;
}

function Vector4_toArray(v4_array_src, ...v4_to_array_args) {
  let v4_array_target = Vector4_arrayOffset(v4_to_array_args[0], v4_to_array_args[1]);
  let v4_array_written = v4_array_target;
  if (v4_array_target >= 0) { v4_array_written = Vector4_copy(v4_array_target, v4_array_src); }
  return v4_array_written;
}

function Vector4_fromBufferAttribute(v4_attr_dst, ...v4_attr_args) {
  let v4_attr_stride = v4_attr_args[3];
  let v4_attr_offset = 0 - 1;
  if (v4_attr_stride >= 16) {
    v4_attr_offset = ux_record_index(v4_attr_args[0], v4_attr_args[1], v4_attr_args[2], v4_attr_stride, 4);
  }
  let v4_attr_status = v4_attr_offset;
  if (v4_attr_offset >= 0) {
    v4_attr_status = Vector4_set(v4_attr_dst, ux_f32(v4_attr_offset), ux_f32(v4_attr_offset + 4),
        ux_f32(v4_attr_offset + 8), ux_f32(v4_attr_offset + 12));
  }
  return v4_attr_status;
}

function Vector4_random(v4_random_dst, ...v4_random_args) {
  return Vector4_set(v4_random_dst, v4_random_args[0], v4_random_args[1], v4_random_args[2], v4_random_args[3]);
}
