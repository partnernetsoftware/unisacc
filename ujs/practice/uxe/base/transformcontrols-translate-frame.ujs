native function transform_q_span(q:i64) i64 {
  return q>=0 && q%8==0 && q<=6291456-32;
}

native function transform_q_axis(q:i64,x:f64,y:f64,z:f64,component:i64,inverse:i64) f64 {
  let a=ux_f64(q); let b=ux_f64(q+8); let c=ux_f64(q+16); let w=ux_f64(q+24);
  let norm=a*a+b*b+c*c+w*w;
  if(norm<=0.0 || norm-norm!=0.0) { return 0.0/0.0; }
  if(inverse==1) { w=0.0-w; }
  let factor=2.0/norm;
  if(component==0) { return x+factor*((a*b-w*c)*y+(a*c+w*b)*z-(b*b+c*c)*x); }
  if(component==1) { return y+factor*((a*b+w*c)*x+(b*c-w*a)*z-(a*a+c*c)*y); }
  return z+factor*((a*c-w*b)*x+(b*c+w*a)*y-(a*a+b*b)*z);
}

// Local axes project the world hit delta into object space. Parent
// rotation and uniform scale convert the result to parent-local position.
// Supply a one- or two-axis mask (X=1, Y=2, Z=4).
native function TransformControls_transLocal(out:i64,position:i64,start:i64,parent:i64,delta:i64,axes:i64,scale:f64,snap:f64) i64 {
  if(!transform_vec3_valid(out) || !transform_vec3_valid(position) || !transform_vec3_valid(delta) ||
     !transform_q_span(start) || !transform_q_span(parent) || axes<1 || axes>6 ||
     scale<=0.0 || scale-scale!=0.0 || snap<0.0 || snap-snap!=0.0) { return 0-1; }
  let dx=ux_f64(delta); let dy=ux_f64(delta+8); let dz=ux_f64(delta+16);
  let px=transform_q_axis(parent,dx,dy,dz,0,1);
  let py=transform_q_axis(parent,dx,dy,dz,1,1);
  let pz=transform_q_axis(parent,dx,dy,dz,2,1);
  let lx=0.0; let ly=0.0; let lz=0.0;
  let useX=axes%2==1; let useY=(axes/2)%2==1; let useZ=axes>=4;
  if(useX) { lx=transform_q_axis(start,px,py,pz,0,1); }
  if(useY) { ly=transform_q_axis(start,px,py,pz,1,1); }
  if(useZ) { lz=transform_q_axis(start,px,py,pz,2,1); }
  let x=ux_f64(position)+transform_q_axis(start,lx,ly,lz,0,0)/scale;
  let y=ux_f64(position+8)+transform_q_axis(start,lx,ly,lz,1,0)/scale;
  let z=ux_f64(position+16)+transform_q_axis(start,lx,ly,lz,2,0)/scale;
  if(snap>0.0) {
    let sx=transform_q_axis(start,x,y,z,0,1);
    let sy=transform_q_axis(start,x,y,z,1,1);
    let sz=transform_q_axis(start,x,y,z,2,1);
    if(useX) { sx=transform_world_axis(sx,0.0,0.0,0.0,snap); }
    if(useY) { sy=transform_world_axis(sy,0.0,0.0,0.0,snap); }
    if(useZ) { sz=transform_world_axis(sz,0.0,0.0,0.0,snap); }
    x=transform_q_axis(start,sx,sy,sz,0,0);
    y=transform_q_axis(start,sx,sy,sz,1,0);
    z=transform_q_axis(start,sx,sy,sz,2,0);
  }
  if(x-x!=0.0 || y-y!=0.0 || z-z!=0.0) { return 0-1; }
  let a=ux_f64_put(out,x);
  let b=ux_f64_put(out+8,y);
  let c=ux_f64_put(out+16,z);
  return out;
}
