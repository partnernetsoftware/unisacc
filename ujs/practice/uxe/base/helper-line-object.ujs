// The caller supplies the unchanged geometry and material producer outputs.
// The root wraps a single leaf Object3D and keeps each producer's resource UUID.
struct HelperLineJson {
  kind: u32;
  uuid: u32;
  uuidBytes: u32;
  name: u32;
  nameBytes: u32;
  geometry: u32;
  geometryEnd: u32;
  material: u32;
  materialEnd: u32;
}

native function line_json_word(at:i64,end:i64,word:i64,count:i64) i64 {
  if(at<0 || end-at<count) { return 0-1; }
  let i=0;
  while(i<count) {
    let byte=ux_u8_put(at+i,word%256);
    word=word/256;
    i=i+1;
  }
  return at+count;
}

// {"metadata":{"version":4.6,"type":"Object","generator":"Object3D.toJSON"},"geometries":[
native function line_json_header(at:i64,end:i64) i64 {
  at=line_json_word(at,end,7017841271895827067,8);
  at=line_json_word(at,end,7311068957734232436,8);
  at=line_json_word(at,end,3763358296332399474,8);
  at=line_json_word(at,end,7309475734918805038,8);
  at=line_json_word(at,end,7162247752869624354,8);
  at=line_json_word(at,end,7308890738898248308,8);
  at=line_json_word(at,end,2466321620830282098,8);
  at=line_json_word(at,end,4914399588643398223,8);
  at=line_json_word(at,end,2472000464622679086,8);
  at=line_json_word(at,end,7308620251604855933,8);
  at=line_json_word(at,end,6573604485118653044,8);
  return at;
}

// ],"materials":[
native function line_json_material(at:i64,end:i64) i64 {
  at=line_json_word(at,end,8243122654763166813,8);
  at=line_json_word(at,end,25678142520451433,7);
  return at;
}

// ],"object":{"uuid":
native function line_json_object(at:i64,end:i64) i64 {
  at=line_json_word(at,end,7162247753406491741,8);
  at=line_json_word(at,end,7599108737214325364,8);
  at=line_json_word(at,end,3809892,3);
  return at;
}

// ,"type":
native function line_json_type(at:i64,end:i64) i64 {
  at=line_json_word(at,end,4189022137156379180,8);
  return at;
}

// "GridHelper"
native function line_json_grid(at:i64,end:i64) i64 {
  at=line_json_word(at,end,7810728724847019810,8);
  at=line_json_word(at,end,577922416,4);
  return at;
}

// "PolarGridHelper"
native function line_json_polar(at:i64,end:i64) i64 {
  at=line_json_word(at,end,8234676206426869794,8);
  at=line_json_word(at,end,8243118303829582953,8);
  at=line_json_word(at,end,34,1);
  return at;
}

// "AxesHelper"
native function line_json_axes(at:i64,end:i64) i64 {
  at=line_json_word(at,end,7810728789204812066,8);
  at=line_json_word(at,end,577922416,4);
  return at;
}

native function line_json_helperType(at:i64,end:i64,kind:i64) i64 {
  if(kind==1) { return line_json_grid(at,end); }
  if(kind==2) { return line_json_polar(at,end); }
  if(kind==3) { return line_json_axes(at,end); }
  if(kind==4) {
    let prefix=line_json_word(at,end,8100961191665287714,8);
    return line_json_word(prefix,end,2257509,3);
  }
  if(kind==5) {
    let prefix=line_json_word(at,end,7810728514645082658,8);
    return line_json_word(prefix,end,577922416,4);
  }
  if(kind==6) {
    let prefix=line_json_word(at,end,5215575623424099106,8);
    return line_json_word(prefix,end,37874723482725,6);
  }
  if(kind==7) {
    let prefix=line_json_word(at,end,8031155551740842786,8);
    return line_json_word(prefix,end,2482157878163884142,8);
  }
  return 0-1;
}

// "LineSegments"
native function line_json_segments(at:i64,end:i64) i64 {
  at=line_json_word(at,end,7450452853663550498,8);
  at=line_json_word(at,end,37879269975405,6);
  return at;
}

// ,"name":
native function line_json_name(at:i64,end:i64) i64 {
  at=line_json_word(at,end,4189022123868430892,8);
  return at;
}

// ,"visible":false
native function line_json_hidden(at:i64,end:i64) i64 {
  at=line_json_word(at,end,7809920648225366572,8);
  at=line_json_word(at,end,7310305785735160421,8);
  return at;
}

// ,"layers":
native function line_json_layers(at:i64,end:i64) i64 {
  at=line_json_word(at,end,8318823033706652204,8);
  at=line_json_word(at,end,14882,2);
  return at;
}

// ,"matrix":[
native function line_json_matrix(at:i64,end:i64) i64 {
  at=line_json_word(at,end,8676592001282286124,8);
  at=line_json_word(at,end,5978658,3);
  return at;
}

// ],"up":[0,1,0],"geometry":
native function line_json_afterMatrix(at:i64,end:i64) i64 {
  at=line_json_word(at,end,6573604472497515613,8);
  at=line_json_word(at,end,2462445557746052144,8);
  at=line_json_word(at,end,8751185004910830951,8);
  at=line_json_word(at,end,14882,2);
  return at;
}

// ,"material":
native function line_json_materialRef(at:i64,end:i64) i64 {
  at=line_json_word(at,end,7598247071852601900,8);
  at=line_json_word(at,end,975334497,4);
  return at;
}

// }}
native function line_json_close(at:i64,end:i64) i64 {
  at=line_json_word(at,end,32125,2);
  return at;
}

// "BufferGeometry"
native function line_json_geometryType(at:i64,end:i64) i64 {
  at=line_json_word(at,end,5148288814517928482,8);
  at=line_json_word(at,end,2484142513714982757,8);
  return at;
}

// "LineBasicMaterial"
native function line_json_materialType(at:i64,end:i64) i64 {
  at=line_json_word(at,end,8313999390514170914,8);
  at=line_json_word(at,end,7598247071850521449,8);
  at=line_json_word(at,end,2255969,3);
  return at;
}

native function line_json_copy(at:i64,end:i64,from:i64,to:i64) i64 {
  if(at<0 || to<from || to-from>end-at) { return 0-1; }
  let i=from;
  while(i<to) {
    let byte=ux_u8_put(at+i-from,ux_u8(i));
    i=i+1;
  }
  return at+to-from;
}

native function line_json_resource(at:i64,end:i64,scratch:i64,material:i64) i64 {
  let start=json_space(at,end);
  if(start>=end || ux_u8(start)!=123) { return 0-1; }
  let last=json_value_end(start,end);
  if(last<0 || json_space(last,end)!=end) { return 0-1; }
  let key=ux_u32_put(scratch,1701869940); // type
  let type=json_find_key(start,last,scratch,4);
  if(type<0) { return 0-1; }
  let limit=scratch+24;
  let close=line_json_geometryType(scratch,limit);
  if(material) { close=line_json_materialType(scratch,limit); }
  let bytes=close-scratch;
  if(json_scan_string(type,last)!=type+bytes) { return 0-1; }
  let i=0;
  while(i<bytes) {
    if(ux_u8(type+i)!=ux_u8(scratch+i)) { return 0-1; }
    i=i+1;
  }
  let id=ux_u32_put(scratch,1684632949); // uuid
  let uuid=json_find_key(start,last,scratch,4);
  if(uuid<0 || json_scan_string(uuid,last)<=uuid+2) { return 0-1; }
  return uuid;
}

native function line_json_fields(at:i64,end:i64,node:i64,matrix:i64,scratch:i64) i64 {
  if(!ux_u32(node+Object3D.visible)) { at=line_json_hidden(at,end); }
  at=line_json_layers(at,end);
  if(at<0) { return at; }
  let mask=ux_u32(node+Object3D.layerMask);
  if(mask>2147483647) { mask=mask-4294967296; }
  at=json_write_f64(at,end,0.0+mask,scratch);
  at=line_json_matrix(at,end);
  let i=0;
  while(i<16 && at>=0) {
    if(i>0) { at=json_byte(at,end,44); }
    if(at>=0) { at=json_write_f64(at,end,ux_f64(matrix+i*8),scratch); }
    i=i+1;
  }
  return line_json_afterMatrix(at,end);
}

// compatible=0 preserves the helper's wire class. r160 ObjectLoader treats
// those classes as Object3D. compatible=1 emits LineSegments to bind both
// resources in that loader; its geometry and material documents are identical.
native function HelperLineObject_toJSON(node:i64,options:i64,dst:i64,end:i64,scratch:i64,compatible:i64) i64 {
  if(!helper_buffer_span(node,Object3D.size,4) || !helper_buffer_span(options,HelperLineJson.size,4) ||
     !helper_buffer_span(dst,end-dst,1) || !helper_buffer_span(scratch,1104,8) ||
     !helper_buffer_disjoint(dst,end-dst,scratch,1104) ||
     !helper_buffer_disjoint(options,HelperLineJson.size,dst,end-dst) ||
     !helper_buffer_disjoint(options,HelperLineJson.size,scratch,1104) ||
     !helper_buffer_disjoint(node,Object3D.size,scratch,1104) ||
     !helper_buffer_disjoint(node,Object3D.size,dst,end-dst) ||
     (compatible!=0 && compatible!=1) || ux_u32(node+Object3D.firstChild)!=0 ||
     ux_u32(node+Object3D.visible)>1) { return 0-1; }
  let kind=ux_u32(options+HelperLineJson.kind);
  let uuid=ux_u32(options+HelperLineJson.uuid);
  let uuidBytes=ux_u32(options+HelperLineJson.uuidBytes);
  let name=ux_u32(options+HelperLineJson.name);
  let nameBytes=ux_u32(options+HelperLineJson.nameBytes);
  let g=ux_u32(options+HelperLineJson.geometry);
  let gEnd=ux_u32(options+HelperLineJson.geometryEnd);
  let m=ux_u32(options+HelperLineJson.material);
  let mEnd=ux_u32(options+HelperLineJson.materialEnd);
  let matrix=ux_u32(node+Object3D.localMatrix);
  if(kind<1 || kind>7 || uuidBytes<1 ||
     !helper_buffer_span(uuid,uuidBytes,1) || !helper_buffer_span(name,nameBytes,1) ||
     !helper_buffer_span(g,gEnd-g,1) || !helper_buffer_span(m,mEnd-m,1) ||
     !helper_buffer_span(matrix,128,8) ||
     !helper_buffer_disjoint(matrix,128,scratch,1104) ||
     !helper_buffer_disjoint(matrix,128,dst,end-dst) ||
     !helper_buffer_disjoint(uuid,uuidBytes,scratch,1104) ||
     !helper_buffer_disjoint(uuid,uuidBytes,dst,end-dst) ||
     !helper_buffer_disjoint(name,nameBytes,scratch,1104) ||
     !helper_buffer_disjoint(name,nameBytes,dst,end-dst) ||
     !helper_buffer_disjoint(g,gEnd-g,scratch,1104) ||
     !helper_buffer_disjoint(g,gEnd-g,dst,end-dst) ||
     !helper_buffer_disjoint(m,mEnd-m,scratch,1104) ||
     !helper_buffer_disjoint(m,mEnd-m,dst,end-dst)) { return 0-1; }
  let gId=line_json_resource(g,gEnd,scratch,0);
  let mId=line_json_resource(m,mEnd,scratch,1);
  if(gId<0 || mId<0) { return 0-1; }

  let at=line_json_header(dst,end);
  at=line_json_copy(at,end,g,gEnd);
  at=line_json_material(at,end);
  at=line_json_copy(at,end,m,mEnd);
  at=line_json_object(at,end);
  at=json_write_string(at,end,uuid,uuidBytes);
  at=line_json_type(at,end);
  if(compatible) { at=line_json_segments(at,end); }
  else { at=line_json_helperType(at,end,kind); }
  if(nameBytes>0) {
    at=line_json_name(at,end);
    at=json_write_string(at,end,name,nameBytes);
  }
  if(kind==7) {
    // ,"matrixAutoUpdate":false
    at=line_json_word(at,end,8676592001282286124,8);
    at=line_json_word(at,end,7017857631594509633,8);
    at=line_json_word(at,end,8317129703536354676,8);
    at=line_json_word(at,end,101,1);
  }
  at=line_json_fields(at,end,node,matrix,scratch);
  at=line_json_copy(at,end,gId,json_scan_string(gId,gEnd));
  at=line_json_materialRef(at,end);
  at=line_json_copy(at,end,mId,json_scan_string(mId,mEnd));
  return line_json_close(at,end);
}

native function line_json_sameString(a:i64,aEnd:i64,b:i64,bEnd:i64) i64 {
  let lastA=json_scan_string(a,aEnd);
  let lastB=json_scan_string(b,bEnd);
  if(lastA<0 || lastB<0 || lastA-a!=lastB-b) { return 0; }
  let i=0;
  while(i<lastA-a) {
    if(ux_u8(a+i)!=ux_u8(b+i)) { return 0; }
    i=i+1;
  }
  return 1;
}

// Restore a leaf into an existing binding. Scratch receives the full matrix
// before the node is changed so malformed input cannot publish a partial pose.
native function HelperLineObject_fromJSON(node:i64,options:i64,input:i64,end:i64,scratch:i64) i64 {
  if(!helper_buffer_span(node,Object3D.size,4) ||
     !helper_buffer_span(options,HelperLineJson.size,4) ||
     input>=end || !helper_buffer_span(input,end-input,1) ||
     !helper_buffer_span(scratch,160,8) ||
     !helper_buffer_disjoint(scratch,160,input,end-input) ||
     !helper_buffer_disjoint(scratch,160,node,Object3D.size) ||
     !helper_buffer_disjoint(scratch,160,options,HelperLineJson.size) ||
     !helper_buffer_disjoint(input,end-input,node,Object3D.size)) { return 0-1; }
  let matrix=ux_u32(node+Object3D.localMatrix);
  if(!helper_buffer_span(matrix,128,8) ||
     !helper_buffer_disjoint(matrix,128,scratch,160) ||
     !helper_buffer_disjoint(matrix,128,input,end-input) ||
     !helper_buffer_disjoint(matrix,128,node,Object3D.size) ||
     !helper_buffer_disjoint(matrix,128,options,HelperLineJson.size) ||
     ux_u32(node+Object3D.firstChild)!=0) { return 0-1; }
  let root=json_value_end(input,end);
  if(root<0 || json_space(root,end)!=end) { return 0-1; }
  let obj=LoaderJson_find(input,root,scratch,1701470831,29795,0,6);
  if(obj<0 || ux_u8(obj)!=123) { return 0-1; }
  let objEnd=json_value_end(obj,root);
  if(objEnd<0) { return 0-1; }
  let kind=ux_u32(options+HelperLineJson.kind);
  let type=LoaderJson_find(obj,objEnd,scratch,1701869940,0,0,4);
  let typeEnd=line_json_helperType(scratch,scratch+24,kind);
  if(!line_json_sameString(type,objEnd,scratch,typeEnd)) { return 0-1; }
  let g=ux_u32(options+HelperLineJson.geometry);
  let gEnd=ux_u32(options+HelperLineJson.geometryEnd);
  let m=ux_u32(options+HelperLineJson.material);
  let mEnd=ux_u32(options+HelperLineJson.materialEnd);
  if(!helper_buffer_span(g,gEnd-g,1) || !helper_buffer_span(m,mEnd-m,1) ||
     !helper_buffer_disjoint(scratch,160,g,gEnd-g) ||
     !helper_buffer_disjoint(scratch,160,m,mEnd-m) ||
     !helper_buffer_disjoint(matrix,128,g,gEnd-g) || !helper_buffer_disjoint(matrix,128,m,mEnd-m) ||
     !helper_buffer_disjoint(node,Object3D.size,g,gEnd-g) ||
     !helper_buffer_disjoint(node,Object3D.size,m,mEnd-m)) { return 0-1; }
  let gId=line_json_resource(g,gEnd,scratch,0);
  let mId=line_json_resource(m,mEnd,scratch,1);
  let gRef=LoaderJson_find(obj,objEnd,scratch,1836016999,2037544037,0,8);
  let mRef=LoaderJson_find(obj,objEnd,scratch,1702125933,1818323314,0,8);
  if(!line_json_sameString(gId,gEnd,gRef,objEnd) || !line_json_sameString(mId,mEnd,mRef,objEnd)) { return 0-1; }
  if(kind==7) {
    let prefix=line_json_word(scratch,scratch+16,8449166770210890093,8);
    let key=line_json_word(prefix,scratch+16,7310575179138428788,8);
    let auto=json_find_key(obj,objEnd,scratch,key-scratch);
    if(auto<0 || ux_u8(auto)!=102) { return 0-1; }
  }
  let show=LoaderJson_find(obj,objEnd,scratch,1769171318,6646882,0,7);
  let visible=1;
  if(show>=0) {
    let first=ux_u8(show);
    if(first==102) { visible=0; }
    else if(first!=116) { return 0-1; }
  } else if(show!=0-2) { return 0-1; }
  let layers=LoaderJson_find(obj,objEnd,scratch,1702453612,29554,0,6);
  let value=json_read_number(layers,objEnd);
  if(!(value>=0.0-2147483648.0 && value<=2147483647.0)) { return 0-1; }
  let mask=f64_floor_i64(value);
  if(value!=0.0+mask) { return 0-1; }
  let mat=LoaderJson_find(obj,objEnd,scratch,1920229741,30825,0,6);
  if(mat<0 || ux_u8(mat)!=91) { return 0-1; }
  let at=json_space(mat+1,objEnd);
  let i=0;
  while(i<16) {
    let component=json_read_number(at,objEnd);
    if(component-component!=0.0) { return 0-1; }
    let saved=ux_f64_put(scratch+32+i*8,component);
    let close=json_value_end(at,objEnd);
    at=json_space(close,objEnd);
    if(at<0 || at>=objEnd) { return 0-1; }
    if(i<15) {
      if(ux_u8(at)!=44) { return 0-1; }
      at=json_space(at+1,objEnd);
    }
    i=i+1;
  }
  if(ux_u8(at)!=93) { return 0-1; }
  let pose=uxe_copy_record(matrix,scratch+32,128);
  let shown=ux_u32_put(node+Object3D.visible,visible);
  let mask32=u32_and(mask,4294967295);
  let layer=ux_u32_put(node+Object3D.layerMask,mask32);
  let dirty=ux_u32_put(node+Object3D.dirty,2);
  return node;
}
