native function gltf_gpu_wrap(value:i64) i64 {
  if(value==33071) { return 0; }
  if(value==10497) { return 1; }
  if(value==33648) { return 2; }
  return 0-1;
}

native function gltf_gpu_filter(mag:i64,min:i64) i64 {
  if(mag==9728 && min==9728) { return 0; }
  if(mag==9729 && min==9729) { return 1; }
  if(mag==9729 && min==9987) { return 2; }
  return 0-1;
}

// Build the packet's tightly packed RGBA8 upload from a resolved glTF
// image and sampler. Unsupported filter pairs fail before any copy.
native function GltfLoader_gpuTexture(image:i64,sampler:i64,out:i64,rgba:i64,capacity:i64) i64 {
  if(image%4!=0 || sampler%4!=0 || out%4!=0 ||
     !loading_span(image,ImageResource.size) || !loading_span(sampler,GltfSampler.size) ||
     !loading_span(out,GpuTextureSource.size) || !loading_span(rgba,capacity) ||
     !file_disjoint(image,ImageResource.size,out,GpuTextureSource.size) ||
     !file_disjoint(sampler,GltfSampler.size,out,GpuTextureSource.size) ||
     !file_disjoint(image,ImageResource.size,rgba,capacity) ||
     !file_disjoint(sampler,GltfSampler.size,rgba,capacity) ||
     !file_disjoint(out,GpuTextureSource.size,rgba,capacity)) { return 0-1; }
  let width=ux_u32(image+ImageResource.width);
  let height=ux_u32(image+ImageResource.height);
  let pitch=ux_u32(image+ImageResource.rowBytes);
  let start=ux_u32(image+ImageResource.rgba);
  let row=width*4;
  if(width<1 || width>4096 || height<1 || height>4096 || pitch<row ||
     height>capacity/row || start>6291456-row || height-1>(6291456-start-row)/pitch) { return 0-1; }
  let bytes=(height-1)*pitch+row;
  if(!file_disjoint(start,bytes,rgba,capacity) || !file_disjoint(start,bytes,out,GpuTextureSource.size)) { return 0-1; }
  let filter=gltf_gpu_filter(ux_u32(sampler+GltfSampler.magFilter),ux_u32(sampler+GltfSampler.minFilter));
  let s=gltf_gpu_wrap(ux_u32(sampler+GltfSampler.wrapS));
  let t=gltf_gpu_wrap(ux_u32(sampler+GltfSampler.wrapT));
  if(filter<0 || s<0 || t<0) { return 0-2; }
  let y=0;
  while(y<height) {
    let copied=uxe_copy_record(rgba+y*row,start+y*pitch,row);
    y=y+1;
  }
  let a=ux_u32_put(out+GpuTextureSource.width,width);
  let b=ux_u32_put(out+GpuTextureSource.height,height);
  let c=ux_u32_put(out+GpuTextureSource.filter,filter);
  let d=ux_u32_put(out+GpuTextureSource.wrapS,s);
  let e=ux_u32_put(out+GpuTextureSource.wrapT,t);
  let f=ux_u32_put(out+GpuTextureSource.rgba,rgba);
  return out;
}
