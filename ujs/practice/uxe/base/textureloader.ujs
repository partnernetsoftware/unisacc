native function TextureLoader_fromImage(image:i64,source:i64) i64 {
  if(!loading_span(image,ImageResource.size) || !loading_span(source,GpuTextureSource.size) ||
     !file_disjoint(image,ImageResource.size,source,GpuTextureSource.size)) { return 0-1; }
  let width=ux_u32(image+ImageResource.width);
  let height=ux_u32(image+ImageResource.height);
  let stride=ux_u32(image+ImageResource.rowBytes);
  let rgba=ux_u32(image+ImageResource.rgba);
  if(width<1 || width>4096 || height<1 || height>4096 || stride!=width*4 || rgba>6291456 ||
     height>(6291456-rgba)/stride || !file_disjoint(source,GpuTextureSource.size,rgba,height*stride)) { return 0-1; }
  let w=ux_u32_put(source+GpuTextureSource.width,width);
  let h=ux_u32_put(source+GpuTextureSource.height,height);
  let f=ux_u32_put(source+GpuTextureSource.filter,2);
  let s=ux_u32_put(source+GpuTextureSource.wrapS,0);
  let t=ux_u32_put(source+GpuTextureSource.wrapT,0);
  let p=ux_u32_put(source+GpuTextureSource.rgba,rgba);
  return source;
}
