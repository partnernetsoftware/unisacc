native function binding_probe_put(arena:i64,handle:i64,y:f64) i64 {
  let node=Object3D_address(arena,handle);
  let position=ux_u32(node+Object3D.position);
  let moved=ux_f64_put(position+8,y);
  return handle;
}

native function binding_probe_init() i64 {
  let arena=Object3D_initArena(0,8);
  let root=Object3D_create(arena);
  let branch=Object3D_create(arena);
  let first=Object3D_create(arena);
  let second=Object3D_create(arena);
  let away=Object3D_create(arena);
  let a=Object3D_add(arena,root,branch);
  let b=Object3D_add(arena,branch,first);
  let c=Object3D_add(arena,root,second);
  let r=binding_probe_put(arena,root,2.0);
  let q=binding_probe_put(arena,branch,10.0);
  let f=binding_probe_put(arena,first,3.0);
  let s=binding_probe_put(arena,second,4.0);
  let foreign=binding_probe_put(arena,away,12.0);
  return PropertyBinding_initNames(3500,arena,3520);
}

if(op==0) { return 0.0+ux_span(0,8192); }
if(op==1) { return 0.0+binding_probe_init(); }
if(op==2) { return 0.0+PropertyBinding_setNodeKeys(3500,a,ux_u32(4000),ux_u32(4004),ux_u32(4008),ux_u32(4012)); }
if(op==3) { return 0.0+PropertyBinding_bindNamed(3800,3500,a,4100,b); }
if(op==4 || op==5) { return 0.0+PropertyBinding_transfer(3800,4504,op-4); }
if(op==6) {
  let node=Object3D_address(0,a);
  if(node<0) { return 0.0-1.0; }
  return ux_f64(ux_u32(node+Object3D.position)+8);
}
if(op==7) { return 0.0+Object3D_remove(0,a,b); }
if(op==8) {
  let ready=Object3D_updateMatrixWorld(0,65537,0);
  if(ready<0) { return 0.0+ready; }
  let node=Object3D_address(0,a);
  return ux_f64(ux_u32(node+Object3D.worldMatrix)+104);
}
if(op==9) { return 0.0+Object3D_destroy(0,a); }
if(op==10) { return 0.0+PropertyBinding_findNamed(3500,a,4100,b); }
if(op==11) {
  let next=Object3D_create(0);
  let attached=Object3D_add(0,65537,next);
  return 0.0+next;
}
return 0.0-1.0;
