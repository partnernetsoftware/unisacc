native function probe_anim_identity(view:i64,object:i64) i64 {
  let cell=AnimGroup_bindingCell(view,object);
  if(cell<0) { return 0; }
  return ux_u32(cell+AnimGroupBindingCell.identity);
}

native function probe_anim_active(view:i64,object:i64) i64 {
