if(mode==0) { return ux_span(0,60000); }
if(mode<1 || mode>7 || length<1 || length>4000) { return 0-100; }
let geo=BufferGeometry_init(GeometryPrimitive_geometry(128),1024,3,1092,0);
let raw=GeometryBuffers_init(1800,8192,120,16000,0);
let storage=2032;
let a=ux_u32_put(storage+PolyhedronJsonStorage.vertices,3328);
let b=ux_u32_put(storage+PolyhedronJsonStorage.vertexCapacity,8);
let c=ux_u32_put(storage+PolyhedronJsonStorage.indices,3648);
let d=ux_u32_put(storage+PolyhedronJsonStorage.indexCapacity,24);
let e=ux_u32_put(storage+PolyhedronJsonStorage.work,3800);
if(geo<0 || raw!=1800) { return 0-101; }
let status=PolyhedronGeometry_fromJSON(128,raw,20480,4096,48000,48000+length,1920,storage);
if(mode>=5) {
  return status==0-1 && ux_u32(128+GeometryPrimitiveRecord.kind)==0;
}
if(status!=128) { return status; }
let name=GeometryPrimitive_setName(128,6016,8);
if(name!=128) { return 0-102; }
let pos=BufferGeometry_getAttribute(geo,1);
let norm=BufferGeometry_getAttribute(geo,2);
let uv=BufferGeometry_getAttribute(geo,4);
let p=ux_u32_put(7000,ux_u32(pos+BufferAttribute.data));
let n=ux_u32_put(7004,ux_u32(norm+BufferAttribute.data));
let u=ux_u32_put(7008,ux_u32(uv+BufferAttribute.data));
let count=ux_u32_put(7012,ux_u32(pos+BufferAttribute.count));
let end=PolyhedronGeometry_toJSON(128,4096,6000,6000,5,2048,mode==2 || mode==3);
if(end<0) { return end; }
return end-4096;
