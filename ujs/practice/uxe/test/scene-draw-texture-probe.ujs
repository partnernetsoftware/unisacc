let packet=GpuPacket_begin(0,4096,1);
let viewport=GpuPacket_viewport(packet,4096,0,0,8,8);
let clear=GpuPacket_clear(packet,4096,4278190080);
let draw=4200;
let stream=4256;
let binding=4280;
let world=4384;
let projection=4512;
let positions=4640;
let uv=4712;
let color=4784;
let projected=4800;
let texture=5120;
let shader=5200;
let texels=5240;
let a=ux_u32_put(draw+SceneDrawItem.worldMatrix,world);
let b=ux_u32_put(stream+SceneDrawStream.positions,positions);
let c=ux_u32_put(stream+SceneDrawStream.vertexCount,6);
let d=ux_u32_put(stream+SceneDrawStream.stride,12);
let e=ux_u32_put(stream+SceneDrawStream.color,color);
let f=ux_u32_put(stream+SceneDrawStream.viewProjection,projection);
let g=ux_u32_put(binding+SceneTextureDraw.stream,stream);
let h=ux_u32_put(binding+SceneTextureDraw.uv,uv);
let j=ux_u32_put(binding+SceneTextureDraw.uvStride,12);
let k=ux_u32_put(binding+SceneTextureDraw.texture,texture);
let l=ux_u32_put(binding+SceneTextureDraw.shader,shader);
let m=ux_u32_put(texture+GpuTextureSource.width,2);
let n=ux_u32_put(texture+GpuTextureSource.height,1);
let o=ux_u32_put(texture+GpuTextureSource.rgba,texels);
let p=ux_u32_put(texels,4278190335);
let q=ux_u32_put(texels+4,4294901760);
let i=0;
while(i<4) {
  let row=ux_f64_put(world+i*40,1.0);
  let diagonal=ux_f64_put(projection+i*40,1.0);
  i=i+1;
}
i=0;
while(i<6) {
  let x=1.0;
  let y=1.0;
  if(i==0 || i==3 || i==5) { x=0.0-1.0; }
  if(i==0 || i==1 || i==3) { y=0.0-1.0; }
  let px=ux_f32_put(positions+i*12,x);
  let py=ux_f32_put(positions+i*12+4,y);
  let u=(x+1.0)*0.5;
  if(mode) { u=1.0-u; }
  let su=ux_f32_put(uv+i*12,u);
  let sv=ux_f32_put(uv+i*12+4,(y+1.0)*0.5);
  i=i+1;
}
let bytes=ux_u32(packet+GpuPacket.bytes);
let count=ux_u32(packet+GpuPacket.commands);
let bad=ux_f64_put(projection+24,0.25);
let perspective=SceneDraw_gpuTexture(packet,4096,draw,binding,projected,6);
let restore=ux_f64_put(projection+24,0.0);
let alias=ux_u32_put(binding+SceneTextureDraw.uv,projected);
let overlap=SceneDraw_gpuTexture(packet,4096,draw,binding,projected,6);
let good=ux_u32_put(binding+SceneTextureDraw.uv,uv);
if(perspective!=0-2 || overlap!=0-1 || ux_u32(packet+GpuPacket.bytes)!=bytes ||
   ux_u32(packet+GpuPacket.commands)!=count) { return 0-3; }
let emitted=SceneDraw_gpuTexture(packet,4096,draw,binding,projected,6);
if(emitted<0 || ux_u32(packet+GpuPacket.commands)!=count+1) { return 0-4; }
return GpuPacket_submit(packet);

