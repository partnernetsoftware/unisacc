native function bloom_blur_shader(shader:i64,position:i64,vn:i64,fn:i64) i64 {
  let a=ux_u32_put(shader+GpuShaderSource.vertex,10000);
  let b=ux_u32_put(shader+GpuShaderSource.vertexBytes,vn);
  let c=ux_u32_put(shader+GpuShaderSource.fragment,position);
  return ux_u32_put(shader+GpuShaderSource.fragmentBytes,fn);
}

native function bloom_blur_read(packet:i64,id:i64,out:i64) i64 {
  let desc=5000;
  let a=ux_u32_put(desc+GpuTargetRead.id,id);
  let b=ux_u32_put(desc+GpuTargetRead.layer,0);
  let c=ux_u32_put(desc+GpuTargetRead.color,0);
  let d=ux_u32_put(desc+GpuTargetRead.x,0);
  let e=ux_u32_put(desc+GpuTargetRead.y,0);
  let f=ux_u32_put(desc+GpuTargetRead.width,7);
  let g=ux_u32_put(desc+GpuTargetRead.height,5);
  let h=ux_u32_put(desc+GpuTargetRead.output,out);
  return GpuTarget_read(packet,4096,desc);
}

if(mode<0 || mode>1 || mutate<0 || mutate>1) { return 0-1; }
let composer=4200;
let ownership=4300;
let initialized=EffectComposer_init(composer,2,1,4360,2,7,5);
let offscreen=EffectComposer_screen(composer,0);
let addH=EffectComposer_addPass(composer,10,3);
let addV=EffectComposer_addPass(composer,20,3);
if(initialized<0 || offscreen<0 || addH<0 || addV<0) { return 0-2; }
let created=EffectComposerGpu_create(composer,ownership,0,4096,5000,1);
if(created!=0) { return created; }
let packet=GpuPacket_begin(0,4096,1);
let bound=EffectComposerGpu_bindBuffer(composer,ownership,packet,4096,0);
let open=GpuPacket_scissor(packet,4096,0,0,0,0,0);
let background=GpuPacket_clear(packet,4096,0);
let point=GpuPacket_scissor(packet,4096,1,3,2,1,1);
let impulse=GpuPacket_clear(packet,4096,289175792);
if(bound<0 || open<0 || background<0 || point<0 || impulse<0) { return 0-3; }
let submitted=GpuPacket_submit(packet);
if(submitted!=0) { return submitted; }
let horizontal=14500;
let hBytes=fn;
if(mode==1) {
  horizontal=28000;
  hBytes=NativeColorCorrection_config(14500,fn,23500,rn,horizontal,4096);
  if(hBytes<0) { return hBytes; }
}
let vertical=32500;
let vBytes=NativeColorCorrection_config(horizontal,hBytes,19000,dn,vertical,4096);
if(vBytes<0) { return vBytes; }
let shaderA=bloom_blur_shader(6300,horizontal,vn,hBytes);
let shaderB=bloom_blur_shader(6320,vertical,vn,vBytes);
let a=ux_u32_put(4800+ComposerNativeBinding.id,10);
let b=ux_u32_put(4800+ComposerNativeBinding.shader,6300);
let second=4800+ComposerNativeBinding.size;
let c=ux_u32_put(second+ComposerNativeBinding.id,20);
let select=6320;
if(mutate==1) { select=6300; }
let d=ux_u32_put(second+ComposerNativeBinding.shader,select);
let rendered=EffectComposerGpu_runNative(composer,4400,4480,2,4800,2,1);
if(rendered!=2) { return 0-4; }
packet=GpuPacket_begin(0,4096,1);
let h=bloom_blur_read(packet,1,7000);
let v=bloom_blur_read(packet,2,7200);
if(h<0 || v<0) { return 0-5; }
let read=GpuPacket_submit(packet);
if(read!=0) { return read; }
return EffectComposerGpu_release(ownership,0,4096,0);
