let packet=0;
let capacity=4096;
let texture=4352;
let vertices=4608;
let shader=4864;
let texels=7200;
if(variant<0 || variant>3) { return 0-1; }
let applied=GpuTextureWrap_apply(texture,value);
if(applied<0) { return applied; }
let w=ux_u32_put(texture+GpuTextureSource.width,4);
let h=ux_u32_put(texture+GpuTextureSource.height,4);
let f=ux_u32_put(texture+GpuTextureSource.filter,0);
let a=ux_u32_put(texture+GpuTextureSource.rgba,texels);
let index=0;
while(index<16) {
  let color=ux_u32_put(texels+index*4,4278190090+13*index);
  index=index+1;
}
let outer=0.0-0.375+1.75*(variant%2);
let u=0.375;
let v=0.375;
if(variant<2) { u=outer; }
else { v=outer; }
index=0;
while(index<3) {
  let row=vertices+index*28;
  let x=ux_f32_put(row,0.0-1.0+4.0*(index==1));
  let y=ux_f32_put(row+4,0.0-1.0+4.0*(index==2));
  let z=ux_f32_put(row+8,0.0);
  let uvx=ux_f32_put(row+12,u);
  let uvy=ux_f32_put(row+16,v);
  index=index+1;
}
let status=GpuPacket_begin(packet,capacity,1);
if(status<0) { return status; }
status=GpuPacket_viewport(packet,capacity,0,0,4,4);
if(status<0) { return status; }
status=GpuPacket_drawTexture(packet,capacity,vertices,3,shader,texture);
if(status<0) { return status; }
return GpuPacket_submit(packet);
