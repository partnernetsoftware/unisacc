let input=64;
let depth=128;
let samples=192;
let out=320;
let depths=[128,112,88,256,144,112,120,96];
let shifts=[9,8,0,9,8,8,8,8,8,7,8,0,8,9,4,8,7,4,8,8,0,9,9,4];
let i=0;
while(i<8) {
  let put=ux_u32_put(depth+4*i,depths[i]);
  i=i+1;
}
i=0;
while(i<24) {
  let put=ux_u32_put(samples+4*i,shifts[i]);
  i=i+1;
}
let w=ux_u32_put(input+SSAOOrthographicInput.width,4);
let h=ux_u32_put(input+SSAOOrthographicInput.height,2);
let d=ux_u32_put(input+SSAOOrthographicInput.depth,depth);
let s=ux_u32_put(input+SSAOOrthographicInput.samples,samples);
let n=ux_u32_put(input+SSAOOrthographicInput.count,8);
let lo=ux_u32_put(input+SSAOOrthographicInput.minDistance,4);
let hi=ux_u32_put(input+SSAOOrthographicInput.maxDistance,16+mutate);
let sentinel=ux_u32_put(out+28,123);
let invalid=ux_u32_put(depth+28,257);
if(SSAO_rawOrthographic(input,out)!=0-1 || ux_u32(out+28)!=123) { return 0-2; }
let valid=ux_u32_put(depth+28,96);
if(SSAO_rawOrthographic(input,depth)!=0-1 || ux_u32(depth)!=128) { return 0-3; }
return SSAO_rawOrthographic(input,out);
