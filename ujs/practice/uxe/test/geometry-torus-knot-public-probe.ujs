native function torus_knot_probe_values(at:i64,out:i64) i64 {
  let geo=GeometryPrimitive_geometry(at);
  let pos=BufferGeometry_getAttribute(geo,1);
  let normal=BufferGeometry_getAttribute(geo,2);
  let uv=BufferGeometry_getAttribute(geo,4);
  let index=BufferGeometry_getIndex(geo);
  let count=ux_u32(pos+BufferAttribute.count);
  let data=ux_u32(pos+BufferAttribute.data);
  let columns=f64_floor_i64(ux_f64(at+GeometryPrimitiveRecord.fourth))+1;
  let opposite=(columns-1)/2*12;
  let last=data+12*(count-columns);
  let last_uv=ux_u32(uv+BufferAttribute.data)+8*(count-1);
  let a=ux_f64_put(out,0.0+count);
  let b=ux_f64_put(out+8,0.0+ux_u32(index+BufferAttribute.count));
  let i=0;
  while(i<6) {
    let p=ux_f64_put(out+16+i*8,ux_f64(at+GeometryPrimitiveRecord.first+i*8));
    i=i+1;
  }
  let centerX=(ux_f32(data)+ux_f32(data+opposite))*0.5;
  let centerY=(ux_f32(data+4)+ux_f32(data+opposite+4))*0.5;
  let centerZ=(ux_f32(data+8)+ux_f32(data+opposite+8))*0.5;
  let x=ux_f32(data)-centerX;
  let y=ux_f32(data+4)-centerY;
  let z=ux_f32(data+8)-centerZ;
  let n=ux_u32(normal+BufferAttribute.data);
  let nx=ux_f32(n);
  let ny=ux_f32(n+4);
  let nz=ux_f32(n+8);
  let c0=ux_f64_put(out+64,centerX);
  let c1=ux_f64_put(out+72,centerY);
  let c2=ux_f64_put(out+80,(ux_f32(last)+ux_f32(last+opposite))*0.5);
  let c3=ux_f64_put(out+88,(ux_f32(last+4)+ux_f32(last+opposite+4))*0.5);
  let tube=ux_f64_put(out+96,x*x+y*y+z*z);
  let unit=ux_f64_put(out+104,nx*nx+ny*ny+nz*nz);
  let u=ux_f64_put(out+112,ux_f32(last_uv));
  let v=ux_f64_put(out+120,ux_f32(last_uv+4));
  let idx=ux_f64_put(out+128,0.0+ux_u16(ux_u32(index+BufferAttribute.data)));
  let tip=ux_f64_put(out+136,(ux_f32(last+8)+ux_f32(last+opposite+8))*0.5);
  return out;
}

if(mode==0) { return ux_span(0,100000); }
let i=0;
while(i<4) {
  let at=128+i*160;
  let attrs=1024+i*128;
  let geo=BufferGeometry_init(GeometryPrimitive_geometry(at),attrs,3,attrs+64,0);
  let registry=EventDispatcher_init(geo,attrs+80,3);
  if(geo<0 || registry!=geo) { return 0-101; }
  i=i+1;
}
let raw=GeometryBuffers_init(1800,8192,700,32000,3600);
let params=1920;
let work=3560;
let p0=ux_f64_put(params+TorusKnotGeometryParameters.radius,2.0);
let p1=ux_f64_put(params+TorusKnotGeometryParameters.tube,0.5+mutate*0.25);
let p2=ux_f64_put(params+TorusKnotGeometryParameters.tubularSegments,4.5);
let p3=ux_f64_put(params+TorusKnotGeometryParameters.radialSegments,4.5);
let p4=ux_f64_put(params+TorusKnotGeometryParameters.p,1.5);
let p5=ux_f64_put(params+TorusKnotGeometryParameters.q,0.5);
let created=TorusKnotGeometry_create(128,raw,49152,4096,params,work);
let named=GeometryPrimitive_setName(128,6016,8);
if(raw!=1800 || created!=128 || named!=128) { return 0-102; }
let short=TorusKnotGeometry_toJSON(128,4096,4100,6000,6,2048);
let end=TorusKnotGeometry_toJSON(128,4096,5600,6000,6,2048);
if(end<4096) { return 0-103; }
let broken=TorusKnotGeometry_fromJSON(288,raw,53248,4096,4096,end-1,2048,work);
let alias=TorusKnotGeometry_fromJSON(288,raw,53248,4096,4096,end,2048,8192);
let bad=TorusKnotGeometry_fromJSON(288,raw,53248,4096,5760,5771,2048,work);
let zeroP=TorusKnotGeometry_fromJSON(288,raw,53248,4096,5824,5831,2048,work);
let zeroRadius=TorusKnotGeometry_fromJSON(288,raw,53248,4096,5840,5852,2048,work);
let thin=TorusKnotGeometry_fromJSON(288,raw,53248,4096,5860,5882,2048,work);
let rejected=ux_f64_put(6160,0.0+(short==0-1 && broken==0-1 && alias==0-1 &&
  bad==0-1 && zeroP==0-1 && zeroRadius==0-1 && thin==0-1 && ux_u32(288+GeometryPrimitiveRecord.kind)==0));
let loaded=TorusKnotGeometry_fromJSON(288,raw,53248,4096,4096,end,2048,work);
let defaults=TorusKnotGeometry_fromJSON(448,raw,65536,32768,5800,5802,2048,work);
if(loaded!=288 || defaults!=448) { return 0-104; }
let results=torus_knot_probe_values(288,6176);
let source=torus_knot_probe_values(128,6656);
let fallback=torus_knot_probe_values(448,6912);
let equal=1;
i=0;
while(i<18) {
  let delta=ux_f64(6176+i*8)-ux_f64(6656+i*8);
  if(delta<0.0-0.000000001 || delta>0.000000001) { equal=0; }
  i=i+1;
}
let same=ux_f64_put(6168,0.0+equal);
let defaultCount=ux_f64_put(6320,ux_f64(6912));
let defaultIndices=ux_f64_put(6328,ux_f64(6920));

let s=GeometryPrimitive_geometry(128);
let d=GeometryPrimitive_geometry(288);
let c=GeometryPrimitive_geometry(608);
let listen1=EventDispatcher_addListener(s,7,41);
let listen2=EventDispatcher_addListener(s,7,82);
let listen3=EventDispatcher_addListener(d,7,61);
let copied=TorusKnotGeometry_copy(288,128,57344,4096);
let cloned=TorusKnotGeometry_clone(608,128,61440,4096);
let occupied=TorusKnotGeometry_clone(288,128,61440,4096);
if(copied!=288 || cloned!=608 || occupied!=0-1) { return 0-105; }
let spos=ux_u32(BufferGeometry_getAttribute(s,1)+BufferAttribute.data);
let dpos=ux_u32(BufferGeometry_getAttribute(d,1)+BufferAttribute.data);
let cpos=ux_u32(BufferGeometry_getAttribute(c,1)+BufferAttribute.data);
let changed=ux_f32_put(spos,9.0);
let changeP=ux_f64_put(128+GeometryPrimitiveRecord.fifth,5.0);
let changeQ=ux_f64_put(128+GeometryPrimitiveRecord.sixth,7.0);
let dst_values=torus_knot_probe_values(288,7168);
let clone_values=torus_knot_probe_values(608,7424);
let own=ux_f64_put(6336,0.0+(spos!=dpos && spos!=cpos && dpos!=cpos));
let copyP=ux_f64_put(6344,ux_f64(288+GeometryPrimitiveRecord.fifth));
let cloneQ=ux_f64_put(6352,ux_f64(608+GeometryPrimitiveRecord.sixth));
let copyTube=ux_f64_put(6360,ux_f64(7264));
let cloneCenter=ux_f64_put(6368,ux_f64(7488));
let sentinel=ux_u32_put(3488,99);
let limited=TorusKnotGeometry_dispose(128,7,3488,1);
let guard=ux_f64_put(6376,0.0+(limited==0-2 && ux_u32(3488)==99));
let first=TorusKnotGeometry_dispose(128,7,3488,3);
let trace=ux_f64_put(6384,0.0+ux_u32(3496)*100+ux_u32(3500));
let target=ux_f64_put(6392,0.0+(first==2 && ux_u32(3488)==128));
let removed=EventDispatcher_removeListener(s,7,82);
let next=TorusKnotGeometry_dispose(128,7,3488,3);
let other=ux_f64_put(6400,0.0+(next==1)*ux_u32(3496));
let td=TorusKnotGeometry_dispose(288,7,3488,3);
let dest=ux_f64_put(6408,0.0+(td==1 && ux_u32(3488)==288)*ux_u32(3496));
let tc=TorusKnotGeometry_dispose(608,7,3488,3);
let none=ux_f64_put(6416,0.0+tc);
return end-4096;
