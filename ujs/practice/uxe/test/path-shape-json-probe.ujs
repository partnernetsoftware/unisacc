if(mode==0) { return ux_span(0,60000); }
let outer=Path_init(128,8192,8);
let hole=Path_init(256,9216,8);
let shape=Shape_init(384,outer,512,1);
let add=Shape_addHole(shape,hole);
let a=ux_u32_put(608+ShapeJsonIdentity.metadata,640);
let b=ux_u32_put(608+ShapeJsonIdentity.uuid,704);
let status=0-1;
if(kind==1) { status=Path_fromJSON(outer,640,40000,40000+length,2048); }
else { status=Shape_fromJSON(shape,608,40000,40000+length,2048); }
if(mode==2) { return status==0-1 && ux_u32(outer+Path.count)==0 && ux_u32(hole+Path.count)==0; }
if(status<0) { return status; }
let count=Path_getPoints(outer,12000,64,3,10752);
let hs=Path_getPoints(hole,14000,64,3,10752);
let c=ux_u32_put(7168,count);
let d=ux_u32_put(7172,hs);
let high=0-1;
if(kind==1) { high=Path_toJSON(outer,640,16000,22000,2048); }
else { high=Shape_toJSON(shape,608,16000,22000,2048); }
if(high<0) { return high; }
return high-16000;
