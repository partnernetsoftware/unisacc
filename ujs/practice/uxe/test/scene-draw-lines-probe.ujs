native function probe_line_stream(stream:i64,xyz:i64,colors:i64,count:i64,stride:i64,shadeStride:i64) i64 {
  let a=ux_u32_put(stream+SceneLineStream.positions,xyz);
  let b=ux_u32_put(stream+SceneLineStream.colors,colors);
  let c=ux_u32_put(stream+SceneLineStream.vertexCount,count);
  let d=ux_u32_put(stream+SceneLineStream.positionStride,stride);
  let e=ux_u32_put(stream+SceneLineStream.colorStride,shadeStride);
  return stream;
}

native function probe_lines_indices(stream:i64,indices:i64,width:i64,count:i64) i64 {
  let a=ux_u32_put(stream+SceneLineStream.indices,indices);
  let b=ux_u32_put(stream+SceneLineStream.indexBytes,width);
  let c=ux_u32_put(stream+SceneLineStream.indexCount,count);
  return stream;
}

let draw=9216;
let stream=9280;
let world=9320;
let proj=9456;
let vertices=8192;
let shader=10500;
let first=ux_u32_put(draw+SceneDrawItem.worldMatrix,world);
let view=ux_u32_put(stream+SceneLineStream.viewProjection,proj);
let topology=ux_u32_put(stream+SceneLineStream.topology,2);
let i=0;
while(i<4) {
  let a=ux_f64_put(world+i*40,1.0);
  let b=ux_f64_put(proj+i*40,1.0);
  i=i+1;
}
let projX=ux_f64_put(proj,0.5);
let projY=ux_f64_put(proj+40,0.5);
let axes=12000;
let axesPos=12128;
let axesRgb=12256;
let interleaved=12512;
let marker=AxesHelper_init(axes,axesPos,axesRgb,0.5);
if(marker<0) { return 0-11; }
if(mode==1) {
  let redStart=ux_f32_put(axesRgb,0.0);
  let blueStart=ux_f32_put(axesRgb+8,1.0);
  let redEnd=ux_f32_put(axesRgb+12,0.0);
  let blueEnd=ux_f32_put(axesRgb+20,1.0);
}
i=0;
while(i<6) {
  let a=uxe_copy_record(interleaved+i*24,ux_u32(axes+AxesHelper.positions)+i*12,12);
  let b=uxe_copy_record(interleaved+i*24+12,ux_u32(axes+AxesHelper.colors)+i*12,12);
  i=i+1;
}
let sx=ux_f64_put(world+96,0.0-1.4375);
let sy=ux_f64_put(world+104,0.0-1.1875);
let line=probe_line_stream(stream,interleaved,interleaved+12,ux_u32(axes+AxesHelper.count),24,24);
let packet=GpuPacket_begin(0,8192,1);
let viewport=GpuPacket_viewport(packet,8192,0,0,32,32);
let clear=GpuPacket_clear(packet,8192,4278190080);
let before=ux_u32(packet+GpuPacket.bytes);
let commands=ux_u32(packet+GpuPacket.commands);

let canary=ux_u32_put(vertices,305419896);
let badColor=ux_u32_put(interleaved+5*24+12,2143289344);
let invalid=SceneDraw_gpuLines(packet,8192,draw,stream,vertices,24,shader);
if(invalid!=(0-2) || ux_u32(vertices)!=305419896 ||
   ux_u32(packet+GpuPacket.bytes)!=before || ux_u32(packet+GpuPacket.commands)!=commands) { return 0-13; }
let repaired=ux_f32_put(interleaved+5*24+12,0.0);
let short=SceneDraw_gpuLines(packet,before+24,draw,stream,vertices,24,shader);
if(short>=0 || ux_u32(packet+GpuPacket.bytes)!=before ||
   ux_u32(packet+GpuPacket.commands)!=commands) { return 0-14; }
let accepted=SceneDraw_gpuLines(packet,8192,draw,stream,vertices,24,shader);
if(accepted<0 || ux_u32(packet+GpuPacket.commands)!=commands+1) { return 0-15; }

let grid=13000;
let gridPos=13056;
let gridRgb=13248;
let gridTints=13440;
let g0=ux_f32_put(gridTints+4,1.0);
let g1=ux_f32_put(gridTints+8,1.0);
let g2=ux_f32_put(gridTints+12,1.0);
let g3=ux_f32_put(gridTints+20,1.0);
let grids=GridHelper_init(grid,gridPos,gridRgb,12,gridTints,1.0,2);
if(grids<0) { return 0-16; }
let gx=ux_f64_put(world+96,0.8125);
let gy=ux_f64_put(world+104,0.0-1.1875);
let q0=ux_f64_put(world+40,0.0);
let q1=ux_f64_put(world+48,0.0-1.0);
let q2=ux_f64_put(world+72,1.0);
let q3=ux_f64_put(world+80,0.0);
let gridLine=probe_line_stream(stream,ux_u32(grid+GridHelper.positions),ux_u32(grid+GridHelper.colors),
    ux_u32(grid+GridHelper.count),12,12);
let gridDraw=SceneDraw_gpuLines(packet,8192,draw,stream,vertices,24,shader);
if(gridDraw<0) { return 0-17; }

let box=14000;
let bounds=14128;
let boxPos=14256;
let boxIndices=14384;
let boxPose=14464;
let boxTint=14528;
let wide=14560;
let lo0=ux_f64_put(bounds,0.3125);
let lo1=ux_f64_put(bounds+8,0.3125);
let lo2=ux_f64_put(bounds+16,0.0-0.25);
let hi0=ux_f64_put(bounds+24,1.3125);
let hi1=ux_f64_put(bounds+32,1.3125);
let hi2=ux_f64_put(bounds+40,0.25);
let ready=Box3Helper_init(box,bounds,boxPos,boxIndices);
let pose=Box3Helper_pose(box,boxPose);
if(ready<0 || pose!=1) { return 0-18; }
let clamp0=ux_f32_put(boxTint,1.0);
let clamp1=ux_f32_put(boxTint+4,1.0);
let unrotate0=ux_f64_put(world+48,0.0);
let unrotate1=ux_f64_put(world+72,0.0);
i=0;
while(i<3) {
  let a=ux_f64_put(world+i*40,ux_f64(boxPose+24+i*8));
  let b=ux_f64_put(world+96+i*8,ux_f64(boxPose+i*8));
  i=i+1;
}
let boxLine=probe_line_stream(stream,ux_u32(box+Box3Helper.positions),boxTint,8,12,0);
let boxIndex=ux_u32(box+Box3Helper.indices);
i=0;
while(i<24) {
  let a=ux_u32_put(wide+i*4,ux_u16(boxIndex+i*2));
  i=i+1;
}
let wideIndices=probe_lines_indices(stream,wide,4,24);
let packed=SceneLine_projectPacked(draw,stream,vertices,24);
if(packed!=24 || ux_f32(vertices)!=0.65625 || ux_f32(vertices+12)!=1.0 ||
   ux_f32(vertices+28)!=0.15625) { return 0-19; }

let badIndex=ux_u32_put(wide+92,8);
let last=ux_u32(vertices+23*28);
let packetBytes=ux_u32(packet+GpuPacket.bytes);
let packetCommands=ux_u32(packet+GpuPacket.commands);
let badDraw=SceneDraw_gpuLines(packet,8192,draw,stream,vertices,24,shader);
if(badDraw>=0 || ux_u32(vertices+23*28)!=last || ux_u32(packet+GpuPacket.bytes)!=packetBytes ||
   ux_u32(packet+GpuPacket.commands)!=packetCommands) { return 0-20; }
let narrowIndices=probe_lines_indices(stream,boxIndex,2,3);
let odd=SceneLine_projectPacked(draw,stream,vertices,24);
let strip=ux_u32_put(stream+SceneLineStream.topology,3);
let stripCount=SceneLine_projectPacked(draw,stream,vertices,24);
let loop=ux_u32_put(stream+SceneLineStream.topology,4);
let loopCount=SceneLine_projectPacked(draw,stream,vertices,24);
if(odd>=0 || stripCount!=3 || loopCount!=3) { return 0-21; }
let pairs=ux_u32_put(stream+SceneLineStream.topology,2);
let indexCount=ux_u32_put(stream+SceneLineStream.indexCount,24);
let boxDraw=SceneDraw_gpuLines(packet,8192,draw,stream,vertices,24,shader);
if(boxDraw<0 || ux_u32(packet+GpuPacket.commands)!=5) { return 0-22; }
return GpuPacket_submit(packet);
