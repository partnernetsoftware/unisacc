let volume=32;
let array=64;
let data=128;
if(op==0) { return ux_span(0,256); }
if(op==1) { return Data3DTexture_create(volume,data,18,3,2,3); }
if(op==2) { return DataArrayTexture_create(array,data,18,3,2,3); }
if(op==3) { return Data3DTexture_sampleR8(volume,x,y,z); }
if(op==4) {
  // Mutation admits the first invalid array layer by redirecting it to layer 0.
  if(mutate!=0 && z==3) { z=0; }
  return DataArrayTexture_sampleR8(array,x,y,z);
}
if(op==5) { return Data3DTexture_create(volume,data,17,3,2,3); }
if(op==6) { return DataArrayTexture_create(array,6291450,18,3,2,3); }
if(op==7) { return Data3DTexture_create(volume,40,18,3,2,3); }
if(op==8) { return DataArrayTexture_create(array,data,0,3,2,0); }
if(op==9) { return Data3DTexture_create(volume,data,18,4294967296,2,3); }
if(op==10) { return Data3DTexture_sampleR8(array,x,y,z); }
if(op==11) { return DataArrayTexture_sampleR8(volume,x,y,z); }
if(op==12) { return Data3DTexture_create(33,data,18,3,2,3); }
if(op==13) { return Data3DTexture_create(96,data+18,2,1,2,1); }
if(op==14) { return Data3DTexture_sampleR8(96,x,y,z); }
if(op==15) { return WebGLUtils_textureFormat(224,1028,1009,0); }
return 0-1;
