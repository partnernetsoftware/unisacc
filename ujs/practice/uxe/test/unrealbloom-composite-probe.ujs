native function bloom_probe_pixel(at:i64,r:i64,g:i64,b:i64,a:i64) i64 {
  return ux_u32_put(at,r+256*g+65536*b+16777216*a);
}

native function bloom_probe_init(table:i64,mode:i64) i64 {
  let starts=[1000,1100,1200,1212,1220];
  let widths=[4,2,1,1,1];
  let r=[2.0,0.0,1.0,1.0,1.0];
  let g=[1.0,2.0,0.0,1.0,2.0];
  let b=[0.0,1.0,2.0,1.0,1.0];
  let k=0;
  while(k<5) {
    let at=table+k*BloomMipRGBA8.size;
    let a=ux_u32_put(at+BloomMipRGBA8.pixels,starts[k]);
    let c=ux_u32_put(at+BloomMipRGBA8.width,widths[k]);
    let d=ux_u32_put(at+BloomMipRGBA8.height,widths[k]);
    let red=1.0;
    let green=1.0;
    let blue=1.0;
    if(mode==1) { red=r[k];green=g[k];blue=b[k]; }
    let e=ux_f64_put(at+BloomMipRGBA8.tintR,red);
    let f=ux_f64_put(at+BloomMipRGBA8.tintG,green);
    let h=ux_f64_put(at+BloomMipRGBA8.tintB,blue);
    k=k+1;
  }
  k=0;
  while(k<16) {
    let fill=bloom_probe_pixel(1000+4*k,18,30,40,20);
    k=k+1;
  }
  let a0=bloom_probe_pixel(1100,30,10,0,30);
  let a1=bloom_probe_pixel(1104,70,30,40,50);
  let a2=bloom_probe_pixel(1108,46,34,32,70);
  let a3=bloom_probe_pixel(1112,86,54,72,90);
  let c=bloom_probe_pixel(1200,25,35,45,60);
  let d=bloom_probe_pixel(1212,50,60,70,80);
  let e=bloom_probe_pixel(1220,10,20,30,40);
  return 0;
}

if(mode<0 || mode>3 || mutate<0 || mutate>1) { return 0-1; }
let table=256;
let dst=1400;
let prepared=bloom_probe_init(table,mode);
let keep=ux_u32_put(dst,123456);
let short=UnrealBloom_compositeRGBA8(table,dst,63,4,4,1.0,0.0);
let overlap=UnrealBloom_compositeRGBA8(table,1100,64,4,4,1.0,0.0);
let invalid=ux_f64_put(table+BloomMipRGBA8.tintR,0.0/0.0);
let nan=UnrealBloom_compositeRGBA8(table,dst,64,4,4,1.0,0.0);
prepared=bloom_probe_init(table,mode);
if(short!=0-1 || overlap!=0-1 || nan!=0-1 || ux_u32(dst)!=123456) { return 0-2; }
let strength=1.0;
let radius=0.0;
if(mode==1) {
  strength=0.5;
  if(mutate==0) { radius=1.0; }
}
if(mode==2) { strength=0.0; }
if(mode==3) { strength=4.0; }
return UnrealBloom_compositeRGBA8(table,dst,64,4,4,strength,radius);
