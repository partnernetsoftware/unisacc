native function native_fxaa_read(packet:i64,id:i64,output:i64) i64 {
  let desc=5000;
  let a=ux_u32_put(desc+GpuTargetRead.id,id);
  let b=ux_u32_put(desc+GpuTargetRead.layer,0);
  let c=ux_u32_put(desc+GpuTargetRead.color,0);
  let d=ux_u32_put(desc+GpuTargetRead.x,0);
  let e=ux_u32_put(desc+GpuTargetRead.y,0);
  let f=ux_u32_put(desc+GpuTargetRead.width,7);
  let g=ux_u32_put(desc+GpuTargetRead.height,5);
  let h=ux_u32_put(desc+GpuTargetRead.output,output);
  return GpuTarget_read(packet,4096,desc);
}

native function native_fxaa_source(packet:i64,pattern:i64) i64 {
  let y=0;
  while(y<5) {
    let x=0;
    while(x<7) {
      let r=0;
      let g=0;
      let b=0;
      let a=255;
      if(pattern==0) { r=20; g=40; b=60; a=0; if(y>=x) { a=240; } }
      if(pattern==1 && y>=3 && x>=3) { r=240; }
      if(pattern==2 && y>=x) { r=50; }
      if(pattern==3 && y>=3) { r=240; }
      if(pattern==4 && x>=3 && y>=2) { r=240; }
      let cell=GpuPacket_scissor(packet,4096,1,x,y,1,1);
      let color=GpuPacket_clear(packet,4096,r+256*g+65536*b+16777216*a);
      if(cell<0 || color<0) { return 0-1; }
      x=x+1;
    }
    y=y+1;
  }
  return GpuPacket_submit(packet);
}

native function native_fxaa_shader(shader:i64,vertexSize:i64,fragment:i64,fragmentSize:i64) i64 {
  let a=ux_u32_put(shader+GpuShaderSource.vertex,10000);
  let b=ux_u32_put(shader+GpuShaderSource.vertexBytes,vertexSize);
  let c=ux_u32_put(shader+GpuShaderSource.fragment,fragment);
  return ux_u32_put(shader+GpuShaderSource.fragmentBytes,fragmentSize);
}

if(pattern<0 || pattern>4 || (mutate!=0 && mutate!=1)) { return 0-1; }
let composer=4200;
let ownership=4300;
let initialized=EffectComposer_init(composer,2,1,4360,2,7,5);
if(initialized<0) { return initialized; }
let created=EffectComposerGpu_create(composer,ownership,0,4096,5000,1);
if(created!=0) { return created; }
let packet=GpuPacket_begin(0,4096,1);
let bound=EffectComposerGpu_bindBuffer(composer,ownership,packet,4096,0);
if(bound<0) { return bound; }
let source=native_fxaa_source(packet,pattern);
if(source!=0) { return source; }
let addFxaa=EffectComposer_addPass(composer,10,3);
let addCopy=EffectComposer_addPass(composer,20,3);
let planned=EffectComposer_plan(composer,4400,4480,2);
if(addFxaa<0 || addCopy<0 || planned!=2) { return 0-1; }
let a=native_fxaa_shader(6300,vn,14500,fn);
let b=native_fxaa_shader(6320,vn,19000,cn);
let shader=6300;
if(mutate==1) { shader=6320; }
let filtered=NativeTargetCopy_step(4480,1,shader);
if(filtered!=0) { return filtered; }
let presented=NativeTargetCopy_step(4480+ComposerStep.size,1,6320);
if(presented!=0) { return presented; }
packet=GpuPacket_begin(0,4096,1);
let readSource=native_fxaa_read(packet,2,7000);
let readFiltered=native_fxaa_read(packet,1,7200);
if(readSource<0 || readFiltered<0) { return 0-1; }
let sampled=GpuPacket_submit(packet);
if(sampled!=0) { return sampled; }
if(FXAA_applyRGBA8(7000,7400,7,5)!=35 || EffectComposer_commit(composer,4400)<0) { return 0-1; }
return EffectComposerGpu_release(ownership,0,4096,0);
