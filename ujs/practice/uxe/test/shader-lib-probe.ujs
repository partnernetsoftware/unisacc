let info=128;
let shader=160;
let vertex=1024;
let texture=512;
let packet=2048;
let capacity=4096;
let text=6144;
if(op==0) { return ux_span(0,12288); }
if(op==1) { return ShaderLib_find(64,a); }
if(op==2) { return ShaderLib_info(info,a); }
if(op==3) {
  let group=ShaderLib_templateGroup(a,b);
  return UniformsLib_groupName(64,96,group);
}
if(op==4) { return UniformsLib_count(ShaderLib_templateGroup(a,b)); }
if(op==5) {
  let group=ShaderLib_templateGroup(a,b);
  return UniformsLib_key(64,96,group,c);
}
if(op==6) { return ShaderLib_templateDefault(256,a,b,c); }
if(op==7) { return ShaderLib_source(shader,text,b,a); }
if(op==9) { return ShaderLib_uniformExtra(64,96,a,b); }
if(op==8) {
  let selected=ShaderLib_info(info,a);
  if(selected<0) { return selected; }
  let topology=ux_u32(info+ShaderLibProgram.topology);
  let textured=ux_u32(info+ShaderLibProgram.textured);
  let variant=a;
  if(b!=0 && textured!=0) { variant=1; }
  let source=ShaderLib_source(shader,text,1024,variant);
  if(source<0) { return source; }
  let ready=GpuPacket_begin(packet,capacity,1);
  let viewport=GpuPacket_viewport(packet,capacity,0,0,9,9);
  let clear=GpuPacket_clear(packet,capacity,4278190080);
  let count=0-1;
  if(textured!=0) { count=GpuPacket_drawTexture(packet,capacity,vertex,3,shader,texture); }
  else { count=GpuPacket_drawPrimitive(packet,capacity,vertex,1,shader,topology); }
  if(count<0) { return count; }
  return GpuPacket_submit(packet);
}
return 0-1;
