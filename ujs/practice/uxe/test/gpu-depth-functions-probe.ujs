native function depth_triangle(vertices:i64,z:f64,green:f64) i64 {
  let index=0;
  while(index<3) {
    let row=vertices+index*28;
    let x=0.0-1.0+4.0*(index==1);
    let y=0.0-1.0+4.0*(index==2);
    let a=ux_f32_put(row,x);
    let b=ux_f32_put(row+4,y);
    let c=ux_f32_put(row+8,z);
    let d=ux_f32_put(row+12,1.0-green);
    let e=ux_f32_put(row+16,green);
    let f=ux_f32_put(row+20,0.0);
    let g=ux_f32_put(row+24,1.0);
    index=index+1;
  }
  return 0;
}
let packet=0;
let capacity=4096;
let state=4352;
let first=4608;
let second=4704;
let shader=4864;
if(variant<0 || variant>5) { return 0-1; }
let selected=GpuDepthFunction_apply(state,value);
if(selected<0) { return selected; }
let status=GpuPacket_begin(packet,capacity,1);
if(status<0) { return status; }
status=GpuPacket_viewport(packet,capacity,0,0,4,4);
if(status<0) { return status; }
status=GpuPacket_state(packet,capacity,0,1,0);
if(status<0) { return status; }
status=GpuPacket_clearDepth(packet,capacity,1.0);
if(status<0) { return status; }
status=GpuPacket_state(packet,capacity,1,variant/3,0);
if(status<0) { return status; }
status=depth_triangle(first,0.0,0.0);
status=GpuPacket_draw(packet,capacity,first,3,shader);
if(status<0) { return status; }
let eqRgb=ux_u32_put(state+GpuRenderState.equationRgb,100);
let eqAlpha=ux_u32_put(state+GpuRenderState.equationAlpha,100);
let srcRgb=ux_u32_put(state+GpuRenderState.sourceRgb,201);
let dstRgb=ux_u32_put(state+GpuRenderState.destinationRgb,200);
let srcAlpha=ux_u32_put(state+GpuRenderState.sourceAlpha,201);
let dstAlpha=ux_u32_put(state+GpuRenderState.destinationAlpha,200);
let mask=ux_u32_put(state+GpuRenderState.colorMask,15);
status=GpuPacket_setRenderState(packet,capacity,state);
if(status<0) { return status; }
let z=0.5*(variant%3)-0.5;
status=depth_triangle(second,z,1.0);
status=GpuPacket_draw(packet,capacity,second,3,shader);
if(status<0) { return status; }
return GpuPacket_submit(packet);
