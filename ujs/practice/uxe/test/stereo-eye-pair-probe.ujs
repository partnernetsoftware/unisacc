// Modes 2..4 exercise the released pair without rematerializing it.
if(mode==2) { return StereoCamera_disposePair(3520); }
if(mode==3) { return StereoCamera_eyeRender(3520,0,7680); }
if(mode==4) { return StereoCamera_eyeRender(3520,1,8000); }
if(mode!=0 && mode!=1) { return 0-1; }
let stereo=StereoCamera_init(0,1024,1152,1280,1408);
let sep=ux_f64_put(stereo+StereoCamera.eyeSep,1.0);
let proj=Matrix4_makePerspective(256,0.0-1.0,1.0,1.0,0.0-1.0,1.0,11.0,2000.0);
let world=Matrix4_identity(512);
let updated=StereoCamera_update(stereo,proj,world,90.0,1.0,1.0,10.0);
let arena=Object3D_initArena(4096,4);
let pair=StereoCamera_initPair(3520,stereo,arena,2048);
if(pair<0) { return 0-1; }
let left=StereoCamera_eyeRender(pair,0,7680);
let right=StereoCamera_eyeRender(pair,1,8000);
if(left<0 || right<0) { return 0-2; }
let alias=StereoCamera_eyeRender(pair,0,2048);
if(alias>=0) { return 0-3; }
if(mode==1) { let wrong=ux_u32_put(right+128,ux_u32(left+128)); }
return 0;
