let space=GpuColor_outputSpaceTag(8500,mode);
if(space<0) { return space; }
let rgb=GpuColor_output(8400,0.21404114048223255,0.05087608817155679,0.0024282158683907,space);
if(rgb<0) { return rgb; }
let r=ux_f64(rgb);
let g=ux_f64(rgb+8);
let b=ux_f64(rgb+16);
let vertices=[0.0-0.75,0.0-0.75,0.75,0.0-0.75,0.0,0.75];
let i=0;
while(i<3) {
  let p=4000+i*28;
  let px=ux_f32_put(p,vertices[i*2]);
  let py=ux_f32_put(p+4,vertices[i*2+1]);
  let pz=ux_f32_put(p+8,0.0);
  let pr=ux_f32_put(p+12,r);
  let pg=ux_f32_put(p+16,g);
  let pb=ux_f32_put(p+20,b);
  let pa=ux_f32_put(p+24,1.0);
  i=i+1;
}
let packet=GpuPacket_begin(0,2048,1);
let view=GpuPacket_viewport(packet,2048,0,0,16,16);
let clear=GpuPacket_clear(packet,2048,4278190080);
let shader=probe_shader_sources(6400);
let result=GpuPacket_draw(packet,2048,4000,3,shader);
if(result<0) { return result; }
return GpuPacket_submit(packet);
