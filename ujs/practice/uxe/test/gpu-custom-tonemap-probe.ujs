native function tone_probe_fill(packet:i64) i64 {
  let y=0;
  while(y<2) {
    let x=0;
    while(x<4) {
      let red=32+40*x+12*y;
      let green=24+20*x+48*y;
      let blue=17+46*x+7*y;
      let alpha=31+32*x+64*y;
      let clip=GpuPacket_scissor(packet,4096,1,x,y,1,1);
      let fill=GpuPacket_clear(packet,4096,red+256*green+65536*blue+16777216*alpha);
      if(clip<0 || fill<0) { return 0-1; }
      x=x+1;
    }
    y=y+1;
  }
  return GpuPacket_submit(packet);
}

if(mode<0 || mode>2 || mutate<0 || mutate>1) { return 0-1; }
let composer=4200;
let ownership=4300;
let initialized=EffectComposer_init(composer,2,1,4360,1,4,2);
let added=EffectComposer_addPass(composer,10,3);
let planned=EffectComposer_plan(composer,4400,4480,1);
if(initialized<0 || added<0 || planned!=1) { return 0-2; }
let created=EffectComposerGpu_create(composer,ownership,0,4096,5000,1);
if(created!=0) { return created; }
let packet=GpuPacket_begin(0,4096,1);
let bound=EffectComposerGpu_bindBuffer(composer,ownership,packet,4096,0);
if(bound<0) { return bound; }
let seeded=tone_probe_fill(packet);
if(seeded!=0) { return seeded; }
let exposure=0.0;
if(mode==1) { exposure=0.7; }
if(mode==2) { exposure=2.0; }
if(mode==1 && mutate==1) { exposure=1.0; }

let base=14500;
let hook=19000;
let out=23500;
let fragment=GpuCustomTone_compose(base,fn,hook,hn,out,4096,exposure);
if(fragment!=fn+hn+43) { return 0-3; }
let keep=ux_u32(out);
let short=GpuCustomTone_compose(base,fn,hook,hn,out,fragment-1,exposure);
let overlap=GpuCustomTone_compose(base,fn,hook,hn,base,4096,exposure);
let invalid=GpuCustomTone_compose(base,fn,hook,hn,out,4096,0.0/0.0);
if(short!=0-1 || overlap!=0-1 || invalid!=0-1 || ux_u32(out)!=keep) { return 0-4; }
let shader=6300;
let a=ux_u32_put(shader+GpuShaderSource.vertex,10000);
let b=ux_u32_put(shader+GpuShaderSource.vertexBytes,vn);
let c=ux_u32_put(shader+GpuShaderSource.fragment,out);
let d=ux_u32_put(shader+GpuShaderSource.fragmentBytes,fragment);
let start=out+fn+43;
let original=ux_u8(start);
let corrupt=ux_u8_put(start,88);
let bad=NativeTargetCopy_step(4480,1,shader);
let restored=ux_u8_put(start,original);
if(bad!=0-14) { return 0-5; }
let drew=NativeTargetCopy_step(4480,1,shader);
if(drew!=0) { return drew; }
if(EffectComposer_commit(composer,4400)<0) { return 0-6; }
return EffectComposerGpu_release(ownership,0,4096,0);
