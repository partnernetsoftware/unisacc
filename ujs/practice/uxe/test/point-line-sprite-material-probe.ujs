let src=512;
let dst=640;
let json=1024;
let output=3072;
let scratch=4096;
let snapshot=5504;
let obj=src;
if(arg==1) { obj=dst; }
if(op==0) { return ux_span(0,6144); }
if(op==1) {
  let sourceEvents=EventDispatcher_init(64,128,2);
  let targetEvents=EventDispatcher_init(80,160,2);
  if(kind==10) {
    if(PointsMaterial_init(src,17,sourceEvents)!=src || PointsMaterial_init(dst,19,targetEvents)!=dst) { return 0-1; }
  } else if(kind==11) {
    if(LineBasicMaterial_init(src,17,sourceEvents)!=src || LineBasicMaterial_init(dst,19,targetEvents)!=dst) { return 0-1; }
  } else if(kind==13) {
    if(SpriteMaterial_init(src,17,sourceEvents)!=src || SpriteMaterial_init(dst,19,targetEvents)!=dst) { return 0-1; }
  } else { return 0-1; }
  return 0;
}
if(op==2) {
  if(arg<=0 || arg>1600) { return 0-1; }
  let loaded=PointLineSprite_readJSON(src,json,json+arg,scratch);
  if(loaded>=0 && mutate!=0) {
    let missing=ux_u32_put(src+Material.size+PointLineSpriteFields.fog,1);
  }
  return loaded;
}
if(op==3) {
  let f=obj+Material.size;
  let a=ux_f64_put(snapshot,0.0+ux_u32(f+PointLineSpriteFields.color));
  let b=ux_f64_put(snapshot+8,0.0+ux_u32(f+PointLineSpriteFields.fog));
  let c=ux_f64_put(snapshot+16,0.0+ux_u32(f+PointLineSpriteFields.attenuation));
  let d=ux_f64_put(snapshot+24,ux_f64(f+PointLineSpriteFields.value));
  let e=ux_f64_put(snapshot+32,0.0+ux_u32(obj+Material.transparent));
  let g=ux_f64_put(snapshot+40,ux_f64(obj+Material.opacity));
  let h=ux_f64_put(snapshot+48,0.0+ux_u32(obj+Material.side));
  return snapshot;
}
if(op==4) { return PointLineSprite_writeJSON(obj,output,output+700,scratch); }
if(op==5) { return PointLineSprite_copy(dst,src); }
return 0-1;
