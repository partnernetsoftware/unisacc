if(mode==0) { return ux_span(0,60000); }
let input=4096;
let out=128;
let groups=2304;
let cap=64;
let groupCap=8;
let slots=64;
if(mode==2) { cap=8; }
if(mode==3) { groupCap=1; }
if(mode==4) { slots=3; }
if(mode==5) { out=input; }
if(length<0 || length>8000) { return 0-101; }
return OBJLoader_parse(input,length,out,cap,groups,groupCap,16384,slots);
