if(mode==0) { return ux_span(0,60000); }
if(mode<1 || mode>5 || length<1 || length>4096) { return 0-100; }
let source=GeometryBuffers_init(64,2000,16,2800,24);
let output=GeometryBuffers_init(128,3100,64,5500,0);
let workspace=832;
let a=ux_u32_put(workspace+LineGeometryWorkspace.source,source);
let b=ux_u32_put(workspace+LineGeometryWorkspace.output,output);
let c=ux_u32_put(workspace+LineGeometryWorkspace.scratch,896);
let d=ux_u32_put(workspace+LineGeometryWorkspace.edges,10080);
let e=ux_u32_put(workspace+LineGeometryWorkspace.edgesBytes,960);
let at=256;
let status=0-1;
if(mode==1) {
  status=LineGeometry_create(at,40000,40000+length,workspace,kind,1.0);
} else {
  if(mode==5) { let alias=ux_u32_put(workspace+LineGeometryWorkspace.scratch,2000); }
  status=LineGeometry_fromJSON(at,40000,40000+length,workspace);
}
if(mode>=3) { return status==0-1 && ux_u32(at+LineGeometrySource.kind)==0; }
if(status!=at) { return status; }
let identity=960;
let p=ux_u32_put(identity+LineGeometryIdentity.uuid,992);
let z=ux_u32_put(identity+LineGeometryIdentity.uuidBytes,6);
let n=ux_u32_put(identity+LineGeometryIdentity.name,1000);
let l=ux_u32_put(identity+LineGeometryIdentity.nameBytes,8);
let count=ux_u32_put(1040,ux_u32(output+GeometryBuffers.vertexCount));
let idx=ux_u32_put(1044,ux_u32(output+GeometryBuffers.indexCount));
let end=LineGeometry_toJSON(at,12000,16000,identity,17000);
if(end<0) { return end; }
return end-12000;
