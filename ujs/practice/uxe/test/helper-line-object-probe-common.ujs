native function line_probe_init(kind:i64,mutate:i64) i64 {
  let gEnd=line_probe_geometry(kind);
  if(gEnd<0) { return gEnd; }
  let events=EventDispatcher_init(480,520,2);
  let sharedAxes=AxesHelper_init(2400,2500,2600,3.0);
  let owner=AxesHelperObject_bind(128,sharedAxes,384,17,events);
  if(owner!=128) { return 0-102; }
  if(kind==4 || kind==5) {
    let tint=ux_u32_put(owner+AxesHelperObject.color,16776960);
    let colors=ux_u32_put(owner+AxesHelperObject.vertexColors,0);
  }
  if(kind==7) {
    let material=ux_u32(owner+AxesHelperObject.material);
    let test=ux_u32_put(material+Material.depthTest,0);
    let write=ux_u32_put(material+Material.depthWrite,0);
    let alpha=ux_u32_put(material+Material.transparent,1);
  }
  let mEnd=AxesHelperObject_materialToJSON(owner,40000,49000,952,6,6000);
  if(mEnd<0) { return mEnd; }
  let o=8000;
  let a=ux_u32_put(o+HelperLineJson.kind,kind);
  let b=ux_u32_put(o+HelperLineJson.uuid,960);
  let c=ux_u32_put(o+HelperLineJson.uuidBytes,6);
  let d=ux_u32_put(o+HelperLineJson.name,968);
  let e=ux_u32_put(o+HelperLineJson.nameBytes,8);
  let f=ux_u32_put(o+HelperLineJson.geometry,30000);
  let g=ux_u32_put(o+HelperLineJson.geometryEnd,gEnd);
  let h=ux_u32_put(o+HelperLineJson.material,40000);
  let i=ux_u32_put(o+HelperLineJson.materialEnd,mEnd);
  let root=Object3D_initArena(12000,1);
  let handle=Object3D_create(root);
  let node=Object3D_address(root,handle);
  if(node!=12008) { return 0-103; }
  let shown=ux_u32_put(node+Object3D.visible,kind%2);
  let mask=2147483648+kind;
  if(kind==2 && mutate) { mask=mask+4; }
  let layers=ux_u32_put(node+Object3D.layerMask,mask);
  let matrix=ux_u32(node+Object3D.localMatrix);
  let tx=ux_f64_put(matrix+96,2.0+kind);
  let ty=ux_f64_put(matrix+104,0.0-kind);
  return node;
}

if(mode==0) { return ux_span(0,90000); }
if(mode==1) {
  let node=line_probe_init(kind,mutate);
  if(node<0) { return node; }
}
if(mode==1 || mode==2) {
  let end=HelperLineObject_toJSON(12008,8000,50000,78000,16000,mode-1);
  if(end<0) { return end; }
  return end-50000;
}
if(mode==3) {
  let original=ux_u32(8000+HelperLineJson.material);
  let originalEnd=ux_u32(8000+HelperLineJson.materialEnd);
  let wrong=ux_u32_put(8000+HelperLineJson.material,30000);
  let wrongEnd=ux_u32_put(8000+HelperLineJson.materialEnd,ux_u32(8000+HelperLineJson.geometryEnd));
  let refused=HelperLineObject_toJSON(12008,8000,50000,78000,16000,1);
  let back=ux_u32_put(8000+HelperLineJson.material,original);
  let backEnd=ux_u32_put(8000+HelperLineJson.materialEnd,originalEnd);
  return refused;
}
if(mode==4) { return HelperLineObject_toJSON(12008,8000,50000,50016,16000,1); }
if(mode==5) { return HelperLineObject_toJSON(12008,8000,8000,10000,16000,1); }
if(mode==6 || mode==7) {
  let end=HelperLineObject_toJSON(12008,8000,50000,78000,16000,0);
  if(end<0) { return end; }
  let matrix=ux_u32(12008+Object3D.localMatrix);
  let saved=ux_f64(matrix+96);
  let savedY=ux_f64(matrix+104);
  let layers=ux_u32(12008+Object3D.layerMask);
  let visible=ux_u32(12008+Object3D.visible);
  let cleared=ux_f64_put(matrix+96,0.0);
  let clearedY=ux_f64_put(matrix+104,0.0);
  let empty=ux_u32_put(12008+Object3D.layerMask,0);
  let shown=ux_u32_put(12008+Object3D.visible,1-visible);
  if(mode==7) {
    let refused=HelperLineObject_fromJSON(12008,8000,50000,end-1,16000);
    return refused<0 && ux_f64(matrix+96)==0.0 && ux_u32(12008+Object3D.layerMask)==0;
  }
  let length=end;
  if((kind==2 || kind>=4) && mutate) { length=length-1; }
  let decoded=HelperLineObject_fromJSON(12008,8000,50000,length,16000);
  return decoded==12008 && ux_f64(matrix+96)==saved && ux_f64(matrix+104)==savedY &&
    ux_u32(12008+Object3D.layerMask)==layers && ux_u32(12008+Object3D.visible)==visible;
}
return 0-1;
