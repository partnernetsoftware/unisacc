native function scene_soft_probe(plan:i64,colors:i64,gpuStats:i64,mutate:i64) i64 {
  let stats=16032;
  let target=16128;
  let rgba=16512;
  let depth=17664;
  let stage=18816;
  let space=2080;
  let a=ux_u32_put(target+SceneRasterTarget.rgba,rgba);
  let b=ux_u32_put(target+SceneRasterTarget.depth,depth);
  let c=ux_u32_put(target+SceneRasterTarget.width,16);
  let d=ux_u32_put(target+SceneRasterTarget.height,16);
  let i=0;
  while(i<256) {
    let color=ux_u32_put(rgba+i*4,4278190080);
    let old=ux_f32_put(depth+i*4,1.0);
    i=i+1;
  }
  i=0;
  while(i<7) {
    let reserve=ux_u32_put(stats+i*4,12345+i);
    i=i+1;
  }
  let nan=ux_f32_put(colors+32,0.0/0.0);
  let rejected=SceneSoftware_consume(target,plan,stats,stage,space);
  let restored=ux_f32_put(colors+32,1.0);
  let center=(9*16+8)*4;
  let hadPartial=ux_u32(stage+32+center)!=4278190080;
  let intact=rejected==0-2 && hadPartial;
  i=0;
  while(i<256) {
    intact=intact && ux_u32(rgba+i*4)==4278190080 && ux_f32(depth+i*4)==1.0;
    i=i+1;
  }
  i=0;
  while(i<7) {
    intact=intact && ux_u32(stats+i*4)==12345+i;
    i=i+1;
  }
  let saved=ux_u32_put(16064,intact);
  if(!intact) { return 0-10; }
  let first=ux_u32(plan+SceneConsumePlan.draws)+SceneDrawItem.size;
  let last=first+SceneDrawItem.size*2;
  let temporary=16256;
  if(mutate) {
    let a=uxe_copy_record(temporary,first,SceneDrawItem.size);
    let b=uxe_copy_record(first,last,SceneDrawItem.size);
    let c=uxe_copy_record(last,temporary,SceneDrawItem.size);
  }
  let drawn=SceneSoftware_consume(target,plan,stats,stage,space);
  if(mutate) {
    let b=uxe_copy_record(last,first,SceneDrawItem.size);
    let c=uxe_copy_record(first,temporary,SceneDrawItem.size);
  }
  if(drawn<0) { return drawn; }
  i=0;
  while(i<6) {
    if(ux_u32(stats+i*4)!=ux_u32(gpuStats+i*4)) { return 0-11; }
    i=i+1;
  }
  return drawn;
}
