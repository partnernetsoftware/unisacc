// R4 fixture: magic, width, height, mode, then packed RGBA8 bytes.
function dt_fixture_callback(capture,...args) {
  let seen=ux_u32_put(capture[0],ux_u32(capture[0])+1);
  return dt_fixture_parser(args[0],args[1],args[2],args[3],args[4]);
}

native function dt_fixture_parser(input:i64,size:i64,image:i64,stage:i64,cap:i64) i64 {
  if(size<6 || ux_u8(input)!=82 || ux_u8(input+1)!=52) { return 0-2; }
  let width=ux_u8(input+2);
  let height=ux_u8(input+3);
  let mode=ux_u8(input+4);
  let bytes=4*width*height;
  if(width==0 || height==0 || size!=5+bytes || mode>2) { return 0-2; }
  let pixels=input+5;
  if(mode==1) {
    if(bytes>cap) { return 0-2; }
    let i=0;
    while(i<bytes) {
      let byte=ux_u8_put(stage+i,u32_xor(ux_u8(pixels+i),90));
      i=i+1;
    }
    pixels=stage;
  }
  if(mode==2) { pixels=256; }
  let a=ux_u32_put(image+DataTextureAsyncImage.data,pixels);
  let b=ux_u32_put(image+DataTextureAsyncImage.bytes,bytes);
  let c=ux_u32_put(image+DataTextureAsyncImage.width,width);
  let d=ux_u32_put(image+DataTextureAsyncImage.height,height);
  return 0;
}

let instance=128;
if(which==1) { instance=256; }
if(op==0) { return ux_span(0,16384); }
if(op==1) {
  let manager=LoadingManager_init(64);
  let main=DataTextureLoader_family(128,0,manager);
  let other=MaterialLoader_family(256,0,manager);
  return main==128 && other==256;
}
if(op==2) { return LoaderFamily_setPath(instance,a,b); }
if(op==3) { return LoaderFamily_beginAsync(instance,a,b,1024,1800,3072,3200); }
if(op==4) { return LoaderFamily_receiveAsync(instance,a,b,c,d,3200); }
if(op==5) {
  let callback=closure(dt_fixture_callback,3800);
  return DataTextureLoader_decodeAsync(callback,instance,a,4096,256,4608,b);
}
if(op==6) {
  let callback=closure(dt_fixture_callback,3800);
  return DataTextureLoader_decodeAsync(callback,instance,a,4096,256,b,32);
}
if(op==7) { return LoaderFamily_releaseAsync(instance,a); }
return 0-1;
