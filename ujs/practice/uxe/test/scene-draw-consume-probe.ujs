let packet=0;
let plan=8320;
let draws=8448;
let stats=8592;
if(mode==9) { return ux_span(0,16384); }
let query=8640;
let nodes=8704;
let binds=8832;
let projection=9216;
let matrices=9344;
let resources=10048;
let streams=10160;
let positions=10256;
let colors=10304;
let uv=10432;
let texture=10512;
let textured=10560;
let flatShader=10752;
let texShader=10768;
let sort=11008;
let vertices=11424;
let probe=11680;
let a=ux_u32_put(query+SceneRenderQuery.snapshot,nodes);
let b=ux_u32_put(query+SceneRenderQuery.bindings,binds);
let c=ux_u32_put(query+SceneRenderQuery.count,5);
let d=ux_u32_put(query+SceneRenderQuery.layerMask,1);
let e=ux_u32_put(query+SceneRenderQuery.viewProjection,projection);

let i=0;
while(i<4) {
  let a=ux_f64_put(projection+i*40,1.0);
  i=i+1;
}
i=0;
while(i<5) {
  let n=nodes+i*SceneSnapshotRow.size;
  let r=binds+i*SceneRenderBinding.size;
  let world=matrices+i*128;
  let node=103;
  let z=0.0-0.25;
  let x=0.0;
  let geometry=11;
  let material=22;
  let pass=2;
  if(i==1) { node=101; material=20; z=0.5; pass=0; }
  if(i==2) { node=102; material=21; z=0.25; }
  if(i==3) { node=104; material=21; geometry=12; z=0.25; x=0.0-0.65; }
  if(i==4) { node=105; geometry=99; }
  let a=ux_u32_put(n+SceneSnapshotRow.node,node);
  let b=ux_u32_put(n+SceneSnapshotRow.visible,1);
  let c=ux_u32_put(n+SceneSnapshotRow.layerMask,1+(i==4));
  let d=ux_u32_put(n+SceneSnapshotRow.worldMatrix,world);
  let f=ux_u32_put(r+SceneRenderBinding.node,node);
  let g=ux_u32_put(r+SceneRenderBinding.geometry,geometry);
  let h=ux_u32_put(r+SceneRenderBinding.material,material);
  let j=ux_u32_put(r+SceneRenderBinding.pass,pass);
  let k=ux_f64_put(r+SceneRenderBinding.renderOrder,0.0-(mode==1 && i==0)*1.0);
  let col=0;
  while(col<4) {
    let a=ux_f64_put(world+col*40,1.0);
    col=col+1;
  }
  let mx=ux_f64_put(world+96,x);
  let mz=ux_f64_put(world+112,z);
  i=i+1;
}

i=0;
while(i<3) {
  let stream=streams+i*SceneDrawStream.size;
  let rgba=colors+i*16;
  let a=ux_u32_put(stream+SceneDrawStream.positions,positions);
  let b=ux_u32_put(stream+SceneDrawStream.vertexCount,3);
  let c=ux_u32_put(stream+SceneDrawStream.stride,12);
  let d=ux_u32_put(stream+SceneDrawStream.color,rgba);
  let e=ux_u32_put(stream+SceneDrawStream.viewProjection,projection);
  let r=ux_f32_put(rgba,(i==2)*1.0);
  let h=ux_f32_put(rgba+4,(i==0)*1.0);
  let q=ux_f32_put(rgba+12,1.0-(i==2)*0.5);
  i=i+1;
}

let px=ux_f32_put(positions,0.0-0.35);
let py=ux_f32_put(positions+4,0.0-0.5);
let qx=ux_f32_put(positions+12,0.35);
let qy=ux_f32_put(positions+16,0.0-0.5);
let ry=ux_f32_put(positions+28,0.5);
let a=ux_u32_put(textured+SceneTextureDraw.stream,streams+SceneDrawStream.size);
let b=ux_u32_put(textured+SceneTextureDraw.uv,uv);
let c=ux_u32_put(textured+SceneTextureDraw.uvStride,8);
let d=ux_u32_put(textured+SceneTextureDraw.texture,texture);
let e=ux_u32_put(textured+SceneTextureDraw.shader,texShader);
let w=ux_u32_put(texture+GpuTextureSource.width,1);
let h=ux_u32_put(texture+GpuTextureSource.height,1);
let rgba=ux_u32_put(texture+GpuTextureSource.rgba,10544);
let texel=ux_u32_put(10544,2164195328);

i=0;
while(i<5) {
  let row=resources+i*SceneConsumeBinding.size;
  let g=11;
  let m=20+i;
  let index=i;
  let shader=flatShader;
  let tex=0;
  if(i==1 || i==3) { shader=texShader; tex=textured; m=21; index=1; }
  if(i==3) { g=12; }
  if(i==4) { g=99; m=99; index=0; }
  let a=ux_u32_put(row+SceneConsumeBinding.geometry,g);
  let b=ux_u32_put(row+SceneConsumeBinding.material,m);
  let c=ux_u32_put(row+SceneConsumeBinding.stream,streams+index*SceneDrawStream.size);
  let d=ux_u32_put(row+SceneConsumeBinding.shader,shader);
  let e=ux_u32_put(row+SceneConsumeBinding.textured,tex);
  i=i+1;
}

let count=Scene_renderList(query,draws,5,sort,384);
if(count!=4) { return 0-9; }
let a=ux_u32_put(plan+SceneConsumePlan.draws,draws);
let b=ux_u32_put(plan+SceneConsumePlan.count,count);
let c=ux_u32_put(plan+SceneConsumePlan.bindings,resources);
let d=ux_u32_put(plan+SceneConsumePlan.bindingCount,5);
let e=ux_u32_put(plan+SceneConsumePlan.vertices,vertices);
let f=ux_u32_put(plan+SceneConsumePlan.vertexCapacity,3);

let begin=GpuPacket_begin(packet,8192,1);
let vp=GpuPacket_viewport(packet,8192,0,0,16,16);
let clr=GpuPacket_clear(packet,8192,4278190080);
let oldBytes=ux_u32(packet+GpuPacket.bytes);
let oldCount=ux_u32(packet+GpuPacket.commands);
i=0;
while(i<7) {
  let mark=ux_u32_put(stats+i*4,12345+i);
  i=i+1;
}
let poison=ux_f32_put(colors+32,0.0/0.0);
let rejected=SceneGpu_consume(packet,8192,plan,stats);
let restored=ux_f32_put(colors+32,1.0);
let same=rejected==0-2 && oldBytes==ux_u32(packet+GpuPacket.bytes) &&
  oldCount==ux_u32(packet+GpuPacket.commands);
i=0;
while(i<7) {
  same=same && ux_u32(stats+i*4)==12345+i;
  i=i+1;
}
let refusal=ux_u32_put(probe,same);
if(!same) { return 0-8; }
let result=SceneGpu_consume(packet,8192,plan,stats);
if(result<0) { return result; }
return GpuPacket_submit(packet);
