import host_time from "env"() f64;
export uxe_dispatch(op:i64, offset:i64, value:i64) i64 version 1;

function base_byte(baseValue) { return baseValue; }
function base_clock(baseTime) { return baseTime; }

if (op == 0) {
  let written = ux_u8_put(offset, value);
  return ux_u8(offset);
}
let tick = 0;
tick = base_clock(host_time());
return base_byte(ux_u8(offset)) + tick;
