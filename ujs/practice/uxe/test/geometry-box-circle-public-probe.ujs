import uxe_box_circle_dispatch from "uxe_box_circle_v1"(i64,i64,i64,i64) f64;
export uxe_box_circle_probe(op:i64,kind:i64,which:i64,value:i64,mutate:i64) f64 version 1;

if(op==7 && mutate==1 && kind==1) { return uxe_box_circle_dispatch(op,kind,0,value); }
if(op==5 && mutate==2 && kind==2) { return uxe_box_circle_dispatch(op,kind,which,8); }
return uxe_box_circle_dispatch(op,kind,which,value);
