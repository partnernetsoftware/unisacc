native function timed_probe_init() i64 {
  let action=AnimationAction_initTimed(0,8.0,2200,0,0);
  let original=ux_f64_put(256,10.0);
  let mix=PropertyMixer_init(288,320,256,1);
  let a=ux_f32_put(480,0.0);
  let b=ux_f32_put(484,8.0);
  let c=ux_f32_put(496,2.0);
  let d=ux_f32_put(500,18.0);
  let seq=AnimationSamples_init(512,480,496,2,1);
  return action;
}

native function timed_probe_step(now:f64,delta:f64) i64 {
  let tick=AnimationAction_tickTimed(0,now,delta);
  if(tick<0) { return tick; }
  let weight=AnimationAction_getWeight(0);
  if(weight>0.0) {
    let sampled=LinearInterpolant_evaluate(512,ux_f64(AnimationAction.sampleTime),560);
    if(sampled<0) { return sampled; }
    let copied=ux_f64_put(568,ux_f32(560));
    let acc=PropertyMixer_accumulate(288,568,weight,2500);
    if(acc<0) { return acc; }
  }
  return PropertyMixer_apply(288);
}

if(op==0) { return 0.0+timed_probe_init(); }
if(op==1) { return 0.0+AnimationAction_startAt(0,a); }
if(op==2) { return 0.0+AnimationAction_fadeIn(0,a,b); }
if(op==3) { return 0.0+AnimationAction_fadeOut(0,a,b); }
if(op==4) { return 0.0+timed_probe_step(a,b); }
if(op==5) { return ux_f64(AnimationAction.time); }
if(op==6) { return AnimationAction_getWeight(0); }
if(op==7) { return 0.0+ux_u32(AnimationAction.enabled); }
if(op==8) { return ux_f64(344); }
if(op==9) { return 0.0+AnimationAction_stopFading(0); }
if(op==10) { return 0.0+AnimationAction_setWeight(0,a); }
if(op==11) {
  let saved=ux_f64_put(AnimationAction.time,a);
  return a;
}
if(op==12) {
  let state=AnimationAction.size;
  return 0.0+ux_u32(state+AnimationActionControl.scheduled)*2+ux_u32(state+AnimationActionControl.fading);
}
return 0.0-1.0;
