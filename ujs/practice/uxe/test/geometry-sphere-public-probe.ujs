let listen2=EventDispatcher_addListener(s,7,82);
let listen3=EventDispatcher_addListener(d,7,61);
let copied=SphereGeometry_copy(288,128,49152,4096);
let cloned=SphereGeometry_clone(768,128,57344,4096);
let occupied=SphereGeometry_clone(288,128,57344,4096);
if(copied!=288 || cloned!=768 || occupied!=0-1) { return 0-106; }
let spos=ux_u32(BufferGeometry_getAttribute(s,1)+BufferAttribute.data);
let dpos=ux_u32(BufferGeometry_getAttribute(d,1)+BufferAttribute.data);
let cpos=ux_u32(BufferGeometry_getAttribute(c,1)+BufferAttribute.data);
let changed=ux_f32_put(spos+4,9.0);
