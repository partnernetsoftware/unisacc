native function sphere_probe_values(at:i64,out:i64) i64 {
  let geo=SphereGeometry_geometry(at);
  let pos=BufferGeometry_getAttribute(geo,1);
  let normal=BufferGeometry_getAttribute(geo,2);
  let uv=BufferGeometry_getAttribute(geo,4);
  let idx=BufferGeometry_getIndex(geo);
  let a=ux_f64_put(out,0.0+ux_u32(pos+BufferAttribute.count));
  let b=ux_f64_put(out+8,0.0+ux_u32(idx+BufferAttribute.count));
  let i=0;
  while(i<6) {
    let p=ux_f64_put(out+16+i*8,ux_f64(at+GeometryPrimitiveRecord.first+i*8));
    i=i+1;
  }
  let tail=ux_f64_put(out+64,ux_f64(at+GeometryPrimitive_size()));
  let y=ux_f64_put(out+72,ux_f32(ux_u32(pos+BufferAttribute.data)+4));
  let z=ux_f64_put(out+80,ux_f32(ux_u32(pos+BufferAttribute.data)+8));
  let ny=ux_f64_put(out+88,ux_f32(ux_u32(normal+BufferAttribute.data)+4));
  let u=ux_f64_put(out+96,ux_f32(ux_u32(uv+BufferAttribute.data)+8*(ux_u32(uv+BufferAttribute.count)-1)));
  let index=ux_f64_put(out+104,0.0+ux_u16(ux_u32(idx+BufferAttribute.data)));
  let last=ux_u32(pos+BufferAttribute.data)+12*(ux_u32(pos+BufferAttribute.count)-1);
  let lastY=ux_f64_put(out+112,ux_f32(last+4));
  let lastZ=ux_f64_put(out+120,ux_f32(last+8));
  return out;
}

