let clamp=SphereGeometry_fromJSON(608,raw,53248,4096,5840,5881,2048);
if(defaults!=448 || clamp!=608) { return 0-105; }
let status=ux_f64_put(6160,0.0+(short==0-1 && broken==0-1 && alias==0-1 && bad==0-1 &&
  ux_u32(768+GeometryPrimitiveRecord.kind)==0));
let values=sphere_probe_values(288,6168);
let source=sphere_probe_values(128,6400);
let fallback=sphere_probe_values(448,6656);
let minimum=sphere_probe_values(608,6912);
let equal=1;
i=0;
while(i<16) {
  let delta=ux_f64(6168+i*8)-ux_f64(6400+i*8);
  if(delta<0.0-0.000000001 || delta>0.000000001) { equal=0; }
