let mv=ux_f64_put(6320,ux_f64(6912));
let mi=ux_f64_put(6328,ux_f64(6920));
let mw=ux_f64_put(6336,ux_f64(6936));
let mh=ux_f64_put(6344,ux_f64(6944));

