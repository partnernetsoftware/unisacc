let own=ux_f64_put(6352,0.0+(spos!=dpos && spos!=cpos && dpos!=cpos));
let dangle=ux_f64_put(6360,ux_f64(288+GeometryPrimitive_size()));
let cangle=ux_f64_put(6368,ux_f64(768+GeometryPrimitive_size()));
let dy=ux_f64_put(6376,ux_f32(dpos+4));
let cy=ux_f64_put(6384,ux_f32(cpos+4));
let sentinel=ux_u32_put(3488,99);
let limited=SphereGeometry_dispose(128,7,3488,1);
let guard=ux_f64_put(6392,0.0+(limited==0-2 && ux_u32(3488)==99));
