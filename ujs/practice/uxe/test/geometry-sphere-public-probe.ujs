let i=0;
while(i<5) {
  let at=128+i*160;
  let attrs=1024+i*128;
  let layout=BufferGeometry_init(SphereGeometry_geometry(at),attrs,3,attrs+64,0);
  let dispatcher=EventDispatcher_init(layout,attrs+80,3);
  if(layout<0 || dispatcher!=layout) { return 0-101; }
  i=i+1;
}
let raw=GeometryBuffers_init(1800,8192,600,28000,3000);
let params=1920;
let p0=ux_f64_put(params+SphereGeometryParameters.radius,2.5+mutate);
let p1=ux_f64_put(params+SphereGeometryParameters.widthSegments,4.5);
let p2=ux_f64_put(params+SphereGeometryParameters.heightSegments,2.5);
let p3=ux_f64_put(params+SphereGeometryParameters.phiStart,0.5);
let p4=ux_f64_put(params+SphereGeometryParameters.phiLength,1.5);
let p5=ux_f64_put(params+SphereGeometryParameters.thetaStart,0.25);
let p6=ux_f64_put(params+SphereGeometryParameters.thetaLength,1.25);
let created=SphereGeometry_create(128,raw,40960,4096,params);
let named=SphereGeometry_setName(128,6016,9);
if(raw!=1800 || created!=128 || named!=128) { return 0-102; }
let short=SphereGeometry_toJSON(128,4096,4100,6000,8,2048);
let end=SphereGeometry_toJSON(128,4096,5600,6000,8,2048);
if(end<4096) { return 0-103; }
let broken=SphereGeometry_fromJSON(288,raw,45056,4096,4096,end-1,2048);
let alias=SphereGeometry_fromJSON(288,raw,45056,4096,4096,end,4096);
let loaded=SphereGeometry_fromJSON(288,raw,45056,4096,4096,end,2048);
if(loaded!=288) { return 0-104; }
let bad=SphereGeometry_fromJSON(768,raw,49152,4096,5760,5776,2048);
