if(op==0) { return ux_span(0,8192); }
if(op==3) { return GpuNormalMap_objectSpace(); }
if(op==4) { return GpuNormalMap_tangentSpace(); }
if(op==1 || op==2) {
  let result=GpuNormalMap_transform(256,mode,rgba,512,640,0.5,1.5,side);
  if(result<0 || op==2) { return result; }
  let x=0.5+ux_f64(result)*0.5;
  let y=0.5+ux_f64(result+8)*0.5;
  let z=0.5+ux_f64(result+16)*0.5;
  let i=0;
  while(i<3) {
    let at=1024+i*28;
    let red=ux_f32_put(at+12,x);
    let green=ux_f32_put(at+16,y);
    let blue=ux_f32_put(at+20,z);
    let alpha=ux_f32_put(at+24,1.0);
    i=i+1;
  }
  let initial=GpuPacket_begin(2048,4096,1);
  let view=GpuPacket_viewport(2048,4096,0,0,1,1);
  let clear=GpuPacket_clear(2048,4096,4278190080);
  let draw=GpuPacket_draw(2048,4096,1024,3,192);
  if(draw<0) { return draw; }
  return GpuPacket_submit(2048);
}
return 0-1;
