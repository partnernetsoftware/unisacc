if(mode==0) { return ux_span(0,60000); }
if(mode<1 || mode>3 || length<1 || length>6000) { return 0-100; }
let geo=BufferGeometry_init(GeometryPrimitive_geometry(128),1024,3,1092,0);
let raw=GeometryBuffers_init(1800,8192,128,16000,512);
let workspace=1824;
let a=ux_u32_put(workspace+TubeLineWorkspace.curve,1904);
let b=ux_u32_put(workspace+TubeLineWorkspace.points,1936);
let c=ux_u32_put(workspace+TubeLineWorkspace.frames,3456);
if(geo<0 || raw!=1800) { return 0-101; }
if(mode==3) {
  let alias=ux_u32_put(workspace+TubeLineWorkspace.points,48000);
}
let status=TubeGeometry_fromJSON(128,raw,22000,8192,48000,48000+length,1280,workspace);
if(mode>1) { return status==0-1 && ux_u32(128+GeometryPrimitiveRecord.kind)==0; }
if(status!=128) { return status; }
let name=GeometryPrimitive_setName(128,6016,8);
if(name!=128) { return 0-102; }
let pos=BufferGeometry_getAttribute(geo,1);
let norm=BufferGeometry_getAttribute(geo,2);
let uv=BufferGeometry_getAttribute(geo,4);
let idx=BufferGeometry_getIndex(geo);
let p=ux_u32_put(7000,ux_u32(pos+BufferAttribute.data));
let n=ux_u32_put(7004,ux_u32(norm+BufferAttribute.data));
let u=ux_u32_put(7008,ux_u32(uv+BufferAttribute.data));
let v=ux_u32_put(7012,ux_u32(idx+BufferAttribute.data));
let pc=ux_u32_put(7016,ux_u32(pos+BufferAttribute.count));
let ic=ux_u32_put(7020,ux_u32(idx+BufferAttribute.count));
let end=TubeGeometry_toJSON(128,4096,6000,6000,6,2048);
if(end<0) { return end; }
return end-4096;
