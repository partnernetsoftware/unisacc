if(mode<0 || mode>1 || mutate<0 || mutate>1) { return 0-1; }
let composer=4200;
let owned=4300;
let init=EffectComposer_init(composer,2,1,4360,1,2,2);
let screen=EffectComposer_screen(composer,mode);
let pass=EffectComposer_addPass(composer,1,1);
let planned=EffectComposer_plan(composer,4400,4480,1);
if(init<0 || screen<0 || pass<0 || planned!=1) { return 0-1; }
let created=EffectComposerGpu_create(composer,owned,0,4096,5000,1);
if(created!=0) { return created; }
let packet=GpuPacket_begin(0,4096,1);
let bound=EffectComposerGpu_bindBuffer(composer,owned,packet,4096,0);
if(mode==1) { bound=GpuTarget_bind(packet,4096,0,0); }
let background=GpuPacket_clear(packet,4096,4282384384);
let state=ux_u32_put(5000+GpuTarget.id,3);
let source=GpuTarget_create(packet,4096,5000);
let bindSource=GpuTarget_bind(packet,4096,3,0);
let paint=GpuPacket_clear(packet,4096,4280303744);
let clip=GpuPacket_scissor(packet,4096,1,0,1,2,1);
let row=GpuPacket_clear(packet,4096,4282417184);
let unclipped=GpuPacket_scissor(packet,4096,0,0,0,0,0);
if(bound<0 || background<0 || source<0 || bindSource<0 || paint<0 || clip<0 || row<0 || unclipped<0) { return 0-2; }
let ready=GpuPacket_submit(packet);
if(ready!=0) { return ready; }
let shader=6300;
let v=ux_u32_put(shader+GpuShaderSource.vertex,10000);
let vb=ux_u32_put(shader+GpuShaderSource.vertexBytes,vn);
let f=ux_u32_put(shader+GpuShaderSource.fragment,14500);
let fb=ux_u32_put(shader+GpuShaderSource.fragmentBytes,fn);
let invalid=TexturePass_render(4480,1,3,shader,1.5);
if(invalid!=0-1) { return 0-3; }
let amount=0.5;
if(mutate==1) { amount=0.25; }
let placed=TexturePass_render(4480,1,3,shader,amount);
if(placed!=0) { return placed; }
let committed=EffectComposer_commit(composer,4400);
if(committed<0 || ux_u32(composer+EffectComposer.read)!=2 || ux_u32(composer+EffectComposer.write)!=1) { return 0-4; }
packet=GpuPacket_begin(0,4096,1);
if(mode==0) {
  let d=5100;
  let id=ux_u32_put(d+GpuTargetRead.id,2);
  let width=ux_u32_put(d+GpuTargetRead.width,2);
  let height=ux_u32_put(d+GpuTargetRead.height,2);
  let addr=ux_u32_put(d+GpuTargetRead.output,7000);
  let read=GpuTarget_read(packet,4096,d);
  if(read<0) { return 0-5; }
}
let toScreen=GpuTarget_bind(packet,4096,0,0);
let released=GpuTarget_dispose(packet,4096,3);
let flushed=GpuPacket_submit(packet);
if(toScreen<0 || released<0 || flushed!=0) { return 0-5; }
return EffectComposerGpu_release(owned,0,4096,0);
