native function probe_scene_batch(packet:i64,draw:i64,stream:i64,world:i64,vertices:i64,shader:i64,mode:i64) i64 {
  let next=draw+SceneDrawItem.size;
  let stream2=5104;
  let world2=5200;
  let rgba2=5344;
  let binds=5380;
  let batch=5440;
  let t0=uxe_copy_record(world2,world,128);
  let t1=uxe_copy_record(stream2,stream,SceneDrawStream.size);
  let matrix=ux_u32_put(next+SceneDrawItem.worldMatrix,world2);
  let x=ux_f64_put(world2+96,0.0-0.55);
  let blue=1.0;
  if(mode==3) { blue=0.0; }
  let a=ux_f32_put(rgba2,1.0-blue);
  let b=ux_f32_put(rgba2+8,blue);
  let c=ux_f32_put(rgba2+12,1.0);
  let color=ux_u32_put(stream2+SceneDrawStream.color,rgba2);
  let z=0;
  while(z<2) {
    let item=draw+z*SceneDrawItem.size;
    let row=binds+z*SceneGpuBinding.size;
    let use=stream;
    if(z==1) { use=stream2; }
    let g=ux_u32_put(row+SceneGpuBinding.geometry,10+10*z);
    let m=ux_u32_put(row+SceneGpuBinding.material,12+10*z);
    let s=ux_u32_put(row+SceneGpuBinding.stream,use);
    let p=ux_u32_put(row+SceneGpuBinding.shader,shader);
    let i=ux_u32_put(item+SceneDrawItem.geometry,10+10*z);
    let j=ux_u32_put(item+SceneDrawItem.material,12+10*z);
    z=z+1;
  }
  let d=ux_u32_put(batch+SceneGpuBatch.draws,draw);
  let e=ux_u32_put(batch+SceneGpuBatch.bindings,binds);
  let f=ux_u32_put(batch+SceneGpuBatch.count,2);
  let g=ux_u32_put(batch+SceneGpuBatch.vertices,vertices);
  let h=ux_u32_put(batch+SceneGpuBatch.vertexCapacity,3);
  let bad=ux_u32_put(next+SceneDrawItem.geometry,21);
  let before=ux_u32(packet+GpuPacket.bytes);
  let commands=ux_u32(packet+GpuPacket.commands);
  let rejected=SceneGpu_drawBatch(packet,4096,batch);
  if(rejected>=0 || ux_u32(packet+GpuPacket.bytes)!=before || ux_u32(packet+GpuPacket.commands)!=commands) { return 0-5; }
  let ready=ux_u32_put(next+SceneDrawItem.geometry,20);
  let accepted=SceneGpu_drawBatch(packet,4096,batch);
  if(accepted!=2) { return 0-6; }
  return GpuPacket_submit(packet);
}

let draw=4200;
let stream=4256;
let world=4352;
let proj=4480;
let xyz=4700;
let rgb=4760;
let vertices=4800;
let shader=5000;
let first=ux_u32_put(draw+SceneDrawItem.worldMatrix,world);
let p=ux_u32_put(stream+SceneDrawStream.positions,xyz);
let n=ux_u32_put(stream+SceneDrawStream.vertexCount,3);
let s=ux_u32_put(stream+SceneDrawStream.stride,12);
let c=ux_u32_put(stream+SceneDrawStream.color,rgb);
let v=ux_u32_put(stream+SceneDrawStream.viewProjection,proj);
let i=0;
while(i<4) {
  let a=ux_f64_put(world+i*40,1.0);
  let b=ux_f64_put(proj+i*40,1.0);
  i=i+1;
}
let shift=0.55;
if(mode==1) { shift=0.0-0.55; }
let moved=ux_f64_put(world+96,shift);
let x0=ux_f32_put(xyz,0.0-0.25);
let y0=ux_f32_put(xyz+4,0.0-0.5);
let x1=ux_f32_put(xyz+12,0.25);
let y1=ux_f32_put(xyz+16,0.0-0.5);
let y2=ux_f32_put(xyz+28,0.5);
let green=ux_f32_put(rgb+4,1.0);
let alpha=ux_f32_put(rgb+12,1.0);
let packet=GpuPacket_begin(0,4096,1);
let viewport=GpuPacket_viewport(packet,4096,0,0,16,16);
let clear=GpuPacket_clear(packet,4096,4278190080);
let before=ux_u32(packet+GpuPacket.bytes);
let commands=ux_u32(packet+GpuPacket.commands);
let refused=SceneDraw_gpuFlat(packet,4096,draw,stream,vertices,2,shader);
if(refused>=0 || ux_u32(packet+GpuPacket.bytes)!=before || ux_u32(packet+GpuPacket.commands)!=commands) { return 0-4; }
if(mode>=2) { return probe_scene_batch(packet,draw,stream,world,vertices,shader,mode); }
let emitted=SceneDraw_gpuFlat(packet,4096,draw,stream,vertices,3,shader);
if(emitted<0) { return emitted; }
return GpuPacket_submit(packet);
