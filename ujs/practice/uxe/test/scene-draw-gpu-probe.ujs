let draw=4200;
let stream=4256;
let world=4352;
let proj=4480;
let xyz=4700;
let rgb=4760;
let vertices=4800;
let shader=5000;
let first=ux_u32_put(draw+SceneDrawItem.worldMatrix,world);
let p=ux_u32_put(stream+SceneDrawStream.positions,xyz);
let n=ux_u32_put(stream+SceneDrawStream.vertexCount,3);
let s=ux_u32_put(stream+SceneDrawStream.stride,12);
let c=ux_u32_put(stream+SceneDrawStream.color,rgb);
let v=ux_u32_put(stream+SceneDrawStream.viewProjection,proj);
let i=0;
while(i<4) {
  let a=ux_f64_put(world+i*40,1.0);
  let b=ux_f64_put(proj+i*40,1.0);
  i=i+1;
}
let shift=0.55;
if(mode==1) { shift=0.0-0.55; }
let moved=ux_f64_put(world+96,shift);
let x0=ux_f32_put(xyz,0.0-0.25);
let y0=ux_f32_put(xyz+4,0.0-0.5);
let x1=ux_f32_put(xyz+12,0.25);
let y1=ux_f32_put(xyz+16,0.0-0.5);
let y2=ux_f32_put(xyz+28,0.5);
let green=ux_f32_put(rgb+4,1.0);
let alpha=ux_f32_put(rgb+12,1.0);
let packet=GpuPacket_begin(0,4096,1);
let viewport=GpuPacket_viewport(packet,4096,0,0,16,16);
let clear=GpuPacket_clear(packet,4096,4278190080);
let before=ux_u32(packet+GpuPacket.bytes);
let commands=ux_u32(packet+GpuPacket.commands);
let refused=SceneDraw_gpuFlat(packet,4096,draw,stream,vertices,2,shader);
if(refused>=0 || ux_u32(packet+GpuPacket.bytes)!=before || ux_u32(packet+GpuPacket.commands)!=commands) { return 0-4; }
let emitted=SceneDraw_gpuFlat(packet,4096,draw,stream,vertices,3,shader);
if(emitted<0) { return emitted; }
return GpuPacket_submit(packet);
