if(mode==0) { return ux_span(0,60000); }
if(mode<1 || mode>4 || length<1 || length>8000) { return 0-100; }
let raw=GeometryBuffers_init(128,8192,64,11000,0);
if(raw!=128) { return 0-101; }
let work=2048;
if(mode==4) { work=8192; }
let loaded=ExtrudeGeometry_fromJSON(256,raw,40000,40000+length,work);
if(mode==2 || mode==4) {
  return loaded==0-1 && ux_u32(256+ExtrudeShapeJson.active)==0 && ux_u32(raw+GeometryBuffers.vertexCount)==0;
}
if(loaded!=256) { return loaded; }
