let src=0;
let copy=64;
let clone=128;
let shape=448;
if(op==0) { return ux_span(0,8192); }
if(op==1) {
  let source=UniformsGroup_init(src,256,8);
  let copied=UniformsGroup_init(copy,320,8);
  let cloned=UniformsGroup_init(clone,384,8);
  let name=UniformsGroup_setName(src,77);
  let usage=UniformsGroup_setUsage(src,35048);
  let v=Uniform_init(512,640);
  let m=Uniform_init(516,648);
  let a=Uniform_init(520,656);
  let fk=ux_u32_put(640+UniformField.kind,4);
  let fp=ux_u32_put(640+UniformField.source,800);
  let mk=ux_u32_put(648+UniformField.kind,5);
  let mp=ux_u32_put(648+UniformField.source,832);
  let ak=ux_u32_put(656+UniformField.kind,1);
  let ap=ux_u32_put(656+UniformField.source,880);
  let direct=UniformsGroup_add(src,v);
  let array=UniformsGroup_add(src,480);
  let empty=UniformsGroup_add(src,496);
  let scalar=UniformsGroup_add(src,a);
  let temporary=UniformsGroup_add(src,500);
  let removed=UniformsGroup_remove(src,500);
  let missing=UniformsGroup_remove(src,504);
  let s0=ux_u32_put(shape,0);
  let s1=ux_u32_put(shape+4,2);
  let s2=ux_u32_put(shape+8,4294967295);
  let s3=ux_u32_put(shape+12,0);
  let n0=ux_u32_put(480,m);
  let n1=ux_u32_put(484,v);
  let source_listeners=EventDispatcher_init(src,704,2);
  let copy_listeners=EventDispatcher_init(copy,736,2);
  let one=EventDispatcher_addListener(src,3,91);
  let two=EventDispatcher_addListener(copy,3,92);
  return ux_u32(src+UniformsGroup.count)==4 && ux_u32(264)==480 && ux_u32(268)==496;
}
if(op==2) { return UniformsGroup_copyValues(copy,src,shape,1024,512); }
if(op==3) { return UniformsGroup_cloneValues(clone,src,shape,1536,512); }
let group=copy;
if(a!=0) { group=clone; }
if(op==4) { return UniformsGroup_packValues(group,0-1,2048,b,2304,128); }
if(op==5) {
  let table=ux_u32(group+UniformsGroup.uniforms);
  if(b<0 || b>=ux_u32(group+UniformsGroup.count)) { return 0-1; }
  return ux_u32(table+4+b*4);
}
if(op==6) { return UniformsGroup_packValues(group,0-1,2048,128,1024,128); }
if(op==7) { return UniformsGroup_packValues(src,shape,2048,128,2304,128); }
return 0-1;
