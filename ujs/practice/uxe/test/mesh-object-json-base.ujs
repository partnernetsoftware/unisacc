let arena=Object3D_initArena(0,6);
let source=Object3D_create(arena);
let target=Object3D_create(arena);
let node=Object3D_address(arena,source);
let dest=Object3D_address(arena,target);
let mesh=Mesh_init(6000,arena,source,7000,19,0,0);
let copy=Mesh_init(6100,arena,target,7200,21,0,0);
let px=ux_f64_put(7800,2.0);
let pos=Object3D_setPosition(arena,source,7800);
let updated=Object3D_updateMatrixWorld(arena,source,0);
let hidden=ux_u32_put(node+Object3D.visible,0);
let o=ux_u8_put(8000,111);
let g=ux_u8_put(8001,103);
let m=ux_u8_put(8002,109);
let i0=ux_u32_put(8024,8000);
let i1=ux_u32_put(8028,1);
let i2=ux_u32_put(8032,8001);
let i3=ux_u32_put(8036,1);
let i4=ux_u32_put(8040,8002);
let i5=ux_u32_put(8044,1);
let ob0=ux_u32_put(8100,8132);
let ob1=ux_u32_put(8104,1);
let ob2=ux_u32_put(8108,8144);
let ob3=ux_u32_put(8112,1);
let g0=ux_u32_put(8132,8001);
let g1=ux_u32_put(8136,1);
let g2=ux_u32_put(8140,7000);
let m0=ux_u32_put(8144,8002);
let m1=ux_u32_put(8148,1);
let m2=ux_u32_put(8152,19);

if(selected_case==0) { let end=Mesh_toJSON(mesh,arena,8024,8192,9216,9408);let restored=Mesh_fromJSON(copy,arena,8192,end,10800,8100);if(restored<0){return 0.0+restored;}return ux_f64(ux_u32(dest+Object3D.localMatrix)+96); }
if(selected_case==1) { let end=Mesh_toJSON(mesh,arena,8024,8192,9216,9408);let restored=Mesh_fromJSON(copy,arena,8192,end,10800,8100);if(restored<0){return 0.0+restored;}return 0.0+ux_u32(dest+Object3D.visible); }
if(selected_case==2) { let end=Mesh_toJSON(mesh,arena,8024,8192,9216,9408);let restored=Mesh_fromJSON(copy,arena,8192,end,10800,8100);if(restored<0){return 0.0+restored;}return 0.0+ux_u32(copy+Mesh.geometry); }
if(selected_case==3) { let end=Mesh_toJSON(mesh,arena,8024,8192,9216,9408);let restored=Mesh_fromJSON(copy,arena,8192,end,10800,8100);if(restored<0){return 0.0+restored;}return 0.0+ux_u32(copy+Mesh.material); }
if(selected_case==4) { let end=Mesh_toJSON(mesh,arena,8024,8192,9216,9408);let bad=ux_u8_put(8001,120);return 0.0+Mesh_fromJSON(copy,arena,8192,end,10800,8100); }
if(selected_case==5) { let cloned=Mesh_clone(copy,arena,mesh,arena,0);
  if(cloned<0){return 0.0+cloned;}
  let freed=Mesh_dispose(mesh,arena);
  let sourceState=Object3D_address(arena,source);
  let targetState=Object3D_address(arena,target);
  return 0.0+(freed==0 && sourceState<0 && targetState>=0 &&
      ux_u32(copy+Mesh.geometry)==7000 && ux_u32(copy+Mesh.material)==19); }
if(selected_case==6) { let wrong=ux_u32_put(8152,21); let end=Mesh_toJSON(mesh,arena,8024,8192,9216,9408);let restored=Mesh_fromJSON(copy,arena,8192,end,10800,8100);if(restored<0){return 0.0+restored;}return 0.0+ux_u32(copy+Mesh.material); }
return 0.0/0.0;
