native function render_pass_target(packet:i64,id:i64) i64 {
  let desc=3000;
  let a=ux_u32_put(desc+GpuTarget.kind,0);
  let b=ux_u32_put(desc+GpuTarget.id,id);
  let c=ux_u32_put(desc+GpuTarget.width,4);
  let d=ux_u32_put(desc+GpuTarget.height,4);
  let e=ux_u32_put(desc+GpuTarget.layers,1);
  let f=ux_u32_put(desc+GpuTarget.colors,1);
  let g=ux_u32_put(desc+GpuTarget.depth,1);
  let created=GpuTarget_create(packet,2048,desc);
  let bound=GpuTarget_bind(packet,2048,id,0);
  return GpuPacket_clear(packet,2048,4294901760);
}

native function render_pass_read(packet:i64,id:i64,out:i64) i64 {
  let desc=3104;
  let a=ux_u32_put(desc+GpuTargetRead.id,id);
  let b=ux_u32_put(desc+GpuTargetRead.layer,0);
  let c=ux_u32_put(desc+GpuTargetRead.color,0);
  let d=ux_u32_put(desc+GpuTargetRead.x,0);
  let e=ux_u32_put(desc+GpuTargetRead.y,0);
  let f=ux_u32_put(desc+GpuTargetRead.width,1);
  let g=ux_u32_put(desc+GpuTargetRead.height,1);
  let h=ux_u32_put(desc+GpuTargetRead.output,out);
  return GpuTarget_read(packet,2048,desc);
}

let packet=GpuPacket_begin(0,2048,1);
let first=render_pass_target(packet,1);
let second=render_pass_target(packet,2);
let composer=3200;
let ready=EffectComposer_init(composer,1,2,3328,1,4,4);
let to_target=EffectComposer_screen(composer,0);
let added=EffectComposer_addPass(composer,1,5);
let planned=EffectComposer_plan(composer,3456,3584,1);
if(mode!=0) { let wrong=ux_u32_put(3584+ComposerStep.read,2); }
let drawn=RenderPass_begin(packet,2048,3584,3,4278255360,1.0,0);
if(drawn<0) { return drawn; }
let read=render_pass_read(packet,1,4000);
let other=render_pass_read(packet,2,4016);
return GpuPacket_submit(packet);
