import uxe_radial_dispatch from "uxe_radial_public_v1"(i64,i64,i64,i64) f64;
export uxe_radial_probe(op:i64,kind:i64,which:i64,value:i64,mutate:i64) f64 version 1;

if(op==7 && mutate==1 && kind==3 && which==2) { return uxe_radial_dispatch(op,kind,0,value); }
if(op==5 && mutate==2 && kind==4) { return uxe_radial_dispatch(op,kind,which,8); }
return uxe_radial_dispatch(op,kind,which,value);
