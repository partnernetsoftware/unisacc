let instance=128;
if(which==1) { instance=256; }
if(op==0) { return ux_span(0,16384); }
if(op==1) {
  let manager=LoadingManager_init(64);
  let material=MaterialLoader_family(128,0,manager);
  let audio=AudioLoader_family(256,0,manager);
  return material==128 && audio==256;
}
if(op==2) { return LoaderFamily_setPath(instance,x,y); }
if(op==3) { return LoaderFamily_beginAsync(instance,x,y,768,2048,2880,2944); }
if(op==4) { return LoaderFamily_receiveAsync(instance,x,y,z,w,2944); }
if(op==5) { return MaterialLoader_decodeAsync(instance,x,3104,3168); }
if(op==6) { return AudioLoader_decodeAsync(instance,x,3200,3264,64); }
if(op==7) { return ux_u32(64+LoadingManager.total); }
if(op==8) { return ux_u32(64+LoadingManager.loaded); }
if(op==9) { return LoaderFamily_releaseAsync(instance,x); }
return 0-1;
