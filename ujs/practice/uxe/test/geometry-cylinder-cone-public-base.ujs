    return ux_f64(object+GeometryPrimitiveRecord.second);
  }
  if(value==1) { return ux_f64(object+GeometryPrimitiveRecord.fourth); }
  let pos=BufferGeometry_getAttribute(geo,1);
  let idx=BufferGeometry_getIndex(geo);
