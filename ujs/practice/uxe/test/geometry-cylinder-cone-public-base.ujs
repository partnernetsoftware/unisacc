  let source=0-1;
  if(kind==3) { source=CylinderGeometry_create(128,raw,8192,4096,params,work); }
  else { source=ConeGeometry_create(128,raw,8192,4096,params,work); }
  let open=ux_u32_put(params+RadialGeometryParameters.openEnded,1);
  let target=0-1;
  if(kind==3) { target=CylinderGeometry_create(272,raw,12288,4096,params,work); }
  else { target=ConeGeometry_create(272,raw,12288,4096,params,work); }
  if(source<0 || target<0) { return 0.0-1.0; }
  let named=RadialGeometry_setName(source,35000,8);
  let s=RadialGeometry_geometry(source);
  let d=RadialGeometry_geometry(target);
