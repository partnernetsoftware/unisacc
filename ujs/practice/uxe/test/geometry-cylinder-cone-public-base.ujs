  if(which==0) { return 0.0+ConeGeometry_copy(272,128,28672,4096); }
  if(which==2) { return 0.0+ConeGeometry_copy(272,128,28672,8); }
  return 0.0+ConeGeometry_clone(416,128,16384,4096);
}
if(op==3) {
  if(value==0) {
