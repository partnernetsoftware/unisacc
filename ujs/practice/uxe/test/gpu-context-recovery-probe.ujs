native function recovery_target(packet:i64) i64 {
  let descriptor=4500;
  let a=ux_u32_put(descriptor+GpuTarget.kind,0);
  let b=ux_u32_put(descriptor+GpuTarget.id,1);
  let c=ux_u32_put(descriptor+GpuTarget.width,4);
  let d=ux_u32_put(descriptor+GpuTarget.height,4);
  let e=ux_u32_put(descriptor+GpuTarget.layers,1);
  let f=ux_u32_put(descriptor+GpuTarget.colors,1);
  let g=ux_u32_put(descriptor+GpuTarget.depth,1);
  return GpuTarget_create(packet,2048,descriptor);
}

native function recovery_read(packet:i64,output:i64) i64 {
  let descriptor=4560;
  let a=ux_u32_put(descriptor+GpuTargetRead.id,1);
  let b=ux_u32_put(descriptor+GpuTargetRead.layer,0);
  let c=ux_u32_put(descriptor+GpuTargetRead.color,0);
  let d=ux_u32_put(descriptor+GpuTargetRead.x,0);
  let e=ux_u32_put(descriptor+GpuTargetRead.y,0);
  let f=ux_u32_put(descriptor+GpuTargetRead.width,4);
  let g=ux_u32_put(descriptor+GpuTargetRead.height,4);
  let h=ux_u32_put(descriptor+GpuTargetRead.output,output);
  return GpuTarget_read(packet,2048,descriptor);
}

native function recovery_triangle(packet:i64) i64 {
  let positions=[0.0-0.75,0.0-0.75,0.75,0.0-0.75,0.0,0.75];
  let i=0;
  while(i<3) {
    let at=4800+i*28;
    let px=ux_f32_put(at,positions[i*2]);
    let py=ux_f32_put(at+4,positions[i*2+1]);
    let pz=ux_f32_put(at+8,0.0);
    let red=ux_f32_put(at+12,1.0);
    let green=ux_f32_put(at+16,0.0);
    let blue=ux_f32_put(at+20,0.0);
    let alpha=ux_f32_put(at+24,1.0);
    i=i+1;
  }
  return GpuPacket_draw(packet,2048,4800,3,5000);
}

if(mode==1) { return GpuPacket_submit(2048); }
let packet=GpuPacket_begin(0,2048,stamp);
if(packet<0) { return packet; }
if(mode==2) {
  let probe=GpuTarget_bind(packet,2048,1,0);
  return GpuPacket_submit(packet);
}
if(mode==4) {
  let read=recovery_read(packet,8200);
  return GpuPacket_submit(packet);
}
if(mode!=0 && mode!=3) { return 0-1; }
let made=recovery_target(packet);
let bound=GpuTarget_bind(packet,2048,1,0);
let view=GpuPacket_viewport(packet,2048,0,0,4,4);
if(made<0 || bound<0 || view<0) { return 0-1; }
if(mode==0) {
  let blue=GpuPacket_clear(packet,2048,4294901760);
  let read=recovery_read(packet,8000);
  let replay=GpuPacket_begin(2048,2048,stamp);
  let staleBound=GpuTarget_bind(replay,2048,1,0);
  let staleClear=GpuPacket_clear(replay,2048,4294967295);
  if(blue<0 || read<0 || staleBound<0 || staleClear<0) { return 0-1; }
} else {
  let green=GpuPacket_clear(packet,2048,4278255360);
  let draw=recovery_triangle(packet);
  let read=recovery_read(packet,8100);
  if(green<0 || draw<0 || read<0) { return 0-1; }
}
return GpuPacket_submit(packet);
