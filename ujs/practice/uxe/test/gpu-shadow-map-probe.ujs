let packet=GpuPacket_begin(0,4096,1);
let desc=5000;
let kind=ux_u32_put(desc+GpuTarget.kind,0);
let id=ux_u32_put(desc+GpuTarget.id,1);
let w=ux_u32_put(desc+GpuTarget.width,16);
let h=ux_u32_put(desc+GpuTarget.height,16);
let layers=ux_u32_put(desc+GpuTarget.layers,1);
let colors=ux_u32_put(desc+GpuTarget.colors,1);
let depth=ux_u32_put(desc+GpuTarget.depth,1);
let created=GpuTarget_create(packet,4096,desc);
let bound=GpuTarget_bind(packet,4096,1,0);
let viewport=GpuPacket_viewport(packet,4096,0,0,16,16);
let clear=GpuPacket_clearBuffers(packet,4096,3,4294967295,1.0,0);
let state=GpuPacket_state(packet,4096,1,1,0);
let center=0.0;
if(mode!=0) { center=0.5; }
let count=GpuSprite_billboard(8000,center,0.0,0.0,0.4,0.4,0.0,4278190165);
let caster=GpuPacket_draw(packet,4096,8000,count,probe_shader_sources(6400));
if(caster<0) { return caster; }
let read=5100;
let rid=ux_u32_put(read+GpuTargetRead.id,1);
let layer=ux_u32_put(read+GpuTargetRead.layer,0);
let attachment=ux_u32_put(read+GpuTargetRead.color,0);
let rx=ux_u32_put(read+GpuTargetRead.x,0);
let ry=ux_u32_put(read+GpuTargetRead.y,0);
let rw=ux_u32_put(read+GpuTargetRead.width,16);
let rh=ux_u32_put(read+GpuTargetRead.height,16);
let out=ux_u32_put(read+GpuTargetRead.output,9000);
let copied=GpuTarget_read(packet,4096,read);
let restored=GpuTarget_bind(packet,4096,0,0);
let released=GpuTarget_dispose(packet,4096,1);
if(copied<0 || restored<0 || released<0) { return 0-1; }
let pass=GpuPacket_submit(packet);
if(pass!=0) { return pass; }

let next=GpuPacket_begin(0,4096,1);
let screen=GpuPacket_viewport(next,4096,0,0,16,16);
let background=GpuPacket_clear(next,4096,0);
let noDepth=GpuPacket_state(next,4096,0,1,0);
let quad=GpuSprite_billboard(8000,0.0,0.0,0.0,2.0,2.0,0.0,2147483648);
let i=0;
while(i<quad) {
  let vertex=8000+28*i;
  let u=ux_f32_put(vertex+12,0.5+0.5*ux_f32(vertex));
  let v=ux_f32_put(vertex+16,0.5+0.5*ux_f32(vertex+4));
  let z=ux_f32_put(vertex+20,0.6);
  i=i+1;
}
let texture=5200;
let tw=ux_u32_put(texture+GpuTextureSource.width,16);
let th=ux_u32_put(texture+GpuTextureSource.height,16);
let filter=ux_u32_put(texture+GpuTextureSource.filter,0);
let ws=ux_u32_put(texture+GpuTextureSource.wrapS,0);
let wt=ux_u32_put(texture+GpuTextureSource.wrapT,0);
let source=ux_u32_put(texture+GpuTextureSource.rgba,9000);
let receiver=GpuPacket_drawTexture(next,4096,8000,quad,probe_map_sources(7000),texture);
if(receiver<0) { return receiver; }
return GpuPacket_submit(next);
