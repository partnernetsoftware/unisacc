let descriptor=RenderTarget_prepareDescriptor(512,1,2,2,0);
let layers=3;
let colors=1;
if(kind==1) { layers=6; }
if(kind==4) { layers=1; colors=2; }
let configured=RenderTarget_configure(descriptor,kind,layers,colors);
if(configured<0) { return configured; }
let created=RenderTarget_create(128,1024,256,descriptor,1);
if(created!=0) { return created; }
let cloned=RenderTarget_clone(256,128,1024,256,descriptor,2);
if(cloned!=0) { return cloned; }
let resized=RenderTarget_setSize(128,1024,256,descriptor,4,4,3,0);
if(resized!=0) { return resized; }
let out=4096;
let a=ux_u32_put(out,ux_u32(256+RenderTarget.width));
let b=ux_u32_put(out+4,ux_u32(128+RenderTarget.width));
let c=ux_u32_put(out+8,ux_u32(256+RenderTarget.kind));
let d=ux_u32_put(out+12,ux_u32(256+RenderTarget.layers));
let e=ux_u32_put(out+16,ux_u32(256+RenderTarget.colors));
if(mutate==0) {
  let copied=RenderTarget_copy(256,128,1024,256,descriptor,4,0);
  if(copied!=0) { return copied; }
}
let f=ux_u32_put(out+20,ux_u32(256+RenderTarget.width));
let g=ux_u32_put(out+24,ux_u32(256+RenderTarget.id)!=ux_u32(128+RenderTarget.id));
let h=ux_u32_put(out+28,ux_u32(256+RenderTarget.layers));
let x=RenderTarget_dispose(128,1024,256,0);
let y=RenderTarget_dispose(256,1024,256,0);
let i=ux_u32_put(out+32,ux_u32(128+RenderTarget.id)+ux_u32(256+RenderTarget.id));
return x+y;
