native function line_probe_geometry(kind:i64) i64 {
  if(kind!=6) { return 0-101; }
  let i=0;
  while(i<16) {
    let d=0.0;
    if(i%5==0) { d=1.0; }
    let m=ux_f64_put(2800+i*8,d);
    let n=ux_f64_put(3000+i*8,d);
    i=i+1;
  }
  let helper=CameraHelper_init(256,1024,2048,2800,3000);
  if(helper!=256) { return 0-101; }
  let row1=ux_u32_put(848,1);
  let positionAt=ux_u32_put(852,872);
  let positionBytes=ux_u32_put(856,8);
  let row2=ux_u32_put(860,8);
  let colorAt=ux_u32_put(864,880);
  let colorBytes=ux_u32_put(868,5);
  let pos0=ux_u32_put(872,1769172848);
  let pos1=ux_u32_put(876,1852795252);
  let rgb0=ux_u32_put(880,1869377379);
  let rgb1=ux_u8_put(884,114);
  let id=ux_u32_put(904+GeometryJsonIdentity.uuid,944);
  let bytes=ux_u32_put(904+GeometryJsonIdentity.uuidBytes,6);
  let names=ux_u32_put(904+GeometryJsonIdentity.names,848);
  let count=ux_u32_put(904+GeometryJsonIdentity.nameCount,2);
  let geo=BufferGeometry_init(640,688,2,720,0);
  let position=BufferAttribute_init(768,1024,50,3,9,0);
  let colors=BufferAttribute_init(800,2048,50,3,9,0);
  if(geo<0 || position<0 || colors<0) { return 0-101; }
  let p=BufferGeometry_setAttribute(geo,1,position);
  let c=BufferGeometry_setAttribute(geo,8,colors);
  if(p<0 || c<0) { return 0-101; }
  return BufferGeometry_toJSON(geo,30000,39000,904,3192);
}
