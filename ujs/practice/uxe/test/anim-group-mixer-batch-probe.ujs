if(test!=64) { let stopped=AnimationMixer_stopAllAction(mixer); }
if(code==12) { return ux_f64(ay); }
if(code==13) { return ux_f64(ax); }
if(code==14) { return ux_f64(by); }
return ux_f64(bx);
