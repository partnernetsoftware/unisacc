native function batch_fixture_route(route:i64,base:i64,table:i64,arena:i64,object:i64,key:i64) i64 {
  let path=2200+(key-1)*20;
  let target=2300+(key-1)*40;
  let bytes=12;
  let from=0.0;
  let to=40.0;
  if(key==2) { bytes=9; from=2.0; to=6.0; }
  let staging=Object3D_initArena(base,1);
  let proxy=Object3D_create(staging);
  let binding=PropertyBinding_bind(base+512,staging,proxy,path,bytes);
  let initial=PropertyBinding_bind(target,arena,object,path,bytes);
  let original=PropertyBinding_transfer(initial,base+688,0);
  let property=PropertyMixer_init(base+576,base+640,base+688,1);
  let action=AnimationAction_init(base+832,1.0,2201,-1,0);
  let t=ux_f32_put(base+932,1.0);
  let v0=ux_f32_put(base+960,from);
  let v1=ux_f32_put(base+964,to);
  let samples=AnimationSamples_init(base+1024,base+928,base+960,2,1);
  let track=KeyframeTrack_init(base+1088,path,bytes,samples);
  let slot=base+768;
  let u0=ux_u32_put(slot+AnimationMixerSlot.action,action);
  let u1=ux_u32_put(slot+AnimationMixerSlot.track,track);
  let u2=ux_u32_put(slot+AnimationMixerSlot.blend,2500);
  let u3=ux_f64_put(slot+AnimationMixerSlot.weight,1.0);
  let mixer=AnimationMixer_init(base+1152,binding,property,slot,1,base+1280);
  let m0=ux_u32_put(route+GroupMixerRoute.mixer,mixer);
  let m1=ux_u32_put(route+GroupMixerRoute.table,table);
  let m2=ux_u32_put(route+GroupMixerRoute.pathID,key);
  let m3=ux_u32_put(route+GroupMixerRoute.arena,arena);
  let m4=ux_u32_put(route+GroupMixerRoute.path,path);
  let m5=ux_u32_put(route+GroupMixerRoute.pathBytes,bytes);
  let m6=ux_u32_put(route+GroupMixerRoute.binding,target);
  let m7=ux_u32_put(route+GroupMixerRoute.workspace,base);
  return ux_u32_put(route+GroupMixerRoute.workspaceBytes,3072);
}

let test=selected;
let arena=Object3D_initArena(0,2);
let a=Object3D_create(arena);
let b=Object3D_create(arena);
let group=AnimationObjectGroup_init(1800,1856,2);
let table=AnimGroup_subsInit(1920,group,1952,2);
let addedA=AnimGroup_updateBindings(table,a,0);
let addedB=AnimGroup_updateBindings(table,b,0);
let first=AnimGroup_subscribe(table,1,1984,2016);
let second=AnimGroup_subscribe(table,2,2052,2080);
let path1=2200;
let path2=2220;
let pos=[46,112,111,115,105,116,105,111,110,91,121,93];
let scale=[46,115,99,97,108,101,91,120,93];
let i=0;
while(i<12) { let set=ux_u8_put(path1+i,pos[i]); i=i+1; }
i=0;
while(i<9) { let set=ux_u8_put(path2+i,scale[i]); i=i+1; }
let aa=Object3D_address(arena,a);
let bb=Object3D_address(arena,b);
let ay=ux_u32(aa+Object3D.position)+8;
let by=ux_u32(bb+Object3D.position)+8;
let ax=ux_u32(aa+Object3D.scale);
let bx=ux_u32(bb+Object3D.scale);
let ya=ux_f64_put(ay,10.0);
let yb=ux_f64_put(by,2.0);
let xa=ux_f64_put(ax,2.0);
let xb=ux_f64_put(bx,3.0);
let routes=2400;
let route2=routes+GroupMixerRoute.size;
let p=3072;
let s=6144;
let aRoute=batch_fixture_route(routes,p,table,arena,a,1);
let bRoute=batch_fixture_route(route2,s,table,arena,a,2);
let batch=2500;
let br=ux_u32_put(batch+GroupMixerBatch.routes,routes);
let bc=ux_u32_put(batch+GroupMixerBatch.count,2);
let bm=ux_u32_put(batch+GroupMixerBatch.backup,9216);
let bn=ux_u32_put(batch+GroupMixerBatch.backupBytes,6144);
if(test==29) {
  let advanced=AnimationMixer_update(p+1152,0.5);
  return ux_f64(ux_u32(ux_u32(advanced+AnimationMixer.property)+PropertyMixer.rows)+24);
}
if(test==30) { return 0.0+AnimationMixer_initGroup(3072,batch); }
if(test==31) {
  let updated=AnimationMixer_update(p+1152,0.5);
  let stopped=AnimationMixer_stopAllAction(updated);
  let binding=ux_u32(stopped+AnimationMixer.binding);
  let proxy=Object3D_address(p,ux_u32(binding+PropertyBinding.handle));
  return ux_f64(ux_u32(proxy+Object3D.position)+8);
}
let mixer=AnimationMixer_initGroup(2600,batch);
if(test==16) {
  let advanced=AnimationMixer_update(mixer,0.875);
  return ux_f64(advanced+AnimationMixer.time);
}
let code=test;
if(test>=17) { code=test-1; }
if(test==64) { code=14; }
if(code>=16) {
  if(code<=20 || test==27) { let invalid=ux_u8_put(path2+1,120); }
  else { let invalid=ux_u32_put(s+768+AnimationMixerSlot.blend,9); }
  if(test>=27) {

    let rejected=AnimationMixer_update(mixer,0.5);
    if(rejected>=0) { return 1.0; }
    return ux_f64(mixer+AnimationMixer.time);
  }
  let refused=AnimationMixer_update(mixer,0.5);
  if(code==16 || code==21) { return 0.0+refused; }
  if(code==17 || code==22) { return ux_f64(ay)+ux_f64(by); }
  if(code==18 || code==23) { return ux_f64(ax)+ux_f64(bx); }
  if(code==19 || code==24) {
    return ux_f64(p+1152+AnimationMixer.time)+ux_f64(s+1152+AnimationMixer.time);
  }
  return ux_f64(p+832+AnimationAction.time)+ux_f64(s+832+AnimationAction.time);
}
let half=AnimationMixer_update(mixer,0.5);
if(code==0) { return ux_f64(ay); }
if(code==1) { return ux_f64(by); }
if(code==2) { return ux_f64(ax); }
if(code==3) { return ux_f64(bx); }
let off=AnimGroup_updateBindings(table,b,1);
