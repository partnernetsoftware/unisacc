native function native_color_read(packet:i64,id:i64,output:i64) i64 {
  let desc=5000;
  let a=ux_u32_put(desc+GpuTargetRead.id,id);
  let b=ux_u32_put(desc+GpuTargetRead.layer,0);
  let c=ux_u32_put(desc+GpuTargetRead.color,0);
  let d=ux_u32_put(desc+GpuTargetRead.x,0);
  let e=ux_u32_put(desc+GpuTargetRead.y,0);
  let f=ux_u32_put(desc+GpuTargetRead.width,3);
  let g=ux_u32_put(desc+GpuTargetRead.height,2);
  let h=ux_u32_put(desc+GpuTargetRead.output,output);
  return GpuTarget_read(packet,4096,desc);
}

native function native_color_shader(shader:i64,vertexBytes:i64,fragment:i64,fragmentBytes:i64) i64 {
  let a=ux_u32_put(shader+GpuShaderSource.vertex,10000);
  let b=ux_u32_put(shader+GpuShaderSource.vertexBytes,vertexBytes);
  let c=ux_u32_put(shader+GpuShaderSource.fragment,fragment);
  return ux_u32_put(shader+GpuShaderSource.fragmentBytes,fragmentBytes);
}

native function native_color_reference(input:i64,output:i64,mode:i64) i64 {
  let settings=7600;
  let a=ux_f64_put(settings+ColorCorrectionSettings.powR,2.0);
  let b=ux_f64_put(settings+ColorCorrectionSettings.powG,2.0);
  let c=ux_f64_put(settings+ColorCorrectionSettings.powB,2.0);
  let d=ux_f64_put(settings+ColorCorrectionSettings.mulR,1.0);
  let e=ux_f64_put(settings+ColorCorrectionSettings.mulG,1.0);
  let f=ux_f64_put(settings+ColorCorrectionSettings.mulB,1.0);
  let g=ux_f64_put(settings+ColorCorrectionSettings.addR,0.0);
  let h=ux_f64_put(settings+ColorCorrectionSettings.addG,0.0);
  let i=ux_f64_put(settings+ColorCorrectionSettings.addB,0.0);
  if(mode==1) {
    b=ux_f64_put(settings+ColorCorrectionSettings.powG,1.0);
    c=ux_f64_put(settings+ColorCorrectionSettings.powB,0.5);
    e=ux_f64_put(settings+ColorCorrectionSettings.mulG,0.5);
    f=ux_f64_put(settings+ColorCorrectionSettings.mulB,2.0);
    g=ux_f64_put(settings+ColorCorrectionSettings.addR,0.1);
    h=ux_f64_put(settings+ColorCorrectionSettings.addG,0.2);
  }
  return ColorCorrection_applyRGBA8(input,output,6,settings);
}

if(mode<0 || mode>1 || mutated<0 || mutated>1) { return 0-1; }
let fragment=14500;
let config=19000;
let specialized=28000;
let ready=NativeColorCorrection_config(fragment,fn,config,dn,specialized,4096);
if(ready!=fn+dn) { return 0-2; }
let sentinel=ux_u8(specialized);
let bounded=NativeColorCorrection_config(fragment,fn,config,dn,specialized,ready-1);
let aliased=NativeColorCorrection_config(fragment,fn,config,dn,config,4096);
let tail=ux_u8(config+dn-1);
let invalid=ux_u8_put(config+dn-1,32);
let boundary=NativeColorCorrection_config(fragment,fn,config,dn,specialized,4096);
let restored=ux_u8_put(config+dn-1,tail);
if(bounded!=0-1 || aliased!=0-1 || boundary!=0-1 || ux_u8(specialized)!=sentinel) { return 0-3; }

let composer=4200;
let ownership=4300;
let initialized=EffectComposer_init(composer,2,1,4360,2,3,2);
if(initialized<0) { return initialized; }
let created=EffectComposerGpu_create(composer,ownership,0,4096,5000,1);
if(created!=0) { return created; }
let packet=GpuPacket_begin(0,4096,1);
let bound=EffectComposerGpu_bindBuffer(composer,ownership,packet,4096,0);
if(bound<0) { return bound; }
let values=[64,128,255,37,0,1,16,41,64,91,100,123,255,0,0,200,11,201,199,0,80,160,40,125];
let p=0;
while(p<6) {
  let a=GpuPacket_scissor(packet,4096,1,p%3,p/3,1,1);
  let b=GpuPacket_clear(packet,4096,values[p*4]+256*values[p*4+1]+65536*values[p*4+2]+16777216*values[p*4+3]);
  if(a<0 || b<0) { return 0-4; }
  p=p+1;
}
let started=GpuPacket_submit(packet);
if(started!=0) { return started; }
let addColor=EffectComposer_addPass(composer,10,3);
let addCopy=EffectComposer_addPass(composer,20,3);
let planned=EffectComposer_plan(composer,4400,4480,2);
if(addColor<0 || addCopy<0 || planned!=2) { return 0-5; }
let actualFragment=fragment;
let actualLength=fn;
if(mode==1 && mutated==0) { actualFragment=specialized; actualLength=ready; }
let vc=native_color_shader(6300,vn,actualFragment,actualLength);
let pc=native_color_shader(6320,vn,23500,cn);
let filtered=NativeTargetCopy_step(4480,1,6300);
if(filtered!=0) { return filtered; }
let presented=NativeTargetCopy_step(4480+ComposerStep.size,1,6320);
if(presented!=0) { return presented; }
packet=GpuPacket_begin(0,4096,1);
let actualSource=native_color_read(packet,2,7000);
let actualTarget=native_color_read(packet,1,7200);
if(actualSource<0 || actualTarget<0) { return 0-6; }
let reads=GpuPacket_submit(packet);
if(reads!=0) { return reads; }
if(native_color_reference(7000,7400,mode)!=6 || EffectComposer_commit(composer,4400)<0) { return 0-7; }
return EffectComposerGpu_release(ownership,0,4096,0);
