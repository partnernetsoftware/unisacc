let input=1024;
let output=3072;
let scratch=4096;
let obj=512;
if(arg==1) { obj=640; }
if(op==0) { return ux_span(0,6144); }
if(op==1) {
  let events=EventDispatcher_init(64,128,2);
  let distinct=EventDispatcher_init(80,160,2);
  if(ShadowMaterial_init(512,17,events)!=512 || ShadowMaterial_init(640,19,distinct)!=640) { return 0-1; }
  return 0;
}
if(op==2) {
  if(arg<1 || arg>1600) { return 0-1; }
  let done=ShadowMaterial_readJSON(512,input,input+arg,scratch);
  if(done>=0 && mutate!=0) { let lost=ux_u32_put(512+Material.size+ShadowMaterialFields.fog,1); }
  return done;
}
if(op==3) {
  let p=5504;
  let a=ux_f64_put(p,0.0+ux_u32(obj+Material.size+ShadowMaterialFields.color));
  let b=ux_f64_put(p+8,0.0+ux_u32(obj+Material.size+ShadowMaterialFields.fog));
  let c=ux_f64_put(p+16,0.0+ux_u32(obj+Material.transparent));
  let d=ux_f64_put(p+24,ux_f64(obj+Material.opacity));
  let e=ux_f64_put(p+32,0.0+ux_u32(obj+Material.depthWrite));
  return p;
}
if(op==4) { return ShadowMaterial_writeJSON(obj,output,output+700,scratch); }
if(op==5) { return ShadowMaterial_copy(640,512); }
return 0-1;
