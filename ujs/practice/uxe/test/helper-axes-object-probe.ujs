native function axes_probe_material() i64 {
  let end=AxesHelperObject_materialToJSON(128,40000,49000,952,6,6000);
  if(end<0) { return end; }
  return end-40000;
}

if(mode==0) { return ux_span(0,90000); }
if(mode==1) {
  let events=EventDispatcher_init(480,520,2);
  let axes=AxesHelper_init(256,1024,2048,3.0);
  let owner=AxesHelperObject_bind(128,axes,384,17,events);
  if(owner!=128) { return 0-101; }
