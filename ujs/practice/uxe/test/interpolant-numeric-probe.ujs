native function numeric_fixture_token(at:i64,data:i64,count:i64,kind:i64) i64 {
  let a=ux_u32_put(at+AnimationArrayView.data,data);
  let b=ux_u32_put(at+AnimationArrayView.count,count);
  let c=ux_u32_put(at+AnimationArrayView.kind,kind);
  return at;
}
