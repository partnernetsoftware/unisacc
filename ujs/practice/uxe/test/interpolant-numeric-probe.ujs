if(k<4 || k==64) {
  let t0=ux_f64_put(64,16777216.0); let t1=ux_f64_put(72,16777217.0); let t2=ux_f64_put(80,16777219.0);
  let a=ux_f64_put(128,0.0); let b=ux_f64_put(136,1.0+1.0/1073741824.0);
  let c=ux_f64_put(144,3.0+3.0/1073741824.0);
  let ts=numeric_fixture_token(256,64,3,10);
  let vs=numeric_fixture_token(280,128,3,10);
  let vv=InterpolantView_fromArrays(view,ts,vs,1);
  let rt=0-1;
  if(k==3 || k==64) { rt=numeric_fixture_token(304,result,1,9); }
  let init=Interpolant_initArray(s,vv,rt,0);
  let v=Interpolant_evaluate(s,16777216.5);
  if(k==3) { return ux_f32(v); }
  if(k==64) { return (ux_f32(v)-0.5)*2147483648.0; }
  if(k==1) { return 0.0+ux_u32(s+InterpolantState.cached); }
  if(k==2) { return 0.0+ux_u32(s+InterpolantState.resultKind); }
  return (ux_f64(v)-0.5)*2147483648.0;
}
let t1=ux_f64_put(72,1.0); let t2=ux_f64_put(80,2.0); let t3=ux_f64_put(88,3.0);
let a=ux_f64_put(128,2.0); let b=ux_f64_put(136,6.0);
