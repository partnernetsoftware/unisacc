  if(a==6) { return ux_u32(at+DepthTexture.flipY); }
  if(a==7) { return ux_u32(at+DepthTexture.generateMipmaps); }
  if(a==8) { return ux_u32(at+DepthTexture.compareFunction)==0; }
  return ux_u32(at+DepthTexture.id)==0 && ux_u32(at+DepthTexture.generation)==0;
}
if(op==7) { return DepthTexture_dispose(at,544,7,640,a); }
if(op==8) {
  let registry=EventDispatcher_init(544,576,3);
