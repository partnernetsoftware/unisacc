if(mode==9) { return ux_span(0,16384); }
let snapshot=4600;
let bindings=5000;
let state=5312;
let out=5504;
let work=6144;
let ray=Raycaster_default(state);
let pose=13568;
let bind=13632;
let inverse=13760;
let geometry=13900;
let line=13936;
let point=13960;
let scale=14000;
let view=14032;
let palette=14160;
let skin=14224;
let skeleton=14248;
let streams=14272;
let joints=14304;
let weights=14352;

let i=0;
while(i<16) {
  let a=ux_f64_put(view+8*i,(i%5==0)*1.0);
  let b=ux_f64_put(bind+8*i,(i%5==0)*1.0);
  let c=ux_f64_put(inverse+8*i,(i%5==0)*1.0);
  let d=ux_f32_put(pose+4*i,(i%5==0)*1.0);
  let e=ux_f32_put(palette+4*i,(i%5==0)*1.0);
  i=i+1;
}
let x0=ux_f32_put(geometry,-1.0);
let y0=ux_f32_put(geometry+4,-1.0);
let x1=ux_f32_put(geometry+12,1.0);
let y1=ux_f32_put(geometry+16,-1.0);
let y2=ux_f32_put(geometry+28,1.0);
let l0=ux_f32_put(line,-1.0);
let l1=ux_f32_put(line+12,1.0);
let scal=Vector3_set(scale,1.0,1.0,1.0);
let initSkin=ux_u32_put(skin+SkinnedMesh.skeleton,skeleton);
let bindSkin=ux_u32_put(skin+SkinnedMesh.bindMatrix,bind);
let invSkin=ux_u32_put(skin+SkinnedMesh.bindInverse,inverse);
let bone=ux_u32_put(skeleton+Skeleton.palette,palette);
let boneCount=ux_u32_put(skeleton+Skeleton.count,1);
let sj=ux_u32_put(streams+RaySkinStreams.joints,joints);
let sw=ux_u32_put(streams+RaySkinStreams.weights,weights);
let js=ux_u32_put(streams+RaySkinStreams.jointStride,16);
let ws=ux_u32_put(streams+RaySkinStreams.weightStride,16);
let weight0=ux_f32_put(weights,1.0);
let weight1=ux_f32_put(weights+16,1.0);
let weight2=ux_f32_put(weights+32,1.0);
i=0;
while(i<8) {
  let node=ux_u32(4800+i*8);
  let world=ux_u32(4804+i*8);
  let row=bindings+i*RayObjectBinding.size;
  let kind=i+1;
  if(i==6) { kind=1; }
  if(i==7) { kind=7; }
  let query=14600+i*64;
  let handle=ux_u32_put(row+RayObjectBinding.node,node);
  let type=ux_u32_put(row+RayObjectBinding.kind,kind);
  let ref=ux_u32_put(row+RayObjectBinding.query,query);
  if(kind==1 || kind==5 || kind==7) {
    let a=ux_u32_put(query+RayMeshBuffer.positions,geometry);
    let b=ux_u32_put(query+RayMeshBuffer.vertexCount,3);
    let c=ux_u32_put(query+RayMeshBuffer.positionStride,12);
    let d=ux_u32_put(query+RayMeshBuffer.faceCount,1);
    let e=ux_u32_put(query+RayMeshBuffer.matrixWorld,world);
    let f=ux_u32_put(query+RayMeshBuffer.layerMask,1);
  }
  if(kind==2 || kind==3) {
    let a=ux_u32_put(query+RayPointsBuffer.positions,point);
    let n=1;
    if(kind==2) { n=2; let b=ux_u32_put(query+RayPointsBuffer.positions,line); }
    let c=ux_u32_put(query+RayPointsBuffer.count,n);
    let d=ux_u32_put(query+RayPointsBuffer.drawCount,n);
    let e=ux_u32_put(query+RayPointsBuffer.stride,12);
    let f=ux_u32_put(query+RayPointsBuffer.world,world);
    let g=ux_u32_put(query+RayPointsBuffer.layerMask,1);
    let h=ux_u32_put(query+RayPointsBuffer.scale,scale);
  }
  if(kind==4) {
    let a=ux_u32_put(query+RaySpriteQuery.world,world);
    let b=ux_u32_put(query+RaySpriteQuery.view,view);
    let c=ux_u32_put(query+RaySpriteQuery.layerMask,1);
    let d=ux_f64_put(query+RaySpriteQuery.centerX,0.5);
    let e=ux_f64_put(query+RaySpriteQuery.centerY,0.5);
  }
  if(kind==5) {
    let a=ux_u32_put(row+RayObjectBinding.aux,pose);
    let b=ux_u32_put(row+RayObjectBinding.count,1);
  }
  if(kind==6) {
    let a=ux_u32_put(row+RayObjectBinding.query,4900);
  }
  if(kind==7) {
    let a=ux_u32_put(row+RayObjectBinding.aux,skin);
    let b=ux_u32_put(row+RayObjectBinding.count,streams);
  }
  i=i+1;
}
let rows=ux_u32(4950);
if(rows!=9) { return 0-8; }
let request=5400;
let a=ux_u32_put(request+RayObjectQuery.snapshot,snapshot);
let b=ux_u32_put(request+RayObjectQuery.nodes,rows);
let c=ux_u32_put(request+RayObjectQuery.bindings,bindings);
let d=ux_u32_put(request+RayObjectQuery.count,8);
return Raycaster_intersectObject(state,request,mode!=1,out,12,work,7000);
