import uxe_loadingmanager from "uxe_loading_manager_v1" (i64,i64,i64,i64,i64) i64;
export uxe_loading_product(action:i64,x:i64,y:i64,z:i64) i64 version 1;

let manager=40;
if(z==2) { manager=128; }
if(action==0) {
  let first=uxe_loadingmanager(1,32,512,4,0);
  let again=uxe_loadingmanager(1,32,512,4,0);
  let separate=uxe_loadingmanager(0,128,640,4,0);
  let canary=ux_u32_put(40,901);
  return first==manager && first==again && separate==128 && ux_u32(40)==901;
}
if(action==1) { return uxe_loadingmanager(2,manager,x,y,0); }
if(action==2) { return uxe_loadingmanager(3,manager,x,0,0); }
if(action==3) { return uxe_loadingmanager(4,manager,x,0,0); }
if(action==4) {
  let selected=uxe_loadingmanager(4,manager,x,0,0);
  if(y==1) { selected=x; }
  let opened=uxe_loadingmanager(8,manager,selected,0,0);
  if(opened<0) { return opened; }
  return selected;
}
if(action==5) {
  if(y==1) {
    let error=uxe_loadingmanager(9,manager,x,0,0);
    if(error<0) { return error; }
  }
  return uxe_loadingmanager(10,manager,x,0,0);
}
if(action==6) { return uxe_loadingmanager(5,40,x,y,z); }
if(action==7) { return uxe_loadingmanager(7,manager,x,0,0); }
if(action==8) { return uxe_loadingmanager(6,manager,x,0,0); }
return 0-1;
