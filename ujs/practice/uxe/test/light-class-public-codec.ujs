let state=256;
let text=1024;
let limit=9216;
let scratch=10240;
if(op==0) {
  if(a==0) { return ux_span(0,16384); }
  if(a==1) { return state; }
  if(a==2) { return LightJson.size; }
  if(a==3) { return text; }
  if(a==4) { return limit-text; }
  return 0-1;
}
if(op==1) {
  let end=LightJson_write(text,limit,state,0,0,scratch);
  if(end<0) { return end; }
  return end-text;
}
if(op==2) {
  if(a<1 || a>limit-text) { return 0-1; }
  return LightJson_read(state,text,text+a,scratch);
}
return 0-1;
