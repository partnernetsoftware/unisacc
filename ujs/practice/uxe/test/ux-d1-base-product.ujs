import uxe_dispatch from "uxe_v1"(i64, i64, i64) i64;
export uxe_frame(test:i64) i64 version 1;

if (test == 0) {
  let size = uxe_dispatch(1, 426, 240);
  let clear = uxe_dispatch(9, 0, 4280161290);
  let corner = uxe_dispatch(2, size - 1, 4284782280);
  return uxe_dispatch(3, 0, 0);
}
if (test == 1) { return uxe_dispatch(0, 0, 0); }
if (test == 2) {
  let copied = uxe_dispatch(4, 1, 3);
  let first = uxe_dispatch(8, 0, 0);
  return copied * 10000 + first * 100 + uxe_dispatch(8, 2, 0);
}
if (test == 3) {
  let firstSample = uxe_dispatch(5, 0, 16384);
  let otherSample = uxe_dispatch(5, 1, 0 - 8192);
  return uxe_dispatch(6, 2, 0);
}
if (test == 4) { return uxe_dispatch(2, 102240, 0); }
if (test == 5) { return uxe_dispatch(7, 0, 0); }
if (test == 6) { return uxe_dispatch(4, 19, 2); }
if (test == 7) { return uxe_dispatch(6, 48001, 0); }
if (test == 8) {
  let wroteBlend = uxe_dispatch(16, 0, 210 + 100 * 256 + 70 * 65536 + 128 * 16777216);
  wroteBlend = uxe_dispatch(2, 1, 255 * 65536 + 64 * 16777216);
  wroteBlend = uxe_dispatch(16, 1, 255 * 65536 + 128 * 16777216);
  wroteBlend = uxe_dispatch(16, 2, 255);
  return uxe_dispatch(3, 0, 0);
}
if (test == 9) { return uxe_dispatch(16, 102240, 4294967295); }
if (test == 10) {
  let stamp = uxe_dispatch(17, 4096 + 8192 * (4096 + 10) + 2 * 67108864,
    210 + 100 * 256 + 70 * 65536 + 200 * 16777216);
  return uxe_dispatch(3, 0, 0);
}
if (test == 11) { return uxe_dispatch(17, 17 * 67108864, 4294967295); }
if (test == 12) {
  let sceneDraw = uxe_dispatch(18, 100, 4);
  sceneDraw = uxe_dispatch(19, 0, 32756 + 32759 * 65536 + 40 * 4294967296);
  sceneDraw = uxe_dispatch(19, 1, 32780 + 32759 * 65536 + 40 * 4294967296);
  sceneDraw = uxe_dispatch(19, 2, 32768 + 32778 * 65536 + 40 * 4294967296);
  sceneDraw = uxe_dispatch(20, 0, 40 + 160 * 256 + 80 * 65536);
  sceneDraw = uxe_dispatch(19, 0, 32744 + 32750 * 65536 + 80 * 4294967296);
  sceneDraw = uxe_dispatch(19, 1, 32792 + 32750 * 65536 + 80 * 4294967296);
  sceneDraw = uxe_dispatch(19, 2, 32768 + 32788 * 65536 + 80 * 4294967296);
  sceneDraw = uxe_dispatch(20, 0, 180 + 20 * 256 + 30 * 65536);
  return uxe_dispatch(3, 0, 0);
}
if (test == 13) { return uxe_dispatch(19, 0, 32768 + 32768 * 65536 + 3 * 4294967296); }
if (test == 14) { return uxe_dispatch(20, 0, 65535); }
if (test == 15) {
  let materialDraw = uxe_dispatch(18, 100, 4);
  materialDraw = uxe_dispatch(21, 40 + 120 * 65536, 200 + 145 * 256 + 51 * 65536);
  materialDraw = uxe_dispatch(22, 120, 1);
  materialDraw = uxe_dispatch(19, 0, 32744 + 32750 * 65536 + 80 * 4294967296);
  materialDraw = uxe_dispatch(19, 1, 32792 + 32750 * 65536 + 80 * 4294967296);
  materialDraw = uxe_dispatch(19, 2, 32768 + 32788 * 65536 + 80 * 4294967296);
  materialDraw = uxe_dispatch(20, 0, 160 + 100 * 256 + 200 * 65536);
  return uxe_dispatch(3, 0, 0);
}
if (test == 16) { return uxe_dispatch(21, 120 + 40 * 65536, 0); }
if (test == 17) { return uxe_dispatch(22, 256, 1); }
if (test == 18 || test == 20) {
  let worldDraw = uxe_dispatch(18, 100, 4);
  worldDraw = uxe_dispatch(21, 0, 0);
  worldDraw = uxe_dispatch(22, 255, 0);
  if (test == 20) { worldDraw = uxe_dispatch(26, 128, 32768 + 32769 * 65536 + 32768 * 4294967296); }
  worldDraw = uxe_dispatch(23, 0, 32868 + 32768 * 65536 + 32868 * 4294967296);
  worldDraw = uxe_dispatch(24, 0, 32668 + 32768 * 65536 + 32768 * 4294967296);
  worldDraw = uxe_dispatch(25, 0, 32828 + 32759 * 65536 + 32880 * 4294967296);
  worldDraw = uxe_dispatch(25, 1, 32828 + 32759 * 65536 + 32856 * 4294967296);
  worldDraw = uxe_dispatch(25, 2, 32828 + 32778 * 65536 + 32868 * 4294967296);
  worldDraw = uxe_dispatch(20, 0, 30 + 85 * 256 + 210 * 65536);
  return uxe_dispatch(3, 0, 0);
}
if (test == 19) { return uxe_dispatch(24, 0, 32768 + 32769 * 65536 + 32768 * 4294967296); }
if (test == 21) { return uxe_dispatch(26, 128, 32768 + 32768 * 65536 + 32768 * 4294967296); }
if (test == 22 || test == 23) {
  let textureDraw = uxe_dispatch(18, 100, 4);
  textureDraw = uxe_dispatch(4, 4, 16);
  textureDraw = uxe_dispatch(27, 2 + 2 * 2048, 0);
  textureDraw = uxe_dispatch(19, 0, 32744 + 32750 * 65536 + 80 * 4294967296);
  textureDraw = uxe_dispatch(19, 1, 32792 + 32750 * 65536 + 80 * 4294967296);
  textureDraw = uxe_dispatch(19, 2, 32768 + 32775 * 65536 + 20 * 4294967296);
  let texUV = 4294967295 * (test == 22);
  textureDraw = uxe_dispatch(28, 0, 0);
  textureDraw = uxe_dispatch(28, 1, 0);
  textureDraw = uxe_dispatch(28, 2, texUV);
  textureDraw = uxe_dispatch(20, 0, 65535);
  return uxe_dispatch(3, 0, 0);
}
if (test == 24) { return uxe_dispatch(27, 2 + 2 * 2048, 1); }
return 0 - 1;
