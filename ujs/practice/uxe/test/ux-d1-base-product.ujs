import uxe_dispatch from "uxe_v1"(i64, i64, i64) i64;
export uxe_frame(test:i64) i64 version 1;

if (test == 0) {
  let size = uxe_dispatch(1, 426, 240);
  let clear = uxe_dispatch(9, 0, 4280161290);
  let corner = uxe_dispatch(2, size - 1, 4284782280);
  return uxe_dispatch(3, 0, 0);
}
if (test == 1) { return uxe_dispatch(0, 0, 0); }
if (test == 2) {
  let copied = uxe_dispatch(4, 1, 3);
  let first = uxe_dispatch(8, 0, 0);
  return copied * 10000 + first * 100 + uxe_dispatch(8, 2, 0);
}
if (test == 3) {
  let firstSample = uxe_dispatch(5, 0, 16384);
  let otherSample = uxe_dispatch(5, 1, 0 - 8192);
  return uxe_dispatch(6, 2, 0);
}
if (test == 4) { return uxe_dispatch(2, 102240, 0); }
if (test == 5) { return uxe_dispatch(7, 0, 0); }
if (test == 6) { return uxe_dispatch(4, 3, 2); }
if (test == 7) { return uxe_dispatch(6, 48001, 0); }
return 0 - 1;
