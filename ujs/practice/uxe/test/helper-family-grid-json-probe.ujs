native function helper_probe_json(at:i64,kind:i64) i64 {
  let geo=BufferGeometry_init(512,640,2,680,0);
  let end=HelperGridGeometry_toJSON(at,kind,geo,704,40000,65000,960,3192);
  if(end<0) { return end; }
  return end-40000;
}

if(mode==0) { return ux_span(0,90000); }
if(mode==1) {
  let names=HelperGridGeometry_names(912);
  let p=ux_u32_put(960+GeometryJsonIdentity.uuid,984);
  let n=ux_u32_put(960+GeometryJsonIdentity.uuidBytes,6);
  let mp=ux_u32_put(960+GeometryJsonIdentity.names,names);
  let mc=ux_u32_put(960+GeometryJsonIdentity.nameCount,2);
  let first=ux_f32_put(608,0.25);
  let second=ux_f32_put(620,0.5);
  let helper=0-1;
  if(kind==1) { helper=GridHelper_init(128,1024,2048,16,608,8.0+mutate,2); }
  else if(kind==2) { helper=PolarGridHelper_init(128,1024,2048,608,4.0+mutate,4,1,4); }
  else if(kind==3) { helper=AxesHelper_init(128,1024,2048,3.0+mutate); }
  if(helper!=128) { return 0-101; }
  return helper_probe_json(helper,kind);
}
if(mode==2 || mode==4) {
  if(length<1 || length>30000) { return 0-102; }
  let geo=BufferGeometry_init(560,800,2,840,0);
  let arena=70000;
  let helper=256;
  if(mode==4) { arena=76000; helper=448; }
  let a=ux_u32_put(880+GeometryJsonLoad.arena,arena);
  let b=ux_u32_put(880+GeometryJsonLoad.arenaEnd,arena+5000);
  let c=ux_u32_put(880+GeometryJsonLoad.names,912);
  let d=ux_u32_put(880+GeometryJsonLoad.nameCount,2);
  let e=ux_u32_put(880+GeometryJsonLoad.scratch,2880);
  let loaded=HelperGridGeometry_fromJSON(helper,kind,geo,10000,10000+length,880);
  if(mode==4) {
    if(loaded==0-1 && ux_u32(helper+helper_grid_geometry_active(kind))==0) { return 1; }
    return 0;
  }
  if(loaded<0) { return loaded; }
  return helper_probe_json(helper,kind);
}
if(mode==3) {
  let cloned=0-1;
  if(kind==1) { cloned=GridHelper_clone(384,256); }
  else if(kind==2) { cloned=PolarGridHelper_clone(384,256); }
  else if(kind==3) { cloned=AxesHelper_clone(384,256); }
  if(cloned!=384) { return 0-103; }
  let changed=ux_f32_put(ux_u32(256+GridHelper.positions),17.0);
  if(kind==3) {
    let red=ux_f32_put(2520,0.75);
    let update=AxesHelper_setColors(256,2520);
    if(update!=256 || AxesHelper_getColorVersion(384)!=1) { return 0-104; }
  }
  return helper_probe_json(cloned,kind);
}
return 0-1;
