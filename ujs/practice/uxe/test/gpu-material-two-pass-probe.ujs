let packet=0;
let capacity=4096;
let state=4352;
let vertices=4608;
let shader=4864;
let i=0;
while(i<6) {
  let point=i%3;
  let back=i>=3;
  let row=vertices+i*28;
  let x=0.0-1.0+4.0*(point==1+back);
  let y=0.0-1.0+4.0*(point==2-back);
  let a=ux_f32_put(row,x);
  let b=ux_f32_put(row+4,y);
  let c=ux_f32_put(row+8,0.0);
  let d=ux_f32_put(row+12,0.0+back);
  let e=ux_f32_put(row+16,1.0-back);
  let f=ux_f32_put(row+20,0.0);
  let g=ux_f32_put(row+24,0.5);
  i=i+1;
}
let a=ux_u32_put(state+GpuRenderState.depth,8);
let b=ux_u32_put(state+GpuRenderState.blend,5);
let eqRgb=ux_u32_put(state+GpuRenderState.equationRgb,100);
let eqAlpha=ux_u32_put(state+GpuRenderState.equationAlpha,100);
let srcRgb=ux_u32_put(state+GpuRenderState.sourceRgb,204);
let dstRgb=ux_u32_put(state+GpuRenderState.destinationRgb,205);
let srcAlpha=ux_u32_put(state+GpuRenderState.sourceAlpha,201);
let dstAlpha=ux_u32_put(state+GpuRenderState.destinationAlpha,205);
let mask=ux_u32_put(state+GpuRenderState.colorMask,15);
let status=GpuPacket_begin(packet,capacity,1);
if(status<0) { return status; }
status=GpuPacket_viewport(packet,capacity,0,0,4,4);
if(status<0) { return status; }
status=GpuPacket_clear(packet,capacity,4278190080);
if(status<0) { return status; }
let side=GpuMaterial_twoPassTag();
let count=GpuMaterial_passCount(side,1,single);
let pass=0;
while(pass<count) {
  let index=pass;
  if(mutate==1 && count==2) { index=1-pass; }
  let face=GpuMaterial_passSide(side,1,single,index);
  status=GpuMaterialSide_apply(state,face);
  if(status<0) { return status; }
  status=GpuPacket_setRenderState(packet,capacity,state);
  if(status<0) { return status; }
  status=GpuPacket_draw(packet,capacity,vertices,6,shader);
  if(status<0) { return status; }
  pass=pass+1;
}
status=GpuPacket_submit(packet);
if(status<0) { return status; }
return count;
