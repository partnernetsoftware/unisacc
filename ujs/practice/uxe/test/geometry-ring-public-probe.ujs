native function ring_probe_values(at:i64,out:i64) i64 {
  let geo=GeometryPrimitive_geometry(at);
  let pos=BufferGeometry_getAttribute(geo,1);
  let normal=BufferGeometry_getAttribute(geo,2);
  let uv=BufferGeometry_getAttribute(geo,4);
  let index=BufferGeometry_getIndex(geo);
  let count=ux_u32(pos+BufferAttribute.count);
  let data=ux_u32(pos+BufferAttribute.data);
  let last=data+12*(count-1);
  let a=ux_f64_put(out,0.0+count);
  let b=ux_f64_put(out+8,0.0+ux_u32(index+BufferAttribute.count));
  let i=0;
  while(i<6) {
    let p=ux_f64_put(out+16+i*8,ux_f64(at+GeometryPrimitiveRecord.first+i*8));
    i=i+1;
  }
  let x=ux_f64_put(out+64,ux_f32(data));
  let y=ux_f64_put(out+72,ux_f32(data+4));
  let endX=ux_f64_put(out+80,ux_f32(last));
  let endY=ux_f64_put(out+88,ux_f32(last+4));
  let n=ux_f64_put(out+96,ux_f32(ux_u32(normal+BufferAttribute.data)+8));
  let v=ux_f64_put(out+104,ux_f32(ux_u32(uv+BufferAttribute.data)+8*(count-1)+4));
  let idx=ux_f64_put(out+112,0.0+ux_u16(ux_u32(index+BufferAttribute.data)));
  return out;
}

if(mode==0) { return ux_span(0,50000); }
let i=0;
while(i<5) {
  let at=128+i*160;
