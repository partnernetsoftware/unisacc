  let geo=BufferGeometry_init(GeometryPrimitive_geometry(at),attrs,3,attrs+64,0);
  let registry=EventDispatcher_init(geo,attrs+80,3);
  if(geo<0 || registry!=geo) { return 0-101; }
  i=i+1;
}
let raw=GeometryBuffers_init(1800,8192,80,12000,240);
let params=1920;
let p0=ux_f64_put(params+RingGeometryParameters.innerRadius,1.25+mutate*0.5);
let p1=ux_f64_put(params+RingGeometryParameters.outerRadius,2.5);
let p2=ux_f64_put(params+RingGeometryParameters.thetaSegments,4.0);
let p3=ux_f64_put(params+RingGeometryParameters.phiSegments,2.0);
let p4=ux_f64_put(params+RingGeometryParameters.thetaStart,0.5);
let p5=ux_f64_put(params+RingGeometryParameters.thetaLength,1.25);
let created=RingGeometry_create(128,raw,16384,4096,params);
let named=GeometryPrimitive_setName(128,6016,7);
if(raw!=1800 || created!=128 || named!=128) { return 0-102; }
let short=RingGeometry_toJSON(128,4096,4100,6000,6,2048);
let end=RingGeometry_toJSON(128,4096,5600,6000,6,2048);
if(end<4096) { return 0-103; }
let broken=RingGeometry_fromJSON(288,raw,20480,4096,4096,end-1,2048);
let alias=RingGeometry_fromJSON(288,raw,20480,4096,4096,end,4096);
let bad=RingGeometry_fromJSON(288,raw,20480,4096,5760,5781,2048);
let fraction=RingGeometry_fromJSON(288,raw,20480,4096,5824,5845,2048);
let zero=RingGeometry_fromJSON(288,raw,20480,4096,5848,5865,2048);
let rejected=ux_f64_put(6160,0.0+(short==0-1 && broken==0-1 && alias==0-1 &&
  bad==0-1 && fraction==0-1 && zero==0-1 && ux_u32(288+GeometryPrimitiveRecord.kind)==0));
let loaded=RingGeometry_fromJSON(288,raw,20480,4096,4096,end,2048);
let defaults=RingGeometry_fromJSON(448,raw,24576,4096,5800,5802,2048);
let minimum=RingGeometry_fromJSON(608,raw,28672,4096,5872,5911,2048);
if(loaded!=288 || defaults!=448 || minimum!=608) { return 0-104; }
let source=ring_probe_values(128,6656);
