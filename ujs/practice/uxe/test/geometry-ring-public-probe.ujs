let fallback=ring_probe_values(448,6912);
let small=ring_probe_values(608,7168);
let equal=1;
i=0;
while(i<15) {
  let delta=ux_f64(6176+i*8)-ux_f64(6656+i*8);
  if(delta<0.0-0.000000001 || delta>0.000000001) { equal=0; }
  i=i+1;
}
let same=ux_f64_put(6168,0.0+equal);
let defaultCount=ux_f64_put(6296,ux_f64(6912));
let defaultIndices=ux_f64_put(6304,ux_f64(6920));
let minimumCount=ux_f64_put(6312,ux_f64(7168));
