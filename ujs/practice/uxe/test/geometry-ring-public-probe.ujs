let changeAngle=ux_f64_put(128+GeometryPrimitiveRecord.sixth,3.0);
let changeRadius=ux_f64_put(128+GeometryPrimitiveRecord.first,7.0);
let own=ux_f64_put(6344,0.0+(spos!=dpos && spos!=cpos && dpos!=cpos));
let angle=ux_f64_put(6352,ux_f64(768+GeometryPrimitiveRecord.sixth));
let radius=ux_f64_put(6360,ux_f64(288+GeometryPrimitiveRecord.first));
