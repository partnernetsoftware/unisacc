import uxe_jpeg_dispatch from "uxe_jpeg_v1"(i64,i64,i64) i64;
export uxe_evaluate_case(selected_case:i64) f64 version 1;

// Values 0..13 are the original case indices. Add 32/64 to select the
// decoder/loader mutation, respectively, without changing their order.
if(selected_case<0 || selected_case>=96) { return 0.0-1.0; }
let index=selected_case%32;
let mode=selected_case/32;
if(index>=14 || uxe_jpeg_dispatch(0,0,0)!=1) { return 0.0-1.0; }
return 0.0+uxe_jpeg_dispatch(3,index,mode);
