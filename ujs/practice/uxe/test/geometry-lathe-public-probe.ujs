native function lathe_probe_emit(at:i64) i64 {
  let geo=GeometryPrimitive_geometry(at);
  let pos=BufferGeometry_getAttribute(geo,1);
  let nor=BufferGeometry_getAttribute(geo,2);
  let uv=BufferGeometry_getAttribute(geo,4);
  let idx=BufferGeometry_getIndex(geo);
  let a=ux_u32_put(7000,ux_u32(pos+BufferAttribute.data));
  let b=ux_u32_put(7004,ux_u32(nor+BufferAttribute.data));
  let c=ux_u32_put(7008,ux_u32(uv+BufferAttribute.data));
  let d=ux_u32_put(7012,ux_u32(idx+BufferAttribute.data));
  let e=ux_u32_put(7016,ux_u32(pos+BufferAttribute.count));
  let f=ux_u32_put(7020,ux_u32(idx+BufferAttribute.count));
  let named=GeometryPrimitive_setName(at,6016,7);
  if(named!=at) { return 0-101; }
  let end=LatheGeometry_toJSON(at,4096,6000,6000,5,2048);
  if(end<0) { return end; }
  return end-4096;
}

if(mode==0) { return ux_span(0,60000); }
if(mode<1 || mode>6) { return 0-1; }
let slot=mode-1;
let at=128+slot*144;
let attrs=1024+slot*128;
let geo=BufferGeometry_init(GeometryPrimitive_geometry(at),attrs,3,attrs+64,0);
let raw=GeometryBuffers_init(1800,8192,200,16000,900);
if(geo<0 || raw!=1800) { return 0-102; }
let profile=3200+slot*96;
let params=1920;
let arena=20480+4096*slot;
let out=0-1;
if(mode==1) {
  let a=ux_f64_put(profile,0.0);
  let b=ux_f64_put(profile+8,0.0-1.0);
  let c=ux_f64_put(profile+16,1.0+mutate*0.5);
  let d=ux_f64_put(profile+24,0.0);
  let e=ux_f64_put(profile+32,0.5);
  let f=ux_f64_put(profile+40,2.0);
  let s=ux_f64_put(params+LatheGeometryParameters.segments,5.5);
  let t=ux_f64_put(params+LatheGeometryParameters.phiStart,0.25);
  let l=ux_f64_put(params+LatheGeometryParameters.phiLength,8.0);
  out=LatheGeometry_create(at,raw,arena,4096,profile,3,params);
} else {
  if(length<1 || length>4096) { return 0-103; }
  let storage=2000;
  let a=ux_u32_put(storage+LatheProfileStorage.points,profile);
  let b=ux_u32_put(storage+LatheProfileStorage.capacity,3);
  if(mode==6) {
    let alias=ux_u32_put(storage+LatheProfileStorage.points,8192);
  }
  out=LatheGeometry_fromJSON(at,raw,arena,4096,48000,48000+length,params,storage);
  if(mode>=4) {
    if(out==0-1 && ux_u32(at+GeometryPrimitiveRecord.kind)==0) { return 1; }
    return 0;
  }
}
if(out!=at) { return 0-100*mode+out; }
return lathe_probe_emit(out);
