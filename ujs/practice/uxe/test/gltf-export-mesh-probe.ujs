let mesh=64;
let a=ux_u32_put(mesh+GltfExportMesh.vertices,512);
let b=ux_u32_put(mesh+GltfExportMesh.vertexCount,3);
let c=ux_u32_put(mesh+GltfExportMesh.indices,576);
let d=ux_u32_put(mesh+GltfExportMesh.indexCount,3);
let e=ux_u32_put(mesh+GltfExportMesh.translation,256);
let f=ux_u32_put(mesh+GltfExportMesh.color,288);
let tx=ux_f64_put(256,2.0);
let ty=ux_f64_put(264,3.0);
let tz=ux_f64_put(272,0.0-4.0);
let red=ux_f64_put(288,0.25);
let green=ux_f64_put(296,0.5);
let blue=ux_f64_put(304,0.75);
let alpha=ux_f64_put(312,1.0);
let ax=ux_f32_put(512,0.0-2.0);
let bx=ux_f32_put(524,1.0);
let cy=ux_f32_put(540,3.0);
let first=ux_u16_put(576,0);
let second=ux_u16_put(578,1);
let third=ux_u16_put(580,2);
if(mode==1) {
  second=ux_u16_put(578,2); third=ux_u16_put(580,1);
} else if(mode==2) {
  let sentinel=ux_u8_put(12000,77);
  let short=GLTFExporter_exportMesh(mesh,12000,20,2048);
  return short*100+ux_u8(12000);
} else if(mode==3) {
  second=ux_u16_put(578,3);
  return GLTFExporter_exportMesh(mesh,12000,8192,2048);
}
return GLTFExporter_exportMesh(mesh,12000,8192,2048);
