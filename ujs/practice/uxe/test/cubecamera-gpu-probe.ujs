function mark_cube_face(sample_ctx,...face_args) {
  let sample_face=face_args[0];
  let sample_direction=face_args[1];
  let sample_color=4278190080;
  let sample_axis=sample_face/2;
  let sample_value=ux_f64(sample_direction+sample_axis*8);
  if(sample_axis==0 && sample_value>0.0) { sample_color=4278190335; }
  if(sample_axis==0 && sample_value<0.0) { sample_color=4278255360; }
  if(sample_axis==1 && sample_value>0.0) { sample_color=4294901760; }
  if(sample_axis==1 && sample_value<0.0) { sample_color=4278255615; }
  if(sample_axis==2 && sample_value>0.0) { sample_color=4294967040; }
  if(sample_axis==2 && sample_value<0.0) { sample_color=4294902015; }
  return GpuPacket_clearBuffers(0,2048,1,sample_color,1.0,0);
}
let start=GpuPacket_begin(0,2048,1);
let desc=3000;
let kind=ux_u32_put(desc+GpuTarget.kind,1);
let id=ux_u32_put(desc+GpuTarget.id,1);
let width=ux_u32_put(desc+GpuTarget.width,4);
let height=ux_u32_put(desc+GpuTarget.height,4);
let layers=ux_u32_put(desc+GpuTarget.layers,6);
let colors=ux_u32_put(desc+GpuTarget.colors,1);
let depth=ux_u32_put(desc+GpuTarget.depth,0);
let created=GpuTarget_create(0,2048,desc);
let callback=closure(mark_cube_face,0);
let capacity=2048;
if(mode==2) { capacity=192; }
let captured=CubeCamera_update(callback,0,capacity,1,0,0,4096,2000);
if(mode==2) {
  if(captured>=0) { return 0-1; }
  return ux_u32(GpuPacket.commands);
}
if(captured!=6) { return captured; }
let face=0;
let read=3200;
let target=ux_u32_put(read+GpuTargetRead.id,1);
let rw=ux_u32_put(read+GpuTargetRead.width,1);
let rh=ux_u32_put(read+GpuTargetRead.height,1);
while(face<6) {
  let selected=face;
  if(mode==1 && face==0) { selected=1; }
  let slice=ux_u32_put(read+GpuTargetRead.layer,selected);
  let out=ux_u32_put(read+GpuTargetRead.output,8192+face*4);
  let command=GpuTarget_read(0,2048,read);
  if(command<0) { return command; }
  face=face+1;
}
let dispose=GpuTarget_dispose(0,2048,1);
return GpuPacket_submit(0);
