if(op==0) { return ux_span(0,16000); }
let node=512;
if(op==2 || op==3) {
  let matrix=ux_u32_put(node+Object3D.localMatrix,896);
  let state=ux_u32_put(0+LightHelperObjectJson.rootState,node);
  let restored=LightHelperObject_readJSON(kind,node,0,8000,finish,6400);
  if(op==3 && restored>=0) { let broken=ux_u32_put(node+Object3D.visible,1); }
  return restored;
}
return LightHelperObject_writeJSON(kind,0,8000,finish,6400);
