  let r1=EventDispatcher_addListener(s,7,41);
  let r2=EventDispatcher_addListener(s,7,82);
  let r3=EventDispatcher_addListener(s,8,99);
  let r4=EventDispatcher_addListener(d,7,61);
  return 0.0+(named==source && r1==s && r2==s && r3==s && r4==d);
