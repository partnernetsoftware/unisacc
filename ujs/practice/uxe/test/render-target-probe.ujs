native function render_target_probe_pixels(target:i64,color:i64,output:i64) i64 {
  let packet=GpuPacket_begin(0,256,1);
  let bound=RenderTarget_bind(target,packet,256);
  if(bound<0) { return bound; }
  if(color>=0) { let cleared=GpuPacket_clear(packet,256,color); }
  let a=ux_u32_put(1100+GpuTargetRead.id,ux_u32(target+RenderTarget.id));
  let b=ux_u32_put(1100+GpuTargetRead.layer,0);
  let c=ux_u32_put(1100+GpuTargetRead.color,0);
  let d=ux_u32_put(1100+GpuTargetRead.x,0);
  let e=ux_u32_put(1100+GpuTargetRead.y,0);
  let f=ux_u32_put(1100+GpuTargetRead.width,ux_u32(target+RenderTarget.width));
  let g=ux_u32_put(1100+GpuTargetRead.height,ux_u32(target+RenderTarget.height));
  let h=ux_u32_put(1100+GpuTargetRead.output,output);
  let read=GpuTarget_read(packet,256,1100);
  if(read<0) { return read; }
  return GpuPacket_submit(packet);
}

native function render_target_probe_bind(id:i64) i64 {
  let packet=GpuPacket_begin(0,256,1);
  let bound=GpuTarget_bind(packet,256,id,0);
  return GpuPacket_submit(packet);
}

native function render_target_probe_observer(observer:i64,output:i64,identity:i64) i64 {
  let a=ux_u32_put(observer+RenderTargetDisposeObserver.dispatcher,1264);
  let b=ux_u32_put(observer+RenderTargetDisposeObserver.event,7);
  let c=ux_u32_put(observer+RenderTargetDisposeObserver.identity,identity);
  let d=ux_u32_put(observer+RenderTargetDisposeObserver.output,output);
  let e=ux_u32_put(observer+RenderTargetDisposeObserver.capacity,2);
  let f=ux_u32_put(observer+RenderTargetDisposeObserver.sequence,0);
  return observer;
}

let prepared=RenderTarget_prepareDescriptor(1024,1,4,3,1);
let create=RenderTarget_create(512,0,256,1024,1);
if(create!=0) { return create; }
let registry=EventDispatcher_init(1264,1328,3);
let ignored=EventDispatcher_addListener(registry,8,404);
let first=EventDispatcher_addListener(registry,7,303);
let second=EventDispatcher_addListener(registry,7,304);
let observed=render_target_probe_observer(1216,1360,777);
let watched=RenderTarget_watchDispose(512,observed);
if(watched!=512) { return 0-102; }
let viewport=RenderTarget_setViewport(512,1,0,3,3);
let scissor=RenderTarget_setScissor(512,1,1+(mutate==1),1,2,1);
if(viewport!=512 || scissor!=512) { return 0-101; }
let painted=render_target_probe_pixels(512,4278190335,1536);
if(painted!=0) { return painted; }
let source_before=ux_u32_put(4096,ux_u32(1536+20));
let source_outer=ux_u32_put(4100,ux_u32(1536));

let clone=RenderTarget_clone(640,512,0,256,1024,2);
if(clone!=0) { return clone; }
let noInheritedObserver=ux_u32_put(4196,ux_u32(640+RenderTarget.disposeObserver)==0);
let b_observer=render_target_probe_observer(1400,1488,888);
let b_watch=RenderTarget_watchDispose(640,b_observer);
if(b_watch!=640) { return 0-103; }
let empty=render_target_probe_pixels(640,0-1,1600);
if(empty!=0) { return empty; }
let independent=ux_u32_put(4104,ux_u32(1600+20));
let clip=ux_u32_put(4108,ux_u32(640+RenderTarget.scissorWidth));
let view=ux_u32_put(4112,ux_u32(640+RenderTarget.viewportWidth));
let clone_depth=ux_u32_put(4116,ux_u32(640+RenderTarget.depthBuffer));

let occupied=RenderTarget_setSize(512,0,256,1024,6,2,2,0);
let rejected=ux_u32_put(4144,occupied==0-12);
let retained=ux_u32_put(4148,ux_u32(512+RenderTarget.id)==1 && ux_u32(512+RenderTarget.width)==4);
let small=ux_u32_put(1216+RenderTargetDisposeObserver.capacity,1);
let limited=RenderTarget_setSize(512,0,256,1024,6,2,3,0);
let resize_blocked=ux_u32_put(4172,limited==0-2 && ux_u32(512+RenderTarget.id)==1 &&
  ux_u32(1216+RenderTargetDisposeObserver.sequence)==0);
let room=ux_u32_put(1216+RenderTargetDisposeObserver.capacity,2);
let resize=RenderTarget_setSize(512,0,256,1024,6,2,3,0);
if(resize!=0) { return resize; }
let sequence=ux_u32_put(4176,ux_u32(1216+RenderTargetDisposeObserver.sequence));
let identity=ux_u32_put(4180,ux_u32(1360));
let count=ux_u32_put(4184,ux_u32(1364));
let listener1=ux_u32_put(4188,ux_u32(1368));
let listener2=ux_u32_put(4192,ux_u32(1372));
let old=render_target_probe_bind(1);
let old_gone=ux_u32_put(4152,old==0-12);
let resized=render_target_probe_pixels(512,4278255360,1664);
if(resized!=0) { return resized; }
let resized_edge=ux_u32_put(4120,ux_u32(1664+44));
let resized_view=ux_u32_put(4124,ux_u32(512+RenderTarget.viewportWidth));
let unaffected=ux_u32_put(4128,ux_u32(640+RenderTarget.width));

let clone_painted=render_target_probe_pixels(640,4294901760,1728);
if(clone_painted!=0) { return clone_painted; }
let unclipped=ux_u32_put(4132,ux_u32(1728));
let after=ux_u32_put(4136,ux_u32(1728+20));
let same=RenderTarget_setSize(640,0,256,1024,4,3,0,0);
if(same!=0) { return same; }
let still_there=render_target_probe_pixels(640,0-1,1792);
if(still_there!=0) { return still_there; }
let same_pixels=ux_u32_put(4140,ux_u32(1792+20));
let same_view=ux_u32_put(4164,ux_u32(640+RenderTarget.viewportWidth));
let same_clipping=ux_u32_put(4168,ux_u32(640+RenderTarget.scissorTest));

let same_event=ux_u32_put(4200,ux_u32(1400+RenderTargetDisposeObserver.sequence));
let copy_from=512;
if(mutate==2) { copy_from=640; }
let copied=RenderTarget_copy(640,copy_from,0,256,1024,4,0);
if(copied!=0) { return copied; }
let copied_width=ux_u32_put(4204,ux_u32(640+RenderTarget.width));
let copied_view=ux_u32_put(4208,ux_u32(640+RenderTarget.viewportWidth));
let copied_scissor=ux_u32_put(4212,ux_u32(640+RenderTarget.scissorTest));
let copy_event=ux_u32_put(4216,ux_u32(1400+RenderTargetDisposeObserver.sequence));
let copied_read=render_target_probe_pixels(640,0-1,1856);
if(copied_read!=0) { return copied_read; }
let copied_pixel=ux_u32_put(4220,ux_u32(1856+20));
let freed=ux_u32_put(4224,render_target_probe_bind(2)==0-12);
let source_read=render_target_probe_pixels(512,0-1,1920);
if(source_read!=0) { return source_read; }
let original_pixel=ux_u32_put(4228,ux_u32(1920+44));
let copy_depth=ux_u32_put(4252,ux_u32(640+RenderTarget.depthBuffer));

let gone_clone=RenderTarget_dispose(640,0,256,0);
let clone_id=ux_u32_put(4156,gone_clone==0 && render_target_probe_bind(2)==0-12);
let b_sequence=ux_u32_put(4232,ux_u32(1400+RenderTargetDisposeObserver.sequence));
let b_identity=ux_u32_put(4236,ux_u32(1488));
let b_listener=ux_u32_put(4240,ux_u32(1496));
let b_id=ux_u32_put(4248,render_target_probe_bind(4)==0-12);
let gone_source=RenderTarget_dispose(512,0,256,0);
let source_id=ux_u32_put(4160,gone_source==0 && render_target_probe_bind(3)==0-12);
let a_sequence=ux_u32_put(4244,ux_u32(1216+RenderTargetDisposeObserver.sequence));
return 0;
