let a=ux_u32_put(128+SplineJson.points,512);
let b=ux_u32_put(128+SplineJson.count,3);
let c=ux_u32_put(128+SplineJson.capacity,3);
let d=ux_u32_put(128+SplineJson.divisions,200);
let e=ux_u32_put(256+SplineJson.points,1024);
let f=ux_u32_put(256+SplineJson.capacity,3);
let t=ux_f64_put(128+SplineJson.tension,0.5);
if(selected<3 || selected==6) {
  let middle=1.0;
  if(selected==6) { middle=2.0; }
  let x=ux_f64_put(528,middle);
  let y=ux_f64_put(544,5.0);
  let stop=SplineCurve_toJSON(128,2048,4096,4608);
  if(stop<0) { return 0.0+stop; }
  let restored=SplineCurve_fromJSON(256,2048,stop,6144);
  if(restored<0) { return 0.0+restored; }
  if(selected==1) { return SplineCurve_getLength(256,8032); }
  if(selected==2) { return 0.0+ux_u32(256+SplineJson.divisions); }
  let point=SplineCurve_getPoint(8000,1024,3,0.5);
  return ux_f64(point);
}
let mode=selected-3;
if(selected==7) { mode=2; }
let x=ux_f64_put(536,1.0);
let y=ux_f64_put(560,5.0);
let kind=ux_u32_put(128+SplineJson.kind,mode);
let last=CatmullRomCurve3_toJSON(128,2048,4096,4608);
if(last<0) { return 0.0+last; }
let loaded=CatmullRomCurve3_fromJSON(256,2048,last,6144);
if(loaded<0) { return 0.0+loaded; }
let parsed=ux_u32(256+SplineJson.kind);
let point=CatmullRomCurve3_getPoint(8000,1024,3,0.5,ux_u32(256+SplineJson.closed),parsed,ux_f64(256+SplineJson.tension));
return ux_f64(point)+CatmullRomCurve3_getLength(256,8032)+10.0*parsed;
