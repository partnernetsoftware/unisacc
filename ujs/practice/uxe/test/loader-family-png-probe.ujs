import uxe_png_dispatch from "uxe_png_loader_v1"(i64,i64,i64,i64) i64;
export uxe_png_probe(op:i64,a:i64,b:i64,c:i64) i64 version 1;

if(op==0 && uxe_png_dispatch(0,0,0,0)!=1) { return 0-1; }
if(op==0) { return uxe_png_dispatch(1,a,0,0); }
if(op==6) { return uxe_png_dispatch(7,a,b,0); }
if(op==7) { return uxe_png_dispatch(8,a,0,0); }
if(op==1) { return uxe_png_dispatch(2,a,b,0); }
if(op==2) { return uxe_png_dispatch(3,a,b,c); }
if(op==3) { return uxe_png_dispatch(4,a,b,0); }
if(op==4) {
  if(a==3 && b==1) { return uxe_png_dispatch(5,5,0,0); }
  return uxe_png_dispatch(5,a,0,0);
}
if(op==5) { return uxe_png_dispatch(6,a,0,0); }
return 0-1;
