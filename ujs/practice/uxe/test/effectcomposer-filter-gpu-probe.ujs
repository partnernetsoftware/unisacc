native function filter_gpu_probe_read(packet:i64,id:i64,out:i64) i64 {
  let desc=5000;
  let a=ux_u32_put(desc+GpuTargetRead.id,id);
  let b=ux_u32_put(desc+GpuTargetRead.layer,0);
  let c=ux_u32_put(desc+GpuTargetRead.color,0);
  let d=ux_u32_put(desc+GpuTargetRead.x,0);
  let e=ux_u32_put(desc+GpuTargetRead.y,0);
  let f=ux_u32_put(desc+GpuTargetRead.width,7);
  let g=ux_u32_put(desc+GpuTargetRead.height,5);
  let h=ux_u32_put(desc+GpuTargetRead.output,out);
  return GpuTarget_read(packet,4096,desc);
}

let composer=4200;
let ownership=4300;
let initialized=EffectComposer_init(composer,2,1,4360,2,7,5);
let created=EffectComposerGpu_create(composer,ownership,0,4096,5000,1);
if(initialized<0 || created!=0) { return 0-1; }
let packet=GpuPacket_begin(0,4096,1);
let bound=EffectComposerGpu_bindBuffer(composer,ownership,packet,4096,0);
if(bound<0) { return bound; }
let y=0;
while(y<5) {
  let x=0;
  while(x<7) {
    let r=40;
    let alpha=80;
    if(y>=x) { r=240; alpha=240; }
    let cell=GpuPacket_scissor(packet,4096,1,x,y,1,1);
    let written=GpuPacket_clear(packet,4096,r+256*64+65536*128+16777216*alpha);
    if(cell<0 || written<0) { return 0-1; }
    x=x+1;
  }
  y=y+1;
}
let ready=GpuPacket_submit(packet);
if(ready!=0) { return ready; }
let addColor=EffectComposer_addPass(composer,10,3);
let addFxaa=EffectComposer_addPass(composer,20,3);
let planned=EffectComposer_plan(composer,4400,4480,2);
if(addColor<0 || addFxaa<0 || planned!=2) { return 0-1; }
let transfer=4600;
let work=4700;
let settings=5104;
let channel=0;
while(channel<3) {
  let power=ux_f64_put(settings+ColorCorrectionSettings.powR+channel*8,2.0);
  let gain=ux_f64_put(settings+ColorCorrectionSettings.mulR+channel*8,1.0);
  channel=channel+1;
}
let a=ux_u32_put(transfer+ComposerFilterTransfer.step,4480);
let b=ux_u32_put(transfer+ComposerFilterTransfer.width,7);
let c=ux_u32_put(transfer+ComposerFilterTransfer.height,5);
let d=ux_u32_put(transfer+ComposerFilterTransfer.input,5440);
let e=ux_u32_put(transfer+ComposerFilterTransfer.output,5664);
let f=ux_u32_put(transfer+ComposerFilterTransfer.shader,6500);
let g=ux_u32_put(transfer+ComposerFilterTransfer.mode,1);
let h=ux_u32_put(transfer+ComposerFilterTransfer.settings,settings);
let alias=ux_u32_put(4480+ComposerStep.write,2);
let refused=EffectComposerGpu_transferRGBA8(0,4096,1,transfer,work);
let restored=ux_u32_put(4480+ComposerStep.write,1);
let limited=EffectComposerGpu_transferRGBA8(0,400,1,transfer,work);
if(refused!=0-1 || limited!=0-1) { return 0-3; }
let color=EffectComposerGpu_transferRGBA8(0,4096,1,transfer,work);
if(color!=0) { return color; }
packet=GpuPacket_begin(0,4096,1);
let sampled=filter_gpu_probe_read(packet,1,5888);
let original=filter_gpu_probe_read(packet,2,6112);
let read=GpuPacket_submit(packet);
if(sampled<0 || original<0 || read!=0) { return 0-4; }
let next=ux_u32_put(transfer+ComposerFilterTransfer.step,4480+ComposerStep.size);
let filter=2;
if(mode==1) { filter=0; }
let selected=ux_u32_put(transfer+ComposerFilterTransfer.mode,filter);
let fxaa=EffectComposerGpu_transferRGBA8(0,4096,1,transfer,work);
if(fxaa!=0) { return fxaa; }
let committed=EffectComposer_commit(composer,4400);
if(committed<0) { return committed; }
return EffectComposerGpu_release(ownership,0,4096,0);
