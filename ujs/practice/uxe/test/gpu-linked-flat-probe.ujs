import uxe_gpu_dispatch from "uxe_gpu_link_v1"(i64,i64) i64;
export uxe_gpu_probe(mode:i64) i64 version 1;

// Keep a different word at the packet address in the probe's own memory.
let sentinel=ux_u32_put(0,1515870810);
if(uxe_gpu_dispatch(0,0)!=1) { return 0-30; }
let status=uxe_gpu_dispatch(1,mode);
if(ux_u32(0)!=1515870810) { return 0-31; }
return status;
