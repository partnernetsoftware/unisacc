let mutate=kind>=16;
if(mutate) { kind=kind-16; }
if(kind<0 || kind>10) { return 0.0-1.0; }
let storage=kind;
if(kind==0) { storage=9; }
let width=BufferAttribute_width(storage);
let i=0;
while(i<4) {
  let at=512+i*width;
  let scalar=i+1;
  if(storage==8) {
    let bits=[15360,49152,0,32768];
    let halfword=ux_u16_put(at,bits[i]);
  } else if(storage==9) { let word=ux_f32_put(at,0.0+scalar); }
  else if(storage==10) { let word=ux_f64_put(at,0.0+scalar); }
  else if(width==1) { let word=ux_u8_put(at,scalar); }
  else if(width==2) { let word=ux_u16_put(at,scalar); }
  else { let word=ux_u32_put(at,scalar); }
  i=i+1;
}
let cap=ux_u32_put(256,2);
let source=Attribute_init(64,0,512,2,2,storage,kind%2,256);
if(source<0) { return 0.0-1.0; }
if(kind!=0 && kind!=10) {
  let bytes=ux_u32_put(416,577200500);
  let named=Attribute_setName(64,416,4);
}
if(kind%2) { let usage=BufferAttribute_setUsage(source,35048); }
let end=Attribute_toJSON(64,3072,3800,4096);
let expected=storage;
if(mutate) {
  expected=1;
  if(storage==1) { expected=2; }
}
let decoded=Attribute_fromJSON(3072,end,6400,8000,8192,expected);
if(decoded!=6400) { return 0.0-1.0; }
let last=Attribute_toJSON(decoded,1024,1900,2048);
if(last<0) { return 0.0-1.0; }
let offset=1024;
let hash=0;
while(offset<last) {
  hash=(hash*131+ux_u8(offset))%16777213;
  offset=offset+1;
}
return hash*1.0;
