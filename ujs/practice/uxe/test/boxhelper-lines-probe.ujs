let bound=BoxHelper_bindLineStream(helper,draw,stream,identity,projection,tint);
if(bound<0) { return 0-13; }
let first=SceneLine_projectPacked(draw,stream,vertices,24);
let expected=0.71875;
if(mode==1) { expected=0.0-0.03125; }
if(first!=24 || ux_f32(vertices)!=expected || ux_f32(vertices+4)!=0.65625) { return 0-14; }

let packet=GpuPacket_begin(0,8192,1);
