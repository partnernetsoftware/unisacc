let e=ux_f64_put(bounds+32,1.3125);
let f=ux_f64_put(bounds+40,0.5);
let made=BoxHelper_init(helper,bounds,positions,indices,3368652);
if(made<0) { return 0-11; }
let movedLo=ux_f64_put(bounds,0.3125);
let movedHi=ux_f64_put(bounds+24,1.3125);
if(mode==0 && BoxHelper_update(helper)!=1) { return 0-12; }

let p0=ux_f64_put(projection,0.5);
let p1=ux_f64_put(projection+40,0.5);
let p2=ux_f64_put(projection+64,0.125);
