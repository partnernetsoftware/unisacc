native function capsule_probe_values(at:i64,out:i64) i64 {
  let geo=GeometryPrimitive_geometry(at);
  let pos=BufferGeometry_getAttribute(geo,1);
  let normal=BufferGeometry_getAttribute(geo,2);
  let uv=BufferGeometry_getAttribute(geo,4);
  let index=BufferGeometry_getIndex(geo);
  let count=ux_u32(pos+BufferAttribute.count);
  let data=ux_u32(pos+BufferAttribute.data);
  let rows=4*f64_floor_i64(ux_f64(at+GeometryPrimitiveRecord.third))+2;
  let low=data+12*(rows/2-1);
  let high=low+12;
  let last=ux_u32(uv+BufferAttribute.data)+8*(count-1);
  let indices=ux_u32(index+BufferAttribute.data);
  let a=ux_f64_put(out,0.0+count);
  let b=ux_f64_put(out+8,0.0+ux_u32(index+BufferAttribute.count));
  let i=0;
  while(i<4) {
    let p=ux_f64_put(out+16+i*8,ux_f64(at+GeometryPrimitiveRecord.first+i*8));
    i=i+1;
  }
  let bottom=ux_f64_put(out+48,ux_f32(data+4));
  let top=ux_f64_put(out+56,ux_f32(data+12*(rows-1)+4));
  let lower=ux_f64_put(out+64,ux_f32(low+4));
  let upper=ux_f64_put(out+72,ux_f32(high+4));
  let radius=ux_f64_put(out+80,ux_f32(low+8));
  let pole=ux_f64_put(out+88,ux_f32(ux_u32(normal+BufferAttribute.data)+4));
  let idx=ux_f64_put(out+96,0.0+ux_u16(indices));
  let second=ux_f64_put(out+104,0.0+ux_u16(indices+2));
  let u=ux_f64_put(out+112,ux_f32(last));
  let v=ux_f64_put(out+120,ux_f32(last+4));
  return out;
}

