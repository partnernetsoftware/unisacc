let packet=0;
let capacity=4096;
let state=4352;
let vertices=4608;
let shader=4864;
if(variant<0 || variant>1) { return 0-1; }
let start=GpuPacket_begin(packet,capacity,1);
if(start<0) { return start; }
let view=GpuPacket_viewport(packet,capacity,0,0,4,4);
if(view<0) { return view; }
let destination=179+77*256+128*65536+173*16777216;
let clear=GpuPacket_clear(packet,capacity,destination);
if(clear<0) { return clear; }
let a=ux_u32_put(state+GpuRenderState.depth,8);
let eq=ux_u32_put(state+GpuRenderState.equationRgb,101);
let ea=ux_u32_put(state+GpuRenderState.equationAlpha,100);
let s=ux_u32_put(state+GpuRenderState.sourceRgb,201);
let d=ux_u32_put(state+GpuRenderState.destinationRgb,201);
let sa=ux_u32_put(state+GpuRenderState.sourceAlpha,201);
let da=ux_u32_put(state+GpuRenderState.destinationAlpha,200);
let factor=GpuBlendMode_apply(state,value,variant);
if(factor<0) { return factor; }
let j=ux_u32_put(state+GpuRenderState.colorMask,15);
let set=GpuPacket_setRenderState(packet,capacity,state);
if(set<0) { return set; }
let alpha=(64.0+47.0*variant)/255.0;
let i=0;
while(i<3) {
  let row=vertices+i*28;
  let x=0.0-1.0+4.0*(i==1);
  let y=0.0-1.0+4.0*(i==2);
  let a=ux_f32_put(row,x);
  let b=ux_f32_put(row+4,y);
  let c=ux_f32_put(row+8,0.0);
  let d=ux_f32_put(row+12,51.0/255.0);
  let e=ux_f32_put(row+16,153.0/255.0);
  let f=ux_f32_put(row+20,102.0/255.0);
  let g=ux_f32_put(row+24,alpha);
  i=i+1;
}
let draw=GpuPacket_draw(packet,capacity,vertices,3,shader);
if(draw<0) { return draw; }
return GpuPacket_submit(packet);
