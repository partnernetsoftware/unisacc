native function bloom_add_probe_read(packet:i64,id:i64,out:i64) i64 {
  let desc=5000;
  let a=ux_u32_put(desc+GpuTargetRead.id,id);
  let b=ux_u32_put(desc+GpuTargetRead.layer,0);
  let c=ux_u32_put(desc+GpuTargetRead.color,0);
  let d=ux_u32_put(desc+GpuTargetRead.x,0);
  let e=ux_u32_put(desc+GpuTargetRead.y,0);
  let f=ux_u32_put(desc+GpuTargetRead.width,4);
  let g=ux_u32_put(desc+GpuTargetRead.height,2);
  let h=ux_u32_put(desc+GpuTargetRead.output,out);
  return GpuTarget_read(packet,4096,desc);
}

let composer=4200;
let owned=4300;
let initialized=EffectComposer_init(composer,2,1,4360,1,4,2);
let offscreen=EffectComposer_screen(composer,0);
let added=EffectComposer_addPass(composer,10,1);
let planned=EffectComposer_plan(composer,4400,4480,1);
if(initialized<0 || offscreen<0 || added<0 || planned!=1) { return 0-1; }
let created=EffectComposerGpu_create(composer,owned,0,4096,5000,1);
if(created!=0) { return created; }
let packet=GpuPacket_begin(0,4096,1);
let alt=GpuTarget_bind(packet,4096,1,0);
let blue=GpuPacket_clear(packet,4096,4294901760);
let bound=GpuTarget_bind(packet,4096,2,0);
let base=GpuPacket_clear(packet,4096,1081626664);
let row=GpuPacket_scissor(packet,4096,1,0,1,4,1);
let br=GpuPacket_clear(packet,4096,4125549020);
if(alt<0 || blue<0 || bound<0 || base<0 || row<0 || br<0) { return 0-2; }
let planted=GpuPacket_submit(packet);
if(planted!=0) { return planted; }
let shader=6200;
let va=ux_u32_put(shader+GpuShaderSource.vertex,10000);
let vb=ux_u32_put(shader+GpuShaderSource.vertexBytes,vn);
let fa=ux_u32_put(shader+GpuShaderSource.fragment,14500);
let fb=ux_u32_put(shader+GpuShaderSource.fragmentBytes,fn);
let rgba=6400;
let first=ux_u32_put(rgba,1321084);
let second=ux_u32_put(rgba+4,2149863588);
let draw=6500;
let a=ux_u32_put(draw+BloomAdditiveDraw.step,4480);
let b=ux_u32_put(draw+BloomAdditiveDraw.rgba,rgba);
let c=ux_u32_put(draw+BloomAdditiveDraw.width,2);
let d=ux_u32_put(draw+BloomAdditiveDraw.height,1);
let e=ux_u32_put(draw+BloomAdditiveDraw.destinationWidth,4);
let f=ux_u32_put(draw+BloomAdditiveDraw.destinationHeight,2);
let g=ux_u32_put(draw+BloomAdditiveDraw.shader,shader);
let small=GpuPacket_begin(5400,320,1);
let short=UnrealBloom_gpuAdd(small,320,draw,6700);
if(short!=0-1 || ux_u32(small+GpuPacket.bytes)!=GpuPacket.size || ux_u32(small+GpuPacket.commands)!=0) { return 0-3; }
packet=GpuPacket_begin(0,4096,1);
let rendered=UnrealBloom_gpuAdd(packet,4096,draw,6700);
if(rendered<0) { return rendered; }
if(mutate==1) {
  let blend=GpuPacket.size+16+24+28+8;
  let rgb=ux_u32_put(blend+GpuRenderState.sourceRgb,201);
  let alpha=ux_u32_put(blend+GpuRenderState.sourceAlpha,201);
}
let sampled=bloom_add_probe_read(packet,2,7000);
let preserved=bloom_add_probe_read(packet,1,7200);
if(sampled<0 || preserved<0) { return 0-4; }
let submitted=GpuPacket_submit(packet);
if(submitted!=0) { return submitted; }
if(EffectComposer_commit(composer,4400)<0 || ux_u32(composer+EffectComposer.read)!=2) { return 0-5; }
return EffectComposerGpu_release(owned,0,4096,0);
