native function native_sample_probe_read(packet:i64,id:i64,output:i64) i64 {
  let desc=5000;
  let a=ux_u32_put(desc+GpuTargetRead.id,id);
  let b=ux_u32_put(desc+GpuTargetRead.layer,0);
  let c=ux_u32_put(desc+GpuTargetRead.color,0);
  let d=ux_u32_put(desc+GpuTargetRead.x,0);
  let e=ux_u32_put(desc+GpuTargetRead.y,0);
  let f=ux_u32_put(desc+GpuTargetRead.width,4);
  let g=ux_u32_put(desc+GpuTargetRead.height,4);
  let h=ux_u32_put(desc+GpuTargetRead.output,output);
  return GpuTarget_read(packet,2048,desc);
}

if(mode==2) {
  let packet=GpuPacket_begin(0,2048,1);
  let first=native_sample_probe_read(packet,2,6000);
  let second=native_sample_probe_read(packet,1,6100);
  if(first<0 || second<0) { return 0-1; }
  return GpuPacket_submit(packet);
}
let composer=4200;
let ownership=4300;
let initialized=EffectComposer_init(composer,2,1,4360,2,4,4);
if(initialized<0) { return initialized; }
let created=EffectComposerGpu_create(composer,ownership,0,2048,5000,1);
if(created!=0) { return created; }
let packet=GpuPacket_begin(0,2048,1);
let desc=5000;
let a=ux_u32_put(desc+GpuTarget.kind,0);
let b=ux_u32_put(desc+GpuTarget.id,3);
let c=ux_u32_put(desc+GpuTarget.width,4);
let d=ux_u32_put(desc+GpuTarget.height,4);
let e=ux_u32_put(desc+GpuTarget.layers,1);
let f=ux_u32_put(desc+GpuTarget.colors,1);
let h=ux_u32_put(desc+GpuTarget.depth,0);
let spare=GpuTarget_create(packet,2048,desc);
let spareBind=GpuTarget_bind(packet,2048,3,0);
let magenta=GpuPacket_clear(packet,2048,4294902015);
let source=GpuTarget_bind(packet,2048,2,0);
let lower=GpuPacket_clear(packet,2048,1614807104);
let half=GpuPacket_scissor(packet,2048,1,0,2,4,2);
let upper=GpuPacket_clear(packet,2048,3248529440);
let clip=GpuPacket_scissor(packet,2048,1,3,3,1,1);
let view=GpuPacket_viewport(packet,2048,1,1,2,2);
let submitted=GpuPacket_submit(packet);
if(spare<0 || spareBind<0 || magenta<0 || source<0 || lower<0 || half<0 ||
   upper<0 || clip<0 || view<0 || submitted!=0) { return 0-2; }
let addFirst=EffectComposer_addPass(composer,10,3);
let addSecond=EffectComposer_addPass(composer,20,3);
let count=EffectComposer_plan(composer,4400,4480,2);
if(addFirst<0 || addSecond<0 || count!=2) { return 0-3; }
let shader=native_copy_fixture_shader(6300);
let pair=NativeTargetCopy_step(4480,1,shader);
if(pair!=0) { return pair; }
let secondStep=4480+ComposerStep.size;
if(mode==1) { let altered=ux_u32_put(secondStep+ComposerStep.read,3); }
let screen=NativeTargetCopy_step(secondStep,1,shader);
if(screen!=0) { return screen; }
let alias=host_gpu_native_copy(1,2,2,shader);
let missing=host_gpu_native_copy(1,77,0,shader);
let old=host_gpu_native_copy(2,2,0,shader);
let saveAlias=ux_u32_put(6200,100+alias);
let saveMissing=ux_u32_put(6204,100+missing);
let saveOld=ux_u32_put(6208,100+old);
let badRecord=host_gpu_native_copy(1,2,0,6291444);
let fragment=ux_u32(shader+GpuShaderSource.fragment);
let out=ux_u32_put(shader+GpuShaderSource.fragment,6291455);
let badBridge=host_gpu_native_copy(1,2,0,shader);
let badBase=NativeTargetCopy_step(secondStep,1,shader);
let fixed=ux_u32_put(shader+GpuShaderSource.fragment,fragment);
let original=ux_u8(fragment);
let invalid=ux_u8_put(fragment,88);
let badGlsl=NativeTargetCopy_step(secondStep,1,shader);
let restored=ux_u8_put(fragment,original);
let saveRecord=ux_u32_put(6212,100+badRecord);
let saveBridge=ux_u32_put(6216,100+badBridge);
let saveBase=ux_u32_put(6220,100+badBase);
let saveGlsl=ux_u32_put(6224,100+badGlsl);
let commit=EffectComposer_commit(composer,4400);
if(commit<0) { return commit; }
return 0;
