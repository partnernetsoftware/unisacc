native function bloom_screen_target(packet:i64,id:i64,width:i64,height:i64) i64 {
  let desc=5000;
  let a=ux_u32_put(desc+GpuTarget.kind,0);
  let b=ux_u32_put(desc+GpuTarget.id,id);
  let c=ux_u32_put(desc+GpuTarget.width,width);
  let d=ux_u32_put(desc+GpuTarget.height,height);
  let e=ux_u32_put(desc+GpuTarget.layers,1);
  let f=ux_u32_put(desc+GpuTarget.colors,1);
  let g=ux_u32_put(desc+GpuTarget.depth,0);
  return GpuTarget_create(packet,4096,desc);
}

native function bloom_screen_read(packet:i64,id:i64,out:i64) i64 {
  let desc=5100;
  let a=ux_u32_put(desc+GpuTargetRead.id,id);
  let b=ux_u32_put(desc+GpuTargetRead.layer,0);
  let c=ux_u32_put(desc+GpuTargetRead.color,0);
  let d=ux_u32_put(desc+GpuTargetRead.x,0);
  let e=ux_u32_put(desc+GpuTargetRead.y,0);
  let f=ux_u32_put(desc+GpuTargetRead.width,4);
  let g=ux_u32_put(desc+GpuTargetRead.height,2);
  let h=ux_u32_put(desc+GpuTargetRead.output,out);
  return GpuTarget_read(packet,4096,desc);
}

native function bloom_screen_sources(shader:i64,vertex:i64,vn:i64,fragment:i64,fn:i64) i64 {
  let a=ux_u32_put(shader+GpuShaderSource.vertex,vertex);
  let b=ux_u32_put(shader+GpuShaderSource.vertexBytes,vn);
  let c=ux_u32_put(shader+GpuShaderSource.fragment,fragment);
  return ux_u32_put(shader+GpuShaderSource.fragmentBytes,fn);
}

let composer=4200;
let ownership=4300;
let initialized=EffectComposer_init(composer,2,1,4360,1,4,2);
let added=EffectComposer_addPass(composer,10,1);
let planned=EffectComposer_plan(composer,4400,4480,1);
if(initialized<0 || added<0 || planned!=1) { return 0-1; }
let created=EffectComposerGpu_create(composer,ownership,0,4096,5000,1);
if(created!=0) { return created; }
let packet=GpuPacket_begin(0,4096,1);
let live=bloom_screen_target(packet,3,2,1);
let screen=GpuTarget_bind(packet,4096,0,0);
let black=GpuPacket_clear(packet,4096,4278190080);
let spare=GpuTarget_bind(packet,4096,1,0);
let blue=GpuPacket_clear(packet,4096,4294901760);
let read=GpuTarget_bind(packet,4096,2,0);
let lower=GpuPacket_clear(packet,4096,1081626664);
let row=GpuPacket_scissor(packet,4096,1,0,1,4,1);
let upper=GpuPacket_clear(packet,4096,4125549020);
let bloom=GpuTarget_bind(packet,4096,3,0);
let left=GpuPacket_scissor(packet,4096,1,0,0,1,1);
let a=GpuPacket_clear(packet,4096,1321084);
let right=GpuPacket_scissor(packet,4096,1,1,0,1,1);
let b=GpuPacket_clear(packet,4096,2149863588);
let restore=GpuTarget_bind(packet,4096,1,0);
let viewport=GpuPacket_viewport(packet,4096,1,0,2,1);
let state=5600;
let words=[8,0,5,101,102,201,200,200,201,0,0,0,255,255,7680,7680,7680,1,1,0,0,0,7];
let i=0;
while(i<23) {
  let put=ux_u32_put(state+i*4,words[i]);
  i=i+1;
}
let setup=GpuPacket_setRenderState(packet,4096,state);
if(live<0 || screen<0 || black<0 || spare<0 || blue<0 || read<0 || lower<0 || row<0 ||
   upper<0 || bloom<0 || left<0 || a<0 || right<0 || b<0 || restore<0 || viewport<0 || setup<0) { return 0-2; }
let planted=GpuPacket_submit(packet);
if(planted!=0) { return planted; }
let src=6300;
let overlay=6320;
let first=bloom_screen_sources(src,10000,vn,14500,fn);
let second=bloom_screen_sources(overlay,19000,dn,23500,bn);
let alias=UnrealBloom_gpuScreen(4480,2,1,src,overlay);
let feedback=host_gpu_native_add(1,3,3,overlay);
if(alias!=0-1 || feedback!=0-1) { return 0-3; }
let render=0;
if(mutate==0) {
  render=UnrealBloom_gpuScreen(4480,3,1,src,overlay);
} else {
  let tooSoon=host_gpu_native_add(1,3,0,overlay);
  if(tooSoon!=0) { return tooSoon; }
  render=host_gpu_native_copy(1,2,0,src);
}
if(render!=0) { return render; }
if(EffectComposer_commit(composer,4400)<0 || ux_u32(composer+EffectComposer.read)!=2) { return 0-4; }
packet=GpuPacket_begin(0,4096,1);
let saved=bloom_screen_read(packet,2,7000);
let unchanged=bloom_screen_read(packet,1,7200);
if(saved<0 || unchanged<0) { return 0-5; }
let sampled=GpuPacket_submit(packet);
if(sampled!=0) { return sampled; }
return EffectComposerGpu_release(ownership,0,4096,0);
