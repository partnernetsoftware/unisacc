export uxe_frustum_test(node:i64) i64 version 1;

let a=ux_f64_put(0,1.0);
let b=ux_f64_put(40,1.0);
let c=ux_f64_put(80,1.0);
let d=ux_f64_put(120,1.0);
let view=Frustum_setFromProjectionMatrix(128,0,0);
let radius=ux_f64_put(344,0.5);
let world=SceneBounds_readWorld(512,node);
return Frustum_intersectsObject(view,320,world,400);
