native function probe_lit_mesh(caseId:i64) i64 {
  let packet=20000;
  let capacity=44000;
  let opened=GpuPacket_begin(packet,capacity,1);
  let viewport=GpuPacket_viewport(packet,capacity,0,0,16,16);
  let clear=GpuPacket_clear(packet,capacity,4278190080);
  let depth=GpuPacket_clearDepth(packet,capacity,1.0);
  let state=GpuPacket_state(packet,capacity,1,1,0);
  let geo=GeometryBuffers_init(90000,100000,256,120000,1200);
  let count=36;
  let cube=caseId>=2 && caseId!=5;
  if(cube) {
    if(BoxGeometry_generate(geo,0.96,0.96,0.96,1,1,1)<0) { return 0-1; }
  } else {
    count=1056;
    if(SphereGeometry_generate(geo,0.7,16,12,0.0,6.283185307179586,0.0,3.141592653589793)<0) { return 0-1; }
  }
  let i=0;
  let mode=caseId;
  if(caseId==4) { mode=1; }
  if(caseId==5) { mode=2; }
  while(i<count) {
    let src=100000+ux_u32(120000+4*i)*32;
    let x=ux_f32(src);
    let y=ux_f32(src+4);
    let z=ux_f32(src+8);
    let nx=ux_f32(src+12);
    let ny=ux_f32(src+16);
    let nz=ux_f32(src+20);
    if(cube) {
      let px=0.8660254037844386*x+0.5*z;
      z=0.8660254037844386*z-0.5*x;
      x=px;
      let normalX=0.8660254037844386*nx+0.5*nz;
      nz=0.8660254037844386*nz-0.5*nx;
      nx=normalX;
    }
    if(caseId==7) { nx=0.0-nx; }
    if(caseId==9) { z=z*0.5; }
    let dest=150000+28*i;
    let a=ux_f32_put(dest,x);
    let b=ux_f32_put(dest+4,y);
    let c=ux_f32_put(dest+8,z);
    let d=ux_f32_put(dest+12,nx);
    let e=ux_f32_put(dest+16,ny);
    let f=ux_f32_put(dest+20,nz);
    let g=ux_f32_put(dest+24,mode*1.0);
    i=i+1;
  }
  let shader=probe_lit_sources(17000);
  let drawn=GpuPacket_draw(packet,capacity,150000,count,shader);
  if(drawn<0) { return drawn; }
  return GpuPacket_submit(packet);
}
