let arena=Object3D_initArena(0,12);
let root=Object3D_create(arena);
let meshNode=Object3D_create(arena);
let hip=Object3D_create(arena);
let knee=Object3D_create(arena);
let otherNode=Object3D_create(arena);
let add1=Object3D_add(arena,root,meshNode);
let add2=Object3D_add(arena,root,hip);
let add3=Object3D_add(arena,hip,knee);
let add4=Object3D_add(arena,root,otherNode);
let hp=ux_u32(Object3D_address(arena,hip)+Object3D.position);
let hp1=ux_f64_put(hp,4.0);
let kp=ux_u32(Object3D_address(arena,knee)+Object3D.position);
let kp1=ux_f64_put(kp,3.0);
let original=Mesh_init(5200,arena,meshNode,9000,17,0,0);
let originalOther=Mesh_init(5232,arena,otherNode,9000,17,0,0);
let skin=SkinnedMesh_init(5400,original,5504,5632);
let other=SkinnedMesh_init(5432,originalOther,5760,5888);
let sk=Skeleton_init(6100,6120,6144,6400,2);
let b1=ux_u32_put(6120,knee);
let b2=ux_u32_put(6124,hip);
let m1=Matrix4_makeTranslation(6144,0.0-7.0,0.0,0.0);
let m2=Matrix4_makeTranslation(6272,0.0-4.0,0.0,0.0);
let bind=Matrix4_makeScale(6600,2.0,1.0,1.0);
let bound1=SkinnedMesh_bind(skin,sk,bind);
let bound2=SkinnedMesh_bind(other,sk,bind);
let mode=SkinnedMesh_updateBind(skin,0,2);
let tree=Object3D_clone(arena,arena,root,1);
if(tree<0) { return 0.0+tree; }
let copyNode=Object3D_traverseNext(arena,tree,tree,1);
let copyHip=Object3D_traverseNext(arena,tree,copyNode,1);
let copyKnee=Object3D_traverseNext(arena,tree,copyHip,1);
let copyOther=Object3D_traverseNext(arena,tree,copyKnee,1);
let mesh=Mesh_init(5264,arena,copyNode,9100,19,0,0);
let meshOther=Mesh_init(5296,arena,copyOther,9100,19,0,0);
let copy=SkinnedMesh_init(5464,mesh,6752,6880);
let copy2=SkinnedMesh_init(7200,meshOther,7360,7488);
let result=SkeletonUtils_rebindClone(copy,arena,tree,7800,skin,arena,root);
let result2=SkeletonUtils_rebindClone(copy2,arena,tree,8240,other,arena,root);
if(result<0 || result2<0) { return 0.0-99.0; }
let copySk=ux_u32(copy+SkinnedMesh.skeleton);
let otherSk=ux_u32(copy2+SkinnedMesh.skeleton);
let bones=ux_u32(copySk+Skeleton.bones);
let otherBones=ux_u32(otherSk+Skeleton.bones);
let inverses=ux_u32(copySk+Skeleton.inverses);

if(selected_case==12) {
  let outside=Object3D_create(arena);
  let external=ux_u32_put(6120,outside);
  let sentinel=ux_u32_put(9400,127);
  let refused=SkeletonUtils_rebindClone(copy,arena,tree,9400,skin,arena,root);
  return 0.0+(refused<0 && ux_u32(9400)==127 && ux_u32(copy+SkinnedMesh.skeleton)==copySk);
}
if(selected_case==13) {
  let refused=SkeletonUtils_rebindClone(copy,arena,tree,6144,skin,arena,root);
  return 0.0+(refused<0 && ux_f64(6240)==0.0-7.0 && ux_u32(copy+SkinnedMesh.skeleton)==copySk);
}
if(selected_case==14) {
  let wrong=ux_u32_put(bones,knee);
  selected_case=2;
}
if(selected_case==0) { return 0.0+(ux_u32(mesh+Mesh.geometry)==9000 && ux_u32(mesh+Mesh.material)==17); }
if(selected_case==1) { return 0.0+(copySk!=sk && bones!=6120); }
if(selected_case==2) { return 0.0+(ux_u32(bones)==copyKnee && copyKnee!=knee); }
if(selected_case==3) { return 0.0+(ux_u32(bones+4)==copyHip && copyHip!=hip); }
if(selected_case==4) {
  return 0.0+(otherSk!=copySk && ux_u32(otherBones)==copyKnee && ux_u32(otherBones+4)==copyHip);
}
if(selected_case==5) { return ux_f64(ux_u32(copy+SkinnedMesh.bindMatrix)); }
if(selected_case==6) { return ux_f64(ux_u32(copy+SkinnedMesh.bindInverse)); }
if(selected_case==7) { return 0.0+(ux_u32(copy+SkinnedMesh.bindMode)==2); }
if(selected_case==8) { return ux_f64(inverses+96); }
if(selected_case==9 || selected_case==10) {
  let at=Object3D_address(arena,ux_u32(bones));
  let pos=ux_u32(at+Object3D.position);
  let moved=ux_f64_put(pos,9.0);
  if(selected_case==10) { return ux_f64(kp); }
  let up=Object3D_updateMatrixWorld(arena,tree,1);
  let palette=Skeleton_update(copySk,arena,9280);
  return ux_f32(palette+48);
}
if(selected_case==11) {
  let changed=ux_f64_put(inverses+96,19.0);
  let otherInverses=ux_u32(otherSk+Skeleton.inverses);
  return 0.0+(ux_f64(6240)==0.0-7.0 && ux_f64(otherInverses+96)==0.0-7.0 &&
              inverses!=6144 && inverses!=otherInverses);
}
return 0.0/0.0;
