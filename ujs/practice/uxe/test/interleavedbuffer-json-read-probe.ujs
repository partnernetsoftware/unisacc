let input=2048;
let scratch=4032;
let snapshot=4352;
let dst=384+32*id;
let registry=256;
let rows=288;
let meta=640;
if(op==0) { return ux_span(0,4608); }
if(op==1) {
  let a=ux_f32_put(128,1.0);
  let b=ux_f32_put(132,0.0-2.0);
  let c=ux_f32_put(136,3.0);
  let d=ux_f32_put(140,4.0);
  let e=ux_f32_put(144,5.0);
  let f=ux_f32_put(148,6.0);
  let duplicate=BufferAttribute_copyBytes(192,128,24);
  let first=InterleavedBuffer_init(32,128,2,12,9);
  let second=InterleavedBuffer_init(64,140,3,4,9);
  let third=InterleavedBuffer_init(96,192,3,8,9);
  if(InterleavedBuffer_initJSON(registry,rows,2,1024,1152)!=registry ||
     InterleavedBuffer_toJSON(first,registry,meta,101,128,24)!=meta ||
     InterleavedBuffer_toJSON(second,registry,meta+16,102,128,24)!=meta+16 ||
     InterleavedBuffer_toJSON(third,registry,meta+32,103,192,24)!=meta+32) { return 0-1; }
  if(mode!=0) { let broken=ux_u32_put(meta+16+IBJsonMeta.buffer,2); }
  let i=0;
  while(i<3) {
    if(InterleavedBuffer_fromJSON(384+i*32,registry,meta+i*16)!=384+i*32) { return 0-2; }
    i=i+1;
  }
  return 0;
}
if(op==2) {
  let data=ux_u32(dst+InterleavedBuffer.data);
  let count=ux_u32(dst+InterleavedBuffer.count);
  let stride=ux_u32(dst+InterleavedBuffer.stride);
  let a=ux_f64_put(snapshot,0.0+count);
  let b=ux_f64_put(snapshot+8,0.0+stride);
  let c=ux_f64_put(snapshot+16,0.0+ux_u32(dst+InterleavedBuffer.componentType));
  let d=ux_f64_put(snapshot+24,0.0+ux_u32(dst+InterleavedBuffer.usage));
  let e=ux_f64_put(snapshot+32,0.0+ux_u32(dst+InterleavedBuffer.version));
  let f=ux_f64_put(snapshot+40,ux_f32(data));
  let g=ux_f64_put(snapshot+48,ux_f32(data+count*stride-4));
  return snapshot;
}
if(op==3) {
  if(bytes<1 || bytes>1200) { return 0-1; }
  return InterleavedBuffer_readWords(1200+id*64,64,input,input+bytes);
}
if(op==4) {
  if(bytes<1 || bytes>1200) { return 0-1; }
  let data=1200;
  if(id==5) { data=1264; }
  return InterleavedBuffer_readJSON(dst,input,input+bytes,data,24,1900,8,scratch);
}
if(op==5) {
  let first=ux_u32(dst+InterleavedBuffer.data);
  let second=ux_u32(dst+32+InterleavedBuffer.data);
  let third=ux_u32(dst+64+InterleavedBuffer.data);
  let a=ux_f64_put(snapshot,0.0+(first==second));
  let b=ux_f64_put(snapshot+8,0.0+(first!=third));
  let edited=ux_f32_put(first,7.0);
  let c=ux_f64_put(snapshot+16,ux_f32(second));
  let d=ux_f64_put(snapshot+24,ux_f32(third));
  return snapshot;
}
if(op==6) {
  let a=uxe_copy_record(meta+64,meta,IBJsonMeta.size);
  if(id==0) { let changed=ux_u32_put(meta+64+IBJsonMeta.buffer,7); }
  if(id==1) { let changed=ux_u32_put(meta+64+IBJsonMeta.stride,7); }
  if(id==2) { let changed=ux_u32_put(meta+64+IBJsonMeta.componentType,255); }
  if(id==3) { let changed=ux_u32_put(rows+IBJsonBacking.words,1200); }
  if(id==4) { return InterleavedBuffer_fromJSON(rows,registry,meta+64); }
  return InterleavedBuffer_fromJSON(768,registry,meta+64);
}
if(op==7) {
  if(bytes<1 || bytes>1200) { return 0-1; }
  let capacity=16;
  if(id==5) { capacity=4; }
  return InterleavedBuffer_readWords(1400,capacity,input,input+bytes);
}
if(op==8) {
  let a=ux_u32_put(snapshot,ux_u32(dst+InterleavedBuffer.count));
  let b=ux_u32_put(snapshot+4,ux_u32(dst+InterleavedBuffer.stride));
  let c=ux_u32_put(snapshot+8,ux_u32(dst+InterleavedBuffer.componentType));
  return snapshot;
}
return 0-1;
