import uxe_light_dispatch from "uxe_light_object_v1"(i64,i64,i64) i64;
import uxe_light_json_dispatch from "uxe_light_codec_v1"(i64,i64,i64) i64;
export uxe_light_probe(side:i64,op:i64,a:i64,b:i64) i64 version 1;

if(side==0) { return uxe_light_dispatch(op,a,b); }
if(side==1) { return uxe_light_json_dispatch(op,a,b); }
return 0-1;
