import uxe_jpeg_gray_dispatch from "uxe_jpeg_gray_v1"(i64,i64,i64) i64;
export uxe_evaluate_case(selected_case:i64) f64 version 1;

if(uxe_jpeg_gray_dispatch(0,0,0)!=1) { return 0.0/0.0; }
if(selected_case==33) { return 0.0+uxe_jpeg_gray_dispatch(3,1,1); }
if(selected_case==75) { return 0.0+uxe_jpeg_gray_dispatch(3,11,2); }
if(selected_case<0 || selected_case>=13) { return 0.0/0.0; }
return 0.0+uxe_jpeg_gray_dispatch(3,selected_case,0);
