if(mode==9) { return ux_span(0,16384); }
let arena=Object3D_initArena(0,10);
let root=Object3D_create(arena);
let lod=0;
let i=0;
while(i<8) {
  let node=Object3D_create(arena);
  if(i!=6) { let attached=Object3D_add(arena,root,node); }
  let object=Object3D_address(arena,node);
  let world=ux_u32(object+Object3D.worldMatrix);
  let depth=1+i;
  if(i==6) { depth=6; }
  let z=ux_f64_put(world+112,-1.0*depth);
  let id=ux_u32_put(4800+i*8,node);
  let ptr=ux_u32_put(4804+i*8,world);
  if(i==5) { lod=LOD_init(5000,arena,node,5104,1); }
  if(i==6) { let level=LOD_addLevel(lod,arena,node,0.0,0.0); }
  i=i+1;
}
let picked=LOD_raycastSceneRow(5312,1,arena,lod,4900);
if(picked!=1) { return 0-7; }
let rows=Scene_snapshot(arena,root,4600,10,0);
let count=ux_u32_put(4950,rows);
return rows;
