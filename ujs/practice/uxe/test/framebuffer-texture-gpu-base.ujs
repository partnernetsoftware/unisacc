native function framebuffer_probe_source(work:i64,rgba:i64,space:i64) i64 {
  let a=ux_u32_put(work+FramebufferGpuWork.rgba,rgba);
  let b=ux_u32_put(work+FramebufferGpuWork.rgbaCapacity,space);
  let c=ux_u32_put(work+FramebufferGpuWork.packetCapacity,256);
  return work;
}

native function framebuffer_probe_paint(target:i64,phase:i64) i64 {
  let packet=4096;
  let capacity=4096;
  let begun=GpuPacket_begin(packet,capacity,1);
  let bound=RenderTarget_bind(target,packet,capacity);
  if(bound<0) { return bound; }
  let y=0;
  while(y<3) {
    let x=0;
    while(x<4) {
      let red=10*(1+x+4*y)+80*phase;
      let green=20+10*y;
      let blue=30+10*x;
      let clip=GpuPacket_scissor(packet,capacity,1,x,y,1,1);
      let pixel=GpuPacket_clear(packet,capacity,4278190080+65536*blue+256*green+red);
      x=x+1;
    }
    y=y+1;
  }
  let full=GpuPacket_scissor(packet,capacity,0,0,0,4,3);
  return GpuPacket_submit(packet);
}

native function framebuffer_probe_draw(texture:i64,target:i64) i64 {
  let packet=4096;
  let capacity=4096;
  let begun=GpuPacket_begin(packet,capacity,1);
  let bound=RenderTarget_bind(target,packet,capacity);
  if(bound<0) { return bound; }
  let rendered=FramebufferTexture_gpuDraw(texture,packet,capacity,2048,3,1000);
  if(rendered<0) { return rendered; }
  let read=944;
  let a=ux_u32_put(read+GpuTargetRead.id,ux_u32(target+RenderTarget.id));
  let b=ux_u32_put(read+GpuTargetRead.layer,0);
  let c=ux_u32_put(read+GpuTargetRead.color,0);
  let d=ux_u32_put(read+GpuTargetRead.x,0);
  let e=ux_u32_put(read+GpuTargetRead.y,0);
  let f=ux_u32_put(read+GpuTargetRead.width,2);
  let g=ux_u32_put(read+GpuTargetRead.height,2);
  let h=ux_u32_put(read+GpuTargetRead.output,8320);
  let captured=GpuTarget_read(packet,capacity,read);
  if(captured<0) { return captured; }
  return GpuPacket_submit(packet);
}

let source=128;
let target=208;
let primary=288;
let secondary=320;
let table=384;
let work=512;
if(op==0) { return ux_span(0,16384); }
if(op==1) {
  let srcdesc=RenderTarget_prepareDescriptor(896,1,4,3,0);
  let src=RenderTarget_create(source,4096,4096,srcdesc,1);
  if(src!=0) { return src; }
  let dstdesc=RenderTarget_prepareDescriptor(896,2,2,2,0);
  let dst=RenderTarget_create(target,4096,4096,dstdesc,1);
  if(dst!=0) { return dst; }
  let unknown=uxe_copy_record(2240,source,RenderTarget.size);
  let absent=ux_u32_put(2240+RenderTarget.id,99);
  return GpuTextureTable_init(table,1);
}
if(op==2) { return framebuffer_probe_paint(source,a); }
if(op==3) {
  let stage=framebuffer_probe_source(work,8192,16);
  return FramebufferTexture_gpuCapture(primary,table,source,stage,a,1,2,2);
}
if(op==4) {
  if(a==0) { return framebuffer_probe_draw(primary,target); }
  return framebuffer_probe_draw(secondary,target);
}
if(op==5) {
  let stage=framebuffer_probe_source(work,8256,16);
  if(b==1) { stage=framebuffer_probe_source(work,8192,16); }
  if(b==2) { return FramebufferTexture_gpuUpdate(primary,2240,stage,1,1,a); }
  if(b==3) { return FramebufferTexture_gpuUpdate(primary,source,stage,3,1,a); }
  if(b==4) { stage=framebuffer_probe_source(work,8256,8); }
  if(b==5) { stage=framebuffer_probe_source(work,source,16); }
  return FramebufferTexture_gpuUpdate(primary,source,stage,1,1,a);
}
if(op==6) {
  if(a==0) { return FramebufferTexture_gpuVersion(primary); }
  return FramebufferTexture_gpuVersion(secondary);
}
if(op==7) {
  if(a==0) { return FramebufferTexture_gpuDispose(primary); }
  return FramebufferTexture_gpuDispose(secondary);
}
if(op==8) { return GpuTextureTable_version(table,a); }
if(op==9) {
  if(a==0) { return ux_u32(primary+FramebufferGpuTexture.width); }
  if(a==1) { return ux_u32(primary+FramebufferGpuTexture.height); }
  if(a==2) { return ux_u32(primary+FramebufferGpuTexture.handle); }
  if(a==3) { return ux_u32(table+GpuTextureTable.live); }
  if(a==4) { return ux_u32(table+GpuTextureTable.peak); }
  let slot=gpu_texture_source(table,ux_u32(primary+FramebufferGpuTexture.handle));
  if(slot<0) { return slot; }
  return ux_u32(slot+GpuTextureSource.filter);
}
if(op==10) {
  let stage=framebuffer_probe_source(work,8384,16);
  return FramebufferTexture_gpuCapture(secondary,table,source,stage,1,1,2,2);
}
if(op==11) {
  if(a==0) { return RenderTarget_dispose(source,4096,4096,0); }
  return RenderTarget_dispose(target,4096,4096,0);
}
if(op==12) {
  let first=FramebufferGpuObject_init(2304,primary,2,2);
  let other=FramebufferGpuObject_init(2368,2432,1,1);
  let clone=FramebufferGpuObject_clone(2336,2304);
  let copied=FramebufferGpuObject_copy(2368,2304);
  return first==2304 && other==2368 && clone==2336 && copied==2368 &&
    FramebufferGpuObject_source(2304)==primary && FramebufferGpuObject_source(2336)==primary &&
    FramebufferGpuObject_source(2368)==primary;
}
if(op==13) {
  if(a==0) { return ux_u32(primary+FramebufferGpuShared.users); }
  if(a==1) { return ux_u32(2432+FramebufferGpuShared.users); }
  return ux_u32(2304+32*(a-2)+FramebufferGpuObject.version);
}
if(op==14) { return framebuffer_probe_draw(FramebufferGpuObject_source(2304+32*a),target); }
if(op==15) { return FramebufferGpuObject_dispose(2304+32*a); }
return 0-1;
