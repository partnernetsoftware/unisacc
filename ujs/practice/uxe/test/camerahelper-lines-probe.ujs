let vertices=8192;
let draw=9752;
let stream=9832;
let world=9920;
let projection=10048;
let inv=10176;
let helper=10304;
let shader=10500;
let positions=12000;
let colors=12640;

let i=0;
while(i<4) {
  let a=ux_f64_put(world+i*40,1.0);
  i=i+1;
}
let a=ux_f64_put(world+96,0.0625);
let b=ux_f64_put(world+104,0.0625);
let c=ux_f64_put(inv,0.75);
let d=ux_f64_put(inv+40,0.5);
let e=ux_f64_put(inv+80,0.0-1.0);
let f=ux_f64_put(inv+112,0.0-2.0);
let g=ux_f64_put(inv+120,1.0);

let p0=ux_f64_put(projection,0.5);
let p1=ux_f64_put(projection+40,0.5);
let p2=ux_f64_put(projection+64,0.0-0.125);
let p3=ux_f64_put(projection+80,0.125);
let p4=ux_f64_put(projection+120,1.0);
let made=CameraHelper_init(helper,positions,colors,world,inv);
if(made<0) { return 0-11; }
let bound=CameraHelper_bindLineStream(helper,draw,stream,projection);
if(bound<0) { return 0-12; }
if(mode==1) { let shift=ux_f64_put(world+96,0.3125); }
let authored=SceneLine_projectPacked(draw,stream,vertices,50);
let expected=0.0-0.21875;
if(mode==1) { expected=0.0-0.09375; }
if(authored!=50 || ux_f32(vertices)!=expected || ux_f32(vertices+4)!=(0.0-0.21875)) { return 0-13; }

let packet=GpuPacket_begin(0,8192,1);
let viewport=GpuPacket_viewport(packet,8192,0,0,32,32);
let clear=GpuPacket_clear(packet,8192,4278190080);
let drawn=SceneDraw_gpuLines(packet,8192,draw,stream,vertices,50,shader);
if(drawn<0 || ux_u32(packet+GpuPacket.commands)!=3) { return 0-14; }
let gone=CameraHelper_dispose(helper);
let marker=ux_u32_put(stream+SceneLineStream.vertexCount,77);
let refused=CameraHelper_bindLineStream(helper,draw,stream,projection);
if(gone!=0 || refused>=0 || ux_u32(stream+SceneLineStream.vertexCount)!=77) { return 0-15; }
return GpuPacket_submit(packet);
