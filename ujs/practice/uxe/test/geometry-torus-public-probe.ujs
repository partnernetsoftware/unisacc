native function torus_probe_values(at:i64,out:i64) i64 {
  let geo=GeometryPrimitive_geometry(at);
  let pos=BufferGeometry_getAttribute(geo,1);
  let normal=BufferGeometry_getAttribute(geo,2);
  let uv=BufferGeometry_getAttribute(geo,4);
  let index=BufferGeometry_getIndex(geo);
  let count=ux_u32(pos+BufferAttribute.count);
  let data=ux_u32(pos+BufferAttribute.data);
  let last=data+12*(count-1);
  let lastUv=ux_u32(uv+BufferAttribute.data)+8*(count-1);
  let columns=f64_floor_i64(ux_f64(at+GeometryPrimitiveRecord.fourth))+1;
  let a=ux_f64_put(out,0.0+count);
  let b=ux_f64_put(out+8,0.0+ux_u32(index+BufferAttribute.count));
  let i=0;
  while(i<5) {
    let p=ux_f64_put(out+16+i*8,ux_f64(at+GeometryPrimitiveRecord.first+i*8));
    i=i+1;
  }
  let x=ux_f64_put(out+56,ux_f32(data));
  let nx=ux_f64_put(out+64,ux_f32(ux_u32(normal+BufferAttribute.data)));
  let z=ux_f64_put(out+72,ux_f32(data+columns*12+8));
  let endX=ux_f64_put(out+80,ux_f32(last));
  let endY=ux_f64_put(out+88,ux_f32(last+4));
  let u=ux_f64_put(out+96,ux_f32(lastUv));
  let v=ux_f64_put(out+104,ux_f32(lastUv+4));
  let idx=ux_f64_put(out+112,0.0+ux_u16(ux_u32(index+BufferAttribute.data)));
  return out;
}

if(mode==0) { return ux_span(0,100000); }
let i=0;
while(i<4) {
  let at=128+i*160;
  let attrs=1024+i*128;
  let geo=BufferGeometry_init(GeometryPrimitive_geometry(at),attrs,3,attrs+64,0);
  let registry=EventDispatcher_init(geo,attrs+80,3);
  if(geo<0 || registry!=geo) { return 0-101; }
  i=i+1;
}
let raw=GeometryBuffers_init(1800,8192,700,32000,3600);
let params=1920;
let p0=ux_f64_put(params+TorusGeometryParameters.radius,3.0);
let p1=ux_f64_put(params+TorusGeometryParameters.tube,1.25+mutate);
let p2=ux_f64_put(params+TorusGeometryParameters.radialSegments,4.5);
let p3=ux_f64_put(params+TorusGeometryParameters.tubularSegments,3.5);
let p4=ux_f64_put(params+TorusGeometryParameters.arc,1.5);
let created=TorusGeometry_create(128,raw,49152,4096,params);
let named=GeometryPrimitive_setName(128,6016,8);
if(raw!=1800 || created!=128 || named!=128) { return 0-102; }
let short=TorusGeometry_toJSON(128,4096,4100,6000,7,2048);
let end=TorusGeometry_toJSON(128,4096,5600,6000,7,2048);
if(end<4096) { return 0-103; }
let broken=TorusGeometry_fromJSON(288,raw,53248,4096,4096,end-1,2048);
let alias=TorusGeometry_fromJSON(288,raw,53248,4096,4096,end,4096);
let bad=TorusGeometry_fromJSON(288,raw,53248,4096,5760,5774,2048);
let zero=TorusGeometry_fromJSON(288,raw,53248,4096,5824,5844,2048);
let rejected=ux_f64_put(6160,0.0+(short==0-1 && broken==0-1 && alias==0-1 &&
  bad==0-1 && zero==0-1 && ux_u32(288+GeometryPrimitiveRecord.kind)==0));
let loaded=TorusGeometry_fromJSON(288,raw,53248,4096,4096,end,2048);
let defaults=TorusGeometry_fromJSON(448,raw,65536,32768,5800,5802,2048);
if(loaded!=288 || defaults!=448) { return 0-104; }
let source=torus_probe_values(128,6400);
let restored=torus_probe_values(288,6176);
let fallback=torus_probe_values(448,6656);
let equal=1;
i=0;
while(i<15) {
  let delta=ux_f64(6176+i*8)-ux_f64(6400+i*8);
  if(delta<0.0-0.000000001 || delta>0.000000001) { equal=0; }
  i=i+1;
}
let same=ux_f64_put(6168,0.0+equal);
let defaultCount=ux_f64_put(6296,ux_f64(6656));
let defaultIndices=ux_f64_put(6304,ux_f64(6664));

let s=GeometryPrimitive_geometry(128);
let d=GeometryPrimitive_geometry(288);
let c=GeometryPrimitive_geometry(608);
let listen1=EventDispatcher_addListener(s,7,41);
let listen2=EventDispatcher_addListener(s,7,82);
let listen3=EventDispatcher_addListener(d,7,61);
let copied=TorusGeometry_copy(288,128,57344,4096);
let cloned=TorusGeometry_clone(608,128,61440,4096);
let occupied=TorusGeometry_clone(288,128,61440,4096);
if(copied!=288 || cloned!=608 || occupied!=0-1) { return 0-105; }
let spos=ux_u32(BufferGeometry_getAttribute(s,1)+BufferAttribute.data);
let dpos=ux_u32(BufferGeometry_getAttribute(d,1)+BufferAttribute.data);
let cpos=ux_u32(BufferGeometry_getAttribute(c,1)+BufferAttribute.data);
let changeFirst=ux_f32_put(spos,9.0);
let changeLast=ux_f32_put(spos+19*12,8.0);
let changeArc=ux_f64_put(128+GeometryPrimitiveRecord.fifth,3.0);
let changeTube=ux_f64_put(128+GeometryPrimitiveRecord.second,7.0);
let own=ux_f64_put(6312,0.0+(spos!=dpos && spos!=cpos && dpos!=cpos));
let arc=ux_f64_put(6320,ux_f64(608+GeometryPrimitiveRecord.fifth));
let tube=ux_f64_put(6328,ux_f64(288+GeometryPrimitiveRecord.second));
let lastX=ux_f64_put(6336,ux_f32(dpos+19*12));
let firstX=ux_f64_put(6344,ux_f32(cpos));
let sentinel=ux_u32_put(3488,99);
let limited=TorusGeometry_dispose(128,7,3488,1);
let guard=ux_f64_put(6352,0.0+(limited==0-2 && ux_u32(3488)==99));
let first=TorusGeometry_dispose(128,7,3488,3);
let trace=ux_f64_put(6360,0.0+ux_u32(3496)*100+ux_u32(3500));
let target=ux_f64_put(6368,0.0+(first==2 && ux_u32(3488)==128));
let removed=EventDispatcher_removeListener(s,7,82);
let next=TorusGeometry_dispose(128,7,3488,3);
let other=ux_f64_put(6376,0.0+(next==1)*ux_u32(3496));
let td=TorusGeometry_dispose(288,7,3488,3);
let dest=ux_f64_put(6384,0.0+(td==1 && ux_u32(3488)==288)*ux_u32(3496));
let tc=TorusGeometry_dispose(608,7,3488,3);
let none=ux_f64_put(6392,0.0+tc);
return end-4096;
