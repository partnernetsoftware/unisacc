native function line_probe_geometry(kind:i64) i64 {
  let first=ux_f32_put(608,0.25);
  let second=ux_f32_put(620,0.5);
  let helper=0-1;
  if(kind==1) { helper=GridHelper_init(256,1024,2048,16,608,8.0,2); }
  else if(kind==2) { helper=PolarGridHelper_init(256,1024,2048,608,4.0,4,1,4); }
  else if(kind==3) { helper=AxesHelper_init(256,1024,2048,3.0); }
  if(helper!=256) { return 0-101; }
  let names=HelperGridGeometry_names(848);
  let a=ux_u32_put(904+GeometryJsonIdentity.uuid,944);
  let b=ux_u32_put(904+GeometryJsonIdentity.uuidBytes,6);
  let c=ux_u32_put(904+GeometryJsonIdentity.names,names);
  let d=ux_u32_put(904+GeometryJsonIdentity.nameCount,2);
  let geo=BufferGeometry_init(640,688,2,720,0);
  return HelperGridGeometry_toJSON(helper,kind,geo,768,30000,39000,904,3192);
}
