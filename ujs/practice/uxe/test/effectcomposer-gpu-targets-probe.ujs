native function composer_gpu_probe_target(packet:i64,descriptor:i64,id:i64) i64 {
  let a=ux_u32_put(descriptor+GpuTarget.kind,0);
  let b=ux_u32_put(descriptor+GpuTarget.id,id);
  let c=ux_u32_put(descriptor+GpuTarget.width,4);
  let d=ux_u32_put(descriptor+GpuTarget.height,4);
  let e=ux_u32_put(descriptor+GpuTarget.layers,1);
  let f=ux_u32_put(descriptor+GpuTarget.colors,1);
  let g=ux_u32_put(descriptor+GpuTarget.depth,1);
  return GpuTarget_create(packet,2048,descriptor);
}

native function composer_gpu_probe_read(packet:i64,descriptor:i64,id:i64,out:i64) i64 {
  let a=ux_u32_put(descriptor+GpuTargetRead.id,id);
  let b=ux_u32_put(descriptor+GpuTargetRead.layer,0);
  let c=ux_u32_put(descriptor+GpuTargetRead.color,0);
  let d=ux_u32_put(descriptor+GpuTargetRead.x,0);
  let e=ux_u32_put(descriptor+GpuTargetRead.y,0);
  let f=ux_u32_put(descriptor+GpuTargetRead.width,1);
  let g=ux_u32_put(descriptor+GpuTargetRead.height,1);
  let h=ux_u32_put(descriptor+GpuTargetRead.output,out);
  return GpuTarget_read(packet,2048,descriptor);
}

let packet=0;
let descriptor=3000;
let composer=3200;
let ownership=3300;
if(mode==1 || mode==2) {
  let begin=GpuPacket_begin(packet,2048,1);
  let bound=GpuTarget_bind(packet,2048,mode,0);
  return GpuPacket_submit(packet);
}
if(mode!=4) {
  let initialized=EffectComposer_init(composer,2,1,3400,1,4,4);
  if(initialized<0) { return initialized; }
}
if(mode==3 || mode==4) {
  let owned=EffectComposerGpu_create(composer,ownership,packet,2048,descriptor,1);
  if(owned!=0) { return owned; }
  return EffectComposerGpu_release(ownership,packet,2048,0);
}

let begin=GpuPacket_begin(packet,2048,1);
let outer= composer_gpu_probe_target(packet,descriptor,3);
let outerBound=GpuTarget_bind(packet,2048,3,0);
let magenta=GpuPacket_clear(packet,2048,4294902015);
let ready=GpuPacket_submit(packet);
if(ready!=0) { return ready; }
let created=EffectComposerGpu_create(composer,ownership,packet,2048,descriptor,1);
if(created!=0) { return created; }
begin=GpuPacket_begin(packet,2048,1);
let read=EffectComposerGpu_bindBuffer(composer,ownership,packet,2048,0);
let green=GpuPacket_clear(packet,2048,4278255360);
let write=EffectComposerGpu_bindBuffer(composer,ownership,packet,2048,1);
let blue=GpuPacket_clear(packet,2048,4294901760);
if(read<0 || write<0) { return 0-1; }
let painted=GpuPacket_submit(packet);
if(painted!=0) { return painted; }
let swap=EffectComposer_addPass(composer,1,3);
let planned=EffectComposer_plan(composer,3500,3600,1);
let committed=EffectComposer_commit(composer,3500);
if(swap<0 || planned!=1 || committed<0) { return 0-1; }
begin=GpuPacket_begin(packet,2048,1);
let role=0;
if(mode==5) { role=1; }
let moved=EffectComposerGpu_bindBuffer(composer,ownership,packet,2048,role);
if(moved<0) { return moved; }
let red=GpuPacket_clear(packet,2048,4278190335);
let sampledRead=composer_gpu_probe_read(packet,descriptor,ux_u32(composer+EffectComposer.read),4000);
let sampledWrite=composer_gpu_probe_read(packet,descriptor,ux_u32(composer+EffectComposer.write),4004);
let sampledOuter=composer_gpu_probe_read(packet,descriptor,3,4008);
let sampled=GpuPacket_submit(packet);
if(sampled!=0) { return sampled; }
let released=EffectComposerGpu_release(ownership,packet,2048,3);
if(released!=0) { return released; }
return EffectComposerGpu_release(ownership,packet,2048,3);
