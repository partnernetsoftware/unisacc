native function exec_native_probe_shader(shader:i64,source:i64,vn:i64,fn:i64) i64 {
  let a=ux_u32_put(shader+GpuShaderSource.vertex,10000);
  let b=ux_u32_put(shader+GpuShaderSource.vertexBytes,vn);
  let c=ux_u32_put(shader+GpuShaderSource.fragment,source);
  return ux_u32_put(shader+GpuShaderSource.fragmentBytes,fn);
}

native function exec_native_probe_read(packet:i64,id:i64,out:i64) i64 {
  let read=5000;
  let a=ux_u32_put(read+GpuTargetRead.id,id);
  let b=ux_u32_put(read+GpuTargetRead.layer,0);
  let c=ux_u32_put(read+GpuTargetRead.color,0);
  let d=ux_u32_put(read+GpuTargetRead.x,0);
  let e=ux_u32_put(read+GpuTargetRead.y,0);
  let f=ux_u32_put(read+GpuTargetRead.width,3);
  let g=ux_u32_put(read+GpuTargetRead.height,2);
  let h=ux_u32_put(read+GpuTargetRead.output,out);
  return GpuTarget_read(packet,4096,read);
}

let composer=4200;
let ownership=4300;
let initialized=EffectComposer_init(composer,2,1,4352,2,3,2);
let screen=EffectComposer_screen(composer,mode);
let color=EffectComposer_addPass(composer,50,3);
let present=EffectComposer_addPass(composer,20,3);
if(initialized<0 || screen<0 || color<0 || present<0) { return 0-1; }
let owned=EffectComposerGpu_create(composer,ownership,0,4096,5000,1);
if(owned!=0) { return owned; }
let packet=GpuPacket_begin(0,4096,1);
let bound=EffectComposerGpu_bindBuffer(composer,ownership,packet,4096,0);
let clip=GpuPacket_scissor(packet,4096,0,0,0,0,0);
let fill=GpuPacket_clear(packet,4096,637501504);
let top=GpuPacket_scissor(packet,4096,1,0,1,3,1);
let paint=GpuPacket_clear(packet,4096,688914688);
if(bound<0 || clip<0 || fill<0 || top<0 || paint<0) { return 0-2; }
let ready=GpuPacket_submit(packet);
if(ready!=0) { return ready; }

let bindings=4800;
let following=bindings+ComposerNativeBinding.size;
let a=exec_native_probe_shader(6300,14500,vn,fn);
let b=exec_native_probe_shader(6320,19000,vn,cn);
let x=ux_u32_put(bindings+ComposerNativeBinding.id,21);
let y=ux_u32_put(bindings+ComposerNativeBinding.shader,6320);
let z=ux_u32_put(following+ComposerNativeBinding.id,50);
let w=ux_u32_put(following+ComposerNativeBinding.shader,6300);
let epoch=ux_u32(composer+EffectComposer.epoch);
let missing=EffectComposerGpu_runNative(composer,4400,4480,2,bindings,2,1);
x=ux_u32_put(bindings+ComposerNativeBinding.id,20);
let badPlan=EffectComposerGpu_runNative(composer,bindings,4480,2,bindings,2,1);
let old=ux_u8(19000);
let badText=ux_u8_put(19000,88);
let badShader=EffectComposerGpu_runNative(composer,4400,4480,2,bindings,2,1);
let fixed=ux_u8_put(19000,old);
if(missing!=0-1 || badPlan!=0-1 || badShader!=0-14 ||
   ux_u32(composer+EffectComposer.epoch)!=epoch || ux_u32(composer+EffectComposer.read)!=2) { return 0-3; }

if(mutate==1) {
  y=ux_u32_put(bindings+ComposerNativeBinding.shader,6300);
  w=ux_u32_put(following+ComposerNativeBinding.shader,6320);
}
let dispatched=EffectComposerGpu_runNative(composer,4400,4480,2,bindings,2,1);
if(dispatched!=2 || ux_u32(composer+EffectComposer.epoch)!=epoch+1 ||
   ux_u32(composer+EffectComposer.read)!=2 || ux_u32(composer+EffectComposer.write)!=1) { return 0-4; }
packet=GpuPacket_begin(0,4096,1);
let middle=exec_native_probe_read(packet,1,7000);
let source=exec_native_probe_read(packet,2,7200);
if(middle<0 || source<0) { return 0-5; }
let read=GpuPacket_submit(packet);
if(read!=0) { return read; }
return EffectComposerGpu_release(ownership,0,4096,0);
