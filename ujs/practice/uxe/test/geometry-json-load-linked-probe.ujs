import uxe_geometry_json_dispatch from "uxe_geometry_json_v1"(i64,i64,i64) f64;
export uxe_evaluate_case(selected_case:i64) f64 version 1;

if(uxe_geometry_json_dispatch(0,0,0)!=1.0) { return 0.0/0.0; }
// Selector 33 substitutes the second component for the first, preserving case order.
if(selected_case==33) { return uxe_geometry_json_dispatch(3,1,1); }
if(selected_case<0 || selected_case>=10) { return 0.0/0.0; }
return uxe_geometry_json_dispatch(3,selected_case,0);
