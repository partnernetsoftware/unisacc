let instance=128;
if(which==1) { instance=256; }
let geo=4096+slot*2048;
let options=geo+64;
let table=geo+128;
let groups=geo+160;
let scratch=geo+240;
let names=geo+400;
let key=geo+416;
let errors=3500;
if(op==0) { return ux_span(0,32768); }
if(op==1) {
  let manager=LoadingManager_init(64);
  let main=BufferGeometryLoader_family(128,0,manager);
  let other=AnimationLoader_family(256,0,manager);
  return main==128 && other==256;
}
if(op==2) { return LoaderFamily_setPath(instance,a,b); }
if(op==3) { return LoaderFamily_beginAsync(instance,a,b,1024,1800,3072,3200); }
if(op==4) { return LoaderFamily_receiveAsync(instance,a,b,c,d,3200); }
if(slot<0 || slot>3) { return 0-1; }
if(op==5) {
  let at=ux_u32_put(geo+BufferGeometry.attributes,table);
  let gr=ux_u32_put(geo+BufferGeometry.groups,groups);
  let ca=ux_u32_put(table+4,1);
  let cg=ux_u32_put(groups+4,1);
  let ar=ux_u32_put(options+GeometryJsonLoad.arena,geo+512);
  let en=ux_u32_put(options+GeometryJsonLoad.arenaEnd,geo+2048);
  let na=ux_u32_put(options+GeometryJsonLoad.names,names);
  let nc=ux_u32_put(options+GeometryJsonLoad.nameCount,1);
  let sc=ux_u32_put(options+GeometryJsonLoad.scratch,scratch);
  let nr=ux_u32_put(names,8);
  let nk=ux_u32_put(names+4,key);
  let nl=ux_u32_put(names+8,8);
  let first=ux_u32_put(key,1769172848);
  let last=ux_u32_put(key+4,1852795252);
  return geo;
}
if(op==6) { return BufferGeomLoader_decodeAsync(instance,a,geo,options,errors); }
if(op==7) {
  let placed=ux_u32_put(options+GeometryJsonLoad.scratch,64);
  let refused=BufferGeomLoader_decodeAsync(instance,a,geo,options,errors);
  let back=ux_u32_put(options+GeometryJsonLoad.scratch,scratch);
  return refused;
}
if(op==8) { return LoaderFamily_releaseAsync(instance,a); }
return 0-1;
