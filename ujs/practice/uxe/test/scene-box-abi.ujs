export uxe_box_world(mode:i64, root:i64) f64 version 1;

let origin0=Vector3_set(0,0.0,0.0,0.0);
let upper0=Vector3_set(24,2.0,1.0,1.0);
let firstBox=Box3_set(0,origin0,upper0);
let origin1=Vector3_set(48,0.0-1.0,0.0-1.0,0.0-1.0);
let upper1=Vector3_set(72,1.0,1.0,1.0);
let secondBox=Box3_set(48,origin1,upper1);
let row0=ux_u32_put(132,firstBox);
let row1=ux_u32_put(160,secondBox);
let rows=SceneBounds_fillRows(root,128,256,2);
if(rows<0) { return 0.0/0.0; }
let output=Box3_setFromObject(600,128,rows,0,680);
if(mode==0) { return ux_f64(output); }
return ux_f64(output+24);
