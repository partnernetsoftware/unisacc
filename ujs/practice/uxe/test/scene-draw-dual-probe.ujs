let packet=0;
let draw=4200;
let stream=4256;
let world=4352;
let proj=4480;
let xyz=4700;
let rgb=4760;
let vertices=4800;
let shader=5000;
let backend=5700;
let target=5720;
let color=8192;
let depth=9216;
let matrix=ux_u32_put(draw+SceneDrawItem.worldMatrix,world);
let p=ux_u32_put(stream+SceneDrawStream.positions,xyz);
let n=ux_u32_put(stream+SceneDrawStream.vertexCount,3);
let s=ux_u32_put(stream+SceneDrawStream.stride,12);
let c=ux_u32_put(stream+SceneDrawStream.color,rgb);
let v=ux_u32_put(stream+SceneDrawStream.viewProjection,proj);
let i=0;
while(i<4) {
  let a=ux_f64_put(world+i*40,1.0);
  let b=ux_f64_put(proj+i*40,1.0);
  i=i+1;
}
let moved=ux_f64_put(world+96,0.55);
let x0=ux_f32_put(xyz,0.0-0.25);
let y0=ux_f32_put(xyz+4,0.0-0.5);
let x1=ux_f32_put(xyz+12,0.25);
let y1=ux_f32_put(xyz+16,0.0-0.5);
let y2=ux_f32_put(xyz+28,0.5);
let green=ux_f32_put(rgb+4,1.0);
let alpha=ux_f32_put(rgb+12,1.0);
let started=GpuPacket_begin(packet,4096,1);
let viewport=GpuPacket_viewport(packet,4096,0,0,16,16);
let clear=GpuPacket_clear(packet,4096,4278190080);
let a=ux_u32_put(backend+SceneDrawBackend.kind,1);
let b=ux_u32_put(backend+SceneDrawBackend.target,packet);
let cap=ux_u32_put(backend+SceneDrawBackend.packetCapacity,4096);
let bound=ux_u32_put(backend+SceneDrawBackend.shader,shader);
let emitted=SceneDraw_flat(backend,draw,stream,vertices,3);
if(emitted<0) { return emitted; }
let soft=ux_u32_put(backend+SceneDrawBackend.kind,0);
let dst=ux_u32_put(backend+SceneDrawBackend.target,target);
let w=ux_u32_put(target+SceneRasterTarget.width,16);
let h=ux_u32_put(target+SceneRasterTarget.height,16);
let cr=ux_u32_put(target+SceneRasterTarget.rgba,color);
let dr=ux_u32_put(target+SceneRasterTarget.depth,depth);
i=0;
while(i<256) {
  let px=ux_u32_put(color+i*4,4278190080);
  let z=ux_f32_put(depth+i*4,1.0);
  i=i+1;
}
if(mode==0) {
  let painted=SceneDraw_flat(backend,draw,stream,vertices,3);
  if(painted<0) { return painted; }
}
return GpuPacket_submit(packet);
