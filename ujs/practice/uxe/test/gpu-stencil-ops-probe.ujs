native function stencil_triangle(vertices:i64,z:f64,green:f64) i64 {
  let index=0;
  while(index<3) {
    let row=vertices+index*28;
    let x=0.0-1.0+4.0*(index==1);
    let y=0.0-1.0+4.0*(index==2);
    let a=ux_f32_put(row,x);
    let b=ux_f32_put(row+4,y);
    let c=ux_f32_put(row+8,z);
    let d=ux_f32_put(row+12,1.0-green);
    let e=ux_f32_put(row+16,green);
    let f=ux_f32_put(row+20,0.0);
    let g=ux_f32_put(row+24,1.0);
    index=index+1;
  }
  return 0;
}
let packet=0;
let capacity=4096;
let state=4352;
let vertices=4608;
let shader=4864;
if(variant<0 || variant>767) { return 0-1; }
let selected=GpuStencilOp_apply(state,value);
if(selected<0) { return selected; }
let depth=ux_u32_put(state+GpuRenderState.depth,8);
let eqRgb=ux_u32_put(state+GpuRenderState.equationRgb,100);
let eqAlpha=ux_u32_put(state+GpuRenderState.equationAlpha,100);
let srcRgb=ux_u32_put(state+GpuRenderState.sourceRgb,201);
let dstRgb=ux_u32_put(state+GpuRenderState.destinationRgb,200);
let srcAlpha=ux_u32_put(state+GpuRenderState.sourceAlpha,201);
let dstAlpha=ux_u32_put(state+GpuRenderState.destinationAlpha,200);
let mask=ux_u32_put(state+GpuRenderState.colorMask,15);
let func=ux_u32_put(state+GpuRenderState.stencil,519);
let ref=ux_u32_put(state+GpuRenderState.stencilReference,83);
let readMask=ux_u32_put(state+GpuRenderState.stencilReadMask,255);
let writeMask=ux_u32_put(state+GpuRenderState.stencilWriteMask,255);
let fail=ux_u32_put(state+GpuRenderState.stencilFail,7680);
let zfail=ux_u32_put(state+GpuRenderState.stencilDepthFail,7680);
let status=GpuPacket_begin(packet,capacity,1);
if(status<0) { return status; }
status=GpuPacket_viewport(packet,capacity,0,0,4,4);
if(status<0) { return status; }
status=GpuPacket_setRenderState(packet,capacity,state);
if(status<0) { return status; }
let sample=variant/256;
let initial=255*(sample==1)+34*(sample==2);
status=GpuPacket_clearBuffers(packet,capacity,5,4278190335,1.0,initial);
if(status<0) { return status; }
status=stencil_triangle(vertices,0.0,1.0);
status=GpuPacket_draw(packet,capacity,vertices,3,shader);
if(status<0) { return status; }
status=GpuPacket_clear(packet,capacity,4278190335);
if(status<0) { return status; }
func=ux_u32_put(state+GpuRenderState.stencil,514);
ref=ux_u32_put(state+GpuRenderState.stencilReference,variant%256);
let keep=ux_u32_put(state+GpuRenderState.stencilPass,7680);
status=GpuPacket_setRenderState(packet,capacity,state);
if(status<0) { return status; }
status=GpuPacket_draw(packet,capacity,vertices,3,shader);
if(status<0) { return status; }
return GpuPacket_submit(packet);
