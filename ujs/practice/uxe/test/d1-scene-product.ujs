// Frame inputs use the D1 terrain projection's units and camera equations.
let heading=0;
let bank=0.0;
let flightX=2048;
let flightZ=2048;
let altitude=25;
let pitch=0;
if(frame==1) { heading=18; bank=12.0; flightX=2064; flightZ=2016; pitch=4; }
if(frame==2) { heading=0-18; bank=0.0-15.0; flightX=2032; flightZ=2016; pitch=0-4; }
if(frame==3) { heading=52; bank=24.0; flightX=2080; flightZ=1984; altitude=30; }
let sine=ux_sin(heading*0.017453292519943296);
let cosine=ux_sin(heading*0.017453292519943296+1.5707963267948966);
let magnitude=bank;
if(magnitude<0.0) { magnitude=0.0-magnitude; }
let camX=(flightX-2048)/8.0-cosine*bank*0.43;
let camHeight=altitude+20.0+magnitude*0.34;
let camZ=(flightZ-2048)/8.0-sine*bank*0.43;
let horizon=100+f64_floor_i64(pitch*0.5+0.5);
let world=f64_floor_i64(uxe_d1_scene(0,0,0,0.0,0.0,0.0));
let camera=f64_floor_i64(uxe_d1_scene(1,world,0,camX,camHeight,camZ));
let terrain=f64_floor_i64(uxe_d1_scene(1,world,0,23.0,0.0,0.0-80.0));
let sample=f64_floor_i64(uxe_d1_scene(1,terrain,0,4.0,28.0*0.22,0.0-10.0));
let orient=uxe_d1_scene(2,camera,0,sine,cosine,0.0);
return uxe_d1_scene(3+component,camera,sample,horizon*1.0,0.0-bank*0.29,0.0);
