native function physical_fixture_tile(out:i64,x:i64,y:i64,r:f64,g:f64,b:f64) i64 {
  let i=0;
  while(i<6) {
    let px=x;
    let py=y;
    if(i==1 || i==2 || i==4) { px=px+8; }
    if(i==2 || i==4 || i==5) { py=py+6; }
    let dst=out+28*i;
    let a=ux_f32_put(dst,(0.0+px)/16.0-1.0);
    let c=ux_f32_put(dst+4,(0.0+py)/16.0-1.0);
    let d=ux_f32_put(dst+8,0.0);
    let e=ux_f32_put(dst+12,r);
    let f=ux_f32_put(dst+16,g);
    let h=ux_f32_put(dst+20,b);
    let alpha=ux_f32_put(dst+24,1.0);
    i=i+1;
  }
  return out+168;
}

let packet=0;
let capacity=8192;
let shader=8192;
let material=8232;
let packed=8448;
if(GpuPacket_begin(packet,capacity,1)<0 || GpuPacket_viewport(packet,capacity,0,0,32,32)<0 ||
   GpuPacket_clear(packet,capacity,4278190080)<0) { return 0-11; }
if(MeshPhysicalMaterial_coat(material,0.5,0.35)!=material ||
   MeshPhysicalMaterial_coat(material,1.25,0.4)!=0-1 ||
   MeshPhysicalMaterial_coat(material,0.5,0.0-0.1)!=0-1 ||
   ux_f32(material+MeshPhysicalMaterial.clearcoat)!=0.5 ||
   MeshPhysicalMaterial_direct(material,0.1,0.55,0.8,0.8,0.8,1.25,2.0)!=0.0-1.0) { return 0-12; }
let row=0;
let out=packed;
while(row<4) {
  let dot=1.0;
  if(row==1) { dot=0.96; }
  if(row==2) { dot=0.8; }
  let rough=0.35;
  if(row==3) { rough=0.7; }
  let col=0;
  while(col<3) {
    let amount=0.5*col;
    if(mode!=0) { amount=0.0; }
    if(MeshPhysicalMaterial_coat(material,amount,rough)!=material) { return 0-13; }
    let red=MeshPhysicalMaterial_direct(material,0.1,0.55,dot,dot,dot,1.0,2.0);
    let green=MeshPhysicalMaterial_direct(material,0.04,0.55,dot,dot,dot,1.0,2.0);
    let blue=MeshPhysicalMaterial_direct(material,0.02,0.55,dot,dot,dot,1.0,2.0);
    if(mode==2 || mode==3) {
      let sheen=0.5*col*(mode==2);
      let width=0.55;
      if(row==3) { width=0.2; }
      red=MeshPhysicalMaterial_sheen(red,0.8*sheen,0.8*sheen,width,dot,dot,dot,2.0);
      green=MeshPhysicalMaterial_sheen(green,0.4*sheen,0.8*sheen,width,dot,dot,dot,2.0);
      blue=MeshPhysicalMaterial_sheen(blue,0.2*sheen,0.8*sheen,width,dot,dot,dot,2.0);
    }
    if(mode>=4) {
      let strength=0.5*col*(mode==4);
      let thickness=180.0+80.0*row;
      let ordinary=MeshPhysicalMaterial_film(0,0.0,1.3,thickness,1.0);
      let r=MeshPhysicalMaterial_film(0,1.0,1.3,thickness,dot);
      let g=MeshPhysicalMaterial_film(1,1.0,1.3,thickness,dot);
      let b=MeshPhysicalMaterial_film(2,1.0,1.3,thickness,dot);
      if(!(r>=0.0 && r<=2.0 && g>=0.0 && g<=2.0 && b>=0.0 && b<=2.0)) { return 0-16; }
      let spec=GpuMaterial_ggxSpecular(0.04,dot,dot,dot,1.0,0.55,2.0);
      red=red+strength*spec*(r-ordinary)/ordinary;
      green=green+strength*spec*(g-ordinary)/ordinary;
      blue=blue+strength*spec*(b-ordinary)/ordinary;
    }
    if(red<0.0 || green<0.0 || blue<0.0) { return 0-14; }
    out=physical_fixture_tile(out,2+10*col,1+8*row,red,green,blue);
    col=col+1;
  }
  row=row+1;
}
if(GpuPacket_draw(packet,capacity,packed,72,shader)<0) { return 0-15; }
return GpuPacket_submit(packet);
