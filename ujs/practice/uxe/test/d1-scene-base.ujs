// Private D1 probe entry. Every node and matrix lives in base memory.
if(op==0) {
  let arena=Object3D_initArena(0,8);
  if(arena<0) { return 0.0-1.0; }
  return Scene_create(arena)*1.0;
}
if(op==1) {
  let child=Object3D_create(0);
  if(child<0) { return 0.0-1.0; }
  let parent=Object3D_add(0,first,child);
  if(parent<0) { return 0.0-1.0; }
  let point=ux_u32(Object3D_address(0,child)+Object3D.position);
  let px=ux_f64_put(point,x);
  let py=ux_f64_put(point+8,y);
  let pz=ux_f64_put(point+16,z);
  return child*1.0;
}
if(op==2) {
  let camera=Object3D_address(0,first);
  if(camera<0) { return 0.0-1.0; }
  let cameraPos=ux_u32(camera+Object3D.position);
  let matrix=Matrix4_set(ux_u32(camera+Object3D.localMatrix),
    y,0.0,0.0-x,ux_f64(cameraPos), 0.0,1.0,0.0,ux_f64(cameraPos+8),
    x,0.0,y,ux_f64(cameraPos+16), 0.0,0.0,0.0,1.0);
  let dirty=ux_u32_put(camera+Object3D.dirty,2);
  return 0.0;
}
let cameraWorld=Object3D_getWorldMatrix(0,first,1);
let objectWorld=Object3D_getWorldMatrix(0,second,1);
if(cameraWorld<0 || objectWorld<0) { return 0.0/0.0; }
let dx=ux_f64(objectWorld+96)-ux_f64(cameraWorld+96);
let dy=ux_f64(objectWorld+104)-ux_f64(cameraWorld+104);
let dz=ux_f64(objectWorld+112)-ux_f64(cameraWorld+112);
let lateral=dx*ux_f64(cameraWorld)+dz*ux_f64(cameraWorld+16);
let depth=0.0-dx*ux_f64(cameraWorld+64)-dz*ux_f64(cameraWorld+80);
if(op==3) { return lateral; }
if(op==4) { return dy; }
if(op==5) { return depth; }
if(depth<=0.0) { return 0.0/0.0; }
let pixelX=212.5+lateral*151.0/depth;
if(op==6) { return pixelX; }
if(op==7) { return x+y*(pixelX-213.0)/213.0-dy*151.0/depth; }
return 0.0/0.0;
