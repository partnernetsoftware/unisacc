native function dashed_fixture_vertex(at:i64,x:f64,y:f64,distance:f64) i64 {
  let a=ux_f32_put(at+LineDashedVertex.x,x/16.0-1.0);
  let b=ux_f32_put(at+LineDashedVertex.y,(y+0.5)/16.0-1.0);
  let c=ux_f32_put(at+LineDashedVertex.z,0.0);
  return ux_f32_put(at+LineDashedVertex.lineDistance,distance);
}

let shader=8192;
let material=8240;
let input=8320;
let packed=8448;
let capacity=8192;
let packet=GpuPacket_begin(0,capacity,1);
if(packet<0 || GpuPacket_viewport(packet,capacity,0,0,32,32)<0 ||
   GpuPacket_clear(packet,capacity,4278190080)<0) { return 0-11; }

if(LineDashedMaterial_init(material)!=material ||
   ux_f32(material+LineDashedMaterial.scale)!=1.0 ||
   ux_f32(material+LineDashedMaterial.dashSize)!=3.0 ||
   ux_f32(material+LineDashedMaterial.gapSize)!=1.0) { return 0-12; }
let left=dashed_fixture_vertex(input,2.0,7.0,0.0);
let right=dashed_fixture_vertex(input+16,30.0,7.0,28.0);
if(LineDashedMaterial_draw(packet,capacity,material,input,2,packed,shader)<0) { return 0-13; }

if(LineDashedMaterial_set(material,1.5,2.0,3.0,3368652)!=material) { return 0-14; }
let shift=0.25;
if(mode!=0) { shift=shift+2.0; }
left=dashed_fixture_vertex(input,5.0,15.0,shift);
right=dashed_fixture_vertex(input+16,27.0,15.0,22.0+shift);
if(LineDashedMaterial_draw(packet,capacity,material,input,2,packed,shader)<0) { return 0-15; }

if(LineDashedMaterial_set(material,0.75,2.0,0.0,65280)!=material) { return 0-16; }
left=dashed_fixture_vertex(input,8.0,23.0,0.25);
right=dashed_fixture_vertex(input+16,24.0,23.0,16.25);
if(LineDashedMaterial_set(material,1.0,0.0,0.0,255)!=0-1 ||
   LineDashedMaterial_set(material,0.0-1.0,2.0,1.0,255)!=0-1 ||
   ux_f32(material+LineDashedMaterial.scale)!=0.75 ||
   ux_u32(material+LineDashedMaterial.color)!=65280) { return 0-17; }
if(LineDashedMaterial_draw(packet,capacity,material,input,2,input,shader)!=0-1 ||
   LineDashedMaterial_draw(packet,capacity,material,input,3,packed,shader)!=0-1 ||
   ux_u32(packet+GpuPacket.commands)!=4) { return 0-18; }
if(LineDashedMaterial_draw(packet,capacity,material,input,2,packed,shader)<0 ||
   ux_u32(packet+GpuPacket.commands)!=5) { return 0-19; }
return GpuPacket_submit(packet);
