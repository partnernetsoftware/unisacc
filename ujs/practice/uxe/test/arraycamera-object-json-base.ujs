let arena=Object3D_initArena(0,4);
let a=Object3D_create(arena);
let b=Object3D_create(arena);
let node=Object3D_address(arena,a);
let target=Object3D_address(arena,b);
let lens=PerspectiveCamera_init(6000,50.0,1.0,0.1,2000.0);
let id=ux_u8_put(7800,99);
let first=ux_u32_put(7100,402);
let second=ux_u32_put(7104,401);
let a0=ux_u32_put(7200,401);
let a1=ux_u32_put(7204,402);
let array=ArrayCamera_init(7000,7100,2);
let name=ux_u32_put(7300+ArrayCameraJson.uuid,7800);
let size=ux_u32_put(7300+ArrayCameraJson.uuidBytes,1);
let reg=ux_u32_put(7300+ArrayCameraJson.registry,7200);
let count=ux_u32_put(7300+ArrayCameraJson.registryCount,2);
let out=ux_u32_put(7300+ArrayCameraJson.output,7400);
let room=ux_u32_put(7300+ArrayCameraJson.capacity,2);

if(selected_case==0) { let last=ArrayCamera_toJSON(node,lens,array,7300,8192,9216,9408);let parsed=ArrayCamera_fromJSON(target,6144,7008,7300,8192,last,10800);if(parsed<0){return 0.0+parsed;}return 0.0+ux_u32(parsed+ArrayCamera.count); }
if(selected_case==1) { let last=ArrayCamera_toJSON(node,lens,array,7300,8192,9216,9408);let parsed=ArrayCamera_fromJSON(target,6144,7008,7300,8192,last,10800);if(parsed<0){return 0.0+parsed;}return 0.0+ArrayCamera_getCamera(parsed,0); }
if(selected_case==2) { let last=ArrayCamera_toJSON(node,lens,array,7300,8192,9216,9408);let parsed=ArrayCamera_fromJSON(target,6144,7008,7300,8192,last,10800);if(parsed<0){return 0.0+parsed;}return 0.0+ArrayCamera_getCamera(parsed,1); }
if(selected_case==3) { let last=ArrayCamera_toJSON(node,lens,array,7300,8192,9216,9408);let parsed=ArrayCamera_fromJSON(target,6144,7008,7300,8192,last,10800);if(parsed<0){return 0.0+parsed;}return ux_f64(6144+PerspectiveCamera.fov); }
if(selected_case==4) { let last=ArrayCamera_toJSON(node,lens,array,7300,8192,9216,9408);let trim=ux_u32_put(7300+ArrayCameraJson.capacity,1);return 0.0+ArrayCamera_fromJSON(target,6144,7008,7300,8192,last,10800); }
if(selected_case==6) { let swap=ux_u32_put(7100,401); let last=ArrayCamera_toJSON(node,lens,array,7300,8192,9216,9408);let parsed=ArrayCamera_fromJSON(target,6144,7008,7300,8192,last,10800);if(parsed<0){return 0.0+parsed;}return 0.0+ArrayCamera_getCamera(parsed,0); }
return 0.0/0.0;
