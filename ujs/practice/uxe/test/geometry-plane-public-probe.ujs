import uxe_plane_dispatch from "uxe_plane_public_v1"(i64,i64,i64) f64;
export uxe_plane_probe(op:i64,a:i64,b:i64,mutate:i64) f64 version 1;

if(op==7 && mutate==1) { return uxe_plane_dispatch(op,0,b); }
if(op==5 && mutate==2) { return uxe_plane_dispatch(op,a,8); }
return uxe_plane_dispatch(op,a,b);
