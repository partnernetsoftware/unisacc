#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use text.json
#pragma unisa use text.fmt
#pragma unisa use text.text

/* One opaque, indexed, statically transformed glTF 2.0 rock. */
typedef struct { const unsigned char *data; int count,stride; } Access;

static unsigned u32(const unsigned char *p) {
    return (unsigned)p[0] | (unsigned)p[1]<<8 | (unsigned)p[2]<<16 | (unsigned)p[3]<<24;
}

static int bounded(const js_val *v,int limit) {
    if(js_kind(v)!=JS_NUM) return -1;
    double n=js_num(v);
    return n>=0 && n<=limit && n==(int)n?(int)n:-1;
}

static int field(const js_val *obj,const char *key,int fallback,int limit) {
    const js_val *v=js_get(obj,key);
    return v?bounded(v,limit):fallback;
}

static int rock_accessor(const js_val *root,const js_val *index,const unsigned char *bin,int length,
        const char *kind,int component,int width,Access *out) {
    const js_val *a=js_at(js_get(root,"accessors"),bounded(index,1024));
    const js_val *v=js_at(js_get(root,"bufferViews"),field(a,"bufferView",-1,1024));
    const char *type=js_str(js_get(a,"type"));
    int start=field(v,"byteOffset",0,length),size=field(v,"byteLength",-1,length);
    int offset=field(a,"byteOffset",0,length),count=field(a,"count",-1,40000);
    int stride=field(v,"byteStride",width,252);
    if(!type || !tx_eqz(type,kind) || field(a,"componentType",-1,6000)!=component ||
        js_get(a,"sparse") || js_bool(js_get(a,"normalized")) ||
        field(v,"buffer",-1,1)!=0 || start<0 || size<0 || start+size>length ||
        offset<0 || count<1 || stride<width || offset+(count-1)*stride+width>size) return 0;
    out->data=bin+start+offset; out->count=count; out->stride=stride;
    return 1;
}

static int vector(const js_val *obj,const char *key,double *v,int n) {
    const js_val *a=js_get(obj,key);
    if(!a) return 1;
    if(js_kind(a)!=JS_ARR || js_len(a)!=n) return 0;
    for(int i=0;i<n;i++) {
        const js_val *e=js_at(a,i);
        if(js_kind(e)!=JS_NUM) return 0;
        v[i]=js_num(e);
        if(!(v[i]>=-1000000 && v[i]<=1000000)) return 0;
    }
    return 1;
}

static int vertex(Access a,int index,const double *q,const double *t,double scale,double *out) {
    double v[3],cross[3];
    const unsigned char *p=a.data+index*a.stride;
    for(int i=0;i<3;i++) {
        unsigned bits=u32(p+4*i);
        float value;
        if(mm_copy(&value,sizeof value,&bits,4)) return 0;
        if(!(value>=-1000000 && value<=1000000)) return 0;
        v[i]=value;
    }
    for(int i=0;i<3;i++) {
        int j=(i+1)%3,k=(i+2)%3;
        cross[i]=2*(q[j]*v[k]-q[k]*v[j]);
    }
    for(int i=0;i<3;i++) {
        int j=(i+1)%3,k=(i+2)%3;
        out[i]=scale*(v[i]+q[3]*cross[i]+q[j]*cross[k]-q[k]*cross[j])+t[i];
    }
    return 1;
}

static int model(const js_val *root,const unsigned char *bin,int length,const char *output) {
    const js_val *nodes=js_get(root,"nodes"),*scene=js_at(js_get(root,"scenes"),0);
    const js_val *parent=js_at(nodes,0),*node=js_at(nodes,1);
    const js_val *mesh=js_at(js_get(root,"meshes"),0),*primitives=js_get(mesh,"primitives");
    const js_val *part=js_at(primitives,0),*attrs=js_get(part,"attributes");
    const js_val *buffers=js_get(root,"buffers"),*buffer=js_at(buffers,0);
    const js_val *material=js_at(js_get(root,"materials"),field(part,"material",-1,1024));
    const js_val *pbr=js_get(material,"pbrMetallicRoughness");
    const char *version=js_str(js_path(root,"asset.version")), *alpha=js_str(js_get(material,"alphaMode"));
    double t[3]={0,0,0},s[3]={1,1,1},q[4]={0,0,0,1},zero[3]={0,0,0},color[4]={1,1,1,1};
    Access pos={0},normal={0},indices={0};
    int buffer_size=field(buffer,"byteLength",-1,length);
    if(!version || !tx_eqz(version,"2.0") || js_len(buffers)!=1 || js_get(buffer,"uri") ||
        buffer_size<1 || length-buffer_size>3 ||
        js_len(js_get(root,"extensionsRequired")) || js_len(js_get(root,"animations")) ||
        js_len(js_get(root,"skins")) || js_len(js_get(root,"textures")) ||
        field(root,"scene",0,0)!=0 || js_len(js_get(root,"scenes"))!=1 ||
        js_len(js_get(scene,"nodes"))!=1 || bounded(js_at(js_get(scene,"nodes"),0),1)!=0 ||
        js_len(nodes)!=2 || js_len(js_get(parent,"children"))!=1 ||
        bounded(js_at(js_get(parent,"children"),0),1)!=1 || js_len(js_get(node,"children")) ||
        js_get(parent,"matrix") || js_get(parent,"mesh") || js_get(node,"matrix") || js_get(node,"skin") ||
        field(node,"mesh",-1,0)!=0 || js_len(js_get(root,"meshes"))!=1 ||
        js_len(primitives)!=1 || js_len(attrs)!=2 || js_get(part,"targets") ||
        field(part,"mode",4,6)!=4 || (alpha && !tx_eqz(alpha,"OPAQUE"))) return 0;
    if(!vector(parent,"translation",t,3) || !vector(parent,"scale",s,3) || !vector(parent,"rotation",q,4) ||
        t[0] || t[1] || t[2] || s[0]!=1 || s[1]!=1 || s[2]!=1 || q[0] || q[1] || q[2] || q[3]!=1 ||
        !vector(node,"translation",t,3) || !vector(node,"scale",s,3) || !vector(node,"rotation",q,4) ||
        s[0]<=0 || s[0]!=s[1] || s[0]!=s[2] || !vector(pbr,"baseColorFactor",color,4)) return 0;
    double unit=q[0]*q[0]+q[1]*q[1]+q[2]*q[2]+q[3]*q[3];
    if(unit<.999 || unit>1.001) return 0;
    for(int i=0;i<4;i++) if(color[i]<0 || color[i]>1) return 0;
    if(!rock_accessor(root,js_get(attrs,"POSITION"),bin,buffer_size,"VEC3",5126,12,&pos) ||
        !rock_accessor(root,js_get(attrs,"NORMAL"),bin,buffer_size,"VEC3",5126,12,&normal) ||
        !rock_accessor(root,js_get(part,"indices"),bin,buffer_size,"SCALAR",5123,2,&indices) ||
        pos.count!=normal.count || indices.count%3) return 0;
    for(int i=0;i<indices.count;i++) {
        const unsigned char *p=indices.data+i*indices.stride;
        int index=p[0]+256*p[1];
        double v[3];
        if(index>=pos.count || !vertex(pos,index,q,t,s[0],v) || !vertex(normal,index,q,zero,1,v)) return 0;
    }
    int capacity=128+indices.count*144;
    char *json=mm_alloc(capacity);
    if(!json) return 0;
    int at=tx_fmt(json,capacity,"{\"color\":[%.7g,%.7g,%.7g],\"positions\":[",color[0],color[1],color[2]);
    if(at<0) { mm_free(json); return 0; }
    for(int stream=0;stream<2;stream++) {
        if(stream) {
            int n=tx_fmt(json+at,capacity-at,"],\"normals\":[");
            if(n<0) { mm_free(json); return 0; }
            at+=n;
        }
        for(int i=0;i<indices.count;i++) {
            const unsigned char *p=indices.data+i*indices.stride;
            double v[3];
            vertex(stream?normal:pos,p[0]+256*p[1],q,stream?zero:t,stream?1:s[0],v);
            int n=tx_fmt(json+at,capacity-at,"%s%.8g,%.8g,%.8g",i?",":"",v[0],v[1],v[2]);
            if(n<0) { mm_free(json); return 0; }
            at+=n;
        }
    }
    int tail=tx_fmt(json+at,capacity-at,"]}\n");
    int ok=tail>0 && sy_write_file(output,json,at+tail,0644)==0;
    mm_free(json);
    if(!ok) return 0;
    printf("GLB_MESH vertices=%d indices=%d triangles=%d\n",pos.count,indices.count,indices.count/3);
    return 1;
}

int main(int argc,char **argv) {
    unsigned char *data=0;
    int64_t length=0,start=sy_mono_ns();
    if(argc!=3) return 2;
    if(sy_read_file(argv[1],&data,&length,2*1024*1024)) return 2;
    int64_t loaded=sy_mono_ns();
    int ok=0;
    if(length>=28 && u32(data)==0x46546c67 && u32(data+4)==2 && u32(data+8)==length) {
        unsigned json_size=u32(data+12);
        if(json_size<=length-28 && json_size%4==0 && u32(data+16)==0x4e4f534a) {
            const unsigned char *chunk=data+20+json_size;
            unsigned bin_size=u32(chunk);
            if(bin_size==length-json_size-28 && bin_size%4==0 && u32(chunk+4)==0x004e4942) {
                char error[120];
                js_val *doc=js_parse((const char*)data+20,json_size,error,sizeof error);
                if(doc) ok=model(doc,chunk+8,bin_size,argv[2]);
                js_free(doc);
            }
        }
    }
    mm_free(data);
    printf("GLB_STUDY bytes=%lld read_us=%lld parse_expand_write_us=%lld accepted=%d\n",
        (long long)length,(long long)((loaded-start)/1000),(long long)((sy_mono_ns()-loaded)/1000),ok);
    return ok?0:1;
}
