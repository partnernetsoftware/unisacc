// Draw back to front using the projected enemy records from the combat step.
let enemyArtReady = uxe_dispatch(4, 20112, 1752);
if (enemyArtReady == 1752) {
  let artDepth = 172;
  while (artDepth >= 4) {
    let artSlot = 0;
    while (artSlot < battleSlots) {
      let artRecord = 32 + 4 * artSlot;
      if (ux_u8(artRecord) > 0 && ux_u8(artRecord + 3) == artDepth) {
        let artX = 2 * ux_u8(artRecord + 1) + ux_u8(72 + artSlot);
        let artY = ux_u8(artRecord + 2);
        let artScale = 1;
        let artW = 17;
        let artH = 6;
        let artOffset = 408 * (artSlot % 3);
        if (artDepth < 33) { artScale = 2; }
        if (artDepth >= 78) { artW = 11; artH = 4; artOffset = 1224 + 176 * (artSlot % 3); }
        packetWrite = uxe_dispatch(15,
          4096 + artX - (artW / 2) * artScale + 8192 * (4096 + artY - (artH / 3) * artScale)
          + 67108864 * artW + 4294967296 * artH + 274877906944 * artScale, artOffset);
        let artMarker = 4278190080 + 255 + 256 * 116 + 65536 * 106;
        packetWrite = uxe_dispatch(2, (artY - 11) * 426 + artX - 3, artMarker);
        packetWrite = uxe_dispatch(2, (artY - 10) * 426 + artX - 2, artMarker);
        packetWrite = uxe_dispatch(2, (artY - 9) * 426 + artX - 1, artMarker);
        packetWrite = uxe_dispatch(2, (artY - 8) * 426 + artX, artMarker);
        packetWrite = uxe_dispatch(2, (artY - 9) * 426 + artX + 1, artMarker);
        packetWrite = uxe_dispatch(2, (artY - 10) * 426 + artX + 2, artMarker);
        packetWrite = uxe_dispatch(2, (artY - 11) * 426 + artX + 3, artMarker);
        if (priorLock == 1 && ux_u8(14) == artRecord) {
          let bracketInk = 4278190080 + 255 + 256 * 228 + 65536 * 107;
          packetWrite = uxe_dispatch(13, artX - 11 + 4096 * (artY - 9) + 16777216 * 5 + 68719476736, bracketInk);
          packetWrite = uxe_dispatch(13, artX + 7 + 4096 * (artY - 9) + 16777216 * 5 + 68719476736, bracketInk);
          packetWrite = uxe_dispatch(13, artX - 11 + 4096 * (artY + 9) + 16777216 * 5 + 68719476736, bracketInk);
          packetWrite = uxe_dispatch(13, artX + 7 + 4096 * (artY + 9) + 16777216 * 5 + 68719476736, bracketInk);
          packetWrite = uxe_dispatch(13, artX - 11 + 4096 * (artY - 9) + 16777216 + 68719476736 * 4, bracketInk);
          packetWrite = uxe_dispatch(13, artX + 11 + 4096 * (artY - 9) + 16777216 + 68719476736 * 4, bracketInk);
          packetWrite = uxe_dispatch(13, artX - 11 + 4096 * (artY + 6) + 16777216 + 68719476736 * 4, bracketInk);
          packetWrite = uxe_dispatch(13, artX + 11 + 4096 * (artY + 6) + 16777216 + 68719476736 * 4, bracketInk);
        }
      }
      artSlot = artSlot + 1;
    }
    artDepth = artDepth - 1;
  }
}
