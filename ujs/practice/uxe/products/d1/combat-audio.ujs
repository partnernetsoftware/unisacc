// Each active voice keeps its own age in product memory. The base owns the
// output buffer and forwards a contiguous 30 Hz chunk to the audio device.
persist let audioGunSeen = 0;
persist let audioMissileSeen = 0;
persist let audioKillSeen = 0;
persist let audioLockSeen = 0;
persist let audioAgeGun = 16000;
persist let audioAgeMissile = 16000;
persist let audioAgeKill = 16000;
persist let audioAgeLock = 16000;
if (audioGunSeen != cannonEvents) { audioAgeGun = 0; audioGunSeen = cannonEvents; }
if (audioMissileSeen != missileEvents) { audioAgeMissile = 0; audioMissileSeen = missileEvents; }
if (audioKillSeen != explosionEvents) { audioAgeKill = 0; audioKillSeen = explosionEvents; }
if (audioLockSeen != lockEvents) { audioAgeLock = 0; audioLockSeen = lockEvents; }

if (audioAgeGun < 3120 || audioAgeMissile < 10800 || audioAgeKill < 15840 || audioAgeLock < 4800) {
  let sampleAt = 0;
  while (sampleAt < 1600) {
    let voiceRow = 1;
    let mixed = 0.0;
    while (voiceRow <= 4) {
      let voiceAge = audioAgeGun;
      if (voiceRow == 2) { voiceAge = audioAgeMissile; }
      if (voiceRow == 3) { voiceAge = audioAgeKill; }
      if (voiceRow == 4) { voiceAge = audioAgeLock; }
      let sampleRequest = (voiceAge + sampleAt) * 8 + voiceRow;
      let gain = d1_effect_level(sampleRequest);
      if (gain > 0.0) {
        let cycle = d1_effect_phase(sampleRequest);
        let signal = 0.0;
        if (voiceRow == 1) {
          signal = 1.0;
          if (cycle >= 0.5) { signal = 0.0 - 1.0; }
        }
        if (voiceRow == 2) { signal = cycle * 2.0 - 1.0; }
        if (voiceRow == 3) {
          signal = cycle * 4.0 - 1.0;
          if (cycle >= 0.5) { signal = 3.0 - cycle * 4.0; }
        }
        if (voiceRow == 4) { signal = ux_sin(cycle * 6.283185307179586); }
        mixed = mixed + signal * gain;
      }
      voiceRow = voiceRow + 1;
    }
    let sampleOutput = uxe_dispatch(5, sampleAt, f64_floor_i64(mixed * 32767.0 + 0.5));
    sampleAt = sampleAt + 1;
  }
  let sentAudio = uxe_dispatch(6, 1600, 0);
  if (audioAgeGun < 16000) { audioAgeGun = audioAgeGun + 1600; }
  if (audioAgeMissile < 16000) { audioAgeMissile = audioAgeMissile + 1600; }
  if (audioAgeKill < 16000) { audioAgeKill = audioAgeKill + 1600; }
  if (audioAgeLock < 16000) { audioAgeLock = audioAgeLock + 1600; }
}
