function d1_elevation(cell) {
  let mapX = cell % 256;
  let mapY = (cell / 256) % 256;
  let mapSeed = cell / 65536;
  let peak = 0 - 49;
  let site = 0;
  while (site < 8) {
    let packed = 100 + 106 * 256 + 34 * 65536 + 28 * 16777216 + 113 * 4294967296;
    if (site == 1) { packed = 163 + 96 * 256 + 22 * 65536 + 18 * 16777216 + 97 * 4294967296; }
    if (site == 2) { packed = 130 + 67 * 256 + 12 * 65536 + 13 * 16777216 + 84 * 4294967296; }
    if (site == 3) { packed = 72 + 56 * 256 + 16 * 65536 + 15 * 16777216 + 100 * 4294967296; }
    if (site == 4) { packed = 187 + 52 * 256 + 17 * 65536 + 13 * 16777216 + 102 * 4294967296; }
    if (site == 5) { packed = 104 + 25 * 256 + 16 * 65536 + 14 * 16777216 + 98 * 4294967296; }
    if (site == 6) { packed = 150 + 20 * 256 + 15 * 65536 + 13 * 16777216 + 103 * 4294967296; }
    if (site == 7) { packed = 215 + 19 * 256 + 19 * 65536 + 13 * 16777216 + 104 * 4294967296; }
    let east = mapX - packed % 256;
    let north = mapY - (packed / 256) % 256;
    let radiusX = (packed / 65536) % 256;
    let radiusY = (packed / 16777216) % 256;
    if (east < 0) { east = 0 - east; }
    if (north < 0) { north = 0 - north; }
    if (east > 128) { east = 256 - east; }
    if (north > 128) { north = 256 - north; }
    let height = packed / 4294967296 - 116 * east * east / (radiusX * radiusX)
      - 116 * north * north / (radiusY * radiusY);
    if (height > peak) { peak = height; }
    site = site + 1;
  }
  let mainland = 0 - 49;
  let edge = 0;
  while (edge < 7) {
    let shelf = 24 + 129 * 256 + 54 * 65536 + 113 * 16777216 + 20 * 4294967296 + 27 * 1099511627776;
    if (edge == 1) { shelf = 54 + 113 * 256 + 79 * 65536 + 104 * 16777216 + 22 * 4294967296 + 42 * 1099511627776; }
    if (edge == 2) { shelf = 79 + 104 * 256 + 106 * 65536 + 92 * 16777216 + 22 * 4294967296 + 50 * 1099511627776; }
    if (edge == 3) { shelf = 106 + 92 * 256 + 114 * 65536 + 73 * 16777216 + 14 * 4294967296 + 28 * 1099511627776; }
    if (edge == 4) { shelf = 35 + 124 * 256 + 37 * 65536 + 98 * 16777216 + 15 * 4294967296 + 27 * 1099511627776; }
    if (edge == 5) { shelf = 63 + 116 * 256 + 68 * 65536 + 133 * 16777216 + 11 * 4294967296 + 28 * 1099511627776; }
    if (edge == 6) { shelf = 89 + 103 * 256 + 103 * 65536 + 129 * 16777216 + 13 * 4294967296 + 30 * 1099511627776; }
    let startX = shelf % 256;
    let startY = (shelf / 256) % 256;
    let axisX = (shelf / 65536) % 256 - startX;
    let axisY = (shelf / 16777216) % 256 - startY;
    let radius = (shelf / 4294967296) % 256;
    let top = shelf / 1099511627776;
    let localX = mapX - startX;
    let localY = mapY - startY;
    let amount = 1.0 * (localX * axisX + localY * axisY) / (axisX * axisX + axisY * axisY);
    if (amount < 0.0) { amount = 0.0; }
    if (amount > 1.0) { amount = 1.0; }
    let offsetX = localX - amount * axisX;
    let offsetY = localY - amount * axisY;
    let shelfHeight = top - f64_floor_i64((top + 19) * (offsetX * offsetX + offsetY * offsetY) / (radius * radius));
    if (shelfHeight > mainland) { mainland = shelfHeight; }
    edge = edge + 1;
  }
  let lagoonX = (mapX - 59) / 10.5;
  let lagoonY = (mapY - 111) / 8.2;
  let lagoon = lagoonX * lagoonX + lagoonY * lagoonY;
  if (lagoon < 1.0) { mainland = mainland - f64_floor_i64((1.0 - lagoon) * 65); }
  if (mainland > peak) { peak = mainland; }
  let octave = 0;
  while (octave < 3) {
    let spacing = 64;
    let salt = mapSeed;
    let amplitude = 0.45;
    if (octave == 1) { spacing = 16; salt = mapSeed + 3; amplitude = 0.25; }
    if (octave == 2) { spacing = 2; salt = mapSeed + 5; amplitude = 0.07; }
    let gridX = mapX / spacing;
    let gridY = mapY / spacing;
    let left = mapX % spacing;
    let bottom = mapY % spacing;
    let mask = 256 / spacing - 1;
    let value = 0;
    let corner = 0;
    while (corner < 4) {
      let column = corner % 2;
      let row = corner / 2;
      let pointX = u32_and(gridX + column, mask);
      let pointY = u32_and(gridY + row, mask);
      let hash = u32_xor(u32_xor(u32_mul(pointX + 17, 374761393), u32_mul(pointY + 29, 668265263)),
        u32_mul(salt, 1442695041));
      hash = u32_mul(u32_xor(hash, u32_shr(hash, 13)), 1274126177);
      hash = u32_and(u32_xor(hash, u32_shr(hash, 16)), 255);
      let weightX = spacing - left;
      let weightY = spacing - bottom;
      if (column == 1) { weightX = left; }
      if (row == 1) { weightY = bottom; }
      value = value + hash * weightX * weightY;
      corner = corner + 1;
    }
    peak = peak + f64_floor_i64((value / (spacing * spacing) - 128) * amplitude);
    octave = octave + 1;
  }
  return peak;
}
