// Packed world positions hold X, Z, altitude, and a billboard scale.
let cloudLoaded = uxe_dispatch(4, 19200, 912);
if (cloudLoaded == 912) {
  let cloudIndex = 0;
  while (cloudIndex < 17) {
    let cloudPacked = 0;
    if (cloudIndex == 0) { cloudPacked = 93 + 256 * 74 + 65536 * 39 + 16777216 * 18; }
    if (cloudIndex == 1) { cloudPacked = 202 + 256 * 63 + 65536 * 23 + 16777216 * 14; }
    if (cloudIndex == 2) { cloudPacked = 155 + 256 * 8 + 65536 * 32 + 16777216 * 15; }
    if (cloudIndex == 3) { cloudPacked = 55 + 256 * 25 + 65536 * 39 + 16777216 * 18; }
    if (cloudIndex == 4) { cloudPacked = 231 + 256 * 14 + 65536 * 36 + 16777216 * 17; }
    if (cloudIndex == 5) { cloudPacked = 117 + 256 * 11 + 65536 * 26 + 16777216 * 19; }
    if (cloudIndex == 6) { cloudPacked = 136 + 256 * 6 + 65536 * 36 + 16777216 * 15; }
    if (cloudIndex == 7) { cloudPacked = 216 + 256 * 10 + 65536 * 31 + 16777216 * 14; }
    if (cloudIndex == 8) { cloudPacked = 31 + 256 * 43 + 65536 * 38 + 16777216 * 20; }
    if (cloudIndex == 9) { cloudPacked = 115 + 256 * 103 + 65536 * 45 + 16777216 * 24; }
    if (cloudIndex == 10) { cloudPacked = 142 + 256 * 96 + 65536 * 43 + 16777216 * 25; }
    if (cloudIndex == 11) { cloudPacked = 78 + 256 * 48 + 65536 * 34 + 16777216 * 20; }
    if (cloudIndex == 12) { cloudPacked = 212 + 256 * 93 + 65536 * 40 + 16777216 * 19; }
    if (cloudIndex == 13) { cloudPacked = 190 + 256 * 53 + 65536 * 39 + 16777216 * 13; }
    if (cloudIndex == 14) { cloudPacked = 116 + 256 * 109 + 65536 * 53 + 16777216 * 33; }
    if (cloudIndex == 15) { cloudPacked = 155 + 256 * 99 + 65536 * 54 + 16777216 * 34; }
    if (cloudIndex == 16) { cloudPacked = 148 + 256 * 107 + 65536 * 48 + 16777216 * 30; }
    let cloudX = 2.0 * (cloudPacked % 256) - 256.0 - viewX;
    let cloudZ = 2.0 * ((cloudPacked / 256) % 256) - 256.0 - viewZ;
    cloudX = cloudX - 512.0 * f64_floor_i64(cloudX / 512.0 + 0.5);
    cloudZ = cloudZ - 512.0 * f64_floor_i64(cloudZ / 512.0 + 0.5);
    let cloudDepth = cloudX * viewSin - cloudZ * viewCos;
    let cloudNear = 94;
    let cloudFar = 295;
    let cloudArt = 0;
    if (cloudIndex >= 9) { cloudNear = 28; cloudFar = 130; cloudArt = 456; }
    if (cloudDepth >= cloudNear && cloudDepth <= cloudFar) {
      let cloudScreenX = f64_floor_i64(213.5 + 151.0 * (cloudX * viewCos + cloudZ * viewSin) / cloudDepth);
      let cloudScreenY = f64_floor_i64(0.5 + viewHorizon
        + (viewCam - 7.0 - (cloudPacked / 65536) % 256) * 151.0 / cloudDepth
        + viewTilt * (cloudScreenX - 213) / 213.0);
      let cloudScale = f64_floor_i64(0.5 + 4.0 * (cloudPacked / 16777216) / cloudDepth);
      if (cloudScale < 1) { cloudScale = 1; }
      packetWrite = uxe_dispatch(15, 4096 + cloudScreenX - 9 * cloudScale
        + 8192 * (4096 + cloudScreenY - 3 * cloudScale)
        + 67108864 * 19 + 4294967296 * 6 + 274877906944 * cloudScale, cloudArt);
    }
    cloudIndex = cloudIndex + 1;
  }
}
