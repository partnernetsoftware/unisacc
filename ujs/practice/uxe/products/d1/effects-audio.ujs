// Each voice uses a 24-byte row: wave, start Hz, end Hz, level per mille, attack ms, duration ms.
// The request is sampleIndex * 8 + row, using the base output rate of 48000 Hz.
function d1_effect_phase(phaseRequest) {
  let phaseAddress = 4700000 + (phaseRequest % 8) * 24;
  let phaseStart = ux_f32(phaseAddress + 4);
  let phaseEnd = ux_f32(phaseAddress + 8);
  let phaseDuration = ux_f32(phaseAddress + 20) / 1000.0;
  let phaseTime = (phaseRequest / 8) / 48000.0;
  let phaseCycles = 0.0;
  if (phaseDuration > 0.0 && phaseTime < phaseDuration) {
    phaseCycles = phaseStart * phaseTime
      + (phaseEnd - phaseStart) * phaseTime * phaseTime / (2.0 * phaseDuration);
  }
  return phaseCycles - f64_floor_i64(phaseCycles);
}

function d1_effect_level(levelRequest) {
  let levelAddress = 4700000 + (levelRequest % 8) * 24;
  let levelTime = (levelRequest / 8) / 48000.0;
  let levelPeak = ux_f32(levelAddress + 12) / 1000.0;
  let levelAttack = ux_f32(levelAddress + 16) / 1000.0;
  let levelDuration = ux_f32(levelAddress + 20) / 1000.0;
  let levelValue = 0.0;
  if (levelAttack > 0.0 && levelDuration > levelAttack && levelTime < levelDuration) {
    if (levelTime < levelAttack) {
      levelValue = levelPeak * levelTime / levelAttack;
    } else {
      levelValue = levelPeak * (levelDuration - levelTime) / (levelDuration - levelAttack);
    }
  }
  return levelValue;
}
