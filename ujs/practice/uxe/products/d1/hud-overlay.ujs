hudDraw = uxe_dispatch(14, 396 + 4096 * 227 + 16777216 * 31599, hudInk);
hudDraw = uxe_dispatch(14, 31 + 4096 * 216 + 16777216 * (32768 + battleWave % 10), hudInk);
hudDraw = uxe_dispatch(14, 31 + 4096 * 227 + 16777216 * (32768 + cannonAmmo / 10), hudInk);
