// Layered broadleaf crowns and meadow tufts share a fixed-step wind clock.
let breeze = ux_sin(walkTick * 0.089);
let clump = 0;
while (clump < 18) {
  let position = clump % 14;
  let treeX = -2230 + position * 310 + position * 67 % 109;
  let treeY = 6 + position % 4 * 42;
  let treeZ = 570 + position * 89 % 430;
  if (clump >= 14) {
    treeX = -1540 + (clump - 14) * 735;
    treeY = 1120 + clump % 3 * 38;
    treeZ = -180 - clump % 3 * 300;
  }
  let patch = 0;
  while (patch < 13) {
    let crownX = treeX + (patch % 4 * 98 - 147) + (patch * 31 + clump * 17) % 83 - 41
      + f64_floor_i64(breeze * (12 + 5 * (patch / 4)));
    let crownY = treeY + (patch / 4 - 1) * 67 + (patch * 47 + clump * 7) % 89 - 44;
    let crownZ = treeZ + (patch * 43 + clump * 19) % 202 - 101;
    let tint = (patch + clump) % 3;
    let extent = 100 + (clump * 11 + patch * 17) % 119;
    let center = (crownZ + 32768) * 4294967296 + (crownY + 32768) * 65536 + crownX + 32768;
    let segment = 0;
    while (segment < 7) {
      let twist = (patch % 5 - 2) * 0.31;
      let t0 = segment * 0.8975979010256552 + twist;
      let t1 = (segment + 1) * 0.8975979010256552 + twist;
      let reach0 = extent - ((patch + segment) % 3) * 27;
      let reach1 = extent - ((patch + (segment + 1) % 7) % 3) * 27;
      let x0 = f64_floor_i64(reach0 * ux_sin(t0 + 1.5707963267948966));
      let x1 = f64_floor_i64(reach1 * ux_sin(t1 + 1.5707963267948966));
      let y0 = f64_floor_i64(0.72 * reach0 * ux_sin(t0));
      let y1 = f64_floor_i64(0.72 * reach1 * ux_sin(t1));
      let leafColor = 29 + 15 * tint + 256 * (62 + 29 * tint) + 65536 * (47 + 10 * tint);
      if (y0 + y1 > 20) {
        leafColor = 94 + 37 * (segment % 2) + 256 * (131 + 30 * (segment % 2)) + 65536 * (63 + 9 * (segment % 2));
      }
      sceneCall = uxe_dispatch(25, 0, center + (49 + patch % 4 * 23) * 4294967296);
      sceneCall = uxe_dispatch(25, 1, center + x0 + y0 * 65536);
      sceneCall = uxe_dispatch(25, 2, center + x1 + y1 * 65536);
      sceneCall = uxe_dispatch(20, 4, leafColor);
      segment = segment + 1;
    }
    patch = patch + 1;
  }
  clump = clump + 1;
}

let tuft = 0;
while (tuft < 320) {
  let rootX = -2170 + tuft % 32 * 146 + tuft * 53 % 111;
  let rootZ = 400 + tuft / 32 * 148 + tuft * 71 % 121;
  let root = (rootZ + 32768) * 4294967296 + 32567 * 65536 + rootX + 32768;
  let grassBend = 11 + f64_floor_i64(breeze * 14.0);
  let blade = 0;
  while (blade < 3) {
    let shade = 28 + 9 * blade + 256 * (66 + 11 * blade) + 65536 * (41 + 5 * blade);
    let tip = root + 65536 * (19 + (tuft + blade * 11) % 36) + grassBend + blade * 13 - 9;
    sceneCall = uxe_dispatch(25, 0, root + blade * 9);
    sceneCall = uxe_dispatch(25, 1, root + blade * 9 + 13);
    sceneCall = uxe_dispatch(25, 2, tip);
    sceneCall = uxe_dispatch(20, 0, shade);
    blade = blade + 1;
  }
  tuft = tuft + 1;
}
