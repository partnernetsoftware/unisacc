// Stone bay coordinates are centimetres. The whole bridge follows the route's diagonal.
function bridgeColumn(x) {
  return x + 32768 + (32768 + x * 45 / 100) * 4294967296;
}

let sceneWidth = 426;
let sceneHeight = 240;
let sceneCall = uxe_dispatch(1, sceneWidth, sceneHeight);
let skyRow = 0;
while (skyRow < sceneHeight) {
  let skyRed = 27 + skyRow * 84 / sceneHeight;
  let skyGreen = 80 + skyRow * 85 / sceneHeight;
  let skyBlue = 153 + skyRow * 63 / sceneHeight;
  sceneCall = uxe_dispatch(11, skyRow * 4096 + 425 * 16777216,
    skyRed + 256 * skyGreen + 65536 * skyBlue + 4278190080);
  skyRow = skyRow + 1;
}
sceneCall = uxe_dispatch(18, 213, 8);
sceneCall = uxe_dispatch(21, 3000 + 10900 * 65536, 14198127);
let eyeX = f64_floor_i64(ux_f32(4) / 10.0);
let eyeY = f64_floor_i64(ux_f32(8) / 10.0);
let eyeZ = f64_floor_i64(ux_f32(12) / 10.0);
sceneCall = uxe_dispatch(23, 0, eyeX + 32768 + (eyeY + 32768) * 65536 + (eyeZ + 32768) * 4294967296);
let yaw = walkYaw / 1000.0;
let routeX = ux_f32(16);
let routeZ = ux_f32(24);
let yawSin = ux_sin(yaw);
let yawCos = ux_sin(yaw + 1.5707963267948966);
let aimX = f64_floor_i64(routeX * yawCos - routeZ * yawSin);
let aimY = f64_floor_i64(ux_f32(20));
let aimZ = f64_floor_i64(routeX * yawSin + routeZ * yawCos);
sceneCall = uxe_dispatch(24, 0, aimX + 32768 + (aimY + 32768) * 65536 + (aimZ + 32768) * 4294967296);

let stone = 246 + 214 * 256 + 168 * 65536;
let archShade = 118 + 124 * 256 + 139 * 65536;
let deckShade = 224 + 202 * 256 + 170 * 65536;
let bay = 0;
while (bay < 5) {
  let center = -1600 + 800 * bay;
  let prevX = center + 400;
  let prevY = -200;
  let rib = 0 - 1;
  while (rib <= 18) {
    let arc = 3.141592653589793 * rib / 16.0;
    let ribX = center + f64_floor_i64(295.0 * ux_sin(arc + 1.5707963267948966) + 0.5);
    let ribY = 440 + f64_floor_i64(472.0 * ux_sin(arc) + 0.5);
    if (rib < 0) { ribX = center + 295; ribY = -200; }
    if (rib == 17) { ribX = center - 295; ribY = -200; }
    if (rib == 18) { ribX = center - 400; ribY = -200; }
    let columnA = bridgeColumn(prevX);
    let columnB = bridgeColumn(ribX);
    let baseA = columnA + (prevY + 32768) * 65536;
    let baseB = columnB + (ribY + 32768) * 65536;
    let deckA = columnA + 33848 * 65536;
    let deckB = columnB + 33848 * 65536;
    let side = 0;
    while (side < 4) {
      let depth = (250 - 1115 * (side % 2)) * 4294967296;
      let a = baseA + depth;
      let b = baseB + depth;
      let c = deckB + depth;
      let d = deckA + depth;
      let color = stone;
      if (side == 2) {
        c = b - 1115 * 4294967296;
        d = a - 1115 * 4294967296;
        color = archShade;
      }
      if (side == 3) {
        a = deckA + 250 * 4294967296;
        b = deckB + 250 * 4294967296;
        color = deckShade;
      }
      sceneCall = uxe_dispatch(25, 0, a);
      sceneCall = uxe_dispatch(25, 1, b);
      sceneCall = uxe_dispatch(25, 2, c);
      sceneCall = uxe_dispatch(20, 0, color);
      sceneCall = uxe_dispatch(25, 1, d);
      sceneCall = uxe_dispatch(20, 0, color);
      side = side + 1;
    }
    prevX = ribX;
    prevY = ribY;
    rib = rib + 1;
  }
  bay = bay + 1;
}
