// Clifftop house: two plaster floors, a balcony, and a slate gable.
let houseLeft = 29368;
let houseRight = 31168;
let houseCenter = 30268;
let houseNear = 32038;
let houseFar = 31498;
let storey = 0;
while (storey < 4) {
  let low = 32568;
  let high = 33848;
  let color = 132 + 116 * 256 + 99 * 65536;
  if (storey == 1) { low = 33848; high = 34208; color = 220 + 155 * 256 + 91 * 65536; }
  if (storey == 2) { low = 34208; high = 34568; color = 243 + 226 * 256 + 180 * 65536; }
  if (storey == 3) { low = 34170; high = 34202; color = 106 + 63 * 256 + 53 * 65536; }
  let face = 0;
  while (face < 4) {
    let x0 = houseLeft;
    let x1 = houseRight;
    let z0 = houseNear;
    let z1 = houseNear;
    if (face == 1) { z0 = houseFar; z1 = houseFar; }
    if (face >= 2) {
      x0 = houseLeft + (houseRight - houseLeft) * (face == 3);
      x1 = x0;
      z0 = houseFar;
      z1 = houseNear;
    }
    if (storey == 3) { z0 = z0 + 100; z1 = z1 + 100; }
    let edge0 = x0 + z0 * 4294967296;
    let edge1 = x1 + z1 * 4294967296;
    sceneCall = uxe_dispatch(25, 0, edge0 + low * 65536);
    sceneCall = uxe_dispatch(25, 1, edge1 + low * 65536);
    sceneCall = uxe_dispatch(25, 2, edge1 + high * 65536);
    sceneCall = uxe_dispatch(20, 3, color);
    sceneCall = uxe_dispatch(25, 1, edge0 + high * 65536);
    sceneCall = uxe_dispatch(20, 3, color);
    face = face + 1;
  }
  storey = storey + 1;
}

let roofLine = 0;
while (roofLine < 12) {
  let run0 = roofLine % 6 * 158;
  let run1 = run0 + 158;
  let side = 1 - 2 * (roofLine / 6);
  let eave0 = houseCenter + side * run0 + (35088 - run0 * 58 / 100) * 65536;
  let eave1 = houseCenter + side * run1 + (35088 - run1 * 58 / 100) * 65536;
  let tile = 45 + roofLine % 3 * 6;
  let roofColor = tile + (tile + 19) * 256 + (tile + 43) * 65536;
  sceneCall = uxe_dispatch(25, 0, eave0 + (houseNear + 45) * 4294967296);
  sceneCall = uxe_dispatch(25, 1, eave1 + (houseNear + 45) * 4294967296);
  sceneCall = uxe_dispatch(25, 2, eave1 + (houseFar - 45) * 4294967296);
  sceneCall = uxe_dispatch(20, 5, roofColor);
  sceneCall = uxe_dispatch(25, 1, eave0 + (houseFar - 45) * 4294967296);
  sceneCall = uxe_dispatch(20, 5, roofColor);
  roofLine = roofLine + 1;
}
let gable = 0;
while (gable < 2) {
  let gableZ = (houseNear - 540 * gable) * 4294967296;
  sceneCall = uxe_dispatch(25, 0, gableZ + 34568 * 65536 + houseLeft);
  sceneCall = uxe_dispatch(25, 1, gableZ + 34568 * 65536 + houseRight);
  sceneCall = uxe_dispatch(25, 2, gableZ + 35088 * 65536 + houseCenter);
  sceneCall = uxe_dispatch(20, 3, 243 + 226 * 256 + 180 * 65536);
  gable = gable + 1;
}

let opening = 0;
while (opening < 35) {
  let windowLeft = houseLeft + 104 + opening % 8 * 220;
  let windowLow = 33965 + opening / 8 * 360;
  let trimZ = houseNear + 4;
  let trimW = 93;
  let trimH = 115;
  let windowColor = 66 + 61 * 256 + 57 * 65536;
  if (opening >= 16 && opening < 32) {
    windowLeft = houseLeft + 145 + opening % 8 * 220;
    windowLow = 33965 + (opening - 16) / 8 * 360;
    trimW = 13;
    trimZ = houseNear + 6;
    windowColor = 184 + 147 * 256 + 95 * 65536;
  }
  if (opening == 32) {
    windowLeft = houseCenter - 79;
    windowLow = 33850;
    trimW = 158;
    trimH = 237;
    trimZ = houseNear + 9;
    windowColor = 112 + 71 * 256 + 37 * 65536;
  }
  if (opening >= 33) {
    windowLeft = houseLeft + 36 + (opening - 33) * 1695;
    windowLow = 33849;
    trimW = 26;
    trimH = 716;
    trimZ = houseNear + 8;
    windowColor = 83 + 53 * 256 + 35 * 65536;
  }
  let corner = trimZ * 4294967296 + windowLow * 65536 + windowLeft;
  sceneCall = uxe_dispatch(25, 0, corner);
  sceneCall = uxe_dispatch(25, 1, corner + trimW);
  sceneCall = uxe_dispatch(25, 2, corner + trimW + trimH * 65536);
  sceneCall = uxe_dispatch(20, 3, windowColor);
  sceneCall = uxe_dispatch(25, 1, corner + trimH * 65536);
  sceneCall = uxe_dispatch(20, 3, windowColor);
  opening = opening + 1;
}

// Weathered rocks at the foot of the abutment, stacked in uneven shelves.
let boulder = 0;
while (boulder < 15) {
  let rx = -1950 + boulder % 4 * 122 + boulder * 43 % 82;
  let ry = -140 + boulder / 4 * 153;
  let rz = 360 + boulder % 4 * 39 - boulder / 4 * 28;
  let rock = (rz + 32768) * 4294967296 + (ry + 32768) * 65536 + rx + 32768;
  let radius = 85 + boulder * 31 % 65;
  let side = 0;
  while (side < 7) {
    let t0 = side * 0.8975979010256552;
    let t1 = t0 + 0.8975979010256552;
    let ring0 = rock + f64_floor_i64(radius * ux_sin(t0 + 1.5707963267948966))
      + f64_floor_i64(radius * 0.74 * ux_sin(t0)) * 4294967296;
    let ring1 = rock + f64_floor_i64(radius * ux_sin(t1 + 1.5707963267948966))
      + f64_floor_i64(radius * 0.74 * ux_sin(t1)) * 4294967296;
    let rockLight = 98 + 38 * (side % 2) + 256 * (126 + 31 * (side % 2)) + 65536 * (141 + 25 * (side % 2));
    sceneCall = uxe_dispatch(25, 0, rock + radius * 65536);
    sceneCall = uxe_dispatch(25, 1, ring0 + 12 * 65536);
    sceneCall = uxe_dispatch(25, 2, ring1 + 12 * 65536);
    sceneCall = uxe_dispatch(20, 6, rockLight);
    sceneCall = uxe_dispatch(25, 0, rock - 58 * 65536);
    sceneCall = uxe_dispatch(20, 6, 86 + 108 * 256 + 124 * 65536);
    side = side + 1;
  }
  boulder = boulder + 1;
}
