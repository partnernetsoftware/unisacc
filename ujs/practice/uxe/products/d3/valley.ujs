// Elevation rings give each ridge a rounded profile. All positions use centimetres.
let ridge = 0;
while (ridge < 12) {
  let ridgeX = -5500 + ridge * 900;
  let ridgeZ = -4300 - ridge % 2 * 1300;
  let ridgeBase = -400 + ridge % 3 * 100;
  let ridgeRadius = 900 + ridge % 4 * 200;
  let ring = 0;
  while (ring < 3) {
    let angle0 = 1.5707963267948966 * ring / 3.0;
    let angle1 = 1.5707963267948966 * (ring + 1) / 3.0;
    let radius0 = ridgeRadius * ux_sin(angle0 + 1.5707963267948966);
    let radius1 = ridgeRadius * ux_sin(angle1 + 1.5707963267948966);
    let y0 = ridgeBase + f64_floor_i64(0.83 * ridgeRadius * ux_sin(angle0));
    let y1 = ridgeBase + f64_floor_i64(0.83 * ridgeRadius * ux_sin(angle1));
    let segment = 0;
    while (segment < 10) {
      let heading0 = 0.6283185307179586 * segment;
      let heading1 = 0.6283185307179586 * (segment + 1);
      let cos0 = ux_sin(heading0 + 1.5707963267948966);
      let cos1 = ux_sin(heading1 + 1.5707963267948966);
      let sin0 = ux_sin(heading0);
      let sin1 = ux_sin(heading1);
      let u = ridgeX + 32768 + 65536 * (y0 + 32768);
      let v = ridgeX + 32768 + 65536 * (y1 + 32768);
      let a = u + f64_floor_i64(radius0 * cos0) + (ridgeZ + 32768 + f64_floor_i64(radius0 * sin0)) * 4294967296;
      let b = u + f64_floor_i64(radius0 * cos1) + (ridgeZ + 32768 + f64_floor_i64(radius0 * sin1)) * 4294967296;
      let c = v + f64_floor_i64(radius1 * cos1) + (ridgeZ + 32768 + f64_floor_i64(radius1 * sin1)) * 4294967296;
      let d = v + f64_floor_i64(radius1 * cos0) + (ridgeZ + 32768 + f64_floor_i64(radius1 * sin0)) * 4294967296;
      let blue = 126 + 6 * (ridge % 3) + 3 * ring;
      let color = 49 + 5 * ring + 256 * (95 + 5 * ring) + 65536 * blue;
      sceneCall = uxe_dispatch(25, 0, a);
      sceneCall = uxe_dispatch(25, 1, b);
      sceneCall = uxe_dispatch(25, 2, c);
      sceneCall = uxe_dispatch(20, 0, color);
      sceneCall = uxe_dispatch(25, 1, d);
      sceneCall = uxe_dispatch(20, 0, color);
      segment = segment + 1;
    }
    ring = ring + 1;
  }
  ridge = ridge + 1;
}

let meadowZ = -4000;
while (meadowZ < 3200) {
  let meadowX = -6000;
  while (meadowX < 6000) {
    let a = (meadowZ + 32768) * 4294967296 + 32566 * 65536 + meadowX + 32768;
    let b = a + 800;
    let c = b + 800 * 4294967296;
    let d = a + 800 * 4294967296;
    let grassTone = (meadowZ - meadowX + 10400) / 800 % 3;
    let grass = 42 + grassTone + 256 * (90 + 3 * grassTone) + 65536 * 66;
    sceneCall = uxe_dispatch(25, 0, a);
    sceneCall = uxe_dispatch(25, 1, b);
    sceneCall = uxe_dispatch(25, 2, c);
    sceneCall = uxe_dispatch(20, 0, grass);
    sceneCall = uxe_dispatch(25, 1, d);
    sceneCall = uxe_dispatch(20, 0, grass);
    meadowX = meadowX + 800;
  }
  meadowZ = meadowZ + 800;
}
