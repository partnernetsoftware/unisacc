// Headless scene state. The standard D4Frame and four legs occupy logical
// bytes 0..375. The rest pose, camera facts, and scratch follow it privately.
persist let d4_started=0;
persist let d4_last=0;
persist let d4_phase=0;

if(now<0 || (d4_started!=0 && now<d4_last)) { return 0-1; }
let delta=0;
if(d4_started!=0) { delta=now-d4_last; }
if(delta>240000) { delta=240000; }
let keys=uxe_dispatch(0,0,0);
if(keys<0) { return 0-1; }
// The browser maps KeyW and KeyS to bits 0 and 1 in that order.
let direction=keys%2-(keys/2)%2;
let phase=d4_phase+delta*12*direction;
if(phase<0-200000000) { phase=0-200000000; }
if(phase>300000000) { phase=300000000; }

let rest=384;
let framing=672;
let work=736;
if(d4_started==0) { let initialized=d4_input_facts(rest,framing); }
if(d4_started==0 || phase!=d4_phase) {
  let pose=D4_frame(rest,0,work,framing,phase/1000000.0,1,0);
  if(pose<0) { return pose; }
}
d4_phase=phase;
d4_last=now;
d4_started=1;
return 0;
