#pragma unisa use mem.heap

int main(int argc,char **argv) {
    if(argc!=2) return 2;
    char *args[]={"./ujs/ujs2wasm.com","ujs/practice/uxe/products/d4/d4-api.ujs",
        "ujs/practice/uxe/base/f64-math.ujs","ujs/practice/uxe/base/record-copy.ujs",
        "ujs/practice/uxe/products/d4/d4-frame.ujs","-o",argv[1],0};
    char *output=0;
    size_t size=0;
    const int rc=cx_runv_timeout(args,12,&output,&size);
    if(size && output) printf("%.*s",(int)size,output);
    mm_free(output);
    return rc;
}
