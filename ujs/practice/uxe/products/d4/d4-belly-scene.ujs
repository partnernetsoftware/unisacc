// Merge the shipped D4 abdomen v1 and main gear v1 ABI into an instance
// record. XYZ + scale and YXZ angles match the shared UXE scene renderer.
// The last angle is baked into the box mesh, before the instance transform.
struct D4BellyPart {
  x: f32;
  y: f32;
  z: f32;
  scale: f32;
  yaw: f32;
  pitch: f32;
  roll: f32;
  width: f32;
  height: f32;
  depth: f32;
  meshRoll: f32;
  red: f32;
  green: f32;
  blue: f32;
  mesh: u32;
}

native function d4_belly_span(at:i64,bytes:i64,align:i64) i64 {
  return at>=0 && at%align==0 && at<=6291456-bytes;
}

native function d4_belly_overlap(a:i64,n:i64,b:i64,m:i64) i64 {
  return a<b+m && b<a+n;
}

native function d4_belly_sizes(kind:i64,w:f64,h:f64,d:f64) i64 {
  if(kind==0) { return w>0.0 && h>0.0 && d>0.0; }
  if(kind==1) { return w>0.0 && h>0.0 && d==0.0; }
  return kind==2 && w==0.0 && h==0.0 && d==0.0;
}

native function d4_belly_bounded(value:f64) i64 {
  return value>=0.0-9007199254740991.0 && value<=9007199254740991.0;
}

native function d4_belly_shell_valid(src:i64) i64 {
  let kind=ux_u32(src+76);
  let scale=ux_f32(src);
  if(scale<=0.0 || !d4_belly_bounded(scale) ||
     !d4_belly_sizes(kind,ux_f32(src+64),ux_f32(src+68),ux_f32(src+72)) ||
     ux_u32(src+80)/16777216!=255 || ux_u32(src+84)!=0) { return 0; }
  let i=0;
  while(i<12) {
    let value=0.0;
    if(i==0 || (kind!=1 && (i==5 || i==10)) || (kind==1 && i==6)) { value=scale; }
    if(kind==1 && i==9) { value=0.0-scale; }
    if(ux_f32(src+i*4)!=value) { return 0; }
    i=i+1;
  }
  i=12;
  while(i<19) {
    if(!d4_belly_bounded(ux_f32(src+i*4))) { return 0; }
    i=i+1;
  }
  return ux_f32(src+60)==1.0;
}

native function d4_belly_gear_valid(src:i64) i64 {
  let kind=ux_u32(src+88);
  if(kind>1 || ux_u32(src+92)!=0 || ux_f64(src+24)<=0.0 ||
     !d4_belly_sizes(kind*2,ux_f64(src+56),ux_f64(src+64),ux_f64(src+72))) { return 0; }
  let i=0;
  while(i<11) {
    if(!d4_belly_bounded(ux_f64(src+i*8))) { return 0; }
    i=i+1;
  }
  return 1;
}

native function d4_belly_tint(dst:i64,color:i64,kind:i64) i64 {
  let r=ux_f32_put(dst+D4BellyPart.red,(color%256)/255.0);
  let g=ux_f32_put(dst+D4BellyPart.green,(color/256%256)/255.0);
  let b=ux_f32_put(dst+D4BellyPart.blue,(color/65536%256)/255.0);
  let mesh=ux_u32_put(dst+D4BellyPart.mesh,kind);
  return dst;
}

native function D4Belly_scene(output:i64,capacity:i64,abdomen:i64,gear:i64) i64 {
  let bytes=capacity*D4BellyPart.size;
  if(capacity<29 || capacity>65536 || !d4_belly_span(output,bytes,4) ||
     !d4_belly_span(abdomen,9*88,4) || !d4_belly_span(gear,20*96,8) ||
     d4_belly_overlap(output,bytes,abdomen,9*88) || d4_belly_overlap(output,bytes,gear,20*96)) { return 0-1; }
  let i=0;
  while(i<9) {
    if(!d4_belly_shell_valid(abdomen+i*88)) { return 0-2; }
    i=i+1;
  }
  i=0;
  while(i<20) {
    if(!d4_belly_gear_valid(gear+i*96)) { return 0-2; }
    i=i+1;
  }
  i=0;
  while(i<9) {
    let src=abdomen+i*88;
    let dst=output+i*D4BellyPart.size;
    let kind=ux_u32(src+76);
    let xyz=uxe_copy_record(dst,src+48,12);
    let scale=ux_u32_put(dst+D4BellyPart.scale,ux_u32(src));
    let a=ux_f32_put(dst+D4BellyPart.yaw,0.0);
    let b=ux_f32_put(dst+D4BellyPart.pitch,(kind==1)*1.5707963267948966);
    let c=ux_f32_put(dst+D4BellyPart.roll,0.0);
    let dims=uxe_copy_record(dst+D4BellyPart.width,src+64,12);
    let local=ux_f32_put(dst+D4BellyPart.meshRoll,0.0);
    let shade=d4_belly_tint(dst,ux_u32(src+80),kind);
    i=i+1;
  }
  i=0;
  while(i<20) {
    let src=gear+i*96;
    let dst=output+(i+9)*D4BellyPart.size;
    let field=0;
    while(field<11) {
      let saved=ux_f32_put(dst+field*4,ux_f64(src+field*8));
      field=field+1;
    }
    let shade=d4_belly_tint(dst,218+161*256+59*65536,ux_u32(src+88)*2);
    i=i+1;
  }
  return 29;
}

return D4Belly_scene(output,capacity,abdomen,gear);
