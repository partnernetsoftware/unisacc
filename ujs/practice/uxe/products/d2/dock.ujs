let dockNear = 14.0 + 216.0 * f64_floor_i64(boatZ / 216.0);
if (dockNear - boatZ >= 7.0 && dockNear + 11.0 - boatZ <= 72.0) {
  let dockAnchor = 0;
  while (dockAnchor < 2) {
    let dockZ = dockNear + dockAnchor * 11.0;
    let dockScale = 155.0 / (dockZ - boatZ);
    let dockBank = 5.4 * ux_sin(dockZ / 49.0) + 4.3 * ux_sin(dockZ / 117.0)
      - 13.2 - 1.9 * ux_sin(dockZ / 39.0);
    let dockX = 213.0 + (dockBank - boatX) * dockScale;
    packetWrite = ux_f32_put(512 + dockAnchor * 12, dockX - 5.0 * dockScale);
    packetWrite = ux_f32_put(516 + dockAnchor * 12, dockX + (6 - 3 * dockAnchor) * dockScale);
    packetWrite = ux_f32_put(520 + dockAnchor * 12, 90.0 + dockScale * 10.0);
    dockAnchor = dockAnchor + 1;
  }
  let dockTop = f64_floor_i64(ux_f32(532) + 0.5);
  let dockBottom = f64_floor_i64(ux_f32(520) + 0.5);
  let dockRow = dockTop;
  while (dockRow <= dockBottom && dockRow < 240) {
    let dockT = (dockRow - dockTop) * 1.0 / (dockBottom - dockTop);
    let dockL = f64_floor_i64(0.5 + ux_f32(524) + (ux_f32(512) - ux_f32(524)) * dockT);
    let dockR = f64_floor_i64(0.5 + ux_f32(528) + (ux_f32(516) - ux_f32(528)) * dockT);
    if (dockL < 0) { dockL = 0; }
    if (dockR > 425) { dockR = 425; }
    let dockInk = 4278190080 + 119 + 256 * 85 + 65536 * 62;
    if ((dockRow - dockTop) % 6 <= 1) { dockInk = 4278190080 + 94 + 256 * 74 + 65536 * 60; }
    if ((dockRow - dockTop) % 6 == 2) { dockInk = 4278190080 + 140 + 256 * 99 + 65536 * 63; }
    if (dockL <= dockR) { packetWrite = uxe_dispatch(11, dockL + 4096 * dockRow + 16777216 * dockR, dockInk); }
    dockRow = dockRow + 1;
  }
  let dockPost = 0;
  while (dockPost < 4) {
    let postT = dockPost / 3.0;
    let postY = f64_floor_i64(0.5 + dockTop + postT * (dockBottom - dockTop));
    let postX = f64_floor_i64(0.5 + ux_f32(528) + (ux_f32(516) - ux_f32(528)) * postT - 9.0);
    if (dockPost == 2) { postX = postX - 29; }
    let postWidth = 3 + dockPost;
    let postHeight = 13 + dockPost * 4;
    if (postX >= 0 && postX + postWidth <= 426 && postY + 4 < 240) {
      packetWrite = uxe_dispatch(13, postX + 4096 * (postY - postHeight)
        + 16777216 * postWidth + 68719476736 * (postHeight + 4), 4278190080 + 70 + 256 * 60 + 65536 * 46);
      packetWrite = uxe_dispatch(13, postX + 4096 * (postY - postHeight)
        + 16777216 * postWidth + 3 * 68719476736, 4278190080 + 189 + 256 * 142 + 65536 * 83);
    }
    dockPost = dockPost + 1;
  }
}
