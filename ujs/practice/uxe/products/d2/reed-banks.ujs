// World-spaced reed strips. Dark stalks, ochre tips and short water shadows.
let reedOrigin = f64_floor_i64(boatZ / 4.0) * 4;
let reedStrip = 19;
while (reedStrip >= 0) {
  let reedZ = reedOrigin + 13 + 4 * reedStrip;
  let reedDepth = reedZ - boatZ;
  if (reedDepth >= 11.0) {
    let reedScale = 155.0 / reedDepth;
    let reedCenter = 5.4 * ux_sin(reedZ / 49.0) + 4.3 * ux_sin(reedZ / 117.0);
    let reedWidth = 13.2 + 1.9 * ux_sin(reedZ / 39.0);
    let reedBase = f64_floor_i64(90.5 + 10.0 * reedScale);
    let reedSide = 0 - 1;
    while (reedSide <= 1) {
      let reedCount = 13;
      if (reedSide > 0) { reedCount = 25; }
      let reed = 0;
      while (reed < reedCount) {
        let reedMark = u32_xor(u32_mul(reed + 71, 374761393), u32_mul(reedZ + 168 + reedSide * 71, 668265263));
        reedMark = u32_mul(u32_xor(reedMark, u32_shr(reedMark, 13)), 1274126177);
        reedMark = u32_and(u32_xor(reedMark, u32_shr(reedMark, 16)), 255);
        let reedShallow = 1.1;
        if (reedDepth < 22.0) { reedShallow = 2.9; }
        let reedX = f64_floor_i64(213.5 + (reedCenter + reedSide * (reedWidth
          + (reedMark % 71) / 13.0 - reedShallow) - boatX) * reedScale);
        let reedHeight = f64_floor_i64(reedScale * (1.7 + (reedMark % 43) / 12.0) + 0.5);
        let reedLean = f64_floor_i64(reedHeight * (0.16 + (reedMark % 8) * 0.037));
        if (reedMark % 2 == 0) { reedLean = 0 - reedLean; }
        let reedRow = 0;
        while (reedRow < reedHeight) {
          let stalkX = reedX + reedLean * reedRow / reedHeight;
          let stalkY = reedBase - reedRow;
          if (stalkX >= 0 && stalkX < 426 && stalkY >= 0 && stalkY < 240) {
            let reedInk = 4278190080 + 48 + 256 * 64 + 65536 * 36;
            if (reedRow * 3 > reedHeight * 2 || reedMark % 6 == 0 && reedRow * 2 > reedHeight) {
              reedInk = 4278190080 + 143 + 256 * 133 + 65536 * 69;
            }
            packetWrite = uxe_dispatch(2, stalkY * 426 + stalkX, reedInk);
          }
          reedRow = reedRow + 1;
        }
        if (reedX >= 0 && reedX < 426 && reedBase + 2 < 240 && reedMark % 3 == 0) {
          packetWrite = uxe_dispatch(16, (reedBase + 2) * 426 + reedX, 58 + 256 * 77 + 65536 * 51 + 132 * 16777216);
        }
        reed = reed + 1;
      }
      reedSide = reedSide + 2;
    }
  }
  reedStrip = reedStrip - 1;
}
