let farCloud = 0;
while (farCloud < 4) {
  let cloudSite = 54 + 512 * 40 + 262144 * 62 + 33554432 * 15;
  if (farCloud == 1) { cloudSite = 155 + 512 * 59 + 262144 * 52 + 33554432 * 11; }
  if (farCloud == 2) { cloudSite = 356 + 512 * 26 + 262144 * 75 + 33554432 * 17; }
  if (farCloud == 3) { cloudSite = 331 + 512 * 71 + 262144 * 60 + 33554432 * 14; }
  let cloudLeft = cloudSite / 262144 % 128;
  let cloudHeight = cloudSite / 33554432;
  let cloudY = 0 - cloudHeight;
  while (cloudY <= cloudHeight) {
    let cloudX = 0 - cloudLeft;
    while (cloudX < cloudLeft) {
      let cloudNoise = u32_xor(u32_mul(160 + cloudX / 7 + farCloud, 374761393),
        u32_mul(202 + cloudY / 3, 668265263));
      cloudNoise = u32_mul(u32_xor(cloudNoise, u32_shr(cloudNoise, 13)), 1274126177);
      cloudNoise = u32_and(u32_xor(cloudNoise, u32_shr(cloudNoise, 16)), 255);
      if (cloudNoise >= 70 && cloudX * cloudX * cloudHeight * cloudHeight + cloudY * cloudY * cloudLeft * cloudLeft
          < cloudLeft * cloudLeft * cloudHeight * cloudHeight) {
        let cloudColumn = cloudSite % 512 + cloudX - f64_floor_i64(boatX * 0.4 + 0.5);
        let cloudRow = cloudSite / 512 % 512 + cloudY;
        let cloudPaint = 4278190080 + 236 + 256 * 174 + 65536 * 92;
        if (cloudY > 1) { cloudPaint = 4278190080 + 203 + 256 * 150 + 65536 * 88; }
        if (cloudColumn >= 0 && cloudColumn < 424 &&
            ((cloudColumn - waterSun) * (cloudColumn - waterSun) + (cloudRow - 53) * (cloudRow - 53) > 529.0 ||
             cloudNoise > 210)) {
          packetWrite = uxe_dispatch(13, cloudColumn + 4096 * cloudRow + 16777216 * 3 + 68719476736 * 2, cloudPaint);
        }
      }
      cloudX = cloudX + 3;
    }
    cloudY = cloudY + 2;
  }
  farCloud = farCloud + 1;
}
let ridge = 0;
while (ridge < 3) {
  let ridgeCol = 0;
  while (ridgeCol < 426) {
    let ridgeDist = ridgeCol - 213.0 + boatX * 0.8;
    if (ridgeDist < 0.0) { ridgeDist = 0.0 - ridgeDist; }
    ridgeDist = ridgeDist - 15.0 - 9.0 * ridge;
    if (ridgeDist > 0.0) {
      let ridgeShape = 0.62 + ux_sin(ridgeCol * 0.043 + ridge * 2.7) * 0.27
        + ux_sin(ridgeCol * 0.016 - ridge + 1.5707963267948966) * 0.18;
      let ridgeRise = f64_floor_i64(0.5 + ridgeDist * (13 + ridge * 15) * ridgeShape / 426.0);
      if (ridgeRise > 0) {
        packetWrite = uxe_dispatch(13, ridgeCol + 4096 * (90 - ridgeRise) + 16777216 * 2
          + 68719476736 * ridgeRise, 4278190080 + 203 - ridge * 33 + 256 * (148 - ridge * 25) + 65536 * (79 - ridge * 10));
      }
    }
    ridgeCol = ridgeCol + 2;
  }
  ridge = ridge + 1;
}
