if (uxe_dispatch(4, 0, 4096) == 4096) {
  let titleMirrorRow = 0;
  while (titleMirrorRow < 24) {
    let titleMirrorSway = (titleMirrorRow + boatTick / 3) % 12;
    if (titleMirrorSway > 6) { titleMirrorSway = 12 - titleMirrorSway; }
    let titleMirrorAlpha = (82 - titleMirrorRow * 3) * (8 + titleMirrorSway) / 14;
    let titleMirrorGlyph = 0;
    while (titleMirrorGlyph < 4) {
      let titleMirrorCol = 0;
      while (titleMirrorCol < 16) {
        if (uxe_dispatch(8, 1024 * titleMirrorGlyph + 4 * (16 * (15 - titleMirrorRow * 2 / 3) + titleMirrorCol) + 3, 0) == 255) {
          packetWrite = uxe_dispatch(16, (156 + titleMirrorRow) * 426 + 175 + titleMirrorGlyph * 20
            + titleMirrorCol + titleMirrorSway - 3, 255 + 256 * 217 + 65536 * 158 + 16777216 * titleMirrorAlpha);
        }
        titleMirrorCol = titleMirrorCol + 1;
      }
      titleMirrorGlyph = titleMirrorGlyph + 1;
    }
    titleMirrorRow = titleMirrorRow + 1;
  }
}
