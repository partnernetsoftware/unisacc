// Crossings repeat every reach. Draw the farther crossing first.
let bridgeFirst = f64_floor_i64(boatZ / 216.0);
let bridgeSegment = bridgeFirst + 1;
while (bridgeSegment >= bridgeFirst) {
  let bridgeZ = bridgeSegment * 216.0 + 24.0;
  let bridgeDepth = bridgeZ - boatZ;
  if (bridgeDepth >= 9.0 && bridgeDepth <= 300.0) {
    let bridgeScale = 155.0 / bridgeDepth;
    let bridgeRiver = 5.4 * ux_sin(bridgeZ / 49.0) + 4.3 * ux_sin(bridgeZ / 117.0);
    let bridgeX = f64_floor_i64(213.5 + (bridgeRiver - boatX) * bridgeScale);
    let bridgeSpan = f64_floor_i64((13.2 + 1.9 * ux_sin(bridgeZ / 39.0)) * bridgeScale);
    let bridgeY = f64_floor_i64(90.5 + bridgeScale * 10.0);
    let bridgeTop = f64_floor_i64(90.5 + bridgeScale * 5.0);
    let bridgeDeck = f64_floor_i64(bridgeScale * 0.85);
    if (bridgeDeck < 2) { bridgeDeck = 2; }
    let bridgeWood = 4278190080 + 101 + 256 * 58 + 65536 * 42;
    let bridgeTrim = 4278190080 + 141 + 256 * 113 + 65536 * 80;
    let bridgeRailY = bridgeTop - 7;
    let bridgeOffset = 0 - bridgeSpan;
    while (bridgeOffset <= bridgeSpan) {
      let bridgeCol = bridgeX + bridgeOffset;
      if (bridgeCol >= 0 && bridgeCol < 426 && bridgeSpan > 0) {
        let bridgeFoot = bridgeTop + bridgeDeck
          + f64_floor_i64(4.0 * bridgeScale * bridgeOffset * bridgeOffset / (bridgeSpan * bridgeSpan));
        packetWrite = uxe_dispatch(10, bridgeCol + 4096 * bridgeTop + 16777216 * bridgeFoot, bridgeWood);
        packetWrite = uxe_dispatch(2, bridgeTop * 426 + bridgeCol, bridgeTrim);
        if (bridgeOffset % 7 == 0) {
          packetWrite = uxe_dispatch(10, bridgeCol + 4096 * bridgeRailY + 16777216 * (bridgeTop - 1), bridgeWood);
        } else {
          packetWrite = uxe_dispatch(2, bridgeRailY * 426 + bridgeCol, bridgeWood);
        }
      }
      bridgeOffset = bridgeOffset + 1;
    }
    let bridgeSide = 0 - 1;
    while (bridgeSide <= 1) {
      let legX = bridgeX + f64_floor_i64(bridgeSide * bridgeSpan * 0.77 + 0.5);
      let legHalf = f64_floor_i64(bridgeScale * 0.55 + 0.5);
      if (legHalf < 2) { legHalf = 2; }
      if (legX - legHalf >= 0 && legX + legHalf < 426) {
        packetWrite = uxe_dispatch(13, legX - legHalf + 4096 * bridgeTop
          + 16777216 * (2 * legHalf + 1) + 68719476736 * (bridgeY - bridgeTop), bridgeWood);
      }
      bridgeSide = bridgeSide + 2;
    }
    if (bridgeDepth < 135.0) {
      let lampLane = 0 - 2;
      let lampSize = f64_floor_i64(bridgeScale * 0.47 + 0.5);
      if (lampSize < 1) { lampSize = 1; }
      while (lampLane <= 2) {
        let lampX = bridgeX + f64_floor_i64(lampLane * bridgeSpan * 0.42 + 0.5);
        if (lampX >= 2 && lampX + lampSize < 426) {
          packetWrite = uxe_dispatch(10, lampX + 4096 * (bridgeTop - 12) + 16777216 * (bridgeTop - 1), bridgeWood);
          packetWrite = uxe_dispatch(13, lampX - 2 + 4096 * (bridgeTop - 12)
            + 16777216 * (lampSize + 2) + 68719476736 * (lampSize + 3), 4278190080 + 171 + 256 * 103 + 65536 * 66);
          packetWrite = uxe_dispatch(13, lampX - 1 + 4096 * (bridgeTop - 11)
            + 16777216 * lampSize + 68719476736 * (lampSize + 1), 4278190080 + 255 + 256 * 233 + 65536 * 163);
          let shimmerLength = f64_floor_i64(bridgeScale * 4.8 + 0.5);
          let shimmerRow = 0;
          while (shimmerRow < shimmerLength) {
            let shimmerY = bridgeY + 2 + shimmerRow;
            if (shimmerY < 240) {
              let shimmerFade = 1.0 - shimmerRow * 1.0 / shimmerLength;
              let shimmerSway = ux_sin(shimmerY * 0.44 + (boatTick % 256) * 0.13);
              let shimmerCenter = lampX + f64_floor_i64(shimmerSway * 2.0 + 0.5);
              let shimmerHalf = f64_floor_i64(bridgeScale * (0.11 + 0.23 * shimmerFade)
                * (1.0 + 0.25 * shimmerSway) + 0.5);
              if (shimmerHalf < 1) { shimmerHalf = 1; }
              let shimmerSeed = u32_xor(u32_mul(shimmerRow + 71, 374761393), u32_mul(lampX + 97, 668265263));
              shimmerSeed = u32_mul(u32_xor(shimmerSeed, u32_shr(shimmerSeed, 13)), 1274126177);
              shimmerSeed = u32_and(u32_xor(shimmerSeed, u32_shr(shimmerSeed, 16)), 255);
              if (shimmerSeed >= 36) {
                let shimmerPixel = shimmerCenter - shimmerHalf;
                while (shimmerPixel <= shimmerCenter + shimmerHalf) {
                  let shimmerAlpha = 71 + f64_floor_i64(138.0 * shimmerFade + 0.5);
                  if (shimmerPixel == shimmerCenter && shimmerSeed > 140) {
                    shimmerAlpha = 107 + f64_floor_i64(125.0 * shimmerFade + 0.5);
                  }
                  if (shimmerPixel >= 0 && shimmerPixel < 426) {
                    packetWrite = uxe_dispatch(16, shimmerY * 426 + shimmerPixel,
                      255 + 256 * 221 + 65536 * 151 + 16777216 * shimmerAlpha);
                  }
                  shimmerPixel = shimmerPixel + 1;
                }
              }
            }
            shimmerRow = shimmerRow + 1;
          }
        }
        lampLane = lampLane + 1;
      }
    }
  }
  bridgeSegment = bridgeSegment - 1;
}
