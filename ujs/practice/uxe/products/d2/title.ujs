// The base owns the glyph bytes. The product selects the reach and layout.
let titleAtlas = uxe_dispatch(4, 0, 24320);
if (titleAtlas == 24320) {
  let titleGlyph = 0;
  while (titleGlyph < 4) {
    packetWrite = uxe_dispatch(15, 4096 + 175 + titleGlyph * 20 + 8192 * (4096 + 18)
      + 67108864 * 16 + 4294967296 * 16 + 274877906944, titleGlyph * 1024);
    titleGlyph = titleGlyph + 1;
  }
  let titleReach = f64_floor_i64(boatZ / 216.0);
  if (titleReach > 7) { titleReach = 7; }
  let reachFirst = 4 + 2 * titleReach;
  let reachSecond = reachFirst + 1;
  if (titleReach == 5) { reachSecond = 0; }
  if (titleReach >= 6) { reachFirst = reachFirst - 1; reachSecond = reachSecond - 1; }
  let titleInk = 4278190080 + 249 + 256 * 230 + 65536 * 187;
  packetWrite = uxe_dispatch(14, 192 + 4096 * 45 + 16777216 * (32769 + titleReach), titleInk);
  packetWrite = uxe_dispatch(14, 198 + 4096 * 45 + 16777216 * 4688, titleInk);
  packetWrite = uxe_dispatch(14, 204 + 4096 * 45 + 16777216 * 32776, titleInk);
  packetWrite = uxe_dispatch(15, 4096 + 215 + 8192 * (4096 + 43)
    + 67108864 * 8 + 4294967296 * 8 + 274877906944, 19456 + reachFirst * 256);
  packetWrite = uxe_dispatch(15, 4096 + 225 + 8192 * (4096 + 43)
    + 67108864 * 8 + 4294967296 * 8 + 274877906944, 19456 + reachSecond * 256);
}
