let lilyRing = 7;
while (lilyRing >= 0) {
  let lilyZ = 6 * f64_floor_i64(boatZ / 6.0) + 13 + lilyRing * 2;
  let lilyDepth = lilyZ - boatZ;
  if (lilyDepth >= 11.0) {
    let lilyScale = 155.0 / lilyDepth;
    let lilyBase = f64_floor_i64(90.5 + lilyScale * 10.0);
    let lilyRiver = 0.0;
    let lilyHalf = 13.2;
    let lilyTerm = 0;
    while (lilyTerm < 3) {
      let lilyFactor = 5.4;
      let lilyDivisor = 49.0;
      if (lilyTerm == 1) { lilyFactor = 4.3; lilyDivisor = 117.0; }
      if (lilyTerm == 2) { lilyFactor = 1.9; lilyDivisor = 39.0; }
      let lilySine = lilyFactor * ux_sin(lilyZ / lilyDivisor);
      if (lilyTerm < 2) { lilyRiver = lilyRiver + lilySine; }
      else { lilyHalf = lilyHalf + lilySine; }
      lilyTerm = lilyTerm + 1;
    }
    let lilySide = 0 - 1;
    while (lilySide <= 1) {
      let lilyX = f64_floor_i64(213.5 + (lilyRiver + lilySide * lilyHalf
        * (0.53 + (lilyRing * 13 + lilySide * 3 + 20) % 20 / 100.0) - boatX) * lilyScale);
      let lilyW = f64_floor_i64(lilyScale * (0.75 + (lilyRing * 5 + lilySide + 1) % 7 / 14.0));
      if (lilyW < 3) { lilyW = 3; }
      let lilyH = 2 + lilyW / 4;
      if (lilyBase >= 148 && lilyBase <= 237 && lilyX - lilyW >= 0 && lilyX + lilyW < 426) {
        let lilyRow = 0 - lilyH;
        while (lilyRow <= lilyH) {
          let lilySpan = lilyW - lilyW * lilyRow * lilyRow / (lilyH * lilyH + 1);
          let lilyStart = lilyX - lilySpan;
          let lilyEnd = lilyX + lilySpan;
          if (lilyRow < 0 && lilyRow * 5 > 0 - 4 * lilyH) {
            if (lilySide < 0) { lilyStart = lilyStart + lilySpan / 3; }
            else { lilyEnd = lilyEnd - lilySpan / 3; }
          }
          packetWrite = uxe_dispatch(11, lilyStart + 4096 * (lilyBase + lilyRow + 2) + 16777216 * lilyEnd,
            4278190080 + 95 + 256 * 62 + 65536 * 45);
          packetWrite = uxe_dispatch(11, lilyStart + 4096 * (lilyBase + lilyRow) + 16777216 * lilyEnd,
            4278190080 + 108 + 256 * 130 + 65536 * 67);
          lilyRow = lilyRow + 1;
        }
        if ((lilyRing + lilySide) % 3 == 0) {
          packetWrite = uxe_dispatch(10, lilyX + 4096 * (lilyBase - 8) + 16777216 * lilyBase,
            4278190080 + 84 + 256 * 99 + 65536 * 63);
          packetWrite = uxe_dispatch(13, lilyX - 1 + 4096 * (lilyBase - 10) + 16777216 * 3 + 4 * 68719476736,
            4278190080 + 188 + 256 * 105 + 65536 * 87);
          packetWrite = uxe_dispatch(17, 4096 + lilyX + 8192 * (4096 + lilyBase - 11) + 2 * 67108864,
            255 + 256 * 221 + 65536 * 151 + 190 * 16777216);
        }
      }
      lilySide = lilySide + 2;
    }
  }
  lilyRing = lilyRing - 1;
}
