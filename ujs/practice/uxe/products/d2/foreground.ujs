let prowX = 213 + f64_floor_i64(boatYaw * 9.0 + 0.5);
let prowY = 188 + f64_floor_i64(ux_sin((boatTick % 256) * 0.17) + 0.5);
let prowLayer = 0;
while (prowLayer < 3) {
  let prowTop = prowY + 4 * prowLayer;
  let prowKnee = prowY + 14 + 2 * prowLayer;
  let prowBeam = 27 - 6 * prowLayer;
  let prowBroad = 68 - 13 * prowLayer;
  let prowPaint = 4278190080 + 53 + 256 * 37 + 65536 * 44;
  if (prowLayer == 1) { prowPaint = 4278190080 + 99 + 256 * 68 + 65536 * 74; }
  if (prowLayer == 2) { prowPaint = 4278190080 + 71 + 256 * 50 + 65536 * 59; }
  let prowRow = prowTop;
  while (prowRow < 240) {
    let prowHalf = (prowRow - prowTop) * prowBeam / (prowKnee - prowTop);
    if (prowRow > prowKnee) {
      prowHalf = prowBeam + (prowRow - prowKnee) * (prowBroad - prowBeam) / (240 - prowKnee);
    }
    packetWrite = uxe_dispatch(11, prowX - prowHalf + 4096 * prowRow + 16777216 * (prowX + prowHalf), prowPaint);
    prowRow = prowRow + 1;
  }
  prowLayer = prowLayer + 1;
}
let board = 0;
while (board < 5) {
  let boardHalf = 10 + board * 6;
  let boardInk = 4278190080 + 119 + 256 * 81 + 65536 * 73;
  if (board % 2 == 1) { boardInk = 4278190080 + 147 + 256 * 99 + 65536 * 79; }
  packetWrite = uxe_dispatch(13, prowX - boardHalf + 4096 * (prowY + 15 + board * 8)
    + 16777216 * 2 * boardHalf + 68719476736 * 2, boardInk);
  board = board + 1;
}
let lanternIron = 4278190080 + 54 + 256 * 41 + 65536 * 51;
packetWrite = uxe_dispatch(13, prowX - 2 + 4096 * (prowY - 30) + 16777216 * 3 + 68719476736 * 32, lanternIron);
packetWrite = uxe_dispatch(13, prowX - 1 + 4096 * (prowY - 34) + 16777216 * 11 + 68719476736 * 3, lanternIron);
packetWrite = uxe_dispatch(13, prowX + 9 + 4096 * (prowY - 32) + 16777216 * 3 + 68719476736 * 6, lanternIron);
packetWrite = uxe_dispatch(13, prowX + 6 + 4096 * (prowY - 26) + 16777216 * 9 + 68719476736 * 11,
  4278190080 + 166 + 256 * 98 + 65536 * 67);
packetWrite = uxe_dispatch(13, prowX + 7 + 4096 * (prowY - 25) + 16777216 * 7 + 68719476736 * 8,
  4278190080 + 255 + 256 * 181 + 65536 * 104);
packetWrite = uxe_dispatch(13, prowX + 9 + 4096 * (prowY - 23) + 16777216 * 3 + 68719476736 * 5,
  4278190080 + 255 + 256 * 240 + 65536 * 175);

let mote = 0;
while (mote < 46) {
  let phase = boatTick % 2048 + mote * 17;
  if (phase % 29 < 22) {
    let moteX = f64_floor_i64(0.5 + (mote * 73 + 11) % 426 + ux_sin(phase * 0.083) * 5.0 - boatX * 1.4);
    let moteY = f64_floor_i64(93.5 + (mote * 47 + 23) % 125 + ux_sin(phase * 0.053) * 2.0);
    if (mote % 7 == 0) {
      packetWrite = uxe_dispatch(17, 4096 + moteX + 8192 * (4096 + moteY) + 2 * 67108864,
        242 + 256 * 188 + 65536 * 105 + 170 * 16777216);
    }
    if (moteX >= 0 && moteX < 426) {
      packetWrite = uxe_dispatch(2, moteY * 426 + moteX, 4278190080 + 255 + 256 * 228 + 65536 * 165);
    }
  }
  mote = mote + 1;
}
