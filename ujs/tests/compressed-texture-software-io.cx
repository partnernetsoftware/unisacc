#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define READ(surface,level) "let n=CompressedTextureSoft_read(32," #surface "," #level ",1024,64);if(n<0){return 0.0+n;}return 0.0+ux_u32(1024);"

#define DISPATCH(format,bytes) "let a=CompressedTextureLoader_level(128,768," #bytes ",4,4," \
    #format ");let tagged=ux_u32_put(128+CompressedMip.format," #format ");" \
    "let used=ux_u32_put(128+CompressedMip.bytes," #bytes ");let start=ux_u32_put(128+CompressedMip.data,768);" \
    "let shape=ux_u32_put(128+CompressedMip.width,4);let height=ux_u32_put(128+CompressedMip.height,4);" \
    "let t=CompressedTextureSoft_init(32,1,1,1,128);" READ(0,0)

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","compressedtextureloader",
        "compressed-texture-bc1","compressed-texture-bc2","compressed-texture-bc3","compressed-texture-bc4",
        "compressed-texture-bc5","compressed-texture-etc1","compressed-texture-astc-constant",
        "compressed-texture-eac","compressed-texture-etc2","compressed-texture-software",0};
    const char setup[]=
        "let i=0;while(i<12){let side=4;if(i%2){side=2;}"
        "let data=512+i*8;let word=63488;if(i%3==1){word=2016;}if(i%3==2){word=31;}"
        "let color=ux_u32_put(data,word);let a=CompressedTextureLoader_level(128+i*CompressedMip.size,data,8,side,side,33776);i=i+1;}";
    const char *cases[]={
        "return 0.0+CompressedTextureSoft_init(32,1,1,2,128);",
        "let t=CompressedTextureSoft_init(32,1,1,2,128);" READ(0,0),
        "let t=CompressedTextureSoft_init(32,1,1,2,128);" READ(0,1),
        "let t=CompressedTextureSoft_init(32,2,2,2,128);" READ(1,0),
        "let t=CompressedTextureSoft_init(32,3,6,2,128);" READ(5,1),
        "let t=CompressedTextureSoft_init(32,3,6,2,128);" READ(6,0),
        "return 0.0+CompressedTextureSoft_init(32,3,5,2,128);",
        "let changed=ux_u32_put(128+CompressedMip.size+CompressedMip.width,3);return 0.0+CompressedTextureSoft_init(32,1,1,2,128);",
        "let t=CompressedTextureSoft_init(32,1,1,2,128);let gone=CompressedTextureSoft_dispose(32);" READ(0,0),
        "let t=CompressedTextureSoft_init(32,2,2,2,128);return 0.0+CompressedTextureSoft_read(32,0,1,528,64);",
        DISPATCH(33778,16),DISPATCH(33779,16),DISPATCH(36283,8),DISPATCH(36286,16),DISPATCH(36196,8),
        "let mark=ux_u32_put(768,4294966780);let tail=ux_u32_put(772,4294967295);"
        "let red=ux_u32_put(776,65535);let alpha=ux_u32_put(780,4294901760);" DISPATCH(37808,16),
        DISPATCH(37492,8),DISPATCH(37494,8),
        "let mark=ux_u32_put(768,4294966780);let tail=ux_u32_put(772,4294967295);"
        "let red=ux_u32_put(776,65535);let alpha=ux_u32_put(780,4294901760);" DISPATCH(37821,16),
    };
    const double gold[]={32,0xff0000ffu,0xff00ff00u,0xffff0000u,0xffff0000u,-1,-1,-3,-1,-1,
        0,0,0xff000000u,0x7f000000u,0xff020202u,0xff0000ffu,0xff020202u,0xff000000u,0xff0000ffu};
    return g_wasm_batch("G_IO CompressedTexture software surfaces","compressed-texture-software",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?4:-1,
        "let t=CompressedTextureSoft_init(32,3,6,2,128);" READ(4,1));
}
