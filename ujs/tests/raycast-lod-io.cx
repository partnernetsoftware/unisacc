#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d","lod",
        "raycast-memory","scene-snapshot-layout","raycast-lod",0};
    const char *setup="let arena=Object3D_initArena(0,4);let root=Object3D_create(arena);"
        "let small=Object3D_create(arena);let big=Object3D_create(arena);let origin=2304;let out=2560;"
        "let lod=LOD_init(2048,arena,root,2112,2);let a=LOD_addLevel(lod,arena,small,0.0,0.0);"
        "let b=LOD_addLevel(lod,arena,big,10.0,0.0);"
        "let rootAt=Object3D_address(arena,root);let smallAt=Object3D_address(arena,small);"
        "let smallMat=ux_u32(smallAt+Object3D.worldMatrix);let l=ux_u32_put(smallAt+Object3D.layerMask,2);"
        "let invisible=ux_u32_put(smallAt+Object3D.visible,0);";
    #define READ "let n=LOD_raycastSceneRow(origin,1,arena,lod,out);"
    const char *cases[]={
        READ "return 0.0+n;",
        READ "return 0.0+(ux_u32(out+SceneSnapshotRow.node)==small);",
        READ "return 0.0+ux_u32(out+SceneSnapshotRow.layerMask);",
        READ "return 0.0+ux_u32(out+SceneSnapshotRow.visible);",
        READ "return 0.0+(ux_u32(out+SceneSnapshotRow.worldMatrix)==smallMat);",
        "let x=ux_f64_put(origin,11.0);" READ "return 0.0+(ux_u32(out+SceneSnapshotRow.node)==big);",
        "let a=ux_u32_put(rootAt+Object3D.layerMask,2);let keep=ux_u32_put(out,77);"
        READ "return 0.0+(n==0 && ux_u32(out)==77);",
        "return 0.0+LOD_raycastSceneRow(origin,1,arena,lod,2112);",
    };
    const double gold[]={1,1,1,0,1,1,1,-1};
    return g_wasm_batch_page("G_RAY LOD direct scene delegation","raycast-lod",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,READ "return 0.0+ux_u32(smallAt+Object3D.layerMask);");
}
