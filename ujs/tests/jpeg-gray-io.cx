#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","jpeg-header","jpeg-entropy","jpeg-idct","jpeg-gray",0};
    unsigned char bytes[160];int size=0;
    const unsigned char quant[]={255,216,255,219,0,67,0};
    for(int i=0;i<7;i++) bytes[size++]=quant[i];
    for(int i=0;i<64;i++) bytes[size++]=1;
    const unsigned char sof[]={255,192,0,11,8,0,3,0,5,1,1,17,0,255,196,0,39};
    for(int i=0;i<17;i++) bytes[size++]=sof[i];
    bytes[size++]=0;bytes[size++]=1;
    for(int i=0;i<15;i++) bytes[size++]=0;
    bytes[size++]=7;
    bytes[size++]=16;bytes[size++]=1;bytes[size++]=1;
    for(int i=0;i<14;i++) bytes[size++]=0;
    const unsigned char ending[]={6,0,255,218,0,8,1,1,0,0,63,0,64,65,127,255,217};
    for(int i=0;i<17;i++) bytes[size++]=ending[i];
    unsigned char reset[170];
    const int scan=size-15;
    for(int i=0;i<scan;i++) reset[i]=bytes[i];
    reset[79]=9;
    const unsigned char dri[]={255,221,0,4,0,1};
    for(int i=0;i<6;i++) reset[scan+i]=dri[i];
    for(int i=0;i<10;i++) reset[scan+6+i]=bytes[scan+i];
    const unsigned char data[]={64,191,255,208,63,191,255,217};
    for(int i=0;i<8;i++) reset[scan+16+i]=data[i];
    const int reset_size=scan+24;
    char setup[1800];int n=tx_snprintf(setup,sizeof setup,"let size=%d;let bytes=[",size);
    for(int i=0;i<size;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",bytes[i]);
    n+=tx_snprintf(setup+n,sizeof setup-n,"];let i=0;while(i<size){let a=ux_u8_put(i,bytes[i]);i=i+1;}let extra=%d;let reset=[",reset_size);
    for(int i=0;i<reset_size;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",reset[i]);
    tx_snprintf(setup+n,sizeof setup-n,"];i=0;while(i<extra){let a=ux_u8_put(256+i,reset[i]);i=i+1;}");
    const char *cases[]={
        "return 0.0+JpegDecode_gray(0,size,512,60,1024,2048);",
        "let n=JpegDecode_gray(0,size,512,60,1024,2048);return 0.0+ux_u8(512);",
        "let n=JpegDecode_gray(0,size,512,60,1024,2048);return 0.0+ux_u8(568);",
        "let n=JpegDecode_gray(0,size,512,60,1024,2048);return 0.0+ux_u8(571);",
        "return 0.0+JpegDecode_gray(0,size-1,512,60,1024,2048);",
        "let bad=ux_u8_put(size-3,126);return 0.0+JpegDecode_gray(0,size,512,60,1024,2048);",
        "let guard=ux_u8_put(512,79);let bad=ux_u8_put(size-3,126);let n=JpegDecode_gray(0,size,512,60,1024,2048);"
        "return 0.0+ux_u8(512);",
        "return 0.0+JpegDecode_gray(0,size,512,56,1024,2048);",
        "let n=JpegDecode_gray(256,extra,512,108,1024,2048);return 0.0+ux_u8(512);",
        "let n=JpegDecode_gray(256,extra,512,108,1024,2048);return 0.0+ux_u8(544);"
    };
    const double gold[]={60,142,135,255,-6,-6,79,-1,136,120};
    return g_wasm_batch("G_IO JpegGray","jpeg-gray",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let n=JpegDecode_gray(0,size,512,60,1024,2048);return 0.0+ux_u8(568);");
}
