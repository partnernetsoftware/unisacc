#pragma unisa use g_geometry
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","geometry-buffers","polyhedrongeometry","octahedrongeometry",0};
    char source[480];
    tx_snprintf(source,sizeof source,"let mesh=GeometryBuffers_init(0,256,24,1024,0);"
        "return OctahedronGeometry_generate(mesh,2048,%d.0,0);",mutate?2:1);
    const int faces[8][3]={{2,4,0},{4,3,0},{3,5,0},{5,2,0},{2,5,1},{5,3,1},{3,4,1},{4,2,1}};
    double gold[194]={24,0};
    int at=2;
    for(int face=0;face<8;face++) {
        int normal[3]={0};
        for(int corner=0;corner<3;corner++) {
            int direction=faces[face][corner];
            normal[direction/2]=1-2*(direction%2);
        }
        for(int corner=0;corner<3;corner++) {
            int direction=faces[face][corner];
            for(int axis=0;axis<3;axis++) gold[at++]=axis==direction/2?1-2*(direction%2):0;
            for(int axis=0;axis<3;axis++) gold[at++]=normal[axis]*0.5773502691896257645;
            double u=0.5, v=0.5;
            if(direction==0) u=normal[2]<0?0:1;
            if(direction==4) u=0.75;
            if(direction==5) u=0.25;
            if(direction==2 || direction==3) {
                u=0.5+normal[2]*(normal[0]>0?0.375:0.125);
                v=direction==2?1:0;
            }
            gold[at++]=u;
            gold[at++]=v;
        }
    }
    return g_geometry_check("OctahedronGeometry","octahedrongeometry",modules,source,gold,at,at);
}
