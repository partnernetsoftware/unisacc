#pragma unisa use g_math
#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

static const char prelude[] =
    "let a=Vector3_set(0,2.0,0.0-3.0,6.0);let b=Vector3_set(24,0.0-4.0,5.0,2.0);"
    "let axis=Vector3_set(48,1.0,0.0,0.0);let z=Vector3_set(72,0.0,0.0,1.0);";

static const char matrices[] =
    "let m00=ux_f64_put(96,2.0);let m11=ux_f64_put(128,3.0);let m22=ux_f64_put(160,4.0);"
    "let t0=ux_f64_put(176,2.0);let t1=ux_f64_put(216,3.0);let t2=ux_f64_put(256,4.0);"
    "let t3=ux_f64_put(272,10.0);let t4=ux_f64_put(280,0.0-8.0);"
    "let t5=ux_f64_put(288,7.0);let t6=ux_f64_put(296,1.0);"
    "let c0=ux_f64_put(304,1.0);let c1=ux_f64_put(344,1.0);let c2=ux_f64_put(384,1.0);"
    "let c3=ux_f64_put(400,3.0);let c4=ux_f64_put(408,2.0);let c5=ux_f64_put(416,1.0);"
    "let c6=ux_f64_put(424,1.0);";

static double root(double number) {
    double estimate = number;
    for (int i = 0; i < 16; i++) estimate = (estimate + number / estimate) * 0.5;
    return estimate;
}

int main(int argc, char **argv) {
    int mutate = argc == 2 && tx_eqz(argv[1], "--mutate");
    if (argc != 1 && !mutate) return 2;
    const char *cases[] = {
        "let r=Vector3_set(a,8.0,9.0,10.0);return ux_f64(r+16);",
        "let r=Vector3_copy(a,b);return ux_f64(r+16);",
        "let r=Vector3_add(a,b);return ux_f64(r+16);",
        "let r=Vector3_sub(a,b);return ux_f64(r+8);",
        "let r=Vector3_multiplyScalar(a,0.0-2.0);return ux_f64(r+16);", "return Vector3_dot(a,b);",
        "let r=Vector3_crossVectors(440,a,b);return ux_f64(r+8);",
        "let r=Vector3_cross(a,b);return ux_f64(r+16);", "return Vector3_lengthSq(a);", "return Vector3_length(a);",
        "let r=Vector3_normalize(a);return ux_f64(r+16);", "return Vector3_distanceToSquared(a,b);",
        "return Vector3_distanceTo(a,b);",
        "let r=Vector3_applyMatrix3(a,96);return ux_f64(r+16);",
        "let r=Vector3_applyNormalMatrix(a,96);return ux_f64(r+16);",
        "let r=Vector3_applyMatrix4(a,176);return ux_f64(r+8);",
        "let r=Vector3_transformDirection(a,176);return ux_f64(r+16);",
        "let r=Vector3_project(a,304,176);return ux_f64(r);",
        "let r=Vector3_unproject(a,176,304);return ux_f64(r);",
        "let p=ux_f64_put(456,0.7071067811865475);let q=ux_f64_put(464,0.7071067811865476);"
        "let r=Vector3_applyQuaternion(a,440);return ux_f64(r);",
        "let r=Vector3_applyAxisAngle(a,0.0+z,1.5707963267948966);return ux_f64(r+8);",
        "let p=ux_f64_put(440,1.5707963267948966);let q=ux_f64_put(456,1.5707963267948966);"
        "let r=Vector3_applyEuler(a,440);return ux_f64(r+8);",
        "let p=ux_f64_put(440,1.5707963267948966);let q=ux_f64_put(456,1.5707963267948966);"
        "let w=ux_u32_put(464,3);let r=Vector3_applyEuler(a,440);return ux_f64(r);",
        "let r=Vector3_multiply(a,b);return ux_f64(r+16);",
        "let r=Vector3_divide(a,b);return ux_f64(r+16);",
        "let r=Vector3_projectOnVector(a,axis);return ux_f64(r);",
        "let r=Vector3_projectOnPlane(a,axis);return ux_f64(r);",
        "let r=Vector3_reflect(a,axis);return ux_f64(r);",
        "let perp=Vector3_set(440,3.0,2.0,0.0);return Vector3_angleTo(a,perp);",
        "let r=Vector3_lerp(a,0.0+b,0.25);return ux_f64(r+16);", "return Vector3_manhattanLength(a);",
        "return Vector3_manhattanDistanceTo(a,b);", "let r=Vector3_setLength(a,14.0);return ux_f64(r+16);",
        "let r=Vector3_setFromSphericalCoords(a,2.0,1.5707963267948966,0.0);return ux_f64(r+16);",
        "let r=Vector3_setFromCylindricalCoords(a,3.0,1.5707963267948966,4.0);return ux_f64(r);",
        "let r=Vector3_clone(440,a);return Vector3_equals(a,r);",
        "let r=Vector3_setScalar(a,0.0-6.0);return ux_f64(r+16);",
        "let r=Vector3_setX(a,8.0);return ux_f64(r);",
        "let r=Vector3_setY(a,0.0-9.0);return ux_f64(r+8);",
        "let r=Vector3_setZ(a,11.0);return ux_f64(r+16);",
        "let r=Vector3_setComponent(a,2.0,9.5);return ux_f64(r+16);",
        "return Vector3_getComponent(a,2);",
        "let r=Vector3_addScalar(a,2.5);return ux_f64(r+8);",
        "let r=Vector3_subScalar(a,5.0);return ux_f64(r+16);",
        "let r=Vector3_addVectors(440,a,b);return ux_f64(r);",
        "let r=Vector3_subVectors(440,a,b);return ux_f64(r+8);",
        "let r=Vector3_multiplyVectors(440,a,b);return ux_f64(r+16);",
        "let r=Vector3_addScaledVector(a,0.0+b,0.5);return ux_f64(r+8);",
        "let r=Vector3_divideScalar(a,2.0);return ux_f64(r+16);",
        "let r=Vector3_negate(a);return ux_f64(r+16);",
        "let r=Vector3_lerpVectors(440,0.0+a,0.0+b,0.25);return ux_f64(r);",
        "let r=Vector3_setFromMatrixPosition(a,176);return ux_f64(r+8);",
        "let r=Vector3_setFromMatrixScale(a,176);return ux_f64(r+16);",
        "let r=Vector3_setFromMatrixColumn(a,176,3);return ux_f64(r);",
        "let r=Vector3_setFromMatrix3Column(a,96,1);return ux_f64(r+8);",
        "let e=Vector3_set(440,0.125,0.25,0.5);let r=Vector3_setFromEuler(a,e);return ux_f64(r+16);",
        "let c=Vector3_set(440,0.125,0.25,0.5);let r=Vector3_setFromColor(a,c);return ux_f64(r+8);",
        "let s=Vector3_set(440,2.0,1.5707963267948966,0.0);let r=Vector3_setFromSpherical(a,s);return ux_f64(r+16);",
        "let c=Vector3_set(440,3.0,1.5707963267948966,4.0);let r=Vector3_setFromCylindrical(a,c);return ux_f64(r+8);",
        "let p=Vector3_set(448,2.0,0.0-3.0,6.0);let r=Vector3_fromArray(a,440,1);return ux_f64(r+16);",
        "let r=Vector3_toArray(a,440,1);return ux_f64(464);",
        "let p=ux_f32_put(460,0.3);let r=Vector3_fromBufferAttribute(a,440,2,1,12);return ux_f64(r+16);",
        "let r=Vector3_random(a,0.125,0.625,0.25);return ux_f64(r+16);",
        "let r=Vector3_randomDirection(a,0.75,0.25);return ux_f64(r+8);",
        "let r=Vector3_min(a,b);return ux_f64(r);",
        "let r=Vector3_max(a,b);return ux_f64(r+8);",
        "let lo=Vector3_set(440,0.0-1.0,0.0-2.0,0.0-3.0);let hi=Vector3_set(464,1.0,2.0,3.0);"
        "let r=Vector3_clamp(a,lo,hi);return ux_f64(r+16);",
        "let r=Vector3_clampScalar(a,0.0-2.0,2.0);return ux_f64(r+8);",
        "let r=Vector3_clampLength(a,0.0,3.5);return ux_f64(r+16);",
        "let p=Vector3_set(440,1.5,0.0-2.25,3.75);let r=Vector3_floor(p);return ux_f64(r+8);",
        "let p=Vector3_set(440,1.5,0.0-2.25,3.75);let r=Vector3_ceil(p);return ux_f64(r);",
        "let p=Vector3_set(440,1.5,0.0-2.25,3.75);let r=Vector3_round(p);return ux_f64(r+16);",
        "let p=Vector3_set(440,1.5,0.0-2.25,3.75);let r=Vector3_roundToZero(p);return ux_f64(r+16);",
        "return Vector3_getComponent(a,2);"
    };
    enum { count = sizeof cases / sizeof cases[0] };
    const double gold[count] = {10,2,8,-8,-12,-11,-28,-2,49,7,6.0/7.0,116,root(116),
        24,24.0/root(673),-17,24.0/root(673),20,17,3,2,-6,6,12,3,2,0,-2,1.5707963267948966,
        5,11,18,12,2,3,1, -6,8,-9,11,9.5,6,-0.5,1,-2,-8,12,-0.5,3,-6,0.5,
        -8,4,10,3,0.5,0.25,2,4,6,6,(double)(float)0.3,0.25,root(0.75),-4,5,3,-2,3,-3,2,4,3,6};
    char dir[256], source[300], wasm[300], initialization[1600], library[45000];
    unsigned char *vectors = 0, *math = 0, *views = 0, *scalar = 0;
    int64_t content_size = 0;
    double reference[count];
    int rc = sy_read_file("ujs/practice/uxe/base/vector3.ujs", &vectors, &content_size, 35000) ||
        sy_read_file("ujs/practice/uxe/base/f64-math.ujs", &math, &content_size, 9000) ||
        sy_read_file("ujs/practice/uxe/base/views.ujs", &views, &content_size, 4000) ||
        sy_read_file("ujs/practice/uxe/base/vector-scalar.ujs", &scalar, &content_size, 4000);
    int n = rc ? -1 : tx_snprintf(library, sizeof library, "%s\n%s\n%s\n%s", math, views, scalar, vectors);
    mm_free(vectors); mm_free(math); mm_free(views); mm_free(scalar);
    if (n < 0 || n >= (int)sizeof library || sy_mkdtemp("/tmp", "ujs-vector3-", dir, sizeof dir)) return 2;
    tx_snprintf(initialization, sizeof initialization, "%s\n%s", prelude, matrices);
    tx_snprintf(source, sizeof source, "%s/probe.ujs", dir);
    tx_snprintf(wasm, sizeof wasm, "%s/probe.wasm", dir);
    int failed = g_math_reference("vector3", reference, count, dir);
    for (int i = 0; !failed && i < count; i++) {
        double actual = 0;
        const char *test = mutate && i == 5 ? "return Vector3_dot(a,a);" : cases[i];
        if (g_math_sample(source, wasm, library, initialization, test, &actual) ||
            !g_math_near(actual, gold[i], 1e-9) || !g_math_near(reference[i], gold[i], 1e-9)) {
            printf("VECTOR3 case=%d actual=%.17g r160=%.17g gold=%.17g\n", i, actual, reference[i], gold[i]);
            failed = 1;
        }
    }
    char *cleanup[] = {"rm", "-rf", "--", dir, 0};
    char *out = 0;
    size_t out_size = 0;
    if (cx_runv_timeout(cleanup, 5, &out, &out_size)) failed = 1;
    mm_free(out);
    printf("G_MATH Vector3 cases=%d failed=%d\n", count, failed);
    return failed;
}
