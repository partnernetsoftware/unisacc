#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","mesh-layout","skeleton-layout",
        "skinnedmesh-deform","skinnedmesh","helper-buffers","source","object-json-tokens",
        "json-read","json-bytes","record-copy","loaderutils","json-string-decode",
        "source-json","source-json-read","skeleton-json","skinnedmesh-bind-json",0};
    const char *setup="struct Source { data: u32; version: u32; dataReady: u32; }\n"
        "let src=SkinnedMesh_init(128,160,256,384);let dst=SkinnedMesh_init(512,544,640,768);"
        "let matrix=Matrix4_makeScale(1024,2.0,1.0,1.0);let bound=SkinnedMesh_bind(src,1152,matrix);"
        "let mode=ux_u32_put(src+SkinnedMesh.bindMode,2);let id=ux_u8_put(1180,115);"
        "let a=ux_u32_put(2048,576791163);let b=ux_u32_put(2052,12346);"
        "let end=SkinnedMesh_writeBindingJSON(src,2054,2560,1180,1,4096);if(end<0){return 0.0+end;}"
        "let stop=json_byte(end,2560,125);";
    const char *cases[]={
        "let ok=SkinnedMesh_readBindingJSON(dst,2048,stop,1152,1180,1,4096);if(ok<0){return 0.0+ok;}return 0.0+ux_u32(dst+SkinnedMesh.bindMode);",
        "let ok=SkinnedMesh_readBindingJSON(dst,2048,stop,1152,1180,1,4096);if(ok<0){return 0.0+ok;}return ux_f64(640);",
        "let ok=SkinnedMesh_readBindingJSON(dst,2048,stop,1152,1180,1,4096);if(ok<0){return 0.0+ok;}return ux_f64(768);",
        "let ok=SkinnedMesh_readBindingJSON(dst,2048,stop,1152,1180,1,4096);if(ok<0){return 0.0+ok;}return 0.0+(ux_u32(dst+SkinnedMesh.skeleton)==1152);",
        "let changed=ux_u8_put(1180,120);let bad=SkinnedMesh_readBindingJSON(dst,2048,stop,1152,1180,1,4096);return 10.0*bad+ux_u32(dst+SkinnedMesh.bindMode);",
    };
    const double gold[]={2,2,0.5,1,-9};
    return g_wasm_batch("G_STRUCT SkinnedMesh JSON binding","skinnedmesh-bind-json",modules,setup,cases,gold,5,
        mutate?0:-1,"let changed=ux_u8_put(2067,97);let rejected=SkinnedMesh_readBindingJSON(dst,2048,stop,1152,1180,1,4096);return 0.0+rejected;");
}
