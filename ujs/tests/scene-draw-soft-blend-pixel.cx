#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","scene-snapshot-layout","render-list","scene-render-list","scene-draw-project",
        "scene-rgba8-blend","scene-draw-software",0};
    const char *setup=
        "let target=0;let verts=64;let rgba=512;let depth=640;"
        "let t=ux_u32_put(target+SceneRasterTarget.rgba,rgba);"
        "let d=ux_u32_put(target+SceneRasterTarget.depth,depth);"
        "let w=ux_u32_put(target+SceneRasterTarget.width,4);let h=ux_u32_put(target+SceneRasterTarget.height,4);"
        "let n=0;while(n<16){let clearColor=ux_u32_put(rgba+4*n,4278190335);let clearDepth=ux_f32_put(depth+4*n,0.75);n=n+1;}"
        "n=0;while(n<6){let v=verts+n*28;let x=0.5;let y=0.5;"
        "if(n==0||n==3||n==5){x=0.0-0.5;}if(n>=2&&n!=3){y=0.0-0.5;}"
        "let u=ux_f32_put(v,x);let z=ux_f32_put(v+4,y);"
        "let b=ux_f32_put(v+20,1.0);let a=ux_f32_put(v+24,0.5);n=n+1;}";
    #define DRAW "let hits=SceneDraw_softwareColor(target,verts,6,1);"
    const char *cases[]={
        DRAW "return 0.0+hits;",
        DRAW "return 0.0+(ux_u8(rgba+20)==127 && ux_u8(rgba+22)==128);",
        DRAW "return ux_f32(depth+20);",
        "let bad=ux_f32_put(verts+52,0.25);" DRAW "return 0.0+(hits==0-2 && ux_u32(rgba+20)==4278190335);",
        "let near=ux_f32_put(depth+20,0.25);" DRAW "return 0.0+(hits==3 && ux_u32(rgba+20)==4278190335);",
    };
    const double gold[]={4,1,0.75,1,1};
    return g_wasm_batch_page("G_PIXEL software flat alpha","scene-draw-soft-blend",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,5,mutate?0:-1,
        "let clipped=ux_f32_put(verts+28,0.0-0.5);" DRAW "return 0.0+hits;");
}

