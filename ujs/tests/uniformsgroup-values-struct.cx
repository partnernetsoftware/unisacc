#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","object-layouts","eventdispatcher","uniform","uniformsgroup",
        "uniform-std140","uniformsgroup-values",0};
    const char *setup=
        "let src=UniformsGroup_init(0,128,4);let dst=UniformsGroup_init(48,192,8);"
        "let shape=288;let items=256;let fields=384;let arena=1024;"
        "let v=Uniform_init(320,fields);let m=Uniform_init(324,fields+8);"
        "let o=Uniform_init(328,fields+16);let s=Uniform_init(332,fields+24);"
        "let v0=ux_u32_put(fields+UniformField.kind,3);let v1=ux_u32_put(fields+UniformField.source,512);"
        "let m0=ux_u32_put(fields+8+UniformField.kind,5);let m1=ux_u32_put(fields+8+UniformField.source,544);"
        "let o0=ux_u32_put(fields+16+UniformField.kind,7);let o1=ux_u32_put(fields+16+UniformField.source,640);"
        "let s0=ux_u32_put(fields+24+UniformField.kind,1);let s1=ux_u32_put(fields+24+UniformField.source,672);"
        "let x=ux_f32_put(512,1.0);let y=ux_f32_put(516,2.0);let z=ux_f32_put(520,3.0);"
        "let scalar=ux_f32_put(672,0.25);let token=ux_u32_put(640,17);"
        "let i=0;while(i<9){let cell=ux_f32_put(544+i*4,i+1.0);i=i+1;}"
        "let n=UniformsGroup_setName(src,77);let u=UniformsGroup_setUsage(src,35048);"
        "let a=UniformsGroup_add(src,v);let b=UniformsGroup_add(src,items);"
        "let c=UniformsGroup_add(src,o);let d=UniformsGroup_add(src,s);"
        "let j=ux_u32_put(items,m);let k=ux_u32_put(items+4,v);let nested=ux_u32_put(shape+4,2);"
        "let sourceEvents=EventDispatcher_init(src,736,2);let dl=EventDispatcher_init(dst,768,2);"
        "let f=UniformsGroup_addEventListener(src,3,91);let g=UniformsGroup_addEventListener(dst,3,92);";
    #define COPY "let copy=UniformsGroup_copyValues(dst,src,shape,arena,512);"
    #define UF(N) "ux_u32(ux_u32(196+" #N "*4)+Uniform.value)"
    #define LOC(N) "ux_u32(" UF(N) "+UniformField.source)"
    #define NOT_ALIAS "let altered=ux_f32_put(512,99.0);return ux_f32(" LOC(0) ");"
    const char *cases[]={
        COPY "return 0.0+ux_u32(dst+UniformsGroup.count);",
        COPY "return 0.0+ux_u32(dst+UniformsGroup.name);",
        COPY "return 0.0+ux_u32(dst+UniformsGroup.usage);",
        COPY "return 0.0+(ux_u32(196)!=v && ux_u32(204)!=v && ux_u32(196)!=ux_u32(204));",
        COPY "return 0.0+(" LOC(0) "!=" LOC(2) ");",
        COPY NOT_ALIAS,
        COPY "let changed=ux_f32_put(" LOC(0) ",44.0);return ux_f32(" LOC(2) ");",
        COPY "return ux_f32(" LOC(1) "+32);",
        COPY "let moved=ux_u32_put(640,18);return 0.0+ux_u32(" LOC(3) ");",
        COPY "return ux_f32(" LOC(4) ");",
        COPY "return 0.0+UniformsGroup_hasEventListener(dst,3,92);",
        COPY "return 0.0+UniformsGroup_hasEventListener(dst,3,91);",
        COPY "let fieldCopy=uxe_copy_record(1600," UF(1) ",UniformField.size);"
          "let packed=UniformsGroup_packStd140(1600,1,1632,64);return ux_f32(1672);",
        "let mark=ux_u32_put(dst+UniformsGroup.name,55);let invalid=ux_u32_put(fields+24+UniformField.kind,9);"
          COPY "return 0.0+ux_u32(dst+UniformsGroup.name);",
        "return 0.0+UniformsGroup_copyValues(dst,src,shape,arena,16);",
        "return 0.0+UniformsGroup_copyValues(dst,src,shape,768,512);",
        "let empty=ux_u32_put(shape+4,4294967295);" COPY "return 0.0+ux_u32(dst+UniformsGroup.count);",
    };
    const double gold[]={5,77,35048,1,1,1,1,9,18,0.25,1,0,9,55,-2,-1,3};
    return g_wasm_batch_page("G_STRUCT UniformsGroup typed value copy","uniformsgroup-values",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?5:-1,COPY
        "let alias=ux_u32_put(" UF(0) "+UniformField.source,512);" NOT_ALIAS);
}
