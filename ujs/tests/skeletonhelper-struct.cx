#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"helper-buffers","skeletonhelper",0};
    const char *setup="let helper=0;let xyz=128;let rgb=256;let pairs=384;let matrix=512;let inv=640;let parent=768;"
        "let child=896;let grand=1024;let empty=1152;"
        "let p0=ux_u32_put(pairs,child);let p1=ux_u32_put(pairs+4,parent);"
        "let p2=ux_u32_put(pairs+8,grand);let p3=ux_u32_put(pairs+12,child);"
        "let a=ux_f64_put(matrix+96,10.0);let b=ux_f64_put(matrix+104,20.0);"
        "let c=ux_f64_put(inv+8,0.0-1.0);let d=ux_f64_put(inv+32,1.0);let e=ux_f64_put(inv+80,1.0);"
        "let f=ux_f64_put(inv+96,0.0-20.0);let g=ux_f64_put(inv+104,10.0);let h=ux_f64_put(inv+120,1.0);"
        "let i=ux_f64_put(parent+96,10.0);let j=ux_f64_put(parent+104,21.0);"
        "let k=ux_f64_put(child+96,7.0);let l=ux_f64_put(child+104,21.0);"
        "let m=ux_f64_put(grand+96,7.0);let n=ux_f64_put(grand+104,25.0);let o=ux_f64_put(grand+112,2.0);"
        "let init=SkeletonHelper_init(helper,xyz,rgb,matrix,pairs,2);";
    const char *cases[]={
        "return 0.0+ux_u32(helper+SkeletonHelper.count);",
        "return ux_f32(xyz+4);",
        "return ux_f32(rgb+8);",
        "return ux_f32(rgb+16);",
        "let up=SkeletonHelper_update(helper,inv);return ux_f32(xyz+4);",
        "let up=SkeletonHelper_update(helper,inv);return ux_f32(xyz+16);",
        "let up=SkeletonHelper_update(helper,inv);return ux_f32(xyz+24);",
        "let up=SkeletonHelper_update(helper,inv);return ux_f32(xyz+32);",
        "let up=SkeletonHelper_update(helper,inv);return ux_f32(xyz+40);",
        "let up=SkeletonHelper_update(helper,inv);return 0.0+ux_u32(helper+SkeletonHelper.positionVersion);",
        "let a=ux_f64_put(child+96,4.0);let up=SkeletonHelper_update(helper,inv);return ux_f32(xyz+4);",
        "return ux_f64(ux_u32(helper+SkeletonHelper.matrix)+96);",
        "let a=SkeletonHelper_init(empty,xyz,rgb,matrix,pairs,0);return 0.0+ux_u32(empty+SkeletonHelper.count);",
        "let gone=SkeletonHelper_dispose(helper);return 0.0+ux_u32(helper+SkeletonHelper.active);",
        "let gone=SkeletonHelper_dispose(helper);return 0.0+SkeletonHelper_update(helper,inv);",
        "let bad=ux_u32_put(pairs+12,6291456);return 0.0+SkeletonHelper_update(helper,inv);",
        "let bad=ux_u32_put(pairs+12,6291456);let up=SkeletonHelper_update(helper,inv);return ux_f32(xyz+4);",
    };
    const double gold[]={4,0,1,1,3,0,5,2,3,1,6,10,0,0,-1,-1,0};
    return g_wasm_batch("G_STRUCT SkeletonHelper","skeletonhelper",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?4:-1,"let up=SkeletonHelper_update(helper,inv);return ux_f32(xyz+16);");
}
