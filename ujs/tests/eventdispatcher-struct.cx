#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","eventdispatcher",0};
    const char *setup="let d=EventDispatcher_init(0,32,8);"
        "let a=EventDispatcher_addEventListener(d,1,11);"
        "let again=EventDispatcher_addEventListener(d,1,11);"
        "let other=EventDispatcher_addEventListener(d,2,99);"
        "let b=EventDispatcher_addEventListener(d,1,22);"
        "let first=EventDispatcher_dispatchEvent(d,1,7,112,4);"
        "let removed=EventDispatcher_removeEventListener(d,1,22);"
        "let c=EventDispatcher_addEventListener(d,1,33);"
        "let second=EventDispatcher_dispatchEvent(d,1,7,144,4);";
    const char *cases[]={
        "return first==2;",
        "return ux_u32(116);",
        "return ux_u32(120);",
        "return ux_u32(124);",
        "return EventDispatcher_hasEventListener(d,1,22);",
        "return second;",
        "return ux_u32(156);",
        "return EventDispatcher_hasEventListener(d,2,99);"
    };
    const double gold[]={1,2,11,22,0,2,33,1};
    return g_math_run("G_STRUCT EventDispatcher","eventdispatcher",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?3:-1,"return ux_u32(156);");
}
