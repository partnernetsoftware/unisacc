#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","eventdispatcher",0};
    const char *setup=
        "function dispatch_probe(ctx,...ev) {"
        "let d0=ctx[0];let j=ux_u32(200);let l=ux_u32_put(204+4*j,ev[0]);"
        "let n=ux_u32_put(200,j+1);"
        "if(ev[0]==11){let dropped=EventDispatcher_removeEventListener(d0,1,22);"
        "let added=EventDispatcher_addEventListener(d0,1,33);}"
        "return ev[1];}"
        "let d=EventDispatcher_init(0,32,8);"
        "let a=EventDispatcher_addEventListener(d,1,11);"
        "let again=EventDispatcher_addEventListener(d,1,11);"
        "let other=EventDispatcher_addEventListener(d,2,99);"
        "let b=EventDispatcher_addEventListener(d,1,22);"
        "let callback=closure(dispatch_probe,d);"
        "let before=EventDispatcher_hasEventListener(d,1,22);"
        "let first=EventDispatcher_dispatchCallback(callback,d,1,7,112,4);"
        "let second=EventDispatcher_dispatchCallback(callback,d,1,7,144,4);";
    const char *cases[]={
        "return before;",
        "return ux_u32(116);",
        "return ux_u32(204);",
        "return ux_u32(208);",
        "return EventDispatcher_hasEventListener(d,1,22);",
        "return second;",
        "return ux_u32(216);",
        "return EventDispatcher_hasEventListener(d,2,99);"
    };
    const double gold[]={1,2,11,22,0,2,33,1};
    return g_math_run("G_STRUCT EventDispatcher","eventdispatcher",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?3:-1,"return ux_u32(216);");
}
