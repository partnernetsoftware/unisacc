#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"curve-line","curve-bezier","path","shape","record-copy","path-lifecycle",0};
    const char *setup="let contour=Path_init(0,256,5);let hole=Path_init(64,768,3);"
        "let a=Path_moveTo(contour,0.0,0.0);let b=Path_lineTo(contour,6.0,0.0);"
        "let c=Path_quadraticCurveTo(contour,8.0,3.0,6.0,6.0);"
        "let d=Path_lineTo(contour,0.0,6.0);let e=Path_closePath(contour);"
        "let ha=Path_moveTo(hole,1.0,1.0);let hb=Path_lineTo(hole,3.0,1.0);"
        "let hc=Path_lineTo(hole,2.0,3.0);let hd=Path_closePath(hole);"
        "let shape=Shape_init(128,contour,1024,1);let h=Shape_addHole(shape,hole);"
        "let clone=Shape_clone(4096,shape,5000,3000);"
        "let outer=ux_u32(clone+Shape.contour);let holes=ux_u32(clone+Shape.holes);"
        "let inner=ux_u32(holes);";
    const char *cases[]={
        "return ux_u32(outer+Path.count);","return ux_u32(clone+Shape.count);",
        "return ux_u32(inner+Path.count);","return Path_getPoints(outer,11000,12,2,11520);",
        "let sampled=Path_getPoints(outer,11000,12,2,11520);return ux_f64(11032);",
        "let changed=ux_f64_put(792,10.0);return ux_f64(ux_u32(inner+Path.segments)+24);",
        "let individual=Path_clone(12000,contour,12504,5);"
        "if(individual<0){return individual;}return ux_u32(individual+Path.count);",
        "let short=Path_init(12000,12504,2);let one=Path_lineTo(short,1.0,1.0);"
        "let copied=Path_copy(short,contour);return (copied==(0-2))*10+ux_u32(short+Path.count);",
        "return Shape_clone(13000,shape,13504,8);"
    };
    const double gold[]={4,1,3,6,7,3,4,11,-2};
    return g_math_run("G_STRUCT Path and Shape lifecycle","path-lifecycle",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?5:-1,
        "let changed=ux_f64_put(792,10.0);return ux_f64(792);");
}
