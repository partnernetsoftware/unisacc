#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"control-bindings",0};
    const char *cases[]={
        "return 0.0+OrbitControls_mouseBinding(0,0,0);",
        "return 0.0+OrbitControls_mouseBinding(0,1,0);",
        "return 0.0+OrbitControls_mouseBinding(0,2,0);",
        "return 0.0+OrbitControls_mouseBinding(1,0,0);",
        "return 0.0+OrbitControls_mouseBinding(1,1,0);",
        "return 0.0+OrbitControls_mouseBinding(1,2,0);",
        "return 0.0+OrbitControls_mouseBinding(1,0,1);",
        "return 0.0+OrbitControls_mouseBinding(1,2,1);",
        "return 0.0+OrbitControls_touchBinding(0,1);",
        "return 0.0+OrbitControls_touchBinding(0,2);",
        "return 0.0+OrbitControls_touchBinding(1,1);",
        "return 0.0+OrbitControls_touchBinding(1,2);",
        "return 0.0+OrbitControls_touchBinding(1,3);",
    };
    const double gold[]={0,1,2,2,1,0,0,2,0,2,1,3,-1};
    return g_wasm_batch_addon("G_RAY OrbitControls action bindings","control-bindings",argv[1],modules,"",cases,gold,
        sizeof gold/sizeof gold[0],mutate?11:-1,"return 0.0+OrbitControls_touchBinding(0,2);");
}
