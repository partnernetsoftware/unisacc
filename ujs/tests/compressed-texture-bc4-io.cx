#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define PIXEL(n) "return 0.0+ux_u32(512+4*" #n ");"
#define U(n) "let n=CompressedTexture_decodeBC4(32,512,100);" PIXEL(n)
#define S(n) "let n=CompressedTexture_decodeBC4(64,512,100);" PIXEL(n)
#define UP(r) (0xff000000u+(r))
#define SP(r) (0x7f000000u+((r)<0?(r)+256:(r)))

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","compressedtextureloader","compressed-texture-bc4",0};
    const char setup[]=
        "native function bc4_fixture(at:i64,a:i64,b:i64,c:i64,d:i64,e:i64) i64 {"
        "let x=ux_u8_put(at,a);let y=ux_u8_put(at+1,b);"
        "let i=0;while(i<2){let q=ux_u8_put(at+2+3*i,c);let r=ux_u8_put(at+3+3*i,d);"
        "let s=ux_u8_put(at+4+3*i,e);i=i+1;}return at;}"
        "let u=CompressedTexture_bc4Level(32,128,32,5,5,36283);"
        "let s=CompressedTexture_bc4Level(64,192,32,5,5,36284);"
        "let a=bc4_fixture(128,210,0,136,198,250);let b=bc4_fixture(136,20,220,255,255,255);"
        "let c=bc4_fixture(144,40,190,136,198,250);let d=bc4_fixture(152,77,77,6,0,0);"
        "let e=bc4_fixture(192,128,63,136,198,250);let f=bc4_fixture(200,63,193,136,198,250);"
        "let g=bc4_fixture(208,129,128,7,0,0);let h=bc4_fixture(216,255,0,2,0,0);";
    const char *cases[]={
        "return 0.0+u;",
        "return 0.0+s;",
        "return 0.0+CompressedTexture_decodeBC4(32,512,100);",
        U(0),U(1),U(2),U(3),U(4),U(5),U(6),U(7),U(8),U(9),
        U(20),U(21),U(22),U(23),U(24),
        S(0),S(1),S(2),S(3),S(4),S(5),S(6),S(7),S(8),S(9),S(20),S(24),
        "let a=ux_u8_put(612,173);let n=CompressedTexture_decodeBC4(32,512,100);return 0.0+ux_u8(612);",
        "let a=ux_u8_put(512,173);let n=CompressedTexture_decodeBC4(32,512,99);return 0.0+n*1000+ux_u8(512);",
        "return 0.0+CompressedTexture_decodeBC4(32,130,100);",
        "return 0.0+CompressedTexture_decodeBC4(32,32,100);",
        "let a=ux_u32_put(32+CompressedMip.data,32);return 0.0+CompressedTexture_decodeBC4(32,512,100);",
        "let a=ux_u32_put(32+CompressedMip.data,6291430);return 0.0+CompressedTexture_decodeBC4(32,512,100);",
        "let a=ux_u32_put(32+CompressedMip.bytes,31);return 0.0+CompressedTexture_decodeBC4(32,512,100);",
        "let a=ux_u32_put(32+CompressedMip.format,36285);return 0.0+CompressedTexture_decodeBC4(32,512,100);",
        "let a=ux_u32_put(32+CompressedMip.width,0);return 0.0+CompressedTexture_decodeBC4(32,512,100);",
        "return 0.0+CompressedTexture_bc4Level(96,256,16,5,5,36283);",
        "return 0.0+CompressedTexture_bc4Level(96,256,32,5,5,36286);",
    };
    const double gold[]={
        32,64,100, UP(210),UP(0),UP(180),UP(150),UP(255),UP(120),UP(90),UP(60),UP(30),UP(255),
        UP(40),UP(190),UP(70),UP(100),UP(0),
        SP(-127),SP(63),SP(-89),SP(-51),SP(63),SP(-13),SP(25),SP(-127),SP(127),SP(9),SP(-127),SP(0),
        173,-827,-1,-1,-1,-3,-3,-2,-3,-3,-2,
    };
    return g_wasm_batch("G_IO CompressedTexture software BC4","compressed-texture-bc4",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let changed=ux_u8_put(130,137);let n=CompressedTexture_decodeBC4(32,512,100);" PIXEL(0));
}
