#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int write=argc==2 && tx_eqz(argv[1],"--write");
    int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char header[]="symbol\tid\toperation\n";
    const char *symbols[]={"TangentSpaceNormalMap","ObjectSpaceNormalMap"};
    const char *methods[]={"tangentSpace","objectSpace"};
    unsigned char *facts=0,*old=0;
    int64_t bytes=0,old_bytes=0;
    int failed=sy_read_file("ujs/practice/uxe/base/gpu-normal-map.tsv",&facts,&bytes,1024);
    if(!failed && (bytes<sizeof header-1 || !tx_prefix((char *)facts,bytes,header,sizeof header-1))) failed=1;
    char code[4096];
    int rows=0,used=0,ids[2],ops[2];
#define EMIT(...) do { int n=tx_snprintf(code+used,sizeof code-used,__VA_ARGS__); \
    if(n<0 || n>=sizeof code-used) failed=1; else used+=n; } while(0)
    EMIT("// Generated by gpu-normal-map-gen.cx.\n");
    for(int at=sizeof header-1;!failed && at<bytes;) {
        int tab=at;
        while(tab<bytes && facts[tab]!='\t' && facts[tab]!='\n') tab++;
        if(rows>=2 || tab+4>=bytes || !tx_same((char *)facts+at,tab-at,symbols[rows],tx_len(symbols[rows],32)) ||
           facts[tab]!='\t' || facts[tab+2]!='\t' || facts[tab+4]!='\n' ||
           facts[tab+1]<'0' || facts[tab+1]>'9' || facts[tab+3]!='0'+rows) { failed=1; break; }
        ids[rows]=facts[tab+1]-'0';
        ops[rows]=facts[tab+3]-'0';
        if(rows>0 && ids[rows-1]>=ids[rows]) { failed=1; break; }
        EMIT("native function GpuNormalMap_%s() i64 { return %d; } // %s\n",methods[rows],ids[rows],symbols[rows]);
        rows++;
        at=tab+5;
    }
    if(!failed && rows==2) {
        EMIT("native function gpu_normal_map_operation(mode:i64) i64 {\n");
        for(int i=0;!failed && i<rows;i++) EMIT("  if(mode==%d) { return %d; }\n",ids[i],mutate?1-ops[i]:ops[i]);
        EMIT("  return 0-2;\n}\n");
    } else failed=1;
#undef EMIT
    const char *path="ujs/practice/uxe/base/gpu-normal-map-generated.ujs";
    if(!failed) failed=write?sy_write_file(path,code,used,0644)!=0:
        sy_read_file(path,&old,&old_bytes,sizeof code) || !tx_same((char *)old,old_bytes,code,used);
    mm_free(facts);
    mm_free(old);
    printf("NORMAL_MAP_GENERATE rows=%d failed=%d\n",rows,failed);
    return failed;
}
