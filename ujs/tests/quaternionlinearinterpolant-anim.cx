#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","vector-scalar","quaternion","animation-view",
        "discreteinterpolant","quaternionlinearinterpolant",0};
    const char *setup=
        "let a=ux_f32_put(64,0.0);let b=ux_f32_put(68,2.0);"
        "let w=ux_f32_put(140,1.0);let z=ux_f32_put(152,-1.0);"
        "let view=AnimationSamples_init(0,64,128,2,4);";
    const char *cases[]={
        "let p=QuatLinearInterpolant_evaluate(view,-1.0,192,256);return ux_f32(p+12);",
        "let p=QuatLinearInterpolant_evaluate(view,1.0,192,256);return ux_f32(p+8);",
        "let p=QuatLinearInterpolant_evaluate(view,1.0,192,256);return ux_f32(p+12);",
        "let p=QuatLinearInterpolant_evaluate(view,2.0,192,256);return ux_f32(p+8);",
        "let a=ux_f32_put(152,0.0);let b=ux_f32_put(156,-1.0);"
        "let p=QuatLinearInterpolant_evaluate(view,1.0,192,256);return ux_f32(p+12);",
        "return QuatLinearInterpolant_evaluate(view,1.0,192,192);"
    };
    const double gold[]={1,(float)-0.7071067811865476,(float)0.7071067811865476,-1,1,-1};
    return g_math_run("G_ANIM QuaternionLinearInterpolant","quaternionlinearinterpolant",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let p=QuatLinearInterpolant_evaluate(view,0.0,192,256);return ux_f32(p+8);");
}
