#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"vector-scalar","vector3","box3","box3-scene",0};
    const char *setup=
        "let r=0.7071067811865476;let m0=ux_f64_put(128,r);let m1=ux_f64_put(136,r);"
        "let m4=ux_f64_put(160,0.0-r);let m5=ux_f64_put(168,r);let m10=ux_f64_put(208,1.0);let m15=ux_f64_put(248,1.0);"
        "let n0=ux_f64_put(256,1.0);let n5=ux_f64_put(296,1.0);let n10=ux_f64_put(336,1.0);"
        "let n12=ux_f64_put(352,5.0);let n15=ux_f64_put(376,1.0);"
        "let px=ux_f32_put(412,2.0);let py=ux_f32_put(428,2.0);"
        "let cached=Vector3_set(448,0.0,0.0,0.0);let hi=Vector3_set(472,1.0,1.0,1.0);"
        "let a0=ux_u32_put(512,128);let a1=ux_u32_put(516,4294967295);let a2=ux_u32_put(520,400);"
        "let a3=ux_u32_put(524,3);let a4=ux_u32_put(528,12);let a5=ux_u32_put(532,1);let a6=ux_u32_put(536,1);"
        "let b0=ux_u32_put(540,256);let b1=ux_u32_put(544,448);";
    const char *cases[]={
        "let s=Box3_setFromObject(0,512,2,0,64);return ux_f64(s+32);",
        "let s=Box3_setFromObject(0,512,2,1,64);return ux_f64(s+32);",
        "let s=Box3_setFromObject(0,512,2,0,64);return ux_f64(s+24);",
        "let s=Box3_setFromObject(0,512,2,1,64);return ux_f64(s);",
        "let lo=Vector3_set(600,0.0-10.0,0.0-10.0,0.0-10.0);let hi2=Vector3_set(624,0.0,0.0,0.0);"
        "let b=Box3_set(0,lo,hi2);let s=Box3_expandByObject(b,512,2,1,64);return ux_f64(s);",
        "let s=Box3_setFromObject(0,512,0,0,64);return Box3_isEmpty(s);",
        "let s=Box3_setFromObject(0,512,2,1,64);let e=Box3_makeEmpty(600);return Box3_containsBox(s,e);"
    };
    const double gold[]={2.8284271247461903,1.4142135623730951,6,-1.4142135623730951,-10,1,1};
    return g_math_run("G_MATH Box3 objects","box3-scene",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?1:-1,"let s=Box3_setFromObject(0,512,2,0,64);return ux_f64(s+32);");
}
