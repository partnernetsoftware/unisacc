#pragma unisa use g_math
#pragma unisa use text.text

#define CURVE(K) "let shape=CurveControl_init(0,512," #K ",4);"
#define LOAD "let table=CurveControl_getArcLengths(shape,128,1024);"
#define REFRESH "let table=CurveControl_updateArcLengths(shape,128,1024);"

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","object-json-tokens","json-bytes","json-read","record-copy",
        "curve-line","curve-bezier","curve-control","curve","curve-control-arcs",0};
    const char *setup="let cache=CurveArcCache_init(128,768,5);"
        "let a=ux_f64_put(528,4.0);let b=ux_f64_put(544,4.0);let c=ux_f64_put(560,4.0);"
        "let d=ux_f64_put(584,4.0);";
    const char *cases[]={
        CURVE(0) LOAD "return ux_f64(table+16);",
        CURVE(2) "let clear=ux_f64_put(528,0.0);" LOAD "return ux_f64(table+16);",
        CURVE(5) "let a=ux_f64_put(528,0.0);let b=ux_f64_put(544,0.0);let c=ux_f64_put(560,0.0);"
        "let p=ux_f64_put(584,4.0);" LOAD "return ux_f64(table+16);",
        CURVE(0) LOAD "let a=ux_f64_put(528,8.0);" LOAD "return ux_f64(table+32);",
        CURVE(0) LOAD "let a=ux_f64_put(528,8.0);" REFRESH "return ux_f64(table+32);",
        CURVE(0) "let keep=ux_u32_put(768,71);return 0.0+(CurveControl_getArcLengths(shape,128,768)==0-1 && ux_u32(768)==71);",
        CURVE(1) "let p=ux_f64_put(528,0.0);let q=ux_f64_put(536,4.0);let r=ux_f64_put(544,0.0);"
        LOAD "return ux_f64(table+16);",
        CURVE(3) "let p=ux_f64_put(528,0.0);let q=ux_f64_put(544,0.0);"
        LOAD "return ux_f64(table+16);",
        CURVE(4) "let p=ux_f64_put(528,0.0);let q=ux_f64_put(544,0.0);"
        LOAD "return ux_f64(table+16);",
    };
    const double gold[]={2,1,0.5,4,8,1,2,1,0.5};
    return g_math_run("G_STRUCT CurveControl arc cache","curve-control-arcs",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?4:-1,
        CURVE(0) LOAD "let a=ux_f64_put(528,8.0);" LOAD "return ux_f64(table+32);");
}

