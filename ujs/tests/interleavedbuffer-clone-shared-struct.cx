#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","datautils","bufferattribute","interleavedbuffer",
        "interleavedbuffer-edit","interleavedbuffer-clone-shared",0};
    const char *setup=
        "let a=InterleavedBuffer_init(0,136,2,8,9);let b=InterleavedBuffer_init(32,144,1,16,9);"
        "let words=InterleavedBuffer_init(64,128,4,4,4);let partial=InterleavedBuffer_init(96,128,2,12,9);"
        "let r=InterleavedBuffer_initClone(256,320,4,1024,1280);"
        "let usage=InterleavedBuffer_setUsage(a,35048);let dirty=InterleavedBuffer_needsUpdate(a,1);"
        "let i=0;while(i<8){let x=ux_f32_put(128+i*4,i+1.0);i=i+1;}"
        "let aCopy=416;let bCopy=448;let cCopy=480;";
    #define FIRST "let first=InterleavedBuffer_cloneShared(aCopy,a,r,128,32);"
    #define SECOND "let second=InterleavedBuffer_cloneShared(bCopy,b,r,128,32);"
    #define AD "ux_u32(aCopy+InterleavedBuffer.data)"
    #define BD "ux_u32(bCopy+InterleavedBuffer.data)"
    #define CD "ux_u32(cCopy+InterleavedBuffer.data)"
    #define SAME "return 0.0+(" AD "==" BD ");"
    const char *cases[]={
        FIRST SECOND SAME,
        FIRST SECOND "return ux_f32(" AD ");",
        FIRST SECOND "return ux_f32(" BD ");",
        FIRST SECOND "return 0.0+ux_u32(aCopy+InterleavedBuffer.count);",
        FIRST SECOND "return 0.0+ux_u32(bCopy+InterleavedBuffer.count);",
        FIRST SECOND "return 0.0+ux_u32(r+IBCloneRegistry.count);",
        FIRST "let changed=ux_f32_put(136,99.0);" SECOND "return ux_f32(" AD ");",
        FIRST SECOND "let changed=ux_f32_put(" AD "+4,41.0);return ux_f32(" BD "+4);",
        FIRST "return 0.0+ux_u32(aCopy+InterleavedBuffer.usage);",
        FIRST "return 0.0+ux_u32(aCopy+InterleavedBuffer.version);",
        SECOND FIRST "return ux_f32(" AD ");",
        FIRST "let retyped=InterleavedBuffer_cloneShared(cCopy,words,r,128,32);return 0.0+ux_u16(" CD "+2);",
        FIRST "let retyped=InterleavedBuffer_cloneShared(cCopy,words,r,128,32);"
          "return 0.0+ux_u32(cCopy+InterleavedBuffer.count);",
        FIRST "let repeat=InterleavedBuffer_cloneShared(cCopy,aCopy,r," AD ",16);"
          "return 0.0+(" CD "!=" AD " && ux_f32(" CD ")==ux_f32(" AD "));",
        FIRST "return 0.0+(InterleavedBuffer_cloneShared(cCopy,partial,r,128,32)==-1);",
        FIRST "return 0.0+InterleavedBuffer_cloneShared(cCopy,a,r,128,28);",
        "let limited=InterleavedBuffer_initClone(768,832,1,1536,1600);"
          "let one=InterleavedBuffer_cloneShared(aCopy,a,limited,128,32);"
          "return 0.0+InterleavedBuffer_cloneShared(bCopy,aCopy,limited,1536,16);",
        FIRST "let keep=ux_u32_put(cCopy+InterleavedBuffer.data,77);"
          "let refused=InterleavedBuffer_cloneShared(cCopy,a,r,128,12);return 0.0+ux_u32(cCopy);",
        "let ea=InterleavedBuffer_init(576,224,0,4,9);let eb=InterleavedBuffer_init(608,240,0,4,9);"
          "let e1=InterleavedBuffer_cloneShared(aCopy,ea,r,224,0);"
          "let e2=InterleavedBuffer_cloneShared(bCopy,eb,r,240,0);return 0.0+(" AD "!=" BD ");",
    };
    const double gold[]={1,3,3,2,1,1,3,41,35048,0,5,16448,4,1,1,-1,-2,77,1};
    return g_wasm_batch_page("G_STRUCT InterleavedBuffer shared clone","interleavedbuffer-clone-shared",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,FIRST
        "let separate=InterleavedBuffer_initClone(768,832,4,1536,1664);"
        "let second=InterleavedBuffer_cloneShared(bCopy,b,separate,128,32);" SAME);
}
