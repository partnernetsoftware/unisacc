#pragma unisa use wasm_test_cache
#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define FIX "ujs/practice/uxe/test/"
#define DRIVER "ujs/tests/geometry-plane-public.cx"

static const char *const sources[]={
    FIX "geometry-plane-public-base-layout.ujs",
    BASE "object-layouts.ujs",BASE "datautils.ujs",BASE "bufferattribute.ujs",
    BASE "buffergeometry.ujs",BASE "eventdispatcher.ujs",BASE "geometry-buffers.ujs",
    BASE "planegeometry.ujs",BASE "geometry-buffer-adapter.ujs",BASE "geometry-lifecycle.ujs",
    BASE "geometry-public-layout.ujs",BASE "geometry-dispose.ujs",BASE "geometry-plane-class.ujs",
    BASE "json-read.ujs",BASE "geometry-family-plane-json.ujs",BASE "json-bytes.ujs",
    BASE "object-json-tokens.ujs",BASE "geometry-parametric-json.ujs",BASE "geometry-plane-tojson.ujs",
    FIX "geometry-plane-public-base.ujs",DRIVER,0,
};

static int compile(char **args,const char *phase,int seconds) {
    char *out=0;
    size_t size=0;
    const long start=sy_now_ms();
    const int rc=cx_runv_timeout(args,seconds,&out,&size);
    printf("PLANE_PUBLIC %s ms=%ld rc=%d\n",phase,sy_now_ms()-start,rc);
    if(rc && out) printf("%.*s",(int)size,out);
    mm_free(out);
    return rc;
}

// Use the canonical layouts unchanged. The installed compiler limits a module
// to 24 layouts, so unrelated object records cannot travel with this base.
static int select_layouts(const char *file) {
    const char *names[]={"struct EventDispatcher {","struct BufferAttribute {","struct BufferGeometry {"};
    unsigned char *raw=0;
    int64_t bytes=0;
    if(sy_read_file(BASE "object-layouts.ujs",&raw,&bytes,20000)) return 1;
    const char *text=(const char *)raw;
    char selected[1536];
    int used=0,failed=0;
    for(int i=0;i<3;i++) {
        const long start=tx_find(text,bytes,names[i],tx_len(names[i],50));
        const long end=start<0?-1:tx_find(text+start,bytes-start,"\n}\n",3);
        if(end<0) { failed=1; break; }
        const int written=tx_snprintf(selected+used,sizeof selected-used,"%.*s",(int)end+3,text+start);
        if(written<0 || written>=(int)sizeof selected-used) { failed=1; break; }
        used+=written;
    }
    mm_free(raw);
    return failed || sy_write_file(file,selected,used,0600);
}

static int base_wasm(const char *wasm,int prepare,int check) {
    const char *cache=sy_env("UXE_PLANE_PUBLIC_WASM_CACHE");
    if(!cache || !cache[0]) {
        printf("PLANE_PUBLIC cache=missing env=UXE_PLANE_PUBLIC_WASM_CACHE\n");
        return 1;
    }
    char record[640],key[65],sha[65];
    if(wasm_test_cache_key(sources,key)) return 1;
    const int n=tx_snprintf(record,sizeof record,"%s/%s.bin",cache,key);
    if(n<0 || n>=(int)sizeof record) return 2;
    const int rc=wasm_test_cache_read(record,key,prepare?0:wasm,sha);
    if(!rc && !check) {
        printf("PLANE_PUBLIC cache=hit key=%s sha=%s\n",key,sha);
        return 0;
    }
    if(rc==-ENOENT && (!prepare || check)) {
        printf("PLANE_PUBLIC cache=missing key=%s\n",key);
        return 1;
    }
    if(rc && rc!=-ENOENT) {
        printf("PLANE_PUBLIC cache=refused rc=%d key=%s\n",rc,key);
        return 1;
    }
    char layouts[360];
    const int layout_len=tx_snprintf(layouts,sizeof layouts,"%s-layout.ujs",wasm);
    if(layout_len<0 || layout_len>=(int)sizeof layouts || select_layouts(layouts)) return 1;
    char *args[26]={"./ujs/ujs2wasm.com"};
    int i=0;
    while(sources[i] && !tx_eqz(sources[i],DRIVER)) {
        args[i+1]=tx_eqz(sources[i],BASE "object-layouts.ujs")?layouts:(char *)sources[i];
        i++;
    }
    args[i+1]="-o";
    args[i+2]=(char *)wasm;
    if(compile(args,"base_prepare",50)) return 1;
    if(check) {
        const int mismatch=wasm_test_cache_verify(wasm,sha);
        printf("PLANE_PUBLIC cache=rebuilt sha=%s failed=%d\n",sha,mismatch!=0);
        return mismatch;
    }
    return wasm_test_cache_write(cache,record,key,wasm);
}

static int browser_check(const char *dir,const char *wasm,int mutate) {
    char cwd[460],url[840],probe[320];
    if(sy_cwd(cwd,sizeof cwd)) return 1;
    tx_snprintf(probe,sizeof probe,"%s/probe.wasm",dir);
    const int n=tx_snprintf(url,sizeof url,"file://%s/" FIX "geometry-plane-public-r160.html?dir=%s&mutate=%d",
        cwd,dir,mutate);
    char *args[]={"./ujs/ujs2wasm.com",FIX "geometry-plane-public-probe.ujs","-o",probe,0};
    const char json[]="{\"metadata\":{\"version\":4.6,\"type\":\"BufferGeometry\","
        "\"generator\":\"BufferGeometry.toJSON\"},\"uuid\":\"plane-1\",\"type\":\"PlaneGeometry\","
        "\"name\":\"deck \\\"A\\\"\",\"width\":6.25,\"height\":4,\"widthSegments\":2.5,\"heightSegments\":1.25}";
    unsigned hash=0;
    for(int i=0;i<(int)sizeof json-1;i++) hash=(hash*131u+(unsigned char)json[i])%16777213u;
    const double common[]={1,6.25,2.5,-3.125,0,3,1,4,4182,41,61,0,1,hash,6,12,-3.125};
    const double native[]={-1,-1,-2,77,-1,-1,1};
    enum { shared=sizeof common/sizeof common[0], extra=sizeof native/sizeof native[0], count=2*shared+extra };
    double actual[count]={0};
    int failed=n<0 || n>=(int)sizeof url || base_wasm(wasm,0,0) ||
        compile(args,"probe",6) || r160_wait_read(url,"#r160",actual,count,dir);
    for(int i=0;!failed && i<count;i++) {
        const double gold=i<2*shared?common[i%shared]:native[i-2*shared];
        if(actual[i]!=gold) {
            printf("PLANE_PUBLIC case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold);
            failed=1;
        }
    }
    printf("G_STRUCT PlaneGeometry public cases=%d failed=%d\n",count,failed);
    return failed;
}

int main(int argc,char **argv) {
    const int prepare=argc>=2 && tx_eqz(argv[1],"--prepare");
    const int check=prepare && argc==3 && tx_eqz(argv[2],"--check");
    int mutate=0;
    if(argc==2 && tx_eqz(argv[1],"--mutate")) mutate=1;
    if(argc==2 && tx_eqz(argv[1],"--mutate-dispose")) mutate=2;
    if(argc!=1 && !check && !mutate && !(prepare && argc==2)) return 2;
    char dir[256],wasm[320];
    if(sy_mkdtemp("/tmp","uxe-plane-public-",dir,sizeof dir)) return 2;
    tx_snprintf(wasm,sizeof wasm,"%s/base.wasm",dir);
    int rc=prepare?base_wasm(wasm,1,check):browser_check(dir,wasm,mutate);
    if(sy_remove_all(dir)) rc=1;
    if(prepare) printf("PLANE_PUBLIC prepare check=%d failed=%d\n",check,rc!=0);
    return rc;
}
