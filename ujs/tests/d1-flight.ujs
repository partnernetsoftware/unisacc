persist let heading = 0;
persist let bank = 0;
persist let x = 2048;
persist let z = 2048;
persist let altitude = 25;
persist let speed = 12;
persist let pitch = 0;
let turn = 0;
if (input_turn > 0) { turn = 1; }
else { if (input_turn < 0) { turn = -1; } }
let target = turn * 24;
if (bank < target) { bank = bank + 4; }
else { if (bank > target) { bank = bank - 4; } }
heading = (heading + turn * 3 + 360) % 360;
let cruise = 12;
if (input_boost > 0) { cruise = 28; }
if (speed < cruise) { speed = speed + 2; }
else { if (speed > cruise) { speed = speed - 2; } }
let pitch_target = 0;
if (input_climb > 0) {
  pitch_target = 18;
  if (altitude < 106) { altitude = altitude + 1; }
} else {
  if (input_climb < 0) {
    pitch_target = -18;
    if (altitude > 12) { altitude = altitude - 1; }
  }
}
if (pitch < pitch_target) { pitch = pitch + 3; }
else { if (pitch > pitch_target) { pitch = pitch - 3; } }
let phase = heading % 180;
let dx = phase * (180 - phase) * speed / 8100;
if (heading >= 180) { dx = -dx; }
let normal = (heading + 90) % 360;
phase = normal % 180;
let dz = phase * (180 - phase) * speed / 8100;
if (normal >= 180) { dz = -dz; }
x = (x + dx + 4096) % 4096;
z = (z - dz + 4096) % 4096;
let frame = list(11);
frame[0] = 3;
frame[1] = heading % 256;
frame[2] = heading / 256;
frame[3] = bank + 24;
frame[4] = x % 256;
frame[5] = x / 256;
frame[6] = z % 256;
frame[7] = z / 256;
frame[8] = altitude;
frame[9] = speed;
frame[10] = pitch + 18;
host_gpu_submit(store_bytes(frame), 11);
return heading;
