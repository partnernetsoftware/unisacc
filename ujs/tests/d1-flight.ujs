persist let heading = 0;
persist let bank = 0;
let turn = 0;
if (input_turn > 0) { turn = 1; }
else { if (input_turn < 0) { turn = -1; } }
let target = turn * 24;
if (bank < target) { bank = bank + 4; }
else { if (bank > target) { bank = bank - 4; } }
heading = (heading + turn * 3 + 360) % 360;
let frame = list(4);
frame[0] = 1;
frame[1] = heading % 256;
frame[2] = heading / 256;
frame[3] = bank + 24;
host_gpu_submit(store_bytes(frame), 4);
return heading;
