#pragma unisa use g_math
#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

static const char setup[] =
    "let a=Vector4_set(0,2.0,0.0-3.0,6.0,2.0);let b=Vector4_set(32,5.0,4.0,0.0-2.0,3.0);"
    "let fraction=Vector4_set(64,1.5,0.0-2.25,3.75,0.0-0.125);"
    "let m0=ux_f64_put(128,2.0);let m1=ux_f64_put(168,3.0);let m2=ux_f64_put(208,4.0);"
    "let m3=ux_f64_put(224,10.0);let m4=ux_f64_put(232,0.0-8.0);"
    "let m5=ux_f64_put(240,7.0);let m6=ux_f64_put(248,1.0);";

static double root(double number) {
    double x = number;
    for (int i = 0; i < 16; i++) x = (x + number / x) / 2;
    return x;
}

int main(int argc, char **argv) {
    int mutate = argc == 2 && tx_eqz(argv[1], "--mutate");
    if (argc != 1 && !mutate) return 2;
    const char *cases[] = {
        "let r=Vector4_set(a,4.0,5.0,6.0,7.0);return ux_f64(r+24);",
        "let r=Vector4_copy(a,b);return ux_f64(r+24);",
        "let r=Vector4_add(a,b);return ux_f64(r+16);",
        "let r=Vector4_addVectors(256,a,b);return ux_f64(r+24);",
        "let r=Vector4_sub(a,b);return ux_f64(r+8);",
        "let r=Vector4_subVectors(256,a,b);return ux_f64(r+16);",
        "let r=Vector4_multiply(a,b);return ux_f64(r+24);",
        "return Vector4_dot(a,b);", "return Vector4_lengthSq(a);", "return Vector4_length(a);",
        "let r=Vector4_addScalar(a,2.5);return ux_f64(r+24);",
        "let r=Vector4_subScalar(a,5.0);return ux_f64(r+16);",
        "let r=Vector4_multiplyScalar(a,0.0-2.0);return ux_f64(r+24);",
        "let r=Vector4_divideScalar(a,2.0);return ux_f64(r+16);",
        "let r=Vector4_negate(a);return ux_f64(r+24);",
        "let r=Vector4_addScaledVector(a,0.0+b,0.5);return ux_f64(r+16);",
        "let r=Vector4_normalize(a);return ux_f64(r+24);",
        "let r=Vector4_setLength(a,5.0);return ux_f64(r+16);", "return Vector4_manhattanLength(a);",
        "let r=Vector4_setScalar(a,0.0-6.0);return ux_f64(r+24);",
        "let r=Vector4_setX(a,8.0);return ux_f64(r);",
        "let r=Vector4_setY(a,0.0-9.0);return ux_f64(r+8);",
        "let r=Vector4_setZ(a,11.0);return ux_f64(r+16);",
        "let r=Vector4_setW(a,0.0-8.0);return ux_f64(r+24);",
        "let r=Vector4_setComponent(a,3.0,12.0);return ux_f64(r+24);", "return Vector4_getComponent(a,3);",
        "let c=Vector4_clone(256,a);return Vector4_equals(c,a);",
        "let r=Vector4_lerpVectors(256,0.0+a,0.0+b,0.25);return ux_f64(r);",
        "let r=Vector4_lerp(a,0.0+b,0.25);return ux_f64(r+16);",
        "let r=Vector4_applyMatrix4(a,128);return ux_f64(r+8);",
        "let r=Vector4_applyMatrix4(a,128);return ux_f64(r+24);",
        "let q=Vector4_set(256,0.0,0.0,0.7071067811865475,0.7071067811865476);"
        "let r=Vector4_setAxisAngleFromQuaternion(a,q);return ux_f64(r+24);",
        "let s0=ux_f64_put(264,1.0);let s1=ux_f64_put(288,0.0-1.0);let s2=ux_f64_put(336,1.0);"
        "let r=Vector4_setAxisAngleFromRotationMatrix(a,256);return ux_f64(r+16);",
        "let s0=ux_f64_put(256,0.0-1.0);let s1=ux_f64_put(296,0.0-1.0);let s2=ux_f64_put(336,1.0);"
        "let r=Vector4_setAxisAngleFromRotationMatrix(a,256);return ux_f64(r+24);",
        "let s0=ux_f64_put(256,1.0);let s1=ux_f64_put(296,1.0);let s2=ux_f64_put(336,1.0);"
        "let r=Vector4_setAxisAngleFromRotationMatrix(a,256);return ux_f64(r);",
        "let r=Vector4_min(a,b);return ux_f64(r);",
        "let r=Vector4_max(a,b);return ux_f64(r+24);",
        "let lo=Vector4_set(256,0.0-1.0,0.0-2.0,0.0-3.0,0.0-4.0);"
        "let hi=Vector4_set(288,1.0,2.0,3.0,4.0);let r=Vector4_clamp(a,lo,hi);return ux_f64(r+16);",
        "let r=Vector4_clampScalar(a,0.0-2.0,2.0);return ux_f64(r+8);",
        "let r=Vector4_clampLength(a,0.0,5.0);return ux_f64(r+16);",
        "let r=Vector4_floor(fraction);return ux_f64(r+8);",
        "let r=Vector4_ceil(fraction);return ux_f64(r);",
        "let r=Vector4_round(fraction);return ux_f64(r+16);",
        "let r=Vector4_roundToZero(fraction);return ux_f64(r+16);",
        "let v=Vector4_set(264,2.0,0.0-3.0,6.0,2.0);let r=Vector4_fromArray(a,256,1);return ux_f64(r+16);",
        "let r=Vector4_toArray(a,256,1);return ux_f64(288);",
        "let v=ux_f32_put(284,0.4);let r=Vector4_fromBufferAttribute(a,256,2,1,16);return ux_f64(r+24);",
        "let r=Vector4_random(a,0.125,0.625,0.25,0.75);return ux_f64(r+24);",
        "return Vector4_getComponent(a,2)==6.0 && Vector4_getComponent(a,3)==2.0;",
        "let c=ux_math_cos(0.002);let s=ux_math_sin(0.002);"
        "let p0=ux_f64_put(256,c);let p1=ux_f64_put(264,s);let p2=ux_f64_put(288,0.0-s);"
        "let p3=ux_f64_put(296,c);let p4=ux_f64_put(336,1.0);"
        "let r=Vector4_setAxisAngleFromRotationMatrix(a,256);return ux_f64(r+24);",
        "let c=ux_math_cos(3.141592653589793-0.002);let s=ux_math_sin(3.141592653589793-0.002);"
        "let p0=ux_f64_put(256,c);let p1=ux_f64_put(264,s);let p2=ux_f64_put(288,0.0-s);"
        "let p3=ux_f64_put(296,c);let p4=ux_f64_put(336,1.0);"
        "let r=Vector4_setAxisAngleFromRotationMatrix(a,256);return ux_f64(r+24);"
    };
    enum { count = sizeof cases / sizeof cases[0] };
    const double length = root(53);
    const double gold[count] = {7,3,4,5,-7,8,6,-8,53,length,4.5,1,-4,3,-2,5,
        2/length,30/length,13,-6,8,-9,11,-8,12,2,1,2.75,4,-25,2,1.5707963267948966,1,
        3.141592653589793,1,2,3,3,-2,30/length,-3,2,4,3,6,2,(double)(float)0.4,0.75,1,0,3.141592653589793};
    char dir[256], source[300], wasm[300], library[45000];
    unsigned char *vectors=0,*math=0,*views=0,*scalar=0;
    int64_t size=0;
    double oracle[count];
    int rc=sy_read_file("ujs/practice/uxe/base/vector4.ujs",&vectors,&size,35000) ||
        sy_read_file("ujs/practice/uxe/base/f64-math.ujs",&math,&size,9000) ||
        sy_read_file("ujs/practice/uxe/base/views.ujs",&views,&size,4000) ||
        sy_read_file("ujs/practice/uxe/base/vector-scalar.ujs",&scalar,&size,4000);
    int n=rc ? -1 : tx_snprintf(library,sizeof library,"%s\n%s\n%s\n%s",math,views,scalar,vectors);
    mm_free(vectors); mm_free(math); mm_free(views); mm_free(scalar);
    if(n<0 || n>=(int)sizeof library || sy_mkdtemp("/tmp","ujs-vector4-",dir,sizeof dir)) return 2;
    tx_snprintf(source,sizeof source,"%s/probe.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/probe.wasm",dir);
    int failed=g_math_reference("vector4",oracle,count,dir);
    for(int i=0;!failed && i<count;i++) {
        double actual=0;
        const char *test=mutate && i==29 ? "return ux_f64(a+8);" : cases[i];
        if(g_math_sample(source,wasm,library,setup,test,&actual) ||
            !g_math_near(actual,gold[i],1e-9) || !g_math_near(oracle[i],gold[i],1e-9)) {
            printf("VECTOR4 case=%d actual=%.17g r160=%.17g gold=%.17g\n",i,actual,oracle[i],gold[i]);
            failed=1;
        }
    }
    char *clean[]={"rm","-rf","--",dir,0};
    char *out=0;
    size_t out_size=0;
    if(cx_runv_timeout(clean,5,&out,&out_size)) failed=1;
    mm_free(out);
    printf("G_MATH Vector4 cases=%d failed=%d\n",count,failed);
    return failed;
}
