#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","datautils","bufferattribute","bufferattribute-transforms",0};
    const char *setup="let a=BufferAttribute_init(0,128,1,3,9,0);"
        "let x=ux_f32_put(128,1.0);let y=ux_f32_put(132,2.0);let z=ux_f32_put(136,3.0);"
        "let a0=ux_f64_put(192,2.0);let a4=ux_f64_put(224,3.0);let a8=ux_f64_put(256,4.0);"
        "let b0=ux_f64_put(288,2.0);let b5=ux_f64_put(328,3.0);let b10=ux_f64_put(368,4.0);"
        "let tx=ux_f64_put(384,5.0);let ty=ux_f64_put(392,6.0);let tz=ux_f64_put(400,7.0);let b15=ux_f64_put(408,1.0);"
        "let j=ux_f64_put(448,8.0);let k=ux_f64_put(456,9.0);let l=ux_f64_put(464,10.0);";
    const char *cases[]={
        "let r=BufferAttribute_applyMatrix3(a,192,480);return BufferAttribute_getY(r,0);",
        "let r=BufferAttribute_applyMatrix4(a,288,480);return BufferAttribute_getX(r,0);",
        "let r=BufferAttribute_applyMatrix4(a,288,480);return BufferAttribute_getZ(r,0);",
        "let r=BufferAttribute_applyNormalMatrix(a,192,480);return BufferAttribute_getZ(r,0);",
        "let r=BufferAttribute_transformDirection(a,288,480);return BufferAttribute_getZ(r,0);",
        "let r=BufferAttribute_set(a,448,2,1,480);return BufferAttribute_getZ(r,0);",
        "let r=BufferAttribute_copyArray(a,448,3,480);return BufferAttribute_getX(r,0);",
        "let r=BufferAttribute_init(0,128,1,2,9,0);let m0=ux_f64_put(512,1.0);let m4=ux_f64_put(544,1.0);"
        "let m6=ux_f64_put(560,4.0);let m7=ux_f64_put(568,6.0);let m8=ux_f64_put(576,1.0);"
        "let t=BufferAttribute_applyMatrix3(r,512,480);return BufferAttribute_getY(t,0);"
    };
    const double unit_z=(double)(float)(12.0/13.564659966250536);
    const double gold[]={6,7,19,unit_z,unit_z,9,8,8};
    return g_math_run("G_STRUCT BufferAttribute transforms","bufferattribute-transforms",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,"let r=BufferAttribute_transformDirection(a,288,480);return BufferAttribute_getZ(r,0);");
}
