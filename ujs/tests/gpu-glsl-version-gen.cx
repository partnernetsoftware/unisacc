#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int write=argc==2 && tx_eqz(argv[1],"--write");
    int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char header[]="symbol\tid\ttoken\n";
    unsigned char *facts=0,*current=0;
    int64_t bytes=0,actual=0;
    int failed=sy_read_file("ujs/practice/uxe/base/gpu-glsl-version.tsv",&facts,&bytes,1024);
    if(!failed && (bytes<sizeof header-1 || !tx_prefix((char *)facts,bytes,header,sizeof header-1))) failed=1;
    char code[4096],names[2][6];
    int ids[2],lengths[2];
    int64_t packed[2];
    int rows=0,used=0;
#define EMIT(...) do { int n=tx_snprintf(code+used,sizeof code-used,__VA_ARGS__); \
    if(n<0 || n>=sizeof code-used) failed=1; else used+=n; } while(0)
    EMIT("// Generated by gpu-glsl-version-gen.cx.\n");
    for(int at=sizeof header-1;!failed && at<bytes;) {
        int end=at;
        while(end<bytes && facts[end]!='\n') end++;
        if(rows>=2 || end==bytes || end-at<11 || end-at>16 ||
           facts[at+5]!='\t' || facts[at+7]!='\t' ||
           !tx_same((char *)facts+at,4,"GLSL",4) || facts[at+4]!=facts[at+6] ||
           (facts[at+6]!='1' && facts[at+6]!='3')) { failed=1; break; }
        int id=facts[at+6]-'0';
        if(rows>0 && ids[rows-1]>=id) { failed=1; break; }
        tx_snprintf(names[rows],sizeof names[0],"%.*s",5,facts+at);
        ids[rows]=id;
        lengths[rows]=end-at-8;
        packed[rows]=0;
        for(int i=0;i<lengths[rows];i++) {
            int c=facts[at+8+i];
            if((c<'0' || c>'9') && c!=' ' && c!='e' && c!='s') { failed=1; break; }
            packed[rows]|=(int64_t)c<<(8*i);
        }
        EMIT("native function GpuGlslVersion_%s() i64 { return %d; }\n",names[rows],id);
        rows++;
        at=end+1;
    }
    if(!failed && rows==2) {
        EMIT("native function gpu_glsl_version_fact(version:i64,field:i64) i64 {\n");
        for(int i=0;!failed && i<rows;i++) {
            EMIT("  if(version==%d) { let value=[%d,%lld]; return value[field]; }\n",
                ids[i],lengths[i],(long long)(packed[i]+(mutate && i==1)));
        }
        EMIT("  return 0-1;\n}\n");
    } else failed=1;
#undef EMIT
    const char *path="ujs/practice/uxe/base/gpu-glsl-version-generated.ujs";
    if(!failed) failed=write?sy_write_file(path,code,used,0644)!=0:
        sy_read_file(path,&current,&actual,sizeof code) || !tx_same((char *)current,actual,code,used);
    mm_free(facts);
    mm_free(current);
    printf("GLSL_VERSION_GENERATE rows=%d failed=%d\n",rows,failed);
    return failed;
}
