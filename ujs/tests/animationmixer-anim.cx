#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    int stop_mutate=argc==2 && tx_eqz(argv[1],"--stop-mutate");
    if(argc!=1 && !mutate && !stop_mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object3d-layout","object3d","animation-view",
        "discreteinterpolant","linearinterpolant","cubicinterpolant","keyframe-track","numberkeyframetrack",
        "animationaction","propertybinding","propertymixer","record-copy","animationmixer","animationmixer-object-api",0};
    const char *setup=
        "let arena=Object3D_initArena(0,4);let root=Object3D_create(arena);"
        "let chars=[46,112,111,115,105,116,105,111,110,91,121,93];let i=0;"
        "while(i<12){let c=ux_u8_put(2000+i,chars[i]);i=i+1;}"
        "let binding=PropertyBinding_bind(2100,arena,root,2000,12);"
        "let node=Object3D_address(arena,root);let pos=ux_u32(node+Object3D.position);"
        "let y=ux_f64_put(pos+8,10.0);let origin=PropertyBinding_transfer(binding,2200,0);"
        "let property=PropertyMixer_init(2240,2304,2200,1);"
        "let a=AnimationAction_init(2560,1.0,2201,-1,0);let b=AnimationAction_init(2640,1.0,2201,-1,0);"
        "let v0=ux_f32_put(2904,1.0);let v1=ux_f32_put(2964,20.0);let v2=ux_f32_put(2984,40.0);"
        "let va=AnimationSamples_init(2752,2900,2960,2,1);let vb=AnimationSamples_init(2768,2900,2980,2,1);"
        "let ta=KeyframeTrack_init(2816,2000,12,va);let tb=KeyframeTrack_init(2848,2000,12,vb);"
        "let s0=2432;let s1=s0+AnimationMixerSlot.size;"
        "let a0=ux_u32_put(s0+AnimationMixerSlot.action,a);let t0=ux_u32_put(s0+AnimationMixerSlot.track,ta);"
        "let b0=ux_u32_put(s0+AnimationMixerSlot.blend,2500);let w0=ux_f64_put(s0+AnimationMixerSlot.weight,0.25);"
        "let a1=ux_u32_put(s1+AnimationMixerSlot.action,b);let t1=ux_u32_put(s1+AnimationMixerSlot.track,tb);"
        "let b1=ux_u32_put(s1+AnimationMixerSlot.blend,2500);let w1=ux_f64_put(s1+AnimationMixerSlot.weight,0.5);"
        "let mixer=AnimationMixer_init(2368,binding,property,s0,2,4000);";
    const char *cases[]={
        "let frame=AnimationMixer_update(mixer,0.5);return ux_f64(frame+AnimationMixer.time);",
        "let frame=AnimationMixer_update(mixer,0.5);return ux_f64(pos+8);",
        "let f0=AnimationMixer_update(mixer,0.5);let f1=AnimationMixer_update(f0,0.25);return ux_f64(pos+8);",
        "let frame=AnimationMixer_update(mixer,0.5);return ux_f64(pos);",
        "let invalid=ux_u32_put(s1+AnimationMixerSlot.blend,9);let refused=AnimationMixer_update(mixer,0.5);return 0.0+refused;",
        "let invalid=ux_u32_put(s1+AnimationMixerSlot.blend,9);let refused=AnimationMixer_update(mixer,0.5);"
        "let valid=ux_u32_put(s1+AnimationMixerSlot.blend,2500);let success=AnimationMixer_update(mixer,0.5);return ux_f64(pos+8);",
        "let frame=AnimationMixer_update(mixer,0.5);let stopped=AnimationMixer_stopAllAction(frame);return ux_f64(pos+8);",
        "let frame=AnimationMixer_update(mixer,0.5);let stopped=AnimationMixer_stopAllAction(frame);"
        "let after=AnimationMixer_update(stopped,0.25);return ux_f64(pos+8);"
    };
    const double gold[]={0.5,15,21.25,0,-1,15,10,10};
    return g_wasm_batch("G_ANIM AnimationMixer","animationmixer",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],stop_mutate?6:mutate?1:-1,
        stop_mutate?"let frame=AnimationMixer_update(mixer,0.5);return ux_f64(pos+8);":
        "let w=ux_f64_put(s1+AnimationMixerSlot.weight,0.0);let frame=AnimationMixer_update(mixer,0.5);return ux_f64(pos+8);");
}
