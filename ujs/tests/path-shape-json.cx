#pragma unisa use g_math
#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define TEST "ujs/practice/uxe/test/"

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[390],abi[300],wasm[300],url[850];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-path-shape-json-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/paths.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/" TEST "path-shape-json-r160.html?wasm=%s&mutate=%d",cwd,wasm,mutate);
    const char entry[]="export uxe_path_shape_json(mode:i64,kind:i64,length:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,BASE "record-copy.ujs",BASE "geometry-buffers.ujs",
        BASE "shapeutils.ujs",BASE "shape-hole.ujs",BASE "shape-holes.ujs",BASE "shapegeometry.ujs",
        BASE "json-bytes.ujs",BASE "json-read.ujs",BASE "object-json-tokens.ujs",
        BASE "shapegeometry-object-rings.ujs",BASE "shapegeometry-object-json.ujs",
        BASE "curve-line.ujs",BASE "curve-bezier.ujs",BASE "path.ujs",BASE "shape.ujs",
        BASE "curve-control-layout.ujs",BASE "curve-control.ujs",BASE "loader-json.ujs",
        BASE "path-shape-json.ujs",TEST "path-shape-json-probe.ujs","-o",wasm,0};
    const double gold[]={1,1,23,3,2,3,1,0,0,0,1,1,1,1,23,3,2,3,1,0,0,0,1,1};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    char *log=0;
    size_t size=0;
    int failed=length<0 || length>=(int)sizeof url || sy_write_file(abi,entry,sizeof entry-1,0600);
    if(!failed) {
        const int rc=cx_runv_timeout(compile,10,&log,&size);
        if(rc) { printf("G_GEOMETRY Path and Shape compile_rc=%d %s\n",rc,log?log:""); failed=1; }
        mm_free(log);
        log=0;
    }
    if(!failed) failed=r160_wait_read(url,"#r160",actual,count,dir);
    if(!failed) for(int i=0;i<count;i++) if(!g_math_near(actual[i],gold[i],1e-6)) {
        printf("G_GEOMETRY Path and Shape case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
        failed++;
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&log,&size)) failed++;
    mm_free(log);
    printf("G_GEOMETRY Path and Shape public cases=%d failed=%d\n",count,failed);
    return failed!=0;
}
