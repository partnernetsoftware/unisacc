#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define SAMPLE(offset) "let count=CompressedTexture_decodeBC2(32,512,32);return 0.0+ux_u32(512+" #offset ");"

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","compressedtextureloader","compressed-texture-bc1","compressed-texture-bc2",0};
    const char setup[]="let mip=CompressedTextureLoader_level(32,128,16,4,2,33778);"
        "let alpha=ux_u32_put(128,4155242512);let colors=ux_u32_put(136,4160749599);let index=ux_u32_put(140,58596);";
    const char *cases[]={
        "return 0.0+CompressedTexture_decodeBC2(32,512,32);",
        SAMPLE(0),SAMPLE(4),SAMPLE(8),SAMPLE(12),SAMPLE(16),
        "return 0.0+CompressedTexture_decodeBC2(32,512,31);",
        "return 0.0+CompressedTexture_decodeBC2(32,129,32);",
        "let bad=ux_u32_put(32+CompressedMip.bytes,8);return 0.0+CompressedTexture_decodeBC2(32,512,32);",
        "let bad=ux_u32_put(32+CompressedMip.format,33779);return 0.0+CompressedTexture_decodeBC2(32,512,32);",
        "return 0.0+ux_u32(32+CompressedMip.format);",
        SAMPLE(4),
    };
    const double gold[]={32,0x00ff0000u,0x110000ffu,0x88aa0055u,0xff5500aau,0xbbff0000u,-1,-1,-3,-2,33778,0x110000ffu};
    return g_wasm_batch("G_IO CompressedTexture software BC2","compressed-texture-bc2",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let alpha=ux_u8_put(129,247);" SAMPLE(8));
}
