#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","scene-snapshot-layout","render-list","scene-render-list",0};
    const char *setup=
        "let query=0;let nodes=128;let binds=384;let proj=768;let mats=1024;let out=2048;let work=3072;"
        "let a=ux_u32_put(query+SceneRenderQuery.snapshot,nodes);let b=ux_u32_put(query+SceneRenderQuery.bindings,binds);"
        "let c=ux_u32_put(query+SceneRenderQuery.count,5);let d=ux_u32_put(query+SceneRenderQuery.layerMask,1);"
        "let e=ux_u32_put(query+SceneRenderQuery.viewProjection,proj);"
        "let p=ux_f64_put(proj+80,0.0-0.1);let q=ux_f64_put(proj+112,0.0-1.0);let r=ux_f64_put(proj+120,1.0);"
        "let i=0;while(i<5){let node=nodes+i*SceneSnapshotRow.size;let bind=binds+i*SceneRenderBinding.size;"
        "let mat=mats+i*128;let a=ux_u32_put(node+SceneSnapshotRow.node,101+i);"
        "let b=ux_u32_put(node+SceneSnapshotRow.visible,1);let layer=1;if(i==4){layer=2;}"
        "let c=ux_u32_put(node+SceneSnapshotRow.layerMask,layer);let d=ux_u32_put(node+SceneSnapshotRow.worldMatrix,mat);"
        "let e=ux_u32_put(bind+SceneRenderBinding.node,101+i);let f=ux_u32_put(bind+SceneRenderBinding.geometry,201+i);"
        "let g=ux_u32_put(bind+SceneRenderBinding.material,301+i);let pass=0;if(i>=2){pass=2;}"
        "let h=ux_u32_put(bind+SceneRenderBinding.pass,pass);let s=ux_f64_put(mat+80,1.0);"
        "let t=ux_f64_put(mat+112,0.0-2.0);let u=ux_f64_put(mat+120,1.0);i=i+1;}"
        "let order=ux_f64_put(binds+SceneRenderBinding.renderOrder,1.0);"
        "let offset=ux_f64_put(binds+3*SceneRenderBinding.size+SceneRenderBinding.centerZ,0.0-6.0);";
    #define BUILD "let count=Scene_renderList(query,out,5,work,512);"
    const char *cases[]={
        BUILD "return 0.0+count;",
        BUILD "return 0.0+ux_u32(out+SceneDrawItem.node);",
        BUILD "return 0.0+ux_u32(out+SceneDrawItem.size+SceneDrawItem.node);",
        BUILD "return 0.0+ux_u32(out+2*SceneDrawItem.size+SceneDrawItem.node);",
        BUILD "return 0.0+ux_u32(out+3*SceneDrawItem.size+SceneDrawItem.node);",
        BUILD "return 0.0+ux_u32(out+2*SceneDrawItem.size+SceneDrawItem.geometry);",
        BUILD "return 0.0+ux_u32(out+2*SceneDrawItem.size+SceneDrawItem.worldMatrix);",
        "let keep=ux_u32_put(out,77);let bad=ux_u32_put(binds+SceneRenderBinding.pass,3);"
        BUILD "return 0.0+(count==0-2 && ux_u32(out)==77);",
        "return 0.0+Scene_renderList(query,out,3,work,512);",
        "let keep=ux_u32_put(work,77);"
        "let bad=ux_u32_put(nodes+4*SceneSnapshotRow.size+SceneSnapshotRow.worldMatrix,work);"
        BUILD "return 0.0+(count==0-2 && ux_u32(work)==77);",
    };
    const double gold[]={4,102,101,104,103,204,1408,1,-3,1};
    return g_wasm_batch_page("G_STRUCT shared scene render list","scene-render-list",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let noCenter=ux_f64_put(binds+3*SceneRenderBinding.size+SceneRenderBinding.centerZ,0.0);"
        BUILD "return 0.0+ux_u32(out+2*SceneDrawItem.size+SceneDrawItem.node);");
}
