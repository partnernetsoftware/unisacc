#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"shapeutils","shape-hole","shape-holes",0};
    const char *setup=
        "let points=[0,0,10,0,10,10,0,10,2,2,2,4,4,4,4,2,6,6,8,6,8,8,6,8];"
        "let i=0;while(i<24){let v=ux_f64_put(128+i*8,0.0+points[i]);i=i+1;}"
        "let s0=ux_u32_put(384,4);let s1=ux_u32_put(388,4);"
        "let count=ShapeUtils_triangulateHoles(128,4,384,2,512,64,1024,1200);"
        "let area=0.0;let inside=0;let bad=0;i=0;"
        "while(i<count){let a=128+16*ux_u32(512+i*4);let b=128+16*ux_u32(516+i*4);"
        "let c=128+16*ux_u32(520+i*4);let turn=shape_turn(a,b,c);"
        "let x=(ux_f64(a)+ux_f64(b)+ux_f64(c))/3.0;let y=(ux_f64(a+8)+ux_f64(b+8)+ux_f64(c+8))/3.0;"
        "if((x>2.0&&x<4.0&&y>2.0&&y<4.0)||(x>6.0&&x<8.0&&y>6.0&&y<8.0)){inside=inside+1;}"
        "if(turn<=0.0){bad=bad+1;}area=area+turn*0.5;i=i+3;}";
    const char *cases[]={
        "return count/3;","return area;","return inside;","return bad;",
        "return ShapeUtils_triangulateHoles(128,4,384,2,512,64,1024,983);",
        "let guard=ux_u32_put(512,777);let failed=ShapeUtils_triangulateHoles(128,4,384,2,512,64,1024,983);return ux_u32(512);",
        "return ShapeUtils_triangulateHoles(128,4,384,2,128,64,1024,1200);"
    };
    const double gold[]={14,92,0,0,-1,777,-1};
    return g_math_run("G_STRUCT ShapeUtils holes","shape-holes",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let lost=ShapeUtils_triangulateHoles(128,4,384,1,512,64,1024,1200);return lost/3;");
}
