#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","datautils","bufferattribute","interleavedbuffer",0};
    const char *setup="let a=InterleavedBuffer_init(0,128,2,12,9);"
        "let q=ux_f32_put(144,5.0);let w=ux_f32_put(148,6.0);"
        "let use=InterleavedBuffer_setUsage(a,35048);let v=InterleavedBuffer_needsUpdate(a,1);";
    const char *cases[]={
        "return ux_u32(a+InterleavedBuffer.count);","return ux_u32(a+InterleavedBuffer.stride);",
        "return ux_u32(a+InterleavedBuffer.usage);","return ux_u32(a+InterleavedBuffer.version);",
        "let c=InterleavedBuffer_copy(32,a,192,24);return ux_f32(ux_u32(c+InterleavedBuffer.data)+16);",
        "let c=InterleavedBuffer_copy(32,a,192,24);return ux_u32(c)!=ux_u32(a);",
        "let c=InterleavedBuffer_clone(32,a,192,24);return ux_f32(ux_u32(c+InterleavedBuffer.data)+20);",
        "let c=InterleavedBuffer_clone(32,a,192,24);return ux_u32(c+InterleavedBuffer.version);"
    };
    const double gold[]={2,12,35048,1,5,1,6,0};
    return g_math_run("G_STRUCT InterleavedBuffer","interleavedbuffer",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?4:-1,"let c=InterleavedBuffer_copy(32,a,192,24);return ux_f32(ux_u32(c)+20);");
}
