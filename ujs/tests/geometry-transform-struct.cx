#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","matrix3","matrix4","object-layouts","buffergeometry","geometry-transform",0};
    const char *setup="let g=BufferGeometry_init(0,64,3,128,0);let index=0;"
        "while(index<3){let view=256+index*64;let base=512+index*64;"
        "let dimensions=3;if(index==2){dimensions=4;}"
        "let a=ux_u32_put(view+BufferAttribute.data,base);let b=ux_u32_put(view+BufferAttribute.count,2);"
        "let c=ux_u32_put(view+BufferAttribute.itemSize,dimensions);"
        "let d=ux_u32_put(view+BufferAttribute.stride,8*dimensions);"
        "let e=ux_u32_put(view+BufferAttribute.componentType,10);"
        "let bound=BufferGeometry_setAttribute(g,index+1,view);index=index+1;}"
        "let x0=ux_f64_put(512,1.0);let y0=ux_f64_put(520,2.0);"
        "let x1=ux_f64_put(536,0.0-1.0);let y1=ux_f64_put(544,0.0-2.0);let z1=ux_f64_put(552,1.0);"
        "let nx=ux_f64_put(576,1.0);let ny=ux_f64_put(584,1.0);"
        "let tx=ux_f64_put(640,1.0);let ty=ux_f64_put(648,1.0);let tw=ux_f64_put(664,0.0-1.0);"
        "let box=BufferGeometry_bounds(g,1,768,832);";
    const char *cases[]={
        "let a=BufferGeometry_scale(g,2.0,1.0,3.0,1024.0,1.0,2.0,3.0);return ux_f64(552);",
        "let a=BufferGeometry_scale(g,2.0,1.0,3.0,1024.0,1.0,2.0,3.0);return ux_f64(576);",
        "let a=BufferGeometry_scale(g,2.0,1.0,3.0,1024.0,1.0,2.0,3.0);return ux_f64(640);",
        "let a=BufferGeometry_scale(g,2.0,1.0,3.0,1024.0,1.0,2.0,3.0);return ux_f64(664);",
        "let a=BufferGeometry_translate(g,1.0,0.0-1.0,2.0,1024.0,1.0,2.0,3.0);return ux_f64(792);",
        "let a=BufferGeometry_translate(g,1.0,0.0-1.0,2.0,1024.0,1.0,2.0,3.0);return ux_f64(848);",
        "let a=BufferGeometry_scale(g,2.0,1.0,3.0,1024.0,1.0,2.0,3.0);return ux_f64(856);",
        "let a=BufferGeometry_rotateX(g,1.5707963267948966,1024.0,1.0,2.0,3.0);return ux_f64(528);",
        "let a=BufferGeometry_rotateY(g,1.5707963267948966,1024.0,1.0,2.0,3.0);return ux_f64(528);",
        "let a=BufferGeometry_rotateZ(g,1.5707963267948966,1024.0,1.0,2.0,3.0);return ux_f64(520);",
        "let a=BufferGeometry_rotateZ(g,1.5707963267948966,1024.0,1.0,2.0,3.0);return ux_u32(256+BufferAttribute.version);"
    };
    const double gold[]={3,0.44721359549995794,0.8944271909999159,-1,2,2.5,3.2015621187164243,2,-1,1,1};
    return g_math_run("G_STRUCT BufferGeometry transforms","geometry-transform",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let a=BufferGeometry_scale(g,2.0,1.0,2.0,1024.0,1.0,2.0,3.0);return ux_f64(552);");
}
