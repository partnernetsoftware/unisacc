#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","cylindrical",0};
    const char *setup="let c=Cylindrical_set(0,5.0,1.0,2.0);let y=ux_f64_put(72,0.0-7.0);";
    const char *cases[]={
        "return ux_f64(c+8);","let r=Cylindrical_clone(24,c);return ux_f64(r+16);",
        "let r=Cylindrical_copy(24,c);return ux_f64(r);",
        "let r=Cylindrical_setFromCartesianCoords(24,3.0,7.0,4.0);return ux_f64(r);",
        "let r=Cylindrical_setFromCartesianCoords(24,3.0,7.0,4.0);return ux_f64(r+8);",
        "let z=ux_f64_put(80,0.0-2.0);let r=Cylindrical_setFromVector3(24,64);return ux_f64(r+8);",
        "let r=Cylindrical_setFromVector3(24,64);return ux_f64(r+16);"
    };
    const double gold[]={1,2,5,5,0.6435011087932844,3.141592653589793,-7};
    return g_math_run("G_MATH Cylindrical","cylindrical",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?4:-1,"let r=Cylindrical_setFromCartesianCoords(24,4.0,7.0,3.0);return ux_f64(r+8);");
}
