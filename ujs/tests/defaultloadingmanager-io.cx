#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","defaultloadingmanager",0};
    const char *setup="let first=DefaultLoadingManager_get(0,64);let event=LoadingManager_item(first,1,7,128);";
    const char *cases[]={
        "return DefaultLoadingManager_get(0,64)==first;",
        "let again=DefaultLoadingManager_get(0,64);return ux_u32(again+LoadingManager.total);",
        "let other=LoadingManager_init(80);return ux_u32(other+LoadingManager.total);",
        "return DefaultLoadingManager_get(0,80);",
        "return DefaultLoadingManager_get(96,100);"
    };
    const double gold[]={1,1,0,-1,-1};
    return g_math_run("G_IO DefaultLoadingManager","defaultloadingmanager",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let again=LoadingManager_init(64);return ux_u32(again+LoadingManager.total);");
}
