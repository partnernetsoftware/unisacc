#pragma unisa use g_math
#pragma unisa use text.text
#pragma unisa use text.fmt

static int digest(const char *text) {
    int hash=0;
    for(int i=0;text[i];i++) hash=(hash*31+text[i])%1000003;
    return hash;
}

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *mods[]={"object-layouts","record-copy","eventdispatcher","material-class",
        "material-classes-generated","json-bytes","json-read","material-field-json","material-field-read",
        "material-fields-generated","material-set-values",0};
    const char *setup=
        "native function row(at:i64,key:i64,value:f64) i64 {"
        "let k=ux_u32_put(at,key);let r=ux_u32_put(at+4,0);return ux_f64_put(at+8,value);}"
        "let ev=EventDispatcher_init(64,128,2);"
        "let m=MeshBasicMaterial_new(256,1,ev);"
        "let a=row(512,2,2.0);let b=row(528,3,0.25);let c=row(544,6,0.0);let d=row(560,9,0.5);let e=row(576,10,1.0);";
    const char *round=
        "let applied=Material_setValues(m,512,5);let end=Material_writeFields(646,900,m,1024);"
        "let prefix=[123,34,120,34,58,48];let i=0;while(i<6){let b=ux_u8_put(640+i,prefix[i]);i=i+1;}"
        "let close=ux_u8_put(end,125);"
        "let n=MeshBasicMaterial_new(2304,2,ev);";
    const char *family=
        "let constructors=[Material_new(1600,10,ev),MeshBasicMaterial_new(1680,11,ev),"
        "MeshLambertMaterial_new(1760,12,ev),MeshPhongMaterial_new(1840,13,ev),"
        "MeshNormalMaterial_new(1920,14,ev),MeshDepthMaterial_new(2000,15,ev),"
        "MeshStandardMaterial_new(2080,16,ev),MeshToonMaterial_new(2160,17,ev),"
        "MeshMatcapMaterial_new(2240,18,ev),MeshDistanceMaterial_new(2320,19,ev)];"
        "let listener=EventDispatcher_addListener(ev,7,42);let j=0;let total=0;"
        "while(j<10){let src=constructors[j];let read=Material_readFields(640,end+1,src,2504);"
        "let clone=Material_clone(3200,src,20,ev);let copied=Material_copy(3360,clone);"
        "let events=Material_dispose(3200,7,3600,1);"
        "if(src<0 || read<0 || clone<0 || copied<0 || events!=1 || ux_u32(3608)!=42 ||"
        "ux_u32(clone+Material.type)!=j || ux_u32(copied+Material.side)!=2){return 0-1;}"
        "total=total+1;j=j+1;}return total;";
    const char *cases[]={
        "let applied=Material_setValues(m,512,5);return ux_u32(applied+Material.side);",
        "let applied=Material_setValues(m,512,5);return ux_u32(applied+Material.version);",
        "let bad=row(560,99,0.5);let rejected=Material_setValues(m,512,4);"
        "return (rejected<0)*10+ux_u32(m+Material.side);",
        "let applied=Material_setValues(m,512,5);let end=Material_writeFields(640,900,m,1024);"
        "let i=640;let hash=0;while(i<end){hash=(hash*31+ux_u8(i))%1000003;i=i+1;}return hash;",
        "let read=Material_readFields(640,end+1,n,2504);"
        "if(read<0){return read;}return ux_u32(n+Material.side)*10.0+ux_f64(n+Material.opacity)*10.0+"
        "(1-ux_u32(n+Material.depthTest))+ux_f64(n+Material.alphaTest)*4.0+"
        "ux_u32(n+Material.premultipliedAlpha)+ux_u32(n+Material.toneMapped);",
        family
    };
    const double gold[]={2,1,10,digest(",\"side\":2,\"opacity\":0.25,\"depthTest\":false,\"alphaTest\":0.5,\"premultipliedAlpha\":true"), 27.5,10};
    char roundCase[2048], alteredCase[2048], familyCase[3000];
    tx_snprintf(roundCase,sizeof roundCase,"%s%s",round,cases[4]);
    tx_snprintf(alteredCase,sizeof alteredCase,"%s%s%s",round,
        "let changed=ux_u8_put(654,49);",cases[4]);
    tx_snprintf(familyCase,sizeof familyCase,"%slet dest=Material_new(3360,21,ev);%s",round,family);
    cases[4]=roundCase;
    cases[5]=familyCase;
    return g_math_run("G_STRUCT Material generated fields","material-fields",mods,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?4:-1,alteredCase);
}
