#pragma unisa use g_math
#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

static const char setup[] =
    "let raw=Quaternion_set(0,1.0,0.0-2.0,3.0,4.0);let id=Quaternion_identity(32);"
    "let qx=Quaternion_set(64,0.7071067811865475,0.0,0.0,0.7071067811865476);"
    "let qz=Quaternion_set(96,0.0,0.0,0.7071067811865475,0.7071067811865476);"
    "let ux=ux_f64_put(128,1.0);let uz=ux_f64_put(176,1.0);";

static double root(double value) {
    double x=value;
    for(int i=0;i<16;i++) x=(x+value/x)*0.5;
    return x;
}

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *cases[]={
        "let r=Quaternion_set(raw,7.0,8.0,9.0,10.0);return ux_f64(r+24);",
        "let r=Quaternion_copy(id,raw);return ux_f64(r+16);",
        "let r=Quaternion_clone(200,raw);return ux_f64(r+8);",
        "let r=Quaternion_identity(qz);return ux_f64(r+24);",
        "let r=Quaternion_conjugate(raw);return ux_f64(r+16);",
        "let r=Quaternion_invert(raw);return ux_f64(r+8);",
        "return Quaternion_dot(raw,id);","return Quaternion_lengthSq(raw);","return Quaternion_length(raw);",
        "let r=Quaternion_normalize(200);return ux_f64(r+24);",
        "let r=Quaternion_normalize(raw);return ux_f64(r+24);",
        "let r=Quaternion_multiplyQuaternions(200,qx,qz);return ux_f64(r+8);",
        "let r=Quaternion_multiply(qx,qz);return ux_f64(r+8);",
        "let r=Quaternion_premultiply(qx,qz);return ux_f64(r+8);",
        "let a=ux_f64_put(200,1.5707963267948966);let b=ux_f64_put(216,1.5707963267948966);"
        "let r=Quaternion_setFromEuler(id,200);return ux_f64(r+8);",
        "let r=Quaternion_setFromAxisAngle(id,160,1.5707963267948966);return ux_f64(r+16);",
        "let m=Matrix4_makeRotationZ(240,1.5707963267948966);let r=Quaternion_setFromRotationMatrix(id,m);return ux_f64(r+16);",
        "let r=Quaternion_setFromUnitVectors(id,128,160);return ux_f64(r+8);",
        "let w=ux_f64_put(160,0.0-1.0);let z=ux_f64_put(176,0.0);"
        "let r=Quaternion_setFromUnitVectors(id,128,160);return ux_f64(r+8);",
        "return Quaternion_angleTo(id,qz);",
        "let r=Quaternion_rotateTowards(id,qz,0.7853981633974483);return ux_f64(r+16);",
        "let r=Quaternion_slerp(id,qz,0.5);return ux_f64(r+16);",
        "let r=Quaternion_slerpQuaternions(200,id,qz,0.5);return ux_f64(r+24);",
        "let r=Quaternion_multiplyQuaternionsFlat(200,1,56,1,88,1);return ux_f64(216);",
        "let r=Quaternion_slerpFlat(200,1.0,24.0,1.0,88.0,1.0,0.5);return ux_f64(224);",
        "let r=Quaternion_clone(200,raw);return Quaternion_equals(raw,r);",
        "let r=Quaternion_fromArray(id,0,0);return ux_f64(r+24);",
        "let r=Quaternion_toArray(raw,200,1);return ux_f64(232);",
        "let r=Quaternion_toJSON(raw,200);return ux_f64(216);",
        "let w=ux_f32_put(228,0.4);let r=Quaternion_fromBufferAttribute(id,200,2,1,16);return ux_f64(r+24);",
        "let r=Quaternion_random(id,0.25,0.25,0.0);return ux_f64(r+16);",
        "return ux_f64(raw+Quaternion.w);"
    };
    enum { count=sizeof cases/sizeof cases[0] };
    const double gold[count]={10,3,-2,1,-3,2,4,30,root(30),1,4/root(30),-0.5,-0.5,0.5,-0.5,
        root(0.5),root(0.5),0-root(0.5),1,1.5707963267948966,0.3826834323650898,0.3826834323650898,
        0.9238795325112867,-0.5,0.3826834323650898,1,4,4,3,(double)(float)0.4,0.5,4};
    unsigned char *q=0,*math=0,*views=0,*matrix=0;
    int64_t n=0;
    char dir[256],source[300],wasm[300],library[55000];
    int rc=sy_read_file("ujs/practice/uxe/base/quaternion.ujs",&q,&n,18000) ||
        sy_read_file("ujs/practice/uxe/base/f64-math.ujs",&math,&n,9000) ||
        sy_read_file("ujs/practice/uxe/base/views.ujs",&views,&n,4000) ||
        sy_read_file("ujs/practice/uxe/base/matrix4.ujs",&matrix,&n,33000);
    int length=rc?-1:tx_snprintf(library,sizeof library,"%s\n%s\n%s\n%s",math,views,matrix,q);
    mm_free(q); mm_free(math); mm_free(views); mm_free(matrix);
    if(length<0 || length>=(int)sizeof library || sy_mkdtemp("/tmp","ujs-quaternion-",dir,sizeof dir)) return 2;
    tx_snprintf(source,sizeof source,"%s/probe.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/probe.wasm",dir);
    double refs[count];
    int failed=g_math_reference("quaternion",refs,count,dir);
    for(int i=0;!failed && i<count;i++) {
        double actual=0;
        const char *example=mutate && i==12?cases[13]:cases[i];
        if(g_math_sample(source,wasm,library,setup,example,&actual) ||
            !g_math_near(actual,gold[i],1e-9) || !g_math_near(refs[i],gold[i],1e-9)) {
            printf("QUATERNION case=%d actual=%.17g r160=%.17g gold=%.17g\n",i,actual,refs[i],gold[i]);
            failed=1;
        }
    }
    char *clean[]={"rm","-rf","--",dir,0};
    char *out=0;
    size_t out_n=0;
    if(cx_runv_timeout(clean,5,&out,&out_n)) failed=1;
    mm_free(out);
    printf("G_MATH Quaternion cases=%d failed=%d\n",count,failed);
    return failed;
}
