#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","clock",0};
    const char *setup="let c=Clock_init(0,1);";
    const char *a="let t0=Clock_getDelta(c,10.0);";
    const char *b="let t0=Clock_getDelta(c,10.0);let t1=Clock_getDelta(c,10.5);let t2=Clock_getElapsedTime(c,11.25);";
    const char *cases[]={
        "return ux_u32(c+Clock.running);",
        "return Clock_getDelta(c,10.0);",
        "let t0=Clock_getDelta(c,10.0);return ux_f64(c+Clock.startTime);",
        "return Clock_getDelta(c,10.5);",
        "let t1=Clock_getDelta(c,10.5);return Clock_getElapsedTime(c,11.25);",
        "let stopped=Clock_stop(c,11.5);return ux_f64(c+Clock.elapsedTime);",
        "let stopped=Clock_stop(c,11.5);return ux_u32(c+Clock.running);",
        "let stopped=Clock_stop(c,11.5);return ux_u32(c+Clock.autoStart);",
        "let stopped=Clock_stop(c,11.5);return Clock_getDelta(c,12.0);",
        "let started=Clock_start(c,12.0);return ux_f64(c+Clock.elapsedTime);",
        "let started=Clock_start(c,12.0);return ux_f64(c+Clock.oldTime);",
        "let started=Clock_start(c,12.0);return Clock_getElapsedTime(c,12.5);",
        "let passive=Clock_init(32,0);return Clock_getDelta(passive,12.5);"
    };
    const double gold[]={0,0,10,0.5,1.25,1.5,0,0,0,0,12,0.5,0};
    enum {count=sizeof gold/sizeof gold[0]};
    char statements[count][512];
    const char *programs[count];
    for(int i=0;i<count;i++) {
        const char *prefix=i>=5 && i<=11?b:(i==3 || i==4?a:"");
        int n=tx_snprintf(statements[i],sizeof statements[i],"%s%s",prefix,cases[i]);
        if(n<0 || n>=(int)sizeof statements[i]) return 2;
        programs[i]=statements[i];
    }
    return g_math_run("G_STRUCT Clock","clock",modules,setup,programs,gold,count,
        mutate?5:-1,"let t0=Clock_getDelta(c,10.0);let stopped=Clock_stop(c,12.0);return ux_f64(c+Clock.elapsedTime);");
}
