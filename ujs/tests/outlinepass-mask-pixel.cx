#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"outlinepass-mask",0};
    const int depths[]={1073741824,1073741824,(int)2147483648U,(int)2147483648U,
        (int)3221225472U,(int)3221225472U};
    const int distances[]={20,40,45,60,65,80,12,15,17,21,29,35};
    char generated[12][180];
    const char *cases[16];
    double gold[16];
    for(int i=0;i<12;i++) {
        int d=distances[i];
        tx_snprintf(generated[i],sizeof generated[i],
            "return 0.0+OutlinePass_depthMask(%u,%d.%d,1.0,9.0,%d);",
            (unsigned)depths[i%6],d/10,d%10,i>=6);
        cases[i]=generated[i];
        gold[i]=i%2?4294967040.0:4294901760.0;
    }
    cases[12]="return 0.0+OutlinePass_depthMask(4294967296,2.0,1.0,9.0,0);";
    cases[13]="return 0.0+OutlinePass_depthMask(64,2.0,9.0,1.0,0);";
    cases[14]="return 0.0+OutlinePass_depthMask(64,0.5,1.0,9.0,1);";
    cases[15]="return 0.0+OutlinePass_depthMask(64,2.0,1.0,9.0,2);";
    for(int i=12;i<16;i++) gold[i]=-1;
    return g_wasm_batch_addon("G_PIXEL OutlinePass mask","outlinepass-mask",argv[1],modules,
        "",cases,gold,16,mutate?7:-1,
        "return 0.0+OutlinePass_depthMask(1073741824,1.5,1.0,9.0,0);");
}
