#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","vector-scalar","color","image-layout","imageutils","image-source-linear",0};
    const char *setup=
        "let a=ux_u32_put(ImageResource.rgba,512);let b=ux_u32_put(ImageResource.width,1);"
        "let c=ux_u32_put(ImageResource.height,2);let d=ux_u32_put(ImageResource.rowBytes,8);"
        "let first=ux_u32_put(512,4278190080+255*65536+128*256+10);"
        "let pad=ux_u32_put(516,305419896);let second=ux_u32_put(520,4278190080+68*256+204);";
    #define LOAD "let done=ImageUtils_sourceToLinear(0,768,8);"
    const char *cases[]={
        LOAD "return 0.0+done;",
        LOAD "return 0.0+ux_u8(768);",
        LOAD "return 0.0+ux_u8(769);",
        LOAD "return 0.0+ux_u8(772);",
        LOAD "return 0.0+ux_u8(773);",
        LOAD "return 0.0+ux_u8(775);",
        LOAD "return 0.0+ux_u32(516);",
        "return 0.0+ImageUtils_sourceToLinear(0,512,8);",
        "let keep=ux_u8_put(768,77);let refused=ImageUtils_sourceToLinear(0,768,7);return 0.0+ux_u8(768);",
        "let x=ux_u32_put(ImageResource.rowBytes,3);" LOAD "return 0.0+done;",
    };
    const double gold[]={8,1,55,154,15,255,305419896,-1,77,-1};
    return g_wasm_batch_page("G_IO ImageUtils decoded source linear","image-source-linear",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,LOAD "return 0.0+ux_u8(773);");
}
