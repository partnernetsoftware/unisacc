#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"lineloop",0};
    const char *setup="let first=LineLoop_segmentAt(0,0,4);let last=LineLoop_segmentAt(16,3,4);";
    const char *cases[]={
        "return ux_u32(first);","return ux_u32(first+4);","return ux_u32(last);","return ux_u32(last+4);",
        "return LineLoop_segmentAt(32,4,4);"
    };
    const double gold[]={0,1,3,0,-1};
    return g_math_run("G_STRUCT LineLoop","lineloop",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?3:-1,"return ux_u32(first+4);");
}
