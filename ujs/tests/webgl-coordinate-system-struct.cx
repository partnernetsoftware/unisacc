#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4",0};
    #define PERSPECTIVE "let m=Matrix4_makePerspective(0,0.0-1.0,1.0,1.0,0.0-1.0,1.0,11.0,2000.0);"
    #define ORTHOGRAPHIC "let m=Matrix4_makeOrthographic(0,0.0-1.0,1.0,1.0,0.0-1.0,1.0,11.0,2000.0);"
    const char *cases[]={
        PERSPECTIVE "return ux_f64(m+112)-ux_f64(m+80);",
        PERSPECTIVE "return (ux_f64(m+112)-ux_f64(m+80)*11.0)/11.0;",
        ORTHOGRAPHIC "return ux_f64(m+112)-ux_f64(m+80);",
        ORTHOGRAPHIC "return ux_f64(m+112)-ux_f64(m+80)*11.0;",
        "return Matrix4_makeOrthographic(0,0.0-1.0,1.0,1.0,0.0-1.0,1.0,11.0,2002.0);"
    };
    const double gold[]={-1,1,-1,1,-1};
    return g_math_run("G_STRUCT WebGL coordinate system","webgl-coordinate-system",modules,"",cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let m=Matrix4_makePerspective(0,0.0-1.0,1.0,1.0,0.0-1.0,1.0,11.0,2001.0);"
        "return ux_f64(m+112)-ux_f64(m+80);");
}
