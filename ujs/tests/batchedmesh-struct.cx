#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"batchedmesh",0};
    const char *setup=
        "let batch=BatchedMesh_init(0,128,3,9,12);"
        "let a=BatchedMesh_addGeometry(batch,1,5,5);let b=BatchedMesh_addGeometry(batch,2,3,3);"
        "let r=BatchedMesh_getRange(batch,b);";
    const char *cases[]={
        "return b;","return ux_u32(r+BatchGeometry.vertexStart);","return ux_u32(r+BatchGeometry.indexStart);",
        "return BatchedMesh_getVisibleAt(batch,b);",
        "let hide=BatchedMesh_setVisibleAt(batch,b,0);return BatchedMesh_getVisibleAt(batch,b);",
        "return BatchedMesh_addGeometry(batch,3,3,3);",
        "return BatchedMesh_addGeometry(batch,3,1,0-1);",
        "let removed=BatchedMesh_deleteGeometry(batch,a);return BatchedMesh_getVisibleAt(batch,a);",
        "let removed=BatchedMesh_deleteGeometry(batch,a);return BatchedMesh_addGeometry(batch,3,1,1);",
        "let refused=BatchedMesh_addGeometry(batch,3,3,3);return ux_u32(batch+BatchedMesh.count);"
    };
    const double gold[]={1,5,5,1,0,-2,-1,0,2,2};
    return g_math_run("G_STRUCT BatchedMesh","batchedmesh",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?7:-1,"let removed=BatchedMesh_deleteGeometry(batch,a);return BatchedMesh_getVisibleAt(batch,b);");
}
