#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","object-json-tokens","json-bytes","json-read",
        "curve-line","curve-bezier","record-copy","curve-control",0};
    const char *setup="let source=CurveControl_init(0,512,0,17);"
        "let filled=0;while(filled<12){let value=ux_f64_put(512+8*filled,1.0+filled);filled=filled+1;}";
    const char *cases[]={
        "let finish=CurveControl_toJSON(source,1024,1500,4096);"
        "let p=1024;let sum=0;while(p<finish){sum=(sum*131+ux_u8(p))%16777213;p=p+1;}return sum;",
        "let cloned=CurveControl_clone(64,source,704);"
        "let changed=ux_f64_put(704,9.0);return ux_f64(512);",
        "let finish=CurveControl_toJSON(source,1024,1500,4096);"
        "let curve=CurveControl_fromJSON(64,704,1024,finish,4096);"
        "return ux_u32(curve+CurveControl.arcLengthDivisions);",
        "let cur=CurveControl_init(0,512,1,17);let end=CurveControl_toJSON(cur,1024,1500,4096);"
        "let clone=CurveControl_fromJSON(64,704,1024,end,4096);"
        "let sample=CurveControl_getPoint(clone,800,0.5);return ux_f64(sample+16);",
        "let cur=CurveControl_init(0,512,2,17);let end=CurveControl_toJSON(cur,1024,1500,4096);"
        "let clone=CurveControl_fromJSON(64,704,1024,end,4096);"
        "let sample=CurveControl_getPoint(clone,800,0.5);return ux_f64(sample+8);",
        "let cur=CurveControl_init(0,512,3,17);let end=CurveControl_toJSON(cur,1024,1500,4096);"
        "let clone=CurveControl_fromJSON(64,704,1024,end,4096);"
        "let sample=CurveControl_getPoint(clone,800,0.5);return ux_f64(sample+16);",
        "let cur=CurveControl_init(0,512,4,17);let end=CurveControl_toJSON(cur,1024,1500,4096);"
        "let clone=CurveControl_fromJSON(64,704,1024,end,4096);"
        "let sample=CurveControl_getPoint(clone,800,0.5);return ux_f64(sample+8);",
        "let cur=CurveControl_init(0,512,5,17);let end=CurveControl_toJSON(cur,1024,1500,4096);"
        "let clone=CurveControl_fromJSON(64,704,1024,end,4096);"
        "let sample=CurveControl_getPoint(clone,800,0.5);return ux_f64(sample+16);",
        "let finish=CurveControl_toJSON(source,1024,1500,4096);"
        "let broken=ux_u8_put(finish-1,93);return CurveControl_fromJSON(64,704,1024,finish,4096);"
    };
    const char expected[]="{\"metadata\":{\"version\":4.6,\"type\":\"Curve\",\"generator\":\"Curve.toJSON\"},"
        "\"arcLengthDivisions\":17,\"type\":\"LineCurve\",\"v1\":[1,2],\"v2\":[3,4]}";
    uint64_t hash=0;
    for(int i=0;i<(int)sizeof expected-1;i++) hash=(hash*131+(unsigned char)expected[i])%16777213;
    const double gold[]={(double)hash,1,17,4.5,4,6,5,7.5,-1};
    return g_math_run("G_STRUCT Fixed-point-count curve lifecycle","curve-control",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let cloned=CurveControl_clone(64,source,704);let edit=ux_f64_put(512,9.0);return ux_f64(512);");
}
