#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[390],abi[300],wasm[300],url[690];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-stereo-eye-pixel-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/stereo.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/ujs/practice/uxe/test/stereo-eye-pair-pixel-r160.html?wasm=file://%s&mutate=%d",cwd,wasm,mutate);
    const char entry[]="export uxe_stereo_pair_render(mode:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,"ujs/practice/uxe/base/f64-math.ujs",
        "ujs/practice/uxe/base/views.ujs","ujs/practice/uxe/base/matrix4.ujs",
        "ujs/practice/uxe/base/object-layouts.ujs","ujs/practice/uxe/base/object3d.ujs",
        "ujs/practice/uxe/base/camera.ujs","ujs/practice/uxe/base/perspectivecamera.ujs",
        "ujs/practice/uxe/base/stereocamera.ujs","ujs/practice/uxe/base/stereo-eye-record.ujs",
        "ujs/practice/uxe/base/stereo-eye-pair.ujs","ujs/practice/uxe/base/stereo-eye-render.ujs",
        "ujs/practice/uxe/test/stereo-eye-pair-probe.ujs","-o",wasm,0};
    const double gold[]={4096,0,0,3,5,0,1,1,1,1,1,1,1,1,6};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    char *out=0;
    size_t bytes=0;
    int failed=length<0 || length>=(int)sizeof url || sy_write_file(abi,entry,sizeof entry-1,0600);
    if(!failed) {
        const int rc=cx_runv_timeout(compile,12,&out,&bytes);
        if(rc) { printf("G_PIXEL Stereo pair compiler_rc=%d %s\n",rc,out?out:""); failed=1; }
        mm_free(out); out=0;
    }
    if(!failed) {
        failed=r160_wait_read(url,"#result",actual,count,dir);
        if(!failed) {
            printf("G_PIXEL Stereo pair pixels=%.0f live_diff=%.0f released_diff=%.0f parallax=%.0f gpu_release=%.0f\n",
                actual[0],actual[1],actual[2],actual[8],actual[13]);
            for(int i=0;i<count;i++) if(actual[i]!=gold[i]) {
                printf("G_PIXEL Stereo pair field=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
                failed=1;
            }
        }
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&out,&bytes)) failed=1;
    mm_free(out);
    printf("G_PIXEL Stereo pair failed=%d\n",failed);
    return failed;
}
