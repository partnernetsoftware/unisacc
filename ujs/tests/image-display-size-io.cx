#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","vector-scalar","color","image-layout","imageutils","image-source-linear","image-display-size",0};
    const char *setup="let source=512;let out=768;"
        "let a=ux_u32_put(ImageResource.rgba,source);let b=ux_u32_put(ImageResource.width,2);"
        "let c=ux_u32_put(ImageResource.height,1);let d=ux_u32_put(ImageResource.rowBytes,8);"
        "let black=ux_u32_put(source,4278190080);let white=ux_u32_put(source+4,4294967295);";
    #define SCALE "let bytes=ImageUtils_displayRaster(0,4,1,out,16);"
    #define ALPHA "let red=ux_u32_put(source,4278190335);let clear=ux_u32_put(source+4,16711680);"
    const char *cases[]={
        SCALE "return 0.0+bytes;",
        SCALE "return 0.0+ux_u8(out);",
        SCALE "return 0.0+ux_u8(out+4);",
        SCALE "return 0.0+ux_u8(out+8);",
        SCALE "return 0.0+ux_u8(out+12);",
        ALPHA SCALE "return 0.0+ux_u8(out+4);",
        ALPHA SCALE "return 0.0+ux_u8(out+7);",
        ALPHA SCALE "return 0.0+ux_u8(out+11);",
        ALPHA SCALE "return 0.0+ux_u32(out+12);",
        "let n=ImageUtils_displayRaster(0,1,1,out,4);return 0.0+ux_u8(out);",
        "return 0.0+ImageUtils_displayRaster(0,4,1,source,16);",
        "return 0.0+ImageUtils_displayRaster(0,4,1,out,15);",
    };
    const double gold[]={16,0,(int)(255*0.25),(int)(255*0.75),255,255,
        (int)(255*0.75),(int)(255*0.25),0,(int)(255*0.5+0.5),-1,-1};
    return g_wasm_batch_page("G_IO ImageUtils display dimensions","image-display-size",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,SCALE "return 0.0+ux_u8(out+8);");
}
