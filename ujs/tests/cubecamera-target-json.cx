#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define WRITE "let stop=CubeCamera_writeTargetJSON(128,256,512,1024);"
#define READ "let result=CubeCamera_readTargetJSON(160,256,stop,2304);"

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","helper-buffers","json-read","json-bytes","cubecamera-target-json",0};
    const char *setup="let size=ux_u32_put(128,4);let faces=ux_u32_put(132,6);";
    const char *cases[]={
        WRITE READ "return 0.0+ux_u32(160);",
        WRITE READ "return 0.0+ux_u32(164);",
        "let bad=ux_u32_put(132,5);return 0.0+CubeCamera_writeTargetJSON(128,256,512,1024);",
        WRITE "let bad=ux_u8_put(stop-2,53);" READ "return 0.0+result;",
    };
    const double gold[]={4,6,-1,-1};
    return g_wasm_batch("G_STRUCT CubeCamera target JSON","cubecamera-target-json",modules,setup,cases,gold,4,
        mutate?0:-1,"let changed=ux_u32_put(128,8);" WRITE READ "return 0.0+ux_u32(160);");
}
