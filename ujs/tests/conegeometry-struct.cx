#pragma unisa use g_cylinder
#pragma unisa use g_geometry
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","geometry-buffers","cylindergeometry","conegeometry",0};
    char source[640];
    tx_snprintf(source,sizeof source,"let mesh=GeometryBuffers_init(0,256,19,2048,36);"
        "let config=CylinderGeometry_init(4096,1.0,1.0,%d.0,0.0,6.283185307179586,4.0,1.0,0.0);"
        "return ConeGeometry_generate(mesh,config);",mutate?3:2);
    double gold[190];
    int count=g_cylinder_gold(gold,1);
    return g_geometry_check("ConeGeometry","conegeometry",modules,source,gold,count,154);
}
