#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","glbufferattribute",0};
    const char *setup="let a=GLBufferAttribute_init(0,7,1015,3,4,5);"
        "let c=GLBufferAttribute_init(32,7,1015,3,4,5);"
        "let b=GLBufferAttribute_setBuffer(c,8);let t=GLBufferAttribute_setType(c,1012,2);"
        "let i=GLBufferAttribute_setItemSize(c,2);let d=GLBufferAttribute_setCount(c,6);let u=GLBufferAttribute_needsUpdate(c,1);";
    const char *cases[]={"return a>=0;","return ux_u32(a+GLBufferAttribute.buffer);",
        "return ux_u32(a+GLBufferAttribute.componentType);","return ux_u32(a+GLBufferAttribute.elementSize);",
        "return ux_u32(a+GLBufferAttribute.count);","return ux_u32(a+GLBufferAttribute.version);",
        "return ux_u32(c+GLBufferAttribute.buffer);","return ux_u32(c+GLBufferAttribute.componentType);",
        "return ux_u32(c+GLBufferAttribute.elementSize);","return ux_u32(c+GLBufferAttribute.itemSize);",
        "return ux_u32(c+GLBufferAttribute.count);","return ux_u32(c+GLBufferAttribute.version);"};
    const double gold[]={1,7,1015,4,5,0,8,1012,2,2,6,1};
    return g_math_run("G_STRUCT GLBufferAttribute","glbufferattribute",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?11:-1,"return ux_u32(a+GLBufferAttribute.version);");
}
