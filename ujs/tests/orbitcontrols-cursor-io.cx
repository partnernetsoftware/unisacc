#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define WHEEL(d) "let event=OrbitControls_wheel(256," d ",1);"
#define CURSOR(x,y,z,mode) "let status=OrbitControls_zoomCursor(256," x "," y "," z "," mode ");"
#define SHIFT WHEEL("0.0-100.0") CURSOR("1.0","0.5","0.0-1.0","1")
#define FIELD(name) "return ux_f64(256+OrbitControls." #name ");"

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"f64-math","vector-scalar","orbitcontrols","orbitcontrols-cursor",0};
    const char *setup="let z=ux_f64_put(16,10.0);let init=OrbitControls_init(256,0,64,100.0);";
    const char *cases[]={
        SHIFT FIELD(x), SHIFT FIELD(y), SHIFT FIELD(z),
        SHIFT FIELD(targetX), SHIFT FIELD(targetY), SHIFT FIELD(targetZ), SHIFT FIELD(radius),
        WHEEL("0.0-100.0") CURSOR("0.0-1.0","0.0-0.5","0.0-1.0","1") FIELD(x),
        WHEEL("0.0-100.0") CURSOR("0.0","0.0","0.0-1.0","1") FIELD(z),
        WHEEL("100.0") CURSOR("1.0","0.5","0.0-1.0","1") FIELD(x),
        "let min=ux_f64_put(256+OrbitControls.minRadius,9.75);" SHIFT FIELD(x),
        WHEEL("0.0-100.0") CURSOR("1.0","0.5","0.0-1.0","0") FIELD(targetY),
        WHEEL("0.0-100.0") CURSOR("0.0","0.0","0.0","1") "return 0.0+status;",
        WHEEL("0.0-100.0") CURSOR("0.0","0.0","0.0","1") FIELD(zoomScale),
        SHIFT FIELD(zoomScale),
    };
    const double gold[]={1.0/3,1.0/6,29.0/3,1.0/3,1.0/6,1.0/6,9.5,
        -1.0/3,9.5,(10-10/0.95)/1.5,1.0/6,0,-1,0.95,1};
    return g_wasm_batch_addon("G_RAY OrbitControls cursor zoom","orbitcontrols-cursor",
        argv[1],modules,setup,cases,gold,sizeof gold/sizeof gold[0],mutate?0:-1,
        WHEEL("0.0-100.0") CURSOR("0.0-1.0","0.5","0.0-1.0","1") FIELD(x));
}
