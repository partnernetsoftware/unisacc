#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","glb-container","json-read","loader-json",
        "gltf-accessor","gltf-sparse-accessor","gltf-primitive-index",0};
    const char json[]="{\"meshes\":[{\"primitives\":[{\"indices\":0},{}]}],"
        "\"accessors\":[{\"componentType\":5123,\"count\":3,\"type\":\"SCALAR\",\"sparse\":{"
        "\"count\":2,\"indices\":{\"bufferView\":0,\"componentType\":5121},\"values\":{\"bufferView\":1}}}],"
        "\"bufferViews\":[{\"buffer\":0,\"byteLength\":2},{\"buffer\":0,\"byteOffset\":4,\"byteLength\":4}]}";
    char setup[4500];
    int n=tx_snprintf(setup,sizeof setup,
        "let input=128;let bin=1024;let out=1200;let target=1400;let key=1500;"
        "let a=ux_u32_put(GlbResource.json,input);let b=ux_u32_put(GlbResource.jsonBytes,%d);"
        "let c=ux_u32_put(GlbResource.bin,bin);let d=ux_u32_put(GlbResource.binBytes,8);"
        "let i0=ux_u8_put(bin,1);let i1=ux_u8_put(bin+1,2);"
        "let v0=ux_u16_put(bin+4,1);let v1=ux_u16_put(bin+6,2);",(int)sizeof json-1);
    for(int at=0;at<(int)sizeof json-1;at+=64) {
        int count=(int)sizeof json-1-at;
        if(count>64) count=64;
        n+=tx_snprintf(setup+n,sizeof setup-n,"if(1){let raw=[");
        for(int i=0;i<count;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[at+i]);
        n+=tx_snprintf(setup+n,sizeof setup-n,"];let i=0;while(i<%d){let a=ux_u8_put(input+%d+i,raw[i]);i=i+1;}}",count,at);
    }
    #define LOAD "let n=GltfLoader_primitiveIndex(0,0,0,out,target,6,key);"
    const char *cases[]={
        LOAD "return 0.0+ux_u32(n+GltfAccessor.count);",
        LOAD "return 0.0+ux_u16(target);",
        LOAD "return 0.0+ux_u16(target+2);",
        LOAD "return 0.0+ux_u16(target+4);",
        "return 0.0+GltfLoader_primitiveIndex(0,0,1,out,target,6,key);",
        "return 0.0+GltfLoader_primitiveIndex(0,0,2,out,target,6,key);",
        "let q=ux_u8_put(bin+1,3);let p=ux_u16_put(target,77);" LOAD "return 0.0+(n==0-5 && ux_u16(target)==77);",
    };
    const double gold[]={3,0,1,2,-8,-2,1};
    return g_wasm_batch_addon("G_IO GLTF primitive sparse indices","gltf-primitive-index",argv[1],modules,
        setup,cases,gold,sizeof gold/sizeof gold[0],mutate?3:-1,
        "let q=ux_u16_put(bin+6,1);" LOAD "return 0.0+ux_u16(target+4);");
}
