#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","record-copy","eventdispatcher","material-class","material-classes-generated",0};
    const char *setup=
        "let event=EventDispatcher_init(64,128,2);let other=EventDispatcher_init(80,160,2);"
        "let src=MeshBasicMaterial_new(256,17,event);let dst=MeshPhongMaterial_new(384,19,other);";
    const char *cases[]={
        "return ux_u32(src+Material.depthFunc);",
        "let n=Material_needsUpdate(src,0);return ux_u32(src+Material.version);",
        "let a=Material_setAlphaTest(src,0.4);let b=Material_setAlphaTest(src,0.9);"
        "let c=Material_needsUpdate(src,1);return ux_u32(src+Material.version);",
        "let a=ux_u32_put(src+Material.side,2);let b=Material_setAlphaTest(src,0.5);"
        "let c=Material_copy(dst,src);return 1000*ux_u32(c+Material.type)+100*ux_u32(c+Material.version)"
        "+10*ux_u32(c+Material.side)+(ux_u32(c+Material.id)==19);",
        "let a=ux_f64_put(src+Material.opacity,0.25);let cloned=Material_clone(512,src,20,other);"
        "let b=ux_f64_put(src+Material.opacity,0.75);return ux_f64(cloned+Material.opacity);",
        "let add=EventDispatcher_addListener(event,7,42);let a=Material_dispose(src,7,640,2);"
        "return 100*ux_u32(640)+10*a+(ux_u32(648)==42);",
        "let clone=Material_clone(512,src,20,other);return ux_u32(clone+Material.type)==ux_u32(src+Material.type);"
    };
    const double gold[]={3,0,2,3121,0.25,1711,1};
    return g_math_run("G_STRUCT Material shared lifecycle","material-class",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,"let n=Material_needsUpdate(src,1);return ux_u32(src+Material.version);");
}
