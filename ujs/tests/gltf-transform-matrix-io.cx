#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","record-copy","loadingmanager","fileloader","gltf-transform-matrix",0};
    const char *setup="let record=0;let out=256;"
        "let x=ux_f64_put(record+8,3.0);let q=ux_f64_put(record+48,0.6);let w=ux_f64_put(record+56,0.8);"
        "let a=ux_f64_put(record+64,2.0);let b=ux_f64_put(record+72,3.0);let c=ux_f64_put(record+80,4.0);";
    #define LOAD "let result=GltfLoader_transformMatrix(record,out);"
    const char *cases[]={
        LOAD "return ux_f64(out);",
        LOAD "return ux_f64(out+8);",
        LOAD "return ux_f64(out+32);",
        LOAD "return ux_f64(out+80);",
        LOAD "return ux_f64(out+96);",
        "let kind=ux_u32_put(record,1);let x=ux_f64_put(record+104,8.0);" LOAD "return ux_f64(out+96);",
        "let kind=ux_u32_put(record,2);let keep=ux_f64_put(out,77.0);" LOAD "return ux_f64(out);",
        "return 0.0+GltfLoader_transformMatrix(record,128);",
    };
    const double gold[]={0.56,1.92,-2.88,4,3,8,77,-1};
    return g_wasm_batch("G_IO GLTF transform to Matrix4","gltf-transform-matrix",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,LOAD "return ux_f64(out+8);");
}
