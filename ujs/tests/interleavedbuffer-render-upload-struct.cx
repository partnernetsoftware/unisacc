#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[390],abi[300],body[300],wasm[300],url[780];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-ib-render-upload-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(body,sizeof body,"%s/entry.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/upload.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/ujs/practice/uxe/test/interleavedbuffer-render-upload-r160.html?wasm=%s%s",
        cwd,wasm,mutate?"&mutate=1":"");
    const char signature[]=
        "import host_ib_transfer from \"uxe_ib_v1\"(i64,i64,i64,i64,i64,i64) i64;\n"
        "import host_ib_callback from \"uxe_ib_v1\"(i64,i64) i64;\n"
        "import host_ib_delete from \"uxe_ib_v1\"(i64,i64) i64;\n"
        "export uxe_ib_probe(op:i64,x:i64,y:i64) i64 version 1;\n";
    const char entry[]=
        "let buffer=32;let data=256;let authority=96;let second=128;"
        "let replica=192;"
        "if(x==2){replica=224;}"
        "if(op==0){"
        "  let setup=InterleavedBuffer_init(buffer,data,3,12,9);"
        "  let a=ux_f32_put(data,0.0-0.5);let b=ux_f32_put(data+4,0.0-0.5);"
        "  let c=ux_f32_put(data+12,0.5);let d=ux_f32_put(data+16,0.0-0.5);let e=ux_f32_put(data+28,0.5);"
        "  let first=InterleavedBuffer_initUpload(authority,buffer);"
        "  let next=InterleavedBuffer_initUpload(second,buffer);"
        "  let p=InterleavedBuffer_bindGpu(192,authority,1,1);"
        "  let q=InterleavedBuffer_bindGpu(224,second,2,1);"
        "  return first==96 && next==128 && p>=0 && q>=0;}"
        "if(op==1){if(x==2 && y==1){return InterleavedBuffer_renderUpload(replica,second);}return InterleavedBuffer_renderUpload(replica,authority);}"
        "if(op==2){return InterleavedBuffer_onUpload(authority,x)==authority;}"
        "if(op==3){let moved=ux_f32_put(data,0.0-0.25);return InterleavedBuffer_needsUpdate(buffer,1);}"
        "if(op==4){return InterleavedBuffer_releaseGpu(replica);}"
        "if(op==5){return InterleavedBuffer_bindGpu(192,authority,1,x)>=0;}"
        "return 0-1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,"ujs/practice/uxe/base/object-layouts.ujs",
        "ujs/practice/uxe/base/datautils.ujs","ujs/practice/uxe/base/bufferattribute.ujs",
        "ujs/practice/uxe/base/interleavedbuffer.ujs","ujs/practice/uxe/base/interleavedbuffer-edit.ujs",
        "ujs/practice/uxe/base/interleavedbuffer-upload.ujs",
        "ujs/practice/uxe/base/interleavedbuffer-render-upload.ujs",body,"-o",wasm,0};
    const double gold[]={
        2,91,1,1, 1,92,2,1, 2,92,2,1, 1,92,3,1,
        1,0,1,1,0,1,0, 32,-2,1,1,0,1,-1,1,1,0, 1,-0.25,-0.25,1,1
    };
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    char *output=0; size_t bytes=0;
    int failed=length<=0 || length>=(int)sizeof url || sy_write_file(abi,signature,sizeof signature-1,0600) ||
        sy_write_file(body,entry,sizeof entry-1,0600);
    if(!failed) {
        const int rc=cx_runv_timeout(compile,6,&output,&bytes);
        if(rc) { printf("IB_RENDER_UPLOAD compile_rc=%d %s\n",rc,output?output:""); failed=1; }
        mm_free(output); output=0;
    }
    if(!failed) {
        failed=r160_wait_read(url,"#r160",actual,count,dir);
        for(int i=0;!failed && i<count;i++) {
            if(actual[i]!=gold[i]) {
                printf("IB_RENDER_UPLOAD case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
                failed=1;
            }
        }
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,4,&output,&bytes)) failed=1;
    mm_free(output);
    printf("G_STRUCT InterleavedBuffer WebGL2 renderer upload lifecycle cases=%d failed=%d\n",count,failed);
    return failed;
}
