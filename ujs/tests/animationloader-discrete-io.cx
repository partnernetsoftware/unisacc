#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","loaderutils","json-read","json-bytes","json-string-decode","loader-json","loadingmanager","fileloader",
        "animation-view","keyframe-track","animationclip","animationloader","animationloader-discrete","animationloader-batch",0};
    const char json[]="[{\"name\":\"\\u7ec4\",\"tracks\":["
        "{\"name\":\".visible\",\"type\":\"boolean\",\"times\":[0,1],\"values\":[true,false],\"interpolation\":2301},"
        "{\"name\":\"\\u540d\",\"type\":\"string\",\"times\":[0,2],\"values\":[\"\\u706f\\u821f\",\"A\\nB\"]},"
        "{\"name\":\".weight\",\"type\":\"number\",\"times\":[0,1],\"values\":[0.25,0.75]}]},"
        "{\"name\":\"next\",\"tracks\":[]}]";
    const long marker=tx_find(json,sizeof json-1,"true",4);
    if(marker<0) return 2;
    char setup[3000];
    const int size=sizeof json-1;
    int used=tx_snprintf(setup,sizeof setup,"let size=%d;let token=%ld;",size,256+marker);
    for(int at=0;at<size;at+=60) {
        const int span=size-at<60?size-at:60;
        used+=tx_snprintf(setup+used,sizeof setup-used,"if(1){let bytes=[");
        for(int j=0;j<span;j++) used+=tx_snprintf(setup+used,sizeof setup-used,"%s%d",j?",":"",json[at+j]);
        used+=tx_snprintf(setup+used,sizeof setup-used,"];let i=0;while(i<%d){let a=ux_u8_put(%d+i,bytes[i]);i=i+1;}}",span,256+at);
    }
    tx_snprintf(setup+used,sizeof setup-used,
        "let manager=LoadingManager_init(0);let file=FileLoader_init(32,manager);let id=FileLoader_begin(file,64);"
        "let ready=FileLoader_receive(file,id,200,256,size,64);");
    #define LOAD "let n=AnimationLoader_parse(file,2048,2,4096,8192,6);"
    #define CLIP "let clip=ux_u32(2048);let tracks=ux_u32(clip+AnimationClip.tracks);"
    #define BOOL "let track=ux_u32(tracks);let view=ux_u32(track+KeyframeTrack.samples);let values=ux_u32(view+AnimationSamples.values);"
    #define STR "let track=ux_u32(tracks+4);let view=ux_u32(track+KeyframeTrack.samples);let values=ux_u32(view+AnimationSamples.values);"
    const char *cases[]={
        LOAD "return 0.0+n;",
        LOAD CLIP "return 0.0+ux_u32(clip+AnimationClip.nameBytes);",
        LOAD CLIP BOOL "return 0.0+ux_u32(track+KeyframeTrack.interpolation);",
        LOAD CLIP BOOL "return 0.0+ux_u32(values);",
        LOAD CLIP BOOL "return 0.0+ux_u32(values+4);",
        LOAD CLIP STR "return 0.0+ux_u32(view+AnimationSamples.stride)/2;",
        LOAD CLIP STR "return 0.0+ux_u32(values+4);",
        LOAD CLIP STR "return 0.0+ux_u8(ux_u32(values));",
        LOAD CLIP STR "return 0.0+ux_u8(ux_u32(values+8)+1);",
        LOAD CLIP STR "return 0.0+ux_u32(track+KeyframeTrack.nameBytes);",
        LOAD CLIP "let track=ux_u32(tracks+8);let view=ux_u32(track+KeyframeTrack.samples);"
        "return ux_f32(ux_u32(view+AnimationSamples.values)+4);",
        "return 0.0+AnimationLoader_parseNumeric(file,2048,2,4096,8192);",
        "let broken=ux_u32_put(token,1819047278);" LOAD "return 0.0+n;",
        "let guard=ux_u32_put(2048,99);let n=AnimationLoader_parse(file,2048,2,4096,2048,6);return 0.0+ux_u32(2048);"
    };
    const double gold[]={2,3,2300,1,0,1,6,231,10,3,.75,-3,-3,99};
    return g_wasm_batch("G_IO AnimationLoader discrete clips","animationloader-discrete",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?8:-1,LOAD CLIP STR "return 0.0+ux_u8(ux_u32(values+8));");
}
