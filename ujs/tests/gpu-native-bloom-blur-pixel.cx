#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

#define RGB(r,g,b) ((r)+256.0*(g)+65536.0*(b)+16777216.0*255)
#define MATCH(h,v) h,h,v,v,0,0,0,0,0,0,0,0

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if((argc!=2 && !mutate) || argv[1][0]!='/') return 2;
    char dir[256],cwd[390],abi[300],wasm[300],url[720];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-native-bloom-blur-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/bloom.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/ujs/practice/uxe/test/gpu-native-bloom-blur-r160.html?package=%s&wasm=%s&mode=%d",
        cwd,argv[1],wasm,mutate);
    const char entry[]="import host_gpu_submit from \"uxe_gpu_v1\"(i64,i64) i64;\n"
        "import host_gpu_native_copy from \"uxe_gpu_target_v1\"(i64,i64,i64,i64) i64;\n"
        "export uxe_native_bloom_blur(mode:i64,mutate:i64,vn:i64,fn:i64,dn:i64,rn:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,"ujs/practice/uxe/base/record-copy.ujs",
        "ujs/practice/uxe/base/gpu-packet.ujs","ujs/practice/uxe/base/gpu-target.ujs",
        "ujs/practice/uxe/base/effectcomposer.ujs","ujs/practice/uxe/base/effectcomposer-gpu-targets.ujs",
        "ujs/practice/uxe/base/gpu-native-sample.ujs","ujs/practice/uxe/base/effectcomposer-native.ujs",
        "ujs/practice/uxe/base/gpu-native-color-correction.ujs",
        "ujs/practice/uxe/test/gpu-native-bloom-blur-probe.ujs","-o",wasm,0};
    const double gold[]={MATCH(RGB(53,27,13),RGB(12,6,3)),MATCH(RGB(30,15,8),RGB(4,2,1)),4};
    enum { perKernel=12, count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    char *output=0;
    size_t bytes=0;
    int failed=length<0 || length>=(int)sizeof url || sy_write_file(abi,entry,sizeof entry-1,0600);
    if(!failed) {
        const int rc=cx_runv_timeout(compile,6,&output,&bytes);
        if(rc) { printf("G_PIXEL native Bloom compiler_rc=%d %s\n",rc,output?output:""); failed++; }
        mm_free(output); output=0;
    }
    if(!failed) failed=r160_wait_read(url,"#r160",actual,count,dir);
    if(!failed) {
        for(int i=0;i<count-1;i+=perKernel) {
            printf("G_PIXEL native Bloom radius=%d rgba8_diff=%.0f half_diff=%.0f half_max=%.0f\n",
                i?5:3,actual[i+4]+actual[i+6],actual[i+8]+actual[i+10],
                actual[i+9]>actual[i+11]?actual[i+9]:actual[i+11]);
        }
        for(int i=0;i<count;i++) if(actual[i]!=gold[i]) {
            const int field=i%perKernel;
            // The native RGBA8 path rounds once more between axes.
            if(i<count-1 && field>=8 && actual[i]>=0 && actual[i]<=(field%2?1:140)) continue;
            printf("G_PIXEL native Bloom case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
            failed++;
        }
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&output,&bytes)) failed++;
    mm_free(output);
    printf("G_PIXEL native Bloom blur cases=%d failed=%d\n",count,failed);
    return failed!=0;
}
