#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"png-header",0};
    const char *setup=
        "let raw=[137,80,78,71,13,10,26,10,0,0,0,13,73,72,68,82,0,0,0,1,0,0,0,1,8,6,0,0,0,31,21,196,137];"
        "let i=0;while(i<33){let b=ux_u8_put(i,raw[i]);i=i+1;}";
    const char *cases[]={
        "let h=PngHeader_probe(0,33,64);return ux_u32(h+PngHeader.width);",
        "let h=PngHeader_probe(0,33,64);return ux_u32(h+PngHeader.height);",
        "let h=PngHeader_probe(0,33,64);return ux_u32(h+PngHeader.depth);",
        "let h=PngHeader_probe(0,33,64);return ux_u32(h+PngHeader.color);",
        "return PngHeader_probe(0,32,64);",
        "let b=ux_u8_put(23,2);return PngHeader_probe(0,33,64);",
        "return PngHeader_probe(0,33,4);"
    };
    const double gold[]={1,1,8,6,-2,-3,-1};
    return g_math_run("G_IO PngHeader","png-header",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let b=ux_u8_put(23,2);return PngHeader_probe(0,33,64);");
}
