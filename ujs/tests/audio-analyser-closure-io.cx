#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use text.fmt
#pragma unisa use text.text

static int analyser_compile(const char *dir) {
    char layout[320],wasm[320];
    tx_snprintf(layout,sizeof layout,"%s/probe-layout.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/probe.wasm",dir);
    const char abi[]="export uxe_audio_analyser_closure(op:i64,out:i64,bins:i64,capacity:i64) f64 version 1;\n";
    if(sy_write_file(layout,abi,sizeof abi-1,0600)) return 1;
    char *args[]={"./ujs/ujs2wasm.com",layout,"ujs/practice/uxe/base/f64-math.ujs",
        "ujs/practice/uxe/base/loadingmanager.ujs","ujs/practice/uxe/base/fileloader.ujs",
        "ujs/practice/uxe/base/audioloader.ujs","ujs/practice/uxe/base/audio-buffer-playback.ujs",
        "ujs/practice/uxe/base/audio-analyser-window.ujs","ujs/practice/uxe/base/audio-spectrum.ujs",
        "ujs/practice/uxe/base/audio-spectrum-cache.ujs","ujs/practice/uxe/base/audio-analyser-closure.ujs",
        "ujs/practice/uxe/test/audio-analyser-closure-probe.ujs","-o",wasm,0};
    char *log=0;
    size_t bytes=0;
    const int rc=cx_runv_timeout(args,8,&log,&bytes);
    if(rc) printf("AUDIO_ANALYSER_BUILD rc=%d output=%.*s\n",rc,(int)bytes,log);
    mm_free(log);
    return rc;
}

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[460],url[840];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","ujs-audio-analyser-",dir,sizeof dir)) return 2;
    const int n=tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/audio-analyser-closure-r160.html?dir=%s%s",
        cwd,dir,mutate?"&mutate=1":"");
    // The Blackman window gives a DC input three nonzero byte bins.
    // The real output keeps playing after either analyser is detached.
    #define BINS 118,101,43,0
    #define LIFE 1,1,1,1,118,1000
    #define DEFAULT 1,2048,1024,1,1,1,1,BINS,262.0/1024.0,LIFE
    #define SMALL 1,32,16,1,1,1,1,BINS,262.0/16.0,LIFE
    const double gold[]={DEFAULT,SMALL,1,DEFAULT,SMALL};
    enum { count=sizeof gold/sizeof gold[0] };
    double values[count]={0};
    int failed=n<0 || n>=sizeof url || analyser_compile(dir) || r160_wait_read(url,"#r160",values,count,dir);
    for(int i=0;!failed && i<count;i++) if(values[i]!=gold[i]) {
        printf("AUDIO_ANALYSER case=%d actual=%.17g gold=%.17g\n",i,values[i],gold[i]);
        failed=1;
    }
    if(sy_remove_all(dir)) failed=1;
    printf("G_IO AudioAnalyser WebAudio connection and byte cache cases=%d failed=%d\n",count,failed);
    return failed;
}
