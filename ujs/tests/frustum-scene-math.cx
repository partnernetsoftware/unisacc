#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"vector-scalar","vector3","box3","sphere","frustum",0};
    const char *setup="let a0=ux_f64_put(0,1.0);let a1=ux_f64_put(40,1.0);"
        "let a2=ux_f64_put(80,1.0);let a3=ux_f64_put(120,1.0);"
        "let f=Frustum_setFromProjectionMatrix(128,0,0);let l=ux_f64_put(344,0.5);";
    const char *cases[]={
        "let x=ux_f64_put(96,2.0);return Frustum_intersectsObject(f,320,0,352);",
        "let x=ux_f64_put(96,2.0);let s=ux_f64_put(0,2.0);return Frustum_intersectsObject(f,320,0,352);",
        "let x=ux_f64_put(96,1.6);return Frustum_intersectsSprite(f,0,352);",
        "let x=ux_f64_put(96,1.8);return Frustum_intersectsSprite(f,0,352);"
    };
    const double gold[]={0,1,1,0};
    return g_math_run("G_MATH Frustum objects","frustum-scene",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?3:-1,"let x=ux_f64_put(96,0.0);return Frustum_intersectsSprite(f,0,352);");
}
