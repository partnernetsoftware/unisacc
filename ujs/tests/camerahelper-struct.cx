#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"helper-buffers","camerahelper",0};
    const char *setup="let helper=0;let xyz=128;let rgb=768;let world=1408;let inv=1536;let palette=1664;let persp=1792;"
        "let a=ux_f64_put(inv,4.0);let b=ux_f64_put(inv+40,3.0);let c=ux_f64_put(inv+80,0.0-4.0);"
        "let d=ux_f64_put(inv+96,2.0);let e=ux_f64_put(inv+104,1.0);let f=ux_f64_put(inv+112,0.0-5.0);"
        "let g=ux_f64_put(inv+120,1.0);let h=ux_f32_put(palette+28,0.25);"
        "let p=ux_f64_put(persp,1.0);let q=ux_f64_put(persp+40,1.0);"
        "let r=ux_f64_put(persp+88,0.0-4.0/9.0);let s=ux_f64_put(persp+112,0.0-1.0);"
        "let t=ux_f64_put(persp+120,5.0/9.0);let init=CameraHelper_init(helper,xyz,rgb,world,inv);";
    const char *cases[]={
        "return 0.0+ux_u32(helper+CameraHelper.count);",
        "return ux_f32(xyz);",
        "return ux_f32(xyz+4);",
        "return ux_f32(xyz+8);",
        "return ux_f32(xyz+104);",
        "return ux_f32(xyz+24*12+8);",
        "return ux_f32(xyz+32*12);",
        "return ux_f32(xyz+35*12+4);",
        "return ux_f32(xyz+39*12+8);",
        "return ux_f32(rgb+32*12+8);",
        "return ux_f32(rgb+40*12);",
        "let up=CameraHelper_update(helper,persp);return ux_f32(xyz+8*12);",
        "let up=CameraHelper_update(helper,persp);return 0.0+ux_u32(helper+CameraHelper.positionVersion);",
        "let up=CameraHelper_setColors(helper,palette);return ux_f32(rgb+32*12+4);",
        "let up=CameraHelper_setColors(helper,palette);return 0.0+ux_u32(helper+CameraHelper.colorVersion);",
        "let moved=ux_f64_put(world+96,3.0);return ux_f64(ux_u32(helper+CameraHelper.matrix)+96);",
        "let gone=CameraHelper_dispose(helper);return 0.0+ux_u32(helper+CameraHelper.active);",
        "let zero=ux_f64_put(inv+120,0.0);return 0.0+CameraHelper_update(helper,inv);",
        "return 0.0+CameraHelper_setColors(helper,rgb);",
    };
    const double gold[]={50,-2,-2,-1,-9,0,(double)(float)4.8,7,-9,1,(double)(float)0.033104766565152086,
        -9,2,0.25,2,3,0,-1,-1};
    return g_wasm_batch("G_STRUCT CameraHelper","camerahelper",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?11:-1,"return ux_f32(xyz+8*12);");
}
