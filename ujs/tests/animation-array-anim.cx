#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","datautils","bufferattribute","record-copy","animation-view","animation-array",0};
    const char *setup="let a=ux_f64_put(128,0.5);let b=ux_f64_put(136,1.5);"
        "let c=ux_f64_put(144,257.0);let d=ux_f64_put(152,0.0-2.0);"
        "let src=64;let data=ux_u32_put(src+AnimationArrayView.data,128);"
        "let n=ux_u32_put(src+AnimationArrayView.count,4);"
        "let typed=AnimationUtils_convertArray(src,3,0,192,256,32,512);";
    const char *cases[]={
        "return AnimationUtils_isTypedArray(src);","return AnimationUtils_isTypedArray(typed);",
        "return ux_u8(256);","return ux_u8(257);","return ux_u8(258);",
        "return AnimationUtils_convertArray(typed,3,0,320,384,32,512)==typed;",
        "return AnimationUtils_convertArray(typed,3,1,320,384,32,512)!=typed;",
        "let plain=AnimationUtils_convertArray(typed,0,0,320,384,32,512);return ux_f64(384+16);",
        "let flag=ux_u32_put(src+AnimationArrayView.kind,11);return AnimationUtils_isTypedArray(src);",
        "return AnimationUtils_convertArray(0-1,9,0,320,384,32,512);",
        "return AnimationUtils_convertArray(typed,3,1,320,256,32,512);"
    };
    const double gold[]={0,1,0,2,255,1,1,255,0,-1,-2};
    return g_math_run("G_ANIM AnimationUtils arrays","animation-array",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,"return ux_u8(256);");
}
