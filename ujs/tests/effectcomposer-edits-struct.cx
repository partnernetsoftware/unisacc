#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"effectcomposer","effectcomposer-edits",0};
    const char *setup="let c=0;let passes=128;let plan=192;let steps=256;"
        "let init=EffectComposer_init(c,13,7,passes,4,40,20);"
        "let a=EffectComposer_addPass(c,10,1);let b=EffectComposer_addPass(c,20,1);let d=EffectComposer_addPass(c,30,3);";
    #define INSERT "let inserted=EffectComposer_insertPass(c,0-1,40,5);"
    #define REMOVE "let removed=EffectComposer_removePass(c,20);"
    #define PLAN "let count=EffectComposer_plan(c,plan,steps,4);"
    const char *cases[]={
        INSERT PLAN "return 0.0+count;",
        INSERT PLAN "return 0.0+ux_u32(steps+2*ComposerStep.size+ComposerStep.id);",
        INSERT REMOVE PLAN "return 0.0+ux_u32(steps+ComposerStep.size+ComposerStep.id);",
        INSERT REMOVE PLAN "return 0.0+ux_u32(steps+2*ComposerStep.size+ComposerStep.id);",
        INSERT REMOVE PLAN "return 0.0+ux_u32(steps+2*ComposerStep.size+ComposerStep.screen);",
        PLAN INSERT "return 0.0+EffectComposer_commit(c,plan);",
        PLAN REMOVE "return 0.0+EffectComposer_commit(c,plan);",
        INSERT "return 0.0+EffectComposer_insertPass(c,0,50,1);",
        "return 0.0+EffectComposer_removePass(c,99);",
    };
    const double gold[]={4,40,40,30,1,-1,-1,-2,0};
    return g_wasm_batch_addon("G_STRUCT EffectComposer pass edits","effectcomposer-edits",argv[1],modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,INSERT REMOVE PLAN "return 0.0+ux_u32(steps+2*ComposerStep.size);");
}
