#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define BUILD "let mesh=ConvexGeometry_boxHull(32,128,9);"
#define AREA(f) BUILD "return box_area(" #f ");"
int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"geometry-buffers","convexgeometry-box",0};
    const char *setup=
        "native function box_area(face:i64) f64 {"
        "let axis=face/2;let u=((axis+1)%3)*4;let v=((axis+2)%3)*4;"
        "let i=0;let sum=0.0;"
        "while(i<2){let a=1024+32*(face*6+i*3);let b=a+32;let c=b+32;"
        "let ab=ux_f32(b+u)-ux_f32(a+u);let ac=ux_f32(c+u)-ux_f32(a+u);"
        "let bb=ux_f32(b+v)-ux_f32(a+v);let bc=ux_f32(c+v)-ux_f32(a+v);"
        "sum=sum+(ab*bc-ac*bb)*ux_f32(a+12+4*axis)*0.5;i=i+1;}return sum;}"
        "let mesh=GeometryBuffers_init(32,1024,36,4000,0);"
        "let i=0;while(i<8){let at=128+i*24;let x=ux_f64_put(at,2.0*(i%2));"
        "let y=ux_f64_put(at+8,4.0*((i/2)%2));let z=ux_f64_put(at+16,6.0*(i/4));i=i+1;}"
        "let x=ux_f64_put(320,1.0);let y=ux_f64_put(328,2.0);let z=ux_f64_put(336,3.0);";
    const char *cases[]={
        BUILD "return 0.0+ux_u32(32+GeometryBuffers.vertexCount);",
        AREA(0), AREA(1), AREA(2), AREA(3), AREA(4), AREA(5),
        "let broken=ux_f64_put(296,1.0);" BUILD "return 0.0+mesh;",
        "let broken=ux_f64_put(296,1.0);let mark=ux_u32_put(1024,77);" BUILD "return 0.0+ux_u32(1024);",
        "let cap=ux_u32_put(32+GeometryBuffers.vertexCapacity,35);" BUILD "return 0.0+mesh;",
    };
    const double gold[]={36,24,24,12,12,8,8,-2,77,-1};
    return g_wasm_batch_addon("G_STRUCT ConvexGeometry box hull","convexgeometry-box",
        argv[1],modules,setup,cases,gold,sizeof gold/sizeof gold[0],mutate?1:-1,
        BUILD "let flipped=ux_f32_put(1036,1.0);return box_area(0);");
}
