#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","camera","perspectivecamera",0};
    const char *setup="let camera=Camera_init(1024,2048);let lens=PerspectiveCamera_init(512,90.0,2.0,1.0,11.0);"
        "let m=ux_u32(camera+Camera.projectionMatrix);";
    const char *cases[]={
        "let p=PerspectiveCamera_updateProjectionMatrix(lens,camera);return ux_f64(m);",
        "let p=PerspectiveCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+40);",
        "let p=PerspectiveCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+80);",
        "let p=PerspectiveCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+112);",
        "return PerspectiveCamera_getFilmWidth(lens);",
        "return PerspectiveCamera_getFilmHeight(lens);",
        "return PerspectiveCamera_getFocalLength(lens);",
        "let v=PerspectiveCamera_setViewOffset(lens,800.0,400.0,0.0,0.0,400.0,200.0);let p=PerspectiveCamera_updateProjectionMatrix(lens,camera);return ux_f64(m);",
        "let v=PerspectiveCamera_setViewOffset(lens,800.0,400.0,0.0,0.0,400.0,200.0);let p=PerspectiveCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+40);",
        "let v=PerspectiveCamera_setViewOffset(lens,800.0,400.0,0.0,0.0,400.0,200.0);let p=PerspectiveCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+64);",
        "let v=PerspectiveCamera_setViewOffset(lens,800.0,400.0,0.0,0.0,400.0,200.0);let p=PerspectiveCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+72);",
        "let v=ux_f64_put(lens+PerspectiveCamera.filmOffset,3.5);let p=PerspectiveCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+64);",
        "let v=ux_u32_put(camera+Camera.coordinateSystem,2001);let p=PerspectiveCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+80);",
        "let v=ux_u32_put(camera+Camera.coordinateSystem,2001);let p=PerspectiveCamera_updateProjectionMatrix(lens,camera);return ux_f64(p+88);"
    };
    const double gold[]={0.5,1,-1.2,-2.2,35,17.5,8.75,1,2,-1,1,0.05,-1.1,-10.0/11.0};
    return g_math_run("G_STRUCT PerspectiveCamera","perspectivecamera",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?2:-1,"let p=PerspectiveCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+112);");
}
