#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d","scene",0};
    const char *setup="let arena=Object3D_initArena(0,3);let s=Scene_create(arena);let o=Object3D_create(arena);"
        "let sa=Object3D_address(arena,s);let oa=Object3D_address(arena,o);"
        "let d=(ux_u32(sa+Scene.background)==0)+(ux_u32(sa+Scene.environment)==0)"
        "+(ux_u32(sa+Scene.fog)==0)+(ux_u32(sa+Scene.overrideMaterial)==0);"
        "let r=Scene_setResources(arena,s,11,22,33,44);"
        "let sp=ux_f64_put(ux_u32(sa+Object3D.position),4.0);let op=ux_f64_put(ux_u32(oa+Object3D.position),3.0);"
        "let added=Scene_add(arena,s,o);let updated=Scene_updateMatrixWorld(arena,s,0);";
    const char *cases[]={
        "return Scene_isScene(arena,s);","return Scene_isScene(arena,o);","return d;",
        "return ux_u32(sa+Scene.background)==11;","return ux_u32(sa+Scene.environment)==22;",
        "return ux_u32(sa+Scene.fog)==33;","return ux_u32(sa+Scene.overrideMaterial)==44;",
        "return ux_f64(ux_u32(oa+Object3D.worldMatrix)+96);","return Scene_traverse(arena,s,1400,4);",
        "let removed=Scene_remove(arena,s,o);return ux_u32(sa+Object3D.firstChild);"
    };
    const double gold[]={1,0,4,1,1,1,1,7,2,0};
    return g_math_run("G_STRUCT Scene","scene",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?7:-1,"return ux_f64(ux_u32(oa+Object3D.localMatrix)+96);");
}
