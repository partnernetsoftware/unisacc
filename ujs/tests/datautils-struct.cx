#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"datautils",0};
    const char *cases[]={
        "return DataUtils_toHalfFloat(1.5,0);","return DataUtils_toHalfFloat((0.0-1.0)*0.0,0);",
        "return DataUtils_toHalfFloat(1.0/16777216.0,0);","return DataUtils_toHalfFloat(1.0/33554432.0,0);",
        "return DataUtils_toHalfFloat(1.0008,0);","return DataUtils_toHalfFloat(99999.0,0);",
        "return DataUtils_toHalfFloat(0.0-99999.0,0);","return DataUtils_fromHalfFloat(15361);",
        "return DataUtils_fromHalfFloat(1);","return 1.0/DataUtils_fromHalfFloat(32768)<0.0;",
        "return DataUtils_fromHalfFloat(31744)==1.0/0.0;",
        "let x=DataUtils_fromHalfFloat(32256);return x!=x;"
    };
    const double gold[]={15872,32768,1,0,15360,31743,64511,1+1.0/1024,1.0/16777216,1,1,1};
    return g_math_run("G_STRUCT DataUtils","datautils",modules,"",cases,gold,sizeof gold/sizeof gold[0],
        mutate?4:-1,"return DataUtils_toHalfFloat(1.001,0);");
}
