#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","audioloader","audio-buffer-playback",0};
    const char *setup="let resource=0;let pcm=128;let state=256;let out=512;"
        "let a=ux_u32_put(resource+AudioResource.pcm,pcm);let b=ux_u32_put(resource+AudioResource.frames,4);"
        "let c=ux_u32_put(resource+AudioResource.channels,2);let d=ux_u32_put(resource+AudioResource.sampleRate,48000);"
        "let e=ux_f32_put(pcm,0.25);let f=ux_f32_put(pcm+8,0.5);"
        "let g=ux_f32_put(pcm+16,0.75);let h=ux_f32_put(pcm+24,1.0);"
        "let j=ux_f32_put(pcm+4,0.0-0.25);let k=ux_f32_put(pcm+12,0.0-0.5);"
        "let l=ux_f32_put(pcm+20,0.0-0.75);let m=ux_f32_put(pcm+28,0.0-1.0);"
        "let ready=Audio_setBuffer(state,resource);";
    #define PLAY "let live=Audio_playBuffer(state,0,0,0,4,0.5);"
    #define LOOP "let live=Audio_playBuffer(state,0,1,1,3,0.5);"
    #define RENDER "let count=Audio_renderBuffer(state,out,6);"
    const char *cases[]={
        PLAY RENDER "return ux_f32(out);",
        PLAY RENDER "return ux_f32(out+12);",
        PLAY RENDER "return ux_f32(out+24);",
        PLAY RENDER "return ux_f32(out+32);",
        PLAY RENDER "return 0.0+ux_u32(state+AudioBufferPlayback.playing);",
        LOOP RENDER "return ux_f32(out+24);",
        LOOP RENDER "return ux_f32(out+32);",
        LOOP "let first=Audio_renderBuffer(state,out,3);let rest=Audio_renderBuffer(state,out,3);return ux_f32(out);",
        PLAY "let stop=Audio_stopBuffer(state);" RENDER "return ux_f32(out);",
        PLAY "return 0.0+Audio_renderBuffer(state,pcm,2);",
        "return 0.0+Audio_playBuffer(state,0,1,3,3,1.0);",
    };
    const double gold[]={0.125,-0.25,0.5,0,0,0.25,0.375,0.25,0,-1,-1};
    return g_wasm_batch_page("G_IO Audio buffer play loop","audio-buffer-playback",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?5:-1,PLAY RENDER "return ux_f32(out+24);");
}
