#pragma unisa use g_math
#pragma unisa use text.text

static double packed(int r,int g,int b,int a) {
    return r+256.0*g+65536.0*b+16777216.0*a;
}

int main(int argc,char **argv) {
    int format_mutation=argc==2 && tx_eqz(argv[1],"--mutate-format");
    int uv_mutation=argc==2 && tx_eqz(argv[1],"--mutate");
    int red_mutation=argc==2 && tx_eqz(argv[1],"--mutate-red");
    int rg_mutation=argc==2 && tx_eqz(argv[1],"--mutate-rg");
    if(argc!=1 && !format_mutation && !uv_mutation && !red_mutation && !rg_mutation) return 2;
    const char *modules[]={"gpu-texture-sample","gpu-texture-uv","gpu-texture-format-generated",0};
    const char *setup="let i=0;let bytes=[12,34,56,78,89,67,45,23];"
        "while(i<8){let b=ux_u8_put(200+i,bytes[i]);i=i+1;}"
        "let a=ux_f64_put(320,1.0);let b=ux_f64_put(352,1.0);"
        "let c=ux_f64_put(368,0.5);let d=ux_f64_put(384,1.0);";
    const char *cases[]={
        "return GpuTexture_readFormat(1023,200,2,1,0.25,0.0);",
        "let out=GpuTexture_mapUv(300,128,320,0.25,0.0);"
        "return GpuTexture_readFormat(1023,200,2,1,ux_f64(out),ux_f64(out+8));",
        "let out=GpuTexture_mapUv(301,128,320,0.25,0.0);"
        "return GpuTexture_readFormat(1023,200,2,1,ux_f64(out),ux_f64(out+8));",
        "return GpuTexture_readFormat(1026,200,2,1,0.25,0.0);",
        "return GpuTexture_readFormat(1028,200,2,1,0.75,0.0);",
        "return GpuTexture_readFormat(1030,200,2,1,0.75,0.0);"
    };
    const double gold[]={packed(12,34,56,78),packed(89,67,45,23),packed(12,34,56,78),-2,packed(34,0,0,255),packed(56,78,0,255)};
    return g_math_run("G_STRUCT GPU texture constants","gpu-texture-format",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],format_mutation?0:uv_mutation?1:red_mutation?4:rg_mutation?5:-1,
        red_mutation?cases[5]:rg_mutation?cases[4]:format_mutation?
        "return GpuTexture_readFormat(1023,200,2,1,0.75,0.0);":cases[2]);
}
