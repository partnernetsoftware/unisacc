#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","geometry-buffers","polyhedrongeometry","octahedrongeometry",
        "lighthelper-common","hemispherelighthelper",0};
    const char *setup="let helper=0;let mesh=128;let vertices=256;let colors=1024;let work=1344;"
        "let light=1728;let rgb=1856;let over=1920;"
        "let a=ux_f64_put(light+96,3.0);let b=ux_f64_put(light+112,4.0);"
        "let c=ux_f64_put(rgb,0.25);let d=ux_f64_put(rgb+24,0.75);let e=ux_f64_put(over+8,0.125);"
        "let buffers=GeometryBuffers_init(mesh,vertices,24,0,0);"
        "let init=HemisphereLightHelper_init(helper,mesh,colors,work,light,2.0,rgb,0-1);";
    const char *cases[]={
        "return 0.0+ux_u32(mesh+GeometryBuffers.vertexCount);",
        "return ux_f32(vertices+4);",
        "return ux_f32(vertices+32);",
        "return ux_f32(vertices+72);",
        "return ux_f32(colors+132);",
        "return ux_f32(colors+144);",
        "return ux_f64(helper+HemisphereLightHelper.lookX);",
        "return ux_f64(helper+HemisphereLightHelper.lookZ);",
        "return 0.0+ux_u32(helper+HemisphereLightHelper.vertexColors);",
        "return 0.0+ux_u32(helper+HemisphereLightHelper.colorVersion);",
        "let c=ux_f64_put(rgb+24,0.5);let up=HemisphereLightHelper_update(helper,rgb,0-1);return ux_f32(colors+144);",
        "let up=HemisphereLightHelper_update(helper,rgb,0-1);return 0.0+ux_u32(helper+HemisphereLightHelper.colorVersion);",
        "let up=HemisphereLightHelper_update(helper,rgb,over);return ux_f64(helper+HemisphereLightHelper.green);",
        "let up=HemisphereLightHelper_update(helper,rgb,over);return 0.0+ux_u32(helper+HemisphereLightHelper.colorVersion);",
        "let b=HemisphereLightHelper_init(helper,mesh,colors,work,light,2.0,rgb,over);return 0.0+ux_u32(helper+HemisphereLightHelper.vertexColors);",
        "let b=HemisphereLightHelper_init(helper,mesh,colors,work,light,2.0,rgb,over);return ux_f32(colors+144);",
        "let b=HemisphereLightHelper_dispose(helper);return 0.0+ux_u32(helper+HemisphereLightHelper.active);",
        "let b=HemisphereLightHelper_dispose(helper);return 0.0+HemisphereLightHelper_update(helper,rgb,over);",
        "return 0.0+HemisphereLightHelper_init(helper,mesh,vertices,work,light,2.0,rgb,0-1);",
    };
    const double gold[]={24,2,2,-2,0.25,0.75,-0.6,-0.8,1,1,0.5,2,0.125,1,0,0,0,-1,-1};
    return g_wasm_batch("G_STRUCT HemisphereLightHelper","hemispherelighthelper",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?5:-1,"return ux_f32(colors+132);");
}
