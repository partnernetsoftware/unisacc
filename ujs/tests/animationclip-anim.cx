#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","animation-view","keyframe-track","animationclip",0};
    const char *setup=
        "let a=ux_f32_put(104,2.0);let b=ux_f32_put(120,4.0);let name=ux_u8_put(80,120);"
        "let va=AnimationSamples_init(0,100,160,2,1);let vb=AnimationSamples_init(16,116,176,2,1);"
        "let ta=KeyframeTrack_init(32,80,1,va);let tb=KeyframeTrack_init(48,80,1,vb);"
        "let x=ux_u32_put(200,ta);let y=ux_u32_put(204,tb);";
    const char *cases[]={
        "let clip=AnimationClip_init(256,80,1,200,2,-1.0,2500);return ux_f64(clip+AnimationClip.duration);",
        "let clip=AnimationClip_init(256,80,1,200,2,1.5,2500);return ux_f64(clip+AnimationClip.duration);",
        "let clip=AnimationClip_init(256,80,1,200,2,1.5,2500);let reset=AnimationClip_resetDuration(clip);"
        "return ux_f64(reset+AnimationClip.duration);",
        "let clip=AnimationClip_init(256,80,1,200,0,-1.0,2501);return ux_f64(clip+AnimationClip.duration);",
        "let clip=AnimationClip_init(256,80,1,200,2,-1.0,2501);return ux_u32(clip+AnimationClip.blendMode);",
        "return AnimationClip_init(96,80,1,200,2,-1.0,2500);",
        "return AnimationClip_init(256,80,1,200,2,-1.0,999);"
    };
    const double gold[]={4,1.5,4,0,2501,-1,-1};
    return g_math_run("G_ANIM AnimationClip","animationclip",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let clip=AnimationClip_init(256,80,1,200,1,-1.0,2500);return ux_f64(clip+AnimationClip.duration);");
}
