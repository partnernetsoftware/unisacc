#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"vector-scalar","vector3","box3","sphere",0};
    const char *setup="let o=Vector3_set(0,0.0,0.0,0.0);let p=Vector3_set(24,4.0,0.0,0.0);"
        "let a=Sphere_set(48,o,2.0);let b=Sphere_set(80,p,1.0);";
    const char *cases[]={
        "let r=Sphere_set(112,p,1.0);return ux_f64(r);",
        "let r=Sphere_setFromPoints(112,o,2,0-1,144);return ux_f64(r+24);",
        "let r=Sphere_setFromPoints(112,o,2,o,144);return ux_f64(r+24);",
        "let r=Sphere_copy(112,a);return ux_f64(r+24);",
        "let r=Sphere_clone(112,a);return ux_f64(r+24);",
        "let r=Sphere_makeEmpty(a);return Sphere_isEmpty(r);",
        "let q=Vector3_set(112,2.0,0.0,0.0);return Sphere_containsPoint(a,q);",
        "return Sphere_distanceToPoint(a,p);","return Sphere_intersectsSphere(a,b);",
        "let l=Vector3_set(112,2.0,0.0-1.0,0.0-1.0);let h=Vector3_set(136,3.0,1.0,1.0);"
        "let r=Box3_set(160,l,h);return Sphere_intersectsBox(a,r);",
        "let q=Vector3_set(112,1.0,0.0,0.0);let k=ux_f64_put(q+24,0.0-2.0);return Sphere_intersectsPlane(a,q);",
        "let r=Sphere_clampPoint(112,a,p);return ux_f64(r);",
        "let r=Sphere_getBoundingBox(112,a);return ux_f64(r+8);",
        "let x=ux_f64_put(160,1.0);let y=ux_f64_put(200,2.0);let z=ux_f64_put(240,3.0);let w=ux_f64_put(280,1.0);"
        "let r=Sphere_applyMatrix4(a,160);return ux_f64(r+24);",
        "let r=Sphere_translate(a,p);return ux_f64(r);",
        "let r=Sphere_expandByPoint(a,p);return ux_f64(r+24);",
        "let r=Sphere_union(a,b);return ux_f64(r+24);",
        "let r=Sphere_clone(112,a);return Sphere_equals(a,r);",
        "let q=Sphere_set(112,o,5.0);let r=Sphere_union(a,q);return ux_f64(r+24);"
    };
    const double gold[]={4,2,4,2,2,1,1,2,0,1,1,2,-2,6,4,3,3.5,1,5};
    return g_math_run("G_MATH Sphere","sphere",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?11:-1,"let r=Sphere_clampPoint(112,a,o);return ux_f64(r);");
}
