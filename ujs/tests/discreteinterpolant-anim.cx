#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","animation-view","discreteinterpolant",0};
    const char *setup=
        "let a=ux_f32_put(64,0.0);let b=ux_f32_put(68,1.0);let c=ux_f32_put(72,1.0);"
        "let d=ux_f32_put(76,3.0);let x=ux_f32_put(128,2.0);let y=ux_f32_put(132,4.0);"
        "let z=ux_f32_put(136,6.0);let w=ux_f32_put(140,8.0);let k=ux_f32_put(144,10.0);"
        "let l=ux_f32_put(148,12.0);let m=ux_f32_put(152,14.0);let n=ux_f32_put(156,16.0);"
        "let view=AnimationSamples_init(0,64,128,4,2);";
    const char *cases[]={
        "let p=DiscreteInterpolant_evaluate(view,-1.0,192);return ux_f32(p);",
        "let p=DiscreteInterpolant_evaluate(view,0.5,192);return ux_f32(p+4);",
        "let p=DiscreteInterpolant_evaluate(view,1.0,192);return ux_f32(p);",
        "let p=DiscreteInterpolant_evaluate(view,4.0,192);return ux_f32(p+4);",
        "let p=DiscreteInterpolant_evaluate(view,4.0,192);let q=DiscreteInterpolant_evaluate(view,0.5,192);return ux_f32(q);",
        "return DiscreteInterpolant_evaluate(view,1.0,132);",
        "let r=ux_f32_put(72,-1.0);return AnimationSamples_init(0,64,128,4,2);"
    };
    const double gold[]={2,4,10,16,2,-1,-2};
    return g_math_run("G_ANIM DiscreteInterpolant","discreteinterpolant",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let p=DiscreteInterpolant_evaluate(view,0.999,192);return ux_f32(p);");
}
