#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","gpu-packet","loadingmanager","fileloader","image-layout","textureloader",0};
    const char *setup="let image=64;let p=ux_u32_put(image+ImageResource.rgba,256);"
        "let w=ux_u32_put(image+ImageResource.width,1);let h=ux_u32_put(image+ImageResource.height,1);"
        "let stride=ux_u32_put(image+ImageResource.rowBytes,4);";
    const char *cases[]={
        "let t=TextureLoader_fromImage(image,400);return ux_u32(t+GpuTextureSource.width);",
        "let t=TextureLoader_fromImage(image,400);return ux_u32(t+GpuTextureSource.filter);",
        "let t=TextureLoader_fromImage(image,400);return ux_u32(t+GpuTextureSource.wrapS);",
        "let t=TextureLoader_fromImage(image,400);return ux_u32(t+GpuTextureSource.rgba)==256;",
        "let bad=ux_u32_put(image+ImageResource.rowBytes,8);return TextureLoader_fromImage(image,400);",
        "return TextureLoader_fromImage(image,256);"
    };
    const double gold[]={1,2,0,1,-1,-1};
    return g_math_run("G_IO TextureLoader","textureloader",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let t=TextureLoader_fromImage(image,400);let wrong=ux_u32_put(t+GpuTextureSource.filter,0);return ux_u32(t+GpuTextureSource.filter);");
}
