#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"bufferconstants",0};
    const char *cases[]={
        "return StaticDrawUsage();","return StaticReadUsage();","return StaticCopyUsage();",
        "return DynamicDrawUsage();","return DynamicReadUsage();","return DynamicCopyUsage();",
        "return StreamDrawUsage();","return StreamReadUsage();","return StreamCopyUsage();",
        "return UnsignedByteType();","return ByteType();","return ShortType();","return UnsignedShortType();",
        "return IntType();","return UnsignedIntType();","return FloatType();","return HalfFloatType();",
        "return UnsignedShort4444Type();","return UnsignedShort5551Type();","return UnsignedInt248Type();"
    };
    const double gold[]={35044,35045,35046,35048,35049,35050,35040,35041,35042,
        1009,1010,1011,1012,1013,1014,1015,1016,1017,1018,1020};
    return g_math_run("G_STRUCT BufferConstants","bufferconstants",modules,"",cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,"return DynamicDrawUsage();");
}
