#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"curve-line","linecurve",0};
    const char *setup="let a=ux_f64_put(0,1.0);let b=ux_f64_put(8,2.0);let c=ux_f64_put(16,4.0);let d=ux_f64_put(24,6.0);"
        "let point=LineCurve_getPoint(128,0,0.25);let end=LineCurve_getPointAt(160,0,1.0);"
        "let tangent=LineCurve_getTangent(192,0);";
    const char *cases[]={"return ux_f64(point);","return ux_f64(point+8);","return ux_f64(end);",
        "return LineCurve_getLength(0);","return ux_f64(tangent);","return ux_f64(tangent+8);"};
    const double gold[]={1.75,3,4,5,0.6,0.8};
    return g_math_run("G_STRUCT LineCurve","linecurve",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,"return ux_f64(end);");
}
