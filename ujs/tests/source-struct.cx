#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","source",0};
    const char *setup="let s=Source_init(0,7);";
    const char *cases[]={
        "return ux_u32(s+Source.data);","return ux_u32(s+Source.version);",
        "let t=Source_needsUpdate(s,0);return ux_u32(t+Source.version);",
        "let a=Source_needsUpdate(s,1);let t=Source_needsUpdate(a,1);return ux_u32(t+Source.version);",
        "let t=Source_setData(s,17,0);return ux_u32(t+Source.data);"
    };
    const double gold[]={7,0,0,2,17};
    return g_math_run("G_STRUCT Source","source",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?3:-1,"let a=Source_needsUpdate(s,1);let t=Source_needsUpdate(a,0);return ux_u32(t+Source.version);");
}
