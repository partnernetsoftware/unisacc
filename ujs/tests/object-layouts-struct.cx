#pragma unisa use g_math
#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *probes[]={
        "return EventDispatcher.size;",
        "return Object3D.generation;",
        "return Object3D.worldMatrix;",
        "return Object3D.size;",
        "return Group.size;",
        "return Scene.background;",
        "return Scene.size;",
        "return Clock.elapsedTime;",
        "return Clock.size;",
        "return InstancedBufferGeometry.instanceCount;",
        "return InstancedBufferGeometry.size;"
    };
    const double expected[]={12,12,52,68,68,68,84,16,32,40,44};
    int count=sizeof expected/sizeof expected[0];
    unsigned char *library=0;
    int64_t bytes=0;
    char dir[256],source[300],wasm[300];
    if(sy_read_file("ujs/practice/uxe/base/object-layouts.ujs",&library,&bytes,20000)) return 2;
    if(sy_mkdtemp("/tmp","ujs-layout-",dir,sizeof dir)) { mm_free(library); return 2; }
    tx_snprintf(source,sizeof source,"%s/layout.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/layout.wasm",dir);
    int failed=0;
    for(int i=0;i<count;i++) {
        double actual=0;
        if(g_math_sample(source,wasm,(char *)library,"",probes[mutate && i==2?1:i],&actual) ||
            actual!=expected[i]) {
            printf("LAYOUT case=%d actual=%.17g gold=%.17g\n",i,actual,expected[i]);
            failed++;
        }
    }
    mm_free(library);
    char *clean[]={"rm","-rf","--",dir,0};
    char *out=0;
    size_t out_n=0;
    int rc=cx_runv_timeout(clean,5,&out,&out_n);
    mm_free(out);
    printf("G_STRUCT object layouts cases=%d failed=%d\n",count,failed);
    return rc?2:failed!=0;
}
