#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define CALL(bytes) "let count=TextGeometry_layout(32,6,128,4,512," bytes ",0.01,1200.0);"
#define READ(row,field) CALL("4") "return ux_f64(512+" #row "*TextGlyphPlacement.size+TextGlyphPlacement." #field ");"
#define CODE(row) CALL("4") "return 0.0+ux_u32(512+" #row "*TextGlyphPlacement.size+TextGlyphPlacement.code);"
int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"textgeometry-layout",0};
    const char *setup=
        "let a=ux_u32_put(32,65);let s=ux_u32_put(36,32);let b=ux_u32_put(40,66);"
        "let lf=ux_u32_put(44,10);let omega=ux_u32_put(48,937);let end=ux_u32_put(52,65);"
        "let s0=ux_u32_put(128,32);let s1=ux_f64_put(136,300.0);"
        "let f0=ux_u32_put(144,63);let f1=ux_u32_put(148,1);let f2=ux_f64_put(152,500.0);"
        "let a0=ux_u32_put(160,65);let a1=ux_u32_put(164,2);let a2=ux_f64_put(168,700.0);"
        "let b0=ux_u32_put(176,66);let b1=ux_u32_put(180,3);let b2=ux_f64_put(184,900.0);";
    const char *cases[]={
        CALL("4") "return 0.0+count;",
        READ(0,x), READ(0,y), CODE(0), READ(1,x), READ(1,y), CODE(1),
        READ(2,x), READ(2,y), CODE(2), READ(3,x), READ(3,y), CODE(3),
        CALL("3") "return 0.0+count;",
        "let marker=ux_u32_put(512,77);" CALL("3") "return 0.0+ux_u32(512);",
        "let surrogate=ux_u32_put(48,55296);" CALL("4") "return 0.0+count;",
    };
    const double gold[]={4,0,0,65,10,0,66,0,-12,63,5,-12,65,-3,77,-2};
    return g_wasm_batch_addon("G_STRUCT TextGeometry glyph placement","textgeometry-layout",
        argv[1],modules,setup,cases,gold,sizeof gold/sizeof gold[0],mutate?8:-1,
        "let swapped=ux_u32_put(44,32);" READ(2,y));
}
