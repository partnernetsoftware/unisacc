#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","datautils","bufferattribute","interleavedbuffer","interleavedbufferattribute",0};
    const char *setup="let b=InterleavedBuffer_init(0,128,2,12,9);let a=InterleavedBufferAttribute_init(32,b,2,1,0);"
        "let b0=ux_f32_put(140,4.0);let b1=ux_f32_put(144,5.0);let b2=ux_f32_put(148,6.0);";
    const char *cases[]={
        "return ux_u32(a+BufferAttribute.count);","return ux_u32(a+InterleavedBufferAttribute.offset);",
        "return BufferAttribute_getX(a,1);","return BufferAttribute_getY(a,1);",
        "let r=BufferAttribute_setXY(a,1.0,7.0,8.0,240.0);return BufferAttribute_getX(r,1);",
        "let r=BufferAttribute_setXY(a,1.0,7.0,8.0,240.0);return BufferAttribute_getY(r,1);",
        "let q=InterleavedBufferAttribute_needsUpdate(a,1);return ux_u32(b+InterleavedBuffer.version);",
        "let r=BufferAttribute_setXY(a,1.0,7.0,8.0,240.0);return ux_f32(140);"
    };
    const double gold[]={2,1,5,6,7,8,1,4};
    return g_math_run("G_STRUCT InterleavedBufferAttribute","interleavedbufferattribute",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,"let q=InterleavedBufferAttribute_init(32,b,2,0,0);return BufferAttribute_getX(q,1);");
}
