#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","cache",0};
    const char *setup="let c=Cache_init(0,32,4);let initial=ux_u32(c+Cache.enabled);"
        "let trial=Cache_add(c,1,17);let ignored=Cache_get(c,1);"
        "let e=Cache_setEnabled(c,1);let put=Cache_add(c,1,17);let first=Cache_get(c,1);"
        "let upd=Cache_add(c,1,23);let b=Cache_add(c,2,0);let revised=Cache_get(c,1);"
        "let stored=Cache_get(c,2);let z=Cache_setEnabled(c,0);let denied=Cache_get(c,1);"
        "let gone=Cache_remove(c,1);let yes=Cache_setEnabled(c,1);";
    const char *cases[]={"return initial;","return ignored;","return first;","return revised;","return stored;",
        "return denied;","return Cache_get(c,1);","return Cache_get(c,2);",
        "let empty=Cache_clear(c);return Cache_get(empty,2);"};
    const double gold[]={0,-1,17,23,0,-1,-1,0,-1};
    return g_math_run("G_STRUCT Cache","cache",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?3:-1,"return first;");
}
