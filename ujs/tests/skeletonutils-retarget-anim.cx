#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d",
        "skeleton-layout","skeleton","skeletonutils-retarget",0};
    char setup[3600];
    int n=tx_snprintf(setup,sizeof setup,
        "let arena=Object3D_initArena(0,4);"
        "let sourceHip=Object3D_create(arena);let sourceChild=Object3D_create(arena);"
        "let targetHip=Object3D_create(arena);let targetChild=Object3D_create(arena);"
        "let attached1=Object3D_add(arena,sourceHip,sourceChild);"
        "let attached2=Object3D_add(arena,targetHip,targetChild);"
        "let a=Object3D_address(arena,sourceHip);let b=Object3D_address(arena,sourceChild);"
        "let c=Object3D_address(arena,targetHip);let d=Object3D_address(arena,targetChild);"
        "let ap=ux_u32(a+Object3D.position);let bp=ux_u32(b+Object3D.position);"
        "let cp=ux_u32(c+Object3D.position);let dp=ux_u32(d+Object3D.position);"
        "let aq=ux_u32(a+Object3D.quaternion);let bq=ux_u32(b+Object3D.quaternion);"
        "let cq=ux_u32(c+Object3D.quaternion);let dq=ux_u32(d+Object3D.quaternion);"
        "let ds=ux_u32(d+Object3D.scale);let as=ux_u32(a+Object3D.scale);"
        "let p1=ux_f64_put(ap,4.0);let p2=ux_f64_put(ap+8,5.0);let p3=ux_f64_put(ap+16,6.0);"
        "let p4=ux_f64_put(bp,3.0);let p5=ux_f64_put(cp,9.0);let p6=ux_f64_put(cp+8,8.0);"
        "let p7=ux_f64_put(cp+16,7.0);let p8=ux_f64_put(dp,2.0);"
        "let q1=ux_f64_put(aq+16,0.7071067811865476);let q2=ux_f64_put(aq+24,0.7071067811865476);"
        "let q3=ux_f64_put(bq+16,0.0-0.7071067811865476);let q4=ux_f64_put(bq+24,0.7071067811865476);"
        "let s1=ux_f64_put(as,2.0);let s2=ux_f64_put(as+8,2.0);let s3=ux_f64_put(as+16,2.0);"
        "let src=Skeleton_init(2000,2040,2080,2340,2);let dst=Skeleton_init(2496,2520,2560,2820,2);"
        "let b1=ux_u32_put(2040,sourceHip);let b2=ux_u32_put(2044,sourceChild);"
        "let b3=ux_u32_put(2520,targetHip);let b4=ux_u32_put(2524,targetChild);"
        "let keepPosition=(selected_case>=10 && selected_case<20) || (%d && selected_case==3);"
        "let keepHip=selected_case>=20;"
        "let result=SkeletonUtils_retarget(dst,arena,src,arena,2960,keepPosition,keepHip);"
        "if(result!=dst){return 0.0-99.0;}",mutate);
    if(n<0 || n>=(int)sizeof setup) return 2;
    const char *fields[]={
        "return ux_f64(cp);","return ux_f64(cp+8);","return ux_f64(cp+16);",
        "return ux_f64(dp);","return ux_f64(dp+8);","return ux_f64(dp+16);",
        "return ux_f64(cq+16);","return ux_f64(dq+16);","return ux_f64(ds);","return ux_f64(bp);",
    };
    const char *cases[30];
    for(int i=0;i<30;i++) cases[i]=fields[i%10];

    // Rz(90) rotates the scaled child offset (6,0,0) to (0,6,0).
    // Keeping only the hip height makes the child offset Rz(-90)*(4,3,6).
    const double h=0.7071067811865476;
    const double gold[]={4,5,6, 6,0,0, h,-h,1,3,
                         4,5,6, 2,0,0, h,-h,1,3,
                         0,8,0, 3,-4,6, h,-h,1,3};
    return g_wasm_batch_addon("G_ANIM SkeletonUtils retarget","skeletonutils-retarget-pose",
        argv[1],modules,setup,cases,gold,30,-1,0);
}
