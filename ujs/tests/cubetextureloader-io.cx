#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","gpu-packet","loadingmanager","fileloader","image-layout","cubetextureloader",0};
    const char *setup="let i=0;while(i<6){let image=128+i*ImageResource.size;let data=256+i*4;"
        "let a=ux_u32_put(image+ImageResource.rgba,data);let b=ux_u32_put(image+ImageResource.width,1);"
        "let c=ux_u32_put(image+ImageResource.height,1);let d=ux_u32_put(image+ImageResource.rowBytes,4);"
        "let e=ux_u32_put(64+i*4,image);let f=ux_u8_put(data,40+i);let g=ux_u8_put(data+3,255);i=i+1;}";
    const char *cases[]={
        "let t=CubeTextureLoader_pack(64,512,24,600);return ux_u32(t+GpuTextureSource.width);",
        "let t=CubeTextureLoader_pack(64,512,24,600);return ux_u8(ux_u32(t+GpuTextureSource.rgba));",
        "let t=CubeTextureLoader_pack(64,512,24,600);return ux_u8(ux_u32(t+GpuTextureSource.rgba)+20);",
        "let bad=ux_u32_put(128+5*ImageResource.size+ImageResource.height,2);return CubeTextureLoader_pack(64,512,24,600);",
        "let guard=ux_u8_put(512,97);let bad=ux_u32_put(128+5*ImageResource.size+ImageResource.height,2);"
        "let refused=CubeTextureLoader_pack(64,512,24,600);return ux_u8(512);",
        "return CubeTextureLoader_pack(64,512,23,600);"
    };
    const double gold[]={1,40,45,-2,97,-2};
    return g_math_run("G_IO CubeTextureLoader","cubetextureloader",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let a=ux_u32_put(84,128);let t=CubeTextureLoader_pack(64,512,24,600);return ux_u8(ux_u32(t+GpuTextureSource.rgba)+20);");
}
