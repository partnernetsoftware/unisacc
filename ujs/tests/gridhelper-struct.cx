#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"gridhelper",0};
    const char *setup="let grid=0;let xyz=128;let colors=512;let rgb=96;"
        "let a=ux_f32_put(rgb,0.25);let b=ux_f32_put(rgb+12,0.5);";
    const char *cases[]={
        "let init=GridHelper_init(grid,xyz,colors,16,rgb,8.0,2);return 0.0+ux_u32(grid+GridHelper.count);",
        "let init=GridHelper_init(grid,xyz,colors,16,rgb,8.0,2);return ux_f32(xyz+24);",
        "let init=GridHelper_init(grid,xyz,colors,16,rgb,8.0,2);return ux_f32(xyz+44);",
        "let init=GridHelper_init(grid,xyz,colors,16,rgb,8.0,2);return ux_f32(xyz+56);",
        "let init=GridHelper_init(grid,xyz,colors,16,rgb,8.0,2);return ux_f32(colors+48);",
        "let init=GridHelper_init(grid,xyz,colors,16,rgb,8.0,3);return ux_f32(colors+96);",
        "let init=GridHelper_init(grid,xyz,colors,16,rgb,8.0,2);let gone=GridHelper_dispose(grid);return 0.0+ux_u32(grid+GridHelper.active);",
        "return 0.0+GridHelper_init(grid,xyz,colors,11,rgb,8.0,2);",
        "return 0.0+GridHelper_init(grid,xyz,xyz,16,rgb,8.0,2);",
    };
    const double gold[]={12,-4,4,0,0.25,0.5,0,-1,-1};
    return g_wasm_batch("G_STRUCT GridHelper","gridhelper",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?4:-1,
        "let init=GridHelper_init(grid,xyz,colors,16,rgb,8.0,2);return ux_f32(colors);");
}
