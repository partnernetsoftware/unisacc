#pragma unisa use g_geometry
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","geometry-buffers","circlegeometry",0};
    char source[512];
    tx_snprintf(source,sizeof source,"let mesh=GeometryBuffers_init(0,256,6,1024,12);"
        "return CircleGeometry_generate(mesh,%d.0,4,0.0,6.283185307179586);",mutate?3:2);
    const double gold[]={
        6,12,
        0,0,0, 0,0,1, .5,.5, 2,0,0, 0,0,1, 1,.5, 0,2,0, 0,0,1, .5,1,
        -2,0,0, 0,0,1, 0,.5, 0,-2,0, 0,0,1, .5,0, 2,0,0, 0,0,1, 1,.5,
        1,2,0, 2,3,0, 3,4,0, 4,5,0
    };
    return g_geometry_check("CircleGeometry","circlegeometry",modules,source,gold,
        sizeof gold/sizeof gold[0],50);
}
