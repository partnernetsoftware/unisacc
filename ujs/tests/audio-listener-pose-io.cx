#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","loadingmanager","fileloader","audioloader",
        "audio-buffer-playback","audio-listener-pose",0};
    const char *setup="let matrix=0;let up=192;let out=256;let work=384;"
        "let a=ux_f64_put(matrix+16,0.0-2.0);let b=ux_f64_put(matrix+40,3.0);"
        "let c=ux_f64_put(matrix+64,4.0);let d=ux_f64_put(matrix+120,1.0);"
        "let x=ux_f64_put(matrix+96,3.0);let y=ux_f64_put(matrix+104,5.0);let z=ux_f64_put(matrix+112,7.0);"
        "let vert=ux_f64_put(up+16,1.0);";
    #define LOAD "let status=AudioListener_worldPose(matrix,up,out,work);"
    const char *cases[]={
        LOAD "return ux_f64(out+AudioListenerPose.x);",
        LOAD "return ux_f64(out+AudioListenerPose.y);",
        LOAD "return ux_f64(out+AudioListenerPose.z);",
        LOAD "return ux_f64(out+AudioListenerPose.forwardX);",
        LOAD "return ux_f64(out+AudioListenerPose.forwardY);",
        LOAD "return ux_f64(out+AudioListenerPose.forwardZ);",
        LOAD "return ux_f64(out+AudioListenerPose.upY);",
        LOAD "return ux_f64(out+AudioListenerPose.upZ);",
        "let invalid=ux_f64_put(matrix+64,0.0);let keep=ux_f64_put(out,77.0);"
        LOAD "return 0.0+(status==0-2 && ux_f64(out)==77.0);",
        "return 0.0+AudioListener_worldPose(matrix,up,out,up);",
    };
    const double gold[]={3,5,7,-1,0,0,0,1,1,-1};
    return g_wasm_batch_page("G_IO AudioListener world pose","audio-listener-pose",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,LOAD "return ux_f64(out+AudioListenerPose.forwardZ);");
}
