#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define ALPHA(offset) "let n=CompressedTexture_decodeBC3(32,512,32);return 0.0+ux_u8(515+" #offset ");"

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","compressedtextureloader","compressed-texture-bc1",
        "compressed-texture-bc2","compressed-texture-bc3",0};
    const char *setup="let mip=CompressedTextureLoader_level(32,128,16,4,2,33779);"
        "let a=ux_u32_put(128,3330801874);let b=ux_u32_put(132,4207315194);"
        "let rgb=ux_u32_put(136,4160749599);let idx=ux_u32_put(140,58596);";
    const char *cases[]={
        ALPHA(0),ALPHA(4),ALPHA(8),ALPHA(12),ALPHA(24),ALPHA(28),
        "let changed=ux_u32_put(128,3330855434);" ALPHA(8),
        "let changed=ux_u32_put(128,3330855434);" ALPHA(12),
        "let changed=ux_u32_put(128,3330855434);" ALPHA(24),
        "let changed=ux_u32_put(128,3330855434);" ALPHA(28),
        "let n=CompressedTexture_decodeBC3(32,512,32);return 0.0+ux_u32(524);",
        "return 0.0+CompressedTexture_decodeBC3(32,512,31);",
        "let bad=ux_u32_put(32+CompressedMip.bytes,8);return 0.0+CompressedTexture_decodeBC3(32,512,32);",
    };
    const double gold[]={210,0,180,150,60,30,50,90,0,255,0x965500aau,-1,-3};
    return g_wasm_batch("G_IO CompressedTexture software BC3","compressed-texture-bc3",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let changed=ux_u8_put(131,194);" ALPHA(12));
}
