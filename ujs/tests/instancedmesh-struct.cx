#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"vector-scalar","f64-math","views","vector3","box3",
        "mesh-layout","instancedmesh","instancedmesh-bounds",0};
    const char *setup=
        "let batch=InstancedMesh_init(64,0,128,384,3);"
        "let first=InstancedMesh_getMatrixAt(batch,0,448);"
        "let tr=InstancedMesh_getMatrixAt(batch,0,640);"
        "let dx=ux_f64_put(tr+96,2.5);let dy=ux_f64_put(tr+104,4.0);let dz=ux_f64_put(tr+112,0.0-1.0);"
        "let tr2=InstancedMesh_getMatrixAt(batch,0,768);"
        "let ex=ux_f64_put(tr2+96,0.0-3.0);let ey=ux_f64_put(tr2+104,1.0);let ez=ux_f64_put(tr2+112,2.0);"
        "let i=InstancedMesh_setMatrixAt(batch,1,tr);let j=InstancedMesh_setMatrixAt(batch,2,tr2);"
        "let tint=InstancedMesh_setColorAt(batch,1,0.1,0.5,0.75);"
        "let a=InstancedMesh_getColorAt(batch,0,960);let b=InstancedMesh_getColorAt(batch,1,984);"
        "let lo=Vector3_set(1024,0.0-1.0,0.0-1.0,0.0-1.0);"
        "let hi=Vector3_set(1048,1.0,1.0,1.0);"
        "let box=Box3_set(1088,lo,hi);";
    const char *cases[]={
        "return ux_f64(first);",
        "let m=InstancedMesh_getMatrixAt(batch,1,448);return ux_f64(m+96);",
        "let m=InstancedMesh_getMatrixAt(batch,2,448);return ux_f64(m+112);",
        "return ux_f64(a);","return ux_f64(b);","return ux_f64(b+16);",
        "let r=InstancedMesh_computeBox(batch,box,1152,1280);return ux_f64(r);",
        "let r=InstancedMesh_computeBox(batch,box,1152,1280);return ux_f64(r+32);",
        "let c=InstancedMesh_setCount(batch,2);let r=InstancedMesh_computeBox(c,box,1152,1280);return ux_f64(r);",
        "return InstancedMesh_getMatrixAt(batch,3,448);"
    };
    const double gold[]={1,2.5,2,0,(double)(float)0.1,0.75,-4,5,-1,-1};
    return g_math_run("G_STRUCT InstancedMesh","instancedmesh",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?1:-1,"let m=InstancedMesh_getMatrixAt(batch,2,448);return ux_f64(m+96);");
}
