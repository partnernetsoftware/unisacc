#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"batchedmesh","batchedmesh-matrices",0};
    const char *setup="let b=BatchedMesh_init(0,64,3,32,48);"
        "let near=BatchedMesh_addGeometry(b,99,3,3);let far=BatchedMesh_addGeometry(b,100,4,6);"
        "let a=ux_f64_put(512+96,5.0);let z=ux_f64_put(768+96,11.0);"
        "let s=BatchedMesh_setMatrixAt(b,near,1024,192,512);"
        "let t=BatchedMesh_setMatrixAt(b,far,1024,192,768);";
    const char *cases[]={
        "let r=BatchedMesh_getMatrixAt(b,near,1024,192,1280);return ux_f64(r+96);",
        "let r=BatchedMesh_getMatrixAt(b,far,1024,192,1280);return ux_f64(r+96);",
        "let dead=BatchedMesh_deleteGeometry(b,far);return BatchedMesh_getMatrixAt(dead,far,1024,192,1280);",
        "return BatchedMesh_setMatrixAt(b,far,1024,64,768);",
        "return BatchedMesh_getMatrixAt(b,near,1024,192,1088);"
    };
    const double gold[]={5,11,-1,-1,-1};
    return g_math_run("G_STRUCT BatchedMesh matrices","batchedmesh-matrices",modules,setup,cases,gold,
        5,mutate?0:-1,"let r=BatchedMesh_getMatrixAt(b,far,1024,192,1280);return ux_f64(r+96);");
}
