#pragma unisa use g_geometry
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"geometry-buffers","shapeutils","extrudegeometry",0};
    char source[640];
    tx_snprintf(source,sizeof source,"let mesh=GeometryBuffers_init(0,256,24,1024,0);"
        "let bx=ux_f64_put(2064,2.0);let cy=ux_f64_put(2088,1.0);"
        "return ExtrudeGeometry_generate(mesh,2048,3,%d.0,1,4096);",mutate?3:2);
    const int lids[6][3]={{0,0,0},{0,1,0},{2,0,0},{2,0,2},{0,1,2},{0,0,2}};
    const int corners[3][2]={{0,0},{2,0},{0,1}};
    const int edges[3][2]={{0,1},{1,2},{2,0}};
    const double normals[3][2]={{0,-1},{0.447213595499958,0.894427190999916},{-1,0}};
    const int face[6][2]={{0,0},{1,0},{0,2},{1,0},{1,2},{0,2}};
    double gold[194]={24,0};
    int at=2;
    for(int i=0;i<6;i++) {
        int x=lids[i][0], y=lids[i][1];
        gold[at++]=x; gold[at++]=y; gold[at++]=lids[i][2];
        gold[at++]=0; gold[at++]=0; gold[at++]=i<3?-1:1;
        gold[at++]=x; gold[at++]=y;
    }
    for(int i=0;i<3;i++) for(int j=0;j<6;j++) {
        int corner=edges[i][face[j][0]], z=face[j][1];
        int x=corners[corner][0], y=corners[corner][1];
        gold[at++]=x; gold[at++]=y; gold[at++]=z;
        gold[at++]=normals[i][0]; gold[at++]=normals[i][1]; gold[at++]=0;
        gold[at++]=i==2?y:x; gold[at++]=1-z;
    }
    return g_geometry_check("ExtrudeGeometry","extrudegeometry",modules,source,gold,at,at);
}
