#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","geometry-load-layout","object-json-tokens","json-read",
        "geometry-json-load","buffergeometryloader",0};
    const char json[]="{\"type\":\"BufferGeometry\",\"data\":{\"attributes\":{\"position\":{\"itemSize\":3,"
        "\"array\":[1.25,2,3],\"type\":\"Float32Array\",\"normalized\":false}}}}";
    char setup[3000];
    int n=tx_snprintf(setup,sizeof setup,
        "let manager=LoadingManager_init(0);let file=FileLoader_init(32,manager);let id=FileLoader_begin(file,64);"
        "let geo=128;let options=192;let table=256;let groups=320;let names=384;"
        "let a=ux_u32_put(geo+BufferGeometry.attributes,table);let b=ux_u32_put(geo+BufferGeometry.groups,groups);"
        "let c=ux_u32_put(table+4,1);let d=ux_u32_put(groups+4,1);"
        "let e=ux_u32_put(options+GeometryJsonLoad.arena,1024);let f=ux_u32_put(options+GeometryJsonLoad.arenaEnd,2048);"
        "let g=ux_u32_put(options+GeometryJsonLoad.names,names);let h=ux_u32_put(options+GeometryJsonLoad.nameCount,1);"
        "let j=ux_u32_put(options+GeometryJsonLoad.scratch,4096);"
        "let k=ux_u32_put(names,8);let l=ux_u32_put(names+4,448);let m=ux_u32_put(names+8,8);"
        "let key=[112,111,115,105,116,105,111,110];let i=0;while(i<8){let b=ux_u8_put(448+i,key[i]);i=i+1;}"
        "let input=6000;let size=%d;",(int)sizeof json-1);
    for(int at=0;at<(int)sizeof json-1;at+=64) {
        int count=(int)sizeof json-1-at; if(count>64) count=64;
        n+=tx_snprintf(setup+n,sizeof setup-n,"if(1){let chunk=[");
        for(int i=0;i<count;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[at+i]);
        n+=tx_snprintf(setup+n,sizeof setup-n,"];let at=0;while(at<%d){let x=ux_u8_put(input+%d+at,chunk[at]);at=at+1;}}",count,at);
    }
    const char *cases[]={
        "return BufferGeometryLoader_parse(file,geo,options);",
        "let received=FileLoader_receive(file,id,200,input,size,64);let loaded=BufferGeometryLoader_parse(file,geo,options);"
        "let view=ux_u32(table+12);return ux_f32(ux_u32(view+BufferAttribute.data));",
        "let received=FileLoader_receive(file,id,200,input,size,64);let loaded=BufferGeometryLoader_parse(file,geo,options);return ux_u32(table);",
        "let bad=ux_u8_put(input+size-1,93);let received=FileLoader_receive(file,id,200,input,size,64);"
        "return BufferGeometryLoader_parse(file,geo,options);",
        "let bad=ux_u8_put(input+size-1,93);let received=FileLoader_receive(file,id,200,input,size,64);"
        "let loaded=BufferGeometryLoader_parse(file,geo,options);return ux_u32(table);"
    };
    const double gold[]={-1,1.25,1,-1,0};
    return g_math_run("G_IO BufferGeometryLoader","buffergeometryloader",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let received=FileLoader_receive(file,id,200,input,size,64);let loaded=BufferGeometryLoader_parse(file,geo,options);"
        "let view=ux_u32(table+12);return ux_f32(ux_u32(view+BufferAttribute.data)+4);");
}
