#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"arraycamera",0};
    const char *setup="let a=ux_u32_put(128,19);let b=ux_u32_put(132,31);let c=ArrayCamera_init(64,128,2);";
    const char *cases[]={
        "return ux_u32(c+ArrayCamera.count);",
        "return ArrayCamera_getCamera(c,0);",
        "return ArrayCamera_getCamera(c,1);",
        "return ArrayCamera_getCamera(c,2);",
        "let replaced=ux_u32_put(128,31);return ArrayCamera_getCamera(c,0);",
        "let empty=ArrayCamera_init(256,0,0);return ux_u32(empty+ArrayCamera.count);"
    };
    const double gold[]={2,19,31,-1,31,0};
    return g_math_run("G_STRUCT ArrayCamera","arraycamera",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,"return ArrayCamera_getCamera(c,1);");
}
