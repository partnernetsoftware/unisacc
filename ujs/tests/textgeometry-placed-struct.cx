#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"geometry-buffers","shapeutils","extrudegeometry","textgeometry",
        "textgeometry-layout","textgeometry-placed",0};
    const char *setup=
        "native function place_bound(verts:i64,axis:i64,maximum:i64) f64 {"
        "let x=ux_f32(verts+axis*4);let j=1;while(j<72){let v=ux_f32(verts+j*32+axis*4);"
        "if((maximum==1 && v>x) || (maximum==0 && v<x)){x=v;}j=j+1;}return x;}"
        "native function place_glyph(verts:i64,row:i64,axis:i64) f64 {"
        "let at=verts+row*24*32;let j=0;let value=0.0;"
        "if(axis<2){value=ux_f32(at+axis*4);}"
        "while(j<24){if(axis==2){if(ux_f32(at+j*32+20)==1.0){value=value+1.0;}}"
        "else{let v=ux_f32(at+j*32+axis*4);if(v<value){value=v;}}j=j+1;}return value;}"
        "let mesh=GeometryBuffers_init(0,256,72,0,0);"
        "let a=ux_u32_put(3000,65);let b=ux_u32_put(3004,65);let c=ux_u32_put(3008,10);let d=ux_u32_put(3012,65);"
        "let code=ux_u32_put(3104,65);let outline=ux_u32_put(3108,3200);let advance=ux_f64_put(3112,700.0);"
        "let contour=ux_u32_put(3200,3304);let points=ux_u32_put(3204,3);"
        "let top=ux_f64_put(3328,100.0);let right=ux_f64_put(3336,200.0);"
        "let count=TextGeometry_layout(3000,4,3104,1,3400,3,0.01,1200.0);";
    const char *render="let ready=TextGeometry_generatePlaced(mesh,3400,count,0.01,2.0,4096,512);";
    const double gold[]={72,0,-12,0,9,1,2,0,0,3,7,0,3,0,-12,3,-1,-1};
    char source[18][300],negative[300];
    const char *cases[18];
    tx_snprintf(source[0],sizeof source[0],"%s return 0.0+ux_u32(16);",render);
    for(int i=1;i<=6;i++) tx_snprintf(source[i],sizeof source[i],
        "%s return place_bound(256,%d,%d);",render,(i-1)%3,i>=4);
    for(int i=7;i<16;i++) tx_snprintf(source[i],sizeof source[i],
        "%s return place_glyph(256,%d,%d);",render,(i-7)/3,(i-7)%3);
    for(int i=0;i<16;i++) cases[i]=source[i];
    cases[16]="return 0.0+TextGeometry_generatePlaced(mesh,3400,count,0.01,2.0,4096,48);";
    cases[17]="return 0.0+TextGeometry_generatePlaced(mesh,3400,count,0.01,2.0,256,512);";
    tx_snprintf(negative,sizeof negative,
        "let m=ux_f64_put(3432,5.0);%s return place_glyph(256,1,0);",render);
    return g_wasm_batch_addon("G_STRUCT TextGeometry placed","textgeometry-placed",argv[1],modules,
        setup,cases,gold,18,mutate?10:-1,negative);
}

