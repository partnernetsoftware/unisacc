#pragma unisa use mem.heap
#pragma unisa use text.text

static int verify(char **command,int seconds,int expected,const char *marker) {
    char *output=0;
    size_t bytes=0;
    const int rc=cx_runv_timeout(command,seconds,&output,&bytes);
    if(output) printf("%.*s",(int)bytes,output);
    const int failed=rc!=expected || !output || tx_find(output,bytes,marker,tx_len(marker,160))<0;
    mm_free(output);
    if(failed) printf("LOADER_FAMILY_CHECK expected_rc=%d actual_rc=%d marker=%s\n",expected,rc,marker);
    return failed;
}

int main(void) {
    char *generated[]={"sh","./unisacc.com","ujs/tools-ux/gen-loader-family.cx","--","--check",0};
    char *normal[]={"sh","./unisacc.com","-I","ujs/tests","ujs/tests/loader-family-io.cx","--",0};
    char *mutated[]={"sh","./unisacc.com","-I","ujs/tests","ujs/tests/loader-family-io.cx","--","--mutate",0};
    if(verify(generated,10,0,"classes=13 failed=0")) return 1;
    if(verify(normal,21,0,"cases=52 failed=0")) return 1;
    return verify(mutated,21,1,"case=43 actual=0 r160=1 gold=1");
}
