#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"animation-view","record-copy","loaderutils","json-read","json-string-decode","animation-json-flatten","animation-json-discrete",0};
    const char json[]="[{\"time\":0},{\"time\":1,\"flag\":false,\"label\":\"\\u82a6\"},{\"time\":2,\"flag\":true,\"label\":\"x\"}]";
    char setup[1300];
    int n=tx_snprintf(setup,sizeof setup,"let data=[");
    for(int i=0;i<(int)sizeof json-1;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[i]);
    tx_snprintf(setup+n,sizeof setup-n,
        "];let length=%d;let i=0;while(i<length){let w=ux_u8_put(128+i,data[i]);i=i+1;}"
        "let flag=ux_u32_put(256,1734437990);let tag=ux_u32_put(264,1700946284);let tail=ux_u8_put(268,108);"
        "let out=320;let times=ux_u32_put(out+AnimationJsonDiscreteRows.times,384);"
        "let values=ux_u32_put(out+AnimationJsonDiscreteRows.values,448);"
        "let text=ux_u32_put(out+AnimationJsonDiscreteRows.text,576);"
        "let row=ux_u32_put(out+AnimationJsonDiscreteRows.capacity,4);"
        "let cap=ux_u32_put(out+AnimationJsonDiscreteRows.textCapacity,16);",
        (int)sizeof json-1);
    const char *cases[]={
        "let r=AnimationUtils_flattenDiscrete(128,length,256,4,1,320,512);return ux_u32(r+AnimationJsonDiscreteRows.count);",
        "let r=AnimationUtils_flattenDiscrete(128,length,256,4,1,320,512);return ux_u32(448);",
        "let r=AnimationUtils_flattenDiscrete(128,length,256,4,1,320,512);return ux_u32(452);",
        "let r=AnimationUtils_flattenDiscrete(128,length,264,5,2,320,512);return ux_u8(ux_u32(448));",
        "let r=AnimationUtils_flattenDiscrete(128,length,264,5,2,320,512);return ux_u32(452);",
        "let r=AnimationUtils_flattenDiscrete(128,length,264,5,2,320,512);return ux_u8(ux_u32(456));",
        "let r=AnimationUtils_flattenDiscrete(128,length,264,5,2,320,512);return ux_f32(384);",
        "let keep=ux_u32_put(448,777);let small=ux_u32_put(out+AnimationJsonDiscreteRows.textCapacity,3);"
        "let r=AnimationUtils_flattenDiscrete(128,length,264,5,2,320,512);return ux_u32(448);"
    };
    const double gold[]={2,0,1,232,3,120,1,777};
    return g_math_run("G_ANIM AnimationUtils discrete JSON","animation-json-discrete",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let r=AnimationUtils_flattenDiscrete(128,length,264,5,2,320,512);return ux_u8(ux_u32(456));");
}
