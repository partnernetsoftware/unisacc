#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","datautils","bufferattribute","instancedbufferattribute",0};
    const char *setup="let a=InstancedBufferAttribute_init(0,128,2,2,9,0,3);let y=ux_f32_put(140,4.0);"
        "let c=InstancedBufferAttribute_clone(48,a,192,16);";
    const char *cases[]={"return a>=0;","return ux_u32(a+InstancedBufferAttribute.meshPerAttribute);",
        "return ux_u32(c+InstancedBufferAttribute.meshPerAttribute);","return BufferAttribute_getY(c,1);",
        "return ux_u32(a)!=ux_u32(c);"};
    const double gold[]={1,3,3,4,1};
    return g_math_run("G_STRUCT InstancedBufferAttribute","instancedbufferattribute",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,"return BufferAttribute_getY(c,0);");
}
