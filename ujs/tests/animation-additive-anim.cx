#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"animation-view","animation-additive",0};
    const char *setup=
        "let end=ux_f32_put(68,1.0);let data=[1,2,3,5,6,7,2,4,6];"
        "let i=0;while(i<9){let put=ux_f32_put(128+i*4,0.0+data[i]);i=i+1;}"
        "let view=AnimationSamples_init(0,64,128,2,3);let result=AnimationUtils_numericDelta(view,152,256,24);";
    const char *cases[]={
        "return result;","return ux_f32(256);","return ux_f32(260);","return ux_f32(276);","return ux_f32(128);",
        "return AnimationUtils_numericDelta(view,152,128,24);",
        "let guard=ux_u32_put(256,777);let rejected=AnimationUtils_numericDelta(view,152,256,23);return ux_u32(256);",
        "let scale=4294967296.0;let max=(2.0-1.0/8388608.0)*2147483648.0*scale*scale*scale;"
        "let high=ux_f32_put(128,max);let low=ux_f32_put(152,0.0-max);"
        "return AnimationUtils_numericDelta(view,152,256,24);"
    };
    const double gold[]={24,-1,-2,1,1,-1,777,-3};
    return g_math_run("G_ANIM AnimationUtils numeric additive","animation-additive",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,"return ux_f32(256);");
}
