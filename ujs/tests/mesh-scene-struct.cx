#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d",
        "mesh-layout","mesh-scene",0};
    const char *setup=
        "let arena=Object3D_initArena(0,5);let root=Object3D_create(arena);"
        "let first=Object3D_create(arena);let group=Object3D_create(arena);"
        "let hidden=Object3D_create(arena);let last=Object3D_create(arena);"
        "let a=Object3D_add(arena,root,last);let b=Object3D_add(arena,root,group);"
        "let c=Object3D_add(arena,group,hidden);let d=Object3D_add(arena,root,first);"
        "let group_at=Object3D_address(arena,group);let hide=ux_u32_put(group_at+Object3D.visible,0);"
        "let e=ux_u32_put(2308,2600);let f=ux_u32_put(2316,2640);let g=ux_u32_put(2320,2680);"
        "let h=ux_u32_put(2600+Mesh.node,first);let j=ux_u32_put(2640+Mesh.node,hidden);"
        "let k=ux_u32_put(2680+Mesh.node,last);";
    const char *cases[]={
        "return MeshScene_collect(arena,root,2304,2400,2500);",
        "let n=MeshScene_collect(arena,root,2304,2400,2500);return ux_u32(2500);",
        "let n=MeshScene_collect(arena,root,2304,2400,2500);return ux_u32(2504);",
        "let v=ux_u32_put(group_at+Object3D.visible,1);let n=MeshScene_collect(arena,root,2304,2400,2500);return ux_u32(2504);",
        "let v=ux_u32_put(2680+Mesh.node,last+65536);return MeshScene_collect(arena,root,2304,2400,2500);",
        "return MeshScene_collect(arena,root,2304,2400,2404);"
    };
    const double gold[]={2,2680,2600,2640,1,-1};
    return g_math_run("G_STRUCT MeshScene","mesh-scene",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let v=ux_u32_put(group_at+Object3D.visible,1);return MeshScene_collect(arena,root,2304,2400,2500);");
}
