#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","helper-buffers","gridhelper","polargridhelper","helper-family-grid-lifecycle",0};
    const char *setup=
        "let grid=GridHelper_init(0,128,512,16,96,8.0,2);"
        "let polar=PolarGridHelper_init(32,1024,1512,1904,4.0,4,2,4);"
        "let grid_copy=GridHelper_copy(48,grid);let grid_clone=GridHelper_clone(64,grid);"
        "let polar_copy=PolarGridHelper_copy(80,polar);let polar_clone=PolarGridHelper_clone(1920,polar);"
        "if(grid_copy!=48 || grid_clone!=64 || polar_copy!=80 || polar_clone!=1920) { return 0.0-123.0; }";
    const char *cases[]={
        "return 0.0+ux_u32(grid_clone+GridHelper.count);",
        "return 0.0+ux_u32(polar_clone+PolarGridHelper.count);",
        "let changed=ux_f32_put(ux_u32(grid+GridHelper.positions),42.0);"
        "return ux_f32(ux_u32(grid_copy+GridHelper.positions));",
        "let changed=ux_f32_put(ux_u32(polar+PolarGridHelper.colors),0.25);"
        "return ux_f32(ux_u32(polar_copy+PolarGridHelper.colors));",
        "let gone=GridHelper_dispose(grid_clone);let polar_gone=PolarGridHelper_dispose(polar_clone);"
        "let bad=GridHelper_copy(256,grid_clone);let polar_bad=PolarGridHelper_copy(4112,polar_clone);"
        "let alias=GridHelper_clone(128,grid);let polar_alias=PolarGridHelper_clone(1512,polar);"
        "if(gone!=0 || polar_gone!=0 || bad!=0-1 || polar_bad!=0-1 || alias!=0-1 || polar_alias!=0-1) { return 0.0; }"
        "return 0.0+(ux_u32(grid+GridHelper.active)==1 && ux_u32(polar+PolarGridHelper.active)==1);",
    };
    const double gold[]={12,24,42,0.25,1};
    return g_wasm_batch_page("G_STRUCT grid helpers copy and clone","helper-family-grid-lifecycle",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "return ux_f32(ux_u32(grid_copy+GridHelper.positions));");
}
