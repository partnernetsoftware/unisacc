#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","mesh-layout","skeleton-layout","skinnedmesh-deform",
        "skinnedmesh","skin-bind-mode",0};
    const char *setup=
        "let skin=SkinnedMesh_init(0,64,128,256);let bind=Matrix4_makeTranslation(128,2.0,0.0,0.0);"
        "let src=Matrix4_makeTranslation(448,4.0,0.0,0.0);"
        "let a=ux_u32_put(896,1635018084);let b=ux_u32_put(900,1684367459);"
        "let tag=DetachedBindMode_parse(896,8);let changed=SkinnedMesh_updateBind(skin,src,tag);";
    const char *cases[]={
        "return tag;","return ux_f64(changed+96);","return ux_f64(bind+96);",
        "let a=ux_u8_put(896,68);return DetachedBindMode_parse(896,8);",
        "return SkinnedMesh_updateBind(skin,src,99);"
    };
    const double gold[]={2,-2,2,-1,-1};
    return g_math_run("G_STRUCT DetachedBindMode","detached-bind",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let wrong=SkinnedMesh_updateBind(skin,src,1);return ux_f64(wrong+96);");
}
