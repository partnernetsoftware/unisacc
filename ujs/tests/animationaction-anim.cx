#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","animation-view","animationaction",0};
    const char *setup="let action=AnimationAction_init(0,1.0,2201,4,1);";
    const char *cases[]={
        "let p=AnimationAction_step(action,2.25);return ux_f64(p+AnimationAction.sampleTime);",
        "let p=AnimationAction_step(action,2.25);return ux_i32(p+AnimationAction.eventValue);",
        "let p=AnimationAction_step(action,-0.25);return ux_i32(p+AnimationAction.eventValue);",
        "let a=AnimationAction_init(0,1.0,2202,4,1);let p=AnimationAction_step(a,1.25);return ux_f64(p+AnimationAction.sampleTime);",
        "let a=AnimationAction_init(0,1.0,2200,0,1);let p=AnimationAction_step(a,1.25);return ux_f64(p+AnimationAction.sampleTime);",
        "let a=AnimationAction_init(0,1.0,2200,0,1);let p=AnimationAction_step(a,1.25);return ux_u32(p+AnimationAction.paused);",
        "let a=AnimationAction_init(0,1.0,2200,0,0);let p=AnimationAction_step(a,-0.25);return ux_i32(p+AnimationAction.eventValue);",
        "let a=AnimationAction_init(0,1.0,2200,0,0);let p=AnimationAction_step(a,1.25);return ux_u32(p+AnimationAction.enabled);",
        "let a=ux_f64_put(action+AnimationAction.timeScale,0.5);let p=AnimationAction_step(action,1.0);return ux_f64(p+AnimationAction.sampleTime);"
    };
    const double gold[]={0.25,2,-1,0.75,1,1,-1,0,0.5};
    return g_math_run("G_ANIM AnimationAction","animationaction",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let p=AnimationAction_step(action,1.25);return ux_f64(p+AnimationAction.sampleTime);");
}
