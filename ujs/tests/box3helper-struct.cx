#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"box3helper",0};
    const char *setup="let h=0;let box=32;let xyz=96;let index=192;let pose=256;"
        "let a=ux_f64_put(box,0.0-2.0);let b=ux_f64_put(box+8,2.0);let c=ux_f64_put(box+16,1.0);"
        "let d=ux_f64_put(box+24,6.0);let e=ux_f64_put(box+32,8.0);let f=ux_f64_put(box+40,3.0);"
        "let init=Box3Helper_init(h,box,xyz,index);let ready=Box3Helper_pose(h,pose);";
    const char *cases[]={
        "return ux_f64(pose);",
        "return ux_f64(pose+8);",
        "return ux_f64(pose+24);",
        "return ux_f64(pose+32);",
        "return ux_f32(xyz+92);",
        "return 0.0+ux_u16(index+46);",
        "let v=ux_f64_put(box,10.0);let u=Box3Helper_pose(h,pose);return ux_f64(pose+8);",
        "let g=Box3Helper_dispose(h);return 0.0+ux_u32(h+Box3Helper.active);",
        "return 0.0+Box3Helper_pose(h,xyz);",
    };
    const double gold[]={2,5,4,3,-1,7,5,0,-1};
    return g_wasm_batch("G_STRUCT Box3Helper","box3helper",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,"return ux_f64(pose+24);");
}
