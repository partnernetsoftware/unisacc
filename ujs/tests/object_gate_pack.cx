#pragma unisa module object_gate_pack
#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.text

int object_gate_pack_lines(char *program,int used,int capacity,const char *path) {
    unsigned char *body=0;
    int64_t size=0;
    if(sy_read_file(path,&body,&size,100000)) return -1;
    for(long p=0;p<size;) {
        long end=p;
        while(end<size && body[end]!='\n') end++;
        while(p<end && (body[p]==' ' || body[p]=='\t')) p++;
        if(p<end && !tx_prefix((const char*)body+p,end-p,"//",2)) {
            int quote=0;
            for(long i=p;i<end;i++) {
                int ch=body[i];
                if(!quote && ch=='/' && i+1<end && body[i+1]=='/') break;
                if(ch=='"' && (i==p || body[i-1]!='\\')) quote=!quote;
                if(!quote && (ch==' ' || ch=='\t') && i>p && i+1<end) {
                    int before=body[i-1],after=body[i+1];
                    int afterLogical=i+2<end && (after=='&' || after=='|') && body[i+2]==after;
                    int beforeLogical=i>=p+2 && (before=='&' || before=='|') && body[i-2]==before;
                    if(before=='(' || before==',' || before=='[' || before=='{' ||
                       after==')' || after==',' || after==';' || after=='{' || after=='}' ||
                       afterLogical || beforeLogical || before==':' || after==':' ||
                       before=='=' || after=='=' || before=='+' || after=='+' ||
                       before=='*' || after=='*' || before=='%' || after=='%' ||
                       before=='>' || after=='>' || before=='<' || after=='<' ||
                       after=='(' || after=='[' || before==';' || before=='}') continue;
                }
                if(used>=capacity-1) { mm_free(body); return -1; }
                program[used++]=ch;
            }
            if(used>=capacity) { mm_free(body); return -1; }
            if(program[used-1]!=';' && program[used-1]!='{' && program[used-1]!='}') program[used++]='\n';
        }
        p=end+1;
    }
    mm_free(body);
    return used;
}
