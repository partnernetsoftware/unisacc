#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    int ray_mutate=argc==2 && tx_eqz(argv[1],"--mutate-ray");
    if(argc!=1 && !mutate && !ray_mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d","lod",0};
    const char *setup=
        "let arena=Object3D_initArena(0,4);let root=Object3D_create(arena);"
        "let near_node=Object3D_create(arena);let far_node=Object3D_create(arena);let camera=Object3D_create(arena);"
        "let cam=Object3D_address(arena,camera);let cam_x=ux_u32(cam+Object3D.worldMatrix)+96;"
        "let near_record=Object3D_address(arena,near_node);let far_record=Object3D_address(arena,far_node);"
        "let lod=LOD_init(2048,arena,root,2112,2);"
        "let a=LOD_addLevel(lod,arena,far_node,0.0-10.0,0.2);let b=LOD_addLevel(lod,arena,near_node,0.0,0.0);"
        "let first=LOD_update(lod,arena,camera,1.0);let near_id=LOD_getObjectForDistance(lod,arena,0.0);"
        "let p=ux_f64_put(cam_x,11.0);let far_update=LOD_update(lod,arena,camera,1.0);"
        "let q=ux_f64_put(cam_x,9.0);let retained=LOD_update(lod,arena,camera,1.0);";
    const char *cases[]={
        "return 0.0+(near_id==near_node);",
        "return ux_f64(2112+LODLevel.size+LODLevel.distance);",
        "return 0.0+LOD_getCurrentLevel(lod);",
        "return 0.0+ux_u32(far_record+Object3D.visible);",
        "return 0.0+ux_u32(near_record+Object3D.visible);",
        "let p=ux_f64_put(cam_x,7.0);let u=LOD_update(lod,arena,camera,1.0);return 0.0+LOD_getCurrentLevel(lod);",
        "let u=LOD_update(lod,arena,camera,2.0);return 0.0+LOD_getCurrentLevel(lod);",
        "return 0.0+LOD_addLevel(lod,arena,camera,20.0,0.0);",
        "return 0.0+(LOD_raycastTarget(lod,arena,cam_x)==far_node);",
        "let near=ux_f64_put(cam_x,7.0);return 0.0+(LOD_raycastTarget(lod,arena,cam_x)==near_node);",
        "let world=ux_u32(Object3D_address(arena,root)+Object3D.worldMatrix);let shift=ux_f64_put(world+96,5.0);"
        "return 0.0+(LOD_raycastTarget(lod,arena,cam_x)==near_node);",
        "let saved=ux_u32_put(lod+LOD.count,0);return 0.0+LOD_raycastTarget(lod,arena,cam_x);",
        "return 0.0+LOD_raycastTarget(lod,arena,6291440);",
    };
    const double gold[]={1,10,1,1,0,0,0,-2,1,1,1,0,-1};
    return g_wasm_batch("G_STRUCT LOD","lod",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        ray_mutate?8:mutate?2:-1,ray_mutate?
        "let x=ux_f64_put(cam_x,7.0);return 0.0+(LOD_raycastTarget(lod,arena,cam_x)==far_node);":
        "let h=ux_f64_put(2112+LODLevel.size+LODLevel.hysteresis,0.0);"
        "let u=LOD_update(lod,arena,camera,1.0);return 0.0+LOD_getCurrentLevel(lod);");
}
