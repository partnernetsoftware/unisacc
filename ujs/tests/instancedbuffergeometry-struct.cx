#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","buffergeometry","instancedbuffergeometry",0};
    const char *setup="let g=InstancedBufferGeometry_init(0,64,4,128,4);"
        "let original=InstancedBufferGeometry_getCount(g);let n=InstancedBufferGeometry_setCount(g,7);"
        "let r=BufferGeometry_setDrawRange(g,1,2);";
    const char *cases[]={"return g>=0;","return original==4294967295;",
        "return InstancedBufferGeometry_getCount(g);","return ux_u32(g+BufferGeometry.drawCount);"};
    const double gold[]={1,1,7,2};
    return g_math_run("G_STRUCT InstancedBufferGeometry","instancedbuffergeometry",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,"let n2=InstancedBufferGeometry_setCount(g,8);return InstancedBufferGeometry_getCount(n2);");
}
