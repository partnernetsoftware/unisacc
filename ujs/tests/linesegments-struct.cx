#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","datautils","bufferattribute","buffergeometry",
        "mesh-layout","line","linesegments",0};
    const char *setup=
        "let geo=BufferGeometry_init(0,64,1,96,0);let position=BufferAttribute_init(128,256,4,3,9,0);"
        "let a=ux_f32_put(268,3.0);let b=ux_f32_put(280,3.0);let c=ux_f32_put(284,4.0);"
        "let d=ux_f32_put(292,3.0);let e=ux_f32_put(296,4.0);let f=ux_f32_put(300,12.0);"
        "let attr=BufferGeometry_setAttribute(geo,8,position);let line=384;"
        "let initialized=ux_u32_put(line+Mesh.geometry,geo);"
        "let count=LineSegments_computeDistances(line,8,512,4);";
    const char *cases[]={
        "return count;","return ux_f32(512);","return ux_f32(516);","return ux_f32(520);","return ux_f32(524);",
        "let indexed=BufferGeometry_setIndex(geo,128);return LineSegments_computeDistances(line,8,512,4);"
    };
    const double gold[]={4,0,3,3,15,-1};
    return g_math_run("G_STRUCT LineSegments","linesegments",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?3:-1,"let strip=Line_computeLineDistances(line,8,512,4);return ux_f32(520);");
}
