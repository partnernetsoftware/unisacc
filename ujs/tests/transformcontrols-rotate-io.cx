#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"f64-math","transformcontrols-translate","transformcontrols-rotate",0};
    const char *setup="let q=64;let delta=128;let camera=192;let out=256;"
        "let initial=ux_f64_put(q+24,1.0);let cz=ux_f64_put(camera+16,10.0);"
        "let dy=ux_f64_put(delta+8,0.0-0.375);";
    #define ROTATE "let done=TransformControls_rotate(out,q,delta,camera,"
    #define X_SNAP ROTATE "1,0.5);"
    #define ANGLE "return ux_f64(out+32);"
    #define INITIAL_Y "let sy=ux_f64_put(q+8,0.7071067811865476);let sw=ux_f64_put(q+24,0.7071067811865476);"
    const char *cases[]={
        ROTATE "1,0.0);" ANGLE,
        X_SNAP ANGLE,
        X_SNAP "return ux_f64(out);",
        "let dy=ux_f64_put(delta+8,0.375);" X_SNAP ANGLE,
        "let dx=ux_f64_put(delta,0.6);" ROTATE "2,0.5);" ANGLE,
        "let dz=ux_f64_put(camera+16,0.0);let cx=ux_f64_put(camera,10.0);let dy=ux_f64_put(delta+8,0.31);"
          ROTATE "4,0.5);" "return ux_f64(out+16);",
        INITIAL_Y X_SNAP "return ux_f64(out+16);",
        INITIAL_Y X_SNAP "return ux_f64(out+24);",
        "return 0.0+TransformControls_rotate(out,q,delta,camera,4,0.5);",
        "let mark=ux_f64_put(out,17.0);let bad=ux_f64_put(delta+8,1.0/0.0);" X_SNAP "return ux_f64(out);",
    };
    const double gold[]={0.75,1,0.479425538604203,-0.5,1,0.24740395925452294,
        0.479425538604203*0.7071067811865476,0.8775825618903728*0.7071067811865476,-1,17};
    return g_wasm_batch_addon("G_RAY TransformControls world rotation","transformcontrols-rotate",
        argv[1],modules,setup,cases,gold,sizeof gold/sizeof gold[0],mutate?1:-1,ROTATE "1,0.0);" ANGLE);
}
