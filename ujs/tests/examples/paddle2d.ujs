let px = 4;
let bx = 2;
let by = 1;
let vx = 2;
let vy = 1;
let hits = 0;
let i = 0;
while (i < 12) {
  bx = bx + vx;
  by = by + vy;
  if (bx > 10) { vx = 0 - vx; bx = 10; }
  if (bx < 0) { vx = 0 - vx; bx = 0; }
  if (by < 0) { vy = 0 - vy; by = 0; }
  if (by > 8) {
    if (bx > px - 2) {
      if (bx < px + 3) {
        vy = 0 - vy;
        by = 8;
        hits = hits + 1;
      } else {
        by = 0;
        vy = 1;
      }
    } else {
      by = 0;
      vy = 1;
    }
  }
  i = i + 1;
}
return hits + 100 * bx + by;
