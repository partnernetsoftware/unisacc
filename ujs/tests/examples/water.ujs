let map = [
  8, 62, 42, 58, 12, 74,
  20, 60, 55, 55, 18, 80,
  5, 58, 48, 60, 8, 80,
  15, 64, 70, 60, 10, 84,
  6, 55, 40, 58, 12, 76,
  25, 66, 80, 62, 28, 84,
  10, 60, 50, 68, 8, 84,
  18, 63, 55, 75, 14, 78
];
let pal = [660520, 1708064, 530456, 1574920, 1052696, 1310732, 790548, 657936];
let d = list(56);
let i = 0;
while (i < 48) {
  d[i] = map[i];
  i = i + 1;
}
i = 0;
while (i < 8) {
  d[48 + i] = pal[i];
  i = i + 1;
}
return d;
