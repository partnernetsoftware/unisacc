let far = [0,30, 20,28, 40,32, 60,26, 80,30, 100,28];
let mid = [5,48, 22,44, 38,50, 55,42, 72,48, 95,46];
let near = [0,70, 18,66, 35,72, 52,64, 70,68, 90,74, 100,70];
let d = list(38);
let i = 0;
while (i < 12) { d[i] = far[i]; i = i + 1; }
i = 0;
while (i < 12) { d[12 + i] = mid[i]; i = i + 1; }
i = 0;
while (i < 14) { d[24 + i] = near[i]; i = i + 1; }
cam = cam + dt;
return {d: d, cam: cam};
