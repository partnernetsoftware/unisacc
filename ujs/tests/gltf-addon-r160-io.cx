#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt

static int addon_path(const char *path) {
    if(path[0]!='/') return 0;
    int i=0;
    while(path[i]) {
        char c=path[i++];
        if(i>180 || !((c>='A' && c<='Z') || (c>='a' && c<='z') ||
           (c>='0' && c<='9') || c=='/' || c=='-' || c=='_' || c=='.')) return 0;
    }
    return i>1;
}

int main(int argc,char **argv) {
    if(argc!=2 || !addon_path(argv[1])) return 2;
    char cwd[390],url[690],dir[270];
    int failed=sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-gltf-oracle-",dir,sizeof dir);
    if(failed) return 2;
    tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/gltf-addon-r160.html?package=%s",cwd,argv[1]);
    const double gold[]={4,55,99,10,30,99,9728,9984,33071,33648,9987,10497};
    double actual[12]={0};
    failed=r160_wait_read(url,"#r160",actual,sizeof gold/sizeof gold[0],dir);
    if(!failed) for(int i=0;i<(int)(sizeof gold/sizeof gold[0]);i++) {
        if(actual[i]!=gold[i]) {
            printf("G_IO glTF actual r160 case=%d value=%.17g gold=%.17g\n",i,actual[i],gold[i]);
            failed++;
        }
    }
    char *clean[]={"rm","-rf","--",dir,0},*output=0;
    size_t bytes=0;
    if(cx_runv_timeout(clean,5,&output,&bytes)) failed++;
    mm_free(output);
    printf("G_IO glTF actual r160 cases=%d failed=%d\n",(int)(sizeof gold/sizeof gold[0]),failed);
    return failed!=0;
}
