#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define TEST "ujs/practice/uxe/test/"

static int material_physical_event_layout(const char *out) {
    unsigned char *raw=0;
    int64_t bytes=0;
    if(sy_read_file(BASE "object-layouts.ujs",&raw,&bytes,20000)) return 1;
    const char *text=(const char *)raw;
    const char anchor[]="struct EventDispatcher {";
    const long start=tx_find(text,bytes,anchor,sizeof anchor-1);
    const long end=start<0?-1:tx_find(text+start,bytes-start,"\n}\n",3);
    const int failed=end<0 || sy_write_file(out,text+start,end+3,0600);
    mm_free(raw);
    return failed;
}

static int material_physical_compile(const char *dir) {
    char layout[320],wasm[320],event[320];
    tx_snprintf(event,sizeof event,"%s/event.ujs",dir);
    tx_snprintf(layout,sizeof layout,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/probe.wasm",dir);
    const char abi[]="export uxe_material_physical(op:i64,pick:i64,arg:i64) f64 version 1;\n";
    if(sy_write_file(layout,abi,sizeof abi-1,0600) || material_physical_event_layout(event)) return 1;
    char *args[]={"./ujs/ujs2wasm.com",layout,event,BASE "record-copy.ujs",
        BASE "eventdispatcher.ujs",BASE "material-class.ujs",BASE "json-bytes.ujs",BASE "json-read.ujs",
        BASE "loaderutils.ujs",BASE "json-string-decode.ujs",BASE "material-field-json.ujs",BASE "material-field-read.ujs",
        BASE "material-fields-generated.ujs",BASE "material-set-values.ujs",BASE "gpu-material-lambert.ujs",
        BASE "f64-math.ujs",BASE "gpu-material-standard.ujs",BASE "mesh-physical-material.ujs",BASE "material-physical-object.ujs",
        BASE "material-physical-object-json.ujs",TEST "material-physical-object-probe.ujs","-o",wasm,0};
    char *log=0;
    size_t bytes=0;
    const int rc=cx_runv_timeout(args,8,&log,&bytes);
    if(rc) printf("PHYSICAL_OBJECT_BUILD rc=%d %.*s\n",rc,(int)bytes,log);
    mm_free(log);
    return rc;
}

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[460],url[850];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","ujs-physical-object-",dir,sizeof dir)) return 2;
    const int n=tx_snprintf(url,sizeof url,"file://%s/" TEST "material-physical-object-r160.html?dir=%s%s",
        cwd,dir,mutate?"&mutate=1":"");
    // Both constructor defaults and a texture-free parameter record
    // are compared numerically with the reference loader and the UJS codec.
    #define DEFAULT 0xffffff,1,0,0,1,1,0,0,0,0,.5,0,1.3,0,0,1,0,0,-1,0xffffff,1,0xffffff,0,0,1,1,0,0,1,1,100,400
    #define LOADED 0x3366cc,.625,.125,0x112233,2,.75,.5,.25,.625,.375,.5,.25,1.25,.5,0x224466,.375,.75,.5,8,0x6699cc,.625,0xf0d080,1,1,0,.75,.25,2,0,0,120,420
    const double gold[]={DEFAULT,DEFAULT,LOADED,LOADED,6,6,6,.625,.375,1,1,1,1,1,1,1,1,1};
    enum { count=sizeof gold/sizeof gold[0] };
    double values[count]={0};
    int failed=n<0 || n>=sizeof url || material_physical_compile(dir) || r160_wait_read(url,"#r160",values,count,dir);
    for(int i=0;!failed && i<count;i++) {
        double delta=values[i]-gold[i];
        if(!(delta>=-1e-9 && delta<=1e-9)) {
            printf("PHYSICAL_OBJECT case=%d actual=%.17g gold=%.17g\n",i,values[i],gold[i]);
            failed=1;
        }
    }
    if(sy_remove_all(dir)) failed=1;
    printf("G_STRUCT MeshPhysicalMaterial JSON cases=%d failed=%d\n",count,failed);
    return failed;
}
