#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"f64-math","vector-scalar","orbitcontrols",0};
    const char *setup=
        "let eye=0;let target=64;let control=256;let z=ux_f64_put(eye+16,10.0);"
        "let ready=OrbitControls_init(control,eye,target,100.0);";
    #define DOWN "let down=OrbitControls_pointer(control,1,7,0.0,0.0);"
    #define MOVE "let move=OrbitControls_pointer(control,2,7,25.0,0.0);"
    #define UP "let up=OrbitControls_pointer(control,3,7,25.0,0.0);"
    #define WHEEL "let turn=OrbitControls_wheel(control,0.0-100.0,1);"
    #define STEP "let frame=OrbitControls_step(control);"
    #define DAMP "let damp=ux_f64_put(control+OrbitControls.damping,0.2);"
    const char *cases[]={
        DOWN MOVE STEP "return ux_f64(control+OrbitControls.x);",
        DOWN MOVE STEP "return ux_f64(control+OrbitControls.z);",
        WHEEL STEP "return ux_f64(control+OrbitControls.radius);",
        DOWN "return 0.0+OrbitControls_pointer(control,2,9,25.0,0.0);",
        DOWN WHEEL STEP "return ux_f64(control+OrbitControls.radius);",
        DAMP DOWN MOVE STEP "return ux_f64(control+OrbitControls.x);",
        DAMP DOWN MOVE STEP "let next=OrbitControls_step(control);return ux_f64(control+OrbitControls.x);",
        "let r=ux_f64_put(control+OrbitControls.minRadius,9.8);" WHEEL STEP "return ux_f64(control+OrbitControls.radius);",
        "return 0.0+OrbitControls_wheel(control,0.0-100.0,0);",
        DOWN "let move=OrbitControls_pointer(control,2,7,1000000000000.0,0.0);return 0.0+OrbitControls_step(control);",
        DOWN UP WHEEL STEP "return ux_f64(control+OrbitControls.radius);",
    };
    const double gold[]={-10,0,9.5,0,10,-3.090169943749474,-5.358267949789966,9.8,-1,-1,9.5};
    return g_wasm_batch_addon("G_RAY OrbitControls drag wheel damping","orbitcontrols",argv[1],modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,DOWN
        "let move=OrbitControls_pointer(control,2,7,0.0-25.0,0.0);" STEP "return ux_f64(control+OrbitControls.x);");
}
