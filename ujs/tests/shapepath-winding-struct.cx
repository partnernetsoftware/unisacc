#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"curve-line","curve-bezier","path","shape","shapepath",0};
    const char *setup="let sp=ShapePath_init(0,64,2);let a=ShapePath_moveTo(sp,128,512,3,0.0,0.0);"
        "let a1=ShapePath_lineTo(sp,4.0,0.0);let a2=ShapePath_lineTo(sp,0.0,4.0);let a3=Path_closePath(128);"
        "let b=ShapePath_moveTo(sp,192,768,3,8.0,0.0);let b1=ShapePath_lineTo(sp,12.0,0.0);"
        "let b2=ShapePath_lineTo(sp,8.0,4.0);let b3=Path_closePath(192);";
    const char *cases[]={
        "return ShapePath_toShapes(sp,1024,2,1152,2,1280,8,1536,2,0);",
        "let n=ShapePath_toShapes(sp,1024,2,1152,2,1280,8,1536,2,0);"
        "return ux_u32(1024+Shape.size+Shape.contour)==192;",
        "let n=ShapePath_toShapes(sp,1024,2,1152,2,1280,8,1536,2,0);return ux_u32(1024+Shape.count);",
        "return ShapePath_toShapes(sp,1024,2,1152,2,1280,8,1536,2,1);",
        "return ShapePath_toShapes(sp,1024,1,1152,2,1280,8,1536,2,0);"
    };
    const double gold[]={2,1,0,2,-1};
    return g_math_run("G_STRUCT ShapePath winding","shapepath-winding",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let n=ShapePath_toShapes(sp,1024,2,1152,2,1280,8,1536,2,0);return ux_u32(1024+Shape.contour)==192;");
}
