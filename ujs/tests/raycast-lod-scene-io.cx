#pragma unisa use g_math
#pragma unisa use mem.heap
#pragma unisa use r160_wait
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

static const char *const dispatch_modules[]={
    "record-copy","f64-math","views","matrix4","object-layouts","object3d","lod",
    "raycast-memory","scene-snapshot-layout","scene-snapshot","raycast-lod","raycast-lod-scene",0,
};
static const char *const mesh_modules[]={
    "record-copy","vector-scalar","vector3","ray","triangle","raycast-memory","raycaster-state",
    "raycast-mesh","raycast-hit-sort","raycast-buffer","raycast-instances","raycast-mesh-uv",
    "scene-snapshot-layout","raycast-scene",0,
};

static const char *dispatch_entry=
    "if(action==1){return ux_span(0,5504);}"
    "let arena=Object3D_initArena(0,8);let group=Object3D_create(arena);let before=Object3D_create(arena);"
    "let root=Object3D_create(arena);let near=Object3D_create(arena);let far=Object3D_create(arena);"
    "let after=Object3D_create(arena);let origin=4096;let lodRows=4512;"
    "let lod=LOD_init(4608,arena,root,4672,2);let snapshot=4864;let staging=5120;let merged=5376;let plan=5632;"
    "let add=Object3D_add(arena,group,before);let addLod=Object3D_add(arena,group,root);"
    "let addAfter=Object3D_add(arena,group,after);let close=LOD_addLevel(lod,arena,near,0.0,0.0);"
    "let distant=LOD_addLevel(lod,arena,far,10.0,0.0);"
    "let a=ux_u32_put(plan+RaySceneLODPlan.arena,arena);let b=ux_u32_put(plan+RaySceneLODPlan.snapshot,snapshot);"
    "let c=ux_u32_put(plan+RaySceneLODPlan.lods,lodRows);let d=ux_u32_put(plan+RaySceneLODPlan.lodCount,1);"
    "let l=ux_u32_put(lodRows,lod);"
    "let ox=ux_f64_put(origin,0.25);if(test==2){let dx=ux_f64_put(origin,11.0);}"
    "let na=Object3D_address(arena,near);let ra=Object3D_address(arena,root);"
    "if(test==1){let hidden=ux_u32_put(na+Object3D.visible,0);}"
    "if(test==3 || test==5 || test==7){let child=ux_u32_put(na+Object3D.layerMask,2);}"
    "if(test==4 || test==5){let parent=ux_u32_put(ra+Object3D.layerMask,2);}"
    "let i=0;while(i<4){let node=before;if(i>=1){node=near+i-1;}"
    "let at=Object3D_address(arena,node);let pos=ux_u32(at+Object3D.worldMatrix);"
    "let z=ux_f64_put(pos+112,(i==3)*1.0-3.0);i=i+1;}"
    "let scope=group;let mode=0;if(test>=6 && test<=8){scope=root;}if(test==6 || test==7){mode=2;}"
    "let count=Scene_snapshot(arena,scope,snapshot,8,mode);let saved=ux_u32_put(plan+RaySceneLODPlan.count,count);"
    "if(test==10){let kept=ux_u32_put(merged,77);let bad=ux_u32_put(plan+RaySceneLODPlan.lodCount,2);"
    "let failed=RayScene_mergeLOD(origin,1,plan,merged,8,staging,8);return ux_u32(merged);}"
    "if(test==11){return RayScene_mergeLOD(origin,1,plan,merged,1,staging,8);}"
    "if(test==12){return RayScene_mergeLOD(origin,1,plan,merged,8,snapshot,8);}\n";

static const char *mesh_entry=
    "if(action==1){return 0.0+ux_span(0,5504);}"
    "let out=6144;if(action==2){return 0.0+ux_u32(out+value*RaySceneHit.size+RaySceneHit.node)%65536;}"
    "if(action==3){return ux_f64(out+value*RaySceneHit.size+RaySceneHit.distance);}"
    "let state=4096;let table=4224;let query=5704;let merged=5376;let positions=5888;let mesh=5960;let work=7168;"
    "let ray=Raycaster_default(state);let ox=ux_f64_put(state+RaycasterState.ox,0.25);"
    "if(test==2){let far=ux_f64_put(state+RaycasterState.ox,11.0);}"
    "if(test==9){let clip=ux_f64_put(state+RaycasterState.far,2.5);}"
    "let q=ux_u32_put(query+RaySceneQuery.meshes,table);let qn=ux_u32_put(query+RaySceneQuery.meshCount,4);"
    "let n=ux_u32_put(query+RaySceneQuery.count,value);let s=ux_u32_put(query+RaySceneQuery.snapshot,merged);"
    "let i=0;while(i<4){let node=65538;if(i>=1){node=65539+i;}"
    "let row=table+i*RaySceneMeshRow.size;let u=ux_u32_put(row+RaySceneMeshRow.node,node);"
    "let v=ux_u32_put(row+RaySceneMeshRow.mesh,mesh);i=i+1;}"
    "let m0=ux_u32_put(mesh+RayMeshBuffer.positions,positions);let m1=ux_u32_put(mesh+RayMeshBuffer.vertexCount,3);"
    "let m2=ux_u32_put(mesh+RayMeshBuffer.positionStride,12);let m3=ux_u32_put(mesh+RayMeshBuffer.faceCount,1);"
    "let x0=ux_f32_put(positions,0.0-1.0);let y0=ux_f32_put(positions+4,0.0-1.0);"
    "let x1=ux_f32_put(positions+12,16.0);let y1=ux_f32_put(positions+16,0.0-1.0);"
    "let x2=ux_f32_put(positions+24,7.0);let y2=ux_f32_put(positions+28,9.0);"
    "return 0.0+Raycaster_intersectSceneMeshes(state,query,out,8,work,4096);\n";

static int compile(const char *source,const char *wasm,const char *const *modules,
        const char *signature,const char *entry,const char *tail) {
    char program[100001];
    int used=tx_snprintf(program,sizeof program,"%s\n",signature);
    for(int i=0;modules[i];i++) {
        char path[192]; unsigned char *body=0; int64_t size=0;
        tx_snprintf(path,sizeof path,"ujs/practice/uxe/base/%s.ujs",modules[i]);
        if(sy_read_file(path,&body,&size,sizeof program-used-2)) return 1;
        const int n=tx_snprintf(program+used,sizeof program-used,"%s\n",body);
        mm_free(body);
        if(n<0 || n>=(int)sizeof program-used) return 1;
        used+=n;
    }
    const int n=tx_snprintf(program+used,sizeof program-used,"%s%s",entry,tail);
    if(n<0 || n>=(int)sizeof program-used || sy_write_file(source,program,used+n,0600)) return 1;
    char *argv[]={"./ujs/ujs2wasm.com",(char*)source,"-o",(char*)wasm,0},*out=0; size_t bytes=0;
    int rc=cx_runv_timeout(argv,6,&out,&bytes);
    if(rc) printf("LOD_SCENE compile_rc=%d file=%s\n",rc,source);
    mm_free(out);
    return rc!=0;
}

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char cwd[390],dir[256],source[290],dispatch[290],mesh[290],url[1200];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-lod-scene-",dir,sizeof dir)) return 2;
    tx_snprintf(source,sizeof source,"%s/probe.ujs",dir);
    tx_snprintf(dispatch,sizeof dispatch,"%s/dispatch.wasm",dir);
    tx_snprintf(mesh,sizeof mesh,"%s/mesh.wasm",dir);
    const int n=tx_snprintf(url,sizeof url,
        "file://%s/ujs/practice/uxe/test/raycast-lod-scene-r160.html?dispatch=%s&mesh=%s",cwd,dispatch,mesh);
    const char *normal="return RayScene_mergeLOD(origin,1,plan,merged,8,staging,8);\n";
    const char *bypass="let lost=uxe_copy_record(merged,snapshot,count*SceneSnapshotRow.size);return count;\n";
    const double gold[]={5,6,2,2,4,4,5,5,4,5,4,4,4,3,1,4,3,1,77,-2,-1};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count*2];
    int failed=n<=0 || n>=(int)sizeof url ||
        compile(source,dispatch,dispatch_modules,"export uxe_lod_dispatch(action:i64,test:i64) i64 version 1;",
            dispatch_entry,mutate?bypass:normal) ||
        compile(source,mesh,mesh_modules,"export uxe_scene_pick(action:i64,value:i64,test:i64) f64 version 1;",
            mesh_entry,"") ||
        r160_wait_read(url,"#r160",actual,count*2,dir);
    for(int i=0;!failed && i<count;i++) {
        if(!g_math_near(actual[i],gold[i],1e-9) || !g_math_near(actual[i+count],gold[i],1e-9)) {
            printf("G_RAY LOD and recursive Mesh merge case=%d actual=%.17g r160=%.17g gold=%.17g\n",
                i,actual[i+count],actual[i],gold[i]);
            failed=1;
        }
    }
    char *clean[]={"rm","-rf","--",dir,0},*out=0; size_t bytes=0;
    if(cx_runv_timeout(clean,4,&out,&bytes)) failed=1;
    mm_free(out);
    printf("G_RAY LOD and recursive Mesh merge cases=%d failed=%d\n",count,failed);
    return failed;
}
