#pragma unisa use g_math
#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define TEST "ujs/practice/uxe/test/"

static int sphere_layouts(const char *path) {
    const char *names[]={"struct EventDispatcher {","struct BufferAttribute {","struct BufferGeometry {"};
    unsigned char *raw=0;
    int64_t bytes=0;
    if(sy_read_file(BASE "object-layouts.ujs",&raw,&bytes,20000)) return 1;
    const char *text=(const char *)raw;
    char selected[1536];
    int used=0,failed=0;
    for(int i=0;i<3;i++) {
        const long start=tx_find(text,bytes,names[i],tx_len(names[i],50));
        const long end=start<0?-1:tx_find(text+start,bytes-start,"\n}\n",3);
        if(end<0) { failed=1; break; }
        const int n=tx_snprintf(selected+used,sizeof selected-used,"%.*s",(int)end+3,text+start);
        if(n<0 || n>=(int)sizeof selected-used) { failed=1; break; }
        used+=n;
    }
    mm_free(raw);
    return failed || sy_write_file(path,selected,used,0600);
}

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[390],abi[300],wasm[300],layout[300],url[850];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-sphere-public-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/sphere.wasm",dir);
    tx_snprintf(layout,sizeof layout,"%s/layouts.ujs",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/" TEST "geometry-sphere-public-r160.html?wasm=%s&mutate=%d",cwd,wasm,mutate);
    const char entry[]="export uxe_sphere_public(mode:i64,mutate:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,layout,BASE "f64-math.ujs",BASE "datautils.ujs",
        BASE "bufferattribute.ujs",BASE "buffergeometry.ujs",BASE "eventdispatcher.ujs",
        BASE "geometry-buffers.ujs",BASE "spheregeometry.ujs",BASE "geometry-buffer-adapter.ujs",
        BASE "geometry-lifecycle.ujs",BASE "geometry-public-layout.ujs",BASE "geometry-dispose.ujs",
        BASE "geometry-primitive-class.ujs",BASE "geometry-sphere-class.ujs",BASE "json-read.ujs",
        BASE "json-bytes.ujs",BASE "object-json-tokens.ujs",BASE "geometry-parametric-json.ujs",
        BASE "geometry-primitive-json.ujs",BASE "geometry-sphere-parameter-json.ujs",
        TEST "geometry-sphere-public-probe.ujs","-o",wasm,0};
    const char json[]="{\"metadata\":{\"version\":4.6,\"type\":\"BufferGeometry\","
        "\"generator\":\"BufferGeometry.toJSON\"},\"uuid\":\"sphere-5\",\"type\":\"SphereGeometry\","
        "\"name\":\"orb \\\"ice\\\"\",\"radius\":2.5,\"widthSegments\":4.5,\"heightSegments\":2.5,"
        "\"phiStart\":0.5,\"phiLength\":1.5,\"thetaStart\":0.25,\"thetaLength\":1.25}";
    uint64_t sum=0;
    for(int i=0;json[i];i++) sum=(sum*131+(unsigned char)json[i])%16777213;
    const double hash=(double)sum;
    const double ny=(float)0.9689124217106447;
    const double y=(float)(2.5*0.9689124217106447);
    const double z=(float)(2.5*0.479425538604203*0.24740395925452294);
    const double last_y=(float)(2.5*0.0707372016677029);
    const double last_z=(float)(2.5*0.9092974268256817*0.9974949866040544);
    const double gold[]={hash,1,15,48,2.5,4.5,2.5,0.5,1.5,0.25,1.25,y,z,ny,1,1,last_y,last_z,
        1,561,2880,12,18,0.5,-1,
        1,1.25,1.25,y,y,1,4182,1,41,61,0,
        hash,15,48,2.5,4.5,2.5,0.5,1.5,0.25,1.25,y,z,ny,1,1,last_y,last_z,
        561,2880,12,18,0.5,-1,
        1,1.25,1.25,y,y,4182,1,41,61,0};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    char *log=0;
    size_t size=0;
    int failed=length<0 || length>=(int)sizeof url || sy_write_file(abi,entry,sizeof entry-1,0600) ||
        sphere_layouts(layout);
    if(!failed) {
        const int rc=cx_runv_timeout(compile,10,&log,&size);
        if(rc) { printf("G_GEOMETRY SphereGeometry compile_rc=%d %s\n",rc,log?log:""); failed=1; }
        mm_free(log);
        log=0;
    }
    if(!failed) failed=r160_wait_read(url,"#r160",actual,count,dir);
    if(!failed) for(int i=0;i<count;i++) if(!g_math_near(actual[i],gold[i],1e-6)) {
        printf("G_GEOMETRY SphereGeometry case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
        failed++;
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&log,&size)) failed++;
    mm_free(log);
    printf("G_GEOMETRY SphereGeometry parameters cases=%d failed=%d\n",count,failed);
    return failed!=0;
}
