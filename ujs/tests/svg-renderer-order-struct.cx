#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define SORT "let n=SVGRenderer_sortFaces(64,6,256,6);"
#define READ(i) "return 0.0+ux_u32(256+4*" #i ");"
int main(int argc,char **argv) {
    int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"svg-renderer-order",0};
    const char *setup=
        "let i=0;while(i<6){let put=ux_u32_put(80+i*24,i+10);i=i+1;}"
        "let z0=ux_f64_put(72,0.2);let z1=ux_f64_put(96,0.8);let o2=ux_f64_put(112,0.0-1.0);"
        "let z3=ux_f64_put(144,0.8);let o4=ux_f64_put(160,2.0);let z4=ux_f64_put(168,0.9);";
    const char *cases[]={
        SORT READ(0),SORT READ(1),SORT READ(2),SORT READ(3),SORT READ(4),SORT READ(5),
        "return 0.0+SVGRenderer_sortFaces(64,6,256,5);",
        "let guard=ux_u32_put(256,77);let bad=SVGRenderer_sortFaces(64,6,256,5);" READ(0),
    };
    const double gold[]={2,1,3,0,5,4,-1,77};
    return g_wasm_batch_addon("G_STRUCT SVGRenderer painter order","svg-renderer-order",argv[1],
        modules,setup,cases,gold,sizeof gold/sizeof gold[0],mutate?1:-1,
        "let z=ux_f64_put(96,0.05);" SORT READ(1));
}
