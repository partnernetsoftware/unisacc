#pragma unisa use g_math
#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define TEST "ujs/practice/uxe/test/"

static int instanced_layout(const char *path) {
    const char *marker="struct InstancedBufferGeometry {";
    unsigned char *raw=0;
    int64_t bytes=0;
    if(sy_read_file(BASE "object-layouts.ujs",&raw,&bytes,20000)) return 1;
    long start=tx_find((const char *)raw,bytes,marker,tx_len(marker,60));
    long end=start<0?-1:tx_find((const char *)raw+start,bytes-start,"\n}\n",3);
    int failed=end<0 || sy_write_file(path,raw+start,end+3,0600);
    mm_free(raw);
    return failed;
}

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[390],abi[300],wasm[300],layout[300],url[850];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-instanced-public-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/instanced.wasm",dir);
    tx_snprintf(layout,sizeof layout,"%s/instanced-layout.ujs",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/" TEST "geometry-instanced-public-r160.html?wasm=%s&mutate=%d",cwd,wasm,mutate);
    const char entry[]="export uxe_inst_geometry(mode:i64,length:i64,mutate:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,layout,BASE "geometry-load-layout.ujs",
        BASE "f64-math.ujs",BASE "datautils.ujs",BASE "bufferattribute.ujs",BASE "buffergeometry.ujs",
        BASE "instancedbuffergeometry.ujs",BASE "object-json-tokens.ujs",BASE "json-read.ujs",
        BASE "loader-json.ujs",BASE "json-bytes.ujs",BASE "geometry-json.ujs",BASE "geometry-json-load.ujs",
        BASE "geometry-instanced-parameter-json.ujs",TEST "geometry-instanced-public-probe.ujs","-o",wasm,0};
    const double gold[]={7,7,1,1,4294967295.0,1,1,1,3,1.25,35048,3,2,0,0,0,0,1,1,1,-1,1};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    char *log=0;
    size_t size=0;
    int failed=length<0 || length>=(int)sizeof url || sy_write_file(abi,entry,sizeof entry-1,0600) || instanced_layout(layout);
    if(!failed) {
        const int rc=cx_runv_timeout(compile,15,&log,&size);
        if(rc) { printf("G_GEOMETRY InstancedBufferGeometry compile_rc=%d %s\n",rc,log?log:""); failed=1; }
        mm_free(log);
        log=0;
    }
    if(!failed) failed=r160_wait_read(url,"#r160",actual,count,dir);
    if(!failed) for(int i=0;i<count;i++) {
        int match=i==15 ? g_math_near(actual[i],gold[i],1e-6) : actual[i]==gold[i];
        if(!match) {
            printf("G_GEOMETRY InstancedBufferGeometry case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
            failed++;
        }
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&log,&size)) failed++;
    mm_free(log);
    printf("G_GEOMETRY InstancedBufferGeometry public cases=%d failed=%d\n",count,failed);
    return failed!=0;
}
