#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"curve",0};
    const char *setup="function quadratic(env,...args){let t=args[0];"
        "let dst=env[0];let x=ux_f64_put(dst,t*t);let y=ux_f64_put(dst+8,0.0);return dst;}"
        "let cb=closure(quadratic,512);";
    const char *cases[]={
        "let p=Curve_getPoints(cb,128,4,2);return ux_f64(144);",
        "let p=Curve_getPoints(cb,128,4,2);return ux_f64(192);",
        "let q=Curve_getLengths(cb,256,4,2);return ux_f64(q+24);",
        "let q=Curve_getLengths(cb,256,4,2);return Curve_getLength(q,4);",
        "let q=Curve_getLengths(cb,256,4,2);return Curve_getUtoTmapping(q,4,0.40625);",
        "let q=Curve_getLengths(cb,256,4,2);let p=Curve_getPointAt(cb,256.0,4.0,0.40625);return ux_f64(p);",
        "let t=Curve_getTangent(cb,256.0,2.0,0.5);return ux_f64(t);"
    };
    const double gold[]={0.0625,1,0.5625,1,0.625,0.390625,1};
    return g_math_run("G_STRUCT Curve","curve",modules,setup,cases,gold,7,
        mutate?4:-1,"let q=Curve_getLengths(cb,256,4,2);return Curve_getUtoTmapping(q,4,0.25);");
}
