#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    int spaced_mutate=argc==2 && tx_eqz(argv[1],"--spaced-mutate");
    int distance_mutate=argc==2 && tx_eqz(argv[1],"--distance-mutate");
    int cache_mutate=argc==2 && tx_eqz(argv[1],"--cache-mutate");
    if(argc!=1 && !mutate && !spaced_mutate && !distance_mutate && !cache_mutate) return 2;
    const char *modules[]={"curve",0};
    const char *setup="function quadratic(env,...args){let t=args[0];"
        "let dst=env[0];let x=ux_f64_put(dst,t*t);let y=ux_f64_put(dst+8,0.0);return dst;}"
        "function bend(env,...args){let t=args[0];let x=1.0;let y=0.0;"
        "if(t<0.5){x=t*2.0;}else{y=(t-0.5)*6.0;}"
        "let dst=env[0];let a=ux_f64_put(dst,x);let b=ux_f64_put(dst+8,y);return dst;}"
        "function scaled(env,...args){let t=args[0];let dst=env[0];let scale=ux_f64(env[1]);"
        "let a=ux_f64_put(dst,t*t*scale);let b=ux_f64_put(dst+8,0.0);return dst;}"
        "let cb=closure(quadratic,512);let turned=closure(bend,768);"
        "let factor=ux_f64_put(824,1.0);let responsive=closure(scaled,864,824);";
    const char *cache_setup="let cache=CurveArcCache_init(928,1024,5);"
        "let first=Curve_getCachedLengths(responsive,cache,4,2);let change=ux_f64_put(824,3.0);";
    char reuse[500],refresh[500],resize[500];
    tx_snprintf(reuse,sizeof reuse,"%slet result=Curve_getCachedLengths(responsive,cache,4,2);return Curve_getLength(result,4);",cache_setup);
    tx_snprintf(refresh,sizeof refresh,"%slet result=Curve_updateArcLengths(responsive,cache,4,2);return Curve_getLength(result,4);",cache_setup);
    tx_snprintf(resize,sizeof resize,"%slet result=Curve_getCachedLengths(responsive,cache,2,2);return Curve_getLength(result,2);",cache_setup);
    const char *cases[]={
        "let p=Curve_getPoints(cb,128,4,2);return ux_f64(144);",
        "let p=Curve_getPoints(cb,128,4,2);return ux_f64(192);",
        "let q=Curve_getLengths(cb,256,4,2);return ux_f64(q+24);",
        "let q=Curve_getLengths(cb,256,4,2);return Curve_getLength(q,4);",
        "let q=Curve_getLengths(cb,256,4,2);return Curve_getUtoTmapping(q,4,0.40625);",
        "let q=Curve_getLengths(cb,256,4,2);let p=Curve_getPointAt(cb,256.0,4.0,0.40625);return ux_f64(p);",
        "let t=Curve_getTangent(cb,256.0,2.0,0.5);return ux_f64(t);",
        "let q=Curve_getLengths(cb,256,4,2);let p=Curve_getSpacedPoints(cb,128,2,2,q,4);return ux_f64(144);",
        "let q=Curve_getLengths(cb,256,4,2);return Curve_getSpacedPoints(cb,256,2,2,q,4);",
        "let q=Curve_getLengths(turned,256,4,2);"
        "let t=Curve_getTangentAt(turned,448.0,2.0,0.4,256.0,4.0);return ux_f64(t+8);",
        "let q=Curve_getLengths(cb,256,4,2);return Curve_getUtoTdistance(q,4,0.75,0.4);",
        "let q=Curve_getLengths(cb,256,4,2);return Curve_getUtoTdistance(q,4,0.40625,0.0);",
        "let q=Curve_getLengths(cb,256,4,2);let t=Curve_getUtoTdistance(q,4,0.5,1.25);return t!=t;",
        "let t=Curve_getUtoTdistance(6291456,4,0.5,0.4);return t!=t;",
        reuse,refresh,resize,"return CurveArcCache_init(928,928,5);",
        "let p=Curve_getPoint(cb,0.25);return ux_f64(p);"
    };
    const double gold[]={0.0625,1,0.5625,1,0.625,0.390625,1,0.49,-1,1,0.62,0.625,1,1,1,3,3,-1,0.0625};
    return g_math_run("G_STRUCT Curve","curve",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        cache_mutate?14:distance_mutate?10:spaced_mutate?7:mutate?4:-1,cache_mutate?refresh:distance_mutate?
        "let q=Curve_getLengths(cb,256,4,2);return Curve_getUtoTmapping(q,4,0.75);":spaced_mutate?
        "let p=Curve_getPoints(cb,128,2,2);return ux_f64(144);":
        "let q=Curve_getLengths(cb,256,4,2);return Curve_getUtoTmapping(q,4,0.25);");
}
