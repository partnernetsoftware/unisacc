#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","mesh-packet-vertices",0};
    const char *setup=
        "let a=ux_f32_put(0,-0.5);let b=ux_f32_put(4,-0.25);let c=ux_f32_put(16,0.5);"
        "let d=ux_f32_put(24,0.5);let e=ux_f32_put(28,-0.25);"
        "let matrix=Matrix4_makeTranslation(64,0.25,-0.125,0.5);"
        "let sy=ux_f64_put(matrix+40,2.0);let r=ux_f32_put(200,0.25);"
        "let g=ux_f32_put(204,0.5);let b0=ux_f32_put(208,0.75);let alpha=ux_f32_put(212,1.0);";
    const char *cases[]={
        "return MeshPacket_vertices(0,3,matrix,200,256);",
        "let n=MeshPacket_vertices(0,3,matrix,200,256);return ux_f32(256);",
        "let n=MeshPacket_vertices(0,3,matrix,200,256);return ux_f32(260);",
        "let n=MeshPacket_vertices(0,3,matrix,200,256);return ux_f32(288);",
        "let n=MeshPacket_vertices(0,3,matrix,200,256);return ux_f32(320);",
        "let n=MeshPacket_vertices(0,3,matrix,200,256);return ux_f32(332);",
        "return MeshPacket_vertices(0,3,matrix,200,4);",
        "let w=ux_f64_put(matrix+88,-1.0);return MeshPacket_vertices(0,3,matrix,200,256);"
    };
    const double gold[]={3,-0.25,-0.625,0.875,0.5,0.75,-1,-2};
    return g_math_run("G_STRUCT MeshPacketVertices","mesh-packet-vertices",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let t=ux_f64_put(matrix+40,1.0);let n=MeshPacket_vertices(0,3,matrix,200,256);return ux_f32(260);");
}
