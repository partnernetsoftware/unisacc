#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use text.fmt
#pragma unisa use text.text

static int gpu_equirectangular_compile(const char *dir) {
    char layout[320],driver[320],wasm[320];
    tx_snprintf(layout,sizeof layout,"%s/layout.ujs",dir);
    tx_snprintf(driver,sizeof driver,"%s/driver.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/probe.wasm",dir);
    const char abi[]="export uxe_equirectangular(op:i64,mode:i64,a:i64) i64 version 1;\n";
    const char source[]=
        "if(op==0){return ux_span(0,65536);}\n"
        "if(op==1){let ratio=0.5;if(a==1){ratio=2.0;}"
        "let uv=GpuEquirectangularMap_uv(256,mode,64,128,ratio);"
        "if(uv<0){return uv;}return GpuEquirectangularMap_rgba(uv,1024,128,64);}\n"
        "if(op==2){return GpuEquirectangularMap_face(mode,64,128,0.5);}\n"
        "if(op==3){return GpuEquirectangularMap_cubeMode(mode);}\n"
        "if(op==4 && mode==0){return GpuEquirectangular_reflection();}\n"
        "if(op==4 && mode==1){return GpuEquirectangular_refraction();}\n"
        "return 0-1;\n";
    if(sy_write_file(layout,abi,sizeof abi-1,0600) || sy_write_file(driver,source,sizeof source-1,0600)) return 1;
    char *args[]={"./ujs/ujs2wasm.com",layout,"ujs/practice/uxe/base/f64-math.ujs",
        "ujs/practice/uxe/base/gpu-cube-map.ujs","ujs/practice/uxe/base/gpu-cube-map-generated.ujs",
        "ujs/practice/uxe/base/gpu-equirectangular-map-generated.ujs",
        "ujs/practice/uxe/base/gpu-equirectangular-map.ujs",driver,"-o",wasm,0};
    char *out=0;
    size_t bytes=0;
    int rc=cx_runv_timeout(args,8,&out,&bytes);
    if(rc) printf("EQUIRECTANGULAR_MAP_BUILD rc=%d output=%.*s\n",rc,(int)bytes,out);
    mm_free(out);
    return rc;
}

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[460],url[840];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","ujs-equirectangular-",dir,sizeof dir)) return 2;
    int n=tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/gpu-equirectangular-map-r160.html?dir=%s%s",
        cwd,dir,mutate?"&mutate=1":"");
    // Stable bands for mapped (x, y, z), with normal components 3/5 and 4/5.
    // The face ids are +X, -Z, +Y, -Z, -X for render-target cubemaps.
    const double gold[]={100,115,73,255, 60,115,66,255, 140,215,98,255, 60,65,57,255, 180,115,87,255,1,
        100,115,73,255, 60,115,66,255, 140,215,98,255, 60,65,57,255, 180,115,87,255,
        0,5,2,5,1, -3,-2,-1,1,1};
    enum { count=sizeof gold/sizeof gold[0] };
    double values[count]={0};
    int failed=n<0 || n>=sizeof url || gpu_equirectangular_compile(dir) || r160_wait_read(url,"#r160",values,count,dir);
    for(int i=0;!failed && i<count;i++) if(values[i]!=gold[i]) {
        printf("EQUIRECTANGULAR_MAP case=%d actual=%.17g gold=%.17g\n",i,values[i],gold[i]);
        failed=1;
    }
    if(sy_remove_all(dir)) failed=1;
    printf("G_PIXEL Equirectangular reflection and refraction cases=%d failed=%d\n",count,failed);
    return failed;
}
