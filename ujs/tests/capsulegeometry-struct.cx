#pragma unisa use g_geometry
#pragma unisa use text.fmt
#pragma unisa use text.text

static double root(double square) {
    if(square==0) return 1;
    double result=1;
    for(int i=0;i<12;i++) result=(result+square/result)*0.5;
    return result;
}

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","geometry-buffers","lathegeometry","capsulegeometry",0};
    char source[512];
    tx_snprintf(source,sizeof source,"let mesh=GeometryBuffers_init(0,256,12,1024,30);"
        "return CapsuleGeometry_generate(mesh,2048,%d.0,2.0,1,1);",mutate?2:1);
    const double q=0.7071067811865475244;
    const double radius[]={0,q,1,1,q,0}, height[]={-2,-1-q,-1,1,1+q,2};
    double gold[128]={12,30};
    int at=2;
    for(int seam=0;seam<2;seam++) for(int i=0;i<6;i++) {
        double nr=0,ny=0;
        if(i>0) { nr=height[i]-height[i-1]; ny=radius[i-1]-radius[i]; }
        if(i<5) {
            nr+=height[i+1]-height[i]; ny+=radius[i]-radius[i+1];
            double length=root(nr*nr+ny*ny);
            nr/=length; ny/=length;
        }
        gold[at++]=0; gold[at++]=height[i]; gold[at++]=radius[i];
        gold[at++]=0; gold[at++]=ny; gold[at++]=nr;
        gold[at++]=seam; gold[at++]=i/5.0;
    }
    const int triangle[]={0,6,1,7,1,6};
    for(int i=0;i<5;i++) for(int j=0;j<6;j++) gold[at++]=i+triangle[j];
    return g_geometry_check("CapsuleGeometry","capsulegeometry",modules,source,gold,at,98);
}
