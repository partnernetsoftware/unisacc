#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"f64-math","vector-scalar","orbitcontrols","orbitcontrols-pan",0};
    const char *setup="let eye=0;let target=64;let right=96;let up=128;let c=256;"
        "let z=ux_f64_put(eye+16,10.0);let x=ux_f64_put(right,1.0);let y=ux_f64_put(up+8,1.0);"
        "let init=OrbitControls_init(c,eye,target,100.0);";
    #define PAN "let p=OrbitControls_panPerspective(c,right,up,1,10.0,20.0,90.0);"
    #define PLANE "let p=OrbitControls_panPerspective(c,right,up,0,10.0,20.0,90.0);"
    #define ORTHO "let p=OrbitControls_panOrthographic(c,right,up,1,10.0,20.0,0.1,0.08);"
    #define STEP "let frame=OrbitControls_step(c);"
    #define DAMP "let damp=ux_f64_put(c+OrbitControls.damping,0.25);"
    const char *cases[]={
        PAN STEP "return ux_f64(c+OrbitControls.targetX);",
        PAN STEP "return ux_f64(c+OrbitControls.targetY);",
        PAN STEP "return ux_f64(c+OrbitControls.x);",
        PLANE STEP "return ux_f64(c+OrbitControls.targetZ);",
        ORTHO STEP "return ux_f64(c+OrbitControls.targetX);",
        ORTHO STEP "return ux_f64(c+OrbitControls.targetY);",
        DAMP PAN STEP "return ux_f64(c+OrbitControls.targetY);",
        DAMP PAN STEP "let next=OrbitControls_step(c);return ux_f64(c+OrbitControls.targetY);",
        "return 0.0+OrbitControls_panPerspective(c,right,up,1,1.0,1.0,180.0);",
    };
    const double gold[]={-2,4,-2,-4,-1,1.6,1,1.75,-1};
    return g_wasm_batch_addon("G_RAY OrbitControls pan","orbitcontrols-pan",argv[1],modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,PLANE STEP "return ux_f64(c+OrbitControls.targetY);");
}
