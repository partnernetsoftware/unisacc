#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"helper-geometry","planehelper",0};
    const char *setup="let helper=0;let outline=128;let fill=256;let matrix=384;"
        "let a=PlaneHelper_init(helper,outline,fill,4.0,16776960);"
        "let b=PlaneHelper_updateMatrixWorld(helper,matrix,0.6,0.0,0.8,3.0);";
    const char *cases[]={
        "return 0.0+ux_u32(helper+PlaneHelper.outlineCount);",
        "return 0.0+ux_u32(helper+PlaneHelper.fillCount);",
        "return ux_f32(outline+12);",
        "return ux_f32(fill+64);",
        "return 0.0+ux_u32(helper+PlaneHelper.color);",
        "return ux_f64(matrix);",
        "return ux_f64(matrix+16);",
        "return ux_f64(matrix+40);",
        "return ux_f64(matrix+96);",
        "return ux_f64(matrix+112);",
        "let a=PlaneHelper_updateMatrixWorld(helper,matrix,0.0,1.0,0.0,2.0);return ux_f64(matrix+80);",
        "let a=PlaneHelper_updateMatrixWorld(helper,matrix,0.0,0.0,0.0,2.0);return ux_f64(matrix+112);",
        "let a=PlaneHelper_dispose(helper);return 0.0+ux_u32(helper+PlaneHelper.active);",
        "let a=PlaneHelper_dispose(helper);return 0.0+PlaneHelper_updateMatrixWorld(helper,matrix,0.6,0.0,0.8,3.0);",
        "return 0.0+PlaneHelper_updateMatrixWorld(helper,outline,0.6,0.0,0.8,3.0);",
    };
    const double gold[]={8,6,-1,-1,16776960,1.6,-1.2,2,-1.8,-2.4,0.0000999999995,-2,0,-1,-1};
    return g_wasm_batch("G_STRUCT PlaneHelper","planehelper",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?8:-1,"return ux_f64(matrix+112);");
}
