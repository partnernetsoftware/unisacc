#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"transformcontrols-translate",0};
    const char *setup="let pos=32;let parent=64;let start=96;let end=128;let out=160;"
        "let x=ux_f64_put(pos,1.25);let y=ux_f64_put(pos+8,0.0-1.25);let z=ux_f64_put(pos+16,3.25);"
        "let px=ux_f64_put(parent,0.25);let py=ux_f64_put(parent+8,0.25);let pz=ux_f64_put(parent+16,0.25);"
        "let ex=ux_f64_put(end,1.0);let ey=ux_f64_put(end+8,0.0-0.5);let ez=ux_f64_put(end+16,2.25);";
    #define MOVE "let move=TransformControls_translate(out,pos,parent,start,end,"
    #define READ_X "return ux_f64(out);"
    #define READ_Y "return ux_f64(out+8);"
    #define READ_Z "return ux_f64(out+16);"
    const char *cases[]={
        MOVE "1,0.0);" READ_X,
        MOVE "1,0.0);" READ_Y,
        MOVE "4,0.0);" READ_Z,
        MOVE "3,1.0);" READ_X,
        MOVE "3,1.0);" READ_Y,
        MOVE "3,1.0);" READ_Z,
        MOVE "4,2.0);" READ_Z,
        "let move=TransformControls_translate(pos,pos,parent,start,end,3,1.0);return ux_f64(pos);",
        "return 0.0+TransformControls_translate(out,pos,parent,start,end,8,0.0);",
        "let mark=ux_f64_put(out,47.0);let bad=ux_f64_put(end+8,1.0/0.0);"
          MOVE "3,1.0);" READ_X,
    };
    const double gold[]={2.25,-1.25,5.5,2.75,-1.25,3.25,5.75,2.75,-1,47};
    return g_wasm_batch_addon("G_RAY TransformControls world translation","transformcontrols-translate",
        argv[1],modules,setup,cases,gold,sizeof gold/sizeof gold[0],mutate?3:-1,MOVE "3,0.0);" READ_X);
}
