#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

#define RGBA(r,g,b,a) ((r)+256.0*(g)+65536.0*(b)+16777216.0*(a))
#define FRAME_SET \
    RGBA(240,64,128,240),RGBA(40,64,128,80),RGBA(40,64,128,80), \
    RGBA(226,16,64,240),RGBA(6,16,64,80),RGBA(6,16,64,80), \
    RGBA(182,16,64,208),RGBA(50,16,64,112),RGBA(6,16,64,80)

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if((argc!=2 && !mutate) || argv[1][0]!='/') return 2;
    char dir[256],cwd[390],abi[300],wasm[300],url[720];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-filter-gpu-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/filter.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/ujs/practice/uxe/test/effectcomposer-filter-gpu-r160.html?package=%s&wasm=%s&mode=%d",
        cwd,argv[1],wasm,mutate);
    const char entry[]="import host_gpu_submit from \"uxe_gpu_v1\"(i64,i64) i64;\nexport uxe_filter_gpu(mode:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,"ujs/practice/uxe/base/record-copy.ujs",
        "ujs/practice/uxe/base/gpu-packet.ujs","ujs/practice/uxe/base/gpu-target.ujs","ujs/practice/uxe/base/gpu-state.ujs",
        "ujs/practice/uxe/base/effectcomposer.ujs","ujs/practice/uxe/base/effectcomposer-gpu-targets.ujs",
        "ujs/practice/uxe/base/f64-math.ujs","ujs/practice/uxe/base/postprocess-rgba8.ujs",
        "ujs/practice/uxe/base/effectcomposer-filter-gpu.ujs","ujs/practice/uxe/test/effectcomposer-filter-gpu-probe.ujs","-o",wasm,0};
    const double gold[]={FRAME_SET,FRAME_SET};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    char *output=0;
    size_t bytes=0;
    int failed=length<0 || length>=(int)sizeof url || sy_write_file(abi,entry,sizeof entry-1,0600);
    if(!failed) {
        const int rc=cx_runv_timeout(compile,6,&output,&bytes);
        if(rc) { printf("G_PIXEL EffectComposer filter compiler_rc=%d %s\n",rc,output?output:""); failed++; }
        mm_free(output); output=0;
    }
    if(!failed) failed=r160_wait_read(url,"#r160",actual,count,dir);
    if(!failed) for(int i=0;i<count;i++) if(actual[i]!=gold[i]) {
        printf("G_PIXEL EffectComposer filter case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
        failed++;
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&output,&bytes)) failed++;
    mm_free(output);
    printf("G_PIXEL EffectComposer filter cases=%d failed=%d\n",count,failed);
    return failed!=0;
}
