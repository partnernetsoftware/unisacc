#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","buffergeometry",0};
    const char *setup="let g=BufferGeometry_init(0,64,4,128,4);let initially=BufferGeometry_getIndex(g);"
        "let count=ux_u32(g+BufferGeometry.drawCount);"
        "let p=224;let data=ux_u32_put(p+BufferAttribute.data,320);let n=ux_u32_put(p+BufferAttribute.count,3);"
        "let k=ux_u32_put(p+BufferAttribute.componentType,9);let stride=ux_u32_put(p+BufferAttribute.stride,12);"
        "let size=ux_u32_put(p+BufferAttribute.itemSize,3);"
        "let x0=ux_f32_put(320,0.0-1.0);let x1=ux_f32_put(332,3.0);let y2=ux_f32_put(348,4.0);"
        "let registered=BufferGeometry_setAttribute(g,1,p);let indexed=BufferGeometry_setIndex(g,256);"
        "let gr0=BufferGeometry_addGroup(g,0,3,2);let gr1=BufferGeometry_addGroup(g,3,3,1);"
        "let draw=BufferGeometry_setDrawRange(g,1,2);"
        "let box=BufferGeometry_computeBoundingBox(g,1,400);let ball=BufferGeometry_computeBoundingSphere(g,1,448);";
    const char *cases[]={
        "return initially<0;","return count==4294967295;",
        "return BufferGeometry_hasAttribute(g,1);","return BufferGeometry_getAttribute(g,1)==p;",
        "return BufferGeometry_getIndex(g)==256;","return ux_u32(128);","return ux_u32(144);","return ux_u32(148);",
        "return ux_u32(g+BufferGeometry.drawStart);","return ux_u32(g+BufferGeometry.drawCount);",
        "return ux_f64(400);","return ux_f64(432);","return ux_f64(448);","return ux_f64(472);",
        "let e=BufferGeometry_clearGroups(g);return ux_u32(128);",
        "let e=BufferGeometry_deleteAttribute(g,1);return BufferGeometry_hasAttribute(e,1);",
        "let e=BufferGeometry_setIndex(g,0-1);return BufferGeometry_getIndex(e)<0;"
    };
    const double gold[]={1,1,1,1,1,2,2,3,1,2,-1,4,1,2.8284271247461903,0,0,1};
    return g_math_run("G_STRUCT BufferGeometry","buffergeometry",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?11:-1,"return ux_f64(424);");
}
