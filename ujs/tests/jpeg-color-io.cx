#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    int mutate_loader=argc==2 && tx_eqz(argv[1],"--mutate-loader");
    if(argc!=1 && !mutate && !mutate_loader) return 2;
    const char *modules[]={"f64-math","jpeg-header","jpeg-entropy","jpeg-idct","jpeg-gray","jpeg-color",
        "record-copy","loadingmanager","fileloader","image-layout","image-file","imageloader-jpeg",0};
    unsigned char bytes[160];
    int size=0;
    const unsigned char quant[]={255,216,255,219,0,67,0};
    for(int i=0;i<7;i++) bytes[size++]=quant[i];
    for(int i=0;i<64;i++) bytes[size++]=8;
    const unsigned char sof[]={255,192,0,17,8,0,3,0,2,3,1,17,0,2,17,0,3,17,0,255,196,0,39};
    for(int i=0;i<23;i++) bytes[size++]=sof[i];
    bytes[size++]=0; bytes[size++]=1; bytes[size++]=1;
    for(int i=0;i<14;i++) bytes[size++]=0;
    bytes[size++]=0; bytes[size++]=6;
    bytes[size++]=16; bytes[size++]=1;
    for(int i=0;i<15;i++) bytes[size++]=0;
    const unsigned char ending[]={0,255,218,0,12,3,1,0,2,0,3,0,0,63,0,40,19,239,255,217};
    for(int i=0;i<20;i++) bytes[size++]=ending[i];
    char setup[1000];
    int n=tx_snprintf(setup,sizeof setup,"let size=%d;let bytes=[",size);
    for(int i=0;i<size;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",bytes[i]);
    tx_snprintf(setup+n,sizeof setup-n,"];let i=0;while(i<size){let a=ux_u8_put(i,bytes[i]);i=i+1;}"
        "let manager=LoadingManager_init(256);let file=FileLoader_init(288,manager);let id=FileLoader_begin(file,320);");
    #define RECEIVE "let received=FileLoader_receive(file,id,200,0,size,320);"
    #define LOAD "let image=ImageLoader_decodeJpeg(file,448,512,24,1024,2048);"
    const char *cases[]={
        "return 0.0+JpegDecode_color444(0,size,512,24,1024,2048);",
        "let n=JpegDecode_color444(0,size,512,24,1024,2048);return 0.0+ux_u8(512);",
        "let n=JpegDecode_color444(0,size,512,24,1024,2048);return 0.0+ux_u8(513);",
        "let n=JpegDecode_color444(0,size,512,24,1024,2048);return 0.0+ux_u8(534);",
        "let n=JpegDecode_color444(0,size,512,24,1024,2048);return 0.0+ux_u8(535);",
        "return 0.0+JpegDecode_color444(0,size-1,512,24,1024,2048);",
        "let a=ux_u8_put(size-3,238);return 0.0+JpegDecode_color444(0,size,512,24,1024,2048);",
        "let guard=ux_u8_put(512,79);let a=ux_u8_put(size-3,238);let n=JpegDecode_color444(0,size,512,24,1024,2048);return 0.0+ux_u8(512);",
        "let a=ux_u8_put(82,34);return 0.0+JpegDecode_color444(0,size,512,24,1024,2048);",
        RECEIVE LOAD "if(image<0){return 0.0+image;}return 0.0+ux_u32(image+ImageResource.width);",
        RECEIVE LOAD "if(image<0){return 0.0+image;}return 0.0+ux_u32(image+ImageResource.rowBytes);",
        "let g=ux_u32_put(448+ImageResource.width,77);" RECEIVE
        "let corrupt=ux_u8_put(size-3,238);" LOAD "return 0.0+ux_u32(448+ImageResource.width);",
        RECEIVE "let released=FileLoader_release(file,id);" LOAD "return 0.0+image;"
    };
    const double gold[]={24,83,140,185,255,-6,-6,79,-4,2,8,77,-1};
    return g_wasm_batch("G_IO JpegColor444","jpeg-color",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate_loader?10:mutate?1:-1,
        mutate_loader?RECEIVE LOAD "return 0.0+ux_u32(image+ImageResource.width);":
        "let n=JpegDecode_color444(0,size,512,24,1024,2048);return 0.0+ux_u8(514);");
}
