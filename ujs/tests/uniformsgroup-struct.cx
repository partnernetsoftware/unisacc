#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","uniform","eventdispatcher","uniformsgroup",0};
    const char *setup="let g=UniformsGroup_init(0,128,4);let initial=ux_u32(g+UniformsGroup.count);"
        "let usage0=ux_u32(g+UniformsGroup.usage);let a=Uniform_init(200,7);let b=Uniform_init(208,11);"
        "let x=UniformsGroup_add(g,a);let y=UniformsGroup_add(g,b);let z=UniformsGroup_add(g,a);"
        "let s=UniformsGroup_remove(g,a);let n=UniformsGroup_setName(g,91);let u=UniformsGroup_setUsage(g,35048);"
        "let c=UniformsGroup_init(48,160,4);let a1=Uniform_clone(216,a,0-1);let b1=Uniform_clone(224,b,0-1);"
        "let v0=ux_u32_put(240,b1);let v1=ux_u32_put(244,a1);let copy=UniformsGroup_clone(c,g,240);"
        "let e=EventDispatcher_init(g,280,4);let l=EventDispatcher_addEventListener(e,1,10);";
    const char *cases[]={
        "return initial;","return usage0;","return ux_u32(g+UniformsGroup.count);","return ux_u32(ux_u32(132));",
        "return ux_u32(g+UniformsGroup.name)==91;","return ux_u32(g+UniformsGroup.usage);",
        "return ux_u32(ux_u32(164));","return ux_u32(132)!=ux_u32(164);",
        "return UniformsGroup_dispose(g,1,7,352,4);"
    };
    const double gold[]={0,35044,2,11,1,35048,11,1,1};
    return g_math_run("G_STRUCT UniformsGroup","uniformsgroup",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,"return ux_u32(ux_u32(136));");
}
