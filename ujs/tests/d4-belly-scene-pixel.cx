#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[390],abdomen[300],gear[300],merge[300],gait[300],url[740];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-d4-belly-scene-",dir,sizeof dir)) return 2;
    tx_snprintf(abdomen,sizeof abdomen,"%s/a.wasm",dir);
    tx_snprintf(gear,sizeof gear,"%s/b.wasm",dir);
    tx_snprintf(merge,sizeof merge,"%s/c.wasm",dir);
    tx_snprintf(gait,sizeof gait,"%s/d.wasm",dir);
    int length=tx_snprintf(url,sizeof url,
        "file://%s/ujs/practice/uxe/test/d4-belly-scene-r160.html?abdomen=file://%s&gear=file://%s&merge=file://%s&gait=file://%s&mutate=%d",
        cwd,abdomen,gear,merge,gait,mutate);
    char *abd[]={"./ujs/ujs2wasm.com","ujs/practice/uxe/products/d4/d4-abdomen-api.ujs",
        "ujs/practice/uxe/products/d4/d4-abdomen.ujs","-o",abdomen,0};
    char *cog[]={"./ujs/ujs2wasm.com","ujs/practice/uxe/products/d4/d4-main-gear-api.ujs",
        "ujs/practice/uxe/base/f64-math.ujs","ujs/practice/uxe/products/d4/d4-main-gear.ujs","-o",gear,0};
    char *all[]={"./ujs/ujs2wasm.com","ujs/practice/uxe/products/d4/d4-belly-scene-api.ujs",
        "ujs/practice/uxe/base/record-copy.ujs","ujs/practice/uxe/products/d4/d4-belly-scene.ujs","-o",merge,0};
    char *pose[]={"cx","ujs/practice/uxe/products/d4/build.cx","--",gait,0};
    char **commands[]={abd,cog,all,pose};
    const double gold[]={5,145,76800,0,0,0,0,4,1};
    double values[9]={0};
    char *out=0;
    size_t bytes=0;
    int failed=length<0 || length>=(int)sizeof url;
    for(int i=0;!failed && i<4;i++) {
        const int rc=cx_runv_timeout(commands[i],12,&out,&bytes);
        if(rc) { printf("D4_BELLY_SCENE build=%d rc=%d %s\n",i,rc,out?out:""); failed=1; }
        mm_free(out); out=0;
    }
    if(!failed) {
        failed=r160_wait_read(url,"#result",values,9,dir);
        if(!failed) {
            printf("D4_BELLY_SCENE frames=%.0f records=%.0f pixels=%.0f count_diff=%.0f field_diff=%.0f pixel_diff=%.0f tail_diff=%.0f refusals=%.0f\n",
                values[0],values[1],values[2],values[3],values[4],values[5],values[6],values[7]);
            for(int i=0;i<9;i++) if(values[i]!=gold[i]) {
                printf("D4_BELLY_SCENE field=%d actual=%.17g gold=%.17g\n",i,values[i],gold[i]);
                failed=1;
            }
        }
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&out,&bytes)) failed=1;
    mm_free(out);
    printf("D4_BELLY_SCENE failed=%d\n",failed);
    return failed;
}
