#pragma unisa use g_math
#pragma unisa use text.text

static double json_hash(const char *text) {
    uint64_t result=0;
    for(int i=0;text[i];i++) result=(result*131+(unsigned char)text[i])%16777213;
    return (double)result;
}

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    int meta_mutate=argc==2 && tx_eqz(argv[1],"--meta-mutate");
    if(argc!=1 && !mutate && !meta_mutate) return 2;
    const char *modules[]={"object-layouts","object-json-tokens","json-bytes","source","source-json",0};
    const char *setup=
        "function bytes(count,...values){let i=0;while(i<count){let write=ux_u8_put(values[0]+i,values[i+1]);i=i+1;}return i;}"
        "function image(at,...values){let x=ux_u32_put(at+SourceImage.kind,values[0]);"
        "let y=ux_u32_put(at+SourceImage.data,values[1]);let z=ux_u32_put(at+SourceImage.count,values[2]);"
        "let w=ux_u32_put(at+SourceImage.width,values[3]);let h=ux_u32_put(at+SourceImage.height,values[4]);return at;}"
        "function hash(end){if(end<0){return end;}let h=0;let p=1024;"
        "while(p<end){h=(h*131+ux_u8(p))%16777213;p=p+1;}return h;}"
        "let id=bytes(5,64,97,115,115,101,116);let url=bytes(7,72,100,97,116,97,58,44,120);"
        "let pixels=bytes(2,80,7,255);let typed=image(128,1,80,2,2,1);let encoded=image(192,11,72,7,0,0);"
        "let faces=image(256,12,320,2,0,0);let face0=ux_u32_put(320,encoded);let face1=ux_u32_put(324,typed);"
        "let s=Source_init(0,0);";
    const char *cases[]={
        "let end=Source_toJSON(s,1024,2048,64,5,4096);return hash(end);",
        "let t=Source_setData(s,typed,1);let end=Source_toJSON(t,1024,2048,64,5,4096);return hash(end);",
        "let t=Source_setData(s,encoded,1);let end=Source_toJSON(t,1024,2048,64,5,4096);return hash(end);",
        "let t=Source_setData(s,faces,1);let end=Source_toJSON(t,1024,2048,64,5,4096);return hash(end);",
        "return Source_toJSON(s,1024,1035,64,5,4096);",
        "let t=Source_setData(s,typed,1);return Source_toJSON(t,80,128,64,5,4096);",
        "let t=Source_setData(s,typed,1);let row=Source_toJSONMeta(t,1024,2048,64,5,4096,512,1);"
        "let changed=Source_setData(s,encoded,1);let hit=Source_toJSONMeta(changed,2048,3072,64,5,4096,512,1);"
        "return hash(ux_u32(hit+8)+ux_u32(hit+12));",
        "let row=Source_toJSONMeta(s,1024,2048,64,5,4096,512,1);"
        "let alt=bytes(5,88,111,116,104,101,114);return Source_toJSONMeta(s,2048,3072,88,5,4096,512,1);"
    };
    const double gold[]={
        json_hash("{\"uuid\":\"asset\",\"url\":\"\"}"),
        json_hash("{\"uuid\":\"asset\",\"url\":{\"data\":[7,255],\"width\":2,\"height\":1,\"type\":\"Uint8Array\"}}"),
        json_hash("{\"uuid\":\"asset\",\"url\":\"data:,x\"}"),
        json_hash("{\"uuid\":\"asset\",\"url\":[\"data:,x\",{\"data\":[7,255],\"width\":2,\"height\":1,\"type\":\"Uint8Array\"}]}"),
        -1,-1,json_hash("{\"uuid\":\"asset\",\"url\":{\"data\":[7,255],\"width\":2,\"height\":1,\"type\":\"Uint8Array\"}}"),-1
    };
    return g_math_run("G_STRUCT Source toJSON","source-json",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],meta_mutate?6:mutate?1:-1,
        meta_mutate?"let t=Source_setData(s,encoded,1);let end=Source_toJSON(t,1024,2048,64,5,4096);return hash(end);":
        "let x=ux_u8_put(80,9);let t=Source_setData(s,typed,1);"
        "let end=Source_toJSON(t,1024,2048,64,5,4096);return hash(end);");
}
