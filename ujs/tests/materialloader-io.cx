#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","json-read","loader-json","materialloader",0};
    const char json[]="{\"type\":\"MeshStandardMaterial\",\"color\":4227200,\"opacity\":0.5,\"roughness\":0.25,"
        "\"metalness\":0.75,\"transparent\":true}";
    char setup[1400];int size=sizeof json-1;
    int n=tx_snprintf(setup,sizeof setup,"let size=%d;let json=[",size);
    for(int i=0;i<size;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[i]);
    tx_snprintf(setup+n,sizeof setup-n,"];let i=0;while(i<size){let b=ux_u8_put(256+i,json[i]);i=i+1;}"
        "let manager=LoadingManager_init(0);let file=FileLoader_init(32,manager);let id=FileLoader_begin(file,64);"
        "let ready=FileLoader_receive(file,id,200,256,size,64);");
    const char *cases[]={
        "let m=MaterialLoader_parse(file,512,600);return ux_u32(m+LoadedMaterial.kind);",
        "let m=MaterialLoader_parse(file,512,600);return ux_u32(m+LoadedMaterial.srgbHex);",
        "let m=MaterialLoader_parse(file,512,600);return ux_f64(m+LoadedMaterial.opacity);",
        "let m=MaterialLoader_parse(file,512,600);return ux_f64(m+LoadedMaterial.roughness);",
        "let m=MaterialLoader_parse(file,512,600);return ux_f64(m+LoadedMaterial.metalness);",
        "let m=MaterialLoader_parse(file,512,600);return ux_u32(m+LoadedMaterial.transparent);",
        "let bad=ux_u8_put(256+size-1,93);return MaterialLoader_parse(file,512,600);",
        "let bad=ux_u8_put(265,88);return MaterialLoader_parse(file,512,600);"
    };
    const double gold[]={2,4227200,0.5,0.25,0.75,1,-2,-3};
    return g_math_run("G_IO MaterialLoader","materialloader",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let m=MaterialLoader_parse(file,512,600);return ux_f64(m+LoadedMaterial.roughness);");
}
