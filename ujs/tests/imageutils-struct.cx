#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    int canvas_mutate=argc==2 && tx_eqz(argv[1],"--canvas-mutate");
    if(argc!=1 && !mutate && !canvas_mutate) return 2;
    const char *modules[]={"f64-math","vector-scalar","color","imageutils",0};
    const char *setup="let a0=ux_u8_put(0,0);let a1=ux_u8_put(1,128);let a2=ux_u8_put(2,255);let a3=ux_u8_put(3,10);"
        "let b0=ux_f32_put(8,0.5);let b1=ux_f32_put(12,0.01);"
        "let r=ImageUtils_sRGBToLinear(32,0,4,1);let f=ImageUtils_sRGBToLinear(40,8,2,9);"
        "let s=ux_u8_put(64,68);let x=ux_u8_put(65,65);let y=ux_u8_put(66,84);"
        "let z=ux_u8_put(67,65);let sep=ux_u8_put(68,58);"
        "let c0=ux_u8_put(80,10);let c1=ux_u8_put(81,128);let c2=ux_u8_put(82,255);let c3=ux_u8_put(83,255);"
        "let canvas=ImageUtils_canvasToLinear(96,80,4);let clamped=ImageUtils_sRGBToLinear(112,80,4,3);";
    const char *cases[]={"return ux_u8(r);","return ux_u8(r+1);","return ux_u8(r+2);","return ux_u8(r+3);",
        "return ux_f32(f);","return ux_f32(f+4);","return ux_u8(1);","return ImageUtils_getDataURL(64,5)==64;",
        "return ux_u8(canvas);","return ux_u8(canvas+1);","return ux_u8(canvas+2);","return ux_u8(canvas+3);",
        "return ux_u8(clamped);","return ImageUtils_canvasToLinear(96,80,3);"};
    const double gold[]={0,55,255,0,(double)(float)0.2140411404715882,
        (double)(float)((double)(float)0.01*0.0773993808),128,1,1,55,255,255,0,-1};
    return g_math_run("G_STRUCT ImageUtils","imageutils",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],canvas_mutate?8:mutate?1:-1,
        canvas_mutate?"return ux_u8(clamped);":"return ux_u8(1);");
}
