#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","loadingmanager","fileloader","audioloader",
        "audio-buffer-playback","audio-analyser-window","audio-spectrum","audio-spectrum-cache",0};
    const char *setup="let state=0;let ring=128;let pcm=512;let history=1024;let work=2048;let cache=3072;let out=3584;"
        "let ready=AudioAnalyser_initWindow(state,ring,32);let reset=AudioAnalyser_resetSpectrum(cache);let i=0;"
        "while(i<32){let p=ux_f32_put(pcm+i*4,0.5);i=i+1;}"
        "let fed=AudioAnalyser_pushWindow(state,pcm,32);"
        "let a=ux_u8_put(out,118);let b=ux_u8_put(out+1,101);let c=ux_u8_put(out+2,43);";
    #define FIRST "let count=AudioAnalyser_spectrumFrame(state,cache,history,work,512,128,0.5);"
    #define AGAIN "let selected=AudioAnalyser_spectrumFrame(state,cache,history,work,512,128,0.5);"
    #define LATER "let selected=AudioAnalyser_spectrumFrame(state,cache,history,work,512,256,0.5);"
    #define VALUE "return 0.0+f64_floor_i64(ux_f64(history+8)*1000000.0+0.5);"
    const char *cases[]={
        FIRST VALUE,
        FIRST AGAIN VALUE,
        FIRST LATER VALUE,
        FIRST AGAIN "return 0.0+selected;",
        FIRST "return 0.0+AudioAnalyser_spectrumFrame(state,cache,history,work,512,127,0.5);",
        FIRST "let bad=AudioAnalyser_spectrumFrame(state,cache,history,work,511,256,0.5);"
        "return 0.0+(bad==0-1 && ux_u32(cache+AudioSpectrumCache.frame)==128);",
        "return AudioAnalyser_averageFrequency(out,16);",
        "return AudioAnalyser_averageFrequency(out,15);",
    };
    const double gold[]={62500,62500,93750,0,-2,1,16.375,-1};
    return g_wasm_batch_page("G_IO AudioAnalyser frame cache","audio-spectrum-cache",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,FIRST LATER VALUE);
}
