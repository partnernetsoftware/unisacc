#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"scene-rgba8-blend",0};
    const char *cases[]={
        "return 0.0+SceneRaster_sourceOver(4294901760,2147483903);",
        "return 0.0+SceneRaster_sourceOver(2164195328,2147483903);",
        "return 0.0+SceneRaster_sourceOver(4278190335,65280);",
        "return 0.0+SceneRaster_sourceOver(16711680,2147483903);",
        "return 0.0+SceneRaster_sourceOver(4278190335,4278255360);",
        "return 0.0+SceneRaster_sourceOver(4294967296,0);",
        "return 0.0+SceneRaster_sourceOver(0,0-1);",
    };
    // Independent calculation in normalized real-valued channels.
    const double alpha=128.0/255.0;
    const double overlap=alpha+alpha*(1.0-alpha);
    const int red=(int)(255.0*alpha/overlap+0.5);
    const int blue=(int)(255.0*alpha*(1.0-alpha)/overlap+0.5);
    const int opacity=(int)(255.0*overlap+0.5);
    const double gold[]={
        4278190080.0+128.0+127.0*65536.0,
        (double)opacity*16777216.0+(double)blue*65536.0+red,
        4278190335.0,2147483903.0,4278255360.0,-1,-1,
    };
    return g_wasm_batch_page("G_STRUCT software source over","scene-rgba8-blend",
        "ujs/practice/uxe/test/wasm-batch.html",modules,"",cases,gold,7,mutate?1:-1,
        "return 0.0+SceneRaster_sourceOver(2147483903,2164195328);");
}

