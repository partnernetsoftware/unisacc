#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d","bone","skeleton-layout","skeleton",0};
    const char *setup=
        "let arena=Object3D_initArena(0,2);let a=Bone_create(arena);let b=Bone_create(arena);"
        "let x=ux_u32(Object3D_address(arena,a)+Object3D.worldMatrix)+96;"
        "let y=ux_u32(Object3D_address(arena,b)+Object3D.worldMatrix)+104;"
        "let ax=ux_f64_put(x,2.0);let by=ux_f64_put(y,5.0);"
        "let h0=ux_u32_put(1088,a);let h1=ux_u32_put(1092,b);"
        "let skeleton=Skeleton_init(1024,1088,1152,1472,2);"
        "let bind=Skeleton_calculateInverses(skeleton,arena);"
        "let rx=ux_f64_put(x,3.0);let ry=ux_f64_put(y,8.0);"
        "let palette=Skeleton_update(skeleton,arena,1664);";
    const char *cases[]={
        "return ux_f64(1152+96);","return ux_f64(1280+104);",
        "return ux_f32(palette+48);","return ux_f32(palette+64+52);",
        "let stale=ux_u32_put(1092,65540);return Skeleton_update(skeleton,arena,1664);",
        "return Skeleton_update(skeleton,arena,1472);"
    };
    const double gold[]={-2,-5,1,3,-1,-1};
    return g_math_run("G_STRUCT Skeleton","skeleton",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?3:-1,"return ux_f32(palette+52);");
}
