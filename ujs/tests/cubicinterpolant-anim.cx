#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","animation-view","discreteinterpolant","cubicinterpolant",0};
    const char *setup=
        "let a=ux_f32_put(64,0.0);let b=ux_f32_put(68,2.0);let c=ux_f32_put(72,4.0);"
        "let d=ux_f32_put(128,0.0);let e=ux_f32_put(132,4.0);let f=ux_f32_put(136,0.0);"
        "let view=AnimationSamples_init(0,64,128,3,1);";
    const char *cases[]={
        "let p=CubicInterpolant_evaluate(view,1.0,192,2400,2400);return ux_f32(p);",
        "let p=CubicInterpolant_evaluate(view,1.0,192,2401,2400);return ux_f32(p);",
        "let p=CubicInterpolant_evaluate(view,1.0,192,2402,2400);return ux_f32(p);",
        "let p=CubicInterpolant_evaluate(view,3.0,192,2400,2400);return ux_f32(p);",
        "let p=CubicInterpolant_evaluate(view,3.0,192,2400,2401);return ux_f32(p);",
        "let p=CubicInterpolant_evaluate(view,3.0,192,2400,2402);return ux_f32(p);",
        "let p=CubicInterpolant_evaluate(view,5.0,192,2400,2400);return ux_f32(p);",
        "return CubicInterpolant_evaluate(view,1.0,192,0,2400);"
    };
    // For the end ZeroSlope interval, the virtual following sample is the
    // final value (zero). Only the lower sample's weight 9/16 contributes.
    const double gold[]={2.5,2,2,2.5,2.25,2,0,-1};
    return g_math_run("G_ANIM CubicInterpolant","cubicinterpolant",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let p=CubicInterpolant_evaluate(view,1.0,192,2400,2400);return ux_f32(p);");
}
