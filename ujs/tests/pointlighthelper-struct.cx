#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","geometry-buffers","spheregeometry","lighthelper-common","pointlighthelper",0};
    const char *setup="let helper=0;let mesh=128;let vertices=256;let indices=768;let matrix=896;"
        "let color=1024;let over=1088;"
        "let a=ux_f64_put(color,0.25);let b=ux_f64_put(color+8,0.5);"
        "let c=ux_f64_put(color+16,0.75);let d=ux_f64_put(over+16,0.125);"
        "let init=PointLightHelper_init(helper,mesh,vertices,indices,matrix,2.0,color,0-1);";
    const char *cases[]={
        "return 0.0+ux_u32(mesh+GeometryBuffers.vertexCount);",
        "return 0.0+ux_u32(mesh+GeometryBuffers.indexCount);",
        "return ux_f32(vertices+4);",
        "return ux_f32(vertices+5*32);",
        "return 0.0+ux_u32(indices+8);",
        "return ux_f64(helper+PointLightHelper.red);",
        "let moved=ux_f64_put(matrix+96,3.5);return ux_f64(ux_u32(helper+PointLightHelper.matrix)+96);",
        "let changed=ux_f64_put(color+8,0.375);let up=PointLightHelper_update(helper,color,0-1);return ux_f64(helper+PointLightHelper.green);",
        "let up=PointLightHelper_update(helper,color,over);return ux_f64(helper+PointLightHelper.blue);",
        "let gone=PointLightHelper_dispose(helper);return 0.0+ux_u32(helper+PointLightHelper.active);",
        "let gone=PointLightHelper_dispose(helper);return 0.0+PointLightHelper_update(helper,color,over);",
        "return 0.0+PointLightHelper_init(helper,mesh,vertices,indices,vertices,2.0,color,0-1);",
    };
    const double gold[]={15,24,2,-2,6,0.25,3.5,0.375,0.125,0,-1,-1};
    return g_wasm_batch("G_STRUCT PointLightHelper","pointlighthelper",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?8:-1,"let up=PointLightHelper_update(helper,color,0-1);return ux_f64(helper+PointLightHelper.blue);");
}
