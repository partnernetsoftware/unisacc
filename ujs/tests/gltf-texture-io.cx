#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","glb-container","json-read","loader-json","gltf-texture",0};
    #define MIME_PREFIX "{\"textures\":[{\"source\":0,\"sampler\":2}],\"images\":[{\"mimeType\":\"image/"
    const char json[]="{\"textures\":[{\"source\":0,\"sampler\":2}],\"images\":[{\"mimeType\":\"image/png\",\"bufferView\":0}],\"bufferViews\":[{\"buffer\":0,\"byteOffset\":4,\"byteLength\":8}]}";
    int bytes=sizeof json-1;
    char setup[1200];
    int n=tx_snprintf(setup,sizeof setup,"let json=[");
    for(int i=0;i<bytes;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[i]);
    tx_snprintf(setup+n,sizeof setup-n,
        "];let i=0;while(i<%d){let cell=ux_u8_put(128+i,json[i]);i=i+1;}"
        "let a=ux_u32_put(GlbResource.json,128);let b=ux_u32_put(GlbResource.jsonBytes,%d);"
        "let c=ux_u32_put(GlbResource.bin,512);let d=ux_u32_put(GlbResource.binBytes,12);"
        "let p=ux_u32_put(516,1196314761);let s=ux_u32_put(520,169478669);let mimeAt=%d;",
        bytes,bytes,128+(int)sizeof MIME_PREFIX-1);
    const char *cases[]={
        "let a=GltfLoader_textureSource(0,0,640,680);return ux_u32(a+GltfTextureSource.length);",
        "let a=GltfLoader_textureSource(0,0,640,680);return ux_u32(a+GltfTextureSource.mime);",
        "let a=GltfLoader_textureSource(0,0,640,680);return ux_u32(a+GltfTextureSource.sampler);",
        "let a=GltfLoader_textureSource(0,0,640,680);return ux_u8(ux_u32(a+GltfTextureSource.bytes));",
        "let bad=ux_u8_put(mimeAt,120);return GltfLoader_textureSource(0,0,640,680);",
        "let bad=ux_u32_put(GlbResource.binBytes,11);return GltfLoader_textureSource(0,0,640,680);",
        "let keep=ux_u32_put(640+GltfTextureSource.length,777);let bad=ux_u8_put(mimeAt,120);"
        "let rejected=GltfLoader_textureSource(0,0,640,680);return ux_u32(640+GltfTextureSource.length);"
    };
    const double gold[]={8,1,2,137,-3,-4,777};
    return g_math_run("G_IO GltfTextureSource","gltf-texture",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let a=GltfLoader_textureSource(0,0,640,680);return ux_u8(ux_u32(a+GltfTextureSource.bytes)+1);");
}
