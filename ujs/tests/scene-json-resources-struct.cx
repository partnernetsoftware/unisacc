#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define TEST "ujs/practice/uxe/test/"

static uint64_t digest(const char *json) {
    uint64_t hash=0;
    for(int i=0;json[i];i++) hash=(hash*131+(unsigned char)json[i])%16777213;
    return hash;
}

int main(int argc,char **argv) {
    const int negative=argc==2 && tx_eqz(argv[1],"--verify-negative");
    if(argc!=1 && !negative) return 2;
    const char *gold[]={
        "{\"background\":1122867,\"fog\":{\"type\":\"Fog\",\"name\":\"valley\",\"color\":3359829,\"near\":2,\"far\":24},\"environment\":\"env-map\",\"backgroundBlurriness\":0.25}",
        "{\"background\":\"sky-map\",\"fog\":{\"type\":\"FogExp2\",\"name\":\"\",\"color\":2241348,\"density\":0.125}}",
        "{}"
    };
    const char *mutated="{\"background\":1122867,\"fog\":{\"type\":\"Fog\",\"name\":\"valley\",\"color\":3359829,\"near\":2,\"far\":24},\"environment\":\"env-map\",\"backgroundBlurriness\":0.5}";
    char dir[240],wasm[300],cwd[380],url[840];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-scene-fields-",dir,sizeof dir)) return 2;
    tx_snprintf(wasm,sizeof wasm,"%s/scene.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/" TEST "scene-json-resources-r160.html?wasm=%s&mutate=%d",cwd,wasm,negative);
    char *compile[]={"/bin/sh","./ujs/ujs2wasm.com",TEST "scene-json-resources-abi.ujs",
        BASE "json-read.ujs",BASE "json-bytes.ujs",
        BASE "scene-json-resources.ujs",TEST "scene-json-resources-probe.ujs","-o",wasm,0};
    char *log=0;
    size_t size=0;
    int failed=length<0 || length>=(int)sizeof url;
    if(!failed) {
        const int rc=cx_runv_timeout(compile,6,&log,&size);
        if(rc) { printf("SCENE_RESOURCES compile_rc=%d %s\n",rc,log?log:""); failed=1; }
        mm_free(log);
    }
    double actual[6]={0};
    if(!failed) failed=r160_wait_read(url,"#r160",actual,6,dir);
    if(!failed) for(int i=0;i<3;i++) {
        const double reference=(double)digest(gold[i]);
        const double expected=(double)digest(negative && i==0?mutated:gold[i]);
        if(actual[i*2]!=reference || actual[i*2+1]!=expected) {
            printf("SCENE_RESOURCES case=%d r160=%g wasm=%g reference=%g expected=%g\n",
                i,actual[i*2],actual[i*2+1],reference,expected);
            failed++;
        }
    }
    if(sy_remove_all(dir)) failed=1;
    printf("G_STRUCT Scene resource JSON cases=3 negative_expected=%d failed=%d\n",negative,failed);
    return failed!=0;
}
