#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define ANALYSE(C) "let rendered=Audio_renderBuffer(player,block,128);" \
    "let seen=AudioAnalyser_pushInterleaved(state,block,rendered," #C ");" \
    "let count=AudioAnalyser_getByteTimeData(state,out,32);"

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","audioloader","audio-buffer-playback",
        "audio-analyser-window","audio-analyser-interleaved",0};
    const char *setup=
        "let state=0;let ring=128;let source=512;let block=1600;let out=2800;let player=2848;let resource=2880;"
        "let ready=AudioAnalyser_initWindow(state,ring,32);"
        "let a=ux_u32_put(resource+AudioResource.pcm,source);let b=ux_u32_put(resource+AudioResource.frames,128);"
        "let c=ux_u32_put(resource+AudioResource.channels,2);let d=ux_u32_put(resource+AudioResource.sampleRate,48000);"
        "let selected=Audio_setBuffer(player,resource);let start=Audio_playBuffer(player,0,0,0,128,1.0);"
        "let i=0;while(i<128){let l=1.0;let r=0.0-1.0;let phase=i%4;"
        "if(phase==1){l=0.5;r=0.0;}if(phase==2){l=0.0-0.5;r=0.0;}if(phase==3){l=0.25;r=0.75;}"
        "let a=ux_f32_put(source+i*8,l);let b=ux_f32_put(source+i*8+4,r);i=i+1;}";
    const char *cases[]={
        ANALYSE(2) "return 0.0+seen;",
        ANALYSE(2) "return 0.0+ux_u8(out);",
        ANALYSE(2) "return 0.0+ux_u8(out+1);",
        ANALYSE(2) "return 0.0+ux_u8(out+2);",
        ANALYSE(2) "return 0.0+ux_u8(out+3);",
        "let rejected=AudioAnalyser_pushInterleaved(state,ring,8,2);"
        "let read=AudioAnalyser_getByteTimeData(state,out,32);return 0.0+(rejected==0-1 && ux_u8(out)==128);",
    };
    const double gold[]={128,128,160,96,192,1};
    return g_wasm_batch_page("G_IO AudioAnalyser interleaved playback","audio-analyser-interleaved",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,6,mutate?1:-1,
        ANALYSE(1) "return 0.0+ux_u8(out);");
}

