#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","camera","perspectivecamera",
        "orthographiccamera","arraycamera","record-copy","camera-lifecycle",0};
    const char *setup="let camera=Camera_init(0,1024);let ortho=Camera_init(64,1536);"
        "let lens=PerspectiveCamera_init(256,60.0,2.0,1.0,150.0);"
        "let o_lens=OrthographicCamera_init(512,0.0-3.0,3.0,2.0,0.0-2.0,0.5,10.0);"
        "let oz=ux_f64_put(o_lens+OrthographicCamera.zoom,2.0);"
        "let view=PerspectiveCamera_setViewOffset(lens,800.0,400.0,200.0,100.0,400.0,200.0);"
        "let view_o=OrthographicCamera_setViewOffset(o_lens,800.0,400.0,200.0,100.0,400.0,200.0);"
        "let film=ux_f64_put(lens+PerspectiveCamera.filmOffset,0.75);"
        "let p=PerspectiveCamera_updateProjectionMatrix(lens,camera);"
        "let o=OrthographicCamera_updateProjectionMatrix(o_lens,ortho);"
        "let view_ptr=ux_u32(camera+Camera.projectionMatrix);"
        "let ortho_ptr=ux_u32(ortho+Camera.projectionMatrix);"
        "let arr0=ux_u32_put(640,1);let arr1=ux_u32_put(644,2);let arr=ArrayCamera_init(672,640,2);";
    const char *cases[]={
        "let copy=PerspectiveCamera_clone(4096,lens,2048,camera,2304);return ux_f64(copy+PerspectiveCamera.filmOffset);",
        "let copy=PerspectiveCamera_clone(4096,lens,2048,camera,2304);return ux_f64(copy+PerspectiveCamera.viewX);",
        "let copy=PerspectiveCamera_clone(4096,lens,2048,camera,2304);"
        "let target=ux_u32(2048+Camera.projectionMatrix);return ux_f64(target+64)-ux_f64(view_ptr+64);",
        "let copy=PerspectiveCamera_clone(4096,lens,2048,camera,2304);"
        "let changed=ux_f64_put(copy+PerspectiveCamera.viewX,25.0);return ux_f64(lens+PerspectiveCamera.viewX);",
        "let copy=OrthographicCamera_clone(4096,o_lens,2048,ortho,2304);return ux_f64(copy+OrthographicCamera.zoom);",
        "let copy=OrthographicCamera_clone(4096,o_lens,2048,ortho,2304);"
        "let target=ux_u32(2048+Camera.projectionMatrix);return ux_f64(target+40)-ux_f64(ortho_ptr+40);",
        "let new_camera=Camera_init(2048,2304);let copied=OrthographicCamera_copy(4096,o_lens,new_camera,ortho);"
        "return ux_f64(copied+OrthographicCamera.viewHeight);",
        "let cloned_array=ArrayCamera_clone(10200,4096,lens,2048,camera,2304);"
        "return ux_u32(cloned_array+ArrayCamera.count)+ux_u32(arr+ArrayCamera.count)*10;",
        "return PerspectiveCamera_clone(2304,lens,2048,camera,2304);"
    };
    const double gold[]={0.75,200,0,200,2,0,200,20,-1};
    return g_math_run("G_STRUCT Camera lenses lifecycle","camera-lifecycle",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let copy=PerspectiveCamera_clone(4096,lens,2048,camera,2304);return ux_f64(copy+PerspectiveCamera.viewWidth);");
}
