#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","animation-view","keyframe-track","animationclip","animationaction",0};
    const char *cases[]={
        "let a=AnimationAction_init(64,1.0,2200,1,1);return ux_u32(a+AnimationAction.loop);",
        "let a=AnimationAction_init(64,1.0,2201,1,1);return ux_u32(a+AnimationAction.loop);",
        "let a=AnimationAction_init(64,1.0,2202,1,1);return ux_u32(a+AnimationAction.loop);",
        "let a=AnimationClip_init(64,0,0,0,0,1.0,2500);return ux_u32(a+AnimationClip.blendMode);",
        "let a=AnimationClip_init(64,0,0,0,0,1.0,2501);return ux_u32(a+AnimationClip.blendMode);",
        "return AnimationAction_init(64,1.0,2500,1,1);",
        "return AnimationClip_init(64,0,0,0,0,1.0,2201);"
    };
    const double gold[]={2200,2201,2202,2500,2501,-1,-1};
    return g_math_run("G_ANIM AnimationModes","animation-modes",modules,"",cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let a=AnimationAction_init(64,1.0,2201,1,1);return ux_u32(a+AnimationAction.loop);");
}
