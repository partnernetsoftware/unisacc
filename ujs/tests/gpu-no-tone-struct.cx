#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","gpu-material-tone","gpu-tone-rgb",0};
    const char *cases[]={
        "let out=GpuMaterial_toneRgb(0,0,0.25,0.5,0.125,2.0,1.0);return f64_floor_i64(ux_f64(out)*255.0+0.5);",
        "let out=GpuMaterial_toneRgb(0,0,0.25,0.5,0.125,0.0,1.0);return f64_floor_i64(ux_f64(out+8)*255.0+0.5);",
        "let out=GpuMaterial_toneRgb(0,0,2.0,0.5,0.125,0.0,1.0);return ux_f64(out);"
    };
    const double gold[]={64,128,2};
    return g_math_run("G_STRUCT GPU no tone mapping","gpu-no-tone",modules,"",cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let out=GpuMaterial_toneRgb(0,1,0.25,0.5,0.125,2.0,1.0);return f64_floor_i64(ux_f64(out)*255.0+0.5);");
}
