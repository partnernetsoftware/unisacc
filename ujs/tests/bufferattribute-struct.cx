#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","datautils","bufferattribute","attribute-families",0};
    const char *types[]={"Uint8","Int8","Uint8Clamped","Uint16","Int16","Uint32","Int32","Float16","Float32","Float64"};
    const char *values[]={"255.0","0.0-128.0","2.5","0.5","0.0-1.0","4294967295.0",
        "0.0-2147483648.0","1.5","0.3","0.3"};
    const char *setup="let a=BufferAttribute_init(0,128,2,4,9,0);"
        "let changed=BufferAttribute_setXYZW(a,1.0,1.25,2.5,3.75,4.5,480.0);"
        "let selected=BufferAttribute_setUsage(a,35048);let u=BufferAttribute_needsUpdate(a,1);";
    const char *tail[]={
        "return ux_u32(a+BufferAttribute.count);","return ux_u32(a+BufferAttribute.itemSize);",
        "return BufferAttribute_getComponent(a,1,0);","return BufferAttribute_getY(a,1);",
        "return BufferAttribute_getZ(a,1);","return BufferAttribute_getW(a,1);",
        "return ux_u32(a+BufferAttribute.usage);","return ux_u32(a+BufferAttribute.version);",
        "let c=BufferAttribute_clone(32,a,192,32);return BufferAttribute_getW(c,1);",
        "let c=BufferAttribute_clone(32,a,192,32);let t=BufferAttribute_copyAt(a,0,c,1);return BufferAttribute_getZ(t,0);",
        "let c=BufferAttribute_clone(32,a,192,32);return ux_u32(a+BufferAttribute.data)!=ux_u32(c+BufferAttribute.data);"
    };
    const double gold[]={255,-128,2,32768.0/65535,-1,4294967295.0,-2147483648.0,1.5,
        (double)(float)0.3,0.3,2,4,1.25,2.5,3.75,4.5,35048,1,4.5,3.75,1};
    enum {count=sizeof gold/sizeof gold[0]};
    char probes[10][256];
    const char *cases[count];
    for(int i=0;i<10;i++) {
        tx_snprintf(probes[i],sizeof probes[i],
            "let typed=%sBufferAttribute_init(32,256,1,1,%d);let u=BufferAttribute_setX(typed,0.0,%s,480.0);return BufferAttribute_getX(u,0);",
            types[i],i==3 || i==4,values[i]);
        cases[i]=probes[i];
    }
    for(int i=10;i<count;i++) cases[i]=tail[i-10];
    return g_math_run("G_STRUCT BufferAttribute","bufferattribute",modules,setup,cases,gold,count,
        mutate?13:-1,"return BufferAttribute_getX(a,1);");
}
