#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"f64-math","vector-scalar","views","matrix4","object-layouts","camera",
        "orthographiccamera","orbitcontrols","orbitcontrols-ortho-zoom",0};
    const char *setup="let c=256;let target=64;let eye=0;let z=ux_f64_put(eye+16,10.0);"
        "let init=OrbitControls_init(c,eye,target,100.0);let camera=Camera_init(1024,2048);"
        "let lens=OrthographicCamera_init(512,0.0-4.0,4.0,2.0,0.0-2.0,1.0,11.0);";
    #define WHEEL "let event=OrbitControls_wheel(c,0.0-100.0,1);"
    #define ZOOM "let zoomed=OrbitControls_zoomOrthographic(c,lens,camera,0.99,1.02);"
    #define STEP "let step=OrbitControls_step(c);"
    #define ZOOM_READ "return ux_f64(lens+OrthographicCamera.zoom);"
    const char *cases[]={
        WHEEL ZOOM ZOOM_READ,
        WHEEL ZOOM "return ux_f64(ux_u32(camera+Camera.projectionMatrix));",
        WHEEL ZOOM "return ux_f64(ux_u32(camera+Camera.projectionMatrixInverse));",
        WHEEL ZOOM STEP "return ux_f64(c+OrbitControls.z);",
        "let event=OrbitControls_wheel(c,100.0,1);" ZOOM ZOOM_READ,
        WHEEL "let zoomed=OrbitControls_zoomOrthographic(c,lens,camera,0.0,2.0);" ZOOM_READ,
        WHEEL "let invalid=OrbitControls_zoomOrthographic(c,lens,camera,2.0,1.0);"
        "return ux_f64(c+OrbitControls.zoomScale);",
    };
    const double gold[]={1.02,0.255,4.0/1.02,10,0.99,1.0/0.95,0.95};
    return g_wasm_batch_addon("G_RAY OrbitControls orthographic zoom","orbitcontrols-ortho-zoom",
        argv[1],modules,setup,cases,gold,sizeof gold/sizeof gold[0],mutate?3:-1,
        WHEEL STEP "return ux_f64(c+OrbitControls.z);");
}
