#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","vector-scalar","vector3","ray","raycast-memory","raycaster-state",
        "raycast-affine","raycast-hit-sort","raycast-vertices","raycast-lines",0};
    const char *setup=
        "let state=0;let query=128;let world=256;let scale=384;let pos=512;let indices=624;let out=768;let work=1024;"
        "let ray=Raycaster_default(state);let threshold=ux_f64_put(state+RaycasterState.lineThreshold,0.2);"
        "let m0=ux_f64_put(world,1.0);let m5=ux_f64_put(world+40,1.0);let m10=ux_f64_put(world+80,1.0);"
        "let m15=ux_f64_put(world+120,1.0);let size=Vector3_set(scale,1.0,1.0,1.0);"
        "let a=ux_u32_put(query+RayPointsBuffer.positions,pos);let b=ux_u32_put(query+RayPointsBuffer.count,4);"
        "let c=ux_u32_put(query+RayPointsBuffer.stride,12);let d=ux_u32_put(query+RayPointsBuffer.indices,indices);"
        "let e=ux_u32_put(query+RayPointsBuffer.indexCount,4);let g=ux_u32_put(query+RayPointsBuffer.drawCount,4);"
        "let h=ux_u32_put(query+RayPointsBuffer.world,world);let i=ux_u32_put(query+RayPointsBuffer.layerMask,1);"
        "let j=ux_u32_put(query+RayPointsBuffer.scale,scale);let k=0;while(k<4){"
        "let y=ux_f32_put(pos+k*12+4,0.125);let z=ux_f32_put(pos+k*12+8,0.0-4.0+2.0*(k/2));k=k+1;}"
        "let x0=ux_f32_put(pos,0.0-1.0);let x1=ux_f32_put(pos+12,1.0);"
        "let x2=ux_f32_put(pos+24,1.0);let x3=ux_f32_put(pos+36,0.0-1.0);"
        "let l0=ux_u8_put(indices,2);let l1=ux_u8_put(indices+1,3);let l2=ux_u8_put(indices+2,0);let l3=ux_u8_put(indices+3,1);";
    #define HIT(mode) "let hits=Raycaster_intersectLinesBuffer(state,query,out,4,work,512," mode ");"
    const char *cases[]={
        HIT("0") "return 0.0+hits;",
        HIT("0") "return 0.0+ux_u32(out+RayLineHit.index);",
        HIT("0") "return ux_f64(out+RayLineHit.distance);",
        HIT("0") "return ux_f64(out+RayLineHit.y);",
        HIT("1") "return 0.0+hits;",
        "let start=ux_u32_put(query+RayPointsBuffer.drawStart,1);" HIT("1") "return 0.0+hits;",
        "let width=ux_u32_put(query+RayPointsBuffer.indexBytes,1);" HIT("1") "return 0.0+ux_u32(out+RayLineHit.index);",
        "let far=ux_f64_put(state+RaycasterState.far,3.0);" HIT("0") "return 0.0+hits;",
        "let width=ux_u32_put(query+RayPointsBuffer.indexBytes,1);let bad=ux_u8_put(indices+3,9);"
        HIT("1") "return 0.0+hits;",
        "let a=ux_f32_put(pos+12,0.0-1.0);let b=ux_f32_put(pos+16,2.0);let c=ux_f32_put(pos+28,2.0);"
        "let d=ux_f32_put(pos+36,1.0);" HIT("2") "return 0.0+hits;",
        "let threshold=ux_f64_put(state+RaycasterState.lineThreshold,0.125);" HIT("0") "return 0.0+hits;",
    };
    const double gold[]={2,2,2,0.125,2,0,0,1,-2,0,2};
    return g_wasm_batch("G_RAY Raycaster line families","raycast-lines",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let t=ux_f64_put(state+RaycasterState.lineThreshold,0.1);" HIT("0") "return 0.0+hits;");
}
