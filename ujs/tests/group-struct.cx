#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d","group",0};
    const char *setup="let arena=Object3D_initArena(0,3);let g=Group_create(arena);let c=Object3D_create(arena);"
        "let attached=Group_add(arena,g,c);";
    const char *cases[]={
        "return Group_isGroup(arena,g);","return Group_isGroup(arena,c);",
        "return Group_traverse(arena,g,1400,4);",
        "let n=Group_traverse(arena,g,1400,4);return ux_u32(1404)%65536;",
        "return ux_u32(Object3D_address(arena,c)+Object3D.parent)==g;",
        "let removed=Group_remove(arena,g,c);return ux_u32(Object3D_address(arena,g)+Object3D.firstChild);"
    };
    const double gold[]={1,0,2,2,1,0};
    return g_math_run("G_STRUCT Group","group",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?2:-1,"return Group_traverse(arena,c,1400,4);");
}
