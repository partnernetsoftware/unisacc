#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","glb-container","json-read","loader-json","gltf-scene-roots",0};
    const char json[]="{\"scene\":1,\"scenes\":[{\"nodes\":[1]},{\"nodes\":[2,0]},{},{\"nodes\":[0,8]}],"
        "\"nodes\":[{\"name\":\"n0\"},{\"name\":\"n1\"},{\"name\":\"n2\"}]}";
    char setup[2400];
    int n=tx_snprintf(setup,sizeof setup,
        "let input=128;let out=512;let key=640;let a=ux_u32_put(GlbResource.json,input);"
        "let b=ux_u32_put(GlbResource.jsonBytes,%d);let keep=ux_u32_put(out,77);",(int)sizeof json-1);
    for(int at=0;at<(int)sizeof json-1;at+=64) {
        int count=(int)sizeof json-1-at;
        if(count>64) count=64;
        n+=tx_snprintf(setup+n,sizeof setup-n,"if(1){let raw=[");
        for(int i=0;i<count;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[at+i]);
        n+=tx_snprintf(setup+n,sizeof setup-n,"];let i=0;while(i<%d){let put=ux_u8_put(input+%d+i,raw[i]);i=i+1;}}",count,at);
    }
    #define DEFAULT "let count=GltfLoader_sceneRoots(0,0-1,out,2,key);"
    const char *cases[]={
        DEFAULT "return 0.0+count;",
        DEFAULT "return 0.0+ux_u32(out);",
        DEFAULT "return 0.0+ux_u32(out+4);",
        "let count=GltfLoader_sceneRoots(0,0,out,2,key);return 0.0+ux_u32(out);",
        "return 0.0+GltfLoader_sceneRoots(0,2,out,2,key);",
        "return 0.0+GltfLoader_sceneRoots(0,9,out,2,key);",
        "let result=GltfLoader_sceneRoots(0,3,out,2,key);return 0.0+(result==0-3 && ux_u32(out)==77);",
        "return 0.0+GltfLoader_sceneRoots(0,0-1,out,1,key);",
    };
    const double gold[]={2,2,0,1,0,-2,1,-3};
    return g_wasm_batch_addon("G_IO GLTF scene roots","gltf-scene-roots",argv[1],modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let count=GltfLoader_sceneRoots(0,0,out,2,key);return 0.0+ux_u32(out);");
}
