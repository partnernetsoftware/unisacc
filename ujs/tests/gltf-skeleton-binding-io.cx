#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d","bone",
        "skeleton-layout","skeleton","gltf-skeleton-binding",0};
    const char *setup=
        "let arena=Object3D_initArena(0,3);let other=Object3D_create(arena);"
        "let a=Bone_create(arena);let b=Bone_create(arena);"
        "let aw=ux_u32(Object3D_address(arena,a)+Object3D.worldMatrix);"
        "let bw=ux_u32(Object3D_address(arena,b)+Object3D.worldMatrix);"
        "let x=ux_f64_put(aw+96,3.0);let y=ux_f64_put(bw+96,5.0);"
        "let source=1408;let nodes=1488;let joints=1520;let inverse=1600;let out=1920;let store=2048;let scratch=3008;"
        "let n0=ux_u32_put(nodes,other);let n1=ux_u32_put(nodes+4,a);let n2=ux_u32_put(nodes+8,b);"
        "let j0=ux_u32_put(joints,2);let j1=ux_u32_put(joints+4,1);"
        "let p=ux_u32_put(source+GltfSkeletonBinding.arena,arena);let q=ux_u32_put(source+GltfSkeletonBinding.nodes,nodes);"
        "let r=ux_u32_put(source+GltfSkeletonBinding.nodeCount,3);let s=ux_u32_put(source+GltfSkeletonBinding.joints,joints);"
        "let t=ux_u32_put(source+GltfSkeletonBinding.jointCount,2);"
        "let u=ux_u32_put(source+GltfSkeletonBinding.inverseBytes,inverse);"
        "let v=ux_u32_put(source+GltfSkeletonBinding.inverseStride,80);"
        "let i=0;while(i<16){let inverse_a=ux_f32_put(inverse+i*4,(i%5==0)*1.0);"
        "let inverse_b=ux_f32_put(inverse+80+i*4,(i%5==0)*1.0);i=i+1;}"
        "let ax=ux_f32_put(inverse+48,0.0-2.0);let bx=ux_f32_put(inverse+128,0.0-1.0);";
    #define LOAD "let loaded=GltfLoader_bindSkeleton(source,out,store,512);"
    #define UPDATE "let palette=Skeleton_update(out,arena,scratch);"
    const char *cases[]={
        LOAD "return 0.0+ux_u32(out+Skeleton.count);",
        LOAD "return 0.0+(ux_u32(ux_u32(out+Skeleton.bones))==b);",
        LOAD "return ux_f64(ux_u32(out+Skeleton.inverses)+96);",
        LOAD UPDATE "return ux_f32(palette+48);",
        LOAD UPDATE "return ux_f32(palette+112);",
        "let implicit=ux_u32_put(source+GltfSkeletonBinding.inverseStride,0);"
        LOAD UPDATE "return ux_f32(palette+48);",
        "let bad=ux_u32_put(joints,0);" LOAD "return 0.0+loaded;",
        "let keep=ux_u32_put(out+Skeleton.count,77);let bad=ux_f32_put(inverse+80,0.0/0.0);"
        LOAD "return 0.0+ux_u32(out+Skeleton.count);",
        "return 0.0+GltfLoader_bindSkeleton(source,out,store,391);",
    };
    const double gold[]={2,1,-2,3,2,5,-2,77,-1};
    return g_wasm_batch("G_IO glTF skeleton binding","gltf-skeleton-binding",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,LOAD UPDATE "return ux_f32(palette+112);");
}
