#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use text.fmt
#pragma unisa use text.text

static int group_compile(const char *dir) {
    char layout[320],wasm[320];
    tx_snprintf(layout,sizeof layout,"%s/probe-layout.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/probe.wasm",dir);
    const char abi[]="export uxe_uniformsgroup_closure(op:i64,a:i64,b:i64) i64 version 1;\n";
    if(sy_write_file(layout,abi,sizeof abi-1,0600)) return 1;
    char *args[]={"./ujs/ujs2wasm.com",layout,"ujs/practice/uxe/base/record-copy.ujs",
        "ujs/practice/uxe/base/object-layouts.ujs","ujs/practice/uxe/base/eventdispatcher.ujs",
        "ujs/practice/uxe/base/uniform.ujs","ujs/practice/uxe/base/uniformsgroup.ujs",
        "ujs/practice/uxe/base/uniform-std140.ujs","ujs/practice/uxe/base/uniformsgroup-values.ujs",
        "ujs/practice/uxe/base/uniformsgroup-closure.ujs",
        "ujs/practice/uxe/test/uniformsgroup-closure-probe.ujs","-o",wasm,0};
    char *out=0;
    size_t bytes=0;
    int rc=cx_runv_timeout(args,8,&out,&bytes);
    if(rc) printf("UNIFORMS_GROUP_BUILD rc=%d output=%.*s\n",rc,(int)bytes,out);
    mm_free(out);
    return rc;
}

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[460],url[840];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","ujs-uniformsgroup-closure-",dir,sizeof dir)) return 2;
    int n=tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/uniformsgroup-closure-r160.html?dir=%s%s",
        cwd,dir,mutate?"&mutate=1":"");
    // Red combines a quarter from the direct vector and a quarter from
    // the matrix. Green comes from the separately copied nested vector.
    const double gold[]={1,1,1,128,128,191,255,128,64,191,255,
        1,1,1,-1,-2,-1,1,96,1,128,128,191,255,128,64,191,255};
    enum { count=sizeof gold/sizeof gold[0] };
    double values[count]={0};
    int failed=n<0 || n>=sizeof url || group_compile(dir) || r160_wait_read(url,"#r160",values,count,dir);
    for(int i=0;!failed && i<count;i++) if(values[i]!=gold[i]) {
        printf("UNIFORMS_GROUP case=%d actual=%.17g gold=%.17g\n",i,values[i],gold[i]);
        failed=1;
    }
    if(sy_remove_all(dir)) failed=1;
    printf("G_PIXEL UniformsGroup copy and clone UBO cases=%d failed=%d\n",count,failed);
    return failed;
}
