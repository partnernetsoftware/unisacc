#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"gltf-triangle-topology",0};
    const char *setup="let x=ux_u32_put(128,66307);let y=ux_u32_put(512,77);";
    #define STRIP "let n=GltfLoader_triangles(5,4,0,0,4,256,6);"
    #define FAN "let n=GltfLoader_triangles(6,4,128,1,4,256,6);"
    const char *cases[]={
        STRIP "return 0.0+n;",
        STRIP "return 0.0+ux_u32(268);",
        STRIP "return 0.0+ux_u32(276);",
        FAN "return 0.0+ux_u32(268);",
        FAN "return 0.0+ux_u32(272);",
        FAN "return 0.0+ux_u32(276);",
        "let n=GltfLoader_triangles(4,3,0,0,3,256,3);return 0.0+ux_u32(264);",
        "return 0.0+GltfLoader_triangles(5,4,0,0,4,256,5);",
        "let bad=ux_u8_put(131,4);let n=GltfLoader_triangles(6,4,128,1,4,512,6);"
        "return 0.0+(n==0-3 && ux_u32(512)==77);",
        "return 0.0+GltfLoader_triangles(6,4,128,1,4,128,6);",
    };
    const double gold[]={6,3,1,3,1,0,2,-2,1,-2};
    return g_wasm_batch_addon("G_IO GLTF triangle topology","gltf-topology",argv[1],modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,STRIP "return 0.0+ux_u32(276);");
}
