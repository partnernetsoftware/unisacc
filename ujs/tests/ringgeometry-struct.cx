#pragma unisa use g_geometry
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","geometry-buffers","ringgeometry",0};
    char source[512];
    tx_snprintf(source,sizeof source,"let mesh=GeometryBuffers_init(0,256,10,1024,24);"
        "return RingGeometry_generate(mesh,%d.0,2.0,4,1,0.0,6.283185307179586);",mutate?2:1);
    const double gold[]={
        10,24,
         1,0,0, 0,0,1, .75,.5, 0, 1,0, 0,0,1, .5,.75,
        -1,0,0, 0,0,1, .25,.5, 0,-1,0, 0,0,1, .5,.25,
         1,0,0, 0,0,1, .75,.5,
         2,0,0, 0,0,1, 1,.5, 0, 2,0, 0,0,1, .5,1,
        -2,0,0, 0,0,1, 0,.5, 0,-2,0, 0,0,1, .5,0,
         2,0,0, 0,0,1, 1,.5,
        0,5,1,5,6,1, 1,6,2,6,7,2, 2,7,3,7,8,3, 3,8,4,8,9,4
    };
    return g_geometry_check("RingGeometry","ringgeometry",modules,source,gold,
        sizeof gold/sizeof gold[0],82);
}
