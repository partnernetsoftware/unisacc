#pragma unisa use g_wasm_batch
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use sys.fs
#pragma unisa use mem.heap

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"helper-buffers","source","object-json-tokens","json-read","json-bytes",
        "record-copy","loaderutils","json-string-decode","source-json","source-json-read",0};
    static const char *const input[]={
        "{\"uuid\":\"asset\",\"url\":{\"data\":[7,255],\"width\":2,\"height\":1,\"type\":\"Uint8Array\"}}",
        "{\"uuid\":\"asset\",\"url\":\"data:,x\"}",
        "{\"uuid\":\"asset\",\"url\":\"\"}",
        "{\"uuid\":\"asset\",\"url\":{\"data\":[7,256],\"width\":2,\"height\":1,\"type\":\"Uint8Array\"}}",
    };
    char setup[4096];
    unsigned char *layouts=0;
    int64_t size=0;
    const char marker[]="struct Source {";
    if(sy_read_file("ujs/practice/uxe/base/object-layouts.ujs",&layouts,&size,100000)) return 2;
    const long start=tx_find((const char *)layouts,size,marker,sizeof marker-1);
    const long tail=start<0?-1:tx_find((const char *)layouts+start,size-start,"\n}",2);
    if(start<0 || tail<0) { mm_free(layouts); return 2; }
    int used=tx_snprintf(setup,sizeof setup,"%.*s\n",(int)tail+2,(const char *)layouts+start);
    mm_free(layouts);
    if(used<=0 || used>=(int)sizeof setup) return 2;
    int args=tx_snprintf(setup+used,sizeof setup-used,
        "let arch=ux_u32_put(128+SourceRead.image,256);let payload=ux_u32_put(128+SourceRead.data,512);"
        "let cap=ux_u32_put(128+SourceRead.capacity,32);let work=ux_u32_put(128+SourceRead.scratch,768);");
    if(args<0 || args>=(int)sizeof setup-used) return 2;
    used+=args;
    for(int i=0;i<4;i++) {
        int bytes=tx_len(input[i],128);
        for(int j=0;j<bytes;j+=4) {
            unsigned word=0;
            for(int k=0;k<4 && j+k<bytes;k++) word|=(unsigned)(unsigned char)input[i][j+k]<<(8*k);
            int n=tx_snprintf(setup+used,sizeof setup-used,"let w%d_%d=ux_u32_put(%d,%u);",i,j,1024+i*128+j,word);
            if(n<0 || n>=(int)sizeof setup-used) return 2;
            used+=n;
        }
    }
    const char *cases[]={
        "let a=Source_fromJSON(32,1024,1104,128);return 0.0+ux_u32(256+SourceImage.width);",
        "let a=Source_fromJSON(32,1024,1104,128);return 0.0+ux_u8(513);",
        "let a=Source_fromJSON(32,1152,1184,128);return 0.0+ux_u32(256+SourceImage.count);",
        "let a=Source_fromJSON(32,1152,1184,128);return 0.0+ux_u8(518);",
        "let a=Source_fromJSON(32,1280,1305,128);return 0.0+ux_u32(32+Source.data);",
        "let mark=ux_u8_put(512,33);let a=Source_fromJSON(32,1408,1488,128);return 0.0+a*100+ux_u8(512);",
        "let a=Source_fromJSON(32,1024,1104,128);if(a<0){return 0.0+a;}"
        "let end=Source_toJSON(32,3000,3500,1033,5,4000);if(end<0){return 0.0+end;}"
        "let at=3000;let hash=0;while(at<end){hash=(hash*131+ux_u8(at))%16777213;at=at+1;}"
        "return 0.0+hash;",
    };
    int digest=0;
    for(int i=0;input[0][i];i++) digest=(digest*131+(unsigned char)input[0][i])%16777213;
    const double gold[]={2,255,7,120,0,-67,digest};
    return g_wasm_batch("G_STRUCT Source JSON read","source-json-read",modules,setup,cases,gold,7,
        mutate?1:-1,"let a=Source_fromJSON(32,1024,1104,128);return 0.0+ux_u8(512);");
}
