#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    int reinhard_mutate=argc==2 && tx_eqz(argv[1],"--reinhard-mutate");
    if(argc!=1 && !mutate && !reinhard_mutate) return 2;
    const char *modules[]={"gpu-material-tone",0};
    const char *cases[]={
        "return GpuMaterial_toneChannel(1,0.25,2.0);",
        "return GpuMaterial_toneChannel(1,2.0,2.0);",
        "return GpuMaterial_toneChannel(1,2.0,0.0);",
        "return GpuMaterial_toneChannel(2,0.25,2.0);",
        "return GpuMaterial_toneChannel(2,2.0,2.0);",
        "return GpuMaterial_toneChannel(2,2.0,0.0);"
    };
    const double gold[]={0.5,1,0,1.0/3.0,0.8,0};
    return g_math_run("G_MATH ToneModes","tone-modes",modules,"",cases,gold,6,
        reinhard_mutate?3:mutate?0:-1,reinhard_mutate?
        "return GpuMaterial_toneChannel(1,0.25,2.0);":
        "return GpuMaterial_toneChannel(2,0.25,2.0);");
}
