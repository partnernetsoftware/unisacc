#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define PIXEL(n) "return 0.0+ux_u32(512+4*" #n ");"
#define U(n) "let n=CompressedTexture_decodeBC5(32,512,60);" PIXEL(n)
#define S(n) "let n=CompressedTexture_decodeBC5(64,512,60);" PIXEL(n)
#define UB(v) ((v)<0?(v)+256:(v))
#define UP(r,g) (0xff000000u+(r)+256*(g))
#define SP(r,g) (0x7f000000u+UB(r)+256*UB(g))

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","compressedtextureloader","compressed-texture-bc4",
        "compressed-texture-bc5",0};
    const char setup[]=
        "native function bc5_fixture(at:i64,a:i64,b:i64,c:i64,d:i64,e:i64) i64 {"
        "let x=ux_u8_put(at,a);let y=ux_u8_put(at+1,b);"
        "let i=0;while(i<2){let q=ux_u8_put(at+2+3*i,c);let r=ux_u8_put(at+3+3*i,d);"
        "let s=ux_u8_put(at+4+3*i,e);i=i+1;}return at;}"
        "let u=CompressedTexture_bc5Level(32,128,32,5,3,36285);"
        "let s=CompressedTexture_bc5Level(64,192,32,5,3,36286);"
        "let a=bc5_fixture(128,210,0,136,198,250);let b=bc5_fixture(136,20,220,119,57,5);"
        "let c=bc5_fixture(144,0,255,182,109,219);let d=bc5_fixture(152,100,100,255,255,255);"
        "let e=bc5_fixture(192,63,193,136,198,250);let f=bc5_fixture(200,128,63,119,57,5);"
        "let g=bc5_fixture(208,129,128,255,255,255);let h=bc5_fixture(216,128,127,255,255,255);";
    const char *cases[]={
        "return 0.0+u;",
        "return 0.0+s;",
        "return 0.0+CompressedTexture_decodeBC5(32,512,60);",
        U(0),U(1),U(2),U(3),U(4),U(5),U(6),U(7),U(8),U(9),U(14),
        S(0),S(1),S(2),S(3),S(4),S(5),S(6),S(7),S(8),S(9),S(14),
        "let a=ux_u8_put(572,173);let n=CompressedTexture_decodeBC5(32,512,60);return 0.0+ux_u8(572);",
        "let a=ux_u8_put(512,173);let n=CompressedTexture_decodeBC5(32,512,59);return 0.0+n*1000+ux_u8(512);",
        "return 0.0+CompressedTexture_decodeBC5(32,145,60);",
        "return 0.0+CompressedTexture_decodeBC5(32,32,60);",
        "let a=ux_u32_put(32+CompressedMip.data,32);return 0.0+CompressedTexture_decodeBC5(32,512,60);",
        "let a=ux_u32_put(32+CompressedMip.data,6291430);return 0.0+CompressedTexture_decodeBC5(32,512,60);",
        "let a=ux_u32_put(32+CompressedMip.bytes,16);return 0.0+CompressedTexture_decodeBC5(32,512,60);",
        "let a=ux_u32_put(32+CompressedMip.format,36283);return 0.0+CompressedTexture_decodeBC5(32,512,60);",
        "let a=ux_u32_put(32+CompressedMip.height,0);return 0.0+CompressedTexture_decodeBC5(32,512,60);",
        "return 0.0+CompressedTexture_bc5Level(96,256,16,5,3,36285);",
        "return 0.0+CompressedTexture_bc5Level(96,256,32,5,3,36284);",
    };
    const double gold[]={
        32,64,60, UP(210,255),UP(0,0),UP(180,180),UP(150,140),UP(0,255),
        UP(120,100),UP(90,60),UP(60,220),UP(30,20),UP(0,255),UP(0,255),
        SP(63,127),SP(-63,-127),SP(45,25),SP(27,-13),SP(-127,127),
        SP(9,-51),SP(-9,-89),SP(-27,63),SP(-45,-127),SP(-127,127),SP(-127,127),
        173,-827,-1,-1,-1,-3,-3,-2,-3,-3,-2,
    };
    return g_wasm_batch("G_IO CompressedTexture software BC5","compressed-texture-bc5",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let changed=ux_u8_put(138,118);let n=CompressedTexture_decodeBC5(32,512,60);" PIXEL(0));
}
