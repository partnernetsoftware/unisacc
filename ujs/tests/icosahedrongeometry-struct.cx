#pragma unisa use g_geometry
#pragma unisa use g_poly_solid
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","geometry-buffers","polyhedrongeometry","icosahedrongeometry",0};
    char source[480];
    tx_snprintf(source,sizeof source,"let mesh=GeometryBuffers_init(0,256,60,4096,0);"
        "return IcosahedronGeometry_generate(mesh,4096,%d.0,0);",mutate?2:1);
    const double p=1.6180339887498948482;
    const double vertices[]={-1,p,0, 1,p,0, -1,-p,0, 1,-p,0,
        0,-1,p, 0,1,p, 0,-1,-p, 0,1,-p, p,0,-1, p,0,1, -p,0,-1, -p,0,1};
    const int faces[]={0,11,5, 0,5,1, 0,1,7, 0,7,10, 0,10,11,
        1,5,9, 5,11,4, 11,10,2, 10,7,6, 7,1,8,
        3,9,4, 3,4,2, 3,2,6, 3,6,8, 3,8,9,
        4,9,5, 2,4,11, 6,2,10, 8,6,7, 9,8,1};
    double gold[482];
    int count=g_poly_solid_gold(gold,vertices,faces,60);
    return g_geometry_check("IcosahedronGeometry","icosahedrongeometry",modules,source,gold,count,count);
}
