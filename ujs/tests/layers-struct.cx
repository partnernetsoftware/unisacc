#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","layers",0};
    const char *setup="let a=Layers_init(0);let b=Layers_init(4);";
    const char *cases[]={
        "return ux_u32(a);",
        "let r=Layers_set(a,31);return ux_u32(r);",
        "let r=Layers_set(a,31);let s=Layers_enable(r,0);return ux_u32(s);",
        "let r=Layers_set(a,31);let s=Layers_enable(r,0);let t=Layers_toggle(s,31);return ux_u32(t);",
        "let r=Layers_disable(a,0);return ux_u32(r);",
        "let r=Layers_enableAll(a);return ux_u32(r);",
        "let r=Layers_enableAll(a);return Layers_isEnabled(r,31);",
        "let r=Layers_enableAll(a);return Layers_test(r,b);",
        "let r=Layers_disableAll(a);return ux_u32(r);",
        "let r=Layers_disableAll(a);return Layers_test(r,b);",
        "let r=Layers_set(a,33);return ux_u32(r);"
    };
    const double gold[]={1,2147483648.0,2147483649.0,1,0,4294967295.0,1,1,0,0,2};
    return g_math_run("G_STRUCT Layers","layers",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?2:-1,"let r=Layers_set(a,31);let s=Layers_disable(r,0);return ux_u32(s);");
}
