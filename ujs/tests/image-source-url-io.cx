#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","f64-math","vector-scalar","color","image-layout","imageutils","image-source-linear",
        "image-base64","png-header","png-scanlines","png-bits","png-huffman","png-fixed","png-stored","png-encode",
        "jpeg-header","jpeg-entropy","jpeg-idct","jpeg-gray","jpeg-color","jpeg-encode-block","jpeg-encode",
        "image-data-url","image-source-url",0};
    const char *setup=
        "let a=ux_u32_put(ImageResource.rgba,512);let b=ux_u32_put(ImageResource.width,1);"
        "let c=ux_u32_put(ImageResource.height,1);let d=ux_u32_put(ImageResource.rowBytes,4);"
        "let red=ux_u32_put(512,4278190080+255);"
        "let marker=ux_u32_put(1024,1096040772);let colon=ux_u8_put(1028,58);"
        "let uri_size=600;if(selected_case>=2){uri_size=0;}"
        "let cap=4096;if(selected_case==4){cap=12;}"
        "let out=65536;if(selected_case==5){out=192;}"
        "let keep=ux_u32_put(192+ImageSourceUrl.length,77);"
        "let slot=ImageUtils_sourceDataURL(0,1024,uri_size,192,out,cap,200000,8192);";
    const char *cases[]={
        "return 0.0+(ux_u32(192+ImageSourceUrl.bytes)==1024 && ux_u32(192+ImageSourceUrl.borrowed)==1);",
        "return 0.0+ux_u32(192+ImageSourceUrl.length);",
        "return 0.0+ux_u32(192+ImageSourceUrl.length);",
        "return 0.0+ux_u32(192+ImageSourceUrl.length);",
        "return 0.0+ux_u32(192+ImageSourceUrl.length);",
        "return 0.0+slot;",
        "return 0.0+ux_u32(192+ImageSourceUrl.borrowed);",
    };
    const double gold[]={1,600,1,255,77,-1,0};
    return g_wasm_batch_page("G_IO ImageUtils decoded source URLs","image-source-url",
        "ujs/practice/uxe/test/image-source-url-wasm.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,"return 0.0+ux_u32(192+ImageSourceUrl.borrowed)-1.0;");
}
