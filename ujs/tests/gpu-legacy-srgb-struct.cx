#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","vector-scalar","color","gpu-texture-sample","gpu-legacy-srgb","gpu-legacy-srgb-generated",0};
    const char *setup="let a=ux_u8_put(128,128);let b=ux_u8_put(129,64);"
        "let c=ux_u8_put(130,192);let d=ux_u8_put(131,102);"
        "let e=ux_u8_put(132,255);let f=ux_u8_put(133,0);let g=ux_u8_put(134,0);let h=ux_u8_put(135,233);";
    const char *cases[]={
        "return GpuLegacySrgb_sample(1035,128,2,1,0.25,0.0);",
        "return GpuLegacySrgb_sample(1035,128,2,1,0.75,0.0);"
    };
    const double gold[]={55+13*256.0+134*65536.0+102*16777216.0,255+233*16777216.0};
    return g_math_run("G_STRUCT GPU legacy sRGB", "gpu-legacy-srgb",modules,setup,cases,gold,2,
        mutate?0:-1,"return GpuTexture_nearestRgba8(128,2,1,0.25,0.0);");
}
