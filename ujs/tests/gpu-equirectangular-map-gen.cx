#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

int main(int argc,char **argv) {
    int write=argc==2 && tx_eqz(argv[1],"--write");
    int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char header[]="symbol\tmapping\tcube_mapping\toperation\n";
    unsigned char *facts=0,*old=0;
    int64_t bytes=0,saved=0;
    int failed=sy_read_file("ujs/practice/uxe/base/gpu-equirectangular-map.tsv",&facts,&bytes,2048);
    if(!failed && (bytes<sizeof header-1 || !tx_prefix((char *)facts,bytes,header,sizeof header-1))) failed=1;
    char code[4096];
    int rows=0,used=0,mappings[2],cubes[2];
#define EMIT(...) do { int n=tx_snprintf(code+used,sizeof code-used,__VA_ARGS__); \
    if(n<0 || n>=sizeof code-used) failed=1; else used+=n; } while(0)
    EMIT("// Generated by gpu-equirectangular-map-gen.cx.\n");
    const char *symbols[]={"EquirectangularReflectionMapping","EquirectangularRefractionMapping"};
    const char *methods[]={"reflection","refraction"};
    for(int at=sizeof header-1;!failed && at<bytes;) {
        int tab=at;
        while(tab<bytes && facts[tab]!='\t' && facts[tab]!='\n') tab++;
        if(rows>=2 || tab+10>=bytes || !tx_same((char *)facts+at,tab-at,symbols[rows],tx_len(symbols[rows],40)) ||
            facts[tab]!='\t' || facts[tab+4]!='\t' || facts[tab+8]!='\t' || facts[tab+9]!='0'+rows || facts[tab+10]!='\n') {
            failed=1; break;
        }
        char *end=0;
        long mapping=tx_strtol((char *)facts+tab+1,&end,10);
        if(end!=(char *)facts+tab+4 || mapping<100 || mapping>999 || (rows!=0 && mapping<=mappings[rows-1])) { failed=1; break; }
        long cube=tx_strtol((char *)facts+tab+5,&end,10);
        if(end!=(char *)facts+tab+8 || cube<100 || cube>999 || cube==mapping) { failed=1; break; }
        mappings[rows]=mapping;
        cubes[rows]=cube;
        EMIT("native function GpuEquirectangular_%s() i64 { return %d; } // %s\n",
             methods[rows],mappings[rows],symbols[rows]);
        rows++;
        at=tab+11;
    }
    if(!failed && rows==2) {
        EMIT("native function gpu_equirectangular_operation(mode:i64) i64 {\n");
        for(int i=0;!failed && i<rows;i++) EMIT("  if(mode==%d) { return %d; }\n",mappings[i],i);
        EMIT("  return 0-2;\n}\nnative function GpuEquirectangularMap_cubeMode(mode:i64) i64 {\n");
        for(int i=0;!failed && i<rows;i++) EMIT("  if(mode==%d) { return %d; }\n",mappings[i],cubes[i]+(mutate && i==1));
        EMIT("  return 0-2;\n}\n");
    } else failed=1;
#undef EMIT
    const char *path="ujs/practice/uxe/base/gpu-equirectangular-map-generated.ujs";
    if(!failed) failed=write?sy_write_file(path,code,used,0644)!=0:
        sy_read_file(path,&old,&saved,sizeof code) || !tx_same((char *)old,saved,code,used);
    mm_free(facts);
    mm_free(old);
    printf("EQUIRECTANGULAR_MAP_GENERATE rows=%d failed=%d\n",rows,failed);
    return failed;
}
