#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d","object3d-lifecycle",
        "datautils","bufferattribute","buffergeometry","mesh-layout","mesh","skeleton-layout",
        "skinnedmesh-deform","skinnedmesh","skin-bind-mode","skinnedmesh-lifecycle",0};
    const char *setup="let arena=Object3D_initArena(0,6);let source=Object3D_create(arena);"
        "let target=Object3D_create(arena);let object=Mesh_init(4024,arena,source,4400,17,0,0);"
        "let targetMesh=Mesh_init(4056,arena,target,4500,19,0,0);"
        "let skin=SkinnedMesh_init(5000,object,5120,5248);let clone=SkinnedMesh_init(5032,targetMesh,5408,5536);"
        "let matrix=Matrix4_makeScale(5700+4,2.0,1.0,1.0);"
        "let bound=SkinnedMesh_bind(skin,3996,matrix);"
        "let inverse=SkinnedMesh_updateBind(skin,0,2);"
        "let result=SkinnedMesh_clone(clone,arena,skin,arena,0);if(result<0){return 0.0+result;}";
    const char *cases[]={
        "return 0.0+(ux_u32(targetMesh+Mesh.geometry)==4400 && ux_u32(targetMesh+Mesh.material)==17);",
        "return 0.0+(ux_u32(result+SkinnedMesh.skeleton)==3996);",
        "return ux_f64(ux_u32(result+SkinnedMesh.bindMatrix));",
        "return ux_f64(ux_u32(result+SkinnedMesh.bindInverse));",
        "return 0.0+ux_u32(result+SkinnedMesh.bindMode);",
        "let changed=ux_f64_put(5408,7.0);return ux_f64(5120);",
    };
    const double gold[]={1,1,2,0.5,2,2};
    return g_wasm_batch("G_STRUCT SkinnedMesh clone","skinnedmesh-clone",modules,setup,cases,gold,6,
        mutate?4:-1,"let changed=ux_u32_put(result+SkinnedMesh.bindMode,1);return 0.0+ux_u32(result+SkinnedMesh.bindMode);");
}
