#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","datautils","bufferattribute","buffergeometry","mesh-layout","line",0};
    const char *setup=
        "let geo=BufferGeometry_init(512,576,1,608,0);let position=BufferAttribute_init(640,768,4,3,9,0);"
        "let p1=ux_f32_put(780,3.0);let p2=ux_f32_put(792,3.0);let p3=ux_f32_put(796,4.0);"
        "let p4=ux_f32_put(804,3.0);let p5=ux_f32_put(808,4.0);let p6=ux_f32_put(812,12.0);"
        "let attr=BufferGeometry_setAttribute(geo,8,position);let line=864;"
        "let initialized=ux_u32_put(line+Mesh.geometry,geo);"
        "let count=Line_computeLineDistances(line,8,1024,4);";
    const char *cases[]={
        "return count;","return ux_f32(1024);","return ux_f32(1028);","return ux_f32(1032);","return ux_f32(1036);",
        "let ix=BufferGeometry_setIndex(geo,640);return Line_computeLineDistances(line,8,1024,4);",
        "return Line_computeLineDistances(line,8,1024,3);"
    };
    const double gold[]={4,0,3,7,19,-1,-1};
    return g_math_run("G_STRUCT Line","line",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?4:-1,"return ux_f32(1032);");
}
