#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"gpu-shadow-compare-generated",0};
    const char *setup="native function mask(mode:i64) i64 {"
        "return GpuShadow_compare(mode,0.25,0.5)+2*GpuShadow_compare(mode,0.5,0.5)"
        "+4*GpuShadow_compare(mode,0.75,0.5);}";
    const char *cases[]={"return mask(512);","return mask(513);","return mask(514);","return mask(515);",
        "return mask(516);","return mask(517);","return mask(518);","return mask(519);"};
    const double gold[]={0,1,2,3,4,5,6,7};
    return g_math_run("G_STRUCT GPU shadow compare","gpu-shadow-compare",modules,setup,cases,gold,8,
        mutate?3:-1,cases[1]);
}
