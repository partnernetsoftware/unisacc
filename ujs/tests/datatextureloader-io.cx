#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","gpu-packet","loadingmanager","fileloader","datatextureloader",0};
    const char *setup="let a=ux_u8_put(256,3);let b=ux_u8_put(257,5);let c=ux_u8_put(258,7);let d=ux_u8_put(259,255);";
    const char *cases[]={
        "let t=DataTextureLoader_rgba8(256,4,1,1,400);return ux_u32(t+GpuTextureSource.width);",
        "let t=DataTextureLoader_rgba8(256,4,1,1,400);return ux_u32(t+GpuTextureSource.filter);",
        "let t=DataTextureLoader_rgba8(256,4,1,1,400);return ux_u8(ux_u32(t+GpuTextureSource.rgba)+1);",
        "return DataTextureLoader_rgba8(256,3,1,1,400);",
        "return DataTextureLoader_rgba8(256,4,1,1,256);"
    };
    const double gold[]={1,1,5,-1,-1};
    return g_math_run("G_IO DataTextureLoader","datatextureloader",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let t=DataTextureLoader_rgba8(256,4,1,1,400);return ux_u8(ux_u32(t+GpuTextureSource.rgba)+2);");
}
