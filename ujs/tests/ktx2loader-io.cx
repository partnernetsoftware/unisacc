#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define PARSE "let parsed=KTX2Loader_parse(128,260,32);"
#define FIELD(name) "return 0.0+ux_u32(32+KTX2TextureView." #name ");"
#define MIP(i,offset) "let at=KTX2Loader_level(32," #i ");return 0.0+ux_u8(at+" #offset ");"

int main(int argc,char **argv) {
    int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"ktx2loader",0};
    const char *setup=
        "let a=ux_u32_put(128,1481919403);let b=ux_u32_put(132,3140497952);let c=ux_u32_put(136,169478669);"
        "let d=ux_u32_put(140,37);let e=ux_u32_put(144,1);let f=ux_u32_put(148,4);let g=ux_u32_put(152,2);"
        "let h=ux_u32_put(164,1);let i=ux_u32_put(168,2);let j=ux_u32_put(176,128);let k=ux_u32_put(180,92);"
        "let l=ux_u32_put(208,228);let m=ux_u32_put(216,32);let n=ux_u32_put(224,32);"
        "let o=ux_u32_put(232,220);let p=ux_u32_put(240,8);let q=ux_u32_put(248,8);"
        "let r=ux_u32_put(256,92);let s=ux_u32_put(264,5767170);let t=ux_u32_put(268,65793);let u=ux_u32_put(276,4);"
        "let samples=0;while(samples<4){let ch=samples;if(ch==3){ch=15;}"
        "let sample=284+16*samples;let meta=ux_u32_put(sample,ch*16777216+458752+8*samples);"
        "let upper=ux_u32_put(sample+12,255);samples=samples+1;}"
        "let v=ux_u32_put(348,4282992711);let w=ux_u32_put(356,4280753427);";
    const char *cases[]={
        PARSE FIELD(width),PARSE FIELD(height),PARSE FIELD(levels),PARSE MIP(0,0),
        PARSE MIP(1,0), PARSE MIP(1,1), PARSE FIELD(srgb),
        "let vk=ux_u32_put(140,43);let transfer=ux_u8_put(270,2);let alpha=ux_u8_put(335,31);" PARSE FIELD(srgb),
        "let changed=ux_u32_put(232,224);" PARSE "return 0.0+parsed;",
        "let changed=ux_u32_put(212,1);" PARSE "return 0.0+parsed;",
        "let changed=ux_u32_put(172,1);" PARSE "return 0.0+parsed;",
        PARSE "return 0.0+KTX2Loader_level(32,2);",
        "let marker=ux_u32_put(32+KTX2TextureView.width,77);let changed=ux_u32_put(232,224);" PARSE FIELD(width),
    };
    const double gold[]={4,2,2,19,71,72,0,1,-4,-4,-3,-1,77};
    return g_wasm_batch_addon("G_IO KTX2Loader raw mip chain","ktx2loader",argv[1],modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?4:-1,PARSE MIP(0,0));
}
