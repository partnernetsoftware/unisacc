#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","buffergeometry","geometry-attributes",0};
    const char *setup="let g=BufferGeometry_init(0,64,4,128,4);let p=224;let i=256;"
        "let d=ux_u32_put(p+BufferAttribute.data,320);let n=ux_u32_put(p+BufferAttribute.count,4);"
        "let kind=ux_u32_put(p+BufferAttribute.componentType,9);let stride=ux_u32_put(p+BufferAttribute.stride,12);"
        "let size=ux_u32_put(p+BufferAttribute.itemSize,3);"
        "let vx=ux_f32_put(332,1.0);let vy=ux_f32_put(348,1.0);let vz=ux_f32_put(364,1.0);"
        "let ia=ux_u32_put(i+BufferAttribute.data,400);let ni=ux_u32_put(i+BufferAttribute.count,6);"
        "let ki=ux_u32_put(i+BufferAttribute.componentType,4);let si=ux_u32_put(i+BufferAttribute.stride,2);"
        "let i1=ux_u16_put(402,1);let i2=ux_u16_put(404,2);let i4=ux_u16_put(408,3);let i5=ux_u16_put(410,1);"
        "let attr=BufferGeometry_setAttribute(g,1,p);let idx=BufferGeometry_setIndex(g,i);"
        "let built=BufferGeometry_computeVertexNormals(g,1,2,448,512,48);"
        "let normal=BufferGeometry_getAttribute(g,2);"
        "let flat=700;let fd=ux_u32_put(flat+BufferAttribute.data,768);let fn=ux_u32_put(flat+BufferAttribute.count,6);"
        "let ft=ux_u32_put(flat+BufferAttribute.componentType,9);let fs=ux_u32_put(flat+BufferAttribute.stride,12);"
        "let fp=ux_u32_put(flat+BufferAttribute.itemSize,3);"
        "let f0=ux_f32_put(780,1.0);let f1=ux_f32_put(796,1.0);let f2=ux_f32_put(824,1.0);let f3=ux_f32_put(828,1.0);"
        "let done=Geometry_normals(flat,0-1,880,72);";
    const char *cases[]={"return ux_u32(normal+BufferAttribute.count);","return ux_f32(512);",
        "return ux_f32(516);","return ux_f32(520);","return ux_f32(544);","return ux_f32(552);",
        "return ux_f32(888);","return ux_f32(920);"};
    const double half=(double)(float)0.7071067811865475;
    const double gold[]={4,0,half,half,1,1,1,1};
    return g_math_run("G_STRUCT BufferGeometry normals","geometry-attributes",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,"return ux_f32(512);");
}
