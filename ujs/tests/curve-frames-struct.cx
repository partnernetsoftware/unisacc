#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","geometry-frames","curve","curve-frames",0};
    char setup[512];
    tx_snprintf(setup,sizeof setup,"function line(env,...time){let dst=env[0];"
        "return frame_put(dst,0.0,0.0,%d.0*time[0]);}"
        "let cb=closure(line,256);let q=ux_f64_put(520,1.0);let r=ux_f64_put(528,2.0);"
        "let frames=Curve_computeFrenetFrames(cb,1024,2,512,2,2048,0);",mutate?3:2);
    const char *cases[]={
        "return frames>=0;","return ux_f64(1040);","return ux_f64(1112);","return ux_f64(1184);",
        "return ux_f64(1056);","return ux_f64(1072);","return ux_f64(1200);","return ux_f64(1216);"
    };
    const double gold[]={1,0,1,2,-1,1,-1,1};
    return g_math_run("G_STRUCT Curve Frenet","curve-frames",modules,setup,cases,gold,8,-1,0);
}
