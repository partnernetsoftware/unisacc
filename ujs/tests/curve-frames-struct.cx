#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

static int closed_frames(int mutate) {
    const char *modules[]={"f64-math","geometry-frames","curve","curve-frames",0};
    char setup[1400];
    tx_snprintf(setup,sizeof setup,
        "function loop(env,...time){let a=time[0]*6.283185307179586;"
        "let x=ux_math_cos(a);let y=ux_math_sin(a);"
        "let z=0.4*ux_math_sin(2.0*a)+0.3*y+0.25*ux_math_cos(3.0*a);"
        "return frame_put(env[0],x,y,z);}"
        "let cb=closure(loop,128);let lengths=Curve_getLengths(cb,256,32,3);"
        "let a=Curve_computeFrenetFrames(cb,1024,12,lengths,32,2048,%d);",mutate?0:1);
    const char *cases[]={
        "return curve_frame_dot(a+24,a+12*72+24)>0.99999;",
        "return curve_frame_dot(a+24,a+48);",
        "return curve_frame_dot(a+12*72+48,a+12*72+48);",
        "return ux_f64(a+12*72);"
    };
    const double gold[]={1,0,1,1};
    return g_math_run("G_STRUCT Curve closed Frenet","curve-closed",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],-1,0);
}

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc==2 && tx_eqz(argv[1],"--closed")) return closed_frames(0);
    if(argc==2 && tx_eqz(argv[1],"--closed-mutate")) return closed_frames(1);
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","geometry-frames","curve","curve-frames",0};
    char setup[512];
    tx_snprintf(setup,sizeof setup,"function line(env,...time){let dst=env[0];"
        "return frame_put(dst,0.0,0.0,%d.0*time[0]);}"
        "let cb=closure(line,256);let q=ux_f64_put(520,1.0);let r=ux_f64_put(528,2.0);"
        "let frames=Curve_computeFrenetFrames(cb,1024,2,512,2,2048,0);",mutate?3:2);
    const char *cases[]={
        "return frames>=0;","return ux_f64(1040);","return ux_f64(1112);","return ux_f64(1184);",
        "return ux_f64(1056);","return ux_f64(1072);","return ux_f64(1200);","return ux_f64(1216);"
    };
    const double gold[]={1,0,1,2,-1,1,-1,1};
    return g_math_run("G_STRUCT Curve Frenet","curve-frames",modules,setup,cases,gold,8,-1,0);
}
