#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","quaternion","animation-view","propertymixer","propertymixer-quaternion",0};
    const char *setup="let a=Quaternion_identity(64);"
        "let x=Quaternion_set(96,0.7071067811865475,0.0,0.0,0.7071067811865476);"
        "let z=Quaternion_set(128,0.0,0.0,0.7071067811865475,0.7071067811865476);"
        "let opposite=Quaternion_set(160,0.0-0.7071067811865475,0.0,0.0,0.0-0.7071067811865476);"
        "let mixer=PropertyMixer_quaternionInit(0,256,a);";
    const char *cases[]={
        "let add=PropertyMixer_quaternionAdd(mixer,x,0.5,2500,512);return ux_f64(PropertyMixer_quaternionApply(mixer));",
        "let add=PropertyMixer_quaternionAdd(mixer,x,0.5,2501,512);return ux_f64(PropertyMixer_quaternionApply(mixer));",
        "let n=PropertyMixer_quaternionAdd(mixer,x,1.0,2500,512);let ad=PropertyMixer_quaternionAdd(mixer,z,1.0,2501,512);"
        "return ux_f64(PropertyMixer_quaternionApply(mixer)+8);",
        "let n=PropertyMixer_quaternionAdd(mixer,x,0.5,2500,512);let ad=PropertyMixer_quaternionAdd(mixer,opposite,0.5,2500,512);"
        "return ux_f64(PropertyMixer_quaternionApply(mixer));",
        "let s=PropertyMixer_quaternionAdd(mixer,x,1.0,2500,512);let once=PropertyMixer_quaternionApply(mixer);"
        "return ux_f64(PropertyMixer_quaternionApply(mixer)+24);",
        "return PropertyMixer_quaternionAdd(mixer,x,1.0,2501,256);",
        "let bad=ux_f64_put(96,7.0);return PropertyMixer_quaternionAdd(mixer,x,1.0,2500,512);"
    };
    const double gold[]={.3826834323650898,.3826834323650898,-.5,.7071067811865475,1,-1,-1};
    return g_math_run("G_ANIM PropertyMixer quaternion","propertymixer-quaternion",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let n=PropertyMixer_quaternionAdd(mixer,z,1.0,2500,512);let ad=PropertyMixer_quaternionAdd(mixer,x,1.0,2501,512);"
        "return ux_f64(PropertyMixer_quaternionApply(mixer)+8);");
}
