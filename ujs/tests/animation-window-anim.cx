#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"animation-view","animation-window",0};
    const char *setup="let a=ux_f32_put(68,0.5);let b=ux_f32_put(72,0.5);"
        "let c=ux_f32_put(76,1.0);let d=ux_f32_put(80,2.0);"
        "let view=AnimationSamples_init(0,64,128,5,1);";
    const char *cases[]={
        "let r=AnimationUtils_frameRange(view,15.0,30.0,30.0,256);return ux_u32(r+AnimationFrameRange.first);",
        "let r=AnimationUtils_frameRange(view,15.0,30.0,30.0,256);return ux_u32(r+AnimationFrameRange.count);",
        "let r=AnimationUtils_frameRange(view,30.0,60.0,30.0,256);return ux_u32(r+AnimationFrameRange.count);",
        "let r=AnimationUtils_frameRange(view,30.0,30.0,30.0,256);return ux_u32(r+AnimationFrameRange.count);",
        "let r=AnimationUtils_frameRange(view,70.0,100.0,30.0,256);return ux_u32(r+AnimationFrameRange.first);",
        "return AnimationUtils_frameRange(view,15.0,30.0,30.0,64);",
        "let guard=ux_u32_put(256,777);let r=AnimationUtils_frameRange(view,15.0,30.0,0.0,256);return ux_u32(256);"
    };
    const double gold[]={1,2,1,0,5,-1,777};
    return g_math_run("G_ANIM AnimationUtils frame window","animation-window",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let r=AnimationUtils_frameRange(view,15.0,31.0,30.0,256);return ux_u32(r+AnimationFrameRange.count);");
}
