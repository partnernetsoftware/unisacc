#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define PIX(offset) "let status=CompressedTexture_decodeETC1(32,512,36);return 0.0+ux_u32(512+" #offset ");"

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","compressedtextureloader","compressed-texture-etc1",0};
    const char *setup="let mip=CompressedTextureLoader_level(32,128,8,3,3,33776);"
        "let fmt=ux_u32_put(32+CompressedMip.format,36196);"
        "let header=ux_u32_put(128,71052574);let index=ux_u32_put(132,16777728);";
    const char *cases[]={
        "return 0.0+CompressedTexture_decodeETC1(32,512,36);",PIX(0),PIX(12),PIX(8),
        "let flags=ux_u32_put(128,66168401);let zero=ux_u32_put(132,0);" PIX(0),
        "let flags=ux_u32_put(128,66168401);let zero=ux_u32_put(132,0);" PIX(24),
        "let bad=ux_u8_put(128,249);let d=ux_u8_put(131,2);return 0.0+CompressedTexture_decodeETC1(32,512,36);",
        "return 0.0+CompressedTexture_decodeETC1(32,512,35);",
    };
    const double gold[]={36,4282067481,4281409551,4291945203,4294551380,4294940252,-4,-1};
    return g_wasm_batch("G_IO ETC1 software RGB","compressed-texture-etc1",modules,setup,cases,gold,8,
        mutate?1:-1,"let broken=ux_u8_put(135,0);" PIX(0));
}
