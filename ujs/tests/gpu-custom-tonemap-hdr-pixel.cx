#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

#define RGBA(r,g,b,a) ((r)+256.0*(g)+65536.0*(b)+16777216.0*(a))
#define SOURCE .625,1.125,1.375,1.875,2.375,2.875,2.3125,.625
#define LOW RGBA(14,76,38,64),RGBA(45,87,74,80),RGBA(126,126,157,143),RGBA(202,132,209,159)
#define HIGH RGBA(39,105,73,64),RGBA(126,118,146,80),RGBA(255,158,255,143),RGBA(255,164,255,159)

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[390],abi[300],wasm[300],url[690];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-custom-tone-hdr-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/tone-hdr.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/ujs/practice/uxe/test/gpu-custom-tonemap-hdr-r160.html?wasm=%s&mode=%d",cwd,wasm,mutate);
    const char entry[]="import host_gpu_submit from \"uxe_gpu_v1\"(i64,i64) i64;\n"
        "import host_gpu_native_copy from \"uxe_gpu_target_v1\"(i64,i64,i64,i64) i64;\n"
        "export uxe_hdr_custom_tone(mode:i64,mutate:i64,vn:i64,fn:i64,hn:i64,sv:i64,sf:i64,cn:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,"ujs/practice/uxe/base/record-copy.ujs",
        "ujs/practice/uxe/base/gpu-packet.ujs","ujs/practice/uxe/base/gpu-target.ujs",
        "ujs/practice/uxe/base/effectcomposer.ujs","ujs/practice/uxe/base/effectcomposer-gpu-targets.ujs",
        "ujs/practice/uxe/base/gpu-native-sample.ujs","ujs/practice/uxe/base/effectcomposer-native.ujs",
        "ujs/practice/uxe/base/gpu-custom-tonemap.ujs","ujs/practice/uxe/test/gpu-custom-tonemap-hdr-probe.ujs","-o",wasm,0};
    const double gold[]={16,1,SOURCE,SOURCE,0,LOW,LOW,0,HIGH,HIGH,0,3};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    char *output=0;
    size_t bytes=0;
    int failed=length<0 || length>=(int)sizeof url || sy_write_file(abi,entry,sizeof entry-1,0600);
    if(!failed) {
        const int rc=cx_runv_timeout(compile,6,&output,&bytes);
        if(rc) { printf("G_PIXEL custom tone HDR compiler_rc=%d %s\n",rc,output?output:""); failed++; }
        mm_free(output); output=0;
    }
    if(!failed) failed=r160_wait_read(url,"#r160",actual,count,dir);
    if(!failed) for(int i=0;i<count;i++) if(actual[i]!=gold[i]) {
        printf("G_PIXEL custom tone HDR case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
        failed++;
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&output,&bytes)) failed++;
    mm_free(output);
    printf("G_PIXEL custom tone HDR cases=%d failed=%d\n",count,failed);
    return failed!=0;
}
