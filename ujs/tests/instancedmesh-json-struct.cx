#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define TEST "ujs/practice/uxe/test/"

int main(int argc,char **argv) {
    const int negative=argc==2 && tx_eqz(argv[1],"--verify-negative");
    if(argc!=1 && !negative) return 2;
    char dir[240],wasm[300],cwd[380],url[840];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-instance-json-",dir,sizeof dir)) return 2;
    tx_snprintf(wasm,sizeof wasm,"%s/probe.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,"file://%s/" TEST "instancedmesh-json-r160.html?wasm=%s&mutate=%d",cwd,wasm,negative);
    char *compile[]={"/bin/sh","./ujs/ujs2wasm.com",TEST "instancedmesh-json-abi.ujs",
        BASE "mesh-layout.ujs",BASE "instancedmesh.ujs",BASE "json-read.ujs",BASE "json-bytes.ujs",
        BASE "loader-json.ujs",BASE "instancedmesh-json.ujs",BASE "instancedmesh-json-read.ujs",
        TEST "instancedmesh-json-probe.ujs","-o",wasm,0};
    char *log=0;
    size_t size=0;
    int failed=length<0 || length>=(int)sizeof url;
    if(!failed) {
        const int rc=cx_runv_timeout(compile,6,&log,&size);
        if(rc) { printf("INSTANCE_JSON compile_rc=%d %s\n",rc,log?log:""); failed=1; }
        mm_free(log);
    }
    double values[12]={0};
    double gold[]={1,32,5,6,1,1,1,32,5,6,1,1};
    if(negative) gold[8]=7;
    if(!failed) failed=r160_wait_read(url,"#r160",values,12,dir);
    if(!failed) for(int i=0;i<12;i++) {
        if(values[i]!=gold[i]) {
            printf("INSTANCE_JSON case=%d actual=%g expected=%g\n",i,values[i],gold[i]);
            failed++;
        }
    }
    if(sy_remove_all(dir)) failed++;
    printf("G_STRUCT InstancedMesh JSON cases=12 negative_expected=%d failed=%d\n",negative,failed);
    return failed!=0;
}
