#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","shapeutils","shape-hole","shape-holes","shape-ring-normalize",0};
    const char *setup=
        "let points=[0,0,10,0,10,10,0,10,0,0,2,2,2,4,4,4,4,2,2,2,6,6,8,6,8,8,6,8,6,6];"
        "let i=0;while(i<30){let v=ux_f64_put(128+i*8,0.0+points[i]);i=i+1;}"
        "let s0=ux_u32_put(384,5);let s1=ux_u32_put(388,5);"
        "let count=ShapeUtils_triangulateRings(128,5,384,2,512,64,1024,1500);"
        "let area=0.0;let largest=0;i=0;"
        "while(i<count){let a=ux_u32(512+i*4);let b=ux_u32(516+i*4);let c=ux_u32(520+i*4);"
        "area=area+shape_turn(1024+a*16,1024+b*16,1024+c*16)*0.5;"
        "if(a>largest){largest=a;}if(b>largest){largest=b;}if(c>largest){largest=c;}i=i+3;}";
    const char *cases[]={
        "return count/3;","return area;","return largest;",
        "let keep=ux_u32_put(512,777);let invalid=ShapeUtils_triangulateRings(128,5,384,2,512,64,1024,247);return ux_u32(512);",
        "return ShapeUtils_triangulateRings(128,5,384,2,128,64,1024,1500);"
    };
    const double gold[]={14,92,11,777,-1};
    return g_math_run("G_STRUCT ShapeUtils closed rings","shape-closed-rings",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let open=ShapeUtils_triangulateHoles(128,5,384,2,512,64,1024,1500);return open/3;");
}
