#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d","scene","group","json-read","loader-json",
        "loadingmanager","fileloader","object-json-references","objectloader",0};
    #define OBJECT_PREFIX "{\"object\":{\"type\":\"Scene\",\"position\":[1,0,0]," \
        "\"children\":[{\"type\":\"Group\",\"position\":["
    const char json[]=OBJECT_PREFIX "2,0,0],\"visible\":false}]}}";
    char setup[1600];int size=sizeof json-1;
    int n=tx_snprintf(setup,sizeof setup,"let size=%d;let positionAt=%d;let json=[",size,256+(int)sizeof OBJECT_PREFIX-1);
    for(int i=0;i<size;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[i]);
    tx_snprintf(setup+n,sizeof setup-n,"];let i=0;while(i<size){let b=ux_u8_put(256+i,json[i]);i=i+1;}"
        "let manager=LoadingManager_init(0);let file=FileLoader_init(32,manager);let id=FileLoader_begin(file,64);"
        "let ready=FileLoader_receive(file,id,200,256,size,64);");
    const char *cases[]={
        "let root=ObjectLoader_scene(file,1024,3,768);return Scene_isScene(1024,root);",
        "let root=ObjectLoader_scene(file,1024,3,768);let r=Object3D_address(1024,root);"
        "return Group_isGroup(1024,ux_u32(r+Object3D.firstChild));",
        "let root=ObjectLoader_scene(file,1024,3,768);let r=Object3D_address(1024,root);let g=ux_u32(r+Object3D.firstChild);"
        "let updated=Object3D_updateMatrixWorld(1024,root,0);let child=Object3D_address(1024,g);"
        "return ux_f64(ux_u32(child+Object3D.worldMatrix)+96);",
        "let root=ObjectLoader_scene(file,1024,3,768);let r=Object3D_address(1024,root);"
        "let child=Object3D_address(1024,ux_u32(r+Object3D.firstChild));return ux_u32(child+Object3D.visible);",
        "return ObjectLoader_scene(file,1024,1,768);",
        "let failed=ObjectLoader_scene(file,1024,1,768);return Object3D_address(1024,65537);"
    };
    const double gold[]={1,1,3,0,-4,-1};
    return g_math_run("G_IO ObjectLoader","objectloader",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let changed=ux_u8_put(positionAt,48);let root=ObjectLoader_scene(file,1024,3,768);"
        "let r=Object3D_address(1024,root);let g=ux_u32(r+Object3D.firstChild);"
        "let updated=Object3D_updateMatrixWorld(1024,root,0);let child=Object3D_address(1024,g);"
        "return ux_f64(ux_u32(child+Object3D.worldMatrix)+96);");
}
