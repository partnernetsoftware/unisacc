#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"curve-bezier","cubicbeziercurve3",0};
    const char *setup="let k4=ux_f64_put(32,4.0);let k5=ux_f64_put(40,8.0);let k6=ux_f64_put(48,4.0);let k7=ux_f64_put(56,4.0);let k8=ux_f64_put(64,8.0);let k9=ux_f64_put(72,4.0);"
        "let first=CubicBezierCurve3_getPoint(128,0.0,0.25);"
        "let middle=CubicBezierCurve3_getPoint(160,0.0,0.5);let last=CubicBezierCurve3_getPoint(192,0.0,1.0);";
    const char *cases[]={"return ux_f64(first+0);","return ux_f64(first+8);","return ux_f64(first+16);","return ux_f64(middle+0);","return ux_f64(middle+8);","return ux_f64(middle+16);","return ux_f64(last+0);","return ux_f64(last+8);","return ux_f64(last+16);"};
    const double gold[]={0.625,2.25,4.5,2,3,6,4,0,0};
    return g_math_run("G_STRUCT CubicBezierCurve3","cubicbeziercurve3",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,"return ux_f64(middle);");
}
