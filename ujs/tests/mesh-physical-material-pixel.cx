#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define FIX "ujs/practice/uxe/test/"

enum { samples=12, channels=4*samples, count=2*channels+2 };
static const int gold[channels]={
    102,87,81,255, 158,150,147,255, 196,190,188,255,
    82,61,53,255, 84,65,57,255, 86,68,60,255,
    66,43,32,255, 66,43,32,255, 65,43,32,255,
    102,87,81,255, 106,92,87,255, 110,96,92,255,
};

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[420],abi[320],wasm[320],url[850];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-mesh-physical-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/physical.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,"file://%s/" FIX "mesh-physical-material-r160.html?wasm=%s&mode=%d",cwd,wasm,mutate);
    const char signature[]="import host_gpu_submit from \"uxe_gpu_v1\"(i64,i64) i64;\n"
        "export uxe_mesh_physical(mode:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,BASE "record-copy.ujs",BASE "gpu-packet.ujs",
        BASE "f64-math.ujs",BASE "gpu-material-lambert.ujs",BASE "gpu-material-standard.ujs",
        BASE "mesh-physical-material.ujs",FIX "mesh-physical-material-probe.ujs","-o",wasm,0};
    double actual[count]={0};
    int failed=length<=0 || length>=(int)sizeof url || sy_write_file(abi,signature,sizeof signature-1,0600);
    if(!failed) {
        char *out=0;
        size_t bytes=0;
        const int rc=cx_runv_timeout(compile,6,&out,&bytes);
        if(rc) { printf("MESH_PHYSICAL compile_rc=%d %.*s\n",rc,(int)bytes,out?out:""); failed=1; }
        mm_free(out);
    }
    if(!failed) {
        failed=r160_wait_read(url,"#r160",actual,count,dir);
        if(!failed) {
            for(int i=0;i<count;i++) {
                const int want=i<2*channels?gold[i%channels]:0;
                if(actual[i]!=want) {
                    printf("MESH_PHYSICAL case=%d actual=%.17g gold=%d\n",i,actual[i],want);
                    failed++;
                }
            }
            printf("MESH_PHYSICAL framebuffer_pixels=1024 different=%.17g alpha_errors=%.17g\n",
                actual[2*channels],actual[2*channels+1]);
        }
    }
    if(sy_remove_all(dir)) failed++;
    printf("G_PIXEL MeshPhysicalMaterial cases=%d failed=%d\n",count,failed);
    return failed!=0;
}
