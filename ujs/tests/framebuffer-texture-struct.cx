#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"framebuffer-texture",0};
    const char *setup="let i=0;while(i<9){let put=ux_u32_put(64+4*i,4278190080+10*(1+i));i=i+1;}";
    #define CAPTURE "let out=FramebufferTexture_capture(128,2,2,64,3,3,1,1);"
    const char *cases[]={
        CAPTURE "return ux_u32(out);",
        CAPTURE "return ux_u32(out+4);",
        CAPTURE "return ux_u32(out+8);",
        CAPTURE "return ux_u32(out+12);",
    };
    const double gold[]={4278190130.0,4278190140.0,4278190160.0,4278190170.0};
    return g_math_run("G_STRUCT FramebufferTexture capture","framebuffer-texture",modules,setup,cases,gold,4,
        mutate?0:-1,"let out=FramebufferTexture_capture(128,2,2,64,3,3,0,1);return ux_u32(out);");
}
