#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

static const char base_source[] = "ujs/practice/uxe/test/ux-link-base.ujs";
static const char product_source[] = "ujs/practice/uxe/test/ux-link-product.ujs";

static int generated(const char *dir, const char *name, const char *source, const char *from, const char *to) {
    char wasm[320], modified[320], body[16384];
    char *cmd[] = {"./ujs/ujs2wasm.com", (char *)source, "-o", wasm, 0};
    char *out = 0;
    size_t out_n = 0;
    int rc;
    tx_snprintf(wasm, sizeof wasm, "%s/%s.wasm", dir, name);
    if (from) {
        unsigned char *bytes = 0;
        int64_t n = 0;
        long key_n = tx_len(from, 64);
        long at;
        int len;
        if (sy_read_file(source, &bytes, &n, sizeof body - 256)) return 1;
        at = tx_find((char *)bytes, n, from, key_n);
        if (at < 0 || tx_find((char *)bytes + at + key_n, n - at - key_n, from, key_n) >= 0) {
            mm_free(bytes);
            return 1;
        }
        len = tx_snprintf(body, sizeof body, "%.*s%s%s", (int)at, (char *)bytes, to, bytes + at + key_n);
        mm_free(bytes);
        if (len < 0 || len >= (int)sizeof body) return 1;
        tx_snprintf(modified, sizeof modified, "%s/%s.ujs", dir, name);
        if (sy_write_file(modified, body, len, 0600)) return 1;
        cmd[1] = modified;
    }
    rc = cx_runv_timeout(cmd, 8, &out, &out_n);
    if (rc) fprintf(stderr, "UX_LINK compile %s rc=%d %s\n", name, rc, out ? out : "");
    mm_free(out);
    return rc != 0;
}

static int copy_fixture(const char *dir, const char *leaf, const char *source) {
    char path[320];
    unsigned char *data = 0;
    int64_t n = 0;
    if (sy_read_file(source, &data, &n, 16384)) return 1;
    tx_snprintf(path, sizeof path, "%s/%s", dir, leaf);
    int rc = sy_write_file(path, data, n, 0600);
    mm_free(data);
    return rc != 0;
}

static int audio_rows(char *out, int cap) {
    const char *prefix[] = {"engine\ttriangle\t", "gun\tsquare\t", "missile\tsawtooth\t",
        "explosion\ttriangle\t", "lock\tsine\t"};
    unsigned char *data = 0;
    int64_t size = 0;
    if (sy_read_file("ujs/practice/uxe/test/d1-audio.tsv", &data, &size, 4096)) return -1;
    char *cursor = (char *)data;
    int used = 0, ok = 1;
    for (int row = 0; row < 5 && ok; row++) {
        long n = tx_len(prefix[row], 32);
        if (cursor + n > (char *)data + size || !tx_same(cursor, n, prefix[row], n)) { ok = 0; break; }
        cursor += n;
        for (int field = 1; field <= 5; field++) {
            char *end = 0;
            long number = tx_strtol(cursor, &end, 10);
            if (end == cursor || number < 1 || number > 4000 || *end != (field == 5 ? '\n' : '\t')) {
                ok = 0; break;
            }
            int written = tx_snprintf(out + used, cap - used, "audioTableWrite = ux_f32_put(%d, %ld.0);\n",
                4700000 + row * 24 + field * 4, number);
            if (written < 0 || written >= cap - used) { ok = 0; break; }
            used += written;
            cursor = end + 1;
        }
    }
    ok = ok && cursor == (char *)data + size;
    mm_free(data);
    return ok ? used : -1;
}

static int airframe_asset(const char *dir) {
    const char *names[] = {"wing", "fin", "root", "body", "keel", "plate", "jet"};
    const int heights[] = {10, 10, 7, 17, 11, 4, 8};
    const int stamps[][4] = {{0,8,21,1},{0,87,21,-1},{0,8,18,1},{0,87,18,-1},
        {2,28,18,1},{2,67,18,-1},{1,26,9,1},{1,69,9,-1},
        {4,36,25,1},{3,37,10,1},{5,43,25,1},{6,39,28,1},{6,50,28,1}};
    const char glyphs[] = "KDMLHGCBAOYSTUFRJW";
    const unsigned colors[] = {0x141a24,0x252e3c,0x3e4a56,0x64707a,0x8e9796,
        0x295c66,0x429ba4,0x8ad5cb,0x943c2a,0xd36132,0xed9448,
        0x556575,0xa8b3b5,0x263344,0xa74433,0xf15b31,0xffad4a,0xffe598};
    const char *rows[7][17];
    int lengths[7][17];
    unsigned char plate[96 * 50 * 4] = {0}, *source = 0;
    int64_t size = 0;
    int rc = 1;
    if (sy_read_file("ujs/practice/uxe/products/d1/airframe-art.tsv", &source, &size, 4096)) return 1;
    const char *at = (char *)source, *end = at + size;
    for (int part = 0; part < 7; part++) {
        long prefix = tx_len(names[part], 8);
        for (int row = 0; row < heights[part]; row++) {
            if (end - at <= prefix || !tx_same(at, prefix, names[part], prefix) || at[prefix] != '\t') goto done;
            at += prefix + 1;
            long len = tx_find(at, end - at, "\n", 1);
            if (len <= 0 || len > 40) goto done;
            rows[part][row] = at;
            lengths[part][row] = (int)len;
            at += len + 1;
        }
    }
    if (at != end) goto done;
    for (int i = 0; i < (int)(sizeof stamps / sizeof stamps[0]); i++) {
        int part = stamps[i][0];
        for (int y = 0; y < heights[part]; y++) {
            for (int x = 0; x < lengths[part][y]; x++) {
                char mark = rows[part][y][x];
                if (mark == '.') continue;
                long ink = tx_find(glyphs, sizeof glyphs - 1, &mark, 1);
                int px = stamps[i][1] + x * stamps[i][3], py = stamps[i][2] + y;
                if (ink < 0 || px < 0 || px >= 96 || py < 0 || py >= 50) goto done;
                unsigned rgb = colors[ink];
                int off = (py * 96 + px) * 4;
                plate[off] = rgb >> 16;
                plate[off + 1] = rgb >> 8;
                plate[off + 2] = rgb;
                plate[off + 3] = 255;
            }
        }
    }
    char path[320];
    tx_snprintf(path, sizeof path, "%s/airframe.rgba", dir);
    rc = sy_write_file(path, plate, sizeof plate, 0600) != 0;
done:
    mm_free(source);
    return rc;
}

static int projection_product(const char *dir, int mutate) {
    const char *sources[] = {"ujs/practice/uxe/products/d1/main.ujs", "ujs/practice/uxe/base/math.ujs",
        "ujs/practice/uxe/products/d1/terrain.ujs", "ujs/practice/uxe/products/d1/terrain-projection.ujs",
        "ujs/practice/uxe/products/d1/effects-audio.ujs", "ujs/practice/uxe/products/d1/combat-audio.ujs",
        "ujs/practice/uxe/products/d1/hud-overlay.ujs"};
    unsigned char *bytes[7] = {0};
    int64_t sizes[7] = {0};
    char path[320], audio[2048];
    char *program = (char *)mm_alloc(65536);
    int rc = 1;
    if (!program) return 1;
    for (int i = 0; i < 7; i++) if (sy_read_file(sources[i], &bytes[i], &sizes[i], 16384)) goto done;
    if (audio_rows(audio, sizeof audio) < 0 || airframe_asset(dir)) goto done;
    if (mutate == 1) {
        const char ray[] = "viewDepth <= 400.0";
        long pos = tx_find((char *)bytes[3], sizes[3], ray, sizeof ray - 1);
        if (pos < 0) goto done;
        bytes[3][pos + 13] = '0';
        bytes[3][pos + 15] = '4';
    }
    if (mutate == 2) {
        const char emit[] = "uxe_dispatch(6, 1600, 0)";
        long pos = tx_find((char *)bytes[5], sizes[5], emit, sizeof emit - 1);
        if (pos < 0) goto done;
        bytes[5][pos + 13] = '7';
    }
    long preamble = tx_find((char *)bytes[0], sizes[0], "\n\n", 2);
    const char tail[] = "\nreturn heading;";
    long body_end = tx_find((char *)bytes[0], sizes[0], tail, sizeof tail - 1);
    const char audio_tick[] = "  // D1 audio tick\n";
    const char audio_body[] = "if (audioGunSeen";
    long tick = tx_find((char *)bytes[0], sizes[0], audio_tick, sizeof audio_tick - 1);
    long voices = tx_find((char *)bytes[5], sizes[5], audio_body, sizeof audio_body - 1);
    if (preamble < 0 || tick <= preamble || body_end <= tick || voices < 0) goto done;
    int n = tx_snprintf(program, 65536,
        "%.*s\n%s\n%s\n%s\n%.*s\npersist let audioTableReady = 0;\n"
        "if (audioTableReady == 0) { let audioTableWrite = 0;\n%s audioTableReady = 1; }\n"
        "%.*s\n%s\n%.*s\n%s\n%s\n%s\nlet presented = uxe_dispatch(3, 0, 0);\nreturn heading;\n",
        (int)preamble, bytes[0], bytes[1], bytes[2], bytes[4], (int)voices, bytes[5], audio,
        (int)(tick - preamble), bytes[0] + preamble, bytes[5] + voices,
        (int)(body_end - tick), bytes[0] + tick, bytes[3], mutate == 3 ? "" :
        "let aircraftAsset = uxe_dispatch(4, 0, 19200);\n"
        "let aircraftPose = 213 + 4096 * (158 - f64_floor_i64(pitch * 0.55 + 0.5))"
        " + 16777216 * 96 + 68719476736 * 50;\n"
        "let aircraftDrawn = uxe_dispatch(12, aircraftPose, f64_floor_i64(bank * 37.81546712654381 + 0.5));\n",
        mutate == 4 ? "" : (char *)bytes[6]);
    if (n < 0 || n >= 65536) goto done;
    tx_snprintf(path, sizeof path, "%s/projection.ujs", dir);
    if (sy_write_file(path, program, n, 0600)) goto done;
    rc = generated(dir, "product", path, 0, 0);
    sy_unlink(path);
done:
    for (int i = 0; i < 7; i++) mm_free(bytes[i]);
    mm_free(program);
    return rc;
}

static int export_projection(const char *dir) {
    if (tx_len(dir, 250) <= 0 || sy_mkdir(dir, 0700)) return 2;
    int rc = generated(dir, "base", "ujs/practice/uxe/base/uxe.ujs", 0, 0) ||
        projection_product(dir, 0) ||
        copy_fixture(dir, "index.html", "ujs/practice/uxe/products/d1/projection-preview.html") ||
        copy_fixture(dir, "host-abi.js", "ujs/practice/uxe/base/host-abi.js");
    if (rc) {
        const char *leaves[] = {"base.wasm","product.wasm","index.html","host-abi.js","airframe.rgba"};
        char path[4096];
        for (int i = 0; i < 5; i++) {
            tx_snprintf(path, sizeof path, "%s/%s", dir, leaves[i]);
            sy_unlink(path);
        }
        sy_rmdir(dir);
    }
    printf("D1_PROJECTION_EXPORT dir=%s failed=%d\n", dir, rc);
    return rc;
}

typedef struct { int heading, bank, x, z, altitude, speed, pitch; } Flight;

static int approach(int value, int target, int increment) {
    if (value < target) return value + increment;
    if (value > target) return value - increment;
    return value;
}

static int move_axis(int heading, int speed) {
    int phase = heading % 180;
    int displacement = phase * (180 - phase) * speed / 8100;
    return heading >= 180 ? -displacement : displacement;
}

static int flight_gold(char *gold, int cap) {
    Flight state = {0, 0, 2048, 2048, 25, 12, 0};
    int n = tx_snprintf(gold, cap, "0 -1");
    for (int tick = 1; tick <= 27; tick++) {
        int turn = tick <= 6 || tick == 27 ? 1 : tick >= 13 && tick <= 18 ? -1 : 0;
        int climb = tick == 27 ? 0 : turn;
        int speed_target = climb == 0 ? 12 : 28;
        state.heading = (state.heading + 360 + 3 * turn) % 360;
        state.bank = approach(state.bank, 24 * turn, 4);
        state.speed = approach(state.speed, speed_target, 2);
        state.pitch = approach(state.pitch, 18 * climb, 3);
        state.altitude += climb;
        state.x = (state.x + move_axis(state.heading, state.speed) + 4096) % 4096;
        state.z = (state.z - move_axis((state.heading + 90) % 360, state.speed) + 4096) % 4096;
        if (tick % 6 == 0 || tick == 27) {
            int written = tx_snprintf(gold + n, cap - n, " 3,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d",
                state.heading % 256, state.heading / 256, 24 + state.bank,
                state.x % 256, state.x / 256, state.z % 256, state.z / 256,
                state.altitude, state.speed, 18 + state.pitch);
            if (written < 0 || written >= cap - n) return -1;
            n += written;
        }
    }
    const char cannon[] = " 95,1 95,1 94,2 0,96 0,96 96,96 36,0,4,1,8 36,1,4,0,8 0,1,4,0,8"
        " 1,0,0,0,0,0 2,4,5,3,9,5 2,1,36,13,2,0 2,1,36,1,2,0 2,1,0,0,0,1";
    if (cap - n < (int)sizeof cannon) return -1;
    return n + tx_snprintf(gold + n, cap - n, "%s", cannon);
}

static int projected_pixels(const char *text, long length) {
    const char *at = text;
    const long header[] = {426,240,0,3};
    long first[80];
    int sky = 0, ocean = 0, land = 0, changed = 0;
    for (int i = 0; i < 164; i++) {
        char *end = 0;
        long value = tx_strtol(at, &end, 10);
        if (end == at || end > text + length) return 1;
        at = end;
        if (i < 4) {
            if (value != header[i]) return 1;
            continue;
        }
        int j = i - 4, r = value & 255, g = (value >> 8) & 255, b = (value >> 16) & 255;
        if ((value >> 24) != 255) return 1;
        if (j < 80) {
            first[j] = value;
            if (j < 10 && r == 42 && g == 126 && b == 185) sky++;
            if (j >= 20 && b >= r + 32 && b >= g + 12 && r <= 160) ocean++;
            if (j >= 20 && g >= b + 12 && r >= 50) land++;
        } else if (first[j - 80] != value) changed++;
    }
    int failed = sky != 10 || ocean < 8 || land < 2 || changed < 6 || at != text + length;
    printf("D1_PROJECTION_PIXELS sky=%d ocean=%d land=%d view_change=%d failed=%d\n",
        sky, ocean, land, changed, failed);
    return failed;
}

static double effect_gain(int sample, int peak, int attack, int duration) {
    if (sample < attack) return peak * sample / (1000.0 * attack);
    return peak * (duration - sample) / (1000.0 * (duration - attack));
}

static int effect_pcm(double signal) {
    double rounded = signal * 32767.0 + 0.5;
    int cut = (int)rounded;
    return cut - (rounded < cut);
}

static int audio_gold(char *gold, int cap) {
    const double root3half = 0.8660254037844386;
    const double t = 100.0 / 48000.0;
    const double saw = 2 * (188 * t + (466 - 188) * t * t / (2 * 0.225)) - 1;
    const double triangle = 4 * (100 * t + (28 - 100) * t * t / (2 * 0.330)) - 1;
    return tx_snprintf(gold, cap, "1600,%d 1600,%d 1600,%d 1600,%d",
        effect_pcm(-root3half * effect_gain(100, 120, 384, 4800)),
        effect_pcm(root3half * effect_gain(1700, 120, 384, 4800) + effect_gain(100, 100, 144, 3120)),
        effect_pcm(-effect_gain(1700, 100, 144, 3120) + saw * effect_gain(100, 85, 432, 10800)),
        effect_pcm(triangle * effect_gain(100, 150, 240, 15840)));
}

static int browser(const char *dir, const char *mode, int base_check, int flight_check, int projection_check) {
    char profile[350], url[380], gold[1024], *out = 0;
    const char start[] = "<pre id=\"ux-link-result\">";
    const char end[] = "</pre>";
    char *cmd[] = {"google-chrome", "--headless=new", "--allow-file-access-from-files",
        "--disable-background-networking", "--no-first-run", profile, "--virtual-time-budget=4000",
        "--dump-dom", url, 0};
    size_t n = 0;
    long from, to;
    int rc, pass = 0;
    int own = 41, transfer = own + 1, clock = 17;
    tx_snprintf(profile, sizeof profile, "--user-data-dir=%s/chrome", dir);
    tx_snprintf(url, sizeof url, "file://%s/probe.html#%s", dir, mode);
    int gold_n = tx_snprintf(gold, sizeof gold, "%d %d %d 1 version signature trap missing",
        transfer * 1000 + transfer + clock, transfer, own);
    if (base_check) {
        gold_n = tx_snprintf(gold, sizeof gold,
            "%d 426 240 10,20,30,255 200,150,100,255 3 2 0 %d 2 0.5 -0.25 48000 -1 1 -1 -1",
            426 * 240, 3 * 10000 + 13 * 100 + 91);
    }
    if (flight_check) gold_n = flight_gold(gold, sizeof gold);
    if (projection_check == 2) gold_n = audio_gold(gold, sizeof gold);
    if (projection_check == 3) gold_n = tx_snprintf(gold, sizeof gold, "20,26,36,255 138,213,203,255 241,91,49,255");
    if (projection_check == 4) gold_n = tx_snprintf(gold, sizeof gold, "35,52,77,255 232,234,219,255 35,52,77,255 232,234,219,255");
    if (gold_n < 0) return 1;
    rc = cx_runv_timeout(cmd, 15, &out, &n);
    from = out ? tx_find(out, n, start, sizeof start - 1) : -1;
    if (from >= 0) {
        from += sizeof start - 1;
        to = tx_find(out + from, n - from, end, sizeof end - 1);
        if (to >= 0) {
            pass = !rc && (projection_check == 1 ? !projected_pixels(out + from, to) :
                tx_same(out + from, to, gold, gold_n));
            if (projection_check && to > 500) to = 0;
            printf("%s mode=%s val=%.*s failed=%d\n",
                projection_check == 2 ? "CHECK_UXE_D1_PCM" : projection_check ? "CHECK_UXE_D1_PROJECTION" :
                flight_check ? "CHECK_UXE_D1_FLIGHT_WASM" : base_check ? "CHECK_UXE_D1_BASE" : "CHECK_UXE_LINK",
                mode, (int)to, out + from, !pass);
        }
    }
    if (from < 0) fprintf(stderr, "UX_LINK browser rc=%d %s\n", rc, out ? out : "");
    mm_free(out);
    return !pass;
}

int main(int argc, char **argv) {
    char dir[256], *removed = 0;
    char *clean[] = {"rm", "-rf", "--", dir, 0};
    size_t removed_n = 0;
    if (argc == 3 && tx_eq(argv[1], "--export-projection", sizeof "--export-projection"))
        return export_projection(argv[2]);
    const char *mode = argc == 2 ? argv[1] : "";
    int base_check = tx_eq(mode, "base", 5) || tx_eq(mode, "base-color", 11);
    int cannon_mutate = tx_eq(mode, "flight-cannon", sizeof "flight-cannon");
    int hit_mutate = tx_eq(mode, "flight-hit", sizeof "flight-hit");
    int wave_mutate = tx_eq(mode, "flight-wave", sizeof "flight-wave");
    int missile_mutate = tx_eq(mode, "flight-missile", sizeof "flight-missile");
    int flight_check = tx_eq(mode, "flight", 7) || tx_eq(mode, "flight-heading", 15) ||
        cannon_mutate || hit_mutate || wave_mutate || missile_mutate;
    int projection_check = tx_eq(mode, "projection", 11) || tx_eq(mode, "projection-short", 17);
    int audio_mutate = tx_eq(mode, "projection-audio-mute", sizeof "projection-audio-mute");
    if (tx_eq(mode, "projection-audio", sizeof "projection-audio") || audio_mutate) projection_check = 2;
    int art_mutate = tx_eq(mode, "projection-art-missing", sizeof "projection-art-missing");
    if (tx_eq(mode, "projection-art", sizeof "projection-art") || art_mutate) projection_check = 3;
    int hud_mutate = tx_eq(mode, "projection-hud-missing", sizeof "projection-hud-missing");
    if (tx_eq(mode, "projection-hud", sizeof "projection-hud") || hud_mutate) projection_check = 4;
    if (argc > 2 || (argc == 2 && !tx_eq(mode, "version", 8) && !tx_eq(mode, "signature", 10) &&
        !tx_eq(mode, "bounds", 7) && !tx_eq(mode, "missing", 8) && !base_check && !flight_check && !projection_check)) return 2;
    if (sy_mkdtemp("/tmp", "uxe-link-", dir, sizeof dir)) return 2;
    int rc = copy_fixture(dir, "host-abi.js", "ujs/practice/uxe/base/host-abi.js");
    if (projection_check) {
        rc = rc || copy_fixture(dir, "probe.html", "ujs/practice/uxe/test/ux-d1-projection-probe.html") ||
            generated(dir, "base", "ujs/practice/uxe/base/uxe.ujs", 0, 0) ||
            projection_product(dir, hud_mutate ? 4 : art_mutate ? 3 : audio_mutate ? 2 : tx_eq(mode, "projection-short", 17));
    } else if (flight_check) {
        int mutate = tx_eq(mode, "flight-heading", 15);
        rc = rc || copy_fixture(dir, "probe.html", "ujs/practice/uxe/test/ux-d1-flight-probe.html") ||
            generated(dir, "base", "ujs/practice/uxe/base/uxe.ujs", 0, 0) ||
            generated(dir, "product", "ujs/practice/uxe/products/d1/main.ujs",
                missile_mutate ? "missileTravel = 13" : wave_mutate ? "battleDelay = 36" : hit_mutate ? "nearestSquare = 900" :
                    cannon_mutate ? "cannonCooldown = 5" : mutate ? "tickTurn * 3" : 0,
                missile_mutate ? "missileTravel = 12" : wave_mutate ? "battleDelay = 35" : hit_mutate ? "nearestSquare = 000" :
                    cannon_mutate ? "cannonCooldown = 4" : "tickTurn * 2");
    } else if (base_check) {
        int mutate = tx_eq(mode, "base-color", 11);
        char path[320];
        const unsigned char asset[] = {7, 13, 29, 91};
        tx_snprintf(path, sizeof path, "%s/asset.bin", dir);
        if (sy_write_file(path, asset, sizeof asset, 0600)) rc = 1;
        rc = rc || copy_fixture(dir, "probe.html", "ujs/practice/uxe/test/ux-d1-base-probe.html") ||
            generated(dir, "base", "ujs/practice/uxe/base/uxe.ujs", 0, 0) ||
            generated(dir, "product", "ujs/practice/uxe/test/ux-d1-base-product.ujs",
                mutate ? "4284782280" : 0, "4284782281");
    } else {
        rc = rc || copy_fixture(dir, "probe.html", "ujs/practice/uxe/test/ux-link-probe.html") ||
            generated(dir, "base", base_source, 0, 0) ||
            generated(dir, "product", product_source, 0, 0) ||
            generated(dir, "version", base_source, "version 1;", "version 2;") ||
            generated(dir, "signature", base_source, "value:i64)", "value:i64, spare:i64)");
    }
    rc = rc || browser(dir, mode, base_check, flight_check, projection_check);
    if (cx_runv_timeout(clean, 8, &removed, &removed_n)) rc = 1;
    mm_free(removed);
    return rc;
}
