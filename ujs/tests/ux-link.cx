#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

static const char base_source[] = "ujs/practice/uxe/test/ux-link-base.ujs";
static const char product_source[] = "ujs/practice/uxe/test/ux-link-product.ujs";

static int generated(const char *dir, const char *name, const char *source, const char *from, const char *to) {
    char wasm[320], modified[320], body[4096];
    char *cmd[] = {"./ujs/ujs2wasm.com", (char *)source, "-o", wasm, 0};
    char *out = 0;
    size_t out_n = 0;
    int rc;
    tx_snprintf(wasm, sizeof wasm, "%s/%s.wasm", dir, name);
    if (from) {
        unsigned char *bytes = 0;
        int64_t n = 0;
        long key_n = tx_len(from, 64);
        long at;
        int len;
        if (sy_read_file(source, &bytes, &n, sizeof body - 256)) return 1;
        at = tx_find((char *)bytes, n, from, key_n);
        if (at < 0 || tx_find((char *)bytes + at + key_n, n - at - key_n, from, key_n) >= 0) {
            mm_free(bytes);
            return 1;
        }
        len = tx_snprintf(body, sizeof body, "%.*s%s%s", (int)at, (char *)bytes, to, bytes + at + key_n);
        mm_free(bytes);
        if (len < 0 || len >= (int)sizeof body) return 1;
        tx_snprintf(modified, sizeof modified, "%s/%s.ujs", dir, name);
        if (sy_write_file(modified, body, len, 0600)) return 1;
        cmd[1] = modified;
    }
    rc = cx_runv_timeout(cmd, 8, &out, &out_n);
    if (rc) fprintf(stderr, "UX_LINK compile %s rc=%d %s\n", name, rc, out ? out : "");
    mm_free(out);
    return rc != 0;
}

static int copy_fixture(const char *dir, const char *leaf, const char *source) {
    char path[320];
    unsigned char *data = 0;
    int64_t n = 0;
    if (sy_read_file(source, &data, &n, 16384)) return 1;
    tx_snprintf(path, sizeof path, "%s/%s", dir, leaf);
    int rc = sy_write_file(path, data, n, 0600);
    mm_free(data);
    return rc != 0;
}

static int projection_product(const char *dir, int mutate) {
    const char *sources[] = {"ujs/practice/uxe/products/d1/main.ujs", "ujs/practice/uxe/base/math.ujs",
        "ujs/practice/uxe/products/d1/terrain.ujs", "ujs/practice/uxe/products/d1/terrain-projection.ujs"};
    unsigned char *bytes[4] = {0};
    int64_t sizes[4] = {0};
    char path[320];
    char *program = (char *)mm_alloc(65536);
    int rc = 1;
    if (!program) return 1;
    for (int i = 0; i < 4; i++) if (sy_read_file(sources[i], &bytes[i], &sizes[i], 16384)) goto done;
    if (mutate) {
        const char ray[] = "viewDepth <= 400.0";
        long pos = tx_find((char *)bytes[3], sizes[3], ray, sizeof ray - 1);
        if (pos < 0) goto done;
        bytes[3][pos + 13] = '0';
        bytes[3][pos + 15] = '4';
    }
    long preamble = tx_find((char *)bytes[0], sizes[0], "\n\n", 2);
    const char tail[] = "\nreturn heading;";
    long body_end = tx_find((char *)bytes[0], sizes[0], tail, sizeof tail - 1);
    if (preamble < 0 || body_end <= preamble) goto done;
    int n = tx_snprintf(program, 65536, "%.*s\n%s\n%s\n%.*s\n%s\nreturn heading;\n",
        (int)preamble, bytes[0], bytes[1], bytes[2],
        (int)(body_end - preamble), bytes[0] + preamble, bytes[3]);
    if (n < 0 || n >= 65536) goto done;
    tx_snprintf(path, sizeof path, "%s/projection.ujs", dir);
    if (sy_write_file(path, program, n, 0600)) goto done;
    rc = generated(dir, "product", path, 0, 0);
    sy_unlink(path);
done:
    for (int i = 0; i < 4; i++) mm_free(bytes[i]);
    mm_free(program);
    return rc;
}

static int export_projection(const char *dir) {
    if (tx_len(dir, 250) <= 0 || sy_mkdir(dir, 0700)) return 2;
    int rc = generated(dir, "base", "ujs/practice/uxe/base/uxe.ujs", 0, 0) ||
        projection_product(dir, 0) ||
        copy_fixture(dir, "index.html", "ujs/practice/uxe/products/d1/projection-preview.html") ||
        copy_fixture(dir, "host-abi.js", "ujs/practice/uxe/base/host-abi.js");
    if (rc) {
        const char *leaves[] = {"base.wasm","product.wasm","index.html","host-abi.js"};
        char path[4096];
        for (int i = 0; i < 4; i++) {
            tx_snprintf(path, sizeof path, "%s/%s", dir, leaves[i]);
            sy_unlink(path);
        }
        sy_rmdir(dir);
    }
    printf("D1_PROJECTION_EXPORT dir=%s failed=%d\n", dir, rc);
    return rc;
}

typedef struct { int heading, bank, x, z, altitude, speed, pitch; } Flight;

static int approach(int value, int target, int increment) {
    if (value < target) return value + increment;
    if (value > target) return value - increment;
    return value;
}

static int move_axis(int heading, int speed) {
    int phase = heading % 180;
    int displacement = phase * (180 - phase) * speed / 8100;
    return heading >= 180 ? -displacement : displacement;
}

static int flight_gold(char *gold, int cap) {
    Flight state = {0, 0, 2048, 2048, 25, 12, 0};
    int n = tx_snprintf(gold, cap, "0 -1");
    for (int tick = 1; tick <= 27; tick++) {
        int turn = tick <= 6 || tick == 27 ? 1 : tick >= 13 && tick <= 18 ? -1 : 0;
        int climb = tick == 27 ? 0 : turn;
        int speed_target = climb == 0 ? 12 : 28;
        state.heading = (state.heading + 360 + 3 * turn) % 360;
        state.bank = approach(state.bank, 24 * turn, 4);
        state.speed = approach(state.speed, speed_target, 2);
        state.pitch = approach(state.pitch, 18 * climb, 3);
        state.altitude += climb;
        state.x = (state.x + move_axis(state.heading, state.speed) + 4096) % 4096;
        state.z = (state.z - move_axis((state.heading + 90) % 360, state.speed) + 4096) % 4096;
        if (tick % 6 == 0 || tick == 27) {
            int written = tx_snprintf(gold + n, cap - n, " 3,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d",
                state.heading % 256, state.heading / 256, 24 + state.bank,
                state.x % 256, state.x / 256, state.z % 256, state.z / 256,
                state.altitude, state.speed, 18 + state.pitch);
            if (written < 0 || written >= cap - n) return -1;
            n += written;
        }
    }
    return n;
}

static int projected_pixels(const char *text, long length) {
    const char *at = text;
    const long header[] = {426,240,0,3};
    long first[80];
    int sky = 0, ocean = 0, land = 0, changed = 0;
    for (int i = 0; i < 164; i++) {
        char *end = 0;
        long value = tx_strtol(at, &end, 10);
        if (end == at || end > text + length) return 1;
        at = end;
        if (i < 4) {
            if (value != header[i]) return 1;
            continue;
        }
        int j = i - 4, r = value & 255, g = (value >> 8) & 255, b = (value >> 16) & 255;
        if ((value >> 24) != 255) return 1;
        if (j < 80) {
            first[j] = value;
            if (j < 10 && r == 42 && g == 126 && b == 185) sky++;
            if (j >= 20 && b >= r + 32 && b >= g + 12 && r <= 160) ocean++;
            if (j >= 20 && g >= b + 12 && r >= 50) land++;
        } else if (first[j - 80] != value) changed++;
    }
    int failed = sky != 10 || ocean < 8 || land < 2 || changed < 6 || at != text + length;
    printf("D1_PROJECTION_PIXELS sky=%d ocean=%d land=%d view_change=%d failed=%d\n",
        sky, ocean, land, changed, failed);
    return failed;
}

static int browser(const char *dir, const char *mode, int base_check, int flight_check, int projection_check) {
    char profile[350], url[380], gold[240], *out = 0;
    const char start[] = "<pre id=\"ux-link-result\">";
    const char end[] = "</pre>";
    char *cmd[] = {"google-chrome", "--headless=new", "--allow-file-access-from-files",
        "--disable-background-networking", "--no-first-run", profile, "--virtual-time-budget=4000",
        "--dump-dom", url, 0};
    size_t n = 0;
    long from, to;
    int rc, pass = 0;
    int own = 41, transfer = own + 1, clock = 17;
    tx_snprintf(profile, sizeof profile, "--user-data-dir=%s/chrome", dir);
    tx_snprintf(url, sizeof url, "file://%s/probe.html#%s", dir, mode);
    int gold_n = tx_snprintf(gold, sizeof gold, "%d %d %d 1 version signature trap missing",
        transfer * 1000 + transfer + clock, transfer, own);
    if (base_check) {
        gold_n = tx_snprintf(gold, sizeof gold,
            "%d 426 240 10,20,30,255 200,150,100,255 3 2 0 %d 2 0.5 -0.25 48000 -1 1 -1 -1",
            426 * 240, 3 * 10000 + 13 * 100 + 91);
    }
    if (flight_check) gold_n = flight_gold(gold, sizeof gold);
    if (gold_n < 0) return 1;
    rc = cx_runv_timeout(cmd, 15, &out, &n);
    from = out ? tx_find(out, n, start, sizeof start - 1) : -1;
    if (from >= 0) {
        from += sizeof start - 1;
        to = tx_find(out + from, n - from, end, sizeof end - 1);
        if (to >= 0) {
            pass = !rc && (projection_check ? !projected_pixels(out + from, to) : tx_same(out + from, to, gold, gold_n));
            if (projection_check && to > 500) to = 0;
            printf("%s mode=%s val=%.*s failed=%d\n",
                projection_check ? "CHECK_UXE_D1_PROJECTION" :
                flight_check ? "CHECK_UXE_D1_FLIGHT_WASM" : base_check ? "CHECK_UXE_D1_BASE" : "CHECK_UXE_LINK",
                mode, (int)to, out + from, !pass);
        }
    }
    if (from < 0) fprintf(stderr, "UX_LINK browser rc=%d %s\n", rc, out ? out : "");
    mm_free(out);
    return !pass;
}

int main(int argc, char **argv) {
    char dir[256], *removed = 0;
    char *clean[] = {"rm", "-rf", "--", dir, 0};
    size_t removed_n = 0;
    if (argc == 3 && tx_eq(argv[1], "--export-projection", sizeof "--export-projection"))
        return export_projection(argv[2]);
    const char *mode = argc == 2 ? argv[1] : "";
    int base_check = tx_eq(mode, "base", 5) || tx_eq(mode, "base-color", 11);
    int flight_check = tx_eq(mode, "flight", 7) || tx_eq(mode, "flight-heading", 15);
    int projection_check = tx_eq(mode, "projection", 11) || tx_eq(mode, "projection-short", 17);
    if (argc > 2 || (argc == 2 && !tx_eq(mode, "version", 8) && !tx_eq(mode, "signature", 10) &&
        !tx_eq(mode, "bounds", 7) && !tx_eq(mode, "missing", 8) && !base_check && !flight_check && !projection_check)) return 2;
    if (sy_mkdtemp("/tmp", "uxe-link-", dir, sizeof dir)) return 2;
    int rc = copy_fixture(dir, "host-abi.js", "ujs/practice/uxe/base/host-abi.js");
    if (projection_check) {
        rc = rc || copy_fixture(dir, "probe.html", "ujs/practice/uxe/test/ux-d1-projection-probe.html") ||
            generated(dir, "base", "ujs/practice/uxe/base/uxe.ujs", 0, 0) ||
            projection_product(dir, tx_eq(mode, "projection-short", 17));
    } else if (flight_check) {
        int mutate = tx_eq(mode, "flight-heading", 15);
        rc = rc || copy_fixture(dir, "probe.html", "ujs/practice/uxe/test/ux-d1-flight-probe.html") ||
            generated(dir, "base", "ujs/practice/uxe/base/uxe.ujs", 0, 0) ||
            generated(dir, "product", "ujs/practice/uxe/products/d1/main.ujs",
                mutate ? "tickTurn * 3" : 0, "tickTurn * 2");
    } else if (base_check) {
        int mutate = tx_eq(mode, "base-color", 11);
        char path[320];
        const unsigned char asset[] = {7, 13, 29, 91};
        tx_snprintf(path, sizeof path, "%s/asset.bin", dir);
        if (sy_write_file(path, asset, sizeof asset, 0600)) rc = 1;
        rc = rc || copy_fixture(dir, "probe.html", "ujs/practice/uxe/test/ux-d1-base-probe.html") ||
            generated(dir, "base", "ujs/practice/uxe/base/uxe.ujs", 0, 0) ||
            generated(dir, "product", "ujs/practice/uxe/test/ux-d1-base-product.ujs",
                mutate ? "4284782280" : 0, "4284782281");
    } else {
        rc = rc || copy_fixture(dir, "probe.html", "ujs/practice/uxe/test/ux-link-probe.html") ||
            generated(dir, "base", base_source, 0, 0) ||
            generated(dir, "product", product_source, 0, 0) ||
            generated(dir, "version", base_source, "version 1;", "version 2;") ||
            generated(dir, "signature", base_source, "value:i64)", "value:i64, spare:i64)");
    }
    rc = rc || browser(dir, mode, base_check, flight_check, projection_check);
    if (cx_runv_timeout(clean, 8, &removed, &removed_n)) rc = 1;
    mm_free(removed);
    return rc;
}
