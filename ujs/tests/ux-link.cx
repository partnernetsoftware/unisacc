#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

static const char base_source[] = "ujs/practice/uxe/test/ux-link-base.ujs";
static const char product_source[] = "ujs/practice/uxe/test/ux-link-product.ujs";

static int generated(const char *dir, const char *name, const char *source, const char *from, const char *to) {
    char wasm[320], modified[320], body[32768];
    char *cmd[] = {"./ujs/ujs2wasm.com", (char *)source, "-o", wasm, 0};
    char *out = 0;
    size_t out_n = 0;
    int rc;
    tx_snprintf(wasm, sizeof wasm, "%s/%s.wasm", dir, name);
    if (from) {
        unsigned char *bytes = 0;
        int64_t n = 0;
        long key_n = tx_len(from, 64);
        long at;
        int len;
        if (sy_read_file(source, &bytes, &n, sizeof body - 256)) return 1;
        at = tx_find((char *)bytes, n, from, key_n);
        if (at < 0 || tx_find((char *)bytes + at + key_n, n - at - key_n, from, key_n) >= 0) {
            mm_free(bytes);
            return 1;
        }
        len = tx_snprintf(body, sizeof body, "%.*s%s%s", (int)at, (char *)bytes, to, bytes + at + key_n);
        mm_free(bytes);
        if (len < 0 || len >= (int)sizeof body) return 1;
        tx_snprintf(modified, sizeof modified, "%s/%s.ujs", dir, name);
        if (sy_write_file(modified, body, len, 0600)) return 1;
        cmd[1] = modified;
    }
    rc = cx_runv_timeout(cmd, 8, &out, &out_n);
    if (rc) fprintf(stderr, "UX_LINK compile %s rc=%d %s\n", name, rc, out ? out : "");
    mm_free(out);
    return rc != 0;
}

static int copy_fixture(const char *dir, const char *leaf, const char *source) {
    char path[320];
    unsigned char *data = 0;
    int64_t n = 0;
    if (sy_read_file(source, &data, &n, 1048576)) return 1;
    tx_snprintf(path, sizeof path, "%s/%s", dir, leaf);
    int rc = sy_write_file(path, data, n, 0600);
    mm_free(data);
    return rc != 0;
}

static int copy_package_file(const char *dir, const char *package, const char *name) {
    char path[512];
    int n = tx_snprintf(path, sizeof path, "%s/%s", package, name);
    return n < 0 || n >= (int)sizeof path || copy_fixture(dir, name, path);
}

static int audio_rows(char *out, int cap) {
    const char *prefix[] = {"engine\ttriangle\t", "gun\tsquare\t", "missile\tsawtooth\t",
        "explosion\ttriangle\t", "lock\tsine\t"};
    unsigned char *data = 0;
    int64_t size = 0;
    if (sy_read_file("ujs/practice/uxe/test/d1-audio.tsv", &data, &size, 4096)) return -1;
    char *cursor = (char *)data;
    int used = 0, ok = 1;
    for (int row = 0; row < 5 && ok; row++) {
        long n = tx_len(prefix[row], 32);
        if (cursor + n > (char *)data + size || !tx_same(cursor, n, prefix[row], n)) { ok = 0; break; }
        cursor += n;
        for (int field = 1; field <= 5; field++) {
            char *end = 0;
            long number = tx_strtol(cursor, &end, 10);
            if (end == cursor || number < 1 || number > 4000 || *end != (field == 5 ? '\n' : '\t')) {
                ok = 0; break;
            }
            int written = tx_snprintf(out + used, cap - used, "audioTableWrite = ux_f32_put(%d, %ld.0);\n",
                4700000 + row * 24 + field * 4, number);
            if (written < 0 || written >= cap - used) { ok = 0; break; }
            used += written;
            cursor = end + 1;
        }
    }
    ok = ok && cursor == (char *)data + size;
    mm_free(data);
    return ok ? used : -1;
}

static int sprite_asset(const char *dir) {
    const char *names[] = {"wing", "fin", "root", "body", "keel", "plate", "jet"};
    const int heights[] = {10, 10, 7, 17, 11, 4, 8};
    const int stamps[][4] = {{0,8,21,1},{0,87,21,-1},{0,8,18,1},{0,87,18,-1},
        {2,28,18,1},{2,67,18,-1},{1,26,9,1},{1,69,9,-1},
        {4,36,25,1},{3,37,10,1},{5,43,25,1},{6,39,28,1},{6,50,28,1}};
    const char glyphs[] = "KDMLHGCBAOYSTUFRJW";
    const unsigned colors[] = {0x141a24,0x252e3c,0x3e4a56,0x64707a,0x8e9796,
        0x295c66,0x429ba4,0x8ad5cb,0x943c2a,0xd36132,0xed9448,
        0x556575,0xa8b3b5,0x263344,0xa74433,0xf15b31,0xffad4a,0xffe598};
    const char *rows[7][17];
    int lengths[7][17];
    unsigned char plate[96 * 50 * 4 + 2 * 19 * 6 * 4 + 3 * (17 * 6 + 11 * 4) * 4] = {0}, *source = 0;
    int64_t size = 0;
    int rc = 1;
    if (sy_read_file("ujs/practice/uxe/products/d1/airframe-art.tsv", &source, &size, 4096)) return 1;
    const char *at = (char *)source, *end = at + size;
    for (int part = 0; part < 7; part++) {
        long prefix = tx_len(names[part], 8);
        for (int row = 0; row < heights[part]; row++) {
            if (end - at <= prefix || !tx_same(at, prefix, names[part], prefix) || at[prefix] != '\t') goto done;
            at += prefix + 1;
            long len = tx_find(at, end - at, "\n", 1);
            if (len <= 0 || len > 40) goto done;
            rows[part][row] = at;
            lengths[part][row] = (int)len;
            at += len + 1;
        }
    }
    if (at != end) goto done;
    for (int i = 0; i < (int)(sizeof stamps / sizeof stamps[0]); i++) {
        int part = stamps[i][0];
        for (int y = 0; y < heights[part]; y++) {
            for (int x = 0; x < lengths[part][y]; x++) {
                char mark = rows[part][y][x];
                if (mark == '.') continue;
                long ink = tx_find(glyphs, sizeof glyphs - 1, &mark, 1);
                int px = stamps[i][1] + x * stamps[i][3], py = stamps[i][2] + y;
                if (ink < 0 || px < 0 || px >= 96 || py < 0 || py >= 50) goto done;
                unsigned rgb = colors[ink];
                int off = (py * 96 + px) * 4;
                plate[off] = rgb >> 16;
                plate[off + 1] = rgb >> 8;
                plate[off + 2] = rgb;
                plate[off + 3] = 255;
            }
        }
    }
    const char puff[][20] = {"........LLL........",".....LLLWWWWL......",
        "..LLLWWWWWWWWWLL...",".LWWWWWWWWWWWWWWLL.","LLLWWWWWWWWWWWWLLLL","...LLLLLLLLLLLL...."};
    const unsigned cloudColors[][2] = {{0xb7d1d9,0xdce9e8},{0xa7c7d6,0xf5f4e8}};
    for (int layer = 0; layer < 2; layer++) {
        for (int row = 0; row < 6; row++) for (int col = 0; col < 19; col++) {
            if (puff[row][col] == '.') continue;
            unsigned rgb = cloudColors[layer][puff[row][col] == 'W'];
            int off = 19200 + 4 * ((layer * 6 + row) * 19 + col);
            plate[off] = rgb >> 16;
            plate[off + 1] = rgb >> 8;
            plate[off + 2] = rgb;
            plate[off + 3] = 255;
        }
    }
    const char enemy[18][18] = {
        "...OW.......WO...","...OW..BBB..WO...","..KOOKMBBBMKOOK..","KKODOOMMMMMOODOKK","KKKDKMMMMMMMDKKKK","...KKO.KKK.OKK...",
        "....OW.....WO....","...OW..BBB..WO...","..KOOKMBBBMKOOK..","KKODOOMMMMMOODOKK","KKKDKMMMMMMMDKKKK","...KKO.KKK.OKK...",
        ".....OW...WO.....","....OW.BBB.WO....","..KOOKMBBBMKOOK..","KKODOOMMMMMOODOKK","KKKDKMMMMMMMDKKKK","...KKO.KKK.OKK..."
    };
    const unsigned enemyColors[] = {0xf3b450,0xe47731,0x2b2030,0x70422d,0xa65b35,0x79c5bd};
    const char enemyInk[] = "WOKDMB";
    for (int variant = 0; variant < 2; variant++) {
        int w = variant ? 11 : 17, h = variant ? 4 : 6;
        for (int kind = 0; kind < 3; kind++) {
            for (int row = 0; row < h; row++) for (int col = 0; col < w; col++) {
                char mark = enemy[kind * 6 + row * 6 / h][col * 17 / w];
                if (mark == '.') continue;
                long ink = tx_find(enemyInk, sizeof enemyInk - 1, &mark, 1);
                if (ink < 0) goto done;
                unsigned rgb = enemyColors[ink];
                int off = 20112 + (variant ? 1224 : 0) + 4 * ((kind * h + row) * w + col);
                plate[off] = rgb >> 16;
                plate[off + 1] = rgb >> 8;
                plate[off + 2] = rgb;
                plate[off + 3] = 255;
            }
        }
    }
    char path[320];
    tx_snprintf(path, sizeof path, "%s/d1-sprites.rgba", dir);
    rc = sy_write_file(path, plate, sizeof plate, 0600) != 0;
done:
    mm_free(source);
    return rc;
}

static int projection_product(const char *dir, int mutate) {
    const char *sources[] = {"ujs/practice/uxe/products/d1/main.ujs", "ujs/practice/uxe/base/math.ujs",
        "ujs/practice/uxe/products/d1/terrain.ujs", "ujs/practice/uxe/products/d1/terrain-projection.ujs",
        "ujs/practice/uxe/products/d1/effects-audio.ujs", "ujs/practice/uxe/products/d1/combat-audio.ujs",
        "ujs/practice/uxe/products/d1/hud-overlay.ujs", "ujs/practice/uxe/products/d1/cloud-overlay.ujs",
        "ujs/practice/uxe/products/d1/enemy-overlay.ujs", "ujs/practice/uxe/products/d1/trail-overlay.ujs"};
    unsigned char *bytes[10] = {0};
    int64_t sizes[10] = {0};
    char path[320], audio[2048];
    char *program = (char *)mm_alloc(65536);
    int rc = 1;
    if (!program) return 1;
    for (int i = 0; i < 10; i++) if (sy_read_file(sources[i], &bytes[i], &sizes[i], 16384)) goto done;
    if (audio_rows(audio, sizeof audio) < 0 || sprite_asset(dir)) goto done;
    if (mutate == 1) {
        const char ray[] = "viewDepth <= 400.0";
        long pos = tx_find((char *)bytes[3], sizes[3], ray, sizeof ray - 1);
        if (pos < 0) goto done;
        bytes[3][pos + 13] = '0';
        bytes[3][pos + 15] = '4';
    }
    if (mutate == 2) {
        const char emit[] = "uxe_dispatch(6, 1600, 0)";
        long pos = tx_find((char *)bytes[5], sizes[5], emit, sizeof emit - 1);
        if (pos < 0) goto done;
        bytes[5][pos + 13] = '7';
    }
    if (mutate == 6 || mutate == 9) {
        const char *detail = mutate == 6 ? "let wavePass = 0" : "{ wavePass = 3";
        long len = tx_len(detail, 32);
        long pos = tx_find((char *)bytes[3], sizes[3], detail, len);
        if (pos < 0) goto done;
        bytes[3][pos + len - 1] = '7';
    }
    long preamble = tx_find((char *)bytes[0], sizes[0], "\n\n", 2);
    const char tail[] = "\nreturn heading;";
    long body_end = tx_find((char *)bytes[0], sizes[0], tail, sizeof tail - 1);
    const char audio_tick[] = "  // D1 audio tick\n";
    const char audio_body[] = "if (audioGunSeen";
    long tick = tx_find((char *)bytes[0], sizes[0], audio_tick, sizeof audio_tick - 1);
    long voices = tx_find((char *)bytes[5], sizes[5], audio_body, sizeof audio_body - 1);
    if (preamble < 0 || tick <= preamble || body_end <= tick || voices < 0) goto done;
    int n = tx_snprintf(program, 65536,
        "%.*s\n%s\n%s\n%s\n%.*s\npersist let audioTableReady = 0;\n"
        "if (audioTableReady == 0) { let audioTableWrite = 0;\n%s audioTableReady = 1; }\n"
        "%.*s\n%s\n%.*s\n%s\n%s\n%s\n%s\n%s\n%s\npacketWrite = uxe_dispatch(3, 0, 0);\nreturn heading;\n",
        (int)preamble, bytes[0], bytes[1], bytes[2], bytes[4], (int)voices, bytes[5], audio,
        (int)(tick - preamble), bytes[0] + preamble, bytes[5] + voices,
        (int)(body_end - tick), bytes[0] + tick, bytes[3], mutate == 5 ? "" : (char *)bytes[7],
        mutate == 7 ? "" : (char *)bytes[8], mutate == 8 ? "" : (char *)bytes[9], mutate == 3 ? "" :
        "if (uxe_dispatch(4, 0, 19200) == 19200) {\n"
        "  packetWrite = uxe_dispatch(12, 213 + 4096 * (158 - f64_floor_i64(pitch * 0.55 + 0.5))"
        " + 16777216 * 96 + 68719476736 * 50, f64_floor_i64(bank * 37.81546712654381 + 0.5));\n}\n",
        mutate == 4 ? "" : (char *)bytes[6]);
    if (n < 0 || n >= 65536) goto done;
    tx_snprintf(path, sizeof path, "%s/projection.ujs", dir);
    if (sy_write_file(path, program, n, 0600)) goto done;
    rc = generated(dir, "product", path, 0, 0);
    sy_unlink(path);
done:
    for (int i = 0; i < 10; i++) mm_free(bytes[i]);
    mm_free(program);
    return rc;
}

static int export_projection(const char *dir) {
    if (tx_len(dir, 250) <= 0 || sy_mkdir(dir, 0700)) return 2;
    int rc = generated(dir, "base", "ujs/practice/uxe/base/uxe.ujs", 0, 0) ||
        projection_product(dir, 0) ||
        copy_fixture(dir, "index.html", "ujs/practice/uxe/products/d1/projection-preview.html") ||
        copy_fixture(dir, "host-abi.js", "ujs/practice/uxe/base/host-abi.js");
    if (rc) {
        const char *leaves[] = {"base.wasm","product.wasm","index.html","host-abi.js","d1-sprites.rgba"};
        char path[4096];
        for (int i = 0; i < 5; i++) {
            tx_snprintf(path, sizeof path, "%s/%s", dir, leaves[i]);
            sy_unlink(path);
        }
        sy_rmdir(dir);
    }
    printf("D1_PROJECTION_EXPORT dir=%s failed=%d\n", dir, rc);
    return rc;
}

typedef struct { int heading, bank, x, z, altitude, speed, pitch; } Flight;

static int approach(int value, int target, int increment) {
    if (value < target) return value + increment;
    if (value > target) return value - increment;
    return value;
}

static int move_axis(int heading, int speed) {
    int phase = heading % 180;
    int displacement = phase * (180 - phase) * speed / 8100;
    return heading >= 180 ? -displacement : displacement;
}

static int flight_gold(char *gold, int cap) {
    Flight state = {0, 0, 2048, 2048, 25, 12, 0};
    int n = tx_snprintf(gold, cap, "0 -1");
    for (int tick = 1; tick <= 27; tick++) {
        int turn = tick <= 6 || tick == 27 ? 1 : tick >= 13 && tick <= 18 ? -1 : 0;
        int climb = tick == 27 ? 0 : turn;
        int speed_target = climb == 0 ? 12 : 28;
        state.heading = (state.heading + 360 + 3 * turn) % 360;
        state.bank = approach(state.bank, 24 * turn, 4);
        state.speed = approach(state.speed, speed_target, 2);
        state.pitch = approach(state.pitch, 18 * climb, 3);
        state.altitude += climb;
        state.x = (state.x + move_axis(state.heading, state.speed) + 4096) % 4096;
        state.z = (state.z - move_axis((state.heading + 90) % 360, state.speed) + 4096) % 4096;
        if (tick % 6 == 0 || tick == 27) {
            int written = tx_snprintf(gold + n, cap - n, " 3,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d",
                state.heading % 256, state.heading / 256, 24 + state.bank,
                state.x % 256, state.x / 256, state.z % 256, state.z / 256,
                state.altitude, state.speed, 18 + state.pitch);
            if (written < 0 || written >= cap - n) return -1;
            n += written;
        }
    }
    const char cannon[] = " 95,1 95,1 94,2 0,96 0,96 96,96 36,0,4,1,8 36,1,4,0,8 0,1,4,0,8"
        " 1,0,0,0,0,0 2,4,5,3,9,5 2,1,36,13,2,0 2,1,36,1,2,0 2,1,0,0,0,1"
        " 0,96,1,1,100,0,2 0,96,1,1,80,6,2 0,96,1,1,0,6,2 0,96,1,1,0,6,2 0,96,0,1,100,0,3";
    if (cap - n < (int)sizeof cannon) return -1;
    return n + tx_snprintf(gold + n, cap - n, "%s", cannon);
}

static double pilot_wave(double sample) {
    const double pi = 3.141592653589793;
    while (sample > pi) sample -= 2 * pi;
    if (sample > pi / 2) sample = pi - sample;
    if (sample < -pi / 2) sample = -pi - sample;
    double term = sample, result = sample;
    for (int i = 1; i <= 9; i++) {
        term *= -sample * sample / ((2 * i) * (2 * i + 1));
        result += term;
    }
    return result;
}

static int pilot_round(double value) {
    double v = value * 1000.0 + 0.5;
    int truncated = (int)v;
    return truncated - (truncated > v);
}

static int pilot_gold(char *gold, int cap) {
    double x = 0, z = 0, speed = 0.35, yaw = 0;
    int used = 0, contacts = 0;
    for (int tick = 1; tick <= 320; tick++) {
        int direction = tick <= 240 ? 1 : -1;
        double bank = 12.3 + 1.9 * pilot_wave(z / 39);
        double center = 5.4 * pilot_wave(z / 49) + 4.3 * pilot_wave(z / 117);
        yaw += 0.13 * (direction - yaw);
        x += yaw * (0.12 + 0.17 * speed) + 0.011 * (center - x);
        int hit = x < center - bank || x > center + bank;
        if (x < center - bank) x = center - bank;
        if (x > center + bank) x = center + bank;
        contacts += hit;
        speed += ((hit ? 0.16 : direction > 0 ? 1.65 : -0.48) - speed) * (hit ? 0.30 : 0.085);
        z += speed;
        if (z < 0) z = 0;
        if (z > 1728) z = 1728;
        if (tick == 1 || tick == 24 || tick == 96 || tick == 180 || tick == 240 || tick == 280 || tick == 320) {
            int n = tx_snprintf(gold + used, cap - used, "%s%d,%d,%d,%d,%d", used ? " " : "",
                tick, pilot_round(x), pilot_round(z), pilot_round(speed), contacts);
            if (n < 0 || n >= cap - used) return -1;
            used += n;
        }
    }
    return contacts ? used : -1;
}

enum { WATER_GLYPHS=19, WATER_ROWS=28, WATER_LARGE=1024, WATER_SMALL=576 };

static int water_font_rows(unsigned rows[WATER_GLYPHS][WATER_ROWS]) {
    const char digits[]="0123456789abcdef";
    unsigned char *data=0;
    int64_t count=0;
    int rc=1;
    if(sy_read_file("ujs/practice/uxe/products/d2/water-glyphs.tsv",&data,&count,4096)) return 1;
    const char *at=(char *)data,*end=at+count;
    while(at<end && *at=='#') {
        long line=tx_find(at,end-at,"\n",1);
        if(line<0) goto done;
        at+=line+1;
    }
    for(int glyph=0;glyph<WATER_GLYPHS;glyph++) {
        long name=tx_find(at,end-at,"\t",1);
        if(name!=3) goto done;
        at+=name+1;
        for(int row=0;row<WATER_ROWS;row++) {
            if(row==16 && (at>=end || *at++!='\t')) goto done;
            if(end-at<4) goto done;
            unsigned mask=0;
            for(int i=0;i<4;i++) {
                long value=tx_find(digits,16,at+i,1);
                if(value<0) goto done;
                mask=mask*16+(unsigned)value;
            }
            at+=4;
            if(row>=16 && mask>=4096) goto done;
            rows[glyph][row]=mask;
        }
        if(at>=end || *at!='\n') goto done;
        at++;
    }
    rc=at!=end;
done:
    mm_free(data);
    return rc;
}

static int water_font_asset(const char *dir,int mutate) {
    unsigned rows[WATER_GLYPHS][WATER_ROWS];
    unsigned char atlas[WATER_GLYPHS*(WATER_LARGE+WATER_SMALL)]={0};
    if(water_font_rows(rows)) return 1;
    for(int glyph=0;glyph<WATER_GLYPHS;glyph++) for(int row=0;row<WATER_ROWS;row++) {
        int large=row<16, width=large?16:12, y=large?row:row-16;
        int start=large?glyph*WATER_LARGE:WATER_GLYPHS*WATER_LARGE+glyph*WATER_SMALL;
        unsigned mask=rows[glyph][row];
        if(mutate==13 && glyph==0 && large) mask=(mask<<1)&65535u;
        for(int x=0;x<width;x++) if(mask&(1u<<x)) {
            int address=start+4*(y*width+x);
            atlas[address]=249;
            atlas[address+1]=230;
            atlas[address+2]=187;
            atlas[address+3]=255;
        }
    }
    char path[320];
    tx_snprintf(path,sizeof path,"%s/d2-type.rgba",dir);
    return sy_write_file(path,atlas,sizeof atlas,0600)!=0;
}

static int water_font_iou(const char *pixels,long length) {
    const char *names[]={"灯","舟","水","道","1","/","8","苇","汀"};
    const unsigned numbers[]={29850,4688,31727};
    unsigned expected[WATER_GLYPHS][WATER_ROWS];
    long at=0;
    int failed=0;
    if(water_font_rows(expected)) return 1;
    for(int glyph=0;glyph<9;glyph++) {
        int digits=glyph>=4 && glyph<=6;
        int width=glyph<4?16:digits?3:12;
        int height=digits?5:width;
        int intersection=0,total=0;
        for(int y=0;y<height;y++) {
            unsigned row=glyph<4?expected[glyph][y]:digits?numbers[glyph-4]>>(3*y):expected[glyph-3][16+y];
            for(int x=0;x<width;x++) {
                if(at>=length || (pixels[at]!='0' && pixels[at]!='1')) return 1;
                int got=pixels[at++]=='1',want=(row>>x)&1u;
                intersection+=got && want;
                total+=got || want;
            }
        }
        int iou=total?intersection*1000/total:0;
        printf("D2_GLYPH %s iou_milli=%d\n",names[glyph],iou);
        if(iou<980) failed++;
    }
    return failed || at!=length;
}

static int walk_rows(int rows[8][7]) {
    unsigned char *data=0;
    int64_t size=0;
    int rc=1;
    if(sy_read_file("ujs/practice/uxe/test/d3-walk-audit.tsv",&data,&size,4096)) return 1;
    long header=tx_find((char *)data,size,"\n",1);
    if(header<0) goto done;
    char *at=(char *)data+header+1;
    for(int y=0;y<8;y++) for(int x=0;x<7;x++) {
        char *end=0;
        long value=tx_strtol(at,&end,10);
        if(end==at || end>=(char *)data+size || *end!=(x==6?'\n':'\t') || value< -100000 || value>100000) goto done;
        rows[y][x]=(int)value;
        at=end+1;
    }
    if(at!=(char *)data+size || rows[0][0]!=0 || rows[7][0]!=67000) goto done;
    for(int i=1;i<8;i++) if(rows[i][0]<=rows[i-1][0]) goto done;
    rc=0;
done:
    mm_free(data);
    return rc;
}

static int walk_asset(const char *dir,int scene) {
    int rows[8][7];
    const unsigned sizes[]={224,57600,65536};
    const char *assets[]={"ujs/practice/uxe/test/d3-cloud-soft.rgba","ujs/practice/uxe/test/d3-detail.rgba"};
    int size=scene?sizes[0]+sizes[1]+sizes[2]:sizes[0];
    unsigned char *bytes=mm_alloc(size);
    char path[320];
    int rc=1;
    if(!bytes) return 1;
    if(walk_rows(rows)) goto done;
    for(int y=0;y<8;y++) for(int x=0;x<7;x++) {
        unsigned value=(unsigned)rows[y][x];
        for(int b=0;b<4;b++) bytes[4*(7*y+x)+b]=value>>(8*b);
    }
    for(int i=0,at=224;scene && i<2;i++) {
        unsigned char *part=0;
        int64_t length=0;
        int err=sy_read_file(assets[i],&part,&length,sizes[i+1]);
        if(!err && length==sizes[i+1])
            for(int j=0;j<length;j++) bytes[at+j]=part[j];
        mm_free(part);
        if(err || length!=sizes[i+1]) goto done;
        at+=length;
    }
    tx_snprintf(path,sizeof path,"%s/route.bin",dir);
    rc=sy_write_file(path,bytes,size,0600)!=0;
done:
    mm_free(bytes);
    return rc;
}

static int bridge_product(const char *dir,int mutate) {
    const char *sources[]={"ujs/practice/uxe/products/d3/route.ujs",
        "ujs/practice/uxe/base/math.ujs","ujs/practice/uxe/products/d3/bridge.ujs",
        "ujs/practice/uxe/products/d3/valley.ujs","ujs/practice/uxe/products/d3/house.ujs",
        "ujs/practice/uxe/products/d3/foliage.ujs"};
    unsigned char *bytes[6]={0};
    int64_t sizes[6]={0};
    char path[320],body[24576];
    int rc=1;
    for(int i=0;i<6;i++) if(sy_read_file(sources[i],&bytes[i],&sizes[i],8192)) goto done;
    long tail=tx_find((char *)bytes[0],sizes[0],"return walkTick;",16);
    long header=tx_find((char *)bytes[0],sizes[0],"\n\n",2);
    if(header<0 || tail<header) goto done;
    const char *valley=mutate==2?"":(char *)bytes[3];
    const char *house=mutate==3?"":(char *)bytes[4];
    const char *foliage=mutate==4?"":(char *)bytes[5];
    int n=tx_snprintf(body,sizeof body,"%.*s\n%s\n%.*s\n%s\n%s\n%s\n%s\n"
        "sceneCall = uxe_dispatch(34, 2, 22 + 25 * 256 + 22 * 65536);\nsceneCall = uxe_dispatch(3, 0, 0);\nreturn walkTick;\n",
        (int)header,bytes[0],bytes[1],(int)(tail-header),bytes[0]+header,bytes[2],valley,house,foliage);
    if(n<0 || n>=(int)sizeof body) goto done;
    tx_snprintf(path,sizeof path,"%s/bridge.ujs",dir);
    if(sy_write_file(path,body,n,0600)) goto done;
    rc=generated(dir,"product",path,
        mutate==1?"while (bay < 10)":mutate==5?"walkTick * 0.089":
        mutate==6?"uxe_dispatch(31, 160 + 90 * 2048, 0)":mutate==7?"128 + 128 * 2048 + 4194304, 57600":
        mutate==8?"uxe_dispatch(29, 60, 178)":mutate==9?"while (rail < 2)":mutate==10?"while (vine < 21)":
        mutate==11?"sceneWidth = 960":mutate==12?"while (stroke < 1050)":
        mutate==13?"(meadowZ + 4000) * 100 / 6400":mutate==14?"y0 + y1 > 20":mutate==15?"uxe_dispatch(34, 2,":
        mutate==16?"164 + 126 * 256 + 89 * 65536":mutate==17?"while (boulder < 15)":
        mutate==18?"walkInput = uxe_dispatch(0, 0, 0)":0,
        mutate==5?"0.0":mutate==6?"0 - 1":mutate==7?"0, 0":mutate==8?"uxe_dispatch(29, 0, 0)":
        mutate==9?"while (rail < 0)":mutate==10?"while (vine < 0)":mutate==11?"sceneWidth = 426":
        mutate==12?"while (stroke < 0)":mutate==13?"100":mutate==14?"0":
        mutate==15?"uxe_dispatch(34, 0,":mutate==16?"118 + 124 * 256 + 139 * 65536":
        mutate==17?"while (boulder < 0)":
        mutate==18?"walkInput = uxe_dispatch(0, 0, 0) % 4294967296":"while (bay < 0)");
done:
    for(int i=0;i<6;i++) mm_free(bytes[i]);
    return rc;
}

static int bridge_shell(const char *dir) {
    char path[320], *out=0;
    size_t size=0;
    char *cmd[]={"sh","./unisacc.com","ujs/tests/uxe-host-budget.cx","--",path,0};
    if(copy_fixture(dir,"index.html","ujs/practice/uxe/products/d3/index.html")) return 1;
    tx_snprintf(path,sizeof path,"%s/index.html",dir);
    int rc=cx_runv_timeout(cmd,8,&out,&size);
    if(out) printf("%s",out);
    mm_free(out);
    return rc!=0;
}

static int export_walk(const char *dir) {
    if(tx_len(dir,250)<=0 || sy_mkdir(dir,0700)) return 2;
    int rc=generated(dir,"base","ujs/practice/uxe/base/uxe.ujs",0,0) ||
        bridge_product(dir,0) || walk_asset(dir,1) ||
        copy_fixture(dir,"host-abi.js","ujs/practice/uxe/base/host-abi.js") || bridge_shell(dir);
    const char *leaves[]={"bridge.ujs","base.wasm","product.wasm","route.bin","host-abi.js","index.html"};
    char path[320];
    for(int i=0;i<(rc?6:1);i++) {
        tx_snprintf(path,sizeof path,"%s/%s",dir,leaves[i]);
        sy_unlink(path);
    }
    if(rc) sy_rmdir(dir);
    printf("D3_WALK_EXPORT dir=%s failed=%d\n",dir,rc);
    return rc;
}

static int walk_input_check(const char *dir) {
    char url[330], *out=0;
    size_t size=0;
    tx_snprintf(url,sizeof url,"file://%s/index.html",dir);
    char *cmd[]={"sh","./unisacc.com","tools/check-uxe-d1-flight.cx","--","wasm-walk-input",url,0};
    int rc=cx_runv_timeout(cmd,28,&out,&size);
    if(out) printf("%s",out);
    mm_free(out);
    return rc!=0;
}

static int walk_gold(char *gold,int cap) {
    const int marks[]={0,1,60,100,170,373,400,420};
    int rows[8][7],n=0;
    if(walk_rows(rows)) return -1;
    for(int j=0;j<8;j++) {
        int tick=marks[j],distance=tick>400?67000-(tick-400)*180:tick*180;
        if(distance>67000) distance=67000;
        int yaw=tick<60?0:tick<100?(tick-59)*28:1120;
        if(tick>400) yaw-=(tick-400)*28;
        int hi=1;
        while(hi<7 && rows[hi][0]<=distance) hi++;
        int values[6];
        double t=(distance-rows[hi-1][0])*1.0/(rows[hi][0]-rows[hi-1][0]);
        for(int i=0;i<6;i++) {
            double v=rows[hi-1][i+1]+(rows[hi][i+1]-rows[hi-1][i+1])*t+0.5;
            int trunc=(int)v;
            values[i]=trunc-(trunc>v);
        }
        int used=tx_snprintf(gold+n,cap-n,"%s%d,%d,%d,%d,%d,%d,%d,%d,%d",
            n?" ":"",tick,distance,values[0],values[1],values[2],values[3],values[4],values[5],yaw);
        if(used<0 || used>=cap-n) return -1;
        n+=used;
    }
    return n;
}

static int pilot_product(const char *dir,int mutate,int draw) {
    const char *sources[]={"ujs/practice/uxe/products/d2/pilot.ujs","ujs/practice/uxe/base/math.ujs"};
    const char *layers[]={"waterway.ujs","skyline.ujs","reed-banks.ujs","crossing.ujs","title-reflection.ujs",
        "lilies.ujs","dock.ujs","foreground.ujs","title.ujs"};
    const int omitted[]={0,6,7,0,12,9,8,5,11};
    unsigned char *pilot=0,*math=0;
    int64_t pn=0,mn=0;
    int rc=1;
    char path[320],program[32768];
    if (sy_read_file(sources[0],&pilot,&pn,7000) || sy_read_file(sources[1],&math,&mn,1000)) goto done;
    long header=tx_find((char *)pilot,pn,"\n\n",2);
    const char tail[]="\nreturn boatTick;";
    long body=tx_find((char *)pilot,pn,tail,sizeof tail-1);
    if (header < 0 || body <= header) goto done;
    if(draw && water_font_asset(dir,mutate)) goto done;
    int n=tx_snprintf(program,sizeof program,"%.*s\n%s%.*s\n",
        (int)header,pilot,math,(int)(body-header),pilot+header);
    if (n<0 || n>=(int)sizeof program) goto done;
    for(int i=0;draw && i<(int)(sizeof layers/sizeof layers[0]);i++) {
        if(omitted[i] && omitted[i]==mutate) continue;
        unsigned char *layer=0;
        int64_t count=0;
        tx_snprintf(path,sizeof path,"ujs/practice/uxe/products/d2/%s",layers[i]);
        if(sy_read_file(path,&layer,&count,sizeof program-n-100)) goto done;
        int added=tx_snprintf(program+n,sizeof program-n,"%s\n",layer);
        mm_free(layer);
        if(added<0 || added>=(int)sizeof program-n) goto done;
        n+=added;
    }
    int ending=tx_snprintf(program+n,sizeof program-n,"%s%s",draw?"packetWrite = uxe_dispatch(3, 0, 0);\n":"",pilot+body);
    if(ending<0 || ending>=(int)sizeof program-n) goto done;
    n+=ending;
    tx_snprintf(path,sizeof path,"%s/pilot.ujs",dir);
    if(sy_write_file(path,program,n,0600)) goto done;
    rc=generated(dir,"product",path,mutate==14?"if (waterDrift > 8)":
        mutate==12?"waterDrift > 18 && waterNoise > 70":mutate==10?"bridgeDepth <= 134.99":
        mutate==4?"shimmerRow < shimmerLength":mutate==3?"bridgeDepth < 135.0":
        mutate==2?"waterCol > waterStart && waterCol < waterEnd":mutate==1?"target = 0.16":0,
        mutate==14?"if (waterDrift > 240)":
        mutate==12?"waterDrift > 18 && waterNoise > 256":mutate==10?"bridgeDepth <= 0.0":
        mutate==4?"shimmerRow < 0":mutate==3?"bridgeDepth < 0.0":
        mutate==2?"waterCol < waterStart && waterCol > waterEnd":"target = 1.65");
done:
    mm_free(pilot);
    mm_free(math);
    return rc;
}

static int export_waterway(const char *dir) {
    if(tx_len(dir,250)<=0 || sy_mkdir(dir,0700)) return 2;
    int rc=generated(dir,"base","ujs/practice/uxe/base/uxe.ujs",0,0) ||
        pilot_product(dir,0,1) ||
        copy_fixture(dir,"index.html","ujs/practice/uxe/products/d2/water-preview.html") ||
        copy_fixture(dir,"host-abi.js","ujs/practice/uxe/base/host-abi.js") ||
        copy_fixture(dir,"font-license.txt","ujs/practice/uxe/products/d2/font-license.txt");
    const char *leaves[]={"pilot.ujs","base.wasm","product.wasm","index.html","host-abi.js","d2-type.rgba","font-license.txt"};
    char path[320];
    for(int i=0;i<(rc?7:1);i++) {
        tx_snprintf(path,sizeof path,"%s/%s",dir,leaves[i]);
        sy_unlink(path);
    }
    if(rc) sy_rmdir(dir);
    printf("D2_WATERWAY_EXPORT dir=%s failed=%d\n",dir,rc);
    return rc;
}

static int projected_pixels(const char *text, long length) {
    const char *at = text;
    const long header[] = {426,240,0,3};
    long first[80];
    int sky = 0, ocean = 0, land = 0, changed = 0;
    for (int i = 0; i < 164; i++) {
        char *end = 0;
        long value = tx_strtol(at, &end, 10);
        if (end == at || end > text + length) return 1;
        at = end;
        if (i < 4) {
            if (value != header[i]) return 1;
            continue;
        }
        int j = i - 4, r = value & 255, g = (value >> 8) & 255, b = (value >> 16) & 255;
        if ((value >> 24) != 255) return 1;
        if (j < 80) {
            first[j] = value;
            if (j < 10 && r == 42 && g == 126 && b == 185) sky++;
            if (j >= 20 && b >= r + 32 && b >= g + 12 && r <= 160) ocean++;
            if (j >= 20 && g >= b + 12 && r >= 50) land++;
        } else if (first[j - 80] != value) changed++;
    }
    int failed = sky != 10 || ocean < 8 || land < 2 || changed < 6 || at != text + length;
    printf("D1_PROJECTION_PIXELS sky=%d ocean=%d land=%d view_change=%d failed=%d\n",
        sky, ocean, land, changed, failed);
    return failed;
}

static double effect_gain(int sample, int peak, int attack, int duration) {
    if (sample < attack) return peak * sample / (1000.0 * attack);
    return peak * (duration - sample) / (1000.0 * (duration - attack));
}

static int effect_pcm(double signal) {
    double rounded = signal * 32767.0 + 0.5;
    int cut = (int)rounded;
    return cut - (rounded < cut);
}

static int audio_gold(char *gold, int cap) {
    const double root3half = 0.8660254037844386;
    const double t = 100.0 / 48000.0;
    const double saw = 2 * (188 * t + (466 - 188) * t * t / (2 * 0.225)) - 1;
    const double triangle = 4 * (100 * t + (28 - 100) * t * t / (2 * 0.330)) - 1;
    return tx_snprintf(gold, cap, "1600,%d 1600,%d 1600,%d 1600,%d",
        effect_pcm(-root3half * effect_gain(100, 120, 384, 4800)),
        effect_pcm(root3half * effect_gain(1700, 120, 384, 4800) + effect_gain(100, 100, 144, 3120)),
        effect_pcm(-effect_gain(1700, 100, 144, 3120) + saw * effect_gain(100, 85, 432, 10800)),
        effect_pcm(triangle * effect_gain(100, 150, 240, 15840)));
}

static int browser(const char *dir, const char *mode, int base_check, int flight_check, int projection_check) {
    char profile[350], url[380], gold[1024], *out = 0;
    const char start[] = "<pre id=\"ux-link-result\">";
    const char end[] = "</pre>";
    char *cmd[] = {"google-chrome", "--headless=new", "--allow-file-access-from-files",
        "--disable-background-networking", "--no-first-run", profile, "--virtual-time-budget=4000",
        "--dump-dom", url, 0};
    size_t n = 0;
    long from, to;
    int rc, pass = 0;
    int own = 41, transfer = own + 1, clock = 17;
    tx_snprintf(profile, sizeof profile, "--user-data-dir=%s/chrome", dir);
    tx_snprintf(url, sizeof url, "file://%s/probe.html#%s", dir, mode);
    int gold_n = tx_snprintf(gold, sizeof gold, "%d %d %d 1 version signature trap missing",
        transfer * 1000 + transfer + clock, transfer, own);
    if (base_check) {
        gold_n = tx_snprintf(gold, sizeof gold,
            "%d 426 240 10,20,30,255 200,150,100,255 3 2 0 %d 2 0.5 -0.25 48000 -1 1 -1 -1"
            " 102240 110,60,50,255 0,0,255,160 10,20,30,255 -1"
            " 102240 167,83,61,255 41,33,36,255 10,20,30,255 10,20,30,255 -1"
            " 102240 40,160,80,255 10,20,30,255 -1 -1 102240 160,110,101,255 -1 -1"
            " 102240 30,85,210,255 -1 102240 %d,%d,%d,255 -1"
            " 102240 24,210,70,255 102240 24,210,70,255 -1"
            " 102240 200,150,100,255 102240 %d,%d,%d,255 -1",
            426 * 240, 3 * 10000 + 13 * 100 + 91,
            (30 * 128 + 127) / 255, (85 * 128 + 127) / 255, (210 * 128 + 127) / 255,
            (200 * 128 + 127) / 255, (150 * 128 + 127) / 255, (100 * 128 + 127) / 255);
    }
    if (flight_check == 1) gold_n = flight_gold(gold, sizeof gold);
    if (flight_check == 2) gold_n = pilot_gold(gold, sizeof gold);
    if (flight_check == 15) gold_n = walk_gold(gold, sizeof gold);
    if (projection_check == 2) gold_n = audio_gold(gold, sizeof gold);
    if (projection_check == 3) gold_n = tx_snprintf(gold, sizeof gold, "20,26,36,255 138,213,203,255 241,91,49,255");
    if (projection_check == 4) gold_n = tx_snprintf(gold, sizeof gold,
        "35,52,77,255 232,234,219,255 35,52,77,255 232,234,219,255 "
        "35,52,77,255 121,220,162,255 62,75,92,255 35,52,77,255 232,234,219,255 121,220,162,255");
    if (projection_check == 5) gold_n = tx_snprintf(gold, sizeof gold, "245,244,232,255 167,199,214,255 220,233,232,255");
    if (projection_check == 7) gold_n = tx_snprintf(gold, sizeof gold,
        "121,197,189,255 255,116,106,255 255,228,107,255");
    if (gold_n < 0) return 1;
    rc = cx_runv_timeout(cmd, 15, &out, &n);
    from = out ? tx_find(out, n, start, sizeof start - 1) : -1;
    if (from >= 0) {
        from += sizeof start - 1;
        to = tx_find(out + from, n - from, end, sizeof end - 1);
        if (to >= 0) {
            if (flight_check == 16) {
                int near=0,far=0,distance=0,ridge=0,meadow=0,house=0,leaf=0,grass=0,wind=0,cloud=0,grout=0,shade=0,rail=0,vines=0;
                int surface_w=0,surface_h=0,brush=0,greens=0,lit_leaf=0,old_trunk=0,ink=0,vine_light=0,warm=0,rocks=0;
                pass=!rc && sscanf(out+from,"%d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d",
                    &near,&far,&distance,&ridge,&meadow,&house,&leaf,&grass,&wind,&cloud,&grout,&shade,&rail,&vines,
                    &surface_w,&surface_h,&brush,&greens,&lit_leaf,&old_trunk,&ink,&vine_light,&warm,&rocks)==24 &&
                    warm>=1000 && rocks>=100 &&
                    surface_w==960 && surface_h==540 && ink>=400 && vine_light>=50 &&
                    brush>=50 && greens>=4 && lit_leaf>=300 && old_trunk==0 &&
                    near>=1000 && far>=1000 && distance==25*7*180 && ridge>=100 && meadow>=1000 && house>=100 &&
                    leaf>=100 && grass>=25 && wind>=25 && cloud>=1500 && grout>=10 && shade>=50 && rail>=100 && vines>=30;
            } else if (flight_check == 14) {
                int dark=0,light=0,sides=0;
                pass=!rc && sscanf(out+from,"%d %d %d",&dark,&light,&sides)==3 &&
                    dark>=40 && light>=20 && sides==2;
            } else if (flight_check == 13) {
                int pixels=0,runs=0,longest=0;
                pass=!rc && sscanf(out+from,"%d %d %d",&pixels,&runs,&longest)==3 &&
                    pixels>=200 && runs>=35 && longest<=80;
            } else if (flight_check == 12) {
                pass=!rc && !water_font_iou(out+from,to);
                if (to>200) to=0;
            } else if (flight_check == 11) {
                int pixels=0,clusters=0;
                pass=!rc && sscanf(out+from,"%d %d",&pixels,&clusters)==2 && pixels>=200 && clusters==3;
            } else if (flight_check == 10) {
                int left=0,right=0,flowers=0;
                pass=!rc && sscanf(out+from,"%d %d %d",&left,&right,&flowers)==3 &&
                    left>=90 && right>=100 && flowers>=15;
            } else if (flight_check == 9) {
                int deck=0,posts=0;
                pass=!rc && sscanf(out+from,"%d %d",&deck,&posts)==2 && deck>=1200 && posts>=36;
            } else if (flight_check == 8) {
                int left=0,right=0;
                pass=!rc && sscanf(out+from,"%d %d",&left,&right)==2 && left>=100 && right>=140;
            } else if (flight_check == 7) {
                int cloud=0,ridge=0;
                pass=!rc && sscanf(out+from,"%d %d",&cloud,&ridge)==2 && cloud>=1200 && ridge>=500;
            } else if (flight_check == 6) {
                int lamp=0,hull=0,motes=0;
                pass = !rc && sscanf(out+from,"%d %d %d",&lamp,&hull,&motes)==3 &&
                    lamp>=15 && hull>=400 && motes>=20;
            } else if (flight_check == 5) {
                int top=0, lower=0, spread=0, outer=0;
                pass = !rc && sscanf(out+from,"%d %d %d %d",&top,&lower,&spread,&outer)==4 &&
                    top>=30 && top>lower && spread>=4 && outer>=30;
            } else if (flight_check == 4) {
                int deck=0, lamps=0;
                pass = !rc && sscanf(out+from,"%d %d",&deck,&lamps)==2 && deck>=171 && lamps==5;
            } else if (flight_check == 3) {
                int sun=0, first=0, later=0, changed=0;
                pass = !rc && sscanf(out+from,"%d %d %d %d",&sun,&first,&later,&changed)==4 &&
                    sun>=1500 && first>=8000 && later>=8000 && changed>=500;
            } else if (projection_check == 6) {
                int first=0, later=0, changed=0;
                pass = !rc && sscanf(out + from, "%d %d %d", &first, &later, &changed)==3 &&
                    first>=100 && later>=100 && changed>=100;
            } else if (projection_check == 8) {
                int first=0, long_trail=0, left=0, right=0;
                pass = !rc && sscanf(out + from, "%d %d %d %d", &first, &long_trail, &left, &right)==4 &&
                    first>=20 && long_trail>=12 && left>=4 && right>=4;
            } else if (projection_check == 9) {
                int rows=0, canopy=0, shadow=0, edges=0;
                pass = !rc && sscanf(out + from, "%d %d %d %d", &rows, &canopy, &shadow, &edges)==4 &&
                    rows>=30 && canopy>=30 && shadow>=20 && edges>=60;
            } else pass = !rc && (projection_check == 1 ? !projected_pixels(out + from, to) :
                     tx_same(out + from, to, gold, gold_n));
            if (projection_check && to > 500) to = 0;
            printf("%s mode=%s val=%.*s failed=%d\n",
                projection_check == 2 ? "CHECK_UXE_D1_PCM" : projection_check ? "CHECK_UXE_D1_PROJECTION" :
                flight_check == 16 ? "CHECK_UXE_D3_SCENE" : flight_check == 15 ? "CHECK_UXE_D3_ROUTE" :
                flight_check == 14 ? "CHECK_UXE_D2_SHALLOWS" : flight_check == 13 ? "CHECK_UXE_D2_GLINT" :
                flight_check == 12 ? "CHECK_UXE_D2_TITLE" : flight_check == 11 ? "CHECK_UXE_D2_RED_LANTERNS" :
                flight_check == 10 ? "CHECK_UXE_D2_LILIES" : flight_check == 9 ? "CHECK_UXE_D2_DOCK" :
                flight_check == 8 ? "CHECK_UXE_D2_REEDS" :
                flight_check == 7 ? "CHECK_UXE_D2_SKYLINE" :
                flight_check == 6 ? "CHECK_UXE_D2_FOREGROUND" : flight_check == 5 ? "CHECK_UXE_D2_MIRROR" :
                flight_check == 4 ? "CHECK_UXE_D2_BRIDGE" :
                flight_check == 3 ? "CHECK_UXE_D2_WATERWAY" :
                flight_check == 2 ? "CHECK_UXE_D2_PILOT" :
                flight_check ? "CHECK_UXE_D1_FLIGHT_WASM" : base_check ? "CHECK_UXE_D1_BASE" : "CHECK_UXE_LINK",
                mode, (int)to, out + from, !pass);
        }
    }
    if (from < 0) fprintf(stderr, "UX_LINK browser rc=%d %s\n", rc, out ? out : "");
    mm_free(out);
    return !pass;
}

int main(int argc, char **argv) {
    char dir[256], *removed = 0;
    char *clean[] = {"rm", "-rf", "--", dir, 0};
    size_t removed_n = 0;
    if (argc == 3 && tx_eq(argv[1], "--export-projection", sizeof "--export-projection"))
        return export_projection(argv[2]);
    if (argc == 3 && tx_eq(argv[1], "--export-waterway", sizeof "--export-waterway"))
        return export_waterway(argv[2]);
    if (argc == 3 && tx_eq(argv[1], "--export-walk", sizeof "--export-walk"))
        return export_walk(argv[2]);
    const char *package = argc == 4 && tx_eq(argv[1], "--package", sizeof "--package") ? argv[2] : 0;
    const char *mode = package ? argv[3] : argc == 2 ? argv[1] : "";
    int base_blend = tx_eq(mode, "base-blend-bad", sizeof "base-blend-bad");
    int base_particle = tx_eq(mode, "base-particle-flat", sizeof "base-particle-flat");
    int base_depth = tx_eq(mode, "base-depth-off", sizeof "base-depth-off");
    int base_fog = tx_eq(mode, "base-fog-off", sizeof "base-fog-off");
    int base_pose = tx_eq(mode, "base-pose-off", sizeof "base-pose-off");
    int base_sun = tx_eq(mode, "base-sun-off", sizeof "base-sun-off");
    int base_texture = tx_eq(mode,"base-texture-off",sizeof "base-texture-off");
    int base_shadow = tx_eq(mode,"base-shadow-off",sizeof "base-shadow-off");
    int base_check = tx_eq(mode, "base", 5) || tx_eq(mode, "base-color", 11) ||
        base_blend || base_particle || base_depth || base_fog || base_pose || base_sun || base_texture || base_shadow;
    int cannon_mutate = tx_eq(mode, "flight-cannon", sizeof "flight-cannon");
    int hit_mutate = tx_eq(mode, "flight-hit", sizeof "flight-hit");
    int wave_mutate = tx_eq(mode, "flight-wave", sizeof "flight-wave");
    int missile_mutate = tx_eq(mode, "flight-missile", sizeof "flight-missile");
    int health_mutate = tx_eq(mode, "flight-health", sizeof "flight-health");
    int flight_check = tx_eq(mode, "flight", 7) || tx_eq(mode, "flight-heading", 15) ||
        cannon_mutate || hit_mutate || wave_mutate || missile_mutate || health_mutate;
    int pilot_mutate = tx_eq(mode, "pilot-no-drag", sizeof "pilot-no-drag");
    if (tx_eq(mode, "pilot", sizeof "pilot") || pilot_mutate) flight_check = 2;
    int dry_mutate = tx_eq(mode,"waterway-dry",sizeof "waterway-dry");
    if (tx_eq(mode,"waterway",sizeof "waterway") || dry_mutate) flight_check = 3;
    int dark_mutate=tx_eq(mode,"water-bridge-dark",sizeof "water-bridge-dark");
    if(tx_eq(mode,"water-bridge",sizeof "water-bridge") || dark_mutate) flight_check=4;
    int mirror_mutate=tx_eq(mode,"water-mirror-off",sizeof "water-mirror-off");
    if(tx_eq(mode,"water-mirror",sizeof "water-mirror") || mirror_mutate) flight_check=5;
    int prow_mutate=tx_eq(mode,"water-foreground-off",sizeof "water-foreground-off");
    if(tx_eq(mode,"water-foreground",sizeof "water-foreground") || prow_mutate) flight_check=6;
    int skyline_mutate=tx_eq(mode,"water-skyline-off",sizeof "water-skyline-off");
    if(tx_eq(mode,"water-skyline",sizeof "water-skyline") || skyline_mutate) flight_check=7;
    int reeds_mutate=tx_eq(mode,"water-reeds-off",sizeof "water-reeds-off");
    if(tx_eq(mode,"water-reeds",sizeof "water-reeds") || reeds_mutate) flight_check=8;
    int dock_mutate=tx_eq(mode,"water-dock-off",sizeof "water-dock-off");
    if(tx_eq(mode,"water-dock",sizeof "water-dock") || dock_mutate) flight_check=9;
    int lilies_mutate=tx_eq(mode,"water-lilies-off",sizeof "water-lilies-off");
    if(tx_eq(mode,"water-lilies",sizeof "water-lilies") || lilies_mutate) flight_check=10;
    int red_mutate=tx_eq(mode,"water-red-off",sizeof "water-red-off");
    if(tx_eq(mode,"water-red",sizeof "water-red") || red_mutate) flight_check=11;
    int title_mutate=tx_eq(mode,"water-title-off",sizeof "water-title-off");
    int glyph_mutate=tx_eq(mode,"water-title-glyph",sizeof "water-title-glyph");
    if(tx_eq(mode,"water-title",sizeof "water-title") || title_mutate || glyph_mutate) flight_check=12;
    int glint_mutate=tx_eq(mode,"water-glint-off",sizeof "water-glint-off");
    if(tx_eq(mode,"water-glint",sizeof "water-glint") || glint_mutate) flight_check=13;
    int shallows_mutate=tx_eq(mode,"water-shallows-off",sizeof "water-shallows-off");
    if(tx_eq(mode,"water-shallows",sizeof "water-shallows") || shallows_mutate) flight_check=14;
    int walk_mutate=tx_eq(mode,"walk-short",sizeof "walk-short");
    int rail_mutate=tx_eq(mode,"walk-rail-off",sizeof "walk-rail-off");
    if(tx_eq(mode,"walk",sizeof "walk") || walk_mutate || rail_mutate) flight_check=15;
    int bridge_mutate=tx_eq(mode,"walk-bridge-off",sizeof "walk-bridge-off");
    if(tx_eq(mode,"walk-valley-off",sizeof "walk-valley-off")) bridge_mutate=2;
    if(tx_eq(mode,"walk-house-off",sizeof "walk-house-off")) bridge_mutate=3;
    if(tx_eq(mode,"walk-foliage-off",sizeof "walk-foliage-off")) bridge_mutate=4;
    if(tx_eq(mode,"walk-wind-off",sizeof "walk-wind-off")) bridge_mutate=5;
    if(tx_eq(mode,"walk-cloud-off",sizeof "walk-cloud-off")) bridge_mutate=6;
    if(tx_eq(mode,"walk-masonry-off",sizeof "walk-masonry-off")) bridge_mutate=7;
    if(tx_eq(mode,"walk-shadow-off",sizeof "walk-shadow-off")) bridge_mutate=8;
    if(tx_eq(mode,"walk-railings-off",sizeof "walk-railings-off")) bridge_mutate=9;
    if(tx_eq(mode,"walk-vines-off",sizeof "walk-vines-off")) bridge_mutate=10;
    if(tx_eq(mode,"walk-low-resolution",sizeof "walk-low-resolution")) bridge_mutate=11;
    if(tx_eq(mode,"walk-meadow-brush-off",sizeof "walk-meadow-brush-off")) bridge_mutate=12;
    if(tx_eq(mode,"walk-meadow-flat",sizeof "walk-meadow-flat")) bridge_mutate=13;
    if(tx_eq(mode,"walk-flat-leaves",sizeof "walk-flat-leaves")) bridge_mutate=14;
    if(tx_eq(mode,"walk-ink-off",sizeof "walk-ink-off")) bridge_mutate=15;
    if(tx_eq(mode,"walk-purple-arch",sizeof "walk-purple-arch")) bridge_mutate=16;
    if(tx_eq(mode,"walk-rocks-off",sizeof "walk-rocks-off")) bridge_mutate=17;
    int walk_input_off=tx_eq(mode,"walk-input-off",sizeof "walk-input-off");
    if(tx_eq(mode,"walk-input",sizeof "walk-input") || walk_input_off) flight_check=17;
    else if(tx_eq(mode,"walk-bridge",sizeof "walk-bridge") || bridge_mutate) flight_check=16;
    int projection_check = tx_eq(mode, "projection", 11) || tx_eq(mode, "projection-short", 17);
    int audio_mutate = tx_eq(mode, "projection-audio-mute", sizeof "projection-audio-mute");
    if (tx_eq(mode, "projection-audio", sizeof "projection-audio") || audio_mutate) projection_check = 2;
    int art_mutate = tx_eq(mode, "projection-art-missing", sizeof "projection-art-missing");
    if (tx_eq(mode, "projection-art", sizeof "projection-art") || art_mutate) projection_check = 3;
    int hud_mutate = tx_eq(mode, "projection-hud-missing", sizeof "projection-hud-missing");
    if (tx_eq(mode, "projection-hud", sizeof "projection-hud") || hud_mutate) projection_check = 4;
    int cloud_mutate = tx_eq(mode, "projection-cloud-missing", sizeof "projection-cloud-missing");
    if (tx_eq(mode, "projection-cloud", sizeof "projection-cloud") || cloud_mutate) projection_check = 5;
    int wave_pixels_mutate = tx_eq(mode, "projection-foam-missing", sizeof "projection-foam-missing");
    if (tx_eq(mode, "projection-foam", sizeof "projection-foam") || wave_pixels_mutate) projection_check = 6;
    int enemy_mutate = tx_eq(mode, "projection-enemy-missing", sizeof "projection-enemy-missing");
    if (tx_eq(mode, "projection-enemy", sizeof "projection-enemy") || enemy_mutate) projection_check = 7;
    int trail_mutate = tx_eq(mode, "projection-trail-missing", sizeof "projection-trail-missing");
    if (tx_eq(mode, "projection-trail", sizeof "projection-trail") || trail_mutate) projection_check = 8;
    int brush_mutate = tx_eq(mode, "projection-brush-missing", sizeof "projection-brush-missing");
    if (tx_eq(mode, "projection-brush", sizeof "projection-brush") || brush_mutate) projection_check = 9;
    if ((argc > 2 && !package) || (package && !projection_check && flight_check<3) ||
        (argc == 2 && !tx_eq(mode, "version", 8) && !tx_eq(mode, "signature", 10) &&
        !tx_eq(mode, "bounds", 7) && !tx_eq(mode, "missing", 8) && !base_check && !flight_check && !projection_check)) return 2;
    if (sy_mkdtemp("/tmp", "uxe-link-", dir, sizeof dir)) return 2;
    int rc = package ? copy_package_file(dir, package, "host-abi.js") :
        copy_fixture(dir, "host-abi.js", "ujs/practice/uxe/base/host-abi.js");
    if (projection_check) {
        int mutate = brush_mutate ? 9 : trail_mutate ? 8 : enemy_mutate ? 7 : wave_pixels_mutate ? 6 :
            cloud_mutate ? 5 : hud_mutate ? 4 : art_mutate ? 3 : audio_mutate ? 2 : tx_eq(mode, "projection-short", 17);
        rc = rc || copy_fixture(dir, "probe.html", "ujs/practice/uxe/test/ux-d1-projection-probe.html");
        if (package) {
            rc = rc || copy_package_file(dir, package, "base.wasm") ||
                (mutate ? projection_product(dir, mutate) : copy_package_file(dir, package, "product.wasm")) ||
                copy_package_file(dir, package, "d1-sprites.rgba");
        } else {
            rc = rc || generated(dir, "base", "ujs/practice/uxe/base/uxe.ujs", 0, 0) || projection_product(dir, mutate);
        }
    } else if (flight_check == 17) {
        rc=rc || (package!=0) || walk_asset(dir,1) || bridge_shell(dir) ||
            generated(dir,"base","ujs/practice/uxe/base/uxe.ujs",0,0) ||
            bridge_product(dir,walk_input_off?18:0) || walk_input_check(dir);
    } else if (flight_check == 16) {
        rc=rc || (package!=0) || walk_asset(dir,1) || bridge_shell(dir) ||
            copy_fixture(dir,"probe.html","ujs/practice/uxe/test/ux-d3-bridge-probe.html") ||
            generated(dir,"base","ujs/practice/uxe/base/uxe.ujs",0,0) || bridge_product(dir,bridge_mutate);
    } else if (flight_check == 15) {
        rc=rc || (package!=0) || walk_asset(dir,0) ||
            copy_fixture(dir,"probe.html","ujs/practice/uxe/test/ux-d3-route-probe.html") ||
            generated(dir,"base","ujs/practice/uxe/base/uxe.ujs",rail_mutate?"high * delta":0,"low * delta") ||
            generated(dir,"product","ujs/practice/uxe/products/d3/route.ujs",walk_mutate?"180 * walkSteps":0,"120 * walkSteps");
    } else if (flight_check >= 2) {
        int mutate=shallows_mutate?14:glyph_mutate?13:glint_mutate?12:title_mutate?11:red_mutate?10:
            lilies_mutate?9:dock_mutate?8:reeds_mutate?7:skyline_mutate?6:prow_mutate?5:mirror_mutate?4:
            dark_mutate?3:dry_mutate?2:pilot_mutate;
        rc = rc || copy_fixture(dir,"probe.html","ujs/practice/uxe/test/ux-d2-pilot-probe.html");
        if(package) {
            rc = rc || copy_package_file(dir,package,"base.wasm") ||
                (mutate?pilot_product(dir,mutate,1):copy_package_file(dir,package,"product.wasm")) ||
                (!glyph_mutate && copy_package_file(dir,package,"d2-type.rgba"));
        } else rc = rc || generated(dir,"base","ujs/practice/uxe/base/uxe.ujs",0,0) ||
            pilot_product(dir,mutate,flight_check>=3);
    } else if (flight_check) {
        int mutate = tx_eq(mode, "flight-heading", 15);
        rc = rc || copy_fixture(dir, "probe.html", "ujs/practice/uxe/test/ux-d1-flight-probe.html") ||
            generated(dir, "base", "ujs/practice/uxe/base/uxe.ujs", 0, 0) ||
            generated(dir, "product", "ujs/practice/uxe/products/d1/main.ujs",
                health_mutate ? "playerHealth = playerHealth - 20" :
                    missile_mutate ? "missileTravel = 13" : wave_mutate ? "battleDelay = 36" : hit_mutate ? "nearestSquare = 900" :
                    cannon_mutate ? "cannonCooldown = 5" : mutate ? "tickTurn * 3" : 0,
                health_mutate ? "playerHealth = playerHealth - 10" :
                    missile_mutate ? "missileTravel = 12" : wave_mutate ? "battleDelay = 35" : hit_mutate ? "nearestSquare = 000" :
                    cannon_mutate ? "cannonCooldown = 4" : "tickTurn * 2");
    } else if (base_check) {
        int mutate = tx_eq(mode, "base-color", 11);
        char path[320];
        const unsigned char asset[] = {7,13,29,91,255,0,255,0,90,100,180,255,70,100,200,255,24,210,70,255};
        tx_snprintf(path, sizeof path, "%s/asset.bin", dir);
        if (sy_write_file(path, asset, sizeof asset, 0600)) rc = 1;
        rc = rc || copy_fixture(dir, "probe.html", "ujs/practice/uxe/test/ux-d1-base-probe.html") ||
            generated(dir, "base", "ujs/practice/uxe/base/uxe.ujs",
                base_shadow ? "resolvedLight * shadowDark" : base_texture ? "if (textured &&" : base_sun ? "sunEnabled = 1;" : base_pose ? "cameraX - worldEyeX" : base_fog ? "sceneFogEnd > sceneFogStart" :
                    base_depth ? "triangleInvZ > ux_f32(triangleDepthAt)" :
                    base_particle ? "blendEdge - blendDistance" : base_blend ? "255 - blendAlpha" : 0,
                base_shadow ? "resolvedLight * 255" : base_texture ? "if (0 &&" : base_sun ? "sunEnabled = 0;" : base_pose ? "cameraX" : base_fog ? "sceneFogEnd < sceneFogStart" : base_depth ? "triangleInvZ > 0.0" :
                    base_particle ? "blendEdge" : "128 - blendAlpha") ||
            generated(dir, "product", "ujs/practice/uxe/test/ux-d1-base-product.ujs",
                mutate ? "4284782280" : 0, "4284782281");
    } else {
        rc = rc || copy_fixture(dir, "probe.html", "ujs/practice/uxe/test/ux-link-probe.html") ||
            generated(dir, "base", base_source, 0, 0) ||
            generated(dir, "product", product_source, 0, 0) ||
            generated(dir, "version", base_source, "version 1;", "version 2;") ||
            generated(dir, "signature", base_source, "value:i64)", "value:i64, spare:i64)");
    }
    if(flight_check!=17) rc = rc || browser(dir, mode, base_check, flight_check, projection_check);
    if (cx_runv_timeout(clean, 8, &removed, &removed_n)) rc = 1;
    mm_free(removed);
    return rc;
}
