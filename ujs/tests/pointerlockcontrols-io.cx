#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"f64-math","vector-scalar","pointerlockcontrols",0};
    const char *setup="let control=256;let direction=512;let ready=PointerLockControls_init(control,0.0,4.0,0.0);";
    #define LOCK "let locked=PointerLockControls_hostState(control,1);"
    #define UNLOCK "let unlocked=PointerLockControls_hostState(control,0);"
    #define MOTION "let changed=PointerLockControls_pointer(control,100.0,0.0-50.0);"
    #define DIRECTION "let view=PointerLockControls_direction(control,direction);"
    #define MOVE "let stepped=PointerLockControls_move(control,2.0,1.0);"
    const char *cases[]={
        MOTION "return ux_f64(control+PointerLockControls.yaw);",
        LOCK "return 0.0+ux_u32(control+PointerLockControls.lockEvents);",
        LOCK MOTION DIRECTION "return ux_f64(direction);",
        LOCK MOTION DIRECTION "return ux_f64(direction+8);",
        LOCK MOTION DIRECTION "return ux_f64(direction+16);",
        LOCK MOTION MOVE "return ux_f64(control+PointerLockControls.x);",
        LOCK MOTION MOVE "return ux_f64(control+PointerLockControls.z);",
        LOCK MOTION MOVE "return ux_f64(control+PointerLockControls.y);",
        LOCK "let max=ux_f64_put(control+PointerLockControls.maxPolar,1.6707963267948966);"
        "let changed=PointerLockControls_pointer(control,0.0,1000.0);" DIRECTION "return ux_f64(direction+8);",
        LOCK MOTION UNLOCK MOTION "return 0.0+ux_u32(control+PointerLockControls.changeEvents);",
        LOCK UNLOCK "return 0.0+ux_u32(control+PointerLockControls.unlockEvents);",
        "return 0.0+PointerLockControls_direction(control,control);",
    };
    const double gold[]={0,1,0.19767681165408388,0.09983341664682815,-0.975170327201816,
        1.377405239431364,-1.761463824887422,4,-0.09983341664682815,1,1,-1};
    return g_wasm_batch_addon("G_RAY PointerLockControls motion","pointerlockcontrols",argv[1],modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,LOCK
        "let changed=PointerLockControls_pointer(control,0.0-100.0,0.0-50.0);" DIRECTION "return ux_f64(direction);");
}
