#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"curve","object-json-tokens","json-bytes","json-read","curve-json",0};
    const char *setup=
        "function hash(end){if(end<0){return end;}let h=0;let p=1024;"
        "while(p<end){h=(h*131+ux_u8(p))%16777213;p=p+1;}return h;}"
        "let src=CurveArcCache_init(0,256,16);let start=ux_u32(src+CurveArcCache.arcLengthDivisions);"
        "let changed=ux_u32_put(src+CurveArcCache.arcLengthDivisions,7);"
        "let dst=CurveArcCache_init(32,512,16);";
    const char *cases[]={
        "return start;",
        "let c=Curve_copy(dst,src);return ux_u32(c+CurveArcCache.arcLengthDivisions);",
        "let c=Curve_clone(64,src,768,16);let v=ux_u32_put(src+CurveArcCache.arcLengthDivisions,3);"
        "return ux_u32(c+CurveArcCache.arcLengthDivisions);",
        "let end=Curve_toJSON(src,1024,2048,4096);return hash(end);",
        "let end=Curve_toJSON(src,1024,2048,4096);let c=Curve_fromJSON(dst,1024,end,4096);"
        "return ux_u32(c+CurveArcCache.arcLengthDivisions);",
        "return Curve_toJSON(src,1024,1040,4096);",
        "let end=Curve_toJSON(src,1024,2048,4096);return Curve_fromJSON(dst,1024,end-1,4096);"
    };
    const char expected[]="{\"metadata\":{\"version\":4.6,\"type\":\"Curve\",\"generator\":\"Curve.toJSON\"},"
        "\"arcLengthDivisions\":7,\"type\":\"Curve\"}";
    uint64_t h=0;
    for(int i=0;expected[i];i++) h=(h*131+(unsigned char)expected[i])%16777213;
    const double gold[]={200,7,7,(double)h,7,-1,-1};
    return g_math_run("G_STRUCT Curve JSON","curve-json",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?3:-1,"let v=ux_u32_put(src+CurveArcCache.arcLengthDivisions,3);"
        "let end=Curve_toJSON(src,1024,2048,4096);return hash(end);");
}
