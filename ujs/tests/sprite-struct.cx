#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d","gpu-sprite","sprite",0};
    const char *setup=
        "let arena=Object3D_initArena(0,2);let node=Object3D_create(arena);let object=Object3D_address(arena,node);"
        "let p=ux_u32(object+Object3D.position);let s=ux_u32(object+Object3D.scale);"
        "let x=ux_f64_put(p,3.0);let y=ux_f64_put(p+8,1.0);let z=ux_f64_put(p+16,0.0-5.0);"
        "let sx=ux_f64_put(s,2.0);let sy=ux_f64_put(s+8,4.0);let update=Object3D_updateMatrixWorld(arena,node,0);"
        "let view=Matrix4_makeTranslation(1024,0.0-1.0,0.0,0.0);"
        "let sprite=Sprite_init(1216,arena,node,7);"
        "let default_x=ux_f64(sprite+Sprite.centerX);let anchor=Sprite_setCenter(sprite,0.25,0.75);"
        "let n=Sprite_buildQuad(sprite,arena,view,1408,1.5707963267948966,0,4294967295);";
    const char *cases[]={
        "return default_x;","return n;","return ux_f32(1408);","return ux_f32(1412);","return ux_f32(1416);",
        "return ux_f32(1440);",
        "let n=Sprite_buildQuad(sprite,arena,view,1408,1.5707963267948966,1,4294967295);return ux_f32(1408);",
        "let n=Sprite_buildQuad(sprite,arena,view,1408,1.5707963267948966,1,4294967295);return ux_f32(1412);"
    };
    const double gold[]={0.5,6,5,0.5,-5,2.5,17,-1.5};
    return g_math_run("G_STRUCT Sprite","sprite",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?2:-1,"let changed=Sprite_setCenter(sprite,0.5,0.5);"
        "let n=Sprite_buildQuad(sprite,arena,view,1408,1.5707963267948966,0,4294967295);return ux_f32(1408);");
}
