#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"transformcontrols-translate","transformcontrols-translate-frame",0};
    const char *setup="let pos=32;let q=64;let parent=96;let delta=128;let out=256;"
        "let x=ux_f64_put(pos,1.25);let y=ux_f64_put(pos+8,0.0-1.25);let z=ux_f64_put(pos+16,3.25);"
        "let ro=ux_f64_put(q+16,0.7071067811865476);let co=ux_f64_put(q+24,0.7071067811865476);"
        "let rp=ux_f64_put(parent+16,0.7071067811865476);let cp=ux_f64_put(parent+24,0.7071067811865476);"
        "let dx=ux_f64_put(delta,0.75);let dy=ux_f64_put(delta+8,0.375);";
    #define MOVE "let done=TransformControls_transLocal(out,pos,q,parent,delta,"
    #define X "return ux_f64(out);"
    #define Y "return ux_f64(out+8);"
    #define Z "return ux_f64(out+16);"
    const char *cases[]={
        MOVE "1,2.0,0.0);" X,
        MOVE "1,2.0,0.0);" Y,
        MOVE "1,2.0,1.0);" Y,
        MOVE "2,2.0,0.0);" X,
        MOVE "3,2.0,1.0);" X,
        MOVE "3,2.0,1.0);" Y,
        MOVE "3,2.0,1.0);" Z,
        "let done=TransformControls_transLocal(pos,pos,q,parent,delta,1,2.0,1.0);return ux_f64(pos+8);",
        "return 0.0+TransformControls_transLocal(out,pos,q,parent,delta,7,2.0,1.0);",
        "let marker=ux_f64_put(out,47.0);" MOVE "1,0.0,1.0);" X,
    };
    const double gold[]={1.25,-1.625,-2,1.4375,1,-2,3.25,-2,-1,47};
    return g_wasm_batch_addon("G_RAY TransformControls local translation","transformcontrols-translate-frame",
        argv[1],modules,setup,cases,gold,sizeof gold/sizeof gold[0],mutate?2:-1,MOVE "1,2.0,0.0);" Y);
}
