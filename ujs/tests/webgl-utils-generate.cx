#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"

typedef struct { unsigned char *data; int64_t size; } Text;

static int number_after(const Text *text,const char *prefix,char separator) {
    const long size=tx_len(prefix,140);
    const long at=tx_find((const char *)text->data,text->size,prefix,size);
    if(at<0) return -1;
    const char *from=(const char *)text->data+at+size;
    char *end=0;
    const long value=tx_strtol(from,&end,10);
    return end>from && end<(const char *)text->data+text->size && *end==separator &&
        value>0 && value<=65535?(int)value:-1;
}

static int field(const char **cursor,const char *end,char out[48]) {
    const long size=tx_find(*cursor,end-*cursor,"\t",1);
    if(size<1 || size>47) return 1;
    for(int i=0;i<size;i++) {
        const char ch=(*cursor)[i];
        if(!((ch>='A'&&ch<='Z') || (ch>='a'&&ch<='z') || (i>0&&ch>='0'&&ch<='9'))) return 1;
        out[i]=ch;
    }
    out[size]=0;
    *cursor+=size+1;
    return 0;
}

static int rows(const Text *facts,const Text *semantic,const Text *integers,const Text *types,char *out,int room) {
    const char header[]="format\ttype\tsrgb\tinternal\texternal\tgl_type\n";
    const char *begin=(const char *)facts->data,*end=begin+facts->size;
    if(facts->size<(int64_t)sizeof header || !tx_same(begin,sizeof header-1,header,sizeof header-1)) return -1;
    int used=0,count=0;
    unsigned seen[19]={0};
    for(const char *line=begin+sizeof header-1;line<end;) {
        const long newline=tx_find(line,end-line,"\n",1);
        char format[48],type[48],marker[140];
        const char *cursor=line;
        if(newline<0 || count>=19 ||
           field(&cursor,line+newline,format) || field(&cursor,line+newline,type)) return -1;
        tx_snprintf(marker,sizeof marker,"\nB\t%s\t",format);
        int f=number_after(semantic,marker,'\t');
        if(f<0) {
            tx_snprintf(marker,sizeof marker,"\n%s\t",format);
            f=number_after(integers,marker,'\t');
        }
        tx_snprintf(marker,sizeof marker,"\nfunction %s() { return ",type);
        const int t=number_after(types,marker,';');
        if(f<0 || t<0 || cursor+2>line+newline ||
           (cursor[0]!='0' && cursor[0]!='1') || cursor[1]!='\t') return -1;
        const int srgb=cursor[0]-'0';
        cursor+=2;
        unsigned enums[3]={0};
        for(int j=0;j<3;j++) {
            char *next=0;
            const long value=tx_strtol(cursor,&next,16);
            if(next==cursor || next>line+newline || value<=0 || value>65535 ||
               *next!=(j==2?'\n':'\t')) return -1;
            enums[j]=(unsigned)value;
            cursor=next+1;
        }
        const unsigned key=(unsigned)f*131072u+(unsigned)t*2u+(unsigned)srgb;
        for(int i=0;i<count;i++) if(seen[i]==key) return -1;
        seen[count++]=key;
        const int n=tx_snprintf(out+used,room-used,
            "  if(format==%d && kind==%d && srgb==%d) { return webgl_utils_write(out,%u,%u,%u); }\n",
            f,t,srgb,enums[0],enums[1],enums[2]);
        if(n<0 || n>=room-used) return -1;
        used+=n;
        line+=newline+1;
    }
    return count==19?used:-1;
}

static int classifier(const Text *r160,const Text *legacy,char *out,int room) {
    const char *formats[]={
        "RGB_S3TC_DXT1_Format","RGBA_S3TC_DXT1_Format","RGBA_S3TC_DXT3_Format","RGBA_S3TC_DXT5_Format",
        "RGB_PVRTC_4BPPV1_Format","RGB_PVRTC_2BPPV1_Format","RGBA_PVRTC_4BPPV1_Format","RGBA_PVRTC_2BPPV1_Format",
        "RGB_ETC1_Format","RGB_ETC2_Format","RGBA_ETC2_EAC_Format",
        "RGBA_ASTC_4x4_Format","RGBA_ASTC_5x4_Format","RGBA_ASTC_5x5_Format","RGBA_ASTC_6x5_Format",
        "RGBA_ASTC_6x6_Format","RGBA_ASTC_8x5_Format","RGBA_ASTC_8x6_Format","RGBA_ASTC_8x8_Format",
        "RGBA_ASTC_10x5_Format","RGBA_ASTC_10x6_Format","RGBA_ASTC_10x8_Format","RGBA_ASTC_10x10_Format",
        "RGBA_ASTC_12x10_Format","RGBA_ASTC_12x12_Format",
        "RGBA_BPTC_Format","RGB_BPTC_SIGNED_Format","RGB_BPTC_UNSIGNED_Format",
        "RED_RGTC1_Format","SIGNED_RED_RGTC1_Format","RED_GREEN_RGTC2_Format","SIGNED_RED_GREEN_RGTC2_Format",
    };
    const char *old[]={"AlphaFormat","LuminanceFormat","LuminanceAlphaFormat"};
    int used=0;
    for(int kind=0;kind<2;kind++) {
        const int count=kind==0?(int)(sizeof formats/sizeof formats[0]):3;
        const int n=tx_snprintf(out+used,room-used,"native function webgl_utils_%s(format:i64) i64 {\n",
            kind==0?"compressed":"legacy");
        if(n<0 || n>=room-used) return -1;
        used+=n;
        for(int i=0;i<count;i++) {
            char marker[120];
            const char *name=kind==0?formats[i]:old[i];
            tx_snprintf(marker,sizeof marker,"\nconst %s = ",name);
            const int value=number_after(r160,marker,';');
            if(value<0) return -1;
            if(kind==1) {
                tx_snprintf(marker,sizeof marker,"\n%s\t",name);
                if(number_after(legacy,marker,'\t')!=value) return -1;
            }
            const int row=tx_snprintf(out+used,room-used,"  if(format==%d) { return 1; }\n",value);
            if(row<0 || row>=room-used) return -1;
            used+=row;
        }
        const int tail=tx_snprintf(out+used,room-used,"  return 0;\n}\n");
        if(tail<0 || tail>=room-used) return -1;
        used+=tail;
    }
    return used;
}

static int generate(char *out,int cap,const Text input[6]) {
    int used=tx_snprintf(out,cap,"// Generated by webgl-utils-generate.cx.\n");
    int n=classifier(&input[4],&input[5],out+used,cap-used);
    if(n<0) return -1;
    used+=n;
    n=tx_snprintf(out+used,cap-used,
        "native function WebGLUtils_textureFormat(out:i64,format:i64,kind:i64,srgb:i64) i64 {\n"
        "  if(out<0 || out%%4!=0 || out>6291456-WebGLTextureFormat.size ||\n"
        "     (srgb!=0 && srgb!=1)) { return 0-1; }\n"
        "  if(webgl_utils_compressed(format)) { return 0-3; }\n"
        "  if(webgl_utils_legacy(format)) { return 0-4; }\n");
    if(n<0 || n>=cap-used) return -1;
    used+=n;
    n=rows(&input[0],&input[1],&input[2],&input[3],out+used,cap-used);
    if(n<0) return -1;
    used+=n;
    n=tx_snprintf(out+used,cap-used,"  return 0-2;\n}\n");
    if(n<0 || n>=cap-used) return -1;
    return used+n;
}

int main(int argc,char **argv) {
    const int write=argc==2 && tx_eqz(argv[1],"--write");
    if(!write && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char *paths[]={BASE "webgl-utils-formats.tsv","ujs/plans/ux-three-b-semantic-facts.tsv",
        BASE "gpu-integer-format.tsv",BASE "bufferconstants.ujs","ujs/practice/web/game/three.module.js",
        BASE "gpu-legacy-format.tsv"};
    Text input[6]={0};
    int failed=0;
    for(int i=0;i<6;i++) {
        if(sy_read_file(paths[i],&input[i].data,&input[i].size,i==4?4000000:32768)) { failed=1; break; }
    }
    char built[8192];
    const int size=failed?-1:generate(built,sizeof built,input);
    for(int i=0;i<6;i++) mm_free(input[i].data);
    if(size<0) return 2;
    const char output[]=BASE "webgl-utils-generated.ujs";
    if(write) failed=sy_write_file(output,built,size,0644)!=0;
    else {
        unsigned char *old=0;
        int64_t bytes=0;
        failed=sy_read_file(output,&old,&bytes,sizeof built) || !tx_same((const char *)old,bytes,built,size);
        mm_free(old);
    }
    printf("WEBGL_UTILS generated=19 failed=%d\n",failed);
    return failed;
}
