#pragma unisa use g_math
#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define TEST "ujs/practice/uxe/test/"

static int source_section(const char *source,const char *start,const char *stop,const char *out) {
    unsigned char *raw=0;
    int64_t bytes=0;
    if(sy_read_file(source,&raw,&bytes,30000)) return 1;
    long first=start?tx_find((const char *)raw,bytes,start,tx_len(start,120)):0;
    long last=first<0?-1:tx_find((const char *)raw+first,bytes-first,stop,tx_len(stop,120));
    if(last>=0 && start) last+=tx_len(stop,120);
    int failed=first<0 || last<=0 || sy_write_file(out,raw+first,last,0600);
    mm_free(raw);
    return failed;
}

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[390],abi[300],wasm[300],event[300],attribute[300],grid[300],geo[300],url[850];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-axes-object-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/axes.wasm",dir);
    tx_snprintf(event,sizeof event,"%s/event-layout.ujs",dir);
    tx_snprintf(attribute,sizeof attribute,"%s/attribute-init.ujs",dir);
    tx_snprintf(grid,sizeof grid,"%s/grid-json-output.ujs",dir);
    tx_snprintf(geo,sizeof geo,"%s/geometry-attributes.ujs",dir);
    int length=tx_snprintf(url,sizeof url,"file://%s/" TEST "helper-axes-object-r160.html?wasm=%s&mutate=%d",cwd,wasm,mutate);
    const char entry[]="export uxe_axes_object(mode:i64,length:i64,mutate:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,event,BASE "geometry-load-layout.ujs",
        BASE "f64-math.ujs",BASE "datautils.ujs",attribute,geo,
        BASE "helper-buffers.ujs",BASE "gridhelper.ujs",BASE "polargridhelper.ujs",BASE "axeshelper.ujs",
        BASE "object-json-tokens.ujs",BASE "json-read.ujs",BASE "json-bytes.ujs",BASE "geometry-json.ujs",grid,
        BASE "eventdispatcher.ujs",BASE "record-copy.ujs",BASE "material-class.ujs",
        BASE "material-field-json.ujs",BASE "material-field-read.ujs",BASE "material-fields-generated.ujs",
        BASE "material-set-values.ujs",BASE "helper-axes-object.ujs",TEST "helper-axes-object-probe.ujs","-o",wasm,0};
    const double gold[]={1,1,16777215,1,0,1,0,1,1,0,0,0,2386092,0,0,.375,1,0,1,0,-1,-1,0};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    char *log=0;
    size_t size=0;
    // Keep the actual dependency declarations and producer entry points under the stage0 source cap.
    int failed=length<0 || length>=(int)sizeof url || sy_write_file(abi,entry,sizeof entry-1,0600) ||
        source_section(BASE "object-layouts.ujs","struct EventDispatcher {","\n}\n",event) ||
        source_section(BASE "bufferattribute.ujs",0,"native function BufferAttribute_index(",attribute) ||
        source_section(BASE "buffergeometry.ujs",0,"native function BufferGeometry_addGroup(",geo) ||
        source_section(BASE "helper-family-grid-json.ujs",0,"native function helper_grid_geometry_data(",grid);
    if(!failed) {
        int rc=cx_runv_timeout(compile,25,&log,&size);
        if(rc) { printf("G_STRUCT AxesHelper material compile_rc=%d %s\n",rc,log?log:""); failed=1; }
        mm_free(log);
        log=0;
    }
    if(!failed) failed=r160_wait_read(url,"#r160",actual,count,dir);
    if(!failed) for(int i=0;i<count;i++) if(!g_math_near(actual[i],gold[i],1e-6)) {
        printf("G_STRUCT AxesHelper material case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
        failed++;
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&log,&size)) failed++;
    mm_free(log);
    printf("G_STRUCT AxesHelper material cases=%d failed=%d\n",count,failed);
    return failed!=0;
}
