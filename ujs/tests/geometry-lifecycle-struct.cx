#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","buffergeometry","geometry-lifecycle",0};
    const char *setup="let src=BufferGeometry_init(0,128,1,192,1);let dst=BufferGeometry_init(1024,1152,1,1216,1);"
        "let pos=256;let p0=ux_u32_put(pos+BufferAttribute.data,512);let p1=ux_u32_put(pos+BufferAttribute.count,2);"
        "let p2=ux_u32_put(pos+BufferAttribute.stride,24);let p3=ux_u32_put(pos+BufferAttribute.itemSize,3);"
        "let p4=ux_u32_put(pos+BufferAttribute.componentType,10);let p5=ux_u32_put(pos+BufferAttribute.version,2);"
        "let sx=ux_f64_put(512,1.0);let tx=ux_f64_put(536,3.0);let ty=ux_f64_put(544,4.0);"
        "let idx=320;let i0=ux_u32_put(idx+BufferAttribute.data,576);let i1=ux_u32_put(idx+BufferAttribute.count,2);"
        "let i2=ux_u32_put(idx+BufferAttribute.stride,2);let i3=ux_u32_put(idx+BufferAttribute.itemSize,1);"
        "let i4=ux_u32_put(idx+BufferAttribute.componentType,4);let first=ux_u16_put(576,1);"
        "let bound=BufferGeometry_setAttribute(src,1,pos);let index=BufferGeometry_setIndex(src,idx);"
        "let group=BufferGeometry_addGroup(src,0,2,4);let draw=BufferGeometry_setDrawRange(src,1,1);"
        "let bounds=BufferGeometry_bounds(src,1,640,704);"
        "let copied=BufferGeometry_clone(dst,src,2048,256);let copy_view=BufferGeometry_getAttribute(dst,1);"
        "let copy_data=ux_u32(copy_view+BufferAttribute.data);let copy_index=BufferGeometry_getIndex(dst);"
        "let copy_box=ux_u32(dst+BufferGeometry.boundingBox)-1;let copy_sphere=ux_u32(dst+BufferGeometry.boundingSphere)-1;";
    const char *cases[]={
        "return copied==dst;","return ux_f64(copy_data);","return ux_f64(copy_data+32);",
        "return ux_u16(ux_u32(copy_index+BufferAttribute.data));","return ux_u32(copy_view+BufferAttribute.version);",
        "let changed=ux_f64_put(copy_data,9.0);return ux_f64(512);",
        "let changed=BufferGeometry_clearGroups(src);return ux_u32(1216);",
        "return ux_u32(1232);","return ux_u32(dst+BufferGeometry.drawStart);",
        "return ux_u32(dst+BufferGeometry.drawCount);","return ux_f64(copy_box+24);",
        "return ux_f64(copy_sphere+24);","return BufferGeometry_copy(dst,src,4096,8)==(0-1);",
        "let failed=BufferGeometry_copy(dst,src,4096,8);return ux_f64(copy_data);",
        "let data=ux_u32_put(pos+BufferAttribute.data,6291444);let size=ux_u32_put(pos+BufferAttribute.count,1);"
        "let stride=ux_u32_put(pos+BufferAttribute.stride,32);let kind=ux_u32_put(pos+BufferAttribute.componentType,9);"
        "let value=ux_f32_put(6291452,7.0);let fresh=BufferGeometry_copy(dst,src,4096,256);"
        "if(fresh!=dst) { return 0.0-1.0; }"
        "return ux_f32(ux_u32(BufferGeometry_getAttribute(dst,1)+BufferAttribute.data)+8);"
    };
    const double gold[]={1,1,4,1,0,1,1,4,1,1,3,2.23606797749979,1,1,7};
    return g_math_run("G_STRUCT BufferGeometry lifecycle","geometry-lifecycle",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?5:-1,"let changed=ux_f64_put(512,9.0);return ux_f64(512);");
}
