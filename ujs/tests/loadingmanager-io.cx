#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager",0};
    const char *setup="let manager=LoadingManager_init(0);let start=LoadingManager_item(manager,1,7,64);";
    const char *cases[]={
        "return start;",
        "return ux_u32(64+LoadingEvent.request);",
        "return LoadingManager_item(manager,1,8,64);",
        "let s=LoadingManager_item(manager,1,8,64);let err=LoadingManager_item(manager,3,8,64);return ux_u32(64+LoadingEvent.kind);",
        "let s=LoadingManager_item(manager,1,8,64);let err=LoadingManager_item(manager,3,8,64);let end=LoadingManager_item(manager,2,8,64);return ux_u32(64+LoadingEvent.loaded);",
        "let s=LoadingManager_item(manager,1,8,64);let end=LoadingManager_item(manager,2,8,64);let done=LoadingManager_item(manager,2,7,64);return ux_u32(64+LoadingEvent.size+LoadingEvent.kind);",
        "let end=LoadingManager_item(manager,2,7,64);let next=LoadingManager_item(manager,1,8,64);return ux_u32(64+LoadingEvent.total);",
        "return LoadingManager_item(manager,2,7,0);"
    };
    const double gold[]={1,7,0,3,1,4,2,-1};
    return g_math_run("G_IO LoadingManager","loadingmanager",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?4:-1,
        "let s=LoadingManager_item(manager,1,8,64);let err=LoadingManager_item(manager,3,8,64);return ux_u32(64+LoadingEvent.loaded);");
}
