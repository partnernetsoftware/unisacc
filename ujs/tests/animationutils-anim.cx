#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","animation-view","animationutils",0};
    const char *setup=
        "let a=ux_f32_put(0,3.0);let b=ux_f32_put(4,1.0);let c=ux_f32_put(8,1.0);let d=ux_f32_put(12,2.0);"
        "let e=ux_f32_put(72,10.0);let f=ux_f32_put(76,11.0);let g=ux_f32_put(80,20.0);let h=ux_f32_put(84,21.0);"
        "let order=AnimationUtils_getOrder(0,4,128);";
    const char *cases[]={
        "return ux_u32(order);","return ux_u32(order+4);","return ux_u32(order+12);",
        "let s=AnimationUtils_sortedArray(64,4,2,order,160);return ux_f32(s+4);",
        "let s=AnimationUtils_sortedArray(64,4,2,order,160);return ux_f32(s+8);",
        "let b=ux_u32_put(order+4,4);return AnimationUtils_sortedArray(64,4,2,order,160);",
        "return AnimationUtils_sortedArray(64,4,2,order,64);"
    };
    const double gold[]={1,2,0,11,20,-2,-1};
    return g_math_run("G_ANIM AnimationUtils","animationutils",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let a=ux_u32_put(order,2);let s=AnimationUtils_sortedArray(64,4,2,order,160);return ux_f32(s+4);");
}
