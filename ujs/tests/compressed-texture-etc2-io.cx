#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define TEXEL(offset) "let result=CompressedTexture_decodeETC2(32,512,64);return 0.0+ux_u32(512+" #offset ");"
#define HEADER(a,b,c,d) "let a=ux_u8_put(128," #a ");let b=ux_u8_put(129," #b ");let c=ux_u8_put(130," #c ");let d=ux_u8_put(131," #d ");"
#define PUNCH "let fmt=ux_u8_put(32+CompressedMip.format,118);"
#define ALPHA "let fmt=ux_u8_put(32+CompressedMip.format,120);let size=ux_u32_put(32+CompressedMip.bytes,16);"
#define RGBA(r,g,b,a) ((r)+256.0*(g)+65536.0*(b)+16777216.0*(a))

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","compressedtextureloader",
        "compressed-texture-etc1","compressed-texture-eac","compressed-texture-etc2",0};
    const char *setup="let mip=CompressedTextureLoader_level(32,128,8,4,4,33776);"
        "let format=ux_u32_put(32+CompressedMip.format,37492);";
    const char *cases[]={
        HEADER(30,45,60,4) TEXEL(0),
        HEADER(145,151,241,3) TEXEL(0),
        HEADER(249,24,76,219) TEXEL(0),
        HEADER(249,24,76,219) "let sel=ux_u8_put(135,1);" TEXEL(0),
        HEADER(104,28,38,110) TEXEL(0),
        HEADER(104,28,38,110) "let sel=ux_u8_put(135,1);" TEXEL(0),
        HEADER(25,1,251,102) "let tail=ux_u32_put(132,756821259);" TEXEL(0),
        HEADER(25,1,251,102) "let tail=ux_u32_put(132,756821259);" TEXEL(60),
        PUNCH HEADER(145,151,241,1) "let sel=ux_u8_put(133,1);" TEXEL(0),
        PUNCH HEADER(145,151,241,1) TEXEL(0),
        PUNCH HEADER(249,24,76,217) "let sel=ux_u8_put(133,1);" TEXEL(0),
        ALPHA HEADER(103,45,12,0) "let rgb=ux_u32_put(136,71052574);" TEXEL(16),
        ALPHA HEADER(103,13,12,0) "let rgb=ux_u32_put(136,71052574);" TEXEL(16),
        "return 0.0+CompressedTexture_decodeETC2(32,512,63);",
        "let broken=ux_u32_put(32+CompressedMip.bytes,7);return 0.0+CompressedTexture_decodeETC2(32,512,64);",
    };
    const double gold[]={RGBA(19,36,53,255),RGBA(150,150,249,255),
        RGBA(221,17,136,255),RGBA(100,236,253,255),RGBA(253,49,168,255),RGBA(189,0,104,255),
        RGBA(48,129,251,255),RGBA(250,112,124,255),0,RGBA(148,148,247,255),0,
        RGBA(19,36,53,83),RGBA(19,36,53,103),-1,-3};
    return g_wasm_batch("G_IO ETC2 software RGBA8","compressed-texture-etc2",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?8:-1,PUNCH HEADER(145,151,241,3) "let sel=ux_u8_put(133,1);" TEXEL(0));
}
