#pragma unisa use object_gate_pack
#pragma unisa use wasm_test_cache
#pragma unisa use r160_wait
#pragma unisa use g_math
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define TEST "ujs/practice/uxe/test/"

static const char *sources[]={
    TEST "mesh-object-json-base-layout.ujs",
    BASE "f64-math.ujs",
    BASE "views.ujs",
    BASE "matrix4.ujs",
    BASE "object-layouts.ujs",
    BASE "object3d.ujs",
    BASE "camera.ujs",
    BASE "perspectivecamera.ujs",
    BASE "arraycamera.ujs",
    BASE "json-read.ujs",
    BASE "json-bytes.ujs",
    BASE "loader-json.ujs",
    BASE "record-copy.ujs",
    BASE "camera-object-json.ujs",
    BASE "camera-lens-json-fields.ujs",
    BASE "perspectivecamera-object-json.ujs",
    BASE "arraycamera-object-json.ujs",
    TEST "arraycamera-object-json-base.ujs",0
};

static int compile(char **command,int seconds) {
    char *out=0;
    size_t bytes=0;
    const long start=sy_now_ms();
    int rc=cx_runv_timeout(command,seconds,&out,&bytes);
    printf("MESH_OBJECT compile_ms=%ld rc=%d\n",sy_now_ms()-start,rc);
    if(rc && out) printf("%.*s",(int)bytes,out);
    mm_free(out);
    return rc;
}

static int base_ready(const char *base,int prepare) {
    const char *cache=sy_env("UXE_ARRAY_CAMERA_CACHE");
    char key[65],sha[65],record[512];
    if(!cache || !cache[0]) {
        printf("ARRAY_CAMERA_OBJECT 基座缓存缺失，先运行 --prepare\n");
        return 1;
    }
    const char *inputs[24];
    int count=0;
    while(sources[count]) { inputs[count]=sources[count]; count++; }
    inputs[count]="ujs/tests/object_gate_pack.cx";
    inputs[count+1]=0;
    if(wasm_test_cache_key(inputs,key)) return 1;
    int size=tx_snprintf(record,sizeof record,"%s/%s.bin",cache,key);
    if(size<0 || size>=(int)sizeof record) return 1;
    int rc=wasm_test_cache_read(record,key,prepare?0:base,sha);
    if(!rc) {
        printf("ARRAY_CAMERA_OBJECT cache=hit key=%s sha=%s\n",key,sha);
        return 0;
    }
    if(rc!=-ENOENT || !prepare) {
        printf("ARRAY_CAMERA_OBJECT cache_rc=%d，先运行 --prepare\n",rc);
        return 1;
    }
    char input[380],program[100000];
    if(tx_snprintf(input,sizeof input,"%s.ujs",base)>=(int)sizeof input) return 1;
    int used=0;
    for(int i=0;sources[i];i++) {
        used=object_gate_pack_lines(program,used,sizeof program,sources[i]);
        if(used<0) {
            printf("MESH_OBJECT source_pack_failed=%s\n",sources[i]);
            return 1;
        }
    }
    if(sy_write_file(input,program,used,0600)) return 1;
    char *command[]={"./ujs/ujs2wasm.com",input,"-o",(char *)base,0};
    return compile(command,50) || wasm_test_cache_write(cache,record,key,base);
}

int main(int argc,char **argv) {
    int prepare=argc==2 && tx_eqz(argv[1],"--prepare");
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !prepare && !mutate) return 2;
    const char *fixture="arraycamera-object-json";
    char dir[256],base[320],probe[320],page[320],url[360];
    if(sy_mkdtemp("/tmp","uxe-mesh-object-",dir,sizeof dir)) return 2;
    tx_snprintf(base,sizeof base,"%s/base.wasm",dir);
    tx_snprintf(probe,sizeof probe,"%s/probe.wasm",dir);
    tx_snprintf(page,sizeof page,"%s/probe.html",dir);
    tx_snprintf(url,sizeof url,"file://%s?count=5%s",page,mutate?"&mutateAt=1":""
    );
    int failed=base_ready(base,prepare);
    if(!failed && !prepare) {
        char *command[]={"./ujs/ujs2wasm.com",TEST "mesh-object-json-probe.ujs","-o",probe,0};
        const double gold[]={2,402,401,50,-2};
        double actual[5],reference[5];
        failed=compile(command,6) || sy_copy(TEST "mesh-object-json-wasm.html",page,0600) ||
            r160_wait_ref(fixture,reference,5,dir) ||
            r160_wait_read(url,"#wasm-cases",actual,5,dir);
        for(int i=0;!failed && i<5;i++) {
            if(!g_math_near(actual[i],gold[i],1e-9) || !g_math_near(reference[i],gold[i],1e-9)) {
                printf("ARRAY_CAMERA_OBJECT case=%d actual=%.17g r160=%.17g gold=%.17g\n",i,actual[i],reference[i],gold[i]);
                failed=1;
            }
        }
    }
    if(sy_remove_all(dir)) failed=1;
    printf("G_STRUCT %s prepare=%d cases=%d failed=%d\n",fixture,prepare,prepare?0:5,failed);
    return failed;
}
