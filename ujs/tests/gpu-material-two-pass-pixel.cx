#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char entry[]=
        "import host_gpu_submit from \"uxe_gpu_v1\" (i64,i64) i64;\n"
        "export uxe_double_side(single:i64,mutate:i64) i64 version 1;\n";
    char dir[220],abi[260],wasm[260],cwd[400],url[760],*output=0;
    size_t bytes=0;
    if(sy_mkdtemp("/tmp","uxe-two-pass-",dir,sizeof dir) || sy_cwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/probe.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/ujs/practice/uxe/test/gpu-material-two-pass-r160.html?wasm=%s&mutate=%d",cwd,wasm,mutate);
    int failed=length<0 || length>=sizeof url || sy_write_file(abi,entry,sizeof entry-1,0600);
    char *compile[]={"./ujs/ujs2wasm.com",abi,"ujs/practice/uxe/base/record-copy.ujs",
        "ujs/practice/uxe/base/gpu-packet.ujs","ujs/practice/uxe/base/gpu-state.ujs",
        "ujs/practice/uxe/base/gpu-material-sides-generated.ujs","ujs/practice/uxe/base/gpu-material-two-pass.ujs",
        "ujs/practice/uxe/test/gpu-material-two-pass-probe.ujs","-o",wasm,0};
    if(!failed) {
        const int rc=cx_runv_timeout(compile,6,&output,&bytes);
        if(rc) printf("GPU_TWO_PASS compile_rc=%d %.*s\n",rc,(int)bytes,output?output:"");
        failed=rc!=0;
        mm_free(output);
        output=0;
    }
    const double gold[]={2,64,128,2,64,128,1,128,64,1,128,64};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    if(!failed) failed=r160_wait_read(url,"#r160",actual,count,dir);
    if(!failed) for(int i=0;i<count;i++) if(actual[i]!=gold[i]) {
        printf("GPU_TWO_PASS case=%d actual=%.0f gold=%.0f\n",i,actual[i],gold[i]);
        failed++;
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&output,&bytes)) failed++;
    mm_free(output);
    printf("GPU_TWO_PASS cases=%d failed=%d\n",count,failed);
    return failed!=0;
}
