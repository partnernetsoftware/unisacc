#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"arrowhelper",0};
    const char *setup="let pose=0;let a=ArrowHelper_setDirection(pose,1.0,0.0,0.0);"
        "let b=ArrowHelper_setDefaultLength(pose,5.0);";
    const char *cases[]={
        "return ux_f64(pose+ArrowHelperPose.qz);",
        "return ux_f64(pose+ArrowHelperPose.qw);",
        "let n=ArrowHelper_setDirection(pose,0.0,0.0-1.0,0.0);return ux_f64(pose+ArrowHelperPose.qx);",
        "let n=ArrowHelper_setDirection(pose,0.0,1.0,0.0);return ux_f64(pose+ArrowHelperPose.qw);",
        "return ux_f64(pose+ArrowHelperPose.shaftScaleY);",
        "return ux_f64(pose+ArrowHelperPose.headPositionY);",
        "return ux_f64(pose+ArrowHelperPose.headScaleY);",
        "return ux_f64(pose+ArrowHelperPose.headScaleXZ);",
        "let n=ArrowHelper_setLength(pose,1.0,2.0,0.3);return ux_f64(pose+ArrowHelperPose.shaftScaleY);",
        "let n=ArrowHelper_setDirection(pose,0.0,2.0,0.0);return ux_f64(pose+ArrowHelperPose.qz);",
    };
    const double q=0.70710678118654752440;
    const double gold[]={-q,q,1,1,4,5,1,0.2,0.0001,-q};
    return g_wasm_batch("G_STRUCT ArrowHelper","arrowhelper",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,"return ux_f64(pose+ArrowHelperPose.qw);");
}
