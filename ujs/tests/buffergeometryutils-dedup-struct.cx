#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define MERGE "let n=BufferGeometryUtils_mergeV(32,64,2048,16,0.01);"
#define INDEXED "let indices=ux_u32_put(64+GeometryBuffers.indexCount,6);"
#define READ_INDEX(i) "return 0.0+ux_u32(1536+4*" #i ");"
#define COUNTS MERGE "return 0.0+ux_u32(32+GeometryBuffers.vertexCount);", \
    MERGE "return 0.0+ux_u32(32+GeometryBuffers.indexCount);"
#define INDICES MERGE READ_INDEX(0), MERGE READ_INDEX(1), MERGE READ_INDEX(2), \
    MERGE READ_INDEX(3), MERGE READ_INDEX(4), MERGE READ_INDEX(5)

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"f64-math","geometry-buffers","buffergeometryutils-dedup",0};
    const char *setup=
        "let src=GeometryBuffers_init(64,256,6,768,6);let dst=GeometryBuffers_init(32,1024,6,1536,6);"
        "let an=ux_u32_put(64+GeometryBuffers.vertexCount,6);"
        "let x1=ux_f32_put(288,1.0);let x4=ux_f32_put(384,1.004);"
        "let y2=ux_f32_put(324,1.0);let y5=ux_f32_put(420,1.0);"
        "let u1=ux_f32_put(312,1.0);let u4=ux_f32_put(408,1.0);"
        "let v2=ux_f32_put(348,1.0);let v5=ux_f32_put(444,0.5);"
        "let j0=ux_u32_put(768,4);let j2=ux_u32_put(776,5);let j3=ux_u32_put(780,1);"
        "let j4=ux_u32_put(784,3);let j5=ux_u32_put(788,2);"
        "let i=0;while(i<6){let f=ux_f32_put(276+i*32,1.0);i=i+1;}";
    const char *cases[]={
        COUNTS, INDICES, MERGE "return ux_f32(1056);",MERGE "return ux_f32(1148);",
        INDEXED MERGE "return 0.0+ux_u32(32+GeometryBuffers.vertexCount);",
        INDEXED MERGE "return 0.0+ux_u32(32+GeometryBuffers.indexCount);",
        INDEXED MERGE READ_INDEX(0), INDEXED MERGE READ_INDEX(1), INDEXED MERGE READ_INDEX(2),
        INDEXED MERGE READ_INDEX(3), INDEXED MERGE READ_INDEX(4), INDEXED MERGE READ_INDEX(5),
        INDEXED MERGE "return ux_f32(1024);", INDEXED MERGE "return ux_f32(1116);",
        INDEXED "let bad=ux_u32_put(788,6);" MERGE "return 0.0+n;",
        INDEXED "let bad=ux_u32_put(788,6);let marker=ux_u32_put(1536,77);" MERGE "return 0.0+ux_u32(1536);",
        "return 0.0+BufferGeometryUtils_mergeV(32,64,1024,16,0.01);",
    };
    const double gold[]={4,6,0,1,2,0,1,3,1,0.5,4,6,0,1,2,0,1,3,(float)1.004,0.5,-2,77,-1};
    return g_wasm_batch_addon("G_STRUCT BufferGeometryUtils merge vertices","buffergeometryutils-dedup",
        argv[1],modules,setup,cases,gold,sizeof gold/sizeof gold[0],mutate?0:-1,
        "let n=BufferGeometryUtils_mergeV(32,64,2048,16,0.001);return 0.0+ux_u32(32+GeometryBuffers.vertexCount);");
}
