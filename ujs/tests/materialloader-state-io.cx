#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","json-read","loader-json","materialloader-state",0};
    const char explicit_json[]="{\"type\":\"MeshPhongMaterial\",\"side\":2,\"depthFunc\":6,"
        "\"depthTest\":false,\"depthWrite\":false,\"colorWrite\":false,\"alphaTest\":0.375}";
    const char default_json[]="{\"type\":\"MeshBasicMaterial\"}";
    const char bad_json[]="{\"side\":3}";
    char setup[3400];
    int n=tx_snprintf(setup,sizeof setup,"let file=0;let out=256;let key=512;let input=768;let size=%d;",
        (int)sizeof explicit_json-1);
    const char *inputs[]={explicit_json,default_json,bad_json};
    const int sizes[]={sizeof explicit_json-1,sizeof default_json-1,sizeof bad_json-1};
    for(int v=0;v<3;v++) {
        const int size=sizes[v];
        const int at=768+v*256;
        for(int start=0; start<size; start+=48) {
            int count=size-start;
            if(count>48) count=48;
            n+=tx_snprintf(setup+n,sizeof setup-n,"if(1){let raw=[");
            for(int j=0;j<count;j++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",j?",":"",inputs[v][start+j]);
            n+=tx_snprintf(setup+n,sizeof setup-n,"];let i=0;while(i<%d){let put=ux_u8_put(%d+i,raw[i]);i=i+1;}}",
                count,at+start);
        }
    }
    n+=tx_snprintf(setup+n,sizeof setup-n,
        "if(selected_case>=6 && selected_case<=8){input=1024;size=%d;}"
        "if(selected_case==9){input=1280;size=%d;}"
        "let ready=ux_u32_put(file+FileLoader.state,2);let source=ux_u32_put(file+FileLoader.bytes,input);"
        "let length=ux_u32_put(file+FileLoader.length,size);let keep=ux_u32_put(out+LoadedMaterialState.side,77);"
        "let result=MaterialLoader_parseState(file,out,key);",
        (int)sizeof default_json-1,(int)sizeof bad_json-1);
    if(n<0 || n>=(int)sizeof setup) return 2;
    const char *cases[]={
        "return 0.0+ux_u32(out+LoadedMaterialState.side);",
        "return 0.0+ux_u32(out+LoadedMaterialState.depthFunction);",
        "return 0.0+ux_u32(out+LoadedMaterialState.depthTest);",
        "return 0.0+ux_u32(out+LoadedMaterialState.depthWrite);",
        "return 0.0+ux_u32(out+LoadedMaterialState.colorWrite);",
        "return ux_f64(out+LoadedMaterialState.alphaTest);",
        "return 0.0+ux_u32(out+LoadedMaterialState.depthFunction);",
        "return 0.0+ux_u32(out+LoadedMaterialState.depthWrite);",
        "return ux_f64(out+LoadedMaterialState.alphaTest);",
        "return 0.0+(result==0-3 && ux_u32(out+LoadedMaterialState.side)==77);",
    };
    const double gold[]={2,6,0,0,0,0.375,3,1,0,1};
    return g_wasm_batch("G_IO MaterialLoader pipeline state","materialloader-state",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,"return 0.0+ux_u32(out+LoadedMaterialState.side);");
}
