#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","helper-geometry","lighthelper-common","spotlighthelper",0};
    const char *setup="let helper=0;let positions=128;let light=1024;let target=1152;let color=1280;let over=1344;"
        "let x=ux_f64_put(light+96,1.0);let y=ux_f64_put(target+96,4.0);let z=ux_f64_put(target+112,4.0);"
        "let c=ux_f64_put(color,0.25);let d=ux_f64_put(over+8,0.75);"
        "let init=SpotLightHelper_init(helper,positions,light,target,8.0,0.7853981633974483,color,0-1);";
    const char *cases[]={
        "return 0.0+ux_u32(helper+SpotLightHelper.count);",
        "return ux_f32(positions+36);",
        "return ux_f32(positions+112);",
        "return ux_f32(positions+120);",
        "return ux_f32(positions+136);",
        "return ux_f32(positions+880);",
        "return ux_f64(helper+SpotLightHelper.lookX);",
        "return ux_f64(helper+SpotLightHelper.lookZ);",
        "return ux_f64(helper+SpotLightHelper.width);",
        "return ux_f64(helper+SpotLightHelper.red);",
        "let up=SpotLightHelper_update(helper,target,0.0,0.0,color,over);return ux_f64(helper+SpotLightHelper.length);",
        "let up=SpotLightHelper_update(helper,target,0.0,0.0,color,over);return ux_f64(helper+SpotLightHelper.width);",
        "let up=SpotLightHelper_update(helper,target,0.0,0.0,color,over);return ux_f64(helper+SpotLightHelper.green);",
        "let gone=SpotLightHelper_dispose(helper);return 0.0+ux_u32(helper+SpotLightHelper.active);",
        "let gone=SpotLightHelper_dispose(helper);return 0.0+SpotLightHelper_update(helper,target,0.0,0.0,color,over);",
        "return 0.0+SpotLightHelper_init(helper,positions,positions,target,8.0,0.0,color,0-1);",
    };
    const double gold[]={74,1,-1,1,(double)(float)0.19509032201612825,0,0.6,0.8,8,0.25,1000,0,0.75,0,-1,-1};
    return g_wasm_batch("G_STRUCT SpotLightHelper","spotlighthelper",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?10:-1,"let up=SpotLightHelper_update(helper,target,1.0,0.0,color,over);return ux_f64(helper+SpotLightHelper.length);");
}
