#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","geometry-buffers","planegeometry","datautils",
        "bufferattribute","buffergeometry","geometry-buffer-adapter",0};
    const char *setup="let raw=GeometryBuffers_init(0,256,4,512,6);"
        "let generated=PlaneGeometry_generate(raw,6.0,4.0,1,1);"
        "let geo=BufferGeometry_init(64,640,3,704,1);"
        "let start=ux_u32_put(768,0);let count=ux_u32_put(772,6);let material=ux_u32_put(776,3);";
    const char *cases[]={
        "let done=GeometryBuffers_asGeometry(raw,geo,2048,512,7,768,1);return ux_u32(640);",
        "let done=GeometryBuffers_asGeometry(raw,geo,2048,512,7,768,1);"
        "return BufferAttribute_getComponent(BufferGeometry_getAttribute(geo,1),0,0);",
        "let done=GeometryBuffers_asGeometry(raw,geo,2048,512,7,768,1);"
        "return BufferAttribute_getComponent(BufferGeometry_getAttribute(geo,2),1,2);",
        "let done=GeometryBuffers_asGeometry(raw,geo,2048,512,7,768,1);"
        "return BufferAttribute_getComponent(BufferGeometry_getAttribute(geo,4),3,0);",
        "let done=GeometryBuffers_asGeometry(raw,geo,2048,512,7,768,1);"
        "return BufferAttribute_getComponent(BufferGeometry_getIndex(geo),4,0);",
        "let done=GeometryBuffers_asGeometry(raw,geo,2048,512,7,768,1);"
        "return ux_u32(BufferGeometry_getIndex(geo)+BufferAttribute.componentType);",
        "let done=GeometryBuffers_asGeometry(raw,geo,2048,512,7,768,1);return ux_u32(720);",
        "let done=GeometryBuffers_asGeometry(raw,geo,2048,512,7,768,1);"
        "let bounds=BufferGeometry_computeBoundingSphere(geo,1,896);return ux_f64(920);",
        "let done=GeometryBuffers_asGeometry(raw,geo,2048,512,7,768,1);"
        "let edit=ux_f32_put(256,9.0);return BufferAttribute_getComponent(BufferGeometry_getAttribute(geo,1),0,0);",
        "let done=GeometryBuffers_asGeometry(raw,geo,2048,8,7,768,1);return done+ux_u32(640);",
        "let broken=ux_u32_put(512,4);return GeometryBuffers_asGeometry(raw,geo,2048,512,7,768,1);",
        "let extra=ux_u32_put(772,7);return GeometryBuffers_asGeometry(raw,geo,2048,512,7,768,1);"
    };
    const double gold[]={3,-3,1,1,3,4,3,3.605551275463989,-3,-2,-1,-1};
    return g_math_run("G_STRUCT Generated geometry adapter","geometry-buffer-adapter",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let done=GeometryBuffers_asGeometry(raw,geo,2048,512,7,768,1);"
        "return BufferAttribute_getComponent(BufferGeometry_getAttribute(geo,1),0,1);");
}
