#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define ROUNDTRIP "let last=PerspectiveCamera_toJSON(node,lens,7800,1,8192,9216,9408);" \
    "let loaded=PerspectiveCamera_fromJSON(target,6144,8192,last,10800);if(loaded<0){return 0.0+loaded;}"

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d","camera",
        "perspectivecamera","json-read","json-bytes","loader-json","record-copy",
        "camera-object-json","camera-lens-json-fields","perspectivecamera-object-json",0};
    const char *setup="let arena=Object3D_initArena(0,4);let a=Object3D_create(arena);let b=Object3D_create(arena);"
        "let node=Object3D_address(arena,a);let target=Object3D_address(arena,b);"
        "let lens=PerspectiveCamera_init(6000,60.0,2.0,1.0,150.0);"
        "let zoom=ux_f64_put(lens+PerspectiveCamera.zoom,2.0);"
        "let focus=ux_f64_put(lens+PerspectiveCamera.focus,15.0);"
        "let off=PerspectiveCamera_setViewOffset(lens,800.0,400.0,200.0,100.0,400.0,200.0);"
        "let id=ux_u8_put(7800,99);";
    const char *cases[]={
        ROUNDTRIP "return ux_f64(loaded+PerspectiveCamera.fov);",
        ROUNDTRIP "return ux_f64(loaded+PerspectiveCamera.zoom);",
        ROUNDTRIP "return ux_f64(loaded+PerspectiveCamera.focus);",
        ROUNDTRIP "return ux_f64(loaded+PerspectiveCamera.viewX);",
        ROUNDTRIP "let cam=Camera_init(6400,6656);let p=PerspectiveCamera_updateProjectionMatrix(loaded,cam);"
        "return ux_f64(ux_u32(cam+Camera.projectionMatrix));",
        "let last=PerspectiveCamera_toJSON(node,lens,7800,1,8192,9216,9408);"
        "return 0.0+PerspectiveCamera_fromJSON(target,6144,8192,last-1,10800);",
    };
    const double gold[]={60,2,15,200,3.464101615137755,-2};
    return g_wasm_batch("G_STRUCT PerspectiveCamera JSON","perspectivecamera-object-json",modules,setup,cases,gold,6,
        mutate?2:-1,"let changed=ux_f64_put(lens+PerspectiveCamera.focus,1.0);" ROUNDTRIP
        "return ux_f64(loaded+PerspectiveCamera.focus);");
}
