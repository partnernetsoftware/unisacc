#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"f64-math","transformcontrols-translate","transformcontrols-rotate-frame",0};
    const char *setup="let q=32;let parent=64;let delta=128;let camera=192;let out=256;"
        "let initial=ux_f64_put(q+24,1.0);"
        "let pz=ux_f64_put(parent+16,0.7071067811865476);let pw=ux_f64_put(parent+24,0.7071067811865476);"
        "let cz=ux_f64_put(camera+16,10.0);let dx=ux_f64_put(delta,0.375);";
    #define MOVE "let done=TransformControls_rotFrame(out,q,parent,delta,camera,1,0.5,"
    #define LOCAL MOVE "1);"
    #define WORLD MOVE "0);"
    #define ANGLE "return ux_f64(out+32);"
    #define DOWN "let dy=ux_f64_put(delta+8,0.0-0.375);"
    #define UP "let dy=ux_f64_put(delta+8,0.375);"
    #define INITIAL_Z "let qz=ux_f64_put(q+16,0.7071067811865476);let qw=ux_f64_put(q+24,0.7071067811865476);"
    const char *cases[]={
        LOCAL ANGLE,
        LOCAL "return ux_f64(out);",
        DOWN WORLD ANGLE,
        DOWN WORLD "return ux_f64(out+8);",
        UP INITIAL_Z LOCAL "return ux_f64(out+8);",
        UP INITIAL_Z LOCAL "return ux_f64(out+16);",
        DOWN INITIAL_Z WORLD "return ux_f64(out);",
        "let dx=ux_f64_put(delta,0.0-0.375);" LOCAL ANGLE,
        "return 0.0+TransformControls_rotFrame(out,q,parent,delta,camera,1,0.5,2);",
        "let marked=ux_f64_put(out,17.0);let empty=ux_f64_put(parent+16,0.0);"
          "let zero=ux_f64_put(parent+24,0.0);" LOCAL "return ux_f64(out);",
    };
    const double s=0.479425538604203,c=0.8775825618903728,h=0.7071067811865476;
    const double gold[]={1,s,1,-s,s*h,c*h,-s*h,-0.5,-1,17};
    return g_wasm_batch_addon("G_RAY TransformControls rotation frames","transformcontrols-rotate-frame",
        argv[1],modules,setup,cases,gold,sizeof gold/sizeof gold[0],mutate?0:-1,WORLD ANGLE);
}
