#pragma unisa use g_wasm_batch
#pragma unisa use text.text

static double gain_scaled(double initial,double target,double elapsed) {
    const double x=-100.0*elapsed;
    double term=1.0;
    double decay=1.0;
    for(int i=1;i<=18;i++) {
        term*=x/i;
        decay+=term;
    }
    return (int)((target+(initial-target)*decay)*1000000+0.5);
}

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","loadingmanager","fileloader","audioloader","audio-buffer-playback","audio-master-gain",0};
    const char *setup="let state=0;let ready=AudioListener_initMasterGain(state,0.0);"
        "let set=AudioListener_setMasterVolume(state,0.25,0.0);";
    #define SAMPLE(t) "return 0.0+f64_floor_i64(1000000.0*AudioListener_masterVolume(state," t ")+0.5);"
    const char *cases[]={
        SAMPLE("0.0"),
        SAMPLE("64.0/48000.0"),
        SAMPLE("128.0/48000.0"),
        SAMPLE("255.0/48000.0"),
        "let next=AudioListener_setMasterVolume(state,0.75,128.0/48000.0);" SAMPLE("128.0/48000.0"),
        "let first=AudioListener_setMasterVolume(state,0.75,128.0/48000.0);"
        "return 0.0+AudioListener_setMasterVolume(state,0.8,0.0);",
    };
    const double gold[]={1000000,gain_scaled(1,0.25,64.0/48000),gain_scaled(1,0.25,128.0/48000),
        gain_scaled(1,0.25,255.0/48000),gain_scaled(1,0.25,128.0/48000),-1};
    return g_wasm_batch_page("G_IO AudioListener gain automation","audio-master-gain",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,SAMPLE("128.0/48000.0"));
}
