#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d","scene","group",
        "json-read","loader-json","loadingmanager","fileloader","objectloader",0};
    const char json[]="{\"object\":{\"type\":\"Scene\",\"position\":[1,0,0],\"children\":["
        "{\"type\":\"Group\",\"position\":[2,0,0],\"children\":[{\"type\":\"Mesh\",\"geometry\":\"geo-a\",\"material\":\"mat-a\",\"position\":[3,0,0]}]},"
        "{\"type\":\"Mesh\",\"geometry\":\"geo-a\",\"material\":\"mat-a\",\"position\":[8,0,0]}]}}";
    const int size=sizeof json-1;
    char setup[5500];
    int n=tx_snprintf(setup,sizeof setup,
        "let input=4200;let size=%d;let arena=1024;let opt=512;let geometries=576;let materials=640;let links=704;"
        "let a=ux_u32_put(opt+ObjectLoadBindings.geometries,geometries);"
        "let b=ux_u32_put(opt+ObjectLoadBindings.geometryCount,1);"
        "let c=ux_u32_put(opt+ObjectLoadBindings.materials,materials);"
        "let d=ux_u32_put(opt+ObjectLoadBindings.materialCount,1);"
        "let e=ux_u32_put(opt+ObjectLoadBindings.links,links);"
        "let f=ux_u32_put(opt+ObjectLoadBindings.linkCapacity,2);"
        "let g=ux_u32_put(geometries,912);let h=ux_u32_put(geometries+4,5);let i=ux_u32_put(geometries+8,11);"
        "let j=ux_u32_put(materials,928);let k=ux_u32_put(materials+4,5);let l=ux_u32_put(materials+8,19);"
        "let m=ux_u32_put(912,762275175);let o=ux_u8_put(916,97);"
        "let q=ux_u32_put(928,762601837);let r=ux_u8_put(932,97);",size);
    for(int at=0;at<size;at+=64) {
        int count=size-at;
        if(count>64) count=64;
        n+=tx_snprintf(setup+n,sizeof setup-n,"if(1){let raw=[");
        for(int i=0;i<count;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[at+i]);
        n+=tx_snprintf(setup+n,sizeof setup-n,"];let i=0;while(i<%d){let a=ux_u8_put(input+%d+i,raw[i]);i=i+1;}}",count,at);
    }
    tx_snprintf(setup+n,sizeof setup-n,"let manager=LoadingManager_init(0);let file=FileLoader_init(32,manager);"
        "let id=FileLoader_begin(file,64);let ready=FileLoader_receive(file,id,200,input,size,64);");
    #define READ "let root=ObjectLoader_sceneWithMeshes(file,arena,6,768,opt);"
    #define UPDATE "let step=Object3D_updateMatrixWorld(arena,root,0);"
    const char *cases[]={
        READ "return 0.0+ux_u32(opt+ObjectLoadBindings.linkCount);",
        READ "return 0.0+ux_u32(links+4);",
        READ "return 0.0+ux_u32(links+8);",
        READ "return 0.0+(ux_u32(links+4)==ux_u32(links+16)&&ux_u32(links+8)==ux_u32(links+20));",
        READ UPDATE "let node=Object3D_address(arena,ux_u32(links));return ux_f64(ux_u32(node+Object3D.worldMatrix)+96);",
        READ UPDATE "let node=Object3D_address(arena,ux_u32(links+12));return ux_f64(ux_u32(node+Object3D.worldMatrix)+96);",
        "let bad=ux_u8_put(916,98);" READ "return 0.0+root;",
        "let capacity=ux_u32_put(opt+ObjectLoadBindings.linkCapacity,1);"
        READ "return 0.0+ux_u32(opt+ObjectLoadBindings.linkCount);",
        "let capacity=ux_u32_put(opt+ObjectLoadBindings.linkCapacity,1);"
        READ "return 0.0+Object3D_address(arena,65537);",
        "return 0.0+ObjectLoader_scene(file,arena,6,768);",
    };
    const double gold[]={2,11,19,1,6,9,-5,0,-1,-3};
    return g_wasm_batch("G_IO ObjectLoader mesh resource links","objectloader-mesh-links",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,READ "return 0.0+ux_u32(links+4);");
}
