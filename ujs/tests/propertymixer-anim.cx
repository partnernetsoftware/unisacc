#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","animation-view","propertymixer",0};
    const char *setup=
        "let a=ux_f64_put(64,10.0);let b=ux_f64_put(80,20.0);let c=ux_f64_put(96,30.0);"
        "let d=ux_f64_put(112,4.0);let mixer=PropertyMixer_init(0,144,64,1);";
    const char *cases[]={
        "let a=PropertyMixer_accumulate(mixer,80,0.25,2500);let out=PropertyMixer_apply(a);return ux_f64(out);",
        "let a=PropertyMixer_accumulate(mixer,80,0.25,2500);let b=PropertyMixer_accumulate(a,96,0.5,2500);"
        "let out=PropertyMixer_apply(b);return ux_f64(out);",
        "let a=PropertyMixer_accumulate(mixer,80,0.25,2500);let b=PropertyMixer_accumulate(a,112,0.5,2501);"
        "let out=PropertyMixer_apply(b);return ux_f64(out);",
        "let a=PropertyMixer_accumulate(mixer,80,1.0,2500);let previous=PropertyMixer_apply(a);"
        "let out=PropertyMixer_apply(a);return ux_f64(out);",
        "let a=PropertyMixer_accumulate(mixer,80,1.0,2500);let out=PropertyMixer_apply(a);"
        "return ux_f64(PropertyMixer_original(a));",
        "return PropertyMixer_accumulate(mixer,144,1.0,2500);"
    };
    const double gold[]={12.5,22.5,14.5,10,10,-1};
    return g_math_run("G_ANIM PropertyMixer","propertymixer",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let a=PropertyMixer_accumulate(mixer,80,0.25,2500);let b=PropertyMixer_accumulate(a,112,0.5,2500);"
        "let out=PropertyMixer_apply(b);return ux_f64(out);");
}
