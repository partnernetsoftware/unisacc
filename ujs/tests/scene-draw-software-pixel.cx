#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","scene-snapshot-layout","render-list","scene-render-list",
        "scene-draw-project","scene-rgba8-blend","scene-draw-software",0};
    const char *setup="let draw=0;let stream=64;let rt=100;let world=128;let proj=256;let xyz=512;let rgb=640;"
        "let vertices=768;let color=1024;let depth=2048;let right=(8*16+12)*4;let left=(8*16+3)*4;"
        "let a=ux_u32_put(draw+SceneDrawItem.worldMatrix,world);"
        "let b=ux_u32_put(stream+SceneDrawStream.positions,xyz);let c=ux_u32_put(stream+SceneDrawStream.vertexCount,3);"
        "let d=ux_u32_put(stream+SceneDrawStream.stride,12);let e=ux_u32_put(stream+SceneDrawStream.color,rgb);"
        "let f=ux_u32_put(stream+SceneDrawStream.viewProjection,proj);let i=0;"
        "while(i<4){let a=ux_f64_put(world+i*40,1.0);let b=ux_f64_put(proj+i*40,1.0);i=i+1;}"
        "let x=ux_f64_put(world+96,0.55);let x0=ux_f32_put(xyz,0.0-0.25);let y0=ux_f32_put(xyz+4,0.0-0.5);"
        "let x1=ux_f32_put(xyz+12,0.25);let y1=ux_f32_put(xyz+16,0.0-0.5);let y2=ux_f32_put(xyz+28,0.5);"
        "let g=ux_f32_put(rgb+4,1.0);let alpha=ux_f32_put(rgb+12,1.0);"
        "let r=ux_u32_put(rt+SceneRasterTarget.rgba,color);let z=ux_u32_put(rt+SceneRasterTarget.depth,depth);"
        "let w=ux_u32_put(rt+SceneRasterTarget.width,16);let h=ux_u32_put(rt+SceneRasterTarget.height,16);"
        "i=0;while(i<256){let p=ux_u32_put(color+i*4,4278190080);let q=ux_f32_put(depth+i*4,1.0);i=i+1;}";
    #define RENDER "let n=SceneDraw_projectPacked(draw,stream,vertices,3);let paint=SceneDraw_softwareFlat(rt,vertices,n);"
    const char *cases[]={
        RENDER "return 0.0+ux_u32(color+left);",
        RENDER "return 0.0+ux_u32(color+right);",
        RENDER "return ux_f32(depth+right);",
        RENDER "return ux_f32(depth+left);",
        RENDER "let farther=ux_f64_put(world+112,0.5);let red=ux_f32_put(rgb,1.0);let noGreen=ux_f32_put(rgb+4,0.0);"
        "let changed=SceneDraw_projectPacked(draw,stream,vertices,3);let blocked=SceneDraw_softwareFlat(rt,vertices,changed);"
        "return 0.0+ux_u32(color+right);",
        "let alpha=ux_f32_put(rgb+12,0.5);" RENDER "return 0.0+(paint==0-2 && ux_u32(color+right)==4278190080);",
    };
    const double gold[]={4278190080.0,4278255360.0,0.5,1,4278255360.0,1};
    return g_wasm_batch_page("G_PIXEL shared software flat draw","scene-draw-software",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let moved=ux_f64_put(world+96,0.0-0.55);" RENDER "return 0.0+ux_u32(color+right);");
}
