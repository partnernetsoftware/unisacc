#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define WRITE "let stop=FramebufferTexture_writeJSON(128,256,512,1024);"
#define READ "let result=FramebufferTexture_readJSON(160,256,stop,2304);"

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","helper-buffers","json-read","json-bytes",
        "framebuffer-texture","framebuffer-texture-json",0};
    const char *setup="let w=ux_u32_put(128,2);let h=ux_u32_put(132,3);"
        "let format=ux_u32_put(136,1023);let kind=ux_u32_put(140,1009);";
    const char *cases[]={
        WRITE READ "return 0.0+ux_u32(160);",
        WRITE READ "return 0.0+ux_u32(164);",
        WRITE READ "return 0.0+ux_u32(168);",
        WRITE READ "return 0.0+ux_u32(172);",
        "let bad=ux_u32_put(140,1015);return 0.0+FramebufferTexture_writeJSON(128,256,512,1024);",
        WRITE "let invalid=ux_u8_put(stop-2,48);" READ "return 0.0+result;"
    };
    const double gold[]={2,3,1023,1009,-1,-1};
    return g_wasm_batch("G_STRUCT FramebufferTexture JSON","framebuffer-texture-json",modules,setup,cases,gold,6,
        mutate?1:-1,"let changed=ux_u32_put(132,2);" WRITE READ "return 0.0+ux_u32(164);");
}
