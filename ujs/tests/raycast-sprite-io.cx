#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","vector-scalar","vector3","ray","raycast-memory",
        "raycaster-state","raycast-sprite",0};
    const char *setup=
        "let state=0;let req=128;let world=256;let view=384;let out=640;"
        "let state=Raycaster_default(state);let x=ux_f64_put(state+RaycasterState.ox,1.5);"
        "let y=ux_f64_put(state+RaycasterState.oy,0.5);"
        "let a=ux_u32_put(req+RaySpriteQuery.world,world);let b=ux_u32_put(req+RaySpriteQuery.view,view);"
        "let c=ux_u32_put(req+RaySpriteQuery.layerMask,1);let d=ux_f64_put(req+RaySpriteQuery.centerX,0.25);"
        "let e=ux_f64_put(req+RaySpriteQuery.centerY,0.5);"
        "let sx=ux_f64_put(world,2.0);let sy=ux_f64_put(world+40,4.0);let sz=ux_f64_put(world+80,1.0);"
        "let sw=ux_f64_put(world+120,1.0);let px=ux_f64_put(world+96,1.0);let pz=ux_f64_put(world+112,0.0-5.0);"
        "let vx=ux_f64_put(view,1.0);let vy=ux_f64_put(view+40,1.0);let vz=ux_f64_put(view+80,1.0);"
        "let vw=ux_f64_put(view+120,1.0);";
    #define HIT "let hit=Raycaster_intersectSprite(state,req,out);"
    #define TURN "let angle=ux_f64_put(req+RaySpriteQuery.rotation,1.5707963267948966);"
    const char *cases[]={
        HIT "return 0.0+hit;",
        HIT "return ux_f64(out+RaySpriteHit.distance);",
        HIT "return ux_f64(out+RaySpriteHit.u);",
        HIT "return ux_f64(out+RaySpriteHit.v);",
        TURN HIT "return ux_f64(out+RaySpriteHit.v);",
        "let depth=ux_u32_put(req+RaySpriteQuery.depthScale,1);" HIT "return ux_f64(out+RaySpriteHit.u);",
        "let x=ux_f64_put(state+RaycasterState.ox,4.0);" HIT "return 0.0+hit;",
        "let clip=ux_f64_put(state+RaycasterState.far,4.0);" HIT "return 0.0+hit;",
        "let layers=ux_u32_put(req+RaySpriteQuery.layerMask,2);" HIT "return 0.0+hit;",
        "let z=ux_f64_put(state+RaycasterState.dz,0.0);" HIT "return 0.0+hit;",
        "return 0.0+Raycaster_intersectSprite(state,req,world);",
    };
    const double gold[]={1,5,0.5,0.625,0.375,0.3,0,0,0,0,-1};
    return g_wasm_batch("G_RAY Raycaster sprite","raycast-sprite",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?4:-1,HIT "return ux_f64(out+RaySpriteHit.v);");
}
