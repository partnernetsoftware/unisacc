#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","mesh-layout","skeleton-layout","skinnedmesh-deform",
        "skinnedmesh",0};
    const char *setup=
        "let skeleton=960;let count=ux_u32_put(skeleton+Skeleton.count,2);"
        "let palette=ux_u32_put(skeleton+Skeleton.palette,1408);"
        "let i=0;while(i<32){let w=ux_f32_put(1408+4*i,(i%16%5==0)*1.0);i=i+1;}"
        "let tx=ux_f32_put(1456,4.0);let ty=ux_f32_put(1524,8.0);"
        "let src=Matrix4_makeScale(1792,2.0,1.0,1.0);let skin=SkinnedMesh_init(1984,2048,2112,2240);"
        "let stored=SkinnedMesh_bind(skin,skeleton,src);"
        "let x=ux_f64_put(2432,1.0);let y=ux_f64_put(2440,2.0);let z=ux_f64_put(2448,3.0);"
        "let i0=ux_u32_put(2496,0);let i1=ux_u32_put(2500,1);"
        "let w0=ux_f32_put(2560,0.25);let w1=ux_f32_put(2564,0.75);"
        "let v=SkinnedMesh_applyBoneTransform(skin,2432,2496,2560);";
    const char *cases[]={
        "return ux_f64(v);","return ux_f64(v+8);","return ux_f64(v+16);",
        "return ux_f64(2240);",
        "let stale=ux_u32_put(2500,2);return SkinnedMesh_applyBoneTransform(skin,2432,2496,2560);"
    };
    const double gold[]={1.5,8,3,0.5,-1};
    return g_math_run("G_STRUCT SkinnedMesh","skinnedmesh",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?1:-1,"return ux_f64(v+16);");
}
