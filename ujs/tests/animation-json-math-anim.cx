#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define FLATTEN "let done=AnimationUtils_flattenMathKeys(128,4,0);"

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"animation-view","object-json-tokens","json-read","animation-json-flatten","animation-json-math",0};
    const char *setup=
        "let a=ux_u32_put(AnimationJsonRows.times,384);let b=ux_u32_put(AnimationJsonRows.values,512);"
        "let c=ux_u32_put(AnimationJsonRows.rowCapacity,5);let d=ux_u32_put(AnimationJsonRows.valueCapacity,12);"
        "let e=ux_u32_put(AnimationJsonRows.rowCount,1);let f=ux_u32_put(AnimationJsonRows.valueCount,1);"
        "let oldTime=ux_f64_put(384,-2.0);let oldValue=ux_f64_put(512,77.0);"
        "let i=0;while(i<4){let key=128+i*AnimationMathKey.size;let addr=640+i*32;let lanes=0;"
        "if(i==1){lanes=2;}if(i==2){lanes=3;}if(i==3){lanes=4;}"
        "let time=ux_f64_put(key+AnimationMathKey.time,0.0+i);let link=ux_u32_put(key+AnimationMathKey.values,addr);"
        "let width=ux_u32_put(key+AnimationMathKey.lanes,lanes);let j=0;"
        "while(j<lanes){let value=ux_f64_put(addr+j*8,10.0*i+j);j=j+1;}i=i+1;}";
    const char *cases[]={
        FLATTEN "return 0.0+ux_u32(AnimationJsonRows.rowCount);",
        FLATTEN "return 0.0+ux_u32(AnimationJsonRows.valueCount);",
        FLATTEN "return ux_f64(384);",
        FLATTEN "return ux_f64(392);",
        FLATTEN "return ux_f64(512);",
        FLATTEN "return ux_f64(520);",
        FLATTEN "return ux_f64(584);",
        "let cap=ux_u32_put(AnimationJsonRows.valueCapacity,8);" FLATTEN
        "return 0.0+(done==0-2 && ux_f64(520)==0.0 && ux_u32(AnimationJsonRows.rowCount)==1);",
    };
    const double gold[]={4,10,-2,1,77,10,33,1};
    return g_wasm_batch_page("G_ANIM AnimationUtils math values","animation-json-math",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,8,mutate?6:-1,
        "let bad=ux_u32_put(128+3*AnimationMathKey.size+AnimationMathKey.values,704);"
        FLATTEN "return ux_f64(584);");
}

