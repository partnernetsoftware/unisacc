#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"curve-line","curve-bezier","path","shape","shapepath",0};
    const char *setup="let sp=ShapePath_init(0,64,2);";
    const char *cases[]={
        "return ShapePath_toShapes(sp,1024,2,1152,2,1280,8,1536,2,0);",
        "let start=ShapePath_moveTo(sp,128,512,2,0.0,0.0);return ShapePath_toShapes(sp,1024,2,1152,2,1280,8,1536,2,0);",
        "let start=ShapePath_moveTo(sp,128,512,2,0.0,0.0);let line=ShapePath_lineTo(sp,3.0,0.0);"
        "let size=ShapePath_toShapes(sp,1024,2,1152,2,1280,8,1536,2,0);return ux_u32(1024+Shape.contour)==128;",
        "let start=ShapePath_moveTo(sp,128,512,2,0.0,0.0);"
        "return ShapePath_toShapes(sp,1024,0,1152,2,1280,8,1536,2,0);"
    };
    const double gold[]={0,1,1,-1};
    return g_math_run("G_STRUCT ShapePath boundary","shapepath-boundary",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "return ShapePath_toShapes(sp,1024,2,1152,2,1280,8,1536,2,0);");
}
