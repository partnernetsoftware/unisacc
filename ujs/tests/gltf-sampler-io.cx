#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","glb-container","json-read","loader-json","gltf-sampler",0};
    const char json[]="{\"samplers\":[{\"magFilter\":9728,\"minFilter\":9984,\"wrapS\":33071,\"wrapT\":33648},{},{\"magFilter\":9984},{\"wrapT\":1}]}";
    const int size=sizeof json-1;
    char setup[1700];
    int n=tx_snprintf(setup,sizeof setup,"let bin=256;let out=512;let key=544;let values=[");
    for(int i=0;i<size;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[i]);
    tx_snprintf(setup+n,sizeof setup-n,"];let i=0;while(i<%d){let a=ux_u8_put(64+i,values[i]);i=i+1;}"
        "let a=ux_u32_put(GlbResource.json,64);let b=ux_u32_put(GlbResource.jsonBytes,%d);"
        "let c=ux_u32_put(GlbResource.bin,bin);let d=ux_u32_put(GlbResource.binBytes,32);",size,size);
    #define READ "let s=GltfLoader_sampler(0,0,out,key);"
    const char *cases[]={
        READ "return 0.0+ux_u32(s+GltfSampler.magFilter);",
        READ "return 0.0+ux_u32(s+GltfSampler.minFilter);",
        READ "return 0.0+ux_u32(s+GltfSampler.wrapS);",
        READ "return 0.0+ux_u32(s+GltfSampler.wrapT);",
        "let s=GltfLoader_sampler(0,1,out,key);return 0.0+ux_u32(s+GltfSampler.minFilter);",
        "let s=GltfLoader_sampler(0,4294967295,out,key);return 0.0+ux_u32(s+GltfSampler.wrapT);",
        "return 0.0+GltfLoader_sampler(0,4,out,key);",
        "return 0.0+GltfLoader_sampler(0,2,out,key);",
        "return 0.0+GltfLoader_sampler(0,3,out,key);",
        "let guard=ux_u32_put(out,88);let s=GltfLoader_sampler(0,3,out,key);return 0.0+ux_u32(out);",
        "return 0.0+GltfLoader_sampler(0,0,bin,key);",
    };
    const double gold[]={9728,9984,33071,33648,9987,10497,-2,-3,-3,88,-1};
    return g_wasm_batch("G_IO glTF sampler","gltf-sampler",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,READ "return 0.0+ux_u32(s+GltfSampler.wrapS);");
}
