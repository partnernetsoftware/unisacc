#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int reflect=argc==2 && tx_eqz(argv[1],"--mutate-reflection");
    const int refract=argc==2 && tx_eqz(argv[1],"--mutate-refraction");
    if(argc!=1 && !reflect && !refract) return 2;
    const char *modules[]={"gpu-cube-map","gpu-cube-map-generated",0};
    const char *setup="let iz=ux_f64_put(80,0.0-1.0);let nx=ux_f64_put(128,0.6);let nz=ux_f64_put(144,0.8);";
    const char *cases[]={
        "return GpuCubeMap_face(301,64,128,0.5,0-1);",
        "return GpuCubeMap_face(302,64,128,0.5,0-1);",
    };
    // Reflection has x=-0.96 after the cube flip. Refraction stays pointed along -z.
    const double gold[]={1,5};
    return g_math_run("G_STRUCT GPU cube map", "gpu-cube-map",modules,setup,cases,gold,2,
        reflect?0:refract?1:-1,reflect?cases[1]:cases[0]);
}
