#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"vector-scalar","vector3","line3",0};
    const char *setup="let a=Vector3_set(0,1.0,1.0,0.0);let b=Vector3_set(24,5.0,4.0,0.0);"
        "let p=Vector3_set(48,9.0,7.0,0.0);let l=Line3_set(72,a,b);";
    const char *cases[]={
        "let r=Line3_set(128,a,b);return ux_f64(r+24);","let r=Line3_copy(128,l);return ux_f64(r+8);",
        "let r=Line3_clone(128,l);return ux_f64(r+32);","let r=Line3_getCenter(128,l);return ux_f64(r+8);",
        "let r=Line3_delta(128,l);return ux_f64(r);","return Line3_distanceSq(l);","return Line3_distance(l);",
        "let r=Line3_at(128,l,0.25);return ux_f64(r+8);","return Line3_closestPointToPointParameter(l,p,0);",
        "return Line3_closestPointToPointParameter(l,p,1);",
        "let r=Line3_closestPointToPoint(128,l,p,1);return ux_f64(r);",
        "let x=ux_f64_put(192,0.0-2.0);let y=ux_f64_put(232,3.0);let z=ux_f64_put(272,4.0);"
        "let w=ux_f64_put(312,1.0);let r=Line3_applyMatrix4(l,192);return ux_f64(r+24);",
        "let r=Line3_clone(128,l);return Line3_equals(l,r);",
        "let r=Line3_set(128,a,a);let t=Line3_closestPointToPointParameter(r,p,1);return t!=t;"
    };
    const double gold[]={5,1,4,2.5,4,25,5,1.75,2,1,5,-10,1,1};
    return g_math_run("G_MATH Line3","line3",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?9:-1,"return Line3_closestPointToPointParameter(l,p,0);");
}
