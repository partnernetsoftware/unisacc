#pragma unisa use object_gate_pack
#pragma unisa use wasm_test_cache
#pragma unisa use r160_wait
#pragma unisa use g_math
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define TEST "ujs/practice/uxe/test/"

static const char *sources[]={
    TEST "mesh-object-json-base-layout.ujs",
    BASE "f64-math.ujs",BASE "views.ujs",BASE "matrix4.ujs",BASE "object-layouts.ujs",
    BASE "object3d.ujs",BASE "object3d-lifecycle.ujs",BASE "mesh-layout.ujs",BASE "datautils.ujs",
    BASE "bufferattribute.ujs",BASE "buffergeometry.ujs",BASE "mesh.ujs",BASE "json-read.ujs",
    BASE "json-bytes.ujs",BASE "loader-json.ujs",BASE "object-json-references.ujs",BASE "record-copy.ujs",
    BASE "camera-object-json.ujs",BASE "mesh-object-json.ujs",
    BASE "line-object-json.ujs",BASE "linesegments-object-json.ujs",BASE "lineloop-object-json.ujs",BASE "points-object-json.ujs",TEST "mesh-object-json-base.ujs",0
};

static const char *sprite_sources[]={
    TEST "mesh-object-json-base-layout.ujs",
    BASE "f64-math.ujs",BASE "views.ujs",BASE "matrix4.ujs",BASE "object-layouts.ujs",
    BASE "object3d.ujs",BASE "object3d-lifecycle.ujs",BASE "gpu-sprite.ujs",BASE "sprite.ujs",BASE "json-read.ujs",
    BASE "json-bytes.ujs",BASE "loader-json.ujs",BASE "object-json-references.ujs",BASE "record-copy.ujs",
    BASE "camera-object-json.ujs",BASE "sprite-object-json.ujs",TEST "sprite-object-json-base.ujs",0
};

static int compile(char **command,int seconds) {
    char *out=0;
    size_t bytes=0;
    const long start=sy_now_ms();
    int rc=cx_runv_timeout(command,seconds,&out,&bytes);
    printf("MESH_OBJECT compile_ms=%ld rc=%d\n",sy_now_ms()-start,rc);
    if(rc && out) printf("%.*s",(int)bytes,out);
    mm_free(out);
    return rc;
}

static int base_ready(const char *base,int prepare,const char *fixture) {
    const char *cache=sy_env("UXE_MESH_OBJECT_CACHE");
    char key[65],sha[65],record[512];
    if(!cache || !cache[0]) {
        printf("MESH_OBJECT 基座缓存缺失，先运行 --prepare\n");
        return 1;
    }
    char cases[180];
    int n=tx_snprintf(cases,sizeof cases,TEST "%s-cases.ujs",fixture);
    if(n<0 || n>=(int)sizeof cases) return 1;
    const char *inputs[32];
    int count=0;
    const char **selected=tx_eqz(fixture,"sprite-object-json")?sprite_sources:sources;
    while(selected[count]) { inputs[count]=selected[count]; count++; }
    inputs[count++]=cases;
    inputs[count]="ujs/tests/object_gate_pack.cx";
    inputs[count+1]=0;
    if(wasm_test_cache_key(inputs,key)) return 1;
    int size=tx_snprintf(record,sizeof record,"%s/%s.bin",cache,key);
    if(size<0 || size>=(int)sizeof record) return 1;
    int rc=wasm_test_cache_read(record,key,prepare?0:base,sha);
    if(!rc) {
        printf("MESH_OBJECT cache=hit key=%s sha=%s\n",key,sha);
        return 0;
    }
    if(rc!=-ENOENT || !prepare) {
        printf("MESH_OBJECT cache_rc=%d，先运行 --prepare\n",rc);
        return 1;
    }
    char input[380],program[100000];
    if(tx_snprintf(input,sizeof input,"%s.ujs",base)>=(int)sizeof input) return 1;
    int used=0;
    for(int i=0;i<count;i++) {
        used=object_gate_pack_lines(program,used,sizeof program,inputs[i]);
        if(used<0) {
            printf("MESH_OBJECT source_pack_failed=%s\n",inputs[i]);
            return 1;
        }
    }
    if(sy_write_file(input,program,used,0600)) return 1;
    char *command[]={"./ujs/ujs2wasm.com",input,"-o",(char *)base,0};
    return compile(command,50) || wasm_test_cache_write(cache,record,key,base);
}

int main(int argc,char **argv) {
    int prepare=0,mutate=0,offset=0;
    for(int i=1;i<argc;i++) {
        if(tx_eqz(argv[i],"--prepare") && !prepare) prepare=1;
        else if(tx_eqz(argv[i],"--mutate") && !mutate) mutate=1;
        else if(tx_eqz(argv[i],"--line") && !offset) offset=7;
        else if(tx_eqz(argv[i],"--linesegments") && !offset) offset=14;
        else if(tx_eqz(argv[i],"--lineloop") && !offset) offset=21;
        else if(tx_eqz(argv[i],"--points") && !offset) offset=28;
        else if(tx_eqz(argv[i],"--sprite") && !offset) offset=35;
        else return 2;
    }
    const char *fixture=offset==35?"sprite-object-json":offset==28?"points-object-json":offset==21?"lineloop-object-json":offset==14?"linesegments-object-json":offset?"line-object-json":"mesh-object-json";
    char dir[256],base[320],probe[320],page[320],url[360];
    if(sy_mkdtemp("/tmp","uxe-mesh-object-",dir,sizeof dir)) return 2;
    tx_snprintf(base,sizeof base,"%s/base.wasm",dir);
    tx_snprintf(probe,sizeof probe,"%s/probe.wasm",dir);
    tx_snprintf(page,sizeof page,"%s/probe.html",dir);
    tx_snprintf(url,sizeof url,"file://%s%s",page,mutate?"?mutate":"");
    int failed=base_ready(base,prepare,fixture);
    if(!failed && !prepare) {
        char *command[]={"./ujs/ujs2wasm.com",TEST "mesh-object-json-probe.ujs","-o",probe,0};
        const double gold[]={2,0,offset==35?1:7000,19,-2,1};
        double actual[6],reference[6];
        failed=compile(command,6) || sy_copy(TEST "mesh-object-json-wasm.html",page,0600) ||
            r160_wait_ref(fixture,reference,6,dir) ||
            r160_wait_read(url,"#wasm-cases",actual,6,dir);
        for(int i=0;!failed && i<6;i++) {
            if(!g_math_near(actual[i],gold[i],1e-9) || !g_math_near(reference[i],gold[i],1e-9)) {
                printf("MESH_OBJECT case=%d actual=%.17g r160=%.17g gold=%.17g\n",i,actual[i],reference[i],gold[i]);
                failed=1;
            }
        }
    }
    if(sy_remove_all(dir)) failed=1;
    printf("G_STRUCT %s prepare=%d cases=%d failed=%d\n",fixture,prepare,prepare?0:6,failed);
    return failed;
}
