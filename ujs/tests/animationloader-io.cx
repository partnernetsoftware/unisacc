#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","json-read","loader-json","loadingmanager","fileloader","animation-view",
        "keyframe-track","animationclip","animationloader",0};
    #define ANIMATION_PREFIX "[{\"name\":\"wiggle\",\"tracks\":[{\"name\":\".position[x]\",\"type\":\"number\",\"times\":["
    const char json[]=ANIMATION_PREFIX "0,2],\"values\":[0,8]}]}]";
    char setup[1500];int size=sizeof json-1;
    int n=tx_snprintf(setup,sizeof setup,"let size=%d;let wrongTime=%d;let json=[",size,256+(int)sizeof ANIMATION_PREFIX-1);
    for(int i=0;i<size;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[i]);
    tx_snprintf(setup+n,sizeof setup-n,"];let i=0;while(i<size){let b=ux_u8_put(256+i,json[i]);i=i+1;}"
        "let manager=LoadingManager_init(0);let file=FileLoader_init(32,manager);let id=FileLoader_begin(file,64);"
        "let ready=FileLoader_receive(file,id,200,256,size,64);");
    const char *cases[]={
        "return AnimationLoader_number(file,512,1024,768)>0;",
        "let clip=AnimationLoader_number(file,512,1024,768);return ux_f64(clip+AnimationClip.duration);",
        "let clip=AnimationLoader_number(file,512,1024,768);return ux_u32(clip+AnimationClip.trackCount);",
        "let clip=AnimationLoader_number(file,512,1024,768);let track=ux_u32(ux_u32(clip+AnimationClip.tracks));"
        "let view=ux_u32(track+KeyframeTrack.samples);return ux_f32(ux_u32(view+AnimationSamples.values)+4);",
        "let clip=AnimationLoader_number(file,512,1024,768);return ux_u8(ux_u32(clip+AnimationClip.name));",
        "let wrong=ux_u8_put(wrongTime,51);return AnimationLoader_number(file,512,1024,768);",
        "let bad=ux_u8_put(256+size-1,125);return AnimationLoader_number(file,512,1024,768);"
    };
    const double gold[]={1,2,1,8,119,-3,-2};
    return g_math_run("G_IO AnimationLoader","animationloader",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let clip=AnimationLoader_number(file,512,1024,768);let track=ux_u32(ux_u32(clip+AnimationClip.tracks));"
        "let view=ux_u32(track+KeyframeTrack.samples);return ux_f32(ux_u32(view+AnimationSamples.values));");
}
