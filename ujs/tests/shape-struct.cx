#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"curve-line","curve-bezier","path","shape",0};
    const char *setup="let outer=Path_init(0,512,3);let a=Path_lineTo(outer,0.0,4.0);"
      "let b=Path_lineTo(outer,4.0,0.0);let c=Path_closePath(outer);"
      "let hole=Path_init(128,1024,3);let start=Path_moveTo(hole,1.0,1.0);"
      "let d=Path_lineTo(hole,2.0,1.0);let e=Path_lineTo(hole,1.0,2.0);let f=Path_closePath(hole);"
      "let shape=Shape_init(256,outer,320,1);let hole_add=Shape_addHole(shape,hole);"
      "let out=ux_u32_put(2048+ShapeHolePoints.points,3072);let cap=ux_u32_put(2048+ShapeHolePoints.capacity,4);"
      "let count=Shape_extractPoints(shape,2816,4,2048,3,4096);";
    const char *cases[]={"return count;","return ux_u32(shape+Shape.count);",
      "return ux_u32(2048+ShapeHolePoints.count);","return ux_f64(2840);",
      "return ux_f64(3088);","return ux_f64(3112);"};
    const double gold[]={4,1,4,4,2,2};
    return g_math_run("G_STRUCT Shape","shape",modules,setup,cases,gold,6,mutate?4:-1,"return ux_f64(3072);");
}
