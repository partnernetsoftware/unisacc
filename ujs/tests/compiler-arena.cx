#pragma unisa use text.text

uint32_t alloc(uint32_t n);
uint32_t err_ptr(void);
uint32_t err_len(void);
const uint8_t *ujs_host_mem(void);
uint32_t ujs_host_mem_size(void);
void ujs_host_write(uint32_t offset,const void *p,uint32_t n);

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const uint32_t limit=8388608;
    const uint8_t expected=73;
    uint32_t first=alloc(32);
    if(!first) return 1;
    ujs_host_write(first,&expected,1);
    uint32_t full=alloc(limit-first-32);
    int accepted=full==96 && ujs_host_mem_size()==limit;
    uint32_t rejected=alloc(1);
    const uint8_t *arena=ujs_host_mem();
    int preserved=arena[first]==(mutate?74:73);
    const char gold[]="emit buffer used=8388608 need=1 limit=8388608";
    int bounded=rejected==0 && err_len()==sizeof gold-1 &&
        tx_same((const char *)(arena+err_ptr()),err_len(),gold,sizeof gold-1);
    int failed=3-accepted-preserved-bounded;
    printf("CHECK_UJS_COMPILER_ARENA accepted=%d preserved=%d refused_plus_one=%d failed=%d\n",
        accepted,preserved,bounded,failed);
    return failed!=0;
}
