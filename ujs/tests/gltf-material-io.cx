#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","glb-container","json-read","loader-json","gltf-material",0};
    #define MATERIAL_PREFIX "{\"materials\":[{\"pbrMetallicRoughness\":{\"baseColorFactor\":["
    const char json[]="{\"materials\":[{\"pbrMetallicRoughness\":{\"baseColorFactor\":[0.2,0.4,0.6,0.8],\"metallicFactor\":0.25,\"roughnessFactor\":0.75},\"alphaMode\":\"MASK\",\"alphaCutoff\":0.3,\"doubleSided\":true},{}]}";
    char setup[1600];
    int bytes=sizeof json-1;
    int n=tx_snprintf(setup,sizeof setup,"let json=[");
    for(int i=0;i<bytes;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[i]);
    tx_snprintf(setup+n,sizeof setup-n,
        "];let i=0;while(i<%d){let cell=ux_u8_put(128+i,json[i]);i=i+1;}"
        "let a=ux_u32_put(GlbResource.json,128);let b=ux_u32_put(GlbResource.jsonBytes,%d);let colorAt=%d;",
        bytes,bytes,128+(int)sizeof MATERIAL_PREFIX-1);
    const char *cases[]={
        "let a=GltfLoader_material(0,0,512,640);return ux_f64(a+GltfMaterial.green);",
        "let a=GltfLoader_material(0,0,512,640);return ux_f64(a+GltfMaterial.alpha);",
        "let a=GltfLoader_material(0,0,512,640);return ux_f64(a+GltfMaterial.metalness);",
        "let a=GltfLoader_material(0,0,512,640);return ux_f64(a+GltfMaterial.roughness);",
        "let a=GltfLoader_material(0,0,512,640);return ux_f64(a+GltfMaterial.cutoff);",
        "let a=GltfLoader_material(0,0,512,640);return ux_u32(a+GltfMaterial.alphaMode);",
        "let a=GltfLoader_material(0,0,512,640);return ux_u32(a+GltfMaterial.doubleSided);",
        "let a=GltfLoader_material(0,1,512,640);return ux_f64(a+GltfMaterial.metalness);",
        "let bad=ux_u8_put(colorAt,50);return GltfLoader_material(0,0,512,640);",
        "let watch=ux_f64_put(512+GltfMaterial.green,0.5);let bad=ux_u8_put(colorAt,50);"
        "let rejected=GltfLoader_material(0,0,512,640);return ux_f64(512+GltfMaterial.green);"
    };
    const double gold[]={0.4,0.8,0.25,0.75,0.3,1,1,1,-3,0.5};
    return g_math_run("G_IO GltfMaterial","gltf-material",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let a=GltfLoader_material(0,0,512,640);return ux_f64(a+GltfMaterial.roughness);");
}
