#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","animation-view","keyframe-track","json-read",
        "record-copy","loaderutils","json-string-decode","json-bytes","animation-json-flatten",
        "loadingmanager","fileloader","loader-json","animationclip","animationloader",
        "keyframe-track-json-tokens","keyframe-track-json-read","keyframe-track-json-write",
        "animationclip-json","animationclip-json-write",0};
    // Canonical object with one scalar and one Boolean track.
    const char *setup=
        "let byte0=ux_u32_put(256,1634607739);"
        "let byte4=ux_u32_put(260,975332717);"
        "let byte8=ux_u32_put(264,2020175138);"
        "let byte12=ux_u32_put(268,1679961122);"
        "let byte16=ux_u32_put(272,1952543349);"
        "let byte20=ux_u32_put(276,577662825);"
        "let byte24=ux_u32_put(280,573321786);"
        "let byte28=ux_u32_put(284,1667330676);"
        "let byte32=ux_u32_put(288,975336299);"
        "let byte36=ux_u32_put(292,1847753563);"
        "let byte40=ux_u32_put(296,577072481);"
        "let byte44=ux_u32_put(300,2016289338);"
        "let byte48=ux_u32_put(304,1948396578);"
        "let byte52=ux_u32_put(308,1936026985);"
        "let byte56=ux_u32_put(312,811285026);"
        "let byte60=ux_u32_put(316,744305196);"
        "let byte64=ux_u32_put(320,1818326562);"
        "let byte68=ux_u32_put(324,577987957);"
        "let byte72=ux_u32_put(328,741563194);"
        "let byte76=ux_u32_put(332,573332793);"
        "let byte80=ux_u32_put(336,1701869940);"
        "let byte84=ux_u32_put(340,1847736866);"
        "let byte88=ux_u32_put(344,1700949365);"
        "let byte92=ux_u32_put(348,746398322);"
        "let byte96=ux_u32_put(352,1634607739);"
        "let byte100=ux_u32_put(356,975332717);"
        "let byte104=ux_u32_put(360,1852780066);"
        "let byte108=ux_u32_put(364,1948396578);"
        "let byte112=ux_u32_put(368,1936026985);"
        "let byte116=ux_u32_put(372,811285026);"
        "let byte120=ux_u32_put(376,744304940);"
        "let byte124=ux_u32_put(380,1818326562);"
        "let byte128=ux_u32_put(384,577987957);"
        "let byte132=ux_u32_put(388,1920228154);"
        "let byte136=ux_u32_put(392,1714185589);"
        "let byte140=ux_u32_put(396,1702063201);"
        "let byte144=ux_u32_put(400,1948396637);"
        "let byte148=ux_u32_put(404,577073273);"
        "let byte152=ux_u32_put(408,1868702266);"
        "let byte156=ux_u32_put(412,2099407983);"
        "let byte160=ux_u32_put(416,1965173853);"
        "let byte164=ux_u32_put(420,577005941);"
        "let byte168=ux_u32_put(424,825238074);"
        "let byte172=ux_u32_put(428,892613425);"
        "let byte176=ux_u32_put(432,942487350);"
        "let byte180=ux_u32_put(436,761422137);"
        "let byte184=ux_u32_put(440,1701077812);"
        "let byte188=ux_u32_put(444,812005421);"
        "let byte192=ux_u32_put(448,858926385);"
        "let byte196=ux_u32_put(452,926299444);"
        "let byte200=ux_u32_put(456,1650538808);"
        "let byte204=ux_u32_put(460,740451427);"
        "let byte208=ux_u32_put(464,1701601826);"
        "let byte212=ux_u32_put(468,1867342958);"
        "let byte216=ux_u32_put(472,975332708);"
        "let byte220=ux_u32_put(476,825242930);"
        "let byte224=ux_u32_put(480,125);"
        "let clip=AnimationClip_fromJSON(32,80,256,481,4096);";
    const char *cases[]={
        "return 0.0+clip;",
        "return 0.0+ux_u32(32+AnimationClip.trackCount);",
        "return ux_f64(32+AnimationClip.duration);",
        "return 0.0+ux_u32(32+AnimationClip.blendMode);",
        "let last=AnimationClip_toJSON(32,80,1024,2048,80000);if(last!=1249){return 0.0-3.0;}let i=0;while(i<225){if(ux_u8(256+i)!=ux_u8(1024+i)){return 0.0-4.0;}i=i+1;}return 0.0+AnimationClip_fromJSON(128,176,1024,last,42000);",
    };
    const double gold[]={32,2,2,2501,128};
    return g_wasm_batch("G_ANIM clip mixed track JSON","animationclip-json",modules,setup,cases,gold,5,
        mutate?4:-1,"let changed=ux_u32_put(32+AnimationClip.blendMode,2500);"
        "let last=AnimationClip_toJSON(32,80,1024,2048,80000);if(last!=1249){return 0.0-3.0;}let i=0;while(i<225){if(ux_u8(256+i)!=ux_u8(1024+i)){return 0.0-4.0;}i=i+1;}return 0.0+AnimationClip_fromJSON(128,176,1024,last,42000);");
}
