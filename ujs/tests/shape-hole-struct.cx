#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"shapeutils","shape-hole",0};
    char setup[1600];
    tx_snprintf(setup,sizeof setup,"let ax=ux_f64_put(144,4.0);let bx=ux_f64_put(160,4.0);"
        "let by=ux_f64_put(168,4.0);let cy=ux_f64_put(184,4.0);"
        "let h0=ux_f64_put(192,1.0);let h1=ux_f64_put(200,1.0);"
        "let h2=ux_f64_put(208,1.0);let h3=ux_f64_put(216,3.0);"
        "let h4=ux_f64_put(224,%s);let h5=ux_f64_put(232,3.0);"
        "let h6=ux_f64_put(240,%s);let h7=ux_f64_put(248,1.0);"
        "let count=ShapeUtils_triangulateHole(128,4,192,4,3072,24,4096);"
        "let i=0;let area=0.0;let bad=0;let inside=0;"
        "while(i<count){let a=128+16*ux_u32(3072+4*i);let b=128+16*ux_u32(3076+4*i);"
        "let c=128+16*ux_u32(3080+4*i);let turn=shape_turn(a,b,c);"
        "if(turn<=0.0){bad=bad+1;}area=area+turn*0.5;"
        "let x=(ux_f64(a)+ux_f64(b)+ux_f64(c))/3.0;"
        "let y=(ux_f64(a+8)+ux_f64(b+8)+ux_f64(c+8))/3.0;"
        "if(x>1.0&&x<3.0&&y>1.0&&y<3.0){inside=inside+1;}i=i+3;}",
        mutate?"2.5":"3.0",mutate?"2.5":"3.0");
    const char *cases[]={"return count/3;","return area;","return bad;","return inside;"};
    const double gold[]={8,12,0,0};
    return g_math_run("G_STRUCT ShapeUtils hole","shape-hole",modules,setup,cases,gold,4,-1,0);
}
