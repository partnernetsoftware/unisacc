#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","animation-view","discreteinterpolant","keyframe-track","stringkeyframetrack",0};
    const char *setup=
        "let t0=ux_f32_put(64,0.0);let t1=ux_f32_put(68,2.0);let t2=ux_f32_put(72,4.0);"
        "let a=ux_u32_put(128,240);let b=ux_u32_put(132,1);let c=ux_u32_put(136,244);let d=ux_u32_put(140,3);"
        "let x=ux_u8_put(240,65);let y=ux_u8_put(244,230);let z=ux_u8_put(245,161);let w=ux_u8_put(246,165);"
        "let name=ux_u8_put(100,120);let samples=AnimationSamples_init(0,64,128,3,2);"
        "let track=StringKeyframeTrack_init(32,100,1,samples);";
    const char *cases[]={
        "let t=StringTrack_setInterpolation(track,2302);return KeyframeTrack_getInterpolation(t);",
        "let p=StringKeyframeTrack_evaluate(track,1.99,192);return ux_u8(ux_u32(p));",
        "let p=StringKeyframeTrack_evaluate(track,2.0,192);return ux_u8(ux_u32(p));",
        "let p=StringKeyframeTrack_evaluate(track,2.0,192);return ux_u32(p+4);",
        "let p=StringKeyframeTrack_evaluate(track,4.0,192);return ux_u32(p+4);",
        "let x=ux_u32_put(136,6291455);return StringKeyframeTrack_evaluate(track,2.0,192);"
    };
    const double gold[]={2300,65,230,3,0,-2};
    return g_math_run("G_ANIM StringKeyframeTrack","stringkeyframetrack",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let p=StringKeyframeTrack_evaluate(track,1.99,192);return ux_u8(ux_u32(p));");
}
