#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"curve-line","curve-bezier","path",0};
    const char *setup="let path=Path_init(0,256,4);let start=Path_moveTo(path,0.0,0.0);"
        "let line=Path_lineTo(path,2.0,0.0);let quad=Path_quadraticCurveTo(path,3.0,2.0,4.0,0.0);"
        "let bez=Path_bezierCurveTo(path,4.0,2.0,6.0,2.0,6.0,0.0);let close=Path_closePath(path);"
        "let count=Path_getPoints(path,1024,7,2,2048);";
    const char *cases[]={"return count;","return ux_f64(1040);","return ux_f64(1056);",
        "return ux_f64(1064);","return ux_f64(1088);","return ux_f64(1096);","return ux_f64(1120);"};
    const double gold[]={7,2,3,1,5,1.5,0};
    return g_math_run("G_STRUCT Path","path",modules,setup,cases,gold,7,mutate?2:-1,"return ux_f64(1088);");
}
