#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    int mutate_ac=argc==2 && tx_eqz(argv[1],"--mutate-ac");
    if(argc!=1 && !mutate && !mutate_ac) return 2;
    const char *modules[]={"f64-math","jpeg-entropy","jpeg-idct","jpeg-progressive",0};
    const char *setup=
        "let reader=0;let coeff=256;let dc=32;let ac=64;let at=128;"
        "let a=ux_u32_put(reader+JpegBits.next,at);let b=ux_u32_put(reader+JpegBits.end,at+8);"
        "let c=ux_u8_put(dc,1);let d=ux_u8_put(dc+16,6);"
        "let e=ux_u8_put(ac,1);let f=ux_u8_put(ac+1,1);let g=ux_u8_put(ac+16,18);let h=ux_u8_put(ac+17,0);";
    const char *cases[]={
        "let bits=ux_u8_put(at,65);let n=jpeg_progressive_dc_first(reader,dc,0,1,coeff);return 0.0+ux_i32(coeff);",
        "let bits=ux_u8_put(at,65);let n=jpeg_progressive_dc_first(reader,dc,0,1,coeff);return 0.0+n-65536.0;",
        "let original=ux_i32_put(coeff,64);let bits=ux_u8_put(at,128);let n=jpeg_progressive_dc_refine(reader,0,coeff);"
        "return 128.0+ux_i32(coeff);",
        "let original=ux_i32_put(coeff,-64);let bits=ux_u8_put(at,128);let n=jpeg_progressive_dc_refine(reader,0,coeff);"
        "return 0.0+ux_i32(coeff);",
        "let original=ux_i32_put(coeff,63);return 0.0+jpeg_progressive_dc_refine(reader,0,coeff);",
        "let bits=ux_u8_put(at,87);let n=jpeg_progressive_ac_first(reader,ac,1,4,1,coeff);return 0.0+ux_i32(coeff+32);",
        "let bits=ux_u8_put(at,87);return 0.0+jpeg_progressive_ac_first(reader,ac,1,1,1,coeff);",
        "let eob=ux_u8_put(ac+16,32);let bits=ux_u8_put(at,95);return 0.0+jpeg_progressive_ac_first(reader,ac,1,4,0,coeff);",
        "let bits=ux_u8_put(at,87);return 0.0+jpeg_progressive_ac_first(reader,ac,0,4,0,coeff);",
        "let initial=ux_i32_put(coeff+4,2);let bits=ux_u8_put(at,191);let refined=jpeg_progressive_ac_refine(reader,ac,1,63,0,coeff,0);"
        "let dequant=ux_i32_put(coeff+4,ux_i32(coeff+4)*64);let basis=jpeg_idct_basis(512);"
        "let pixel=jpeg_idct_block(coeff,basis,1024,1536);return 0.0+ux_u8(pixel);",
        "let initial=ux_i32_put(coeff+4,-2);let symbol=ux_u8_put(ac+16,17);let bits=ux_u8_put(at,96);"
        "let n=jpeg_progressive_ac_refine(reader,ac,1,3,0,coeff,0);return 0.0+ux_i32(coeff+64);",
        "let initial=ux_i32_put(coeff+4,-2);let symbol=ux_u8_put(ac+16,17);let bits=ux_u8_put(at,96);"
        "let n=jpeg_progressive_ac_refine(reader,ac,1,3,0,coeff,0);return 0.0+ux_i32(coeff+4);",
        "let initial=ux_i32_put(coeff+4,2);let bits=ux_u8_put(at,128);return 0.0+jpeg_progressive_ac_refine(reader,ac,1,63,0,coeff,3);",
        "let bits=ux_u8_put(at,0);return 0.0+jpeg_progressive_ac_refine(reader,ac,1,12,0,coeff,0);",
        "let zrl=ux_u8_put(ac+16,240);let bits=ux_u8_put(at,0);return 0.0+jpeg_progressive_ac_refine(reader,ac,1,16,0,coeff,0);",
        "let zrl=ux_u8_put(ac+16,240);let bits=ux_u8_put(at,0);return 0.0+jpeg_progressive_ac_refine(reader,ac,1,15,0,coeff,0);"
    };
    const double gold[]={64,32,193,-63,-6,4,-6,5,-4,161,1,-3,2,-6,0,-6};
    return g_wasm_batch("G_IO JpegProgressiveBands","jpeg-progressive-band",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate_ac?9:mutate?2:-1,
        mutate_ac?"let initial=ux_i32_put(coeff+4,2);let bits=ux_u8_put(at,159);let refined=jpeg_progressive_ac_refine(reader,ac,1,63,0,coeff,0);"
        "let dequant=ux_i32_put(coeff+4,ux_i32(coeff+4)*64);let basis=jpeg_idct_basis(512);"
        "let pixel=jpeg_idct_block(coeff,basis,1024,1536);return 0.0+ux_u8(pixel);":
        "let original=ux_i32_put(coeff,64);let bits=ux_u8_put(at,0);let n=jpeg_progressive_dc_refine(reader,0,coeff);"
        "return 128.0+ux_i32(coeff);");
}
