#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","loaderutils","json-read","json-string-decode",0};
    const char json[]="\"A\\n\\u82a6\\ud83d\\ude00\\ud800\"";
    char setup[700];
    int n=tx_snprintf(setup,sizeof setup,"let data=[");
    for(int i=0;i<(int)sizeof json-1;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[i]);
    tx_snprintf(setup+n,sizeof setup-n,
        "];let size=%d;let i=0;while(i<size){let byte=ux_u8_put(64+i,data[i]);i=i+1;}"
        "let length=Json_decodeString(64,64+size,256,24);",(int)sizeof json-1);
    const char *cases[]={
        "return length;","return ux_u8(257);","return ux_u8(258);","return ux_u8(261);","return ux_u8(265);",
        "let keep=ux_u8_put(256,77);let small=Json_decodeString(64,64+size,256,11);return ux_u8(256);",
        "let raw=ux_u8_put(65,255);return Json_decodeString(64,64+size,256,24);",
        "return Json_decodeString(64,64+size,65,24);",
        "return Json_stringBytes(64,64+size);"
    };
    const double gold[]={12,10,232,240,239,77,-2,-1,12};
    return g_math_run("G_IO Json UTF8 string","json-string-decode",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,"return ux_u8(265);");
}
