#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int list=argc==3 && tx_eqz(argv[2],"--mutate-list");
    const int strip=argc==3 && tx_eqz(argv[2],"--mutate-strip");
    const int fan=argc==3 && tx_eqz(argv[2],"--mutate-fan");
    if(argc!=2 && !list && !strip && !fan) return 2;
    const char *modules[]={"gltf-triangle-topology","gpu-draw-mode-generated",0};
    const char *setup="let data=[3,1,2,0,2,1];let i=0;"
        "while(i<6){let byte=ux_u8_put(64+i,data[i]);i=i+1;}";
    #define LIST "let n=GpuDraw_triangleList(0,4,64,1,6,256,6);"
    #define STRIP "let n=GpuDraw_triangleList(1,4,64,1,4,256,6);"
    #define FAN "let n=GpuDraw_triangleList(2,4,64,1,4,256,6);"
    const char *cases[]={
        LIST "return 0.0+n;",
        LIST "return 0.0+ux_u32(268)*100+ux_u32(272)*10+ux_u32(276);",
        STRIP "return 0.0+ux_u32(268)*100+ux_u32(272)*10+ux_u32(276);",
        FAN "return 0.0+ux_u32(268)*100+ux_u32(272)*10+ux_u32(276);",
        "return 0.0+GpuDraw_triangleList(3,4,64,1,4,256,6);"
    };
    const double gold[]={6,21,21,320,-1};
    // The list mutation switches to strip on the full six-index input,
    // the two other mutations swap strip and fan on the same four indices.
    return g_wasm_batch_addon("G_STRUCT GPU triangle modes","gpu-draw-mode",argv[1],modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],list?0:strip?2:fan?3:-1,list?
        "return 0.0+GpuDraw_triangleList(1,4,64,1,6,256,12);":strip?cases[3]:cases[2]);
}
