#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d","bone",0};
    const char *setup=
        "let arena=Object3D_initArena(0,4);let root=Bone_create(arena);"
        "let joint=Bone_create(arena);let tip=Bone_create(arena);let plain=Object3D_create(arena);"
        "let r=Object3D_address(arena,root);let j=Object3D_address(arena,joint);let t=Object3D_address(arena,tip);"
        "let rx=ux_f64_put(ux_u32(r+Object3D.position),3.0);"
        "let jy=ux_f64_put(ux_u32(j+Object3D.position)+8,2.0);"
        "let q=ux_u32(j+Object3D.quaternion);"
        "let qz=ux_f64_put(q+16,0.7071067811865475);let qw=ux_f64_put(q+24,0.7071067811865476);"
        "let tx=ux_f64_put(ux_u32(t+Object3D.position),2.0);"
        "let a=Object3D_add(arena,root,joint);let b=Object3D_add(arena,joint,tip);"
        "let update=Object3D_updateMatrixWorld(arena,root,0);let world=ux_u32(t+Object3D.worldMatrix);";
    const char *cases[]={
        "return Bone_isBone(arena,root);","return Bone_isBone(arena,plain);",
        "return ux_u32(t+Object3D.parent)==joint;","return ux_f64(world+96);","return ux_f64(world+104);"
    };
    const double gold[]={1,0,1,3,4};
    return g_math_run("G_STRUCT Bone","bone",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?4:-1,"return ux_f64(ux_u32(j+Object3D.worldMatrix)+104);");
}
