#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

#define RGBA(r,g,b,a) ((r)+256.0*(g)+65536.0*(b)+16777216.0*(a))
#define BLEND RGBA(40,80,120,64),RGBA(57,86,123,68),RGBA(98,106,132,100),RGBA(122,120,138,128), \
    RGBA(220,225,230,245),RGBA(237,231,233,249),RGBA(255,251,242,255),RGBA(255,255,248,255)
#define BLUE 4294901760
#define SPARE BLUE,BLUE,BLUE,BLUE,BLUE,BLUE,BLUE,BLUE

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if((argc!=2 && !mutate) || argv[1][0]!='/') return 2;
    char dir[256],cwd[390],abi[300],wasm[300],url[720];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-bloom-additive-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/additive.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/ujs/practice/uxe/test/unrealbloom-additive-r160.html?package=%s&wasm=%s&mode=%d",
        cwd,argv[1],wasm,mutate);
    const char entry[]="import host_gpu_submit from \"uxe_gpu_v1\"(i64,i64) i64;\n"
        "export uxe_bloom_add(mutate:i64,vn:i64,fn:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,"ujs/practice/uxe/base/record-copy.ujs",
        "ujs/practice/uxe/base/gpu-packet.ujs","ujs/practice/uxe/base/gpu-state.ujs",
        "ujs/practice/uxe/base/gpu-target.ujs","ujs/practice/uxe/base/effectcomposer.ujs",
        "ujs/practice/uxe/base/effectcomposer-gpu-targets.ujs","ujs/practice/uxe/base/unrealbloom-additive.ujs",
        "ujs/practice/uxe/test/unrealbloom-additive-probe.ujs","-o",wasm,0};
    const double gold[]={BLEND,SPARE,BLEND,SPARE};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    char *output=0;
    size_t bytes=0;
    int failed=length<0 || length>=(int)sizeof url || sy_write_file(abi,entry,sizeof entry-1,0600);
    if(!failed) {
        const int rc=cx_runv_timeout(compile,6,&output,&bytes);
        if(rc) { printf("G_PIXEL Bloom additive compiler_rc=%d %s\n",rc,output?output:""); failed++; }
        mm_free(output); output=0;
    }
    if(!failed) failed=r160_wait_read(url,"#r160",actual,count,dir);
    if(!failed) for(int i=0;i<count;i++) if(actual[i]!=gold[i]) {
        printf("G_PIXEL Bloom additive case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
        failed++;
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&output,&bytes)) failed++;
    mm_free(output);
    printf("G_PIXEL Bloom additive cases=%d failed=%d\n",count,failed);
    return failed!=0;
}
