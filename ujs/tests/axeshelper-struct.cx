#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"axeshelper",0};
    const char *setup="let helper=0;let positions=128;let colors=256;let source=384;"
        "let ready=AxesHelper_init(helper,positions,colors,2.0);"
        "let x=ux_f32_put(source,0.25);let y=ux_f32_put(source+16,0.5);let z=ux_f32_put(source+32,0.75);";
    const char *cases[]={
        "return 0.0+ux_u32(helper+AxesHelper.count);",
        "return ux_f32(positions+12);",
        "return ux_f32(positions+40);",
        "return ux_f32(positions+68);",
        "return ux_f32(colors+16);",
        "let changed=AxesHelper_setColors(helper,source);return ux_f32(colors+12);",
        "let changed=AxesHelper_setColors(helper,source);return ux_f32(colors+64);",
        "let changed=AxesHelper_setColors(helper,source);return 0.0+ux_u32(helper+AxesHelper.colorVersion);",
        "let gone=AxesHelper_dispose(helper);return 0.0+ux_u32(helper+AxesHelper.active);",
        "let gone=AxesHelper_dispose(helper);return 0.0+AxesHelper_setColors(helper,source);",
        "return 0.0+AxesHelper_init(helper,positions,positions,2.0);",
    };
    const double gold[]={6,2,2,2,(double)(float)0.6,0.25,0,1,0,-1,-1};
    return g_wasm_batch("G_STRUCT AxesHelper","axeshelper",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?5:-1,"let changed=AxesHelper_setColors(helper,source);return ux_f32(colors+16);");
}
