#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","glb-container","json-read","loader-json","gltf-accessor",0};
    const char json[]="{\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":2,\"type\":\"VEC3\"}],\"bufferViews\":[{\"buffer\":0,\"byteLength\":32,\"byteStride\":16}]}";
    char setup[1600];
    int bytes=sizeof json-1;
    int n=tx_snprintf(setup,sizeof setup,"let json=[");
    for(int i=0;i<bytes;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[i]);
    tx_snprintf(setup+n,sizeof setup-n,
        "];let i=0;while(i<%d){let cell=ux_u8_put(128+i,json[i]);i=i+1;}"
        "let a=ux_u32_put(GlbResource.json,128);let b=ux_u32_put(GlbResource.jsonBytes,%d);"
        "let c=ux_u32_put(GlbResource.bin,512);let d=ux_u32_put(GlbResource.binBytes,32);"
        "let x=ux_f32_put(512,1.25);let y=ux_f32_put(528,4.5);let z=ux_f32_put(536,-2.0);",bytes,bytes);
    const char *cases[]={
        "let a=GltfLoader_accessor(0,0,640,680);return ux_u32(a+GltfAccessor.count);",
        "let a=GltfLoader_accessor(0,0,640,680);return ux_u32(a+GltfAccessor.stride);",
        "let a=GltfLoader_accessor(0,0,640,680);let p=ux_u32(a+GltfAccessor.bytes);return ux_f32(p+16);",
        "let a=GltfLoader_accessor(0,0,640,680);let p=ux_u32(a+GltfAccessor.bytes);return ux_f32(p+24);",
        "return GltfLoader_accessor(0,1,640,680);",
        "let bad=ux_u32_put(GlbResource.binBytes,24);return GltfLoader_accessor(0,0,640,680);",
        "return GltfLoader_accessor(0,0,640,644);",
        "let keep=ux_u32_put(640,777);let bad=ux_u32_put(GlbResource.binBytes,24);"
        "let result=GltfLoader_accessor(0,0,640,680);return ux_u32(640);"
    };
    const double gold[]={2,16,4.5,-2,-2,-3,-1,777};
    return g_math_run("G_IO GltfAccessor","gltf-accessor",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let a=GltfLoader_accessor(0,0,640,680);let p=ux_u32(a+GltfAccessor.bytes);return ux_f32(p);");
}
