#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","camera","perspectivecamera","stereocamera","stereo-eye-record",0};
    const char *setup="let c=StereoCamera_init(0,1024,1152,1280,1408);"
        "let projection=Matrix4_makePerspective(256,0.0-2.0,2.0,1.0,0.0-1.0,1.0,11.0,2000.0);"
        "let world=Matrix4_makeTranslation(512,3.0,4.0,5.0);"
        "let stereo=StereoCamera_update(c,projection,world,90.0,1.0,2.0,10.0);";
    const char *cases[]={
        "let eye=StereoCamera_readEye(c,0,2048,704);return ux_u32(eye+StereoEyeRecord.layerMask);",
        "let eye=StereoCamera_readEye(c,1,2048,704);return ux_u32(eye+StereoEyeRecord.layerMask);",
        "let eye=StereoCamera_readEye(c,0,2048,704);return ux_f64(ux_u32(eye+StereoEyeRecord.lens)+PerspectiveCamera.fov);",
        "let eye=StereoCamera_readEye(c,0,2048,704);return ux_f64(ux_u32(eye+StereoEyeRecord.world)+96);",
        "let eye=StereoCamera_readEye(c,1,2048,704);let cam=ux_u32(eye+StereoEyeRecord.camera);"
        "return ux_f64(ux_u32(cam+Camera.matrixWorldInverse)+96);",
        "let eye=StereoCamera_readEye(c,0,2048,704);let cam=ux_u32(eye+StereoEyeRecord.camera);"
        "return ux_f64(ux_u32(cam+Camera.projectionMatrix)+64);",
        "return StereoCamera_readEye(c,0,2048,703);",
        "return StereoCamera_readEye(c,0,1024,704);"
    };
    const double gold[]={3,5,50,2.968,-3.032,.0016,-1,-1};
    return g_math_run("G_STRUCT StereoEyeRecord","stereo-eye-record",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let eye=StereoCamera_readEye(c,1,2048,704);return ux_f64(ux_u32(eye+StereoEyeRecord.world)+96);");
}
