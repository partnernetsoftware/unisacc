#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","loadingmanager","fileloader","glb-container","json-read","loader-json",
        "gltf-accessor","animation-view","gltf-animation","gltf-cubic-interpolant",0};
    const char json[]="{\"animations\":[{\"channels\":[{\"sampler\":0,\"target\":{\"node\":1,\"path\":\"translation\"}}],\"samplers\":[{\"input\":0,\"output\":1,\"interpolation\":\"CUBICSPLINE\"}]}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":2,\"type\":\"SCALAR\"},{\"bufferView\":1,\"componentType\":5126,\"count\":6,\"type\":\"VEC3\"}],\"bufferViews\":[{\"buffer\":0,\"byteLength\":8},{\"buffer\":0,\"byteOffset\":8,\"byteLength\":72}]}";
    const int bytes=sizeof json-1;
    char setup[3200];
    int n=0;
    for(int start=0;start<bytes;start+=100) {
        int count=bytes-start<100?bytes-start:100;
        n+=tx_snprintf(setup+n,sizeof setup-n,"if(1){let chunk=[");
        for(int i=0;i<count;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[start+i]);
        n+=tx_snprintf(setup+n,sizeof setup-n,
            "];let i=0;while(i<%d){let cell=ux_u8_put(%d+i,chunk[i]);i=i+1;}}",count,128+start);
    }
    tx_snprintf(setup+n,sizeof setup-n,
        "let a=ux_u32_put(GlbResource.json,128);let b=ux_u32_put(GlbResource.jsonBytes,%d);"
        "let c=ux_u32_put(GlbResource.bin,512);let d=ux_u32_put(GlbResource.binBytes,80);"
        "let t0=ux_f32_put(512,1.0);let t1=ux_f32_put(516,3.0);"
        "let p0=ux_f32_put(532,2.0);let m0=ux_f32_put(544,4.0);"
        "let m1=ux_f32_put(556,0.0-2.0);let p1=ux_f32_put(568,10.0);",bytes);
    const char *cases[]={
        "let channel=GltfLoader_translationChannel(0,0,0,2,640,680);return ux_u32(channel+GltfAnimationChannel.interpolation);",
        "let channel=GltfLoader_translationChannel(0,0,0,2,640,680);let view=ux_u32(channel+GltfAnimationChannel.samples);"
        "return ux_u32(view+AnimationSamples.stride);",
        "let channel=GltfLoader_translationChannel(0,0,0,2,640,680);let view=ux_u32(channel+GltfAnimationChannel.samples);"
        "let p=GltfCubic_evaluate(view,2.0,800,0);return ux_f32(p);",
        "let chan=GltfLoader_translationChannel(0,0,0,2,640,680);let view=ux_u32(chan+GltfAnimationChannel.samples);"
        "let p=GltfCubic_evaluate(view,4.0,800,0);return ux_f32(p);",
        "let bad=ux_u32_put(GlbResource.binBytes,76);return GltfLoader_translationChannel(0,0,0,2,640,680);"
    };
    const double gold[]={2303,9,7.5,10,-5};
    return g_math_run("G_IO GLTF cubic translation","gltf-animation-cubic",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let edit=ux_f32_put(556,0.0);let c=GltfLoader_translationChannel(0,0,0,2,640,680);"
        "let v=ux_u32(c+GltfAnimationChannel.samples);let p=GltfCubic_evaluate(v,2.0,800,0);return ux_f32(p);");
}
