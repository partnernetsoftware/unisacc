#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define LARGE "let changed=EffectComposer_setViewport(64,160,320,180,2.0);"
#define FRACTIONAL "let changed=EffectComposer_setViewport(64,160,201,101,1.5);"
#define FIELD(name) "return 0.0+ux_u32(64+EffectComposer." #name ");"
int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"f64-math","effectcomposer","effectcomposer-viewport",0};
    const char *setup="let c=EffectComposer_init(64,2,1,256,4,5,7);let pass=EffectComposer_addPass(64,7,1);";
    const char *cases[]={
        LARGE FIELD(width),LARGE FIELD(height),
        LARGE "return 0.0+EffectComposer_passViewport(64,0,0);",
        LARGE "return 0.0+EffectComposer_passViewport(64,0,1);",
        FRACTIONAL FIELD(width),FRACTIONAL FIELD(height),
        FRACTIONAL "return 0.0+ux_u32(160+ComposerViewport.logicalWidth);",
        FRACTIONAL "return 0.0+ux_u32(160+ComposerViewport.logicalHeight);",
        FRACTIONAL "return ux_f64(160+ComposerViewport.pixelRatio);",
        "return 0.0+EffectComposer_setViewport(64,160,65535,180,2.0);",
        "let bad=EffectComposer_setViewport(64,64,320,180,2.0);" FIELD(width),
        "let bad=EffectComposer_setViewport(64,256,320,180,2.0);" FIELD(height),
        "return 0.0+EffectComposer_setViewport(64,160,5,7,1.0);",
    };
    const double gold[]={640,360,640,360,301,151,201,101,1.5,-1,5,7,0};
    return g_wasm_batch_addon("G_STRUCT EffectComposer viewport","effectcomposer-viewport",
        argv[1],modules,setup,cases,gold,sizeof gold/sizeof gold[0],mutate?0:-1,
        "let changed=EffectComposer_setViewport(64,160,320,180,1.0);" FIELD(width));
}
