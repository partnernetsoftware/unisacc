#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object3d-layout","object3d","scene-snapshot-layout","scene-snapshot",0};
    const char *setup=
        "let arena=0;let out=2048;let ready=Object3D_initArena(arena,4);"
        "let root=Object3D_create(arena);let hidden=Object3D_create(arena);let leaf=Object3D_create(arena);"
        "let sibling=Object3D_create(arena);let r=Object3D_address(arena,root);let h=Object3D_address(arena,hidden);"
        "let l=Object3D_address(arena,leaf);let s=Object3D_address(arena,sibling);"
        "let x0=ux_f64_put(ux_u32(r+Object3D.position),1.0);let x1=ux_f64_put(ux_u32(h+Object3D.position),2.0);"
        "let x2=ux_f64_put(ux_u32(l+Object3D.position),4.0);let x3=ux_f64_put(ux_u32(s+Object3D.position),8.0);"
        "let visible=ux_u32_put(h+Object3D.visible,0);let layer=ux_u32_put(l+Object3D.layerMask,8);"
        "let j=Object3D_add(arena,root,hidden);let k=Object3D_add(arena,hidden,leaf);"
        "let m=Object3D_add(arena,root,sibling);let updated=Object3D_updateMatrixWorld(arena,root,0);";
    #define ALL "let count=Scene_snapshot(arena,root,out,4,0);"
    #define VISIBLE "let count=Scene_snapshot(arena,root,out,4,1);"
    const char *cases[]={
        ALL "return 0.0+count;",
        ALL "let row=out+2*SceneSnapshotRow.size;return 0.0+(ux_u32(row+SceneSnapshotRow.parent)==hidden);",
        ALL "let row=out+2*SceneSnapshotRow.size;return ux_f64(ux_u32(row+SceneSnapshotRow.worldMatrix)+96);",
        ALL "return 0.0+ux_u32(out+2*SceneSnapshotRow.size+SceneSnapshotRow.layerMask);",
        VISIBLE "return 0.0+count;",
        VISIBLE "return 0.0+(ux_u32(out+SceneSnapshotRow.size+SceneSnapshotRow.node)==sibling);",
        "return 0.0+Scene_snapshot(arena,root,out,4,2);",
        "let keep=ux_u32_put(out,77);let refused=Scene_snapshot(arena,root,out,3,0);return 0.0+ux_u32(out);",
        "return 0.0+Scene_snapshot(arena,root,256,4,0);",
    };
    const double gold[]={4,1,7,8,2,1,1,77,-1};
    return g_wasm_batch("G_STRUCT scene snapshot","scene-snapshot",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?4:-1,ALL "return 0.0+count;");
}
