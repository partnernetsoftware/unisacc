#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"geometry-load-layout","datautils","bufferattribute","interleavedbuffer",
        "interleavedbuffer-edit","interleavedbuffer-clone-shared","interleavedbuffer-json","instancedinterleavedbuffer",0};
    const char *setup=
        "let src=InstancedInterleavedBuffer_new(0,128,2,8,9,2);"
        "let x=ux_f32_put(128,1.0);let z=ux_f32_put(136,3.0);"
        "let use=InterleavedBuffer_setUsage(src,35048);"
        "let reg=InterleavedBuffer_initClone(512,544,2,1024,1200);"
        "let json=InterleavedBuffer_initJSON(624,656,2,1280,1360);";
    const char *cases[]={
        "return 0.0+ux_u32(src+InstancedInterleavedBuffer.meshPerAttribute);",
        "return ux_f32(InstancedInterleavedBuffer_row(src,1));",
        "return ux_f32(InstancedInterleavedBuffer_row(src,2));",
        "return 0.0+InstancedInterleavedBuffer_row(src,4);",
        "let c=InstancedInterleavedBuffer_copy(256,src,320,16);"
        "let changed=ux_f32_put(136,99.0);return ux_f32(InstancedInterleavedBuffer_row(c,2));",
        "let c=InstancedInterleavedBuffer_copy(256,src,320,16);return 0.0+ux_u32(c+InterleavedBuffer.usage);",
        "let a=InstancedInterleaved_clone(256,src,reg,128,16);"
        "let b=InstancedInterleaved_clone(352,src,reg,128,16);"
        "let edit=ux_f32_put(InstancedInterleavedBuffer_row(a,2),11.0);"
        "return ux_f32(InstancedInterleavedBuffer_row(b,3));",
        "let rec=InstancedInterleaved_toJSON(src,json,768,41,128,16);"
        "return 0.0+ux_u32(rec+InstancedInterleavedJson.meshPerAttribute);",
        "let rec=InstancedInterleaved_toJSON(src,json,768,41,128,16);"
        "return 0.0+ux_u32(rec+InstancedInterleavedJson.isInstancedInterleavedBuffer);"
    };
    const double gold[]={2,1,3,-2,3,35048,11,2,1};
    return g_wasm_batch("G_STRUCT InstancedInterleavedBuffer","instancedinterleavedbuffer",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,"return ux_f32(InstancedInterleavedBuffer_row(src,1));");
}
