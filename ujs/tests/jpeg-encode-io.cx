#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","image-layout","jpeg-header","jpeg-entropy","jpeg-idct","jpeg-gray",
        "jpeg-color","jpeg-encode-block","jpeg-encode",0};
    const char *setup="let a=ux_u32_put(ImageResource.rgba,256);let b=ux_u32_put(ImageResource.width,17);"
        "let c=ux_u32_put(ImageResource.height,9);let d=ux_u32_put(ImageResource.rowBytes,72);"
        "let y=0;while(y<9){let x=0;while(x<17){"
        "let p=ux_u32_put(256+y*72+x*4,4278190080+119*65536+68*256+204);x=x+1;}y=y+1;}";
    #define ENCODE "let size=JpegEncode_rgba8(0,80,2048,4096,8192,8192);"
    #define DECODE "let length=JpegDecode_color(2048,size,16384,612,32768,4096);"
    const char *cases[]={
        ENCODE "return 0.0+(size>318 && size<4096);",
        ENCODE "let meta=JpegHeader_probe(2048,size,16384);if(meta<0){return 0.0+meta;}return 0.0+ux_u32(meta+JpegHeader.width);",
        ENCODE "let meta=JpegHeader_probe(2048,size,16384);if(meta<0){return 0.0+meta;}return 0.0+ux_u32(meta+JpegHeader.height);",
        ENCODE DECODE "return 0.0+length;",
        ENCODE DECODE "let r=ux_u8(16384);return 0.0+(r>=201 && r<=207);",
        ENCODE DECODE "let g=ux_u8(16385+608);return 0.0+(g>=65 && g<=71);",
        ENCODE DECODE "let b=ux_u8(16386+608);return 0.0+(b>=116 && b<=122);",
        "return 0.0+JpegEncode_rgba8(0,80,2048,320,8192,8192);",
        "let keep=ux_u8_put(2048,99);let n=JpegEncode_rgba8(0,80,2048,320,8192,8192);return 0.0+ux_u8(2048);",
        "return 0.0+JpegEncode_rgba8(0,0,2048,4096,8192,8192);",
        "return 0.0+JpegEncode_rgba8(0,80,256,4096,8192,8192);",
        ENCODE DECODE "return 0.0+ux_u8(16387+608);"
    };
    const double gold[]={1,17,9,612,1,1,1,-1,99,-1,-1,255};
    return g_wasm_batch("G_IO JpegEncode","jpeg-encode",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?4:-1,
        "let line=0;while(line<8){let k=0;while(k<8){let v=ux_u32_put(256+line*72+k*4,4278190080);k=k+1;}line=line+1;}"
        ENCODE DECODE "let r=ux_u8(16384);return 0.0+(r>=201 && r<=207);");
}
