#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","loaderutils",0};
    const char *setup=
        "let b64=ux_u8_put(64,72);let b65=ux_u8_put(65,84);let b66=ux_u8_put(66,84);"
        "let b67=ux_u8_put(67,80);let b68=ux_u8_put(68,83);let b69=ux_u8_put(69,58);"
        "let b70=ux_u8_put(70,47);let b71=ux_u8_put(71,47);let b72=ux_u8_put(72,97);"
        "let b73=ux_u8_put(73,47);let b74=ux_u8_put(74,98);let b75=ux_u8_put(75,47);"
        "let b96=ux_u8_put(96,47);let b97=ux_u8_put(97,120);"
        "let b112=ux_u8_put(112,47);let b113=ux_u8_put(113,47);let b114=ux_u8_put(114,98);"
        "let b115=ux_u8_put(115,47);let b116=ux_u8_put(116,120);"
        "let b128=ux_u8_put(128,100);let b129=ux_u8_put(129,97);let b130=ux_u8_put(130,116);"
        "let b131=ux_u8_put(131,97);let b132=ux_u8_put(132,58);let b133=ux_u8_put(133,44);"
        "let b134=ux_u8_put(134,120);"
        "let b144=ux_u8_put(144,100);let b145=ux_u8_put(145,97);let b146=ux_u8_put(146,116);"
        "let b147=ux_u8_put(147,97);let b148=ux_u8_put(148,58);let b149=ux_u8_put(149,120);"
        "let b160=ux_u8_put(160,66);let b161=ux_u8_put(161,111);let b162=ux_u8_put(162,66);"
        "let b163=ux_u8_put(163,58);let b164=ux_u8_put(164,120);"
        "let b176=ux_u8_put(176,66);let b177=ux_u8_put(177,76);let b178=ux_u8_put(178,79);"
        "let b179=ux_u8_put(179,66);let b180=ux_u8_put(180,58);let b181=ux_u8_put(181,120);"
        "let b224=ux_u8_put(224,239);let b225=ux_u8_put(225,187);let b226=ux_u8_put(226,191);"
        "let b227=ux_u8_put(227,65);let b228=ux_u8_put(228,226);let b229=ux_u8_put(229,130);"
        "let b230=ux_u8_put(230,66);let b231=ux_u8_put(231,240);let b232=ux_u8_put(232,159);"
        "let b233=ux_u8_put(233,152);let b234=ux_u8_put(234,128);let b235=ux_u8_put(235,237);"
        "let b236=ux_u8_put(236,160);let b237=ux_u8_put(237,128);";
    const char *cases[]={
        "return LoaderUtils_resolveURL(96,2,64,12,320,32);",
        "let n=LoaderUtils_resolveURL(96,2,64,12,320,32);return ux_u8(320+n-2);",
        "return LoaderUtils_resolveURL(112,5,64,12,320,32);",
        "return LoaderUtils_resolveURL(128,7,64,12,320,32);",
        "return LoaderUtils_resolveURL(144,6,64,12,320,32);",
        "return LoaderUtils_resolveURL(160,5,64,12,320,32);",
        "return LoaderUtils_resolveURL(176,6,64,12,320,32);",
        "return LoaderUtils_resolveURL(96,0,64,12,320,0);",
        "let keep=ux_u8_put(320,77);let n=LoaderUtils_resolveURL(96,2,64,12,320,10);return ux_u8(320);",
        "return LoaderUtils_decodeText(224,14,320,32);",
        "let n=LoaderUtils_decodeText(224,14,320,32);return ux_u8(320);",
        "let n=LoaderUtils_decodeText(224,14,320,32);return ux_u8(324);",
        "let n=LoaderUtils_decodeText(224,14,320,32);return ux_u8(328);",
        "let keep=ux_u8_put(320,77);let n=LoaderUtils_decodeText(224,14,320,13);return ux_u8(320);",
        "return LoaderUtils_decodeText(224,14,224,32);"
    };
    const double gold[]={11,47,5,7,18,17,6,0,77,18,65,66,128,77,-1};
    return g_math_run("G_IO LoaderUtilsText","loaderutils-text",modules,setup,cases,gold,
