#pragma unisa use g_math
#pragma unisa use r160_wait
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","audioloader","audioloader-request",0};
    const char *setup="let wav=[82,73,70,70,42,0,0,0,87,65,86,69,102,109,116,32,16,0,0,0,1,0,1,0,64,31,0,0,128,62,0,0,2,0,16,0,100,97,116,97,6,0,0,0,0,0,0,128,0,64];"
        "let i=0;while(i<50){let a=ux_u8_put(256+i,wav[i]);i=i+1;}"
        "let manager=LoadingManager_init(0);let file=FileLoader_init(32,manager);let other=FileLoader_init(96,manager);"
        "let id=FileLoader_begin(file,64);let result=512;"
        "let clip=ux_u32_put(result+AudioLoadResult.clip,560);let pcm=ux_u32_put(result+AudioLoadResult.pcm,608);"
        "let cap=ux_u32_put(result+AudioLoadResult.capacity,16);";
    #define RECEIVE "let count=AudioLoader_receive(file,id,200,256,50,128,result);"
    #define TRANSPORT "let count=AudioLoader_receive(file,id,404,0,0,128,result);"
    #define BAD "let format=ux_u16_put(276,65535);"
    const char *cases[]={
        RECEIVE "return count;",
        RECEIVE "return ux_u32(128+LoadingEvent.kind);",
        RECEIVE "return ux_u32(128+LoadingEvent.size+LoadingEvent.kind);",
        RECEIVE "return ux_u32(560+AudioResource.frames);",
        RECEIVE "return ux_i32(result+AudioLoadResult.status);",
        RECEIVE "return ux_u32(file+FileLoader.state);",
        BAD RECEIVE "return count;",
        BAD RECEIVE "return ux_u32(128+2*LoadingEvent.size+LoadingEvent.kind);",
        BAD RECEIVE "return ux_i32(result+AudioLoadResult.status);",
        TRANSPORT "return ux_i32(result+AudioLoadResult.status);",
        TRANSPORT "return ux_u32(128+LoadingEvent.kind);",
        "let second=FileLoader_begin(other,64);" RECEIVE "return count;",
        "let second=FileLoader_begin(other,64);" RECEIVE
        "let completed=AudioLoader_receive(other,second,200,256,50,128,result);return ux_u32(128+LoadingEvent.size+LoadingEvent.kind);",
        "return AudioLoader_receive(file,id+1,200,256,50,128,result);",
        "let guard=ux_i32_put(result+AudioLoadResult.status,77);let out=AudioLoader_receive(file,id+1,200,256,50,128,result);"
        "return ux_i32(result+AudioLoadResult.status);"
    };
    const double gold[]={2,2,4,3,0,0,3,3,-3,-4,3,1,4,-1,77};
    return g_math_run_oracle("G_IO AudioLoader response lifecycle","audio-request",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?7:-1,
        BAD RECEIVE "return ux_u32(128+LoadingEvent.size+LoadingEvent.kind);",r160_wait_ref);
}
