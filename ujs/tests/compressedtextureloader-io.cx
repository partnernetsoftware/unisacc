#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","compressedtextureloader",0};
    const char *cases[]={
        "let t=CompressedTextureLoader_level(32,128,64,5,5,33779);return ux_u32(t+CompressedMip.bytes);",
        "let t=CompressedTextureLoader_level(32,128,64,5,5,33779);return ux_u32(t+CompressedMip.format);",
        "let t=CompressedTextureLoader_level(32,128,64,5,5,33779);return ux_u32(t+CompressedMip.width);",
        "return CompressedTextureLoader_level(32,128,63,5,5,33779);",
        "return CompressedTextureLoader_level(32,128,64,5,5,1);",
        "return CompressedTextureLoader_level(32,36,64,5,5,33779);"
    };
    const double gold[]={64,33779,5,-3,-2,-1};
    return g_math_run("G_IO CompressedTextureLoader","compressedtextureloader",modules,"",cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let t=CompressedTextureLoader_level(32,128,32,5,5,33776);return ux_u32(t+CompressedMip.bytes);");
}
