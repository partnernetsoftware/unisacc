#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader",0};
    const char *setup="let manager=LoadingManager_init(0);let loader=FileLoader_init(32,manager);"
        "let id=FileLoader_begin(loader,64);let byte=ux_u8_put(256,65);";
    const char *cases[]={
        "let got=FileLoader_receive(loader,id,200,256,3,64);return ux_u8(ux_u32(loader+FileLoader.bytes));",
        "let got=FileLoader_receive(loader,id,200,256,3,64);return ux_u32(loader+FileLoader.length);",
        "let got=FileLoader_receive(loader,id,404,0,0,64);return ux_u32(64+LoadingEvent.kind);",
        "let got=FileLoader_receive(loader,id,404,0,0,64);return ux_u32(64+2*LoadingEvent.size+LoadingEvent.kind);",
        "let gone=FileLoader_receive(loader,id,404,0,0,64);let fresh=FileLoader_begin(loader,64);return FileLoader_receive(loader,id,200,256,3,64);",
        "return FileLoader_receive(loader,id,200,6291455,3,64);",
        "let got=FileLoader_receive(loader,id,200,256,3,64);let released=FileLoader_release(loader,id);return ux_u32(released+FileLoader.length);"
    };
    const double gold[]={65,3,3,4,-1,-1,0};
    return g_math_run("G_IO FileLoader","fileloader",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let got=FileLoader_receive(loader,id,200,256,3,64);return ux_u32(64+LoadingEvent.kind);");
}
