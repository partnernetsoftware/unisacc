#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"curve-line","curve-bezier","path","shape","shapepath",0};
    const char *setup=
        "let sp=ShapePath_init(0,64,4);"
        "let left=Path_init(96,512,3);let l1=Path_lineTo(left,0.0,6.0);let l2=Path_lineTo(left,6.0,0.0);let l3=Path_closePath(left);"
        "let right=Path_init(160,768,3);let r0=Path_moveTo(right,10.0,0.0);let r1=Path_lineTo(right,10.0,6.0);"
        "let r2=Path_lineTo(right,16.0,0.0);let r3=Path_closePath(right);"
        "let hole=Path_init(224,1024,3);let h0=Path_moveTo(hole,1.0,1.0);let h1=Path_lineTo(hole,2.0,1.0);"
        "let h2=Path_lineTo(hole,1.0,2.0);let h3=Path_closePath(hole);"
        "let next=Path_init(288,1280,3);let n0=Path_moveTo(next,11.0,1.0);let n1=Path_lineTo(next,12.0,1.0);"
        "let n2=Path_lineTo(next,11.0,2.0);let n3=Path_closePath(next);"
        "let a=ShapePath_add(sp,left);let b=ShapePath_add(sp,right);let c=ShapePath_add(sp,hole);let d=ShapePath_add(sp,next);";
    const char *cases[]={
        "return ShapePath_toShapes(sp,1792,3,1920,2,2048,8,2304,2,0);",
        "let n=ShapePath_toShapes(sp,1792,3,1920,2,2048,8,2304,2,0);return ux_u32(1792+Shape.count);",
        "let n=ShapePath_toShapes(sp,1792,3,1920,2,2048,8,2304,2,0);return ux_u32(1928)==next;",
        "let x=ux_u32_put(64,hole);let y=ux_u32_put(68,left);let z=ux_u32_put(72,next);let p=ux_u32_put(76,right);"
        "let n=ShapePath_toShapes(sp,1792,3,1920,2,2048,8,2304,2,0);return ux_u32(1928)==next;",
        "let x=ux_u32_put(68,left);let n=ShapePath_toShapes(sp,1792,3,1920,2,2048,8,2304,2,0);"
        "return ux_u32(1792+Shape.size+Shape.count);"
    };
    const double gold[]={2,1,1,1,2};
    return g_math_run("G_STRUCT ShapePath hole ownership","shapepath-holes",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let n=ShapePath_toShapes(sp,1792,3,1920,2,2048,8,2304,2,0);return ux_u32(1792+Shape.count)+1;");
}
