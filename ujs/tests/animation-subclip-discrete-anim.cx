#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","animation-view","keyframe-track","animationclip","animation-window",
        "animation-subclip","discreteinterpolant","booleankeyframetrack","stringkeyframetrack",0};
    const char *setup=
        "let name=ux_u8_put(64,110);let first=ux_u8_put(68,97);let last=ux_u8_put(72,98);"
        "let time=ux_f32_put(132,1.0);let bool=ux_u32_put(164,1);"
        "let s0=ux_u32_put(176,68);let l0=ux_u32_put(180,1);let s1=ux_u32_put(184,72);let l1=ux_u32_put(188,1);"
        "let bv=AnimationSamples_init(256,128,160,2,1);let sv=AnimationSamples_init(272,128,176,2,2);"
        "let b=BooleanKeyframeTrack_init(320,64,1,bv);let s=StringKeyframeTrack_init(336,64,1,sv);"
        "let p0=ux_u32_put(384,b);let p1=ux_u32_put(388,s);"
        "let clip=AnimationClip_init(512,64,1,384,2,1.0,2500);let request=576;"
        "let start=ux_f64_put(request+AnimationSubclipRequest.startFrame,30.0);"
        "let end=ux_f64_put(request+AnimationSubclipRequest.endFrame,60.0);"
        "let fps=ux_f64_put(request+AnimationSubclipRequest.fps,30.0);"
        "let out=AnimationUtils_subclip(clip,request,640,1024,512);"
        "let tracks=ux_u32(out+AnimationClip.tracks);let newBool=ux_u32(tracks);let newString=ux_u32(tracks+4);";
    const char *cases[]={
        "return ux_u32(out+AnimationClip.trackCount);",
        "let value=BoolTrack_evaluate(newBool,0.0,1600);return ux_u32(value);",
        "let value=StringKeyframeTrack_evaluate(newString,0.0,1600);return ux_u8(ux_u32(value));",
        "let value=StringKeyframeTrack_evaluate(newString,0.0,1600);return ux_u32(value+4);",
        "let edit=ux_u32_put(184,68);let value=StringKeyframeTrack_evaluate(newString,0.0,1600);return ux_u8(ux_u32(value));",
        "return KeyframeTrack_getInterpolation(newString);"
    };
    const double gold[]={2,1,98,1,98,2300};
    return g_math_run("G_ANIM AnimationUtils discrete subclip","animation-subclip-discrete",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,"return ux_u8(68);");
}
