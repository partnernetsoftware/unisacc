#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"vector-scalar","object-layouts","vector3","ray","raycaster","raycast-mesh",0};
    const char *setup="let a=Vector3_set(256,0.0-1.0,0.0-1.0,0.0);let b=Vector3_set(280,1.0,0.0-1.0,0.0);"
        "let c=Vector3_set(304,0.0,1.0,0.0);let w=512;let a0=ux_f64_put(w,2.0);let a1=ux_f64_put(w+40,1.0);"
        "let a2=ux_f64_put(w+80,1.0);let a3=ux_f64_put(w+112,0.0-4.0);let a4=ux_f64_put(w+120,1.0);"
        "let o=Vector3_set(0,0.25,0.0,0.0);let d=Vector3_set(24,0.0,0.0,0.0-1.0);let r=Ray_set(64,o,d);"
        "let q=656;let initial=ux_f64_put(q+RayMeshQuery.far,5.0);";
    const char *cases[]={
        "let h=Raycaster_meshFace(r,256,w,q,704,800);return ux_f64(h+RayMeshHit.distance);",
        "let h=Raycaster_meshFace(r,256,w,q,704,800);return ux_f64(h+RayMeshHit.z);",
        "let mode=ux_u32_put(q+RayMeshQuery.side,2);let h=Raycaster_meshFace(r,256,w,q,704,800);return ux_f64(h+RayMeshHit.x);",
        "let h=Raycaster_meshFace(r,256,w,q,704,800);return ux_u32(h+RayMeshHit.face);",
        "let mode=ux_u32_put(q+RayMeshQuery.side,1);return Raycaster_meshFace(r,256,w,q,704,800);",
        "let far=ux_f64_put(q+RayMeshQuery.far,3.0);return Raycaster_meshFace(r,256,w,q,704,800);",
        "let flip=ux_f64_put(w,0.0-2.0);let h=Raycaster_meshFace(r,256,w,q,704,800);return ux_f64(h+RayMeshHit.distance);",
        "return Raycaster_meshFace(r,256,w,q,704,704);"
    };
    const double gold[]={4,-4,.25,0,-2,-2,4,-1};
    return g_math_run("G_RAY StaticMeshFace","raycast-mesh",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let h=Raycaster_meshFace(r,256,w,q,704,800);return ux_f64(h+RayMeshHit.z);");
}
