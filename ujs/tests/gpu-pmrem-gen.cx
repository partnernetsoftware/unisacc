#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

int main(int argc,char **argv) {
    int write=argc==2 && tx_eqz(argv[1],"--write");
    int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    const char header[]="roughness_milli\tmip\n";
    unsigned char *data=0,*old=0,*reference=0;
    int64_t bytes=0,old_bytes=0,reference_bytes=0;
    const char cube_uv[]="const CubeUVReflectionMapping = 306;";
    int failed=sy_read_file("ujs/practice/uxe/base/gpu-pmrem-roughness.tsv",&data,&bytes,1024) ||
        sy_read_file("ujs/practice/web/game/three.module.js",&reference,&reference_bytes,4000000) ||
        !tx_contains((const char *)reference,reference_bytes,cube_uv,sizeof cube_uv-1);
    if(!failed && (bytes<sizeof header-1 || !tx_prefix((char *)data,bytes,header,sizeof header-1))) failed=1;
    int rows=0,levels[5],threshold[5];
    for(int i=sizeof header-1;!failed && i<bytes;) {
        char *end=0;
        long rough=tx_strtol((char *)data+i,&end,10);
        if(rows>=5 || end==(char *)data+i || end>=(char *)data+bytes || *end!='\t' || rough<1 || rough>1000) { failed=1; break; }
        char *start=end+1;
        long mip=tx_strtol(start,&end,10);
        if(end==start || end>=(char *)data+bytes || *end!='\n' || mip< -2 || mip>4 ||
           (rows>0 && (rough>=threshold[rows-1] || mip<=levels[rows-1]))) { failed=1; break; }
        threshold[rows]=rough;
        levels[rows]=mip;
        rows++;
        i=end-(char *)data+1;
    }
    if(rows!=5 || threshold[0]!=1000 || levels[0]!=-2 || levels[4]!=4) failed=1;
    char code[4096];
    int n=0;
    if(!failed) n=tx_snprintf(code,sizeof code,
        "// Generated by gpu-pmrem-gen.cx.\n"
        "native function GpuPmrem_cubeUVMapping() i64 { return 306; }\n"
        "native function gpu_pmrem_threshold(index:i64) i64 { let row=[%d,%d,%d,%d,%d]; return row[index]; }\n"
        "native function gpu_pmrem_level(index:i64) i64 { let row=[%d,%d,%d,%d,%d]; return row[index]; }\n",
        threshold[0],threshold[1],threshold[2]+mutate,threshold[3],threshold[4],
        levels[0],levels[1],levels[2],levels[3],levels[4]);
    if(n<=0 || n>=sizeof code) failed=1;
    const char *path="ujs/practice/uxe/base/gpu-pmrem-generated.ujs";
    if(!failed) failed=write?sy_write_file(path,code,n,0644)!=0:
        sy_read_file(path,&old,&old_bytes,sizeof code) || !tx_same((char *)old,old_bytes,code,n);
    mm_free(data);
    mm_free(old);
    mm_free(reference);
    printf("PMREM_GENERATE rows=%d failed=%d\n",rows,failed);
    return failed;
}
