#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","vector-scalar","color","gpu-fog","fogexp2",0};
    const char *setup=
        "let initial=Color_setHex(256,8405000,1);let defaults=FogExp2_initDefault(0,initial);"
        "let fog=FogExp2_init(64,initial,0.04);let m=ux_u8_put(512,109);"
        "let i=ux_u8_put(513,105);let s=ux_u8_put(514,115);let t=ux_u8_put(515,116);"
        "let named=FogExp2_setName(fog,512,4);let clone=FogExp2_clone(128,fog);"
        "let reset=Color_setHex(256,0,1);let blue=Color_setHex(fog+FogExp2.red,255,1);"
        "let json=FogExp2_toJSON(192,fog);";
    const char *cases[]={
        "return ux_f64(defaults+FogExp2.density);","return ux_u32(clone+FogExp2.nameBytes);",
        "return Color_getHex(clone+FogExp2.red,1);","return ux_f64(clone+FogExp2.density);",
        "return ux_u32(json+FogExp2Json.kind);","return ux_u32(json+FogExp2Json.nameBytes);",
        "return ux_u8(ux_u32(json+FogExp2Json.name));","return ux_u8(ux_u32(json+FogExp2Json.name)+1);",
        "return ux_u8(ux_u32(json+FogExp2Json.name)+2);","return ux_u8(ux_u32(json+FogExp2Json.name)+3);",
        "return ux_u32(json+FogExp2Json.color);","return ux_f64(json+FogExp2Json.density);"
    };
    const double gold[]={0.00025,0,8405000,0.04,2,4,109,105,115,116,255,0.04};
    return g_math_run("G_STRUCT FogExp2","fogexp2",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?3:-1,"let lost=ux_f64_put(clone+FogExp2.density,0.4);return ux_f64(clone+FogExp2.density);");
}
