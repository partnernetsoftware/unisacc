#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","scene-snapshot-layout","render-list","scene-render-list","scene-draw-project",0};
    const char *setup="let draw=0;let stream=64;let world=128;let proj=256;let xyz=512;let rgb=640;let out=768;"
        "let w=ux_u32_put(draw+SceneDrawItem.worldMatrix,world);"
        "let p=ux_u32_put(stream+SceneDrawStream.positions,xyz);let n=ux_u32_put(stream+SceneDrawStream.vertexCount,2);"
        "let s=ux_u32_put(stream+SceneDrawStream.stride,16);let c=ux_u32_put(stream+SceneDrawStream.color,rgb);"
        "let v=ux_u32_put(stream+SceneDrawStream.viewProjection,proj);"
        "let a=ux_f64_put(world,1.0);let b=ux_f64_put(world+40,1.0);let d=ux_f64_put(world+80,1.0);"
        "let e=ux_f64_put(world+96,1.0);let f=ux_f64_put(world+104,2.0);"
        "let g=ux_f64_put(world+112,0.0-4.0);let h=ux_f64_put(world+120,1.0);"
        "let i=ux_f64_put(proj,1.0);let j=ux_f64_put(proj+40,1.0);let k=ux_f64_put(proj+80,0.0-1.25);"
        "let l=ux_f64_put(proj+88,0.0-1.0);let m=ux_f64_put(proj+112,0.0-2.25);"
        "let x=ux_f32_put(xyz,1.0);let y=ux_f32_put(xyz+4,0.0-1.0);"
        "let z=ux_f32_put(xyz+16,0.0-1.0);let z2=ux_f32_put(xyz+24,0.0-4.0);"
        "let red=ux_f32_put(rgb,0.25);let alpha=ux_f32_put(rgb+12,0.5);";
    #define DRAW "let count=SceneDraw_projectPacked(draw,stream,out,2);"
    const char *cases[]={
        DRAW "return 0.0+count;",
        DRAW "return ux_f32(out);",
        DRAW "return ux_f32(out+4);",
        DRAW "return ux_f32(out+8);",
        DRAW "return ux_f32(out+36);",
        DRAW "return ux_f32(out+40);",
        DRAW "return ux_f32(out+52);",
        "let keep=ux_f32_put(out,77.0);let bad=ux_f32_put(xyz+24,5.0);"
        DRAW "return 0.0+(count==0-2 && ux_f32(out)==77.0);",
        "return 0.0+SceneDraw_projectPacked(draw,stream,xyz,2);",
    };
    const double gold[]={2,0.5,0.25,0.6875,0.96875,0.25,0.5,1,-1};
    return g_wasm_batch("G_STRUCT scene projection stream","scene-draw-project",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,DRAW "return ux_f32(out+4);");
}
