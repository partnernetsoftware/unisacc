#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

static double level(int mip,int nearest) {
    const int size=4>>mip, scale=1<<mip;
    double x=0.31*size, y=0.32*size;
    if(nearest) { x=(int)x; y=(int)y; }
    else {
        x-=0.5; y-=0.5;
        if(x<0.0) x=0.0;
        if(y<0.0) y=0.0;
        if(x>size-1) x=size-1;
        if(y>size-1) y=size-1;
    }
    return 16+16*(x*scale+(scale-1)*0.5)+32*(y*scale+(scale-1)*0.5);
}

static int filter_gold(int index,int sample) {
    const int modes[]={0,1,2,2,3,3,4,4,5,5};
    const int mode=modes[index];
    if(mode<2 || sample==0) return (int)(level(0,mode==0)+0.5);
    const int nearest=mode==3 || mode==4;
    if(mode==3 || mode==5) return (int)(level(1,nearest)+0.5);
    const int low=sample-1;
    const double weight=sample==1?0.75:0.375;
    return (int)(level(low,nearest)*(1-weight)+level(low+1,nearest)*weight+0.5);
}

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char prelude[]=
        "import host_gpu_submit from \"uxe_gpu_v1\" (i64,i64) i64;\n"
        "export uxe_texture_filter(value:i64,variant:i64) i64 version 1;\n";
    char dir[220],abi[260],wasm[260],cwd[400],url[760],*out=0;
    size_t size=0;
    if(sy_mkdtemp("/tmp","uxe-texture-filters-",dir,sizeof dir) || sy_cwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/fixture.wasm",dir);
    tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/gpu-texture-filters-r160.html?wasm=%s&mutate=%d",
        cwd,wasm,mutate);
    int failed=sy_write_file(abi,prelude,sizeof prelude-1,0600)!=0;
    char *compile[]={"./ujs/ujs2wasm.com",abi,"ujs/practice/uxe/base/record-copy.ujs",
        "ujs/practice/uxe/base/gpu-packet.ujs","ujs/practice/uxe/base/gpu-state.ujs",
        "ujs/practice/uxe/base/gpu-texture-filters-generated.ujs",
        "ujs/practice/uxe/test/gpu-texture-filters-probe.ujs","-o",wasm,0};
    if(!failed) {
        const int rc=cx_runv_timeout(compile,6,&out,&size);
        if(rc) printf("GPU_TEXTURE_FILTERS compile_rc=%d %.*s\n",rc,(int)size,out?out:"");
        failed=rc!=0;
        mm_free(out);
        out=0;
    }
    enum { functions=10, variants=3, values=functions*variants*2 };
    double pixels[values]={0};
    if(!failed && r160_wait_read(url,"#r160",pixels,values,dir)) {
        printf("GPU_TEXTURE_FILTERS browser_read_failed\n");
        failed=1;
    }
    int checked=0;
    if(!failed) for(int v=0;v<variants;v++) for(int tag=0;tag<functions;tag++) {
        const int expected=filter_gold(tag,v);
        const int offset=(v*functions+tag)*2;
        if(pixels[offset]!=pixels[offset] || pixels[offset+1]!=pixels[offset+1] ||
           pixels[offset]<expected-1 || pixels[offset]>expected+1 ||
           pixels[offset+1]<expected-1 || pixels[offset+1]>expected+1) {
            printf("GPU_TEXTURE_FILTERS tag=%d sample=%d actual=%.0f r160=%.0f gold=%d\n",
                tag,v,pixels[offset],pixels[offset+1],expected);
            failed++;
        }
        checked++;
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&out,&size)) failed++;
    mm_free(out);
    printf("GPU_TEXTURE_FILTERS modes=%d variants=%d pixels=%d failed=%d\n",functions,variants,checked,failed);
    return failed!=0;
}
