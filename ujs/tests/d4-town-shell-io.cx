#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"../products/d4/d4-town-shell",0};
    const char *setup=
        "let data=[0,0,2000,0,1000,2000,1000,1,1000,2000,0,1000,2000,1000,2,2000,2000,0,1000,2000,1000];"
        "let i=0;while(i<21){let x=ux_i32_put(4*i,data[i]);i=i+1;}"
        "let facts=0;let target=512;let clear=ux_u32_put(target,42);";
    #define SHELL "let output=D4Town_shell(target,9,facts,3,3.0);"
    const char *cases[]={
        SHELL "return 0.0+output;",
        SHELL "return ux_f32(target);",
        SHELL "return ux_f32(target+4);",
        SHELL "return ux_f32(target+32+24);",
        SHELL "return ux_f32(target+4*32+16);",
        SHELL "return ux_f32(target+8*32);",
        SHELL "return 0.0+ux_u32(target+4*32+28);",
        "let bad=ux_i32_put(80,0);" SHELL "return 0.0+(output==0-2 && ux_u32(target)==42);",
        "let wrong=D4Town_shell(target,8,facts,3,3.0);return 0.0+(wrong==0-1 && ux_u32(target)==42);",
    };
    const double gold[]={9,3,3,(float)0.48,(float)0.24,(float)5.27,2,1,1};
    return g_wasm_batch("G_IO D4 town shell","d4-town-shell",modules,setup,cases,gold,9,mutate?1:-1,
        "let canonical=D4Town_shell(target,9,facts,3,0.0);return ux_f32(target);");
}
