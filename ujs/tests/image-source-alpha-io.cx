#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","vector-scalar","color","image-layout","imageutils","image-source-linear",0};
    const char *setup=
        "let a=ux_u32_put(ImageResource.rgba,512);let b=ux_u32_put(ImageResource.width,3);"
        "let c=ux_u32_put(ImageResource.height,1);let d=ux_u32_put(ImageResource.rowBytes,12);"
        "let p=ux_u32_put(512,128*16777216+128*256+255);"
        "let q=ux_u32_put(516,32*16777216+250*65536+125*256+25);"
        "let r=ux_u32_put(520,16777216+255);";
    #define LOAD "let done=ImageUtils_sourceCanvasLinear(0,768,12);"
    const char *cases[]={
        LOAD "return 0.0+done;",
        LOAD "return 0.0+ux_u8(768);",
        LOAD "return 0.0+ux_u8(769);",
        LOAD "return 0.0+ux_u8(771);",
        LOAD "return 0.0+ux_u8(772);",
        LOAD "return 0.0+ux_u8(773);",
        LOAD "return 0.0+ux_u8(774);",
        LOAD "return 0.0+ux_u8(775);",
        LOAD "return 0.0+ux_u32(776);",
        "return 0.0+ImageUtils_sourceCanvasLinear(0,512,12);",
    };
    const double gold[]={12,255,56,55,0,64,255,4,0,-1};
    return g_wasm_batch_page("G_IO ImageUtils canvas alpha","image-source-alpha",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let done=ImageUtils_sourceToLinear(0,768,12);return 0.0+ux_u8(769);");
}
