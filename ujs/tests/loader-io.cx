#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","loader",0};
    const char *setup="let manager=LoadingManager_init(0);let loader=Loader_init(32,manager);let p=ux_u8_put(128,112);let q=ux_u8_put(144,114);";
    const char *cases[]={
        "return ux_u32(loader+Loader.pathBytes);","return ux_u32(loader+Loader.credentials);",
        "let p=Loader_setPath(loader,128,2,0);let q=Loader_setPath(p,144,3,1);return ux_u32(q+Loader.resourcePathBytes);",
        "let p=Loader_setPath(loader,128,2,0);let q=Loader_setPath(p,144,3,1);return ux_u8(ux_u32(q+Loader.path));",
        "let p=Loader_setWithCredentials(loader,1);return ux_u32(p+Loader.credentials);",
        "return Loader_setPath(loader,6291455,2,0);"
    };
    const double gold[]={0,0,3,112,1,-1};
    return g_math_run("G_IO Loader","loader",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let p=Loader_setPath(loader,128,2,0);let q=Loader_setPath(p,144,3,0);return ux_u8(ux_u32(q+Loader.path));");
}
