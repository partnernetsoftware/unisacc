#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","animation-view","animationobjectgroup",0};
    const char *setup=
        "let group=AnimationObjectGroup_init(0,128,3);let a=AnimationObjectGroup_update(group,7,0);"
        "let b=AnimationObjectGroup_update(group,8,0);let dup=AnimationObjectGroup_update(group,7,0);";
    const char *cases[]={
        "return ux_u32(group+AnimationObjectGroup.total);",
        "let removed=AnimationObjectGroup_update(group,7,1);return ux_u32(removed+AnimationObjectGroup.active);",
        "let removed=AnimationObjectGroup_update(group,7,1);return ux_u32(removed+AnimationObjectGroup.total);",
        "let removed=AnimationObjectGroup_update(group,7,1);let joined=AnimationObjectGroup_update(removed,7,0);"
        "return ux_u32(joined+AnimationObjectGroup.active);",
        "let removed=AnimationObjectGroup_update(group,7,2);return ux_u32(removed+AnimationObjectGroup.total);",
        "let filled=AnimationObjectGroup_update(group,9,0);return AnimationObjectGroup_update(filled,10,0);"
    };
    const double gold[]={2,1,2,2,1,-2};
    return g_math_run("G_ANIM AnimationObjectGroup","animationobjectgroup",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let removed=AnimationObjectGroup_update(group,7,2);return ux_u32(removed+AnimationObjectGroup.total);");
}
