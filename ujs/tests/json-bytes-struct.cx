#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"json-bytes",0};
    const char *setup="let quote=ux_u8_put(32,34);let slash=ux_u8_put(33,92);"
        "let newline=ux_u8_put(34,10);let utf_a=ux_u8_put(35,195);let utf_b=ux_u8_put(36,169);";
    const char *cases[]={
        "return json_write_string(100,128,32,5)-100;",
        "let end=json_write_string(100,128,32,5);return ux_u8(101)+ux_u8(104)*256;",
        "let end=json_write_string(100,128,32,5);return ux_u8(110)+ux_u8(111)*256;",
        "let mark=ux_u8_put(100,21);let end=json_write_string(100,103,32,5);return ux_u8(100)+end;",
        "return json_write_f64(100,128,1.25,4096)-100;",
        "let end=json_write_f64(100,128,0.0-25.5,4096);return ux_u8(100)+ux_u8(103)*256;",
        "return json_write_f64(100,200,0.1,4096)-100;",
        "let end=json_write_f64(100,200,0.1,4096);return ux_u8(102)+ux_u8(end-1)*256;",
        "let end=json_write_f64(100,128,0.0-0.0,4096);return ux_u8(100)+(end-100)*256;",
        "let end=json_write_f64(100,128,1.0/0.0,4096);return ux_u8(100)+(end-100)*256;",
        "let mark=ux_u8_put(100,21);let end=json_write_f64(100,103,1.25,4096);return ux_u8(100)+end;"
    };
    const double gold[]={14,23644,50017,20,4,11821,57,13617,304,1134,20};
    return g_math_run("G_STRUCT UTF-8 JSON tokens","json-bytes",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?4:-1,"return json_write_f64(100,128,125.0,4096)-100;");
}
