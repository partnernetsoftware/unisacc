#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object3d-layout","object3d","animation-view",
        "animationobjectgroup","anim-group-bindings","propertybinding","anim-group-property-write",0};
    const char *setup=
        "let arena=Object3D_initArena(0,5);let a=Object3D_create(arena);let b=Object3D_create(arena);"
        "let c=Object3D_create(arena);let group=AnimationObjectGroup_init(2304,2368,4);"
        "let table=AnimGroup_subsInit(2432,group,2464,2);"
        "let aa=AnimGroup_updateBindings(table,a,0);let bb=AnimGroup_updateBindings(table,b,0);"
        "let cc=AnimGroup_updateBindings(table,c,0);let removed=AnimGroup_updateBindings(table,b,1);"
        "let rows=AnimGroup_subscribe(table,1,2496,2560);let scale=AnimGroup_subscribe(table,2,2640,2704);"
        "let binding=2800;let values=2848;let path=2896;let scalePath=2920;"
        "let pa=Object3D_address(arena,a);let pb=Object3D_address(arena,b);let pc=Object3D_address(arena,c);"
        "let posa=ux_u32(pa+Object3D.position);let posb=ux_u32(pb+Object3D.position);let posc=ux_u32(pc+Object3D.position);"
        "let ax=ux_f64_put(posa,1.0);let ay=ux_f64_put(posa+8,1.0);"
        "let by=ux_f64_put(posb+8,2.0);let cy=ux_f64_put(posc+8,3.0);"
        "let da=ux_u32_put(pa+Object3D.dirty,0);let db=ux_u32_put(pb+Object3D.dirty,0);"
        "let dc=ux_u32_put(pc+Object3D.dirty,0);"
        "let t0=ux_f64_put(values,7.0);let t1=ux_f64_put(values+8,3.0);let t2=ux_f64_put(values+16,4.0);"
        "let chars=[46,112,111,115,105,116,105,111,110,91,121,93];let i=0;"
        "while(i<12){let put=ux_u8_put(path+i,chars[i]);i=i+1;}"
        "let letters=[46,115,99,97,108,101];i=0;while(i<6){let put=ux_u8_put(scalePath+i,letters[i]);i=i+1;}";
    #define WRITE "let hit=AnimGroup_setValue(table,1,arena,path,12,values,1,binding);"
    #define RESUME "let added=AnimGroup_updateBindings(table,b,0);"
    #define DELETE "let dead=Object3D_destroy(arena,c);"
    #define A "return ux_f64(posa+8);"
    #define B "return ux_f64(posb+8);"
    #define COUNT "return 0.0+hit;"
    const char *cases[]={
        WRITE COUNT, WRITE A, WRITE B, WRITE "return ux_f64(posc+8);",
        WRITE "return ux_f64(posa);",
        WRITE "return 0.0+(ux_u32(pa+Object3D.dirty)!=0);",
        WRITE "return 0.0+(ux_u32(pb+Object3D.dirty)!=0);",
        RESUME WRITE COUNT, RESUME WRITE B,
        "let forget=AnimGroup_updateBindings(table,c,2);" WRITE COUNT,
        "let forget=AnimGroup_updateBindings(table,c,2);" WRITE "return ux_f64(posc+8);",
        "let x=ux_f64_put(values,2.0);let hit=AnimGroup_setValue(table,2,arena,scalePath,6,values,3,binding);"
          "return ux_f64(ux_u32(pc+Object3D.scale)+16);",
        "let x=ux_f64_put(values,2.0);let hit=AnimGroup_setValue(table,2,arena,scalePath,6,values,3,binding);"
          "return ux_f64(ux_u32(pb+Object3D.scale)+16);",
        DELETE WRITE COUNT, DELETE WRITE A,
        DELETE "let replacement=Object3D_create(arena);" WRITE A,
        "let dead=Object3D_destroy(arena,b);" WRITE COUNT,
        "let broken=ux_u32_put(pc+Object3D.position,posa);" WRITE A,
        "let detached=AnimGroup_unsubscribe(table,1);" WRITE COUNT,
        "return 0.0+AnimGroup_setValue(table,1,arena,path,12,values,2,binding);",
        "let bad=ux_u8_put(path+10,119);" WRITE COUNT,
        "let removeA=AnimGroup_updateBindings(table,a,1);let removeC=AnimGroup_updateBindings(table,c,1);" WRITE COUNT,
        "return 0.0+AnimGroup_setValue(table,1,arena,path,12,values,1,2560);",
    };
    const double gold[]={2,7,2,7,1,1,0,3,7,1,3,4,1,-1,1,1,2,1,-1,-1,-1,0,-1};
    return g_wasm_batch_page("G_ANIM AnimationObjectGroup composite write","anim-group-property-write",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,RESUME WRITE B);
}
