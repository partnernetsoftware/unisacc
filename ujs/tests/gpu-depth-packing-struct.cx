#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int basic=argc==2 && tx_eqz(argv[1],"--mutate-basic");
    const int rgba=argc==2 && tx_eqz(argv[1],"--mutate-rgba");
    if(argc!=1 && !basic && !rgba) return 2;
    const char *modules[]={"gpu-depth-packing-generated",0};
    const char *cases[]={
        "return GpuDepth_pack(3200,0.25,0.25);",
        "return GpuDepth_pack(3201,0.25,0.25);",
        "return GpuDepth_pack(3201,0.312744140625,1.0);",
        "return GpuDepth_pack(3200,0.75,1.0);",
    };
    const double gold[]={
        191*65793.0+64*16777216.0,
        64*16777216.0,
        16*65536.0+80*16777216.0,
        64*65793.0+255*16777216.0,
    };
    return g_math_run("G_STRUCT GPU depth packing","gpu-depth-packing",modules,"",cases,gold,4,
        basic?0:rgba?1:-1,basic?cases[1]:cases[0]);
}
