#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"curve-line","curve-bezier","path","curvepath",0};
    const char *setup="let path=Path_init(0,256,2);let move=Path_moveTo(path,0.0,0.0);"
        "let a=Path_lineTo(path,3.0,0.0);let b=Path_lineTo(path,3.0,4.0);"
        "let count=CurvePath_getCurveLengths(path,1024,2048,4);"
        "let middle=CurvePath_getPoint(path,3072,1024,2048,0.5,4);"
        "let end=CurvePath_getPoint(path,3104,1024,2048,1.0,4);";
    const char *cases[]={"return count;","return ux_f64(1024);","return CurvePath_getLength(1024,count);",
        "return ux_f64(middle);","return ux_f64(middle+8);","return ux_f64(end+8);"};
    const double gold[]={2,3,7,3,0.5,4};
    return g_math_run("G_STRUCT CurvePath","curvepath",modules,setup,cases,gold,6,mutate?4:-1,"return ux_f64(end+8);");
}
