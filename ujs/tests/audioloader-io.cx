#pragma unisa use g_math
#pragma unisa use r160_wait
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","audioloader",0};
    const char *setup="let wav=[82,73,70,70,42,0,0,0,87,65,86,69,102,109,116,32,16,0,0,0,1,0,1,0,64,31,0,0,128,62,0,0,2,0,16,0,100,97,116,97,6,0,0,0,0,0,0,128,0,64];"
        "let i=0;while(i<50){let a=ux_u8_put(256+i,wav[i]);i=i+1;}"
        "let manager=LoadingManager_init(0);let file=FileLoader_init(32,manager);"
        "let id=FileLoader_begin(file,64);let got=FileLoader_receive(file,id,200,256,50,64);";
    const char *cases[]={
        "let clip=AudioLoader_decodeWav(file,512,600,12);return ux_u32(clip+AudioResource.frames);",
        "let clip=AudioLoader_decodeWav(file,512,600,12);return ux_u32(clip+AudioResource.sampleRate);",
        "let clip=AudioLoader_decodeWav(file,512,600,12);return ux_f32(ux_u32(clip+AudioResource.pcm)+4);",
        "let clip=AudioLoader_decodeWav(file,512,600,12);return ux_f32(ux_u32(clip+AudioResource.pcm)+8);",
        "let a=ux_u8_put(276,3);return AudioLoader_decodeWav(file,512,600,12);",
        "let a=ux_u8_put(296,8);return AudioLoader_decodeWav(file,512,600,12);",
        "return AudioLoader_decodeWav(file,512,600,8);"
    };
    const double gold[]={3,8000,-1,(float)(16384.0/32767.0),-3,-2,-1};
    return g_math_run_oracle("G_IO AudioLoader","audioloader",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let clip=AudioLoader_decodeWav(file,512,600,12);return ux_f32(ux_u32(clip+AudioResource.pcm)+8);",r160_wait_ref);
}
