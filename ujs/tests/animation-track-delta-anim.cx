#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","f64-math","quaternion","animation-view","discreteinterpolant",
        "linearinterpolant","cubicinterpolant","quaternionlinearinterpolant","animation-additive",
        "animation-additive-quat","animation-track-delta",0};
    const char *setup=
        "let time=ux_f32_put(68,1.0);let end=ux_f32_put(88,1.0);"
        "let a=ux_f32_put(128,5.0);let b=ux_f32_put(132,10.0);"
        "let c=ux_f32_put(148,2.0);let d=ux_f32_put(152,10.0);"
        "let target=AnimationSamples_init(0,64,128,2,1);let reference=AnimationSamples_init(32,80,144,3,1);";
    const char *cases[]={
        "let result=AnimationUtils_trackDelta(target,reference,2301,1,0.5,256,8,512);return ux_f32(256);",
        "let result=AnimationUtils_trackDelta(target,reference,2301,1,0.5,256,8,512);return ux_f32(260);",
        "let result=AnimationUtils_trackDelta(target,reference,2301,1,0.0,256,8,512);return ux_f32(256);",
        "let result=AnimationUtils_trackDelta(target,reference,2301,1,2.0,256,8,512);return ux_f32(256);",
        "let result=AnimationUtils_trackDelta(target,reference,2300,1,0.5,256,8,512);return ux_f32(256);",
        "return AnimationUtils_trackDelta(target,reference,2301,1,0.5,256,8,128);"
    };
    const double gold[]={-1,4,5,-5,3,-1};
    return g_math_run("G_ANIM AnimationUtils reference sampling","animation-track-delta",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let result=AnimationUtils_trackDelta(target,reference,2300,1,0.5,256,8,512);return ux_f32(256);");
}
