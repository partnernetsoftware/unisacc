#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","f64-math","image-layout","image-base64","png-header","png-scanlines",
        "png-bits","png-huffman","png-fixed","png-stored","png-encode","jpeg-header","jpeg-entropy","jpeg-idct",
        "jpeg-gray","jpeg-color","jpeg-encode-block","jpeg-encode","image-data-url",0};
    const char *setup="let a=ux_u32_put(ImageResource.rgba,512);let i=0;while(i<2049){"
        "let p=ux_u32_put(512+i*4,4278190080+119*65536+68*256+204);i=i+1;}";
    #define SIZE(W,H,P) "let w=ux_u32_put(ImageResource.width," #W ");let h=ux_u32_put(ImageResource.height," #H ");" \
        "let pitch=ux_u32_put(ImageResource.rowBytes," #P ");"
    #define AUTO "return 0.0+ImageUtils_canvasDataURL(0,65536,65536,200000,262144);"
    #define JPEG "return 0.0+ImageUtils_jpegDataURL(0,80,65536,65536,200000,262144);"
    const char *cases[]={
        SIZE(2048,1,8192) AUTO,
        SIZE(2049,1,8196) AUTO,
        SIZE(1,2049,4) AUTO,
        SIZE(2,1,8) AUTO,
        SIZE(17,9,68) JPEG,
        SIZE(2049,1,8196) AUTO,
        SIZE(2,1,8) "return 0.0+ImageUtils_jpegDataURL(0,80,65536,24,200000,262144);",
        SIZE(2,1,8) "let keep=ux_u8_put(65536,99);let n=ImageUtils_jpegDataURL(0,80,65536,24,200000,262144);"
        "return 0.0+ux_u8(65536);",
        SIZE(2,1,12) AUTO,
        SIZE(2,1,8) "return 0.0+ImageUtils_jpegDataURL(0,80,512,65536,200000,262144);"
    };
    const double gold[]={2048,2049,2049,204,1,1,-2,99,-1,-1};
    return g_wasm_batch_page("G_IO ImageUtils data URLs","image-data-url","ujs/practice/uxe/test/image-data-url-wasm.html",
        modules,setup,cases,gold,sizeof gold/sizeof gold[0],mutate?1:-1,SIZE(2048,1,8192) AUTO);
}
