#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","vector-scalar","vector3","ray","raycast-memory","raycaster-state",
        "raycast-mesh","raycast-hit-sort","raycast-buffer","raycast-instances","skeleton-layout","skinnedmesh-deform",
        "raycast-skinned",0};
    const char *setup=
        "let state=0;let mesh=128;let skin=192;let stream=224;let skeleton=256;"
        "let world=384;let bind=512;let inverse=640;let pose=768;let points=864;let joints=960;let weights=1024;"
        "let hits=1152;let work=1280;let ray=Raycaster_default(state);"
        "let i=0;while(i<16){let a=ux_f64_put(world+8*i,(i%5==0)*1.0);let b=ux_f64_put(bind+8*i,(i%5==0)*1.0);"
        "let c=ux_f64_put(inverse+8*i,(i%5==0)*1.0);let d=ux_f32_put(pose+4*i,(i%5==0)*1.0);i=i+1;}"
        "let wz=ux_f64_put(world+112,0.0-4.0);let bx=ux_f32_put(pose+48,0.0-3.0);"
        "let a=ux_u32_put(mesh+RayMeshBuffer.positions,points);let b=ux_u32_put(mesh+RayMeshBuffer.vertexCount,3);"
        "let c=ux_u32_put(mesh+RayMeshBuffer.positionStride,12);let d=ux_u32_put(mesh+RayMeshBuffer.faceCount,1);"
        "let e=ux_u32_put(mesh+RayMeshBuffer.matrixWorld,world);let f=ux_u32_put(mesh+RayMeshBuffer.layerMask,1);"
        "let g=ux_u32_put(skin+SkinnedMesh.skeleton,skeleton);let h=ux_u32_put(skin+SkinnedMesh.bindMatrix,bind);"
        "let j=ux_u32_put(skin+SkinnedMesh.bindInverse,inverse);let k=ux_u32_put(skeleton+Skeleton.palette,pose);"
        "let l=ux_u32_put(skeleton+Skeleton.count,1);let m=ux_u32_put(stream+RaySkinStreams.joints,joints);"
        "let n=ux_u32_put(stream+RaySkinStreams.weights,weights);let o=ux_u32_put(stream+RaySkinStreams.jointStride,16);"
        "let p=ux_u32_put(stream+RaySkinStreams.weightStride,16);"
        "let x0=ux_f32_put(points,2.0);let y0=ux_f32_put(points+4,0.0-1.0);"
        "let x1=ux_f32_put(points+12,4.0);let y1=ux_f32_put(points+16,0.0-1.0);"
        "let x2=ux_f32_put(points+24,3.0);let y2=ux_f32_put(points+28,1.0);"
        "let w0=ux_f32_put(weights,1.0);let w1=ux_f32_put(weights+16,1.0);let w2=ux_f32_put(weights+32,1.0);";
    #define HIT "let count=Raycaster_intersectSkinned(state,mesh,skin,stream,hits,1,work,768);"
    const char *cases[]={
        HIT "return 0.0+count;",
        HIT "return ux_f64(hits+RayMeshHit.distance);",
        HIT "return 0.0+ux_u32(hits+RayMeshHit.face);",
        "return 0.0+Raycaster_intersectMeshBuffer(state,mesh,hits,1,work,768);",
        "let far=ux_f64_put(state+RaycasterState.far,3.0);" HIT "return 0.0+count;",
        "let bad=ux_u32_put(joints+32,1);" HIT "return 0.0+count;",
        "let keep=ux_f64_put(hits,77.0);let bad=ux_u32_put(joints+32,1);" HIT "return ux_f64(hits);",
        "return 0.0+Raycaster_intersectSkinned(state,mesh,skin,stream,hits,1,points,768);",
    };
    const double gold[]={1,4,0,0,0,-2,77,-1};
    return g_wasm_batch("G_RAY SkinnedMesh deformed triangles","raycast-skinned",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,"let moved=ux_f32_put(pose+48,0.0);" HIT "return 0.0+count;");
}
