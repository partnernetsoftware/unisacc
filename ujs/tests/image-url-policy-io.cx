#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","vector-scalar","color","imageutils",0};
    const char *setup="let ready=ux_u32_put(512,1096040772);let colon=ux_u8_put(516,58);";
    const char *cases[]={
        "return 0.0+ImageUtils_urlPolicy(512,5,1,1);",
        "return 0.0+ImageUtils_urlPolicy(512,5,0,1);",
        "return 0.0+ImageUtils_urlPolicy(1024,4,0,1);",
        "return 0.0+ImageUtils_urlPolicy(1024,4,1,1);",
        "return 0.0+ImageUtils_urlPolicy(0,0,0,0);",
        "return 0.0+ImageUtils_urlPolicy(0,0,1,0);",
        "return 0.0+ImageUtils_urlPolicy(6291455,2,1,1);",
        "return 0.0+ImageUtils_urlPolicy(0,1,1,0);",
    };
    const double gold[]={0,0,0,1,2,1,-1,-1};
    return g_wasm_batch("G_IO ImageUtils URL policy","image-url-policy",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,"return 0.0+ImageUtils_urlPolicy(1024,4,1,1);");
}
