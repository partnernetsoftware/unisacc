#pragma unisa use sys.fs
#pragma unisa use mem.heap
#pragma unisa use text.text
#pragma unisa use text.fmt

static int call(char **arguments,int want,const char *marker) {
    char *out=0;
    size_t n=0;
    int rc=cx_runv_timeout(arguments,10,&out,&n);
    int ok=rc==want && (!marker || (out && tx_contains(out,n,marker,tx_len(marker,512))));
    if(!ok && out) printf("%s\n",out);
    mm_free(out);
    return ok;
}

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    int numeric_only=argc==2 && tx_eqz(argv[1],"--numeric-only");
    if(argc!=1 && !mutate && !numeric_only) return 2;
    char dir[256],source[300],wasm[300];
    if(sy_mkdtemp("/tmp","ujs-mixed-",dir,sizeof dir)) return 2;
    tx_snprintf(source,sizeof source,"%s/probe.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/probe.wasm",dir);
    char *compile[]={"./ujs/ujs2wasm.com",source,"-o",wasm,0};
    char *validate[]={"wasm-validate",wasm,0};
    char *run[]={"./ujs/ujs2wasm.com","--run",wasm,0};
    char *reject[]={"sh","-c","exec \"$@\" 2>&1","sh","./ujs/ujs2wasm.com",source,"-o",wasm,0};
    const char *cases[]={
        "let a=3;let w=2.0;let x=a*(w/4)-w*0.5;return x;",
        "let a=3;return (a+0.5)*(2.0-a/2.0);",
        "native function twice(x:f64) f64 {return x*2;}return twice(3*(2.0/4)-2.0*0.5);",
        "let a=3;return a<3.5 && 2.5<a && (a+0.25)==3.25;",
        "native function probe(a:i64,w:f64) f64 {let x=a*(w/4)-w*0.5;return x;}return probe(3,2.0);"
    };
    const char *gold[]={
        "\"tag\":\"f64\",\"value\":0.5,","\"tag\":\"f64\",\"value\":1.75,",
        "\"tag\":\"f64\",\"value\":1,","\"tag\":\"i64\",\"value\":1,",
        "\"tag\":\"f64\",\"value\":0.5,"
    };
    int failed=0;
    for(int i=0;i<5;i++) {
        const char *program=i==0 && mutate?"let a=4;let w=2.0;let x=a*(w/4)-w*0.5;return x;":cases[i];
        if(sy_write_file(source,program,tx_len(program,1024),0600) ||
           !call(compile,0,0) || !call(validate,0,0) || !call(run,0,gold[i])) {
            printf("MIXED_NUMERIC case=%d\n",i);
            failed++;
        }
        sy_unlink(wasm);
    }
    const char *bad[]={
        "return 3%2.0;",
        "native function probe() i64 {let v=0.5-0.25;let v=1;return v;}return probe();"
    };
    const char *errors[]={"f64 mod","local redeclaration changes type"};
    sy_stat_t stat;
    if(!numeric_only) for(int i=0;i<2;i++) {
        if(sy_write_file(source,bad[i],tx_len(bad[i],1024),0600) ||
           !call(reject,1,errors[i]) || sy_lstat(wasm,&stat)!=-ENOENT) {
            printf("MIXED_NUMERIC rejection=%d\n",i);
            failed++;
        }
        sy_unlink(wasm);
    }
    sy_unlink(source);
    sy_rmdir(dir);
    printf("CHECK_UJS_MIXED_NUMERIC cases=%d failed=%d\n",numeric_only?5:7,failed);
    return failed!=0;
}
