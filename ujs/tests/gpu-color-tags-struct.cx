#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int empty=argc==2 && tx_eqz(argv[1],"--mutate-empty");
    int linear=argc==2 && tx_eqz(argv[1],"--mutate-linear");
    int srgb=argc==2 && tx_eqz(argv[1],"--mutate-srgb");
    int rec709=argc==2 && tx_eqz(argv[1],"--mutate-rec709");
    int p3=argc==2 && tx_eqz(argv[1],"--mutate-p3");
    if(argc!=1 && !empty && !linear && !srgb && !rec709 && !p3) return 2;
    const char *modules[]={"f64-math","vector-scalar","color","colormanagement",
        "gpu-output-color","gpu-color-tag","gpu-color-tags-generated",0};
    const char *setup="let color=Color_setRGB(0,0.2,0.4,0.8);"
        "let bytes=[108,105,110,101,97,114,115,114,103,98,114,101,99,55,48,57,112,51];"
        "let i=0;while(i<18){let b=ux_u8_put(64+i,bytes[i]);i=i+1;}";
    const char *cases[]={
        "let out=GpuColor_fromColorSpace(color,64,0,3);return ux_f64(out);",
        "return GpuColor_decodeTransfer(64,6,0.02);",
        "return GpuColor_decodeTransfer(70,4,0.02);",
        "let out=GpuColor_convertPrimaries(color,74,6,80,2);return ux_f64(out);",
        "let out=GpuColor_convertPrimaries(color,80,2,74,6);return ux_f64(out);",
        "return GpuColor_convertPrimaries(color,70,4,74,6);"
    };
    const double gold[]={0.2,0.02,0.02/12.92,0.2*0.8224621+0.4*0.177538,
        0.2*1.2249401-0.4*0.2249404,-2};
    return g_math_run("G_STRUCT GPU color tags","gpu-color-tags",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],empty?0:linear?1:srgb?2:rec709?3:p3?4:-1,empty?
        "let out=GpuColor_fromColorSpace(color,70,4,3);return ux_f64(out);":
        linear?cases[2]:srgb?cases[1]:rec709?cases[4]:cases[3]);
}
