#pragma unisa module g_math
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

int g_math_reference(const char *name, double *values, int count, const char *dir) {
    char profile[320], url[640], cwd[460], *out = 0;
    char *args[] = {"google-chrome", "--headless=new", "--allow-file-access-from-files",
        "--disable-background-networking", "--no-first-run", profile, "--virtual-time-budget=4000",
        "--dump-dom", url, 0};
    const char marker[] = "<pre id=\"r160\">[";
    size_t size = 0;
    if (sy_cwd(cwd, sizeof cwd)) return 1;
    tx_snprintf(profile, sizeof profile, "--user-data-dir=%s/chrome", dir);
    tx_snprintf(url, sizeof url, "file://%s/ujs/practice/uxe/test/%s-r160.html", cwd, name);
    int rc = cx_runv_timeout(args, 14, &out, &size);
    long at = !rc && out ? tx_find(out, size, marker, sizeof marker - 1) : -1;
    if (at >= 0) {
        char *p = out + at + sizeof marker - 1, *end = 0;
        for (int i = 0; i < count; i++) {
            values[i] = tx_strtod(p, &end);
            if (end == p || *end != (i + 1 == count ? ']' : ',')) { at = -1; break; }
            p = end + 1;
        }
    }
    mm_free(out);
    return at < 0;
}

int g_math_sample(const char *source, const char *wasm, const char *library,
                  const char *prelude, const char *statement, double *value) {
    char text[100001], *out = 0, *end = 0;
    const char marker[] = "\"value\":";
    char *args[] = {"./ujs/ujs2wasm.com", (char *)source, "-o", (char *)wasm, "--run", 0};
    int size = tx_snprintf(text, sizeof text, "%s\n%s\n%s\n", library, prelude, statement);
    if (size < 0 || size >= (int)sizeof text || sy_write_file(source, text, size, 0600)) return 1;
    size_t n = 0;
    int rc = cx_runv_timeout(args, 6, &out, &n);
    long at = !rc && out ? tx_find(out, n, marker, sizeof marker - 1) : -1;
    if(at<0) printf("G_MATH_SAMPLE compiler_rc=%d bytes=%ld\n",rc,(long)n);
    if (at >= 0) {
        char *p = out + at + sizeof marker - 1;
        *value = tx_strtod(p, &end);
        if (end == p || *end != ',') at = -1;
    }
    mm_free(out);
    return at < 0;
}

int g_math_near(double a, double b, double tolerance) {
    return a - b <= tolerance && b - a <= tolerance;
}

typedef int (*g_math_oracle_fn)(const char *,double *,int,const char *);

static int g_math_run_oracle_range(const char *name, const char *fixture, const char *const *modules,
               const char *setup, const char *const *cases, const double *gold,
               int count, int first, int limit, int mutate_index, const char *mutation,g_math_oracle_fn oracle) {
    char library[96000]={0};
    int used=0;
    if(count<=0 || count>100 || first<0 || limit<=first || limit>count) return 2;
    for(int i=0;modules[i];i++) {
        char path[256];
        unsigned char *data=0;
        int64_t bytes=0;
        tx_snprintf(path,sizeof path,"ujs/practice/uxe/base/%s.ujs",modules[i]);
        int read=sy_read_file(path,&data,&bytes,sizeof library-used-2);
        if(read) {
            printf("G_MATH_SOURCE path=%s bytes_used=%d rc=%d\n",path,used,read);
            return 2;
        }
        int added=tx_snprintf(library+used,sizeof library-used,"%s\n",data);
        mm_free(data);
        if(added<0 || added>=(int)sizeof library-used) return 2;
        used+=added;
    }
    char dir[256],source[300],wasm[300];
    if(sy_mkdtemp("/tmp","ujs-math-",dir,sizeof dir)) return 2;
    tx_snprintf(source,sizeof source,"%s/probe.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/probe.wasm",dir);
    double refs[100]={0};
    int failed=oracle(fixture,refs,count,dir);
    for(int i=first;!failed && i<limit;i++) {
        double actual=0;
        const char *statement=i==mutate_index?mutation:cases[i];
        if(g_math_sample(source,wasm,library,setup,statement,&actual) ||
            !g_math_near(actual,gold[i],1e-9) || !g_math_near(refs[i],gold[i],1e-9)) {
            printf("%s case=%d actual=%.17g r160=%.17g gold=%.17g\n",name,i,actual,refs[i],gold[i]);
            failed=1;
        }
    }
    char *clean[]={"rm","-rf","--",dir,0};
    char *out=0;
    size_t out_n=0;
    if(cx_runv_timeout(clean,5,&out,&out_n)) failed=1;
    mm_free(out);
    printf("%s cases=%d failed=%d\n",name,limit-first,failed);
    return failed;
}

int g_math_run_range(const char *name, const char *fixture, const char *const *modules,
               const char *setup, const char *const *cases, const double *gold,
               int count, int first, int limit, int mutate_index, const char *mutation) {
    return g_math_run_oracle_range(name,fixture,modules,setup,cases,gold,count,first,limit,mutate_index,mutation,g_math_reference);
}

int g_math_run_oracle(const char *name, const char *fixture, const char *const *modules,
               const char *setup, const char *const *cases, const double *gold,
               int count, int mutate_index, const char *mutation,g_math_oracle_fn oracle) {
    return g_math_run_oracle_range(name,fixture,modules,setup,cases,gold,count,0,count,mutate_index,mutation,oracle);
}

int g_math_run(const char *name, const char *fixture, const char *const *modules,
               const char *setup, const char *const *cases, const double *gold,
               int count, int mutate_index, const char *mutation) {
    return g_math_run_range(name,fixture,modules,setup,cases,gold,count,0,count,mutate_index,mutation);
}
