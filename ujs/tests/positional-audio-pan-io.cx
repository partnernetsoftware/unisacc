#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","loadingmanager","fileloader","audioloader","audio-buffer-playback","positional-audio-pan",0};
    #define RIGHT "let n=PositionalAudio_panMono(0,1,4.0,0.0,0.0,1.0,100.0,1.0);"
    #define LEFT "let n=PositionalAudio_panMono(0,1,0.0-4.0,0.0,0.0,1.0,100.0,1.0);"
    #define CENTER "let n=PositionalAudio_panMono(0,1,0.0,0.0,0.0-1.0,1.0,100.0,1.0);"
    const char *cases[]={
        RIGHT "return ux_f64(PositionalAudioGain.right);",
        RIGHT "return ux_f64(PositionalAudioGain.left);",
        LEFT "return ux_f64(PositionalAudioGain.left);",
        CENTER "return 0.0+f64_floor_i64(ux_f64(PositionalAudioGain.right)*1000000.0+0.5);",
        "return PositionalAudio_distanceGain(0,3.0,1.0,5.0,1.0);",
        "return PositionalAudio_distanceGain(2,4.0,1.0,100.0,2.0);",
        "return PositionalAudio_distanceGain(1,8.0,1.0,4.0,1.0);",
        "return PositionalAudio_distanceGain(0,8.0,1.0,5.0,1.0);",
        "return PositionalAudio_distanceGain(3,8.0,1.0,5.0,1.0);",
    };
    const double gold[]={0.25,0,0.25,707107,0.5,0.0625,0.125,0,-1};
    return g_wasm_batch_page("G_IO PositionalAudio mono panning","positional-audio-pan",
        "ujs/practice/uxe/test/wasm-batch.html",modules,"",cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,LEFT "return ux_f64(PositionalAudioGain.right);");
}
