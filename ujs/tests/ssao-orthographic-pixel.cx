#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if((argc!=2 && !mutate) || argv[1][0]!='/') return 2;
    char dir[256],cwd[390],abi[300],wasm[300],url[750];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-ssao-orthographic-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/ssao.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/ujs/practice/uxe/test/ssao-orthographic-r160.html?package=%s&wasm=%s&mode=%d",
        cwd,argv[1],wasm,mutate);
    const char entry[]="export uxe_ssao_orthographic(mutate:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,"ujs/practice/uxe/base/ssao-orthographic.ujs",
        "ujs/practice/uxe/test/ssao-orthographic-probe.ujs","-o",wasm,0};
    // In lower-left row order, expected counts from strict (4,16) depth deltas.
    // The upper-left pixel sees its lower neighbor. The upper-right foreground
    // pair tests the right clamp and the lower-right background depth of 256.
    const int covered[]={2,0,0,0,1,0,1,0};
    enum { pixels=sizeof covered/sizeof covered[0] };
    double actual[pixels*2]={0};
    char *output=0;
    size_t bytes=0;
    int failed=length<0 || length>=(int)sizeof url || sy_write_file(abi,entry,sizeof entry-1,0600);
    if(!failed) {
        const int rc=cx_runv_timeout(compile,6,&output,&bytes);
        if(rc) { printf("C_PIXEL SSAO compiler_rc=%d %s\n",rc,output?output:""); failed++; }
        mm_free(output); output=0;
    }
    if(!failed) failed=r160_wait_read(url,"#r160",actual,pixels*2,dir);
    if(!failed) for(int i=0;i<pixels;i++) {
        const int gray=((8-covered[i])*255+4)/8;
        const double gold=4278190080.0+65793.0*gray;
        if(actual[i]!=gold || actual[pixels+i]!=gold) {
            printf("C_PIXEL SSAO index=%d ujs=%.0f r160=%.0f gold=%.0f\n",
                i,actual[i],actual[pixels+i],gold);
            failed++;
        }
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&output,&bytes)) failed++;
    mm_free(output);
    printf("C_PIXEL SSAO pixels=%d failed=%d\n",pixels,failed);
    return failed!=0;
}
