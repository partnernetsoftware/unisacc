#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"vector-scalar","vector3","box3","plane",0};
    const char *setup="let x=Vector3_set(0,1.0,0.0,0.0);let p=Vector3_set(24,4.0,0.0,0.0);"
        "let a=Plane_set(48,x,0.0-2.0);let l=Vector3_set(80,0.0,1.0,0.0);let e=Vector3_copy(104,p);";
    const char *cases[]={
        "let r=Plane_set(144,x,0.0-2.0);return ux_f64(r+24);",
        "let r=Plane_setComponents(144,0.0,1.0,0.0,0.0-3.0);return ux_f64(r+8);",
        "let r=Plane_setFromNormalAndCoplanarPoint(144,x,p);return ux_f64(r+24);",
        "let x1=Vector3_set(176,0.0,0.0,2.0);let x2=Vector3_set(200,1.0,0.0,2.0);"
        "let x3=Vector3_set(224,0.0,1.0,2.0);let r=Plane_setFromCoplanarPoints(144,x1,x2,x3);return ux_f64(r+24);",
        "let r=Plane_copy(144,a);return ux_f64(r+24);","let r=Plane_clone(144,a);return ux_f64(r+24);",
        "let q=Plane_setComponents(144,2.0,0.0,0.0,0.0-4.0);let r=Plane_normalize(q);return ux_f64(r+24);",
        "let r=Plane_negate(a);return ux_f64(r+24);","return Plane_distanceToPoint(a,p);",
        "let q=Vector3_copy(144,p);let w=ux_f64_put(q+24,1.0);return Plane_distanceToSphere(a,q);",
        "let r=Plane_projectPoint(144,a,p);return ux_f64(r);",
        "let r=Plane_intersectLine(144,a,l);return ux_f64(r+8);",
        "let q=Vector3_set(104,0.0,0.0,0.0);return Plane_intersectLine(144,a,l);",
        "let h=ux_f64_put(l,2.0);let j=ux_f64_put(e,2.0);let r=Plane_intersectLine(144,a,l);return ux_f64(r+8);",
        "return Plane_intersectsLine(a,l);",
        "let h=ux_f64_put(l,2.0);let j=ux_f64_put(e,2.0);return Plane_intersectsLine(a,l);",
        "let lo=Vector3_set(176,0.0,0.0-1.0,0.0-1.0);let hi=Vector3_set(200,2.0,1.0,1.0);"
        "let box=Box3_set(224,lo,hi);return Plane_intersectsBox(a,box);",
        "let q=Vector3_copy(144,p);let w=ux_f64_put(q+24,1.0);return Plane_intersectsSphere(a,q);",
        "let r=Plane_coplanarPoint(144,a);return ux_f64(r);",
        "let c0=ux_f64_put(272,0.0-2.0);let c1=ux_f64_put(312,3.0);let c2=ux_f64_put(352,4.0);"
        "let c3=ux_f64_put(368,1.0);let d3=ux_f64_put(392,1.0);"
        "let r=Plane_applyMatrix4(a,272,0-1,144);return ux_f64(r+24);",
        "let c0=ux_f64_put(272,0.0-2.0);let c1=ux_f64_put(312,3.0);let c2=ux_f64_put(352,4.0);"
        "let c3=ux_f64_put(368,1.0);let d3=ux_f64_put(392,1.0);let n0=ux_f64_put(400,0.0-0.5);"
        "let r=Plane_applyMatrix4(a,272,400,144);return ux_f64(r);",
        "let r=Plane_translate(a,p);return ux_f64(r+24);",
        "let r=Plane_clone(144,a);return Plane_equals(a,r);"
    };
    const double gold[]={-2,1,-4,-2,-2,-2,-2,2,2,1,2,0.5,-1,1,1,0,1,0,2,-3,-1,-6,1};
    return g_math_run("G_MATH Plane","plane",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?8:-1,"return Plane_distanceToPoint(a,x);");
}
