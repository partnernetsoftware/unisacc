#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","record-copy","animation-view","interpolant-family-class",0};
    const char *setup=
        "let a=ux_f32_put(128,1.0);let b=ux_f32_put(132,3.0);let c=ux_f32_put(136,6.0);"
        "let d=ux_f32_put(256,2.0);let e=ux_f32_put(260,5.0);let f=ux_f32_put(264,11.0);"
        "let view=AnimationSamples_init(64,128,256,3,1);"
        "let state=Interpolant_init(512,view,1024);";
    const char *cases[]={
        "let result=Interpolant_evaluate(state,0.0);return ux_f32(result);",
        "let result=Interpolant_evaluate(state,7.0);return ux_f32(result);",
        "return Interpolant_evaluate(state,2.0);",
        "let call=Interpolant_evaluate(state,3.0);return ux_u32(state+InterpolantState.cached);",
        "let result=Interpolant_copySampleValue(state,1);return 10*ux_f32(result)+(result==1024);",
        "return Interpolant_copySampleValue(state,3);",
        "let p=Interpolant_getSettings(state);let x=ux_u32_put(1100,2401);let y=ux_u32_put(1104,2402);"
        "let q=Interpolant_setSettings(state,1100);return p!=Interpolant_getSettings(q);",
        "let first=Interpolant_locate(state,2.0);let same=Interpolant_locate(state,2.5);"
        "let next=Interpolant_locate(state,3.0);let after=Interpolant_locate(state,9.0);"
        "let back=Interpolant_locate(state,1.0);return first*10000+same*1000+next*100+after*10+back;"
    };
    const double gold[]={2,11,-3,2,51,-1,1,32563};
    return g_math_run("G_ANIM Interpolant base","interpolant-base",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,"return Interpolant_evaluate(state,0.0);");
}
