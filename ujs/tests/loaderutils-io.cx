#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","loaderutils",0};
    const char *setup="let a=ux_u8_put(64,97);let b=ux_u8_put(65,47);let c=ux_u8_put(66,98);let d=ux_u8_put(67,47);let e=ux_u8_put(68,99);";
    const char *cases[]={
        "return LoaderUtils_extractUrlBase(64,5,128,16);",
        "let n=LoaderUtils_extractUrlBase(64,5,128,16);return ux_u8(128+n-2);",
        "let n=LoaderUtils_extractUrlBase(68,1,128,16);return ux_u8(128);",
        "return LoaderUtils_extractUrlBase(64,5,128,3);",
        "let n=LoaderUtils_extractUrlBase(64,5,65,4);return ux_u8(65+n-2);"
    };
    const double gold[]={4,98,46,-2,98};
    return g_math_run("G_IO LoaderUtils","loaderutils",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "return LoaderUtils_extractUrlBase(64,3,128,16);");
}
