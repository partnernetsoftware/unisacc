#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","datautils","bufferattribute","interleavedbuffer",
        "interleavedbuffer-edit","interleavedbuffer-json",0};
    const char *setup=
        "let first=InterleavedBuffer_init(0,128,4,4,9);let second=InterleavedBuffer_init(32,136,1,8,9);"
        "let other=InterleavedBuffer_init(64,192,1,8,9);let reg=256;let table=320;let a=512;let b=544;"
        "let x=ux_f32_put(128,1.0);let y=ux_f32_put(132,0.0-2.0);let z=ux_f32_put(136,3.0);"
        "let w=ux_f32_put(140,4.0);let copy=BufferAttribute_copyBytes(192,128,16);";
    #define INIT "let r=InterleavedBuffer_initJSON(reg,table,2,640,704);"
    #define FIRST "let ja=InterleavedBuffer_toJSON(first,reg,a,101,128,16);"
    #define SECOND "let jb=InterleavedBuffer_toJSON(second,reg,b,102,128,16);"
    #define OTHER "let jb=InterleavedBuffer_toJSON(other,reg,b,102,192,16);"
    #define WORDS "let words=ux_u32(table+IBJsonBacking.words);"
    #define SHARED "return 0.0+(ux_u32(a+IBJsonMeta.buffer)==ux_u32(b+IBJsonMeta.buffer));"
    const char *cases[]={
        INIT FIRST SECOND SHARED,
        INIT FIRST SECOND "return 0.0+ux_u32(reg+IBJsonRegistry.count);",
        INIT FIRST SECOND "return 0.0+ux_u32(b+IBJsonMeta.stride);",
        INIT FIRST SECOND "return 0.0+ux_u32(b+IBJsonMeta.componentType);",
        INIT FIRST SECOND "return 0.0+(ux_u32(b+IBJsonMeta.uuid)==102);",
        INIT FIRST WORDS "return 0.0+ux_u32(words);",
        INIT FIRST WORDS "return 0.0+ux_u32(words+4);",
        INIT FIRST WORDS "return 0.0+ux_u32(words+12);",
        INIT FIRST "let moved=ux_f32_put(128,7.0);" SECOND WORDS "return 0.0+ux_u32(words);",
        INIT FIRST OTHER "return 0.0+ux_u32(b+IBJsonMeta.buffer);",
        INIT FIRST OTHER "return 0.0+ux_u32(reg+IBJsonRegistry.count);",
        INIT FIRST "return 0.0+InterleavedBuffer_toJSON(second,reg,b,102,128,20);",
        "let r=InterleavedBuffer_initJSON(reg,table,1,640,704);" FIRST
          "return 0.0+InterleavedBuffer_toJSON(other,reg,b,102,192,16);",
        INIT "return 0.0+InterleavedBuffer_toJSON(first,reg,128,101,128,16);",
        INIT FIRST "let mark=ux_u32_put(b,77);let bad=InterleavedBuffer_toJSON(second,reg,b,102,128,15);"
          "return 0.0+ux_u32(b);",
    };
    const double gold[]={1,1,2,9,1,1065353216,3221225472,1082130432,1065353216,2,2,-1,-2,-1,77};
    return g_wasm_batch_page("G_STRUCT InterleavedBuffer native JSON","interleavedbuffer-json",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,INIT FIRST OTHER SHARED);
}
