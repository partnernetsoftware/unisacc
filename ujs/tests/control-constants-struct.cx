#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mouse=argc==2 && tx_eqz(argv[1],"--mutate-mouse");
    const int touch=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mouse && !touch) return 2;
    const char *modules[]={"control-constants",0};
    const char *cases[]={
        "return 0.0+MOUSE_LEFT();", "return 0.0+MOUSE_MIDDLE();", "return 0.0+MOUSE_RIGHT();",
        "return 0.0+MOUSE_ROTATE();", "return 0.0+MOUSE_DOLLY();", "return 0.0+MOUSE_PAN();",
        "return 0.0+TOUCH_ROTATE();", "return 0.0+TOUCH_PAN();",
        "return 0.0+TOUCH_DOLLY_PAN();", "return 0.0+TOUCH_DOLLY_ROTATE();",
    };
    const double gold[]={0,1,2,0,1,2,0,1,2,3};
    return g_wasm_batch_page("G_STRUCT control exports","control-constants",
        "ujs/practice/uxe/test/wasm-batch.html",modules,"",cases,gold,10,mouse?3:touch?9:-1,
        mouse?"return 0.0+MOUSE_PAN();":"return 0.0+TOUCH_DOLLY_PAN();");
}

