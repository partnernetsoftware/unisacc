#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","ellipsecurve",0};
    const char *setup="let cx=ux_f64_put(0,3.0);let cy=ux_f64_put(8,0.0-1.0);"
        "let rx=ux_f64_put(16,2.0);let ry=ux_f64_put(24,1.0);"
        "let end=ux_f64_put(40,3.141592653589793);let turn=ux_f64_put(48,1.5707963267948966);"
        "let first=EllipseCurve_getPoint(128,0,0.0);let mid=EllipseCurve_getPoint(160,0,0.5);"
        "let last=EllipseCurve_getPoint(192,0,1.0);";
    const char *cases[]={"return ux_f64(first);","return ux_f64(first+8);","return ux_f64(mid);",
        "return ux_f64(mid+8);","return ux_f64(last);","return ux_f64(last+8);"};
    const double gold[]={3,1,2,-1,3,-3};
    return g_math_run("G_STRUCT EllipseCurve","ellipsecurve",modules,setup,cases,gold,6,
        mutate?1:-1,"return ux_f64(last+8);");
}
