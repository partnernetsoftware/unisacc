#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"f64-math","vector-scalar","orbitcontrols","orbitcontrols-pinch",0};
    const char *setup="let c=256;let eye=0;let target=64;let z=ux_f64_put(eye+16,10.0);"
        "let init=OrbitControls_init(c,eye,target,100.0);";
    #define RADIUS "let step=OrbitControls_step(c);return ux_f64(c+OrbitControls.radius);"
    const char *cases[]={
        "let motion=OrbitControls_pinch(c,20.0,40.0);" RADIUS,
        "let motion=OrbitControls_pinch(c,20.0,10.0);" RADIUS,
        "let speed=ux_f64_put(c+OrbitControls.zoomSpeed,2.0);let motion=OrbitControls_pinch(c,20.0,40.0);" RADIUS,
        "let min=ux_f64_put(c+OrbitControls.minRadius,7.0);let motion=OrbitControls_pinch(c,20.0,40.0);" RADIUS,
        "let first=OrbitControls_pinch(c,20.0,40.0);let next=OrbitControls_pinch(c,40.0,25.0);" RADIUS,
        "let stationary=OrbitControls_pinch(c,20.0,20.0);" RADIUS,
        "let overlap=OrbitControls_pinch(c,0.0,20.0);" RADIUS,
        "return 0.0+OrbitControls_pinch(c,0.0-1.0,20.0);",
    };
    const double gold[]={5,20,2.5,7,8,10,10,-1};
    return g_wasm_batch_addon("G_RAY OrbitControls pinch","orbitcontrols-pinch",
        argv[1],modules,setup,cases,gold,sizeof gold/sizeof gold[0],mutate?0:-1,
        "let motion=OrbitControls_pinch(c,40.0,20.0);" RADIUS);
}
