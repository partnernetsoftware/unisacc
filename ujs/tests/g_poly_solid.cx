#pragma unisa module g_poly_solid

static double root(double value) {
    if(value==0) return 0;
    double answer=value>1?value:1;
    for(int i=0;i<24;i++) answer=(answer+value/answer)*0.5;
    return answer;
}

static double atan_ratio(double ratio) {
    double sign=ratio<0?-1:1;
    double r=ratio*sign;
    int reciprocal=r>1;
    if(reciprocal) r=1/r;
    int rotation=r>0.414213562373095;
    if(rotation) r=(r-1)/(r+1);
    double sum=0, term=r;
    for(int j=1;j<=51;j+=2) { sum+=term/j; term*=-r*r; }
    if(rotation) sum+=0.7853981633974483096;
    if(reciprocal) sum=1.5707963267948966192-sum;
    return sign*sum;
}

static double bearing(double x,double y) {
    if(x==0) return y==0?0:(y<0?-1:1)*1.5707963267948966192;
    double base=atan_ratio(y/x);
    if(x<0) base+=(y<0?-1:1)*3.1415926535897932385;
    return base;
}

int g_poly_solid_gold(double *gold,const double *vertices,const int *triples,int count) {
    gold[0]=count;
    gold[1]=0;
    int at=2;
    for(int i=0;i<count;i+=3) {
        double p[3][3], center[3]={0};
        for(int k=0;k<3;k++) {
            const double *corner=vertices+3*triples[i+(k+1)%3];
            double scale=1/root(corner[0]*corner[0]+corner[1]*corner[1]+corner[2]*corner[2]);
            for(int j=0;j<3;j++) { p[k][j]=corner[j]*scale; center[j]+=p[k][j]; }
        }
        double n[3];
        for(int axis=0;axis<3;axis++) {
            int a=(axis+1)%3, b=(axis+2)%3;
            n[axis]=(p[1][a]-p[0][a])*(p[2][b]-p[0][b])-(p[2][a]-p[0][a])*(p[1][b]-p[0][b]);
        }
        double magnitude=root(n[0]*n[0]+n[1]*n[1]+n[2]*n[2]);
        double u[3], min=1, max=0;
        double face_angle=bearing(-center[0],center[2]);
        for(int j=0;j<3;j++) {
            double x=p[j][0], z=p[j][2];
            double angle=x==0 && z==0?face_angle:bearing(-x,z);
            u[j]=0.5+angle/6.2831853071795864769;
            if(face_angle<0 && u[j]==1) u[j]=0;
            if(u[j]<min) min=u[j];
            if(u[j]>max) max=u[j];
        }
        for(int j=0;j<3;j++) {
            for(int k=0;k<3;k++) gold[at++]=p[j][k];
            for(int k=0;k<3;k++) gold[at++]=n[k]/magnitude;
            gold[at++]=u[j]+(min<0.1 && max>0.9 && u[j]<0.2);
            double horizontal=root(p[j][0]*p[j][0]+p[j][2]*p[j][2]);
            gold[at++]=0.5+bearing(horizontal,p[j][1])/3.1415926535897932385;
        }
    }
    return at;
}
