#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int constructor=argc==2 && tx_eqz(argv[1],"--constructor-mutate");
    const int mapping=argc==2 && tx_eqz(argv[1],"--mapping-mutate");
    const int frames=argc==2 && tx_eqz(argv[1],"--frames-mutate");
    const int only_constructor=argc==2 && tx_eqz(argv[1],"--constructor");
    const int only_mapping=argc==2 && tx_eqz(argv[1],"--mapping");
    const int only_open=argc==2 && tx_eqz(argv[1],"--frames-open");
    const int only_other=argc==2 && tx_eqz(argv[1],"--frames-other");
    if(argc!=1 && !constructor && !mapping && !frames &&
       !only_constructor && !only_mapping && !only_open && !only_other) return 2;
    const char *modules[]={"f64-math","geometry-frames","curve","curve-frames","linecurve3-class",0};
    const char *constructor_setup=
        "let first=frame_put(512,0.0,0.0,0.0);let last=frame_put(536,0.0,0.0,8.0);"
        "let line=LineCurve3_init(32,first,last);let defaults=LineCurve3_init(96,0-1,0-1);"
        "let partial=LineCurve3_init(160,first,0-1);let same=LineCurve3_init(224,first,first);"
        "let defaultPoint=LineCurve3_sample(768,defaults,0.75);";
    const char *map_setup=
        "let first=frame_put(512,0.0,0.0,0.0);let last=frame_put(536,0.0,0.0,8.0);"
        "let line=LineCurve3_init(32,first,last);let defaults=LineCurve3_init(96,0-1,0-1);"
        "let cache=CurveArcCache_init(600,1024,201);let scratch=704;"
        "let defcache=CurveArcCache_init(640,3072,201);";
    const char *axis_setup=
        "let first=frame_put(512,0.0,0.0,0.0);let last=frame_put(536,0.0,0.0,16.0);"
        "let line=LineCurve3_init(32,first,last);"
        "let open=LineCurve3_computeFrenetFrames(5120,line,2,0,5504);";
    const char *frames_setup=
        "let first=frame_put(512,0.0,0.0,0.0);let last=frame_put(536,0.0,0.0,16.0);"
        "let line=LineCurve3_init(32,first,last);let defaults=LineCurve3_init(96,0-1,0-1);"
        "let a=frame_put(832,1.0,2.0,3.0);let b=frame_put(864,3.0,5.0,9.0);"
        "let diag=LineCurve3_init(320,a,b);";
    const char *cases[]={
        "return ux_u32(line+LineCurve3Record.arcLengthDivisions);",
        "return ux_u32(line+LineCurve3Record.v1)==first;",
        "return ux_u32(line+LineCurve3Record.v2)==last;",
        "return ux_u32(defaults+LineCurve3Record.v1)!=ux_u32(defaults+LineCurve3Record.v2);",
        "return curve_frame_dot(defaultPoint,defaultPoint);",
        "return ux_u32(partial+LineCurve3Record.v1)==first && ux_u32(partial+LineCurve3Record.v2)!=first;",
        "return ux_u32(same+LineCurve3Record.v1)==ux_u32(same+LineCurve3Record.v2);",
        "let table=LineCurve3_getArcLengths(line,cache,scratch,0);return LineCurve3_getUtoTmapping(line,table,0.25,0.0);",
        "let table=LineCurve3_getArcLengths(line,cache,scratch,0);return LineCurve3_getUtoTmapping(line,table,0.25,6.0);",
        "let table=LineCurve3_getArcLengths(line,cache,scratch,0);return LineCurve3_getUtoTmapping(line,table,0.25,0.0);",
        "let table=LineCurve3_getArcLengths(line,cache,scratch,0);return LineCurve3_getUtoTmapping(line,table,0.25,0.0/0.0);",
        "let table=LineCurve3_getArcLengths(line,cache,scratch,0);let outside=LineCurve3_getUtoTmapping(line,table,0.25,9.0);return outside!=outside;",
        "let table=LineCurve3_getArcLengths(defaults,defcache,scratch,0);return LineCurve3_getUtoTmapping(defaults,table,0.75,0.0);",
        "let set=ux_u32_put(defaults+LineCurve3Record.arcLengthDivisions,3);"
            "let table=LineCurve3_getArcLengths(defaults,defcache,scratch,0);return LineCurve3_getUtoTmapping(defaults,table,0.75,0.0);",
        "let move=ux_f64_put(last+16,16.0);let sampled=LineCurve3_sample(736,line,0.5);return ux_f64(sampled+16);",
        "let table=LineCurve3_getArcLengths(line,cache,scratch,0);let move=ux_f64_put(last+16,16.0);"
            "return LineCurve3_getUtoTmapping(line,table,0.25,4.0);",
        "let before=LineCurve3_getArcLengths(line,cache,scratch,0);let move=ux_f64_put(last+16,16.0);"
            "let table=LineCurve3_getArcLengths(line,cache,scratch,1);"
            "return LineCurve3_getUtoTmapping(line,table,0.25,4.0);",
        "return (open==5120)*3;",
        "return ux_f64(open);","return ux_f64(open+8);","return ux_f64(open+16);",
        "return ux_f64(open+96);","return ux_f64(open+104);","return ux_f64(open+112);",
        "return ux_f64(open+192);","return ux_f64(open+200);","return ux_f64(open+208);",
        "let diagonal=LineCurve3_computeFrenetFrames(6272,diag,2,0,5504);return ux_f64(diagonal+144);","let diagonal=LineCurve3_computeFrenetFrames(6272,diag,2,0,5504);return ux_f64(diagonal+152);","let diagonal=LineCurve3_computeFrenetFrames(6272,diag,2,0,5504);return ux_f64(diagonal+160);",
        "let diagonal=LineCurve3_computeFrenetFrames(6272,diag,2,0,5504);return ux_f64(diagonal+168);","let diagonal=LineCurve3_computeFrenetFrames(6272,diag,2,0,5504);return ux_f64(diagonal+200);",
        "let closed=LineCurve3_computeFrenetFrames(5632,line,2,1,5504);return ux_f64(closed+176);","let closed=LineCurve3_computeFrenetFrames(5632,line,2,1,5504);return ux_f64(closed+192);",
        "let singular=LineCurve3_computeFrenetFrames(5888,defaults,2,1,5504);return curve_frame_dot(singular+72,singular+72);",
        "let singular=LineCurve3_computeFrenetFrames(5888,defaults,2,1,5504);return curve_frame_dot(singular+168,singular+168);",
        "let singular=LineCurve3_computeFrenetFrames(5888,defaults,2,1,5504);return curve_frame_dot(singular+192,singular+192);",
        "let one=LineCurve3_computeFrenetFrames(6144,line,0,0,5504);return one==6144;",
        "let one=LineCurve3_computeFrenetFrames(6144,line,0,0,5504);return ux_f64(one+16);",
        "let one=LineCurve3_computeFrenetFrames(6144,line,0,0,5504);return ux_f64(one+32);"
    };
    const double gold[]={
        200,1,1,1,0,1,1,0.25,0.75,0.25,0.25,1,0.5,1.0/3,8,0.5,0.25,
        3,0,0,1,0,-1,0,1,0,0,2.0/7,3.0/7,6.0/7,
        -0.9583148474999099,-0.8944271909999159,-1,1,0,0,0,1,1,-1
    };
    const int mutant=constructor?1:mapping?8:frames?24:-1;
    const char *replacement=constructor?"let swapped=LineCurve3_init(416,last,first);return ux_u32(swapped+LineCurve3Record.v1)==first;":
        mapping?"let table=LineCurve3_getArcLengths(line,cache,scratch,0);return LineCurve3_getUtoTmapping(line,table,0.25,0.0);":"let reverse=LineCurve3_init(416,last,first);"
        "let moved=LineCurve3_computeFrenetFrames(5632,reverse,2,0,5504);return ux_f64(moved+192);";
    const int count=sizeof gold/sizeof gold[0];
    const char *label="G_STRUCT LineCurve3 class", *fixture="linecurve3-class";
    if(constructor || only_constructor) return g_math_run_range(label,fixture,modules,constructor_setup,cases,gold,count,0,7,mutant,replacement);
    if(mapping || only_mapping) return g_math_run_range(label,fixture,modules,map_setup,cases,gold,count,7,17,mutant,replacement);
    if(frames || only_open) return g_math_run_range(label,fixture,modules,axis_setup,cases,gold,count,17,27,mutant,replacement);
    if(only_other) return g_math_run_range(label,fixture,modules,frames_setup,cases,gold,count,27,count,-1,0);
    return g_math_run_range(label,fixture,modules,constructor_setup,cases,gold,count,0,7,-1,0) ||
        g_math_run_range(label,fixture,modules,map_setup,cases,gold,count,7,17,-1,0) ||
        g_math_run_range(label,fixture,modules,axis_setup,cases,gold,count,17,27,-1,0) ||
        g_math_run_range(label,fixture,modules,frames_setup,cases,gold,count,27,count,-1,0);
}
