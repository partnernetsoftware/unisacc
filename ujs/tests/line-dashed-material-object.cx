#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define FIX "ujs/practice/uxe/test/"

enum { width=32, count=229 };

static int event_layout(const char *file) {
    unsigned char *raw=0;
    int64_t bytes=0;
    if(sy_read_file(BASE "object-layouts.ujs",&raw,&bytes,20000)) return 1;
    const char *text=(const char *)raw;
    const char anchor[]="struct EventDispatcher {";
    const long start=tx_find(text,bytes,anchor,sizeof anchor-1);
    const long end=start<0?-1:tx_find(text+start,bytes-start,"\n}\n",3);
    const int failed=end<0 || sy_write_file(file,text+start,end+3,0600);
    mm_free(raw);
    return failed;
}

static int expected(double *gold) {
    const double objects[][9]={
        {1,3,1,0xffffff,1,0,0,0,17},
        {1.25,2.75,.625,0x3366cc,.25,.5,2,3,19},
        {1.25,2.75,.625,0x3366cc,.25,.5,2,1,21},
        {2,4,2,0xff0000,.25,.5,2,1,17},
        {1.25,2.75,.625,0x3366cc,.25,.5,2,1,23},
        {1.25,2.75,.625,0x3366cc,.25,.5,2,1,23},
    };
    const int events[]={1,17,41, 1,19,43, 0,21,0, 1,21,47, 1,21,47};
    int at=0;
    // The shared UJS decimal reader takes a different rounding path than
    // JSON.parse for some fractions. Keep its actual binary64 values visible.
    const double ujs_loaded[]={1.2500000000000002,2.7500000000000004,0.62500000000000011,
        0x3366cc,0.25000000000000006,.5,2,1,23};
    for(int side=0;side<2;side++) {
        for(int object=0;object<6;object++) for(int field=0;field<9;field++) {
            gold[at++]=side==0 && object>=4?ujs_loaded[field]:objects[object][field];
        }
        for(int i=0;i<15;i++) gold[at++]=events[i];
    }
    for(int field=0;field<9;field++) gold[at++]=objects[4][field];
    for(int i=0;i<8;i++) {
        gold[at++]=-1;
        gold[at++]=1;
    }
    for(int side=0;side<2;side++) for(int x=0;x<width;x++) {
        gold[at++]=x>=2 && x<30 && (15+20*(x-2))%54<=44?0x3366cc:0;
    }
    gold[at++]=0;
    gold[at++]=0;
    return at;
}

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[420],abi[320],layout[320],wasm[320],url[850];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-dashed-object-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(layout,sizeof layout,"%s/event.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/dashed.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,"file://%s/" FIX "line-dashed-material-object-r160.html?wasm=%s&mode=%d",
        cwd,wasm,mutate);
    const char signature[]="import host_gpu_submit from \"uxe_gpu_v1\"(i64,i64) i64;\n"
        "export uxe_dash_object(op:i64,arg:i64,mutate:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,layout,BASE "record-copy.ujs",
        BASE "eventdispatcher.ujs",BASE "material-class.ujs",BASE "json-bytes.ujs",BASE "json-read.ujs",
        BASE "loaderutils.ujs",BASE "json-string-decode.ujs",BASE "material-field-json.ujs",BASE "material-field-read.ujs",
        BASE "material-fields-generated.ujs",BASE "material-set-values.ujs",BASE "gpu-packet.ujs",
        BASE "line-dashed-material.ujs",BASE "line-dashed-material-object.ujs",
        BASE "line-dashed-material-object-json.ujs",FIX "line-dashed-material-object-probe.ujs","-o",wasm,0};
    double gold[count],actual[count]={0};
    int failed=length<=0 || length>=(int)sizeof url || expected(gold)!=count ||
        sy_write_file(abi,signature,sizeof signature-1,0600) || event_layout(layout);
    if(!failed) {
        char *out=0;
        size_t bytes=0;
        const int rc=cx_runv_timeout(compile,6,&out,&bytes);
        if(rc) { printf("DASHED_OBJECT compile_rc=%d %.*s\n",rc,(int)bytes,out?out:""); failed=1; }
        mm_free(out);
    }
    if(!failed) failed=r160_wait_read(url,"#r160",actual,count,dir);
    if(!failed) {
        for(int i=0;i<count;i++) if(actual[i]!=gold[i]) {
            printf("DASHED_OBJECT case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
            failed++;
        }
        printf("DASHED_OBJECT framebuffer_pixels=1024 different=%.17g alpha_errors=%.17g\n",actual[count-2],actual[count-1]);
    }
    if(sy_remove_all(dir)) failed++;
    printf("G_STRUCT LineDashedMaterial public cases=%d failed=%d\n",count,failed);
    return failed!=0;
}
