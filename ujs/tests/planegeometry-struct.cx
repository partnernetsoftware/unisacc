#pragma unisa use g_geometry
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"geometry-buffers","planegeometry",0};
    char source[512];
    tx_snprintf(source,sizeof source,"let mesh=GeometryBuffers_init(0,256,6,1024,12);"
        "return PlaneGeometry_generate(mesh,%d.0,2.0,2,1);",mutate?5:4);
    const double gold[]={
        6,12,
        -2, 1,0, 0,0,1, 0,1,  0, 1,0, 0,0,1, .5,1,  2, 1,0, 0,0,1, 1,1,
        -2,-1,0, 0,0,1, 0,0,  0,-1,0, 0,0,1, .5,0,  2,-1,0, 0,0,1, 1,0,
        0,3,1,3,4,1, 1,4,2,4,5,2
    };
    return g_geometry_check("PlaneGeometry","planegeometry",modules,source,gold,
        sizeof gold/sizeof gold[0],50);
}
