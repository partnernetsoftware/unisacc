#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","animation-view","discreteinterpolant","keyframe-track","booleankeyframetrack",0};
    const char *setup=
        "let a=ux_f32_put(64,0.0);let b=ux_f32_put(68,2.0);let c=ux_f32_put(72,4.0);"
        "let d=ux_u32_put(132,1);let name=ux_u8_put(100,120);"
        "let samples=AnimationSamples_init(0,64,128,3,1);let track=BooleanKeyframeTrack_init(32,100,1,samples);";
    const char *cases[]={
        "return KeyframeTrack_getInterpolation(track);",
        "let t=BoolTrack_setInterpolation(track,2301);return KeyframeTrack_getInterpolation(t);",
        "let p=BoolTrack_evaluate(track,1.99,192);return ux_u32(p);",
        "let p=BoolTrack_evaluate(track,2.0,192);return ux_u32(p);",
        "let a=ux_u32_put(132,2);return BoolTrack_evaluate(track,2.0,192);",
        "return BoolTrack_evaluate(track,2.0,132);"
    };
    const double gold[]={2300,2300,0,1,-2,-1};
    return g_math_run("G_ANIM BooleanKeyframeTrack","booleankeyframetrack",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let p=BoolTrack_evaluate(track,1.99,192);return ux_u32(p);");
}
