#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"helper-buffers","box3helper","boxhelper",0};
    const char *setup="let helper=0;let box=128;let xyz=256;let index=384;"
        "let ax=ux_f64_put(box,0.0-2.0);let ay=ux_f64_put(box+8,2.0);let az=ux_f64_put(box+16,1.0);"
        "let bx=ux_f64_put(box+24,6.0);let by=ux_f64_put(box+32,8.0);let bz=ux_f64_put(box+40,3.0);"
        "let init=BoxHelper_init(helper,box,xyz,index,16776960);";
    const char *cases[]={
        "return ux_f32(xyz);",
        "return ux_f32(xyz+12);",
        "return ux_f32(xyz+56);",
        "return 0.0+ux_u16(index+46);",
        "return ux_f64(helper+BoxHelper.centerX);",
        "return ux_f64(helper+BoxHelper.centerY);",
        "return ux_f64(helper+BoxHelper.radius);",
        "return 0.0+ux_u32(helper+BoxHelper.color);",
        "return 0.0+ux_u32(helper+BoxHelper.positionVersion);",
        "let a=ux_f64_put(box+24,9.0);let up=BoxHelper_update(helper);return ux_f32(xyz);",
        "let a=ux_f64_put(box,10.0);let up=BoxHelper_update(helper);return ux_f32(xyz);",
        "let a=ux_f64_put(box,10.0);let up=BoxHelper_update(helper);return 0.0+ux_u32(helper+BoxHelper.positionVersion);",
        "let gone=BoxHelper_dispose(helper);return 0.0+ux_u32(helper+BoxHelper.active);",
        "let gone=BoxHelper_dispose(helper);return 0.0+BoxHelper_update(helper);",
        "return 0.0+BoxHelper_init(helper,box,xyz,xyz,16776960);",
    };
    const double gold[]={6,-2,1,7,2,5,5.0990195135927845,16776960,1,9,6,1,0,-1,-1};
    return g_wasm_batch("G_STRUCT BoxHelper","boxhelper",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,"return ux_f32(xyz);");
}
