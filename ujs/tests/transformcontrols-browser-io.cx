#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

typedef struct {
    sy_child_t child;
    long deadline;
    int id,at,size;
    char stream[4096],reply[8192],session[112];
} Browser;

static const char *field(const char *reply,const char *key) {
    const long size=tx_len(reply,8192), width=tx_len(key,100);
    for(long i=0;i+width<=size;i++) if(tx_prefix(reply+i,size-i,key,width)) return reply+i+width;
    return 0;
}

static int id_text(const char *at,char out[97]) {
    if(!at) return 0;
    for(int i=0;i<97 && at[i];i++) {
        if(at[i]=='"') { out[i]=0; return i>0; }
        out[i]=at[i];
    }
    return 0;
}

static int receive(Browser *browser) {
    for(int i=0;i<(int)sizeof browser->reply;i++) {
        if(browser->at==browser->size) {
            const long remain=browser->deadline-sy_now_ms();
            if(remain<=0 || sy_readable(browser->child.out_fd,remain)<=0) return 0;
            browser->size=sy_read(browser->child.out_fd,browser->stream,sizeof browser->stream);
            browser->at=0;
            if(browser->size<=0) return 0;
        }
        const char byte=browser->stream[browser->at++];
        browser->reply[i]=byte;
        if(byte==0) return 1;
    }
    return 0;
}

static int send(Browser *browser,const char *method,const char *params) {
    char command[1500];
    const int id=++browser->id;
    const int bytes=tx_snprintf(command,sizeof command,
        "{\"id\":%d,\"method\":\"%s\",\"params\":%s%s}",id,method,params,browser->session);
    if(bytes<1 || bytes>=(int)sizeof command || sy_write_all(browser->child.in_fd,command,bytes+1)) return 0;
    while(sy_now_ms()<browser->deadline && receive(browser)) {
        const char *received=field(browser->reply,"\"id\":");
        if(received && tx_strtol(received,0,10)==id) return field(browser->reply,"\"error\":")==0;
    }
    return 0;
}

static int evaluate(Browser *browser,const char *expression) {
    char params[700];
    tx_snprintf(params,sizeof params,"{\"expression\":\"%s\"}",expression);
    return send(browser,"Runtime.evaluate",params);
}

static int ready(Browser *browser) {
    for(int i=0;i<100 && sy_now_ms()<browser->deadline;i++) {
        if(!evaluate(browser,"document.querySelector('#ready')?.textContent") ||
           field(browser->reply,"\"value\":\"fail:")) return 0;
        if(field(browser->reply,"\"value\":\"ready\"")) return 1;
        sy_sleep_ms(50);
    }
    return 0;
}

static int mouse(Browser *browser,const char *type,int x,int y,int held) {
    char params[240];
    const char *button=tx_eqz(type,"mouseMoved") && !held?"none":"left";
    tx_snprintf(params,sizeof params,
        "{\"type\":\"%s\",\"button\":\"%s\",\"clickCount\":1,\"x\":%d,\"y\":%d,\"buttons\":%d}",type,button,x,y,held);
    return send(browser,"Input.dispatchMouseEvent",params);
}

typedef struct { const char *type,*event,*gold; int dx,dy,held; } Gesture;
static int drag(Browser *browser,int side,int center) {
    const Gesture points[]={
        {"mouseMoved","pointermove","[0,0,0,0,0,0]",0,-80,0},
        {"mouseMoved","pointermove","[0,0,1,0,0,0]",24,3,0},
        {"mousePressed","pointerdown","[0,1,1,1,0,0]",24,3,1},
        {"mouseMoved","pointermove","[0.75,1,1,1,1,0]",44,3,1},
        {"mouseReleased","pointerup","[0.75,0,0,1,1,1]",44,3,0},
        {"mouseMoved","pointermove","[0.75,0,0,1,1,1]",0,-80,0},
    };
    for(int i=0;i<(int)(sizeof points/sizeof points[0]);i++) {
        const Gesture step=points[i];
        char expression[180];
        const int x=center+step.dx,y=144+step.dy;
        tx_snprintf(expression,sizeof expression,"compareTransform(%d,%s,'%s',%d,%d)",side,step.gold,step.event,x,y);
        int delivered=mouse(browser,step.type,x,y,step.held);
        for(int attempt=0;delivered && attempt<20;attempt++) {
            delivered=evaluate(browser,expression);
            if(!delivered || !field(browser->reply,"\"value\":\"pending\"")) break;
            sy_sleep_ms(20);
        }
        if(!delivered || !field(browser->reply,"\"value\":\"pass\"")) {
            printf("TRANSFORM_BROWSER side=%d step=%d reply=%s\n",side,i,browser->reply);
            return 0;
        }
    }
    return 1;
}

static int exercise(Browser *browser,const char *url) {
    char target[97],session[97],params[1050];
    tx_snprintf(params,sizeof params,"{\"url\":\"%s\"}",url);
    if(!send(browser,"Target.createTarget",params) || !id_text(field(browser->reply,"\"targetId\":\""),target)) return 0;
    tx_snprintf(params,sizeof params,"{\"targetId\":\"%s\",\"flatten\":true}",target);
    if(!send(browser,"Target.attachToTarget",params) || !id_text(field(browser->reply,"\"sessionId\":\""),session)) return 0;
    tx_snprintf(browser->session,sizeof browser->session,",\"sessionId\":\"%s\"",session);
    if(!send(browser,"Page.bringToFront","{}") || !ready(browser)) {
        printf("TRANSFORM_BROWSER fixture reply=%s\n",browser->reply);
        return 0;
    }
    return drag(browser,1,448) && drag(browser,0,144);
}

static int run_browser(const char *url,const char *dir) {
    char profile[350];
    tx_snprintf(profile,sizeof profile,"--user-data-dir=%s/chrome",dir);
    char *argv[]={"sh","-c","exec google-chrome \"$@\" 3<&0 4>&1 1>/dev/null","transform-pipe",
        "--headless=new","--disable-background-networking","--no-first-run","--allow-file-access-from-files",
        "--remote-debugging-pipe","--force-device-scale-factor=1","--window-size=900,520",profile,"about:blank",0};
    Browser browser={0};
    sy_spawn_t launch; sy_exit_t ended;
    sy_spawn_init(&launch);
    launch.argv=argv; launch.in_fd=SY_STDIO_PIPE; launch.out_fd=SY_STDIO_PIPE; launch.err_fd=SY_STDIO_NULL;
    launch.pgroup=-1; launch.deadline_ms=17000;
    if(sy_proc_spawn(&launch,&browser.child)) return 1;
    browser.deadline=sy_now_ms()+15000;
    const int failed=!exercise(&browser,url);
    sy_close(browser.child.in_fd);
    sy_close(browser.child.out_fd);
    sy_proc_kill(&browser.child,9);
    sy_proc_wait(&browser.child,&ended);
    printf("G_RAY TransformControls trusted X drag stages=6 failed=%d\n",failed);
    return failed;
}

static int build(const char *source,const char *wasm,int mutate) {
    const char *modules[]={"transformcontrols-translate","transformcontrols-pointer-x",0};
    char program[25000]="export uxe_transform_x(action:i64,id:i64,x:f64,y:f64) f64 version 1;\n";
    int used=tx_len(program,sizeof program);
    for(int i=0;modules[i];i++) {
        char path[192]; unsigned char *body=0; int64_t size=0;
        tx_snprintf(path,sizeof path,"ujs/practice/uxe/base/%s.ujs",modules[i]);
        if(sy_read_file(path,&body,&size,sizeof program-used-2)) return 1;
        const int n=tx_snprintf(program+used,sizeof program-used,"%s\n",body);
        mm_free(body);
        if(n<0 || n>=(int)sizeof program-used) return 1;
        used+=n;
    }
    const int n=tx_snprintf(program+used,sizeof program-used,
        "let state=256;if(action==10){return 0.0+TransformControls_initX(state,128.0,128.0,32.0,8.0,24.0,4.0,%s);}"
        "if(action==20){return ux_f64(state+TransformXInput.position);}"
        "if(action==21){return 0.0+ux_u32(state+TransformXInput.dragging);}"
        "if(action==22){return 0.0+ux_u32(state+TransformXInput.hover);}"
        "if(action==23){return 0.0+ux_u32(state+TransformXInput.starts);}"
        "if(action==24){return 0.0+ux_u32(state+TransformXInput.moves);}"
        "if(action==25){return 0.0+ux_u32(state+TransformXInput.ends);}"
        "return 0.0+TransformControls_pointerX(state,action,id,x,y);\n",mutate?"0.0":"0.25");
    if(n<=0 || n>=(int)sizeof program-used || sy_write_file(source,program,used+n,0600)) return 1;
    char *argv[]={"./ujs/ujs2wasm.com",(char*)source,"-o",(char*)wasm,0},*out=0; size_t bytes=0;
    int rc=cx_runv_timeout(argv,6,&out,&bytes);
    if(rc) printf("TRANSFORM_BROWSER compile_rc=%d\n",rc);
    mm_free(out);
    return rc!=0;
}

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if((argc!=2 && !mutate) || argv[1][0]!='/') return 2;
    for(int i=0;argv[1][i];i++) {
        const char c=argv[1][i];
        if(i>=180 || !((c>='A' && c<='Z') || (c>='a' && c<='z') ||
            (c>='0' && c<='9') || c=='-' || c=='_' || c=='/' || c=='.')) return 2;
    }
    char cwd[390],dir[256],source[290],wasm[290],url[950];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-transform-",dir,sizeof dir)) return 2;
    tx_snprintf(source,sizeof source,"%s/probe.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/probe.wasm",dir);
    const int n=tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/transformcontrols-browser.html?package=%s&wasm=%s",
        cwd,argv[1],wasm);
    int failed=n<=0 || n>=(int)sizeof url || build(source,wasm,mutate) || run_browser(url,dir);
    char *clean[]={"rm","-rf","--",dir,0},*out=0; size_t bytes=0;
    if(cx_runv_timeout(clean,4,&out,&bytes)) failed=1;
    mm_free(out);
    return failed;
}
