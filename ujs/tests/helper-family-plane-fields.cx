#pragma unisa use g_math
#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

static const char source[]=
    "export uxe_plane_fields(mutate:i64) i64 version 1;\n";
static const char probe[]=
    "let src=PlaneHelper_init(0,128,256,4.0,16776960);"
    "let dst=PlaneHelper_init(512,576,704,3.0,255);"
    "let applied=PlaneHelper_setFields(src,8.0+mutate,1193046);"
    "let end=PlaneHelper_fieldsToJSON(src,1000,1200,2000);"
    "let restored=PlaneHelper_fieldsFromJSON(dst,1000,end,2000);"
    "let updated=PlaneHelper_updateMatrixWorld(dst,832,0.0,0.0,1.0,2.0);"
    "if(src!=0 || dst!=512 || applied!=0 || end<0 || restored!=512 || updated!=512) { return 0-1; }"
    "let hash=0;let i=1000;while(i<end){hash=(hash*131+ux_u8(i))%16777213;i=i+1;}"
    "let sum=ux_f64_put(4096,0.0+hash);let n=ux_f64_put(4104,0.0+end-1000);"
    "let size=ux_f64_put(4112,ux_f64(dst+PlaneHelper.sizeValue));"
    "let rgb=ux_f64_put(4120,0.0+ux_u32(dst+PlaneHelper.color));"
    "let x=ux_f64_put(4128,ux_f64(832));let y=ux_f64_put(4136,ux_f64(872));"
    "let z=ux_f64_put(4144,ux_f64(944));"
    "let refs=ux_f64_put(4152,0.0+(ux_u32(dst+PlaneHelper.outline)==576 && ux_u32(dst+PlaneHelper.fill)==704));"
    "let invalid=[123,34,115,105,122,101,34,58,50,44,34,99,111,108,111,114,34,58,49,46,53,125];"
    "i=0;while(i<22){let w=ux_u8_put(1400+i,invalid[i]);i=i+1;}"
    "let bad=PlaneHelper_fieldsFromJSON(dst,1400,1422,2000);"
    "let truncated=PlaneHelper_fieldsFromJSON(dst,1000,end-1,2000);"
    "let valid=bad==0-1 && truncated==0-1 && ux_f64(dst+PlaneHelper.sizeValue)==8.0+mutate &&"
    "ux_u32(dst+PlaneHelper.color)==1193046;"
    "let reject=ux_f64_put(4160,0.0+valid);"
    "let out_alias=PlaneHelper_fieldsToJSON(dst,576,620,2000);"
    "let scratch_alias=PlaneHelper_fieldsFromJSON(dst,1000,end,704);"
    "let small=PlaneHelper_fieldsToJSON(dst,1600,1605,2000);"
    "let guards=ux_f64_put(4168,0.0+(out_alias==0-1 && scratch_alias==0-1 && small==0-1));"
    "let released=PlaneHelper_dispose(dst);"
    "let closed=PlaneHelper_fieldsFromJSON(dst,1000,end,2000);"
    "let gone=ux_f64_put(4176,0.0+(released==0 && closed==0-1));"
    "return 0;";

static const char page[]=
    "<!doctype html><meta charset=utf-8><pre id=result>pending</pre><script type=module>\n"
    "import { Plane, PlaneHelper, REVISION, Vector3 } from './three.module.js';\n"
    "const result=document.querySelector('#result');try {"
    "if(REVISION!=='160') throw Error('revision');"
    "const req=new XMLHttpRequest();req.open('GET','probe.wasm',false);"
    "req.overrideMimeType('text/plain; charset=x-user-defined');req.send();"
    "const bytes=Uint8Array.from(req.responseText,c=>c.charCodeAt(0)&255);"
    "const api=new WebAssembly.Instance(new WebAssembly.Module(bytes)).exports;"
    "const status=api.uxe_plane_fields(BigInt(new URLSearchParams(location.search).get('mutate')));"
    "const native=new Float64Array(api.memory.buffer,2097152+4096,11);"
    "const original=new PlaneHelper(new Plane(),4,0xffff00);"
    "original.size=8;original.material.color.setHex(0x123456);"
    "original.children[0].material.color.setHex(0x123456);"
    "const text=JSON.stringify({size:original.size,color:original.material.color.getHex()});"
    "let hash=0;for(const c of new TextEncoder().encode(text))hash=(hash*131+c)%16777213;"
    "const target=new PlaneHelper(new Plane(new Vector3(0,0,1),2),3,255);"
    "const decoded=JSON.parse(text);target.size=decoded.size;"
    "target.material.color.setHex(decoded.color);target.children[0].material.color.setHex(decoded.color);"
    "target.updateMatrixWorld();const matrix=target.matrixWorld.elements;"
    "result.textContent=JSON.stringify([Number(status),...native,hash,text.length,target.size,"
    "target.material.color.getHex(),target.children[0].material.color.getHex(),matrix[0],matrix[5],matrix[14]]);"
    "} catch(e) {result.textContent='error:'+String(e);}</script>\n";

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[240],abi[290],body[290],wasm[290],html[290],three[290],url[350];
    if(sy_mkdtemp("/tmp","uxe-plane-fields-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(body,sizeof body,"%s/probe.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/probe.wasm",dir);
    tx_snprintf(html,sizeof html,"%s/probe.html",dir);
    tx_snprintf(three,sizeof three,"%s/three.module.js",dir);
    tx_snprintf(url,sizeof url,"file://%s?mutate=%d",html,mutate);
    char *compile[]={"./ujs/ujs2wasm.com",abi,"ujs/practice/uxe/base/helper-geometry.ujs",
        "ujs/practice/uxe/base/planehelper.ujs","ujs/practice/uxe/base/json-bytes.ujs",
        "ujs/practice/uxe/base/json-read.ujs","ujs/practice/uxe/base/helper-family-plane-fields.ujs",
        body,"-o",wasm,0};
    const char json[]="{\"size\":8,\"color\":1193046}";
    uint64_t hash=0;
    for(int i=0;json[i];i++) hash=(hash*131+(unsigned char)json[i])%16777213;
    const double bytes=sizeof json-1;
    const double gold[]={0,(double)hash,bytes,8,1193046,4,4,-2,1,1,1,1,
        (double)hash,bytes,8,1193046,1193046,4,4,-2};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    char *log=0;
    size_t size=0;
    int failed=sy_write_file(abi,source,sizeof source-1,0600) ||
        sy_write_file(body,probe,sizeof probe-1,0600) ||
        sy_write_file(html,page,sizeof page-1,0600) ||
        sy_copy("ujs/practice/web/game/three.module.js",three,0600);
    if(!failed) {
        int rc=cx_runv_timeout(compile,6,&log,&size);
        if(rc) { printf("G_STRUCT PlaneHelper fields compile_rc=%d %s\n",rc,log?log:""); failed=1; }
        mm_free(log);
        log=0;
    }
    if(!failed) failed=r160_wait_read(url,"#result",actual,count,dir);
    if(!failed) for(int i=0;i<count;i++) if(!g_math_near(actual[i],gold[i],1e-9)) {
        printf("G_STRUCT PlaneHelper fields case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
        failed++;
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&log,&size)) failed++;
    mm_free(log);
    printf("G_STRUCT PlaneHelper fields cases=%d failed=%d\n",count,failed);
    return failed!=0;
}
