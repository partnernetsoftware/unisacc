#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","animation-view","discreteinterpolant","linearinterpolant",
        "cubicinterpolant","keyframe-track","numberkeyframetrack","vectorkeyframetrack",0};
    const char *setup=
        "let a=ux_f32_put(64,0.0);let b=ux_f32_put(68,2.0);let c=ux_f32_put(72,4.0);"
        "let d=ux_f32_put(132,4.0);let e=ux_f32_put(136,8.0);let f=ux_f32_put(140,12.0);"
        "let g=ux_f32_put(148,4.0);let name=ux_u8_put(100,120);"
        "let samples=AnimationSamples_init(0,64,128,3,2);let track=KeyframeTrack_init(32,100,1,samples);";
    const char *cases[]={
        "let p=VectorKeyframeTrack_evaluate(track,1.0,192);return ux_f32(p);",
        "let p=VectorKeyframeTrack_evaluate(track,1.0,192);return ux_f32(p+4);",
        "let t=KeyframeTrack_setInterpolation(track,2300);let p=VectorKeyframeTrack_evaluate(t,1.0,192);return ux_f32(p+4);",
        "let t=KeyframeTrack_setInterpolation(track,2302);let p=VectorKeyframeTrack_evaluate(t,1.0,192);return ux_f32(p);",
        "return VectorKeyframeTrack_evaluate(track,1.0,96);"
    };
    const double gold[]={4,8,4,5,-1};
    return g_math_run("G_ANIM VectorKeyframeTrack","vectorkeyframetrack",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let p=VectorKeyframeTrack_evaluate(track,1.0,192);return ux_f32(p);");
}
