#pragma unisa use g_cylinder
#pragma unisa use g_geometry
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","geometry-buffers","cylindergeometry",0};
    char source[640];
    tx_snprintf(source,sizeof source,"let mesh=GeometryBuffers_init(0,256,28,2048,48);"
        "let config=CylinderGeometry_init(4096,1.0,1.0,%d.0,0.0,6.283185307179586,4.0,1.0,0.0);"
        "return CylinderGeometry_generate(mesh,config);",mutate?3:2);
    double gold[274];
    int count=g_cylinder_gold(gold,0);
    return g_geometry_check("CylinderGeometry","cylindergeometry",modules,source,gold,count,226);
}
