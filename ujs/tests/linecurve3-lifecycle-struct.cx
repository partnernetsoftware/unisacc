#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    if(argc!=3 || argv[2][0]!='/') return 2;
    const int construct=tx_eqz(argv[1],"--construct");
    const int verify=tx_eqz(argv[1],"--verify");
    const int identity=tx_eqz(argv[1],"--identity-mutate");
    const int json=tx_eqz(argv[1],"--json-mutate");
    if(!construct && !verify && !identity && !json) return 2;
    const char *wasm=argv[2];
    char dir[256],cwd[390],abi[300],body[300],consumer[300],probe[300],url[1400];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-lc3-lifecycle-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(body,sizeof body,"%s/entry.ujs",dir);
    tx_snprintf(consumer,sizeof consumer,"%s/consumer.ujs",dir);
    tx_snprintf(probe,sizeof probe,"%s/consumer.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/ujs/practice/uxe/test/linecurve3-lifecycle-r160.html?wasm=%s&probe=%s%s",
        cwd,wasm,probe,identity?"&mutate=identity":json?"&mutate=json":"");
    const char signature[]="export uxe_lc3_lifecycle(op:i64,x:i64) i64 version 1;\n";
    const char entry[]=
        "let src=32;let dest=128;let clone=224;let raw=896;let sample=960;let samples=1016;"
        "let srcCache=640;let destCache=672;let srcTable=704;let destTable=768;"
        "if(op==0){"
        "  let a=frame_put(512,1.0,2.0,3.0);let b=frame_put(536,1.0,2.0,11.0);"
        "  let c=frame_put(576,0.0,0.0,0.0);let d=frame_put(600,0.0,0.0,4.0);"
        "  let e=LineCurve3_init(src,a,b);let f=LineCurve3_init(dest,c,d);"
        "  let p=ux_u32_put(src+LineCurve3Record.arcLengthDivisions,4);"
        "  let q=ux_u32_put(dest+LineCurve3Record.arcLengthDivisions,4);"
        "  let g=CurveArcCache_init(srcCache,srcTable,5);let h=CurveArcCache_init(destCache,destTable,5);"
        "  return e==src && f==dest && g==srcCache && h==destCache;}"
        "if(op==1){return ux_u32(src+LineCurve3Record.v1);}"
        "if(op==2){return LineCurve3_recordPoint(sample,src,0.25,raw);}"
        "if(op==3){return LineCurve3_recordPointAt(sample,src,1.0,raw);}"
        "if(op==4){return LineCurve3_recordTangent(sample,src,raw);}"
        "if(op==5){return LineCurve3_recordTangentAt(sample,src,raw);}"
        "if(op==6){return LineCurve3_recordPoints(samples,src,2,raw);}"
        "if(op==7){return LineCurve3_recordSpacedPoints(samples,src,2,raw);}"
        "if(op==8){return LineCurve3_recordLengths(src,srcCache,sample,0-1,0);}"
        "if(op==10){return LineCurve3_updateArcLengths(src,srcCache,sample);}"
        "if(op==12){return LineCurve3_recordLengths(dest,destCache,sample,0-1,0);}"
        "if(op==14){return LineCurve3_updateArcLengths(dest,destCache,sample);}"
        "if(op==9){return ux_f64_put(552,x*1.0);}"
        "if(op==11){let t=LineCurve3_getUtoTmapping(src,srcTable,0.75,4.0);let n=ux_f64_put(sample,t);return sample;}"
        "if(op==13){if(x==1){return LineCurve3_clone(dest,src);}return LineCurve3_copy(dest,src);}"
        "if(op==15){return LineCurve3_clone(clone,dest);}"
        "if(op==16){return ux_f64_put(ux_u32(clone+LineCurve3Record.v2)+16,x*1.0);}"
        "if(op==17){if(x==1){return LineCurve3_toJSON(dest,2048,3072,4096);}return LineCurve3_toJSON(clone,2048,3072,4096);}"
        "if(op==18){return LineCurve3_fromJSON(dest,2048,x,4096);}"
        "if(op==19){return LineCurve3_computeFrenetFrames(6144,dest,2,1,6400);}"
        "if(op==20){return ux_span(0,8192);}"
        "if(op==21){let bad=ux_u8_put(x-1,93);return LineCurve3_fromJSON(dest,2048,x,4096);}"
        "if(op==22){let line=src;let table=srcTable;if(x==1){line=dest;table=destTable;}"
        "  let n=ux_f64_put(sample,LineCurve3_recordLength(line,table));return sample;}"
        "if(op==23){return LineCurve3_recordLengths(dest,destCache,sample,2,0);}"
        "return 0-1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,"ujs/practice/uxe/base/curve-control-layout.ujs",
        "ujs/practice/uxe/base/object-json-tokens.ujs","ujs/practice/uxe/base/json-bytes.ujs",
        "ujs/practice/uxe/base/json-read.ujs","ujs/practice/uxe/base/record-copy.ujs",
        "ujs/practice/uxe/base/f64-math.ujs","ujs/practice/uxe/base/geometry-frames.ujs",
        "ujs/practice/uxe/base/curve-line.ujs","ujs/practice/uxe/base/curve-bezier.ujs",
        "ujs/practice/uxe/base/curve-control.ujs","ujs/practice/uxe/base/curve.ujs",
        "ujs/practice/uxe/base/curve-frames.ujs","ujs/practice/uxe/base/linecurve3.ujs",
        "ujs/practice/uxe/base/linecurve3-class.ujs","ujs/practice/uxe/base/linecurve3-lifecycle.ujs",
        body,"-o",(char *)wasm,0};
    const double gold[]={1,5,11,1,1,3,7,3,7,8,7,8,16,.25,4,1,19,4,16,1,19,27,0,
        1,27,4,16,12,24,12,1,-1,1};
    enum { count=sizeof gold/sizeof gold[0] };
    const char serialized[]="{\"metadata\":{\"version\":4.6,\"type\":\"Curve\",\"generator\":\"Curve.toJSON\"},"
        "\"arcLengthDivisions\":4,\"type\":\"LineCurve3\",\"v1\":[1,2,3],\"v2\":[1,2,27]}";
    uint64_t hash=0;
    for(unsigned i=0;i<sizeof serialized-1;i++) hash=(hash*131+(unsigned char)serialized[i])%16777213;
    double actual[count]={0};
    char *output=0; size_t bytes=0;
    int failed=length<=0 || length>=(int)sizeof url;
    if(!failed && construct) {
        failed=sy_write_file(abi,signature,sizeof signature-1,0600) ||
            sy_write_file(body,entry,sizeof entry-1,0600);
    }
    if(!failed && construct) {
        const int rc=cx_runv_timeout(compile,12,&output,&bytes);
        if(rc) { printf("LINECURVE3_LIFECYCLE compile_rc=%d %s\n",rc,output?output:""); failed=1; }
        mm_free(output); output=0;
    }
    if(!failed && !construct) {
        const char source[]=
            "import uxe_lc3_lifecycle from \"uxe_linecurve3_v1\"(i64,i64) i64;\n"
            "export uxe_linecurve3_read(op:i64,x:i64) i64 version 1;\n"
            "if(op!=0 && op!=6 && op!=7){return 0-1;}\n"
            "return uxe_lc3_lifecycle(op,x);\n";
        char *args[]={"./ujs/ujs2wasm.com",consumer,"-o",probe,0};
        failed=sy_write_file(consumer,source,sizeof source-1,0600) || cx_runv_timeout(args,6,&output,&bytes);
        if(failed) printf("LINECURVE3_LIFECYCLE consumer compilation failed\n");
        mm_free(output);
        output=0;
        if(!failed) failed=r160_wait_read(url,"#r160",actual,count,dir);
        for(int i=0;!failed && i<count;i++) {
            const double expected=i==22?(double)hash:gold[i];
            if(actual[i]!=expected) {
                printf("LINECURVE3_LIFECYCLE case=%d actual=%.17g gold=%.17g\n",i,actual[i],expected);
                failed=1;
            }
        }
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,4,&output,&bytes)) failed=1;
    mm_free(output);
    if(construct) printf("LINECURVE3_LIFECYCLE construct failed=%d wasm=%s\n",failed,wasm);
    else printf("G_STRUCT LineCurve3 shared-instance lifecycle cases=%d failed=%d\n",count,failed);
    return failed;
}
