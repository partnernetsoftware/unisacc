#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","vector-scalar","spherical",0};
    const char *setup="let s=Spherical_set(0,5.0,1.0,2.0);let y=ux_f64_put(72,0.0-7.0);";
    const char *cases[]={
        "return ux_f64(s+8);","let r=Spherical_clone(24,s);return ux_f64(r+16);",
        "let r=Spherical_copy(24,s);return ux_f64(r);",
        "let q=Spherical_set(24,1.0,0.0,0.0);let r=Spherical_makeSafe(q);return ux_f64(r+8);",
        "let q=Spherical_set(24,1.0,3.141592653589793,0.0);let r=Spherical_makeSafe(q);return ux_f64(r+8);",
        "let r=Spherical_setFromCartesianCoords(24,3.0,0.0,4.0);return ux_f64(r);",
        "let r=Spherical_setFromCartesianCoords(24,3.0,0.0,4.0);return ux_f64(r+16);",
        "let r=Spherical_setFromVector3(24,64);return ux_f64(r+8);",
        "let r=Spherical_setFromVector3(24,96);return ux_f64(r);"
    };
    const double gold[]={1,2,5,0.000001,3.141591653589793,5,0.6435011087932844,3.141592653589793,0};
    return g_math_run("G_MATH Spherical","spherical",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?3:-1,"let q=Spherical_set(24,1.0,0.0,0.0);return ux_f64(q+8);");
}
