#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d",
        "bone","skeleton-layout","skeleton",0};
    const char *setup="let arena=Object3D_initArena(0,4);let bone=Bone_create(arena);"
        "let source=Skeleton_init(2048,2200,2304,2560,1);let a=ux_u32_put(2200,bone);"
        "let inverse=Matrix4_identity(2304);let sourceValue=ux_f32_put(2560,7.0);"
        "let targetValue=ux_f32_put(2816,9.0);let copy=Skeleton_clone(2112,source,2704,2816);"
        "if(copy<0){return 0.0+copy;}";
    const char *cases[]={
        "return 0.0+(ux_u32(2704)==bone && ux_u32(copy+Skeleton.bones)!=ux_u32(source+Skeleton.bones));",
        "return 0.0+(ux_u32(copy+Skeleton.inverses)==ux_u32(source+Skeleton.inverses));",
        "return ux_f32(2816);",
        "let changed=ux_u32_put(2704,0);return 0.0+(ux_u32(2200)==bone && ux_u32(2704)==0);",
        "let bad=Skeleton_clone(2160,source,2200,2816);return 0.0+bad;",
    };
    const double gold[]={1,1,0,1,-1};
    return g_wasm_batch("G_STRUCT Skeleton clone","skeleton-clone",modules,setup,cases,gold,5,
        mutate?2:-1,"let dirty=ux_f32_put(2816,7.0);return ux_f32(2816);");
}
