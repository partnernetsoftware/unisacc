#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int alpha=argc==2 && tx_eqz(argv[1],"--mutate-alpha");
    const int lum=argc==2 && tx_eqz(argv[1],"--mutate-luminance");
    const int paired=argc==2 && tx_eqz(argv[1],"--mutate-luminance-alpha");
    if(argc!=1 && !alpha && !lum && !paired) return 2;
    const char *modules[]={"gpu-texture-sample","gpu-legacy-format","gpu-legacy-format-generated",0};
    const char *setup="let a=ux_u8_put(128,10);let b=ux_u8_put(129,45);"
        "let c=ux_u8_put(130,180);let d=ux_u8_put(131,200);";
    const char *cases[]={
        "return GpuLegacyTexture_sample(1021,128,2,1,0.75,0.0);",
        "return GpuLegacyTexture_sample(1024,128,2,1,0.75,0.0);",
        "return GpuLegacyTexture_sample(1025,128,2,1,0.75,0.0);"
    };
    const double gold[]={45*16777216.0,45*65793.0+255*16777216.0,180*65793.0+200*16777216.0};
    return g_math_run("G_STRUCT GPU legacy texture formats","gpu-legacy-format",modules,setup,cases,gold,3,
        alpha?0:lum?1:paired?2:-1,alpha?cases[1]:cases[0]);
}
