#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define TEST "ujs/practice/uxe/test/"

static int action_timed_build(const char *dir) {
    char layout[320],wasm[320];
    tx_snprintf(layout,sizeof layout,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/probe.wasm",dir);
    const char abi[]="export uxe_animationaction_timed(op:i64,a:f64,b:f64) f64 version 1;\n";
    if(sy_write_file(layout,abi,sizeof abi-1,0600)) return 1;
    char *args[]={"./ujs/ujs2wasm.com",layout,BASE "animation-view.ujs",BASE "linearinterpolant.ujs",
        BASE "propertymixer.ujs",BASE "animationaction.ujs",BASE "animationaction-timed.ujs",
        TEST "animationaction-timed-probe.ujs","-o",wasm,0};
    char *log=0;
    size_t bytes=0;
    const int rc=cx_runv_timeout(args,8,&log,&bytes);
    if(rc) printf("ACTION_TIMED_BUILD rc=%d %.*s\n",rc,(int)bytes,log);
    mm_free(log);
    return rc;
}

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[460],url[850];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","ujs-action-timed-",dir,sizeof dir)) return 2;
    const int n=tx_snprintf(url,sizeof url,"file://%s/" TEST "animationaction-timed-r160.html?dir=%s%s",
        cwd,dir,mutate?"&mutate=1":"");
    // Rows are local time, effective weight, enabled and blended position.
    // Track interpolates 2 + 2*time; unused blend amount retains position 10.
    #define STAGES 0,.25,1,8, 0,.625,1,5, .5,.875,1,3.875, 1.25,1,1,4.5, \
        1.75,.5,1,7.75, 2.25,0,1,10, 2.5,0,0,10, 2.5,0,0,10, \
        .5,.25,1,8.25, 1,1,1,4, 1.5,.5,1,7.5, 3,1,1,8, 2.75,1,1,7.5, .25,.5
    const double gold[]={STAGES,STAGES,1};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    int failed=n<0 || n>=sizeof url || action_timed_build(dir) || r160_wait_read(url,"#r160",actual,count,dir);
    for(int i=0;!failed && i<count;i++) if(actual[i]!=gold[i]) {
        printf("ACTION_TIMED case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
        failed=1;
    }
    if(sy_remove_all(dir)) failed=1;
    printf("G_ANIM AnimationAction timed fade cases=%d failed=%d\n",count,failed);
    return failed;
}
