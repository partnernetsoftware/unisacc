#pragma unisa use g_geometry
#pragma unisa use text.fmt
#pragma unisa use text.text

static int later(const double *a,const double *b) {
    for(int i=0;i<6;i++) {
        if(a[i]!=b[i]) return a[i]>b[i];
    }
    return 0;
}

int main(int argc,char **argv) {
    int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"geometry-buffers","geometry-frames","convexgeometry",0};
    char source[960];
    tx_snprintf(source,sizeof source,"let mesh=GeometryBuffers_init(0,256,12,1024,0);"
        "let bx=ux_f64_put(2072,%d.0);let cy=ux_f64_put(2104,2.0);let dz=ux_f64_put(2136,2.0);"
        "let ex=ux_f64_put(2144,0.2);let ey=ux_f64_put(2152,0.2);let ez=ux_f64_put(2160,0.2);"
        "return ConvexGeometry_generate(mesh,2048,5,4096,0.00000001);",mutate?3:2);
    const double unit=0.5773502691896257645;
    const int vertices[4][3]={{0,0,0},{2,0,0},{0,2,0},{0,0,2}};
    const int faces[4][3]={{0,1,2},{0,1,3},{0,2,3},{1,2,3}};
    const double normals[4][3]={{0,0,-1},{0,-1,0},{-1,0,0},{unit,unit,unit}};
    double gold[98]={12,0};
    int at=2;
    for(int face=0;face<4;face++) for(int corner=0;corner<3;corner++) {
        for(int k=0;k<3;k++) gold[at++]=vertices[faces[face][corner]][k];
        for(int k=0;k<3;k++) gold[at++]=normals[face][k];
        gold[at++]=0; gold[at++]=0;
    }
    for(int i=1;i<12;i++) {
        int j=i;
        while(j>0 && later(gold+2+(j-1)*8,gold+2+j*8)) {
            for(int k=0;k<8;k++) {
                double tmp=gold[2+(j-1)*8+k];
                gold[2+(j-1)*8+k]=gold[2+j*8+k]; gold[2+j*8+k]=tmp;
            }
            j--;
        }
    }
    return g_geometry_check_with("ConvexGeometry","convexgeometry",modules,source,gold,98,98,argv[1]);
}
