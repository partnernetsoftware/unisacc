#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","animation-view","keyframe-track",0};
    const char *setup=
        "let a=ux_f32_put(64,0.0);let b=ux_f32_put(68,1.0);let name=ux_u8_put(100,120);"
        "let samples=AnimationSamples_init(0,64,128,2,3);let track=KeyframeTrack_init(32,100,1,samples);";
    const char *cases[]={
        "return KeyframeTrack_getValueSize(track);",
        "return KeyframeTrack_getInterpolation(track);",
        "let t=KeyframeTrack_setInterpolation(track,2300);return KeyframeTrack_getInterpolation(t);",
        "let t=KeyframeTrack_setInterpolation(track,2302);let invalid=KeyframeTrack_setInterpolation(t,777);"
        "return KeyframeTrack_getInterpolation(invalid);",
        "return ux_u8(ux_u32(track+KeyframeTrack.name));",
        "return KeyframeTrack_init(64,100,1,samples);"
    };
    const double gold[]={3,2301,2300,2302,120,-1};
    return g_math_run("G_ANIM KeyframeTrack","keyframe-track",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let t=KeyframeTrack_setInterpolation(track,777);return KeyframeTrack_getInterpolation(t);");
}
