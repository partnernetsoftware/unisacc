#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","camera","orthographiccamera",0};
    const char *setup="let camera=Camera_init(1024,2048);let lens=OrthographicCamera_init(512,"
        "0.0-4.0,4.0,2.0,0.0-2.0,1.0,11.0);let z=ux_f64_put(lens+OrthographicCamera.zoom,2.0);"
        "let m=ux_u32(camera+Camera.projectionMatrix);";
    const char *cases[]={
        "let p=OrthographicCamera_updateProjectionMatrix(lens,camera);return ux_f64(m);",
        "let p=OrthographicCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+40);",
        "let p=OrthographicCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+80);",
        "let p=OrthographicCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+112);",
        "let v=OrthographicCamera_setViewOffset(lens,800.0,400.0,0.0,0.0,400.0,200.0);let p=OrthographicCamera_updateProjectionMatrix(lens,camera);return ux_f64(m);",
        "let v=OrthographicCamera_setViewOffset(lens,800.0,400.0,0.0,0.0,400.0,200.0);let p=OrthographicCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+40);",
        "let v=OrthographicCamera_setViewOffset(lens,800.0,400.0,0.0,0.0,400.0,200.0);let p=OrthographicCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+96);",
        "let v=OrthographicCamera_setViewOffset(lens,800.0,400.0,0.0,0.0,400.0,200.0);let p=OrthographicCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+104);",
        "let v=ux_u32_put(camera+Camera.coordinateSystem,2001);let p=OrthographicCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+80);",
        "let v=ux_u32_put(camera+Camera.coordinateSystem,2001);let p=OrthographicCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+112);",
        "let v=ux_u32_put(camera+Camera.coordinateSystem,2001);let p=OrthographicCamera_updateProjectionMatrix(lens,camera);return ux_f64(p+80);"
    };
    const double gold[]={0.5,1,-0.2,-1.2,1,2,1,-1,-0.1,-0.1,-10};
    return g_math_run("G_STRUCT OrthographicCamera","orthographiccamera",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,"let p=OrthographicCamera_updateProjectionMatrix(lens,camera);return ux_f64(m+40);");
}
