#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","f64-math","quaternion","animation-view","gltf-cubic-interpolant",
        "animation-additive-quat","animation-gltf-quat-delta",0};
    const char *setup=
        "let a=ux_f32_put(64,1.0);let b=ux_f32_put(68,3.0);let q=0.7071067811865476;"
        "let tang=ux_f32_put(128,11.0);let z=ux_f32_put(152,q);let w=ux_f32_put(156,q);"
        "let end=ux_f32_put(172,19.0);"
        "let r0=ux_f32_put(208,q);let r1=ux_f32_put(220,q);let r2=ux_f32_put(256,q);let r3=ux_f32_put(268,q);"
        "let t=AnimationSamples_init(0,64,128,1,12);let r=AnimationSamples_init(32,64,192,2,12);"
        "let size=AnimationUtils_gltfQuatDelta(t,r,2.0,384,48,512);";
    const char *cases[]={
        "return size;","return ux_f32(404);","return ux_f32(400);","return ux_f32(384);","return ux_f32(428);",
        "return AnimationUtils_gltfQuatDelta(t,r,2.0,384,47,512);",
        "return AnimationUtils_gltfQuatDelta(t,r,2.0,384,48,384);"
    };
    double q=(float)0.7071067811865476;
    double product=(float)(q*q);
    const double gold[]={48,product,-product,11,19,-2,-1};
    return g_math_run("G_ANIM AnimationUtils glTF quaternion delta","animation-gltf-quat-delta",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,"return ux_f32(400);");
}
