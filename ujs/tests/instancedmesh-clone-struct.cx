#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts",
        "object3d","object3d-lifecycle","datautils","bufferattribute","buffergeometry","mesh-layout",
        "mesh","record-copy","instancedmesh","instancedmesh-lifecycle",0};
    const char *setup="let arena=Object3D_initArena(0,6);let source=Object3D_create(arena);"
        "let target=Object3D_create(arena);let mesh=Mesh_init(4024,arena,source,4400,17,0,0);"
        "let targetMesh=Mesh_init(4056,arena,target,4500,19,0,0);"
        "let instance=InstancedMesh_init(5000,mesh,5120,5248,2);"
        "let targetInstance=InstancedMesh_init(5032,targetMesh,5408,5536,2);"
        "let matrix=Matrix4_makeTranslation(5704,3.0,0.0,0.0);"
        "let second=InstancedMesh_setMatrixAt(instance,1,matrix);let color=InstancedMesh_setColorAt(instance,1,0.5,0.25,0.75);"
        "let count=InstancedMesh_setCount(instance,1);"
        "let clone=InstancedMesh_clone(targetInstance,arena,instance,arena,0);"
        "if(clone<0){return 0.0+clone;}";
    const char *cases[]={
        "return 0.0+(ux_u32(targetMesh+Mesh.geometry)==4400 && ux_u32(targetMesh+Mesh.material)==17);",
        "return 0.0+ux_u32(clone+InstancedMesh.count);",
        "let count=InstancedMesh_setCount(clone,2);let m=InstancedMesh_getMatrixAt(clone,1,5704);return ux_f64(m+96);",
        "let count=InstancedMesh_setCount(clone,2);let rgb=InstancedMesh_getColorAt(clone,1,5904);return ux_f64(rgb);",
        "let edited=ux_f32_put(5520,9.0);return ux_f32(5232);",
        "let small=InstancedMesh_init(6056,targetMesh,6144,6224,1);return 0.0+InstancedMesh_copy(small,arena,instance,arena,0);",
    };
    const double gold[]={1,1,3,0.5,3,-2};
    return g_wasm_batch("G_STRUCT InstancedMesh clone","instancedmesh-clone",modules,setup,cases,gold,6,
        mutate?3:-1,"let count=InstancedMesh_setCount(clone,2);let rgb=InstancedMesh_getColorAt(clone,1,5904);return ux_f64(rgb+8);");
}
