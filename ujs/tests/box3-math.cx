#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"vector-scalar","f64-math","views","vector3","box3",0};
    const char *setup="let low=Vector3_set(0,0.0-2.0,0.0-1.0,0.0);let high=Vector3_set(24,4.0,3.0,2.0);"
        "let blo=Vector3_set(48,2.0,0.0-4.0,1.0);let bhi=Vector3_set(72,7.0,1.0,4.0);"
        "let a=Box3_set(96,low,high);let b=Box3_set(144,blo,bhi);"
        "let center=Vector3_set(192,1.0,1.0,1.0);let p=Vector3_set(216,7.0,7.0,2.0);"
        "let size=Vector3_set(240,6.0,4.0,2.0);";
    const char *cases[]={
        "let r=Box3_set(272,low,high);return ux_f64(r);",
        "let r=Box3_setFromArray(272,center,6);return ux_f64(r+32);",
        "let s=ux_f32_put(320,1.0);let t=ux_f32_put(336,0.0-4.0);let r=Box3_setFromBufferAttribute(272,320,2,16);return ux_f64(r);",
        "let r=Box3_setFromPoints(272,center,2);return ux_f64(r+40);",
        "let r=Box3_setFromCenterAndSize(272,center,size);return ux_f64(r+8);",
        "let r=Box3_clone(272,a);return ux_f64(r+24);",
        "let r=Box3_copy(272,a);return ux_f64(r+32);",
        "let r=Box3_makeEmpty(a);return Box3_isEmpty(r);",
        "let r=Box3_getCenter(272,a);return ux_f64(r+16);",
        "let r=Box3_getSize(272,a);return ux_f64(r);",
        "let r=Box3_expandByPoint(a,p);return ux_f64(r+32);",
        "let r=Box3_expandByVector(a,center);return ux_f64(r+16);",
        "let r=Box3_expandByScalar(a,2.0);return ux_f64(r+40);",
        "return Box3_containsPoint(a,center);","return Box3_containsBox(a,b);",
        "let r=Box3_getParameter(272,a,center);return ux_f64(r+8);",
        "return Box3_intersectsBox(a,b);",
        "let s=Vector3_set(272,7.0,7.0,2.0);let h=ux_f64_put(s+24,5.0);return Box3_intersectsSphere(a,s);",
        "let s=Vector3_set(272,0.0,0.0,1.0);let h=ux_f64_put(s+24,0.0-1.0);return Box3_intersectsPlane(a,s);",
        "let u=Vector3_set(272,1.0,1.0,1.0);let v=Vector3_set(296,2.0,1.0,1.0);let w=Vector3_set(320,1.0,2.0,1.0);return Box3_intersectsTriangle(a,u);",
        "let u=Vector3_set(272,4.0,4.0,1.0);let v=Vector3_set(296,5.0,3.0,1.0);let w=Vector3_set(320,6.0,4.0,1.0);return Box3_intersectsTriangle(a,u);",
        "let r=Box3_clampPoint(272,a,p);return ux_f64(r);","return Box3_distanceToPoint(a,p);",
        "let r=Box3_getBoundingSphere(272,a);return ux_f64(r+24);",
        "let r=Box3_intersect(a,b);return ux_f64(r+32);","let r=Box3_union(a,b);return ux_f64(r+8);",
        "let x=ux_f64_put(320,0.0-2.0);let y=ux_f64_put(360,3.0);let z=ux_f64_put(400,4.0);"
        "let w=ux_f64_put(440,1.0);let r=Box3_applyMatrix4(a,320,272);return ux_f64(r);",
        "let r=Box3_translate(a,center);return ux_f64(r);",
        "let r=Box3_clone(272,a);return Box3_equals(a,r);"
    };
    const double gold[]={-2,7,-4,2,-1,4,3,1,1,6,7,-1,4,1,0,0.5,1,1,1,1,0,4,5,
        3.7416573867739413,1,-4,-8,-1,1};
    return g_math_run("Box3","box3",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?24:-1,"let r=Box3_union(a,b);return ux_f64(r+32);");
}
