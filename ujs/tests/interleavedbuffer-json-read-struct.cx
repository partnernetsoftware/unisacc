#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define FIX "ujs/practice/uxe/test/"

enum { count=121 };

static int expected(double *gold) {
    const int shapes[]={2,12,9,35044,0,1,6, 6,4,9,35044,0,1,6, 3,8,9,35044,0,1,6, 1,1,7,1};
    const int types[]={12,2,3,3,8,10};
    const int failures[]={-2,-3,-1,-1,-1, -2,-2,-1,-3,-1, -1,-1,-1,-1,-1,-2,0};
    int at=0;
    for(int source=0;source<3;source++) for(int i=0;i<25;i++) gold[at++]=shapes[i];
    for(int source=0;source<2;source++) for(int i=0;i<6;i++) gold[at++]=types[i];
    for(int i=0;i<17;i++) {
        gold[at++]=failures[i];
        gold[at++]=1;
    }
    return at;
}

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[420],abi[320],wasm[320],url[850];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-ib-json-read-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/views.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,"file://%s/" FIX "interleavedbuffer-json-read-r160.html?wasm=%s&mode=%d",
        cwd,wasm,mutate);
    const char signature[]="export uxe_ib_json_read(op:i64,id:i64,bytes:i64,mode:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,BASE "geometry-load-layout.ujs",BASE "datautils.ujs",
        BASE "bufferattribute.ujs",BASE "record-copy.ujs",BASE "interleavedbuffer.ujs",BASE "interleavedbuffer-edit.ujs",
        BASE "json-read.ujs",BASE "loader-json.ujs",BASE "loaderutils.ujs",BASE "json-string-decode.ujs",
        BASE "object-json-tokens.ujs",BASE "interleavedbuffer-json.ujs",BASE "interleavedbuffer-json-read.ujs",
        FIX "interleavedbuffer-json-read-probe.ujs","-o",wasm,0};
    double gold[count],actual[count]={0};
    int failed=length<=0 || length>=(int)sizeof url || expected(gold)!=count ||
        sy_write_file(abi,signature,sizeof signature-1,0600);
    if(!failed) {
        char *out=0;
        size_t bytes=0;
        const int rc=cx_runv_timeout(compile,6,&out,&bytes);
        if(rc) { printf("IB_JSON_READ compile_rc=%d %.*s\n",rc,(int)bytes,out?out:""); failed=1; }
        mm_free(out);
    }
    if(!failed) failed=r160_wait_read(url,"#r160",actual,count,dir);
    if(!failed) for(int i=0;i<count;i++) if(actual[i]!=gold[i]) {
        printf("IB_JSON_READ case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
        failed++;
    }
    if(sy_remove_all(dir)) failed++;
    printf("G_STRUCT InterleavedBuffer JSON read cases=%d failed=%d\n",count,failed);
    return failed!=0;
}
