#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define PIXEL(offset) "return 0.0+ux_u32(512+" #offset ");"

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","compressedtextureloader","compressed-texture-bc1",0};
    const char setup[]=
        "let opaque=CompressedTextureLoader_level(32,128,16,5,3,33776);"
        "let alpha=CompressedTextureLoader_level(64,128,16,5,3,33777);"
        "let a=ux_u32_put(128,2095104);let b=ux_u32_put(132,3840206052);"
        "let c=ux_u32_put(136,4160749568);let d=ux_u32_put(140,4294967295);";
    const char *cases[]={
        "let n=CompressedTexture_decodeBC1(32,512,60);return 0.0+n;",
        "let n=CompressedTexture_decodeBC1(32,512,60);" PIXEL(0),
        "let n=CompressedTexture_decodeBC1(32,512,60);" PIXEL(4),
        "let n=CompressedTexture_decodeBC1(32,512,60);" PIXEL(8),
        "let n=CompressedTexture_decodeBC1(32,512,60);" PIXEL(12),
        "let n=CompressedTexture_decodeBC1(32,512,60);" PIXEL(16),
        "let n=CompressedTexture_decodeBC1(64,512,60);" PIXEL(16),
        "let n=CompressedTexture_decodeBC1(64,512,60);" PIXEL(56),
        "return 0.0+CompressedTexture_decodeBC1(32,512,59);",
        "return 0.0+CompressedTexture_decodeBC1(32,132,60);",
        "let changed=ux_u32_put(32+CompressedMip.bytes,8);return 0.0+CompressedTexture_decodeBC1(32,512,60);",
        "let changed=ux_u32_put(32+CompressedMip.format,33779);return 0.0+CompressedTexture_decodeBC1(32,512,60);",
    };
    const double gold[]={60,0xff0000ffu,0xffff0000u,0xff5500aau,0xffaa0055u,0xff000000u,0,0,-1,-1,-3,-2};
    return g_wasm_batch("G_IO CompressedTexture software BC1","compressed-texture-bc1",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let changed=ux_u8_put(132,212);let n=CompressedTexture_decodeBC1(32,512,60);" PIXEL(8));
}
