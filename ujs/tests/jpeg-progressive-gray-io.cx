#pragma unisa use g_jpeg_gray_link
#pragma unisa use text.text

static int build(unsigned char *image,int restart) {
    const unsigned char soi[]={255,216,255,219,0,67,0};
    int size=0;
    for(int i=0;i<7;i++) image[size++]=soi[i];
    for(int i=0;i<64;i++) image[size++]=i==1 && !restart?64:8;
    const unsigned char header[]={255,194,0,11,8,0,1,0,restart?9:1,1,1,17,0,255,196,0,39};
    for(int i=0;i<17;i++) image[size++]=header[i];
    image[size++]=0;image[size++]=1;
    for(int i=0;i<15;i++) image[size++]=0;
    image[size++]=restart?6:0;
    image[size++]=16;image[size++]=1;image[size++]=1;
    for(int i=0;i<14;i++) image[size++]=0;
    image[size++]=0;image[size++]=restart?1:0;
    if(!restart) {
        // AC code 0 inserts coefficient 1. Code 10 ends the block.
        image[size-2]=1;image[size-1]=0;
        const unsigned char scans[]={255,218,0,8,1,1,0,0,0,0,127,
            255,218,0,8,1,1,0,1,63,1,111,
            255,218,0,8,1,1,0,1,63,16,191,255,217};
        for(int i=0;i<(int)sizeof scans;i++) image[size++]=scans[i];
    } else {
        const unsigned char scans[]={255,221,0,4,0,1,
            255,218,0,8,1,1,0,0,0,0,65,255,208,63,
            255,218,0,8,1,1,0,1,63,0,127,255,208,127,255,217};
        for(int i=0;i<(int)sizeof scans;i++) image[size++]=scans[i];
    }
    return size;
}

int main(int argc,char **argv) {
    if(argc>1 && tx_eqz(argv[1],"--prepare")) {
        if(argc==2) return g_jpeg_gray_prepare(0);
        if(argc==3 && tx_eqz(argv[2],"--check")) return g_jpeg_gray_prepare(1);
        return 2;
    }
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    const int mutate_loader=argc==2 && tx_eqz(argv[1],"--mutate-loader");
    if(argc!=1 && !mutate && !mutate_loader) return 2;
    unsigned char fixtures[512]={0};
    const int first=build(fixtures,0);
    const int second=build(fixtures+256,1);
    const double gold[]={4,161,255,36,160,96,-6,-6,-6,79,-1,36,96};
    return g_jpeg_gray_link(fixtures,first,second,gold,sizeof gold/sizeof gold[0],mutate_loader?2:mutate);
}
