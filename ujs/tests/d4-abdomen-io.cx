#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[390],wasm[300],gait[300],url[960];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-d4-abdomen-",dir,sizeof dir)) return 2;
    tx_snprintf(wasm,sizeof wasm,"%s/d4-abdomen.wasm",dir);
    tx_snprintf(gait,sizeof gait,"%s/d4-gait.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/ujs/practice/uxe/test/d4-abdomen-r160.html?wasm=file://%s&gait=file://%s&mutate=%d",cwd,wasm,gait,mutate);
    char *compile[]={"./ujs/ujs2wasm.com","ujs/practice/uxe/products/d4/d4-abdomen-api.ujs",
        "ujs/practice/uxe/products/d4/d4-abdomen.ujs","-o",wasm,0};
    char *buildGait[]={"cx","ujs/practice/uxe/products/d4/build.cx","--",gait,0};
    const double gold[]={9,81,0,0,0,0,8,(double)(float)4.45,(double)(float)0.4,
        (double)(float)7.4,(double)(float)1.3,(double)(float)4.4,1,-1,-2.5,
        (double)(float)1.01,(double)(float)0.24,(double)0xff4677a1u,(double)(float)0.21,
        2.5,(double)(float)3.01};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    char *out=0;
    size_t bytes=0;
    int failed=length<0 || length>=(int)sizeof url;
    if(!failed) {
        const int rc=cx_runv_timeout(compile,12,&out,&bytes);
        if(rc) { printf("D4_ABDOMEN compile_rc=%d %s\n",rc,out?out:""); failed=1; }
        mm_free(out); out=0;
    }
    if(!failed) {
        const int rc=cx_runv_timeout(buildGait,16,&out,&bytes);
        if(rc) { printf("D4_ABDOMEN gait_rc=%d %s\n",rc,out?out:""); failed=1; }
        mm_free(out); out=0;
    }
    if(!failed) {
        failed=r160_wait_read(url,"#result",actual,count,dir);
        if(!failed) {
            printf("D4_ABDOMEN frames=%.0f records=%.0f count_diff=%.0f matrix_diff=%.0f material_diff=%.0f tail_diff=%.0f refusals=%.0f\n",
                actual[0],actual[1],actual[2],actual[3],actual[4],actual[5],actual[6]);
            for(int i=0;i<count;i++) {
                const double delta=actual[i]-gold[i];
                if(!(delta>=-1e-8 && delta<=1e-8)) {
                    printf("D4_ABDOMEN field=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
                    failed=1;
                }
            }
        }
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&out,&bytes)) failed=1;
    mm_free(out);
    printf("D4_ABDOMEN failed=%d\n",failed);
    return failed;
}
