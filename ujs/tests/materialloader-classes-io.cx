#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","json-read","loader-json","materialloader",0};
    const char *names[]={"MeshBasicMaterial","MeshStandardMaterial","MeshLambertMaterial","MeshPhongMaterial","MeshToonMaterial",
        "MeshNormalMaterial","MeshDepthMaterial","MeshDistanceMaterial","MeshMatcapMaterial","PointsMaterial","LineBasicMaterial",
        "LineDashedMaterial","SpriteMaterial","ShadowMaterial","ShaderMaterial","RawShaderMaterial","MeshPhysicalMaterial",
        "MeshBasicMaterialX"};
    char setup[10000];
    int n=tx_snprintf(setup,sizeof setup,"let input=256;let out=768;let size=0;");
    for(int i=0;i<18;i++) {
        char json[96];
        int bytes=tx_snprintf(json,sizeof json,"{\"type\":\"%s\",\"opacity\":0.5}",names[i]);
        n+=tx_snprintf(setup+n,sizeof setup-n,"if(selected_case==%d){size=%d;let bytes=[",i,bytes);
        for(int j=0;j<bytes;j++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",j?",":"",json[j]);
        n+=tx_snprintf(setup+n,sizeof setup-n,"];let j=0;while(j<size){let a=ux_u8_put(input+j,bytes[j]);j=j+1;}}");
    }
    tx_snprintf(setup+n,sizeof setup-n,"let m=LoadingManager_init(0);let f=FileLoader_init(32,m);"
        "let id=FileLoader_begin(f,64);let ok=FileLoader_receive(f,id,200,input,size,64);"
        "let result=MaterialLoader_parse(f,out,576);");
    const char *cases[18];
    double gold[18];
    for(int i=0;i<18;i++) {
        cases[i]="if(result<0){return 0.0+result;}return 0.0+ux_u32(out+LoadedMaterial.kind);";
        gold[i]=i+1;
    }
    gold[17]=-3;
    return g_wasm_batch("G_IO MaterialLoader constructors","materialloader-classes",modules,setup,cases,gold,
        18,mutate?4:-1,"return ux_f64(out+LoadedMaterial.opacity);");
}
