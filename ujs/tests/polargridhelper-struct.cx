#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","polargridhelper",0};
    const char *setup="let helper=0;let positions=128;let colors=512;let rgb=896;"
        "let a=ux_f32_put(rgb,0.25);let b=ux_f32_put(rgb+12,0.75);"
        "let init=PolarGridHelper_init(helper,positions,colors,rgb,4.0,4,2,4);";
    const char *cases[]={
        "return 0.0+ux_u32(helper+PolarGridHelper.count);",
        "return ux_f32(positions+20);",
        "return ux_f32(positions+36);",
        "return ux_f32(positions+68);",
        "return ux_f32(positions+84);",
        "return ux_f32(colors);",
        "return ux_f32(colors+36);",
        "return ux_f32(positions+104);",
        "return ux_f32(positions+116);",
        "return ux_f32(positions+200);",
        "return ux_f32(colors+192);",
        "let a=PolarGridHelper_init(helper,positions,colors,rgb,4.0,1,1,4);return 0.0+ux_u32(helper+PolarGridHelper.count);",
        "let a=PolarGridHelper_init(helper,positions,colors,rgb,4.0,4,1,0);return 0.0+ux_u32(helper+PolarGridHelper.count);",
        "let gone=PolarGridHelper_dispose(helper);return 0.0+ux_u32(helper+PolarGridHelper.active);",
        "let gone=PolarGridHelper_dispose(helper);return 0.0+PolarGridHelper_dispose(helper);",
        "return 0.0+PolarGridHelper_init(helper,positions,positions,rgb,4.0,4,2,4);",
    };
    const double gold[]={24,4,4,-4,-4,0.75,0.25,4,0,2,0.25,8,8,0,-1,-1};
    return g_wasm_batch("G_STRUCT PolarGridHelper","polargridhelper",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?9:-1,"return ux_f32(positions+104);");
}
