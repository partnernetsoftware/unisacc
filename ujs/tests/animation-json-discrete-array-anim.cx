#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"animation-view","record-copy","loaderutils","json-read","json-string-decode","animation-json-flatten","animation-json-discrete",0};
    const char json[]="[{\"time\":1,\"f\":[true,false],\"s\":[\"a\",\"\\u82a6\"]},{\"time\":2,\"f\":[false,true],\"s\":[\"x\",\"y\"]}]";
    char setup[1250];
    int n=tx_snprintf(setup,sizeof setup,"let data=[");
    for(int i=0;i<(int)sizeof json-1;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[i]);
    tx_snprintf(setup+n,sizeof setup-n,
        "];let length=%d;let i=0;while(i<length){let w=ux_u8_put(128+i,data[i]);i=i+1;}"
        "let flag=ux_u8_put(256,102);let tag=ux_u8_put(264,115);"
        "let out=320;let times=ux_u32_put(out+AnimationJsonDiscreteRows.times,384);"
        "let values=ux_u32_put(out+AnimationJsonDiscreteRows.values,448);"
        "let text=ux_u32_put(out+AnimationJsonDiscreteRows.text,576);"
        "let rows=ux_u32_put(out+AnimationJsonDiscreteRows.capacity,2);"
        "let valuesCap=ux_u32_put(out+AnimationJsonDiscreteRows.valueCapacity,4);"
        "let cap=ux_u32_put(out+AnimationJsonDiscreteRows.textCapacity,16);",
        (int)sizeof json-1);
    const char *cases[]={
        "let r=AnimationUtils_flattenDiscrete(128,length,256,1,1,320,512);return ux_u32(r+AnimationJsonDiscreteRows.count);",
        "let r=AnimationUtils_flattenDiscrete(128,length,256,1,1,320,512);return ux_u32(r+AnimationJsonDiscreteRows.valueCount);",
        "let r=AnimationUtils_flattenDiscrete(128,length,256,1,1,320,512);return ux_u32(460);",
        "let r=AnimationUtils_flattenDiscrete(128,length,264,1,2,320,512);return ux_u8(ux_u32(456));",
        "let r=AnimationUtils_flattenDiscrete(128,length,264,1,2,320,512);return ux_u8(ux_u32(472));",
        "let r=AnimationUtils_flattenDiscrete(128,length,264,1,2,320,512);return ux_f32(388);",
        "let keep=ux_u32_put(448,777);let cap=ux_u32_put(out+AnimationJsonDiscreteRows.valueCapacity,3);"
        "let r=AnimationUtils_flattenDiscrete(128,length,264,1,2,320,512);return ux_u32(448);"
    };
    const double gold[]={2,4,1,232,121,2,777};
    return g_math_run("G_ANIM AnimationUtils discrete JSON arrays","animation-json-discrete-array",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?4:-1,
        "let r=AnimationUtils_flattenDiscrete(128,length,264,1,2,320,512);return ux_u8(ux_u32(464));");
}
