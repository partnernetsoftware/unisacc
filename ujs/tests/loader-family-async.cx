#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define FIX "ujs/practice/uxe/test/"

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[400],abi[300],wasm[300],url[750];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-loader-async-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/async.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/" FIX "loader-family-async-r160.html?wasm=%s%s",cwd,wasm,mutate?"&mutate=1":"");
    const char signature[]="export uxe_loader_async(op:i64,which:i64,x:i64,y:i64,z:i64,w:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,BASE "loadingmanager.ujs",BASE "defaultloadingmanager.ujs",
        BASE "loader.ujs",BASE "fileloader.ujs",BASE "loader-base.ujs",BASE "loader-family.ujs",
        BASE "loader-family-classes.ujs",BASE "json-read.ujs",BASE "loader-json.ujs",BASE "materialloader.ujs",
        BASE "audioloader.ujs",BASE "loader-family-material.ujs",BASE "loader-family-audio.ujs",
        FIX "loader-family-async-entry.ujs","-o",wasm,0};
    const double gold[]={0.5,0.25,3,8000,-1,1,0.75, 0.5,0.25,3,8000,-1,1,0.75,
        -1,-1,-1,-1,-2,1,1,2,3,4,4};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    char *output=0;
    size_t bytes=0;
    int failed=length<=0 || length>=(int)sizeof url || sy_write_file(abi,signature,sizeof signature-1,0600);
    if(!failed) {
        const int rc=cx_runv_timeout(compile,10,&output,&bytes);
        if(rc) { printf("LOADER_ASYNC_COMPILE rc=%d %.*s\n",rc,(int)bytes,output?output:""); failed=1; }
        mm_free(output); output=0;
    }
    if(!failed) {
        failed=r160_wait_read(url,"#r160",actual,count,dir);
        for(int i=0;!failed && i<count;i++) {
            const double delta=actual[i]-gold[i];
            if(!(delta>=-1e-9 && delta<=1e-9)) {
                printf("LOADER_ASYNC case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
                failed=1;
            }
        }
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,4,&output,&bytes)) failed=1;
    mm_free(output);
    printf("G_IO Loader family async cases=%d failed=%d\n",count,failed);
    return failed;
}
