#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"animation-view","json-read","animation-json-flatten",0};
    const char json[]="[{ \"time\": 0 },{\"time\":1,\"pos\":[2,3],\"scalar\":4},{\"time\":2,\"pos\":[5,8]},{\"time\":3}]";
    char setup[1400];
    int n=tx_snprintf(setup,sizeof setup,"let data=[");
    for(int i=0;i<(int)sizeof json-1;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[i]);
    tx_snprintf(setup+n,sizeof setup-n,
        "];let length=%d;let i=0;while(i<length){let w=ux_u8_put(128+i,data[i]);i=i+1;}"
        "let key=ux_u32_put(256,7565168);let tag=ux_u32_put(260,1818321779);let tail=ux_u16_put(264,29281);"
        "let out=320;let times=ux_u32_put(out+AnimationJsonRows.times,384);"
        "let values=ux_u32_put(out+AnimationJsonRows.values,448);"
        "let row=ux_u32_put(out+AnimationJsonRows.rowCapacity,4);let cap=ux_u32_put(out+AnimationJsonRows.valueCapacity,8);",
        (int)sizeof json-1);
    const char *cases[]={
        "let r=AnimationUtils_flattenJSON(128,length,256,3,320,512);return ux_u32(r+AnimationJsonRows.rowCount);",
        "let r=AnimationUtils_flattenJSON(128,length,256,3,320,512);return ux_u32(r+AnimationJsonRows.valueCount);",
        "let r=AnimationUtils_flattenJSON(128,length,256,3,320,512);return ux_f64(384);",
        "let r=AnimationUtils_flattenJSON(128,length,256,3,320,512);return ux_f64(472);",
        "let r=AnimationUtils_flattenJSON(128,length,260,6,320,512);return ux_f64(448);",
        "let guard=ux_f64_put(384,777.0);let small=ux_u32_put(out+AnimationJsonRows.valueCapacity,3);"
        "let r=AnimationUtils_flattenJSON(128,length,256,3,320,512);return ux_f64(384);",
        "let r=AnimationUtils_flattenJSON(128,length,256,3,320,256);return r;",
        "let bad=ux_u8_put(128,125);return AnimationUtils_flattenJSON(128,length,256,3,320,512);"
    };
    const double gold[]={2,4,1,8,4,777,-1,-2};
    return g_math_run("G_ANIM AnimationUtils JSON flatten","animation-json-flatten",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let r=AnimationUtils_flattenJSON(128,length,256,3,320,512);return ux_f64(464);");
}
