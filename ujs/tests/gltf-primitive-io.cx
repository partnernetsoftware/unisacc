#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","glb-container","json-read","loader-json","gltf-accessor","gltf-primitive",0};
    const char json[]="{\"meshes\":[{\"primitives\":[{\"attributes\":{\"POSITION\":0},\"indices\":1,\"material\":2}]}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":1,\"componentType\":5123,\"count\":3,\"type\":\"SCALAR\"}],\"bufferViews\":[{\"buffer\":0,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":36,\"byteLength\":6}]}";
    char setup[2500];
    int bytes=sizeof json-1;
    int n=0;
    for(int start=0;start<bytes;start+=100) {
        int count=bytes-start<100?bytes-start:100;
        n+=tx_snprintf(setup+n,sizeof setup-n,"let json%d=[",start);
        for(int i=0;i<count;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[start+i]);
        n+=tx_snprintf(setup+n,sizeof setup-n,
            "];let i%d=0;while(i%d<%d){let cell%d=ux_u8_put(%d+i%d,json%d[i%d]);i%d=i%d+1;}",
            start,start,count,start,128+start,start,start,start,start,start);
    }
    tx_snprintf(setup+n,sizeof setup-n,
        "let a=ux_u32_put(GlbResource.json,128);let b=ux_u32_put(GlbResource.jsonBytes,%d);"
        "let c=ux_u32_put(GlbResource.bin,512);let d=ux_u32_put(GlbResource.binBytes,42);"
        "let y=ux_f32_put(524,1.25);let z=ux_f32_put(540,2.5);"
        "let j=ux_u8_put(550,2);let k=ux_u8_put(552,1);",bytes);
    const char *cases[]={
        "let a=GltfLoader_trianglePrimitive(0,0,0,640,680);return ux_u32(a+GltfPrimitive.vertices);",
        "let a=GltfLoader_trianglePrimitive(0,0,0,640,680);return ux_u32(a+GltfPrimitive.indexCount);",
        "let a=GltfLoader_trianglePrimitive(0,0,0,640,680);return ux_u32(a+GltfPrimitive.material);",
        "let a=GltfLoader_trianglePrimitive(0,0,0,640,680);let p=ux_u32(a+GltfPrimitive.index);"
        "let b=ux_u32(p+GltfAccessor.bytes);return ux_u8(b+2);",
        "let a=GltfLoader_trianglePrimitive(0,0,0,640,680);let p=ux_u32(a+GltfPrimitive.position);"
        "let b=ux_u32(p+GltfAccessor.bytes);return ux_f32(b+28);",
        "let invalid=ux_u8_put(552,3);return GltfLoader_trianglePrimitive(0,0,0,640,680);",
        "let watch=ux_u32_put(640,777);let invalid=ux_u8_put(552,3);"
        "let rejected=GltfLoader_trianglePrimitive(0,0,0,640,680);return ux_u32(640);",
        "return GltfLoader_trianglePrimitive(0,1,0,640,680);"
    };
    const double gold[]={3,3,2,2,2.5,-5,777,-2};
    return g_math_run("G_IO GltfPrimitive","gltf-primitive",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?4:-1,
        "let a=GltfLoader_trianglePrimitive(0,0,0,640,680);let p=ux_u32(a+GltfPrimitive.position);"
        "let b=ux_u32(p+GltfAccessor.bytes);return ux_f32(b+12);");
}
