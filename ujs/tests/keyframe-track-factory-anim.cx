#pragma unisa use g_math
#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define FIX "ujs/practice/uxe/test/keyframe-track-factory-"

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],wasm[320],page[320],url[400];
    if(sy_mkdtemp("/tmp","uxe-interpolant-class-",dir,sizeof dir)) return 2;
    const double gold[]={2,1,0,2,2300,2.4375,12,0.5,2301,(float)0.7071067811865476,0,1,1,2301,-1,4,-1,-1};
    enum { count=sizeof gold/sizeof gold[0], oracle_count=14 };
    tx_snprintf(wasm,sizeof wasm,"%s/probe.wasm",dir);
    tx_snprintf(page,sizeof page,"%s/probe.html",dir);
    tx_snprintf(url,sizeof url,"file://%s?count=%d&mutate=%d",page,count,mutate);
    char *compile[]={"./ujs/ujs2wasm.com","ujs/practice/uxe/test/interpolant-family-class-api.ujs",BASE "f64-math.ujs",
        BASE "record-copy.ujs",BASE "animation-view.ujs",BASE "keyframe-track.ujs",
        BASE "interpolant-family-class.ujs",BASE "keyframe-track-factory.ujs",
        FIX "probe.ujs","-o",wasm,0};
    double actual[count],reference[count]={0};
    char *out=0;
    size_t bytes=0;
    const int rc=cx_runv_timeout(compile,6,&out,&bytes);
    if(rc) printf("TRACK_FACTORY compile_rc=%d %.*s\n",rc,(int)bytes,out?out:"");
    mm_free(out);
    int failed=rc || sy_copy(FIX "wasm.html",page,0600) ||
        r160_wait_ref("keyframe-track-factory",reference,oracle_count,dir) ||
        r160_wait_read(url,"#wasm-cases",actual,count,dir);
    for(int i=0;!failed && i<count;i++) {
        if(!g_math_near(actual[i],gold[i],1e-9) || (i<oracle_count && !g_math_near(reference[i],gold[i],1e-9))) {
            printf("TRACK_FACTORY case=%d actual=%.17g r160=%.17g gold=%.17g\n",i,actual[i],reference[i],gold[i]);
            failed=1;
        }
    }
    if(sy_remove_all(dir)) failed=1;
    printf("TRACK_FACTORY cases=%d oracle=%d failed=%d\n",count,oracle_count,failed);
    return failed;
}
