#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d",
        "object3d-lifecycle","lod","lod-lifecycle",0};
    const char *setup="let srcArena=Object3D_initArena(0,6);let dstArena=Object3D_initArena(3000,6);"
        "let root=Object3D_create(srcArena);let near=Object3D_create(srcArena);"
        "let far=Object3D_create(srcArena);let grand=Object3D_create(srcArena);"
        "let extra=Object3D_create(srcArena);let target=Object3D_create(dstArena);"
        "let lod=LOD_init(6000,srcArena,root,6144,2);let copy=LOD_init(6048,dstArena,target,6208,2);"
        "let present=Object3D_add(srcArena,root,extra);let nested=Object3D_add(srcArena,far,grand);"
        "let a=LOD_addLevel(lod,srcArena,far,10.0,0.25);let b=LOD_addLevel(lod,srcArena,near,0.0,0.0);"
        "let auto=ux_u32_put(lod+LOD.autoUpdate,0);"
        "let targetRecord=Object3D_address(dstArena,target);"
        "let fail=LOD_clone(copy,dstArena,lod,srcArena);if(fail<0){return 0.0+fail;}"
        "let farCopy=ux_u32(6208+LODLevel.size+LODLevel.node);"
        "let farRecord=Object3D_address(dstArena,farCopy);";
    const char *cases[]={
        "return 0.0+ux_u32(copy+LOD.count);",
        "return ux_f64(6208+LODLevel.size+LODLevel.distance);",
        "return ux_f64(6208+LODLevel.size+LODLevel.hysteresis);",
        "return 0.0+ux_u32(copy+LOD.autoUpdate);",
        "return 0.0+(farRecord>=0 && ux_u32(farRecord+Object3D.parent)==target && ux_u32(farRecord+Object3D.firstChild)!=0);",
        "let freed=LOD_dispose(copy,dstArena);"
        "return 0.0+(freed==0 && Object3D_address(dstArena,target)<0 && Object3D_address(srcArena,root)>=0);",
    };
    const double gold[]={2,10,0.25,0,1,1};
    return g_wasm_batch("G_STRUCT LOD clone","lod-lifecycle",modules,setup,cases,gold,6,
        mutate?2:-1,"return ux_f64(6208+LODLevel.hysteresis);");
}
