#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define GLTF_DELTA "let built=AnimationUtils_makeClipAdditive(target,reference,request,2048,1024);"

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","f64-math","quaternion","animation-view","keyframe-track","animationclip",
        "animation-window","animation-subclip","discreteinterpolant","linearinterpolant","cubicinterpolant",
        "quaternionlinearinterpolant","animation-additive","animation-additive-quat","animation-track-delta",
        "gltf-cubic-interpolant","animation-gltf-numeric-delta","animation-gltf-quat-delta","animation-clip-additive",0};
    const char *setup=
        "let a=ux_u8_put(64,97);let b=ux_u8_put(65,98);"
        "let start=ux_f32_put(128,1.0);let stop=ux_f32_put(132,3.0);"
        "let data=[11,8,13,17,12,19,8,12,2,10,99,2,4,-2,10,99];"
        "let i=0;while(i<16){let p=ux_f32_put(160+i*4,0.0+data[i]);i=i+1;}"
        "let v0=AnimationSamples_init(256,128,160,2,3);let v1=AnimationSamples_init(272,128,184,2,1);"
        "let v2=AnimationSamples_init(288,128,192,2,1);let v3=AnimationSamples_init(304,128,200,2,3);"
        "let t0=KeyframeTrack_init(384,64,1,v0);let t1=KeyframeTrack_init(400,65,1,v1);"
        "let t2=KeyframeTrack_init(416,64,1,v2);let t3=KeyframeTrack_init(432,65,1,v3);"
        "let p0=ux_u32_put(512,t0);let p1=ux_u32_put(516,t1);let p2=ux_u32_put(528,t2);let p3=ux_u32_put(532,t3);"
        "let k0=ux_u32_put(544,9);let k1=ux_u32_put(548,1);let k2=ux_u32_put(560,1);let k3=ux_u32_put(564,9);"
        "let target=AnimationClip_init(640,64,1,512,2,3.0,2500);"
        "let reference=AnimationClip_init(704,64,1,528,2,3.0,2500);let request=768;"
        "let tk=ux_u32_put(request+AnimationAdditiveRequest.targetKinds,544);"
        "let rk=ux_u32_put(request+AnimationAdditiveRequest.referenceKinds,560);"
        "let f=ux_f64_put(request+AnimationAdditiveRequest.frame,60.0);";
    const char *cases[]={
        GLTF_DELTA "return ux_f32(ux_u32(v0+AnimationSamples.values)+4);",
        GLTF_DELTA "return ux_f32(ux_u32(v0+AnimationSamples.values)+16);",
        GLTF_DELTA "return ux_f32(ux_u32(v0+AnimationSamples.values)+20);",
        GLTF_DELTA "return ux_f32(ux_u32(v1+AnimationSamples.values));",
        GLTF_DELTA "return ux_f32(ux_u32(v1+AnimationSamples.values)+4);",
        GLTF_DELTA "return 0.0+ux_u32(target+AnimationClip.blendMode);",
        "let fail=AnimationUtils_makeClipAdditive(target,reference,request,2048,640);"
        "return ux_f32(ux_u32(v0+AnimationSamples.values)+4);"
    };
    const double gold[]={2,6,19,.5,4.5,2501,8};
    return g_wasm_batch("G_ANIM AnimationUtils mixed GLTF clip","animation-clip-gltf",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let time=ux_f64_put(request+AnimationAdditiveRequest.frame,90.0);"
        GLTF_DELTA "return ux_f32(ux_u32(v1+AnimationSamples.values));");
}
