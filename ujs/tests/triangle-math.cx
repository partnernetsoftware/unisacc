#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"vector-scalar","vector3","box3","triangle",0};
    const char *setup="let a=Vector3_set(0,0.0,0.0,2.0);let b=Vector3_set(24,4.0,0.0,2.0);"
        "let c=Vector3_set(48,0.0,4.0,2.0);let t=Triangle_set(72,a,b,c);"
        "let p=Vector3_set(144,1.0,2.0,3.0);let q=Vector3_set(168,4.0,4.0,3.0);";
    const char *cases[]={
        "let v=Triangle_set(192,a,b,c);return ux_f64(v+24);",
        "let v=Triangle_setFromPointsAndIndices(192,a,2,1,0);return ux_f64(v+8);",
        "let r=ux_f32_put(296,4.0);let v=Triangle_setFromAttributeAndIndices(192,280,16,1,2,0);return ux_f64(v);",
        "let v=Triangle_copy(192,t);return ux_f64(v+56);","let v=Triangle_clone(192,t);return ux_f64(v+24);",
        "return Triangle_getArea(t,192);","let v=Triangle_getMidpoint(192,t);return ux_f64(v+8);",
        "let v=Triangle_getNormal(192,t);return ux_f64(v+16);","let v=Triangle_getPlane(192,t);return ux_f64(v+24);",
        "let v=Triangle_getBarycoord(192,t,p);return ux_f64(v+16);",
        "let x=ux_f64_put(296,1.0);let y=ux_f64_put(320,1.0);let v=Triangle_getUV(192,t,p,280,208);return ux_f64(v+8);",
        "let v=Triangle_getInterpolation(192,t,p,a,3,216);return ux_f64(v);",
        "return Triangle_containsPoint(t,p,192);","return Triangle_containsPoint(t,q,192);",
        "let v=Vector3_set(192,0.0,0.0,0.0-1.0);return Triangle_isFrontFacing(t,v,216);",
        "let l=Vector3_set(288,0.0,0.0,0.0);let h=Vector3_set(312,2.0,2.0,3.0);"
        "let u=Box3_set(192,l,h);return Triangle_intersectsBox(t,u);",
        "let v=Triangle_closestPointToPoint(192,t,p,216);return ux_f64(v+16);",
        "let v=Triangle_closestPointToPoint(192,t,q,216);return ux_f64(v);",
        "let v=Triangle_clone(192,t);return Triangle_equals(t,v);",
        "let v=Triangle_set(t,a,a,a);return Triangle_getBarycoord(192,v,p);",
        "let v=Triangle_set(t,a,a,a);return Triangle_containsPoint(v,a,192);"
    };
    const double gold[]={4,4,4,4,4,8,4.0/3,1,-2,0.5,0.5,1,1,0,1,1,2,2,1,-1,0};
    return g_math_run("G_MATH Triangle","triangle",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?9:-1,"let v=Triangle_getBarycoord(192,t,p);return ux_f64(v+8);");
}
