#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"helper-buffers","axeshelper","box3helper","boxhelper","helper-family-shared-geometry",0};
    const char *setup=
        "let axes=AxesHelper_init(0,128,256,2.0);let ac=AxesHelper_copy(32,axes);let al=AxesHelper_clone(64,ac);"
        "let c=ux_f32_put(400,0.25);let changed=AxesHelper_setColors(al,400);"
        "let smax=ux_f64_put(536,2.0);"
        "let dmin=ux_f64_put(576,4.0);let dmax=ux_f64_put(600,8.0);"
        "let box=Box3Helper_init(448,512,700,800);let bc=Box3Helper_init(464,576,864,960);"
        "let copied=Box3Helper_copy(bc,box);let bl=Box3Helper_clone(480,box);"
        "let maxx=ux_f64_put(2456,2.0);"
        "let bh=BoxHelper_init(2048,2432,2560,2700,16776960);"
        "let bhc=BoxHelper_init(2176,2496,2816,2976,255);"
        "let bh_copy=BoxHelper_copy(bhc,bh);let bh_clone=BoxHelper_clone(2304,bh);"
        "if(ac!=32 || al!=64 || changed!=64 || copied!=464 || bl!=480 ||"
        "bh!=2048 || bh_copy!=2176 || bh_clone!=2304){return 0.0-123.0;}";
    const char *cases[]={
        "return ux_f32(ux_u32(axes+AxesHelper.colors));",
        "return 0.0+AxesHelper_getColorVersion(axes);",
        "let gone=AxesHelper_dispose(axes);let changed=AxesHelper_setColors(al,400);"
        "return 0.0+AxesHelper_getColorVersion(ac);",
        "let result=Box3Helper_pose(bc,1040);if(result!=1){return 0.0-123.0;}return ux_f64(1040);",
        "return 0.0+Box3Helper_pose(bl,1040);",
        "let ready=Box3Helper_bindBox(bl,512);let result=Box3Helper_pose(bl,1040);"
        "if(ready!=480 || result!=1){return 0.0-123.0;}return ux_f64(1040);",
        "let x=ux_u32(box+Box3Helper.positions);"
        "return 0.0+(ux_u32(bl+Box3Helper.positions)==x && ux_u32(bc+Box3Helper.positions)==x);",
        "let a=AxesHelper_clone(128,axes);let b=Box3Helper_clone(800,box);"
        "return 0.0+(a==0-1 && b==0-1);",
        "return 0.0+(ux_u32(bhc+BoxHelper.box)==2432 && ux_u32(bh_clone+BoxHelper.box)==2432);",
        "let moved=ux_f64_put(2456,5.0);let refresh=BoxHelper_update(bh_clone);"
        "if(refresh!=1) { return 0.0-123.0; }return ux_f32(ux_u32(bhc+BoxHelper.positions));",
        "let version=BoxHelper_getPositionVersion(bh);let moved=ux_f64_put(2456,5.0);"
        "let refresh=BoxHelper_update(bh_clone);if(refresh!=1) { return 0.0-123.0; }"
        "return 0.0+(BoxHelper_getPositionVersion(bhc)-version);",
        "let moved=ux_f64_put(2456,5.0);let refresh=BoxHelper_update(bh_clone);"
        "let state=BoxHelper_geometryState(bhc);if(refresh!=1 || state<0) { return 0.0-123.0; }"
        "return ux_f64(state+8);",
        "let state=BoxHelper_geometryState(bh);let changed=ux_u32_put(state,65280);"
        "return 0.0+ux_u32(BoxHelper_geometryState(bh_clone));",
    };
    const double gold[]={0.25,1,2,6,-1,1,1,1,1,5,1,2.5,65280};
    return g_wasm_batch_page("G_STRUCT Helper shared geometry","helper-family-shared-geometry",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let wrong=Box3Helper_bindBox(bc,512);let result=Box3Helper_pose(bc,1040);return ux_f64(1040);");
}
