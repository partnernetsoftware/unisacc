#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"

#define SHADER_PROGRAM_LIMIT 16

typedef struct {
    char name[9];
    int topology,textured,point_size,groups_n;
    int groups[16];
    unsigned char *text[2];
    int64_t size[2];
} ShaderProgram;

static int shader_names(char groups[24][25],int *count) {
    unsigned char *data=0;
    int64_t bytes=0;
    if(sy_read_file(BASE "uniforms-lib.tsv",&data,&bytes,16384)) return 1;
    int at=0,failed=0;
    while(at<bytes && data[at]!='\n') at++;
    for(at++;!failed && at<bytes;) {
        int end=at;
        while(end<bytes && data[end]!='\t' && data[end]!='\n') end++;
        if(end==at || end==bytes || data[end]!='\t' || end-at>=25) { failed=1; break; }
        if(*count==0 || !tx_same(groups[*count-1],tx_len(groups[*count-1],25),(char *)data+at,end-at)) {
            if(*count>=24) { failed=1; break; }
            tx_snprintf(groups[(*count)++],25,"%.*s",end-at,data+at);
        }
        while(end<bytes && data[end]!='\n') end++;
        at=end+1;
    }
    mm_free(data);
    return failed || *count==0;
}

static int shader_asset(ShaderProgram *program,int stage,const char *name) {
    const char *suffix=stage==0?".vert":".frag";
    int len=tx_len(name,100);
    if(len<6 || len>=100 || !tx_eqz(name+len-5,suffix)) return 1;
    for(int i=0;i<len-5;i++) if((name[i]<'a' || name[i]>'z') && name[i]!='-') return 1;
    char path[170];
    tx_snprintf(path,sizeof path,BASE "%s",name);
    int rc=sy_read_file(path,&program->text[stage],&program->size[stage],4096);
    if(rc || program->size[stage]<=0) return 1;
    for(int i=0;i<program->size[stage];i++) {
        if(program->text[stage][i]==0 || program->text[stage][i]>127) return 1;
    }
    return 0;
}

static int shader_row(ShaderProgram *program,char *line,int bytes,char groups[24][25],int count) {
    char *fields[7]={line};
    int columns=1;
    for(int i=0;i<bytes;i++) if(line[i]=='\t') {
        if(columns>=7) return 1;
        line[i]=0;
        fields[columns++]=line+i+1;
    }
    if(columns!=7) return 1;
    int name=tx_len(fields[0],9);
    if(name<=0 || name>=9) return 1;
    for(int i=0;i<name;i++) if(fields[0][i]<'a' || fields[0][i]>'z') return 1;
    tx_snprintf(program->name,sizeof program->name,"%s",fields[0]);
    int numeric[3];
    const int limits[]={4,1,64};
    for(int i=0;i<3;i++) {
        char *end=0;
        const char *start=fields[3+i];
        long value=tx_strtol(start,&end,10);
        if(end==start || *end || value<0 || value>limits[i]) return 1;
        numeric[i]=value;
    }
    program->topology=numeric[0]; program->textured=numeric[1]; program->point_size=numeric[2];
    if((numeric[0]==1)!=(numeric[2]>0) || (numeric[1] && numeric[0])) return 1;
    for(char *start=fields[6];;) {
        char *end=start;
        while(*end && *end!=',') end++;
        int group=-1;
        for(int i=0;i<count;i++) if(tx_same(groups[i],tx_len(groups[i],25),start,end-start)) group=i;
        if(group<0 || program->groups_n>=16) return 1;
        for(int i=0;i<program->groups_n;i++) if(program->groups[i]==group) return 1;
        program->groups[program->groups_n++]=group;
        if(!*end) break;
        start=end+1;
    }
    return shader_asset(program,0,fields[1]) || shader_asset(program,1,fields[2]);
}

static int shader_read(ShaderProgram programs[SHADER_PROGRAM_LIMIT]) {
    const char header[]="name\tvertex\tfragment\ttopology\ttextured\tpoint_size\tuniform_groups\n";
    char groups[24][25];
    unsigned char *data=0;
    int64_t bytes=0;
    int groups_n=0;
    int failed=shader_names(groups,&groups_n) || sy_read_file(BASE "shader-lib.tsv",&data,&bytes,4096);
    if(!failed && (bytes<sizeof header-1 || !tx_prefix((char *)data,bytes,header,sizeof header-1))) failed=1;
    int rows=0;
    for(int at=sizeof header-1; !failed && at<bytes;) {
        int end=at;
        while(end<bytes && data[end]!='\n') end++;
        if(end>=bytes || rows>=SHADER_PROGRAM_LIMIT) { failed=1; break; }
        data[end]=0;
        failed=shader_row(&programs[rows],(char *)data+at,end-at,groups,groups_n);
        for(int i=0;!failed && i<rows;i++) failed=tx_eqz(programs[i].name,programs[rows].name);
        rows++;
        at=end+1;
    }
    mm_free(data);
    return failed || rows<2 ? -1 : rows;
}

static int64_t shader_word(const unsigned char *text,int bytes) {
    int64_t word=0;
    for(int i=0;i<bytes;i++) word|=(int64_t)text[i]<<(8*i);
    return word;
}

static int shader_generate(const ShaderProgram programs[2],char *out,int capacity,int mutate) {
    int used=0;
    int count=0;
    while(count<SHADER_PROGRAM_LIMIT && programs[count].name[0]) count++;
#define EMIT(...) do { int n=tx_snprintf(out+used,capacity-used,__VA_ARGS__); if(n<0 || n>=capacity-used) return -1; used+=n; } while(0)
    EMIT("// Generated by shader-lib-gen.cx from repository GLSL.\n"
         "native function ShaderLib_count() i64 { return %d; }\n"
         "native function shader_lib_fact(program:i64,field:i64) i64 {\n",count);
    for(int i=0;i<count;i++) {
        const ShaderProgram *p=&programs[i];
        int length=tx_len(p->name,sizeof p->name);
        EMIT("  if(program==%d) { let values=[%d,%lld,%d,%d,%d,%lld,%lld,%d]; return values[field]; }\n",
            i,length,(long long)shader_word((const unsigned char *)p->name,length),p->topology,p->textured,p->point_size,
            (long long)p->size[0],(long long)p->size[1],p->groups_n);
    }
    EMIT("  return 0-1;\n}\nnative function shader_lib_group(program:i64,index:i64) i64 {\n");
    for(int i=0;i<count;i++) {
        EMIT("  if(program==%d) { let groups=[",i);
        for(int j=0;j<programs[i].groups_n;j++) EMIT("%s%d",j?",":"",programs[i].groups[j]+(mutate && i==1 && j==0));
        EMIT("]; return groups[index]; }\n");
    }
    EMIT("  return 0-1;\n}\nnative function shader_lib_block(out:i64,program:i64,stage:i64,block:i64) i64 {\n");
    for(int i=0;i<count;i++) for(int stage=0;stage<2;stage++) {
        const int bytes=programs[i].size[stage];
        for(int start=0;start<bytes;start+=1024) {
            const int stop=bytes-start>1024?start+1024:bytes;
            EMIT("  if(program==%d && stage==%d && block==%d) { let words=[",
                i,stage,start/1024);
            for(int at=start;at<stop;at+=8) EMIT("%s%lld",at>start?",":"",
                (long long)shader_word(programs[i].text[stage]+at,stop-at>8?8:stop-at));
            EMIT("]; let i=0; let word=0; while(i<%d) { "
                "if(i%%8==0) { word=words[i/8]; } "
                "let saved=ux_u8_put(out+i,word%%256); word=word/256; i=i+1; } return out+i; }\n",stop-start);
        }
    }
    EMIT("  return 0-1;\n}\n");
#undef EMIT
    return used;
}

int main(int argc,char **argv) {
    int write=argc==2 && tx_eqz(argv[1],"--write");
    int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    ShaderProgram programs[SHADER_PROGRAM_LIMIT]={0};
    char code[65536];
    const int count=shader_read(programs);
    int size=count<0?-1:shader_generate(programs,code,sizeof code,mutate);
    const char *path=BASE "shader-lib-generated.ujs";
    unsigned char *old=0;
    int64_t bytes=0;
    int failed=size<0 || (write?sy_write_file(path,code,size,0644):
        sy_read_file(path,&old,&bytes,sizeof code) || !tx_same((char *)old,bytes,code,size));
    for(int i=0;i<SHADER_PROGRAM_LIMIT;i++) for(int j=0;j<2;j++) mm_free(programs[i].text[j]);
    mm_free(old);
    printf("SHADER_LIB_GENERATE programs=%d failed=%d\n",count,failed);
    return failed;
}
