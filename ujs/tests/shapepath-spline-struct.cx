#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"curve-line","curve-bezier","record-copy","path","shape","path-lifecycle","shapepath",0};
    const char *setup="let values=[1,1,2,0,3,1,4,0];let i=0;"
        "while(i<8){let w=ux_f64_put(256+i*8,0.0+values[i]);i=i+1;}"
        "let shape=ShapePath_init(0,64,2);let path=Path_init(96,512,4);"
        "let start=ShapePath_moveTo(shape,path,512,4,0.0,0.0);"
        "let spline=ShapePath_splineThru(shape,256,4);let line=ShapePath_lineTo(shape,5.0,1.0);"
        "let points=Path_getPoints(path,1024,8,1,1304);";
    const char *cases[]={
        "return points;","return ux_f64(1040);","return ux_f64(1048);","return ux_f64(1104);","return ux_f64(1120);",
        "let clone=Path_clone(1536,path,1792,4);let damage=ux_f64_put(536,100.0);"
        "let read=Path_getPoints(clone,2304,8,1,2560);return ux_f64(2320);",
        "return ShapePath_splineThru(shape,256,4);"
    };
    const double gold[]={7,.784,.912,4,5,.784,-1};
    return g_math_run("G_STRUCT ShapePath spline","shapepath-spline",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,"return ux_f64(1040);");
}
