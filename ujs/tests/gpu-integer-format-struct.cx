#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int red=argc==2 && tx_eqz(argv[1],"--mutate-red");
    const int rg=argc==2 && tx_eqz(argv[1],"--mutate-rg");
    const int rgba=argc==2 && tx_eqz(argv[1],"--mutate-rgba");
    if(argc!=1 && !red && !rg && !rgba) return 2;
    const char *modules[]={"gpu-texture-sample","gpu-integer-format","gpu-integer-format-generated",0};
    const char *setup="let i=0;while(i<8){let value=1000+i*100;"
        "let a=ux_u8_put(128+2*i,value%256);let b=ux_u8_put(129+2*i,value/256);i=i+1;}";
    const char *cases[]={
        "return GpuIntTexture_component(1029,128,2,1,0.75,0.0,0);",
        "return GpuIntTexture_component(1029,128,2,1,0.75,0.0,3);",
        "return GpuIntTexture_component(1031,128,2,1,0.75,0.0,1);",
        "return GpuIntTexture_component(1031,128,2,1,0.75,0.0,2);",
        "return GpuIntTexture_component(1033,128,2,1,0.75,0.0,0);",
        "return GpuIntTexture_component(1033,128,2,1,0.75,0.0,3);",
    };
    const double gold[]={1100,1,1300,0,1400,1700};
    return g_math_run("G_STRUCT GPU integer texture formats","gpu-integer-format",modules,setup,cases,gold,6,
        red?0:rg?2:rgba?5:-1, red?cases[2]:rg?cases[0]:cases[1]);
}
