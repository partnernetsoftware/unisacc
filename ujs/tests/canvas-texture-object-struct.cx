#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"views","record-copy","gpu-packet","gpu-texture-table","texture-object","canvas-texture-object",0};
    const char *setup="let table=GpuTextureTable_init(0,2);let image=512;"
        "let w=ux_u32_put(image+GpuTextureSource.width,1);let h=ux_u32_put(image+GpuTextureSource.height,1);"
        "let pointer=ux_u32_put(image+GpuTextureSource.rgba,600);let red=ux_u8_put(600,27);"
        "let source=CanvasTexture_init(640,table,image);if(source<0){return 0.0+source;}"
        "let key=ux_u32(source+Texture.handle);let initial=GpuTextureTable_version(table,key)-1;"
        "let copy=CanvasTexture_clone(672,source);let copyKey=ux_u32(copy+Texture.handle);";
    const char *cases[]={
        "return 0.0+initial;",
        "let in=ux_u32_put(image+GpuTextureSource.rgba,608);let red=ux_u8_put(608,49);"
        "let version=CanvasTexture_refresh(source);let descriptor=gpu_texture_source(table,key);"
        "return 0.0+ux_u8(ux_u32(descriptor+GpuTextureSource.rgba));",
        "return 0.0+(CanvasTexture_refresh(source)-1-initial);",
        "return 0.0+(copyKey!=key && ux_u32(copy+Texture.source)==ux_u32(source+Texture.source));",
        "let bad=ux_u32_put(image+GpuTextureSource.width,0);let refused=CanvasTexture_refresh(source);"
        "return 0.0+(refused<0 && GpuTextureTable_version(table,key)==initial+1);",
    };
    const double gold[]={1,49,1,1,1};
    return g_wasm_batch_page("G_STRUCT CanvasTexture snapshot","canvas-texture-object",
        "ujs/practice/uxe/test/wasm-batch-gpu-layout.html",modules,setup,cases,gold,5,mutate?1:-1,
        "let descriptor=gpu_texture_source(table,key);return 0.0+ux_u8(ux_u32(descriptor+GpuTextureSource.rgba));");
}
