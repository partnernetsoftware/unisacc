#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"vector-scalar","object-layouts","vector3","ray","raycaster",0};
    /* Independent inverse of the 90-degree perspective and -4..4 by -2..2 orthographic projections. */
    const char *setup="let p=1024;let o=1280;let pm=2048;let pi=2176;let om=2560;let oi=2688;let w=3200;"
        "let c0=ux_u32_put(p+Camera.coordinateSystem,2000);let c1=ux_u32_put(o+Camera.coordinateSystem,2000);"
        "let p0=ux_u32_put(p+Camera.projectionMatrix,pm);let p1=ux_u32_put(p+Camera.projectionMatrixInverse,pi);"
        "let o0=ux_u32_put(o+Camera.projectionMatrix,om);let o1=ux_u32_put(o+Camera.projectionMatrixInverse,oi);"
        "let p2=ux_f64_put(pi,2.0);let p3=ux_f64_put(pi+40,1.0);let p4=ux_f64_put(pi+88,0.0-1.0/2.2);"
        "let p5=ux_f64_put(pi+112,0.0-1.0);let p6=ux_f64_put(pi+120,1.2/2.2);"
        "let o2=ux_f64_put(om+112,0.0-1.2);let o3=ux_f64_put(oi,4.0);let o4=ux_f64_put(oi+40,2.0);"
        "let o5=ux_f64_put(oi+80,0.0-5.0);let o6=ux_f64_put(oi+112,0.0-6.0);let o7=ux_f64_put(oi+120,1.0);"
        "let w0=ux_f64_put(w,1.0);let w1=ux_f64_put(w+40,1.0);let w2=ux_f64_put(w+80,1.0);"
        "let w3=ux_f64_put(w+120,1.0);let t=Vector3_set(w+96,3.0,4.0,5.0);let n=Vector3_set(3400,0.5,0.0-0.5,0.0);";
    const char *cases[]={
        "let r=Raycaster_setFromCamera(3504,p,w,n,1,3600);return ux_f64(r+Ray.oz);",
        "let r=Raycaster_setFromCamera(3504,p,w,n,1,3600);return ux_f64(r+Ray.dx);",
        "let r=Raycaster_setFromCamera(3504,p,w,n,1,3600);return ux_f64(r+Ray.dy);",
        "let r=Raycaster_setFromCamera(3504,o,w,n,2,3600);return ux_f64(r+Ray.ox);",
        "let r=Raycaster_setFromCamera(3504,o,w,n,2,3600);return ux_f64(r+Ray.oy);",
        "let r=Raycaster_setFromCamera(3504,o,w,n,2,3600);return ux_f64(r+Ray.oz);",
        "let r=Raycaster_setFromCamera(3504,o,w,n,2,3600);return ux_f64(r+Ray.dz);",
        "return Raycaster_setFromCamera(3504,p,w,n,3,3600);",
        "return Raycaster_setFromCamera(3504,p,w,n,1,3504);"
    };
    const double gold[]={5,2.0/3,-1.0/3,5,3,5,-1,-1,-1};
    return g_math_run("G_RAY RaycasterCamera","raycaster-camera",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let r=Raycaster_setFromCamera(3504,p,w,n,1,3600);return ux_f64(r+Ray.dy);");
}
