#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define SAMPLE(at,capacity) "let decoded=CompressedTexture_decodeEAC(32,512," #capacity ");return 0.0+ux_u8(512+" #at ")+256*ux_u8(513+" #at ");"

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","compressedtextureloader","compressed-texture-eac",0};
    const char *setup="let mip=CompressedTextureLoader_level(32,128,8,3,3,33776);"
        "let f=ux_u32_put(32+CompressedMip.format,37488);"
        "let base=ux_u8_put(128,103);let flags=ux_u8_put(129,45);let idx=ux_u8_put(130,12);";
    const char *cases[]={
        "return 0.0+CompressedTexture_decodeEAC(32,512,18);",
        SAMPLE(0,18), SAMPLE(6,18), SAMPLE(2,18),
        "let multiplier=ux_u8_put(129,13);" SAMPLE(6,18),
        "let lo=ux_u8_put(128,0);" SAMPLE(6,18),
        "let hi=ux_u8_put(128,255);let sel=ux_u8_put(130,224);" SAMPLE(0,18),
        "let signed=ux_u32_put(32+CompressedMip.format,37489);let min=ux_u8_put(128,128);" SAMPLE(0,18),
        "let signed=ux_u32_put(32+CompressedMip.format,37489);let min=ux_u8_put(128,128);"
            "let multiplier=ux_u8_put(129,13);" SAMPLE(0,18),
        "let signed=ux_u32_put(32+CompressedMip.format,37489);let zero=ux_u8_put(128,0);"
            "let sel=ux_u8_put(130,128);" SAMPLE(0,18),
        "let rg=ux_u32_put(32+CompressedMip.format,37490);let bytes=ux_u32_put(32+CompressedMip.bytes,16);"
            "let green=ux_u8_put(136,20);let gt=ux_u8_put(137,13);let gi=ux_u8_put(138,128);" SAMPLE(2,36),
        "let rg=ux_u32_put(32+CompressedMip.format,37491);let bytes=ux_u32_put(32+CompressedMip.bytes,16);"
            "let green=ux_u8_put(136,255);let gt=ux_u8_put(137,13);let gi=ux_u8_put(138,128);" SAMPLE(2,36),
        "return 0.0+CompressedTexture_decodeEAC(32,512,17);",
        "return 0.0+CompressedTexture_decodeEAC(32,128,18);",
        "let wrong=ux_u32_put(32+CompressedMip.format,37492);return 0.0+CompressedTexture_decodeEAC(32,512,18);",
        "let truncated=ux_u32_put(32+CompressedMip.bytes,7);return 0.0+CompressedTexture_decodeEAC(32,512,18);",
    };
    const double gold[]={18,812,668,812,818,0,2047,64513,64519,0,164,65528,-1,-1,-2,-3};
    return g_wasm_batch("G_IO EAC R11 RG11 software","compressed-texture-eac",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,"let bad=ux_u8_put(130,0);" SAMPLE(6,18));
}
