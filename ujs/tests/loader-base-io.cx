#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","defaultloadingmanager","loader","fileloader","loader-base",0};
    const char *setup="let base=0;let secondary=32;let fresh=48;let separate=LoadingManager_init(64);"
        "let l=Loader_initWithBase(128,base,0-1);let a=FileLoader_initWithBase(160,base,0-1);"
        "let b=FileLoader_initWithBase(192,base,0-1);let c=FileLoader_initWithBase(224,base,separate);"
        "let e=Loader_initWithBase(256,base,separate);let other=FileLoader_initWithBase(288,secondary,0-1);"
        "let active=LoaderBase_default(base);let distinct=LoaderBase_default(secondary);"
        "let ea=512;let eb=576;let ec=640;let eo=704;let payload=900;let sample=ux_u8_put(payload,65);"
        "let aID=FileLoader_begin(a,ea);let bID=FileLoader_begin(b,eb);let cID=FileLoader_begin(c,ec);";
    const char *cases[]={
        "return 0.0+(ux_u32(l+Loader.manager)==active && ux_u32(a+FileLoader.manager)==active && ux_u32(b+FileLoader.manager)==active);",
        "return 0.0+(ux_u32(c+FileLoader.manager)==separate && ux_u32(e+Loader.manager)==separate && separate!=active);",
        "return 0.0+ux_u32(ea+LoadingEvent.total);",
        "return 0.0+ux_u32(eb+LoadingEvent.kind);",
        "let late=Loader_initWithBase(352,base,active);return 0.0+ux_u32(ux_u32(late+Loader.manager)+LoadingManager.total);",
        "return 0.0+FileLoader_receive(c,cID,200,payload,1,ec);",
        "let ended=FileLoader_receive(c,cID,200,payload,1,ec);return 0.0+ux_u32(active+LoadingManager.loaded);",
        "return 0.0+FileLoader_receive(a,aID,200,payload,1,ea);",
        "let ended=FileLoader_receive(a,aID,200,payload,1,ea);return 0.0+ux_u32(ea+LoadingEvent.total);",
        "let ended=FileLoader_receive(a,aID,200,payload,1,ea);return 0.0+ux_u32(ea+LoadingEvent.kind);",
        "let endA=FileLoader_receive(a,aID,200,payload,1,ea);let endB=FileLoader_receive(b,bID,200,payload,1,eb);"
            "return 0.0+ux_u32(eb+LoadingEvent.size+LoadingEvent.kind);",
        "let endA=FileLoader_receive(a,aID,200,payload,1,ea);let endB=FileLoader_receive(b,bID,200,payload,1,eb);"
            "return 0.0+ux_u32(active+LoadingManager.loaded);",
        "let id=FileLoader_begin(other,eo);return 0.0+ux_u32(distinct+LoadingManager.total);",
        "let id=FileLoader_begin(other,eo);return 0.0+ux_u32(LoaderBase_default(base)+LoadingManager.total);",
        "let explicitOnly=Loader_initWithBase(384,fresh,separate);return 0.0+ux_u32(fresh+DefaultLoadingManager.initialized);",
        "return 0.0+Loader_initWithBase(fresh,fresh,0-1);",
        "let invalid=FileLoader_initWithBase(fresh+4,fresh,0-1);return 0.0+ux_u32(fresh+DefaultLoadingManager.initialized);",
        "let overwritten=ux_u32_put(base+DefaultLoadingManager.manager,separate);return 0.0+FileLoader_initWithBase(384,base,0-1);",
        "return 0.0+FileLoader_initWithBase(384,base,base+4);",
        "return 0.0+Loader_initWithBase(384,base,0-2);",
        "let requested=FileLoader_initWithBase(384,fresh,fresh+DefaultLoadingManager.size);"
            "return 0.0+(requested==384 && ux_u32(fresh+DefaultLoadingManager.initialized)==1);",
    };
    const double gold[]={1,1,1,0,2,2,0,1,2,2,4,2,1,2,0,-1,0,-1,-1,-1,1};
    return g_wasm_batch_page("G_IO DefaultLoadingManager loader base","loader-base",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?13:-1,
        "let id=FileLoader_begin(other,eo);return 0.0+ux_u32(LoaderBase_default(secondary)+LoadingManager.total);");
}

