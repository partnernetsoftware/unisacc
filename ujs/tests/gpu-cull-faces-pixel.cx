#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

static int visible(int mode,int clockwise) {
    if(mode==0) return 1;
    if(mode==1) return !clockwise;
    if(mode==2) return clockwise;
    return 0;
}

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char prelude[]=
        "import host_gpu_submit from \"uxe_gpu_v1\" (i64,i64) i64;\n"
        "export uxe_cull_face(value:i64,variant:i64) i64 version 1;\n";
    char dir[220],abi[260],wasm[260],cwd[400],url[760],*out=0;
    size_t size=0;
    if(sy_mkdtemp("/tmp","uxe-cull-faces-",dir,sizeof dir) || sy_cwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/fixture.wasm",dir);
    tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/gpu-cull-faces-r160.html?wasm=%s&mutate=%d",
        cwd,wasm,mutate);
    int failed=sy_write_file(abi,prelude,sizeof prelude-1,0600)!=0;
    char *compile[]={"./ujs/ujs2wasm.com",abi,"ujs/practice/uxe/base/record-copy.ujs",
        "ujs/practice/uxe/base/gpu-packet.ujs","ujs/practice/uxe/base/gpu-state.ujs",
        "ujs/practice/uxe/base/gpu-cull-faces-generated.ujs",
        "ujs/practice/uxe/test/gpu-cull-faces-probe.ujs","-o",wasm,0};
    if(!failed) {
        const int rc=cx_runv_timeout(compile,6,&out,&size);
        if(rc) printf("GPU_CULL_FACES compile_rc=%d %.*s\n",rc,(int)size,out?out:"");
        failed=rc!=0;
        mm_free(out);
        out=0;
    }
    enum { functions=4, variants=2, values=functions*variants*2 };
    double pixels[values]={0};
    if(!failed && r160_wait_read(url,"#r160",pixels,values,dir)) {
        printf("GPU_CULL_FACES browser_read_failed\n");
        failed=1;
    }
    int checked=0;
    if(!failed) for(int v=0;v<variants;v++) for(int tag=0;tag<functions;tag++) {
        const int expected=255*visible(tag,v);
        const int offset=(v*functions+tag)*2;
        if(pixels[offset]!=expected || pixels[offset+1]!=expected) {
            printf("GPU_CULL_FACES tag=%d sample=%d actual=%.0f r160=%.0f gold=%d\n",
                tag,v,pixels[offset],pixels[offset+1],expected);
            failed++;
        }
        checked++;
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&out,&size)) failed++;
    mm_free(out);
    printf("GPU_CULL_FACES modes=%d variants=%d pixels=%d failed=%d\n",functions,variants,checked,failed);
    return failed!=0;
}
