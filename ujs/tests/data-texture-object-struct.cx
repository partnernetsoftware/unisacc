#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"views","record-copy","gpu-packet","gpu-texture-table","texture-object","data-texture-object",0};
    const char *setup="let table=GpuTextureTable_init(0,2);let image=DataTexture_rgba8Source(512,600,2,2);"
        "let r0=ux_u8_put(600,3);let r1=ux_u8_put(604,5);let r2=ux_u8_put(608,13);let r3=ux_u8_put(612,29);"
        "let src=DataTexture_init(640,table,image);let clone=DataTexture_clone(672,src);"
        "if(clone<0){return 0.0+clone;}";
    const char *cases[]={
        "return 0.0+ux_u8(DataTexture_texel(clone,1,1));",
        "return 0.0+ux_u8(DataTexture_texel(clone,0,1));",
        "return 0.0+ux_u32(image+GpuTextureSource.filter);",
        "return 0.0+(ux_u32(src+Texture.source)==ux_u32(clone+Texture.source));",
        "return 0.0+DataTexture_texel(clone,2,1);",
        "return 0.0+DataTexture_rgba8Source(512,6291452,2,2);",
    };
    const double gold[]={29,13,0,1,-1,-1};
    return g_wasm_batch_page("G_STRUCT DataTexture RGBA8","data-texture-object",
        "ujs/practice/uxe/test/wasm-batch-gpu-layout.html",modules,setup,cases,gold,6,mutate?0:-1,
        "return 0.0+ux_u8(DataTexture_texel(clone,0,1));");
}
