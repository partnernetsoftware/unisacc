#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

typedef struct { int name,kind,first,count; double a,b; } UniformRow;
typedef struct { int name,first,count; } UniformGroup;
typedef struct {
    char names[180][25];
    UniformRow rows[96];
    UniformGroup groups[24];
    int fields[80];
    int names_n,rows_n,groups_n,fields_n;
} UniformFacts;

static int uniform_name(UniformFacts *facts,const char *text,int n) {
    if(n<1 || n>=25) return -1;
    for(int i=0;i<n;i++) {
        char c=text[i];
        if(!((c>='A' && c<='Z') || (c>='a' && c<='z') || c=='_' || (i && c>='0' && c<='9'))) return -1;
    }
    for(int i=0;i<facts->names_n;i++) {
        if(tx_same(facts->names[i],tx_len(facts->names[i],25),text,n)) return i;
    }
    if(facts->names_n>=180) return -1;
    int name=facts->names_n++;
    tx_snprintf(facts->names[name],25,"%.*s",n,text);
    return name;
}

static int uniform_fact(UniformFacts *facts,char *line,int n) {
    char *words[6]={line};
    int cols=1;
    for(int i=0;i<n;i++) {
        if(line[i]=='\t') {
            if(cols==6) return 1;
            line[i]=0;
            words[cols++]=line+i+1;
        }
    }
    if(cols!=6 || facts->rows_n>=96) return 1;
    int group=uniform_name(facts,words[0],tx_len(words[0],25));
    int name=uniform_name(facts,words[1],tx_len(words[1],25));
    const char *kinds[]={"null","number","color","matrix3","vec2","array"};
    int kind=-1;
    for(int i=0;i<6;i++) if(tx_eqz(words[2],kinds[i])) kind=i;
    char *stop=0;
    double a=tx_strtod(words[3],&stop);
    if(stop==words[3] || *stop || a-a!=0.0) return 1;
    double b=tx_strtod(words[4],&stop);
    if(stop==words[4] || *stop || b-b!=0.0 || group<0 || name<0 || kind<0) return 1;
    if(((kind==0 || kind==5) && a!=0.0) || ((kind==2 || kind==3) && a!=1.0) || (kind!=4 && b!=0.0)) return 1;

    int group_index=facts->groups_n-1;
    if(group_index<0 || facts->groups[group_index].name!=group) {
        if(facts->groups_n>=24) return 1;
        for(int i=0;i<facts->groups_n;i++) if(facts->groups[i].name==group) return 1;
        group_index=facts->groups_n++;
        facts->groups[group_index].name=group;
        facts->groups[group_index].first=facts->rows_n;
    }
    UniformGroup *current=&facts->groups[group_index];
    for(int i=current->first;i<facts->rows_n;i++) if(facts->rows[i].name==name) return 1;
    UniformRow *row=&facts->rows[facts->rows_n];
    row->name=name; row->kind=kind; row->a=a; row->b=b; row->first=facts->fields_n;
    if(!tx_eqz(words[5],"-")) {
        if(kind!=5) return 1;
        for(char *start=words[5];;) {
            char *p=start;
            while(*p && *p!=',') p++;
            int field=uniform_name(facts,start,p-start);
            if(field<0 || facts->fields_n>=80) return 1;
            for(int i=row->first;i<facts->fields_n;i++) if(facts->fields[i]==field) return 1;
            facts->fields[facts->fields_n++]=field;
            row->count++;
            if(!*p) break;
            start=p+1;
        }
    }
    current->count++;
    facts->rows_n++;
    return 0;
}

static int uniform_read(UniformFacts *facts) {
    const char header[]="group\tname\tkind\ta\tb\tproperties\n";
    unsigned char *data=0;
    int64_t bytes=0;
    int failed=sy_read_file("ujs/practice/uxe/base/uniforms-lib.tsv",&data,&bytes,16384);
    if(!failed && (bytes<sizeof header-1 || !tx_prefix((char *)data,bytes,header,sizeof header-1))) failed=1;
    for(int at=sizeof header-1;!failed && at<bytes;) {
        int end=at;
        while(end<bytes && data[end]!='\n') end++;
        if(end==bytes) { failed=1; break; }
        data[end]=0;
        failed=uniform_fact(facts,(char *)data+at,end-at);
        at=end+1;
    }
    mm_free(data);
    return failed || facts->groups_n!=16 || facts->rows_n==0;
}

static int uniform_literal(char out[48],double value) {
    // The r160 facts are simple decimals. Emit a compact fixed-point literal
    // and reject new facts that cannot roundtrip through this representation.
    int n=tx_snprintf(out,48,"%.12f",value);
    if(n<=0 || n>=48) return 1;
    while(n>1 && out[n-1]=='0' && out[n-2]!='.') n--;
    out[n]=0;
    return tx_strtod(out,0)!=value;
}

static int uniform_emit(const UniformFacts *facts,char *out,int room,int mutate) {
    int used=0;
#define EMIT(...) do { int n=tx_snprintf(out+used,room-used,__VA_ARGS__); if(n<0 || n>=room-used) return -1; used+=n; } while(0)
    EMIT("// Generated by uniforms-lib-gen.cx.\n"
        "native function UniformsLib_groupCount() i64 { return %d; }\n"
        "native function uniforms_group(group:i64,field:i64) i64 {\n",facts->groups_n);
    for(int i=0;i<facts->groups_n;i++) {
        const UniformGroup *g=&facts->groups[i];
        EMIT("  if(group==%d) { let row=[%d,%d,%d]; return row[field]; }\n",i,g->name,g->first,g->count);
    }
    EMIT("  return 0-1;\n}\nnative function uniforms_row(row:i64,field:i64) i64 {\n");
    for(int i=0;i<facts->rows_n;i++) {
        const UniformRow *r=&facts->rows[i];
        EMIT("  if(row==%d) { let value=[%d,%d,%d,%d]; return value[field]; }\n",i,r->name,r->kind,r->first,r->count);
    }
    EMIT("  return 0-1;\n}\nnative function uniforms_arg(row:i64,axis:i64) f64 {\n");
    for(int i=0;i<facts->rows_n;i++) {
        const UniformRow *r=&facts->rows[i];
        double a=r->a+(mutate && i==13?1.0:0.0);
        if(a!=0.0 || r->b!=0.0) {
            char first[48],second[48];
            if(uniform_literal(first,a) || uniform_literal(second,r->b)) return -1;
            EMIT("  if(row==%d) { if(axis==0) { return %s; } return %s; }\n",i,first,second);
        }
    }
    EMIT("  return 0.0;\n}\nnative function uniforms_field(index:i64) i64 {\n  let names=[");
    for(int i=0;i<facts->fields_n;i++) EMIT("%s%d",i?",":"",facts->fields[i]);
    EMIT("];\n  return names[index];\n}\nnative function uniforms_name(token:i64,field:i64) i64 {\n");
    for(int i=0;i<facts->names_n;i++) {
        int len=tx_len(facts->names[i],25);
        int64_t word[3]={0,0,0};
        for(int j=0;j<len;j++) word[j/8]|=(int64_t)(unsigned char)facts->names[i][j]<<(j%8*8);
        EMIT("  if(token==%d) { let value=[%d,%lld,%lld,%lld]; return value[field]; }\n",i,len,
            (long long)word[0],(long long)word[1],(long long)word[2]);
    }
    EMIT("  return 0-1;\n}\n");
#undef EMIT
    return used;
}

int main(int argc,char **argv) {
    int write=argc==2 && tx_eqz(argv[1],"--write");
    int mutate=argc==3 && tx_eqz(argv[1],"--check") && tx_eqz(argv[2],"--mutate");
    if(!write && !mutate && !(argc==2 && tx_eqz(argv[1],"--check"))) return 2;
    UniformFacts facts={0};
    char generated[32768];
    int n=uniform_read(&facts)?-1:uniform_emit(&facts,generated,sizeof generated,mutate);
    const char *path="ujs/practice/uxe/base/uniforms-lib-generated.ujs";
    unsigned char *old=0;
    int64_t bytes=0;
    int failed=n<0 || (write?sy_write_file(path,generated,n,0644):
        sy_read_file(path,&old,&bytes,sizeof generated) || !tx_same((char *)old,bytes,generated,n));
    mm_free(old);
    printf("UNIFORMS_LIB_GENERATE groups=%d entries=%d fields=%d failed=%d\n",facts.groups_n,facts.rows_n,facts.fields_n,failed);
    return failed;
}
