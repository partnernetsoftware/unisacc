#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","loadingmanager","fileloader","glb-container","loaderutils","json-read",
        "loader-json","json-string-decode","gltf-texture-uri",0};
    const char json[]="{\"textures\":[{\"source\":0,\"sampler\":3},{\"source\":1},{\"source\":2},{\"source\":3},{\"source\":4}],"
        "\"images\":[{\"uri\":\"m\\u0061p.png\"},{\"uri\":\"/root.png\"},{\"uri\":\"data:image/png;base64,AAAA\"},"
        "{\"uri\":\"both.png\",\"bufferView\":0},{\"uri\":\"bad\\u0000.png\"}]}";
    const char base[]="https://cdn.example/a/";
    const int size=sizeof json-1;
    char setup[5000];
    int n=tx_snprintf(setup,sizeof setup,
        "let input=128;let opt=640;let out=672;let base=800;let work=1024;let url=2001;"
        "let a=ux_u32_put(0+GlbResource.json,input);let b=ux_u32_put(0+GlbResource.jsonBytes,%d);"
        "let c=ux_u32_put(opt+GltfTextureUriOptions.path,base);"
        "let d=ux_u32_put(opt+GltfTextureUriOptions.pathBytes,%d);"
        "let e=ux_u32_put(opt+GltfTextureUriOptions.work,work);let f=ux_u32_put(opt+GltfTextureUriOptions.workBytes,128);"
        "let path=[",size,(int)sizeof base-1);
    for(int i=0;i<(int)sizeof base-1;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",base[i]);
    n+=tx_snprintf(setup+n,sizeof setup-n,"];let j=0;while(j<%d){let a=ux_u8_put(base+j,path[j]);j=j+1;}",(int)sizeof base-1);
    for(int at=0;at<size;at+=64) {
        int count=size-at;
        if(count>64) count=64;
        n+=tx_snprintf(setup+n,sizeof setup-n,"if(1){let raw=[");
        for(int i=0;i<count;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[at+i]);
        n+=tx_snprintf(setup+n,sizeof setup-n,"];let i=0;while(i<%d){let a=ux_u8_put(input+%d+i,raw[i]);i=i+1;}}",count,at);
    }
    #define READ(at) "let result=GltfLoader_textureUri(0," at ",out,url,128,opt);"
    const char *cases[]={
        READ("0") "return 0.0+ux_u32(out+GltfTextureUri.length);",
        READ("0") "return 0.0+ux_u8(url+23);",
        READ("0") "return 0.0+ux_u32(out+GltfTextureUri.sampler);",
        READ("1") "return 0.0+ux_u32(out+GltfTextureUri.length);",
        READ("1") "return 0.0+ux_u8(url+20);",
        READ("2") "return 0.0+ux_u32(out+GltfTextureUri.inlineData);",
        READ("2") "return 0.0+ux_u32(out+GltfTextureUri.length);",
        READ("3") "return 0.0+result;",
        READ("4") "return 0.0+result;",
        "let keep=ux_u32_put(out+GltfTextureUri.length,77);let result=GltfLoader_textureUri(0,0,out,url,8,opt);"
        "return 0.0+ux_u32(out+GltfTextureUri.length);",
        "return 0.0+GltfLoader_textureUri(0,0,out,work,64,opt);",
    };
    const double gold[]={29,97,3,28,114,1,26,-3,-3,77,-1};
    return g_wasm_batch("G_IO glTF texture URI","gltf-texture-uri",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,READ("0") "return 0.0+ux_u8(url+24);");
}
