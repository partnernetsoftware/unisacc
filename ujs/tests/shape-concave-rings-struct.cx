#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"shapeutils","shape-hole","shape-holes",0};
    const char *setup=
        "let points=[0,0,12,0,12,10,8,10,8,4,4,4,4,10,0,10,1,5,1,7,3,7,3,5,9,5,11,5,11,7,9,7];"
        "let i=0;while(i<32){let v=ux_f64_put(128+i*8,0.0+points[i]);i=i+1;}"
        "let s0=ux_u32_put(416,4);let s1=ux_u32_put(420,4);"
        "let count=ShapeUtils_triangulateHoles(128,8,416,2,512,72,1024,1536);"
        "let area=0.0;let empty=0;let bad=0;i=0;"
        "while(i<count){let a=128+16*ux_u32(512+i*4);let b=128+16*ux_u32(516+i*4);"
        "let c=128+16*ux_u32(520+i*4);let turn=shape_turn(a,b,c);"
        "let x=(ux_f64(a)+ux_f64(b)+ux_f64(c))/3.0;let y=(ux_f64(a+8)+ux_f64(b+8)+ux_f64(c+8))/3.0;"
        "if((x>4.0&&x<8.0&&y>4.0)||(x>1.0&&x<3.0&&y>5.0&&y<7.0)||"
        "(x>9.0&&x<11.0&&y>5.0&&y<7.0)){empty=empty+1;}"
        "if(turn<=0.0){bad=bad+1;}area=area+turn*0.5;i=i+3;}";
    const char *cases[]={"return count/3;","return area;","return empty;","return bad;"};
    const double gold[]={18,88,0,0};
    return g_math_run("G_STRUCT ShapeUtils concave rings","shape-concave-rings",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let lost=ShapeUtils_triangulateHoles(128,8,416,1,512,72,1024,1536);return lost/3;");
}
