#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"curve-hermite","catmullromcurve3",0};
    const char *setup="let bx=ux_f64_put(24,2.0);let by=ux_f64_put(32,2.0);let cx=ux_f64_put(48,4.0);"
        "let one=CatmullRomCurve3_getPoint(128,0,3,0.25,0,0,0.5);"
        "let two=CatmullRomCurve3_getPoint(160,0,3,0.75,0,1,0.5);"
        "let end=CatmullRomCurve3_getPoint(192,0,3,1.0,0,2,0.5);"
        "let closed=CatmullRomCurve3_getPoint(224,0,3,1.0,1,1,0.5);";
    const char *cases[]={"return ux_f64(one);","return ux_f64(one+8);","return ux_f64(two);",
        "return ux_f64(two+8);","return ux_f64(end);","return ux_f64(end+8);","return ux_f64(closed);"};
    const double gold[]={1,1.25,3,1.25,4,0,0};
    return g_math_run("G_STRUCT CatmullRomCurve3","catmullromcurve3",modules,setup,cases,gold,7,
        mutate?0:-1,"return ux_f64(two);");
}
