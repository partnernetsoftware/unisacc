#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

static double json_hash(const unsigned char *s,int n) {
    uint64_t hash=0;
    for(int i=0;i<n;i++) hash=(hash*131+s[i])%16777213;
    return (double)hash;
}

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","object-json-tokens","buffergeometry","json-bytes","geometry-json",0};
    const char *setup="function bytes(count,...values){let i=0;while(i<count){"
        "let b=ux_u8_put(values[0]+i,values[i+1]);i=i+1;}return i;}\n"
        "let geo=BufferGeometry_init(0,128,1,192,1);"
        "let pos=256;let idx=320;let identity=384;let names=416;let sphere=448;"
        "let uuid=bytes(10,600,103,101,111,109,101,116,114,121,45,49);"
        "let name=bytes(4,620,100,101,99,107);"
        "let attr=bytes(8,640,112,111,115,105,116,105,111,110);"
        "let u=ux_u32_put(identity+GeometryJsonIdentity.uuid,600);"
        "let un=ux_u32_put(identity+GeometryJsonIdentity.uuidBytes,10);"
        "let n=ux_u32_put(identity+GeometryJsonIdentity.name,620);"
        "let nn=ux_u32_put(identity+GeometryJsonIdentity.nameBytes,4);"
        "let map=ux_u32_put(identity+GeometryJsonIdentity.names,names);"
        "let nc=ux_u32_put(identity+GeometryJsonIdentity.nameCount,1);"
        "let token=ux_u32_put(names,8);let np=ux_u32_put(names+4,640);let ns=ux_u32_put(names+8,8);"
        "let pd=ux_u32_put(pos+BufferAttribute.data,704);let pn=ux_u32_put(pos+BufferAttribute.count,1);"
        "let ps=ux_u32_put(pos+BufferAttribute.itemSize,3);let pt=ux_u32_put(pos+BufferAttribute.componentType,9);"
        "let pst=ux_u32_put(pos+BufferAttribute.stride,12);let use=ux_u32_put(pos+BufferAttribute.usage,35048);"
        "let px=ux_f32_put(704,1.25);let py=ux_f32_put(708,0.0-2.0);let pz=ux_f32_put(712,0.0);"
        "let id=ux_u32_put(idx+BufferAttribute.data,720);let in=ux_u32_put(idx+BufferAttribute.count,1);"
        "let is=ux_u32_put(idx+BufferAttribute.itemSize,1);let it=ux_u32_put(idx+BufferAttribute.componentType,4);"
        "let ist=ux_u32_put(idx+BufferAttribute.stride,2);let ix=ux_u16_put(720,0);"
        "let a=BufferGeometry_setAttribute(geo,8,pos);let b=BufferGeometry_setIndex(geo,idx);"
        "let g=BufferGeometry_addGroup(geo,4,8,2);let s=ux_u32_put(geo+BufferGeometry.boundingSphere,sphere+1);"
        "let sx=ux_f64_put(sphere,1.0);let sy=ux_f64_put(sphere+8,2.0);"
        "let sz=ux_f64_put(sphere+16,3.0);let sr=ux_f64_put(sphere+24,4.0);";
    const char *hash="let p=1024;let h=0;while(p<end){h=(h*131+ux_u8(p))%16777213;p=p+1;}return h;";
    char check[540],bad[540];
    tx_snprintf(check,sizeof check,"let end=BufferGeometry_toJSON(geo,1024,2048,identity,4096);%s",hash);
    tx_snprintf(bad,sizeof bad,"let changed=ux_f64_put(sphere+24,6.0);"
        "let end=BufferGeometry_toJSON(geo,1024,2048,identity,4096);%s",hash);
    const char *cases[]={check,
        "return BufferGeometry_toJSON(geo,1024,2048,identity,4096)-1024;",
        "return BufferGeometry_toJSON(geo,1024,1150,identity,4096);",
        "let empty=ux_u32_put(identity+GeometryJsonIdentity.nameCount,0);"
        "return BufferGeometry_toJSON(geo,1024,2048,identity,4096);"};
    const char expected[]="{\"metadata\":{\"version\":4.6,\"type\":\"BufferGeometry\","
        "\"generator\":\"BufferGeometry.toJSON\"},\"uuid\":\"geometry-1\",\"type\":\"BufferGeometry\","
        "\"name\":\"deck\",\"data\":{\"attributes\":{\"position\":{\"itemSize\":3,\"type\":\"Float32Array\","
        "\"array\":[1.25,-2,0],\"normalized\":false,\"usage\":35048}},\"index\":{\"type\":\"Uint16Array\","
        "\"array\":[0]},\"groups\":[{\"start\":4,\"count\":8,\"materialIndex\":2}],"
        "\"boundingSphere\":{\"center\":[1,2,3],\"radius\":4}}}";
    const double gold[]={json_hash((const unsigned char *)expected,sizeof expected-1),sizeof expected-1,-1,-2};
    return g_math_run("G_STRUCT BufferGeometry toJSON","geometry-json",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,bad);
}
