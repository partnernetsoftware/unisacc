#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"helper-geometry","lighthelper-common","directionallighthelper",0};
    const char *setup="let helper=0;let plane=128;let line=256;let light=384;let target=512;let color=640;let over=768;"
        "let x=ux_f64_put(light+96,1.0);let y=ux_f64_put(target+96,4.0);let z=ux_f64_put(target+112,4.0);"
        "let c=ux_f64_put(color,0.25);let d=ux_f64_put(over+8,0.75);"
        "let init=DirectionalLightHelper_init(helper,plane,line,light,target,2.0,color,0-1);";
    const char *cases[]={
        "return ux_f32(plane);",
        "return ux_f32(plane+28);",
        "return ux_f32(plane+52);",
        "return ux_f32(line+20);",
        "return ux_f64(helper+DirectionalLightHelper.lookX);",
        "return ux_f64(helper+DirectionalLightHelper.lookZ);",
        "return ux_f64(helper+DirectionalLightHelper.lineScaleZ);",
        "let p=ux_f64_put(target+96,1.0);let up=DirectionalLightHelper_update(helper,target,color,over);return ux_f64(helper+DirectionalLightHelper.lineScaleZ);",
        "return ux_f64(helper+DirectionalLightHelper.red);",
        "let up=DirectionalLightHelper_update(helper,target,color,over);return ux_f64(helper+DirectionalLightHelper.green);",
        "let p=ux_f64_put(light+96,2.5);return ux_f64(ux_u32(helper+DirectionalLightHelper.matrix)+96);",
        "let gone=DirectionalLightHelper_dispose(helper);return 0.0+ux_u32(helper+DirectionalLightHelper.active);",
        "let gone=DirectionalLightHelper_dispose(helper);return 0.0+DirectionalLightHelper_update(helper,target,color,over);",
        "return 0.0+DirectionalLightHelper_init(helper,plane,plane,light,target,2.0,color,0-1);",
    };
    const double gold[]={-2,-2,2,1,0.6,0.8,5,4,0.25,0.75,2.5,0,-1,-1};
    return g_wasm_batch("G_STRUCT DirectionalLightHelper","directionallighthelper",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?6:-1,"return ux_f64(helper+DirectionalLightHelper.lookZ);");
}
