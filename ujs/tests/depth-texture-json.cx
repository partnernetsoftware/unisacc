#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define WRITE "let stop=DepthTexture_writeJSON(128,256,512,1024);"
#define READ "let result=DepthTexture_readJSON(160,256,stop,2304);"

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","helper-buffers","json-read","json-bytes",
        "depth-texture-format","depth-texture-json",0};
    const char *setup="let format=ux_u32_put(128,1027);let kind=ux_u32_put(132,1020);"
        "let compare=ux_u32_put(136,515);";
    const char *cases[]={
        WRITE READ "return 0.0+ux_u32(160);",
        WRITE READ "return 0.0+ux_u32(164);",
        WRITE READ "return 0.0+ux_u32(168);",
        "let cleared=ux_u32_put(136,0);" WRITE READ "return 0.0+ux_u32(168);",
        "let bad=ux_u32_put(132,1014);return 0.0+DepthTexture_writeJSON(128,256,512,1024);",
        WRITE "let invalid=ux_u8_put(stop-2,48);" READ "return 0.0+result;"
    };
    const double gold[]={1027,1020,515,0,-1,-1};
    return g_wasm_batch("G_STRUCT DepthTexture JSON","depth-texture-json",modules,setup,cases,gold,6,
        mutate?2:-1,"let changed=ux_u32_put(136,516);" WRITE READ "return 0.0+ux_u32(168);");
}
