#pragma unisa module g_wasm_batch
#pragma unisa use g_math
#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

static int build_source(const char *file,const char *const *modules,const char *setup,
        const char *const *cases,int count,int mutate,const char *mutation) {
    char program[100001];
    int used=tx_snprintf(program,sizeof program,"export uxe_evaluate_case(selected_case:i64) f64 version 1;\n");
    for(int i=0;modules[i];i++) {
        char path[256];
        unsigned char *body=0;
        int64_t size=0;
        tx_snprintf(path,sizeof path,"ujs/practice/uxe/base/%s.ujs",modules[i]);
        if(sy_read_file(path,&body,&size,sizeof program-used-2)) return 1;
        int written=tx_snprintf(program+used,sizeof program-used,"%s\n",body);
        mm_free(body);
        if(written<0 || written>=(int)sizeof program-used) return 1;
        used+=written;
    }
    int prefix=tx_snprintf(program+used,sizeof program-used,"\n%s\n",setup);
    if(prefix<0 || prefix>=(int)sizeof program-used) return 1;
    used+=prefix;
    for(int i=0;i<count;i++) {
        const char *statement=i==mutate?mutation:cases[i];
        int n=tx_snprintf(program+used,sizeof program-used,"if(selected_case==%d){%s}\n",i,statement);
        if(n<0 || n>=(int)sizeof program-used) return 1;
        used+=n;
    }
    const int suffix=tx_snprintf(program+used,sizeof program-used,"return 0.0/0.0;\n");
    if(suffix<0 || suffix>=(int)sizeof program-used) return 1;
    return sy_write_file(file,program,used+suffix,0600)!=0;
}

// Compile once. A fresh WebAssembly instance supplies independent zeroed
// memory for each case, while the r160 oracle is evaluated separately.
static int g_wasm_batch_mode(const char *name,const char *fixture,const char *page,const char *const *modules,const char *setup,
        const char *const *cases,const double *gold,int count,int mutate,const char *mutation,int realtime) {
    if(count<1 || count>64) return 2;
    char dir[256],source[300],wasm[300],html[300],profile[320],url[390],*out=0;
    size_t size=0;
    if(sy_mkdtemp("/tmp","uxe-wasm-batch-",dir,sizeof dir)) return 2;
    tx_snprintf(source,sizeof source,"%s/probe.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/probe.wasm",dir);
    tx_snprintf(html,sizeof html,"%s/probe.html",dir);
    tx_snprintf(profile,sizeof profile,"--user-data-dir=%s/wasm-chrome",dir);
    tx_snprintf(url,sizeof url,"file://%s?count=%d",html,count);
    int failed=build_source(source,modules,setup,cases,count,mutate,mutation) ||
        sy_copy(page,html,0600);
    double refs[64]={0};
    if(!failed && g_math_reference(fixture,refs,count,dir)) {
        printf("WASM_BATCH oracle_failed fixture=%s\n",fixture);
        failed=1;
    }
    char *compile[]={"./ujs/ujs2wasm.com",source,"-o",wasm,0};
    if(!failed) {
        const int rc=cx_runv_timeout(compile,6,&out,&size);
        if(rc) { printf("WASM_BATCH compile_rc=%d\n",rc); failed=1; }
        mm_free(out); out=0; size=0;
    }
    const int uses_dom=!realtime;
    if(!failed && !uses_dom) {
        double actual[64]={0};
        failed=r160_wait_read(url,"#wasm-cases",actual,count,dir);
        if(failed) printf("WASM_BATCH browser_fixture_failed=%s\n",fixture);
        for(int i=0;!failed && i<count;i++) {
            if(!g_math_near(actual[i],gold[i],1e-9) || !g_math_near(refs[i],gold[i],1e-9)) {
                printf("%s case=%d actual=%.17g r160=%.17g gold=%.17g\n",name,i,actual[i],refs[i],gold[i]);
                failed=1;
            }
        }
    }
    if(!failed && uses_dom) {
        char *browser[]={"google-chrome","--headless=new","--allow-file-access-from-files",
            "--disable-background-networking","--no-first-run",profile,"--dump-dom",url,0};
        const int rc=cx_runv_timeout(browser,6,&out,&size);
        const char marker[]="<pre id=\"wasm-cases\">[";
        long at=!rc&&out?tx_find(out,size,marker,sizeof marker-1):-1;
        if(at<0) {
            printf("WASM_BATCH browser_rc=%d output_bytes=%ld\n",rc,(long)size);
            const char status_marker[]="<pre id=\"wasm-cases\">";
            const long status=out?tx_find(out,size,status_marker,sizeof status_marker-1):-1;
            if(status>=0) {
                const char *start=out+status+sizeof status_marker-1;
                const long end=tx_find(start,size-(start-out),"</pre>",6);
                if(end>=0 && end<220) printf("WASM_BATCH browser_status=%.*s\n",(int)end,start);
            }
            failed=1;
        }
        else {
            char *value=out+at+sizeof marker-1;
            for(int i=0;i<count;i++) {
                char *end=0;
                double actual=tx_strtod(value,&end);
                if(end==value || *end!=(i==count-1?']':',')) { failed=1; break; }
                if(!g_math_near(actual,gold[i],1e-9) || !g_math_near(refs[i],gold[i],1e-9)) {
                    printf("%s case=%d actual=%.17g r160=%.17g gold=%.17g\n",name,i,actual,refs[i],gold[i]);
                    failed=1;
                }
                value=end+1;
            }
        }
        mm_free(out); out=0; size=0;
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&out,&size)) failed=1;
    mm_free(out);
    printf("%s cases=%d failed=%d\n",name,count,failed);
    return failed;
}

int g_wasm_batch_page(const char *name,const char *fixture,const char *page,const char *const *modules,const char *setup,
        const char *const *cases,const double *gold,int count,int mutate,const char *mutation) {
    return g_wasm_batch_mode(name,fixture,page,modules,setup,cases,gold,count,mutate,mutation,1);
}

int g_wasm_batch(const char *name,const char *fixture,const char *const *modules,const char *setup,
        const char *const *cases,const double *gold,int count,int mutate,const char *mutation) {
    return g_wasm_batch_mode(name,fixture,"ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,count,mutate,mutation,0);
}
