#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define START "let started=DragControls_begin(state,7,17,press,normal,world,inverse);"
#define MOVE "let moved=DragControls_move(state,7,move);"
#define AGAIN "let repeated=DragControls_move(state,7,again);"
#define END "let ended=DragControls_end(state,7);"
#define SELECTED "return 0.0+DragControls_selected(state);"
#define X "return ux_f64(DragControls_position(state));"
#define Y "return ux_f64(DragControls_position(state)+8);"
#define Z "return ux_f64(DragControls_position(state)+16);"
#define PARALLEL "let a=ux_f64_put(move+24,1.0);let b=ux_f64_put(move+40,0.0);"
#define TILT "let n1=ux_f64_put(normal+8,0.0-0.6);let n2=ux_f64_put(normal+16,0.0-0.8);" \
    "let p=drag_controls_put3(press,0.0-3.0,5.0,11.5);let pd=drag_controls_put3(press+24,0.0,0.0-0.6,0.0-0.8);" \
    "let m=drag_controls_put3(move,0.0-2.0,7.0,10.0);let md=drag_controls_put3(move+24,0.0,0.0-0.6,0.0-0.8);"

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"dragcontrols",0};
    const char *setup="let state=4096;let press=32;let move=96;let again=160;let normal=224;let world=256;let inverse=288;"
        "let init=DragControls_init(state);"
        "let p=drag_controls_put3(press,0.0-2.5,0.0-0.75,13.5);let pd=ux_f64_put(press+40,0.0-1.0);"
        "let m=drag_controls_put3(move,0.0-0.5,0.0-2.75,13.5);let md=ux_f64_put(move+40,0.0-1.0);"
        "let q=drag_controls_put3(again,0.0-4.5,1.25,13.5);let qd=ux_f64_put(again+40,0.0-1.0);"
        "let n=ux_f64_put(normal+16,0.0-1.0);let w=drag_controls_put3(world,0.0-3.0,0.0-1.0,3.5);"
        "let a=ux_f64_put(inverse+8,0.0-0.25);let b=ux_f64_put(inverse+32,0.5);"
        "let c=ux_f64_put(inverse+80,1.0/3.0);let d=ux_f64_put(inverse+96,1.5);"
        "let e=ux_f64_put(inverse+104,1.25);let f=ux_f64_put(inverse+112,0.0-2.0/3.0);"
        "let g=ux_f64_put(inverse+120,1.0);";
    const char *cases[]={
        SELECTED,
        "return 0.0+DragControls_begin(state,7,0,0,0,0,0);",
        START "return 0.0+started;",
        START SELECTED,
        START MOVE X,
        START MOVE Y,
        START MOVE Z,
        START MOVE "return 0.0+moved;",
        START MOVE AGAIN X,
        START MOVE AGAIN Y,
        START MOVE AGAIN Z,
        START MOVE END "return 0.0+ended;",
        START END SELECTED,
        START END MOVE "return 0.0+moved;",
        START END "return 0.0+DragControls_begin(state,7,29,press,normal,world,inverse);",
        START END "let second=DragControls_begin(state,7,29,press,normal,world,inverse);"
            "return 0.0+DragControls_end(state,7);",
        TILT START MOVE X,
        TILT START MOVE Y,
        TILT START MOVE Z,

        // The remaining cases exercise memory, input and pointer ownership contracts.
        "return 0.0+DragControls_init(state+4);",
        "return 0.0+DragControls_begin(state,7,17,6291456-40,normal,world,inverse);",
        "return 0.0+DragControls_begin(state,7,17,state,normal,world,inverse);",
        PARALLEL "return 0.0+DragControls_begin(state,7,17,move,normal,world,inverse);",
        START "return 0.0+DragControls_move(state,8,move);",
        START "return 0.0+DragControls_end(state,8);",
        START "let ignored=DragControls_move(state,8,move);" X,
        START "let busy=DragControls_begin(state,8,29,press,normal,world,inverse);" SELECTED,
        START PARALLEL MOVE "return 0.0+moved;",
        START PARALLEL MOVE SELECTED,
        "let bad=ux_f64_put(inverse+120,0.0);" START "return 0.0+started;",
        "let bad=ux_f64_put(press+40,0.0);" START "return 0.0+started;",
        "state=6291456-DragControls_size();let ready=DragControls_init(state);" START "return 0.0+started;",
        START "let changed=ux_f64_put(inverse+96,99.0);let copied=DragControls_move(state,7,press);" X,
        START "return 0.0+DragControls_move(state,7,6291456);",
        START "let invalid=DragControls_move(state,7,6291456);" END "return 0.0+ended;",
        START "let huge=10000000000000000.0;let h2=huge*huge;let h4=h2*h2;let h8=h4*h4;let h16=h8*h8;let enormous=ux_f64_put(move+24,h16*h2*huge*10000.0);" MOVE "return 0.0+moved;",
        START PARALLEL "let coplanar=ux_f64_put(move+16,3.5);" MOVE "return 0.0+moved;",
    };
    const double gold[]={
        0,0,17,17,0,1.5,0.5,17,2,2.5,0.5,17,0,0,29,29,2,1.75,0,
        -1,-1,-1,0,0,0,1,17,0,17,-1,-1,17,1,-1,17,-1,17,
    };
    return g_wasm_batch_addon("G_RAY DragControls world plane and pointer lifecycle","dragcontrols",
        argv[1],modules,setup,cases,gold,sizeof gold/sizeof gold[0],mutate?5:-1,
        START "let omitted=ux_f64_put(state+DragControlsState.offsetX,0.0);" MOVE Y);
}
