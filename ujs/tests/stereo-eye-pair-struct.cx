#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d","camera","perspectivecamera",
        "stereocamera","stereo-eye-record","stereo-eye-pair",0};
    const char *setup="let stereo=StereoCamera_init(0,1024,1152,1280,1408);"
        "let proj=Matrix4_makePerspective(256,0.0-2.0,2.0,1.0,0.0-1.0,1.0,11.0,2000.0);"
        "let world=Matrix4_makeTranslation(512,3.0,4.0,5.0);"
        "let primed=StereoCamera_update(stereo,proj,world,90.0,1.0,2.0,10.0);"
        "let arena=Object3D_initArena(4096,4);let rig=StereoCamera_initPair(3520,stereo,arena,2048);"
        "let left=StereoCamera_pairNode(rig,0);let right=StereoCamera_pairNode(rig,1);"
        "let ln=Object3D_address(arena,left);let rn=Object3D_address(arena,right);"
        "let le=StereoCamera_pairEye(rig,0);let re=StereoCamera_pairEye(rig,1);"
        "let ll=ux_u32(le+StereoEyeRecord.lens);let rl=ux_u32(re+StereoEyeRecord.lens);";
    const char *cases[]={
        "return 0.0+(left!=right && left>0 && right>0 && le!=re && le>0 && re>0);",
        "return 0.0+ux_u32(ln+Object3D.layerMask);",
        "return 0.0+ux_u32(rn+Object3D.layerMask);",
        "return 0.0+ux_u32(le+StereoEyeRecord.matrixAutoUpdate);",
        "return 0.0+ux_u32(re+StereoEyeRecord.matrixAutoUpdate);",
        "return ux_f64(ux_u32(ln+Object3D.worldMatrix)+96);",
        "let fov=ux_f64_put(ll+PerspectiveCamera.fov,65.0);let move=ux_f64_put(world+96,9.0);"
            "let u=StereoCamera_update(stereo,proj,world,90.0,1.0,2.0,10.0);"
            "let refreshed=StereoCamera_refreshPair(rig);return ux_f64(ll+PerspectiveCamera.fov);",
        "let fov=ux_f64_put(rl+PerspectiveCamera.fov,80.0);let move=ux_f64_put(world+96,9.0);"
            "let u=StereoCamera_update(stereo,proj,world,90.0,1.0,2.0,10.0);"
            "let refreshed=StereoCamera_refreshPair(rig);return ux_f64(rl+PerspectiveCamera.fov);",
        "let move=ux_f64_put(world+96,9.0);let u=StereoCamera_update(stereo,proj,world,90.0,1.0,2.0,10.0);"
            "let refreshed=StereoCamera_refreshPair(rig);return 0.0+(StereoCamera_pairNode(rig,0)==left &&"
            "StereoCamera_pairNode(rig,1)==right && StereoCamera_pairEye(rig,0)==le && StereoCamera_pairEye(rig,1)==re);",
        "let move=ux_f64_put(world+96,9.0);let u=StereoCamera_update(stereo,proj,world,90.0,1.0,2.0,10.0);"
            "let refreshed=StereoCamera_refreshPair(rig);return ux_f64(ux_u32(ln+Object3D.worldMatrix)+96);",
        "let move=ux_f64_put(world+96,9.0);let u=StereoCamera_update(stereo,proj,world,90.0,1.0,2.0,10.0);"
            "let refreshed=StereoCamera_refreshPair(rig);return ux_f64(ux_u32(rn+Object3D.worldMatrix)+96);",
        "let move=ux_f64_put(world+96,9.0);let u=StereoCamera_update(stereo,proj,world,90.0,1.0,2.0,10.0);"
            "let refreshed=StereoCamera_refreshPair(rig);let cam=ux_u32(le+StereoEyeRecord.camera);"
            "return ux_f64(ux_u32(cam+Camera.matrixWorldInverse)+96);",
        "let recomposed=Object3D_updateMatrixWorld(arena,left,1);return ux_f64(ux_u32(ln+Object3D.worldMatrix)+96);",
        "let change=ux_u32_put(ln+Object3D.layerMask,19);let refreshed=StereoCamera_refreshPair(rig);"
            "return 0.0+ux_u32(le+StereoEyeRecord.layerMask);",
        "let u=StereoCamera_update(stereo,proj,world,90.0,1.0,2.0,20.0);let refreshed=StereoCamera_refreshPair(rig);"
            "let cam=ux_u32(le+StereoEyeRecord.camera);return ux_f64(ux_u32(cam+Camera.projectionMatrix)+64);",
        "let broken=ux_u32_put(re+StereoEyeRecord.eye,0);let move=ux_f64_put(world+96,9.0);"
            "let u=StereoCamera_update(stereo,proj,world,90.0,1.0,2.0,10.0);let refused=StereoCamera_refreshPair(rig);"
            "return ux_f64(ux_u32(le+StereoEyeRecord.world)+96);",
        "let extra=Object3D_create(arena);let linked=Object3D_add(arena,extra,left);return 0.0+StereoCamera_refreshPair(rig);",
        "let freed=StereoCamera_disposePair(rig);return 0.0+(freed==0 && Object3D_address(arena,left)<0 &&"
            "Object3D_address(arena,right)<0 && StereoCamera_pairEye(rig,0)<0);",
        "let freed=StereoCamera_disposePair(rig);return 0.0+StereoCamera_disposePair(rig);",
        "let freed=StereoCamera_disposePair(rig);let other=StereoCamera_initPair(rig,stereo,arena,2048);"
            "return 0.0+(other==rig && StereoCamera_pairNode(other,0)!=left && StereoCamera_pairNode(other,1)!=right);",
        "let small=Object3D_initArena(8192,1);let refused=StereoCamera_initPair(8704,stereo,small,8960);"
            "let node=Object3D_create(small);return 0.0+(refused<0 && node>0);",
        "return 0.0+StereoCamera_initPair(3584,stereo,arena,4096);",
        "return 0.0+StereoCamera_pairNode(rig,2);",
        "let deleted=Object3D_destroy(arena,right);let stale=StereoCamera_refreshPair(rig);"
            "let released=StereoCamera_disposePair(rig);return 0.0+(stale<0 && released==0 && Object3D_address(arena,left)<0);",
        "let tamper=ux_u32_put(rn+Object3D.worldMatrix,6291456);let move=ux_f64_put(world+96,9.0);"
            "let u=StereoCamera_update(stereo,proj,world,90.0,1.0,2.0,10.0);let refused=StereoCamera_refreshPair(rig);"
            "return ux_f64(ux_u32(le+StereoEyeRecord.world)+96);",
    };
    const double gold[]={1,3,5,0,0,2.968,65,80,1,8.968,9.032,-8.968,2.968,19,.0008,2.968,-1,
        1,-1,1,1,-1,-1,1,2.968};
    return g_wasm_batch("G_STRUCT StereoCamera pair","stereo-eye-pair",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?6:-1,
        "let fov=ux_f64_put(ll+PerspectiveCamera.fov,65.0);let move=ux_f64_put(world+96,9.0);"
        "let u=StereoCamera_update(stereo,proj,world,90.0,1.0,2.0,10.0);"
        "let remade=StereoCamera_readEye(stereo,0,le,704);return ux_f64(ll+PerspectiveCamera.fov);");
}
