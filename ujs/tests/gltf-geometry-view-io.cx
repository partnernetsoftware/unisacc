#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","glb-container","json-read","loader-json",
        "gltf-accessor","gltf-triangle-topology","gltf-topology-accessors","gltf-geometry-view",0};
    const char *setup=
        "let req=0;let xyz=128;let uv=192;let attrs=256;let out=384;let dst=768;"
        "let m=ux_u32_put(req+GltfGeometryRequest.mode,5);let p=ux_u32_put(req+GltfGeometryRequest.position,xyz);"
        "let a=ux_u32_put(req+GltfGeometryRequest.attributes,attrs);let c=ux_u32_put(req+GltfGeometryRequest.attributeCount,1);"
        "let b=ux_u32_put(req+GltfGeometryRequest.indicesOut,dst);let cap=ux_u32_put(req+GltfGeometryRequest.indexCapacity,6);"
        "let w=ux_u32_put(attrs,uv);let t=ux_u32_put(out+GltfGeometryView.indexCount,77);let u=ux_u32_put(dst,99);"
        "let p0=ux_u32_put(xyz+GltfAccessor.bytes,512);let p1=ux_u32_put(xyz+GltfAccessor.count,4);"
        "let p2=ux_u32_put(xyz+GltfAccessor.stride,12);let p3=ux_u32_put(xyz+GltfAccessor.elementBytes,12);"
        "let p4=ux_u32_put(xyz+GltfAccessor.component,5126);let p5=ux_u32_put(xyz+GltfAccessor.lanes,3);"
        "let a0=ux_u32_put(uv+GltfAccessor.bytes,608);let a1=ux_u32_put(uv+GltfAccessor.count,4);"
        "let a2=ux_u32_put(uv+GltfAccessor.stride,8);let a3=ux_u32_put(uv+GltfAccessor.elementBytes,8);"
        "let a4=ux_u32_put(uv+GltfAccessor.component,5126);let a5=ux_u32_put(uv+GltfAccessor.lanes,2);";
    #define BUILD "let done=GltfLoader_geometryView(req,out);"
    const char *cases[]={
        BUILD "return 0.0+ux_u32(out+GltfGeometryView.vertexCount);",
        BUILD "return 0.0+ux_u32(out+GltfGeometryView.indexCount);",
        BUILD "return 0.0+ux_u32(dst+12);",
        BUILD "return 0.0+ux_u32(dst+20);",
        BUILD "return 0.0+ux_u32(out+GltfGeometryView.attributeCount);",
        "let short=ux_u32_put(uv+GltfAccessor.count,3);" BUILD "return 0.0+(done==0-2 && ux_u32(dst)==99 && ux_u32(out+GltfGeometryView.indexCount)==77);",
        "let alias=ux_u32_put(uv+GltfAccessor.bytes,dst);" BUILD "return 0.0+(done==0-2 && ux_u32(dst)==99);",
    };
    const double gold[]={4,6,3,1,1,1,1};
    return g_wasm_batch_addon("G_IO GLTF geometry view","gltf-geometry-view",argv[1],modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,BUILD "return 0.0+ux_u32(dst+20);");
}
