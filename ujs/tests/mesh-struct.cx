#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d","object3d-lifecycle",
        "datautils","bufferattribute","buffergeometry","mesh-layout","mesh",0};
    const char *setup=
        "let arena=Object3D_initArena(0,4);let root=Object3D_create(arena);"
        "let node=Object3D_create(arena);let other=Object3D_create(arena);"
        "let root_record=Object3D_address(arena,root);let node_record=Object3D_address(arena,node);"
        "let rx=ux_f64_put(ux_u32(root_record+Object3D.position),10.0);"
        "let mx=ux_f64_put(ux_u32(node_record+Object3D.position),2.0);"
        "let joined=Object3D_add(arena,root,node);let world=Object3D_updateMatrixWorld(arena,root,0);"
        "let geo=BufferGeometry_init(2048,2112,1,2144,0);"
        "let position=BufferAttribute_init(2176,2240,1,3,9,0);"
        "let target=BufferAttribute_init(2304,2368,1,3,9,0);"
        "let x=ux_f32_put(2240,1.0);let y=ux_f32_put(2244,2.0);let z=ux_f32_put(2248,3.0);"
        "let ax=ux_f32_put(2368,5.0);let ay=ux_f32_put(2372,10.0);let az=ux_f32_put(2376,15.0);"
        "let attr=BufferGeometry_setAttribute(geo,8,position);"
        "let mesh=Mesh_init(2432,arena,node,geo,17,2560,2);"
        "let shared=Mesh_init(2496,arena,other,geo,17,2624,2);"
        "let desc=ux_u32_put(2688,target);let name=ux_u32_put(2692,7);"
        "let morph=Mesh_updateMorphTargets(mesh,2688,1,0);let weight=Mesh_setMorphInfluence(mesh,0,0.25);";
    const char *cases[]={
        "return ux_f64(ux_u32(node_record+Object3D.worldMatrix)+96);",
        "return Mesh_findMorphTarget(mesh,7);",
        "let point=Mesh_getVertexPosition(mesh,2816,0,8);return ux_f64(point);",
        "let point=Mesh_getVertexPosition(mesh,2816,0,8);return ux_f64(point+16);",
        "let m=Mesh_updateMorphTargets(mesh,2688,1,1);let w=Mesh_setMorphInfluence(mesh,0,0.25);"
        "let point=Mesh_getVertexPosition(mesh,2816,0,8);return ux_f64(point+8);",
        "let copied=Mesh_copy(shared,arena,mesh,arena,0);let w=Mesh_setMorphInfluence(mesh,0,0.5);"
        "let point=Mesh_getVertexPosition(copied,2816,0,8);return ux_f64(point);",
        "let copied=Mesh_copy(shared,arena,mesh,arena,0);return ux_u32(copied+Mesh.geometry)==ux_u32(mesh+Mesh.geometry);",
        "let copied=Mesh_copy(shared,arena,mesh,arena,0);let rec=Object3D_address(arena,other);"
        "return ux_f64(ux_u32(rec+Object3D.position));",
        "return Mesh_setMorphInfluence(mesh,1,0.5);",
        "return Mesh_getVertexPosition(mesh,2816,1,8);"
    };
    const double gold[]={12,0,2,6,4.5,2,1,2,-1,-1};
    return g_math_run("G_STRUCT Mesh","mesh",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?5:-1,"let copied=Mesh_copy(shared,arena,mesh,arena,0);let w=Mesh_setMorphInfluence(mesh,0,0.5);"
        "let point=Mesh_getVertexPosition(mesh,2816,0,8);return ux_f64(point);");
}
