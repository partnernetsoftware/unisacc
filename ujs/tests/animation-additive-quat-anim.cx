#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","quaternion","animation-view","animation-additive-quat",0};
    const char *setup=
        "let time=ux_f32_put(68,1.0);let q=0.7071067811865476;"
        "let ax=ux_f32_put(128,q);let aw=ux_f32_put(140,q);let bz=ux_f32_put(152,q);let bw=ux_f32_put(156,q);"
        "let view=AnimationSamples_init(0,64,128,2,4);"
        "let size=AnimationUtils_quatDelta(view,128,256,32,512);";
    const char *cases[]={
        "return size;","return ux_f32(268);","return ux_f32(276);","return ux_f32(272);",
        "return AnimationUtils_quatDelta(view,128,256,31,512);",
        "return AnimationUtils_quatDelta(view,128,256,32,256);",
        "let edit=ux_f32_put(156,2.0);let guard=ux_u32_put(256,777);"
        "let rejected=AnimationUtils_quatDelta(view,128,256,32,512);return ux_u32(256);"
    };
    float root=(float)0.7071067811865476;
    double partial=(double)root*(double)root;
    const double gold[]={32,(float)(partial*2),(float)partial,-(float)partial,-2,-1,777};
    return g_math_run("G_ANIM AnimationUtils quaternion additive","animation-additive-quat",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,"return 0.0-ux_f32(276);");
}
