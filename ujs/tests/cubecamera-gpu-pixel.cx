#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define FIX "ujs/practice/uxe/test/"

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[460],abi[320],wasm[320],url[950];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-cubecamera-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/cube.wasm",dir);
    int address=tx_snprintf(url,sizeof url,"file://%s/" FIX "cubecamera-gpu-r160.html?wasm=%s&mutate=%d",cwd,wasm,mutate);
    const char entry[]="import host_gpu_submit from \"uxe_gpu_v1\"(i64,i64) i64;\n"
        "export uxe_cube_probe(mode:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,BASE "record-copy.ujs",BASE "gpu-packet.ujs",
        BASE "gpu-target.ujs",BASE "cubecamera.ujs",BASE "cubecamera-gpu.ujs",
        FIX "cubecamera-gpu-probe.ujs","-o",wasm,0};
    const double colors[]={4278190335.0,4278255360.0,4294901760.0,4278255615.0,4294967040.0,4294902015.0};
    enum { count=15 };
    double actual[count]={0};
    char *log=0;
    size_t bytes=0;
    int bad=address<0 || address>=(int)sizeof url || sy_write_file(abi,entry,sizeof entry-1,0600);
    if(!bad) {
        const int rc=cx_runv_timeout(compile,6,&log,&bytes);
        if(rc) printf("CUBE_GPU compile_rc=%d %.*s\n",rc,(int)bytes,log?log:"");
        bad=rc!=0;
        mm_free(log);
    }
    if(!bad) bad=r160_wait_read(url,"#r160",actual,count,dir);
    if(!bad) for(int i=0;i<count;i++) {
        const double expected=i==0?0:i<3?1:colors[(i-3)%6];
        if(actual[i]!=expected) {
            printf("CUBE_GPU case=%d actual=%.17g gold=%.17g\n",i,actual[i],expected);
            bad=1;
        }
    }
    if(sy_remove_all(dir)) bad=1;
    printf("G_PIXEL CubeCamera six faces cases=%d failed=%d\n",count,bad);
    return bad;
}
