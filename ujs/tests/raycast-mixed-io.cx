#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","vector-scalar","vector3","ray","triangle","raycast-memory",
        "raycaster-state","raycast-affine","raycast-hit-sort","raycast-vertices","raycast-points",
        "raycast-mesh","raycast-buffer","raycast-mixed",0};
    const char *setup=
        "let ray=0;let m=128;let p=192;let world=256;let scale=384;let mp=512;let pp=608;"
        "let first=768;let mesh=896;let last=1024;let blocks=1280;let out=1536;let work=2048;let merged=4096;"
        "let init=Raycaster_default(ray);let u=Vector3_set(scale,1.0,1.0,1.0);"
        "let i=0;while(i<16){let cell=ux_f64_put(world+i*8,(i%5==0)*1.0);i=i+1;}"
        "let a0=ux_u32_put(m+RayMeshBuffer.positions,mp);let a1=ux_u32_put(m+RayMeshBuffer.vertexCount,3);"
        "let a2=ux_u32_put(m+RayMeshBuffer.positionStride,12);let a3=ux_u32_put(m+RayMeshBuffer.faceCount,1);"
        "let a4=ux_u32_put(m+RayMeshBuffer.matrixWorld,world);let a5=ux_u32_put(m+RayMeshBuffer.layerMask,1);"
        "let x0=Vector3_set(5504,0.0-1.0,0.0-1.0,0.0-3.0);"
        "let x1=Vector3_set(5536,1.0,0.0-1.0,0.0-3.0);let x2=Vector3_set(5568,0.0,1.0,0.0-3.0);"
        "i=0;while(i<3){let v=5504+i*32;let base=mp+i*12;"
        "let vx=ux_f32_put(base,ux_f64(v));let vy=ux_f32_put(base+4,ux_f64(v+8));"
        "let vz=ux_f32_put(base+8,ux_f64(v+16));i=i+1;}"
        "let b0=ux_u32_put(p+RayPointsBuffer.positions,pp);let b1=ux_u32_put(p+RayPointsBuffer.count,2);"
        "let b2=ux_u32_put(p+RayPointsBuffer.stride,12);let b3=ux_u32_put(p+RayPointsBuffer.drawCount,2);"
        "let b4=ux_u32_put(p+RayPointsBuffer.world,world);let b5=ux_u32_put(p+RayPointsBuffer.scale,scale);"
        "let b6=ux_u32_put(p+RayPointsBuffer.layerMask,1);"
        "let d0=ux_f32_put(pp,0.25);let z0=ux_f32_put(pp+8,0.0-3.0);let z1=ux_f32_put(pp+20,0.0-1.0);"
        "let n0=Raycaster_intersectPointsBuffer(ray,p,first,2,work,512);"
        "let n1=Raycaster_intersectMeshBuffer(ray,m,mesh,1,work,512);"
        "let b7=ux_u32_put(p+RayPointsBuffer.drawCount,1);"
        "let n2=Raycaster_intersectPointsBuffer(ray,p,last,1,work,512);"
        "i=0;while(i<3){let at=blocks+i*RayMixedBlock.size;let hit=first+i*128;let n=n2;"
        "if(i==0){n=n0;}if(i==1){n=n1;}"
        "let k=ux_u32_put(at+RayMixedBlock.kind,2-(i==1));let node=ux_u32_put(at+RayMixedBlock.node,11+i);"
        "let addr=ux_u32_put(at+RayMixedBlock.hits,hit);let count=ux_u32_put(at+RayMixedBlock.count,n);i=i+1;}";
    #define MERGE "let hits=Raycaster_mergeHitBlocks(blocks,3,out,4,merged,1024);"
    #define NODE(N) "return 0.0+ux_u32(out+" #N "*RayMixedHit.size+RayMixedHit.node);"
    #define KIND(N) "return 0.0+ux_u32(out+" #N "*RayMixedHit.size+RayMixedHit.kind);"
    #define INDEX(N) "return 0.0+ux_u32(out+" #N "*RayMixedHit.size+RayMixedHit.index);"
    #define DIST(N) "return ux_f64(out+" #N "*RayMixedHit.size+RayMixedHit.distance);"
    #define SWAP "let a=uxe_copy_record(1200,blocks,RayMixedBlock.size);" \
        "let b=uxe_copy_record(blocks,blocks+RayMixedBlock.size,RayMixedBlock.size);" \
        "let c=uxe_copy_record(blocks+RayMixedBlock.size,1200,RayMixedBlock.size);"
    const char *cases[]={
        MERGE "return 0.0+hits;",
        MERGE NODE(0), MERGE NODE(1), MERGE NODE(2), MERGE NODE(3),
        MERGE KIND(1), MERGE KIND(2), MERGE INDEX(0), MERGE INDEX(1),
        MERGE DIST(0), MERGE DIST(2),
        MERGE "let point=ux_u32(out+RayMixedHit.size+RayMixedHit.source);return ux_f64(point+RayPointsHit.distanceToRay);",
        SWAP MERGE NODE(1), SWAP MERGE NODE(2),
        "return 0.0+Raycaster_mergeHitBlocks(blocks,3,out,3,merged,1024);",
        "let invalid=ux_u32_put(blocks+RayMixedBlock.kind,3);" MERGE "return 0.0+hits;",
        "let marker=ux_u32_put(out,77);let invalid=ux_f64_put(mesh+RayMeshHit.distance,0.0/0.0);"
          MERGE "return 0.0+ux_u32(out);",
        "return 0.0+Raycaster_mergeHitBlocks(blocks,3,first,4,merged,1024);",
    };
    const double gold[]={4,11,11,12,13,2,1,1,0,1,3,0.25,12,11,-2,-1,77,-1};
    return g_wasm_batch_page("G_RAY mixed Mesh Points results","raycast-mixed",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,SWAP MERGE NODE(1));
}
