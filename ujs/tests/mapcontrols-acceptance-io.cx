#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use text.fmt
#pragma unisa use text.text

static int run(char **args,int expected,const char *line) {
    char *output=0;
    size_t length=0;
    int rc=cx_runv_timeout(args,55,&output,&length);
    int matched=output && tx_find(output,length,line,tx_len(line,256))>=0;
    if(output) printf("%s",output);
    mm_free(output);
    return rc!=expected || !matched;
}

int main(int argc,char **argv) {
    if(argc!=2 || argv[1][0]!='/') return 2;
    char *binding[]={"cx","ujs/tests/control-bindings-io.cx","--",argv[1],0};
    char *bad[]={"cx","ujs/tests/control-bindings-io.cx","--",argv[1],"--mutate",0};
    char *touch[]={"cx","ujs/tests/orbitcontrols-touch-io.cx","--",argv[1],0};
    char *browser[]={"cx","ujs/tests/orbitcontrols-browser-io.cx","--",argv[1],0};
    int failed=0;
    failed+=run(binding,0,"G_RAY OrbitControls action bindings cases=13 failed=0");
    failed+=run(bad,1,"case=11 actual=2 r160=3 gold=3");
    failed+=run(touch,0,"G_RAY OrbitControls touch routing cases=10 failed=0");
    failed+=run(browser,0,"G_RAY OrbitControls browser drag wheel pinch failed=0");
    printf("G_RAY MapControls acceptance gates=4 failed=%d\n",failed);
    return failed!=0;
}
