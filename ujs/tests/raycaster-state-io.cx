#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"vector-scalar","object-layouts","vector3","ray","raycaster","raycaster-state",0};
    const char *setup="let o=Vector3_set(128,1.0,2.0,3.0);let d=Vector3_set(160,0.0,1.0,0.0);"
        "let plain=Raycaster_default(256);let custom=Raycaster_init(384,o,d,2.0,13.0);"
        "let changed=Raycaster_set(custom,d,o);";
    const char *cases[]={
        "return ux_f64(plain+Ray.dz);","return ux_f64(plain+RaycasterState.near);",
        "let limit=ux_f64(plain+RaycasterState.far);return limit>0.0 && limit+1.0==limit;",
        "return ux_f64(custom+Ray.oy);","return ux_f64(custom+Ray.dz);",
        "return ux_f64(custom+RaycasterState.near);","return ux_f64(custom+RaycasterState.far);",
        "return ux_u32(custom+RaycasterState.layerMask);",
        "return ux_f64(custom+RaycasterState.pointThreshold)+ux_f64(custom+RaycasterState.lineThreshold);",
        "let made=Raycaster_init(384,o,d,5.0,4.0);return ux_f64(custom+RaycasterState.near);"
    };
    const double gold[]={-1,0,1,1,3,2,13,1,2,2};
    return g_math_run("G_RAY RaycasterState","raycaster-state",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?5:-1,"return ux_f64(custom+RaycasterState.far);");
}
