#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","ellipsecurve","arccurve",0};
    const char *setup="let cx=ux_f64_put(0,1.0);let cy=ux_f64_put(8,2.0);let rx=ux_f64_put(16,3.0);"
       "let end=ux_f64_put(40,1.5707963267948966);let clockwise=ux_u32_put(56,1);"
       "let first=ArcCurve_getPoint(128,0,0.0);let mid=ArcCurve_getPoint(160,0,1.0/3.0);"
       "let last=ArcCurve_getPoint(192,0,1.0);";
    const char *cases[]={"return ux_f64(first);","return ux_f64(first+8);","return ux_f64(mid);",
        "return ux_f64(mid+8);","return ux_f64(last);","return ux_f64(last+8);"};
    const double gold[]={4,2,1,-1,1,5};
    return g_math_run("G_STRUCT ArcCurve","arccurve",modules,setup,cases,gold,6,
        mutate?3:-1,"return ux_f64(last+8);");
}
