#pragma unisa use g_geometry
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"geometry-buffers","planegeometry","buffergeometryutils",0};
    char source[1000];
    tx_snprintf(source,sizeof source,"let result=GeometryBuffers_init(0,256,8,1024,12);"
        "let one=GeometryBuffers_init(64,2048,4,2304,6);let two=GeometryBuffers_init(128,2560,4,2816,6);"
        "let a=PlaneGeometry_generate(one,2.0,2.0,1,1);let b=PlaneGeometry_generate(two,%d.0,2.0,1,1);"
        "let id0=ux_u32_put(3072,one);let id1=ux_u32_put(3076,two);"
        "return BufferGeometryUtils_mergeGeometries(result,3072,2);",mutate?6:4);
    double gold[78]={8,12};
    int at=2;
    for(int m=0;m<2;m++) for(int v=0;v<4;v++) {
        gold[at++]=(1+m)*(2*(v%2)-1); gold[at++]=1-2*(v/2); gold[at++]=0;
        gold[at++]=0; gold[at++]=0; gold[at++]=1;
        gold[at++]=v%2; gold[at++]=1-v/2;
    }
    const int indices[]={0,2,1,2,3,1,4,6,5,6,7,5};
    for(int i=0;i<12;i++) gold[at++]=indices[i];
    return g_geometry_check_with("BufferGeometryUtils","buffergeometryutils",modules,source,gold,at,66,argv[1]);
}
