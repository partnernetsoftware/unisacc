#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","animation-view","gltf-cubic-interpolant","animation-gltf-numeric-delta",0};
    const char *setup=
        "let time0=ux_f32_put(64,1.0);let time1=ux_f32_put(68,3.0);"
        "let target=[11,8,13,17,12,19];let source=[99,2,4,-2,10,99];let i=0;"
        "while(i<6){let a=ux_f32_put(128+i*4,0.0+target[i]);let b=ux_f32_put(160+i*4,0.0+source[i]);i=i+1;}"
        "let t=AnimationSamples_init(0,64,128,2,3);let r=AnimationSamples_init(32,64,160,2,3);"
        "let size=AnimationUtils_gltfNumDelta(t,r,2.0,256,24,512);";
    const char *cases[]={
        "return size;","return ux_f32(260);","return ux_f32(272);","return ux_f32(256);","return ux_f32(276);",
        "let keep=ux_u32_put(256,777);let result=AnimationUtils_gltfNumDelta(t,r,2.0,256,23,512);return ux_u32(256);",
        "return AnimationUtils_gltfNumDelta(t,r,2.0,128,24,512);"
    };
    const double gold[]={24,.5,4.5,11,19,777,-1};
    return g_math_run("G_ANIM AnimationUtils glTF numeric delta","animation-gltf-numeric-delta",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let result=AnimationUtils_gltfNumDelta(t,r,3.0,256,24,512);return ux_f32(260);");
}
