#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","quaternion","object3d-layout","object3d","animation-view",
        "record-copy","propertybinding","propertymixer","propertymixer-discrete","propertymixer-quaternion","propertymixer-bound",0};
    const char *setup=
        "let arena=Object3D_initArena(0,4);let root=Object3D_create(arena);"
        "let chars=[46,112,111,115,105,116,105,111,110,91,121,93];let i=0;"
        "while(i<12){let c=ux_u8_put(2000+i,chars[i]);i=i+1;}"
        "let binding=PropertyBinding_bind(2100,arena,root,2000,12);"
        "let node=Object3D_address(arena,root);let pos=ux_u32(node+Object3D.position);"
        "let a=ux_f64_put(pos,1.0);let b=ux_f64_put(pos+8,2.0);let c=ux_f64_put(pos+16,3.0);"
        "let num=PropertyMixer_construct(2200,2240,2304,binding,1,0,0);"
        "let q=3800;let qi=4704;let q0=Quaternion_identity(q);"
        "let q1=Quaternion_set(qi,0.0,0.0,0.7071067811865475,0.7071067811865476);"
        "let quat=PropertyMixer_construct(3504,3552,3600,q,4,1,1);"
        "let bt=4176;let bi=4864;let b0=ux_u32_put(bt+4,1);let b1=ux_f64_put(bi,1.0);"
        "let flag=PropertyMixer_construct(4000,4032,4096,bt,2,2,1);"
        "let st=4496;let si=4896;let s0=ux_u32_put(st,1);let s1=ux_f64_put(si,4294967295.0);"
        "let word=PropertyMixer_construct(4304,4352,4416,st,1,3,1);"
        "let work=4608;let ni=4664;let n0=ux_f64_put(ni,10.0);"
        "let ns=PropertyMixer_saveBound(num,work);let qs=PropertyMixer_saveBound(quat,work);"
        "let bs=PropertyMixer_saveBound(flag,work);let ss=PropertyMixer_saveBound(word,work);"
        "let qpath=[46,113,117,97,116,101,114,110,105,111,110];i=0;"
        "while(i<11){let c=ux_u8_put(2024+i,qpath[i]);i=i+1;}"
        "let qb=PropertyBinding_bind(2136,arena,root,2024,11);"
        "let nodeQuat=PropertyMixer_construct(5000,5040,5120,qb,4,1,0);"
        "let nodeSaved=PropertyMixer_saveBound(nodeQuat,work);";
    const char *cases[]={
        "let m=PropertyMixer_construct(2200,2240,2304,binding,1,0,0);return 0.0+PropertyMixer_applyBound(m);",
        "let add=PropertyMixer_addBound(num,ni,0.25,2500,work);let apply=PropertyMixer_applyBound(num);return ux_f64(pos+8);",
        "let add=PropertyMixer_addBound(num,ni,0.25,2500,work);let apply=PropertyMixer_applyBound(num);"
            "let world=Object3D_updateMatrixWorld(arena,root,0);return ux_f64(ux_u32(node+Object3D.worldMatrix)+104);",
        "let add=PropertyMixer_addBound(num,ni,0.25,2500,work);let apply=PropertyMixer_applyBound(num);"
            "let restored=PropertyMixer_restoreBound(num);return ux_f64(pos+8);",
        "let add=PropertyMixer_addBound(num,ni,0.25,2500,work);let apply=PropertyMixer_applyBound(num);"
            "let off=ux_u32_put(node+Object3D.dirty,0);let again=PropertyMixer_addBound(num,ni,0.25,2500,work);"
            "let repeat=PropertyMixer_applyBound(num);return 0.0+ux_u32(node+Object3D.dirty);",
        "let add=PropertyMixer_addBound(num,ni,0.25,2500,work);let apply=PropertyMixer_applyBound(num);"
            "let external=ux_f64_put(pos+8,99.0);let again=PropertyMixer_addBound(num,ni,0.25,2500,work);"
            "let repeat=PropertyMixer_applyBound(num);return ux_f64(pos+8);",
        "let add=PropertyMixer_addBound(num,ni,1.0,2500,work);let outside=ux_f64_put(pos+8,9.0);"
            "let saved=PropertyMixer_saveBound(num,work);let other=ux_f64_put(pos+8,6.0);"
            "let restored=PropertyMixer_restoreBound(num);return ux_f64(pos+8);",
        "let add=PropertyMixer_addBound(num,ni,0.25,2500,work);let restored=PropertyMixer_restoreBound(num);"
            "let apply=PropertyMixer_applyBound(num);return ux_f64(pos+8);",
        "let add=PropertyMixer_addBound(num,ni,0.25,2501,work);let apply=PropertyMixer_applyBound(num);return ux_f64(pos+8);",
        "let add=PropertyMixer_addBound(quat,qi,0.5,2500,work);let apply=PropertyMixer_applyBound(quat);return ux_f64(q+16);",
        "let add=PropertyMixer_addBound(quat,qi,1.0,2500,work);let apply=PropertyMixer_applyBound(quat);"
            "let original=PropertyMixer_restoreBound(quat);return ux_f64(q+24);",
        "let add=PropertyMixer_addBound(quat,qi,0.5,2501,work);let apply=PropertyMixer_applyBound(quat);return ux_f64(q+16);",
        "let add=PropertyMixer_addBound(flag,bi,0.5,2500,work);let apply=PropertyMixer_applyBound(flag);return 0.0+ux_u32(bt);",
        "let add=PropertyMixer_addBound(flag,bi,0.75,2500,work);let apply=PropertyMixer_applyBound(flag);return 0.0+ux_u32(bt);",
        "let add=PropertyMixer_addBound(flag,bi,0.75,2500,work);let apply=PropertyMixer_applyBound(flag);"
            "let original=PropertyMixer_restoreBound(flag);return 0.0+ux_u32(bt+4);",
        "let invalid=ux_f64_put(bi,2.0);return 0.0+PropertyMixer_addBound(flag,bi,1.0,2500,work);",
        "let add=PropertyMixer_addBound(word,si,1.0,2500,work);let apply=PropertyMixer_applyBound(word);return 0.0+ux_u32(st);",
        "let add=PropertyMixer_addBound(word,si,1.0,2500,work);let apply=PropertyMixer_applyBound(word);"
            "let original=PropertyMixer_restoreBound(word);return 0.0+ux_u32(st);",
        "let add=PropertyMixer_addBound(num,ni,0.25,2500,work);let stale=ux_u32_put(binding+PropertyBinding.handle,root+65536);"
            "return 0.0+PropertyMixer_applyBound(num);",
        "let add=PropertyMixer_addBound(num,ni,0.25,2500,work);let stale=ux_u32_put(binding+PropertyBinding.handle,root+65536);"
            "let rejected=PropertyMixer_applyBound(num);return ux_f64(2240+PropertyMixer.weight);",
        "return 0.0+PropertyMixer_saveBound(num,2336);",
        "return 0.0+PropertyMixer_construct(2200,2240,2304,2336,1,0,1);",
        "let invalid=ux_u32_put(bt,2);return 0.0+PropertyMixer_saveBound(flag,work);",
        "return 0.0+PropertyMixer_construct(3504,3552,3600,q,3,1,1);",
        "let add=PropertyMixer_addBound(nodeQuat,qi,0.5,2500,work);let applied=PropertyMixer_applyBound(nodeQuat);"
            "return ux_f64(ux_u32(node+Object3D.quaternion)+16);",
        "let add=PropertyMixer_addBound(nodeQuat,qi,1.0,2500,work);let applied=PropertyMixer_applyBound(nodeQuat);"
            "let original=PropertyMixer_restoreBound(nodeQuat);return ux_f64(ux_u32(node+Object3D.quaternion)+24);",
    };
    const double z=0.3826834323650898;
    const double gold[]={-1,4,4,2,0,99,9,4,4.5,z,1,z,0,1,1,-2,4294967295.0,1,-1,0.25,-1,-1,-2,-1,z,1};
    return g_wasm_batch("G_ANIM PropertyMixer bound","propertymixer-bound",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,
        "let add=PropertyMixer_addBound(num,ni,0.25,2500,work);let apply=PropertyMixer_applyBound(num);return ux_f64(pos+8);");
}
