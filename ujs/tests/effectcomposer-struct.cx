#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"effectcomposer",0};
    const char *setup=
        "let control=0;let passes=128;let plan=192;let steps=256;"
        "let ready=EffectComposer_init(control,13,7,passes,4,40,20);"
        "let a=EffectComposer_addPass(control,10,1);let b=EffectComposer_addPass(control,20,2);"
        "let c=EffectComposer_addPass(control,30,3);let d=EffectComposer_addPass(control,40,5);";
    #define PLAN "let count=EffectComposer_plan(control,plan,steps,4);"
    const char *cases[]={
        PLAN "return 0.0+count;",
        PLAN "return 0.0+ux_u32(steps+ComposerStep.size+ComposerStep.id);",
        PLAN "return 0.0+ux_u32(steps+ComposerStep.read);",
        PLAN "return 0.0+ux_u32(steps+2*ComposerStep.size+ComposerStep.read);",
        PLAN "return 0.0+ux_u32(steps+2*ComposerStep.size+ComposerStep.screen);",
        PLAN "return 0.0+ux_u32(steps+2*ComposerStep.size+ComposerStep.flags);",
        PLAN "let accepted=EffectComposer_commit(control,plan);return 0.0+ux_u32(control+EffectComposer.read);",
        PLAN "let accepted=EffectComposer_commit(control,plan);return 0.0+EffectComposer_commit(control,plan);",
        PLAN "let resized=EffectComposer_resize(control,80,50);return 0.0+EffectComposer_commit(control,plan);",
        "let screen=EffectComposer_screen(control,0);" PLAN "return 0.0+ux_u32(steps+2*ComposerStep.size+ComposerStep.screen);",
        "let keep=ux_u32_put(plan+ComposerPlan.count,77);let refused=EffectComposer_plan(control,plan,steps,2);"
        "return 0.0+ux_u32(plan+ComposerPlan.count);",
        "let resized=EffectComposer_resize(control,80,50);return 0.0+ux_u32(control+EffectComposer.width);",
    };
    const double gold[]={3,30,13,7,1,5,7,-1,-1,0,77,80};
    return g_wasm_batch_addon("G_STRUCT EffectComposer dispatch","effectcomposer",argv[1],modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,PLAN "return 0.0+ux_u32(steps+2*ComposerStep.size+ComposerStep.write);");
}
