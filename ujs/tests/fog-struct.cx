#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","vector-scalar","color","gpu-fog","fog",0};
    const char *setup=
        "let initial=Color_setHex(256,8405000,1);let defaults=Fog_initDefault(0,initial);"
        "let fog=Fog_init(64,initial,2.0,10.0);let r=ux_u8_put(512,114);"
        "let i=ux_u8_put(513,105);let d=ux_u8_put(514,100);let g=ux_u8_put(515,103);"
        "let e=ux_u8_put(516,101);let named=Fog_setName(fog,512,5);"
        "let clone=Fog_clone(128,fog);let reset=Color_setHex(256,0,1);"
        "let red=Color_setHex(fog+Fog.red,16711680,1);let json=Fog_toJSON(192,fog);";
    const char *cases[]={
        "return ux_f64(defaults+Fog.near);","return ux_f64(defaults+Fog.far);",
        "return ux_u32(clone+Fog.nameBytes);","return Color_getHex(clone+Fog.red,1);",
        "return ux_f64(clone+Fog.near);","return ux_f64(clone+Fog.far);",
        "return ux_u32(json+FogJson.kind);","return ux_u32(json+FogJson.nameBytes);",
        "return ux_u8(ux_u32(json+FogJson.name));","return ux_u8(ux_u32(json+FogJson.name)+1);",
        "return ux_u8(ux_u32(json+FogJson.name)+2);","return ux_u8(ux_u32(json+FogJson.name)+3);",
        "return ux_u8(ux_u32(json+FogJson.name)+4);","return ux_u32(json+FogJson.color);",
        "return ux_f64(json+FogJson.near);","return ux_f64(json+FogJson.far);"
    };
    const double gold[]={1,1000,0,8405000,2,10,1,5,114,105,100,103,101,16711680,2,10};
    return g_math_run("G_STRUCT Fog","fog",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?2:-1,"let inherited=Fog_setName(clone,512,5);return ux_u32(inherited+Fog.nameBytes);");
}
