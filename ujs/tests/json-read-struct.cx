#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"json-read",0};
    const char *inputs[]={
        "{\"k\":-12.5e1,\"a\":[{},true,null,\"\\u005d\"],\"k\":2}",
        "{\"k\":1,}",
        "[1,]",
        "{\"k\" 1}",
        "[\"\\u12gb\"]",
        "[01]",
        "{\"x\":[1,2]}",
        "0.1000000000000000055511151231257827021181583404541015625",
        "0.0000125e2",
        "k"
    };
    char setup[16000],cases[9][288],mutation[288];
    const char *statements[9];
    int used=0,ends[10];
    for(int i=0;i<10;i++) {
        int size=(int)tx_len(inputs[i],128);
        ends[i]=i*128+size;
        for(int j=0;j<size;j++) {
            int n=tx_snprintf(setup+used,sizeof setup-used,"let byte=ux_u8_put(%d,%d);",
                i*128+j,(unsigned char)inputs[i][j]);
            if(n<0 || n>=(int)sizeof setup-used) return 2;
            used+=n;
        }
    }
    tx_snprintf(cases[0],sizeof cases[0],"let p=json_find_key(0,%d,1152,1);return json_read_number(p,%d);",ends[0],ends[0]);
    for(int i=1;i<6;i++) tx_snprintf(cases[i],sizeof cases[i],"return json_value_end(%d,%d);",i*128,ends[i]);
    tx_snprintf(cases[6],sizeof cases[6],"return json_find_key(768,%d,1152,1);",ends[6]);
    for(int i=7;i<9;i++) tx_snprintf(cases[i],sizeof cases[i],"return json_read_number(%d,%d);",i*128,ends[i]);
    for(int i=0;i<9;i++) statements[i]=cases[i];
    tx_snprintf(mutation,sizeof mutation,"let p=json_find_key(0,%d,1152,1);return json_read_number(p,%d)+1.0;",ends[0],ends[0]);
    const double gold[]={2,-1,-1,-1,-1,-1,-2,0.1,0.00125};
    return g_math_run("G_STRUCT JSON reader","json-read",modules,setup,statements,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,mutation);
}
