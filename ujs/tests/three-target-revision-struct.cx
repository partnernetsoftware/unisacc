#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"three-target-revision",0};
    const char *cases[]={
        "let n=UxeThree_targetRevision(64,3);return n*1000+(ux_u8(64)-48)*100+(ux_u8(65)-48)*10+ux_u8(66)-48;",
    };
    const double gold[]={3160};
    return g_math_run("G_STRUCT three target revision","three-target-revision",modules,"",cases,gold,1,
        mutate?0:-1,"let n=UxeThree_targetRevision(64,3);let swapped=ux_u8_put(66,49);"
        "return n*1000+(ux_u8(64)-48)*100+(ux_u8(65)-48)*10+ux_u8(66)-48;");
}
