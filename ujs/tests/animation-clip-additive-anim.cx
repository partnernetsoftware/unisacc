#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define ADDITIVE_RUN "let done=AnimationUtils_makeClipAdditive(target,reference,request,2048,512);"

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","f64-math","quaternion","animation-view","keyframe-track","animationclip",
        "animation-window","animation-subclip","discreteinterpolant","linearinterpolant","cubicinterpolant",
        "quaternionlinearinterpolant","animation-additive","animation-additive-quat","animation-track-delta",
        "gltf-cubic-interpolant","animation-gltf-numeric-delta","animation-gltf-quat-delta","animation-clip-additive",0};
    const char *setup=
        "let a=ux_u8_put(64,97);let b=ux_u8_put(65,98);let c=ux_u8_put(66,99);let end=ux_f32_put(132,1.0);"
        "let x=ux_f32_put(160,5.0);let y=ux_f32_put(164,10.0);let q=ux_f32_put(168,23.0);let r=ux_f32_put(172,42.0);"
        "let flag=ux_u32_put(176,1);let frame=ux_f32_put(188,4.0);let k=ux_f32_put(192,100.0);"
        "let v0=AnimationSamples_init(256,128,160,2,1);let v1=AnimationSamples_init(272,128,168,2,1);"
        "let v2=AnimationSamples_init(288,128,176,2,1);let v3=AnimationSamples_init(304,128,184,2,1);"
        "let v4=AnimationSamples_init(320,128,192,2,1);let v5=AnimationSamples_init(336,128,200,2,1);"
        "let t0=KeyframeTrack_init(384,64,1,v0);let t1=KeyframeTrack_init(400,65,1,v1);let t2=KeyframeTrack_init(416,66,1,v2);"
        "let t3=KeyframeTrack_init(432,64,1,v3);let t4=KeyframeTrack_init(448,65,1,v4);let t5=KeyframeTrack_init(464,66,1,v5);"
        "let p0=ux_u32_put(512,t0);let p1=ux_u32_put(516,t1);let p2=ux_u32_put(520,t2);"
        "let p3=ux_u32_put(528,t3);let p4=ux_u32_put(532,t4);let p5=ux_u32_put(536,t5);"
        "let k0=ux_u32_put(544,1);let k1=ux_u32_put(548,2);let k2=ux_u32_put(552,5);"
        "let k3=ux_u32_put(560,1);let k4=ux_u32_put(564,3);let k5=ux_u32_put(568,5);"
        "let target=AnimationClip_init(640,64,1,512,3,1.0,2500);"
        "let reference=AnimationClip_init(704,64,1,528,3,1.0,2500);let request=768;"
        "let tk=ux_u32_put(request+AnimationAdditiveRequest.targetKinds,544);"
        "let rk=ux_u32_put(request+AnimationAdditiveRequest.referenceKinds,560);"
        "let f=ux_f64_put(request+AnimationAdditiveRequest.frame,15.0);";
    const char *cases[]={
        ADDITIVE_RUN "return ux_f32(ux_u32(v0+AnimationSamples.values));",
        ADDITIVE_RUN "return ux_f32(ux_u32(v0+AnimationSamples.values)+4);",
        ADDITIVE_RUN "return ux_f32(ux_u32(v1+AnimationSamples.values));",
        ADDITIVE_RUN "return 0.0+ux_u32(ux_u32(v2+AnimationSamples.values));",
        ADDITIVE_RUN "return 0.0+ux_u32(target+AnimationClip.blendMode);",
        ADDITIVE_RUN "return ux_f32(ux_u32(v3+AnimationSamples.values)+4);",
        "let fail=AnimationUtils_makeClipAdditive(target,reference,request,2048,376);"
        "return 0.0+ux_u32(target+AnimationClip.blendMode);",
        "return 0.0+AnimationUtils_makeClipAdditive(target,reference,request,128,512);"
    };
    const double gold[]={3,8,23,1,2501,4,2500,-1};
    return g_wasm_batch("G_ANIM AnimationUtils additive clip","animation-clip-additive",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let edit=ux_f64_put(request+AnimationAdditiveRequest.frame,30.0);"
        ADDITIVE_RUN "return ux_f32(ux_u32(v0+AnimationSamples.values));");
}
