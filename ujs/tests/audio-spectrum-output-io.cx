#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","loadingmanager","fileloader","audioloader","audio-buffer-playback",
        "audio-analyser-window","audio-spectrum-output",0};
    const char *setup="let history=0;let out=256;"
        "let a=ux_f64_put(history,0.00042);let b=ux_f64_put(history+8,0.00025);"
        "let c=ux_f64_put(history+16,0.00004);let sentinel=ux_u8_put(out+16,77);";
    #define LOAD "let count=AudioAnalyser_getFrequencyData(history,16,out,20,0.0-100.0,0.0-30.0);"
    const char *cases[]={
        LOAD "return 0.0+count;",
        LOAD "return 0.0+ux_u8(out);",
        LOAD "return 0.0+ux_u8(out+1);",
        LOAD "return 0.0+ux_u8(out+2);",
        LOAD "return 0.0+ux_u8(out+15);",
        LOAD "return 0.0+ux_u8(out+16);",
        "let c=ux_f64_put(history,1.0);" LOAD "return 0.0+ux_u8(out);",
        "return 0.0+AudioAnalyser_getFrequencyData(history,16,out,16,0.0-30.0,0.0-100.0);",
        "let keep=ux_u8_put(out,77);let bad=ux_f64_put(history+16,0.0-1.0);"
        LOAD "return 0.0+(count==0-2 && ux_u8(out)==77);",
    };
    const double gold[]={16,118,101,43,0,77,255,-1,1};
    return g_wasm_batch_page("G_IO AudioAnalyser byte spectrum","audio-spectrum-output",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,LOAD "return 0.0+ux_u8(out+2);");
}
