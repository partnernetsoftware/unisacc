#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","loadingmanager","fileloader","audioloader",
        "audio-buffer-playback","audio-analyser-window","audio-spectrum",0};
    const char *setup="let state=0;let ring=128;let pcm=512;let history=1024;let work=2048;"
        "let ready=AudioAnalyser_initWindow(state,ring,32);let i=0;"
        "while(i<32){let p=ux_f32_put(pcm+i*4,0.5);i=i+1;}"
        "let fed=AudioAnalyser_pushWindow(state,pcm,32);";
    #define RUN "let count=AudioAnalyser_spectrum(state,history,work,512,0.0);"
    #define SMOOTH "let count=AudioAnalyser_spectrum(state,history,work,512,0.5);"
    const char *cases[]={
        RUN "return 0.0+count;",
        RUN "return 0.0+f64_floor_i64(ux_f64(history)*1000000.0+0.5);",
        RUN "return 0.0+f64_floor_i64(ux_f64(history+8)*1000000.0+0.5);",
        RUN "return 0.0+f64_floor_i64(ux_f64(history+16)*1000000.0+0.5);",
        SMOOTH "return 0.0+f64_floor_i64(ux_f64(history+8)*1000000.0+0.5);",
        SMOOTH "let next=AudioAnalyser_spectrum(state,history,work,512,0.5);"
        "return 0.0+f64_floor_i64(ux_f64(history+8)*1000000.0+0.5);",
        "return 0.0+AudioAnalyser_spectrum(state,history,work,511,0.0);",
        "let keep=ux_f64_put(history,0.5);let bad=ux_f64_put(history+8,0.0-1.0);"
        RUN "return 0.0+(count==0-1 && ux_f64(history)==0.5);",
    };
    const double gold[]={16,210000,125000,20000,62500,93750,-1,1};
    return g_wasm_batch_page("G_IO AudioAnalyser Blackman FFT","audio-spectrum",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        RUN "return 0.0+f64_floor_i64(ux_f64(history+16)*1000000.0+0.5);");
}
