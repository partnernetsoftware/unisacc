#pragma unisa use sys.fs
#pragma unisa use mem.heap
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use text.num

static int execute(char **args,int seconds) {
    char *out=0;
    size_t n=0;
    int rc=cx_runv_timeout(args,seconds,&out,&n);
    if(rc && out) printf("%s\n",out);
    mm_free(out);
    return rc;
}

static double sine(double x) {
    double term=x,sum=x;
    for(int i=1;i<=14;i++) {
        term*=-x*x/((2*i)*(2*i+1));
        sum+=term;
    }
    return sum;
}

static void expected(int frame,double *gold) {
    const double heading[]={0,18,-18,52}, bank[]={0,12,-15,24};
    const double flight_x[]={2048,2064,2032,2080}, flight_z[]={2048,2016,2016,1984};
    const double camera_altitude[]={45,45,45,50}, horizon[]={100,102,98,100};
    double angle=heading[frame]*0.01745329251994329577;
    double s=sine(angle),c=sine(1.57079632679489661923-angle);
    double lean=bank[frame],abs_lean=lean<0?-lean:lean;
    double dx=27-(flight_x[frame]-2048)/8+c*lean*.43;
    double dy=28*.22-camera_altitude[frame]-abs_lean*.34;
    double dz=-90-(flight_z[frame]-2048)/8+s*lean*.43;
    double lateral=c*dx+s*dz,depth=s*dx-c*dz;
    double pixel_x=212.5+151*lateral/depth;
    gold[0]=lateral;
    gold[1]=dy;
    gold[2]=depth;
    gold[3]=pixel_x;
    gold[4]=horizon[frame]-.29*lean*(pixel_x-213)/213-151*dy/depth;
}

static int browser(const char *dir) {
    char profile[320],url[380];
    tx_snprintf(profile,sizeof profile,"--user-data-dir=%s/chrome",dir);
    tx_snprintf(url,sizeof url,"file://%s/probe.html",dir);
    char *args[]={"google-chrome","--headless=new","--allow-file-access-from-files",
        "--disable-background-networking","--no-first-run",profile,
        "--virtual-time-budget=4000","--dump-dom",url,0};
    char *out=0;
    size_t bytes=0;
    int rc=cx_runv_timeout(args,14,&out,&bytes);
    const char start[]="<pre id=\"result\">[";
    long at=!rc && out?tx_find(out,bytes,start,sizeof start-1):-1;
    if(at<0) {
        if(out) printf("D1_SCENE_PROBE document=%s\n",out);
        mm_free(out);
        return 2;
    }
    char *next=out+at+sizeof start-1;
    int failed=0;
    for(int i=0;i<4;i++) {
        double gold[5];
        expected(i,gold);
        for(int j=0;j<5;j++) {
            char *end=0;
            double value=tx_strtod(next,&end);
            if(end==next || *end!=(i==3 && j==4?']':',')) { mm_free(out); return 2; }
            double error=value-gold[j];
            if(!(error>=-1e-8 && error<=1e-8)) {
                printf("D1_SCENE_PROBE case=%d actual=%.17g gold=%.17g\n",i*5+j,value,gold[j]);
                failed++;
            }
            next=end+1;
        }
    }
    mm_free(out);
    printf("D1_SCENE_PROBE cases=20 failed=%d\n",failed);
    return failed!=0;
}

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],base[300],product[300],page[300],host[300],replacement[300];
    if(sy_mkdtemp("/tmp","ujs-d1-scene-",dir,sizeof dir)) return 2;
    tx_snprintf(base,sizeof base,"%s/base.wasm",dir);
    tx_snprintf(product,sizeof product,"%s/product.wasm",dir);
    tx_snprintf(page,sizeof page,"%s/probe.html",dir);
    tx_snprintf(host,sizeof host,"%s/host-abi.js",dir);
    tx_snprintf(replacement,sizeof replacement,"%s/mutant.ujs",dir);
    char *source="ujs/practice/uxe/test/d1-scene-base.ujs";
    if(mutate) {
        unsigned char *raw=0;
        int64_t n=0;
        if(sy_read_file(source,&raw,&n,8192)) return 2;
        const char from[]="+dz*ux_f64(cameraWorld+16)";
        long at=tx_find((char *)raw,n,from,sizeof from-1);
        if(at<0) { mm_free(raw); return 2; }
        raw[at]='-';
        int write_rc=sy_write_file(replacement,raw,n,0600);
        mm_free(raw);
        if(write_rc) return 2;
        source=replacement;
    }
    char *base_args[]={"./ujs/ujs2wasm.com",
        "ujs/practice/uxe/test/d1-scene-base-header.ujs",
        "ujs/practice/uxe/base/f64-math.ujs","ujs/practice/uxe/base/views.ujs",
        "ujs/practice/uxe/base/matrix4.ujs","ujs/practice/uxe/base/object-layouts.ujs",
        "ujs/practice/uxe/base/object3d.ujs","ujs/practice/uxe/base/scene.ujs",source,"-o",base,0};
    char *product_args[]={"./ujs/ujs2wasm.com",
        "ujs/practice/uxe/test/d1-scene-product-header.ujs","ujs/practice/uxe/base/math.ujs",
        "ujs/practice/uxe/test/d1-scene-product.ujs","-o",product,0};
    int rc=2;
    sy_stat_t st;
    if(!execute(base_args,15) && !execute(product_args,10) && !sy_lstat(base,&st)) {
        printf("D1_SCENE_BASE bytes=%lld budget=4194304\n",(long long)st.size);
        if(st.size>4194304) {
            printf("D1_SCENE_BASE_BUDGET_EXCEEDED\n");
            rc=1;
        } else if(!sy_copy("ujs/practice/uxe/test/d1-scene-probe.html",page,0600) &&
            !sy_copy("ujs/practice/uxe/base/host-abi.js",host,0600)) {
            rc=browser(dir);
        }
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(execute(clean,5)) return 2;
    return rc;
}
