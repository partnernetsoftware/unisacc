#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","animation-view","gltf-cubic-interpolant",0};
    const char *setup=
        "let a=ux_f32_put(64,1.0);let b=ux_f32_put(68,3.0);"
        "let c=ux_f32_put(128,99.0);let d=ux_f32_put(132,2.0);let e=ux_f32_put(136,4.0);"
        "let f=ux_f32_put(140,0.0-2.0);let g=ux_f32_put(144,10.0);let h=ux_f32_put(148,99.0);"
        "let view=AnimationSamples_init(0,64,128,2,3);"
        "let q=0.7071067811865476;let w=ux_f32_put(540,1.0);let qz=ux_f32_put(584,q);let qw=ux_f32_put(588,q);"
        "let quat=AnimationSamples_init(32,64,512,2,12);";
    const char *cases[]={
        "let r=GltfCubic_evaluate(view,2.0,256,0);return ux_f32(r);",
        "let r=GltfCubic_evaluate(view,0.0,256,0);return ux_f32(r);",
        "let r=GltfCubic_evaluate(view,4.0,256,0);return ux_f32(r);",
        "return GltfCubic_evaluate(view,2.0,256,1);",
        "return GltfCubic_evaluate(view,2.0,144,0);",
        "let r=GltfCubic_evaluate(quat,2.0,832,1);return ux_f32(r+8);",
        "let r=GltfCubic_evaluate(quat,2.0,832,1);return ux_f32(r+12);"
    };
    const double q=(float)0.7071067811865476;
    const double z=(float)(q*.5),w=(float)((1+q)*.5),length2=z*z+w*w;
    double norm=1;
    for(int i=0;i<10;i++) norm=(norm+length2/norm)*.5;
    const double gold[]={7.5,2,10,-1,-1,(float)(z/norm),(float)(w/norm)};
    return g_math_run("G_ANIM GLTF cubic interpolation","gltf-cubic-interpolant",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let wrong=ux_f32_put(136,0.0);let r=GltfCubic_evaluate(view,2.0,256,0);return ux_f32(r);");
}
