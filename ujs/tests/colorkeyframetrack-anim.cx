#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","animation-view","discreteinterpolant","linearinterpolant",
        "cubicinterpolant","keyframe-track","numberkeyframetrack","colorkeyframetrack",0};
    const char *setup=
        "let a=ux_f32_put(64,0.0);let b=ux_f32_put(68,2.0);"
        "let red=ux_f32_put(128,1.0);let green=ux_f32_put(144,0.5);let blue=ux_f32_put(148,1.0);"
        "let name=ux_u8_put(100,120);let samples=AnimationSamples_init(0,64,128,2,3);"
        "let track=KeyframeTrack_init(32,100,1,samples);";
    const char *cases[]={
        "let p=ColorKeyframeTrack_evaluate(track,1.0,192);return ux_f32(p);",
        "let p=ColorKeyframeTrack_evaluate(track,1.0,192);return ux_f32(p+4);",
        "let p=ColorKeyframeTrack_evaluate(track,1.0,192);return ux_f32(p+8);",
        "let t=KeyframeTrack_setInterpolation(track,2300);let p=ColorKeyframeTrack_evaluate(t,1.0,192);return ux_f32(p);",
        "let view=AnimationSamples_init(0,64,128,2,2);return ColorKeyframeTrack_evaluate(track,1.0,192);"
    };
    const double gold[]={0.5,0.25,0.5,1,-1};
    return g_math_run("G_ANIM ColorKeyframeTrack","colorkeyframetrack",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let p=ColorKeyframeTrack_evaluate(track,1.0,192);return ux_f32(p+8);");
}
