#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define FIX "ujs/practice/uxe/test/"
#define RGBA(r,g,b,a) ((r)+256u*(g)+65536u*(b)+16777216u*(a))
#define EXPECTED_TEXTURES 2,1,1,0,0,RGBA(7,23,123,255),RGBA(9,5,40,128), \
    1,2,1,0,0,RGBA(11,12,13,255),RGBA(6,7,8,128),1,1,4,4,2,4,4

static const double gold[]={
    EXPECTED_TEXTURES,
    EXPECTED_TEXTURES,
    -1,-1,-1,-1,-1,-1,-1,2,-2,-3,2,3,1,4,0,
};

static int texture_layout(const char *file) {
    unsigned char *input=0;
    int64_t bytes=0;
    if(sy_read_file(BASE "gpu-packet.ujs",&input,&bytes,30000)) return 1;
    const char *text=(const char *)input;
    const char anchor[]="struct GpuTextureSource {";
    const long start=tx_find(text,bytes,anchor,sizeof anchor-1);
    const long end=start<0?-1:tx_find(text+start,bytes-start,"\n}\n",3);
    const int failed=end<0 || sy_write_file(file,text+start,end+3,0600);
    mm_free(input);
    return failed;
}

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[420],abi[320],layout[320],wasm[320],url[850];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-data-async-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(layout,sizeof layout,"%s/texture.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/async.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,"file://%s/" FIX "data-texture-loader-async-r160.html?wasm=%s&mode=%d",
        cwd,wasm,mutate);
    const char signature[]="export uxe_data_async(op:i64,which:i64,a:i64,b:i64,c:i64,d:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,layout,BASE "record-copy.ujs",
        BASE "loadingmanager.ujs",BASE "defaultloadingmanager.ujs",BASE "loader.ujs",BASE "fileloader.ujs",
        BASE "loader-base.ujs",BASE "loader-family.ujs",BASE "loader-family-classes.ujs",
        BASE "datatextureloader.ujs",BASE "data-texture-loader-async.ujs",FIX "data-texture-loader-async-probe.ujs","-o",wasm,0};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    int failed=length<=0 || length>=(int)sizeof url ||
        sy_write_file(abi,signature,sizeof signature-1,0600) || texture_layout(layout);
    if(!failed) {
        char *out=0;
        size_t bytes=0;
        const int rc=cx_runv_timeout(compile,10,&out,&bytes);
        if(rc) { printf("DATA_ASYNC compile_rc=%d %.*s\n",rc,(int)bytes,out?out:""); failed=1; }
        mm_free(out);
    }
    if(!failed) failed=r160_wait_read(url,"#r160",actual,count,dir);
    if(!failed) for(int i=0;i<count;i++) if(actual[i]!=gold[i]) {
        printf("DATA_ASYNC case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
        failed++;
    }
    if(sy_remove_all(dir)) failed++;
    printf("G_IO DataTextureLoader async cases=%d failed=%d\n",count,failed);
    return failed!=0;
}
