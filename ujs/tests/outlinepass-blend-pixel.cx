#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

static double rgba(int r,int g,int b,int a) {
    return r+256.0*g+65536.0*b+16777216.0*a;
}

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"f64-math","postprocess-rgba8","outlinepass-blend",0};
    const char *setup=
        "let i=0;while(i<16){let c=ux_u32_put(32+i,511203900);i=i+4;}"
        "let a=ux_u32_put(0,5913630);let b=ux_u32_put(4,1431976990);"
        "let c=ux_u32_put(8,2858040350);let d=ux_u32_put(12,4280598783);";
    char generated[4][140];
    const char *cases[6];
    double gold[]={rgba(60,90,120,30),rgba(70,110,150,58),rgba(80,130,180,143),rgba(255,255,156,255),-1,-1};
    for(int i=0;i<4;i++) {
        tx_snprintf(generated[i],sizeof generated[i],
            "let n=OutlinePass_blendRGBA8(0,32,4);return 0.0+ux_u32(%d);",32+4*i);
        cases[i]=generated[i];
    }
    cases[4]="return 0.0+OutlinePass_blendRGBA8(0,8,4);";
    cases[5]="return 0.0+OutlinePass_blendRGBA8(0,6291452,4);";
    return g_wasm_batch_addon("G_PIXEL OutlinePass blend","outlinepass-blend",argv[1],modules,
        setup,cases,gold,6,mutate?1:-1,
        "let k=ux_u8_put(7,255);let n=OutlinePass_blendRGBA8(0,32,4);return 0.0+ux_u32(36);");
}

