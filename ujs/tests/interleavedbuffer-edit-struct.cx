#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","datautils","bufferattribute","interleavedbuffer",
        "interleavedbuffer-edit","interleavedbuffer-updates",0};
    const char *setup=
        "let a=InterleavedBuffer_init(0,128,2,12,9);let b=InterleavedBuffer_init(32,192,3,8,9);"
        "let clamped=InterleavedBuffer_init(64,320,2,3,3);let small=InterleavedBuffer_init(96,512,2,4,1);"
        "let updates=InterleavedBuffer_initUpdates(672,a,704,2);"
        "let i=0;while(i<6){let x=ux_f32_put(128+i*4,i+1.0);let y=ux_f32_put(192+i*4,i+7.0);i=i+1;}"
        "let x=ux_f64_put(384,0.5);let y=ux_f64_put(392,1.5);let z=ux_f64_put(400,300.0);let w=ux_f64_put(408,0.0-1.0);"
        "let q0=ux_f32_put(512,1.5);let q1=ux_f32_put(516,2.5);";
    #define COPY "let result=InterleavedBuffer_copyAt(a,1,b,1,768);"
    #define OVERLAP "let result=InterleavedBuffer_set(a,1,128,5,9,768);"
    #define CLAMP "let result=InterleavedBuffer_set(clamped,0,384,4,10,768);"
    #define CROSS "let result=InterleavedBuffer_set(small,4,512,2,9,768);"
    #define FIRST "let first=InterleavedBuffer_addRange(updates,1,3);"
    #define SECOND "let second=InterleavedBuffer_addRange(updates,2,2);"
    const char *cases[]={
        COPY "return ux_f32(140);",
        COPY "return ux_f32(148);",
        OVERLAP "return ux_f32(148);",
        OVERLAP "return ux_f32(132);",
        CLAMP "return 0.0+ux_u8(320);",
        CLAMP "return 0.0+ux_u8(321);",
        CLAMP "return 0.0+ux_u8(322);",
        CLAMP "return 0.0+ux_u8(323);",
        CROSS "return 0.0+ux_u8(516);",
        CROSS "return 0.0+ux_u8(517);",
        FIRST SECOND "return 0.0+ux_u32(updates+InterleavedUpdateState.count);",
        FIRST SECOND "return 0.0+ux_u32(712+InterleavedUpdateRange.start);",
        FIRST SECOND "return 0.0+ux_u32(704+InterleavedUpdateRange.count);",
        FIRST SECOND "let clear=InterleavedBuffer_clearRanges(updates);"
          "return 0.0+ux_u32(updates+InterleavedUpdateState.count);",
        "return 0.0+ux_i32(updates+InterleavedUpdateState.legacyCount);",
        "let set=InterleavedBuffer_legacyRange(updates,2,3);"
          "return 0.0+ux_u32(updates+InterleavedUpdateState.legacyOffset);",
        COPY OVERLAP FIRST "return 0.0+ux_u32(a+InterleavedBuffer.version);",
        "return 0.0+InterleavedBuffer_set(a,5,192,2,9,768);",
        FIRST SECOND "return 0.0+InterleavedBuffer_addRange(updates,0,1);",
        "let mark=ux_f32_put(148,77.0);let refused=InterleavedBuffer_copyAt(a,1,b,2,768);return ux_f32(148);",
    };
    const double gold[]={9,11,5,1,0,2,255,0,1,2,2,2,3,0,-1,2,0,-1,-2,77};
    return g_wasm_batch_page("G_STRUCT InterleavedBuffer updates","interleavedbuffer-edit",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let result=InterleavedBuffer_copyAt(a,1,b,0,768);return ux_f32(140);");
}
