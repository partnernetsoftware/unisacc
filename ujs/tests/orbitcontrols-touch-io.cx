#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"f64-math","vector-scalar","orbitcontrols","orbitcontrols-pan",
        "control-bindings","orbitcontrols-pinch","orbitcontrols-touch",0};
    const char *setup="let eye=0;let target=64;let right=96;let up=128;let c=256;let contacts=512;"
        "let z=ux_f64_put(eye+16,10.0);let x=ux_f64_put(right,1.0);let y=ux_f64_put(up+8,1.0);"
        "let init=OrbitControls_init(c,eye,target,100.0);";
    #define TOUCH "OrbitControls_touchPerspective(c,contacts,"
    #define DOWN "let first=" TOUCH "1,7,20.0,20.0);"
    #define DOWN_ORBIT "let route=OrbitControls_initTouch(contacts,0,right,up,90.0);" DOWN
    #define DOWN_MAP "let route=OrbitControls_initTouch(contacts,1,right,up,90.0);" DOWN
    #define SECOND "let second=" TOUCH "1,8,40.0,20.0);"
    #define ORBIT_PAIR DOWN_ORBIT SECOND
    #define MAP_PAIR DOWN_MAP SECOND
    #define MOVE "let move=" TOUCH "2,8,60.0,20.0);"
    #define STEP "let step=OrbitControls_step(c);"
    #define TARGET_X "return ux_f64(c+OrbitControls.targetX);"
    #define EYE_X "return ux_f64(c+OrbitControls.x);"
    #define RADIUS "return ux_f64(c+OrbitControls.radius);"
    const char *cases[]={
        DOWN_ORBIT "let move=" TOUCH "2,7,30.0,20.0);" STEP EYE_X,
        DOWN_MAP "let move=" TOUCH "2,7,30.0,40.0);" STEP TARGET_X,
        DOWN_MAP "let move=" TOUCH "2,7,30.0,40.0);" STEP "return ux_f64(c+OrbitControls.targetZ);",
        ORBIT_PAIR MOVE STEP TARGET_X,
        ORBIT_PAIR MOVE STEP RADIUS,
        MAP_PAIR MOVE STEP EYE_X,
        MAP_PAIR MOVE STEP RADIUS,
        ORBIT_PAIR MOVE STEP "let cancel=" TOUCH "3,8,60.0,20.0);"
          "let stale=" TOUCH "2,7,5.0,5.0);" "let update=OrbitControls_step(c);" TARGET_X,
        ORBIT_PAIR "let stray=" TOUCH "2,20,60.0,20.0);" STEP RADIUS,
        ORBIT_PAIR "let move=" TOUCH "2,7,0.0,20.0);" STEP TARGET_X,
    };
    const double gold[]={-5.877852522924732,-2,-4,-2,5,-2.938926261462366,5,-2,10,2};
    return g_wasm_batch_addon("G_RAY OrbitControls touch routing","orbitcontrols-touch",
        argv[1],modules,setup,cases,gold,sizeof gold/sizeof gold[0],mutate?3:-1,
        MAP_PAIR MOVE STEP TARGET_X);
}
