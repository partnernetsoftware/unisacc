#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","glb-container","json-read","loader-json",
        "gltf-accessor","gltf-triangle-topology","gltf-topology-accessors",0};
    const char *setup="let p=0;let i=64;let xyz=128;let indices=256;let out=512;"
        "let a=ux_u32_put(p+GltfAccessor.bytes,xyz);let b=ux_u32_put(p+GltfAccessor.count,4);"
        "let c=ux_u32_put(p+GltfAccessor.stride,12);let d=ux_u32_put(p+GltfAccessor.elementBytes,12);"
        "let e=ux_u32_put(p+GltfAccessor.component,5126);let f=ux_u32_put(p+GltfAccessor.lanes,3);"
        "let g=ux_u32_put(i+GltfAccessor.bytes,indices);let h=ux_u32_put(i+GltfAccessor.count,4);"
        "let j=ux_u32_put(i+GltfAccessor.stride,2);let k=ux_u32_put(i+GltfAccessor.elementBytes,2);"
        "let l=ux_u32_put(i+GltfAccessor.component,5123);let m=ux_u32_put(i+GltfAccessor.lanes,1);"
        "let x=ux_u16_put(indices,3);let y=ux_u16_put(indices+2,2);let z=ux_u16_put(indices+4,1);";
    #define EXPLICIT "let n=GltfLoader_accessorTriangles(5,p,i,1,out,6);"
    #define IMPLICIT "let n=GltfLoader_accessorTriangles(5,p,i,0,out,6);"
    const char *cases[]={
        EXPLICIT "return 0.0+n;",
        EXPLICIT "return 0.0+ux_u32(out+12);",
        EXPLICIT "return 0.0+ux_u32(out+20);",
        IMPLICIT "return 0.0+ux_u32(out+20);",
        "let bad=ux_u32_put(i+GltfAccessor.normalized,1);" EXPLICIT "return 0.0+n;",
        "let bad=ux_u32_put(i+GltfAccessor.stride,4);" EXPLICIT "return 0.0+n;",
        "return 0.0+GltfLoader_accessorTriangles(5,p,i,1,xyz,6);",
        "let keep=ux_u32_put(out,77);let bad=ux_u16_put(indices+6,4);"
        EXPLICIT "return 0.0+(n==0-3 && ux_u32(out)==77);",
    };
    const double gold[]={6,0,2,1,-1,-1,-1,1};
    return g_wasm_batch_addon("G_IO GLTF accessor topology","gltf-topology-accessors",argv[1],modules,
        setup,cases,gold,sizeof gold/sizeof gold[0],mutate?2:-1,IMPLICIT "return 0.0+ux_u32(out+20);");
}
