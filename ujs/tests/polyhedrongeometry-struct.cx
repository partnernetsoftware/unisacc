#pragma unisa use g_geometry
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","geometry-buffers","polyhedrongeometry",0};
    char source[768];
    tx_snprintf(source,sizeof source,"let mesh=GeometryBuffers_init(0,256,3,1024,0);"
        "let a=ux_f64_put(2048,1.0);let b=ux_f64_put(2088,1.0);let c=ux_f64_put(2104,1.0);"
        "let j=ux_u32_put(3076,1);let k=ux_u32_put(3080,2);"
        "let config=PolyhedronGeometry_init(64,2048,3,3072,3,4096);"
        "return PolyhedronGeometry_generate(mesh,config,%d.0,0);",mutate?3:2);
    const double n=-0.5773502691896257645;
    const double gold[]={3,0, 0,0,2,n,n,n,.75,.5, 0,2,0,n,n,n,.875,1, 2,0,0,n,n,n,1,.5};
    return g_geometry_check("PolyhedronGeometry","polyhedrongeometry",modules,source,gold,26,26);
}
