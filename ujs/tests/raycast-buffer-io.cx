#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","vector-scalar","vector3","ray","raycast-memory","raycaster-state",
        "raycast-mesh","raycast-hit-sort","raycast-buffer",0};
    const char *setup=
        "let state=Raycaster_default(0);let mesh=128;let m=256;"
        "let m0=ux_f64_put(m,1.0);let m1=ux_f64_put(m+40,1.0);let m2=ux_f64_put(m+80,1.0);let m3=ux_f64_put(m+120,1.0);"
        "let points=[-1,-1,-8,1,-1,-8,0,1,-8,-1,-1,-4,1,-1,-4,0,1,-4];"
        "let indices=[0,1,2,3,4,5,3,4,5];"
        "let i=0;while(i<18){let p=ux_f32_put(512+i*4,0.0+points[i]);i=i+1;}"
        "i=0;while(i<9){let p=ux_u16_put(640+i*2,indices[i]);i=i+1;}"
        "let a=ux_u32_put(mesh+RayMeshBuffer.positions,512);let b=ux_u32_put(mesh+RayMeshBuffer.vertexCount,6);"
        "let c=ux_u32_put(mesh+RayMeshBuffer.positionStride,12);let d=ux_u32_put(mesh+RayMeshBuffer.indices,640);"
        "let e=ux_u32_put(mesh+RayMeshBuffer.indexBytes,2);let f=ux_u32_put(mesh+RayMeshBuffer.faceCount,3);"
        "let g=ux_u32_put(mesh+RayMeshBuffer.matrixWorld,m);let h=ux_u32_put(mesh+RayMeshBuffer.layerMask,1);";
    const char *cases[]={
        "return Raycaster_intersectMeshBuffer(state,mesh,1024,3,2048,384);",
        "let n=Raycaster_intersectMeshBuffer(state,mesh,1024,3,2048,384);return ux_f64(1024+RayMeshHit.distance);",
        "let n=Raycaster_intersectMeshBuffer(state,mesh,1024,3,2048,384);return ux_u32(1024+RayMeshHit.face);",
        "let n=Raycaster_intersectMeshBuffer(state,mesh,1024,3,2048,384);return ux_u32(1024+RayMeshHit.size+RayMeshHit.face);",
        "let n=Raycaster_intersectMeshBuffer(state,mesh,1024,3,2048,384);return ux_f64(1024+2*RayMeshHit.size+RayMeshHit.distance);",
        "let cut=ux_f64_put(state+RaycasterState.far,5.0);return Raycaster_intersectMeshBuffer(state,mesh,1024,3,2048,384);",
        "let layer=ux_u32_put(mesh+RayMeshBuffer.layerMask,2);return Raycaster_intersectMeshBuffer(state,mesh,1024,3,2048,384);",
        "let bad=ux_u16_put(656,99);return Raycaster_intersectMeshBuffer(state,mesh,1024,3,2048,384);",
        "let guard=ux_u32_put(1024,777);let n=Raycaster_intersectMeshBuffer(state,mesh,1024,2,2048,384);return ux_u32(1024);"
    };
    const double gold[]={3,4,1,2,8,2,0,-2,777};
    return g_math_run("G_RAY Raycaster indexed buffer","raycast-buffer",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let n=Raycaster_intersectMeshBuffer(state,mesh,1024,3,2048,384);return ux_f64(1024+2*RayMeshHit.size+RayMeshHit.distance);");
}
