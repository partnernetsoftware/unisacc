#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"views","record-copy","gpu-packet","gpu-texture-table","texture-object","cube-texture-object",0};
    const char *setup="let table=GpuTextureTable_init(0,2);let image=512;"
        "let w=ux_u32_put(image+GpuTextureSource.width,1);let h=ux_u32_put(image+GpuTextureSource.height,1);"
        "let data=ux_u32_put(image+GpuTextureSource.rgba,600);"
        "let i=0;while(i<6){let put=ux_u8_put(600+4*i,10+i);i=i+1;}"
        "let source=CubeTexture_init(640,table,image);let clone=CubeTexture_clone(672,source);"
        "if(clone<0){return 0.0+clone;}";
    const char *cases[]={
        "return 0.0+ux_u8(CubeTexture_face(clone,0));",
        "return 0.0+ux_u8(CubeTexture_face(clone,5));",
        "return 0.0+(ux_u32(source+Texture.source)==ux_u32(clone+Texture.source));",
        "return 0.0+CubeTexture_face(clone,6);",
        "let high=ux_u32_put(image+GpuTextureSource.rgba,6291452);return 0.0+CubeTexture_init(704,table,image);",
    };
    const double gold[]={10,15,1,-1,-1};
    return g_wasm_batch_page("G_STRUCT CubeTexture faces","cube-texture-object",
        "ujs/practice/uxe/test/wasm-batch-gpu-layout.html",modules,setup,cases,gold,5,mutate?1:-1,
        "return 0.0+ux_u8(CubeTexture_face(clone,4));");
}
