#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d","object3d-lifecycle",
        "datautils","bufferattribute","buffergeometry","mesh-layout","mesh","points",0};
    const char *setup=
        "let arena=Object3D_initArena(0,2);let node=Object3D_create(arena);let rec=Object3D_address(arena,node);"
        "let px=ux_f64_put(ux_u32(rec+Object3D.position),10.0);let world=Object3D_updateMatrixWorld(arena,node,0);"
        "let geo=BufferGeometry_init(1024,1088,1,1120,0);"
        "let position=BufferAttribute_init(1152,1344,3,3,9,0);"
        "let index=BufferAttribute_init(1216,1408,3,1,4,0);"
        "let i=0;while(i<9){let v=ux_f32_put(1344+4*i,1.0+i);i=i+1;}"
        "let a=ux_u16_put(1408,2);let b=ux_u16_put(1410,0);let c=ux_u16_put(1412,1);"
        "let add=BufferGeometry_setAttribute(geo,8,position);let ix=BufferGeometry_setIndex(geo,index);"
        "let range=BufferGeometry_setDrawRange(geo,1,2);let points=Points_init(1472,arena,node,geo,5,1600,0);";
    const char *cases[]={
        "return Points_vertexIndex(points,0,8);","return Points_vertexIndex(points,1,8);",
        "let p=Points_worldVertex(points,arena,0,8,1664);return ux_f64(p);",
        "let p=Points_worldVertex(points,arena,1,8,1664);return ux_f64(p+16);",
        "return Points_vertexIndex(points,2,8);",
        "let ix=BufferGeometry_setIndex(geo,0-1);return Points_vertexIndex(points,0,8);"
    };
    const double gold[]={0,1,11,6,-1,1};
    return g_math_run("G_STRUCT Points","points",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?2:-1,"let q=BufferGeometry_setDrawRange(geo,0,2);"
        "let p=Points_worldVertex(points,arena,0,8,1664);return ux_f64(p);");
}
