#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

static int stencil_value(int tag,int initial) {
    switch(tag) {
        case 0: return 0;
        case 1: return initial;
        case 2: return 83;
        case 3: return initial<255?initial+1:255;
        case 4: return initial>0?initial-1:0;
        case 5: return (initial+1)&255;
        case 6: return (initial+255)&255;
        case 7: return 255-initial;
    }
    return -1;
}

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char prelude[]=
        "import host_gpu_submit from \"uxe_gpu_v1\" (i64,i64) i64;\n"
        "export uxe_stencil_op(value:i64,variant:i64) i64 version 1;\n";
    char dir[220],abi[260],wasm[260],cwd[400],url[760],*out=0;
    size_t size=0;
    if(sy_mkdtemp("/tmp","uxe-stencil-ops-",dir,sizeof dir) || sy_cwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/fixture.wasm",dir);
    char gold[128];
    int used=0;
    for(int v=0;v<3;v++) for(int tag=0;tag<8;tag++) {
        const int value=stencil_value(tag,v==0?0:v==1?255:34);
        used+=tx_snprintf(gold+used,sizeof gold-used,"%s%d",used?",":"",value);
    }
    tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/gpu-stencil-ops-r160.html?wasm=%s&mutate=%d&gold=%s",
        cwd,wasm,mutate,gold);
    int failed=sy_write_file(abi,prelude,sizeof prelude-1,0600)!=0;
    char *compile[]={"./ujs/ujs2wasm.com",abi,"ujs/practice/uxe/base/record-copy.ujs",
        "ujs/practice/uxe/base/gpu-packet.ujs","ujs/practice/uxe/base/gpu-state.ujs",
        "ujs/practice/uxe/base/gpu-stencil-ops-generated.ujs",
        "ujs/practice/uxe/test/gpu-stencil-ops-probe.ujs","-o",wasm,0};
    if(!failed) {
        const int rc=cx_runv_timeout(compile,6,&out,&size);
        if(rc) printf("GPU_STENCIL_OPS compile_rc=%d %.*s\n",rc,(int)size,out?out:"");
        failed=rc!=0;
        mm_free(out);
        out=0;
    }
    enum { functions=8, variants=3, values=functions*variants*4 };
    double pixels[values]={0};
    if(!failed && r160_wait_read(url,"#r160",pixels,values,dir)) {
        printf("GPU_STENCIL_OPS browser_read_failed\n");
        failed=1;
    }
    int checked=0;
    if(!failed) for(int v=0;v<variants;v++) for(int tag=0;tag<functions;tag++) {
        const int offset=(v*functions+tag)*4;
        if(pixels[offset]!=255 || pixels[offset+1]!=255 || pixels[offset+2]!=0 || pixels[offset+3]!=0) {
            printf("GPU_STENCIL_OPS tag=%d sample=%d match=%.0f/%.0f control=%.0f/%.0f\n",
                tag,v,pixels[offset],pixels[offset+1],pixels[offset+2],pixels[offset+3]);
            failed++;
        }
        checked++;
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&out,&size)) failed++;
    mm_free(out);
    printf("GPU_STENCIL_OPS ops=%d variants=%d stencil_values=%d failed=%d\n",functions,variants,checked,failed);
    return failed!=0;
}
