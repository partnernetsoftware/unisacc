#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int texture=argc==3 && (tx_eqz(argv[2],"--texture") || tx_eqz(argv[2],"--texture-mutate"));
    const int mutate=argc==3 && (tx_eqz(argv[2],"--mutate") || tx_eqz(argv[2],"--texture-mutate"));
    if((argc!=2 && !mutate && !texture) || argv[1][0]!='/') return 2;
    char dir[256],cwd[390],abi[300],wasm[300],url[720];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-shaderpass-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/filter.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/ujs/practice/uxe/test/shaderpass-r160.html?package=%s&wasm=%s&mode=%d&texture=%d",cwd,argv[1],wasm,mutate,texture);
    const char entry[]=
        "import host_gpu_submit from \"uxe_gpu_v1\"(i64,i64) i64;\n"
        "import host_gpu_native_copy from \"uxe_gpu_target_v1\"(i64,i64,i64,i64) i64;\n"
        "import host_gpu_native_filter from \"uxe_gpu_target_v1\"(i64,i64,i64,i64,f64) i64;\n"
        "import host_gpu_native_overlay from \"uxe_gpu_target_v1\"(i64,i64,i64,i64,f64) i64;\n"
        "export uxe_shaderpass(mode:i64,mutate:i64,vn:i64,fn:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,"ujs/practice/uxe/base/record-copy.ujs",
        "ujs/practice/uxe/base/gpu-packet.ujs","ujs/practice/uxe/base/gpu-target.ujs",
        "ujs/practice/uxe/base/effectcomposer.ujs","ujs/practice/uxe/base/effectcomposer-gpu-targets.ujs",
        "ujs/practice/uxe/base/gpu-native-sample.ujs",
        texture?"ujs/practice/uxe/base/texturepass.ujs":"ujs/practice/uxe/base/shaderpass.ujs",
        texture?"ujs/practice/uxe/test/texturepass-probe.ujs":"ujs/practice/uxe/test/shaderpass-probe.ujs","-o",wasm,0};
    enum { count=64 };
    double actual[count]={0};
    const double rgba[]={64,32,16,255}, lower[]={64,32,48,255}, upper[]={16,64,64,255};
    const char *name=texture?"TexturePass":"ShaderPass";
    char *output=0;
    size_t bytes=0;
    int failed=length<0 || length>=(int)sizeof url || sy_write_file(abi,entry,sizeof entry-1,0600);
    if(!failed) {
        int rc=cx_runv_timeout(compile,6,&output,&bytes);
        if(rc) { printf("G_PIXEL ShaderPass compiler_rc=%d %s\n",rc,output?output:""); failed=1; }
        mm_free(output);
        output=0;
    }
    if(!failed) failed=r160_wait_read(url,"#r160",actual,count,dir);
    if(!failed) for(int i=0;i<count;i++) {
        const double *expected=texture?(i%16<8?lower:upper):rgba;
        if(actual[i]!=expected[i%4]) {
            printf("G_PIXEL %s channel=%d actual=%.17g gold=%.17g\n",name,i,actual[i],expected[i%4]);
            failed++;
        }
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&output,&bytes)) failed++;
    mm_free(output);
    printf("G_PIXEL %s channels=%d failed=%d\n",name,count,failed);
    return failed!=0;
}
