#pragma unisa use g_wasm_batch
#pragma unisa use text.deflate
#pragma unisa use text.fmt
#pragma unisa use text.text

static void be(unsigned char *at,unsigned value) {
    at[0]=value>>24; at[1]=value>>16; at[2]=value>>8; at[3]=value;
}

static int chunk(unsigned char *dst,unsigned kind,const unsigned char *data,int length) {
    be(dst,length);be(dst+4,kind);
    for(int i=0;i<length;i++) dst[8+i]=data[i];
    be(dst+8+length,dz_crc32(0,dst+4,4+length));
    return 12+length;
}

static int fixture(unsigned char *dst,int depth,int variant) {
    const unsigned char magic[]={137,80,78,71,13,10,26,10};
    for(int i=0;i<8;i++) dst[i]=magic[i];
    const unsigned char header[]={0,0,0,5,0,0,0,2,depth,3,0,0,0};
    int size=8+chunk(dst+8,0x49484452,header,sizeof header);
    const unsigned char colors[]={255,0,0,0,255,0,0,0,255,255,255,0};
    const unsigned char alpha[]={255,127,0,255,0};
    const int count=depth==1?2:variant==1?3:4;
    if(variant!=3) size+=chunk(dst+size,0x504c5445,colors,count*3);
    if(variant==4) size+=chunk(dst+size,0x504c5445,colors,count*3);
    if(variant!=3) size+=chunk(dst+size,0x74524e53,alpha,variant==2?5:depth==1?2:3);
    const int row=(5*depth+7)/8;
    const int bytes=2*(row+1);
    unsigned char raw[12]={0},zlib[23]={120,1,1,bytes,0,255-bytes,255};
    const unsigned char pixels[]={0,1,2,3,0,3,2,1,0,3};
    for(int y=0;y<2;y++) {
        unsigned char packed[5]={0};
        for(int i=0;i<5;i++) {
            const int bit=i*depth;
            const int sample=pixels[5*y+i]&((1<<depth)-1);
            packed[bit/8]|=sample<<(8-depth-bit%8);
        }
        raw[y*(row+1)]=y;
        for(int x=0;x<row;x++) raw[y*(row+1)+x+1]=packed[x]-(y && x?packed[x-1]:0);
    }
    unsigned a=1,b=0;
    for(int i=0;i<bytes;i++) { zlib[7+i]=raw[i];a+=raw[i];b+=a; }
    be(zlib+7+bytes,(b<<16)+a);
    size+=chunk(dst+size,0x49444154,zlib,11+bytes);
    size+=chunk(dst+size,0x49454e44,0,0);
    return size;
}

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","png-header","png-scanlines","png-bits","png-huffman","png-fixed","png-stored",0};
    unsigned char image[220];
    char setup[6400];
    int used=0;
    const int depths[]={2,1,4,8,2,2,2,2};
    for(int i=0;i<8;i++) {
        const int count=fixture(image,depths[i],i<4?0:i-3);
        used+=tx_snprintf(setup+used,sizeof setup-used,"let n%d=%d;if(1){let bytes=[",i,count);
        for(int j=0;j<count;j++) used+=tx_snprintf(setup+used,sizeof setup-used,"%s%d",j?",":"",image[j]);
        used+=tx_snprintf(setup+used,sizeof setup-used,"];let p=0;while(p<n%d){let v=ux_u8_put(%d+p,bytes[p]);p=p+1;}}",i,128+i*256);
    }
    #define DECODE "let result=PngDecode_rgba8(128,n0,2400,40,4096,4096);"
    const char *cases[]={
        DECODE "return 0.0+result;",
        DECODE "return 0.0+ux_u8(2405);",
        DECODE "return 0.0+ux_u8(2407);",
        DECODE "return 0.0+ux_u8(2411);",
        DECODE "return 0.0+ux_u8(2421);",
        "let n=PngDecode_rgba8(384,n1,2400,40,4096,4096);return 0.0+ux_u8(2407);",
        "let n=PngDecode_rgba8(640,n2,2400,40,4096,4096);return 0.0+ux_u8(2421);",
        "let n=PngDecode_rgba8(896,n3,2400,40,4096,4096);return 0.0+ux_u8(2411);",
        "let keep=ux_u8_put(2400,99);let n=PngDecode_rgba8(1152,n4,2400,40,4096,4096);"
        "return 0.0+ux_u8(2400)-(n<0)*100;",
        "return 0.0+PngDecode_rgba8(1408,n5,2400,40,4096,4096);",
        "return 0.0+PngDecode_rgba8(1664,n6,2400,40,4096,4096);",
        "return 0.0+PngDecode_rgba8(1920,n7,2400,40,4096,4096);"
    };
    const double gold[]={40,255,127,0,255,127,255,0,-1,-5,-5,-5};
    return g_wasm_batch("G_IO PngPalette","png-palette",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,DECODE "return 0.0+ux_u8(2411);");
}
