#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define PIX(offset) "let n=CompressedTexture_astcRGBA8(32,512,40);return 0.0+ux_u32(512+" #offset ");"

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","compressedtextureloader","compressed-texture-bc1",
        "compressed-texture-bc2","compressed-texture-astc-constant",0};
    const char *setup="let mip=CompressedTextureLoader_level(32,128,32,5,2,33778);"
        "let format=ux_u32_put(32+CompressedMip.format,37808);"
        "let a=ux_u32_put(128,4294966780);let b=ux_u32_put(132,4294967295);"
        "let c=ux_u32_put(144,4294966780);let d=ux_u32_put(148,4294967295);"
        "let e=ux_u32_put(136,2147483647);let f=ux_u32_put(140,4294901760);"
        "let g=ux_u32_put(152,0);let h=ux_u32_put(156,1073807359);";
    const char *cases[]={
        "return 0.0+CompressedTexture_astcRGBA8(32,512,40);",PIX(0),PIX(16),PIX(36),
        "let bad=ux_u8_put(145,255);let guard=ux_u8_put(512,77);let n=CompressedTexture_astcRGBA8(32,512,40);return 0.0+n*100+ux_u8(512);",
        "return 0.0+CompressedTexture_astcRGBA8(32,512,39);",
        "let wrong=ux_u32_put(32+CompressedMip.format,37822);return 0.0+CompressedTexture_astcRGBA8(32,512,40);",
        "let format=ux_u32_put(32+CompressedMip.format,37809);let size=ux_u32_put(32+CompressedMip.bytes,16);" PIX(16),
        "let format=ux_u32_put(32+CompressedMip.format,37853);let size=ux_u32_put(32+CompressedMip.bytes,16);" PIX(36),
        "let s=ux_u32_put(128,33558012);let t=ux_u32_put(132,524288);" PIX(0),
        "let s=ux_u32_put(128,3580);let t=ux_u32_put(132,524288);return 0.0+CompressedTexture_astcRGBA8(32,512,40);",
    };
    const double gold[]={40,0xff007fffu,0x40ff0000u,0x40ff0000u,-323,-1,-2,0xff007fffu,0xff007fffu,0xff007fffu,-4};
    return g_wasm_batch("G_IO ASTC LDR constant color","compressed-texture-astc-constant",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?2:-1,"let color=ux_u8_put(157,254);" PIX(16));
}
