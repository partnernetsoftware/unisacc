#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","datautils","bufferattribute","record-copy","animation-view","animation-array",0};
    const char *setup=
        "let signed=32;let unsigned=64;let plainNumber=96;let data=128;let output=256;let dst=320;let temp=768;"
        "let a=ux_u32_put(signed+AnimationArrayView.data,data);let b=ux_u32_put(signed+AnimationArrayView.count,3);"
        "let c=ux_u32_put(signed+AnimationArrayView.kind,12);"
        "let clone=uxe_copy_record(unsigned,signed,AnimationArrayView.size);"
        "let k=ux_u32_put(unsigned+AnimationArrayView.kind,13);"
        "let first=ux_u32_put(data,4294967295);let firstHi=ux_u32_put(data+4,4294967295);"
        "let mid=ux_u32_put(data+12,2147483648);"
        "let last=ux_u32_put(data+16,3);let lastHi=ux_u32_put(data+20,2097152);"
        "let p=ux_u32_put(plainNumber+AnimationArrayView.data,192);"
        "let q=ux_u32_put(plainNumber+AnimationArrayView.count,1);let x=ux_f64_put(192,4.0);";
    #define UNSIGN "let out=AnimationUtils_convertArray(signed,13,0,output,dst,48,temp);"
    #define SIGN "let out=AnimationUtils_convertArray(unsigned,12,0,output,dst,48,temp);"
    #define PLAIN_S "let out=AnimationUtils_convertArray(signed,0,0,output,dst,48,temp);"
    #define PLAIN_U "let out=AnimationUtils_convertArray(unsigned,0,0,output,dst,48,temp);"
    const char *cases[]={
        "return 0.0+AnimationUtils_isTypedArray(signed);",
        "return 0.0+AnimationUtils_isTypedArray(unsigned);",
        "return 0.0+(AnimationUtils_convertArray(signed,12,0,output,dst,48,temp)==signed);",
        "let out=AnimationUtils_convertArray(signed,12,1,output,dst,48,temp);"
          "let changed=ux_u32_put(data,3);return 0.0+(out!=signed && ux_u32(dst)==4294967295);",
        UNSIGN "return 0.0+ux_u32(output+AnimationArrayView.kind);",
        UNSIGN "return 0.0+ux_u32(dst+16);",
        UNSIGN "return 0.0+ux_u32(dst+20);",
        SIGN "return 0.0+ux_u32(output+AnimationArrayView.kind);",
        SIGN "return 0.0+ux_u32(dst+4);",
        SIGN "return 0.0+ux_u32(dst+12);",
        PLAIN_S "return 0.0+ux_u32(output+AnimationArrayView.kind);",
        PLAIN_U "return 0.0+ux_u32(output+AnimationArrayView.kind);",
        PLAIN_S "return 0.0+AnimationUtils_isTypedArray(out);",
        PLAIN_U "return 0.0+(AnimationUtils_convertArray(out,0,0,384,448,48,temp)==out);",
        PLAIN_U "let fresh=AnimationUtils_convertArray(out,0,1,384,448,48,temp);"
          "let change=ux_u32_put(dst,9);return 0.0+(fresh!=out && ux_u32(448)==4294967295);",
        PLAIN_S "let typed=AnimationUtils_convertArray(out,13,0,384,448,48,temp);return 0.0+ux_u32(448+4);",
        "return 0.0+AnimationUtils_convertArray(plainNumber,12,0,output,dst,48,temp);",
        "return 0.0+AnimationUtils_convertArray(signed,9,0,output,dst,48,temp);",
        "let empty=ux_u32_put(signed+AnimationArrayView.count,0);"
          "return 0.0+AnimationUtils_convertArray(signed,9,0,output,dst,48,temp);",
        "let empty=ux_u32_put(plainNumber+AnimationArrayView.count,0);"
          "let out=AnimationUtils_convertArray(plainNumber,12,0,output,dst,48,temp);"
          "return 0.0+(out==output && ux_u32(out+AnimationArrayView.count)==0);",
        "let empty=ux_u32_put(plainNumber+AnimationArrayView.count,0);"
          "let typed=ux_u32_put(plainNumber+AnimationArrayView.kind,10);"
          "return 0.0+AnimationUtils_convertArray(plainNumber,12,0,output,dst,48,temp);",
        "let dataview=ux_u32_put(signed+AnimationArrayView.kind,11);return 0.0+AnimationUtils_isTypedArray(signed);",
        "let mark=ux_u32_put(dst,77);let bad=AnimationUtils_convertArray(plainNumber,13,0,output,dst,48,temp);"
          "return 0.0+ux_u32(dst);",
        "return 0.0+AnimationUtils_convertArray(0-1,13,0,output,dst,48,temp);",
    };
    const double gold[]={1,1,1,1,13,3,2097152,12,4294967295.0,2147483648.0,
        14,15,0,1,1,4294967295.0,-2,-2,-2,1,-2,0,77,-1};
    return g_wasm_batch_page("G_ANIM AnimationUtils BigInt arrays","animation-array-bigint",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?5:-1,UNSIGN
        "let number=ux_u32(dst+20)*4294967296.0+ux_u32(dst+16);return number-9007199254740992.0;");
}
