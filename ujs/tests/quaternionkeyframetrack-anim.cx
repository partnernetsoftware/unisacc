#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","vector-scalar","quaternion","animation-view","discreteinterpolant",
        "quaternionlinearinterpolant","keyframe-track","quaternionkeyframetrack",0};
    const char *setup=
        "let a=ux_f32_put(64,0.0);let b=ux_f32_put(68,2.0);"
        "let c=ux_f32_put(140,1.0);let d=ux_f32_put(152,-1.0);let name=ux_u8_put(100,120);"
        "let view=AnimationSamples_init(0,64,128,2,4);let track=KeyframeTrack_init(32,100,1,view);";
    const char *cases[]={
        "let p=QuatTrack_evaluate(track,1.0,192,256);return ux_f32(p+8);",
        "let t=QuatTrack_setInterpolation(track,2302);return KeyframeTrack_getInterpolation(t);",
        "let t=QuatTrack_setInterpolation(track,2300);let p=QuatTrack_evaluate(t,1.0,192,256);return ux_f32(p+8);",
        "let t=QuatTrack_setInterpolation(track,2300);let p=QuatTrack_evaluate(t,2.0,192,256);return ux_f32(p+8);",
        "return QuatTrack_evaluate(track,1.0,192,32);"
    };
    const double gold[]={(float)-0.7071067811865476,2301,0,-1,-1};
    return g_math_run("G_ANIM QuaternionKeyframeTrack","quaternionkeyframetrack",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let t=QuatTrack_setInterpolation(track,2300);let p=QuatTrack_evaluate(t,1.0,192,256);return ux_f32(p+8);");
}
