#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"shapeutils",0};
    const char *setup="let ax=ux_f64_put(144,2.0);let bx=ux_f64_put(160,2.0);"
        "let by=ux_f64_put(168,2.0);let cx=ux_f64_put(176,1.0);let cy=ux_f64_put(184,1.0);"
        "let dy=ux_f64_put(200,2.0);let count=ShapeUtils_triangulateShape(128,5,1024,9,2048);";
    const char *cases[]={
        "return ShapeUtils_area(128,5);","return ShapeUtils_isClockWise(128,5);","return count;",
        "return ux_u32(1024);","return ux_u32(1028);","return ux_u32(1032);",
        "return ux_u32(1036);","return ux_u32(1040);","return ux_u32(1044);",
        "return ux_u32(1048);","return ux_u32(1052);","return ux_u32(1056);"
    };
    const double gold[]={3,0,9,3,4,0,1,2,3,3,0,1};
    return g_math_run("G_STRUCT ShapeUtils","shapeutils",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,"return ux_u32(1028);");
}
