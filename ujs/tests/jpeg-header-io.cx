#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"jpeg-header",0};
    const char *setup="let bytes=[255,216,255,224,0,4,1,2,255,192,0,17,8,0,2,0,3,3,1,34,0,2,17,1,3,17,1];"
        "let i=0;while(i<27){let byte=ux_u8_put(i,bytes[i]);i=i+1;}";
    const char *cases[]={
        "let h=JpegHeader_probe(0,27,64);return ux_u32(h+JpegHeader.width);",
        "let h=JpegHeader_probe(0,27,64);return ux_u32(h+JpegHeader.height);",
        "let h=JpegHeader_probe(0,27,64);return ux_u32(h+JpegHeader.components);",
        "let h=JpegHeader_probe(0,27,64);return ux_u32(h+JpegHeader.frame);",
        "return JpegHeader_probe(0,26,64);",
        "let bad=ux_u8_put(19,0);return JpegHeader_probe(0,27,64);",
        "let bad=ux_u8_put(24,1);return JpegHeader_probe(0,27,64);",
        "return JpegHeader_probe(0,27,4);"
    };
    const double gold[]={3,2,3,192,-2,-4,-4,-1};
    return g_math_run("G_IO JpegHeader","jpeg-header",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let bad=ux_u8_put(16,4);let h=JpegHeader_probe(0,27,64);return ux_u32(h+JpegHeader.width);");
}
