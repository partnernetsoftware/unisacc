#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"curve-line","linecurve3",0};
    const char *setup="let a=ux_f64_put(0,1.0);let b=ux_f64_put(8,2.0);let c=ux_f64_put(16,3.0);let d=ux_f64_put(24,3.0);let e=ux_f64_put(32,5.0);let f=ux_f64_put(40,9.0);"
        "let point=LineCurve3_getPoint(128,0,0.25);let end=LineCurve3_getPointAt(160,0,1.0);"
        "let tangent=LineCurve3_getTangent(192,0);";
    const char *cases[]={"return ux_f64(point);","return ux_f64(point+8);","return ux_f64(end);",
        "return LineCurve3_getLength(0);","return ux_f64(tangent);","return ux_f64(tangent+8);"};
    const double gold[]={1.5,2.75,3,7,2.0/7.0,3.0/7.0};
    return g_math_run("G_STRUCT LineCurve3","linecurve3",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,"return ux_f64(end);");
}
