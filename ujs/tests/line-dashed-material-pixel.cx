#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define FIX "ujs/practice/uxe/test/"

enum { width=32, row_values=3*width+1, count=2*row_values+2 };

static int expected_pixel(int row,int x) {
    if(row==0 && x>=2 && x<30 && (x-2)%4<3) return 0xffffff;
    if(row==1 && x>=5 && x<27 && (9+12*(x-5))%40<=16) return 0x3366cc;
    if(row==2 && x>=8 && x<24) return 0x00ff00;
    return 0;
}

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[420],abi[320],wasm[320],url[850];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-line-dashed-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/dashed.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,"file://%s/" FIX "line-dashed-material-r160.html?wasm=%s&mode=%d",cwd,wasm,mutate);
    const char signature[]="import host_gpu_submit from \"uxe_gpu_v1\"(i64,i64) i64;\n"
        "export uxe_line_dashed(mode:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,BASE "record-copy.ujs",BASE "gpu-packet.ujs",
        BASE "line-dashed-material.ujs",FIX "line-dashed-material-probe.ujs","-o",wasm,0};
    double actual[count]={0};
    int failed=length<=0 || length>=(int)sizeof url || sy_write_file(abi,signature,sizeof signature-1,0600);
    if(!failed) {
        char *out=0;
        size_t bytes=0;
        const int rc=cx_runv_timeout(compile,6,&out,&bytes);
        if(rc) { printf("LINE_DASHED compile_rc=%d %.*s\n",rc,(int)bytes,out?out:""); failed=1; }
        mm_free(out);
    }
    if(!failed) failed=r160_wait_read(url,"#r160",actual,count,dir);
    if(!failed) {
        for(int i=0;i<count;i++) {
            const int local=i%row_values;
            const int gold=i<2*row_values && local<3*width?expected_pixel(local/width,local%width):0;
            if(actual[i]!=gold) {
                printf("LINE_DASHED case=%d actual=%.17g gold=%d\n",i,actual[i],gold);
                failed++;
            }
        }
        printf("LINE_DASHED framebuffer_pixels=1024 different=%.17g alpha_errors=%.17g\n",
            actual[2*row_values],actual[2*row_values+1]);
    }
    if(sy_remove_all(dir)) failed++;
    printf("G_PIXEL LineDashedMaterial cases=%d failed=%d\n",count,failed);
    return failed!=0;
}
