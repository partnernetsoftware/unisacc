#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d","animation-view","propertybinding",0};
    const char *setup=
        "let arena=Object3D_initArena(0,4);let root=Object3D_create(arena);"
        "let chars=[46,112,111,115,105,116,105,111,110,91,121,93];let i=0;"
        "while(i<12){let c=ux_u8_put(2000+i,chars[i]);i=i+1;}"
        "let binding=PropertyBinding_bind(2100,arena,root,2000,12);"
        "let node=Object3D_address(arena,root);let pos=ux_u32(node+Object3D.position);"
        "let a=ux_f64_put(pos,1.0);let b=ux_f64_put(pos+8,2.0);let c=ux_f64_put(pos+16,3.0);"
        "let value=ux_f64_put(2200,7.0);";
    const char *cases[]={
        "let n=PropertyBinding_transfer(binding,2200,0);return ux_f64(2200);",
        "let n=PropertyBinding_transfer(binding,2200,1);return ux_f64(pos+8);",
        "let n=PropertyBinding_transfer(binding,2200,1);return ux_f64(pos);",
        "let n=PropertyBinding_transfer(binding,2200,1);let u=Object3D_updateMatrixWorld(arena,root,0);"
        "return ux_f64(ux_u32(node+Object3D.worldMatrix)+104);",
        "let bad=ux_u8_put(2010,119);return PropertyBinding_bind(2100,arena,root,2000,12);",
        "let bad=ux_u32_put(binding+PropertyBinding.handle,root+65536);return PropertyBinding_transfer(binding,2200,1);"
    };
    const double gold[]={2,7,1,7,-1,-1};
    return g_math_run("G_ANIM PropertyBinding","propertybinding",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let c=ux_u8_put(2010,120);let p=PropertyBinding_bind(2100,arena,root,2000,12);"
        "let n=PropertyBinding_transfer(p,2200,1);return ux_f64(pos+8);");
}
