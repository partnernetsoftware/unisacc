#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","uniform",0};
    const char *setup="let a=Uniform_init(0,7);let b=Uniform_init(4,32);let x=ux_u32_put(32,9);"
        "let y=ux_u32_put(48,ux_u32(32));let copy=Uniform_clone(8,b,48);";
    const char *cases[]={"return ux_u32(a);","let c=Uniform_clone(12,a,0-1);return ux_u32(c);",
        "return ux_u32(copy)!=ux_u32(b);","return ux_u32(ux_u32(copy));"};
    const double gold[]={7,7,1,9};
    return g_math_run("G_STRUCT Uniform","uniform",modules,setup,cases,gold,sizeof gold/sizeof gold[0],
        mutate?2:-1,"let c=Uniform_clone(8,b,0-1);return ux_u32(c)!=ux_u32(b);");
}
