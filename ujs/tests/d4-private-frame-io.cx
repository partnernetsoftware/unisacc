#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[390],wasm[300],url[690];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-d4-private-",dir,sizeof dir)) return 2;
    tx_snprintf(wasm,sizeof wasm,"%s/d4.wasm",dir);
    int length=tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d4-private-frame-r160.html?wasm=file://%s&mutate=%d",
        cwd,wasm,mutate);
    char *build[]={"cx","ujs/practice/uxe/products/d4/build.cx","--",wasm,0};
    const double gold[]={19,684,0,0,0,8,1,1,0.48,11.28,0.48,10.8};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    char *output=0;
    size_t bytes=0;
    int failed=length<0 || length>=(int)sizeof url;
    if(!failed) {
        const int rc=cx_runv_timeout(build,16,&output,&bytes);
        if(rc) { printf("D4_PRIVATE build_rc=%d %s\n",rc,output?output:""); failed=1; }
        mm_free(output); output=0;
    }
    if(!failed) {
        failed=r160_wait_read(url,"#result",actual,count,dir);
        if(!failed) {
            printf("D4_PRIVATE phases=%.0f joint_components=%.0f joint_diff=%.0f body_diff=%.0f camera_diff=%.0f refusals=%.0f raster=%.0f motion=%.0f\n",
                actual[0],actual[1],actual[2],actual[3],actual[4],actual[5],actual[6],actual[7]);
            for(int i=0;i<count;i++) {
                const double delta=actual[i]-gold[i];
                if(!(delta>=-1e-9 && delta<=1e-9)) {
                    printf("D4_PRIVATE field=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
                    failed=1;
                }
            }
        }
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&output,&bytes)) failed=1;
    mm_free(output);
    printf("D4_PRIVATE failed=%d\n",failed);
    return failed;
}
