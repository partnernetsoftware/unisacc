#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"curve-hermite","splinecurve",0};
    const char *setup="let bx=ux_f64_put(16,2.0);let by=ux_f64_put(24,2.0);let cx=ux_f64_put(32,4.0);"
        "let first=SplineCurve_getPoint(128,0,3,0.25);let later=SplineCurve_getPoint(160,0,3,0.75);"
        "let end=SplineCurve_getPoint(192,0,3,1.0);";
    const char *cases[]={"return ux_f64(first);","return ux_f64(first+8);","return ux_f64(later);",
        "return ux_f64(later+8);","return ux_f64(end);","return ux_f64(end+8);"};
    const double gold[]={0.875,1.125,3.125,1.125,4,0};
    return g_math_run("G_STRUCT SplineCurve","splinecurve",modules,setup,cases,gold,6,
        mutate?0:-1,"return ux_f64(later);");
}
