#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","animation-view","keyframe-track","animationclip","animation-window","animation-subclip",0};
    const char *setup=
        "let a=ux_u8_put(64,97);let b=ux_u8_put(65,98);let c=ux_u8_put(66,99);let name=ux_u8_put(67,116);"
        "let t0=ux_f32_put(128,0.5);let t1=ux_f32_put(132,1.0);let t2=ux_f32_put(136,1.5);"
        "let t3=ux_f32_put(140,1.0);let t4=ux_f32_put(144,1.75);let t5=ux_f32_put(148,2.0);"
        "let value=ux_f32_put(176,9.0);"
        "let v0=AnimationSamples_init(256,128,160,3,1);let v1=AnimationSamples_init(272,140,176,2,2);"
        "let v2=AnimationSamples_init(288,148,192,1,1);"
        "let k0=KeyframeTrack_init(320,64,1,v0);let k1=KeyframeTrack_init(336,65,1,v1);"
        "let k2=KeyframeTrack_init(352,66,1,v2);let mode=KeyframeTrack_setInterpolation(k1,2300);"
        "let p0=ux_u32_put(384,k0);let p1=ux_u32_put(388,k1);let p2=ux_u32_put(392,k2);"
        "let clip=AnimationClip_init(512,64,1,384,3,2.0,2500);let request=576;"
        "let start=ux_f64_put(request+AnimationSubclipRequest.startFrame,15.0);"
        "let end=ux_f64_put(request+AnimationSubclipRequest.endFrame,60.0);"
        "let fps=ux_f64_put(request+AnimationSubclipRequest.fps,30.0);"
        "let n=ux_u32_put(request+AnimationSubclipRequest.name,67);"
        "let nb=ux_u32_put(request+AnimationSubclipRequest.nameBytes,1);"
        "let trimmed=AnimationUtils_subclip(clip,request,640,1024,512);"
        "let newTracks=ux_u32(trimmed+AnimationClip.tracks);let second=ux_u32(newTracks+4);"
        "let samples=ux_u32(second+KeyframeTrack.samples);";
    const char *cases[]={
        "return ux_u32(trimmed+AnimationClip.trackCount);","return ux_f64(trimmed+AnimationClip.duration);",
        "return ux_f32(ux_u32(samples+AnimationSamples.times));",
        "return ux_f32(ux_u32(samples+AnimationSamples.values));",
        "return ux_u32(second+KeyframeTrack.interpolation);",
        "let edit=ux_f32_put(176,7.0);return ux_f32(ux_u32(samples+AnimationSamples.values));",
        "let guard=ux_u32_put(704+AnimationClip.trackCount,777);"
        "let bad=AnimationUtils_subclip(clip,request,704,1536,8);return ux_u32(704+AnimationClip.trackCount);",
        "return AnimationUtils_subclip(clip,request,704,128,512);",
        "return ux_u8(ux_u32(trimmed+AnimationClip.name));"
    };
    const double gold[]={2,1.25,.5,9,2300,9,777,-1,116};
    return g_math_run("G_ANIM AnimationUtils subclip","animation-subclip",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,"return ux_f32(ux_u32(samples+AnimationSamples.times))-0.5;");
}
