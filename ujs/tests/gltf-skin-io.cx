#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","glb-container","json-read","loader-json","gltf-accessor","gltf-skin",0};
    #define SKIN_PREFIX "{\"skins\":[{\"joints\":[0,"
    const char json[]=SKIN_PREFIX "2],\"skeleton\":0,\"inverseBindMatrices\":0}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":2,\"type\":\"MAT4\"}],\"bufferViews\":[{\"buffer\":0,\"byteLength\":128}]}";
    int bytes=sizeof json-1;
    char setup[1400];
    int n=tx_snprintf(setup,sizeof setup,"let json=[");
    for(int i=0;i<bytes;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[i]);
    tx_snprintf(setup+n,sizeof setup-n,
        "];let i=0;while(i<%d){let cell=ux_u8_put(128+i,json[i]);i=i+1;}"
        "let a=ux_u32_put(GlbResource.json,128);let b=ux_u32_put(GlbResource.jsonBytes,%d);"
        "let c=ux_u32_put(GlbResource.bin,512);let d=ux_u32_put(GlbResource.binBytes,128);"
        "let p=ux_f32_put(624,-2.0);let jointAt=%d;",bytes,bytes,128+(int)sizeof SKIN_PREFIX-1);
    const char *cases[]={
        "let a=GltfLoader_skin(0,0,3,640,680,96);return ux_u32(a+GltfSkin.jointCount);",
        "let a=GltfLoader_skin(0,0,3,640,680,96);return ux_u32(ux_u32(a+GltfSkin.joints)+4);",
        "let a=GltfLoader_skin(0,0,3,640,680,96);return ux_u32(a+GltfSkin.skeleton);",
        "let a=GltfLoader_skin(0,0,3,640,680,96);let inv=ux_u32(a+GltfSkin.inverseBind);"
        "return ux_f32(ux_u32(inv+GltfAccessor.bytes)+112);",
        "let bad=ux_u8_put(jointAt,51);return GltfLoader_skin(0,0,3,640,680,96);",
        "let bad=ux_u8_put(jointAt,48);return GltfLoader_skin(0,0,3,640,680,96);",
        "return GltfLoader_skin(0,0,3,640,680,56);",
        "let bad=ux_u32_put(GlbResource.binBytes,64);return GltfLoader_skin(0,0,3,640,680,96);"
    };
    const double gold[]={2,2,0,-2,-3,-3,-4,-5};
    return g_math_run("G_IO GltfSkin","gltf-skin",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        "let a=GltfLoader_skin(0,0,3,640,680,96);return ux_u32(ux_u32(a+GltfSkin.joints));");
}
