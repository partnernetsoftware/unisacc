#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","animation-view","propertymixer","propertymixer-discrete",0};
    const char *setup="let a=ux_f64_put(64,0.0);let b=ux_f64_put(72,1.0);let c=ux_f64_put(80,2.0);"
        "let mixer=PropertyMixer_init(0,128,64,1);";
    const char *cases[]={
        "let s=PropertyMixer_select(mixer,72,0.5,2500);return ux_f64(PropertyMixer_applySelection(mixer));",
        "let s=PropertyMixer_select(mixer,72,0.51,2500);return ux_f64(PropertyMixer_applySelection(mixer));",
        "let s=PropertyMixer_select(mixer,72,0.5,2500);let later=PropertyMixer_select(mixer,80,0.5,2500);"
        "return ux_f64(PropertyMixer_applySelection(mixer));",
        "let s=PropertyMixer_select(mixer,72,1.0,2500);let add=PropertyMixer_select(mixer,80,0.49,2501);"
        "return ux_f64(PropertyMixer_applySelection(mixer));",
        "let s=PropertyMixer_select(mixer,80,0.5,2501);return ux_f64(PropertyMixer_applySelection(mixer));",
        "let s=PropertyMixer_select(mixer,72,1.0,2500);let prior=PropertyMixer_applySelection(mixer);"
        "return ux_f64(PropertyMixer_applySelection(mixer));",
        "let wrong=ux_f64_put(72,1.25);return PropertyMixer_select(mixer,72,1.0,2500);"
    };
    const double gold[]={0,1,2,0,2,0,-2};
    return g_math_run("G_ANIM PropertyMixer discrete","propertymixer-discrete",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?0:-1,
        "let s=PropertyMixer_select(mixer,72,0.51,2500);return ux_f64(PropertyMixer_applySelection(mixer));");
}
