#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","object-json-tokens","json-read","geometry-json-load",
        "json-bytes","geometry-json",0};
    const char json[]="{ \"data\": { \"groups\":[{\"materialIndex\":2,\"count\":8,\"start\":4}],"
        "\"boundingSphere\":{\"radius\":4,\"center\":[1,2,3]},"
        "\"index\":{\"array\":[0],\"type\":\"Uint16Array\"},"
        "\"attributes\":{\"position\":{\"usage\":35048,\"normalized\":false,\"array\":[1.25,-2,0],"
        "\"type\":\"Float32Array\",\"itemSize\":3}}},\"type\":\"BufferGeometry\",\"uuid\":\"geometry-1\"}";
    char setup[12000];
    int size=(int)sizeof json-1;
    int used=tx_snprintf(setup,sizeof setup,
        "let geo=0;let options=64;let table=128;let groups=192;let names=256;"
        "let gt=ux_u32_put(geo+BufferGeometry.attributes,table);"
        "let gg=ux_u32_put(geo+BufferGeometry.groups,groups);"
        "let tc=ux_u32_put(table+4,1);let gc=ux_u32_put(groups+4,1);"
        "let wa=ux_u32_put(options+GeometryJsonLoad.arena,1024);"
        "let we=ux_u32_put(options+GeometryJsonLoad.arenaEnd,2048);"
        "let wn=ux_u32_put(options+GeometryJsonLoad.names,names);"
        "let wc=ux_u32_put(options+GeometryJsonLoad.nameCount,1);"
        "let ws=ux_u32_put(options+GeometryJsonLoad.scratch,4096);"
        "let id=ux_u32_put(names,8);let address=ux_u32_put(names+4,320);"
        "let name_size=ux_u32_put(names+8,8);let key=[112,111,115,105,116,105,111,110];"
        "let k=0;while(k<8){let b=ux_u8_put(320+k,key[k]);k=k+1;}"
        "let input=6000;let end=input+%d;",size);
    for(int at=0;at<size;at+=60) {
        int chunk=size-at<60?size-at:60;
        if(used<0 || used+512>=(int)sizeof setup) {
            printf("GEOMETRY_JSON_FIXTURE_SIZE bytes=%d input=%d at=%d\n",used,size,at);
            return 2;
        }
        used+=tx_snprintf(setup+used,sizeof setup-used,"if(1){let bytes=[");
        for(int i=0;i<chunk;i++) used+=tx_snprintf(setup+used,sizeof setup-used,
            "%s%d",i?",":"",(unsigned char)json[at+i]);
        used+=tx_snprintf(setup+used,sizeof setup-used,"];let i=0;"
            "while(i<%d){let byte=ux_u8_put(input+%d+i,bytes[i]);i=i+1;}}",chunk,at);
    }
    const char *cases[]={
        "let loaded=BufferGeometry_fromJSON(geo,input,end,options);return ux_u32(table);",
        "let loaded=BufferGeometry_fromJSON(geo,input,end,options);let view=ux_u32(table+12);"
        "return ux_f32(ux_u32(view+BufferAttribute.data));",
        "let loaded=BufferGeometry_fromJSON(geo,input,end,options);let view=ux_u32(table+12);"
        "return ux_f32(ux_u32(view+BufferAttribute.data)+4);",
        "let loaded=BufferGeometry_fromJSON(geo,input,end,options);let view=ux_u32(table+12);"
        "return ux_u32(view+BufferAttribute.usage);",
        "let loaded=BufferGeometry_fromJSON(geo,input,end,options);"
        "let index=ux_u32(geo+BufferGeometry.index)-1;return ux_u32(index+BufferAttribute.componentType);",
        "let loaded=BufferGeometry_fromJSON(geo,input,end,options);return ux_u32(groups+16);",
        "let loaded=BufferGeometry_fromJSON(geo,input,end,options);"
        "let sphere=ux_u32(geo+BufferGeometry.boundingSphere)-1;return ux_f64(sphere+16)+ux_f64(sphere+24);",
        "let cap=ux_u32_put(options+GeometryJsonLoad.arenaEnd,1064);"
        "let loaded=BufferGeometry_fromJSON(geo,input,end,options);return (loaded<0)*2+ux_u32(table);",
        "let broken=ux_u8_put(end-1,93);return BufferGeometry_fromJSON(geo,input,end,options);",
        "let loaded=BufferGeometry_fromJSON(geo,input,end,options);"
        "let identity=448;let source=ux_u32_put(identity+GeometryJsonIdentity.uuid,320);"
        "let count=ux_u32_put(identity+GeometryJsonIdentity.uuidBytes,8);"
        "let context=ux_u32_put(identity+GeometryJsonIdentity.names,names);"
        "let names_count=ux_u32_put(identity+GeometryJsonIdentity.nameCount,1);"
        "let finish=BufferGeometry_toJSON(geo,7000,8000,identity,4096);"
        "if(loaded<0 || finish<0){return 0-1;}"
        "let h=0;let p=7000;while(p<finish){h=(h*131+ux_u8(p))%16777213;p=p+1;}return h;"
    };
    const char expected[]="{\"metadata\":{\"version\":4.6,\"type\":\"BufferGeometry\","
        "\"generator\":\"BufferGeometry.toJSON\"},\"uuid\":\"position\",\"type\":\"BufferGeometry\","
        "\"data\":{\"attributes\":{\"position\":{\"itemSize\":3,\"type\":\"Float32Array\","
        "\"array\":[1.25,-2,0],\"normalized\":false,\"usage\":35048}},\"index\":{\"type\":\"Uint16Array\","
        "\"array\":[0]},\"groups\":[{\"start\":4,\"count\":8,\"materialIndex\":2}],"
        "\"boundingSphere\":{\"center\":[1,2,3],\"radius\":4}}}";
    uint64_t hash=0;
    for(int i=0;i<(int)sizeof expected-1;i++) hash=(hash*131+(unsigned char)expected[i])%16777213;
    const double gold[]={1,1.25,-2,35048,4,2,7,2,-1,(double)hash};
    const char mutation[]="let loaded=BufferGeometry_fromJSON(geo,input,end,options);let view=ux_u32(table+12);"
        "return ux_f32(ux_u32(view+BufferAttribute.data)+4);";
    return g_math_run("G_STRUCT BufferGeometry fromJSON","geometry-json-load",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,mutation);
}
