#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","eventdispatcher","arrowhelper","arrowhelper-lifecycle",0};
    const char *setup=
        "let i=0;"
        "while(i<4) {"
        "let dispatcher=1024+i*32;"
        "let ready=EventDispatcher_init(dispatcher,2048+i*32,3);"
        "let wrong=EventDispatcher_addListener(dispatcher,8,200+i);"
        "let matched=EventDispatcher_addListener(dispatcher,9,100+i);"
        "let link=ux_u32_put(512+i*8,dispatcher);"
        "let id=ux_u32_put(516+i*8,10+i);"
        "i=i+1;}"
        "let pose=ArrowHelper_setDirection(256,1.0,0.0,0.0);"
        "let length=ArrowHelper_setDefaultLength(pose,5.0);"
        "let source=ArrowHelper_init(0,pose,512);"
        "let clone=ArrowHelper_clone(128,source);"
        "let copied=ArrowHelper_copy(384,source);"
        "if(source!=0 || clone!=128 || copied!=384) { return 0.0-123.0; }";
    const char *cases[]={
        "return ux_f64(clone+ArrowHelper.qz);",
        "let changed=ArrowHelper_setDefaultLength(source,8.0);"
        "return ux_f64(clone+ArrowHelper.shaftScaleY);",
        "let changed=ArrowHelper_setDefaultLength(source,8.0);"
        "return ux_f64(copied+ArrowHelper.headPositionY);",
        "let i=0;while(i<32){"
        "let link=ArrowHelper.shaftGeometryDispatcher+i;"
        "if(ux_u32(source+link)!=ux_u32(clone+link) || ux_u32(source+link)!=ux_u32(copied+link)){return 0.0;}"
        "i=i+4;}return 1.0;",
        "let n=ArrowHelper_dispose(clone,9,3000,48);"
        "if(n!=48){return 0.0;}"
        "let i=0;while(i<4){"
        "let row=3000+i*12;"
        "if(ux_u32(row)!=10+i || ux_u32(row+4)!=1 || ux_u32(row+8)!=100+i){return 0.0;}"
        "i=i+1;}return 1.0;",
        "let gone=ArrowHelper_dispose(clone,9,3000,48);"
        "let again=ArrowHelper_dispose(clone,9,3000,48);"
        "if(gone!=48 || again!=0-1 || ux_u32(clone+ArrowHelper.active)!=0){return 0.0;}"
        "return 0.0+ux_u32(source+ArrowHelper.active);",
        "let sentinel=ux_u32_put(3000,999);"
        "let short=ArrowHelper_dispose(clone,9,3000,47);"
        "let overlap=ArrowHelper_dispose(clone,9,2048,48);"
        "let same=ArrowHelper_clone(source,source);"
        "let partial=ArrowHelper_copy(16,source);"
        "if(short!=0-2 || overlap!=0-1 || same!=0-1 || partial!=0-1 || ux_u32(3000)!=999){return 0.0;}"
        "return 0.0+ux_u32(clone+ArrowHelper.active);",
    };
    const double gold[]={-0.7071067811865476,4,5,1,1,1,1};
    return g_wasm_batch_page("G_STRUCT ArrowHelper lifecycle","arrowhelper-lifecycle",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?4:-1,
        "let n=ArrowHelper_dispose(clone,8,3000,48);return 0.0+(ux_u32(3008)==100);");
}
