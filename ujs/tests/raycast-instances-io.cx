#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","vector-scalar","vector3","ray","raycast-memory","raycaster-state",
        "raycast-mesh","raycast-hit-sort","raycast-buffer","raycast-instances",0};
    const char *setup=
        "let state=0;let mesh=128;let world=256;let pos=512;let instances=576;let out=896;let work=1024;"
        "let ray=Raycaster_default(state);let a0=ux_f64_put(world,1.0);let a1=ux_f64_put(world+40,1.0);"
        "let a2=ux_f64_put(world+80,1.0);let a3=ux_f64_put(world+120,1.0);let near=ux_f64_put(world+112,0.0-1.0);"
        "let b=ux_u32_put(mesh+RayMeshBuffer.positions,pos);let c=ux_u32_put(mesh+RayMeshBuffer.vertexCount,3);"
        "let d=ux_u32_put(mesh+RayMeshBuffer.positionStride,12);let e=ux_u32_put(mesh+RayMeshBuffer.faceCount,1);"
        "let f=ux_u32_put(mesh+RayMeshBuffer.matrixWorld,world);let g=ux_u32_put(mesh+RayMeshBuffer.layerMask,1);"
        "let x0=ux_f32_put(pos,0.0-1.0);let y0=ux_f32_put(pos+4,0.0-1.0);"
        "let x1=ux_f32_put(pos+12,1.0);let y1=ux_f32_put(pos+16,0.0-1.0);let y2=ux_f32_put(pos+28,1.0);"
        "let i=0;while(i<48){let cell=ux_f32_put(instances+i*4,(i%16%5==0)*1.0);i=i+1;}"
        "let z0=ux_f32_put(instances+56,0.0-4.0);let z1=ux_f32_put(instances+120,0.0-2.0);"
        "let x2=ux_f32_put(instances+176,3.0);let z2=ux_f32_put(instances+184,0.0-1.0);";
    #define READ "let count=Raycaster_intersectInstances(state,mesh,instances,3,out,3,work,1024);"
    const char *cases[]={
        READ "return 0.0+count;",
        READ "return 0.0+ux_u32(out+RayInstanceHit.instanceId);",
        READ "return ux_f64(out+RayInstanceHit.distance);",
        READ "return ux_f64(out+RayInstanceHit.size+RayInstanceHit.distance);",
        "let equal=ux_f32_put(instances+56,0.0-2.0);" READ "return 0.0+ux_u32(out+RayInstanceHit.instanceId);",
        "let far=ux_f64_put(state+RaycasterState.far,4.0);" READ "return 0.0+count;",
        "let mask=ux_u32_put(mesh+RayMeshBuffer.layerMask,2);" READ "return 0.0+count;",
        "let bad=ux_f32_put(instances+64,0.0);" READ "return 0.0+count;",
        "let keep=ux_f64_put(out,77.0);let bad=ux_f32_put(instances+64,0.0);" READ "return ux_f64(out);",
        "return 0.0+Raycaster_intersectInstances(state,mesh,instances,3,out,2,work,1024);",
    };
    const double gold[]={2,1,3,5,0,1,0,-1,77,-1};
    return g_wasm_batch("G_RAY InstancedMesh raycast","raycast-instances",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,READ "return 0.0+ux_u32(out+RayInstanceHit.size+RayInstanceHit.instanceId);");
}
