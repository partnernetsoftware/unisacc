#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    int forward_mutate=argc==2 && tx_eqz(argv[1],"--forward-mutate");
    if(argc!=1 && !mutate && !forward_mutate) return 2;
    const char *modules[]={"curve-line","curve-bezier","path","shape","shapepath",0};
    const char *setup="let one=Path_init(0,1024,3);let o1=Path_lineTo(one,0.0,6.0);"
        "let o2=Path_lineTo(one,6.0,0.0);let o3=Path_closePath(one);"
        "let hole=Path_init(64,1536,3);let h0=Path_moveTo(hole,1.0,1.0);"
        "let h1=Path_lineTo(hole,2.0,1.0);let h2=Path_lineTo(hole,1.0,2.0);let h3=Path_closePath(hole);"
        "let two=Path_init(128,2048,3);let t0=Path_moveTo(two,10.0,0.0);"
        "let t1=Path_lineTo(two,10.0,6.0);let t2=Path_lineTo(two,16.0,0.0);let t3=Path_closePath(two);"
        "let sp=ShapePath_init(256,320,3);let a=ShapePath_add(sp,one);let b=ShapePath_add(sp,hole);"
        "let c=ShapePath_add(sp,two);let count=ShapePath_toShapes(sp,512,2,640,2,3072,8,4096,2,0);"
        "let draw=ShapePath_init(4224,4288,2);"
        "let noPath=ShapePath_lineTo(draw,1.0,1.0);"
        "let start=ShapePath_moveTo(draw,4352,4608,3,4.0,5.0);"
        "let edge=ShapePath_lineTo(draw,6.0,7.0);"
        "let quad=ShapePath_quadraticCurveTo(draw,7.0,6.0,8.0,9.0);"
        "let cubic=ShapePath_bezierCurveTo(draw,9.0,10.0,10.0,11.0,11.0,12.0);"
        "let other=ShapePath_moveTo(draw,4416,4864,1,13.0,14.0);";
    const char *cases[]={"return count;","return ux_u32(512+Shape.contour)/64+1;",
        "return ux_u32(512+Shape.count);","return ux_u32(640)/64+1;",
        "return ux_u32(512+Shape.size+Shape.contour)/64+1;","return ux_u32(512+Shape.size+Shape.count);",
        "return ux_u32(draw+ShapePath.count);","return ux_u32(4352+Path.count);",
        "return ux_f64(4608+16);","return ux_f64(4680+40);","return ux_f64(4752+64);",
        "return ux_f64(4416+Path.x);","return noPath;",
        "return ShapePath_moveTo(draw,4480,5120,1,0.0,0.0);"};
    const double gold[]={2,1,1,2,3,0,2,3,5,8,12,13,-1,-1};
    return g_math_run("G_STRUCT ShapePath","shapepath",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],forward_mutate?9:mutate?2:-1,
        forward_mutate?"return ux_f64(4680+24);":"return ux_u32(512+Shape.size+Shape.count);");
}
