#pragma unisa use g_math
#pragma unisa use text.text
int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"curve-line","curve-bezier","path","shape","shapepath",0};
    const char *setup="let one=Path_init(0,1024,3);let o1=Path_lineTo(one,0.0,6.0);"
        "let o2=Path_lineTo(one,6.0,0.0);let o3=Path_closePath(one);"
        "let hole=Path_init(64,1536,3);let h0=Path_moveTo(hole,1.0,1.0);"
        "let h1=Path_lineTo(hole,2.0,1.0);let h2=Path_lineTo(hole,1.0,2.0);let h3=Path_closePath(hole);"
        "let two=Path_init(128,2048,3);let t0=Path_moveTo(two,10.0,0.0);"
        "let t1=Path_lineTo(two,10.0,6.0);let t2=Path_lineTo(two,16.0,0.0);let t3=Path_closePath(two);"
        "let sp=ShapePath_init(256,320,3);let a=ShapePath_add(sp,one);let b=ShapePath_add(sp,hole);"
        "let c=ShapePath_add(sp,two);let count=ShapePath_toShapes(sp,512,2,640,2,3072,8,4096,2,0);";
    const char *cases[]={"return count;","return ux_u32(512+Shape.contour)/64+1;",
        "return ux_u32(512+Shape.count);","return ux_u32(640)/64+1;",
        "return ux_u32(512+Shape.size+Shape.contour)/64+1;","return ux_u32(512+Shape.size+Shape.count);"};
    const double gold[]={2,1,1,2,3,0};
    return g_math_run("G_STRUCT ShapePath","shapepath",modules,setup,cases,gold,6,mutate?2:-1,
        "return ux_u32(512+Shape.size+Shape.count);");
}
