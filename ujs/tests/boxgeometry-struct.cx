#pragma unisa use g_geometry
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"geometry-buffers","boxgeometry",0};
    char source[512];
    tx_snprintf(source,sizeof source,"let mesh=GeometryBuffers_init(0,256,24,2048,36);"
        "return BoxGeometry_generate(mesh,%d.0,4.0,6.0,1,1,1);",mutate?3:2);
    const int corners[6][4][3]={
        {{1,2,3},{1,2,-3},{1,-2,3},{1,-2,-3}},
        {{-1,2,-3},{-1,2,3},{-1,-2,-3},{-1,-2,3}},
        {{-1,2,-3},{1,2,-3},{-1,2,3},{1,2,3}},
        {{-1,-2,3},{1,-2,3},{-1,-2,-3},{1,-2,-3}},
        {{-1,2,3},{1,2,3},{-1,-2,3},{1,-2,3}},
        {{1,2,-3},{-1,2,-3},{1,-2,-3},{-1,-2,-3}}
    };
    const int triangles[]={0,2,1,2,3,1};
    double gold[230]={24,36};
    int at=2;
    for(int face=0;face<6;face++) for(int vertex=0;vertex<4;vertex++) {
        for(int axis=0;axis<3;axis++) gold[at++]=corners[face][vertex][axis];
        for(int axis=0;axis<3;axis++) gold[at++]=axis==face/2?1-2*(face%2):0;
        gold[at++]=vertex%2;
        gold[at++]=1-vertex/2;
    }
    for(int face=0;face<6;face++) for(int i=0;i<6;i++) gold[at++]=4*face+triangles[i];
    return g_geometry_check("BoxGeometry","boxgeometry",modules,source,gold,at,194);
}
