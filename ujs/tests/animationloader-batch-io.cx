#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","json-read","loader-json","loadingmanager","fileloader","animation-view",
        "keyframe-track","animationclip","animationloader","animationloader-batch",0};
    const char json[]="[{\"name\":\"walk\",\"fps\":2,\"tracks\":["
        "{\"name\":\".position[x]\",\"type\":\"number\",\"times\":[0,4],\"values\":[2,10],\"interpolation\":2300},"
        "{\"name\":\".scale\",\"type\":\"vector\",\"times\":[0,8],\"values\":[1,2,3,2,3,4]},"
        "{\"name\":\".quaternion\",\"type\":\"quaternion\",\"times\":[0,6],\"values\":[0,0,0,1,0,1,0,0]}]},"
        "{\"name\":\"glow\",\"duration\":9,\"blendMode\":2501,\"tracks\":["
        "{\"name\":\".material.color\",\"type\":\"color\",\"times\":[0,5],\"values\":[1,0,0,0,1,0]}]},"
        "{\"name\":\"empty\",\"tracks\":[]}]";
    const char key[]="\"type\":\"color\"";
    const long marker=tx_find(json,sizeof json-1,key,sizeof key-1);
    if(marker<0) return 2;
    char setup[4500];
    const int size=sizeof json-1;
    int used=tx_snprintf(setup,sizeof setup,"let size=%d;let bad=%ld;",size,256+marker+8);
    for(int at=0;at<size;at+=60) {
        const int span=size-at<60?size-at:60;
        used+=tx_snprintf(setup+used,sizeof setup-used,"if(1){let bytes=[");
        for(int j=0;j<span;j++) used+=tx_snprintf(setup+used,sizeof setup-used,"%s%d",j?",":"",json[at+j]);
        used+=tx_snprintf(setup+used,sizeof setup-used,"];let i=0;while(i<%d){let a=ux_u8_put(%d+i,bytes[i]);i=i+1;}}",span,256+at);
    }
    tx_snprintf(setup+used,sizeof setup-used,
        "let manager=LoadingManager_init(0);let file=FileLoader_init(32,manager);let id=FileLoader_begin(file,64);"
        "let ready=FileLoader_receive(file,id,200,256,size,64);");
    #define LOAD "let n=AnimationLoader_parseNumeric(file,2048,3,4096,8192);"
    #define C0 "let clip=ux_u32(2048);let tracks=ux_u32(clip+AnimationClip.tracks);"
    #define VEC "let track=ux_u32(tracks+4);let view=ux_u32(track+KeyframeTrack.samples);"
    const char *cases[]={
        LOAD "return 0.0+n;",
        LOAD C0 "return ux_f64(clip+AnimationClip.duration);",
        LOAD C0 "return 0.0+ux_u32(clip+AnimationClip.trackCount);",
        LOAD C0 "return 0.0+ux_u32(ux_u32(tracks)+KeyframeTrack.interpolation);",
        LOAD C0 VEC "return ux_f32(ux_u32(view+AnimationSamples.times)+4);",
        LOAD C0 VEC "return ux_f32(ux_u32(view+AnimationSamples.values)+20);",
        LOAD C0 "return 0.0+ux_u32(ux_u32(tracks+8)+AnimationLoadedTrack.kind);",
        LOAD "let clip=ux_u32(2052);return 0.0+ux_u32(clip+AnimationClip.blendMode);",
        LOAD "let clip=ux_u32(2052);return ux_f64(clip+AnimationClip.duration);",
        LOAD "let clip=ux_u32(2056);return ux_f64(clip+AnimationClip.duration);",
        "return 0.0+AnimationLoader_parseNumeric(file,2048,2,4096,8192);",
        "let broken=ux_u8_put(bad,120);" LOAD "return 0.0+n;",
        "let keep=ux_u32_put(2048,99);let broken=ux_u8_put(bad,120);" LOAD "return 0.0+ux_u32(2048);",
        "return 0.0+AnimationLoader_parseNumeric(file,2048,3,4096,128);"
    };
    const double gold[]={3,4,3,2300,4,4,4,2501,9,0,-1,-3,99,-1};
    return g_wasm_batch("G_IO AnimationLoader numeric clips","animationloader-batch",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?4:-1,LOAD C0 VEC "return ux_f32(ux_u32(view+AnimationSamples.times));");
}
