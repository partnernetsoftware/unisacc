#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[390],wasm[300],url[690];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-d4-smoke-",dir,sizeof dir)) return 2;
    tx_snprintf(wasm,sizeof wasm,"%s/d4-smoke.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/ujs/practice/uxe/test/d4-smoke-r160.html?wasm=file://%s&mutate=%d",cwd,wasm,mutate);
    char *compile[]={"./ujs/ujs2wasm.com","ujs/practice/uxe/products/d4/d4-smoke-api.ujs",
        "ujs/practice/uxe/base/f64-math.ujs","ujs/practice/uxe/products/d4/d4-smoke.ujs","-o",wasm,0};
    const double gold[]={27,15,347,0,0,0,0,0,9,
        (double)(float)-4.45,(double)(float)10.8,-3.5,(double)(float)0.67,(double)(float)(202.0/255.0),
        (double)(float)-4.9,(double)(float)0.24,26,1,
        (double)(float)(0.67*(0.64+0.4/120.0)*0.1),
        (double)(float)-2.05,(double)(float)11.175,(double)(float)-2.57,(double)(float)0.5628,
        (double)(float)(0.67*(0.64+119.0/120.0*0.4)*(8.0/120.0)),1,2,26};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    char *out=0;
    size_t bytes=0;
    int failed=length<0 || length>=(int)sizeof url;
    if(!failed) {
        const int rc=cx_runv_timeout(compile,12,&out,&bytes);
        if(rc) { printf("D4_SMOKE compile_rc=%d %s\n",rc,out?out:""); failed=1; }
        mm_free(out); out=0;
    }
    if(!failed) {
        failed=r160_wait_read(url,"#result",actual,count,dir);
        if(!failed) {
            printf("D4_SMOKE frames=%.0f records=%.0f count_diff=%.0f matrix_diff=%.0f color_diff=%.0f slot_diff=%.0f tail_diff=%.0f refusals=%.0f\n",
                actual[1],actual[2],actual[3],actual[4],actual[5],actual[6],actual[7],actual[8]);
            for(int i=0;i<count;i++) {
                const double delta=actual[i]-gold[i];
                if(!(delta>=-1e-8 && delta<=1e-8)) {
                    printf("D4_SMOKE field=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
                    failed=1;
                }
            }
        }
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&out,&bytes)) failed=1;
    mm_free(out);
    printf("D4_SMOKE failed=%d\n",failed);
    return failed;
}
