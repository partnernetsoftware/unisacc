#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int linear=argc==2 && tx_eqz(argv[1],"--mutate-linear");
    const int srgb=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !linear && !srgb) return 2;
    const char *modules[]={"f64-math","vector-scalar","color","colormanagement","gpu-color-encoding-generated",0};
    const char *setup="let color=Color_setRGB(0,0.02,0.03,0.04);";
    const char *cases[]={
        "let read=GpuColor_fromLegacyEncoding(color,3000,1);return ux_f64(read);",
        "let read=GpuColor_fromLegacyEncoding(color,3001,1);return ux_f64(read);",
        "let read=GpuColor_fromLegacyEncoding(color,3001,1);return ux_f64(read+16);",
        "let read=GpuColor_fromLegacyEncoding(color,3001,2);return ux_f64(read+8);",
        "let read=GpuColor_fromLegacyEncoding(color,3002,1);return read;"
    };
    const double gold[]={0.02,0.02/12.92,0.04/12.92,0.03,-2};
    return g_math_run("G_STRUCT GPU color encoding","gpu-color-encoding",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],linear?0:srgb?1:-1,linear?cases[1]:cases[0]);
}
