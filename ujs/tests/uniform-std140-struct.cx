#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","uniform-std140",0};
    const char *setup="let values=[3,5,7,11,1,2,3,4,5,6,7,8,9,13,17];"
        "let i=0;while(i<15){let f=ux_f32_put(128+i*4,0.0+values[i]);i=i+1;}"
        "let a=ux_u32_put(256,3);let b=ux_u32_put(260,128);"
        "let c=ux_u32_put(264,1);let d=ux_u32_put(268,140);"
        "let e=ux_u32_put(272,5);let f=ux_u32_put(276,144);"
        "let h=ux_u32_put(280,2);let j=ux_u32_put(284,180);"
        "let size=UniformsGroup_packStd140(256,4,512,128);";
    const char *cases[]={
        "return size;","return ux_f32(512);","return ux_f32(524);","return ux_f32(544);",
        "return ux_f32(540);","return ux_f32(576);",
        "let keep=ux_u32_put(512,777);let tooShort=UniformsGroup_packStd140(256,4,512,79);return ux_u32(512);",
        "let invalid=ux_u32_put(276,512);return UniformsGroup_packStd140(256,4,512,128);",
        "let invalid=ux_u32_put(272,7);return UniformsGroup_packStd140(256,4,512,128);"
    };
    const double gold[]={80,3,11,4,0,13,777,-1,-1};
    return g_math_run("G_STRUCT UniformGroup std140","uniform-std140",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,"return ux_f32(540);");
}
