#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","glb-container","json-read","loader-json","gltf-sampler",
        "image-layout","record-copy","gpu-packet","gltf-gpu-texture",0};
    const char *setup="let image=0;let sampler=64;let out=128;let src=256;let dst=512;"
        "let p=ux_u32_put(image+ImageResource.rgba,src);let w=ux_u32_put(image+ImageResource.width,1);"
        "let h=ux_u32_put(image+ImageResource.height,2);let pitch=ux_u32_put(image+ImageResource.rowBytes,8);"
        "let a=ux_u32_put(src,4278190335);let pad=ux_u32_put(src+4,99);let b=ux_u32_put(src+8,4294901760);"
        "let mag=ux_u32_put(sampler+GltfSampler.magFilter,9729);let min=ux_u32_put(sampler+GltfSampler.minFilter,9987);"
        "let s=ux_u32_put(sampler+GltfSampler.wrapS,33648);let t=ux_u32_put(sampler+GltfSampler.wrapT,33071);";
    #define READ "let done=GltfLoader_gpuTexture(image,sampler,out,dst,8);"
    const char *cases[]={
        READ "return 0.0+ux_u32(out+GpuTextureSource.width);",
        READ "return 0.0+ux_u32(out+GpuTextureSource.height);",
        READ "return 0.0+ux_u32(out+GpuTextureSource.filter);",
        READ "return 0.0+ux_u32(out+GpuTextureSource.wrapS);",
        READ "return 0.0+ux_u32(out+GpuTextureSource.wrapT);",
        READ "return 0.0+ux_u32(dst);",
        READ "return 0.0+ux_u32(dst+4);",
        "let cap=ux_u32_put(dst,77);let unsupported=ux_u32_put(sampler+GltfSampler.minFilter,9984);"
        READ "return 0.0+(done==0-2 && ux_u32(dst)==77);",
        "return 0.0+GltfLoader_gpuTexture(image,sampler,out,src+4,8);",
    };
    const double gold[]={1,2,2,2,0,4278190335.0,4294901760.0,1,-1};
    return g_wasm_batch_addon_page("G_IO GLTF GPU texture source","gltf-gpu-texture",
        "ujs/practice/uxe/test/wasm-batch-gpu-layout.html",argv[1],modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?6:-1,READ "return 0.0+ux_u32(dst);");
}
