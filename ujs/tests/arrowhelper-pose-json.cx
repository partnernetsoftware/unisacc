#pragma unisa use g_wasm_batch
#pragma unisa use text.text

static double bytes_hash(const char *text) {
    uint64_t hash=0;
    for(int i=0;text[i];i++) hash=(hash*131+(unsigned char)text[i])%16777213;
    return 0.0+hash;
}

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"object-layouts","eventdispatcher","arrowhelper","arrowhelper-lifecycle",
        "json-bytes","json-read","arrowhelper-pose-json",0};
    const char *setup=
        "let dispatcher=EventDispatcher_init(1024,1200,1);"
        "let i=0;while(i<4){"
        "let pointer=ux_u32_put(512+i*8,dispatcher);let item=ux_u32_put(516+i*8,101+i);i=i+1;}"
        "let pose=ArrowHelper_setDirection(256,0.0,0.0-1.0,0.0);"
        "let length=ArrowHelper_setLength(pose,5.5,1.5,0.25);"
        "let source=ArrowHelper_init(0,pose,512);let target=ArrowHelper_clone(128,source);"
        "let finish=ArrowHelper_poseToJSON(source,3000,3500,4000);"
        "let changed=ArrowHelper_setDirection(target,0.0,1.0,0.0);"
        "let shortened=ArrowHelper_setLength(target,2.0,1.0,0.125);"
        "let restored=ArrowHelper_poseFromJSON(target,3000,finish);"
        "if(source!=0 || target!=128 || finish<3000 || restored!=128){return 0.0-123.0;}";
    const char *cases[]={
        "let hash=0;let i=3000;while(i<finish){hash=(hash*131+ux_u8(i))%16777213;i=i+1;}return 0.0+hash;",
        "return ux_f64(target+ArrowHelper.qx);",
        "return ux_f64(target+ArrowHelper.shaftScaleY);",
        "return ux_f64(target+ArrowHelper.headPositionY);",
        "return ux_f64(target+ArrowHelper.headScaleY);",
        "return ux_f64(target+ArrowHelper.headScaleXZ);",
        "let i=0;while(i<32){let link=ArrowHelper.shaftGeometryDispatcher+i;"
        "if(ux_u32(target+link)!=ux_u32(source+link)){return 0.0;}i=i+4;}return 1.0;",
        "let first=ArrowHelper_poseFromJSON(target,3000,finish-1);"
        "let damaged=ux_u8_put(finish,48);let trailing=ArrowHelper_poseFromJSON(target,3000,finish+1);"
        "let overlap=ArrowHelper_poseToJSON(source,1200,1230,4000);"
        "if(first!=0-1 || trailing!=0-1 || overlap!=0-1){return 0.0;}return ux_f64(target+ArrowHelper.headPositionY);",
    };
    const double gold[]={bytes_hash("[[1,0,0,0],[4,5.5,1.5,0.25]]"),1,4,5.5,1.5,0.25,1,5.5};
    return g_wasm_batch_page("G_STRUCT ArrowHelper public pose JSON","arrowhelper-pose-json",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?5:-1,
        "return ux_f64(target+ArrowHelper.headScaleY);");
}
