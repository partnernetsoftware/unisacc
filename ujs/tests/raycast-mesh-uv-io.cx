#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","vector-scalar","vector3","ray","triangle","raycast-memory",
        "raycaster-state","raycast-mesh","raycast-hit-sort","raycast-buffer","raycast-mesh-uv",0};
    const char *setup=
        "let state=0;let mesh=128;let world=256;let points=512;let indices=576;let tex=640;let hits=768;"
        "let work=1024;let out=1600;let uv_work=1664;"
        "let s=Raycaster_default(state);let x=ux_f64_put(state+RaycasterState.ox,2.5);let y=ux_f64_put(state+RaycasterState.oy,1.0);"
        "let m0=ux_f64_put(world,2.0);let m5=ux_f64_put(world+40,1.0);let m10=ux_f64_put(world+80,1.0);"
        "let m15=ux_f64_put(world+120,1.0);let tx=ux_f64_put(world+96,1.0);let ty=ux_f64_put(world+104,0.5);"
        "let a=ux_u32_put(mesh+RayMeshBuffer.positions,points);let b=ux_u32_put(mesh+RayMeshBuffer.vertexCount,3);"
        "let c=ux_u32_put(mesh+RayMeshBuffer.positionStride,12);let d=ux_u32_put(mesh+RayMeshBuffer.indices,indices);"
        "let e=ux_u32_put(mesh+RayMeshBuffer.faceCount,1);let f=ux_u32_put(mesh+RayMeshBuffer.matrixWorld,world);"
        "let g=ux_u32_put(mesh+RayMeshBuffer.layerMask,1);let h=ux_u32_put(mesh+RayMeshBuffer.side,2);"
        "let z0=ux_f32_put(points+8,0.0-4.0);let x1=ux_f32_put(points+12,2.0);let z1=ux_f32_put(points+20,0.0-4.0);"
        "let y2=ux_f32_put(points+28,2.0);let z2=ux_f32_put(points+32,0.0-4.0);"
        "let u1=ux_f32_put(tex+8,1.0);let v2=ux_f32_put(tex+20,1.0);"
        "let i1=ux_u16_put(indices+2,2);let i2=ux_u16_put(indices+4,1);"
        "if(selected_case==4){let mode=ux_u32_put(mesh+RayMeshBuffer.indexBytes,2);}"
        "let count=Raycaster_intersectMeshBuffer(state,mesh,hits,2,work,512);";
    #define CALL "let uv=Raycaster_meshHitUV(mesh,hits,tex,8,out,uv_work);"
    const char *cases[]={
        "return 0.0+count;",
        CALL "return ux_f64(out);",
        CALL "return ux_f64(out+8);",
        "return 0.0+ux_u32(hits+RayMeshHit.face);",
        CALL "return ux_f64(out);",
        "let invalid=ux_u32_put(hits+RayMeshHit.face,1);" CALL "return 0.0+uv;",
        "let mode=ux_u32_put(mesh+RayMeshBuffer.indexBytes,2);let invalid=ux_u16_put(indices+4,5);"
        CALL "return 0.0+uv;",
        "return 0.0+Raycaster_meshHitUV(mesh,hits,tex,8,tex,uv_work);",
        "let keep=ux_f64_put(out,77.0);let zero=ux_f32_put(points+12,0.0);"
        CALL "return ux_f64(out);",
    };
    const double gold[]={1,0.375,0.25,0,0.375,-1,-2,-1,77};
    return g_wasm_batch("G_RAY Raycaster mesh UV","raycast-mesh-uv",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,CALL "return ux_f64(out+8);");
}
