#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"vector-scalar","vector3","ray",0};
    const char *setup="let o=Vector3_set(0,0.0,0.0,0.0);let x=Vector3_set(24,1.0,0.0,0.0);"
        "let a=Ray_set(48,o,x);let p=Vector3_set(96,3.0,4.0,0.0);"
        "let q=Vector3_set(120,0.0-1.0,2.0,0.0);";
    const char *sphere="let s=Vector3_set(144,4.0,0.0,0.0);let r=ux_f64_put(s+24,1.0);";
    const char *plane="let l=Vector3_copy(144,x);let c=ux_f64_put(l+24,0.0-2.0);";
    const char *box="let lo=Vector3_set(144,2.0,0.0-1.0,0.0-1.0);let hi=Vector3_set(168,4.0,1.0,1.0);";
    const char *tri="let ta=Vector3_set(144,3.0,0.0-1.0,0.0-1.0);let tb=Vector3_set(168,3.0,0.0-1.0,1.0);"
        "let tc=Vector3_set(192,3.0,1.0,0.0-1.0);";
    const char *seg="let s=Vector3_set(144,3.0,1.0,2.0);let t=Vector3_set(168,3.0,4.0,2.0);"
        "let d=Ray_distanceSqToSegment(a,s,t,240,264);";
    const char *cases[]={
        "let r=Ray_set(144,o,x);return ux_f64(r+24);",
        "let r=Ray_copy(144,a);return ux_f64(r+24);","let r=Ray_clone(144,a);return ux_f64(r);",
        "let r=Ray_at(240,a,2.0);return ux_f64(r);",
        "let s=Vector3_set(144,0.0,2.0,0.0);let r=Ray_lookAt(a,s);return ux_f64(r+32);",
        "let r=Ray_recast(a,2.0);return ux_f64(r);",
        "let r=Ray_closestPointToPoint(240,a,p);return ux_f64(r);",
        "let r=Ray_closestPointToPoint(240,a,q);return ux_f64(r);",
        "return Ray_distanceToPoint(a,p);","return Ray_distanceSqToPoint(a,q);",
        "return d;","return ux_f64(240);","return ux_f64(272);",
        "let hit=Ray_intersectSphere(240,a,s);return ux_f64(hit);","return Ray_intersectsSphere(a,s);",
        "let e=Ray_set(192,s,x);let hit=Ray_intersectSphere(240,e,s);return ux_f64(hit);",
        "return Ray_distanceToPlane(a,l);","let hit=Ray_intersectPlane(240,a,l);return ux_f64(hit);",
        "return Ray_intersectsPlane(a,l);","let t=ux_f64_put(l+24,2.0);return Ray_distanceToPlane(a,l);",
        "let hit=Ray_intersectBox(240,a,lo);return ux_f64(hit);","return Ray_intersectsBox(a,lo);",
        "let pt=Vector3_set(192,3.0,0.0,0.0);let e=Ray_set(288,pt,x);let hit=Ray_intersectBox(240,e,lo);return ux_f64(hit);",
        "let hit=Ray_intersectTriangle(240,a,ta,tb,tc,1);return ux_f64(hit);",
        "return Ray_intersectTriangle(240,a,ta,tc,tb,1);",
        "let c0=ux_f64_put(288,0.0-2.0);let c1=ux_f64_put(328,3.0);let c2=ux_f64_put(368,4.0);"
        "let c3=ux_f64_put(384,1.0);let d3=ux_f64_put(408,1.0);let r=Ray_applyMatrix4(a,288);return ux_f64(r+24);",
        "let r=Ray_clone(144,a);return Ray_equals(a,r);"
    };
    const double gold[]={1,1,0,2,1,2,3,0,4,5,5,3,1,3,1,5,2,2,1,-1,2,1,4,3,-1,-1,1};
    enum {count=sizeof gold/sizeof gold[0]};
    char samples[count][512];
    const char *programs[count];
    for(int i=0;i<count;i++) {
        const char *extra="";
        if(i>=10 && i<=12) extra=seg;
        if(i>=13 && i<=15) extra=sphere;
        if(i>=16 && i<=19) extra=plane;
        if(i>=20 && i<=22) extra=box;
        if(i==23 || i==24) extra=tri;
        int length=tx_snprintf(samples[i],sizeof samples[i],"%s%s",extra,cases[i]);
        if(length<0 || length>=(int)sizeof samples[i]) return 2;
        programs[i]=samples[i];
    }
    return g_math_run("G_MATH Ray","ray",modules,setup,programs,gold,count,
        mutate?6:-1,"let r=Ray_closestPointToPoint(240,a,q);return ux_f64(r);");
}
