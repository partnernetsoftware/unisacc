#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"record-copy","loadingmanager","fileloader","image-layout","imagebitmaploader",0};
    const char *setup="let image=64;let ptr=ux_u32_put(image+ImageResource.rgba,256);"
        "let w=ux_u32_put(image+ImageResource.width,1);let h=ux_u32_put(image+ImageResource.height,2);"
        "let stride=ux_u32_put(image+ImageResource.rowBytes,8);let r0=ux_u8_put(256,40);let a0=ux_u8_put(259,255);"
        "let r1=ux_u8_put(264,64);let a1=ux_u8_put(267,128);";
    const char *cases[]={
        "return ImageBitmapLoader_copy(image,512,8,0);",
        "let n=ImageBitmapLoader_copy(image,512,8,0);return ux_u8(512);",
        "let n=ImageBitmapLoader_copy(image,512,8,1);return ux_u8(512);",
        "let n=ImageBitmapLoader_copy(image,512,8,3);return ux_u8(512);",
        "let n=ImageBitmapLoader_copy(image,512,8,3);return ux_u8(515);",
        "return ImageBitmapLoader_copy(image,512,7,0);",
        "return ImageBitmapLoader_copy(image,264,8,0);"
    };
    const double gold[]={8,40,64,32,128,-1,-1};
    return g_math_run("G_IO ImageBitmapLoader","imagebitmaploader",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let n=ImageBitmapLoader_copy(image,512,8,0);return ux_u8(512);");
}
