#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","compressedtextureloader","compressed-texture-astc-constant",0};
    const char *setup=
        "native function astc_test(format:i64,w:i64,h:i64,bytes:i64) i64 {"
        "let i=0;while(i<4){let block=128+i*16;let a=ux_u32_put(block,4294966780);"
        "let b=ux_u32_put(block+4,4294967295);let red=ux_u8_put(block+9,32+i);"
        "let alpha=ux_u8_put(block+15,255);i=i+1;}"
        "let a=ux_u32_put(32+CompressedMip.data,128);let b=ux_u32_put(32+CompressedMip.bytes,bytes);"
        "let c=ux_u32_put(32+CompressedMip.width,w+1);let d=ux_u32_put(32+CompressedMip.height,h+1);"
        "let e=ux_u32_put(32+CompressedMip.format,format);"
        "let n=CompressedTexture_astcRGBA8(32,512,1024);if(n<0){return n;}"
        "let x=astc_footprint(format,0);let y=astc_footprint(format,1);"
        "if(n!=4*(w+1)*(h+1) || ux_u8(512)!=32 || ux_u8(512+4*w)!=33 ||"
        "ux_u8(512+4*h*(w+1))!=34 || ux_u8(512+4*(h*(w+1)+w))!=35){return 0-5;}"
        "return format*10000+x*100+y;}";
    const int shapes[14][2]={{4,4},{5,4},{5,5},{6,5},{6,6},{8,5},{8,6},{8,8},
        {10,5},{10,6},{10,8},{10,10},{12,10},{12,12}};
    char code[28][100];
    const char *cases[28];
    double gold[28];
    for(int i=0;i<28;i++) {
        int format=37808+i%14,w=shapes[i%14][0],h=shapes[i%14][1];
        int n=tx_snprintf(code[i],sizeof code[i],"return 0.0+astc_test(%d,%d,%d,%d);",format,w,h,i<14?64:48);
        if(n<0 || n>=(int)sizeof code[i]) return 2;
        cases[i]=code[i];
        gold[i]=i<14?format*10000+w*100+h:-3;
    }
    return g_wasm_batch("G_IO ASTC footprints and pixels","compressed-texture-astc-format",modules,setup,cases,gold,28,
        mutate?13:-1,"return 0.0+astc_test(37820,12,12,64);");
}
