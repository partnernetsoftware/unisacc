#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define RGBA(r,g,b,a) ((r)+256.0*(g)+65536.0*(b)+16777216.0*(a))
#define CALL "let n=OutlinePass_overlayRGBA8(mask,edge1,edge2,pattern,dst,28,7,settings);"
#define OUTPUT(offset) CALL "return 0.0+ux_u32(dst+" #offset ");"

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"f64-math","postprocess-rgba8","outlinepass-overlay",0};
    const char *setup=
        "native function outline_inputs(mask:i64,edge1:i64,edge2:i64,pattern:i64) i64 {"
        "let at=0;while(at<28){"
        "let r=ux_u32_put(mask+at,0);let g=ux_u8_put(mask+at+1,255);"
        "let e=ux_u32_put(edge1+at,1379804690);let f=ux_u32_put(edge2+at,1346119700);"
        "let p=ux_u32_put(pattern+at,0);at=at+4;}"
        "let a=ux_u8_put(mask,255);let b=ux_u32_put(mask+4,255);"
        "let c=ux_u8_put(mask+12,127);let d=ux_u8_put(mask+21,254);"
        "let p2=ux_u8_put(pattern+8,1);let p3=ux_u8_put(pattern+12,255);"
        "let p4=ux_u8_put(pattern+16,255);let p5=ux_u8_put(pattern+20,127);"
        "return ux_u8_put(pattern+24,129);}"
        "let mask=0;let edge1=64;let edge2=128;let pattern=192;let dst=257;let settings=320;"
        "let strength=ux_f64_put(settings,2.0);let glow=ux_f64_put(settings+8,0.5);"
        "let init=outline_inputs(mask,edge1,edge2,pattern);";
    const char *cases[]={
        OUTPUT(0),OUTPUT(4),OUTPUT(8),OUTPUT(12),OUTPUT(16),OUTPUT(20),OUTPUT(24),
        CALL "return 0.0+n;",
        "let set=ux_f64_put(settings+8,0.0);let n=OutlinePass_overlayRGBA8(mask,edge1,edge2,0-1,dst,28,7,settings);return 0.0+ux_u32(dst);",
        "let s=ux_f64_put(settings,16.0);let g=ux_f64_put(settings+8,1.0);"
        "let n=OutlinePass_overlayRGBA8(mask,edge1,edge2,0-1,dst,28,7,settings);return 0.0+ux_u32(dst);",
        "let keep=ux_u32_put(dst,481);let n=OutlinePass_overlayRGBA8(mask,edge1,edge2,pattern,dst,27,7,settings);"
        "return 0.0+ux_u32(dst)+1000*n;",
        "return 0.0+OutlinePass_overlayRGBA8(mask,edge1,edge2,pattern,mask+1,28,7,settings);",
        "return 0.0+OutlinePass_overlayRGBA8(mask,edge1,edge2,dst-1,dst,28,7,settings);",
        "return 0.0+OutlinePass_overlayRGBA8(mask,edge1,edge2,6291429,dst,28,7,settings);",
        "return 0.0+OutlinePass_overlayRGBA8(mask,edge1,edge2,pattern,6291428,29,7,settings);",
        "return 0.0+OutlinePass_overlayRGBA8(mask,edge1,edge2,0-2,dst,28,7,settings);",
        "let set=ux_f64_put(settings,0.0/0.0);"
        "return 0.0+OutlinePass_overlayRGBA8(mask,edge1,edge2,pattern,dst,28,7,settings);",
        "return 0.0+OutlinePass_overlayRGBA8(mask,edge1,edge2,pattern,dst,28,7,settings+1);",
        "return 0.0+OutlinePass_overlayRGBA8(mask,edge1,edge2,pattern,dst,28,7,264);",
        "return 0.0+OutlinePass_overlayRGBA8(mask,edge1,edge2,pattern,dst,28,0,settings);",
    };
    const double gold[]={
        RGBA(56,116,184,244),RGBA(56,116,184,244),RGBA(127,127,127,127),
        RGBA(28,58,92,122),0,RGBA(128,128,128,128),RGBA(63,63,63,63),7,
        RGBA(36,76,124,164),RGBA(255,255,255,255),-519,-1,-1,-1,-1,-1,-1,-1,-1,-1,
    };
    return g_wasm_batch_addon("G_PIXEL OutlinePass overlay","outlinepass-overlay",argv[1],modules,
        setup,cases,gold,sizeof gold/sizeof gold[0],mutate?5:-1,
        "let k=ux_u8_put(mask+21,255);" OUTPUT(20));
}
