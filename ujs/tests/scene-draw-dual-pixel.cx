#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[390],abi[300],wasm[300],url[690];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-scene-dual-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/scene.wasm",dir);
    int length=tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/scene-draw-dual-r160.html?wasm=%s&mode=%d",
        cwd,wasm,mutate);
    const char entry[]="import host_gpu_submit from \"uxe_gpu_v1\"(i64,i64) i64;\n"
        "export uxe_scene_dual(mode:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,"ujs/practice/uxe/base/record-copy.ujs",
        "ujs/practice/uxe/base/scene-snapshot-layout.ujs","ujs/practice/uxe/base/render-list.ujs",
        "ujs/practice/uxe/base/scene-render-list.ujs","ujs/practice/uxe/base/scene-draw-project.ujs",
        "ujs/practice/uxe/base/gpu-packet.ujs","ujs/practice/uxe/base/scene-draw-gpu.ujs",
        "ujs/practice/uxe/base/scene-draw-software.ujs","ujs/practice/uxe/base/scene-draw-dual.ujs",
        "ujs/practice/uxe/test/scene-draw-dual-probe.ujs","-o",wasm,0};
    const double gold[]={0,0,0,255,0,255,0,255};
    double actual[24]={0};
    char *output=0;
    size_t bytes=0;
    int failed=length<0 || length>=(int)sizeof url || sy_write_file(abi,entry,sizeof entry-1,0600);
    if(!failed) {
        const int rc=cx_runv_timeout(compile,6,&output,&bytes);
        if(rc) { printf("G_PIXEL dual scene compiler_rc=%d %s\n",rc,output?output:""); failed++; }
        mm_free(output); output=0;
    }
    if(!failed) failed=r160_wait_read(url,"#r160",actual,24,dir);
    if(!failed) for(int i=0;i<24;i++) if(actual[i]!=gold[i%8]) {
        printf("G_PIXEL dual scene case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i%8]);
        failed++;
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&output,&bytes)) failed++;
    mm_free(output);
    printf("G_PIXEL dual scene cases=24 failed=%d\n",failed);
    return failed!=0;
}
