#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","glb-container","record-copy","json-read","loader-json","gltfloader",0};
    #define GLB_VERSION_PREFIX "{\"asset\":{\"version\":\""
    #define GLB_LENGTH_PREFIX GLB_VERSION_PREFIX "2.0\"},\"buffers\":[{\"byteLength\":"
    const char json[]=GLB_LENGTH_PREFIX "12}]}";
    int length=(sizeof json+2)/4*4;
    char setup[1100];
    int n=tx_snprintf(setup,sizeof setup,"let bytes=%d;let end=%d;let json=[",40+length,20+length);
    for(int i=0;i<length;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",i<(int)sizeof json-1?json[i]:32);
    tx_snprintf(setup+n,sizeof setup-n,"];let a=ux_u32_put(0,1179937895);let b=ux_u32_put(4,2);"
        "let c=ux_u32_put(8,bytes);let d=ux_u32_put(12,%d);let e=ux_u32_put(16,1313821514);"
        "let i=0;while(i<%d){let cell=ux_u8_put(20+i,json[i]);i=i+1;}"
        "let f=ux_u32_put(end,12);let g=ux_u32_put(end+4,5130562);let x=ux_f32_put(end+8,1.25);"
        "let y=ux_f32_put(end+12,2.0);let z=ux_f32_put(end+16,-3.0);"
        "let manager=LoadingManager_init(768);let file=FileLoader_init(800,manager);let id=FileLoader_begin(file,900);"
        "let got=FileLoader_receive(file,id,200,0,bytes,900);let versionAt=%d;let lengthAt=%d;",
        length,length,20+(int)sizeof GLB_VERSION_PREFIX-1,20+(int)sizeof GLB_LENGTH_PREFIX-1);
    const char *cases[]={
        "let g=GlbContainer_probe(0,bytes,256);return ux_u32(g+GlbResource.binBytes);",
        "let g=GlbContainer_probe(0,bytes,256);let p=GlbContainer_access(g,0,1,12,12,4);return ux_f32(p);",
        "let g=GlbContainer_probe(0,bytes,256);let p=GlbContainer_access(g,0,1,12,12,4);return ux_f32(p+8);",
        "let g=GlbContainer_probe(0,bytes,256);return ux_u8(ux_u32(g+GlbResource.json));",
        "let bad=ux_u32_put(4,1);return GlbContainer_probe(0,bytes,256);",
        "let bad=ux_u32_put(end,16);return GlbContainer_probe(0,bytes,256);",
        "let g=GlbContainer_probe(0,bytes,256);return GlbContainer_access(g,0,2,12,12,4);",
        "let g=GlbContainer_probe(0,bytes,256);return GlbContainer_access(g,1,1,12,8,4);",
        "let guard=ux_u32_put(256+GlbResource.jsonBytes,777);let bad=ux_u32_put(end,16);"
        "let failed=GlbContainer_probe(0,bytes,256);return ux_u32(256+GlbResource.jsonBytes);",
        "let parsed=GltfLoader_readGlb(file,256,512);return ux_u32(parsed+GlbResource.binBytes);",
        "let wrong=ux_u8_put(versionAt,49);return GltfLoader_readGlb(file,256,512);",
        "let wrong=ux_u8_put(lengthAt,57);return GltfLoader_readGlb(file,256,512);"
    };
    const double gold[]={12,1.25,-3,123,-2,-3,-2,-1,777,12,-4,-6};
    return g_math_run("G_IO GlbContainer","glb-container",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?2:-1,
        "let g=GlbContainer_probe(0,bytes,256);let p=GlbContainer_access(g,0,1,12,12,4);return ux_f32(p+4);");
}
