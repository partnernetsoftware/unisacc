#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int depth=argc==2 && tx_eqz(argv[1],"--mutate-depth");
    int stencil=argc==2 && tx_eqz(argv[1],"--mutate-stencil");
    if(argc!=1 && !depth && !stencil) return 2;
    const char *modules[]={"gpu-depth-format","gpu-depth-format-generated",0};
    const char *setup="let a=ux_u16_put(64,16384);let b=ux_u32_put(128,3221225233);";
    const char *cases[]={
        "return f64_floor_i64(GpuDepthFormat_sample(64,1026,1012)*255.0+0.5);",
        "return f64_floor_i64(GpuDepthFormat_sample(128,1027,1020)*255.0+0.5);",
        "return GpuDepthFormat_stencil(128,1027,1020)==17;",
        "return GpuDepthFormat_stencil(128,1027,1020)==18;",
        "return GpuDepthFormat_stencil(64,1026,1012);"
    };
    const double gold[]={64,191,1,0,-1};
    return g_math_run("G_STRUCT GPU depth formats","gpu-depth-format",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],depth?0:stencil?2:-1,depth?cases[1]:cases[3]);
}
