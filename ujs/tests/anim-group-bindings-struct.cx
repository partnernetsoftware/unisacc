#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.fmt
#pragma unisa use text.text

#define SHARED 1,1,0,1,1,2,1,1,0,1,1,1,2,1,1,1,3,4,1,1,1

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    char dir[256],cwd[390],abi[300],wasm[300],url[690];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-anim-subs-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/subscriptions.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/ujs/practice/uxe/test/anim-group-bindings-r160.html?wasm=%s&mode=%d",cwd,wasm,mutate);
    const char entry[]="export uxe_anim_subscriptions(mutate:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,"ujs/practice/uxe/base/f64-math.ujs",
        "ujs/practice/uxe/base/views.ujs","ujs/practice/uxe/base/animation-view.ujs",
        "ujs/practice/uxe/base/animationobjectgroup.ujs","ujs/practice/uxe/base/anim-group-bindings.ujs",
        "ujs/practice/uxe/test/anim-group-bindings-probe.ujs","-o",wasm,0};
    // r160 leaves a stale path index on unsubscribe, so re-subscribe finds
    // no live bindings. The native registry removes the index explicitly.
    const double gold[]={SHARED,1,3,1,SHARED,0,3,0};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    char *output=0;
    size_t bytes=0;
    int failed=length<0 || length>=(int)sizeof url || sy_write_file(abi,entry,sizeof entry-1,0600);
    if(!failed) {
        const int rc=cx_runv_timeout(compile,6,&output,&bytes);
        if(rc) { printf("G_STRUCT AnimGroup compiler_rc=%d %s\n",rc,output?output:""); failed++; }
        mm_free(output); output=0;
    }
    if(!failed) failed=r160_wait_read(url,"#r160",actual,count,dir);
    if(!failed) for(int i=0;i<count;i++) if(actual[i]!=gold[i]) {
        printf("G_STRUCT AnimGroup case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
        failed++;
    }
    char *clean[]={"rm","-rf","--",dir,0};
    if(cx_runv_timeout(clean,5,&output,&bytes)) failed++;
    mm_free(output);
    printf("G_STRUCT AnimGroup subscriptions cases=%d failed=%d\n",count,failed);
    return failed!=0;
}
