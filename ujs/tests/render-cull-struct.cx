#pragma unisa use g_math
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"vector-scalar","vector3","box3","sphere","frustum",
        "record-copy","render-list","render-cull",0};
    const char *setup="let positions=[0.0,2.0,1.5,8.0,0.0,2.0];let flags=[3,3,3,1,2,3];"
        "let a=ux_f64_put(0,1.0);let b=ux_f64_put(40,1.0);"
        "let c=ux_f64_put(80,1.0);let d=ux_f64_put(120,1.0);"
        "let planes=Frustum_setFromProjectionMatrix(128,0,0);let radius=ux_f64_put(344,0.5);"
        "let i=0;while(i<6){let world=512+128*i;let item=1600+i*RenderItem.size;"
        "let row=2000+i*RenderCandidate.size;let sx=1.0;if(i==5){sx=3.0;}"
        "let x=ux_f64_put(world,sx);let y=ux_f64_put(world+40,1.0);let z=ux_f64_put(world+80,1.0);"
        "let w=ux_f64_put(world+120,1.0);let t=ux_f64_put(world+96,positions[i]);"
        "let id=ux_u32_put(item+RenderItem.objectId,i);"
        "let v=ux_u32_put(row+RenderCandidate.item,item);let s=ux_u32_put(row+RenderCandidate.sphere,320);"
        "let m=ux_u32_put(row+RenderCandidate.worldMatrix,world);let f=ux_u32_put(row+RenderCandidate.flags,flags[i]);i=i+1;}";
    const char *cases[]={"return RenderList_collect(2000,6,128,3000,6,352);",
        "let n=RenderList_collect(2000,6,128,3000,6,352);return ux_u32(3000+RenderItem.objectId);",
        "let n=RenderList_collect(2000,6,128,3000,6,352);return ux_u32(3000+RenderItem.size+RenderItem.objectId);",
        "let n=RenderList_collect(2000,6,128,3000,6,352);return ux_u32(3000+2*RenderItem.size+RenderItem.objectId);",
        "let n=RenderList_collect(2000,6,128,3000,6,352);return ux_u32(3000+3*RenderItem.size+RenderItem.objectId);",
        "return RenderList_collect(2000,6,128,3000,4,352);",
        "let flag=ux_u32_put(2000+RenderCandidate.flags,4);return RenderList_collect(2000,6,128,3000,6,352);"};
    const double gold[]={4,0,2,3,5,-1,-2};
    return g_math_run("G_STRUCT renderer frustum","render-cull",modules,setup,cases,gold,7,
        mutate?0:-1,"let shifted=ux_f64_put(512+128*2+96,1.6);return RenderList_collect(2000,6,128,3000,6,352);");
}
