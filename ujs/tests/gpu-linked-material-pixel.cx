#pragma unisa use wasm_test_cache
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use text.text

static const char layout[]="ujs/practice/uxe/test/gpu-linked-material-layout.ujs";
static const char probe[]="ujs/practice/uxe/test/gpu-linked-material-probe.ujs";
static const char old_probe[]="ujs/practice/uxe/test/gpu-packet-probe.ujs";
static const char old_page[]="ujs/practice/uxe/test/gpu-packet-r160.html";
static const char linked_page[]="ujs/practice/uxe/test/gpu-linked-material-browser.js";
static const char *modules[]={
    "ujs/practice/uxe/base/record-copy.ujs",
    "ujs/practice/uxe/base/gpu-packet.ujs",
    "ujs/practice/uxe/base/f64-math.ujs",
    "ujs/practice/uxe/base/gpu-material-basic.ujs",
    "ujs/practice/uxe/base/gpu-material-lambert.ujs",
    "ujs/practice/uxe/base/gpu-material-phong.ujs",
    "ujs/practice/uxe/base/gpu-material-standard.ujs",
    "ujs/practice/uxe/base/gpu-texture-sample.ujs",
    "ujs/practice/uxe/base/gpu-material-tone.ujs",
    "ujs/practice/uxe/base/gpu-tone-rgb.ujs",
    "ujs/practice/uxe/base/vector-scalar.ujs",
    "ujs/practice/uxe/base/matrix3.ujs",
    "ujs/practice/uxe/base/gpu-texture-uv.ujs",
    "ujs/practice/uxe/base/gpu-texture-table.ujs",
    "ujs/practice/uxe/base/gpu-material-toon.ujs",0
};
static const char *shaders[]={"ujs/practice/uxe/base/gpu-flat.vert",
    "ujs/practice/uxe/base/gpu-flat.frag",
    "ujs/practice/uxe/base/gpu-texture.vert",
    "ujs/practice/uxe/base/gpu-texture.frag",
    "ujs/practice/uxe/base/gpu-cubetexture.vert",
    "ujs/practice/uxe/base/gpu-cubetexture.frag",0};

static int timed(const char *phase,char **args,int seconds,char **out,size_t *bytes) {
    const int64_t start=sy_mono_ns();
    const int rc=cx_runv_timeout(args,seconds,out,bytes);
    printf("GPU_LINK_MATERIAL phase=%s ms=%ld rc=%d\n",phase,(long)((sy_mono_ns()-start)/1000000),rc);
    return rc;
}

static long section(const char *data,long size,const char *marker,long from) {
    if(from<0 || from>=size) return -1;
    const long offset=tx_find(data+from,size-from,marker,tx_len(marker,200));
    return offset<0?-1:from+offset;
}

static int shader_words(char *program,int capacity,int used,const char *path,const char *name,int address) {
    unsigned char *input=0;
    int64_t size=0;
    if(sy_read_file(path,&input,&size,300) || size<1 || used<0 || capacity-used<size*4+360) {
        mm_free(input);
        return -1;
    }
    const int words=(size+3)/4;
    used+=tx_snprintf(program+used,capacity-used,"let %s=[",name);
    for(int i=0;i<words;i++) {
        unsigned word=0;
        for(int byte=0;byte<4;byte++) {
            const int at=i*4+byte;
            if(at<size) word|=(unsigned)input[at]<<(byte*8);
        }
        used+=tx_snprintf(program+used,capacity-used,"%s%u",i?",":"",word);
    }
    used+=tx_snprintf(program+used,capacity-used,
        "];let i=0;while(i<%d){let b=ux_u32_put(%d+4*i,%s[i]);i=i+1;}"
        "let p=ux_u32_put(shader+GpuShaderSource.%s,%d);let n=ux_u32_put(shader+GpuShaderSource.%sBytes,%ld);",
        words,address,name,name,address,name,(long)size);
    mm_free(input);
    return used;
}

static int build_base_source(const char *source) {
    unsigned char *bytes=0;
    int64_t size=0;
    if(sy_read_file(old_probe,&bytes,&size,32000)) return 1;
    const char *text=(const char *)bytes;
    const long helper=section(text,size,"function probe_triangle(",0);
    const long methods=section(text,size,"function probe_tone_callback(",helper);
    const long methods_end=section(text,size,"native function probe_custom_draw(",methods);
    const long begin=section(text,size,"let capacity=2048;",methods_end);
    const long dispatch=section(text,size,"if(mode>=150 && mode<=157)",begin);
    const long dispatch_end=section(text,size,"if(mode==148 || mode==149)",dispatch);
    const long material=section(text,size,"if(mode>=110) { return probe_cube_texture",dispatch_end);
    const long material_end=section(text,size,"if(mode>=20) {",material);
    if(helper<=0 || methods<=helper || methods_end<=methods || begin<=methods_end ||
       dispatch<=begin || dispatch_end<=dispatch || material<=dispatch_end || material_end<=material) {
        mm_free(bytes);
        printf("GPU_LINK_MATERIAL source slice markers missing\n");
        return 1;
    }
    char program[32000];
    int used=0;
    const char *names[]={"probe_shader_sources","probe_texture_sources","probe_cube_sources"};
    const int addresses[]={6500,6800,7100,7400,12300,12600};
    for(int i=0;i<3 && used>=0;i++) {
        used+=tx_snprintf(program+used,sizeof program-used,"native function %s(shader:i64) i64 {",names[i]);
        used=shader_words(program,sizeof program,used,shaders[2*i],"vertex",addresses[2*i]);
        if(used>=0) used=shader_words(program,sizeof program,used,shaders[2*i+1],"fragment",addresses[2*i+1]);
        if(used>=0) used+=tx_snprintf(program+used,sizeof program-used,"return shader;}\n");
    }
    if(used>=0 && used<(int)sizeof program) {
        used+=tx_snprintf(program+used,sizeof program-used,
            "%.*s\n%.*s\n"
            "if(op==0 && value==0) { return 1; }\n"
            "if(op!=1 || !((value>=40 && value<=56) || (value>=60 && value<=66) || "
            "(value>=100 && value<=105) || (value>=110 && value<=116) || (value>=150 && value<=157))) { return 0-1; }\n"
            "let mode=value;\n%.*s%.*s%.*sreturn 0-1;\n",
            (int)helper,text,(int)(methods_end-methods),text+methods,
            (int)(dispatch-begin),text+begin,(int)(dispatch_end-dispatch),text+dispatch,
            (int)(material_end-material),text+material);
    }
    mm_free(bytes);
    return used<0 || used>=(int)sizeof program || sy_write_file(source,program,used,0600);
}

static int load_base(const char *dir,const char *base,int prepare,int check) {
    const char *cache=sy_env("UXE_GPU_LINK_MATERIAL_CACHE");
    if(!cache || cache[0]!='/') {
        printf("GPU_LINK_MATERIAL 基座缓存缺失：先运行准备步骤并设置 UXE_GPU_LINK_MATERIAL_CACHE\n");
        return 1;
    }
    const char *sources[32]={layout,old_probe,"ujs/tests/gpu-linked-material-pixel.cx"};
    int count=3;
    for(int i=0;modules[i];i++) sources[count++]=modules[i];
    for(int i=0;shaders[i];i++) sources[count++]=shaders[i];
    char key[65],sha[65],stored[540];
    if(wasm_test_cache_key(sources,key)) return 1;
    const int path=tx_snprintf(stored,sizeof stored,"%s/%s.bin",cache,key);
    if(path<0 || path>=(int)sizeof stored) return 1;
    const int rc=wasm_test_cache_read(stored,key,prepare?0:base,sha);
    if(!rc && !check) {
        printf("GPU_LINK_MATERIAL base cache hit key=%s sha=%s\n",key,sha);
        return 0;
    }
    if(rc && rc!=-ENOENT) {
        printf("GPU_LINK_MATERIAL base cache rejected rc=%d key=%s\n",rc,key);
        return 1;
    }
    if(rc==-ENOENT && (!prepare || check)) {
        printf("GPU_LINK_MATERIAL 基座缓存缺失：先运行准备步骤 key=%s\n",key);
        return 1;
    }
    char source[360];
    tx_snprintf(source,sizeof source,"%s/base.ujs",dir);
    if(build_base_source(source)) return 1;
    char *args[32]={"./ujs/ujs2wasm.com",(char *)layout};
    int n=2;
    for(int i=0;modules[i];i++) args[n++]=(char *)modules[i];
    args[n++]=source;
    args[n++]="-o";
    args[n++]=(char *)base;
    args[n]=0;
    char *out=0;
    size_t bytes=0;
    const int failed=timed("base_prepare",args,30,&out,&bytes);
    if(failed && out) printf("%.*s\n",(int)bytes,out);
    mm_free(out);
    if(failed) return 1;
    if(check) {
        const int drift=wasm_test_cache_verify(base,sha);
        printf("GPU_LINK_MATERIAL cache=rebuilt sha=%s failed=%d\n",sha,drift!=0);
        return drift;
    }
    const int saved=wasm_test_cache_write(cache,stored,key,base);
    printf("GPU_LINK_MATERIAL prepared key=%s failed=%d\n",key,saved!=0);
    return saved;
}

static int build_browser(const char *path) {
    unsigned char *source=0,*loader=0;
    int64_t bytes=0,loader_bytes=0;
    if(sy_read_file(old_page,&source,&bytes,80000) || sy_read_file(linked_page,&loader,&loader_bytes,9000)) {
        mm_free(source); mm_free(loader); return 1;
    }
    const char *text=(const char *)source;
    const long prelude=section(text,bytes,"\ntry {\n",0);
    const long actual=section(text,bytes,"  const basicMode =",prelude);
    const long actual_end=section(text,bytes,"  const litShaderErrors =",actual);
    const long tone=section(text,bytes,"  const toneSuiteStart =",actual_end);
    const long tone_end=section(text,bytes,"  for (const mode of [mutate ?",tone);
    const long renderer=section(text,bytes,"  const three = context();",tone_end);
    const long renderer_end=section(text,bytes,"  for (let sceneIndex",renderer);
    const long ref=section(text,bytes,"  renderer.setScissorTest(false);\n  renderer.setClearColor(0, 1);\n  const basicGeometry",renderer_end);
    const long ref_end=section(text,bytes,"  const litResults =",ref);
    const long more=section(text,bytes,"  renderer.shadowMap.enabled = false;\n  renderer.setClearColor(0, 1);\n  renderer.toneMappingExposure = 2;",ref_end);
    const long more_end=section(text,bytes,"  result.textContent = JSON.stringify",more);
    const long cells=section(text,bytes,"basicStatus, ...actualBasic, ...referenceBasic,",more_end);
    const long cells_end=section(text,bytes,"    ...litResults.slice(0, 6).flat(),",cells);
    int failed=1;
    if(prelude>0 && actual>prelude && actual_end>actual && tone>actual_end && tone_end>tone &&
       renderer>tone_end && renderer_end>renderer && ref>renderer_end && ref_end>ref &&
       more>ref_end && more_end>more && cells>more_end && cells_end>cells) {
        char page[32000];
        const int length=tx_snprintf(page,sizeof page,
            "%.*s\n%.*s%.*s%.*s%.*s%.*s%.*s"
            "  result.textContent = JSON.stringify([%.*s...toneResults]);\n"
            "} catch (error) { result.textContent = String(error); }\n</script>\n",
            (int)prelude,text,(int)loader_bytes,loader,(int)(actual_end-actual),text+actual,
            (int)(tone_end-tone),text+tone,(int)(renderer_end-renderer),text+renderer,
            (int)(ref_end-ref),text+ref,(int)(more_end-more),text+more,
            (int)(cells_end-cells),text+cells);
        failed=length<0 || length>=(int)sizeof page || sy_write_file(path,page,length,0600);
    } else printf("GPU_LINK_MATERIAL browser slice markers missing\n");
    mm_free(source); mm_free(loader);
    return failed;
}

static int copy_at(const char *dir,const char *file,const char *source) {
    char path[340];
    const int length=tx_snprintf(path,sizeof path,"%s/%s",dir,file);
    return length<0 || length>=(int)sizeof path || sy_copy(source,path,0600);
}

static int material_check(char *at) {
    int failed=0;
    double actual[20]={0};
    for(int k=0;k<777;k++) {
        const int i=k<613?314+k:1518+k-613;
        char *end=0;
        const double value=tx_strtod(at,&end);
        if(end==at || *end!=(k==776?']':',')) {
            printf("GPU_LINK_MATERIAL malformed original cell=%d\n",i);
            return failed+1;
        }
        double expected=0,tolerance=0;
        if(i>=1518) {
            const int scene=(i-1518)/41,sample=(i-1518)%41;
            if(sample) {
                const int cell=(sample-1)%20,channel=cell%4;
                if(sample<=20) actual[cell]=value;
                if(channel==3) expected=255;
                else if(cell/4!=0&&cell/4!=2) expected=0;
                else if(scene==2) {
                    const int half[]={92,44,4};
                    expected=half[channel]; tolerance=1;
                } else if(sample>20) {
                    expected=actual[cell]; tolerance=2;
                } else {
                    expected=value;
                    if(value<0||value>255||(channel==0&&value<40)) failed++;
                }
            }
        } else if(i>=886) {
            const int toon[]={108,53,6,255},inside[]={1,0,1,0,0};
            const int sample=i-886;
            if(sample) {
                const int cell=(sample-1)%20;
                expected=cell%4==3?255:inside[cell/4]*toon[cell%4]; tolerance=1;
            }
        } else if(i>=865) {
            const int canvas[]={0,0,255,0,255,0,0,0,255,255,0,0,255,0,0,0,255,0,0,0,255};
            expected=canvas[i-865];
        } else if(i>=811) {
            const int colors[][4]={{255,0,0,255},{0,255,0,255},{0,0,255,255},
                {255,255,0,255},{255,0,255,255},{0,255,255,255}};
            const int cell=(i-811)%9;
            if(cell) expected=colors[(i-811)/9][(cell-1)%4];
        } else if(i>=806) {
            const int lifecycle[]={1000,2,2,0,1002};
            expected=lifecycle[i-806];
        } else if(i>=601) {
            const int offset=i-601,sample=offset%41;
            if(sample) {
                const int cell=(sample-1)%20,point=cell/4,channel=cell%4;
                const int texel[][2][2]={{{0,255},{255,0}},{{112,143},{207,48}},
                    {{0,255},{255,0}},{{255,0},{0,255}},{{128,128},{128,128}}};
                if(channel==3) expected=255;
                else if(channel<2&&(point==0||point==2)) expected=texel[offset/41][point/2][channel];
                tolerance=1;
            }
        } else {
            const int colors[][4]={{128,64,8,255},{92,44,4,255},{148,101,81,255},
                {165,127,112,255},{124,170,203,255},{175,90,15,255},{149,86,15,255}};
            const int inside[]={1,0,1,0,0},offset=i-314,sample=offset%41;
            if(sample) {
                const int cell=(sample-1)%20;
                expected=cell%4==3?255:inside[cell/4]*colors[offset/41][cell%4];
                tolerance=1;
            }
        }
        if(!(value>=expected-tolerance && value<=expected+tolerance)) {
            printf("GPU_LINK_MATERIAL original cell=%d actual=%.4g expected=%.4g tolerance=%.4g\n",i,value,expected,tolerance);
            failed++;
        }
        at=end+1;
    }
    return failed;
}

static const struct { const char *flag; int mode; int replacement; } mutations[]={
    {"basic-mutate",40,41},{"lambert-mutate",42,43},{"phong-mutate",44,45},
    {"standard-mutate",46,47},{"texture-mutate",50,51},{"tone-mutate",52,54},
    {"toon-mutate",55,56},{"sampled-mutate",60,62},{"wrap-mutate",63,66},
    {"texture-life-mutate",100,101},{"cube-mutate",110,116},{"tone-suite-mutate",150,154},
    {"scene-omit-mutate",0,0},{0,0,0}
};

static int browser(const char *dir,int mutation) {
    char url[380],profile[360];
    const char *query=mutation>=0?mutations[mutation].flag:"";
    tx_snprintf(url,sizeof url,"file://%s/probe.html%s%s",dir,*query?"?":"",query);
    tx_snprintf(profile,sizeof profile,"--user-data-dir=%s/chrome",dir);
    char *args[]={"google-chrome","--headless=new","--no-first-run","--disable-background-networking",
        "--allow-file-access-from-files","--enable-unsafe-swiftshader","--use-angle=swiftshader",
        "--virtual-time-budget=7000","--dump-dom",profile,url,0};
    char *out=0;
    size_t bytes=0;
    int failed=timed("chrome",args,20,&out,&bytes);
    const char marker[]="<pre id=\"gpu\">[";
    const int order[]={40,42,44,46,50,52,53,55,60,61,63,64,65,100,102,103,104,105,110,111,112,113,114,115,150,151,152,153};
    char visits[180];
    int n=tx_snprintf(visits,sizeof visits,"<pre id=\"gpu-scenes\">[");
    for(int i=0;i<28;i++) {
        int mode=order[i];
        if(mutation>=0 && mode==mutations[mutation].mode) mode=mutations[mutation].replacement;
        if(mutation>=0 && mutations[mutation].mode==150 && i>=25) mode+=4;
        n+=tx_snprintf(visits+n,sizeof visits-n,"%s%d",i?",":"",mode);
    }
    tx_snprintf(visits+n,sizeof visits-n,"]</pre>");
    const long at=out?section(out,bytes,marker,0):-1;
    if(!failed && at>=0) {
        failed=material_check(out+at+sizeof marker-1);
        if(section(out,bytes,visits,0)<0) { printf("GPU_LINK_MATERIAL visits mismatch\n"); failed++; }
    } else {
        long detail=out?section(out,bytes,"<pre id=\"gpu\">",0):-1;
        printf("GPU_LINK_MATERIAL browser detail=%.210s\n",detail>=0?out+detail:"");
        failed=1;
    }
    mm_free(out);
    return failed;
}

int main(int argc,char **argv) {
    const int check=argc==3 && tx_eqz(argv[1],"--prepare") && tx_eqz(argv[2],"--check");
    const int prepare=check || (argc==2 && tx_eqz(argv[1],"--prepare"));
    const int64_t start=sy_mono_ns();
    int mutation=-1;
    if(argc==2 && argv[1][0]=='-' && argv[1][1]=='-') {
        for(int i=0;mutations[i].flag;i++) if(tx_eqz(argv[1]+2,mutations[i].flag)) mutation=i;
    }
    if(argc!=1 && !prepare && mutation<0) return 2;
    char dir[256],base[350],wasm[350],page[350];
    if(sy_mkdtemp("/tmp","uxe-gpu-linked-material-",dir,sizeof dir)) return 2;
    tx_snprintf(base,sizeof base,"%s/base.wasm",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/probe.wasm",dir);
    tx_snprintf(page,sizeof page,"%s/probe.html",dir);
    int failed=load_base(dir,base,prepare,check);
    if(!failed && !prepare) {
        char *compile[]={"./ujs/ujs2wasm.com",(char *)probe,"-o",wasm,0};
        char *out=0;
        size_t bytes=0;
        failed=timed("probe",compile,6,&out,&bytes);
        if(failed && out) printf("%.*s\n",(int)bytes,out);
        mm_free(out);
        failed=failed || build_browser(page) ||
            copy_at(dir,"gpu-host-abi.js","ujs/practice/uxe/base/gpu-host-abi.js") ||
            copy_at(dir,"gpu-state-abi.js","ujs/practice/uxe/base/gpu-state-abi.js") ||
            copy_at(dir,"three.module.js","ujs/practice/web/game/three.module.js");
        if(!failed) failed=browser(dir,mutation);
        printf("G_PIXEL GPU_LINK_MATERIAL material scenes=23 values=777 failed=%d\n",failed);
    }
    if(sy_remove_all(dir)) return 1;
    const long elapsed=(sy_mono_ns()-start)/1000000;
    printf("GPU_LINK_MATERIAL material %s ms=%ld\n",prepare?"prepare":"consumer",elapsed);
    return failed || (prepare && elapsed>=55000);
}
