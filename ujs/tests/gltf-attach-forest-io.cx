#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d","loadingmanager","fileloader",
        "glb-container","json-read","loader-json","gltf-scene-roots","gltf-node-parents","gltf-attach-forest",0};
    const char json[]="{\"nodes\":[{\"children\":[2,1]},{\"children\":[3]},{},{}]}";
    char setup[2100];
    int n=tx_snprintf(setup,sizeof setup,
        "let arena=0;let glb=2048;let json=2112;let handles=2304;let work=2400;let key=2560;"
        "let ready=Object3D_initArena(arena,4);let a=ux_u32_put(glb+GlbResource.json,json);"
        "let b=ux_u32_put(glb+GlbResource.jsonBytes,%d);"
        "let i=0;while(i<4){let handle=Object3D_create(arena);let saved=ux_u32_put(handles+i*4,handle);i=i+1;}"
        "let root=Object3D_address(arena,ux_u32(handles));let leaf=Object3D_address(arena,ux_u32(handles+12));"
        "let raw=[",(int)sizeof json-1);
    for(int i=0;i<(int)sizeof json-1;i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",json[i]);
    n+=tx_snprintf(setup+n,sizeof setup-n,
        "];i=0;while(i<%d){let put=ux_u8_put(json+i,raw[i]);i=i+1;}",(int)sizeof json-1);
    if(n<0 || n>=(int)sizeof setup) return 2;
    #define BUILD "let count=GltfLoader_attachForest(glb,arena,handles,4,key,work,96);"
    const char *cases[]={
        BUILD "return 0.0+count;",
        BUILD "return 0.0+(ux_u32(root+Object3D.firstChild)%65536-1);",
        BUILD "return 0.0+(ux_u32(root+Object3D.lastChild)%65536-1);",
        BUILD "return 0.0+(ux_u32(leaf+Object3D.parent)%65536-1);",
        "let bad=ux_u32_put(handles+4,ux_u32(handles));" BUILD
        "return 0.0+(count==0-3 && ux_u32(root+Object3D.firstChild)==0);",
        "return 0.0+GltfLoader_attachForest(glb,arena,handles,4,key,work,95);",
        BUILD "return 0.0+GltfLoader_attachForest(glb,arena,handles,4,key,work,96);",
    };
    const double gold[]={3,2,1,1,1,-1,-3};
    return g_wasm_batch_addon("G_IO GLTF ordered Object3D forest","gltf-attach-forest",argv[1],modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?1:-1,
        BUILD "return 0.0+(ux_u32(root+Object3D.lastChild)%65536-1);");
}
