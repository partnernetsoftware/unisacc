#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","audioloader","audio-buffer-playback","audio-analyser-window",0};
    const char *setup="let state=0;let ring=128;let pcm=512;let out=1280;"
        "let ready=AudioAnalyser_initWindow(state,ring,32);let i=0;"
        "while(i<128){let sample=0.0;let phase=i%4;"
        "if(phase==0){sample=0.0-1.5;}if(phase==1){sample=0.25;}"
        "if(phase==2){sample=1.5;}if(phase==3){sample=0.0-0.25;}"
        "let put=ux_f32_put(pcm+i*4,sample);i=i+1;}";
    #define PUSH "let push=AudioAnalyser_pushWindow(state,pcm,128);"
    #define READ "let count=AudioAnalyser_getByteTimeData(state,out,32);"
    const char *cases[]={
        READ "return 0.0+ux_u8(out);",
        PUSH READ "return 0.0+count;",
        PUSH READ "return 0.0+ux_u8(out);",
        PUSH READ "return 0.0+ux_u8(out+1);",
        PUSH READ "return 0.0+ux_u8(out+2);",
        PUSH READ "return 0.0+ux_u8(out+3);",
        PUSH "let partial=AudioAnalyser_pushWindow(state,pcm,1);" READ "return 0.0+ux_u8(out+31);",
        "return 0.0+AudioAnalyser_initWindow(state,ring,33);",
        "return 0.0+AudioAnalyser_getByteTimeData(state,ring+1,32);",
    };
    const double gold[]={128,32,0,160,255,96,0,-1,-1};
    return g_wasm_batch_page("G_IO AudioAnalyser time domain","audio-analyser-window",
        "ujs/practice/uxe/test/wasm-batch.html",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,PUSH READ "return 0.0+ux_u8(out+3);");
}
