#pragma unisa use g_math
#pragma unisa use text.text

int main(int argc,char **argv) {
    int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"sphericalharmonics3",0};
    const char *setup="let a=SphericalHarmonics3_zero(0);let b=SphericalHarmonics3_zero(216);"
        "let a0=ux_f64_put(a,2.0);let a2=ux_f64_put(a+48,3.0);let a6=ux_f64_put(a+144,5.0);"
        "let b0=ux_f64_put(b,6.0);let z=ux_f64_put(448,1.0);";
    const char *cases[]={
        "let r=SphericalHarmonics3_set(512,a);return ux_f64(r+144);",
        "let r=SphericalHarmonics3_zero(a);return ux_f64(r+144);",
        "let r=SphericalHarmonics3_getAt(480,a,432,512);return ux_f64(r);",
        "let r=SphericalHarmonics3_getIrradianceAt(480,a,432,512);return ux_f64(r);",
        "let r=SphericalHarmonics3_add(a,b);return ux_f64(r);",
        "let r=SphericalHarmonics3_addScaledSH(a,b,0.5);return ux_f64(r);",
        "let r=SphericalHarmonics3_scale(a,2.0);return ux_f64(r);",
        "let r=SphericalHarmonics3_lerp(a,b,0.25);return ux_f64(r);",
        "let r=SphericalHarmonics3_clone(512,a);return SphericalHarmonics3_equals(a,r);",
        "return SphericalHarmonics3_equals(a,b);",
        "let r=SphericalHarmonics3_copy(512,a);return ux_f64(r+48);",
        "let r=SphericalHarmonics3_clone(512,a);return ux_f64(r+48);",
        "let out=SphericalHarmonics3_toArray(a,512,1);let r=SphericalHarmonics3_fromArray(768,out,1);return ux_f64(r);",
        "let r=SphericalHarmonics3_toArray(a,512,2);return ux_f64(r+160);",
        "let r=SphericalHarmonics3_getBasisAt(512,432);return ux_f64(r+48);"
    };
    const double gold[]={5,0,2*0.282095+3*0.488603+10*0.315392,
        2*0.886227+6*0.511664+5*(0.743125-0.247708),8,5,4,3,1,0,3,3,2,5,0.630784};
    return g_math_run("G_MATH SphericalHarmonics3","sphericalharmonics3",modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?3:-1,"let r=SphericalHarmonics3_getAt(480,a,432,512);return ux_f64(r);");
}
