#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use text.fmt
#pragma unisa use text.text

#define GEOMETRY 2,3,-4,-2,0,0,1,0,0,0,3,0,0,1,2,0.25,0.5,0.75,1,0,1
int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if((argc!=2 && !mutate) || argv[1][0]!='/') return 2;
    char cwd[390],dir[256],abi[300],wasm[300],url[768];
    if(sy_cwd(cwd,sizeof cwd) || sy_mkdtemp("/tmp","uxe-export-mesh-",dir,sizeof dir)) return 2;
    tx_snprintf(abi,sizeof abi,"%s/abi.ujs",dir);
    tx_snprintf(wasm,sizeof wasm,"%s/scene.wasm",dir);
    const int length=tx_snprintf(url,sizeof url,
        "file://%s/ujs/practice/uxe/test/gltf-export-mesh-r160.html?package=%s&wasm=%s&mode=%d",
        cwd,argv[1],wasm,mutate);
    const char entry[]="export uxe_export_mesh(mode:i64) i64 version 1;\n";
    char *compile[]={"./ujs/ujs2wasm.com",abi,"ujs/practice/uxe/base/json-bytes.ujs",
        "ujs/practice/uxe/base/gltf-export-manifest.ujs","ujs/practice/uxe/base/gltf-export-mesh.ujs",
        "ujs/practice/uxe/test/gltf-export-mesh-probe.ujs","-o",wasm,0};
    const double gold[]={GEOMETRY,GEOMETRY,-223,-2};
    enum { count=sizeof gold/sizeof gold[0] };
    double actual[count]={0};
    char *out=0;
    size_t bytes=0;
    int failed=length<0 || length>=(int)sizeof url || sy_write_file(abi,entry,sizeof entry-1,0600);
    if(!failed) {
        const int rc=cx_runv_timeout(compile,6,&out,&bytes);
        if(rc) { printf("G_IO GLTFExporter compiler_rc=%d %s\n",rc,out?out:""); failed++; }
        mm_free(out);
    }
    if(!failed) failed=r160_wait_read(url,"#r160",actual,count,dir);
    if(!failed) for(int i=0;i<count;i++) if(actual[i]!=gold[i]) {
        printf("G_IO GLTFExporter case=%d actual=%.17g gold=%.17g\n",i,actual[i],gold[i]);
        failed++;
    }
    if(sy_remove_all(dir)) failed++;
    printf("G_IO GLTFExporter indexed mesh cases=%d failed=%d\n",count,failed);
    return failed!=0;
}
