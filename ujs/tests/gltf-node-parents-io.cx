#pragma unisa use g_wasm_batch
#pragma unisa use text.fmt
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if(argc!=2 && !mutate) return 2;
    const char *modules[]={"loadingmanager","fileloader","glb-container","json-read","loader-json",
        "gltf-scene-roots","gltf-node-parents",0};
    const char good[]="{\"nodes\":[{\"children\":[1,2]},{\"children\":[3]},{},{}]}";
    const char cycle[]="{\"nodes\":[{\"children\":[1]},{\"children\":[2]},{\"children\":[0]},{}]}";
    const char duplicate[]="{\"nodes\":[{\"children\":[1,2]},{},{\"children\":[1]},{}]}";
    const char outOfRange[]="{\"nodes\":[{\"children\":[4]},{},{},{}]}";
    const char *inputs[]={good,cycle,duplicate,outOfRange};
    const int sizes[]={sizeof good-1,sizeof cycle-1,sizeof duplicate-1,sizeof outOfRange-1};
    char setup[3400];
    int n=tx_snprintf(setup,sizeof setup,"let out=768;let work=896;let key=1024;"
        "let input=128;let bytes=%d;let keep=ux_u32_put(out,77);",sizes[0]);
    for(int v=0;v<4;v++) {
        const int at=128+v*128;
        n+=tx_snprintf(setup+n,sizeof setup-n,"if(1){let raw=[");
        for(int i=0;i<sizes[v];i++) n+=tx_snprintf(setup+n,sizeof setup-n,"%s%d",i?",":"",inputs[v][i]);
        n+=tx_snprintf(setup+n,sizeof setup-n,"];let i=0;while(i<%d){let put=ux_u8_put(%d+i,raw[i]);i=i+1;}}",
            sizes[v],at);
    }
    n+=tx_snprintf(setup+n,sizeof setup-n,
        "if(selected_case==5){input=256;bytes=%d;}"
        "if(selected_case==6){input=384;bytes=%d;}"
        "if(selected_case==7){input=512;bytes=%d;}"
        "let a=ux_u32_put(GlbResource.json,input);let b=ux_u32_put(GlbResource.jsonBytes,bytes);",
        sizes[1],sizes[2],sizes[3]);
    if(n<0 || n>=(int)sizeof setup) return 2;
    #define LOAD "let n=GltfLoader_nodeParents(0,out,4,work,20,key);"
    const char *cases[]={
        LOAD "return 0.0+n;",
        LOAD "return 0.0+ux_u32(out);",
        LOAD "return 0.0+ux_u32(out+4);",
        LOAD "return 0.0+ux_u32(out+8);",
        LOAD "return 0.0+ux_u32(out+12);",
        LOAD "return 0.0+(n==0-4 && ux_u32(out)==77);",
        LOAD "return 0.0+((n==0-3 && ux_u32(out)==77)*2);",
        LOAD "return 0.0+n;",
        "return 0.0+GltfLoader_nodeParents(0,out,4,work,19,key);",
    };
    const double gold[]={4,4294967295.0,0,0,1,1,2,-3,-1};
    return g_wasm_batch_addon("G_IO GLTF node parents","gltf-node-parents",argv[1],modules,setup,cases,gold,
        sizeof gold/sizeof gold[0],mutate?4:-1,LOAD "return 0.0+ux_u32(out+8);");
}
