#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define ARC "let finish=ArcCurve_toJSON(128,1024,2048,2304,200);if(finish<0){return 0.0+finish;}" \
    "let divisions=ArcCurve_fromJSON(256,1024,finish,4096);if(divisions<0){return 0.0+divisions;}"
#define ELLIPSE "let finish=EllipseCurve_toJSON(128,1024,2048,2304,200);if(finish<0){return 0.0+finish;}" \
    "let divisions=EllipseCurve_fromJSON(256,1024,finish,4096);if(divisions<0){return 0.0+divisions;}"

int main(int argc,char **argv) {
    const int arc=argc>=2 && tx_eqz(argv[1],"--arc");
    const int ellipse=argc>=2 && tx_eqz(argv[1],"--ellipse");
    const int mutate=argc==3 && tx_eqz(argv[2],"--mutate");
    if((!arc && !ellipse) || (argc!=2 && !mutate)) return 2;
    const char *modules[]={"f64-math","views","helper-buffers","record-copy","loaderutils","json-read",
        "json-string-decode","json-bytes","ellipsecurve","arccurve","ellipse-curve-json",0};
    const char *setup="let a=ux_f64_put(128+EllipseCurve.centerX,1.0);"
        "let b=ux_f64_put(128+EllipseCurve.centerY,1.0);"
        "let c=ux_f64_put(128+EllipseCurve.radiusX,2.0);"
        "let d=ux_f64_put(128+EllipseCurve.radiusY,1.0);"
        "let f=ux_f64_put(128+EllipseCurve.finish,3.141592653589793);";
    const char *arc_cases[]={
        ARC "let point=ArcCurve_getPoint(6000,256,0.5);return ux_f64(6008);",
        ARC "return ArcCurve_getLength(256,6000,divisions);",
        ARC "return 0.0+divisions;",
        ARC "return ux_f64(256+EllipseCurve.radiusY);",
    };
    const char *ellipse_cases[]={
        ELLIPSE "let point=EllipseCurve_getPoint(6000,256,0.5);return ux_f64(6008);",
        ELLIPSE "return EllipseCurve_getLength(256,6000,divisions);",
        ELLIPSE "return 0.0+divisions;",
        ELLIPSE "return ux_f64(256+EllipseCurve.radiusY);",
    };
    // Chord sums for 200 equal polar-angle samples on the half curves.
    const double arc_gold[]={3,6.283120710969067,200,2};
    const double ellipse_gold[]={2,4.84417430774453,200,1};
    return g_wasm_batch(arc?"G_STRUCT ArcCurve JSON":"G_STRUCT EllipseCurve JSON",
        arc?"arc-curve-json":"ellipse-curve-json",modules,setup,arc?arc_cases:ellipse_cases,
        arc?arc_gold:ellipse_gold,4,mutate?0:-1,arc?
        "let changed=ux_f64_put(128+EllipseCurve.radiusX,3.0);" ARC
        "let point=ArcCurve_getPoint(6000,256,0.5);return ux_f64(6008);":
        "let changed=ux_f64_put(128+EllipseCurve.radiusY,3.0);" ELLIPSE
        "let point=EllipseCurve_getPoint(6000,256,0.5);return ux_f64(6008);");
}
