#pragma unisa use wasm_test_cache
#pragma unisa use g_math
#pragma unisa use r160_wait
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use text.fmt
#pragma unisa use text.text

#define BASE "ujs/practice/uxe/base/"
#define FIXTURE "ujs/practice/uxe/test/data-texture-image-json-"

static int compile(char **args,const char *phase,int seconds) {
    char *out=0;
    size_t bytes=0;
    const long start=sy_now_ms();
    const int rc=cx_runv_timeout(args,seconds,&out,&bytes);
    printf("DATA_TEXTURE_JSON %s ms=%ld rc=%d\n",phase,sy_now_ms()-start,rc);
    if(rc && out) printf("%.*s",(int)bytes,out);
    mm_free(out);
    return rc;
}

static int cached_base(const char *wasm,int prepare,int check) {
    const char *sources[]={FIXTURE "abi.ujs",BASE "f64-math.ujs",BASE "views.ujs",BASE "record-copy.ujs",
        BASE "gpu-packet.ujs",BASE "gpu-texture-table.ujs",BASE "texture-object.ujs",BASE "data-texture-object.ujs",
        BASE "helper-buffers.ujs",BASE "source.ujs",BASE "object-json-tokens.ujs",BASE "json-read.ujs",
        BASE "json-bytes.ujs",BASE "loaderutils.ujs",BASE "json-string-decode.ujs",BASE "source-json.ujs",
        BASE "source-json-read.ujs",BASE "data-texture-json.ujs",BASE "texture-parameters-json.ujs",FIXTURE "base.ujs",0};
    const char *cache=sy_env("UXE_TEXTURE_IMAGE_JSON_CACHE");
    if(!cache || !cache[0]) {
        printf("DATA_TEXTURE_JSON cache=missing env=UXE_TEXTURE_IMAGE_JSON_CACHE 基座缓存缺失：先运行准备步骤 --prepare\n");
        return 1;
    }
    char record[640],key[65],sha[65];
    if(wasm_test_cache_key(sources,key)) return 1;
    int len=tx_snprintf(record,sizeof record,"%s/%s.bin",cache,key);
    if(len<0 || len>=(int)sizeof record) return 2;
    int rc=wasm_test_cache_read(record,key,prepare?0:wasm,sha);
    if(!rc && !check) {
        printf("DATA_TEXTURE_JSON cache=hit key=%s sha=%s\n",key,sha);
        return 0;
    }
    if(rc==-ENOENT && (!prepare || check)) {
        printf("DATA_TEXTURE_JSON cache=missing key=%s 基座缓存缺失：先运行准备步骤 --prepare\n",key);
        return 1;
    }
    if(rc && rc!=-ENOENT) return 1;
    char *args[24]={"./ujs/ujs2wasm.com"};
    int n=0;
    while(sources[n]) { args[n+1]=(char *)sources[n]; n++; }
    args[n+1]="-o";
    args[n+2]=(char *)wasm;
    if(compile(args,"base_prepare",50)) return 1;
    return check?wasm_test_cache_verify(wasm,sha):wasm_test_cache_write(cache,record,key,wasm);
}

int main(int argc,char **argv) {
    const int prepare=argc>=2 && tx_eqz(argv[1],"--prepare");
    const int check=prepare && argc==3 && tx_eqz(argv[2],"--check");
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate && !(prepare && (argc==2 || check))) return 2;
    char dir[256],base[320],probe[320],page[320],url[360];
    if(sy_mkdtemp("/tmp","uxe-texture-image-json-",dir,sizeof dir)) return 2;
    tx_snprintf(base,sizeof base,"%s/base.wasm",dir);
    int failed=cached_base(base,prepare,check);
    if(!failed && !prepare) {
        tx_snprintf(probe,sizeof probe,"%s/probe.wasm",dir);
        tx_snprintf(page,sizeof page,"%s/probe.html",dir);
        tx_snprintf(url,sizeof url,"file://%s%s",page,mutate?"?mutate":"");
        char *args[]={"./ujs/ujs2wasm.com",FIXTURE "probe.ujs","-o",probe,0};
        double actual[15],ref[15];
        failed=compile(args,"probe",6) || sy_copy(FIXTURE "wasm.html",page,0600) ||
            r160_wait_ref("data-texture-image-json",ref,15,dir) ||
            r160_wait_read(url,"#wasm-cases",actual,15,dir);
        static const char json[]="{\"uuid\":\"i\",\"url\":{\"data\":[7,2,3,3,11,12,29,255],\"width\":2,\"height\":1,\"type\":\"Uint8Array\"}}";
        int digest=0;
        for(int i=0;json[i];i++) digest=(digest*131+(unsigned char)json[i])%16777213;
        const double expected[]={2,1,255,1,digest,1000,1002,1006,1008,1023,1009,1,0,1,4};
        if(!failed) for(int i=0;i<15;i++) {
            if(actual[i]!=expected[i] || ref[i]!=expected[i]) {
                printf("DATA_TEXTURE_JSON case=%d actual=%g r160=%g gold=%g\n",i,actual[i],ref[i],expected[i]);
                failed++;
            }
        }
    }
    if(sy_remove_all(dir)) failed++;
    printf("G_STRUCT DataTexture Source JSON linked prepare=%d cases=%d failed=%d\n",prepare,prepare?0:15,failed);
    return failed!=0;
}
