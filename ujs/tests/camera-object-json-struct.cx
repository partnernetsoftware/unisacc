#pragma unisa use g_wasm_batch
#pragma unisa use text.text

#define RESTORE "let written=Camera_toJSON(node,8000,1,8192,9216,9408);" \
    "let restored=Camera_fromJSON(target,8192,written,10800);if(restored<0){return 0.0+restored;}"

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    if(argc!=1 && !mutate) return 2;
    const char *modules[]={"f64-math","views","matrix4","object-layouts","object3d",
        "camera","json-read","json-bytes","loader-json","record-copy","camera-object-json",0};
    const char *setup="let arena=Object3D_initArena(0,6);let parent=Object3D_create(arena);"
        "let source=Object3D_create(arena);let copy=Object3D_create(arena);"
        "let node=Object3D_address(arena,source);let target=Object3D_address(arena,copy);"
        "let group=Object3D_add(arena,parent,source);"
        "let px=ux_f64_put(7800,5.0);let cx=ux_f64_put(7832,2.0);"
        "let rp=Object3D_setPosition(arena,parent,7800);"
        "let cp=Object3D_setPosition(arena,source,7832);"
        "let hidden=ux_u32_put(node+Object3D.visible,0);"
        "let layer=ux_u32_put(node+Object3D.layerMask,2147483648);"
        "let id=ux_u8_put(8000,99);let cam=Camera_init(6000,6400);"
        "let ready=Camera_syncObject(cam,arena,source);";
    const char *cases[]={
        "return ux_f64(ux_u32(cam+Camera.matrixWorldInverse)+96);",
        RESTORE "return ux_f64(ux_u32(target+Object3D.localMatrix)+96);",
        RESTORE "return 0.0+ux_u32(target+Object3D.visible);",
        RESTORE "return 0.0+ux_u32(target+Object3D.layerMask);",
        "let written=Camera_toJSON(node,8000,1,8192,9216,9408);"
        "return 0.0+Camera_fromJSON(target,8192,written-1,10800);",
    };
    const double gold[]={-7,2,0,2147483648.0,-2};
    return g_wasm_batch("G_STRUCT Camera object JSON","camera-object-json",modules,setup,cases,gold,5,
        mutate?2:-1,"let shown=ux_u32_put(node+Object3D.visible,1);" RESTORE
        "return 0.0+ux_u32(target+Object3D.visible);");
}
