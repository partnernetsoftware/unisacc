#pragma unisa use g_wasm_batch
#pragma unisa use text.text

int main(int argc,char **argv) {
    const int mutate=argc==2 && tx_eqz(argv[1],"--mutate");
    const int threshold=argc==2 && tx_eqz(argv[1],"--mutate-threshold");
    if(argc!=1 && !mutate && !threshold) return 2;
    const char *modules[]={"record-copy","f64-math","vector-scalar","color","image-layout","imageutils","image-source-linear",
        "image-display-size","image-base64","png-header","png-scanlines","png-bits","png-huffman","png-fixed","png-stored",
        "png-encode","jpeg-header","jpeg-entropy","jpeg-idct","jpeg-gray","jpeg-color","jpeg-encode-block","jpeg-encode",
        "image-data-url","image-display-url",0};
    const char *setup=
        "let a=ux_u32_put(ImageResource.rgba,512);let b=ux_u32_put(ImageResource.width,2);"
        "let c=ux_u32_put(ImageResource.height,1);let d=ux_u32_put(ImageResource.rowBytes,8);"
        "let black=ux_u32_put(512,4278190080);let white=ux_u32_put(516,4294967295);"
        "let raster=8192;if(selected_case==0){raster=65536;}"
        "let width=4;if(selected_case==3){width=1;}"
        "if(selected_case>=4){width=2049;if(selected_case==6){width=2048;}"
        "let ga=ux_u32_put(512,4286611584);let gb=ux_u32_put(516,4286611584);}"
        "let cap=4096;let space=8192;if(selected_case>=4){cap=65536;space=262144;}"
        "let length=ImageUtils_displayDataURL(0,width,1,raster,65536,cap,200000,space);";
    const char *cases[]={"return 0.0+length;","return 0.0+ux_u8(8192+ImageResource.size+8);",
        "return 0.0+length;","return 0.0+length;","return 0.0+length;",
        "return 0.0+length;","return 0.0+length;"};
    const double gold[]={-1,191,4,128,2049,128,2048};
    return g_wasm_batch_page("G_IO ImageUtils display dimensions in data URL","image-display-url",
        "ujs/practice/uxe/test/image-display-url-wasm.html",modules,setup,cases,gold,7,mutate?2:threshold?4:-1,
        threshold?"return 0.0+ImageUtils_displayDataURL(0,2048,1,raster,65536,cap,200000,space);":"return 0.0;");
}
