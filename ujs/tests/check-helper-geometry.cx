#pragma unisa use mem.heap

int main(void) {
    char *command[]={"sh","./unisacc.com","ujs/tools-ux/gen-helper-geometry.cx","--","--check",0,0};
    char *out=0;
    size_t size=0;
    const int clean=cx_runv_timeout(command,15,&out,&size);
    mm_free(out);
    out=0;
    command[5]="ujs/practice/uxe/base/helper-geometry.tsv";
    const int changed=cx_runv_timeout(command,15,&out,&size);
    mm_free(out);
    printf("CHECK_HELPER_GEOMETRY clean=%d changed=%d\n",clean,changed);
    return clean!=0 || changed!=1;
}
