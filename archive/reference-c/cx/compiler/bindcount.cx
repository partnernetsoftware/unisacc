#pragma unisa module bindcount
#pragma unisa use bindsym
/* Slot count of the runargs vector: 1 + argc - argstart.
   No libc and no include. xrealloc and the fill stay in
   exec/c/compiler.c. The result is that expression, including
   zero and negative values. The old assignment does not refuse them. */
int bx_run_count(int argc, int argstart) {
    return 1 + argc - argstart;
}
