#pragma unisa module optgate
/* Pure gates from src/opt.c. No libc and no include.
   sg_isctl and sg_islab stay in srcgate. A line span is out[ol_s, ol_e):
   the newline is not part of the length. Table walks, malloc, and rewrites
   stay in src/opt.c. A null pointer returns 4. */
static int og_al(int c) {
    if (c >= 97 && c <= 122) return 1;
    if (c >= 65 && c <= 90) return 1;
    if (c == 95) return 1;
    return 0;
}
static int og_di(int c) {
    if (c >= 48 && c <= 57) return 1;
    return 0;
}
static int og_bit(int mask, int z) {
    if (z < 0 || z > 30) return 0;
    return (mask & (1 << z)) != 0;
}
int og_reg(const char *s, int n) {
    int p, v;
    if (!s) return 4;
    if (n < 2 || (s[0] & 255) != 114) return -1;
    p = 1;
    v = 0;
    while (p < n) {
        if (!og_di(s[p] & 255)) return -1;
        v = v * 10 + (s[p] & 255) - 48;
        p = p + 1;
    }
    return v;
}
int og_is(const char *s, int n, const char *t) {
    int k;
    if (!s || !t) return 4;
    k = 0;
    while (t[k]) {
        if (k >= n || (s[k] & 255) != (t[k] & 255)) return 0;
        k = k + 1;
    }
    return k == n;
}
int og_pre(const char *s, int n, const char *t) {
    int k;
    if (!s || !t) return 4;
    k = 0;
    while (t[k]) {
        if (k >= n || (s[k] & 255) != (t[k] & 255)) return 0;
        k = k + 1;
    }
    return k;
}
int og_op_is(const char *s, int n, const char *w) {
    int k;
    if (!s || !w) return 4;
    if (n < 0) n = 0;
    k = 0;
    while (k < n) {
        if (w[k] == 0 || (s[k] & 255) != (w[k] & 255)) return 0;
        k = k + 1;
    }
    return w[k] == 0;
}
int og_word(const char *s, int n, const char *w) {
    int p, k;
    if (!s || !w) return 4;
    if (n <= 0 || (s[0] & 255) != 32) return 0;
    p = 2;
    k = 0;
    while (w[k]) {
        if (p + k >= n || (s[p + k] & 255) != (w[k] & 255)) return 0;
        k = k + 1;
    }
    if (p + k == n) return 1;
    return (s[p + k] & 255) == 32;
}
int og_push(const char *s, int n) {
    int k;
    if (!s) return 4;
    k = og_pre(s, n, "  store64 [r7+0], ");
    if (k == 0) return -1;
    return og_reg(s + k, n - k);
}
int og_pop(const char *s, int n) {
    int q, k;
    const char *suf;
    if (!s) return 4;
    if (og_pre(s, n, "  load64 ") == 0) return -1;
    q = 9;
    while (q < n && (s[q] & 255) != 44) q = q + 1;
    if (n - q != 8 || q < 9) return -1;
    suf = ", [r7+0]";
    k = 0;
    while (k < 8) {
        if ((s[q + k] & 255) != (suf[k] & 255)) return -1;
        k = k + 1;
    }
    return og_reg(s + 9, q - 9);
}
int og_names(const char *s, int n, int r) {
    int p, v;
    if (!s) return 4;
    if (n < 0) n = 0;
    p = 0;
    while (p < n) {
        if ((s[p] & 255) == 114 && (p == 0 || !og_al(s[p - 1] & 255)) && p + 1 < n && og_di(s[p + 1] & 255)) {
            v = 0;
            p = p + 1;
            while (p < n && og_di(s[p] & 255)) {
                v = v * 10 + (s[p] & 255) - 48;
                p = p + 1;
            }
            if (v == r) return 1;
            continue;
        }
        p = p + 1;
    }
    return 0;
}
int og_mask(const char *s, int n) {
    int p, v, m;
    if (!s) return 4;
    if (n < 0) n = 0;
    p = 0;
    m = 0;
    while (p < n) {
        if ((s[p] & 255) == 114 && (p == 0 || !og_al(s[p - 1] & 255)) && p + 1 < n && og_di(s[p + 1] & 255)) {
            v = 0;
            p = p + 1;
            while (p < n && og_di(s[p] & 255)) {
                v = v * 10 + (s[p] & 255) - 48;
                p = p + 1;
            }
            if (v < 16) m = m | (1 << v);
            continue;
        }
        p = p + 1;
    }
    return m;
}
int og_firstreg(const char *s, int n) {
    int p, v;
    if (!s) return 4;
    if (n < 0) n = 0;
    p = 2;
    while (p < n && (s[p] & 255) != 32) p = p + 1;
    while (p < n) {
        if ((s[p] & 255) == 114 && !og_al(s[p - 1] & 255) && p + 1 < n && og_di(s[p + 1] & 255)) {
            v = 0;
            p = p + 1;
            while (p < n && og_di(s[p] & 255)) {
                v = v * 10 + (s[p] & 255) - 48;
                p = p + 1;
            }
            return v;
        }
        if ((s[p] & 255) == 91) return -1;
        p = p + 1;
    }
    return -1;
}
int og_writes(const char *s, int n, int z) {
    int p, v, first;
    if (!s) return 4;
    if (og_word(s, n, "store64") || og_word(s, n, ".st")) return 0;
    if (og_firstreg(s, n) != z) return 0;
    if (n < 0) n = 0;
    p = 2;
    first = 1;
    while (p < n && (s[p] & 255) != 32) p = p + 1;
    while (p < n) {
        if ((s[p] & 255) == 114 && !og_al(s[p - 1] & 255) && p + 1 < n && og_di(s[p + 1] & 255)) {
            v = 0;
            p = p + 1;
            while (p < n && og_di(s[p] & 255)) {
                v = v * 10 + (s[p] & 255) - 48;
                p = p + 1;
            }
            if (first == 0 && v == z) return 0;
            first = 0;
            continue;
        }
        p = p + 1;
    }
    return 1;
}
int og_kind(const char *s, int n, int simple) {
    int w, wn;
    if (!s) return 4;
    if (n <= 0 || (s[0] & 255) != 32) return 1;
    w = 2;
    wn = 0;
    while (w + wn < n && (s[w + wn] & 255) != 32) wn = wn + 1;
    if (og_op_is(s + w, wn, "ret")) return 2;
    if (og_op_is(s + w, wn, "jump")) return 3;
    if (og_op_is(s + w, wn, "jumpz")) return 4;
    if (og_op_is(s + w, wn, "call")) return 5;
    if (og_op_is(s + w, wn, ".frame")) return 6;
    if (simple && n >= 3 && (s[1] & 255) == 32) return 0;
    /* 不是旧返回 */
    return -1;
}
/* store64 和 .st 的 first 传 -1，和 ol_prep 一样。 */
int og_facts(const char *s, int n, int *mask, int *first, int *again) {
    int p, v, m, f, fst, saw, ag;
    if (!s || !mask || !first || !again) return 4;
    if (n < 0) n = 0;
    p = 2;
    while (p < n && (s[p] & 255) != 32) p = p + 1;
    m = 0;
    f = -1;
    fst = 1;
    saw = 0;
    ag = 0;
    while (p < n) {
        if ((s[p] & 255) == 91) saw = 1;
        if ((s[p] & 255) == 114 && p > 0 && !og_al(s[p - 1] & 255) && p + 1 < n && og_di(s[p + 1] & 255)) {
            v = 0;
            p = p + 1;
            while (p < n && og_di(s[p] & 255)) {
                v = v * 10 + (s[p] & 255) - 48;
                p = p + 1;
            }
            if (v < 16) m = m | (1 << v);
            if (fst) {
                if (saw == 0) f = v;
                fst = 0;
            } else if (f >= 0 && v == f) ag = 1;
            continue;
        }
        p = p + 1;
    }
    *mask = m;
    *first = f;
    *again = ag;
    return 0;
}
int og_rw(int kind, int mask, int first, int again, int *rm, int *wm) {
    int bit;
    if (!rm || !wm) return 4;
    if (kind < 0 || kind > 7) {
        /* 不是旧返回 */
        return 2;
    }
    *wm = 0;
    if (kind == 4) {
        *rm = mask;
        return 0;
    }
    if (kind == 0) {
        if (first < -1 || first > 30) {
            /* 不是旧返回 */
            return 2;
        }
        if (first < 0) {
            *rm = mask;
            return 0;
        }
        bit = 1 << first;
        *wm = bit;
        *rm = mask & ~bit;
        if (again) *rm = *rm | bit;
        return 0;
    }
    if (kind == 7) {
        *rm = 255;
        return 0;
    }
    *rm = 0;
    return 0;
}
/* 1 活，0 死，3 接着看下一行。 */
int og_scan(int kind, int z, int rm, int wm, int tgt, int seen) {
    if (kind < 0 || kind > 7) {
        /* 不是旧返回 */
        return 2;
    }
    if (kind == 1) return seen ? 1 : 0;
    if (kind == 2) return z <= 1;
    if (kind == 3) {
        if (tgt < 0) return 1;
        return seen ? 1 : 0;
    }
    if (kind == 4) {
        if (og_bit(rm, z)) return 1;
        if (tgt < 0) return 1;
        if (seen) return 1;
        return 3;
    }
    if (kind == 5) {
        if (tgt < 0) return 1;
        if (seen) return 1;
        return 3;
    }
    if (kind == 6) return 3;
    if (og_bit(rm, z)) return 1;
    if (og_bit(wm, z)) return 0;
    return 3;
}
int og_last(const char *s, int n) {
    int p;
    if (!s) return 4;
    if (n < 0) n = 0;
    p = n;
    while (p > 0 && (s[p - 1] & 255) != 32) p = p - 1;
    return p;
}
int og_same(const char *a, int n, const char *b, int m) {
    int i;
    if (n < 0) n = 0;
    if (m < 0) m = 0;
    if (n != m) return 0;
    if (n == 0) return 1;
    if (!a || !b) return 4;
    i = 0;
    while (i < n) {
        if ((a[i] & 255) != (b[i] & 255)) return 0;
        i = i + 1;
    }
    return 1;
}
int og_lab_slot(const char *name, int n) {
    int h, k;
    if (!name) return 4;
    if (n < 0) n = 0;
    h = n;
    k = 0;
    while (k < n) {
        h = (h * 31 + (name[k] & 255)) & 16777215;
        k = k + 1;
    }
    h = h & 4095;
    h = h * 16 + (n & 15);
    return h & 65535;
}
int og_lab_hit(const char *name, int n, const char *text, int m) {
    int k;
    if (!name || !text) return 4;
    if (n < 0 || m < n + 1) return 0;
    k = 0;
    while (k < n && (text[k] & 255) == (name[k] & 255)) k = k + 1;
    if (k == n && (text[k] & 255) == 58) return 1;
    return 0;
}
int og_store(const char *s, int n, int *m0, int *m1) {
    int p, q;
    if (!s || !m0 || !m1) return 4;
    if (og_pre(s, n, "  store64 [") == 0) return -1;
    p = 11;
    q = p;
    while (q < n && (s[q] & 255) != 93) q = q + 1;
    if (q + 3 >= n || (s[q + 1] & 255) != 44 || (s[q + 2] & 255) != 32) return -1;
    *m0 = p;
    *m1 = q;
    return og_reg(s + q + 3, n - (q + 3));
}
int og_load(const char *s, int n, int *n0, int *n1) {
    int p, q, y;
    if (!s || !n0 || !n1) return 4;
    if (og_pre(s, n, "  load64 ") == 0) return -1;
    p = 9;
    q = p;
    while (q < n && (s[q] & 255) != 44) q = q + 1;
    y = og_reg(s + p, q - p);
    if (y < 0 || q + 3 >= n || (s[q + 1] & 255) != 32 || (s[q + 2] & 255) != 91 || (s[n - 1] & 255) != 93) return -1;
    *n0 = q + 3;
    *n1 = n - 1;
    return y;
}
int og_imm(const char *s, int n, long long *v) {
    int p, q, reg;
    long long x;
    if (!s || !v) return 4;
    if (og_pre(s, n, "  imm r") == 0) return -1;
    p = 6;
    q = p;
    while (q < n && (s[q] & 255) != 44) q = q + 1;
    reg = og_reg(s + p, q - p);
    if (reg < 0 || q + 2 >= n || (s[q + 1] & 255) != 32) return -1;
    q = q + 2;
    if (n - q > 18 || q >= n) return -1;
    x = 0;
    while (q < n) {
        if (!og_di(s[q] & 255)) return -1;
        x = x * 10 + (long long)((s[q] & 255) - 48);
        q = q + 1;
    }
    *v = x;
    return reg;
}
int og_three(const char *s, int n, int *d, int *sr, int *t) {
    int p, q, a, b, c;
    if (!s || !d || !sr || !t) return 4;
    if (n <= 0 || (s[0] & 255) != 32) return 0;
    p = 2;
    while (p < n && (s[p] & 255) != 32) p = p + 1;
    if (p >= n) return 0;
    p = p + 1;
    q = p;
    while (q < n && (s[q] & 255) != 44) q = q + 1;
    a = og_reg(s + p, q - p);
    if (a < 0 || q + 2 >= n) return 0;
    p = q + 2;
    q = p;
    while (q < n && (s[q] & 255) != 44) q = q + 1;
    b = og_reg(s + p, q - p);
    if (b < 0 || q + 2 >= n) return 0;
    c = og_reg(s + q + 2, n - (q + 2));
    if (c < 0) return 0;
    *d = a;
    *sr = b;
    *t = c;
    return 1;
}
int og_movat(const char *s, int n, int *d, int *sr) {
    int p, q, a, b;
    if (!s || !d || !sr) return 4;
    if (og_pre(s, n, "  mov r") == 0) return 0;
    p = 6;
    q = p;
    while (q < n && (s[q] & 255) != 44) q = q + 1;
    a = og_reg(s + p, q - p);
    if (a < 0 || q + 2 >= n) return 0;
    b = og_reg(s + q + 2, n - (q + 2));
    if (b < 0) return 0;
    *d = a;
    *sr = b;
    return 1;
}
int og_pow2(unsigned long long v) {
    if (v == 0 || v == 1) return 0;
    return (v & (v - 1ull)) == 0ull;
}
int og_cut(int first) {
    return (first & 255) != 32;
}
