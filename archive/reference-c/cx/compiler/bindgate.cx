#pragma unisa module bindgate
/* Dependency-write gate. No libc and no include.
   cxd_write, the .d concatenation, and the deponly name choice stay in
   exec/c/compiler.c. A null deps pointer stays outside. Any other pointer,
   including an empty string, enters when deponly is nonzero or when mode
   is neither 1 nor 4 and runit is zero. */
int bx_dep_gate(const char *deps, int deponly, int mode, int runit) {
    if (!deps) return 0;
    if (deponly) return 1;
    if (mode != 1 && mode != 4 && !runit) return 1;
    return 0;
}
