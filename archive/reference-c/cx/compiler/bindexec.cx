#pragma unisa module bindexec
#pragma unisa use bindargs
/* Whether execrun calls forward_exec. No libc and no include.
   The use above does not call bindargs. The unit check already has
   32 uses, so this use pulls bindargs into that program.
   forward_exec stays in exec/c/compiler.c. The call exists only
   inside __linux__. Any nonzero execrun takes that call. Zero
   continues. The earlier fwd_exec && runit assignment, and the
   later stores that set execrun, stay in C. */
int bx_exec_forward(int execrun) {
    if (execrun) return 0;
    return 1;
}
