#pragma unisa module bindfilter
/* Null-path provider mask. No libc and no include.
   fopen, fread, fclose, and host_provider_filter stay in exec/c/bind.c.
   A null path writes mask 15 and returns 0. target is not used.
   A non-null path, including an empty string, returns 2 and does not
   write the mask. That code is not a return of host_filter_file. */
int bx_filter_none(const char *path, unsigned target, unsigned *mask) {
    (void)target;
    if (!mask) return 4;
    if (path) return 2;
    *mask = 15;
    return 0;
}
