#pragma unisa module binddep
/* Dependency-path length. No libc and no include.
   The memcpy that writes the stem, the '.', and the 'd' stays in
   exec/c/compiler.c. depname is 4096 bytes. The gate is
   dot - b + 3 > cap. A slash resets the dot to the end. The basename
   start moves only when the output path is absent. */
int bx_dep_mark(const char *base, int use_out, int *b_out, int *dot_out) {
    int len, k, dot, b;
    if (!base || !b_out || !dot_out) return 4;
    len = 0;
    while (base[len]) len++;
    dot = len;
    b = 0;
    for (k = 0; k < len; k++) {
        if (base[k] == '/') {
            dot = len;
            if (!use_out) b = k + 1;
        } else if (base[k] == '.') {
            dot = k;
        }
    }
    *b_out = b;
    *dot_out = dot;
    return 0;
}
int bx_dep_len(int dot, int b, int cap) {
    if (b < 0 || dot < b || cap < 1) return 4;
    if (dot - b > cap - 3) return 1;
    return 0;
}
const char *bx_dep_why(void) {
    return "bind: dependency path too long";
}
