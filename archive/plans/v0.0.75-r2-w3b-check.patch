+/* 1 when ELF object PATH defines NAME (section index != 0), 0 when it only refers to it or
+   lacks it, -1 when the object cannot be read. */
+static unsigned long long le(const unsigned char *p, int n) {
+    unsigned long long v = 0; int i; for (i = n - 1; i >= 0; i--) v = v << 8 | p[i]; return v;
+}
+static int defines(const char *path, const char *name) {
+    unsigned char *b; long n = slurp(path, &b); int r = 0; size_t nl = strlen(name);
+    if (n < 64 || memcmp(b, "\177ELF\2\1", 6) || le(b + 58, 2) != 64) { free(b); return -1; }
+    unsigned long long sho = le(b + 40, 8), shn = le(b + 60, 2), i, j;
+    if (sho > (unsigned long long)n || shn > ((unsigned long long)n - sho) / 64) { free(b); return -1; }
+    for (i = 0; i < shn; i++) {
+        const unsigned char *s = b + sho + i * 64;
+        if (le(s + 4, 4) != 2) continue;                                   /* SHT_SYMTAB */
+        unsigned long long so = le(s + 24, 8), ss = le(s + 32, 8), lk = le(s + 40, 4);
+        if (lk >= shn || so > (unsigned long long)n || ss > (unsigned long long)n - so) { free(b); return -1; }
+        const unsigned char *t = b + sho + lk * 64;
+        unsigned long long to = le(t + 24, 8), ts = le(t + 32, 8);
+        if (to > (unsigned long long)n || ts > (unsigned long long)n - to) { free(b); return -1; }
+        for (j = 0; j + 24 <= ss; j += 24) {
+            const unsigned char *y = b + so + j; unsigned long long nm = le(y, 4);
+            if (nm + nl + 1 > ts || memcmp(b + to + nm, name, nl + 1)) continue;
+            if (le(y + 6, 2) != 0) r = 1; else if (!r) r = 2;              /* st_shndx */
+        }
+    }
+    free(b);
+    return r == 2 ? 0 : r;
+}
