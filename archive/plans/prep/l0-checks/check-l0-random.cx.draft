/* red draft: entropy. sy_random(buf,n) fills n bytes; two calls differ; n=0 returns 0; n>256 loops internally.
   Linux getrandom(2); osx getentropy (<=256 per call); win BCryptGenRandom or -ENOSYS.
   Oracle: /dev/urandom read (tools/tls13-get.cx path) plus a byte-histogram sanity bound. */
#pragma unisa use sys.posix
int main(void) {
    unsigned char a[300], b[300];
    int r1 = sy_random(a, 300), r2 = sy_random(b, 300), d = 0, i;
    for (i = 0; i < 300; i++) d |= a[i] ^ b[i];
    int ok = r1 == 300 && r2 == 300 && d && sy_random(a, 0) == 0;
    printf("CHECK_L0_RANDOM %s\n", ok ? "PASS" : "FAIL");
    return !ok;
}
