/* red draft: mtime nanoseconds. sy_utimes(p, .., mtime_s=1700000000, mtime_ns=123456789) then sy_stat: mtime_ns == 123456789.
   Oracle: stat -c %Y.%y / st_mtim.tv_nsec (linux), st_mtimespec (osx), FILETIME*100 (win, 100ns granularity). */
#pragma unisa use sys.fs
#pragma unisa use sys.posix
int main(void) {
    const char *p = "/tmp/l0-mtime-ns.probe";
    sy_stat_t s;
    sy_write_file(p, "x", 1, 0644);
    sy_utimes(p, 1700000000, 0, 1700000000, 123456789);
    int r = sy_stat(p, &s);
    int ok = r == 0 && s.mtime == 1700000000 && s.mtime_ns == 123456789;
    sy_unlink(p);
    printf("CHECK_L0_MTIME_NS %s\n", ok ? "PASS" : "FAIL");
    return !ok;
}
