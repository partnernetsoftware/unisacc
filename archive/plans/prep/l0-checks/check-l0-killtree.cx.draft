/* red draft: deadline path kills the tree. Child escapes a grandchild by setsid (sleep 30), then sleeps; deadline 300ms
   with SY_SPAWN_KILL_TREE must leave no live grandchild. Today sy_proc_wait kills only the process group (c->h), and
   sy_kill_tree lives in ext/sysx/process.cx (L1) under an sy_ name. Oracle: ps -o pid= --sid after the run is empty. */
#pragma unisa use sys.proc
int main(void) {
    sy_spawn_t o; sy_exit_t st;
    char *a[] = {"sh", "-c", "setsid sleep 30 & sleep 30", 0};
    sy_spawn_init(&o); o.argv = a; o.pgroup = -1; o.deadline_ms = 300; o.flags |= SY_SPAWN_KILL_TREE;
    int r = sy_proc_run(&o, &st);
    int ok = r == 0 && st.timed_out && st.tree_left == 0;
    printf("CHECK_L0_KILLTREE %s\n", ok ? "PASS" : "FAIL");
    return !ok;
}
