/* red draft: sy_syscall6 privileged entry. Oracle: getpid via raw number equals sy_pid(); bad nr -> -ENOSYS (-38). */
#pragma unisa use sys.posix
#pragma unisa use sys.env
int main(void) {
    long p = sy_syscall6(SY_NR_GETPID, 0, 0, 0, 0, 0, 0);
    long bad = sy_syscall6(-1, 0, 0, 0, 0, 0, 0);
    int ok = (p == (long)sy_pid()) && (bad == -38);
    printf("CHECK_L0_SYSCALL6 %s\n", ok ? "PASS" : "FAIL");
    return !ok;
}
