/* red draft: wait set. Spawn 3 children exiting 3,4,5; sy_wait_any reaps all in any order, then -ECHILD (-10);
   SY_WAIT_NOHANG returns 0 while one still runs. Oracle: POSIX waitpid(-1,..,WNOHANG) / waitid(P_ALL). */
#pragma unisa use sys.proc
int main(void) {
    char *a0[] = {"sh", "-c", "exit 3", 0}, *a1[] = {"sh", "-c", "exit 4", 0}, *a2[] = {"sh", "-c", "sleep 0.3; exit 5", 0};
    int i, sum = 0, ex, code, sig, r, got = 0;
    sy_spawn(a0); sy_spawn(a1); sy_spawn(a2);
    r = sy_wait_any(SY_WAIT_NOHANG, &ex, &code, &sig);
    if (r > 0 && ex) { sum += code; got++; }
    while (got < 3) { r = sy_wait_any(0, &ex, &code, &sig); if (r <= 0) break; if (ex) sum += code; got++; }
    int ok = got == 3 && sum == 12 && sy_wait_any(0, &ex, &code, &sig) == -10;
    printf("CHECK_L0_WAITSET %s\n", ok ? "PASS" : "FAIL");
    return !ok;
}
