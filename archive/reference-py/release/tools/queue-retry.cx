 if(!apply){b=wire(out,&wn);printf("%.*s\n",(int)wn,b);return 0;}ck(!strcmp(argv[5],approved),"apply same pre-state/proposal SHA required");const char*archive=argv[6];char parent[4096];snprintf(parent,sizeof parent,"%s",archive);char*slash=strrchr(parent,'/');ck(slash&&slash!=parent,"absolute archive parent");*slash=0;char ap[4096];ck(realpath(parent,ap)!=0,"archive parent");ck(strcmp(ap,STATE)&&strncmp(ap,STATE,strlen(STATE))!=0,"archive outside state");ck(!mkdir(archive,0700),"new archive required");save(path(archive,"results.before.json"),original,original_n);
