/* Native same-identity queue recovery; qualified only for Linux/x86_64 F4.
 * Usage (default dry-run):
 *   sh ./unisacc.com release/tools/queue-retry.cx -- ROOT STATE FAILED_SUITE
 * Apply only the reviewed dry proposal, with an absent archive path:
 *   ... ROOT STATE FAILED_SUITE --apply PROPOSAL_SHA NEW_ARCHIVE
 * Hold the original ROOT/path/source, candidate pair, UA, provider and execution
 * environment fixed. The parent must independently verify repaired inputs; this
 * tool preserves stored stamps and does not reconstruct all queue fingerprints.
 * No passed result, executed dependent, permanent history or attempt is cleared.
 * The complete archive is intent, not proof of commit: after interruption compare
 * live results SHA with its archived before/after images before deciding recovery.
 * --crash-after-archive is a private fixture fault-injection option, not a retry.
 * Mechanical port of reviewed014eda4; canonical JSON module replaces private copy.
 */
/* Same-identity narrow retry. Reads source/queue; writes only explicit apply target/archive.
 * Dry-run is default. Fixture controls use no real queue. Linux/POSIX flock protocol. */
#include <cx.h>
#include <sys/file.h>
#include "../../tests/cxlib/pyjson.cx"
static pj_value*RS;static int LOCK=-1,COMMITTED;static char NEW_SHA[65];static const char*ROOT,*STATE;
static void fail(const char*w){fprintf(stderr,"RETRY %s %s\n",COMMITTED?"COMMITTED — DO NOT RETRY":"REFUSED",w);if(COMMITTED)fprintf(stderr,"committed_results_sha256=%s\n",NEW_SHA);exit(2);}
static void ck(int ok,const char*w){if(!ok)fail(w);}
static char*path(const char*a,const char*b){char*p=malloc(strlen(a)+strlen(b)+2);ck(p!=0,"allocation");sprintf(p,"%s/%s",a,b);return p;}
static int hex(const char*s){return s&&strlen(s)==64&&strspn(s,"0123456789abcdef")==64;}
static char*readbound(const char*p,size_t*n,int optional){struct stat a,z;errno=0;if(lstat(p,&a)){if(optional&&errno==ENOENT){pj_value*o=pj_get(RS,p);ck(!o||o->type==PJ_NULL,"missing input drift");pj_set(RS,p,pj_null());if(n)*n=0;return 0;}fail(p);}ck(S_ISREG(a.st_mode),"regular nonsymlink input");size_t len;char*b=cx_read(p,&len);ck(b&&len==(size_t)a.st_size&&!lstat(p,&z)&&a.st_dev==z.st_dev&&a.st_ino==z.st_ino&&a.st_size==z.st_size&&a.st_mtime==z.st_mtime&&a.st_ctime==z.st_ctime,"stable input read");char h[65];cx_sha256_hex(b,len,h);pj_value*old=pj_get(RS,p);ck(!old||(old->type==PJ_STR&&!strcmp(old->s,h)),"input drift");pj_set(RS,p,pj_strz(h));if(n)*n=len;return b;}
static pj_value*json(const char*p){size_t n;char*b=readbound(p,&n,0),why[300];pj_value*j=pj_loads(b,n,why,sizeof why);ck(j&&j->type==PJ_OBJ,"JSON object");return j;}
static const char*str(pj_value*v){ck(v&&v->type==PJ_STR&&v->n==strlen(v->s),"string");return v->s;}
static void sort(pj_value*v){if(v->type==PJ_ARR){for(size_t i=0;i<v->len;i++)sort(v->items[i]);return;}if(v->type!=PJ_OBJ)return;for(size_t i=1;i<v->len;i+=2)sort(v->items[i]);for(size_t i=2;i<v->len;i+=2)for(size_t j=i;j>=2&&strcmp(v->items[j-2]->s,v->items[j]->s)>0;j-=2){pj_value*k=v->items[j],*a=v->items[j+1];v->items[j]=v->items[j-2];v->items[j+1]=v->items[j-1];v->items[j-2]=k;v->items[j-1]=a;}}
static char*wire(pj_value*j,size_t*n){char*b;ck(!pj_dumps(j,-1,&b,n),"JSON encode");return b;}
static void hashjson(pj_value*j,char h[65]){size_t n;char*b=wire(j,&n);cx_sha256_hex(b,n,h);free(b);}
static void recheck(void){size_t n=RS->len;for(size_t i=0;i<n;i+=2)readbound(RS->items[i]->s,0,RS->items[i+1]->type==PJ_NULL);}
static int blocked(pj_value*r){pj_value*a=r?pj_get(r,"rc"):0,*b=r?pj_get(r,"seconds"):0,*c=r?pj_get(r,"limit"):0;return r&&r->type==PJ_OBJ&&r->len==6&&a&&b&&c&&a->type==PJ_INT&&b->type==PJ_INT&&c->type==PJ_INT&&pj_eq_int(a,1)&&pj_eq_int(b,0)&&pj_eq_int(c,0);}
static int red(pj_value*r){pj_value*v=r?pj_get(r,"rc"):0;return v&&v->type==PJ_INT&&!pj_eq_int(v,0);}
/* Actual executions have positive finite seconds and positive queue limits.
   A timed-out child may finish cleanup just after its limit, so do not require
   seconds<=limit. The queue admits windows<=55s; the outer contract is<=60s. */
static int positive_number(pj_value*v,double maximum){
    if(!v||(v->type!=PJ_INT&&v->type!=PJ_FLOAT))return 0;
    double value;if(v->type==PJ_FLOAT)value=v->d;
    else {char*end;errno=0;value=strtod(v->s,&end);if(errno||*end)return 0;}
    return value>0.0&&value<=maximum; /* also rejects NaN and both infinities */
}
static int safe(const char*s){if(!*s)return 0;for(;*s;s++)if(!((*s>='a'&&*s<='z')||(*s>='A'&&*s<='Z')||(*s>='0'&&*s<='9')||*s=='-'||*s=='_'))return 0;return 1;}
static void save(const char*p,const void*b,size_t n){size_t expected=n;int f=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW,0600);ck(f>=0,"exclusive output create");const char*s=b;while(n){ssize_t k=write(f,s,n);if(k<0&&errno==EINTR)continue;ck(k>0,"write");s+=k;n-=k;}ck(!fsync(f)&&!close(f),"output fsync");size_t actual;char*check=cx_read(p,&actual);ck(check&&actual==expected&&!memcmp(check,b,expected),"archived bytes readback");free(check);}
static void savejson(const char*p,pj_value*j){size_t n;char*b=wire(j,&n);save(p,b,n);free(b);}
static void syncdir(const char*p){int f=open(p,O_RDONLY|O_DIRECTORY|O_NOFOLLOW,0);ck(f>=0&&!fsync(f)&&!close(f),"directory fsync");}
static void acquire(void){char*p=path(STATE,"lock");LOCK=open(p,O_RDWR|O_NOFOLLOW|O_CLOEXEC,0);ck(LOCK>=0,"existing queue lock open");struct stat a,b;ck(!fstat(LOCK,&a)&&S_ISREG(a.st_mode)&&!lstat(p,&b)&&a.st_dev==b.st_dev&&a.st_ino==b.st_ino,"queue lock inode");/* flock is the SAME lock namespace as gatequeue.py. No errno bridge assumptions. */ck(flock(LOCK,LOCK_EX|LOCK_NB)==0,"exclusive queue flock busy/error");}
static const char*physical(const char*p){return !strncmp(p,"/mnt/",5)?path(ROOT,p+5):p;}
/* gatequeue.py portable()/k2b_output_digest: surrogateescape round-trip is
   lossless, so literal UTF-8 path replacement can operate on byte spans.
   No newline conversion, invalid-byte replacement or strlen(log): NUL is data.
   This helper's qualified execution view is F4 /mnt (physical ROOT is outside).
   Equal-length aliases retain PATH_KEYS order, as Python's stable sort does. */
static void queue_log_hash(const char*log,size_t n,pj_value*vars,char out[65]){
    const char*keys[]={"MODEL_COM","UA","UA_RUN","TOOLS_UA","CORPUS_UA","UNISA_CONTAINER","UNISA_KERNEL","UNISACC_FFI_PROVIDER","UNISACC_FFI_X86_PROVIDER","SEED_DIR",0};
    struct {const char*from,*to;} pairs[22];int count=0;
    for(int i=0;keys[i];i++){
        pj_value*v=pj_get(vars,keys[i]);if(!v)continue;const char*raw=str(v);if(!strchr(raw,'/'))continue;
        char*to=malloc(strlen(keys[i])+3);ck(to!=0,"path alias allocation");sprintf(to,"{%s}",keys[i]);pairs[count].from=raw;pairs[count++].to=to;
        char resolved[4096];if(realpath(physical(raw),resolved)){
            const char*logical=resolved;size_t rn=strlen(ROOT);
            if(!strncmp(raw,"/mnt/",5)){ck(!strncmp(resolved,ROOT,rn)&&(resolved[rn]=='/'||!resolved[rn]),"F4 selector resolves outside ROOT");logical=resolved[rn]?path("/mnt",resolved+rn+1):"/mnt";}
            if(strcmp(logical,raw)){pairs[count].from=strdup(logical);pairs[count++].to=to;}
        }
    }
    pairs[count].from="/mnt";pairs[count++].to="{ROOT}";
    for(int i=1;i<count;i++)for(int j=i;j>0&&strlen(pairs[j-1].from)<strlen(pairs[j].from);j--){const char*f=pairs[j].from,*t=pairs[j].to;pairs[j]=pairs[j-1];pairs[j-1].from=f;pairs[j-1].to=t;}
    char*b=malloc(n+1);ck(b!=0,"log allocation");memcpy(b,log,n);b[n]=0;
    for(int k=0;k<count;k++){size_t a=strlen(pairs[k].from),z=strlen(pairs[k].to),hits=0,i=0;ck(a>0,"empty log selector");while(i<n){if(a<=n-i&&!memcmp(b+i,pairs[k].from,a)){hits++;i+=a;}else i++;}ck(z<=a||hits<=((size_t)-1-n-1)/(z-a),"log fold overflow");size_t nn=n-hits*a+hits*z;char*c=malloc(nn+1),*w=c;ck(c!=0,"log fold allocation");i=0;while(i<n){if(a<=n-i&&!memcmp(b+i,pairs[k].from,a)){memcpy(w,pairs[k].to,z);w+=z;i+=a;}else *w++=b[i++];}c[nn]=0;free(b);b=c;n=nn;}
    cx_sha256_hex(b,n,out);free(b);
}
static size_t white(const char*b,size_t n,size_t p){while(p<n&&(b[p]==' '||b[p]=='\n'||b[p]=='\r'||b[p]=='\t'))p++;return p;}
static size_t quoted(const char*b,size_t n,size_t p){ck(p<n&&b[p]=='"',"raw string");for(p++;p<n;p++){if(b[p]=='\\'){p++;ck(p<n,"escape");}else if(b[p]=='"')return p+1;}fail("unterminated string");return 0;}
static size_t value_end(const char*b,size_t n,size_t p){p=white(b,n,p);ck(p<n,"raw value");if(b[p]=='"')return quoted(b,n,p);if(b[p]=='{'||b[p]=='['){int depth=0;for(;p<n;p++){if(b[p]=='"'){p=quoted(b,n,p)-1;continue;}if(b[p]=='{'||b[p]=='[')depth++;else if(b[p]=='}'||b[p]==']'){if(!--depth)return p+1;}}fail("raw nesting");}while(p<n&&b[p]!=','&&b[p]!='}'&&b[p]!=']'&&b[p]!=' '&&b[p]!='\n'&&b[p]!='\r'&&b[p]!='\t')p++;return p;}
static char*rawsplice(const char*b,size_t n,pj_value*chosen,size_t*outn){size_t p=white(b,n,0),begin=0,end=0;ck(b[p++]=='{',"raw root");int hits=0;while((p=white(b,n,p))<n&&b[p]!='}'){size_t k=p,ke=quoted(b,n,p);char why[200];pj_value*key=pj_loads(b+k,ke-k,why,sizeof why);p=white(b,n,ke);ck(b[p++]==':',"raw colon");p=white(b,n,p);size_t e=value_end(b,n,p);if(!strcmp(str(key),"results")){begin=p;end=e;hits++;}p=white(b,n,e);if(b[p]==',')p++;else ck(b[p]=='}',"raw top separator");}ck(hits==1&&b[begin]=='{'&&b[end-1]=='}',"unique raw results");char*out=malloc(n+1);ck(out!=0,"raw allocation");memcpy(out,b,begin+1);size_t z=begin+1;p=begin+1;int kept=0,removed=0;while(white(b,n,p)<end-1){size_t start=p,k=white(b,n,p),ke=quoted(b,n,k);char why[200];pj_value*key=pj_loads(b+k,ke-k,why,sizeof why);p=white(b,n,ke);ck(b[p++]==':',"member colon");size_t e=white(b,n,value_end(b,n,p));if(!pj_get(chosen,str(key))){if(kept++)out[z++]=',';memcpy(out+z,b+start,e-start);z+=e-start;}else removed++;p=e;if(b[p]==',')p++;else ck(p==end-1,"member separator");}ck(removed==(int)chosen->len/2,"raw exact removal count");memcpy(out+z,b+end-1,n-(end-1));z+=n-(end-1);out[z]=0;*outn=z;return out;}
int main(int argc,char**argv){
#if !defined(__linux__) || !defined(__x86_64__)
fail("only verified Linux/x86_64 queue flock protocol supported");
#endif
if(argc!=4&&argc!=7&&argc!=8)fail("ROOT STATE FAILED_SUITE [--apply PROPOSAL_SHA NEW_ARCHIVE [--crash-after-archive]]");char root[4096],state[4096];ck(realpath(argv[1],root)&&realpath(argv[2],state),"ROOT/STATE existing realpath");ROOT=root;STATE=state;const char*target=argv[3];ck(safe(target),"safe target");int apply=argc>=7,crash=argc==8;if(apply)ck(!strcmp(argv[4],"--apply")&&hex(argv[5])&&(!crash||!strcmp(argv[7],"--crash-after-archive")),"apply arguments");RS=pj_dict();char self[4096];ck(realpath(argv[0],self)!=0,"operator source path");readbound(self,0,0);char*slash=strrchr(self,'/');ck(slash!=0,"operator source directory");*slash=0;char module[4096];ck(realpath(path(self,"../../tests/cxlib/pyjson.cx"),module)!=0,"canonical pyjson path");readbound(module,0,0);acquire();
 char*rp=path(STATE,"results.json");size_t original_n;char*original=readbound(rp,&original_n,0);char why[300];pj_value*d=pj_loads(original,original_n,why,sizeof why);ck(d&&d->type==PJ_OBJ,"results JSON");pj_value*jobs=pj_get(d,"jobs"),*results=pj_get(d,"results"),*stamps=pj_get(d,"stamp"),*inflight=pj_get(d,"inflight");ck(jobs&&jobs->type==PJ_OBJ&&results&&results->type==PJ_OBJ&&stamps&&stamps->type==PJ_OBJ&&jobs->len==stamps->len,"jobs/stamps/results shape");ck(!inflight||(inflight->type==PJ_OBJ&&!inflight->len),"inflight must be empty");
 for(size_t i=0;i<jobs->len;i+=2){const char*n=str(jobs->items[i]);ck(safe(n)&&jobs->items[i+1]->type==PJ_ARR&&jobs->items[i+1]->len&&hex(str(pj_get(stamps,n))),"job/stamp identity");}for(size_t i=0;i<results->len;i+=2)ck(pj_get(jobs,str(results->items[i]))&&results->items[i+1]->type==PJ_OBJ,"result membership/type");
 pj_value*pin=json(path(STATE,"env-pin.json")),*receipt=json(path(STATE,"start-receipt.json")),*vars=pj_get(pin,"vars");ck(pj_eq_int(pj_get(pin,"version"),1)&&vars&&vars->type==PJ_OBJ,"env-pin shape");pj_value*body=pj_dict();pj_set(body,"version",pj_int(1));pj_set(body,"vars",vars);sort(body);size_t wn;char*b=wire(body,&wn),h[65];char*nl=malloc(wn+1);memcpy(nl,b,wn);nl[wn]='\n';cx_sha256_hex(nl,wn+1,h);ck(!strcmp(h,str(pj_get(pin,"sha256")))&&!strcmp(h,str(pj_get(receipt,"env_pin_sha256"))),"env-pin digest/start receipt");
 char*head=readbound(path(STATE,"head"),0,0);head[strcspn(head,"\r\n")]=0;ck(hex(head),"declared head identity");const char*decl[]={"src","exec","tests","include","kernel","weights","unisa","examples","unisacc.c","README.md","ARCHITECTURE.md","AGENTS.md","prd.md","release","scripts","Makefile",0};char*ga[25];int g=0;ga[g++]="git";ga[g++]="-C";ga[g++]=(char*)ROOT;ga[g++]="ls-tree";ga[g++]="HEAD";ga[g++]="--";for(int i=0;decl[i];i++)ga[g++]=(char*)decl[i];ga[g]=0;char*tree=0;size_t tn;ck(cx_runv_timeout(ga,5,&tree,&tn)==0&&tree&&tn,"actual declared Git tree");cx_sha256_hex(tree,tn,h);ck(!strcmp(h,head),"state head vs actual ROOT declared tree");
 ga[3]="status";ga[4]="--porcelain";ga[5]="--";g=6;for(int i=0;decl[i];i++)ga[g++]=(char*)decl[i];ga[g]=0;char*dirty=0;size_t dn;ck(cx_runv_timeout(ga,5,&dirty,&dn)==0&&dirty&&!dn,"declared source must be clean");
 const char*actors[]={"tests/gate.sh","tests/gateorder.json","tests/gatequeue.py","tests/env_pin.py","tests/gatedeps.json","release/tools/queuestart.py","src/version.h","out/isolate.sh","out/f4-final-config.sh","out/f4-final-env.sh","out/accept-env.sh"};for(int i=0;i<11;i++)readbound(path(ROOT,actors[i]),0,0);const char*model=physical(str(pj_get(vars,"MODEL_COM")));readbound(model,0,0);ck(!strcmp(str(pj_get(RS,model)),str(pj_get(receipt,"artifact_sha256"))),"actual candidate matches start receipt");char*side=malloc(strlen(model)+12);sprintf(side,"%s.build.json",model);pj_value*pair=json(side);ck(!strcmp(str(pj_get(pair,"artifact_sha256")),str(pj_get(receipt,"artifact_sha256"))),"actual product pair");const char*provider=physical(str(pj_get(vars,"UNISACC_FFI_X86_PROVIDER")));const char*pf[]={"manifest.json","lib/libffi.a","include/ffi.h","include/ffitarget.h","include/ffi/ffi.h","include/ffi/ffitarget.h","LICENSE"};for(int i=0;i<7;i++)readbound(path(provider,pf[i]),0,0);pj_value*after=pj_get(json(path(ROOT,"tests/gateorder.json")),"after");ck(after&&after->type==PJ_OBJ,"dependency graph");
 pj_value*r=pj_get(results,target);ck(pj_get(jobs,target)&&red(r)&&!blocked(r),"target must be actually failed, not PASS/pending/BLOCKED");pj_value*sec=pj_get(r,"seconds"),*lim=pj_get(r,"limit");ck(positive_number(sec,60.0)&&positive_number(lim,55.0),"target finite positive seconds<=60 and limit<=55");
 pj_value*chosen=pj_dict(),*reasons=pj_dict();pj_set(chosen,target,pj_bool(1));pj_set(reasons,target,pj_strz("explicit actual failed suite"));int changed;do{changed=0;for(size_t i=0;i<jobs->len;i+=2){const char*n=str(jobs->items[i]);if(pj_get(chosen,n)||!blocked(pj_get(results,n)))continue;pj_value*pred=pj_get(after,n);if(!pred)continue;int cause=0,other=0;size_t count=pred->type==PJ_STR?1:pred->type==PJ_ARR?pred->len:0;ck(count>0,"dependency type");for(size_t k=0;k<count;k++){const char*p=str(pred->type==PJ_STR?pred:pred->items[k]);if(!pj_get(jobs,p))continue;if(pj_get(chosen,p))cause=1;else if(red(pj_get(results,p)))other=1;}if(cause&&!other){char*leaf=malloc(strlen(n)+5);sprintf(leaf,"%s.log",n);if(readbound(path(STATE,leaf),0,1))continue;pj_set(chosen,n,pj_bool(1));pj_set(reasons,n,pj_strz("exact3integer-key BLOCKED with no log; all failed predecessors belong to this single-root retry"));changed=1;}}}while(changed);
 pj_value*names=pj_list(),*logs=pj_dict();for(size_t i=0;i<chosen->len;i+=2){const char*n=str(chosen->items[i]);pj_append(names,pj_strz(n));char*leaf=malloc(strlen(n)+5);sprintf(leaf,"%s.log",n);size_t len;char*log=readbound(path(STATE,leaf),&len,strcmp(n,target)!=0);if(!strcmp(n,target)){const char*out=str(pj_get(r,"out_sha"));char digest[65];ck(!strcmp(str(pj_get(RS,path(ROOT,"tests/gatequeue.py"))),"3b00a139c38d0ea8d20c2747ed8a82f0c7cffd6eeae739f3017167bef92dfb52"),"unreviewed queue digest protocol");queue_log_hash(log,len,vars,digest);ck(hex(out)&&!strcmp(out,digest),"failed target queue-portable log SHA mismatch");}pj_set(logs,n,pj_get(RS,path(STATE,leaf)));}
