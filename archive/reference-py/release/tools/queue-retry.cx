 pj_value*next=pj_dict();for(size_t i=0;i<results->len;i+=2)if(!pj_get(chosen,str(results->items[i])))pj_set(next,str(results->items[i]),results->items[i+1]);pj_set(d,"results",next);char checkj[65],checks[65];hashjson(pj_get(d,"jobs"),checkj);hashjson(pj_get(d,"stamp"),checks);ck(!strcmp(checkj,jobs_sha)&&!strcmp(checks,stamp_sha),"jobs/stamp unchanged");char*newbytes=rawsplice(original,original_n,chosen,&wn);pj_value*parsed=pj_loads(newbytes,wn,why,sizeof why);ck(parsed&&parsed->type==PJ_OBJ,"spliced JSON parse");sort(d);sort(parsed);char a[65],z[65];hashjson(d,a);hashjson(parsed,z);ck(!strcmp(a,z),"rawsplice exactly removes selected results and nothing else semantically");cx_sha256_hex(newbytes,wn,NEW_SHA);pj_set(out,"after_results_sha256",pj_strz(NEW_SHA));savejson(path(archive,"receipt.json"),out);save(path(archive,"results.after.json"),newbytes,wn);syncdir(archive);/* Archive is complete before any state mutation; chmod every owned file read-only. */DIR*ad=opendir(archive);ck(ad!=0,"archive directory");struct dirent*e;while((e=readdir(ad)))if(strcmp(e->d_name,".")&&strcmp(e->d_name,".."))ck(!chmod(path(archive,e->d_name),0444),"immutable archived file");closedir(ad);ck(!chmod(archive,0555),"immutable archive directory");syncdir(archive);recheck();if(crash)_exit(86);
 char*tmp=path(STATE,".queue-retry-XXXXXX");int fd=mkstemp(tmp);ck(fd>=0,"unique results staging");size_t left=wn;char*w=newbytes;while(left){ssize_t k=write(fd,w,left);if(k<0&&errno==EINTR)continue;ck(k>0,"results staging write");w+=k;left-=k;}ck(!fsync(fd)&&!close(fd),"results staging fsync");recheck();ck(!rename(tmp,rp),"atomic results replace");COMMITTED=1;syncdir(STATE);b=wire(out,&wn);printf("%.*s\n",(int)wn,b);return 0;}
