diff --git a/tests/safedel.mjs b/tests/safedel.mjs
new file mode 100644
index 0000000..8b37bf1
--- /dev/null
+++ b/tests/safedel.mjs
@@ -0,0 +1,55 @@
+// safedel.mjs: the JavaScript face of the one deletion guard (include/unisa_safedel.h, commissar ruling 2026-10-23).
+// Every deletion in tracked .js/.mjs goes through safedel() here, which runs the argv-only CLI tests/safedel.cx
+// (through tests/cxbin) with child_process.spawnSync and an argv array: no shell, the paths after `--`.  The guard's
+// policy is the CLI's, never re-implemented here: "", ".", "~", the cwd, a repository root, a .git tree and anything
+// outside a temp root or a repository's out/ are refused.
+//   import { safedel } from "<relative>/tests/safedel.mjs";
+//   safedel([path, ...], { purge: true, dryRun: false, maxFiles: N })   // 0, or throws (err.status: 3 refused, 1 I/O, 2 usage)
+//   node tests/safedel.mjs [--dry-run] [--purge] [--max-files N] [--] PATH...   (exit status: the CLI's)
+// Fail closed: a path that is not a string, a missing CLI and every non-zero status throw; nothing is deleted on a
+// refusal (the CLI checks every path before it touches any).  tests/deletecheck.cx scans .js/.mjs for raw deletions
+// (fs.rmSync/unlinkSync/rmdirSync, fs.rm/unlink/rmdir, an argv or shell rm); tests/deletemutcheck.cx replays each
+// guarded site's form `safedel.mjs ... {X}` with "", "." and a sandbox repository root.
+import { spawnSync } from "node:child_process";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const TESTS = path.dirname(fileURLToPath(import.meta.url));
+const CXBIN = path.join(TESTS, "cxbin");
+const CLI = path.join(TESTS, "safedel.cx");
+
+export function safedel(paths, opts = {}) {
+  if (!Array.isArray(paths) || paths.length === 0) throw Object.assign(new Error("safedel: no path"), { status: 2 });
+  for (const p of paths) {
+    if (typeof p !== "string") throw Object.assign(new Error("safedel: a path is not a string: " + String(p)), { status: 2 });
+  }
+  const argv = [CXBIN, CLI];
+  if (opts.dryRun) argv.push("--dry-run");
+  if (opts.purge) argv.push("--purge");
+  if (opts.maxFiles !== undefined) argv.push("--max-files", String(opts.maxFiles));
+  argv.push("--", ...paths);
+  const r = spawnSync("sh", argv, { stdio: ["ignore", "inherit", "inherit"], shell: false });
+  if (r.error) throw Object.assign(new Error("safedel: cannot run the guard CLI: " + r.error.message), { status: 2 });
+  if (r.status !== 0) {
+    const what = r.status === 3 ? "refused (nothing deleted)" : r.status === null ? "killed by " + r.signal : "status " + r.status;
+    throw Object.assign(new Error("safedel: " + what + ": " + paths.join(" ")), { status: r.status === null ? 1 : r.status });
+  }
+  return 0;
+}
+
+function self(p) { try { return fs.realpathSync(p); } catch { return ""; } }
+if (process.argv[1] && self(process.argv[1]) === self(fileURLToPath(import.meta.url))) {
+  const a = process.argv.slice(2), paths = [], opts = {};
+  let ends = false;
+  for (let i = 0; i < a.length; i++) {
+    const w = a[i];
+    if (ends || !w.startsWith("-") || w === "-") { paths.push(w); continue; }
+    if (w === "--") ends = true;
+    else if (w === "--dry-run") opts.dryRun = true;
+    else if (w === "--purge") opts.purge = true;
+    else if (w === "--max-files" && i + 1 < a.length) opts.maxFiles = a[++i];
+    else { console.error("usage: node tests/safedel.mjs [--dry-run] [--purge] [--max-files N] [--] PATH..."); process.exit(2); }
+  }
+  try { safedel(paths, opts); process.exit(0); } catch (e) { console.error(e.message); process.exit(e.status || 1); }
+}
