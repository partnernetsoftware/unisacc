diff --git a/exec/c/apecache.cx b/exec/c/apecache.cx
new file mode 100644
index 0000000..797b345
--- /dev/null
+++ b/exec/c/apecache.cx
@@ -0,0 +1,275 @@
+#!/usr/bin/env -S unisacc.com -run
+/* apecache.cx -- the development APE driver (exec/c/compiler.c around a model package), built without Python and
+   kept in a read-set cache.  Replaces exec/c/apecache.py (2026-10-23, seed detach W2-F), which ran the archived
+   seed's `ape exec/c/compiler.c --via UA -O2 --payload PAYLOAD`.
+   usage: sh ./tests/cxbin exec/c/apecache.cx OUT UA PAYLOAD          (cwd = the repository root)
+   Construction (the product build's container route, exec/c/buildcompiler.sh pack_driver): `UA -O2 -b T
+   exec/c/compiler.c` for the five slice targets win/x86_64 lnx/x86_64 lnx/arm64 osx/x86_64 osx/arm64 (an MZ UA is
+   launched through sh), then seed/ape.c (cc -std=c99 -O2 -w, no zlib: its gzip members are stored blocks, which
+   the launcher's `gzip -dc` reads the same, so the build does not depend on the host having zlib.h)
+   `--payload PAYLOAD DRIVER SLICES...`.
+   Cache (the .py's scheme, minus Python): the slice builds run under `strace -f -e trace=openat`; the read set is
+   every read-only regular-file open of the build (absolute; minus /proc /sys /dev, PAYLOAD, the build directory,
+   OUT's directory and anything the build itself wrote).  JOB = sha256 over the scheme tag, exec/c/compiler.c, -O2,
+   sha256(UA), sha256(PAYLOAD), sha256(seed/ape.c) and the host cc's --version line; the index
+   BASE/ape-index-JOB.tsv keeps one read set per line (tab-separated names), and an entry is BASE/ape-KEY with
+   KEY = sha256(JOB, every name's stamp: its sha256, `absent` or `dir`).  A lookup hits only when every stored name
+   re-stamps equal and the entry's driver.com matches its own manifest (driver.com<TAB>sha256).  A miss builds,
+   stores the artifact under its read-set key and adds the read set to the index.  Nothing is reused across different
+   bytes: any changed input changes a stamp or JOB.  BASE = $UNISACC_MODEL_CACHE, else ${TMPDIR:-/tmp}/unisacc-
+   model-cache.  The index is updated under an exclusive flock(2) of BASE/ape-index-JOB.lock.
+   Output: `ape-cache: hit KEY16` or `ape-cache: miss, built and stored KEY16 (N read names)`, rc 0; a failure is one
+   `apecache: ...` line on stderr (plus the failing command's tail), rc 1; usage rc 2.
+   Prelude gap: <sys/file.h> for flock(2) is the one #include (as tests/seedconstructcheck.cx). */
+#include <sys/file.h>
+
+static char ROOT[4096], BASE[4096], WORK[4300], JOB[65];
+static const char *OUT, *UA, *PAYLOAD;
+
+static void fail(const char *a, const char *b) {
+    fflush(stdout);
+    fprintf(stderr, "apecache: %s%s\n", a, b ? b : "");
+    if (WORK[0]) { cx_rmtree(WORK); WORK[0] = 0; }   /* the unfinished build directory (own mkdtemp under BASE) */
+    exit(1);
+}
+static char *xstrdup(const char *s) { size_t n = strlen(s) + 1; char *p = malloc(n); if (!p) fail("out of memory", 0); memcpy(p, s, n); return p; }
+static int file_sha(const char *p, char hex[65]) {   /* 0 ok, 1 absent, 2 a directory, -1 unreadable */
+    struct stat st; size_t n; char *b;
+    if (stat(p, &st) != 0) return 1;
+    if (S_ISDIR(st.st_mode)) return 2;
+    if (!(b = cx_read(p, &n))) return -1;
+    cx_sha256_hex(b, n, hex); free(b); return 0;
+}
+static void must_sha(const char *p, char hex[65]) { if (file_sha(p, hex) != 0) fail("cannot read ", p); }
+static void mkdirs(const char *p) {
+    char t[4096]; size_t i, n = strlen(p);
+    if (n >= sizeof t) fail("path too long: ", p);
+    memcpy(t, p, n + 1);
+    for (i = 1; i <= n; i++) if (t[i] == '/' || t[i] == 0) { char c = t[i]; t[i] = 0; mkdir(t, 0777); t[i] = c; }
+    { struct stat st; if (stat(p, &st) != 0 || !S_ISDIR(st.st_mode)) fail("cannot create ", p); }
+}
+/* run ARGV (cwd ROOT) under SECS; rc 0 required, else its stdout tail and the failure */
+static void run_checked(char **argv, int secs, const char *what) {
+    char *out = 0; size_t n = 0; int rc = cx_runv_timeout(argv, secs, &out, &n);
+    if (rc != 0) {
+        char t[64];
+        if (out && n) { size_t s = n > 400 ? n - 400 : 0; fwrite(out + s, 1, n - s, stderr); }
+        snprintf(t, sizeof t, " failed (rc %d)", rc); free(out);
+        fail(what, t);
+    }
+    free(out);
+}
+
+/* ---- names and stamps ----------------------------------------------------------------------------------------- */
+typedef struct { char **v; size_t n, cap; } Names;
+static void names_add(Names *s, const char *p) {
+    size_t i;
+    for (i = 0; i < s->n; i++) if (!strcmp(s->v[i], p)) return;
+    if (s->n == s->cap) { s->cap = s->cap ? 2 * s->cap : 64; s->v = realloc(s->v, s->cap * sizeof *s->v); if (!s->v) fail("out of memory", 0); }
+    s->v[s->n++] = xstrdup(p);
+}
+static int names_has(const Names *s, const char *p) { size_t i; for (i = 0; i < s->n; i++) if (!strcmp(s->v[i], p)) return 1; return 0; }
+static int cmpstr(const void *a, const void *b) { return strcmp(*(char *const *)a, *(char *const *)b); }
+/* KEY = sha256("JOB\n" + "NAME\tSTAMP\n"... over the names in byte order) */
+static void readkey(const Names *s, char key[65]) {
+    size_t i, len = strlen(JOB) + 1, at; char *buf, hex[65];
+    for (i = 0; i < s->n; i++) len += strlen(s->v[i]) + 66;
+    if (!(buf = malloc(len + 1))) fail("out of memory", 0);
+    at = (size_t)sprintf(buf, "%s\n", JOB);
+    for (i = 0; i < s->n; i++) {
+        int r = file_sha(s->v[i], hex);
+        at += (size_t)sprintf(buf + at, "%s\t%s\n", s->v[i], r == 0 ? hex : r == 1 ? "absent" : r == 2 ? "dir" : "unreadable");
+    }
+    cx_sha256_hex(buf, at, key); free(buf);
+}
+static int cache_valid(const char *entry) {
+    char p[4400], want[80], hex[65]; size_t n; char *m; int ok;
+    snprintf(p, sizeof p, "%s/manifest.tsv", entry);
+    if (!(m = cx_read(p, &n))) return 0;
+    snprintf(p, sizeof p, "%s/driver.com", entry);
+    ok = file_sha(p, hex) == 0;
+    if (ok) { snprintf(want, sizeof want, "driver.com\t%s\n", hex); ok = n == strlen(want) && !memcmp(m, want, n); }
+    free(m); return ok;
+}
+static void copy_out(const char *from) {
+    size_t n; char *b = cx_read(from, &n);
+    if (!b || cx_write(OUT, b, n) != 0) fail("cannot write ", OUT);
+    free(b);
+}
+/* path normalisation (os.path.normpath of an absolute path; a relative one is taken under ROOT) */
+static void normpath(const char *in, char *out, size_t cap) {
+    char tmp[8192], *seg[1024]; int ns = 0, i; char *p, *q; size_t at = 0;
+    if (in[0] == '/') snprintf(tmp, sizeof tmp, "%s", in); else snprintf(tmp, sizeof tmp, "%s/%s", ROOT, in);
+    for (p = tmp; *p; ) {
+        while (*p == '/') p++;
+        if (!*p) break;
+        q = p; while (*q && *q != '/') q++;
+        if (*q) *q++ = 0;
+        if (!strcmp(p, ".")) ;
+        else if (!strcmp(p, "..")) { if (ns) ns--; }
+        else if (ns < 1024) seg[ns++] = p;
+        p = q;
+    }
+    if (!ns) { snprintf(out, cap, "/"); return; }
+    for (i = 0; i < ns && at + 1 < cap; i++) at += (size_t)snprintf(out + at, cap - at, "/%s", seg[i]);
+}
+static int below(const char *p, const char *dir) { size_t n = strlen(dir); return !strncmp(p, dir, n) && (p[n] == '/' || p[n] == 0); }
+/* `[PID ]openat(AT_FDCWD|N, "PATH", FLAGS) = FD` lines of the strace log: the read set */
+static void measured_names(const char *log, Names *keep) {
+    size_t n, at = 0; char *t = cx_read(log, &n), payload[4200], outdir[4200], *sl; Names reads = { 0 }, writes = { 0 }; size_t i;
+    if (!t) fail("no strace log ", log);
+    normpath(PAYLOAD, payload, sizeof payload);
+    normpath(OUT, outdir, sizeof outdir); if ((sl = strrchr(outdir, '/')) && sl != outdir) *sl = 0;
+    while (at < n) {
+        char *l = t + at, *e = memchr(l, '\n', n - at), *p, *q, *path, *flags, norm[4200]; size_t ln = e ? (size_t)(e - l) : n - at; long fd;
+        at += ln + 1; l[ln] = 0;
+        p = l; while (*p >= '0' && *p <= '9') p++;
+        if (p != l) { if (*p != ' ' && *p != '\t') continue; while (*p == ' ' || *p == '\t') p++; }
+        if (strncmp(p, "openat(", 7)) continue;
+        p += 7;
+        if (!strncmp(p, "AT_FDCWD", 8)) p += 8; else { if (*p == '-') p++; q = p; while (*p >= '0' && *p <= '9') p++; if (p == q) continue; }
+        if (*p != ',') continue;
+        p++; while (*p == ' ' || *p == '\t') p++;
+        if (*p != '"') continue;
+        path = ++p; while (*p && *p != '"') p++;
+        if (*p != '"') continue;
+        *p++ = 0;
+        if (*p != ',') continue;
+        p++; while (*p == ' ' || *p == '\t') p++;
+        flags = p; while (*p && *p != ')') p++;
+        if (*p != ')') continue;
+        *p++ = 0;
+        while (*p == ' ' || *p == '\t') p++;
+        if (*p != '=') continue;
+        p++; while (*p == ' ' || *p == '\t') p++;
+        fd = strtol(p, &q, 10);
+        if (q == p || fd < 0) continue;
+        normpath(path, norm, sizeof norm);
+        if (strstr(flags, "O_WRONLY") || strstr(flags, "O_RDWR") || strstr(flags, "O_CREAT") || strstr(flags, "O_TRUNC")) names_add(&writes, norm);
+        else names_add(&reads, norm);
+    }
+    for (i = 0; i < reads.n; i++) {
+        const char *r = reads.v[i];
+        if (names_has(&writes, r)) continue;
+        if (below(r, "/proc") || below(r, "/sys") || below(r, "/dev") || !strcmp(r, payload)) continue;
+        if (below(r, WORK) || below(r, outdir)) continue;
+        if (strchr(r, '\t')) fail("a read path holds a tab: ", r);
+        names_add(keep, r);
+    }
+    qsort(keep->v, keep->n, sizeof *keep->v, cmpstr);
+    free(t);
+}
+
+static void job_key(void) {
+    char ua[65], pl[65], ap[65], *cc = 0, *buf; size_t ccn = 0, n; char *argv[3];
+    argv[0] = "cc"; argv[1] = "--version"; argv[2] = 0;
+    if (cx_runv_timeout(argv, 10, &cc, &ccn) != 0 || !cc) fail("host cc --version failed", 0);
+    { char *nl = memchr(cc, '\n', ccn); if (nl) *nl = 0; }
+    must_sha(UA, ua); must_sha(PAYLOAD, pl); must_sha("seed/ape.c", ap);
+    n = strlen(cc) + 400;
+    if (!(buf = malloc(n))) fail("out of memory", 0);
+    n = (size_t)snprintf(buf, n, "ape-readset-v2\nexec/c/compiler.c\n-O2\nua %s\npayload %s\nape.c %s\ncc %s\n", ua, pl, ap, cc);
+    cx_sha256_hex(buf, n, JOB); free(buf); free(cc);
+}
+
+int main(int argc, char **argv) {
+    char index[4400], lockp[4400], entry[4400], key[65], path[4600], *idx = 0; size_t idxn = 0; int lf, i;
+    const char *e;
+    if (argc != 4) { fprintf(stderr, "usage: apecache.cx OUT UA PAYLOAD\n"); return 2; }
+    OUT = argv[1]; UA = argv[2]; PAYLOAD = argv[3];
+    if (!getcwd(ROOT, sizeof ROOT)) fail("no working directory", 0);
+    if ((e = getenv("UNISACC_MODEL_CACHE")) && *e) snprintf(BASE, sizeof BASE, "%s", e);
+    else { const char *t = getenv("TMPDIR"); snprintf(BASE, sizeof BASE, "%s/unisacc-model-cache", t && *t ? t : "/tmp"); }
+    mkdirs(BASE);
+    job_key();
+    snprintf(index, sizeof index, "%s/ape-index-%s.tsv", BASE, JOB);
+    snprintf(lockp, sizeof lockp, "%s/ape-index-%s.lock", BASE, JOB);
+    if ((lf = open(lockp, O_WRONLY | O_CREAT | O_APPEND, 0666)) < 0) fail("cannot open ", lockp);
+    while (flock(lf, LOCK_EX) != 0) if (errno != EINTR) fail("cannot lock ", lockp);
+    /* lookup: every stored read set, re-stamped */
+    if ((idx = cx_read(index, &idxn))) {
+        size_t at = 0;
+        while (at < idxn) {
+            char *l = idx + at, *nl = memchr(l, '\n', idxn - at), *p; Names s = { 0 }; size_t ln = nl ? (size_t)(nl - l) : idxn - at;
+            at += ln + 1;
+            if (!ln) continue;
+            {   char *line = malloc(ln + 1); if (!line) fail("out of memory", 0); memcpy(line, l, ln); line[ln] = 0;
+                for (p = line; p; ) { char *tab = strchr(p, '\t'); if (tab) *tab = 0; if (*p) names_add(&s, p); p = tab ? tab + 1 : 0; }
+                free(line); }
+            readkey(&s, key);
+            snprintf(entry, sizeof entry, "%s/ape-%s", BASE, key);
+            if (cache_valid(entry)) {
+                snprintf(path, sizeof path, "%s/driver.com", entry); copy_out(path);
+                printf("ape-cache: hit %.16s\n", key);
+                return 0;
+            }
+        }
+    }
+    /* miss: build into an own mkdtemp under BASE, under strace */
+    {
+        char tpl[4400], ape[4600], logp[4600], drv[4600], man[4600], hex[65], line[200], *v[20];
+        static const char *const targets[5] = { "win/x86_64", "lnx/x86_64", "lnx/arm64", "osx/x86_64", "osx/arm64" };
+        static char script[] = "u=$1; w=$2; via=$u; [ \"$(head -c 2 \"$u\")\" = MZ ] && via=\"sh $u\"; pids=; "
+            "for t in win/x86_64 lnx/x86_64 lnx/arm64 osx/x86_64 osx/arm64; do $via -O2 -b $t exec/c/compiler.c -o \"$w/slice-$(echo $t | tr / -)\" & pids=\"$pids $!\"; done; "
+            "rc=0; for p in $pids; do wait $p || rc=1; done; exit $rc";
+        Names names = { 0 }; size_t k; int n;
+        snprintf(tpl, sizeof tpl, "%s/ape-%.12s.build-XXXXXX", BASE, JOB);
+        if (!mkdtemp(tpl)) fail("cannot create a build directory under ", BASE);
+        snprintf(WORK, sizeof WORK, "%s", tpl);
+        snprintf(ape, sizeof ape, "%s/ape", WORK); snprintf(logp, sizeof logp, "%s/strace.log", WORK);
+        snprintf(drv, sizeof drv, "%s/driver.com", WORK); snprintf(man, sizeof man, "%s/manifest.tsv", WORK);
+        v[0] = "cc"; v[1] = "-std=c99"; v[2] = "-O2"; v[3] = "-w"; v[4] = "-o"; v[5] = ape; v[6] = "seed/ape.c"; v[7] = 0;
+        run_checked(v, 30, "cc seed/ape.c");
+        v[0] = "strace"; v[1] = "-f"; v[2] = "-qq"; v[3] = "-e"; v[4] = "trace=openat"; v[5] = "-o"; v[6] = logp;
+        v[7] = "sh"; v[8] = "-c"; v[9] = script; v[10] = "apecache"; v[11] = (char *)UA; v[12] = WORK; v[13] = 0;
+        run_checked(v, 50, "UA -O2 -b slices of exec/c/compiler.c");
+        n = 0; v[n++] = ape; v[n++] = "--payload"; v[n++] = (char *)PAYLOAD; v[n++] = drv;
+        for (k = 0; k < 5; k++) {
+            char s[4700], tg[16], *c; snprintf(tg, sizeof tg, "%s", targets[k]); for (c = tg; *c; c++) if (*c == '/') *c = '-';
+            snprintf(s, sizeof s, "%s/slice-%s", WORK, tg); v[n++] = xstrdup(s);
+        }
+        v[n] = 0;
+        run_checked(v, 30, "seed/ape.c container");
+        measured_names(logp, &names);
+        /* only driver.com and its manifest go into the entry: the tool, the slices and the trace are build files */
+        for (k = 0; k < 7; k++) {
+            if (k < 5) { char tg[16], *c; snprintf(tg, sizeof tg, "%s", targets[k]); for (c = tg; *c; c++) if (*c == '/') *c = '-'; snprintf(path, sizeof path, "%s/slice-%s", WORK, tg); }
+            else snprintf(path, sizeof path, "%s", k == 5 ? ape : logp);
+            cx_remove(path);   /* build files inside the own mkdtemp */
+        }
+        must_sha(drv, hex);
+        snprintf(line, sizeof line, "driver.com\t%s\n", hex);
+        if (cx_write(man, line, strlen(line)) != 0) fail("cannot write ", man);
+        readkey(&names, key);
+        snprintf(entry, sizeof entry, "%s/ape-%s", BASE, key);
+        { struct stat st; if (lstat(entry, &st) == 0 && cx_trash(entry) != 0) fail("the deletion guard refused the replaced entry ", entry); }
+        if (rename(WORK, entry) != 0) fail("cannot store ", entry);
+        WORK[0] = 0;
+        {   /* the index: one more read set (tmp + rename) */
+            int seen = 0; size_t at = 0, len = 0, j; char *row, tmpi[4500];
+            for (j = 0; j < names.n; j++) len += strlen(names.v[j]) + 1;
+            if (!(row = malloc(len + 2))) fail("out of memory", 0);
+            row[0] = 0; for (j = 0; j < names.n; j++) { if (j) strcat(row, "\t"); strcat(row, names.v[j]); }
+            if (idx) while (at < idxn) {
+                char *l = idx + at, *nl = memchr(l, '\n', idxn - at); size_t ln = nl ? (size_t)(nl - l) : idxn - at;
+                if (ln == strlen(row) && !memcmp(l, row, ln)) seen = 1;
+                at += ln + 1;
+            }
+            if (!seen) {
+                size_t m = idxn + strlen(row) + 2; char *all = malloc(m); size_t w = 0;
+                if (!all) fail("out of memory", 0);
+                if (idx && idxn) { memcpy(all, idx, idxn); w = idxn; if (all[w - 1] != '\n') all[w++] = '\n'; }
+                memcpy(all + w, row, strlen(row)); w += strlen(row); all[w++] = '\n';
+                snprintf(tmpi, sizeof tmpi, "%s.tmp", index);
+                if (cx_write(tmpi, all, w) != 0 || rename(tmpi, index) != 0) fail("cannot write ", index);
+                free(all);
+            }
+            free(row);
+        }
+        snprintf(path, sizeof path, "%s/driver.com", entry); copy_out(path);
+        printf("ape-cache: miss, built and stored %.16s (%d read names)\n", key, (int)names.n);
+        for (i = 0; i < (int)names.n; i++) free(names.v[i]);
+    }
+    free(idx);
+    return 0;
+}
