diff --git a/tests/apeversioncheck.cx b/tests/apeversioncheck.cx
new file mode 100644
index 0000000..182562c
--- /dev/null
+++ b/tests/apeversioncheck.cx
@@ -0,0 +1,281 @@
+#!/usr/bin/env -S unisacc.com -run
+/* apeversioncheck.cx -- the product container's VERSIONINFO, read independently and by llvm-readobj (gate job
+   ape-version).  Replaces tests/apeversioncheck.py (2026-10-23, seed detach W2-F: no Python).
+   usage: sh ./tests/cxbin tests/apeversioncheck.cx [--ape APE] [--llvm-readobj TOOL]     (from the repository root)
+   APE defaults to ./unisacc.com; TOOL to llvm-readobj on PATH, then the Homebrew llvm paths.  A missing tool or an
+   invalid PE head fails, never skips.  No VM, no signing credentials, no compiler or model rebuild.
+
+   What is checked (as the .py's product half):
+     the PE head of the APE (bytes up to the end of the last section) is followed by more bytes (the Unix slices);
+     the head's resource directory (data directory 2) leads, by ids 16 / 1 / 0x0409, to one VERSIONINFO data entry
+     (codepage 1200) inside its section; that VERSIONINFO parses (every block: length >= 8, inside its parent, type 0
+     or 1, a NUL-terminated UTF-16 key, 4-byte alignment, unique child keys) and its fields equal the frozen field
+     table below, the version being src/version.h's one UNISACC_VERSION;
+     llvm-readobj --coff-resources on the head names Type VERSIONINFO (ID 16), Language (ID 1033), Codepage 1200, and
+     the bytes of its hex dump are the same VERSIONINFO bytes, whose fields are checked again.
+   Output (byte-equal to the .py's product lines):
+     frozen-ape-pe-head: llvm-readobj ProductName=Unisacc ProductVersion=V matches src/version.h
+     real head sha256=HEX
+   rc 0; a failure is one `apeversioncheck: ...` line on stderr, rc 1 (usage rc 2).
+   Not carried over from the .py: its synthetic-PE and rejection cases exercised the Python seed's VERSIONINFO
+   writer (peversion.add_version_info), which no build runs any more -- the one writer is seed/ape.c (--product),
+   whose output is exactly the head judged here; its C reference is judged by job k6-peversion.  A head without
+   VERSIONINFO is red here (the .py instead ran that writer over it). */
+
+/* The frozen field table: what the seed's peversion and seed/ape.c write (captured from tests/apeversioncheck.py at
+   HEAD a1df62cc).  "@" stands for src/version.h's UNISACC_VERSION. */
+static const char *const STRING_TABLE[4][2] = {
+    { "ProductName", "Unisacc" }, { "ProductVersion", "@" }, { "FileDescription", "Unisacc" }, { "FileVersion", "@" },
+};
+static const unsigned long FIXED_SIG = 0xFEEF04BDUL, FIXED_STRUCVER = 0x10000UL;
+static const unsigned long FIXED_TAIL[7] = { 0x3fUL, 0, 0x40004UL, 1, 0, 0, 0 };   /* flagsmask flags os type subtype date */
+static const unsigned RES_PATH[3] = { 16, 1, 0x0409 };                                /* RT_VERSION, id 1, en-US */
+#define LANG_CP 1200u
+#define STRING_BLOCK "040904B0"
+
+static char TMPF[4200];
+static void fail(const char *a, const char *b) {
+    fflush(stdout);
+    fprintf(stderr, "apeversioncheck: %s%s\n", a, b ? b : "");
+    if (TMPF[0]) { cx_remove(TMPF); TMPF[0] = 0; }
+    exit(1);
+}
+#define CHECK(c, what) do { if (!(c)) fail("AssertionError: ", what); } while (0)
+
+static unsigned long u16(const unsigned char *b, size_t n, size_t at) {
+    CHECK(at + 2 <= n, "read past the end");
+    return (unsigned long)b[at] | (unsigned long)b[at + 1] << 8;
+}
+static unsigned long u32(const unsigned char *b, size_t n, size_t at) {
+    CHECK(at + 4 <= n, "read past the end");
+    return (unsigned long)b[at] | (unsigned long)b[at + 1] << 8 | (unsigned long)b[at + 2] << 16 | (unsigned long)b[at + 3] << 24;
+}
+
+/* ---- PE layout ---------------------------------------------------------------------------------------------- */
+typedef struct { unsigned long vsize, rva, size, raw; } Sect;
+static size_t layout(const unsigned char *b, size_t n, size_t *opt, Sect **out) {
+    size_t pe, count, table, i; Sect *s;
+    pe = u32(b, n, 60); count = u16(b, n, pe + 6); *opt = pe + 24; table = *opt + u16(b, n, pe + 20);
+    s = calloc(count ? count : 1, sizeof *s); if (!s) fail("MemoryError", 0);
+    for (i = 0; i < count; i++) {
+        size_t at = table + 40 * i;
+        s[i].vsize = u32(b, n, at + 8); s[i].rva = u32(b, n, at + 12); s[i].size = u32(b, n, at + 16); s[i].raw = u32(b, n, at + 20);
+    }
+    *out = s; return count;
+}
+/* the VERSIONINFO data entry by ids 16 / 1 / 0x0409 */
+static unsigned char *resource_bytes(const unsigned char *b, size_t n, size_t *len) {
+    size_t opt, cnt, i, base, at = 0, raw; Sect *s, *sect = 0; unsigned long rva, size, drva, dn; int k; unsigned char *r;
+    cnt = layout(b, n, &opt, &s);
+    rva = u32(b, n, opt + 128); size = u32(b, n, opt + 132);
+    for (i = 0; i < cnt; i++) if (s[i].rva <= rva && rva < s[i].rva + s[i].vsize) { sect = &s[i]; break; }
+    CHECK(sect, "resource directory outside every section");
+    base = sect->raw + (rva - sect->rva);
+    for (k = 0; k < 3; k++) {
+        unsigned long got, target;
+        CHECK(u16(b, n, base + at + 12) == 0 && u16(b, n, base + at + 14) == 1, "resource directory: one id entry");
+        got = u32(b, n, base + at + 16); target = u32(b, n, base + at + 20);
+        CHECK(got == RES_PATH[k], "resource directory id");
+        if (k < 2) CHECK(target & 0x80000000UL, "resource directory: subdirectory expected");
+        else CHECK(!(target & 0x80000000UL), "resource directory: data entry expected");
+        at = target & 0x7fffffffUL;
+    }
+    drva = u32(b, n, base + at); dn = u32(b, n, base + at + 4);
+    CHECK(u32(b, n, base + at + 8) == LANG_CP && u32(b, n, base + at + 12) == 0 && dn <= size, "resource data entry");
+    raw = sect->raw + (drva - sect->rva);
+    CHECK(drva >= sect->rva && raw + dn <= base + size && raw + dn <= n, "resource data outside its directory");
+    r = malloc(dn ? dn : 1); if (!r) fail("MemoryError", 0);
+    memcpy(r, b + raw, dn); *len = dn; free(s);
+    return r;
+}
+
+/* ---- VERSIONINFO blocks --------------------------------------------------------------------------------------- */
+typedef struct Blk { char key[64]; int kind; size_t vat, vn; struct Blk *kid[16]; int nk; } Blk;
+static Blk *parse_block(const unsigned char *b, size_t at, size_t end, size_t *stop_out) {
+    size_t len, vlen, stop, pos, kn = 0; Blk *k = calloc(1, sizeof *k); int done = 0, i;
+    if (!k) fail("MemoryError", 0);
+    len = u16(b, end, at); vlen = u16(b, end, at + 2); k->kind = (int)u16(b, end, at + 4);
+    stop = at + len;
+    CHECK(len >= 8 && stop <= end && (k->kind == 0 || k->kind == 1), "VERSIONINFO block header");
+    for (pos = at + 6; pos + 2 <= stop; ) {
+        unsigned c = b[pos] | b[pos + 1] << 8; pos += 2;
+        if (!c) { done = 1; break; }
+        CHECK(c < 0x80 && kn + 1 < sizeof k->key, "VERSIONINFO key is not short ASCII");
+        k->key[kn++] = (char)c;
+    }
+    CHECK(done, "unterminated VERSIONINFO key");
+    pos = (pos + 3) / 4 * 4;
+    k->vat = pos; k->vn = vlen * (k->kind ? 2 : 1);
+    CHECK(pos + k->vn <= stop, "VERSIONINFO value past its block");
+    pos += k->vn;
+    while ((pos + 3) / 4 * 4 < stop) {
+        size_t next; Blk *c;
+        pos = (pos + 3) / 4 * 4;
+        c = parse_block(b, pos, stop, &next);
+        CHECK(next > pos, "VERSIONINFO child of no length");
+        for (i = 0; i < k->nk; i++) CHECK(strcmp(k->kid[i]->key, c->key), "duplicate VERSIONINFO key");
+        CHECK(k->nk < 16, "too many VERSIONINFO children");
+        k->kid[k->nk++] = c; pos = next;
+    }
+    *stop_out = stop;
+    return k;
+}
+static Blk *child(Blk *k, const char *key) {
+    int i;
+    for (i = 0; i < k->nk; i++) if (!strcmp(k->kid[i]->key, key)) return k->kid[i];
+    fail("KeyError: ", key); return 0;
+}
+/* the string value of a kind-1 block: UTF-16LE, one trailing NUL dropped; ASCII only */
+static void strval(const unsigned char *b, const Blk *k, char *out, size_t cap) {
+    size_t i, m = 0;
+    for (i = 0; i + 2 <= k->vn; i += 2) {
+        unsigned c = b[k->vat + i] | b[k->vat + i + 1] << 8;
+        CHECK(c < 0x80 && m + 1 < cap, "VERSIONINFO string is not short ASCII");
+        out[m++] = (char)c;
+    }
+    if (m && out[m - 1] == 0) m--;
+    out[m] = 0;
+}
+static void fields(const unsigned char *info, size_t n, const char *version) {
+    size_t stop, i; Blk *root, *table, *trans; unsigned long comp[4] = { 0, 0, 0, 0 }, ms, ls; int nc = 0; const char *p = version;
+    root = parse_block(info, 0, n, &stop);
+    CHECK(stop == n && !strcmp(root->key, "VS_VERSION_INFO") && root->kind == 0, "VS_VERSION_INFO root");
+    CHECK(root->vn == 52, "VS_FIXEDFILEINFO size");
+    CHECK(u32(info, n, root->vat) == FIXED_SIG && u32(info, n, root->vat + 4) == FIXED_STRUCVER, "VS_FIXEDFILEINFO signature");
+    while (*p) {
+        unsigned long v = 0; const char *s = p;
+        while (*p >= '0' && *p <= '9') { v = v * 10 + (unsigned long)(*p - '0'); CHECK(v <= 65535, "version component"); p++; }
+        CHECK(p > s && nc < 4, "version components");
+        comp[nc++] = v;
+        if (*p == '.') { p++; CHECK(*p, "version components"); }
+        else CHECK(!*p, "version components");
+    }
+    CHECK(nc == 3 || nc == 4, "version components");
+    ms = comp[0] << 16 | comp[1]; ls = comp[2] << 16 | comp[3];
+    CHECK(u32(info, n, root->vat + 8) == ms && u32(info, n, root->vat + 12) == ls &&
+          u32(info, n, root->vat + 16) == ms && u32(info, n, root->vat + 20) == ls, "file/product version numbers");
+    for (i = 0; i < 7; i++) CHECK(u32(info, n, root->vat + 24 + 4 * i) == FIXED_TAIL[i], "VS_FIXEDFILEINFO flags/os/type");
+    table = child(child(root, "StringFileInfo"), STRING_BLOCK);
+    CHECK(table->nk == 4, "string table has exactly the four frozen keys");
+    for (i = 0; i < 4; i++) {
+        char got[256]; const char *want = strcmp(STRING_TABLE[i][1], "@") ? STRING_TABLE[i][1] : version;
+        strval(info, child(table, STRING_TABLE[i][0]), got, sizeof got);
+        if (strcmp(got, want)) fail("AssertionError: string ", STRING_TABLE[i][0]);
+    }
+    trans = child(child(root, "VarFileInfo"), "Translation");
+    CHECK(trans->vn == 4 && u16(info, n, trans->vat) == 0x409 && u16(info, n, trans->vat + 2) == LANG_CP, "Translation");
+}
+
+/* src/version.h: exactly one `#define UNISACC_VERSION "N.N.N[.N]"` */
+static void product_version(char *out, size_t cap) {
+    size_t n, at = 0; char *t = cx_read("src/version.h", &n); int found = 0;
+    if (!t) fail("FileNotFoundError: src/version.h", 0);
+    while (at < n) {
+        char *l = t + at, *e = memchr(l, '\n', n - at), *q; size_t ln;
+        ln = e ? (size_t)(e - l) : n - at; at += ln + 1;
+        while (ln && (*l == ' ' || *l == '\t')) { l++; ln--; }
+        if (ln < 24 || memcmp(l, "#define", 7)) continue;
+        q = l + 7; if (*q != ' ' && *q != '\t') continue;
+        while (*q == ' ' || *q == '\t') q++;
+        if (strncmp(q, "UNISACC_VERSION", 15) || (q[15] != ' ' && q[15] != '\t')) continue;
+        q += 15; while (*q == ' ' || *q == '\t') q++;
+        if (*q != '"') continue;
+        {   char *s = ++q; int dots = 0; size_t m;
+            while (*q && *q != '"' && q < l + ln) { if (*q == '.') dots++; else if (*q < '0' || *q > '9') break; q++; }
+            if (*q != '"' || dots < 2 || dots > 3 || q == s) continue;
+            m = (size_t)(q - s);
+            {   char *r = q + 1; while (r < l + ln && (*r == ' ' || *r == '\t' || *r == '\r')) r++; if (r != l + ln) continue; }
+            CHECK(m + 1 < cap, "version too long");
+            memcpy(out, s, m); out[m] = 0; found++;
+        }
+    }
+    free(t);
+    CHECK(found == 1, "src/version.h must declare exactly one product version");
+}
+
+/* `llvm-readobj --coff-resources HEAD`: the VERSIONINFO lines and the hex dump's bytes */
+static unsigned char *external(const char *tool, const unsigned char *head, size_t hn, size_t *xn) {
+    char *argv[4], *out = 0; size_t on = 0, at = 0, m = 0; int rc, fd; unsigned char *x; int half = -1;
+    const char *tmp = getenv("TMPDIR");
+    snprintf(TMPF, sizeof TMPF, "%s/unisacc-peversion-XXXXXX", tmp && *tmp ? tmp : "/tmp");
+    if ((fd = mkstemp(TMPF)) < 0) { TMPF[0] = 0; fail("OSError: cannot create a temporary file", 0); }
+    close(fd);
+    if (cx_write(TMPF, head, hn)) fail("OSError: cannot write ", TMPF);
+    argv[0] = (char *)tool; argv[1] = "--coff-resources"; argv[2] = TMPF; argv[3] = 0;
+    rc = cx_runv_timeout(argv, 15, &out, &on);
+    cx_remove(TMPF); TMPF[0] = 0;
+    if (rc) { char t[64]; snprintf(t, sizeof t, "%d", rc); fail("AssertionError: llvm-readobj rc ", t); }
+    CHECK(out && strstr(out, "Type: VERSIONINFO (ID 16)") && strstr(out, "Language: (ID 1033)") && strstr(out, "Codepage: 1200"),
+          "llvm-readobj does not name the VERSIONINFO resource");
+    x = malloc(on / 2 + 1); if (!x) fail("MemoryError", 0);
+    /* rows `^\s+HEX:\s+([0-9A-Fa-f ]+)\s+\|` (the .py's regex): the bytes of the captured hex */
+    while (at < on) {
+        char *l = out + at, *e = memchr(l, '\n', on - at), *p = l, *g, *ge, *q; size_t ln = e ? (size_t)(e - l) : on - at;
+        at += ln + 1;
+        if (p == l + ln || !(*p == ' ' || *p == '\t')) continue;
+        while (p < l + ln && (*p == ' ' || *p == '\t')) p++;
+        q = p; while (p < l + ln && isxdigit((unsigned char)*p)) p++;
+        if (p == q || p >= l + ln || *p != ':') continue;
+        p++; q = p; while (p < l + ln && (*p == ' ' || *p == '\t')) p++;
+        if (p == q) continue;
+        g = p; while (p < l + ln && (isxdigit((unsigned char)*p) || *p == ' ')) p++;
+        ge = p; while (p < l + ln && (*p == ' ' || *p == '\t')) p++;
+        if (p >= l + ln || *p != '|') continue;
+        if (ge == p) { if (ge == g || ge[-1] != ' ') continue; ge--; }   /* \s+ before | takes a space back */
+        for (q = g; q < ge; q++) {
+            int v;
+            if (*q == ' ') continue;
+            v = isdigit((unsigned char)*q) ? *q - '0' : (tolower((unsigned char)*q) - 'a' + 10);
+            if (half < 0) half = v; else { x[m++] = (unsigned char)(half << 4 | v); half = -1; }
+        }
+    }
+    CHECK(half < 0, "odd number of hex digits in the dump");
+    free(out); *xn = m;
+    return x;
+}
+
+static int is_exec(const char *p) { struct stat st; return !stat(p, &st) && S_ISREG(st.st_mode) && !access(p, X_OK); }
+static char *find_tool(void) {
+    static char buf[4200]; const char *path = getenv("PATH"); const char *s;
+    static const char *const fixed[2] = { "/opt/homebrew/opt/llvm/bin/llvm-readobj", "/usr/local/opt/llvm/bin/llvm-readobj" };
+    int i;
+    for (s = path; s && *s; ) {
+        const char *e = strchr(s, ':'); size_t n = e ? (size_t)(e - s) : strlen(s);
+        snprintf(buf, sizeof buf, "%.*s/llvm-readobj", (int)(n ? n : 1), n ? s : ".");
+        if (is_exec(buf)) return buf;
+        s = e ? e + 1 : 0;
+    }
+    for (i = 0; i < 2; i++) if (!access(fixed[i], F_OK)) return (char *)fixed[i];
+    return 0;
+}
+
+int main(int argc, char **argv) {
+    const char *ape_path = "unisacc.com", *tool = 0; size_t an, hn, opt, cnt, i, end = 0, rn, xn;
+    unsigned char *ape, *info, *ext; Sect *s; char version[64], hex[65]; int k;
+    for (k = 1; k < argc; k++) {
+        if (!strcmp(argv[k], "--ape") && k + 1 < argc) ape_path = argv[++k];
+        else if (!strncmp(argv[k], "--ape=", 6)) ape_path = argv[k] + 6;
+        else if (!strcmp(argv[k], "--llvm-readobj") && k + 1 < argc) tool = argv[++k];
+        else if (!strncmp(argv[k], "--llvm-readobj=", 15)) tool = argv[k] + 15;
+        else { fprintf(stderr, "usage: apeversioncheck.cx [--ape APE] [--llvm-readobj TOOL]\n"); return 2; }
+    }
+    if (!tool && !(tool = find_tool())) fail("RuntimeError: llvm-readobj required; missing is not a passing check", 0);
+    if (!(ape = (unsigned char *)cx_read(ape_path, &an))) fail("FileNotFoundError: ", ape_path);
+    cnt = layout(ape, an, &opt, &s);
+    for (i = 0; i < cnt; i++) if (s[i].raw + s[i].size > end) end = s[i].raw + s[i].size;
+    free(s);
+    CHECK(end < an, "expected complete frozen APE with appended Unix slices");
+    hn = end;
+    CHECK(u32(ape, hn, opt + 128) || u32(ape, hn, opt + 132), "frozen APE PE head carries no VERSIONINFO resource");
+    product_version(version, sizeof version);
+    info = resource_bytes(ape, hn, &rn);
+    fields(info, rn, version);
+    ext = external(tool, ape, hn, &xn);
+    CHECK(xn == rn && !memcmp(ext, info, rn), "llvm-readobj extracted other VERSIONINFO bytes");
+    fields(ext, xn, version);
+    printf("frozen-ape-pe-head: llvm-readobj ProductName=Unisacc ProductVersion=%s matches src/version.h\n", version);
+    cx_sha256_hex(ape, hn, hex);
+    printf("real head sha256=%s\n", hex);
+    free(ape); free(info); free(ext);
+    return 0;
+}
