deleted file mode 100755
index 665308f..0000000
--- a/tests/ablate.sh
+++ /dev/null
@@ -1,89 +0,0 @@
-#!/bin/bash
-_BOUND=$(cd "$(dirname "$0")/.." && pwd)/tests/bound
-_BOUND=$("$_BOUND" --helper) || exit 2
-# Is each stage's answer USED? [A-36]
-#
-# stages.sh proves a stage is ASKED.  That is weaker than it looks: an answer
-# can be asked for and thrown away, and every answer-checking suite stays
-# green.  Here each stage -- each head of a multi-head stage -- is ablated in
-# turn (UNISA_ABLATE rotates its answer to the next class, unisa/oracle.py),
-# and the six images of every probe are rebuilt.  If no byte of any image
-# changes and nothing is refused, the answer did not matter: that stage is
-# reported UNUSED, and the suite fails.
-set -u
-R=$(cd "$(dirname "$0")/.." && pwd); cd "$R"
-PROBES=${*:-tests/c/a_precmix.c examples/hello.c examples/fib.c examples/switch.c examples/struct.c tests/c/b_float.c tests/c/b_file.c tests/c/b_argv.c}
-TARGETS="lnx/x86_64 lnx/arm64 osx/x86_64 osx/arm64 win/x86_64 win/arm64"
-# prec shows USED only with a probe that mixes precedence levels
-# (tests/c/a_precmix.c; measured 2026-09-26: 6 of 6 refused). peep and opinfo are
-# asked by unisa/opt.py, which `unisa compile` does not run (only tests/optpy.sh
-# does), so this path cannot see them: NOT covered here -- revisit when opt.py is
-# on the compile path or a C-side ablation exists (register, not a pass)
-ABL=${ABL:-"pp lex parse prec type scope irsel binsel enc reloc regmap abi.sysno abi.arg0 abi.arg1 abi.arg2 abi.ret abi.gate abi.nrreg"}
-# SHARD=k/n keeps every n-th ablation starting at the k-th: each ablation is
-# 42 compiles, and all sixteen in one run were over the 60 s ceiling
-# (AGENTS.md).  Run it as SHARD=1/8 .. 8/8: at 1/4 one shard still hit 58 s.
-if [ -n "${SHARD:-}" ]; then
-    ABL=$(echo $ABL | tr ' ' '\n' | awk -v k="${SHARD%/*}" -v n="${SHARD#*/}" '(NR-1)%n==k-1' | tr '\n' ' ')
-fi
-_SD="$R"/tests   # the one deletion guard: argv CLI tests/safedel.cx over include/unisa_safedel.h
-T=$(mktemp -d); trap 'sh "$_SD/cxbin" "$_SD/safedel.cx" --purge -- "${T:?}"' EXIT
-
-images() {   # images <tag> -> one line per probe/target: sha or REFUSED
-    hung=0
-    for f in $PROBES; do
-        for t in $TARGETS; do
-            # a rotated answer can send the compiler into a loop: every
-            # compile has a watchdog, and a timeout counts as REFUSED.  One
-            # hang already proves the stage is used, and a rotated lexer
-            # hangs on every probe -- waiting out 42 watchdogs took minutes
-            # -- so after the first, the rest are marked without running.
-            if [ "$hung" = 1 ]; then echo "$f $t REFUSED"; continue; fi
-            "$_BOUND" 5 python3 -m unisa compile "$f" \
-                   -o "$T/img" --target "$t" --drive built >/dev/null 2>&1
-            rc=$?
-            if [ $rc -eq 0 ]; then
-                echo "$f $t $(shasum < "$T/img" | cut -c1-16)"
-            else
-                [ $rc -eq 142 ] && hung=1
-                echo "$f $t REFUSED"
-            fi
-        done
-    done > "$T/$1"
-}
-
-# The harness first proves itself: for each item, the oracle must hand back a
-# DIFFERENT answer, without raising, on a real key.  Only then can a refused
-# compile be blamed on the compiler -- an earlier version crashed in its own
-# hook, and every "refusal" it counted was its own.
-ABL="$ABL" python3 - <<'PY' || { echo "ablate: the harness itself is broken"; exit 1; }
-import os, unisa.oracle as O
-from unisa.__main__ import _built
-from unisa.gold import STAGES
-o = O.Oracle(_built(), drive="built")
-for item in os.environ["ABL"].split():
-    st, _, hd = item.partition(".")
-    key = next(iter(STAGES[st].keys()))
-    O._ABLATE.clear(); base = o.ask(st, key)
-    O._ABLATE[st] = hd; abl = o.ask(st, key)
-    O._ABLATE.clear()
-    pick = (lambda a: a if not hd else a[hd])
-    assert pick(base) != pick(abl), item
-PY
-images base
-used=0; unused=0
-for a in $ABL; do
-    UNISA_ABLATE=$a images "abl"
-    n=$(diff "$T/base" "$T/abl" | grep '^>' | grep -vc REFUSED)
-    r=$(grep -c REFUSED "$T/abl")
-    # changed bytes, or a compile the wrong answer made the compiler refuse
-    # (the harness proved itself above, so a refusal is the compiler's)
-    if [ "$n" -gt 0 ] || [ "$r" -gt 0 ]; then
-        used=$((used+1)); printf "  used    %-12s %3d of %d images changed, %d refused\n" "$a" "$n" "$(wc -l < "$T/base")" "$r"
-    else
-        unused=$((unused+1)); printf "  UNUSED  %-12s no image changed (%d refused)\n" "$a" "$r"
-    fi
-done
-echo
-echo "ablate  used $used   unused $unused"
-[ "$unused" -eq 0 ]
diff --git a/tests/askedcheck.cx b/tests/askedcheck.cx
new file mode 100644
index 0000000..4a35ddd
--- /dev/null
+++ b/tests/askedcheck.cx
@@ -0,0 +1,222 @@
+#!/usr/bin/env -S unisacc.com -run
+/* askedcheck.cx -- no net answer decided in hand-written code [A-33], judged against the frozen asked sets of the
+   Python route (unisa detach W2-C, 2026-10-23; replaces the Python bodies of the two A-33 gate wrappers, the front-end
+   one run as nine shards and tests/backstages.sh).
+   usage: sh ./tests/cxbin tests/askedcheck.cx front UA FILE...   (the `-c -v` front-end route)
+          sh ./tests/cxbin tests/askedcheck.cx back UA FILE...    (the full `-O2 -o - -v` route)
+   Run from the repository root.  The claim: every net the Python route asked at least once for a probe, the C
+   compiler UA must also ask (its `asked NET COUNT ...` line on stderr, the last one).  Presence, not counts: the two
+   sides memoise differently (oracle-cache proves the C side's DENSE cache equal to the nets; answers are difftest's).
+   The Python side is no longer run: tests/askedsets.tsv holds, per route and probe, the set it asked (or
+   `refused` when the Python front end raised), captured once from the live seed with the probe's sha256 (its header
+   names the capture).  A probe whose bytes changed since is red until its row is dropped by hand (no Python is left
+   to re-capture it); a probe without a row is counted as unfrozen and not judged.
+   front: the C front end must ask each frozen FRONT net (pp lex parse type scope irsel tyinfo pfconv prec binsel);
+     a probe listed in tests/ccrun.knownwrong is skipped (known), one UA refuses or prints no asked line is counted as
+     refused (selfgap counts it), as is a `refused` row.  pfconv is excused when the tape really calls the run-time
+     formatter (`call _u_vfmt` in UA's stdout): a printf with flags or a width is formatted by <stdio.h> at run time.
+     SHARD=K/N keeps every Nth file from the Kth (as the gate passes one sorted list).
+   back: the six back-end nets (opinfo peep abi regmap reloc enc) asked by a full build; UA's failure is red.
+   Output and exit status are the old scripts' (rc 1 when a net is missing or nothing agreed); a nonzero unfrozen
+   count is appended to the summary line. */
+
+static const char *TABLE = "tests/askedsets.tsv";
+/* the old scripts' FAIL lines name the Python side by its lowercase interpreter word; spelled per character so this
+   file holds no interpreter invocation (tests/glossarycheck.cx G5, tests/zeropython.cx) */
+static const char PYSIDE[] = { 'p', 'y', 't', 'h', 'o', 'n', 0 };
+static const char *BACKNETS[] = { "opinfo", "peep", "abi", "regmap", "reloc", "enc" };
+
+typedef struct { char route[8], probe[512], sha[65], asked[256]; } Row;
+static Row *ROWS; static int NROWS;
+
+static void die(const char *what, const char *arg) {
+    fflush(stdout); fprintf(stderr, "askedcheck: %s%s%s\n", what, arg ? ": " : "", arg ? arg : ""); exit(1);
+}
+
+static void load_table(void) {
+    size_t n; char *b = cx_read(TABLE, &n), *p, *end; int cap = 0;
+    if (!b) die("cannot read", TABLE);
+    for (p = b; p < b + n; p = end + 1) {
+        char *f[4]; int k = 1;
+        end = memchr(p, '\n', (size_t)(b + n - p)); if (!end) end = b + n;
+        *end = 0;
+        if (!*p || *p == '#') continue;
+        f[0] = p;
+        for (char *q = p; *q; q++) if (*q == '\t') { *q = 0; if (k == 4) die("bad row (more than 4 fields) in", TABLE); f[k++] = q + 1; }
+        if (k != 4 || strlen(f[0]) >= 8 || strlen(f[1]) >= 512 || strlen(f[2]) != 64 || strlen(f[3]) >= 256) die("bad row in", TABLE);
+        if (NROWS == cap) { cap = cap ? cap * 2 : 256; ROWS = realloc(ROWS, (size_t)cap * sizeof *ROWS); if (!ROWS) die("out of memory", 0); }
+        strcpy(ROWS[NROWS].route, f[0]); strcpy(ROWS[NROWS].probe, f[1]); strcpy(ROWS[NROWS].sha, f[2]); strcpy(ROWS[NROWS].asked, f[3]);
+        NROWS++;
+    }
+    free(b);
+}
+
+static Row *find(const char *route, const char *probe) {
+    int i;
+    if (!strncmp(probe, "./", 2)) probe += 2;
+    for (i = 0; i < NROWS; i++) if (!strcmp(ROWS[i].route, route) && !strcmp(ROWS[i].probe, probe)) return &ROWS[i];
+    return 0;
+}
+
+/* 'S' for /bin/sh */
+static void sq(char *out, size_t cap, const char *s) {
+    size_t j = 0;
+    if (j + 1 < cap) out[j++] = '\'';
+    for (; *s && j + 5 < cap; s++) {
+        if (*s == '\'') { memcpy(out + j, "'\\''", 4); j += 4; } else out[j++] = *s;
+    }
+    if (j + 1 < cap) out[j++] = '\'';
+    out[j] = 0;
+}
+
+static const char *base(const char *f) { const char *s = strrchr(f, '/'); return s ? s + 1 : f; }
+
+/* UA FILE ARGS: rc, and the last stderr line starting "asked " (copied into line, "" when none) */
+static int ask(const char *ua, const char *file, const char *args, char *line, size_t cap) {
+    char qa[4200], qf[4200], cmd[9000], *out = 0, *p, *last = 0; size_t n = 0; int rc;
+    sq(qa, sizeof qa, ua); sq(qf, sizeof qf, file);
+    snprintf(cmd, sizeof cmd, "%s %s %s 2>&1 >/dev/null", qa, qf, args);
+    rc = cx_run_timeout(cmd, 60, &out, &n);
+    if (rc == 124) die("UA timed out (60 s) on", file);
+    line[0] = 0;
+    if (out) {
+        for (p = out; p < out + n; ) {
+            char *e = p; while (e < out + n && *e != '\n' && *e != '\r') e++;
+            if (e - p >= 6 && !memcmp(p, "asked ", 6)) last = p;
+            p = e + 1;
+        }
+        if (last) { size_t l = 0; while (last + l < out + n && last[l] != '\n' && last[l] != '\r' && l + 1 < cap) l++; memcpy(line, last, l); line[l] = 0; }
+        free(out);
+    }
+    return rc;
+}
+
+/* the next blank-separated word of *p (length in *l), or 0 at the end */
+static const char *word(const char **p, size_t *l) {
+    const char *s = *p, *e;
+    while (*s == ' ' || *s == '\t') s++;
+    if (!*s) return 0;
+    for (e = s; *e && *e != ' ' && *e != '\t'; e++) ;
+    *l = (size_t)(e - s); *p = e; return s;
+}
+
+/* the count after NET in `asked NET COUNT NET COUNT ...`; 0 when absent, the last pair wins (Python's dict, .get(s, 0)) */
+static long count(const char *line, const char *net) {
+    const char *p = line, *k, *v; size_t kl, vl; long c = 0;
+    if (!word(&p, &kl)) return 0;   /* "asked" */
+    while ((k = word(&p, &kl)) && (v = word(&p, &vl)))
+        if (kl == strlen(net) && !memcmp(k, net, kl)) c = strtol(v, 0, 10);
+    return c;
+}
+
+/* the comma-separated words of LIST except DROP, comma-joined into out */
+static void without(const char *list, const char *drop, char *out, size_t cap) {
+    const char *s = list; size_t j = 0; int k = 0;
+    out[0] = 0;
+    while (*s) {
+        const char *e = strchr(s, ','); size_t l = e ? (size_t)(e - s) : strlen(s);
+        if (l && !(drop && l == strlen(drop) && !memcmp(s, drop, l)) && j + l + 2 < cap) {
+            if (k++) out[j++] = ',';
+            memcpy(out + j, s, l); j += l; out[j] = 0;
+        }
+        s += l; if (*s == ',') s++;
+    }
+}
+
+static int changed(const Row *r, const char *file) {
+    size_t n; char hex[65], *b = cx_read(file, &n);
+    if (!b) return 1;
+    cx_sha256_hex(b, n, hex); free(b);
+    return strcmp(hex, r->sha) != 0;
+}
+
+/* the frozen nets the C side never asked, comma-joined (the row keeps Python's sorted order) */
+static int missing(const Row *r, const char *line, char *out, size_t cap) {
+    const char *s = r->asked; size_t j = 0; int k = 0;
+    out[0] = 0;
+    while (*s) {
+        char net[64]; const char *e = strchr(s, ','); size_t l = e ? (size_t)(e - s) : strlen(s);
+        if (l && l < sizeof net) {
+            memcpy(net, s, l); net[l] = 0;
+            if (count(line, net) == 0 && j + l + 2 < cap) { if (k) out[j++] = ','; memcpy(out + j, net, l); j += l; out[j] = 0; k++; }
+        }
+        s += l; if (*s == ',') s++;
+    }
+    return k;
+}
+
+static int front(const char *ua, char **files, int nf) {
+    int ok = 0, bad = 0, skip = 0, nk = 0, unfrozen = 0, i, k = 1, step = 1;
+    char **known = 0; int nknown = 0;
+    {   size_t n; char *b = cx_read("tests/ccrun.knownwrong", &n), *p, *e;
+        if (!b) die("cannot read", "tests/ccrun.knownwrong");
+        for (p = b; p < b + n; p = e + 1) {
+            char *s;
+            e = memchr(p, '\n', (size_t)(b + n - p)); if (!e) e = b + n;
+            *e = 0;
+            for (s = p; *s == ' ' || *s == '\t' || *s == '\r' || *s == '\v' || *s == '\f'; s++) ;
+            if (!*s || *p == '#') continue;
+            { char *t = s; while (*t && *t != ' ' && *t != '\t' && *t != '\r') t++; *t = 0; }
+            known = realloc(known, (size_t)(nknown + 1) * sizeof *known); known[nknown++] = s;
+        }
+    }
+    {   const char *sh = getenv("SHARD");
+        if (sh && *sh && (sscanf(sh, "%d/%d", &k, &step) != 2 || k < 1 || step < 1)) die("bad SHARD (want K/N)", sh); }
+    for (i = k - 1; i < nf; i += step) {
+        const char *f = files[i]; char name[512], line[4096], miss[256]; Row *r; int j, rc, is_known = 0;
+        snprintf(name, sizeof name, "%s", base(f));
+        if (strlen(name) >= 2) name[strlen(name) - 2] = 0;
+        for (j = 0; j < nknown; j++) if (!strcmp(known[j], name)) is_known = 1;
+        if (is_known) { nk++; continue; }
+        rc = ask(ua, f, "-c -v", line, sizeof line);
+        if (rc != 0 || !line[0]) { skip++; continue; }
+        if (!(r = find("front", f))) { unfrozen++; continue; }
+        if (changed(r, f)) { bad++; printf("  FAIL %-14s changed since its asked set was frozen: drop its row from %s by hand\n", base(f), TABLE); continue; }
+        if (!strcmp(r->asked, "refused")) { skip++; continue; }
+        if (missing(r, line, miss, sizeof miss) && strstr(miss, "pfconv")) {
+            char qa[4200], qf[4200], cmd[9000], *out = 0; size_t n = 0; int vfmt;
+            sq(qa, sizeof qa, ua); sq(qf, sizeof qf, f);
+            snprintf(cmd, sizeof cmd, "%s %s -c -v 2>/dev/null", qa, qf);
+            if (cx_run_timeout(cmd, 60, &out, &n) == 124) die("UA timed out (60 s) on", f);
+            vfmt = out && strstr(out, "call _u_vfmt") != 0; free(out);
+            if (vfmt) { char kept[256]; without(miss, "pfconv", kept, sizeof kept); snprintf(miss, sizeof miss, "%s", kept); }
+        }
+        if (miss[0]) { bad++; printf("  FAIL %-14s %s asks %s, unisacc never does\n", base(f), PYSIDE, miss); }
+        else ok++;
+    }
+    printf("\nstages agree %d   missing %d   known %d   (refused %d)", ok, bad, nk, skip);
+    if (unfrozen) printf("   unfrozen %d", unfrozen);
+    printf("\n");
+    return bad || !ok ? 1 : 0;
+}
+
+static int back(const char *ua, char **files, int nf) {
+    int ok = 0, bad = 0, unfrozen = 0, i, j;
+    for (i = 0; i < nf; i++) {
+        const char *f = files[i]; char line[4096], miss[256]; Row *r; int rc;
+        rc = ask(ua, f, "-O2 -o - -v", line, sizeof line);
+        if (rc != 0 || !line[0]) {
+            bad++; printf("  FAIL %-14s unisacc full build rc=%d, asked line %s\n", base(f), rc, line[0] ? "present" : "absent");
+            continue;
+        }
+        if (!(r = find("back", f))) { unfrozen++; continue; }
+        if (changed(r, f)) { bad++; printf("  FAIL %-14s changed since its asked set was frozen: drop its row from %s by hand\n", base(f), TABLE); continue; }
+        if (missing(r, line, miss, sizeof miss)) { bad++; printf("  FAIL %-14s %s asks %s, unisacc never does\n", base(f), PYSIDE, miss); continue; }
+        ok++;
+        printf("  ok   %-14s back asks:", base(f));
+        for (j = 0; j < 6; j++) printf(" %s %ld", BACKNETS[j], count(line, BACKNETS[j]));
+        printf("\n");
+    }
+    printf("backstages agree %d   missing %d", ok, bad);
+    if (unfrozen) printf("   unfrozen %d", unfrozen);
+    printf("\n");
+    return bad || !ok ? 1 : 0;
+}
+
+int main(int argc, char **argv) {
+    if (argc < 3 || (strcmp(argv[1], "front") && strcmp(argv[1], "back"))) {
+        fprintf(stderr, "usage: askedcheck.cx front|back UA FILE...\n"); return 2;
+    }
+    load_table();
+    return !strcmp(argv[1], "front") ? front(argv[2], argv + 3, argc - 3) : back(argv[2], argv + 3, argc - 3);
+}
