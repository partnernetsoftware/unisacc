+
+def _aside(entry):   # a present entry that does not verify is renamed away (never deleted here)
+    dest = entry.with_name('%s.broken-%d-%d' % (entry.name, time.time_ns(), os.getpid()))
+    os.rename(entry, dest)
+    print('tapebin ref moved aside %s' % dest.name)
+
+
