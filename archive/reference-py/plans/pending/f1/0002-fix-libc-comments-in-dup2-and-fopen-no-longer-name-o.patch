From 2e37a8befae4937de6c516f9e9c84ff7b549d390 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Fri, 23 Oct 2026 10:53:25 +0800
Subject: [PATCH 2/8] fix(libc): comments in dup2 and fopen no longer name open
 -- -ftrim-libc stops pulling open() into programs

---
 include/stdio.h  | 4 ++--
 include/unistd.h | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/include/stdio.h b/include/stdio.h
index 6409fb7..95b3832 100644
--- a/include/stdio.h
+++ b/include/stdio.h
@@ -281,7 +281,7 @@ static long fread(void *__u_p, long __u_sz, long __u_n, FILE *__u_f) {
 static FILE *fopen(const char *__u_path, const char *__u_mode) {
     int __u_fd;
 #ifdef _WIN32
-    /* Windows has no open(2), and CreateFileA wants its own shapes.  They
+    /* Windows has no POSIX file-opening call, and CreateFileA wants its own shapes.  They
        are built HERE and not in the encoder, because this is the only place
        that knows whether the program is being compiled for Windows. */
     long __u_access;
@@ -320,7 +320,7 @@ static FILE *fopen(const char *__u_path, const char *__u_mode) {
         /* The gate answers -errno on Linux and Darwin (see the __write audit
            above); Windows' CreateFileA gate answers -1.  Without this line
            errno stayed 0 and sbase said "fopen /nonexistent: Success"
-           [R13-0b #25].  A bare -1 is reported as ENOENT: an open that
+           [R13-0b #25].  A bare -1 is reported as ENOENT: an fopen that
            failed with no code is almost always a missing file. */
         errno = 0 - __u_fd;
 #ifdef _WIN32
diff --git a/include/unistd.h b/include/unistd.h
index f8df793..a0515d3 100644
--- a/include/unistd.h
+++ b/include/unistd.h
@@ -292,7 +292,7 @@ static int dup2(int __u_old, int __u_new) {
 #if defined(__APPLE__) || defined(__x86_64__)
     return (int)_unisa_ret(__syscall6(_UNISA_SC(_UNISA_NR_dup2), __u_old, __u_new, 0, 0, 0));
 #else
-    if (__u_old == __u_new) { long __u_r; __u_r = __fcntl(__u_old, 1, 0); return __u_r < 0 ? (int)_unisa_ret(__u_r) : __u_new; }   /* F_GETFD: is it open */
+    if (__u_old == __u_new) { long __u_r; __u_r = __fcntl(__u_old, 1, 0); return __u_r < 0 ? (int)_unisa_ret(__u_r) : __u_new; }   /* F_GETFD: is OLD a valid descriptor */
     return (int)_unisa_ret(__syscall6(_UNISA_NR_dup3, __u_old, __u_new, 0, 0, 0));
 #endif
 }
