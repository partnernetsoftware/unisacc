From eb8fd2b606f6d05abbe3df77574da96d44617e47 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Fri, 23 Oct 2026 10:53:26 +0800
Subject: [PATCH 5/8] fix(libc): fileno

---
 include/stdio.h          |  8 ++++++++
 tests/c/fileno_streams.c | 23 +++++++++++++++++++++++
 2 files changed, 31 insertions(+)
 create mode 100644 tests/c/fileno_streams.c

diff --git a/include/stdio.h b/include/stdio.h
index 5c06392..ec7f1bc 100644
--- a/include/stdio.h
+++ b/include/stdio.h
@@ -1297,6 +1297,14 @@ static FILE *fdopen(int __u_fd, const char *__u_mode) {
     return (FILE *)(long)__u_fd;
 }
 #endif
+/* fileno (POSIX), 0.0.43: fdopen's inverse -- the descriptor the FILE * stands for, 0..2 for
+   the standard streams; a null stream is EBADF (glibc would fault) */
+#if !__UNISA_FTRIM_LIBC || __UN_fileno
+static int fileno(FILE *__u_f) {
+    if (__u_f == NULL) { errno = 9; return -1; }   /* EBADF */
+    return _unisa_fd(__u_f);
+}
+#endif
 /* popen/pclose (POSIX), 0.0.34: a pipe (socketpair on macOS, as pipe() in unistd.h), a fork, and
    /bin/sh -c in the child with the pipe end on fd 0 or 1 -- the raw calls system() uses, so this
    header still needs no <unistd.h>.  pclose waits for the child and returns its wait status. */
diff --git a/tests/c/fileno_streams.c b/tests/c/fileno_streams.c
new file mode 100644
index 0000000..5fc9208
--- /dev/null
+++ b/tests/c/fileno_streams.c
@@ -0,0 +1,23 @@
+/* fileno (POSIX) names the descriptor of a stream; the carried libc had none
+   ("undefined function 'fileno'" under -run and when compiling). */
+#include <stdio.h>
+#include <string.h>
+#ifndef _WIN32
+#include <unistd.h>
+#endif
+int main(void) {
+    FILE *f; int fd, bad = 0;
+    if (fileno(stdin) != 0 || fileno(stdout) != 1 || fileno(stderr) != 2) bad |= 1;
+    f = fopen("fileno_streams.tmp", "w+");
+    if (!f) return 99;
+    fd = fileno(f);
+    if (fd <= 2) bad |= 2;
+    fputs("abc", f); fflush(f);
+#ifndef _WIN32   /* the descriptor is the stream's: read back through it */
+    {   char buf[8];
+        if (lseek(fd, 0, SEEK_SET) != 0 || read(fd, buf, 3) != 3 || memcmp(buf, "abc", 3) != 0) bad |= 4; }
+#endif
+    fclose(f); remove("fileno_streams.tmp");
+    printf("fileno bad=%d\n", bad);
+    return bad;
+}
