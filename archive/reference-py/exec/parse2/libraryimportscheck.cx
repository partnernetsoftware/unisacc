#!/usr/bin/env -S unisacc.com -run
/* libraryimportscheck.cx -- exec/parse2/libraryimportscheck.py in C (2026-10-23, the py->cx port wave; the owner's
   direction: the toolchain moves off Python).  Private E3 injected bindings proof.  Explicit typed tokens isolate the
   e3 stream-stage; no root product rebuild; the wrapper tape proof is distinct from native ABI execution.
   usage: sh ./unisacc.com -run exec/parse2/libraryimportscheck.cx -- [DELTA.json [OUT]]
   The e3 model: with no argument it is constructed fresh, as the .py did with exec/build/gen.py parse2 -- here by
   seed/gen.c (byte-identical to gen.py on parse2, ~6 s against ~35 s), and `parse2 states N` is printed on stderr as
   gen.py printed it; with DELTA.json that delta is used.  The .py ran the delta in its Python simulator
   (exec/pp/sim.py); here the delta becomes the flat table and the threshold network through seed/tbl.c and
   seed/net.c (byte-identical to exec/c/tbl.py and exec/c/net.py) and runs in exec/c/run.c, the C machine of sim.py,
   action for action.  Each run is one stream-stage route (`c`: e3, tokens -> tape) in an uncompressed P1/P2
   package written here: the model, and when the fixture has bindings the resource \0library/bindings (the key the
   .py put into sim.Files).  sim.run's maxsteps=100000 is UNISA_MAXSTEPS=100000 (run.c: rc 0 accept, 1 reject, 3 out
   of steps); the accepted wrapper's step count, which sim.run returned and the .py prints, is the least step budget
   under which run.c accepts (run.c and sim.py both stop after exactly maxsteps steps), found by bisection.
   The checks are the .py's, in its order: the real wrapper is accepted with one hostadd label, the call, the
   .librarycall sequence and the frame epilogue; two wide native addresses survive untruncated; no bindings, every
   proper prefix of the binding blob, a trailing byte, a bad magic, unsupported, kind 1, a wrong argument count and a
   4-byte descriptor all reject; a source without the prototype rejects; base/shape local IDs are ignored; an empty
   binding table rejects.  Then the summary line on stdout, rc 0, and with OUT the accepted tape is written there.
   A failed check is the .py's uncaught AssertionError: one `AssertionError: ...` line on stderr (the traceback frames
   are not reproduced), rc 1; a failed child (cc, seed tool) is the CalledProcessError line, rc 1.
   The tools are built here with $SEED_GEN_CC (default cc) -std=c99 -O2 -w for the seed tools and $EXEC_CC (default
   cc) -O2 for run.c, in parallel, in a fresh directory TMPDIR (TEMP, TMP, /tmp)/libimports-XXXXXX.  ROOT is the
   grandparent of this file's directory.
   Module note: `#pragma unisa use` resolves beside the using file only, so tests/cxlib/pytempfile.cx is reached
   through the exec/parse2/cxlib/ symlink (the exec/c/cxlib/ precedent); the scratch removal goes through its
   ptf_rmtree, guarded here (only the directory this run created with mkdtemp, by its libimports- name). */
#pragma unisa use cxlib.pytempfile

#define PATHN 4096
static char ROOT[PATHN], TD[PATHN];
static int TD_MADE;

/* ---------- scratch: removal of the directory this run made (guarded) ---------- */
static void scratch_remove(void) {
    const char *base;
    if (!TD_MADE || TD[0] != '/') return;
    base = strrchr(TD, '/'); base = base ? base + 1 : TD;
    if (strncmp(base, "libimports-", 11) || strlen(base) != 17) return;
    TD_MADE = 0;
    ptf_rmtree(TD);
}
static void quit(int rc) { fflush(stdout); fflush(stderr); scratch_remove(); exit(rc); }
static void fail(const char *line) {   /* an uncaught Python exception: its last line */
    fflush(stdout);
    fprintf(stderr, "%s\n", line);
    quit(1);
}
static void *xmalloc(size_t n) { void *p = malloc(n ? n : 1); if (!p) fail("MemoryError"); return p; }

/* ---------- bytes ---------- */
typedef struct Buf { unsigned char *p; size_t n, cap; } Buf;
static void bput(Buf *b, const void *s, size_t n) {
    if (b->n + n + 1 > b->cap) {
        size_t c = b->cap ? b->cap : 256;
        while (c < b->n + n + 1) c *= 2;
        b->p = realloc(b->p, c);
        if (!b->p) fail("MemoryError");
        b->cap = c;
    }
    if (n) memcpy(b->p + b->n, s, n);
    b->n += n; b->p[b->n] = 0;
}
static void bstr(Buf *b, const char *s) { bput(b, s, strlen(s)); }
static void bbyte(Buf *b, unsigned c) { unsigned char x = (unsigned char)c; bput(b, &x, 1); }
static void bU(Buf *b, unsigned long long v) {   /* struct.pack('<Q', v) */
    unsigned char q[8]; int i;
    for (i = 0; i < 8; i++) q[i] = (unsigned char)(v >> (8 * i));
    bput(b, q, 8);
}
static void bfree(Buf *b) { free(b->p); b->p = 0; b->n = b->cap = 0; }
static int has(const unsigned char *s, size_t n, const char *needle) {
    size_t m = strlen(needle), i;
    if (m > n) return 0;
    for (i = 0; i + m <= n; i++) if (!memcmp(s + i, needle, m)) return 1;
    return 0;
}
static size_t count(const unsigned char *s, size_t n, const char *needle) {   /* bytes.count: non-overlapping */
    size_t m = strlen(needle), i = 0, c = 0;
    while (m && i + m <= n) { if (!memcmp(s + i, needle, m)) { c++; i += m; } else i++; }
    return c;
}
static int endswith(const unsigned char *s, size_t n, const char *tail) {
    size_t m = strlen(tail);
    return n >= m && !memcmp(s + n - m, tail, m);
}
static char *path2(const char *a, const char *b) {
    size_t n = strlen(a) + strlen(b) + 2; char *p = xmalloc(n); snprintf(p, n, "%s/%s", a, b); return p;
}
static void putfile(const char *path, const void *p, size_t n) {
    if (cx_write(path, p, n)) {
        char line[PATHN + 64]; snprintf(line, sizeof line, "OSError: cannot write '%s'", path); fail(line);
    }
}

/* ---------- children: stdout and stderr captured into files of the scratch directory ---------- */
typedef struct Res { int rc; char *out; size_t outn; char *err; size_t errn; } Res;
static void res_free(Res *r) { free(r->out); free(r->err); r->out = r->err = 0; }
static char *repr_args(char *const argv[]) {   /* repr(list of str) for plain ASCII words */
    Buf b = { 0, 0, 0 }; int i;
    bstr(&b, "[");
    for (i = 0; argv[i]; i++) { if (i) bstr(&b, ", "); bstr(&b, "'"); bstr(&b, argv[i]); bstr(&b, "'"); }
    bstr(&b, "]");
    return (char *)b.p;
}
/* start ARGV (PATH lookup) with ENVP (0: ours) in CWD (0: ours); stdout/stderr into TD/.out-K, TD/.err-K */
static pid_t start(char *const argv[], char *const envp[], const char *cwd, int k) {
    char op[PATHN], ep[PATHN]; int of, ef; pid_t pid;
    snprintf(op, sizeof op, "%s/.out-%d", TD, k); snprintf(ep, sizeof ep, "%s/.err-%d", TD, k);
    of = open(op, O_WRONLY | O_CREAT | O_TRUNC, 0600); ef = open(ep, O_WRONLY | O_CREAT | O_TRUNC, 0600);
    if (of < 0 || ef < 0) fail("OSError: cannot capture output");
    fflush(stdout); fflush(stderr);
    pid = fork();
    if (pid < 0) fail("OSError: fork failed");
    if (pid == 0) {
        int nul = open("/dev/null", O_RDONLY);
        if (nul >= 0) { dup2(nul, 0); close(nul); }
        dup2(of, 1); dup2(ef, 2); close(of); close(ef);
        if (cwd && chdir(cwd)) _exit(127);
        if (envp) execve(argv[0], argv, envp); else execvp(argv[0], argv);
        _exit(127);
    }
    close(of); close(ef);
    return pid;
}
static void finish(pid_t pid, int k, Res *r) {
    char op[PATHN], ep[PATHN]; int st = 0;
    while (waitpid(pid, &st, 0) < 0) if (errno != EINTR) fail("ChildProcessError: wait failed");
    r->rc = WIFSIGNALED(st) ? -WTERMSIG(st) : WEXITSTATUS(st);
    snprintf(op, sizeof op, "%s/.out-%d", TD, k); snprintf(ep, sizeof ep, "%s/.err-%d", TD, k);
    r->out = cx_read(op, &r->outn); r->err = cx_read(ep, &r->errn);
    if (!r->out) { r->out = xmalloc(1); r->outn = 0; }
    if (!r->err) { r->err = xmalloc(1); r->errn = 0; }
}
static void checked(char *const argv[], const Res *r) {   /* subprocess.run(..., check=True) */
    if (r->rc) {
        char line[PATHN * 2], *a = repr_args(argv);
        if (r->rc == 127 && !r->outn && !r->errn) snprintf(line, sizeof line, "FileNotFoundError: [Errno 2] No such file or directory: '%s'", argv[0]);
        else snprintf(line, sizeof line, "subprocess.CalledProcessError: Command '%s' returned non-zero exit status %d.", a, r->rc);
        fflush(stdout);
        if (r->errn) fwrite(r->err, 1, r->errn, stderr);   /* the child's stderr was the caller's */
        fail(line);
    }
}

/* ---------- the e3 model: seed tools, delta -> table -> network ---------- */
static const char *envor(const char *k, const char *d) { const char *v = getenv(k); return v && *v ? v : d; }
static void build_tools(int construct) {
    char *gen = path2(TD, "seed-gen"), *tbl = path2(TD, "seed-tbl"), *net = path2(TD, "seed-net"), *run = path2(TD, "run");
    char *seed = path2(ROOT, "seed"), *scc = (char *)envor("SEED_GEN_CC", "cc"), *ecc = (char *)envor("EXEC_CC", "cc");
    char *a0[] = { scc, "-std=c99", "-O2", "-w", "-I", seed, path2(ROOT, "seed/gen.c"), "-o", gen, 0 };
    char *a1[] = { scc, "-std=c99", "-O2", "-w", "-I", seed, path2(ROOT, "seed/tbl.c"), "-o", tbl, 0 };
    char *a2[] = { scc, "-std=c99", "-O2", "-w", "-I", seed, path2(ROOT, "seed/net.c"), "-o", net, 0 };
    char *a3[] = { ecc, "-O2", path2(ROOT, "exec/c/run.c"), "-o", run, 0 };
    char **all[4]; pid_t pid[4]; Res r[4]; int i, first = construct ? 0 : 1;
    all[0] = a0; all[1] = a1; all[2] = a2; all[3] = a3;
    for (i = first; i < 4; i++) pid[i] = start(all[i], 0, 0, i);
    for (i = first; i < 4; i++) finish(pid[i], i, &r[i]);
    for (i = first; i < 4; i++) { checked(all[i], &r[i]); res_free(&r[i]); }
}
static void tool(char **argv, const char *cwd) {
    Res r; pid_t pid = start(argv, 0, cwd, 0);
    finish(pid, 0, &r); checked(argv, &r); res_free(&r);
}

/* len(delta['states']): the members of the top-level "states" object (JSON text, strings respected) */
static const char *skip_ws(const char *p, const char *e) { while (p < e && (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r')) p++; return p; }
static const char *skip_str(const char *p, const char *e) {   /* p at '"': past the closing quote */
    for (p++; p < e; p++) { if (*p == '\\') p++; else if (*p == '"') return p + 1; }
    return 0;
}
static const char *skip_value(const char *p, const char *e) {
    int depth = 0;
    p = skip_ws(p, e);
    if (p >= e) return 0;
    if (*p == '"') return skip_str(p, e);
    if (*p != '{' && *p != '[') { while (p < e && !strchr(",]} \t\r\n", *p)) p++; return p; }
    while (p < e) {
        if (*p == '"') { p = skip_str(p, e); if (!p) return 0; continue; }
        if (*p == '{' || *p == '[') depth++;
        else if (*p == '}' || *p == ']') { if (--depth == 0) return p + 1; }
        p++;
    }
    return 0;
}
static long object_members(const char *p, const char *e, const char *want, const char **at) {   /* p at '{' */
    long n = 0;
    p = skip_ws(p + 1, e);
    if (p < e && *p == '}') return 0;
    while (p < e && *p == '"') {
        const char *k = p, *v; p = skip_str(p, e); if (!p) return -1;
        p = skip_ws(p, e); if (p >= e || *p != ':') return -1;
        v = skip_ws(p + 1, e);
        if (want && (size_t)(p - k) >= 2 && (size_t)(skip_ws(k, p) - k) == 0) {
            const char *ke = k + 1; while (ke < p && *ke != '"') ke++;
            if ((size_t)(ke - k - 1) == strlen(want) && !memcmp(k + 1, want, strlen(want))) *at = v;
        }
        p = skip_value(v, e); if (!p) return -1;
        n++;
        p = skip_ws(p, e);
        if (p < e && *p == ',') { p = skip_ws(p + 1, e); continue; }
        if (p < e && *p == '}') return n;
        return -1;
    }
    return -1;
}
static long states_of(const char *json, size_t n) {
    const char *e = json + n, *p = skip_ws(json, e), *at = 0; long c;
    if (p >= e || *p != '{' || object_members(p, e, "states", &at) < 0 || !at || *at != '{') fail("json.decoder.JSONDecodeError: the delta is not a JSON object with a states object");
    c = object_members(at, e, 0, 0);
    if (c < 0) fail("json.decoder.JSONDecodeError: the delta's states object is malformed");
    return c;
}

/* ---------- fixtures ---------- */
static const char *TOKENS = "type=long\nid=hostadd\n(\ntype=long\nid=a\n,\ntype=long\nid=b\n)\n;\ntype\nid=main\n(\ntype=void\n)\n{\n"
    "return\nid=hostadd\n(\nnum=10\n,\nnum=20\n)\n==\nnum=30\n?\nnum=0\n:\nnum=1\n;\n}\neof\n32 tokens\n";
static void desc6(Buf *b, unsigned long long a, unsigned long long c, unsigned long long d, unsigned long long k,
                  unsigned long long w, unsigned long long f) {
    bU(b, a); bU(b, c); bU(b, d); bU(b, k); bU(b, w); bU(b, f);
}
/* binding(desc, nargs, supported, kind, address) */
static Buf binding(const Buf *desc, unsigned long long nargs, unsigned supported, unsigned kind, unsigned long long address) {
    Buf payload = { 0, 0, 0 }, o = { 0, 0, 0 }, d = { 0, 0, 0 }; unsigned long long i;
    if (desc) bput(&d, desc->p, desc->n); else desc6(&d, 0, 0, 0, 1, 8, 0);
    bU(&payload, 7); bstr(&payload, "hostadd");
    bbyte(&payload, kind); bbyte(&payload, 0); bbyte(&payload, 0); bbyte(&payload, 0);
    bU(&payload, address); bU(&payload, nargs);
    for (i = 0; i < 1 + nargs; i++) bput(&payload, d.p, d.n);
    bbyte(&payload, supported);
    bstr(&o, "USBIND1\n"); bU(&o, 1); bU(&o, payload.n); bput(&o, payload.p, payload.n);
    bfree(&payload); bfree(&d);
    return o;
}

/* ---------- one e3 run: the package, then run.c ---------- */
static char *NET, *PKG, *TOK, *RUN; static size_t NETN;
static char **ENVP; static size_t ENVN; static char MAXSTEPS[48];
static void make_envp(void) {   /* os.environ with UNISA_MAXSTEPS replaced (setenv does not reach execve children) */
    size_t n = 0, i;
    while (environ && environ[n]) n++;
    ENVP = xmalloc((n + 2) * sizeof *ENVP);
    for (i = 0; i < n; i++) if (strncmp(environ[i], "UNISA_MAXSTEPS=", 15)) ENVP[ENVN++] = environ[i];
    ENVP[ENVN++] = MAXSTEPS; ENVP[ENVN] = 0;
}
/* status: 'accept' 1, 'reject' 0, 'timeout' 2; OUT the accepted tape */
static int execute(const Buf *raw, const char *tokens, size_t tokn, long maxsteps, Buf *out) {
    Buf pkg = { 0, 0, 0 }; char line[160]; Res r; pid_t pid; int st;
    char *argv[] = { RUN, "--bundle", PKG, "c", TOK, "typed-fixture", 0 };
    snprintf(line, sizeof line, raw ? "P 2 1 1 1\n" : "P 1 1 1\n"); bstr(&pkg, line);
    bstr(&pkg, "D c e3 tokens tape 0\n");
    snprintf(line, sizeof line, "M %lu\n", (unsigned long)NETN); bstr(&pkg, line); bput(&pkg, NET, NETN);
    if (raw) {
        snprintf(line, sizeof line, "F 17 %lu\n", (unsigned long)raw->n); bstr(&pkg, line);
        bput(&pkg, "\0library/bindings", 17); bput(&pkg, raw->p, raw->n);
    }
    putfile(PKG, pkg.p, pkg.n); bfree(&pkg);
    putfile(TOK, tokens, tokn);
    snprintf(MAXSTEPS, sizeof MAXSTEPS, "UNISA_MAXSTEPS=%ld", maxsteps);
    pid = start(argv, ENVP, TD, 0); finish(pid, 0, &r);
    if (r.rc == 0) st = 1; else if (r.rc == 1) st = 0; else if (r.rc == 3) st = 2;
    else {
        char msg[1200]; int k = r.errn > 500 ? (int)(r.errn - 500) : 0;
        snprintf(msg, sizeof msg, "RuntimeError: e3 run failed (rc %d): %.*s", r.rc, (int)(r.errn - k), r.err + k);
        fail(msg);
    }
    if (out) { out->n = 0; bput(out, r.out, r.outn); }
    res_free(&r);
    return st;
}
static void check(int ok, const char *what) {
    if (!ok) { char line[512]; snprintf(line, sizeof line, "AssertionError%s%s", what ? ": " : "", what ? what : ""); fail(line); }
}

int main(int argc, char **argv) {
    char here[PATHN], *slash, *json, *delta_path, line[512]; size_t jn, i, tokn = strlen(TOKENS); long states, n, lo, hi;
    Buf raw, out = { 0, 0, 0 }, high = { 0, 0, 0 }, bad, d = { 0, 0, 0 }; int v, construct = argc == 1, controls = 0;
    const char *tmp; unsigned long long wide[2] = { 0x123456789abcdULL, 0x7fffffffffffffffULL };

    /* ROOT = Path(__file__).resolve().parents[2] */
    snprintf(here, sizeof here, "%s", __FILE__);
    slash = strrchr(here, '/');
    if (slash) *slash = 0; else snprintf(here, sizeof here, ".");
    { char t[PATHN]; snprintf(t, sizeof t, "%s/../..", here); if (!realpath(t, ROOT)) fail("FileNotFoundError: cannot resolve the repository root"); }

    /* tempfile.TemporaryDirectory(prefix='libimports-') */
    tmp = getenv("TMPDIR");
    if (!tmp || !*tmp || access(tmp, W_OK)) tmp = getenv("TEMP");
    if (!tmp || !*tmp || access(tmp, W_OK)) tmp = getenv("TMP");
    if (!tmp || !*tmp || access(tmp, W_OK)) tmp = "/tmp";
    { char t[PATHN]; snprintf(t, sizeof t, "%s/libimports-XXXXXX", tmp); if (!mkdtemp(t)) fail("OSError: cannot create the temporary directory");
      if (!realpath(t, TD)) fail("OSError: cannot resolve the temporary directory"); TD_MADE = 1; }

    build_tools(construct);
    if (construct) {   /* build(): exec/build/gen.py parse2 OUT, here seed/gen.c (it opens exec/... relative to ROOT) */
        char *a[] = { path2(TD, "seed-gen"), "parse2", path2(TD, "parse.json"), 0 };
        tool(a, ROOT);
        delta_path = a[2];
    } else delta_path = argv[1];
    json = cx_read(delta_path, &jn);
    if (!json) { snprintf(line, sizeof line, "FileNotFoundError: [Errno 2] No such file or directory: '%s'", delta_path); fail(line); }
    states = states_of(json, jn); free(json);
    if (construct) { fprintf(stderr, "parse2 states %ld\n", states); fflush(stderr); }
    {   /* the delta as the flat table, the table as the threshold network */
        char *t[] = { path2(TD, "seed-tbl"), (char *)delta_path, path2(TD, "parse.tbl"), 0 };
        char *nt[] = { path2(TD, "seed-net"), t[2], path2(TD, "parse.net"), 0 };
        tool(t, 0); tool(nt, 0);
        NET = cx_read(nt[2], &NETN);
        if (!NET) fail("OSError: the network was not written");
    }
    PKG = path2(TD, "e3.pkg"); TOK = path2(TD, "tokens"); RUN = path2(TD, "run");
    make_envp();

    raw = binding(0, 2, 1, 0, 4096);
    v = execute(&raw, TOKENS, tokn, 100000, &out);
    check(v == 1, "the real wrapper was not accepted");
    /* the accepted wrapper's steps: the least budget run.c accepts under */
    lo = 1; hi = 100000;
    while (lo < hi) { long mid = lo + (hi - lo) / 2; if (execute(&raw, TOKENS, tokn, mid, 0) == 1) hi = mid; else lo = mid + 1; }
    n = lo;
    check(count(out.p, out.n, "hostadd:\n") == 1 && has(out.p, out.n, "call hostadd\n"), 0);
    check(has(out.p, out.n, "  imm r1, 4096\n  mov r0, r7\n  .librarycall r1, r0\n"), 0);
    check(endswith(out.p, out.n, "  .frame -48\n  ret\n"), 0);
    for (i = 0; i < 2; i++) {
        Buf b = binding(0, 2, 1, 0, wide[i]); char want[64];
        check(execute(&b, TOKENS, tokn, 100000, &high) == 1, 0);
        snprintf(want, sizeof want, "  imm r1, %llu\n", wide[i]);
        check(has(high.p, high.n, want), "native address was truncated");
        bfree(&b);
    }
    check(execute(0, TOKENS, tokn, 100000, 0) == 0, 0);   /* undefined source function, no fake FND */
    for (i = 1; i < raw.n + 7; i++) {   /* raw[:i] for i in 1..len-1, raw+X, X+raw[1:], four signature controls */
        Buf b = { 0, 0, 0 };
        if (i < raw.n) bput(&b, raw.p, i);
        else if (i == raw.n) { bput(&b, raw.p, raw.n); bstr(&b, "X"); }
        else if (i == raw.n + 1) { bstr(&b, "X"); bput(&b, raw.p + 1, raw.n - 1); }
        else if (i == raw.n + 2) b = binding(0, 2, 0, 0, 4096);
        else if (i == raw.n + 3) b = binding(0, 2, 1, 1, 4096);
        else if (i == raw.n + 4) b = binding(0, 1, 1, 0, 4096);
        else if (i == raw.n + 5) { Buf d4 = { 0, 0, 0 }; desc6(&d4, 0, 0, 0, 1, 4, 0); b = binding(&d4, 2, 1, 0, 4096); bfree(&d4); }
        else break;
        if (execute(&b, TOKENS, tokn, 100000, 0) != 0) {
            snprintf(line, sizeof line, "('invalid binding accepted', %lu)", (unsigned long)b.n); check(0, line);
        }
        controls++;
        bfree(&b);
    }
    {   /* no_prototype = TOKENS[TOKENS.index(b'type\nid=main'):] */
        const char *np = strstr(TOKENS, "type\nid=main");
        check(execute(&raw, np, strlen(np), 100000, 0) == 0, 0);
    }
    /* base/shape local IDs are ignored, ABI descriptor fields remain identical */
    desc6(&d, 0, 999, 777, 1, 8, 0);
    bad = binding(&d, 2, 1, 0, 4096);
    check(execute(&bad, TOKENS, tokn, 100000, 0) == 1, 0);
    bfree(&bad);
    {   /* empty = USBIND1 + U(0): the unresolved actual call remains */
        Buf empty = { 0, 0, 0 }; bstr(&empty, "USBIND1\n"); bU(&empty, 0);
        check(execute(&empty, TOKENS, tokn, 100000, 0) == 0, 0);
        bfree(&empty);
    }
    printf("USBIND1 E3: %ld states; real wrapper accepted %ld steps; %d malformed/signature controls reject; base/shape local IDs ignored; no native runtime claim\n",
           states, n, controls);
    if (argc > 2) putfile(argv[2], out.p, out.n);
    quit(0);
    return 0;
}
