#!/usr/bin/env -S unisacc.com -run
/* windowshostbridgecheck.cx -- exec/enc/windowshostbridgecheck.py in C (2026-10-23, the py->cx port wave; owner's
   goal: no Python in the toolchain).  Independent Win64 declaration assembly and an actual ten-GP MS ABI probe.  On
   macOS x86_64/Rosetta it executes MS ABI calls; not Windows SEH qualification.
   usage: sh ./unisacc.com -run exec/enc/windowshostbridgecheck.cx -- [--part {all,cross,native}]   (default all)
   - The declarations are the win_x86_64 / win_arm64 `body` rows of ROOT/exec/enc/hostbridge.tsv (what unisa/hostabi.py
     exports as WIN_X86_BODY bytes and WIN_ARM_BODY words); a row that is not three tab fields is the .py's import
     failure (rc 1).
   - --part native first requires a darwin-x86_64 execution host (tests/hostcheck.py require_host, here
     tests/cxlib/hostcheck.cx): elsewhere one UNVERIFIED line on stdout, rc 77.
   - clang and llvm-objcopy are $LLVM_BIN/clang and $LLVM_BIN/llvm-objcopy when LLVM_BIN is set and non-empty, else
     shutil.which (PATH); without clang (or, unless native, llvm-objcopy): `Win64 declaration check requires clang and
     llvm-objcopy` on stderr, rc 1.
   - cross/all: the reference bridge text for x86_64 and arm64 is assembled by clang to COFF, its .text dumped by
     llvm-objcopy, and must equal the declarations byte for byte (arm64 as little-endian words); no arm64 word may name
     x18 as Rt/Rd or Rn.  Then `COFF byte declaration verified: x86_64 and arm64`; --part cross ends there, rc 0.
   - all/native on Darwin (after require_host darwin-x86_64): probe.c + probe.s carrying the x86_64 body, built with
     `clang -arch x86_64 -O2` and run (its stripped stdout printed); the same probe with the one rcx restore
     (48 8b 4c 24 68) replaced by five NOPs must exit 1, then `missing rcx restore mutant rejected: ok`.  Off Darwin:
     `UNVERIFIED: required=Darwin/native-msabi observed=SYSTEM/MACHINE missing=native-msabi-probe target=win/x86_64,
     win/arm64` on stdout, rc 77.
   Every tool run is captured (stdout and stderr) with a 20 s limit; a nonzero exit is the .py's AssertionError:
   its last line on stderr, rc 1.  The scratch directory is tempfile.TemporaryDirectory(prefix='r10-winhost-template-'),
   removed on every exit through tests/cxlib/pytempfile.cx.  Argument errors follow argparse (usage +
   `windowshostbridgecheck.py: error: ...` on stderr, rc 2; -h/--help prints the help, rc 0); --part may be abbreviated
   and takes `--part=V`.  ROOT is Path(__file__).resolve().parents[2].  tests/cxlib/hostcheck.cx and
   tests/cxlib/pytempfile.cx are used through the exec/enc/cxlib/ symlinks (`#pragma unisa use` resolves beside the
   using file only; the tests/flownet/*.cx and exec/c/cxlib/ precedent). */
#pragma unisa use cxlib.hostcheck
#pragma unisa use cxlib.pytempfile

#define PATHN 4096
static char ROOT[PATHN], TD[PATHN], CAPO[PATHN], CAPE[PATHN];
static int capo = -1, cape = -1;

static const char ASM[] =
    ".text\n.globl bridge\nbridge:\n pushq %rbx\n movq %rax,%rbx\n movq %rsp,%rax\n subq $176,%rsp\n andq $-16,%rsp\n"
    " movq %rdi,80(%rsp)\n movq %rsi,88(%rsp)\n movq %rdx,96(%rsp)\n movq %rcx,104(%rsp)\n movq %r8,112(%rsp)\n"
    " movq %r9,120(%rsp)\n movq %rax,136(%rsp)\n movq 32(%rbx),%rax\n movq %rax,32(%rsp)\n movq 40(%rbx),%rax\n"
    " movq %rax,40(%rsp)\n movq 48(%rbx),%rax\n movq %rax,48(%rsp)\n movq 56(%rbx),%rax\n movq %rax,56(%rsp)\n"
    " movq 64(%rbx),%rax\n movq %rax,64(%rsp)\n movq 72(%rbx),%rax\n movq %rax,72(%rsp)\n movq 0(%rbx),%rcx\n"
    " movq 8(%rbx),%rdx\n movq 16(%rbx),%r8\n movq 24(%rbx),%r9\n callq *%r11\n movq 80(%rsp),%rdi\n"
    " movq 88(%rsp),%rsi\n movq 96(%rsp),%rdx\n movq 104(%rsp),%rcx\n movq 112(%rsp),%r8\n movq 120(%rsp),%r9\n"
    " movq 136(%rsp),%rsp\n popq %rbx\n";
static const char ARM_ASM[] =
    ".text\n.globl bridge\nbridge:\n mov x9, sp\n sub x10, x9, #128\n and x10, x10, #0xfffffffffffffff0\n mov sp, x10\n"
    " str x1, [sp, #16]\n str x2, [sp, #24]\n str x3, [sp, #32]\n str x4, [sp, #40]\n str x5, [sp, #48]\n"
    " str x6, [sp, #56]\n str x7, [sp, #64]\n str x9, [sp, #72]\n str x30, [sp, #80]\n ldr x11, [x17, #64]\n"
    " str x11, [sp, #0]\n ldr x11, [x17, #72]\n str x11, [sp, #8]\n ldr x0, [x17, #0]\n ldr x1, [x17, #8]\n"
    " ldr x2, [x17, #16]\n ldr x3, [x17, #24]\n ldr x4, [x17, #32]\n ldr x5, [x17, #40]\n ldr x6, [x17, #48]\n"
    " ldr x7, [x17, #56]\n blr x16\n ldr x1, [sp, #16]\n ldr x2, [sp, #24]\n ldr x3, [sp, #32]\n ldr x4, [sp, #40]\n"
    " ldr x5, [sp, #48]\n ldr x6, [sp, #56]\n ldr x7, [sp, #64]\n ldr x9, [sp, #72]\n ldr x30, [sp, #80]\n mov sp, x9\n";
static const char PROBE_C[] =
    "#include <stdint.h>\n#include <stdio.h>\nextern void probe(void*,uint64_t*,uint64_t*);\n"
    "__attribute__((ms_abi,noinline)) uint64_t host(uint64_t a,uint64_t b,uint64_t c,uint64_t d,uint64_t e,uint64_t f,"
    "uint64_t g,uint64_t h,uint64_t i,uint64_t j) {\n uint64_t r=a+2*b+3*c+4*d+5*e+6*f+7*g+8*h+9*i+10*j;\n"
    " __asm__ volatile(\"mov $999,%%rcx;mov $888,%%rdx;mov $777,%%r8;mov $666,%%r9;mov $555,%%r10;mov $444,%%r11\":::"
    "\"rcx\",\"rdx\",\"r8\",\"r9\",\"r10\",\"r11\");return r;\n}\n"
    "int main(void){uint64_t v[8]={0,1,UINT32_MAX,UINT64_C(0x100000000),INT64_MAX,UINT64_C(0x8000000000000000),"
    "UINT64_MAX,UINT64_C(0x123456789abcdef0)};for(int i=0;i<64;i++){uint64_t a[10],o[9]={0},want=0;for(int j=0;j<10;j++)"
    "{a[j]=v[(i+j)%8]+i;want+=(j+1)*a[j];}probe((void*)host,a,o);\n"
    " if(o[0]!=want||o[1]!=17||o[2]!=34||o[3]!=51||o[4]!=68||o[5]!=85||o[6]!=102||o[7]!=119||o[8]!=1)return 1;}"
    "puts(\"64 ten-GP MS-ABI register/stack calls and restores: ok\");return 0;}\n";

/* ---- the .py's uncaught exception: last traceback line, TemporaryDirectory removed, rc 1 ---- */
static void cleanup(void) { if (TD[0]) { ptf_rmtree(TD); TD[0] = 0; } }
static void die(const char *kind, const char *msg) {
    fflush(stdout);
    if (msg && *msg) fprintf(stderr, "%s: %s\n", kind, msg); else fprintf(stderr, "%s\n", kind);
    cleanup(); exit(1);
}
static void writeb(const char *p, const void *b, size_t n) {
    if (cx_write(p, b, n)) { char m[PATHN + 64]; snprintf(m, sizeof m, "cannot write '%s'", p); die("OSError", m); }
}

/* ---- subprocess.run(list(map(str, args)), capture_output=True, timeout=20) ---- */
typedef struct { int rc; char *out; size_t outn; char *err; size_t errn; } Res;
static void run(char *const *argv, Res *r) {
    pid_t pid; int st = 0; long ticks = 2000;
    if (capo < 0) {
        snprintf(CAPO, sizeof CAPO, "%s/.stdoutXXXXXX", TD); snprintf(CAPE, sizeof CAPE, "%s/.stderrXXXXXX", TD);
        if ((capo = mkstemp(CAPO)) < 0 || (cape = mkstemp(CAPE)) < 0) die("OSError", "cannot create capture files");
    }
    if (ftruncate(capo, 0) || ftruncate(cape, 0)) die("OSError", "cannot reset capture files");
    lseek(capo, 0, SEEK_SET); lseek(cape, 0, SEEK_SET);
    fflush(stdout); fflush(stderr);
    if (strchr(argv[0], '/') && access(argv[0], F_OK)) {
        char m[PATHN + 64]; snprintf(m, sizeof m, "[Errno 2] No such file or directory: '%s'", argv[0]); die("FileNotFoundError", m);
    }
    pid = fork();
    if (pid < 0) die("OSError", "fork failed");
    if (pid == 0) {
        setpgid(0, 0); dup2(capo, 1); dup2(cape, 2); close(capo); close(cape);
        execvp(argv[0], argv); _exit(127);
    }
    for (;;) {
        pid_t w = waitpid(pid, &st, WNOHANG);
        if (w == pid) break;
        if (w < 0) die("OSError", "waitpid failed");
        if (ticks-- <= 0) {
            char m[PATHN + 64];
            kill(-pid, SIGKILL); kill(pid, SIGKILL); waitpid(pid, &st, 0);
            snprintf(m, sizeof m, "Command '%s' timed out after 20 seconds", argv[0]); die("subprocess.TimeoutExpired", m);
        }
        usleep(10000);
    }
    r->rc = (st & 0x7f) ? -(st & 0x7f) : (st >> 8) & 0xff;
    r->out = cx_read(CAPO, &r->outn); r->err = cx_read(CAPE, &r->errn);
    if (!r->out || !r->err) die("OSError", "cannot read captured output");
}
/* command(args): rc 0 or AssertionError((args, rc, stdout, stderr)); stdout returned (malloc'd) */
static char *command(char *const *argv, size_t *n) {
    Res r; run(argv, &r);
    if (r.rc) {
        char m[8192]; size_t k = r.errn < 4000 ? r.errn : 4000;
        snprintf(m, sizeof m, "(['%s', ...], %d, ..., b'%.*s')", argv[0], r.rc, (int)k, r.err);
        die("AssertionError", m);
    }
    free(r.err); *n = r.outn; return r.out;
}

/* ---- the declarations: exec/enc/hostbridge.tsv (unisa/hostabi.py) ---- */
static unsigned char *X86; static size_t NX86; static unsigned long *ARMW; static size_t NARM;
static int hexval(int c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1; }
static void load_declarations(void) {
    char p[PATHN + 64], *t, *line, *next; size_t n; int x86 = 0;
    snprintf(p, sizeof p, "%s/exec/enc/hostbridge.tsv", ROOT);
    if (!(t = cx_read(p, &n))) { char m[PATHN + 100]; snprintf(m, sizeof m, "[Errno 2] No such file or directory: '%s'", p); die("FileNotFoundError", m); }
    X86 = malloc(n + 1); ARMW = malloc((n + 1) * sizeof *ARMW);
    if (!X86 || !ARMW) die("MemoryError", 0);
    for (line = t; line && *line; line = next) {
        char *f[4], *s; int k = 1;
        next = strchr(line, '\n'); if (next) *next++ = 0;
        if (!*line || *line == '#') continue;
        f[0] = line;
        for (s = line; *s; s++) if (*s == '\t') { *s = 0; if (k < 4) f[k] = s + 1; k++; }
        if (k != 3) die("ValueError", k < 3 ? "not enough values to unpack (expected 3)" : "too many values to unpack (expected 3)");
        if (!strcmp(f[0], "win_x86_64") && !strcmp(f[1], "body") && !x86) {   /* bytes.fromhex(first such row) */
            const char *h = f[2]; x86 = 1;
            while (*h) {
                int a, b;
                if (*h == ' ' || *h == '\t' || *h == '\r') { h++; continue; }
                a = hexval(h[0]); b = a < 0 ? -1 : hexval(h[1]);
                if (a < 0 || b < 0) die("ValueError", "non-hexadecimal number found in fromhex() arg");
                X86[NX86++] = (unsigned char)(a * 16 + b); h += 2;
            }
        } else if (!strcmp(f[0], "win_arm64") && !strcmp(f[1], "body")) {   /* int(v, 16) */
            char *e; const char *h = f[2];
            while (*h == ' ' || *h == '\t') h++;
            if (!*h || *h == '-' || *h == '+') die("ValueError", "invalid literal for int() with base 16");
            ARMW[NARM++] = strtoul(h, &e, 16);
            while (*e == ' ' || *e == '\t' || *e == '\r') e++;
            if (*e) die("ValueError", "invalid literal for int() with base 16");
        }
    }
    if (!x86) die("StopIteration", 0);
    free(t);
}

/* ---- shutil.which ---- */
static int which(const char *name, char *out, size_t cap) {
    const char *path = getenv("PATH"), *s; char cand[PATHN];
    if (!path) path = "/bin:/usr/bin";
    for (s = path;;) {
        const char *e = strchr(s, ':'); size_t l = e ? (size_t)(e - s) : strlen(s); struct stat st;
        if (l) snprintf(cand, sizeof cand, "%.*s/%s", (int)l, s, name); else snprintf(cand, sizeof cand, "%s", name);
        if (stat(cand, &st) == 0 && !S_ISDIR(st.st_mode) && access(cand, X_OK) == 0) { snprintf(out, cap, "%s", cand); return 1; }
        if (!e) break;
        s = e + 1;
    }
    return 0;
}

/* ---- argparse: [-h] [--part {all,cross,native}] ---- */
static const char USAGE[] = "usage: windowshostbridgecheck.py [-h] [--part {all,cross,native}]\n";
static void argerr(const char *m) { fputs(USAGE, stderr); fprintf(stderr, "windowshostbridgecheck.py: error: %s\n", m); exit(2); }
static int negnum(const char *s) {
    const char *p = s + 1; int d = 0;
    if (s[0] != '-') return 0;
    while (*p >= '0' && *p <= '9') { p++; d = 1; }
    if (!*p) return d;
    if (*p != '.') return 0;
    p++; if (!*p) return 0;
    while (*p >= '0' && *p <= '9') p++;
    return !*p;
}
static const char *parse_args(int argc, char **argv) {
    static char extra[8192]; const char *part = "all"; int i, rest = 0; size_t xn = 0;
    extra[0] = 0;
#define EXTRA(a) do { xn += (size_t)snprintf(extra + xn, xn < sizeof extra ? sizeof extra - xn : 0, "%s%s", xn ? " " : "", (a)); if (xn >= sizeof extra) xn = sizeof extra - 1; } while (0)
    for (i = 1; i < argc; i++) {
        const char *a = argv[i], *eq, *val = 0; size_t al; int help = 0, prt = 0;
        if (rest || a[0] != '-' || !a[1] || negnum(a)) { EXTRA(a); continue; }
        if (!strcmp(a, "--")) { rest = 1; EXTRA(a); continue; }
        eq = a[1] == '-' ? strchr(a, '=') : 0; al = eq ? (size_t)(eq - a) : strlen(a);
        if (!strcmp(a, "-h") || (a[1] == '-' && al > 2 && !strncmp("--help", a, al))) help = 1;
        else if (a[1] == '-' && al > 2 && !strncmp("--part", a, al)) prt = 1;
        if (!help && !prt) { EXTRA(a); continue; }
        if (eq) val = eq + 1;
        if (help) {
            if (val) { char m[600]; snprintf(m, sizeof m, "argument -h/--help: ignored explicit argument '%s'", val); argerr(m); }
            fputs(USAGE, stdout);
            fputs("\nIndependent Win64 declaration assembly and actual ten-GP MS ABI probe. On\n"
                  "macOS x86_64/Rosetta executes MS ABI calls; not Windows SEH qualification.\n\n"
                  "options:\n  -h, --help            show this help message and exit\n  --part {all,cross,native}\n", stdout);
            exit(0);
        }
        if (!val) {
            if (i + 1 >= argc || rest || (argv[i + 1][0] == '-' && argv[i + 1][1] && !negnum(argv[i + 1])))
                argerr("argument --part: expected one argument");
            val = argv[++i];
        }
        if (strcmp(val, "all") && strcmp(val, "cross") && strcmp(val, "native")) {
            char m[600]; snprintf(m, sizeof m, "argument --part: invalid choice: '%s' (choose from 'all', 'cross', 'native')", val); argerr(m);
        }
        part = val;
    }
    if (xn) { char m[8300]; snprintf(m, sizeof m, "unrecognized arguments: %s", extra); argerr(m); }
#undef EXTRA
    return part;
}

/* ---- main(part) ---- */
static void path(char *out, const char *name) { snprintf(out, PATHN, "%s/%s", TD, name); }
int main(int argc, char **argv) {
    const char *part, *llvm; char self[PATHN], clang[PATHN], objcopy[PATHN], sys[256], mach[256];
    int k, rc, have_clang, have_objcopy; size_t n;
    if (!realpath(__FILE__, self)) die("FileNotFoundError", __FILE__);
    for (k = 0; k < 3; k++) { char *s = strrchr(self, '/'); if (s && s != self) *s = 0; else { strcpy(self, "/"); break; } }
    snprintf(ROOT, sizeof ROOT, "%s", self);
    load_declarations();   /* the .py's module-level import of unisa.hostabi, before argparse */
    part = parse_args(argc, argv);
    if (!strcmp(part, "native") && (rc = hc_require_host("darwin-x86_64", "win/x86_64", ROOT))) return rc;
    llvm = getenv("LLVM_BIN");
    if (llvm && *llvm) {
        size_t l = strlen(llvm);
        while (l > 1 && llvm[l - 1] == '/') l--;
        snprintf(clang, sizeof clang, "%.*s/clang", (int)l, llvm); snprintf(objcopy, sizeof objcopy, "%.*s/llvm-objcopy", (int)l, llvm);
        have_clang = have_objcopy = 1;
    } else { have_clang = which("clang", clang, sizeof clang); have_objcopy = which("llvm-objcopy", objcopy, sizeof objcopy); }
    if (!have_clang || (strcmp(part, "native") && !have_objcopy)) {
        fputs("Win64 declaration check requires clang and llvm-objcopy\n", stderr); return 1;
    }
    if (ptf_mkdtemp(0, "r10-winhost-template-", TD, sizeof TD)) { TD[0] = 0; die("FileNotFoundError", "No usable temporary directory found"); }
    if (strcmp(part, "native")) {
        char src[PATHN], obj[PATHN], bin[PATHN], cpy[PATHN], dump[PATHN + 32]; unsigned char *b; size_t i;
        path(src, "bridge.s"); path(obj, "bridge.obj"); path(bin, "bridge.bin"); path(cpy, "bridge-copy.obj");
        writeb(src, ASM, strlen(ASM));
        { char *a[] = { clang, "-target", "x86_64-pc-windows-msvc", "-c", src, "-o", obj, 0 }; free(command(a, &n)); }
        snprintf(dump, sizeof dump, "--dump-section=.text=%s", bin);
        { char *a[] = { objcopy, dump, obj, cpy, 0 }; free(command(a, &n)); }
        if (!(b = (unsigned char *)cx_read(bin, &n))) die("FileNotFoundError", bin);
        if (n != NX86 || memcmp(b, X86, n)) die("AssertionError", "declaration differs from independent assembly");
        free(b);
        path(src, "arm-bridge.s"); path(obj, "arm-bridge.obj"); path(bin, "arm-bridge.bin"); path(cpy, "arm-bridge-copy.obj");
        writeb(src, ARM_ASM, strlen(ARM_ASM));
        { char *a[] = { clang, "-target", "aarch64-pc-windows-msvc", "-c", src, "-o", obj, 0 }; free(command(a, &n)); }
        snprintf(dump, sizeof dump, "--dump-section=.text=%s", bin);
        { char *a[] = { objcopy, dump, obj, cpy, 0 }; free(command(a, &n)); }
        if (!(b = (unsigned char *)cx_read(bin, &n))) die("FileNotFoundError", bin);
        if (n != 4 * NARM) die("AssertionError", 0);
        for (i = 0; i < NARM; i++) {
            unsigned long w = (unsigned long)b[4 * i] | (unsigned long)b[4 * i + 1] << 8 | (unsigned long)b[4 * i + 2] << 16 | (unsigned long)b[4 * i + 3] << 24;
            if (w != ARMW[i]) die("AssertionError", "ARM declaration differs from independent assembly");
        }
        free(b);
        if (!NARM) die("AssertionError", "ARM Win64 ten-argument body missing");
        /* Every ARM declaration word has a register Rt/Rd in bits0..4; no x18 appears there or as memory base Rn.
           No PC-relative instruction uses x18. */
        for (i = 0; i < NARM; i++) if ((ARMW[i] & 31) == 18 || ((ARMW[i] >> 5) & 31) == 18) die("AssertionError", "ARM platform register clobber");
        puts("COFF byte declaration verified: x86_64 and arm64"); fflush(stdout);
        if (!strcmp(part, "cross")) { cleanup(); return 0; }
    }
    hc_uname("-s", sys, sizeof sys);
    if (!strcmp(sys, "Darwin")) {
        char c[PATHN], a[PATHN], exe[PATHN], bad[PATHN]; char *s; size_t i, at = (size_t)-1, cnt = 0; Res r;
        static const unsigned char restore[5] = { 0x48, 0x8b, 0x4c, 0x24, 0x68 };
        static const char *REG[] = { "rdi", "rsi", "rdx", "rcx", "r8", "r9", "rbx" }; static const int VAL[] = { 17, 34, 51, 68, 85, 102, 119 };
        static const char *OUTR[] = { "rax", "rdi", "rsi", "rdx", "rcx", "r8", "r9", "rbx" };
        int pass;
        if ((rc = hc_require_host("darwin-x86_64", "win/x86_64", ROOT))) { cleanup(); return rc; }
        /* Native C callback consumes RCX/RDX/R8/R9 and stack parameters5..10. */
        path(c, "probe.c"); writeb(c, PROBE_C, strlen(PROBE_C));
        path(a, "probe.s");
        for (i = 0; i + 5 <= NX86; i++) if (!memcmp(X86 + i, restore, 5)) { if (at == (size_t)-1) at = i; cnt++; i += 4; }
        for (pass = 0; pass < 2; pass++) {
            size_t cap = 4096 + NX86 * 4, len = 0;
            s = malloc(cap); if (!s) die("MemoryError", 0);
            len += (size_t)snprintf(s + len, cap - len, ".text\n.globl _probe\n_probe:\npushq %%rbx\npushq %%r12\npushq %%r13\n"
                                    "movq %%rdx,%%r12\nmovq %%rsp,%%r13\nmovq %%rdi,%%r11\nmovq %%rsi,%%rax\n");
            for (k = 0; k < 7; k++) len += (size_t)snprintf(s + len, cap - len, "movq $%d,%%%s\n", VAL[k], REG[k]);
            len += (size_t)snprintf(s + len, cap - len, ".byte ");
            for (i = 0; i < NX86; i++) {
                unsigned v = X86[i];
                if (pass && at != (size_t)-1 && i >= at && i < at + 5) v = 0x90;
                len += (size_t)snprintf(s + len, cap - len, "%s%u", i ? "," : "", v);
            }
            len += (size_t)snprintf(s + len, cap - len, "\n");
            for (k = 0; k < 8; k++) len += (size_t)snprintf(s + len, cap - len, "movq %%%s,%d(%%r12)\n", OUTR[k], 8 * k);
            len += (size_t)snprintf(s + len, cap - len, "cmpq %%r13,%%rsp\nsete %%al\nmovzbq %%al,%%rax\nmovq %%rax,64(%%r12)\n"
                                    "popq %%r13\npopq %%r12\npopq %%rbx\nretq\n");
            writeb(a, s, len); free(s);
            if (!pass) {
                char *o, *b, *e;
                path(exe, "probe");
                { char *av[] = { clang, "-arch", "x86_64", "-O2", c, a, "-o", exe, 0 }; free(command(av, &n)); }
                { char *av[] = { exe, 0 }; o = command(av, &n); }
                b = o; e = o + n;
                while (b < e && (*b == ' ' || *b == '\n' || *b == '\t' || *b == '\r' || *b == '\v' || *b == '\f')) b++;
                while (e > b && (e[-1] == ' ' || e[-1] == '\n' || e[-1] == '\t' || e[-1] == '\r' || e[-1] == '\v' || e[-1] == '\f')) e--;
                printf("%.*s\n", (int)(e - b), b); fflush(stdout); free(o);
                if (cnt != 1) die("AssertionError", 0);
            }
        }
        path(bad, "bad-probe");
        { char *av[] = { clang, "-arch", "x86_64", "-O2", c, a, "-o", bad, 0 }; free(command(av, &n)); }
        { char *av[] = { bad, 0 }; run(av, &r); }
        if (r.rc != 1) { char m[200]; snprintf(m, sizeof m, "('missing rcx restore not detected', %d)", r.rc); die("AssertionError", m); }
        free(r.out); free(r.err);
        puts("missing rcx restore mutant rejected: ok"); fflush(stdout);
        cleanup(); return 0;
    }
    hc_uname("-m", mach, sizeof mach);
    printf("UNVERIFIED: required=Darwin/native-msabi observed=%s/%s missing=native-msabi-probe target=win/x86_64,win/arm64\n", sys, mach);
    fflush(stdout);
    cleanup();
    return 77;
}
