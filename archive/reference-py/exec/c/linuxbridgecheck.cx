#!/usr/bin/env -S unisacc.com -run
/* linuxbridgecheck.cx -- exec/c/linuxbridgecheck.py in C (2026-10-23, the py->cx port wave; the owner's direction: the
   toolchain moves off Python).  Cross-assemble both ELF bridges and compare instruction bytes with Mach-O.  This is
   format/symbol evidence, not native Linux execution evidence.
   usage: sh ./unisacc.com -run exec/c/linuxbridgecheck.cx [-- [-h] [--evidence EVIDENCE]]
   env:   LLVM_BIN (default /opt/homebrew/opt/llvm/bin): where llvm-readelf/llvm-objdump are when PATH lacks them.
   Per arch (arm64, x86_64): exec/c/librarycall_ARCH.S assembled by clang for the Linux target (ELF) and with -arch
   (Mach-O), and HEAD's copy (`git -C ROOT show HEAD:exec/c/librarycall_ARCH.S`) with -arch as the baseline; the three
   llvm-objdump -d instruction streams must be equal once normalised (branch targets, <symbol> annotations and the
   '//' vs ';' comment dropped -- archive/research/r12/r12-linuxbridgecheck-diagnosis.md); llvm-readelf -sSW shows one
   ELF GLOBAL FUNC us_library_bridge_raw (no leading underscore) and a non-executable .note.GNU-stack; both Windows
   targets are refused with `does not implement the Windows host ABI`.
   Output: json.dumps(rows) on one line, rc 0; --evidence also writes json.dumps(rows, indent=2) + "\n" there.  Usage
   errors are argparse's (usage line and `linuxbridgecheck.py: error: ...` on stderr, rc 2; -h prints the help, rc 0).
   A failed step is one `linuxbridgecheck: ...` line on stderr where Python printed a traceback (a missing clang is
   `FileNotFoundError: [Errno 2] No such file or directory: 'clang'`), rc 1.  The scratch directory is a
   tempfile.mkdtemp(prefix='unisacc-linuxbridge-check-') tree, removed on every exit through cxlib.pytempfile.
   The repository root is two directories above this file (the .py's Path(__file__).resolve().parents[2]). */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.pytempfile

static char ROOT[4096], D[4096];
static const char USAGE[] = "usage: linuxbridgecheck.py [-h] [--evidence EVIDENCE]\n";

static void cleanup(void) { if (D[0]) { ptf_rmtree(D); D[0] = 0; } }
static void fail(const char *what) {
    fflush(stdout);
    fprintf(stderr, "linuxbridgecheck: %s\n", what);
    cleanup(); exit(1);
}
static void check(int ok, const char *what) { if (!ok) { char t[1024]; snprintf(t, sizeof t, "AssertionError%s%s", *what ? ": " : "", what); fail(t); } }
/* call(ARGS, ok=True): capture_output, timeout 15; with OK the rc must be 0 */
static np_result call(char **argv, int ok) {
    np_result r; char why[8192];
    if (np_run(argv, 0, 0, 15, &r, why, sizeof why)) fail(why);
    if (ok && r.rc != 0) {
        np_buf b = { 0, 0, 0 }; size_t i; char t[32];
        np_puts(&b, "AssertionError: (");
        for (i = 0; argv[i]; i++) { np_puts(&b, i ? ", '" : "['"); np_puts(&b, argv[i]); np_puts(&b, "'"); }
        snprintf(t, sizeof t, "], %d, ", r.rc); np_puts(&b, t);
        np_repr_bytes(&b, r.err, r.errn > 2000 ? 2000 : r.errn); np_puts(&b, ")");
        fail(b.p);
    }
    return r;
}
/* shutil.which(NAME) or LLVM/NAME */
static void tool(const char *name, const char *llvm, char *out, size_t cap) {
    const char *path = getenv("PATH"), *p, *e;
    if (!path) path = "/bin:/usr/bin";
    for (p = path; ; p = e + 1) {
        char cand[4096]; struct stat st; size_t l;
        e = strchr(p, ':'); if (!e) e = p + strlen(p);
        l = (size_t)(e - p);
        if (l) snprintf(cand, sizeof cand, "%.*s/%s", (int)l, p, name); else snprintf(cand, sizeof cand, "%s", name);
        if (stat(cand, &st) == 0 && S_ISREG(st.st_mode) && access(cand, X_OK) == 0) { snprintf(out, cap, "%s", cand); return; }
        if (!*e) break;
    }
    snprintf(out, cap, "%s/%s", llvm, name);
}

static int isws(char c) { return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 11 || c == 12 || (c >= 0x1c && c <= 0x1f); }
static int ishex(char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); }
static int isword(char c) { return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_'; }
/* BR = ^(j\w+|b\w*|call\w*|bl|br|ret|cbz|cbnz|tbz|tbnz)$ */
static int branch(const char *op) {
    size_t i, n = strlen(op);
    if (!strcmp(op, "ret") || !strcmp(op, "cbz") || !strcmp(op, "cbnz") || !strcmp(op, "tbz") || !strcmp(op, "tbnz")) return 1;
    if (op[0] == 'j' && n >= 2) { for (i = 1; i < n && isword(op[i]); i++) ; if (i == n) return 1; }
    if (op[0] == 'b') { for (i = 1; i < n && isword(op[i]); i++) ; if (i == n) return 1; }
    if (!strncmp(op, "call", 4)) { for (i = 4; i < n && isword(op[i]); i++) ; if (i == n) return 1; }
    return 0;
}
/* re.match(r"\s*[0-9a-f]+:\s+[0-9a-f ]+\t(\S+)(.*)", L) with Python's backtracking order: OP and REST, or 0 */
static int insn_match(const char *s, size_t n, size_t *op0, size_t *op1) {
    size_t p = 0, q, w, k, h, hmax;
    while (p < n && isws(s[p])) p++;
    q = p; while (q < n && ishex(s[q])) q++;
    if (q == p || q >= n || s[q] != ':') return 0;
    q++;
    for (w = q; w < n && isws(s[w]); w++) ;
    if (w == q) return 0;
    for (k = w - q; k >= 1; k--) {   /* \s+ takes k characters, the longest first */
        size_t a = q + k;
        for (hmax = 0; a + hmax < n && (ishex(s[a + hmax]) || s[a + hmax] == ' '); hmax++) ;
        for (h = hmax; h >= 1; h--) {
            size_t t = a + h;
            if (t < n && s[t] == '\t' && t + 1 < n && !isws(s[t + 1])) {
                size_t e = t + 1;
                while (e < n && !isws(s[e])) e++;
                *op0 = t + 1; *op1 = e;
                return 1;
            }
        }
    }
    return 0;
}
typedef struct list { char **v; size_t n, cap; } list;
static void list_add(list *l, char *s) {
    if (l->n == l->cap) { l->cap = l->cap ? l->cap * 2 : 64; l->v = realloc(l->v, l->cap * sizeof *l->v); if (!l->v) fail("MemoryError"); }
    l->v[l->n++] = s;
}
/* insns(objdump, path): the normalised instruction list */
static list insns(const char *objdump, const char *path) {
    list r = { 0, 0, 0 }; char *v[4]; np_result o; char why[8192]; size_t p = 0;
    v[0] = (char *)objdump; v[1] = "-d"; v[2] = (char *)path; v[3] = 0;
    if (np_run(v, 0, 0, 15, &o, why, sizeof why)) fail(why);
    while (p < o.outn) {
        size_t e = p, ln, op0, op1, i, rn; const char *s = o.out + p; np_buf rest = { 0, 0, 0 }, norm = { 0, 0, 0 }, item = { 0, 0, 0 };
        while (e < o.outn && o.out[e] != '\n' && o.out[e] != '\r') e++;
        ln = e - p;
        p = e < o.outn ? (o.out[e] == '\r' && e + 1 < o.outn && o.out[e + 1] == '\n' ? e + 2 : e + 1) : e;
        if (!insn_match(s, ln, &op0, &op1)) continue;
        /* rest = re.split(r"//|;", m.group(2))[0]; re.sub(r"<[^>]*>", "", rest); " ".join(rest.split()).rstrip(",") */
        np_put(&rest, "", 0);
        for (i = op1; i < ln; i++) {
            if (s[i] == ';' || (s[i] == '/' && i + 1 < ln && s[i + 1] == '/')) break;
            np_put(&rest, s + i, 1);
        }
        np_put(&norm, "", 0);
        for (i = 0; i < rest.n; i++) {
            if (rest.p[i] == '<') {
                size_t j = i + 1;
                while (j < rest.n && rest.p[j] != '>') j++;
                if (j < rest.n) { i = j; continue; }
            }
            np_put(&norm, rest.p + i, 1);
        }
        rest.n = 0; np_put(&rest, "", 0);
        for (i = 0; i < norm.n;) {
            size_t j;
            while (i < norm.n && isws(norm.p[i])) i++;
            if (i >= norm.n) break;
            for (j = i; j < norm.n && !isws(norm.p[j]); j++) ;
            if (rest.n) np_put(&rest, " ", 1);
            np_put(&rest, norm.p + i, j - i); i = j;
        }
        rn = rest.n; while (rn && rest.p[rn - 1] == ',') rn--;
        np_put(&item, s + op0, op1 - op0);
        if (!branch(item.p)) {
            /* (op + " " + rest).strip() */
            if (rn) { np_put(&item, " ", 1); np_put(&item, rest.p, rn); }
            while (item.n && isws(item.p[item.n - 1])) item.p[--item.n] = 0;
        }
        list_add(&r, item.p);
        free(rest.p); free(norm.p);
    }
    np_free(&o);
    return r;
}
static int list_eq(const list *a, const list *b) {
    size_t i;
    if (a->n != b->n) return 0;
    for (i = 0; i < a->n; i++) if (strcmp(a->v[i], b->v[i])) return 0;
    return 1;
}
static void list_free(list *l) { size_t i; for (i = 0; i < l->n; i++) free(l->v[i]); free(l->v); l->v = 0; l->n = l->cap = 0; }

static unsigned long long le(const char *b, size_t n, size_t at, int w) {
    unsigned long long v = 0; int i;
    if (at + (size_t)w > n) fail("struct.error: unpack_from requires a buffer of more bytes");
    for (i = w - 1; i >= 0; i--) v = v << 8 | (unsigned char)b[at + (size_t)i];
    return v;
}
static size_t slicelen(size_t n, unsigned long long a, unsigned long long l) {   /* len(blob[a:a+l]) */
    unsigned long long e = a + l;
    if (a >= n) return 0;
    if (e > n) e = n;
    return e > a ? (size_t)(e - a) : 0;
}
/* len(text(blob)): the .text section (ELF) or __text section (Mach-O 64) */
static size_t text_len(const char *b, size_t n) {
    if (n >= 4 && !memcmp(b, "\177ELF", 4)) {
        unsigned long long shoff = le(b, n, 40, 8), sn, so; unsigned ents = (unsigned)le(b, n, 58, 2), cnt = (unsigned)le(b, n, 60, 2), si = (unsigned)le(b, n, 62, 2), i;
        if (si >= cnt) fail("IndexError: list index out of range");
        so = le(b, n, (size_t)(shoff + (unsigned long long)si * ents + 24), 8);
        sn = le(b, n, (size_t)(shoff + (unsigned long long)si * ents + 32), 8);
        for (i = 0; i < cnt; i++) {
            size_t h = (size_t)(shoff + (unsigned long long)i * ents), nl = slicelen(n, so, sn), at;
            unsigned long long name;
            le(b, n, h, 4); le(b, n, h + 56, 8);   /* the whole '<IIQQQQIIQQ' header must be there */
            name = le(b, n, h, 4);
            at = (size_t)name;
            /* names[h[0]:].split(b'\0')[0] == b'.text' */
            if (at <= nl && nl - at >= 5 && !memcmp(b + so + at, ".text", 5) && (nl - at == 5 || b[so + at + 5] == 0))
                return slicelen(n, le(b, n, h + 24, 8), le(b, n, h + 32, 8));
        }
    } else {
        unsigned long long ncmds, i, pos = 32;
        check(n >= 4 && !memcmp(b, "\xcf\xfa\xed\xfe", 4), "");
        ncmds = le(b, n, 16, 4);
        for (i = 0; i < ncmds; i++) {
            unsigned long long cmd = le(b, n, (size_t)pos, 4), size = le(b, n, (size_t)pos + 4, 4), j, ns;
            if (cmd == 25) {
                ns = le(b, n, (size_t)pos + 64, 4);
                for (j = 0; j < ns; j++) {
                    size_t a = (size_t)(pos + 72 + j * 80), l = slicelen(n, a, 16);
                    if (l >= 6 && !memcmp(b + a, "__text", 6) && (l == 6 || b[a + 6] == 0))
                        return slicelen(n, le(b, n, a + 48, 4), le(b, n, a + 40, 8));
                }
            }
            pos += size;
        }
    }
    fail("AssertionError: missing text");
    return 0;
}

static void usage_error(const char *msg) {
    fputs(USAGE, stderr);
    fprintf(stderr, "linuxbridgecheck.py: error: %s\n", msg);
    exit(2);
}

int main(int argc, char **argv) {
    static const char *archs[2] = { "arm64", "x86_64" }, *targets[2] = { "aarch64-linux-gnu", "x86_64-linux-gnu" };
    static const char *wins[2] = { "aarch64-windows-msvc", "x86_64-windows-msvc" };
    char here[4096], *slash, readelf[4200], objdump[4200], *evidence = 0;
    const char *llvm = getenv("LLVM_BIN");
    int i, k, textb[2];
    np_buf extra = { 0, 0, 0 };

    /* argparse: --evidence PATH (any unambiguous prefix of it, or --evidence=PATH), -h/--help */
    for (i = 1; i < argc; i++) {
        const char *a = argv[i];
        if (!strcmp(a, "-h") || (strlen(a) >= 3 && !strncmp("--help", a, strlen(a)))) {
            fputs(USAGE, stdout);
            fputs("\noptions:\n  -h, --help           show this help message and exit\n  --evidence EVIDENCE\n", stdout);
            return 0;
        }
        if (!strcmp(a, "--")) { for (; i < argc; i++) { np_puts(&extra, extra.n ? " " : ""); np_puts(&extra, argv[i]); } break; }
        if (a[0] == '-' && a[1] == '-' && a[2]) {
            const char *eq = strchr(a, '='); size_t l = eq ? (size_t)(eq - a) : strlen(a);
            if (l >= 3 && l <= 10 && !strncmp(a, "--evidence", l)) {
                if (eq) { evidence = (char *)eq + 1; continue; }
                if (i + 1 < argc && (argv[i + 1][0] != '-' || !argv[i + 1][1] || (argv[i + 1][1] >= '0' && argv[i + 1][1] <= '9'))) { evidence = argv[++i]; continue; }
                usage_error("argument --evidence: expected one argument");
            }
        }
        if (a[0] == '-' && a[1] && strcmp(a, "-") && !(a[1] >= '0' && a[1] <= '9')) { np_puts(&extra, extra.n ? " " : ""); np_puts(&extra, a); continue; }
        np_puts(&extra, extra.n ? " " : ""); np_puts(&extra, a);
    }
    if (extra.n) { char m[4200]; snprintf(m, sizeof m, "unrecognized arguments: %s", extra.p); usage_error(m); }

    snprintf(here, sizeof here, "%s", __FILE__);
    slash = strrchr(here, '/');
    if (slash) *slash = 0; else snprintf(here, sizeof here, ".");
    { char t[4200]; snprintf(t, sizeof t, "%s/../..", here); if (!realpath(t, ROOT)) fail("cannot resolve the repository root"); }
    if (!llvm) llvm = "/opt/homebrew/opt/llvm/bin";
    { char l[4096]; np_pathnorm(llvm, l, sizeof l); tool("llvm-readelf", l, readelf, sizeof readelf); tool("llvm-objdump", l, objdump, sizeof objdump); }
    if (ptf_mkdtemp(0, "unisacc-linuxbridge-check-", D, sizeof D)) { D[0] = 0; fail("FileNotFoundError: No usable temporary directory found"); }
    for (k = 0; k < 2; k++) {
        const char *arch = archs[k];
        char src[4300], elf[4300], mac[4300], old[4300], base[4300], badp[4300], name[64], ref[128], *v[10];
        np_result r; np_buf blob = { 0, 0, 0 }; list ei, mi, bi; int w;
        snprintf(name, sizeof name, "librarycall_%s.S", arch);
        snprintf(src, sizeof src, "%s/exec/c/%s", ROOT, name);
        snprintf(elf, sizeof elf, "%s/%s.elf.o", D, arch); snprintf(mac, sizeof mac, "%s/%s.mac.o", D, arch);
        snprintf(old, sizeof old, "%s/%s-old.S", D, arch); snprintf(base, sizeof base, "%s/%s-old.o", D, arch);
        snprintf(badp, sizeof badp, "%s/bad.o", D);
        v[0] = "clang"; v[1] = "-target"; v[2] = (char *)targets[k]; v[3] = "-c"; v[4] = src; v[5] = "-o"; v[6] = elf; v[7] = 0;
        r = call(v, 1); np_free(&r);
        v[0] = "clang"; v[1] = "-arch"; v[2] = (char *)arch; v[3] = "-c"; v[4] = src; v[5] = "-o"; v[6] = mac; v[7] = 0;
        r = call(v, 1); np_free(&r);
        snprintf(ref, sizeof ref, "HEAD:exec/c/%s", name);
        v[0] = "git"; v[1] = "-C"; v[2] = ROOT; v[3] = "show"; v[4] = ref; v[5] = 0;
        r = call(v, 1);
        if (np_writefile(old, r.out, r.outn)) fail("OSError: cannot write the HEAD copy");
        np_free(&r);
        v[0] = "clang"; v[1] = "-arch"; v[2] = (char *)arch; v[3] = "-c"; v[4] = old; v[5] = "-o"; v[6] = base; v[7] = 0;
        r = call(v, 1); np_free(&r);
        ei = insns(objdump, elf); mi = insns(objdump, mac); bi = insns(objdump, base);
        if (!(list_eq(&ei, &mi) && list_eq(&mi, &bi))) {
            np_buf m = { 0, 0, 0 }; size_t j;
            np_puts(&m, "AssertionError: ('instruction streams differ', '"); np_puts(&m, arch); np_puts(&m, "', ");
            for (j = 0; j < ei.n && j < mi.n && !strcmp(ei.v[j], mi.v[j]); j++) ;
            if (j < ei.n && j < mi.n) { np_puts(&m, "('"); np_puts(&m, ei.v[j]); np_puts(&m, "', '"); np_puts(&m, mi.v[j]); np_puts(&m, "'))"); }
            else { char t[64]; snprintf(t, sizeof t, "('len', %d, %d))", (int)ei.n, (int)mi.n); np_puts(&m, t); }
            fail(m.p);
        }
        list_free(&ei); list_free(&mi); list_free(&bi);
        v[0] = readelf; v[1] = "-sSW"; v[2] = elf; v[3] = 0;
        r = call(v, 1);
        {
            np_buf sy = { 0, 0, 0 }; char *line = 0, *p, *e;
            np_put(&sy, r.out, r.outn);
            check(strstr(sy.p, "FUNC    GLOBAL DEFAULT") && strstr(sy.p, " us_library_bridge_raw"), "");
            check(!strstr(sy.p, " _us_library_bridge_raw"), "");
            for (p = sy.p; *p; p = *e ? e + 1 : e) {
                e = p + strcspn(p, "\n\r");
                if (e > p) {
                    char c = *e; *e = 0;
                    if (strstr(p, ".note.GNU-stack")) { line = p; break; }
                    *e = c;
                }
            }
            if (!line) fail("StopIteration");
            check(!strstr(line, " X ") && !strstr(line, " AX "), "");
            free(sy.p);
        }
        np_free(&r);
        v[0] = objdump; v[1] = "-d"; v[2] = elf; v[3] = 0;
        r = call(v, 1);
        { np_buf as = { 0, 0, 0 }; np_put(&as, r.out, r.outn); check(strstr(as.p, "<us_library_bridge_raw>:") != 0, ""); free(as.p); }
        np_free(&r);
        for (w = 0; w < 2; w++) {
            v[0] = "clang"; v[1] = "-target"; v[2] = (char *)wins[w]; v[3] = "-c"; v[4] = src; v[5] = "-o"; v[6] = badp; v[7] = 0;
            r = call(v, 0);
            check(r.rc != 0 && np_count(r.err, r.errn, "does not implement the Windows host ABI", 39) > 0, "");
            np_free(&r);
        }
        if (np_readfile(elf, &blob)) fail("FileNotFoundError: the ELF object is missing");
        textb[k] = (int)text_len(blob.p, blob.n);
        free(blob.p);
    }
    {
        np_buf one = { 0, 0, 0 }, ind = { 0, 0, 0 }; char t[64];
        np_puts(&one, "["); np_puts(&ind, "[\n");
        for (k = 0; k < 2; k++) {
            snprintf(t, sizeof t, "%d", textb[k]);
            np_puts(&one, k ? ", {\"arch\": \"" : "{\"arch\": \""); np_puts(&one, archs[k]);
            np_puts(&one, "\", \"text_bytes\": "); np_puts(&one, t);
            np_puts(&one, ", \"symbols\": \"ELF GLOBAL FUNC\", \"instruction_bytes\": \"same instruction stream as Mach-O baseline\", "
                          "\"gnu_stack\": \"non-executable\", \"windows\": \"rejected\"}");
            np_puts(&ind, k ? ",\n  {\n    \"arch\": \"" : "  {\n    \"arch\": \""); np_puts(&ind, archs[k]);
            np_puts(&ind, "\",\n    \"text_bytes\": "); np_puts(&ind, t);
            np_puts(&ind, ",\n    \"symbols\": \"ELF GLOBAL FUNC\",\n    \"instruction_bytes\": \"same instruction stream as Mach-O baseline\",\n"
                          "    \"gnu_stack\": \"non-executable\",\n    \"windows\": \"rejected\"\n  }");
        }
        np_puts(&one, "]\n"); np_puts(&ind, "\n]\n");
        cleanup();   /* the TemporaryDirectory closes before the evidence is written */
        if (evidence) {
            char m[4600], shown[4096]; int e0 = np_writefile(evidence, ind.p, ind.n);
            np_pathnorm(evidence, shown, sizeof shown);
            if (e0) { np_oserror(e0, shown, m, sizeof m); fail(m); }
        }
        fputs(one.p, stdout);
        free(one.p); free(ind.p);
    }
    return 0;
}
