/* Fixed closure partition only; all full-source and negative oracle checks remain. */
#pragma unisa use cxlib.pyrun
/* Legacy external Python oracle remains; not migration. */
#define TP_SOURCE "exec/c/targetpackage.py"
#define TP_SHA "6e18f38e2441ebbecc2e99f0c8a337c2bb4877f34de829b61448387179f626eb"
static int tp_no(const char*s){fprintf(stderr,"targetpackagephase refused: %s\n",s);return 2;}
int main(int argc,char**argv){
 const char*domain="TARGETS = tuple(f'{os}/{arch}' for os in ('lnx','osx','win') for arch in ('arm64','x86_64'))\n";
 const char*targets[]={"lnx/arm64","lnx/x86_64","osx/arm64","osx/x86_64","win/arm64","win/x86_64"};
 int inspect=argc==2&&!strcmp(argv[1],"--inspect");
 if(!inspect&&(argc!=3||strlen(argv[1])!=1||argv[1][0]<'1'||argv[1][0]>'3'))return tp_no("1|2|3 PACKAGE, or --inspect");
 size_t n;char*s=cx_read(TP_SOURCE,&n),h[65];if(!s||memchr(s,0,n))return tp_no("source read/NUL");cx_sha256_hex(s,n,h);
 if(strcmp(h,TP_SHA)||!strstr(s,domain))return tp_no("fixed production source SHA/six-target domain changed");
 if(inspect){printf("targetpackagephase source=%s six-target domain exact; pairs lnx/osx/win each arm64+x86_64; joint6/6 only, NOT PASS\n",h);return 0;}
 int at=(argv[1][0]-'1')*2;
 if(unsetenv("UNISA_CONTAINER"))return tp_no("original child environment");
 char interpreter[4096]={0},script[4096];int unresolved=pr_python(interpreter,sizeof interpreter);struct stat script_st;if(unresolved&&!interpreter[0])return tp_no("resolve original interpreter");if(!unresolved&&(!realpath("tests/targetpackagecheck.py",script)||stat(script,&script_st)||!S_ISREG(script_st.st_mode)))return tp_no("resolve original oracle");
 char*a[]={interpreter,unresolved?"tests/targetpackagecheck.py":script,argv[2],(char*)targets[at],(char*)targets[at+1],0};
 execvp(a[0],a);return tp_no("exec original oracle");
}
