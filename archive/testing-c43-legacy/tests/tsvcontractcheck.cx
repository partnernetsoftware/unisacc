#!/usr/bin/env -S unisacc.com -run
/* tsvcontractcheck.cx -- the gold .tsv input contract [J10]: a damaged table must be REJECTED by the reader, not
   built into a net that looks exact (2026-10-23, unisa detachment W1-E: port of tests/tsv_contract.py, which asked
   the Python seed's tsvgold reader; the reader that matters now is the C one, iterate/construct/construct.c, the
   weight constructor that reads weights/gold/*.tsv -- same contract, J10).
   usage (from the repository root):  sh ./tests/cxbin tests/tsvcontractcheck.cx            (tests/tsvbuild.sh)
                                      sh ./unisacc.com -run tests/tsvcontractcheck.cx
   construct.c is built once by the product (sh ./unisacc.com -o), then run on six copies of weights/gold/prec.tsv:
     ok             the table as committed: exit 0 (accepted)
     missing row    the first data row deleted               exit 1, "keys do not cover"
     duplicate row  the second data row replaced by the first exit 1, "key repeats"
     bad label      the first row's label 1 -> NOPE          exit 1, "not a class of its head"
     extra column   a tab and x appended to the first row    exit 1, "wrong number of columns"
     bad key        zz prefixed to the first row's key       exit 1, "not a value of its field"
   A rejection is exit status exactly 1 AND that diagnostic: a signal, the watchdog, a capacity or invariant exit, or
   the wrong reason is not the reader rejecting the damage.  Output: one line per case (`NAME accepted` /
   `NAME rejected: <diagnostic>`), then `contract  cases 6  wrong N` (tests/tsvbuild.sh greps it); rc 0 when wrong is
   0, 1 otherwise, 2 when construct.c cannot be built or the table cannot be read.
   No #include: the prelude is built in. */

static char WORK[4096];
static void cleanup(void) {                      /* own mkdtemp, through the one deletion guard */
    if (!WORK[0]) return;
    cx_rmtree(WORK); WORK[0] = 0;
}
static void die(const char *a, const char *b) { fflush(stdout); fprintf(stderr, "tsvcontractcheck: %s%s\n", a, b ? b : ""); cleanup(); exit(2); }

/* ARGV (execvp, stdin /dev/null), stdout and stderr together into *out, under a SECS watchdog.
   Exit code, 128+N on signal N, 124 on timeout (process group killed), 127 when ARGV[0] cannot run. */
static int run(char *const argv[], int secs, char **out) {
    char op[4200]; long ticks = (long)secs * 100; int st = 0, rc, fo; pid_t pid, w; size_t n;
    snprintf(op, sizeof op, "%s/.out", WORK);
    fo = open(op, O_WRONLY | O_CREAT | O_TRUNC, 0600);
    if (fo < 0) die("cannot open ", op);
    pid = fork();
    if (pid < 0) die("fork failed", 0);
    if (pid == 0) {
        int nul = open("/dev/null", O_RDONLY);
        setpgid(0, 0);
        if (nul >= 0) { dup2(nul, 0); close(nul); }
        dup2(fo, 1); dup2(fo, 2); close(fo);
        execvp(argv[0], argv); _exit(127);
    }
    close(fo);
    for (;;) {
        w = waitpid(pid, &st, WNOHANG);
        if (w == pid) { rc = (st & 0x7f) ? 128 + (st & 0x7f) : (st >> 8) & 0xff; break; }
        if (w < 0) { rc = -1; break; }
        if (ticks-- <= 0) { kill(-pid, SIGKILL); kill(pid, SIGKILL); waitpid(pid, &st, 0); rc = 124; break; }
        usleep(10000);
    }
    *out = cx_read(op, &n); if (!*out) { *out = malloc(1); if (!*out) die("out of memory", 0); (*out)[0] = 0; }
    cx_remove(op);
    return rc;
}

#define MAXL 4096
static char *L[MAXL]; static int NL;               /* the table split at '\n' (a final '' kept, as str.split) */

/* write the case: lines L with DROP removed (-1 none), line AT replaced by REPL (-1 none) */
static void writecase(const char *path, int drop, int at, const char *repl) {
    size_t cap = 1 << 16, n = 0; char *b = malloc(cap); int i, first = 1;
    if (!b) die("out of memory", 0);
    for (i = 0; i < NL; i++) {
        const char *s = (i == at) ? repl : L[i]; size_t l;
        if (i == drop) continue;
        l = strlen(s);
        while (n + l + 2 > cap) { cap *= 2; b = realloc(b, cap); if (!b) die("out of memory", 0); }
        if (!first) b[n++] = '\n';
        memcpy(b + n, s, l); n += l; first = 0;
    }
    if (cx_write(path, b, n) != 0) die("cannot write ", path);
    free(b);
}

int main(int argc, char **argv) {
    static const char *src = "weights/gold/prec.tsv";
    char *text, *p, *out, tsv[4200], exe[4200], *edit; size_t n; int i, body[2], nb = 0, wrong = 0, k;
    const char *tmp = getenv("TMPDIR");
    struct { const char *name, *want; int drop, at; } cs[6];
    (void)argv;
    if (argc != 1) { fprintf(stderr, "usage: tsvcontractcheck.cx   (from the repository root)\n"); return 2; }
    if (!(text = cx_read(src, &n))) die("cannot read ", src);
    for (p = text, NL = 0; ; ) {
        char *e = strchr(p, '\n');
        if (NL >= MAXL) die("too many lines in ", src);
        L[NL++] = p;
        if (!e) break;
        *e = 0; p = e + 1;
    }
    {   /* data rows: the non-comment lines after the column header */
        int seen = 0;
        for (i = 0; i < NL && nb < 2; i++) if (L[i][0] && L[i][0] != '#') { if (seen++) body[nb++] = i; }
        if (nb < 2) die("fewer than two data rows in ", src);
    }
    if (!tmp || !*tmp) tmp = "/tmp";
    snprintf(WORK, sizeof WORK, "%s/unisacc-tsvcontract-XXXXXX", tmp);
    if (!mkdtemp(WORK)) { WORK[0] = 0; die("cannot make a temporary directory under ", tmp); }
    snprintf(tsv, sizeof tsv, "%s/prec.tsv", WORK);
    snprintf(exe, sizeof exe, "%s/construct", WORK);
    {   /* the reader, built by the product */
        char *av[6]; int rc; av[0] = "sh"; av[1] = "./unisacc.com"; av[2] = "-o"; av[3] = exe; av[4] = "iterate/construct/construct.c"; av[5] = 0;
        rc = run(av, 40, &out);
        if (rc != 0) { fprintf(stderr, "%s", out); die("cannot build iterate/construct/construct.c with ./unisacc.com", 0); }
        free(out);
    }
    cs[0].name = "ok";            cs[0].want = 0;                          cs[0].drop = -1;      cs[0].at = -1;
    cs[1].name = "missing row";   cs[1].want = "keys do not cover";        cs[1].drop = body[0]; cs[1].at = -1;
    cs[2].name = "duplicate row"; cs[2].want = "key repeats";              cs[2].drop = -1;      cs[2].at = body[1];
    cs[3].name = "bad label";     cs[3].want = "not a class of its head";  cs[3].drop = -1;      cs[3].at = body[0];
    cs[4].name = "extra column";  cs[4].want = "wrong number of columns";  cs[4].drop = -1;      cs[4].at = body[0];
    cs[5].name = "bad key";       cs[5].want = "not a value of its field"; cs[5].drop = -1;      cs[5].at = body[0];
    for (k = 0; k < 6; k++) {
        char *av[3], *nl; int rc, ok; size_t l = strlen(L[body[0]]);
        edit = malloc(l + 16); if (!edit) die("out of memory", 0);
        if (k == 2) strcpy(edit, L[body[0]]);
        else if (k == 3) {                          /* the first '\t1' becomes '\tNOPE' (str.replace on that row) */
            char *t = strstr(L[body[0]], "\t1");
            if (!t) die("the first data row has no label 1 to damage: ", L[body[0]]);
            memcpy(edit, L[body[0]], (size_t)(t - L[body[0]])); strcpy(edit + (t - L[body[0]]), "\tNOPE"); strcat(edit, t + 2);
        }
        else if (k == 4) { strcpy(edit, L[body[0]]); strcat(edit, "\tx"); }
        else if (k == 5) { strcpy(edit, "zz"); strcat(edit, L[body[0]]); }
        writecase(tsv, cs[k].drop, cs[k].at, edit);
        free(edit);
        av[0] = exe; av[1] = tsv; av[2] = 0;
        rc = run(av, 10, &out);
        if ((nl = strchr(out, '\n')) != 0) *nl = 0;
        {   /* the diagnostic without the temporary path: `construct: TSV: why` -> `why` */
            char pre[4300]; snprintf(pre, sizeof pre, "construct: %s: ", tsv);
            if (!strncmp(out, pre, strlen(pre))) memmove(out, out + strlen(pre), strlen(out + strlen(pre)) + 1);
        }
        if (!cs[k].want) {
            ok = rc == 0;
            printf("%-14s %s\n", cs[k].name, ok ? "accepted" : "NOT ACCEPTED");
            if (!ok) printf("               (rc %d) %s\n", rc, out);
        } else {
            ok = rc == 1 && strstr(out, cs[k].want) != 0;
            if (ok) printf("%-14s rejected: %s\n", cs[k].name, out);
            else printf("%-14s NOT A READER REJECTION (rc %d): %s\n", cs[k].name, rc, out);
        }
        if (!ok) wrong++;
        free(out);
    }
    cleanup();
    printf("contract  cases 6  wrong %d\n", wrong);
    return wrong ? 1 : 0;
}
