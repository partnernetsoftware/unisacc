#!/usr/bin/env -S unisacc.com -run
/* edgeablate.cx --gate|--produce|--check-frozen LEAF ROOT */

typedef struct { char flow[32], net[32], probe[256], probe_sha[65], target[64]; } Manifest;
typedef struct { char key[512], sample[24], verdict[24], how[24]; } ARow;

static int fail(const char *s) { printf("edgeablate: FAIL %s\n", s); return 1; }

static int fields(char *p, char **f, int max) {
    int n = 1;
    f[0] = p;
    while (*p) {
        if (*p == '\t') { *p = 0; if (n == max) return -1; f[n++] = p + 1; }
        p++;
    }
    return n;
}

static int read_manifest(const char *leaf, Manifest *m) {
    char path[4096], *b, *p, *end, *f[2];
    size_t n;
    snprintf(path, sizeof path, "%s/manifest.tsv", leaf);
    b = cx_read(path, &n);
    if (!b) return fail("missing manifest.tsv");
    memset(m, 0, sizeof *m);
    for (p = b; *p; p = end + 1) {
        end = strchr(p, '\n');
        if (!end) { free(b); return fail("manifest truncated"); }
        *end = 0;
        if (!*p || p[0] == '#') { if (!end[1]) break; continue; }
        if (fields(p, f, 2) != 2) { free(b); return fail("manifest row"); }
        if (!strcmp(f[0], "flow")) strncpy(m->flow, f[1], sizeof m->flow - 1);
        else if (!strcmp(f[0], "net")) strncpy(m->net, f[1], sizeof m->net - 1);
        else if (!strcmp(f[0], "probe")) strncpy(m->probe, f[1], sizeof m->probe - 1);
        else if (!strcmp(f[0], "target")) strncpy(m->target, f[1], sizeof m->target - 1);
        else if (!strcmp(f[0], "probe_sha256")) strncpy(m->probe_sha, f[1], sizeof m->probe_sha - 1);
        if (!end[1]) break;
    }
    free(b);
    if (!m->flow[0] || !m->net[0] || !m->probe[0] || !m->target[0] || strlen(m->probe_sha) != 64)
        return fail("manifest incomplete");
    return 0;
}

static void unesc(const char *in, char *out, size_t cap) {
    size_t j = 0;
    for (const char *p = in; *p && j + 1 < cap; p++) {
        if (p[0] == '\\' && p[1] == 'x' && p[2] && p[3]) {
            int hi = 0, lo = 0;
            char h = p[2], l = p[3];
            if (h >= '0' && h <= '9') hi = h - '0';
            else if (h >= 'a' && h <= 'f') hi = 10 + h - 'a';
            if (l >= '0' && l <= '9') lo = l - '0';
            else if (l >= 'a' && l <= 'f') lo = 10 + l - 'a';
            out[j++] = (char)((hi << 4) | lo);
            p += 3;
        } else out[j++] = *p;
    }
    out[j] = 0;
}

static int key_in_asks(const char *leaf, const char *key) {
    char path[4096], *b, *p, *end, *f[4], dk[512];
    size_t n;
    snprintf(path, sizeof path, "%s/asks.tsv", leaf);
    b = cx_read(path, &n);
    if (!b) return 0;
    for (p = b; *p; p = end + 1) {
        end = strchr(p, '\n');
        if (!end) { free(b); return 0; }
        *end = 0;
        if (!*p || p[0] == '#') { if (!end[1]) break; continue; }
        if (fields(p, f, 3) < 1) { free(b); return 0; }
        unesc(f[0], dk, sizeof dk);
        if (!strcmp(dk, key)) { free(b); return 1; }
        if (!end[1]) break;
    }
    free(b);
    return 0;
}

static int load_ablate(const char *leaf, ARow *rows, int *nr) {
    char path[4096], *b, *p, *end, *f[8];
    size_t n;
    snprintf(path, sizeof path, "%s/ablate.tsv", leaf);
    b = cx_read(path, &n);
    if (!b) return fail("missing ablate.tsv");
    *nr = 0;
    for (p = b; *p; p = end + 1) {
        end = strchr(p, '\n');
        if (!end) { free(b); return fail("ablate truncated"); }
        *end = 0;
        if (!*p || p[0] == '#') { if (!end[1]) break; continue; }
        if (fields(p, f, 4) != 4) { free(b); return fail("ablate row"); }
        if (*nr >= 32) { free(b); return fail("ablate cap"); }
        {
            ARow *r = &rows[*nr];
            strncpy(r->key, f[0], sizeof r->key - 1);
            strncpy(r->sample, f[1], sizeof r->sample - 1);
            strncpy(r->verdict, f[2], sizeof r->verdict - 1);
            strncpy(r->how, f[3], sizeof r->how - 1);
        }
        (*nr)++;
        if (!end[1]) break;
    }
    free(b);
    if (!*nr) return fail("ablate empty");
    return 0;
}

static int sha_path(const char *path, char hex[65]) {
    size_t n;
    char *b = cx_read(path, &n);
    if (!b) return -1;
    cx_sha256_hex(b, n, hex);
    free(b);
    return 0;
}

static int compile_ablate(const char *root, const Manifest *m, const char *ablate, const char *out) {
    char cmd[8192];
    snprintf(cmd, sizeof cmd,
             "cd '%s' && UNISA_ABLATE='%s' python3 -m unisa compile '%s' -o '%s' --target '%s' --drive built >/dev/null 2>&1", root,
             ablate ? ablate : "", m->probe, out, m->target);
    return cx_run_timeout(cmd, 25, 0, 0);
}

static int check_frozen(const char *leaf, const char *root, Manifest *m, int replay) {
    ARow rows[32];
    char dk[512], probe_path[4096], sha[65];
    int i, nr = 0, need_raise = 0, need_art = 0, in_map = 0;
    if (read_manifest(leaf, m)) return 1;
    snprintf(probe_path, sizeof probe_path, "%s/%s", root, m->probe);
    if (sha_path(probe_path, sha) || strcmp(sha, m->probe_sha)) return fail("probe sha mismatch");
    if (load_ablate(leaf, rows, &nr)) return 1;
    for (i = 0; i < nr; i++) {
        unesc(rows[i].key, dk, sizeof dk);
        if (!strcmp(rows[i].sample, "in-map")) {
            in_map++;
            if (!key_in_asks(leaf, dk)) return fail("in-map key not in asks.tsv");
            if (strcmp(rows[i].verdict, "changed")) return fail("in-map verdict");
            if (!strcmp(rows[i].how, "raise")) need_raise = 1;
            else if (!strcmp(rows[i].how, "artifact")) need_art = 1;
            else return fail("in-map how");
        } else if (!strcmp(rows[i].sample, "out-of-map")) {
            if (key_in_asks(leaf, dk)) return fail("out-of-map key in asks.tsv");
        } else return fail("sample class");
    }
    if (!in_map) return fail("no in-map samples");
    if (!replay) {
        printf("edgeablate: frozen ok %s->%s (%d rows)\n", m->flow, m->net, nr);
        return 0;
    }
    {
        /* under the temp root ($TMPDIR, else /tmp): the images are deleted through the one guard (cx_remove) */
        const char *td = getenv("TMPDIR");
        char base[4096], abl[4096];
        char bp[4200], ap[4200];
        int rc0, rc1, f0, f1;
        snprintf(base, sizeof base, "%s/eabl-b-XXXXXX", td && *td ? td : "/tmp");
        snprintf(abl, sizeof abl, "%s/eabl-a-XXXXXX", td && *td ? td : "/tmp");
        f0 = mkstemp(base); f1 = mkstemp(abl);
        if (f0 < 0 || f1 < 0) return fail("tmp");
        close(f0);
        close(f1);
        snprintf(bp, sizeof bp, "%s.img", base);
        snprintf(ap, sizeof ap, "%s.img", abl);
        rc0 = compile_ablate(root, m, 0, bp);
        rc1 = compile_ablate(root, m, m->net, ap);
        if (rc0 != 0) { cx_remove(bp); cx_remove(ap); cx_remove(base); cx_remove(abl); return fail("baseline compile"); }
        if (need_raise && rc1 == 0) { cx_remove(bp); cx_remove(ap); cx_remove(base); cx_remove(abl); return fail("expected refusal"); }
        if (need_art && rc1 == 0) {
            char h0[65], h1[65];
            if (sha_path(bp, h0) || sha_path(ap, h1) || !strcmp(h0, h1)) {
                cx_remove(bp);
                cx_remove(ap); cx_remove(base); cx_remove(abl);
                return fail("artifact unchanged");
            }
        }
        cx_remove(bp);
        cx_remove(ap); cx_remove(base); cx_remove(abl);
    }
    printf("edgeablate: edge %s->%s PASS probe %s (%d samples)\n", m->flow, m->net, m->probe, nr);
    return 0;
}

static int copy_file(const char *s, const char *d) {
    size_t n;
    char *b = cx_read(s, &n);
    if (!b) return -1;
    if (cx_write(d, b, n)) { free(b); return -1; }
    free(b);
    return 0;
}

static int gate_neg(const char *leaf, const char *root, Manifest *m) {
    char dir[] = "/tmp/eabl-neg-XXXXXX", src[4096], dst[4096];
    if (!mkdtemp(dir)) return fail("neg dir");
    snprintf(src, sizeof src, "%s/manifest.tsv", leaf);
    snprintf(dst, sizeof dst, "%s/manifest.tsv", dir);
    if (copy_file(src, dst)) return fail("neg copy");
    snprintf(src, sizeof src, "%s/asks.tsv", leaf);
    snprintf(dst, sizeof dst, "%s/asks.tsv", dir);
    if (copy_file(src, dst)) return fail("neg copy");
    snprintf(src, sizeof src, "%s/ablate.tsv", leaf);
    snprintf(dst, sizeof dst, "%s/ablate.tsv", dir);
    {
        size_t n;
        char *b = cx_read(src, &n);
        char *p;
        if (!b) return fail("neg");
        p = b;
        while (*p && (*p == '#' || *p == '\n')) {
            if (*p == '\n') p++;
            else { p = strchr(p, '\n'); if (!p) break; p++; }
        }
        if (p && *p) {
            char *v = strchr(p, '\t');
            if (v) { v = strchr(v + 1, '\t'); if (v) strcpy(v + 1, "bogus"); }
        }
        cx_write(dst, b, n);
        free(b);
    }
    if (check_frozen(dir, root, m, 0) == 0) return fail("negative not caught");
    puts("edgeablate: negatives caught");
    return 0;
}

static int produce(const char *leaf, const char *root) {
    char cmd[8192];
    snprintf(cmd, sizeof cmd,
             "cd '%s' && python3 archive/tests/legacy/edgeablate.py --produce '%s' '%s'", root, leaf, root);
    if (cx_run_timeout(cmd, 55, 0, 0) != 0) return fail("produce failed");
    return 0;
}

int main(int argc, char **argv) {
    Manifest m;
    if (argc == 4 && !strcmp(argv[1], "--check-frozen")) return check_frozen(argv[2], argv[3], &m, 0);
    if (argc == 4 && !strcmp(argv[1], "--produce")) return produce(argv[2], argv[3]);
    if (argc == 4 && !strcmp(argv[1], "--gate")) {
        if (check_frozen(argv[2], argv[3], &m, 1)) return 1;
        return gate_neg(argv[2], argv[3], &m);
    }
    fprintf(stderr, "usage: edgeablate.cx --gate|--produce|--check-frozen LEAF ROOT\n");
    return 2;
}
