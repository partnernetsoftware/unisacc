/* pyjson.cx -- Python's json.loads / json.dumps as a .cx module (2026-10-23, the py->cx port wave; first user
   tests/libraryunion16check.cx).  Use it with `#pragma unisa use cxlib.pyjson` from a .cx file in tests/.
   Values are a tree of pj_value: PJ_STR keeps UTF-8 bytes (a lone \uD800-style surrogate from an escape is kept as
   its 3-byte form), PJ_INT keeps the decimal text Python's int() would print, PJ_FLOAT a double, PJ_OBJ keeps
   insertion order with keys at items[2i] and values at items[2i+1] (a repeated key keeps its first position and
   takes the last value, as a dict does).
     pj_loads(TEXT, N, why, whylen)   json.loads(str): the tree, or 0 with WHY set to the traceback's last line,
                                      `json.decoder.JSONDecodeError: Expecting value: line 1 column 1 (char 0)`
                                      (the C scanner's messages and positions; positions count code points)
     pj_dumps(V, INDENT, &out, &n)    json.dumps(V) for INDENT < 0 (separators ', ' and ': '), json.dumps(V,
                                      indent=INDENT) otherwise; ensure_ascii, NaN/Infinity, float repr as Python's
     pj_null/pj_bool/pj_int/pj_float/pj_str/pj_strz/pj_list/pj_dict, pj_append, pj_set (dict[key] = v),
     pj_get (dict.get(key), 0 when absent), pj_isnum, pj_eq_int (Python ==, so True == 1 and 1.0 == 1)
   No exported objects or macros (CXIF v0). */
#pragma unisa module pyjson

enum pj_type { PJ_NULL, PJ_BOOL, PJ_INT, PJ_FLOAT, PJ_STR, PJ_ARR, PJ_OBJ };
typedef struct pj_value { int type; char *s; size_t n; double d; int b; struct pj_value **items; size_t len, cap; } pj_value;

/* ---- construction ---- */
static pj_value *pj_new(int type) {
    pj_value *v = calloc(1, sizeof *v);
    if (!v) { fputs("MemoryError\n", stderr); exit(1); }
    v->type = type; return v;
}
pj_value *pj_null(void) { return pj_new(PJ_NULL); }
pj_value *pj_bool(int b) { pj_value *v = pj_new(PJ_BOOL); v->b = !!b; return v; }
pj_value *pj_int(long long x) {
    pj_value *v = pj_new(PJ_INT); char t[32];
    snprintf(t, sizeof t, "%lld", x); v->n = strlen(t); v->s = malloc(v->n + 1); memcpy(v->s, t, v->n + 1);
    return v;
}
pj_value *pj_float(double d) { pj_value *v = pj_new(PJ_FLOAT); v->d = d; return v; }
pj_value *pj_str(const char *s, size_t n) {
    pj_value *v = pj_new(PJ_STR);
    v->s = malloc(n + 1); if (n) memcpy(v->s, s, n); v->s[n] = 0; v->n = n;
    return v;
}
pj_value *pj_strz(const char *s) { return pj_str(s, strlen(s)); }
pj_value *pj_list(void) { return pj_new(PJ_ARR); }
pj_value *pj_dict(void) { return pj_new(PJ_OBJ); }
static void pj_push(pj_value *c, pj_value *v) {
    if (c->len == c->cap) {
        pj_value **g = realloc(c->items, (c->cap = c->cap ? 2 * c->cap : 8) * sizeof *g);
        if (!g) { fputs("MemoryError\n", stderr); exit(1); }
        c->items = g;
    }
    c->items[c->len++] = v;
}
void pj_append(pj_value *list, pj_value *v) { pj_push(list, v); }
static long pj_find(const pj_value *o, const char *k, size_t kn) {
    size_t i;
    for (i = 0; i + 1 < o->len; i += 2) if (o->items[i]->n == kn && !memcmp(o->items[i]->s, k, kn)) return (long)i;
    return -1;
}
static void pj_setn(pj_value *o, const char *k, size_t kn, pj_value *v) {
    long i = pj_find(o, k, kn);
    if (i >= 0) { o->items[i + 1] = v; return; }
    pj_push(o, pj_str(k, kn)); pj_push(o, v);
}
void pj_set(pj_value *obj, const char *key, pj_value *v) { pj_setn(obj, key, strlen(key), v); }
pj_value *pj_get(const pj_value *obj, const char *key) {
    long i;
    if (!obj || obj->type != PJ_OBJ) return 0;
    i = pj_find(obj, key, strlen(key));
    return i < 0 ? 0 : obj->items[i + 1];
}
int pj_isnum(const pj_value *v) { return v && (v->type == PJ_BOOL || v->type == PJ_INT || v->type == PJ_FLOAT); }
int pj_eq_int(const pj_value *v, long long x) {
    char t[32];
    if (!v) return 0;
    if (v->type == PJ_BOOL) return (long long)v->b == x;
    if (v->type == PJ_FLOAT) return v->d == (double)x;
    if (v->type != PJ_INT) return 0;
    snprintf(t, sizeof t, "%lld", x);
    return !strcmp(v->s, t);
}

/* ---- loads (Modules/_json.c scanner + json.decoder) ---- */
typedef struct pj_src { const unsigned char *s; size_t n; int err; size_t at; const char *msg; } pj_src;
static int pj_ws(int c) { return c == ' ' || c == '\t' || c == '\n' || c == '\r'; }
static size_t pj_skip(pj_src *p, size_t i) { while (i < p->n && pj_ws(p->s[i])) i++; return i; }
static pj_value *pj_fail(pj_src *p, const char *msg, size_t at) { if (!p->err) { p->err = 1; p->msg = msg; p->at = at; } return 0; }
static void pj_utf8(char *o, size_t *k, unsigned long c) {
    if (c < 0x80) o[(*k)++] = (char)c;
    else if (c < 0x800) { o[(*k)++] = (char)(0xC0 | (c >> 6)); o[(*k)++] = (char)(0x80 | (c & 0x3F)); }
    else if (c < 0x10000) { o[(*k)++] = (char)(0xE0 | (c >> 12)); o[(*k)++] = (char)(0x80 | ((c >> 6) & 0x3F)); o[(*k)++] = (char)(0x80 | (c & 0x3F)); }
    else { o[(*k)++] = (char)(0xF0 | (c >> 18)); o[(*k)++] = (char)(0x80 | ((c >> 12) & 0x3F)); o[(*k)++] = (char)(0x80 | ((c >> 6) & 0x3F)); o[(*k)++] = (char)(0x80 | (c & 0x3F)); }
}
static int pj_hex4(const unsigned char *s, unsigned long *c) {
    int i; *c = 0;
    for (i = 0; i < 4; i++) {
        int h = s[i];
        if (h >= '0' && h <= '9') h -= '0'; else if (h >= 'a' && h <= 'f') h -= 'a' - 10; else if (h >= 'A' && h <= 'F') h -= 'A' - 10; else return i;
        *c = (*c << 4) | (unsigned long)h;
    }
    return 4;
}
/* the byte length of the code point at s[i] (input is valid UTF-8: it came from a decoded str) */
static size_t pj_cplen(const unsigned char *s, size_t n, size_t i) {
    size_t l = s[i] < 0x80 ? 1 : s[i] < 0xE0 ? 2 : s[i] < 0xF0 ? 3 : 4;
    return i + l > n ? n - i : l;
}
/* scanstring: BEGIN is the index after the opening quote */
static pj_value *pj_string(pj_src *p, size_t begin, size_t *end) {
    size_t i = begin, k = 0; char *o = malloc(p->n - begin + 1); pj_value *v;
    while (1) {
        unsigned c;
        if (i >= p->n) { free(o); return pj_fail(p, "Unterminated string starting at", begin - 1); }
        c = p->s[i];
        if (c == '"') break;
        if (c < 0x20) { free(o); return pj_fail(p, "Invalid control character at", i); }
        if (c != '\\') { o[k++] = (char)c; i++; continue; }
        i++;
        if (i >= p->n) { free(o); return pj_fail(p, "Unterminated string starting at", begin - 1); }
        c = p->s[i];
        if (c != 'u') {
            char r = c == '"' ? '"' : c == '\\' ? '\\' : c == '/' ? '/' : c == 'b' ? '\b' : c == 'f' ? '\f'
                   : c == 'n' ? '\n' : c == 'r' ? '\r' : c == 't' ? '\t' : 0;
            if (!r) { free(o); return pj_fail(p, "Invalid \\escape", i - 1); }
            o[k++] = r; i++; continue;
        } else {
            unsigned long u, lo; size_t h = i + 1;
            if (h + 4 >= p->n) { free(o); return pj_fail(p, "Invalid \\uXXXX escape", h - 1); }
            if (pj_hex4(p->s + h, &u) != 4) { free(o); return pj_fail(p, "Invalid \\uXXXX escape", h - 1); }
            i = h + 4;
            if (u >= 0xD800 && u <= 0xDBFF && i + 6 < p->n && p->s[i] == '\\' && p->s[i + 1] == 'u') {
                if (pj_hex4(p->s + i + 2, &lo) != 4) { free(o); return pj_fail(p, "Invalid \\uXXXX escape", i + 1); }
                if (lo >= 0xDC00 && lo <= 0xDFFF) { u = 0x10000 + (((u - 0xD800) << 10) | (lo - 0xDC00)); i += 6; }
            }
            pj_utf8(o, &k, u);
        }
    }
    v = pj_new(PJ_STR); o[k] = 0; v->s = o; v->n = k;
    *end = i + 1;
    return v;
}
static pj_value *pj_scan(pj_src *p, size_t i, size_t *end, int depth);
static pj_value *pj_number(pj_src *p, size_t i, size_t *end) {
    size_t st = i, j; int fl = 0; pj_value *v; char *t;
    if (i < p->n && p->s[i] == '-') i++;
    if (i < p->n && p->s[i] >= '1' && p->s[i] <= '9') { while (i < p->n && p->s[i] >= '0' && p->s[i] <= '9') i++; }
    else if (i < p->n && p->s[i] == '0') i++;
    else return pj_fail(p, "Expecting value", st);
    if (i + 1 < p->n && p->s[i] == '.' && p->s[i + 1] >= '0' && p->s[i + 1] <= '9') {
        fl = 1; i += 2; while (i < p->n && p->s[i] >= '0' && p->s[i] <= '9') i++;
    }
    if (i < p->n && (p->s[i] == 'e' || p->s[i] == 'E')) {
        j = i + 1;
        if (j < p->n && (p->s[j] == '+' || p->s[j] == '-')) j++;
        if (j < p->n && p->s[j] >= '0' && p->s[j] <= '9') { fl = 1; while (j < p->n && p->s[j] >= '0' && p->s[j] <= '9') j++; i = j; }
    }
    t = malloc(i - st + 1); memcpy(t, p->s + st, i - st); t[i - st] = 0;
    *end = i;
    if (fl) { v = pj_float(strtod(t, 0)); free(t); return v; }
    v = pj_new(PJ_INT);
    if (!strcmp(t, "-0")) { t[0] = '0'; t[1] = 0; }
    v->s = t; v->n = strlen(t);
    return v;
}
static pj_value *pj_scan(pj_src *p, size_t i, size_t *end, int depth) {
    pj_value *v, *x, *key;
    if (i >= p->n) return pj_fail(p, "Expecting value", i);
    if (depth > 900) return pj_fail(p, "RecursionError", i);
    switch (p->s[i]) {
    case '"': return pj_string(p, i + 1, end);
    case '{':
        v = pj_dict(); i = pj_skip(p, i + 1);
        if (i < p->n && p->s[i] == '}') { *end = i + 1; return v; }
        for (;;) {
            size_t comma;
            if (i >= p->n || p->s[i] != '"') return pj_fail(p, "Expecting property name enclosed in double quotes", i);
            if (!(key = pj_string(p, i + 1, &i))) return 0;
            i = pj_skip(p, i);
            if (i >= p->n || p->s[i] != ':') return pj_fail(p, "Expecting ':' delimiter", i);
            i = pj_skip(p, i + 1);
            if (!(x = pj_scan(p, i, &i, depth + 1))) return 0;
            pj_setn(v, key->s, key->n, x);
            i = pj_skip(p, i);
            if (i < p->n && p->s[i] == '}') { *end = i + 1; return v; }
            if (i >= p->n || p->s[i] != ',') return pj_fail(p, "Expecting ',' delimiter", i);
            comma = i; i = pj_skip(p, i + 1);
            if (i < p->n && p->s[i] == '}') return pj_fail(p, "Illegal trailing comma before end of object", comma);
        }
    case '[':
        v = pj_list(); i = pj_skip(p, i + 1);
        if (i < p->n && p->s[i] == ']') { *end = i + 1; return v; }
        for (;;) {
            size_t comma;
            if (!(x = pj_scan(p, i, &i, depth + 1))) return 0;
            pj_push(v, x);
            i = pj_skip(p, i);
            if (i < p->n && p->s[i] == ']') { *end = i + 1; return v; }
            if (i >= p->n || p->s[i] != ',') return pj_fail(p, "Expecting ',' delimiter", i);
            comma = i; i = pj_skip(p, i + 1);
            if (i < p->n && p->s[i] == ']') return pj_fail(p, "Illegal trailing comma before end of array", comma);
        }
    case 'n': if (i + 4 <= p->n && !memcmp(p->s + i, "null", 4)) { *end = i + 4; return pj_null(); } break;
    case 't': if (i + 4 <= p->n && !memcmp(p->s + i, "true", 4)) { *end = i + 4; return pj_bool(1); } break;
    case 'f': if (i + 5 <= p->n && !memcmp(p->s + i, "false", 5)) { *end = i + 5; return pj_bool(0); } break;
    case 'N': if (i + 3 <= p->n && !memcmp(p->s + i, "NaN", 3)) { *end = i + 3; return pj_float(0.0 / 0.0); } break;
    case 'I': if (i + 8 <= p->n && !memcmp(p->s + i, "Infinity", 8)) { *end = i + 8; return pj_float(1.0 / 0.0); } break;
    case '-': if (i + 9 <= p->n && !memcmp(p->s + i, "-Infinity", 9)) { *end = i + 9; return pj_float(-1.0 / 0.0); } break;
    }
    return pj_number(p, i, end);
}
pj_value *pj_loads(const char *text, size_t n, char *why, size_t whylen) {
    pj_src p; size_t i, end = 0, k, chars = 0, line = 1, col; pj_value *v;
    p.s = (const unsigned char *)text; p.n = n; p.err = 0; p.at = 0; p.msg = 0;
    if (n >= 3 && p.s[0] == 0xEF && p.s[1] == 0xBB && p.s[2] == 0xBF) { pj_fail(&p, "Unexpected UTF-8 BOM (decode using utf-8-sig)", 0); v = 0; }
    else {
        i = pj_skip(&p, 0);
        v = pj_scan(&p, i, &end, 0);
        if (v) { end = pj_skip(&p, end); if (end != n) v = pj_fail(&p, "Extra data", end); }
    }
    if (v) return v;
    /* JSONDecodeError(msg, doc, pos): positions in code points */
    {   size_t lastnl = (size_t)-1, cpos = 0;
        for (k = 0; k < p.at && k < n; k += pj_cplen(p.s, n, k)) { if (p.s[k] == '\n') { line++; lastnl = cpos; } cpos++; }
        chars = cpos;
        col = lastnl == (size_t)-1 ? chars + 1 : chars - lastnl;
    }
    if (why && whylen) snprintf(why, whylen, "json.decoder.JSONDecodeError: %s: line %lu column %lu (char %lu)", p.msg,
                                (unsigned long)line, (unsigned long)col, (unsigned long)chars);
    return 0;
}

/* ---- dumps ---- */
typedef struct pj_out { char *p; size_t n, cap; } pj_out;
static void pj_put(pj_out *o, const char *s, size_t n) {
    if (o->n + n + 1 > o->cap) {
        size_t c = o->cap ? o->cap : 256; char *g;
        while (c < o->n + n + 1) c *= 2;
        if (!(g = realloc(o->p, c))) { fputs("MemoryError\n", stderr); exit(1); }
        o->p = g; o->cap = c;
    }
    memcpy(o->p + o->n, s, n); o->n += n; o->p[o->n] = 0;
}
static void pj_puts(pj_out *o, const char *s) { pj_put(o, s, strlen(s)); }
/* float.__repr__: the shortest round-tripping digits; exponent form when decpt <= -4 or decpt > 16 */
static void pj_repr_float(pj_out *o, double d) {
    char t[64], digits[32], r[64]; int p, decpt = 0, nd = 0, i, j = 0; char *e;
    if (d != d) { pj_puts(o, "NaN"); return; }
    if (d > 1.7976931348623157e308) { pj_puts(o, "Infinity"); return; }
    if (d < -1.7976931348623157e308) { pj_puts(o, "-Infinity"); return; }
    if (d == 0) { pj_puts(o, (1.0 / d) < 0 ? "-0.0" : "0.0"); return; }
    for (p = 1; p <= 17; p++) { snprintf(t, sizeof t, "%.*e", p - 1, d); if (strtod(t, 0) == d) break; }
    for (i = d < 0 ? 1 : 0; t[i] && t[i] != 'e'; i++) if (t[i] != '.') digits[nd++] = t[i];
    while (nd > 1 && digits[nd - 1] == '0') nd--;
    digits[nd] = 0;
    e = strchr(t, 'e'); decpt = atoi(e + 1) + 1;
    if (d < 0) r[j++] = '-';
    if (decpt <= -4 || decpt > 16) {
        int x = decpt - 1;
        r[j++] = digits[0];
        if (nd > 1) { r[j++] = '.'; for (i = 1; i < nd; i++) r[j++] = digits[i]; }
        j += snprintf(r + j, sizeof r - (size_t)j, "e%c%02d", x < 0 ? '-' : '+', x < 0 ? -x : x);
    } else if (decpt <= 0) {
        r[j++] = '0'; r[j++] = '.';
        for (i = 0; i < -decpt; i++) r[j++] = '0';
        for (i = 0; i < nd; i++) r[j++] = digits[i];
    } else {
        for (i = 0; i < decpt; i++) r[j++] = i < nd ? digits[i] : '0';
        r[j++] = '.';
        if (nd > decpt) for (i = decpt; i < nd; i++) r[j++] = digits[i]; else r[j++] = '0';
    }
    r[j] = 0;
    pj_puts(o, r);
}
static void pj_dump_str(pj_out *o, const char *str, size_t n) {
    const unsigned char *s = (const unsigned char *)str; size_t i = 0; char t[16];
    pj_put(o, "\"", 1);
    while (i < n) {
        unsigned long c = s[i]; size_t l = 1;
        if (c >= 0x80) {   /* lenient UTF-8 (surrogates allowed) */
            int need = c >= 0xF0 ? 3 : c >= 0xE0 ? 2 : c >= 0xC0 ? 1 : 0, k;
            unsigned long cp = need == 3 ? (c & 0x07) : need == 2 ? (c & 0x0F) : (c & 0x1F);
            for (k = 1; k <= need && i + (size_t)k < n && (s[i + k] & 0xC0) == 0x80; k++) cp = (cp << 6) | (s[i + k] & 0x3F);
            if (need && k == need + 1) { c = cp; l = (size_t)need + 1; }
        }
        if (c == '"') pj_puts(o, "\\\"");
        else if (c == '\\') pj_puts(o, "\\\\");
        else if (c == '\n') pj_puts(o, "\\n");
        else if (c == '\r') pj_puts(o, "\\r");
        else if (c == '\t') pj_puts(o, "\\t");
        else if (c == '\b') pj_puts(o, "\\b");
        else if (c == '\f') pj_puts(o, "\\f");
        else if (c >= 0x20 && c < 0x7F) { t[0] = (char)c; pj_put(o, t, 1); }
        else if (c < 0x10000) { snprintf(t, sizeof t, "\\u%04lx", c); pj_puts(o, t); }
        else { unsigned long v = c - 0x10000; snprintf(t, sizeof t, "\\u%04lx\\u%04lx", 0xD800 + (v >> 10), 0xDC00 + (v & 0x3FF)); pj_puts(o, t); }
        i += l;
    }
    pj_put(o, "\"", 1);
}
static void pj_nl(pj_out *o, int indent, int level) { int i; pj_put(o, "\n", 1); for (i = 0; i < indent * level; i++) pj_put(o, " ", 1); }
static void pj_dump(pj_out *o, const pj_value *v, int indent, int level) {
    size_t i;
    switch (v->type) {
    case PJ_NULL: pj_puts(o, "null"); return;
    case PJ_BOOL: pj_puts(o, v->b ? "true" : "false"); return;
    case PJ_INT: pj_put(o, v->s, v->n); return;
    case PJ_FLOAT: pj_repr_float(o, v->d); return;
    case PJ_STR: pj_dump_str(o, v->s, v->n); return;
    case PJ_ARR:
        if (!v->len) { pj_puts(o, "[]"); return; }
        pj_puts(o, "[");
        for (i = 0; i < v->len; i++) {
            if (indent >= 0) { if (i) pj_puts(o, ","); pj_nl(o, indent, level + 1); } else if (i) pj_puts(o, ", ");
            pj_dump(o, v->items[i], indent, level + 1);
        }
        if (indent >= 0) pj_nl(o, indent, level);
        pj_puts(o, "]"); return;
    case PJ_OBJ:
        if (!v->len) { pj_puts(o, "{}"); return; }
        pj_puts(o, "{");
        for (i = 0; i + 1 < v->len; i += 2) {
            if (indent >= 0) { if (i) pj_puts(o, ","); pj_nl(o, indent, level + 1); } else if (i) pj_puts(o, ", ");
            pj_dump_str(o, v->items[i]->s, v->items[i]->n); pj_puts(o, ": ");
            pj_dump(o, v->items[i + 1], indent, level + 1);
        }
        if (indent >= 0) pj_nl(o, indent, level);
        pj_puts(o, "}"); return;
    }
}
int pj_dumps(const pj_value *v, int indent, char **out, size_t *n) {
    pj_out o = { 0, 0, 0 };
    pj_put(&o, "", 0);
    pj_dump(&o, v, indent, 0);
    *out = o.p; *n = o.n;
    return 0;
}
