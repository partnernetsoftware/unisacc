/* Test shared-runtime link provider only; no product/runtime policy change. */
#pragma unisa module libffiprovider
#pragma unisa use pyjson
#pragma unisa use runtimecopy
#include <cx.h>
#include <fcntl.h>
typedef struct { char *link; char sha256[65]; int pic; char manifest_sha256[65]; char contract[192]; } ffip_provider;
static char FFIP_ERROR[256];
const char*ffip_error(void){return FFIP_ERROR;}
static int ffip_no(const char*s){snprintf(FFIP_ERROR,sizeof FFIP_ERROR,"%s",s);return -1;}
static int ffip_hash(const char*path,char h[65]){
 struct stat s,t;if(stat(path,&s))return ffip_no("provider stat failed");if(!S_ISREG(s.st_mode)||s.st_size<=0)return ffip_no("provider must be nonempty regular file");
 int fd=open(path,O_RDONLY|O_NONBLOCK);if(fd<0)return ffip_no("provider open failed");if(fstat(fd,&t)||!S_ISREG(t.st_mode)||s.st_dev!=t.st_dev||s.st_ino!=t.st_ino||s.st_size!=t.st_size){close(fd);return ffip_no("provider open identity changed");}
 size_t n=(size_t)s.st_size,k=0;char*b=malloc(n+1),extra;if(!b){close(fd);return ffip_no("provider allocation failed");}
 while(k<n){ssize_t r=read(fd,b+k,n-k);if(r<0){
 if(errno==EINTR)continue;
 }if(r<=0){free(b);close(fd);return ffip_no("provider read failed");}k+=r;}
 int bad=read(fd,&extra,1)!=0||fstat(fd,&t)||!S_ISREG(t.st_mode)||s.st_dev!=t.st_dev||s.st_ino!=t.st_ino||s.st_size!=t.st_size||s.st_mtime!=t.st_mtime||s.st_ctime!=t.st_ctime;
 if(close(fd))bad=1;if(bad){free(b);return ffip_no("provider changed during read");}cx_sha256_hex(b,n,h);free(b);return 0;
}
static int ffip_eq(pj_value*v,const char*s){return v&&v->type==PJ_STR&&v->n==strlen(s)&&!memcmp(v->s,s,v->n);}
static void ffip_json_free(pj_value*v){if(!v)return;for(size_t i=0;i<v->len;i++)ffip_json_free(v->items[i]);free(v->items);free(v->s);free(v);}
static int ffip_qualified(ffip_provider*p,const char*root,const char*target){
 static const char*required[]={"lib/libffi.a","include/ffi.h","include/ffitarget.h","include/ffi/ffi.h","include/ffi/ffitarget.h","LICENSE"};
 static const char*source="f3a3082a23b37c293a4fcd1053147b371f2ff91fa7ea1b2a52e335676bac82dc";
 char dir[4096],mf[4200],why[500],first[65],last[65];char*text=0;size_t n;pj_value*doc=0;int rc=-1;
 if(!*root)return ffip_no("explicit provider is empty");
 if(rtc_resolve(root,1,dir,sizeof dir,why,sizeof why))return ffip_no("explicit provider resolve failed");
 struct stat st;if(stat(dir,&st)||!S_ISDIR(st.st_mode))return ffip_no("explicit provider must be a directory");
 snprintf(mf,sizeof mf,"%s/manifest.json",dir);if(ffip_hash(mf,first))return -1;
 text=cx_read(mf,&n);if(!text){ffip_no("explicit manifest read failed");goto done;}cx_sha256_hex(text,n,last);if(strcmp(first,last)){ffip_no("explicit manifest changed during read");goto done;}
 doc=pj_loads(text,n,why,sizeof why);if(!doc||doc->type!=PJ_OBJ){ffip_no("invalid explicit provider manifest");goto done;}
 pj_value*schema=pj_get(doc,"schema");if(!schema||schema->type!=PJ_INT||strcmp(schema->s,"1")||!ffip_eq(pj_get(doc,"target"),target)||!ffip_eq(pj_get(doc,"version"),"3.5.2")||!ffip_eq(pj_get(doc,"source_tar_sha256"),source)){ffip_no("unqualified explicit provider identity");goto done;}
 pj_value*arts=pj_get(doc,"artifacts");if(!arts||arts->type!=PJ_OBJ){ffip_no("incomplete explicit provider artifacts");goto done;}
 for(int i=0;i<6;i++){char file[4300],h[65],bytes[40];pj_value*item=pj_get(arts,required[i]);if(!item||item->type!=PJ_OBJ){ffip_no("missing explicit provider artifact");goto done;}snprintf(file,sizeof file,"%s/%s",dir,required[i]);if(stat(file,&st)||!S_ISREG(st.st_mode)||st.st_size<=0){ffip_no("explicit provider artifact must be nonempty regular file");goto done;}snprintf(bytes,sizeof bytes,"%lld",(long long)st.st_size);pj_value*sz=pj_get(item,"bytes");if(!sz||sz->type!=PJ_INT||strcmp(sz->s,bytes)){ffip_no("explicit provider artifact size mismatch");goto done;}if(ffip_hash(file,h))goto done;if(!ffip_eq(pj_get(item,"sha256"),h)){ffip_no("explicit provider artifact SHA mismatch");goto done;}if(!i)strcpy(p->sha256,h);}
 if(ffip_hash(mf,last))goto done;if(strcmp(first,last)){ffip_no("explicit manifest changed during verification");goto done;}
 p->link=malloc(strlen(dir)+16);if(!p->link){p->link="-lffi";ffip_no("provider allocation failed");goto done;}sprintf(p->link,"%s/lib/libffi.a",dir);p->pic=1;strcpy(p->manifest_sha256,first);snprintf(p->contract,sizeof p->contract,"qualified-schema1:%s:3.5.2:%s",target,source);rc=0;
done:ffip_json_free(doc);free(text);return rc;
}
static int ffip_select_impl(ffip_provider*p){p->link="-lffi";p->sha256[0]=0;p->pic=0;p->manifest_sha256[0]=0;p->contract[0]=0;
#ifdef __linux__
#if defined(__x86_64__)
 const char*configured=getenv("UNISACC_FFI_X86_PROVIDER");if(configured&&*configured)return ffip_qualified(p,configured,"lnx/x86_64");
#elif defined(__aarch64__)
 const char*configured=getenv("UNISACC_FFI_PROVIDER");if(configured&&*configured)return ffip_qualified(p,configured,"lnx/arm64");
#endif
 const char*list=getenv("LIBRARY_PATH");if(list){const char*a=list;for(;;){const char*e=strchr(a,':');size_t n=e?(size_t)(e-a):strlen(a);char*path=malloc(n+32);if(!path)return ffip_no("provider allocation failed");if(!n)strcpy(path,"./libffi_pic.a");else if(*a=='/')snprintf(path,n+32,"%.*s/libffi_pic.a",(int)n,a);else snprintf(path,n+32,"./%.*s/libffi_pic.a",(int)n,a);struct stat s;
 if(stat(path,&s)){int err=errno;free(path);if(err!=ENOENT)return ffip_no("LIBRARY_PATH stat failed (only ENOENT may skip)");}
 else{if(!S_ISREG(s.st_mode)||s.st_size<=0){free(path);return ffip_no("provider must be nonempty regular file");}if(ffip_hash(path,p->sha256)){free(path);return -1;}p->link=path;p->pic=1;return 0;}
 if(!e)break;a=e+1;}}
#endif
 return 0;
}
int ffip_select(ffip_provider*p){return ffip_select_impl(p);}
int ffip_verify(const ffip_provider*p){ffip_provider now;if(ffip_select_impl(&now))return -1;int bad=now.pic!=p->pic||strcmp(now.link,p->link)||strcmp(now.sha256,p->sha256)||strcmp(now.manifest_sha256,p->manifest_sha256)||strcmp(now.contract,p->contract);if(now.pic)free(now.link);return bad?ffip_no("selected provider changed"):0;}
