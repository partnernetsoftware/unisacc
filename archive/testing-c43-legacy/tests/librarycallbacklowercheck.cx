#include <cx.h>
#include <stdint.h>
/* Model verdict only. Producer executes through existing bound/SC1/RF; no
   parser, provider lookup, lifecycle or stage implementation lives here. */
static uint64_t read64(const unsigned char*p){uint64_t n=0;for(int i=0;i<8;i++)n|=(uint64_t)p[i]<<(8*i);return n;}
static int bytes(const char*a,const char*b){size_t n,m;char*x=cx_read(a,&n),*y=cx_read(b,&m);if(!x||!y){free(x);free(y);return 2;}int ok=n==m&&!memcmp(x,y,n);free(x);free(y);return ok?0:1;}
static int payload(const char*p,const char*want){size_t n;char*b=cx_read(p,&n);if(!b)return 2;size_t at=0;if(n>=8&&!memcmp(b,"reject: ",8))at=8;while(n>at&&(b[n-1]=='\n'||b[n-1]=='\r'))n--;size_t z=strlen(want);int ok=n-at==z&&!memcmp(b+at,want,z);free(b);return ok?0:1;}
static int refused(const char*status,const char*out,const char*err,const char*ref,const char*reason){size_t n,m;char*s=cx_read(status,&n),*o=cx_read(out,&m);if(!s||!o){free(s);free(o);return 2;}int exact=n==2&&s[0]=='1'&&s[1]=='\n';free(s);free(o);if(!exact)return 2;if(m)return 1;int a=payload(err,reason),b=payload(ref,reason);return a==2||b==2?2:(a||b?1:0);}
static int projection(const char*model,const char*reference){size_t n,m;unsigned char*b=(unsigned char*)cx_read(model,&n),*r=(unsigned char*)cx_read(reference,&m);if(!b||!r){free(b);free(r);return 2;}int rc=1;if(n>=32&&!memcmp(b,"USLOWP2\n",8)){uint64_t a=read64(b+8),z=read64(b+16),d=read64(b+24);if(a<=n-32&&z<=n-32-a&&d==n-32-a-z&&z==m&&!memcmp(b+32+(size_t)a,r,m))rc=0;}free(b);free(r);return rc;}
static int selftest(const char*d){char a[4096],b[4096],s[4096],o[4096],e[4096],r[4096];snprintf(a,sizeof a,"%s/a",d);snprintf(b,sizeof b,"%s/b",d);snprintf(s,sizeof s,"%s/status",d);snprintf(o,sizeof o,"%s/output",d);snprintf(e,sizeof e,"%s/error",d);snprintf(r,sizeof r,"%s/reference-error",d);if(cx_write(a,"abc",3)||cx_write(b,"abc",3)||bytes(a,b))return 1;if(cx_write(b,"abd",3)||bytes(a,b)!=1)return 1;const char*reason="library callback graph mismatch symbol fixture";if(cx_write(s,"1\n",2)||cx_write(o,"",0)||cx_write(e,reason,strlen(reason))||cx_write(r,reason,strlen(reason))||refused(s,o,e,r,reason))return 1;if(cx_write(s,"142\n",4)||refused(s,o,e,r,reason)!=2)return 1;if(cx_write(s,"1\n",2)||cx_write(o,"x",1)||refused(s,o,e,r,reason)!=1)return 1;puts("callbacklower selftest: bytes/NEG/timeout/empty-output checks; NO MODEL PASS");return 0;}
int main(int argc,char**argv){if(argc==3&&!strcmp(argv[1],"--selftest"))return selftest(argv[2]);if(argc!=3||strcmp(argv[1],"--plan"))return 2;size_t n;char*text=cx_read(argv[2],&n);if(!text)return 2;int count=0;
 for(char*p=text;*p;){char*end=strchr(p,'\n');if(!end){free(text);return 2;}*end=0;if(*p&&*p!='#'){char*f[8];f[0]=p;int k=1;for(char*q=p;*q;q++)if(*q=='\t'){*q=0;if(k==8){free(text);return 2;}f[k++]=q+1;}if(k!=8){free(text);return 2;}int rc;if(!strcmp(f[0],"bytes"))rc=bytes(f[2],f[3]);else if(!strcmp(f[0],"projection"))rc=projection(f[2],f[3]);else if(!strcmp(f[0],"refusal"))rc=refused(f[2],f[3],f[4],f[5],f[6]);else{free(text);return 2;}if(rc){printf("%s %s rc%d\n",rc==2?"MECHANISM":"CONTRACT_RED",f[1],rc);free(text);return rc;}count++;}p=end+1;}
 free(text);if(!count){puts("MECHANISM empty callback plan");return 2;}printf("callbacklower: %d verdict rows PASS; projection is not full lower/ABI\n",count);return 0;}
