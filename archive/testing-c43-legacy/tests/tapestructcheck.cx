#!/usr/bin/env -S unisacc.com -run
/* tapestructcheck.cx PRODUCT UA: program-structure refusals past the tape domain,
   target lnx/x86_64.  These are named "not covered" refusals without a line
   number (they are properties of the whole program, not of one line), so they
   do not belong in tapedomaincheck's per-line discipline.
   Control: a branch to a defined label builds and runs (exit 7).
   Negatives: a branch to an undefined label and a label defined twice refuse
   by name with rc1, empty stdout and no output file; a .ld width outside the
   encoder slice refuses with the encoder-slice naming (an honest not-covered,
   registered).  Duplicate .str/.bss names are ACCEPTED today by product and
   reference alike, images byte-identical -- registered acceptance: if either
   side starts refusing, this leaf goes red and the registration is revisited.
   The reference is the classic C reference UA (tests/build_ref.sh; the gate
   passes $UA); until 2026-10-23 it was the archived Python seed
   (plans/unisa-detach.md W1-G: control = UA). */
static char D[4096], P[4096], U[4096];
static int checks, bad;
static char *slurp(const char *name, size_t *n) {
    char path[8192];snprintf(path,sizeof path,"%s/%s",D,name);return cx_read(path,n);
}
static int put(const char *name, const char *body) {
    char path[8192];snprintf(path,sizeof path,"%s/%s",D,name);
    return cx_write(path,body,strlen(body));
}
static int note(const char *name, int ok) {
    printf("struct %-16s %s\n",name,ok ? "pass" : "FAIL");
    checks++;if(!ok)bad++;return !ok;
}
static int build(const char *name, const char *tape, const char *refusal) {
    char cmd[16384],img[16384],*out=0,*err=0;size_t on=0,en=0;int rc,ok;
    snprintf(img,sizeof img,"%s/%s.img",D,name);
    snprintf(cmd,sizeof cmd,"%s'%s' '%s/%s' -b lnx/x86_64 -o '%s' 2>'%s/%s.err'",
        strstr(P,".com") ? "sh " : "",P,D,tape,img,D,name);
    rc=cx_run_timeout(cmd,15,&out,&on);
    { char e[8192];snprintf(e,sizeof e,"%s.err",name);err=slurp(e,&en); }
    if (!refusal) {
        char *b;size_t bn=0;char nm[8192];snprintf(nm,sizeof nm,"%s.img",name);
        b=slurp(nm,&bn);ok=rc==0 && on==0 && b && bn>0;free(b);
    } else {
        struct stat st;
        ok=rc==1 && on==0 && stat(img,&st)!=0 && err && strstr(err,refusal);
    }
    if(note(name,ok))fprintf(stderr,"rc=%d stdout(%zu) stderr=%s\n",rc,on,err?err:"<missing>");
    free(out);free(err);return !ok;
}
int main(int argc,char **argv) {
    char own[]="/tmp/structXXXXXX",cwd[4096],cmd[16384],*a,*b;size_t an,bn;int rc;
    if(argc!=3)return 2;
    if(!getcwd(cwd,sizeof cwd) || !mkdtemp(own))return 2;
    snprintf(D,sizeof D,"%s",own);
    if(argv[1][0]=='/')snprintf(P,sizeof P,"%s",argv[1]);else snprintf(P,sizeof P,"%s/%s",cwd,argv[1]);
    if(argv[2][0]=='/')snprintf(U,sizeof U,"%s",argv[2]);else snprintf(U,sizeof U,"%s/%s",cwd,argv[2]);
    if(strchr(P,39)||strchr(D,39)||strchr(U,39))return 2;
    if(put("ctl.tape","_start:\n  imm r4, 0\n  imm r0, 7\n  jumpz r4, done\n  imm r0, 9\ndone:\n  ret\n") ||
       put("undef.tape","_start:\n  jumpz r1, nowhere\n  ret\n") ||
       put("dup.tape","_start:\n  ret\n_start:\n  ret\n") ||
       put("width.tape","_start:\n  .ld r0, [r1+0], 3\n  ret\n") ||
       put("dupdata.tape",".str s \"a\"\n.str s \"b\"\n.bss z 8\n.bss z 8\n_start:\n  .lea r0, s\n  ret\n"))return 2;
    build("control","ctl.tape",NULL);
    /* the control also runs: the defined branch is taken, exit 7 */
    snprintf(cmd,sizeof cmd,"%s'%s' '%s/ctl.tape' -run >/dev/null 2>&1",
        strstr(P,".com") ? "sh " : "",P,D);
    rc=cx_run_timeout(cmd,15,0,0);
    note("control-run",rc==7);
    build("neg-undef-label","undef.tape","not covered: a branch to an undefined label");
    build("neg-dup-label","dup.tape","not covered: a label defined twice");
    build("neg-ld-width","width.tape","not covered: an op outside the first encoder slice");
    build("ctl-dup-data","dupdata.tape",NULL);
    snprintf(cmd,sizeof cmd,
        "'%s' '%s/dupdata.tape' -b lnx/x86_64 -o '%s/dupdata.uaimg' >/dev/null 2>&1",U,D,D);
    note("dup-data-ref",cx_run_timeout(cmd,25,0,0)==0);
    a=slurp("ctl-dup-data.img",&an);b=slurp("dupdata.uaimg",&bn);
    note("dup-data-bytes",a&&b&&an==bn&&!memcmp(a,b,an));
    free(a);free(b);
    /* text-form edges.  No trailing newline, a 5000-char symbol name and a
       UTF-8 BOM (which both sides treat as ordinary label bytes) are accepted
       with product/reference image parity.  CRLF is one line (the tape
       domain's authored rule): the domain echoes the bytes under -S, and since
       the lower separator class and the carrier emitter learned CR (ledger 2c,
       B-lower) the image route builds a CRLF tape byte-identical to its LF
       twin, as the reference always did. */
    if(put("noeol.tape","_start:\n  ret") ||
       put("bom.tape","\xef\xbb\xbf_start:\n  ret\n") ||
       put("crlf.tape","_start:\r\n  imm r0, 0\r\n  ret\r\n"))return 2;
    { char nm[6000];size_t i;for(i=0;i<5000;i++)nm[i]='n';nm[5000]=0;
      char body[8192];snprintf(body,sizeof body,".str %s \"x\"\n_start:\n  ret\n",nm);
      if(put("longname.tape",body))return 2; }
    { static const char *T[]={"noeol","bom","longname",0};int i;
      for(i=0;T[i];i++){
        char tp[64];snprintf(tp,sizeof tp,"%s.tape",T[i]);
        char lbl[64];snprintf(lbl,sizeof lbl,"ctl-%s",T[i]);
        build(lbl,tp,NULL);
        snprintf(cmd,sizeof cmd,
            "'%s' '%s/%s' -b lnx/x86_64 -o '%s/%s.uaimg' >/dev/null 2>&1",U,D,tp,D,T[i]);
        { char ok=cx_run_timeout(cmd,25,0,0)==0;char rl[64];snprintf(rl,sizeof rl,"%s-ref",T[i]);note(rl,ok); }
        { char ia[64],ib2[64],bl[64];size_t xn=0,yn=0;char *x,*y;
          snprintf(ia,sizeof ia,"ctl-%s.img",T[i]);snprintf(ib2,sizeof ib2,"%s.uaimg",T[i]);
          x=slurp(ia,&xn);y=slurp(ib2,&yn);
          snprintf(bl,sizeof bl,"%s-bytes",T[i]);
          note(bl,x&&y&&xn==yn&&!memcmp(x,y,xn));free(x);free(y); }
      } }
    snprintf(cmd,sizeof cmd,"%s'%s' '%s/crlf.tape' -S -o '%s/crlf.S' 2>/dev/null",
        strstr(P,".com") ? "sh " : "",P,D,D);
    note("crlf-domain",cx_run_timeout(cmd,15,0,0)==0);
    { static const char CRLF[]="_start:\r\n  imm r0, 0\r\n  ret\r\n";
      size_t n=0;char *s=slurp("crlf.S",&n);
      note("crlf-identity",s&&n==sizeof CRLF-1&&!memcmp(s,CRLF,n));free(s); }
    if(put("lf.tape","_start:\n  imm r0, 0\n  ret\n"))return 2;
    build("crlf-build","crlf.tape",NULL);
    build("lf-build","lf.tape",NULL);
    a=slurp("crlf-build.img",&an);b=slurp("lf-build.img",&bn);
    note("crlf-lf-bytes",a&&b&&an==bn&&!memcmp(a,b,an));free(a);free(b);
    snprintf(cmd,sizeof cmd,
        "'%s' '%s/crlf.tape' -b lnx/x86_64 -o '%s/crlf.uaimg' >/dev/null 2>&1",U,D,D);
    note("crlf-ref-accepts",cx_run_timeout(cmd,25,0,0)==0);
    a=slurp("crlf-build.img",&an);b=slurp("crlf.uaimg",&bn);
    note("crlf-ref-bytes",a&&b&&an==bn&&!memcmp(a,b,an));free(a);free(b);
    printf("struct checks %d bad %d\n",checks,bad);
    return bad?1:0;
}
