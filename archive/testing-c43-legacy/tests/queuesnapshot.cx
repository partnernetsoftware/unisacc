#!/usr/bin/env -S unisacc.com -run
/* Read-only queue snapshot: original absent/member/oct-mode/nonlink-file SHA
   records. Global directory order (not DFS); member symlinks are not followed. */
typedef struct { char *path,*rel; char **names; size_t n,cap; int yielded; } SnapDir;
static SnapDir *DIRS; static size_t ND,DCAP;
static void fail(const char *why,const char *p){fprintf(stderr,"queuesnapshot: %s: %s\n",why,p?p:"");exit(1);}
static void emit(const char *s){size_t n=strlen(s);while(n){ssize_t k=write(1,s,n);if(k>0){s+=k;n-=(size_t)k;}else if(k<0&&errno==EINTR)continue;else fail("stdout write failed",0);}}
static void *alloc(size_t n){void *p=malloc(n?n:1);if(!p)fail("allocation",0);return p;}
static char *copy(const char *s){size_t n=strlen(s);char *p=alloc(n+1);memcpy(p,s,n+1);return p;}
static char *join(const char *a,const char *b){size_t an=strlen(a),bn=strlen(b);int slash=an&&a[an-1]!='/';char *p=alloc(an+(size_t)slash+bn+1);memcpy(p,a,an);if(slash)p[an++]='/';memcpy(p+an,b,bn+1);return p;}
/* Strict scalar UTF8, then surrogateescape per undecodable byte. */
static unsigned nextcp(const unsigned char *s,size_t n,size_t *at){
 size_t i=*at;unsigned c=s[i],v,lo=0x80,hi=0xbf;int need,k;
 if(c<0x80){*at=i+1;return c;}
 if(c>=0xc2&&c<=0xdf)need=1;
 else if(c>=0xe0&&c<=0xef){need=2;if(c==0xe0)lo=0xa0;if(c==0xed)hi=0x9f;}
 else if(c>=0xf0&&c<=0xf4){need=3;if(c==0xf0)lo=0x90;if(c==0xf4)hi=0x8f;}
 else {*at=i+1;return 0xdc00+c;}
 if(i+(size_t)need>=n){*at=i+1;return 0xdc00+c;}
 v=c&(0x3f>>need);
 for(k=1;k<=need;k++){unsigned b=s[i+(size_t)k];if(k==1?(b<lo||b>hi):(b<0x80||b>0xbf)){*at=i+1;return 0xdc00+c;}v=(v<<6)|(b&63);}
 *at=i+(size_t)need+1;return v;
}
static int textcmp(const char *a,const char *b){size_t an=strlen(a),bn=strlen(b),ai=0,bi=0;while(ai<an&&bi<bn){unsigned ac=nextcp((const unsigned char*)a,an,&ai),bc=nextcp((const unsigned char*)b,bn,&bi);if(ac!=bc)return ac<bc?-1:1;}return ai<an?1:bi<bn?-1:0;}
static int namecmp(const void *a,const void *b){return textcmp(*(const char *const*)a,*(const char *const*)b);}
static int dircmp(const void *a,const void *b){return textcmp(((const SnapDir*)a)->rel,((const SnapDir*)b)->rel);}
static void adddir(char *path,char *rel){SnapDir *p;if(ND==DCAP){size_t cap=DCAP?DCAP*2:16;p=realloc(DIRS,cap*sizeof *p);if(!p)fail("allocation",0);DIRS=p;DCAP=cap;}memset(&DIRS[ND],0,sizeof DIRS[ND]);DIRS[ND].path=path;DIRS[ND].rel=rel;ND++;}
static void addname(size_t d,const char *name){SnapDir *p=&DIRS[d];char **q;if(p->n==p->cap){size_t cap=p->cap?p->cap*2:16;q=realloc(p->names,cap*sizeof *q);if(!q)fail("allocation",0);p->names=q;p->cap=cap;}p->names[p->n++]=copy(name);}
static void gather(const char *root){
 size_t d,i;adddir(copy(root),copy(""));
 for(d=0;d<ND;d++){
  DIR *dp=opendir(DIRS[d].path);struct dirent *e;
  /* Fail closed on directory I/O; main already handled non-directory roots. */
  if(!dp)fail("opendir failed",DIRS[d].path);
  for(;;){
   errno=0;e=readdir(dp);
   if(!e){if(errno){closedir(dp);fail("readdir failed",DIRS[d].path);}break;}
   if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;addname(d,e->d_name);
  }
  if(closedir(dp))fail("closedir failed",DIRS[d].path);DIRS[d].yielded=1;
  if(DIRS[d].n>1)qsort(DIRS[d].names,DIRS[d].n,sizeof *DIRS[d].names,namecmp);
  for(i=0;i<DIRS[d].n;i++){
   char *p=join(DIRS[d].path,DIRS[d].names[i]);struct stat st;
   if(lstat(p,&st))fail("member lstat failed",p);
   if(S_ISDIR(st.st_mode))adddir(p,join(DIRS[d].rel,DIRS[d].names[i]));else free(p);
  }
 }
 /* Common root prefix: relative directory string order equals full path order. */
 if(ND>1)qsort(DIRS,ND,sizeof *DIRS,dircmp);
}
int main(int argc,char **argv){
 struct stat st,follow;size_t d,i;const char *root;
 if(argc!=2){fprintf(stderr,"queuesnapshot: usage ROOT\n");return 2;}
 root=argv[1];
 /* Preserve original lexists semantics, including dangling root symlink. */
 if(lstat(root,&st)){if(errno==ENOENT){emit("absent\n");return 0;}fail("root lstat failed",root);}
 if(stat(root,&follow)){if(S_ISLNK(st.st_mode)&&errno==ENOENT)return 0;fail("root stat failed",root);}
 if(!S_ISDIR(follow.st_mode))return 0;
 gather(root);
 for(d=0;d<ND;d++)if(DIRS[d].yielded)for(i=0;i<DIRS[d].n;i++){
  char *p=join(DIRS[d].path,DIRS[d].names[i]),*rel=join(DIRS[d].rel,DIRS[d].names[i]);char h[65];h[0]=0;
  if(lstat(p,&st))fail("lstat failed",p);
  if(S_ISREG(st.st_mode)){
   size_t n;char *bytes=cx_read(p,&n);if(!bytes)fail("read failed",p);cx_sha256_hex(bytes,n,h);free(bytes);
  }
  {char mode[64];snprintf(mode,sizeof mode," 0o%lo ",(unsigned long)st.st_mode);emit(rel);emit(mode);emit(h);emit("\n");}
  free(p);free(rel);
 }
 for(d=0;d<ND;d++){for(i=0;i<DIRS[d].n;i++)free(DIRS[d].names[i]);free(DIRS[d].names);free(DIRS[d].path);free(DIRS[d].rel);}free(DIRS);
 return 0;
}
