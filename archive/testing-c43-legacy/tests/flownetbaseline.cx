/* flownetbaseline.cx -- flownet W1 (plans/m4-flownet-cx-module.md §4 W1): the m4 behaviour baseline.
   tests/flownet-baseline.tsv freezes what the m4 flow x net path does today, so W2's flownet/*.cx can be held to it:
     acc       per net (exact, total) from `python3 -m m4 acc`, the wired/reserved lists and the verdict
     out1..4   per program (tests/ujs2wasm/corpus/*.ujs then m4/probes/*.ujs, m4's order): source sha256, m4 output
               bytes and sha256 from `python3 -m m4 build`, and its trace bookkeeping (phase, net, hits, gold fallbacks);
               four shards so that every step stays well inside 60 s
     check     `python3 -m m4 check`: per program same/DIFF/skip against the ujs gold path, the negative programs, summary
     selftest  `python3 -m m4 selftest`: the isel choose proof and the measured decision kinds per net
     expect    the EXPECT table of m4/selftest.py, read from the source (no Python)
   The Python m4 package is only the measurement oracle here (run as a child, never imported); this file is not in flownet/.
   Usage (repository root, every step under tests/bound 58):
     sh ./unisacc.com -run tests/flownetbaseline.cx -- --check PART [ROOT]    recompute PART, compare with the recorded section
     sh ./unisacc.com -run tests/flownetbaseline.cx -- --write PART [ROOT]    re-record PART (the other sections are kept)
     sh ./unisacc.com -run tests/flownetbaseline.cx -- --emit PART [ROOT]     print PART's rows to stdout
     sh ./unisacc.com -run tests/flownetbaseline.cx -- --check-file [ROOT]    no Python: shape and invariants of the whole
         file (every section, acc exact == total, gold fallbacks 0, check same == out with equal bytes, selftest PASS with
         decides == expect), corpus sources unchanged, and the expect section recomputed from m4/selftest.py
   Errors are "flownet-baseline: PATH[:LINE]: reason" on stderr, rc 1; a mismatch names the first differing row. */

#define NPARTS 8
#define NSHARD 4
#define TSV "tests/flownet-baseline.tsv"
static const char *PARTS[NPARTS] = { "acc", "out1", "out2", "out3", "out4", "check", "selftest", "expect" };
#define NNETS 10
static const char *NETS[NNETS] = { "lex", "parse", "type", "scope", "shape", "irsel", "ic", "isel", "enc", "reloc" };
#define ORACLE_SECS 50

/* ---------- small growable string ---------- */
typedef struct { char *s; size_t n, cap; } Buf;
static void die(const char *a, const char *b) { fprintf(stderr, "flownet-baseline: %s%s\n", a, b ? b : ""); exit(1); }
static void badd(Buf *b, const char *s, size_t k) {
    if (b->n + k + 1 > b->cap) {
        size_t c = b->cap ? b->cap : 4096; char *g;
        while (c < b->n + k + 1) c *= 2;
        if (!(g = realloc(b->s, c))) die("out of memory", 0);
        b->s = g; b->cap = c;
    }
    memcpy(b->s + b->n, s, k); b->n += k; b->s[b->n] = 0;
}
static void bs(Buf *b, const char *s) { badd(b, s, strlen(s)); }
static void bt(Buf *b, const char *s) { bs(b, "\t"); bs(b, s); }          /* tab, then a field */
static void bl(Buf *b, long v) { char t[32]; snprintf(t, sizeof t, "\t%ld", v); bs(b, t); }
static void bnl(Buf *b) { bs(b, "\n"); }

/* ---------- lines and fields ---------- */
#define MAXF 16
static int split(char *line, char sep, char **f) {     /* in place; empty fields kept when sep is tab */
    int n = 0; char *p = line;
    if (sep == ' ') {
        for (;;) {
            while (*p == ' ') p++;
            if (!*p) return n;
            if (n == MAXF) return -1;
            f[n++] = p;
            while (*p && *p != ' ') p++;
            if (*p) *p++ = 0;
        }
    }
    for (;;) {
        if (n == MAXF) return -1;
        f[n++] = p;
        while (*p && *p != sep) p++;
        if (!*p) return n;
        *p++ = 0;
    }
}
static int isnum(const char *s) { if (!*s) return 0; for (; *s; s++) if (*s < '0' || *s > '9') return 0; return 1; }
static int ishex64(const char *s) { int i; for (i = 0; i < 64; i++) if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f'))) return 0; return !s[64]; }
static int netidx(const char *s) { int i; for (i = 0; i < NNETS; i++) if (!strcmp(s, NETS[i])) return i; return -1; }
static int partidx(const char *s) { int i; for (i = 0; i < NPARTS; i++) if (!strcmp(s, PARTS[i])) return i; return -1; }

/* ---------- the oracle (python3 -m m4 ...) as a child ---------- */
static char *oracle(char *const argv[], int *rc) {
    char *out = 0; size_t n = 0;
    *rc = cx_runv_timeout(argv, ORACLE_SECS, &out, &n);
    if (*rc == 124) die("oracle timed out: python3 -m m4 ", argv[3]);
    if (*rc == 127 || *rc == -1) die("oracle could not start: python3 -m m4 ", argv[3]);
    if (!out) die("oracle gave no output buffer: python3 -m m4 ", argv[3]);
    if (memchr(out, 0, n)) die("oracle output holds a NUL byte: python3 -m m4 ", argv[3]);
    return out;
}
static char *next_line(char **p) {                      /* destructive line iterator over a NUL-terminated buffer */
    char *s = *p, *e;
    if (!s || !*s) return 0;
    e = strchr(s, '\n');
    if (e) { *e = 0; *p = e + 1; } else *p = s + strlen(s);
    return s;
}
static void collapse(char *s) {                        /* runs of spaces -> one space, trailing spaces dropped */
    char *w = s, *r = s; int sp = 0;
    for (; *r; r++) { if (*r == ' ') { sp = 1; continue; } if (sp && w != s) *w++ = ' '; sp = 0; *w++ = *r; }
    *w = 0;
}

/* ---------- acc ---------- */
static void emit_acc(Buf *b) {
    char *argv[] = { "python3", "-m", "m4", "acc", 0 }, *out, *p, *ln, *f[MAXF]; int rc, nf, k = 0, ln_no = 0;
    out = oracle(argv, &rc); p = out;
    while ((ln = next_line(&p))) {
        ln_no++;
        if (!strncmp(ln, "wired: ", 7)) {
            nf = split(ln, ' ', f);
            if (nf != 4 || strcmp(f[2], "reserved:")) die("m4 acc: unrecognised wired line", 0);
            bs(b, "acc\twired"); bt(b, f[1]); bnl(b); bs(b, "acc\treserved"); bt(b, f[3]); bnl(b);
            continue;
        }
        if (!strncmp(ln, "acc: ", 5)) { bs(b, "acc\tverdict"); bt(b, ln + 5); bnl(b); continue; }
        nf = split(ln, ' ', f);
        if (nf == 3 && netidx(f[0]) == k) {
            char *sl = strchr(f[1], '/');
            if (!sl) die("m4 acc: no exact/total in a net line", 0);
            *sl = 0;
            if (!isnum(f[1]) || !isnum(sl + 1)) die("m4 acc: exact/total not numbers", 0);
            bs(b, "acc\tnet"); bt(b, f[0]); bt(b, f[1]); bt(b, sl + 1); bt(b, f[2]); bnl(b);
            k++; continue;
        }
        { char t[64]; snprintf(t, sizeof t, "m4 acc: unrecognised line %d", ln_no); die(t, 0); }
    }
    if (k != NNETS) die("m4 acc: not every net reported in contract order", 0);
    bs(b, "acc\trc"); bl(b, rc); bnl(b);
    free(out);
}

/* ---------- the program list (m4's order: corpus sorted, then probes sorted) ---------- */
#define MAXP 256
static char *progs[MAXP]; static int nprog, ncorpus;
static int cmpstr(const void *a, const void *b) { return strcmp(*(char *const *)a, *(char *const *)b); }
static int list_dir(const char *dir) {
    DIR *d = opendir(dir); struct dirent *e; int start = nprog, k;
    if (!d) die(dir, ": cannot open directory");
    while ((e = readdir(d))) {
        size_t l = strlen(e->d_name); char path[512]; struct stat st;
        if (l < 5 || strcmp(e->d_name + l - 4, ".ujs")) continue;
        snprintf(path, sizeof path, "%s/%s", dir, e->d_name);
        if (stat(path, &st) != 0 || !S_ISREG(st.st_mode)) continue;
        if (nprog == MAXP) die(dir, ": too many programs");
        if (!(progs[nprog] = malloc(strlen(path) + 1))) die("out of memory", 0);
        strcpy(progs[nprog++], path);
    }
    closedir(d);
    k = nprog - start;
    qsort(progs + start, k, sizeof progs[0], cmpstr);   /* glob.glob + sorted() over byte-order names */
    return k;
}
static void load_progs(void) {
    if (nprog) return;
    ncorpus = list_dir("tests/ujs2wasm/corpus");
    list_dir("m4/probes");
    if (!ncorpus) die("tests/ujs2wasm/corpus: no programs", 0);
}
static int shard_of(int i) { return i * NSHARD / nprog; }   /* contiguous shards 0..NSHARD-1 */
static const char *base(const char *p) { const char *s = strrchr(p, '/'); return s ? s + 1 : p; }
static void file_sha(const char *path, char hex[65], size_t *len) {
    struct stat st; size_t n = 0; char *buf;
    if (stat(path, &st) != 0) die(path, ": cannot stat");
    if (!S_ISREG(st.st_mode)) die(path, ": not a regular file");
    if (!(buf = cx_read(path, &n))) die(path, ": cannot read");
    cx_sha256_hex(buf, n, hex); free(buf);
    if (len) *len = n;
}

/* ---------- a tiny JSON reader for m4 build's {"bytes": N, "trace": {PHASE: {NET: [HITS, GOLD]}}, "wasm": PATH} ---------- */
typedef struct { const char *s; size_t i; } J;
static void jws(J *j) { while (j->s[j->i] == ' ' || j->s[j->i] == '\n' || j->s[j->i] == '\t' || j->s[j->i] == '\r') j->i++; }
static void jexp(J *j, char c) { jws(j); if (j->s[j->i] != c) { char t[48]; snprintf(t, sizeof t, "m4 build: JSON wants '%c' at %ld", c, (long)j->i); die(t, 0); } j->i++; }
static int jpeek(J *j, char c) { jws(j); return j->s[j->i] == c; }
static void jstr(J *j, char *out, size_t cap) {
    size_t k = 0;
    jexp(j, '"');
    while (j->s[j->i] && j->s[j->i] != '"') {
        if (j->s[j->i] == '\\') die("m4 build: escaped JSON string not expected", 0);
        if (k + 1 >= cap) die("m4 build: JSON string too long", 0);
        out[k++] = j->s[j->i++];
    }
    if (j->s[j->i] != '"') die("m4 build: unterminated JSON string", 0);
    j->i++; out[k] = 0;
}
static long jnum(J *j) {
    long v = 0; int any = 0;
    jws(j);
    while (j->s[j->i] >= '0' && j->s[j->i] <= '9') { v = v * 10 + (j->s[j->i++] - '0'); any = 1; }
    if (!any) die("m4 build: JSON number expected", 0);
    return v;
}
static void build_rows(Buf *b, const char *part, const char *prog, const char *json, const char *wasm) {
    J j = { json, 0 }; char key[256], phase[64], net[64], hex[65], src[65]; long bytes = -1; int sawtrace = 0, ntrace = 0;
    Buf tr = { 0, 0, 0 }; size_t wlen = 0;
    jexp(&j, '{');
    for (;;) {
        jstr(&j, key, sizeof key); jexp(&j, ':');
        if (!strcmp(key, "bytes")) bytes = jnum(&j);
        else if (!strcmp(key, "wasm")) jstr(&j, key, sizeof key);
        else if (!strcmp(key, "trace")) {
            sawtrace = 1; jexp(&j, '{');
            if (!jpeek(&j, '}')) for (;;) {
                jstr(&j, phase, sizeof phase); jexp(&j, ':'); jexp(&j, '{');
                if (!jpeek(&j, '}')) for (;;) {
                    long h, g;
                    jstr(&j, net, sizeof net); jexp(&j, ':'); jexp(&j, '[');
                    h = jnum(&j); jexp(&j, ','); g = jnum(&j); jexp(&j, ']');
                    bs(&tr, part); bt(&tr, "trace"); bt(&tr, prog); bt(&tr, phase); bt(&tr, net); bl(&tr, h); bl(&tr, g); bnl(&tr);
                    ntrace++;
                    if (jpeek(&j, ',')) { j.i++; continue; }
                    break;
                }
                jexp(&j, '}');
                if (jpeek(&j, ',')) { j.i++; continue; }
                break;
            }
            jexp(&j, '}');
        } else die("m4 build: unexpected JSON key ", key);
        if (jpeek(&j, ',')) { j.i++; continue; }
        break;
    }
    jexp(&j, '}'); jws(&j);
    if (j.s[j.i]) die("m4 build: trailing text after JSON for ", prog);
    if (bytes < 0 || !sawtrace) die("m4 build: bytes or trace missing for ", prog);
    file_sha(wasm, hex, &wlen);
    if ((long)wlen != bytes) die("m4 build: reported bytes differ from the written file for ", prog);
    file_sha(prog, src, 0);
    bs(b, part); bt(b, "out"); bt(b, prog); bt(b, src); bl(b, bytes); bt(b, hex); bnl(b);
    if (!ntrace) die("m4 build: empty trace for ", prog);
    bs(b, tr.s); free(tr.s);
}
static void emit_out(Buf *b, int shard) {
    char tmpl[512], wasm[600], part[8]; const char *td = getenv("TMPDIR"); int i;
    load_progs();
    snprintf(part, sizeof part, "out%d", shard + 1);
    snprintf(tmpl, sizeof tmpl, "%s/flownetbl.XXXXXX", td && *td ? td : "/tmp");
    if (!mkdtemp(tmpl)) die(tmpl, ": mkdtemp failed");
    snprintf(wasm, sizeof wasm, "%s/m4.wasm", tmpl);
    for (i = 0; i < nprog; i++) {
        char *argv[] = { "python3", "-m", "m4", "build", progs[i], "-o", wasm, 0 }, *out; int rc;
        if (shard_of(i) != shard) continue;
        cx_remove(wasm);
        out = oracle(argv, &rc);
        if (rc != 0) {                                  /* recorded, and red in --check-file */
            char src[65]; file_sha(progs[i], src, 0);
            bs(b, part); bt(b, "refused"); bt(b, progs[i]); bt(b, src); bl(b, rc); bnl(b);
        } else build_rows(b, part, progs[i], out, wasm);
        free(out);
    }
    cx_remove(wasm); cx_remove(tmpl);
}

/* ---------- check ---------- */
static void emit_check(Buf *b) {
    char *argv[] = { "python3", "-m", "m4", "check", 0 }, *out, *p, *ln, *f[MAXF]; int rc, nf, ln_no = 0;
    out = oracle(argv, &rc); p = out;
    while ((ln = next_line(&p))) {
        char t[64];
        ln_no++;
        if (!strncmp(ln, "check: ", 7)) { collapse(ln); bs(b, "check\tsummary"); bt(b, ln + 7); bnl(b); continue; }
        if (!strncmp(ln, "neg gate: ", 10)) { collapse(ln); bs(b, "check\tunexpected"); bt(b, ln + 10); bnl(b); continue; }
        if (!strncmp(ln, "skip ", 5)) {
            collapse(ln); nf = split(ln, ' ', f);
            if (nf >= 2) { char *why = ln + 5 + strlen(f[1]) + 1; bs(b, "check\tskip"); bt(b, f[1]); bt(b, nf > 2 ? why : ""); bnl(b); continue; }
        }
        nf = split(ln, ' ', f);
        if (nf == 4 && !strcmp(f[0], "same") && isnum(f[2]) && !strcmp(f[3], "bytes")) { bs(b, "check\tsame"); bt(b, f[1]); bt(b, f[2]); bnl(b); continue; }
        if (nf == 4 && !strcmp(f[0], "DIFF")) { bs(b, "check\tDIFF"); bt(b, f[1]); bt(b, f[2]); bt(b, f[3]); bnl(b); continue; }
        if (nf == 3 && !strcmp(f[0], "reject")) { bs(b, "check\treject"); bt(b, f[1]); bt(b, f[2]); bnl(b); continue; }
        if (nf == 3 && !strcmp(f[0], "ACCEPT")) { bs(b, "check\taccept"); bt(b, f[1]); bt(b, f[2]); bnl(b); continue; }
        snprintf(t, sizeof t, "m4 check: unrecognised line %d", ln_no); die(t, 0);
    }
    bs(b, "check\trc"); bl(b, rc); bnl(b);
    free(out);
}

/* ---------- selftest ---------- */
static void emit_selftest(Buf *b) {
    char *argv[] = { "python3", "-m", "m4", "selftest", 0 }, *out, *p, *ln, *f[MAXF]; int rc, nf, k = 0, ln_no = 0;
    out = oracle(argv, &rc); p = out;
    while ((ln = next_line(&p))) {
        char t[64];
        ln_no++; collapse(ln);
        if (!strncmp(ln, "isel choose ", 12)) { bs(b, "selftest\tchoose"); bt(b, ln + 12); bnl(b); continue; }
        if (!strncmp(ln, "selftest: ", 10)) { bs(b, "selftest\tverdict"); bt(b, ln + 10); bnl(b); continue; }
        {
            char tail[256]; snprintf(tail, sizeof tail, "%s", ln);
            nf = split(ln, ' ', f);
            if (nf >= 4 && netidx(f[0]) == k && !strcmp(f[1], "decides")) {
                const char *rest = tail + strlen(f[0]) + 1 + strlen(f[1]) + 1 + strlen(f[2]) + 1;
                bs(b, "selftest\tdecides"); bt(b, f[0]); bt(b, f[2]); bt(b, rest); bnl(b);
                k++; continue;
            }
        }
        snprintf(t, sizeof t, "m4 selftest: unrecognised line %d", ln_no); die(t, 0);
    }
    if (k != NNETS) die("m4 selftest: not every net reported in contract order", 0);
    bs(b, "selftest\trc"); bl(b, rc); bnl(b);
    free(out);
}

/* ---------- expect: EXPECT = { "NET": {"k", ...} | set(), ... } in m4/selftest.py, any order; rows in contract order ---------- */
static void emit_expect(Buf *b) {
    const char *path = "m4/selftest.py"; size_t n = 0; char *src = cx_read(path, &n), *p, *ln, got[NNETS][16]; int in = 0, k = 0, ln_no = 0, done = 0, seen[NNETS], j;
    for (j = 0; j < NNETS; j++) seen[j] = 0;
    if (!src) die(path, ": cannot read");
    p = src;
    while ((ln = next_line(&p)) && !done) {
        char t[600], *q, *e; int nk = 0, hasshift = 0, hastrap = 0, ni;
        ln_no++;
        if (!in) { if (!strcmp(ln, "EXPECT = {")) in = 1; continue; }
        if (!strcmp(ln, "}")) { done = 1; break; }
        snprintf(t, sizeof t, "%s:%d: ", path, ln_no);
        q = ln; while (*q == ' ') q++;
        if (*q != '"') die(t, "EXPECT row not \"NET\": {...}");
        e = strchr(q + 1, '"'); if (!e) die(t, "EXPECT row: unterminated net name");
        *e = 0;
        if ((ni = netidx(q + 1)) < 0) die(t, "EXPECT row: not one of the ten nets");
        if (seen[ni]++) die(t, "EXPECT row: net listed twice");
        q = e + 1;
        if (strncmp(q, ": ", 2)) die(t, "EXPECT row: no ': '");
        q += 2;
        if (!strcmp(q, "set(),")) nk = 0;
        else if (*q == '{') {
            q++;
            for (;;) {
                if (*q != '"') die(t, "EXPECT kinds: want a quoted kind");
                if (!strncmp(q, "\"shift\"", 7)) { hasshift++; q += 7; }
                else if (!strncmp(q, "\"trap\"", 6)) { hastrap++; q += 6; }
                else die(t, "EXPECT kinds: unknown kind (shift and trap are measured)");
                nk++;
                if (!strncmp(q, ", ", 2)) { q += 2; continue; }
                if (!strcmp(q, "},")) break;
                die(t, "EXPECT kinds: want ', ' or '},'");
            }
            if (hasshift > 1 || hastrap > 1) die(t, "EXPECT kinds: repeated kind");
        } else die(t, "EXPECT row: want set() or {...}");
        /* selftest prints sorted kinds joined by '/', or "nothing" */
        if (!nk) strcpy(got[ni], "nothing");
        else snprintf(got[ni], 16, "%s%s%s", hasshift ? "shift" : "", hasshift && hastrap ? "/" : "", hastrap ? "trap" : "");
        k++;
    }
    if (!in) die(path, ": no 'EXPECT = {' line");
    if (!done || k != NNETS) die(path, ": EXPECT does not list the ten nets and close with '}'");
    for (j = 0; j < NNETS; j++) { bs(b, "expect"); bt(b, NETS[j]); bt(b, got[j]); bnl(b); }   /* contract order */
    free(src);
}

static void emit(int part, Buf *b) {
    if (part == 0) emit_acc(b);
    else if (part <= NSHARD) emit_out(b, part - 1);
    else if (part == 5) emit_check(b);
    else if (part == 6) emit_selftest(b);
    else emit_expect(b);
}

/* ---------- the recorded file ---------- */
static const char *HEADER =
    "# flownet W1 baseline: the m4 flow x net behaviour (plans/m4-flownet-cx-module.md §4 W1). Generated; do not hand-edit.\n"
    "# Re-record one section: sh ./unisacc.com -run tests/flownetbaseline.cx -- --write PART   (PART: acc out1 out2 out3 out4 check selftest expect)\n"
    "# Check: --check PART recomputes PART through the m4 oracle; --check-file checks the whole file without Python.\n"
    "# Rows: SECTION<TAB>KIND<TAB>fields.  out: PROGRAM SRC_SHA256 BYTES OUT_SHA256; trace: PROGRAM PHASE NET HITS GOLD_FALLBACKS.\n";

static Buf sect[NPARTS]; static int have[NPARTS];
static char *tsv_text; static size_t tsv_len;
static void load_tsv(int must) {
    struct stat st; char *p, *ln; int ln_no = 0, last = -1;
    if (stat(TSV, &st) != 0) { if (must) die(TSV, ": cannot stat (missing?)"); return; }
    if (!S_ISREG(st.st_mode)) die(TSV, ": not a regular file");
    if (!(tsv_text = cx_read(TSV, &tsv_len))) die(TSV, ": cannot read");
    if (memchr(tsv_text, 0, tsv_len)) die(TSV, ": NUL byte");
    if (tsv_len && tsv_text[tsv_len - 1] != '\n') die(TSV, ": no final newline");
    {
        char *copy = malloc(tsv_len + 1); if (!copy) die("out of memory", 0);
        memcpy(copy, tsv_text, tsv_len + 1); p = copy;
        while ((ln = next_line(&p))) {
            char t[600], *tab; int k;
            ln_no++;
            snprintf(t, sizeof t, "%s:%d: ", TSV, ln_no);
            if (ln[0] == '#') { if (last >= 0) die(t, "comment after the first row"); continue; }
            tab = strchr(ln, '\t'); if (!tab) die(t, "no tab");
            *tab = 0; k = partidx(ln); *tab = '\t';
            if (k < 0) die(t, "unknown section");
            if (k < last) die(t, "section out of order");
            if (k != last && have[k]) die(t, "section split");
            have[k] = 1; last = k;
            bs(&sect[k], ln); bnl(&sect[k]);
        }
        free(copy);
    }
}
static void first_diff(const char *want, const char *got, const char *part) {
    int ln = 1; const char *a = want, *b = got;
    while (*a && *b) {
        const char *ea = strchr(a, '\n'), *eb = strchr(b, '\n');
        size_t la = ea ? (size_t)(ea - a) : strlen(a), lb = eb ? (size_t)(eb - b) : strlen(b);
        if (la != lb || memcmp(a, b, la)) break;
        a += la + (ea ? 1 : 0); b += lb + (eb ? 1 : 0); ln++;
    }
    fprintf(stderr, "flownet-baseline: %s: section %s row %d differs\n  recorded: %.*s\n  measured: %.*s\n", TSV, part, ln,
            (int)strcspn(a, "\n"), *a ? a : "(end)", (int)strcspn(b, "\n"), *b ? b : "(end)");
}
static int count_rows(const char *s) { int n = 0; for (; *s; s++) n += *s == '\n'; return n; }

static int do_check(int part) {
    Buf now = { 0, 0, 0 };
    load_tsv(1);
    if (!have[part]) die(TSV, ": section missing (re-record with --write)");
    emit(part, &now);
    if (!now.s || strcmp(now.s, sect[part].s)) { first_diff(sect[part].s, now.s ? now.s : "", PARTS[part]); return 1; }
    printf("flownet-baseline %s: %d rows, recorded == measured\n", PARTS[part], count_rows(now.s));
    return 0;
}
static int do_write(int part) {
    Buf out = { 0, 0, 0 }, now = { 0, 0, 0 }; int k;
    load_tsv(0);
    emit(part, &now);
    free(sect[part].s); sect[part] = now; have[part] = 1;
    bs(&out, HEADER);
    for (k = 0; k < NPARTS; k++) if (have[k]) bs(&out, sect[k].s);
    if (cx_write(TSV, out.s, out.n) != 0) die(TSV, ": cannot write");
    printf("flownet-baseline %s: %d rows written to %s\n", PARTS[part], count_rows(now.s), TSV);
    return 0;
}

/* ---------- --check-file: the whole recorded baseline, no Python ---------- */
static int fails;
static void need(int ok, const char *what) { if (!ok) { fprintf(stderr, "flownet-baseline: %s: %s\n", TSV, what); fails++; } }
#define PROGLEN 512
typedef struct { char prog[PROGLEN]; long bytes; int ntrace; } Out;
static Out outs[MAXP]; static int nouts;
static int rows(int part, char **lines, int max) {         /* split a section into its lines (in place on a copy) */
    char *c = malloc(sect[part].n + 1), *p, *ln; int n = 0;
    if (!c) die("out of memory", 0);
    memcpy(c, sect[part].s, sect[part].n + 1); p = c;
    while ((ln = next_line(&p))) { if (n == max) die(TSV, ": section too long"); lines[n++] = ln; }
    return n;
}
static int do_check_file(void) {
    static char *L[8192]; char *f[MAXF], expect_kinds[NNETS][32], why[600]; int k, n, i, nf, nacc = 0, ndec = 0, ngold = 0, ntr = 0;
    long keys = 0; int same = 0, nneg = 0, ok_verdict;
    load_tsv(1);
    if (strncmp(tsv_text, HEADER, strlen(HEADER))) need(0, "header differs from the generator's");
    for (k = 0; k < NPARTS; k++) if (!have[k]) { snprintf(why, sizeof why, "section %s missing", PARTS[k]); need(0, why); }
    if (fails) return 1;
    /* expect: recomputed from m4/selftest.py now */
    { Buf now = { 0, 0, 0 }; emit_expect(&now); if (strcmp(now.s, sect[7].s)) { first_diff(sect[7].s, now.s, "expect"); fails++; } free(now.s); }
    n = rows(7, L, 8192);
    for (i = 0; i < n; i++) { nf = split(L[i], '\t', f); need(nf == 3 && netidx(f[1]) == i, "expect row malformed"); if (nf == 3 && i < NNETS) snprintf(expect_kinds[i], 32, "%s", f[2]); }
    need(n == NNETS, "expect: not ten nets");
    /* acc */
    n = rows(0, L, 8192); ok_verdict = 0;
    for (i = 0; i < n; i++) {
        nf = split(L[i], '\t', f);
        if (nf == 6 && !strcmp(f[1], "net")) {
            need(netidx(f[2]) == nacc, "acc: net rows not in contract order");
            need(isnum(f[3]) && isnum(f[4]) && !strcmp(f[3], f[4]) && atol(f[4]) > 0 && !strcmp(f[5], "ok"), "acc: a net is not exact on every key");
            keys += atol(f[4]); nacc++;
        } else if (nf == 3 && !strcmp(f[1], "verdict")) ok_verdict = !strcmp(f[2], "PASS");
        else if (nf == 3 && !strcmp(f[1], "rc")) need(!strcmp(f[2], "0"), "acc: oracle rc != 0");
        else if (nf == 3 && (!strcmp(f[1], "wired") || !strcmp(f[1], "reserved"))) ;
        else need(0, "acc: unknown row");
    }
    need(nacc == NNETS, "acc: not ten nets"); need(ok_verdict, "acc: verdict is not PASS");
    /* out1..4 against the programs on disk now */
    load_progs();
    for (k = 1; k <= NSHARD; k++) {
        n = rows(k, L, 8192);
        for (i = 0; i < n; i++) {
            nf = split(L[i], '\t', f);
            if (nf == 6 && !strcmp(f[1], "out")) {
                char hex[65]; int idx = nouts;
                need(idx < nprog && !strcmp(f[2], progs[idx]), "out: programs differ from tests/ujs2wasm/corpus + m4/probes on disk (re-record)");
                need(idx < nprog && shard_of(idx) == k - 1, "out: program in the wrong shard");
                need(ishex64(f[3]) && isnum(f[4]) && ishex64(f[5]), "out: malformed sha/bytes");
                if (idx < nprog && !strcmp(f[2], progs[idx])) {
                    file_sha(progs[idx], hex, 0);
                    if (strcmp(hex, f[3])) { snprintf(why, sizeof why, "out: %s changed since it was recorded (source sha256)", f[2]); need(0, why); }
                }
                if (nouts < MAXP) { snprintf(outs[nouts].prog, PROGLEN, "%s", f[2]); outs[nouts].bytes = atol(f[4]); outs[nouts].ntrace = 0; nouts++; }
            } else if (nf == 7 && !strcmp(f[1], "trace")) {
                need(nouts > 0 && !strcmp(f[2], outs[nouts - 1].prog), "trace: row not under its program");
                need(netidx(f[4]) >= 0, "trace: unknown net");
                need(isnum(f[5]) && isnum(f[6]), "trace: hits/gold not numbers");
                if (strcmp(f[6], "0")) { snprintf(why, sizeof why, "trace: %s net %s fell back to gold %s time(s)", f[2], f[4], f[6]); need(0, why); ngold++; }
                if (nouts > 0) outs[nouts - 1].ntrace++;
                ntr++;
            } else if (nf == 5 && !strcmp(f[1], "refused")) { snprintf(why, sizeof why, "out: m4 build refused %s (rc %s)", f[2], f[4]); need(0, why); }
            else need(0, "out: unknown row");
        }
    }
    need(nouts == nprog, "out: not every program on disk is recorded");
    for (i = 0; i < nouts; i++) if (!outs[i].ntrace) need(0, "out: a program has no trace rows");
    /* check: every program same, with the same byte count as out; nothing DIFF or skipped */
    n = rows(5, L, 8192);
    for (i = 0; i < n; i++) {
        nf = split(L[i], '\t', f);
        if (nf == 4 && !strcmp(f[1], "same")) {
            int found = 0, j;
            for (j = 0; j < nouts; j++) if (!strcmp(base(outs[j].prog), f[2])) { found = 1; need(outs[j].bytes == atol(f[3]), "check: same-row bytes differ from out"); }
            need(found, "check: same row for a program not in out");
            same++;
        } else if (nf == 4 && (!strcmp(f[1], "reject") || !strcmp(f[1], "accept"))) nneg++;
        else if (nf == 3 && !strcmp(f[1], "rc")) need(!strcmp(f[2], "0"), "check: oracle rc != 0");
        else if (nf == 3 && !strcmp(f[1], "summary")) need(strstr(f[2], " differ 0 skipped 0 ") != 0, "check: summary is not differ 0 skipped 0");
        else { snprintf(why, sizeof why, "check: row kind %s (DIFF/skip/unexpected) in the baseline", nf > 1 ? f[1] : "?"); need(0, why); }
    }
    need(same == nouts, "check: same count != programs recorded");
    /* selftest: PASS, choose proven, decides == expect for every net */
    n = rows(6, L, 8192); ok_verdict = 0;
    for (i = 0; i < n; i++) {
        nf = split(L[i], '\t', f);
        if (nf == 5 && !strcmp(f[1], "decides")) {
            int j = netidx(f[2]);
            need(j == ndec, "selftest: decides rows not in contract order");
            need(j >= 0 && !strcmp(f[3], expect_kinds[j]) && !strcmp(f[4], "as expected"), "selftest: measured decision kinds differ from EXPECT");
            ndec++;
        } else if (nf == 3 && !strcmp(f[1], "choose")) need(strncmp(f[2], "FAIL", 4) != 0, "selftest: isel choose proof failed");
        else if (nf == 3 && !strcmp(f[1], "verdict")) ok_verdict = !strcmp(f[2], "PASS");
        else if (nf == 3 && !strcmp(f[1], "rc")) need(!strcmp(f[2], "0"), "selftest: oracle rc != 0");
        else need(0, "selftest: unknown row");
    }
    need(ndec == NNETS, "selftest: not ten nets"); need(ok_verdict, "selftest: verdict is not PASS");
    if (fails) { printf("flownet-baseline file: RED (%d problem(s))\n", fails); return 1; }
    printf("flownet-baseline file: ok -- acc %d/%d nets exact (%ld keys); %d corpus + %d probe outputs, %d trace rows, gold fallbacks %d; "
           "check same %d/%d, neg %d; selftest PASS, decides == EXPECT for %d nets\n",
           nacc, NNETS, keys, ncorpus, nprog - ncorpus, ntr, ngold, same, nouts, nneg, ndec);
    return 0;
}

static void usage(void) {
    fprintf(stderr, "usage: flownetbaseline.cx --check PART|--write PART|--emit PART [ROOT] | --check-file [ROOT]\n"
                    "  PART: acc out1 out2 out3 out4 check selftest expect\n");
    exit(2);
}
int main(int argc, char **argv) {
    const char *root = "."; int part = -1;
    if (argc < 2) usage();
    if (!strcmp(argv[1], "--check-file")) { if (argc > 3) usage(); if (argc == 3) root = argv[2]; }
    else if (!strcmp(argv[1], "--check") || !strcmp(argv[1], "--write") || !strcmp(argv[1], "--emit")) {
        if (argc < 3 || argc > 4) usage();
        if ((part = partidx(argv[2])) < 0) die("unknown PART ", argv[2]);
        if (argc == 4) root = argv[3];
    } else usage();
    if (chdir(root) != 0) die(root, ": cannot chdir");
    if (part < 0) return do_check_file();
    if (!strcmp(argv[1], "--check")) return do_check(part);
    if (!strcmp(argv[1], "--write")) return do_write(part);
    { Buf now = { 0, 0, 0 }; emit(part, &now); fwrite(now.s ? now.s : "", 1, now.n, stdout); return 0; }
}
