/* p2a.cx -- CX2a positive P2: a diamond.  p2a uses p2b and p2c, both use p2d; p2d is one unit, compiled once.
   p2b's exported signature names p2d's type, so p2a sees p2d's type part (not its functions). */
#pragma unisa use p2b
#pragma unisa use p2c

int main(void) {
    p2_cell c = p2b_cell(20);
    int total = p2b_get(&c) + p2c_twice(1);
    if (total != 22 + 2 * 11) { printf("FAIL diamond %d\n", total); return 1; }
    printf("diamond ok (4 units, d once: %d)\n", p2c_count());
    return 0;
}
