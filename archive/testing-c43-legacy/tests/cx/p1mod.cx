/* p1mod.cx -- the module p1.cx uses (CX2a).  Its interface is derived, not written: every typedef and
   struct/enum definition, and the prototype of every non-static function definition.  Statics stay private (tab
   is also a static in p1.cx); there is no exported object and no macro in an exported declaration. */
#pragma unisa module p1mod

typedef struct { int a, b; } p1_pair;
enum p1_colour { P1_RED, P1_GREEN, P1_BLUE };
struct p1_box { int n; };

static const int tab[6] = { 3, 1, 4, 1, 5, 9 };
static const int radix[2] = { 2, 3 };
#define P1_LOCAL 2                                /* a module macro: fine while no exported item names it */

int p1_radix(int i) { return i == 0 || i == 1 ? radix[i] : -1; }

int p1_lookup(int a, int b) {
    if (a < 0 || a >= radix[0] || b < 0 || b >= radix[1]) return -1;
    return tab[a * radix[1] + b];
}
p1_pair p1_pair_make(int a, int b) { p1_pair p; p.a = a; p.b = b; return p; }
int p1_pair_sum(const p1_pair *p) { return p->a + p->b; }
const char *p1_colour_name(enum p1_colour c) { return c == P1_RED ? "red" : c == P1_GREEN ? "green" : "blue"; }
int p1_box_twice(struct p1_box *b) { return b->n * P1_LOCAL; }
