#!/usr/bin/env unisacc.com
#include <sys/file.h>
/* Prepared Windows lowering materials only; no cached verdict. Fixed frozen
 * host/environment identity. Every consumer rechecks all seals and sources.
 * prepare tools | prepare json|tbl x86_64|arm64 | check x86_64|arm64 [--part cases|refusals|refusals-1|refusals-2|large]
 * Children restore the formal caller's UNISA_CONTAINER=unset contract. Other
 * environment bytes are pinned; PWD/OLDPWD/SHLVL/_ are shell bookkeeping.
 * The inherited bound deadline is execution control, excluded only from key. */
static char ROOT[4096],D[4096],T[4096],KEY[65],UA[4096],CC[4096],PY[4096];
static int LOCKFD=-1,PREPARE;extern char **environ;
typedef struct{char*s;size_t n,cap;} Buf;
static void die(const char*s,int rc){fprintf(stderr,"winlowerphase: %s\n",s);exit(rc);}
static void add(Buf*b,const char*s,size_t n){if(b->n+n+1>b->cap){size_t c=(b->n+n+1)*2;char*p=realloc(b->s,c);if(!p)die("allocation",2);b->s=p;b->cap=c;}memcpy(b->s+b->n,s,n);b->n+=n;b->s[b->n]=0;}
static void str(Buf*b,const char*s){add(b,s,strlen(s));}
static void fdput(int f,const char*s,size_t n){while(n){ssize_t k=write(f,s,n);if(k>0){s+=k;n-=k;}else if(k<0&&errno==EINTR)continue;else die("write",2);}}
static void path(char*out,const char*dir,const char*name){if(snprintf(out,4096,"%s/%s",dir,name)>=4096)die("path extent",2);}
static int regular(const char*p,int executable){struct stat st;if(lstat(p,&st)){if(errno==ENOENT)return 0;die("artifact inspection",2);}return S_ISREG(st.st_mode)&&st.st_size>0&&(!executable||(st.st_mode&0111));}
static int run(char**command,Buf*capture);
static void digest_output(const char*p,const Buf*out,char h[65]){size_t i,n=strlen(p);if(out->n!=67+n||!out->s||out->s[64]!=' '||out->s[65]!=' '||memcmp(out->s+66,p,n)||out->s[66+n]!='\n')die("large digest output format",2);for(i=0;i<64;i++)if(!((out->s[i]>='0'&&out->s[i]<='9')||(out->s[i]>='a'&&out->s[i]<='f')))die("large digest hex",2);memcpy(h,out->s,64);h[64]=0;}
/* Every call reads content. The external branch avoids the O0 carried SHA
   cost on large executables/models; its bounded command and full record are
   checked, and the resulting bytes keep the existing key/seal format. */
static void digest(const char*p,char h[65]){struct stat st;size_t n;char*s;if(stat(p,&st)||!S_ISREG(st.st_mode))die("input inspection",2);if(st.st_size>=8388608){Buf out={0};char*a[]={"sha256sum","--",(char*)p,0};int rc=run(a,&out);if(rc){fprintf(stderr,"winlowerphase: large digest command rc=%d\n",rc);free(out.s);exit(rc);}digest_output(p,&out,h);free(out.s);return;}s=cx_read(p,&n);if(!s)die("input read",2);cx_sha256_hex(s,n,h);free(s);}
static void cleanup(void){char p[4096],why[512];if(*T){if(unisa_safedel(T,SAFEDEL_PURGE|SAFEDEL_RECURSIVE,200000,why,sizeof why))fprintf(stderr,"winlowerphase cleanup: %s\n",why);*T=0;}if(LOCKFD>=0){if(close(LOCKFD))fprintf(stderr,"winlowerphase cleanup lock close failure\n");LOCKFD=-1;}}
static int run(char**command,Buf*capture){char**a;int i=0,j,fds[2],st,overflow=0;size_t bytes=64,nc=0,len;pid_t p,w;char b[8192];ssize_t n;while(command[nc]){if(nc==4099)die("argv count",2);len=strlen(command[nc])+1;if(len>65536-bytes)die("argv extent",2);bytes+=len;nc++;}a=malloc((nc+6)*sizeof(char*));if(!a)die("argv allocation",2);a[i++]="tests/bound";a[i++]="40";a[i++]="env";a[i++]="-u";a[i++]="UNISA_CONTAINER";for(j=0;command[j];j++)a[i++]=command[j];a[i]=0;if(capture&&pipe(fds))die("pipe",2);p=fork();if(p<0)die("fork",2);if(!p){if(capture){close(fds[0]);if(dup2(fds[1],1)<0)_exit(126);close(fds[1]);}execvp(a[0],a);_exit(127);}free(a);if(capture){close(fds[1]);while((n=read(fds[0],b,sizeof b))){if(n>0){if((size_t)n>1048576-capture->n)overflow=1;else if(!overflow)add(capture,b,n);}else if(errno!=EINTR)die("capture",2);}close(fds[0]);}do{w=waitpid(p,&st,0);}while(w<0&&errno==EINTR);if(w!=p)die("waitpid",2);if(overflow&&WIFEXITED(st)&&!WEXITSTATUS(st))die("capture extent",2);return WIFEXITED(st)?WEXITSTATUS(st):WIFSIGNALED(st)?128+WTERMSIG(st):255;}

/* One native read per listed input, every key() call. NUL output avoids
 * sha256sum filename escaping, including spaces, backslashes and newlines.
 * Preserve the original path-NUL + hex-NUL key stream and its ordering. */
static void digest_many(Buf*b,char**files,int count){Buf out={0};char**a,h[65];struct stat st;size_t at=0,n,j;int i,rc;if(count<=0||count>4096)die("digest input count",2);a=malloc((count+4)*sizeof(char*));if(!a)die("digest argv allocation",2);a[0]="sha256sum";a[1]="-z";a[2]="--";for(i=0;i<count;i++){if(!*files[i]||stat(files[i],&st)||!S_ISREG(st.st_mode))die("digest input inspection",2);a[i+3]=files[i];}a[count+3]=0;rc=run(a,&out);free(a);if(rc){fprintf(stderr,"winlowerphase: batch digest command rc=%d\n",rc);free(out.s);exit(rc);}for(i=0;i<count;i++){n=strlen(files[i]);if(at>out.n||out.n-at<67||n>out.n-at-67)die("batch digest truncated",2);for(j=0;j<64;j++)if(!((out.s[at+j]>='0'&&out.s[at+j]<='9')||(out.s[at+j]>='a'&&out.s[at+j]<='f')))die("batch digest hex",2);if(out.s[at+64]!=' '||out.s[at+65]!=' '||memcmp(out.s+at+66,files[i],n)||out.s[at+66+n])die("batch digest path/order",2);memcpy(h,out.s+at,64);h[64]=0;add(b,files[i],n+1);add(b,h,65);at+=67+n;}if(at!=out.n)die("batch digest extra output",2);free(out.s);}
static void must(char**a)
{int rc=run(a,0);if(rc)exit(rc);}
static int cmpstr(const void*a,const void*b){return strcmp(*(char*const*)a,*(char*const*)b);}
static void resolve(const char*name,char out[4096]){const char*env=getenv("PATH");char*p,*q,*at,candidate[4096];if(strchr(name,'/')){if(!realpath(name,out))die("executable path",PREPARE?2:75);return;}if(!env)die("PATH absent",2);p=malloc(strlen(env)+1);if(!p)die("allocation",2);strcpy(p,env);at=p;for(;;){q=strchr(at,':');if(q)*q=0;if(snprintf(candidate,sizeof candidate,"%s/%s",*at?at:".",name)>=(int)sizeof candidate)die("PATH extent",2);if(!access(candidate,X_OK)){if(!realpath(candidate,out))die("tool realpath",2);free(p);return;}if(errno!=ENOENT&&errno!=EACCES)die("tool inspection",2);if(!q)break;at=q+1;}free(p);die("tool absent",2);}
static int source_ext(const char*p){const char*s=strrchr(p,'.');return s&&(!strcmp(s,".tsv")||!strcmp(s,".py")||!strcmp(s,".c")||!strcmp(s,".h")||!strcmp(s,".sh")||!strcmp(s,".inc")||!strcmp(s,".json"));}
static void key(char out[65]){Buf b={0},list={0},v={0};char h[65],*p,*end;int i,count=0,total;char**files;const char*envs[]={"PATH","PYTHONPATH","PYTHONHOME","PYTHONNOUSERSITE","PYTHONHASHSEED","CPATH","C_INCLUDE_PATH","CPLUS_INCLUDE_PATH","OBJC_INCLUDE_PATH","GCC_EXEC_PREFIX","COMPILER_PATH","LIBRARY_PATH","LD_PRELOAD","LD_LIBRARY_PATH","GCC_SPECS","CFLAGS","CPPFLAGS","LDFLAGS","UA","UA_RUN","UNISA_JOBS","TMPDIR","LANG","LC_ALL",0};char*ls[]={"rg","--files","-0","exec","unisa","seed","include","weights",0};char*cv[]={CC,"--version",0},*pv[]={"sh","./exec/lower/wincheck.sh","--interpreter-info",0},*host[]={"uname","-sm",0};const char*extra[]={"tests/winlowerphase.cx","tests/enc/tins.py","tests/bound.py","exec/lower/wincheck.sh","tests/lib.sh","tests/cxbin","tests/safedel.cx","tests/bound","tests/bound.c","tests/build_ref.sh","tests/export_ref.sh","tests/refshim.h","tests/reffoot.h","examples/hello.c","examples/fib.c","unisacc.c",".gitignore",0};
 if(run(ls,&list))die("BASE file inventory",2);if(!list.s||!list.n)die("empty source inventory",2);for(p=list.s,end=list.s+list.n;p&&p<end;){char*z=memchr(p,0,end-p);if(!z||z==p)die("inventory NUL record",2);if(source_ext(p)){if(count==4096)die("inventory count",2);count++;}p=z+1;}if(!count)die("empty source inventory",2);files=malloc(4096*sizeof(char*));if(!files)die("allocation",2);for(p=list.s,i=0;p<end;p+=strlen(p)+1)if(source_ext(p))files[i++]=p;qsort(files,count,sizeof(char*),cmpstr);for(i=1;i<count;i++)if(!strcmp(files[i-1],files[i]))die("duplicate source inventory",2);total=count;for(i=0;extra[i];i++){if(total>=4093)die("digest input count",2);files[total++]=(char*)extra[i];}if(total>4093)die("digest input count",2);files[total++]=UA;files[total++]=CC;files[total++]=PY;str(&b,"winlower-materials-v1\ncontainer=unset\n");add(&b,ROOT,strlen(ROOT)+1);digest_many(&b,files,total);
if(run(cv,&v))die("cc identity",2);add(&b,v.s,v.n);free(v.s);memset(&v,0,sizeof v);if(run(pv,&v))die("interpreter identity",2);add(&b,v.s,v.n);free(v.s);memset(&v,0,sizeof v);if(run(host,&v))die("host identity",2);add(&b,v.s,v.n);free(v.s);{const char*opt[]={"tests/__init__.py","tests/enc/__init__.py",0};struct stat os;for(i=0;opt[i];i++){add(&b,opt[i],strlen(opt[i])+1);if(stat(opt[i],&os)){if(errno!=ENOENT)die("optional import inspection",2);str(&b,"absent\n");}else{if(!S_ISREG(os.st_mode))die("optional import type",2);digest(opt[i],h);add(&b,h,65);}}}for(i=0;envs[i];i++){const char*x=getenv(envs[i]);add(&b,envs[i],strlen(envs[i])+1);if(x){str(&b,"set:");add(&b,x,strlen(x)+1);}else str(&b,"unset\n");}{int en=0,j=0;char**ev;for(i=0;environ[i];i++)en++;ev=malloc((en+1)*sizeof(char*));if(!ev)die("environment allocation",2);for(i=0;i<en;i++){const char*x=environ[i];if(!strncmp(x,"UNISACC_BOUND_DEADLINE_MONO=",28)||!strncmp(x,"UNISA_CONTAINER=",16)||!strncmp(x,"SHLVL=",6)||!strncmp(x,"PWD=",4)||!strncmp(x,"OLDPWD=",7)||!strncmp(x,"_=",2))continue;ev[j++]=environ[i];}qsort(ev,j,sizeof(char*),cmpstr);for(i=0;i<j;i++)add(&b,ev[i],strlen(ev[i])+1);free(ev);}cx_sha256_hex(b.s,b.n,out);free(files);free(list.s);free(b.s);}
static const char*artifacts(const char*phase,int i){static const char*tools[]={"run","hello","fib",0};if(!strcmp(phase,"tools"))return i<3?tools[i]:0;if(i)return 0;if(!strcmp(phase,"x86_64-json"))return "x86_64.json";if(!strcmp(phase,"arm64-json"))return "arm64.json";if(!strcmp(phase,"x86_64-tbl"))return "x86_64.tbl";if(!strcmp(phase,"arm64-tbl"))return "arm64.tbl";die("unknown phase",2);return 0;}
static const char*pred(const char*phase){if(!strcmp(phase,"tools"))return 0;if(!strcmp(phase,"x86_64-json")||!strcmp(phase,"arm64-json"))return "tools";if(!strcmp(phase,"x86_64-tbl"))return "x86_64-json";if(!strcmp(phase,"arm64-tbl"))return "arm64-json";die("unknown phase",2);return 0;}
static void manifest(const char*phase,const char*dir,Buf*b){char p[4096],h[65],line[4300],seal[128];const char*parent=pred(phase),*name;int i;str(b,"winlower-seal-v1\n");str(b,phase);str(b,"\n");str(b,KEY);str(b,"\n");if(parent){snprintf(seal,sizeof seal,"%s.seal",parent);path(p,D,seal);digest(p,h);snprintf(line,sizeof line,"parent\t%s\t%s\n",seal,h);str(b,line);}for(i=0;(name=artifacts(phase,i));i++){path(p,dir,name);if(!regular(p,!strcmp(name,"run")))die("new artifact invalid",2);digest(p,h);snprintf(line,sizeof line,"artifact\t%s\t%s\n",name,h);str(b,line);}}
static int valid(const char*phase){char p[4096],seal[128];const char*parent=pred(phase),*name;Buf b={0};size_t n;char*s;int i,ok;if(parent&&!valid(parent))return 0;snprintf(seal,sizeof seal,"%s.seal",phase);path(p,D,seal);if(!regular(p,0))return 0;for(i=0;(name=artifacts(phase,i));i++){path(p,D,name);if(!regular(p,!strcmp(name,"run")))return 0;}manifest(phase,D,&b);path(p,D,seal);s=cx_read(p,&n);if(!s)die("seal read",2);ok=n==b.n&&!memcmp(s,b.s,n);free(s);free(b.s);return ok;}
static void need(const char*phase){if(!valid(phase)){fprintf(stderr,"winlowerphase: NEED_PREPARE %s (cold/stale/corrupt)\n",phase);exit(75);}}
static void syncfile(const char*p){int f=open(p,O_RDONLY|O_NOFOLLOW|O_CLOEXEC);if(f<0||fsync(f)||close(f))die("artifact fsync",2);}
static void publish(const char*phase){const char*name;char a[4096],b[4096],h[65],seal[128];Buf m={0};int i,f;key(h);if(strcmp(h,KEY))die("preparation inputs changed",2);if(pred(phase))need(pred(phase));for(i=0;(name=artifacts(phase,i));i++){path(a,T,name);if(!regular(a,!strcmp(name,"run")))die("producer output invalid",2);syncfile(a);}for(i=0;(name=artifacts(phase,i));i++){path(a,T,name);path(b,D,name);if(rename(a,b))die("artifact publish",2);}manifest(phase,D,&m);snprintf(seal,sizeof seal,"%s.seal",phase);path(a,T,seal);f=open(a,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW,0600);if(f<0)die("seal create",2);fdput(f,m.s,m.n);if(fsync(f)||close(f))die("seal fsync",2);path(b,D,seal);if(rename(a,b))die("seal publish",2);f=open(D,O_RDONLY|O_DIRECTORY);if(f<0||fsync(f)||close(f))die("cache directory fsync",2);free(m.s);need(phase);}
/* The lock inode is permanent: never unlink/rename it while this protocol is live.
 * Readers do not create it; writers create it before publication. Deliberately
 * inherited across fork/exec, so live owned children retain protection if the
 * wrapper is killed. close(), not LOCK_UN, releases only this process's reference.
 * Outer bound still owns/reaps the full subtree; no waiting or budget extension. */
/* flock is host-libc; image errno is separate from libc's thread-local errno. */
static int lock_host_errno(void){
#ifdef __APPLE__
 extern int*__error(void);return *__error();
#else
 extern int*__errno_location(void);return *__errno_location();
#endif
}
static void take_lock(void){char p[4096];struct stat st;path(p,D,"lock");LOCKFD=open(p,(PREPARE?O_RDWR|O_CREAT:O_RDONLY)|O_NOFOLLOW|O_NONBLOCK,0600);if(LOCKFD<0){if(!PREPARE&&errno==ENOENT)die("NEED_PREPARE cache lock absent",75);die("lock open (legacy directory is not a live file lock)",2);}if(fstat(LOCKFD,&st)||!S_ISREG(st.st_mode)||st.st_uid!=geteuid()||(st.st_mode&0022)||st.st_nlink!=1)die("unsafe lock file",2);while(flock(LOCKFD,(PREPARE?LOCK_EX:LOCK_SH)|LOCK_NB)){int e=lock_host_errno();if(e==EINTR)continue;if(e==EWOULDBLOCK||e==EAGAIN)die(PREPARE?"NEED_PREPARE active readers/writer lock":"NEED_PREPARE active writer lock",75);die("flock",2);}}
int main(int argc,char**argv){const char*mode,*kind,*arch=0,*tmp,*u,*part=0;char phase[64],h[65],a[4096],b[4096],c[4096],e[4096],f[4096],lock[4096],binding[64];struct stat st;int rc;if(argc<3)die("usage prepare tools | prepare json|tbl ARCH | check ARCH",2);mode=argv[1];kind=argv[2];PREPARE=!strcmp(mode,"prepare");if(PREPARE){if(!strcmp(kind,"tools")){if(argc!=3)die("tools arguments",2);strcpy(phase,"tools");}else{if(argc!=4||(strcmp(kind,"json")&&strcmp(kind,"tbl")))die("preparation arguments",2);arch=argv[3];}}else{if(strcmp(mode,"check")||(argc!=3&&argc!=5))die("consumer arguments",2);arch=kind;if(argc==5){if(strcmp(argv[3],"--part")||(strcmp(argv[4],"cases")&&strcmp(argv[4],"refusals")&&strcmp(argv[4],"refusals-1")&&strcmp(argv[4],"refusals-2")&&strcmp(argv[4],"large")))die("consumer part",2);part=argv[4];if(!strcmp(part,"large")&&strcmp(arch,"arm64"))die("large scope requires arm64",2);}}if(arch&&strcmp(arch,"x86_64")&&strcmp(arch,"arm64"))die("architecture",2);if(arch)snprintf(phase,sizeof phase,"%s-%s",arch,PREPARE?kind:"tbl");if(!getcwd(ROOT,sizeof ROOT))die("cwd",2);atexit(cleanup);u=getenv("UA");resolve(u&&*u?u:"/tmp/ua_ref",UA);resolve("cc",CC);{Buf info={0};char*nl;char*iv[]={"sh","./exec/lower/wincheck.sh","--interpreter-info",0};if(run(iv,&info))die("legacy interpreter info",2);nl=strchr(info.s,'\n');if(!nl||nl==info.s)die("interpreter info format",2);*nl=0;resolve(info.s,PY);free(info.s);}key(KEY);tmp=getenv("TMPDIR");if(!tmp||!*tmp)tmp="/tmp";if(snprintf(D,sizeof D,"%s/unisacc-winlower-%s",tmp,KEY)>=(int)sizeof D)die("cache path",2);if(lstat(D,&st)){if(errno!=ENOENT)die("cache inspection",2);if(!PREPARE)die("NEED_PREPARE cold cache",75);if(mkdir(D,0700))die("cache mkdir",2);}else if(!S_ISDIR(st.st_mode)||st.st_uid!=geteuid()||(st.st_mode&0022))die("unsafe cache directory",2);take_lock();
 if(PREPARE){if(valid(phase)){printf("winlowerphase PREPARED %s key=%s (complete seal verified)\n",phase,KEY);return 0;}if(pred(phase))need(pred(phase));if(snprintf(T,sizeof T,"%s/txn-%ld",D,(long)getpid())>=(int)sizeof T)die("transaction path",2);if(mkdir(T,0700))die("new transaction",2);if(!strcmp(phase,"tools")){path(a,T,"run");{char*cmd[]={CC,"-O2","-o",a,"exec/c/run.c",0};must(cmd);}path(a,T,"hello");{char*cmd[]={UA,"-S","examples/hello.c","-o",a,0};must(cmd);}path(a,T,"fib");{char*cmd[]={UA,"-O2","-S","examples/fib.c","-o",a,0};must(cmd);}}else if(!strcmp(kind,"json")){char name[64];snprintf(name,sizeof name,"%s.json",arch);path(a,T,name);{char*cmd[]={"sh","./exec/lower/wincheck.sh","--material-json",(char*)arch,a,0};must(cmd);}}else{char name[64];snprintf(name,sizeof name,"%s.json",arch);path(a,D,name);snprintf(name,sizeof name,"%s.tbl",arch);path(b,T,name);{char*cmd[]={"sh","./exec/lower/wincheck.sh","--material-tbl",a,b,0};must(cmd);}}publish(phase);printf("winlowerphase PREPARED %s key=%s\n",phase,KEY);return 0;}
 need(phase);path(a,D,"run");snprintf(binding,sizeof binding,"LOWER_TARGET=win/%s",arch);{char name[64];snprintf(name,sizeof name,"%s.tbl",arch);path(b,D,name);snprintf(name,sizeof name,"%s.json",arch);path(c,D,name);}path(e,D,"hello");path(f,D,"fib");{char*cmd[12];int ci=0;cmd[ci++]="sh";cmd[ci++]="./exec/lower/wincheck.sh";cmd[ci++]="--material-check";cmd[ci++]=(char*)arch;if(part){cmd[ci++]="--part";cmd[ci++]=(char*)part;}cmd[ci++]=a;cmd[ci++]=b;cmd[ci++]=c;cmd[ci++]=e;cmd[ci++]=f;cmd[ci]=0;rc=run(cmd,0);}key(h);if(strcmp(h,KEY))die("consumer inputs changed",2);need(phase);if(rc)return rc;if(part)printf("winlowerphase scope PASS win/%s part=%s (fresh execution; partial coverage; no verdict cache)\n",arch,part);else printf("winlowerphase fullcheck PASS win/%s (fresh execution; no verdict cache)\n",arch);return 0;}
