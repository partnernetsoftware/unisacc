#!/usr/bin/env -S unisacc.com -run
/* librarysig2nativecheck.cx -- complete native signatures through the real public library, private sources.
   This proves host->script fixed scalar/Pair cases, not full bidirectional FFI.
   Ported from tests/librarysig2nativecheck.py (2026-10-23, the owner's direction: the toolchain moves off Python).
   usage: sh ./unisacc.com -run tests/librarysig2nativecheck.cx -- [-h] --package PACKAGE [--arch {arm64,x86_64}]
   The whole flow (argparse, the runtime copy, the two cc builds, the probe run, the evidence line, the failure
   contract) is tests/cxlib/libnative.cx, shared with tests/librarytypednativecheck.cx; here the probe is
   tests/libraryabi/nine_mixed_native.c, run as `probe PACKAGE TARGET`.  stdout is the probe's lines, then
     {"target": ..., "package_sha256": ..., "runtime_sha256": ..., "optimisation_levels": [0, 1, 2],
      "calls_per_level": 100, "scope": "actual public us_sym native->script fixed FP/GP17/Pair9 return; ..."}
   rc 0; a failure is rc 1 with the last line of the .py's traceback on stderr; argparse errors rc 2. */
#pragma unisa use cxlib.libnative

int main(int argc, char **argv) {
    static const ln_spec spec = {
        "librarysig2nativecheck.py", "tests/libraryabi/nine_mixed_native.c",
        "actual public us_sym native->script fixed FP/GP17/Pair9 return; not complete bidirectional/variadic/callback ABI",
        0, 0 };
    return ln_main(argc, argv, &spec);
}
