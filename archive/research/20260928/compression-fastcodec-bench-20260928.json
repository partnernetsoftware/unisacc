    "generator": "import random,zlib,json,subprocess,hashlib\nfrom pathlib import Path\nT=Path('/tmp/unisacc-v009-codec-probe'); rng=random.Random(9009); cases=[]\nfor n in [0,1,2,3,4,5,7,8,9,15,16,17,55,56,63,64,65,511,512,513,4095,4096,4097,32768,65535,65536]:\n raw=bytes(rng.randrange(256) for _ in range(n)) if n%2 else (b'abcabca0123456789'*((n+15)//16))[:n]\n for kind in ['stored','fixed','dynamic','mixed']:\n  c=zlib.compressobj(0 if kind=='stored' else 9,zlib.DEFLATED,-15,8,zlib.Z_FIXED if kind=='fixed' else zlib.Z_DEFAULT_STRATEGY)\n  if kind=='mixed':mid=n//2;packed=c.compress(raw[:mid])+c.flush(zlib.Z_SYNC_FLUSH)+c.compress(raw[mid:])+c.flush()\n  else:packed=c.compress(raw)+c.flush()\n  assert zlib.decompress(packed,-15)==raw\n  idx=len(cases);(T/f'v{idx}.raw').write_bytes(raw);(T/f'v{idx}.def').write_bytes(packed)\n  cases.append(dict(index=idx,n=n,kind=kind,crc=zlib.crc32(raw)))\nfor exe in ['cc','ua','san']:\n for mode in [2,3]:\n  for at in range(0,len(cases),32):\n   part=cases[at:at+32];args=[str(T/exe),str(mode),'1']\n   for x in part:args += [str(T/f\"v{x['index']}.raw\"),str(T/f\"v{x['index']}.def\")]\n   r=subprocess.run(args,capture_output=True,timeout=10);assert r.returncode==0,(exe,mode,r.returncode,r.stderr)\n   assert r.stdout.decode()==''.join(str(x['crc'])+'\\n' for x in part),(exe,mode,'CRC mismatch')\n print(exe,len(cases),'vectors x CRC/inflate equal',flush=True)\n(T/'vectors-result.json').write_text(json.dumps(dict(count=len(cases),executables=['cc','ua','san'],modes=['crc32','inflate'],cases=cases,scope='valid streams, stored/fixed/dynamic strategies and sync-flush mixed blocks; no malformed-input claim'),indent=2)+'\\n')\n"
