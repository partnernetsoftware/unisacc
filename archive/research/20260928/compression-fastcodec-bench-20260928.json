  "baseline_record": "research/compression-codec-bench-20260928.json",
  "changes": "9-bit canonical Huffman prefix lookup with long-code fallback, exact consumption without prefetch; slice-by-4 CRC32.",
  "prototype_patch": "--- probe-original.c\n+++ probe-fast.c\n@@ -437,10 +437,35 @@\n  *   since though their behavior -is- defined for overlapping arrays, it is\n  *   defined to do the wrong thing in this case.\n  */\n+\n+/* Probe fast path: peek only, then consume exactly the matched bits.\n+   Never prefetch an extra byte across the stored-block boundary. */\n+local void fasttable(const struct huffman *h, int *tab) {\n+ int len;int i;int k;int rev;int v;int j;int first;int index;\n+ for(i=0;i<512;i++)tab[i]=-1;\n+ first=0;index=0;\n+ for(len=1;len<=MAXBITS;len++){\n+  if(len<=9)for(i=0;i<h->count[len];i++){\n+   v=first+i;rev=0;for(j=0;j<len;j++){rev=(rev<<1)|(v&1);v=v>>1;}\n+   for(k=rev;k<512;k+=1<<len)tab[k]=(h->symbol[index+i]<<4)|len;\n+  }\n+  index+=h->count[len];first=(first+h->count[len])<<1;\n+ }\n+}\n+local int fastdecode(struct state *s,const struct huffman *h,int *tab){\n+ int val;int avail;int entry;int n;\n+ val=s->bitbuf;avail=s->bitcnt;\n+ if(s->incnt<s->inlen){val|=((int)s->in[s->incnt])<<avail;avail+=8;}\n+ entry=tab[val&511];\n+ if(entry>=0){n=entry&15;if(n<=avail){if(n>s->bitcnt){s->incnt++;s->bitcnt+=8;}else val=s->bitbuf;s->bitbuf=val>>n;s->bitcnt-=n;return entry>>4;}}\n+ return decode(s,h);\n+}\n+\n local int codes(struct state *s,\n                 const struct huffman *lencode,\n                 const struct huffman *distcode)\n {\n+    int lfast[512]; int dfast[512];\n     int symbol;         /* decoded symbol */\n     int len;            /* length for copy */\n     unsigned dist;      /* distance for copy */\n@@ -459,9 +484,10 @@\n         7, 7, 8, 8, 9, 9, 10, 10, 11, 11,\n         12, 12, 13, 13};\n \n+    fasttable(lencode,lfast);fasttable(distcode,dfast);\n     /* decode literals and length/distance pairs */\n     do {\n-        symbol = decode(s, lencode);\n+        symbol = fastdecode(s, lencode,lfast);\n         if (symbol < 0)\n             return symbol;              /* invalid symbol */\n         if (symbol < 256) {             /* literal: symbol is the byte */\n@@ -481,7 +507,7 @@\n             len = lens[symbol] + bits(s, lext[symbol]);\n \n             /* get and check distance */\n-            symbol = decode(s, distcode);\n+            symbol = fastdecode(s, distcode,dfast);\n             if (symbol < 0)\n                 return symbol;          /* invalid symbol */\n             dist = dists[symbol] + bits(s, dext[symbol]);\n@@ -940,9 +966,12 @@\n \n \n \n-long ctab[256];\n-int crc_init(void) { int i; int j; long c; for(i=0;i<256;i++){c=i;for(j=0;j<8;j++){if(c&1)c=(c>>1)^3988292384;else c=c>>1;}ctab[i]=c;}return 0; }\n-long crc(char *p,int n){long c;int i;c=4294967295;for(i=0;i<n;i++)c=(c>>8)^ctab[(c^(p[i]&255))&255];return c^4294967295;}\n+\n+long ctab[4][256];\n+int crc_init(void){int i;int j;long c;for(i=0;i<256;i++){c=i;for(j=0;j<8;j++){if(c&1)c=(c>>1)^3988292384;else c=c>>1;}ctab[0][i]=c;}for(i=0;i<256;i++){c=ctab[0][i];for(j=1;j<4;j++){c=(c>>8)^ctab[0][c&255];ctab[j][i]=c;}}return 0;}\n+long crc(char *p,int n){long c;long x;int i;c=4294967295;i=0;\n+ while(i+4<=n){x=c^((long)(p[i]&255)|((long)(p[i+1]&255)<<8)|((long)(p[i+2]&255)<<16)|((long)(p[i+3]&255)<<24));c=ctab[3][x&255]^ctab[2][(x>>8)&255]^ctab[1][(x>>16)&255]^ctab[0][(x>>24)&255];i+=4;}\n+ while(i<n){c=(c>>8)^ctab[0][(c^(p[i]&255))&255];i++;}return c^4294967295;}\n char *readall(char *path,int *n) {FILE *f;char *p;long k;f=fopen(path,\"rb\");if(!f)exit(3);if(fseek(f,0,2))exit(3);k=ftell(f);if(k<0||k>2000000)exit(3);*n=k;if(fseek(f,0,0))exit(3);p=malloc(k+1);if(!p)exit(3);if(fread(p,1,k,f)!=k)exit(3);fclose(f);return p;}\n char *raws[64];char *defs[64];char *outs[64];int lens[64];int clens[64];long answer[64];\n int main(int argc,char **argv){int m;int r;int i;int j;int n;int count;int mode;int rep;unsigned long on;unsigned long cn;char dig[32];\n",
