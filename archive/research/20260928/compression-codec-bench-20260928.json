  "puff_adaptations": [
    "remove setjmp.h and puff.h; define NIL 0",
    "jmp_buf env -> int env",
    "longjmp(s->env, 1) -> exit(2) at both sites",
    "setjmp(s.env) != 0 -> 0; valid-input throughput only, no production error handling"
  ],
  "sha_source": "src/back_image.c: SHA_K through sha_final, unchanged",
  "probe_wrapper": "long ctab[256];\nint crc_init(void) { int i; int j; long c; for(i=0;i<256;i++){c=i;for(j=0;j<8;j++){if(c&1)c=(c>>1)^3988292384;else c=c>>1;}ctab[i]=c;}return 0; }\nlong crc(char *p,int n){long c;int i;c=4294967295;for(i=0;i<n;i++)c=(c>>8)^ctab[(c^(p[i]&255))&255];return c^4294967295;}\nchar *readall(char *path,int *n) {FILE *f;char *p;long k;f=fopen(path,\"rb\");if(!f)exit(3);if(fseek(f,0,2))exit(3);k=ftell(f);if(k<0||k>2000000)exit(3);*n=k;if(fseek(f,0,0))exit(3);p=malloc(k+1);if(!p)exit(3);if(fread(p,1,k,f)!=k)exit(3);fclose(f);return p;}\nchar *raws[64];char *defs[64];char *outs[64];int lens[64];int clens[64];long answer[64];\nint main(int argc,char **argv){int m;int r;int i;int j;int n;int count;int mode;int rep;unsigned long on;unsigned long cn;char dig[32];\nif(argc<5||(argc-3)%2)return 3;mode=atoi(argv[1]);rep=atoi(argv[2]);count=(argc-3)/2;if(count>64||rep<1)return 3;crc_init();\nfor(m=0;m<count;m++){raws[m]=readall(argv[3+2*m],&lens[m]);defs[m]=readall(argv[4+2*m],&clens[m]);outs[m]=malloc(lens[m]);if(!outs[m])return 3;}\nfor(r=0;r<rep;r++)for(m=0;m<count;m++){\n if(mode==1){sha_init();for(i=0;i<lens[m];i++)sha_byte(raws[m][i]&255);sha_final(dig);answer[m]=dig[0]&255;}\n if(mode==2)answer[m]=crc(raws[m],lens[m]);\n if(mode==3){on=lens[m];cn=clens[m];if(puff((unsigned char *)outs[m],&on,(unsigned char *)defs[m],&cn)||on!=lens[m]||cn!=clens[m])return 4;}\n}\nfor(m=0;m<count;m++){\n if(mode==3&&memcmp(outs[m],raws[m],lens[m]))return 5;\n if(mode==1){sha_init();for(i=0;i<lens[m];i++)sha_byte(raws[m][i]&255);sha_final(dig);for(j=0;j<32;j++)printf(\"%02x\",dig[j]&255);printf(\"\\n\");}\n else printf(\"%ld\\n\",mode==2?answer[m]:crc(raws[m],lens[m]));\n}\nreturn 0;}\n",
  "measurement_script": "import json,hashlib,zlib,subprocess,time,statistics,platform\nfrom pathlib import Path\nT=Path('/tmp/unisacc-v009-codec-probe'); q=json.loads((T/'models.json').read_text()); models=q['models']\ndef call(exe,mode,rep,ids):\n args=[str(T/exe),str(mode),str(rep)]\n for i in ids: args += [str(T/f'{i}.raw'),str(T/f'{i}.def')]\n start=time.perf_counter();r=subprocess.run(args,capture_output=True,timeout=15);dt=time.perf_counter()-start\n assert r.returncode==0,(exe,mode,r.returncode,r.stderr)\n expected=''.join((models[i]['sha256'] if mode==1 else str(models[i]['crc32']))+'\\n' for i in ids)\n assert r.stdout.decode()==expected,(exe,mode,'checksum mismatch')\n return dt\nids=[int(r[-1]) for r in q['routes'] if r[1]=='osx/arm64/run/O0'] + [int(r[-1]) for r in q['routes'] if r[1]=='osx/arm64/memory']*2\nsize=sum(models[i]['bytes'] for i in ids)\nresult=dict(artifact_sha256=hashlib.sha256(Path('unisacc.com').read_bytes()).hexdigest(),platform=platform.platform(),ids=ids,bytes_per_run=size,models=models,puff_source_sha256=hashlib.sha256(Path('/tmp/unisacc-puff-v009.c').read_bytes()).hexdigest(),probe_source_sha256=hashlib.sha256((T/'probe.c').read_bytes()).hexdigest(),scope='Valid-input prototype; puff EOF aborts instead of setjmp. Five process pairs (25 repetitions minus 5)/20 remove file-read/output/startup costs approximately. No integrated product timing.',results={})\nfor exe in ['cc','ua']:\n for mode in [1,2,3]:call(exe,mode,1,list(range(len(models))))\n print(exe,'all 32 models inflate/hash/CRC verified',flush=True)\n result['results'][exe]={}\n for mode,name in [(1,'sha256'),(2,'crc32'),(3,'inflate')]:\n  pairs=[]\n  for j in range(5):\n   if j%2: high=call(exe,mode,25,ids);low=call(exe,mode,5,ids)\n   else: low=call(exe,mode,5,ids);high=call(exe,mode,25,ids)\n   pairs.append(dict(low_s=low,high_s=high,per_run_s=(high-low)/20))\n  median=statistics.median(p['per_run_s'] for p in pairs)\n  result['results'][exe][name]=dict(pairs=pairs,median_s=median,decimal_MB_s=size/median/1e6)\n  print(exe,name,'%.3f ms %.1f MB/s'%(median*1000,size/median/1e6),flush=True)\nresult['binary_sha256']={e:hashlib.sha256((T/e).read_bytes()).hexdigest() for e in ['cc','ua']}\n(T/'result.json').write_text(json.dumps(result,indent=2)+'\\n')\n",
  "input_recipe": "Read published v0.0.8 artifact footer UNIPKG1; parse P2 directory then each M body. Bodies are after compact_q. Compress each with zlib.compressobj(9, zlib.DEFLATED, -15). Independently compare inflated bytes, SHA256 and CRC32 against Python hashlib/zlib for all 32 models using both binaries before timing.",
  "decision": "Runtime decoded-network CRC32; keep SHA256 in construction/package audit. Integrated startup/calc timings and production bounds decoder remain untested."
}
