  "method": "Read root .com UNIPKG1 footer; validate/decompress actual embedded package via packageformat.read_package; parse N and H; validate and expand Q/C using pack.decode_q. Count each H bank and its threshold units, with mode-3 keys separately. Count all package D row references per selected model. No model execution. The unchanged extraction_python from the previous audit was actually executed. The current product-input closure was compared with the actual build record; every tracked closure input was independently compared with the recorded audit HEAD blob.",
  "units": {
    "states": "N states / one H observation bank per state",
    "sequences": "Q plus C sequence records",
    "expanded_sequence_actions": "sum of actions after backward prefix expansion, not flat integer operands",
    "threshold_units": "sum H unit counts, excluding declared return keys",
    "declared_return_keys": "sum mode-3 return set cardinalities, not distinct keys across banks",
    "route_row_refs": "all package stage-row references to this physical shared model, not only selected route",
    "binary_bytes": "uncompressed UNINETB1 body",
    "compressed_bytes": "stored per-model raw-DEFLATE body, excludes package directory and record headers"
  },
  "scope": "Offline structure only. Route totals count six distinct physical models once. All-shared totals count every physical model once. Structure and compressed bytes are specific to the recorded artifact.",
  "previous_audit": "research/r9-pipeline-structure-10994c2.json",
  "previous_audit_sha256": "5c25338bc895e0deca1ae7f692e4998a5658a10e5dbb9e4ade4e5e52464682c1",
  "dynamic_counts": {
    "remeasured": false,
    "previous_evidence": "research/pipeline-counts-20260928/manifest.json",
    "limitation": "Older calc runtime action/step counts are not transferred or extrapolated to these models. No runtime steps, actions, timings or live platform execution measured in this audit."
  },
  "extraction_python": "import collections, hashlib, pathlib, sys\nroot = pathlib.Path.cwd()\nsys.path.insert(0, str(root / 'exec/c'))\nfrom packageformat import read_package\nfrom pack import decode_q\nartifact = (root / 'unisacc.com').read_bytes()\nassert artifact[-16:-8] == b'UNIPKG1\\n'\npackage_bytes = int.from_bytes(artifact[-8:], 'little')\npackage_offset = len(artifact) - 16 - package_bytes\nassert package_offset > 0 and package_bytes > 0\npackage = artifact[package_offset:-16]\ndecoded = read_package(package)\nrefs = collections.Counter(int(row[5]) for row in decoded['rows'])\nmodels = []\nfor index, text in enumerate(decoded['models']):\n    lines = text.splitlines()\n    head = lines[0].split()\n    assert head[0] == b'N' and len(head) == 7\n    states, sequences, registers, strings, start, top = map(int, head[1:])\n    qlines = lines[1 + strings:1 + strings + sequences]\n    expanded = decode_q(qlines)\n    hlines = lines[1 + strings + sequences:]\n    assert len(hlines) == states\n    units = banks = keys = 0\n    for line in hlines:\n        words = line.split()\n        assert words[0] == b'H'\n        values = list(map(int, words[1:]))\n        mode, lo, hi, count, base_next, base_sequence = values[:6]\n        assert count >= 0\n        units += count\n        if mode == 3:\n            return_sequence, return_count = values[6:8]\n            return_keys = values[8:8 + return_count]\n            assert 0 <= return_sequence < sequences\n            assert return_count > 0 and len(return_keys) == return_count\n            assert return_keys == sorted(set(return_keys))\n            assert all(0 <= key <= top for key in return_keys)\n            assert len(values) == 8 + return_count + 3 * count\n            banks += 1\n            keys += return_count\n        else:\n            assert mode in (0, 1, 2) and len(values) == 6 + 3 * count\n    wire = decoded['wires'][index]\n    models.append(dict(index=index, states=states, sequences=sequences,\n        q_records=sum(line.startswith(b'Q ') for line in qlines),\n        c_records=sum(line.startswith(b'C ') for line in qlines),\n        stored_suffix_actions=sum(int(line.split()[1] if line.startswith(b'Q ') else line.split()[3]) for line in qlines),\n        expanded_sequence_actions=sum(map(len, expanded)), threshold_units=units,\n        declared_return_banks=banks, declared_return_keys=keys,\n        binary_bytes=len(wire['raw']), compressed_bytes=len(wire['stored']),\n        route_row_refs=refs[index], binary_sha256=hashlib.sha256(wire['raw']).hexdigest(),\n        compressed_sha256=hashlib.sha256(wire['stored']).hexdigest()))\nroute = 'osx/arm64/image/O2'\nselected = [dict(stage=row[2].decode(), input=row[3].decode(), output=row[4].decode(),\n                 **models[int(row[5])]) for row in decoded['rows'] if row[1].decode() == route]\nassert [item['stage'] for item in selected] == ['e2','e1','e3','e4','lower','elf']\nassert len({item['index'] for item in selected}) == len(selected)\nassert (root / 'unisacc.com').read_bytes() == artifact\n",
  "extraction_python_sha256": "14b90c1562e5cb2de320331009d245670f678de4b960f3510ec75ce4e59c0cfd",
