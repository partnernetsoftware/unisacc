#pragma unisa use sys.fs
#pragma unisa use sys.sha
static void fail(const char *s){fprintf(stderr,"POSTVERIFY REFUSE %s\n",s);exit(2);}
static char *load(const char *f){size_t n;char *b=cx_read(f,&n);if(!b||memchr(b,0,n))fail("input");return b;}
int main(void){char *plan=load("out/c48-macos-distribution/cache-apply.stdout"),*active=load("out/c48-macos-distribution/cache-apply-fresh-active.tsv");long kept=0,deleted=0,bytes=0,protected=0;char *p=plan;while(*p){char *e=strchr(p,'\n');if(!e)fail("framing");*e=0;if(!strncmp(p,"CACHE_PLAN\t",11)){char *action=p+11,*name=strchr(action,'\t');if(!name)fail("plan");*name++=0;char *t=strchr(name,'\t');if(!t)fail("name");*t++=0;if(strncmp(name,"unisacc-",8)||strlen(name)!=24||strspn(name+8,"0123456789abcdef")!=16)fail("strict name");char path[4400];snprintf(path,sizeof path,"/Users/wjc/.cache/unisacc/%s",name);struct stat st;errno=0;int r=lstat(path,&st);if(!strcmp(action,"KEEP")){if(r||!S_ISREG(st.st_mode)||st.st_uid!=getuid())fail("keep missing/unsafe");char *hs=strstr(t,"sha=");if(!hs||strlen(hs+4)!=64)fail("SHA field");size_t n;char *b=cx_read(path,&n),h[65];if(!b)fail("keep read");if(sy_sha256_hex(b,n,h)&&cx_sha256_hex(b,n,h))fail("SHA");free(b);if(strcmp(h,hs+4))fail("keep SHA");bytes+=st.st_size;kept++;}else if(!strcmp(action,"DELETE")){if(!r||errno!=ENOENT)fail("delete still present/error");deleted++;}else fail("action");}p=e+1;}p=strchr(active,'\n');if(!p)fail("active header");p++;while(*p){char *e=strchr(p,'\n'),*t=strchr(p,'\t');if(!e||!t||t>e)fail("active framing");*t=0;char path[4400];snprintf(path,sizeof path,"/Users/wjc/.cache/unisacc/%s",p);struct stat st;if(lstat(path,&st)||!S_ISREG(st.st_mode))fail("active removed");protected++;p=e+1;}DIR *d=opendir("/Users/wjc/.cache/unisacc");if(!d)fail("directory");struct dirent *e;long count=0;while((e=readdir(d)))if(!strncmp(e->d_name,"unisacc-",8)&&strlen(e->d_name)==24&&strspn(e->d_name+8,"0123456789abcdef")==16)count++;closedir(d);if(count!=kept||kept!=4)fail("N/count");printf("CACHE_POSTVERIFY\tstatus=VERIFIED\tkept=%ld\tdeleted_absent=%ld\tbytes=%ld\tactive_paths_preserved=%ld\tfull_SHA_checked=%ld\n",kept,deleted,bytes,protected,kept);return 0;}
