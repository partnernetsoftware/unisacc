#pragma unisa use sys.fs
#pragma unisa use sysx.process
static char *cache="/Users/wjc/.cache/unisacc",*base="/Users/wjc/repos/unisacc/out/c48-macos-distribution";
static void die(const char *s){fprintf(stderr,"MIGRATION REFUSE %s\n",s);exit(2);}
static void save(const char *leaf,const char *s,size_t n){char p[8192];cx_fmt(p,sizeof p,"%s/%s",base,leaf);if(cx_write(p,s,n))die("save");}
static int name(const char *s){if(strncmp(s,"unisacc-",8)||strlen(s)!=24)return 0;return strspn(s+8,"0123456789abcdef")==16;}
int main(int ac,char **av){if(ac!=2||(strcmp(av[1],"audit")&&strcmp(av[1],"dry")&&strcmp(av[1],"apply")))return 2;
 char list[8192];cx_fmt(list,sizeof list,"%s/cache-active.tsv",base);
 if(1){char *v[]={"/usr/sbin/lsof","-nP","-Fpn","+D",cache,0};np_result r={0};char why[300];if(np_run(v,".",0,12,&r,why,sizeof why)||r.residue||r.errn||(r.rc!=0&&r.rc!=1))die("lsof");save("cache-active.raw",r.out?r.out:"",r.outn);char data[65536];int n=snprintf(data,sizeof data,"CACHE_ACTIVE_V1\t%s\n",cache);long pid=0;char *p=r.out;while(p&&*p){char *e=strchr(p,'\n');if(!e)die("lsof framing");*e=0;if(p[0]=='p'){char *end;pid=strtol(p+1,&end,10);if(*end||pid<1)die("pid");}else if(p[0]=='n'){size_t z=strlen(cache);if(!strcmp(p+1,cache)){p=e+1;continue;}if(!pid||strncmp(p+1,cache,z)||p[z+1]!='/')die("outside cache");const char *leaf=p+z+2;if(name(leaf)){char row[300];int m=snprintf(row,sizeof row,"%s\t%ld\n",leaf,pid);if(m<0||m>=sizeof row||m>=(int)sizeof data-n)die("list bound");if(!strstr(data,row)){memcpy(data+n,row,m+1);n+=m;}}}else if(p[0]!='f')die("unknown lsof field");p=e+1;}save("cache-active.tsv",data,n);printf("CACHE_MIGRATION_AUDIT\trc=%d\tbytes=%d\n",r.rc,n);np_free(&r);if(!strcmp(av[1],"audit"))return 0;}
 char parent[40];snprintf(parent,sizeof parent,"%ld",(long)getpid());char *helper="/Users/wjc/repos/unisacc/out/c48-macos-distribution/full-six-slot/cache-manager-arm64";char *v[12];int n=0;v[n++]=helper;if(!strcmp(av[1],"dry"))v[n++]="--dry-run";v[n++]="--adopt-legacy";v[n++]=list;v[n++]=cache;v[n++]="unisacc";v[n++]="e5f80facc67e6b41";v[n++]="4";v[n++]=parent;v[n]=0;np_result r={0};char why[300];int tr=np_run(v,".",0,45,&r,why,sizeof why);char leaf[100];cx_fmt(leaf,sizeof leaf,"cache-%s.stdout",av[1]);save(leaf,r.out?r.out:"",r.outn);cx_fmt(leaf,sizeof leaf,"cache-%s.stderr",av[1]);save(leaf,tr?why:(r.err?r.err:""),tr?strlen(why):r.errn);if(tr||r.rc||r.residue)die("helper");if(r.outn)fwrite(r.out,1,r.outn,stdout);np_free(&r);return 0;}
