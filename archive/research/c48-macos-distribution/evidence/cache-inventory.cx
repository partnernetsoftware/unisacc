#pragma unisa use sys.fs
#pragma unisa use sys.sha
int main(void){const char *dir="/Users/wjc/.cache/unisacc";DIR *d=opendir(dir);if(!d)return 2;struct dirent *e;long count=0,bytes=0,markers=0,leases=0,other=0;int current=0,protected=0;printf("CACHE_INVENTORY\tversion=1\troot=%s\n",dir);while((e=readdir(d))){if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;char p[4400];snprintf(p,sizeof p,"%s/%s",dir,e->d_name);struct stat s;if(lstat(p,&s))return 2;if(!strncmp(e->d_name,"unisacc-",8)&&strlen(e->d_name)==24&&strspn(e->d_name+8,"0123456789abcdef")==16){if(!S_ISREG(s.st_mode)||s.st_uid!=getuid()||s.st_nlink!=1)return 3;count++;bytes+=s.st_size;printf("FILE\t%s\tbytes=%ld\tinode=%ld\tmode=%o\n",e->d_name,(long)s.st_size,(long)s.st_ino,s.st_mode&0777);if(!strcmp(e->d_name,"unisacc-e5f80facc67e6b41")){current=1;size_t n;char *b=cx_read(p,&n),h[65];if(!b)return 2;if(sy_sha256_hex(b,n,h)&&cx_sha256_hex(b,n,h))return 2;printf("CURRENT_SHA\t%s\n",h);free(b);}if(!strcmp(e->d_name,"unisacc-9e379afec4e07216"))protected=1;}else if(!strncmp(e->d_name,"unisacc.managed-v1-",18))markers++;else if(!strncmp(e->d_name,"unisacc.lease-v1-",16))leases++;else other++;}if(closedir(d))return 2;printf("TOTAL\tfiles=%ld\tbytes=%ld\tmarkers=%ld\tleases=%ld\tother=%ld\tcurrent=%d\tpreviously_active_9e379=%d\n",count,bytes,markers,leases,other,current,protected);return 0;}
