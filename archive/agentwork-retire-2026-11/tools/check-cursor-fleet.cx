/* tools/check-cursor-fleet.cx -- tools/cursor-fleet.cx against a stub agent in a temporary git fixture.
 *
 *   sh ./unisacc.com tools/check-cursor-fleet.cx
 *
 * The check builds a temporary repo (git init, a mini agentwork/dag.tsv and items.tsv), compiles the stub agent
 * (a .cx program written by the check; its behavior is picked by a STUBMODE:x marker in the node title, which
 * reaches it through the prompt) and the tool through cxlib.runnerprep, and never starts the real cursor-agent.
 * Fixtures: (1) edit inside the domain -> OK; (2) edit outside -> REJECTED, outside_paths lists it; (3) a deleted
 * assertion -> REJECTED; (4) a raised limit -> REJECTED; (5) timeout -> TIMEOUT and the group is gone;
 * (6) nonzero exit -> AGENT_FAIL; (7) no change -> NO_CHANGE; (8) a node with an unfinished dep is refused;
 * (9) --dry-run writes the prompt only; (10) --max 2 overlaps two nodes, a missing id is refused; (11) the
 * fixture origin is byte-identical afterwards; plus a forbidden-path fixture, so each REJECTED rule fires by its
 * own fixture and the others stay 0.  Prints PASS/FAIL per case and CHECK_CURSOR_FLEET<TAB>failed=N seconds=S. */
#pragma unisa use cxlib.procrun
#pragma unisa use cxlib.runnerprep
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use text.text

static int failed;
static char work[4400], home[4400], toolbin[4400], stubbin[4400], origin[4400];

static void die(const char *s) { fprintf(stderr, "check-cursor-fleet: %s\n", s); exit(2); }
static void ck(int ok, const char *name) { printf("%s\tcursor-fleet.%s\n", ok ? "PASS" : "FAIL", name); if (!ok) failed++; }
/* 1 when some line of S starts with T (a line-prefix compare, never a free substring search) */
static int has(const char *s, const char *t) {
    size_t tl = strlen(t);
    while (s && *s) {
        const char *e = strchr(s, '\n');
        if (!strncmp(s, t, tl)) return 1;
        if (!e) break;
        s = e + 1;
    }
    return 0;
}

static const char *STUB =
    "static int is(const char *m, const char *x) { size_t n = strlen(x); return !strncmp(m, x, n) && (m[n] == 0 || m[n] <= ' '); }\n"
    "static void put(const char *p, const char *s) { cx_write(p, s, strlen(s)); }\n"
    "int main(int argc, char **argv) {\n"
    "    int i; const char *m = \"\";\n"
    "    for (i = 1; i < argc; i++) { const char *p = strstr(argv[i], \"STUBMODE:\"); if (p) { m = p + 9; break; } }\n"
    "    printf(\"{\\\"type\\\":\\\"result\\\"}\\n\");\n"
    "    if (is(m, \"edit-ok\")) put(\"src/a.txt\", \"changed\\n\");\n"
    "    else if (is(m, \"edit-out\")) put(\"other/x.txt\", \"changed\\n\");\n"
    "    else if (is(m, \"del-assert\")) put(\"tests/t.cx\", \"int main(void) { return 0; }\\n\");\n"
    "    else if (is(m, \"raise-limit\")) put(\"src/limits-demo.tsv\", \"a\\t600\\n\");\n"
    "    else if (is(m, \"forbid\")) put(\"tools/cxlib/x.cx\", \"int y;\\n\");\n"
    "    else if (is(m, \"fail\")) return 3;\n"
    "    else if (is(m, \"sleep\")) {\n"
    "        char *av[] = {\"sleep\", \"30\", 0}; char b[32]; int pid = fork();\n"
    "        if (pid == 0) { execvp(\"sleep\", av); _exit(127); }\n"
    "        snprintf(b, sizeof b, \"%d\\n\", pid); put(\"gc.pid\", b);\n"
    "        sleep(30);\n"
    "    }\n"
    "    else if (is(m, \"slow\")) { usleep(1500000); put(\"src/a.txt\", \"slow\\n\"); }\n"
    "    return 0;\n"
    "}\n";

static int alive(int pid) {
    char stat[64]; size_t n = 0; char *s, *p; int z;
    if (cx_fmt(stat, sizeof stat, "/proc/%d/stat", pid)) return 0;
    s = cx_read(stat, &n);
    if (!s) return 0;
    p = strrchr(s, ')');
    z = p && p[1] == ' ' && p[2] == 'Z';
    free(s);
    return !z;
}

static int run(const char *cwd, char **argv, int secs, char *out, size_t cap) {
    pr_result r; int t = pr_run("fleet-check", argv, cwd, 0, secs, &r), rc;
    if (out) {
        size_t k;
        out[0] = 0;
        if (r.out) (void)tx_copy(out, (long)cap, r.out, (long)(r.outn < cap - 1 ? r.outn : cap - 1));
        k = strlen(out);
        if (r.err && k + 1 < cap) (void)tx_copy(out + k, (long)(cap - k), r.err, (long)(r.errn < cap - 1 - k ? r.errn : cap - 1 - k));
    }
    rc = t ? -1 : r.rc;
    pr_free(&r);
    return rc;
}

static void git(const char *dir, char **argv) {
    if (run(dir, argv, 30, 0, 0) != 0) die("fixture git command failed");
}

static void put(const char *rel, const char *text) {
    char p[4500];
    if (cx_fmt(p, sizeof p, "%s/%s", origin, rel) || cx_write(p, text, strlen(text))) die("fixture write");
}

/* column NAME of the data row of result.tsv at PATH into out; 0 when found */
static int rget(const char *path, const char *name, char *out, size_t cap) {
    size_t n = 0; char *t = cx_read(path, &n), *nl; char h[64]; int i;
    out[0] = 0;
    if (!t) return -1;
    nl = strchr(t, '\n');
    if (!nl) { free(t); return -1; }
    for (i = 0; i < 20; i++) {
        long hl = 0; const char *hs = t; long k;
        int f = 0; const char *c = hs;
        while (f < i && c < nl) { if (*c == '\t') f++; c++; }
        if (f < i) break;
        k = 0; while (c + k < nl && c[k] != '\t') k++;
        hl = k; if (hl > 63) hl = 63; (void)tx_copy(h, (long)sizeof h, c, hl);
        if (!strcmp(h, name)) {
            const char *r = nl + 1; const char *e = strchr(r, '\n'); long rn = e ? (long)(e - r) : (long)strlen(r);
            long j = 0; int g = 0; size_t o = 0;
            while (j < rn && g < i) { if (r[j] == '\t') g++; j++; }
            while (j < rn && r[j] != '\t' && o + 1 < cap) out[o++] = r[j++];
            out[o] = 0; free(t); return 0;
        }
    }
    free(t);
    return -1;
}

static void res(const char *out, const char *node, const char *col, char *v) {
    char p[4500];
    v[0] = 0;
    if (cx_fmt(p, sizeof p, "%s/%s/result.tsv", out, node) || rget(p, col, v, 4096)) (void)cx_fmt(v, 4096, "?");
}

int main(void) {
    long t0 = sy_now_ms();
    char cache[4500], p[4500], buf[8192], v[4096], v2[4096], why[512], stubsrc[4500], out1[4500], out2[4500], out3[4500], out4[4500], before[8192], after[8192];
    int reused;
    if (sy_realpath(".", home, sizeof home) < 0) die("realpath");
    if (cx_fmt(work, sizeof work, "%s/check-cursor-fleet-%d", sy_tmpdir(), (int)getpid())) die("work");
    if (sy_exists(work) == 1 && cx_rmtree(work)) die("old work");
    if (sy_mkdir(work, 0700)) die("mkdir");
    if (cx_fmt(origin, sizeof origin, "%s/origin", work) || sy_mkdir(origin, 0700)) die("origin");
    if (cx_fmt(cache, sizeof cache, "%s/cursor-fleet-check-cache", sy_tmpdir())) die("cache");
    if (sy_mkdir_all(cache, 0755) < 0) die("cache dir");
    if (rn_prepare(home, "tools/cursor-fleet.cx", cache, toolbin, sizeof toolbin, &reused, why, sizeof why)) { fprintf(stderr, "%s\n", why); die("prepare tool"); }
    /* the stub names no module (implicit runtime only), so it can live in the cache dir; a fixed name keeps the image reusable */
    if (cx_fmt(stubsrc, sizeof stubsrc, "%s/stub-agent.cx", cache) || cx_write(stubsrc, STUB, strlen(STUB))) die("stub source");
    if (rn_prepare(home, stubsrc, cache, stubbin, sizeof stubbin, &reused, why, sizeof why)) { fprintf(stderr, "%s\n", why); die("prepare stub"); }
    printf("PREPARED\tcursor-fleet\tseconds=%ld\n", (sy_now_ms() - t0) / 1000);

    /* fixture repo */
    {   char *i1[] = {"git", "init", "-q", "-b", "main", 0}; git(origin, i1); }
    {   char *c1[] = {"git", "config", "user.email", "fixture@example.invalid", 0}; git(origin, c1); }
    {   char *c2[] = {"git", "config", "user.name", "fixture", 0}; git(origin, c2); }
    {   char *m[] = {"mkdir", "-p", "src", "tests", "tools/cxlib", "other", "agentwork", 0}; git(origin, m); }
    put("src/a.txt", "orig\n");
    put("src/limits-demo.tsv", "a\t60\n");
    put("tests/t.cx", "int main(void) {\n    ck(x == 1, \"a\");\n    return 0;\n}\n");
    put("tools/cxlib/x.cx", "int x;\n");
    put("other/x.txt", "orig\n");
    put("agentwork/dag.tsv",
        "id\ttitle\tstatus\tdeps\twrite_domain\towner\tacceptance\tcommit\n"
        "DEP0\tdone dep\tDONE\t-\tsrc/**\tx\ttrue\tabc\n"
        "DEP1\tunfinished dep\tTODO\t-\tsrc/**\tx\ttrue\t-\n"
        "N-OK\tSTUBMODE:edit-ok\tTODO\tDEP0\tsrc/**\tx\ttrue\t-\n"
        "N-OUT\tSTUBMODE:edit-out\tTODO\tDEP0\tsrc/**\tx\ttrue\t-\n"
        "N-ASSERT\tSTUBMODE:del-assert\tTODO\t-\ttests/**\tx\ttrue\t-\n"
        "N-LIMIT\tSTUBMODE:raise-limit\tTODO\t-\tsrc/**\tx\ttrue\t-\n"
        "N-FORB\tSTUBMODE:forbid\tTODO\t-\ttools/**\tx\ttrue\t-\n"
        "N-FAIL\tSTUBMODE:fail\tTODO\t-\tsrc/**\tx\ttrue\t-\n"
        "N-NOCH\tSTUBMODE:nochange\tTODO\t-\tsrc/**\tx\ttrue\t-\n"
        "N-SLEEP\tSTUBMODE:sleep\tTODO\t-\tsrc/**\tx\ttrue\t-\n"
        "N-BLOCK\tSTUBMODE:edit-ok\tTODO\tDEP1\tsrc/**\tx\ttrue\t-\n"
        "N-SLOW1\tSTUBMODE:slow\tTODO\t-\tsrc/**\tx\ttrue\t-\n"
        "N-SLOW2\tSTUBMODE:slow\tTODO\t-\tsrc/**\tx\ttrue\t-\n");
    put("agentwork/items.tsv",
        "id\tgoal\trole\tdomain\tgate\tcontext\tbudget_min\tdeps\tstate\towner\tcheck\n"
        "N-OK\tGOALTEXT-make-the-change\timplementer\tsrc/**\tGATETEXT-run-one\tCTXTEXT-read-a\t5\t-\tTODO\t-\t-\n");
    {   char *a[] = {"git", "add", "-A", 0}; git(origin, a); }
    {   char *c[] = {"git", "commit", "-q", "-m", "seed", 0}; git(origin, c); }
    {   char *s[] = {"git", "status", "--porcelain=v1", 0}; run(origin, s, 30, before, sizeof before); }
    {   char *h[] = {"git", "rev-parse", "HEAD", 0}; char hb[128]; run(origin, h, 30, hb, sizeof hb); (void)tx_copy(before + strlen(before), (long)(sizeof before - strlen(before)), hb, (long)strlen(hb)); }

    if (cx_fmt(out1, sizeof out1, "%s/out1", work) || cx_fmt(out2, sizeof out2, "%s/out2", work) ||
        cx_fmt(out3, sizeof out3, "%s/out3", work) || cx_fmt(out4, sizeof out4, "%s/out4", work)) die("out");

    /* (1)(2)(3)(4)(6)(7) plus forbidden: seven quick nodes, four at a time */
    {   char *av[] = {toolbin, "run", "--nodes", "N-OK,N-OUT,N-ASSERT,N-LIMIT,N-FORB,N-FAIL,N-NOCH", "--max", "4", "--agent", stubbin,
                      "--root", origin, "--out", out1, "--template", "tools/cursor-fleet-template.txt", 0};
        long a0 = sy_now_ms();
        int rc = run(home, av, 55, buf, sizeof buf);
        printf("SECONDS\tquick-nodes=%ld\n", (sy_now_ms() - a0) / 1000);
        ck(rc == 1 && has(buf, "RESULT\tN-OK\tOK"), "run-quick-nodes-finish"); }
    res(out1, "N-OK", "status", v); res(out1, "N-OK", "domain_ok", v2);
    ck(!strcmp(v, "OK") && !strcmp(v2, "1"), "1-edit-in-domain-is-ok");
    {   char pp[4500], *t; size_t n = 0; cx_fmt(pp, sizeof pp, "%s/N-OK/patch.diff", out1); t = cx_read(pp, &n);
        ck(t && has(t, "+changed") && has(t, "+++ b/src/a.txt"), "1b-patch-harvested"); free(t);
        cx_fmt(pp, sizeof pp, "%s/N-OK/agent.out", out1); t = cx_read(pp, &n);
        ck(t && has(t, "{\"type\":\"result\""), "1c-agent-stdout-captured"); free(t); }
    res(out1, "N-OUT", "status", v); res(out1, "N-OUT", "outside_paths", v2);
    ck(!strcmp(v, "REJECTED") && !strcmp(v2, "other/x.txt"), "2-outside-domain-rejected");
    res(out1, "N-OUT", "assertion_deletes", v); res(out1, "N-OUT", "forbidden_touch", v2);
    ck(!strcmp(v, "0") && !strcmp(v2, "0"), "2b-outside-fires-only-the-domain-rule");
    res(out1, "N-ASSERT", "status", v); res(out1, "N-ASSERT", "assertion_deletes", v2);
    ck(!strcmp(v, "REJECTED") && atoi(v2) > 0, "3-deleted-assertion-rejected");
    res(out1, "N-ASSERT", "domain_ok", v); res(out1, "N-ASSERT", "forbidden_touch", v2);
    ck(!strcmp(v, "1") && !strcmp(v2, "0"), "3b-assertion-fires-only-its-rule");
    res(out1, "N-LIMIT", "status", v); res(out1, "N-LIMIT", "assertion_deletes", v2);
    ck(!strcmp(v, "REJECTED") && atoi(v2) > 0, "4-raised-limit-rejected");
    res(out1, "N-LIMIT", "domain_ok", v); res(out1, "N-LIMIT", "forbidden_touch", v2);
    ck(!strcmp(v, "1") && !strcmp(v2, "0"), "4b-limit-fires-only-its-rule");
    res(out1, "N-FORB", "status", v); res(out1, "N-FORB", "forbidden_touch", v2);
    ck(!strcmp(v, "REJECTED") && atoi(v2) > 0, "4c-forbidden-path-rejected");
    res(out1, "N-FORB", "domain_ok", v); res(out1, "N-FORB", "assertion_deletes", v2);
    ck(!strcmp(v, "1") && !strcmp(v2, "0"), "4d-forbidden-fires-only-its-rule");
    res(out1, "N-FAIL", "status", v); res(out1, "N-FAIL", "rc", v2);
    ck(!strcmp(v, "AGENT_FAIL") && !strcmp(v2, "3"), "6-nonzero-exit-is-agent-fail");
    res(out1, "N-NOCH", "status", v); res(out1, "N-NOCH", "files_changed", v2);
    ck(!strcmp(v, "NO_CHANGE") && !strcmp(v2, "0"), "7-no-change");
    {   char *av[] = {toolbin, "patch", "N-OUT", "--out", out1, 0}; int rc = run(home, av, 20, buf, sizeof buf);
        char want[4500];
        cx_fmt(want, sizeof want, "%s/N-OUT/patch.diff", out1);
        ck(rc == 3 && has(buf, want), "2c-patch-command-marks-rejected");
        av[2] = "N-OK"; rc = run(home, av, 20, buf, sizeof buf);
        cx_fmt(want, sizeof want, "%s/N-OK/patch.diff", out1);
        ck(rc == 0 && has(buf, want), "2d-patch-command-prints-path"); }
    {   char *av[] = {toolbin, "status", "--out", out1, 0}; int rc = run(home, av, 20, buf, sizeof buf);
        ck(rc == 0 && has(buf, "FLEET\tOK=1\tNO_CHANGE=1\tTIMEOUT=0\tAGENT_FAIL=1\tREJECTED=4"), "status-summary"); }

    /* (5) timeout kills the whole group */
    {   char *av[] = {toolbin, "run", "--nodes", "N-SLEEP", "--timeout-s", "2", "--agent", stubbin, "--root", origin, "--out", out2,
                      "--template", "tools/cursor-fleet-template.txt", 0};
        long a0 = sy_now_ms(); int rc = run(home, av, 55, buf, sizeof buf); long secs = (sy_now_ms() - a0) / 1000;
        res(out2, "N-SLEEP", "status", v);
        ck(rc == 1 && !strcmp(v, "TIMEOUT") && secs < 20, "5-timeout-status");
        cx_fmt(p, sizeof p, "%s/N-SLEEP/repo/gc.pid", out2);
        {   size_t n = 0; char *t = cx_read(p, &n); int pid = t ? atoi(t) : 0, k, gone = 0; free(t);
            for (k = 0; k < 20 && pid > 0; k++) { if (!alive(pid)) { gone = 1; break; } sy_sleep_ms(100); }
            ck(pid > 0 && gone, "5b-process-group-gone"); } }

    /* (10) two nodes overlap with --max 2; a missing id is refused */
    {   char *av[] = {toolbin, "run", "--nodes", "N-SLOW1,N-SLOW2", "--max", "2", "--agent", stubbin, "--root", origin, "--out", out3,
                      "--template", "tools/cursor-fleet-template.txt", 0};
        char s1[4096], e1[4096], s2[4096], e2[4096];
        int rc = run(home, av, 55, buf, sizeof buf);
        res(out3, "N-SLOW1", "start_ms", s1); res(out3, "N-SLOW1", "end_ms", e1);
        res(out3, "N-SLOW2", "start_ms", s2); res(out3, "N-SLOW2", "end_ms", e2);
        ck(rc == 0 && atol(s2) < atol(e1) && atol(s1) < atol(e2) && atol(s1) > 0, "10-max-2-runs-two-nodes-overlapped"); }
    {   char *av[] = {toolbin, "run", "--nodes", "N-NOCH,N-NOPE", "--agent", stubbin, "--root", origin, "--out", out4, "--template", "tools/cursor-fleet-template.txt", 0};
        int rc = run(home, av, 20, buf, sizeof buf);
        cx_fmt(p, sizeof p, "%s/N-NOCH", out4);
        ck(rc == 2 && has(buf, "cursor-fleet: unknown node") && sy_exists(p) != 1, "10b-missing-node-id-refused-before-anything"); }

    /* (8) unfinished dep refused; (9) dry-run writes the prompt only */
    {   char *av[] = {toolbin, "run", "--nodes", "N-BLOCK", "--agent", stubbin, "--root", origin, "--out", out4, "--template", "tools/cursor-fleet-template.txt", 0};
        int rc = run(home, av, 20, buf, sizeof buf);
        cx_fmt(p, sizeof p, "%s/N-BLOCK", out4);
        ck(rc == 2 && has(buf, "cursor-fleet: node N-BLOCK refused: dep DEP1 is TODO") && sy_exists(p) != 1, "8-unfinished-dep-refused"); }
    {   char *av[] = {toolbin, "run", "--nodes", "N-OK", "--dry-run", "--agent", stubbin, "--root", origin, "--out", out4, "--template", "tools/cursor-fleet-template.txt", 0};
        int rc = run(home, av, 20, buf, sizeof buf); char pp[4500]; size_t n = 0; char *t;
        cx_fmt(pp, sizeof pp, "%s/N-OK/prompt.txt", out4); t = cx_read(pp, &n);
        ck(rc == 0 && has(buf, "DRYRUN\tN-OK") && t && has(t, "GOALTEXT-make-the-change") && has(t, "src/**") && has(t, "CTXTEXT-read-a") && has(t, "12. ") && !has(t, "{"), "9-dry-run-writes-prompt");
        free(t);
        cx_fmt(pp, sizeof pp, "%s/N-OK/repo", out4);
        {   char rp[4500]; cx_fmt(rp, sizeof rp, "%s/N-OK/result.tsv", out4);
            ck(sy_exists(pp) != 1 && sy_exists(rp) != 1, "9b-dry-run-runs-nothing"); } }

    /* (11) the shared origin is untouched */
    {   char *s[] = {"git", "status", "--porcelain=v1", 0}; char hb[128]; char *h[] = {"git", "rev-parse", "HEAD", 0};
        run(origin, s, 30, after, sizeof after); run(origin, h, 30, hb, sizeof hb); (void)tx_copy(after + strlen(after), (long)(sizeof after - strlen(after)), hb, (long)strlen(hb));
        ck(!strcmp(before, after), "11-origin-untouched"); }

    /* cx_rmtree refuses a tree holding .git: park the fixture under the temp dir instead */
    {   char dst[4500], pd[4500]; char *mk[] = {"mkdir", "-p", pd, 0}; char *mv[] = {"mv", work, dst, 0};
        if (cx_fmt(pd, sizeof pd, "%s/cursor-fleet-check-parked", sy_tmpdir()) || cx_fmt(dst, sizeof dst, "%s/%d", pd, (int)getpid()) || run(home, mk, 20, 0, 0) || run(home, mv, 20, 0, 0))
            fprintf(stderr, "check-cursor-fleet: could not park %s\n", work); }
    printf("CHECK_CURSOR_FLEET\tfailed=%d\tseconds=%ld\n", failed, (sy_now_ms() - t0) / 1000);
    return failed ? 1 : 0;
}
