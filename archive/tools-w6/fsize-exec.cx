/* Linux x86_64 test launcher: real kernel SIGXFSZ ignore and RLIMIT_FSIZE.
 * Bundled signal() is in-process only, so it cannot impose this condition. */
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 return 77;
#else
 if(argc<3)return 2;unsigned long limit=0;
 for(const char *p=argv[1];*p;p++){if(*p<'0'||*p>'9'||limit>100000000)return 2;limit=limit*10+*p-'0';}
 if(!limit)return 2;
 unsigned long action[4]={1,0,0,0},limits[2]={limit,limit};
 if(__syscall6(13,25,(long)action,0,8,0)||__syscall6(160,1,(long)limits,0,0,0))return 77;
 execvp(argv[2],argv+2);return 126;
#endif
}
