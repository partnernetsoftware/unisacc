/* ROOT PRODUCT LIMIT_LAUNCHER NEW_ABS_OUT; Linux x86_64 output contract. */
#pragma unisa use cxlib.netpack
static void save(const char *p,const void *s,size_t n){FILE *f=fopen(p,"wx");if(!f||fwrite(s,1,n,f)!=n||fclose(f))exit(2);}
static int sentinel(const char *p){size_t n;char *s=cx_read(p,&n);int ok=s&&n==9&&!memcmp(s,"KEEP-OLD\n",9);free(s);return ok;}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN output-file-cases requires Linux x86_64\n",stderr);return 3;
#endif
 if(geteuid()==0){fputs("NOT_RUN output permission checks require a non-root user\n",stderr);return 3;}
 if(argc!=5||argv[4][0]!='/'||mkdir(argv[4],0700))return 2;
 char input[4400],target[4400],old[4400],bound[4400],log[4400],why[1024];
 { if (cx_fmt(input,sizeof input,"%s/input.c",argv[4])) { fprintf(stderr, "output-file-cases: text too long for input\n"); exit(2); } }{ if (cx_fmt(old,sizeof old,"%s/original",argv[4])) { fprintf(stderr, "output-file-cases: text too long for old\n"); exit(2); } }{ if (cx_fmt(bound,sizeof bound,"%s/tools/bound",argv[1])) { fprintf(stderr, "output-file-cases: text too long for bound\n"); exit(2); } }
 const char *src="int main(void){return 7;}\n";save(input,src,strlen(src));save(old,"KEEP-OLD\n",9);
 int failures=0;char *ev[]={"UNISACC_RUN_CACHE=0",0};
 for(int i=0;i<10;i++){
  { if (cx_fmt(target,sizeof target,"%s/case-%d",argv[4],i)) { fprintf(stderr, "output-file-cases: text too long for target\n"); exit(2); } }
  char parent[4400];parent[0]=0;
  if(i==7){char leaf[241];memset(leaf,'x',240);leaf[240]=0;{ if (cx_fmt(target,sizeof target,"%s/%s",argv[4],leaf)) { fprintf(stderr, "output-file-cases: text too long for target\n"); exit(2); } }}
  if(i==8){
   { if (cx_fmt(parent,sizeof parent,"%s/readonly-parent",argv[4])) { fprintf(stderr, "output-file-cases: text too long for parent\n"); exit(2); } }if(mkdir(parent,0700))return 2;
   { if (cx_fmt(target,sizeof target,"%s/existing",parent)) { fprintf(stderr, "output-file-cases: text too long for target\n"); exit(2); } }save(target,"KEEP-OLD\n",9);if(chmod(parent,0500))return 2;
  }
  if(i==9){save(target,"KEEP-OLD\n",9);if(chmod(target,0400))return 2;}
  if(i==1)save(target,"KEEP-OLD\n",9);
  if(i==3&&symlink("case-2",target))return 2;
  if(i==6&&__syscall6(86,(long)old,(long)target,0,0,0))return 2; /* Linux x86_64 link */
  char *dest=i==4?"/dev/null":i==5?"/dev/full":target;
  char *limited[]={bound,"8",argv[3],"1024","sh",argv[2],input,"-o",dest,0};
  char *normal[]={bound,"8","sh",argv[2],input,"-o",dest,0};np_result r={0};
  int tr=np_run(i<2?limited:normal,argv[1],ev,10,&r,why,sizeof why);
  { if (cx_fmt(log,sizeof log,"%s/%d.stdout",argv[4],i)) { fprintf(stderr, "output-file-cases: text too long for log\n"); exit(2); } }save(log,r.out,r.outn);
  { if (cx_fmt(log,sizeof log,"%s/%d.stderr",argv[4],i)) { fprintf(stderr, "output-file-cases: text too long for log\n"); exit(2); } }save(log,r.err,r.errn);
  int ok=!tr&&!r.outn;struct stat st;
  if(i<2||i==5)ok=ok&&r.rc==1&&r.err&&strstr(r.err,"short output write");
  else if(i==8)ok=ok&&r.rc==1&&r.err&&strstr(r.err,"cannot open output")&&sentinel(target);
  else ok=ok&&!r.rc&&!r.errn;
  if(i==0){errno=0;ok=ok&&lstat(target,&st)<0&&errno==ENOENT;}
  if(i==1)ok=ok&&sentinel(target);
  if(i==3)ok=ok&&!lstat(target,&st)&&S_ISLNK(st.st_mode);
  if(i==6)ok=ok&&sentinel(old);
  if(i==4||i==5)ok=ok&&!lstat(dest,&st)&&S_ISCHR(st.st_mode);
  if(i==7||i==9)ok=ok&&!lstat(target,&st)&&S_ISREG(st.st_mode)&&(st.st_mode&0100)&&st.st_size>1024;
  if(parent[0]&&chmod(parent,0700))return 2;
  printf("%s\toutput.%d\trc=%d\ttransport=%d\n",ok?"PASS":"FAIL",i,r.rc,tr);if(!ok)failures++;np_free(&r);
 }
 { if (cx_fmt(target,sizeof target,"%s/case-2",argv[4])) { fprintf(stderr, "output-file-cases: text too long for target\n"); exit(2); } }char *run[]={bound,"5",target,0};np_result r={0};int tr=np_run(run,argv[1],0,7,&r,why,sizeof why);
 int ok=!tr&&r.rc==7&&!r.outn&&!r.errn;printf("%s\toutput.image-exec7\trc=%d\ttransport=%d\n",ok?"PASS":"FAIL",r.rc,tr);if(!ok)failures++;np_free(&r);
 DIR *d=opendir(argv[4]);if(!d)return 2;struct dirent *e;ok=1;while((e=readdir(d)))if(strstr(e->d_name,".unisacc-"))ok=0;closedir(d);
 printf("%s\toutput.no-staging-residue\n",ok?"PASS":"FAIL");if(!ok)failures++;
 printf("OUTPUT_FILES\tassertions=12\tfailed=%d\n",failures);return failures?1:0;
}
