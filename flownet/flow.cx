/* flownet/flow.cx -- the flow layer of flownet (plans/m4-flownet-cx-module.md W2): a run of a consumer's flows asks
   the nets questions; this unit answers them and keeps the books.
     ask    key values -> the net's answer.  The key must fit the net's domain exactly (arity, every value in its field),
            otherwise the ask is refused by name -- never answered from anywhere else.  Drive "built" (the default)
            answers by the integer net and books a hit; drive "gold" answers from the gold table and books a gold
            fallback (a reference mode: a run that books any gold fallback fails the trace check).
     phase  asks are booked per (phase, net); the phases are the contract's.
     gate   an answer outside the legal set the consumer pins for that point is a named refusal.
     trace  the (phase, net, hits, gold fallbacks) rows of the run; check: every hit net is a contract net and no net
            fell back to gold (m4 flows._check_trace).
   Internal unit; the public face is flownet/api.cx. */

void fnx_fail(const char *msg);
int fnn_find(const char *name);
int fnn_nfields(int i);
const char *fnn_field(int i, int f);
int fnn_encode(int i, int nk, const char *const *key, int *bad);
int fnn_predict(int i, int key);
int fnn_gold(int i, int key);
const char *fnn_class(int i, int c);
int fnc_nphases(void);
const char *fnc_phase(int i);
int fnc_phase_find(const char *s);
int fnc_nnets(void);
const char *fnc_net(int i);
int fnc_find(const char *net);

#define FNF_MAXP 32
#define FNF_MAXN 32

static int drive_gold;                         /* 0 built, 1 gold */
static int curphase = -1;
static long hits[FNF_MAXP][FNF_MAXN], golds[FNF_MAXP][FNF_MAXN];
static long nasks;

void fnf_reset(void) {
    int p, n;
    for (p = 0; p < FNF_MAXP; p++) for (n = 0; n < FNF_MAXN; n++) { hits[p][n] = 0; golds[p][n] = 0; }
    curphase = -1; nasks = 0;
}

int fnf_drive(const char *mode) {
    char m[160];
    if (!strcmp(mode, "built")) { drive_gold = 0; return 0; }
    if (!strcmp(mode, "gold")) { drive_gold = 1; return 0; }
    snprintf(m, sizeof m, "drive %.60s: want built or gold", mode);
    fnx_fail(m);
    return -1;
}

int fnf_phase(const char *name) {
    char m[200]; int p = fnc_phase_find(name);
    if (p < 0) { snprintf(m, sizeof m, "phase %.80s is not one of the contract's phases", name); fnx_fail(m); return -1; }
    curphase = p;
    return 0;
}

const char *fnf_ask(const char *net, int nk, const char *const *key) {
    char m[512]; int i, c, k, bad, ci;
    if (curphase < 0) { snprintf(m, sizeof m, "ask %.60s before any phase", net); fnx_fail(m); return 0; }
    if ((ci = fnc_find(net)) < 0 || (i = fnn_find(net)) < 0) {
        snprintf(m, sizeof m, "ask: %.60s is not a contract net", net); fnx_fail(m); return 0;
    }
    if ((k = fnn_encode(i, nk, key, &bad)) < 0) {
        if (bad < 0) snprintf(m, sizeof m, "ask %s: arity %d != %d", net, nk, fnn_nfields(i));
        else snprintf(m, sizeof m, "ask %s: field %s got '%.80s', not in its domain", net, fnn_field(i, bad), key[bad] ? key[bad] : "(null)");
        fnx_fail(m);
        return 0;
    }
    nasks++;
    if (drive_gold) { golds[curphase][ci]++; c = fnn_gold(i, k); }
    else { hits[curphase][ci]++; c = fnn_predict(i, k); }
    return fnn_class(i, c);
}

/* ANSWER must be one of LEGAL (space-separated); WHAT names the point for the refusal */
int fnf_gate(const char *net, const char *answer, const char *legal, const char *what) {
    char m[512]; const char *p = legal; size_t k = strlen(answer);
    while (*p) {
        const char *e = strchr(p, ' ');
        size_t n = e ? (size_t)(e - p) : strlen(p);
        if (n == k && !strncmp(p, answer, k)) return 0;
        if (!e) break;
        p = e + 1;
    }
    snprintf(m, sizeof m, "%s: net %s answered '%.60s', not a legal answer here (legal: %.200s)", what, net, answer, legal);
    fnx_fail(m);
    return -1;
}

/* the K-th nonzero trace row, phases in contract order and nets in name order (strcmp); 0 past the end */
int fnf_trace_row(int want, const char **phase, const char **net, long *h, long *g) {
    int p, k = 0, n, used[FNF_MAXN];
    for (p = 0; p < fnc_nphases(); p++) {
        int nn = fnc_nnets(), done;
        for (n = 0; n < nn; n++) used[n] = 0;
        for (done = 0; done < nn; done++) {
            int best = -1;
            for (n = 0; n < nn; n++)
                if (!used[n] && (best < 0 || strcmp(fnc_net(n), fnc_net(best)) < 0)) best = n;
            used[best] = 1;
            if (!hits[p][best] && !golds[p][best]) continue;
            if (k++ == want) {
                *phase = fnc_phase(p); *net = fnc_net(best); *h = hits[p][best]; *g = golds[p][best];
                return 1;
            }
        }
    }
    return 0;
}

/* m4 flows._check_trace: hits only on contract nets (ask refuses any other), and no gold fallback anywhere */
int fnf_trace_check(void) {
    int p, n; char m[256];
    for (p = 0; p < fnc_nphases(); p++)
        for (n = 0; n < fnc_nnets(); n++)
            if (golds[p][n]) {
                snprintf(m, sizeof m, "trace: net %s fell back to gold %ld time(s) in phase %s", fnc_net(n), golds[p][n], fnc_phase(p));
                fnx_fail(m);
                return -1;
            }
    return 0;
}

long fnf_asks(void) { return nasks; }
