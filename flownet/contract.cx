/* flownet/contract.cx -- the contract layer of flownet (plans/m4-flownet-cx-module.md W2).
   DIR/contract.tsv says which nets exist and what each one is for; it is data, so another consumer brings its own:
     net       NAME...                  every net, in order (each has NAME.gold.tsv + NAME.net.tsv beside the contract)
     flow      FLOW NET...              a flow and the nets that decide it (wired: they decide output or refusal)
     reserved  NET...                   built and accepted, never on a decision path
     observed  NET...                   asked as a side channel; the answers do not reach the output
     choice    NET INPUT FORM FORM...   a net input with more than one legal answer (the first is the gold one);
                                        the consumer must write different output per form, not only accept/refuse
     phase     NAME...                  the bookkeeping phases a run may book its asks to, in order
   check_contract: every net falls in exactly one of wired / reserved / observed; a choice names a net and at least
   two distinct forms.  Errors: fnx_fail("PATH[:LINE]: reason").  Internal unit; the public face is flownet/api.cx. */

void fnx_fail(const char *msg);

#define FNC_MAX 32
#define FNC_NAME 64
#define FNC_MAXCH 32

static char cnet[FNC_MAX][FNC_NAME]; static int ncnet;
static char cflow[FNC_MAX][FNC_NAME]; static int ncflow;
static int crole[FNC_MAX];            /* per net: 0 unassigned, 1 wired, 2 reserved, 3 observed (more = overlap) */
static int cnroles[FNC_MAX];
static int cflowof[FNC_MAX];          /* per net: the flow that wires it, -1 */
static int crank[FNC_MAX], nrank;     /* per net: the order in which a flow/reserved/observed row named it */
static char cphase[FNC_MAX][FNC_NAME]; static int ncphase;
static char chnet[FNC_MAXCH][FNC_NAME], chin[FNC_MAXCH][FNC_NAME], chforms[FNC_MAXCH][512]; static int nch;

static void cfail(const char *path, int line, const char *why) {
    char m[512];
    if (line > 0) snprintf(m, sizeof m, "%s:%d: %s", path, line, why);
    else snprintf(m, sizeof m, "%s: %s", path, why);
    fnx_fail(m);
}

static int cindex(const char *s) {
    int i;
    for (i = 0; i < ncnet; i++) if (!strcmp(cnet[i], s)) return i;
    return -1;
}

static int okname(const char *s) { return *s && strlen(s) < FNC_NAME && !strchr(s, '/') && !strchr(s, ' '); }

int fnc_load(const char *dir) {
    char path[1024], *b, *p; size_t n = 0; struct stat st; int line = 0, i, k;
    ncnet = ncflow = ncphase = nch = nrank = 0;
    for (i = 0; i < FNC_MAX; i++) { crole[i] = 0; cnroles[i] = 0; cflowof[i] = -1; }
    snprintf(path, sizeof path, "%s/contract.tsv", dir);
    if (stat(path, &st) != 0) { cfail(path, 0, "cannot read (missing?)"); return -1; }
    if (!S_ISREG(st.st_mode)) { cfail(path, 0, "not a regular file"); return -1; }
    if (!(b = cx_read(path, &n))) { cfail(path, 0, "cannot read"); return -1; }
    if (memchr(b, 0, n)) { free(b); cfail(path, 0, "NUL byte in table"); return -1; }
    if (!n || b[n - 1] != '\n') { free(b); cfail(path, 0, "empty, or no final newline"); return -1; }
    for (p = b; *p; ) {
        char *nl = strchr(p, '\n'), *f[FNC_MAX + 4], *s; int k2 = 0;
        line++; *nl = 0;
        if (!*p || *p == '#') { p = nl + 1; continue; }
        for (s = p;;) {
            if (k2 == FNC_MAX + 4) { free(b); cfail(path, line, "too many fields"); return -1; }
            f[k2++] = s;
            if (!(s = strchr(s, '\t'))) break;
            *s++ = 0;
        }
        for (k = 0; k < k2; k++) if (!okname(f[k]) && strcmp(f[0], "choice")) { free(b); cfail(path, line, "empty or bad name"); return -1; }
        if (!strcmp(f[0], "net")) {
            if (ncnet) { free(b); cfail(path, line, "a second net row"); return -1; }
            for (k = 1; k < k2; k++) {
                if (k - 1 == FNC_MAX) { free(b); cfail(path, line, "too many nets"); return -1; }
                for (i = 0; i < ncnet; i++) if (!strcmp(cnet[i], f[k])) { free(b); cfail(path, line, "net named twice"); return -1; }
                strcpy(cnet[ncnet++], f[k]);
            }
            if (!ncnet) { free(b); cfail(path, line, "no nets"); return -1; }
        } else if (!strcmp(f[0], "flow") || !strcmp(f[0], "reserved") || !strcmp(f[0], "observed")) {
            int role = f[0][0] == 'f' ? 1 : f[0][0] == 'r' ? 2 : 3, from = 1;
            if (!ncnet) { free(b); cfail(path, line, "the net row must come first"); return -1; }
            if (role == 1) {
                if (k2 < 3) { free(b); cfail(path, line, "a flow needs a name and its nets"); return -1; }
                if (ncflow == FNC_MAX) { free(b); cfail(path, line, "too many flows"); return -1; }
                for (i = 0; i < ncflow; i++) if (!strcmp(cflow[i], f[1])) { free(b); cfail(path, line, "flow named twice"); return -1; }
                strcpy(cflow[ncflow++], f[1]);
                from = 2;
            }
            for (k = from; k < k2; k++) {
                if ((i = cindex(f[k])) < 0) { free(b); cfail(path, line, "names a net that the net row does not list"); return -1; }
                crole[i] = role; cnroles[i]++; crank[i] = nrank++;
                if (role == 1) cflowof[i] = ncflow - 1;
            }
        } else if (!strcmp(f[0], "choice")) {
            char *forms = chforms[nch];
            if (k2 < 5) { free(b); cfail(path, line, "a choice needs a net, an input and at least two forms"); return -1; }
            if (nch == FNC_MAXCH) { free(b); cfail(path, line, "too many choices"); return -1; }
            if (cindex(f[1]) < 0) { free(b); cfail(path, line, "choice names an unknown net"); return -1; }
            for (k = 1; k < k2; k++) if (!okname(f[k])) { free(b); cfail(path, line, "empty or bad name"); return -1; }
            for (k = 3; k < k2; k++)
                for (i = 3; i < k; i++) if (!strcmp(f[i], f[k])) { free(b); cfail(path, line, "choice collapsed: a form named twice"); return -1; }
            strcpy(chnet[nch], f[1]); strcpy(chin[nch], f[2]);
            forms[0] = 0;
            for (k = 3; k < k2; k++) {
                if (strlen(forms) + strlen(f[k]) + 2 > 512) { free(b); cfail(path, line, "choice too long"); return -1; }
                if (k > 3) strcat(forms, " ");
                strcat(forms, f[k]);
            }
            nch++;
        } else if (!strcmp(f[0], "phase")) {
            for (k = 1; k < k2; k++) {
                if (ncphase == FNC_MAX) { free(b); cfail(path, line, "too many phases"); return -1; }
                strcpy(cphase[ncphase++], f[k]);
            }
        } else { free(b); cfail(path, line, "unknown row kind"); return -1; }
        p = nl + 1;
    }
    free(b);
    /* check_contract: an exact partition of the nets into wired / reserved / observed */
    if (!ncnet) { cfail(path, 0, "no net row"); return -1; }
    if (!ncphase) { cfail(path, 0, "no phase row"); return -1; }
    for (i = 0; i < ncnet; i++) {
        char m[160];
        if (cnroles[i] != 1) {
            snprintf(m, sizeof m, "nets not partitioned exactly: %s is in %d of wired/reserved/observed", cnet[i], cnroles[i]);
            cfail(path, 0, m); return -1;
        }
    }
    return 0;
}

int fnc_nnets(void) { return ncnet; }
const char *fnc_net(int i) { return i >= 0 && i < ncnet ? cnet[i] : 0; }
int fnc_find(const char *net) { return cindex(net); }
/* "wired", "reserved", "observed" */
const char *fnc_role(int i) {
    if (i < 0 || i >= ncnet) return 0;
    return crole[i] == 1 ? "wired" : crole[i] == 2 ? "reserved" : "observed";
}
const char *fnc_flowof(int i) { return i >= 0 && i < ncnet && cflowof[i] >= 0 ? cflow[cflowof[i]] : 0; }
/* the nets of ROLE ("wired", "reserved", "observed") joined by commas, in the order the contract names them */
int fnc_list(const char *role, char *out, int cap) {
    int r = !strcmp(role, "wired") ? 1 : !strcmp(role, "reserved") ? 2 : !strcmp(role, "observed") ? 3 : 0, k, i, n = 0;
    out[0] = 0;
    if (!r) return -1;
    for (k = 0; k < nrank; k++)
        for (i = 0; i < ncnet; i++)
            if (crole[i] == r && crank[i] == k) {
                if ((int)(strlen(out) + strlen(cnet[i]) + 2) > cap) return -1;
                if (n++) strcat(out, ",");
                strcat(out, cnet[i]);
            }
    return n;
}
int fnc_nflows(void) { return ncflow; }
const char *fnc_flow(int i) { return i >= 0 && i < ncflow ? cflow[i] : 0; }
int fnc_nphases(void) { return ncphase; }
const char *fnc_phase(int i) { return i >= 0 && i < ncphase ? cphase[i] : 0; }
int fnc_phase_find(const char *s) {
    int i;
    for (i = 0; i < ncphase; i++) if (!strcmp(cphase[i], s)) return i;
    return -1;
}
/* the legal forms of NET on INPUT as "f1 f2 ...", or 0 when the contract names no choice there */
const char *fnc_choice(const char *net, const char *in) {
    int i;
    for (i = 0; i < nch; i++) if (!strcmp(chnet[i], net) && !strcmp(chin[i], in)) return chforms[i];
    return 0;
}
