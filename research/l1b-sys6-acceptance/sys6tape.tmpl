; L1b sys6 raw-tape probe (template; accept.c fills @NR_WRITE@ and @MAP_ANON@ per target).
; A: dynamic syscall, sources permuted (number in r3, buf from r0).  B: r7 itself is the buf source.
; C: number in r5, all six sources reversed.  D: named mmap with permuted sources; the page is
; written and read back.  Each case writes 'tape X' and checks the count; exit 0 = all four.
_start:
  call main
  jump __main_ret
main:
  .frame 8
  store64 [r7+0], r6
  mov r6, r7
  .frame 64
  imm r0, 116
  .st [r7+0], r0, 1
  imm r0, 97
  .st [r7+1], r0, 1
  imm r0, 112
  .st [r7+2], r0, 1
  imm r0, 101
  .st [r7+3], r0, 1
  imm r0, 32
  .st [r7+4], r0, 1
  imm r0, 65
  .st [r7+5], r0, 1
  imm r0, 10
  .st [r7+6], r0, 1
  imm r3, @NR_WRITE@
  imm r5, 1
  mov r0, r7
  imm r1, 7
  imm r4, 23130
  imm r2, -1
  .sys6 syscall, r3, r5, r0, r1, r4, r2
  imm r1, 7
  ne r2, r0, r1
  jumpz r2, __ok_A
  imm r0, 11
  .exit r0
__ok_A:
  imm r0, 116
  .st [r7+0], r0, 1
  imm r0, 97
  .st [r7+1], r0, 1
  imm r0, 112
  .st [r7+2], r0, 1
  imm r0, 101
  .st [r7+3], r0, 1
  imm r0, 32
  .st [r7+4], r0, 1
  imm r0, 66
  .st [r7+5], r0, 1
  imm r0, 10
  .st [r7+6], r0, 1
  imm r0, @NR_WRITE@
  imm r1, 1
  imm r2, 7
  imm r3, 0
  imm r4, -1
  imm r5, 23130
  .sys6 syscall, r0, r1, r7, r2, r3, r4
  imm r1, 7
  ne r2, r0, r1
  jumpz r2, __ok_B
  imm r0, 12
  .exit r0
__ok_B:
  imm r0, 116
  .st [r7+0], r0, 1
  imm r0, 97
  .st [r7+1], r0, 1
  imm r0, 112
  .st [r7+2], r0, 1
  imm r0, 101
  .st [r7+3], r0, 1
  imm r0, 32
  .st [r7+4], r0, 1
  imm r0, 67
  .st [r7+5], r0, 1
  imm r0, 10
  .st [r7+6], r0, 1
  imm r5, @NR_WRITE@
  imm r4, 1
  mov r3, r7
  imm r2, 7
  imm r1, 23130
  imm r0, -1
  .sys6 syscall, r5, r4, r3, r2, r1, r0
  imm r1, 7
  ne r2, r0, r1
  jumpz r2, __ok_C
  imm r0, 13
  .exit r0
__ok_C:
  imm r2, 0
  imm r4, 4096
  imm r0, 3
  imm r1, @MAP_ANON@
  imm r3, -1
  imm r5, 0
  .sys6 mmap, r2, r4, r0, r1, r3, r5
  mov r5, r0
  imm r1, 109
  .st [r5+0], r1, 1
  .ld r2, [r5+0], 1
  ne r3, r1, r2
  jumpz r3, __ok_mm
  imm r0, 14
  .exit r0
__ok_mm:
  imm r0, 116
  .st [r7+0], r0, 1
  imm r0, 97
  .st [r7+1], r0, 1
  imm r0, 112
  .st [r7+2], r0, 1
  imm r0, 101
  .st [r7+3], r0, 1
  imm r0, 32
  .st [r7+4], r0, 1
  imm r0, 68
  .st [r7+5], r0, 1
  imm r0, 10
  .st [r7+6], r0, 1
  imm r0, @NR_WRITE@
  imm r1, 1
  imm r2, 7
  .sys6 syscall, r0, r1, r7, r2, r3, r4
  imm r1, 7
  ne r2, r0, r1
  jumpz r2, __ok_D
  imm r0, 15
  .exit r0
__ok_D:
  imm r0, 0
  mov r7, r6
  load64 r6, [r7+0]
  .frame -8
  ret
__init:
  ret
__main_ret:
  .exit r0
