+                F(held_own, sizeof held_own, "%s", f[2]);
+                F(held_pt, sizeof held_pt, "%s", f[4]);
+            }
+            F(rsp, sizeof rsp, "OK\tacquired\t%s\towner=%s\texpires_in_s=120\n", f[1], f[2]);
+        } else if (!strncmp(buf, "lock-release\t", 13)) {
+            F(rsp, sizeof rsp, "ERR\tdenied\tmock-release-refused\n");
+        } else if (!strcmp(buf, "lock-list")) {
