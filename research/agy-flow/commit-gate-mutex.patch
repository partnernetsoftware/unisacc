+    if (!src || !src[0] || sy_sha256_hex((const unsigned char *)src, (long)strlen(src), hex) != 0) return -1;
+    int prev_ovf = ovf;
+    F(out_name, cap, "commit-wt-%.16s", hex);
+    return ovf != prev_ovf ? -1 : 0;
+}
