diff --git a/tools/check-notes-evidence.cx b/tools/check-notes-evidence.cx
new file mode 100644
index 0000000..925a5de
--- /dev/null
+++ b/tools/check-notes-evidence.cx
@@ -0,0 +1,277 @@
+/* Tool self-check: tools/check-notes-evidence.cx. Exercises tools/notes-evidence.cx against real
+ * release/evidence/{0.1.1,0.1.2} receipts, release/notes-0.1.2.md, and synthetic positive/negative
+ * fixtures in $TMPDIR without creating symlinks or writing into the checkout. Check: notes-evidence. */
+#pragma unisa use sys.io
+#pragma unisa use sys.fs
+#pragma unisa use sys.proc
+#pragma unisa use sys.env
+#pragma unisa use sys.posix
+#pragma unisa use text.fmt
+#pragma unisa use mem.heap
+
+static int cne_passed, cne_failed;
+
+static long cne_cstr_len(const char *s) {
+    long n = 0;
+    if (!s) return 0;
+    while (s[n]) n++;
+    return n;
+}
+
+static int cne_has(const char *hay, long hlen, const char *needle) {
+    long nlen = cne_cstr_len(needle), i, j;
+    if (nlen == 0) return 1;
+    if (!hay || nlen > hlen) return 0;
+    for (i = 0; i + nlen <= hlen; i++) {
+        int ok = 1;
+        for (j = 0; j < nlen; j++) {
+            if (hay[i + j] != needle[j]) { ok = 0; break; }
+        }
+        if (ok) return 1;
+    }
+    return 0;
+}
+
+static void cne_ck(int cond, const char *name, const char *diag) {
+    if (cond) {
+        cne_passed++;
+        sy_printf("PASS\tnotes-evidence.%s\n", name);
+    } else {
+        cne_failed++;
+        sy_printf("FAIL\tnotes-evidence.%s\t%s\n", name, diag ? diag : "-");
+    }
+}
+
+static int cne_read_product(char *out, size_t cap) {
+    int64_t sz = 0;
+    unsigned char *ubuf = 0;
+    const char *buf;
+    long pos = 0, len;
+    if (sy_read_file("tools/devsvc-repo.tsv", &ubuf, &sz, 1 << 20) != 0 || !ubuf || sz <= 0) {
+        if (ubuf) mm_free(ubuf);
+        return 1;
+    }
+    buf = (const char *)ubuf;
+    len = (long)sz;
+    while (pos < len) {
+        long eol = pos;
+        while (eol < len && buf[eol] != '\n' && buf[eol] != '\r') eol++;
+        if (eol - pos > 8 &&
+            buf[pos] == 'p' && buf[pos + 1] == 'r' && buf[pos + 2] == 'o' && buf[pos + 3] == 'd' &&
+            buf[pos + 4] == 'u' && buf[pos + 5] == 'c' && buf[pos + 6] == 't' && buf[pos + 7] == '\t') {
+            long vstart = pos + 8, vend = vstart;
+            while (vend < eol && buf[vend] != '\t') vend++;
+            if (vend > vstart && !cx_fmt(out, cap, "%.*s", (int)(vend - vstart), buf + vstart)) {
+                mm_free(ubuf);
+                return 0;
+            }
+        }
+        pos = eol;
+        if (pos < len && buf[pos] == '\r') pos++;
+        if (pos < len && buf[pos] == '\n') pos++;
+    }
+    mm_free(ubuf);
+    return 1;
+}
+
+static int cne_run_tool(const char *prod, const char *tmp_dir, const char *tag,
+                        char *const *args, int nargs,
+                        char *out_buf, size_t out_cap, long *out_len) {
+    char *argv[20];
+    char of[512];
+    int i, n = 0, fd, prc, rc = -1;
+    sy_spawn_t sp;
+    sy_exit_t ex;
+    unsigned char *ub = 0;
+    int64_t usz = 0;
+    out_buf[0] = 0;
+    *out_len = 0;
+    if (nargs + 6 >= 20 || cx_fmt(of, sizeof of, "%s/%s.out", tmp_dir, tag)) return -1;
+    argv[n++] = "sh";
+    argv[n++] = (char *)prod;
+    argv[n++] = "tools/notes-evidence.cx";
+    argv[n++] = "--";
+    for (i = 0; i < nargs; i++) argv[n++] = args[i];
+    argv[n] = 0;
+    (void)sy_unlink(of);
+    fd = sy_open_new(of, 0600);
+    if (fd < 0) return -1;
+    sy_spawn_init(&sp);
+    sp.argv = argv;
+    sp.deadline_ms = 20000;
+    sp.in_fd = SY_STDIO_NULL;
+    sp.out_fd = fd;
+    sp.err_fd = fd;
+    prc = sy_proc_run(&sp, &ex);
+    (void)sy_close(fd);
+    if (prc == 0 && !ex.timed_out) rc = sy_exit_code(&ex);
+    if (sy_read_file(of, &ub, &usz, 1 << 20) == 0 && ub) {
+        long cp = (long)usz < (long)(out_cap - 1) ? (long)usz : (long)(out_cap - 1);
+        for (i = 0; i < cp; i++) out_buf[i] = (char)ub[i];
+        out_buf[cp] = 0;
+        *out_len = cp;
+        mm_free(ub);
+    }
+    (void)sy_unlink(of);
+    return rc;
+}
+
+static int cne_write_file(const char *dir, const char *name, const char *body) {
+    char p[512];
+    if (cx_fmt(p, sizeof p, "%s/%s", dir, name)) return 1;
+    return sy_write_atomic(p, body, (size_t)cne_cstr_len(body), 0600);
+}
+
+int main(void) {
+    char prod[256], tmp[256], syn[320], neg[320], out[16384], notes_p[384];
+    long olen = 0;
+    int rc;
+    if (cne_read_product(prod, sizeof prod) != 0) {
+        sy_printf("FAIL\tnotes-evidence.read-product\nCHECK_NOTES_EVIDENCE\tpassed=0\tfailed=1\n");
+        return 1;
+    }
+    if (cx_fmt(tmp, sizeof tmp, "%s/cne-%d", sy_tmpdir(), sy_pid()) ||
+        cx_fmt(syn, sizeof syn, "%s/syn", tmp) ||
+        cx_fmt(neg, sizeof neg, "%s/neg", tmp) ||
+        sy_mkdir_all(syn, 0700) != 0 || sy_mkdir_all(neg, 0700) != 0) {
+        sy_printf("FAIL\tnotes-evidence.tmpdir\nCHECK_NOTES_EVIDENCE\tpassed=0\tfailed=1\n");
+        return 1;
+    }
+
+    /* 1. Real 0.1.1 evidence extraction without any cxroot symlink */
+    {   char *a[] = {"--evidence-dir", "release/evidence/0.1.1"};
+        rc = cne_run_tool(prod, tmp, "r011", a, 2, out, sizeof out, &olen);
+        cne_ck(rc == 0 &&
+               cne_has(out, olen, "APE_SUMMARY\tsha=d83537aef92eb55ed94d81081b0cff27d146a0ef0d83b2a544b989c15701c3eb\tbytes=8992558") &&
+               cne_has(out, olen, "  - `lnx/x86_64` (`fixedpoint/g2/lnx-x86_64/entry.elf`): `4542533b550c284189f91de4000f434be74baec4790128aee218c7a9b85402ed` (`1954382` bytes, `SAME`)") &&
+               cne_has(out, olen, "  - `win/arm64` (`fixedpoint/g2/win-arm64/slice-win-arm64`): `7f29174a5232c63a0906496d03bc844b4b2e41bc3944b77ad06bbb6f96f72ee1` (`4708352` bytes, `SAME`)"),
+               "real-011-extract", out);
+    }
+
+    /* 2. Real 0.1.2 evidence extraction + verbatim --check-notes against release/notes-0.1.2.md */
+    {   char *a[] = {"--evidence-dir", "release/evidence/0.1.2", "--check-notes", "release/notes-0.1.2.md"};
+        rc = cne_run_tool(prod, tmp, "r012", a, 4, out, sizeof out, &olen);
+        cne_ck(rc == 0 &&
+               cne_has(out, olen, "APE_SUMMARY\tsha=e31c413a1287a935c62df9e5c9820f91d7d760ea7e3c2c1480f99f8fc6a7c269\tbytes=8992558") &&
+               cne_has(out, olen, "  - `osx/arm64` (`fixedpoint/g2/osx-arm64/slice-osx-arm64`): `b10fc08cc1436fd57653f245e99547eb87453bff46093b8a1fbaf43d4e0cf3a5` (`4326370` bytes, `SAME`)") &&
+               cne_has(out, olen, "NOTES_CHECK\tOK\tmatched=7\tfile=release/notes-0.1.2.md"),
+               "real-012-extract-and-check-notes", out);
+    }
+
+    /* 3. Synthetic full fixture with chain-dir times + notes check */
+    {   const char *ape_txt =
+            "unisacc-next.com\tape-final/unisacc-next.com\tsha=1111111111111111111111111111111111111111111111111111111111111111\tbytes=123456\n";
+        const char *fp_txt =
+            "target\tg2_path\tg2_sha256\tg3_path\tg3_sha256\tbytes\tverdict\n"
+            "lnx/x86_64\tg2/l64\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tg3/l64\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\t100\tSAME\n"
+            "lnx/arm64\tg2/la64\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tg3/la64\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\t200\tSAME\n"
+            "osx/x86_64\tg2/o64\tcccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\tg3/o64\tcccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\t300\tSAME\n"
+            "osx/arm64\tg2/oa64\tdddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\tg3/oa64\tdddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\t400\tSAME\n"
+            "win/x86_64\tg2/w64\teeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\tg3/w64\teeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\t500\tSAME\n"
+            "win/arm64\tg2/wa64\tffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\tg3/wa64\tffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\t600\tSAME\n";
+        const char *own_txt = "OWNER\t1795607168\tpid=1\n";
+        const char *ext_txt = "EXIT\t1795608794\trc=0\n";
+        const char *notes_ok =
+            "# Synthetic Notes\n"
+            "APE_SUMMARY\tsha=1111111111111111111111111111111111111111111111111111111111111111\tbytes=123456\n"
+            "  - `lnx/x86_64` (`g2/l64`): `aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa` (`100` bytes, `SAME`)\n"
+            "  - `lnx/arm64` (`g2/la64`): `bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb` (`200` bytes, `SAME`)\n"
+            "  - `osx/x86_64` (`g2/o64`): `cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc` (`300` bytes, `SAME`)\n"
+            "  - `osx/arm64` (`g2/oa64`): `dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd` (`400` bytes, `SAME`)\n"
+            "  - `win/x86_64` (`g2/w64`): `eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee` (`500` bytes, `SAME`)\n"
+            "  - `win/arm64` (`g2/wa64`): `ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff` (`600` bytes, `SAME`)\n";
+        int w = cne_write_file(syn, "ape-receipt.txt", ape_txt) |
+                cne_write_file(syn, "fixedpoint-6targets.tsv", fp_txt) |
+                cne_write_file(syn, "owner.tsv", own_txt) |
+                cne_write_file(syn, "exit.tsv", ext_txt) |
+                cne_write_file(syn, "notes.md", notes_ok);
+        if (!w && !cx_fmt(notes_p, sizeof notes_p, "%s/notes.md", syn)) {
+            char *a[] = {"--evidence-dir", syn, "--chain-dir", syn, "--check-notes", notes_p};
+            rc = cne_run_tool(prod, tmp, "syn", a, 6, out, sizeof out, &olen);
+            cne_ck(rc == 0 &&
+                   cne_has(out, olen, "APE_SUMMARY\tsha=1111111111111111111111111111111111111111111111111111111111111111\tbytes=123456") &&
+                   cne_has(out, olen, "CHAIN_TIMES\tT1=") &&
+                   cne_has(out, olen, "(1795607168)") &&
+                   cne_has(out, olen, "(1795608794)") &&
+                   cne_has(out, olen, "\tdelta_s=1626\tdelta_min=27.1") &&
+                   cne_has(out, olen, "NOTES_CHECK\tOK\tmatched=7"),
+                   "synth-full-with-chain-times", out);
+        } else {
+            cne_ck(0, "synth-full-with-chain-times", "fixture-write-failed");
+        }
+
+        /* 4. Negative: missing --evidence-dir -> rc=2 usage */
+        {   char *a[] = {"--chain-dir", syn};
+            rc = cne_run_tool(prod, tmp, "neg-miss", a, 2, out, sizeof out, &olen);
+            cne_ck(rc == 2 && cne_has(out, olen, "NOTES_EVIDENCE\tREFUSE\treason=usage"),
+                   "neg-missing-evidence-dir-rc2", out);
+        }
+
+        /* 5. Negative: unknown option -> rc=2 usage */
+        {   char *a[] = {"--evidence-dir", syn, "--bogus"};
+            rc = cne_run_tool(prod, tmp, "neg-unk", a, 3, out, sizeof out, &olen);
+            cne_ck(rc == 2 && cne_has(out, olen, "NOTES_EVIDENCE\tREFUSE\treason=usage\targ=--bogus"),
+                   "neg-unknown-flag-rc2", out);
+        }
+
+        /* 6. Negative: missing ape-receipt.txt -> rc=1 */
+        {   char *a[] = {"--evidence-dir", neg};
+            rc = cne_run_tool(prod, tmp, "neg-noape", a, 2, out, sizeof out, &olen);
+            cne_ck(rc == 1 && cne_has(out, olen, "NOTES_EVIDENCE\tREFUSE\treason=ape-receipt-invalid"),
+                   "neg-missing-ape-receipt-rc1", out);
+        }
+
+        /* 7. Negative: corrupted ape sha (truncated) -> rc=1 */
+        (void)cne_write_file(neg, "ape-receipt.txt", "unisacc-next.com\tape-final/unisacc-next.com\tsha=deadbeef\tbytes=123\n");
+        (void)cne_write_file(neg, "fixedpoint-6targets.tsv", fp_txt);
+        {   char *a[] = {"--evidence-dir", neg};
+            rc = cne_run_tool(prod, tmp, "neg-badsha", a, 2, out, sizeof out, &olen);
+            cne_ck(rc == 1 && cne_has(out, olen, "NOTES_EVIDENCE\tREFUSE\treason=ape-receipt-invalid"),
+                   "neg-corrupt-ape-sha-rc1", out);
+        }
+
+        /* 8. Negative: fixedpoint verdict DIFF -> rc=1 */
+        (void)cne_write_file(neg, "ape-receipt.txt", ape_txt);
+        (void)cne_write_file(neg, "fixedpoint-6targets.tsv",
+            "target\tg2_path\tg2_sha256\tg3_path\tg3_sha256\tbytes\tverdict\n"
+            "lnx/x86_64\tg2/l64\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tg3/l64\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\t100\tDIFF\n");
+        {   char *a[] = {"--evidence-dir", neg};
+            rc = cne_run_tool(prod, tmp, "neg-fpdiff", a, 2, out, sizeof out, &olen);
+            cne_ck(rc == 1 && cne_has(out, olen, "NOTES_EVIDENCE\tREFUSE\treason=fixedpoint-invalid"),
+                   "neg-fixedpoint-diff-verdict-rc1", out);
+        }
+
+        /* 9. Negative: chain times backwards (T2 < T1) -> rc=1 */
+        (void)cne_write_file(neg, "fixedpoint-6targets.tsv", fp_txt);
+        (void)cne_write_file(neg, "owner.tsv", "OWNER\t1795608794\tpid=1\n");
+        (void)cne_write_file(neg, "exit.tsv", "EXIT\t1795607168\trc=0\n");
+        {   char *a[] = {"--evidence-dir", neg, "--chain-dir", neg};
+            rc = cne_run_tool(prod, tmp, "neg-time", a, 4, out, sizeof out, &olen);
+            cne_ck(rc == 1 && cne_has(out, olen, "NOTES_EVIDENCE\tREFUSE\treason=chain-times-invalid"),
+                   "neg-chain-times-backwards-rc1", out);
+        }
+
+        /* 10. Negative: notes tampered by 1 byte in APE_SUMMARY (all 6 fixedpoint intact) -> rc=1 notes-mismatch */
+        (void)cne_write_file(neg, "notes-bad.md",
+            "# Tampered\n"
+            "APE_SUMMARY\tsha=1111111111111111111111111111111111111111111111111111111111111112\tbytes=123456\n"
+            "  - `lnx/x86_64` (`g2/l64`): `aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa` (`100` bytes, `SAME`)\n"
+            "  - `lnx/arm64` (`g2/la64`): `bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb` (`200` bytes, `SAME`)\n"
+            "  - `osx/x86_64` (`g2/o64`): `cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc` (`300` bytes, `SAME`)\n"
+            "  - `osx/arm64` (`g2/oa64`): `dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd` (`400` bytes, `SAME`)\n"
+            "  - `win/x86_64` (`g2/w64`): `eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee` (`500` bytes, `SAME`)\n"
+            "  - `win/arm64` (`g2/wa64`): `ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff` (`600` bytes, `SAME`)\n");
+        if (!cx_fmt(notes_p, sizeof notes_p, "%s/notes-bad.md", neg)) {
+            char *a[] = {"--evidence-dir", syn, "--check-notes", notes_p};
+            rc = cne_run_tool(prod, tmp, "neg-notes", a, 4, out, sizeof out, &olen);
+            cne_ck(rc == 1 && cne_has(out, olen, "NOTES_EVIDENCE\tREFUSE\treason=notes-mismatch\titem=APE_SUMMARY"),
+                   "neg-notes-tampered-1byte-rc1", out);
+        } else {
+            cne_ck(0, "neg-notes-tampered-1byte-rc1", "path-overflow");
+        }
+    }
+
+    (void)sy_remove_all(tmp);
+    sy_printf("CHECK_NOTES_EVIDENCE\tpassed=%d\tfailed=%d\n", cne_passed, cne_failed);
+    return cne_failed ? 1 : 0;
+}
diff --git a/tools/notes-evidence.cx b/tools/notes-evidence.cx
new file mode 100644
index 0000000..9f1923c
--- /dev/null
+++ b/tools/notes-evidence.cx
@@ -0,0 +1,362 @@
+/* tools/notes-evidence.cx -- extract and verify release notes evidence lines from chain/release receipts.
+ *
+ *   sh ./unisacc.com tools/notes-evidence.cx -- --evidence-dir DIR [--chain-dir DIR] [--check-notes FILE]
+ *
+ * Reads DIR/ape-receipt.txt and DIR/fixedpoint-6targets.tsv (required, strict validation) and
+ * optionally CH_DIR/owner.tsv + CH_DIR/exit.tsv (required when --chain-dir is given or either file
+ * exists in DIR).  With --check-notes FILE, proves that the extracted APE_SUMMARY line and all six
+ * fixedpoint lines appear verbatim in FILE.
+ *
+ * Exit codes: 0 ok, 1 missing/invalid/mismatched evidence, 2 usage error.
+ * Check: tools/check-notes-evidence.cx. */
+#pragma unisa use sys.io
+#pragma unisa use sys.fs
+#pragma unisa use sys.time
+#pragma unisa use text.fmt
+#pragma unisa use mem.heap
+
+#define NE_MAX_LINE 1024
+#define NE_MAX_TARGETS 6
+
+static int ne_streq_n(const char *a, const char *b, long n) {
+    long i;
+    for (i = 0; i < n; i++) if (a[i] != b[i]) return 0;
+    return 1;
+}
+
+static long ne_cstr_len(const char *s) {
+    long n = 0;
+    if (!s) return 0;
+    while (s[n]) n++;
+    return n;
+}
+
+static int ne_streq_cstr(const char *a, const char *b) {
+    long la = ne_cstr_len(a), lb = ne_cstr_len(b);
+    return la == lb && ne_streq_n(a, b, la);
+}
+
+static int ne_is_hex64(const char *s, long n) {
+    long i;
+    if (n != 64) return 0;
+    for (i = 0; i < 64; i++) {
+        char c = s[i];
+        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 0;
+    }
+    return 1;
+}
+
+static int ne_parse_pos_long(const char *s, long n, long *out) {
+    long i, v = 0;
+    if (n <= 0 || n > 18) return 1;
+    for (i = 0; i < n; i++) {
+        if (s[i] < '0' || s[i] > '9') return 1;
+        v = v * 10 + (s[i] - '0');
+    }
+    if (v <= 0) return 1;
+    *out = v;
+    return 0;
+}
+
+static long ne_find_line_end(const char *buf, long len, long pos) {
+    long i = pos;
+    while (i < len && buf[i] != '\n' && buf[i] != '\r') i++;
+    return i;
+}
+
+static long ne_next_line(const char *buf, long len, long eol) {
+    long p = eol;
+    if (p < len && buf[p] == '\r') p++;
+    if (p < len && buf[p] == '\n') p++;
+    return p;
+}
+
+static int ne_get_field(const char *line, long llen, int col, const char **out_p, long *out_n) {
+    long i = 0, start = 0;
+    int c = 0;
+    while (i <= llen) {
+        if (i == llen || line[i] == '\t') {
+            if (c == col) {
+                *out_p = line + start;
+                *out_n = i - start;
+                return 0;
+            }
+            c++;
+            start = i + 1;
+        }
+        i++;
+    }
+    return 1;
+}
+
+static int ne_mem_contains(const char *hay, long hlen, const char *needle, long nlen) {
+    long i, j;
+    if (nlen == 0) return 1;
+    if (nlen > hlen) return 0;
+    for (i = 0; i + nlen <= hlen; i++) {
+        int ok = 1;
+        for (j = 0; j < nlen; j++) {
+            if (hay[i + j] != needle[j]) { ok = 0; break; }
+        }
+        if (ok) return 1;
+    }
+    return 0;
+}
+
+static int ne_extract_ape(const char *dir, char *out_line, size_t out_cap) {
+    char path[1024];
+    int64_t sz = 0;
+    unsigned char *ubuf = 0;
+    const char *buf;
+    long pos = 0, len;
+    int found = 0;
+    out_line[0] = 0;
+    if (cx_fmt(path, sizeof path, "%s/ape-receipt.txt", dir)) {
+        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=ape-receipt-invalid\tdetail=path-too-long\n");
+        return 1;
+    }
+    if (sy_read_file(path, &ubuf, &sz, 16 << 20) != 0 || !ubuf || sz <= 0) {
+        if (ubuf) mm_free(ubuf);
+        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=ape-receipt-invalid\tpath=%s\n", path);
+        return 1;
+    }
+    buf = (const char *)ubuf;
+    len = (long)sz;
+    while (pos < len) {
+        long eol = ne_find_line_end(buf, len, pos);
+        long llen = eol - pos;
+        const char *f0, *f2, *f3;
+        long n0, n2, n3, bytes_v = 0;
+        if (ne_get_field(buf + pos, llen, 0, &f0, &n0) == 0 &&
+            n0 == 16 && ne_streq_n(f0, "unisacc-next.com", 16)) {
+            if (ne_get_field(buf + pos, llen, 2, &f2, &n2) == 0 &&
+                ne_get_field(buf + pos, llen, 3, &f3, &n3) == 0 &&
+                n2 == 68 && ne_streq_n(f2, "sha=", 4) && ne_is_hex64(f2 + 4, 64) &&
+                n3 > 6 && ne_streq_n(f3, "bytes=", 6) && ne_parse_pos_long(f3 + 6, n3 - 6, &bytes_v) == 0) {
+                if (cx_fmt(out_line, out_cap, "APE_SUMMARY\t%.*s\t%.*s", (int)n2, f2, (int)n3, f3)) {
+                    mm_free(ubuf);
+                    sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=ape-receipt-invalid\tdetail=line-overflow\n");
+                    return 1;
+                }
+                found++;
+            } else {
+                mm_free(ubuf);
+                sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=ape-receipt-invalid\tpath=%s\tdetail=malformed-fields\n", path);
+                return 1;
+            }
+        }
+        pos = ne_next_line(buf, len, eol);
+    }
+    mm_free(ubuf);
+    if (found != 1) {
+        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=ape-receipt-invalid\tpath=%s\tfound=%d\n", path, found);
+        return 1;
+    }
+    return 0;
+}
+
+static int ne_extract_fixedpoint(const char *dir, char out_lines[NE_MAX_TARGETS][NE_MAX_LINE], int *out_cnt) {
+    char path[1024];
+    char seen_tgts[NE_MAX_TARGETS][64];
+    int64_t sz = 0;
+    unsigned char *ubuf = 0;
+    const char *buf;
+    long pos = 0, len;
+    int cnt = 0;
+    *out_cnt = 0;
+    if (cx_fmt(path, sizeof path, "%s/fixedpoint-6targets.tsv", dir)) {
+        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=fixedpoint-invalid\tdetail=path-too-long\n");
+        return 1;
+    }
+    if (sy_read_file(path, &ubuf, &sz, 16 << 20) != 0 || !ubuf || sz <= 0) {
+        if (ubuf) mm_free(ubuf);
+        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=fixedpoint-invalid\tpath=%s\n", path);
+        return 1;
+    }
+    buf = (const char *)ubuf;
+    len = (long)sz;
+    while (pos < len) {
+        long eol = ne_find_line_end(buf, len, pos);
+        long llen = eol - pos;
+        if (llen > 0 && buf[pos] != '#') {
+            const char *tgt, *g2p, *g2s, *g3s, *bytes, *ver;
+            long nt, np, ns, n3s, nb, nv, bytes_v = 0;
+            if (ne_get_field(buf + pos, llen, 0, &tgt, &nt) == 0 &&
+                nt == 6 && ne_streq_n(tgt, "target", 6)) {
+                pos = ne_next_line(buf, len, eol);
+                continue;
+            }
+            if (cnt >= NE_MAX_TARGETS ||
+                ne_get_field(buf + pos, llen, 0, &tgt, &nt) != 0 || nt <= 0 || nt >= 64 ||
+                ne_get_field(buf + pos, llen, 1, &g2p, &np) != 0 || np <= 0 ||
+                ne_get_field(buf + pos, llen, 2, &g2s, &ns) != 0 || !ne_is_hex64(g2s, ns) ||
+                ne_get_field(buf + pos, llen, 4, &g3s, &n3s) != 0 || !ne_is_hex64(g3s, n3s) ||
+                !ne_streq_n(g2s, g3s, 64) ||
+                ne_get_field(buf + pos, llen, 5, &bytes, &nb) != 0 || ne_parse_pos_long(bytes, nb, &bytes_v) != 0 ||
+                ne_get_field(buf + pos, llen, 6, &ver, &nv) != 0 || nv != 4 || !ne_streq_n(ver, "SAME", 4)) {
+                mm_free(ubuf);
+                sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=fixedpoint-invalid\tpath=%s\trow=%d\n", path, cnt + 1);
+                return 1;
+            }
+            {   int j;
+                for (j = 0; j < cnt; j++) {
+                    if (ne_cstr_len(seen_tgts[j]) == nt && ne_streq_n(seen_tgts[j], tgt, nt)) {
+                        mm_free(ubuf);
+                        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=fixedpoint-invalid\tpath=%s\tdetail=duplicate-target\n", path);
+                        return 1;
+                    }
+                }
+                if (cx_fmt(seen_tgts[cnt], sizeof seen_tgts[cnt], "%.*s", (int)nt, tgt) ||
+                    cx_fmt(out_lines[cnt], NE_MAX_LINE, "  - `%.*s` (`%.*s`): `%.*s` (`%.*s` bytes, `%.*s`)",
+                           (int)nt, tgt, (int)np, g2p, (int)ns, g2s, (int)nb, bytes, (int)nv, ver)) {
+                    mm_free(ubuf);
+                    sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=fixedpoint-invalid\tdetail=line-overflow\n");
+                    return 1;
+                }
+                cnt++;
+            }
+        }
+        pos = ne_next_line(buf, len, eol);
+    }
+    mm_free(ubuf);
+    if (cnt != NE_MAX_TARGETS) {
+        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=fixedpoint-invalid\tpath=%s\tcount=%d\n", path, cnt);
+        return 1;
+    }
+    *out_cnt = cnt;
+    return 0;
+}
+
+static int ne_read_epoch_from(const char *path, const char *prefix, long plen, long *out_epoch) {
+    int64_t sz = 0;
+    unsigned char *ubuf = 0;
+    const char *buf;
+    long pos = 0, len;
+    int found = 0;
+    if (sy_read_file(path, &ubuf, &sz, 16 << 20) != 0 || !ubuf || sz <= 0) {
+        if (ubuf) mm_free(ubuf);
+        return 1;
+    }
+    buf = (const char *)ubuf;
+    len = (long)sz;
+    while (pos < len) {
+        long eol = ne_find_line_end(buf, len, pos);
+        long llen = eol - pos;
+        const char *f0, *f1;
+        long n0, n1, ep = 0;
+        if (ne_get_field(buf + pos, llen, 0, &f0, &n0) == 0 &&
+            n0 == plen && ne_streq_n(f0, prefix, plen)) {
+            if (ne_get_field(buf + pos, llen, 1, &f1, &n1) == 0 &&
+                ne_parse_pos_long(f1, n1, &ep) == 0) {
+                *out_epoch = ep;
+                found = 1;
+                break;
+            }
+            mm_free(ubuf);
+            return 1;
+        }
+        pos = ne_next_line(buf, len, eol);
+    }
+    mm_free(ubuf);
+    return found ? 0 : 1;
+}
+
+static int ne_extract_times(const char *dir, int required, char *out_line, size_t out_cap) {
+    char p_own[1024], p_exit[1024], t1s[64], t2s[64];
+    int has_own, has_exit;
+    long t1 = -1, t2 = -1, ds, dmin10;
+    out_line[0] = 0;
+    if (cx_fmt(p_own, sizeof p_own, "%s/owner.tsv", dir) ||
+        cx_fmt(p_exit, sizeof p_exit, "%s/exit.tsv", dir)) {
+        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=chain-times-invalid\tdetail=path-too-long\n");
+        return 1;
+    }
+    has_own = sy_exists(p_own) == 1;
+    has_exit = sy_exists(p_exit) == 1;
+    if (!required && !has_own && !has_exit) return 0;
+    if (!has_own || !has_exit ||
+        ne_read_epoch_from(p_own, "OWNER", 5, &t1) != 0 ||
+        ne_read_epoch_from(p_exit, "EXIT", 4, &t2) != 0 ||
+        t2 < t1) {
+        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=chain-times-invalid\tdir=%s\tt1=%ld\tt2=%ld\n", dir, t1, t2);
+        return 1;
+    }
+    if (sy_local_fmt(t1s, sizeof t1s, "%Y-%m-%d %H:%M:%S %z", t1) <= 0 ||
+        sy_local_fmt(t2s, sizeof t2s, "%Y-%m-%d %H:%M:%S %z", t2) <= 0) {
+        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=chain-times-invalid\tdetail=time-format\n");
+        return 1;
+    }
+    ds = t2 - t1;
+    dmin10 = (ds * 10 + 30) / 60;
+    if (cx_fmt(out_line, out_cap, "CHAIN_TIMES\tT1=%s (%ld)\tT2=%s (%ld)\tdelta_s=%ld\tdelta_min=%ld.%ld",
+               t1s, t1, t2s, t2, ds, dmin10 / 10, dmin10 % 10)) {
+        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=chain-times-invalid\tdetail=line-overflow\n");
+        return 1;
+    }
+    return 0;
+}
+
+static int ne_verify_notes(const char *notes_path, const char *ape_line,
+                           char fp_lines[NE_MAX_TARGETS][NE_MAX_LINE], int fp_cnt) {
+    int64_t sz = 0;
+    unsigned char *ubuf = 0;
+    const char *buf;
+    int i, matched = 0;
+    if (sy_read_file(notes_path, &ubuf, &sz, 16 << 20) != 0 || !ubuf || sz <= 0) {
+        if (ubuf) mm_free(ubuf);
+        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=notes-unreadable\tfile=%s\n", notes_path);
+        return 1;
+    }
+    buf = (const char *)ubuf;
+    if (!ne_mem_contains(buf, (long)sz, ape_line, ne_cstr_len(ape_line))) {
+        mm_free(ubuf);
+        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=notes-mismatch\titem=APE_SUMMARY\tfile=%s\n", notes_path);
+        return 1;
+    }
+    matched++;
+    for (i = 0; i < fp_cnt; i++) {
+        if (!ne_mem_contains(buf, (long)sz, fp_lines[i], ne_cstr_len(fp_lines[i]))) {
+            mm_free(ubuf);
+            sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=notes-mismatch\titem=fixedpoint-%d\tfile=%s\n", i + 1, notes_path);
+            return 1;
+        }
+        matched++;
+    }
+    mm_free(ubuf);
+    sy_printf("NOTES_CHECK\tOK\tmatched=%d\tfile=%s\n", matched, notes_path);
+    return 0;
+}
+
+int main(int argc, char **argv) {
+    const char *ev_dir = 0, *ch_dir = 0, *notes_path = 0;
+    char ape_line[NE_MAX_LINE], times_line[NE_MAX_LINE];
+    char fp_lines[NE_MAX_TARGETS][NE_MAX_LINE];
+    int i, fp_cnt = 0;
+    for (i = 1; i < argc; i++) {
+        if (ne_streq_cstr(argv[i], "--evidence-dir") && i + 1 < argc) {
+            if (ev_dir) { sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=usage\tdetail=duplicate-evidence-dir\n"); return 2; }
+            ev_dir = argv[++i];
+        } else if (ne_streq_cstr(argv[i], "--chain-dir") && i + 1 < argc) {
+            if (ch_dir) { sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=usage\tdetail=duplicate-chain-dir\n"); return 2; }
+            ch_dir = argv[++i];
+        } else if (ne_streq_cstr(argv[i], "--check-notes") && i + 1 < argc) {
+            if (notes_path) { sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=usage\tdetail=duplicate-check-notes\n"); return 2; }
+            notes_path = argv[++i];
+        } else {
+            sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=usage\targ=%s\n", argv[i]);
+            return 2;
+        }
+    }
+    if (!ev_dir || !ev_dir[0]) {
+        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=usage\tneed=--evidence-dir\n");
+        return 2;
+    }
+    if (ne_extract_ape(ev_dir, ape_line, sizeof ape_line) != 0) return 1;
+    if (ne_extract_fixedpoint(ev_dir, fp_lines, &fp_cnt) != 0) return 1;
+    if (ne_extract_times(ch_dir ? ch_dir : ev_dir, ch_dir != 0, times_line, sizeof times_line) != 0) return 1;
+    sy_printf("%s\n", ape_line);
+    for (i = 0; i < fp_cnt; i++) sy_printf("%s\n", fp_lines[i]);
+    if (times_line[0]) sy_printf("%s\n", times_line);
+    if (notes_path && ne_verify_notes(notes_path, ape_line, fp_lines, fp_cnt) != 0) return 1;
+    return 0;
+}
