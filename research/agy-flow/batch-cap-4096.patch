+static int run_proc(char **av, const char *cwd, int secs, int *rc_out, char *obuf, size_t ocap) {
+    np_result r = {0};
+    char why[256];
+    int tr = np_run(av, cwd, 0, secs, &r, why, sizeof why);
+    *rc_out = tr ? 124 : r.rc;
+    if (obuf && ocap > 0) {
+        obuf[0] = 0;
+        size_t n = 0;
+        if (r.out && r.outn > 0) {
+            size_t c = r.outn < ocap - 1 ? r.outn : ocap - 1;
+            mm_copy(obuf, (long)ocap, r.out, (long)c);
+            n += c;
+        }
+        if (r.err && r.errn > 0 && n + 1 < ocap) {
+            size_t c = r.errn < ocap - 1 - n ? r.errn : ocap - 1 - n;
+            mm_copy(obuf + n, (long)(ocap - n), r.err, (long)c);
+            n += c;
+        }
+        obuf[n] = 0;
+    }
+    np_free(&r);
+    return tr;
+}
