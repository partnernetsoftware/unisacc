+static int copy_reg(const char *src, const char *dst, int mode) {
+    size_t n = 0;
+    char *b = cx_read(src, &n);
+    if (!b) return -1;
+    int rc = sy_write_atomic(dst, b, (long)n, mode);
+    free(b);
+    return rc;
+}
