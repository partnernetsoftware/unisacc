+    cx_fmt(dst, sizeof dst, "%s/tools/bound", dir);
+    (void)symlink(p, dst);
+
+    /* Copy entry tools as regular files so realpath(__FILE__) resolves inside dir (not g_root) */
+    const char *tcopies[] = {"tools/affected.cx", "tools/all-waves.cx", "tests/run.cx", "tests/run-batch.cx", 0};
+    for (int i = 0; tcopies[i]; i++) {
+        cx_fmt(p, sizeof p, "%s/%s", g_root, tcopies[i]);
+        cx_fmt(dst, sizeof dst, "%s/%s", dir, tcopies[i]);
