+
+    /* Symlink repo directories needed by run.cx / affected.cx / all-waves.cx */
+    const char *links[] = {"cx", "ext", "include", "src", "exec", "seed", "cxroot.tsv", "unisacc.com", 0};
+    for (int i = 0; links[i]; i++) {
+        cx_fmt(p, sizeof p, "%s/%s", g_root, links[i]);
