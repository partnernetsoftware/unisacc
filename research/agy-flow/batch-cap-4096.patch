+    size_t bn = 0;
+    char *bt = synth_batches(nrows, &bn);
+    if (!bt) return -1;
+    cx_fmt(p, sizeof p, "%s/tests/batches.tsv", dir);
+    int wr1 = sy_write_atomic(p, bt, (long)bn, 0644);
