+/* tools/check-batch-cap.cx -- single-source 4096 batch/tool capacity consistency, behavior (2100/4000), and mutation proof.
+ *
+ *   sh ./unisacc.com tools/check-batch-cap.cx
+ *   last line: CHECK_BATCH_CAP<TAB>passed=P<TAB>failed=F
+ *
+ * Verifies:
+ *   (1) Single source of truth: exec/facts/limits.tsv and tools/cxlib/testplan.cx agree on
+ *       TP_BATCH_CAP = 4096 and TP_TOOL_SRC_CAP = 4096.
+ *   (2) Token-level traversal of all 11 batch/tool-source capacity consumers: every consumer
+ *       references TP_BATCH_CAP or TP_TOOL_SRC_CAP with zero independent 2048 literals.
+ *   (3) Mutation proof: mutating any one of the 11 consumers back to 2048 is caught (11/11 killed).
+ *   (4) Behavior proof at 2100 and 4000 synthetic batch rows (plus 4097 over-limit refusal):
+ *       tests/run.cx --list, tools/affected.cx, cxlib.s9sched (ss_steps_par), and tools/all-waves.cx. */
+#pragma unisa use sys.io
+#pragma unisa use sys.fs
+#pragma unisa use sys.posix
+#pragma unisa use sys.proc
+#pragma unisa use sys.env
+#pragma unisa use text.text
+#pragma unisa use mem.bytes
+#pragma unisa use mem.heap
+#pragma unisa use cxlib.netpack
+#pragma unisa use cxlib.chainargv
+#pragma unisa use cxlib.testplan
+#pragma unisa use cxlib.s9sched
+
+static int g_pass = 0;
+static int g_fail = 0;
+static char g_root[4096];
+
+static void bck(int ok, const char *name) {
+    if (ok) {
+        g_pass++;
+        sy_printf("PASS\tcheck-batch-cap.%s\n", name);
+    } else {
+        g_fail++;
+        sy_printf("FAIL\tcheck-batch-cap.%s\n", name);
+    }
+}
+
+static int tok_eq(void *a, int i, const char *s) { return ca_token_is(a, i, s); }
+
+/* Check `#define NAME VAL` via token stream. */
+static int has_macro_tok(void *a, const char *name, const char *val) {
+    int n = ca_token_count(a), hits = 0, ok = 0;
+    for (int i = 0; i + 3 < n; i++) {
+        if (tok_eq(a, i, "#") && tok_eq(a, i + 1, "define") && tok_eq(a, i + 2, name)) {
+            hits++;
+            if (tok_eq(a, i + 3, val)) ok++;
+        }
+    }
+    return hits == 1 && ok == 1;
+}
+
+/* Check `enum { ... NAME = VAL ... }` via token stream. */
+static int has_enum_tok(void *a, const char *name, const char *val) {
+    int n = ca_token_count(a), hits = 0, ok = 0;
+    for (int i = 0; i + 3 < n; i++) {
+        if (tok_eq(a, i, "enum") && tok_eq(a, i + 1, "{")) {
+            int end = ca_token_end(a, i + 1);
+            if (end < 0) continue;
+            for (int j = i + 2; j + 2 < end; j++) {
+                if (tok_eq(a, j, name) && tok_eq(a, j + 1, "=")) {
+                    hits++;
+                    if (tok_eq(a, j + 2, val)) ok++;
+                }
+            }
+        }
+    }
+    return hits == 1 && ok == 1;
+}
+
+/* Count exact token matches for IDENT[SYM] or IDENT == SYM or call arg SYM. */
+static int count_tok_pair(void *a, const char *t0, const char *t1, const char *t2) {
+    int n = ca_token_count(a), c = 0;
+    for (int i = 0; i + 2 < n; i++) {
+        if (tok_eq(a, i, t0) && tok_eq(a, i + 1, t1) && tok_eq(a, i + 2, t2)) c++;
+    }
+    return c;
+}
+
+static int count_tok(void *a, const char *t) {
+    int n = ca_token_count(a), c = 0;
+    for (int i = 0; i < n; i++) if (tok_eq(a, i, t)) c++;
+    return c;
+}
+
+/* Verify one consumer source text (id 0..10) against single-source TP_BATCH_CAP / TP_TOOL_SRC_CAP. */
+static int check_consumer_src(int id, const char *src) {
+    void *a = ca_tokens(src);
+    if (!a) return 0;
+    int ok = 0;
+    if (id == 0) {
+        /* tools/cxlib/testplan.cx: defines TP_BATCH_CAP=4096, TP_TOOL_SRC_CAP=4096, uses TP_BATCH_CAP in bf/source_present/3x tp_table, zero 2048 in tp_process */
+        int def_ok = has_enum_tok(a, "TP_BATCH_CAP", "4096") && has_enum_tok(a, "TP_TOOL_SRC_CAP", "4096");
+        int uses = count_tok(a, "TP_BATCH_CAP");
+        int old_alloc = count_tok_pair(a, "calloc", "(", "2048") + count_tok_pair(a, ",", "2048", ",");
+        ok = def_ok && uses >= 7 && old_alloc == 0;
+    } else if (id == 1) {
+        /* tools/affected.cx */
+        ok = has_macro_tok(a, "MAXBATCH", "TP_BATCH_CAP");
+    } else if (id == 2) {
+        /* tools/cxlib/s9sched.cx */
+        ok = has_macro_tok(a, "SS_MAX", "TP_BATCH_CAP");
+    } else if (id == 3) {
+        /* tools/all-waves.cx */
+        ok = count_tok_pair(a, "tier_ids", "[", "TP_BATCH_CAP") == 1 &&
+             count_tok_pair(a, "tier_count", "==", "TP_BATCH_CAP") == 1 &&
+             count_tok_pair(a, "tier_ids", "[", "2048") == 0 &&
+             count_tok_pair(a, "tier_count", "==", "2048") == 0;
+    } else if (id == 4) {
+        /* tools/osx-lane.cx */
+        ok = has_macro_tok(a, "OL_MAX", "TP_BATCH_CAP");
+    } else if (id == 5) {
+        /* tools/osx-sentinel.cx */
+        ok = count_tok_pair(a, "ids", "[", "TP_BATCH_CAP") == 1 &&
+             count_tok_pair(a, "count", "==", "TP_BATCH_CAP") == 1 &&
+             count_tok_pair(a, "count", ">", "TP_BATCH_CAP") == 1 &&
+             count_tok(a, "2048") == 0;
+    } else if (id == 6) {
+        /* tools/batch-packages-gen.cx */
+        ok = has_enum_tok(a, "MAXB", "TP_BATCH_CAP");
+    } else if (id == 7) {
+        /* tools/prerun-drive.cx */
+        ok = has_macro_tok(a, "PD_MAX_IDS", "TP_BATCH_CAP");
+    } else if (id == 8) {
+        /* tools/tool-index.cx */
+        ok = has_macro_tok(a, "MAXF", "TP_TOOL_SRC_CAP");
+    } else if (id == 9) {
+        /* tools/tlib-admit.cx */
+        ok = has_macro_tok(a, "MAXF", "TP_TOOL_SRC_CAP");
+    } else if (id == 10) {
+        /* tests/tools-compile.cx */
+        ok = count_tok_pair(a, "count", ">", "TP_TOOL_SRC_CAP") == 1;
+    }
+    ca_tokens_free(a);
+    return ok;
+}
+
+/* Replace all occurrences of NEEDLE in SRC with REPL in a freshly allocated buffer. */
+static char *mutate_replace(const char *src, const char *needle, const char *repl) {
+    size_t sl = strlen(src), nl = strlen(needle), rl = strlen(repl);
+    size_t cap = sl * 2 + 256, outn = 0;
+    char *out = (char *)mm_alloc((long)cap);
+    if (!out) return 0;
+    size_t i = 0;
+    while (i < sl) {
+        if (i + nl <= sl && memcmp(src + i, needle, nl) == 0) {
+            if (outn + rl + 1 >= cap) {
+                cap = (cap + rl) * 2;
+                out = (char *)mm_grow(out, (long)cap);
+                if (!out) return 0;
+            }
+            mm_copy(out + outn, (long)(cap - outn), repl, (long)rl);
+            outn += rl;
+            i += nl;
+        } else {
+            if (outn + 2 >= cap) {
+                cap *= 2;
+                out = (char *)mm_grow(out, (long)cap);
+                if (!out) return 0;
+            }
+            out[outn++] = src[i++];
+        }
+    }
+    out[outn] = 0;
+    return out;
+}
+
+/* Build synthetic N-row batches.tsv and 1-row coverage.tsv in memory or on disk. */
+static char *synth_batches(int nrows, size_t *out_len) {
+    size_t cap = (size_t)nrows * 256 + 512;
+    char *b = (char *)mm_alloc((long)cap);
+    if (!b) return 0;
+    size_t n = 0;
+    const char *hdr = "id\timplementation\tlayer\tsource\tmode\tplatform\tbudget_seconds\tmaterials\tentry\targs\tcoverage\texpect\theaders\ttier\n";
+    size_t hl = strlen(hdr);
+    mm_copy(b, (long)cap, hdr, (long)hl);
+    n = hl;
+    for (int i = 0; i < nrows; i++) {
+        char row[256];
+        int w = snprintf(row, sizeof row,
+                         "bcap-%04d\tIMPLEMENTED\tinterfaces\ttools/check-batch-cap.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/check-batch-cap.cx\t-\tinterfaces.bcap\trc0:CHECK_BATCH_CAP\tproduct\tcommit\n",
+                         i);
+        if (w <= 0 || n + (size_t)w + 1 >= cap) { mm_free(b); return 0; }
+        mm_copy(b + n, (long)(cap - n), row, (long)w);
+        n += (size_t)w;
+    }
+    b[n] = 0;
+    if (out_len) *out_len = n;
+    return b;
+}
