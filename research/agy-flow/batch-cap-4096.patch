+        bck(rc21 == 3, "s9sched-accepts-2100");
+        g_s9_want_n = 4000;
+        int rc40 = ss_steps_par(&ops, "/tmp", 1, 0, &ms);
+        bck(rc40 == 3, "s9sched-accepts-4000");
+        g_s9_want_n = 4097;
+        int rc41 = ss_steps_par(&ops, "/tmp", 1, 0, &ms);
+        bck(rc41 == 1, "s9sched-refuses-4097");
+    }
+
+    /* (4c) Real CLI subprocess behavior: run.cx --list, affected.cx, all-waves.cx at 2100 and 4000 */
+    char tmp[4096];
+    if (sy_mkdtemp("/tmp", "unisacc-session-bcap", tmp, sizeof tmp) == 0) {
+        int sizes[2] = {2100, 4000};
+        static char obuf[2 << 20];
+        for (int s = 0; s < 2; s++) {
+            int N = sizes[s];
+            char sdir[4200], sess[4300], want_b[64], want_a[64], tag[96];
+            cx_fmt(sdir, sizeof sdir, "%s/tree-%d", tmp, N);
+            cx_fmt(sess, sizeof sess, "%s/sess-%d", tmp, N);
+            int prep_ok = (write_synth_tree(sdir, sess, N) == 0);
+            cx_fmt(tag, sizeof tag, "synth-tree-%d", N);
+            bck(prep_ok, tag);
+            if (!prep_ok) continue;
+
+            /* tests/run.cx --list */
+            int rc = -1;
+            char *av_run[] = {"sh", "./unisacc.com", "tests/run.cx", "--", "--list", 0};
+            (void)run_proc(av_run, sdir, 30, &rc, obuf, sizeof obuf);
+            cx_fmt(want_b, sizeof want_b, "batches=%d\t", N);
+            cx_fmt(tag, sizeof tag, "run-list-%d", N);
+            int ok_r = (rc == 0 && strstr(obuf, want_b) != 0);
+            bck(ok_r, tag);
+            if (!ok_r) sy_printf("NOTE\t%s\trc=%d\tlen=%ld\thead=%.200s\n", tag, rc, (long)strlen(obuf), obuf);
+
+            /* tools/affected.cx --files tools/check-batch-cap.cx */
+            char *av_aff[] = {"sh", "./unisacc.com", "tools/affected.cx", "--", "--files", "tools/check-batch-cap.cx", 0};
+            (void)run_proc(av_aff, sdir, 30, &rc, obuf, sizeof obuf);
+            cx_fmt(want_a, sizeof want_a, "scanned=%d\t", N);
+            cx_fmt(tag, sizeof tag, "affected-scan-%d", N);
+            int ok_a = (rc == 0 && strstr(obuf, want_a) != 0);
+            bck(ok_a, tag);
+            if (!ok_a) sy_printf("NOTE\t%s\trc=%d\tlen=%ld\thead=%.200s\n", tag, rc, (long)strlen(obuf), obuf);
+
+            /* tools/all-waves.cx pending --tier commit */
+            char *av_wp[] = {"sh", "./unisacc.com", "tools/all-waves.cx", "--", "pending", sdir, sess, "--tier", "commit", 0};
+            int rc2 = -1;
+            (void)run_proc(av_wp, sdir, 30, &rc2, obuf, sizeof obuf);
+            cx_fmt(want_b, sizeof want_b, "PENDING_SUMMARY\tundecided=%d\t", N);
+            cx_fmt(tag, sizeof tag, "all-waves-pending-%d", N);
+            int ok_w = (rc2 == 0 && strstr(obuf, want_b) != 0 && strstr(obuf, "tier-limit") == 0);
+            bck(ok_w, tag);
+            if (!ok_w) sy_printf("NOTE\t%s\trc=%d\tlen=%ld\thead=%.200s\n", tag, rc2, (long)strlen(obuf), obuf);
+        }
+        char *rmv[] = {"rm", "-rf", tmp, 0};
+        int rrc = 0;
+        (void)run_proc(rmv, g_root, 10, &rrc, 0, 0);
+    } else {
+        bck(0, "mkdtemp-synth");
+    }
+
+    sy_printf("CHECK_BATCH_CAP\tpassed=%d\tfailed=%d\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
