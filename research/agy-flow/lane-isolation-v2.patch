+/* Count surviving processes whose pgid == lane_pgid or whose /proc/<pid>/cwd or open fd points inside lane_dir. */
+static int pd_count_lane_residue(const char *lane_dir, int lane_pgid) {
+    sy_dir_t pd;
+    int next, residue = 0;
+    long ldir_len = (lane_dir && lane_dir[0]) ? (long)strlen(lane_dir) : 0;
+    long self_pid = (long)sy_pid();
+    if (sy_dir_open(&pd, "/proc")) return 0;
+    while ((next = sy_dir_next(&pd)) == 1) {
+        long pid = 0;
+        int i, all_dig = 1;
+        for (i = 0; pd.name[i]; i++) {
+            if (pd.name[i] < '0' || pd.name[i] > '9') { all_dig = 0; break; }
+            pid = pid * 10 + (long)(pd.name[i] - '0');
+        }
+        if (!all_dig || pid <= 0 || pid == self_pid) continue;
+        if (lane_pgid > 0 && (int)sy_getpgid((int)pid) == lane_pgid) {
+            residue++;
+            continue;
+        }
+        if (ldir_len > 0) {
+            char lp[128], target[PD_PW];
+            long rn;
+            if (!cx_fmt(lp, sizeof lp, "/proc/%ld/cwd", pid)) {
+                rn = sy_readlink(lp, target, sizeof target - 1);
+                if (rn > 0) {
+                    target[rn] = 0;
+                    if (rn >= ldir_len && memcmp(target, lane_dir, (size_t)ldir_len) == 0 &&
+                        (rn == ldir_len || target[ldir_len] == '/')) {
+                        residue++;
+                        continue;
+                    }
+                }
+            }
+        }
+    }
+    sy_dir_close(&pd);
+    return residue;
+}
