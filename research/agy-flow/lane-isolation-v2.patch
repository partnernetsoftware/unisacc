+static int pd_cmd_analyze_isolation(const char *root, const char *batches_path, const char *out_path) {
+    char bpath[PD_PW];
+    unsigned char *raw = 0;
+    int64_t rn = 0, pos = 0;
+    size_t cap = 1 << 20, mp = 0;
+    char *out = 0;
+    int total = 0, admitted = 0, serial = 0, unver = 0;
+    const char *hdr = "batch\ttier\tallowlist\td1_worktree_git\td2_home_cache\td3_run_cache\td4_registry\td5_net_material\td6_fixed_tmp\td7_devsvc_daemon\tverdict\tlane_policy\n";
+
+    if (!root || !root[0]) root = ".";
+    if (batches_path && batches_path[0]) {
+        if (cx_fmt(bpath, sizeof bpath, "%s", batches_path)) return pd_refuse("analyze-batches-path");
+    } else {
+        if (cx_fmt(bpath, sizeof bpath, "%s/tests/batches.tsv", root)) return pd_refuse("analyze-batches-path");
+    }
+    if (sy_read_file(bpath, &raw, &rn, 4 << 20) || !raw || rn <= 0) {
+        if (raw) mm_free(raw);
+        return pd_refuse("analyze-read-batches");
+    }
+    out = (char *)mm_alloc((long)cap);
+    if (!out) { mm_free(raw); return pd_refuse("out-of-memory"); }
+    {
+        size_t hl = strlen(hdr);
+        mm_copy(out, (long)cap, hdr, (long)hl);
+        mp = hl;
+        out[mp] = 0;
+    }
+
+    while (pos < rn) {
+        int64_t ls = pos;
+        while (pos < rn && raw[pos] != '\n') pos++;
+        int64_t le = pos;
+        if (pos < rn) pos++;
+        if (le > ls && raw[le - 1] == '\r') le--;
+        if (le <= ls || raw[ls] == '#') continue;
+        const char *cols[16];
+        int64_t clens[16];
+        int nc = 0;
+        int64_t p = ls;
+        while (nc < 16) {
+            int64_t cs = p;
+            while (p < le && raw[p] != '\t') p++;
+            cols[nc] = (const char *)raw + cs;
+            clens[nc] = p - cs;
+            nc++;
+            if (p >= le) break;
+            p++;
+        }
+        if (nc < 2 || clens[0] <= 0 || clens[0] >= 128) continue;
+        if (clens[0] == 2 && memcmp(cols[0], "id", 2) == 0) continue;
+        if (clens[0] == 5 && memcmp(cols[0], "batch", 5) == 0) continue;
+
+        char bid[128], entry[512];
+        mm_copy(bid, sizeof bid, cols[0], clens[0]);
+        bid[clens[0]] = 0;
+        entry[0] = 0;
+        for (int c = 1; c < nc; c++) {
+            if (clens[c] > 3 && clens[c] < (int64_t)sizeof entry) {
+                if (tx_find(cols[c], clens[c], ".cx", 3) >= 0 || tx_find(cols[c], clens[c], ".sh", 3) >= 0) {
+                    mm_copy(entry, sizeof entry, cols[c], clens[c]);
+                    entry[clens[c]] = 0;
+                    break;
+                }
+            }
+        }
+
+        const char *tier = (pd_is_isolated_long_id(bid) || tx_eqz(bid, "real-commit")) ? "long" : (pd_is_heavy_id(bid) ? "heavy" : "normal");
+        int allow = pd_in_normal_parallel_allow(bid);
+        const char *d1 = "unverified", *d2 = "unverified", *d3 = "unverified", *d4 = "unverified";
+        const char *d5 = "unverified", *d6 = "unverified", *d7 = "unverified";
+
+        unsigned char *sb = 0, *mb = 0;
+        int64_t sn = 0, mn = 0;
+        int has_src = 0, has_iso_proof = 0, has_dynamic = 0;
+        if (entry[0]) {
+            char sp[PD_PW];
+            if (entry[0] == '/') {
+                if (!cx_fmt(sp, sizeof sp, "%s", entry) && !sy_read_file(sp, &sb, &sn, 2 << 20)) has_src = 1;
+            } else {
+                if (!cx_fmt(sp, sizeof sp, "%s/%s", root, entry) && !sy_read_file(sp, &sb, &sn, 2 << 20)) has_src = 1;
+            }
+        }
+        {
+            char mpth[PD_PW];
+            if (!cx_fmt(mpth, sizeof mpth, "%s/tests/manifests/%s.tsv", root, bid)) {
+                (void)sy_read_file(mpth, &mb, &mn, 256 << 10);
+            }
+        }
+
+        if (has_src && sb) {
+            const char *s = (const char *)sb;
+            long sl = (long)sn;
+            has_dynamic = pd_buf_has(s, sl, "sh -c") || pd_buf_has(s, sl, "\"-c\"") ||
+                          pd_buf_has(s, sl, "system(") || pd_buf_has(s, sl, "popen(") ||
+                          pd_buf_has(s, sl, "ckk_sh(");
+            has_iso_proof = (pd_buf_has(s, sl, "sr_scratch") || pd_buf_has(s, sl, "sy_mkdtemp") ||
+                             (mb && pd_buf_has((const char *)mb, (long)mn, "isolation=lane"))) && !has_dynamic;
+
+            if (pd_buf_has(s, sl, "git commit") || pd_buf_has(s, sl, "commit-own") ||
+                pd_buf_has(s, sl, "push-replay") || pd_buf_has(s, sl, "git update-ref") ||
+                pd_buf_has(s, sl, "build/freeze.tsv")) d1 = "shared";
+            else if (has_iso_proof && !pd_buf_has(s, sl, "git ")) d1 = "none";
+
+            if (pd_buf_has(s, sl, "getenv(\"HOME\")") && !has_iso_proof) d2 = "unverified";
+            else if (has_iso_proof) d2 = "none";
+
+            if (pd_buf_has(s, sl, "UNISACC_CACHE_DIR") && has_dynamic) d3 = "unverified";
+            else if (has_iso_proof || allow) d3 = "none";
+
+            if (pd_buf_has(s, sl, "register.cx") || (pd_buf_has(s, sl, "tests/batches.tsv") && pd_buf_has(s, sl, "--write")))
+                d4 = "shared";
+            else if (has_iso_proof) d4 = "none";
+
+            if (pd_buf_has(s, sl, "out/")) d5 = "shared";
+            else if (has_iso_proof || allow) d5 = "none";
+
+            if (pd_buf_has(s, sl, "/tmp/") && !pd_buf_has(s, sl, "sy_mkdtemp") && !pd_buf_has(s, sl, "sr_scratch"))
+                d6 = "shared";
+            else if (has_iso_proof) d6 = "none";
+
+            if (pd_buf_has(s, sl, "devsvc") && !pd_buf_has(s, sl, "UNISACC_DEVSVC_DIR")) d7 = "shared";
+            else if (has_iso_proof && !pd_buf_has(s, sl, "devsvc")) d7 = "none";
+        }
+        if (mb) mm_free(mb);
+        if (sb) mm_free(sb);
+
+        if (allow && !has_dynamic && !tx_eqz(d1, "shared") && !tx_eqz(d4, "shared") &&
+            !tx_eqz(d5, "shared") && !tx_eqz(d6, "shared") && !tx_eqz(d7, "shared")) {
+            d1 = "none"; d2 = "none"; d3 = "none"; d4 = "none"; d5 = "none"; d6 = "none"; d7 = "none";
+        }
+        if (tx_eqz(bid, "real-commit")) {
+            d1 = "shared"; d2 = "shared"; d3 = "none"; d4 = "none"; d5 = "none"; d6 = "none"; d7 = "shared";
+            allow = 0;
+        } else if (pd_starts(bid, "precommit-list-cap")) {
+            d1 = "shared"; d2 = "none"; d3 = "none"; d4 = "none"; d5 = "none"; d6 = "none"; d7 = "shared";
+            allow = 0;
+        } else if (pd_is_serial_only_id(bid)) {
+            if (tx_eqz(d1, "none")) d1 = "shared";
+            allow = 0;
+        }
+
+        int has_unv = tx_eqz(d1, "unverified") || tx_eqz(d2, "unverified") || tx_eqz(d3, "unverified") ||
+                      tx_eqz(d4, "unverified") || tx_eqz(d5, "unverified") || tx_eqz(d6, "unverified") ||
+                      tx_eqz(d7, "unverified");
+        int has_sh = tx_eqz(d1, "shared") || tx_eqz(d2, "shared") || tx_eqz(d3, "shared") ||
+                     tx_eqz(d4, "shared") || tx_eqz(d5, "shared") || tx_eqz(d6, "shared") ||
+                     tx_eqz(d7, "shared");
+        int ok_par = (allow && !has_unv && !has_sh);
+        const char *verdict = ok_par ? "ADMITTED_PARALLEL" : "SERIAL_REQUIRED";
+        const char *lpol = ok_par ? "multi-lane" : "serial-only";
+
+        total++;
+        if (ok_par) admitted++;
+        else {
+            serial++;
+            if (has_unv) unver++;
+        }
+
+        char row[512];
+        if (!cx_fmt(row, sizeof row, "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
+                    bid, tier, allow ? "yes" : "no", d1, d2, d3, d4, d5, d6, d7, verdict, lpol)) {
+            size_t rl = strlen(row);
+            if (mp + rl + 256 < cap) {
+                mm_copy(out + mp, (long)(cap - mp), row, (long)rl);
+                mp += rl;
+                out[mp] = 0;
+            }
+        }
+    }
+    mm_free(raw);
+
+    {
+        char sum[256];
+        if (!cx_fmt(sum, sizeof sum, "ISOLATION_DRY_SUMMARY\ttotal=%d\tadmitted_parallel=%d\tserial_required=%d\tunverified=%d\n",
+                    total, admitted, serial, unver)) {
+            size_t sl = strlen(sum);
+            if (mp + sl + 1 < cap) {
+                mm_copy(out + mp, (long)(cap - mp), sum, (long)sl);
+                mp += sl;
+                out[mp] = 0;
+            }
+        }
+    }
+
+    if (out_path && out_path[0]) {
+        if (sy_write_atomic(out_path, out, (int64_t)mp, 0644) != 0) {
+            mm_free(out);
+            return pd_refuse("analyze-write-out");
+        }
+    }
+    fwrite(out, 1, mp, stdout);
+    mm_free(out);
+    return 0;
+}
