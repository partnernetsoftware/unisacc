+    (void)cli_copy_file_no_hardlink(wf, l0f, 0600);
+    (void)cli_copy_file_no_hardlink(wacct, l0acct, 0600);
+    (void)cli_copy_file_no_hardlink(wf, l1f, 0600);
+    (void)cli_copy_file_no_hardlink(wacct, l1acct, 0600);
+
+    if (sy_lstat(wf, &st_w) == 0 && sy_lstat(l0f, &st_0) == 0 && sy_lstat(l1f, &st_1) == 0 &&
+        st_w.ino != st_0.ino && st_w.ino != st_1.ino && st_0.ino != st_1.ino) {
+        ino_ok = 1;
