+        if (wr <= 0) {
+            if (ch.h > 0) (void)sy_killpg(ch.h, 9);
+            else (void)sy_kill(ch.pid);
+            (void)sy_wait(ch.pid, 0);
+            return pd_refuse("LANE_CPUSET_UNAVAILABLE");
+        }
+        return pd_refuse("LANE_CPUSET_UNAVAILABLE");
+    }
+
+    deadline = sy_now_ms() + (long)PD_CHILD_SECONDS * 1000L;
+    for (;;) {
+        int ex = 0, code = 0, sig = 0;
+        int wr = sy_wait_status(ch.pid, 1, &ex, &code, &sig);
+        if (wr > 0) {
+            rc = ex ? code : (128 + sig);
