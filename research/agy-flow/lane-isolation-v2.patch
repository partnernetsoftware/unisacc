+/* ---- 256-bit strict CPU mask operations ---- */
+
+void fa_cpumask_zero(fa_cpumask_t *m) {
+    int i;
+    for (i = 0; i < 4; i++) m->w[i] = 0ull;
+}
+
+int fa_cpumask_test(const fa_cpumask_t *m, int cpu) {
+    if (!m || cpu < 0 || cpu >= 256) return 0;
+    return (int)((m->w[cpu >> 6] >> (cpu & 63)) & 1ull);
+}
+
+static void fa_cpumask_set(fa_cpumask_t *m, int cpu) {
+    if (m && cpu >= 0 && cpu < 256) m->w[cpu >> 6] |= (1ull << (cpu & 63));
+}
+
+int fa_cpumask_popcount(const fa_cpumask_t *m) {
+    int i, b, n = 0;
+    if (!m) return 0;
+    for (i = 0; i < 4; i++) {
+        unsigned long long v = m->w[i];
+        for (b = 0; b < 64; b++) if ((v >> b) & 1ull) n++;
+    }
+    return n;
+}
+
+int fa_cpumask_equal(const fa_cpumask_t *a, const fa_cpumask_t *b) {
+    int i;
+    if (!a || !b) return 0;
+    for (i = 0; i < 4; i++) if (a->w[i] != b->w[i]) return 0;
+    return 1;
+}
+
+int fa_cpumask_is_subset(const fa_cpumask_t *sub, const fa_cpumask_t *sup) {
+    int i;
+    if (!sub || !sup) return 0;
+    for (i = 0; i < 4; i++) if ((sub->w[i] & ~sup->w[i]) != 0ull) return 0;
+    return 1;
+}
+
+int fa_cpumask_overlap(const fa_cpumask_t *a, const fa_cpumask_t *b) {
+    int i;
+    if (!a || !b) return 0;
+    for (i = 0; i < 4; i++) if ((a->w[i] & b->w[i]) != 0ull) return 1;
+    return 0;
+}
+
+static int fa_parse_cpu_u8(const char **pp, int *out, char *why, size_t wcap) {
+    const char *p = *pp;
+    int v = 0, digits = 0;
+    while (*p >= '0' && *p <= '9') {
+        int d = *p - '0';
+        if (v > 25 || (v == 25 && d > 5)) {
+            (void)fa_set_why(why, wcap, "CPUSET_OUT_OF_RANGE");
+            return -1;
+        }
+        v = v * 10 + d;
+        digits++;
+        p++;
+    }
+    if (!digits) {
+        (void)fa_set_why(why, wcap, "CPUSET_SYNTAX");
+        return -1;
+    }
+    *pp = p;
+    *out = v;
+    return 0;
+}
+
+/* Strict 256-bit CPU list parser: rejects empty, leading/trailing/double comma, whitespace,
+ * non-digits, reversed ranges, val > 255 before multiply-accumulate, and duplicate CPUs. */
+int fa_cpuset_parse_strict(const char *spec, fa_cpumask_t *out, char *why, size_t wcap) {
+    const char *p = spec;
+    if (!out) return fa_set_why(why, wcap, "CPUSET_SYNTAX");
+    fa_cpumask_zero(out);
+    if (!spec || !spec[0]) return fa_set_why(why, wcap, "CPUSET_SYNTAX");
+    for (;;) {
+        int a = 0, b = 0, c;
+        if (fa_parse_cpu_u8(&p, &a, why, wcap) != 0) return 2;
+        b = a;
+        if (*p == '-') {
+            p++;
+            if (fa_parse_cpu_u8(&p, &b, why, wcap) != 0) return 2;
+            if (b < a) return fa_set_why(why, wcap, "CPUSET_REVERSED_RANGE");
+        }
+        for (c = a; c <= b; c++) {
+            if (fa_cpumask_test(out, c)) {
+                if (why && wcap > 0) (void)cx_fmt(why, wcap, "CPUSET_DUPLICATE cpu=%d", c);
+                return 2;
+            }
+            fa_cpumask_set(out, c);
+        }
+        if (*p == 0) break;
+        if (*p != ',') return fa_set_why(why, wcap, "CPUSET_SYNTAX");
+        p++;
+        if (*p == 0) return fa_set_why(why, wcap, "CPUSET_SYNTAX");
+    }
+    if (fa_cpumask_popcount(out) <= 0) return fa_set_why(why, wcap, "CPUSET_SYNTAX");
+    if (why && wcap > 0) why[0] = 0;
+    return 0;
+}
+
+/* Canonical sparse-preserving formatter: e.g. {0,2,5} -> "0,2,5", {0,1,2,5} -> "0-2,5". */
+int fa_cpuset_format(const fa_cpumask_t *m, char *out, size_t cap) {
+    size_t pos = 0;
+    int c = 0, first = 1;
+    if (!m || !out || cap < 2) return -1;
+    out[0] = 0;
+    while (c < 256) {
+        int s, e;
+        char tok[16];
+        size_t tl;
+        if (!fa_cpumask_test(m, c)) { c++; continue; }
+        s = c;
+        while (c + 1 < 256 && fa_cpumask_test(m, c + 1)) c++;
+        e = c;
+        if (s == e) {
+            if (cx_fmt(tok, sizeof tok, "%s%d", first ? "" : ",", s)) return -1;
+        } else {
+            if (cx_fmt(tok, sizeof tok, "%s%d-%d", first ? "" : ",", s, e)) return -1;
+        }
+        tl = (size_t)tx_len(tok, sizeof tok);
+        if (pos + tl + 1 > cap) return -1;
+        mm_copy(out + pos, (long)(cap - pos), tok, (long)tl);
+        pos += tl;
+        out[pos] = 0;
+        first = 0;
+        c++;
+    }
+    return first ? -1 : 0;
+}
