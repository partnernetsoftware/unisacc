+/* Independent byte copy (never link(2)) so lane caches never share inodes with warm cache or peer lanes. */
+static int pd_copy_file_no_hardlink(const char *src, const char *dst, int mode) {
+    unsigned char buf[16384];
+    int in_fd = sy_open_read(src), out_fd;
+    if (in_fd < 0) return -1;
+    out_fd = sy_open(dst, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, mode);
+    if (out_fd < 0) { sy_close(in_fd); return -1; }
+    for (;;) {
+        long r = sy_read_once(in_fd, buf, (long)sizeof buf);
+        if (r == 0) break;
+        if (r < 0) { sy_close(in_fd); sy_close(out_fd); (void)sy_unlink(dst); return -1; }
+        if (sy_write_all(out_fd, buf, r) != 0) { sy_close(in_fd); sy_close(out_fd); (void)sy_unlink(dst); return -1; }
+    }
+    sy_close(in_fd);
+    sy_close(out_fd);
+    return 0;
+}
