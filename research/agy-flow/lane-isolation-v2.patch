+/* ============================================================================
+ * Group 4: admission-bidirectional-barrier-race (legs a, b, c, d)
+ * ============================================================================ */
+static void test_admission_bidirectional_barrier_race(void) {
+    int c0 = 0, c1 = 1;
+    char ldir[CLI_PW], s0[16], s1[16], why[160], dcpus[64];
+    int leg_a = 0, leg_b = 0, leg_c = 0, leg_d = 0;
+
+    if (cli_find_two_allowed_cpus(&c0, &c1) != 0) {
+        ck(0, "admission-bidirectional-barrier-race");
+        return;
+    }
+    (void)cx_fmt(s0, sizeof s0, "%d", c0);
+    (void)cx_fmt(s1, sizeof s1, "%d", c1);
+
+    /* Leg (a): unpinned in-flight dev job D1 holds dev-inflight.lock LOCK_SH -> blocks prerun P1 with PRERUN_DEV_INFLIGHT */
+    {
+        sy_spawn_t opt;
+        sy_child_t d1;
+        fa_prerun_lease_t p1;
+        int pinned = -1;
+        char *dav[] = {"sh", "-c", "sleep 20", 0};
+        (void)cx_fmt(ldir, sizeof ldir, "%s/g4a-lease", g_tmp);
+        sy_spawn_init(&opt);
+        opt.argv = dav; opt.pgroup = -1;
+        opt.in_fd = SY_STDIO_NULL; opt.out_fd = SY_STDIO_NULL; opt.err_fd = SY_STDIO_NULL;
+        if (fa_dev_spawn_admit(ldir, &opt, &d1, &pinned, dcpus, sizeof dcpus, why, sizeof why) == 0 && pinned == 0) {
+            why[0] = 0;
+            int blocked = (fa_prerun_lease_acquire(ldir, s0, s1, sy_wall_s() + 300, &p1, why, sizeof why) == 2 &&
+                           cli_has(why, "PRERUN_DEV_INFLIGHT"));
+            if (d1.h > 0) (void)sy_killpg(d1.h, 9);
+            else (void)sy_kill(d1.pid);
+            (void)sy_wait(d1.pid, 0);
+            sy_sleep_ms(50);
+            why[0] = 0;
+            int after_drain = (fa_prerun_lease_acquire(ldir, s0, s1, sy_wall_s() + 300, &p1, why, sizeof why) == 0);
+            if (after_drain) (void)fa_prerun_lease_release(&p1, why, sizeof why);
+            leg_a = (blocked && after_drain);
+        }
+    }
+
+    /* Leg (b): synchronized barrier race between prerun acquire and dev spawn */
+    {
+        int go_p[2], res_p[2], pid_dev;
+        (void)cx_fmt(ldir, sizeof ldir, "%s/g4b-lease", g_tmp);
+        (void)sy_mkdir(ldir, 0700);
+        if (pipe(go_p) == 0 && pipe(res_p) == 0) {
+            pid_dev = fork();
+            if (pid_dev == 0) {
+                char b;
+                sy_spawn_t opt;
+                sy_child_t ch;
+                int pinned = -1;
+                char dwhy[128], dc[64], msg[32];
+                char *dav[] = {"sh", "-c", "sleep 2", 0};
+                close(go_p[1]); close(res_p[0]);
+                (void)read(go_p[0], &b, 1);
+                sy_spawn_init(&opt);
+                opt.argv = dav; opt.pgroup = -1;
+                opt.in_fd = SY_STDIO_NULL; opt.out_fd = SY_STDIO_NULL; opt.err_fd = SY_STDIO_NULL;
+                int rc = fa_dev_spawn_admit(ldir, &opt, &ch, &pinned, dc, sizeof dc, dwhy, sizeof dwhy);
+                int n = snprintf(msg, sizeof msg, "%d %d %d\n", rc, pinned, rc == 0 ? ch.pid : 0);
+                (void)write(res_p[1], msg, (size_t)n);
+                if (rc == 0 && ch.pid > 0) {
+                    sy_sleep_ms(300);
+                    if (ch.h > 0) (void)sy_killpg(ch.h, 9);
+                    else (void)sy_kill(ch.pid);
+                    (void)sy_wait(ch.pid, 0);
+                }
+                _exit(0);
+            }
+            close(go_p[0]); close(res_p[1]);
+            (void)write(go_p[1], "G", 1);
+            close(go_p[1]);
+            fa_prerun_lease_t p_lease;
+            int prc = fa_prerun_lease_acquire(ldir, s0, s1, sy_wall_s() + 300, &p_lease, why, sizeof why);
+            char rbuf[64];
+            ssize_t rn = read(res_p[0], rbuf, sizeof rbuf - 1);
+            close(res_p[0]);
+            int drc = -1, dpinned = -1, dpid = 0;
+            if (rn > 0) { rbuf[rn] = 0; sscanf(rbuf, "%d %d %d", &drc, &dpinned, &dpid); }
+            (void)sy_wait(pid_dev, 0);
+            if (prc == 0) (void)fa_prerun_lease_release(&p_lease, why, sizeof why);
+            /* Serialized invariant: never (prerun acquired AND dev spawned unpinned) */
+            if ((prc == 0 && drc == 0 && dpinned == 1) || (prc == 2 && cli_has(why, "PRERUN_DEV_INFLIGHT") && drc == 0 && dpinned == 0)) {
+                leg_b = 1;
+            }
+        }
+    }
+
+    /* Leg (c): prerun-cpuset.lock held LOCK_EX while prerun-cpuset.tsv missing or corrupt -> fail closed */
+    {
+        char lp[CLI_PW], tsvp[CLI_PW];
+        int lfd;
+        sy_spawn_t opt;
+        sy_child_t ch;
+        int pinned = -1, miss_ok = 0, corrupt_ok = 0;
+        char *dav[] = {"sh", "-c", "sleep 1", 0};
+        (void)cx_fmt(ldir, sizeof ldir, "%s/g4c-lease", g_tmp);
+        (void)sy_mkdir(ldir, 0700);
+        (void)cx_fmt(lp, sizeof lp, "%s/prerun-cpuset.lock", ldir);
+        (void)cx_fmt(tsvp, sizeof tsvp, "%s/prerun-cpuset.tsv", ldir);
+        lfd = sy_open(lp, O_CREAT | O_RDWR | O_CLOEXEC, 0600);
+        if (lfd >= 0 && sy_flock(lfd, FA_LOCK_EX | FA_LOCK_NB) == 0) {
+            (void)sy_unlink(tsvp);
+            sy_spawn_init(&opt);
+            opt.argv = dav; opt.pgroup = -1;
+            opt.in_fd = SY_STDIO_NULL; opt.out_fd = SY_STDIO_NULL; opt.err_fd = SY_STDIO_NULL;
+            why[0] = 0;
+            if (fa_dev_spawn_admit(ldir, &opt, &ch, &pinned, dcpus, sizeof dcpus, why, sizeof why) == 2 &&
+                cli_has(why, "DEV_LEASE_METADATA_INVALID_WHILE_LOCKED")) {
+                miss_ok = 1;
+            }
+            (void)sy_write_file(tsvp, "corrupt\tonly_two_cols\n", 22, 0600);
+            why[0] = 0;
+            if (fa_dev_spawn_admit(ldir, &opt, &ch, &pinned, dcpus, sizeof dcpus, why, sizeof why) == 2 &&
+                cli_has(why, "DEV_LEASE_METADATA_INVALID_WHILE_LOCKED")) {
+                corrupt_ok = 1;
+            }
+            (void)sy_flock(lfd, FA_LOCK_UN);
+            sy_close(lfd);
+        }
+        leg_c = (miss_ok && corrupt_ok);
+    }
+
+    /* Leg (d): lease rotation with surviving pinned dev descendant D2a from previous lease A ->
+     * prerun B requesting rotated cpuset (s1:s0) must refuse PRERUN_DEV_INFLIGHT until D2a drains. */
+    {
+        fa_prerun_lease_t la, lb;
+        sy_spawn_t opt;
+        sy_child_t d2;
+        int pinned = -1;
+        char *dav[] = {"sh", "-c", "sleep 20 & wait", 0};
+        (void)cx_fmt(ldir, sizeof ldir, "%s/g4d-lease", g_tmp);
+        if (fa_prerun_lease_acquire(ldir, s0, s1, sy_wall_s() + 300, &la, why, sizeof why) == 0) {
+            sy_spawn_init(&opt);
+            opt.argv = dav; opt.pgroup = -1;
+            opt.in_fd = SY_STDIO_NULL; opt.out_fd = SY_STDIO_NULL; opt.err_fd = SY_STDIO_NULL;
+            if (fa_dev_spawn_admit(ldir, &opt, &d2, &pinned, dcpus, sizeof dcpus, why, sizeof why) == 0 && pinned == 1) {
+                /* Release prerun A while pinned dev subtree D2/D2a stays alive on CPU s1 */
+                (void)fa_prerun_lease_release(&la, why, sizeof why);
+                why[0] = 0;
+                int rot_blocked = (fa_prerun_lease_acquire(ldir, s1, s0, sy_wall_s() + 300, &lb, why, sizeof why) == 2 &&
+                                   cli_has(why, "PRERUN_DEV_INFLIGHT"));
+                if (d2.h > 0) (void)sy_killpg(d2.h, 9);
+                else (void)sy_kill(d2.pid);
+                (void)sy_wait(d2.pid, 0);
+                sy_sleep_ms(100);
+                why[0] = 0;
+                int rot_ok = (fa_prerun_lease_acquire(ldir, s1, s0, sy_wall_s() + 300, &lb, why, sizeof why) == 0);
+                if (rot_ok) (void)fa_prerun_lease_release(&lb, why, sizeof why);
+                leg_d = (rot_blocked && rot_ok);
+            } else {
+                (void)fa_prerun_lease_release(&la, why, sizeof why);
+            }
+        }
+    }
+
+    ck(leg_a && leg_b && leg_c && leg_d, "admission-bidirectional-barrier-race");
+}
