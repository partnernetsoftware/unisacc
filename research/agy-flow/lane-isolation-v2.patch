+static int fa_parse_lease_tsv(const char *tsv_path, fa_prerun_lease_t *out, char *why, size_t wcap) {
+    char *b = fa_slurp(tsv_path, 4096);
+    char *cols[8], *p, *nl;
+    int nc = 0;
+    char tmpwhy[128];
+    if (!b || !b[0]) { free(b); return fa_set_why(why, wcap, "DEV_LEASE_METADATA_INVALID_WHILE_LOCKED"); }
+    nl = strchr(b, '\n');
+    if (nl) *nl = 0;
+    p = b;
+    while (nc < 8) {
+        char *tab = strchr(p, '\t');
+        cols[nc++] = p;
+        if (!tab) break;
+        *tab = 0;
+        p = tab + 1;
+    }
+    if (nc != 7 || !cols[0][0] || !cols[1][0] || !cols[2][0] || !cols[3][0] ||
+        !cols[4][0] || !cols[5][0] || !cols[6][0]) {
+        free(b);
+        return fa_set_why(why, wcap, "DEV_LEASE_METADATA_INVALID_WHILE_LOCKED");
+    }
+    out->owner_pid = atol(cols[0]);
+    out->owner_pgid = atol(cols[1]);
+    out->owner_start_ticks = atol(cols[2]);
+    out->deadline_epoch_s = atol(cols[6]);
+    if (out->owner_pid <= 0 || out->owner_pgid <= 0 || out->owner_start_ticks < 0 || out->deadline_epoch_s <= 0 ||
+        cx_fmt(out->lease_token, sizeof out->lease_token, "%s", cols[3]) ||
+        cx_fmt(out->prerun_cpus, sizeof out->prerun_cpus, "%s", cols[4]) ||
+        cx_fmt(out->dev_cpus, sizeof out->dev_cpus, "%s", cols[5]) ||
+        fa_cpuset_parse_strict(out->prerun_cpus, &out->prerun_mask, tmpwhy, sizeof tmpwhy) != 0 ||
+        fa_cpuset_parse_strict(out->dev_cpus, &out->dev_mask, tmpwhy, sizeof tmpwhy) != 0 ||
+        fa_cpumask_overlap(&out->prerun_mask, &out->dev_mask)) {
+        free(b);
+        return fa_set_why(why, wcap, "DEV_LEASE_METADATA_INVALID_WHILE_LOCKED");
+    }
+    free(b);
+    return 0;
+}
