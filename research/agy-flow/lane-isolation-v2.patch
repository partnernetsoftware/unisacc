+    av2 = (char **)mm_alloc((long)(orig_n + 4) * (long)sizeof(char *));
+    if (!av2) return pd_refuse("OUT_OF_MEMORY");
+    av2[0] = (char *)ts;
+    av2[1] = "-c";
+    av2[2] = (char *)cpulist;
+    for (i = 0; i < orig_n; i++) av2[3 + i] = base_av[i];
+    av2[3 + orig_n] = 0;
