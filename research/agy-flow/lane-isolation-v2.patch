+/* ============================================================================
+ * Group 3: lease-real-window-subtree-and-sigkill-wrapper
+ * ============================================================================ */
+static void test_lease_real_window_subtree_and_sigkill_wrapper(void) {
+    int c0 = 0, c1 = 1;
+    char ldir[CLI_PW], pidf[CLI_PW], s0[16], s1[16], why[160], dcpus[64];
+    int pfd[2];
+    int wrapper_pid, worker_pid = 0;
+    int held_ok = 0, dev_pinned_ok = 0, reclaimed_ok = 0;
+
+    if (cli_find_two_allowed_cpus(&c0, &c1) != 0) {
+        ck(0, "lease-real-window-subtree-and-sigkill-wrapper");
+        return;
+    }
+    (void)cx_fmt(s0, sizeof s0, "%d", c0);
+    (void)cx_fmt(s1, sizeof s1, "%d", c1);
+    (void)cx_fmt(ldir, sizeof ldir, "%s/g3-lease", g_tmp);
+    (void)cx_fmt(pidf, sizeof pidf, "%s/g3-worker.pid", g_tmp);
+    (void)sy_mkdir(ldir, 0700);
+    if (pipe(pfd) != 0) { ck(0, "lease-real-window-subtree-and-sigkill-wrapper"); return; }
+
+    wrapper_pid = fork();
+    if (wrapper_pid == 0) {
+        fa_prerun_lease_t l;
+        sy_spawn_t opt;
+        sy_child_t worker;
+        char wcmd[256], wwhy[128];
+        char *av[4];
+        close(pfd[0]);
+        if (fa_prerun_lease_acquire(ldir, s0, s1, sy_wall_s() + 1, &l, wwhy, sizeof wwhy) != 0) _exit(11);
+        /* Spawn real window worker via sy_proc_spawn: inherits prerun-cpuset.lock LOCK_EX FD. */
+        (void)cx_fmt(wcmd, sizeof wcmd, "echo $$ > '%s'; sleep 30", pidf);
+        av[0] = "sh"; av[1] = "-c"; av[2] = wcmd; av[3] = 0;
+        sy_spawn_init(&opt);
+        opt.argv = av;
+        opt.pgroup = -1;
+        opt.in_fd = SY_STDIO_NULL;
+        opt.out_fd = SY_STDIO_NULL;
+        opt.err_fd = SY_STDIO_NULL;
+        if (sy_proc_spawn(&opt, &worker) < 0) _exit(12);
+        {
+            char msg[32];
+            int n = snprintf(msg, sizeof msg, "%d\n", worker.pid);
+            (void)write(pfd[1], msg, (size_t)n);
+        }
+        close(pfd[1]);
+        for (;;) sy_sleep_ms(100);
+        _exit(0);
+    }
+    close(pfd[1]);
+    {
+        char rbuf[64];
+        ssize_t rn = read(pfd[0], rbuf, sizeof rbuf - 1);
+        close(pfd[0]);
+        if (rn > 0) { rbuf[rn] = 0; worker_pid = atoi(rbuf); }
+    }
+    /* SIGKILL wrapper A, reap A, and wait past 1s deadline while worker A1 stays alive. */
+    if (wrapper_pid > 0) {
+        (void)sy_kill(wrapper_pid);
+        (void)sy_wait(wrapper_pid, 0);
+    }
+    sy_sleep_ms(1200);
+
+    if (worker_pid > 0) {
+        fa_prerun_lease_t b_lease;
+        sy_spawn_t dopt;
+        sy_child_t dch;
+        int pinned = 0;
+        char *dav[] = {"sh", "-c", "sleep 2", 0};
+
+        /* (a) New prerun B must be refused with PRERUN_LEASE_HELD even though A is dead & expired */
+        why[0] = 0;
+        if (fa_prerun_lease_acquire(ldir, s0, s1, sy_wall_s() + 300, &b_lease, why, sizeof why) == 2 &&
+            cli_has(why, "PRERUN_LEASE_HELD")) {
+            held_ok = 1;
+        }
+
+        /* (b) Dev spawn admission must still force pinning to dev_cpus (s1) */
+        sy_spawn_init(&dopt);
+        dopt.argv = dav; dopt.pgroup = -1;
+        dopt.in_fd = SY_STDIO_NULL; dopt.out_fd = SY_STDIO_NULL; dopt.err_fd = SY_STDIO_NULL;
+        why[0] = 0;
+        if (fa_dev_spawn_admit(ldir, &dopt, &dch, &pinned, dcpus, sizeof dcpus, why, sizeof why) == 0 &&
+            pinned == 1 && tx_eqz(dcpus, s1)) {
+            dev_pinned_ok = 1;
+        }
+        if (dch.pid > 0) {
+            if (dch.h > 0) (void)sy_killpg(dch.h, 9);
+            else (void)sy_kill(dch.pid);
+            (void)sy_wait(dch.pid, 0);
+        }
+
+        /* Terminate worker A1 subtree, then B must succeed acquiring the lease */
+        (void)sy_killpg(worker_pid, 9);
+        (void)sy_kill(worker_pid);
+        sy_sleep_ms(150);
+        why[0] = 0;
+        if (fa_prerun_lease_acquire(ldir, s0, s1, sy_wall_s() + 300, &b_lease, why, sizeof why) == 0) {
+            reclaimed_ok = 1;
+            (void)fa_prerun_lease_release(&b_lease, why, sizeof why);
+        }
+    }
+    ck(held_ok && dev_pinned_ok && reclaimed_ok, "lease-real-window-subtree-and-sigkill-wrapper");
+}
