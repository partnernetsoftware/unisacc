+/* ============================================================================
+ * Group 2: cpuset-affinity-and-default
+ * ============================================================================ */
+static void test_cpuset_affinity_and_default(void) {
+    int c0 = 0, c1 = 1;
+    char ldir[CLI_PW], fake_ts[CLI_PW], why[160], dcpus[64], spec[64], s0[16], s1[16];
+    fa_prerun_lease_t lease;
+    sy_spawn_t opt;
+    sy_child_t ch;
+    int pinned = 0, default_ok = 0, missing_ts_ok = 0, fake_ts_ok = 0, real_ts_ok = 0;
+    unsigned char *pd_src = 0;
+    int64_t pd_n = 0;
+
+    /* (a) Verify PD_DEFAULT_LANES stays 4 in tools/prerun-drive.cx */
+    if (!sy_read_file("tools/prerun-drive.cx", &pd_src, &pd_n, 4 << 20) && pd_src) {
+        if (tx_find((const char *)pd_src, (long)pd_n, "#define PD_DEFAULT_LANES 4", 26) >= 0) default_ok = 1;
+        mm_free(pd_src);
+    }
+
+    if (cli_find_two_allowed_cpus(&c0, &c1) != 0) {
+        ck(0, "cpuset-affinity-and-default");
+        return;
+    }
+    (void)cx_fmt(s0, sizeof s0, "%d", c0);
+    (void)cx_fmt(s1, sizeof s1, "%d", c1);
+    (void)cx_fmt(spec, sizeof spec, "%d:%d", c0, c1);
+    (void)cx_fmt(ldir, sizeof ldir, "%s/g2-lease", g_tmp);
+    (void)cx_fmt(fake_ts, sizeof fake_ts, "%s/fake-noop-taskset.sh", g_tmp);
+    {
+        const char *sc = "#!/bin/sh\nshift\nshift\nexec \"$@\"\n";
+        (void)sy_write_file(fake_ts, sc, (int64_t)strlen(sc), 0755);
+    }
+
+    if (fa_prerun_lease_acquire(ldir, s0, s1, sy_wall_s() + 300, &lease, why, sizeof why) == 0) {
+        char *sleep_av[] = {"sh", "-c", "sleep 2", 0};
+        sy_spawn_init(&opt);
+        opt.argv = sleep_av;
+        opt.pgroup = -1;
+        opt.in_fd = SY_STDIO_NULL;
+        opt.out_fd = SY_STDIO_NULL;
+        opt.err_fd = SY_STDIO_NULL;
+
+        /* (b) Nonexistent taskset -> rc=2 REFUSE LANE_CPUSET_UNAVAILABLE */
+        (void)sy_setenv("UNISACC_TASKSET_BIN", "/nonexistent/taskset", 1);
+        why[0] = 0;
+        if (fa_dev_spawn_admit(ldir, &opt, &ch, &pinned, dcpus, sizeof dcpus, why, sizeof why) == 2 &&
+            cli_has(why, "LANE_CPUSET_UNAVAILABLE")) {
+            missing_ts_ok = 1;
+        }
+
+        /* (c) Fake noop taskset (does not change affinity) -> caught by /proc/<pid>/status readback */
+        (void)sy_setenv("UNISACC_TASKSET_BIN", fake_ts, 1);
+        why[0] = 0;
+        if (fa_dev_spawn_admit(ldir, &opt, &ch, &pinned, dcpus, sizeof dcpus, why, sizeof why) == 2 &&
+            cli_has(why, "LANE_CPUSET_UNAVAILABLE")) {
+            fake_ts_ok = 1;
+        }
+
+        /* (d) Real /usr/bin/taskset -> child Cpus_allowed_list matches dev_mask bit-for-bit */
+        (void)sy_unsetenv("UNISACC_TASKSET_BIN");
+        why[0] = 0;
+        if (fa_dev_spawn_admit(ldir, &opt, &ch, &pinned, dcpus, sizeof dcpus, why, sizeof why) == 0 && pinned == 1) {
+            fa_cpumask_t got;
+            if (fa_read_pid_allowed_mask((long)ch.pid, &got, why, sizeof why) == 0 &&
+                fa_cpumask_equal(&got, &lease.dev_mask)) {
+                real_ts_ok = 1;
+            }
+            if (ch.h > 0) (void)sy_killpg(ch.h, 9);
+            else (void)sy_kill(ch.pid);
+            (void)sy_wait(ch.pid, 0);
+        }
+        (void)fa_prerun_lease_release(&lease, why, sizeof why);
+    }
+    (void)sy_unsetenv("UNISACC_TASKSET_BIN");
+    ck(default_ok && missing_ts_ok && fake_ts_ok && real_ts_ok, "cpuset-affinity-and-default");
+}
