+static int pd_seed_lane_e3cache(const char *src_dir, const char *dst_dir) {
+    sy_dir_t d;
+    int next;
+    if (!dst_dir || !dst_dir[0]) return -1;
+    (void)sy_mkdir(dst_dir, 0700);
+    (void)chmod(dst_dir, 0700);
+    if (!src_dir || !src_dir[0] || sy_exists(src_dir) != 1) return 0;
+    if (sy_dir_open(&d, src_dir)) return 0;
+    while ((next = sy_dir_next(&d)) == 1) {
+        char sp[PD_PW], dp[PD_PW];
+        sy_stat_t st;
+        if (tx_eqz(d.name, ".") || tx_eqz(d.name, "..") || tx_eqz(d.name, ".budget.lock")) continue;
+        if (cx_fmt(sp, sizeof sp, "%s/%s", src_dir, d.name) ||
+            cx_fmt(dp, sizeof dp, "%s/%s", dst_dir, d.name)) continue;
+        if (sy_lstat(sp, &st) != 0) continue;
+        if (st.kind == 'd') {
+            if (pd_seed_lane_e3cache(sp, dp) != 0) { sy_dir_close(&d); return -1; }
+        } else if (st.kind == 'f') {
+            if (pd_copy_file_no_hardlink(sp, dp, 0600) != 0) { sy_dir_close(&d); return -1; }
+        }
+    }
+    sy_dir_close(&d);
+    return 0;
+}
