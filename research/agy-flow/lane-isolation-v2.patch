+/* tools/check-lane-isolation.cx -- deterministic 6-group verification suite for lane-isolation-v2.
+ * Covers all 6 required fixture groups from research/agy-flow/lane-isolation-v2.md section 4:
+ *   1. cpuset-parser-strict
+ *   2. cpuset-affinity-and-default
+ *   3. lease-real-window-subtree-and-sigkill-wrapper
+ *   4. admission-bidirectional-barrier-race (legs a, b, c, d)
+ *   5. schedule-allowlist-and-analyzer-soundness
+ *   6. lane-cache-no-hardlink-and-reap-before-clean
+ */
+#pragma unisa use sys.io
+#pragma unisa use sys.fs
+#pragma unisa use sys.posix
+#pragma unisa use sys.proc
+#pragma unisa use sys.env
+#pragma unisa use sys.time
+#pragma unisa use sysx.process
+#pragma unisa use cxlib.flowadmit
+#pragma unisa use text.text
+#pragma unisa use mem.bytes
+#pragma unisa use mem.heap
+#pragma unisa use crypto.sha256
+
+#define CLI_PW 4096
+
+static int g_pass = 0;
+static int g_fail = 0;
+static char g_tmp[CLI_PW];
+
+static void ck(int ok, const char *name) {
+    if (ok) {
+        g_pass++;
+        sy_printf("PASS\tcheck-lane-isolation.%s\n", name);
+    } else {
+        g_fail++;
+        sy_printf("FAIL\tcheck-lane-isolation.%s\n", name);
+    }
+}
+
+static int cli_has(const char *buf, const char *sub) {
+    if (!buf || !sub) return 0;
+    return tx_find(buf, (long)strlen(buf), sub, (long)strlen(sub)) >= 0;
+}
+
+static int cli_sha256_file(const char *path, char hex[65]) {
+    unsigned char *b = 0;
+    int64_t n = 0;
+    if (sy_read_file(path, &b, &n, 4 << 20) || !b || n < 0) { if (b) mm_free(b); return -1; }
+    if (cs_sha256_hex(b, (long)n, hex) != 0) { mm_free(b); return -1; }
+    mm_free(b);
+    return 0;
+}
+
+static int cli_run_cmd(char **av, const char *cwd, char **env, int timeout_s, int *out_rc, char *out_buf, size_t cap) {
+    np_result r = {0};
+    char why[256];
+    long n = 0;
+    int tr = np_run(av, cwd, env, timeout_s, &r, why, sizeof why);
+    *out_rc = tr ? 124 : r.rc;
+    out_buf[0] = 0;
+    if (r.out && r.outn > 0) {
+        long t = (long)r.outn < (long)cap - 1 ? (long)r.outn : (long)cap - 1;
+        mm_copy(out_buf, (long)cap, r.out, t);
+        n += t;
+    }
+    if (r.err && r.errn > 0 && n < (long)cap - 1) {
+        long t = (long)r.errn < (long)cap - 1 - n ? (long)r.errn : (long)cap - 1 - n;
+        mm_copy(out_buf + n, (long)cap - n, r.err, t);
+        n += t;
+    }
+    out_buf[n] = 0;
+    np_free(&r);
+    return tr;
+}
+
+static int cli_find_two_allowed_cpus(int *c0, int *c1) {
+    fa_cpumask_t m;
+    char why[128];
+    int c, got = 0, pair[2] = {-1, -1};
+    if (fa_read_pid_allowed_mask(0, &m, why, sizeof why) != 0) return -1;
+    for (c = 0; c < 256 && got < 2; c++) {
+        if (fa_cpumask_test(&m, c)) pair[got++] = c;
+    }
+    if (got < 2) return -1;
+    *c0 = pair[0];
+    *c1 = pair[1];
+    return 0;
+}
+
+static int cli_copy_file_no_hardlink(const char *src, const char *dst, int mode) {
+    unsigned char buf[8192];
+    int ifd = sy_open_read(src), ofd;
+    if (ifd < 0) return -1;
+    ofd = sy_open(dst, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, mode);
+    if (ofd < 0) { sy_close(ifd); return -1; }
+    for (;;) {
+        long r = sy_read_once(ifd, buf, (long)sizeof buf);
+        if (r == 0) break;
+        if (r < 0 || sy_write_all(ofd, buf, r) != 0) { sy_close(ifd); sy_close(ofd); return -1; }
+    }
+    sy_close(ifd);
+    sy_close(ofd);
+    return 0;
+}
