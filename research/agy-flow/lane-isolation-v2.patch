+        if (!env2) { mm_free(av2); return pd_refuse("OUT_OF_MEMORY"); }
+        for (i = 0; i < base_e; i++) env2[i] = cur[i];
+        for (i = 0; i < ext_e; i++) {
+            const char *eq = strchr(extra_env[i], '=');
+            long kl = eq ? (long)(eq - extra_env[i]) + 1 : 0;
+            int j, hit = 0;
+            for (j = 0; j < base_e; j++) {
+                if (kl > 0 && strncmp(env2[j], extra_env[i], (size_t)kl) == 0) { env2[j] = extra_env[i]; hit = 1; }
