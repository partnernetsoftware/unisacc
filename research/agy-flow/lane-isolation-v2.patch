+/* ============================================================================
+ * Group 1: cpuset-parser-strict
+ * ============================================================================ */
+static void test_cpuset_parser_strict(void) {
+    fa_cpumask_t m, pm, dm;
+    char why[160], ps[128], ds[128];
+    int bad_ok = 1, sparse_ok = 0, ov_ok = 0, ins_ok = 0;
+    static const char *bad_specs[] = {
+        "", "0-3,", ",0-3", "0,,1", "0-3,2", "99999999999999999999", "256", "5-2", "0 1", "0-a", 0
+    };
+    int i;
+    for (i = 0; bad_specs[i]; i++) {
+        why[0] = 0;
+        if (fa_cpuset_parse_strict(bad_specs[i], &m, why, sizeof why) != 2) bad_ok = 0;
+    }
+    /* Specific error tags: duplicate, overflow/out-of-range */
+    if (fa_cpuset_parse_strict("0-3,2", &m, why, sizeof why) != 2 || !cli_has(why, "CPUSET_DUPLICATE")) bad_ok = 0;
+    if (fa_cpuset_parse_strict("99999999999999999999", &m, why, sizeof why) != 2 || !cli_has(why, "CPUSET_OUT_OF_RANGE")) bad_ok = 0;
+    if (fa_cpuset_parse_strict("256", &m, why, sizeof why) != 2 || !cli_has(why, "CPUSET_OUT_OF_RANGE")) bad_ok = 0;
+
+    /* Sparse preservation: 0,2,5 and 1,3 must stay sparse, not expand to 0-5 */
+    if (fa_cpuset_parse_strict("0,2,5", &pm, why, sizeof why) == 0 &&
+        fa_cpuset_parse_strict("1,3", &dm, why, sizeof why) == 0 &&
+        fa_cpuset_format(&pm, ps, sizeof ps) == 0 &&
+        fa_cpuset_format(&dm, ds, sizeof ds) == 0 &&
+        tx_eqz(ps, "0,2,5") && tx_eqz(ds, "1,3")) {
+        sparse_ok = 1;
+    }
+
+    /* Overlap and insufficient CPUs negative controls */
+    why[0] = 0;
+    if (fa_cpuset_pair_parse_and_verify("0,2:2,3", 1, &pm, &dm, ps, sizeof ps, ds, sizeof ds, why, sizeof why) == 2 &&
+        cli_has(why, "CPUSET_OVERLAP")) {
+        ov_ok = 1;
+    }
+    why[0] = 0;
+    if (fa_cpuset_pair_parse_and_verify("0,2:1,3", 3, &pm, &dm, ps, sizeof ps, ds, sizeof ds, why, sizeof why) == 2 &&
+        cli_has(why, "CPUSET_INSUFFICIENT_CPUS")) {
+        ins_ok = 1;
+    }
+
+    ck(bad_ok && sparse_ok && ov_ok && ins_ok, "cpuset-parser-strict");
+}
