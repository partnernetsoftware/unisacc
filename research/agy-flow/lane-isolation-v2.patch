+        rp_kill_tree(lane_pgid, 150, 0, 0, rep, sizeof rep);
+        (void)sy_killpg(lane_pgid, 9);
+        sy_sleep_ms(30);
+    }
+    residue = pd_count_lane_residue(lane_dir, lane_pgid);
+    if (residue > 0) {
+        fprintf(stderr, "LANE_TAINTED\tdir=%s\tresidue=%d\nRESIDUE\tdir=%s\tcount=%d\n",
+                lane_dir, residue, lane_dir, residue);
+        return -1;
+    }
+    if (lane_dir && lane_dir[0] && sy_exists(lane_dir) == 1) {
+        char *rmv[] = {"rm", "-rf", (char *)lane_dir, 0};
+        np_result r = {0};
+        char why[128];
+        (void)np_run(rmv, 0, 0, 15, &r, why, sizeof why);
+        np_free(&r);
+    }
+    return 0;
+}
