+
+    char base_rev[64] = "", head_rev[64] = "";
+    {
+        char p[4500]; unsigned char *b = 0; int64_t n = 0;
+        cx_fmt(p, sizeof p, "%s/base.txt", tmp);
+        if (sy_read_file(p, &b, &n, 100) || n < 40 || ck_copy(base_rev, sizeof base_rev, b, 40)) return 2;
