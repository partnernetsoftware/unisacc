+        cx_write(mock_dv_bin, dv_sh, strlen(dv_sh)) || sy_chmod(mock_dv_bin, 0755) ||
+        cx_write(real_dv_exec, real_dv_sh, strlen(real_dv_sh)) || sy_chmod(real_dv_exec, 0755)) return 2;
+
+    /* (1) Verify strict mock-dvqualify rejects old --root flag */
+    {
+        char *bad_dv[] = {mock_dv_bin, "--root", fx, "--candidate", ape1, "--ids", "light-a", 0};
+        np_result br = run(bad_dv, 0);
+        ck(br.rc == 2 && tk_has(br.err, "argv[1] must be positional repo root"), "strict-mock-dvqualify-rejects-dash-root");
