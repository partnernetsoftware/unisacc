+        }
+        printf("PRERUN_START\tRESUME_MIGRATED\tfrom_repo=%s\tto_repo=%s\tfrom_rev=%s\tto_rev=%s\tfrom_tree=%s\tto_tree=%s\treason=%s\n",
+               b_repo, rrepo, b_rev_sha, cur_rev, b_tree_sha, cur_tree, mig_why);
+    }
+
+    char *rv[22]; int rc_i = ps_prog_prefix(rv, dr_prog);
