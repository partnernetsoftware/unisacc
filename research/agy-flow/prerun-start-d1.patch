diff --git a/tools/prerun-start.cx b/tools/prerun-start.cx
new file mode 100644
index 0000000000..50d9ce1fb8
--- /dev/null
+++ b/tools/prerun-start.cx
@@ -0,0 +1,960 @@
+/* tools/prerun-start.cx -- D1 freeze admission gate and T11 warmup-cold-v2 cold receipt producer/verifier.
+ *
+ * Subcommands:
+ *   admission        --root DIR --base REV --candidate APE --out DIR
+ *                    [--warmup-batch ID] [--dvqualify-prog FILE] [--affected-prog FILE]
+ *   verify-admission --root DIR --base REV --candidate APE --out DIR
+ *                    [--affected-prog FILE] [--plan-windows FILE]
+ *   verify-cold-v2   --root DIR --candidate APE --cold-times-file FILE [--rev REV]
+ *   cold-identity    --root DIR --candidate APE [--rev REV]
+ *
+ * Check: tools/check-prerun-start.cx. */
+#pragma unisa use cxlib.netpack
+#pragma unisa use sys.fs
+#pragma unisa use sys.env
+#pragma unisa use sys.posix
+#pragma unisa use sys.proc
+#pragma unisa use sys.time
+#pragma unisa use sys.sha
+#pragma unisa use text.text
+#pragma unisa use mem.bytes
+#pragma unisa use mem.heap
+
+#define PS_MAXIDS 4096
+#define PS_IDLEN 128
+#define PS_PW 4400
+#define PS_COLD_V2_LIMIT_MS 12000
+
+static char g_ids[PS_MAXIDS][PS_IDLEN];
+static int g_src[PS_MAXIDS]; /* bit 1 = affected, bit 2 = added */
+static int g_nids;
+
+static int ps_refuse(const char *sub, const char *why) {
+    printf("PRERUN_START\tREFUSE\tsub=%s\treason=%s\n", sub ? sub : "-", why ? why : "unknown");
+    return 2;
+}
+
+static char *ps_read_all(const char *path, size_t *n) {
+    unsigned char *b = 0; int64_t k = 0;
+    if (sy_read_file(path, &b, &k, 64 << 20)) return 0;
+    *n = (size_t)k;
+    return (char *)b;
+}
+
+static int ps_sha_buf(const char *data, size_t n, char hex[65]) {
+    return sy_sha256_hex(data, (long)n, hex);
+}
+
+static int ps_sha_file(const char *path, char hex[65]) {
+    size_t n = 0;
+    char *b = ps_read_all(path, &n);
+    if (!b) return -1;
+    int rc = ps_sha_buf(b, n, hex);
+    mm_free(b);
+    return rc;
+}
+
+static int ps_is_hex(const char *s, size_t len) {
+    if (len == 0) return 0;
+    for (size_t i = 0; i < len; i++) {
+        char c = s[i];
+        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 0;
+    }
+    return 1;
+}
+
+static int ps_is_digits(const char *s, size_t len) {
+    if (len == 0 || len > 5) return 0;
+    for (size_t i = 0; i < len; i++) if (s[i] < '0' || s[i] > '9') return 0;
+    return 1;
+}
+
+static int ps_starts(const char *s, const char *pre) {
+    size_t pl = strlen(pre);
+    return strlen(s) >= pl && memcmp(s, pre, pl) == 0;
+}
+
+static int ps_ends_cx(const char *s) {
+    size_t n = strlen(s);
+    return n >= 3 && memcmp(s + n - 3, ".cx", 3) == 0;
+}
+
+static int ps_prog_prefix(char **v, const char *prog) {
+    int c = 0;
+    if (ps_ends_cx(prog)) {
+        v[c++] = "sh";
+        v[c++] = "./unisacc.com";
+        v[c++] = (char *)prog;
+        v[c++] = "--";
+    } else {
+        v[c++] = (char *)prog;
+    }
+    return c;
+}
+
+static int ps_is_compile_smoke_id(const char *id) {
+    return ps_starts(id, "daily-compile-smoke-") || ps_starts(id, "compile-smoke-");
+}
+
+static int ps_is_early_canary_id(const char *id) {
+    return ps_starts(id, "ri-image-") || !strcmp(id, "ri-route-refuse") || !strcmp(id, "lane-key-probes") ||
+           ps_is_compile_smoke_id(id);
+}
+
+static int ps_is_warmup_excluded_id(const char *id) {
+    return !strcmp(id, "tools-default-regression") || !strcmp(id, "cx-booter-ape") ||
+           ps_starts(id, "unit-frontcache-") || ps_starts(id, "opt-frame4-");
+}
+
+static int ps_is_heavy_id(const char *id) {
+    static const char *builtin[] = {
+        "real-commit", "unit-frontcache-equiv3", "check-split-parents",
+        "check-gen-all-check", "check-gen-all-pass", "check-gen-all-hang",
+        "c-negative", "stream-pipe-parts", 0
+    };
+    for (int i = 0; builtin[i]; i++) if (!strcmp(id, builtin[i])) return 1;
+    if (ps_starts(id, "netregen-")) return 1;
+    return 0;
+}
+
+static int ps_find_id(const char *id) {
+    for (int i = 0; i < g_nids; i++) if (!strcmp(g_ids[i], id)) return i;
+    return -1;
+}
+
+static void ps_trim_line(char *s) {
+    size_t n = strlen(s);
+    while (n > 0 && (s[n - 1] == '\n' || s[n - 1] == '\r' || s[n - 1] == ' ' || s[n - 1] == '\t')) s[--n] = 0;
+}
+
+static int ps_git_out(const char *repo, char **argv, char *out, size_t cap) {
+    np_result r = {0}; char why[512];
+    if (np_run(argv, repo, 0, 30, &r, why, sizeof why) || r.rc || !r.out) {
+        np_free(&r);
+        return -1;
+    }
+    size_t n = r.outn < cap - 1 ? r.outn : cap - 1;
+    mm_copy(out, cap, r.out, n);
+    out[n] = 0;
+    ps_trim_line(out);
+    np_free(&r);
+    return 0;
+}
+
+static int ps_git_rev_triple(const char *repo, const char *s1, const char *s2, const char *s3,
+                             char h1[41], char h2[41], char h3[41]) {
+    char *v[] = {"git", "rev-parse", (char *)s1, (char *)s2, (char *)s3, 0};
+    char buf[384];
+    if (ps_git_out(repo, v, buf, sizeof buf)) return -1;
+    if (strlen(buf) < 122 || buf[40] != '\n' || buf[81] != '\n') return -1;
+    mm_copy(h1, 41, buf, 40); h1[40] = 0;
+    mm_copy(h2, 41, buf + 41, 40); h2[40] = 0;
+    mm_copy(h3, 41, buf + 82, 40); h3[40] = 0;
+    if (!ps_is_hex(h1, 40) || !ps_is_hex(h2, 40) || !ps_is_hex(h3, 40)) return -1;
+    return 0;
+}
+
+static int ps_git_clean_tracked(const char *repo) {
+    char *v[] = {"git", "status", "--porcelain", "--untracked-files=no", 0};
+    char buf[256];
+    if (ps_git_out(repo, v, buf, sizeof buf)) return -1;
+    return buf[0] == 0 ? 0 : 1;
+}
+
+static char *ps_git_show_alloc(const char *repo, const char *spec, size_t *out_n) {
+    char *v[] = {"git", "show", (char *)spec, 0};
+    np_result r = {0}; char why[512];
+    if (np_run(v, repo, 0, 30, &r, why, sizeof why) || r.rc || !r.out) {
+        np_free(&r);
+        return 0;
+    }
+    char *b = (char *)mm_alloc(r.outn + 1);
+    if (!b) { np_free(&r); return 0; }
+    if (r.outn) mm_copy(b, r.outn + 1, r.out, r.outn);
+    b[r.outn] = 0;
+    *out_n = r.outn;
+    np_free(&r);
+    return b;
+}
+
+static void ps_load_implemented_batches(const char *t, size_t n) {
+    g_nids = 0;
+    const char *p = t, *end = t + n;
+    int first = 1;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        char line[2048];
+        size_t cp = ll < sizeof line - 1 ? ll : sizeof line - 1;
+        mm_copy(line, sizeof line, p, cp);
+        line[cp] = 0;
+        p += ll + (nl ? 1 : 0);
+        if (first) { first = 0; continue; }
+        if (!line[0] || line[0] == '#') continue;
+        char *t1 = strchr(line, '\t');
+        if (!t1) continue;
+        *t1++ = 0;
+        char *t2 = strchr(t1, '\t');
+        if (t2) *t2 = 0;
+        if (strcmp(t1, "IMPLEMENTED") || strlen(line) >= PS_IDLEN || g_nids >= PS_MAXIDS) continue;
+        if (ps_find_id(line) >= 0) continue;
+        cx_fmt(g_ids[g_nids], PS_IDLEN, "%s", line);
+        g_src[g_nids] = 0;
+        g_nids++;
+    }
+}
+
+static int ps_batch_implemented_in(const char *t, size_t n, const char *id) {
+    const char *p = t, *end = t + n;
+    size_t il = strlen(id);
+    int first = 1;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        const char *row = p;
+        p += ll + (nl ? 1 : 0);
+        if (first) { first = 0; continue; }
+        if (ll > il + 12 && !memcmp(row, id, il) && row[il] == '\t' &&
+            !memcmp(row + il + 1, "IMPLEMENTED", 11) &&
+            (row[il + 12] == '\t' || row[il + 12] == '\r' || il + 12 == ll)) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static const char *ps_src_label(int mask) {
+    if (mask == 3) return "both";
+    if (mask == 2) return "added";
+    return "affected";
+}
+
+/* Compute cold_identity matching tools/prerun-drive.cx pd_cold_identity:
+ * sha256("warmup-cold-v1\n<tree_sha>\n<ape_sha>\n<batches_sha>\n"). */
+static int ps_compute_cold_identity(const char *repo, const char *rev, const char *ape,
+                                    char cold_id[65], char rev_sha[41], char tree_sha[41],
+                                    char ape_sha[65], char batches_sha[65]) {
+    char cspec[128], tspec[128], bspec[160], head_c[41];
+    const char *r = (rev && rev[0]) ? rev : "HEAD";
+    if (cx_fmt(cspec, sizeof cspec, "%s^{commit}", r) ||
+        cx_fmt(tspec, sizeof tspec, "%s^{tree}", r) ||
+        cx_fmt(bspec, sizeof bspec, "%s:tests/batches.tsv", r)) return -1;
+    if (ps_git_rev_triple(repo, cspec, tspec, "HEAD^{commit}", rev_sha, tree_sha, head_c)) return -1;
+    sy_stat_t st;
+    if (!ape || sy_stat(ape, &st) || st.kind != 'f' || ps_sha_file(ape, ape_sha)) return -1;
+    size_t bn = 0;
+    char *bt = 0;
+    char disk_bp[PS_PW];
+    if (!strcmp(rev_sha, head_c) && !cx_fmt(disk_bp, sizeof disk_bp, "%s/tests/batches.tsv", repo)) {
+        bt = ps_read_all(disk_bp, &bn);
+    }
+    if (!bt) bt = ps_git_show_alloc(repo, bspec, &bn);
+    if (!bt) return -1;
+    int brc = ps_sha_buf(bt, bn, batches_sha);
+    if (g_nids == 0) ps_load_implemented_batches(bt, bn);
+    mm_free(bt);
+    if (brc) return -1;
+    char payload[512];
+    if (cx_fmt(payload, sizeof payload, "warmup-cold-v1\n%s\n%s\n%s\n", tree_sha, ape_sha, batches_sha)) return -1;
+    return ps_sha_buf(payload, strlen(payload), cold_id);
+}
+
+static int ps_collect_admission_union(const char *root, const char *base_rev, const char *affected_prog,
+                                      char head_sha[41], char tree_sha[41], char base_sha[41],
+                                      char batches_sha[65], char *why, size_t wcap) {
+    char bspec[128], disk_bp[PS_PW];
+    if (ps_git_clean_tracked(root) != 0) { cx_fmt(why, wcap, "dirty-tree"); return -1; }
+    if (cx_fmt(bspec, sizeof bspec, "%s^{commit}", base_rev) ||
+        ps_git_rev_triple(root, "HEAD^{commit}", "HEAD^{tree}", bspec, head_sha, tree_sha, base_sha)) {
+        cx_fmt(why, wcap, "rev-resolve-failed"); return -1;
+    }
+    size_t hbn = 0, pbn = 0;
+    cx_fmt(disk_bp, sizeof disk_bp, "%s/tests/batches.tsv", root);
+    char *hbt = ps_read_all(disk_bp, &hbn);
+    if (!hbt) { cx_fmt(why, wcap, "head-batches-unreadable"); return -1; }
+    if (ps_sha_buf(hbt, hbn, batches_sha)) { mm_free(hbt); cx_fmt(why, wcap, "batches-sha-failed"); return -1; }
+    ps_load_implemented_batches(hbt, hbn);
+    mm_free(hbt);
+    if (g_nids <= 0) { cx_fmt(why, wcap, "no-implemented-batches"); return -1; }
+
+    char pbspec[160];
+    cx_fmt(pbspec, sizeof pbspec, "%s:tests/batches.tsv", base_sha);
+    char *pbt = ps_git_show_alloc(root, pbspec, &pbn);
+    if (!pbt) { cx_fmt(why, wcap, "base-batches-unreadable"); return -1; }
+    for (int i = 0; i < g_nids; i++) {
+        if (!ps_batch_implemented_in(pbt, pbn, g_ids[i])) g_src[i] |= 2;
+    }
+    mm_free(pbt);
+
+    char *av[12];
+    int ac = ps_prog_prefix(av, affected_prog);
+    av[ac++] = "--since"; av[ac++] = base_sha;
+    av[ac++] = "--list-only";
+    av[ac] = 0;
+    np_result r = {0}; char rwhy[512];
+    if (np_run(av, root, 0, 50, &r, rwhy, sizeof rwhy) || r.rc != 0 || !r.out) {
+        np_free(&r);
+        cx_fmt(why, wcap, "affected-run-failed");
+        return -1;
+    }
+    int saw_summary = 0;
+    const char *p = r.out, *end = r.out + r.outn;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        char line[1024];
+        size_t cp = ll < sizeof line - 1 ? ll : sizeof line - 1;
+        mm_copy(line, sizeof line, p, cp);
+        line[cp] = 0;
+        ps_trim_line(line);
+        p += ll + (nl ? 1 : 0);
+        if (ps_starts(line, "AFFECTED_SUMMARY\t")) saw_summary = 1;
+        if (!ps_starts(line, "AFFECTED\t")) continue;
+        char *id = line + 9;
+        char *tb = strchr(id, '\t');
+        if (tb) *tb = 0;
+        int ix = ps_find_id(id);
+        if (ix >= 0) g_src[ix] |= 1;
+    }
+    np_free(&r);
+    if (!saw_summary) { cx_fmt(why, wcap, "affected-missing-summary"); return -1; }
+    return 0;
+}
+
+/* Parse a dvqualify strict evidence file and compute:
+ *   - file_sha_out: 64-hex SHA256 of the entire strict file bytes
+ *   - row_sha_out:  64-hex SHA256 of the trimmed summary row line (without trailing LF/CR)
+ *   - raw_sha_out:  64-hex SHA256 of the trimmed RAW\tBATCH_RUN\t... line (without trailing LF/CR)
+ *   - status_out, ms_out (`col 6`), raw_line_out. */
+static int ps_parse_dvqualify_strict(const char *path, const char *want_id, const char *want_cand,
+                                     char status_out[32], long *ms_out, char *raw_line_out, size_t raw_cap,
+                                     char file_sha_out[65], char row_sha_out[65], char raw_sha_out[65]) {
+    size_t n = 0;
+    char *b = ps_read_all(path, &n);
+    if (!b) return -1;
+    status_out[0] = 0;
+    *ms_out = 0;
+    raw_line_out[0] = 0;
+    file_sha_out[0] = 0;
+    row_sha_out[0] = 0;
+    raw_sha_out[0] = 0;
+    if (ps_sha_buf(b, n, file_sha_out)) { mm_free(b); return -1; }
+
+    int got_row = 0, got_raw = 0;
+    const char *p = b, *end = b + n;
+    size_t il = strlen(want_id);
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        size_t rll = ll;
+        if (rll > 0 && p[rll - 1] == '\r') rll--;
+        if (rll > 14 && !memcmp(p, "RAW\tBATCH_RUN\t", 14)) {
+            char id_pat[PS_IDLEN + 8], cand_pat[80];
+            cx_fmt(id_pat, sizeof id_pat, "\tid=%s\t", want_id);
+            cx_fmt(cand_pat, sizeof cand_pat, "\tcandidate=%s", want_cand);
+            if (tx_find(p, (long)rll, id_pat, (long)strlen(id_pat)) >= 0) {
+                size_t cp = rll < raw_cap - 1 ? rll : raw_cap - 1;
+                mm_copy(raw_line_out, raw_cap, p, cp);
+                raw_line_out[cp] = 0;
+                ps_sha_buf(p, rll, raw_sha_out);
+                long cpos = tx_find(p, (long)rll, cand_pat, (long)strlen(cand_pat));
+                int cand_ok = 0;
+                if (cpos >= 0) {
+                    size_t after = (size_t)cpos + strlen(cand_pat);
+                    if (after == rll || p[after] == '\t') cand_ok = 1;
+                }
+                if (tx_find(p, (long)rll, "\tstatus=PASS\t", 13) >= 0 &&
+                    tx_find(p, (long)rll, "\trc=0\t", 6) >= 0 && cand_ok) {
+                    got_raw = 1;
+                }
+            }
+        } else if (rll > il + 1 && !memcmp(p, want_id, il) && p[il] == '\t') {
+            ps_sha_buf(p, rll, row_sha_out);
+            char line[2048];
+            size_t cp = rll < sizeof line - 1 ? rll : sizeof line - 1;
+            mm_copy(line, sizeof line, p, cp);
+            line[cp] = 0;
+            char *cols[10]; int nc = 0; char *q = line;
+            while (nc < 10) {
+                cols[nc++] = q;
+                char *tb = strchr(q, '\t');
+                if (!tb) break;
+                *tb = 0;
+                q = tb + 1;
+            }
+            if (nc >= 6) {
+                cx_fmt(status_out, 32, "%s", cols[2]);
+                if (ps_is_digits(cols[5], strlen(cols[5]))) {
+                    *ms_out = atol(cols[5]);
+                    if (!strcmp(cols[2], "PASS") && !strcmp(cols[3], "0") && !strcmp(cols[4], want_cand)) {
+                        got_row = 1;
+                    }
+                }
+            }
+        }
+        p += ll + (nl ? 1 : 0);
+    }
+    mm_free(b);
+    return (got_row && got_raw) ? 0 : -1;
+}
+
+static int ps_is_eligible_warmup_batch(int ix) {
+    if (ix < 0 || ix >= g_nids) return 0;
+    const char *id = g_ids[ix];
+    if (g_src[ix] != 0) return 0; /* D1 priority (affected U added) excluded from W0000 warmup */
+    if (ps_is_heavy_id(id) || ps_is_early_canary_id(id) || ps_is_warmup_excluded_id(id)) return 0;
+    return 1;
+}
+
+/* Parse and validate an 8-column warmup-cold-v2 receipt AND re-read the referenced strict evidence file:
+ * Line 1: warmup-cold-v2\t<64_hex_cold_identity>\n
+ * Line 2: <batch_id>\tPASS\tcold-cache-off\t<ms>\t<strict_relpath>\t<strict_file_sha256>\t<strict_row_sha256>\t<raw_row_sha256>\n */
+static int ps_verify_cold_v2_file(const char *cpath, const char *want_cold_id, const char *want_cand_sha,
+                                  int check_prio, char batch_out[PS_IDLEN], long *ms_out,
+                                  char *why, size_t wcap) {
+    batch_out[0] = 0;
+    *ms_out = 0;
+    size_t cn = 0;
+    char *cb = ps_read_all(cpath, &cn);
+    if (!cb) { cx_fmt(why, wcap, "cold-v2-receipt-missing"); return -1; }
+    if (cn <= 80 || cn > 1024) { mm_free(cb); cx_fmt(why, wcap, "cold-v2-size-invalid"); return -1; }
+    if (!memcmp(cb, "warmup-cold-v1\t", 15)) { mm_free(cb); cx_fmt(why, wcap, "cold-v1-rejected-need-v2"); return -1; }
+    if (memcmp(cb, "warmup-cold-v2\t", 15) != 0 || cb[79] != '\n') {
+        mm_free(cb);
+        cx_fmt(why, wcap, "cold-v2-header-invalid");
+        return -1;
+    }
+    char hdr_id[65];
+    mm_copy(hdr_id, sizeof hdr_id, cb + 15, 64);
+    hdr_id[64] = 0;
+    if (!ps_is_hex(hdr_id, 64)) { mm_free(cb); cx_fmt(why, wcap, "cold-v2-header-hex-invalid"); return -1; }
+    if (strcmp(hdr_id, want_cold_id) != 0) {
+        mm_free(cb);
+        cx_fmt(why, wcap, "cold-identity-mismatch");
+        return -1;
+    }
+    size_t end_n = cn;
+    if (cb[end_n - 1] == '\n') end_n--;
+    const char *row = cb + 80;
+    const char *end = cb + end_n;
+    if (row >= end || memchr(row, '\n', (size_t)(end - row)) != 0 || memchr(row, '\r', (size_t)(end - row)) != 0) {
+        mm_free(cb);
+        cx_fmt(why, wcap, "cold-v2-must-have-single-data-row");
+        return -1;
+    }
+    char line[768];
+    size_t rlen = (size_t)(end - row);
+    if (rlen >= sizeof line) { mm_free(cb); cx_fmt(why, wcap, "cold-v2-row-too-long"); return -1; }
+    mm_copy(line, sizeof line, row, rlen);
+    line[rlen] = 0;
+    mm_free(cb);
+
+    char *cols[10]; int nc = 0; char *q = line;
+    while (nc < 10) {
+        cols[nc++] = q;
+        char *tb = strchr(q, '\t');
+        if (!tb) break;
+        *tb = 0;
+        q = tb + 1;
+    }
+    if (nc != 8) { cx_fmt(why, wcap, "cold-v2-row-columns-must-be-8"); return -1; }
+    if (strcmp(cols[1], "PASS") != 0) { cx_fmt(why, wcap, "cold-v2-status-not-pass"); return -1; }
+    if (strcmp(cols[2], "cold-cache-off") != 0) { cx_fmt(why, wcap, "cold-v2-source-must-be-cold-cache-off"); return -1; }
+    size_t mlen = strlen(cols[3]);
+    if (mlen == 0 || mlen > 5 || !ps_is_digits(cols[3], mlen)) {
+        cx_fmt(why, wcap, "cold-v2-ms-malformed");
+        return -1;
+    }
+    long ms = atol(cols[3]);
+    if (ms <= 0 || ms >= PS_COLD_V2_LIMIT_MS) {
+        cx_fmt(why, wcap, "cold-v2-ms-out-of-range");
+        return -1;
+    }
+    int ix = ps_find_id(cols[0]);
+    if (ix < 0 || ps_is_heavy_id(cols[0]) || ps_is_early_canary_id(cols[0]) ||
+        ps_is_warmup_excluded_id(cols[0]) || (check_prio && g_src[ix] != 0)) {
+        cx_fmt(why, wcap, "cold-v2-batch-ineligible");
+        return -1;
+    }
+    char want_rel[PS_IDLEN + 16];
+    cx_fmt(want_rel, sizeof want_rel, "qualify-%s.tsv", cols[0]);
+    if (strcmp(cols[4], want_rel) != 0 || strchr(cols[4], '/') != 0) {
+        cx_fmt(why, wcap, "cold-v2-strict-relpath-invalid");
+        return -1;
+    }
+    if (strlen(cols[5]) != 64 || !ps_is_hex(cols[5], 64) ||
+        strlen(cols[6]) != 64 || !ps_is_hex(cols[6], 64) ||
+        strlen(cols[7]) != 64 || !ps_is_hex(cols[7], 64)) {
+        cx_fmt(why, wcap, "cold-v2-hash-columns-invalid");
+        return -1;
+    }
+
+    /* Resolve <dirname(cpath)>/<strict_relpath> and re-verify strict file SHA, row SHA, RAW SHA, candidate, and ms. */
+    char dir_part[PS_PW], spath[PS_PW];
+    const char *slash = strrchr(cpath, '/');
+    if (slash) {
+        size_t dl = (size_t)(slash - cpath);
+        if (dl >= sizeof dir_part) { cx_fmt(why, wcap, "cold-v2-dir-bound"); return -1; }
+        mm_copy(dir_part, sizeof dir_part, cpath, dl);
+        dir_part[dl] = 0;
+        if (cx_fmt(spath, sizeof spath, "%s/%s", dir_part, cols[4])) { cx_fmt(why, wcap, "cold-v2-path-bound"); return -1; }
+    } else {
+        cx_fmt(spath, sizeof spath, "%s", cols[4]);
+    }
+
+    char st_str[32], raw_line[2048], fsha[65], rsha[65], rawsha[65];
+    long strict_ms = 0;
+    int prc = ps_parse_dvqualify_strict(spath, cols[0], want_cand_sha, st_str, &strict_ms,
+                                        raw_line, sizeof raw_line, fsha, rsha, rawsha);
+    if (!fsha[0]) { cx_fmt(why, wcap, "cold-v2-strict-file-missing"); return -1; }
+    if (strcmp(fsha, cols[5]) != 0) { cx_fmt(why, wcap, "cold-v2-strict-file-sha-mismatch"); return -1; }
+    if (prc != 0) { cx_fmt(why, wcap, "cold-v2-strict-evidence-invalid"); return -1; }
+    if (strcmp(rsha, cols[6]) != 0) { cx_fmt(why, wcap, "cold-v2-strict-row-sha-mismatch"); return -1; }
+    if (strcmp(rawsha, cols[7]) != 0) { cx_fmt(why, wcap, "cold-v2-raw-row-sha-mismatch"); return -1; }
+    if (strict_ms != ms) { cx_fmt(why, wcap, "cold-v2-strict-ms-mismatch"); return -1; }
+
+    cx_fmt(batch_out, PS_IDLEN, "%s", cols[0]);
+    *ms_out = ms;
+    return 0;
+}
+
+static int ps_cmd_admission(int argc, char **argv) {
+    const char *root = 0, *base = 0, *cand = 0, *out = 0, *wbatch = 0;
+    const char *dvprog = "tools/dvqualify.cx", *afprog = "tools/affected.cx";
+    for (int i = 2; i < argc; i++) {
+        const char *k = argv[i], *v = i + 1 < argc ? argv[i + 1] : 0;
+        if (!v) return ps_refuse("admission", "missing-value");
+        if (!strcmp(k, "--root")) root = v;
+        else if (!strcmp(k, "--base") || !strcmp(k, "--since")) base = v;
+        else if (!strcmp(k, "--candidate") || !strcmp(k, "--ape")) cand = v;
+        else if (!strcmp(k, "--out") || !strcmp(k, "--dir")) out = v;
+        else if (!strcmp(k, "--warmup-batch")) wbatch = v;
+        else if (!strcmp(k, "--cold-mode")) {
+            if (strcmp(v, "cold-cache-off") != 0) return ps_refuse("admission", "only-cold-cache-off-allowed");
+        }
+        else if (!strcmp(k, "--dvqualify-prog")) dvprog = v;
+        else if (!strcmp(k, "--affected-prog")) afprog = v;
+        else return ps_refuse("admission", "unknown-option");
+        i++;
+    }
+    if (!root || !base || !cand || !out) return ps_refuse("admission", "need-root-base-candidate-out");
+
+    char rroot[PS_PW], rcand[PS_PW], cand_sha[65];
+    if (sy_realpath(root, rroot, sizeof rroot) < 0) return ps_refuse("admission", "root-unresolvable");
+    sy_stat_t st;
+    if (sy_realpath(cand, rcand, sizeof rcand) < 0 || sy_stat(rcand, &st) || st.kind != 'f' || ps_sha_file(rcand, cand_sha))
+        return ps_refuse("admission", "candidate-missing");
+    if (sy_mkdir_all(out, 0700)) return ps_refuse("admission", "out-mkdir-failed");
+
+    char head_sha[41], tree_sha[41], base_sha[41], batches_sha[65], why[256];
+    if (ps_collect_admission_union(rroot, base, afprog, head_sha, tree_sha, base_sha, batches_sha, why, sizeof why))
+        return ps_refuse("admission", why);
+
+    char cold_id[65], c_rev[41], c_tree[41], c_ape[65], c_bat[65];
+    if (ps_compute_cold_identity(rroot, "HEAD", rcand, cold_id, c_rev, c_tree, c_ape, c_bat))
+        return ps_refuse("admission", "cold-identity-compute-failed");
+
+    int w_ix = -1;
+    if (wbatch && wbatch[0]) {
+        w_ix = ps_find_id(wbatch);
+        if (!ps_is_eligible_warmup_batch(w_ix)) return ps_refuse("admission", "warmup-batch-ineligible");
+    } else {
+        for (int i = 0; i < g_nids; i++) {
+            if (ps_is_eligible_warmup_batch(i)) { w_ix = i; break; }
+        }
+        if (w_ix < 0) return ps_refuse("admission", "no-eligible-cold-warmup-batch");
+    }
+
+    char rpath[PS_PW], ppath[PS_PW], cpath[PS_PW];
+    cx_fmt(rpath, sizeof rpath, "%s/admission-receipt.tsv", out);
+    cx_fmt(ppath, sizeof ppath, "%s/priority.tsv", out);
+    cx_fmt(cpath, sizeof cpath, "%s/warmup-cold.tsv", out);
+    sy_unlink(rpath);
+    sy_unlink(ppath);
+    sy_unlink(cpath);
+
+    int nsel = 0;
+    for (int i = 0; i < g_nids; i++) if (g_src[i]) nsel++;
+
+    np_buf rec = {0}, pri = {0};
+    char hdr[1024];
+    cx_fmt(hdr, sizeof hdr,
+           "# prerun-start D1 admission receipt (schema=v2)\n"
+           "ADMISSION_META\tschema=v2\thead=%s\ttree=%s\tbase=%s\tcandidate_sha256=%s\tbatches_sha256=%s\tcold_identity=%s\tcount=%d\n"
+           "batch\tsource\tstatus\trc\tcandidate_sha256\tms\traw_sha256\n",
+           head_sha, tree_sha, base_sha, cand_sha, batches_sha, cold_id, nsel);
+    np_puts(&rec, hdr);
+    np_puts(&pri, "batch\tdomain\tstatus\n");
+
+    for (int i = 0; i < g_nids; i++) {
+        if (!g_src[i]) continue;
+        char bfile[PS_PW];
+        cx_fmt(bfile, sizeof bfile, "%s/qualify-%s.tsv", out, g_ids[i]);
+        sy_unlink(bfile);
+
+        char *dv[20];
+        int dc = ps_prog_prefix(dv, dvprog);
+        dv[dc++] = rroot;
+        dv[dc++] = "--candidate"; dv[dc++] = rcand;
+        dv[dc++] = "--ids"; dv[dc++] = g_ids[i];
+        dv[dc++] = "--jobs"; dv[dc++] = "1";
+        dv[dc++] = "--segment-batches"; dv[dc++] = "1";
+        dv[dc++] = "--out"; dv[dc++] = bfile;
+        dv[dc] = 0;
+
+        np_result dr = {0}; char dwhy[512];
+        int tr = np_run(dv, rroot, 0, 55, &dr, dwhy, sizeof dwhy);
+        int drc = tr ? 2 : dr.rc;
+        np_free(&dr);
+
+        char st_str[32] = "MISSING", raw_line[2048] = "", f_sha[65] = "-", r_sha[65] = "-", raw_sha[65] = "-";
+        long ms = 0;
+        int p_ok = (ps_parse_dvqualify_strict(bfile, g_ids[i], cand_sha, st_str, &ms,
+                                              raw_line, sizeof raw_line, f_sha, r_sha, raw_sha) == 0);
+        int ok = (drc == 0 && p_ok);
+        char row[1024], prow[256];
+        cx_fmt(row, sizeof row, "%s\t%s\t%s\t%d\t%s\t%ld\t%s\n%s\n",
+               g_ids[i], ps_src_label(g_src[i]), ok ? "PASS" : (st_str[0] ? st_str : "FAIL"),
+               drc, cand_sha, ms, raw_sha, raw_line);
+        np_puts(&rec, row);
+        cx_fmt(prow, sizeof prow, "%s\tadmission-%s\tFAIL\n", g_ids[i], ps_src_label(g_src[i]));
+        np_puts(&pri, prow);
+        if (!ok) {
+            (void)cx_write(rpath, rec.p ? rec.p : "", rec.n);
+            (void)cx_write(ppath, pri.p ? pri.p : "", pri.n);
+            free(rec.p); free(pri.p);
+            printf("PRERUN_START\tADMISSION\tFAIL\tbatch=%s\tstatus=%s\trc=%d\tcandidate=%s\n",
+                   g_ids[i], st_str[0] ? st_str : "FAIL", drc ? drc : 1, cand_sha);
+            return 1;
+        }
+    }
+
+    /* Run the selected W0000 warmup batch cold (UNISACC_RUN_CACHE=0) via dvqualify and bind the strict evidence file. */
+    char wfile[PS_PW], wrel[PS_IDLEN + 16];
+    cx_fmt(wrel, sizeof wrel, "qualify-%s.tsv", g_ids[w_ix]);
+    cx_fmt(wfile, sizeof wfile, "%s/%s", out, wrel);
+    sy_unlink(wfile);
+    char *wdv[20];
+    int wdc = ps_prog_prefix(wdv, dvprog);
+    wdv[wdc++] = rroot;
+    wdv[wdc++] = "--candidate"; wdv[wdc++] = rcand;
+    wdv[wdc++] = "--ids"; wdv[wdc++] = g_ids[w_ix];
+    wdv[wdc++] = "--jobs"; wdv[wdc++] = "1";
+    wdv[wdc++] = "--segment-batches"; wdv[wdc++] = "1";
+    wdv[wdc++] = "--out"; wdv[wdc++] = wfile;
+    wdv[wdc] = 0;
+    char *cenv[] = {"UNISACC_RUN_CACHE=0", 0};
+    np_result wdr = {0}; char wdwhy[512];
+    int wtr = np_run(wdv, rroot, cenv, 55, &wdr, wdwhy, sizeof wdwhy);
+    int wdrc = wtr ? 2 : wdr.rc;
+    np_free(&wdr);
+
+    char wst_str[32] = "MISSING", wraw_line[2048] = "", wf_sha[65] = "", wr_sha[65] = "", wraw_sha[65] = "";
+    long strict_ms = 0;
+    int wok = (wdrc == 0 && ps_parse_dvqualify_strict(wfile, g_ids[w_ix], cand_sha, wst_str, &strict_ms,
+                                                      wraw_line, sizeof wraw_line, wf_sha, wr_sha, wraw_sha) == 0);
+    if (!wok) {
+        free(rec.p); free(pri.p);
+        printf("PRERUN_START\tADMISSION\tFAIL\tbatch=%s\tstatus=%s\trc=%d\tcandidate=%s\n",
+               g_ids[w_ix], wst_str[0] ? wst_str : "FAIL", wdrc ? wdrc : 1, cand_sha);
+        return 1;
+    }
+    if (strict_ms <= 0 || strict_ms >= PS_COLD_V2_LIMIT_MS) {
+        free(rec.p); free(pri.p);
+        return ps_refuse("admission", "cold-warmup-ms-out-of-range");
+    }
+
+    char ctext[768];
+    cx_fmt(ctext, sizeof ctext,
+           "warmup-cold-v2\t%s\n%s\tPASS\tcold-cache-off\t%ld\t%s\t%s\t%s\t%s\n",
+           cold_id, g_ids[w_ix], strict_ms, wrel, wf_sha, wr_sha, wraw_sha);
+
+    if (cx_write(rpath, rec.p ? rec.p : "", rec.n) ||
+        cx_write(ppath, pri.p ? pri.p : "", pri.n) ||
+        cx_write(cpath, ctext, strlen(ctext))) {
+        free(rec.p); free(pri.p);
+        return ps_refuse("admission", "receipt-write-failed");
+    }
+    free(rec.p); free(pri.p);
+    printf("PRERUN_START\tADMISSION\tPASS\ttree=%s\tbase=%s\tcandidate=%s\tbatches=%d\twarmup=%s\tcold_mode=cold-cache-off\tcold_ms=%ld\tcold_identity=%s\tstrict_sha=%s\treceipt=%s\tpriority=%s\tcold_receipt=%s\n",
+           tree_sha, base_sha, cand_sha, nsel, g_ids[w_ix], strict_ms, cold_id, wf_sha, rpath, ppath, cpath);
+    return 0;
+}
+
+static int ps_kv_get(const char *line, const char *key, char *out, size_t cap) {
+    long k = tx_find(line, (long)strlen(line), key, (long)strlen(key));
+    out[0] = 0;
+    if (k < 0) return -1;
+    const char *p = line + k + strlen(key);
+    size_t j = 0;
+    while (p[j] && p[j] != '\t' && p[j] != '\n' && p[j] != '\r' && j + 1 < cap) {
+        out[j] = p[j];
+        j++;
+    }
+    out[j] = 0;
+    return 0;
+}
+
+/* Verify on-disk windows.tsv W0000 matches the proven warmup batch and v4 proof comment
+ * ("# w0000-proof=cold-v2\t<cold_identity>\t<batch_id>\n") without modifying windows.tsv. */
+static int ps_verify_plan_windows_w0000(const char *wpath, const char *want_cold_id,
+                                        const char *want_batch, char *why, size_t wcap) {
+    size_t n = 0;
+    char *b = ps_read_all(wpath, &n);
+    if (!b) { cx_fmt(why, wcap, "plan-windows-unreadable"); return -1; }
+    char want_proof[256];
+    cx_fmt(want_proof, sizeof want_proof, "# w0000-proof=cold-v2\t%s\t%s\n", want_cold_id, want_batch);
+    int saw_proof = tx_find(b, (long)n, want_proof, (long)strlen(want_proof)) >= 0;
+    int saw_w0 = 0, w0_ok = 0;
+    const char *p = b, *end = b + n;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        if (ll > 6 && !memcmp(p, "W0000\t", 6)) {
+            saw_w0 = 1;
+            char line[512];
+            size_t cp = ll < sizeof line - 1 ? ll : sizeof line - 1;
+            mm_copy(line, sizeof line, p, cp);
+            line[cp] = 0;
+            ps_trim_line(line);
+            char *cols[6]; int nc = 0; char *q = line;
+            while (nc < 6) {
+                cols[nc++] = q;
+                char *tb = strchr(q, '\t');
+                if (!tb) break;
+                *tb = 0;
+                q = tb + 1;
+            }
+            if (nc == 5 && !strcmp(cols[1], "1") && !strcmp(cols[2], "warmup") &&
+                !strcmp(cols[3], "1") && !strcmp(cols[4], want_batch)) {
+                w0_ok = 1;
+            }
+            break;
+        }
+        p += ll + (nl ? 1 : 0);
+    }
+    mm_free(b);
+    if (!saw_proof) { cx_fmt(why, wcap, "plan-windows-missing-cold-v2-proof-header"); return -1; }
+    if (!saw_w0 || !w0_ok) { cx_fmt(why, wcap, "plan-windows-w0000-mismatch"); return -1; }
+    return 0;
+}
+
+static int ps_cmd_verify_admission(int argc, char **argv) {
+    const char *root = 0, *base = 0, *cand = 0, *out = 0, *plan_win = 0;
+    const char *afprog = "tools/affected.cx";
+    for (int i = 2; i < argc; i++) {
+        const char *k = argv[i], *v = i + 1 < argc ? argv[i + 1] : 0;
+        if (!v) return ps_refuse("verify-admission", "missing-value");
+        if (!strcmp(k, "--root")) root = v;
+        else if (!strcmp(k, "--base") || !strcmp(k, "--since")) base = v;
+        else if (!strcmp(k, "--candidate") || !strcmp(k, "--ape")) cand = v;
+        else if (!strcmp(k, "--out") || !strcmp(k, "--dir")) out = v;
+        else if (!strcmp(k, "--affected-prog")) afprog = v;
+        else if (!strcmp(k, "--plan-windows")) plan_win = v;
+        else return ps_refuse("verify-admission", "unknown-option");
+        i++;
+    }
+    if (!root || !base || !cand || !out) return ps_refuse("verify-admission", "need-root-base-candidate-out");
+
+    char rroot[PS_PW], rcand[PS_PW], cand_sha[65];
+    if (sy_realpath(root, rroot, sizeof rroot) < 0) return ps_refuse("verify-admission", "root-unresolvable");
+    sy_stat_t st;
+    if (sy_realpath(cand, rcand, sizeof rcand) < 0 || sy_stat(rcand, &st) || st.kind != 'f' || ps_sha_file(rcand, cand_sha))
+        return ps_refuse("verify-admission", "candidate-missing");
+
+    char head_sha[41], tree_sha[41], base_sha[41], batches_sha[65], why[256];
+    if (ps_collect_admission_union(rroot, base, afprog, head_sha, tree_sha, base_sha, batches_sha, why, sizeof why))
+        return ps_refuse("verify-admission", why);
+
+    char cold_id[65], c_rev[41], c_tree[41], c_ape[65], c_bat[65];
+    if (ps_compute_cold_identity(rroot, "HEAD", rcand, cold_id, c_rev, c_tree, c_ape, c_bat))
+        return ps_refuse("verify-admission", "cold-identity-compute-failed");
+
+    char rpath[PS_PW], ppath[PS_PW], cpath[PS_PW];
+    cx_fmt(rpath, sizeof rpath, "%s/admission-receipt.tsv", out);
+    cx_fmt(ppath, sizeof ppath, "%s/priority.tsv", out);
+    cx_fmt(cpath, sizeof cpath, "%s/warmup-cold.tsv", out);
+    size_t rn = 0, pn = 0;
+    char *rt = ps_read_all(rpath, &rn);
+    if (!rt) return ps_refuse("verify-admission", "receipt-missing");
+    char *pt = ps_read_all(ppath, &pn);
+    if (!pt) { mm_free(rt); return ps_refuse("verify-admission", "priority-missing"); }
+
+    char m_tree[65] = "", m_base[65] = "", m_cand[65] = "", m_bsha[65] = "";
+    static int seen_pass[PS_MAXIDS], seen_raw[PS_MAXIDS], seen_prio[PS_MAXIDS];
+    for (int i = 0; i < g_nids; i++) { seen_pass[i] = 0; seen_raw[i] = 0; seen_prio[i] = 0; }
+
+    int got_meta = 0;
+    const char *p = rt, *end = rt + rn;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        char line[2048];
+        size_t cp = ll < sizeof line - 1 ? ll : sizeof line - 1;
+        mm_copy(line, sizeof line, p, cp);
+        line[cp] = 0;
+        ps_trim_line(line);
+        p += ll + (nl ? 1 : 0);
+        if (!line[0] || line[0] == '#' || ps_starts(line, "batch\t")) continue;
+        if (ps_starts(line, "ADMISSION_META\t")) {
+            got_meta = 1;
+            ps_kv_get(line, "\ttree=", m_tree, sizeof m_tree);
+            ps_kv_get(line, "\tbase=", m_base, sizeof m_base);
+            ps_kv_get(line, "\tcandidate_sha256=", m_cand, sizeof m_cand);
+            ps_kv_get(line, "\tbatches_sha256=", m_bsha, sizeof m_bsha);
+            continue;
+        }
+        if (ps_starts(line, "RAW\tBATCH_RUN\t")) {
+            char rid[PS_IDLEN] = "", rst[32] = "", rrc[16] = "", rcand_s[65] = "";
+            ps_kv_get(line, "\tid=", rid, sizeof rid);
+            ps_kv_get(line, "\tstatus=", rst, sizeof rst);
+            ps_kv_get(line, "\trc=", rrc, sizeof rrc);
+            ps_kv_get(line, "\tcandidate=", rcand_s, sizeof rcand_s);
+            int ix = ps_find_id(rid);
+            if (ix >= 0 && !strcmp(rst, "PASS") && !strcmp(rrc, "0") && !strcmp(rcand_s, cand_sha))
+                seen_raw[ix] = 1;
+            continue;
+        }
+        char *cols[8]; int nc = 0; char *q = line;
+        while (nc < 8) {
+            cols[nc++] = q;
+            char *tb = strchr(q, '\t');
+            if (!tb) break;
+            *tb = 0;
+            q = tb + 1;
+        }
+        if (nc >= 7) {
+            int ix = ps_find_id(cols[0]);
+            if (ix < 0) { mm_free(rt); mm_free(pt); return ps_refuse("verify-admission", "unknown-batch-in-receipt"); }
+            if (strcmp(cols[2], "PASS") || strcmp(cols[3], "0")) {
+                mm_free(rt); mm_free(pt);
+                return ps_refuse("verify-admission", "receipt-status-not-pass");
+            }
+            if (strcmp(cols[4], cand_sha)) {
+                mm_free(rt); mm_free(pt);
+                return ps_refuse("verify-admission", "receipt-row-candidate-mismatch");
+            }
+            seen_pass[ix] = 1;
+        }
+    }
+    mm_free(rt);
+
+    if (!got_meta) { mm_free(pt); return ps_refuse("verify-admission", "missing-meta"); }
+    if (strcmp(m_tree, tree_sha)) { mm_free(pt); return ps_refuse("verify-admission", "tree-mismatch"); }
+    if (strcmp(m_base, base_sha)) { mm_free(pt); return ps_refuse("verify-admission", "base-mismatch"); }
+    if (strcmp(m_cand, cand_sha)) { mm_free(pt); return ps_refuse("verify-admission", "candidate-mismatch"); }
+    if (strcmp(m_bsha, batches_sha)) { mm_free(pt); return ps_refuse("verify-admission", "batches-table-mismatch"); }
+
+    p = pt; end = pt + pn;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        char line[512];
+        size_t cp = ll < sizeof line - 1 ? ll : sizeof line - 1;
+        mm_copy(line, sizeof line, p, cp);
+        line[cp] = 0;
+        ps_trim_line(line);
+        p += ll + (nl ? 1 : 0);
+        if (!line[0] || line[0] == '#' || ps_starts(line, "batch\t")) continue;
+        char *tb = strchr(line, '\t');
+        if (tb) *tb = 0;
+        int ix = ps_find_id(line);
+        if (ix >= 0) seen_prio[ix] = 1;
+    }
+    mm_free(pt);
+
+    int verified = 0;
+    for (int i = 0; i < g_nids; i++) {
+        if (!g_src[i]) continue;
+        if (!seen_pass[i] || !seen_raw[i]) {
+            char msg[256];
+            cx_fmt(msg, sizeof msg, "missing-batch-pass:%s", g_ids[i]);
+            return ps_refuse("verify-admission", msg);
+        }
+        if (!seen_prio[i]) {
+            char msg[256];
+            cx_fmt(msg, sizeof msg, "priority-missing-batch:%s", g_ids[i]);
+            return ps_refuse("verify-admission", msg);
+        }
+        verified++;
+    }
+
+    char wbatch[PS_IDLEN] = "";
+    long cms = 0;
+    if (ps_verify_cold_v2_file(cpath, cold_id, cand_sha, 1, wbatch, &cms, why, sizeof why))
+        return ps_refuse("verify-admission", why);
+
+    if (plan_win && plan_win[0]) {
+        if (ps_verify_plan_windows_w0000(plan_win, cold_id, wbatch, why, sizeof why))
+            return ps_refuse("verify-admission", why);
+    }
+
+    printf("PRERUN_START\tADMISSION_VERIFY\tPASS\ttree=%s\tbase=%s\tcandidate=%s\tbatches=%d\twarmup=%s\tcold_mode=cold-cache-off\tcold_ms=%ld\tcold_identity=%s\n",
+           tree_sha, base_sha, cand_sha, verified, wbatch, cms, cold_id);
+    return 0;
+}
+
+static int ps_cmd_verify_cold_v2(int argc, char **argv) {
+    const char *root = 0, *cand = 0, *coldf = 0, *rev = "HEAD";
+    for (int i = 2; i < argc; i++) {
+        const char *k = argv[i], *v = i + 1 < argc ? argv[i + 1] : 0;
+        if (!v) return ps_refuse("verify-cold-v2", "missing-value");
+        if (!strcmp(k, "--root") || !strcmp(k, "--repo")) root = v;
+        else if (!strcmp(k, "--candidate") || !strcmp(k, "--ape")) cand = v;
+        else if (!strcmp(k, "--cold-times-file")) coldf = v;
+        else if (!strcmp(k, "--rev")) rev = v;
+        else return ps_refuse("verify-cold-v2", "unknown-option");
+        i++;
+    }
+    if (!root || !cand || !coldf) return ps_refuse("verify-cold-v2", "need-root-candidate-coldtimes");
+    char rroot[PS_PW], rcand[PS_PW], rcold[PS_PW];
+    if (sy_realpath(root, rroot, sizeof rroot) < 0) return ps_refuse("verify-cold-v2", "root-unresolvable");
+    if (sy_realpath(cand, rcand, sizeof rcand) < 0) return ps_refuse("verify-cold-v2", "candidate-unresolvable");
+    if (sy_realpath(coldf, rcold, sizeof rcold) < 0) return ps_refuse("verify-cold-v2", "cold-file-unresolvable");
+    if (ps_git_clean_tracked(rroot) != 0) return ps_refuse("verify-cold-v2", "dirty-tree");
+    char cold_id[65], rev_sha[41], tree_sha[41], ape_sha[65], batches_sha[65], why[256], wbatch[PS_IDLEN];
+    long cms = 0;
+    if (ps_compute_cold_identity(rroot, rev, rcand, cold_id, rev_sha, tree_sha, ape_sha, batches_sha))
+        return ps_refuse("verify-cold-v2", "cold-identity-compute-failed");
+    if (ps_verify_cold_v2_file(rcold, cold_id, ape_sha, 0, wbatch, &cms, why, sizeof why))
+        return ps_refuse("verify-cold-v2", why);
+    printf("PRERUN_START\tCOLD_V2_VERIFY\tPASS\twarmup=%s\tms=%ld\tcold_identity=%s\n",
+           wbatch, cms, cold_id);
+    return 0;
+}
+
+static int ps_cmd_cold_identity(int argc, char **argv) {
+    const char *root = 0, *cand = 0, *rev = "HEAD";
+    for (int i = 2; i < argc; i++) {
+        const char *k = argv[i], *v = i + 1 < argc ? argv[i + 1] : 0;
+        if (!v) return ps_refuse("cold-identity", "missing-value");
+        if (!strcmp(k, "--root") || !strcmp(k, "--repo")) root = v;
+        else if (!strcmp(k, "--candidate") || !strcmp(k, "--ape")) cand = v;
+        else if (!strcmp(k, "--rev")) rev = v;
+        else return ps_refuse("cold-identity", "unknown-option");
+        i++;
+    }
+    if (!root || !cand) return ps_refuse("cold-identity", "need-root-and-candidate");
+    char rroot[PS_PW], rcand[PS_PW];
+    if (sy_realpath(root, rroot, sizeof rroot) < 0) return ps_refuse("cold-identity", "root-unresolvable");
+    if (sy_realpath(cand, rcand, sizeof rcand) < 0) return ps_refuse("cold-identity", "candidate-unresolvable");
+    if (!strcmp(rev, "HEAD") && ps_git_clean_tracked(rroot) != 0)
+        return ps_refuse("cold-identity", "dirty-tree");
+    char cold_id[65], rev_sha[41], tree_sha[41], ape_sha[65], batches_sha[65];
+    if (ps_compute_cold_identity(rroot, rev, rcand, cold_id, rev_sha, tree_sha, ape_sha, batches_sha))
+        return ps_refuse("cold-identity", "compute-failed");
+    printf("PRERUN_START\tCOLD_IDENTITY\t%s\trev=%s\ttree=%s\tcandidate=%s\tbatches=%s\n",
+           cold_id, rev_sha, tree_sha, ape_sha, batches_sha);
+    return 0;
+}
+
+int main(int argc, char **argv) {
+    if (argc >= 2 && !strcmp(argv[1], "--")) { argc--; argv++; }
+    if (argc < 2) return ps_refuse("main", "usage: admission|verify-admission|verify-cold-v2|cold-identity");
+    const char *sub = argv[1];
+    if (!strcmp(sub, "admission")) return ps_cmd_admission(argc, argv);
+    if (!strcmp(sub, "verify-admission")) return ps_cmd_verify_admission(argc, argv);
+    if (!strcmp(sub, "verify-cold-v2")) return ps_cmd_verify_cold_v2(argc, argv);
+    if (!strcmp(sub, "cold-identity")) return ps_cmd_cold_identity(argc, argv);
+    return ps_refuse("main", "unknown-subcommand");
+}
diff --git a/tools/check-prerun-start.cx b/tools/check-prerun-start.cx
