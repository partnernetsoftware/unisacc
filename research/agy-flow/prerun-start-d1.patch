+static int ps_load_priority_marks(const char *path) {
+    size_t n = 0;
+    char *b = ps_read_all(path, &n);
+    if (!b) return -1;
+    int has_pass = 0;
+    const char *p = b, *end = b + n;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        char line[1024];
+        size_t cp = ll < sizeof line - 1 ? ll : sizeof line - 1;
+        mm_copy(line, sizeof line, p, cp);
+        line[cp] = 0;
+        ps_trim_line(line);
+        p += ll + (nl ? 1 : 0);
+        if (!line[0] || line[0] == '#') continue;
+        char *cols[6]; int nc = 0; char *q = line;
+        while (nc < 6) {
+            cols[nc++] = q;
+            char *tb = strchr(q, '\t');
+            if (!tb) break;
+            *tb = 0;
+            q = tb + 1;
+        }
+        if (nc >= 3 && !strcmp(cols[2], "PASS")) { has_pass = 1; break; }
+    }
+    p = b;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        char line[1024];
+        size_t cp = ll < sizeof line - 1 ? ll : sizeof line - 1;
+        mm_copy(line, sizeof line, p, cp);
+        line[cp] = 0;
+        ps_trim_line(line);
+        p += ll + (nl ? 1 : 0);
+        if (!line[0] || line[0] == '#') continue;
+        char *cols[6]; int nc = 0; char *q = line;
+        while (nc < 6) {
+            cols[nc++] = q;
+            char *tb = strchr(q, '\t');
+            if (!tb) break;
+            *tb = 0;
+            q = tb + 1;
+        }
+        if (!strcmp(cols[0], "RAW") || !strcmp(cols[0], "SUMMARY") || !strcmp(cols[0], "CHECKPOINT") ||
+            !strcmp(cols[0], "batch") || !strcmp(cols[0], "id")) continue;
+        if (has_pass && nc >= 3) {
+            const char *id_col = ps_is_digits(cols[0], strlen(cols[0])) ? cols[1] : cols[0];
+            int is_pass = !strcmp(cols[2], "PASS");
+            int ix = ps_find_id(id_col);
+            if (ix >= 0) g_prio[ix] = is_pass ? 0 : 2;
+        } else {
+            int ix = ps_find_id(cols[0]);
+            if (ix >= 0) g_prio[ix] = 2;
+        }
+    }
+    mm_free(b);
+    return 0;
+}
