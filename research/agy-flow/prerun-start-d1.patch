diff --git a/tools/prerun-start.cx b/tools/prerun-start.cx
new file mode 100644
index 0000000000..79b0610964
--- /dev/null
+++ b/tools/prerun-start.cx
@@ -0,0 +1,1376 @@
+/* tools/prerun-start.cx -- unified strict prerun launcher and D1 freeze admission gate.
+ *
+ * Subcommands:
+ *   admission        --root DIR --base REV --candidate APE --out DIR
+ *                    [--dvqualify-prog FILE] [--affected-prog FILE]
+ *   verify-admission --root DIR --base REV --candidate APE --out DIR
+ *                    [--affected-prog FILE]
+ *   cold-identity    --root DIR --candidate APE [--rev REV]
+ *   start            --rev REV --version V --prev PV --prev-rev PREVREV --ape ABS_APE
+ *                    --dir ABS_DIR --priority-src FILE --cold-times-file FILE
+ *                    [--repo DIR] [--lanes N] [--jobs N] [--prev-windows FILE]
+ *                    [--times-cache FILE] [--evidence-out DIR | --no-templates]
+ *                    [--exclude FILE] [--add-ids FILE] [--inputs-prog FILE]
+ *                    [--drive-prog FILE] [--plan-only]
+ *   resume           --dir ABS_DIR --candidate ABS_APE [--repo DIR]
+ *                    [--allow-migrate REASON] [--drive-prog FILE]
+ *
+ * Check: tools/check-prerun-start.cx. */
+#pragma unisa use cxlib.netpack
+#pragma unisa use sys.fs
+#pragma unisa use sys.env
+#pragma unisa use sys.posix
+#pragma unisa use sys.proc
+#pragma unisa use sys.sha
+#pragma unisa use text.text
+#pragma unisa use mem.bytes
+#pragma unisa use mem.heap
+
+#define PS_MAXIDS 4096
+#define PS_IDLEN 128
+#define PS_PW 4400
+#define PS_COLD_MAX_MS 27500
+#define PS_RUN_BOUND_SECS 5400
+
+static char g_ids[PS_MAXIDS][PS_IDLEN];
+static int g_src[PS_MAXIDS]; /* bit 1 = affected, bit 2 = added */
+static int g_prio[PS_MAXIDS];
+static int g_nids;
+
+static int ps_refuse(const char *sub, const char *why) {
+    printf("PRERUN_START\tREFUSE\tsub=%s\treason=%s\n", sub ? sub : "-", why ? why : "unknown");
+    return 2;
+}
+
+static int ps_unlock_refuse(const char *lockp, const char *sub, const char *why) {
+    if (lockp && lockp[0]) sy_unlink(lockp);
+    return ps_refuse(sub, why);
+}
+
+static char *ps_read_all(const char *path, size_t *n) {
+    unsigned char *b = 0; int64_t k = 0;
+    if (sy_read_file(path, &b, &k, 64 << 20)) return 0;
+    *n = (size_t)k;
+    return (char *)b;
+}
+
+static int ps_sha_buf(const char *data, size_t n, char hex[65]) {
+    return sy_sha256_hex(data, (long)n, hex);
+}
+
+static int ps_sha_file(const char *path, char hex[65]) {
+    size_t n = 0;
+    char *b = ps_read_all(path, &n);
+    if (!b) return -1;
+    int rc = ps_sha_buf(b, n, hex);
+    mm_free(b);
+    return rc;
+}
+
+static int ps_is_hex(const char *s, size_t len) {
+    for (size_t i = 0; i < len; i++) {
+        char c = s[i];
+        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 0;
+    }
+    return 1;
+}
+
+static int ps_is_digits(const char *s, size_t len) {
+    if (len == 0 || len > 12) return 0;
+    for (size_t i = 0; i < len; i++) if (s[i] < '0' || s[i] > '9') return 0;
+    return 1;
+}
+
+static int ps_starts(const char *s, const char *pre) {
+    size_t pl = strlen(pre);
+    return strlen(s) >= pl && memcmp(s, pre, pl) == 0;
+}
+
+static int ps_ends_cx(const char *s) {
+    size_t n = strlen(s);
+    return n >= 3 && memcmp(s + n - 3, ".cx", 3) == 0;
+}
+
+static int ps_prog_prefix(char **v, const char *prog) {
+    int c = 0;
+    if (ps_ends_cx(prog)) {
+        v[c++] = "sh";
+        v[c++] = "./unisacc.com";
+        v[c++] = (char *)prog;
+        v[c++] = "--";
+    } else {
+        v[c++] = (char *)prog;
+    }
+    return c;
+}
+
+static int ps_prog_has_token(const char *repo, const char *prog, const char *tok) {
+    char path[PS_PW];
+    const char *p = prog;
+    if (prog[0] != '/') {
+        if (cx_fmt(path, sizeof path, "%s/%s", repo, prog)) return 0;
+        p = path;
+    }
+    size_t n = 0, tl = strlen(tok);
+    char *b = ps_read_all(p, &n);
+    if (!b) return 1;
+    int hit = 0;
+    for (size_t i = 0; tl > 0 && i + tl <= n; i++) {
+        if (!memcmp(b + i, tok, tl)) { hit = 1; break; }
+    }
+    mm_free(b);
+    return hit;
+}
+
+static int ps_is_compile_smoke_id(const char *id) {
+    return ps_starts(id, "daily-compile-smoke-") || ps_starts(id, "compile-smoke-");
+}
+
+static int ps_is_early_canary_id(const char *id) {
+    return ps_starts(id, "ri-image-") || !strcmp(id, "ri-route-refuse") || !strcmp(id, "lane-key-probes") ||
+           ps_is_compile_smoke_id(id);
+}
+
+static int ps_is_warmup_excluded_id(const char *id) {
+    return !strcmp(id, "tools-default-regression") || !strcmp(id, "cx-booter-ape") ||
+           ps_starts(id, "unit-frontcache-") || ps_starts(id, "opt-frame4-");
+}
+
+static int ps_is_heavy_id(const char *id) {
+    static const char *builtin[] = {
+        "real-commit", "unit-frontcache-equiv3", "check-split-parents",
+        "check-gen-all-check", "check-gen-all-pass", "check-gen-all-hang",
+        "c-negative", "stream-pipe-parts", 0
+    };
+    for (int i = 0; builtin[i]; i++) if (!strcmp(id, builtin[i])) return 1;
+    if (ps_starts(id, "netregen-")) return 1;
+    return 0;
+}
+
+static int ps_find_id(const char *id) {
+    for (int i = 0; i < g_nids; i++) if (!strcmp(g_ids[i], id)) return i;
+    return -1;
+}
+
+static void ps_trim_line(char *s) {
+    size_t n = strlen(s);
+    while (n > 0 && (s[n - 1] == '\n' || s[n - 1] == '\r' || s[n - 1] == ' ' || s[n - 1] == '\t')) s[--n] = 0;
+}
+
+static int ps_git_out(const char *repo, char **argv, char *out, size_t cap) {
+    np_result r = {0}; char why[512];
+    if (np_run(argv, repo, 0, 30, &r, why, sizeof why) || r.rc || !r.out) {
+        np_free(&r);
+        return -1;
+    }
+    size_t n = r.outn < cap - 1 ? r.outn : cap - 1;
+    mm_copy(out, cap, r.out, n);
+    out[n] = 0;
+    ps_trim_line(out);
+    np_free(&r);
+    return 0;
+}
+
+/* Resolve two or three rev-parse specs in one git invocation to minimize subprocess overhead. */
+static int ps_git_rev_pair(const char *repo, const char *s1, const char *s2, char h1[41], char h2[41]) {
+    char *v[] = {"git", "rev-parse", (char *)s1, (char *)s2, 0};
+    char buf[256];
+    if (ps_git_out(repo, v, buf, sizeof buf)) return -1;
+    if (strlen(buf) < 81 || buf[40] != '\n') return -1;
+    mm_copy(h1, 41, buf, 40); h1[40] = 0;
+    mm_copy(h2, 41, buf + 41, 40); h2[40] = 0;
+    if (!ps_is_hex(h1, 40) || !ps_is_hex(h2, 40)) return -1;
+    return 0;
+}
+
+static int ps_git_rev_triple(const char *repo, const char *s1, const char *s2, const char *s3,
+                             char h1[41], char h2[41], char h3[41]) {
+    char *v[] = {"git", "rev-parse", (char *)s1, (char *)s2, (char *)s3, 0};
+    char buf[384];
+    if (ps_git_out(repo, v, buf, sizeof buf)) return -1;
+    if (strlen(buf) < 122 || buf[40] != '\n' || buf[81] != '\n') return -1;
+    mm_copy(h1, 41, buf, 40); h1[40] = 0;
+    mm_copy(h2, 41, buf + 41, 40); h2[40] = 0;
+    mm_copy(h3, 41, buf + 82, 40); h3[40] = 0;
+    if (!ps_is_hex(h1, 40) || !ps_is_hex(h2, 40) || !ps_is_hex(h3, 40)) return -1;
+    return 0;
+}
+
+static int ps_git_clean_tracked(const char *repo) {
+    char *v[] = {"git", "status", "--porcelain", "--untracked-files=no", 0};
+    char buf[256];
+    if (ps_git_out(repo, v, buf, sizeof buf)) return -1;
+    return buf[0] == 0 ? 0 : 1;
+}
+
+static char *ps_git_show_alloc(const char *repo, const char *spec, size_t *out_n) {
+    char *v[] = {"git", "show", (char *)spec, 0};
+    np_result r = {0}; char why[512];
+    if (np_run(v, repo, 0, 30, &r, why, sizeof why) || r.rc || !r.out) {
+        np_free(&r);
+        return 0;
+    }
+    char *b = (char *)mm_alloc(r.outn + 1);
+    if (!b) { np_free(&r); return 0; }
+    if (r.outn) mm_copy(b, r.outn + 1, r.out, r.outn);
+    b[r.outn] = 0;
+    *out_n = r.outn;
+    np_free(&r);
+    return b;
+}
+
+static void ps_load_implemented_batches(const char *t, size_t n) {
+    g_nids = 0;
+    const char *p = t, *end = t + n;
+    int first = 1;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        char line[2048];
+        size_t cp = ll < sizeof line - 1 ? ll : sizeof line - 1;
+        mm_copy(line, sizeof line, p, cp);
+        line[cp] = 0;
+        p += ll + (nl ? 1 : 0);
+        if (first) { first = 0; continue; }
+        if (!line[0] || line[0] == '#') continue;
+        char *t1 = strchr(line, '\t');
+        if (!t1) continue;
+        *t1++ = 0;
+        char *t2 = strchr(t1, '\t');
+        if (t2) *t2 = 0;
+        if (strcmp(t1, "IMPLEMENTED") || strlen(line) >= PS_IDLEN || g_nids >= PS_MAXIDS) continue;
+        if (ps_find_id(line) >= 0) continue;
+        cx_fmt(g_ids[g_nids], PS_IDLEN, "%s", line);
+        g_src[g_nids] = 0;
+        g_prio[g_nids] = 0;
+        g_nids++;
+    }
+}
+
+static int ps_batch_implemented_in(const char *t, size_t n, const char *id) {
+    const char *p = t, *end = t + n;
+    size_t il = strlen(id);
+    int first = 1;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        const char *row = p;
+        p += ll + (nl ? 1 : 0);
+        if (first) { first = 0; continue; }
+        if (ll > il + 12 && !memcmp(row, id, il) && row[il] == '\t' &&
+            !memcmp(row + il + 1, "IMPLEMENTED", 11) &&
+            (row[il + 12] == '\t' || row[il + 12] == '\r' || il + 12 == ll)) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static const char *ps_src_label(int mask) {
+    if (mask == 3) return "both";
+    if (mask == 2) return "added";
+    return "affected";
+}
+
+static int ps_compute_cold_identity(const char *repo, const char *rev, const char *ape,
+                                    char cold_id[65], char rev_sha[41], char tree_sha[41],
+                                    char ape_sha[65], char batches_sha[65]) {
+    char cspec[128], tspec[128], bspec[160], head_c[41];
+    const char *r = (rev && rev[0]) ? rev : "HEAD";
+    if (cx_fmt(cspec, sizeof cspec, "%s^{commit}", r) ||
+        cx_fmt(tspec, sizeof tspec, "%s^{tree}", r) ||
+        cx_fmt(bspec, sizeof bspec, "%s:tests/batches.tsv", r)) return -1;
+    if (ps_git_rev_triple(repo, cspec, tspec, "HEAD^{commit}", rev_sha, tree_sha, head_c)) return -1;
+    sy_stat_t st;
+    if (!ape || sy_stat(ape, &st) || st.kind != 'f' || ps_sha_file(ape, ape_sha)) return -1;
+    size_t bn = 0;
+    char *bt = 0;
+    char disk_bp[PS_PW];
+    if (!strcmp(rev_sha, head_c) && !cx_fmt(disk_bp, sizeof disk_bp, "%s/tests/batches.tsv", repo)) {
+        bt = ps_read_all(disk_bp, &bn);
+    }
+    if (!bt) bt = ps_git_show_alloc(repo, bspec, &bn);
+    if (!bt) return -1;
+    int brc = ps_sha_buf(bt, bn, batches_sha);
+    mm_free(bt);
+    if (brc) return -1;
+    char payload[512];
+    if (cx_fmt(payload, sizeof payload, "warmup-cold-v1\n%s\n%s\n%s\n", tree_sha, ape_sha, batches_sha)) return -1;
+    return ps_sha_buf(payload, strlen(payload), cold_id);
+}
+
+static int ps_collect_admission_union(const char *root, const char *base_rev, const char *affected_prog,
+                                      char head_sha[41], char tree_sha[41], char base_sha[41],
+                                      char batches_sha[65], char *why, size_t wcap) {
+    char bspec[128], disk_bp[PS_PW];
+    if (ps_git_clean_tracked(root) != 0) { cx_fmt(why, wcap, "dirty-tree"); return -1; }
+    if (cx_fmt(bspec, sizeof bspec, "%s^{commit}", base_rev) ||
+        ps_git_rev_triple(root, "HEAD^{commit}", "HEAD^{tree}", bspec, head_sha, tree_sha, base_sha)) {
+        cx_fmt(why, wcap, "rev-resolve-failed"); return -1;
+    }
+    size_t hbn = 0, pbn = 0;
+    cx_fmt(disk_bp, sizeof disk_bp, "%s/tests/batches.tsv", root);
+    char *hbt = ps_read_all(disk_bp, &hbn);
+    if (!hbt) { cx_fmt(why, wcap, "head-batches-unreadable"); return -1; }
+    if (ps_sha_buf(hbt, hbn, batches_sha)) { mm_free(hbt); cx_fmt(why, wcap, "batches-sha-failed"); return -1; }
+    ps_load_implemented_batches(hbt, hbn);
+    mm_free(hbt);
+    if (g_nids <= 0) { cx_fmt(why, wcap, "no-implemented-batches"); return -1; }
+
+    char pbspec[160];
+    cx_fmt(pbspec, sizeof pbspec, "%s:tests/batches.tsv", base_sha);
+    char *pbt = ps_git_show_alloc(root, pbspec, &pbn);
+    if (!pbt) { cx_fmt(why, wcap, "base-batches-unreadable"); return -1; }
+    for (int i = 0; i < g_nids; i++) {
+        if (!ps_batch_implemented_in(pbt, pbn, g_ids[i])) g_src[i] |= 2;
+    }
+    mm_free(pbt);
+
+    const char *aprog = (affected_prog && affected_prog[0]) ? affected_prog : "tools/affected.cx";
+    char *av[12]; int ac = ps_prog_prefix(av, aprog);
+    av[ac++] = "--since"; av[ac++] = base_sha; av[ac++] = "--list-only"; av[ac] = 0;
+    np_result ar = {0}; char awhy[512];
+    if (np_run(av, root, 0, 55, &ar, awhy, sizeof awhy) || ar.rc || !ar.out) {
+        np_free(&ar);
+        cx_fmt(why, wcap, "affected-run-failed");
+        return -1;
+    }
+    const char *p = ar.out, *end = ar.out + ar.outn;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        if (ll > 9 && !memcmp(p, "AFFECTED\t", 9)) {
+            const char *id_s = p + 9;
+            const char *tb = (const char *)memchr(id_s, '\t', (size_t)(p + ll - id_s));
+            size_t il = tb ? (size_t)(tb - id_s) : (size_t)(p + ll - id_s);
+            if (il > 0 && il < PS_IDLEN) {
+                char id[PS_IDLEN];
+                mm_copy(id, sizeof id, id_s, il);
+                id[il] = 0;
+                ps_trim_line(id);
+                int ix = ps_find_id(id);
+                if (ix >= 0) g_src[ix] |= 1;
+            }
+        }
+        p += ll + (nl ? 1 : 0);
+    }
+    np_free(&ar);
+    return 0;
+}
+
+static int ps_parse_batch_evidence(const char *path, const char *want_id, const char *want_cand,
+                                   char *status_out, size_t st_cap, long *ms_out,
+                                   char *raw_line_out, size_t raw_cap, char raw_sha_out[65]) {
+    size_t n = 0;
+    char *b = ps_read_all(path, &n);
+    if (!b) return -1;
+    status_out[0] = 0;
+    *ms_out = 0;
+    raw_line_out[0] = 0;
+    raw_sha_out[0] = 0;
+    int got_row = 0, got_raw = 0;
+    const char *p = b, *end = b + n;
+    size_t il = strlen(want_id);
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        size_t rll = ll;
+        if (rll > 0 && p[rll - 1] == '\r') rll--;
+        if (rll > 4 && !memcmp(p, "RAW\t", 4) && tx_find(p, (long)rll, "BATCH_RUN", 9) >= 0) {
+            char id_pat[PS_IDLEN + 8], cand_pat[80];
+            cx_fmt(id_pat, sizeof id_pat, "\tid=%s\t", want_id);
+            cx_fmt(cand_pat, sizeof cand_pat, "\tcandidate=%s", want_cand);
+            if (tx_find(p, (long)rll, id_pat, (long)strlen(id_pat)) >= 0) {
+                size_t cp = rll < raw_cap - 1 ? rll : raw_cap - 1;
+                mm_copy(raw_line_out, raw_cap, p, cp);
+                raw_line_out[cp] = 0;
+                ps_sha_buf(raw_line_out, strlen(raw_line_out), raw_sha_out);
+                if (tx_find(p, (long)rll, "\tstatus=PASS\t", 13) >= 0 &&
+                    tx_find(p, (long)rll, "\trc=0\t", 6) >= 0 &&
+                    tx_find(p, (long)rll, cand_pat, (long)strlen(cand_pat)) >= 0) {
+                    got_raw = 1;
+                }
+            }
+        } else if (rll > il + 1 && !memcmp(p, want_id, il) && p[il] == '\t') {
+            char line[2048];
+            size_t cp = rll < sizeof line - 1 ? rll : sizeof line - 1;
+            mm_copy(line, sizeof line, p, cp);
+            line[cp] = 0;
+            char *cols[10]; int nc = 0; char *q = line;
+            while (nc < 10) {
+                cols[nc++] = q;
+                char *tb = strchr(q, '\t');
+                if (!tb) break;
+                *tb = 0;
+                q = tb + 1;
+            }
+            if (nc == 9) {
+                cx_fmt(status_out, st_cap, "%s", cols[2]);
+                *ms_out = atol(cols[5]);
+                if (!strcmp(cols[2], "PASS") && !strcmp(cols[3], "0") && !strcmp(cols[4], want_cand)) {
+                    got_row = 1;
+                }
+            }
+        }
+        p += ll + (nl ? 1 : 0);
+    }
+    mm_free(b);
+    return (got_row && got_raw) ? 0 : 1;
+}
+
+static int ps_cmd_admission(int argc, char **argv) {
+    const char *root = 0, *base = 0, *cand = 0, *out = 0;
+    const char *dvprog = "tools/dvqualify.cx", *afprog = "tools/affected.cx";
+    for (int i = 2; i < argc; i++) {
+        const char *k = argv[i], *v = i + 1 < argc ? argv[i + 1] : 0;
+        if (!v) return ps_refuse("admission", "missing-value");
+        if (!strcmp(k, "--root")) root = v;
+        else if (!strcmp(k, "--base")) base = v;
+        else if (!strcmp(k, "--candidate")) cand = v;
+        else if (!strcmp(k, "--out")) out = v;
+        else if (!strcmp(k, "--dvqualify-prog")) dvprog = v;
+        else if (!strcmp(k, "--affected-prog")) afprog = v;
+        else return ps_refuse("admission", "unknown-option");
+        i++;
+    }
+    if (!root || !base || !cand || !out) return ps_refuse("admission", "need-root-base-candidate-out");
+    if (out[0] != '/') return ps_refuse("admission", "out-not-absolute");
+    char rroot[PS_PW], rcand[PS_PW], cand_sha[65];
+    sy_stat_t st;
+    if (sy_realpath(root, rroot, sizeof rroot) < 0) return ps_refuse("admission", "root-unresolvable");
+    if (sy_realpath(cand, rcand, sizeof rcand) < 0 || sy_stat(rcand, &st) || st.kind != 'f' || ps_sha_file(rcand, cand_sha))
+        return ps_refuse("admission", "candidate-unreadable");
+    if (sy_mkdir_all(out, 0700)) return ps_refuse("admission", "out-create-failed");
+
+    char head_sha[41], tree_sha[41], base_sha[41], batches_sha[65], why[256];
+    if (ps_collect_admission_union(rroot, base, afprog, head_sha, tree_sha, base_sha, batches_sha, why, sizeof why))
+        return ps_refuse("admission", why);
+
+    int nsel = 0;
+    for (int i = 0; i < g_nids; i++) if (g_src[i]) nsel++;
+
+    np_buf rec = {0}, pri = {0};
+    char line[4096], rpath[PS_PW], ppath[PS_PW];
+    cx_fmt(rpath, sizeof rpath, "%s/admission-receipt.tsv", out);
+    cx_fmt(ppath, sizeof ppath, "%s/priority.tsv", out);
+
+    np_puts(&rec, "# prerun-start admission receipt (D1 freeze admission gate)\n");
+    cx_fmt(line, sizeof line,
+           "ADMISSION_META\tschema=v1\ttree_sha=%s\thead_sha=%s\tbase_sha=%s\tcandidate_sha256=%s\tbatches_sha256=%s\tcount=%d\tstatus=PASS\n",
+           tree_sha, head_sha, base_sha, cand_sha, batches_sha, nsel);
+    np_puts(&rec, line);
+
+    np_puts(&pri, "# prerun-start admission priority table (D1)\n");
+    cx_fmt(line, sizeof line, "# tree_sha=%s base_sha=%s candidate_sha256=%s\nbatch\tsource\tstatus\n__admission_pass_anchor__\tadmission\tPASS\n", tree_sha, base_sha, cand_sha);
+    np_puts(&pri, line);
+
+    /* tools/dvqualify.cx:635 requires positional ROOT as argv[1] (no --root flag). */
+    for (int i = 0; i < g_nids; i++) {
+        if (!g_src[i]) continue;
+        char bfile[PS_PW], st_str[32] = "UNKNOWN", raw_line[1024] = "", raw_sha[65] = "-";
+        long bms = 0;
+        cx_fmt(bfile, sizeof bfile, "%s/batch-%s.tsv", out, g_ids[i]);
+        sy_unlink(bfile);
+        char *dv[20]; int dc = ps_prog_prefix(dv, dvprog);
+        dv[dc++] = rroot;
+        dv[dc++] = "--candidate"; dv[dc++] = rcand;
+        dv[dc++] = "--ids"; dv[dc++] = g_ids[i];
+        dv[dc++] = "--jobs"; dv[dc++] = "1";
+        dv[dc++] = "--segment-batches"; dv[dc++] = "1";
+        dv[dc++] = "--out"; dv[dc++] = bfile;
+        dv[dc] = 0;
+        np_result dr = {0}; char dwhy[512];
+        int tr = np_run(dv, rroot, 0, 58, &dr, dwhy, sizeof dwhy);
+        int drc = tr ? -1 : dr.rc;
+        np_free(&dr);
+        int perr = ps_parse_batch_evidence(bfile, g_ids[i], cand_sha, st_str, sizeof st_str, &bms,
+                                           raw_line, sizeof raw_line, raw_sha);
+        if (drc != 0 || perr != 0) {
+            if (!st_str[0]) cx_fmt(st_str, sizeof st_str, "UNKNOWN");
+            np_buf frec = {0};
+            np_puts(&frec, "# prerun-start admission receipt (D1 freeze admission gate)\n");
+            cx_fmt(line, sizeof line,
+                   "ADMISSION_META\tschema=v1\ttree_sha=%s\thead_sha=%s\tbase_sha=%s\tcandidate_sha256=%s\tbatches_sha256=%s\tcount=%d\tstatus=FAIL\tfailed_batch=%s\tfailed_status=%s\n",
+                   tree_sha, head_sha, base_sha, cand_sha, batches_sha, nsel, g_ids[i], st_str);
+            np_puts(&frec, line);
+            cx_write(rpath, frec.p ? frec.p : "", frec.n);
+            free(frec.p); free(rec.p); free(pri.p);
+            printf("PRERUN_START\tADMISSION\tFAIL\tbatch=%s\tstatus=%s\trc=%d\n", g_ids[i], st_str, drc);
+            return 1;
+        }
+        cx_fmt(line, sizeof line, "ADMISSION_BATCH\t%s\t%s\tPASS\t%ld\t%s\t%s\n%s\n",
+               g_ids[i], ps_src_label(g_src[i]), bms, cand_sha, raw_sha, raw_line);
+        np_puts(&rec, line);
+        cx_fmt(line, sizeof line, "%s\t%s\tPRIORITY\n", g_ids[i], ps_src_label(g_src[i]));
+        np_puts(&pri, line);
+    }
+
+    if (cx_write(rpath, rec.p ? rec.p : "", rec.n) || cx_write(ppath, pri.p ? pri.p : "", pri.n)) {
+        free(rec.p); free(pri.p);
+        return ps_refuse("admission", "receipt-write-failed");
+    }
+    free(rec.p); free(pri.p);
+    printf("PRERUN_START\tADMISSION\tPASS\ttree=%s\tbase=%s\tcandidate=%s\tbatches=%d\treceipt=%s\tpriority=%s\n",
+           tree_sha, base_sha, cand_sha, nsel, rpath, ppath);
+    return 0;
+}
+
+static int ps_kv_get(const char *line, const char *key, char *out, size_t cap) {
+    long k = tx_find(line, (long)strlen(line), key, (long)strlen(key));
+    out[0] = 0;
+    if (k < 0) return -1;
+    const char *p = line + k + strlen(key);
+    size_t j = 0;
+    while (p[j] && p[j] != '\t' && p[j] != '\n' && p[j] != '\r' && j + 1 < cap) {
+        out[j] = p[j];
+        j++;
+    }
+    out[j] = 0;
+    return 0;
+}
