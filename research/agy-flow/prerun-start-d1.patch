+    printf("PRERUN_START\tRESUME_DONE\trc=%d\tdir=%s\tbound_s=%d\n", rrc, dir, PS_RUN_BOUND_SECS);
+    return rrc;
+}
+
+int main(int argc, char **argv) {
+    if (argc >= 2 && !strcmp(argv[1], "--")) { argc--; argv++; }
+    if (argc < 2) return ps_refuse("main", "usage: admission|verify-admission|cold-identity|start|resume");
+    const char *sub = argv[1];
+    if (!strcmp(sub, "admission")) return ps_cmd_admission(argc, argv);
+    if (!strcmp(sub, "verify-admission")) return ps_cmd_verify_admission(argc, argv);
+    if (!strcmp(sub, "cold-identity")) return ps_cmd_cold_identity(argc, argv);
+    if (!strcmp(sub, "start")) return ps_cmd_start(argc, argv);
+    if (!strcmp(sub, "resume")) return ps_cmd_resume(argc, argv);
+    return ps_refuse(sub, "unknown-subcommand");
+}
