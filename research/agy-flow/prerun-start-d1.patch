+
+    char *ver_cmd[] = {bin, "verify-admission", "--root", fx, "--base", base_rev, "--candidate", ape1, "--out", adm_dir,
+                       "--affected-prog", mock_af_bin, 0};
+    r = run(ver_cmd, 0);
+    ck(r.rc == 2 && tk_has(r.out, "receipt-status-not-pass"), "d1-verify-rejects-failed-receipt");
+    np_free(&r);
+
+    /* D1 UNKNOWN batch status refused */
+    setenv("MOCK_DV_MODE", "unknown-w0201", 1);
+    r = run(adm_fail, 0);
+    ck(r.rc == 1 && tk_has(r.out, "PRERUN_START\tADMISSION\tFAIL\tbatch=w0201-aff\tstatus=UNKNOWN"),
+       "d1-unknown-batch-refused");
+    np_free(&r);
+    unsetenv("MOCK_DV_MODE");
+
+    /* Reject cold-new-layout and warm-restart at admission CLI (only cold-cache-off is allowed) */
+    char *adm_new_lay[] = {bin, "admission", "--root", fx, "--base", base_rev, "--candidate", ape1, "--out", adm_dir,
+                           "--cold-mode", "cold-new-layout", "--affected-prog", mock_af_bin, "--dvqualify-prog", mock_dv_bin, 0};
+    r = run(adm_new_lay, 0);
