+static int ps_cmd_verify_admission(int argc, char **argv) {
+    const char *root = 0, *base = 0, *cand = 0, *out = 0;
+    const char *afprog = "tools/affected.cx";
+    for (int i = 2; i < argc; i++) {
+        const char *k = argv[i], *v = i + 1 < argc ? argv[i + 1] : 0;
+        if (!v) return ps_refuse("verify-admission", "missing-value");
+        if (!strcmp(k, "--root")) root = v;
+        else if (!strcmp(k, "--base")) base = v;
+        else if (!strcmp(k, "--candidate")) cand = v;
+        else if (!strcmp(k, "--out")) out = v;
+        else if (!strcmp(k, "--affected-prog")) afprog = v;
+        else return ps_refuse("verify-admission", "unknown-option");
+        i++;
+    }
+    if (!root || !base || !cand || !out) return ps_refuse("verify-admission", "need-root-base-candidate-out");
+    char rroot[PS_PW], rcand[PS_PW], cand_sha[65];
+    sy_stat_t st;
+    if (sy_realpath(root, rroot, sizeof rroot) < 0) return ps_refuse("verify-admission", "root-unresolvable");
+    if (sy_realpath(cand, rcand, sizeof rcand) < 0 || sy_stat(rcand, &st) || st.kind != 'f' || ps_sha_file(rcand, cand_sha))
+        return ps_refuse("verify-admission", "candidate-unreadable");
+
+    char head_sha[41], tree_sha[41], base_sha[41], batches_sha[65], why[256];
+    if (ps_collect_admission_union(rroot, base, afprog, head_sha, tree_sha, base_sha, batches_sha, why, sizeof why))
+        return ps_refuse("verify-admission", why);
+
+    char rpath[PS_PW], ppath[PS_PW];
+    cx_fmt(rpath, sizeof rpath, "%s/admission-receipt.tsv", out);
+    cx_fmt(ppath, sizeof ppath, "%s/priority.tsv", out);
+    size_t rn = 0, pn = 0;
+    char *rt = ps_read_all(rpath, &rn);
+    if (!rt) return ps_refuse("verify-admission", "receipt-missing");
+    char *pt = 0;
+
+    static int seen_rec[PS_MAXIDS];
+    static int seen_pri[PS_MAXIDS];
+    for (int i = 0; i < g_nids; i++) { seen_rec[i] = 0; seen_pri[i] = 0; }
+
+    int got_meta = 0, rec_rows = 0;
+    const char *p = rt, *end = rt + rn;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        char line[2048];
+        size_t cp = ll < sizeof line - 1 ? ll : sizeof line - 1;
+        mm_copy(line, sizeof line, p, cp);
+        line[cp] = 0;
+        ps_trim_line(line);
+        p += ll + (nl ? 1 : 0);
+        if (!line[0] || line[0] == '#') continue;
+        if (ps_starts(line, "ADMISSION_META\t")) {
+            char v_st[32], v_tree[64], v_base[64], v_cand[80], v_bsha[80];
+            ps_kv_get(line, "\tstatus=", v_st, sizeof v_st);
+            ps_kv_get(line, "\ttree_sha=", v_tree, sizeof v_tree);
+            ps_kv_get(line, "\tbase_sha=", v_base, sizeof v_base);
+            ps_kv_get(line, "\tcandidate_sha256=", v_cand, sizeof v_cand);
+            ps_kv_get(line, "\tbatches_sha256=", v_bsha, sizeof v_bsha);
+            if (strcmp(v_st, "PASS")) { mm_free(rt); return ps_refuse("verify-admission", "receipt-status-not-pass"); }
+            if (strcmp(v_tree, tree_sha)) { mm_free(rt); return ps_refuse("verify-admission", "tree-mismatch"); }
+            if (strcmp(v_base, base_sha)) { mm_free(rt); return ps_refuse("verify-admission", "base-mismatch"); }
+            if (strcmp(v_cand, cand_sha)) { mm_free(rt); return ps_refuse("verify-admission", "candidate-mismatch"); }
+            if (strcmp(v_bsha, batches_sha)) { mm_free(rt); return ps_refuse("verify-admission", "batches-sha-mismatch"); }
+            got_meta = 1;
+        } else if (ps_starts(line, "ADMISSION_BATCH\t")) {
+            char *cols[8]; int nc = 0; char *q = line;
+            while (nc < 8) {
+                cols[nc++] = q;
+                char *tb = strchr(q, '\t');
+                if (!tb) break;
+                *tb = 0;
+                q = tb + 1;
+            }
+            if (nc != 7) { mm_free(rt); return ps_refuse("verify-admission", "malformed-batch-row"); }
+            int ix = ps_find_id(cols[1]);
+            if (ix < 0 || !g_src[ix] || seen_rec[ix]) {
+                mm_free(rt);
+                return ps_refuse("verify-admission", "unexpected-or-duplicate-batch");
+            }
+            if (strcmp(cols[3], "PASS")) { mm_free(rt); return ps_refuse("verify-admission", "batch-status-not-pass"); }
+            if (strcmp(cols[5], cand_sha)) { mm_free(rt); return ps_refuse("verify-admission", "batch-candidate-mismatch"); }
+            char bfile[PS_PW], bst[32], braw[1024], bsha[65];
+            long bms = 0;
+            cx_fmt(bfile, sizeof bfile, "%s/batch-%s.tsv", out, cols[1]);
+            if (ps_parse_batch_evidence(bfile, cols[1], cand_sha, bst, sizeof bst, &bms, braw, sizeof braw, bsha) ||
+                strcmp(bsha, cols[6])) {
+                mm_free(rt);
+                return ps_refuse("verify-admission", "batch-raw-evidence-mismatch");
+            }
+            seen_rec[ix] = 1;
+            rec_rows++;
+        }
+    }
+    mm_free(rt);
+    if (!got_meta) return ps_refuse("verify-admission", "receipt-meta-missing");
+    pt = ps_read_all(ppath, &pn);
+    if (!pt) return ps_refuse("verify-admission", "priority-missing");
+
+    p = pt; end = pt + pn;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        char line[512];
+        size_t cp = ll < sizeof line - 1 ? ll : sizeof line - 1;
+        mm_copy(line, sizeof line, p, cp);
+        line[cp] = 0;
+        ps_trim_line(line);
+        p += ll + (nl ? 1 : 0);
+        if (!line[0] || line[0] == '#') continue;
+        char *tb = strchr(line, '\t');
+        if (tb) *tb = 0;
+        if (!strcmp(line, "id") || !strcmp(line, "batch") || !strcmp(line, "__admission_pass_anchor__")) continue;
+        int ix = ps_find_id(line);
+        if (ix < 0 || !g_src[ix] || seen_pri[ix]) {
+            mm_free(pt);
+            return ps_refuse("verify-admission", "priority-table-mismatch");
+        }
+        seen_pri[ix] = 1;
+    }
+    mm_free(pt);
+
+    int want_n = 0;
+    for (int i = 0; i < g_nids; i++) {
+        if (!g_src[i]) continue;
+        want_n++;
+        if (!seen_rec[i]) {
+            char msg[200];
+            cx_fmt(msg, sizeof msg, "missing-batch:%s", g_ids[i]);
+            return ps_refuse("verify-admission", msg);
+        }
+        if (!seen_pri[i]) {
+            char msg[200];
+            cx_fmt(msg, sizeof msg, "priority-missing-batch:%s", g_ids[i]);
+            return ps_refuse("verify-admission", msg);
+        }
+    }
+    if (rec_rows != want_n) return ps_refuse("verify-admission", "batch-count-mismatch");
+    printf("PRERUN_START\tADMISSION_VERIFY\tPASS\ttree=%s\tbase=%s\tcandidate=%s\tbatches=%d\n",
+           tree_sha, base_sha, cand_sha, want_n);
+    return 0;
+}
