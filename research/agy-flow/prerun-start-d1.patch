+    } else {
+        char par_setup[12000];
+        cx_fmt(par_setup, sizeof par_setup,
+            "set -e; (cd '%s' && sh '%s' tools/prerun-start.cx -o '%s') & b_pid=$!; "
+            "%s; wait $b_pid",
