+    cx_fmt(strict_wfile, sizeof strict_wfile, "%s/qualify-light-b.tsv", adm_dir);
+
+    /* (2) D1 Red-then-Green: 107 Round 1 W0201 failure caught before freeze (no warmup-cold.tsv emitted) */
+    setenv("MOCK_DV_MODE", "fail-w0201", 1);
+    char *adm_fail[] = {bin, "admission", "--root", fx, "--base", base_rev, "--candidate", ape1, "--out", adm_dir,
