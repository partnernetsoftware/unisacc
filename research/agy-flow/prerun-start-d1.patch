+static int ps_load_ids_list(const char *path) {
+    size_t n = 0;
+    char *b = ps_read_all(path, &n);
+    if (!b) return -1;
+    g_nids = 0;
+    const char *p = b, *end = b + n;
+    while (p < end && g_nids < PS_MAXIDS) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        char line[PS_IDLEN];
+        size_t cp = ll < sizeof line - 1 ? ll : sizeof line - 1;
+        mm_copy(line, sizeof line, p, cp);
+        line[cp] = 0;
+        ps_trim_line(line);
+        p += ll + (nl ? 1 : 0);
+        if (!line[0] || line[0] == '#') continue;
+        char *tb = strchr(line, '\t');
+        if (tb) *tb = 0;
+        if (!strcmp(line, "id") || !strcmp(line, "batch") || !strcmp(line, "RAW") || !strcmp(line, "SUMMARY")) continue;
+        if (ps_find_id(line) >= 0) continue;
+        cx_fmt(g_ids[g_nids], PS_IDLEN, "%s", line);
+        g_src[g_nids] = 0;
+        g_prio[g_nids] = 0;
+        g_nids++;
+    }
+    mm_free(b);
+    return g_nids > 0 ? 0 : -1;
+}
