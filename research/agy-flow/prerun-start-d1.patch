+    int tr = np_run(rv, rrepo, 0, PS_RUN_BOUND_SECS, &rr, rwhy, sizeof rwhy);
+    int rrc = tr ? 2 : rr.rc;
+    if (rr.out && rr.outn) fwrite(rr.out, 1, rr.outn, stdout);
+    if (rr.err && rr.errn) fwrite(rr.err, 1, rr.errn, stderr);
+    np_free(&rr);
