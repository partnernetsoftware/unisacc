+static int ps_cmd_resume(int argc, char **argv) {
+    const char *dir = 0, *ape = 0, *repo = 0, *mig_why = 0;
+    const char *dr_prog = "tools/prerun-drive.cx";
+    for (int i = 2; i < argc; i++) {
+        const char *k = argv[i];
+        if (!strcmp(k, "--normal-jobs")) return ps_refuse("resume", "normal-jobs-refused-use-binding");
+        const char *v = i + 1 < argc ? argv[i + 1] : 0;
+        if (!v) return ps_refuse("resume", "missing-value");
+        if (!strcmp(k, "--dir") || !strcmp(k, "--out")) dir = v;
+        else if (!strcmp(k, "--candidate") || !strcmp(k, "--ape")) ape = v;
+        else if (!strcmp(k, "--repo") || !strcmp(k, "--root")) repo = v;
+        else if (!strcmp(k, "--allow-migrate")) mig_why = v;
+        else if (!strcmp(k, "--drive-prog")) dr_prog = v;
+        else return ps_refuse("resume", "unknown-option");
+        i++;
+    }
+    if (!dir || !ape) return ps_refuse("resume", "need-dir-and-candidate");
+    if (dir[0] != '/' || ape[0] != '/') return ps_refuse("resume", "dir-and-candidate-must-be-absolute");
+    if (mig_why && (!mig_why[0] || strchr(mig_why, '\t') || strchr(mig_why, '\n')))
+        return ps_refuse("resume", "invalid-allow-migrate-reason");
+
+    char rape[PS_PW], ape_sha[65];
+    sy_stat_t st;
+    if (sy_realpath(ape, rape, sizeof rape) < 0 || sy_stat(rape, &st) || st.kind != 'f' || ps_sha_file(rape, ape_sha))
+        return ps_refuse("resume", "kit-missing-candidate");
+
+    char lockp[PS_PW] = "";
+    int lrc = ps_lock_acquire(dir, lockp);
+    if (lrc == 1) return ps_refuse("resume", "already-running");
+    if (lrc < 0) return ps_refuse("resume", "lock-create-failed");
+
+    char bindp[PS_PW], winp[PS_PW], idsp[PS_PW];
+    cx_fmt(bindp, sizeof bindp, "%s/start-binding.tsv", dir);
+    cx_fmt(winp, sizeof winp, "%s/windows.tsv", dir);
+    cx_fmt(idsp, sizeof idsp, "%s/ids.txt", dir);
+    size_t bn = 0;
+    char *bt = ps_read_all(bindp, &bn);
+    if (!bt) return ps_unlock_refuse(lockp, "resume", "binding-missing");
+
+    char b_repo[PS_PW] = "", b_rev_sha[65] = "", b_tree_sha[65] = "", b_ape_sha[65] = "";
+    char b_win_sha[65] = "", b_ids_sha[65] = "", b_lanes[16] = "", b_jobs[16] = "";
+    const char *p = bt, *end = bt + bn;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        char line[4096];
+        size_t cp = ll < sizeof line - 1 ? ll : sizeof line - 1;
+        mm_copy(line, sizeof line, p, cp);
+        line[cp] = 0;
+        ps_trim_line(line);
+        p += ll + (nl ? 1 : 0);
+        if (ps_starts(line, "BINDING\t")) {
+            ps_kv_get(line, "\trepo=", b_repo, sizeof b_repo);
+            ps_kv_get(line, "\trev_sha=", b_rev_sha, sizeof b_rev_sha);
+            ps_kv_get(line, "\ttree_sha=", b_tree_sha, sizeof b_tree_sha);
+            ps_kv_get(line, "\tape_sha256=", b_ape_sha, sizeof b_ape_sha);
+            ps_kv_get(line, "\twindows_sha256=", b_win_sha, sizeof b_win_sha);
+            ps_kv_get(line, "\tids_sha256=", b_ids_sha, sizeof b_ids_sha);
+            ps_kv_get(line, "\tlanes=", b_lanes, sizeof b_lanes);
+            ps_kv_get(line, "\tmax_jobs=", b_jobs, sizeof b_jobs);
+        }
+    }
+    mm_free(bt);
+    if (!b_repo[0] || !b_rev_sha[0] || !b_tree_sha[0] || !b_ape_sha[0] || !b_win_sha[0] || !b_lanes[0] || !b_jobs[0])
+        return ps_unlock_refuse(lockp, "resume", "binding-malformed");
+    if (strcmp(b_ape_sha, ape_sha) != 0)
+        return ps_unlock_refuse(lockp, "resume", "candidate-mismatch");
+
+    char cur_win_sha[65], cur_ids_sha[65];
+    if (ps_sha_file(winp, cur_win_sha) || strcmp(cur_win_sha, b_win_sha) != 0)
+        return ps_unlock_refuse(lockp, "resume", "plan-windows-changed-or-missing");
+    if (ps_sha_file(idsp, cur_ids_sha) || strcmp(cur_ids_sha, b_ids_sha) != 0)
