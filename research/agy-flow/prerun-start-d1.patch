+/* Contract: checks tools/prerun-start.cx (P0 D1 admission gate and T11 warmup-cold-v2 receipt producer/verifier)
+ * offline on a throw-away git fixture, including an end-to-end execution of the real tools/dvqualify.cx.
+ * Verifies:
+ *   (1) D1 admission & verify-admission: passes positional ROOT (argv[1]) per tools/dvqualify.cx:635,
+ *       executes the REAL tools/dvqualify.cx end-to-end on the fixture repository (building an isolated layout
+ *       and producing real dvqualify strict evidence files qualify-*.tsv), catches failing batch (107 W0201 red
+ *       before freeze), passes after fix, generates admission-receipt.tsv, priority.tsv, and 8-column warmup-cold.tsv.
+ *   (2) T11 warmup-cold-v2 8-column strict-bound contract:
+ *       - Line 1: "warmup-cold-v2\t<cold_identity>"
+ *       - Line 2: "<batch_id>\tPASS\tcold-cache-off\t<ms>\tqualify-<batch_id>.tsv\t<strict_file_sha256>\t<strict_row_sha256>\t<raw_row_sha256>"
+ *       - Only cold-cache-off is accepted (cold-new-layout and warm-restart 5297 ms rejected at both admission and verify)
+ *       - 0 < ms < 12000 (12000 boundary rejected) and receipt ms must equal strict row ms (shortened ms rejected)
+ *       - Re-reads qualify-<batch_id>.tsv and verifies file SHA256, summary row SHA256, RAW row SHA256, candidate SHA256, and ms
+ *       - Verifies on-disk windows.tsv W0000 and "# w0000-proof=cold-v2\t<cold_id>\t<batch>" without rewriting windows.tsv.
+ * Layer: interfaces. Output: CHECK_PRERUN_START. */
+#pragma unisa use sys.fs
+#pragma unisa use sys.env
+#pragma unisa use sys.posix
+#pragma unisa use sys.proc
+
+static char tmp[4096], fx[4400], persist[4400], bin[4400], driver[4096];
+static int g_pass, g_fail;
+
+typedef struct { int rc; char *out; char *err; } np_result;
+
+static void np_free(np_result *r) {
+    if (r && r->out) { free(r->out); r->out = 0; r->err = 0; }
+}
+
+static int ck_copy(void *dst, size_t cap, const void *src, size_t n) {
+    if (!dst || !src || n > cap) return -1;
+    if (n > 0) memcpy(dst, src, n);
+    return 0;
+}
+
+static void ck(int ok, const char *name) {
+    if (ok) { g_pass++; printf("PASS\t%s\n", name); }
+    else { g_fail++; printf("FAIL\t%s\n", name); }
+}
+
+static int tk_has(const char *s, const char *sub) {
+    return s && sub && strstr(s, sub) != 0;
+}
+
+static np_result run(char **v, const char *cwd) {
+    np_result r = {0};
+    int cap = 131072, cut = 0;
+    char *buf = (char *)malloc((size_t)cap);
+    if (!buf) exit(2);
+    buf[0] = 0;
+    int rc;
+    if (cwd && cwd[0]) {
+        char *sv[] = {"sh", "-c", "cd \"$1\" && shift && exec \"$@\"", "sh", (char *)cwd,
+                      v[0], v[0] ? v[1] : 0, (v[0] && v[1]) ? v[2] : 0,
+                      (v[0] && v[1] && v[2]) ? v[3] : 0, 0};
+        rc = sy_run(sv, buf, cap, &cut);
+    } else {
+        rc = sy_run(v, buf, cap, &cut);
+    }
+    if (rc < 0) {
+        fprintf(stderr, "check-prerun-start: sy_run failed rc=%d\n", rc);
+        exit(2);
+    }
+    r.rc = rc;
+    r.out = buf;
+    r.err = buf;
+    return r;
+}
+
+static void sh(const char *cmd, const char *cwd) {
+    char *v[] = {"sh", "-c", (char *)cmd, 0};
+    np_result r = run(v, cwd);
+    if (r.rc) {
+        fprintf(stderr, "check-prerun-start: fixture step failed: %s\n%s",
+                cmd, r.out ? r.out : "");
+        exit(2);
+    }
+    np_free(&r);
+}
+
+int main(int argc, char **argv) {
+    if (sy_mkdtemp(sy_tmpdir(), "prerun-start-check-", tmp, sizeof tmp) ||
+        cx_fmt(fx, sizeof fx, "%s/repo", tmp) ||
+        cx_fmt(bin, sizeof bin, "%s/prerun-start", tmp)) return 2;
+    if (sy_realpath("./unisacc.com", driver, sizeof driver) < 0) return 2;
+    const char *home = sy_env("HOME");
+    if (!home || cx_fmt(persist, sizeof persist, "%s/.cache/unisacc/prerun-start-check-%ld", home, (long)sy_pid())) return 2;
+
+    if (sy_mkdir(fx, 0700) || sy_mkdir_all(persist, 0700)) return 2;
+
+    char repo_root[4096];
+    if (sy_realpath(".", repo_root, sizeof repo_root) < 0) return 2;
+
+    /* Fixture repo fx: no unisacc.com tracked inside git so real tools/dvqualify.cx populate_layout()
+     * can install ape1 into <lay>/unisacc.com and run real dvqualify layout + batch classification. */
+    char setup[10000];
+    cx_fmt(setup, sizeof setup,
+        "set -e; "
+        "mkdir -p tests; "
+        "printf 'id\\timplementation\\tmode\\tsource\\tentry\\targs\\texpected_rc\\tmarker\\tmaterials\\tscope\\towner\\theaders\\ttier\\n"
+        "light-a\\tIMPLEMENTED\\tSOURCE\\ta.cx\\t-\\t-\\t0\\tOK\\t-\\thost\\tc\\tproduct\\tsmoke\\n"
+        "light-b\\tIMPLEMENTED\\tSOURCE\\tb.cx\\t-\\t-\\t0\\tOK\\t-\\thost\\tc\\tproduct\\tsmoke\\n"
+        "w0201-aff\\tIMPLEMENTED\\tSOURCE\\tw.cx\\t-\\t-\\t0\\tOK\\t-\\thost\\tc\\tproduct\\tfull\\n' > tests/batches.tsv; "
+        "printf 'batch\\tdomain\\trule\\tsample\\tbasis\\n"
+        "light-a\\tproduct-qualification\\tr\\ts\\tb\\n"
+        "light-b\\tproduct-qualification\\tr\\ts\\tb\\n"
+        "w0201-aff\\tproduct-qualification\\tr\\ts\\tb\\n"
+        "new-heavy-prio\\tproduct-qualification\\tr\\ts\\tb\\n' > tests/batch-domain-index.tsv; "
+        "git init -q . && git add tests && git -c user.name=t -c user.email=t@t commit -q -m base && git rev-parse HEAD > '%s/base.txt'; "
+        "printf 'new-heavy-prio\\tIMPLEMENTED\\tSOURCE\\tn.cx\\t-\\t-\\t0\\tOK\\t-\\thost\\tc\\tproduct\\tfull\\n' >> tests/batches.tsv; "
+        "git add tests/batches.tsv && git -c user.name=t -c user.email=t@t commit -q -m head && git rev-parse HEAD > '%s/head.txt'",
+        tmp, tmp);
