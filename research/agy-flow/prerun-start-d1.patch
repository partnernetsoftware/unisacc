+static int ps_select_cold_warmup_batch(const char *cold_file, const char *want_cold_id,
+                                       char best_id[PS_IDLEN], long *best_max_ms, char *why, size_t wcap) {
+    size_t n = 0;
+    char *b = ps_read_all(cold_file, &n);
+    if (!b) { cx_fmt(why, wcap, "cold-times-unreadable"); return -1; }
+    const char *p = b, *end = b + n;
+    int got_hdr = 0;
+    int best_ix = -1;
+    long best_ms = 0;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        char line[512];
+        size_t cp = ll < sizeof line - 1 ? ll : sizeof line - 1;
+        mm_copy(line, sizeof line, p, cp);
+        line[cp] = 0;
+        ps_trim_line(line);
+        p += ll + (nl ? 1 : 0);
+        if (!line[0] || line[0] == '#') continue;
+        char *cols[6]; int nc = 0; char *q = line;
+        while (nc < 6) {
+            cols[nc++] = q;
+            char *tb = strchr(q, '\t');
+            if (!tb) break;
+            *tb = 0;
+            q = tb + 1;
+        }
+        if (!got_hdr) {
+            if (nc != 2 || strcmp(cols[0], "warmup-cold-v1") || strlen(cols[1]) != 64 || !ps_is_hex(cols[1], 64)) {
+                mm_free(b);
+                cx_fmt(why, wcap, "cold-header-invalid");
+                return -1;
+            }
+            if (strcmp(cols[1], want_cold_id)) {
+                mm_free(b);
+                cx_fmt(why, wcap, "cold-identity-mismatch");
+                return -1;
+            }
+            got_hdr = 1;
+            continue;
+        }
+        if (nc != 4 || !ps_is_digits(cols[1], strlen(cols[1])) ||
+            !ps_is_digits(cols[2], strlen(cols[2])) || !ps_is_digits(cols[3], strlen(cols[3]))) {
+            mm_free(b);
+            cx_fmt(why, wcap, "cold-row-malformed");
+            return -1;
+        }
+        long m1 = atol(cols[1]), m2 = atol(cols[2]), m3 = atol(cols[3]);
+        if (m1 <= 0 || m2 <= 0 || m3 <= 0) {
+            mm_free(b);
+            cx_fmt(why, wcap, "cold-row-nonpositive");
+            return -1;
+        }
+        long mx = m1 > m2 ? m1 : m2;
+        if (m3 > mx) mx = m3;
+        int ix = ps_find_id(cols[0]);
+        if (ix < 0) continue;
+        if (g_prio[ix] > 0 || ps_is_heavy_id(cols[0]) || ps_is_early_canary_id(cols[0]) ||
+            ps_is_warmup_excluded_id(cols[0])) continue;
+        if (mx > PS_COLD_MAX_MS) continue;
+        if (best_ix < 0 || mx < best_ms || (mx == best_ms && ix < best_ix)) {
+            best_ix = ix;
+            best_ms = mx;
+        }
+    }
+    mm_free(b);
+    if (!got_hdr) { cx_fmt(why, wcap, "cold-header-missing"); return -1; }
+    if (best_ix < 0) { cx_fmt(why, wcap, "no-eligible-cold-warmup-batch"); return -1; }
+    cx_fmt(best_id, PS_IDLEN, "%s", g_ids[best_ix]);
+    *best_max_ms = best_ms;
+    return 0;
+}
+
+static int ps_enforce_w0000_and_verify_windows(const char *wpath, const char *best_id, char *why, size_t wcap) {
+    size_t n = 0;
+    char *b = ps_read_all(wpath, &n);
+    if (!b) { cx_fmt(why, wcap, "windows-unreadable"); return -1; }
+
+    char w0_id[PS_IDLEN] = "";
+    const char *p = b, *end = b + n;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        if (ll > 6 && !memcmp(p, "W0000\t", 6)) {
+            char line[1024];
+            size_t cp = ll < sizeof line - 1 ? ll : sizeof line - 1;
+            mm_copy(line, sizeof line, p, cp);
+            line[cp] = 0;
+            ps_trim_line(line);
+            char *cols[6]; int nc = 0; char *q = line;
+            while (nc < 6) {
+                cols[nc++] = q;
+                char *tb = strchr(q, '\t');
+                if (!tb) break;
+                *tb = 0;
+                q = tb + 1;
+            }
+            if (nc == 5 && !strcmp(cols[1], "1") && !strcmp(cols[2], "warmup") && !strcmp(cols[3], "1")) {
+                cx_fmt(w0_id, sizeof w0_id, "%s", cols[4]);
+            }
+            break;
+        }
+        p += ll + (nl ? 1 : 0);
+    }
+    if (!w0_id[0]) { mm_free(b); cx_fmt(why, wcap, "w0000-warmup-missing"); return -1; }
+
+    if (strcmp(w0_id, best_id) != 0) {
+        np_buf out = {0};
+        p = b;
+        while (p < end) {
+            const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+            size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+            char line[8192];
+            size_t cp = ll < sizeof line - 1 ? ll : sizeof line - 1;
+            mm_copy(line, sizeof line, p, cp);
+            line[cp] = 0;
+            ps_trim_line(line);
+            p += ll + (nl ? 1 : 0);
+            if (line[0] != 'W') {
+                np_puts(&out, line);
+                np_puts(&out, "\n");
+                continue;
+            }
+            char *cols[6]; int nc = 0; char *q = line;
+            while (nc < 6) {
+                cols[nc++] = q;
+                char *tb = strchr(q, '\t');
+                if (!tb) break;
+                *tb = 0;
+                q = tb + 1;
+            }
+            if (nc != 5) { free(out.p); mm_free(b); cx_fmt(why, wcap, "windows-row-malformed"); return -1; }
+            char prefix[256];
+            cx_fmt(prefix, sizeof prefix, "%s\t%s\t%s\t%s\t", cols[0], cols[1], cols[2], cols[3]);
+            np_puts(&out, prefix);
+            if (!strcmp(cols[0], "W0000")) {
+                np_puts(&out, best_id);
+            } else {
+                char *s = cols[4];
+                int first_tok = 1;
+                while (*s) {
+                    char *c = strchr(s, ',');
+                    if (c) *c = 0;
+                    if (!first_tok) np_puts(&out, ",");
+                    first_tok = 0;
+                    if (!strcmp(s, best_id)) np_puts(&out, w0_id);
+                    else np_puts(&out, s);
+                    if (!c) break;
+                    s = c + 1;
+                }
+            }
+            np_puts(&out, "\n");
+        }
+        mm_free(b);
+        if (cx_write(wpath, out.p ? out.p : "", out.n)) {
+            free(out.p);
+            cx_fmt(why, wcap, "windows-rewrite-failed");
+            return -1;
+        }
+        free(out.p);
+        b = ps_read_all(wpath, &n);
+        if (!b) { cx_fmt(why, wcap, "windows-reread-failed"); return -1; }
+    }
+
+    static int seen[PS_MAXIDS];
+    for (int i = 0; i < g_nids; i++) seen[i] = 0;
+    int w0_ok = 0;
+    p = b; end = b + n;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t ll = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        char line[8192];
+        size_t cp = ll < sizeof line - 1 ? ll : sizeof line - 1;
+        mm_copy(line, sizeof line, p, cp);
+        line[cp] = 0;
+        ps_trim_line(line);
+        p += ll + (nl ? 1 : 0);
+        if (line[0] != 'W') continue;
+        char *cols[6]; int nc = 0; char *q = line;
+        while (nc < 6) {
+            cols[nc++] = q;
+            char *tb = strchr(q, '\t');
+            if (!tb) break;
+            *tb = 0;
+            q = tb + 1;
+        }
+        if (nc != 5) { mm_free(b); cx_fmt(why, wcap, "windows-row-malformed"); return -1; }
+        if (!strcmp(cols[2], "prebuild-self")) continue;
+        if (!strcmp(cols[0], "W0000")) {
+            if (!strcmp(cols[1], "1") && !strcmp(cols[2], "warmup") && !strcmp(cols[3], "1") && !strcmp(cols[4], best_id))
+                w0_ok = 1;
+        }
+        char *s = cols[4];
+        while (*s) {
+            char *c = strchr(s, ',');
+            if (c) *c = 0;
+            int ix = ps_find_id(s);
+            if (ix < 0 || seen[ix]) {
+                mm_free(b);
+                cx_fmt(why, wcap, "window-duplicate-or-unknown-batch");
+                return -1;
+            }
+            seen[ix] = 1;
+            if (!c) break;
+            s = c + 1;
+        }
+    }
+    mm_free(b);
+    if (!w0_ok) { cx_fmt(why, wcap, "w0000-not-selected-light-batch"); return -1; }
+    for (int i = 0; i < g_nids; i++) {
+        if (!seen[i]) {
+            cx_fmt(why, wcap, "window-plan-missing-batch");
+            return -1;
+        }
+    }
+    return 0;
+}
+
+/* Atomic lock acquisition via O_CREAT | O_EXCL before writing any plan/input file.
+ * Negative-control hook PRERUN_START_MUT_SKIP_LOCK=1 disables atomic locking to prove test sensitivity. */
+static int ps_lock_acquire(const char *dir, char lock_path[PS_PW]) {
+    if (cx_fmt(lock_path, PS_PW, "%s/run.lock", dir)) return -1;
+    const char *mut = sy_env("PRERUN_START_MUT_SKIP_LOCK");
+    if (mut && !strcmp(mut, "1")) {
+        lock_path[0] = 0;
+        return 0;
+    }
+    char pbuf[64];
+    cx_fmt(pbuf, sizeof pbuf, "%ld\n", (long)sy_pid());
+    for (int attempt = 0; attempt < 2; attempt++) {
+        int fd = sy_open(lock_path, O_WRONLY | O_CREAT | O_EXCL, 0600);
+        if (fd >= 0) {
+            int werr = sy_write_all(fd, pbuf, (long)strlen(pbuf));
+            int cerr = sy_close(fd);
+            if (werr || cerr) { sy_unlink(lock_path); lock_path[0] = 0; return -1; }
+            return 0;
+        }
+        size_t n = 0;
+        char *b = ps_read_all(lock_path, &n);
+        if (!b) { lock_path[0] = 0; return 1; }
+        ps_trim_line(b);
+        long pid = atol(b);
+        mm_free(b);
+        if (pid <= 1) { lock_path[0] = 0; return 1; }
+        char proc_p[128];
+        sy_stat_t st;
+        if (!cx_fmt(proc_p, sizeof proc_p, "/proc/%ld", pid) && sy_stat(proc_p, &st) == 0) {
+            lock_path[0] = 0;
+            return 1; /* live process holds lock */
+        }
+        if (attempt == 0) sy_unlink(lock_path);
+    }
+    lock_path[0] = 0;
+    return 1;
+}
+
+static int ps_cmd_start(int argc, char **argv) {
+    const char *rev = 0, *ver = 0, *prev = 0, *prevrev = 0, *ape = 0, *dir = 0, *prio = 0, *coldf = 0;
+    const char *repo = ".", *pwin = 0, *tcache = 0, *evout = 0, *exclf = 0, *addf = 0;
+    const char *in_prog = "tools/prerun-inputs.cx", *dr_prog = "tools/prerun-drive.cx";
+    int lanes = 2, jobs = 8, notpl = 0, plan_only = 0;
+    for (int i = 2; i < argc; i++) {
+        const char *k = argv[i];
+        if (!strcmp(k, "--no-templates")) { notpl = 1; continue; }
+        if (!strcmp(k, "--plan-only")) { plan_only = 1; continue; }
+        if (!strcmp(k, "--normal-jobs")) return ps_refuse("start", "normal-jobs-refused-use-jobs");
+        const char *v = i + 1 < argc ? argv[i + 1] : 0;
+        if (!v) return ps_refuse("start", "missing-value");
+        if (!strcmp(k, "--rev")) rev = v;
+        else if (!strcmp(k, "--version")) ver = v;
+        else if (!strcmp(k, "--prev")) prev = v;
+        else if (!strcmp(k, "--prev-rev")) prevrev = v;
+        else if (!strcmp(k, "--ape") || !strcmp(k, "--candidate")) ape = v;
+        else if (!strcmp(k, "--dir") || !strcmp(k, "--out")) dir = v;
+        else if (!strcmp(k, "--priority-src")) prio = v;
+        else if (!strcmp(k, "--cold-times-file")) coldf = v;
+        else if (!strcmp(k, "--repo") || !strcmp(k, "--root")) repo = v;
+        else if (!strcmp(k, "--prev-windows")) pwin = v;
+        else if (!strcmp(k, "--times-cache")) tcache = v;
+        else if (!strcmp(k, "--evidence-out")) evout = v;
+        else if (!strcmp(k, "--exclude")) exclf = v;
+        else if (!strcmp(k, "--add-ids")) addf = v;
+        else if (!strcmp(k, "--inputs-prog")) in_prog = v;
+        else if (!strcmp(k, "--drive-prog")) dr_prog = v;
+        else if (!strcmp(k, "--lanes") || !strcmp(k, "--window-lanes")) lanes = atoi(v);
+        else if (!strcmp(k, "--jobs") || !strcmp(k, "--max-jobs")) jobs = atoi(v);
+        else return ps_refuse("start", "unknown-option");
+        i++;
+    }
+    if (!rev || !ver || !prev || !ape || !dir || !prio || !coldf)
+        return ps_refuse("start", "need-rev-version-prev-ape-dir-priority-coldtimes");
+    if (lanes < 1 || lanes > 8 || jobs < 1 || jobs > 16)
+        return ps_refuse("start", "lanes-1..8-and-jobs-1..16");
+    if (dir[0] != '/' || ape[0] != '/')
+        return ps_refuse("start", "dir-and-ape-must-be-absolute");
+
+    char rrepo[PS_PW], rape[PS_PW], rcold[PS_PW];
+    sy_stat_t st;
+    if (sy_realpath(repo, rrepo, sizeof rrepo) < 0) return ps_refuse("start", "repo-unresolvable");
+    if (sy_realpath(ape, rape, sizeof rape) < 0 || sy_stat(rape, &st) || st.kind != 'f')
+        return ps_refuse("start", "kit-missing-ape");
+    if (sy_realpath(coldf, rcold, sizeof rcold) < 0 || sy_stat(rcold, &st) || st.kind != 'f')
+        return ps_refuse("start", "cold-times-file-missing");
+
+    if (sy_mkdir_all(dir, 0700)) return ps_refuse("start", "dir-create-failed");
+
+    /* Acquire atomic O_CREAT|O_EXCL run.lock BEFORE writing any input, plan, or binding file. */
+    char lockp[PS_PW] = "";
+    int lrc = ps_lock_acquire(dir, lockp);
+    if (lrc == 1) return ps_refuse("start", "already-running");
+    if (lrc < 0) return ps_refuse("start", "lock-create-failed");
+
+    char bindp[PS_PW], w0p[PS_PW], d0p[PS_PW];
+    cx_fmt(bindp, sizeof bindp, "%s/start-binding.tsv", dir);
+    cx_fmt(w0p, sizeof w0p, "%s/strict-W0000.tsv", dir);
+    cx_fmt(d0p, sizeof d0p, "%s/done.W0000", dir);
+    if (sy_exists(bindp) == 1 || sy_exists(w0p) == 1 || sy_exists(d0p) == 1)
+        return ps_unlock_refuse(lockp, "start", "already-started-use-resume");
+
+    char cold_id[65], rev_sha[41], tree_sha[41], ape_sha[65], batches_sha[65];
+    if (ps_compute_cold_identity(rrepo, rev, rape, cold_id, rev_sha, tree_sha, ape_sha, batches_sha))
+        return ps_unlock_refuse(lockp, "start", "cold-identity-compute-failed");
+
+    /* Step 1: invoke prerun-inputs.cx */
+    char lanes_s[16], jobs_s[16];
+    cx_fmt(lanes_s, sizeof lanes_s, "%d", lanes);
+    cx_fmt(jobs_s, sizeof jobs_s, "%d", jobs);
+    char *iv[36]; int ic = ps_prog_prefix(iv, in_prog);
+    iv[ic++] = "--rev"; iv[ic++] = (char *)rev;
+    iv[ic++] = "--version"; iv[ic++] = (char *)ver;
+    iv[ic++] = "--prev"; iv[ic++] = (char *)prev;
+    if (prevrev) { iv[ic++] = "--prev-rev"; iv[ic++] = (char *)prevrev; }
+    iv[ic++] = "--repo"; iv[ic++] = rrepo;
+    iv[ic++] = "--ape"; iv[ic++] = rape;
+    iv[ic++] = "--dir"; iv[ic++] = (char *)dir;
+    iv[ic++] = "--priority-src"; iv[ic++] = (char *)prio;
+    iv[ic++] = "--lanes"; iv[ic++] = lanes_s;
+    iv[ic++] = "--jobs"; iv[ic++] = jobs_s;
+    if (pwin) { iv[ic++] = "--prev-windows"; iv[ic++] = (char *)pwin; }
+    if (tcache) { iv[ic++] = "--times-cache"; iv[ic++] = (char *)tcache; }
+    if (evout) { iv[ic++] = "--evidence-out"; iv[ic++] = (char *)evout; }
+    if (notpl) { iv[ic++] = "--no-templates"; }
+    if (exclf) { iv[ic++] = "--exclude"; iv[ic++] = (char *)exclf; }
+    if (addf) { iv[ic++] = "--add-ids"; iv[ic++] = (char *)addf; }
+    iv[ic] = 0;
+
+    np_result ir = {0}; char iwhy[512];
+    if (np_run(iv, rrepo, 0, 50, &ir, iwhy, sizeof iwhy) || ir.rc != 0 || !ir.out ||
+        tx_find(ir.out, (long)ir.outn, "status=READY", 12) < 0) {
+        if (ir.out && ir.outn) fwrite(ir.out, 1, ir.outn, stdout);
+        if (ir.err && ir.errn) fwrite(ir.err, 1, ir.errn, stderr);
+        np_free(&ir);
+        return ps_unlock_refuse(lockp, "start", "prerun-inputs-not-ready");
+    }
+    fwrite(ir.out, 1, ir.outn, stdout);
+    np_free(&ir);
+
+    char idsp[PS_PW], timesp[PS_PW], priop[PS_PW], winp[PS_PW];
+    cx_fmt(idsp, sizeof idsp, "%s/ids.txt", dir);
+    cx_fmt(timesp, sizeof timesp, "%s/times.tsv", dir);
+    cx_fmt(priop, sizeof priop, "%s/priority.tsv", dir);
+    cx_fmt(winp, sizeof winp, "%s/windows.tsv", dir);
+    if (ps_load_ids_list(idsp) || ps_load_priority_marks(priop))
+        return ps_unlock_refuse(lockp, "start", "inputs-artifacts-missing");
+
+    char best_id[PS_IDLEN] = "";
+    long best_ms = 0;
+    char cwhy[256];
+    if (ps_select_cold_warmup_batch(rcold, cold_id, best_id, &best_ms, cwhy, sizeof cwhy))
+        return ps_unlock_refuse(lockp, "start", cwhy);
+
+    /* Step 2: invoke prerun-drive.cx plan with --warmup 1 [--cold-times-file --cold-identity] */
+    int has_cold_cli = ps_prog_has_token(rrepo, dr_prog, "--cold-times-file");
+    char *pv[28]; int pc = ps_prog_prefix(pv, dr_prog);
+    pv[pc++] = "plan";
+    pv[pc++] = "--ids-file"; pv[pc++] = idsp;
+    pv[pc++] = "--times-file"; pv[pc++] = timesp;
+    pv[pc++] = "--priority-file"; pv[pc++] = priop;
+    pv[pc++] = "--out"; pv[pc++] = (char *)dir;
+    pv[pc++] = "--normal-jobs"; pv[pc++] = jobs_s;
+    pv[pc++] = "--window-lanes"; pv[pc++] = lanes_s;
+    pv[pc++] = "--warmup"; pv[pc++] = "1";
+    if (has_cold_cli) {
+        pv[pc++] = "--cold-times-file"; pv[pc++] = rcold;
+        pv[pc++] = "--cold-identity"; pv[pc++] = cold_id;
+    }
+    pv[pc] = 0;
+    np_result pr = {0}; char pwhy[512];
+    if (np_run(pv, rrepo, 0, 50, &pr, pwhy, sizeof pwhy)) {
+        np_free(&pr);
+        return ps_unlock_refuse(lockp, "start", "plan-transport-failed");
+    }
+    if (has_cold_cli && pr.rc == 2 && pr.err && tx_find(pr.err, (long)pr.errn, "unknown-plan-arg", 16) >= 0) {
+        np_free(&pr);
+        pc -= 4;
+        pv[pc] = 0;
+        if (np_run(pv, rrepo, 0, 50, &pr, pwhy, sizeof pwhy) || pr.rc != 0) {
+            if (pr.err && pr.errn) fwrite(pr.err, 1, pr.errn, stderr);
+            np_free(&pr);
+            return ps_unlock_refuse(lockp, "start", "plan-failed");
+        }
+    } else if (pr.rc != 0) {
+        if (pr.err && pr.errn) fwrite(pr.err, 1, pr.errn, stderr);
+        np_free(&pr);
+        return ps_unlock_refuse(lockp, "start", "plan-failed");
+    }
+    if (pr.out && pr.outn) fwrite(pr.out, 1, pr.outn, stdout);
+    np_free(&pr);
+
+    if (ps_enforce_w0000_and_verify_windows(winp, best_id, cwhy, sizeof cwhy))
+        return ps_unlock_refuse(lockp, "start", cwhy);
+
+    char win_sha[65], ids_sha[65];
+    if (ps_sha_file(winp, win_sha) || ps_sha_file(idsp, ids_sha))
+        return ps_unlock_refuse(lockp, "start", "plan-hash-failed");
+
+    char bind_text[4096];
+    cx_fmt(bind_text, sizeof bind_text,
+           "# prerun-start binding (schema=v1)\n"
+           "BINDING\tschema=v1\trepo=%s\trev=%s\trev_sha=%s\tversion=%s\ttree_sha=%s\tape_path=%s\tape_sha256=%s\tcold_identity=%s\twarmup_batch=%s\twarmup_cold_max_ms=%ld\twindows_sha256=%s\tids_sha256=%s\tlanes=%d\tmax_jobs=%d\n",
+           rrepo, rev, rev_sha, ver, tree_sha, rape, ape_sha, cold_id, best_id, best_ms, win_sha, ids_sha, lanes, jobs);
+    if (cx_write(bindp, bind_text, strlen(bind_text)))
+        return ps_unlock_refuse(lockp, "start", "binding-write-failed");
+
+    printf("PRERUN_START\tPLAN_READY\tdir=%s\twarmup=%s\twarmup_cold_max_ms=%ld\tcold_identity=%s\twindows_sha=%s\tlanes=%d\tmax_jobs=%d\n",
+           dir, best_id, best_ms, cold_id, win_sha, lanes, jobs);
+    if (plan_only) {
+        if (lockp[0]) sy_unlink(lockp);
+        return 0;
+    }
+
+    /* Step 3: invoke prerun-drive.cx run (only --max-jobs and --keep-going, never --normal-jobs; bound = 5400s) */
+    char *rv[20]; int rc_i = ps_prog_prefix(rv, dr_prog);
+    rv[rc_i++] = "run";
+    rv[rc_i++] = "--root"; rv[rc_i++] = rrepo;
+    rv[rc_i++] = "--candidate"; rv[rc_i++] = rape;
+    rv[rc_i++] = "--out"; rv[rc_i++] = (char *)dir;
+    rv[rc_i++] = "--window-lanes"; rv[rc_i++] = lanes_s;
+    rv[rc_i++] = "--max-jobs"; rv[rc_i++] = jobs_s;
+    rv[rc_i++] = "--keep-going";
+    rv[rc_i] = 0;
+    np_result rr = {0}; char rwhy[512];
+    int tr = np_run(rv, rrepo, 0, PS_RUN_BOUND_SECS, &rr, rwhy, sizeof rwhy);
+    int rrc = tr ? 2 : rr.rc;
+    if (rr.out && rr.outn) fwrite(rr.out, 1, rr.outn, stdout);
+    if (rr.err && rr.errn) fwrite(rr.err, 1, rr.errn, stderr);
+    np_free(&rr);
+    if (lockp[0]) sy_unlink(lockp);
+    printf("PRERUN_START\tRUN_DONE\trc=%d\tdir=%s\twarmup=%s\tbound_s=%d\n", rrc, dir, best_id, PS_RUN_BOUND_SECS);
+    return rrc;
+}
