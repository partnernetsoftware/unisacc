+    cx_fmt(mock_af_bin, sizeof mock_af_bin, "%s/mock-affected", tmp);
+    cx_fmt(mock_dv_bin, sizeof mock_dv_bin, "%s/mock-dvqualify", tmp);
+    cx_fmt(real_dv_exec, sizeof real_dv_exec, "%s/real-dvqualify-exec", tmp);
+
+    /* Fixture candidate APE executed by REAL tools/dvqualify.cx inside its isolated git layout */
+    const char *ape1_sh =
+        "#!/bin/sh\n"
+        "if [ \"$1\" = --version ]; then echo 'unisacc 0.1.1-fixture'; exit 0; fi\n"
+        "git rev-parse --verify HEAD >/dev/null 2>&1 || { echo 'no git inventory'; exit 3; }\n"
+        "[ -L ./unisacc.com ] && { echo 'unisacc.com is a link'; exit 4; }\n"
+        "s=$(sha256sum ./unisacc.com | cut -c1-64)\n"
+        "printf 'BATCH_RUN\\tid=%s\\tstatus=PASS\\trc=0\\ttransport=0\\tmarker=FIXTURE\\tcandidate=%s\\theaders=product\\tscope=actual-one-batch-no-cached-result\\tassertions=4\\n' \"$4\" \"$s\"\n";
+    const char *ape2_sh = "#!/bin/sh\necho 'unisacc 0.1.1-other'\n";
+
+    const char *af_sh =
+        "#!/bin/sh\n"
+        "while [ $# -gt 0 ]; do\n"
+        "  case \"$1\" in\n"
+        "    --since) shift 2;;\n"
+        "    --list-only) shift;;\n"
+        "    *) echo \"mock-affected: unknown arg $1\" >&2; exit 2;;\n"
