+static int ps_cmd_cold_identity(int argc, char **argv) {
+    const char *root = 0, *cand = 0, *rev = "HEAD";
+    for (int i = 2; i < argc; i++) {
+        const char *k = argv[i], *v = i + 1 < argc ? argv[i + 1] : 0;
+        if (!v) return ps_refuse("cold-identity", "missing-value");
+        if (!strcmp(k, "--root") || !strcmp(k, "--repo")) root = v;
+        else if (!strcmp(k, "--candidate") || !strcmp(k, "--ape")) cand = v;
+        else if (!strcmp(k, "--rev")) rev = v;
+        else return ps_refuse("cold-identity", "unknown-option");
+        i++;
+    }
+    if (!root || !cand) return ps_refuse("cold-identity", "need-root-and-candidate");
+    char rroot[PS_PW], rcand[PS_PW], cold_id[65], rev_sha[41], tree_sha[41], ape_sha[65], b_sha[65];
+    if (sy_realpath(root, rroot, sizeof rroot) < 0 || sy_realpath(cand, rcand, sizeof rcand) < 0)
+        return ps_refuse("cold-identity", "path-unresolvable");
+    if (ps_compute_cold_identity(rroot, rev, rcand, cold_id, rev_sha, tree_sha, ape_sha, b_sha))
+        return ps_refuse("cold-identity", "identity-compute-failed");
+    printf("PRERUN_START\tCOLD_IDENTITY\t%s\trev=%s\ttree=%s\tcandidate=%s\tbatches=%s\n",
+           cold_id, rev_sha, tree_sha, ape_sha, b_sha);
+    return 0;
+}
