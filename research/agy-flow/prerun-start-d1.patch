+        "  case \"$1\" in\n"
+        "    --candidate) cand=\"$2\"; shift 2;;\n"
+        "    --ids) id=\"$2\"; shift 2;;\n"
+        "    --jobs) jobs=\"$2\"; shift 2;;\n"
+        "    --segment-batches) seg=\"$2\"; shift 2;;\n"
+        "    --out) out=\"$2\"; shift 2;;\n"
