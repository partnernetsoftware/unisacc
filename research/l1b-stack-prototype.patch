+int bk_arm(int i, long off) {
+    int op; int wr; int ok; op=tkop[i];wr=0;
+    /* First-operand destinations in the finite low-level catalog. Memory stores are excluded. */
+    if ((op>=0 && op<=25 && op!=22 && op!=24) || (op>=42 && op<=65) || op==TO_SETREG || op==TO_HOSTADDR || op==TO_ARGVGET) wr=1;
