+        tka[i*4]=14; ok=bk_arm_inner(i,off); tka[i*4]=7;
+        if (!ok) return 0;
+        ow(0xEB0701DF); ow(0x540000C2);
+        a_shadow(14); ow(0xAA0E03E7); ow(0x14000005);
+        ow(0xAA0E03E7); a_shadow(7);
+        return 1;
+    }
+    return bk_arm_inner(i,off);
