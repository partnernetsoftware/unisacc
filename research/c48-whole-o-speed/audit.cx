/* Read-only X2 identities and whole-o receipts. This does not launch builds. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sysx.process
static const char *snap="out/release-snap-58093906dc";
static const char *rev="58093906dcb356d92df13553776dcb19cbff796a";
static char output[65536];static long used;
#define ADD(...) do {int z=snprintf(output+used,sizeof output-used,__VA_ARGS__);if(z<0||z>=(int)sizeof output-used)die("audit output limit");used+=z;} while(0)
static void die(const char *s){fprintf(stderr,"X2_AUDIT REFUSE %s errno=%d\n",s,errno);exit(2);}
static char *load(const char *p,size_t *n){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode))die("regular input");char *s=cx_read(p,n);if(!s)die("read input");return s;}
static void sha(const void *s,size_t n,char h[65]){if(sy_sha256_hex(s,n,h)&&cx_sha256_hex(s,n,h))die("SHA");}
static char *sourcefile(const char *base,const char *rel,size_t *n,char resolved[8192]){char root[8192],p[8192],real[8192];if(!realpath(base,root)||cx_fmt(p,sizeof p,"%s/%s",base,rel)||!realpath(p,real))die("source resolution");size_t z=strlen(root);if(strncmp(real,root,z)||real[z]!='/')die("source link escapes root");if(strlen(real+z+1)>=8192)die("source path length");strcpy(resolved,real+z+1);return load(real,n);}
static void filehash(const char *p,char h[65]){size_t n;char *s=load(p,&n);sha(s,n,h);free(s);}
static long number(const char *s){if(!*s||(s[0]=='0'&&s[1]))die("number syntax");long n=0;for(;*s;s++){if(*s<'0'||*s>'9'||n>(9223372036854775807L-(*s-'0'))/10)die("number overflow");n=n*10+*s-'0';}return n;}
static void ascii(const char *s,size_t n){if(!n||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))die("TSV framing");}
static int roots(const char *source,char names[44][256]){char *p=strstr(source,"static const char *rb_whole_src[RB_WHOLE_SRC] = {");if(!p)die("whole array");p=strchr(p,'{')+1;int n=0;while(*p){if(p[0]=='/'&&p[1]=='*'){char *e=strstr(p+2,"*/");if(!e)die("array comment");p=e+2;continue;}if(*p=='}')break;if(*p=='"'){char *e=strchr(++p,'"');if(!e||e-p>=256||e-p<5||n==44||memcmp(p,"src/",4)||memchr(p,'\\',e-p))die("array path");memcpy(names[n],p,e-p);names[n][e-p]=0;if(strstr(names[n],".."))die("array traversal");for(int j=0;j<n;j++)if(!strcmp(names[n],names[j]))die("array duplicate");n++;p=e+1;}else p++;}if(n!=44||*p!='}')die("44 roots required");return n;}
static unsigned long u32(const unsigned char *p){return p[0]|(unsigned long)p[1]<<8|(unsigned long)p[2]<<16|(unsigned long)p[3]<<24;}
static unsigned u16(const unsigned char *p){return p[0]|p[1]<<8;}
static void format(const unsigned char *p,size_t n,int index){if(index<2){if(n<32||u32(p)!=0xfeedfacfUL||u32(p+4)!=(index==0?0x01000007UL:0x0100000cUL)||u32(p+12)!=2)die("MachO CPU/filetype");}else{if(n<64||p[0]!='M'||p[1]!='Z')die("PE DOS");unsigned long at=u32(p+60);if(at>n-24||memcmp(p+at,"PE\0\0",4)||u16(p+at+4)!=(index==2?0x8664:0xaa64)||u16(p+at+6)<1||u16(p+at+20)<112||at+24+u16(p+at+20)>n||u16(p+at+24)!=0x20b)die("PE CPU/header");}}
static void identities(void){const char *files[]={"tools/release-build.cx","out/c48-x2/release-build","out/c47-driver-fix/constructor","out/c47-driver-fix/ape/p3-package.body","unisacc.com"};const char *expected[]={"46671add95316041160768aae6cb37941342907d824857a014f184e761d8a53a","5fb91caf66447b0df57a918b275fd578c3e51a7c96ac63e90d16bebe767f811e","fc45d417f459a4cd721f1f37485ae438d9d9e998e38bf2d6f28df1f408580db3","0d5696535d0062d038bc71a97b266904b69f174a9b799555c2981d5b182c5ad4","f069d4c92b7f5ede508809aa3abd21e326cbecadb2fb9eccf0bd1ac7004c3e82"};for(int i=0;i<5;i++){char h[65];filehash(files[i],h);if(strcmp(h,expected[i]))die("execution input SHA changed");ADD("IDENTITY\t%s\tsha=%s\n",files[i],h);}}
static void target(int index){const char *targets[]={"osx/x86_64","osx/arm64","win/x86_64","win/arm64"},*slugs[]={"osx-x86_64","osx-arm64","win-x86_64","win-arm64"},*old[]={"out/c47-driver-fix/osx-x86_64/slice-osx-x86_64","out/c47-driver-fix/whole/slice-osx-arm64","out/c47-driver-fix/win-x86_64/slice-win-x86_64","out/c47-driver-fix/win-arm64/slice-win-arm64"};char file[8192];snprintf(file,sizeof file,"out/c48-x2/%s/receipt.txt",slugs[index]);size_t n;char *receipt=load(file,&n);ascii(receipt,n);char rh[65];sha(receipt,n,rh);char *p=receipt,*v[8];const char *keys[]={"route","target","rev","image","sha","bytes","ns","rc"};for(int i=0;i<8;i++){char *e=strchr(p,'\n');if(!e)die("receipt line count");*e=0;char *tab=strchr(p,'\t');if(!tab||strchr(tab+1,'\t'))die("receipt fields");*tab=0;if(strcmp(p,keys[i]))die("receipt field order");v[i]=tab+1;p=e+1;}if(*p||strcmp(v[0],"whole-o")||strcmp(v[1],targets[index])||strcmp(v[2],rev)||strcmp(v[7],"0"))die("receipt identity/rc");char image[100];snprintf(image,sizeof image,"slice-%s",slugs[index]);if(strcmp(v[3],image))die("receipt basename");long bytes=number(v[5]),ns=number(v[6]);if(bytes<1||ns<1||ns>=60000000000L)die("receipt 60s bound");snprintf(file,sizeof file,"out/c48-x2/%s/%s",slugs[index],image);size_t image_n;unsigned char *actual=(unsigned char *)load(file,&image_n);char ih[65];sha(actual,image_n,ih);if((long)image_n!=bytes||strcmp(ih,v[4]))die("image actual SHA/size");format(actual,image_n,index);size_t oldn;char *historical=load(old[index],&oldn);char oh[65];sha(historical,oldn,oh);int same=oldn==image_n&&!memcmp(actual,historical,image_n);snprintf(file,sizeof file,"out/c48-x2/%s.log",slugs[index]);size_t logn;char *log=load(file,&logn);ascii(log,logn);if(!strstr(log,"PROFILE\t")||!strstr(log,"RR_TIME\t"))die("profile instrumentation absent");char expected[500];snprintf(expected,sizeof expected,"release-build\twhole-o\ttarget=%s\tsha=%s\tbytes=%ld\tns=%ld\trc=0\n",targets[index],ih,bytes,ns);char *end=strstr(log,expected);if(!end||end+strlen(expected)!=log+logn)die("whole terminal log mismatch");char lh[65];sha(log,logn,lh);ADD("TARGET\t%s\timage_sha=%s\tbytes=%ld\tns=%ld\tformat_cpu=VERIFIED\treceipt_sha=%s\tlog_sha=%s\tC47_equal=%d\tC47_sha=%s\n",targets[index],ih,bytes,ns,rh,lh,same,oh);free(log);free(historical);free(actual);free(receipt);}
int main(int argc,char **argv){int final=argc==2&&!strcmp(argv[1],"--final");if(argc!=2||(!final&&strcmp(argv[1],"--prepare")))die("usage --prepare|--final");identities();size_t n;char *source=load("tools/release-build.cx",&n);if(!strstr(source,"#define RB_WHOLE_DEADLINE_MS 60000"))die("default bound source");char current[44][256],frozen[44][256];roots(source,current);char file[8192];snprintf(file,sizeof file,"%s/tools/release-build.cx",snap);char *ss=load(file,&n);roots(ss,frozen);snprintf(file,sizeof file,"%s/.release-rev",snap);char *marker=load(file,&n);if(n!=40||memcmp(marker,rev,40))die("snapshot revision marker");free(marker);long start=used;for(int i=0;i<44;i++){if(strcmp(current[i],frozen[i]))die("snapshot root order");char p[8192];snprintf(p,sizeof p,"%s/%s",snap,current[i]);size_t a,b;char cr[8192],sr[8192];char *x=sourcefile(".",current[i],&a,cr),*y=sourcefile(snap,current[i],&b,sr);if(strcmp(cr,sr)||a!=b||memcmp(x,y,a))die("snapshot/current source mismatch");char h[65];sha(x,a,h);ADD("SOURCE\t%d\t%s\tbytes=%ld\tsha=%s\tresolved=%s\tsnapshot_current=IDENTICAL\n",i,current[i],(long)a,h,cr);free(x);free(y);}char manifest[65];sha(output+start,used-start,manifest);ADD("SOURCE_COMPLETE\troots=44\tordered_manifest_sha=%s\trev=%s\tsnapshot=%s\n",manifest,rev,snap);free(source);free(ss);
 char *args[]={"git","diff","--exit-code","3b41cc224f",(char *)rev,"--","src","cx","exec","seed","include",0};np_result r={0};char why[300];if(np_run(args,".",0,15,&r,why,sizeof why)||r.rc||r.residue||r.outn)die("historical product inputs diff");np_free(&r);ADD("PRODUCT_INPUT_DIFF\tfrom=3b41cc224f\tto=%s\tscope=src,cx,exec,seed,include\tstate=EMPTY\n",rev);if(final){for(int i=0;i<4;i++)target(i);ADD("X2_AUDIT_COMPLETE\ttargets=4\tall_receipts_under_ns=60000000000\tstate=VERIFIED_CURRENT_RUN\tC47_comparison=HISTORICAL_BYTE_IDENTITY_ONLY\n");}else ADD("X2_AUDIT_PREPARED\troots=44\ttarget_receipts=NOT_CHECKED\tstate=PREPARED\n");if(sy_write_all(1,output,used))die("stdout");return 0;}
