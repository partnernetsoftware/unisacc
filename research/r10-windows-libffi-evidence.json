      "log": "logs/arm-build.log",
      "reason": "same absent lib.exe; all 8 official COFF objects compiled successfully, GNU sysv.S route."
    },
    {
      "step": "zig ar rcs arm-prefix/lib/libffi.a official COFF objects",
      "rc": 0
    },
    {
      "step": "ARM actual ffi_call + closure probe first compile/link",
      "rc": 1,
      "log": "logs/arm-probe.log",
      "reason": "undefined __clear_cache from compiler builtin in ffi.c GNU branch"
    },
    {
      "step": "private Windows FlushInstructionCache adapter compile",
      "rc": 0,
      "log": "logs/arm-cache.log"
    },
    {
      "step": "ARM archive with adapter; actual call/closure probe link",
      "rc": 0,
      "log": "logs/arm-probe-adapted.log"
    },
    {
      "step": "both probe -c COFF compilation",
      "rc": 0
    }
  ],
