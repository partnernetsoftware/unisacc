diff --git b/tools/check-s5-measure.cx b/tools/check-s5-measure.cx
new file mode 100644
index 0000000..b5eee11
--- /dev/null
+++ b/tools/check-s5-measure.cx
@@ -0,0 +1,269 @@
+/* tools/check-s5-measure.cx -- S5 三波冷态测量工具 tools/s5-measure.cx 的自足夹具检查(不跑真库批次).
+ *
+ * 在临时假仓(FAKE_ROOT)与合成登记表/耗时表下验证:
+ *   1. --dry 三波(A/B/C/all)与 --part K/N 分片精确选批(跳过已测批/非 commit/非 IMPLEMENTED);
+ *   2. 越界拒绝: --wave B -j 2、--deadline 61、--out-table 等于共享 --times 表、--part 越界均 rc 2 具名拒绝;
+ *   3. 隔离测量环境: 子进程固定 UNISACC_RUN_CACHE=0 UNISACC_UNIT_CACHE=0 与隔离 UNISACC_BATCH_TIMES(保留 E3CACHE),共享表零改动;
+ *   4. <=60s 总 deadline 与残留进程组 TERM->等待->KILL->核实 清理: 覆盖顺从 SIGTERM 与无视 SIGTERM 的孙进程树(residue=0);
+ *   5. --verify-append 门控: 坏表/零行拒写(共享表逐字节不变), 经 batch-timing 核验通过后才带注释头追加共享表.
+ *   sh ./unisacc.com tools/check-s5-measure.cx [-- ROOT OUT] */
+#pragma unisa use cxlib.toolprep
+#pragma unisa use sys.fs
+#pragma unisa use sys.env
+#pragma unisa use sys.io
+#pragma unisa use sys.proc
+#pragma unisa use sys.time
+#pragma unisa use text.text
+#pragma unisa use mem.heap
+#pragma unisa use mem.bytes
+
+static int failed, checks;
+static char root[4096], work[4400], bin[4400], froot[4400], tdir[4400], shared[4400];
+static char *last;
+static size_t lastn;
+
+static void ck(int ok, const char *name) {
+    checks++;
+    if (!ok) {
+        failed++;
+        if (last && lastn) sy_eprintf("%.*s\n", (int)(lastn > 1200 ? 1200 : lastn), last);
+    }
+    sy_printf("%s\ts5-measure.%s\n", ok ? "PASS" : "FAIL", name);
+}
+
+static int has_in_ok(const char *s, size_t n, const char *needle) {
+    long nl = tx_len(needle, 512);
+    long i;
+    if (!s || nl <= 0) return 0;
+    for (i = 0; i + nl <= (long)n; i++) if (mm_same(s + i, needle, nl)) return 1;
+    return 0;
+}
+static int has(const char *needle) { return has_in_ok(last, lastn, needle); }
+
+static int put(const char *p, const char *s) {
+    return cx_write(p, s, (size_t)tx_len(s, TX_ZCAP));
+}
+
+static int run_s5(char **extra, int n_extra, int bound_s) {
+    char *av[24];
+    int k = 0, i;
+    mm_free(last); last = 0; lastn = 0;
+    av[k++] = bin;
+    av[k++] = "--root"; av[k++] = froot;
+    for (i = 0; i < n_extra && k + 1 < 24; i++) av[k++] = extra[i];
+    av[k] = 0;
+    return cx_runv_timeout(av, bound_s, &last, &lastn);
+}
+
+int main(int argc, char **argv) {
+    char src[4400], dot[4400], ft[4400], bp[4400], fprod[4400], frun[4400], faff[4400], fbt[4400];
+    char iso1[4400], iso_bad[4400], iso_term[4400], iso_kill[4400], why[256];
+    int rc;
+
+    if (sy_realpath(argc >= 2 && argv[1][0] ? argv[1] : ".", root, sizeof root) < 0) return 2;
+    if (argc >= 3 && argv[2][0]) {
+        if (sy_mkdir_all(argv[2], 0755) != 0 && sy_exists(argv[2]) != 1) return 2;
+        if (cx_fmt(work, sizeof work, "%s/s5m-%d-%ld", argv[2], sy_pid(), sy_now_ms())) return 2;
+    } else {
+        if (cx_fmt(dot, sizeof dot, "%s", sy_tmpdir()) ||
+            cx_fmt(work, sizeof work, "%s/check-s5-measure-%d-%ld", dot, sy_pid(), sy_now_ms())) return 2;
+    }
+    if (sy_mkdir_all(work, 0700) != 0) return 2;
+
+    if (cx_fmt(src, sizeof src, "%s/tools/s5-measure.cx", root) ||
+        cx_fmt(bin, sizeof bin, "%s/s5-measure.native", work) ||
+        cx_fmt(froot, sizeof froot, "%s/fakeroot", work) ||
+        cx_fmt(ft, sizeof ft, "%s/fakeroot/tools", work) ||
+        cx_fmt(tdir, sizeof tdir, "%s/fakeroot/tests", work) ||
+        cx_fmt(bp, sizeof bp, "%s/batches.tsv", tdir) ||
+        cx_fmt(shared, sizeof shared, "%s/shared-batch-times.tsv", work) ||
+        cx_fmt(fprod, sizeof fprod, "%s/unisacc.com", froot) ||
+        cx_fmt(frun, sizeof frun, "%s/tests/run-batch.cx", froot) ||
+        cx_fmt(faff, sizeof faff, "%s/tools/affected.cx", froot) ||
+        cx_fmt(fbt, sizeof fbt, "%s/tools/batch-timing.cx", froot) ||
+        cx_fmt(iso1, sizeof iso1, "%s/iso-live.tsv", work) ||
+        cx_fmt(iso_bad, sizeof iso_bad, "%s/iso-bad.tsv", work) ||
+        cx_fmt(iso_term, sizeof iso_term, "%s/iso-term.tsv", work) ||
+        cx_fmt(iso_kill, sizeof iso_kill, "%s/iso-kill.tsv", work)) return 2;
+
+    if (sy_mkdir_all(ft, 0755) != 0 || sy_mkdir_all(tdir, 0755) != 0) return 2;
+    if (sy_setenv("UNISACC_TABLES", tdir, 1) || sy_unsetenv("UNISACC_E3CACHE")) return 2;
+
+    if (tq_native(root, src, bin, why, sizeof why)) {
+        sy_printf("FAIL\ts5-measure.build-native\t%s\n", why);
+        return 1;
+    }
+    ck(sy_is_reg(bin) == 1, "build-native");
+
+    /* 假仓 batches.tsv:
+       a1(A), a2(C) 共用 entry-a; b1(A); m1(B), m2(B); done1(已测跳过); d1(daily 跳过); p1(PLANNED 跳过); c3(C 仅当加长分片用 -> c1(A),c2(C)!) */
+    if (put(bp,
+        "id\timplementation\tlayer\tsource\tmode\tplatform\tbudget_seconds\tmaterials\tentry\targs\tcoverage\texpect\theaders\ttier\n"
+        "done1\tIMPLEMENTED\tinterfaces\ttools/d.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/done.cx\t-\ti.done1\trc0:D\tproduct\tcommit\n"
+        "a1\tIMPLEMENTED\tinterfaces\ttools/a.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/ent-a.cx\t--1\ti.a1\trc0:A\tproduct\tcommit\n"
+        "a2\tIMPLEMENTED\tinterfaces\ttools/a.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/ent-a.cx\t--2\ti.a2\trc0:A\tproduct\tcommit\n"
+        "b1\tIMPLEMENTED\tinterfaces\ttools/b.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/ent-b.cx\t-\ti.b1\trc0:B\tproduct\tcommit\n"
+        "c1\tIMPLEMENTED\tinterfaces\ttools/c.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/ent-a.cx\t--3\ti.c1\trc0:C\tproduct\tcommit\n"
+        "m1\tIMPLEMENTED\tinterfaces\ttools/m.cx\tSOURCE\tlnx/x86_64\t55\tm-tool\ttools/m.cx\t{m-tool}\ti.m1\trc0:M\tproduct\tcommit\n"
+        "m2\tIMPLEMENTED\tinterfaces\ttools/m.cx\tSOURCE\tlnx/x86_64\t55\tm-tool\ttools/m.cx\t{m-tool}\ti.m2\trc0:M\tproduct\tcommit\n"
+        "d1\tIMPLEMENTED\tinterfaces\ttools/daily.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/daily.cx\t-\ti.d1\trc0:X\tproduct\tdaily\n"
+        "p1\tPLANNED\tinterfaces\ttools/plan.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/plan.cx\t-\ti.p1\tNOT_READY\tproduct\tcommit\n")) return 2;
+
+    if (put(shared, "# initial\n100\tdone1\tPASS\t1200\t1000\thot\t0.1\trun-batch\n")) return 2;
+
+    /* 假 unisacc.com 分发到 stub .cx 文本脚本 */
+    if (put(fprod, "#!/bin/sh\nscript=\"$1\"\nshift\n[ \"$1\" = \"--\" ] && shift\nexec sh \"$script\" \"$@\"\n")) return 2;
+    if (sy_chmod(fprod, 0755)) return 2;
+
+    /* 假 run-batch.cx: 验证冷环境并支持 --mode 行为 (normal / term-tree / ignore-term) */
+    if (put(frun,
+        "#!/bin/sh\n"
+        "r=\"$1\"; p=\"$2\"; id=\"$3\"\n"
+        "if [ \"$UNISACC_RUN_CACHE\" != \"0\" ] || [ \"$UNISACC_UNIT_CACHE\" != \"0\" ]; then echo \"BAD_CACHE\"; exit 3; fi\n"
+        "if [ \"${UNISACC_E3CACHE:-unset}\" = \"0\" ]; then echo \"BAD_E3\"; exit 4; fi\n"
+        "if [ -z \"$UNISACC_BATCH_TIMES\" ]; then echo \"NO_BT\"; exit 5; fi\n"
+        "case \"$p\" in */unisacc-affected-s5-*) ;; *) echo \"BAD_PARENT=$p\"; exit 6;; esac\n"
+        "case \"$S5_STUB_MODE\" in\n"
+        "  term-tree)\n"
+        "    sleep 20 &\n"
+        "    wait\n"
+        "    exit 0\n"
+        "    ;;\n"
+        "  ignore-term)\n"
+        "    trap '' TERM\n"
+        "    (trap '' TERM; exec sleep 20) &\n"
+        "    while true; do sleep 1; done\n"
+        "    ;;\n"
+        "  *)\n"
+        "    printf '200\\t%s\\tPASS\\t4500\\t4100\\thot\\t0.2\\trun-batch\\n' \"$id\" >> \"$UNISACC_BATCH_TIMES\"\n"
+        "    printf 'BATCH_RUN\\tid=%s\\tstatus=PASS\\n' \"$id\"\n"
+        "    ;;\n"
+        "esac\n")) return 2;
+    if (sy_chmod(frun, 0755)) return 2;
+
+    if (put(faff,
+        "#!/bin/sh\n"
+        "echo 'MATERIAL\tm1\tm-tool\t/tmp/fake-mat-m-tool'\n"
+        "echo 'MATERIAL\tm2\tm-tool\t/tmp/fake-mat-m-tool'\n")) return 2;
+    if (sy_chmod(faff, 0755)) return 2;
+
+    if (put(fbt,
+        "#!/bin/sh\n"
+        "tab=\"\"\n"
+        "while [ $# -gt 0 ]; do if [ \"$1\" = \"--table\" ]; then tab=\"$2\"; shift 2; else shift; fi; done\n"
+        "n=$(grep -cvE '^(#|$)' \"$tab\" || true)\n"
+        "printf 'BT_SUMMARY\\trows=%s\\tids=%s\\tnear=0\\tover_budget=0\\n' \"$n\" \"$n\"\n")) return 2;
+    if (sy_chmod(fbt, 0755)) return 2;
+
+    /* 1. --dry 波次与分片校验 */
+    {
+        char *a[] = {"--wave", "A", "--times", shared, "--dry"};
+        rc = run_s5(a, 5, 15);
+        ck(rc == 0 && has("total_unmeasured=6\twave_count=2\tselected=2\t") &&
+           has("id=a1\twave=A\t") && has("id=b1\twave=A\t") &&
+           !has("id=done1\t") && !has("id=a2\t") && !has("id=m1\t") && !has("id=d1\t") && !has("id=p1\t") &&
+           has("dry=1"), "dry-wave-a");
+    }
+    {
+        char *a[] = {"--wave", "B", "--times", shared, "--dry"};
+        rc = run_s5(a, 5, 15);
+        ck(rc == 0 && has("selected=2\tjobs=1\t") && has("S5_PREPARE\t") && has("id=m1\twave=B\t") && has("id=m2\twave=B\t"),
+           "dry-wave-b-serial");
+    }
+    {
+        char *a1[] = {"--wave", "C", "--part", "1/2", "--times", shared, "--dry"};
+        rc = run_s5(a1, 7, 15);
+        ck(rc == 0 && has("part=1/2\t") && has("selected=1\t") && has("id=a2\twave=C\t") && !has("id=c1\t"),
+           "dry-wave-c-part-1");
+    }
+    {
+        char *a2[] = {"--wave", "C", "--part", "2/2", "--times", shared, "--dry"};
+        rc = run_s5(a2, 7, 15);
+        ck(rc == 0 && has("part=2/2\t") && has("selected=1\t") && has("id=c1\twave=C\t") && !has("id=a2\t"),
+           "dry-wave-c-part-2");
+    }
+
+    /* 2. 越界拒绝 */
+    {
+        char *a[] = {"--wave", "B", "-j", "2", "--times", shared, "--dry"};
+        rc = run_s5(a, 7, 15);
+        ck(rc == 2 && has("S5_REFUSE\twave-b-serial-only\t"), "refuse-wave-b-j2");
+    }
+    {
+        char *a[] = {"--wave", "A", "--deadline", "61", "--times", shared, "--dry"};
+        rc = run_s5(a, 7, 15);
+        ck(rc == 2 && has("S5_REFUSE\tinvalid-deadline\t"), "refuse-deadline-over-60");
+    }
+    {
+        char *a[] = {"--wave", "A", "--times", shared, "--out-table", shared, "--dry"};
+        rc = run_s5(a, 7, 15);
+        ck(rc == 2 && has("S5_REFUSE\tout-table-equals-shared\t"), "refuse-shared-out-table");
+    }
+    {
+        char *a[] = {"--wave", "C", "--part", "3/2", "--times", shared, "--dry"};
+        rc = run_s5(a, 7, 15);
+        ck(rc == 2 && has("S5_REFUSE\tinvalid-part\t"), "refuse-bad-part");
+    }
+
+    /* 3. 隔离测量写隔离表而不碰共享表 */
+    {
+        size_t sn0 = 0, sn1 = 0, in0 = 0; char *sb0, *sb1, *ib0;
+        char *a[] = {"--wave", "A", "-j", "2", "--times", shared, "--out-table", iso1, "--deadline", "10"};
+        sb0 = cx_read(shared, &sn0);
+        rc = run_s5(a, 10, 15);
+        sb1 = cx_read(shared, &sn1);
+        ib0 = cx_read(iso1, &in0);
+        ck(rc == 0 && has("S5_SUMMARY\twave=A\tselected=2\tlaunched=2\tpassed=2\tfailed=0\ttimed_out=0\tresidue=0") &&
+           sb0 && sb1 && sn0 == sn1 && mm_same(sb0, sb1, sn0) &&
+           ib0 && has_in_ok(ib0, in0, "\ta1\tPASS\t4500\t4100\t") && has_in_ok(ib0, in0, "\tb1\tPASS\t4500\t4100\t"),
+           "live-isolated-table-and-env");
+        mm_free(sb0); mm_free(sb1); mm_free(ib0);
+    }
+
+    /* 4. PGID 清理: TERM->等待->KILL->核实 */
+    if (sy_setenv("S5_STUB_MODE", "term-tree", 1)) return 2;
+    {
+        long t0 = sy_now_ms(), dt;
+        char *a[] = {"--wave", "A", "-j", "1", "--limit", "1", "--times", shared, "--out-table", iso_term, "--deadline", "4"};
+        rc = run_s5(a, 12, 15);
+        dt = sy_now_ms() - t0;
+        ck(rc == 1 && dt <= 5500 && has("S5_PGID_CLEANUP\tid=a1\t") && has("\tterm=1\tkill=0\tresidue=0\t") &&
+           has("S5_DONE\tid=a1\tstatus=TIMEOUT\t"), "deadline-pgid-term-wait-verify");
+    }
+    if (sy_setenv("S5_STUB_MODE", "ignore-term", 1)) return 2;
+    {
+        long t0 = sy_now_ms(), dt;
+        char *a[] = {"--wave", "A", "-j", "1", "--limit", "1", "--times", shared, "--out-table", iso_kill, "--deadline", "4"};
+        rc = run_s5(a, 12, 15);
+        dt = sy_now_ms() - t0;
+        ck(rc == 1 && dt <= 5500 && has("S5_PGID_CLEANUP\tid=a1\t") && has("\tterm=1\tkill=1\tresidue=0\t") &&
+           has("S5_DONE\tid=a1\tstatus=TIMEOUT\t"), "deadline-pgid-escalate-kill-verify");
+    }
+    (void)sy_unsetenv("S5_STUB_MODE");
+
+    /* 5. --verify-append 坏表拒写与核验后追加 */
+    if (put(iso_bad, "1\ta1\tPASS\tnotnum\t10\thot\t0.1\trun-batch\n")) return 2;
+    {
+        size_t sn0 = 0, sn1 = 0; char *sb0, *sb1;
+        char *a[] = {"--verify-append", shared, "--from", iso_bad, "--rev", "abc123"};
+        sb0 = cx_read(shared, &sn0);
+        rc = run_s5(a, 6, 15);
+        sb1 = cx_read(shared, &sn1);
+        ck(rc == 2 && has("S5_REFUSE\tverify-bad-row\t") && sb0 && sb1 && sn0 == sn1 && mm_same(sb0, sb1, sn0),
+           "verify-append-refuses-bad-row");
+        mm_free(sb0); mm_free(sb1);
+    }
+    {
+        size_t sn1 = 0; char *sb1;
+        char *a[] = {"--verify-append", shared, "--from", iso1, "--rev", "deadbeef01"};
+        rc = run_s5(a, 6, 15);
+        sb1 = cx_read(shared, &sn1);
+        ck(rc == 0 && has("S5_APPEND\t") && has("rows=2\trev=deadbeef01") &&
+           sb1 && has_in_ok(sb1, sn1, "# S5-cold rev=deadbeef01 UNISACC_RUN_CACHE=0") &&
+           has_in_ok(sb1, sn1, "\tb1\tPASS\t4500\t4100\t"), "verify-append-writes-shared-after-verify");
+        mm_free(sb1);
+    }
+
+    sy_printf("CHECK_S5_MEASURE\tchecks=%d\tfailed=%d\n", checks, failed);
+    return failed ? 1 : 0;
+}
diff --git b/tools/s5-measure.cx b/tools/s5-measure.cx
new file mode 100644
index 0000000..367bc6a
--- /dev/null
+++ b/tools/s5-measure.cx
@@ -0,0 +1,720 @@
+/* tools/s5-measure.cx -- S5 零记录 commit 批三波低成本冷态测量与核验回写工具(只记观测,不判通过).
+ *
+ *   sh ./unisacc.com tools/s5-measure.cx -- [--root DIR] --wave A|B|C|all [--part K/N] [-j 1|2]
+ *       [--deadline S] [--out-table PATH] [--times PATH] [--limit M] [--dry]
+ *   sh ./unisacc.com tools/s5-measure.cx -- [--root DIR] --verify-append SHARED_TABLE --from ISOLATED_TABLE [--rev REV]
+ *
+ * 三波规则(针对 tier=commit 且在共享 --times 表零记录的 IMPLEMENTED 批):
+ *   A: materials=- 的唯一 entry 代表批(每个 entry 取登记表首批); 默认 -j 2.
+ *   B: materials!=- 批; 先调 affected --materials-dump --prepare-materials 绑定材料,强制 -j 1(-j 2 拒绝 rc 2).
+ *   C: 其余 materials=- 批; 默认 -j 2,可配 --part K/N (1<=K<=N) 分片推进.
+ *   all: 含 A+B+C 三波选批(主要用于 --dry 全局盘点; 实跑须显式分波 A/B/C 以遵守隔离并发).
+ *
+ * 隔离与清组契约:
+ *   - 单批总 deadline(--deadline S) 限制 1..60 秒(默认 60),超限即 TERM->等待->KILL->核实 清理整个进程组(pgid).
+ *   - 测量子进程固定传 UNISACC_RUN_CACHE=0 UNISACC_UNIT_CACHE=0 (保留默认 E3CACHE),并将
+ *     UNISACC_BATCH_TIMES 指向隔离 --out-table (禁止指向共享 --times 或 $HOME/.cache/unisacc/batch-times.tsv).
+ *   - 测量阶段绝不写共享 batch-times 表;须经 --verify-append 先逐行校验并跑 tools/batch-timing.cx report 核验通过后,
+ *     才带 # S5-cold 注释头追加到共享表.
+ *
+ * Check: tools/check-s5-measure.cx (批次 s5-measure). */
+#pragma unisa use sys.fs
+#pragma unisa use sys.env
+#pragma unisa use sys.proc
+#pragma unisa use sys.posix
+#pragma unisa use sys.poll
+#pragma unisa use sys.time
+#pragma unisa use sys.io
+#pragma unisa use text.text
+#pragma unisa use mem.heap
+#pragma unisa use mem.bytes
+
+#define S5_MAX_BATCH 4096
+#define S5_MAX_ENV 512
+#define S5_MAX_SLOTS 2
+#define S5_DEADLINE_MAX 60
+#define S5_MAT_MAX 8
+
+typedef struct {
+    char id[128], mat[256], entry[512];
+    char wave;
+    int budget;
+    int sel;
+    char mat_args[S5_MAT_MAX][600];
+    int nmat_args;
+} S5Job;
+
+typedef struct {
+    int active, ji, pid, pgid, out_fd;
+    long start_ms, term_at_ms, hard_ms, wait_until_ms, kill_at_ms;
+    int phase; /* 0=run, 1=wait-term, 2=wait-kill */
+    int term_sent, kill_sent, timed_out, reaped, rc, exited, sig, residue;
+    char *buf;
+    long bufn, bufcap;
+} S5Slot;
+
+typedef struct { char s[128]; } S5Id;
+typedef struct { char s[512]; } S5Entry;
+
+static char g_root[4096], g_shared[4400], g_out_table[4400], g_rev[128] = "HEAD";
+static S5Id *g_seen;
+static int g_nseen;
+static S5Entry *g_entries;
+static int g_nentries;
+static S5Job *g_jobs;
+static int g_njobs;
+
+static int die2(const char *code, const char *detail) {
+    sy_printf("S5_REFUSE\t%s\t%s\n", code, detail ? detail : "-");
+    sy_eprintf("s5-measure: REFUSE %s (%s)\n", code, detail ? detail : "-");
+    return 2;
+}
+
+static long parse_pos(const char *s, long maxv) {
+    long v = 0, i = 0, n = tx_len(s, 32);
+    if (n <= 0) return -1;
+    for (; i < n; i++) {
+        if (s[i] < '0' || s[i] > '9') return -1;
+        v = v * 10 + (s[i] - '0');
+        if (v > maxv) return -1;
+    }
+    return v;
+}
+
+static int parse_part(const char *s, int *pk, int *pn) {
+    long n = tx_len(s, 32), sl = tx_chr(s, n, '/');
+    char a[16], b[16];
+    long k, tot;
+    if (sl <= 0 || sl + 1 >= n || sl >= (long)sizeof a || n - sl - 1 >= (long)sizeof b) return -1;
+    if (mm_copy(a, sizeof a, s, sl) || mm_copy(b, sizeof b, s + sl + 1, n - sl - 1)) return -1;
+    a[sl] = 0; b[n - sl - 1] = 0;
+    k = parse_pos(a, 10000); tot = parse_pos(b, 10000);
+    if (k < 1 || tot < 1 || k > tot) return -1;
+    *pk = (int)k; *pn = (int)tot;
+    return 0;
+}
+
+static void default_shared_times(char *out, size_t cap) {
+    const char *e = sy_env("UNISACC_BATCH_TIMES"), *h = sy_env("HOME");
+    if (e && e[0] && !tx_eqz(e, "off")) { if (cx_fmt(out, cap, "%s", e)) out[0] = 0; return; }
+    if (cx_fmt(out, cap, "%s/.cache/unisacc/batch-times.tsv", h && h[0] ? h : "/tmp")) out[0] = 0;
+}
+
+static int same_target_path(const char *a, const char *b) {
+    char ra[4096], rb[4096];
+    if (!a || !a[0] || !b || !b[0]) return 0;
+    if (tx_eqz(a, b)) return 1;
+    if (sy_realpath(a, ra, sizeof ra) == 0 && sy_realpath(b, rb, sizeof rb) == 0 && tx_eqz(ra, rb)) return 1;
+    return 0;
+}
+
+static int id_seen(const char *id, long n) {
+    int i;
+    for (i = 0; i < g_nseen; i++) if (tx_len(g_seen[i].s, 128) == n && mm_same(g_seen[i].s, id, n)) return 1;
+    return 0;
+}
+
+static void add_seen(const char *id, long n) {
+    if (n <= 0 || n >= 128 || g_nseen >= S5_MAX_BATCH || id_seen(id, n)) return;
+    if (mm_copy(g_seen[g_nseen].s, 128, id, n)) return;
+    g_seen[g_nseen].s[n] = 0;
+    g_nseen++;
+}
+
+static int entry_seen(const char *ent, long n) {
+    int i;
+    for (i = 0; i < g_nentries; i++) if (tx_len(g_entries[i].s, 512) == n && mm_same(g_entries[i].s, ent, n)) return 1;
+    return 0;
+}
+
+static void add_entry(const char *ent, long n) {
+    if (n <= 0 || n >= 512 || g_nentries >= S5_MAX_BATCH || entry_seen(ent, n)) return;
+    if (mm_copy(g_entries[g_nentries].s, 512, ent, n)) return;
+    g_entries[g_nentries].s[n] = 0;
+    g_nentries++;
+}
+
+static int valid_status_tok(const char *s, long n) {
+    if (n == 4 && mm_same(s, "PASS", 4)) return 1;
+    if (n == 4 && mm_same(s, "FAIL", 4)) return 1;
+    if (n == 6 && mm_same(s, "KILLED", 6)) return 1;
+    if (n == 7 && mm_same(s, "UNKNOWN", 7)) return 1;
+    return 0;
+}
+
+/* 解析并验证 batch-times 行; 返回 1 有效行, 0 跳过注释/空行, -1 格式错误 */
+static int check_time_row(const char *line, long L, char *id_out, long id_cap, long *idn_out) {
+    long f1o, f1n, f2o, f2n, f3o, f3n, f4o, f4n, i;
+    if (L <= 0 || line[0] == '#') return 0;
+    if (tx_fields(line, L, '\t') < 7) return -1;
+    if (tx_field(line, L, '\t', 1, &f1o, &f1n) || f1n <= 0 || f1n >= 128 || (id_out && f1n >= id_cap)) return -1;
+    if (tx_field(line, L, '\t', 2, &f2o, &f2n) || !valid_status_tok(line + f2o, f2n)) return -1;
+    if (tx_field(line, L, '\t', 3, &f3o, &f3n) || f3n <= 0) return -1;
+    for (i = 0; i < f3n; i++) if (line[f3o + i] < '0' || line[f3o + i] > '9') return -1;
+    if (tx_field(line, L, '\t', 4, &f4o, &f4n) || f4n <= 0) return -1;
+    for (i = 0; i < f4n; i++) if (line[f4o + i] < '0' || line[f4o + i] > '9') return -1;
+    if (id_out && id_cap > 0) {
+        if (mm_copy(id_out, id_cap, line + f1o, f1n)) return -1;
+        id_out[f1n] = 0;
+        if (idn_out) *idn_out = f1n;
+    }
+    return 1;
+}
+
+static int load_seen_times(const char *times_path) {
+    size_t n = 0; char *s; long at = 0;
+    if (!times_path || !times_path[0] || sy_exists(times_path) != 1) return 0;
+    s = cx_read(times_path, &n);
+    if (!s) return -1;
+    while (at < (long)n) {
+        long e = at; char idb[128]; long idn = 0;
+        while (e < (long)n && s[e] != '\n') e++;
+        if (check_time_row(s + at, e - at, idb, sizeof idb, &idn) == 1) add_seen(idb, idn);
+        at = e + 1;
+    }
+    mm_free(s);
+    return 0;
+}
+
+static int load_s5_jobs(const char *root) {
+    const char *td = sy_env("UNISACC_TABLES"); char p[4400]; size_t n = 0; char *s; long at = 0;
+    if (td && td[0]) {
+        if (td[0] == '/') { if (cx_fmt(p, sizeof p, "%s/batches.tsv", td)) return -1; }
+        else if (cx_fmt(p, sizeof p, "%s/%s/batches.tsv", root, td)) return -1;
+    } else if (cx_fmt(p, sizeof p, "%s/tests/batches.tsv", root)) return -1;
+    if (sy_exists(p) != 1) return -1;
+    s = cx_read(p, &n);
+    if (!s) return -1;
+    while (at < (long)n) {
+        long e = at, L;
+        long o0, n0, o1, n1, o6, n6, o7, n7, o8, n8, o13, n13;
+        while (e < (long)n && s[e] != '\n') e++;
+        L = e - at;
+        if (L > 0 && s[at] != '#' && tx_fields(s + at, L, '\t') == 14 &&
+            !tx_field(s + at, L, '\t', 0, &o0, &n0) && !tx_field(s + at, L, '\t', 1, &o1, &n1) &&
+            !tx_field(s + at, L, '\t', 6, &o6, &n6) && !tx_field(s + at, L, '\t', 7, &o7, &n7) &&
+            !tx_field(s + at, L, '\t', 8, &o8, &n8) && !tx_field(s + at, L, '\t', 13, &o13, &n13)) {
+            const char *l = s + at;
+            if (n1 == 11 && mm_same(l + o1, "IMPLEMENTED", 11) && n13 == 6 && mm_same(l + o13, "commit", 6) &&
+                !id_seen(l + o0, n0) && g_njobs < S5_MAX_BATCH) {
+                S5Job *j = &g_jobs[g_njobs];
+                char bbuf[16];
+                if (n0 < (long)sizeof j->id && n7 < (long)sizeof j->mat && n8 < (long)sizeof j->entry && n6 < (long)sizeof bbuf) {
+                    mm_fill(j, sizeof *j, 0, sizeof *j);
+                    mm_copy(j->id, sizeof j->id, l + o0, n0); j->id[n0] = 0;
+                    mm_copy(j->mat, sizeof j->mat, l + o7, n7); j->mat[n7] = 0;
+                    mm_copy(j->entry, sizeof j->entry, l + o8, n8); j->entry[n8] = 0;
+                    mm_copy(bbuf, sizeof bbuf, l + o6, n6); bbuf[n6] = 0;
+                    j->budget = (int)parse_pos(bbuf, 600);
+                    if (j->budget <= 0) j->budget = 55;
+                    if (!(n7 == 1 && l[o7] == '-')) j->wave = 'B';
+                    else if (!entry_seen(l + o8, n8)) { add_entry(l + o8, n8); j->wave = 'A'; }
+                    else j->wave = 'C';
+                    g_njobs++;
+                }
+            }
+        }
+        at = e + 1;
+    }
+    mm_free(s);
+    return 0;
+}
+
+/* 构造隔离子环境: 固定 UNISACC_RUN_CACHE=0 UNISACC_UNIT_CACHE=0 UNISACC_BATCH_TIMES=OUT_TABLE; 保留 E3CACHE */
+static int build_cold_env(const char *out_table, char **envv, int cap, char store[3][4600]) {
+    char **cur = sy_env_vec();
+    int k = 0, i;
+    if (cx_fmt(store[0], 4600, "UNISACC_RUN_CACHE=0") ||
+        cx_fmt(store[1], 4600, "UNISACC_UNIT_CACHE=0") ||
+        cx_fmt(store[2], 4600, "UNISACC_BATCH_TIMES=%s", out_table)) return -1;
+    if (cur) {
+        for (i = 0; cur[i] && k + 4 < cap; i++) {
+            const char *e = cur[i];
+            long en = tx_len(e, 4600);
+            if (tx_prefix(e, en, "UNISACC_RUN_CACHE=", 18) ||
+                tx_prefix(e, en, "UNISACC_UNIT_CACHE=", 19) ||
+                tx_prefix(e, en, "UNISACC_BATCH_TIMES=", 20)) continue;
+            envv[k++] = cur[i];
+        }
+    }
+    envv[k++] = store[0];
+    envv[k++] = store[1];
+    envv[k++] = store[2];
+    envv[k] = 0;
+    return 0;
+}
+
+static void drain_slot(S5Slot *s) {
+    char tmp[4096];
+    long r;
+    if (s->out_fd < 0) return;
+    for (;;) {
+        sy_pollfd_t p;
+        p.fd = s->out_fd; p.events = SY_POLLIN; p.revents = 0;
+        if (sy_poll(&p, 1, 0) <= 0) break;
+        if (!(p.revents & (SY_POLLIN | SY_POLLERR | SY_POLLHUP | SY_POLLNVAL))) break;
+        r = sy_read(s->out_fd, tmp, sizeof tmp);
+        if (r > 0) {
+            if (s->buf && s->bufn + r + 1 <= s->bufcap) {
+                if (mm_copy(s->buf + s->bufn, s->bufcap - s->bufn, tmp, r) == 0) {
+                    s->bufn += r;
+                    s->buf[s->bufn] = 0;
+                }
+            }
+            continue;
+        }
+        (void)sy_close(s->out_fd);
+        s->out_fd = -1;
+        break;
+    }
+}
+
+static void init_slot_times(S5Slot *s, int deadline_s) {
+    long total = (long)deadline_s * 1000L;
+    long term_grace = deadline_s >= 4 ? 1500L : (total * 3L) / 10L;
+    long kill_grace = deadline_s >= 4 ? 500L : (total * 2L) / 10L;
+    if (term_grace < 200L) term_grace = 200L;
+    if (kill_grace < 150L) kill_grace = 150L;
+    if (term_grace + kill_grace >= total) {
+        term_grace = total / 3L;
+        kill_grace = total / 4L;
+    }
+    s->hard_ms = s->start_ms + total;
+    s->term_at_ms = s->hard_ms - term_grace - kill_grace;
+    s->wait_until_ms = s->hard_ms - kill_grace;
+    s->kill_at_ms = s->wait_until_ms;
+}
+
+/* 对单一槽执行 TERM -> 等待 -> KILL -> 核实; 返回 1 表示槽仍未结束, 0 表示槽已完成或到达 hard_ms */
+static int step_slot(S5Slot *s, const char *label, long now) {
+    sy_child_t ch;
+    sy_exit_t st;
+    int wr, grp_gone;
+    ch.pid = s->pid; ch.in_fd = -1; ch.out_fd = s->out_fd; ch.err_fd = -1; ch.deadline_at_ms = 0; ch.h = s->pgid;
+    drain_slot(s);
+    if (!s->reaped) {
+        wr = sy_proc_try_wait(&ch, &st);
+        if (wr == 1) {
+            s->reaped = 1;
+            s->exited = st.exited;
+            s->sig = st.sig;
+            s->rc = st.exited ? st.code : (128 + st.sig);
+        }
+    }
+    grp_gone = (sy_killpg(s->pgid, 0) == -ESRCH);
+    if (s->reaped && grp_gone && s->phase == 0) {
+        if (s->out_fd >= 0) { (void)sy_close(s->out_fd); s->out_fd = -1; }
+        s->active = 0;
+        return 0;
+    }
+    /* 即使主进程提前退出但同组孙进程残留,立即进入 TERM->等待->KILL->核实 */
+    if (s->phase == 0 && (now >= s->term_at_ms || (s->reaped && !grp_gone))) {
+        if (now >= s->term_at_ms) s->timed_out = 1;
+        s->phase = 1;
+        s->term_sent = 1;
+        s->wait_until_ms = now + (s->wait_until_ms - s->term_at_ms);
+        if (s->wait_until_ms > s->hard_ms - 300L) s->wait_until_ms = s->hard_ms - 300L;
+        (void)sy_killpg(s->pgid, 15);
+        (void)sy_signal(s->pid, 15);
+    } else if (s->phase == 1) {
+        if (s->reaped && grp_gone) {
+            s->residue = 0;
+            if (s->out_fd >= 0) { (void)sy_close(s->out_fd); s->out_fd = -1; }
+            sy_printf("S5_PGID_CLEANUP\tid=%s\tpgid=%d\tterm=%d\tkill=%d\tresidue=%d\telapsed_ms=%ld\n",
+                      label, s->pgid, s->term_sent, s->kill_sent, s->residue, now - s->start_ms);
+            s->active = 0;
+            return 0;
+        }
+        if (now >= s->wait_until_ms) {
+            s->phase = 2;
+            s->kill_sent = 1;
+            s->kill_at_ms = now;
+            (void)sy_killpg(s->pgid, 9);
+            (void)sy_signal(s->pid, 9);
+        }
+    } else if (s->phase == 2) {
+        if (s->reaped && grp_gone) {
+            s->residue = 0;
+            if (s->out_fd >= 0) { (void)sy_close(s->out_fd); s->out_fd = -1; }
+            sy_printf("S5_PGID_CLEANUP\tid=%s\tpgid=%d\tterm=%d\tkill=%d\tresidue=%d\telapsed_ms=%ld\n",
+                      label, s->pgid, s->term_sent, s->kill_sent, s->residue, now - s->start_ms);
+            s->active = 0;
+            return 0;
+        }
+        if (now >= s->hard_ms) {
+            int g2 = sy_killpg(s->pgid, 0);
+            int p2 = sy_signal(s->pid, 0);
+            s->residue = (s->reaped && g2 == -ESRCH && p2 == -ESRCH) ? 0 : 1;
+            if (s->out_fd >= 0) { (void)sy_close(s->out_fd); s->out_fd = -1; }
+            sy_printf("S5_PGID_CLEANUP\tid=%s\tpgid=%d\tterm=%d\tkill=%d\tresidue=%d\telapsed_ms=%ld\n",
+                      label, s->pgid, s->term_sent, s->kill_sent, s->residue, now - s->start_ms);
+            s->active = 0;
+            return 0;
+        }
+    }
+    return 1;
+}
+
+static int run_one_bounded(const char *label, char **argv, const char *cwd, char **envv, int deadline_s,
+                           char **out_p, long *out_n, int *timed_p, int *residue_p) {
+    sy_spawn_t sp;
+    sy_child_t ch;
+    S5Slot sl;
+    int r;
+    mm_fill(&sl, sizeof sl, 0, sizeof sl);
+    sl.bufcap = 131072;
+    sl.buf = mm_alloc(sl.bufcap);
+    if (!sl.buf) return -1;
+    sl.buf[0] = 0;
+    sy_spawn_init(&sp);
+    sp.argv = argv; sp.env = envv; sp.cwd = cwd;
+    sp.in_fd = SY_STDIO_NULL; sp.out_fd = SY_STDIO_PIPE;
+    sp.flags = SY_SPAWN_ERR_TO_OUT; sp.pgroup = -1;
+    r = sy_proc_spawn(&sp, &ch);
+    if (r < 0) { mm_free(sl.buf); return r; }
+    sl.active = 1; sl.pid = ch.pid; sl.pgid = ch.h > 0 ? ch.h : ch.pid; sl.out_fd = ch.out_fd;
+    sl.start_ms = sy_now_ms();
+    init_slot_times(&sl, deadline_s);
+    while (sl.active) {
+        sy_pollfd_t pfd;
+        if (sl.out_fd >= 0) {
+            pfd.fd = sl.out_fd; pfd.events = SY_POLLIN; pfd.revents = 0;
+            (void)sy_poll(&pfd, 1, 20);
+        } else {
+            sy_sleep_ms(20);
+        }
+        (void)step_slot(&sl, label, sy_now_ms());
+    }
+    if (out_p) *out_p = sl.buf; else mm_free(sl.buf);
+    if (out_n) *out_n = sl.bufn;
+    if (timed_p) *timed_p = sl.timed_out;
+    if (residue_p) *residue_p = sl.residue;
+    return sl.timed_out ? 124 : sl.rc;
+}
+
+static int prepare_wave_b(const char *root, int *sel_idx, int nsel, int deadline_s) {
+    char *ids = mm_alloc(65536), *out = 0;
+    char prod[4400], aff[4400];
+    long off = 0, outn = 0, at = 0;
+    int i, timed = 0, res = 0, rc;
+    if (!ids) return -1;
+    ids[0] = 0;
+    for (i = 0; i < nsel; i++) {
+        S5Job *j = &g_jobs[sel_idx[i]];
+        long ln = tx_len(j->id, 128);
+        if (off + ln + 2 >= 65536) { mm_free(ids); return -1; }
+        if (off) ids[off++] = ',';
+        mm_copy(ids + off, 65536 - off, j->id, ln);
+        off += ln; ids[off] = 0;
+    }
+    if (!off) { mm_free(ids); return 0; }
+    if (cx_fmt(prod, sizeof prod, "%s/unisacc.com", root) ||
+        cx_fmt(aff, sizeof aff, "%s/tools/affected.cx", root)) { mm_free(ids); return -1; }
+    {
+        char *av[] = {"sh", prod, aff, "--", "--materials-dump", "--ids", ids, "--prepare-materials", 0};
+        rc = run_one_bounded("wave-b-prep", av, root, 0, deadline_s, &out, &outn, &timed, &res);
+    }
+    mm_free(ids);
+    if (rc != 0 || timed || res) {
+        if (out && outn) sy_eprintf("%.*s", (int)(outn > 1000 ? 1000 : outn), out);
+        mm_free(out);
+        return -1;
+    }
+    while (at < outn) {
+        long e = at, L, o1, n1, o2, n2, o3, n3;
+        while (e < outn && out[e] != '\n') e++;
+        L = e - at;
+        if (L > 9 && tx_prefix(out + at, L, "MATERIAL\t", 9) &&
+            !tx_field(out + at, L, '\t', 1, &o1, &n1) &&
+            !tx_field(out + at, L, '\t', 2, &o2, &n2) &&
+            !tx_field(out + at, L, '\t', 3, &o3, &n3)) {
+            if (tx_find(out + at, L, "\tREFUSED=", 9) >= 0 || (n3 == 1 && out[at + o3] == '-')) {
+                sy_eprintf("s5-measure: REFUSE material-prep %.*s\n", (int)L, out + at);
+                mm_free(out);
+                return -1;
+            }
+            for (i = 0; i < nsel; i++) {
+                S5Job *j = &g_jobs[sel_idx[i]];
+                if (tx_len(j->id, 128) == n1 && mm_same(j->id, out + at + o1, n1) && j->nmat_args < S5_MAT_MAX) {
+                    if (cx_fmt(j->mat_args[j->nmat_args], 600, "%.*s=%.*s", (int)n2, out + at + o2, (int)n3, out + at + o3) == 0)
+                        j->nmat_args++;
+                }
+            }
+        }
+        at = e + 1;
+    }
+    mm_free(out);
+    return 0;
+}
+
+static int verify_and_append(const char *root, const char *shared, const char *isolated, const char *rev) {
+    size_t n = 0;
+    char *s, *out = 0, *copybuf;
+    long at = 0, outn = 0, valid = 0, copyn = 0;
+    char prod[4400], bt[4400], hdr[256], sum_want[64];
+    int rc, timed = 0, res = 0;
+    if (!shared[0] || !isolated[0]) return die2("verify-append-args", "need shared and --from");
+    if (same_target_path(shared, isolated)) return die2("verify-append-same-file", isolated);
+    if (sy_exists(isolated) != 1) return die2("isolated-table-missing", isolated);
+    s = cx_read(isolated, &n);
+    if (!s || !n) { mm_free(s); return die2("isolated-table-empty", isolated); }
+    copybuf = mm_alloc(n + 512);
+    if (!copybuf) { mm_free(s); return die2("oom", 0); }
+    while (at < (long)n) {
+        long e = at, L;
+        int chk;
+        while (e < (long)n && s[e] != '\n') e++;
+        L = e - at;
+        chk = check_time_row(s + at, L, 0, 0, 0);
+        if (chk < 0) {
+            mm_free(s); mm_free(copybuf);
+            return die2("verify-bad-row", isolated);
+        }
+        if (chk == 1) {
+            valid++;
+            mm_copy(copybuf + copyn, n + 512 - copyn, s + at, L);
+            copyn += L;
+            copybuf[copyn++] = '\n';
+        }
+        at = e + 1;
+    }
+    mm_free(s);
+    if (valid <= 0) { mm_free(copybuf); return die2("verify-zero-rows", isolated); }
+    if (cx_fmt(prod, sizeof prod, "%s/unisacc.com", root) ||
+        cx_fmt(bt, sizeof bt, "%s/tools/batch-timing.cx", root)) { mm_free(copybuf); return die2("path-bound", 0); }
+    {
+        char *av[] = {"sh", prod, bt, "--", "report", "--table", (char *)isolated, 0};
+        rc = run_one_bounded("verify-report", av, root, 0, 30, &out, &outn, &timed, &res);
+    }
+    if (cx_fmt(sum_want, sizeof sum_want, "BT_SUMMARY\trows=%ld\t", valid)) { mm_free(out); mm_free(copybuf); return die2("fmt", 0); }
+    if (rc != 0 || timed || res || !out || tx_find(out, outn, sum_want, tx_len(sum_want, 64)) < 0) {
+        sy_printf("S5_VERIFY_FAIL\trows=%ld\trc=%d\ttimed=%d\tresidue=%d\n", valid, rc, timed, res);
+        mm_free(out); mm_free(copybuf);
+        return 1;
+    }
+    mm_free(out);
+    if (cx_fmt(hdr, sizeof hdr, "# S5-cold rev=%s UNISACC_RUN_CACHE=0 UNISACC_UNIT_CACHE=0\n", rev)) {
+        mm_free(copybuf); return die2("fmt", 0);
+    }
+    if (sy_append_file(shared, hdr, tx_len(hdr, sizeof hdr), 0644) != 0 ||
+        sy_append_file(shared, copybuf, copyn, 0644) != 0) {
+        mm_free(copybuf); return die2("append-shared-failed", shared);
+    }
+    mm_free(copybuf);
+    sy_printf("S5_APPEND\tshared=%s\tfrom=%s\trows=%ld\trev=%s\n", shared, isolated, valid, rev);
+    return 0;
+}
+
+static void free_slot(S5Slot *s) { mm_free(s->buf); s->buf = 0; s->bufn = 0; }
+
+int main(int argc, char **argv) {
+    const char *root_arg = ".", *wave = "all", *part = 0, *out_arg = 0, *times_arg = 0;
+    const char *append_target = 0, *from_arg = 0;
+    int jobs = -1, deadline_s = 60, dry = 0, limit = -1, pk = 1, pn = 1, i;
+    int sel_idx[S5_MAX_BATCH], nsel = 0, wavemat = 0, wave_count = 0;
+    char out_parent[4400], prod[4400], runner[4400], out_dir[4400];
+    char *envv[S5_MAX_ENV], env_store[3][4600];
+    int launched = 0, passed = 0, failed = 0, timed_out = 0, total_residue = 0;
+
+    for (i = 1; i < argc; i++) {
+        const char *a = argv[i];
+        if (tx_eqz(a, "--dry")) dry = 1;
+        else if (tx_eqz(a, "--root") && i + 1 < argc) root_arg = argv[++i];
+        else if (tx_eqz(a, "--wave") && i + 1 < argc) wave = argv[++i];
+        else if (tx_eqz(a, "--part") && i + 1 < argc) part = argv[++i];
+        else if (tx_eqz(a, "--out-table") && i + 1 < argc) out_arg = argv[++i];
+        else if (tx_eqz(a, "--times") && i + 1 < argc) times_arg = argv[++i];
+        else if (tx_eqz(a, "--rev") && i + 1 < argc) { if (cx_fmt(g_rev, sizeof g_rev, "%s", argv[++i])) return die2("rev-bound", 0); }
+        else if (tx_eqz(a, "--verify-append") && i + 1 < argc) append_target = argv[++i];
+        else if (tx_eqz(a, "--from") && i + 1 < argc) from_arg = argv[++i];
+        else if (tx_eqz(a, "-j") && i + 1 < argc) {
+            long jv = parse_pos(argv[++i], 100);
+            if (jv < 1 || jv > 2) return die2("invalid-concurrency", "allowed -j 1|2 only");
+            jobs = (int)jv;
+        } else if (tx_eqz(a, "--deadline") && i + 1 < argc) {
+            long dv = parse_pos(argv[++i], 600);
+            if (dv < 1 || dv > S5_DEADLINE_MAX) return die2("invalid-deadline", "must be 1..60 seconds");
+            deadline_s = (int)dv;
+        } else if (tx_eqz(a, "--limit") && i + 1 < argc) {
+            long lv = parse_pos(argv[++i], 10000);
+            if (lv < 1) return die2("invalid-limit", "must be >= 1");
+            limit = (int)lv;
+        } else return die2("usage", a);
+    }
+
+    if (sy_realpath(root_arg, g_root, sizeof g_root) < 0) return die2("bad-root", root_arg);
+
+    if (append_target) {
+        if (!from_arg) return die2("missing-from", "--verify-append requires --from");
+        return verify_and_append(g_root, append_target, from_arg, g_rev);
+    }
+
+    if (!tx_eqz(wave, "A") && !tx_eqz(wave, "B") && !tx_eqz(wave, "C") && !tx_eqz(wave, "all"))
+        return die2("invalid-wave", wave);
+    if (part && tx_eqz(wave, "all")) return die2("part-requires-single-wave", wave);
+    if (part && parse_part(part, &pk, &pn) < 0) return die2("invalid-part", part);
+    if (tx_eqz(wave, "B")) {
+        if (jobs == 2) return die2("wave-b-serial-only", "Wave B refuses -j 2");
+        if (jobs < 0) jobs = 1;
+    } else if (jobs < 0) jobs = tx_eqz(wave, "all") ? 1 : 2;
+    if (!dry && tx_eqz(wave, "all")) return die2("live-requires-single-wave", "specify --wave A|B|C when executing");
+
+    if (times_arg) { if (cx_fmt(g_shared, sizeof g_shared, "%s", times_arg)) return die2("times-bound", 0); }
+    else default_shared_times(g_shared, sizeof g_shared);
+    if (!g_shared[0]) return die2("times-path", 0);
+
+    if (out_arg) { if (cx_fmt(g_out_table, sizeof g_out_table, "%s", out_arg)) return die2("out-table-bound", 0); }
+    else if (cx_fmt(g_out_table, sizeof g_out_table, "%s/unisacc-s5-cold-%d/batch-times.tsv", sy_tmpdir(), sy_pid()))
+        return die2("out-table-bound", 0);
+    if (same_target_path(g_out_table, g_shared)) return die2("out-table-equals-shared", g_out_table);
+    {
+        char def_shared[4400];
+        const char *h = sy_env("HOME");
+        if (cx_fmt(def_shared, sizeof def_shared, "%s/.cache/unisacc/batch-times.tsv", h && h[0] ? h : "/tmp") == 0 &&
+            same_target_path(g_out_table, def_shared)) return die2("out-table-equals-default-shared", g_out_table);
+    }
+
+    g_seen = mm_zalloc(sizeof(S5Id) * S5_MAX_BATCH);
+    g_entries = mm_zalloc(sizeof(S5Entry) * S5_MAX_BATCH);
+    g_jobs = mm_zalloc(sizeof(S5Job) * S5_MAX_BATCH);
+    if (!g_seen || !g_entries || !g_jobs) return die2("oom", 0);
+
+    if (load_seen_times(g_shared) < 0) return die2("read-shared-times", g_shared);
+    if (load_s5_jobs(g_root) < 0) return die2("read-batches", g_root);
+
+    {
+        int widx[S5_MAX_BATCH];
+        for (i = 0; i < g_njobs; i++) {
+            char w = g_jobs[i].wave;
+            if (tx_eqz(wave, "all") || w == wave[0]) widx[wave_count++] = i;
+        }
+        if (pn > 1) {
+            int base = wave_count / pn, rem = wave_count % pn;
+            int start = (pk - 1) * base + ((pk - 1) < rem ? (pk - 1) : rem);
+            int len = base + ((pk - 1) < rem ? 1 : 0);
+            for (i = start; i < start + len && i < wave_count; i++) sel_idx[nsel++] = widx[i];
+        } else {
+            for (i = 0; i < wave_count; i++) sel_idx[nsel++] = widx[i];
+        }
+    }
+    if (limit > 0 && nsel > limit) nsel = limit;
+    for (i = 0; i < nsel; i++) if (g_jobs[sel_idx[i]].wave == 'B') wavemat++;
+
+    sy_printf("S5_PLAN\twave=%s\tpart=%d/%d\ttotal_unmeasured=%d\twave_count=%d\tselected=%d\tjobs=%d\tdeadline_s=%d\tout_table=%s\tshared_times=%s\tdry=%d\n",
+              wave, pk, pn, g_njobs, wave_count, nsel, jobs, deadline_s, g_out_table, g_shared, dry);
+
+    if (dry) {
+        if (wavemat > 0)
+            sy_printf("S5_PREPARE\tcmd=affected --materials-dump --prepare-materials\tbatches=%d\n", wavemat);
+        for (i = 0; i < nsel; i++) {
+            S5Job *j = &g_jobs[sel_idx[i]];
+            sy_printf("S5_JOB\tidx=%d\tid=%s\twave=%c\tmaterials=%s\tentry=%s\n",
+                      i, j->id, j->wave, j->mat, j->entry);
+        }
+        sy_printf("S5_SUMMARY\twave=%s\tselected=%d\tlaunched=0\tpassed=0\tfailed=0\ttimed_out=0\tresidue=0\tout_table=%s\tdry=1\n",
+                  wave, nsel, g_out_table);
+        return 0;
+    }
+
+    if (wavemat > 0 && prepare_wave_b(g_root, sel_idx, nsel, deadline_s) < 0) return die2("wave-b-prepare-failed", 0);
+
+    {
+        long sl = tx_len(g_out_table, sizeof g_out_table) - 1;
+        while (sl > 0 && g_out_table[sl] != '/') sl--;
+        if (sl > 0) {
+            mm_copy(out_dir, sizeof out_dir, g_out_table, sl); out_dir[sl] = 0;
+            if (sy_mkdir_all(out_dir, 0700) != 0 && sy_exists(out_dir) != 1) return die2("mkdir-out-table", out_dir);
+        }
+    }
+    {
+        char tmpc[4096];
+        if (sy_realpath(sy_tmpdir(), tmpc, sizeof tmpc) < 0) return die2("tmpdir-realpath", sy_tmpdir());
+        if (cx_fmt(out_parent, sizeof out_parent, "%s/unisacc-affected-s5-%d-%ld", tmpc, sy_pid(), sy_now_ms()))
+            return die2("out-parent-bound", 0);
+        if (sy_mkdir(out_parent, 0700) != 0) return die2("mkdir-out-parent", out_parent);
+    }
+    if (cx_fmt(prod, sizeof prod, "%s/unisacc.com", g_root) ||
+        cx_fmt(runner, sizeof runner, "%s/tests/run-batch.cx", g_root)) return die2("path-bound", 0);
+    if (build_cold_env(g_out_table, envv, S5_MAX_ENV, env_store) < 0) return die2("env-build", 0);
+
+    {
+        S5Slot slots[S5_MAX_SLOTS];
+        int next = 0, active = 0;
+        mm_fill(slots, sizeof slots, 0, sizeof slots);
+        while (next < nsel || active > 0) {
+            int sidx;
+            while (next < nsel && active < jobs) {
+                int free_s = -1;
+                for (sidx = 0; sidx < jobs; sidx++) if (!slots[sidx].active) { free_s = sidx; break; }
+                if (free_s < 0) break;
+                {
+                    S5Job *j = &g_jobs[sel_idx[next]];
+                    char *av[16];
+                    int na = 0, k;
+                    sy_spawn_t sp; sy_child_t ch; int sr;
+                    av[na++] = "sh"; av[na++] = prod; av[na++] = runner; av[na++] = "--";
+                    av[na++] = g_root; av[na++] = out_parent; av[na++] = j->id;
+                    for (k = 0; k < j->nmat_args && na + 1 < 16; k++) av[na++] = j->mat_args[k];
+                    av[na] = 0;
+                    mm_fill(&slots[free_s], sizeof slots[free_s], 0, sizeof slots[free_s]);
+                    slots[free_s].bufcap = 65536;
+                    slots[free_s].buf = mm_alloc(slots[free_s].bufcap);
+                    if (!slots[free_s].buf) return die2("oom", 0);
+                    slots[free_s].buf[0] = 0;
+                    sy_spawn_init(&sp);
+                    sp.argv = av; sp.env = envv; sp.cwd = g_root;
+                    sp.in_fd = SY_STDIO_NULL; sp.out_fd = SY_STDIO_PIPE;
+                    sp.flags = SY_SPAWN_ERR_TO_OUT; sp.pgroup = -1;
+                    sr = sy_proc_spawn(&sp, &ch);
+                    if (sr < 0) {
+                        free_slot(&slots[free_s]);
+                        failed++;
+                        sy_printf("S5_DONE\tid=%s\tstatus=SPAWN_FAIL\trc=%d\telapsed_ms=0\tresidue=0\n", j->id, sr);
+                        next++;
+                        continue;
+                    }
+                    slots[free_s].active = 1; slots[free_s].ji = next;
+                    slots[free_s].pid = ch.pid; slots[free_s].pgid = ch.h > 0 ? ch.h : ch.pid;
+                    slots[free_s].out_fd = ch.out_fd;
+                    slots[free_s].start_ms = sy_now_ms();
+                    init_slot_times(&slots[free_s], deadline_s);
+                    active++; launched++; next++;
+                }
+            }
+            if (active > 0) {
+                sy_pollfd_t pfds[S5_MAX_SLOTS];
+                int np = 0;
+                for (sidx = 0; sidx < jobs; sidx++) {
+                    if (slots[sidx].active && slots[sidx].out_fd >= 0) {
+                        pfds[np].fd = slots[sidx].out_fd; pfds[np].events = SY_POLLIN; pfds[np].revents = 0; np++;
+                    }
+                }
+                if (np > 0) (void)sy_poll(pfds, np, 20);
+                else sy_sleep_ms(20);
+                {
+                    long now = sy_now_ms();
+                    for (sidx = 0; sidx < jobs; sidx++) {
+                        if (!slots[sidx].active) continue;
+                        {
+                            S5Job *j = &g_jobs[sel_idx[slots[sidx].ji]];
+                            if (step_slot(&slots[sidx], j->id, now) == 0) {
+                                int ok = !slots[sidx].timed_out && !slots[sidx].residue && slots[sidx].rc == 0;
+                                if (slots[sidx].timed_out) timed_out++;
+                                if (slots[sidx].residue) total_residue++;
+                                if (ok) passed++; else failed++;
+                                sy_printf("S5_DONE\tid=%s\tstatus=%s\trc=%d\ttimed_out=%d\tresidue=%d\telapsed_ms=%ld\n",
+                                          j->id, slots[sidx].timed_out ? "TIMEOUT" : (ok ? "PASS" : "FAIL"),
+                                          slots[sidx].rc, slots[sidx].timed_out, slots[sidx].residue, now - slots[sidx].start_ms);
+                                free_slot(&slots[sidx]);
+                                active--;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    sy_printf("S5_SUMMARY\twave=%s\tselected=%d\tlaunched=%d\tpassed=%d\tfailed=%d\ttimed_out=%d\tresidue=%d\tout_table=%s\tdry=0\n",
+              wave, nsel, launched, passed, failed, timed_out, total_residue, g_out_table);
+    return (failed || timed_out || total_residue) ? 1 : 0;
+}
