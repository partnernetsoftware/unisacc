+static int cr_abs_from_cwd(const char *p, char *out, size_t cap) {
+    char cwd[2048];
+    if (!p || !p[0]) return -1;
+    if (p[0] == '/') return cx_fmt(out, cap, "%s", p);
+    if (sy_cwd(cwd, sizeof cwd) != 0) return cx_fmt(out, cap, "%s", p);
+    return cx_fmt(out, cap, "%s/%s", cwd, p);
+}
+
+static int cr_sha256_file(const char *path, char hex[65]) {
+    size_t n = 0; char *b = cx_read(path, &n);
+    int rc;
+    if (!b) return -1;
+    rc = sy_sha256_hex(b, (long)n, hex);
+    mm_free(b);
+    return rc ? -1 : 0;
+}
+
+static int cr_seed_ident_sha(const char *repo, char hex[65]) {
+    char pc[4400], ph[4400], h1[65], h2[65], comb[256];
+    h2[0] = '-'; h2[1] = 0;
+    if (cx_fmt(pc, sizeof pc, "%s/seed/ident.c", repo) || cr_sha256_file(pc, h1)) return -1;
+    if (!cx_fmt(ph, sizeof ph, "%s/seed/sha256.h", repo) && sy_exists(ph) == 1) {
+        if (cr_sha256_file(ph, h2)) return -1;
+    }
+    if (cx_fmt(comb, sizeof comb, "ident.c=%s\nsha256.h=%s\n", h1, h2)) return -1;
+    return sy_sha256_hex(comb, (long)tx_len(comb, sizeof comb), hex) ? -1 : 0;
+}
+
+static int cr_default_helper_path(char *out, size_t cap) {
+    const char *home = getenv("HOME");
+    if (!home || !home[0]) return -1;
+    return cx_fmt(out, cap, "%s/.cache/unisacc/ident-helper/identity-helper-real5", home);
+}
+
+static int cr_parse_kv_hex64(const char *buf, size_t len, const char *key, char out[65]) {
+    const char *p = buf;
+    size_t kl = strlen(key);
+    while (p && (size_t)(p - buf) + kl + 64 <= len) {
+        if (!memcmp(p, key, kl)) {
+            const char *v = p + kl;
+            for (int i = 0; i < 64; i++) {
+                char c = v[i];
+                if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return -1;
+                out[i] = c;
+            }
+            out[64] = 0;
+            return 0;
+        }
+        const char *nl = strchr(p, '\n');
+        if (!nl) break;
+        p = nl + 1;
+    }
+    return -1;
+}
+
+/* Returns 1 if PASS, 0 if FAIL (fills ev). Checks stat/X_OK and <ih>.ident receipt against repo seed/ident.c. */
+static int cr_verify_helper_receipt(const char *repo, const char *ih, int strict_req, char *ev, size_t cap) {
+    struct stat st;
+    char rpath[4400], rec_src[65], rec_bin[65], cur_src[65], cur_bin[65];
+    size_t rn = 0; char *rb;
+    if (!ih || !ih[0]) {
+        cx_fmt(ev, cap, "UNISACC_IDENT_HELPER unset (default: ~/.cache/unisacc/ident-helper/identity-helper-real5; fix: sh ./unisacc.com tools/chain-ready.cx -- --prepare)");
+        return 0;
+    }
+    if (stat(ih, &st) != 0 || !S_ISREG(st.st_mode)) {
+        cx_fmt(ev, cap, "UNISACC_IDENT_HELPER missing-or-not-regular path=%s (default: ~/.cache/unisacc/ident-helper/identity-helper-real5; fix: --prepare)", ih);
+        return 0;
+    }
+    if (access(ih, X_OK) != 0) {
+        cx_fmt(ev, cap, "UNISACC_IDENT_HELPER not-executable path=%s (fix: chmod +x or --prepare)", ih);
+        return 0;
+    }
+    if (cx_fmt(rpath, sizeof rpath, "%s.ident", ih)) {
+        cx_fmt(ev, cap, "helper-receipt-path-overflow path=%s", ih);
+        return 0;
+    }
+    if (sy_exists(rpath) != 1) {
+        if (strict_req) {
+            cx_fmt(ev, cap, "helper-receipt-missing path=%s (fix: sh ./unisacc.com tools/chain-ready.cx -- --prepare --helper-out %s)", rpath, ih);
+            return 0;
+        }
+        cx_fmt(ev, cap, "UNISACC_IDENT_HELPER=%s executable", ih);
+        return 1;
+    }
+    rb = cx_read(rpath, &rn);
+    if (!rb || cr_parse_kv_hex64(rb, rn, "src_sha=", rec_src) || cr_parse_kv_hex64(rb, rn, "helper_sha=", rec_bin)) {
+        if (rb) mm_free(rb);
+        cx_fmt(ev, cap, "helper-receipt-malformed path=%s (fix: --prepare)", rpath);
+        return 0;
+    }
+    mm_free(rb);
+    if (cr_sha256_file(ih, cur_bin) || !tx_eqz(cur_bin, rec_bin)) {
+        cx_fmt(ev, cap, "helper-sha-mismatch path=%s (fix: sh ./unisacc.com tools/chain-ready.cx -- --prepare --helper-out %s)", ih, ih);
+        return 0;
+    }
+    if (cr_seed_ident_sha(repo, cur_src)) {
+        cx_fmt(ev, cap, "helper-seed-source-unreadable repo=%s", repo);
+        return 0;
+    }
+    if (!tx_eqz(cur_src, rec_src)) {
+        cx_fmt(ev, cap, "helper-stale-source-changed path=%s (seed/ident.c changed; fix: sh ./unisacc.com tools/chain-ready.cx -- --prepare --helper-out %s)", ih, ih);
+        return 0;
+    }
+    cx_fmt(ev, cap, "UNISACC_IDENT_HELPER=%s executable verified=1 src_sha=%.12s", ih, cur_src);
+    return 1;
+}
+
+static void cr_append_bad(char *bad, size_t cap, const char *piece) {
+    size_t cur = strlen(bad), pl = strlen(piece);
+    if (cur + (cur ? 2 : 0) + pl < cap) {
+        if (cur) { bad[cur++] = ','; bad[cur++] = ' '; }
+        mm_copy(bad + cur, cap - cur, piece, (long)pl);
+        bad[cur + pl] = 0;
+    }
+}
+
+static int cr_check_env_clean(int allow_future_deadline, char *bad, size_t cap, double *at_out, int *st_out) {
+    extern char **environ;
+    double at = 0.0; const char *why = 0;
+    int st = be_deadline(&at, &why);
+    static const char *leak[] = {"UNISACC_RUN_CACHE", "UNISACC_CACHE_DIR", "UNISACC_FREEZE_NO_FETCH", 0};
+    static const char *ok[] = {"UNISACC_IDENT_HELPER", "UNISACC_PREP_CACHE", "UNISACC_DEVSVC_DIR", "UNISACC_TMPDIR",
+                               "UNISACC_BATCH_TIMES", "UNISACC_COMMIT_OWN_RUN", 0};
+    bad[0] = 0;
+    if (at_out) *at_out = at;
+    if (st_out) *st_out = st;
+    if (st < 0 || (!allow_future_deadline && st > 0)) {
+        char one[200];
+        cx_fmt(one, sizeof one, "%s (%s)", be_name(), st < 0 ? why : "bound-deadline-active");
+        cr_append_bad(bad, cap, one);
+    }
+    for (int li = 0; leak[li]; li++) {
+        const char *v = getenv(leak[li]);
+        if (v != 0) cr_append_bad(bad, cap, leak[li]);
+    }
+    for (char **ep = environ; ep && *ep; ep++) {
+        const char *eq; long kl; int known = 0;
+        if (strncmp(*ep, "UNISACC_", 8)) continue;
+        eq = strchr(*ep, '='); kl = eq ? (long)(eq - *ep) : (long)strlen(*ep);
+        for (int li = 0; leak[li]; li++) if ((long)strlen(leak[li]) == kl && !memcmp(*ep, leak[li], (size_t)kl)) known = 1;
+        for (int oi = 0; ok[oi]; oi++) if ((long)strlen(ok[oi]) == kl && !memcmp(*ep, ok[oi], (size_t)kl)) known = 1;
+        if ((long)strlen(be_name()) == kl && !memcmp(*ep, be_name(), (size_t)kl)) known = 1;
+        if (!known) {
+            char one[200];
+            cx_fmt(one, sizeof one, "%.*s (unregistered, release-chain run refuses it)", (int)kl, *ep);
+            cr_append_bad(bad, cap, one);
+        }
+    }
+    return bad[0] ? 0 : 1;
+}
+
+static int cr_build_ident_helper(const char *repo, const char *out_path, char src_sha[65], char bin_sha[65], int *rebuilt) {
+    char abs_out[4400], dir[4400], tmp_out[4400], rpath[4400], rtmp[4400], bound_abs[4400], why[200], rline[256];
+    char cur_src[65], rec_src[65], rec_bin[65], cur_bin[65];
+    size_t rn = 0; char *rb;
+    *rebuilt = 0;
+    if (cr_abs_from_cwd(out_path, abs_out, sizeof abs_out)) return -1;
+    if (cr_seed_ident_sha(repo, cur_src)) return -1;
+    if (!cx_fmt(rpath, sizeof rpath, "%s.ident", abs_out) &&
+        access(abs_out, X_OK) == 0 && sy_exists(rpath) == 1 &&
+        (rb = cx_read(rpath, &rn)) != 0) {
+        int same = (!cr_parse_kv_hex64(rb, rn, "src_sha=", rec_src) &&
+                    !cr_parse_kv_hex64(rb, rn, "helper_sha=", rec_bin) &&
+                    tx_eqz(cur_src, rec_src) &&
+                    !cr_sha256_file(abs_out, cur_bin) &&
+                    tx_eqz(cur_bin, rec_bin));
+        mm_free(rb);
+        if (same) {
+            tx_copy(src_sha, 65, cur_src, 64);
+            tx_copy(bin_sha, 65, cur_bin, 64);
+            return 0;
+        }
+    }
+    if (cx_fmt(dir, sizeof dir, "%s", abs_out)) return -1;
+    { char *sl = strrchr(dir, '/'); if (sl && sl != dir) { *sl = 0; if (sy_mkdir_all(dir, 0755)) return -1; } }
+    if (cx_fmt(tmp_out, sizeof tmp_out, "%s.tmp.%d", abs_out, sy_pid()) ||
+        cx_fmt(rtmp, sizeof rtmp, "%s.ident.tmp.%d", abs_out, sy_pid())) return -1;
+    {
+        char repo_bound[4400];
+        if (!cx_fmt(repo_bound, sizeof repo_bound, "%s/tools/bound", repo) && access(repo_bound, X_OK) == 0) {
+            cx_fmt(bound_abs, sizeof bound_abs, "./tools/bound");
+        } else if (cr_abs_from_cwd("./tools/bound", bound_abs, sizeof bound_abs)) return -1;
+    }
+    {
+        char *av[] = {bound_abs, "30", "cc", "-std=c99", "-D_POSIX_C_SOURCE=200809L", "-O2", "-w", "seed/ident.c", "-o", tmp_out, 0};
+        np_result r = {0};
+        if (np_run(av, repo, 0, 35, &r, why, sizeof why) || r.rc != 0) {
+            if (r.out && r.out[0]) fprintf(stderr, "%s\n", r.out);
+            np_free(&r);
+            return -1;
+        }
+        np_free(&r);
+    }
+    if (sy_chmod(tmp_out, 0755) || sy_rename(tmp_out, abs_out)) return -1;
+    if (cr_sha256_file(abs_out, cur_bin)) return -1;
+    if (cx_fmt(rline, sizeof rline, "src_sha=%s\nhelper_sha=%s\n", cur_src, cur_bin)) return -1;
+    if (cx_write(rtmp, rline, strlen(rline)) || sy_rename(rtmp, rpath)) return -1;
+    tx_copy(src_sha, 65, cur_src, 64);
+    tx_copy(bin_sha, 65, cur_bin, 64);
+    *rebuilt = 1;
+    return 0;
+}
+
+static int cr_run_repo_derive(const char *repo, const char *uc_abs, const char *b_abs, char **dargs, int secs, char *out, size_t cap) {
+    char repo_uc[4400], repo_b[4400], why[200];
+    const char *use_uc = uc_abs, *use_b = b_abs;
+    if (!cx_fmt(repo_uc, sizeof repo_uc, "%s/unisacc.com", repo) && access(repo_uc, X_OK) == 0) use_uc = "./unisacc.com";
+    if (!cx_fmt(repo_b, sizeof repo_b, "%s/tools/bound", repo) && access(repo_b, X_OK) == 0) use_b = "./tools/bound";
+    char *av[24]; char sec_s[16]; int k = 0;
+    cx_fmt(sec_s, sizeof sec_s, "%d", secs);
+    av[k++] = (char *)use_b; av[k++] = sec_s; av[k++] = "sh"; av[k++] = (char *)use_uc;
+    av[k++] = "tools/derive.cx"; av[k++] = "--";
+    for (int i = 0; dargs[i] && k < 23; i++) av[k++] = dargs[i];
+    av[k] = 0;
+    np_result r = {0};
+    if (np_run(av, repo, 0, secs + 5, &r, why, sizeof why)) { np_free(&r); return -1; }
+    if (out && cap > 0) {
+        size_t n = r.outn < cap - 1 ? r.outn : cap - 1;
+        if (n) mm_copy(out, cap, r.out, (long)n);
+        out[n] = 0;
+    }
+    int rc = r.rc;
+    np_free(&r);
+    return rc;
+}
+
+static int cmd_prepare(const char *repo, const char *helper_out) {
+    long t0 = sy_now_ms();
+    char ih_path[4400], uc_abs[4400], b_abs[4400], src_sha[65], bin_sha[65], out[4096];
+    int rebuilt = 0;
+    const char *env_ih = getenv("UNISACC_IDENT_HELPER");
+    if (helper_out && helper_out[0]) cx_fmt(ih_path, sizeof ih_path, "%s", helper_out);
+    else if (env_ih && env_ih[0]) cx_fmt(ih_path, sizeof ih_path, "%s", env_ih);
+    else if (cr_default_helper_path(ih_path, sizeof ih_path)) {
+        printf("CHAIN_READY_PREPARE\tstatus=FAIL\tstep=ident-helper\treason=no-HOME-for-helper\n");
+        return 2;
+    }
+    if (cr_build_ident_helper(repo, ih_path, src_sha, bin_sha, &rebuilt)) {
+        printf("CHAIN_READY_PREPARE\tstatus=FAIL\tstep=ident-helper\treason=build-failed\tpath=%s\n", ih_path);
+        return 2;
+    }
+    printf("CHAIN_READY_PREPARE_STEP\tstep=ident-helper\tstatus=PREPARED\taction=%s\tpath=%s\tsrc_sha=%.12s\thelper_sha=%.12s\n",
+           rebuilt ? "rebuilt" : "reused", ih_path, src_sha, bin_sha);
+
+    if (cr_abs_from_cwd(UC, uc_abs, sizeof uc_abs) || cr_abs_from_cwd("./tools/bound", b_abs, sizeof b_abs)) return 2;
+    static const char *prep_shards[] = {
+        "batch-packages-gen",
+        "tables-gen,signal-targets,cx-flatten,layer-api,iface-hash,st-gap,chain-phases",
+        "batch-domains,links,libc-decls,product-map,doc-links,tool-index,table-index,cx0-three-source",
+        0
+    };
+    int nshards = 0;
+    for (int s = 0; prep_shards[s]; s++) {
+        char *da[] = {"--check", "--prepare-native", "--only", (char *)prep_shards[s], 0};
+        int rc = cr_run_repo_derive(repo, uc_abs, b_abs, da, 45, out, sizeof out);
+        if (rc != 0) {
+            printf("CHAIN_READY_PREPARE\tstatus=FAIL\tstep=derive-native\tshard=%s\trc=%d\n", prep_shards[s], rc);
+            return 1;
+        }
+        nshards++;
+    }
+    printf("CHAIN_READY_PREPARE_STEP\tstep=derive-native\tstatus=PREPARED\tshards=%d\n", nshards);
+
+    const char *ti_act = "clean";
+    {
+        char *ca[] = {"--check", "--only", "table-index", 0};
+        int crc = cr_run_repo_derive(repo, uc_abs, b_abs, ca, 25, out, sizeof out);
+        if (crc != 0) {
+            char *wa[] = {"--write", "--only", "table-index", 0};
+            int wrc = cr_run_repo_derive(repo, uc_abs, b_abs, wa, 25, out, sizeof out);
+            if (wrc != 0 || cr_run_repo_derive(repo, uc_abs, b_abs, ca, 25, out, sizeof out) != 0) {
+                printf("CHAIN_READY_PREPARE\tstatus=FAIL\tstep=table-index\treason=refresh-failed\trc=%d\n", wrc);
+                return 1;
+            }
+            ti_act = "refreshed";
+        }
+    }
+    printf("CHAIN_READY_PREPARE_STEP\tstep=table-index\tstatus=PREPARED\taction=%s\n", ti_act);
+    printf("CHAIN_READY_PREPARE\tstatus=PREPARED\thelper=%s\tderive_native=%d/%d\ttable_index=%s\tms=%ld\n",
+           ih_path, nshards, nshards, ti_act, sy_now_ms() - t0);
+    return 0;
+}
+
+static int cmd_launch_env(const char *repo, const char *rootarg, const char *tver, const char *revarg, const char *helper_out, int strict_helper) {
+    char bad[512], ih_path[4400], ev[640], ver[32], rev[64];
+    if (!cr_check_env_clean(0, bad, sizeof bad, 0, 0)) {
+        printf("REFUSE\tLAUNCH_ENV\treason=polluted-env\tvar=%s\tfix: unset polluted variables or run under env -i\n", bad);
+        return 2;
+    }
+    const char *env_ih = getenv("UNISACC_IDENT_HELPER");
+    if (helper_out && helper_out[0]) cx_fmt(ih_path, sizeof ih_path, "%s", helper_out);
+    else if (env_ih && env_ih[0]) cx_fmt(ih_path, sizeof ih_path, "%s", env_ih);
+    else if (cr_default_helper_path(ih_path, sizeof ih_path)) {
+        printf("REFUSE\tLAUNCH_ENV\treason=ident-helper-missing\tpath=-\tfix: sh ./unisacc.com tools/chain-ready.cx -- --prepare --repo %s\n", repo);
+        return 2;
+    }
+    if (!cr_verify_helper_receipt(repo, ih_path, strict_helper, ev, sizeof ev)) {
+        printf("REFUSE\tLAUNCH_ENV\treason=ident-helper-missing\tdetail=%s\n", ev);
+        return 2;
+    }
+    const char *home = getenv("HOME"); if (!home || !home[0]) home = "/root";
+    const char *user = getenv("USER"); if (!user || !user[0]) user = getenv("LOGNAME"); if (!user || !user[0]) user = "devali";
+    const char *own = getenv("DEVSVC_OWNER"); if (!own || !own[0]) own = "cc";
+    const char *eff_root = rootarg && rootarg[0] ? rootarg : repo;
+    if (tver && tver[0]) cx_fmt(ver, sizeof ver, "%s", tver);
+    else if (!seq_next_version(repo, ver)) cx_fmt(ver, sizeof ver, "0.1.3");
+    if (revarg && revarg[0]) cx_fmt(rev, sizeof rev, "%s", revarg);
+    else if (!parse2_commit(repo, "HEAD", rev)) cx_fmt(rev, sizeof rev, "HEAD_HEX40");
+    printf("CHAIN_READY_LAUNCH_ENV\tok=1\thelper=%s\tversion=%s\trev=%s\n", ih_path, ver, rev);
+    printf("env -i HOME=\"%s\" USER=\"%s\" LOGNAME=\"%s\" TMPDIR=/tmp PATH=\"/usr/bin:/bin:%s/.local/bin\" DEVSVC_OWNER=\"%s\" UNISACC_IDENT_HELPER=\"%s\" sh ./unisacc.com tools/chain-ready.cx -- --repo \"%s\" --root \"%s\" --version \"%s\"\n",
