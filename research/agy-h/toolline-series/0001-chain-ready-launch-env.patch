+            rc = run(v, out, sizeof out);
+            ck(rc == 2 && has(out, "REFUSE\tLAUNCH_ENV\treason=polluted-env") && has(out, "UNISACC_CACHE_DIR"),
+               "launch-env-mut-cache-dir-refused");
+        }
+        /* (2) Missing helper under --launch-env must refuse */
+        {   char *v[] = {"./tools/bound", "40", "env", "-i", "PATH=/usr/bin:/bin", "HOME=/tmp/cr-no-home-helper", "TMPDIR=/tmp",
+                         "sh", UC, "tools/chain-ready.cx", "--", "--launch-env", "--repo", prepo, "--helper-out", ih, 0};
+            rc = run(v, out, sizeof out);
+            ck(rc == 2 && has(out, "REFUSE\tLAUNCH_ENV\treason=ident-helper-missing"),
+               "launch-env-mut-missing-helper-refused");
+        }
+        /* (3) --prepare builds helper, refreshes table-index baseline, prewarms derive-native in bounded shards */
+        {   char *v[] = {"./tools/bound", "60", "sh", "-c",
+                         "cd '" "' && exit 2", 0};
+            (void)v;
+            cx_fmt(cmd, sizeof cmd,
+                "cd '%s' && env -u UNISACC_BOUND_DEADLINE_MONO -u UNISACC_RUN_CACHE -u UNISACC_CACHE_DIR -u UNISACC_FREEZE_NO_FETCH "
+                "sh '%s/unisacc.com' '%s/tools/chain-ready.cx' -- --prepare --repo . --helper-out '%s'",
+                prepo, cwd, cwd, ih);
+            char *pv[] = {"./tools/bound", "60", "sh", "-c", cmd, 0};
+            rc = run(pv, out, sizeof out);
+            ck(rc == 0 && has(out, "CHAIN_READY_PREPARE_STEP\tstep=ident-helper\tstatus=PREPARED") &&
+               has(out, "CHAIN_READY_PREPARE_STEP\tstep=derive-native\tstatus=PREPARED") &&
+               has(out, "CHAIN_READY_PREPARE_STEP\tstep=table-index\tstatus=PREPARED\taction=refreshed") &&
+               has(out, "CHAIN_READY_PREPARE\tstatus=PREPARED") && !has(out, "\tPASS\t"),
+               "prepare-builds-helper-prewarms-and-refreshes-table-index");
+        }
+        /* (4) After --prepare: --launch-env succeeds and prints canonical env -i line */
+        {   cx_fmt(cmd, sizeof cmd,
+                "env -i HOME=\"$HOME\" PATH=/usr/bin:/bin TMPDIR=/tmp DEVSVC_OWNER=cc UNISACC_IDENT_HELPER='%s' "
+                "sh ./unisacc.com tools/chain-ready.cx -- --launch-env --repo '%s' --version 0.1.3",
+                ih, prepo);
+            char *lv[] = {"./tools/bound", "40", "sh", "-c", cmd, 0};
+            rc = run(lv, out, sizeof out);
+            ck(rc == 0 && has(out, "CHAIN_READY_LAUNCH_ENV\tok=1") && has(out, "env -i ") &&
+               has(out, "UNISACC_IDENT_HELPER=") && has(out, "tools/chain-ready.cx"),
+               "launch-env-clean-prints-canonical-env-i");
+        }
+        /* (5) 2a-derive inside prepo after --prepare: table-index is clean and batch-packages-gen runs isolated */
+        {   cx_fmt(cmd, sizeof cmd,
+                "cd '%s' && sh '%s/unisacc.com' '%s/tools/chain-ready.cx' -- --repo . --only 2a-derive",
+                prepo, cwd, cwd);
+            char *dv[] = {"./tools/bound", "60", "sh", "-c", cmd, 0};
+            rc = run(dv, out, sizeof out);
+            ck(rc == 0 && has(out, "2a-derive\tPASS") && !has(out, "CONCURRENT_VIOLATION"),
+               "derive-2a-after-prepare-isolated-pass");
+        }
+        /* (6) Gap (1) regression check: re-inject table-index drift -> 2a-derive fails specifically naming table-index(DRIFT) */
+        {   cx_fmt(cmd, sizeof cmd,
+                "cd '%s' && touch build/.table_drift && sh '%s/unisacc.com' '%s/tools/chain-ready.cx' -- --repo . --only 2a-derive",
+                prepo, cwd, cwd);
+            char *dv[] = {"./tools/bound", "60", "sh", "-c", cmd, 0};
+            rc = run(dv, out, sizeof out);
+            ck(rc == 1 && has(out, "2a-derive\tFAIL") && has(out, "failed_generator=table-index(DRIFT)"),
+               "derive-2a-detects-table-index-drift-independently");
+        }
+        /* (7) 20-ident-helper strict verification + tampering & seed mutation checks */
+        {   cx_fmt(cmd, sizeof cmd,
+                "UNISACC_IDENT_HELPER='%s' sh ./unisacc.com tools/chain-ready.cx -- --repo '%s' --only 20-ident-helper --strict-helper",
+                ih, prepo);
+            char *hv[] = {"./tools/bound", "40", "sh", "-c", cmd, 0};
+            rc = run(hv, out, sizeof out);
+            ck(rc == 0 && has(out, "20-ident-helper\tPASS"), "ident-helper-strict-verified-pass");
+        }
+        {   cx_fmt(cmd, sizeof cmd,
+                "UNISACC_IDENT_HELPER='%s/tools/bound' sh ./unisacc.com tools/chain-ready.cx -- --repo '%s' --only 20-ident-helper --strict-helper",
+                prepo, prepo);
+            char *hv[] = {"./tools/bound", "40", "sh", "-c", cmd, 0};
+            rc = run(hv, out, sizeof out);
+            ck(rc == 1 && has(out, "20-ident-helper\tFAIL") && has(out, "helper-receipt-missing"),
+               "ident-helper-mut-strict-unverified-refused");
+        }
+        {   cx_fmt(cmd, sizeof cmd,
+                "cp '%s' '%s.bak' && printf 'X' >> '%s' && "
+                "UNISACC_IDENT_HELPER='%s' sh ./unisacc.com tools/chain-ready.cx -- --repo '%s' --only 20-ident-helper; "
+                "r=$?; mv -f '%s.bak' '%s'; exit $r",
+                ih, ih, ih, ih, prepo, ih, ih);
+            char *hv[] = {"./tools/bound", "40", "sh", "-c", cmd, 0};
+            rc = run(hv, out, sizeof out);
+            ck(rc == 1 && has(out, "20-ident-helper\tFAIL") && has(out, "helper-sha-mismatch"),
+               "ident-helper-mut-tamper-1byte-refused");
+        }
+        {   cx_fmt(cmd, sizeof cmd,
+                "printf '/* mut */\\n' >> '%s/seed/ident.c' && "
+                "UNISACC_IDENT_HELPER='%s' sh ./unisacc.com tools/chain-ready.cx -- --repo '%s' --only 20-ident-helper",
+                prepo, ih, prepo);
+            char *hv[] = {"./tools/bound", "40", "sh", "-c", cmd, 0};
+            rc = run(hv, out, sizeof out);
+            ck(rc == 1 && has(out, "20-ident-helper\tFAIL") && has(out, "helper-stale-source-changed"),
+               "ident-helper-mut-seed-changed-refused");
+        }
+    }
     printf("CHAIN_READY_CHECK\tpassed=%d\tfailed=%d\n", passed, failed);
     return failed ? 1 : 0;
 }
