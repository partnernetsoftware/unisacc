+static int fc_check_root_files(const char *repo, char *detail, size_t cap) {
+    static const char *names[2] = {"unisacc.com", "unisacc.com.build.json"};
+    for (int i = 0; i < 2; i++) {
+        char p[4400]; sy_stat_t st;
+        if (cx_fmt(p, sizeof p, "%s/%s", repo, names[i])) return -1;
+        if (sy_lstat(p, &st) != 0) { cx_fmt(detail, cap, "path=%s status=missing", p); return -1; }
+        if (st.kind != 'f') { cx_fmt(detail, cap, "path=%s kind=%c", p, st.kind); return -2; }
+    }
+    return 0;
+}
