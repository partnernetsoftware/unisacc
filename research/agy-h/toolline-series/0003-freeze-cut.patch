diff --git a/tools/check-freeze-cut.cx b/tools/check-freeze-cut.cx
new file mode 100644
index 0000000..547f857
--- /dev/null
+++ b/tools/check-freeze-cut.cx
@@ -0,0 +1,220 @@
+/* tools/check-freeze-cut.cx -- red-then-green contract check for tools/freeze-cut.cx (batch freeze-cut).
+ * Tests precondition refusals (bad version, polluted env, symlink root, missing owner, non-public prev slot,
+ * active prev freeze, dirty product source before cut), single-command --cut (C0a numbering commit + C0b
+ * isolated freeze row commit), --check PASS, and post-cut tamper mutations.
+ * Final line: CHECK_FREEZE_CUT<TAB>passed=N<TAB>failed=M
+ */
+#pragma unisa use fsx.fs
+#pragma unisa use sys.fs
+#pragma unisa use sys.io
+#pragma unisa use sys.proc
+#pragma unisa use sys.posix
+#pragma unisa use text.text
+#pragma unisa use text.fmt
+#pragma unisa use mem.heap
+#pragma unisa use mem.bytes
+#pragma unisa use cxlib.netpack
+
+static int g_pass, g_fail;
+static char g_root[4096];
+
+static void ck(int ok, const char *name, const np_result *r) {
+    if (ok) {
+        g_pass++;
+        printf("PASS\t%s\n", name);
+    } else {
+        g_fail++;
+        printf("FAIL\t%s\trc=%d\tout=%.200s\terr=%.200s\n",
+               name, r ? r->rc : -1,
+               (r && r->out) ? r->out : "",
+               (r && r->err) ? r->err : "");
+    }
+}
+
+static int run_sh(const char *cwd, const char *cmd, int timeout_s, np_result *r) {
+    char *av[4];
+    char why[256];
+    av[0] = "sh"; av[1] = "-c"; av[2] = (char *)cmd; av[3] = 0;
+    mm_fill(r, sizeof *r, 0, sizeof *r);
+    if (np_run(av, cwd, 0, timeout_s, r, why, sizeof why) != 0) return -1;
+    return r->rc;
+}
+
+static int has(const np_result *r, const char *lit) {
+    long ll = tx_len(lit, 512);
+    if (r->out && r->outn > 0 && tx_find(r->out, (long)r->outn, lit, ll) >= 0) return 1;
+    if (r->err && r->errn > 0 && tx_find(r->err, (long)r->errn, lit, ll) >= 0) return 1;
+    return 0;
+}
+
+static int run_fc(const char *env_pre, const char *args, np_result *r) {
+    char cmd[8192];
+    if (cx_fmt(cmd, sizeof cmd,
+               "env -u UNISACC_RUN_CACHE -u UNISACC_CACHE_DIR -u UNISACC_FREEZE_NO_FETCH "
+               "-u UNISACC_BOUND_DEADLINE_MONO %s sh '%s/unisacc.com' '%s/tools/freeze-cut.cx' -- %s",
+               env_pre ? env_pre : "", g_root, g_root, args)) return -1;
+    return run_sh(g_root, cmd, 45, r);
+}
+
+static void init_repo(const char *repo, const char *state67) {
+    char shcmd[8192]; np_result r;
+    cx_fmt(shcmd, sizeof shcmd,
+        "set -e; rm -rf '%s'; mkdir -p '%s/build/layer-api' '%s/release' '%s/plans' '%s/src' '%s/research'; cd '%s'; "
+        "git init -q -b main; git config user.name test; git config user.email t@local; git config commit.gpgsign false; "
+        "printf 'ape\\n' > unisacc.com; printf '{\"version\":\"0.1.2\"}\\n' > unisacc.com.build.json; "
+        "printf '# slot\\tversion\\tclass\\tstate\\tnote\\n"
+        "67\\t0.1.2\\t基线主题(C1+C2)\\t%s\\t编排者 2026-11-25 立项 0.1.2;计划 plans/v0.1.2.md\\n' > build/version-seq.tsv; "
+        "printf 'repo\\ttag\\tcommit\\tversion\\tworkflow\\tworkflow_ref\\tci_run_id\\tape\\n"
+        "org/repo\\tv0.1.2\\t11223344556677889900aabbccddeeff00112233\\t0.1.2\\tcandidate-native.yml\\tv0.1.2\\t0\\tunisacc.com\\n' > release/candidate.tsv; "
+        "printf '# candidate_sid\\tbase_commit\\towner\\tdeadline_epoch_s\\tpaths\\n"
+        "# 0.1.2-FREEZE\\t11223344556677889900aabbccddeeff00112233\\tcc\\t4102444800\\tsrc\\n' > build/freeze.tsv; "
+        "printf '# 0.1.2 计划:基线主题\\nplanned_units=8\\ndone_units=UNMEASURED\\nunplanned_units=0\\na_class=基线主题\\na_files_cap=24\\nfreeze_at=TBD\\n' > plans/v0.1.2.md; "
+        "printf 'p\\t1\\n' > build/tlib-packages.tsv; printf 'h\\t1\\n' > build/iface-hash.tsv; printf 'x\\n' > build/layer-api/x.tsv; "
+        "printf 'int a = 1;\\n' > src/a.c; printf 'doc\\n' > research/r.md; "
+        "git add -A; git commit -qm init",
+        repo, repo, repo, repo, repo, repo, repo, state67);
+    (void)run_sh(g_root, shcmd, 30, &r);
+    np_free(&r);
+}
+
+int main(void) {
+    if (sy_realpath(".", g_root, sizeof g_root) < 0) return 2;
+    int sc = 0;
+    if (fsx_scratch(&sc, "check-fcut-") != 0) return 2;
+    const char *dir = fsx_scratch_dir(sc);
+    if (!dir) return 2;
+
+    char repo[1024], args[2048], shcmd[4096];
+    np_result r;
+
+    cx_fmt(repo, sizeof repo, "%s/repo_cut", dir);
+    init_repo(repo, "\xe5\xb7\xb2\xe5\x85\xac\xe5\xbc\x80"); /* 已公开 */
+
+    /* 1. Bad version format refused */
+    cx_fmt(args, sizeof args, "--cut --repo '%s' --version 0.1 --topic foo --owner cc --no-derive", repo);
+    run_fc("", args, &r);
+    ck(r.rc == 2 && has(&r, "REFUSE\tFREEZE_CUT\tbad-version"), "mut-bad-version-refused", &r);
+    np_free(&r);
+
+    /* 2. Polluted env refused */
+    cx_fmt(args, sizeof args, "--check --repo '%s' --version 0.1.3 --owner cc --no-derive", repo);
+    run_fc("UNISACC_FREEZE_NO_FETCH=1", args, &r);
+    ck(r.rc == 2 && has(&r, "REFUSE\tFREEZE_CUT\tpolluted-env"), "mut-polluted-env-refused", &r);
+    np_free(&r);
+
+    /* 3. Missing owner refused */
+    cx_fmt(args, sizeof args, "--cut --repo '%s' --version 0.1.3 --topic foo --no-derive", repo);
+    run_fc("-u DEVSVC_OWNER -u UNISACC_INTEGRATOR", args, &r);
+    ck(r.rc == 2 && has(&r, "REFUSE\tFREEZE_CUT\towner-unset"), "mut-owner-unset-refused", &r);
+    np_free(&r);
+
+    /* 4. Symlink Root file refused */
+    cx_fmt(shcmd, sizeof shcmd, "cd '%s' && mv unisacc.com unisacc.com.real && ln -s unisacc.com.real unisacc.com", repo);
+    run_sh(g_root, shcmd, 15, &r); np_free(&r);
+    cx_fmt(args, sizeof args, "--cut --repo '%s' --version 0.1.3 --topic foo --owner cc --no-derive", repo);
+    run_fc("", args, &r);
+    ck(r.rc == 2 && has(&r, "REFUSE\tFREEZE_CUT\troot-file-symlink"), "mut-root-symlink-refused", &r);
+    np_free(&r);
+    cx_fmt(shcmd, sizeof shcmd, "cd '%s' && rm -f unisacc.com && mv unisacc.com.real unisacc.com", repo);
+    run_sh(g_root, shcmd, 15, &r); np_free(&r);
+
+    /* 5. Previous version not public refused */
+    char rbad_prev[1024];
+    cx_fmt(rbad_prev, sizeof rbad_prev, "%s/repo_prev", dir);
+    init_repo(rbad_prev, "\xe8\xbf\x9b\xe8\xa1\x8c\xe4\xb8\xad"); /* 进行中 */
+    cx_fmt(args, sizeof args, "--cut --repo '%s' --version 0.1.3 --topic foo --owner cc --no-derive", rbad_prev);
+    run_fc("", args, &r);
+    ck(r.rc == 2 && has(&r, "REFUSE\tFREEZE_CUT\tprev-version-not-public"), "mut-prev-not-public-refused", &r);
+    np_free(&r);
+
+    /* 6. Active unthawed freeze row refused */
+    cx_fmt(shcmd, sizeof shcmd,
+           "cd '%s' && printf '0.1.2-FREEZE\\t11223344556677889900aabbccddeeff00112233\\tcc\\t4102444800\\tsrc\\n' >> build/freeze.tsv && "
+           "git add build/freeze.tsv && git commit -qm active-frz", repo);
+    run_sh(g_root, shcmd, 15, &r); np_free(&r);
+    cx_fmt(args, sizeof args, "--cut --repo '%s' --version 0.1.3 --topic foo --owner cc --no-derive", repo);
+    run_fc("", args, &r);
+    ck(r.rc == 2 && has(&r, "REFUSE\tFREEZE_CUT\tprev-freeze-still-active"), "mut-prev-freeze-active-refused", &r);
+    np_free(&r);
+    cx_fmt(shcmd, sizeof shcmd, "cd '%s' && git reset -q --hard HEAD~1", repo);
+    run_sh(g_root, shcmd, 15, &r); np_free(&r);
+
+    /* 7. Dirty product source before numbering refused */
+    cx_fmt(shcmd, sizeof shcmd, "cd '%s' && printf 'int dirty = 1;\\n' >> src/a.c", repo);
+    run_sh(g_root, shcmd, 15, &r); np_free(&r);
+    cx_fmt(args, sizeof args, "--cut --repo '%s' --version 0.1.3 --topic foo --owner cc --no-derive", repo);
+    run_fc("", args, &r);
+    ck(r.rc == 2 && has(&r, "REFUSE\tFREEZE_CUT\tnumbering-step-touched-product-source"), "mut-dirty-product-refused", &r);
+    np_free(&r);
+    cx_fmt(shcmd, sizeof shcmd, "cd '%s' && git checkout -q -- src/a.c", repo);
+    run_sh(g_root, shcmd, 15, &r); np_free(&r);
+
+    /* 8. --check before cut must fail */
+    cx_fmt(args, sizeof args, "--check --repo '%s' --version 0.1.3 --owner cc --no-derive", repo);
+    run_fc("", args, &r);
+    ck(r.rc != 0, "mut-check-before-cut-fails", &r);
+    np_free(&r);
+
+    /* 9. Happy path --cut + --check + git commit structure check */
+    cx_fmt(args, sizeof args,
+           "--cut --repo '%s' --version 0.1.3 --topic '生命周期与切片车' --a-class '生命周期与切片车' --planned-units 8 --a-files-cap 24 --owner cc --deadline-s 7200 --no-derive",
+           repo);
+    run_fc("", args, &r);
+    ck(r.rc == 0 && has(&r, "FREEZE_CUT\tPASS\tversion=0.1.3\tslot=68"), "cut-single-command-pass", &r);
+    np_free(&r);
+
+    cx_fmt(args, sizeof args, "--check --repo '%s' --version 0.1.3 --owner cc --no-derive", repo);
+    run_fc("", args, &r);
+    ck(r.rc == 0 && has(&r, "FREEZE_CUT\tCHECK_PASS\tversion=0.1.3\tslot=68"), "check-after-cut-pass", &r);
+    np_free(&r);
+
+    /* Verify C0a and C0b git history + candidate.tsv + freeze base_commit + plans/v0.1.3.md */
+    cx_fmt(shcmd, sizeof shcmd,
+        "cd '%s' && "
+        "C0A=$(git rev-parse HEAD~1) && "
+        "BASE=$(awk -F'\\t' '$1==\"0.1.3-FREEZE\"{print $2}' build/freeze.tsv) && "
+        "[ \"$C0A\" = \"$BASE\" ] && "
+        "FDIFF=$(git diff-tree --no-commit-id --name-only -r HEAD) && "
+        "[ \"$FDIFF\" = \"build/freeze.tsv\" ] && "
+        "grep -q '^# 0.1.3 计划:生命周期与切片车' plans/v0.1.3.md && "
+        "grep -q '^planned_units=8$' plans/v0.1.3.md && "
+        "grep -q '^a_files_cap=24$' plans/v0.1.3.md && "
+        "grep -q 'plans/v0.1.3.md' plans/v0.1.3.md && "
+        "awk -F'\\t' 'NR==2{exit($4==\"0.1.3\"?0:1)}' release/candidate.tsv && "
+        "echo STRUCT_OK", repo);
+    run_sh(g_root, shcmd, 15, &r);
+    ck(r.rc == 0 && has(&r, "STRUCT_OK"), "cut-git-structure-exact", &r);
+    np_free(&r);
+
+    /* 10. Tamper mutations caught by --check */
+    /* 10a: freeze commit mixed with product file */
+    cx_fmt(shcmd, sizeof shcmd,
+        "cd '%s' && printf 'int m = 1;\\n' >> src/a.c && git add src/a.c build/freeze.tsv && git commit -q --amend --no-edit", repo);
+    run_sh(g_root, shcmd, 15, &r); np_free(&r);
+    cx_fmt(args, sizeof args, "--check --repo '%s' --version 0.1.3 --owner cc --no-derive", repo);
+    run_fc("", args, &r);
+    ck(r.rc == 2 && has(&r, "REFUSE\tFREEZE_CUT\tfreeze-commit-mixed"), "mut-check-freeze-mixed-refused", &r);
+    np_free(&r);
+
+    /* 10b: tlib after freeze refused (reset back clean first, then commit iface-hash after freeze) */
+    cx_fmt(shcmd, sizeof shcmd,
+        "cd '%s' && git reset -q --hard HEAD@{1} && printf 'h\\t2\\n' > build/iface-hash.tsv && git add build/iface-hash.tsv && git commit -qm late-tlib", repo);
+    run_sh(g_root, shcmd, 15, &r); np_free(&r);
+    cx_fmt(args, sizeof args, "--check --repo '%s' --version 0.1.3 --owner cc --no-derive", repo);
+    run_fc("", args, &r);
+    ck(r.rc == 2 && has(&r, "REFUSE\tFREEZE_CUT\ttlib-after-freeze"), "mut-check-tlib-after-freeze-refused", &r);
+    np_free(&r);
+
+    /* 10c: plan R1 mismatch caught by --check */
+    cx_fmt(shcmd, sizeof shcmd,
+        "cd '%s' && git reset -q --hard HEAD~1 && sed -i '1s/0.1.3/0.1.4/' plans/v0.1.3.md && git add plans/v0.1.3.md && git commit -qm bad-plan", repo);
+    run_sh(g_root, shcmd, 15, &r); np_free(&r);
+    cx_fmt(args, sizeof args, "--check --repo '%s' --version 0.1.3 --owner cc --no-derive", repo);
+    run_fc("", args, &r);
+    ck(r.rc == 2 && has(&r, "REFUSE\tFREEZE_CUT\tplan-version-mismatch"), "mut-check-plan-r1-refused", &r);
+    np_free(&r);
+
+    fsx_scratch_drop(sc);
+    printf("CHECK_FREEZE_CUT\tpassed=%d\tfailed=%d\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/tools/freeze-cut.cx b/tools/freeze-cut.cx
new file mode 100644
index 0000000..debaaf5
--- /dev/null
+++ b/tools/freeze-cut.cx
@@ -0,0 +1,721 @@
+/* tools/freeze-cut.cx -- transactional numbering & freeze cut (C0a numbering + C0b isolated freeze commit).
+ * Implements skills/unisacc-orch-release-train (2) pre-chain checklist:
+ *   sh ./unisacc.com tools/freeze-cut.cx -- --check --version V [--repo DIR] [--owner NAME] [--no-derive] [--skip-root-check]
+ *   sh ./unisacc.com tools/freeze-cut.cx -- --cut --version V --topic TEXT [--a-class TEXT]
+ *       [--planned-units N] [--a-files-cap N] [--repo DIR] [--owner NAME]
+ *       [--deadline-s SECS | --deadline-epoch EPOCH] [--paths STR]
+ *       [--use-existing-plan] [--no-commit] [--no-derive] [--skip-root-check]
+ *
+ * Guarantees:
+ *   1. Clean env (no UNISACC_FREEZE_NO_FETCH/UNISACC_RUN_CACHE/UNISACC_CACHE_DIR/unregistered UNISACC_*).
+ *   2. Regular root files (unisacc.com, unisacc.com.build.json not symlinks unless --skip-root-check).
+ *   3. Previous version in build/version-seq.tsv is public and no old freeze row remains active.
+ *   4. Single numbering commit C0a updates build/version-seq.tsv, release/candidate.tsv (version col),
+ *      plans/v<V>.md (R1/R2/R5 + 19-chain-preflight fields), and build/table-index.tsv (via derive unless --no-derive),
+ *      with zero PIK1 product-input files modified.
+ *   5. Separate final commit C0b appends <V>-FREEZE to build/freeze.tsv with base_commit=C0a (only build/freeze.tsv touched),
+ *      preserving tlib-packages / layer-api / iface-hash ordering before freeze.
+ *
+ * Check: tools/check-freeze-cut.cx (batch freeze-cut).
+ */
+#pragma unisa use fsx.fs
+#pragma unisa use sys.fs
+#pragma unisa use sys.io
+#pragma unisa use sys.env
+#pragma unisa use sys.proc
+#pragma unisa use sys.time
+#pragma unisa use sys.posix
+#pragma unisa use text.text
+#pragma unisa use text.fmt
+#pragma unisa use text.conv
+#pragma unisa use mem.heap
+#pragma unisa use mem.bytes
+#pragma unisa use cxlib.netpack
+#pragma unisa use cxlib.releaseversion
+#pragma unisa use cxlib.releaseseq
+
+static int refuse(const char *reason, const char *detail) {
+    printf("REFUSE\tFREEZE_CUT\t%s\t%s\n", reason, detail && detail[0] ? detail : "-");
+    return 2;
+}
+
+static int fc_under(const char *p, const char *dir) {
+    long dl = (long)tx_len(dir, 64);
+    return p && !strncmp(p, dir, (size_t)dl) && p[dl] == '/';
+}
+
+static int fc_ends(const char *p, const char *sfx) {
+    long pl = (long)tx_len(p, 4096), sl = (long)tx_len(sfx, 64);
+    return pl >= sl && !memcmp(p + pl - sl, sfx, (size_t)sl);
+}
+
+static const char *fc_base(const char *p) {
+    const char *s = strrchr(p, '/');
+    return s ? s + 1 : p;
+}
+
+static int fc_is_pik1_path(const char *p) {
+    static const char *const exact[] = {
+        "iterate/kernel/typekw.tsv", "cxroot.tsv", "build/core-closure.tsv",
+        "tools/bound", "tools/bound.c", "tools/cxbin", "tools/safedel.cx", "tools/lib.sh",
+        "tools/build_ref.sh", "tools/export_ref.sh", "tools/refshim.h", "tools/reffoot.h",
+        "tools/sourceflat.cx", "tools/ape-pack.cx", "tools/release-ape.cx", "tools/cxlib/releaseversion.cx",
+        "tools/candidate-chain.cx", "tools/chain-step.cx", "tools/release-build.cx", "tools/build.cx",
+        "tools/kernel-build.cx", "tools/product-build.cx", "tools/source-job-wave.cx", "tools/pc-wave.cx",
+        "tools/selfhost.cx", "tools/cxlib/nninputs.cx", "tools/cxlib/netpack.cx",
+        "tools/cxlib/kernelsha.cx", "tools/cxlib/productpkg.cx", "tools/cxlib/netsel.cx", 0
+    };
+    static const char *const seed_ok[] = {
+        "tbl.c", "net.c", "json.h", "gen.c", "facts.h", "ident.c",
+        "blob.c", "sha256.h", "pack.c", "compilerpack.c", "ape.c", 0
+    };
+    const char *b; int i;
+    if (!p || !p[0]) return 0;
+    for (i = 0; exact[i]; i++) if (tx_eqz(p, exact[i])) return 1;
+    b = fc_base(p);
+    if (fc_under(p, "seed")) {
+        for (i = 0; seed_ok[i]; i++) if (tx_eqz(b, seed_ok[i])) return 1;
+        return 0;
+    }
+    if (tx_eqz(b, "README.md") || tx_eqz(b, ".DS_Store") || fc_ends(p, ".md")) return 0;
+    if ((fc_ends(p, ".c") || fc_ends(p, ".h")) && (fc_under(p, "probes") || strstr(p, "/probes/") != 0)) return 0;
+    if (fc_under(p, "cx")) {
+        if (tx_eqz(p, "cx/check_memory.cx") || tx_eqz(p, "cx/check_owned.cx")) return 0;
+        return 1;
+    }
+    if (fc_under(p, "exec")) {
+        if (tx_eqz(p, "exec/facts/derive.tsv")) return 0;
+        if (fc_ends(p, "check.sh") || fc_ends(p, "check.py") || fc_ends(p, "check.cx")) return 0;
+        if (fc_under(p, "exec/build") && (strchr(p + 11, '/') != 0 || !fc_ends(p, ".py"))) return 0;
+        return 1;
+    }
+    if (fc_under(p, "src") || fc_under(p, "include") || fc_under(p, "kernel") ||
+        fc_under(p, "weights") || fc_under(p, "ext") || fc_under(p, "flownet")) return 1;
+    return 0;
+}
+
+static int fc_is_hex40(const char *s) {
+    int i;
+    if (!s) return 0;
+    for (i = 0; i < 40; i++) {
+        char c = s[i];
+        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 0;
+    }
+    return s[40] == 0;
+}
+
+static int fc_same_ci(const char *a, long an, const char *b) {
+    long bn = b ? (long)tx_len(b, 64) : 0, i;
+    while (an > 0 && (a[an - 1] == ' ' || a[an - 1] == '\r')) an--;
+    if (!an || an != bn) return 0;
+    for (i = 0; i < an; i++) {
+        char x = a[i], y = b[i];
+        if (x >= 'A' && x <= 'Z') x = (char)(x + 32);
+        if (y >= 'A' && y <= 'Z') y = (char)(y + 32);
+        if (x != y) return 0;
+    }
+    return 1;
+}
+
+static int fc_git(const char *repo, char **argv, char *out, long cap) {
+    np_result r = {0}; char why[200]; int rc; size_t n;
+    if (out && cap > 0) out[0] = 0;
+    if (np_run(argv, repo, 0, 20, &r, why, sizeof why)) { np_free(&r); return -1; }
+    rc = r.rc;
+    if (out && cap > 0) {
+        n = r.outn < (size_t)(cap - 1) ? r.outn : (size_t)(cap - 1);
+        if (n) mm_copy(out, cap, r.out, (long)n);
+        out[n] = 0;
+        while (n && (out[n - 1] == '\n' || out[n - 1] == '\r')) out[--n] = 0;
+    }
+    np_free(&r);
+    return rc;
+}
+
+static int fc_check_env(char *why, size_t cap) {
+    extern char **environ;
+    static const char *leak[] = {"UNISACC_RUN_CACHE", "UNISACC_CACHE_DIR", "UNISACC_FREEZE_NO_FETCH", 0};
+    static const char *ok[] = {
+        "UNISACC_IDENT_HELPER", "UNISACC_PREP_CACHE", "UNISACC_DEVSVC_DIR", "UNISACC_TMPDIR",
+        "UNISACC_BATCH_TIMES", "UNISACC_COMMIT_OWN_RUN", "UNISACC_BOUND_DEADLINE_MONO",
+        "UNISACC_INTEGRATOR", 0
+    };
+    why[0] = 0;
+    for (int i = 0; leak[i]; i++) {
+        const char *v = getenv(leak[i]);
+        if (v != 0) { cx_fmt(why, cap, "var=%s", leak[i]); return 0; }
+    }
+    for (char **ep = environ; ep && *ep; ep++) {
+        const char *eq; long kl; int known = 0;
+        if (strncmp(*ep, "UNISACC_", 8)) continue;
+        eq = strchr(*ep, '='); kl = eq ? (long)(eq - *ep) : (long)strlen(*ep);
+        for (int oi = 0; ok[oi]; oi++) if ((long)strlen(ok[oi]) == kl && !memcmp(*ep, ok[oi], (size_t)kl)) known = 1;
+        if (!known) { cx_fmt(why, cap, "var=%.*s", (int)kl, *ep); return 0; }
+    }
+    return 1;
+}
