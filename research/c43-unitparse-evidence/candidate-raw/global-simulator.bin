.unit 2
.global g_count
.bss g_count 4
.gdef g_count
.bss g_hidden 4
.global get
get:
  .frame 8
  store64 [r7+0], r6
  mov r6, r7
  .frame      0
  .lea r0, g_count
  .ld r0, [r0+0], 4
  .frame 8
  store64 [r7+0], r0
  .lea r0, g_hidden
  .ld r0, [r0+0], 4
  load64 r1, [r7+0]
  .frame -8
  add64 r0, r1, r0
  .frame 8
  .st [r7+0], r0, 4
  .ld r0, [r7+0], 4
  .frame -8
  jump __unisacc_R1
__unisacc_R1:
  mov r7, r6
  load64 r6, [r7+0]
  .frame -8
  ret
.global __init_u
__init_u:
  imm r0, 3
  .lea r1, g_count
  .st [r1+0], r0, 4
  ret
__main_ret:
  .exit r0
