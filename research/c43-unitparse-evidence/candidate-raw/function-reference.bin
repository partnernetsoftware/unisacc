.unit 2
.global twice
twice:
  .frame 8
  store64 [r7+0], r6
  mov r6, r7
  .frame      8
  store64 [r6-8], r0
  imm r2, 8
  sub64 r0, r6, r2
  .ld r0, [r0+0], 4
  .frame 8
  store64 [r7+0], r0
  imm r0, 2
  load64 r1, [r7+0]
  .frame -8
  mul64 r0, r1, r0
  .frame 8
  .st [r7+0], r0, 4
  .ld r0, [r7+0], 4
  .frame -8
  jump __unisacc_R1
__unisacc_R1:
  mov r7, r6
  load64 r6, [r7+0]
  .frame -8
  ret
.global __init_u
__init_u:
  ret
__main_ret:
  .exit r0
