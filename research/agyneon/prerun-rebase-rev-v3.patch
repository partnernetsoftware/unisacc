index 0000000..f9d924e
--- /dev/null
+++ b/tools/check-prerun-rebase.cx
@@ -0,0 +1,184 @@
+/* tools/check-prerun-rebase.cx -- table-driven check for prerun-drive rebase-rev. */
+#pragma unisa use sys.fs
+#pragma unisa use sys.posix
+#pragma unisa use sys.env
+#pragma unisa use sysx.run
+
+static int failed;
+static int rows;
+static int asserted;
+
+static void sh_run(const char *cwd, const char *cmd) {
+    px_opts o;
+    px_result r;
+    char *av[4];
+    av[0] = "sh"; av[1] = "-c"; av[2] = (char *)cmd; av[3] = 0;
+    px_opts_init(&o); o.argv = av; o.cwd = cwd; o.deadline_ms = 5000;
+    px_run(&o, &r);
+    px_result_free(&r);
+}
+
+static int parse_kv_int(const char *s, const char *key) {
+    char pat[64];
+    int i, j, plen;
+    cx_fmt(pat, sizeof pat, "\t%s=", key);
+    plen = (int)strlen(pat);
+    for (i = 0; s[i]; i++) {
+        for (j = 0; j < plen && s[i + j] == pat[j]; j++) {}
+        if (j == plen) return atoi(s + i + plen);
+    }
+    return -1;
+}
+
+static void verify_case(char **cols, const char *repo) {
+    const char *id = cols[0];
+    int exp_rc = atoi(cols[1]);
+    const char *exp_tag = cols[2];
+    int exp_ret = atoi(cols[3]);
+    int exp_rer = atoi(cols[4]);
+    char outd[512], revf[512], cmd[1024];
+    px_opts o;
+    px_result r;
+    char *av[4];
+    int rc, obs_ret = -1, obs_rer = -1, ok;
+
+    cx_fmt(outd, sizeof outd, "%s/out_%s", repo, id);
+    sh_run(repo, "git checkout -q base");
+    if (strcmp(id, "non_ancestor_refused") == 0) {
+        cx_fmt(cmd, sizeof cmd, "mkdir -p '%s' && git rev-parse side > '%s/frozen-source.rev'", outd, outd);
+        sh_run(repo, cmd);
+        sh_run(repo, "git checkout -q goodpath");
+    } else if (strcmp(id, "disallowed_path_refused") == 0) {
+        cx_fmt(cmd, sizeof cmd, "mkdir -p '%s' && git rev-parse base > '%s/frozen-source.rev'", outd, outd);
+        sh_run(repo, cmd);
+        sh_run(repo, "git checkout -q badpath");
+    } else if (strcmp(id, "sid_mismatch_refused") == 0) {
+        cx_fmt(cmd, sizeof cmd, "mkdir -p '%s' && git rev-parse base > '%s/frozen-source.rev'", outd, outd);
+        sh_run(repo, cmd);
+        sh_run(repo, "git checkout -q goodpath");
+        setenv("PRERUN_REBASE_SID_BIN", "/bin/echo", 1);
+    } else if (strcmp(id, "single_batch_changed_reruns") == 0) {
+        int i;
+        cx_fmt(cmd, sizeof cmd, "mkdir -p '%s' && git rev-parse base > '%s/frozen-source.rev'", outd, outd);
+        sh_run(repo, cmd);
+        for (i = 0; i < 5; i++) {
+            cx_fmt(cmd, sizeof cmd, "touch '%s/done.W%04d' && printf 'b%d\\tPASS\\t%s\\n' > '%s/strict-W%04d.tsv'",
+                   outd, i, i, i == 2 ? "tests/ok.txt" : "tests/other.txt", outd, i);
+            sh_run(repo, cmd);
+        }
+        sh_run(repo, "git checkout -q goodpath");
+    } else if (strcmp(id, "sampling_10pct_floor") == 0) {
+        int i;
+        cx_fmt(cmd, sizeof cmd, "mkdir -p '%s' && git rev-parse base > '%s/frozen-source.rev'", outd, outd);
+        sh_run(repo, cmd);
+        for (i = 0; i < 10; i++) {
+            cx_fmt(cmd, sizeof cmd, "touch '%s/done.W%04d' && printf 'b%d\\tPASS\\ttests/other.txt\\n' > '%s/strict-W%04d.tsv'",
+                   outd, i, i, outd, i);
+            sh_run(repo, cmd);
+        }
+        sh_run(repo, "git checkout -q goodpath");
+    } else if (strcmp(id, "replay_c7_to_c10_disallowed_posix") == 0) {
+        cx_fmt(cmd, sizeof cmd, "mkdir -p '%s' && git rev-parse base > '%s/frozen-source.rev'", outd, outd);
+        sh_run(repo, cmd);
+        sh_run(repo, "git checkout -q posixbad");
+    } else if (strcmp(id, "replay_c9b_to_c10_scale_20") == 0) {
+        int i;
+        cx_fmt(cmd, sizeof cmd, "mkdir -p '%s' && git rev-parse base > '%s/frozen-source.rev'", outd, outd);
+        sh_run(repo, cmd);
+        for (i = 0; i < 20; i++) {
+            const char *st = (i == 3) ? "FAIL" : "PASS";
+            const char *f = (i == 2) ? "tests/daily-compile-smoke.tsv" : "tests/other.txt";
+            cx_fmt(cmd, sizeof cmd, "touch '%s/done.W%04d' && printf 'b%d\\t%s\\t%s\\n' > '%s/strict-W%04d.tsv'",
+                   outd, i, i, st, f, outd, i);
+            sh_run(repo, cmd);
+        }
+        sh_run(repo, "git checkout -q c10good");
+    }
+    (void)revf;
+    cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/prerun-drive.cx -- rebase-rev --root '%s' --out '%s' --new-rev HEAD", repo, outd);
+    av[0] = "sh"; av[1] = "-c"; av[2] = cmd; av[3] = 0;
+    px_opts_init(&o); o.argv = av; o.deadline_ms = 40000; o.merge_err = 1;
+    rc = px_run(&o, &r);
+    unsetenv("PRERUN_REBASE_SID_BIN");
+    if (rc == 0) rc = r.code != 0 ? 1 : 0; else rc = 1;
+    if (r.out && exp_rc == 0) {
+        obs_ret = parse_kv_int(r.out, "retained");
+        obs_rer = parse_kv_int(r.out, "rerun");
+    }
+    ok = (rc == exp_rc) && (r.out && strstr(r.out, exp_tag) != 0) && (obs_ret == exp_ret) && (obs_rer == exp_rer);
+    if (ok && exp_rc == 0) {
+        sy_dir_t d;
+        int actual_done = 0;
+        size_t rsz = 0;
+        char *rtxt;
+        cx_fmt(revf, sizeof revf, "%s/frozen-source.rev", outd);
+        rtxt = cx_read(revf, &rsz);
+        if (!rtxt || rsz < 40 || strncmp(rtxt, "HEAD", 4) == 0) ok = 0;
+        if (rtxt) free(rtxt);
+        if (sy_dir_open(&d, outd) == 0) {
+            while (sy_dir_next(&d) == 1) {
+                if (strncmp(d.name, "done.W", 6) == 0) actual_done++;
+            }
+            sy_dir_close(&d);
+        }
+        if (actual_done != obs_ret) ok = 0;
+    }
+    asserted++;
+    if (ok) printf("PASS\t%s\n", id);
+    else {
+        printf("FAIL\t%s\twant=(%d,%s,%d,%d)\tobs=(%d,%d,%d)\n", id, exp_rc, exp_tag, exp_ret, exp_rer, rc, obs_ret, obs_rer);
+        failed++;
+    }
+    px_result_free(&r);
+}
+
+int main(void) {
+    char repo[512], cmd[4096];
+    size_t sz = 0;
+    char *txt, *p, *nl;
+    int line_no = 0;
+
+    cx_fmt(repo, sizeof repo, "%s/prerun-rebase-test-%d", sy_tmpdir(), (int)getpid());
+    cx_fmt(cmd, sizeof cmd,
+           "rm -rf '%s' && mkdir -p '%s/tests' '%s/cx/sys' '%s/ext' '%s/src' '%s/include' && "
+           "cd '%s' && git init -q && git config user.email t@t && git config user.name t && "
+           "touch tests/ok.txt tests/other.txt tests/daily-compile-smoke.tsv cx/sys/proc.cx cx/sys/posix.cx ext/a src/a include/a && "
+           "git add -A && git commit -q -m init && git branch -M base && "
+           "git checkout -q -b side && echo x > tests/side.txt && git add -A && git commit -q -m side && "
+           "git checkout -q base && git checkout -q -b badpath && echo x > cx/sys/proc.cx && git add -A && git commit -q -m bad && "
+           "git checkout -q base && git checkout -q -b posixbad && echo x > cx/sys/posix.cx && git add -A && git commit -q -m pbad && "
+           "git checkout -q base && git checkout -q -b goodpath && echo x > tests/ok.txt && git add -A && git commit -q -m good && "
+           "git checkout -q base && git checkout -q -b c10good && echo x > tests/daily-compile-smoke.tsv && git add -A && git commit -q -m c10",
+           repo, repo, repo, repo, repo, repo, repo);
+    sh_run(0, cmd);
+
+    txt = cx_read("tools/prerun-rebase-cases.tsv", &sz);
+    if (!txt) { printf("FAIL\tmissing tools/prerun-rebase-cases.tsv\n"); return 1; }
+    p = txt;
+    while (*p) {
+        nl = strchr(p, '\n');
+        if (nl) *nl = 0;
+        if (line_no > 0 && p[0]) {
+            char *cols[8];
+            int nc = 0;
+            char *q = p;
+            cols[nc++] = q;
+            while (*q && nc < 8) {
+                if (*q == '\t') { *q = 0; cols[nc++] = q + 1; }
+                q++;
+            }
+            rows++;
+            if (nc >= 5) verify_case(cols, repo);
+            else { printf("FAIL\tbad_row_%s\n", cols[0]); failed++; }
+        }
+        line_no++;
+        if (!nl) break;
+        p = nl + 1;
+    }
+    free(txt);
+    cx_fmt(cmd, sizeof cmd, "rm -rf '%s'", repo);
+    sh_run(0, cmd);
+    if (rows != asserted) { printf("FAIL\tmismatch rows=%d asserted=%d\n", rows, asserted); failed++; }
+    printf("CHECK_PRERUN_REBASE\trows=%d\tasserted=%d\tfailed=%d\n", rows, asserted, failed);
+    return failed ? 1 : 0;
+}
