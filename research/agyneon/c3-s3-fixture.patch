--- /dev/null
+++ b/tools/check-proc-s3.cx
@@ -0,0 +1,279 @@
+/* tools/check-proc-s3.cx -- S3 table-driven check against tools/proc-s3-transitions.tsv. */
+#pragma unisa use sys.proc
+#pragma unisa use sys.posix
+#pragma unisa use sys.fs
+#pragma unisa use sys.time
+#pragma unisa use sysx.run
+
+static int failed;
+static int rows;
+static int asserted;
+
+static int parse_rc(const char *s) {
+    if (strcmp(s, "0") == 0) return 0;
+    if (strcmp(s, "-ECHILD") == 0) return -ECHILD;
+    if (strcmp(s, "-EINTR") == 0) return -EINTR;
+    if (strcmp(s, "-ETIMEDOUT") == 0) return -ETIMEDOUT;
+    if (strcmp(s, "-EPERM") == 0) return -EPERM;
+    if (strcmp(s, "-ESRCH") == 0) return -ESRCH;
+    return -99999;
+}
+
+static void verify_row(const char *id, const char *exp_nslot, const char *exp_rc, const char *exp_exit, const char *exp_rel,
+                       int obs_rc, const char *obs_nslot, const char *obs_exit, int obs_rel) {
+    int want_rc = parse_rc(exp_rc);
+    int want_rel = (strcmp(exp_rel, "yes") == 0) ? 1 : 0;
+    int ok = (obs_rc == want_rc) && (strcmp(obs_nslot, exp_nslot) == 0) &&
+             (strcmp(obs_exit, exp_exit) == 0) && (obs_rel == want_rel);
+    asserted++;
+    if (ok) {
+        printf("PASS\t%s\n", id);
+    } else {
+        printf("FAIL\t%s\twant=(%s,%d,%s,%d)\tobs=(%s,%d,%s,%d)\n",
+               id, exp_nslot, want_rc, exp_exit, want_rel, obs_nslot, obs_rc, obs_exit, obs_rel);
+        failed++;
+    }
+}
+
+static const char *slot_name_from_stats(int live, int ab, int lost) {
+    if (lost > 0 && ab > 0) return "LOST_ABANDONED";
+    if (lost > 0) return "LOST_LIVE";
+    if (ab > 0) return "ABANDONED";
+    if (live > 0) return "LIVE";
+    return "FREE";
+}
+
+static int run_case(char **cols) {
+    const char *id = cols[0];
+    const char *exp_nslot = cols[5];
+    const char *exp_rc = cols[7];
+    const char *exp_exit = cols[8];
+    const char *exp_rel = cols[9];
+    sy_spawn_t sp;
+    sy_child_t c;
+    sy_exit_t st;
+    px_opts o;
+    px_result r;
+    char *av_sleep[3];
+    int rc, live = 0, ab = 0, lost = 0;
+
+    av_sleep[0] = "sleep"; av_sleep[1] = "0.2"; av_sleep[2] = 0;
+    sy_proc_test_reset();
+
+    if (strcmp(id, "px_run_ok") == 0) {
+        char *av4[4];
+        av4[0] = "sh"; av4[1] = "-c"; av4[2] = "exit 7"; av4[3] = 0;
+        px_opts_init(&o); o.argv = av4; o.deadline_ms = 2000;
+        rc = px_run(&o, &r);
+        sy_proc_own_stats(&live, &ab, &lost);
+        verify_row(id, exp_nslot, exp_rc, exp_exit, exp_rel,
+                   rc, slot_name_from_stats(live, ab, lost), (r.code == 7 && r.timed_out == 0) ? "real" : "bad", (live + ab + lost) == 0);
+        px_result_free(&r);
+        return 1;
+    }
+    if (strcmp(id, "px_run_kill_tree_zero_residue") == 0) {
+        char *av4[4];
+        av4[0] = "sh"; av4[1] = "-c"; av4[2] = "setsid sleep 5 >/dev/null 2>&1 & wait"; av4[3] = 0;
+        px_opts_init(&o); o.argv = av4; o.deadline_ms = 30; o.kill_tree = 1;
+        rc = px_run(&o, &r);
+        sy_proc_own_stats(&live, &ab, &lost);
+        verify_row(id, exp_nslot, exp_rc, exp_exit, exp_rel,
+                   rc, slot_name_from_stats(live, ab, lost), (r.timed_out == 1 && r.code == 124 && r.residue == 0) ? "real_timed_out" : "bad", (live + ab + lost) == 0);
+        px_result_free(&r);
+        return 1;
+    }
+    if (strcmp(id, "px_run_notree_timeout") == 0) {
+        px_opts_init(&o); o.argv = av_sleep; o.deadline_ms = 20; o.kill_tree = 0;
+        rc = px_run(&o, &r);
+        sy_proc_own_stats(&live, &ab, &lost);
+        verify_row(id, exp_nslot, exp_rc, exp_exit, exp_rel,
+                   rc, slot_name_from_stats(live, ab, lost), (r.timed_out == 1 && r.code == 124 && r.residue == -1) ? "real_timed_out" : "bad", (live + ab + lost) == 0);
+        px_result_free(&r);
+        return 1;
+    }
+    if (strcmp(id, "px_run_try_wait_echild") == 0) {
+        sy_proc_test_inject_syscall(1, 0, 1, ECHILD);
+        px_opts_init(&o); o.argv = av_sleep; o.deadline_ms = 500;
+        rc = px_run(&o, &r);
+        sy_proc_own_stats(&live, &ab, &lost);
+        verify_row(id, exp_nslot, exp_rc, exp_exit, exp_rel,
+                   rc, lost > 0 ? "LOST_ABANDONED" : "OTHER", (r.code == 0 && r.timed_out == 0) ? "zeroed" : "bad", (live + ab + lost) == 0);
+        px_result_free(&r);
+        sy_proc_test_reset();
+        sy_proc_own_drain(200);
+        return 1;
+    }
+    if (strcmp(id, "px_run_try_wait_eintr") == 0) {
+        setenv("UNISACC_PROC_INJECT_WAIT_ERR", "1", 1);
+        px_opts_init(&o); o.argv = av_sleep; o.deadline_ms = 500;
+        rc = px_run(&o, &r);
+        unsetenv("UNISACC_PROC_INJECT_WAIT_ERR");
+        sy_proc_own_stats(&live, &ab, &lost);
+        verify_row(id, exp_nslot, exp_rc, exp_exit, exp_rel,
+                   rc, slot_name_from_stats(live, ab, lost), (r.code == 0 && r.timed_out == 0) ? "zeroed" : "bad", (live + ab + lost) == 0);
+        px_result_free(&r);
+        sy_proc_own_drain(200);
+        return 1;
+    }
+    if (strcmp(id, "px_run_end_timeout") == 0) {
+        sy_proc_test_inject_syscall(1, 0, 90, 0);
+        px_opts_init(&o); o.argv = av_sleep; o.deadline_ms = 20;
+        rc = px_run(&o, &r);
+        sy_proc_own_stats(&live, &ab, &lost);
+        verify_row(id, exp_nslot, exp_rc, exp_exit, exp_rel,
+                   rc, slot_name_from_stats(live, ab, lost), (r.code == 0 && r.timed_out == 0) ? "zeroed" : "bad", (live + ab + lost) == 0);
+        px_result_free(&r);
+        sy_proc_test_reset();
+        sy_proc_own_drain(200);
+        return 1;
+    }
+    if (strcmp(id, "px_run_end_eperm") == 0) {
+        sy_proc_test_inject_syscall(2, 0, 3, EPERM);
+        sy_proc_test_inject_syscall(1, 0, 90, 0);
+        px_opts_init(&o); o.argv = av_sleep; o.deadline_ms = 20; o.kill_tree = 0;
+        rc = px_run(&o, &r);
+        sy_proc_own_stats(&live, &ab, &lost);
+        verify_row(id, exp_nslot, exp_rc, exp_exit, exp_rel,
+                   rc, slot_name_from_stats(live, ab, lost), (r.code == 0 && r.timed_out == 0) ? "zeroed" : "bad", (live + ab + lost) == 0);
+        px_result_free(&r);
+        sy_proc_test_reset();
+        sy_proc_own_drain(200);
+        return 1;
+    }
+    if (strcmp(id, "sy_proc_wait_deadline_reaped") == 0) {
+        sy_spawn_init(&sp); sp.argv = av_sleep; sp.deadline_ms = 20;
+        rc = sy_proc_spawn(&sp, &c);
+        rc = (rc == 0) ? sy_proc_wait(&c, &st) : rc;
+        sy_proc_own_stats(&live, &ab, &lost);
+        verify_row(id, exp_nslot, exp_rc, exp_exit, exp_rel,
+                   rc, slot_name_from_stats(live, ab, lost), st.timed_out == 1 ? "real_timed_out" : "bad", (live + ab + lost) == 0);
+        sy_proc_close(&c);
+        return 1;
+    }
+    if (strcmp(id, "sy_proc_wait_deadline_null_st") == 0) {
+        sy_spawn_init(&sp); sp.argv = av_sleep; sp.deadline_ms = 20;
+        rc = sy_proc_spawn(&sp, &c);
+        rc = (rc == 0) ? sy_proc_wait(&c, 0) : rc;
+        sy_proc_own_stats(&live, &ab, &lost);
+        verify_row(id, exp_nslot, exp_rc, exp_exit, exp_rel,
+                   rc, slot_name_from_stats(live, ab, lost), (sy_proc_try_wait(&c, &st) == 1 && st.timed_out == 1) ? "real_timed_out" : "bad", (live + ab + lost) == 0);
+        sy_proc_close(&c);
+        return 1;
+    }
+    if (strcmp(id, "sy_proc_wait_deadline_exhausted") == 0) {
+        sy_spawn_init(&sp); sp.argv = av_sleep; sp.deadline_ms = 20;
+        rc = sy_proc_spawn(&sp, &c);
+        sy_proc_test_inject_syscall(1, c.pid, 50, 0);
+        rc = (rc == 0) ? sy_proc_wait(&c, &st) : rc;
+        sy_proc_own_stats(&live, &ab, &lost);
+        verify_row(id, exp_nslot, exp_rc, exp_exit, exp_rel,
+                   rc, slot_name_from_stats(live, ab, lost), st.timed_out == 0 ? "zeroed" : "bad", (live + ab + lost) == 0);
+        sy_proc_test_reset();
+        sy_proc_end(&c, 200, &st);
+        sy_proc_close(&c);
+        return 1;
+    }
+    if (strcmp(id, "sy_proc_wait_deadline_kill_eperm") == 0) {
+        sy_spawn_init(&sp); sp.argv = av_sleep; sp.deadline_ms = 20;
+        rc = sy_proc_spawn(&sp, &c);
+        sy_proc_test_inject_syscall(2, c.pid, 1, EPERM);
+        rc = (rc == 0) ? sy_proc_wait(&c, &st) : rc;
+        sy_proc_own_stats(&live, &ab, &lost);
+        verify_row(id, exp_nslot, exp_rc, exp_exit, exp_rel,
+                   rc, slot_name_from_stats(live, ab, lost), st.timed_out == 0 ? "zeroed" : "bad", (live + ab + lost) == 0);
+        sy_proc_test_reset();
+        sy_proc_end(&c, 200, &st);
+        sy_proc_close(&c);
+        return 1;
+    }
+    if (strcmp(id, "sy_proc_wait_deadline_wait_echild") == 0) {
+        sy_spawn_init(&sp); sp.argv = av_sleep; sp.deadline_ms = 20;
+        rc = sy_proc_spawn(&sp, &c);
+        sy_proc_test_inject_syscall(1, c.pid, 1, 0);
+        sy_proc_test_inject_syscall(1, c.pid, 1, ECHILD);
+        rc = (rc == 0) ? sy_proc_wait(&c, &st) : rc;
+        sy_proc_own_stats(&live, &ab, &lost);
+        verify_row(id, exp_nslot, exp_rc, exp_exit, exp_rel,
+                   rc, slot_name_from_stats(live, ab, lost), st.timed_out == 0 ? "zeroed" : "bad", (live + ab + lost) == 0);
+        sy_proc_test_reset();
+        sy_proc_close(&c);
+        sy_proc_own_drain(200);
+        return 1;
+    }
+    if (strcmp(id, "sy_proc_wait_deadline_kill_esrch_reap") == 0) {
+        char *av_short[3];
+        av_short[0] = "sleep"; av_short[1] = "0.1"; av_short[2] = 0;
+        sy_spawn_init(&sp); sp.argv = av_short; sp.deadline_ms = 20;
+        rc = sy_proc_spawn(&sp, &c);
+        sy_proc_test_inject_syscall(2, c.pid, 1, ESRCH);
+        rc = (rc == 0) ? sy_proc_wait(&c, &st) : rc;
+        sy_proc_own_stats(&live, &ab, &lost);
+        verify_row(id, exp_nslot, exp_rc, exp_exit, exp_rel,
+                   rc, slot_name_from_stats(live, ab, lost), st.timed_out == 1 ? "real_timed_out" : "bad", (live + ab + lost) == 0);
+        sy_proc_close(&c);
+        return 1;
+    }
+    if (strcmp(id, "sy_proc_wait_no_deadline_long") == 0) {
+        char *av_long[3];
+        long t0, dt;
+        av_long[0] = "sleep"; av_long[1] = "0.35"; av_long[2] = 0;
+        sy_spawn_init(&sp); sp.argv = av_long; sp.deadline_ms = 0;
+        t0 = sy_now_ms();
+        rc = sy_proc_spawn(&sp, &c);
+        rc = (rc == 0) ? sy_proc_wait(&c, &st) : rc;
+        dt = sy_now_ms() - t0;
+        sy_proc_own_stats(&live, &ab, &lost);
+        verify_row(id, exp_nslot, exp_rc, exp_exit, exp_rel,
+                   rc, slot_name_from_stats(live, ab, lost), (dt >= 300 && st.timed_out == 0) ? "real" : "bad", (live + ab + lost) == 0);
+        sy_proc_close(&c);
+        return 1;
+    }
+    if (strcmp(id, "px_run_timeout_no_grace_sleep") == 0) {
+        px_opts_init(&o); o.argv = av_sleep; o.deadline_ms = 30; o.kill_tree = 1;
+        rc = px_run(&o, &r);
+        sy_proc_own_stats(&live, &ab, &lost);
+        verify_row(id, exp_nslot, exp_rc, exp_exit, exp_rel,
+                   rc, slot_name_from_stats(live, ab, lost), (r.code == 124 && r.timed_out == 1 && r.wall_ms < 180) ? "real_timed_out" : "bad", (live + ab + lost) == 0);
+        px_result_free(&r);
+        return 1;
+    }
+    return 0;
+}
+
+int main(void) {
+    size_t sz = 0;
+    char *txt = cx_read("tools/proc-s3-transitions.tsv", &sz);
+    char *p, *nl;
+    int line_no = 0;
+    if (!txt) { printf("FAIL\tmissing tools/proc-s3-transitions.tsv\n"); return 1; }
+    p = txt;
+    while (*p) {
+        nl = strchr(p, '\n');
+        if (nl) *nl = 0;
+        if (line_no > 0 && p[0]) {
+            char *cols[16];
+            int nc = 0;
+            char *q = p;
+            cols[nc++] = q;
+            while (*q && nc < 16) {
+                if (*q == '\t') { *q = 0; cols[nc++] = q + 1; }
+                q++;
+            }
+            rows++;
+            if (nc < 10 || !run_case(cols)) {
+                printf("FAIL\tunhandled_row_%s\n", cols[0]);
+                failed++;
+            }
+        }
+        line_no++;
+        if (!nl) break;
+        p = nl + 1;
+    }
+    free(txt);
+    if (rows != asserted) {
+        printf("FAIL\trow_assertion_mismatch rows=%d asserted=%d\n", rows, asserted);
+        failed++;
+    }
+    printf("CHECK_PROC_S3\trows=%d\tasserted=%d\tfailed=%d\n", rows, asserted, failed);
+    return failed ? 1 : 0;
+}
