int main(void){const char *d="/Users/wjc/repos/unisacc/out/c48-base-incremental/rehearsal-v2";char p[8192],bak[8192],exe[8192],out[8192];cx_fmt(p,sizeof p,"%s/compare-00.tsv",d);cx_fmt(bak,sizeof bak,"%s/compare-00.original",d);cx_fmt(exe,sizeof exe,"%s/controller-shards.exe",d);cx_fmt(out,sizeof out,"%s/tamper-must-not-publish.tsv",d);struct stat st;errno=0;if(!lstat(bak,&st)||errno!=ENOENT)return 2;errno=0;if(!lstat(out,&st)||errno!=ENOENT)return 2;size_t n;char *s=cx_read(p,&n);if(!s||n<50)return 2;char *at=strstr(s,"claim=frozen-run-stage-proof");if(!at)return 2;at[6]='X';if(rename(p,bak))return 2;if(cx_write(p,s,n)){rename(bak,p);return 2;}char *a[]={exe,"report",(char*)d,out,0};np_result r={0};char why[300];int tr=np_run(a,"/Users/wjc/repos/unisacc",0,40,&r,why,sizeof why);int ur=unlink(p),rr=rename(bak,p);errno=0;int missing=lstat(out,&st)&&errno==ENOENT;printf("SHARD_TAMPER\ttransport=%d\trc=%d\tno_output=%d\trestored=%d\n",tr,r.rc,missing,!ur&&!rr);if(r.err)fwrite(r.err,1,r.errn,stdout);int ok=!tr&&r.rc==2&&missing&&!ur&&!rr;np_free(&r);free(s);return ok?0:1;}
