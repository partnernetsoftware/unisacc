+static int scan_literal_tree(const char *path, np_buf *rows) {
+    sy_dir_t dir;
+    int got;
+    if (sy_dir_open(&dir, path)) return -1;
+    while ((got = sy_dir_next(&dir)) == 1) {
+        char rel[512];
+        size_t n = strlen(dir.name);
+        if (!strcmp(dir.name, ".") || !strcmp(dir.name, "..")) continue;
+        if (cx_fmt(rel, sizeof rel, "%s/%s", path, dir.name)) { got = -1; break; }
+        if (dir.kind == 'd') {
+            if (scan_literal_tree(rel, rows)) { got = -1; break; }
+        } else if (dir.kind == 'f' &&
+                   ((n >= 3 && !strcmp(dir.name + n - 3, ".cx")) ||
+                    (n >= 2 && (!strcmp(dir.name + n - 2, ".c") || !strcmp(dir.name + n - 2, ".h")))) &&
+                   strcmp(rel, "tools/check-batch-cap.cx")) {
+            size_t sn = 0;
+            char *src = cx_read(rel, &sn);
+            if (!src) { got = -1; break; }
+            int rc = scan_literal_lines(rel, src, rows);
+            free(src);
+            if (rc) { got = -1; break; }
+        }
+    }
+    sy_dir_close(&dir);
+    return got < 0 ? -1 : 0;
+}
+
+static int sort_line(const void *a, const void *b) {
+    return strcmp(*(char *const *)a, *(char *const *)b);
+}
+
+static char **literal_rows(char *buf, size_t n, size_t *used) {
+    size_t capacity = 1;
+    for (size_t i = 0; i < n; i++) if (buf[i] == '\n') capacity++;
+    char **rows = calloc(capacity, sizeof *rows);
+    *used = 0;
+    if (!rows) return 0;
+    for (char *p = buf; p && *p;) {
+        char *end = strchr(p, '\n');
+        if (end) *end++ = 0;
+        if (*p != '#') rows[(*used)++] = p;
+        p = end;
+    }
+    qsort(rows, *used, sizeof *rows, sort_line);
+    return rows;
+}
