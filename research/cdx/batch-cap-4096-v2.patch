diff --git a/tools/check-batch-cap.cx b/tools/check-batch-cap.cx
new file mode 100644
index 000000000..3abb4082c
--- /dev/null
+++ b/tools/check-batch-cap.cx
@@ -0,0 +1,884 @@
+/* tools/check-batch-cap.cx -- Single-source batch/tool-source capacity (4096) verification.
+ *
+ * With no arguments, check the source inventory and library bounds.
+ * --case and --s9-case 2100|4000|4097 exercise separate registered CLI shards.
+ * --emit-literals prints the current literal inventory for review.
+ * Verifies:
+ *   (1) Single source of truth in tools/cxlib/testplan.cx (TP_BATCH_CAP = 4096, TP_TOOL_SRC_CAP = 4096)
+ *       anchored in exec/facts/limits.tsv.
+ *   (2) Token-level consistency across all 18 batch/tool-source consumers, plus individual mutation
+ *       checks (mutating each consumer site back to 2048 MUST fail).
+ *   (3) Inventory all code occurrences of 2048 and numeric MAX declarations under tools/ and tests.
+ *       Each existing occurrence is listed in tests/batch-cap-literals.tsv; new occurrences fail closed.
+ *   (4) In-process tp_visit (2100/4000 PASS, 4097 table-limit REFUSE) and cxlib.s9sched ss_buf
+ *       production max-width S9_PENDING boundary (2100/4096 PASS, 4097 REFUSE).
+ *   (5) Real CLI entrypoints (tests/run.cx --list, tools/affected.cx, tools/all-waves.cx pending,
+ *       tools/s9-shards.cx pending, tools/s9-shards-flow.cx emit) at 2100, 4000 (PASS) and 4097 (REFUSE).
+ *
+ * Output ends with: CHECK_BATCH_CAP<TAB>passed=P<TAB>failed=F
+ */
+#pragma unisa use cxlib.testplan
+#pragma unisa use cxlib.s9sched
+#pragma unisa use cxlib.netpack
+#pragma unisa use sys.fs
+#pragma unisa use sys.posix
+#pragma unisa use sys.io
+#pragma unisa use sys.env
+#pragma unisa use sys.sha
+#pragma unisa use text.text
+#pragma unisa use mem.bytes
+#pragma unisa use mem.heap
+
+static int g_pass = 0;
+static int g_fail = 0;
+static char g_root[4096];
+
+static void bck(int cond, const char *name) {
+    if (cond) {
+        g_pass++;
+        sy_printf("PASS\tcheck-batch-cap.%s\n", name);
+    } else {
+        g_fail++;
+        sy_printf("FAIL\tcheck-batch-cap.%s\n", name);
+    }
+    fflush(stdout);
+}
+
+static int is_id_ch(char c) {
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+           (c >= '0' && c <= '9') || c == '_';
+}
+
+/* Strip C comments and string/char literals while preserving line count and spacing. */
+static char *strip_code(const char *src) {
+    size_t n = strlen(src);
+    char *out = (char *)mm_alloc((long)(n + 1));
+    if (!out) return 0;
+    size_t i = 0, o = 0;
+    while (i < n) {
+        if (src[i] == '/' && i + 1 < n && src[i + 1] == '/') {
+            while (i < n && src[i] != '\n') i++;
+            continue;
+        }
+        if (src[i] == '/' && i + 1 < n && src[i + 1] == '*') {
+            i += 2;
+            while (i + 1 < n && !(src[i] == '*' && src[i + 1] == '/')) {
+                if (src[i] == '\n') out[o++] = '\n';
+                i++;
+            }
+            if (i + 1 < n) i += 2;
+            out[o++] = ' ';
+            continue;
+        }
+        if (src[i] == '"' || src[i] == '\'') {
+            char q = src[i++];
+            out[o++] = ' ';
+            while (i < n && src[i] != q) {
+                if (src[i] == '\\' && i + 1 < n) i += 2;
+                else { if (src[i] == '\n') out[o++] = '\n'; i++; }
+            }
+            if (i < n) i++;
+            out[o++] = ' ';
+            continue;
+        }
+        out[o++] = src[i++];
+    }
+    out[o] = 0;
+    return out;
+}
+
+static int has_token_seq(const char *code, const char *t1, const char *t2, const char *t3) {
+    const char *p = code;
+    size_t l1 = strlen(t1), l2 = t2 ? strlen(t2) : 0, l3 = t3 ? strlen(t3) : 0;
+    while (*p) {
+        while (*p && (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r')) p++;
+        if (!*p) break;
+        const char *q = p;
+        int match = 0;
+        if (is_id_ch(t1[0])) {
+            size_t k = 0;
+            while (is_id_ch(q[k])) k++;
+            if (k == l1 && !memcmp(q, t1, l1)) { match = 1; q += k; }
+        } else {
+            if (!strncmp(q, t1, l1)) { match = 1; q += l1; }
+        }
+        if (match && t2) {
+            while (*q == ' ' || *q == '\t' || *q == '\n' || *q == '\r') q++;
+            if (is_id_ch(t2[0])) {
+                size_t k = 0;
+                while (is_id_ch(q[k])) k++;
+                if (k == l2 && !memcmp(q, t2, l2)) q += k; else match = 0;
+            } else {
+                if (!strncmp(q, t2, l2)) q += l2; else match = 0;
+            }
+        }
+        if (match && t3) {
+            while (*q == ' ' || *q == '\t' || *q == '\n' || *q == '\r') q++;
+            if (is_id_ch(t3[0])) {
+                size_t k = 0;
+                while (is_id_ch(q[k])) k++;
+                if (k == l3 && !memcmp(q, t3, l3)) q += k; else match = 0;
+            } else {
+                if (!strncmp(q, t3, l3)) q += l3; else match = 0;
+            }
+        }
+        if (match) return 1;
+        if (is_id_ch(*p)) { while (is_id_ch(*p)) p++; }
+        else p++;
+    }
+    return 0;
+}
+
+static int has_use_testplan(const char *src) {
+    return strstr(src, "#pragma unisa use cxlib.testplan") != 0 ||
+           strstr(src, "#pragma unisa use testplan") != 0;
+}
+
+/* Verify consumer idx binds to TP_BATCH_CAP / TP_TOOL_SRC_CAP without 2048/4096 regressions. */
+static int check_consumer_src(int idx, const char *src) {
+    char *c = strip_code(src);
+    if (!c) return 0;
+    int ok = 0;
+    switch (idx) {
+    case 0: /* tools/cxlib/testplan.cx */
+        ok = has_token_seq(c, "TP_BATCH_CAP", "=", "4096") &&
