+    if (sn <= 0 || sn >= (int)sizeof sbuf) return -1;
+    cx_fmt(p, sizeof p, "%s/session.tsv", sess);
+    return sy_write_atomic(p, sbuf, (long)sn, 0600);
+}
+
+static int sign_driver(const char *path) {
+    char receipt[4500], hash[66];
+    size_t n;
+    char *bytes = cx_read(path, &n);
+    if (!bytes) return -1;
+    int rc = sy_sha256_hex(bytes, (long)n, hash);
+    free(bytes);
+    if (rc || cx_fmt(receipt, sizeof receipt, "%s.sha256", path)) return -1;
+    hash[64] = '\n';
+    return sy_write_atomic(receipt, hash, 65, 0600);
+}
+
+/* The real producer rejects an over-capacity registry. Feed its wire format
+ * directly to the emitter to test the latter's independent limit. */
+static int write_overflow_driver(const char *path, int nrows) {
+    char body[4500], pending[4400];
+    int cap = nrows * 224 + 96;
+    char *wire = mm_alloc(cap);
+    if (!wire) return -1;
+    g_s9_want_n = nrows;
+    int rc = mock_s9_list(0, wire, cap);
+    if (!rc && (cx_fmt(pending, sizeof pending, "%s.pending", path) ||
+                sy_write_atomic(pending, wire, (long)strlen(wire), 0600) ||
+                cx_fmt(body, sizeof body, "#!/bin/sh\nexec cat -- '%s'\n", pending) ||
+                sy_write_atomic(path, body, (long)strlen(body), 0700))) rc = -1;
+    mm_free(wire);
+    return rc ? rc : sign_driver(path);
+}
+
+static void count_batch_cb(const tp_batch_view *v, void *ctx) { (void)v; (*(int *)ctx)++; }
+static void count_cov_cb(const tp_coverage_view *v, void *ctx) { (void)v; (void)ctx; }
+
+static void check_cli(int N, int s9) {
+    char tmp[4096];
+    if (sy_mkdtemp(sy_tmpdir(), "unisacc-session-bcap", tmp, sizeof tmp) == 0) {
+        static char obuf[2 << 20];
+        do {
+            int over = (N > 4096);
+            char sdir[4200], sess[4300], driver[4300], mdrv[4300], want[96], tag[96];
+            char affected_src[4400], waves_src[4400], flow_src[4400], flow_out[4400];
+            if (cx_fmt(affected_src, sizeof affected_src, "%s/tools/affected.cx", g_root) ||
+                cx_fmt(waves_src, sizeof waves_src, "%s/tools/all-waves.cx", g_root) ||
+                cx_fmt(flow_src, sizeof flow_src, "%s/tools/s9-shards-flow.cx", g_root)) {
+                bck(0, "cli-source-path");
+                break;
+            }
+            cx_fmt(sdir, sizeof sdir, "%s/tree-%d", tmp, N);
+            cx_fmt(sess, sizeof sess, "%s/sess-%d", tmp, N);
+            cx_fmt(driver, sizeof driver, "%s/driver", tmp);
+            cx_fmt(mdrv, sizeof mdrv, over ? "%s/overflow-driver" : "%s/driver", tmp);
+            int prep_ok = write_synth_tree(sdir, sess, N) == 0;
+            if (prep_ok && s9 && over) prep_ok = write_overflow_driver(mdrv, N) == 0;
+            if (prep_ok && s9) {
+                char *build_driver[] = {"sh", "./unisacc.com", "-o", driver, "tools/s9-shards.cx", 0};
+                int build_rc;
+                (void)run_proc(build_driver, g_root, 30, &build_rc, obuf, sizeof obuf);
+                prep_ok = build_rc == 0 && sign_driver(driver) == 0;
+                if (!prep_ok) sy_printf("NOTE\ts9-driver-build-%d\trc=%d\t%.300s\n", N, build_rc, obuf);
+            }
+            cx_fmt(tag, sizeof tag, "synth-tree-%d", N);
+            bck(prep_ok, tag);
+            if (!prep_ok) break;
+
+            int rc = -1;
+            if (!s9) {
+                /* (5a) tests/run.cx --list */
+                char *av_run[] = {"sh", "./unisacc.com", "tests/run.cx", "--", "--list", 0};
+                (void)run_proc(av_run, sdir, 30, &rc, obuf, sizeof obuf);
+                if (!over) {
+                    cx_fmt(want, sizeof want, "batches=%d\t", N);
+                    cx_fmt(tag, sizeof tag, "cli-run-list-%d", N);
+                    bck(rc == 0 && strstr(obuf, want) != 0, tag);
+                } else {
+                    bck(rc == 2 && strstr(obuf, "table-limit row=4097") != 0, "cli-run-list-refuses-4097");
+                }
+
+                /* (5b) tools/affected.cx */
+                char *av_aff[] = {"sh", "./unisacc.com", affected_src, "--", "--files", "tools/check-batch-cap.cx", 0};
+                (void)run_proc(av_aff, sdir, 30, &rc, obuf, sizeof obuf);
+                if (!over) {
+                    cx_fmt(want, sizeof want, "scanned=%d\t", N);
+                    cx_fmt(tag, sizeof tag, "cli-affected-scan-%d", N);
+                    bck(rc == 0 && strstr(obuf, want) != 0, tag);
+                } else {
+                    bck(rc == 2 && strstr(obuf, "table-limit row=4097") != 0, "cli-affected-refuses-4097");
+                }
+
+                /* (5c) tools/all-waves.cx pending --tier commit */
+                char *av_wp[] = {"sh", "./unisacc.com", waves_src, "--", "pending", sdir, sess, "--tier", "commit", 0};
+                (void)run_proc(av_wp, sdir, 30, &rc, obuf, sizeof obuf);
+                if (!over) {
+                    cx_fmt(want, sizeof want, "PENDING_SUMMARY\tundecided=%d\t", N);
+                    cx_fmt(tag, sizeof tag, "cli-all-waves-pending-%d", N);
+                    bck(rc == 0 && strstr(obuf, want) != 0 && strstr(obuf, "tier-limit") == 0, tag);
+                } else {
+                    bck(rc == 2 && strstr(obuf, "table-limit row=4097") != 0, "cli-all-waves-refuses-4097");
+                }
+
+                break;
+            }
+
+            /* (5d) tools/s9-shards.cx pending (production S9 upstream entry) */
+            char *av_s9[] = {"./tools/bound", "30", driver, "pending", sdir, sess, 0};
+            (void)run_proc(av_s9, sdir, 30, &rc, obuf, sizeof obuf);
+            if (!over) {
+                cx_fmt(tag, sizeof tag, "cli-s9-shards-pending-%d", N);
+                cx_fmt(want, sizeof want, "S9_PENDING_SUMMARY\tpending=%d\tslices=%d", N, N);
+                long wire_n = (long)strlen(obuf);
+                int ok_s9 = rc == 0 && strstr(obuf, want) != 0 && wire_n > (long)N * 128;
+                printf("S9_PENDING_WIRE\trows=%d\tbytes=%ld\tleaf_width=79\n", N, wire_n);
+                bck(ok_s9, tag);
+                if (!ok_s9) sy_printf("NOTE\t%s\trc=%d\thead=%.200s\n", tag, rc, obuf);
+            } else {
+                int ok_s9 = (rc == 2 && strstr(obuf, "REFUSE registry") != 0);
+                bck(ok_s9, "cli-s9-shards-refuses-4097");
+                if (!ok_s9) sy_printf("NOTE\tcli-s9-shards-refuses-4097\trc=%d\thead=%.200s\n", rc, obuf);
+            }
+
+            /* (5e) tools/s9-shards-flow.cx emit (production S9 flow emitter) */
+            if (cx_fmt(flow_out, sizeof flow_out, "%s/flow.tsv", sess)) { bck(0, "s9-flow-path"); break; }
+            char *av_sf[] = {"sh", "./unisacc.com", flow_src, "--", "emit", sdir, sess,
+                             "--driver", mdrv, "--out", flow_out, 0};
+            (void)run_proc(av_sf, sdir, 30, &rc, obuf, sizeof obuf);
+            if (!over) {
+                cx_fmt(want, sizeof want, "emitted=%d\t", N);
+                cx_fmt(tag, sizeof tag, "cli-s9-shards-flow-emit-%d", N);
+                bck(rc == 0 && strstr(obuf, want) != 0, tag);
+            } else {
+                bck(rc == 2 && strstr(obuf, "REFUSE pending-rows") != 0, "cli-s9-shards-flow-refuses-4097");
+            }
+        } while (0);
+        char *rmv[] = {"rm", "-rf", tmp, 0};
+        int rrc = 0;
+        (void)run_proc(rmv, g_root, 10, &rrc, 0, 0);
+    } else {
+        bck(0, "mkdtemp-synth");
+    }
+}
+
+int main(int argc, char **argv) {
+    if (argc == 2 && !strcmp(argv[1], "--emit-literals")) return literal_inventory(1);
+    if (sy_cwd(g_root, sizeof g_root) < 0) return 2;
+    if (argc == 3 && (!strcmp(argv[1], "--case") || !strcmp(argv[1], "--s9-case"))) {
+        int s9 = !strcmp(argv[1], "--s9-case");
+        if (!strcmp(argv[2], "2100")) check_cli(2100, s9);
+        else if (!strcmp(argv[2], "4000")) check_cli(4000, s9);
+        else if (!strcmp(argv[2], "4097")) check_cli(4097, s9);
+        else return 2;
+        sy_printf("CHECK_BATCH_CAP\tpassed=%d\tfailed=%d\n", g_pass, g_fail);
+        return g_fail ? 1 : 0;
+    }
+    if (argc != 1) return 2;
+
+    /* (1) Runtime & limits.tsv single-source verification */
+    bck(tp_batch_cap() == 4096 && tp_tool_src_cap() == 4096, "single-source-runtime-4096");
+    {
+        size_t ln = 0;
+        char *lim = cx_read("exec/facts/limits.tsv", &ln);
+        int ok = lim && strstr(lim, "TP_BATCH_CAP\t4096\ttools/cxlib/testplan.cx\tTP_BATCH_CAP = {}") != 0 &&
+                 strstr(lim, "TP_TOOL_SRC_CAP\t4096\ttools/cxlib/testplan.cx\tTP_TOOL_SRC_CAP = {}") != 0;
+        if (lim) free(lim);
+        bck(ok, "limits-tsv-anchors-single-source");
+    }
+
+    /* (2) Traverse all 18 consumers: consistency PASS + mutation to 2048 MUST FAIL */
+    const char *cfiles[18] = {
+        "tools/cxlib/testplan.cx",
+        "tools/affected.cx",
+        "tools/cxlib/s9sched.cx",
+        "tools/all-waves.cx",
+        "tools/osx-lane.cx",
+        "tools/osx-sentinel.cx",
+        "tools/batch-packages-gen.cx",
+        "tools/prerun-drive.cx",
+        "tools/s9-shards.cx",
+        "tools/s9-shards-flow.cx",
+        "tools/speed-ledger.cx",
+        "tools/tlib-cover.cx",
+        "tools/tool-index.cx",
+        "tools/tlib-admit.cx",
+        "tests/tools-compile.cx",
+        "tools/tier-census.cx",
+        "tools/posix-census.cx",
+        "tools/check-out-writers.cx"
+    };
+    const char *cnames[18] = {
+        "testplan", "affected", "s9sched", "all-waves", "osx-lane", "osx-sentinel",
+        "batch-packages-gen", "prerun-drive", "s9-shards", "s9-shards-flow",
+        "speed-ledger", "tlib-cover", "tool-index", "tlib-admit", "tools-compile",
+        "tier-census", "posix-census", "check-out-writers"
+    };
+    const char *csyms[18] = {
+        "TP_BATCH_CAP", "TP_BATCH_CAP", "TP_BATCH_CAP", "TP_BATCH_CAP", "TP_BATCH_CAP",
+        "TP_BATCH_CAP", "TP_BATCH_CAP", "TP_BATCH_CAP", "TP_BATCH_CAP", "TP_BATCH_CAP",
+        "TP_BATCH_CAP", "TP_BATCH_CAP", "TP_TOOL_SRC_CAP", "TP_TOOL_SRC_CAP",
+        "TP_TOOL_SRC_CAP", "TP_TOOL_SRC_CAP", "TP_TOOL_SRC_CAP", "TP_TOOL_SRC_CAP"
+    };
+    int mut_killed = 0;
+    for (int i = 0; i < 18; i++) {
+        size_t sn = 0;
+        char *src = cx_read(cfiles[i], &sn);
+        char tag[96];
+        int ok = src && check_consumer_src(i, src);
+        cx_fmt(tag, sizeof tag, "consumer.%s", cnames[i]);
+        bck(ok, tag);
+        if (src) {
+            char *mut = (i == 0) ? mutate_replace(src, "4096", "2048") : mutate_replace(src, csyms[i], "2048");
+            int mok = mut && !check_consumer_src(i, mut);
+            if (mok) mut_killed++;
+            cx_fmt(tag, sizeof tag, "mutant-2048-killed.%s", cnames[i]);
+            bck(mok, tag);
+            if (mut) mm_free(mut);
+            /* Extra independent single-site mutation kills for prerun-drive (pd_bmeta & pd_pq_ids) */
+            if (i == 7) {
+                char *m_pq = mutate_replace(src, "pd_pq_ids[TP_BATCH_CAP]", "pd_pq_ids[2048]");
+                bck(m_pq && !check_consumer_src(7, m_pq), "mutant-2048-killed.prerun-drive-pd-pq-ids");
+                if (m_pq) mm_free(m_pq);
+                char *m_bm = mutate_replace(src, "pd_bmeta[TP_BATCH_CAP]", "pd_bmeta[4096]");
+                bck(m_bm && !check_consumer_src(7, m_bm), "mutant-4096-hardcoded-killed.prerun-drive-pd-bmeta");
+                if (m_bm) mm_free(m_bm);
+            }
+            free(src);
+        }
+    }
+    bck(mut_killed == 18, "all-18-consumer-mutants-killed");
+
+    bck(literal_inventory(0) == 0, "literal-inventory-fully-classified");
+    {
+        np_buf mutation = {0};
+        int rc = scan_literal_lines("tools/batch-probe.cx",
+            "int batch_ids[2048];\nenum { MAX_NEW_BATCHES =\n    3072 };\n", &mutation);
+        bck(!rc && mutation.p && strstr(mutation.p, "\t1\t0\t") &&
+            strstr(mutation.p, "\t0\t1\t"), "literal-inventory-detects-array-and-numeric-max");
+        free(mutation.p);
+    }
+
+    /* (4a) In-process tp_visit behavior at 2100, 4000, and 4097 (over-limit) */
+    {
+        int counts[3] = {2100, 4000, 4097};
+        for (int k = 0; k < 3; k++) {
+            size_t bn = 0;
+            char *bt = synth_batches(counts[k], &bn);
+            tp_summary sum;
+            char why[256];
+            int seen = 0;
+            tp_observer ob = {count_batch_cb, count_cov_cb, &seen};
+            int rc = bt ? tp_visit(g_root, bt, bn, SYNTH_COV, strlen(SYNTH_COV), &ob, &sum, why, sizeof why) : -1;
+            if (bt) mm_free(bt);
+            if (counts[k] <= 4096) {
+                char tag[64];
+                cx_fmt(tag, sizeof tag, "tp-visit-accepts-%d", counts[k]);
+                bck(rc == 0 && sum.batches == counts[k] && seen == counts[k], tag);
+            } else {
+                bck(rc != 0 && strstr(why, "table-limit row=4097") != 0, "tp-visit-refuses-4097");
+            }
+        }
+    }
+
+    /* (4b) cxlib.s9sched ss_buf production max-width boundary at 2100, 4096, and 4097 */
+    {
+        ss_ops ops;
+        memset(&ops, 0, sizeof ops);
+        ops.hcap = 1; ops.extra = 1; ops.closes = 1; ops.outer = 300;
+        ops.list = mock_s9_list; ops.spawn = mock_s9_spawn; ops.sched_sha = "synthetic";
+        long ms = 0;
+        g_s9_want_n = 2100;
+        bck(ss_steps_par(&ops, "/tmp", 1, 0, &ms) == 3, "s9sched-maxwidth-accepts-2100");
+        g_s9_want_n = 4096;
+        bck(ss_steps_par(&ops, "/tmp", 1, 0, &ms) == 3, "s9sched-maxwidth-ssbuf-accepts-4096");
+        g_s9_want_n = 4097;
+        bck(ss_steps_par(&ops, "/tmp", 1, 0, &ms) == 1, "s9sched-maxwidth-refuses-4097");
+    }
+
+
+    sy_printf("CHECK_BATCH_CAP\tpassed=%d\tfailed=%d\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
