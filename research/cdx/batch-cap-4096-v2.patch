+static int literal_inventory(int emit) {
+    np_buf current = {0};
+    int rc = scan_literal_tree("tools", &current) || scan_literal_tree("tests", &current);
+    size_t na = 0, nb = 0, n = 0;
+    char **actual = rc ? 0 : literal_rows(current.p, current.n, &na);
+    char *ledger = emit ? 0 : cx_read("tests/batch-cap-literals.tsv", &n);
+    char **expected = ledger ? literal_rows(ledger, n, &nb) : 0;
+    if (!actual || !na || (!emit && !expected)) rc = 1;
+    if (!rc && emit) {
+        puts("# path\t2048_tokens\tnumeric_max_declarations\tcode_line_sha256\tclassified_source");
+        puts("# Existing byte widths and separate domain limits. Batch and tool-source capacity use TP_*_CAP.");
+        for (size_t i = 0; i < na; i++) puts(actual[i]);
+    } else if (!rc) {
+        size_t i = 0, j = 0;
+        while (i < na || j < nb) {
+            int order = i == na ? 1 : j == nb ? -1 : strcmp(actual[i], expected[j]);
+            if (order < 0) { printf("UNCLASSIFIED_LITERAL\t%s\n", actual[i++]); rc = 1; }
+            else if (order > 0) j++;
+            else { i++; j++; }
+        }
+    }
+    free(expected);
+    free(ledger);
+    free(actual);
+    free(current.p);
+    return rc;
+}
