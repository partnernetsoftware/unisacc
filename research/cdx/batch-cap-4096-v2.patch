+/* Inventory exact code lines, not a substring allow-list. Duplicate lines retain multiplicity. */
+static int scan_literal_lines(const char *path, const char *src, np_buf *rows) {
+    char *code = strip_code(src);
+    if (!code) return -1;
+    int max_continues = 0;
+    for (char *line = code; *line;) {
+        char *end = strchr(line, '\n');
+        char *lead = line;
+        int hits = 0, max_decl = 0, directive = 0;
+        if (end) *end = 0;
+        while (*lead == ' ' || *lead == '\t') lead++;
+        if (max_continues) {
+            const char *value = lead;
+            while (*value == '(' || *value == '+' || *value == '-' ||
+                   *value == ' ' || *value == '\t') value++;
+            max_decl = *value >= '0' && *value <= '9';
+            max_continues = !*value || (*value == '\\' && !value[1]);
+        }
+        if (*lead == '#') {
+            const char *q = lead + 1;
+            while (*q == ' ' || *q == '\t') q++;
+            if (!strncmp(q, "define", 6) && !is_id_ch(q[6])) {
+                directive = 1;
+                lead = (char *)q + 6;
+            }
+        }
+        for (char *p = lead; *p;) {
+            if (!is_id_ch(*p)) { p++; continue; }
+            char *first = p++;
+            while (is_id_ch(*p)) p++;
+            if (*first >= '0' && *first <= '9') {
+                char *tail;
+                unsigned long v = strtoul(first, &tail, 0);
+                while (tail < p && strchr("uUlL", *tail)) tail++;
+                if (tail == p && v == 2048) hits++;
+            } else {
+                char *q = p;
+                int is_max = 0;
+                for (char *s = first; s + 3 <= p; s++) {
+                    if (!memcmp(s, "MAX", 3)) { is_max = 1; break; }
+                }
+                while (*q == ' ' || *q == '\t') q++;
+                if (*q == '=' && q[1] != '=') {
+                    q++;
+                    while (*q == ' ' || *q == '\t') q++;
+                } else if (!directive) {
+                    continue;
+                }
+                while (*q == '(' || *q == '+' || *q == '-' || *q == ' ' || *q == '\t') q++;
+                if (is_max && *q >= '0' && *q <= '9') max_decl++;
+                if (is_max && ((!directive && !*q) || (*q == '\\' && !q[1])))
+                    max_continues = 1;
+            }
+            directive = 0;
+        }
+        if (hits || max_decl) {
+            char hash[65], row[1024], excerpt[121];
+            size_t count = strlen(line);
+            const char *s = line;
+            size_t n = 0;
+            if (sy_sha256_hex(line, (long)count, hash)) { mm_free(code); return -1; }
+            while (*s == ' ' || *s == '\t') s++;
+            while (*s && n + 1 < sizeof excerpt) {
+                char c = *s++;
+                excerpt[n++] = c == '\t' || c == '\r' ? ' ' : c;
+            }
+            while (n && excerpt[n - 1] == ' ') n--;
+            excerpt[n] = 0;
+            if (cx_fmt(row, sizeof row, "%s\t%d\t%d\t%s\t%s\n", path, hits, max_decl, hash, excerpt)) {
+                mm_free(code);
+                return -1;
+            }
+            np_puts(rows, row);
+        }
+        if (!end) break;
+        line = end + 1;
+    }
+    mm_free(code);
+    return 0;
+}
