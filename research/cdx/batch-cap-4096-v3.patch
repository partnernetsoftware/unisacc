+static char *mutate_replace(const char *src, const char *from, const char *to) {
+    size_t n = strlen(src), fl = strlen(from), tl = strlen(to);
+    size_t cap = n * 2 + 64;
+    char *out = (char *)mm_alloc((long)cap);
+    if (!out) return 0;
+    size_t i = 0, outn = 0;
+    while (i < n) {
+        if (i + fl <= n && !memcmp(src + i, from, fl)) {
+            if (outn + tl + 1 >= cap) {
+                cap = (cap + tl + 64) * 2;
+                out = (char *)mm_grow(out, (long)cap);
+                if (!out) return 0;
+            }
+            mm_copy(out + outn, (long)(cap - outn), to, (long)tl);
+            outn += tl;
+            i += fl;
+        } else {
+            if (outn + 2 >= cap) {
+                cap *= 2;
+                out = (char *)mm_grow(out, (long)cap);
+                if (!out) return 0;
+            }
+            out[outn++] = src[i++];
+        }
+    }
+    out[outn] = 0;
+    return out;
+}
+
+/* Report candidate literals by source location and syntax. */
+static int scan_literal_lines(const char *path, const char *src, np_buf *rows) {
+    char *code = strip_code(src);
+    if (!code) return -1;
+    int max_continues = 0, line_no = 0;
+    for (char *line = code; *line;) {
+        char *end = strchr(line, '\n');
+        char *lead = line;
+        int old_cap = 0, new_cap = 0, max_decl = 0, directive = 0;
+        line_no++;
+        if (end) *end = 0;
+        while (*lead == ' ' || *lead == '\t') lead++;
+        if (max_continues) {
+            const char *value = lead;
+            while (*value == '(' || *value == '+' || *value == '-' ||
+                   *value == ' ' || *value == '\t') value++;
+            max_decl = *value >= '0' && *value <= '9';
+            max_continues = !*value || (*value == '\\' && !value[1]);
+        }
+        if (*lead == '#') {
+            const char *q = lead + 1;
+            while (*q == ' ' || *q == '\t') q++;
+            if (!strncmp(q, "define", 6) && !is_id_ch(q[6])) {
+                directive = 1;
+                lead = (char *)q + 6;
+            }
+        }
+        for (char *p = lead; *p;) {
+            if (!is_id_ch(*p)) { p++; continue; }
+            char *first = p++;
+            while (is_id_ch(*p)) p++;
+            if (*first >= '0' && *first <= '9') {
+                char *tail;
+                unsigned long v = strtoul(first, &tail, 0);
+                while (tail < p && strchr("uUlL", *tail)) tail++;
+                if (tail == p && v == 2048) old_cap++;
+                if (tail == p && v == 4096) new_cap++;
+            } else {
+                char *q = p;
+                int is_max = 0;
+                for (char *s = first; s + 3 <= p; s++) {
+                    if (!memcmp(s, "MAX", 3)) { is_max = 1; break; }
+                }
+                while (*q == ' ' || *q == '\t') q++;
+                if (*q == '=' && q[1] != '=') {
+                    q++;
+                    while (*q == ' ' || *q == '\t') q++;
+                } else if (!directive) {
+                    continue;
+                }
+                while (*q == '(' || *q == '+' || *q == '-' || *q == ' ' || *q == '\t') q++;
+                if (is_max && *q >= '0' && *q <= '9') max_decl++;
+                if (is_max && ((!directive && !*q) || (*q == '\\' && !q[1])))
+                    max_continues = 1;
+            }
+            directive = 0;
+        }
+        if (old_cap || new_cap || max_decl) {
+            char row[1024], excerpt[121];
+            const char *s = line;
+            size_t n = 0;
+            while (*s == ' ' || *s == '\t') s++;
+            while (*s && n + 1 < sizeof excerpt) {
+                char c = *s++;
+                excerpt[n++] = c == '\t' || c == '\r' ? ' ' : c;
+            }
+            excerpt[n] = 0;
+            const char *categories[] = {"literal-2048", "literal-4096", "numeric-max"};
+            int counts[] = {old_cap, new_cap, max_decl};
+            for (int i = 0; i < 3; i++) if (counts[i]) {
+                if (cx_fmt(row, sizeof row, "%s\t%d\t%s\t%d\t%s\n",
+                           path, line_no, categories[i], counts[i], excerpt)) {
+                    mm_free(code);
+                    return -1;
+                }
+                np_puts(rows, row);
+            }
+        }
+        if (!end) break;
+        line = end + 1;
+    }
+    mm_free(code);
+    return 0;
+}
+
+static int scan_literal_tree(const char *path, np_buf *rows) {
+    sy_dir_t dir;
+    int got;
+    if (sy_dir_open(&dir, path)) return -1;
+    while ((got = sy_dir_next(&dir)) == 1) {
+        char rel[512];
+        size_t n = strlen(dir.name);
+        if (!strcmp(dir.name, ".") || !strcmp(dir.name, "..")) continue;
+        if (cx_fmt(rel, sizeof rel, "%s/%s", path, dir.name)) { got = -1; break; }
+        if (dir.kind == 'd') {
+            if (scan_literal_tree(rel, rows)) { got = -1; break; }
+        } else if (dir.kind == 'f' &&
+                   ((n >= 3 && !strcmp(dir.name + n - 3, ".cx")) ||
+                    (n >= 2 && (!strcmp(dir.name + n - 2, ".c") || !strcmp(dir.name + n - 2, ".h")))) &&
+                   strcmp(rel, "tools/check-batch-cap.cx")) {
+            size_t sn = 0;
+            char *src = cx_read(rel, &sn);
+            if (!src) { got = -1; break; }
+            int rc = scan_literal_lines(rel, src, rows);
+            free(src);
+            if (rc) { got = -1; break; }
+        }
+    }
+    sy_dir_close(&dir);
+    return got < 0 ? -1 : 0;
+}
+
+static int literal_report(void) {
+    np_buf rows = {0};
+    int rc = scan_literal_tree("tools", &rows);
+    if (scan_literal_tree("tests", &rows)) rc = -1;
+    sy_printf("path\tline\tcategory\tcount\texcerpt\n");
+    if (rows.p) sy_printf("%s", rows.p);
+    free(rows.p);
+    if (rc) sy_printf("BATCH_CAP_LITERAL_REPORT\tstatus=INCOMPLETE\n");
+    return 0;
+}
+
+/* Build synthetic N-row batches.tsv and 1-row coverage.tsv in memory or on disk. */
+static char *synth_batches(int nrows, size_t *out_len) {
+    size_t cap = (size_t)nrows * 256 + 512;
+    char *b = (char *)mm_alloc((long)cap);
+    if (!b) return 0;
+    size_t n = 0;
+    const char *hdr = "id\timplementation\tlayer\tsource\tmode\tplatform\tbudget_seconds\tmaterials\tentry\targs\tcoverage\texpect\theaders\ttier\n";
+    size_t hl = strlen(hdr);
+    mm_copy(b, (long)cap, hdr, (long)hl);
+    n = hl;
+    for (int i = 0; i < nrows; i++) {
+        char row[256];
+        int w = snprintf(row, sizeof row,
+                         "bcap-%04d\tIMPLEMENTED\tinterfaces\ttools/check-batch-cap.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/check-batch-cap.cx\t-\tinterfaces.bcap\trc0:CHECK_BATCH_CAP\tproduct\tcommit\n",
+                         i);
+        if (w <= 0 || n + (size_t)w + 1 >= cap) { mm_free(b); return 0; }
+        mm_copy(b + n, (long)(cap - n), row, (long)w);
+        n += (size_t)w;
+    }
+    b[n] = 0;
+    if (out_len) *out_len = n;
+    return b;
+}
+
+static const char *SYNTH_COV =
+    "id\tlayer\timplementation\texpected_or_gap\tsource\n"
+    "interfaces.bcap\tinterfaces\tIMPLEMENTED_SEPARATE_BATCH\tsynthetic batch capacity test\ttools/check-batch-cap.cx\n";
+
+/* Production max-width S9_PENDING mock (~144 bytes/row -> 4096 rows = ~590 KiB > old 512 KiB ss_buf). */
+static int g_s9_want_n = 0;
+static int mock_s9_list(const char *run, char *buf, int cap) {
+    (void)run;
+    int off = 0;
+    for (int i = 0; i < g_s9_want_n; i++) {
