#!/bin/sh
# first-observe make shim (research/c40-freeze-first-observe.md): log one monotonic line, then exit 97 (expected stop)
python3 - "$@" <<'PY' >> "$OBS_MAKE_LOG" 2>/dev/null
import os, sys, time, json
print(json.dumps({"monotonic_ns": time.monotonic_ns(), "pid": os.getpid(), "ppid": os.getppid(),
                  "pgid": os.getpgid(0), "sid": os.getsid(0), "argv": sys.argv[1:]}))
PY
echo "make shim: first make reached; expected stop rc 97" >&2
exit 97
