+/* Test seam, same shape as UNISACC_PROC_INJECT_* but default off and exact:
+   it fires only when UNISACC_TIME_INJECT_EINTR=1 AND UNISACC_TIME_INJECT_PID
+   is the decimal text of this process, compared as bytes (no arithmetic, so an
+   over-long digit string cannot wrap into a valid pid; omitted/foreign pid or
+   a pid with extra characters = off).  Armed: every poll below naps 5 ms (or
+   the requested time when shorter) and returns EINTR. */
+static int syt_inject_eintr(void) {
+#ifdef _WIN32
+    return 0;
+#else
+    const char *v = sy_env("UNISACC_TIME_INJECT_EINTR");
+    const char *p;
+    char me[32];
+    if (!v || v[0] != '1' || v[1]) return 0;
+    p = sy_env("UNISACC_TIME_INJECT_PID");
+    if (!p || !p[0]) return 0;
+    if (cx_fmt(me, sizeof me, "%ld", (long)getpid())) return 0;
+    return !strcmp(p, me);
+#endif
+}
+
+/* poll with the injection seam above. Never returns EINTR when the seam is off;
+   firing is observable from outside (a ready fd reports 0 under the seam). */
+static int syt_poll(struct pollfd *fds, unsigned long n, int ms) {
+#ifdef _WIN32
+    (void)fds; (void)n; (void)ms;
+    return -ENOSYS;
+#else
+    if (syt_inject_eintr()) {
+        struct timespec q;
+        q.tv_sec = 0;
+        q.tv_nsec = (long)(ms > 0 && ms < 5 ? ms : 5) * 1000000L;
+        nanosleep(&q, NULL);
+        errno = EINTR;
+        return -1;
+    }
+    return poll(fds, n, ms);
+#endif
+}
+
