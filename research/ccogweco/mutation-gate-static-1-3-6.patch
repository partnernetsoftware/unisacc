+    sh(sc, 0, 0, 5);
+    for (k = 0; k < 50; k++) { if (!mg_group_alive(pgid)) return 0; sy_sleep_ms(100); }
+    cx_fmt(sc, sizeof sc, "kill -KILL -%d 2>/dev/null; kill -KILL %d 2>/dev/null; true", pgid, pgid);
+    sh(sc, 0, 0, 5);
+    for (k = 0; k < 50; k++) { if (!mg_group_alive(pgid)) return 0; sy_sleep_ms(100); }
+    return mg_group_alive(pgid) ? 1 : 0;
