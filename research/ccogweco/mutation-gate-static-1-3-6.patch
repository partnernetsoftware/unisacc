+/* Run SCRIPT with a bound like sh(), but leave the child where the run's cleanup can reach it: its pid
+   (a sy_spawn child is its own process group leader) is written to PIDFILE before the first read and
+   removed after the child is gone, so run_all kills that group too when the worker's own deadline
+   killed the worker first.  On the bound the whole child tree is killed (sy_kill_tree records what
+   survives) and 124 is returned, the same code a timeout carries elsewhere. */
+static int mg_run_check(const char *script, char *out, int cap, int secs, const char *pidfile) {
+    char *av[] = {"sh", "-c", (char *)script, 0};
+    int ofd = -1, pid, ex = 0, code = 0, sig = 0, pr, timedout = 0, rc;
+    long total = 0, deadline;
+    char *b;
+    if (out && cap > 0) out[0] = 0;
+    if (secs < 1 || secs > 60) return -EINVAL;
+    pid = sy_spawn_pipe(av, 0, 0, &ofd, 0);
+    if (pid < 0) return -1;
+    if (pidfile && pidfile[0]) (void)mg_pid_write(pidfile, pid);
+    b = (char *)mm_alloc(cap > 0 ? (long)cap : 1);
+    if (!b) { sy_close(ofd); sy_kill_tree(pid, 5000, 0, 0, 0, 0); sy_wait_status(pid, 0, &ex, &code, &sig); if (pidfile) sy_unlink(pidfile); return -1; }
+    deadline = sy_now_ms() + (long)secs * 1000;
+    for (;;) {
+        sy_pollfd_t pf; long left = deadline - sy_now_ms(); long r;
+        if (left <= 0) { timedout = 1; break; }
+        pf.fd = ofd; pf.events = SY_POLLIN; pf.revents = 0;
+        pr = sy_poll(&pf, 1, left > 1000 ? 1000 : (int)left);
+        if (pr == 0) continue;
+        if (pr < 0) break;
+        r = sy_read(ofd, b + total, (long)cap - 1 - total);
+        if (r <= 0) break;
+        total += r;
+        if (total >= (long)cap - 1) break;
+    }
+    if (timedout) {
+        int keep[1] = {0}; char rep[160];
+        sy_kill_tree(pid, 5000, keep, 0, rep, sizeof rep);
+        total += 0;
+    }
+    sy_close(ofd);
+    sy_wait_status(pid, 0, &ex, &code, &sig);
+    b[total] = 0;
+    if (out && cap > 0) { long m = total < (long)cap ? total : (long)cap - 1; if (m > 0) memcpy(out, b, (size_t)m); out[m > 0 ? m : 0] = 0; }
+    mm_free(b);
+    if (pidfile && pidfile[0]) sy_unlink(pidfile);
+    if (timedout) return 124;
+    rc = ex ? code : (sig ? 128 + sig : -1);
+    return rc;
+}
 
