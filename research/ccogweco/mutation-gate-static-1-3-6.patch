+/* The 20th number after the command name of /proc/PID/stat is starttime: two reads that differ mean
+   the pid was reused.  0 when the process is gone or the file cannot be parsed. */
+static long mg_proc_start(int pid) {
+    char p[64], *b; size_t n = 0; long seen = 0, v = 0; int f; char *q;
+    if (pid <= 0) return 0;
+    if (cx_fmt(p, sizeof p, "/proc/%d/stat", pid)) return 0;
+    b = (char *)cx_read(p, &n);
+    if (!b) return 0;
+    q = strrchr(b, ')');
+    if (!q) { mm_free(b); return 0; }
+    q++;
+    for (;;) {
+        while (*q == ' ') q++;
+        if (!*q) break;
+        v = 0; while (*q >= '0' && *q <= '9') { v = v * 10 + (*q - '0'); q++; }
+        seen++;
+        if (seen == 20) { mm_free(b); return v > 0 ? v : 0; }
+        while (*q && *q != ' ') q++;
+    }
+    mm_free(b);
+    return 0;
+}
+/* PID[ start] (the form mg_run_check writes); 0 on success.  START may be 0 for an old file. */
+static int mg_pid_write(const char *path, int pid) {
+    FILE *f = fopen(path, "wb"); long st; int k;
+    if (!f) return -1;
+    st = mg_proc_start(pid);
+    k = fprintf(f, "%d %ld\n", pid, st);
+    fclose(f);
+    return k > 0 ? 0 : -1;
+}
+/* PID and START from PATH; 0 on success, -1 when absent or unparsable. */
+static int mg_pid_read(const char *path, int *pid, long *start) {
+    char *b; size_t n = 0; char *sp;
+    *pid = 0; *start = 0;
+    b = (char *)cx_read(path, &n);
+    if (!b) return -1;
+    *pid = atoi(b);
+    sp = strchr(b, ' ');
+    if (sp) *start = atol(sp + 1);
+    mm_free(b);
+    return *pid > 0 ? 0 : -1;
+}
+/* 1 when PID still is the process whose starttime is START (0 = PID already gone). */
+static int mg_same_proc(int pid, long start) {
+    long now;
+    if (pid <= 0) return 0;
+    now = mg_proc_start(pid);
+    return now > 0 && start > 0 && now == start;
+}
+/* A worker's process group is its session (run_all starts it under setsid): 0 when the group has no
+   member left (kill -0 -PGID answers EPERM/ESRCH), 1 while one remains. */
+static int mg_group_alive(int pgid) {
+    char sc[256];
+    if (pgid <= 0) return 0;
+    cx_fmt(sc, sizeof sc, "kill -0 -%d 2>/dev/null", pgid);
+    return sh(sc, 0, 0, 5) == 0;
