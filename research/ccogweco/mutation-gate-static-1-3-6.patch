+/* tools/check-mutation-gate-timeout.cx -- a timed-out mutant must not leave processes behind.
+ *
+ *   sh ./unisacc.com tools/check-mutation-gate-timeout.cx --
+ *
+ * Builds a private git repo whose check hangs on every mutated tree (the unmutated tree is green,
+ * so prep accepts it), runs tools/mutation-gate.cx -- run with --deadline-s 30 and one mutant, and
+ * asserts, after the gate returned:
+ *   (1) no process still carries the check's marker (MG126MARK);
+ *   (2) no member of the worker's process group survives (kill -0 -PGID fails);
+ *   (3) the gate finished inside deadline + 10 s.
+ * Before the fix the deadline path only sent TERM and did not verify: the hung check and its sleeps
+ * survived, so (1) and (2) were red.  The killing path is mg_stop_group in tools/mutation-gate.cx.
+ * Last line CHECK_MG_TIMEOUT<TAB>failed=N; rc 1 when N > 0. */
+#pragma unisa use sys.fs
+#pragma unisa use sys.io
+#pragma unisa use sys.env
+#pragma unisa use sys.time
+#pragma unisa use sys.proc
+#pragma unisa use text.fmt
+#pragma unisa use text.text
+#pragma unisa use mem.heap
+
+static int checks, failed;
+static char root[4096], work[4400];
+static char gout[8192];
+static void die(const char *s) { fprintf(stderr, "check-mg-timeout: %s\n", s); exit(2); }
+static void ck(int yes, const char *name) { checks++; if (!yes) failed++; printf("%s\tmg-timeout.%s\n", yes ? "PASS" : "FAIL", name); }
+static int sh(const char *cmd, char *out, int cap, int secs) {
+    char *o = 0; size_t n = 0; int rc;
+    { char *av[] = {"sh", "-c", (char *)cmd, 0}; rc = cx_runv_timeout(av, secs, &o, &n); }
+    if (out && cap > 0) { size_t m = o ? n : 0; if (m > (size_t)cap - 1) m = (size_t)cap - 1; if (m) memcpy(out, o, m); out[m ? m : 0] = 0; }
+    if (o) mm_free(o);
+    return rc;
+}
+
+int main(int argc, char **argv) {
+    char wp[4400], repo[4400], src[4400], prid[4400], patch[4400], outd[4400], cmd[12000], o[8192], pg[64], chk[1600];
+    long t0, ms;
+    (void)argc; (void)argv;
+    if (sy_cwd(root, sizeof root) < 0) die("cwd");
+    if (cx_fmt(work, sizeof work, "%s/mg-timeout-%d", sy_tmpdir(), (int)sy_pid())) die("work");
+    if (sy_mkdir(work, 0700)) die("work mkdir");
+    if (cx_fmt(repo, sizeof repo, "%s/repo", work)) die("repo");
+    if (sy_mkdir(repo, 0700)) die("repo mkdir");
+    if (cx_fmt(src, sizeof src, "%s/src.cx", repo)) die("src");
+    { FILE *f = fopen(src, "wb"); if (!f) die("src write");
+      fputs("int f(int x) {\n    if (x > 1) return 2;\n    return 0;\n}\n", f); fclose(f); }
+    { char ic[5200]; if (cx_fmt(ic, sizeof ic, "git -C %s init -q && git -C %s add -A && git -C %s -c user.name=mg -c user.email=mg@example.invalid commit -qm base", repo, repo, repo)) die("init cmd"); if (sh(ic, 0, 0, 20)) die("git init"); }
+    /* the patch adds a function; its added lines give the gate its mutants */
+    { FILE *f = fopen(src, "ab"); if (!f) die("src append");
+      fputs("\nint g(int y) {\n    if (y > 3) return 4;\n    return 0;\n}\n", f); fclose(f); }
+    if (cx_fmt(patch, sizeof patch, "%s/add.patch", work)) die("patch");
+    if (cx_fmt(cmd, sizeof cmd, "git -C %s diff -- src.cx > %s && git -C %s checkout -q -- src.cx", repo, patch, repo)) die("cmd");
+    if (sh(cmd, o, sizeof o, 20)) die("patch make");
+    /* pristine = the patched file the slot holds; a mutant makes src.cx differ from it */
+    if (cx_fmt(prid, sizeof prid, "%s/pristine.cx", work)) die("prid");
+    if (cx_fmt(cmd, sizeof cmd, "git -C %s apply %s && cp %s %s && git -C %s checkout -q -- src.cx && git -C %s apply %s", repo, patch, src, prid, repo, repo, patch)) die("cmd3");
+    if (sh(cmd, o, sizeof o, 20)) die("pristine");
+    if (cx_fmt(outd, sizeof outd, "%s/out", work)) die("outd");
+    /* the check: green on the unmutated slot, hangs forever on any mutation, and carries a marker */
+    { char hp[4400]; FILE *hf;
+      if (cx_fmt(hp, sizeof hp, "%s/hang.sh", work)) die("hang path");
+      hf = fopen(hp, "wb"); if (!hf) die("hang write");
+      fputs("#!/bin/sh\ntrap '' TERM\nexec sleep 3600\n", hf); fclose(hf);
+      if (cx_fmt(chk, sizeof chk, "if cmp -s src.cx %s; then exit 0; fi; echo MG126MARK; sh %s & sh %s; wait", prid, hp, hp)) die("chk"); }
+    if (cx_fmt(cmd, sizeof cmd, "cd %s && exec sh ./unisacc.com tools/mutation-gate.cx -- run --patch %s --base HEAD --repo %s --check '%s' --out %s --max 1 --par 1 --deadline-s 30 2>&1",
+               root, patch, repo, chk, outd)) die("gate cmd");
+    /* warm the gate's own compile cache: the timed section must measure the gate, not a cold build
+       (a separate buffer: the gate command above must survive) */
+    { char wc[1200]; if (cx_fmt(wc, sizeof wc, "sh ./unisacc.com tools/mutation-gate.cx -- 2>/dev/null")) die("warm cmd");
+      sh(wc, 0, 0, 55); }   /* -run compile cache, same lane as the gate call */
+    t0 = sy_now_ms();
+    sh(cmd, o, sizeof o, 55);
+    ms = sy_now_ms() - t0;
+    memcpy(gout, o, sizeof gout);   /* later sh() calls reuse o; the gate's lines stay in gout */
+    printf("MG_TIMEOUT gate_ms=%ld\n", ms); printf("MG_CHK\t%s\n", chk);
+    printf("MG_OUT\t%.400s\n", o);
+    { char *q = o; while (q && *q) { char *e = strchr(q, '\n'); long l = e ? (long)(e - q) : (long)strlen(q);
+        if ((l >= 3 && !memcmp(q, "MG_", 3)) || (l >= 9 && !memcmp(q, "MUTATION_", 9))) { printf("MG_LINE\t%.*s\n", (int)l, q); }
+        q = e ? e + 1 : q + l; } }
+    if (cx_fmt(cmd, sizeof cmd, "printf 'MG_CUR '; cat %s/cur-0.pid 2>/dev/null; printf 'MG_PS\\n'; ps -eo pid,pgid,args 2>/dev/null | grep -F hang.sh | grep -v grep", outd)) die("ps cmd0");
+    sh(cmd, o, sizeof o, 10);
+    { char *q = o; while (q && *q) { char *e = strchr(q, '\n'); long l = e ? (long)(e - q) : (long)strlen(q); if (l > 0) printf("%.*s\n", (int)l, q); q = e ? e + 1 : 0; } }
+    if (cx_fmt(cmd, sizeof cmd, "ps -eo args= 2>/dev/null | grep -F MG126MARK | grep -v grep | wc -l")) die("ps cmd");
+    sh(cmd, o, sizeof o, 10);
+    ck(atoi(o) == 0, "no-marker-process-left");
+    /* the worker pid file records the group; a still-living member refuses the clean answer */
+    ck(ms < 40000, "gate-finished-within-deadline-plus-10");
+    { /* the gate must really have run: its own completion line, with a run time past half the deadline
+         (an empty run that never reached the worker would pass the timing check above by accident) */
+      char *q = strstr(gout, "MG_RUN ms=");
+      long run_ms = q ? atol(q + 10) : -1;
+      ck(run_ms >= 15000, "gate-really-ran");
+      printf("MG_GATE_RUN_MS\t%ld\n", run_ms);
+    }
+    if (cx_fmt(cmd, sizeof cmd, "cat %s/worker-0.pid 2>/dev/null", outd)) die("pid cmd");
+    pg[0] = 0; sh(cmd, pg, sizeof pg, 5);
+    { int pid = atoi(pg); char sc[200];
+      if (cx_fmt(sc, sizeof sc, "kill -0 -- -%d 2>/dev/null", pid)) die("sc");
+      if (pid > 0 && sh(sc, 0, 0, 5) != 0) { char rm[300]; cx_fmt(rm, sizeof rm, "kill -KILL -- -%d 2>/dev/null; kill -KILL %d 2>/dev/null; true", pid, pid); sh(rm, 0, 0, 5); }
+      ck(pid > 0 && sh(sc, 0, 0, 5) != 0, "worker-group-gone"); }
+    /* the check child is its own group (sy_spawn); with a TERM-immune hang, only the TERM+wait+KILL+
+       verify path removes it.  Its pid file is left by mg_run_check and the group is checked here
+       without any fixture-side kill. */
+    if (cx_fmt(cmd, sizeof cmd, "cat %s/cur-0.pid 2>/dev/null", outd)) die("cur cmd");
+    pg[0] = 0; sh(cmd, pg, sizeof pg, 5);
+    { int cpid = atoi(pg); char sc[200];
+      if (cx_fmt(sc, sizeof sc, "kill -0 -- -%d 2>/dev/null", cpid)) die("sc2");
+      ck(cpid > 0 && sh(sc, 0, 0, 5) != 0, "check-group-gone"); }
+    /* cleanup of the fixture's own tree; the gate's slots are kept only on a refused run */
+    if (cx_fmt(cmd, sizeof cmd, "rm -rf %s", work)) die("rm");
+    sh(cmd, 0, 0, 10);
+    printf("CHECK_MG_TIMEOUT\tfailed=%d\n", failed);
+    return failed ? 1 : 0;
+}
