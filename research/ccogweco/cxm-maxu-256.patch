diff --git a/tools/genunits-tmp.cx b/tools/genunits-tmp.cx
new file mode 100644
index 0000000..43cbef3
--- /dev/null
+++ b/tools/genunits-tmp.cx
@@ -0,0 +1,25 @@
+/* private probe: write N chained modules + a root that uses m0, into DIR */
+#pragma unisa use sys.fs
+#pragma unisa use sys.io
+#pragma unisa use text.fmt
+int main(int argc, char **argv) {
+    int n = 0, k; char p[1024], b[128];
+    FILE *f;
+    if (argc < 3) return 2;
+    { const char *s = argv[2]; while (*s >= '0' && *s <= '9') { n = n * 10 + (*s++ - '0'); } }
+    if (n < 1) return 2;
+    for (k = 0; k < n; k++) {
+        if (snprintf(p, sizeof p, "%s/m%d.cx", argv[1], k) >= (int)sizeof p) return 2;
+        f = fopen(p, "wb"); if (!f) return 2;
+        if (k + 1 < n) fprintf(f, "#pragma unisa module m%d\n#pragma unisa use m%d\n", k, k + 1);
+        else fprintf(f, "#pragma unisa module m%d\n", k);
+        fclose(f);
+    }
+    if (snprintf(p, sizeof p, "%s/main.cx", argv[1]) >= (int)sizeof p) return 2;
+    f = fopen(p, "wb"); if (!f) return 2;
+    fprintf(f, "#pragma unisa use m0\nint main(void){return 0;}\n");
+    fclose(f);
+    (void)b;
+    printf("GEN\t%s\tn=%d\n", argv[1], n);
+    return 0;
+}
