+/* Test seam, same shape as UNISACC_PROC_INJECT_*: UNISACC_TIME_INJECT_EINTR=1
+   makes every poll below nap 5 ms (or the requested time when shorter) and
+   return EINTR, and UNISACC_TIME_INJECT_PID limits it to that pid. Unset in
+   production; it only exercises the interrupted-path timing, not new behavior. */
+static int syt_inject_eintr(void) {
+#ifdef _WIN32
+    return 0;
+#else
+    const char *v = sy_env("UNISACC_TIME_INJECT_EINTR");
+    const char *p;
+    if (!v || v[0] != '1' || v[1]) return 0;
+    p = sy_env("UNISACC_TIME_INJECT_PID");
+    if (p && p[0]) {
+        long want = 0, me = (long)getpid();
+        int i = 0;
+        while (p[i] >= '0' && p[i] <= '9') { want = want * 10 + (p[i] - '0'); i++; }
+        if (want > 0 && want != me) return 0;
+    }
+    return 1;
+#endif
+}
+
+/* Number of injected EINTR returns so far; the check proves the seam fired. */
+static long syt_inject_n;
+long sy_time_eintr_injected(void) { return syt_inject_n; }
+
+/* poll with the injection seam above. Never returns EINTR when the seam is off. */
+static int syt_poll(struct pollfd *fds, unsigned long n, int ms) {
+#ifdef _WIN32
+    (void)fds; (void)n; (void)ms;
+    return -ENOSYS;
+#else
+    if (syt_inject_eintr()) {
+        struct timespec q;
+        q.tv_sec = 0;
+        q.tv_nsec = (long)(ms > 0 && ms < 5 ? ms : 5) * 1000000L;
+        nanosleep(&q, NULL);
+        syt_inject_n++;
+        errno = EINTR;
+        return -1;
+    }
+    return poll(fds, n, ms);
+#endif
+}
