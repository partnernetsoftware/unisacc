diff --git a/tools/check-time-eintr.cx b/tools/check-time-eintr.cx
new file mode 100644
index 0000000..6e5f617
--- /dev/null
+++ b/tools/check-time-eintr.cx
@@ -0,0 +1,49 @@
+/* tools/check-time-eintr.cx -- sy_sleep_ms / sy_readable honor one deadline across EINTR.
+ *
+ *   UNISACC_TIME_INJECT_EINTR=1 (set here, with UNISACC_TIME_INJECT_PID = this
+ *   pid) makes every poll nap 5 ms (or the requested time when shorter) and
+ *   return EINTR, so a loop that reuses the full timeout never returns and one
+ *   that recomputes the remaining monotonic time returns at the deadline.
+ *
+ *   (1) sy_sleep_ms(200): 0, wall 190..1000 ms, seam fired more than once.
+ *   (2) sy_readable(pipe read end with no data, 200): 0 (timed out), wall
+ *       190..1000 ms. Run this file under a wrapper timeout: without the
+ *       deadline recompute the call never returns.
+ *   Exit 0 all pass; 1 otherwise. */
+#pragma unisa use sys.time
+#pragma unisa use sys.posix
+#pragma unisa use sys.proc
+
+static long ck_fail;
+
+static void ck(int ok, const char *what) {
+    if (ok) printf("PASS\t%s\n", what);
+    else { printf("FAIL\t%s\n", what); ck_fail++; }
+}
+
+int main(void) {
+    long t0, t1, rc;
+    int fds[2];
+    char me[32];
+    if (setenv("UNISACC_TIME_INJECT_EINTR", "1", 1) != 0) { printf("FAIL\tsetenv\n"); return 1; }
+    cx_fmt(me, sizeof me, "%ld", (long)getpid());
+    if (setenv("UNISACC_TIME_INJECT_PID", me, 1) != 0) { printf("FAIL\tsetenv pid\n"); return 1; }
+
+    t0 = sy_now_ms();
+    rc = sy_sleep_ms(200);
+    t1 = sy_now_ms();
+    ck(rc == 0, "sleep rc=0 under continuous EINTR");
+    ck(t1 - t0 >= 190 && t1 - t0 <= 1000, "sleep wall inside 190..1000 ms");
+    ck(sy_time_eintr_injected() > 1, "injected EINTR reached the poll seam");
+
+    if (pipe(fds) != 0) { printf("FAIL\tpipe\n"); return 1; }
+    t0 = sy_now_ms();
+    rc = sy_readable(fds[0], 200);   /* write end open: no data, no hang-up */
+    t1 = sy_now_ms();
+    close(fds[0]); close(fds[1]);
+    ck(rc == 0, "readable returns 0 (timeout) under continuous EINTR");
+    ck(t1 - t0 >= 190 && t1 - t0 <= 1000, "readable wall inside 190..1000 ms");
+
+    printf("CHECK_TIME_EINTR\t%s\tfail=%ld\n", ck_fail ? "FAIL" : "PASS", ck_fail);
+    return ck_fail ? 1 : 0;
+}
