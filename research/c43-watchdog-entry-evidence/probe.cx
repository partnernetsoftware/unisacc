#pragma unisa use cxlib.seedprep
static char *cmd(char **a,size_t *n) {
 char *o=0,*e=0;size_t en=0;int k=0,j;char *v[40];int rc;
 v[k++]=sp_pjoin(sp_root(),"tests/bound");v[k++]="30";
 for(j=0;a[j];j++){if(k>=39)sp_raise_line("AssertionError: command argv overflow");v[k++]=a[j];}v[k]=0;
 rc=sp_spawn(v,32.25,&o,n,&e,&en);
 if(rc){fprintf(stderr,"modelobject command rc=%d: %s\n",rc,a[0]);
   if(e)fwrite(e+(en>2000?en-2000:0),1,en>2000?2000:en,stderr);
   free(o);free(e);sp_raise_line("AssertionError: modelobject command failed");}
 free(e);return o;
}
int main(int argc,char **argv){size_t n;char *o;char *a[4];if(argc!=4)return 2;sp_init(__FILE__);if(chdir(sp_root()))return 2;a[0]=argv[1];a[1]=argv[2];a[2]=argv[3];a[3]=0;o=cmd(a,&n);free(o);return 0;}
