    "    (local.set $i (i32.const 0))\n"
    "    (block $done (loop $L\n"
    "      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))\n"
    "      (local.set $k (i32.load (i32.add (i32.add (local.get $d) (i32.const 8))\n"
