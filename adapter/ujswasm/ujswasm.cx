static void esc(Buf *b, const char *p, int n) {
    static const char *HEX = "0123456789abcdef"; int i; char t[3];   /* bounded: one escaped byte is \xx */
    for (i = 0; i < n; i++) { unsigned char c = (unsigned char)p[i]; t[0] = '\\'; t[1] = HEX[c >> 4]; t[2] = HEX[c & 15]; badd(b, t, 3); }
}
static void map_data(Parts *P, int addr, int *v, int n) {
    Buf b; int i;
    if (!n) return;
    memset(&b, 0, sizeof b);
    bs(&b, "(data (i32.const "); bi(&b, addr); bs(&b, ") \"");
    for (i = 0; i < n; i++) {
        char le[4]; /* bounded: one i32, little-endian */ le[0] = (char)(v[i] & 255); le[1] = (char)((v[i] >> 8) & 255); le[2] = (char)((v[i] >> 16) & 255); le[3] = (char)((v[i] >> 24) & 255);
        esc(&b, le, 4);
    }
    bs(&b, "\")");
    pp(P, b.s); free(b.s);
}

static int cmpname(const void *a, const void *b) { return strcmp(*(char *const *)a, *(char *const *)b); }

static char *emit_wat(Fn *fn) {
    Strings S; Off *so; Buf blob, wat; Parts out; char **fnames = 0; int nfn = 0, k, j, q;
    can_emit_direct(fn);                      /* emit_wat runs it again (its asks are booked again) */
    memset(&S, 0, sizeof S); memset(&blob, 0, sizeof blob); memset(&out, 0, sizeof out); memset(&wat, 0, sizeof wat);
    for (k = 0; k < fn->nstr; k++) { S.s = xrealloc(S.s, (S.n + 1) * sizeof(Str)); S.s[S.n++] = fn->str[k]; }
    if (fn->fns) for (j = 0; j < fn->fns->n; j++) { Fn *n = fn->fns->fn[j]; for (k = 0; k < n->nstr; k++) strings_add(&S, n->str[k].p, n->str[k].n); }
    for (j = -1; j < (fn->fns ? fn->fns->n : 0); j++) {
        Fn *o = j < 0 ? fn : fn->fns->fn[j];
        for (k = 0; k < o->ncode; k++) if (!strcmp(o->code[k].op, "dot") && o->code[k].a) strings_add(&S, o->code[k].a, (int)strlen(o->code[k].a));
    }
    so = xrealloc(0, (S.n + 1) * sizeof(Off));
    bs(&blob, "");
    for (k = 0; k < S.n; k++) { so[k].off = STRDATA0 + (int)blob.n; so[k].len = S.s[k].n; badd(&blob, S.s[k].p, S.s[k].n); }
    if (fn->fns && fn->fns->n) {
        fnames = xrealloc(0, fn->fns->n * sizeof(char *));
        for (j = 0; j < fn->fns->n; j++) fnames[j] = fn->fns->name[j];
        nfn = fn->fns->n;
        qsort(fnames, nfn, sizeof(char *), cmpname);
    }
    pp(&out, "(module");
    pp(&out, HELPERS);
    if (blob.n) {
        Buf d; memset(&d, 0, sizeof d);
        bs(&d, "(data (i32.const "); bi(&d, STRDATA0); bs(&d, ") \""); esc(&d, blob.s, (int)blob.n); bs(&d, "\")");
        pp(&out, d.s); free(d.s);
    }
    for (k = 0; k < nfn; k++) {
        Buf b; char *nm; Fn *nf = 0;
        for (j = 0; j < fn->fns->n; j++) if (!strcmp(fn->fns->name[j], fnames[k])) nf = fn->fns->fn[j];
        memset(&b, 0, sizeof b);
        nm = xf("fn_%d", k);
        body(&b, normalize(nf, &S), so, fnames, nfn, nm);
        pp(&out, b.s); free(b.s);
        g_emit_fn = "main"; free(nm);
    }
    if (!nfn) pp(&out, "(func $dispatch_fn (param $ix i32) (result i32) (unreachable))");
    else {
        Parts d; Buf bt;
        memset(&d, 0, sizeof d); memset(&bt, 0, sizeof bt);
        pp(&d, "(func $dispatch_fn (param $ix i32) (result i32)");
        pp(&d, "(block $bad");
        for (k = nfn - 1; k >= 0; k--) ppf(&d, "(block $f%d", k);
        pp(&d, "(local.get $ix)");
        bs(&bt, "(br_table ");
        for (k = 0; k < nfn; k++) { bi(&bt, k); bs(&bt, " "); }
        bi(&bt, nfn); bs(&bt, ")");
        pp(&d, bt.s); free(bt.s);
        for (k = 0; k < nfn; k++) { pp(&d, ")"); ppf(&d, "(return (call $fn_%d))", k); }
        pp(&d, ")");
        pp(&d, "(unreachable))");
        pp(&out, d.b.s); free(d.b.s);
    }
    {
        Buf b; memset(&b, 0, sizeof b);
        body(&b, normalize(fn, &S), so, fnames, nfn, "main_body");
        pp(&out, b.s); free(b.s);
    }
    {
        /* _host_api_wat(_slot_names(fn), *_gl_names(fn)) */
        int nflat, *lmap, *gmap, nl = 0, ng = 0; char **flat = slot_names(fn, &nflat), **lnames, **gnames;
        Parts H; Buf h; const char *p; int which = 0;
        lnames = xrealloc(0, (fn->nslot + fn->ncode + 1) * sizeof(char *));
        gnames = xrealloc(0, (fn->ncode + 1) * sizeof(char *));
        for (k = 0; k < fn->nslot; k++) if (last_index(lnames, nl, fn->slot[k]) < 0) lnames[nl++] = fn->slot[k];
        for (k = 0; k < fn->ncode; k++) {
            Ins *x = &fn->code[k];
            if ((!strcmp(x->op, "load_l") || !strcmp(x->op, "store_l")) && x->a && last_index(lnames, nl, x->a) < 0) lnames[nl++] = x->a;
        }
        for (k = 0; k < fn->ncode; k++) {
            Ins *x = &fn->code[k];
            if ((!strcmp(x->op, "load_g") || !strcmp(x->op, "store_g")) && x->a && last_index(gnames, ng, x->a) < 0) gnames[ng++] = x->a;
        }
        lmap = xrealloc(0, (nl + 1) * sizeof(int)); gmap = xrealloc(0, (ng + 1) * sizeof(int));
        for (k = 0; k < nl; k++) lmap[k] = last_index(flat, nflat, lnames[k]);
        for (k = 0; k < ng; k++) gmap[k] = last_index(flat, nflat, gnames[k]);
        memset(&H, 0, sizeof H); memset(&h, 0, sizeof h);
        map_data(&H, LMAP0, lmap, nl);
        map_data(&H, GMAP0, gmap, ng);
        for (p = HOSTAPI; *p; p++) {
            if (p[0] == '%' && p[1] == 'd') { bi(&h, (which == 0 || which == 2) ? nl : ng); which++; p++; }
            else badd(&h, p, 1);
        }
        pp(&H, h.s); free(h.s);
        pp(&out, H.b.s); free(H.b.s);
        (void)q;
    }
    pp(&out, EXPORTS);
    free(blob.s);
    return out.b.s;
}

/* ======================================================================================================
   flows.run: SRC -> front -> select+encode -> wat2wasm -> \0asm; the trace is checked (no gold fallback)
   ====================================================================================================== */
static int g_wasm_len; static char *g_wasm;

/* the last resort: wat2wasm refused WAT that the front end and the select/encode flows passed.  Its stderr (captured,
   never passed through) becomes one line: no ANSI colour, no scratch path, the first "error:" with its WAT line:col */
static void refuse_wat2wasm(int rc, const char *errpath) {
    size_t n = 0, i, j = 0; char *e = cx_read(errpath, &n), *t, *ln, *er, *m, *where = 0;
    if (rc == 124) refuse_at(0, "wat2wasm timed out (30 s) on the generated WAT");
    if (rc == 127) refuse_at(0, "wat2wasm cannot be run (not on PATH?)");
    t = malloc(n + 1); if (!t) oom();
    for (i = 0; e && i < n; i++) {                       /* drop ESC [ ... final-byte sequences */
        if (e[i] == 0x1b && i + 1 < n && e[i + 1] == '[') { i += 2; while (i < n && !(e[i] >= 0x40 && e[i] <= 0x7e)) i++; continue; }
        t[j++] = e[i];
    }
    t[j] = 0; free(e);
    if ((er = strstr(t, "error: "))) {
        for (ln = er; ln > t && ln[-1] != '\n'; ln--) ;
        char *c2 = er, *msg = er + 7, *nl = strchr(msg, '\n');
        int l = 0, col = 0;
        if (nl) *nl = 0;
        /* "PATH:LINE:COL: error: " -- read LINE:COL back from the ": " before "error: " */
        if (c2 - ln >= 2 && c2[-1] == ' ' && c2[-2] == ':') {
            char *d = c2 - 2, *a;
            while (d > ln && d[-1] >= '0' && d[-1] <= '9') d--;
            col = atoi(d);
            if (d > ln && d[-1] == ':') { a = d - 1; while (a > ln && a[-1] >= '0' && a[-1] <= '9') a--; if (a < d - 1) l = atoi(a); }
        }
        if (l > 0) where = xf(" at WAT %d:%d", l, col);
        m = xf("wat2wasm refused the generated WAT (rc %d)%s: %s", rc, where ? where : "", msg);   /* its whole first error line */
    } else m = xf("wat2wasm refused the generated WAT (rc %d) with no error line", rc);
    for (i = 0; m[i]; i++) if ((unsigned char)m[i] < 0x20) m[i] = ' ';
    free(t);
    refuse_at(0, m);
}

/* the flows (fn_flows_fn): front, then select+encode; the WAT is the run's output */
typedef struct { const char *src; size_t n; const char *watout; } Run;
static int ujs_flows(void *ctx) {
    Run *r = ctx; Fn *fn; char *wat;
    load_source(r->src, r->n);
    if (fn_phase(PH_FRONT)) refuse_at(0, fn_error());
    fn = compile_src();
    if (fn_phase(PH_SELECT)) refuse_at(0, fn_error());
    can_emit_direct(fn);
    wat = emit_wat(fn);
    if (r->watout && cx_write(r->watout, wat, strlen(wat))) refuse2(0, "cannot write ", r->watout);
    if (fn_out(wat, (long)strlen(wat))) refuse_at(0, fn_error());
    free(wat);
    return 0;
}

/* the emit hook (fn_emit_fn): the WAT through wat2wasm to \0asm, kept in g_wasm; fn_run calls it only after the books
   are clean (no gold fallback), so a refused or gold-driven run never reaches wat2wasm */
static int ujs_emit(void *ctx, const char *wat, long wn) {
    char *wp, *op, *argv[6], *o = 0; size_t on = 0; int rc, saved, efd;
    (void)ctx;
    if (strlen(TMPL_BUILD) + 1 != sizeof g_tmpdir) refuse_at(0, "internal: the scratch template does not fit its buffer");
    memcpy(g_tmpdir, TMPL_BUILD, sizeof g_tmpdir);
    if (!mkdtemp(g_tmpdir)) { g_tmpdir[0] = 0; refuse_at(0, "cannot make a scratch directory"); }
    wp = xf("%s/p.wat", g_tmpdir); op = xf("%s/p.wasm", g_tmpdir);
    if (cx_write(wp, wat, (size_t)wn)) refuse_at(0, "cannot write the WAT");
    argv[0] = "wat2wasm"; argv[1] = wp; argv[2] = "-o"; argv[3] = op; argv[4] = 0;
    /* the child's stderr goes to p.err (cx_runv_timeout captures stdout only): fd 2 is swapped around the call */
    g_errpath = xf("%s/errXXXXXX", g_tmpdir);
    fflush(stderr);
    if ((efd = mkstemp(g_errpath)) < 0) { free(g_errpath); g_errpath = 0; refuse_at(0, "cannot capture the wat2wasm diagnostics"); }
    if ((saved = dup(2)) < 0 || dup2(efd, 2) < 0) refuse_at(0, "cannot capture the wat2wasm diagnostics");
    rc = cx_runv_timeout(argv, 30, &o, &on);
    dup2(saved, 2); close(saved); close(efd);
    free(o);
    if (rc) refuse_wat2wasm(rc, g_errpath);
    {
        size_t wl = 0; char *w = cx_read(op, &wl);
        if (!w || wl < 4 || memcmp(w, "\0asm", 4)) refuse_at(0, "output is not \\0asm");
        g_wasm = w; g_wasm_len = (int)wl;
    }
    cleanup();
    free(wp); free(op);
    return 0;
}

static void run_flows(const char *src, size_t n, const char *watout) {
    Run r;
    r.src = src; r.n = n; r.watout = watout;
    if (fn_run(ujs_flows, &r, ujs_emit, 0)) refuse_at(0, fn_error());
}

/* the adapter's tables: the ujs gold port injected as the label source, the oracle's integer nets from DIR */
static int open_tables(const char *dir) {
    if (fn_label_source(ujsgold_domain, ujsgold_label, 0)) return -1;
    return fn_open(dir);
}

static void print_trace(FILE *f) {
    int k; const char *ph, *net; long h, g;
    for (k = 0; fn_trace_row(k, &ph, &net, &h, &g); k++) fprintf(f, "trace\t%s\t%s\t%ld\t%ld\n", ph, net, h, g);
}

static char *read_source(const char *path, size_t *n) {
    struct stat st; char *b;
    if (stat(path, &st) != 0) refuse_at(0, "cannot read the source (missing?)");
    if (!S_ISREG(st.st_mode)) refuse_at(0, "the source is not a regular file");
    if (!(b = cx_read(path, n))) refuse_at(0, "cannot read the source");
    return b;
}

static int cmd_build(int argc, char **argv) {
    const char *src = 0, *out = 0, *tables = DEFAULT_TABLES, *watout = 0, *drive = "built"; int k; size_t n; char *data;
    char hex[65];                             /* bounded: cx_sha256_hex writes 64 hex digits and a NUL */
    for (k = 0; k < argc; k++) {
        if (!strcmp(argv[k], "-o") && k + 1 < argc) out = argv[++k];
        else if (!strcmp(argv[k], "--tables") && k + 1 < argc) tables = argv[++k];
        else if (!strcmp(argv[k], "--wat") && k + 1 < argc) watout = argv[++k];
        else if (!strcmp(argv[k], "--drive") && k + 1 < argc) drive = argv[++k];
        else if (!src && argv[k][0] != '-') src = argv[k];
        else { fprintf(stderr, "ujswasm: build: unexpected argument %s\n", argv[k]); return 2; }
    }
    if (!src || !out) { fprintf(stderr, "ujswasm: usage: build SRC -o OUT [--tables DIR] [--wat FILE]\n"); return 2; }
    g_src = src;
    unlink(out);                              /* OUT exists afterwards only if this build succeeded */
    if (open_tables(tables)) refuse_at(0, fn_error());
    if (fn_drive(drive)) refuse_at(0, fn_error());
    data = read_source(src, &n);
    run_flows(data, n, watout);
    if (cx_write(out, g_wasm, g_wasm_len)) { unlink(out); refuse2(0, "cannot write ", out); }
    cx_sha256_hex(g_wasm, g_wasm_len, hex);
    printf("out\t%s\t%d\t%s\n", out, g_wasm_len, hex);
    print_trace(stdout);
    return 0;
}

/* ======================================================================================================
   check / refuse / negative / d1: the W2 gate steps
   ====================================================================================================== */
#define BASE "tests/flownet-baseline.tsv"

typedef struct { int rc; char *out; size_t nout; char *err; size_t nerr; } Child;

/* one build in a forked child (a refusal exits that child only): rc, stdout and stderr */
static Child build_child(const char *src, const char *outpath, const char *tables, const char *drive) {
    Child r; char so[] = "/tmp/ujswasmoXXXXXX", se[] = "/tmp/ujswasmeXXXXXX"; int fo = mkstemp(so), fe = mkstemp(se), st = 0; pid_t p;
    memset(&r, 0, sizeof r);
    fflush(stdout); fflush(stderr);
    p = fork();
    if (p == 0) {
        char *av[8]; int k = 0;
        dup2(fo, 1); dup2(fe, 2); close(fo); close(fe);
        av[k++] = (char *)src; av[k++] = "-o"; av[k++] = (char *)outpath; av[k++] = "--tables"; av[k++] = (char *)tables;
        av[k++] = "--drive"; av[k++] = (char *)drive; av[k] = 0;
        g_tmpdir[0] = 0;
        exit(cmd_build(k, av));
    }
    close(fo); close(fe);
    waitpid(p, &st, 0);
    r.rc = (st & 0x7f) ? 128 + (st & 0x7f) : (st >> 8) & 0xff;
    r.out = cx_read(so, &r.nout); r.err = cx_read(se, &r.nerr);
    if (!r.out) { r.out = sdup(""); r.nout = 0; }
    if (!r.err) { r.err = sdup(""); r.nerr = 0; }
    unlink(so); unlink(se);
    return r;
}

static int fails;
static void bad(const char *a, const char *b) { fprintf(stderr, "ujswasm-check: %s%s\n", a, b ? b : ""); fails++; }
static void badf(const char *fmt, ...) { char *m; XF(fmt, m); bad(m, 0); free(m); }

/* baseline rows: SECTION KIND fields... */
typedef struct { char **f; int n; } Row;
static Row *rows; static int nrows;
static void load_baseline(const char *root) {
    char *path = xf("%s/%s", root, BASE), *b, *p; size_t n = 0;
    if (!(b = cx_read(path, &n)) || !n || b[n - 1] != '\n') { fprintf(stderr, "ujswasm-check: %s: cannot read, or no final newline\n", path); exit(1); }
    for (p = b; *p; ) {
        char *nl = strchr(p, '\n'), *s; Row r;
        *nl = 0;
        if (*p && *p != '#') {
            r.f = 0; r.n = 0;
            for (s = p;;) {
                r.f = xrealloc(r.f, (r.n + 1) * sizeof(char *)); r.f[r.n++] = s;
                if (!(s = strchr(s, '\t'))) break;
                *s++ = 0;
            }
            rows = xrealloc(rows, (nrows + 1) * sizeof(Row)); rows[nrows++] = r;
        }
        p = nl + 1;
    }
}
static int is_out(Row *r) { return r->n >= 2 && !strncmp(r->f[0], "out", 3) && r->f[0][3] >= '1' && r->f[0][3] <= '9' && !r->f[0][4]; }

/* D5: rc 1, stdout empty, no output file, stderr one line naming the source and a reason */
static void d5(const char *what, Child *c, const char *outpath, const char *src) {
    struct stat st;
    if (c->rc != 1) badf("%s: refusal rc %d, want 1", what, c->rc);
    if (c->nout) badf("%s: refusal wrote %ld bytes to stdout", what, (long)c->nout);
    if (stat(outpath, &st) == 0) badf("%s: refusal left an output file", what);
    if (strncmp(c->err, "ujswasm: ", 9) || strncmp(c->err + 9, src, strlen(src)) || c->nerr < 9 + strlen(src) + 4
        || !strchr(c->err, '\n') || strchr(c->err, '\n')[1])
        badf("%s: refusal stderr is not one line naming the source and a reason: %s", what, c->err);
}

/* the position part of a refusal: "SRC:LINE:" or "(function F, instruction K)" or a table "PATH:LINE:" */
static int has_position(const char *err, const char *src) {
    char *pat = xf("%s:", src); const char *p = strstr(err, pat); size_t L = strlen(pat);
    free(pat);
    if (p && p[L] >= '1' && p[L] <= '9') return 1;
    if (strstr(err, "(function ") && strstr(err, ", instruction ")) return 1;
    if (strstr(err, "(offset ") || strstr(err, " at offset ")) return 1;
    if (strstr(err, " at WAT ")) return 1;      /* the wat2wasm last resort: the generated WAT's line:col */
    return 0;
}

/* a recorded negative program: tests/ujs2wasm/neg/NAME, else m4/neg/NAME */
static char *neg_path(const char *name) {
    struct stat st; char *p = xf("tests/ujs2wasm/neg/%s", name);
    if (stat(p, &st)) { free(p); p = xf("m4/neg/%s", name); }
    return p;
}

static int cmd_check(const char *root) {
    char *outp, tmp[] = "/tmp/ujswasmcXXXXXX"; int r, k, nprog = 0, same = 0, i, nacc = 0, accok = 0;
    const char *tables = DEFAULT_TABLES;
    load_baseline(root);
    if (chdir(root)) { fprintf(stderr, "ujswasm-check: cannot enter %s\n", root); return 1; }
    if (open_tables(tables)) { fprintf(stderr, "ujswasm-check: %s\n", fn_error()); return 1; }
    /* acc: every net exact on every key, (exact, total) as recorded; the wired and reserved lists as recorded */
    for (r = 0; r < nrows; r++) {
        Row *w = &rows[r];
        if (strcmp(w->f[0], "acc")) continue;
        if (!strcmp(w->f[1], "net") && w->n == 6) {
            int e, t;
            nacc++;
            if (fn_acc(w->f[2], &e, &t)) { bad(fn_error(), 0); continue; }
            if (e != atoi(w->f[3]) || t != atoi(w->f[4]) || e != t) badf("acc %s: %d/%d, recorded %s/%s", w->f[2], e, t, w->f[3], w->f[4]);
            else accok++;
        } else if (!strcmp(w->f[1], "wired") || !strcmp(w->f[1], "reserved")) {
            int cap = 64; char *l = xrealloc(0, cap);
            while (fn_list(w->f[1], l, cap) < 0 && cap < (1 << 20)) { cap *= 2; l = xrealloc(l, cap); fn_error_clear(); }
            if (w->n != 3 || strcmp(l, w->f[2])) badf("acc %s: %s, recorded %s", w->f[1], l, w->n > 2 ? w->f[2] : "?");
            free(l);
        }
    }
    if (!mkdtemp(tmp)) { fprintf(stderr, "ujswasm-check: no scratch\n"); return 1; }
    outp = xf("%s/o.wasm", tmp);
    /* every recorded program: bytes, sha256 and the whole trace equal the m4 record */
    for (r = 0; r < nrows; r++) {
        Row *w = &rows[r]; Child c; char *src; size_t sn = 0; Buf want, got; int t;
        char hex[65];                         /* bounded: cx_sha256_hex writes 64 hex digits and a NUL */
        if (!is_out(w) || strcmp(w->f[1], "out") || w->n != 6) continue;
        nprog++;
        src = cx_read(w->f[2], &sn);
        if (!src) { bad("cannot read ", w->f[2]); continue; }
        cx_sha256_hex(src, sn, hex); free(src);
        if (strcmp(hex, w->f[3])) { bad("source changed since the baseline: ", w->f[2]); continue; }
        c = build_child(w->f[2], outp, tables, "built");
        if (c.rc) { badf("%s: refused (rc %d): %s", w->f[2], c.rc, c.err); continue; }
        {
            size_t wl = 0; char *wb = cx_read(outp, &wl);
            if (!wb) { bad("no output for ", w->f[2]); continue; }
            cx_sha256_hex(wb, wl, hex); free(wb);
            if ((long)wl != atol(w->f[4]) || strcmp(hex, w->f[5])) { badf("%s: output %ld bytes sha256 %s, recorded %s bytes %s", w->f[2], (long)wl, hex, w->f[4], w->f[5]); continue; }
        }
        memset(&want, 0, sizeof want); memset(&got, 0, sizeof got); bs(&want, ""); bs(&got, "");
        for (t = r + 1; t < nrows && is_out(&rows[t]) && !strcmp(rows[t].f[1], "trace") && rows[t].n == 7 && !strcmp(rows[t].f[2], w->f[2]); t++) {
            bs(&want, "trace\t"); bs(&want, rows[t].f[3]); bs(&want, "\t"); bs(&want, rows[t].f[4]); bs(&want, "\t");
            bs(&want, rows[t].f[5]); bs(&want, "\t"); bs(&want, rows[t].f[6]); bs(&want, "\n");
        }
        {
            char *nl = strchr(c.out, '\n');
            if (nl) bs(&got, nl + 1);
        }
        if (strcmp(want.s, got.s)) { badf("%s: trace differs from the m4 record\n--- recorded\n%s--- flownet\n%s", w->f[2], want.s, got.s); continue; }
        same++;
        free(want.s); free(got.s); free(c.out); free(c.err);
    }
    /* the negative programs: accepted / refused as recorded (check section); every refusal in D5 shape */
    {
        int neg = 0, rej = 0, acc = 0;
        for (r = 0; r < nrows; r++) {
            Row *w = &rows[r]; char *path; Child c;
            if (strcmp(w->f[0], "check") || (strcmp(w->f[1], "reject") && strcmp(w->f[1], "accept")) || w->n != 4) continue;
            path = neg_path(w->f[2]);
            neg++;
            c = build_child(path, outp, tables, "built");
            if (!strcmp(w->f[1], "reject")) {
                if (!c.rc) { badf("%s: accepted, the record says refused (%s)", path, w->f[3]); unlink(outp); continue; }
                d5(path, &c, outp, path);
                if (!has_position(c.err, path)) badf("%s: refusal without a position: %s", path, c.err);
                rej++;
            } else {
                if (c.rc) { badf("%s: refused, the record says accepted: %s", path, c.err); continue; }
                acc++; unlink(outp);
            }
        }
        for (i = 0; i < nrows; i++) if (!strcmp(rows[i].f[0], "check") && !strcmp(rows[i].f[1], "summary")) break;
        printf("ujswasm-check: acc %d/%d nets exact as recorded; programs %d/%d byte-identical with identical traces; negatives %d (refused %d, accepted %d)\n",
               accok, nacc, same, nprog, neg, rej, acc);
        if (nacc != 10 || !nprog || same != nprog || neg != 9) badf("want 10 acc rows (%d), every recorded program (%d) the same, 9 negatives (%d)", nacc, nprog, neg);
    }
    rmdir(tmp); free(outp);
    (void)k;
    if (fails) { fprintf(stderr, "ujswasm-check: %d failure(s)\n", fails); return 1; }
    printf("ujswasm-check: PASS (D2: %d/%d programs byte-identical to the ujs gold record, acc %d/10, gold fallbacks 0)\n", same, nprog, accok);
    return 0;
}

/* generated sources, built in memory at their full length: the long-text probes of the accepts and refuse steps
   (D5 / no truncation) and the literal boundaries.  R(c, k) is k copies of c. */
typedef struct { const char *name; const char *what; } LongCase;
static const LongCase LONGS[] = {
    { "edge_i64max.ujs", "2^64-1 with leading zeros" },
    { "edge_f64max.ujs", "2^1024-2^970-1 with a fraction (DBL_MAX by rounding)" },
    { "long_frac500.ujs", "a float literal with 500 fraction digits" },
    { "long_frac6000.ujs", "a float literal with 6000 fraction digits" },
    { "long_ident700.ujs", "a 700-character identifier" },
    { "long_str200k.ujs", "a 200000-byte string literal" } };
#define NLONG ((int)(sizeof LONGS / sizeof LONGS[0]))
static void R(Buf *b, int c, long k) { char ch = (char)c; long i; for (i = 0; i < k; i++) badd(b, &ch, 1); }
static Buf long_source(int e) {
    Buf b; memset(&b, 0, sizeof b); bs(&b, "");
    switch (e) {
    case 0: bs(&b, "let a = 018446744073709551615;\nreturn a + 1;\n"); break;
    case 1: {
        size_t L = strlen(F64_INF_FROM);
        bs(&b, "return 00"); badd(&b, F64_INF_FROM, L - 1); bs(&b, "1.9999;\n");   /* ...792 -> ...791: no borrow */
        break; }
    case 2: bs(&b, "return 1."); R(&b, '3', 500); bs(&b, ";\n"); break;
    case 3: bs(&b, "let x = 2;\nreturn x * 0.0"); R(&b, '7', 6000); bs(&b, ";\n"); break;
    case 4: bs(&b, "let "); R(&b, 'q', 700); bs(&b, " = 40;\nreturn "); R(&b, 'q', 700); bs(&b, " + 2;\n"); break;
    case 5: bs(&b, "let s = \""); R(&b, 'x', 200000); bs(&b, "\";\nreturn s;\n"); break;
    }
    return b;
}

/* SRC built through flownet and through the m4 oracle (`python3 -m m4 build SRC -o REF`, a child; nothing of it is
   imported): both accept and the bytes are equal */
static int same_as_oracle(const char *src, const char *label, const char *mine, const char *ref) {
    Child c; char *av[8], *o = 0, *x, *y; size_t on = 0, a = 0, b = 0; int rc, ok;
    unlink(mine);
    c = build_child(src, mine, DEFAULT_TABLES, "built");
    if (c.rc) { badf("%s: refused: %s", label, c.err); free(c.out); free(c.err); return 0; }
    free(c.out); free(c.err);
    av[0] = "python3"; av[1] = "-m"; av[2] = "m4"; av[3] = "build"; av[4] = (char *)src; av[5] = "-o"; av[6] = (char *)ref; av[7] = 0;
    unlink(ref);
    rc = cx_runv_timeout(av, 20, &o, &on); free(o);
    if (rc) { badf("%s: the m4 oracle failed (rc %d)", label, rc); return 0; }
    x = cx_read(mine, &a); y = cx_read(ref, &b);
    ok = x && y && a == b && !memcmp(x, y, a);
    if (!ok) badf("%s: flownet %ld bytes, m4 %ld bytes: differ", label, (long)a, (long)b);
    else printf("same\t%s\t%ld bytes\n", label, (long)a);
    free(x); free(y);
    return ok;
}

/* the negatives that ujs (and m4) accept have no recorded bytes in the baseline: each one is built through flownet
   and through the m4 oracle (`python3 -m m4 build SRC -o OUT`, run as a child; nothing of it is imported) and the bytes
   must be equal.  This is the only Python step of the adapter's checks; flownet/ itself never runs it. */
static int cmd_accepts(const char *root) {
    char tmp[] = "/tmp/ujswasmaXXXXXX", *mine, *ref; int r, n = 0, ok = 0, nedge = 0, edgeok = 0, e;
    load_baseline(root);
    if (chdir(root)) { fprintf(stderr, "ujswasm-accepts: cannot enter %s\n", root); return 1; }
    if (!mkdtemp(tmp)) return 1;
    mine = xf("%s/mine.wasm", tmp); ref = xf("%s/ref.wasm", tmp);
    for (r = 0; r < nrows; r++) {
        Row *w = &rows[r]; char *path;
        if (strcmp(w->f[0], "check") || strcmp(w->f[1], "accept") || w->n != 4) continue;
        path = neg_path(w->f[2]);
        n++;
        if (same_as_oracle(path, path, mine, ref)) ok++;
        free(path);
    }
    /* generated accepts: (1) the literal boundaries just inside what wat2wasm takes (the refuse step holds the ones
       just outside): 2^64-1 as an i64.const (wraps to -1, as the oracle's int() text does), and 2^1024 - 2^970 - 1 with
       a fraction and leading zeros (rounds to DBL_MAX; the oracle writes 1.7976931348623157e+308, flownet the decimal
       text); (2) long texts, which must reach the WAT whole (no fixed buffer on the way): float literals with 500 and
       6000 fraction digits, a 700-character identifier, a 200000-byte string literal */
    for (e = 0; e < NLONG; e++) {
        char *path = xf("%s/%s", tmp, LONGS[e].name); Buf body = long_source(e);
        if (cx_write(path, body.s, body.n)) { bad("cannot write ", path); free(path); free(body.s); continue; }
        free(body.s);
        nedge++;
        if (same_as_oracle(path, LONGS[e].name, mine, ref)) edgeok++;
        unlink(path); free(path);
    }
    unlink(mine); unlink(ref); rmdir(tmp); free(mine); free(ref);
    if (fails || n != 5 || nedge != NLONG) { fprintf(stderr, "ujswasm-accepts: %d failure(s), %d/%d the same (want the 5 recorded accepts), generated %d/%d\n", fails, ok, n, edgeok, nedge); return 1; }
    printf("ujswasm-accepts: PASS (%d/%d known accepts and %d/%d generated accepts -- 2 literal boundaries, 4 long texts -- byte-identical to python3 -m m4 build)\n", ok, n, edgeok, nedge);
    return 0;
}

/* the wat2wasm last resort, reached on purpose: (1) a wrapper wat2wasm first on PATH rewrites one literal of the
   generated WAT to one the real wat2wasm rejects (its real coloured diagnostic, with its scratch path), (2) no
   wat2wasm on PATH.  Each must be one D5 line: no ANSI, no WAT/scratch path, the reason named.  PATH is set to the
   stub directory alone (the carried setenv keeps at most 255 bytes; execvp searches what getenv sees), and the stub
   restores the full PATH itself for sed and the real wat2wasm. */
static int refuse_wat2wasm_cases(const char *tmp, const char *outp) {
    char *bin, *stub, *real = 0, *src, *body, *path = getenv("PATH"), *pv, *seg, *save;
    struct stat st; int n = 0, k;
    pv = sdup(path ? path : "");
    for (seg = pv; seg; seg = save) {
        save = strchr(seg, ':'); if (save) *save++ = 0;
        real = xf("%s/wat2wasm", *seg ? seg : ".");
        if (!stat(real, &st) && S_ISREG(st.st_mode) && !access(real, X_OK)) break;
        free(real); real = 0;
    }
    free(pv);
    if (!real || strchr(real, '\'') || strchr(tmp, '\'') || !path || strchr(path, '\'')) { bad("wat2wasm cases: no wat2wasm on PATH (or a quote in its path)", 0); return 0; }
    bin = xf("%s/bin", tmp);
    if (mkdir(bin, 0755)) { bad("wat2wasm cases: cannot make ", bin); return 0; }
    stub = xf("%s/wat2wasm", bin);
    body = xf(
        "#!/bin/sh\n"
        "PATH='%s'; export PATH\n"
        "sed 's/(i64.const 424242)/(i64.const 99999999999999999999)/' \"$1\" > '%s/x.wat' || exit 9\n"
        "exec '%s' '%s/x.wat' \"$2\" \"$3\"\n", path, bin, real, bin);
    if (cx_write(stub, body, strlen(body)) || chmod(stub, 0755)) { bad("wat2wasm cases: cannot write ", stub); return 0; }
    free(body);
    src = xf("%s/w2w.ujs", tmp);
    { const char *w = "let k = 1;\nreturn k + 424242;\n"; if (cx_write(src, w, strlen(w))) { bad("wat2wasm cases: cannot write ", src); return 0; } }
    for (k = 0; k < 2; k++) {
        Child c; char *old = sdup(path), *np = k ? xf("%s/none", tmp) : xf("%s", bin);
        const char *what = k ? "wat2wasm missing" : "wat2wasm rejects", *want = k ? "wat2wasm cannot be run" : "wat2wasm refused the generated WAT (rc 1) at WAT ";
        if (setenv("PATH", np, 1)) { bad("wat2wasm cases: cannot set PATH to ", np); free(old); free(np); continue; }
        cx_write(outp, "stale", 5);
        c = build_child(src, outp, DEFAULT_TABLES, "built");
        setenv("PATH", old, 1); free(old); free(np);
        d5(what, &c, outp, src);
        if (!strstr(c.err, want)) badf("%s: reason not named (want '%s'): %s", what, want, c.err);
        if (!k && !strstr(c.err, "invalid literal")) badf("%s: wat2wasm's own error not carried: %s", what, c.err);
        if (!k && !has_position(c.err, src)) badf("%s: no position: %s", what, c.err);
        if (strchr(c.err, 0x1b) || strstr(c.err, ".wat") || strstr(c.err, bin)) badf("%s: ANSI or a scratch path leaked: %s", what, c.err);
        printf("refused\t%s\t%s", what, c.err);
        n++;
    }
    body = xf("%s/x.wat", bin); unlink(body); free(body);
    unlink(stub); rmdir(bin); unlink(src);
    free(stub); free(bin); free(src); free(real);
    return n;
}

/* long-text refusals (generated): a nested function with a 700-character name, a 6000-digit integer literal above
   2^64-1, a float literal with 6000 integer digits (infinity), an unterminated 200000-byte string */
static const char *LONGREF[][2] = {
    { "long_nested700.ujs", "not a top-level function" },
    { "long_int6000.ujs", "(6000 digits) exceeds 2^64-1" },
    { "long_finf6000.ujs", "(6000 integer digits) rounds to infinity" },
    { "long_unterm200k.ujs", "unterminated string (opened at line 2)" } };
#define NLONGREF ((int)(sizeof LONGREF / sizeof LONGREF[0]))
static Buf long_refusal(int k) {
    Buf b; memset(&b, 0, sizeof b); bs(&b, "");
    switch (k) {
    case 0: bs(&b, "function f() {\n  function "); R(&b, 'q', 700); bs(&b, "() { return 1; }\n  return "); R(&b, 'q', 700);
            bs(&b, "();\n}\nreturn f();\n"); break;
    case 1: bs(&b, "let a = 1;\nreturn a + 1"); R(&b, '0', 5999); bs(&b, ";\n"); break;
    case 2: bs(&b, "let a = 1;\nreturn a * 1"); R(&b, '0', 5999); bs(&b, ".5;\n"); break;
    case 3: bs(&b, "let a = 1;\nreturn \""); R(&b, 'x', 200000); bs(&b, ";\n"); break;
    }
    return b;
}

/* D5 over inputs no recorded program covers; each must be refused with a reason and a position */
static int cmd_refuse(const char *root) {
    static const char *CASES[][3] = {
        { "keys.ujs", "let d = {a: 1};\nreturn keys(d);\n", "emit gap keys" },
        { "in.ujs", "let d = {a: 1};\nreturn \"a\" in d;\n", "emit gap in" },
        { "spread.ujs", "let xs = [1, 2];\nreturn [...xs];\n", "emit gap spread" },
        { "modassign.ujs", "let x = 5;\nx %= 2;\nreturn x;\n", "not in its domain" },
        { "nonascii_id.ujs", "let \xce\xbb = 1;\nreturn \xe2\x82\xac;\n", "not covered" },
        { "badutf8.ujs", "return \"\xff\";\n", "not valid UTF-8" },
        { "unterminated.ujs", "return \"abc;\n", "unterminated string" },
        { "break.ujs", "break;\nreturn 1;\n", "break outside" },
        { "nested_fn.ujs", "function f() {\n  function g() { return 1; }\n  return g();\n}\nreturn f();\n", "not a top-level function" },
        /* literals wat2wasm cannot take: refused at the literal's line before any WAT is written */
        { "int_over.ujs", "let a = 007;\nreturn a + 99999999999999999999;\n", "exceeds 2^64-1" },
        { "int_2p64.ujs", "let x = 1;\n\nreturn x + 18446744073709551616;\n", "exceeds 2^64-1" },
        { "int_case.ujs", "let x = 3;\nswitch (x) {\n  case 000099999999999999999999: return 1;\n  default: return 0;\n}\n", "exceeds 2^64-1" },
        { 0, 0, 0 } };
    /* f64 literals at the infinity boundary (2^1024 - 2^970, the tie rounds to infinity): the integer part is spelled
       from F64_INF_FROM; F64_INF_FROM - 1 with any fraction stays finite (an accept, see the accepts step) */
    static const char *FLOATS[][3] = {
        { "float_inf.ujs", "return %s.0;\n", "rounds to infinity" },
        { "float_tie.ujs", "let y = 2;\n\nreturn y * 000%s.000;\n", "rounds to infinity" },
        { 0, 0, 0 } };
    char tmp[] = "/tmp/ujswasmrXXXXXX", *src, *outp; int k, n = 0, npos = 0;
    if (chdir(root)) { fprintf(stderr, "ujswasm-refuse: cannot enter %s\n", root); return 1; }
    if (!mkdtemp(tmp)) return 1;
    outp = xf("%s/o.wasm", tmp);
    for (k = 0; CASES[k][0]; k++) {
        Child c;
        src = xf("%s/%s", tmp, CASES[k][0]);
        if (cx_write(src, CASES[k][1], strlen(CASES[k][1]))) return 1;
        cx_write(outp, "stale", 5);           /* a stale OUT must not survive a refusal */
        c = build_child(src, outp, DEFAULT_TABLES, "built");
        d5(CASES[k][0], &c, outp, src);
        if (!strstr(c.err, CASES[k][2])) badf("%s: reason not named (want '%s'): %s", CASES[k][0], CASES[k][2], c.err);
        if (!has_position(c.err, src)) badf("%s: no position: %s", CASES[k][0], c.err); else npos++;
        printf("refused\t%s\t%s", CASES[k][0], c.err);
        unlink(src); free(src); n++;
    }
    for (k = 0; FLOATS[k][0]; k++) {
        Child c; char *body = xf(FLOATS[k][1], F64_INF_FROM);
        src = xf("%s/%s", tmp, FLOATS[k][0]);
        if (cx_write(src, body, strlen(body))) return 1;
        free(body);
        cx_write(outp, "stale", 5);
        c = build_child(src, outp, DEFAULT_TABLES, "built");
        d5(FLOATS[k][0], &c, outp, src);
        if (!strstr(c.err, FLOATS[k][2])) badf("%s: reason not named (want '%s'): %s", FLOATS[k][0], FLOATS[k][2], c.err);
        if (!has_position(c.err, src)) badf("%s: no position: %s", FLOATS[k][0], c.err); else npos++;
        printf("refused\t%s\t%s", FLOATS[k][0], c.err);
        unlink(src); free(src); n++;
    }
    /* long texts refused: the reason and the position survive whole, and a long name is named whole (no message
       buffer cuts it); a 6000-digit integer or float literal is shown by an explicit abbreviation and its count */
    for (k = 0; k < NLONGREF; k++) {
        Child c; Buf body = long_refusal(k), name; size_t got;
        src = xf("%s/%s", tmp, LONGREF[k][0]);
        if (cx_write(src, body.s, body.n)) return 1;
        free(body.s);
        cx_write(outp, "stale", 5);
        c = build_child(src, outp, DEFAULT_TABLES, "built");
        d5(LONGREF[k][0], &c, outp, src);
        if (!strstr(c.err, LONGREF[k][1])) badf("%s: reason not named (want '%s'): %s", LONGREF[k][0], LONGREF[k][1], c.err);
        if (!has_position(c.err, src)) badf("%s: no position: %s", LONGREF[k][0], c.err); else npos++;
        memset(&name, 0, sizeof name); bs(&name, " "); R(&name, 'q', 700); bs(&name, " ");
        if (k == 0 && !strstr(c.err, name.s)) badf("%s: the 700-character name is not named whole: %s", LONGREF[k][0], c.err);
        free(name.s);
        got = strlen(c.err);
        printf("refused\t%s\t", LONGREF[k][0]);
        if (got > 200) printf("%.*s ... (%ld bytes)\n", 120, c.err, (long)got);   /* the gate log only; checked whole above */
        else printf("%s", c.err);
        unlink(src); free(src); n++;
    }
    n += refuse_wat2wasm_cases(tmp, outp); npos++;   /* the wat2wasm rejection names the WAT line:col */
    {   /* a missing source and a directory as the source */
        Child c;
        src = xf("%s/missing.ujs", tmp);
        c = build_child(src, outp, DEFAULT_TABLES, "built");
        d5("missing source", &c, outp, src);
        if (!strstr(c.err, "cannot read the source")) bad("missing source: reason not named: ", c.err);
        c = build_child(tmp, outp, DEFAULT_TABLES, "built");
        d5("directory as source", &c, outp, tmp);
        if (!strstr(c.err, "not a regular file")) bad("directory source: reason not named: ", c.err);
        n += 2; free(src);
    }
    unlink(outp); rmdir(tmp); free(outp);
    if (fails) { fprintf(stderr, "ujswasm-refuse: %d failure(s)\n", fails); return 1; }
    printf("ujswasm-refuse: PASS (%d uncovered inputs, each rc 1, stdout empty, no output file, one stderr line naming the reason; "
           "%d with a position -- the rest are a missing/directory source and a missing wat2wasm)\n", n, npos);
    return 0;
}

/* copy the tables to DIR (scratch), then apply one mutation */
static void copy_tables(const char *dir) {
    int i; char *a, *b; size_t n; char *t;
    for (i = -1; i < 20; i++) {
        static const char *N[10] = { "lex", "parse", "type", "scope", "shape", "irsel", "ic", "isel", "enc", "reloc" };
        if (i < 0) { a = xf("%s/contract.tsv", DEFAULT_TABLES); b = xf("%s/contract.tsv", dir); }
        else { a = xf("%s/%s.%s.tsv", DEFAULT_TABLES, N[i / 2], i % 2 ? "net" : "gold"); b = xf("%s/%s.%s.tsv", dir, N[i / 2], i % 2 ? "net" : "gold"); }
        t = cx_read(a, &n); if (!t || cx_write(b, t, n)) { fprintf(stderr, "ujswasm-negative: cannot copy %s\n", a); exit(1); }
        free(t); free(a); free(b);
    }
}

/* every w2 entry of NET gets weight +W on CLASS: the net's answers move */
static void mutate_w2(const char *dir, const char *net, int cls, int w) {
    char *p = xf("%s/%s.net.tsv", dir, net); size_t n; char *t, *q; Buf o; memset(&o, 0, sizeof o); bs(&o, "");
    t = cx_read(p, &n);
    for (q = t; *q; ) {
        char *nl = strchr(q, '\n');
        *nl = 0;
        badd(&o, q, strlen(q));
        if (!strncmp(q, "w2\t", 3)) { char *e = xf("\t%d:%d", cls, w); bs(&o, e); free(e); }
        bs(&o, "\n");
        q = nl + 1;
    }
    cx_write(p, o.s, o.n); free(t); free(o.s); free(p);
}

/* the ujs gold port with one label flipped: enc (nop, none) answers trap instead of empty */
static const char *flipped_label(void *ctx, const char *net, int nk, const char *const *key) {
    if (!strcmp(net, "enc") && nk == 2 && !strcmp(key[0], "nop") && !strcmp(key[1], "none")) return "trap";
    return ujsgold_label(ctx, net, nk, key);
}

static int cmd_negative(const char *root) {
    char tmp[] = "/tmp/ujswasmnXXXXXX", *outp, *p; int e, t, red = 0, total = 0; Child c;
    const char *prog = "tests/ujs2wasm/corpus/arith.ujs";
    if (chdir(root)) { fprintf(stderr, "ujswasm-negative: cannot enter %s\n", root); return 1; }
    if (!mkdtemp(tmp)) return 1;
    outp = xf("%s/o.wasm", tmp);
    /* 1. clean copy: acc exact and the program builds (the mutations below are what turn it red) */
    copy_tables(tmp);
    if (open_tables(tmp) || fn_acc("isel", &e, &t) || e != t) { bad("negative: the clean copy is not exact: ", fn_error()); }
    c = build_child(prog, outp, tmp, "built");
    if (c.rc) bad("negative: the clean copy does not build: ", c.err);
    /* 2. gold drive: every answer is a gold fallback -> the trace check refuses (red line 1) */
    total++;
    c = build_child(prog, outp, tmp, "gold");
    if (c.rc == 1 && strstr(c.err, "fell back to gold")) { red++; printf("red\tgold drive\t%s", c.err); } else bad("negative: gold drive was not refused: ", c.err);
    /* 3. a missing net table: named, rc 1 */
    total++;
    p = xf("%s/enc.net.tsv", tmp);
    { size_t n; char *keep = cx_read(p, &n); unlink(p);
      c = build_child(prog, outp, tmp, "built");
      if (c.rc == 1 && strstr(c.err, "enc.net.tsv") && strstr(c.err, "cannot read")) { red++; printf("red\tmissing table\t%s", c.err); } else bad("negative: missing table not named: ", c.err);
      cx_write(p, keep, n); free(keep); free(p); }
    /* 4. isel net mutated (every unit +1000 on class 1 = i64_bin): acc red, and the build refused or different */
    total++;
    mutate_w2(tmp, "isel", 1, 1000);
    fn_error_clear();
    if (open_tables(tmp) == 0 && fn_acc("isel", &e, &t) == 0 && e != t) { red++; printf("red\tisel mutated\tacc %d/%d\n", e, t); }
    else bad("negative: mutated isel still exact", 0);
    total++;
    c = build_child(prog, outp, tmp, "built");
    if (c.rc == 1 && strstr(c.err, "not a legal answer")) { red++; printf("red\tisel mutated\t%s", c.err); } else bad("negative: mutated isel was not refused: ", c.err);
    /* 5. lex net mutated: the lexer is decided by it -- refused */
    copy_tables(tmp);
    total++;
    mutate_w2(tmp, "lex", 8, 1000);           /* class 8 = bad */
    c = build_child(prog, outp, tmp, "built");
    if (c.rc == 1 && strstr(c.err, "lex")) { red++; printf("red\tlex mutated\t%s", c.err); } else bad("negative: mutated lex was not refused: ", c.err);
    /* 6. a gold label flipped in the file, read by flownet's stock label source (no injection): acc red */
    copy_tables(tmp);
    total++;
    {
        size_t n; char *g; char *q;
        p = xf("%s/enc.gold.tsv", tmp);
        g = cx_read(p, &n);
        q = strstr(g, "\nnop\tnone\tempty\n");
        if (q) { memcpy(q + 1 + 9, "trap\n", 5); memmove(q + 1 + 14, q + 1 + 15, strlen(q + 1 + 15) + 1); n--; }
        cx_write(p, g, n);
        free(g); free(p);
        fn_error_clear();
        fn_label_source(0, 0, 0);
        if (q && fn_open(tmp) == 0 && fn_acc("enc", &e, &t) == 0 && e == t - 1) { red++; printf("red\tenc gold flipped\tacc %d/%d\n", e, t); }
        else bad("negative: flipped gold label not caught by acc", 0);
    }
    /* 7. the same label flipped in the injected label source (the port, wrapped): acc red -- the injected source is
          what the nets are checked against, and a build through it is refused (enc's gate no longer passes) */
    copy_tables(tmp);
    total++;
    fn_error_clear();
    if (fn_label_source(ujsgold_domain, flipped_label, 0) == 0 && fn_open(tmp) == 0 && fn_acc("enc", &e, &t) == 0 && e == t - 1) {
        red++; printf("red\tinjected label flipped\tacc %d/%d\n", e, t);
    } else bad("negative: flipped injected label not caught by acc: ", fn_error());
    fn_label_source(0, 0, 0);
    copy_tables(tmp);
    {
        int i; static const char *N[10] = { "lex", "parse", "type", "scope", "shape", "irsel", "ic", "isel", "enc", "reloc" };
        for (i = 0; i < 20; i++) { p = xf("%s/%s.%s.tsv", tmp, N[i / 2], i % 2 ? "net" : "gold"); unlink(p); free(p); }
        p = xf("%s/contract.tsv", tmp); unlink(p); free(p);
    }
    unlink(outp); rmdir(tmp); free(outp);
    if (fails || red != total) { fprintf(stderr, "ujswasm-negative: %d failure(s), %d/%d mutations red\n", fails, red, total); return 1; }
    printf("ujswasm-negative: PASS (%d/%d mutations red: gold drive, missing table, isel acc + build, lex build, gold label in the file, label in the injected source)\n", red, total);
    return 0;
}

/* D1 (grep -rn ujs flownet/ --include=*.cx is empty) and red line 3 (no Python in flownet/) */
static int d1_hits, d1_files;
static int d1_file(const char *path, void *ctx) {
    size_t n, k, L = strlen(path); char *b; int line = 1; (void)ctx;
    if (L < 3 || strcmp(path + L - 3, ".cx")) {
        if (L > 3 && !strcmp(path + L - 3, ".py")) { fprintf(stderr, "ujswasm-d1: %s: a Python file in flownet/\n", path); d1_hits++; }
        return 0;
    }
    d1_files++;
    if (!(b = cx_read(path, &n))) { fprintf(stderr, "ujswasm-d1: %s: cannot read\n", path); d1_hits++; return 0; }
    for (k = 0; k < n; k++) {
        if (b[k] == '\n') line++;
        if (k + 3 <= n && !memcmp(b + k, "ujs", 3)) { fprintf(stderr, "ujswasm-d1: %s:%d: names ujs\n", path, line); d1_hits++; }
        if (k + 6 <= n && (!memcmp(b + k, "python", 6) || !memcmp(b + k, "Python", 6))) { fprintf(stderr, "ujswasm-d1: %s:%d: names Python\n", path, line); d1_hits++; }
    }
    free(b);
    return 0;
}

/* bounds: no text is cut short by a fixed-size buffer anywhere in flownet/ or adapter/ujswasm/.  Over the code (comments
   and literal contents blanked), each of these is a finding at FILE:LINE:
     a call of the printf-to-buffer or string-copy family other than vsnprintf (which only the exact-size formatters
     run): s-n-printf, s-printf, v-s-printf, str-cpy, str-n-cpy, str-cat, str-n-cat, gets;
     a fixed-size char array (a non-pointer declarator NAME[N] in a char declaration) whose line does not state its
     bound in a comment with the word "bounded:";
   and, inside string literals, a %.N precision (a silent cut; an abbreviation is spelled %.*s with its "..." shown).
   The scan proves itself first on samples of each kind (it must find every one), so it is not decorative. */
static int bnd_hits, bnd_files;
static int is_idc(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'; }
/* code: comments and the contents of string/char literals become spaces (newlines kept); lit: the reverse */
static void bnd_split(const char *t, size_t n, char *code, char *lit) {
    size_t i = 0; int st = 0;                 /* 0 code, 1 block comment, 2 line comment, 3 "..." 4 '...' */
    for (i = 0; i < n; i++) {
        char c = t[i], nx = i + 1 < n ? t[i + 1] : 0;
        code[i] = lit[i] = c == '\n' ? '\n' : ' ';
        if (st == 0) {
            if (c == '/' && nx == '*') { st = 1; i++; code[i] = lit[i] = ' '; continue; }
            if (c == '/' && nx == '/') { st = 2; continue; }
            code[i] = c;
            if (c == '"') st = 3; else if (c == '\'') st = 4;
        } else if (st == 1) { if (c == '*' && nx == '/') { st = 0; i++; code[i] = lit[i] = ' '; } }
        else if (st == 2) { if (c == '\n') st = 0; }
        else {
            if (c == '\\' && i + 1 < n) { lit[i] = c; i++; lit[i] = t[i] == '\n' ? ' ' : t[i]; code[i] = ' '; continue; }
            if ((st == 3 && c == '"') || (st == 4 && c == '\'')) { code[i] = c; st = 0; continue; }
            lit[i] = c == '\n' ? '\n' : c;
        }
    }
    code[n] = lit[n] = 0;
}
static const char *BND_CALLS[] = { "s" "nprintf", "s" "printf", "vs" "printf", "str" "cpy", "str" "ncpy", "str" "cat", "str" "ncat", "ge" "ts", 0 };
static int bnd_text(const char *label, const char *t, size_t n, int quiet) {
    char *code = xrealloc(0, n + 1), *lit = xrealloc(0, n + 1); size_t i, ls = 0; int line = 1, hits = 0, k;
    bnd_split(t, n, code, lit);
    for (i = 0; i <= n; i++) {
        if (i < n && code[i] != '\n') continue;
        {   /* one line: [ls, i) */
            const char *c = code + ls, *l = lit + ls, *o = t + ls; size_t L = i - ls, j;
            int bounded = 0;
            for (j = 0; j + 8 <= L; j++) if (!memcmp(o + j, "bounded:", 8)) bounded = 1;
            for (j = 0; j < L; j++) {
                if (!is_idc(c[j]) || (j && is_idc(c[j - 1]))) continue;
                for (k = 0; BND_CALLS[k]; k++) {
                    size_t q = strlen(BND_CALLS[k]), e = j + q;
                    if (e > L || memcmp(c + j, BND_CALLS[k], q) || (e < L && is_idc(c[e]))) continue;
                    while (e < L && c[e] == ' ') e++;
                    if (e < L && c[e] == '(') { if (!quiet) fprintf(stderr, "ujswasm-bounds: %s:%d: %s(...) (a printf-to-buffer or string copy)\n", label, line, BND_CALLS[k]); hits++; }
                }
                if (L - j >= 4 && !memcmp(c + j, "char", 4) && (j + 4 == L || !is_idc(c[j + 4]))) {
                    /* the declarators of this char declaration: depth-0 NAME[N] without a '*' before NAME */
                    size_t e = j + 4; int depth = 0, star = 0, init = 0;
                    for (; e < L; e++) {
                        char ch = c[e];
                        if (ch == '(' || ch == '{') depth++;
                        else if (ch == ')' || ch == '}') { if (--depth < 0) break; }
                        else if (depth == 0 && ch == ';') break;
                        else if (depth == 0 && ch == ',') { star = 0; init = 0; }
                        else if (depth == 0 && ch == '=') init = 1;
                        else if (depth == 0 && !init && ch == '*') star = 1;
                        else if (depth == 0 && !init && ch == '[' && !star) {
                            size_t b2 = e; while (b2 > j + 4 && c[b2 - 1] == ' ') b2--;
                            if (b2 > j + 4 && is_idc(c[b2 - 1])) {
                                size_t f = e + 1; while (f < L && c[f] == ' ') f++;
                                if (f < L && c[f] != ']' && !bounded) { if (!quiet) fprintf(stderr, "ujswasm-bounds: %s:%d: a fixed-size char array without a stated bound (\"bounded:\" comment)\n", label, line); hits++; }
                            }
                        }
                    }
                }
            }
            for (j = 0; j + 2 < L; j++)
                if (l[j] == '%' && l[j + 1] == '.' && l[j + 2] >= '0' && l[j + 2] <= '9') { if (!quiet) fprintf(stderr, "ujswasm-bounds: %s:%d: a %%.N precision in a format (a silent cut)\n", label, line); hits++; }
        }
        ls = i + 1; line++;
    }
    free(code); free(lit);
    return hits;
}
static int bnd_file(const char *path, void *ctx) {
    size_t n, L = strlen(path); char *b; (void)ctx;
    if (L < 3 || strcmp(path + L - 3, ".cx")) return 0;
    bnd_files++;
    if (!(b = cx_read(path, &n))) { fprintf(stderr, "ujswasm-bounds: %s: cannot read\n", path); bnd_hits++; return 0; }
    bnd_hits += bnd_text(path, b, n, 0);
    free(b);
    return 0;
}
static int bnd_selftest(void) {
    /* every line but the last two holds one finding (calls, arrays, precisions); the last two hold none */
    static const char *S =
        "  n = s" "nprintf(m, sizeof m, fmt, a);\n"
        "  s" "printf (m, fmt, a);\n"
        "  str" "cpy(d, s); \n"
        "  str" "cat(d, s);\n"
        "  str" "ncpy(d, s, 8);\n"
        "  char m[80];\n"
        "  static char *p, q[12];\n"
        "  unsigned char md[32]; const char *x = y[3];\n"
        "  printf(\"%" ".60s\", s);\n"
        "  char t[4]; /* bounded" ": a code point */ x = v" "snprintf(p, c, f, ap); char *f[8]; char u[] = \"x\";\n"
        "  /* char m[80]; s" "nprintf(m, 80, \"%" ".9s\"); */ x = \"s" "nprintf(m, 80) char z[9]\"; c = (unsigned char)d[i];\n";
    int got = bnd_text("selftest", S, strlen(S), 1);
    if (got != 9) { fprintf(stderr, "ujswasm-bounds: the scan found %d of the 9 sample findings (not trusted)\n", got); return 1; }
    return 0;
}

static int cmd_d1(const char *root) {
    char *d = xf("%s/flownet", root), *a = xf("%s/adapter/ujswasm", root); int rc = 0;
    if (cx_walk(d, d1_file, 0) < 0) { fprintf(stderr, "ujswasm-d1: %s: cannot read\n", d); return 1; }
    if (d1_files < 4) { fprintf(stderr, "ujswasm-d1: only %d .cx files under %s (want contract, nets, flow, api)\n", d1_files, d); return 1; }
    if (d1_hits) rc = 1;
    else printf("ujswasm-d1: PASS (%d .cx files under flownet/: no ujs, no Python)\n", d1_files);
    /* the class fix for silent truncation stays fixed: flownet/ and the adapter */
    if (bnd_selftest()) return 1;
    if (cx_walk(d, bnd_file, 0) < 0 || cx_walk(a, bnd_file, 0) < 0) { fprintf(stderr, "ujswasm-bounds: cannot walk %s or %s\n", d, a); return 1; }
    if (bnd_files < 8) { fprintf(stderr, "ujswasm-bounds: only %d .cx files (want flownet's 5 and the adapter's 3)\n", bnd_files); return 1; }
    if (bnd_hits) { fprintf(stderr, "ujswasm-bounds: %d finding(s)\n", bnd_hits); return 1; }
    printf("ujswasm-bounds: PASS (%d .cx files under flownet/ and adapter/ujswasm/: no printf-to-buffer or string copy, "
           "every fixed char array states its bound, no %%.N precision; self-test 9/9)\n", bnd_files);
    free(d); free(a);
    return rc;
}

int main(int argc, char **argv) {
    const char *cmd = argc > 1 ? argv[1] : "";
    if (!strcmp(cmd, "build")) return cmd_build(argc - 2, argv + 2);
    if (!strcmp(cmd, "check")) return cmd_check(argc > 2 ? argv[2] : ".");
    if (!strcmp(cmd, "refuse")) return cmd_refuse(argc > 2 ? argv[2] : ".");
    if (!strcmp(cmd, "negative")) return cmd_negative(argc > 2 ? argv[2] : ".");
    if (!strcmp(cmd, "d1")) return cmd_d1(argc > 2 ? argv[2] : ".");
    if (!strcmp(cmd, "accepts")) return cmd_accepts(argc > 2 ? argv[2] : ".");
    fprintf(stderr, "ujswasm: usage: build SRC -o OUT [--tables DIR] [--wat FILE] | check ROOT | refuse ROOT | negative ROOT | d1 ROOT | accepts ROOT\n");
    return 2;
}
