    "return", "break", "continue", "block", "expr",
    "neg", "not", "spread", "typeof", "prim",
    "index", "call", "dot", "done",
    "ident", "number", "string", "null", "true", "false",
    "list", "dict", "paren", "arrow", "bad", 0 };
static const char *TYS[] = { "null", "bool", "i64", "f64", "str", "list", "dict", "fn", "tup", 0 };
static const char *TOPS[] = { "+", "-", "*", "/", "%", "<", "<=", ">", ">=", "==", "!=",
    "&&", "||", "!", "=", "[]", ".", "call", "len", "keys", "in", "spread", ",", 0 };
static const char *TYOUT[] = { "null", "bool", "i64", "f64", "str", "list", "dict", "fn", "tup", "illegal", 0 };
static const char *CTX[] = { "mod", "fn", "block", "switch", "for", "expr", 0 };
static const char *KIND[] = { "bind", "load", "store", "param", "rest", "label", "break", "continue", 0 };
static const char *ACTS[] = { "ok", "shadow", "unbound", "readonly", "illegal", 0 };
static const char *KEYSIG[] = { "empty", "k1", "k2", "k3", "k4", "open", 0 };
static const char *SHAPES[] = { "s_null", "s_bool", "s_i64", "s_f64", "s_str", "s_list", "s_tup", "s_fn",
    "s_dict_empty", "s_dict_k1", "s_dict_k2", "s_dict_k3", "s_dict_k4", "s_dict_open", "s_unknown", 0 };
