static const char *TOKS[] = { "eof", "id", "num", "str", "null", "true", "false",
    "let", "function", "if", "else", "while", "for", "return",
    "break", "continue", "switch", "case", "default",
    "typeof", "of", "in",
    "{", "}", "(", ")", "[", "]", ";", ",", ":", ".", "?",
    "=", "==", "!=", "<", ">", "<=", ">=",
    "+", "-", "*", "/", "%", "&&", "||", "!", "??",
    "=>", "+=", "-=", "*=", "/=",
    "...", 0 };
