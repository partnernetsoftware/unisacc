/* adapter/ujswasm/tables.cx -- the ujs side of flownet's tables (plans/m4-flownet-cx-module.md W2): writes the
   external .tsv tables that flownet/ reads (the W0 ruling), for the m4 flow x net path ujs -> \0asm.
     contract.tsv     m4/contract.py as data: the 10 nets, the 4 flows and the nets each one is decided by, reserved,
                      the isel choice for eq/ne, and the two bookkeeping phases of m4/flows.py -- as revised by W4: m4's
                      observed nets (type, shape, ic) are consumed by ujswasm.cx's front end and wired into its front flow
     NET.gold.tsv     the label source: ujs/seed/construct/gold.py STAGES -- each field's values and the classes in
                      their order, and every key's gold label -- ported to .cx in the module ujsgold.cx (domains and
                      label functions; W3: the same port is injected into flownet as the adapter's label source)
     NET.net.tsv      the integer net for that gold, constructed natively by iterate/construct/construct.c, the C
                      port of unisa/construct.py build_net (the algorithm of `python3 -m ujs build-weights`, i.e.
                      unisa/intnet.build, whose Python is archived): this program writes each stage's gold in the
                      gold-table wire construct.c reads, runs it as a child, checks its canonical text against the
                      domain (classes, shape, exact over every key) and converts it.  The files' header line still
                      names that Python oracle: the bytes are frozen, and construct.c reproduces them exactly.
   The gold port is proven by acceptance, not by inspection: the oracle's nets are exact against the Python gold on
   every key (W1 baseline, acc 10/10), so flownet's acc over these files (gold from this port, nets from the oracle)
   is 10/10 exact only if the port agrees with gold.py on all 3677 keys.
   Usage (repository root; every step under tools/bound 55):
     sh ./unisacc.com -run adapter/ujswasm/tables.cx -- --write [ROOT]       re-write ROOT/adapter/ujswasm/tables
     sh ./unisacc.com -run adapter/ujswasm/tables.cx -- --check [ROOT]       re-make all in a scratch dir, cmp
     sh ./unisacc.com -run adapter/ujswasm/tables.cx -- --check-gold [ROOT]  contract + gold files only
   No mode needs Python.
   Errors: "ujswasm-tables: reason" on stderr, rc 1, stdout empty.  This adapter may name ujs; flownet/ may not. */

#pragma unisa use ujsgold

#define TDIR "adapter/ujswasm/tables"
#define NNETS 10
static const char *NETS[NNETS] = { "lex", "parse", "type", "scope", "shape", "irsel", "ic", "isel", "enc", "reloc" };

static void die(const char *a, const char *b) { fprintf(stderr, "ujswasm-tables: %s%s\n", a, b ? b : ""); exit(1); }

/* formatted text allocated to its exact length, never cut short (as in ujswasm.cx: format into a heap buffer, retry
   once at the reported size -- the m9 libc's vsnprintf hangs measuring a long %s with a null buffer) */
#define XF(fmt, out) do { va_list ap_; size_t cap_ = 256; int n_; char *p_ = 0, *g_; \
    for (;;) { \
        if (!(g_ = realloc(p_, cap_))) die("out of memory", 0); \
        p_ = g_; va_start(ap_, fmt); n_ = vsnprintf(p_, cap_, fmt, ap_); va_end(ap_); \
        if (n_ < 0) die("cannot format ", fmt); \
        if ((size_t)n_ < cap_) break; \
        cap_ = (size_t)n_ + 1; } \
    (out) = p_; } while (0)
static char *xf(const char *fmt, ...) { char *s; XF(fmt, s); return s; }
static void dief(const char *fmt, ...) { char *s; XF(fmt, s); die(s, 0); }

/* the gold port itself (domains, label functions, the stage registry) is the module adapter/ujswasm/ujsgold.cx, which
   the ujs adapter also injects into flownet as its label source (W3) */
static int eq(const char *a, const char *b) { return !strcmp(a, b); }
static int dlen(const char **d) { int n = 0; while (d[n]) n++; return n; }
#define ST(s) (*ujsgold_stage(s))

/* ---------- growable text ---------- */
typedef struct { char *s; size_t n, cap; } Buf;
static void badd(Buf *b, const char *s, size_t k) {
    if (b->n + k + 1 > b->cap) {
        size_t c = b->cap ? b->cap : 4096; char *g;
        while (c < b->n + k + 1) c *= 2;
        if (!(g = realloc(b->s, c))) die("out of memory", 0);
        b->s = g; b->cap = c;
    }
    memcpy(b->s + b->n, s, k); b->n += k; b->s[b->n] = 0;
}
static void bs(Buf *b, const char *s) { badd(b, s, strlen(s)); }
static void bi(Buf *b, long v) { char *t = xf("%ld", v); bs(b, t); free(t); }

static void domain(Buf *b, int s) {
    const UjsStage *S = &ST(s); int f, i;
    bs(b, "net\t"); bs(b, S->name); bs(b, "\n");
    for (f = 0; f < S->nf; f++) {
        bs(b, "field\t"); bs(b, S->fname[f]);
        for (i = 0; S->dom[f][i]; i++) { bs(b, "\t"); bs(b, S->dom[f][i]); }
        bs(b, "\n");
    }
    bs(b, "class");
    for (i = 0; S->cls[i]; i++) { bs(b, "\t"); bs(b, S->cls[i]); }
    bs(b, "\n");
}

static int nkeys(int s) { const UjsStage *S = &ST(s); int n = 1, f; for (f = 0; f < S->nf; f++) n *= dlen(S->dom[f]); return n; }

/* one row per key in cartesian-product order: field values, gold class (the same rows in both wires) */
static void key_rows(Buf *b, int s) {
    const UjsStage *S = &ST(s); int n = nkeys(s), k, f, rem, d[3]; const char *key[3];
    for (k = 0; k < n; k++) {
        rem = k;
        for (f = S->nf - 1; f >= 0; f--) { int r = dlen(S->dom[f]); d[f] = rem % r; rem /= r; }
        for (f = 0; f < S->nf; f++) { key[f] = S->dom[f][d[f]]; if (f) bs(b, "\t"); bs(b, key[f]); }
        bs(b, "\t"); bs(b, ujsgold_label_at(s, key)); bs(b, "\n");
    }
}

static void gold_file(Buf *b, int s) {
    bs(b, "# "); bs(b, ST(s).name);
    bs(b, ".gold.tsv -- GENERATED by adapter/ujswasm/tables.cx from its .cx port of ujs/seed/construct/gold.py; do not edit.\n"
          "# flownet label source: the domain, then one row per key in cartesian-product order: field values, gold class.\n");
    domain(b, s);
    key_rows(b, s);
}

/* the stage as construct.c's input, the gold-table wire of weights/gold/<stage>.tsv (unisa/tsvgold.py load_stage):
   "# stage NAME: ...", one #field row per field, the one head y with its classes, the column header, the key rows */
static void construct_input(Buf *b, int s) {
    const UjsStage *S = &ST(s); int f, i;
    bs(b, "# stage "); bs(b, S->name); bs(b, ": "); bi(b, nkeys(s));
    bs(b, " keys, written by adapter/ujswasm/tables.cx from adapter/ujswasm/ujsgold.cx\n");
    for (f = 0; f < S->nf; f++) {
        bs(b, "#field\t"); bs(b, S->fname[f]);
        for (i = 0; S->dom[f][i]; i++) { bs(b, "\t"); bs(b, S->dom[f][i]); }
        bs(b, "\n");
    }
    bs(b, "#head\ty\t-");
    for (i = 0; S->cls[i]; i++) { bs(b, "\t"); bs(b, S->cls[i]); }
    bs(b, "\n");
    for (f = 0; f < S->nf; f++) { bs(b, S->fname[f]); bs(b, "\t"); }
    bs(b, "=> y\n");
    key_rows(b, s);
}

static const char *CONTRACT =
    "# contract.tsv -- GENERATED by adapter/ujswasm/tables.cx from m4/contract.py as revised by flownet W4; do not edit.\n"
    "# flownet contract for ujs -> \\0asm: 10 nets; 4 flows; m4's measured revision of the 4 x 10 draft (lex, parse,\n"
    "# isel, enc decide output or refusal) revised by W4: the adapter's front end consumes type, shape and ic (each a\n"
    "# legal/refuse gate, measured by its selftest), so the front flow is decided by parse, type, shape and ic and no net\n"
    "# is observed; irsel, reloc, scope stay reserved; the isel choice for eq/ne (first = gold).\n"
    "net\tlex\tparse\ttype\tscope\tshape\tirsel\tic\tisel\tenc\treloc\n"
    "flow\tlex\tlex\n"
    "flow\tfront\tparse\ttype\tshape\tic\n"
    "flow\tselect\tisel\n"
    "flow\tencode\tenc\n"
    "reserved\tirsel\treloc\tscope\n"
    "choice\tisel\teq\ti64_cmp\tf64_cmp\n"
    "choice\tisel\tne\ti64_cmp\tf64_cmp\n"
    "phase\tfront(lex+parse)\tselect+encode\n";

/* ---------- the integer net: iterate/construct/construct.c, run as a child, read back as its canonical text ----------
   construct.c prints intnet.to_dict's fields in that order, one per line, space-separated: "stage NAME", "H N",
   "offs ...", "b1 ...", "head y CLASSES...", "feeds H0", then one "f C: UNITS..." per input coordinate, "w2 y", one
   "r J: CLASS,WEIGHT ..." per unit, "maxlogit M", "exact KEYS" (keys over which it verified the net exact). */
#define CONSTRUCT "iterate/construct/construct.c"
#define MAXTOK 1024
static char *cp, *tok[MAXTOK]; static int ntok; static const char *cnet;
static void cbad(const char *why, const char *what) { dief("%s: %s: %s%s", CONSTRUCT, cnet, why, what ? what : ""); }
/* the next line, split at spaces in place; its first word must be WANT */
static void cline(const char *want) {
    ntok = 0;
    while (*cp && *cp != '\n') {
        if (ntok == MAXTOK) cbad("a line with too many words: ", want);
        tok[ntok++] = cp;
        while (*cp && *cp != ' ' && *cp != '\n') cp++;
        if (*cp == ' ') *cp++ = 0;
    }
    if (*cp != '\n') cbad("output ends before the line ", want);
    *cp++ = 0;
    if (!ntok || !eq(tok[0], want)) cbad("want the line ", want);
}
/* a decimal integer in [LO, HI], the whole word, or followed by exactly STOP when STOP is not 0; *REST past STOP */
static long cnum(const char *t, long lo, long hi, int stop, const char **rest) {
    char *e; long v = strtol(t, &e, 10);
    if (e == t || v < lo || v > hi || (stop ? *e != stop : *e != 0)) cbad("not a number in range: ", t);
    if (rest) *rest = stop ? e + 1 : e;
    return v;
}

/* construct stage s in TMP and write its NET.net.tsv text to B */
static void net_file(Buf *b, int s, const char *tmp) {
    const UjsStage *S = &ST(s); Buf in = {0}; char *path, *o = 0, *argv[6]; const char *r;
    size_t n = 0; int rc, i, j, k, H, nc = dlen(S->cls), h0 = 0, off = 0;
    construct_input(&in, s);
    path = xf("%s/%s.tsv", tmp, S->name);
    if (cx_write(path, in.s, in.n)) die("cannot write ", path);
    free(in.s);
    argv[0] = "sh"; argv[1] = "./unisacc.com"; argv[2] = CONSTRUCT; argv[3] = "--"; argv[4] = path; argv[5] = 0;
    rc = cx_runv_timeout(argv, 30, &o, &n);
    cnet = S->name;
    if (rc) dief("%s %s: rc %d: %s", CONSTRUCT, S->name, rc, o ? o : "");
    if (!o) cbad("no output", 0);
    cp = o;
    cline("stage"); if (ntok != 2 || !eq(tok[1], S->name)) cbad("another stage", 0);
    cline("H"); if (ntok != 2) cbad("want H N", 0);
    H = (int)cnum(tok[1], 1, 100000, 0, 0);
    bs(b, "# "); bs(b, S->name);
    bs(b, ".net.tsv -- GENERATED by adapter/ujswasm/tables.cx from `python3 -m ujs build-weights` (unisa/intnet.build,\n"
          "# the construction oracle); do not edit.  flownet integer net: domain, H, offs, b1, then W1 as one feed row per input\n"
          "# coordinate (units it feeds) and W2 as one row per unit (class:weight).\n");
    domain(b, s);
    bs(b, "H\t"); bi(b, H); bs(b, "\n");
    /* offs: field f starts at the sum of the earlier fields' value counts */
    cline("offs"); if (ntok != S->nf + 1) cbad("offs differs from the fields", 0);
    bs(b, "offs");
    for (i = 0; i < S->nf; i++) {
        if (cnum(tok[i + 1], 0, 100000, 0, 0) != off) cbad("offs differs from the domain: ", tok[i + 1]);
        bs(b, "\t"); bi(b, off); off += dlen(S->dom[i]);
    }
    bs(b, "\n");
    h0 = off;
    cline("b1"); if (ntok != H + 1) cbad("b1 is not H long", 0);
    bs(b, "b1"); for (j = 0; j < H; j++) { bs(b, "\t"); bi(b, cnum(tok[j + 1], -100000, 100000, 0, 0)); } bs(b, "\n");
    /* one head y whose classes are the gold table's classes, in order */
    cline("head"); if (ntok != nc + 2 || !eq(tok[1], "y")) cbad("want one head y with the gold's classes", 0);
    for (k = 0; k < nc; k++) if (!eq(tok[k + 2], S->cls[k])) cbad("a class differs from gold: ", tok[k + 2]);
    cline("feeds"); if (ntok != 2 || cnum(tok[1], 0, 100000, 0, 0) != h0) cbad("feeds differs from the domain", 0);
    for (i = 0; i < h0; i++) {
        cline("f"); if (ntok < 2 || cnum(tok[1], 0, 100000, ':', &r) != i || *r) cbad("feed rows out of order", 0);
        bs(b, "feed\t"); bi(b, i);
        for (j = 2; j < ntok; j++) { bs(b, "\t"); bi(b, cnum(tok[j], 0, H - 1, 0, 0)); }
        bs(b, "\n");
    }
    cline("w2"); if (ntok != 2 || !eq(tok[1], "y")) cbad("want w2 y", 0);
    for (j = 0; j < H; j++) {
        cline("r"); if (ntok < 2 || cnum(tok[1], 0, 100000, ':', &r) != j || *r) cbad("w2 rows out of order", 0);
        bs(b, "w2\t"); bi(b, j);
        for (k = 2; k < ntok; k++) {
            long c = cnum(tok[k], 0, nc - 1, ',', &r);
            bs(b, "\t"); bi(b, c); bs(b, ":"); bi(b, cnum(r, -100000, 100000, 0, 0));
        }
        bs(b, "\n");
    }
    cline("maxlogit"); if (ntok != 2) cbad("want maxlogit M", 0);
    cline("exact"); if (ntok != 2 || cnum(tok[1], 0, 100000000, 0, 0) != nkeys(s)) cbad("not verified exact over every key", 0);
    if (*cp) cbad("text after the exact line", 0);
    free(o); free(path);
}

/* ---------- write / check ---------- */
static void put(const char *dir, const char *name, Buf *b) {
    char *path = xf("%s/%s", dir, name);
    if (cx_write(path, b->s, b->n)) die("cannot write ", path);
    free(path);
}

static int make(const char *root, const char *out, int with_nets) {
    Buf b = {0}; int s; char *name, *tmp = 0; const char *td = getenv("TMPDIR");
    if (with_nets) {
        if (chdir(root)) die("cannot enter ", root);          /* construct.c and unisacc.com are ROOT-relative */
        tmp = xf("%s/fnujsXXXXXX", td && *td ? td : "/tmp");   /* the guard's temp root: construct.c's inputs */
        if (!mkdtemp(tmp)) die("cannot make a scratch directory", 0);
    }
    bs(&b, CONTRACT); put(out, "contract.tsv", &b);
    for (s = 0; s < NNETS; s++) {
        b.n = 0; gold_file(&b, s);
        name = xf("%s.gold.tsv", ST(s).name); put(out, name, &b); free(name);
        if (with_nets) {
            b.n = 0; net_file(&b, s, tmp);
            name = xf("%s.net.tsv", ST(s).name); put(out, name, &b); free(name);
        }
    }
    if (tmp) {
        if (cx_rmtree(tmp)) die("cannot remove the scratch directory ", tmp);   /* include/unisa_safedel.h */
        free(tmp);
    }
    free(b.s);
    return 0;
}

static int same(const char *a, const char *b) {
    size_t na = 0, nb = 0; char *x = cx_read(a, &na), *y = cx_read(b, &nb); int r;
    r = x && y && na == nb && !memcmp(x, y, na);
    free(x); free(y);
    return r;
}

int main(int argc, char **argv) {
    const char *mode = argc > 1 ? argv[1] : "", *root = argc > 2 ? argv[2] : ".";
    char *dir, *tmp, *a, *c, *name, *rootabs; const char *td = getenv("TMPDIR");
    int s, k, bad = 0, nets = !eq(mode, "--check-gold");
    if (!eq(mode, "--write") && !eq(mode, "--check") && !eq(mode, "--check-gold"))
        die("usage: tables.cx -- --write|--check|--check-gold [ROOT]", 0);
    if (!(rootabs = realpath(root, 0))) die("no such root: ", root);     /* allocated at its length */
    dir = xf("%s/%s", rootabs, TDIR);
    if (eq(mode, "--write")) {
        make(rootabs, dir, 1);
        printf("ujswasm-tables: wrote %s (contract + %d nets x gold, net)\n", TDIR, NNETS);
        return 0;
    }
    tmp = xf("%s/fntabXXXXXX", td && *td ? td : "/tmp");
    if (!mkdtemp(tmp)) die("cannot make a scratch directory", 0);
    make(rootabs, tmp, nets);
    for (s = -1; s < NNETS; s++)
        for (k = 0; k < (s < 0 ? 1 : nets ? 2 : 1); k++) {
            name = s < 0 ? xf("contract.tsv") : xf("%s.%s.tsv", ST(s).name, k ? "net" : "gold");
            a = xf("%s/%s", dir, name); c = xf("%s/%s", tmp, name);
            if (!same(a, c)) { fprintf(stderr, "ujswasm-tables: %s/%s: differs from a fresh make (or is missing)\n", TDIR, name); bad++; }
            free(a); free(c); free(name);
        }
    if (cx_rmtree(tmp)) die("cannot remove the scratch directory ", tmp);
    if (bad) return 1;
    printf("ujswasm-tables: %s: contract + %d gold%s tables identical to a fresh make%s\n", TDIR, NNETS,
           nets ? " + net" : "", nets ? " (nets: " CONSTRUCT ", no Python)" : " (no Python)");
    return 0;
}
