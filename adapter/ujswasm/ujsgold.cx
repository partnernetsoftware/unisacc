/* adapter/ujswasm/ujsgold.cx -- the ujs gold as a .cx module (plans/m4-flownet-cx-module.md W3): the domains and label
   functions of ujs/seed/construct/gold.py STAGES (with catalog.py's vocabularies), ported to .cx in W2 and moved here
   from tables.cx so that two users share one port:
     tables.cx    writes adapter/ujswasm/tables/NET.gold.tsv from it (the stock label source of fn_open, and the files
                  the derived-consistency step compares)
     ujswasm.cx   injects it into flownet as the adapter's label source (fn_label_source(ujsgold_domain, ujsgold_label,
                  0)): flownet asks every key once when it opens the tables and takes the nets' gold from here
   The port is proven by acceptance: the oracle's integer nets (python3 -m ujs build-weights, outside this file) are
   exact against the Python gold on every key, so flownet's acc over this source is 10/10 exact only if the port agrees
   with gold.py on all 3677 keys.  This module may name ujs; flownet/ may not (D1). */

enum { UJSGOLD_NETS = 10 };

/* ---------- the ujs domains (gold.py, catalog.py), in their order ---------- */
static const char *CHARC[] = { "eof", "nl", "ws", "A", "D", "Q", "S", "P", "O", "other", 0 };
static const char *LEXACT[] = { "eof", "ws", "nl", "id", "num", "str", "punct", "op", "bad", 0 };
static const char *NT[] = { "top", "stmt", "unary", "postfix", "primary", "pswitch", 0 };
static const char *TOKS[] = { "eof", "id", "num", "str", "null", "true", "false",
    "let", "function", "if", "else", "while", "for", "return",
    "break", "continue", "switch", "case", "default",
    "typeof", "of", "in",
    "{", "}", "(", ")", "[", "]", ";", ",", ":", ".", "?",
    "=", "==", "!=", "<", ">", "<=", ">=",
    "+", "-", "*", "/", "%", "&&", "||", "!", "??",
    "=>", "+=", "-=", "*=", "/=",
    "...", 0 };
static const char *PRODS[] = { "end", "fn", "let", "if", "while", "for", "switch", "case", "default",
    "return", "break", "continue", "block", "expr",
    "neg", "not", "spread", "typeof", "prim",
    "index", "call", "dot", "done",
    "ident", "number", "string", "null", "true", "false",
    "list", "dict", "paren", "arrow", "bad", 0 };
static const char *TYS[] = { "null", "bool", "i64", "f64", "str", "list", "dict", "fn", "tup", 0 };
static const char *TOPS[] = { "+", "-", "*", "/", "%", "<", "<=", ">", ">=", "==", "!=",
    "&&", "||", "!", "=", "[]", ".", "call", "len", "keys", "in", "spread", ",", 0 };
static const char *TYOUT[] = { "null", "bool", "i64", "f64", "str", "list", "dict", "fn", "tup", "illegal", 0 };
static const char *CTX[] = { "mod", "fn", "block", "switch", "for", "expr", 0 };
static const char *KIND[] = { "bind", "load", "store", "param", "rest", "label", "break", "continue", 0 };
static const char *ACTS[] = { "ok", "shadow", "unbound", "readonly", "illegal", 0 };
static const char *KEYSIG[] = { "empty", "k1", "k2", "k3", "k4", "open", 0 };
static const char *SHAPES[] = { "s_null", "s_bool", "s_i64", "s_f64", "s_str", "s_list", "s_tup", "s_fn",
    "s_dict_empty", "s_dict_k1", "s_dict_k2", "s_dict_k3", "s_dict_k4", "s_dict_open", "s_unknown", 0 };
static const char *FAMILY[] = { "arith", "cmp", "logic", "mem", "ctrl", "call", "data", "ic", "host", 0 };
static const char *FLAVOR[] = { "i64", "f64", "bool", "str", "list", "dict", "any",
    "br", "br_if", "ret", "switch", "enter", "print", 0 };
static const char *RECIPE[] = { "op_add", "op_sub", "op_mul", "op_div", "op_mod",
    "op_cmp", "op_logic", "op_load", "op_store", "op_idx",
    "op_jump", "op_call", "op_ret", "op_mk", "op_ic", "op_host", "bad", 0 };
static const char *IC_OPS[] = { "add", "sub", "mul", "div", "mod", "lt", "eq", "idx", "setidx", "dot", "call", "len", "in", 0 };
static const char *GUARDS[] = { "none", "type_ok", "len_ok", "key_ok", "mono", 0 };
static const char *STUBS[] = { "interp", "add_i64", "add_f64", "sub_i64", "mul_i64", "div_f64",
    "cmp_i64", "cmp_f64", "idx_list", "idx_dict", "idx_str", "set_list", "set_dict",
    "dot_dict", "call_fn", "len_list", "len_str", "in_dict", "bad", 0 };
static const char *JOPS[] = { "nop", "const", "load_l", "store_l", "load_g", "store_g", "drop",
    "add", "sub", "mul", "div", "mod", "lt", "le", "gt", "ge", "eq", "ne",
    "and", "or", "not", "idx", "setidx", "dot", "len", "keys", "in",
    "mklist", "mkdict", "mktup", "jump", "jumpz", "jumpnz",
    "call", "ret", "spread", "restpack", "typeof", "shapeof", "switch", "ic_enter", "print", 0 };
static const char *WASM_FORMS[] = { "nop", "i64_bin", "f64_bin", "i64_cmp", "f64_cmp",
    "bool_logic", "local", "global", "const", "br", "br_if", "call", "ret",
    "poly_bin", "heap", "typeof", "host", "trap", 0 };
