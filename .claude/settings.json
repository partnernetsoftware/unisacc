{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ./tools/bound 9 sh ./unisacc.com tools/guard-hook.cx",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ./tools/bound 38 sh ./unisacc.com tools/auto-continue.cx || true",
            "timeout": 40
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ./tools/bound 18 sh ./unisacc.com tools/on-change.cx -- --hook || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
