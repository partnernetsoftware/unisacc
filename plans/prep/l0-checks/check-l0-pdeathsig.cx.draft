/* red draft: PDEATHSIG. Final form: a middle process spawns a grandchild with SY_SPAWN_PDEATHSIG and exits; the
   grandchild must be gone within 1s. Linux prctl(PR_SET_PDEATHSIG); osx/win sy_pdeathsig returns -ENOSYS (refuse column).
   Oracle: C fork + prctl + getppid loop. */
#pragma unisa use sys.proc
int main(void) {
    int r = sy_pdeathsig(9);
    int f = SY_SPAWN_PDEATHSIG;
    int ok = (r == 0 || r == -38) && f != 0;
    printf("CHECK_L0_PDEATHSIG %s r=%d\n", ok ? "PASS" : "FAIL", r);
    return !ok;
}
