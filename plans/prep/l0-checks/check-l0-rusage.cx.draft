/* red draft: rusage fill. Child burns CPU; sy_wait_rusage fills user_ms+sys_ms >= 50 and maxrss_kb > 0.
   Oracle: wait4(2) ru_utime/ru_stime/ru_maxrss; cross-check /proc/self/stat cutime (tools/cpu-meter.cx path). */
#pragma unisa use sys.proc
int main(void) {
    char *a[] = {"sh", "-c", "i=0; while [ $i -lt 200000 ]; do i=$((i+1)); done", 0};
    sy_rusage_t ru;
    int pid = sy_spawn(a);
    int r = sy_wait_rusage(pid, 0, &ru);
    int ok = r == pid && ru.user_ms + ru.sys_ms >= 50 && ru.maxrss_kb > 0;
    printf("CHECK_L0_RUSAGE %s\n", ok ? "PASS" : "FAIL");
    return !ok;
}
