/* red draft: L0 two-buffer capture run. SY_SPAWN_STDERR_SPLIT already exists in sy_spawn_pipe; the gap is an L0 run
   that drains both pipes (no deadlock past 64KiB) under a deadline. Child writes 256KiB to stderr then "out\n".
   Oracle: sh -c '... 2>e >o' then byte compare. */
#pragma unisa use sys.proc
int main(void) {
    sy_spawn_t o; sy_exit_t st; sy_capture_t cap;
    char *a[] = {"sh", "-c", "head -c 262144 /dev/zero >&2; echo out", 0};
    sy_spawn_init(&o); o.argv = a; o.deadline_ms = 20000;
    int r = sy_proc_capture(&o, &st, &cap, 1 << 20);
    int ok = r == 0 && cap.errn == 262144 && cap.outn == 4 && st.exited && st.code == 0;
    sy_capture_free(&cap);
    printf("CHECK_L0_CAPTURE %s\n", ok ? "PASS" : "FAIL");
    return !ok;
}
