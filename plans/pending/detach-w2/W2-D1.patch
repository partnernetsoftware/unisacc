+            for (i = 0; i < m; i++) if (hexval((unsigned char)r->hex[i]) < 0) fail("%s: EXPECT is not lowercase hex (%s)", rel, r->group);
+        } else if (strcmp(r->hex, "-")) fail("%s: a reject row's EXPECT must be - (%s)", rel, r->group);
