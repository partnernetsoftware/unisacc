+#!/usr/bin/env -S unisacc.com -run
+/* encrefcheck.cx -- the arm64 / Windows x86 encoder referee checks without the Python seed (2026-10-23, unisa detach
+   W2-D1, plans/unisa-detach.md): exec/enc/{armcheck,armmemcheck,armbranchcheck,armintcheck,armfpcheck,arminputcheck,
+   armlayoutcheck,armwincheck,x86wincheck}.py in one .cx.  Those scripts computed the expected bytes with unisa
+   (emit_arm.encode, assemble, lower + tests/enc/tins.py); here the expected bytes are frozen data, captured once while
+   unisa was live (the header of each table names the capture), and the checks are the .py's checks on them.
+   usage: sh ./tests/cxbin exec/enc/encrefcheck.cx arm    RUN ARM.tbl ARM.json   (job exec-arm, exec/enc/armcheck.sh)
+          sh ./tests/cxbin exec/enc/encrefcheck.cx armwin RUN ARM.tbl            (job exec-armwin, exec/enc/armwincheck.sh)
+          sh ./tests/cxbin exec/enc/encrefcheck.cx x86win RUN MODEL             (job exec-x86win, exec/enc/x86wincheck.sh)
+          sh ./tests/cxbin exec/enc/encrefcheck.cx tins [--full] [--target T] FILE   (tests/cxlib/tins.cx: dump(parse(FILE)))
+   Tables: exec/enc/arm-ref.tsv (groups ref mem branch branch.absent int fp input input.worked layout armwin) and
+   exec/enc/x86win-ref.tsv (x86win.setup x86win.real); columns GROUP KIND SOURCE EXPECT NOTE, SOURCE with \n \t \\
+   escapes, KIND bytes (EXPECT = the lowercase hex the executor must write, rc 0) or reject (EXPECT `-`: rc 1, no
+   stdout, `not covered` on stderr -- checklib.notcovered).  Every accepted SOURCE must also be well-formed TIns text
+   (tins_parse); its instruction count is what the summary lines print where the .py printed len(lines)/stats['insns'].
+   The fixed numbers the .py printed as literals (12 rejects, 10 fixtures, ...) are asserted against the table.
+   Executors: RUN on the given model, and when that model is a flat table (*.tbl) also RUN on its threshold network
+   built here by seed/net.c (byte-identical to exec/c/net.py).  The .py's second executor was the Python simulator
+   exec/pp/sim.py, of which exec/c/run.c is the C machine action for action; run.c on the table against run.c on the
+   network keeps two independent model forms.  The arm group also runs the synthetic BR.range helper contexts of
+   armbranchcheck.py: the delta JSON is extended in text (8 cases, the RET return, the byte-printing state) and
+   tabled by seed/tbl.c (byte-identical to exec/c/tbl.py); the expected bytes are arithmetic, as there.
+   Native execution (Darwin/arm64 only, as the .py: the delta's bytes against the system assembler and C, for the
+   reference ops, memory, branches and integer/frame) is generated here as the .py generated it; on any other host
+   the same SKIPPED lines are printed.  ARM64 FP native (exec/enc/fpcheck.py) runs from exec/enc/armcheck.sh.
+   ENCREF_NATIVE_DRY=DIR treats the host as native but only writes each harness to DIR/NAME.{s,c} (no cc, no run)
+   and prints the .py's lines -- to compare the generated harness text; never set by a gate job.
+   A failed check: one `AssertionError: ...` line on stderr, rc 1.  ROOT is the grandparent of this file's directory.
+   Tools are built with $SEED_GEN_CC (default cc) -std=c99 -O2 -w in a fresh TMPDIR/encref-XXXXXXXX, removed at exit. */
+#pragma unisa use cxlib.pytempfile
+#pragma unisa use cxlib.hostcheck
+#pragma unisa use cxlib.tins
+#include <stdarg.h>   /* va_list for bfmt: not in the cx prelude (edition 1) */
+
+#define PATHN 4096
+static char ROOT[PATHN], TD[PATHN];
+static const char *RUN;
+static char *MODEL[2]; static int NMODEL;
+static int NATIVE; static const char *DRY;
+
+static void cleanup(void) { if (TD[0]) { ptf_rmtree(TD); TD[0] = 0; } }
+static void fail(const char *fmt, const char *a, const char *b) {
+    fflush(stdout);
+    fprintf(stderr, "AssertionError: "); fprintf(stderr, fmt, a ? a : "", b ? b : ""); fprintf(stderr, "\n");
+    cleanup(); exit(1);
+}
+static void *xmalloc(size_t n) { void *p = malloc(n ? n : 1); if (!p) fail("MemoryError", 0, 0); return p; }
+static char *tdpath(const char *name) { char *p = xmalloc(PATHN); snprintf(p, PATHN, "%s/%s", TD, name); return p; }
+static void putfile(const char *path, const void *p, size_t n) { if (cx_write(path, p, n)) fail("cannot write %s", path, 0); }
+
+/* ---------- growable text ---------- */
+typedef struct { char *s; size_t n, cap; } Buf;
+static void bput(Buf *b, const char *s, size_t n) {
+    if (b->n + n + 1 > b->cap) {
+        size_t c = b->cap ? b->cap : 256; while (c < b->n + n + 1) c *= 2;
+        b->s = realloc(b->s, c); if (!b->s) fail("MemoryError", 0, 0); b->cap = c;
+    }
+    memcpy(b->s + b->n, s, n); b->n += n; b->s[b->n] = 0;
+}
+static void bstr(Buf *b, const char *s) { bput(b, s, strlen(s)); }
+static void bfmt(Buf *b, const char *fmt, ...) {
+    char t[2048]; va_list ap; int n;
+    va_start(ap, fmt); n = vsnprintf(t, sizeof t, fmt, ap); va_end(ap);
+    if (n < 0 || n >= (int)sizeof t) fail("format overflow", 0, 0);
+    bput(b, t, (size_t)n);
+}
+
+/* ---------- a child with stdout/stderr captured (subprocess.run(..., capture_output=True, timeout=60)) ---------- */
+typedef struct { int rc; char *out; size_t outn; char *err; size_t errn; } Res;
+/* wait for PID (its own process group) at most 60 s, as subprocess.run(timeout=60): past that the group is killed */
+static void reap(pid_t pid, int *st, const char *what) {
+    long ticks = 0; pid_t w;
+    for (;;) {
+        w = waitpid(pid, st, WNOHANG);
+        if (w == pid) return;
+        if (w < 0 && errno != EINTR) fail("wait failed", 0, 0);
+        if (++ticks > 600000) { kill(-pid, SIGKILL); kill(pid, SIGKILL); waitpid(pid, st, 0); fail("%s timed out after 60 seconds", what, 0); }
+        usleep(ticks < 1000 ? 50 : 100);
+    }
+}
+static void res_free(Res *r) { free(r->out); free(r->err); r->out = r->err = 0; }
+static void exe(char *const argv[], Res *r) {
+    char op[PATHN], ep[PATHN]; int of, ef, st = 0; pid_t pid;
+    snprintf(op, sizeof op, "%s/.out", TD); snprintf(ep, sizeof ep, "%s/.err", TD);
+    of = open(op, O_WRONLY | O_CREAT | O_TRUNC, 0600); ef = open(ep, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+    if (of < 0 || ef < 0) fail("cannot capture output in %s", TD, 0);
+    fflush(stdout); fflush(stderr);
+    pid = fork();
+    if (pid < 0) fail("fork failed", 0, 0);
+    if (pid == 0) {
+        int nul = open("/dev/null", O_RDONLY);
+        if (nul >= 0) { dup2(nul, 0); close(nul); }
+        dup2(of, 1); dup2(ef, 2); close(of); close(ef);
+        setpgid(0, 0);
+        execvp(argv[0], argv); _exit(127);
+    }
+    close(of); close(ef);
+    reap(pid, &st, argv[0]);
+    r->rc = WIFSIGNALED(st) ? -WTERMSIG(st) : WEXITSTATUS(st);
+    r->out = cx_read(op, &r->outn); r->err = cx_read(ep, &r->errn);
+    if (!r->out) { r->out = xmalloc(1); r->outn = 0; }
+    if (!r->err) { r->err = xmalloc(1); r->errn = 0; }
+}
+static void checked(char *const argv[]) {
+    Res r; exe(argv, &r);
+    if (r.rc) { fflush(stdout); fwrite(r.err, 1, r.errn, stderr); fail("command failed: %s (rc != 0)", argv[0], 0); }
+    res_free(&r);
+}
+static const char *envor(const char *k, const char *d) { const char *v = getenv(k); return v && *v ? v : d; }
+/* seed/<name>.c -> TD/seed-<name>, several in parallel */
+static void build_seed(const char *const *names, int n) {
+    pid_t pid[4]; int i, st;
+    fflush(stdout); fflush(stderr);
+    for (i = 0; i < n; i++) {
+        char src[PATHN], out[PATHN], inc[PATHN];
+        snprintf(src, sizeof src, "%s/seed/%s.c", ROOT, names[i]); snprintf(out, sizeof out, "%s/seed-%s", TD, names[i]);
+        snprintf(inc, sizeof inc, "%s/seed", ROOT);
+        pid[i] = fork();
+        if (pid[i] < 0) fail("fork failed", 0, 0);
+        if (pid[i] == 0) {
+            char *argv[] = { (char *)envor("SEED_GEN_CC", "cc"), "-std=c99", "-O2", "-w", "-I", inc, src, "-o", out, 0 };
+            setpgid(0, 0); execvp(argv[0], argv); _exit(127);
+        }
+    }
+    for (i = 0; i < n; i++) {
+        reap(pid[i], &st, names[i]);
+        if (!WIFEXITED(st) || WEXITSTATUS(st)) fail("cannot build seed/%s.c", names[i], 0);
+    }
+}
+static int endswith(const char *s, const char *t) { size_t a = strlen(s), b = strlen(t); return a >= b && !strcmp(s + a - b, t); }
+/* MODEL[0] = the given model; a flat table also gets its threshold network as MODEL[1] */
+static void models(const char *model, int need_tbl) {
+    const char *names[2] = { "net", "tbl" };
+    MODEL[0] = (char *)model; NMODEL = 1;
+    if (endswith(model, ".tbl") || need_tbl) build_seed(names, need_tbl ? 2 : 1);
+    if (endswith(model, ".tbl")) {
+        char *net = tdpath("model.net"), *seed = tdpath("seed-net");
+        char *argv[] = { seed, (char *)model, net, 0 };
+        checked(argv);
+        MODEL[1] = net; NMODEL = 2;
+    }
+}
+
+/* ---------- the frozen tables ---------- */
+typedef struct { char *group, *kind, *src, *hex, *note; size_t srcn; int line; } Row;
+static Row *ROWS; static int NROWS;
+static int hexval(int c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1; }
+static void load(const char *rel) {
+    char path[PATHN], *t, *s, *e; size_t n; int line = 0;
+    snprintf(path, sizeof path, "%s/%s", ROOT, rel);
+    if (!(t = cx_read(path, &n))) fail("cannot read %s", path, 0);
+    for (s = t; s < t + n; s = e + 1) {
+        char *f[6]; int k = 0; Row *r;
+        e = memchr(s, '\n', (size_t)(t + n - s)); if (!e) e = t + n;
+        *e = 0; line++;
+        if (!*s || *s == '#') continue;
+        f[k++] = s;
+        for (char *q = s; *q && k < 6; q++) if (*q == '\t') { *q = 0; f[k++] = q + 1; }
+        if (k != 5) fail("%s: a row without 5 columns", rel, 0);
+        ROWS = realloc(ROWS, (size_t)(NROWS + 1) * sizeof *ROWS); if (!ROWS) fail("MemoryError", 0, 0);
+        r = &ROWS[NROWS++]; r->group = f[0]; r->kind = f[1]; r->hex = f[3]; r->note = f[4]; r->line = line;
+        {   /* unescape \n \t \\ */
+            char *d = xmalloc(strlen(f[2]) + 1), *q = f[2]; size_t m = 0;
+            for (; *q; q++) {
+                if (*q == '\\' && (q[1] == 'n' || q[1] == 't' || q[1] == '\\')) { q++; d[m++] = *q == 'n' ? '\n' : *q == 't' ? '\t' : '\\'; }
+                else if (*q == '\\') fail("%s: a bad escape in SOURCE", rel, 0);
+                else d[m++] = *q;
+            }
+            d[m] = 0; r->src = d; r->srcn = m;
+        }
+        if (strcmp(r->kind, "bytes") && strcmp(r->kind, "reject")) fail("%s: unknown KIND %s", rel, r->kind);
+        if (!strcmp(r->kind, "bytes")) {
+            size_t m = strlen(r->hex), i;
