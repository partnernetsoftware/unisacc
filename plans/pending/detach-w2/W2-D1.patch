+static int tins_cli(int argc, char **argv) {
+    int full = 0, i; const char *target = "lnx/x86_64", *file = 0; char *t, *o, err[512]; size_t n; tins_prog p;
+    for (i = 2; i < argc; i++) {
+        if (!strcmp(argv[i], "--full")) full = 1;
+        else if (!strcmp(argv[i], "--target") && i + 1 < argc) target = argv[++i];
+        else file = argv[i];
+    }
+    if (!file || !(t = cx_read(file, &n))) { fprintf(stderr, "usage: encrefcheck.cx tins [--full] [--target T] FILE\n"); return 2; }
+    if (tins_parse(t, n, target, &p, err, sizeof err)) { printf("ValueError: %s\n", err); return 1; }
+    if (!(o = tins_dump(&p, full, err, sizeof err))) { printf("ValueError: %s\n", err); tins_free(&p); return 1; }
+    fputs(o, stdout); free(o); tins_free(&p); free(t);
+    return 0;
+}
