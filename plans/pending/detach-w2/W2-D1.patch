+/* run INPUT (bytes) on executor K: RUN MODEL[K] TD/in */
+static void run_on(int k, const char *model, const void *in, size_t n, Res *r) {
+    char *f = tdpath("in");
+    char *argv[] = { (char *)RUN, (char *)model, f, 0 };
+    putfile(f, in, n);
+    exe(argv, r); free(f);
