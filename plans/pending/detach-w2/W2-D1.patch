+static int notcovered(const Res *r) {
+    size_t i;
+    if (r->rc != 1 || r->outn) return 0;
+    for (i = 0; i + 11 <= r->errn; i++) if (!memcmp(r->err + i, "not covered", 11)) return 1;
+    return 0;
