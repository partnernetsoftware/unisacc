diff --git a/tests/cxlib/tins.cx b/tests/cxlib/tins.cx
new file mode 100644
index 0000000..4765fda
--- /dev/null
+++ b/tests/cxlib/tins.cx
@@ -0,0 +1,386 @@
+/* tins.cx -- the TIns text tool of tests/enc/tins.py as a .cx module (2026-10-23, unisa detach W2-D1; plans/unisa-detach.md
+   row tests/enc/tins.py).  TIns text (archive/docs/exec/e5-tins-interface.md) is the lowered program as text: one
+   instruction per line `op a, b, ... key=value ...`; `name:` lines give labels (several may share an index; a label past
+   the last instruction comes last); a full program starts with `@` header lines.  This is the text format only: it
+   computes no machine code, layout, offsets or short branches, and it has no reference semantics (the Python side built
+   a unisa.lower.TargetProgram; here the program is the plain struct below).
+   Use it with `#pragma unisa use cxlib.tins` from a .cx file in tests/ (exec/enc/ reaches it through exec/enc/cxlib/).
+     tins_parse(TEXT, N, TARGET, &prog, err, cap)   tins.parse(TEXT, target=TARGET): 0, or -1 with the ValueError text in
+                                                    ERR (the same messages; an int() failure is Python's `invalid literal
+                                                    for int() with base 10: '...'`)
+     tins_dump(&prog, FULL, err, cap)               tins.dump(prog, full=FULL): malloc'd text, or 0 with the ValueError text
+     tins_free(&prog)
+   Values follow tins._val: `'TEXT` is the string TEXT, true/false a bool, anything int(s, 0) reads an int (kept as its
+   canonical decimal text, so 0x10 is 16 and no width limit applies), else a string; an argument with a blank is the
+   tagged pair `KIND VALUE` (only its first two words, as the .py split it).  Meta keys are exec/facts/enc-tins-meta.tsv
+   (read from ROOT given to tins_set_root, default the working directory); meta pairs are kept in the order tins.py's
+   dict held them: the line is read from its end, so `dump(parse(x))` lists them reversed.  spinit's absent second
+   operand is simply not stored (tins.py appended None and dump dropped it again).
+   No exported objects or macros (CXIF v0). */
+#pragma unisa module tins
+
+enum { TINS_NONE = 0, TINS_INT, TINS_BOOL, TINS_STR, TINS_TAG };
+typedef struct tins_val { int kind; char *s; int b; struct tins_val *sub; } tins_val;   /* INT: decimal; STR: text; TAG: kind + sub */
+typedef struct { char *key; tins_val v; } tins_meta;
+typedef struct { char *op; tins_val *arg; int narg; tins_meta *meta; int nmeta; } tins_ins;
+typedef struct { char *name; int pc; } tins_label;
+typedef struct { char *name; char *addr; } tins_sym;
+typedef struct {
+    char target[64]; char *data;                      /* data: lowercase hex, "" for none */
+    char *src_os, *data_len, *bss, *relocs;          /* 0 when the header line is absent; relocs: "1,2" or "" */
+    int threads;
+    tins_sym *sym; int nsym;
+    tins_label *label; int nlabel;
+    tins_ins *code; int ncode;
+} tins_prog;
+
+static char TINS_ROOT[4096];
+static char *TINS_META[64]; static int TINS_NMETA = -1;
+void tins_set_root(const char *root) { snprintf(TINS_ROOT, sizeof TINS_ROOT, "%s", root); TINS_NMETA = -1; }
+
+static void *tins_xmalloc(size_t n) { void *p = malloc(n ? n : 1); if (!p) { fprintf(stderr, "MemoryError\n"); exit(1); } return p; }
+static char *tins_dupn(const char *s, size_t n) { char *d = tins_xmalloc(n + 1); memcpy(d, s, n); d[n] = 0; return d; }
+static char *tins_dup(const char *s) { return tins_dupn(s, strlen(s)); }
+static void *tins_grow(void *p, int n, size_t each) {   /* room for element n (0-based) */
+    if ((n & (n - 1)) == 0 || n == 0) { p = realloc(p, (size_t)(n ? 2 * n : 4) * each); if (!p) { fprintf(stderr, "MemoryError\n"); exit(1); } }
+    return p;
+}
+
+/* exec/facts/enc-tins-meta.tsv: one key per line, `#` lines are comments */
+static int tins_load_meta(char *err, size_t cap) {
+    char path[4200], *t, *s, *e; size_t n;
+    if (TINS_NMETA >= 0) return 0;
+    snprintf(path, sizeof path, "%s%sexec/facts/enc-tins-meta.tsv", TINS_ROOT, TINS_ROOT[0] ? "/" : "");
+    t = cx_read(path, &n);
+    if (!t) { snprintf(err, cap, "cannot read %s", path); return -1; }
+    TINS_NMETA = 0;
+    for (s = t; s < t + n; s = e + 1) {
+        e = memchr(s, '\n', (size_t)(t + n - s)); if (!e) e = t + n;
+        if (e > s && *s != '#' && TINS_NMETA < 64) {
+            const char *q = memchr(s, '\t', (size_t)(e - s));
+            TINS_META[TINS_NMETA++] = tins_dupn(s, (size_t)((q ? q : e) - s));
+        }
+    }
+    free(t);
+    return 0;
+}
+static int tins_is_meta(const char *k) { int i; for (i = 0; i < TINS_NMETA; i++) if (!strcmp(TINS_META[i], k)) return 1; return 0; }
+
+/* ---------- int(s, BASE) of Python, to canonical decimal text ---------- */
+static int tins_ws(int c) { return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f' || (c >= 0x1c && c <= 0x1f); }
+static int tins_digit(int c) {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'z') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'Z') return c - 'A' + 10;
+    return 99;
+}
+/* 1 and the decimal text in OUT (malloc'd) when S is a Python int literal in BASE (0: with 0x/0o/0b prefixes) */
+static int tins_int(const char *s, int base, char **out) {
+    const char *p = s, *e = s + strlen(s); int neg = 0, b = base, under_ok = 0, nd = 0, allzero = 1;
+    unsigned char *dec; size_t dn = 1, i;
+    while (p < e && tins_ws((unsigned char)*p)) p++;
+    while (e > p && tins_ws((unsigned char)e[-1])) e--;
+    if (p < e && (*p == '+' || *p == '-')) neg = *p++ == '-';
+    if (b == 0) {
+        if (e - p >= 2 && p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) { b = 16; p += 2; under_ok = 1; }
+        else if (e - p >= 2 && p[0] == '0' && (p[1] == 'o' || p[1] == 'O')) { b = 8; p += 2; under_ok = 1; }
+        else if (e - p >= 2 && p[0] == '0' && (p[1] == 'b' || p[1] == 'B')) { b = 2; p += 2; under_ok = 1; }
+        else b = 10;
+    }
+    if (p >= e) return 0;
+    dec = tins_xmalloc((size_t)(e - p) * 2 + 2); dec[0] = 0;   /* little-endian decimal digits */
+    for (; p < e; p++) {
+        int d, carry;
+        if (*p == '_') {
+            if (!under_ok || p + 1 >= e || p[1] == '_') { free(dec); return 0; }
+            under_ok = 0; continue;
+        }
+        d = tins_digit((unsigned char)*p);
+        if (d >= b) { free(dec); return 0; }
+        under_ok = 1; nd++;
+        if (d) allzero = 0;
+        carry = d;
+        for (i = 0; i < dn; i++) { int v = dec[i] * b + carry; dec[i] = (unsigned char)(v % 10); carry = v / 10; }
+        while (carry) { dec[dn++] = (unsigned char)(carry % 10); carry /= 10; }
+    }
+    if (!nd) { free(dec); return 0; }
+    if (base == 0 && b == 10 && !allzero) {   /* base 0: a nonzero decimal may not start with 0 */
+        const char *q = s; while (tins_ws((unsigned char)*q)) q++;
+        if (*q == '+' || *q == '-') q++;
+        if (*q == '0') { free(dec); return 0; }
+    }
+    while (dn > 1 && !dec[dn - 1]) dn--;
+    if (dn == 1 && !dec[0]) neg = 0;
+    *out = tins_xmalloc(dn + 2);
+    { size_t k = 0; if (neg) (*out)[k++] = '-'; for (i = dn; i-- > 0;) (*out)[k++] = (char)('0' + dec[i]); (*out)[k] = 0; }
+    free(dec);
+    return 1;
+}
+static int tins_neg(const char *dec) { return dec[0] == '-'; }
+
+/* tins._val */
+static void tins_val_of(const char *s, tins_val *v) {
+    char *d;
+    memset(v, 0, sizeof *v);
+    if (s[0] == '\'') { v->kind = TINS_STR; v->s = tins_dup(s + 1); return; }
+    if (!strcmp(s, "true") || !strcmp(s, "false")) { v->kind = TINS_BOOL; v->b = s[0] == 't'; return; }
+    if (tins_int(s, 0, &d)) { v->kind = TINS_INT; v->s = d; return; }
+    v->kind = TINS_STR; v->s = tins_dup(s);
+}
+static void tins_val_free(tins_val *v) {
+    free(v->s); v->s = 0;
+    if (v->sub) { tins_val_free(v->sub); free(v->sub); v->sub = 0; }
+}
+
+void tins_free(tins_prog *p) {
+    int i, j;
+    free(p->data); free(p->src_os); free(p->data_len); free(p->bss); free(p->relocs);
+    for (i = 0; i < p->nsym; i++) { free(p->sym[i].name); free(p->sym[i].addr); }
+    for (i = 0; i < p->nlabel; i++) free(p->label[i].name);
+    for (i = 0; i < p->ncode; i++) {
+        tins_ins *c = &p->code[i];
+        free(c->op);
+        for (j = 0; j < c->narg; j++) tins_val_free(&c->arg[j]);
+        for (j = 0; j < c->nmeta; j++) { free(c->meta[j].key); tins_val_free(&c->meta[j].v); }
+        free(c->arg); free(c->meta);
+    }
+    free(p->sym); free(p->label); free(p->code);
+    memset(p, 0, sizeof *p);
+}
+
+static int tins_err(char *err, size_t cap, const char *a, const char *b) { snprintf(err, cap, "%s%s", a, b ? b : ""); return -1; }
+static int tins_bad_int(char *err, size_t cap, const char *s) {
+    snprintf(err, cap, "invalid literal for int() with base 10: '%s'", s); return -1;
+}
+/* str.split(): whitespace runs; at most 8 words kept, the count returned */
+static int tins_words(char *s, char **w, int max) {
+    int n = 0;
+    while (*s) {
+        while (*s && tins_ws((unsigned char)*s)) *s++ = 0;
+        if (!*s) break;
+        if (n < max) w[n] = s;
+        n++;
+        while (*s && !tins_ws((unsigned char)*s)) s++;
+    }
+    return n;
+}
+
+int tins_parse(const char *text, size_t n, const char *target, tins_prog *p, char *err, size_t cap) {
+    char *buf = tins_dupn(text, n), *ln, *next; int started = 0, rc = 0;
+    int h_target = 0, h_data = 0, h_src = 0, h_len = 0, h_bss = 0, h_rel = 0, h_thr = 0, nheader = 0;
+    memset(p, 0, sizeof *p);
+    snprintf(p->target, sizeof p->target, "%s", target);
+    p->data = tins_dup("");
+    if (tins_load_meta(err, cap)) { free(buf); return -1; }
+    for (ln = buf; ln; ln = next) {
+        char *e;
+        next = strchr(ln, '\n'); if (next) *next++ = 0;
+        while (*ln && tins_ws((unsigned char)*ln)) ln++;
+        e = ln + strlen(ln); while (e > ln && tins_ws((unsigned char)e[-1])) *--e = 0;
+        if (!*ln) continue;
+        if (*ln == '@') {
+            char *w[8]; int nw;
+            if (started) { rc = tins_err(err, cap, "header after instructions or labels", 0); break; }
+            nw = tins_words(ln, w, 8);
+            if (!strcmp(w[0], "@target") || !strcmp(w[0], "@data")) {
+                int is_t = w[0][1] == 't', *seen = is_t ? &h_target : &h_data;
+                if (*seen || nw != 2) { rc = tins_err(err, cap, "duplicate or malformed ", w[0]); break; }
+                *seen = 1; nheader++;
+                if (is_t) {
+                    static const char *T6[] = { "lnx/x86_64", "lnx/arm64", "osx/x86_64", "osx/arm64", "win/x86_64", "win/arm64" };
+                    int k, ok = 0;
+                    for (k = 0; k < 6; k++) if (!strcmp(w[1], T6[k])) ok = 1;
+                    if (!ok) { rc = tins_err(err, cap, "unknown target", 0); break; }
+                    snprintf(p->target, sizeof p->target, "%s", w[1]);
+                } else {
+                    const char *v = w[1]; size_t k, m = strlen(v);
+                    if (strcmp(v, "-")) {
+                        if (m % 2) { rc = tins_err(err, cap, "invalid data bytes", 0); break; }
+                        for (k = 0; k < m; k++) if (!strchr("0123456789abcdef", v[k]) || !v[k]) break;
+                        if (k < m) { rc = tins_err(err, cap, "invalid data bytes", 0); break; }
+                    }
+                    free(p->data); p->data = tins_dup(strcmp(v, "-") ? v : "");
+                }
+            } else if (!strcmp(w[0], "@src_os") || !strcmp(w[0], "@data_len") || !strcmp(w[0], "@bss") || !strcmp(w[0], "@relocs")) {
+                int *seen = !strcmp(w[0], "@src_os") ? &h_src : !strcmp(w[0], "@data_len") ? &h_len : !strcmp(w[0], "@bss") ? &h_bss : &h_rel;
+                if (*seen || nw != 2) { rc = tins_err(err, cap, "duplicate or malformed ", w[0]); break; }
+                *seen = 1; nheader++;
+                if (seen == &h_src) {
+                    if (strcmp(w[1], "lnx") && strcmp(w[1], "osx") && strcmp(w[1], "win")) { rc = tins_err(err, cap, "unknown source OS", 0); break; }
+                    p->src_os = tins_dup(w[1]);
+                } else if (seen == &h_rel) {
+                    char out[4096] = ""; size_t on = 0;
+                    if (strcmp(w[1], "-")) {
+                        char *s = w[1], *c, *d;
+                        for (;;) {
+                            c = strchr(s, ','); if (c) *c = 0;
+                            if (!tins_int(s, 10, &d)) { rc = tins_bad_int(err, cap, s); break; }
+                            if (tins_neg(d)) { free(d); rc = tins_err(err, cap, "negative relocation offset", 0); break; }
+                            on += (size_t)snprintf(out + on, on < sizeof out ? sizeof out - on : 0, "%s%s", on ? "," : "", d);
+                            free(d);
+                            if (!c) break;
+                            s = c + 1;
+                        }
+                        if (rc) break;
+                    }
+                    p->relocs = tins_dup(out);
+                } else {
+                    char *d;
+                    if (!tins_int(w[1], 10, &d)) { rc = tins_bad_int(err, cap, w[1]); break; }
+                    if (tins_neg(d)) { free(d); rc = tins_err(err, cap, "negative size", 0); break; }
+                    if (seen == &h_len) p->data_len = d; else p->bss = d;
+                }
+            } else if (!strcmp(w[0], "@threads")) {
+                if (h_thr || nw != 2 || strcmp(w[1], "1")) { rc = tins_err(err, cap, "duplicate or malformed @threads", 0); break; }
+                h_thr = 1; nheader++; p->threads = 1;
+            } else if (!strcmp(w[0], "@sym") && nw == 3) {
+                int k; char *d;
+                for (k = 0; k < p->nsym; k++) if (!strcmp(p->sym[k].name, w[1])) break;
+                if (k < p->nsym) { rc = tins_err(err, cap, "duplicate data symbol", 0); break; }
+                if (!tins_int(w[2], 10, &d)) { rc = tins_bad_int(err, cap, w[2]); break; }
+                p->sym = tins_grow(p->sym, p->nsym, sizeof *p->sym);
+                p->sym[p->nsym].name = tins_dup(w[1]); p->sym[p->nsym].addr = d; p->nsym++;
+            } else { rc = tins_err(err, cap, "unknown or malformed header", 0); break; }
+            continue;
+        }
+        started = 1;
+        if (ln[strlen(ln) - 1] == ':' && !strchr(ln, ' ')) {
+            int k; size_t m = strlen(ln) - 1;
+            for (k = 0; k < p->nlabel; k++) if (strlen(p->label[k].name) == m && !memcmp(p->label[k].name, ln, m)) break;
+            if (k < p->nlabel) { rc = tins_err(err, cap, "label defined twice: ", ln); break; }
+            p->label = tins_grow(p->label, p->nlabel, sizeof *p->label);
+            p->label[p->nlabel].name = tins_dupn(ln, m); p->label[p->nlabel].pc = p->ncode; p->nlabel++;
+            continue;
+        }
+        {
+            /* words = ln.split(" "); meta popped from the end while the last word holds '=' */
+            char **w = tins_xmalloc((strlen(ln) + 2) * sizeof *w); int nw = 0, k; char *s = ln, *rest;
+            tins_ins *c;
+            for (;;) { char *sp = strchr(s, ' '); w[nw++] = s; if (!sp) break; *sp = 0; s = sp + 1; }
+            p->code = tins_grow(p->code, p->ncode, sizeof *p->code);
+            c = &p->code[p->ncode++]; memset(c, 0, sizeof *c);
+            while (1) {
+                char *eq, *v; tins_val val;
+                if (!nw) { rc = tins_err(err, cap, "list index out of range", 0); break; }   /* IndexError */
+                if (!(eq = strchr(w[nw - 1], '='))) break;
+                *eq = 0; v = eq + 1;
+                for (k = 0; k < c->nmeta; k++) if (!strcmp(c->meta[k].key, w[nw - 1])) break;
+                if (k < c->nmeta || !tins_is_meta(w[nw - 1])) { rc = tins_err(err, cap, "meta: ", w[nw - 1]); break; }
+                if (!strcmp(v, "none")) memset(&val, 0, sizeof val); else tins_val_of(v, &val);
+                c->meta = tins_grow(c->meta, c->nmeta, sizeof *c->meta);
+                c->meta[c->nmeta].key = tins_dup(w[nw - 1]); c->meta[c->nmeta].v = val; c->nmeta++;
+                nw--;
+            }
+            if (rc) { c->op = tins_dup(""); free(w); break; }
+            c->op = tins_dup(w[0]);
+            /* rest = " ".join(words[1:]); args = [_val(a.strip()) for a in rest.split(",")] if rest.strip() */
+            {
+                size_t m = 0; char *q;
+                for (k = 1; k < nw; k++) m += strlen(w[k]) + 1;
+                rest = tins_xmalloc(m + 1); rest[0] = 0;
+                for (k = 1; k < nw; k++) { if (k > 1) strcat(rest, " "); strcat(rest, w[k]); }
+                for (q = rest; *q && tins_ws((unsigned char)*q); q++) ;
+                if (*q) {
+                    char *a = rest;
+                    for (;;) {
+                        char *comma = strchr(a, ','), *b, *z; tins_val val;
+                        if (comma) *comma = 0;
+                        for (b = a; *b && tins_ws((unsigned char)*b); b++) ;
+                        z = b + strlen(b); while (z > b && tins_ws((unsigned char)z[-1])) *--z = 0;
+                        tins_val_of(b, &val);
+                        if (val.kind == TINS_STR && strchr(val.s, ' ')) {   /* the tagged pair: split(" ")[0], _val(split(" ")[1]) */
+                            char *sp = strchr(val.s, ' '), *sp2 = strchr(sp + 1, ' ');
+                            tins_val tag; memset(&tag, 0, sizeof tag);
+                            tag.kind = TINS_TAG; tag.s = tins_dupn(val.s, (size_t)(sp - val.s));
+                            if (sp2) *sp2 = 0;
+                            tag.sub = tins_xmalloc(sizeof *tag.sub); tins_val_of(sp + 1, tag.sub);
+                            tins_val_free(&val); val = tag;
+                        }
+                        c->arg = tins_grow(c->arg, c->narg, sizeof *c->arg); c->arg[c->narg++] = val;
+                        if (!comma) break;
+                        a = comma + 1;
+                    }
+                }
+                free(rest);
+            }
+            free(w);
+        }
+    }
+    if (!rc && (nheader || p->nsym) && !(h_target && h_data)) rc = tins_err(err, cap, "full header requires target and data", 0);
+    free(buf);
+    if (rc) tins_free(p);
+    return rc;
+}
+
+/* ---------- dump ---------- */
+typedef struct { char *s; size_t n, cap; } tins_buf;
+static void tins_put(tins_buf *b, const char *s) {
+    size_t m = strlen(s);
+    if (b->n + m + 1 > b->cap) {
+        size_t c = b->cap ? b->cap : 256; while (c < b->n + m + 1) c *= 2;
+        b->s = realloc(b->s, c); if (!b->s) { fprintf(stderr, "MemoryError\n"); exit(1); }
+        b->cap = c;
+    }
+    memcpy(b->s + b->n, s, m + 1); b->n += m;
+}
+static void tins_repr(tins_buf *b, const tins_val *v) {   /* repr() of the value, for the error text */
+    if (v->kind == TINS_NONE) tins_put(b, "None");
+    else if (v->kind == TINS_BOOL) tins_put(b, v->b ? "True" : "False");
+    else if (v->kind == TINS_INT) tins_put(b, v->s);
+    else if (v->kind == TINS_STR) { tins_put(b, strchr(v->s, '\'') && !strchr(v->s, '"') ? "\"" : "'"); tins_put(b, v->s); tins_put(b, strchr(v->s, '\'') && !strchr(v->s, '"') ? "\"" : "'"); }
+    else { tins_val k; memset(&k, 0, sizeof k); k.kind = TINS_STR; k.s = v->s; tins_put(b, "("); tins_repr(b, &k); tins_put(b, ", "); tins_repr(b, v->sub); tins_put(b, ")"); }
+}
+static int tins_arg(tins_buf *b, const tins_val *v, char *err, size_t cap) {
+    if (v->kind == TINS_BOOL) { tins_put(b, v->b ? "true" : "false"); return 0; }
+    if (v->kind == TINS_INT) { tins_put(b, v->s); return 0; }
+    if (v->kind == TINS_STR && v->s[0] && !strpbrk(v->s, " ,=") && v->s[0] != '\'') {
+        tins_val back; int plain;
+        tins_val_of(v->s, &back); plain = back.kind == TINS_STR && strcmp(v->s, "none"); tins_val_free(&back);
+        if (!plain) tins_put(b, "'");
+        tins_put(b, v->s);
+        return 0;
+    }
+    if (v->kind == TINS_TAG && (!strcmp(v->s, "imm") || !strcmp(v->s, "reg") || !strcmp(v->s, "mem") || !strcmp(v->s, "addr"))) {
+        tins_put(b, v->s); tins_put(b, " ");
+        return tins_arg(b, v->sub, err, cap);
+    }
+    { tins_buf r = { 0, 0, 0 }; tins_repr(&r, v); snprintf(err, cap, "no text form for %s", r.s); free(r.s); }
+    return -1;
+}
+char *tins_dump(const tins_prog *p, int full, char *err, size_t cap) {
+    tins_buf b = { 0, 0, 0 }; int pc, k, j;
+    tins_put(&b, "");
+    if (full) {
+        tins_put(&b, "@target "); tins_put(&b, p->target); tins_put(&b, "\n");
+        tins_put(&b, "@data "); tins_put(&b, p->data[0] ? p->data : "-"); tins_put(&b, "\n");
+        if (p->src_os) { tins_put(&b, "@src_os "); tins_put(&b, p->src_os); tins_put(&b, "\n"); }
+        if (p->data_len) { tins_put(&b, "@data_len "); tins_put(&b, p->data_len); tins_put(&b, "\n"); }
+        if (p->bss) { tins_put(&b, "@bss "); tins_put(&b, p->bss); tins_put(&b, "\n"); }
+        if (p->relocs) { tins_put(&b, "@relocs "); tins_put(&b, p->relocs[0] ? p->relocs : "-"); tins_put(&b, "\n"); }
+        for (k = 0; k < p->nsym; k++) {
+            const char *s;
+            for (s = p->sym[k].name; *s && !tins_ws((unsigned char)*s); s++) ;
+            if (!p->sym[k].name[0] || *s) { free(b.s); snprintf(err, cap, "invalid data symbol name"); return 0; }
+            tins_put(&b, "@sym "); tins_put(&b, p->sym[k].name); tins_put(&b, " "); tins_put(&b, p->sym[k].addr); tins_put(&b, "\n");
+        }
+    }
+    for (pc = 0; pc <= p->ncode; pc++) {
+        const tins_ins *c;
+        for (k = 0; k < p->nlabel; k++) if (p->label[k].pc == pc) { tins_put(&b, p->label[k].name); tins_put(&b, ":\n"); }
+        if (pc == p->ncode) break;
+        c = &p->code[pc];
+        tins_put(&b, c->op);
+        for (j = 0; j < c->narg; j++) {
+            tins_put(&b, j ? ", " : " ");
+            if (tins_arg(&b, &c->arg[j], err, cap)) { free(b.s); return 0; }
+        }
+        for (j = 0; j < c->nmeta; j++) {
+            tins_put(&b, " "); tins_put(&b, c->meta[j].key); tins_put(&b, "=");
+            if (c->meta[j].v.kind == TINS_NONE) tins_put(&b, "none");
+            else if (tins_arg(&b, &c->meta[j].v, err, cap)) { free(b.s); return 0; }
+        }
+        tins_put(&b, "\n");
+    }
+    if (!b.n) tins_put(&b, "\n");   /* "\n".join([]) + "\n" */
+    return b.s;
+}
