+/* ---------- the groups ---------- */
+static long long DATA_VA_WANT;
+static void layout_hook(const Row *r, const unsigned char *out, size_t n) {   /* ADRP+ADD of the first .lea-like pair */
+    char text_os[4], path[PATHN], *t, *s; size_t tn; long long text = -1, pages, decoded; unsigned w0, w1;
+    const char *tg = strstr(r->src, "@target ");
+    if (!tg || n < 8 || strncmp(r->note, "data_va=", 8)) fail("layout row without @target/data_va (line %s)", r->src, 0);
+    snprintf(text_os, sizeof text_os, "%.3s", tg + 8);
+    snprintf(path, sizeof path, "%s/exec/facts/enc-address-layout-%s.tsv", ROOT, text_os);
+    if (!(t = cx_read(path, &tn))) fail("cannot read %s", path, 0);
+    for (s = t; s && *s; s = strchr(s, '\n') ? strchr(s, '\n') + 1 : 0) if (!strncmp(s, "text\t", 5)) { text = strtoll(s + 5, 0, 10); break; }
+    free(t);
+    if (text < 0) fail("%s: no text row", path, 0);
+    w0 = le32(out); w1 = le32(out + 4);
+    pages = (long long)(((w0 >> 29) & 3) | (((w0 >> 5) & 0x7ffff) << 2));
+    if (pages & (1LL << 20)) pages -= 1LL << 21;
+    decoded = (text & ~4095LL) + pages * 4096 + ((w1 >> 10) & 4095);
+    DATA_VA_WANT = strtoll(r->note + 8, 0, 10);
+    if (decoded != DATA_VA_WANT) { char a[64], b[64]; snprintf(a, sizeof a, "%lld", decoded); snprintf(b, sizeof b, "%lld", DATA_VA_WANT); fail("layout: ADRP/ADD decode %s, data_va %s", a, b); }
+}
+static void absent_hook(const Row *r, const unsigned char *out, size_t n) {   /* `call absent` = bl to text offset 0 */
+    unsigned w; long long imm;
+    (void)r;
+    if (n < 4) fail("call absent: no bl", 0, 0);
+    w = le32(out + n - 4);
+    if ((w & 0xfc000000u) != 0x94000000u) fail("call absent: the last word is not bl", 0, 0);
+    imm = (long long)(w & 0x3ffffff); if (imm & (1LL << 25)) imm -= 1LL << 26;
+    if ((long long)(n - 4) + imm * 4 != 0) fail("call absent: bl does not reach text offset 0", 0, 0);
+}
