+    printf("ARM64 memory: %d instructions, %zu bytes; both executors equal\n", s.insns, s.nbytes);
+    printf("ARM64 memory: width and fallback scratch rejection passed\n");
+    if (NATIVE) native_mem(); else printf("ARM64 memory native: SKIPPED (needs macOS arm64)\n");
+    /* armbranchcheck */
+    s = check_group("branch", 0); expect_n("branch fixtures", s.bytes_rows, 10); expect_n("branch rejects", s.rejects, 6);
+    { Stat a = check_group("branch.absent", absent_hook); expect_n("call absent", a.bytes_rows, 1); }
+    printf("ARM64 branches: 10 fixtures on both executors; 6 worked byte expectations; call absent = offset 0; 6 rejects\n");
+    synthetic(json);
+    if (NATIVE) native_branch(); else printf("ARM64 branch execution: SKIPPED (needs macOS arm64)\n");
+    /* armintcheck */
+    s = check_group("int", 0); expect_n("int fixtures", s.bytes_rows, 1);
+    printf("ARM64 integer/frame: %d instructions, %zu bytes equal, both executors\n", s.insns, s.nbytes);
+    expect_n("int rejects", s.rejects, 10);
+    printf("ARM64 integer/frame: 10 signed-domain/field-width/scratch rejects, both executors\n");
+    if (NATIVE) native_int(); else printf("ARM64 integer/frame native: SKIPPED\n");
+    /* armfpcheck */
+    s = check_group("fp", 0); expect_n("fp fixtures", s.bytes_rows, 1); expect_n("fp rejects", s.rejects, 0);
+    printf("ARM64 FP: %d ops, %d register fixtures, %zu bytes match on both executors\n", s.ops, s.insns, s.nbytes);
+    if (!NATIVE) printf("ARM64 FP native: SKIPPED\n");
+    /* arminputcheck */
+    s = check_group("input", 0); expect_n("input fixtures", s.bytes_rows, 5); expect_n("input rejects", s.rejects, 17);
