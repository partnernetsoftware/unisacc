+/* the stats of one group, filled by check_group */
+typedef struct { int bytes_rows, rejects, insns; size_t nbytes; int ops; } Stat;
+static int count_ops(const tins_prog *p) {   /* distinct op names, in order of appearance */
+    int i, j, n = 0;
+    for (i = 0; i < p->ncode; i++) {
+        for (j = 0; j < i; j++) if (!strcmp(p->code[j].op, p->code[i].op)) break;
+        if (j == i) n++;
+    }
+    return n;
+}
+/* every row of GROUP on every executor; ROW_HOOK(row, out, n) for accepted rows */
+static Stat check_group(const char *group, void (*hook)(const Row *, const unsigned char *, size_t)) {
+    Stat st; int i, k;
+    memset(&st, 0, sizeof st);
+    for (i = 0; i < NROWS; i++) {
+        Row *r = &ROWS[i];
+        if (strcmp(r->group, group)) continue;
+        if (!strcmp(r->kind, "bytes")) {
+            size_t wn; unsigned char *want = unhex(r->hex, &wn); tins_prog p; char err[512];
+            if (tins_parse(r->src, r->srcn, "lnx/x86_64", &p, err, sizeof err)) fail("%s: frozen source is not TIns text: %s", group, err);
+            st.insns += p.ncode; st.ops += count_ops(&p); tins_free(&p);
+            for (k = 0; k < NMODEL; k++) {
+                Res res; run_on(k, MODEL[k], r->src, r->srcn, &res);
+                if (res.rc != 0 || res.outn != wn || memcmp(res.out, want, wn)) {
+                    char *got = xmalloc(2 * res.outn + 1), msg[256];
+                    size_t at = 0;
+                    tohex((unsigned char *)res.out, res.outn, got);
+                    while (at < wn && at < res.outn && (unsigned char)res.out[at] == want[at]) at++;
+                    fflush(stdout); fwrite(res.err, 1, res.errn, stderr);
+                    snprintf(msg, sizeof msg, "line %d, executor %s: rc %d, %zu bytes, want %zu, first difference at %zu", r->line, MODEL[k], res.rc, res.outn, wn, at);
+                    fail("%s %s", group, msg);
+                }
+                if (hook && k == 0) hook(r, (unsigned char *)res.out, res.outn);
+                res_free(&res);
+            }
+            st.bytes_rows++; st.nbytes += wn; free(want);
+        } else {
+            for (k = 0; k < NMODEL; k++) {
+                Res res; run_on(k, MODEL[k], r->src, r->srcn, &res);
+                if (!notcovered(&res)) {
+                    char msg[256];
+                    snprintf(msg, sizeof msg, "line %d, executor %s: rc %d, %zu stdout bytes, not the declared not-covered reply", r->line, MODEL[k], res.rc, res.outn);
+                    fflush(stdout); fwrite(res.err, 1, res.errn, stderr);
+                    fail("%s reject %s", group, msg);
+                }
+                res_free(&res);
+            }
+            st.rejects++;
+        }
+    }
+    return st;
+}
+static void expect_n(const char *what, int got, int want) {
+    if (got != want) { char a[64], b[64]; snprintf(a, sizeof a, "%s: %d", what, got); snprintf(b, sizeof b, "%d", want); fail("%s rows, the check states %s", a, b); }
