+int main(int argc, char **argv) {
+    char here[PATHN], *sl; const char *mode = argc > 1 ? argv[1] : "";
+    snprintf(here, sizeof here, "%s", __FILE__);
+    if (here[0] != '/') { char cwd[PATHN], t[PATHN]; if (!getcwd(cwd, sizeof cwd)) return 2; snprintf(t, sizeof t, "%s/%s", cwd, here); snprintf(here, sizeof here, "%s", t); }
+    for (int up = 0; up < 3; up++) { sl = strrchr(here, '/'); if (!sl) return 2; *sl = 0; }   /* file, enc/, exec/ */
+    ptf_abspath(here[0] ? here : "/", ROOT, sizeof ROOT);
+    tins_set_root(ROOT);
+    if (!strcmp(mode, "tins")) return tins_cli(argc, argv);
+    if (!((!strcmp(mode, "arm") && argc == 5) || (!strcmp(mode, "armwin") && argc == 4) || (!strcmp(mode, "x86win") && argc == 4))) {
+        fprintf(stderr, "usage: encrefcheck.cx arm RUN ARM.tbl ARM.json | armwin RUN ARM.tbl | x86win RUN MODEL | tins [--full] [--target T] FILE\n");
+        return 2;
+    }
+    RUN = argv[2];
+    DRY = getenv("ENCREF_NATIVE_DRY"); if (DRY && !*DRY) DRY = 0;
+    { char h[600]; hc_host(h, sizeof h); NATIVE = DRY || !strcmp(h, "Darwin/arm64"); }
+    if (ptf_mkdtemp(0, "encref-", TD, sizeof TD)) { TD[0] = 0; fail("no usable temporary directory", 0, 0); }
+    models(argv[3], !strcmp(mode, "arm"));
+    if (!strcmp(mode, "arm")) arm(argv[4]);
+    else if (!strcmp(mode, "armwin")) armwin();
+    else x86win();
+    fflush(stdout);
+    cleanup();
+    return 0;
+}
