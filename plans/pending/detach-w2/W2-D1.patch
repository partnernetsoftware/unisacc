+static const Row *row_of(const char *group, int nth) {   /* the NTH bytes row of GROUP */
+    int i;
+    for (i = 0; i < NROWS; i++) if (!strcmp(ROWS[i].group, group) && !strcmp(ROWS[i].kind, "bytes") && nth-- == 0) return &ROWS[i];
