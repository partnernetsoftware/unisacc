+static const char *jskip_str(const char *p, const char *e) { for (p++; p < e; p++) { if (*p == '\\') p++; else if (*p == '"') return p + 1; } return 0; }
+static const char *jskip(const char *p, const char *e) {   /* past one JSON value (compact or not) */
+    int depth = 0;
+    while (p < e && strchr(" \t\r\n", *p)) p++;
+    if (p >= e) return 0;
+    if (*p == '"') return jskip_str(p, e);
+    if (*p != '{' && *p != '[') { while (p < e && !strchr(",]} \t\r\n", *p)) p++; return p; }
+    while (p < e) {
+        if (*p == '"') { p = jskip_str(p, e); if (!p) return 0; continue; }
+        if (*p == '{' || *p == '[') depth++;
+        else if ((*p == '}' || *p == ']') && --depth == 0) return p + 1;
+        p++;
+    }
+    return 0;
+}
+/* the value of member KEY of the object at P ('{'): its start, and *END past it; 0 when absent */
+static const char *jmember(const char *p, const char *e, const char *key, const char **end) {
+    size_t kn = strlen(key);
+    p++;
+    for (;;) {
+        const char *k, *ke, *v;
+        while (p < e && strchr(" \t\r\n,", *p)) p++;
+        if (p >= e || *p != '"') return 0;
+        k = p + 1; ke = jskip_str(p, e); if (!ke) return 0;
+        p = ke; while (p < e && strchr(" \t\r\n", *p)) p++;
+        if (p >= e || *p != ':') return 0;
+        v = p + 1; while (v < e && strchr(" \t\r\n", *v)) v++;
+        p = jskip(v, e); if (!p) return 0;
+        if ((size_t)(ke - 1 - k) == kn && !memcmp(k, key, kn)) { *end = p; return v; }
+    }
+}
+typedef struct { const char *at, *skip_to; int what; } Edit;   /* one text edit of the delta JSON */
+static void synthetic(const char *json) {
+    size_t n; char *d = cx_read(json, &n), *e;
+    const char *states, *states_end, *seqs, *seqs_end, *start, *start_end, *ret, *ret_end, *row, *row_end, *p;
+    long nseq = 0; Buf out = { 0, 0, 0 }, ins = { 0, 0, 0 }; int bits_i, vi, key = 65, ci = 0, k257;
+    static const int BITS[2][2] = { { 19, 5 }, { 26, 0 } };
+    long long cases[8][4];   /* key, bits, shift, value */
+    if (!d) fail("cannot read %s", json, 0);
+    e = d + n;
+    if (*d != '{' || !(states = jmember(d, e, "states", &states_end)) || !(seqs = jmember(d, e, "seqs", &seqs_end)) || !(start = jmember(d, e, "start", &start_end)))
+        fail("%s: not a delta (start, states, seqs)", json, 0);
+    if (!(ret = jmember(states, e, "RET", &ret_end)) || *ret != '[') fail("%s: no RET state", json, 0);
+    for (p = ret + 1; p < ret_end && *p != ','; p++) ;   /* RET = ["mode", {row}] */
+    row = p + 1; while (row < ret_end && *row != '{') row++;
+    if (row >= ret_end || !(row_end = jskip(row, e))) fail("%s: RET has no row", json, 0);
+    for (p = seqs + 1; p < seqs_end - 1;) {   /* len(delta['seqs']) */
+        while (p < seqs_end && strchr(" \t\r\n,", *p)) p++;
+        if (p >= seqs_end - 1) break;
+        p = jskip(p, e); if (!p) fail("%s: bad seqs", json, 0);
+        nseq++;
+    }
+    /* the new seqs, in the .py's append order: 8 cases, RET's POP, BOUND.ret's DEAD */
+    for (bits_i = 0; bits_i < 2; bits_i++) {
+        long long bits = BITS[bits_i][0], half = 1LL << (bits - 1);
