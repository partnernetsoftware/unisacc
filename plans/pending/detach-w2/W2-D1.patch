+static unsigned char *unhex(const char *h, size_t *n) {
+    size_t m = strlen(h) / 2, i; unsigned char *b = xmalloc(m + 1);
+    for (i = 0; i < m; i++) b[i] = (unsigned char)(hexval((unsigned char)h[2 * i]) * 16 + hexval((unsigned char)h[2 * i + 1]));
+    *n = m; return b;
+}
+static void tohex(const unsigned char *b, size_t n, char *out) { static const char D[] = "0123456789abcdef"; size_t i; for (i = 0; i < n; i++) { out[2 * i] = D[b[i] >> 4]; out[2 * i + 1] = D[b[i] & 15]; } out[2 * n] = 0; }
