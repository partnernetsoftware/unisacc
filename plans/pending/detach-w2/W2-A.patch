diff --git a/tests/tapevmrun.cx b/tests/tapevmrun.cx
new file mode 100644
index 0000000..89c142a
--- /dev/null
+++ b/tests/tapevmrun.cx
@@ -0,0 +1,48 @@
+#!/usr/bin/env -S unisacc.com -run
+/* tapevmrun.cx -- run a tape file in the reference tape VM (2026-10-23, unisa/ detach W2-A: replaces the
+   seed's `unisa vm --os OS TAPE` step of tests/closure.sh; the VM is tests/cxlib/tapevm.cx, the port of
+   unisa/tape.py parse + unisa/vm.py run_reference).
+     sh ./tests/cxbin tests/tapevmrun.cx [--os lnx|osx|win] TAPE [ARG...]
+   As cmd_vm did: the tape is read as latin-1, argv is [TAPE, ARG...], the step limit is vm.py's MAX_STEPS
+   (4,000,000,000); --os names the target whose C library passed the open(2) flags (default lnx: a text tape does
+   not say).  The program's output (fd 1 and 2, as vm.py collects them) goes to stdout and the halt code is the exit
+   status.  A tape that does not parse, an unreadable file, or a run the VM refuses (an unknown label, an unsupported
+   syscall, a `tapevm: ... not covered` case) writes one line on stderr, nothing on stdout, and exits 1 -- the
+   status of the uncaught exception the Python VM raised in the same place.  A usage error is rc 2. */
+#pragma unisa use cxlib.tapevm
+
+static int usage(void) { fprintf(stderr, "usage: tapevmrun.cx [--os lnx|osx|win] TAPE [ARG...]\n"); return 2; }
+
+int main(int argc, char **argv) {
+    int i = 1, os = 0, code = 0; FILE *f; char *buf = 0, why[16384]; size_t n = 0, cap = 0, k;
+    tv_tape *t; tv_vm vm;
+    if (i < argc && !strcmp(argv[i], "--os")) {
+        if (i + 1 >= argc) return usage();
+        if (!strcmp(argv[i + 1], "lnx")) os = 0;
+        else if (!strcmp(argv[i + 1], "osx")) os = 1;
+        else if (!strcmp(argv[i + 1], "win")) os = 2;
+        else return usage();
+        i += 2;
+    }
+    if (i >= argc) return usage();
+    if (!(f = fopen(argv[i], "rb"))) { fprintf(stderr, "FileNotFoundError: %s: %s\n", argv[i], strerror(errno)); return 1; }
+    for (;;) {
+        if (n == cap) {
+            char *g; cap = cap ? 2 * cap : 65536;
+            if (!(g = realloc(buf, cap))) { fprintf(stderr, "MemoryError\n"); fclose(f); return 1; }
+            buf = g;
+        }
+        k = fread(buf + n, 1, cap - n, f);
+        if (!k) break;
+        n += k;
+    }
+    if (ferror(f)) { fprintf(stderr, "OSError: %s: read failed\n", argv[i]); fclose(f); return 1; }
+    fclose(f);
+    if (!(t = tv_parse_latin1(buf ? buf : "", n, why, sizeof why))) { fprintf(stderr, "%s\n", why); return 1; }
+    if (tv_vm_init(&vm, t, 4000000000LL, argv + i, argc - i, why, sizeof why)) { fprintf(stderr, "%s\n", why); return 1; }
+    vm.os = os;
+    if (tv_vm_run(&vm, &code, why, sizeof why)) { fprintf(stderr, "%s\n", why); return 1; }
+    if (vm.outn && fwrite(vm.out, 1, vm.outn, stdout) != vm.outn) return 1;
+    fflush(stdout);
+    return code & 255;
+}
