@@ -0,0 +1,188 @@
+#!/usr/bin/env -S unisacc.com -run
+/* layoutcheck.cx -- the data layout, enumerated rather than sampled [A-41] [P-3] (2026-10-23, unisa/ detach W2-A:
+   replaces tests/gen_layout.py + tests/layout_check.py, which compiled every tape with the Python back end too).
+     sh ./tests/cxbin tests/layoutcheck.cx UA DEPTH TARGET...                 (driver: tests/layout.sh)
+   The enumeration (gen_layout.py, unchanged): every tape of one to DEPTH (<= 3) data definitions over {bss 1, bss 8,
+   str 1, str 7, str 8, str of NULs}, plus the same tapes with the first or the last symbol defined TWICE -- 762 tapes
+   at depth 3.  Each tape is written to a fresh directory under TMPDIR and handed straight to the C back end
+   (`UA TAPE -b TARGET`, 60 s), once per target; the image's sha256 must equal the reference image's in
+   tests/layout.expected.tsv.  That table is the Python back end's answer (unisa lower + assemble + image, drive
+   built, prune_input), frozen from the live seed while it was importable: the C images were byte-identical to it
+   for all 762 x 6 compiles on the day of the capture (tests/layout_check.py green), so their sha256 is the reference's.
+   The tapes do not depend on the front end, so the table goes stale only when the back end changes what it writes
+   for a data layout -- which is exactly what this check exists to notice.  A FAIL line names the tape and the target
+   and says why (no image, no frozen row, or which sha256 the image has); the summary line is the one the Python
+   check printed.  rc 0 when every compile matched, 1 otherwise (or nothing was checked), 2 on a usage error.
+     sh ./tests/cxbin tests/layoutcheck.cx --print UA DEPTH
+   prints the table rows of UA's own images instead (tape, then the sha256 for the six targets in the table's column
+   order): the capture listing.  It judges nothing -- a row it prints becomes a reference only by a deliberate,
+   reviewed edit of tests/layout.expected.tsv, after the change in the back end's layout was itself judged. */
+#pragma unisa use cxlib.pyrun
+
+static const char *SUF[6] = { "b1", "b8", "s1", "s7", "s8", "z8" };
+static const char *LINE[6] = {
+    ".bss %s 1", ".bss %s 8", ".str %s \"a\"", ".str %s \"abcdefg\"", ".str %s \"abcdefgh\"",
+    ".str %s \"\\0\\0\\0\\0\\0\\0\\0\\0\""
+};
+static const char *ALLT[6] = { "lnx/x86_64", "lnx/arm64", "osx/x86_64", "osx/arm64", "win/x86_64", "win/arm64" };
+
+typedef struct { char name[64]; char sha[6][65]; } Row;
+static Row *rows; static size_t nrows;
+static char **names; static size_t nnames, capnames;
+static char DIR_[4096];
+
+static void die(const char *m) { fprintf(stderr, "layoutcheck: %s\n", m); if (DIR_[0]) pr_rmtree(DIR_); exit(2); }
+
+/* gen_layout.tape(defs, redef) */
+static void write_tape(const char *name, const int *defs, int k, int redef) {
+    char path[4400], line[128], d[16]; FILE *f; int i;
+    snprintf(path, sizeof path, "%s/%s.tape", DIR_, name);
+    if (!(f = fopen(path, "wb"))) die("cannot write a tape");
+    fputs("_start:\n", f);
+    for (i = 0; i < k; i++) fprintf(f, "  .lea r0, d%d\n", i);
+    fputs("  imm r0, 0\n  .exit r0\n", f);
+    for (i = 0; i < k; i++) { snprintf(d, sizeof d, "d%d", i); snprintf(line, sizeof line, LINE[defs[i]], d); fprintf(f, "%s\n", line); }
+    if (redef >= 0) { snprintf(d, sizeof d, "d%d", redef); snprintf(line, sizeof line, LINE[defs[redef]], d); fprintf(f, "%s\n", line); }
+    if (fclose(f)) die("cannot write a tape");
+    if (nnames == capnames) { capnames = capnames ? 2 * capnames : 1024; if (!(names = realloc(names, capnames * sizeof *names))) die("out of memory"); }
+    snprintf(path, sizeof path, "%s.tape", name);
+    if (!(names[nnames++] = strdup(path))) die("out of memory");
+}
+static void generate(int maxn) {
+    int k, defs[3], i, total;
+    for (k = 1; k <= maxn; k++) {
+        total = 1; for (i = 0; i < k; i++) total *= 6;
+        for (i = 0; i < total; i++) {   /* itertools.product(SPECS, repeat=k): the last position varies fastest */
+            char name[64] = ""; int j, v = i, r;
+            for (j = k - 1; j >= 0; j--) { defs[j] = v % 6; v /= 6; }
+            for (j = 0; j < k; j++) { if (j) strcat(name, "_"); strcat(name, SUF[defs[j]]); }
+            write_tape(name, defs, k, -1);
+            if (k > 1) for (r = 0; r < 2; r++) {
+                char rn[72]; int at = r ? k - 1 : 0;
+                snprintf(rn, sizeof rn, "%s.r%d", name, at);
+                write_tape(rn, defs, k, at);
+            }
+        }
+    }
+}
+/* `UA TAPE -b TARGET`: stdout and stderr through two pipes, read in that order (an image is read to EOF first; the
+   only stderr is a short diagnostic, far below a pipe's buffer).  A blocking wait, not pr_run's 1 ms poll and two
+   temporary files per call: 4,572 compiles.  No per-compile limit: the whole run is bounded (60 s) by
+   tests/layout.sh (the carried libc has no alarm()), and a hang there is red, never green. */
+typedef struct { char *out; size_t outn; char *err; int rc; } Run;
+static void slurp(int fd, char **p, size_t *n) {
+    char buf[65536]; ssize_t k; size_t cap = 0;
+    *p = 0; *n = 0;
+    while ((k = read(fd, buf, sizeof buf)) > 0) {
+        if (*n + (size_t)k + 1 > cap) { cap = (*n + (size_t)k + 1) * 2; if (!(*p = realloc(*p, cap))) die("out of memory"); }
+        memcpy(*p + *n, buf, (size_t)k); *n += (size_t)k; (*p)[*n] = 0;
+    }
+}
+static int run_ua(const char *ua, const char *tape, const char *target, Run *r, char *why, size_t wl) {
+    int p[2], q[2]; pid_t pid; int st = 0; size_t en;
+    memset(r, 0, sizeof *r);
+    if (pipe(p)) { snprintf(why, wl, "pipe failed"); return -1; }
+    if (pipe(q)) { close(p[0]); close(p[1]); snprintf(why, wl, "pipe failed"); return -1; }
+    fflush(stdout);
+    if ((pid = fork()) < 0) { close(p[0]); close(p[1]); close(q[0]); close(q[1]); snprintf(why, wl, "fork failed"); return -1; }
+    if (!pid) {
+        char *av[5]; av[0] = (char *)ua; av[1] = (char *)tape; av[2] = "-b"; av[3] = (char *)target; av[4] = 0;
+        dup2(p[1], 1); dup2(q[1], 2); close(p[0]); close(p[1]); close(q[0]); close(q[1]);
+        execv(ua, av);
+        _exit(127);
+    }
+    close(p[1]); close(q[1]);
+    slurp(p[0], &r->out, &r->outn); close(p[0]);
+    slurp(q[0], &r->err, &en); close(q[0]);
+    while (waitpid(pid, &st, 0) < 0) if (errno != EINTR) break;
+    r->rc = WIFEXITED(st) ? WEXITSTATUS(st) : -WTERMSIG(st);
+    return 0;
+}
+static int cmpname(const void *a, const void *b) { return strcmp(*(char *const *)a, *(char *const *)b); }
+
+static void load_table(const char *path) {
+    size_t n; char *t = cx_read(path, &n), *p, *e; size_t cap = 0;
+    if (!t) die("cannot read tests/layout.expected.tsv");
+    for (p = t; *p; p = e) {
+        char *f[8]; int nf = 0, i; Row r;
+        e = strchr(p, '\n'); if (e) *e++ = 0; else e = p + strlen(p);
+        if (*p == '#' || !*p) continue;
+        f[nf++] = p;
+        while (nf < 8 && (p = strchr(p, '\t'))) { *p++ = 0; f[nf++] = p; }
+        if (nf != 7 || strlen(f[0]) >= sizeof r.name) die("malformed row in tests/layout.expected.tsv");
+        snprintf(r.name, sizeof r.name, "%s", f[0]);
+        for (i = 0; i < 6; i++) {
+            if (strlen(f[i + 1]) != 64 || strspn(f[i + 1], "0123456789abcdef") != 64) die("malformed sha256 in tests/layout.expected.tsv");
+            memcpy(r.sha[i], f[i + 1], 65);
+        }
+        if (nrows == cap) { cap = cap ? 2 * cap : 1024; if (!(rows = realloc(rows, cap * sizeof *rows))) die("out of memory"); }
+        rows[nrows++] = r;
+    }
+    free(t);
+}
+static const char *frozen(const char *name, const char *target) {
+    size_t i; int j;
+    for (j = 0; j < 6; j++) if (!strcmp(ALLT[j], target)) break;
+    if (j == 6) return 0;
+    for (i = 0; i < nrows; i++) if (!strcmp(rows[i].name, name)) return rows[i].sha[j];
+    return 0;
+}
+
+int main(int argc, char **argv) {
+    char here[4096], *slash, table[4400], why[4096], targets[256] = "";
+    const char *ua; int depth, i, bad = 0, n = 0, print = 0; size_t k;
+    char *all[9];
+    if (argc == 4 && !strcmp(argv[1], "--print")) {   /* the capture listing: UA's sha256 per tape, all six targets */
+        print = 1; all[0] = argv[0]; all[1] = argv[2]; all[2] = argv[3];
+        for (i = 0; i < 6; i++) all[3 + i] = (char *)ALLT[i];
+        argc = 9; argv = all;
+    }
+    if (argc < 4) { fprintf(stderr, "usage: layoutcheck.cx UA DEPTH TARGET... | --print UA DEPTH\n"); return 2; }
+    ua = argv[1]; depth = atoi(argv[2]);
+    if (depth < 1 || depth > 3) die("DEPTH must be 1, 2 or 3");
+    for (i = 3; i < argc; i++) {
+        int j, ok = 0; for (j = 0; j < 6; j++) if (!strcmp(argv[i], ALLT[j])) ok = 1;
+        if (!ok) die("unknown target");
+        if (i > 3) strcat(targets, ",");
+        strcat(targets, argv[i]);
+    }
+    snprintf(here, sizeof here, "%s", __FILE__);
+    slash = strrchr(here, '/'); if (slash) *slash = 0; else snprintf(here, sizeof here, ".");
+    snprintf(table, sizeof table, "%s/layout.expected.tsv", here);
+    if (!print) load_table(table);
+    if (pr_tempdir("layout-", DIR_, sizeof DIR_)) die("cannot make a scratch directory");
+    generate(depth);
+    qsort(names, nnames, sizeof *names, cmpname);   /* sorted(os.listdir(tdir)) */
+    for (k = 0; k < nnames; k++) {
+        char path[4400], base[64]; size_t bl = strlen(names[k]) - 5;
+        snprintf(path, sizeof path, "%s/%s", DIR_, names[k]);
+        memcpy(base, names[k], bl); base[bl] = 0;
+        if (print) printf("%s", base);
+        for (i = 3; i < argc; i++) {
+            Run res; char hex[65]; const char *want;
+            n++;
+            if (run_ua(ua, path, argv[i], &res, why, sizeof why)) { bad++; printf("  FAIL %-24s %s: %s\n", names[k], argv[i], why); continue; }
+            want = print ? 0 : frozen(base, argv[i]);
+            if (print) {
+                if (!res.outn) die("--print: the C back end wrote nothing");
+                cx_sha256_hex(res.out, res.outn, hex); printf("\t%s", hex);
+            } else if (!res.outn) {
+                char *nl, *msg = res.err ? res.err : (char *)"";
+                while (*msg == ' ' || *msg == '\n' || *msg == '\t' || *msg == '\r') msg++;
+                if ((nl = strchr(msg, '\n'))) *nl = 0;
+                bad++; printf("  FAIL %-24s %s: the C back end wrote nothing (%s)\n", names[k], argv[i], *msg ? msg : "no message");
+            } else if (!want) {
+                bad++; printf("  FAIL %-24s %s: no frozen reference row in tests/layout.expected.tsv\n", names[k], argv[i]);
+            } else {
+                cx_sha256_hex(res.out, res.outn, hex);
+                if (strcmp(hex, want)) { bad++; printf("  FAIL %-24s %s: image sha256 %.16s..., frozen reference %.16s...\n", names[k], argv[i], hex, want); }
+            }
+            free(res.out); free(res.err);
+        }
+        if (print) printf("\n");
+    }
+    pr_rmtree(DIR_); DIR_[0] = 0;
+    if (print) return 0;
+    printf("\nlayout  tapes %d   compiles %d   wrong %d   targets %s\n", (int)nnames, n, bad, targets);
+    return (bad || !n) ? 1 : 0;
+}
