index 54fd9fc..fcd3a81 100755
--- a/tests/bigclosure.sh
+++ b/tests/bigclosure.sh
@@ -1,6 +1,19 @@
 #!/bin/bash
 # Compiler-source image equality: all six targets, or one explicit target.
-# A host-target slice also executes its self-compiled compiler.
+# The compiler's own source (tests/sourceflat.py's private export) is compiled
+# to TARGET twice: by UA (the classic C reference, built by the host cc) and by
+# the compiler UA writes for this host from the same source (`UA SELF -b HOST`,
+# the product judging itself).  The two images must be the same bytes: the
+# self-built back end and front end agree with the host-cc-built ones on the
+# largest input there is, for every target.  A host-target slice also runs the
+# self-built compiler (`-run examples/hello.c`).
+#
+# Until 2026-10-23 the reference image came from the Python back end
+# (`unisa compile --from-tape`).  unisa/ detach W2-A: a frozen sha256 of the
+# compiler's own image would go stale on the next source commit, so the
+# check became UA vs the self-built compiler (plans/unisa-detach.md, W2-A);
+# the back end's byte equality with the Python one stays judged on frozen
+# inputs by tests/closure.sh (tests/closure.expected.tsv) and tests/layout.sh.
 set -u
 R=$(cd "$(dirname "$0")/.." && pwd); cd "$R"
 ALL_TARGETS="lnx/x86_64 lnx/arm64 osx/x86_64 osx/arm64 win/x86_64 win/arm64"
@@ -19,49 +32,40 @@ esac
 T=$(scratch)
 SELF="$T/unisacc.flat.c"
 bound 10 python3 "$R/tests/sourceflat.py" "$SELF" || exit 1; HOSTT=$(host_target)
+[ -n "$HOSTT" ] || { echo '  FAIL this host is none of the six targets: the self-built compiler cannot run here'; exit 1; }
+# the self-built compiler: UA's image of its own source for this host
+ht=$(echo "$HOSTT" | tr / _)
+if ! bound 30 "$UA" "$SELF" -b "$HOSTT" > "$T/ua.$ht" 2>"$T/ua.$ht.err" || [ ! -s "$T/ua.$ht" ]; then
+    echo "  FAIL $HOSTT: C image build failed"; cat "$T/ua.$ht.err"; exit 1
+fi
+cp "$T/ua.$ht" "$T/self"; chmod +x "$T/self"
+signrc=0
+if command -v codesign >/dev/null; then bound 10 codesign -f -s - "$T/self" >"$T/sign.log" 2>&1 || signrc=$?; fi
+[ "$signrc" -eq 0 ] || { echo "  FAIL self signing exited $signrc"; cat "$T/sign.log"; exit 1; }
 same=0; diff=0; host_selected=0
 for t in $TARGETS; do
     [ "$t" = "$HOSTT" ] && host_selected=1
     tt=$(echo "$t" | tr / _)
-    if ! bound 30 "$UA" "$SELF" -t "$t" > "$T/tape.$tt" 2>"$T/tape.$tt.err"; then
-        echo "  FAIL $t: front end failed"; cat "$T/tape.$tt.err"; diff=$((diff+1)); continue
-    fi
-    if [ ! -s "$T/tape.$tt" ]; then
-        echo "  FAIL $t: empty tape"; diff=$((diff+1)); continue
-    fi
-    if ! bound 45 python3 -m unisa compile "$T/tape.$tt" --from-tape \
-         -o "$T/py.$tt" --target "$t" --drive built >"$T/py.$tt.log" 2>&1; then
-        echo "  FAIL $t: Python image build failed"; cat "$T/py.$tt.log"; diff=$((diff+1)); continue
-    fi
-    if ! bound 30 "$UA" "$SELF" -b "$t" > "$T/ua.$tt" 2>"$T/ua.$tt.err"; then
+    if [ ! -s "$T/ua.$tt" ] && ! bound 30 "$UA" "$SELF" -b "$t" > "$T/ua.$tt" 2>"$T/ua.$tt.err"; then
         echo "  FAIL $t: C image build failed"; cat "$T/ua.$tt.err"; diff=$((diff+1)); continue
     fi
-    if [ ! -s "$T/py.$tt" ] || [ ! -s "$T/ua.$tt" ]; then
+    if ! bound 30 "$T/self" "$SELF" -b "$t" > "$T/self.$tt" 2>"$T/self.$tt.err"; then
+        echo "  FAIL $t: the self-built compiler's image build failed"; cat "$T/self.$tt.err"; diff=$((diff+1)); continue
+    fi
+    if [ ! -s "$T/ua.$tt" ] || [ ! -s "$T/self.$tt" ]; then
         echo "  FAIL $t: empty image"; diff=$((diff+1)); continue
     fi
-    if cmp -s "$T/py.$tt" "$T/ua.$tt"; then
+    if cmp -s "$T/ua.$tt" "$T/self.$tt"; then
         same=$((same+1)); printf "  %-12s identical  %s B\n" "$t" "$(wc -c < "$T/ua.$tt")"
     else
-        diff=$((diff+1)); printf "  %-12s DIFF  %s\n" "$t" "$(cmp "$T/py.$tt" "$T/ua.$tt" 2>&1 | head -1)"
+        diff=$((diff+1)); printf "  %-12s DIFF  %s\n" "$t" "$(cmp "$T/ua.$tt" "$T/self.$tt" 2>&1 | head -1)"
     fi
 done
 ranok=0; ranwrong=0
 if [ "$host_selected" -eq 1 ]; then
-    tt=$(echo "$HOSTT" | tr / _)
-    if [ -s "$T/ua.$tt" ]; then
-        cp "$T/ua.$tt" "$T/self"; chmod +x "$T/self"
-        signrc=0
-        if command -v codesign >/dev/null; then bound 10 codesign -f -s - "$T/self" >"$T/sign.log" 2>&1 || signrc=$?; fi
-        if [ "$signrc" -ne 0 ]; then
-            ranwrong=1; echo "  FAIL self signing exited $signrc"; cat "$T/sign.log"
-        else
-            got=$(bound 20 "$T/self" -run examples/hello.c 2>&1); rc=$?
-            if [ "$rc" -eq 0 ] && [ "$got" = "hello from C99" ]; then ranok=1
-            else ranwrong=1; echo "  FAIL self compiler exited $rc and said [$got]"; fi
-        fi
-    else
-        ranwrong=1; echo '  FAIL host image missing'
-    fi
+    got=$(bound 20 "$T/self" -run examples/hello.c 2>&1); rc=$?
+    if [ "$rc" -eq 0 ] && [ "$got" = "hello from C99" ]; then ranok=1
+    else ranwrong=1; echo "  FAIL self compiler exited $rc and said [$got]"; fi
 fi
 echo
 echo "bigclosure targets=$expected identical=$same differ=$diff host-selected=$host_selected self-ran=$ranok wrong=$ranwrong"
