+        if (hb) { printf("vocab_check: %s heads != %s BH_%s_*\n", bf[i], model, up); bad++; }
+        nbf += g->fname.n; nbh += g->hname.n;
+    }
+    printf("vocab_check: %d vocab rows (%d generated + typekw %s) and %d bfbh nets (%d BF, %d BH) %s %s\n",
+           nv, gen, typekws, nb, nbf, nbh, bad ? "!=" : "==", model);
