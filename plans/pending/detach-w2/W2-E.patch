+    }
+    for (i = 0; i < nv; i++) {
+        lst got; int cnt; char nsym[96];
+        if (!strcmp(vkind[i], "typekw")) {
+            if (strcmp(vsym[i], "TYPEV")) { printf("vocab_check: typekw row %s is not TYPEV\n", vsym[i]); bad++; }
+            continue;   /* TYPEV's values: the typekw mode */
+        }
+        if (!cvalue(inc, vsym[i], &got, &cnt) || cnt != 1) { printf("vocab_check: %s: %d definitions in %s, want 1\n", vsym[i], cnt, model); bad++; continue; }
+        {
+            gold *g = table(vnet[i]); const lst *names = !strcmp(vfh[i], "field") ? &g->fname : &g->hname; int at = index_of(names, vname[i]);
+            const lst *want = at < 0 ? 0 : (!strcmp(vfh[i], "field") ? &g->fval[at] : &g->hval[at]);
