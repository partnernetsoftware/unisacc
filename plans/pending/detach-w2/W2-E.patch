+#!/usr/bin/env -S unisacc.com -run
+/* tsvcheck.cx -- the J10 declared tables judged against the committed model, without Python (2026-10-23,
+   plans/unisa-detach.md W2-E; replaces iterate/kernel/order_check.py, typekw_check.py and vocab_check.py, which
+   compared the tables with the archived seed's tuples).  The tables are the authority genmodel reads; what they are
+   compared with now is what is committed: kernel/unisa_model.inc (written from them), weights/built.uns2 and the
+   weights/gold/*.tsv headers.
+     sh ./unisacc.com -run iterate/kernel/tsvcheck.cx -- order
+         iterate/kernel/order.tsv (rows KEY<TAB>VALUE: one key for the per-net rows, plus heads_max): its net list,
+         in order, is the S_<NET> defines of kernel/unisa_model.inc (S_<NET> = the row's index, NAME upper-cased);
+         as a set it is the nets of weights/built.uns2 and the nets whose weights/gold/NET.tsv is exported (first
+         line `# ... NET: N keys, generated by ...`; the DECLARED tables lexcls / lexword are not nets of the kernel);
+         heads_max is the stride of the committed head-count array (its length / NSTAGE) and no built.uns2 net has
+         more heads.  `order.tsv == ...` and rc 0, else `order.tsv != ...` with the first difference, rc 1.
+     sh ./unisacc.com -run iterate/kernel/tsvcheck.cx -- typekw [TYPEKW.tsv [MODEL.inc]]
+         the kw rows of TYPEKW.tsv (default iterate/kernel/typekw.tsv) are the values of char *TYPEV in MODEL.inc
+         (default kernel/unisa_model.inc), in order.  The .py's lines: `typekw_check: PATH == ... (N values, same
+         order)` rc 0; `typekw_check: DIFFERENCE: ...` and one line per differing position, rc 1; a malformed table or
+         a model without exactly one non-empty TYPEV is one `typekw_check: ...` line, rc 1.
+     sh ./unisacc.com -run iterate/kernel/tsvcheck.cx -- vocab [MODEL.inc]
+         iterate/kernel/vocab.tsv against the vocab / BF / BH region of MODEL.inc (after the `}` closing
+         model_dims(), up to the first `/ * ENC_` comment -- the anchors of iterate/kernel/vregion.awk): the char *
+         vocab symbols, in order, are the vocab/typekw rows; each vocab symbol's '\0'-separated values are its
+         table's #field / #head list (weights/gold/NET.tsv) and N<SYM> is their count; the BF_ / BH_ symbols come in
+         the bfbh rows' order; per bfbh net BF_<NET>_<i> is #field i, BH_<NET>_<HEAD> the classes of #head HEAD and
+         HD_<NET>_<HEAD> its index, and no other BF_ / BH_ symbol of that net exists.  Each difference is one
+         `vocab_check: ...` line, then the summary `vocab_check: ... ==|!= MODEL`, rc 0 / 1; an empty region, no
+         vocab or no bfbh rows is one `vocab_check: ...` line, rc 1 (fail closed).
+   Run from the repository root.  rc 2: usage or an unreadable input. */
+
+#define MAXL 512        /* values of one list */
+#define MAXN 64         /* nets / rows */
+
+typedef struct lst { char *v[MAXL]; int n; } lst;
+static const char *TAG = "tsvcheck";
+
+static void die(const char *what, const char *arg) { fflush(stdout); fprintf(stderr, "%s: %s%s\n", TAG, what, arg ? arg : ""); exit(2); }
+static char *dupn(const char *s, size_t n) { char *d = malloc(n + 1); if (!d) exit(2); memcpy(d, s, n); d[n] = 0; return d; }
+static char *slurp(const char *path) { size_t n; char *b = cx_read(path, &n); if (!b) die("cannot read ", path); return b; }
+static void push(lst *l, const char *s, size_t n) { if (l->n == MAXL) die("list too long", 0); l->v[l->n++] = dupn(s, n); }
+static int same(const lst *a, const lst *b) { int i; if (a->n != b->n) return 0; for (i = 0; i < a->n; i++) if (strcmp(a->v[i], b->v[i])) return 0; return 1; }
+static int index_of(const lst *l, const char *s) { int i; for (i = 0; i < l->n; i++) if (!strcmp(l->v[i], s)) return i; return -1; }
+/* lines of a text, in place */
+static int lines(char *b, char **ln, int max) {
+    int n = 0; char *p = b;
+    while (*p) { char *e = strchr(p, '\n'); if (n == max) die("too many lines", 0); ln[n++] = p; if (!e) break; *e = 0; p = e + 1; }
+    return n;
+}
+static int tabs(char *s, char **c, int max) { int n = 1; c[0] = s; while (*s) { if (*s == '\t') { *s = 0; if (n == max) return -1; c[n++] = s + 1; } s++; } return n; }
+static void upper(char *d, const char *s, size_t cap) { size_t i; for (i = 0; s[i] && i + 1 < cap; i++) d[i] = (char)(s[i] >= 'a' && s[i] <= 'z' ? s[i] - 32 : s[i]); d[i] = 0; }
+/* a Python repr of a plain string: '...' with \\ and \' escaped (the .py printed %r) */
+static void repr(char *d, size_t cap, const char *s) {
+    size_t k = 0; if (cap < 4) return;
+    d[k++] = '\'';
+    for (; *s && k + 3 < cap; s++) { if (*s == '\\' || *s == '\'') d[k++] = '\\'; d[k++] = *s; }
+    d[k++] = '\''; d[k] = 0;
+}
