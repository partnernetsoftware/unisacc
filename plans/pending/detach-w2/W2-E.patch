diff --git a/exec/lex/declcheck.cx b/exec/lex/declcheck.cx
new file mode 100644
index 0000000..b7b77db
--- /dev/null
+++ b/exec/lex/declcheck.cx
@@ -0,0 +1,377 @@
+#!/usr/bin/env -S unisacc.com -run
+/* declcheck.cx -- the E1 declaration check without Python (2026-10-23, plans/unisa-detach.md W2-E; replaces
+   exec/lex/declcheck.py, which was exec/lex/gen.py --check-declarations): the declared lexer data agrees with the C
+   lexer.  Declared: weights/gold/lexcls.tsv (byte -> class, attws), weights/gold/lexword.tsv (skipparen / drop words,
+   character and string prefixes), the token order of weights/gold/parse.tsv `#field tok`, the class order of
+   weights/gold/lex.tsv `#field c`, iterate/kernel/typekw.tsv and EOF of exec/facts/lex-consts.tsv.  Judged against:
+   src/front_pp.c isal() / isdi() / charclass() / lex(), the OPCH[n] = 1 lines of src/front_parse.c, and the
+   committed TOKV / TYPEV strings of kernel/unisa_model.inc.
+     sh ./unisacc.com -run exec/lex/declcheck.cx        (exec/lex/run.sh runs it before the E1 table is generated)
+   `lex declarations agree` and rc 0; a disagreement is one `AssertionError: WHAT` line on stderr, rc 1 (the .py's
+   traceback ended in the same message); a table that breaks the gold-table input contract (the reader of the .py,
+   unisa/tsvgold.py load_table: unique schema names, values and classes, one column per field and head, in-domain
+   cells, no repeated key, the full product covered) is `GoldDataError: PATH: WHY`, rc 1.
+   What left with the seed: the .py also asserted that TOKS / TYPEKW equal the archived Python lexer's tuples; the
+   committed kernel/unisa_model.inc TOKV / TYPEV (checked here as before) is the comparison that stays.
+   The extraction from the C sources follows the .py's patterns literally (the same anchors, the same digit captures),
+   so a reformatted lexer fails closed rather than passing.  ROOT is the grandparent of this file's directory. */
+
+typedef struct dc_buf { char *p; size_t n, cap; } dc_buf;
+static char ROOT[4096];
+
+static void dc_put(dc_buf *b, const char *s, size_t n) {
+    if (b->n + n + 1 > b->cap) { b->cap = (b->n + n + 1) * 2 + 64; b->p = realloc(b->p, b->cap); if (!b->p) exit(2); }
+    memcpy(b->p + b->n, s, n); b->n += n; b->p[b->n] = 0;
+}
+static void fail(const char *what) { fflush(stdout); fprintf(stderr, "AssertionError: %s\n", what); exit(1); }
+static void fail2(const char *what, const char *detail) {
+    fflush(stdout); fprintf(stderr, "AssertionError: %s%s\n", what, detail); exit(1);
+}
+static char *dupn(const char *s, size_t n) { char *d = malloc(n + 1); if (!d) exit(2); memcpy(d, s, n); d[n] = 0; return d; }
+static int strcmp_ptr(const char *const *a, const char *const *b) { return strcmp(*a, *b); }
+static char *slurp(const char *rel) {
+    char p[8192]; size_t n; char *b;
+    snprintf(p, sizeof p, "%s/%s", ROOT, rel);
+    b = cx_read(p, &n);
+    if (!b) { fflush(stdout); fprintf(stderr, "FileNotFoundError: %s\n", rel); exit(1); }
+    return b;
+}
+/* split S at C in place; up to MAX cells; the count */
+static int split(char *s, char c, char **cell, int max) {
+    int n = 1; cell[0] = s;
+    while (*s) { if (*s == c) { *s = 0; if (n == max) return -1; cell[n++] = s + 1; } s++; }
+    return n;
+}
+/* the text between the first A (searched from S) and the first B after it; fails like str.index */
+static const char *find(const char *s, const char *a, const char *what) {
+    const char *p = strstr(s, a);
+    if (!p) fail2("anchor not found: ", what);
+    return p;
+}
+
+/* ---- a list of strings (a set when compared with same_set) ---- */
+typedef struct strs { char *v[512]; int n; } strs;
+static void add(strs *l, const char *s, size_t n) { if (l->n == 512) exit(2); l->v[l->n++] = dupn(s, n); }
+static int has(const strs *l, const char *s) { int i; for (i = 0; i < l->n; i++) if (!strcmp(l->v[i], s)) return 1; return 0; }
+static int same_set(const strs *a, const strs *b) {
+    int i; for (i = 0; i < a->n; i++) if (!has(b, a->v[i])) return 0;
+    for (i = 0; i < b->n; i++) if (!has(a, b->v[i])) return 0;
+    return 1;
+}
+
+/* ---- the .py's re.findall patterns: PRE (\d+) [MID (\d+)] POST, literal text around the digits, over [s, e) ---- */
+typedef struct nums { long a[512], b[512]; int n; } nums;
+static const char *digits(const char *p, const char *e, long *v) {
+    const char *q = p; long x = 0;
+    while (q < e && *q >= '0' && *q <= '9') { x = x * 10 + (*q - '0'); q++; }
+    if (q == p) return 0;
+    *v = x; return q;
+}
+static int lit(const char *p, const char *e, const char *t) { size_t n = strlen(t); return (size_t)(e - p) >= n && !memcmp(p, t, n); }
+static void findall(const char *s, const char *e, const char *pre, const char *mid, const char *post, nums *out) {
+    const char *p = s, *q; long x, y = 0; size_t np = strlen(pre);
+    out->n = 0;
+    while (p < e) {
+        const char *hit = 0, *t;
+        for (t = p; t + np <= e; t++) if (!memcmp(t, pre, np)) { hit = t; break; }
+        if (!hit) break;
+        q = digits(hit + np, e, &x);
+        if (q && mid) { if (lit(q, e, mid)) q = digits(q + strlen(mid), e, &y); else q = 0; }
+        if (q && lit(q, e, post)) {
+            if (out->n == 512) exit(2);
+            out->a[out->n] = x; out->b[out->n] = y; out->n++;
+            p = q + strlen(post);
+        } else p = hit + 1;
+    }
+}
+/* srcis\(i, j - i, "(\w+)"\) over [s, e) */
+static void srcis_words(const char *s, const char *e, strs *out) {
+    const char *pre = "srcis(i, j - i, \"", *p = s; size_t np = strlen(pre);
+    out->n = 0;
+    while (p + np <= e) {
+        const char *q;
+        if (memcmp(p, pre, np)) { p++; continue; }
+        q = p + np;
+        while (q < e && (*q == '_' || (*q >= '0' && *q <= '9') || (*q >= 'a' && *q <= 'z') || (*q >= 'A' && *q <= 'Z'))) q++;
+        if (q > p + np && lit(q, e, "\")")) { add(out, p + np, (size_t)(q - p - np)); p = q + 2; } else p++;
+    }
+}
+/* the first capture of PRE (\d+) POST in [s, e); the .py's re.search(...).group(1) (AttributeError when absent) */
+static long first(const char *s, const char *e, const char *pre, const char *post, const char *what) {
+    nums r; findall(s, e, pre, 0, post, &r);
+    if (!r.n) { fflush(stdout); fprintf(stderr, "AttributeError: no match for %s\n", what); exit(1); }
+    return r.a[0];
+}
+
+/* ---- the gold-table reader (unisa/tsvgold.py load_table's input contract) ---- */
+typedef struct col { char *name; char *v[300]; int nv; } col;
+typedef struct table { col f[8], h[8]; int nf, nh; char **rows; int nrows; } table;
+static void gbad(const char *path, const char *why) { fflush(stdout); fprintf(stderr, "GoldDataError: %s: %s\n", path, why); exit(1); }
+static int in_col(const col *c, const char *s) { int i; for (i = 0; i < c->nv; i++) if (!strcmp(c->v[i], s)) return i; return -1; }
+static void load_table(const char *rel, table *t) {
+    char *b = slurp(rel), *p = b, *nl, *cell[320]; int header = 0, named = 0, n, i, j; long prod = 1;
+    memset(t, 0, sizeof *t);
+    t->rows = malloc(sizeof(char *) * 70000); if (!t->rows) exit(2);
+    while (*p) {
+        nl = strchr(p, '\n'); if (nl) *nl = 0;
+        if (!strncmp(p, "# ", 2) && !named && strchr(p, ':')) {
+            /* the name line: `# <kind> NAME: ...`, NAME the file's stem */
+            const char *sl = strrchr(rel, '/'), *dot = strrchr(rel, '.'), *w = strchr(p + 2, ' '), *colon = strchr(p, ':');
+            size_t sn = (size_t)(dot - sl - 1);
+            if (w && w < colon && (size_t)(colon - w - 1) == sn && !memcmp(w + 1, sl + 1, sn)) named = 1;
+        } else {
+            char *line = dupn(p, strlen(p));
+            n = split(line, '\t', cell, 320);
+            if (n < 0) gbad(rel, "too many columns");
+            if (!strcmp(cell[0], "#field") || !strcmp(cell[0], "#head")) {
+                int isf = cell[0][1] == 'f'; col *c;
+                if (header) gbad(rel, "schema after the header");
+                if (n < (isf ? 3 : 4)) gbad(rel, isf ? "a field with no values" : "a head with no classes");
+                if ((isf ? t->nf : t->nh) == 8) exit(2);
+                c = isf ? &t->f[t->nf++] : &t->h[t->nh++];
+                c->name = cell[1];
+                for (i = isf ? 2 : 3; i < n; i++) { if (c->nv == 300) exit(2); c->v[c->nv++] = cell[i]; }
+            } else if (!header) {
+                if (n != t->nf + t->nh) gbad(rel, "header is not the schema's");
+                for (i = 0; i < t->nf; i++) if (strcmp(cell[i], t->f[i].name)) gbad(rel, "header is not the schema's");
+                for (i = 0; i < t->nh; i++) if (strncmp(cell[t->nf + i], "=> ", 3) || strcmp(cell[t->nf + i] + 3, t->h[i].name)) gbad(rel, "header is not the schema's");
+                header = 1;
+            } else {
+                if (n != t->nf + t->nh) gbad(rel, "a row's column count is not the schema's");
+                for (i = 0; i < t->nf; i++) if (in_col(&t->f[i], cell[i]) < 0) gbad(rel, "a key cell outside its field");
+                for (i = 0; i < t->nh; i++) if (in_col(&t->h[i], cell[t->nf + i]) < 0) gbad(rel, "a label outside its head's classes");
+                if (t->nrows == 70000) exit(2);
+                for (i = 1; i < n; i++) cell[i][-1] = '\t';   /* keep the row whole */
+                t->rows[t->nrows++] = line;
+            }
+        }
+        if (!nl) break;
+        p = nl + 1;
+    }
+    if (!named || !t->nf || !t->nh || !header) gbad(rel, "not a gold table with a schema");
+    for (i = 0; i < t->nf; i++) for (j = 0; j < i; j++) if (!strcmp(t->f[i].name, t->f[j].name)) gbad(rel, "field names repeat");
+    for (i = 0; i < t->nh; i++) for (j = 0; j < i; j++) if (!strcmp(t->h[i].name, t->h[j].name)) gbad(rel, "head names repeat");
+    for (i = 0; i < t->nf; i++) { int a, c; for (a = 0; a < t->f[i].nv; a++) for (c = 0; c < a; c++) if (!strcmp(t->f[i].v[a], t->f[i].v[c])) gbad(rel, "field values repeat"); prod *= t->f[i].nv; }
+    for (i = 0; i < t->nh; i++) { int a, c; for (a = 0; a < t->h[i].nv; a++) for (c = 0; c < a; c++) if (!strcmp(t->h[i].v[a], t->h[i].v[c])) gbad(rel, "head classes repeat"); }
+    /* keys: the first nf cells; unique (sorted copy) and as many as the product = the full cover */
+    {
+        char **k = malloc(sizeof(char *) * (size_t)(t->nrows + 1));
+        for (i = 0; i < t->nrows; i++) {
+            char *r = t->rows[i], *e = r; int c = 0;
+            while (*e && !(*e == '\t' && ++c == t->nf)) e++;
+            k[i] = dupn(r, (size_t)(e - r));
+        }
+        qsort(k, (size_t)t->nrows, sizeof *k, (int (*)(const void *, const void *))strcmp_ptr);
+        for (i = 1; i < t->nrows; i++) if (!strcmp(k[i], k[i - 1])) gbad(rel, "a key repeats");
+        if ((long)t->nrows != prod) gbad(rel, "the keys do not cover the fields' product");
+    }
+}
+/* cell I of row R (malloc'd) */
+static char *cellof(const char *r, int i) {
+    const char *s = r, *e; int c = 0;
+    while (c < i) { s = strchr(s, '\t'); if (!s) return dupn("", 0); s++; c++; }
+    e = strchr(s, '\t'); if (!e) e = s + strlen(s);
+    return dupn(s, (size_t)(e - s));
+}
+static int hidx(const table *t, const char *name) { int i; for (i = 0; i < t->nh; i++) if (!strcmp(t->h[i].name, name)) return t->nf + i; fail2("no such head: ", name); return 0; }
+
+/* the raw text of `char *NAME = "...";` in S split at the two characters \0 (the .py split the source text, not the
+   decoded bytes), the piece after the last separator dropped */
+static void cstring_list(const char *s, const char *name, strs *out) {
+    char a[64]; const char *p, *q; dc_buf raw = { 0, 0, 0 };
+    snprintf(a, sizeof a, "char *%s = \"", name);
+    out->n = 0;
+    p = strstr(s, a);
+    if (!p) fail(name);
+    p += strlen(a);
+    for (q = p; *q && *q != '"'; q++) if (*q == '\\' && q[1]) q++;
+    if (*q != '"' || q[1] != ';') fail(name);
+    dc_put(&raw, p, (size_t)(q - p));
+    if (!raw.p) return;
+    p = raw.p;
+    for (;;) { const char *z = strstr(p, "\\0"); if (!z) break; add(out, p, (size_t)(z - p)); p = z + 2; }
+}
+static int same_list(const strs *a, const strs *b) {
+    int i; if (a->n != b->n) return 0;
+    for (i = 0; i < a->n; i++) if (strcmp(a->v[i], b->v[i])) return 0;
+    return 1;
+}
+/* the cells after the first two of the first line of the file that starts with PREFIX */
+static int field_row(const char *text, const char *prefix, strs *out, int must_be_one) {
+    const char *p = text; int seen = 0; size_t np = strlen(prefix);
+    out->n = 0;
+    while (*p) {
+        const char *e = strchr(p, '\n'); if (!e) e = p + strlen(p);
+        if ((size_t)(e - p) >= np && !memcmp(p, prefix, np)) {
+            if (seen++ && !must_be_one) break;
+            if (seen == 1) {
+                const char *c = p + np;
+                for (;;) { const char *t = c; while (t < e && *t != '\t') t++; add(out, c, (size_t)(t - c)); if (t >= e) break; c = t + 1; }
+            }
+        }
+        if (!*e) break;
+        p = e + 1;
+    }
+    return seen;
+}
+
+int main(void) {
+    char up[8192], *pp, *fp, *inc, *lx, *body; const char *f = __FILE__, *sl = strrchr(f, '/');
+    strs toks, typekw, cfield, skipparen, drop, charpfx, strpfx, got; table lc, lw;
+    long eof = -1, cls[257]; int attws[257], i, ci, ai, gi, xi, si;
+    if (sl) snprintf(up, sizeof up, "%.*s/../..", (int)(sl - f), f); else snprintf(up, sizeof up, "../..");
+    if (!realpath(up, ROOT)) { fprintf(stderr, "declcheck: cannot resolve the repository root\n"); return 2; }
+
+    /* EOF (exec/facts/lex-consts.tsv: `# name<TAB>value` then rows) */
+    {
+        char *b = slurp("exec/facts/lex-consts.tsv"), *p = b;
+        while (*p) {
+            char *e = strchr(p, '\n'); if (e) *e = 0;
+            if (*p != '#' && !strncmp(p, "EOF\t", 4)) eof = atol(p + 4);
+            if (!e) break;
+            p = e + 1;
+        }
+        if (eof < 0) { fprintf(stderr, "KeyError: 'EOF'\n"); return 1; }
+    }
+    /* the token-ID contract: the declared parse #field tok order, exactly one such line */
+    {
+        char *b = slurp("weights/gold/parse.tsv");
+        if (field_row(b, "#field\ttok\t", &toks, 1) != 1 || !toks.n) fail("missing or repeated token schema");
+        for (i = 0; i < toks.n; i++) { int k; if (!*toks.v[i]) fail("invalid token schema"); for (k = 0; k < i; k++) if (!strcmp(toks.v[k], toks.v[i])) fail("invalid token schema"); }
+    }
+    /* TYPEKW: the kw rows of iterate/kernel/typekw.tsv */
+    {
+        char *b = slurp("iterate/kernel/typekw.tsv"), *p = b, *cell[4];
+        typekw.n = 0;
+        while (*p) {
+            char *e = strchr(p, '\n'); if (e) *e = 0;
+            if (*p && *p != '#') {
+                int n = split(p, '\t', cell, 4);
+                if (n != 2 || strcmp(cell[0], "kw") || !*cell[1]) fail("typekw.tsv row is not kw<TAB>value");
+                add(&typekw, cell[1], strlen(cell[1]));
+            }
+            if (!e) break;
+            p = e + 1;
+        }
+        if (!typekw.n) fail("typekw.tsv has no kw rows");
+        for (i = 0; i < typekw.n; i++) { int k; for (k = 0; k < i; k++) if (!strcmp(typekw.v[k], typekw.v[i])) fail("duplicate type keyword"); }
+    }
+    /* the declared data, read under the gold-table contract */
+    load_table("weights/gold/lexcls.tsv", &lc);
+    load_table("weights/gold/lexword.tsv", &lw);
+    for (i = 0; i < 257; i++) { cls[i] = -1; attws[i] = 0; }
+    ci = hidx(&lc, "c"); ai = hidx(&lc, "attws");
+    for (i = 0; i < lc.nrows; i++) {
+        char *bv = cellof(lc.rows[i], 0), *c = cellof(lc.rows[i], ci), *a = cellof(lc.rows[i], ai);
+        long b = !strcmp(bv, "eof") ? eof : atol(bv);
+        if (b < 0 || b > 256) { fprintf(stderr, "KeyError: %s\n", bv); return 1; }
+        cls[b] = in_col(&lc.h[0], c);   /* the class's index in lexcls' first head */
+        if (!strcmp(a, "yes")) attws[b] = 1;
+    }
+    gi = hidx(&lw, "gcc"); xi = hidx(&lw, "pfxch"); si = hidx(&lw, "pfxstr");
+    skipparen.n = drop.n = charpfx.n = strpfx.n = 0;
+    for (i = 0; i < lw.nrows; i++) {
+        char *w = cellof(lw.rows[i], 0), *g = cellof(lw.rows[i], gi);
+        if (!strcmp(g, "skipparen")) add(&skipparen, w, strlen(w));
+        if (!strcmp(g, "drop")) add(&drop, w, strlen(w));
+        if (!strcmp(cellof(lw.rows[i], xi), "yes")) add(&charpfx, w, strlen(w));
+        if (!strcmp(cellof(lw.rows[i], si), "yes")) add(&strpfx, w, strlen(w));
+    }
+
+    /* TOKV / TYPEV of the committed kernel/unisa_model.inc */
+    inc = slurp("kernel/unisa_model.inc");
+    cstring_list(inc, "TOKV", &got); if (!same_list(&got, &toks)) fail("TOKV");
+    cstring_list(inc, "TYPEV", &got); if (!same_list(&got, &typekw)) fail("TYPEV");
+
+    /* ---- agreement with the C lexer ---- */
+    pp = slurp("src/front_pp.c"); fp = slurp("src/front_parse.c");
+    {
+        char *b = slurp("weights/gold/lex.tsv");
+        if (!field_row(b, "#field\tc\t", &cfield, 0)) { fprintf(stderr, "IndexError: lex.tsv has no #field c line\n"); return 1; }
+        if (cfield.n != lc.h[0].nv) fail("lexcls classes != lex.tsv c field");
+        for (i = 0; i < cfield.n; i++) if (strcmp(cfield.v[i], lc.h[0].v[i])) fail("lexcls classes != lex.tsv c field");
+    }
+    {   /* charclass()'s body, isal/isdi as byte sets, OPCH */
+        const char *s = find(pp, "int charclass(int c) {", "charclass"), *e;
+        static int AL[257], DI[257], OP[257];
+        nums r, eq; long k_eof, k_al, k_di, k_op, k_other; int c;
+        s += strlen("int charclass(int c) {");
+        e = find(s, "\n}", "charclass end");
+        body = dupn(s, (size_t)(e - s));
+        for (c = 0; c < 2; c++) {
+            const char *fn = c ? "int isdi(int c) {" : "int isal(int c) {";
+            const char *b0 = find(pp, fn, fn), *b1;
+            int *set = c ? DI : AL; int k; long v;
+            b0 += strlen(fn); b1 = find(b0, "return 0;", "isal/isdi end");
+            findall(b0, b1, "c >= ", ") { if (c <= ", ")", &r);
+            for (k = 0; k < r.n; k++) for (v = r.a[k]; v <= r.b[k]; v++) if (v >= 0 && v < 257) set[v] = 1;
+            findall(b0, b1, "c == ", 0, ") return 1", &r);
+            for (k = 0; k < r.n; k++) if (r.a[k] >= 0 && r.a[k] < 257) set[r.a[k]] = 1;
+        }
+        for (i = 0; i < toks.n; i++) if (*toks.v[i]) OP[(unsigned char)toks.v[i][0]] = 1;
+        findall(fp, fp + strlen(fp), "OPCH[", 0, "] = 1", &r);
+        for (i = 0; i < r.n; i++) if (r.a[i] >= 0 && r.a[i] < 257) OP[r.a[i]] = 1;
+        e = body + strlen(body);
+        k_eof = first(body, e, "c < 0) return ", "", "the eof return");
+        findall(body, e, "if (c == ", ") return ", ";", &eq);
+        k_al = first(body, e, "isal(c)) return ", "", "the isal return");
+        k_di = first(body, e, "isdi(c)) return ", "", "the isdi return");
+        k_op = first(body, e, "OPCH[c]) return ", "", "the OPCH return");
+        k_other = first(body, e, "\n    return ", ";", "the last return");
+        for (c = 0; c < 257; c++) {
+            long k = -1; int m; char msg[256];
+            if (c == eof) k = k_eof;
+            else {
+                for (m = 0; m < eq.n; m++) if (eq.a[m] == c) { k = eq.b[m]; break; }
+                if (k < 0) k = AL[c] ? k_al : DI[c] ? k_di : (c < 128 && OP[c]) ? k_op : k_other;
+            }
+            if (k < 0 || k >= cfield.n) { fprintf(stderr, "IndexError: charclass() returns %ld\n", k); return 1; }
+            if (cls[c] < 0) { fprintf(stderr, "KeyError: %d\n", c); return 1; }
+            if (strcmp(lc.h[0].v[cls[c]], cfield.v[k])) {
+                snprintf(msg, sizeof msg, "lexcls: byte %d is %s, charclass() says %s", c, lc.h[0].v[cls[c]], cfield.v[k]);
+                fail(msg);
+            }
