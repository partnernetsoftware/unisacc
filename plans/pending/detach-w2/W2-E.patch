+/* ---- weights/gold/NET.tsv: the #field and #head lists ---- */
+typedef struct gold { char net[64]; lst fname, hname; lst fval[16], hval[16]; } gold;
+static gold G[MAXN]; static int NG;
+static gold *table(const char *net) {
+    int i; char path[512], *b, *ln[70000], *c[600]; int n, k;
+    for (i = 0; i < NG; i++) if (!strcmp(G[i].net, net)) return &G[i];
+    if (NG == MAXN) die("too many tables", 0);
+    snprintf(path, sizeof path, "weights/gold/%s.tsv", net);
+    b = slurp(path); n = lines(b, ln, 70000);
+    memset(&G[NG], 0, sizeof(gold)); snprintf(G[NG].net, 64, "%s", net);
+    for (i = 0; i < n; i++) {
+        int m, isf = !strncmp(ln[i], "#field\t", 7), ish = !strncmp(ln[i], "#head\t", 6);
+        if (!isf && !ish) continue;
+        m = tabs(ln[i], c, 600); if (m < 0) die("too many cells in ", path);
+        if (isf) { if (G[NG].fname.n == 16) die("too many fields in ", path); push(&G[NG].fname, c[1], strlen(c[1])); for (k = 2; k < m; k++) push(&G[NG].fval[G[NG].fname.n - 1], c[k], strlen(c[k])); }
+        else { if (G[NG].hname.n == 16) die("too many heads in ", path); push(&G[NG].hname, c[1], strlen(c[1])); for (k = 3; k < m; k++) push(&G[NG].hval[G[NG].hname.n - 1], c[k], strlen(c[k])); }
+    }
+    return &G[NG++];
+}
+
+/* ---- order ---- */
+static int order(void) {
+    char *b = slurp("iterate/kernel/order.tsv"), *ln[512], *c[4], *inc = slurp("kernel/unisa_model.inc"), key[64] = "";
+    lst nets = { { 0 }, 0 }, hm = { { 0 }, 0 }, defs = { { 0 }, 0 }, exported = { { 0 }, 0 }, built = { { 0 }, 0 };
+    int n = lines(b, ln, 512), i, bad = 0, setbad = 0, maxheads = 0; long nst, ncls, stride = -1; const char *p;
+    char why[600] = "", why2[600] = "";
+    for (i = 0; i < n; i++) {
+        int m; if (!ln[i][0] || ln[i][0] == '#') continue;
+        m = tabs(ln[i], c, 4);
+        if (!strcmp(c[0], "heads_max")) { push(&hm, m == 2 ? c[1] : "", m == 2 ? strlen(c[1]) : 0); continue; }
+        if (!key[0]) snprintf(key, sizeof key, "%s", c[0]);
+        if (strcmp(c[0], key) || m != 2) { printf("order.tsv: line %d: a row that is neither %s NAME nor heads_max N\n", i + 1, key); return 1; }
+        push(&nets, c[1], strlen(c[1]));
+    }
+    /* the committed S_<NET> defines, in file order */
+    for (p = inc; (p = strstr(p, "\n#define S_")); p++) {
+        const char *s = p + 11, *e = s; char low[64]; size_t k;
+        while (*e && *e != ' ' && *e != '\n') e++;
+        if ((size_t)(e - s) >= sizeof low) continue;
+        for (k = 0; k < (size_t)(e - s); k++) low[k] = (char)(s[k] >= 'A' && s[k] <= 'Z' ? s[k] + 32 : s[k]);
+        low[k] = 0;
+        if (atol(e) != defs.n) { snprintf(why, sizeof why, "S_%.*s is %ld, its position is %d", (int)(e - s), s, atol(e), defs.n); bad = 1; }
+        push(&defs, low, k);
+    }
+    if (!same(&nets, &defs) && !bad) { snprintf(why, sizeof why, "the S_* defines name a different list"); bad = 1; }
+    /* weights/gold: the exported tables */
+    {
+        DIR *d = opendir("weights/gold"); struct dirent *e;
+        if (!d) die("cannot read weights/gold", 0);
+        while ((e = readdir(d))) {
+            size_t L = strlen(e->d_name); char path[512], *t, *nl, *w, *colon;
+            if (L < 5 || strcmp(e->d_name + L - 4, ".tsv")) continue;
+            snprintf(path, sizeof path, "weights/gold/%s", e->d_name);
+            t = slurp(path); nl = strchr(t, '\n'); if (nl) *nl = 0;
+            w = !strncmp(t, "# ", 2) ? strchr(t + 2, ' ') : 0; colon = strchr(t, ':');
+            if (w && colon && w < colon && (size_t)(colon - w - 1) == L - 4 && !memcmp(w + 1, e->d_name, L - 4) && strstr(colon, "keys, generated by"))
+                push(&exported, e->d_name, L - 4);
+            free(t);
+        }
+        closedir(d);
+    }
+    /* weights/built.uns2: the net names and their head counts */
+    {
+        size_t un; unsigned char *u = (unsigned char *)cx_read("weights/built.uns2", &un); size_t q = 16; int s, ns, k;
+        if (!u || un < 16 || memcmp(u, "UNS2", 4)) die("weights/built.uns2 is not UNS2", 0);
+        ns = u[6] | u[7] << 8;
+        for (s = 0; s < ns; s++) {
+            int nf, nh; unsigned long w1;
+            if (q + 24 > un) die("weights/built.uns2 truncated", 0);
+            { size_t L = 0; while (L < 16 && u[q + L]) L++; push(&built, (char *)u + q, L); }
+            nf = u[q + 20]; nh = u[q + 21]; if (nh > maxheads) maxheads = nh;
+            q += 24 + 2 * (size_t)nf;
+            if (q + 4 > un) die("weights/built.uns2 truncated", 0);
+            w1 = u[q] | u[q + 1] << 8 | (unsigned long)u[q + 2] << 16 | (unsigned long)u[q + 3] << 24; q += 4 + w1;
+            for (k = 0; k < nh; k++) {
+                unsigned long hl;
+                if (q + 8 > un) die("weights/built.uns2 truncated", 0);
+                hl = u[q + 4] | u[q + 5] << 8 | (unsigned long)u[q + 6] << 16 | (unsigned long)u[q + 7] << 24; q += 8 + hl;
+            }
+        }
+        if (q != un) die("weights/built.uns2: trailing bytes", 0);
+    }
+    for (i = 0; i < nets.n && !setbad; i++) if (index_of(&exported, nets.v[i]) < 0 || index_of(&built, nets.v[i]) < 0) { snprintf(why2, sizeof why2, "%s is not an exported weights/gold table and a built.uns2 net", nets.v[i]); setbad = 1; }
+    for (i = 0; i < exported.n && !setbad; i++) if (index_of(&nets, exported.v[i]) < 0) { snprintf(why2, sizeof why2, "weights/gold/%s.tsv is exported but not listed", exported.v[i]); setbad = 1; }
+    for (i = 0; i < built.n && !setbad; i++) if (index_of(&nets, built.v[i]) < 0) { snprintf(why2, sizeof why2, "built.uns2 net %s is not listed", built.v[i]); setbad = 1; }
+    for (i = 0; i < nets.n && !setbad; i++) { int k; for (k = 0; k < i; k++) if (!strcmp(nets.v[i], nets.v[k])) { snprintf(why2, sizeof why2, "%s listed twice", nets.v[i]); setbad = 1; } }
+    nst = cdefine(inc, "NSTAGE");
+    p = strstr(inc, "_NCLS["); ncls = p ? atol(p + 6) : -1;
+    if (nst > 0 && ncls > 0 && ncls % nst == 0) stride = ncls / nst;
+    {
+        int hmok = hm.n == 1 && atol(hm.v[0]) == stride && stride > 0 && maxheads <= stride;
+        char hms[128];
+        snprintf(hms, sizeof hms, "%s%s%s", hm.n ? "[['" : "[", hm.n ? hm.v[0] : "", hm.n ? "']]" : "]");
+        printf("order.tsv %s kernel/unisa_model.inc S_* (%d nets; exported weights/gold and built.uns2 %s), heads_max %s %s NCLS stride %ld (most heads in built.uns2: %d)\n",
+               bad || setbad ? "!=" : "==", nets.n, setbad ? "differ" : "agree", hms, hmok ? "==" : "!=", stride, maxheads);
+        if (bad) printf("order.tsv: %s\n", why);
+        if (setbad) printf("order.tsv: %s\n", why2);
+        return bad || setbad || !hmok;
+    }
+}
+
+/* ---- typekw ---- */
+static int typekw(const char *path, const char *model) {
+    char *b = slurp(path), *ln[512], *c[4], *inc = slurp(model), a[256], x[256];
+    lst decl = { { 0 }, 0 }, tv = { { 0 }, 0 }; int n = lines(b, ln, 512), i, cnt;
+    if (n && !ln[n - 1][0]) n--;
+    for (i = 0; i < n; i++) {
+        if (ln[i][0] == '#') continue;
+        if (tabs(ln[i], c, 4) != 2 || strcmp(c[0], "kw")) { printf("typekw_check: %s line %d: want kw<TAB>value\n", path, i + 1); return 1; }
+        push(&decl, c[1], strlen(c[1]));
+    }
+    if (!decl.n) { printf("typekw_check: %s: no kw rows\n", path); return 1; }
+    if (!cvalue(inc, "TYPEV", &tv, &cnt) || cnt != 1) { printf("typekw_check: %s: %d TYPEV definitions, want 1\n", model, cnt); return 1; }
+    if (!tv.n) { printf("typekw_check: %s: TYPEV is empty\n", model); return 1; }
+    if (same(&decl, &tv)) { printf("typekw_check: %s == %s TYPEV (%d values, same order)\n", path, model, decl.n); return 0; }
+    printf("typekw_check: DIFFERENCE: %s != %s TYPEV\n", path, model);
+    for (i = 0; i < (decl.n > tv.n ? decl.n : tv.n); i++) {
+        const char *da = i < decl.n ? decl.v[i] : "(none)", *db = i < tv.n ? tv.v[i] : "(none)";
+        if (strcmp(da, db)) { repr(a, sizeof a, da); repr(x, sizeof x, db); printf("typekw_check:   [%d] declared %s, TYPEV %s\n", i, a, x); }
+    }
+    {   /* same set? */
+        int same_set = decl.n == tv.n;
+        for (i = 0; i < decl.n && same_set; i++) { int k, ca = 0, cb = 0; for (k = 0; k < decl.n; k++) { ca += !strcmp(decl.v[k], decl.v[i]); cb += !strcmp(tv.v[k], decl.v[i]); } if (ca != cb) same_set = 0; }
+        if (same_set) puts("typekw_check:   same set, different order");
+    }
+    return 1;
+}
+
+/* ---- vocab ---- */
+static int vocab(const char *model) {
+    char *b = slurp("iterate/kernel/vocab.tsv"), *ln[512], *c[8], *inc = slurp(model), *region, *ml[8192], *r0, *r1;
+    char *vsym[MAXN], *vkind[MAXN], *vnet[MAXN], *vfh[MAXN], *vname[MAXN], *bf[MAXN], *rsym[MAXN], *bforder[MAXN];
+    int n = lines(b, ln, 512), nv = 0, nb = 0, nr = 0, nbo = 0, i, k, bad = 0, nbf = 0, nbh = 0, gen = 0, m;
+    char typekws[256] = "[";
+    for (i = 0; i < n; i++) {
+        if (!ln[i][0] || ln[i][0] == '#') continue;
+        m = tabs(ln[i], c, 8);
+        if (!strcmp(c[0], "vocab") || !strcmp(c[0], "typekw")) {
+            if (nv == MAXN) die("too many vocab rows", 0);
+            vkind[nv] = c[0]; vsym[nv] = m > 1 ? c[1] : ""; vnet[nv] = m > 2 ? c[2] : ""; vfh[nv] = m > 3 ? c[3] : ""; vname[nv] = m > 4 ? c[4] : "";
+            if (!strcmp(c[0], "typekw")) { if (typekws[1]) strcat(typekws, ", "); strcat(typekws, "'"); strncat(typekws, vsym[nv], 64); strcat(typekws, "'"); }
+            else gen++;
+            nv++;
+        } else if (!strcmp(c[0], "bfbh")) { if (nb == MAXN) die("too many bfbh rows", 0); bf[nb++] = m > 1 ? c[1] : ""; }
+    }
+    strcat(typekws, "]");
+    if (!nv || !nb) { puts("vocab_check: vocab.tsv has no vocab/typekw or no bfbh rows"); return 1; }
+    /* the region: after the `}` closing model_dims(), up to the first `/ * ENC_` line */
+    r0 = strstr(inc, "\nint model_dims(void) {\n");
+    if (r0) r0 = strstr(r0, "\n}\n");
+    if (!r0) { printf("vocab_check: %s: no model_dims() to anchor the region\n", model); return 1; }
+    r0 += 3;
+    r1 = strstr(r0, "\n/* ENC_"); if (!r1) r1 = r0 + strlen(r0); else r1++;
+    region = dupn(r0, (size_t)(r1 - r0));
+    m = lines(region, ml, 8192);
+    for (i = 0; i < m; i++) {
+        if (!strncmp(ml[i], "char *", 6)) {
