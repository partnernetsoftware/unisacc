+/* ---- the committed model: `char *NAME = "...";` decoded (C escapes) and split at NUL; #define NAME N ---- */
+static int cvalue(const char *text, const char *name, lst *out, int *count) {
+    char pat[160]; const char *p = text, *hit = 0; int found = 0;
+    snprintf(pat, sizeof pat, "char *%s = \"", name);
+    out->n = 0;
+    while ((p = strstr(p, pat))) { if (p == text || p[-1] == '\n') { found++; if (!hit) hit = p; } p++; }
+    if (count) *count = found;
+    if (!hit) return 0;
+    {
+        const char *q = hit + strlen(pat); char buf[65536]; size_t n = 0, s0 = 0;
+        while (*q && *q != '"') {
+            int c = (unsigned char)*q++;
+            if (c == '\\') {
+                c = (unsigned char)*q++;
+                if (c >= '0' && c <= '7') { int v = c - '0', k; for (k = 0; k < 2 && *q >= '0' && *q <= '7'; k++) v = v * 8 + (*q++ - '0'); c = v; }
+                else if (c == 'n') c = '\n'; else if (c == 't') c = '\t';
+            }
+            if (n + 1 >= sizeof buf) die("string too long: ", name);
+            buf[n++] = (char)c;
+        }
+        if (*q != '"' || q[1] != ';') return 0;
+        for (s0 = 0; s0 < n; ) { size_t e = s0; while (e < n && buf[e]) e++; if (e == n) break; push(out, buf + s0, e - s0); s0 = e + 1; }
+    }
+    return 1;
+}
+static long cdefine(const char *text, const char *name) {
+    char pat[160]; const char *p = text; size_t n;
+    snprintf(pat, sizeof pat, "#define %s ", name); n = strlen(pat);
+    while ((p = strstr(p, pat))) { if (p == text || p[-1] == '\n') return atol(p + n); p++; }
+    return -1;
+}
