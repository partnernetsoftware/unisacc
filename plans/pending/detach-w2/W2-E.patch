new file mode 100644
index 0000000..ae6af30
--- /dev/null
+++ b/tests/pptruthcheck.cx
@@ -0,0 +1,78 @@
+#!/usr/bin/env -S unisacc.com -run
+/* pptruthcheck.cx -- the R9 #if syntax regression without Python (2026-10-23, plans/unisa-detach.md W2-E; replaces
+   tests/pptruthcheck.py, which asked the archived seed's #if evaluator).  The rows are frozen in tests/pptruth.tsv
+   (captured from the .py at a1df62cc); the evaluator judged is the product's own preprocessor.
+     sh ./unisacc.com -run tests/pptruthcheck.cx [-- COMPILER]      (gate job pptruth; COMPILER default ./unisacc.com)
+   Run from the repository root.  Per row one C file in a mkdtemp directory:
+       [#define NAME VALUE]  [#if 0]  #if EXPR  int main(void) { return 3; }  #else  int main(void) { return 4; }
+       #endif  [#else  int main(void) { return 4; }  #endif]
+   (the bracketed `#if 0` wrapper only for a dead row, whose own group is then skipped and main returns 4), run as
+   `sh COMPILER FILE -run`, stdout and stderr together, bounded at 20 s.  Taken = rc 3, not taken = rc 4; refused =
+   any other rc with an output line that starts `reject: `.  A row whose verdict differs is one `pptruth: ROW: ...`
+   line; the summary counts the rows per kind as the .py did:
+       pptruth: valid 9, malformed 19, division 2 passed
+   rc 0 every row holds, 1 a row differs, 2 usage / table / I/O.  The scratch directory is removed through the one
+   deletion guard (cx_rmtree). */
+
+#define MAXR 128
+
+static char dir[4096];          /* the own mkdtemp scratch directory, empty until made */
+static void cleanup(void) { if (dir[0]) cx_rmtree(dir); dir[0] = 0; }
+static void die(const char *what, const char *arg) {
+    cleanup(); fflush(stdout); fprintf(stderr, "pptruth: %s%s\n", what, arg ? arg : ""); exit(2);
+}
+
+int main(int argc, char **argv) {
+    char *tsv, *p, *cell[8], src[4200], *rows[MAXR]; size_t n; int nrows = 0, i, bad = 0;
+    int counts[3] = { 0, 0, 0 }; const char *kinds[3] = { "valid", "malformed", "division" };
+    const char *com = argc > 1 ? argv[1] : "./unisacc.com", *td = getenv("TMPDIR");
+    if (argc > 2) die("usage: pptruthcheck.cx [COMPILER]", 0);
+    tsv = cx_read("tests/pptruth.tsv", &n);
+    if (!tsv) die("cannot read tests/pptruth.tsv (run from the repository root)", 0);
+    for (p = tsv; *p; ) {
+        char *e = strchr(p, '\n'); if (e) *e = 0;
+        if (*p && *p != '#') { if (nrows == MAXR) die("too many rows", 0); rows[nrows++] = p; }
+        if (!e) break;
+        p = e + 1;
+    }
+    snprintf(dir, sizeof dir, "%s/pptruth-XXXXXX", td && *td ? td : "/tmp");
+    if (!mkdtemp(dir)) die("cannot create the scratch directory", 0);
+    snprintf(src, sizeof src, "%s/t.c", dir);
+    for (i = 0; i < nrows; i++) {
+        char line[1024], text[2048], *out = 0, *argv2[6]; size_t on = 0; int nc, k, rc, dead, refused; const char *got;
+        snprintf(line, sizeof line, "%s", rows[i]);
+        nc = 1; cell[0] = line;
+        for (p = line; *p; p++) if (*p == '\t') { *p = 0; if (nc == 8) break; cell[nc++] = p + 1; }
+        if (nc != 5) { die("row is not kind<TAB>context<TAB>defines<TAB>expr<TAB>want: ", rows[i]); }
+        for (k = 0; k < 3 && strcmp(cell[0], kinds[k]); k++) ;
+        if (k == 3) { die("unknown kind: ", cell[0]); }
+        if (strcmp(cell[1], "live") && strcmp(cell[1], "dead")) { die("unknown context: ", cell[1]); }
+        if (strcmp(cell[4], "1") && strcmp(cell[4], "0") && strcmp(cell[4], "refuse")) { die("unknown want: ", cell[4]); }
+        dead = !strcmp(cell[1], "dead");
+        text[0] = 0;
+        if (strcmp(cell[2], "-")) {
+            char *eq = strchr(cell[2], '=');
+            if (!eq) { die("defines is not NAME=VALUE: ", cell[2]); }
+            snprintf(text + strlen(text), sizeof text - strlen(text), "#define %.*s %s\n", (int)(eq - cell[2]), cell[2], eq + 1);
+        }
+        if (dead) snprintf(text + strlen(text), sizeof text - strlen(text), "#if 0\n");
+        snprintf(text + strlen(text), sizeof text - strlen(text),
+                 "#if %s\nint main(void) { return 3; }\n#else\nint main(void) { return 4; }\n#endif\n", cell[3]);
+        if (dead) snprintf(text + strlen(text), sizeof text - strlen(text), "#else\nint main(void) { return 4; }\n#endif\n");
+        if (cx_write(src, text, strlen(text))) { die("cannot write ", src); }
+        argv2[0] = "sh"; argv2[1] = "-c"; argv2[2] = "sh \"$0\" \"$1\" -run 2>&1"; argv2[3] = (char *)com; argv2[4] = src; argv2[5] = 0;
+        rc = cx_runv_timeout(argv2, 20, &out, &on);
+        refused = out && (!strncmp(out, "reject: ", 8) || strstr(out, "\nreject: "));
+        got = rc == 3 && !refused ? "1" : rc == 4 && !refused ? "0" : refused && rc != 3 && rc != 4 ? "refuse" : 0;
+        if (!got || strcmp(got, cell[4])) {
+            printf("pptruth: %s %s `%s`: want %s, got %s (rc %d%s%.*s)\n", cell[0], cell[1], cell[3], cell[4], got ? got : "neither",
+                   rc, on ? ": " : "", (int)(on && out[on - 1] == '\n' ? on - 1 : on), out ? out : "");
+            bad++;
+        } else counts[k]++;
+        free(out);
+    }
+    cleanup();
+    if (bad) { printf("pptruth: %d of %d rows differ\n", bad, nrows); return 1; }
+    printf("pptruth: valid %d, malformed %d, division %d passed\n", counts[0], counts[1], counts[2]);
+    return 0;
+}
