+        }
+    }
+    if (!nr && !nbo) { printf("vocab_check: %s: the vocab / BF / BH region is empty\n", model); return 1; }
+    {   /* the symbol order */
+        int ok = nr == nv;
+        for (i = 0; i < nv && ok; i++) if (strcmp(rsym[i], vsym[i])) ok = 0;
+        if (!ok) {
+            printf("vocab_check: vocab order/symbols [");
+            for (i = 0; i < nv; i++) printf("%s'%s'", i ? ", " : "", vsym[i]);
+            printf("] != %s [", model);
+            for (i = 0; i < nr; i++) printf("%s'%s'", i ? ", " : "", rsym[i]);
+            printf("]\n"); bad++;
