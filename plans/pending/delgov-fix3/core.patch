+/* safedelrace: the one deletion guard (include/unisa_safedel.h) under races -- the tree it was asked to delete is
+   swapped for symlinks into a decoy repository, or for other directories, while the guard works.  Zero damage: the
+   decoy repository, the fake $HOME and a repository's src/ keep their full-tree checksum (every path, type, mode,
+   size, content and link target) through every case, and each case's swap must have struck.
+     sh unisacc.com -run tests/safedelrace.cx            (the gate job safedel-race)
+   Everything happens in a sandbox B = mkdtemp($TMPDIR or /tmp), S = B/s; the guard runs in process with HOME=S/home,
+   its cwd S/cwd and TMPDIR=S/t<k>, a fresh temp root per case.  Deterministic cases use the guard's race hook
+   (unisa_safedel_sethook): at the step and name a case names, the hook swaps the tree --
+     top          the target itself, after the check (a link; another real directory);
+     root         the temp root itself, after the check;
+     intermediate a directory above the target, after the check and during the descent (between two components);
+     leaf         a subdirectory or a file inside the target while the purge works (at depth 1 and 5), and a
+                  subdirectory after the walk;
+     trash        the target, and its parent, right before the move into the trash;
+     out/         a repository's out/ target, after the check;
+   then a concurrent stress: a child process renames a directory of the target back and forth with a link into the
+   decoy (renames only) while the parent purges and trashes, for a bounded number of rounds.  The sandbox goes through
+   the guard at the end (its fake .git entries renamed away first). */
+static char B[4096], S[4096];
+static int passes, fails;
+static char *at(const char *rel) {   /* S/rel in one of 16 rotating buffers */
+    static char buf[16][4096]; static int k; char *b = buf[k++ & 15];
+    if (!rel || !rel[0]) snprintf(b, 4096, "%s", S); else snprintf(b, 4096, "%s/%s", S, rel);
+    return b;
+}
+static void mkdirs(const char *p) {
+    char t[4096]; size_t i, n = strlen(p);
+    if (n >= sizeof t) return;
+    memcpy(t, p, n + 1);
+    for (i = 1; i <= n; i++) if (t[i] == '/' || t[i] == 0) { char c = t[i]; t[i] = 0; mkdir(t, 0755); t[i] = c; }
+}
+static void put(const char *rel, const char *text) {
+    char d[4096]; char *p = at(rel), *s;
+    snprintf(d, sizeof d, "%s", p); s = strrchr(d, '/'); if (s) { *s = 0; mkdirs(d); }
+    if (cx_write(p, text, strlen(text)) != 0) { printf("FAIL setup: cannot write %s\n", p); fails++; }
+}
+static int exists(const char *p) { struct stat st; return lstat(p, &st) == 0; }
+/* the tree checksum: sorted walk, lstat only */
+struct buf { char *p; size_t n, cap; };
+static void add(struct buf *b, const char *s) {
+    size_t l = strlen(s);
+    if (b->n + l + 1 > b->cap) { b->cap = (b->n + l + 1) * 2; b->p = realloc(b->p, b->cap); if (!b->p) exit(2); }
+    memcpy(b->p + b->n, s, l); b->n += l; b->p[b->n] = 0;
+}
+static int cmpname(const void *a, const void *b) { return strcmp(*(char *const *)a, *(char *const *)b); }
+static void tree(struct buf *b, const char *p, const char *rel) {
+    struct stat st; char line[9000];
+    if (lstat(p, &st) != 0) { snprintf(line, sizeof line, "? %s\n", rel); add(b, line); return; }
+    if (S_ISLNK(st.st_mode)) {
+        char t[4096]; long n = (long)readlink(p, t, sizeof t - 1); if (n < 0) n = 0; t[n] = 0;
+        snprintf(line, sizeof line, "L %s -> %s\n", rel, t); add(b, line);
+    } else if (S_ISDIR(st.st_mode)) {
+        DIR *d = opendir(p); struct dirent *e; char **v = 0; size_t n = 0, i;
+        snprintf(line, sizeof line, "D %s %o\n", rel, (unsigned)(st.st_mode & 07777)); add(b, line);
+        if (!d) { add(b, "unreadable\n"); return; }
+        while ((e = readdir(d))) {
+            if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
+            v = realloc(v, (n + 1) * sizeof *v); if (!v) exit(2);
+            v[n] = malloc(strlen(e->d_name) + 1); if (!v[n]) exit(2); memcpy(v[n], e->d_name, strlen(e->d_name) + 1); n++;
+        }
+        closedir(d);
+        if (n) qsort(v, n, sizeof *v, cmpname);
+        for (i = 0; i < n; i++) {
+            char cp[4096], cr[4096];
+            snprintf(cp, sizeof cp, "%s/%s", p, v[i]); snprintf(cr, sizeof cr, "%s/%s", rel, v[i]);
+            tree(b, cp, cr); free(v[i]);
+        }
+        free(v);
+    } else {
+        size_t len = 0; char *c = cx_read(p, &len), hex[65];
+        cx_sha256_hex(c ? c : "", c ? len : 0, hex); free(c);
+        snprintf(line, sizeof line, "F %s %o %ld %s\n", rel, (unsigned)(st.st_mode & 07777), (long)st.st_size, hex); add(b, line);
+    }
+}
+static void sum(const char *p, char hex[65]) {
+    struct buf b = {0, 0, 0}; add(&b, ""); tree(&b, p, "."); cx_sha256_hex(b.p, b.n, hex); free(b.p);
+}
+/* the protected trees: the decoy repository, the fake $HOME, the src/ of the repository whose out/ is a target */
+static void guarded(char out[65]) {
+    char a[65], b[65], c[65], all[200];
+    sum(at("decoy"), a); sum(at("home"), b); sum(at("proj/src"), c);
+    snprintf(all, sizeof all, "%s%s%s", a, b, c); cx_sha256_hex(all, strlen(all), out);
