+/* the case being run: at STEP (and NAME, when given) the hook renames K's REL aside and puts a link to DEST (a
+   path under S) there, or (DEST 0) a fresh real directory */
+static int H_STEP, H_FIRED; static const char *H_NAME; static char H_REL[512], H_DEST[512];
+static void swap_now(void) {
+    char real[4200];
+    snprintf(real, sizeof real, "%s.real", at(H_REL));
+    if (rename(at(H_REL), real) != 0) { printf("FAIL setup: cannot rename %s aside\n", H_REL); fails++; return; }
+    if (H_DEST[0]) { if (symlink(at(H_DEST), at(H_REL)) != 0) { printf("FAIL setup: symlink %s\n", H_REL); fails++; return; } }
+    else { mkdirs(at(H_REL)); { char f[4300]; snprintf(f, sizeof f, "%s/other", H_REL); put(f, "another directory\n"); } }
+    H_FIRED = 1;
+}
+static void hook(int step, const char *name) {
+    if (H_FIRED || step != H_STEP) return;
