+    H_STEP = 0;
+    {   int ok = H_FIRED && !strcmp(before, after) && (expect_rc < 0 || rc == expect_rc) && (!expect_why || strstr(WHY, expect_why));
+        if (ok) { passes++; printf("ok   race %-34s rc %d: %s\n", label, rc, shown()); }
+        else { fails++; printf("FAIL race %-34s rc %d fired %d damage %s: %s\n", label, rc, H_FIRED, strcmp(before, after) ? "YES" : "no", shown()); }
+    }
+}
+/* the concurrent stress: a child renames t<K>/A back and forth with the link t<K>/L (into the decoy) for CYCLES rounds
+   while the parent runs the guard on t<K>/A/B/victim; renames only, so the child leaves the layout as it found it */
+static void spin(long n) { volatile long i; for (i = 0; i < n; i++) ; }
+static int stress(int k, int rounds) {
+    char tp[64], a[512], ar[512], l[512], target[512], before[65], after[65]; int r, out[4] = {0, 0, 0, 0};
+    snprintf(tp, sizeof tp, "t%d", k);
+    snprintf(a, sizeof a, "%s/A", at(tp)); snprintf(ar, sizeof ar, "%s/A.real", at(tp)); snprintf(l, sizeof l, "%s/L", at(tp));
+    snprintf(target, sizeof target, "%s/A/B/victim", at(tp));
+    mkdirs(a);
+    if (symlink(at("decoy"), l) != 0) { printf("FAIL setup: stress link\n"); return 1; }
+    setenv("TMPDIR", at(tp), 1);
+    guarded(before);
+    srand(7);
+    for (r = 0; r < rounds; r++) {
+        int pid, st, rc, cycles = 20 + rand() % 200; long delay = rand() % 20000;
+        victim(k);
+        fflush(stdout); fflush(stderr);
+        pid = fork();
+        if (pid < 0) { printf("FAIL stress: fork\n"); return 1; }
+        if (pid == 0) {
+            int c;
+            for (c = 0; c < cycles; c++) {
+                if (rename(a, ar) != 0) _exit(3);
+                if (rename(l, a) != 0) { rename(ar, a); _exit(4); }
+                spin(rand() % 3000);
+                if (rename(a, l) != 0) _exit(5);
+                if (rename(ar, a) != 0) _exit(6);
+                spin(rand() % 3000);
+            }
+            _exit(0);
+        }
+        spin(delay);
+        rc = unisa_safedel(target, (r & 1) ? (SAFEDEL_PURGE | SAFEDEL_RECURSIVE) : SAFEDEL_RECURSIVE, 0, WHY, (int)sizeof WHY);
+        if (waitpid(pid, &st, 0) != pid || !WIFEXITED(st) || WEXITSTATUS(st) != 0) { printf("FAIL stress: the swapping child failed (round %d)\n", r); return 1; }
+        out[rc == 0 ? 0 : rc == 3 ? 1 : rc == 1 ? 2 : 3]++;
+        guarded(after);
+        if (strcmp(before, after)) { printf("FAIL stress round %d: DAMAGE (rc %d: %s)\n", r, rc, shown()); return 1; }
+    }
+    printf("ok   race %-34s %d rounds: %d done, %d refused, %d failed, %d other; zero damage\n", "stress-concurrent-swap", rounds, out[0], out[1], out[2], out[3]);
+    return 0;
+}
+int main(int argc, char **argv) {
+    const char *tmp0 = getenv("TMPDIR"), *home0 = getenv("HOME"); char cwd0[4096], base[4096], savetmp[4096], savehome[4096];
+    int hadtmp = tmp0 != 0, i, rounds = 300, rc;
+    for (i = 1; i < argc; i++) {
+        if (!strcmp(argv[i], "--rounds") && i + 1 < argc) rounds = atoi(argv[++i]);
+        else { fprintf(stderr, "usage: safedelrace [--rounds N]\n"); return 2; }
+    }
+    snprintf(savetmp, sizeof savetmp, "%s", tmp0 ? tmp0 : ""); snprintf(savehome, sizeof savehome, "%s", home0 ? home0 : "");
+    if (!getcwd(cwd0, sizeof cwd0)) return 2;
+    snprintf(base, sizeof base, "%s/safedelrace-XXXXXX", tmp0 && tmp0[0] ? tmp0 : "/tmp");
+    if (!mkdtemp(base) || !realpath(base, B)) { fprintf(stderr, "safedelrace: no sandbox\n"); return 2; }
+    snprintf(S, sizeof S, "%s/s", B);
+    /* the protected trees, and decoy copies of every shape a swapped link could land on */
+    put("home/notes", "home\n");
+    put("decoy/.git/HEAD", "ref: refs/heads/main\n");
+    for (i = 0; i < 10; i++) { char r[64]; snprintf(r, sizeof r, "decoy/src/c%02d", i); put(r, "canary\n"); }
+    for (i = 0; i < 10; i++) { char r[64]; snprintf(r, sizeof r, "decoy/victim/c%02d", i); put(r, "canary\n"); }
+    for (i = 0; i < 10; i++) { char r[64]; snprintf(r, sizeof r, "decoy/B/victim/c%02d", i); put(r, "canary\n"); }
+    for (i = 0; i < 10; i++) { char r[64]; snprintf(r, sizeof r, "decoy/A/B/victim/c%02d", i); put(r, "canary\n"); }
+    put("proj/.git/HEAD", "ref: refs/heads/main\n"); put("proj/src/a.c", "int a;\n"); put("proj/out/x/o", "o\n");
+    put("cwd/.keep", "the guard's cwd\n");
+    if (chdir(at("cwd")) != 0) return 2;
+    setenv("HOME", at("home"), 1);
+    unisa_safedel_sethook(hook);
+
+    /* top: the target itself */
+    race_case("top-checked-link", 1, "A/B/victim", SAFEDEL_PURGE | SAFEDEL_RECURSIVE, SAFEDEL_AT_CHECKED, 0, "A/B/victim", "decoy/victim", 3, "changed");
+    race_case("top-checked-other-dir", 2, "A/B/victim", SAFEDEL_PURGE | SAFEDEL_RECURSIVE, SAFEDEL_AT_CHECKED, 0, "A/B/victim", 0, 3, "changed");
+    race_case("top-checked-link-trash", 3, "A/B/victim", SAFEDEL_RECURSIVE, SAFEDEL_AT_CHECKED, 0, "A/B/victim", "decoy/victim", 3, "changed");
+    /* the temp root itself */
+    race_case("root-checked-link", 4, "A/B/victim", SAFEDEL_PURGE | SAFEDEL_RECURSIVE, SAFEDEL_AT_CHECKED, 0, "", "decoy", 3, "changed");
+    /* intermediate: above the target, after the check and between two components of the descent */
+    race_case("intermediate-checked-link", 5, "A/B/victim", SAFEDEL_PURGE | SAFEDEL_RECURSIVE, SAFEDEL_AT_CHECKED, 0, "A", "decoy", 3, "changed");
+    race_case("intermediate-checked-other-dir", 6, "A/B/victim", SAFEDEL_PURGE | SAFEDEL_RECURSIVE, SAFEDEL_AT_CHECKED, 0, "A/B", 0, 3, "changed");
+    race_case("intermediate-descent-link", 7, "A/B/victim", SAFEDEL_PURGE | SAFEDEL_RECURSIVE, SAFEDEL_AT_DESCENT, "A", "A/B", "decoy/B", 3, "changed");
+    race_case("intermediate-descent-parent-link", 8, "A/B/victim", SAFEDEL_RECURSIVE, SAFEDEL_AT_DESCENT, "B", "A/B/victim", "decoy/victim", 3, "changed");
+    /* leaf: inside the target while it is deleted (depth 1 and depth 5), and after the walk */
+    race_case("leaf-purge-depth1-link", 9, "A/B/victim", SAFEDEL_PURGE | SAFEDEL_RECURSIVE, SAFEDEL_AT_PURGEDIR, "sub", "A/B/victim/sub", "decoy/victim", 3, "changed");
+    race_case("leaf-purge-depth5-link", 10, "A/B/victim", SAFEDEL_PURGE | SAFEDEL_RECURSIVE, SAFEDEL_AT_PURGEDIR, "d3", "A/B/victim/sub/deep/d1/d2/d3", "decoy/src", 3, "changed");
+    race_case("leaf-purge-file-link", 11, "A/B/victim", SAFEDEL_PURGE | SAFEDEL_RECURSIVE, SAFEDEL_AT_UNLINK, "f05", "A/B/victim/f05", "decoy/src", -1, 0);
+    /* after the walk the purge lists each directory afresh: the swapped-in link is unlinked as a link, never followed */
+    race_case("leaf-walked-link", 12, "A/B/victim", SAFEDEL_PURGE | SAFEDEL_RECURSIVE, SAFEDEL_AT_WALKED, 0, "A/B/victim/sub", "decoy/victim", 0, "purged");
+    race_case("leaf-purge-parent-swapped", 13, "A/B/victim", SAFEDEL_PURGE | SAFEDEL_RECURSIVE, SAFEDEL_AT_PURGEDIR, "sub", "A/B", "decoy/B", -1, 0);
+    /* during the trash move */
+    race_case("trash-move-target-link", 14, "A/B/victim", SAFEDEL_RECURSIVE, SAFEDEL_AT_TRASH, 0, "A/B/victim", "decoy/victim", 1, "changed during the move");
+    race_case("trash-move-parent-link", 15, "A/B/victim", SAFEDEL_RECURSIVE, SAFEDEL_AT_TRASH, 0, "A/B", "decoy/B", -1, 0);
+    /* a repository's out/ target (trashed): out/x swapped for a link to its src/ after the check */
+    {   char before[65], after[65];
+        H_STEP = SAFEDEL_AT_CHECKED; H_NAME = 0; H_FIRED = 0; snprintf(H_REL, sizeof H_REL, "proj/out/x"); snprintf(H_DEST, sizeof H_DEST, "proj/src");
+        setenv("TMPDIR", at("t1"), 1);
+        guarded(before); rc = unisa_safedel(at("proj/out/x"), SAFEDEL_PURGE | SAFEDEL_RECURSIVE, 0, WHY, (int)sizeof WHY); guarded(after); H_STEP = 0;
+        if (H_FIRED && rc == 3 && strstr(WHY, "changed") && !strcmp(before, after)) { passes++; printf("ok   race %-34s rc %d: %s\n", "repo-out-checked-link", rc, shown()); }
+        else { fails++; printf("FAIL race %-34s rc %d fired %d damage %s: %s\n", "repo-out-checked-link", rc, H_FIRED, strcmp(before, after) ? "YES" : "no", shown()); } }
+    unisa_safedel_sethook(0);
+
+    /* concurrent: a real second process */
+    if (rounds > 0 && stress(16, rounds) != 0) fails++; else if (rounds > 0) passes++;
+
+    /* the sandbox, through the guard: the fake .git entries renamed away first; links inside are removed as links */
+    if (chdir(cwd0) != 0) return 2;
+    if (hadtmp) setenv("TMPDIR", savetmp, 1); else unsetenv("TMPDIR");
+    if (savehome[0]) setenv("HOME", savehome, 1); else unsetenv("HOME");
+    rename(at("decoy/.git"), at("decoy/dotgit-fixture")); rename(at("proj/.git"), at("proj/dotgit-fixture"));
+    rc = unisa_safedel(B, SAFEDEL_PURGE | SAFEDEL_RECURSIVE, 100000, WHY, (int)sizeof WHY);
+    if (rc != 0 || exists(B)) { printf("FAIL cleanup: the sandbox %s stays (rc %d: %s)\n", B, rc, WHY); fails++; }
+    printf("safedelrace: %d passed, %d failed\n", passes, fails);
+    return fails ? 1 : 0;
+}
