+/* the victim tree of case K: t<k>/A/B/victim with 20 files, sub/ (10 files) and sub/deep/d1/d2/d3 (5 files) */
+static void victim(int k) {
+    char r[256]; int i;
+    for (i = 0; i < 20; i++) { snprintf(r, sizeof r, "t%d/A/B/victim/f%02d", k, i); put(r, "victim\n"); }
+    for (i = 0; i < 10; i++) { snprintf(r, sizeof r, "t%d/A/B/victim/sub/g%02d", k, i); put(r, "sub\n"); }
+    for (i = 0; i < 5; i++) { snprintf(r, sizeof r, "t%d/A/B/victim/sub/deep/d1/d2/d3/h%d", k, i); put(r, "deep\n"); }
