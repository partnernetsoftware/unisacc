#pragma unisa module fmt
#pragma unisa dock
/* L0 text/fmt: printf-style formatting into a caller buffer (plans/cx-layers.md,
   plans/cx-l0-fmt-2026-10-30.md).  The one file in cx/text/ that calls the prelude's
   vsnprintf; text.cx stays libc-free.  No #include: <stdio.h> and <stdarg.h> come
   with the implicit prelude.
   Semantics are exactly the prelude's snprintf/vsnprintf (C99 7.19.6.5): the output
   is truncated to CAP-1 bytes and NUL-terminated when CAP > 0; DST may be 0 when CAP
   is 0 (measure only); the return is the length the whole output would have had, or
   a negative value on an encoding error.  cx_fmt differs (it clears DST on overflow),
   so it is not a drop-in for snprintf; these are. */

/* vsnprintf(DST, CAP, FMT, AP). */
int tx_vsnprintf(char *dst, size_t cap, const char *fmt, va_list ap) {
    return vsnprintf(dst, cap, fmt, ap);
}

/* snprintf(DST, CAP, FMT, ...). */
int tx_snprintf(char *dst, size_t cap, const char *fmt, ...) {
    va_list ap;
    int n;
    va_start(ap, fmt);
    n = vsnprintf(dst, cap, fmt, ap);
    va_end(ap);
    return n;
}

/* Negative-code formatting (CXS-C3 S4).  Success returns the bytes written, NUL not
   counted.  -EINVAL: FMT null, or DST null with CAP > 0.  -EMSGSIZE: the whole output
   needs more than CAP-1 bytes (DST, when CAP > 0, still holds the truncated NUL-ended
   prefix).  -EILSEQ: encoding error (the prelude returned a negative value). */
int tx_vfmt(char *dst, size_t cap, const char *fmt, va_list ap) {
    int n;
    if (!fmt || (!dst && cap > 0)) return -EINVAL;
    n = vsnprintf(dst, cap, fmt, ap);
    if (n < 0) return -EILSEQ;
    if ((size_t)n >= cap && !(cap == 0 && n == 0)) return -EMSGSIZE;
    return n;
}

int tx_fmt(char *dst, size_t cap, const char *fmt, ...) {
    va_list ap;
    int n;
    va_start(ap, fmt);
    n = tx_vfmt(dst, cap, fmt, ap);
    va_end(ap);
    return n;
}
