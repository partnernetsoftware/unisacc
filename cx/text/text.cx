#pragma unisa module text
/* L0 text: byte-string operations with explicit lengths (plans/cx-layers.md).
   No libc call; every function reads at most the lengths it is given.
   A "z-string" argument is a NUL-terminated array the caller owns; functions that take one
   also take its capacity, so a missing terminator is reported (-1) instead of overrun. */

/* Length of the z-string s within cap bytes, or -1 when no NUL occurs in s[0..cap). */
long tx_len(const char *s, long cap) {
    long i;
    if (!s || cap < 0) return -1;
    for (i = 0; i < cap; i++) if (!s[i]) return i;
    return -1;
}

/* 1 when the byte spans a[0..an) and b[0..bn) are equal, else 0. */
int tx_same(const char *a, long an, const char *b, long bn) {
    long i;
    if (!a || !b || an < 0 || bn < 0 || an != bn) return 0;
    for (i = 0; i < an; i++) if (a[i] != b[i]) return 0;
    return 1;
}

/* 1 when z-strings a and b (each within cap bytes) are equal; 0 when unequal or unterminated. */
int tx_eq(const char *a, const char *b, long cap) {
    long an = tx_len(a, cap), bn = tx_len(b, cap);
    if (an < 0 || bn < 0) return 0;
    return tx_same(a, an, b, bn);
}

/* The trusted ceiling for a z-string compared without a caller cap.  A command-line
   token, option name, or file name longer than this never matches; the ceiling is
   the bound check-driver-cli already passes to tx_eq.  See tx_eqz / tx_prefixz. */
enum { TX_ZCAP = 1 << 20 };

/* 1 when z-strings a and b are equal, each read at most TX_ZCAP bytes; 0 when
   unequal or unterminated.  The bounded form of strcmp(a,b)==0. */
int tx_eqz(const char *a, const char *b) {
    return tx_eq(a, b, TX_ZCAP);
}

/* 1 when a[0..n) equals the first n bytes of lit (a bounded prefix match, the
   bounded form of strncmp(a,lit,n)==0).  n must be 0..TX_ZCAP. */
int tx_prefixz(const char *a, const char *lit, long n) {
    if (!a || !lit || n < 0 || n > TX_ZCAP) return 0;
    return tx_prefix(a, n, lit, n);
}

/* 1 when the span s[0..n) starts with the span p[0..pn). */
int tx_prefix(const char *s, long n, const char *p, long pn) {
    if (!s || !p || n < 0 || pn < 0 || pn > n) return 0;
    return tx_same(s, pn, p, pn);
}

/* Offset of the first byte c in s[0..n), or -1. */
long tx_chr(const char *s, long n, int c) {
    long i;
    if (!s || n < 0) return -1;
    for (i = 0; i < n; i++) if ((unsigned char)s[i] == (unsigned char)c) return i;
    return -1;
}

/* Offset of the last byte c in s[0..n), or -1. */
long tx_rchr(const char *s, long n, int c) {
    long i;
    if (!s || n < 0) return -1;
    for (i = n - 1; i >= 0; i--) if ((unsigned char)s[i] == (unsigned char)c) return i;
    return -1;
}

/* Order of the spans a[0..an) and b[0..bn) as unsigned bytes, the shorter first on a common prefix:
   <0, 0 or >0 (strcmp's order for terminated strings passed with their lengths). */
int tx_cmp(const char *a, long an, const char *b, long bn) {
    long i, m = an < bn ? an : bn;
    if (!a || !b || an < 0 || bn < 0) return 0;
    for (i = 0; i < m; i++)
        if (a[i] != b[i]) return (int)(unsigned char)a[i] - (int)(unsigned char)b[i];
    return an < bn ? -1 : an > bn ? 1 : 0;
}

/* Offset of the first occurrence of p[0..pn) in s[0..n), or -1 (an empty p is found at 0). */
long tx_find(const char *s, long n, const char *p, long pn) {
    long i;
    if (!s || !p || n < 0 || pn < 0 || pn > n) return -1;
    for (i = 0; i + pn <= n; i++) if (tx_same(s + i, pn, p, pn)) return i;
    return -1;
}

/* Copies src[0..n) to dst and terminates it; returns 0, or 1 when n + 1 > cap (dst untouched). */
int tx_copy(char *dst, long cap, const char *src, long n) {
    long i;
    if (!dst || !src || n < 0 || cap < 1 || n + 1 > cap) return 1;
    for (i = 0; i < n; i++) dst[i] = src[i];
    dst[n] = 0;
    return 0;
}

/* Count the fields of the span s[0..n) split at every byte c: n + 1 is the
   count of c in the span (an empty span has 0 fields).  This is the length of
   Node's String.prototype.split, and Rust's str::split(...).count(). */
long tx_fields(const char *s, long n, int c) {
    long i, k = 0;
    if (!s || n < 0) return -1;
    for (i = 0; i < n; i++) if ((unsigned char)s[i] == (unsigned char)c) k++;
    return n > 0 ? k + 1 : 0;
}

/* The IDX-th field (0-based) of s[0..n) split at c, into *OFF and *LEN.  A
   field may be empty (LEN 0).  Returns 0, or -1 when IDX is out of range or an
   argument is invalid.  The field is borrowed from s; it is not copied. */
int tx_field(const char *s, long n, int c, long idx, long *off, long *len) {
    long i, k = 0, b;
    if (!s || n < 0 || idx < 0 || !off || !len) return -1;
    b = 0;
    for (i = 0; i <= n; i++) {
        if (i == n || (unsigned char)s[i] == (unsigned char)c) {
            if (k == idx) { *off = b; *len = i - b; return 0; }
            k++;
            b = i + 1;
        }
    }
    return -1;
}
