#pragma unisa module edit
#pragma unisa dock
/* L0 text/edit: replace, ASCII case mapping and ASCII case-insensitive equality over
   explicit-length spans (Rust str::replace / make_ascii_lowercase / eq_ignore_ascii_case).
   Only bytes 'A'..'Z' / 'a'..'z' are mapped; locale and non-ASCII bytes are untouched.
   Failure contract: negative codes only.  No libc call. */

static int ed_lc(int c) { return (c >= 'A' && c <= 'Z') ? c + 32 : c; }

/* Replace every non-overlapping occurrence (left to right) of FROM[0..FN) in S[0..N) with
   TO[0..TN), writing to DST (not NUL-terminated).  Returns the byte length written (the needed
   length), -EINVAL for null spans, negative lengths, an empty FROM, or DST overlapping S,
   -ERANGE when the result does not fit CAP (DST is not touched). */
long tx_replace(char *dst, long cap, const char *s, long n, const char *from, long fn, const char *to, long tn) {
    long i, k, need = 0, o = 0;
    if (n < 0 || cap < 0 || fn <= 0 || tn < 0 || !s || !from || (tn > 0 && !to)) return -EINVAL;
    if (n > 0 && dst && dst + cap > s && s + n > dst && cap > 0) return -EINVAL;
    for (i = 0; i < n; ) {
        if (i + fn <= n) {
            for (k = 0; k < fn; k++) if (s[i + k] != from[k]) break;
            if (k == fn) { need += tn; i += fn; continue; }
        }
        need++; i++;
    }
    if (need > cap) return -ERANGE;
    if (need > 0 && !dst) return -EINVAL;
    for (i = 0; i < n; ) {
        if (i + fn <= n) {
            for (k = 0; k < fn; k++) if (s[i + k] != from[k]) break;
            if (k == fn) { for (k = 0; k < tn; k++) dst[o++] = to[k]; i += fn; continue; }
        }
        dst[o++] = s[i++];
    }
    return o;
}

/* Lowercase ASCII letters of S[0..N) in place.  Returns the number of bytes changed (>= 0),
   or -EINVAL for a null S with N > 0 or N < 0. */
int tx_lower(char *s, long n) {
    long i; int c = 0;
    if (n < 0 || (!s && n > 0)) return -EINVAL;
    for (i = 0; i < n; i++) if (s[i] >= 'A' && s[i] <= 'Z') { s[i] += 32; c++; }
    return c;
}

/* Uppercase ASCII letters of S[0..N) in place; return as tx_lower. */
int tx_upper(char *s, long n) {
    long i; int c = 0;
    if (n < 0 || (!s && n > 0)) return -EINVAL;
    for (i = 0; i < n; i++) if (s[i] >= 'a' && s[i] <= 'z') { s[i] -= 32; c++; }
    return c;
}

/* 1 when A[0..AN) and B[0..BN) are equal ignoring ASCII case, else 0 (different lengths,
   negative lengths, or a null span with a positive length are 0). */
int tx_ieq(const char *a, long an, const char *b, long bn) {
    long i;
    if (an < 0 || bn < 0 || an != bn) return 0;
    if (an > 0 && (!a || !b)) return 0;
    for (i = 0; i < an; i++) if (ed_lc((unsigned char)a[i]) != ed_lc((unsigned char)b[i])) return 0;
    return 1;
}
