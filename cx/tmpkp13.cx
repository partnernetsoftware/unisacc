#pragma unisa use text.fmt
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use sys.time
int main(void){
 char *w[]={"./out/cx-host-run-8922-0/gcc_cx_cx","-run","./out/cx-host-run-8922-0/barrier.cx","--","/tmp/rr1","/tmp/gg1","2000",0};
 int o=-1,e=-1;
 int p=sy_spawn_pipe(w,0,8,&o,&e);
 long pg=sy_getpgid(p);
 sy_sleep_ms(2900);
 sy_killpg((int)pg,15);
 int ex=0,cd=0,sg=0,w2=0;
 for(int i=0;i<150;i++){ w2=(int)sy_wait_status(p,1,&ex,&cd,&sg); if(w2>0)break; sy_sleep_ms(20);}
 sy_killpg((int)pg,9);
 sy_sleep_ms(300);
 char *sc[]={"sh","-c","ps -eo pid,ppid,pgid,stat,comm --no-headers > /tmp/psdump.txt; echo $? > /tmp/psdump.rc",0};
 sy_run(sc,0,0,0);
 sy_printf("me=%d pg=%ld g=%d w=%d\n", (int)sy_pid(), pg, sy_killpg((int)pg,0), w2);
 return 0;}
