#pragma unisa module levelname
/* Generated by tools/level-gen.cx from exec/c/compiler-routes.tsv.
   Do not edit by hand. Names are the first-seen suffix text after '/'.
   The optimiser column stays on optname. O0 there is none.
   A null out-pointer returns 4. An index outside 0..count-1 returns 2.
   No libc and no include. */
int rlv_count(void) {
    return 3;
}
int rlv_at(int index, const char **name) {
