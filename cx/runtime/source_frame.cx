    else if (kind == 1) msg = "INTERFACE_ERROR capture-staging-create";
    else if (kind == 4) msg = "INTERFACE_ERROR capture-staging-cleanup";
    else if (kind == 5) msg = "INTERFACE_ERROR capture-ledger-open";
    else if (kind == 6) msg = "INTERFACE_ERROR capture-ledger-not-empty-regular";
    else if (kind == 7) msg = "INTERFACE_ERROR capture-ledger-write";
    else if (kind == 8) msg = "INTERFACE_ERROR capture-ledger-close";
    else if (kind == 2 || kind == 3) {
        if (!name) return 1;
