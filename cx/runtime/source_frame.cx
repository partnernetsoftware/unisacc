    memcpy(dst, head, hn);
    at = (int)hn;
    if (xn) { memcpy(dst + at, hex, xn); at += (int)xn; }
    memcpy(dst + at, " event=", 7);
    at += 7;
    for (i = nd - 1; i >= 0; i--) dst[at++] = num[i];
    dst[at] = 0;
    return 0;
}
int cxsf_fetch_row(const unsigned char *key, int kn,
                   const unsigned char *name, int nn,
                   const unsigned char *data, int len,
                   unsigned char **bytes, int *out_len) {
    if (!bytes || !out_len) return 4;
    if (kn < 0 || nn < 0 || kn != nn) return 0;
    if (kn > 0) {
        if (!key) return 4;
        if (!name || memcmp(key, name, (size_t)kn) != 0) return 0;
    }
    *bytes = (unsigned char *)data;
    *out_len = len;
    return 1;
}
int cxsf_fetch_path(char *dst, int cap, const unsigned char *p, int n, const char *incdir) {
    const unsigned char *s;
    int sn, i, name_n;
    size_t dn, need;
    if (!dst || cap < 1 || n < 0 || (n > 0 && !p)) return 4;
    s = p;
    sn = n;
    if (sn >= 7 && (!memcmp(s, "\0inc/q/", 7) || !memcmp(s, "\0inc/a/", 7))) {
        s += 7;
        sn -= 7;
    }
    if (!(sn >= 5 && !memcmp(s, "\0hdr/", 5))) {
        for (i = 0; i < sn; i++) if (s[i] == 0) return 2;
        need = (size_t)sn;
        if (need > 2147483646u || need + 1 > (size_t)cap) return 2;
        if (sn) memcpy(dst, s, need);
        dst[sn] = 0;
        return 0;
    }
    if (!incdir) return 1;
    dn = strlen(incdir);
    name_n = sn - 5;
    for (i = 0; i < name_n; i++) if (s[5 + i] == 0) return 2;
    if (dn > 2147483646u) return 2;
    need = dn + 1u + (size_t)name_n;
    if (need > 2147483646u || need + 1 > (size_t)cap) return 2;
    if (dn) memcpy(dst, incdir, dn);
    dst[dn] = '/';
    if (name_n) memcpy(dst + dn + 1, s + 5, (size_t)name_n);
    dst[need] = 0;
    return 0;
}
int cxsf_fetch_file(const void *bytes, const char *path,
                    void (*readfn)(const char *), void (*absentfn)(const char *)) {
    if (!path || !readfn || !absentfn) return 4;
    if (bytes) {
        readfn(path);
        return 2;
    }
    absentfn(path);
    return 0;
}
int cxsf_file_keep(int record, char **mine, int mine_n, char **other, int other_n,
                   const char *path, void *(*alloc)(void *, size_t),
                   char ***out_list, int *out_n) {
    int i;
    size_t pn;
    char **list;
    char *copy;
    if (!record) return 0;
    if (!path || !alloc || !out_list || !out_n) return 4;
    if (mine_n < 0 || other_n < 0 || (mine_n > 0 && !mine) || (other_n > 0 && !other)) return 4;
    for (i = 0; i < mine_n; i++) {
        if (!mine[i]) return 4;
        if (strcmp(mine[i], path) == 0) return 1;
    }
    for (i = 0; i < other_n; i++) {
        if (!other[i]) return 4;
        if (strcmp(other[i], path) == 0) return 1;
    }
    list = alloc(mine, ((size_t)mine_n + 1u) * sizeof(char *));
    if (!list) return 3;
    pn = strlen(path) + 1u;
    copy = alloc(0, pn);
    if (!copy) {
        *out_list = list;
        *out_n = mine_n;
        return 3;
    }
    memcpy(copy, path, pn);
    list[mine_n] = copy;
    *out_list = list;
    *out_n = mine_n + 1;
    return 2;
}
int cxsf_close_fail(long, void (*)(const char *));
int cxsf_readfile(const char *path, int *len, int optional, int windows, long enoent,
                  char *line, int line_cap,
                  long (*openfn)(const char *),
                  const char *(*reasonfn)(long),
                  void (*say)(const char *),
                  void (*raw)(const char *, const char *),
                  void (*failfn)(const char *),
                  unsigned char *(*streamfn)(long, const char *, int *),
                  long (*closefn)(long),
                  unsigned char **out) {
    long fd;
    int gate;
    const char *reason;
    unsigned char *b;
    if (!path || !len || !out || !openfn || !reasonfn || !say || !raw || !failfn || !streamfn || !closefn)
        return 4;
    fd = openfn(path);
    gate = cxsf_open_gate(fd, optional, windows, enoent);
    if (gate == 1) {
        *out = 0;
        return 1;
    }
    if (gate) {
        reason = reasonfn(fd);
        if (!line || line_cap < 1 || cxsf_open_line(line, line_cap, path, reason)) raw(path, reason);
        else say(line);
        failfn("cannot open input");
        return 2;
    }
    b = streamfn(fd, path, len);
    if (cxsf_close_fail(closefn(fd), failfn)) return 3;
    *out = b;
    return 0;
}
int cxsf_read_err(char *dst, int cap, const char *path) {
    const char *head = "run: cannot read ";
    size_t hn, pn, need;
    if (!dst || !path || cap < 1) return 1;
    hn = strlen(head);
    pn = strlen(path);
    need = hn + pn + 1u;
    if (pn > 2147483646u || need > 2147483646u || need + 1u > (size_t)cap) return 1;
    memcpy(dst, head, hn);
    if (pn) memcpy(dst + hn, path, pn);
    dst[hn + pn] = '\n';
    dst[need] = 0;
    return 0;
}
int cxsf_readstream(long fd, const char *path, int *len, char *line, int line_cap,
                    int (*stamp)(long, long long *, long long *),
                    void *(*grow)(void *, size_t),
                    long (*readfn)(long, unsigned char *, long),
                    void (*say)(const char *),
                    void (*raw)(const char *),
                    void (*failfn)(const char *),
                    unsigned char **own, unsigned char **out) {
    int n, cap, stamped;
    long long size, off;
    unsigned char *b;
    if (!path || !len || !own || !out || !stamp || !grow || !readfn || !say || !raw || !failfn)
        return 4;
    size = 0;
    off = 0;
    stamped = stamp(fd, &size, &off);
    cap = cxsf_read_cap(stamped, stamped ? size : 0, stamped ? off : 0);
    b = grow(0, (size_t)cap);
    *own = b;
    if (!b) return 3;
    n = 0;
    for (;;) {
        long r;
        int nn, took, next;
        if (n == cap) {
            next = cap;
            if (cxsf_read_grow(cap, &next)) {
                failfn("file too large");
                return 2;
            }
            cap = next;
            b = grow(b, (size_t)cap);
            *own = b;
            if (!b) return 3;
        }
        r = readfn(fd, b + n, (long)(cap - n));
        nn = n;
        took = cxsf_read_take(r, cap, n, &nn);
        if (took == 1) {
            if (!line || line_cap < 1 || cxsf_read_err(line, line_cap, path)) raw(path);
            else say(line);
            failfn("cannot read input");
            return 1;
        }
        if (took == 2) break;
        if (took) {
            failfn("invalid read length");
            return 5;
        }
        n = nn;
    }
    *len = n;
    *out = b;
    return 0;
}
int cxsf_stamp_reg(int stat_ok, int is_reg,
                   long long size, long long mtime, long long mtime_ns,
                   long long ctime, long long ctime_ns, long long ino, long long dev,
                   long long *out_size, long long *out_off,
                   long long *out_mtime, long long *out_mtime_ns,
                   long long *out_ctime, long long *out_ctime_ns,
                   long long *out_ino, long long *out_dev,
                   unsigned *out_tag, int *out_valid) {
    if (!out_size || !out_off || !out_mtime || !out_mtime_ns || !out_ctime || !out_ctime_ns
        || !out_ino || !out_dev || !out_tag || !out_valid)
        return 4;
    if (!stat_ok || !is_reg) return 0;
    *out_size = size;
    *out_off = 0;
    *out_mtime = mtime;
    *out_mtime_ns = mtime_ns;
    *out_ctime = ctime;
    *out_ctime_ns = ctime_ns;
    *out_ino = ino;
    *out_dev = dev;
    *out_tag = 0;
    *out_valid = 1;
    return 1;
}
long cxsf_read_errno(long r, long err) {
    if (r < 0) return -err;
    return r;
}
long cxsf_open_errno(long fd, long err) {
    if (fd < 0) return -err;
    return fd;
}
int cxsf_open_flags(int base, int binary, int windows) {
    if (windows) return base | binary;
    return base;
}
static int cxsf_stamp_window(long fd, long at, unsigned *h,
                             long (*seekfn)(long, long, int),
                             long (*readfn)(long, unsigned char *, long)) {
    unsigned char b[4096];
    long n, r, i;
    if (seekfn(fd, at, 0) < 0) return 0;
    n = 0;
    while (n < 4096) {
        r = readfn(fd, b + n, 4096 - n);
        if (r < 0 || r > 4096 - n) return 0;
        if (!r) break;
        n += r;
    }
    for (i = 0; i < n; i++) *h = (*h ^ b[i]) * 16777619u;
    return 1;
}
int cxsf_stamp_unisa(long fd,
                     long (*seekfn)(long, long, int),
                     long (*readfn)(long, unsigned char *, long),
                     void (*failfn)(const char *),
                     long long *out_size, long long *out_off,
                     unsigned *out_tag, int *out_valid) {
    long cur, end;
    unsigned h;
    int ok;
    if (!seekfn || !readfn || !failfn || !out_size || !out_off || !out_tag || !out_valid)
        return 4;
    cur = seekfn(fd, 0, 1);
    if (cur < 0) return 0;
    end = seekfn(fd, 0, 2);
    if (end < 0) return 0;
    h = 2166136261u;
    ok = cxsf_stamp_window(fd, 0, &h, seekfn, readfn);
    if (ok && end > 4096) ok = cxsf_stamp_window(fd, end - 4096, &h, seekfn, readfn);
    if (seekfn(fd, cur, 0) < 0) {
        failfn("cannot read input");
        return 2;
    }
    if (!ok) return 0;
    *out_size = end;
    *out_off = cur;
    *out_tag = h;
    *out_valid = 1;
    return 1;
}
long cxsf_close_rc(long r, long err) {
    (void)err;
    return r;
}
int cxsf_close_fail(long rc, void (*failfn)(const char *)) {
    if (!failfn) return 4;
    if (rc < 0) {
        failfn("close failed");
        return 1;
    }
    return 0;
}
