    dn = strlen(dir);
    nn = strlen(name);
    if (dn > 2147483647u || nn > 2147483647u) return 1;
    need = dn + 1 + nn;
    if (need > 2147483646u || need + 1 > (size_t)cap) return 1;
    memcpy(dst, dir, dn);
    dst[dn] = '/';
    if (nn) memcpy(dst + dn + 1, name, nn);
    dst[need] = 0;
    return 0;
}
