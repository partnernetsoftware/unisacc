#pragma unisa module source_frame
/* A source identity frame contains, in source order, little-endian u32
 * name length, name bytes, u32 source length, and source bytes. Inputs are
 * borrowed. The caller owns the returned block and supplies its allocator.
 * Failure leaves both outputs untouched and performs no allocation when
 * an argument or the total size is invalid. */
int cxsf_encode(int count, const char **names, const unsigned char **bytes,
                const int *lengths, unsigned char **out, int *out_n,
                void *(*alloc)(void *, size_t)) {
    size_t total = 0;
    if (count < 0 || !out || !out_n || !alloc ||
        (count && (!names || !bytes || !lengths))) return 1;
    for (int i = 0; i < count; i++) {
        if (!names[i] || lengths[i] < 0 || (lengths[i] && !bytes[i])) return 1;
        size_t name_n = strlen(names[i]);
        if (name_n > 2147483647u || total > 2147483647u - name_n) return 2;
        total += name_n;
        if (total > 2147483647u - 8u || (size_t)lengths[i] > 2147483647u - total - 8u) return 2;
        total += 8u + (size_t)lengths[i];
    }
    unsigned char *block = alloc(0, total ? total : 1);
    if (!block) return 3;
    unsigned char *p = block;
    for (int i = 0; i < count; i++) {
        size_t name_n = strlen(names[i]);
        for (int j = 0; j < 4; j++) *p++ = (unsigned char)(name_n >> (8 * j));
        if (name_n) memcpy(p, names[i], name_n);
        p += name_n;
        for (int j = 0; j < 4; j++) *p++ = (unsigned char)((unsigned)lengths[i] >> (8 * j));
        if (lengths[i]) memcpy(p, bytes[i], (size_t)lengths[i]);
        p += lengths[i];
    }
    *out = block;
    *out_n = (int)total;
    return 0;
}

/* E3 identity is a pair of arbitrary byte spans, including embedded NULs. */
int cxsf_pair(const unsigned char *first, int first_n,
              const unsigned char *second, int second_n,
              unsigned char **out, int *out_n,
              void *(*alloc)(void *, size_t)) {
    if (first_n < 0 || second_n < 0 || (first_n && !first) ||
        (second_n && !second) || !out || !out_n || !alloc) return 1;
    if ((size_t)first_n > 2147483647u - 8u ||
        (size_t)second_n > 2147483647u - 8u - (size_t)first_n) return 2;
    size_t total = 8u + (size_t)first_n + (size_t)second_n;
    unsigned char *block = alloc(0, total);
    if (!block) return 3;
    for (int j = 0; j < 4; j++) block[j] = (unsigned char)((unsigned)first_n >> (8 * j));
    if (first_n) memcpy(block + 4, first, (size_t)first_n);
    for (int j = 0; j < 4; j++) block[4 + first_n + j] = (unsigned char)((unsigned)second_n >> (8 * j));
    if (second_n) memcpy(block + 8 + first_n, second, (size_t)second_n);
    *out = block;
    *out_n = (int)total;
    return 0;
}

/* Parse the entire SC2 E3 companion. Outputs are committed only on success. */
int cxsf_companion(const unsigned char *b, int n, char *stage, size_t cap, char *hex) {
    const char prefix[] = "#SC2\tstage=";
    const char field[] = "input_sha256=";
    if (!b || !stage || !hex || n < 20 || n > 512 || b[n-1] != '\n') return 0;
    for (int i=0; i<n-1; i++) if (!b[i] || b[i]=='\n') return 0;
    if (n < 11 || memcmp(b,prefix,11)) return 0;
    int end=11;
    while (end<n-1 && b[end]!='\t') end++;
    size_t sn=(size_t)(end-11);
    if (end==n-1 || !sn || sn>=cap || n-end-1 != 13+64+1 || memcmp(b+end+1,field,13)) return 0;
    const unsigned char *hash=b+end+14;
    for (int i=0; i<64; i++) if (!((hash[i]>='0' && hash[i]<='9') || (hash[i]>='a' && hash[i]<='f'))) return 0;
    memcpy(stage,b+11,sn); stage[sn]=0;
    memcpy(hex,hash,64); hex[64]=0;
    return 1;
}
