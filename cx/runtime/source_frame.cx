    neg = pid < 0;
    u = neg ? (unsigned long)(-(pid + 1)) + 1ul : (unsigned long)pid;
    n = 0;
    do { rev[n++] = (char)('0' + (int)(u % 10ul)); u /= 10ul; } while (u && n < 31);
    dn = strlen(dir);
