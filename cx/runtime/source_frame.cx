#pragma unisa module source_frame
/* A source identity frame contains, in source order, little-endian u32
 * name length, name bytes, u32 source length, and source bytes. Inputs are
 * borrowed. The caller owns the returned block and supplies its allocator.
 * Failure leaves both outputs untouched and performs no allocation when
 * an argument or the total size is invalid. */
int cxsf_encode(int count, const char **names, const unsigned char **bytes,
                const int *lengths, unsigned char **out, int *out_n,
                void *(*alloc)(void *, size_t)) {
    size_t total = 0;
    if (count < 0 || !out || !out_n || !alloc ||
        (count && (!names || !bytes || !lengths))) return 1;
    for (int i = 0; i < count; i++) {
        if (!names[i] || lengths[i] < 0 || (lengths[i] && !bytes[i])) return 1;
        size_t name_n = strlen(names[i]);
        if (name_n > 2147483647u || total > 2147483647u - name_n) return 2;
        total += name_n;
        if (total > 2147483647u - 8u || (size_t)lengths[i] > 2147483647u - total - 8u) return 2;
        total += 8u + (size_t)lengths[i];
    }
    unsigned char *block = alloc(0, total ? total : 1);
    if (!block) return 3;
    unsigned char *p = block;
    for (int i = 0; i < count; i++) {
        size_t name_n = strlen(names[i]);
        for (int j = 0; j < 4; j++) *p++ = (unsigned char)(name_n >> (8 * j));
        if (name_n) memcpy(p, names[i], name_n);
        p += name_n;
        for (int j = 0; j < 4; j++) *p++ = (unsigned char)((unsigned)lengths[i] >> (8 * j));
        if (lengths[i]) memcpy(p, bytes[i], (size_t)lengths[i]);
        p += lengths[i];
    }
    *out = block;
    *out_n = (int)total;
    return 0;
}

/* E3 identity is a pair of arbitrary byte spans, including embedded NULs. */
int cxsf_pair(const unsigned char *first, int first_n,
              const unsigned char *second, int second_n,
              unsigned char **out, int *out_n,
              void *(*alloc)(void *, size_t)) {
    if (first_n < 0 || second_n < 0 || (first_n && !first) ||
        (second_n && !second) || !out || !out_n || !alloc) return 1;
    if ((size_t)first_n > 2147483647u - 8u ||
        (size_t)second_n > 2147483647u - 8u - (size_t)first_n) return 2;
    size_t total = 8u + (size_t)first_n + (size_t)second_n;
    unsigned char *block = alloc(0, total);
    if (!block) return 3;
    for (int j = 0; j < 4; j++) block[j] = (unsigned char)((unsigned)first_n >> (8 * j));
    if (first_n) memcpy(block + 4, first, (size_t)first_n);
    for (int j = 0; j < 4; j++) block[4 + first_n + j] = (unsigned char)((unsigned)second_n >> (8 * j));
    if (second_n) memcpy(block + 8 + first_n, second, (size_t)second_n);
    *out = block;
    *out_n = (int)total;
    return 0;
}

/* Parse the entire SC2 E3 companion. Outputs are committed only on success. */
int cxsf_companion(const unsigned char *b, int n, char *stage, size_t cap, char *hex) {
    const char prefix[] = "#SC2\tstage=";
    const char field[] = "input_sha256=";
    if (!b || !stage || !hex || n < 20 || n > 512 || b[n-1] != '\n') return 0;
    for (int i=0; i<n-1; i++) if (!b[i] || b[i]=='\n') return 0;
    if (n < 11 || memcmp(b,prefix,11)) return 0;
    int end=11;
    while (end<n-1 && b[end]!='\t') end++;
    size_t sn=(size_t)(end-11);
    if (end==n-1 || !sn || sn>=cap || n-end-1 != 13+64+1 || memcmp(b+end+1,field,13)) return 0;
    const unsigned char *hash=b+end+14;
    for (int i=0; i<64; i++) if (!((hash[i]>='0' && hash[i]<='9') || (hash[i]>='a' && hash[i]<='f'))) return 0;
    memcpy(stage,b+11,sn); stage[sn]=0;
    memcpy(hex,hash,64); hex[64]=0;
    return 1;
}

/* Resource ledger numbers accept canonical unsigned decimal up to INT32_MAX. */
int cxsf_hex_digit(int c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    return -1;
}
int cxsf_length(const char *s, int *out) {
    if (!s || !out || !*s || (*s == '0' && s[1])) return 0;
    long long v=0;
    for (const char *p=s; *p; p++) {
        if (*p<'0' || *p>'9') return 0;
        v=v*10+(*p-'0');
        if (v>2147483647LL) return 0;
    }
    *out=(int)v;
    return 1;
}

/* Parse an SC1/SC2 header after its five-byte prefix has been checked. */
int cxsf_ledger_identity(const char *line, char *stage, size_t cap, char *hex) {
    if (!line || !stage || !hex || strlen(line)<5) return 0;
    const char *s=line+5, *t=strchr(s,'\t');
    if (!t || strncmp(s,"stage=",6)) return 0;
    size_t sn=(size_t)(t-(s+6));
    if (!sn || sn>=cap) return 0;
    const char *v=t+1;
    if (strncmp(v,"input_sha256=",13) || strlen(v+13)!=64) return 0;
    v+=13;
    for(int i=0;i<64;i++) if (cxsf_hex_digit((unsigned char)v[i])<0) return 0;
    memcpy(stage,s+6,sn);stage[sn]=0;
    memcpy(hex,v,64);hex[64]=0;
    return 1;
}

/* Five TAB-separated ledger fields, each including its terminator in 4096
 * bytes. The caller owns the 5*4096-byte output and must ignore it on error. */
int cxsf_ledger_fields(const char *line, char *fields) {
    if (!line || !fields) return -1;
    const char *p=line;
    for(int k=0;k<5;k++) {
        const char *t=strchr(p,'\t');
        if(k<4 && !t) return -1;
        if(k==4 && t) return -2;
        size_t width=t?(size_t)(t-p):strlen(p);
        if(width>=4096) return -3;
        memcpy(fields+k*4096,p,width);
        fields[k*4096+width]=0;
        p=t?t+1:p+width;
    }
    return 5;
}

/* Borrow a complete LF-terminated row; never advance or publish a span on
 * rejection. A NUL is checked only after the terminating LF is found. */
int cxsf_ledger_line(const unsigned char *bytes,size_t length,size_t *cursor,
                     size_t *start,size_t *row_length) {
    if (!cursor || !start || !row_length || *cursor>length || (length && !bytes)) return 4;
    if (*cursor==length) return 0;
    size_t e=*cursor;
    while(e<length && bytes[e]!='\n') e++;
    if(e==length) return 2;
    if(memchr(bytes+*cursor,0,e-*cursor)) return 3;
    *start=*cursor;*row_length=e-*cursor;*cursor=e+1;
    return 1;
}

/* Decode a nonempty lowercase hexadecimal key into caller-owned bytes.
 * On malformed input the caller discards the output, which may be partial. */
int cxsf_ledger_key(const char *key, size_t length, unsigned char *out) {
    if (!key || !out || !length || length%2) return 0;
    for(size_t q=0;q<length;q+=2) {
        int hi=cxsf_hex_digit((unsigned char)key[q]);
        int lo=cxsf_hex_digit((unsigned char)key[q+1]);
        if(hi<0 || lo<0) return 0;
        out[q/2]=(unsigned char)(hi*16+lo);
    }
    return 1;
}

/* Validate row metadata before the caller reads any blob. Error codes follow
 * the existing ledger diagnostic order; outputs are committed on success. */
int cxsf_ledger_metadata(const char *presence,const char *blob,const char *length,
                         const char *digest,int *present,int *size) {
    if (!presence || !blob || !length || !digest || !present || !size) return 1;
    int p, n;
    if (!strcmp(presence,"0")) p=0;
    else if (!strcmp(presence,"1")) p=1;
    else return 1;
    if (!cxsf_length(length,&n)) return 2;
    if (!p) {
        if (strcmp(blob,"-") || n!=0 || strcmp(digest,"-")) return 3;
    } else if (!strcmp(blob,"-") || strchr(blob,'/') || !strcmp(blob,"..") ||
               strlen(blob)>=64 || strlen(digest)!=64) return 4;
    *present=p; *size=n;
    return 0;
}

/* Rows and keys are borrowed. A successful ordered lookup alone advances the
 * caller-owned cursor. An absent row remains an ordinary matched row. */
typedef struct {
    unsigned char *key; int kn; int present; unsigned char *value; int vn; char blob[64];
} CxLedgerRow;
typedef struct {
    CxLedgerRow *rows; int n; int has_id; int trace, cursor; char stage[128]; char input_hex[65];
} CxLedger;
/* Takes key ownership only after a row is committed. 0 success, 1 duplicate,
 * 2 allocation failure, 3 invalid size. Caller releases key on failure. */
int cxsf_ledger_add(void *ledger,int *cap,unsigned char *key,int kn,
                    void *(*alloc)(void *,size_t)) {
    if(!ledger||!cap||!key||kn<=0||!alloc)return 3;
    CxLedger l;memcpy(&l,ledger,sizeof l);
    if(l.n<0||*cap<0||l.n>*cap||(l.n&&!l.rows))return 3;
    if(!l.trace)for(int i=0;i<l.n;i++){CxLedgerRow row;memcpy(&row,(unsigned char *)l.rows+(size_t)i*sizeof row,sizeof row);
        if(row.kn==kn&&!memcmp(row.key,key,(size_t)kn))return 1;}
    if(l.n==*cap){
        if(*cap>2147483647/2)return 3;
        int next=*cap?*cap*2:16;
        if((size_t)next>(size_t)-1/sizeof(CxLedgerRow))return 3;
        void *p=alloc(l.rows,(size_t)next*sizeof(CxLedgerRow));if(!p)return 2;
        l.rows=p;*cap=next;
    }
    CxLedgerRow row={0};row.key=key;row.kn=kn;
    memcpy((unsigned char *)l.rows+(size_t)l.n*sizeof row,&row,sizeof row);
    l.n++;memcpy(ledger,&l,sizeof l);return 0;
}
typedef struct {const char *name;const unsigned char *bytes;size_t n;} CxLedgerView;
/* Snapshot views are borrowed; successful copies belong to the caller.
 * 0 found, 1 missing, 2 allocation failure, 3 invalid or overflowing view. */
int cxsf_ledger_view_copy(const void *views,int count,const char *name,
                          unsigned char **out,size_t *length,
                          void *(*alloc)(void *,size_t)) {
    if (!views || count<0 || !name || !out || !length || !alloc) return 3;
    const unsigned char *p=(const unsigned char *)views;
    for(int i=0;i<count;i++) {
        CxLedgerView view;memcpy(&view,p+(size_t)i*sizeof view,sizeof view);
        if (!view.name) return 3;
        if (!strcmp(name,view.name)) {
            if (view.n==(size_t)-1 || (view.n && !view.bytes)) return 3;
            unsigned char *b=alloc(0,view.n+1);
            if (!b) return 2;
            if (view.n) memcpy(b,view.bytes,view.n);
            *out=b;*length=view.n;return 0;
        }
    }
    return 1;
}
/* IO and memory are caller supplied so descriptors, errno and allocations
 * remain in the runtime's own domain. No fd or buffer survives a failure. */
typedef struct {
    int (*open_file)(const char *); int (*stat_file)(int,long long *,int *);
    ssize_t (*read_file)(int,void *,size_t); int (*close_file)(int);
    void *(*alloc)(void *,size_t); void (*release)(void *);
    int (*get_error)(void); void (*set_error)(int);
} CxLedgerIO;
unsigned char *cxsf_ledger_readfile(const char *path,size_t *out_n,const void *callbacks) {
    CxLedgerIO io;if(!path||!out_n||!callbacks)return 0;memcpy(&io,callbacks,sizeof io);
    if(!io.open_file||!io.stat_file||!io.read_file||!io.close_file||!io.alloc||!io.release||!io.get_error||!io.set_error)return 0;
    io.set_error(0);int fd=io.open_file(path);if(fd<0)return 0;
    long long file_size;int kind,saved;
    if(io.stat_file(fd,&file_size,&kind)){saved=io.get_error();if(!saved)saved=EIO;io.close_file(fd);io.set_error(saved);return 0;}
    if(kind){saved=kind==1?EISDIR:EINVAL;io.close_file(fd);io.set_error(saved);return 0;}
    if(file_size<0 || file_size>2147483647LL){io.close_file(fd);io.set_error(EFBIG);return 0;}
    size_t size=(size_t)file_size,at=0;unsigned char *b=io.alloc(0,size+1);
    if(!b){io.close_file(fd);io.set_error(ENOMEM);return 0;}
    while(at<size){ssize_t z=io.read_file(fd,b+at,size-at);int e=io.get_error();
        if(z<0 && e==EINTR)continue;
        if(z<=0){saved=z<0&&e?e:EIO;io.close_file(fd);io.release(b);io.set_error(saved);return 0;}
        at+=(size_t)z;
    }
    for(;;){unsigned char extra;ssize_t z=io.read_file(fd,&extra,1);int e=io.get_error();
        if(z<0 && e==EINTR)continue;
        if(z!=0){saved=z<0&&e?e:EIO;io.close_file(fd);io.release(b);io.set_error(saved);return 0;}
        break;
    }
    if(io.close_file(fd)){saved=io.get_error();if(!saved)saved=EIO;io.release(b);io.set_error(saved);return 0;}
    *out_n=size;return b;
}
/* Windows ledger reading keeps its existing stdio seek/read semantics. */
typedef struct {
    void *(*open_file)(const char *); int (*seek_end)(void *); long long (*tell)(void *);
    int (*seek_start)(void *); size_t (*read_file)(void *,void *,size_t); int (*close_file)(void *);
    void *(*alloc)(void *,size_t); void (*release)(void *);
    int (*get_error)(void); void (*set_error)(int);
} CxLedgerStreamIO;
unsigned char *cxsf_ledger_readstream(const char *path,size_t *out_n,const void *callbacks) {
    CxLedgerStreamIO io;if(!path||!out_n||!callbacks)return 0;memcpy(&io,callbacks,sizeof io);
    if(!io.open_file||!io.seek_end||!io.tell||!io.seek_start||!io.read_file||!io.close_file||!io.alloc||!io.release||!io.get_error||!io.set_error)return 0;
    io.set_error(0);void *f=io.open_file(path);if(!f)return 0;
    long long size;int saved;
    if(io.seek_end(f)||(size=io.tell(f))<0||io.seek_start(f)){
        saved=io.get_error();if(!saved)saved=EIO;io.close_file(f);io.set_error(saved);return 0;
    }
    if(size>2147483647LL){io.close_file(f);io.set_error(EFBIG);return 0;}
    unsigned char *b=io.alloc(0,(size_t)size+1);
    if(!b){io.close_file(f);io.set_error(ENOMEM);return 0;}
    if(size && io.read_file(f,b,(size_t)size)!=(size_t)size){
        saved=io.get_error();if(!saved)saved=EIO;io.close_file(f);io.release(b);io.set_error(saved);return 0;
    }
    if(io.close_file(f)){saved=io.get_error();if(!saved)saved=EIO;io.release(b);io.set_error(saved);return 0;}
    *out_n=(size_t)size;return b;
}
/* The caller supplies the release function for the allocation domain that
 * produced every row. The ledger and its row metadata are copied as bytes. */
void cxsf_ledger_clear(void *ledger,void (*release)(void *)) {
    if (!ledger || !release) return;
    CxLedger local; memcpy(&local,ledger,sizeof local);
    for(int i=0;i<local.n;i++) { CxLedgerRow row;
        memcpy(&row,(unsigned char *)local.rows+(size_t)i*sizeof row,sizeof row);
        release(row.key);release(row.value);
    }
    release(local.rows);memset(ledger,0,sizeof local);
}
/* Verify the stage before hashing, preserving the existing diagnostic order.
 * The caller supplies the hash routine and retains all referenced storage. */
int cxsf_ledger_check_identity(const void *ledger,const char *stage,
                               const unsigned char *input,int input_n,
                               char *err,size_t err_n,
                               void (*input_hex)(const unsigned char *,int,char *)) {
    CxLedger local; char hex[65];
    if (!ledger || !stage || !input_hex) return 1;
    memcpy(&local,ledger,sizeof local);
    if (!local.has_id) { snprintf(err,err_n,"INTERFACE_ERROR resource-identity-absent"); return 1; }
    if (strcmp(local.stage,stage)) {
        snprintf(err,err_n,"INTERFACE_ERROR resource-identity-mismatch stage ledger=%s run=%s",local.stage,stage);
        return 1;
    }
    input_hex(input,input_n,hex);
    if (strcmp(local.input_hex,hex)) {
        snprintf(err,err_n,"INTERFACE_ERROR resource-identity-mismatch input ledger=%s run=%s",local.input_hex,hex);
        return 1;
    }
    return 0;
}
int cxsf_ledger_find(const void *rows,int count,int trace,const unsigned char *key,int n) {
    const unsigned char *r=(const unsigned char *)rows;
    if (trace || count<0 || n<0 || (count && !r) || (n && !key)) return -1;
    for(int i=0;i<count;i++) { CxLedgerRow row; memcpy(&row,r+(size_t)i*sizeof row,sizeof row);
        if(row.kn==n && (!n || !memcmp(row.key,key,(size_t)n))) return i; }
    return -1;
}
/* 0 found, 1 not started, 2 missing event, 3 mismatched key. */
int cxsf_ledger_next(const void *rows,int count,int started,int *cursor,
                     const unsigned char *key,int n,int *index) {
    const unsigned char *r=(const unsigned char *)rows;
    if (!started) return 1;
    if (!cursor || !index || *cursor<0 || *cursor>=count || !r) return 2;
    int i=*cursor;
    CxLedgerRow row; memcpy(&row,r+(size_t)i*sizeof row,sizeof row);
    if(n<0 || (n && !key) || row.kn!=n || (n && memcmp(row.key,key,(size_t)n))) return 3;
    *index=i; *cursor=i+1;
    return 0;
}

static int cxsf_token(const char *s,size_t n,const char *word) {
    return strlen(word)==n && !memcmp(s,word,n);
}
/* The registered stage and driver route grammar, without any global state. */
int cxsf_stage_label(const char *label) {
    const char *colon=label?strchr(label,':'):0,*r,*q;size_t n;
    if(!colon) return 0;
    n=(size_t)(colon-label);
    if(!cxsf_token(label,n,"e3") && !cxsf_token(label,n,"lower") && !cxsf_token(label,n,"source")) return 0;
    r=colon+1;q=strchr(r,'/');if(!q)return 0;n=(size_t)(q-r);
    if(!cxsf_token(r,n,"lnx") && !cxsf_token(r,n,"osx") && !cxsf_token(r,n,"win"))return 0;
    r=q+1;q=strchr(r,'/');if(!q)return 0;n=(size_t)(q-r);
    if(!cxsf_token(r,n,"x86_64") && !cxsf_token(r,n,"arm64"))return 0;
    r=q+1;if(!strncmp(r,"warn/",5))r+=5;if(!strncmp(r,"multi/",6))r+=6;
    q=strchr(r,'/');if(!q)return 0;n=(size_t)(q-r);
    if(!cxsf_token(r,n,"tape") && !cxsf_token(r,n,"image") && !cxsf_token(r,n,"run") && !cxsf_token(r,n,"object"))return 0;
    r=q+1;return r[0]=='O' && r[1]>='0' && r[1]<='9' && r[2]==0;
}

/* Complete ledger parsing. File lookup, allocation, errno and SHA remain
 * caller supplied. On failure, committed rows stay owned by the ledger so
 * its caller can release them; transient input, line and blob are released. */
typedef struct {
    void *context; unsigned char *(*file_bytes)(void *,const char *,size_t *);
    void *(*alloc)(void *,size_t); void (*release)(void *);
    int (*get_error)(void); void (*hash_hex)(const void *,size_t,char *);
} CxLedgerParseOps;
int cxsf_ledger_parse(const char *dir,void *ledger,char *err,size_t errn,const void *callbacks) {
    if(!dir||!ledger||!callbacks)return 1;
    CxLedgerParseOps io;memcpy(&io,callbacks,sizeof io);
    if(!io.file_bytes||!io.alloc||!io.release||!io.get_error||!io.hash_hex)return 1;
    CxLedger l={0};memcpy(ledger,&l,sizeof l);size_t n=0,at=0;int cap=0;
    unsigned char *b=io.file_bytes(io.context,"resources.tsv",&n);
    if(!b){int e=io.get_error();snprintf(err,errn,e==ENOENT?"INTERFACE_ERROR resource-ledger-absent %s":e==ENOMEM?"INTERFACE_ERROR resource-ledger-allocation-failed %s":"INTERFACE_ERROR resource-ledger-read-failed %s errno=%d",dir,e);return 1;}
    while(at<n){
        size_t start=0,width=0;int code=cxsf_ledger_line(b,n,&at,&start,&width);
        if(code!=1){io.release(b);snprintf(err,errn,code==3?"INTERFACE_ERROR resource-row-nul":"INTERFACE_ERROR resource-row-truncated");return 1;}
        char *line=io.alloc(0,width+1);if(!line){io.release(b);return 1;}
        memcpy(line,b+start,width);line[width]=0;
        if(!strncmp(line,"#SC1\t",5)||!strncmp(line,"#SC2\t",5)){
            memcpy(&l,ledger,sizeof l);
            int ok=start==0&&!l.has_id&&cxsf_ledger_identity(line,l.stage,sizeof l.stage,l.input_hex);
            if(ok){l.has_id=1;l.trace=line[3]=='2';memcpy(ledger,&l,sizeof l);}
            io.release(line);
            if(!ok){io.release(b);snprintf(err,errn,"INTERFACE_ERROR resource-identity-malformed");return 1;}
            continue;
        }
        char fields[5][4096];int nf=cxsf_ledger_fields(line,fields[0]);
        if(nf!=5){io.release(line);io.release(b);snprintf(err,errn,nf==-3?"INTERFACE_ERROR resource-row-field-too-long":"INTERFACE_ERROR resource-row-fields");return 1;}
        size_t kl=strlen(fields[0]);
        if(!kl||kl%2){io.release(line);io.release(b);snprintf(err,errn,"INTERFACE_ERROR resource-key-malformed");return 1;}
        unsigned char *key=io.alloc(0,kl/2);
        if(!key){io.release(line);io.release(b);return 1;}
        if(!cxsf_ledger_key(fields[0],kl,key)){io.release(key);io.release(line);io.release(b);snprintf(err,errn,"INTERFACE_ERROR resource-key-malformed");return 1;}
        code=cxsf_ledger_add(ledger,&cap,key,(int)(kl/2),io.alloc);
        if(code){io.release(key);io.release(line);io.release(b);if(code==1)snprintf(err,errn,"INTERFACE_ERROR duplicate-resource-key %s",fields[0]);else if(code==3)snprintf(err,errn,"INTERFACE_ERROR resource-ledger-allocation-failed");return 1;}
        memcpy(&l,ledger,sizeof l);unsigned char *slot=(unsigned char *)l.rows+(size_t)(l.n-1)*sizeof(CxLedgerRow);
        CxLedgerRow row;memcpy(&row,slot,sizeof row);int len=0;
        code=cxsf_ledger_metadata(fields[1],fields[2],fields[3],fields[4],&row.present,&len);
        if(code){io.release(line);io.release(b);snprintf(err,errn,code==1?"INTERFACE_ERROR resource-presence-invalid":code==2?"INTERFACE_ERROR resource-length-invalid":code==3?"INTERFACE_ERROR resource-absent-malformed":"INTERFACE_ERROR resource-blob-malformed");return 1;}
        memcpy(slot,&row,sizeof row);
        if(row.present){
            size_t bl=0;unsigned char *value=io.file_bytes(io.context,fields[2],&bl);
            if(!value){int e=io.get_error();io.release(line);io.release(b);snprintf(err,errn,e==ENOENT?"INTERFACE_ERROR resource-bytes-absent %s":e==ENOMEM?"INTERFACE_ERROR resource-ledger-allocation-failed %s":"INTERFACE_ERROR resource-bytes-read-failed %s errno=%d",fields[0],e);return 1;}
            if(bl!=(size_t)len){io.release(value);io.release(line);io.release(b);snprintf(err,errn,"INTERFACE_ERROR resource-bytes-length-mismatch %s",fields[0]);return 1;}
            char hex[65];io.hash_hex(value,bl,hex);
            if(strcmp(hex,fields[4])){io.release(value);io.release(line);io.release(b);snprintf(err,errn,"INTERFACE_ERROR resource-hash-mismatch %s",fields[0]);return 1;}
            row.value=value;row.vn=(int)bl;snprintf(row.blob,sizeof row.blob,"%s",fields[2]);memcpy(slot,&row,sizeof row);
        }
        io.release(line);
    }
    io.release(b);return 0;
}

/* Open and read decisions for the product readfile path. The caller still
 * performs open, read, close, stamp, fprintf, and die. A null pointer is
 * refused before any write; that guard is not part of the old C path. */
const char *cxsf_open_reason(long fd, int windows, long enoent, long enotdir, long eacces) {
    if (windows) return 0;
    if (fd == -enoent) return "ENOENT";
    if (fd == -enotdir) return "ENOTDIR";
    if (fd == -eacces) return "EACCES";
    return 0;
}
int cxsf_open_gate(long fd, int optional, int unisa_windows, long enoent) {
    if (fd >= 0) return 0;
    if (unisa_windows) return optional ? 1 : 2;
    if (optional && fd == -enoent) return 1;
    return 2;
}
int cxsf_open_line(char *dst, int cap, const char *path, const char *reason) {
    const char *prefix = "run: cannot open ";
    size_t pn, rn, need;
    if (!dst || !path || cap < 1) return 1;
    pn = strlen(path);
    rn = reason ? strlen(reason) : 0;
    if (pn > 2147483647u || rn > 2147483647u) return 1;
    need = strlen(prefix) + pn + 1;
    if (reason) {
        if (need > 2147483647u - 2 - rn) return 1;
        need += 2 + rn;
    }
    if (need > 2147483646u || need + 1 > (size_t)cap) return 1;
    if (reason) snprintf(dst, (size_t)cap, "run: cannot open %s: %s\n", path, reason);
    else snprintf(dst, (size_t)cap, "run: cannot open %s\n", path);
    return 0;
}
int cxsf_read_cap(int stamped, long long size, long long off) {
    long long span;
    if (!stamped || size <= off) return 65536;
    span = size - off;
    if (span > 1073741823LL) return 65536;
    return (int)span + 1;
}
int cxsf_read_grow(int cap, int *next) {
    if (!next) return 4;
    if (cap > 1073741823) return 1;
    *next = cap * 2;
    return 0;
}
int cxsf_read_take(long r, int cap, int n, int *out) {
    if (!out) return 4;
    if (r < 0) return 1;
    if (r == 0) return 2;
    if (r > (long)(cap - n)) return 3;
    *out = n + (int)r;
    return 0;
}
/* package_open has no reason suffix and no optional miss. */
int cxsf_package_gate(long fd) {
    return fd < 0 ? 2 : 0;
}

/* Capture write decisions. mkdir, open, write, link and unlink stay with
 * the caller. A short buffer or a null pointer returns 1 or 4 and writes
 * nothing. A negative file index is refused; the old snprintf was not. */
static int cxsf_dec(char *tmp, int v) {
    unsigned int u;
    int n, neg;
    neg = v < 0;
    u = neg ? (unsigned int)(-(v + 1)) + 1u : (unsigned int)v;
    n = 0;
    do { tmp[n++] = (char)('0' + (int)(u % 10u)); u /= 10u; } while (u && n < 15);
    if (neg && n < 16) tmp[n++] = '-';
    return n;
}
int cxsf_cap_full(int count, int max) { return count >= max; }
