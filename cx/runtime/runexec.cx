#pragma unisa module runexec
#pragma unisa use sys.io
#pragma unisa use sys.posix
#pragma unisa use source_frame
/* Execute gate and status lines. No include.
   core_run stays in exec/c/run.c. ex_cap_gate is the entry refusal:
   it asks sy_env and writes one stderr line through sy_eprintf.
   A product build ignores the budget string and does not call parse.
   A null budget keeps the fallback and does not call parse.
   A failed parse returns 2 and leaves steps unchanged. why receives
   "run: UNISA_MAXSTEPS must be a positive decimal integer <= 9223372036854775807\n"
   when it fits. If why cannot hold that line, return 1 and write nothing.
   Return 3 when steps is null, or a budget is present and parse is null.
   ex_lines writes the historical status lines. Status 1 copies reason
   up to reason_n and also stops at a zero byte. Status 2 copies the
   C string. Status 3 prints the step count, including a minus sign.
   A line that is not selected becomes an empty string. A short buffer
   or a null reason where a line needs it writes nothing. */
static int ex_ulen(unsigned long long u) {
    int n;
    n = 1;
    while (u > 9) { u = u / 10; n++; }
    return n;
}

static void ex_mag(long long v, int *sign, int *digits, unsigned long long *mag) {
    if (v < 0) {
        *sign = 1;
        *mag = (unsigned long long)(-(v + 1)) + 1;
    } else {
        *sign = 0;
        *mag = (unsigned long long)v;
    }
    *digits = ex_ulen(*mag);
}

static void ex_udigits(char *out, long at, int digits, unsigned long long u) {
    int i;
    for (i = digits - 1; i >= 0; i--) {
        out[at + i] = (char)('0' + (int)(u % 10));
        u = u / 10;
    }
}

static long ex_copy(char *out, long cap, long at, const char *s) {
    long i;
    i = 0;
    while (s[i]) {
        if (out && at + 1 < cap) out[at] = s[i];
        at++;
        i++;
    }
    return at;
}

static int ex_put(char *out, long cap, const char *msg) {
    long n, i;
    if (!msg) return 0;
    n = 0;
    while (msg[n]) n++;
    if (!out || n + 1 > cap) return 0;
    for (i = 0; i < n; i++) out[i] = msg[i];
    out[n] = 0;
    return 1;
}

int ex_budget(int product, const char *budget, long long fallback,
              int (*parse)(const char *, long long *),
              long long *steps, char *why, long cap) {
    long long parsed;
    const char *msg = "run: UNISA_MAXSTEPS must be a positive decimal integer <= 9223372036854775807\n";
    if (!steps) return 3;
    if (product || !budget) {
        *steps = fallback;
        if (why && cap > 0) why[0] = 0;
        return 0;
    }
    if (!parse) return 3;
    if (!parse(budget, &parsed)) {
        if (!ex_put(why, cap, msg)) return 1;
        return 2;
    }
    *steps = parsed;
    if (why && cap > 0) why[0] = 0;
    return 0;
}

static long ex_reason_n(const char *reason, int reason_n) {
    long n;
    n = 0;
    while (n < reason_n && reason[n]) n++;
    return n;
}

int ex_lines(int status, const char *reason, int reason_n, long long steps,
             char *reject, long reject_cap, char *runmsg, long run_cap,
             char *blown, long blown_cap) {
    int want_reject, want_run, want_budget, sign, digits;
    unsigned long long mag;
    long rn, need, at;
    want_reject = status == 1 && reason_n > 0;
    want_run = status == 2;
    want_budget = status == 3;
    if (want_reject && !reason) return 3;
    if (want_run && !reason) return 3;
    if (reason_n < 0) return 3;
    rn = want_reject ? ex_reason_n(reason, reason_n) : 0;
    if (want_budget) ex_mag(steps, &sign, &digits, &mag);
    else { sign = 0; digits = 0; mag = 0; }
    if (want_reject && (!reject || 8 + rn + 1 + 1 > reject_cap)) return 1;
    if (want_run) {
        need = 0;
        need = ex_copy(0, 0, need, "run: ");
        need = ex_copy(0, 0, need, reason);
        need = need + 1;
        if (!runmsg || need + 1 > run_cap) return 1;
    }
    if (want_budget) {
        need = 0;
        need = ex_copy(0, 0, need, "step budget exhausted (budget ");
        need = need + sign + digits;
        need = ex_copy(0, 0, need, " steps)\n");
        if (!blown || need + 1 > blown_cap) return 1;
    }
    if (reject && reject_cap > 0) reject[0] = 0;
    if (runmsg && run_cap > 0) runmsg[0] = 0;
    if (blown && blown_cap > 0) blown[0] = 0;
    if (want_reject) {
        at = ex_copy(reject, reject_cap, 0, "reject: ");
        while (rn) { reject[at++] = *reason++; rn--; }
        reject[at++] = '\n';
        reject[at] = 0;
    }
    if (want_run) {
        at = ex_copy(runmsg, run_cap, 0, "run: ");
        at = ex_copy(runmsg, run_cap, at, reason);
        runmsg[at++] = '\n';
        runmsg[at] = 0;
    }
    if (want_budget) {
        at = ex_copy(blown, blown_cap, 0, "step budget exhausted (budget ");
        if (sign) blown[at++] = '-';
        ex_udigits(blown, at, digits, mag);
        at = at + digits;
        at = ex_copy(blown, blown_cap, at, " steps)\n");
        blown[at] = 0;
    }
    return 0;
}

/* Ledger state for one process. source_frame parses and matches rows.
   sy_*, mm_*, and sy_sha256_hex stay as declarations: those bodies
   already live in other product objects. */
static int ex_strict;
static int ex_loaded;
static int ex_started;
static int ex_die_rc = 1;
static int ex_errno;
static int ex_cap_want;
static int ex_cap_active;
static int ex_cap_n;
static char ex_dir[4096];
static char ex_cap[4096];
static char ex_cap_live[4096];
static CxLedger ex_led;
static unsigned char *ex_bk[64];
static unsigned char *ex_bb[64];
static int ex_bkn[64];
static int ex_bbl[64];
static int ex_bo[64];
static int ex_bn;

static int ex_zlen(const char *s) {
    int n;
    n = 0;
    if (!s) return 0;
    while (s[n]) n = n + 1;
    return n;
}

static int ex_eq(const char *a, const char *b) {
    int i;
    if (!a || !b) return 0;
    i = 0;
    while (a[i] && a[i] == b[i]) i = i + 1;
    return a[i] == 0 && b[i] == 0;
}

static int ex_has(const char *s, const char *w) {
    int i;
    int j;
    if (!s || !w) return 0;
    i = 0;
    while (s[i]) {
        j = 0;
        while (w[j] && s[i + j] == w[j]) j = j + 1;
        if (!w[j]) return 1;
        i = i + 1;
    }
    return 0;
}

static void ex_putdir(char *dst, const char *src) {
    int i;
    i = 0;
    while (src[i]) { dst[i] = src[i]; i = i + 1; }
    dst[i] = 0;
}

static int ex_join(char *dst, int cap, const char *dir, const char *name) {
    int i;
    int j;
    int nd;
    int nn;
    nd = ex_zlen(dir);
    nn = ex_zlen(name);
    if (nd < 0 || nn < 0 || nd + 1 + nn + 1 > cap) return 1;
    i = 0;
    while (i < nd) { dst[i] = dir[i]; i = i + 1; }
    dst[i] = '/';
    i = i + 1;
    j = 0;
    while (j < nn) { dst[i] = name[j]; i = i + 1; j = j + 1; }
    dst[i] = 0;
    return 0;
}

static void *ex_alloc(void *ctx, size_t n) {
    void *mm_grow(void *, long);
    if (n == 0 || n > 2147483647u) return 0;
    return mm_grow(ctx, (long)n);
}

static void ex_release(void *p) {
    void mm_free(void *);
    mm_free(p);
}

static int ex_geterr(void) { return ex_errno; }

static void ex_hex(const void *data, size_t n, char *hex) {
    int sy_sha256_hex(const void *, long, char *);
    int i;
    if (!hex) return;
    if (n > 2147483647u || sy_sha256_hex(data, (long)n, hex)) {
        i = 0;
        while (i < 65) { hex[i] = 0; i = i + 1; }
    }
}

static void ex_hex_u(const unsigned char *p, int n, char *hex) {
    if (n < 0) n = 0;
    ex_hex(p, (size_t)n, hex);
}

static unsigned char *ex_file(void *ctx, const char *name, size_t *n) {
    int sy_open_read(const char *);
    long sy_read(int, void *, long);
    int sy_close(int);
    void *mm_grow(void *, long);
    char path[4096];
    unsigned char *b;
    unsigned char *nb;
    long got;
    long room;
    long nroom;
    long k;
    int fd;
    (void)ctx;
    ex_errno = 2;
    if (!n) return 0;
    *n = 0;
    if (ex_join(path, 4096, ex_dir, name)) { ex_errno = 36; return 0; }
    fd = sy_open_read(path);
    if (fd < 0) { ex_errno = -fd; return 0; }
    b = 0;
    got = 0;
    room = 0;
    for (;;) {
        if (got == room) {
            if (room > 1073741824L) { sy_close(fd); ex_release(b); ex_errno = 12; return 0; }
            nroom = room ? room * 2 : 4096;
            nb = mm_grow(b, nroom);
            if (!nb) { sy_close(fd); ex_release(b); ex_errno = 12; return 0; }
            b = nb;
            room = nroom;
        }
        k = sy_read(fd, b + got, room - got);
        if (k < 0) { sy_close(fd); ex_release(b); ex_errno = (int)(-k); return 0; }
        if (k == 0) break;
        got = got + k;
    }
    sy_close(fd);
    if (!b) {
        b = ex_alloc(0, 1);
        if (!b) { ex_errno = 12; return 0; }
    }
    *n = (size_t)got;
    return b;
}

static int ex_load(char *err, int cap) {
    CxLedgerParseOps io;
    int i;
    i = 0;
    while (i < cap) { err[i] = 0; i = i + 1; }
    io.context = 0;
    io.file_bytes = ex_file;
    io.alloc = ex_alloc;
    io.release = ex_release;
    io.get_error = ex_geterr;
    io.hash_hex = ex_hex;
    return cxsf_ledger_parse(ex_dir, &ex_led, err, (size_t)cap, &io);
}

typedef struct {
    long size;
    long ino;
    long mtime;
    int mode;
    int kind;
    long uid;
    unsigned long dev;
} ExStat;

static void ex_die(const char *msg) {
    void core_host_panic(const char *);
    ex_die_rc = 2;
    core_host_panic(msg ? msg : "capture");
}

static int ex_cap_append(const char *path, const unsigned char *bytes, int n, int require_empty, char *err, int errn) {
    int sy_open(const char *, int, int);
    int sy_fstat(int, ExStat *);
    int sy_write_all(int, const void *, long);
    int sy_close(int);
    ExStat st;
    int fd;
    int rc;
    fd = sy_open(path, 1 | 1024 | 2048 | 131072 | 524288, 0);
    if (fd < 0) { cxsf_cap_line(err, errn, 5, 0, 0); return 1; }
    rc = sy_fstat(fd, &st);
    if (cxsf_cap_reg(rc == 0, rc == 0 && st.kind == 'f', require_empty, rc == 0 ? (long long)st.size : 0)) {
        sy_close(fd);
        cxsf_cap_line(err, errn, 6, 0, 0);
        return 1;
    }
    if (n > 0 && sy_write_all(fd, bytes, n)) {
        sy_close(fd);
        cxsf_cap_line(err, errn, 7, 0, 0);
        return 1;
    }
    if (sy_close(fd)) { cxsf_cap_line(err, errn, 8, 0, 0); return 1; }
    return 0;
}

static int ex_cap_new(const char *dir, const char *name, const unsigned char *bytes, int n, char *err, int errn) {
    int sy_mkdir(const char *, int);
    int sy_open_new(const char *, int);
    int sy_write_all(int, const void *, long);
    int sy_close(int);
    int sy_unlink(const char *);
    int sy_rmdir(const char *);
    char tmp[4096];
    char from[4096];
    char to[4096];
    int fd;
    int bad;
    int rc;
    if (cxsf_cap_stage(tmp, 4096, dir, 1) || cxsf_cap_join(from, 4096, tmp, "bytes") || cxsf_cap_join(to, 4096, dir, name)) {
        cxsf_cap_line(err, errn, 0, 0, 0);
        return 1;
    }
    if (sy_mkdir(tmp, 0700)) { cxsf_cap_line(err, errn, 1, 0, 0); return 1; }
    bad = 0;
    fd = sy_open_new(from, 0600);
    if (fd < 0) bad = 1;
    else {
        if (n > 0 && sy_write_all(fd, bytes, n)) bad = 1;
        if (sy_close(fd)) bad = 1;
    }
    if (bad) cxsf_cap_line(err, errn, 2, 0, name);
    else {
        rc = sy_linkat(sy_at_fdcwd(), from, sy_at_fdcwd(), to, 0);
        if (rc) { bad = 1; cxsf_cap_line(err, errn, 3, rc == -17, name); }
    }
    if (sy_unlink(from) && !bad) { bad = 1; cxsf_cap_line(err, errn, 4, 0, 0); }
    if (sy_rmdir(tmp) && !bad) { bad = 1; cxsf_cap_line(err, errn, 4, 0, 0); }
    return bad;
}

static int ex_cap_row(const char *dir, int index, int present, const unsigned char *key, int kn, const unsigned char *bytes, int len, char *err, int errn) {
    char path[4096];
    char hex[1025];
    char sha[65];
    char name[64];
    char row[1280];
    int z;
    if (cxsf_cap_hex(hex, 1025, key, kn)) return 1;
    if (present) {
        ex_hex_u(bytes ? bytes : (const unsigned char *)"", len, sha);
        if (cxsf_cap_name(name, 64, index)) return 1;
        if (ex_cap_new(dir, name, bytes, len, err, errn)) return 1;
        if (cxsf_cap_row(row, 1280, 1, hex, name, len, sha)) return 1;
    } else if (cxsf_cap_row(row, 1280, 0, hex, 0, 0, 0)) return 1;
    z = ex_zlen(row);
    if (cxsf_cap_join(path, 4096, dir, "resources.tsv")) { cxsf_cap_line(err, errn, 0, 0, 0); return 1; }
    return ex_cap_append(path, (const unsigned char *)row, z, 0, err, errn);
}

static int ex_cap_keep(int present, const unsigned char *key, int kn, const unsigned char *bytes, int len) {
    unsigned char *k;
    unsigned char *b;
    int i;
    if (ex_bn >= 64) return 1;
    k = ex_alloc(0, (size_t)kn);
    if (!k) return 1;
    i = 0;
    while (i < kn) { k[i] = key[i]; i = i + 1; }
    b = 0;
    if (present && len > 0) {
        b = ex_alloc(0, (size_t)len);
        if (!b) { ex_release(k); return 1; }
        i = 0;
        while (i < len) { b[i] = bytes[i]; i = i + 1; }
    }
    ex_bk[ex_bn] = k;
    ex_bb[ex_bn] = b;
    ex_bkn[ex_bn] = kn;
    ex_bbl[ex_bn] = present ? len : 0;
    ex_bo[ex_bn] = present;
    ex_bn = ex_bn + 1;
    return 0;
}

static int ex_cap_begin(const char *dir, const char *stage, const unsigned char *input, int n, char *err, int errn) {
    int sy_mkdir(const char *, int);
    int sy_lstat(const char *, ExStat *);
    int sy_open_read(const char *);
    int sy_close(int);
    int sy_rmdir(const char *);
    char path[4096];
    char guard[4096];
    char line[512];
    char hex[65];
    char names[8192];
    ExStat st;
    int empty;
    int bad;
    int cls;
    int fd;
    int rc;
    int count;
    int at;
    int seen;
    int i;
    i = 0;
    while (i < errn) { err[i] = 0; i = i + 1; }
    if (cxsf_cap_args(dir != 0, stage != 0, n, input != 0)) {
        cxsf_cap_dirline(err, errn, 0);
        return 1;
    }
    if (cxsf_cap_join(path, 4096, dir, "resources.tsv") || cxsf_cap_join(guard, 4096, dir, ".capture-begin")) {
        cxsf_cap_line(err, errn, 0, 0, 0);
        return 1;
    }
    rc = sy_mkdir(dir, 0700);
    if (rc && rc != -17) { cxsf_cap_dirline(err, errn, 1); return 1; }
    if (sy_mkdir(guard, 0700)) { cxsf_cap_dirline(err, errn, 2); return 1; }
    empty = 0;
    rc = sy_lstat(path, &st);
    if (rc == 0) cls = cxsf_cap_ledger(1, st.kind == 'f', 0, (long long)st.size, &empty);
    else if (rc == -2) cls = cxsf_cap_ledger(0, 0, 1, 0, &empty);
    else cls = cxsf_cap_ledger(0, 0, 0, 0, &empty);
    bad = 1;
    if (cls) {
        cxsf_cap_dirline(err, errn, cls == 1 ? 3 : cls == 2 ? 4 : 5);
        goto done;
    }
    fd = sy_open_read(dir);
    if (fd < 0) { cxsf_cap_dirline(err, errn, 6); goto done; }
    count = sy_dir_names(fd, names, 8192);
    if (sy_close(fd) || count < 0) { cxsf_cap_dirline(err, errn, 7); goto done; }
    seen = 0;
    at = 0;
    while (seen < count) {
        if (cxsf_cap_dent(names + at, empty)) { cxsf_cap_dirline(err, errn, 8); goto done; }
        while (names[at]) at = at + 1;
        at = at + 1;
        seen = seen + 1;
    }
    ex_hex_u(input ? input : (const unsigned char *)"", n, hex);
    if (cxsf_cap_idline(line, 512, stage, hex)) { cxsf_cap_dirline(err, errn, 10); goto done; }
    if (cxsf_cap_place(empty)) bad = ex_cap_append(path, (const unsigned char *)line, ex_zlen(line), 1, err, errn);
    else bad = ex_cap_new(dir, "resources.tsv", (const unsigned char *)line, ex_zlen(line), err, errn);
done:
    if (sy_rmdir(guard) && !bad) { bad = 1; cxsf_cap_dirline(err, errn, 9); }
    if (!bad) {
        ex_putdir(ex_cap_live, dir);
        ex_cap_active = 1;
        ex_cap_n = 0;
        i = 0;
        while (i < ex_bn) {
            if (ex_cap_row(dir, ex_cap_n, ex_bo[i], ex_bk[i], ex_bkn[i], ex_bb[i], ex_bbl[i], err, errn)) {
                bad = 1;
                ex_cap_active = 0;
                break;
            }
            ex_release(ex_bk[i]);
            ex_release(ex_bb[i]);
            ex_bk[i] = 0;
            ex_bb[i] = 0;
            ex_cap_n = ex_cap_n + 1;
            i = i + 1;
        }
        ex_bn = 0;
    }
    return bad;
}

/* A non-empty UNISACC_RF_CAPTURE records the host answers. An empty value
   is no capture. This pass also takes --strict-resource-flow and
   --resource-ledger DIR out of argv. Return 2 after one stderr line.
   Return 1 when fewer than two arguments remain. Return 0 to continue.
   sy_env is the entry's env module; this file does not emit a second copy. */
int ex_cap_gate(int *argc, char **argv) {
    const char *sy_env(const char *);
    const char *v;
    int i;
    int w;
    int n;
    char err[512];
    v = sy_env("UNISACC_RF_CAPTURE");
    if (v && v[0]) {
        if (ex_zlen(v) >= 4096) {
            sy_eprintf("unisacc: INTERFACE_ERROR capture-path-too-long\n");
            return 2;
        }
        ex_putdir(ex_cap, v);
        ex_cap_want = 1;
    }
    if (!argc || !argv) return 1;
    n = *argc;
    w = 1;
    i = 1;
    while (i < n) {
        if (ex_eq(argv[i], "--strict-resource-flow")) { ex_strict = 1; i = i + 1; continue; }
        if (ex_eq(argv[i], "--resource-ledger")) {
            if (i + 1 >= n) { sy_eprintf("unisacc: --resource-ledger needs DIR\n"); return 2; }
            i = i + 1;
            if (ex_zlen(argv[i]) >= 4096) {
                sy_eprintf("unisacc: INTERFACE_ERROR resource-ledger-path-too-long\n");
                return 2;
            }
            cxsf_ledger_clear(&ex_led, ex_release);
            ex_loaded = 0;
            ex_started = 0;
            ex_putdir(ex_dir, argv[i]);
            if (ex_load(err, 512)) {
                if (!err[0]) sy_eprintf("unisacc: INTERFACE_ERROR resource-ledger-read-failed\n");
                else sy_eprintf("unisacc: %s\n", err);
                return 2;
            }
            ex_loaded = 1;
            i = i + 1;
            continue;
        }
        argv[w] = argv[i];
        w = w + 1;
        i = i + 1;
    }
    argv[w] = 0;
    *argc = w;
    if (ex_strict && !ex_loaded) {
        sy_eprintf("unisacc: --strict-resource-flow needs --resource-ledger DIR\n");
        return 2;
    }
    if (w < 2) return 1;
    return 0;
}

int ex_ri_rc(void) { return ex_die_rc; }

/* 2: not strict, caller keeps the host path. 1 present, 0 absent.
   A strict miss, a long key, or a trace fault panics with exit code 2. */
int ex_ri_fetch(const unsigned char *key, int n, unsigned char **bytes, int *len) {
    void core_host_panic(const char *);
    char msg[1280];
    char hex[1025];
    CxLedgerRow row;
    int idx;
    int code;
    if (!ex_strict) return 2;
    if (n > 512 || cxsf_cap_hex(hex, 1025, key, n)) {
        ex_die_rc = 2;
        core_host_panic("resource key too long");
        return 2;
    }
    if (ex_led.trace) {
        code = cxsf_ledger_next(ex_led.rows, ex_led.n, ex_started, &ex_led.cursor, key, n, &idx);
        if (code == 1) {
            ex_die_rc = 2;
            core_host_panic("INTERFACE_ERROR resource-trace-not-started");
            return 2;
        }
        if (code == 2) {
            if (cxsf_fetch_miss(msg, 1280, 1, hex, ex_led.cursor)) msg[0] = 0;
            ex_die_rc = 2;
            core_host_panic(msg[0] ? msg : "MISSING_EXPLICIT_RESOURCE");
            return 2;
        }
        if (code != 0) {
            if (cxsf_fetch_mismatch(msg, 1280, hex, ex_led.cursor)) msg[0] = 0;
            ex_die_rc = 2;
            core_host_panic(msg[0] ? msg : "INTERFACE_ERROR resource-trace-key-mismatch");
            return 2;
        }
    } else {
        idx = cxsf_ledger_find(ex_led.rows, ex_led.n, 0, key, n);
        if (idx < 0) {
            if (cxsf_fetch_miss(msg, 1280, 0, hex, 0)) msg[0] = 0;
            ex_die_rc = 2;
            core_host_panic(msg[0] ? msg : "MISSING_EXPLICIT_RESOURCE");
            return 2;
        }
    }
    row = ex_led.rows[idx];
    return cxsf_fetch_hand(row.present, row.value, row.vn, bytes, len);
}

/* Record one host answer when capture is on. rc is the fetch result the
   caller returns. Before the identity line exists, the row is held in
   memory and flushed by ex_ri_arm. A bad key or a full ledger panics. */
int ex_ri_note(const unsigned char *key, int n, int rc, unsigned char **bytes, int *len) {
    char err[512];
    const unsigned char *bp;
    int present;
    int ln;
    int i;
    if (!ex_cap_want || rc == 4) return rc;
    present = rc != 0;
    ln = present && len ? *len : 0;
    bp = present && bytes ? *bytes : 0;
    if (cxsf_cap_key(n, key != 0)) ex_die("INTERFACE_ERROR capture-key-length");
    if (cxsf_cap_answer(present, ln, bp != 0)) ex_die("INTERFACE_ERROR capture-answer-invalid");
    if (cxsf_cap_full(ex_cap_active ? ex_cap_n : ex_bn, 4096)) ex_die("INTERFACE_ERROR capture-capacity-exceeded");
    if (!ex_cap_active) {
        if (ex_cap_keep(present, key, n, bp, ln)) ex_die("INTERFACE_ERROR capture-capacity-exceeded");
        return rc;
    }
    if (cxsf_cap_session(ex_cap_live[0] != 0, ex_cap_active, ex_eq(ex_cap, ex_cap_live), 1))
        ex_die("INTERFACE_ERROR capture-session-not-initialized");
    i = 0;
    while (i < 512) { err[i] = 0; i = i + 1; }
    if (ex_cap_row(ex_cap_live, ex_cap_n, present, key, n, bp, ln, err, 512))
        ex_die(err[0] ? err : "INTERFACE_ERROR capture-ledger-write");
    ex_cap_n = ex_cap_n + 1;
    return rc;
}

/* Hash the source bytes the driver already read. Stage is e3: plus the
   route text (lnx/x86_64/tape/O0). Tape and image pass; other routes
   refuse before the model runs. Return 2 on a named refusal, else 0. */
int ex_ri_arm(const char *route, int mode, const unsigned char *bytes, long n) {
    char stage[160];
    char err[512];
    int i;
    int k;
    if (!ex_strict && !ex_cap_want) return 0;
    if (!((mode == 2 && ex_has(route, "/tape/O")) || (mode == 0 && ex_has(route, "/image/O")))) {
        sy_eprintf("unisacc: INTERFACE_ERROR resource-route-unsupported %s (strict and capture cover tape and image routes only)\n", route ? route : "-");
        return 2;
    }
    if (!route || ex_zlen(route) + 4 > 160 || n < 0 || n > 2147483647L || (n > 0 && !bytes)) {
        sy_eprintf("unisacc: INTERFACE_ERROR capture-stage-label\n");
        return 2;
    }
    stage[0] = 'e';
    stage[1] = '3';
    stage[2] = ':';
    i = 0;
    k = 3;
    while (route[i]) { stage[k] = route[i]; k = k + 1; i = i + 1; }
    stage[k] = 0;
    if (!cxsf_stage_label(stage)) {
        sy_eprintf("unisacc: INTERFACE_ERROR capture-stage-label\n");
        return 2;
    }
    if (ex_strict && cxsf_ledger_check_identity(&ex_led, stage, bytes ? bytes : (const unsigned char *)"", (int)n, err, sizeof err, ex_hex_u)) {
        sy_eprintf("unisacc: %s\n", err[0] ? err : "INTERFACE_ERROR resource-identity-absent");
        return 2;
    }
    if (ex_cap_want && ex_cap_begin(ex_cap, stage, bytes ? bytes : (const unsigned char *)"", (int)n, err, 512)) {
        sy_eprintf("unisacc: %s\n", err[0] ? err : "INTERFACE_ERROR capture-dir-create");
        return 2;
    }
    if (ex_strict) {
        ex_led.cursor = 0;
        ex_started = 1;
    }
    return 0;
}

void ex_alu_note(int rc) {
    if (rc) return;
    sy_eprintf("unisacc: model driver: alu\n");
}

/* Err bytes stay with the caller. Return 1 when n is nonzero and bytes
 * is present: the caller writes those bytes, then frees *owned.
 * Return 0 when n is 0: nothing is written, and *owned is still freed.
 * Return 4 and write nothing when owned is null, or n is nonzero and
 * bytes is null. That null-bytes refusal is not on the old C path. */
int ex_err(const void *bytes, int n, void **owned) {
    if (!owned) return 4;
    if (n && !bytes) return 4;
    *owned = (void *)bytes;
    return n ? 1 : 0;
}
