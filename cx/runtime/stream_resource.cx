#pragma unisa module stream_resource
/* Parse a borrowed NAME=PATH value. On success the caller owns the copied
 * NUL-prefixed name and borrows the path from value. Failure changes no
 * output; absence clears the path and length without writing the name. */
int cxsr_parse(const char *value,unsigned char *name,long cap,const char **path,int *length) {
    if(!name||!path||!length||cap<=0)return 2;
    if(!value||!*value){*path=0;*length=0;return 0;}
    const char *eq=strchr(value,'=');
    if(!eq||eq==value||!eq[1])return 2;
    long n=(long)(eq-value);
    if(n>254||n+1>cap)return 2;
    uintptr_t src=(uintptr_t)value,dst=(uintptr_t)name;size_t source_size=strlen(value)+1;
    if((dst>=src&&dst-src<source_size)||(src>=dst&&src-dst<(uintptr_t)(n+1)))return 2;
    name[0]=0;memcpy(name+1,value,(size_t)n);*path=eq+1;*length=(int)n+1;
    return 1;
}
