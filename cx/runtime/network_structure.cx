#pragma unisa module network_structure
#pragma unisa use model_number
/* Borrowed UNINETB1 N span. The caller keeps the bytes. Record order follows
 * networkformat.decode. Counts and H/C bounds follow run.c before execution:
 * int32 fields, negative action counts, copy prefixes, and bank shape.
 * networkformat.decode reads no further actions after a negative count.
 * Opcode operand kinds, bn/bq ranges, string meaning, inflation, and
 * execution are not judged. */
static const unsigned char ARITY[56] = {
    0,1,1,2,2,4,4,2,2,1,3,3,1,1,0,0,1,1,2,0,0,1,2,2,3,0,1,1,1,1,0,3,3,1,1,2,
    0,0,1,2,1,1,1,1,2,1,1,1,0,0,1,4,4,2,2,1
};
static int done(int *qlen, int code) { free(qlen); return code; }
static int num(const unsigned char *d, long n, long *at, long long *o) {
    int rc = cxmn_number(d, n, at, 1, o);
    return rc ? 4 : 0;
}
static int i32(long long v, int *o) {
    if (v < -2147483648LL || v > 2147483647LL) return 0;
    *o = (int)v;
    return 1;
}
static int actions(const unsigned char *d, long n, long *at, int count) {
    int a;
    if (count < 0) return 6;
    if ((long)count > n - *at) return 6;
    for (a = 0; a < count; a++) {
        long long opv; int op, j;
        if (num(d, n, at, &opv)) return 4;
        if (!i32(opv, &op) || op < 0 || op >= 56) return 7;
        for (j = 0; j < ARITY[op]; j++) {
            long long operand;
            if (num(d, n, at, &operand)) return 4;
        }
    }
    return 0;
}
int cxns_audit(const unsigned char *data, long length) {
    long at = 8;
    long long ns, nq, nrg, nstr, start, top, raw;
    int ins, inq, instr, istart, itop, i, *qlen = 0;
    if (length < 0 || (length > 0 && !data)) return 1;
    if (length < 8 || memcmp(data, "UNINETB1", 8)) return 2;
    if (at >= length || data[at++] != 'N') return 3;
    if (num(data, length, &at, &ns) || num(data, length, &at, &nq) ||
        num(data, length, &at, &nrg) || num(data, length, &at, &nstr) ||
        num(data, length, &at, &start) || num(data, length, &at, &top)) return 4;
    if (!i32(ns, &ins) || !i32(nq, &inq) || !i32(nrg, &i) || !i32(nstr, &instr) ||
        !i32(start, &istart) || !i32(top, &itop)) return 3;
    if (ins <= 0 || inq <= 0 || nrg < 0 || instr < 0 || istart < 0 || istart >= ins) return 3;
    if ((long long)ins > length || (long long)inq > length || (long long)instr > length) return 3;
    if (instr == 2147483647 || itop < ins - 1 || itop == 2147483647) return 3;
    for (i = 0; i < instr; i++) {
        int n;
        if (at >= length || data[at++] != 'S') return 5;
        if (num(data, length, &at, &raw)) return 4;
        if (!i32(raw, &n) || n < 0 || n == 2147483647 || (long)n > length - at) return 5;
        at += n;
    }
    if ((size_t)inq > (size_t)-1 / sizeof(int)) return 10;
    qlen = malloc((size_t)inq * sizeof(int));
    if (!qlen) return 10;
    for (i = 0; i < inq; i++) {
        int tag, n, ref = 0, prefix = 0, rc;
        if (at >= length) return done(qlen, 6);
        tag = data[at++];
        if (tag == 'C') {
            long long a, b;
            if (num(data, length, &at, &raw) || num(data, length, &at, &a) ||
                num(data, length, &at, &b)) return done(qlen, 4);
            if (!i32(raw, &ref) || !i32(a, &prefix) || !i32(b, &n)) return done(qlen, 6);
            if (ref < 0 || ref >= i || prefix <= 0 || prefix > qlen[ref] ||
                n < 0 || (long long)n > 2147483647LL - prefix) return done(qlen, 6);
        } else {
            if (tag != 'Q') return done(qlen, 6);
            if (num(data, length, &at, &raw)) return done(qlen, 4);
            if (!i32(raw, &n) || n < 0) return done(qlen, 6);
        }
        rc = actions(data, length, &at, n);
        if (rc) return done(qlen, rc);
        qlen[i] = prefix + n;
    }
    free(qlen); qlen = 0;
    for (i = 0; i < ins; i++) {
        long long f[6];
        int m, lo, hi, n, bn, bq, rs, rn, prev, j;
        if (at >= length || data[at++] != 'H') return 8;
        for (j = 0; j < 6; j++) if (num(data, length, &at, &f[j])) return 4;
        if (!i32(f[0], &m) || !i32(f[1], &lo) || !i32(f[2], &hi) ||
            !i32(f[3], &n) || !i32(f[4], &bn) || !i32(f[5], &bq)) return 8;
        if (m == 3) {
            if (num(data, length, &at, &raw)) return 4;
            if (!i32(raw, &rs)) return 8;
            if (num(data, length, &at, &raw)) return 4;
            if (!i32(raw, &rn)) return 8;
            if (rs < 0 || rs >= inq || rn < 1 || rn > ins) return 8;
            if ((long)rn > length - at) return 8;
            prev = -1;
            for (j = 0; j < rn; j++) {
                int k;
                if (num(data, length, &at, &raw)) return 4;
                if (!i32(raw, &k) || k <= prev || k >= ins) return 8;
                prev = k;
            }
            m = 1;
        }
        if (m < 0 || m > 2 || lo != (m == 1 ? -1 : 0) ||
            hi != (m == 1 ? itop : 256) || n < 0) return 8;
        if ((long long)n > (long long)hi - lo) return 8;
        if ((long)n > length - at) return 8;
        prev = lo;
        for (j = 0; j < n; j++) {
            int key, row, seq;
            if (num(data, length, &at, &raw)) return 4;
            if (!i32(raw, &key)) return 8;
            if (num(data, length, &at, &raw)) return 4;
            if (!i32(raw, &row)) return 8;
            if (num(data, length, &at, &raw)) return 4;
            if (!i32(raw, &seq)) return 8;
            if (key <= prev || key > hi) return 8;
            prev = key;
            (void)row; (void)seq; (void)bn; (void)bq;
        }
    }
    if (at != length) return 9;
    return 0;
}
