#pragma unisa module packagestruct
#pragma unisa use mem.bytes
/* Structural audit of one P1, P2, or P3 package span. The caller owns the
 * bytes and locates a UNIPKG1 footer separately. Stage route, name, in, and
 * out use the pword_owned alphabet. P1 and P2 extents must start with N.
 * That byte is not a network parse. P3 extents stay opaque. cxps_models
 * borrows each P3 stored span during one walk and does not copy or retain it. */
typedef struct { const unsigned char *p; long n; } CxpsField;
static int blank(unsigned char c) {
    return c == ' ' || c == '\t' || c == '\r' || c == '\v' || c == '\f';
}
static int line(const unsigned char *d, long n, long *at, CxpsField *f, int max, int *nf) {
    long i = *at, end, k = 0;
    if (i >= n) return 0;
    end = i;
    while (end < n && d[end] != '\n') end++;
    if (end >= n) return 0;
    i = *at; *at = end + 1;
    while (i < end) {
        while (i < end && blank(d[i])) i++;
        if (i >= end) break;
        if (k == max) return 0;
        f[k].p = d + i;
        while (i < end && !blank(d[i])) i++;
        f[k].n = (d + i) - f[k].p;
        k++;
    }
    *nf = (int)k;
    return 1;
}
static int u64(const CxpsField *f, unsigned long long limit, unsigned long long *o) {
    unsigned long long v = 0; long i;
    if (f->n <= 0) return 0;
    for (i = 0; i < f->n; i++) {
        unsigned d = (unsigned)(f->p[i] - '0');
        if (d > 9) return 0;
        if (v > limit / 10 || (v == limit / 10 && d > limit % 10)) return 0;
        v = v * 10 + d;
    }
    *o = v;
    return 1;
}
static int word(CxpsField f) {
    long i;
    if (f.n <= 0) return 0;
    for (i = 0; i < f.n; i++) {
        unsigned char c = f.p[i];
        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
              (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.' || c == '/'))
            return 0;
    }
    return 1;
}
static int same(CxpsField a, CxpsField b) {
    return a.n == b.n && (a.n == 0 || mm_same(a.p, b.p, a.n));
}
static int tag(CxpsField f, char c) { return f.n == 1 && f.p[0] == c; }
static int stage_conflict(const unsigned char *d, long n, long at, int count, CxpsField route, CxpsField stage, CxpsField in) {
    int i, seen = 0; CxpsField last = { 0, 0 };
    for (i = 0; i < count; i++) {
        CxpsField f[8]; int nf = 0;
        if (!line(d, n, &at, f, 8, &nf) || nf != 6 || !tag(f[0], 'D')) return -1;
        if (same(f[1], route) && same(f[2], stage)) return 1;
        if (same(f[1], route)) { last = f[4]; seen = 1; }
    }
    return seen && !same(last, in);
}
static int key_conflict(const unsigned char *d, long n, long at, int count, const unsigned char *key, long keylen) {
    int i;
    for (i = 0; i < count; i++) {
        CxpsField f[8]; int nf = 0; unsigned long long a, b; long keyat;
        if (!line(d, n, &at, f, 8, &nf) || nf != 3 || !tag(f[0], 'F')) return -1;
        if (at > n || !u64(&f[1], (unsigned long long)(n - at), &a) || !u64(&f[2], (unsigned long long)(n - at), &b)) return -1;
        if (a > (unsigned long long)(n - at) || b > (unsigned long long)(n - at - (long)a)) return -1;
        keyat = at;
        if ((long)a == keylen && (keylen == 0 || mm_same(d + keyat, key, keylen))) return 1;
        at = keyat + (long)a + (long)b;
    }
    return 0;
}
static int walk(const unsigned char *data, long length, int *version,
                int (*visit)(void *, const unsigned char *, long, long, unsigned long),
                void *ctx) {
    CxpsField f[8]; int nf, ver, i; long at = 0, stage_at, res_at;
    unsigned long long nm, nd, nr, cap;
    if (!version || length < 0 || (length > 0 && !data)) return 1;
    if (!line(data, length, &at, f, 8, &nf) || nf < 2 || !tag(f[0], 'P')) return 2;
    if (f[1].n != 1 || f[1].p[0] < '1' || f[1].p[0] > '3') return 2;
    ver = f[1].p[0] - '0';
    if (nf != (ver == 1 ? 4 : 5)) return 2;
    if (!u64(&f[2], (unsigned long long)length, &nm) || !u64(&f[3], (unsigned long long)length, &nd)) return 2;
    nr = 0;
    if (ver != 1 && !u64(&f[4], (unsigned long long)length, &nr)) return 2;
    cap = (unsigned long long)length;
    if (cap > 2147483647ULL) cap = 2147483647ULL;
    if (nm == 0 || nd == 0 || nm > cap || nd > cap || nr > cap) return 3;
    stage_at = at;
    for (i = 0; i < (int)nd; i++) {
        unsigned long long idx; int conflict;
        if (!line(data, length, &at, f, 8, &nf) || nf != 6 || !tag(f[0], 'D')) return 4;
        if (!word(f[1]) || !word(f[2]) || !word(f[3]) || !word(f[4])) return 4;
        if (!u64(&f[5], nm - 1, &idx)) return 4;
        conflict = stage_conflict(data, length, stage_at, i, f[1], f[2], f[3]);
        if (conflict) return 4;
    }
    for (i = 0; i < (int)nm; i++) {
        unsigned long long stored, rawlen, codec, sum;
        if (!line(data, length, &at, f, 8, &nf) || !tag(f[0], 'M')) return 5;
        if (nf != (ver == 3 ? 5 : 2)) return 5;
        if (at > length || !u64(&f[1], (unsigned long long)(length - at), &stored) || stored == 0) return 5;
        if (ver == 3) {
            if (!u64(&f[2], 2147483647ULL, &rawlen) || rawlen == 0) return 5;
            if (!u64(&f[3], 1, &codec) || codec != 1) return 5;
            if (!u64(&f[4], 4294967295ULL, &sum)) return 5;
            if (visit) {
                int stop = visit(ctx, data + at, (long)stored, (long)rawlen, (unsigned long)sum);
                if (stop == 1) return 8;
                if (stop) return 9;
            }
        } else if (data[at] != 'N') return 5;
        at += (long)stored;
    }
    res_at = at;
    for (i = 0; i < (int)nr; i++) {
        unsigned long long keylen, vallen; int conflict;
        if (!line(data, length, &at, f, 8, &nf) || nf != 3 || !tag(f[0], 'F')) return 6;
        if (at > length || !u64(&f[1], (unsigned long long)(length - at), &keylen) || keylen == 0) return 6;
        if (!u64(&f[2], (unsigned long long)(length - at), &vallen)) return 6;
        if (keylen > (unsigned long long)(length - at) || vallen > (unsigned long long)(length - at - (long)keylen)) return 6;
        conflict = key_conflict(data, length, res_at, i, data + at, (long)keylen);
        if (conflict) return 6;
        at += (long)keylen + (long)vallen;
    }
    if (at != length) return 7;
    *version = ver;
    return 0;
}
int cxps_audit(const unsigned char *data, long length, int *version) {
    return walk(data, length, version, 0, 0);
}
/* One walk. visit is required. It is called only for P3, with a borrowed
 * stored span plus the declared raw length and checksum. Return 0 from visit
 * to continue, 1 to interrupt (8), and any other nonzero to refuse (9).
 * Failure leaves *version unchanged. No inflation or copy. */
int cxps_models(const unsigned char *data, long length, int *version,
                int (*visit)(void *ctx, const unsigned char *stored, long nstored,
                             long rawlen, unsigned long crc),
                void *ctx) {
    if (!visit) return 1;
    return walk(data, length, version, visit, ctx);
}
