#pragma unisa module archname
/* Generated by tools/axis-gen.cx from exec/facts/pp-targets.tsv.
   Do not edit by hand. Names are the first-seen arch column.
   The six os/arch pairs stay on targetname.
   A null out-pointer returns 4. An index outside 0..count-1 returns 2.
   No libc and no include. */
int rarc_count(void) {
    return 2;
}
int rarc_at(int index, const char **name) {
    if (!name) return 4;
    if (index == 0) { *name = "x86_64"; return 0; }
    if (index == 1) { *name = "arm64"; return 0; }
    return 2;
}
