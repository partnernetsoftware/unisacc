#pragma unisa module stream_attributes
/* Borrow a serialized attribute table. The first little-endian word is its
 * record count; the rest must be exactly that many nine-byte records. */
int cxsa_valid(const unsigned char *data,long length) {
    if(!data||length<4)return 0;
    unsigned long count=(unsigned long)data[0]|((unsigned long)data[1]<<8)|
        ((unsigned long)data[2]<<16)|((unsigned long)data[3]<<24);
    if(count>1000000UL)return 0;
    return length==4+(long)count*9;
}
