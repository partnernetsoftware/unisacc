#pragma unisa module holdframe
#pragma unisa use mem.heap
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use runtime.frames
#pragma unisa use sys.time
#pragma unisa use sys.io

static long long hf_now(void) {
    sy_ts_t t; if (sy_mono(&t)) return -1;
    return (long long)t.sec * 1000000000LL + t.nsec;
}
static void hf_metric(const char *op, long physical, long logical, long attrs,
                      long dictionary, long shared, long long start) {
    const char *e = sy_env("UNISACC_RR_TIME"); long long end;
    if (!e || !e[0]) return;
    end = hf_now();
    sy_eprintf("RR_TIME\tphase-material\top=%s\tphase_physical_bytes=%ld\tframe_logical_bytes=%ld\tattrs_bytes=%ld\tunique_dictionary_bytes=%ld\tshared_dictionary_bytes=%ld\tdictionary_kind=generic-exact-chunks\tunique_header_bytes=UNMEASURED\trestore_consume_bytes=%ld\tns=%lld\tmacro_evaluation_skipped=0\tparse_skipped=0\n", op, physical, logical, attrs, dictionary, shared, op[0]=='w'?0:logical, start < 0 || end < 0 ? -1LL : end-start);
}
static long hf_u32(const unsigned char *p) {
    return (long)p[0] | ((long)p[1]<<8) | ((long)p[2]<<16) | ((long)p[3]<<24);
}
static int hf_valid(const unsigned char *fr, long fn, const unsigned char *at, long an) {
    long pos = 0, units = 0, count;
    while (pos < fn) {
        long z, nl;
        if (fn-pos < 8) return 1;
        z = hf_u32(fr+pos); nl = hf_u32(fr+pos+4);
        if (z < 4 || z > fn-pos-4 || nl < 0 || nl > z-4) return 1;
        units++; pos += 4+z;
    }
    if (!units) return 1;
    if (!an) return 0;
    if (!at || an < 4) return 1;
    count = hf_u32(at);
    if (count < 0 || count > 1000000L || an != 4+count*9) return 1;
    for (long i=0; i<count; i++) if (hf_u32(at+4+i*9) >= units) return 1;
    return 0;
}
/* First-pass unit frames and their attribute table. Plain bytes, no handles.
   Upper layer: no #include, no libc. Allocation is mm_*. */
static unsigned char *hf_fr;
static long hf_frn;
static unsigned char *hf_at;
static long hf_atn;

static void hf_copy(unsigned char *d, const unsigned char *s, long n) {
    long i;
    i = 0;
    while (i < n) {
        d[i] = s[i];
        i = i + 1;
    }
}

/* Checkpoint receipt: <path>.sha256 holds the SHA-256 of the whole phase
   file (header, physical frames, attribute table) as 64 hex digits and LF.
   Written after the file; a restore without a matching receipt is refused,
   so a truncated, edited or mismatched checkpoint never silently continues. */
static int hf_receipt_path(const char *path, char *dst, long cap) {
    long i;
    const char *suf;
    i = 0;
    while (path[i]) { if (i + 8 >= cap) return 1; dst[i] = path[i]; i = i + 1; }
    suf = ".sha256";
    while (*suf) { dst[i] = *suf; i = i + 1; suf = suf + 1; }
    dst[i] = 0;
    return 0;
}

static int hf_receipt_digest(const unsigned char *hdr, const unsigned char *body, long bodyn,
                             const unsigned char *at, long atn, char hex[65]) {
    unsigned char *all;
    long n;
    n = 8 + bodyn + atn;
    all = mm_alloc(n);
    if (!all) return 1;
    hf_copy(all, hdr, 8);
    hf_copy(all + 8, body, bodyn);
    if (atn > 0) hf_copy(all + 8 + bodyn, at, atn);
    cx_sha256_hex(all, (size_t)n, hex);
    mm_free(all);
    return 0;
}

static int hf_receipt_write(const char *path, const unsigned char *hdr, const unsigned char *body, long bodyn,
                            const unsigned char *at, long atn) {
    char rp[4400];
    char hex[66];
    int fd;
    int wr;
    int cl;
    if (hf_receipt_path(path, rp, 4400)) return 1;
    if (hf_receipt_digest(hdr, body, bodyn, at, atn, hex)) return 1;
    hex[64] = '\n';
    hex[65] = 0;
    fd = sy_open(rp, O_CREAT | O_TRUNC | O_WRONLY, 0644);
    if (fd < 0) return 1;
    wr = sy_write_all(fd, hex, 65);
    cl = sy_close(fd);
    return wr || cl;
}

/* 0 when <path>.sha256 matches the raw bytes read from PATH. */
static int hf_receipt_check(const char *path, const unsigned char *hdr, const unsigned char *body, long bodyn,
                            const unsigned char *at, long atn) {
    char rp[4400];
    char hex[65];
    unsigned char got[65];
    int fd;
    long i;
    if (hf_receipt_path(path, rp, 4400)) return 1;
    fd = sy_open_read(rp);
    if (fd < 0) return 1;
    if (sy_reg_size(fd) != 65 || sy_read_full(fd, got, 65)) { sy_close(fd); return 1; }
    sy_close(fd);
    if (got[64] != '\n') return 1;
    if (hf_receipt_digest(hdr, body, bodyn, at, atn, hex)) return 1;
    i = 0;
    while (i < 64) { if ((unsigned char)hex[i] != got[i]) return 1; i = i + 1; }
    return 0;
}

void hf_drop(void) {
    mm_free(hf_fr);
    mm_free(hf_at);
    hf_fr = 0;
    hf_frn = 0;
    hf_at = 0;
    hf_atn = 0;
}

int hf_keep(const unsigned char *fr, long frn, const unsigned char *at, long atn) {
    unsigned char *fp;
    unsigned char *cp;
    hf_drop();
    if (!fr || frn <= 0) return 1;
    fp = mm_alloc(frn);
    if (!fp) return 1;
    hf_copy(fp, fr, frn);
    cp = 0;
    if (atn > 0) {
        if (!at) {
            mm_free(fp);
            return 1;
        }
        cp = mm_alloc(atn);
        if (!cp) {
            mm_free(fp);
            return 1;
        }
        hf_copy(cp, at, atn);
    }
    hf_fr = fp;
    hf_frn = frn;
    hf_at = cp;
    hf_atn = atn;
    {
        const char *path;
        int fd;
        unsigned char nb[8];
        long i;
        unsigned long v;
        unsigned char *packed = 0;
        const unsigned char *physical = hf_fr;
        long physicaln = hf_frn;
        long dictionary = 0, shared = 0;
        const char *compact = sy_env("UNISACC_PP_COMPACT");
        const char *timing = sy_env("UNISACC_RR_TIME");
        long long started = timing && timing[0] ? hf_now() : -1;
        path = sy_env("UNISACC_PHASE_OUT");
        if (path && path[0]) {
            if (compact && compact[0] == '1' && !compact[1]) {
                if (fr_phase_pack(hf_fr, hf_frn, &packed, &physicaln, &dictionary, &shared)) return 1;
                physical = packed;
            }
            {
              if (timing && timing[0]) {
                  long long end = hf_now();
                  sy_eprintf("RR_TIME\tphase-pack\tpack_ns=%lld\n", started < 0 || end < 0 ? -1LL : end-started);
              }
            }
            fd = sy_open(path, O_CREAT | O_TRUNC | O_WRONLY, 0644);
            if (fd < 0) { mm_free(packed); return 1; }
            {
                v = (unsigned long)physicaln;
                i = 0;
                while (i < 4) { nb[i] = (unsigned char)((v >> (8 * i)) & 255); i = i + 1; }
                v = (unsigned long)hf_atn;
                while (i < 8) { nb[i] = (unsigned char)((v >> (8 * (i - 4))) & 255); i = i + 1; }
                int wr = sy_write_all(fd, nb, 8);
                if (!wr) wr = sy_write_all(fd, physical, physicaln);
                if (!wr && hf_atn > 0) wr = sy_write_all(fd, hf_at, hf_atn);
                int cl = sy_close(fd);
                if (wr || cl) { mm_free(packed); return 1; }
            }
            if (hf_receipt_write(path, nb, physical, physicaln, hf_at, hf_atn)) { mm_free(packed); return 1; }
            hf_metric("write", 8+physicaln+hf_atn, hf_frn, hf_atn, dictionary, shared, started);
            mm_free(packed);
        }
    }
    return 0;
}

static int hf_load(void) {
    const char *path;
    int fd;
    unsigned char nb[8];
    long frn;
    long atn;
    unsigned char *fr;
    unsigned char *at;
    long physicaln, dictionary = 0, shared = 0;
    const char *timing = sy_env("UNISACC_RR_TIME");
    long long started = timing && timing[0] ? hf_now() : -1;
    path = sy_env("UNISACC_PHASE_IN");
    if (!path || !path[0]) return 1;
    fd = sy_open_read(path);
    if (fd < 0) return 1;
    if (sy_read_full(fd, nb, 8)) { sy_close(fd); return 1; }
    frn = (long)nb[0] | ((long)nb[1] << 8) | ((long)nb[2] << 16) | ((long)nb[3] << 24);
    atn = (long)nb[4] | ((long)nb[5] << 8) | ((long)nb[6] << 16) | ((long)nb[7] << 24);
    if (frn <= 0 || frn > 2147483647L || atn < 0 || atn > 2147483647L) { sy_close(fd); return 1; }
    physicaln = frn;
    fr = mm_alloc(frn);
    at = atn ? mm_alloc(atn) : 0;
    if (!fr || (atn && !at) || sy_read_full(fd, fr, frn) || (atn && sy_read_full(fd, at, atn))) {
        mm_free(fr);
        mm_free(at);
        sy_close(fd);
        return 1;
    }
    if (sy_reg_size(fd) != 8+physicaln+atn) { mm_free(fr); mm_free(at); sy_close(fd); return 1; }
    sy_close(fd);
    if (hf_receipt_check(path, nb, fr, physicaln, at, atn)) { mm_free(fr); mm_free(at); return 1; }
    if (frn >= 8 && fr[0] == 'U' && fr[1] == 'N' && fr[2] == 'I' && fr[3] == 'F') {
        unsigned char *restored = 0; long restoredn = 0;
        if (fr_phase_unpack(fr, frn, &restored, &restoredn, &dictionary, &shared)) { mm_free(fr); mm_free(at); return 1; }
        mm_free(fr); fr = restored; frn = restoredn;
    }
    if (hf_valid(fr, frn, at, atn)) { mm_free(fr); mm_free(at); return 1; }
    hf_metric("restore", 8+physicaln+atn, frn, atn, dictionary, shared, started);
    hf_fr = fr;
    hf_frn = frn;
    hf_at = at;
    hf_atn = atn;
    return 0;
}

/* A phase B restore that fails (absent file, bad extent, receipt mismatch)
   is a refusal, never a silent fall back to a fresh whole compile: the
   driver reads hf_phase_refused and stops. The flag is sticky per process. */
static int hf_refused;

unsigned char *hf_frames(long *n) {
    if (!hf_fr) {
        const char *e = sy_env("UNISACC_PHASE");
        if (hf_load() && e && e[0] == 'B' && e[1] == 0) hf_refused = 1;
    }
    if (n) *n = hf_frn;
    return hf_fr;
}

/* Hand the kept frames and attribute table back as fresh copies (frames
   are never empty after a load; attrs may be 0/0) and drop the hold. The
   copies belong to the caller. 1 when nothing is held or memory is short. */
int hf_take(unsigned char **fr, long *frn, unsigned char **at, long *atn) {
    unsigned char *f;
    unsigned char *a;
    *fr = 0; *frn = 0; *at = 0; *atn = 0;
    if (!hf_frames(0) || hf_frn <= 0) return 1;
    f = mm_alloc(hf_frn);
    if (!f) return 1;
    hf_copy(f, hf_fr, hf_frn);
    a = 0;
    if (hf_atn > 0) {
        a = mm_alloc(hf_atn);
        if (!a) { mm_free(f); return 1; }
        hf_copy(a, hf_at, hf_atn);
    }
    *fr = f; *frn = hf_frn; *at = a; *atn = hf_atn;
    hf_drop();
    return 0;
}

/* 1 when the first-pass forwarding stub exists at PATH; absent or no path is 0.
   Any other stat failure also counts as present so the stub route reports the
   real error instead of silently going stub-less. */
int hf_stub_present(const char *path) {
    if (!path || !path[0]) return 0;
    return sy_exists(path) != 0;
}

int hf_phase_refused(void) {
    return hf_refused;
}

unsigned char *hf_attrs(long *n) {
    if (n) *n = hf_atn;
    return hf_at;
}

int hf_phase_b(void) {
    const char *e;
    e = sy_env("UNISACC_PHASE");
    if (!e || e[0] != 'B' || e[1] != 0) return 0;
    return hf_frames(0) != 0;
}
