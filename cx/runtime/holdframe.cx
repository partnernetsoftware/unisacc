#pragma unisa module holdframe
#pragma unisa use mem.heap
/* First-pass unit frames and their attribute table. Plain bytes, no handles.
   Upper layer: no #include, no libc. Allocation is mm_*. */
static unsigned char *hf_fr;
static long hf_frn;
static unsigned char *hf_at;
static long hf_atn;

static void hf_copy(unsigned char *d, const unsigned char *s, long n) {
    long i;
    i = 0;
    while (i < n) {
        d[i] = s[i];
        i = i + 1;
    }
}

void hf_drop(void) {
    mm_free(hf_fr);
    mm_free(hf_at);
    hf_fr = 0;
    hf_frn = 0;
    hf_at = 0;
    hf_atn = 0;
}

int hf_keep(const unsigned char *fr, long frn, const unsigned char *at, long atn) {
    unsigned char *fp;
    unsigned char *cp;
    hf_drop();
    if (!fr || frn <= 0) return 1;
    fp = mm_alloc(frn);
    if (!fp) return 1;
    hf_copy(fp, fr, frn);
    cp = 0;
    if (atn > 0) {
        if (!at) {
            mm_free(fp);
            return 1;
        }
        cp = mm_alloc(atn);
        if (!cp) {
            mm_free(fp);
            return 1;
        }
        hf_copy(cp, at, atn);
    }
    hf_fr = fp;
    hf_frn = frn;
    hf_at = cp;
    hf_atn = atn;
    return 0;
}

unsigned char *hf_frames(long *n) {
    if (n) *n = hf_frn;
    return hf_fr;
}

unsigned char *hf_attrs(long *n) {
    if (n) *n = hf_atn;
    return hf_at;
}
