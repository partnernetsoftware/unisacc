#pragma unisa module model_payload
#pragma unisa use codec
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
/* Check a P3 member without retaining its bytes. The caller owns the input.
 * This verifies exact DEFLATE extents, CRC and the binary-network marker;
 * it does not parse the network or authenticate the package. */
int cxmp_audit_with(const unsigned char *stored, long stored_n, long raw_n,
                    unsigned expected_crc, int (*check)(const unsigned char *, long)) {
    unsigned char *raw;
    CxCodecCrc crc;
    uint32_t actual;
    int rc;
    if (!stored || stored_n <= 0 || raw_n <= 0 || raw_n > 2147483647L)
        return 1;
    raw = mm_alloc(raw_n);
    if (!raw) return 2;
    rc = cxcodec_inflate(raw, (unsigned long)raw_n, stored, (unsigned long)stored_n);
    if (rc) { mm_free(raw); return 3; }
    cxcodec_crc_init(&crc);
    rc = cxcodec_crc(&crc, (const char *)raw, (int)raw_n, &actual);
    if (rc || actual != expected_crc) { mm_free(raw); return 4; }
    if (raw_n < 9 || !mm_same(raw, "UNINETB1N", 9)) { mm_free(raw); return 5; }
    if (check && check(raw,raw_n)) { mm_free(raw); return 6; }
    mm_free(raw);
    return 0;
}
int cxmp_audit(const unsigned char *stored, long stored_n, long raw_n,
               unsigned expected_crc) {
    return cxmp_audit_with(stored,stored_n,raw_n,expected_crc,0);
}
