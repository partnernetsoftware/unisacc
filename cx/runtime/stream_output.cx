#pragma unisa module stream_output
/* The caller owns the descriptor, path and byte span. These functions retain
 * nothing. Attribute files opened here are closed before return. */
int cxs_write(int fd,const void *data,long n) {
    if(n<0 || (!data && n))return 2;
    const unsigned char *p=(const unsigned char *)data;
    while(n){ssize_t z=write(fd,p,(size_t)n);if(z>0){p+=z;n-=z;}else if(z<0&&errno==EINTR)continue;else return 2;}
    return 0;
}
int cxs_attributes(const char *path,const void *data,long n) {
    if(n<0 || (!data && n))return 2;
    if(!path||!*path||!n)return 0;
    int fd=open(path,O_WRONLY|O_CREAT|O_TRUNC,0600);if(fd<0)return 2;
    int rc=cxs_write(fd,data,n);if(close(fd))rc=2;return rc;
}
