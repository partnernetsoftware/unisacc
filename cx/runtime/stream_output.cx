#pragma unisa module stream_output
#pragma unisa use sys.fs
/* The caller owns the descriptor, path and byte span. These functions retain
 * nothing. Attribute files opened here are closed before return.  The write,
 * open and close primitives come from sys.fs so this L1 module keeps no bare
 * libc call (tests/cxraw.cx). */
int cxs_write(int fd,const void *data,long n) {
    if(n<0 || (!data && n))return 2;
    return sy_write_all(fd, data, n) ? 2 : 0;
}
int cxs_attributes(const char *path,const void *data,long n) {
    if(n<0 || (!data && n))return 2;
    if(!path||!*path||!n)return 0;
    int fd=sy_open(path,O_WRONLY|O_CREAT|O_TRUNC,0600);if(fd<0)return 2;
    int rc=cxs_write(fd,data,n);if(sy_close(fd))rc=2;return rc;
}
