#pragma unisa module modelload
/* Order of one model load. The byte parser stays in model_decode.
   No libc and no include.
   0  decode returned 0. take ran, then bind. fail did not run.
   1  decode returned nonzero. fail receives why when why is
      non-null, including an empty string. A null why becomes
      "invalid model input". take and bind do not run.
   2  dec, model, or any function pointer is null. Nothing runs.
   A null data pointer is forwarded with its length. */
static const char *ml_text(const char *why) {
    if (why) return why;
    return "invalid model input";
}

int ml_load(void *dec, void *model, const unsigned char *data, long len,
            int (*decode)(void *, const unsigned char *, long),
            const char *(*whyof)(void *),
            void (*take)(void *, void *),
            void (*bindfn)(void *),
            void (*fail)(const char *)) {
    int rc;
    const char *why;
    if (!dec || !model || !decode || !whyof || !take || !bindfn || !fail) return 2;
    rc = decode(dec, data, len);
    if (rc) {
        why = whyof(dec);
        fail(ml_text(why));
        return 1;
    }
    take(dec, model);
    bindfn(model);
    return 0;
}
