#pragma unisa module routespan
/* Package stage-span selection. No libc and no include.
   Inflation, clocks, execute, and buffer swap stay in exec/c/run.c.
   A null first or last pointer is absent. An empty string is a name.
   A null stage route or name does not match. The caller still dies
   with "unknown package route or stage boundary" when rs_ok is 0.
   rs_take counts a stage before the caller runs it. A failing stage
   returns its own status and does not ask rs_ok.
   After the selected last name, stop is 1 and later takes return 0. */
typedef struct { int ready, ended, count, stop; } RsCursor;

static int rs_eq(const char *a, const char *b) {
    int i;
    if (!a || !b) return 0;
    i = 0;
    while (a[i] && a[i] == b[i]) i++;
    return a[i] == b[i];
}

void rs_reset(RsCursor *c, int first_absent, int last_absent) {
    if (!c) return;
    c->ready = first_absent ? 1 : 0;
    c->ended = last_absent ? 1 : 0;
    c->count = 0;
    c->stop = 0;
}

int rs_take(RsCursor *c, const char *stage_route, const char *stage_name,
            const char *route, const char *first, const char *last) {
    if (!c || c->stop) return 0;
    if (!rs_eq(stage_route, route)) return 0;
    if (!c->ready) {
        if (!rs_eq(stage_name, first)) return 0;
        c->ready = 1;
    }
    c->count++;
    if (last && rs_eq(stage_name, last)) {
        c->ended = 1;
        c->stop = 1;
    }
    return 1;
}

int rs_ok(const RsCursor *c) {
    if (!c) return 0;
    return c->count > 0 && c->ended;
}
