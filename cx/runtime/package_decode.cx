#pragma unisa module package_decode
#pragma unisa use package_lifetime
#pragma unisa use mem.bytes
/* Decode directory tables from one borrowed package span.  On success the
 * caller owns the returned allocations; file and path remain unowned. */
typedef struct {
    const unsigned char *bytes; long length, at;
    void *(*allocate)(void *, size_t); void (*release)(void *);
    CxPackage package; const char *why;
} CxPackageDecode;
static int bad(CxPackageDecode *d,const char *why) { if (!d->why) d->why=why; return 1; }
static void *getmem(CxPackageDecode *d,size_t n) {
    void *p=d->allocate(0,n?n:1); if(!p)bad(d,"out of memory"); return p;
}
static int tag(CxPackageDecode *d,int want) {
    int value=0,rc;
    int cxmn_tag(const unsigned char *, long, long *, int, int *);
    rc=cxmn_tag(d->bytes,d->length,&d->at,0,&value);
    if(rc==2)return bad(d,"truncated model");
    if(rc==3)return bad(d,"bad model tag");
    if(rc)return bad(d,"invalid model tag input");
    return value==want?0:bad(d,"bad model tag");
}
static int number(CxPackageDecode *d,long long *v) {
    int rc;
    int cxmn_number(const unsigned char *, long, long *, int, long long *);
    rc=cxmn_number(d->bytes,d->length,&d->at,0,v);
    if(rc==5)return bad(d,"bad model number");
    if(rc==6)return bad(d,"model number overflow");
    if(rc==7)return bad(d,"missing model number");
    return rc?bad(d,"invalid model number input"):0;
}
static int integer(CxPackageDecode *d,int *v) {
    long long n;if(number(d,&n))return 1;
    if(n < (-2147483647LL-1) || n > 2147483647LL)return bad(d,"model index overflow");
    *v=(int)n;return 0;
}
static char *word(CxPackageDecode *d) {
    while(d->at<d->length && d->bytes[d->at]<=32)d->at++;
    long start=d->at;
    while(d->at<d->length && d->bytes[d->at]>32) {
        int c=d->bytes[d->at++];
        if(!((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_'||c=='-'||c=='.'||c=='/')){bad(d,"bad package name");return 0;}
    }
    long n=d->at-start;if(!n){bad(d,"missing package name");return 0;}
    char *v=getmem(d,(size_t)n+1);if(v){if(mm_copy(v,(long)n+1,d->bytes+start,(long)n)){bad(d,"out of memory");return 0;}v[n]=0;}return v;
}
static int pk_eq(const char *a, const char *b) {
    int i;
    if (!a || !b) return 0;
    for (i = 0; i < 64; i++) {
        if (a[i] != b[i]) return 0;
        if (!a[i]) return 1;
    }
    return 0;
}
static int pk_image(const char *s) {
    int i, j;
    const char *n = "/image/";
    if (!s) return 0;
    for (i = 0; i < 128 && s[i]; i++) {
        for (j = 0; n[j] && s[i + j] == n[j]; j++) {}
        if (!n[j]) return 1;
    }
    return 0;
}
/* Route index over the stage list: one chain per distinct route, found
 * through an open hash on the route text. The s^2 walk it replaces cost
 * about 60ms per open on the 1,823-stage product package. Every refusal
 * below is the same refusal as before, in the same order. */
typedef struct { int *slot; int cap; int *next; int *first; int *last; } PkIndex;
static unsigned pk_hash(const char *s) {
    unsigned h = 2166136261u;
    int i;
    for (i = 0; s[i]; i++) { h = h ^ (unsigned char)s[i]; h = h * 16777619u; }
    return h;
}
static void pk_index_drop(CxPackageDecode *d, PkIndex *x) {
    d->release(x->slot); d->release(x->next); d->release(x->first); d->release(x->last);
    x->slot = 0; x->next = 0; x->first = 0; x->last = 0;
}
static int pk_index_open(CxPackageDecode *d, PkIndex *x, int ps) {
    int i;
    x->cap = 16;
    while (x->cap < ps * 2) x->cap = x->cap * 2;
    x->slot = getmem(d, sizeof(int) * (size_t)x->cap);
    x->next = getmem(d, sizeof(int) * (size_t)ps);
    x->first = getmem(d, sizeof(int) * (size_t)ps);
    x->last = getmem(d, sizeof(int) * (size_t)ps);
    if (!x->slot || !x->next || !x->first || !x->last) { pk_index_drop(d, x); return 1; }
    for (i = 0; i < x->cap; i++) x->slot[i] = -1;
    for (i = 0; i < ps; i++) { x->next[i] = -1; x->first[i] = -1; x->last[i] = -1; }
    return 0;
}
/* Find the slot of stage i's route among stages 0..i-1. The slot holds the
 * first stage index of that route, or -1 when the route is new. */
static int pk_index_find(const PkIndex *x, const CxPackage *p, int i) {
    int bx_stage_route(const char *, const char *const *, int);
    unsigned k = pk_hash(p->stages[i].route) & (unsigned)(x->cap - 1);
    for (;;) {
        const char *routes[1];
        int f = x->slot[k];
        if (f < 0) return (int)k;
        routes[0] = p->stages[f].route;
        if (bx_stage_route(p->stages[i].route, routes, 1) == 1) return (int)k;
        k = (k + 1) & (unsigned)(x->cap - 1);
    }
}
/* An image route must still name lower and end on elf. A one-byte stage
 * rename or an elf row that left the route is not a route. An image route
 * of 64 bytes or more never matched itself under the old bounded compare and
 * was refused; it still is. */
static int image_open(const CxPackage *p, const PkIndex *x) {
    int i, k, lower, n;
    const char *last;
    for (i = 0; i < p->s; i++) {
        if (x->first[i] != i || !pk_image(p->stages[i].route)) continue;
        for (n = 0; n < 64 && p->stages[i].route[n]; n++) {}
        if (n >= 64) return 1;
        lower = 0;
        last = 0;
        for (k = i; k >= 0; k = x->next[k]) {
            last = p->stages[k].name;
            if (pk_eq(last, "lower")) lower = 1;
        }
        if (!lower || !pk_eq(last, "elf")) return 1;
    }
    return 0;
}
static int decode(CxPackageDecode *d) {
    CxPackage *p=&d->package;int ver,pm,ps,nr=0;
    int bx_stage_model_ok(int, int);
    int bx_stage_present(const char *, const char *, const char *const *, const char *const *, int);
    int bx_stage_join(const char *, const char *);
    p->b=(unsigned char *)d->bytes;p->n=(int)d->length;
    if (!d->length || !d->bytes || d->bytes[0] != 'P') return bad(d, "bad model tag");
    if(tag(d,'P')||integer(d,&ver))return 1;
    if(ver<1||ver>4)return bad(d,"unknown package version");p->ver=ver;
    if(integer(d,&pm)||integer(d,&ps)||(ver>=2&&integer(d,&nr)))return 1;
    if(nr<0||nr>p->n/5)return bad(d,"bad resource count");
    p->res=getmem(d,sizeof(CxPackageResource)*(size_t)nr);if(!p->res)return 1;p->nr=nr;
    mm_fill(p->res, sizeof(CxPackageResource)*(size_t)nr, 0, sizeof(CxPackageResource)*(size_t)nr);
    if(pm<=0||ps<=0||pm>p->n/8||ps>p->n/10)return bad(d,"bad package count");
    p->off=getmem(d,sizeof(int)*(size_t)pm);if(!p->off)return 1;
    p->len=getmem(d,sizeof(int)*(size_t)pm);if(!p->len)return 1;
    p->raw=getmem(d,sizeof(int)*(size_t)pm);if(!p->raw)return 1;
    p->crc=getmem(d,sizeof(uint32_t)*(size_t)pm);if(!p->crc)return 1;p->m=pm;
    p->stages=getmem(d,sizeof(CxPackageStage)*(size_t)ps);if(!p->stages)return 1;
    mm_fill(p->stages, sizeof(CxPackageStage)*(size_t)ps, 0, sizeof(CxPackageStage)*(size_t)ps);p->s=ps;
    PkIndex x;if(pk_index_open(d,&x,ps))return 1;
    for(int i=0;i<ps;i++){
        if(tag(d,'D')){pk_index_drop(d,&x);return 1;}CxPackageStage *s=&p->stages[i];
        s->route=word(d);if(!s->route){pk_index_drop(d,&x);return 1;}s->name=word(d);if(!s->name){pk_index_drop(d,&x);return 1;}
        s->in=word(d);if(!s->in){pk_index_drop(d,&x);return 1;}s->out=word(d);if(!s->out){pk_index_drop(d,&x);return 1;}
        if(integer(d,&s->model)){pk_index_drop(d,&x);return 1;}
        if(bx_stage_model_ok(s->model,pm)!=0){pk_index_drop(d,&x);return bad(d,"bad package model index");}
        int previous=-1;int slot=pk_index_find(&x,p,i);int f=x.slot[slot];
        if(f>=0){
            for(int j=f;j>=0;j=x.next[j]){
                const char *routes[1];const char *names[1];
                routes[0]=p->stages[j].route;names[0]=p->stages[j].name;
                if(bx_stage_present(s->route,s->name,routes,names,1)==1){pk_index_drop(d,&x);return bad(d,"duplicate package stage");}
            }
            previous=x.last[f];x.next[previous]=i;x.last[f]=i;x.first[i]=f;
        } else {x.slot[slot]=i;x.first[i]=i;x.last[i]=i;}
        if(previous>=0&&bx_stage_join(p->stages[previous].out,s->in)!=0){pk_index_drop(d,&x);return bad(d,"package format mismatch");}
    }
    if (image_open(p,&x)) {pk_index_drop(d,&x);return bad(d, "unknown package route or stage boundary");}
    pk_index_drop(d,&x);
    for(int i=0;i<pm;i++){
        int n;if(tag(d,'M')||integer(d,&n))return 1;p->raw[i]=n;p->crc[i]=0;
        if(ver>=3){int codec;long long sum;if(integer(d,&p->raw[i])||integer(d,&codec)||number(d,&sum))return 1;
            if(p->raw[i]<=0||codec!=1||sum<0||sum>4294967295LL)return bad(d,"bad compressed model header");p->crc[i]=(uint32_t)sum;}
        if(d->at>=d->length||d->bytes[d->at++]!=10||n<=0||n>d->length-d->at)return bad(d,"bad package model extent");
        if(ver<3&&d->bytes[d->at]!='N')return bad(d,"package requires networks");
        p->off[i]=(int)d->at;p->len[i]=n;d->at+=n;
    }
    for(int i=0;i<nr;i++){
        int n,len;int rawlen=0;int codec=0;long long sum=0;
        if(tag(d,'F')||integer(d,&n)||integer(d,&len))return 1;
        if(ver>=4){
            if(integer(d,&rawlen)||integer(d,&codec)||number(d,&sum))return 1;
            if(codec==1){if(len<=0||rawlen<=0||sum<0||sum>4294967295LL)return bad(d,"bad compressed resource header");}
            else if(codec==0){if(rawlen!=len)return bad(d,"raw resource rawlen mismatch");}
            else return bad(d,"bad resource codec");
        }
        if(d->at>=d->length||d->bytes[d->at++]!=10||n<=0||len<0||n>d->length-d->at||len>d->length-d->at-n)return bad(d,"bad resource extent");
        p->res[i].name=(int)d->at;p->res[i].n=n;p->res[i].data=(int)d->at+n;p->res[i].len=len;
        if(ver>=4){p->res[i].rawlen=rawlen;p->res[i].codec=codec;p->res[i].crc=(unsigned)sum;}
        else{p->res[i].rawlen=len;p->res[i].codec=0;p->res[i].crc=0;}
        for(int j=0;j<i;j++)if(p->res[j].n==n&&mm_same(d->bytes+p->res[j].name,d->bytes+d->at,(long)n))return bad(d,"duplicate resource name");
        d->at+=n+len;
    }
    if(d->at!=d->length)return bad(d,"trailing package data");p->complete=1;return 0;
}
int cxpk_decode(CxPackageDecode *d,const unsigned char *bytes,long n) {
    if(!d||!d->allocate||!d->release||n<0||n>2147483647L||(!bytes&&n))return 1;
    cxpl_release(&d->package,d->release);d->bytes=bytes;d->length=n;d->at=0;d->why=0;
    if(decode(d)){cxpl_release(&d->package,d->release);return 1;}return 0;
}
