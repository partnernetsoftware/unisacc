#pragma unisa module model_lifetime
/* Owned decoded-model arrays; the caller supplies the allocation domain's
 * matching release function. The shape mirrors the transitional runtime ABI. */
typedef struct UnisaModel {
    int loaded;
    int ns,nq,nrg,nstr,start,isnet,topmax,nqa;
    char **str; int *strl; int *qoff,*qlen; int64_t *qa;
    int *smode,*rowc,**rowk,**rown,**rowq; int *nlo,*nhi,*bn,*bq,*rets; unsigned char **retok;
} CxModel;
void cxml_release(CxModel *m, void (*release)(void *)) {
    if(!m || !release) return;
    if(m->str) for(int i=0;i<m->nstr;i++) release(m->str[i]);
    if(m->rowk) for(int i=0;i<m->ns;i++) release(m->rowk[i]);
    if(m->rown) for(int i=0;i<m->ns;i++) release(m->rown[i]);
    if(m->rowq) for(int i=0;i<m->ns;i++) release(m->rowq[i]);
    if(m->retok) for(int i=0;i<m->ns;i++) release(m->retok[i]);
    release(m->str); release(m->strl); release(m->qoff); release(m->qlen); release(m->qa);
    release(m->smode); release(m->rowc); release(m->rowk); release(m->rown); release(m->rowq);
    release(m->nlo); release(m->nhi); release(m->bn); release(m->bq); release(m->rets); release(m->retok);
    memset(m,0,sizeof *m);
}
