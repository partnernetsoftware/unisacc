#pragma unisa module model_lifetime
/* TEMP-UNTIL-INSTALL: mem.bytes is already in packmodel.o (package_decode /
   package_lifetime). A second use here would define mm_* again in modeldecode.o.
   The call declares mm_fill locally so this module does not export it.
   After install (module dedupe), restore `#pragma unisa use mem.bytes` and
   delete the local prototype. */
/* Owned decoded-model arrays; the caller supplies the allocation domain's
 * matching release function. The shape mirrors the transitional runtime ABI. */
typedef struct UnisaModel {
    int loaded;
    int ns,nq,nrg,nstr,start,isnet,topmax,nqa;
    char **str; int *strl; int *qoff,*qlen; int64_t *qa;
    int *smode,*rowc,**rowk,**rown,**rowq; int *nlo,*nhi,*bn,*bq,*rets; unsigned char **retok;
} CxModel;
void cxml_release(CxModel *m, void (*release)(void *)) {
    int mm_fill(void *dst, long dcap, int byte, long n);
    if(!m || !release) return;
    if(m->str) for(int i=0;i<m->nstr;i++) release(m->str[i]);
    if(m->rowk) for(int i=0;i<m->ns;i++) release(m->rowk[i]);
    if(m->rown) for(int i=0;i<m->ns;i++) release(m->rown[i]);
    if(m->rowq) for(int i=0;i<m->ns;i++) release(m->rowq[i]);
    if(m->retok) for(int i=0;i<m->ns;i++) release(m->retok[i]);
    release(m->str); release(m->strl); release(m->qoff); release(m->qlen); release(m->qa);
    release(m->smode); release(m->rowc); release(m->rowk); release(m->rown); release(m->rowq);
    release(m->nlo); release(m->nhi); release(m->bn); release(m->bq); release(m->rets); release(m->retok);
    mm_fill(m, sizeof *m, 0, sizeof *m);
}

/* Field copies between the runtime globals and one decoded model.
   Scalars are ns, nq, nrg, nstr, start, isnet, topmax, nqa.
   Pointers are str, strl, qoff, qlen, qa, smode, rowc, rowk, rown,
   rowq, nlo, nhi, bn, bq, rets, retok. loaded is not a global and
   is left unchanged. A null or the wrong width writes nothing. */
static int mv_ok(int **sc, int nsc, void ***slot, int nslot) {
    int i;
    if (!sc || !slot || nsc != 8 || nslot != 16) return 0;
    for (i = 0; i < nsc; i++) if (!sc[i]) return 0;
    for (i = 0; i < nslot; i++) if (!slot[i]) return 0;
    return 1;
}

int mv_clear(int **sc, int nsc, void ***slot, int nslot) {
    int i;
    if (!mv_ok(sc, nsc, slot, nslot)) return 3;
    for (i = 0; i < nsc; i++) *sc[i] = 0;
    for (i = 0; i < nslot; i++) *slot[i] = 0;
    return 0;
}

int mv_capture(void *model, int **sc, int nsc, void ***slot, int nslot) {
    CxModel *m;
    m = model;
    if (!m || !mv_ok(sc, nsc, slot, nslot)) return 3;
    m->ns = *sc[0];
    m->nq = *sc[1];
    m->nrg = *sc[2];
    m->nstr = *sc[3];
    m->start = *sc[4];
    m->isnet = *sc[5];
    m->topmax = *sc[6];
    m->nqa = *sc[7];
    m->str = (char **)*slot[0];
    m->strl = (int *)*slot[1];
    m->qoff = (int *)*slot[2];
    m->qlen = (int *)*slot[3];
    m->qa = (int64_t *)*slot[4];
    m->smode = (int *)*slot[5];
    m->rowc = (int *)*slot[6];
    m->rowk = (int **)*slot[7];
    m->rown = (int **)*slot[8];
    m->rowq = (int **)*slot[9];
    m->nlo = (int *)*slot[10];
    m->nhi = (int *)*slot[11];
    m->bn = (int *)*slot[12];
    m->bq = (int *)*slot[13];
    m->rets = (int *)*slot[14];
    m->retok = (unsigned char **)*slot[15];
    return 0;
}

int mv_bind(void *model, int **sc, int nsc, void ***slot, int nslot) {
    CxModel *m;
    m = model;
    if (!m || !mv_ok(sc, nsc, slot, nslot)) return 3;
    *sc[0] = m->ns;
    *sc[1] = m->nq;
    *sc[2] = m->nrg;
    *sc[3] = m->nstr;
    *sc[4] = m->start;
    *sc[5] = m->isnet;
    *sc[6] = m->topmax;
    *sc[7] = m->nqa;
    *slot[0] = m->str;
    *slot[1] = m->strl;
    *slot[2] = m->qoff;
    *slot[3] = m->qlen;
    *slot[4] = m->qa;
    *slot[5] = m->smode;
    *slot[6] = m->rowc;
    *slot[7] = m->rowk;
    *slot[8] = m->rown;
    *slot[9] = m->rowq;
    *slot[10] = m->nlo;
    *slot[11] = m->nhi;
    *slot[12] = m->bn;
    *slot[13] = m->bq;
    *slot[14] = m->rets;
    *slot[15] = m->retok;
    return 0;
}
