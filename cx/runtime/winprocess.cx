#pragma unisa module winprocess
/* Current-process PE page walk. No libc and no include.
   The Windows adapter still maps the image, allocates, and dies.
   Named-import layout stays in peimport. These functions only decide
   the page, the MZ mark, the PE signature, and the little-endian word
   the adapter already reads. */
long wp_u32(int b0, int b1, int b2, int b3) {
    return (long)(unsigned char)b0
         | ((long)(unsigned char)b1 << 8)
         | ((long)(unsigned char)b2 << 16)
         | ((long)(unsigned char)b3 << 24);
}
long wp_page(long here) {
    return here & -4096;
}
long wp_down(long at) {
    return at - 4096;
}
int wp_keep(long at) {
    return at > 65536;
}
int wp_mz(int b0, int b1) {
    return b0 == 'M' && b1 == 'Z';
}
int wp_pe(long pe, long sig) {
    return pe < 4096 && sig == 0x4550;
}
