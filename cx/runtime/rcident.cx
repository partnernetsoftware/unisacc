#pragma unisa module rcident
#pragma unisa use sys.fs
/* Hot-reuse key for one regular file: SHA-256 of size, dev, ino, mtime, ctime.
   The caller still content-hashes cache entry files. A forged identity misses
   the fast path and cannot validate a stale entry. */
static void ri_put64(unsigned char *p, unsigned long long v) {
    int i;
    i = 0;
    while (i < 8) {
        p[i] = (unsigned char)(v & 255ull);
        v = v >> 8;
        i = i + 1;
    }
}

int rc_hex_ident(const char *path, char hex[65]) {
    unsigned char buf[40];
    sy_stat_t st;
    if (!path || !path[0] || !hex) return 1;
    if (sy_stat(path, &st) || st.kind != 'f' || st.size < 0) return 1;
    ri_put64(buf, (unsigned long long)st.size);
    ri_put64(buf + 8, (unsigned long long)st.dev);
    ri_put64(buf + 16, (unsigned long long)st.ino);
    ri_put64(buf + 24, (unsigned long long)st.mtime);
    ri_put64(buf + 32, (unsigned long long)st.ctime);
    cx_sha256_hex(buf, 40, hex);
    return 0;
}
