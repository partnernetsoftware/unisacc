#pragma unisa module package_lifetime
#pragma unisa use mem.bytes
/* strcmp stays. This module is compiled into packmodel.o, and drive.o already
 * exports tx_eqz, so a use of text.text would duplicate that symbol. */
/* Package data and stage names belong to the same allocation domain.  The
 * interior b pointer and resource offsets borrow from file and are not freed. */
typedef struct { long long size,off,mtime,mtime_ns,ctime,ctime_ns,ino,dev; unsigned tag; int valid; } CxPackageStamp;
typedef struct { char *route,*name,*in,*out; int model; } CxPackageStage;
typedef struct { int name,n,data,len; } CxPackageResource;
typedef struct UnisaPackage {
    char *path; CxPackageStamp stamp; int complete;
    unsigned char *file,*b; int n,m,s,ver;
    int *off,*len,*raw; uint32_t *crc; CxPackageStage *stages; CxPackageResource *res; int nr;
} CxPackage;
void cxpl_release(CxPackage *p, void (*release)(void *)) {
    if (!p || !release) return;
    if (p->stages) for (int i=0;i<p->s;i++) {
        release(p->stages[i].route); release(p->stages[i].name);
        release(p->stages[i].in); release(p->stages[i].out);
    }
    release(p->stages); release(p->off); release(p->len); release(p->raw);
    release(p->crc); release(p->res); release(p->file); release(p->path);
    if (mm_fill(p, (long)sizeof *p, 0, (long)sizeof *p)) return;
}

/* Cache hit decisions. The caller still opens, stamps, parses, and releases.
 * Eight longs are size, off, mtime, mtime_ns, ctime, ctime_ns, ino, dev.
 * A null pointer or a width other than 8 returns 0 and reads nothing. */
int cxpl_stamp_match(const long long *a, const long long *b, int n,
                     unsigned atag, unsigned btag, int av, int bv) {
    if (!a || !b || n != 8) return 0;
    if (!av || !bv || atag != btag) return 0;
    for (int i = 0; i < 8; i++) if (a[i] != b[i]) return 0;
    return 1;
}
int cxpl_reuse(int complete, const char *path, const char *cached, int stamp_match) {
    if (!complete || !path || !cached || !stamp_match) return 0;
    return strcmp(path, cached) == 0;
}
int cxpl_settle(int loading) { return loading ? 1 : 0; }
int cxpl_slot(const void *cache, int m, int nmodels) {
    if (!cache) return 0;
    return m < nmodels;
}
