#pragma unisa module package_lifetime
/* Package data and stage names belong to the same allocation domain.  The
 * interior b pointer and resource offsets borrow from file and are not freed. */
typedef struct { long long size,off,mtime,mtime_ns,ctime,ctime_ns,ino,dev; unsigned tag; int valid; } CxPackageStamp;
typedef struct { char *route,*name,*in,*out; int model; } CxPackageStage;
typedef struct { int name,n,data,len; } CxPackageResource;
typedef struct UnisaPackage {
    char *path; CxPackageStamp stamp; int complete;
    unsigned char *file,*b; int n,m,s,ver;
    int *off,*len,*raw; uint32_t *crc; CxPackageStage *stages; CxPackageResource *res; int nr;
} CxPackage;
void cxpl_release(CxPackage *p, void (*release)(void *)) {
    if (!p || !release) return;
    if (p->stages) for (int i=0;i<p->s;i++) {
        release(p->stages[i].route); release(p->stages[i].name);
        release(p->stages[i].in); release(p->stages[i].out);
    }
    release(p->stages); release(p->off); release(p->len); release(p->raw);
    release(p->crc); release(p->res); release(p->file); release(p->path);
    memset(p,0,sizeof *p);
}
