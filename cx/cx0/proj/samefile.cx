    char ra[CXM_PATHW], rb[CXM_PATHW];
    if (cxm_eq(a, b)) return 1;
    /* the host's canonical-path callback (cxm_bind_real) closes the symlink case: two spellings of
       one file are one module. Unbound, or a path the host cannot resolve, stays a text compare. */
    if (cxm_reali && cxm_reali(a, ra, CXM_PATHW) > 0 && cxm_reali(b, rb, CXM_PATHW) > 0 && cxm_eq(ra, rb)) return 1;
    return 0;
