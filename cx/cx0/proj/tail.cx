int cxm_count(void) { return cxm_funit ? cxm_rootn : cxm_n; }
void cxm_set_funit(int v) { cxm_funit = v ? 1 : 0; }
/* the source the driver compiles for unit u: the renamed body when a symbol-level use rewrote it */
char *cxm_unit_path(int u) { return cxm_bodysrc[u][0] ? cxm_bodysrc[u] : cxm_arg[u]; }
int cxm_include_count(int u) { return cxm_ninc[u]; }
int cxm_wants_plan(void) { return cxm_wantplan; }
int cxm_wants_interface(void) { return cxm_wantif; }
void cxm_set_on(int v) { cxm_on = v; }
int cxm_on_now(void) { return cxm_on; }
