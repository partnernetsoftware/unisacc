
static int (*cxm_rdi)(char *, char *, int);
static int (*cxm_wri)(char *, char *, int);
static int (*cxm_sayi)(int, char *, int);
static void (*cxm_shai)(char *, int, char *);
static char cxm_tmpdir[CXM_PATHW];

int cxm_bind(int (*rd)(char *, char *, int), int (*wr)(char *, char *, int), int (*say)(int, char *, int), void (*sha)(char *, int, char *), char *tmpdir) {
    int k;
    if (!rd || !wr || !say || !sha || !tmpdir || !tmpdir[0]) return 1;
    cxm_rdi = rd; cxm_wri = wr; cxm_sayi = say; cxm_shai = sha;
    k = 0; while (tmpdir[k] && k < CXM_PATHW - 1) { cxm_tmpdir[k] = tmpdir[k]; k = k + 1; }
    cxm_tmpdir[k] = 0;
    if (tmpdir[k]) return 1;
    return 0;
}
/* Optional: REAL(path, dst, cap) writes the canonical absolute path and returns its length (> 0),
   or a value <= 0 when it cannot. Without it module identity is the lexically normalised text. */
static int (*cxm_reali)(const char *, char *, int);
void cxm_bind_real(int (*real)(const char *, char *, int)) { cxm_reali = real; }
static int cxm_rd(char *path, char *buf, int cap) { return cxm_rdi(path, buf, cap); }
static int cxm_wr(char *path, char *buf, int n) { return cxm_wri(path, buf, n); }
static int cxm_say(int fd, char *s, int n) { return cxm_sayi(fd, s, n); }
static void cxm_digest(char *p, int n, char *hex) { cxm_shai(p, n, hex); }
