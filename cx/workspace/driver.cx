#pragma unisa module driver
#pragma unisa use mem.heap
#pragma unisa use sys.time
/* Invocation-owned graph. POSIX, sequential scheduling, no result cache. */
typedef struct {char *p;size_t n;} CxwText;
typedef struct {char *id,*source,*artifact,*recipe,*extra[4];int nextra,seconds,mark,selected;char build[65],interface_key[65],assembly[65],digest[65];} CxwPackage;
typedef struct {int owner,tree;char *role,*name,*path,*snapshot;size_t snapshot_bytes;char digest[65];} CxwInput;
typedef struct {int owner,dependency;char *kind;} CxwEdge;
typedef struct {int owner;char *id,*source;int seconds;} CxwTest;
typedef struct {CxwPackage packages[32];CxwInput inputs[256];CxwEdge edges[128];CxwTest tests[64];int np,ni,ne,nt,order[32],no;char root[4096],out[4096],compiler[65],watchdog[65];long long deadline;char *text;} CxwState;
static void cxw_die(const char *why,const char *detail){fprintf(stderr,"cx-workspace: %s: %s errno=%d\n",why,detail?detail:"-",errno);exit(2);}
static long long cxw_now(void){
 long stamp[2]={0,0};sy_ts_t t;
 if(sy_mono(&t))cxw_die("monotonic-clock",0);stamp[0]=t.sec;stamp[1]=t.nsec;
 if(stamp[0]<0||stamp[1]<0||stamp[1]>=1000000000L)cxw_die("monotonic-clock-range",0);return (long long)stamp[0]*1000000000LL+stamp[1];
}
static int cxw_budget(CxwState *s,int requested){long long remaining=s->deadline-cxw_now()-2000000000LL;if(remaining<1000000000LL)cxw_die("total-budget-exhausted-partial-prepared-only",0);int seconds=(int)(remaining/1000000000LL);return requested<seconds?requested:seconds;}
static void cxw_put(CxwText *b,const char *s){size_t n=strlen(s);if(n>8388608-b->n)cxw_die("record-bound",0);char *p=realloc(b->p,b->n+n+1);if(!p)cxw_die("allocation",0);b->p=p;{void *cx_kept=memcpy(p+b->n,s,n+1);(void)cx_kept;}b->n+=n;}
static void cxw_row(CxwText *b,const char *a,const char *c){cxw_put(b,a);cxw_put(b,"\t");cxw_put(b,c);cxw_put(b,"\n");}
static int cxw_safe(const char *p){if(!*p||*p=='/'||strstr(p,"..")||strchr(p,'\\'))return 0;for(;*p;p++)if(!((*p>='a'&&*p<='z')||(*p>='A'&&*p<='Z')||(*p>='0'&&*p<='9')||strchr("/_-.",*p)))return 0;return 1;}
static void cxw_path(char *out,const char *base,const char *name){int n=snprintf(out,4400,"%s/%s",base,name);if(n<0||n>=4400)cxw_die("path-bound",name);}
/* N is a snprintf result into CAP bytes; a truncated name would alias another package's file. */
static void cxw_fit(int n,size_t cap,const char *why,const char *detail){if(n<0||(size_t)n>=cap)cxw_die(why,detail);}
static char *cxw_read(const char *p,size_t *n){struct stat a,b;errno=0;if(stat(p,&a))cxw_die(errno==ENOENT?"missing-input":"input-stat",p);if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>67108864)cxw_die("bounded-regular-input",p);int fd=open(p,O_RDONLY|O_NONBLOCK);if(fd<0)cxw_die("input-open",p);if(fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)cxw_die("input-open-identity",p);*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)cxw_die("allocation",p);size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)cxw_die("input-read",p);at+=(size_t)z;}char tail;ssize_t z=read(fd,&tail,1);int bad=z||fstat(fd,&b)||a.st_size!=b.st_size;if(close(fd))bad=1;if(bad)cxw_die("input-changed-or-close",p);s[*n]=0;return s;}
static void cxw_hash(const char *p,char hash[65]){size_t n;char *s=cxw_read(p,&n);cx_sha256_hex(s,n,hash);mm_free(s);}
static void cxw_watchdog(char out[65]){char hashes[130];cxw_hash("tools/bound",hashes);cxw_hash("tools/bound.c",hashes+65);cx_sha256_hex(hashes,sizeof hashes,out);}
static int cxw_find(CxwState *s,const char *id){for(int i=0;i<s->np;i++)if(!strcmp(s->packages[i].id,id))return i;cxw_die("missing-package",id);return -1;}
static int cxw_seconds(const char *p){char *end;long n=strtol(p,&end,10);if(!*p||*end||n<1||n>55)cxw_die("seconds-1-to-55",p);return (int)n;}
static int cxw_input(CxwState *s,int pkg,const char *path){for(int i=0;i<s->ni;i++)if(s->inputs[i].owner==pkg&&!strcmp(s->inputs[i].path,path))return 1;return 0;}
static void cxw_load(CxwState *s,const char *manifest){size_t n;s->text=cxw_read(manifest,&n);if(n>1048576||memchr(s->text,0,n))cxw_die("manifest-shape",manifest);char *line=s->text;int first=1;while(*line){char *end=strchr(line,'\n');if(!end)cxw_die("manifest-final-newline",manifest);*end=0;if(*line&&*line!='#'){char *v[8];int k=0;v[k++]=line;for(char *p=line;*p;p++)if(*p=='\t'){*p=0;if(k==8)cxw_die("manifest-fields",0);v[k++]=p+1;}if(first){if(k!=1||strcmp(v[0],"CXWORK1"))cxw_die("manifest-version",line);first=0;}else if(!strcmp(v[0],"P")){if(k!=6||s->np==32||!cxw_safe(v[1])||strchr(v[1],'/')||!cxw_safe(v[2])||!cxw_safe(v[3])||strchr(v[3],'/')||(strcmp(v[4],"unisacc")&&strcmp(v[4],"unisacc-O2-full")))cxw_die("package-fields",v[1]);for(int i=0;i<s->np;i++)if(!strcmp(s->packages[i].id,v[1])||!strcmp(s->packages[i].source,v[2])||!strcmp(s->packages[i].artifact,v[3]))cxw_die("duplicate-package-source-or-artifact",v[1]);CxwPackage *p=&s->packages[s->np++];p->id=v[1];p->source=v[2];p->artifact=v[3];p->recipe=v[4];p->seconds=cxw_seconds(v[5]);}else if(!strcmp(v[0],"I")||!strcmp(v[0],"G")){if(k!=5||s->ni==256||(strcmp(v[2],"implementation")&&strcmp(v[2],"interface")&&strcmp(v[2],"test"))||!cxw_safe(v[3])||!cxw_safe(v[4]))cxw_die("input-fields",v[1]);CxwInput *p=&s->inputs[s->ni++];p->owner=cxw_find(s,v[1]);p->role=v[2];p->name=v[3];p->path=v[4];p->tree=v[0][0]=='G';for(int i=0;i<s->ni-1;i++)if(p->owner==s->inputs[i].owner&&(!strcmp(p->name,s->inputs[i].name)||!strcmp(p->path,s->inputs[i].path)))cxw_die("duplicate-input",p->name);}else if(!strcmp(v[0],"C")){if(k!=3||!cxw_safe(v[2]))cxw_die("compile-input-fields",v[1]);CxwPackage *p=&s->packages[cxw_find(s,v[1])];if(p->nextra==4)cxw_die("compile-input-bound",v[1]);p->extra[p->nextra++]=v[2];}else if(!strcmp(v[0],"D")){if(k!=4||s->ne==128||(strcmp(v[2],"normal")&&strcmp(v[2],"build")))cxw_die("dependency-fields",v[1]);CxwEdge *p=&s->edges[s->ne++];p->owner=cxw_find(s,v[1]);p->kind=v[2];p->dependency=cxw_find(s,v[3]);for(int i=0;i<s->ne-1;i++)if(p->owner==s->edges[i].owner&&p->dependency==s->edges[i].dependency)cxw_die("duplicate-edge",v[1]);}else if(!strcmp(v[0],"T")){if(k!=5||s->nt==64||!cxw_safe(v[2])||!cxw_safe(v[3]))cxw_die("test-fields",v[1]);CxwTest *p=&s->tests[s->nt++];p->owner=cxw_find(s,v[1]);p->id=v[2];p->source=v[3];p->seconds=cxw_seconds(v[4]);for(int i=0;i<s->nt-1;i++)if(p->owner==s->tests[i].owner&&!strcmp(p->id,s->tests[i].id))cxw_die("duplicate-test",p->id);}else cxw_die("unknown-row",v[0]);}line=end+1;}if(first||!s->np)cxw_die("empty-workspace",0);for(int i=0;i<s->np;i++)if(!cxw_input(s,i,s->packages[i].source))cxw_die("undeclared-package-source",s->packages[i].source);}
static void cxw_visit(CxwState *s,int id){CxwPackage *p=&s->packages[id];if(p->mark==1)cxw_die("dependency-cycle",p->id);if(p->mark==2)return;p->mark=1;for(int i=0;i<s->ne;i++)if(s->edges[i].owner==id)cxw_visit(s,s->edges[i].dependency);p->mark=2;s->order[s->no++]=id;}
static void cxw_select(CxwState *s,int id){if(s->packages[id].selected)return;s->packages[id].selected=1;for(int i=0;i<s->ne;i++)if(s->edges[i].owner==id)cxw_select(s,s->edges[i].dependency);}
/* Descriptor-relative snapshots reject every symlink below the current cwd.
 * Names and file bytes enter the manifest; timestamps never substitute hashes. */
typedef struct {CxwState *state;CxwText text;size_t bytes;int entries,files;} CxwTree;
static int cxw_openat(int parent,const char *name,int flags){
#if defined(__UNISA__) && defined(__linux__) && defined(__x86_64__)
 return (int)_unisa_ret(__syscall6(257,parent,(long)name,flags,0,0));
#else
 extern int openat(int,const char *,int,...);return openat(parent,name,flags,0);
#endif
}
static int cxw_namecmp(const void *a,const void *b){return strcmp(*(char *const *)a,*(char *const *)b);}
static void cxw_tree_name(const char *name){if(!*name)cxw_die("directory-empty-name",0);for(const unsigned char *p=(const unsigned char *)name;*p;p++)if(*p<32||*p==127||*p=='/')cxw_die("directory-name-unrepresentable",name);}
static void cxw_tree_walk(CxwTree *t,int fd,const char *relative,int depth){
 if(depth>16)cxw_die("directory-depth-bound",relative);cxw_budget(t->state,1);DIR *dir=fdopendir(fd);if(!dir){close(fd);cxw_die("directory-stream",relative);}
 char **names=calloc(8192,sizeof *names);if(!names)cxw_die("allocation",0);int count=0;
 for(;;){errno=0;struct dirent *entry=readdir(dir);if(!entry){if(errno)cxw_die("directory-enumerate",relative);break;}if(!strcmp(entry->d_name,".")||!strcmp(entry->d_name,".."))continue;cxw_tree_name(entry->d_name);if(++t->entries>8192||count==8192)cxw_die("directory-entry-bound",relative);names[count]=strdup(entry->d_name);if(!names[count++])cxw_die("allocation",0);}
 qsort(names,(size_t)count,sizeof *names,cxw_namecmp);cxw_row(&t->text,"D",*relative?relative:".");
 for(int i=0;i<count;i++){
  cxw_budget(t->state,1);char child[4400];if(*relative)cxw_path(child,relative,names[i]);else cxw_fit(snprintf(child,sizeof child,"%s",names[i]),sizeof child,"path-bound",names[i]);
  struct stat a,b;if(fstatat(fd,names[i],&a,AT_SYMLINK_NOFOLLOW))cxw_die(errno==ENOENT?"directory-member-disappeared":"directory-member-stat",child);
  if(S_ISLNK(a.st_mode))cxw_die("directory-symlink-refused",child);
  if(S_ISDIR(a.st_mode)){int next=cxw_openat(fd,names[i],O_RDONLY|O_DIRECTORY|O_NOFOLLOW);if(next<0||fstat(next,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino)cxw_die("directory-member-open",child);cxw_tree_walk(t,next,child,depth+1);}
  else{
   if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>67108864||++t->files>4096||(size_t)a.st_size>67108864-t->bytes)cxw_die("directory-file-or-byte-bound",child);t->bytes+=(size_t)a.st_size;
   int input=cxw_openat(fd,names[i],O_RDONLY|O_NOFOLLOW|O_NONBLOCK);if(input<0)cxw_die("directory-file-open",child);if(fstat(input,&b)||!S_ISREG(b.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)cxw_die("directory-file-open-identity",child);
   size_t n=(size_t)a.st_size,at=0;char *bytes=malloc(n?n:1);if(!bytes)cxw_die("allocation",0);
   while(at<n){cxw_budget(t->state,1);size_t want=n-at;if(want>65536)want=65536;ssize_t got=read(input,bytes+at,want);if(got<0&&errno==EINTR)continue;if(got<=0)cxw_die("directory-file-read",child);at+=(size_t)got;}
   char extra;ssize_t got;do{got=read(input,&extra,1);}while(got<0&&errno==EINTR);int bad=got||fstat(input,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;if(close(input))bad=1;if(bad)cxw_die("directory-file-changed-or-close",child);
   char hash[65],extent[40];cx_sha256_hex(bytes,n,hash);mm_free(bytes);cxw_fit(snprintf(extent,sizeof extent,"%zu",n),sizeof extent,"extent-bound",child);cxw_put(&t->text,"F\t");cxw_put(&t->text,child);cxw_put(&t->text,"\t");cxw_put(&t->text,extent);cxw_put(&t->text,"\t");cxw_put(&t->text,hash);cxw_put(&t->text,"\n");
  }
  mm_free(names[i]);if(t->text.n>1048576)cxw_die("directory-manifest-bound",relative);
 }
 mm_free(names);if(closedir(dir))cxw_die("directory-close",relative);
}
static void cxw_tree_hash(CxwState *s,CxwInput *in,int check,char hash[65]){
 int fd=open(".",O_RDONLY|O_DIRECTORY|O_NOFOLLOW);if(fd<0)cxw_die("workspace-root-directory",s->root);char *path=strdup(in->path);if(!path)cxw_die("allocation",0);char *part=path;int depth=0;
 for(;;){char *slash=strchr(part,'/');if(slash)*slash=0;if(!*part||!strcmp(part,".")||!strcmp(part,"..")||++depth>16)cxw_die("directory-root-components",in->path);int next=cxw_openat(fd,part,O_RDONLY|O_DIRECTORY|O_NOFOLLOW);int saved=errno;if(close(fd))cxw_die("directory-root-close",in->path);errno=saved;if(next<0)cxw_die(errno==ENOENT?"missing-directory-input":"directory-root-open",in->path);fd=next;if(!slash)break;part=slash+1;}
 mm_free(path);CxwTree tree={0};tree.state=s;cxw_put(&tree.text,"CXWORKTREE1\n");cxw_tree_walk(&tree,fd,"",0);cx_sha256_hex(tree.text.p,tree.text.n,hash);
 if(check){if(tree.text.n!=in->snapshot_bytes||memcmp(tree.text.p,in->snapshot,tree.text.n))cxw_die("directory-input-changed",in->name);mm_free(tree.text.p);}else{mm_free(in->snapshot);in->snapshot=tree.text.p;in->snapshot_bytes=tree.text.n;}
}
static void cxw_input_hash(CxwState *s,CxwInput *in,int check,char hash[65]){if(in->tree)cxw_tree_hash(s,in,check,hash);else{char path[4400];cxw_path(path,s->root,in->path);cxw_hash(path,hash);}}
static void cxw_dispose(CxwState *s){for(int i=0;i<s->ni;i++)mm_free(s->inputs[i].snapshot);mm_free(s->text);mm_free(s);}
static void cxw_observe(CxwState *s,int id,const char *target,int check){CxwPackage *p=&s->packages[id];CxwText key={0},api={0};cxw_row(&key,"schema","cx-workspace-build-v1");cxw_row(&key,"package",p->id);cxw_row(&key,"workspace-root",s->root);cxw_row(&key,"source",p->source);cxw_row(&key,"artifact",p->artifact);for(int i=0;i<p->nextra;i++){if(!cxw_input(s,id,p->extra[i]))cxw_die("undeclared-compile-input",p->extra[i]);cxw_row(&key,"compile-input",p->extra[i]);}cxw_row(&key,"target",target);cxw_row(&key,"compiler",s->compiler);cxw_row(&key,"watchdog",s->watchdog);cxw_row(&key,"recipe-flags",p->recipe);cxw_row(&key,"recipe","sh unisacc.com SOURCE -b TARGET -o ARTIFACT");cxw_row(&api,"abi","unisa-c99-v1");cxw_row(&api,"target",target);for(int i=0;i<s->ni;i++)if(s->inputs[i].owner==id&&strcmp(s->inputs[i].role,"test")){cxw_budget(s,1);CxwInput *in=&s->inputs[i];char hash[65];cxw_input_hash(s,in,check,hash);if(check&&strcmp(hash,in->digest))cxw_die("input-changed-during-build",in->name);if(!check)memcpy(in->digest,hash,sizeof in->digest);cxw_row(&key,in->tree?"directory":"file",in->name);cxw_row(&key,in->role,in->name);cxw_row(&key,in->path,hash);if(!strcmp(in->role,"interface")){cxw_row(&api,in->name,hash);}}for(int i=0;i<s->ne;i++)if(s->edges[i].owner==id){CxwPackage *dep=&s->packages[s->edges[i].dependency];cxw_row(&key,s->edges[i].kind,dep->id);cxw_row(&key,"dependency-build",dep->build);}char h[65];cx_sha256_hex(key.p,key.n,h);if(check&&strcmp(h,p->build))cxw_die("build-key-changed",p->id);if(!check){memcpy(p->build,h,sizeof p->build);cx_sha256_hex(api.p,api.n,p->interface_key);}mm_free(key.p);mm_free(api.p);}
static void cxw_publish(const char *path,const char *bytes,size_t n){int fd=open(path,O_CREAT|O_EXCL|O_WRONLY,0600);if(fd<0)cxw_die("exclusive-output",path);size_t at=0;while(at<n){ssize_t z=write(fd,bytes+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)cxw_die("output-write",path);at+=(size_t)z;}if(fsync(fd)||close(fd))cxw_die("output-sync-close",path);}
static int cxw_run(CxwState *s,char **v,int seconds,const char *log){seconds=cxw_budget(s,seconds);char nseconds[16];cxw_fit(snprintf(nseconds,sizeof nseconds,"%d",seconds),sizeof nseconds,"seconds-bound",0);char *bounded[32]={"./tools/bound",nseconds};int k=0;while(v[k]){if(k==29)cxw_die("child-argument-bound",0);bounded[k+2]=v[k];k++;}bounded[k+2]=0;char *out=0;size_t n=0;int rc=cx_runv_timeout(bounded,seconds+2,&out,&n);if(out){if(n>67108864)cxw_die("subprocess-output-bound",log);cxw_publish(log,out,n);mm_free(out);}cxw_budget(s,1);return rc;}
static void cxw_artifact(CxwState *s,int id){char path[4400];cxw_path(path,s->out,s->packages[id].artifact);cxw_hash(path,s->packages[id].digest);}
static void cxw_build(CxwState *s,int id,const char *target){CxwPackage *p=&s->packages[id];char path[4400],log[4400],name[100],artifact_pending[4400],artifact_final[4400];cxw_path(artifact_final,s->out,p->artifact);int pn=snprintf(name,sizeof name,"%s.pending.%ld",p->artifact,(long)getpid());if(pn<0||(size_t)pn>=sizeof name)cxw_die("artifact-name-bound",p->artifact);cxw_path(artifact_pending,s->out,name);memcpy(path,artifact_pending,sizeof path);cxw_fit(snprintf(name,sizeof name,"%s.build.%ld.stdout",p->id,(long)getpid()),sizeof name,"log-name-bound",p->id);cxw_path(log,s->out,name);char *v[16]={"sh","./unisacc.com",p->source};int at=3;if(!strcmp(p->recipe,"unisacc-O2-full")){v[at++]="-O2";v[at++]="-fno-trim-libc";}for(int i=0;i<p->nextra;i++)v[at++]=p->extra[i];v[at++]="-b";v[at++]=(char *)target;v[at++]="-o";v[at++]=path;v[at]=0;int rc=cxw_run(s,v,p->seconds,log);if(rc){if(unlink(path)&&errno!=ENOENT)cxw_die("failed-artifact-unlink",path);cxw_die(rc==124?"build-timeout":"build-failed",p->id);}cxw_observe(s,id,target,1);char compiler[65];cxw_hash("unisacc.com",compiler);if(strcmp(compiler,s->compiler))cxw_die("compiler-changed",0);cxw_watchdog(compiler);if(strcmp(compiler,s->watchdog))cxw_die("watchdog-changed",0);cxw_budget(s,1);cxw_hash(artifact_pending,p->digest);CxwText assembly={0},receipt={0};cxw_row(&assembly,"build",p->build);for(int i=0;i<s->ne;i++)if(s->edges[i].owner==id){CxwPackage *d=&s->packages[s->edges[i].dependency];cxw_row(&assembly,d->id,d->digest);}cx_sha256_hex(assembly.p,assembly.n,p->assembly);mm_free(assembly.p);cxw_put(&receipt,"CXWORKART1\n");cxw_row(&receipt,"status","PREPARED-no-test-result");cxw_row(&receipt,"timing","compile/load/run/validation-UNMEASURED");cxw_row(&receipt,"cache","disabled");cxw_row(&receipt,"package",p->id);cxw_row(&receipt,"target",target);cxw_row(&receipt,"build",p->build);cxw_row(&receipt,"interface",p->interface_key);cxw_row(&receipt,"assembly",p->assembly);cxw_row(&receipt,"artifact",p->artifact);cxw_row(&receipt,"sha256",p->digest);for(int i=0;i<s->ni;i++)if(s->inputs[i].owner==id&&strcmp(s->inputs[i].role,"test")){CxwInput *in=&s->inputs[i];cxw_row(&receipt,in->name,in->digest);if(in->tree){cxw_row(&receipt,"tree-name",in->name);cxw_row(&receipt,"tree-root",in->path);cxw_put(&receipt,in->snapshot);}}cxw_fit(snprintf(name,sizeof name,"%s.receipt",p->id),sizeof name,"receipt-name-bound",p->id);cxw_path(path,s->out,name);char receipt_pending[4400];int rn=snprintf(receipt_pending,sizeof receipt_pending,"%s.pending",path);if(rn<0||(size_t)rn>=sizeof receipt_pending)cxw_die("receipt-path-bound",path);cxw_publish(receipt_pending,receipt.p,receipt.n);if(rename(artifact_pending,artifact_final))cxw_die("artifact-publish",artifact_final);if(rename(receipt_pending,path)){if(unlink(artifact_final))cxw_die("failed-artifact-unlink",artifact_final);cxw_die("receipt-publish",path);}mm_free(receipt.p);printf("PREPARED\t%s\t%s\t%s\n",p->id,p->build,p->digest);}
static int cxw_prepared(CxwState *s,int id,const char *target){
 CxwPackage *p=&s->packages[id];char artifact[4400],receipt[4400],name[100],needle[160];struct stat st;
 cxw_budget(s,1);cxw_path(artifact,s->out,p->artifact);cxw_fit(snprintf(name,sizeof name,"%s.receipt",p->id),sizeof name,"receipt-name-bound",p->id);cxw_path(receipt,s->out,name);
 errno=0;int have_artifact=!stat(artifact,&st);if(!have_artifact&&errno!=ENOENT)cxw_die("resume-artifact-stat",artifact);
 errno=0;int have_receipt=!stat(receipt,&st);if(!have_receipt&&errno!=ENOENT)cxw_die("resume-receipt-stat",receipt);
 if(!have_artifact&&!have_receipt)return 0;if(!have_artifact||!have_receipt)cxw_die("partial-package-without-committed-pair",p->id);
 size_t n;char *text=cxw_read(receipt,&n);if(n>8388608||memchr(text,0,n)||strncmp(text,"CXWORKART1\n",11))cxw_die("resume-receipt-shape",p->id);
 cxw_fit(snprintf(needle,sizeof needle,"build\t%s\n",p->build),sizeof needle,"needle-bound",p->id);if(!strstr(text,needle))cxw_die("stale-build-receipt",p->id);
 cxw_artifact(s,id);cxw_fit(snprintf(needle,sizeof needle,"sha256\t%s\n",p->digest),sizeof needle,"needle-bound",p->id);if(!strstr(text,needle))cxw_die("artifact-digest-mismatch",p->id);
 CxwText assembly={0};cxw_row(&assembly,"build",p->build);for(int i=0;i<s->ne;i++)if(s->edges[i].owner==id){CxwPackage *d=&s->packages[s->edges[i].dependency];cxw_row(&assembly,d->id,d->digest);}cx_sha256_hex(assembly.p,assembly.n,p->assembly);mm_free(assembly.p);
 cxw_fit(snprintf(needle,sizeof needle,"assembly\t%s\n",p->assembly),sizeof needle,"needle-bound",p->id);if(!strstr(text,needle))cxw_die("stale-assembly-receipt",p->id);mm_free(text);cxw_observe(s,id,target,1);cxw_budget(s,1);return 1;
}
int cxw_main(int argc,char **argv){
 if(argc<5|| (strcmp(argv[1],"plan")&&strcmp(argv[1],"build")&&strcmp(argv[1],"resume")&&strcmp(argv[1],"test")))cxw_die("usage","plan|build|resume MANIFEST OUT TARGET [PACKAGE] | test MANIFEST OUT TARGET PACKAGE TEST -- ARGS...");
 CxwState *s=calloc(1,sizeof *s);if(!s)cxw_die("allocation",0);s->deadline=cxw_now()+50000000000LL;if(!getcwd(s->root,sizeof s->root))cxw_die("root",0);if(strcmp(argv[4],"lnx/x86_64"))cxw_die("unsupported-workspace-target",argv[4]);cxw_load(s,argv[2]);for(int i=0;i<s->np;i++)cxw_visit(s,i);if(argc>5)cxw_select(s,cxw_find(s,argv[5]));else for(int i=0;i<s->np;i++)s->packages[i].selected=1;cxw_hash("unisacc.com",s->compiler);cxw_watchdog(s->watchdog);
 if(argv[3][0]=='/')cxw_fit(snprintf(s->out,sizeof s->out,"%s",argv[3]),sizeof s->out,"output-path-bound",0);else{int n=snprintf(s->out,sizeof s->out,"%s/%s",s->root,argv[3]);if(n<0||(size_t)n>=sizeof s->out)cxw_die("output-path-bound",0);}
 for(int k=0;k<s->no;k++){int id=s->order[k];if(s->packages[id].selected)cxw_observe(s,id,argv[4],0);}
 if(!strcmp(argv[1],"plan")){if(argc>6)cxw_die("plan-arguments",0);for(int k=0;k<s->no;k++){CxwPackage *p=&s->packages[s->order[k]];if(p->selected)printf("PLAN\t%s\t%s\t%s\t%s\n",p->id,p->source,p->artifact,p->build);}printf("SCHEDULER\tsequential\tmax-child-seconds=55\ttotal-seconds=50\tcache=disabled\tno-test-result\n");}
 else if(!strcmp(argv[1],"build")||!strcmp(argv[1],"resume")){if(argc>6)cxw_die("build-arguments",0);int resume=!strcmp(argv[1],"resume");if(!resume){if(mkdir(s->out,0700))cxw_die("exclusive-build-directory",s->out);}else{struct stat st;if(stat(s->out,&st)||!S_ISDIR(st.st_mode))cxw_die("resume-directory",s->out);}for(int k=0;k<s->no;k++)if(s->packages[s->order[k]].selected){int id=s->order[k];if(resume&&cxw_prepared(s,id,argv[4])){printf("REVERIFIED_PREPARED\t%s\tno-test-result\n",s->packages[id].id);}else cxw_build(s,id,argv[4]);}}
 else{if(argc<8||strcmp(argv[7],"--"))cxw_die("test-arguments",0);int id=cxw_find(s,argv[5]),found=-1;for(int i=0;i<s->nt;i++)if(s->tests[i].owner==id&&!strcmp(s->tests[i].id,argv[6]))found=i;if(found<0)cxw_die("undeclared-test",argv[6]);CxwTest *t=&s->tests[found];for(int k=0;k<s->no;k++)if(s->packages[s->order[k]].selected)cxw_artifact(s,s->order[k]);char source_hash[65];cxw_hash(t->source,source_hash);CxwText evidence={0};cxw_row(&evidence,"package",argv[5]);cxw_row(&evidence,"test",t->id);cxw_row(&evidence,"source-path",t->source);cxw_row(&evidence,"target",argv[4]);cxw_row(&evidence,"test-source",source_hash);cxw_row(&evidence,"compiler",s->compiler);cxw_row(&evidence,"watchdog",s->watchdog);cxw_row(&evidence,"artifact",s->packages[id].digest);for(int k=0;k<s->no;k++)if(s->packages[s->order[k]].selected){CxwPackage *p=&s->packages[s->order[k]];cxw_row(&evidence,p->id,p->digest);char rp[4400],rn[100];cxw_fit(snprintf(rn,sizeof rn,"%s.receipt",p->id),sizeof rn,"receipt-name-bound",p->id);cxw_path(rp,s->out,rn);size_t z;char *r=cxw_read(rp,&z),needle[100];cxw_fit(snprintf(needle,sizeof needle,"build\t%s\n",p->build),sizeof needle,"needle-bound",p->id);if(!strstr(r,needle))cxw_die("stale-build-receipt",p->id);cxw_fit(snprintf(needle,sizeof needle,"sha256\t%s\n",p->digest),sizeof needle,"needle-bound",p->id);if(!strstr(r,needle))cxw_die("artifact-digest-mismatch",p->id);mm_free(r);}for(int i=0;i<s->ni;i++)if(s->packages[s->inputs[i].owner].selected&&!strcmp(s->inputs[i].role,"test")){char h[65];cxw_input_hash(s,&s->inputs[i],0,h);memcpy(s->inputs[i].digest,h,sizeof s->inputs[i].digest);cxw_row(&evidence,s->inputs[i].name,h);}char (*arg_hash)[65]=calloc((size_t)argc,65);if(!arg_hash)cxw_die("allocation",0);for(int i=8;i<argc;i++){cxw_row(&evidence,"argv",argv[i]);struct stat a;errno=0;if(!stat(argv[i],&a)){if(S_ISREG(a.st_mode)){cxw_hash(argv[i],arg_hash[i]);cxw_row(&evidence,"argv-file-sha256",arg_hash[i]);}}else if(errno!=ENOENT)cxw_die("argument-resource-stat",argv[i]);}char key[65];cx_sha256_hex(evidence.p,evidence.n,key);mm_free(evidence.p);char path[4400],name[150];cxw_fit(snprintf(name,sizeof name,"%s-%s-%ld.stdout",argv[5],argv[6],(long)getpid()),sizeof name,"log-name-bound",argv[6]);cxw_path(path,s->out,name);char **v=calloc((size_t)argc+4,sizeof *v);if(!v)cxw_die("allocation",0);v[0]="sh";v[1]="./unisacc.com";v[2]=t->source;v[3]="--";for(int i=8;i<argc;i++)v[i-4]=argv[i];int rc=cxw_run(s,v,t->seconds,path);mm_free(v);char after[65];cxw_hash(t->source,after);if(strcmp(source_hash,after))cxw_die("test-source-changed",t->source);for(int i=8;i<argc;i++)if(arg_hash[i][0]){cxw_hash(argv[i],after);if(strcmp(after,arg_hash[i]))cxw_die("argument-resource-changed",argv[i]);}mm_free(arg_hash);for(int i=0;i<s->ni;i++)if(s->packages[s->inputs[i].owner].selected&&!strcmp(s->inputs[i].role,"test")){cxw_input_hash(s,&s->inputs[i],1,after);if(strcmp(after,s->inputs[i].digest))cxw_die("test-input-changed",s->inputs[i].name);}for(int k=0;k<s->no;k++)if(s->packages[s->order[k]].selected){CxwPackage *p=&s->packages[s->order[k]];char prior[65];memcpy(prior,p->digest,sizeof prior);cxw_artifact(s,s->order[k]);if(strcmp(prior,p->digest))cxw_die("artifact-changed-during-test",p->id);cxw_observe(s,s->order[k],argv[4],1);}cxw_hash("unisacc.com",after);if(strcmp(after,s->compiler))cxw_die("compiler-changed-during-test",0);cxw_watchdog(after);if(strcmp(after,s->watchdog))cxw_die("watchdog-changed-during-test",0);cxw_budget(s,1);printf("EXECUTED\t%s\t%s\trc=%d\ttest-key=%s\tstdout=%s\n",argv[5],argv[6],rc,key,path);cxw_dispose(s);return rc<0?2:rc;}
 char final_identity[65];cxw_hash("unisacc.com",final_identity);if(strcmp(final_identity,s->compiler))cxw_die("compiler-changed",0);cxw_watchdog(final_identity);if(strcmp(final_identity,s->watchdog))cxw_die("watchdog-changed",0);cxw_budget(s,1);cxw_dispose(s);return 0;
}
