#pragma unisa module driver
/* Invocation-owned graph. POSIX, sequential scheduling, no result cache. */
typedef struct {char *p;size_t n;} CxwText;
typedef struct {char *id,*source,*artifact,*extra[4];int nextra,seconds,mark,selected;char build[65],interface_key[65],assembly[65],digest[65];} CxwPackage;
typedef struct {int owner;char *role,*name,*path;char digest[65];} CxwInput;
typedef struct {int owner,dependency;char *kind;} CxwEdge;
typedef struct {int owner;char *id,*source;int seconds;} CxwTest;
typedef struct {CxwPackage packages[32];CxwInput inputs[256];CxwEdge edges[128];CxwTest tests[64];int np,ni,ne,nt,order[32],no;char root[4096],out[4096],compiler[65];char *text;} CxwState;
static void cxw_die(const char *why,const char *detail){fprintf(stderr,"cx-workspace: %s: %s errno=%d\n",why,detail?detail:"-",errno);exit(2);}
static void cxw_put(CxwText *b,const char *s){size_t n=strlen(s);if(n>8388608-b->n)cxw_die("record-bound",0);char *p=realloc(b->p,b->n+n+1);if(!p)cxw_die("allocation",0);b->p=p;memcpy(p+b->n,s,n+1);b->n+=n;}
static void cxw_row(CxwText *b,const char *a,const char *c){cxw_put(b,a);cxw_put(b,"\t");cxw_put(b,c);cxw_put(b,"\n");}
static int cxw_safe(const char *p){if(!*p||*p=='/'||strstr(p,"..")||strchr(p,'\\'))return 0;for(;*p;p++)if(!((*p>='a'&&*p<='z')||(*p>='A'&&*p<='Z')||(*p>='0'&&*p<='9')||strchr("/_-.",*p)))return 0;return 1;}
static void cxw_path(char *out,const char *base,const char *name){int n=snprintf(out,4400,"%s/%s",base,name);if(n<0||n>=4400)cxw_die("path-bound",name);}
static char *cxw_read(const char *p,size_t *n){struct stat a,b;errno=0;if(stat(p,&a))cxw_die(errno==ENOENT?"missing-input":"input-stat",p);if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>67108864)cxw_die("bounded-regular-input",p);int fd=open(p,O_RDONLY|O_NONBLOCK);if(fd<0)cxw_die("input-open",p);if(fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)cxw_die("input-open-identity",p);*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)cxw_die("allocation",p);size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)cxw_die("input-read",p);at+=(size_t)z;}char tail;ssize_t z=read(fd,&tail,1);int bad=z||fstat(fd,&b)||a.st_size!=b.st_size;if(close(fd))bad=1;if(bad)cxw_die("input-changed-or-close",p);s[*n]=0;return s;}
static void cxw_hash(const char *p,char hash[65]){size_t n;char *s=cxw_read(p,&n);cx_sha256_hex(s,n,hash);free(s);}
static int cxw_find(CxwState *s,const char *id){for(int i=0;i<s->np;i++)if(!strcmp(s->packages[i].id,id))return i;cxw_die("missing-package",id);return -1;}
static int cxw_seconds(const char *p){char *end;long n=strtol(p,&end,10);if(!*p||*end||n<1||n>55)cxw_die("seconds-1-to-55",p);return (int)n;}
static int cxw_input(CxwState *s,int pkg,const char *path){for(int i=0;i<s->ni;i++)if(s->inputs[i].owner==pkg&&!strcmp(s->inputs[i].path,path))return 1;return 0;}
static void cxw_load(CxwState *s,const char *manifest){size_t n;s->text=cxw_read(manifest,&n);if(n>1048576||memchr(s->text,0,n))cxw_die("manifest-shape",manifest);char *line=s->text;int first=1;while(*line){char *end=strchr(line,'\n');if(!end)cxw_die("manifest-final-newline",manifest);*end=0;if(*line&&*line!='#'){char *v[8];int k=0;v[k++]=line;for(char *p=line;*p;p++)if(*p=='\t'){*p=0;if(k==8)cxw_die("manifest-fields",0);v[k++]=p+1;}if(first){if(k!=1||strcmp(v[0],"CXWORK1"))cxw_die("manifest-version",line);first=0;}else if(!strcmp(v[0],"P")){if(k!=6||s->np==32||!cxw_safe(v[1])||strchr(v[1],'/')||!cxw_safe(v[2])||!cxw_safe(v[3])||strchr(v[3],'/')||strcmp(v[4],"unisacc"))cxw_die("package-fields",v[1]);for(int i=0;i<s->np;i++)if(!strcmp(s->packages[i].id,v[1])||!strcmp(s->packages[i].source,v[2])||!strcmp(s->packages[i].artifact,v[3]))cxw_die("duplicate-package-source-or-artifact",v[1]);CxwPackage *p=&s->packages[s->np++];p->id=v[1];p->source=v[2];p->artifact=v[3];p->seconds=cxw_seconds(v[5]);}else if(!strcmp(v[0],"I")){if(k!=5||s->ni==256||(strcmp(v[2],"implementation")&&strcmp(v[2],"interface")&&strcmp(v[2],"test"))||!cxw_safe(v[3])||!cxw_safe(v[4]))cxw_die("input-fields",v[1]);CxwInput *p=&s->inputs[s->ni++];p->owner=cxw_find(s,v[1]);p->role=v[2];p->name=v[3];p->path=v[4];for(int i=0;i<s->ni-1;i++)if(p->owner==s->inputs[i].owner&&(!strcmp(p->name,s->inputs[i].name)||!strcmp(p->path,s->inputs[i].path)))cxw_die("duplicate-input",p->name);}else if(!strcmp(v[0],"C")){if(k!=3||!cxw_safe(v[2]))cxw_die("compile-input-fields",v[1]);CxwPackage *p=&s->packages[cxw_find(s,v[1])];if(p->nextra==4)cxw_die("compile-input-bound",v[1]);p->extra[p->nextra++]=v[2];}else if(!strcmp(v[0],"D")){if(k!=4||s->ne==128||(strcmp(v[2],"normal")&&strcmp(v[2],"build")))cxw_die("dependency-fields",v[1]);CxwEdge *p=&s->edges[s->ne++];p->owner=cxw_find(s,v[1]);p->kind=v[2];p->dependency=cxw_find(s,v[3]);for(int i=0;i<s->ne-1;i++)if(p->owner==s->edges[i].owner&&p->dependency==s->edges[i].dependency)cxw_die("duplicate-edge",v[1]);}else if(!strcmp(v[0],"T")){if(k!=5||s->nt==64||!cxw_safe(v[2])||!cxw_safe(v[3]))cxw_die("test-fields",v[1]);CxwTest *p=&s->tests[s->nt++];p->owner=cxw_find(s,v[1]);p->id=v[2];p->source=v[3];p->seconds=cxw_seconds(v[4]);for(int i=0;i<s->nt-1;i++)if(p->owner==s->tests[i].owner&&!strcmp(p->id,s->tests[i].id))cxw_die("duplicate-test",p->id);}else cxw_die("unknown-row",v[0]);}line=end+1;}if(first||!s->np)cxw_die("empty-workspace",0);for(int i=0;i<s->np;i++)if(!cxw_input(s,i,s->packages[i].source))cxw_die("undeclared-package-source",s->packages[i].source);}
static void cxw_visit(CxwState *s,int id){CxwPackage *p=&s->packages[id];if(p->mark==1)cxw_die("dependency-cycle",p->id);if(p->mark==2)return;p->mark=1;for(int i=0;i<s->ne;i++)if(s->edges[i].owner==id)cxw_visit(s,s->edges[i].dependency);p->mark=2;s->order[s->no++]=id;}
static void cxw_select(CxwState *s,int id){if(s->packages[id].selected)return;s->packages[id].selected=1;for(int i=0;i<s->ne;i++)if(s->edges[i].owner==id)cxw_select(s,s->edges[i].dependency);}
static void cxw_observe(CxwState *s,int id,const char *target,int check){CxwPackage *p=&s->packages[id];CxwText key={0},api={0};cxw_row(&key,"schema","cx-workspace-build-v1");cxw_row(&key,"package",p->id);cxw_row(&key,"source",p->source);cxw_row(&key,"artifact",p->artifact);for(int i=0;i<p->nextra;i++){if(!cxw_input(s,id,p->extra[i]))cxw_die("undeclared-compile-input",p->extra[i]);cxw_row(&key,"compile-input",p->extra[i]);}cxw_row(&key,"target",target);cxw_row(&key,"compiler",s->compiler);cxw_row(&key,"recipe","sh unisacc.com SOURCE -b TARGET -o ARTIFACT");cxw_row(&api,"abi","unisa-c99-v1");cxw_row(&api,"target",target);for(int i=0;i<s->ni;i++)if(s->inputs[i].owner==id&&strcmp(s->inputs[i].role,"test")){CxwInput *in=&s->inputs[i];char path[4400],hash[65];cxw_path(path,s->root,in->path);cxw_hash(path,hash);if(check&&strcmp(hash,in->digest))cxw_die("input-changed-during-build",in->name);if(!check)strcpy(in->digest,hash);cxw_row(&key,in->role,in->name);cxw_row(&key,in->path,hash);if(!strcmp(in->role,"interface")){cxw_row(&api,in->name,hash);}}for(int i=0;i<s->ne;i++)if(s->edges[i].owner==id){CxwPackage *dep=&s->packages[s->edges[i].dependency];cxw_row(&key,s->edges[i].kind,dep->id);cxw_row(&key,"dependency-build",dep->build);}char h[65];cx_sha256_hex(key.p,key.n,h);if(check&&strcmp(h,p->build))cxw_die("build-key-changed",p->id);if(!check){strcpy(p->build,h);cx_sha256_hex(api.p,api.n,p->interface_key);}free(key.p);free(api.p);}
static void cxw_publish(const char *path,const char *bytes,size_t n){int fd=open(path,O_CREAT|O_EXCL|O_WRONLY,0600);if(fd<0)cxw_die("exclusive-output",path);size_t at=0;while(at<n){ssize_t z=write(fd,bytes+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)cxw_die("output-write",path);at+=(size_t)z;}if(fsync(fd)||close(fd))cxw_die("output-sync-close",path);}
static int cxw_run(char **v,int seconds,const char *log){char *out=0;size_t n=0;int rc=cx_runv_timeout(v,seconds,&out,&n);if(out){if(n>67108864)cxw_die("subprocess-output-bound",log);cxw_publish(log,out,n);free(out);}return rc;}
static void cxw_artifact(CxwState *s,int id){char path[4400];cxw_path(path,s->out,s->packages[id].artifact);cxw_hash(path,s->packages[id].digest);}
static void cxw_build(CxwState *s,int id,const char *target){CxwPackage *p=&s->packages[id];char path[4400],log[4400],name[100],artifact_pending[4400],artifact_final[4400];cxw_path(artifact_final,s->out,p->artifact);int pn=snprintf(name,sizeof name,"%s.pending",p->artifact);if(pn<0||(size_t)pn>=sizeof name)cxw_die("artifact-name-bound",p->artifact);cxw_path(artifact_pending,s->out,name);strcpy(path,artifact_pending);snprintf(name,sizeof name,"%s.build.stdout",p->id);cxw_path(log,s->out,name);char *v[16]={"sh","./unisacc.com",p->source};int at=3;for(int i=0;i<p->nextra;i++)v[at++]=p->extra[i];v[at++]="-b";v[at++]=(char *)target;v[at++]="-o";v[at++]=path;v[at]=0;int rc=cxw_run(v,p->seconds,log);if(rc){if(unlink(path)&&errno!=ENOENT)cxw_die("failed-artifact-unlink",path);cxw_die(rc==124?"build-timeout":"build-failed",p->id);}cxw_observe(s,id,target,1);char compiler[65];cxw_hash("unisacc.com",compiler);if(strcmp(compiler,s->compiler))cxw_die("compiler-changed",0);cxw_hash(artifact_pending,p->digest);CxwText assembly={0},receipt={0};cxw_row(&assembly,"build",p->build);for(int i=0;i<s->ne;i++)if(s->edges[i].owner==id){CxwPackage *d=&s->packages[s->edges[i].dependency];cxw_row(&assembly,d->id,d->digest);}cx_sha256_hex(assembly.p,assembly.n,p->assembly);free(assembly.p);cxw_put(&receipt,"CXWORKART1\n");cxw_row(&receipt,"status","PREPARED-no-test-result");cxw_row(&receipt,"timing","compile/load/run/validation-UNMEASURED");cxw_row(&receipt,"cache","disabled");cxw_row(&receipt,"package",p->id);cxw_row(&receipt,"target",target);cxw_row(&receipt,"build",p->build);cxw_row(&receipt,"interface",p->interface_key);cxw_row(&receipt,"assembly",p->assembly);cxw_row(&receipt,"artifact",p->artifact);cxw_row(&receipt,"sha256",p->digest);for(int i=0;i<s->ni;i++)if(s->inputs[i].owner==id&&strcmp(s->inputs[i].role,"test"))cxw_row(&receipt,s->inputs[i].name,s->inputs[i].digest);snprintf(name,sizeof name,"%s.receipt",p->id);cxw_path(path,s->out,name);char receipt_pending[4400];int rn=snprintf(receipt_pending,sizeof receipt_pending,"%s.pending",path);if(rn<0||(size_t)rn>=sizeof receipt_pending)cxw_die("receipt-path-bound",path);cxw_publish(receipt_pending,receipt.p,receipt.n);if(rename(artifact_pending,artifact_final))cxw_die("artifact-publish",artifact_final);if(rename(receipt_pending,path)){if(unlink(artifact_final))cxw_die("failed-artifact-unlink",artifact_final);cxw_die("receipt-publish",path);}free(receipt.p);printf("PREPARED\t%s\t%s\t%s\n",p->id,p->build,p->digest);}
int cxw_main(int argc,char **argv){
 if(argc<5|| (strcmp(argv[1],"plan")&&strcmp(argv[1],"build")&&strcmp(argv[1],"test")))cxw_die("usage","plan|build MANIFEST OUT TARGET [PACKAGE] | test MANIFEST OUT TARGET PACKAGE TEST -- ARGS...");
 CxwState *s=calloc(1,sizeof *s);if(!s)cxw_die("allocation",0);if(!getcwd(s->root,sizeof s->root))cxw_die("root",0);if(strcmp(argv[4],"lnx/x86_64"))cxw_die("unsupported-workspace-target",argv[4]);cxw_load(s,argv[2]);for(int i=0;i<s->np;i++)cxw_visit(s,i);if(argc>5)cxw_select(s,cxw_find(s,argv[5]));else for(int i=0;i<s->np;i++)s->packages[i].selected=1;cxw_hash("unisacc.com",s->compiler);
 if(argv[3][0]=='/'){if(strlen(argv[3])>=sizeof s->out)cxw_die("output-path-bound",0);strcpy(s->out,argv[3]);}else{int n=snprintf(s->out,sizeof s->out,"%s/%s",s->root,argv[3]);if(n<0||(size_t)n>=sizeof s->out)cxw_die("output-path-bound",0);}
 for(int k=0;k<s->no;k++){int id=s->order[k];if(s->packages[id].selected)cxw_observe(s,id,argv[4],0);}
 if(!strcmp(argv[1],"plan")){if(argc>6)cxw_die("plan-arguments",0);for(int k=0;k<s->no;k++){CxwPackage *p=&s->packages[s->order[k]];if(p->selected)printf("PLAN\t%s\t%s\t%s\t%s\n",p->id,p->source,p->artifact,p->build);}printf("SCHEDULER\tsequential\tmax-child-seconds=55\tcache=disabled\tno-test-result\n");}
 else if(!strcmp(argv[1],"build")){if(argc>6)cxw_die("build-arguments",0);if(mkdir(s->out,0700))cxw_die("exclusive-build-directory",s->out);for(int k=0;k<s->no;k++)if(s->packages[s->order[k]].selected)cxw_build(s,s->order[k],argv[4]);}
 else{if(argc<8||strcmp(argv[7],"--"))cxw_die("test-arguments",0);int id=cxw_find(s,argv[5]),found=-1;for(int i=0;i<s->nt;i++)if(s->tests[i].owner==id&&!strcmp(s->tests[i].id,argv[6]))found=i;if(found<0)cxw_die("undeclared-test",argv[6]);CxwTest *t=&s->tests[found];for(int k=0;k<s->no;k++)if(s->packages[s->order[k]].selected)cxw_artifact(s,s->order[k]);char source_hash[65];cxw_hash(t->source,source_hash);CxwText evidence={0};cxw_row(&evidence,"package",argv[5]);cxw_row(&evidence,"test",t->id);cxw_row(&evidence,"source-path",t->source);cxw_row(&evidence,"target",argv[4]);cxw_row(&evidence,"test-source",source_hash);cxw_row(&evidence,"compiler",s->compiler);cxw_row(&evidence,"artifact",s->packages[id].digest);for(int k=0;k<s->no;k++)if(s->packages[s->order[k]].selected){CxwPackage *p=&s->packages[s->order[k]];cxw_row(&evidence,p->id,p->digest);char rp[4400],rn[100];snprintf(rn,sizeof rn,"%s.receipt",p->id);cxw_path(rp,s->out,rn);size_t z;char *r=cxw_read(rp,&z),needle[100];snprintf(needle,sizeof needle,"build\t%s\n",p->build);if(!strstr(r,needle))cxw_die("stale-build-receipt",p->id);snprintf(needle,sizeof needle,"sha256\t%s\n",p->digest);if(!strstr(r,needle))cxw_die("artifact-digest-mismatch",p->id);free(r);}for(int i=0;i<s->ni;i++)if(s->packages[s->inputs[i].owner].selected&&!strcmp(s->inputs[i].role,"test")){char h[65];cxw_hash(s->inputs[i].path,h);strcpy(s->inputs[i].digest,h);cxw_row(&evidence,s->inputs[i].name,h);}char (*arg_hash)[65]=calloc((size_t)argc,65);if(!arg_hash)cxw_die("allocation",0);for(int i=8;i<argc;i++){cxw_row(&evidence,"argv",argv[i]);struct stat a;errno=0;if(!stat(argv[i],&a)){if(S_ISREG(a.st_mode)){cxw_hash(argv[i],arg_hash[i]);cxw_row(&evidence,"argv-file-sha256",arg_hash[i]);}}else if(errno!=ENOENT)cxw_die("argument-resource-stat",argv[i]);}char key[65];cx_sha256_hex(evidence.p,evidence.n,key);free(evidence.p);char path[4400],name[150];snprintf(name,sizeof name,"%s-%s-%ld.stdout",argv[5],argv[6],(long)getpid());cxw_path(path,s->out,name);char **v=calloc((size_t)argc+4,sizeof *v);if(!v)cxw_die("allocation",0);v[0]="sh";v[1]="./unisacc.com";v[2]=t->source;v[3]="--";for(int i=8;i<argc;i++)v[i-4]=argv[i];int rc=cxw_run(v,t->seconds,path);free(v);char after[65];cxw_hash(t->source,after);if(strcmp(source_hash,after))cxw_die("test-source-changed",t->source);for(int i=8;i<argc;i++)if(arg_hash[i][0]){cxw_hash(argv[i],after);if(strcmp(after,arg_hash[i]))cxw_die("argument-resource-changed",argv[i]);}free(arg_hash);for(int i=0;i<s->ni;i++)if(s->packages[s->inputs[i].owner].selected&&!strcmp(s->inputs[i].role,"test")){cxw_hash(s->inputs[i].path,after);if(strcmp(after,s->inputs[i].digest))cxw_die("test-input-changed",s->inputs[i].name);}for(int k=0;k<s->no;k++)if(s->packages[s->order[k]].selected){CxwPackage *p=&s->packages[s->order[k]];char prior[65];strcpy(prior,p->digest);cxw_artifact(s,s->order[k]);if(strcmp(prior,p->digest))cxw_die("artifact-changed-during-test",p->id);cxw_observe(s,s->order[k],argv[4],1);}cxw_hash("unisacc.com",after);if(strcmp(after,s->compiler))cxw_die("compiler-changed-during-test",0);printf("EXECUTED\t%s\t%s\trc=%d\ttest-key=%s\tstdout=%s\n",argv[5],argv[6],rc,key,path);free(s->text);free(s);return rc<0?2:rc;}
 free(s->text);free(s);return 0;
}
