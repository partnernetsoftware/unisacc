static void status(cm_result r,int want,const char *name){ck(r.status==want&&(!want||(!r.instance.id&&!r.owner.instance&&!r.owner.token&&!r.owner.slot&&!r.lease.instance&&!r.lease.token&&!r.lease.slot&&!r.length&&!r.byte)),name);}
static void byte(cm_result r,unsigned want,const char *name){ck(r.status==CM_OK&&r.byte==want,name);}
static cm_instance instance(cm_result r,const char *name){ck(r.status==CM_OK&&r.instance.id,name);cm_instance value=r.instance;return value;}
static cm_owner owner(cm_result r,const char *name){ck(r.status==CM_OK&&r.owner.instance&&r.owner.token,name);cm_owner value=r.owner;return value;}
static cm_lease lease(cm_result r,const char *name){ck(r.status==CM_OK&&r.lease.instance&&r.lease.token,name);cm_lease value=r.lease;return value;}
