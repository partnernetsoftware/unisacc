#pragma unisa module hkdf
/* crypto/hkdf -- HKDF-SHA256 (RFC 5869) and the TLS 1.3 HKDF-Expand-Label wrapper (RFC 8446 §7.1).
   Pure cx on top of crypto.sha256; no libc, no allocation, every length checked first.

     cs_hkdf_extract_sha256(salt, slen, ikm, ilen, prk32)
          RFC 5869 §2.2: PRK = HMAC(salt, IKM).  A zero-length salt is the empty key, which HMAC
          defines as all-zero (RFC 5869 §2.2 note); a null salt with slen 0 is accepted for that.
     cs_hkdf_expand_sha256(prk, plen, info, ilen, out, outlen)
          RFC 5869 §2.3.  outlen is 0..255*32 and ilen is 0..1024; anything wider is -EINVAL.
          out may be null only when outlen is 0.
     cs_hkdf_sha256(salt, slen, ikm, ilen, info, ilen2, out, outlen)
          extract then expand.
     cs_hkdf_expand_label_sha256(secret, slen, label, llen, context, clen, out, outlen)
          RFC 8446 §7.1: info = uint16(outlen) || uint8(|tlslabel|) || "tls13 " || label
                              || uint8(|context|) || context.  |label| <= 249 and |context| <= 255.

   These functions do not zeroise their intermediates; the caller owns the buffers and the lifetime of
   the secrets.  A comparison of two derived keys is not done here at all. */

#pragma unisa use sha256

int cs_hkdf_extract_sha256(const void *salt, long slen, const void *ikm, long ilen, unsigned char prk[32]) {
    return cs_hmac_sha256(salt, slen, ikm, ilen, prk);
}

int cs_hkdf_expand_sha256(const void *prk, long plen, const void *info, long ilen,
                          void *out, long outlen) {
    unsigned char t[32], block[32 + 1024 + 1];
    unsigned char *o = (unsigned char *)out;
    const unsigned char *ip = (const unsigned char *)info;
    long done = 0, i;
    unsigned counter = 1;
    if (plen < 0 || ilen < 0 || outlen < 0) return -EINVAL;
    if ((!prk && plen > 0) || (!info && ilen > 0)) return -EINVAL;
    if (ilen > 1024) return -EINVAL;              /* keeps the block buffer fixed; TLS 1.3 needs 514 */
    if (outlen > 255L * 32L) return -EINVAL;      /* the counter is one byte: 255 blocks at most */
    if (!o && outlen > 0) return -EINVAL;
    if (outlen == 0) return 0;
    while (done < outlen) {
        long n = 0, take;
        if (counter > 1) {                        /* T(i) = HMAC(PRK, T(i-1) || info || i) */
            for (i = 0; i < 32; i++) block[n++] = t[i];
        }
        for (i = 0; i < ilen; i++) block[n++] = ip[i];
        block[n++] = (unsigned char)counter;
        if (cs_hmac_sha256(prk, plen, block, n, t)) return -EINVAL;
        take = outlen - done;
        if (take > 32) take = 32;
        for (i = 0; i < take; i++) o[done + i] = t[i];
        done += take;
        counter++;
    }
    return 0;
}

int cs_hkdf_sha256(const void *salt, long slen, const void *ikm, long ilen,
                   const void *info, long infolen, void *out, long outlen) {
    unsigned char prk[32];
    if (cs_hkdf_extract_sha256(salt, slen, ikm, ilen, prk)) return -EINVAL;
    return cs_hkdf_expand_sha256(prk, 32, info, infolen, out, outlen);
}

int cs_hkdf_expand_label_sha256(const void *secret, long slen, const char *label, long llen,
                                const void *context, long clen, void *out, long outlen) {
    static const char prefix[6] = {'t', 'l', 's', '1', '3', ' '};
    unsigned char info[2 + 1 + 255 + 1 + 255];
    long n = 0, i;
    if (slen < 0 || llen < 0 || clen < 0 || outlen < 0) return -EINVAL;
    if (!label && llen > 0) return -EINVAL;
    if (!context && clen > 0) return -EINVAL;
    if (llen > 249) return -EINVAL;               /* "tls13 " + label must fit one length byte */
    if (clen > 255) return -EINVAL;
    if (outlen > 65535) return -EINVAL;
    info[n++] = (unsigned char)(outlen >> 8);     /* uint16 length of the output */
    info[n++] = (unsigned char)outlen;
    info[n++] = (unsigned char)(llen + 6);
    for (i = 0; i < 6; i++) info[n++] = (unsigned char)prefix[i];
    for (i = 0; i < llen; i++) info[n++] = (unsigned char)label[i];
    info[n++] = (unsigned char)clen;
    for (i = 0; i < clen; i++) info[n++] = ((const unsigned char *)context)[i];
    return cs_hkdf_expand_sha256(secret, slen, info, n, out, outlen);
}
