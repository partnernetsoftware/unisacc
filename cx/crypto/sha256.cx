#pragma unisa module sha256
/* crypto/sha256 -- SHA-256 (FIPS 180-4) and HMAC-SHA-256 (RFC 2104, vectors RFC 4231), pure cx.
   No libc call, no allocation, no mutable static state (the round constants are const), so two
   digests run at once on separate cs_sha256_t values.  Every buffer is the caller's; every length
   is checked before a byte is read or written.

     cs_sha256_init(&s)                         0, or -EINVAL on a null state
     cs_sha256_update(&s, p, n)                 0, or -EINVAL (null state, null p with n > 0, n < 0)
     cs_sha256_final(&s, out32)                 0, or -EINVAL; the state is not reusable without init
     cs_sha256(data, n, out32)                  one-shot of the three above
     cs_sha256_hex(data, n, hex65)              32 lowercase hex digits and a NUL; -1 on bad args
     cs_hmac_sha256(key, klen, data, dlen, out32)    RFC 2104; a key longer than 64 bytes is hashed first
     cs_hmac_sha256_hex(key, klen, data, dlen, hex65)  as above, hex form

   Not constant-time in the comparison sense: no comparison is done here, only hashing, and the length
   of the message is not secret in TLS.  The HMAC keys are the caller's problem to keep. */

enum { CS_BLOCK = 64 };
enum { CS_DIGEST = 32 };

typedef struct {
    unsigned h[8];                 /* chaining value, host byte order */
    unsigned char buf[CS_BLOCK];   /* bytes not yet compressed */
    long n;                        /* used bytes in buf, 0..63 */
    long total;                    /* bytes hashed so far; only the padding length is derived from it */
} cs_sha256_t;

/* The round constants (FIPS 180-4 §4.2.2): the first 32 bits of the fractional parts of the cube
   roots of the first 64 primes.  Const, so a digest holds no shared mutable state. */
static const unsigned cs_k[64] = {
    0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u, 0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
    0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u, 0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
    0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu, 0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
    0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u, 0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
    0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u, 0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
    0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u, 0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
    0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u, 0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
    0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u, 0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u
};

/* Rotate right by N, 1..31. */
static unsigned cs_ror(unsigned x, int n) { return (x >> n) | (x << (32 - n)); }

/* Compress one 64-byte block into H (FIPS 180-4 §6.2.2). */
static void cs_block(unsigned hv[8], const unsigned char b[CS_BLOCK]) {
    unsigned w[64], a, bb, c, d, e, f, g, hh, t1, t2;
    int i;
    for (i = 0; i < 16; i++)
        w[i] = ((unsigned)b[4 * i] << 24) | ((unsigned)b[4 * i + 1] << 16) | ((unsigned)b[4 * i + 2] << 8) | (unsigned)b[4 * i + 3];
    for (i = 16; i < 64; i++) {
        unsigned s0 = cs_ror(w[i - 15], 7) ^ cs_ror(w[i - 15], 18) ^ (w[i - 15] >> 3);
        unsigned s1 = cs_ror(w[i - 2], 17) ^ cs_ror(w[i - 2], 19) ^ (w[i - 2] >> 10);
        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
    }
    a = hv[0]; bb = hv[1]; c = hv[2]; d = hv[3]; e = hv[4]; f = hv[5]; g = hv[6]; hh = hv[7];
    for (i = 0; i < 64; i++) {
        unsigned S1 = cs_ror(e, 6) ^ cs_ror(e, 11) ^ cs_ror(e, 25);
        unsigned ch = (e & f) ^ (~e & g);
        unsigned S0 = cs_ror(a, 2) ^ cs_ror(a, 13) ^ cs_ror(a, 22);
        unsigned maj = (a & bb) ^ (a & c) ^ (bb & c);
        t1 = hh + S1 + ch + cs_k[i] + w[i];
        t2 = S0 + maj;
        hh = g; g = f; f = e; e = d + t1; d = c; c = bb; bb = a; a = t1 + t2;
    }
    hv[0] += a; hv[1] += bb; hv[2] += c; hv[3] += d;
    hv[4] += e; hv[5] += f; hv[6] += g; hv[7] += hh;
}

int cs_sha256_init(cs_sha256_t *s) {
    int i;
    if (!s) return -EINVAL;
    s->h[0] = 0x6a09e667u; s->h[1] = 0xbb67ae85u; s->h[2] = 0x3c6ef372u; s->h[3] = 0xa54ff53au;
    s->h[4] = 0x510e527fu; s->h[5] = 0x9b05688cu; s->h[6] = 0x1f83d9abu; s->h[7] = 0x5be0cd19u;
    for (i = 0; i < CS_BLOCK; i++) s->buf[i] = 0;
    s->n = 0;
    s->total = 0;
    return 0;
}

int cs_sha256_update(cs_sha256_t *s, const void *p, long n) {
    const unsigned char *b = (const unsigned char *)p;
    long i = 0;
    if (!s || n < 0) return -EINVAL;
    if (!b && n > 0) return -EINVAL;
    if (n == 0) return 0;
    s->total += n;
    if (s->n > 0) {                        /* fill the pending block first */
        long take = CS_BLOCK - s->n;
        if (take > n) take = n;
        for (i = 0; i < take; i++) s->buf[s->n + i] = b[i];
        s->n += take;
        i = take;
        if (s->n < CS_BLOCK) return 0;
        cs_block(s->h, s->buf);
        s->n = 0;
    }
    while (n - i >= CS_BLOCK) {            /* whole blocks straight from the caller's buffer */
        cs_block(s->h, b + i);
        i += CS_BLOCK;
    }
    for (; i < n; i++) s->buf[s->n++] = b[i];
    return 0;
}

int cs_sha256_final(cs_sha256_t *s, unsigned char out[32]) {
    unsigned long bits;
    int i;
    if (!s || !out) return -EINVAL;
    bits = (unsigned long)s->total * 8;
    s->buf[s->n++] = 0x80;                 /* the mandatory 0x80, then zeros */
    if (s->n > CS_BLOCK - 8) {
        while (s->n < CS_BLOCK) s->buf[s->n++] = 0;
        cs_block(s->h, s->buf);
        s->n = 0;
    }
    while (s->n < CS_BLOCK - 8) s->buf[s->n++] = 0;
    for (i = 7; i >= 0; i--) {             /* 64-bit big-endian bit count */
        s->buf[CS_BLOCK - 1 - i] = (unsigned char)(bits >> (8 * i));
    }
    cs_block(s->h, s->buf);
    for (i = 0; i < 8; i++) {
        out[4 * i] = (unsigned char)(s->h[i] >> 24);
        out[4 * i + 1] = (unsigned char)(s->h[i] >> 16);
        out[4 * i + 2] = (unsigned char)(s->h[i] >> 8);
        out[4 * i + 3] = (unsigned char)s->h[i];
    }
    s->n = 0;
    return 0;
}

int cs_sha256(const void *data, long n, unsigned char out[32]) {
    cs_sha256_t s;
    if (cs_sha256_init(&s)) return -EINVAL;
    if (cs_sha256_update(&s, data, n)) return -EINVAL;
    return cs_sha256_final(&s, out);
}

/* Lowercase hex of the 32 digest bytes plus a NUL: -1 on bad arguments, 0 otherwise. */
int cs_sha256_hex(const void *data, long n, char hex[65]) {
    static const char digits[16] = "0123456789abcdef";
    unsigned char md[CS_DIGEST];
    int i;
    if (!hex) return -1;
    hex[0] = 0;
    if (cs_sha256(data, n, md)) return -1;
    for (i = 0; i < CS_DIGEST; i++) {
        hex[2 * i] = digits[md[i] >> 4];
        hex[2 * i + 1] = digits[md[i] & 15];
    }
    hex[2 * CS_DIGEST] = 0;
    return 0;
}

int cs_hmac_sha256(const void *key, long klen, const void *data, long dlen, unsigned char out[32]) {
    unsigned char k[CS_BLOCK], pad[CS_BLOCK], inner[CS_DIGEST];
    cs_sha256_t s;
    const unsigned char *kp = (const unsigned char *)key;
    long i;
    if (klen < 0 || dlen < 0 || !out) return -EINVAL;
    if ((!key && klen > 0) || (!data && dlen > 0)) return -EINVAL;
    for (i = 0; i < CS_BLOCK; i++) k[i] = 0;
    if (klen > CS_BLOCK) {                 /* RFC 2104: a long key is replaced by its digest */
        if (cs_sha256(key, klen, inner)) return -EINVAL;
        for (i = 0; i < CS_DIGEST; i++) k[i] = inner[i];
    } else {
        for (i = 0; i < klen; i++) k[i] = kp[i];
    }
    for (i = 0; i < CS_BLOCK; i++) pad[i] = (unsigned char)(k[i] ^ 0x36);
    if (cs_sha256_init(&s) || cs_sha256_update(&s, pad, CS_BLOCK) || cs_sha256_update(&s, data, dlen)
        || cs_sha256_final(&s, inner)) return -EINVAL;
    for (i = 0; i < CS_BLOCK; i++) pad[i] = (unsigned char)(k[i] ^ 0x5c);
    if (cs_sha256_init(&s) || cs_sha256_update(&s, pad, CS_BLOCK) || cs_sha256_update(&s, inner, CS_DIGEST)
        || cs_sha256_final(&s, out)) return -EINVAL;
    return 0;
}

int cs_hmac_sha256_hex(const void *key, long klen, const void *data, long dlen, char hex[65]) {
    static const char digits[16] = "0123456789abcdef";
    unsigned char md[CS_DIGEST];
    int i;
    if (!hex) return -1;
    hex[0] = 0;
    if (cs_hmac_sha256(key, klen, data, dlen, md)) return -1;
    for (i = 0; i < CS_DIGEST; i++) {
        hex[2 * i] = digits[md[i] >> 4];
        hex[2 * i + 1] = digits[md[i] & 15];
    }
    hex[2 * CS_DIGEST] = 0;
    return 0;
}
