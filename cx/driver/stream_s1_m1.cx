#pragma unisa module stream_s1_m1
#pragma unisa use runtime.packagefooter
#pragma unisa use runtime.package_decode
#pragma unisa use runtime.package_lifetime
#pragma unisa use driver.tape_soload
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
/* Shared per-process embedded-carrier tape runtime for lnx/x86_64 (m53, packmodel, batch 1+):
 * - Zero dependency on runtime.stream_attributes (no native cxsa_valid, no fallback).
 * - ONE shared TapeRuntime per process: locates the P4 footer once, scans P4 once to index all
 *   tape/* F records, verifies/caches manifest.tsv once, maps tapemode.so once, and reuses one
 *   VM arena (vm_mem / vm_ibm) across calls without per-call mmap/munmap page-fault churn.
 * - Per-unit lazy slice loading (TapeUnitState): each unit extracts, G1-CRC-checks, manifest-checks,
 *   and UTAPEBIN-v1.3-validates only its own .tapeslice on its first call (0 ms on stages that do
 *   not call it; < 1 ms on first call after runtime boot; ~0.01 ms stat-hit on repeat calls).
 * - Measure-ready hooks: tape_rt_stats() and tape_unit_stats() / tape_unit_m53_stats().
 * - Keeps cxsa_valid_s1, m53_m1_extract_tape, m53_m1_classify_vm_result, m53_m1_classify_run_result,
 *   TapeUnitSpec, TapeUnitState, and tape_unit_call_bytes 100% backward-compatible. */

enum {
    M53_M1_UNBOOTED = 0,
    M53_M1_LOADING = 1,
    M53_M1_READY = 2,
    M53_M1_REFUSED = 3,
    M53_M1_MAX_APE = 67108864L,
    M53_M1_MAX_IN = 16777216L,
    M53_M1_MAX_MF = 65536L,
    M53_M1_MAX_SO = 1048576L,
    M53_M1_MAX_SL = 4194304L,
    M53_M1_MASK = 383ULL,
    TAPE_RT_MAX_FDIR = 64
};

static const unsigned long long M53_M1_RES_SENTINEL = 0x554e575249545445ULL;

typedef struct {
    const char *mf_key;
    const char *so_key;
    const char *sl_key;
    const char *so_leaf;
    const char *sl_leaf;
    const char *abi_tag;
    long abi_tag_len;
    const char *guest_sym;
    unsigned long long max_ret;
    unsigned long long budget;
    const char *refuse_tag;
} TapeUnitSpec;

typedef struct {
    char path[4096];
    unsigned long dev;
    long ino;
    long size;
    long mtime;
    int64_t mtime_ns;
    int64_t ctime_ns;
    int valid;
} M53CacheKey;

typedef struct {
    char key[128];
    long key_len;
    long data_off;
    long len;
    long rawlen;
    unsigned crc;
    int codec;
    int dup;
} TapeFDirEntry;

typedef struct {
    const unsigned char *slice;
    long slice_len;
    unsigned long gen;
    unsigned char sha[32];
    unsigned char *ibm;
    long cap;
} TapeIbmSlot;

typedef struct {
    const void *unit;
    const unsigned char *slice;
    long slice_len;
    unsigned long gen;
    unsigned char sha[32];
    int valid;
} TapeUnitSha;

typedef struct {
    int state;
    int busy;
    unsigned long gen;
    M53CacheKey cache;
    TapeFDirEntry fdir[TAPE_RT_MAX_FDIR];
    int fdir_n;
    unsigned char *mf;
    long mf_len;
    tsl_img_t tsl;
    void *bind_fn;
    void *disp_fn;
    void *run_fn;
    unsigned char *vm_mem;
    long vm_mem_cap;
    unsigned char *vm_ibm;
    long vm_ibm_cap;
    TapeIbmSlot ibm_cache[16];
    TapeUnitSha unit_shas[16];
    long boot_count;
    long boot_ns;
} TapeRuntime;

typedef struct {
    int state;
    int busy;
    int detail;
    char reason[64];
    unsigned long rt_gen;
    unsigned char *slice;
    long slice_len;
    unsigned long long code_len;
    unsigned long long data_off;
    unsigned long long data_len;
    unsigned long long bss_size;
    long calls;
    long slice_load_ns;
    long first_ns;
    long repeat_ns;
} TapeUnitState;

static TapeRuntime g_tape_rt;
static TapeUnitState m53_m1_unit;

static const TapeUnitSpec m53_m1_spec = {
    "tape/lnx-x86_64/manifest.tsv",
    "tape/lnx-x86_64/tapemode.so",
    "tape/lnx-x86_64/m53.tapeslice",
    "tapemode.so",
    "m53.tapeslice",
    "M53S1BIN2",
    9L,
    "cxsa_valid",
    1ULL,
    2000000ULL,
    "M53_M1_REFUSE"
};

static long tape_mono_ns(void) {
    sy_ts_t t;
    if (sy_mono(&t) != 0) return 0L;
    return t.sec * 1000000000L + t.nsec;
}

static long m53_m1_len(const char *s, long cap) {
    long i = 0;
    if (!s) return 0;
    while (i < cap && s[i]) i++;
    return i;
}

static void m53_m1_cpy(char *dst, long cap, const char *src) {
    long i = 0;
    if (!dst || cap <= 0) return;
    if (src) while (src[i] && i + 1 < cap) { dst[i] = src[i]; i++; }
    dst[i] = 0;
}

static int m53_m1_eq(const char *a, long al, const char *b, long bl) {
    long i = 0;
    if (al != bl) return 0;
    while (i < al) { if (a[i] != b[i]) return 0; i++; }
    return 1;
}

static unsigned long long m53_m1_rd_u(const unsigned char *p, int k) {
    unsigned long long v = 0;
    int i = k - 1;
    while (i >= 0) { v = (v << 8) | (unsigned long long)(p[i] & 255); i--; }
    return v;
}

static void m53_m1_wr_i64_dec(char *dst, long cap, long long v) {
    char tmp[32];
    int n = 0, i = 0;
    unsigned long long uv;
    if (!dst || cap <= 0) return;
    if (v == 0) { if (cap > 1) { dst[0] = '0'; dst[1] = 0; } else dst[0] = 0; return; }
    if (v < 0) {
        if (i + 1 < cap) dst[i++] = '-';
        uv = (unsigned long long)(-(v + 1)) + 1ULL;
    } else uv = (unsigned long long)v;
    while (uv > 0 && n < 32) { tmp[n++] = (char)('0' + (uv % 10ULL)); uv /= 10ULL; }
    while (n > 0 && i + 1 < cap) dst[i++] = tmp[--n];
    dst[i] = 0;
}

static int m53_m1_bytes_eq(const unsigned char *a, const unsigned char *b, long n) {
    long i;
    for (i = 0; i < n; i++) if (a[i] != b[i]) return 0;
    return 1;
}

/* IEEE CRC32 (poly 0xedb88320, bit-identical to runtime.codec cxcodec_crc). */
static unsigned m53_m1_crc32(const unsigned char *p, long n) {
    unsigned c = 4294967295U;
    long i;
    int j;
    for (i = 0; i < n; i++) {
        c ^= (unsigned)p[i];
        for (j = 0; j < 8; j++) c = (c & 1U) ? ((c >> 1) ^ 3988292384U) : (c >> 1);
    }
    return c ^ 4294967295U;
}

static void *m53_m1_pk_alloc(void *prev, size_t n) {
    (void)prev;
    return mm_alloc((long)(n ? n : 1));
}

static void m53_m1_pk_free(void *p) {
    if (p) mm_free(p);
}

static void m53_m1_hex(const unsigned char h[32], char out[65]) {
    static const char hx[] = "0123456789abcdef";
    int i;
    for (i = 0; i < 32; i++) {
        out[i * 2] = hx[(h[i] >> 4) & 15];
        out[i * 2 + 1] = hx[h[i] & 15];
    }
    out[64] = 0;
}

static void tape_emit_refuse(const char *tag, const char *reason, int detail) {
    char buf[192], num[24];
    long p = 0, i = 0, nn = 0;
    const char *t = (tag && tag[0]) ? tag : "M53_M1_REFUSE";
    const char *pre = "\treason=";
    const char *mid = "\tdetail=";
    unsigned long long uv;
    while (t[i] && p + 1 < (long)sizeof buf) buf[p++] = t[i++];
    i = 0;
    while (pre[i] && p + 1 < (long)sizeof buf) buf[p++] = pre[i++];
    i = 0;
    if (reason) while (reason[i] && p + 1 < (long)sizeof buf) buf[p++] = reason[i++];
    i = 0;
    while (mid[i] && p + 1 < (long)sizeof buf) buf[p++] = mid[i++];
    if (detail < 0) { if (p + 1 < (long)sizeof buf) buf[p++] = '-'; uv = (unsigned long long)(-(long long)detail); }
    else uv = (unsigned long long)detail;
    if (uv == 0) num[nn++] = '0';
    else while (uv > 0 && nn < (long)sizeof num) { num[nn++] = (char)('0' + (uv % 10ULL)); uv /= 10ULL; }
    while (nn > 0 && p + 1 < (long)sizeof buf) buf[p++] = num[--nn];
    if (p + 1 < (long)sizeof buf) buf[p++] = '\n';
    (void)sy_write_all(2, buf, p);
}

static int tape_unit_fail(TapeUnitState *u, const TapeUnitSpec *sp, const char *reason, int detail) {
    u->state = M53_M1_REFUSED;
    u->detail = detail;
    m53_m1_cpy(u->reason, (long)sizeof u->reason, reason);
    tape_emit_refuse(sp ? sp->refuse_tag : 0, reason, detail);
    return -2;
}

static int m53_m1_parse_dec(const char *s, long n, long *out) {
    long v = 0, i = 0;
    if (n <= 0) return -1;
    while (i < n) {
        if (s[i] < '0' || s[i] > '9') return -1;
        if (v > (M53_M1_MAX_APE - (long)(s[i] - '0')) / 10) return -1;
        v = v * 10 + (long)(s[i] - '0');
        i++;
    }
    *out = v;
    return 0;
}

static int m53_m1_check_mf_line(const char *mf, long mfn, const char *name, const char sha[65], long bytes) {
    long nl = m53_m1_len(name, 64), at = 0;
    int found = 0;
    while (at < mfn) {
        long e = at;
        while (e < mfn && mf[e] != '\n') e++;
        long ln = e - at;
        if (ln > 0 && mf[at] != '#') {
            long t1 = -1, t2 = -1, i;
            for (i = 0; i < ln; i++) {
                if (mf[at + i] == '\t') {
                    if (t1 < 0) t1 = i;
                    else if (t2 < 0) t2 = i;
                }
            }
            if (t1 == nl && m53_m1_eq(mf + at, t1, name, nl) && t2 > t1) {
                long sl = t2 - (t1 + 1), bl = ln - (t2 + 1), bv = -1;
                if (sl != 64 || !m53_m1_eq(mf + at + t1 + 1, 64, sha, 64)) return -1;
                if (m53_m1_parse_dec(mf + at + t2 + 1, bl, &bv) != 0 || bv != bytes) return -1;
                if (found) return -1;
                found = 1;
            }
        }
        at = e + 1;
    }
    return found ? 0 : -1;
}

/* G1 authoritative in-memory extractor for any 3-key tape unit (used by check-m1-g1-crc.cx). */
int tape_unit_extract_mem(const unsigned char *pkg, long pkglen, const char *const keys[3],
                          const unsigned char *out_p[3], long out_n[3],
                          const char **reason_out, int *detail_out) {
    static const long max_bytes[3] = { M53_M1_MAX_MF, M53_M1_MAX_SO, M53_M1_MAX_SL };
    long key_len[3];
    CxPackageDecode dec;
    int i, k;
    for (k = 0; k < 3; k++) {
        key_len[k] = m53_m1_len(keys[k], 128);
        out_p[k] = 0;
        out_n[k] = 0;
    }
    mm_fill(&dec, (long)sizeof dec, 0, (long)sizeof dec);
    dec.allocate = m53_m1_pk_alloc;
    dec.release = m53_m1_pk_free;
    if (!pkg || pkglen <= 0 || cxpk_decode(&dec, pkg, pkglen) != 0) {
        *reason_out = "embed-pkg-decode-failed";
        *detail_out = 10;
        return -1;
    }
    if (dec.package.ver < 4) {
        cxpl_release(&dec.package, m53_m1_pk_free);
        *reason_out = "embed-pkg-decode-failed";
        *detail_out = 10;
        return -1;
    }
    for (i = 0; i < dec.package.nr; i++) {
        const CxPackageResource *r = &dec.package.res[i];
        const char *nm = (const char *)(pkg + r->name);
        for (k = 0; k < 3; k++) {
            if ((long)r->n == key_len[k] && m53_m1_eq(nm, (long)r->n, keys[k], key_len[k])) {
                if (out_p[k]) {
                    cxpl_release(&dec.package, m53_m1_pk_free);
                    *reason_out = "embed-resource-duplicate";
                    *detail_out = k + 1;
                    return -1;
                }
                if (r->codec != 0) {
                    cxpl_release(&dec.package, m53_m1_pk_free);
                    *reason_out = "embed-pkg-decode-failed";
                    *detail_out = 20 + k;
                    return -1;
                }
                if (r->len <= 0 || r->rawlen != r->len || (long)r->len > max_bytes[k]) {
                    cxpl_release(&dec.package, m53_m1_pk_free);
                    *reason_out = "embed-pkg-decode-failed";
                    *detail_out = 30 + k;
                    return -1;
                }
                if (m53_m1_crc32(pkg + r->data, (long)r->len) != r->crc) {
                    cxpl_release(&dec.package, m53_m1_pk_free);
                    *reason_out = "embed-pkg-decode-failed";
                    *detail_out = k;
                    return -1;
                }
                out_p[k] = pkg + r->data;
                out_n[k] = (long)r->len;
                break;
            }
        }
    }
    cxpl_release(&dec.package, m53_m1_pk_free);
    for (k = 0; k < 3; k++) {
        if (!out_p[k]) {
            *reason_out = "embed-resource-missing";
            *detail_out = k + 1;
            return -1;
        }
    }
    *reason_out = 0;
    *detail_out = 0;
    return 0;
}

int m53_m1_extract_tape(const unsigned char *pkg, long pkglen,
                        const unsigned char *out_p[3], long out_n[3],
                        const char **reason_out, int *detail_out) {
    const char *keys[3];
    keys[0] = m53_m1_spec.mf_key;
    keys[1] = m53_m1_spec.so_key;
    keys[2] = m53_m1_spec.sl_key;
    return tape_unit_extract_mem(pkg, pkglen, keys, out_p, out_n, reason_out, detail_out);
}

/* Full UTAPEBIN v1.3 6-section validator (parameterized by ABI tag). */
static int tape_unit_validate_slice(const unsigned char *b, long len,
                                    const char *abi_tag, long abi_len,
                                    unsigned long long *clen_out, unsigned long long *doff_out,
                                    unsigned long long *dlen_out, unsigned long long *bsz_out) {
    static const char *const tags[6] = {"CODE", "DATA", "BSSZ", "SYMS", "RELO", "HOST"};
    static const char magic[8] = {'U', 'T', 'A', 'P', 'E', 'B', 'I', 'N'};
    unsigned long long entry_off, nsect, dir_off, origin, prev_end = 208ULL;
    unsigned long long code_len = 0, data_off = 0, data_len = 0, bss_sz = 0;
    unsigned char *tmp, dig[32], seen_host[37];
    int i, j, has_abi = 0;
    if (!b || len < 216 || !abi_tag || abi_len <= 0) return -1;
    for (i = 0; i < 8; i++) if (b[i] != (unsigned char)magic[i]) return -1;
    if (m53_m1_rd_u(b + 8, 2) != 1ULL || m53_m1_rd_u(b + 10, 2) != 3ULL) return -1;
    if (m53_m1_rd_u(b + 12, 2) != 1ULL || m53_m1_rd_u(b + 14, 2) != 0ULL) return -1;
    entry_off = m53_m1_rd_u(b + 16, 4);
    nsect = m53_m1_rd_u(b + 20, 4);
    dir_off = m53_m1_rd_u(b + 24, 4);
    origin = m53_m1_rd_u(b + 60, 4);
    if (nsect != 6ULL || dir_off != 64ULL || origin > 6ULL) return -1;
    for (i = 0; i < 6; i++) {
        int d = 64 + 24 * i;
        unsigned long long soff, slen, scnt, aligned;
        for (j = 0; j < 4; j++) if (b[d + j] != (unsigned char)tags[i][j]) return -1;
        soff = m53_m1_rd_u(b + d + 4, 8);
        slen = m53_m1_rd_u(b + d + 12, 8);
        scnt = m53_m1_rd_u(b + d + 20, 4);
        aligned = prev_end + ((8ULL - (prev_end & 7ULL)) & 7ULL);
        if (soff != aligned) return -1;
        if (soff > (unsigned long long)len || slen > (unsigned long long)len - soff) return -1;
        while (prev_end < soff) { if (b[prev_end] != 0) return -1; prev_end++; }
        if (i == 0) code_len = slen;
        if (i == 1) { data_off = soff; data_len = slen; }
        if (i == 2) { if (slen != 8ULL || scnt != 1ULL) return -1; bss_sz = m53_m1_rd_u(b + soff, 8); }
        if (i == 3) {
            unsigned long long r;
            if ((slen & 15ULL) != 0ULL || scnt != (slen >> 4)) return -1;
            for (r = 0; r < scnt; r++) {
                const unsigned char *row = b + soff + (r << 4);
                unsigned long long noff = m53_m1_rd_u(row, 4), k;
                int nul_ok = 0;
                if (row[4] > 3 || row[5] > 3 || m53_m1_rd_u(row + 6, 2) != 0ULL) return -1;
                if (noff >= data_len || b[data_off + noff] == 0) return -1;
                for (k = noff; k < data_len; k++) if (b[data_off + k] == 0) { nul_ok = 1; break; }
                if (!nul_ok) return -1;
            }
        }
        if (i == 4) {
            unsigned long long r;
            if ((slen & 15ULL) != 0ULL || scnt != (slen >> 4)) return -1;
            for (r = 0; r < scnt; r++) {
                const unsigned char *row = b + soff + (r << 4);
                unsigned long long rpos = m53_m1_rd_u(row, 8);
                if (row[8] > 3 || row[9] < 1 || row[9] > 10 || m53_m1_rd_u(row + 10, 2) != 0ULL) return -1;
                if (rpos == 0ULL || rpos >= code_len || (unsigned long long)row[9] > code_len - rpos) return -1;
            }
        }
        if (i == 5) {
            unsigned long long hpos = 0, r;
            for (j = 0; j < 37; j++) seen_host[j] = 0;
            for (r = 0; r < scnt; r++) {
                unsigned long long slot, nlen;
                if (slen - hpos < 4ULL) return -1;
                slot = m53_m1_rd_u(b + soff + hpos, 2);
                nlen = m53_m1_rd_u(b + soff + hpos + 2, 2);
                hpos += 4ULL;
                if (slot >= 37ULL || seen_host[slot] || ((M53_M1_MASK >> slot) & 1ULL) == 0ULL) return -1;
                if (nlen > slen - hpos) return -1;
                seen_host[slot] = 1;
                hpos += nlen;
            }
            if (hpos != slen) return -1;
        }
        prev_end = soff + slen;
    }
    if (prev_end != (unsigned long long)len) return -1;
    if (code_len == 0ULL && entry_off != 0ULL) return -1;
    if (code_len > 0ULL && entry_off >= code_len) return -1;
    tmp = (unsigned char *)mm_alloc(len);
    if (!tmp) return -1;
    if (mm_copy(tmp, len, b, len)) { mm_free(tmp); return -1; }
    for (i = 0; i < 32; i++) tmp[28 + i] = 0;
    cx_sha256(tmp, (size_t)len, dig);
    mm_free(tmp);
    if (!m53_m1_bytes_eq(b + 28, dig, 32)) return -1;
    if (data_len >= (unsigned long long)abi_len) {
        unsigned long long pos;
        for (pos = 0; pos + (unsigned long long)abi_len <= data_len; pos++) {
            int ok = 1;
            long k;
            for (k = 0; k < abi_len; k++) {
                if (b[data_off + pos + (unsigned long long)k] != (unsigned char)abi_tag[k]) { ok = 0; break; }
            }
            if (ok) { has_abi = 1; break; }
        }
    }
    if (!has_abi) return -1;
    *clen_out = code_len;
    *doff_out = data_off;
    *dlen_out = data_len;
    *bsz_out = bss_sz;
    return 0;
}

static void tape_cache_clear_all(TapeRuntime *rt) {
    int i;
    for (i = 0; i < 16; i++) {
        rt->ibm_cache[i].slice = 0;
        rt->ibm_cache[i].slice_len = 0;
        rt->ibm_cache[i].gen = 0;
        mm_fill(rt->ibm_cache[i].sha, 32L, 0, 32L);
        rt->unit_shas[i].valid = 0;
        rt->unit_shas[i].unit = 0;
        rt->unit_shas[i].slice = 0;
        rt->unit_shas[i].slice_len = 0;
        rt->unit_shas[i].gen = 0;
        mm_fill(rt->unit_shas[i].sha, 32L, 0, 32L);
    }
}

static void tape_cache_drop_slice(TapeRuntime *rt, const void *unit, const unsigned char *slice) {
    int i;
    for (i = 0; i < 16; i++) {
        if (slice && rt->ibm_cache[i].slice == slice) {
            rt->ibm_cache[i].slice = 0;
            rt->ibm_cache[i].slice_len = 0;
            rt->ibm_cache[i].gen = 0;
            mm_fill(rt->ibm_cache[i].sha, 32L, 0, 32L);
        }
        if ((unit && rt->unit_shas[i].unit == unit) ||
            (slice && rt->unit_shas[i].slice == slice)) {
            rt->unit_shas[i].valid = 0;
            rt->unit_shas[i].unit = 0;
            rt->unit_shas[i].slice = 0;
            rt->unit_shas[i].slice_len = 0;
            rt->unit_shas[i].gen = 0;
            mm_fill(rt->unit_shas[i].sha, 32L, 0, 32L);
        }
    }
}

static void tape_unit_sha_record(TapeRuntime *rt, const void *unit, const unsigned char *slice,
                                 long slice_len, unsigned long gen, const unsigned char sha[32]) {
    int i, dst = -1;
    for (i = 0; i < 16; i++) {
        if (rt->unit_shas[i].valid && rt->unit_shas[i].unit == unit) { dst = i; break; }
        if (!rt->unit_shas[i].valid && dst < 0) dst = i;
    }
    if (dst < 0) dst = 0;
    rt->unit_shas[dst].unit = unit;
    rt->unit_shas[dst].slice = slice;
    rt->unit_shas[dst].slice_len = slice_len;
    rt->unit_shas[dst].gen = gen;
    mm_copy(rt->unit_shas[dst].sha, 32L, sha, 32L);
    rt->unit_shas[dst].valid = 1;
}

static int tape_unit_sha_lookup(const TapeRuntime *rt, const void *unit, const unsigned char *slice,
                                long slice_len, unsigned long gen, unsigned char out[32]) {
    int i;
    for (i = 0; i < 16; i++) {
        if (rt->unit_shas[i].valid && rt->unit_shas[i].unit == unit &&
            rt->unit_shas[i].slice == slice && rt->unit_shas[i].slice_len == slice_len &&
            rt->unit_shas[i].gen == gen) {
            mm_copy(out, 32L, rt->unit_shas[i].sha, 32L);
            return 1;
        }
    }
    return 0;
}

static void tape_zero_fast(unsigned char *p, long n) {
    unsigned long long *q;
    long i = 0;
    if (!p || n <= 0L) return;
    while (i < n && (((unsigned long long)(p + i)) & 7ULL) != 0ULL) {
        p[i++] = 0;
    }
    q = (unsigned long long *)(p + i);
    while (i + 32L <= n) {
        q[0] = 0ULL; q[1] = 0ULL; q[2] = 0ULL; q[3] = 0ULL;
        q += 4;
        i += 32L;
    }
    while (i + 8L <= n) {
        *q++ = 0ULL;
        i += 8L;
    }
    while (i < n) p[i++] = 0;
}

static void tape_rt_drop(TapeRuntime *rt) {
    tsl_unload(&rt->tsl);
    if (rt->mf) { mm_free(rt->mf); rt->mf = 0; }
    rt->mf_len = 0;
    rt->fdir_n = 0;
    rt->bind_fn = 0;
    rt->disp_fn = 0;
    rt->run_fn = 0;
    rt->cache.valid = 0;
    tape_cache_clear_all(rt);
    rt->gen++;
}

static void tape_unit_drop_slice(TapeUnitState *u) {
    tape_cache_drop_slice(&g_tape_rt, (const void *)u, u->slice);
    if (u->slice) { mm_free(u->slice); u->slice = 0; }
    u->slice_len = 0;
    u->code_len = 0;
    u->data_off = 0;
    u->data_len = 0;
    u->bss_size = 0;
    u->rt_gen = 0;
}

/* Contract: stat-hit fast path assumes immutable APE/P4 container files (no in-place mutation
 * preserving dev/ino/size/mtime/ctime_ns); mutable containers must replace via rename/new inode. */
static int tape_rt_stat_hit(const TapeRuntime *rt, const char *cpath, const sy_stat_t *st) {
    long cl, kl;
    if (rt->state != M53_M1_READY || !rt->cache.valid) return 0;
    cl = m53_m1_len(cpath, 4096);
    kl = m53_m1_len(rt->cache.path, 4096);
    if (!m53_m1_eq(cpath, cl, rt->cache.path, kl)) return 0;
    return st->dev == rt->cache.dev && st->ino == rt->cache.ino && st->size == rt->cache.size &&
           st->mtime == rt->cache.mtime && st->mtime_ns == rt->cache.mtime_ns &&
           st->ctime_ns == rt->cache.ctime_ns;
}

typedef struct {
    int fd;
    long pos;
    long end;
    long bpos;
    long blen;
    unsigned char buf[4096];
} M53FdScan;

static void m53_fd_init(M53FdScan *sc, int fd, long start, long end) {
    sc->fd = fd;
    sc->pos = start;
    sc->end = end;
    sc->bpos = 0;
    sc->blen = 0;
}

static long m53_fd_tell(const M53FdScan *sc) {
    return sc->pos - (sc->blen - sc->bpos);
}

static int m53_fd_getc(M53FdScan *sc) {
    if (sc->bpos >= sc->blen) {
        long rem = sc->end - sc->pos;
        long want = rem > (long)sizeof sc->buf ? (long)sizeof sc->buf : rem;
        long got;
        if (want <= 0) return -1;
        got = sy_read(sc->fd, sc->buf, want);
        if (got <= 0) return -1;
        sc->pos += got;
        sc->bpos = 0;
        sc->blen = got;
    }
    return (int)sc->buf[sc->bpos++];
}

static int m53_fd_skip(M53FdScan *sc, long n) {
    long avail;
    if (n < 0) return -1;
    if (n == 0) return 0;
    avail = sc->blen - sc->bpos;
    if (n <= avail) { sc->bpos += n; return 0; }
    n -= avail;
    sc->bpos = 0;
    sc->blen = 0;
    if (n > sc->end - sc->pos) return -1;
    sc->pos += n;
    return sy_lseek(sc->fd, sc->pos, 0) == sc->pos ? 0 : -1;
}

static int m53_fd_read(M53FdScan *sc, unsigned char *dst, long n) {
    long avail, take;
    if (n < 0) return -1;
    if (n == 0) return 0;
    avail = sc->blen - sc->bpos;
    if (avail > 0) {
        take = n < avail ? n : avail;
        if (mm_copy(dst, n, sc->buf + sc->bpos, take)) return -1;
        sc->bpos += take;
        dst += take;
        n -= take;
    }
    if (n == 0) return 0;
    if (n > sc->end - sc->pos) return -1;
    if (sy_read_full(sc->fd, dst, n) != 0) return -1;
    sc->pos += n;
    return 0;
}

static long m53_fd_line(M53FdScan *sc, char *line, long cap) {
    long n = 0;
    int c;
    for (;;) {
        c = m53_fd_getc(sc);
        if (c < 0) return -1;
        if (c == '\n') { line[n] = 0; return n; }
        if (n + 1 >= cap) return -1;
        line[n++] = (char)c;
    }
}

static int m53_tok_u64(const char *s, long *at, long len, unsigned long long *out) {
    unsigned long long v = 0;
    long i = *at;
    int any = 0;
    while (i < len && (s[i] == ' ' || s[i] == '\t' || s[i] == '\r')) i++;
    while (i < len && s[i] >= '0' && s[i] <= '9') {
        unsigned long long d = (unsigned long long)(s[i] - '0');
        if (v > (18446744073709551615ULL - d) / 10ULL) return -1;
        v = v * 10ULL + d;
        any = 1;
        i++;
    }
    if (!any) return -1;
    *at = i;
    *out = v;
    return 0;
}

/* Single-pass P4 index builder: skips D/M/non-tape F payloads via lseek and records offsets/CRCs of
 * all tape/* F records into fdir[] so subsequent units do O(1) direct seeks without rescanning P4. */
static int tape_rt_scan_p4_fd(int fd, long pkg_off, long pkglen,
                              TapeFDirEntry fdir[TAPE_RT_MAX_FDIR], int *fdir_n_out) {
    M53FdScan sc;
    char line[512];
    unsigned char nbuf[128];
    long ln, at, i;
    int fn_cnt = 0;
    unsigned long long ver = 0, pm = 0, ps = 0, nr = 0;

    *fdir_n_out = 0;
    if (pkg_off < 0 || pkglen <= 0 || sy_lseek(fd, pkg_off, 0) != pkg_off) return -1;
    m53_fd_init(&sc, fd, pkg_off, pkg_off + pkglen);

    ln = m53_fd_line(&sc, line, (long)sizeof line);
    if (ln <= 0) return -1;
    at = 0;
    while (at < ln && (unsigned char)line[at] <= 32) at++;
    if (at >= ln || line[at++] != 'P' ||
        m53_tok_u64(line, &at, ln, &ver) != 0 || ver != 4ULL ||
        m53_tok_u64(line, &at, ln, &pm) != 0 || pm == 0ULL || pm > (unsigned long long)(pkglen / 8) ||
        m53_tok_u64(line, &at, ln, &ps) != 0 || ps == 0ULL || ps > (unsigned long long)(pkglen / 10) ||
        m53_tok_u64(line, &at, ln, &nr) != 0 || nr > (unsigned long long)(pkglen / 5)) return -1;

    for (i = 0; i < (long)ps; i++) {
        ln = m53_fd_line(&sc, line, (long)sizeof line);
        if (ln <= 0) return -1;
        at = 0;
        while (at < ln && (unsigned char)line[at] <= 32) at++;
        if (at >= ln || line[at] != 'D') return -1;
    }

    for (i = 0; i < (long)pm; i++) {
        unsigned long long mn = 0, mraw = 0, mcod = 0, msum = 0;
        ln = m53_fd_line(&sc, line, (long)sizeof line);
        if (ln <= 0) return -1;
        at = 0;
        while (at < ln && (unsigned char)line[at] <= 32) at++;
        if (at >= ln || line[at++] != 'M' ||
            m53_tok_u64(line, &at, ln, &mn) != 0 || mn == 0ULL ||
            m53_tok_u64(line, &at, ln, &mraw) != 0 ||
            m53_tok_u64(line, &at, ln, &mcod) != 0 ||
            m53_tok_u64(line, &at, ln, &msum) != 0 ||
            m53_fd_skip(&sc, (long)mn) != 0) return -1;
    }

    for (i = 0; i < (long)nr; i++) {
        unsigned long long fn = 0, flen = 0, fraw = 0, fcod = 0, fcrc = 0;
        long data_off;
        ln = m53_fd_line(&sc, line, (long)sizeof line);
        if (ln <= 0) return -1;
        at = 0;
        while (at < ln && (unsigned char)line[at] <= 32) at++;
        if (at >= ln || line[at++] != 'F' ||
            m53_tok_u64(line, &at, ln, &fn) != 0 || fn == 0ULL ||
            m53_tok_u64(line, &at, ln, &flen) != 0 ||
            m53_tok_u64(line, &at, ln, &fraw) != 0 ||
            m53_tok_u64(line, &at, ln, &fcod) != 0 ||
            m53_tok_u64(line, &at, ln, &fcrc) != 0 || fcrc > 4294967295ULL) return -1;
        if (fn >= 5ULL && fn < (unsigned long long)sizeof nbuf) {
            if (m53_fd_read(&sc, nbuf, (long)fn) != 0) return -1;
            data_off = m53_fd_tell(&sc);
            if (nbuf[0] == 't' && nbuf[1] == 'a' && nbuf[2] == 'p' && nbuf[3] == 'e' && nbuf[4] == '/') {
                int j, found = -1;
                for (j = 0; j < fn_cnt; j++) {
                    if (fdir[j].key_len == (long)fn && m53_m1_eq(fdir[j].key, fdir[j].key_len, (const char *)nbuf, (long)fn)) {
                        found = j;
                        break;
                    }
                }
                if (found >= 0) {
                    fdir[found].dup = 1;
                } else if (fn_cnt < TAPE_RT_MAX_FDIR) {
                    TapeFDirEntry *e = &fdir[fn_cnt++];
                    mm_copy(e->key, (long)sizeof e->key, nbuf, (long)fn);
                    e->key[fn] = 0;
                    e->key_len = (long)fn;
                    e->data_off = data_off;
                    e->len = (long)flen;
                    e->rawlen = (long)fraw;
                    e->crc = (unsigned)fcrc;
                    e->codec = (int)fcod;
                    e->dup = 0;
                }
            }
        } else {
            if (m53_fd_skip(&sc, (long)fn) != 0) return -1;
        }
        if (m53_fd_skip(&sc, (long)flen) != 0) return -1;
    }
    if (m53_fd_tell(&sc) != pkg_off + pkglen) return -1;
    *fdir_n_out = fn_cnt;
    return 0;
}

static const TapeFDirEntry *tape_fdir_find(const TapeFDirEntry *fdir, int n, const char *key) {
    long kl = m53_m1_len(key, 128);
    int i;
    for (i = 0; i < n; i++) {
        if (fdir[i].key_len == kl && m53_m1_eq(fdir[i].key, kl, key, kl)) return &fdir[i];
    }
    return 0;
}

/* Read one indexed tape/* F record via direct lseek + sy_read_full and enforce G1 CRC/codec/bounds. */
static unsigned char *tape_fdir_read_checked(int fd, const TapeFDirEntry *e, int k, long max_bytes,
                                             long *len_out, const char **reason_out, int *detail_out) {
    unsigned char *buf;
    if (!e) { *reason_out = "embed-resource-missing"; *detail_out = k + 1; return 0; }
    if (e->dup) { *reason_out = "embed-resource-duplicate"; *detail_out = k + 1; return 0; }
    if (e->codec != 0) { *reason_out = "embed-pkg-decode-failed"; *detail_out = 20 + k; return 0; }
    if (e->len <= 0 || e->rawlen != e->len || e->len > max_bytes) {
        *reason_out = "embed-pkg-decode-failed"; *detail_out = 30 + k; return 0;
    }
    buf = (unsigned char *)mm_alloc(e->len);
    if (!buf) { *reason_out = "embed-pkg-decode-failed"; *detail_out = 10; return 0; }
    if (sy_lseek(fd, e->data_off, 0) != e->data_off || sy_read_full(fd, buf, e->len) != 0) {
        mm_free(buf); *reason_out = "embed-pkg-decode-failed"; *detail_out = 10; return 0;
    }
    if (m53_m1_crc32(buf, e->len) != e->crc) {
        mm_free(buf); *reason_out = "embed-pkg-decode-failed"; *detail_out = k; return 0;
    }
    *len_out = e->len;
    return buf;
}

static int m53_m1_locate_pkg_fd(int fd, long apen, long *pkg_off_out, long *pkglen_out) {
    unsigned char h4[4], foot[16];
    unsigned long long plen;
    if (apen < 4) return -1;
    if (sy_lseek(fd, 0, 0) != 0 || sy_read_full(fd, h4, 4) != 0) return -1;
    if (h4[0] == 'P' && h4[1] == ' ') {
        *pkg_off_out = 0;
        *pkglen_out = apen;
        return 0;
    }
    if (apen >= 16 && sy_lseek(fd, apen - 16, 0) == apen - 16 && sy_read_full(fd, foot, 16) == 0 &&
        foot[0] == 85 && foot[1] == 78 && foot[2] == 73 && foot[3] == 80 &&
        foot[4] == 75 && foot[5] == 71 && foot[6] == 49 && foot[7] == 10) {
        plen = m53_m1_rd_u(foot + 8, 8);
        if (plen > 0ULL && plen <= (unsigned long long)(apen - 16)) {
            *pkg_off_out = apen - 16 - (long)plen;
            *pkglen_out = (long)plen;
            return 0;
        }
    }
    {
        unsigned char *ape = (unsigned char *)mm_alloc(apen);
        PackageFooter pf;
        int ok = 0;
        if (!ape) return -1;
        if (sy_lseek(fd, 0, 0) == 0 && sy_read_full(fd, ape, apen) == 0 &&
            packagefooter_locate_bytes(ape, apen, &pf) &&
            pf.package_offset >= 0 && pf.package_length > 0 &&
            pf.package_offset + pf.package_length <= apen) {
            *pkg_off_out = pf.package_offset;
            *pkglen_out = pf.package_length;
            ok = 1;
        }
        mm_free(ape);
        return ok ? 0 : -1;
    }
}

/* Boot or reload the ONE shared TapeRuntime per process (footer + P4 fdir + manifest + tapemode.so). */
static int tape_rt_ensure(TapeUnitState *u, const TapeUnitSpec *sp, const char *cpath,
                          int *fd_inout, sy_stat_t *st_inout) {
    static const char *const sym_names[3] = {
        "hoststub_lnx_x86_64_bind",
        "hoststub_lnx_x86_64",
        "tape_run_x86_64"
    };
    TapeRuntime *rt = &g_tape_rt;
    TapeFDirEntry new_fdir[TAPE_RT_MAX_FDIR];
    int new_fn = 0, rc, i;
    long apen, pkg_off = 0, pkglen = 0, mf_len = 0, so_len = 0;
    unsigned char *mf_buf = 0, *so_buf = 0;
    unsigned char so_h[32];
    char so_sha[65];
    const char *er = 0;
    int ed = 0;
    tsl_img_t new_tsl;
    void *new_bind = 0, *new_disp = 0, *new_run = 0;
    long t0 = tape_mono_ns();

    if (*fd_inout < 0) {
        *fd_inout = sy_open_read(cpath);
        if (*fd_inout < 0) {
            tape_rt_drop(rt);
            rt->state = M53_M1_REFUSED;
            return tape_unit_fail(u, sp, "embed-container-missing", *fd_inout);
        }
        if (sy_fstat(*fd_inout, st_inout) != 0 || st_inout->kind != 'f' ||
            st_inout->size <= 0 || st_inout->size > M53_M1_MAX_APE) {
            tape_rt_drop(rt);
            rt->state = M53_M1_REFUSED;
            return tape_unit_fail(u, sp, "embed-container-missing", -EINVAL);
        }
    }
    if (tape_rt_stat_hit(rt, cpath, st_inout)) return 0;

    apen = (long)st_inout->size;
    rt->state = M53_M1_LOADING;
    if (m53_m1_locate_pkg_fd(*fd_inout, apen, &pkg_off, &pkglen) != 0) {
        tape_rt_drop(rt); rt->state = M53_M1_REFUSED;
        return tape_unit_fail(u, sp, "embed-footer-invalid", 0);
    }
    if (tape_rt_scan_p4_fd(*fd_inout, pkg_off, pkglen, new_fdir, &new_fn) != 0) {
        tape_rt_drop(rt); rt->state = M53_M1_REFUSED;
        return tape_unit_fail(u, sp, "embed-pkg-decode-failed", 10);
    }

    mf_buf = tape_fdir_read_checked(*fd_inout, tape_fdir_find(new_fdir, new_fn, sp->mf_key),
                                    0, M53_M1_MAX_MF, &mf_len, &er, &ed);
    if (!mf_buf) {
        tape_rt_drop(rt); rt->state = M53_M1_REFUSED;
        return tape_unit_fail(u, sp, er ? er : "embed-pkg-decode-failed", ed);
    }
    so_buf = tape_fdir_read_checked(*fd_inout, tape_fdir_find(new_fdir, new_fn, sp->so_key),
                                    1, M53_M1_MAX_SO, &so_len, &er, &ed);
    if (!so_buf) {
        mm_free(mf_buf);
        tape_rt_drop(rt); rt->state = M53_M1_REFUSED;
        return tape_unit_fail(u, sp, er ? er : "embed-pkg-decode-failed", ed);
    }

    cx_sha256(so_buf, (size_t)so_len, so_h);
    m53_m1_hex(so_h, so_sha);
    if (m53_m1_check_mf_line((const char *)mf_buf, mf_len, sp->so_leaf, so_sha, so_len) != 0) {
        mm_free(so_buf); mm_free(mf_buf);
        tape_rt_drop(rt); rt->state = M53_M1_REFUSED;
        return tape_unit_fail(u, sp, "embed-manifest-mismatch", 1);
    }

    mm_fill(&new_tsl, (long)sizeof new_tsl, 0, (long)sizeof new_tsl);
    rc = tsl_check(so_buf, so_len, sym_names, &new_tsl);
    if (rc != 0) {
        mm_free(so_buf); mm_free(mf_buf);
        tape_rt_drop(rt); rt->state = M53_M1_REFUSED;
        return tape_unit_fail(u, sp, "embed-so-invalid", rc);
    }
    rc = tsl_map(so_buf, so_len, &new_tsl);
    mm_free(so_buf); so_buf = 0;
    if (rc != 0) {
        mm_free(mf_buf);
        tape_rt_drop(rt); rt->state = M53_M1_REFUSED;
        return tape_unit_fail(u, sp, "embed-so-map-failed", rc);
    }
    new_bind = tsl_addr(&new_tsl, 0);
    new_disp = tsl_addr(&new_tsl, 1);
    new_run = tsl_addr(&new_tsl, 2);
    if (!new_bind || !new_disp || !new_run) {
        tsl_unload(&new_tsl); mm_free(mf_buf);
        tape_rt_drop(rt); rt->state = M53_M1_REFUSED;
        return tape_unit_fail(u, sp, "embed-so-map-failed", 20);
    }

    /* Atomic swap into shared TapeRuntime (bumps rt->gen so all units lazily re-verify slices). */
    tape_rt_drop(rt);
    for (i = 0; i < TSL_I_WORDS; i++) rt->tsl[i] = new_tsl[i];
    for (i = 0; i < new_fn; i++) rt->fdir[i] = new_fdir[i];
    rt->fdir_n = new_fn;
    rt->mf = mf_buf;
    rt->mf_len = mf_len;
    rt->bind_fn = new_bind;
    rt->disp_fn = new_disp;
    rt->run_fn = new_run;
    m53_m1_cpy(rt->cache.path, (long)sizeof rt->cache.path, cpath);
    rt->cache.dev = st_inout->dev;
    rt->cache.ino = st_inout->ino;
    rt->cache.size = st_inout->size;
    rt->cache.mtime = st_inout->mtime;
    rt->cache.mtime_ns = st_inout->mtime_ns;
    rt->cache.ctime_ns = st_inout->ctime_ns;
    rt->cache.valid = 1;
    rt->state = M53_M1_READY;
    rt->boot_count++;
    rt->boot_ns += (tape_mono_ns() - t0);
    return 0;
}

/* Lazy per-unit slice loader: O(1) seek from shared g_tape_rt.fdir[] + G1 CRC + manifest + UTAPEBIN. */
static int tape_unit_ensure_slice(TapeUnitState *u, const TapeUnitSpec *sp,
                                  const char *cpath, int *fd_inout) {
    TapeRuntime *rt = &g_tape_rt;
    unsigned char *sl_buf = 0;
    unsigned char sl_h[32];
    char sl_sha[65];
    long sl_len = 0;
    unsigned long long new_clen = 0, new_doff = 0, new_dlen = 0, new_bsz = 0;
    const char *er = 0;
    int ed = 0;
    long t0 = tape_mono_ns();

    if (u->state == M53_M1_READY && u->rt_gen == rt->gen && u->slice) return 0;

    if (*fd_inout < 0) {
        *fd_inout = sy_open_read(cpath);
        if (*fd_inout < 0) {
            tape_unit_drop_slice(u);
            return tape_unit_fail(u, sp, "embed-container-missing", *fd_inout);
        }
    }
    sl_buf = tape_fdir_read_checked(*fd_inout, tape_fdir_find(rt->fdir, rt->fdir_n, sp->sl_key),
                                    2, M53_M1_MAX_SL, &sl_len, &er, &ed);
    if (!sl_buf) {
        tape_unit_drop_slice(u);
        return tape_unit_fail(u, sp, er ? er : "embed-pkg-decode-failed", ed);
    }
    cx_sha256(sl_buf, (size_t)sl_len, sl_h);
    m53_m1_hex(sl_h, sl_sha);
    if (m53_m1_check_mf_line((const char *)rt->mf, rt->mf_len, sp->sl_leaf, sl_sha, sl_len) != 0) {
        mm_free(sl_buf);
        tape_unit_drop_slice(u);
        return tape_unit_fail(u, sp, "embed-manifest-mismatch", 2);
    }
    if (tape_unit_validate_slice(sl_buf, sl_len, sp->abi_tag, sp->abi_tag_len,
                                 &new_clen, &new_doff, &new_dlen, &new_bsz) != 0) {
        mm_free(sl_buf);
        tape_unit_drop_slice(u);
        return tape_unit_fail(u, sp, "embed-slice-corrupt", 1);
    }
    tape_unit_drop_slice(u);
    u->slice = sl_buf;
    u->slice_len = sl_len;
    u->code_len = new_clen;
    u->data_off = new_doff;
    u->data_len = new_dlen;
    u->bss_size = new_bsz;
    u->rt_gen = rt->gen;
    u->state = M53_M1_READY;
    tape_unit_sha_record(rt, (const void *)u, sl_buf, sl_len, rt->gen, sl_h);
    u->slice_load_ns += (tape_mono_ns() - t0);
    return 0;
}

/* Parameterized VM result classifier: validates [0..max_ret] domain without & 255 truncation. */
static long tape_unit_classify_vm_domain(long call_rc, const unsigned long long res[4],
                                         unsigned long long max_ret,
                                         const char **reason_out, int *detail_out) {
    if (reason_out) *reason_out = 0;
    if (detail_out) *detail_out = 0;
    if (call_rc != 0L) {
        if (reason_out) *reason_out = "embed-vm-call-failed";
        if (detail_out) *detail_out = (int)call_rc;
        return -2L;
    }
    if (!res) {
        if (reason_out) *reason_out = "embed-vm-fault";
        if (detail_out) *detail_out = -1;
        return -2L;
    }
    if (res[0] != 0ULL) {
        if (reason_out) *reason_out = "embed-vm-fault";
        if (detail_out) *detail_out = (int)(res[2] ? res[2] : res[0]);
        return -2L;
    }
    if (res[3] > max_ret) {
        if (reason_out) *reason_out = "embed-vm-bad-return";
        if (detail_out) *detail_out = res[3] <= 2147483647ULL ? (int)res[3] : 2147483647;
        return -2L;
    }
    return (long)res[3];
}

int m53_m1_classify_vm_result(long call_rc, const unsigned long long res[4],
                              const char **reason_out, int *detail_out) {
    return (int)tape_unit_classify_vm_domain(call_rc, res, 1ULL, reason_out, detail_out);
}

static long tape_unit_classify_run_domain(long rrc, const unsigned long long res[4],
                                          unsigned long long max_ret,
                                          const char **reason_out, int *detail_out) {
    if (reason_out) *reason_out = 0;
    if (detail_out) *detail_out = 0;
    if (!res) {
        if (reason_out) *reason_out = "embed-vm-fault";
        if (detail_out) *detail_out = -1;
        return -2L;
    }
    if (res[0] == M53_M1_RES_SENTINEL || res[1] == M53_M1_RES_SENTINEL ||
        res[2] == M53_M1_RES_SENTINEL || res[3] == M53_M1_RES_SENTINEL) {
        if (reason_out) *reason_out = "embed-vm-unwritten";
        if (detail_out) *detail_out = -4;
        return -2L;
    }
    if (res[0] == 3ULL) {
        if (reason_out) *reason_out = "embed-vm-budget";
        if (detail_out) *detail_out = 3;
        return -2L;
    }
    if (res[0] != 0ULL) {
        if (reason_out) *reason_out = "embed-vm-fault";
        if (detail_out) *detail_out = (int)(res[2] ? res[2] : res[0]);
        return -2L;
    }
    if (res[1] == 0ULL) {
        if (reason_out) *reason_out = "embed-vm-unwritten";
        if (detail_out) *detail_out = -5;
        return -2L;
    }
    if (rrc != (long)res[3]) {
        long err = rrc ? rrc : -3L;
        if (reason_out) *reason_out = "embed-vm-call-failed";
        if (detail_out) *detail_out = (int)err;
        return -2L;
    }
    return tape_unit_classify_vm_domain(0L, res, max_ret, reason_out, detail_out);
}

int m53_m1_classify_run_result(long rrc, const unsigned long long res[4],
                               const char **reason_out, int *detail_out) {
    return (int)tape_unit_classify_run_domain(rrc, res, 1ULL, reason_out, detail_out);
}

static int tape_rt_ensure_arena(TapeRuntime *rt, long memlimit, long ibitmap_cap) {
    if (memlimit > rt->vm_mem_cap) {
        long want = memlimit < 131072L ? 131072L : memlimit;
        unsigned char *p = (unsigned char *)mm_alloc(want);
        if (!p) return -1;
        mm_fill(p, want, 0, want);
        if (rt->vm_mem) mm_free(rt->vm_mem);
        rt->vm_mem = p;
        rt->vm_mem_cap = want;
    }
    if (ibitmap_cap > rt->vm_ibm_cap) {
        long want = ibitmap_cap < 4096L ? 4096L : ibitmap_cap;
        unsigned char *p = (unsigned char *)mm_alloc(want);
        if (!p) return -1;
        mm_fill(p, want, 0, want);
        if (rt->vm_ibm) mm_free(rt->vm_ibm);
        rt->vm_ibm = p;
        rt->vm_ibm_cap = want;
    }
    return 0;
}

static long tape_unit_vm_exec(TapeUnitState *u, const TapeUnitSpec *sp,
                              const unsigned char *data, long length) {
    TapeRuntime *rt = &g_tape_rt;
    unsigned long long data_aligned, copy_n, in_off, in_end, argv_at, argbuf_off, memlimit, ibitmap_cap;
    unsigned char *mem, *ibm;
    unsigned long long args[12], result[5], res4[4], *guest_argv, *bin_blk;
    unsigned char cur_sha[32];
    const char *why = 0;
    long brc, rrc, ret;
    int i, det = 0, ibm_cached;

    if (!rt->tsl[TSL_I_BASE] || !u->slice || !rt->bind_fn || !rt->disp_fn || !rt->run_fn) {
        tape_emit_refuse(sp->refuse_tag, "embed-vm-call-failed", -1);
        return -2L;
    }
    if (u->data_len > ~7ULL) {
        tape_emit_refuse(sp->refuse_tag, "embed-vm-call-failed", -2);
        return -2L;
    }
    data_aligned = (u->data_len + 7ULL) & ~7ULL;
    if (u->bss_size > 0x20000000ULL - 65536ULL - data_aligned) {
        tape_emit_refuse(sp->refuse_tag, "embed-vm-call-failed", -2);
        return -2L;
    }
    in_off = data_aligned + u->bss_size;
    copy_n = (data && length > 0) ? (unsigned long long)length : 0ULL;
    in_end = (in_off + copy_n + 7ULL) & ~7ULL;
    argv_at = in_end + 65536ULL;
    argbuf_off = argv_at + 64ULL;
    memlimit = argbuf_off + 128ULL;
    ibitmap_cap = (u->code_len >> 3) + ((u->code_len & 7ULL) != 0ULL ? 1ULL : 0ULL);
    if (ibitmap_cap == 0ULL) ibitmap_cap = 1ULL;

    if (tape_rt_ensure_arena(rt, (long)memlimit, (long)ibitmap_cap) != 0) {
        tape_emit_refuse(sp->refuse_tag, "embed-vm-call-failed", -2);
        return -2L;
    }
    mem = rt->vm_mem;
    /* Clear full guest-observable arena [0, memlimit) on every call (BSS + stack + old input + tail). */
    tape_zero_fast(mem, (long)memlimit);
    if (u->data_len > 0ULL && mm_copy(mem, (long)memlimit, u->slice + u->data_off, (long)u->data_len)) {
        tape_emit_refuse(sp->refuse_tag, "embed-vm-call-failed", -2);
        return -2L;
    }
    if (copy_n > 0ULL && mm_copy(mem + in_off, (long)(memlimit - in_off), data, (long)copy_n)) {
        tape_emit_refuse(sp->refuse_tag, "embed-vm-call-failed", -2);
        return -2L;
    }

    guest_argv = (unsigned long long *)(mem + argv_at);
    /* Fixed little-endian u64 binary argument block at mem + argbuf_off: [ptr, len] for all units. */
    bin_blk = (unsigned long long *)(mem + argbuf_off);
    bin_blk[0] = data ? (unsigned long long)(mem + in_off) : 0ULL;
    bin_blk[1] = (unsigned long long)length;
    bin_blk[2] = 0ULL;
    guest_argv[0] = (unsigned long long)(mem + argbuf_off + 16ULL);
    guest_argv[1] = (unsigned long long)bin_blk;
    guest_argv[2] = (unsigned long long)(mem + argbuf_off + 16ULL);
    guest_argv[3] = 0ULL;

    if (!tape_unit_sha_lookup(rt, (const void *)u, u->slice, u->slice_len, rt->gen, cur_sha)) {
        cx_sha256(u->slice, (size_t)u->slice_len, cur_sha);
    }

    TapeIbmSlot *slot = 0;
    ibm_cached = 0;
    for (i = 0; i < 16; i++) {
        if (rt->ibm_cache[i].slice == u->slice && rt->ibm_cache[i].slice_len == u->slice_len &&
            rt->ibm_cache[i].gen == rt->gen &&
            m53_m1_eq((const char *)rt->ibm_cache[i].sha, 32L, (const char *)cur_sha, 32L) &&
            rt->ibm_cache[i].ibm && rt->ibm_cache[i].cap >= (long)ibitmap_cap) {
            slot = &rt->ibm_cache[i];
            ibm_cached = 1;
            break;
        }
    }
    if (!ibm_cached) {
        for (i = 0; i < 16; i++) {
            if (!rt->ibm_cache[i].slice || rt->ibm_cache[i].gen != rt->gen) { slot = &rt->ibm_cache[i]; break; }
        }
        if (!slot) slot = &rt->ibm_cache[0];
        if (!slot->ibm || slot->cap < (long)ibitmap_cap) {
            unsigned char *nb = (unsigned char *)mm_alloc((long)ibitmap_cap);
            if (!nb) {
                tape_emit_refuse(sp->refuse_tag, "embed-vm-call-failed", -2);
                return -2L;
            }
            if (slot->ibm) mm_free(slot->ibm);
            slot->ibm = nb;
            slot->cap = (long)ibitmap_cap;
        }
        slot->slice = 0;
        slot->slice_len = 0;
        slot->gen = 0;
        mm_fill(slot->sha, 32L, 0, 32L);
        mm_fill(slot->ibm, (long)ibitmap_cap, 0, (long)ibitmap_cap);
    }
    ibm = slot->ibm;

    brc = tsl_call2(&rt->tsl, rt->bind_fn, (long)mem, (long)memlimit);
    if (brc != 0L) {
        tape_emit_refuse(sp->refuse_tag, "embed-vm-call-failed", (int)brc);
        return -2L;
    }
    for (i = 0; i < 12; i++) args[i] = 0ULL;
    for (i = 0; i < 5; i++) result[i] = M53_M1_RES_SENTINEL;
    args[0] = ibm_cached ? 260ULL : 4ULL;
    args[1] = (unsigned long long)u->slice;
    args[2] = memlimit;
    args[3] = sp->budget ? sp->budget : 2000000ULL;
    args[4] = 3ULL;
    args[5] = (unsigned long long)guest_argv;
    args[6] = (unsigned long long)result;
    args[7] = (unsigned long long)u->slice_len;
    args[8] = (unsigned long long)rt->disp_fn;
    args[9] = (unsigned long long)mem;
    args[10] = (unsigned long long)ibm;
    args[11] = ibitmap_cap;

    rrc = tsl_call2(&rt->tsl, rt->run_fn, (long)args, 0L);
    if (!ibm_cached && result[0] == 0ULL) {
        slot->slice = u->slice;
        slot->slice_len = u->slice_len;
        slot->gen = rt->gen;
        mm_copy(slot->sha, 32L, cur_sha, 32L);
    }

    res4[0] = result[0];
    res4[1] = result[2];
    res4[2] = result[4];
    res4[3] = result[1];
    ret = tape_unit_classify_run_domain(rrc, res4, sp->max_ret, &why, &det);
    if (ret < 0L) {
        tape_emit_refuse(sp->refuse_tag, why ? why : "embed-vm-fault", det);
        return -2L;
    }
    return ret;
}

/* Measure-ready hooks for per-process shared runtime and per-unit first-call/repeat ms. */
void tape_rt_stats(long *boot_count_out, long *boot_ns_out) {
    if (boot_count_out) *boot_count_out = g_tape_rt.boot_count;
    if (boot_ns_out) *boot_ns_out = g_tape_rt.boot_ns;
}

void tape_unit_stats(const TapeUnitState *u, long *calls_out, long *slice_load_ns_out,
                     long *first_ns_out, long *repeat_ns_out) {
    if (!u) return;
    if (calls_out) *calls_out = u->calls;
    if (slice_load_ns_out) *slice_load_ns_out = u->slice_load_ns;
    if (first_ns_out) *first_ns_out = u->first_ns;
    if (repeat_ns_out) *repeat_ns_out = u->repeat_ns;
}

void tape_unit_m53_stats(long *calls_out, long *slice_load_ns_out,
                         long *first_ns_out, long *repeat_ns_out) {
    tape_unit_stats(&m53_m1_unit, calls_out, slice_load_ns_out, first_ns_out, repeat_ns_out);
}

/* Shared unit-agnostic entry point for any embedded tape unit (m53, packmodel, batch 1+). */
long tape_unit_call_bytes(TapeUnitState *u, const TapeUnitSpec *sp,
                          const unsigned char *data, long length) {
    const char *env_s1 = sy_env("UNISACC_M53_S1");
    const char *env_so = sy_env("UNISACC_M53_S1_SO");
    char selfp[4096];
    const char *cpath;
    sy_stat_t st;
    int fd = -1;
    long t0, dt, ret;

    if (!u || !sp) return -2L;
    if ((env_s1 && env_s1[0]) || (env_so && env_so[0])) {
        tape_emit_refuse(sp->refuse_tag, "embed-env-override-forbidden", 0);
        return -2L;
    }
    if (u->busy || g_tape_rt.busy) {
        tape_emit_refuse(sp->refuse_tag, "embed-reentrant", 0);
        return -2L;
    }
    if (length > M53_M1_MAX_IN) {
        tape_emit_refuse(sp->refuse_tag, "embed-input-too-large", 0);
        return -2L;
    }

    t0 = tape_mono_ns();
    u->busy = 1;
    g_tape_rt.busy = 1;

    cpath = sy_env("UNISA_CONTAINER");
    if (!cpath || !cpath[0]) {
        if (sy_self_path(selfp, (int)sizeof selfp) != 0) {
            tape_rt_drop(&g_tape_rt);
            g_tape_rt.state = M53_M1_REFUSED;
            tape_unit_drop_slice(u);
            ret = (long)tape_unit_fail(u, sp, "embed-container-missing", -ENOENT);
            u->busy = 0; g_tape_rt.busy = 0;
            return ret;
        }
        cpath = selfp;
    }

    /* Fast path: 1 sy_stat syscall when shared runtime + this unit slice are already loaded. */
    if (g_tape_rt.state == M53_M1_READY && u->state == M53_M1_READY &&
        u->rt_gen == g_tape_rt.gen && u->slice &&
        sy_stat(cpath, &st) == 0 && st.kind == 'f' &&
        tape_rt_stat_hit(&g_tape_rt, cpath, &st)) {
        ret = tape_unit_vm_exec(u, sp, data, length);
    } else {
        if (tape_rt_ensure(u, sp, cpath, &fd, &st) != 0 ||
            tape_unit_ensure_slice(u, sp, cpath, &fd) != 0) {
            if (fd >= 0) sy_close(fd);
            u->busy = 0; g_tape_rt.busy = 0;
            return -2L;
        }
        if (fd >= 0) sy_close(fd);
        ret = tape_unit_vm_exec(u, sp, data, length);
    }

    dt = tape_mono_ns() - t0;
    if (u->calls == 0L) u->first_ns = dt;
    else u->repeat_ns += dt;
    u->calls++;
    u->busy = 0;
    g_tape_rt.busy = 0;
    return ret;
}

int cxsa_valid_s1(const unsigned char *data, long length) {
    const char *env_s1 = sy_env("UNISACC_M53_S1");
    const char *env_so = sy_env("UNISACC_M53_S1_SO");
    if ((env_s1 && env_s1[0]) || (env_so && env_so[0])) {
        tape_emit_refuse(m53_m1_spec.refuse_tag, "embed-env-override-forbidden", 0);
        return -2;
    }
    if (m53_m1_unit.busy || g_tape_rt.busy) {
        tape_emit_refuse(m53_m1_spec.refuse_tag, "embed-reentrant", 0);
        return -2;
    }
    if (!data || length < 4) return 0;
    return (int)tape_unit_call_bytes(&m53_m1_unit, &m53_m1_spec, data, length);
}
