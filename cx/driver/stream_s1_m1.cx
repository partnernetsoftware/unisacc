#pragma unisa module stream_s1_m1
#pragma unisa use runtime.packagefooter
#pragma unisa use runtime.package_decode
#pragma unisa use runtime.package_lifetime
#pragma unisa use driver.tape_soload
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
/* M1 authoritative embedded-carrier stream_s1 for lnx/x86_64:
 * - Zero dependency on runtime.stream_attributes (no native cxsa_valid, no fallback).
 * - Decodes P4 package body via runtime.package_decode (cxpk_decode) without altering
 *   shared package_decode.cx (preserving codec=0 crc=0 compatibility and byte-unchanged
 *   other 5 slices).
 * - Enforces G1 gate strictly on the 3 embedded tape/lnx-x86_64/* F records:
 *     ver >= 4, codec == 0, 0 < len == rawlen <= per-item max, explicit IEEE CRC32 == r->crc.
 * - Returns 1 (valid), 0 (invalid attr table), or -2 (integrity/carrier refusal with
 *   M53_M1_REFUSE\treason=<name>\tdetail=<int> on stderr). */

enum {
    M53_M1_UNBOOTED = 0,
    M53_M1_LOADING = 1,
    M53_M1_READY = 2,
    M53_M1_REFUSED = 3,
    M53_M1_MAX_APE = 67108864L,
    M53_M1_MAX_IN = 16777216L,
    M53_M1_MAX_MF = 65536L,
    M53_M1_MAX_SO = 1048576L,
    M53_M1_MAX_SL = 4194304L,
    M53_M1_MASK = 383ULL
};

static const unsigned long long M53_M1_RES_SENTINEL = 0x554e575249545445ULL;

typedef struct {
    char path[4096];
    unsigned long dev;
    long ino;
    long size;
    long mtime;
    int64_t mtime_ns;
    int64_t ctime_ns;
    unsigned char tape_sha[32];
    int valid;
} M53CacheKey;

static int m53_m1_state;
static int m53_m1_busy;
static int m53_m1_detail;
static char m53_m1_reason[64];
static M53CacheKey m53_m1_cache;
static unsigned char *m53_m1_slice;
static long m53_m1_slice_len;
static unsigned long long m53_m1_code_len;
static unsigned long long m53_m1_data_off;
static unsigned long long m53_m1_data_len;
static unsigned long long m53_m1_bss_size;
static tsl_img_t m53_m1_tsl;
static void *m53_m1_bind_fn;
static void *m53_m1_disp_fn;
static void *m53_m1_run_fn;

static long m53_m1_len(const char *s, long cap) {
    long i = 0;
    if (!s) return 0;
    while (i < cap && s[i]) i++;
    return i;
}

static void m53_m1_cpy(char *dst, long cap, const char *src) {
    long i = 0;
    if (!dst || cap <= 0) return;
    if (src) while (src[i] && i + 1 < cap) { dst[i] = src[i]; i++; }
    dst[i] = 0;
}

static int m53_m1_eq(const char *a, long al, const char *b, long bl) {
    long i = 0;
    if (al != bl) return 0;
    while (i < al) { if (a[i] != b[i]) return 0; i++; }
    return 1;
}

static unsigned long long m53_m1_rd_u(const unsigned char *p, int k) {
    unsigned long long v = 0;
    int i = k - 1;
    while (i >= 0) { v = (v << 8) | (unsigned long long)(p[i] & 255); i--; }
    return v;
}

static void m53_m1_wr_i64_dec(char *dst, long cap, long long v) {
    char tmp[32];
    int n = 0, i = 0;
    unsigned long long uv;
    if (!dst || cap <= 0) return;
    if (v == 0) { if (cap > 1) { dst[0] = '0'; dst[1] = 0; } else dst[0] = 0; return; }
    if (v < 0) {
        if (i + 1 < cap) dst[i++] = '-';
        uv = (unsigned long long)(-(v + 1)) + 1ULL;
    } else uv = (unsigned long long)v;
    while (uv > 0 && n < 32) { tmp[n++] = (char)('0' + (uv % 10ULL)); uv /= 10ULL; }
    while (n > 0 && i + 1 < cap) dst[i++] = tmp[--n];
    dst[i] = 0;
}

static int m53_m1_bytes_eq(const unsigned char *a, const unsigned char *b, long n) {
    long i;
    for (i = 0; i < n; i++) if (a[i] != b[i]) return 0;
    return 1;
}

/* IEEE CRC32 (poly 0xedb88320, bit-identical to runtime.codec cxcodec_crc). */
static unsigned m53_m1_crc32(const unsigned char *p, long n) {
    unsigned c = 4294967295U;
    long i;
    int j;
    for (i = 0; i < n; i++) {
        c ^= (unsigned)p[i];
        for (j = 0; j < 8; j++) c = (c & 1U) ? ((c >> 1) ^ 3988292384U) : (c >> 1);
    }
    return c ^ 4294967295U;
}

static void *m53_m1_pk_alloc(void *prev, size_t n) {
    (void)prev;
    return mm_alloc((long)(n ? n : 1));
}

static void m53_m1_pk_free(void *p) {
    if (p) mm_free(p);
}

static void m53_m1_hex(const unsigned char h[32], char out[65]) {
    static const char hx[] = "0123456789abcdef";
    int i;
    for (i = 0; i < 32; i++) {
        out[i * 2] = hx[(h[i] >> 4) & 15];
        out[i * 2 + 1] = hx[h[i] & 15];
    }
    out[64] = 0;
}

static void m53_m1_emit_refuse(const char *reason, int detail) {
    char buf[160], num[24];
    long p = 0, i = 0, nn = 0;
    const char *pre = "M53_M1_REFUSE\treason=";
    const char *mid = "\tdetail=";
    unsigned long long uv;
    while (pre[i] && p + 1 < (long)sizeof buf) buf[p++] = pre[i++];
    i = 0;
    if (reason) while (reason[i] && p + 1 < (long)sizeof buf) buf[p++] = reason[i++];
    i = 0;
    while (mid[i] && p + 1 < (long)sizeof buf) buf[p++] = mid[i++];
    if (detail < 0) { if (p + 1 < (long)sizeof buf) buf[p++] = '-'; uv = (unsigned long long)(-(long long)detail); }
    else uv = (unsigned long long)detail;
    if (uv == 0) num[nn++] = '0';
    else while (uv > 0 && nn < (long)sizeof num) { num[nn++] = (char)('0' + (uv % 10ULL)); uv /= 10ULL; }
    while (nn > 0 && p + 1 < (long)sizeof buf) buf[p++] = num[--nn];
    if (p + 1 < (long)sizeof buf) buf[p++] = '\n';
    (void)sy_write_all(2, buf, p);
}

static int m53_m1_fail(const char *reason, int detail) {
    m53_m1_state = M53_M1_REFUSED;
    m53_m1_detail = detail;
    m53_m1_cpy(m53_m1_reason, sizeof m53_m1_reason, reason);
    m53_m1_emit_refuse(reason, detail);
    return -2;
}

static int m53_m1_parse_dec(const char *s, long n, long *out) {
    long v = 0, i = 0;
    if (n <= 0) return -1;
    while (i < n) {
        if (s[i] < '0' || s[i] > '9') return -1;
        if (v > (M53_M1_MAX_APE - (long)(s[i] - '0')) / 10) return -1;
        v = v * 10 + (long)(s[i] - '0');
        i++;
    }
    *out = v;
    return 0;
}

static int m53_m1_check_mf_line(const char *mf, long mfn, const char *name, const char sha[65], long bytes) {
    long nl = m53_m1_len(name, 64), at = 0;
    int found = 0;
    while (at < mfn) {
        long e = at;
        while (e < mfn && mf[e] != '\n') e++;
        long ln = e - at;
        if (ln > 0 && mf[at] != '#') {
            long t1 = -1, t2 = -1, i;
            for (i = 0; i < ln; i++) {
                if (mf[at + i] == '\t') {
                    if (t1 < 0) t1 = i;
                    else if (t2 < 0) t2 = i;
                }
            }
            if (t1 == nl && m53_m1_eq(mf + at, t1, name, nl) && t2 > t1) {
                long sl = t2 - (t1 + 1), bl = ln - (t2 + 1), bv = -1;
                if (sl != 64 || !m53_m1_eq(mf + at + t1 + 1, 64, sha, 64)) return -1;
                if (m53_m1_parse_dec(mf + at + t2 + 1, bl, &bv) != 0 || bv != bytes) return -1;
                if (found) return -1;
                found = 1;
            }
        }
        at = e + 1;
    }
    return found ? 0 : -1;
}

/* G1 authoritative extractor for the 3 embedded lnx/x86_64 tape F records.
 * Leaves non-tape P4 codec=0 crc=0 records untouched (zero regression for existing writers).
 * Refusal detail conventions for reason="embed-pkg-decode-failed":
 *   0/1/2   = raw IEEE CRC32 mismatch on manifest.tsv(0) / tapemode.so(1) / m53.tapeslice(2)
 *   10      = cxpk_decode failure or package version < 4 downgrade
 *   20..22  = codec != 0 (e.g. codec=1 bypass) on record k=0..2
 *   30..32  = len <= 0, rawlen != len, or len > max_k on record k=0..2 */
int m53_m1_extract_tape(const unsigned char *pkg, long pkglen,
                        const unsigned char *out_p[3], long out_n[3],
                        const char **reason_out, int *detail_out) {
    static const char *const keys[3] = {
        "tape/lnx-x86_64/manifest.tsv",
        "tape/lnx-x86_64/tapemode.so",
        "tape/lnx-x86_64/m53.tapeslice"
    };
    static const long key_len[3] = { 28, 27, 29 };
    static const long max_bytes[3] = { M53_M1_MAX_MF, M53_M1_MAX_SO, M53_M1_MAX_SL };
    CxPackageDecode dec;
    int i, k;
    out_p[0] = 0; out_p[1] = 0; out_p[2] = 0;
    out_n[0] = 0; out_n[1] = 0; out_n[2] = 0;
    mm_fill(&dec, (long)sizeof dec, 0, (long)sizeof dec);
    dec.allocate = m53_m1_pk_alloc;
    dec.release = m53_m1_pk_free;
    if (!pkg || pkglen <= 0 || cxpk_decode(&dec, pkg, pkglen) != 0) {
        *reason_out = "embed-pkg-decode-failed";
        *detail_out = 10;
        return -1;
    }
    if (dec.package.ver < 4) {
        cxpl_release(&dec.package, m53_m1_pk_free);
        *reason_out = "embed-pkg-decode-failed";
        *detail_out = 10;
        return -1;
    }
    for (i = 0; i < dec.package.nr; i++) {
        const CxPackageResource *r = &dec.package.res[i];
        const char *nm = (const char *)(pkg + r->name);
        for (k = 0; k < 3; k++) {
            if ((long)r->n == key_len[k] && m53_m1_eq(nm, (long)r->n, keys[k], key_len[k])) {
                if (out_p[k]) {
                    cxpl_release(&dec.package, m53_m1_pk_free);
                    *reason_out = "embed-resource-duplicate";
                    *detail_out = k + 1;
                    return -1;
                }
                if (r->codec != 0) {
                    cxpl_release(&dec.package, m53_m1_pk_free);
                    *reason_out = "embed-pkg-decode-failed";
                    *detail_out = 20 + k;
                    return -1;
                }
                if (r->len <= 0 || r->rawlen != r->len || (long)r->len > max_bytes[k]) {
                    cxpl_release(&dec.package, m53_m1_pk_free);
                    *reason_out = "embed-pkg-decode-failed";
                    *detail_out = 30 + k;
                    return -1;
                }
                if (m53_m1_crc32(pkg + r->data, (long)r->len) != r->crc) {
                    cxpl_release(&dec.package, m53_m1_pk_free);
                    *reason_out = "embed-pkg-decode-failed";
                    *detail_out = k;
                    return -1;
                }
                out_p[k] = pkg + r->data;
                out_n[k] = (long)r->len;
                break;
            }
        }
    }
    cxpl_release(&dec.package, m53_m1_pk_free);
    for (k = 0; k < 3; k++) {
        if (!out_p[k]) {
            *reason_out = "embed-resource-missing";
            *detail_out = k + 1;
            return -1;
        }
    }
    *reason_out = 0;
    *detail_out = 0;
    return 0;
}

/* Full UTAPEBIN v1.3 6-section validator (matches cx/driver/stream_s1.cx:213-311):
 * CODE, DATA, BSSZ, SYMS, RELO, HOST with 8-byte alignment, zero padding, M1 host mask (<=383),
 * zeroed-ident[28..59] SHA-256 seal, and M53S1ABI1 tag in DATA. Writes outputs only on success. */
static int m53_m1_validate_slice(const unsigned char *b, long len,
                                 unsigned long long *clen_out, unsigned long long *doff_out,
                                 unsigned long long *dlen_out, unsigned long long *bsz_out) {
    static const char *const tags[6] = {"CODE", "DATA", "BSSZ", "SYMS", "RELO", "HOST"};
    static const char magic[8] = {'U', 'T', 'A', 'P', 'E', 'B', 'I', 'N'};
    static const char abi_tag[9] = {'M', '5', '3', 'S', '1', 'A', 'B', 'I', '1'};
    unsigned long long entry_off, nsect, dir_off, origin, prev_end = 208ULL;
    unsigned long long code_len = 0, data_off = 0, data_len = 0, bss_sz = 0;
    unsigned char *tmp, dig[32], seen_host[37];
    int i, j, has_abi = 0;
    if (!b || len < 216) return -1;
    for (i = 0; i < 8; i++) if (b[i] != (unsigned char)magic[i]) return -1;
    if (m53_m1_rd_u(b + 8, 2) != 1ULL || m53_m1_rd_u(b + 10, 2) != 3ULL) return -1;
    if (m53_m1_rd_u(b + 12, 2) != 1ULL || m53_m1_rd_u(b + 14, 2) != 0ULL) return -1;
    entry_off = m53_m1_rd_u(b + 16, 4);
    nsect = m53_m1_rd_u(b + 20, 4);
    dir_off = m53_m1_rd_u(b + 24, 4);
    origin = m53_m1_rd_u(b + 60, 4);
    if (nsect != 6ULL || dir_off != 64ULL || origin > 6ULL) return -1;
    for (i = 0; i < 6; i++) {
        int d = 64 + 24 * i;
        unsigned long long soff, slen, scnt, aligned;
        for (j = 0; j < 4; j++) if (b[d + j] != (unsigned char)tags[i][j]) return -1;
        soff = m53_m1_rd_u(b + d + 4, 8);
        slen = m53_m1_rd_u(b + d + 12, 8);
        scnt = m53_m1_rd_u(b + d + 20, 4);
        aligned = prev_end + ((8ULL - (prev_end & 7ULL)) & 7ULL);
        if (soff != aligned) return -1;
        if (soff > (unsigned long long)len || slen > (unsigned long long)len - soff) return -1;
        while (prev_end < soff) { if (b[prev_end] != 0) return -1; prev_end++; }
        if (i == 0) code_len = slen;
        if (i == 1) { data_off = soff; data_len = slen; }
        if (i == 2) { if (slen != 8ULL || scnt != 1ULL) return -1; bss_sz = m53_m1_rd_u(b + soff, 8); }
        if (i == 3) {
            unsigned long long r;
            if ((slen & 15ULL) != 0ULL || scnt != (slen >> 4)) return -1;
            for (r = 0; r < scnt; r++) {
                const unsigned char *row = b + soff + (r << 4);
                unsigned long long noff = m53_m1_rd_u(row, 4), k;
                int nul_ok = 0;
                if (row[4] > 3 || row[5] > 3 || m53_m1_rd_u(row + 6, 2) != 0ULL) return -1;
                if (noff >= data_len || b[data_off + noff] == 0) return -1;
                for (k = noff; k < data_len; k++) if (b[data_off + k] == 0) { nul_ok = 1; break; }
                if (!nul_ok) return -1;
            }
        }
        if (i == 4) {
            unsigned long long r;
            if ((slen & 15ULL) != 0ULL || scnt != (slen >> 4)) return -1;
            for (r = 0; r < scnt; r++) {
                const unsigned char *row = b + soff + (r << 4);
                unsigned long long rpos = m53_m1_rd_u(row, 8);
                if (row[8] > 3 || row[9] < 1 || row[9] > 10 || m53_m1_rd_u(row + 10, 2) != 0ULL) return -1;
                if (rpos == 0ULL || rpos >= code_len || (unsigned long long)row[9] > code_len - rpos) return -1;
            }
        }
        if (i == 5) {
            unsigned long long hpos = 0, r;
            for (j = 0; j < 37; j++) seen_host[j] = 0;
            for (r = 0; r < scnt; r++) {
                unsigned long long slot, nlen;
                if (slen - hpos < 4ULL) return -1;
                slot = m53_m1_rd_u(b + soff + hpos, 2);
                nlen = m53_m1_rd_u(b + soff + hpos + 2, 2);
                hpos += 4ULL;
                if (slot >= 37ULL || seen_host[slot] || ((M53_M1_MASK >> slot) & 1ULL) == 0ULL) return -1;
                if (nlen > slen - hpos) return -1;
                seen_host[slot] = 1;
                hpos += nlen;
            }
            if (hpos != slen) return -1;
        }
        prev_end = soff + slen;
    }
    if (prev_end != (unsigned long long)len) return -1;
    if (code_len == 0ULL && entry_off != 0ULL) return -1;
    if (code_len > 0ULL && entry_off >= code_len) return -1;
    tmp = (unsigned char *)mm_alloc(len);
    if (!tmp) return -1;
    if (mm_copy(tmp, len, b, len)) { mm_free(tmp); return -1; }
    for (i = 0; i < 32; i++) tmp[28 + i] = 0;
    cx_sha256(tmp, (size_t)len, dig);
    mm_free(tmp);
    if (!m53_m1_bytes_eq(b + 28, dig, 32)) return -1;
    if (data_len >= 9ULL) {
        unsigned long long pos;
        for (pos = 0; pos + 9ULL <= data_len; pos++) {
            int ok = 1;
            for (j = 0; j < 9; j++) {
                if (b[data_off + pos + (unsigned long long)j] != (unsigned char)abi_tag[j]) { ok = 0; break; }
            }
            if (ok) { has_abi = 1; break; }
        }
    }
    if (!has_abi) return -1;
    *clen_out = code_len;
    *doff_out = data_off;
    *dlen_out = data_len;
    *bsz_out = bss_sz;
    return 0;
}

static void m53_m1_drop_loaded(void) {
    tsl_unload(&m53_m1_tsl);
    if (m53_m1_slice) { mm_free(m53_m1_slice); m53_m1_slice = 0; }
    m53_m1_slice_len = 0;
    m53_m1_code_len = 0;
    m53_m1_data_off = 0;
    m53_m1_data_len = 0;
    m53_m1_bss_size = 0;
    m53_m1_bind_fn = 0;
    m53_m1_disp_fn = 0;
    m53_m1_run_fn = 0;
    m53_m1_cache.valid = 0;
}

static int m53_m1_stat_hit(const char *cpath, const sy_stat_t *st) {
    long cl, kl;
    if (m53_m1_state != M53_M1_READY || !m53_m1_cache.valid) return 0;
    cl = m53_m1_len(cpath, 4096);
    kl = m53_m1_len(m53_m1_cache.path, 4096);
    if (!m53_m1_eq(cpath, cl, m53_m1_cache.path, kl)) return 0;
    return st->dev == m53_m1_cache.dev && st->ino == m53_m1_cache.ino && st->size == m53_m1_cache.size &&
           st->mtime == m53_m1_cache.mtime && st->mtime_ns == m53_m1_cache.mtime_ns &&
           st->ctime_ns == m53_m1_cache.ctime_ns;
}

typedef struct {
    int fd;
    long pos;
    long end;
    long bpos;
    long blen;
    unsigned char buf[4096];
} M53FdScan;

static void m53_fd_init(M53FdScan *sc, int fd, long start, long end) {
    sc->fd = fd;
    sc->pos = start;
    sc->end = end;
    sc->bpos = 0;
    sc->blen = 0;
}

static long m53_fd_tell(const M53FdScan *sc) {
    return sc->pos - (sc->blen - sc->bpos);
}

static int m53_fd_getc(M53FdScan *sc) {
    if (sc->bpos >= sc->blen) {
        long rem = sc->end - sc->pos;
        long want = rem > (long)sizeof sc->buf ? (long)sizeof sc->buf : rem;
        long got;
        if (want <= 0) return -1;
        got = sy_read(sc->fd, sc->buf, want);
        if (got <= 0) return -1;
        sc->pos += got;
        sc->bpos = 0;
        sc->blen = got;
    }
    return (int)sc->buf[sc->bpos++];
}

static int m53_fd_skip(M53FdScan *sc, long n) {
    long avail;
    if (n < 0) return -1;
    if (n == 0) return 0;
    avail = sc->blen - sc->bpos;
    if (n <= avail) { sc->bpos += n; return 0; }
    n -= avail;
    sc->bpos = 0;
    sc->blen = 0;
    if (n > sc->end - sc->pos) return -1;
    sc->pos += n;
    return sy_lseek(sc->fd, sc->pos, 0) == sc->pos ? 0 : -1;
}

static int m53_fd_read(M53FdScan *sc, unsigned char *dst, long n) {
    long avail, take;
    if (n < 0) return -1;
    if (n == 0) return 0;
    avail = sc->blen - sc->bpos;
    if (avail > 0) {
        take = n < avail ? n : avail;
        if (mm_copy(dst, n, sc->buf + sc->bpos, take)) return -1;
        sc->bpos += take;
        dst += take;
        n -= take;
    }
    if (n == 0) return 0;
    if (n > sc->end - sc->pos) return -1;
    if (sy_read_full(sc->fd, dst, n) != 0) return -1;
    sc->pos += n;
    return 0;
}

static long m53_fd_line(M53FdScan *sc, char *line, long cap) {
    long n = 0;
    int c;
    for (;;) {
        c = m53_fd_getc(sc);
        if (c < 0) return -1;
        if (c == '\n') { line[n] = 0; return n; }
        if (n + 1 >= cap) return -1;
        line[n++] = (char)c;
    }
}

static int m53_tok_u64(const char *s, long *at, long len, unsigned long long *out) {
    unsigned long long v = 0;
    long i = *at;
    int any = 0;
    while (i < len && (s[i] == ' ' || s[i] == '\t' || s[i] == '\r')) i++;
    while (i < len && s[i] >= '0' && s[i] <= '9') {
        unsigned long long d = (unsigned long long)(s[i] - '0');
        if (v > (18446744073709551615ULL - d) / 10ULL) return -1;
        v = v * 10ULL + d;
        any = 1;
        i++;
    }
    if (!any) return -1;
    *at = i;
    *out = v;
    return 0;
}

/* Stream-seek P4 package directly on fd: reads only headers + the 3 tape/lnx-x86_64/* payloads (~22 KB)
 * instead of reading the full 9.4 MB APE or 2.9 MB P4 body. Enforces identical G1 rules to m53_m1_extract_tape. */
static int m53_m1_extract_tape_fd(int fd, long pkg_off, long pkglen,
                                  unsigned char *out_p[3], long out_n[3],
                                  const char **reason_out, int *detail_out) {
    static const char *const keys[3] = {
        "tape/lnx-x86_64/manifest.tsv",
        "tape/lnx-x86_64/tapemode.so",
        "tape/lnx-x86_64/m53.tapeslice"
    };
    static const long key_len[3] = { 28, 27, 29 };
    static const long max_bytes[3] = { M53_M1_MAX_MF, M53_M1_MAX_SO, M53_M1_MAX_SL };
    M53FdScan sc;
    char line[512];
    unsigned char nbuf[32];
    long ln, at, i, k;
    unsigned long long ver = 0, pm = 0, ps = 0, nr = 0;

    out_p[0] = 0; out_p[1] = 0; out_p[2] = 0;
    out_n[0] = 0; out_n[1] = 0; out_n[2] = 0;
    if (pkg_off < 0 || pkglen <= 0 || sy_lseek(fd, pkg_off, 0) != pkg_off) {
        *reason_out = "embed-pkg-decode-failed"; *detail_out = 10; return -1;
    }
    m53_fd_init(&sc, fd, pkg_off, pkg_off + pkglen);

    /* P <ver> <pm> <ps> <nr>\n */
    ln = m53_fd_line(&sc, line, (long)sizeof line);
    if (ln <= 0) { *reason_out = "embed-pkg-decode-failed"; *detail_out = 10; return -1; }
    at = 0;
    while (at < ln && (unsigned char)line[at] <= 32) at++;
    if (at >= ln || line[at++] != 'P' ||
        m53_tok_u64(line, &at, ln, &ver) != 0 || ver < 4ULL || ver > 4ULL ||
        m53_tok_u64(line, &at, ln, &pm) != 0 || pm == 0ULL || pm > (unsigned long long)(pkglen / 8) ||
        m53_tok_u64(line, &at, ln, &ps) != 0 || ps == 0ULL || ps > (unsigned long long)(pkglen / 10) ||
        m53_tok_u64(line, &at, ln, &nr) != 0 || nr > (unsigned long long)(pkglen / 5)) {
        *reason_out = "embed-pkg-decode-failed"; *detail_out = 10; return -1;
    }

    /* Skip ps stage rows: D <route> <name> <in> <out> <model>\n */
    for (i = 0; i < (long)ps; i++) {
        ln = m53_fd_line(&sc, line, (long)sizeof line);
        if (ln <= 0) { *reason_out = "embed-pkg-decode-failed"; *detail_out = 10; return -1; }
        at = 0;
        while (at < ln && (unsigned char)line[at] <= 32) at++;
        if (at >= ln || line[at] != 'D') { *reason_out = "embed-pkg-decode-failed"; *detail_out = 10; return -1; }
    }

    /* Skip pm model payloads: M <n> <raw> <codec> <sum>\n + <n> bytes */
    for (i = 0; i < (long)pm; i++) {
        unsigned long long mn = 0, mraw = 0, mcod = 0, msum = 0;
        ln = m53_fd_line(&sc, line, (long)sizeof line);
        if (ln <= 0) { *reason_out = "embed-pkg-decode-failed"; *detail_out = 10; return -1; }
        at = 0;
        while (at < ln && (unsigned char)line[at] <= 32) at++;
        if (at >= ln || line[at++] != 'M' ||
            m53_tok_u64(line, &at, ln, &mn) != 0 || mn == 0ULL ||
            m53_tok_u64(line, &at, ln, &mraw) != 0 ||
            m53_tok_u64(line, &at, ln, &mcod) != 0 ||
            m53_tok_u64(line, &at, ln, &msum) != 0 ||
            m53_fd_skip(&sc, (long)mn) != 0) {
            *reason_out = "embed-pkg-decode-failed"; *detail_out = 10; return -1;
        }
    }

    /* Scan nr resource records: F <nlen> <len> <rawlen> <codec> <crc>\n + <nlen> + <len> */
    for (i = 0; i < (long)nr; i++) {
        unsigned long long fn = 0, flen = 0, fraw = 0, fcod = 0, fcrc = 0;
        int match = -1;
        ln = m53_fd_line(&sc, line, (long)sizeof line);
        if (ln <= 0) { *reason_out = "embed-pkg-decode-failed"; *detail_out = 10; goto err_fd; }
        at = 0;
        while (at < ln && (unsigned char)line[at] <= 32) at++;
        if (at >= ln || line[at++] != 'F' ||
            m53_tok_u64(line, &at, ln, &fn) != 0 || fn == 0ULL ||
            m53_tok_u64(line, &at, ln, &flen) != 0 ||
            m53_tok_u64(line, &at, ln, &fraw) != 0 ||
            m53_tok_u64(line, &at, ln, &fcod) != 0 ||
            m53_tok_u64(line, &at, ln, &fcrc) != 0 || fcrc > 4294967295ULL) {
            *reason_out = "embed-pkg-decode-failed"; *detail_out = 10; goto err_fd;
        }
        if (fn == 27ULL || fn == 28ULL || fn == 29ULL) {
            if (m53_fd_read(&sc, nbuf, (long)fn) != 0) {
                *reason_out = "embed-pkg-decode-failed"; *detail_out = 10; goto err_fd;
            }
            for (k = 0; k < 3; k++) {
                if ((long)fn == key_len[k] && m53_m1_eq((const char *)nbuf, (long)fn, keys[k], key_len[k])) {
                    match = (int)k;
                    break;
                }
            }
        } else {
            if (m53_fd_skip(&sc, (long)fn) != 0) {
                *reason_out = "embed-pkg-decode-failed"; *detail_out = 10; goto err_fd;
            }
        }
        if (match >= 0) {
            unsigned char *pay;
            if (out_p[match]) { *reason_out = "embed-resource-duplicate"; *detail_out = match + 1; goto err_fd; }
            if (fcod != 0ULL) { *reason_out = "embed-pkg-decode-failed"; *detail_out = 20 + match; goto err_fd; }
            if (flen == 0ULL || fraw != flen || (long)flen > max_bytes[match]) {
                *reason_out = "embed-pkg-decode-failed"; *detail_out = 30 + match; goto err_fd;
            }
            pay = (unsigned char *)mm_alloc((long)flen);
            if (!pay) { *reason_out = "embed-pkg-decode-failed"; *detail_out = 10; goto err_fd; }
            if (m53_fd_read(&sc, pay, (long)flen) != 0) {
                mm_free(pay); *reason_out = "embed-pkg-decode-failed"; *detail_out = 10; goto err_fd;
            }
            if (m53_m1_crc32(pay, (long)flen) != (unsigned)fcrc) {
                mm_free(pay); *reason_out = "embed-pkg-decode-failed"; *detail_out = match; goto err_fd;
            }
            out_p[match] = pay;
            out_n[match] = (long)flen;
        } else {
            if (m53_fd_skip(&sc, (long)flen) != 0) {
                *reason_out = "embed-pkg-decode-failed"; *detail_out = 10; goto err_fd;
            }
        }
    }
    if (m53_fd_tell(&sc) != pkg_off + pkglen) {
        *reason_out = "embed-pkg-decode-failed"; *detail_out = 10; goto err_fd;
    }
    for (k = 0; k < 3; k++) {
        if (!out_p[k]) { *reason_out = "embed-resource-missing"; *detail_out = (int)k + 1; goto err_fd; }
    }
    *reason_out = 0;
    *detail_out = 0;
    return 0;
err_fd:
    for (k = 0; k < 3; k++) { if (out_p[k]) { mm_free(out_p[k]); out_p[k] = 0; out_n[k] = 0; } }
    return -1;
}

/* Locate P4 package span on fd by reading only head4 + 16-byte tail footer (fallback to full
 * packagefooter_locate_bytes only for signed PE containers with trailing certificate tables). */
static int m53_m1_locate_pkg_fd(int fd, long apen, long *pkg_off_out, long *pkglen_out) {
    unsigned char h4[4], foot[16];
    unsigned long long plen;
    if (apen < 4) return -1;
    if (sy_lseek(fd, 0, 0) != 0 || sy_read_full(fd, h4, 4) != 0) return -1;
    if (h4[0] == 'P' && h4[1] == ' ') {
        *pkg_off_out = 0;
        *pkglen_out = apen;
        return 0;
    }
    if (apen >= 16 && sy_lseek(fd, apen - 16, 0) == apen - 16 && sy_read_full(fd, foot, 16) == 0 &&
        foot[0] == 85 && foot[1] == 78 && foot[2] == 73 && foot[3] == 80 &&
        foot[4] == 75 && foot[5] == 71 && foot[6] == 49 && foot[7] == 10) {
        plen = m53_m1_rd_u(foot + 8, 8);
        if (plen > 0ULL && plen <= (unsigned long long)(apen - 16)) {
            *pkg_off_out = apen - 16 - (long)plen;
            *pkglen_out = (long)plen;
            return 0;
        }
    }
    /* Slow fallback: signed PE with cert table padding before UNIPKG1 footer. */
    {
        unsigned char *ape = (unsigned char *)mm_alloc(apen);
        PackageFooter pf;
        int ok = 0;
        if (!ape) return -1;
        if (sy_lseek(fd, 0, 0) == 0 && sy_read_full(fd, ape, apen) == 0 &&
            packagefooter_locate_bytes(ape, apen, &pf) &&
            pf.package_offset >= 0 && pf.package_length > 0 &&
            pf.package_offset + pf.package_length <= apen) {
            *pkg_off_out = pf.package_offset;
            *pkglen_out = pf.package_length;
            ok = 1;
        }
        mm_free(ape);
        return ok ? 0 : -1;
    }
}

/* G3: fast stat-key cache hit (0 reads, 0 hashes on 2nd+ calls); on miss, stream-seeks only footer
 * + 3 tape records (~22 KB) and hashes only the 3 tape records (~18 KB, ~1.4 ms) before atomic swap. */
static int m53_m1_ensure_loaded(void) {
    static const char *const sym_names[3] = {
        "hoststub_lnx_x86_64_bind",
        "hoststub_lnx_x86_64",
        "tape_run_x86_64"
    };
    char selfp[4096];
    const char *cpath = sy_env("UNISA_CONTAINER");
    int fd = -1, rc, i;
    sy_stat_t st;
    long apen = 0, pkg_off = 0, pkglen = 0;
    unsigned char *tp[3] = {0, 0, 0};
    long tn[3] = {0, 0, 0};
    unsigned char *new_slice = 0;
    const char *er = 0;
    int ed = 0;
    unsigned char comb96[96], tape_sha[32];
    char so_sha[65], sl_sha[65];
    unsigned long long new_clen = 0, new_doff = 0, new_dlen = 0, new_bsz = 0;
    tsl_img_t new_tsl;
    void *new_bind = 0, *new_disp = 0, *new_run = 0;

    if (!cpath || !cpath[0]) {
        if (sy_self_path(selfp, (int)sizeof selfp) != 0) {
            m53_m1_drop_loaded();
            return m53_m1_fail("embed-container-missing", -ENOENT);
        }
        cpath = selfp;
    }
    fd = sy_open_read(cpath);
    if (fd < 0) {
        m53_m1_drop_loaded();
        return m53_m1_fail("embed-container-missing", fd);
    }
    if (sy_fstat(fd, &st) != 0 || st.kind != 'f' || st.size <= 0 || st.size > M53_M1_MAX_APE) {
        sy_close(fd);
        m53_m1_drop_loaded();
        return m53_m1_fail("embed-container-missing", -EINVAL);
    }
    /* (1) Fast path: path + stat (dev/ino/size/mtime/mtime_ns/ctime_ns) hit -> 0 reads, 0 hashes. */
    if (m53_m1_stat_hit(cpath, &st)) {
        sy_close(fd);
        return 0;
    }

    apen = (long)st.size;
    m53_m1_state = M53_M1_LOADING;
    /* (3) Locate package span via 16-byte footer and stream-seek only the 3 tape F records. */
    if (m53_m1_locate_pkg_fd(fd, apen, &pkg_off, &pkglen) != 0) {
        sy_close(fd);
        m53_m1_drop_loaded();
        return m53_m1_fail("embed-footer-invalid", 0);
    }
    if (m53_m1_extract_tape_fd(fd, pkg_off, pkglen, tp, tn, &er, &ed) != 0) {
        sy_close(fd);
        m53_m1_drop_loaded();
        return m53_m1_fail(er ? er : "embed-pkg-decode-failed", ed);
    }
    sy_close(fd);

    /* (2) Hash only the 3 tape records (~18 KB, ~1.4 ms) for manifest check + cache identity. */
    cx_sha256(tp[0], (size_t)tn[0], comb96);
    cx_sha256(tp[1], (size_t)tn[1], comb96 + 32);
    cx_sha256(tp[2], (size_t)tn[2], comb96 + 64);
    cx_sha256(comb96, 96, tape_sha);
    m53_m1_hex(comb96 + 32, so_sha);
    m53_m1_hex(comb96 + 64, sl_sha);

    if (m53_m1_check_mf_line((const char *)tp[0], tn[0], "tapemode.so", so_sha, tn[1]) != 0) {
        mm_free(tp[0]); mm_free(tp[1]); mm_free(tp[2]); m53_m1_drop_loaded();
        return m53_m1_fail("embed-manifest-mismatch", 1);
    }
    if (m53_m1_check_mf_line((const char *)tp[0], tn[0], "m53.tapeslice", sl_sha, tn[2]) != 0) {
        mm_free(tp[0]); mm_free(tp[1]); mm_free(tp[2]); m53_m1_drop_loaded();
        return m53_m1_fail("embed-manifest-mismatch", 2);
    }
    mm_free(tp[0]); tp[0] = 0;

    if (m53_m1_validate_slice(tp[2], tn[2], &new_clen, &new_doff, &new_dlen, &new_bsz) != 0) {
        mm_free(tp[1]); mm_free(tp[2]); m53_m1_drop_loaded();
        return m53_m1_fail("embed-slice-corrupt", 1);
    }
    new_slice = tp[2]; tp[2] = 0;

    mm_fill(&new_tsl, (long)sizeof new_tsl, 0, (long)sizeof new_tsl);
    rc = tsl_check(tp[1], tn[1], sym_names, &new_tsl);
    if (rc != 0) {
        mm_free(tp[1]); mm_free(new_slice); m53_m1_drop_loaded();
        return m53_m1_fail("embed-so-invalid", rc);
    }
    rc = tsl_map(tp[1], tn[1], &new_tsl);
    mm_free(tp[1]); tp[1] = 0;
    if (rc != 0) {
        mm_free(new_slice); m53_m1_drop_loaded();
        return m53_m1_fail("embed-so-map-failed", rc);
    }

    new_bind = tsl_addr(&new_tsl, 0);
    new_disp = tsl_addr(&new_tsl, 1);
    new_run = tsl_addr(&new_tsl, 2);
    if (!new_bind || !new_disp || !new_run) {
        tsl_unload(&new_tsl);
        mm_free(new_slice);
        m53_m1_drop_loaded();
        return m53_m1_fail("embed-so-map-failed", 20);
    }

    /* Atomic swap: unload old mapping and publish validated new image + cache key. */
    m53_m1_drop_loaded();
    for (i = 0; i < TSL_I_WORDS; i++) m53_m1_tsl[i] = new_tsl[i];
    m53_m1_slice = new_slice;
    m53_m1_slice_len = tn[2];
    m53_m1_code_len = new_clen;
    m53_m1_data_off = new_doff;
    m53_m1_data_len = new_dlen;
    m53_m1_bss_size = new_bsz;
    m53_m1_bind_fn = new_bind;
    m53_m1_disp_fn = new_disp;
    m53_m1_run_fn = new_run;
    m53_m1_cpy(m53_m1_cache.path, (long)sizeof m53_m1_cache.path, cpath);
    m53_m1_cache.dev = st.dev;
    m53_m1_cache.ino = st.ino;
    m53_m1_cache.size = st.size;
    m53_m1_cache.mtime = st.mtime;
    m53_m1_cache.mtime_ns = st.mtime_ns;
    m53_m1_cache.ctime_ns = st.ctime_ns;
    for (i = 0; i < 32; i++) m53_m1_cache.tape_sha[i] = tape_sha[i];
    m53_m1_cache.valid = 1;
    m53_m1_state = M53_M1_READY;
    return 0;
}

/* G4 authoritative VM result classifier (shared by m53_m1_vm_exec and tools/check-m1-g4.cx).
 * res layout: [0]=vm_status, [1]=steps, [2]=fault_code, [3]=raw_64bit_ret (never masked & 255). */
int m53_m1_classify_vm_result(long call_rc, const unsigned long long res[4],
                              const char **reason_out, int *detail_out) {
    if (reason_out) *reason_out = 0;
    if (detail_out) *detail_out = 0;
    if (call_rc != 0L) {
        if (reason_out) *reason_out = "embed-vm-call-failed";
        if (detail_out) *detail_out = (int)call_rc;
        return -2;
    }
    if (!res) {
        if (reason_out) *reason_out = "embed-vm-fault";
        if (detail_out) *detail_out = -1;
        return -2;
    }
    if (res[0] != 0ULL) {
        if (reason_out) *reason_out = "embed-vm-fault";
        if (detail_out) *detail_out = (int)(res[2] ? res[2] : res[0]);
        return -2;
    }
    if (res[3] != 0ULL && res[3] != 1ULL) {
        if (reason_out) *reason_out = "embed-vm-bad-return";
        if (detail_out) *detail_out = res[3] <= 2147483647ULL ? (int)res[3] : 2147483647;
        return -2;
    }
    return (int)res[3];
}

/* G4 tape_x86_64.S .Lrun_exit ABI classifier:
 * - result[0..4] is pre-filled with M53_M1_RES_SENTINEL before tsl_call2(run_fn); tape_x86_64.S:262-265
 *   always zeroes result[0..4] via rep stosq on real execution and records steps>0 at .Lrun_return.
 * - ASM status codes (tape_x86_64.S:1081-1101): 0=normal exit, 2=fault/container, 3=budget exhausted.
 * - On normal exit (res[0]==0): %rax (rrc) MUST equal (long)res[3]; any disagreement (including
 *   rrc==0 while res[3]==1) produces a guaranteed non-zero internal error (-3 when rrc==0). */
int m53_m1_classify_run_result(long rrc, const unsigned long long res[4],
                               const char **reason_out, int *detail_out) {
    if (reason_out) *reason_out = 0;
    if (detail_out) *detail_out = 0;
    if (!res) {
        if (reason_out) *reason_out = "embed-vm-fault";
        if (detail_out) *detail_out = -1;
        return -2;
    }
    if (res[0] == M53_M1_RES_SENTINEL || res[1] == M53_M1_RES_SENTINEL ||
        res[2] == M53_M1_RES_SENTINEL || res[3] == M53_M1_RES_SENTINEL) {
        if (reason_out) *reason_out = "embed-vm-unwritten";
        if (detail_out) *detail_out = -4;
        return -2;
    }
    if (res[0] == 3ULL) {
        if (reason_out) *reason_out = "embed-vm-budget";
        if (detail_out) *detail_out = 3;
        return -2;
    }
    if (res[0] != 0ULL) {
        if (reason_out) *reason_out = "embed-vm-fault";
        if (detail_out) *detail_out = (int)(res[2] ? res[2] : res[0]);
        return -2;
    }
    if (res[1] == 0ULL) {
        if (reason_out) *reason_out = "embed-vm-unwritten";
        if (detail_out) *detail_out = -5;
        return -2;
    }
    if (rrc != (long)res[3]) {
        long err = rrc ? rrc : -3L;
        if (reason_out) *reason_out = "embed-vm-call-failed";
        if (detail_out) *detail_out = (int)err;
        return -2;
    }
    return m53_m1_classify_vm_result(0L, res, reason_out, detail_out);
}

/* G4: execute embedded m53.tapeslice cxsa_valid via tsl_call2 with full 64-bit return domain check. */
static int m53_m1_vm_exec(const unsigned char *data, long length) {
    unsigned long long data_aligned, copy_n, in_off, in_end, argv_at, argbuf_off, memlimit, ibitmap_cap;
    unsigned char *mem = 0, *ibm = 0;
    unsigned long long args[12], result[5], res4[4], *guest_argv;
    char *abuf, *a0, *a1, *a2;
    const char *why = 0;
    long brc, rrc;
    int i, det = 0, ret;

    if (!m53_m1_tsl[TSL_I_BASE] || !m53_m1_slice || !m53_m1_bind_fn || !m53_m1_disp_fn || !m53_m1_run_fn) {
        m53_m1_emit_refuse("embed-vm-call-failed", -1);
        return -2;
    }
    if (m53_m1_data_len > ~7ULL) {
        m53_m1_emit_refuse("embed-vm-call-failed", -2);
        return -2;
    }
    data_aligned = (m53_m1_data_len + 7ULL) & ~7ULL;
    if (m53_m1_bss_size > 0x20000000ULL - 65536ULL - data_aligned) {
        m53_m1_emit_refuse("embed-vm-call-failed", -2);
        return -2;
    }
    in_off = data_aligned + m53_m1_bss_size;
    copy_n = (data && length > 0) ? (unsigned long long)length : 0ULL;
    in_end = (in_off + copy_n + 7ULL) & ~7ULL;
    argv_at = in_end + 65536ULL;
    argbuf_off = argv_at + 64ULL;
    memlimit = argbuf_off + 128ULL;
    ibitmap_cap = (m53_m1_code_len >> 3) + ((m53_m1_code_len & 7ULL) != 0ULL ? 1ULL : 0ULL);
    if (ibitmap_cap == 0ULL) ibitmap_cap = 1ULL;

    mem = (unsigned char *)mm_alloc((long)memlimit);
    ibm = (unsigned char *)mm_alloc((long)ibitmap_cap);
    if (!mem || !ibm) {
        if (ibm) mm_free(ibm);
        if (mem) mm_free(mem);
        m53_m1_emit_refuse("embed-vm-call-failed", -2);
        return -2;
    }
    mm_fill(mem, (long)memlimit, 0, (long)memlimit);
    mm_fill(ibm, (long)ibitmap_cap, 0, (long)ibitmap_cap);
    if (m53_m1_data_len > 0ULL && mm_copy(mem, (long)memlimit, m53_m1_slice + m53_m1_data_off, (long)m53_m1_data_len)) {
        mm_free(ibm); mm_free(mem);
        m53_m1_emit_refuse("embed-vm-call-failed", -2);
        return -2;
    }
    if (copy_n > 0ULL && mm_copy(mem + in_off, (long)(memlimit - in_off), data, (long)copy_n)) {
        mm_free(ibm); mm_free(mem);
        m53_m1_emit_refuse("embed-vm-call-failed", -2);
        return -2;
    }

    guest_argv = (unsigned long long *)(mem + argv_at);
    abuf = (char *)(mem + argbuf_off);
    a0 = abuf; m53_m1_cpy(a0, 32, "cxsa_valid");
    a1 = a0 + 32; m53_m1_wr_i64_dec(a1, 32, data ? (long long)(unsigned long long)(mem + in_off) : 0LL);
    a2 = a1 + 32; m53_m1_wr_i64_dec(a2, 32, (long long)length);
    guest_argv[0] = (unsigned long long)a0;
    guest_argv[1] = (unsigned long long)a1;
    guest_argv[2] = (unsigned long long)a2;
    guest_argv[3] = 0ULL;

    brc = tsl_call2(&m53_m1_tsl, m53_m1_bind_fn, (long)mem, (long)memlimit);
    if (brc != 0L) {
        mm_free(ibm); mm_free(mem);
        m53_m1_emit_refuse("embed-vm-call-failed", (int)brc);
        return -2;
    }
    for (i = 0; i < 12; i++) args[i] = 0ULL;
    for (i = 0; i < 5; i++) result[i] = M53_M1_RES_SENTINEL;
    args[0] = 4ULL;
    args[1] = (unsigned long long)m53_m1_slice;
    args[2] = memlimit;
    args[3] = 2000000ULL;
    args[4] = 3ULL;
    args[5] = (unsigned long long)guest_argv;
    args[6] = (unsigned long long)result;
    args[7] = (unsigned long long)m53_m1_slice_len;
    args[8] = (unsigned long long)m53_m1_disp_fn;
    args[9] = (unsigned long long)mem;
    args[10] = (unsigned long long)ibm;
    args[11] = ibitmap_cap;

    rrc = tsl_call2(&m53_m1_tsl, m53_m1_run_fn, (long)args, 0L);
    mm_free(ibm);
    mm_free(mem);

    res4[0] = result[0];
    res4[1] = result[2];
    res4[2] = result[4];
    res4[3] = result[1];
    ret = m53_m1_classify_run_result(rrc, res4, &why, &det);
    if (ret < 0) {
        m53_m1_emit_refuse(why ? why : "embed-vm-fault", det);
        return -2;
    }
    return ret;
}

int cxsa_valid_s1(const unsigned char *data, long length) {
    const char *env_s1 = sy_env("UNISACC_M53_S1");
    const char *env_so = sy_env("UNISACC_M53_S1_SO");
    int ret;
    if ((env_s1 && env_s1[0]) || (env_so && env_so[0])) {
        m53_m1_emit_refuse("embed-env-override-forbidden", 0);
        return -2;
    }
    if (m53_m1_busy) {
        m53_m1_emit_refuse("embed-reentrant", 0);
        return -2;
    }
    if (!data || length < 4) return 0;
    if (length > M53_M1_MAX_IN) {
        m53_m1_emit_refuse("embed-input-too-large", 0);
        return -2;
    }
    m53_m1_busy = 1;
    if (m53_m1_ensure_loaded() != 0) {
        m53_m1_busy = 0;
        return -2;
    }
    ret = m53_m1_vm_exec(data, length);
    m53_m1_busy = 0;
    return ret;
}
