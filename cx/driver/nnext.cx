#pragma unisa module nnext
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.sha
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use text.text

#define CXN_DIR_CAP 4096
#define CXN_PATH_CAP 4200

static char cxn_dir[CXN_DIR_CAP];
static char cxn_why_buf[256];
static int cxn_active;
static int cxn_explicit;
static int cxn_dir_exists;
static int cxn_hit_any;
static int cxn_err;
static unsigned char *cxn_buf;

static int cxn_fail_msg(char *why, int wcap, const char *msg) {
    int i = 0;
    const char *p = (msg && msg[0]) ? msg : "external nn refused";
    cxn_err = 1;
    while (p[i] && i + 1 < (int)sizeof cxn_why_buf) { cxn_why_buf[i] = p[i]; i = i + 1; }
    cxn_why_buf[i] = 0;
    if (why && wcap > 0) {
        int j = 0;
        while (cxn_why_buf[j] && j + 1 < wcap) { why[j] = cxn_why_buf[j]; j = j + 1; }
        why[j] = 0;
    }
    return -1;
}

static int cxn_set_dir(const char *src, char *why, int wcap) {
    long n = 0;
    if (!src || !src[0]) return -1;
    while (src[n]) {
        if (n + 1 >= CXN_DIR_CAP) return cxn_fail_msg(why, wcap, "external nn dir exceeds 4095 bytes");
        cxn_dir[n] = src[n];
        n = n + 1;
    }
    cxn_dir[n] = 0;
    return 0;
}

static int cxn_is_sep(char c) {
    return c == '/' || c == '\\';
}

static int cxn_set_beside_from_exe(const char *exe, char *why, int wcap) {
    long i = 0, last = -1;
    char sep = '/';
    if (!exe || !exe[0]) return 0;
    while (exe[i]) {
        if (cxn_is_sep(exe[i])) { last = i; sep = exe[i]; }
        i = i + 1;
    }
    /* Bare executable name with no separator never falls back to CWD ./nn */
    if (last < 0) return 0;
    {
        long prefix_len = last == 0 ? 1 : last;
        int need_sep = (last == 0 || (last == 2 && exe[1] == ':' && exe[2] == '\\')) ? 0 : 1;
        long total = prefix_len + need_sep + 2;
        if (last == 2 && exe[1] == ':' && exe[2] == '\\') prefix_len = 3;
        if (total + 1 > CXN_DIR_CAP) return cxn_fail_msg(why, wcap, "beside nn dir exceeds 4095 bytes");
        for (long k = 0; k < prefix_len; k = k + 1) cxn_dir[k] = exe[k];
        long at = prefix_len;
        if (need_sep) cxn_dir[at++] = sep;
        cxn_dir[at++] = 'n';
        cxn_dir[at++] = 'n';
        cxn_dir[at] = 0;
    }
    return 1;
}

static int cxn_resolve_self_beside(char *why, int wcap) {
    char self[CXN_DIR_CAP];
    int n = sy_self_path(self, (int)sizeof self);
    if (n == -ENAMETOOLONG || n >= (int)sizeof self) {
        return cxn_fail_msg(why, wcap, "executable path exceeds 4095 bytes");
    }
    if (n <= 0) return 0;
    self[n] = 0;
    return cxn_set_beside_from_exe(self, why, wcap);
}

static int cxn_ends_unisacc_com(const char *val) {
    long n = 0;
    if (!val || !val[0]) return 0;
    if (tx_eqz(val, "unisacc.com") || tx_eqz(val, "./unisacc.com")) return 1;
    while (val[n]) n = n + 1;
    if (n > 12 && tx_eqz(val + n - 12, "/unisacc.com")) return 1;
    if (n > 12 && tx_eqz(val + n - 12, "\\unisacc.com")) return 1;
    return 0;
}

static int cxn_chain_forced(const char *pkg) {
    const char *e;
    if (pkg && pkg[0]) return 1;
    e = sy_env("UNISACC_NN_MODE");
    if (e && tx_eqz(e, "builtin")) return 1;
    e = sy_env("UNISACC_PHASE");
    if (e && e[0]) return 1;
    e = sy_env("UNISACC_CTOR");
    if (e && e[0]) return 1;
    e = sy_env("UNISACC_CHAIN_TOOLS_EPOCH");
    if (e && e[0]) return 1;
    e = sy_env("UNISACC_CHAIN_PHASE_BOUND_S");
    if (e && e[0]) return 1;
    e = sy_env("UNISACC_CHAIN_SHAMEMO");
    if (e && e[0]) return 1;
    e = sy_env("UNISACC_IDENTITY_HELPER");
    if (e && e[0]) return 1;
    e = sy_env("UNISA_CONTAINER");
    if (e && e[0] && !cxn_ends_unisacc_com(e)) return 1;
    return 0;
}

static int cxn_init_core(const char *cli_dir, int no_ext, const char *pkg, const char *exe_path, char *why, int wcap) {
    const char *env_dir;
    sy_stat_t st;
    int sr;
    cxn_dir[0] = 0;
    cxn_why_buf[0] = 0;
    cxn_active = 0;
    cxn_explicit = 0;
    cxn_dir_exists = 0;
    cxn_hit_any = 0;
    cxn_err = 0;
    if (why && wcap > 0) why[0] = 0;
    if (no_ext || cxn_chain_forced(pkg)) return 0;
    if (cli_dir && cli_dir[0]) {
        if (cxn_set_dir(cli_dir, why, wcap) < 0) return -1;
        cxn_active = 1;
        cxn_explicit = 1;
    } else if ((env_dir = sy_env("UNISACC_NN_DIR")) != 0 && env_dir[0]) {
        if (cxn_set_dir(env_dir, why, wcap) < 0) return -1;
        cxn_active = 1;
        cxn_explicit = 1;
    } else {
        int r = (exe_path && exe_path[0]) ? cxn_set_beside_from_exe(exe_path, why, wcap) : cxn_resolve_self_beside(why, wcap);
        if (r < 0) return -1;
        if (r == 0) return 0;
        cxn_active = 1;
        cxn_explicit = 0;
    }
    sr = sy_stat(cxn_dir, &st);
    if (sr == 0) {
        if (st.kind != 'd') return cxn_fail_msg(why, wcap, "external nn path is not a directory");
        cxn_dir_exists = 1;
    } else if (sr != -ENOENT) {
        return cxn_fail_msg(why, wcap, "external nn directory unreadable");
    }
    return 1;
}

/* Unit-test & legacy entry: 1 active, 0 builtin, -1 rejected (overlong or unreadable path). */
int cxn_init(const char *cli_dir, int no_ext, const char *exe_path) {
    return cxn_init_core(cli_dir, no_ext, 0, exe_path, 0, 0);
}

/* Driver entry: always resolves beside via L0 sy_self_path (never raw argv[0]); returns 0 on ok, -1 on refusal. */
int cxn_boot(const char *cli_dir, int no_ext, const char *pkg, char *why, int wcap) {
    int rc = cxn_init_core(cli_dir, no_ext, pkg, 0, why, wcap);
    return rc < 0 ? -1 : 0;
}

int cxn_dir_present(void) { return cxn_active && cxn_dir_exists; }
int cxn_bypass_cache(void) { return (cxn_active && (cxn_hit_any || cxn_err)) ? 1 : 0; }
const char *cxn_dir_get(void) { return cxn_active ? cxn_dir : 0; }
const char *cxn_why(void) { return cxn_why_buf[0] ? cxn_why_buf : "external nn refused"; }

void cxn_close(void) {
    if (cxn_buf) { mm_free(cxn_buf); cxn_buf = 0; }
}

static int cxn_make_stage_path(const char *stage, char *path, int pcap, char *why, int wcap) {
    long di = 0, si = 0;
    if (!stage || !stage[0]) return cxn_fail_msg(why, wcap, "invalid nn stage");
    while (cxn_dir[di]) {
        if (di + 6 >= pcap) return cxn_fail_msg(why, wcap, "external nn file path too long");
        path[di] = cxn_dir[di];
        di = di + 1;
    }
    if (di == 0 || !cxn_is_sep(path[di - 1])) path[di++] = '/';
    while (stage[si]) {
        if (cxn_is_sep(stage[si]) || di + 5 >= pcap) return cxn_fail_msg(why, wcap, "external nn stage path too long");
        path[di++] = stage[si++];
    }
    path[di++] = '.'; path[di++] = 'n'; path[di++] = 'b'; path[di] = 0;
    return 0;
}

int cxn_probe_stage(const char *stage, char *why, int wcap) {
    char path[CXN_PATH_CAP];
    int fd;
    sy_stat_t st;
    unsigned char hdr[9];
    const char *m = "UNINETB1N";
    long got = 0;
    if (!cxn_active || !cxn_dir_exists) return 0;
    if (cxn_make_stage_path(stage, path, (int)sizeof path, why, wcap) != 0) return -1;
    fd = sy_open_read(path);
    if (fd < 0) {
        if (fd == -ENOENT) return 0;
        return cxn_fail_msg(why, wcap, "external nn file unreadable");
    }
    if (sy_fstat(fd, &st) != 0 || st.kind != 'f') {
        sy_close(fd);
        return cxn_fail_msg(why, wcap, "external nn is not a regular file");
    }
    if (st.size < 9 || st.size > 2147483647L) {
        sy_close(fd);
        return cxn_fail_msg(why, wcap, "external nn truncated");
    }
    while (got < 9) {
        long r = sy_read(fd, hdr + got, 9 - got);
        if (r <= 0) { sy_close(fd); return cxn_fail_msg(why, wcap, "external nn header unreadable"); }
        got = got + r;
    }
    sy_close(fd);
    for (int k = 0; k < 9; k = k + 1) {
        if (hdr[k] != (unsigned char)m[k]) return cxn_fail_msg(why, wcap, "external nn bad UNINETB1N magic");
    }
    cxn_hit_any = 1;
    return 0;
}

int cxn_probe_route(int (*along)(const char *, int, const char **), const char *route, char *why, int wcap) {
    int idx = 0;
    const char *stage = 0;
    if (!cxn_active || !cxn_dir_exists) return 0;
    if (cxn_probe_stage("e2", why, wcap) != 0) return -1;
    if (along && route) {
        while (along(route, idx, &stage) == 0) {
            if (stage && cxn_probe_stage(stage, why, wcap) != 0) return -1;
            idx = idx + 1;
        }
    }
    return 0;
}

int cxn_try_load(const char *stage, const unsigned char **bytes, long *n,
                 int *raw, unsigned *crc, int *compressed,
                 unsigned (*crcfn)(char *, int)) {
    char path[CXN_PATH_CAP];
    int fd;
    sy_stat_t st;
    long sz, got = 0;
    unsigned char *buf;
    const char *m = "UNINETB1N";
    if (!stage || !bytes || !n || !raw || !crc || !compressed || !crcfn) return 4;
    if (!cxn_active || !cxn_dir[0]) return 2;
    if (cxn_make_stage_path(stage, path, (int)sizeof path, 0, 0) != 0) return 3;
    fd = sy_open_read(path);
    if (fd < 0) {
        if (fd == -ENOENT) return 2;
        cxn_fail_msg(0, 0, "external nn file unreadable");
        return 3;
    }
    if (sy_fstat(fd, &st) != 0 || st.kind != 'f') {
        sy_close(fd);
        cxn_fail_msg(0, 0, "external nn is not a regular file");
        return 3;
    }
    if (st.size < 9 || st.size > 2147483647L) {
        sy_close(fd);
        cxn_fail_msg(0, 0, "external nn truncated");
        return 3;
    }
    sz = (long)st.size;
    buf = (unsigned char *)mm_alloc((long)sz);
    if (!buf) { sy_close(fd); cxn_fail_msg(0, 0, "external nn out of memory"); return 3; }
    while (got < sz) {
        long r = sy_read(fd, buf + got, sz - got);
        if (r <= 0) { mm_free(buf); sy_close(fd); cxn_fail_msg(0, 0, "external nn read failed"); return 3; }
        got = got + r;
    }
    sy_close(fd);
    for (int k = 0; k < 9; k = k + 1) {
        if (buf[k] != (unsigned char)m[k]) { mm_free(buf); cxn_fail_msg(0, 0, "external nn bad UNINETB1N magic"); return 3; }
    }
    if (cxn_buf) mm_free(cxn_buf);
    cxn_buf = buf;
    *bytes = cxn_buf;
    *n = sz;
    *raw = (int)sz;
    *crc = crcfn((char *)cxn_buf, (int)sz);
    *compressed = 2;
    cxn_hit_any = 1;
    return 0;
}
