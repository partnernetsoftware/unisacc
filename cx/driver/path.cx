/* module path. Five public classifiers:
     cxp_tapebin_path, cxp_tape_path, cxp_object_path,
     cxp_archive_path, cxp_tapebin_target.
   No compiler global and no module state. Every argument is borrowed
   for the call and is not written. Nothing is allocated. A null
   argument is not a match and is not a target. These functions do not
   call die, exit, clierror, or fprintf.

   A path matches only when its final bytes are the suffix. The compare
   is case-sensitive. A shorter string is not a match. A trailing space
   is not ignored.
     .tapebin   cxp_tapebin_path only. It does not end in .tape.
     .tape      cxp_tape_path only.
     .o         cxp_object_path only.
     .obj       cxp_object_path only.
     .a         cxp_object_path and cxp_archive_path.
   .c, .cx, and .s are none of these.

   cxp_tapebin_target returns the product origin id, or 0:
     1 lnx/x86_64
     2 lnx/arm64
     3 osx/x86_64
     4 osx/arm64
     5 win/x86_64
     6 win/arm64
   Any other byte string is 0, including a different case, a 32-bit
   name, a missing slash, or surrounding space. */
#pragma unisa module path

static int cxp_suffix(const char *s, const char *suf, long need) {
    size_t n;
    if (!s || need < 0) return 0;
    n = strlen(s);
    if (n < (size_t)need) return 0;
    return !strcmp(s + (n - (size_t)need), suf);
}

int cxp_tapebin_path(const char *path) { return cxp_suffix(path, ".tapebin", 8); }
int cxp_tape_path(const char *path) { return cxp_suffix(path, ".tape", 5); }
int cxp_object_path(const char *path) {
    return cxp_suffix(path, ".o", 2) || cxp_suffix(path, ".a", 2) || cxp_suffix(path, ".obj", 4);
}
int cxp_archive_path(const char *path) { return cxp_suffix(path, ".a", 2); }

int cxp_tapebin_target(const char *target) {
    if (!target) return 0;
    if (!strcmp(target, "lnx/x86_64")) return 1;
    if (!strcmp(target, "lnx/arm64")) return 2;
    if (!strcmp(target, "osx/x86_64")) return 3;
    if (!strcmp(target, "osx/arm64")) return 4;
    if (!strcmp(target, "win/x86_64")) return 5;
    if (!strcmp(target, "win/arm64")) return 6;
    return 0;
}
