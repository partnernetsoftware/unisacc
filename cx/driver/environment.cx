#pragma unisa module environment
/* Borrow one process-environment entry. The returned pointer belongs to the
 * process, is not retained here, and is valid only while that vector remains
 * unchanged. The caller supplies a nonnegative index through the NULL entry. */
#ifdef __UNISA__
static char *cxe_get(int argc,char **argv,int index){return __argv(__argc()+1+index);}
#else
static char *cxe_get(int argc,char **argv,int index){return argv[argc+1+index];}
#endif
char *cxe_environment(int argc,char **argv,int index){return cxe_get(argc,argv,index);}
