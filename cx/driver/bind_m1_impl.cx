#pragma unisa module bind_m1_impl
#pragma unisa use driver.stream_s1_m1
/* Authoritative S3 embedded-tape host wrapper for bind.o (src/bind.cx bd_touch).
 * Zero native fallback: carrier or VM failure refuses -2 with BIND_M1_REFUSE. */
static TapeUnitState bind_m1_unit;

static const TapeUnitSpec *bind_m1_spec(void) {
    static const TapeUnitSpec sp = {
        "tape/lnx-x86_64/manifest.tsv",
        "tape/lnx-x86_64/tapemode.so",
        "tape/lnx-x86_64/bind.tapeslice",
        "tapemode.so",
        "bind.tapeslice",
        "BINDM1BIN1",
        10L,
        "main",
        1ULL,
        2000000ULL,
        "BIND_M1_REFUSE"
    };
    return &sp;
}

int bind_m1_touch(void) {
    static const unsigned char req[4] = {'B', 'D', 'T', 0};
    long r = tape_unit_call_bytes(&bind_m1_unit, bind_m1_spec(), req, 4L);
    return r < 0L ? -2 : (int)r;
}

void bind_m1_stats(long *calls_out, long *slice_load_ns_out,
                   long *first_ns_out, long *repeat_ns_out) {
    tape_unit_stats(&bind_m1_unit, calls_out, slice_load_ns_out, first_ns_out, repeat_ns_out);
}
