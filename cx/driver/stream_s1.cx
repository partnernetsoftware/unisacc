#pragma unisa module stream_s1
#pragma unisa use runtime.stream_attributes
#pragma unisa use runtime.tape_exec
#pragma unisa use sys.env
#pragma unisa use sys.hostid
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.io
#pragma unisa use driver.tape_soload
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
/* Incremental-1 S1 container loader & fail-open shadow comparator (lnx/x86_64):
 * Kept separate from runtime.stream_attributes (pure sliceable m53 unit cxsa_valid)
 * so tapepack --export cxsa_valid stays free of host syscalls (M1 mask <= 383).
 *
 * - Default OFF (UNISACC_M53_S1 unset / "" / "0" / "native"): zero-overhead native cxsa_valid.
 * - When enabled ("1" / "shadow" -> sidecar <parent>/tape/m53.tapeslice, or explicit path),
 *   validates UTAPEBIN v1.3 layout + M1 8-slot mask (383) + M53S1ABI1 identity + T0 prelude
 *   cx_sha256 zeroed-ident[28..59] seal, invokes bounded tape executor (via aligned
 *   m53_fn_call_bytes_int seam), compares against native cxsa_valid, always adopts native result,
 *   and logs M53_S1_FALLBACK\treason=... on stderr (zero stdout pollution). */

enum {
    M53_S1_UNBOOTED = 0,
    M53_S1_LOADING = 1,
    M53_S1_READY = 2,
    M53_S1_FALLBACK = 3,
    M53_S1_MAX_IMG = 4194304L,
    M53_S1_MAX_IN = 16777216L,
    M53_S1_M1_MASK = 383ULL,
    M53_RES_STATUS = 0,
    M53_RES_STEPS = 1,
    M53_RES_FAULT = 2,
    M53_RES_RET = 3
};

static int m53_s1_state;
static int m53_s1_busy;
static unsigned char *m53_s1_img;
static long m53_s1_img_len;
static unsigned long long m53_s1_code_len;
static unsigned long long m53_s1_data_off;
static unsigned long long m53_s1_data_len;
static unsigned long long m53_s1_bss_size;
static tsl_img_t m53_s1_tsl;
static int m53_s1_detail;
static void *m53_s1_bind_fn;
static void *m53_s1_disp_fn;
static void *m53_s1_run_fn;
static int m53_s1_use_portable;
static int m53_s1_abi_ver;
static char m53_s1_reason[64];
static char m53_s1_last_mode[512];
static char m53_s1_last_so[512];

static int m53_eqz(const char *a, const char *b) {
    long i = 0;
    if (!a || !b) return 0;
    while (a[i] && b[i] && a[i] == b[i]) i++;
    return a[i] == 0 && b[i] == 0;
}

static long m53_len(const char *s, long cap) {
    long i = 0;
    if (!s) return 0;
    while (i < cap && s[i]) i++;
    return i;
}

static void m53_cpy(char *dst, long cap, const char *src) {
    long i = 0;
    if (!dst || cap <= 0) return;
    if (src) while (src[i] && i + 1 < cap) { dst[i] = src[i]; i++; }
    dst[i] = 0;
}

static void m53_wr_i64_dec(char *dst, long cap, long long v) {
    char tmp[32];
    int n = 0, i = 0;
    unsigned long long uv;
    if (cap <= 0) return;
    if (v == 0) { if (cap > 1) { dst[0] = '0'; dst[1] = 0; } else dst[0] = 0; return; }
    if (v < 0) {
        if (i + 1 < cap) dst[i++] = '-';
        uv = (unsigned long long)(-(v + 1)) + 1ULL;
    } else uv = (unsigned long long)v;
    while (uv > 0 && n < 32) { tmp[n++] = (char)('0' + (uv % 10ULL)); uv /= 10ULL; }
    while (n > 0 && i + 1 < cap) dst[i++] = tmp[--n];
    dst[i] = 0;
}

static unsigned long long m53_rd_u(const unsigned char *p, int k) {
    unsigned long long v = 0;
    int i = k - 1;
    while (i >= 0) { v = (v << 8) | (unsigned long long)(p[i] & 255); i--; }
    return v;
}

static int m53_ape_hdr(int fd) {
    unsigned char h[8];
    if (fd < 0) return 0;
    if (sy_read(fd, h, 8) != 8) return 0;
    if (h[0] == 0x7f && h[1] == 'E' && h[2] == 'L' && h[3] == 'F') return 1;
    if (h[0] == 'M' && h[1] == 'Z') return 1;
    return 0;
}

static int m53_is_win_target(void) {
    const char *t = tn_self();
    return t && (m53_eqz(t, "win/x86_64") || m53_eqz(t, "win/arm64"));
}

static int m53_is_sep(char c, int is_win) {
    return c == '/' || (is_win && c == '\\');
}

static int m53_split_parent(const char *path, char *dir, long dcap, char *leaf, long lcap) {
    int is_win = m53_is_win_target();
    long n = m53_len(path, 512), at = n, i;
    if (n <= 0 || n >= 512) return -EINVAL;
    while (at > 0 && !m53_is_sep(path[at - 1], is_win)) at--;
    if (at == 0) return -EINVAL;
    if (at == 1) {
        if (dcap < 2 || n - at + 1 > lcap) return -ENAMETOOLONG;
        dir[0] = path[0]; dir[1] = 0;
    } else if (is_win && at == 3 && path[1] == ':') {
        /* Windows drive root (e.g. C:\file -> parent C:\) */
        if (dcap < 4 || n - at + 1 > lcap) return -ENAMETOOLONG;
        dir[0] = path[0]; dir[1] = path[1]; dir[2] = path[2]; dir[3] = 0;
    } else {
        if (at > dcap) return -ENAMETOOLONG;
        for (i = 0; i < at - 1; i++) dir[i] = path[i];
        dir[at - 1] = 0;
    }
    if (n - at + 1 > lcap || n == at) return -EINVAL;
    for (i = 0; i <= n - at; i++) leaf[i] = path[at + i];
    return 0;
}

static int m53_open_checked_path(const char *path, int is_exec, const char **reason_out, long *size_out) {
    char dir[512], leaf[256];
    sy_stat_t st;
    long uid = sy_euid();
    int pfd, cfd;
    if (m53_split_parent(path, dir, (long)sizeof dir, leaf, (long)sizeof leaf) != 0) {
        *reason_out = is_exec ? "exec-absent" : "absent";
        return -1;
    }
    pfd = sy_open_dir_nofollow(dir);
    if (pfd == -ENOSYS) {
        /* Named refusal on Windows in v0.1.9: handle-level reparse/owner checks are v0.1.10 work. */
        *reason_out = "win-sidecar-unsupported";
        return -1;
    }
    if (pfd < 0) { *reason_out = pfd == -ENOENT ? (is_exec ? "exec-absent" : "absent") : "untrusted"; return -1; }
    if (sy_fstat(pfd, &st) != 0 || st.kind != 'd' || !sy_stat_trusted_owner(&st, uid)) {
        sy_close(pfd); *reason_out = "untrusted"; return -1;
    }
    cfd = sy_openat_read_nofollow(pfd, leaf);
    sy_close(pfd);
    if (cfd < 0) { *reason_out = cfd == -ENOENT ? (is_exec ? "exec-absent" : "absent") : "untrusted"; return -1; }
    if (sy_fstat(cfd, &st) != 0 || st.kind != 'f' || !sy_stat_trusted_owner(&st, uid)) {
        sy_close(cfd); *reason_out = "untrusted"; return -1;
    }
    if (st.size == 0) { sy_close(cfd); *reason_out = is_exec ? "exec-absent" : "empty"; return -1; }
    if (st.size < 0 || st.size > M53_S1_MAX_IMG) { sy_close(cfd); *reason_out = "corrupt"; return -1; }
    if (size_out) *size_out = st.size;
    return cfd;
}

static int m53_open_sidecar(const char *mode, char *resolved_dir, long rcap,
                            const char **reason_out, long *size_out) {
    char exe[512], outer[512], dir[512], leaf[256];
    sy_stat_t st;
    long uid = sy_euid();
    int pfd = -1, tfd = -1, cfd = -1;
    if (m53_eqz(mode, "1") || m53_eqz(mode, "shadow")) {
        const char *ape = sy_env("UNISACC_APE_SELF");
        if (ape && ape[0]) {
            if (sy_realpath(ape, outer, (int)sizeof outer) < 0 ||
                m53_split_parent(outer, dir, (long)sizeof dir, leaf, (long)sizeof leaf) != 0) {
                *reason_out = "absent"; return -1;
            }
            pfd = sy_open_dir_nofollow(dir);
            if (pfd == -ENOSYS) { *reason_out = "win-sidecar-unsupported"; return -1; }
            if (pfd < 0) { *reason_out = pfd == -ENOENT ? "absent" : "untrusted"; return -1; }
            if (sy_fstat(pfd, &st) != 0 || st.kind != 'd' || !sy_stat_trusted_owner(&st, uid)) {
                sy_close(pfd); *reason_out = "untrusted"; return -1;
            }
            int afd = sy_openat_read_nofollow(pfd, leaf);
            int is_ape = m53_ape_hdr(afd);
            if (afd >= 0) sy_close(afd);
            if (!is_ape) { sy_close(pfd); *reason_out = "untrusted"; return -1; }
        } else {
            if (sy_self_path(exe, (int)sizeof exe) < 0 ||
                m53_split_parent(exe, dir, (long)sizeof dir, leaf, (long)sizeof leaf) != 0) {
                *reason_out = "absent"; return -1;
            }
            pfd = sy_open_dir_nofollow(dir);
            if (pfd == -ENOSYS) { *reason_out = "win-sidecar-unsupported"; return -1; }
            if (pfd < 0) { *reason_out = pfd == -ENOENT ? "absent" : "untrusted"; return -1; }
            if (sy_fstat(pfd, &st) != 0 || st.kind != 'd' || !sy_stat_trusted_owner(&st, uid)) {
                sy_close(pfd); *reason_out = "untrusted"; return -1;
            }
        }
        tfd = sy_openat_read_nofollow(pfd, "tape");
        sy_close(pfd);
        if (tfd < 0) { *reason_out = tfd == -ENOENT ? "absent" : "untrusted"; return -1; }
        if (sy_fstat(tfd, &st) != 0 || st.kind != 'd' || !sy_stat_trusted_owner(&st, uid)) {
            sy_close(tfd); *reason_out = "untrusted"; return -1;
        }
        cfd = sy_openat_read_nofollow(tfd, "m53.tapeslice");
        sy_close(tfd);
        if (cfd < 0) { *reason_out = cfd == -ENOENT ? "absent" : "untrusted"; return -1; }
        if (sy_fstat(cfd, &st) != 0 || st.kind != 'f' || !sy_stat_trusted_owner(&st, uid)) {
            sy_close(cfd); *reason_out = "untrusted"; return -1;
        }
        if (st.size == 0) { sy_close(cfd); *reason_out = "empty"; return -1; }
        if (st.size < 0 || st.size > M53_S1_MAX_IMG) { sy_close(cfd); *reason_out = "corrupt"; return -1; }
        if (size_out) *size_out = st.size;
        if (rcap > 0) {
            long dl = m53_len(dir, 480);
            if (dl + 6 < rcap) {
                long i;
                for (i = 0; i < dl; i++) resolved_dir[i] = dir[i];
                resolved_dir[dl++] = '/'; resolved_dir[dl++] = 't'; resolved_dir[dl++] = 'a';
                resolved_dir[dl++] = 'p'; resolved_dir[dl++] = 'e'; resolved_dir[dl] = 0;
            } else resolved_dir[0] = 0;
        }
        return cfd;
    }
    if (rcap > 0) {
        if (m53_split_parent(mode, resolved_dir, rcap, leaf, (long)sizeof leaf) != 0) resolved_dir[0] = 0;
    }
    return m53_open_checked_path(mode, 0, reason_out, size_out);
}

static int m53_validate_utapebin(const unsigned char *b, long len) {
    static const char *tags[6] = {"CODE", "DATA", "BSSZ", "SYMS", "RELO", "HOST"};
    const char *magic = "UTAPEBIN", *abi_tag = "M53S1ABI1";
    unsigned long long entry_off, nsect, dir_off, origin, prev_end = 208;
    unsigned long long code_len = 0, data_off = 0, data_len = 0, bss_sz = 0;
    unsigned char *tmp, dig[32], seen_host[37];
    int i, j, has_abi = 0;
    if (!b || len < 216) return 1;
    for (i = 0; i < 8; i++) if (b[i] != (unsigned char)magic[i]) return 1;
    if (m53_rd_u(b + 8, 2) != 1 || m53_rd_u(b + 10, 2) != 3) return 1;
    if (m53_rd_u(b + 12, 2) != 1 || m53_rd_u(b + 14, 2) != 0) return 1;
    entry_off = m53_rd_u(b + 16, 4);
    nsect = m53_rd_u(b + 20, 4);
    dir_off = m53_rd_u(b + 24, 4);
    origin = m53_rd_u(b + 60, 4);
    if (nsect != 6 || dir_off != 64 || origin > 6) return 1;
    for (i = 0; i < 6; i++) {
        int d = 64 + 24 * i;
        unsigned long long soff, slen, scnt, aligned;
        for (j = 0; j < 4; j++) if (b[d + j] != (unsigned char)tags[i][j]) return 1;
        soff = m53_rd_u(b + d + 4, 8);
        slen = m53_rd_u(b + d + 12, 8);
        scnt = m53_rd_u(b + d + 20, 4);
        aligned = prev_end + ((8ULL - (prev_end & 7ULL)) & 7ULL);
        if (soff != aligned) return 1;
        if (soff > (unsigned long long)len || slen > (unsigned long long)len - soff) return 1;
        while (prev_end < soff) { if (b[prev_end] != 0) return 1; prev_end++; }
        if (i == 0) code_len = slen;
        if (i == 1) { data_off = soff; data_len = slen; }
        if (i == 2) { if (slen != 8 || scnt != 1) return 1; bss_sz = m53_rd_u(b + soff, 8); }
        if (i == 3) {
            unsigned long long r;
            if ((slen & 15ULL) != 0 || scnt != (slen >> 4)) return 1;
            for (r = 0; r < scnt; r++) {
                const unsigned char *row = b + soff + (r << 4);
                unsigned long long noff = m53_rd_u(row, 4), k;
                int nul_ok = 0;
                if (row[4] > 3 || row[5] > 3 || m53_rd_u(row + 6, 2) != 0) return 1;
                if (noff >= data_len || b[data_off + noff] == 0) return 1;
                for (k = noff; k < data_len; k++) if (b[data_off + k] == 0) { nul_ok = 1; break; }
                if (!nul_ok) return 1;
            }
        }
        if (i == 4) {
            unsigned long long r;
            if ((slen & 15ULL) != 0 || scnt != (slen >> 4)) return 1;
            for (r = 0; r < scnt; r++) {
                const unsigned char *row = b + soff + (r << 4);
                unsigned long long rpos = m53_rd_u(row, 8);
                if (row[8] > 3 || row[9] < 1 || row[9] > 10 || m53_rd_u(row + 10, 2) != 0) return 1;
                if (rpos == 0 || rpos >= code_len || (unsigned long long)row[9] > code_len - rpos) return 1;
            }
        }
        if (i == 5) {
            unsigned long long hpos = 0, r;
            for (j = 0; j < 37; j++) seen_host[j] = 0;
            for (r = 0; r < scnt; r++) {
                unsigned long long slot, nlen;
                if (slen - hpos < 4) return 1;
                slot = m53_rd_u(b + soff + hpos, 2);
                nlen = m53_rd_u(b + soff + hpos + 2, 2);
                hpos += 4;
                if (slot >= 37 || seen_host[slot] || ((M53_S1_M1_MASK >> slot) & 1ULL) == 0ULL) return 1;
                if (nlen > slen - hpos) return 1;
                seen_host[slot] = 1;
                hpos += nlen;
            }
            if (hpos != slen) return 1;
        }
        prev_end = soff + slen;
    }
    if (prev_end != (unsigned long long)len) return 1;
    if (code_len == 0 && entry_off != 0) return 1;
    if (code_len > 0 && entry_off >= code_len) return 1;
    tmp = (unsigned char *)mm_alloc((size_t)len);
    if (!tmp) return 1;
    if (mm_copy(tmp, len, b, len)) { mm_free(tmp); return 1; }
    for (i = 0; i < 32; i++) tmp[28 + i] = 0;
    /* Immutable T0 bootstrap root: container identity SHA-256 via prelude cx_sha256. */
    cx_sha256(tmp, (size_t)len, dig);
    mm_free(tmp);
    for (i = 0; i < 32; i++) if (b[28 + i] != dig[i]) return 1;
    if (data_len >= 9) {
        static const char abi_bin2[10] = "M53S1BIN2";
        unsigned long long pos;
        for (pos = 0; pos + 9ULL <= data_len; pos++) {
            int ok1 = 1, ok2 = 1;
            for (j = 0; j < 9; j++) {
                unsigned char ch = b[data_off + pos + (unsigned long long)j];
                if (ch != (unsigned char)abi_tag[j]) ok1 = 0;
                if (ch != (unsigned char)abi_bin2[j]) ok2 = 0;
            }
            if (ok2) { has_abi = 2; break; }
            if (ok1 && has_abi == 0) has_abi = 1;
        }
    }
    if (!has_abi) return 2;
    m53_s1_abi_ver = has_abi;
    m53_s1_code_len = code_len;
    m53_s1_data_off = data_off;
    m53_s1_data_len = data_len;
    m53_s1_bss_size = bss_sz;
    return 0;
}

static int m53_load_exec(const char *tape_dir, const char *so_ovr, const char **reason_out) {
    static const char *const sym_names[3] = {
        "hoststub_lnx_x86_64_bind",
        "hoststub_lnx_x86_64",
        "tape_run_x86_64"
    };
    char so_path[560];
    const char *use_path = 0;
    int fd, rc;
    long sz = 0, got = 0;
    unsigned char *ebuf = 0;
    tsl_img_t im;

    tsl_unload(&m53_s1_tsl);
    m53_s1_bind_fn = 0; m53_s1_disp_fn = 0; m53_s1_run_fn = 0;
    m53_s1_use_portable = 0;
    m53_s1_detail = 0;

    if (so_ovr && m53_eqz(so_ovr, "portable")) {
        const char *stgt = tn_self();
        if (!stgt || m53_eqz(stgt, "lnx/x86_64")) {
            *reason_out = "exec-target-disallowed";
            return -1;
        }
        m53_s1_use_portable = 1;
        return 0;
    }

    if (so_ovr && so_ovr[0]) {
        use_path = so_ovr;
    } else {
        so_path[0] = 0;
        if (tape_dir && tape_dir[0]) {
            long tl = m53_len(tape_dir, 500), i;
            if (tl + 13 < (long)sizeof so_path) {
                const char *nm = "/tapemode.so";
                for (i = 0; i < tl; i++) so_path[i] = tape_dir[i];
                for (i = 0; i <= 12; i++) so_path[tl + i] = nm[i];
            }
        }
        if (!so_path[0]) { *reason_out = "exec-absent"; return -1; }
        use_path = so_path;
    }

    fd = m53_open_checked_path(use_path, 1, reason_out, &sz);
    if (fd < 0) return -1;
    ebuf = (unsigned char *)mm_alloc((size_t)sz);
    if (!ebuf) { sy_close(fd); *reason_out = "exec-absent"; return -1; }
    while (got < sz) {
        long rr = sy_read(fd, ebuf + got, sz - got);
        if (rr <= 0) break;
        got += rr;
    }
    sy_close(fd);
    if (got != sz) {
        mm_free(ebuf);
        *reason_out = "exec-absent";
        return -1;
    }
    for (unsigned long k = 0; k < (unsigned long)sizeof im; k++) ((unsigned char *)&im)[k] = 0;
    rc = tsl_check(ebuf, got, sym_names, &im);
    if (rc != 0) {
        mm_free(ebuf);
        m53_s1_detail = rc;
        *reason_out = "exec-absent";
        return -1;
    }
    rc = tsl_map(ebuf, got, &im);
    mm_free(ebuf);
    if (rc != 0) {
        m53_s1_detail = rc;
        *reason_out = "exec-absent";
        return -1;
    }
    for (rc = 0; rc < TSL_I_WORDS; rc++) m53_s1_tsl[rc] = im[rc];
    m53_s1_bind_fn = tsl_addr(&m53_s1_tsl, 0);
    m53_s1_disp_fn = tsl_addr(&m53_s1_tsl, 1);
    m53_s1_run_fn = tsl_addr(&m53_s1_tsl, 2);
    if (!m53_s1_bind_fn || !m53_s1_disp_fn || !m53_s1_run_fn) {
        tsl_unload(&m53_s1_tsl);
        m53_s1_bind_fn = 0; m53_s1_disp_fn = 0; m53_s1_run_fn = 0;
        *reason_out = "exec-absent";
        return -1;
    }
    return 0;
}

static void m53_s1_boot(const char *mode, const char *so_ovr) {
    const char *why = "absent";
    char tape_dir[512];
    int fd, vrc;
    long sz = 0, got = 0;
    unsigned char *buf;
    m53_s1_state = M53_S1_LOADING;
    m53_s1_detail = 0;
    tape_dir[0] = 0;
    if (m53_s1_img) { mm_free(m53_s1_img); m53_s1_img = 0; m53_s1_img_len = 0; }
    fd = m53_open_sidecar(mode, tape_dir, (long)sizeof tape_dir, &why, &sz);
    if (fd < 0) { m53_cpy(m53_s1_reason, (long)sizeof m53_s1_reason, why); m53_s1_state = M53_S1_FALLBACK; return; }
    buf = (unsigned char *)mm_alloc((size_t)sz);
    if (!buf) { sy_close(fd); m53_cpy(m53_s1_reason, (long)sizeof m53_s1_reason, "corrupt"); m53_s1_state = M53_S1_FALLBACK; return; }
    while (got < sz) { long r = sy_read(fd, buf + got, sz - got); if (r <= 0) break; got += r; }
    sy_close(fd);
    vrc = (got == sz) ? m53_validate_utapebin(buf, got) : 1;
    if (vrc != 0) {
        mm_free(buf);
        m53_cpy(m53_s1_reason, (long)sizeof m53_s1_reason, vrc == 2 ? "swap" : "corrupt");
        m53_s1_state = M53_S1_FALLBACK; return;
    }
    if (m53_load_exec(tape_dir, so_ovr, &why) != 0) {
        mm_free(buf); m53_cpy(m53_s1_reason, (long)sizeof m53_s1_reason, why); m53_s1_state = M53_S1_FALLBACK; return;
    }
    m53_s1_img = buf; m53_s1_img_len = got;
    m53_cpy(m53_s1_reason, (long)sizeof m53_s1_reason, "ok");
    m53_s1_state = M53_S1_READY;
}

/* Product BIN2 argument-block packer: sign-extends host long (32-bit on Win LLP64) to 64-bit u64. */
void m53_s1_pack_bin2(unsigned long long bin_blk[3], unsigned long long guest_ptr, long len) {
    bin_blk[0] = guest_ptr;
    bin_blk[1] = (unsigned long long)(long long)len;
    bin_blk[2] = 0ULL;
}

/* Aligned function-level call seam (shared interface contract with agyneon2).
 * Allocates linear arena with isolated 64 KiB guest stack below argv_at,
 * copies bounded input slice if non-null, binds hoststub, executes symbol/entry
 * under step budget, and returns exit status/integer result in out->ret_val. */
static int m53_fn_call_bytes_int(const unsigned char *img, long img_len,
                                 void *bind_fn, void *disp_fn, void *run_fn,
                                 const char *sym_name, const unsigned char *bytes, long len,
                                 unsigned long long budget, unsigned long long out[4]) {
    unsigned long long data_aligned, copy_n, in_off, in_end, argv_at, argbuf_off, memlimit, ibitmap_cap;
    unsigned char *mem = 0, *ibm = 0;
    unsigned long long args[12], result[5], *guest_argv;
    char *abuf, *a0, *a1, *a2;
    int i;
    if (!out || (!m53_s1_use_portable && !m53_s1_tsl[TSL_I_BASE]) || len > M53_S1_MAX_IN) return -1;
    if (m53_s1_data_len > ~7ULL) return -2;
    data_aligned = (m53_s1_data_len + 7ULL) & ~7ULL;
    if (m53_s1_bss_size > 0x20000000ULL - 65536ULL - data_aligned) return -2;
    in_off = data_aligned + m53_s1_bss_size;
    copy_n = (bytes && len > 0) ? (unsigned long long)len : 0ULL;
    in_end = (in_off + copy_n + 7ULL) & ~7ULL;
    argv_at = in_end + 65536ULL;
    argbuf_off = argv_at + 64ULL;
    memlimit = argbuf_off + 128ULL;
    ibitmap_cap = (m53_s1_code_len >> 3) + ((m53_s1_code_len & 7ULL) != 0ULL ? 1ULL : 0ULL);
    if (ibitmap_cap == 0ULL) ibitmap_cap = 1ULL;
    mem = (unsigned char *)mm_alloc((size_t)memlimit);
    ibm = (unsigned char *)mm_alloc((size_t)ibitmap_cap);
    if (!mem || !ibm) { if (mem) mm_free(mem); if (ibm) mm_free(ibm); return -2; }
    for (unsigned long long k = 0; k < memlimit; k++) mem[k] = 0;
    for (unsigned long long k = 0; k < ibitmap_cap; k++) ibm[k] = 0;
    if (m53_s1_data_len > 0) mm_copy(mem, (long)memlimit, img + m53_s1_data_off, (long)m53_s1_data_len);
    if (copy_n > 0) mm_copy(mem + in_off, (long)(memlimit - in_off), bytes, (long)copy_n);
    guest_argv = (unsigned long long *)(mem + argv_at);
    if (m53_s1_abi_ver == 2) {
        unsigned long long *bin_blk = (unsigned long long *)(mem + argbuf_off);
        m53_s1_pack_bin2(bin_blk, bytes ? (unsigned long long)(mem + in_off) : 0ULL, len);
        guest_argv[0] = (unsigned long long)(mem + argbuf_off + 16ULL);
        guest_argv[1] = (unsigned long long)bin_blk;
        guest_argv[2] = (unsigned long long)(mem + argbuf_off + 16ULL);
        guest_argv[3] = 0ULL;
    } else {
        abuf = (char *)(mem + argbuf_off);
        a0 = abuf; m53_cpy(a0, 32, sym_name ? sym_name : "cxsa_valid");
        a1 = a0 + 32; m53_wr_i64_dec(a1, 32, bytes ? (long long)(unsigned long long)(mem + in_off) : 0LL);
        a2 = a1 + 32; m53_wr_i64_dec(a2, 32, (long long)len);
        guest_argv[0] = (unsigned long long)a0;
        guest_argv[1] = (unsigned long long)a1;
        guest_argv[2] = (unsigned long long)a2;
        guest_argv[3] = 0;
    }
    {
        for (i = 0; i < 12; i++) args[i] = 0;
        for (i = 0; i < 5; i++) result[i] = 0;
        args[0] = 4; args[1] = (unsigned long long)img; args[2] = memlimit;
        args[3] = budget; args[4] = 3ULL; args[5] = (unsigned long long)guest_argv;
        args[6] = (unsigned long long)result; args[7] = (unsigned long long)img_len;
        args[8] = m53_s1_use_portable ? 0ULL : (unsigned long long)disp_fn;
        args[9] = (unsigned long long)mem;
        args[10] = (unsigned long long)ibm; args[11] = ibitmap_cap;
        if (m53_s1_use_portable) {
            (void)tape_run_cx(args);
        } else {
            (void)tsl_call2(&m53_s1_tsl, bind_fn, (long)mem, (long)memlimit);
            (void)tsl_call2(&m53_s1_tsl, run_fn, (long)args, 0L);
        }
    }
    out[M53_RES_STATUS] = result[0];
    out[M53_RES_STEPS] = result[2];
    out[M53_RES_FAULT] = result[4];
    out[M53_RES_RET] = (unsigned long long)(int)(result[1] & 255ULL);
    mm_free(ibm); mm_free(mem);
    return 0;
}

int cxsa_valid_s1(const unsigned char *data, long length) {
    int native_ret = cxsa_valid(data, length);
    const char *mode = sy_env("UNISACC_M53_S1"), *so_ovr, *so_s;
    unsigned long long res[4];
    int call_rc, tape_ret;
    if (!mode || !mode[0] || m53_eqz(mode, "0") || m53_eqz(mode, "native")) return native_ret;
    if (m53_s1_busy) { sy_eprintf("M53_S1_FALLBACK\treason=reentrant\n"); return native_ret; }
    m53_s1_busy = 1;
    so_ovr = sy_env("UNISACC_M53_S1_SO");
    so_s = so_ovr ? so_ovr : "";
    if (!m53_eqz(mode, m53_s1_last_mode) || !m53_eqz(so_s, m53_s1_last_so)) {
        m53_cpy(m53_s1_last_mode, (long)sizeof m53_s1_last_mode, mode);
        m53_cpy(m53_s1_last_so, (long)sizeof m53_s1_last_so, so_s);
        m53_s1_state = M53_S1_UNBOOTED;
    }
    if (m53_s1_state == M53_S1_UNBOOTED) m53_s1_boot(mode, so_s);
    if (m53_s1_state == M53_S1_LOADING) {
        sy_eprintf("M53_S1_FALLBACK\treason=bootstrap-not-ready\n");
        m53_s1_busy = 0; return native_ret;
    }
    if (m53_s1_state != M53_S1_READY) {
        if (m53_s1_detail > 0) {
            sy_eprintf("M53_S1_FALLBACK\treason=%s\tdetail=%d\n", m53_s1_reason[0] ? m53_s1_reason : "fallback", m53_s1_detail);
        } else {
            sy_eprintf("M53_S1_FALLBACK\treason=%s\n", m53_s1_reason[0] ? m53_s1_reason : "fallback");
        }
        m53_s1_busy = 0; return native_ret;
    }
    if (length > M53_S1_MAX_IN) {
        sy_eprintf("M53_S1_FALLBACK\treason=too-large\n");
        m53_s1_busy = 0; return native_ret;
    }
    call_rc = m53_fn_call_bytes_int(m53_s1_img, m53_s1_img_len,
                                    m53_s1_bind_fn, m53_s1_disp_fn, m53_s1_run_fn,
                                    "cxsa_valid", data, length, 2000000ULL, res);
    if (call_rc != 0 || res[M53_RES_STATUS] != 0ULL) {
        sy_eprintf("M53_S1_FALLBACK\treason=vm-fail\tstatus=%llu\tfault=%llu\n",
                   call_rc ? 99ULL : res[M53_RES_STATUS], call_rc ? 0ULL : res[M53_RES_FAULT]);
        m53_s1_busy = 0; return native_ret;
    }
    tape_ret = (int)res[M53_RES_RET];
    if (tape_ret != native_ret) {
        sy_eprintf("M53_S1_FALLBACK\treason=mismatch\tnative=%d\ttape=%d\n", native_ret, tape_ret);
    }
    m53_s1_busy = 0;
    return native_ret;
}
