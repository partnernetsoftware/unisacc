#pragma unisa module emissionroute
/* Driver emission boundaries. Object output retains every definition; only
   whole-program image/run routes may execute reachability pruning. The span
   callback owns each input exactly as st_span does, including failure paths. */
typedef int (*DverSpan)(const char *,const char *,const char *,int,unsigned,
    const char *,const char *,unsigned char *,long,unsigned char **,long *,char *,int);
const char *dver_tape_target(const char *target,int sawS,int mode,int has_origin,
                             const char *default_target) {
    if (!target && sawS && mode == 2 && !has_origin) return default_target;
    return target;
}
int dver_span(DverSpan span,int object,int level,const char *route,const char *target,
              const char *source,int cx,unsigned unit,const char *first,
              unsigned char *in,long inn,unsigned char **out,long *outn,char *why,int cap) {
    unsigned char *mid = 0;
    long midn = 0;
    int status;
    if (!object || (first && !level))
        return span(route,target,source,cx,unit,first,0,in,inn,out,outn,why,cap);
    status = span(route,target,source,cx,unit,first,level ? "e4" : "tapecheck",in,inn,&mid,&midn,why,cap);
    if (status) return status;
    return span(route,target,source,cx,unit,"lower",0,mid,midn,out,outn,why,cap);
}
