/* module cli. Command-line parsing, including the resource options.
   The caller owns one CxcState, one CxcResources through res, and one
   CxcOps through ops. These functions borrow argv and do not write its
   slots or the bytes of any argument. They do not allocate for
   themselves. The caller's record and line may grow the caller's
   blocks. There is no mutable module state. They do not call die,
   exit, clierror, or fprintf, and they do not assign INCDIR or
   fwd_libs. This module does not use the args module. The caller
   fills record, line, and cancel. A consumer that uses args injects
   cxa_record, cxa_line, and cxa_cancel.

   Transitional C callers paste these typedefs and these prototypes.
   CxcState is eight pointers, then eighteen ints, then res, then ops.
   Natural alignment, no pack attribute. On LP64 and LLP64 that is
   8-byte pointers and 4-byte ints. The original fields stay at their
   old offsets, sizeof was 136, res is the pointer at offset 136, and
   ops is the pointer at offset 144. sizeof CxcState is 152.
   CxcResources is nineteen pointers, sizeof 152, with no interior
   padding. CxcOps is three function pointers, sizeof 24.
   tools/check-driver-cli.cx locks every offset.

     typedef struct {
         unsigned char **defs;
         unsigned char **undefs;
         unsigned char **forced;
         unsigned char **incdir;
         unsigned char **quotedir;
         unsigned char **errorlimit;
         long *defs_n;
         long *undefs_n;
         long *forced_n;
         long *incdir_n;
         long *quotedir_n;
         long *error_n;
         long *defs_cap;
         long *undefs_cap;
         long *forced_cap;
         long *incdir_cap;
         long *quotedir_cap;
         long *error_cap;
         const char *last_include;
     } CxcResources;
     typedef struct {
         int (*record)(unsigned char **, long *, long *, const char *, char *, long);
         int (*line)(unsigned char **, long *, long *, const char *, char *, long);
         int (*cancel)(unsigned char **, long *, const char *, char *, long);
     } CxcOps;
     typedef struct {
         const char *out;
         const char *target;
         const char *pkg;
         const char *deps;
         const char *host_symbols_path;
         const char *host_provider_path;
         const char **deptargets;
         int *depquoted;
         int deptarget_cap;
         int ndeptargets;
         int mode;
         int level;
         int explicit_image;
         int runit;
         int force_origin;
         int emitbin;
         int deponly;
         int depphony;
         int sawc;
         int sawS;
         int funit;
         int warnings;
         int defrun;
         int werror;
         int nostd;
         int notrim;
         CxcResources *res;
         CxcOps *ops;
     } CxcState;
     int cxc_default_run(CxcState *st, char **argv, int argc,
                         char *why, long whycap);
     int cxc_step(CxcState *st, char **argv, int argc, int *index,
                  char *why, long whycap);

   char ** matches main. A const char ** parameter would not accept
   main's argv under the host warning set. Borrowing is the contract,
   not a const qualifier.

   cxc_default_run scans argv[1..argc). A "--" ends the scan. A single
   letter o, b, t, S, c, E, or M is a mode flag, as are the exact words
   -run, -dump-tokens, --tapebin, --version, and -version. The exact
   words --models, -I, -iquote, -D, -U, -include, -MF, -MT, -MQ,
   --emit-host-symbols, and --host-provider skip the following slot
   without reading it, so that slot cannot itself count as a mode flag.
   -DFOO, -Ifoo, and -iquotepath do not skip. With no mode flag, runit
   and defrun become 1. A mode flag leaves every field unchanged, so an
   explicit -run does not set defrun. --force-origin, -funit, --help,
   and -Werror are not mode flags.

   cxc_step reads argv[*index] only.
     0  this slice consumed the option. *index is the next slot.
        The caller must not also increment.
     1  not this slice. *index and every state field stay unchanged.
        The caller handles -l/-L/-x, --help/--version, positionals,
        "--", ledger words, and unknown words. -ferror-limit without
        '=' is one of those unknown words, as is -includefoo.
     5  missing or refused argument. *index and every state field stay
        unchanged. why receives the phrase the driver passes to
        clierror. This 5 is not an args-module failure and must not
        be turned into die. A null res, a null ops, a null function
        this option needs, or a null pointer inside the view this
        option needs, is also 5 "bad argument", and only after a
        present argument has been resolved. A missing argument is
        reported first and does not read res or ops. -D requires both
        cancel and record before cancel runs. -ferror-limit= requires
        record before it sets the error-limit length to 0.
     7  a call through record, line, or cancel failed. *index and
        every CxcState field stay unchanged. why is that call's phrase.
        The caller must die(why), not clierror. Two failures are
        already committed and are not rolled back: -ferror-limit=
        sets the error-limit length to 0 before record, and -D
        finishes cancel before record. A cancel failure does
        not record. When the caller injects cxa_cancel, that entry
        removes undef records whose whole bytes equal the name of the
        -D text, and that name stops before '='. A stored FOO=1 record
        therefore stays when the later definition is FOO. -I publishes
        last_include only after line returns 0. The caller assigns
        INCDIR from last_include after
        the walk. -l/-L/-x stay at return 1.
   A missing -b or -t therefore does not update mode. The in-driver
   loop used to assign mode and then return; that write died with the
   stack frame. Here the state is the caller's object, so the write
   waits until the argument is present.
   -MD and -MMD store a read-only empty string only when deps is null.
   -M and -MM also set deponly and mode 1. -MF after either keeps the
   path that -MF stored. werror, nostd, and notrim are sticky ints.
   The caller emits any one-byte resource after the walk. -S and -c
   both set mode 2 and do not clear each other's saw bit. -b sets
   mode 0 and explicit_image 1. -t sets mode 2 and explicit_image 0.
   A later mode flag does not clear sawc or sawS. -O and -Os store
   level 1, -O2 and -O3 store 2, and -O0 stores 0; the last one wins.
   -g and -std= are accepted and change no field.
   why is left untouched when it is null or whycap <= 0. A short
   positive cap receives a truncated phrase and a terminating NUL.
   Success clears why when the buffer is usable. Return 1 does not. */
#pragma unisa module cli

typedef struct {
    unsigned char **defs;
    unsigned char **undefs;
    unsigned char **forced;
    unsigned char **incdir;
    unsigned char **quotedir;
    unsigned char **errorlimit;
    long *defs_n;
    long *undefs_n;
    long *forced_n;
    long *incdir_n;
    long *quotedir_n;
    long *error_n;
    long *defs_cap;
    long *undefs_cap;
    long *forced_cap;
    long *incdir_cap;
    long *quotedir_cap;
    long *error_cap;
    const char *last_include;
} CxcResources;

typedef struct {
    int (*record)(unsigned char **, long *, long *, const char *, char *, long);
    int (*line)(unsigned char **, long *, long *, const char *, char *, long);
    int (*cancel)(unsigned char **, long *, const char *, char *, long);
} CxcOps;

typedef struct {
    const char *out;
    const char *target;
    const char *pkg;
    const char *deps;
    const char *host_symbols_path;
    const char *host_provider_path;
    const char **deptargets;
    int *depquoted;
    int deptarget_cap;
    int ndeptargets;
    int mode;
    int level;
    int explicit_image;
    int runit;
    int force_origin;
    int emitbin;
    int deponly;
    int depphony;
    int sawc;
    int sawS;
    int funit;
    int warnings;
    int defrun;
    int werror;
    int nostd;
    int notrim;
    CxcResources *res;
    CxcOps *ops;
} CxcState;

static void cxc_setwhy(char *why, long cap, const char *msg) {
    long i;
    if (!why || cap <= 0) return;
    i = 0;
    if (msg) while (msg[i] && i + 1 < cap) { why[i] = msg[i]; i = i + 1; }
    why[i] = 0;
}

static int cxc_fail(int rc, const char *msg, char *why, long whycap) {
    cxc_setwhy(why, whycap, msg);
    return rc;
}

static int cxc_ok(char *why, long whycap) {
    cxc_setwhy(why, whycap, 0);
    return 0;
}

static int cxc_skips(const char *a) {
    return !strcmp(a, "--models") || !strcmp(a, "-I") || !strcmp(a, "-iquote")
        || !strcmp(a, "-D") || !strcmp(a, "-U") || !strcmp(a, "-include")
        || !strcmp(a, "-MF") || !strcmp(a, "-MT") || !strcmp(a, "-MQ")
        || !strcmp(a, "--emit-host-symbols") || !strcmp(a, "--host-provider");
}

static int cxc_mode_word(const char *a) {
    return !strcmp(a, "-run") || !strcmp(a, "-dump-tokens") || !strcmp(a, "--tapebin")
        || !strcmp(a, "--version") || !strcmp(a, "-version");
}

static int cxc_need(char **argv, int argc, int index, char **out) {
    if (index + 1 >= argc) return 0;
    if (!argv[index + 1]) return -1;
    *out = argv[index + 1];
    return 1;
}

static int cxc_arg(char **argv, int argc, int index, const char *a, int at, char **out,
                   const char *missing, char *why, long whycap) {
    int got;
    if (a[at]) { *out = (char *)(a + at); return 0; }
    got = cxc_need(argv, argc, index, out);
    if (got == 0) return cxc_fail(5, missing, why, whycap);
    if (got < 0) return cxc_fail(5, "bad argument", why, whycap);
    return 0;
}

static int cxc_advance(int *index, const char *a, int at, char *why, long whycap) {
    *index = *index + (a[at] ? 1 : 2);
    return cxc_ok(why, whycap);
}

static int cxc_macro(CxcState *st, char **argv, int argc, int *index, const char *a,
                     char *why, long whycap) {
    CxcResources *r;
    char *arg;
    int rc;
    rc = cxc_arg(argv, argc, *index, a, 2, &arg, "missing macro argument", why, whycap);
    if (rc) return rc;
    r = st->res;
    if (a[1] == 'D') {
        if (!r || !st->ops || !st->ops->cancel || !st->ops->record
            || !r->undefs || !r->undefs_n || !r->defs || !r->defs_n || !r->defs_cap)
            return cxc_fail(5, "bad argument", why, whycap);
        rc = st->ops->cancel(r->undefs, r->undefs_n, arg, why, whycap);
        if (rc) return 7;
        rc = st->ops->record(r->defs, r->defs_n, r->defs_cap, arg, why, whycap);
        if (rc) return 7;
    } else {
        if (!r || !st->ops || !st->ops->record || !r->undefs || !r->undefs_n || !r->undefs_cap)
            return cxc_fail(5, "bad argument", why, whycap);
        rc = st->ops->record(r->undefs, r->undefs_n, r->undefs_cap, arg, why, whycap);
        if (rc) return 7;
    }
    return cxc_advance(index, a, 2, why, whycap);
}

static int cxc_include(CxcState *st, char **argv, int argc, int *index, char *why, long whycap) {
    CxcResources *r;
    char *arg;
    int got;
    int rc;
    got = cxc_need(argv, argc, *index, &arg);
    if (got == 0) return cxc_fail(5, "missing forced include", why, whycap);
    if (got < 0) return cxc_fail(5, "bad argument", why, whycap);
    r = st->res;
    if (!r || !st->ops || !st->ops->record || !r->forced || !r->forced_n || !r->forced_cap)
        return cxc_fail(5, "bad argument", why, whycap);
    rc = st->ops->record(r->forced, r->forced_n, r->forced_cap, arg, why, whycap);
    if (rc) return 7;
    *index = *index + 2;
    return cxc_ok(why, whycap);
}

static int cxc_quote(CxcState *st, char **argv, int argc, int *index, const char *a,
                     char *why, long whycap) {
    CxcResources *r;
    char *arg;
    int rc;
    rc = cxc_arg(argv, argc, *index, a, 7, &arg, "missing quote include path", why, whycap);
    if (rc) return rc;
    r = st->res;
    if (!r || !st->ops || !st->ops->line || !r->quotedir || !r->quotedir_n || !r->quotedir_cap)
        return cxc_fail(5, "bad argument", why, whycap);
    rc = st->ops->line(r->quotedir, r->quotedir_n, r->quotedir_cap, arg, why, whycap);
    if (rc) return 7;
    return cxc_advance(index, a, 7, why, whycap);
}

static int cxc_incdir(CxcState *st, char **argv, int argc, int *index, const char *a,
                      char *why, long whycap) {
    CxcResources *r;
    char *arg;
    int rc;
    rc = cxc_arg(argv, argc, *index, a, 2, &arg, "missing include path", why, whycap);
    if (rc) return rc;
    r = st->res;
    if (!r || !st->ops || !st->ops->line || !r->incdir || !r->incdir_n || !r->incdir_cap)
        return cxc_fail(5, "bad argument", why, whycap);
    rc = st->ops->line(r->incdir, r->incdir_n, r->incdir_cap, arg, why, whycap);
    if (rc) return 7;
    r->last_include = arg;
    return cxc_advance(index, a, 2, why, whycap);
}

static int cxc_limit(CxcState *st, int *index, const char *a, char *why, long whycap) {
    CxcResources *r;
    int rc;
    r = st->res;
    if (!r || !st->ops || !st->ops->record || !r->errorlimit || !r->error_n || !r->error_cap)
        return cxc_fail(5, "bad argument", why, whycap);
    *r->error_n = 0;
    rc = st->ops->record(r->errorlimit, r->error_n, r->error_cap, a + 14, why, whycap);
    if (rc) return 7;
    *index = *index + 1;
    return cxc_ok(why, whycap);
}

int cxc_default_run(CxcState *st, char **argv, int argc, char *why, long whycap) {
    int i, modeflag;
    if (!st || !argv || argc < 1) return cxc_fail(5, "bad argument", why, whycap);
    modeflag = 0;
    for (i = 1; i < argc; i++) {
        const char *a = argv[i];
        if (!a) return cxc_fail(5, "bad argument", why, whycap);
        if (!strcmp(a, "--")) break;
        if (a[0] != '-') continue;
        if (a[1] == 'o' || a[1] == 'b' || a[1] == 't' || a[1] == 'S' || a[1] == 'c'
            || a[1] == 'E' || a[1] == 'M') modeflag = 1;
        if (cxc_mode_word(a)) modeflag = 1;
        if (cxc_skips(a)) i++;
    }
    if (!modeflag) {
        st->runit = 1;
        st->defrun = 1;
    }
    return cxc_ok(why, whycap);
}

int cxc_step(CxcState *st, char **argv, int argc, int *index, char *why, long whycap) {
    const char *a;
    char *arg;
    int got;
    if (!st || !argv || !index || argc < 1 || *index < 0 || *index >= argc)
        return cxc_fail(5, "bad argument", why, whycap);
    a = argv[*index];
    if (!a) return cxc_fail(5, "bad argument", why, whycap);
    if (!strcmp(a, "-Wall") || !strcmp(a, "-Wextra")) {
        st->warnings = 1;
        *index = *index + 1;
        return cxc_ok(why, whycap);
    }
    if (!strcmp(a, "-Werror")) {
        st->warnings = 1;
        st->werror = 1;
        *index = *index + 1;
        return cxc_ok(why, whycap);
    }
    if (!strcmp(a, "-nostdinc")) {
        st->nostd = 1;
        *index = *index + 1;
        return cxc_ok(why, whycap);
    }
    if (!strcmp(a, "-ftrim-libc") || !strcmp(a, "-libneed")) {
        st->notrim = 0;
        *index = *index + 1;
        return cxc_ok(why, whycap);
    }
    if (!strcmp(a, "-fno-trim-libc")) {
        st->notrim = 1;
        *index = *index + 1;
        return cxc_ok(why, whycap);
    }
    if (!strcmp(a, "-run")) { st->runit = 1; *index = *index + 1; return cxc_ok(why, whycap); }
    if (!strcmp(a, "--force-origin")) { st->force_origin = 1; *index = *index + 1; return cxc_ok(why, whycap); }
    if (!strcmp(a, "--tapebin")) { st->emitbin = 1; *index = *index + 1; return cxc_ok(why, whycap); }
    if (!strcmp(a, "-funit")) { st->funit = 1; *index = *index + 1; return cxc_ok(why, whycap); }
    if (!strcmp(a, "-dump-tokens")) { st->mode = 4; *index = *index + 1; return cxc_ok(why, whycap); }
    if (!strcmp(a, "-E")) { st->mode = 1; *index = *index + 1; return cxc_ok(why, whycap); }
    if (!strcmp(a, "-S") || !strcmp(a, "-c")) {
        st->mode = 2;
        if (a[1] == 'c') st->sawc = 1;
        else st->sawS = 1;
        *index = *index + 1;
        return cxc_ok(why, whycap);
    }
    if (!strcmp(a, "-MP")) { st->depphony = 1; *index = *index + 1; return cxc_ok(why, whycap); }
    if (!strcmp(a, "-MD") || !strcmp(a, "-MMD")) {
        if (!st->deps) st->deps = "";
        *index = *index + 1;
        return cxc_ok(why, whycap);
    }
    if (!strcmp(a, "-M") || !strcmp(a, "-MM")) {
        st->deponly = 1;
        st->mode = 1;
        if (!st->deps) st->deps = "";
        *index = *index + 1;
        return cxc_ok(why, whycap);
    }
    if (!strcmp(a, "-MT") || !strcmp(a, "-MQ")) {
        got = cxc_need(argv, argc, *index, &arg);
        if (got == 0) return cxc_fail(5, "missing dependency target", why, whycap);
        if (got < 0) return cxc_fail(5, "bad argument", why, whycap);
        if (st->ndeptargets < 0 || st->deptarget_cap < 0 || st->ndeptargets >= st->deptarget_cap
            || !st->deptargets || !st->depquoted)
            return cxc_fail(5, "dependency target capacity", why, whycap);
        st->deptargets[st->ndeptargets] = arg;
        st->depquoted[st->ndeptargets] = a[2] == 'Q';
        st->ndeptargets = st->ndeptargets + 1;
        *index = *index + 2;
        return cxc_ok(why, whycap);
    }
    if (!strcmp(a, "--emit-host-symbols") || !strcmp(a, "--host-provider")) {
        const char *phrase = a[2] == 'e' ? "invalid --emit-host-symbols argument"
                                         : "invalid --host-provider argument";
        if ((a[2] == 'e' && st->host_symbols_path) || (a[2] != 'e' && st->host_provider_path))
            return cxc_fail(5, phrase, why, whycap);
        got = cxc_need(argv, argc, *index, &arg);
        if (got == 0) return cxc_fail(5, phrase, why, whycap);
        if (got < 0) return cxc_fail(5, "bad argument", why, whycap);
        if (a[2] == 'e') st->host_symbols_path = arg;
        else st->host_provider_path = arg;
        *index = *index + 2;
        return cxc_ok(why, whycap);
    }
    if (!strcmp(a, "-MF")) {
        got = cxc_need(argv, argc, *index, &arg);
        if (got == 0) return cxc_fail(5, "missing dependency output", why, whycap);
        if (got < 0) return cxc_fail(5, "bad argument", why, whycap);
        st->deps = arg;
        *index = *index + 2;
        return cxc_ok(why, whycap);
    }
    if (!strcmp(a, "--models")) {
        got = cxc_need(argv, argc, *index, &arg);
        if (got == 0) return cxc_fail(5, "missing package", why, whycap);
        if (got < 0) return cxc_fail(5, "bad argument", why, whycap);
        st->pkg = arg;
        *index = *index + 2;
        return cxc_ok(why, whycap);
    }
    if (!strcmp(a, "-b") || !strcmp(a, "-t")) {
        int mode, image;
        got = cxc_need(argv, argc, *index, &arg);
        if (got == 0) return cxc_fail(5, "missing target", why, whycap);
        if (got < 0) return cxc_fail(5, "bad argument", why, whycap);
        mode = a[1] == 'b' ? 0 : 2;
        image = mode == 0;
        st->mode = mode;
        st->explicit_image = image;
        st->target = arg;
        *index = *index + 2;
        return cxc_ok(why, whycap);
    }
    if (!strcmp(a, "-o")) {
        got = cxc_need(argv, argc, *index, &arg);
        if (got == 0) return cxc_fail(5, "missing output path", why, whycap);
        if (got < 0) return cxc_fail(5, "bad argument", why, whycap);
        st->out = arg;
        *index = *index + 2;
        return cxc_ok(why, whycap);
    }
    if (a[0] == '-' && a[1] == 'o' && a[2]) {
        st->out = a + 2;
        *index = *index + 1;
        return cxc_ok(why, whycap);
    }
    if (!strcmp(a, "-g") || !strncmp(a, "-std=", 5)) {
        *index = *index + 1;
        return cxc_ok(why, whycap);
    }
    if (!strcmp(a, "-O")) { st->level = 1; *index = *index + 1; return cxc_ok(why, whycap); }
    if (!strcmp(a, "-O0")) { st->level = 0; *index = *index + 1; return cxc_ok(why, whycap); }
    if (!strcmp(a, "-O1")) { st->level = 1; *index = *index + 1; return cxc_ok(why, whycap); }
    if (!strcmp(a, "-O2") || !strcmp(a, "-O3")) { st->level = 2; *index = *index + 1; return cxc_ok(why, whycap); }
    if (!strcmp(a, "-Os")) { st->level = 1; *index = *index + 1; return cxc_ok(why, whycap); }
    if (!strncmp(a, "-ferror-limit=", 14)) return cxc_limit(st, index, a, why, whycap);
    if (!strcmp(a, "-include")) return cxc_include(st, argv, argc, index, why, whycap);
    if (!strncmp(a, "-iquote", 7)) return cxc_quote(st, argv, argc, index, a, why, whycap);
    if (!strcmp(a, "-I") || (a[0] == '-' && a[1] == 'I' && a[2]))
        return cxc_incdir(st, argv, argc, index, a, why, whycap);
    if (a[0] == '-' && (a[1] == 'D' || a[1] == 'U'))
        return cxc_macro(st, argv, argc, index, a, why, whycap);
    return 1;
}
