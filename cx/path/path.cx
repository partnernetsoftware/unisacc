#pragma unisa module path
#pragma unisa dock
/* cx.path: pure path-text functions (no file access, no allocation, no libc).
   A path is a byte span (p, n) or a z-string. Style 0 = posix (only '/'), 1 = win ('/' and '\'
   both separate; output uses '\'), 2 = host (the style of the target). Every *_as function gives
   the same answer on every host. Results are lengths (>= 0) or -errno:
   -22 bad argument, -34 destination too small (cap counts the NUL), -36 path too long (relative
   and has_prefix normalize into 1024-byte scratch). */

static int pt_host_os(void) {
#ifdef _WIN32
    return 1;
#else
    return 0;
#endif
}

static int pt_st(int style) {
    if (style == 2) return pt_host_os();
    if (style == 0 || style == 1) return style;
    return -1;
}

static int pt_sep_of(int st, int c) { return c == '/' || (st == 1 && c == '\\'); }

int pt_is_sep(int c) { return pt_sep_of(pt_host_os(), c); }
int pt_sep(void) { return pt_host_os() ? '\\' : '/'; }

static int pt_alpha(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }

/* Root kind: 0 none, 1 absolute, 2 rooted but not absolute (win "\x"), 3 drive-relative (win "C:x"). */
static long pt_root(int st, const char *p, long n, int *kind) {
    long i;
    *kind = 0;
    if (n <= 0) return 0;
    if (st == 0) {
        if (p[0] == '/') { *kind = 1; return 1; }
        return 0;
    }
    if (n >= 2 && pt_alpha(p[0]) && p[1] == ':') {
        if (n >= 3 && pt_sep_of(1, p[2])) { *kind = 1; return 3; }
        *kind = 3;
        return 2;
    }
    if (n >= 2 && pt_sep_of(1, p[0]) && pt_sep_of(1, p[1])) {
        if (n >= 4 && p[2] == '?' && pt_sep_of(1, p[3])) {
            *kind = 1;
            if (n >= 7 && pt_alpha(p[4]) && p[5] == ':' && pt_sep_of(1, p[6])) return 7;
            return 4;
        }
        i = 2;
        while (i < n && !pt_sep_of(1, p[i])) i++;
        if (i < n) i++;
        while (i < n && !pt_sep_of(1, p[i])) i++;
        if (i < n) i++;
        *kind = 1;
        return i;
    }
    if (pt_sep_of(1, p[0])) { *kind = 2; return 1; }
    return 0;
}

int pt_is_abs_as(int style, const char *p, long n) {
    int st = pt_st(style), k;
    if (st < 0 || (!p && n != 0) || n < 0) return -22;
    pt_root(st, p, n, &k);
    return k == 1;
}
int pt_is_abs(const char *p, long n) { return pt_is_abs_as(2, p, n); }

long pt_root_len(int style, const char *p, long n) {
    int st = pt_st(style), k;
    if (st < 0 || (!p && n != 0) || n < 0) return -22;
    return pt_root(st, p, n, &k);
}

static long pt_zlen(const char *s) {
    long i = 0;
    while (s[i]) i++;
    return i;
}

/* Write one byte at dst[*o]; the final NUL needs one more byte. */
static int pt_put(char *dst, long cap, long *o, int c) {
    if (*o + 1 >= cap) return -34;
    dst[*o] = (char)c;
    *o = *o + 1;
    return 0;
}

/* ---- join ---- */
long pt_join_as(int style, char *dst, long cap, const char *a, const char *b) {
    int st = pt_st(style), ka, kb;
    long an, bn, o = 0, i, ra, rb;
    int out;
    if (st < 0 || !dst || cap <= 0 || !a || !b) return -22;
    an = pt_zlen(a);
    bn = pt_zlen(b);
    out = st ? '\\' : '/';
    rb = pt_root(st, b, bn, &kb);
    ra = pt_root(st, a, an, &ka);
    {
        const char *pa = a;
        long la = an;
        const char *pb = b;
        long lb = bn;
        int add = 0;
        if (kb == 1 || an == 0) { pa = 0; la = 0; }
        else if (kb == 2 && ka != 0 && ka != 2) { la = ra; pb = b + 1; lb = bn - 1; }
        else if (bn == 0) { pb = 0; lb = 0; }
        else if (kb == 3 && ka == 1 && ra >= 2 && lb >= 2 && (pb[0] | 32) == (pa[0] | 32)) { pb = b + 2; lb = bn - 2; la = an; add = 1; }
        else if (kb == 3) { pa = 0; la = 0; }
        else add = 1;
        (void)rb;
        for (i = 0; i < la; i++) {
            int c = (unsigned char)pa[i];
            if (st && c == '/') c = '\\';
            if (pt_put(dst, cap, &o, c) < 0) return -34;
        }
        if (la > 0 && lb > 0 && add) {
            int last = (unsigned char)dst[o - 1];
            int drive_only = (la == 2 && st && pt_alpha(pa[0]) && pa[1] == ':');
            if (!pt_sep_of(st, last) && !drive_only)
                if (pt_put(dst, cap, &o, out) < 0) return -34;
        }
        for (i = 0; i < lb; i++) {
            int c = (unsigned char)pb[i];
            if (st && c == '/') c = '\\';
            if (pt_put(dst, cap, &o, c) < 0) return -34;
        }
    }
    dst[o] = 0;
    return o;
}
long pt_join(char *dst, long cap, const char *a, const char *b) { return pt_join_as(2, dst, cap, a, b); }

long pt_join_n(char *dst, long cap, const char *const *parts, int n) {
    int i;
    long r;
    if (!dst || cap <= 0 || n < 0 || (n > 0 && !parts)) return -22;
    dst[0] = 0;
    if (n == 0) return 0;
    r = pt_join(dst, cap, "", parts[0]);
    if (r < 0) return r;
    for (i = 1; i < n; i++) {
        char tmp[1024];
        long m = pt_zlen(dst);
        long k;
        if (m + 1 > (long)sizeof tmp) return -36;
        for (k = 0; k <= m; k++) tmp[k] = dst[k];
        r = pt_join(dst, cap, tmp, parts[i]);
        if (r < 0) return r;
    }
    return r;
}

/* ---- dirname / basename / ext / stem ---- */
/* Last component of p[0..n) after the root: [*cs, *ce), and the end of the stuff before it in *pe
   (separators before the component removed but never into the root). */
static void pt_split(int st, const char *p, long n, long *pe, long *cs, long *ce) {
    int k;
    long root = pt_root(st, p, n, &k), e = n, s;
    while (e > root && pt_sep_of(st, p[e - 1])) e--;
    s = e;
    while (s > root && !pt_sep_of(st, p[s - 1])) s--;
    *cs = s;
    *ce = e;
    while (s > root && pt_sep_of(st, p[s - 1])) s--;
    *pe = s;
}

int pt_dirname_as(int style, const char *p, long n, long *off, long *len) {
    int st = pt_st(style), k;
    long pe, cs, ce, root;
    if (st < 0 || !off || !len || (!p && n != 0) || n < 0) return -22;
    root = pt_root(st, p, n, &k);
    pt_split(st, p, n, &pe, &cs, &ce);
    *off = 0;
    *len = cs <= root ? root : pe;
    return 0;
}
int pt_dirname(const char *p, long n, long *off, long *len) { return pt_dirname_as(2, p, n, off, len); }

int pt_basename_as(int style, const char *p, long n, long *off, long *len) {
    int st = pt_st(style);
    long pe, cs, ce;
    if (st < 0 || !off || !len || (!p && n != 0) || n < 0) return -22;
    pt_split(st, p, n, &pe, &cs, &ce);
    *off = cs;
    *len = ce - cs;
    return 0;
}
int pt_basename(const char *p, long n, long *off, long *len) { return pt_basename_as(2, p, n, off, len); }

/* Extension start inside the name [s, e): index of the last '.', or e when none. */
static long pt_dot(const char *p, long s, long e) {
    long i;
    if (e - s == 1 && p[s] == '.') return e;
    if (e - s == 2 && p[s] == '.' && p[s + 1] == '.') return e;
    for (i = e - 1; i > s; i--) if (p[i] == '.') return i;
    return e;
}

int pt_ext_as(int style, const char *p, long n, long *off, long *len) {
    int st = pt_st(style);
    long pe, cs, ce, d;
    if (st < 0 || !off || !len || (!p && n != 0) || n < 0) return -22;
    pt_split(st, p, n, &pe, &cs, &ce);
    d = pt_dot(p, cs, ce);
    *off = d;
    *len = ce - d;
    return 0;
}
int pt_ext(const char *p, long n, long *off, long *len) { return pt_ext_as(2, p, n, off, len); }

int pt_stem_as(int style, const char *p, long n, long *off, long *len) {
    int st = pt_st(style);
    long pe, cs, ce, d;
    if (st < 0 || !off || !len || (!p && n != 0) || n < 0) return -22;
    pt_split(st, p, n, &pe, &cs, &ce);
    d = pt_dot(p, cs, ce);
    *off = cs;
    *len = d - cs;
    return 0;
}
int pt_stem(const char *p, long n, long *off, long *len) { return pt_stem_as(2, p, n, off, len); }

/* ---- iteration ---- */
int pt_next_as(int style, const char *p, long n, long *pos, long *off, long *len) {
    int st = pt_st(style), k;
    long i, root;
    if (st < 0 || !pos || !off || !len || (!p && n != 0) || n < 0 || *pos < 0 || *pos > n) return -22;
    i = *pos;
    if (i == 0) {
        root = pt_root(st, p, n, &k);
        if (root > 0) { *off = 0; *len = root; *pos = root; return 1; }
    }
    while (i < n && pt_sep_of(st, p[i])) i++;
    if (i >= n) { *pos = n; return 0; }
    *off = i;
    while (i < n && !pt_sep_of(st, p[i])) i++;
    *len = i - *off;
    *pos = i;
    return 1;
}
int pt_next(const char *p, long n, long *pos, long *off, long *len) { return pt_next_as(2, p, n, pos, off, len); }

/* ---- normalize ---- */
long pt_normalize_as(int style, char *dst, long cap, const char *p, long n) {
    int st = pt_st(style), k, out, c;
    long o = 0, i, root, base, cs, ce;
    int rooted;
    if (st < 0 || !dst || cap <= 0 || (!p && n != 0) || n < 0) return -22;
    out = st ? '\\' : '/';
    root = pt_root(st, p, n, &k);
    for (i = 0; i < root; i++) {
        c = (unsigned char)p[i];
        if (st && c == '/') c = '\\';
        if (st == 0 && i > 0) break;
        if (pt_put(dst, cap, &o, c) < 0) return -34;
    }
    if (k == 1 && st == 1 && o > 0 && !pt_sep_of(1, dst[o - 1]) && root > 3)
        if (pt_put(dst, cap, &o, out) < 0) return -34;
    rooted = (k == 1 || k == 2);
    base = o;
    i = root;
    while (i < n) {
        while (i < n && pt_sep_of(st, p[i])) i++;
        if (i >= n) break;
        cs = i;
        while (i < n && !pt_sep_of(st, p[i])) i++;
        ce = i;
        if (ce - cs == 1 && p[cs] == '.') continue;
        if (ce - cs == 2 && p[cs] == '.' && p[cs + 1] == '.') {
            long j = o;
            if (j > base) {
                long e = j;
                while (e > base && dst[e - 1] != out) e--;
                if (!(j - e == 2 && dst[e] == '.' && dst[e + 1] == '.')) {
                    o = e > base ? e - 1 : base;
                    continue;
                }
            } else if (rooted) continue;
        }
        if (o > 0 && !pt_sep_of(st, dst[o - 1]) && !(o == base && k == 3)) {
            if (pt_put(dst, cap, &o, out) < 0) return -34;
        }
        {
            long m;
            for (m = cs; m < ce; m++)
                if (pt_put(dst, cap, &o, (unsigned char)p[m]) < 0) return -34;
        }
    }
    if (o == 0) {
        if (pt_put(dst, cap, &o, '.') < 0) return -34;
    }
    dst[o] = 0;
    return o;
}
long pt_normalize(char *dst, long cap, const char *p, long n) { return pt_normalize_as(2, dst, cap, p, n); }

/* ---- relative / has_prefix ---- */
enum { PT_SCR = 1024 };

static int pt_lc(int st, int c) { return st && c >= 'A' && c <= 'Z' ? c + 32 : c; }

static int pt_eqn(int st, const char *a, const char *b, long n) {
    long i;
    for (i = 0; i < n; i++) if (pt_lc(st, (unsigned char)a[i]) != pt_lc(st, (unsigned char)b[i])) return 0;
    return 1;
}

/* Normalize both into scratch; roots: *same = 1 when equal. Component areas start at *ra / *rb. */
static long pt_pair(int st, const char *a, const char *b, char *na, long *nal, char *nb, long *nbl,
                    long *ra, long *rb, int *same) {
    long r;
    int ka, kb;
    r = pt_normalize_as(st, na, PT_SCR, a, pt_zlen(a));
    if (r == -34) return -36;
    if (r < 0) return r;
    *nal = r;
    r = pt_normalize_as(st, nb, PT_SCR, b, pt_zlen(b));
    if (r == -34) return -36;
    if (r < 0) return r;
    *nbl = r;
    *ra = pt_root(st, na, *nal, &ka);
    *rb = pt_root(st, nb, *nbl, &kb);
    if ((ka == 1) != (kb == 1)) return -22;
    *same = *ra == *rb && pt_eqn(st, na, nb, *ra);
    if (*nal == 1 && na[0] == '.') *ra = *nal = 0;
    if (*nbl == 1 && nb[0] == '.') *rb = *nbl = 0;
    return 0;
}

/* Next component of s[*i..n): start and end, 0 at the end. */
static int pt_comp(int st, const char *s, long n, long *i, long *cs, long *ce) {
    while (*i < n && pt_sep_of(st, s[*i])) (*i)++;
    if (*i >= n) return 0;
    *cs = *i;
    while (*i < n && !pt_sep_of(st, s[*i])) (*i)++;
    *ce = *i;
    return 1;
}

long pt_relative_as(int style, char *dst, long cap, const char *from, const char *to) {
    int st = pt_st(style), same, out, ga, gb;
    char na[PT_SCR], nb[PT_SCR];
    long nal, nbl, ra, rb, ia, ib, as, ae, bs, be, o = 0, r;
    if (st < 0 || !dst || cap <= 0 || !from || !to) return -22;
    out = st ? '\\' : '/';
    r = pt_pair(st, from, to, na, &nal, nb, &nbl, &ra, &rb, &same);
    if (r < 0) return r;
    if (!same) {
        if (ra > 0 && rb > 0) return pt_normalize_as(st, dst, cap, to, pt_zlen(to));
        if (ra != rb) return -22;
    }
    ia = ra;
    ib = rb;
    for (;;) {
        long sa = ia, sb = ib;
        ga = pt_comp(st, na, nal, &ia, &as, &ae);
        gb = pt_comp(st, nb, nbl, &ib, &bs, &be);
        if (ga && gb && ae - as == be - bs && pt_eqn(st, na + as, nb + bs, ae - as)) continue;
        ia = sa;
        ib = sb;
        break;
    }
    while (pt_comp(st, na, nal, &ia, &as, &ae)) {
        if (ae - as == 2 && na[as] == '.' && na[as + 1] == '.') return -22;
        if (o > 0 && pt_put(dst, cap, &o, out) < 0) return -34;
        if (pt_put(dst, cap, &o, '.') < 0 || pt_put(dst, cap, &o, '.') < 0) return -34;
    }
    while (pt_comp(st, nb, nbl, &ib, &bs, &be)) {
        long m;
        if (o > 0 && pt_put(dst, cap, &o, out) < 0) return -34;
        for (m = bs; m < be; m++) if (pt_put(dst, cap, &o, (unsigned char)nb[m]) < 0) return -34;
    }
    if (o == 0 && pt_put(dst, cap, &o, '.') < 0) return -34;
    dst[o] = 0;
    return o;
}
long pt_relative(char *dst, long cap, const char *from, const char *to) { return pt_relative_as(2, dst, cap, from, to); }

int pt_has_prefix_as(int style, const char *p, long n, const char *dir, long dn) {
    int st = pt_st(style), same;
    char na[PT_SCR], nb[PT_SCR], pz[PT_SCR], dz[PT_SCR];
    long nal, nbl, ra, rb, ia, ib, as, ae, bs, be, i, r;
    if (st < 0 || (!p && n != 0) || (!dir && dn != 0) || n < 0 || dn < 0) return -22;
    if (n >= PT_SCR || dn >= PT_SCR) return -36;
    for (i = 0; i < n; i++) pz[i] = p[i];
    pz[n] = 0;
    for (i = 0; i < dn; i++) dz[i] = dir[i];
    dz[dn] = 0;
    r = pt_pair(st, pz, dz, na, &nal, nb, &nbl, &ra, &rb, &same);
    if (r < 0) return r == -22 ? 0 : r;
    if (!same) return 0;
    ia = ra;
    ib = rb;
    while (pt_comp(st, nb, nbl, &ib, &bs, &be)) {
        if (!pt_comp(st, na, nal, &ia, &as, &ae)) return 0;
        if (ae - as != be - bs || !pt_eqn(st, na + as, nb + bs, ae - as)) return 0;
    }
    return 1;
}
int pt_has_prefix(const char *p, long n, const char *dir, long dn) { return pt_has_prefix_as(2, p, n, dir, dn); }

/* ---- separator conversion ---- */
static long pt_conv(int from_c, int to_c, char *dst, long cap, const char *p, long n) {
    long i;
    if (!dst || cap <= 0 || (!p && n != 0) || n < 0) return -22;
    if (n + 1 > cap) return -34;
    for (i = 0; i < n; i++) dst[i] = (char)(p[i] == from_c ? to_c : p[i]);
    dst[n] = 0;
    return n;
}
long pt_to_slash(char *dst, long cap, const char *p, long n) {
    return pt_conv(pt_host_os() ? '\\' : -1, '/', dst, cap, p, n);
}
long pt_to_native(char *dst, long cap, const char *p, long n) {
    return pt_conv(pt_host_os() ? '/' : -1, '\\', dst, cap, p, n);
}
