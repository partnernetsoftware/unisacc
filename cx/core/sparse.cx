#pragma unisa module sparse
#pragma unisa use mem.heap
/* Caller owns all three arrays; an occupied slot remains occupied when its
 * value is zero, and capacity is checked before even an overwrite.  The
 * calloc/free come from mem.heap (mm_zalloc/mm_free) so this core module
 * keeps no bare libc call. */
typedef struct {int64_t *keys,*values;unsigned char *used;size_t cap,n;} CxSparse;
static void fail(const char *s){{extern void core_host_panic(const char *);core_host_panic(s);}abort();}
static size_t slot(const CxSparse *m,int64_t k){uint64_t h=(uint64_t)k*0x9E3779B97F4A7C15ull;return (size_t)(h>>20)&(m->cap-1);}
int64_t core_memory_get(const CxSparse *m,int64_t k){
 if(!m->cap)return 0;size_t s=slot(m,k);while(m->used[s]){if(m->keys[s]==k)return m->values[s];s=(s+1)&(m->cap-1);}return 0;
}
void core_memory_set(CxSparse *m,int64_t k,int64_t v){
 if((m->n+1)*2>m->cap){
  size_t oc=m->cap;int64_t *ok=m->keys,*ov=m->values;unsigned char *ou=m->used;
  if(oc>0x0fffffffffffffffull)fail("memory capacity overflow");m->cap=oc?oc*2:1<<16;
  m->keys=mm_zalloc((long)(m->cap*sizeof(int64_t)));m->values=mm_zalloc((long)(m->cap*sizeof(int64_t)));m->used=mm_zalloc((long)m->cap);m->n=0;
  if(!m->keys||!m->values||!m->used)fail("out of memory");
  for(size_t j=0;j<oc;j++)if(ou[j])core_memory_set(m,ok[j],ov[j]);
  mm_free(ok);mm_free(ov);mm_free(ou);
 }
 size_t s=slot(m,k);while(m->used[s]&&m->keys[s]!=k)s=(s+1)&(m->cap-1);
 if(!m->used[s]){m->used[s]=1;m->keys[s]=k;m->n++;}m->values[s]=v;
}
