#pragma unisa module bytes
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
/* Caller owns the tables and their copies. Resource fetch returns absent=0,
 * borrowed=1 or owned=2; owned fetched bytes are released after copying.
 * Heap and byte moves go through mem.heap and mem.bytes. */
typedef struct {unsigned char *b;int n;} CxBlob;
typedef struct {CxBlob *entries;int n,cap;} CxBlobs;
typedef struct {unsigned char *b;int n;int64_t v;} CxInternEntry;
typedef struct {CxInternEntry *entries;size_t cap,n;} CxIntern;
typedef struct {unsigned char *p;int n,id;} CxResourceEntry;
typedef struct {CxResourceEntry *entries;int n;} CxResources;
static void fail(const char *s){{extern void core_host_panic(const char *);core_host_panic(s);}abort();}
static void *grow(void *p,size_t n){void *q=mm_grow(p,(long)(n?n:1));if(!q)fail("out of memory");return q;}
int core_blob_add(CxBlobs *t,const unsigned char *b,int n){
 if(t->n>=t->cap){if(t->cap>INT32_MAX/2)fail("blob capacity overflow");t->cap=t->cap?t->cap*2:64;t->entries=grow(t->entries,sizeof(CxBlob)*(size_t)t->cap);}
 t->entries[t->n].b=grow(0,(size_t)n+1);if(n&&mm_copy(t->entries[t->n].b,(long)n+1,b,(long)n))fail("out of memory");t->entries[t->n].n=n;return t->n++;
}
static uint64_t hbytes(const unsigned char *b,int n){uint64_t h=1469598103934665603ull;for(int j=0;j<n;j++)h=(h^b[j])*1099511628211ull;return h;}
int64_t core_string_intern(CxIntern *t,const unsigned char *b,int n){
 if((t->n+1)*2>t->cap){
  size_t oc=t->cap;CxInternEntry *o=t->entries;if(oc>0x0555555555555555ull)fail("intern capacity overflow");
  t->cap=oc?oc*2:1024;t->entries=mm_zalloc((long)(t->cap*sizeof(CxInternEntry)));if(!t->entries)fail("out of memory");
  for(size_t j=0;j<oc;j++)if(o[j].b){size_t k=hbytes(o[j].b,o[j].n)&(t->cap-1);while(t->entries[k].b)k=(k+1)&(t->cap-1);t->entries[k]=o[j];}mm_free(o);
 }
 size_t k=hbytes(b,n)&(t->cap-1);while(t->entries[k].b){if(t->entries[k].n==n&&mm_same(t->entries[k].b,b,(long)n))return t->entries[k].v;k=(k+1)&(t->cap-1);}
 t->entries[k].b=grow(0,(size_t)n+1);if(mm_copy(t->entries[k].b,(long)n+1,b,(long)n))fail("out of memory");t->entries[k].n=n;t->entries[k].v=(int64_t)++t->n;return t->entries[k].v;
}
int core_resource_find(CxResources *t,CxBlobs *bs,const unsigned char *p,int n){
 for(int j=0;j<t->n;j++)if(t->entries[j].n==n&&mm_same(t->entries[j].p,p,(long)n))return t->entries[j].id;
 if(t->n==INT32_MAX)fail("resource cache capacity overflow");unsigned char *b=0;int len=0,id=0;
 int owned;{extern int core_host_fetch(const unsigned char *,int,unsigned char **,int *);owned=core_host_fetch(p,n,&b,&len);}
 if(owned)id=core_blob_add(bs,b,len);if(owned==2)mm_free(b);
 t->entries=grow(t->entries,sizeof(CxResourceEntry)*((size_t)t->n+1));t->entries[t->n].p=grow(0,(size_t)n+1);
 if(mm_copy(t->entries[t->n].p,(long)n+1,p,(long)n))fail("out of memory");t->entries[t->n].n=n;t->entries[t->n].id=id;t->n++;return id;
}
