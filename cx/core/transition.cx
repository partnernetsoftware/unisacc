#pragma unisa module transition
/* Immutable decoded-model view. The caller owns all arrays and validates
 * state and direct-table indices before invoking the transition. */
typedef struct {
    int ns,nq,nrg,start,isnet;
    char **str; int *strl;
    int *qoff,*qlen; int64_t *qa;
    int *mode,*count,**keys,**next,**seq;
    int *lo,*hi,*base_next,*base_seq;
    int *ret_seq; unsigned char **ret_ok;
} CxTransitionModel;
const char *core_transition(const CxTransitionModel *m,int q,int key,int *nx,int *sq) {
    *nx=-1;*sq=0;
    if(m->ret_ok&&m->ret_ok[q]&&key>=0&&key<m->ns&&m->ret_ok[q][key]){
        *nx=key;*sq=m->ret_seq[q];return 0;
    }
    if(m->isnet){
        if(key<m->lo[q]||key>m->hi[q])return "observation outside network domain";
        int64_t n=m->base_next[q],s=m->base_seq[q];
        const int *k=m->keys[q];int cut=0,end=m->count[q];
        while(cut<end){int mid=(cut+end)>>1;if(key>=k[mid])cut=mid+1;else end=mid;}
        for(int j=0;j<cut;j++){n+=(int64_t)m->next[q][j];s+=(int64_t)m->seq[q][j];}
        if(n< -1||n>=m->ns||s<0||s>=m->nq)return "invalid network output";
        *nx=(int)n;*sq=(int)s;
    }else if(m->mode[q]==1){
        for(int j=0;j<m->count[q];j++)if(m->keys[q][j]==key){*nx=m->next[q][j];*sq=m->seq[q][j];break;}
    }else{*nx=m->next[q][key];*sq=m->seq[q][key];}
    return 0;
}
/* Standalone consumers use the same execution-core implementation. */
const char *cxtn_transition(const CxTransitionModel *m,int q,int key,int *nx,int *sq) {
    return core_transition(m,q,key,nx,sq);
}

/* core_run step decisions. The caller still allocates, calls the transition
 * and runs actions. A null pointer returns 4 and writes nothing. */
int core_run_budget(long long steps, long long maxsteps, long long *next, const char **why) {
    if (!next || !why) return 4;
    if (steps >= maxsteps) { *why = "timeout"; return 3; }
    *next = steps + 1;
    return 0;
}
int core_run_key(int mode, int stack_n, int stack_top, long long i, long long end, int byte, long long r) {
    if (mode == 1) return stack_n ? stack_top : -1;
    if (mode == 0) return i < end ? byte : 256;
    return (r >= 0 && r <= 256) ? (int)r : 256;
}
int core_run_stop(const char *reason, int nx, const char **out) {
    if (!out) return 4;
    if (reason) { *out = reason; return 2; }
    if (nx < 0) { *out = "no transition"; return 2; }
    return 0;
}
int core_run_take(int status) { return status ? 0 : 1; }
