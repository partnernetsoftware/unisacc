#pragma unisa module stack
/* Storage belongs to the caller; frames borrow input and attribute spans. */
typedef struct { const unsigned char *b; const int64_t *at; int64_t i,end; } CxCoreFrame;
typedef struct { CxCoreFrame *entries; int n,cap; } CxCoreFrames;
typedef struct { int *entries; int n,cap; } CxCoreStack;
static void fail(const char *s){{extern void core_host_panic(const char *);core_host_panic(s);}abort();}
static void *grow(void *p,size_t n){p=realloc(p,n?n:1);if(!p)fail("out of memory");return p;}
void core_stack_push(CxCoreStack *s,int value){
 if(s->n>=s->cap){if(s->cap>INT32_MAX/2)fail("stack capacity overflow");s->cap=s->cap?s->cap*2:1024;s->entries=grow(s->entries,sizeof(int)*(size_t)s->cap);}
 s->entries[s->n++]=value;
}
void core_stack_pop(CxCoreStack *s){if(!s->n)fail("pop of an empty stack");s->n--;}
void core_frame_push(CxCoreFrames *s,const CxCoreFrame *value){
 if(s->n>=s->cap){if(s->cap>INT32_MAX/2)fail("frame capacity overflow");s->cap=s->cap?s->cap*2:16;s->entries=grow(s->entries,sizeof(CxCoreFrame)*(size_t)s->cap);}
 s->entries[s->n++]=*value;
}
void core_frame_pop(CxCoreFrames *s){if(s->n>1)s->n--;}
