#pragma unisa module output
#pragma unisa use mem.heap
/* Buffer storage belongs to the caller; the host supplies panic behavior.
 * grow goes through mem.heap so this module keeps no bare realloc. */
typedef struct { unsigned char *b; int64_t *at; int n,cap; } CxCoreBuffer;
static void fail(const char *s){{extern void core_host_panic(const char *);core_host_panic(s);}abort();}
static void *grow(void *p,size_t n){void *q=mm_grow(p,(long)(n?n:1));if(!q)fail("out of memory");return q;}
void core_buffer_put(CxCoreBuffer *o,int c,int64_t at){
 if(o->n>=o->cap){if(o->cap>INT32_MAX/2)fail("buffer capacity overflow");o->cap=o->cap?o->cap*2:256;o->b=grow(o->b,(size_t)o->cap);o->at=grow(o->at,sizeof(int64_t)*(size_t)o->cap);}
 o->b[o->n]=(unsigned char)c;o->at[o->n]=at;o->n++;
}
int core_decimal(char *s,int64_t v){
 char t[20];int n=0,k=0;uint64_t u=(uint64_t)v;if(v<0){s[k++]='-';u=0-u;}
 do{t[n++]=(char)('0'+u%10);u/=10;}while(u);while(n)s[k++]=t[--n];return k;
}
int core_field_fill(CxCoreBuffer *o,int64_t at,int64_t width,int64_t value){
 char t[32];int n=core_decimal(t,value);if(n>width)return 1;
 if(at<0||at>o->n||width>o->n-at)fail("fill past the reservation");
 for(int64_t j=0;j<width;j++)o->b[at+j]=j<width-n?' ':(unsigned char)t[j-(width-n)];return 0;
}
