#pragma unisa module alu
/* Stateless arithmetic for network actions. The host panic callback is used
 * only for an invalid opcode, as in the execution core. */
static int32_t word32(int64_t v){return (int32_t)(uint32_t)(uint64_t)v;}
int64_t core_alu32(int op,int64_t a64,int64_t b64){
 int32_t a=word32(a64),b=word32(b64);
 switch(op){
 case 0:return (int32_t)((uint32_t)a+(uint32_t)b);
 case 1:return (int32_t)((uint32_t)a-(uint32_t)b);
 case 2:return (int32_t)((uint32_t)a*(uint32_t)b);
 case 3:if(!b)return 0;if(a==INT32_MIN&&b==-1)return INT32_MIN;return a/b;
 case 4:if(!b)return 0;if(a==INT32_MIN&&b==-1)return 0;return a%b;
 case 5:return a&b;case 6:return a|b;case 7:return a^b;
 case 8:return (int32_t)((uint32_t)a<<(b&31));case 9:return a>>(b&31);
 }
 {extern void core_host_panic(const char *);core_host_panic("bad alu op");}abort();return 0;
}
int64_t core_alu64(int op,int64_t a,int64_t b,int *z){
 uint64_t ua=(uint64_t)a,ub=(uint64_t)b;*z=0;
 switch(op){
 case 0:return (int64_t)(ua+ub);case 1:return (int64_t)(ua-ub);case 2:return (int64_t)(ua*ub);
 case 10:if(!b){*z=1;return 0;}if(a==INT64_MIN&&b==-1)return INT64_MIN;return a/b;
 case 11:if(!b){*z=1;return 0;}if(a==INT64_MIN&&b==-1)return 0;return a%b;
 case 12:if(!b){*z=1;return 0;}return (int64_t)(ua/ub);
 case 13:if(!b){*z=1;return 0;}return (int64_t)(ua%ub);
 case 5:return a&b;case 6:return a|b;case 7:return a^b;case 14:return ~a;
 case 8:return (int64_t)(ua<<(b&63));case 15:return (int64_t)(ua>>(b&63));case 9:return a>>(b&63);
 }
 {extern void core_host_panic(const char *);core_host_panic("bad alu64 op");}abort();return 0;
}
