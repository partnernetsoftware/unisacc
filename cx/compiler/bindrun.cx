#pragma unisa module bindrun
/* Whether runit enters memory_enter. No libc and no include.
   memory_enter stays in exec/c/compiler.c. Any nonzero runit takes
   that call. Zero continues. execrun and forward_exec stay in C and
   are not reached when this returns 0. */
int bx_run_enter(int runit) {
    if (runit) return 0;
    return 1;
}
