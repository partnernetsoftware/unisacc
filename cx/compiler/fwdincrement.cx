#pragma unisa module fwdincrement
/* Forwarding increment. No libc and no include.
   Replay, overflow, a count outside 1..131000, a route that does not fit,
   or a merge that is not ok: return 0 (full replay). Replay and overflow
   return before the injected front. Front or range failure: return -1.
   Merge ok: return 1. Alloc, release, route execution, and the environment
   bit are injected. */
typedef struct { unsigned char *b; long long *at; int n, cap; } FwiBuf;
typedef struct { const unsigned char *name; int n; const unsigned char *data; int len; } FwiRi;

static int fwi_eq(const unsigned char *a, int n, const char *lit, int ln) {
    int i;
    if (n != ln || !a) return 0;
    for (i = 0; i < n; i++) if (a[i] != (unsigned char)lit[i]) return 0;
    return 1;
}
static int fwi_route(char *route, int cap, const char *target, int level) {
    int i = 0, k, n = 0;
    char rev[16], tmp[16];
    unsigned long long u;
    const char *mid = "/tape/O";
    if (!target) return -1;
    while (target[i]) {
        if (i + 1 >= cap) return -1;
        route[i] = target[i];
        i++;
    }
    for (k = 0; mid[k]; k++) {
        if (i + 1 >= cap) return -1;
        route[i++] = mid[k];
    }
    if (level < 0) {
        if (i + 1 >= cap) return -1;
        route[i++] = '-';
        if (level == -2147483647 - 1) u = 2147483648ULL;
        else u = (unsigned long long)(-(long long)level);
    } else u = (unsigned long long)level;
    if (u == 0) tmp[n++] = '0';
    else {
        int r = 0;
        while (u) { rev[r++] = (char)('0' + (u % 10)); u /= 10; }
        while (r) tmp[n++] = rev[--r];
    }
    for (k = 0; k < n; k++) {
        if (i + 1 >= cap) return -1;
        route[i++] = tmp[k];
    }
    if (i >= cap) return -1;
    route[i] = 0;
    return i;
}
int fwd_incremental(const char *target, int level, const FwiBuf *base, int unit, FwiBuf *merged,
                    FwiRi *ri, int *nri, FwiBuf *attrs, int *attr_unit, int *attr_slot, char *fwd_path,
                    int (*replay)(void), int (*overflowed)(void), int (*count)(void), char *(*text)(void),
                    void *(*alloc)(void *, long long), void (*release)(void *),
                    int (*front)(char *, char *, void *, char *),
                    int (*range)(char *, char *, char *, void *, char *),
                    int (*merge)(const void *, const void *, const void *, int, void *)) {
    static const char dummy[] = "\nint main(void){return 0;}\n";
    static const unsigned char funit_one = 1;
    FwiBuf unit_tape;
    char route[96];
    int fslot = -1, sslot = -1, j, rc, ok, ncopy, i, plen, dlen;
    FwiRi oldf, olds;
    FwiBuf oldattrs;
    int oldunit;
    char *src;
    if (replay() || overflowed()) return 0;
    if (count() <= 0 || count() > 131000) return 0;
    dlen = (int)sizeof dummy - 1;
    unit_tape.b = 0; unit_tape.at = 0; unit_tape.n = 0; unit_tape.cap = 0;
    unit_tape.n = count() + dlen;
    unit_tape.b = alloc(0, (long long)unit_tape.n + 1);
    ncopy = count();
    src = text();
    for (i = 0; i < ncopy; i++) unit_tape.b[i] = (unsigned char)src[i];
    for (i = 0; i < dlen; i++) unit_tape.b[ncopy + i] = (unsigned char)dummy[i];
    unit_tape.b[unit_tape.n] = 0;
    if (fwi_route(route, 96, target, level) < 0) { release(unit_tape.b); return 0; }
    for (j = 0; j < *nri; j++) {
        if (fwi_eq(ri[j].name, ri[j].n, "\0cli/run-forward", 16)) fslot = j;
        if (fwi_eq(ri[j].name, ri[j].n, "\0cli/source", 11)) sslot = j;
    }
    oldf.name = 0; oldf.n = 0; oldf.data = 0; oldf.len = 0;
    olds.name = 0; olds.n = 0; olds.data = 0; olds.len = 0;
    if (fslot >= 0) { oldf = ri[fslot]; ri[fslot].n = 0; }
    if (sslot >= 0) {
        olds = ri[sslot];
        plen = 0; while (fwd_path[plen]) plen++;
        ri[sslot].data = (const unsigned char *)fwd_path;
        ri[sslot].len = plen;
    }
    oldattrs = *attrs; oldunit = *attr_unit;
    attrs->b = 0; attrs->n = 0; attrs->cap = 0; *attr_unit = 0;
    if (*attr_slot >= 0) { ri[*attr_slot].data = 0; ri[*attr_slot].len = 0; }
    rc = front(route, "e1", &unit_tape, fwd_path);
    if (!rc && *nri < 255) {
        ri[*nri].name = (const unsigned char *)"\0cli/funit";
        ri[*nri].n = 10; ri[*nri].data = &funit_one; ri[*nri].len = 1;
        (*nri)++;
        rc = range(route, "e3", "e3", &unit_tape, fwd_path);
        (*nri)--;
    } else rc = 1;
    release(attrs->b); *attrs = oldattrs; *attr_unit = oldunit;
    if (*attr_slot >= 0) { ri[*attr_slot].data = attrs->b; ri[*attr_slot].len = attrs->n; }
    if (fslot >= 0) ri[fslot] = oldf;
    if (sslot >= 0) ri[sslot] = olds;
    if (rc) { release(unit_tape.b); release(unit_tape.at); return -1; }
    ok = merge(base, &unit_tape, &unit_tape, unit, merged);
    release(unit_tape.b); release(unit_tape.at);
    return ok ? 1 : 0;
}
