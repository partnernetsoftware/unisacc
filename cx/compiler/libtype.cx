#pragma unisa module libtype
/* Pure gates from exec/c/librarybindings.h. No libc and no include.
   malloc, snprintf, and the binding table stay in that header.
   A null name returns 4. The old name check returned 0 for a null.
   A missing type returns 4. The old type check returned 0 for a null.
   A negative count returns 4. That 4 was not on the old path.
   Name length 1024 is accepted. Length 1025 is refused.
   Pointer width is the caller's sizeof(void*). */
int lt_name(const char *s) {
    int i, c, a;
    if (!s) return 4;
    if (!s[0]) return 0;
    i = 0;
    while (s[i]) {
        if (i >= 1024) return 0;
        c = s[i] & 255;
        a = 0;
        if (c >= 65 && c <= 90) a = 1;
        if (c >= 97 && c <= 122) a = 1;
        if (c == 95) a = 1;
        if (!a) {
            if (i == 0) return 0;
            if (c < 48 || c > 57) return 0;
        }
        i = i + 1;
    }
    return 1;
}
int lt_type_ok(int present, int kind, int depth, int width, int uns, int result, int ptrwidth) {
    if (!present) return 4;
    if (kind > 6 || uns > 1) return 0;
    if (kind < 0 || uns < 0) return 0;
    if (kind == 0) {
        if (result && depth == 0 && width == 0 && uns == 0) return 1;
        return 0;
    }
    if (kind == 1) {
        if (depth) return 0;
        if (width == 1 || width == 2 || width == 4 || width == 8) return 1;
        return 0;
    }
    if (kind == 2) {
        if (depth > 0 && width == ptrwidth && uns == 0) return 1;
        return 0;
    }
    if (kind == 3) {
        if (depth) return 0;
        if (uns) return 0;
        if (width == 4 || width == 8) return 1;
        return 0;
    }
    if (kind == 4) {
        if (depth > 0 && width == ptrwidth && uns == 0) return 1;
        return 0;
    }
    return 1;
}
int lt_supported(int kind, int result) {
    if (kind == 1) return 1;
    if (kind == 2) return 1;
    if (result && kind == 0) return 1;
    return 0;
}
int lt_count(int n) {
    if (n < 0) return 4;
    if (n >= 4096) return 1;
    return 0;
}
int lt_args(int count, int variadic) {
    if (count < 0) return 4;
    if (variadic < 0) return 4;
    if (count > 1024) return 1;
    if (variadic > 1) return 1;
    return 0;
}
int lt_type_diff(unsigned long long da, unsigned long long db,
                 unsigned long long ka, unsigned long long kb,
                 unsigned long long wa, unsigned long long wb,
                 unsigned long long ua, unsigned long long ub,
                 unsigned long long aa, unsigned long long ab,
                 unsigned long long ta, unsigned long long tb,
                 unsigned long long na, unsigned long long nb,
                 unsigned long long ca, unsigned long long cb,
                 unsigned long long sa, unsigned long long sb) {
    if (da != db) return 1;
    if (ka != kb) return 1;
    if (wa != wb) return 1;
    if (ua != ub) return 1;
    if (aa != ab) return 1;
    if (ta != tb) return 1;
    if (na != nb) return 1;
    if (ca != cb) return 1;
    if (sa != sb) return 1;
    return 0;
}
int lt_wire3_diff(unsigned long long a, unsigned long long b) {
    unsigned long long aa;
    unsigned long long bb;
    aa = a == 3ull;
    bb = b == 3ull;
    if (aa != bb) return 1;
    return 0;
}
int lt_v3_diff(unsigned long long ra, unsigned long long rb,
               unsigned long long fa, unsigned long long fb,
               unsigned long long na, unsigned long long nb,
               unsigned long long la, unsigned long long lb,
               unsigned long long ma, unsigned long long mb,
               unsigned long long oa, unsigned long long ob) {
    if (ra != rb) return 1;
    if (fa != fb) return 1;
    if (na != nb) return 1;
    if (la != lb) return 1;
    if (ma != mb) return 1;
    if (oa != ob) return 1;
    return 0;
}
int lt_member_diff(unsigned long long oa, unsigned long long ob,
                   unsigned long long ba, unsigned long long bb,
                   unsigned long long wa, unsigned long long wb,
                   unsigned long long sa, unsigned long long sb) {
    if (oa != ob) return 1;
    if (ba != bb) return 1;
    if (wa != wb) return 1;
    if (sa != sb) return 1;
    return 0;
}
int lt_member_v3(unsigned long long oa, unsigned long long ob,
                 unsigned long long ka, unsigned long long kb,
                 unsigned long long aa, unsigned long long ab) {
    if (oa != ob) return 1;
    if (ka != kb) return 1;
    if (aa != ab) return 1;
    return 0;
}
int lt_sig_diff(unsigned long long va, unsigned long long vb,
                unsigned long long ma, unsigned long long mb,
                unsigned long long ca, unsigned long long cb,
                unsigned long long sa, unsigned long long sb) {
    if (va != vb) return 1;
    if (ma != mb) return 1;
    if (ca != cb) return 1;
    if (sa != sb) return 1;
    if (sa != ca) return 1;
    if (ca > 1024ull) return 1;
    return 0;
}
int lt_member_n(unsigned long long n, int has) {
    if (has < 0) return 4;
    if (n > 128ull) return 1;
    if (n && !has) return 1;
    return 0;
}
int lt_null_diff(int a, int b) {
    if (a < 0 || b < 0) return 4;
    if (a != b) return 1;
    return 0;
}
int lt_graph_cap(void) {
    return 16384;
}
int lt_graph_room(int kind, int used, int extra) {
    if (kind < 0 || used < 0 || extra < 0) return 4;
    if (kind == 0) {
        if (used > 16384) return 1;
        return 0;
    }
    if (kind == 1) {
        if (used >= 16384) return 1;
        if (extra > 16384 - used) return 1;
        return 0;
    }
    return 4;
}
