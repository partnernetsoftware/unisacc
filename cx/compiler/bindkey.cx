#pragma unisa module bindkey
/* Path-key length gates. No libc and no include.
   realpath, errno, the slash split, and the empty-base refusal stay in
   exec/c/bind.c. parent[] is 4096 bytes. The joined key is "%s/%s":
   snprintf's return is that length without the trailing NUL, and the
   adapter refuses when the return is >= cap. */
int bx_key_len(int n) {
    if (n < 0) return 4;
    if (n == 0 || n >= 4096) return 1;
    return 0;
}
int bx_key_fit(int left_n, int right_n, int cap) {
    if (left_n < 0 || right_n < 0 || cap < 1) return 4;
    if (left_n >= cap || right_n >= cap) return 1;
    if (left_n >= cap - right_n - 1) return 1;
    return 0;
}
