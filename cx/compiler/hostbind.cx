#pragma unisa module hostbind
/* Host symbol-contract framing. No libc and no include.
   File IO, dl addresses, and image writes stay in exec/c/bind.c.
   Error text is the historical "unisacc: bind: ..." string.
   A framing or record failure zeroes the requirements.
   A backend failure zeroes the plan. A filter failure leaves the mask. */
typedef struct { unsigned target, count, indirect, mask; } HbReq;
typedef struct { unsigned target, kind, available; unsigned long long address[4]; } HbProv;
typedef struct { unsigned target, kind, mask; unsigned long long address[4]; } HbPlan;

static int hb_eq(const unsigned char *a, const char *b, int n) {
    int i;
    if (!a) return 0;
    for (i = 0; i < n; i++) if (a[i] != (unsigned char)b[i]) return 0;
    return 1;
}
static int hb_say(char *error, unsigned long long cap, const char *reason) {
    const char *prefix = "unisacc: bind: ";
    unsigned long long i = 0, j = 0;
    if (!error || cap == 0) return 1;
    while (prefix[i] && i + 1 < cap) { error[i] = prefix[i]; i++; }
    while (reason[j] && i + 1 < cap) error[i++] = reason[j++];
    error[i] = 0;
    return 1;
}
static int hb_missing(char *error, unsigned long long cap, unsigned symbol, unsigned slot) {
    char msg[48];
    int n = 0, k;
    const char *head = "missing-provider symbol ";
    const char *mid = " slot ";
    for (k = 0; head[k]; k++) msg[n++] = head[k];
    msg[n++] = (char)('0' + (symbol % 10));
    for (k = 0; mid[k]; k++) msg[n++] = mid[k];
    msg[n++] = (char)('0' + (slot % 10));
    msg[n] = 0;
    return hb_say(error, cap, msg);
}
static void hb_zero_req(HbReq *r) {
    r->target = 0; r->count = 0; r->indirect = 0; r->mask = 0;
}
static void hb_zero_plan(HbPlan *out) {
    int i;
    out->target = 0; out->kind = 0; out->mask = 0;
    for (i = 0; i < 4; i++) out->address[i] = 0;
}
int hb_target_id(const char *target) {
    if (hb_eq((const unsigned char *)target, "lnx/x86_64", 10) && target[10] == 0) return 1;
    if (hb_eq((const unsigned char *)target, "lnx/arm64", 9) && target[9] == 0) return 2;
    if (hb_eq((const unsigned char *)target, "osx/x86_64", 10) && target[10] == 0) return 3;
    if (hb_eq((const unsigned char *)target, "osx/arm64", 9) && target[9] == 0) return 4;
    return 0;
}
int hb_requirements(const unsigned char *b, unsigned long long n, HbReq *r, char *error, unsigned long long cap) {
    int previous = -1;
    unsigned i;
    hb_zero_req(r);
    if (n < 12 || !hb_eq(b, "UNISYM1\n", 8) || b[8] < 1 || b[8] > 4 || b[9] || b[10] > 4 || b[11] > 1
        || n != 12ull + 8ull * (unsigned long long)b[10])
        return hb_say(error, cap, "invalid-contract framing");
    r->target = b[8]; r->count = b[10]; r->indirect = b[11];
    for (i = 0; i < r->count; i++) {
        const unsigned char *p = b + 12 + 8 * i;
        unsigned slot = p[4];
        if (slot > 3 || (int)slot <= previous || p[0] != slot + 1 || p[1] || p[2] || p[3] || p[5] != 1 || p[6] || p[7])
            return hb_say(error, cap, "invalid-contract record");
        previous = (int)slot;
        r->mask |= 1u << slot;
    }
    return 0;
}
int hb_provider_filter(const unsigned char *b, unsigned long long n, unsigned target, unsigned *mask, char *error, unsigned long long cap) {
    if (n != 12 || !hb_eq(b, "UHPROV1\n", 8)) return hb_say(error, cap, "invalid-provider framing");
    if (b[8] != target) return hb_say(error, cap, "provider-target differs");
    if (b[9] & 240) return hb_say(error, cap, "invalid-provider mask");
    if (b[10] || b[11]) return hb_say(error, cap, "provider-reserved bits are nonzero");
    *mask = b[9];
    return 0;
}
int hb_bind(const HbReq *r, const HbProv *p, unsigned filter, HbPlan *out, char *error, unsigned long long cap) {
    unsigned available, slot;
    hb_zero_plan(out);
    if (!r->target || p->target != r->target || p->kind < 1 || p->kind > 2 || (p->available & ~15u) || (filter & ~15u))
        return hb_say(error, cap, "invalid-provider backend");
    available = p->available & filter;
    for (slot = 0; slot < 4; slot++) if (r->mask & (1u << slot)) {
        if (!(available & (1u << slot)) || (p->kind == 2 && !p->address[slot]))
            return hb_missing(error, cap, slot + 1, slot);
    }
    out->target = r->target; out->kind = p->kind; out->mask = r->mask;
    for (slot = 0; slot < 4; slot++) out->address[slot] = p->address[slot];
    return 0;
}
