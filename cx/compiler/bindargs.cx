#pragma unisa module bindargs
/* Whether runit or execrun allocates the runargs vector.
   No libc and no include. xrealloc and the vector fill stay in
   exec/c/compiler.c. linux nonzero stands for the __linux__ build,
   where execrun joins the condition. linux zero ignores execrun. */
int bx_run_args(int runit, int execrun, int linux) {
    if (runit) return 1;
    if (linux && execrun) return 1;
    return 0;
}
