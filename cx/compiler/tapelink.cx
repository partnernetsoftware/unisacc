}
/* ---- archives (R17-3): GNU/BSD `ar` format, written and read in memory ----
   `unisacc ar rcs|t|x LIB.a [members]`.  Member names longer than 15 bytes
   use the BSD `#1/<len>` form, which GNU ar, llvm-ar and ld64 all read.  The
   unisacc linker takes `.a` inputs and pulls in a member only when it
   defines a `.global` name that is still undefined (the classic rule), so a
   library of unit objects links like one made by a system `ar`. */
long tl_ar_dec(char *b, int w, long max) {
    long v; int k; int digit; int d;
    v = 0; k = 0; digit = 0;
    while (k < w && b[k] >= 48 && b[k] <= 57) {
        d = b[k] - 48;
        if (d > max || v > (max - d) / 10) return -1;
        v = v * 10 + d; digit = 1; k = k + 1;
    }
    if (!digit) return -1;
    while (k < w) { if (b[k] != 32) return -1; k = k + 1; }
    return v;
}
/* link-time name sets, for pulling archive members: names defined (.global)
   and names wanted (.extern) by the units taken so far */
static char *tl_npool; static int tl_nend;
static int *tl_def_at; static int *tl_def_len; static int tl_ndef;
static int *tl_ext_at; static int *tl_ext_len; static int tl_next;
static int tl_has_entry;
/* forward marks: `.bss __unisa_fw1_<sig>_<name> 1` says <name> is a host function the
   link may supply a stub for. <sig> holds no underscore, so the name follows the first one. */
static int *tl_fw_at; static int *tl_fw_len; static int tl_nfw;
static int tl_fw_name(int i) {
    int k; k = 12;
    while (k < tl_fw_len[i] && tl_npool[tl_fw_at[i] + k] != 95) k = k + 1;
    return k + 1;
}
int tl_inset(int *at, int *ln, int cnt, char *s, int n) {
    int i; i = 0; while (i < cnt) { if (tl_same(tl_npool + at[i], ln[i], s, n)) return 1; i = i + 1; } return 0;
}
int tl_addname(int *at, int *ln, int *cnt, char *s, int n) {
    int k;
    if (*cnt >= 65536 || tl_nend + n >= 2097152) tl_fail("link: too many names\n");
    if (tl_inset(at, ln, *cnt, s, n)) return 0;
    at[*cnt] = tl_nend; ln[*cnt] = n; k = 0; while (k < n) { tl_npool[tl_nend + k] = s[k]; k = k + 1; }
    tl_nend = tl_nend + n; *cnt = *cnt + 1; return 0;
}
int tl_islink(char *t, long i, long e, char *w) {          /* ".global NAME" / ".extern NAME" */
    int k; k = 0; while (w[k]) { if (i + k >= e || t[i + k] != w[k]) return 0; k = k + 1; } return 1;
}
int tl_note_links(char *t, long n) {
    long i; long e;
    i = 0;
    while (i < n) {
        e = i; while (e < n && t[e] != 10) e = e + 1;
        if (tl_islink(t, i, e, ".global ")) tl_addname(tl_def_at, tl_def_len, &tl_ndef, t + i + 8, (int)(e - i - 8));
        if (tl_islink(t, i, e, ".extern ")) tl_addname(tl_ext_at, tl_ext_len, &tl_next, t + i + 8, (int)(e - i - 8));
        if (tl_is(t + i, (int)(e - i), "_start:")) tl_has_entry = 1;
        if (tl_islink(t, i, e, ".bss __unisa_fw1_")) {
            long q; q = i + 5; while (q < e && t[q] != 32) q = q + 1;
            tl_addname(tl_fw_at, tl_fw_len, &tl_nfw, t + i + 5, (int)(q - i - 5));
        }
        i = e + 1;
    }
    return 0;
}
int tl_defined(char *s, int n) { return tl_inset(tl_def_at, tl_def_len, tl_ndef, s, n); }
static int tl_fw_has(char *s, int n) {
    int i; int k; i = 0;
    while (i < tl_nfw) {
        k = tl_fw_name(i);
        if (k < tl_fw_len[i] && tl_same(tl_npool + tl_fw_at[i] + k, tl_fw_len[i] - k, s, n)) return 1;
        i = i + 1;
    }
    return 0;
}
/* Forward mark i: its text and length when no unit defines the name, 0 when one does,
   -1 past the last mark. */
int tl_fwd(int i, char **s) {
    int k;
    if (i < 0 || i >= tl_nfw || !s) return -1;
    k = tl_fw_name(i);
    if (k < tl_fw_len[i] && tl_defined(tl_npool + tl_fw_at[i] + k, tl_fw_len[i] - k)) return 0;
    *s = tl_npool + tl_fw_at[i];
    return tl_fw_len[i];
}
/* The link trailer: __init calls every unit's initialiser, then the tape ends. */
int tl_finish(int u) {
    int k;
    tl_os("__init:\n", 8);
    k = 0;
    while (k < u) { tl_os("  call __init_u", 15); tl_num(k); tl_os("\n", 1); k = k + 1; }
    tl_os("  ret\n", 6);
    tl_os(".end\n", 5);
    return 0;
}
int tl_needs(char *t, long n) {                              /* defines something still undefined? */
    long i; long e; int l;
    i = 0;
    while (i < n) {
        e = i; while (e < n && t[e] != 10) e = e + 1;
        if (tl_islink(t, i, e, ".global ")) {
            l = (int)(e - i - 8);
            if (tl_inset(tl_ext_at, tl_ext_len, tl_next, t + i + 8, l) && !tl_inset(tl_def_at, tl_def_len, tl_ndef, t + i + 8, l)) return 1;
        }
        i = e + 1;
    }
    return 0;
}
/* Reject unresolved data and function externs before emitting an image.
   __init alone is synthesized below after this check. */
int tl_check_undef(void) {
    int i; int k; char msg[320]; char *pre;
    i = 0;
    while (i < tl_next) {
        char *s; int n; s = tl_npool + tl_ext_at[i]; n = tl_ext_len[i];
        if (n > 0 && !tl_is(s, n, "__init") && !tl_inset(tl_def_at, tl_def_len, tl_ndef, s, n) && !tl_fw_has(s, n)) {
            pre = "link: undefined reference to "; k = 0;
            while (pre[k]) { msg[k] = pre[k]; k = k + 1; }
            if (n > 2 && s[0] == 103 && s[1] == 95) { n = n - 2; s = s + 2; }
            while (n > 0 && k < 318) { msg[k] = *s; k = k + 1; s = s + 1; n = n - 1; }
            msg[k] = 10; msg[k + 1] = 0;
            tl_fail(msg); return 1;
        }
        i = i + 1;
    }
    return 0;
}
int isarchive(char *p) { int n; n = 0; while (p[n]) n = n + 1; return n >= 2 && p[n - 2] == 46 && p[n - 1] == 97; }

/* the tape a unit object carries, or 0; its target goes to tl_target */
static char tl_target[32]; static char tl_first[32];
/* Decode a bounded little-endian field without overflowing host long. */
long tl_objnum(char *p, int w, long max) {
    long v; int d; v = 0;
    while (w > 0) { w = w - 1; d = p[w] & 255;
        if (d > max || v > (max - d) / 256) return -1;
        v = v * 256 + d;
    }
    return v;
}
int tl_objspan(long off, long size, long n) { return off >= 0 && size >= 0 && off <= n && size <= n - off; }
int tl_objname(char *p, long n, char *s) {
    long i; i = 0; while (s[i]) { if (i >= n || p[i] != s[i]) return 0; i = i + 1; }
    return i < n && p[i] == 0;
}
static char *tl_container_target;
long tl_objsection(char *b, long n, long *size) {
    long table; long count; long i; long h; long off; long z; long found; long names; long namesz; long ni; long end; long cmd; long width; long machine;
    found = -1; *size = 0; tl_container_target = 0;
    if (n < 64) return -1;
    if (b[0] == 127 && b[1] == 69 && b[2] == 76 && b[3] == 70) {
        if (b[4] != 2 || b[5] != 1 || b[6] != 1 || tl_objnum(b + 16, 2, 65535) != 1 || tl_objnum(b + 58, 2, 65535) != 64) goto bad;
        machine = tl_objnum(b + 18, 2, 65535);
        if (machine == 62) tl_container_target = "lnx/x86_64"; else if (machine == 183) tl_container_target = "lnx/arm64"; else goto bad;
        table = tl_objnum(b + 40, 8, n); count = tl_objnum(b + 60, 2, 65535); ni = tl_objnum(b + 62, 2, 65535);
        if (table < 64 || count <= 0 || ni <= 0 || ni >= count || count > (n - table) / 64) goto bad;
        h = table + ni * 64; names = tl_objnum(b + h + 24, 8, n); namesz = tl_objnum(b + h + 32, 8, n);
        if (!tl_objspan(names, namesz, n) || tl_objnum(b + h + 4, 4, 65535) != 3) goto bad;
        i = 0; while (i < count) {
            h = table + i * 64; off = tl_objnum(b + h + 24, 8, n); z = tl_objnum(b + h + 32, 8, 2147483647);
            if (tl_objnum(b + h + 4, 4, 65535) != 8 && !tl_objspan(off, z, n)) goto bad;
            ni = tl_objnum(b + h, 4, namesz); if (ni < 0 || ni >= namesz) goto bad;
            if (tl_objname(b + names + ni, namesz - ni, ".unisa.tape")) {
                if (found >= 0 || tl_objnum(b + h + 4, 4, 65535) != 1 || !tl_objspan(off, z, n)) goto bad;
                found = off; *size = z;
            }
            i = i + 1;
        }
    } else if ((b[0] & 255) == 207 && (b[1] & 255) == 250 && (b[2] & 255) == 237 && (b[3] & 255) == 254) {
        machine = tl_objnum(b + 4, 4, 2147483647);
        if (machine == 16777223) tl_container_target = "osx/x86_64"; else if (machine == 16777228) tl_container_target = "osx/arm64"; else goto bad;
        if (tl_objnum(b + 12, 4, 65535) != 1) goto bad;
        count = tl_objnum(b + 16, 4, n); z = tl_objnum(b + 20, 4, n); if (!tl_objspan(32, z, n) || count < 0 || count > z / 8) goto bad;
        end = 32 + z; table = 32; i = 0;
        while (i < count) {
            if (!tl_objspan(table, 8, end)) goto bad;
            cmd = tl_objnum(b + table, 4, 2147483647); width = tl_objnum(b + table + 4, 4, n);
            if (width < 8 || !tl_objspan(table, width, end)) goto bad;
            if (cmd == 25) {
                long sections; long j;
                if (width < 72) goto bad; sections = tl_objnum(b + table + 64, 4, n);
                if (sections < 0 || sections > (width - 72) / 80 || 72 + sections * 80 != width) goto bad;
                j = 0; while (j < sections) {
                    h = table + 72 + j * 80; off = tl_objnum(b + h + 48, 4, n); z = tl_objnum(b + h + 40, 8, 2147483647);
                    if ((b[h + 64] & 255) != 1 && !tl_objspan(off, z, n)) goto bad;
                    if (tl_objname(b + h, 16, "__unisa_tape") && tl_objname(b + h + 16, 16, "__UNISA")) {
                        if (found >= 0 || !tl_objspan(off, z, n)) goto bad; found = off; *size = z;
                    }
                    j = j + 1;
                }
            }
            table = table + width; i = i + 1;
        }
        if (table != end) goto bad;
    } else {
        machine = tl_objnum(b, 2, 65535);
        if (machine == 34404) tl_container_target = "win/x86_64"; else if (machine == 43620) tl_container_target = "win/arm64"; else goto bad;
        count = tl_objnum(b + 2, 2, 65535); if (tl_objnum(b + 16, 2, 65535) != 0 || count <= 0 || count > (n - 20) / 40) goto bad;
        table = tl_objnum(b + 8, 4, n); z = tl_objnum(b + 12, 4, n); if (table < 0 || z < 0 || z > (n - table) / 18) goto bad;
        i = 0; while (i < count) {
            h = 20 + i * 40; off = tl_objnum(b + h + 20, 4, n); z = tl_objnum(b + h + 16, 4, 2147483647);
            if (!(b[h + 36] & 128) && !tl_objspan(off, z, n)) goto bad;
            if (tl_is(b + h, 8, ".unisatp")) { if (found >= 0 || !tl_objspan(off, z, n)) goto bad; found = off; *size = z; }
            i = i + 1;
        }
    }
    return found;
bad:
    tl_fail("link: malformed unit object container\n"); return -1;
}
char *tl_tape(char *b, long n, long *len) {
    long i; long k; long v; long size; long digits; int q;
    i = tl_objsection(b, n, &size); if (i < 0) return 0;
    n = i + size;
    if (size > 11) {
        if (b[i] == 85 && b[i + 1] == 78 && b[i + 2] == 73 && b[i + 3] == 83 && b[i + 4] == 65 && b[i + 5] == 84
            && b[i + 6] == 65 && b[i + 7] == 80 && b[i + 8] == 69 && b[i + 9] == 49 && b[i + 10] == 32) {
            k = i + 11; q = 0;
            while (k < n && b[k] != 32 && q < 31) { tl_target[q] = b[k]; q = q + 1; k = k + 1; }
            if (!q || k >= n || b[k] != 32) goto malformed;
            tl_target[q] = 0; if (!tl_objname(tl_target, 32, tl_container_target)) goto malformed;
            k = k + 1; digits = k;
            while (k < n && b[k] >= 48 && b[k] <= 57) k = k + 1;
            if (k >= n || b[k] != 10 || k - digits > 20) goto malformed;
            v = tl_ar_dec(b + digits, (int)(k - digits), n - k - 1);
            if (v >= 0 && v == n - k - 1) { *len = v; return b + k + 1; }
        }
    }
malformed:
    tl_fail("link: malformed unit tape payload\n"); return 0;
}

static int tl_tab_on;
static int tl_tables(void) {
    void *mm_zalloc(long);
    long sy_rlimit_as(void);
    long lim;
    if (tl_tab_on) return 0;
    /* tl_tables allocates 8 MiB, but the link flow itself (object read,
       relocation, output buffers) needs about 20 MiB more on top of the
       12.1 MiB static BSS: the measured floor is 40 MiB, so 44 MiB leaves
       4 MiB. This is not the table size -- re-measure the whole link. */
    lim = sy_rlimit_as();
    if (lim > 0 && lim < (44L * 1024 * 1024)) return 1;
    tl_hat = mm_zalloc((long)TL_HASH * (long)sizeof(int));
    tl_hlen = mm_zalloc((long)TL_HASH * (long)sizeof(int));
    tl_hkind = mm_zalloc((long)TL_HASH * (long)sizeof(int));
    tl_gpool = mm_zalloc((long)TL_GP);
    tl_gat = mm_zalloc((long)TL_MAXG * (long)sizeof(int));
    tl_glen = mm_zalloc((long)TL_MAXG * (long)sizeof(int));
    tl_gdef_at = mm_zalloc((long)TL_MAXG * (long)sizeof(int));
    tl_gdef_len = mm_zalloc((long)TL_MAXG * (long)sizeof(int));
    tl_npool = mm_zalloc((long)TL_NP);
    tl_def_at = mm_zalloc((long)TL_MAXG * (long)sizeof(int));
    tl_def_len = mm_zalloc((long)TL_MAXG * (long)sizeof(int));
    tl_ext_at = mm_zalloc((long)TL_MAXG * (long)sizeof(int));
    tl_ext_len = mm_zalloc((long)TL_MAXG * (long)sizeof(int));
    tl_fw_at = mm_zalloc((long)TL_MAXG * (long)sizeof(int));
    tl_fw_len = mm_zalloc((long)TL_MAXG * (long)sizeof(int));
    if (!tl_fw_at || !tl_fw_len) return 1;
    if (!tl_hat || !tl_hlen || !tl_hkind || !tl_gpool || !tl_gat || !tl_glen ||
        !tl_gdef_at || !tl_gdef_len || !tl_npool || !tl_def_at || !tl_def_len || !tl_ext_at || !tl_ext_len)
        return 1;
    tl_tab_on = 1;
    return 0;
}

int tl_begin(void) {
    if (tl_tables()) { tl_fail("link: out of memory\n"); return 1; }
    tl_source_next = 0;
    tl_ng = 0; tl_gend = 0; tl_nend = 0; tl_ndef = 0; tl_next = 0; tl_ngdef = 0; tl_has_entry = 0; tl_inits = 0; tl_nfw = 0;
    return 0;
}
void tl_adopt_first(void) {
    int k = 0;
    while (tl_target[k] && k < 31) { tl_first[k] = tl_target[k]; k = k + 1; }
    tl_first[k] = 0;
}
int tl_target_differs(void) {
    int k = 0;
    while (tl_first[k] && tl_first[k] == tl_target[k]) k = k + 1;
    return tl_first[k] != tl_target[k];
}
const char *tl_first_text(void) { return tl_first; }
const char *tl_target_text(void) { return tl_target; }
int tl_entry_missing(void) { return !tl_has_entry; }
