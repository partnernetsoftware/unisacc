#pragma unisa module tapelink
/* Product tape linker. No libc and no posix. The driver injects byte
   emission and failure, and owns the output buffer. One link at a time. */
static int (*tl_emit)(int);
static int (*tl_die)(char *);
int tl_bind(int (*emit)(int), int (*die)(char *)) {
    if (!emit || !die) return 1;
    tl_emit = emit; tl_die = die; return 0;
}
static int tl_o(int c) { return tl_emit(c); }
static int tl_fail(char *m) { return tl_die(m); }
#define TL_HASH 262144
#define TL_MAXG 65536
#define TL_GP 1048576
#define TL_NP 2097152
static int *tl_hat; static int *tl_hlen; static int *tl_hkind;   /* per unit: offset+1 into tl_t */
static char *tl_t;
static char *tl_gpool; static int tl_gend;                                 /* global objects already defined */
static int *tl_gat; static int *tl_glen; static int tl_ng;
static int tl_inits;                                                        /* units that had an __init_u */
int tl_isid(int c) {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 46 || c == 36;
}
int tl_hash(char *s, int n) {
    unsigned long h; int k; h = 5381; k = 0;
    while (k < n) { h = (h * 33 + (s[k] & 255)) & 4294967295; k = k + 1; }
    return (int)(h & (TL_HASH - 1));
}
int tl_same(char *a, int n, char *b, int m) {
    int k; if (n != m) return 0;
    k = 0; while (k < n) { if (a[k] != b[k]) return 0; k = k + 1; }
    return 1;
}
int tl_is(char *s, int n, char *lit) { int k; k = 0; while (lit[k]) k = k + 1; return tl_same(s, n, lit, k); }
int tl_slot(char *s, int n) {               /* the slot holding s, or the empty slot where it would go */
    int h; h = tl_hash(s, n);
    while (tl_hat[h]) {
        if (tl_same(tl_t + tl_hat[h] - 1, tl_hlen[h], s, n)) return h;
        h = (h + 1) & (TL_HASH - 1);
    }
    return h;
}
int tl_kind(char *s, int n) { int h; h = tl_slot(s, n); return tl_hat[h] ? tl_hkind[h] : 0; }
int tl_put(char *s, int n, int kind) {
    int h; h = tl_slot(s, n);
    if (tl_hat[h] == 0) { tl_hat[h] = (int)(s - tl_t) + 1; tl_hlen[h] = n; tl_hkind[h] = kind; }
    else { if (kind == 2) tl_hkind[h] = 2; }      /* `.global` wins over a definition seen first */
    return 0;
}
int tl_gseen(char *s, int n) {               /* a global object some earlier unit defined */
    int i; i = 0;
    while (i < tl_ng) { if (tl_same(tl_gpool + tl_gat[i], tl_glen[i], s, n)) return 1; i = i + 1; }
    return 0;
}
int tl_gadd(char *s, int n) {
    int k;
    if (tl_ng >= 65536 || tl_gend + n >= 1048576) tl_fail("link: too many global objects\n");
    tl_gat[tl_ng] = tl_gend; tl_glen[tl_ng] = n;
    k = 0; while (k < n) { tl_gpool[tl_gend + k] = s[k]; k = k + 1; }
    tl_gend = tl_gend + n; tl_ng = tl_ng + 1;
    return 0;
}
int tl_os(char *s, int n) { int k; k = 0; while (k < n) { tl_o(s[k] & 255); k = k + 1; } return 0; }
int tl_num(int v) { char d[16]; int n; n = 0; if (v == 0) { tl_o(48); return 0; }
    while (v > 0) { d[n] = 48 + v % 10; v = v / 10; n = n + 1; }
    while (n > 0) { n = n - 1; tl_o(d[n]); } return 0; }
/* a name, renamed for unit u when it is this unit's own */
int tl_name(char *s, int n, int u) {
    if (tl_is(s, n, "__init_u")) { tl_os("__init_u", 8); tl_num(u); return 0; }
    if (tl_is(s, n, "_start") || tl_is(s, n, "__init")) { tl_os(s, n); return 0; }
    if (tl_kind(s, n) == 1) { tl_os("__u", 3); tl_num(u); tl_o(95); }
    tl_os(s, n);
    return 0;
}
/* the operands of a line from p to e: identifiers renamed, strings copied */
int tl_operands(char *t, int p, int e, int u) {
    int q;
    while (p < e) {
        if (t[p] == 34) {
            q = p + 1;
            while (q < e && t[q] != 34) { if (t[q] == 92) q = q + 1; q = q + 1; }
            if (q < e) q = q + 1;
            tl_os(t + p, q - p); p = q; continue;
        }
        if (tl_isid(t[p] & 255) && (t[p] < 48 || t[p] > 57) && t[p] != 46 && t[p] != 36) {
            q = p; while (q < e && tl_isid(t[q] & 255)) q = q + 1;
            tl_name(t + p, q - p, u); p = q; continue;
        }
        if (tl_isid(t[p] & 255)) {            /* a number or a register-like word: as it is */
            q = p; while (q < e && tl_isid(t[q] & 255)) q = q + 1;
            tl_os(t + p, q - p); p = q; continue;
        }
        tl_o(t[p] & 255); p = p + 1;
    }
    return 0;
}
int tl_word(char *t, int p, int e) { int q; q = p; while (q < e && tl_isid(t[q] & 255)) q = q + 1; return q; }
int tl_inset(int *at, int *ln, int cnt, char *s, int n); int tl_addname(int *at, int *ln, int *cnt, char *s, int n);
static int *tl_gdef_at; static int *tl_gdef_len; static int tl_ngdef;    /* R20-3: names some unit gave an initialiser */
/* R20-3: a unit tape's first record must be `.unit 2` (exactly once); an
   object without it predates the initialiser marks and could hide two
   initialised definitions, so it is refused rather than guessed at */
/* Source frame ids are local to each object, then assigned distinct link ids. */
static int tl_source_next;
static int tl_source_map[128];
/* tokenlocations.UNIT_MAX = 128; anonymous boundaries share the same budget.
   Blank/comment rows are not semantics. Tape controls end comments, just as
   in exec/facts/tape-space.tsv; metadata is handled before this predicate. */
static int tl_semantic(char *t, int p, int e) {
    int c;
    while (p < e) {
        c = t[p] & 255;
        if (c == 9 || c == 11 || c == 12 || c == 13 || c == 28 || c == 29 || c == 30 || c == 32 || c == 133 || c == 160) { p++; continue; }
        if (c != 59) return 1;
        while (p < e) {
            c = t[p] & 255; p++;
            if (c == 11 || c == 12 || c == 13 || c == 28 || c == 29 || c == 30 || c == 133) break;
        }
    }
    return 0;
}
static int tl_unlocated(char *t, int p, int e, int first, int *located) {
    int id;
    if (*located || !tl_semantic(t, p, e)) return 0;
    if (tl_source_next >= 128) { tl_fail("reject: tape truncated\n"); return 1; }
    id = tl_source_next; tl_source_next++;
    if (first >= 0) tl_source_map[first] = id;
    tl_os(".unit ", 6); tl_num(id); tl_os(" 0:\n", 4);
    *located = 1;
    return 0;
}
static int tl_frame(char *t, int p, int e, int *id, int *tail) {
    int v; int b; int k; int h; int l;
    if (p >= e || t[p] < 48 || t[p] > 57) return 0;
    v = 0; k = p;
    while (p < e && t[p] >= 48 && t[p] <= 57) { if (v > 127) return 0; v = v * 10 + t[p] - 48; p++; }
    if (v >= 128 || (p - k > 1 && t[k] == 48) || p >= e || t[p] != 32) return 0;
    *id = v; p++; *tail = p; k = p; b = 0;
    while (p < e && t[p] >= 48 && t[p] <= 57) {
        int max; int digit; max = (e - p) / 2; digit = t[p] - 48;
        if (b > max / 10 || (b == max / 10 && digit > max % 10)) return 0;
        b = b * 10 + digit; p++;
    }
    if (p == k || (p - k > 1 && t[k] == 48) || p >= e || t[p] != 58 || b != (e - p - 1) / 2 || (e - p - 1) % 2) return 0;
    p++;
    while (p < e) {
        h = t[p]; l = t[p + 1];
        if (!((h >= 48 && h <= 57) || (h >= 97 && h <= 102)) || !((l >= 48 && l <= 57) || (l >= 97 && l <= 102)) || (h == 48 && l == 48)) return 0;
        p = p + 2;
    }
    return 1;
}
int tl_unitver(char *t, int n) {
    int i; int e; int id; int tail;
    if (n < 13 || !tl_same(t, 8, ".unit 2\n", 8)) { tl_fail("link: object predates .unit 2 (recompile it with this unisacc -c -funit)\n"); return 1; }
    i = 8;
    while (i < n) {
        e = i; while (e < n && t[e] != 10) e++;
        if (e == n) break;
        if (e - i >= 4 && tl_same(t + i, 4, ".end", 4) &&
            (e - i == 4 || t[i + 4] == 32 || t[i + 4] == 9 || t[i + 4] == 13 || t[i + 4] == 59)) {
            if (e - i == 4 && e + 1 == n) return 0;
            break;
        }
        if (e - i >= 5 && tl_same(t + i, 5, ".unit", 5) &&
            (e - i == 5 || t[i + 5] == 32 || t[i + 5] == 9 || t[i + 5] == 13 || t[i + 5] == 59)) {
            if (e - i < 6 || t[i + 5] != 32 || !tl_frame(t, i + 6, e, &id, &tail)) break;
        }
        i = e + 1;
    }
    tl_fail("reject: tape truncated\n"); return 1;
}
int tl_unit(char *t, int n, int u) {
    int i; int e; int j; int q; int pass; int first; int located;
    i = 0; while (i < 128) { tl_source_map[i] = -1; i++; }
    /* Prefix semantics belong to the first real local TU, if one exists.
       Reserve its mapping early, without inheriting its later filename. */
    first = -1; located = 0;
    tl_t = t;
    i = 0; while (i < TL_HASH) { tl_hat[i] = 0; i = i + 1; }
    pass = 0;
    while (pass < 2) {                        /* 0: .global names; 1: everything defined here */
        i = 0;
        while (i < n) {
            e = i; while (e < n && t[e] != 10) e = e + 1;
            if (e > i) {
                if (t[i] == 46) {
                    j = i + 1; q = tl_word(t, j, e);
                    if (pass == 0 && first < 0 && tl_same(t + j, q - j, "unit", 4) && q < e && t[q] == 32) {
                        int id; int tail;
                        if (tl_frame(t, q + 1, e, &id, &tail)) first = id;
                    }
                    if (pass == 0 && tl_same(t + j, q - j, "global", 6)) { j = q + 1; q = tl_word(t, j, e); tl_put(t + j, q - j, 2); }
                    if (pass == 1 && (tl_same(t + j, q - j, "bss", 3) || tl_same(t + j, q - j, "str", 3))) {
                        j = q + 1; q = tl_word(t, j, e); tl_put(t + j, q - j, 1);
                    }
                } else { if (pass == 1 && t[i] != 32 && t[i] != 9 && t[e - 1] == 58) tl_put(t + i, e - 1 - i, 1); }
            }
            i = e + 1;
        }
        pass = pass + 1;
    }
    i = 0;
    while (i < n) {
        e = i; while (e < n && t[e] != 10) e = e + 1;
        if (e > i) {
            if (t[i] == 46) {
                j = i + 1; q = tl_word(t, j, e);
                if (tl_same(t + j, q - j, "global", 6) || tl_same(t + j, q - j, "extern", 6)) { i = e + 1; continue; }
                if (tl_same(t + j, q - j, "end", 3) && q == e) { i = e + 1; continue; }
                if (tl_same(t + j, q - j, "unit", 4) && q < e && t[q] == 32) {
                    int id; int tail;
                    if (e - i == 7 && tl_same(t + i, 7, ".unit 2", 7)) { i = e + 1; continue; }
                    if (!tl_frame(t, q + 1, e, &id, &tail)) { tl_fail("reject: tape truncated\n"); return 1; }
                    if (tl_source_map[id] < 0) {
                        if (tl_source_next >= 128) { tl_fail("reject: tape truncated\n"); return 1; }
                        tl_source_map[id] = tl_source_next; tl_source_next++;
                    }
                    tl_os(".unit ", 6); tl_num(tl_source_map[id]); tl_o(32); tl_os(t + tail, e - tail); tl_o(10);
                    located = 1;
                    i = e + 1; continue;
                }
                /* R20-3: `.gdef NAME` -- this unit gives NAME an initialiser; a
                   second unit doing the same is two definitions (C99 6.9p5) */
                if (tl_same(t + j, q - j, "gdef", 4)) {
                    int a; int b; a = q + 1; b = tl_word(t, a, e);
                    if (tl_inset(tl_gdef_at, tl_gdef_len, tl_ngdef, t + a, b - a)) {
                        char msg[320]; int m; int c; char *pre; pre = "link: multiple definitions of ";
                        m = 0; while (pre[m]) { msg[m] = pre[m]; m = m + 1; }
                        c = a; if (b - a > 2 && t[a] == 103 && t[a + 1] == 95) c = a + 2;
                        while (c < b && m < 300) { msg[m] = t[c]; m = m + 1; c = c + 1; }
                        msg[m] = 10; msg[m + 1] = 0; tl_fail(msg);
                    }
                    tl_addname(tl_gdef_at, tl_gdef_len, &tl_ngdef, t + a, b - a);
                    i = e + 1; continue;
                }
                if (tl_same(t + j, q - j, "bss", 3)) {
                    int a; int b; a = q + 1; b = tl_word(t, a, e);
                    if (tl_kind(t + a, b - a) == 2) {
                        if (tl_gseen(t + a, b - a)) { i = e + 1; continue; }   /* one object for every unit */
                        tl_gadd(t + a, b - a);
                    }
                }
                if (tl_unlocated(t, i, e, first, &located)) return 1;
                tl_os(t + i, q - i);           /* the directive word itself */
                tl_operands(t, q, e, u);
            } else {
                if (tl_unlocated(t, i, e, first, &located)) return 1;
                if (t[i] == 32 || t[i] == 9) {
                j = i; while (j < e && (t[j] == 32 || t[j] == 9)) j = j + 1;
                q = j; while (q < e && t[q] != 32 && t[q] != 9) q = q + 1;   /* the op, as it is */
                /* `.sys NAME, ...`: NAME is a system call, never a unit's name
                   (a unit that carries `exit` or `rename` must not rename it) */
                if (tl_same(t + j, q - j, ".sys", 4) || tl_same(t + j, q - j, ".sys6", 5)) {
                    while (q < e && (t[q] == 32 || t[q] == 9)) q = q + 1;
                    while (q < e && t[q] != 44) q = q + 1;
                }
                tl_os(t + i, q - i);
                tl_operands(t, q, e, u);
            } else {
                if (t[e - 1] == 58) {
                    if (tl_is(t + i, e - 1 - i, "__init_u")) tl_inits = tl_inits | 0;
                    /* R19-8: an exported name defined by two units (two `main`s) */
                    if (tl_kind(t + i, e - 1 - i) == 2 && e - 1 - i < 250 && !tl_is(t + i, e - 1 - i, "__init_u")) {
                        char fk[256]; int q; fk[0] = 1; q = 0;
                        while (q < e - 1 - i) { fk[q + 1] = t[i + q]; q = q + 1; }
                        if (tl_gseen(fk, q + 1)) {
                            char msg[320]; int m; char *pre; pre = "link: multiple definitions of ";
                            m = 0; while (pre[m]) { msg[m] = pre[m]; m = m + 1; }
                            q = 0; while (q < e - 1 - i) { msg[m] = t[i + q]; m = m + 1; q = q + 1; }
                            msg[m] = 10; msg[m + 1] = 0;
                            tl_fail(msg);
                        }
                        tl_gadd(fk, q + 1);
                    }
                    tl_name(t + i, e - 1 - i, u); tl_o(58);
                } else tl_os(t + i, e - i);
            } }
        }
        tl_o(10);
        i = e + 1;
