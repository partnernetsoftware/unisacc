#pragma unisa module bindret
/* Return immediately after a successful dependency write when deponly
   is nonzero. No libc and no include. free and clierror stay in
   exec/c/compiler.c. A nonzero write result is the clierror path and
   does not reach the deponly return. */
int bx_dep_ret(int drc, int deponly) {
    if (drc) return 2;
    if (deponly) return 0;
    return 1;
}
