#pragma unisa module streamname
/* Seven stream names. Code names and model files match
   exec/pipeline/image-stages.tsv. Official names match the byte-stream
   table in README.md. No libc and no include. A null out-pointer
   returns 4. An index outside 0..6 returns 2. */
int sn_count(void) {
    return 7;
}
int sn_at(int index, const char **official, const char **code) {
    if (!official || !code) return 4;
    if (index == 0) { *official = "preprocess"; *code = "e2"; return 0; }
    if (index == 1) { *official = "lex"; *code = "e1"; return 0; }
    if (index == 2) { *official = "parse"; *code = "e3"; return 0; }
    if (index == 3) { *official = "opt"; *code = "e4"; return 0; }
    if (index == 4) { *official = "prune"; *code = "prune"; return 0; }
    if (index == 5) { *official = "lowering"; *code = "lower"; return 0; }
    if (index == 6) { *official = "encode"; *code = "elf"; return 0; }
    return 2;
}
