#pragma unisa module bindtarget
/* Dependency-target choice. No libc and no include.
   cxd_default_target and the 520-byte buffer stay in exec/c/compiler.c.
   dep_target starts as out. A null out, or any nonzero deponly, asks for
   the default and does not publish out. Otherwise the choice is out. */
int bx_dep_target(const char *out, int deponly, const char **chosen) {
    if (!out || deponly) return 1;
    if (!chosen) return 4;
    *chosen = out;
    return 0;
}
