#pragma unisa module kertx
/* Generated by tools/nametab-gen.cx from exec/facts/k2-errors.tsv@messages (tools/nametabs.tsv row kertx).
   Do not edit by hand. K2 error text rows with three columns. The leading = is stripped. The value stays text.
   A null out-pointer returns 4. An index outside 0..count-1 returns 2.
   No libc and no include. */
int ket_count(void) {
    return 3;
}
int ket_at(int index, const char **name, const char **kind, const char **value) {
    if (!name || !kind || !value) return 4;
    if (index == 0) { *name = "text0"; *kind = "str"; *value = "too many errors emitted, stopping now\\n"; return 0; }
    if (index == 1) { *name = "text1"; *kind = "str"; *value = " error generated.\\n"; return 0; }
    if (index == 2) { *name = "text2"; *kind = "str"; *value = " errors generated.\\n"; return 0; }
    return 2;
}
