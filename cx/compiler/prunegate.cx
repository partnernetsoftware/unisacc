#pragma unisa module prunegate
/* Pure name and prologue gates from src/tapeprune.c. Globals stay in C.
   A null pointer returns 4. That 4 is not on the old path. */
static int pg_eq(const char *a, const char *b) {
    int i;
    i = 0;
    while (a[i] && a[i] == b[i]) i++;
    return a[i] == 0 && b[i] == 0;
}
int pg_length(const char *s) {
    int n;
    if (!s) return 4;
    n = 0;
    while (s[n]) n++;
    return n;
}
int pg_equal(const char *a, const char *b, int n) {
    int i;
    if (n <= 0) return 1;
    if (!a || !b) return 4;
    i = 0;
    while (i < n) {
        if (a[i] != b[i]) return 0;
        i++;
    }
    return 1;
}
int pg_reg(const char *s) {
    if (!s) return 4;
    if (pg_eq(s, "r0")) return 0;
    if (pg_eq(s, "r1")) return 1;
    if (pg_eq(s, "r2")) return 2;
    if (pg_eq(s, "r3")) return 3;
    if (pg_eq(s, "r4")) return 4;
    if (pg_eq(s, "r5")) return 5;
    if (pg_eq(s, "r6")) return 6;
    if (pg_eq(s, "r7")) return 7;
    return -1;
}
int pg_op(const char *s) {
    if (!s) return 4;
    if (pg_eq(s, "imm")) return 0;
    if (pg_eq(s, "mov")) return 1;
    if (pg_eq(s, "load64")) return 21;
    if (pg_eq(s, "store64")) return 22;
    if (pg_eq(s, ".ld")) return 23;
    if (pg_eq(s, ".st")) return 24;
    if (pg_eq(s, ".lea")) return 25;
    if (pg_eq(s, ".zero")) return 26;
    if (pg_eq(s, "jump")) return 27;
    if (pg_eq(s, "jumpz")) return 28;
    if (pg_eq(s, "call")) return 29;
    if (pg_eq(s, "callr")) return 30;
    if (pg_eq(s, "ret")) return 33;
    if (pg_eq(s, ".frame")) return 34;
    if (pg_eq(s, ".exit")) return 38;
    if (pg_eq(s, "callm")) return 68;
    if (pg_eq(s, ".bss")) return 100;
    if (pg_eq(s, ".str")) return 101;
    if (pg_eq(s, ".global")) return 102;
    if (pg_eq(s, ".extern")) return 103;
    if (pg_eq(s, ".hostaddr")) return 104;
    if (pg_eq(s, ".hostcall")) return 105;
    return -1;
}
/* Opcode index for a span, same order as src/tapeprune.c tp_opnames.
   A null pointer or a negative length returns 4. That 4 is not tp_getop's
   old return. An empty or unknown span returns -1. */
int pg_span(const char *s, int n) {
    static const char *names[69] = {
        "imm", "mov", "add64", "sub64", "mul64", "xor64", "and64", "or64", "shl64", "shr64", "lshr64",
        ".div", ".mod", ".udiv", ".umod", "slt64", "sle64", "ult64", "ule64", "eq", "ne",
        "load64", "store64", ".ld", ".st", ".lea", ".zero", "jump", "jumpz", "call", "callr",
        ".hostcall", ".hostaddr", "ret", ".frame", ".arg", ".print", ".write", ".exit", ".sys", ".sys6",
        ".argc", ".argv", "nop",
        "fadd64", "fsub64", "fmul64", "fdiv64", "flt64", "fle64", "feq64",
        "fadd32", "fsub32", "fmul32", "fdiv32", "flt32", "fle32", "feq32",
        "cvtid", "cvtud", "cvtis", "cvtus", "cvtdi", "cvtdu", "cvtsd", "cvtds",
        "fsqrt64", "fsqrt32", "callm"
    };
    int i;
    if (!s || n < 0) return 4;
    i = 0;
    while (i < 69) {
        int k;
        k = 0;
        while (names[i][k]) k = k + 1;
        if (k == n && pg_equal(s, names[i], n) == 1) return i;
        i = i + 1;
    }
    return -1;
}
int pg_keep(const char *s) {
    int op;
    op = pg_op(s);
    if (op == 4) return 4;
    if (op == 102 || op == 103 || op == 104 || op == 105) return 1;
    return 0;
}
int pg_shape(int op) {
    if (op == 0 || op == 1 || op == 25 || op == 28 || op == 31 || op == 32) return 2;
    if (op == 21 || op == 22 || op == 26) return 3;
    if (op == 23 || op == 24) return 4;
    if (op == 27 || op == 29 || op == 30 || op == 34) return 1;
    if (op == 33) return 0;
    return -1;
}
int pg_prologue(int op0, int i0, int op1, int a1, int b1, int c1, int op2, int a2, int b2, int op3, int i3) {
    if (op0 != 34 || i0 != 8) return 0;
    if (op1 != 22 || a1 != 7 || b1 != 0 || c1 != 6) return 0;
    if (op2 != 1 || a2 != 6 || b2 != 7) return 0;
    if (op3 != 34 || i3 < 0) return 0;
    return 1;
}
int pg_width(int w) {
    if (w == 1 || w == 2 || w == 4 || w == 8) return 1;
    return 0;
}
int pg_cut(const char *s, int n) {
    int i;
    if (!s || n < 1) return 4;
    if (s[0] != 'r') return -1;
    i = 1;
    while (i < n) {
        if (s[i] == '+' || s[i] == '-') return i;
        i++;
    }
    return -1;
}
int pg_comment(int c, int quoted) {
    if (quoted) return 0;
    if (c == 59) return 1;
    return 0;
}
int pg_bss_size(unsigned long long n) {
    if (n > 33554432ull) return 1;
    return 0;
}
