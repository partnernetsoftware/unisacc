#pragma unisa module bindtemp
/* Temporary symbol-stream path. No libc and no include.
   mkstemp, fdopen, fwrite, fclose, rename, and unlink stay in exec/c/bind.c.
   On Apple and Linux the adapter formats "%s.XXXXXX" into a 4096-byte buffer.
   snprintf's return is the length without the trailing NUL. A return >= cap
   is the historical "path too long" refusal. Other hosts do not build this name. */
static const char bx_suf[8] = { '.', 'X', 'X', 'X', 'X', 'X', 'X', 0 };
int bx_tmp_name(const char *path, char *out, int cap) {
    int n, i;
    if (!path || !out || cap < 1) return 4;
    n = 0;
    while (path[n]) {
        if (n + 7 >= cap) return 1;
        n++;
    }
    if (n + 7 >= cap) return 1;
    for (i = 0; i < n; i++) out[i] = path[i];
    for (i = 0; i < 7; i++) out[n + i] = bx_suf[i];
    out[n + 7] = 0;
    return 0;
}
const char *bx_tmp_why(void) {
    return "bind: symbol-stream path too long";
}
