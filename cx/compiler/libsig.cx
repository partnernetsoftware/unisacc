#pragma unisa module libsig
/* Pure gates after the name and type checks in exec/c/librarybindings.h.
   malloc, the binding table, and graph equality stay in that header.
   A missing binding returns 4. The old data declaration returned 1.
   A negative writable or a negative signature length returns 4.
   Those 4s were not on the old path. Extent 0, writable above 1,
   a pointer width other than 8, a zero address, an extent past the
   top of a 64-bit address, or an extent shorter than the width
   returns 1. A null signature returns 4. Length below 16 returns 1
   and does not read. USLSIG2 or USLSIG3 plus a newline returns 0. */
static int ls_tag(const char *s, int ver) {
    if (s[0] != 85) return 0;
    if (s[1] != 83) return 0;
    if (s[2] != 76) return 0;
    if (s[3] != 83) return 0;
    if (s[4] != 73) return 0;
    if (s[5] != 71) return 0;
    if (ver == 2) {
        if (s[6] != 50) return 0;
    } else if (ver == 3) {
        if (s[6] != 51) return 0;
    } else {
        return 0;
    }
    if (s[7] != 10) return 0;
    return 1;
}
int ls_data(int present, int addr_present, int ptr64, unsigned long long address,
    unsigned long long extent, int writable, unsigned long long width) {
    unsigned long long top;
    if (!present) return 4;
    if (!addr_present) return 1;
    if (!ptr64) return 1;
    if (writable < 0) return 4;
    if (extent == 0) return 1;
    if (writable > 1) return 1;
    top = 18446744073709551615ull - address;
    if (extent > top) return 1;
    if (extent < width) return 1;
    return 0;
}
int ls_sig(const char *sig, int length) {
    if (!sig) return 4;
    if (length < 0) return 4;
    if (length < 16) return 1;
    if (ls_tag(sig, 2)) return 0;
    if (ls_tag(sig, 3)) return 0;
    return 1;
}
int ls_bytes(int n, int *out) {
    if (!out) return 4;
    if (n < 0) return 4;
    if (n > 2147483646) return 1;
    *out = n + 1;
    return 0;
}
int ls_wire_base(void) {
    return 16;
}
int ls_wire_type(void) {
    return 48;
}
int ls_wire_tail(int kind) {
    if (kind < 0) return 4;
    if (kind) return 86;
    return 77;
}
int ls_wire_rec(int name_n, int kind, int count) {
    int tail;
    if (name_n < 0 || count < 0) return 4;
    tail = ls_wire_tail(kind);
    if (tail == 4) return 4;
    if (name_n > 2147483647 - 86) return 1;
    if ((2147483647 - tail - name_n) / 48 < count) return 1;
    return name_n + tail + 48 * count;
}
int ls_wire_tag(unsigned char *p, int cap) {
    if (!p) return 4;
    if (cap < 8) return 1;
    p[0] = 85;
    p[1] = 83;
    p[2] = 66;
    p[3] = 73;
    p[4] = 78;
    p[5] = 68;
    p[6] = 49;
    p[7] = 10;
    return 0;
}
int ls_wire_flags(unsigned char *p, int cap, int kind, int variadic) {
    if (!p) return 4;
    if (cap < 4) return 1;
    if (kind < 0 || variadic < 0) return 4;
    p[0] = (unsigned char)kind;
    p[1] = 0;
    p[2] = 0;
    p[3] = (unsigned char)variadic;
    return 0;
}
