#pragma unisa module frames
/* The framed units the driver hands the multi route, and the per-source framing
   that builds them. src/driveunits.cx and tools/stagecase.cx both use this: the
   bytes are produced once, not copied a second time in a tool.
   A frame is LE32 frame length, then LE32 source-name length, the name, then the
   source's tape text; the frame's own length covers everything after it.
   fr_need/fr_le are the growth and little-endian writes driveunits used before
   the split, byte for byte. Allocation and copying go through L0 mem.heap and
   mem.bytes, so this module adds no direct libc call. All functions return 0,
   or 1 when refused. */
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use compiler.frameparts
#define FR_MAXN 2147483647L
#define FR_ROOM 1073741824L

int fr_need(unsigned char **b, long *n, long *cap, long more) {
    unsigned char *nb;
    long room;
    if (more < 0 || *n > FR_MAXN - more) return 1;
    if (*n + more <= *cap) return 0;
    room = *cap ? *cap : 4096;
    while (room < *n + more) {
        if (room > FR_ROOM) return 1;
        room = room * 2;
    }
    nb = mm_grow(*b, room);
    if (!nb) return 1;
    *b = nb;
    *cap = room;
    return 0;
}

void fr_le(unsigned char *b, long at, long v) {
    int k;
    k = 0;
    while (k < 4) {
        b[at + k] = (unsigned char)((v >> (8 * k)) & 255);
        k = k + 1;
    }
}

/* Append one source's frame. NAME/NAMELEN is the source path the driver saw,
   TEXT/TEXTN the tape that source produced. */
int fr_add(unsigned char **b, long *n, long *cap, const char *name, long namelen,
           const unsigned char *text, long textn) {
    long framed;
    if (namelen < 0 || textn < 0 || textn > FR_MAXN - 4 - namelen) return 1;
    framed = textn + 4 + namelen;
    if (fr_need(b, n, cap, 4 + framed)) return 1;
    fr_le(*b, *n, framed);
    *n = *n + 4;
    fr_le(*b, *n, namelen);
    *n = *n + 4;
    if (namelen > 0 && mm_copy(*b + *n, *cap - *n, name, namelen) != 0) return 1;
    *n = *n + namelen;
    if (textn > 0 && mm_copy(*b + *n, *cap - *n, text, textn) != 0) return 1;
    *n = *n + textn;
    return 0;
}

/* Shared intermediate frames own exact payload chunks until materialization.
 * The returned contiguous wire is independent of STORE and caller-owned. */
void *fr_shared_new(void) { return fp_new(); }
int fr_shared_add(void *store, const char *name, long namelen,
                  const unsigned char *text, long textn) {
    return fp_add(store, name, namelen, text, textn);
}
int fr_shared_materialize(void *store, unsigned char **bytes, long *n) {
    return fp_materialize(store, bytes, n);
}
void fr_shared_drop(void *store) { fp_drop(store); }
/* Internal phase transport only. Public framed wire stays byte-identical.
 * UNISACC_PP_COMPACT=1 selects UNIFP1 in holdframe's phase body only;
 * legacy phase bodies remain readable. Dictionary entries are generic exact
 * chunks, not semantically identified headers. Restoration intentionally
 * recreates the entire logical wire: macro evaluation/parsing is not skipped.
 * The outer LE32 body length and untouched ATTRT bytes retain their framing. */
int fr_phase_pack(const unsigned char *wire, long wn, unsigned char **out, long *on,
                  long *dictionary, long *shared) {
    void *s = fp_new(); long at = 0; int rc = 1;
    if (!s || !wire || wn <= 0) { fp_drop(s); return 1; }
    while (at < wn) {
        long z, nl;
        if (wn-at < 8) goto end;
        z = (long)wire[at] | ((long)wire[at+1]<<8) | ((long)wire[at+2]<<16) | ((long)wire[at+3]<<24);
        nl = (long)wire[at+4] | ((long)wire[at+5]<<8) | ((long)wire[at+6]<<16) | ((long)wire[at+7]<<24);
        if (z < 4 || z > wn-at-4 || nl < 0 || nl > z-4) goto end;
        if (fp_add(s, (const char *)wire+at+8, nl, wire+at+8+nl, z-4-nl)) goto end;
        at += 4+z;
    }
    rc = fp_pack(s, out, on, dictionary, shared);
end:
    fp_drop(s); return rc;
}
int fr_phase_unpack(const unsigned char *p, long n, unsigned char **out, long *on,
                    long *dictionary, long *shared) {
    return fp_unpack(p, n, out, on, dictionary, shared);
}
