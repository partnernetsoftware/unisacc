#pragma unisa module optmore
/* Pure judgments still inline in src/opt.c. No libc and no include.
   Line buffers, the opinfo net, and the writers stay in that file.
   A null pointer returns 4. An unknown kind returns -1.
   A match with the old if is marked 同旧返回. */
static int om_eq(const char *a, const char *b) {
    int i;
    i = 0;
    while (a[i] && a[i] == b[i]) i = i + 1;
    return a[i] == 0 && b[i] == 0;
}
/* oi_idx: h = (h * 31 + byte) & 511. OW_SLOTS is 512. 同旧返回. */
int om_hash(int h, int b) {
    return (h * 31 + (b & 255)) & 511;
}
/* oi_ask: i outside 0..127 returns -1. That -1 is the old 0-1. 同旧返回.
   A slot inside the table returns 0. oi_ask does not return there. */
int om_op_slot(int i) {
    if (i < 0 || i >= 128) return -1;
    return 0;
}
/* ol_opi: a stored generation equal to the round is a hit. 1 同旧返回. */
int om_opi_hit(int seen, int gen) {
    if (seen == gen) return 1;
    return 0;
}
/* ol_simple: a line shorter than 3, or not two leading spaces, returns 0.
   0 同旧返回. 1 means the head matched and the old function continues. */
int om_indent(int n, int c0, int c1) {
    if (n < 3 || c0 != 32 || c1 != 32) return 0;
    return 1;
}
/* ol_isctl: jump, jumpz, or ret. 1 and 0 同旧返回.
   A null word returns 4, 不是旧返回. */
int om_ctl(const char *w) {
    if (!w) return 4;
    if (om_eq(w, "jump") || om_eq(w, "jumpz") || om_eq(w, "ret")) return 1;
    return 0;
}
/* bl_split: bl_n >= 262144 returns 0. 0 同旧返回.
   1 means another block still fits. bl_split does not return there. */
int om_block_room(int n) {
    if (n >= 262144) return 0;
    return 1;
}
/* bl_split: a first byte other than space sets cut. 1 同旧返回. */
int om_lead_cut(int c) {
    if (c != 32) return 1;
    return 0;
}
/* ol_dead: ol_zok[z] == 0 returns 0. 0 同旧返回.
   1 means the scan still runs. ol_dead does not return there. */
int om_dead_off(int ok) {
    if (ok == 0) return 0;
    return 1;
}
/* ol_local: i + 2 >= n, or r2 not tracked, returns 0. 0 同旧返回. */
int om_local_span(int i, int n, int zok2) {
    if (i + 2 >= n || zok2 == 0) return 0;
    return 1;
}
/* ol_local: r2, r6, r7, and anything outside 0..7 return 0. 0 同旧返回.
   1 means the destination register can be the frame load. */
int om_frame_reg(int d) {
    if (d < 0 || d > 7 || d == 2 || d == 6 || d == 7) return 0;
    return 1;
}
/* ol_local: the sub64 line must be a + 9 bytes. A mismatch returns 0. 同旧返回. */
int om_sub_len(int len, int a) {
    if (len != a + 9) return 0;
    return 1;
}
/* ol_local: `, r6, r2` at the checked columns. A mismatch returns 0. 同旧返回. */
int om_sub_tail(int c0, int c2, int c3, int c6, int c7) {
    if (c0 != 44 || c2 != 114 || c3 != 54 || c6 != 114 || c7 != 50) return 0;
    return 1;
}
/* pk_islab: not a space, not a dot, longer than 1, and a trailing colon.
   1 and 0 同旧返回. */
int om_lab_line(int c0, int clast, int n) {
    if (n <= 1) return 0;
    if (c0 == 32 || c0 == 46) return 0;
    if (clast != 58) return 0;
    return 1;
}
/* pk_same: equal spans only. 0 and 1 同旧返回. */
int om_span_eq(int n, int m) {
    if (n != m) return 0;
    return 1;
}
/* ol_mov: a register >= 10 writes a tens digit. 1 同旧返回. */
int om_tens(int r) {
    if (r >= 10) return 1;
    return 0;
}
/* pk_bcls: l >= n selects the none row. 1 is that condition, not the old vfind.
   不是旧返回. */
int om_past(int l, int n) {
    if (l >= n) return 1;
    return 0;
}
