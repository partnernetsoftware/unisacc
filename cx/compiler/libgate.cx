#pragma unisa module libgate
/* Pure decisions from exec/c/libunisacc.c. No libc and no include.
   open, mmap, malloc, qsort, and panic stay in C. Return 4 is not on
   the old path. */
int lg_region(unsigned long long base, unsigned long long extent, unsigned long long at, unsigned long long bytes) {
    if (at < base) return 0;
    if (at - base > extent) return 0;
    if (bytes > extent - (at - base)) return 0;
    return 1;
}
int lg_bucket(unsigned long long p) {
    unsigned long long x;
    x = p >> 4;
    x = x ^ (x >> 17);
    x = x ^ (x >> 9);
    return (int)(x & 4095ull);
}
long long lg_dataoff(long long text) {
    return (text + 16383) & -16384;
}
int lg_image_head(const unsigned char *b, int n) {
    const char *m;
    int i;
    if (!b) return 4;
    if (n < 40) return 1;
    m = "UNILIB1\n";
    i = 0;
    while (i < 8) {
        if (b[i] != (unsigned char)m[i]) return 1;
        i++;
    }
    return 0;
}
int lg_syms_head(const unsigned char *b, int n) {
    const char *m;
    int i;
    if (!b) return 4;
    if (n < 6) return 1;
    m = "SYMS1\n";
    i = 0;
    while (i < 6) {
        if (b[i] != (unsigned char)m[i]) return 1;
        i++;
    }
    return 0;
}
int lg_u64_span(int at, int n) {
    if (at < 0 || n < 0) return 4;
    if (at > n) return 1;
    if (n - at < 8) return 1;
    return 0;
}
int lg_bounds(long long text, long long entry, long long stored, long long extent) {
    if (text <= 0) return 1;
    if (entry >= text) return 1;
    if (stored > extent) return 1;
    return 0;
}
int lg_sym_bad(int kind, unsigned long long n) {
    if (kind > 1) return 1;
    if (n == 0) return 1;
    return 0;
}
int lg_name_eq(const char *a, const char *b) {
    int i;
    if (!a || !b) return 4;
    i = 0;
    while (a[i] && a[i] == b[i]) i++;
    return a[i] == 0 && b[i] == 0;
}
int lg_addr_out(unsigned long long addr, unsigned long long lo, unsigned long long hi) {
    if (addr < lo) return 1;
    if (addr > hi) return 1;
    return 0;
}
int lg_count_fit(unsigned long long count, unsigned long long remain) {
    if (remain / 18ull < count) return 1;
    return 0;
}
int lg_page_bad(unsigned long long page, unsigned long long usable, unsigned long long size_max) {
    if (!page) return 1;
    if (usable > size_max) return 1;
    if (page > (size_max - usable) / 2ull) return 1;
    return 0;
}
int lg_gen_full(unsigned long long gen) {
    return gen == ~0ull;
}
int lg_def_nl(const char *d) {
    int i;
    if (!d) return 4;
    i = 0;
    while (d[i]) {
        if (d[i] == 10) return 1;
        i++;
    }
    return 0;
}
/* 1024 is US_LIBRARY_STACK_ARGUMENT_LIMIT. A negative count returns 4. */
int lg_frame_bad(int has_c, int has_image, int has_raw, int has_values, int has_slots, int count, int mode, int result_kind, int has_result, unsigned long long result_bytes) {
    if (count < 0 || mode < 0 || result_kind < 0) return 4;
    if (!has_c || !has_image || !has_raw || !has_values) return 1;
    if (!has_slots && count > 0) return 1;
    if (count > 1024 || mode > 1) return 1;
    if (mode == 0 && count > 6) return 1;
    if (result_kind > 6) return 1;
    if (result_kind && !has_result) return 1;
    if (result_kind == 5 && (result_bytes == 0 || result_bytes > 16777216ull)) return 1;
    if (result_kind && result_kind != 5 && result_bytes != 8) return 1;
    return 0;
}
int lg_has0(const unsigned char *b, int n) {
    int i;
    if (n < 0) return 4;
    if (n > 0 && !b) return 4;
    i = 0;
    while (i < n) {
        if (b[i] == 0) return 1;
        i++;
    }
    return 0;
}
