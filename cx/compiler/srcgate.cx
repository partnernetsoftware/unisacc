#pragma unisa module srcgate
/* Pure gates from the nine src files that had no cx module.
   No libc and no include. src/*.c stays the classic oracle.
   fopen, getenv, malloc, and the table walks stay there. */
static int sg_nlen(const char *s) {
    int n;
    n = 0;
    while (s[n]) n++;
    return n;
}
static int sg_eq(const char *a, const char *b) {
    int i;
    i = 0;
    while (a[i] && a[i] == b[i]) i++;
    return a[i] == 0 && b[i] == 0;
}
static unsigned long long sg_num2(const char *s) {
    unsigned long long v;
    int k, c, base;
    v = 0;
    k = 0;
    base = 10;
    if (k < 2 && s[k] == '-') return 0;
    if (k + 1 < 2 && s[0] == '0' && ((s[1] | 32) == 'x')) { base = 16; k = 2; }
    while (k < 2 && s[k]) {
        c = s[k] & 255;
        if (c >= 48 && c <= 57) c = c - 48;
        else if ((c | 32) >= 97 && (c | 32) <= 102) c = (c | 32) - 87;
        else break;
        v = v * (unsigned long long)base + (unsigned long long)c;
        k++;
    }
    return v;
}
int sg_relcall_add(int type) {
    if (type == 900) return -4;
    return 0;
}
int sg_relo_slot(int sizing, int objmode, unsigned long long target, unsigned long long nz, int *sect, unsigned long long *add) {
    if (sizing || objmode == 0) return 0;
    if (!sect || !add) return 4;
    if (target >= 4294967296ull - 32ull && target < 4294967296ull) return 2;
    if (target >= 34359738368ull) {
        *sect = 1000 + (int)((target - 34359738368ull) >> 20);
        *add = (target - 34359738368ull) & 1048575ull;
        return 1;
    }
    if (target >= 17179869184ull) {
        *sect = 100 + (int)((target - 17179869184ull) / 8ull);
        *add = 0;
        return 1;
    }
    if (target >= 4294967296ull) {
        target = target - 4294967296ull;
        if (target >= nz) { *sect = 3; *add = target - nz; }
        else { *sect = 2; *add = target; }
    } else { *sect = 1; *add = target; }
    return 1;
}
const char *sg_interp(int arm) {
    if (arm == 1) return "/lib/ld-linux-aarch64.so.1";
    if (arm == 0) return "/lib64/ld-linux-x86-64.so.2";
    return 0;
}
int sg_elf_machine(int arm) {
    if (arm == 1) return 183;
    if (arm == 0) return 62;
    return -1;
}
int sg_rela_type(int arm) {
    if (arm == 1) return 1025;
    if (arm == 0) return 6;
    return -1;
}
int sg_dyn_name(int i) {
    if (i == 0) return 11;
    if (i == 1) return 18;
    if (i == 2) return 24;
    if (i == 3) return 32;
    return -1;
}
unsigned int sg_rotr32(unsigned int x, int n) {
    if (n <= 0 || n >= 32) return x;
    return ((x >> n) | (x << (32 - n))) & 4294967295u;
}
int sg_elf_hdrs(int dyn) {
    if (dyn) return 784;
    return 176;
}
int sg_hex(int c) {
    if (c >= 48 && c <= 57) return c - 48;
    return (c | 32) - 87;
}
int sg_tape_space(int c) {
    return c == ' ' || c == '\t' || c == '\r';
}
int sg_tape_sep(int c) {
    return sg_tape_space(c) || c == ',' || c == '[' || c == ']';
}
int sg_regnum(const char *nm) {
    if (!nm) return 4;
    if (nm[0] == 'x') return (int)sg_num2(nm + 1);
    if (sg_eq(nm, "rax")) return 0;
    if (sg_eq(nm, "rcx")) return 1;
    if (sg_eq(nm, "rdx")) return 2;
    if (sg_eq(nm, "rbx")) return 3;
    if (sg_eq(nm, "rsp")) return 4;
    if (sg_eq(nm, "rbp")) return 5;
    if (sg_eq(nm, "rsi")) return 6;
    if (sg_eq(nm, "rdi")) return 7;
    if (sg_eq(nm, "r8")) return 8;
    if (sg_eq(nm, "r9")) return 9;
    if (sg_eq(nm, "r10")) return 10;
    if (sg_eq(nm, "r11")) return 11;
    if (sg_eq(nm, "r12")) return 12;
    if (sg_eq(nm, "r13")) return 13;
    if (sg_eq(nm, "r14")) return 14;
    if (sg_eq(nm, "r15")) return 15;
    return -1;
}
int sg_isccw(const char *p, int n) {
    if (!p || n <= 6) return 0;
    return p[0] == 95 && p[1] == 95 && p[2] == 99 && p[3] == 99 && p[4] == 119 && p[5] == 95;
}
int sg_bfenc(int width, int bofs, int ub, int sig) {
    int ul;
    ul = 0;
    if (ub == 2) ul = 1;
    if (ub == 4) ul = 2;
    if (ub == 8) ul = 3;
    return 1048576 + width + 128 * bofs + 16384 * ul + 65536 * sig;
}
int sg_bfwidth(int w) { return (w - 1048576) % 128; }
int sg_bfofs(int w) { return ((w - 1048576) / 128) % 128; }
int sg_bfunit(int w) {
    int ul;
    ul = ((w - 1048576) / 16384) % 4;
    if (ul == 0) return 1;
    if (ul == 1) return 2;
    if (ul == 2) return 4;
    return 8;
}
int sg_bfsig(int w) { return (w - 1048576) / 65536; }
int sg_isal(int c) {
    if (c >= 97 && c <= 122) return 1;
    if (c >= 65 && c <= 90) return 1;
    if (c == 95) return 1;
    return 0;
}
int sg_isdi(int c) {
    if (c >= 48 && c <= 57) return 1;
    return 0;
}
int sg_ucn_span(const char *b, int i, int e) {
    int n, k, c;
    if (!b || i + 1 >= e || (b[i] & 255) != 92) return 0;
    n = 0;
    if (b[i + 1] == 117) n = 6;
    if (b[i + 1] == 85) n = 10;
    if (n == 0 || n > e - i) return 0;
    k = 2;
    while (k < n) {
        c = b[i + k] & 255;
        if (!((c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102))) return 0;
        k++;
    }
    return n;
}
static unsigned long long sg_ucn_value(const char *b, int i, int n) {
    int k, c, d;
    unsigned long long value;
    value = 0;
    k = 2;
    while (k < n) {
        c = b[i + k] & 255;
        d = c - 48;
        if (c >= 65 && c <= 70) d = c - 55;
        if (c >= 97 && c <= 102) d = c - 87;
        value = value * 16ull + (unsigned long long)d;
        k++;
    }
    return value;
}
int sg_id_same(const char *a, int an, const char *b, int bn) {
    int i, j, n, m;
    unsigned long long av, bv;
    if ((!a && an > 0) || (!b && bn > 0)) return 4;
    i = 0;
    j = 0;
    while (i < an && j < bn) {
        n = sg_ucn_span(a, i, an);
        m = sg_ucn_span(b, j, bn);
        av = n ? sg_ucn_value(a, i, n) : (unsigned long long)(a[i] & 255);
        bv = m ? sg_ucn_value(b, j, m) : (unsigned long long)(b[j] & 255);
        if (av != bv) return 0;
        i = i + (n ? n : 1);
        j = j + (m ? m : 1);
    }
    return i == an && j == bn;
}
long sg_source_at(int count, long begin, long p, const long *origins) {
    if (count > 0 && p >= begin && p - begin < (long)count) {
        if (!origins) return -1;
        return origins[p - begin];
    }
    return p;
}
int sg_fwd_maxargs(const char *t) {
    if (t && t[0] == 119) return 4;
    return 0;
}
int sg_fwd_stop(int r1, int fwdrun, int nsrc) {
    if (r1 && (fwdrun == 0 || nsrc == 0)) return 1;
    return 0;
}
int sg_isctl(const char *w) {
    if (!w) return 0;
    return sg_eq(w, "jump") || sg_eq(w, "jumpz") || sg_eq(w, "ret");
}
int sg_islab(int first, int len, int last) {
    return first != 32 && first != 46 && len > 1 && last == 58;
}
long sg_le(const unsigned char *p, int n) {
    long v;
    int i;
    if (!p || n <= 0) return 0;
    v = 0;
    i = n - 1;
    while (i >= 0) { v = (v << 8) | (p[i] & 255); i = i - 1; }
    return v;
}
int sg_same(const char *a, const char *b, int n) {
    int i;
    if (n <= 0) return 1;
    if (!a || !b) return 4;
    i = 0;
    while (i < n) { if (a[i] != b[i]) return 0; i++; }
    return 1;
}
int sg_target_id(const char *target) {
    if (!target) return 4;
    if (sg_eq(target, "lnx/x86_64")) return 1;
    if (sg_eq(target, "lnx/arm64")) return 2;
    if (sg_eq(target, "osx/x86_64")) return 3;
    if (sg_eq(target, "osx/arm64")) return 4;
    if (sg_eq(target, "win/x86_64")) return 5;
    if (sg_eq(target, "win/arm64")) return 6;
    return 0;
}
int sg_space(int c) {
    return c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12;
}
int sg_namechar(int c, int first) {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || (!first && ((c >= 48 && c <= 57) || c == 46 || c == 36));
}
int sg_validname(const char *s, int n) {
    int i;
    if (!s || n < 1) return 0;
    for (i = 0; i < n; i++) if (!sg_namechar(s[i] & 255, i == 0)) return 0;
    return 1;
}
