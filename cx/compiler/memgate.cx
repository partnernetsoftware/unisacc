#pragma unisa module memgate
/* Map and protect choices from exec/c/memory.c. mmap, VirtualAlloc,
   mprotect, and die stay in that file. plat 0 is host POSIX, 1 is host
   Windows, 2 is UNISA Linux, 3 is UNISA other, 4 is UNISA Windows.
   Host plats return 2 and write nothing: those prots are C macros.
   An unknown plat or a null out returns 4. That 4 was not on the old
   path. A zero UNISA prot is a real value, so success is the return
   0 and the number is written to out. */
static int mm_lit(int plat, int *out, int value, int host) {
    if (!out) return 4;
    if (plat < 0 || plat > 4) return 4;
    if (host) return 2;
    *out = value;
    return 0;
}
int mm_reserve_size(void) {
    return 2147467264;
}
int mm_map_api(int plat) {
    if (plat < 0 || plat > 4) return 4;
    if (plat == 1) return 1;
    return 0;
}
int mm_map_prot(int plat, int *out) {
    if (plat == 4) return mm_lit(plat, out, 12288, 0);
    if (plat == 2 || plat == 3) return mm_lit(plat, out, 3, 0);
    return mm_lit(plat, out, 0, 1);
}
int mm_map_flags(int plat, int *out) {
    if (plat == 4) return mm_lit(plat, out, 4, 0);
    if (plat == 2) return mm_lit(plat, out, 34, 0);
    if (plat == 3) return mm_lit(plat, out, 4098, 0);
    return mm_lit(plat, out, 0, 1);
}
int mm_map_fd(int plat, int *out) {
    if (plat == 4) return mm_lit(plat, out, 0, 0);
    if (plat == 2 || plat == 3 || plat == 0) return mm_lit(plat, out, 0 - 1, 0);
    return mm_lit(plat, out, 0, 1);
}
int mm_reserve_prot(int plat, int *out) {
    if (plat == 4) return mm_lit(plat, out, 8192, 0);
    if (plat == 2 || plat == 3) return mm_lit(plat, out, 0, 0);
    return mm_lit(plat, out, 0, 1);
}
int mm_reserve_flags(int plat, int *out) {
    if (plat == 4) return mm_lit(plat, out, 1, 0);
    if (plat == 2) return mm_lit(plat, out, 34, 0);
    if (plat == 3) return mm_lit(plat, out, 4098, 0);
    return mm_lit(plat, out, 0, 1);
}
int mm_commit_prot(int plat, int *out) {
    if (plat == 4) return mm_lit(plat, out, 4096, 0);
    if (plat == 2 || plat == 3) return mm_lit(plat, out, 3, 0);
    return mm_lit(plat, out, 0, 1);
}
int mm_protect_prot(int plat, int *out) {
    if (plat == 4) return mm_lit(plat, out, 32, 0);
    if (plat == 2 || plat == 3) return mm_lit(plat, out, 5, 0);
    return mm_lit(plat, out, 0, 1);
}
int mm_base_bad(int allones, int isnull) {
    if (allones < 0 || isnull < 0) return 4;
    if (allones || isnull) return 1;
    return 0;
}
int mm_layout_same(int text, int plan_text, int extent, int plan_extent, int entry, int plan_entry) {
    if (text != plan_text) return 1;
    if (extent != plan_extent) return 1;
    if (entry != plan_entry) return 1;
    return 0;
}
int mm_commit_over(long long size, long long reserved) {
    if (size > reserved) return 1;
    return 0;
}
int mm_copy_at(int text) {
    if (text < 0) return 4;
    return 40 + text;
}
