#pragma unisa module bindsym
/* Symbol-stream name, diagnostic refusals, forward want, and the
   non-Linux object-route gate from exec/c/compiler.c. No libc and
   no include. host_same_output, clierror, host_stage_present,
   unpackage, and fwd_set_maxargs stay in C. */
static int bx_nz(int v) {
    return v != 0;
}
static int bx_pre(const char *s, const char *p) {
    int i;
    for (i = 0; i < 4; i++) if (s[i] != p[i]) return 0;
    return 1;
}
int bx_sym_out(const char *out, int mode, int explicit_image, int runit,
               const char **chosen) {
    if (out || mode || explicit_image || runit) return 2;
    if (!chosen) return 4;
    *chosen = "a.out";
    return 1;
}
int bx_diag_opt(const char *symbols, const char *provider, int host_target,
                int mode, int emitbin, int asmwant) {
    if (!symbols && !provider) return 0;
    if (!host_target || mode == 1 || mode == 4 || mode == 5 || bx_nz(emitbin) || bx_nz(asmwant))
        return 1;
    return 0;
}
int bx_diag_run(const char *path, int runit) {
    if (!path) return 0;
    if (bx_nz(runit) || (path[0] == '-' && path[1] == 0)) return 1;
    return 0;
}
const char *bx_same_why(int same, int kind) {
    if (same > 0 && kind == 0) return "bind: symbol-stream and output are the same path";
    if (same > 0 && kind == 1) return "bind: symbol-stream and dependency output are the same path";
    if (same < 0) return "bind: cannot-check-symbol-stream path";
    return 0;
}
int bx_sym_need(int host_target, int mode, const char *path) {
    if (!host_target) return 0;
    if (mode == 0 || mode == 3 || path) return 1;
    return 0;
}
int bx_fwd_want(int runit, int mode, int second, int tape, int linking, const char *target) {
    if (!bx_nz(runit) && mode != 0) return 0;
    if (bx_nz(second) || bx_nz(tape) || bx_nz(linking)) return 0;
    if (!target) return 4;
    if (bx_pre(target, "osx/") || bx_pre(target, "lnx/") || bx_pre(target, "win/")) return 1;
    return 0;
}
int bx_fwd_maxargs(const char *target, int *out) {
    if (!target || !out) return 4;
    *out = bx_pre(target, "win/") ? 4 : 0;
    return 0;
}
int bx_obj_foreign(int objwant, const char *target) {
    if (!bx_nz(objwant)) return 0;
    if (!target) return 4;
    if (bx_pre(target, "lnx/")) return 0;
    return 1;
}
int bx_obj_route(int lower, int encoder) {
    if (bx_nz(lower) && bx_nz(encoder)) return 0;
    return 1;
}
