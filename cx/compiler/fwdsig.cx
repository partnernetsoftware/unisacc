#pragma unisa module fwdsig
/* USLSIG3 / callback-graph decode. No libc and no include.
   The driver keeps the side-car refusal strings. Truncation returns 1.
   long long is 8 bytes on LP64 and LLP64. No file-scope object. */
typedef struct {
    int kind;
    int width, uns, ptr, depth, isvoid, structbyval;
    unsigned long long base;
    const unsigned char *callback;
    unsigned long long callback_len;
} USForwardType;
typedef struct {
    int variadic, structbyval, n;
    USForwardType ret, args[33];
} USForwardSig;
typedef struct { int n; USForwardType ret, args[8]; } USForwardCallback;

static int fw_bytes(const unsigned char *a, const char *b, int n) {
    int i;
    for (i = 0; i < n; i++) if (a[i] != (unsigned char)b[i]) return 0;
    return 1;
}
static void fw_clear(USForwardType *t) {
    t->kind = 0; t->width = 0; t->uns = 0; t->ptr = 0; t->depth = 0;
    t->isvoid = 0; t->structbyval = 0; t->base = 0; t->callback = 0; t->callback_len = 0;
}
int us_fw_u64(const unsigned char *b, unsigned long long n, unsigned long long *at, unsigned long long *v) {
    int i;
    if (*at > n || n - *at < 8) return 1;
    *v = 0;
    for (i = 0; i < 8; i++) *v |= (unsigned long long)b[*at + i] << (8 * i);
    *at += 8;
    return 0;
}
static int us_fw_type(const unsigned char *b, unsigned long long n, unsigned long long *at, USForwardType *t, int result) {
    unsigned long long depth, base, shape, kind, width, uns, alignment, natural, payload;
    unsigned tag, fp_rank, fp_format, flags, known, origin;
    if (us_fw_u64(b, n, at, &depth) || us_fw_u64(b, n, at, &base) ||
        us_fw_u64(b, n, at, &shape) || us_fw_u64(b, n, at, &kind) ||
        us_fw_u64(b, n, at, &width) || us_fw_u64(b, n, at, &uns) ||
        us_fw_u64(b, n, at, &alignment) || n - *at < 2) return 1;
    fp_rank = b[(*at)++]; fp_format = b[(*at)++];
    if (us_fw_u64(b, n, at, &natural) || n - *at < 4) return 1;
    flags = b[(*at)++]; known = b[(*at)++]; origin = b[(*at)++];
    tag = b[(*at)++];
    if (us_fw_u64(b, n, at, &payload) || payload > n - *at || payload > 16777216 ||
        uns > 1 || depth > 1024 || kind > 6 || width > 16777216 || tag > 5 ||
        fp_rank > 3 || fp_format > 4 || flags > 3 || known > 3 || origin > 2 ||
        (flags & ~known) || natural > 65536 || alignment > 65536 ||
        (alignment && (alignment & (alignment - 1))) ||
        (natural && (natural & (natural - 1)))) return 1;
    (void)shape;
    fw_clear(t);
    t->width = (int)width; t->uns = (int)uns; t->ptr = depth != 0; t->depth = (int)depth; t->base = base;
    if (kind == 0 && result && !depth && !width && !payload) t->isvoid = 1;
    else if (kind == 1 && !depth && !payload && tag == 0 &&
             (width == 1 || width == 2 || width == 4 || width == 8)) t->kind = 0;
    else if (kind == 2 && depth && width == 8 && (tag == 0 || tag == 5) &&
             (tag == 5 || !payload)) t->kind = 1;
    else if (kind == 4 && depth == 1 && width == 8 && tag == 4 && payload >= 20) {
        t->kind = 1; t->callback = b + *at; t->callback_len = payload;
    }
    else if (kind == 3 && !depth && !payload && tag == 0 &&
             (width == 4 || width == 8)) t->kind = width == 4 ? 4 : 8;
    else if (kind == 5 && !depth && (tag == 1 || tag == 2 || tag == 3)) t->structbyval = 1;
    else return 1;
    *at += payload;
    return 0;
}
int us_forward_callback_decode(const USForwardType *t, USForwardCallback *out) {
    const unsigned char *b; unsigned long long n, at, id, np, stored;
    unsigned variadic, mode; int i;
    if (!t || !t->callback || !out || t->callback_len < 20) return 1;
    b = t->callback; n = t->callback_len; at = 0;
    if (b[at++] != 1 || b[at++] != 0) return 1;
    if (us_fw_u64(b, n, &at, &id) || id == 0 || id > 1024 || n - at < 2) return 1;
    variadic = b[at++]; mode = b[at++];
    if (variadic || mode || us_fw_u64(b, n, &at, &np) || np > 8 ||
        us_fw_type(b, n, &at, &out->ret, 1) ||
        us_fw_u64(b, n, &at, &stored) || stored != np) return 1;
    out->n = (int)np;
    for (i = 0; i < out->n; i++) if (us_fw_type(b, n, &at, &out->args[i], 0)) return 1;
    return at + 1 == n && b[at] == 0 ? 0 : 1;
}
int us_forward_sig_decode(const unsigned char *b, unsigned long long n,
                          const char *name, unsigned long long namelen, USForwardSig *out) {
    unsigned long long at = 8, count, inner_name, np, stored;
    USForwardSig tmp;
    int i;
    unsigned long long k;
    if (!b || !name || !out || n < 16 || !fw_bytes(b, "USLSIG3\n", 8) ||
        us_fw_u64(b, n, &at, &count) || count != 1 ||
        us_fw_u64(b, n, &at, &inner_name) || inner_name != namelen ||
        inner_name > n - at) return 1;
    for (k = 0; k < namelen; k++) if (b[at + k] != (unsigned char)name[k]) return 1;
    at += namelen;
    if (n - at < 4 || b[at] != 0 || b[at + 1] != 1 || b[at + 2] > 1 || b[at + 3] > 1) return 1;
    tmp.variadic = b[at + 2]; tmp.structbyval = 0; tmp.n = 0;
    fw_clear(&tmp.ret);
    for (i = 0; i < 33; i++) fw_clear(&tmp.args[i]);
    at += 4;
    if (us_fw_u64(b, n, &at, &np) || np > 33 || us_fw_type(b, n, &at, &tmp.ret, 1) ||
        us_fw_u64(b, n, &at, &stored) || stored != np) return 1;
    tmp.n = (int)np; tmp.structbyval = tmp.ret.structbyval;
    for (i = 0; i < tmp.n; i++) {
        if (us_fw_type(b, n, &at, &tmp.args[i], 0)) return 1;
        tmp.structbyval |= tmp.args[i].structbyval;
    }
    if (at >= n || b[at++] != 0 || at != n) return 1;
    *out = tmp;
    return 0;
}
/* Scalar C spelling and the callback declarator. No libc and no include.
   us_forward_callback_decode stays the byte reader. */
const char *fw_simple_type(int isvoid, int has_callback, int structbyval,
                           int kind, int depth, unsigned long long base,
                           int width, int uns) {
    if (isvoid) return "void";
    if (has_callback || structbyval) return 0;
    if (kind == 1) {
        if (depth != 1) return 0;
        if (base == 0) return "void *";
        if (base == 1) return "char *";
        if (base == 2) return "short *";
        if (base == 4) return "int *";
        if (base == 8) return "long *";
        return 0;
    }
    if (kind == 4) return "float";
    if (kind == 8) return "double";
    if (kind == 0) {
        if (width == 1) return uns ? "unsigned char" : "signed char";
        if (width == 2) return uns ? "unsigned short" : "short";
        if (width == 4) return uns ? "unsigned int" : "int";
        if (width == 8) return uns ? "unsigned long" : "long";
    }
    return 0;
}
static int fw_len(const char *s) {
    int n;
    n = 0;
    while (s[n]) n++;
    return n;
}
static int fw_digits(int v, char *buf) {
    char tmp[16];
    int n, i, neg;
    unsigned int u;
    neg = 0;
    if (v < 0) {
        neg = 1;
        u = (unsigned int)(-(v + 1)) + 1;
    } else u = (unsigned int)v;
    n = 0;
    if (u == 0) { tmp[n] = '0'; n = 1; }
    while (u) { tmp[n] = (char)('0' + (u % 10)); n++; u = u / 10; }
    i = 0;
    if (neg) { buf[i] = '-'; i++; }
    while (n) { n--; buf[i] = tmp[n]; i++; }
    return i;
}
static void fw_put(char *out, int *at, const char *s) {
    int i;
    i = 0;
    while (s[i]) { out[*at] = s[i]; *at = *at + 1; i++; }
}
static int fw_need(int *need, int more) {
    if (more < 0 || *need < 0 || more > 2147483647 - *need) return 1;
    *need = *need + more;
    return 0;
}
int fw_decl(const char *ret, int index, const char *const *args, int n, char *out, int cap) {
    int i, need, at, dlen;
    char dec[16];
    if (!ret || !out || cap < 1 || n < 0) return 4;
    if (n > 0 && !args) return 4;
    for (i = 0; i < n; i++) if (!args[i]) return 4;
    dlen = fw_digits(index, dec);
    need = 0;
    if (fw_need(&need, fw_len(ret)) || fw_need(&need, 4) || fw_need(&need, dlen) || fw_need(&need, 2)) return 1;
    if (n == 0 && fw_need(&need, 4)) return 1;
    for (i = 0; i < n; i++) {
        if (i && fw_need(&need, 2)) return 1;
        if (fw_need(&need, fw_len(args[i]))) return 1;
    }
    if (fw_need(&need, 1)) return 1;
    if (need >= cap) return 1;
    at = 0;
    fw_put(out, &at, ret);
    fw_put(out, &at, " (*a");
    for (i = 0; i < dlen; i++) { out[at] = dec[i]; at++; }
    fw_put(out, &at, ")(");
    if (n == 0) fw_put(out, &at, "void");
    for (i = 0; i < n; i++) {
        if (i) fw_put(out, &at, ", ");
        fw_put(out, &at, args[i]);
    }
    out[at] = ')';
    at++;
    out[at] = 0;
    return 0;
}
int fw_side_head(const unsigned char *b, unsigned long long n) {
    if (n < 7) return 1;
    if (!b) return 4;
    if (b[0] == 'U' && b[1] == 'S' && b[2] == 'L' && b[3] == 'F' && b[4] == 'W' && b[5] == '1' && b[6] == '\n') return 0;
    return 1;
}
int fw_side_bad(unsigned long long ccwc, unsigned long long tl, unsigned long long n, unsigned long long at) {
    if (ccwc > 256) return 1;
    if (tl > n - at) return 1;
    return 0;
}
const char *fw_side_why(int kind) {
    if (kind == 0) return "unisacc: error: forwarding side-car missing\n";
    if (kind == 1) return "unisacc: error: forwarding side-car malformed\n";
    return 0;
}
int fw_undef(int bad, int structbyval, int ret_struct, int n) {
    if (bad || structbyval || ret_struct || n > 32) return 1;
    return 0;
}
int fw_emit_miss(int emitted) {
    if (emitted) return 0;
    return 1;
}
int fw_undef_line(const char *name, int n, char *out, int cap) {
    int i, need, at, plen;
    const char *pre;
    pre = "unisacc: error: undefined function '";
    if (!out || cap < 1 || n < 0) return 4;
    if (n > 0 && !name) return 4;
    plen = fw_len(pre);
    need = 0;
    if (fw_need(&need, plen) || fw_need(&need, n) || fw_need(&need, 2)) return 1;
    if (need >= cap) return 1;
    at = 0;
    fw_put(out, &at, pre);
    for (i = 0; i < n; i++) { out[at] = name[i]; at++; }
    out[at] = '\'';
    at++;
    out[at] = '\n';
    at++;
    out[at] = 0;
    return 0;
}

/* A side-car name is a link error when the primary source itself prototypes
   it and never defines it. A call whose declaration arrives only from a
   header stays a host forward: that declaration is not in this file.
   Only a declarator at brace depth 0 counts. The span has already taken
   the input buffer, so the source is read again from its path. */
static int uu_id(int c) {
    if (c >= 'A' && c <= 'Z') return 1;
    if (c >= 'a' && c <= 'z') return 1;
    if (c == '_') return 1;
    if (c >= '0' && c <= '9') return 1;
    return 0;
}
static int uu_sp(int c) {
    if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f') return 1;
    return 0;
}
static int uu_role(const char *s, long n, const char *name, int nl) {
    long i;
    int depth, proto, defn;
    i = 0;
    depth = 0;
    proto = 0;
    defn = 0;
    while (i < n) {
        char c;
        c = s[i];
        if (c == '/' && i + 1 < n && s[i + 1] == '/') {
            while (i < n && s[i] != '\n') i++;
            continue;
        }
        if (c == '/' && i + 1 < n && s[i + 1] == '*') {
            i += 2;
            while (i + 1 < n && !(s[i] == '*' && s[i + 1] == '/')) i++;
            if (i + 1 < n) i += 2;
            else i = n;
            continue;
        }
        if (c == '"' || c == '\'') {
            char q;
            q = c;
            i++;
            while (i < n && s[i] != q) {
                if (s[i] == '\\' && i + 1 < n) i += 2;
                else if (s[i] == '\n') break;
                else i++;
            }
            if (i < n && s[i] == q) i++;
            continue;
        }
        if (c == '{') { depth++; i++; continue; }
        if (c == '}') { if (depth) depth--; i++; continue; }
        if (depth == 0 && uu_id((unsigned char)c)) {
            long st, j;
            int match, k, par, word;
            st = i;
            while (i < n && uu_id((unsigned char)s[i])) i++;
            match = (i - st == (long)nl);
            k = 0;
            while (match && k < nl) {
                if (s[st + k] != name[k]) match = 0;
                k++;
            }
            if (!match) continue;
            j = i;
            while (j < n && uu_sp((unsigned char)s[j])) j++;
            if (j >= n || s[j] != '(') continue;
            par = 0;
            while (j < n) {
                char d;
                d = s[j];
                if (d == '"' || d == '\'' || (d == '/' && j + 1 < n && (s[j + 1] == '/' || s[j + 1] == '*'))) break;
                if (d == '(') { par++; j++; continue; }
                if (d == ')') { par--; j++; if (par == 0) break; continue; }
                j++;
            }
            if (par != 0) continue;
            word = 0;
            while (j < n) {
                char d;
                d = s[j];
                if (d == '/' && j + 1 < n && s[j + 1] == '/') {
                    while (j < n && s[j] != '\n') j++;
                    continue;
                }
                if (d == '/' && j + 1 < n && s[j + 1] == '*') {
                    j += 2;
                    while (j + 1 < n && !(s[j] == '*' && s[j + 1] == '/')) j++;
                    if (j + 1 < n) j += 2;
                    else j = n;
                    continue;
                }
                if (uu_sp((unsigned char)d)) {
                    if (d == '\n' && word) break;
                    j++;
                    continue;
                }
                if (d == '(') {
                    par = 1;
                    j++;
                    while (j < n && par) {
                        if (s[j] == '(') par++;
                        else if (s[j] == ')') par--;
                        j++;
                    }
                    continue;
                }
                if (d == ';' || d == ',') { proto = 1; break; }
                if (d == '{') { defn = 1; break; }
                if (uu_id((unsigned char)d)) {
                    word = 1;
                    while (j < n && uu_id((unsigned char)s[j])) j++;
                    continue;
                }
                j++;
            }
            continue;
        }
        i++;
    }
    if (defn) return 2;
    if (proto) return 1;
    return 0;
}
static void uu_say(const char *name, int nl) {
    char msg[1200];
    const char *pre;
    int k, i;
    int sy_write_all(int, const void *, long);
    pre = "link: undefined reference to ";
    k = 0;
    while (pre[k] && k < 1100) { msg[k] = pre[k]; k++; }
    i = 0;
    while (i < nl && k < 1196) { msg[k] = name[i]; k++; i++; }
    msg[k] = '\n';
    k++;
    sy_write_all(2, msg, (long)k);
}
int uu_user_undef(const char *src, const unsigned char *b, unsigned long long n,
                  unsigned long long at, unsigned long long cnt, char *why, int cap) {
    char *text;
    long sz, tn;
    int fd;
    unsigned long long r;
    int sy_open_read(const char *);
    long sy_reg_size(int);
    int sy_read_full(int, void *, long);
    int sy_close(int);
    void *mm_alloc(long);
    void mm_free(void *);
    if (!src || !src[0] || (src[0] == '-' && src[1] == 0) || !b) return 0;
    fd = sy_open_read(src);
    if (fd < 0) return 0;
    sz = sy_reg_size(fd);
    if (sz < 0 || sz > 1048576L) { sy_close(fd); return 0; }
    text = (char *)mm_alloc(sz + 1);
    if (!text) { sy_close(fd); return 0; }
    if (sz > 0 && sy_read_full(fd, text, sz)) { sy_close(fd); mm_free(text); return 0; }
    sy_close(fd);
    text[sz] = 0;
    tn = sz;
    r = 0;
    while (r < cnt) {
        unsigned long long nl, sl;
        const char *nm;
        int role;
        if (us_fw_u64(b, n, &at, &nl) || nl > 1024 || nl > n - at) { mm_free(text); return 0; }
        nm = (const char *)(b + at);
        at += nl;
        if (us_fw_u64(b, n, &at, &sl) || sl > n - at) { mm_free(text); return 0; }
        at += sl;
        if (nl > 0 && nl <= 1024) {
            role = uu_role(text, tn, nm, (int)nl);
            if (role == 1) {
                uu_say(nm, (int)nl);
                if (why && cap > 0) why[0] = 0;
                mm_free(text);
                return 1;
            }
        }
        r++;
    }
    mm_free(text);
    return 0;
}
