#pragma unisa module frontpp
#pragma unisa use srcgate
/* Pure judgments from src/front_pp.c. No libc and no include.
   sg_isal, sg_isdi, sg_ucn_span, sg_id_same, and sg_source_at stay in srcgate.
   malloc, FILE, the macro table, and expansion stay in front_pp.c. */
static unsigned long long pp_uval(const char *b, int i, int n) {
    int k, c, d;
    unsigned long long value;
    value = 0;
    k = 2;
    while (k < n) {
        c = b[i + k] & 255;
        d = c - 48;
        if (c >= 65 && c <= 70) d = c - 55;
        if (c >= 97 && c <= 102) d = c - 87;
        value = value * 16ull + (unsigned long long)d;
        k = k + 1;
    }
    return value;
}
static int pp_at(const char *s, int n, int i) {
    if (i < 0 || i >= n) return -1;
    return s[i] & 255;
}
int pp_wsc(int c) {
    if (c == 32) return 1;
    if (c == 9) return 1;
    if (c == 10) return 1;
    return 0;
}
int pp_wsat(int c) {
    if (c == 32) return 1;
    if (c == 9) return 1;
    return 0;
}
int pp_skip_ws(const char *s, int i, int n) {
    if (!s) return 4;
    while (i < n) {
        if (s[i] != 32 && s[i] != 9) {
            if ((s[i] & 255) != 10) break;
        }
        i = i + 1;
    }
    return i;
}
int pp_ishex(int c) {
    if (c >= 48 && c <= 57) return 1;
    if (c >= 97 && c <= 102) return 1;
    if (c >= 65 && c <= 70) return 1;
    return 0;
}
int pp_hexv(int c) {
    if (c >= 48 && c <= 57) return c - 48;
    if (c >= 97 && c <= 102) return c - 87;
    if (c >= 65 && c <= 70) return c - 55;
    return -1;
}
int pp_idch(int c) {
    if (sg_isal(c)) return 1;
    return sg_isdi(c);
}
int pp_id_chars(const char *s, int n) {
    int at, count, width;
    if (!s) return 4;
    at = 0;
    count = 0;
    if (n < 0) n = 0;
    while (at < n) {
        width = sg_ucn_span(s, at, n);
        at = at + (width ? width : 1);
        count = count + 1;
    }
    return count;
}
int pp_name_long(const char *s, int n) {
    int count;
    if (!s) return 4;
    if (n < 0) n = 0;
    count = pp_id_chars(s, n);
    if (n < 640 && count <= 63) return 0;
    return 1;
}
int pp_id_end(const char *b, int i, int e) {
    int j, n, c;
    if (!b) return 4;
    j = i;
    while (j < e) {
        c = b[j] & 255;
        if (sg_isal(c) || (j > i && sg_isdi(c))) { j = j + 1; continue; }
        n = sg_ucn_span(b, j, e);
        if (n == 0) break;
        j = j + n;
    }
    return j;
}
int pp_mac_hash(const char *s, int n) {
    int i, h, u;
    unsigned long long value;
    if (!s) return 4;
    h = 131;
    i = 0;
    if (n < 0) n = 0;
    while (i < n) {
        u = sg_ucn_span(s, i, n);
        value = u ? pp_uval(s, i, u) : (unsigned long long)(s[i] & 255);
        h = (h * 31 + (int)(value & 16777215ull)) & 16777215;
        i = i + (u ? u : 1);
    }
    h = h & 8191;
    if (h < 0) h = 0 - h;
    return h;
}
int pp_mac_is(const char *slot, const char *s, int n) {
    int k;
    if (!slot || !s) return 4;
    k = 0;
    while (slot[k]) k = k + 1;
    return sg_id_same(slot, k, s, n);
}
int pp_vhash(const char *s, int n) {
    int h, k;
    if (!s) return 4;
    if (n < 0) n = 0;
    h = n;
    k = 0;
    while (k < n) { h = (h * 31 + (s[k] & 255)) & 16777215; k = k + 1; }
    return h & 4095;
}
int pp_vsame(const char *v, int p, const char *s, int slen) {
    int k;
    if (!v || !s) return 4;
    k = 0;
    while (k < slen) {
        if (v[p + k] != s[k]) return 0;
        if (v[p + k] == 0) return 0;
        k = k + 1;
    }
    return v[p + k] == 0;
}
int pp_span_eq(const char *a, int L, const char *nm) {
    int k;
    if (!a || !nm) return 4;
    k = 0;
    while (k < L) {
        if (nm[k] == 0) return 0;
        if ((a[k] & 255) != (nm[k] & 255)) return 0;
        k = k + 1;
    }
    if (nm[L] != 0) return 0;
    return 1;
}
int pp_num_ok(const char *s, int n) {
    int q, digits, isfloat, hasdot, octbad, firstzero, c, uns;
    if (!s) return 4;
    if (n < 0) n = 0;
    q = 0;
    digits = 0;
    isfloat = 0;
    hasdot = 0;
    octbad = 0;
    firstzero = pp_at(s, n, q) == 48;
    if (firstzero && (pp_at(s, n, q + 1) == 120 || pp_at(s, n, q + 1) == 88)) {
        q = q + 2;
        while (q < n && pp_ishex(pp_at(s, n, q))) { q = q + 1; digits = digits + 1; }
        if (q < n && pp_at(s, n, q) == 46) {
            hasdot = 1;
            q = q + 1;
            while (q < n && pp_ishex(pp_at(s, n, q))) { q = q + 1; digits = digits + 1; }
        }
        if (digits == 0) return 0;
        if (q < n && (pp_at(s, n, q) == 112 || pp_at(s, n, q) == 80)) {
            isfloat = 1;
            q = q + 1;
            if (q < n && (pp_at(s, n, q) == 43 || pp_at(s, n, q) == 45)) q = q + 1;
            digits = 0;
            while (q < n && sg_isdi(pp_at(s, n, q))) { q = q + 1; digits = digits + 1; }
            if (digits == 0) return 0;
        } else if (hasdot) return 0;
    } else {
        while (q < n && sg_isdi(pp_at(s, n, q))) {
            if (firstzero && pp_at(s, n, q) >= 56) octbad = 1;
            q = q + 1;
            digits = digits + 1;
        }
        if (q < n && pp_at(s, n, q) == 46) {
            isfloat = 1;
            q = q + 1;
            while (q < n && sg_isdi(pp_at(s, n, q))) { q = q + 1; digits = digits + 1; }
        }
        if (digits == 0) return 0;
        if (q < n && (pp_at(s, n, q) == 101 || pp_at(s, n, q) == 69)) {
            isfloat = 1;
            q = q + 1;
            if (q < n && (pp_at(s, n, q) == 43 || pp_at(s, n, q) == 45)) q = q + 1;
            digits = 0;
            while (q < n && sg_isdi(pp_at(s, n, q))) { q = q + 1; digits = digits + 1; }
            if (digits == 0) return 0;
        }
        if (isfloat == 0 && octbad) return 0;
    }
    if (isfloat) {
        if (q < n && (pp_at(s, n, q) == 102 || pp_at(s, n, q) == 70 || pp_at(s, n, q) == 108 || pp_at(s, n, q) == 76)) q = q + 1;
        return q == n;
    }
    uns = 0;
    if (q < n && (pp_at(s, n, q) == 117 || pp_at(s, n, q) == 85)) { uns = 1; q = q + 1; }
    if (q < n && (pp_at(s, n, q) == 108 || pp_at(s, n, q) == 76)) {
        c = pp_at(s, n, q);
        q = q + 1;
        if (q < n && pp_at(s, n, q) == c) q = q + 1;
    }
    if (uns == 0 && q < n && (pp_at(s, n, q) == 117 || pp_at(s, n, q) == 85)) q = q + 1;
    return q == n;
}
int pp_lead_dec(const char *s, int i, int e, int *out) {
    int v;
    if (!s || !out) return 4;
    if (i < 0 || i >= e || !sg_isdi(s[i] & 255)) { *out = 0; return 0; }
    v = 0;
    while (i < e && sg_isdi(s[i] & 255)) {
        v = v * 10 + ((s[i] & 255) - 48);
        i = i + 1;
    }
    *out = v;
    return 1;
}
int pp_lt(long a, long b, int u) {
    unsigned long ua, ub;
    if (u) {
        ua = (unsigned long)a;
        ub = (unsigned long)b;
        if (ua < ub) return 1;
        return 0;
    }
    if (a < b) return 1;
    return 0;
}
int pp_div0(long b, int skip) {
    if (b == 0 && skip == 0) return 1;
    return 0;
}
int pp_cond_live(const int *take, int n) {
    int k, live;
    if (!take) return 4;
    if (n < 0) n = 0;
    live = 1;
    k = 0;
    while (k < n) {
        if (take[k] == 0) live = 0;
        k = k + 1;
    }
    return live;
}
int pp_cond_outer(const int *take, const int *seen, int n) {
    int ol, k;
    if (!take || !seen) return 4;
    ol = 0;
    if (n > 0 && seen[n - 1] == 0) {
        ol = 1;
        k = 0;
        while (k < n - 1) {
            if (take[k] == 0) ol = 0;
            k = k + 1;
        }
    }
    return ol;
}
int pp_cond_take(int act, int live) {
    if (act == 0 && live) return 1;
    return 0;
}
int pp_cond_else(int act, int seen) {
    if (act == 0 && seen == 0) return 1;
    return 0;
}
int pp_cond_pop(int act, int depth) {
    if (act == 2 && depth > 0) return 1;
    return 0;
}
int pp_nest_full(int depth) {
    if (depth >= 64) return 1;
    return 0;
}
/* 未知种类返回 -1，不是旧返回。 */
int pp_dir_act(int d, int on) {
    int take;
    take = on == 1;
    if (d == 5) return 2;
    if (d == 6 || d == 7 || d == 8) return 3;
    if (d == 0) return take ? 0 : 1;
    if (d == 1) return take ? 1 : 0;
    if (d == 2 || d == 3 || d == 4) return take ? 0 : 1;
    return -1;
}
/* 未知种类返回 2，不是旧返回。 */
int pp_stack_op(int d) {
    if (d >= 0 && d < 3) return 0;
    if (d == 3) return 1;
    if (d == 4) return 3;
    if (d == 5) return 4;
    if (d == 6 || d == 7 || d == 8) return 5;
    return 2;
}
/* 未知种类返回 2，不是旧返回。 */
int pp_ucn_gate(int kind, int initial, int span) {
    if (kind == 0) return -2;
    if (initial && kind == 2) return -3;
    if (kind == 1 || kind == 2) return span;
    return 2;
}
int pp_hs_has(const int *mem, const int *nxt, int h, int m) {
    if (!mem || !nxt) return 4;
    while (h) {
        if (mem[h] == m) return 1;
        h = nxt[h];
    }
    return 0;
}
/* 空指针、负下标或负长度返回 4。pp_ucn_value 在这些情况下返回 0 并且不读。
   0 也是真实标量。累加与 src/front_pp.c 的 pp_ucn_value 相同。 */
int pp_ucn_null(const char *b, int i, int n) {
    if (!b || i < 0 || n < 0) return 4;
    return 0;
}
unsigned long long pp_ucn_value(const char *b, int i, int n) {
    if (!b || i < 0 || n < 0) return 0;
    return pp_uval(b, i, n);
}
/* 1 表示旧 lex_ucnlen 因标量范围返回 -1。不是旧返回。 */
int pp_ucn_bad(unsigned long long v) {
    if (v > 1114111ull) return 1;
    if (v >= 55296ull && v <= 57343ull) return 1;
    if (v < 160ull && v != 36ull && v != 64ull && v != 96ull) return 1;
    return 0;
}
/* 与 lex_ucn_reason 三句相同。其它 code 也是第三句。 */
const char *pp_ucn_why(int code) {
    if (code == 0 - 2) return "universal character name not permitted in identifier";
    if (code == 0 - 3) return "universal character name digit cannot start identifier";
    return "invalid universal character name";
}
/* 空指针返回 0，这不是旧 pp_ucn_span 的崩溃。其余与 sg_ucn_span 相同。 */
int pp_ucn_span(const char *b, int i, int e) {
    return sg_ucn_span(b, i, e);
}
/* 命中返回该行的种类。扫完返回 0。空表或负条数返回 4，不是旧返回。
   行是 lo, hi, kind 连续三项。 */
int pp_ucn_kind(int c, const unsigned short *row, int n) {
    int i;
    if (!row || n < 0) return 4;
    i = 0;
    while (i < n) {
        if (c >= row[i * 3] && c <= row[i * 3 + 1]) return row[i * 3 + 2];
        i = i + 1;
    }
    return 0;
}
/* C99 phase 2. dst may be src. cap must be at least n.
   0 writes *outn. 1 means cap < n and writes nothing.
   4 is a null or a negative length. A backslash-newline, or
   backslash-CR-LF, is deleted. Line numbers are not recorded. */
int pp_splice(const char *src, int n, char *dst, int cap, int *outn) {
    int i;
    int j;
    int c;
    if (!outn || n < 0 || cap < 0) return 4;
    if (n > 0 && (!src || !dst)) return 4;
    if (n > cap) return 1;
    i = 0;
    j = 0;
    while (i < n) {
        c = src[i] & 255;
        if (c == 92 && i + 1 < n && (src[i + 1] & 255) == 10) {
            i = i + 2;
            continue;
        }
        if (c == 92 && i + 2 < n && (src[i + 1] & 255) == 13 && (src[i + 2] & 255) == 10) {
            i = i + 3;
            continue;
        }
        dst[j] = src[i];
        j = j + 1;
        i = i + 1;
    }
    *outn = j;
    return 0;
}
/* C99 phase 3. dst may be src. cap must be at least n.
   A comment becomes one space. A block comment keeps its newlines.
   0 writes *outn. 1 means cap < n and writes nothing.
   2 is an unclosed block comment; *outn stays unchanged.
   4 is a null or a negative length. */
int pp_decomment(const char *src, int n, char *dst, int cap, int *outn) {
    int i;
    int j;
    int c;
    int q;
    int nl;
    if (!outn || n < 0 || cap < 0) return 4;
    if (n > 0 && (!src || !dst)) return 4;
    if (n > cap) return 1;
    i = 0;
    j = 0;
    while (i < n) {
        c = src[i] & 255;
        if (c == 34 || c == 39) {
            q = c;
            dst[j] = src[i];
            j = j + 1;
            i = i + 1;
            while (i < n) {
                if ((src[i] & 255) == 92) {
                    dst[j] = src[i];
                    j = j + 1;
                    i = i + 1;
                    if (i < n) {
                        dst[j] = src[i];
                        j = j + 1;
                        i = i + 1;
                    }
                    continue;
                }
                dst[j] = src[i];
                j = j + 1;
                if ((src[i] & 255) == q) {
                    i = i + 1;
                    break;
                }
                i = i + 1;
            }
            continue;
        }
        if (c == 47 && i + 1 < n && (src[i + 1] & 255) == 47) {
            while (i < n && (src[i] & 255) != 10) i = i + 1;
            dst[j] = 32;
            j = j + 1;
            continue;
        }
        if (c == 47 && i + 1 < n && (src[i + 1] & 255) == 42) {
            int closed;
            nl = 0;
            closed = 0;
            i = i + 2;
            while (i < n) {
                if ((src[i] & 255) == 10) nl = nl + 1;
                if ((src[i] & 255) == 42 && i + 1 < n && (src[i + 1] & 255) == 47) {
                    i = i + 2;
                    closed = 1;
                    break;
                }
                i = i + 1;
            }
            if (!closed) return 2;
            dst[j] = 32;
            j = j + 1;
            while (nl > 0) {
                dst[j] = 10;
                j = j + 1;
                nl = nl - 1;
            }
            continue;
        }
        dst[j] = src[i];
        j = j + 1;
        i = i + 1;
    }
    *outn = j;
    return 0;
}

struct PpMac {
    char name[64];
    int nlen;
    char body[256];
    int blen;
    int fn;
    int np;
    char parm[8][32];
    int plen[8];
};

struct PpCond {
    int take[64];
    int seen[64];
    int depth;
};

static int pp_ws(int c) {
    return c == 32 || c == 9 || c == 13 || c == 11 || c == 12;
}

static void pp_why(char *why, int cap, const char *s) {
    int i;
    if (!why || cap <= 0) return;
    i = 0;
    while (s[i] && i + 1 < cap) {
        why[i] = s[i];
        i = i + 1;
    }
    why[i] = 0;
}

static int pp_put(char *dst, int cap, int *at, int c) {
    if (*at < 0 || *at >= cap) return 1;
    dst[*at] = (char)c;
    *at = *at + 1;
    return 0;
}

static int pp_mac_at(struct PpMac *mac, int nmac, const char *s, int n) {
    int i;
    i = 0;
    while (i < nmac) {
        if (mac[i].nlen > 0 && pp_mac_is(mac[i].name, s, n) == 1) return i;
        i = i + 1;
    }
    return -1;
}

static int pp_live(struct PpCond *cond) {
    int k;
    if (!cond) return 1;
    k = 0;
    while (k < cond->depth) {
        if (cond->take[k] == 0) return 0;
        k = k + 1;
    }
    return 1;
}

static int pp_blank_line(const char *src, int n, int i, char *dst, int cap, int *at, int *ni) {
    int e;
    e = i;
    while (e < n && (src[e] & 255) != 10) e = e + 1;
    while (i < e) {
        if (pp_put(dst, cap, at, 32)) return 1;
        i = i + 1;
    }
    if (e < n && (src[e] & 255) == 10) {
        if (pp_put(dst, cap, at, 10)) return 1;
        i = e + 1;
    } else i = e;
    *ni = i;
    return 0;
}

static int pp_subst(struct PpMac *m, const char *src, const int *as, const int *al, char *dst, int cap, int *outn) {
    int i;
    int j;
    int k;
    int o;
    int p;
    o = 0;
    i = 0;
    while (i < m->blen) {
        if (sg_isal(m->body[i] & 255)) {
            j = i + 1;
            while (j < m->blen && pp_idch(m->body[j] & 255)) j = j + 1;
            k = 0;
            while (k < m->np) {
                if (m->plen[k] == j - i && pp_mac_is(m->parm[k], m->body + i, j - i) == 1) {
                    if (o > cap - al[k]) return 1;
                    p = 0;
                    while (p < al[k]) {
                        dst[o] = src[as[k] + p];
                        o = o + 1;
                        p = p + 1;
                    }
                    i = j;
                    break;
                }
                k = k + 1;
            }
            if (k < m->np) continue;
        }
        if (o >= cap) return 1;
        dst[o] = m->body[i];
        o = o + 1;
        i = i + 1;
    }
    *outn = o;
    return 0;
}

static int pp_if_num(const char *s, int n, int *out) {
    int i;
    int v;
    int any;
    i = 0;
    any = 0;
    v = 0;
    while (i < n && pp_ws(s[i] & 255)) i = i + 1;
    while (i < n && sg_isdi(s[i] & 255)) {
        any = 1;
        v = v * 10 + (s[i] & 255) - 48;
        i = i + 1;
    }
    while (i < n && pp_ws(s[i] & 255)) i = i + 1;
    if (!any || i != n) return 0;
    *out = v != 0;
    return 1;
}

static int pp_if_on(const char *s, int n, struct PpMac *mac, int nmac, int *out, char *why, int whycap) {
    int i;
    int b;
    int e;
    int mi;
    i = 0;
    while (i < n && pp_ws(s[i] & 255)) i = i + 1;
    if (n - i >= 7 && pp_span_eq(s + i, 7, "defined") == 1 && (i + 7 == n || !pp_idch(s[i + 7] & 255))) {
        i = i + 7;
        while (i < n && pp_ws(s[i] & 255)) i = i + 1;
        if (i < n && (s[i] & 255) == 40) {
            i = i + 1;
            while (i < n && pp_ws(s[i] & 255)) i = i + 1;
            b = i;
            while (i < n && pp_idch(s[i] & 255)) i = i + 1;
            e = i;
            while (i < n && pp_ws(s[i] & 255)) i = i + 1;
            if (i >= n || (s[i] & 255) != 41 || b == e) {
                pp_why(why, whycap, "bad if");
                return 3;
            }
            i = i + 1;
        } else {
            b = i;
            while (i < n && pp_idch(s[i] & 255)) i = i + 1;
            e = i;
            if (b == e) {
                pp_why(why, whycap, "bad if");
                return 3;
            }
        }
        while (i < n && pp_ws(s[i] & 255)) i = i + 1;
        if (i != n) {
            pp_why(why, whycap, "if expression not migrated");
            return 3;
        }
        *out = pp_mac_at(mac, nmac, s + b, e - b) >= 0;
        return 0;
    }
    if (pp_if_num(s + i, n - i, out)) return 0;
    if (i < n && sg_isal(s[i] & 255)) {
        b = i;
        while (i < n && pp_idch(s[i] & 255)) i = i + 1;
        e = i;
        while (i < n && pp_ws(s[i] & 255)) i = i + 1;
        mi = pp_mac_at(mac, nmac, s + b, e - b);
        if (mi >= 0 && !mac[mi].fn && i == n && pp_if_num(mac[mi].body, mac[mi].blen, out)) return 0;
    }
    pp_why(why, whycap, "if expression not migrated");
    return 3;
}

static int pp_expand_span(const char *src, int n, char *dst, int cap, int *at,
                          struct PpMac *mac, int *nmac, struct PpCond *cond, int depth, int in_inc,
                          char *work, int workcap,
                          int (*readinc)(void *, const char *, int, char *, int, int *),
                          void *ud, char *why, int whycap,
                          const char *hide, int hiden) {
    int i, bol, quote, c, j, e, ns, ne, bs, be, mi, rc, gn, sn, nam;
    if (depth > 16) {
        pp_why(why, whycap, "macro expansion too deep");
        return 3;
    }
    i = 0;
    bol = 1;
    quote = 0;
    while (i < n) {
        if (bol && quote == 0) {
            j = i;
            while (j < n && pp_ws(src[j] & 255)) j = j + 1;
            if (j < n && (src[j] & 255) == 35) {
                e = j;
                while (e < n && (src[e] & 255) != 10) e = e + 1;
                j = j + 1;
                while (j < e && pp_ws(src[j] & 255)) j = j + 1;
                ns = j;
                while (j < e && pp_idch(src[j] & 255)) j = j + 1;
                ne = j;
                if (pp_span_eq(src + ns, ne - ns, "define") == 1) {
                    gn = e;
                    if (!pp_live(cond)) {
                        if (pp_blank_line(src, n, i, dst, cap, at, &i)) return 1;
                        bol = 1;
                        continue;
                    }
                    while (j < e && pp_ws(src[j] & 255)) j = j + 1;
                    if (j >= e || !sg_isal(src[j] & 255)) {
                        pp_why(why, whycap, "bad define");
                        return 3;
                    }
                    bs = j;
                    while (j < e && pp_idch(src[j] & 255)) j = j + 1;
                    be = j;
                    if (be - bs >= 64 || *nmac >= 64) return 1;
                    while (j < e && pp_ws(src[j] & 255)) j = j + 1;
                    while (e > j && pp_ws(src[e - 1] & 255)) e = e - 1;
                    if (e - j >= 256) return 1;
                    mi = pp_mac_at(mac, *nmac, src + bs, be - bs);
                    if (mi < 0) {
                        mi = *nmac;
                        *nmac = *nmac + 1;
                    }
                    mac[mi].nlen = be - bs;
                    nam = 0;
                    while (nam < mac[mi].nlen) {
                        mac[mi].name[nam] = src[bs + nam];
                        nam = nam + 1;
                    }
                    mac[mi].name[mac[mi].nlen] = 0;
                    mac[mi].fn = 0;
                    mac[mi].np = 0;
                    if (j < gn && (src[j] & 255) == 40) {
                        int pk;
                        j = j + 1;
                        pk = 0;
                        while (j < gn) {
                            while (j < gn && pp_ws(src[j] & 255)) j = j + 1;
                            if (j < gn && (src[j] & 255) == 41) break;
                            if (j >= gn || !sg_isal(src[j] & 255)) {
                                pp_why(why, whycap, "bad define");
                                return 3;
                            }
                            bs = j;
                            while (j < gn && pp_idch(src[j] & 255)) j = j + 1;
                            if (pk >= 8 || j - bs >= 32) return 1;
                            mac[mi].plen[pk] = j - bs;
                            nam = 0;
                            while (nam < mac[mi].plen[pk]) {
                                mac[mi].parm[pk][nam] = src[bs + nam];
                                nam = nam + 1;
                            }
                            mac[mi].parm[pk][mac[mi].plen[pk]] = 0;
                            pk = pk + 1;
                            while (j < gn && pp_ws(src[j] & 255)) j = j + 1;
                            if (j < gn && (src[j] & 255) == 44) {
                                j = j + 1;
                                continue;
                            }
                            break;
                        }
                        if (j >= gn || (src[j] & 255) != 41) {
                            pp_why(why, whycap, "bad define");
                            return 3;
                        }
                        j = j + 1;
                        mac[mi].fn = 1;
                        mac[mi].np = pk;
                    }
                    while (j < e && pp_ws(src[j] & 255)) j = j + 1;
                    while (e > j && pp_ws(src[e - 1] & 255)) e = e - 1;
                    if (e - j >= 256) return 1;
                    mac[mi].blen = e - j;
                    nam = 0;
                    while (nam < mac[mi].blen) {
                        mac[mi].body[nam] = src[j + nam];
                        nam = nam + 1;
                    }
                    mac[mi].body[mac[mi].blen] = 0;
                    while (i < gn) {
                        if (pp_put(dst, cap, at, 32)) return 1;
                        i = i + 1;
                    }
                    if (gn < n && (src[gn] & 255) == 10) {
                        if (pp_put(dst, cap, at, 10)) return 1;
                        i = gn + 1;
                    }
                    bol = 1;
                    continue;
                }
                if (pp_span_eq(src + ns, ne - ns, "include") == 1) {
                    int ang;
                    int pend;
                    char ip[320];
                    const char *ipath;
                    int iplen;
                    if (!pp_live(cond)) {
                        if (pp_blank_line(src, n, i, dst, cap, at, &i)) return 1;
                        bol = 1;
                        continue;
                    }
                    if (in_inc) {
                        pp_why(why, whycap, "nested include not migrated");
                        return 3;
                    }
                    while (j < e && pp_ws(src[j] & 255)) j = j + 1;
                    ang = 0;
                    pend = 34;
                    if (j < e && (src[j] & 255) == 60) {
                        ang = 1;
                        pend = 62;
                    } else if (j >= e || (src[j] & 255) != 34) {
                        pp_why(why, whycap, "bad include");
                        return 3;
                    }
                    if (j >= e) {
                        pp_why(why, whycap, "bad include");
                        return 3;
                    }
                    j = j + 1;
                    bs = j;
                    while (j < e && (src[j] & 255) != pend) j = j + 1;
                    if (j >= e) {
                        pp_why(why, whycap, "bad include");
                        return 3;
                    }
                    if (!readinc) return 4;
                    ipath = src + bs;
                    iplen = j - bs;
                    if (ang) {
                        if (iplen + 8 >= 320) return 1;
                        nam = 0;
                        while (nam < 8) {
                            ip[nam] = "include/"[nam];
                            nam = nam + 1;
                        }
                        while (nam - 8 < iplen) {
                            ip[nam] = src[bs + nam - 8];
                            nam = nam + 1;
                        }
                        ip[nam] = 0;
                        ipath = ip;
                        iplen = nam;
                    }
                    gn = 0;
                    rc = readinc(ud, ipath, iplen, work, workcap, &gn);
                    if (rc == 1) {
                        pp_why(why, whycap, "cannot open include");
                        return 3;
                    }
                    if (rc) {
                        pp_why(why, whycap, "cannot read include");
                        return 3;
                    }
                    sn = 0;
                    rc = pp_splice(work, gn, work, gn, &sn);
                    if (rc) return rc;
                    rc = pp_decomment(work, sn, work, gn, &sn);
                    if (rc) return rc;
                    rc = pp_expand_span(work, sn, dst, cap, at, mac, nmac, cond, depth, 1, work, workcap, readinc, ud, why, whycap, 0, 0);
                    if (rc) return rc;
                    if (e < n && (src[e] & 255) == 10) i = e + 1;
                    else i = e;
                    bol = 1;
                    continue;
                }
                if (pp_span_eq(src + ns, ne - ns, "ifdef") == 1 || pp_span_eq(src + ns, ne - ns, "ifndef") == 1
                    || pp_span_eq(src + ns, ne - ns, "if") == 1 || pp_span_eq(src + ns, ne - ns, "elif") == 1
                    || pp_span_eq(src + ns, ne - ns, "else") == 1 || pp_span_eq(src + ns, ne - ns, "endif") == 1
                    || pp_span_eq(src + ns, ne - ns, "undef") == 1) {
                    int kind;
                    int on;
                    int act;
                    int want;
                    kind = 0;
                    if (pp_span_eq(src + ns, ne - ns, "ifndef") == 1) kind = 1;
                    if (pp_span_eq(src + ns, ne - ns, "if") == 1) kind = 2;
                    if (pp_span_eq(src + ns, ne - ns, "elif") == 1) kind = 3;
                    if (pp_span_eq(src + ns, ne - ns, "else") == 1) kind = 4;
                    if (pp_span_eq(src + ns, ne - ns, "endif") == 1) kind = 5;
                    if (pp_span_eq(src + ns, ne - ns, "undef") == 1) kind = 8;
                    if (kind == 8) {
                        if (pp_live(cond)) {
                            while (j < e && pp_ws(src[j] & 255)) j = j + 1;
                            bs = j;
                            while (j < e && pp_idch(src[j] & 255)) j = j + 1;
                            mi = pp_mac_at(mac, *nmac, src + bs, j - bs);
                            if (mi >= 0) mac[mi].nlen = 0;
                        }
                    } else if (kind == 5) {
                        if (cond->depth <= 0) {
                            pp_why(why, whycap, "#endif without #if");
                            return 3;
                        }
                        cond->depth = cond->depth - 1;
                    } else if (kind == 4 || kind == 3) {
                        int outer;
                        if (cond->depth <= 0) {
                            pp_why(why, whycap, kind == 4 ? "#else without #if" : "#elif without #if");
                            return 3;
                        }
                        outer = pp_cond_outer(cond->take, cond->seen, cond->depth);
                        on = 0;
                        if (kind == 4) {
                            if (cond->seen[cond->depth - 1] == 0) on = 1;
                            act = pp_dir_act(4, on);
                            cond->take[cond->depth - 1] = 0;
                            if (pp_cond_else(act, cond->seen[cond->depth - 1])) cond->take[cond->depth - 1] = 1;
                        } else {
                            want = outer;
                            on = 0;
                            if (want) {
                                rc = pp_if_on(src + j, e - j, mac, *nmac, &on, why, whycap);
                                if (rc) return rc;
                            }
                            act = pp_dir_act(3, on);
                            cond->take[cond->depth - 1] = 0;
                            if (act == 0 && outer && cond->seen[cond->depth - 1] == 0) cond->take[cond->depth - 1] = 1;
                        }
                        if (cond->take[cond->depth - 1]) cond->seen[cond->depth - 1] = 1;
                    } else {
                        on = 0;
                        want = pp_live(cond);
                        if (kind == 0 || kind == 1) {
                            while (j < e && pp_ws(src[j] & 255)) j = j + 1;
                            bs = j;
                            while (j < e && pp_idch(src[j] & 255)) j = j + 1;
                            if (bs == j) {
                                pp_why(why, whycap, "bad ifdef");
                                return 3;
                            }
                            on = pp_mac_at(mac, *nmac, src + bs, j - bs) >= 0;
                            act = pp_dir_act(kind, on);
                        } else {
                            if (want) {
                                rc = pp_if_on(src + j, e - j, mac, *nmac, &on, why, whycap);
                                if (rc) return rc;
                            }
                            act = pp_dir_act(2, on);
                        }
                        if (cond->depth >= 64) return 1;
                        cond->take[cond->depth] = pp_cond_take(act, want);
                        cond->seen[cond->depth] = cond->take[cond->depth];
                        cond->depth = cond->depth + 1;
                    }
                    if (pp_blank_line(src, n, i, dst, cap, at, &i)) return 1;
                    bol = 1;
                    continue;
                }
                if (!pp_live(cond)) {
                    if (pp_blank_line(src, n, i, dst, cap, at, &i)) return 1;
                    bol = 1;
                    continue;
                }
                pp_why(why, whycap, "directive not migrated");
                return 3;
            }
            if (!pp_live(cond)) {
                if (pp_blank_line(src, n, i, dst, cap, at, &i)) return 1;
                bol = 1;
                continue;
            }
        }
        c = src[i] & 255;
        if (c == 10) {
            if (pp_put(dst, cap, at, 10)) return 1;
            i = i + 1;
            bol = 1;
            continue;
        }
        bol = 0;
        if (quote) {
            if (pp_put(dst, cap, at, c)) return 1;
            i = i + 1;
            if (c == 92 && i < n) {
                if (pp_put(dst, cap, at, src[i] & 255)) return 1;
                i = i + 1;
                continue;
            }
            if (c == quote) quote = 0;
            continue;
        }
        if (c == 34 || c == 39) {
            quote = c;
            if (pp_put(dst, cap, at, c)) return 1;
            i = i + 1;
            continue;
        }
        if (sg_isal(c)) {
            j = i + 1;
            while (j < n && pp_idch(src[j] & 255)) j = j + 1;
            mi = -1;
            if (!(hide && hiden == j - i && pp_mac_is(hide, src + i, j - i) == 1))
                mi = pp_mac_at(mac, *nmac, src + i, j - i);
            if (mi >= 0 && mac[mi].fn) {
                int k;
                int nargs;
                int depthp;
                int qch;
                int as[8];
                int al[8];
                int substn;
                char subst[1024];
                k = j;
                while (k < n && ((src[k] & 255) == 32 || (src[k] & 255) == 9)) k = k + 1;
                if (k >= n || (src[k] & 255) != 40) {
                    while (i < j) {
                        if (pp_put(dst, cap, at, src[i] & 255)) return 1;
                        i = i + 1;
                    }
                    continue;
                }
                k = k + 1;
                nargs = 0;
                depthp = 0;
                qch = 0;
                bs = k;
                while (k < n) {
                    c = src[k] & 255;
                    if (qch) {
                        if (c == 92 && k + 1 < n) {
                            k = k + 2;
                            continue;
                        }
                        if (c == qch) qch = 0;
                        k = k + 1;
                        continue;
                    }
                    if (c == 34 || c == 39) {
                        qch = c;
                        k = k + 1;
                        continue;
                    }
                    if (c == 40) {
                        depthp = depthp + 1;
                        k = k + 1;
                        continue;
                    }
                    if (c == 41 && depthp == 0) break;
                    if (c == 41) {
                        depthp = depthp - 1;
                        k = k + 1;
                        continue;
                    }
                    if (c == 44 && depthp == 0) {
                        if (nargs >= 8) {
                            pp_why(why, whycap, "macro argument count");
                            return 3;
                        }
                        be = k;
                        while (bs < be && pp_ws(src[bs] & 255)) bs = bs + 1;
                        while (be > bs && pp_ws(src[be - 1] & 255)) be = be - 1;
                        as[nargs] = bs;
                        al[nargs] = be - bs;
                        nargs = nargs + 1;
                        k = k + 1;
                        bs = k;
                        continue;
                    }
                    k = k + 1;
                }
                if (k >= n || (src[k] & 255) != 41) {
                    pp_why(why, whycap, "bad macro call");
                    return 3;
                }
                be = k;
                while (bs < be && pp_ws(src[bs] & 255)) bs = bs + 1;
                while (be > bs && pp_ws(src[be - 1] & 255)) be = be - 1;
                if (!(nargs == 0 && bs == be)) {
                    if (nargs >= 8) {
                        pp_why(why, whycap, "macro argument count");
                        return 3;
                    }
                    as[nargs] = bs;
                    al[nargs] = be - bs;
                    nargs = nargs + 1;
                }
                if (nargs != mac[mi].np) {
                    pp_why(why, whycap, "macro argument count");
                    return 3;
                }
                substn = 0;
                if (pp_subst(&mac[mi], src, as, al, subst, 1024, &substn)) return 1;
                rc = pp_expand_span(subst, substn, dst, cap, at, mac, nmac, cond, depth + 1, 1, work, workcap, readinc, ud, why, whycap, mac[mi].name, mac[mi].nlen);
                if (rc) return rc;
                i = k + 1;
                continue;
            }
            if (mi >= 0) {
                rc = pp_expand_span(mac[mi].body, mac[mi].blen, dst, cap, at, mac, nmac, cond, depth + 1, 1, work, workcap, readinc, ud, why, whycap, mac[mi].name, mac[mi].nlen);
                if (rc) return rc;
            } else {
                while (i < j) {
                    if (pp_put(dst, cap, at, src[i] & 255)) return 1;
                    i = i + 1;
                }
                continue;
            }
            i = j;
            continue;
        }
        if (pp_put(dst, cap, at, c)) return 1;
        i = i + 1;
    }
    return 0;
}

int pp_expand(const char *src, int n, char *dst, int cap, int *outn,
              char *work, int workcap,
              int (*readinc)(void *, const char *, int, char *, int, int *),
              void *ud, char *why, int whycap) {
    struct PpMac mac[64];
    struct PpCond cond;
    int nmac;
    int at;
    int rc;
    if (!outn || n < 0 || cap < 0 || workcap < 0) return 4;
    if (n > 0 && !src) return 4;
    if (cap > 0 && !dst) return 4;
    if (workcap > 0 && !work) return 4;
    nmac = 0;
    at = 0;
    cond.depth = 0;
    rc = pp_expand_span(src, n, dst, cap, &at, mac, &nmac, &cond, 0, 0, work, workcap, readinc, ud, why, whycap, 0, 0);
    if (rc) return rc;
    *outn = at;
    return 0;
}
