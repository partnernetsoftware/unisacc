#pragma unisa module bindvec
/* Indexes in the runargs vector. No libc and no include.
   xrealloc and the pointer fill stay in exec/c/compiler.c.
   Slot 0 is the source. The following slots are argv from
   argstart, then a null at index count, then envn entries
   and the environment's own null. The size is count+envn+2.
   These are that expression, including zero and negative. */
int bx_run_slots(int count, int envn) {
    return count + envn + 2;
}
int bx_run_arg_at(int argstart, int j) {
    return j - argstart + 1;
}
int bx_run_nul(int count) {
    return count;
}
int bx_run_env_at(int count, int j) {
    return count + 1 + j;
}
