#pragma unisa module bindonly
/* deponly dependency-name selection. No libc and no include.
   The .d concatenation, memcpy, and cxd_write stay in exec/c/compiler.c.
   An empty deps string with a nonzero deponly flag selects out when that
   pointer is present, and "-" when it is not. Any other input leaves the
   choice unwritten. */
int bx_dep_only(const char *deps, int deponly, const char *out, const char **chosen) {
    if (!deps) return 4;
    if (deps[0] || !deponly) return 2;
    if (!chosen) return 4;
    *chosen = out ? out : "-";
    return 1;
}
