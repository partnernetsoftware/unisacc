#pragma unisa module compilergate
/* Pure judgments still inline in exec/c/compiler.c. No libc and no include.
   IO, decode, and the product calls stay in that file. A null pointer
   returns 4. A value that does not fit returns 1 and is not written.
   An unknown kind returns -1. That -1 is not the old return. */
static int cg_eq(const char *a, const char *b) {
    int i;
    i = 0;
    while (a[i] && a[i] == b[i]) i++;
    return a[i] == 0 && b[i] == 0;
}
/* fwd_callback_decl: cb.n must sit in 0..8. 1 matches that refusal. */
int cg_cb_count(int n) {
    if (n < 0 || n > 8) return 1;
    return 0;
}
/* fwd_callback_decl: size_t cap is cast to int for fw_decl.
   Above 2147483647 does not fit and is not written. */
int cg_cb_cap(unsigned long long cap) {
    if (cap > 2147483647ull) return 1;
    return 0;
}
/* par_take_paths: more than 65536 paths does not fit and is not stored.
   1 is not the old return. par_take_paths returned 0.
   A negative count is not an unsigned length and returns -1.
   That -1 is not the old return. */
int cg_par_count(int n) {
    if (n < 0) return -1;
    if (n > 65536) return 1;
    return 0;
}
/* par_take_paths: an empty path or a length past cap does not fit
   and is not written. 1 is not the old return (the reader returned 0).
   A negative length or cap is unknown and returns -1.
   That -1 is not the old return. */
int cg_par_len(int len, int cap) {
    if (len < 0 || cap < 0) return -1;
    if (cap < 1 || len == 0 || len >= cap) return 1;
    return 0;
}
/* fwd_sidecar: a record name past 1024, or past the remaining bytes,
   does not fit and is not copied. 1 is not the old return.
   fwd_sidecar returned -1. The u64 read stays in C. */
int cg_fwd_nl(unsigned long long nl, unsigned long long n, unsigned long long at) {
    if (nl > 1024ull) return 1;
    if (nl > n - at) return 1;
    return 0;
}
/* fwd_sidecar: a signature past the remaining bytes does not fit
   and is not decoded here. 1 is not the old return (fwd_sidecar
   returned -1). The u64 read stays in C. */
int cg_fwd_sl(unsigned long long sl, unsigned long long n, unsigned long long at) {
    if (sl > n - at) return 1;
    return 0;
}
/* product_view: argv[1][0]=='o' is objdump. 'n' is nm.
   Any other first byte returns -1. That -1 is not the old return:
   product_view treated every non-'o' name as nm. */
int cg_view_kind(const char *name) {
    if (!name) return 4;
    if (name[0] == 'o') return 1;
    if (name[0] == 'n') return 0;
    return -1;
}
/* product_view: objdump needs argc 4 and "-d". nm needs argc 3.
   A bad shape returns 1 and writes nothing. 1 is not the old return
   (product_view returned 2). An unknown dis kind returns -1.
   That -1 is not the old return. */
int cg_view_argc(int dis, int argc, const char *flag) {
    if (dis == 1) {
        if (argc != 4) return 1;
        if (!flag) return 4;
        if (cg_eq(flag, "-d")) return 0;
        return 1;
    }
    if (dis == 0) {
        if (argc == 3) return 0;
        return 1;
    }
    return -1;
}
/* product_as: "-o" with a following word is 1, "-b" with one is 3,
   a bare word is an input (0). Another dash word is an unknown option
   and returns -1. That -1 is not the old return (product_as returned 2). */
int cg_as_word(const char *word, int has_next) {
    if (!word) return 4;
    if (has_next && cg_eq(word, "-o")) return 1;
    if (has_next && cg_eq(word, "-b")) return 3;
    if (word[0] == '-' && word[1]) return -1;
    return 0;
}
/* product_as: an explicit -b conflicts when the -S header arch is
   known and differs. 1 matches that refusal. explicit_b other than
   0 or 1 returns -1. That -1 is not the old return. */
int cg_as_head(int explicit_b, int header, int arch) {
    if (explicit_b != 0 && explicit_b != 1) return -1;
    if (!explicit_b) return 0;
    if (header < 0) return 0;
    if (header != arch) return 1;
    return 0;
}
/* cxt_error: rc 4 is the raw why path (1). Any other non-negative rc
   is the clierror path (0). 0 is not cxt_error's old return.
   A negative rc returns -1. That -1 is not the old return. */
int cg_cxt_rc(int rc) {
    if (rc == 4) return 1;
    if (rc < 0) return -1;
    return 0;
}
/* take_unit: index 0 adopts the first object. A later index must
   compare targets (1). A negative index returns -1.
   That -1 is not the old return. */
int cg_unit_ord(int index) {
    if (index == 0) return 0;
    if (index > 0) return 1;
    return -1;
}
