#pragma unisa module leword
/* Eight-byte little-endian store from resource_u64 in exec/c/memory.c.
   The callers in compiler.c, bind.c, and libunisacc.c stay in C.
   A null destination returns 4. A capacity below 8 returns 1 and
   writes nothing. Those two were not on the old path, which always
   wrote eight bytes. */
int lw_put(unsigned char *dst, int cap, unsigned long long value) {
    int i;
    if (!dst) return 4;
    if (cap < 8) return 1;
    i = 0;
    while (i < 8) {
        dst[i] = (unsigned char)(value & 255ull);
        value = value >> 8;
        i = i + 1;
    }
    return 0;
}
/* Resource row names around the same stores. Each counted name
   starts with a zero byte. A null buffer or an unknown index
   returns 4. A short buffer returns 1 and writes nothing. */
static const char *mr_body(int i) {
    if (i == 0) return "process/argc";
    if (i == 1) return "process/argv";
    if (i == 2) return "memory/text";
    if (i == 3) return "memory/reserve";
    if (i == 4) return "library/symbols";
    if (i == 5) return "library/exit";
    if (i == 6) return "library/mmap";
    if (i == 7) return "library/munmap";
    if (i == 8) return "process/dl/0";
    if (i == 9) return "process/dl/1";
    if (i == 10) return "process/dl/2";
    if (i == 11) return "process/dl/3";
    if (i == 12) return "library/module";
    if (i == 13) return "library/process";
    if (i == 14) return "library/callables";
    if (i == 15) return "library/callablemake";
    if (i == 16) return "library/callablecall";
    return 0;
}
static int mr_len(const char *s) {
    int n;
    n = 0;
    while (s[n]) n = n + 1;
    return n + 1;
}
static int mr_write(const char *s, unsigned char *out, int cap) {
    int n, k;
    if (!out) return 4;
    if (!s) return 4;
    n = mr_len(s);
    if (cap < n) return 1;
    out[0] = 0;
    k = 0;
    while (k < n - 1) {
        out[k + 1] = (unsigned char)s[k];
        k = k + 1;
    }
    return 0;
}
int mr_rows(void) {
    return 17;
}
int mr_cap_base(void) {
    return 25;
}
int mr_rec_len(void) {
    return 8;
}
int mr_cli_text(void) {
    return 7;
}
int mr_cli_tail(void) {
    return 8;
}
int mr_name_n(int i) {
    const char *s;
    s = mr_body(i);
    if (!s) return 4;
    return mr_len(s);
}
int mr_name(int i, unsigned char *out, int cap) {
    return mr_write(mr_body(i), out, cap);
}
int mr_tail_n(int kind) {
    if (kind == 0) return 15;
    if (kind == 1) return 12;
    return 4;
}
int mr_tail(int kind, unsigned char *out, int cap) {
    if (kind == 0) return mr_write("memory/reserve", out, cap);
    if (kind == 1) return mr_write("memory/data", out, cap);
    return 4;
}
int mr_extra_n(int kind) {
    if (kind == 0) return 19;
    if (kind == 1) return 17;
    return 4;
}
int mr_extra(int kind, unsigned char *out, int cap) {
    if (kind == 0) return mr_write("library/signatures", out, cap);
    if (kind == 1) return mr_write("library/bindings", out, cap);
    return 4;
}
int mr_apple(int apple) {
    if (apple < 0) return 4;
    if (apple) return 32;
    return 0;
}
int mr_host_n(void) {
    return 4;
}
int mr_host_at(int j) {
    if (j < 0 || j >= 4) return 4;
    return j * 8;
}
int mr_host_cli(int j) {
    if (j < 0 || j >= 4) return 4;
    return 9 + j;
}
int mr_mark(void) {
    return 1;
}
