#pragma unisa module bindimage
/* Default image name after the dependency block. No libc and no include.
   The assignment stays in exec/c/compiler.c. A null out with mode 0 and
   explicit_image 0 selects a.exe when win is nonzero, otherwise a.out.
   The earlier effective_out line also requires runit to be zero and always
   uses a.out. That line is bx_sym_out in bindsym.cx. */
int bx_image_name(const char *out, int mode, int explicit_image, int win,
                   const char **chosen) {
    if (out || mode || explicit_image) return 2;
    if (!chosen) return 4;
    *chosen = win ? "a.exe" : "a.out";
    return 1;
}
