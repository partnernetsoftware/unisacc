#pragma unisa module fwdmerge
/* Incrementally attach the generated host-forwarding unit to the first E3 tape.
   The stub is compiled alone with a throwaway main; only its definitions,
   initializer and string rows survive.  A shape we cannot prove safe falls
   back to the original full E3 replay in compiler.c.
   No libc. The driver injects allocate, release, and failure. FwmBuf matches the
   driver's layout: two pointers, then two ints. long long is 8 bytes on LP64
   and LLP64. */
typedef struct { unsigned char *b; long long *at; int n, cap; } FwmBuf;
typedef struct { const unsigned char *p; int n; } FwmLine;
typedef struct { const unsigned char *p; int n; } FwmName;
static char *fwm_exports[512];
static int fwm_nexports;
static int fwm_overflow;
static void *(*fwm_alloc)(void *, long long);
static void (*fwm_release)(void *);
static void (*fwm_fail)(char *);
int fwm_bind(void *(*alloc)(void *, long long), void (*release)(void *), void (*fail)(char *)) {
    if (!alloc || !release || !fail) return 1;
    fwm_alloc = alloc; fwm_release = release; fwm_fail = fail; return 0;
}
static void *fwm_grow(void *p, long long n) { return fwm_alloc(p, n); }
static void fwm_drop(void *p) { if (p) fwm_release(p); }
static void fwm_die(char *m) { fwm_fail(m); }
static int fwm_len(const char *s) { int n; n = 0; while (s[n]) n = n + 1; return n; }
static int fwm_memeq(const unsigned char *a, const unsigned char *b, int n) {
    int i; for (i = 0; i < n; i = i + 1) if (a[i] != b[i]) return 0; return 1;
}
static void fwm_copy(unsigned char *d, const unsigned char *s, int n) {
    int i; for (i = 0; i < n; i = i + 1) d[i] = s[i];
}
static void fwm_clear(FwmBuf *o) {
    unsigned char *p; int i; int n;
    p = (unsigned char *)o; n = (int)sizeof *o;
    for (i = 0; i < n; i = i + 1) p[i] = 0;
}
void fwm_reset(void) {
    int i; for (i = 0; i < fwm_nexports; i = i + 1) fwm_drop(fwm_exports[i]);
    fwm_nexports = 0; fwm_overflow = 0;
}
int fwm_export(const unsigned char *p, int n) {
    char *s;
    if (n <= 0 || n > 1024 || fwm_nexports >= 512) { fwm_overflow = 1; return 1; }
    s = fwm_grow(0, (long long)n + 1); fwm_copy((unsigned char *)s, p, n); s[n] = 0;
    fwm_exports[fwm_nexports] = s; fwm_nexports = fwm_nexports + 1; return 0;
}
int fwm_overflowed(void) { return fwm_overflow; }
static int fwm_isid(int c) {
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '.' || c == '$';
}
static int fwm_eq(FwmLine l, const char *s) {
    int n; n = fwm_len(s); return l.n == n && fwm_memeq(l.p, (const unsigned char *)s, n);
}
static int fwm_prefix(FwmLine l, const char *s) {
    int n; n = fwm_len(s); return l.n >= n && fwm_memeq(l.p, (const unsigned char *)s, n);
}
static int fwm_lines(const FwmBuf *b, FwmLine **out) {
    int cap; int count; int at; FwmLine *v;
    cap = 256; count = 0; at = 0; v = fwm_grow(0, (long long)cap * (long long)sizeof *v);
    while (at < b->n) {
        int end; end = at; while (end < b->n && b->b[end] != '\n') end = end + 1;
        if (end == b->n) { fwm_drop(v); return -1; }
        if (count == cap) { cap = cap * 2; v = fwm_grow(v, (long long)cap * (long long)sizeof *v); }
        v[count].p = b->b + at; v[count].n = end - at; count = count + 1; at = end + 1;
    }
    *out = v; return count;
}
static int fwm_nameeq(FwmName a, const unsigned char *p, int n) {
    return a.n == n && fwm_memeq(a.p, p, n);
}
static int fwm_hasname(FwmName *v, int count, const unsigned char *p, int n) {
    int i; for (i = 0; i < count; i = i + 1) if (fwm_nameeq(v[i], p, n)) return 1;
    return 0;
}
static int fwm_isexport(const unsigned char *p, int n) {
    int i;
    for (i = 0; i < fwm_nexports; i = i + 1)
        if (fwm_len(fwm_exports[i]) == n && fwm_memeq((const unsigned char *)fwm_exports[i], p, n)) return 1;
    return 0;
}
int fwm_seen(const unsigned char *p, int n) { return fwm_isexport(p, n); }
static int fwm_addname(FwmName *v, int *count, const unsigned char *p, int n) {
    int i;
    if (n <= 0 || n > 1024 || *count >= 4096) return 1;
    for (i = 0; i < *count; i = i + 1) if (fwm_nameeq(v[i], p, n)) return 0;
    v[*count].p = p; v[*count].n = n; *count = *count + 1; return 0;
}
static int fwm_number(const unsigned char *p, int n, int prefix, int *value) {
    int x; int i;
    if (n <= prefix) return 0;
    x = 0;
    for (i = prefix; i < n; i = i + 1) {
        if (p[i] < '0' || p[i] > '9' || x > 1000000) return 0;
        x = x * 10 + p[i] - '0';
    }
    *value = x; return 1;
}
static void fwm_put(FwmBuf *o, const unsigned char *p, int n) {
    int cap;
    if (n <= 0) return;
    if (o->n + n > o->cap) {
        cap = o->cap ? o->cap : 1024;
        while (cap < o->n + n) { if (cap > 0x3fffffff) { fwm_die("forward tape too large"); return; } cap = cap * 2; }
        o->b = fwm_grow(o->b, (long long)cap); o->cap = cap;
    }
    fwm_copy(o->b + o->n, p, n); o->n = o->n + n;
}
static void fwm_text(FwmBuf *o, const char *s) { fwm_put(o, (const unsigned char *)s, fwm_len(s)); }
static void fwm_int(FwmBuf *o, int x) {
    char d[32]; int n; unsigned u;
    n = 0;
    if (x < 0) u = (unsigned)(-(x + 1)) + 1u; else u = (unsigned)x;
    if (u == 0) { d[n] = '0'; n = n + 1; }
    while (u) {
        if (n >= 30) { fwm_die("forward tape number"); return; }
        d[n] = (char)('0' + (u % 10)); n = n + 1; u = u / 10;
    }
    if (x < 0) { d[n] = '-'; n = n + 1; }
    while (n > 0) { n = n - 1; fwm_put(o, (const unsigned char *)(d + n), 1); }
}
static int fwm_rewrite(FwmBuf *o, FwmLine l, FwmName *locals, int nlocals, int labshift, int strshift, int unit) {
    int start; int end; int i;
    start = 0; end = l.n;
    if (fwm_prefix(l, "  .sys ") || fwm_prefix(l, "  .sys6 ")) {
        while (start < l.n && l.p[start] != ',') start = start + 1;
        if (start == l.n) return 1;
        start = start + 1;
        fwm_put(o, l.p, start);
    }
    if (fwm_prefix(l, ".str ")) {
        for (i = start; i < l.n; i = i + 1) if (l.p[i] == '"') { end = i; break; }
    }
    for (i = start; i < end; ) {
        int j; const unsigned char *p; int n; int v; int done;
        if (!fwm_isid(l.p[i])) { fwm_put(o, l.p + i, 1); i = i + 1; continue; }
        j = i + 1; while (j < end && fwm_isid(l.p[j])) j = j + 1;
        p = l.p + i; n = j - i; v = 0; done = 0;
        if (n > 11 && fwm_memeq(p, (const unsigned char *)"__unisacc_", 10) && (p[10] == 'L' || p[10] == 'R') && fwm_number(p, n, 11, &v)) {
            fwm_put(o, p, 11); fwm_int(o, v + labshift); done = 1;
        } else if (p[0] == 'S' && fwm_number(p, n, 1, &v)) {
            fwm_text(o, "S"); fwm_int(o, v + strshift); done = 1;
        } else if (n > 2 && p[0] == 'l' && p[1] == 's' && fwm_number(p, n, 2, &v)) {
            fwm_text(o, "ls"); fwm_int(o, v + 2097152 * unit); done = 1;
        } else {
            int k;
            for (k = 0; k < nlocals; k = k + 1) if (fwm_nameeq(locals[k], p, n)) {
                fwm_put(o, p, n); fwm_text(o, "__u"); fwm_int(o, unit); done = 1; break;
            }
        }
        if (!done) fwm_put(o, p, n);
        i = j;
    }
    if (end < l.n) fwm_put(o, l.p + end, l.n - end);
    fwm_text(o, "\n"); return 0;
}
static void fwm_line(FwmBuf *o, FwmLine l) { fwm_put(o, l.p, l.n); fwm_text(o, "\n"); }
int fwm_merge(const FwmBuf *base, const FwmBuf *stub, const FwmBuf *unit_tape, int unit, FwmBuf *out) {
    FwmLine *a; FwmLine *b; FwmLine *u; FwmName *locals; FwmName *globals;
    int na; int nb; int nu; int nglobals; int ok; int body; int main; int sinit; int sret; int ainit; int aret; int lastret;
    a = 0; b = 0; u = 0; locals = 0; globals = 0;
    na = fwm_lines(base, &a); nb = fwm_lines(stub, &b); nu = fwm_lines(unit_tape, &u);
    nglobals = 0; ok = 0; body = -1; main = -1; sinit = -1; sret = -1; ainit = -1; aret = -1; lastret = -1;
    if (na < 0 || nb < 0 || nu < 0 || !fwm_nexports || fwm_overflow) goto done;
    if (nu < 1 || !fwm_eq(u[0], ".unit 2")) goto done;
    globals = fwm_grow(0, 4096 * (long long)sizeof *globals);
    {
        int i;
        for (i = 0; i < nu; i = i + 1) if (fwm_prefix(u[i], ".global ")) {
            const unsigned char *p; int n;
            p = u[i].p + 8; n = u[i].n - 8;
            if (fwm_addname(globals, &nglobals, p, n)) goto done;
        }
    }
    body = 1;
    {
        int i;
        for (i = 0; i < nb; i = i + 1) {
            if (main < 0 && fwm_eq(b[i], "main:")) main = i;
            if (sinit < 0 && fwm_eq(b[i], "__init_u:")) sinit = i;
            if (sret < 0 && fwm_eq(b[i], "__main_ret:")) sret = i;
        }
        for (i = 0; i < na; i = i + 1) {
            if (ainit < 0 && fwm_eq(a[i], "__init:")) ainit = i;
            if (aret < 0 && fwm_eq(a[i], "__main_ret:")) aret = i;
        }
    }
    if (!(0 < body && body < main && main < sinit && sinit < sret && sret + 1 < nb && 0 < ainit && ainit < aret)) goto done;
    if (!fwm_eq(b[sret - 1], "  ret")) goto done;
    {
        int i;
        for (i = ainit + 1; i < aret; i = i + 1) if (fwm_eq(a[i], "  ret")) lastret = i;
    }
    if (lastret < 0) goto done;
    {
        int insert_at; int stub_calls; int nlocals; int labmax; int strmax; int i;
        insert_at = lastret;
        while (insert_at > ainit + 1 && fwm_prefix(a[insert_at - 1], "  call ")) insert_at = insert_at - 1;
        stub_calls = sret - 1;
        while (stub_calls > sinit + 1 && fwm_prefix(b[stub_calls - 1], "  call ")) stub_calls = stub_calls - 1;
        if (!fwm_eq(b[sret + 1], "  .exit r0") &&
            !(fwm_eq(b[sret + 1], "  call exit") && sret + 2 < nb && fwm_eq(b[sret + 2], "  .exit r0"))) goto done;
        for (i = sret + 1; i < nb; i = i + 1) if (!fwm_prefix(b[i], ".str ") &&
            !fwm_eq(b[i], "  .exit r0") && !fwm_eq(b[i], "  call exit") &&
            !fwm_eq(b[i], ".extern __init")) goto done;
        nlocals = 0; labmax = 0; strmax = -1;
        locals = fwm_grow(0, 4096 * (long long)sizeof *locals);
        for (i = body; i < main; i = i + 1) {
            const unsigned char *p; int n;
            if (fwm_prefix(b[i], ".global ") || fwm_prefix(b[i], ".extern ") ||
                fwm_prefix(b[i], ".gdef ")) continue;
            p = 0; n = 0;
            if (fwm_prefix(b[i], ".bss ")) {
                p = b[i].p + 5; while (5 + n < b[i].n && fwm_isid(p[n])) n = n + 1;
            } else if (b[i].n > 1 && b[i].p[0] != ' ' && b[i].p[b[i].n - 1] == ':') {
                p = b[i].p; n = b[i].n - 1;
            }
            if (p && n && !fwm_isexport(p, n) && !fwm_hasname(globals, nglobals, p, n) &&
                !(n > 11 && fwm_memeq(p, (const unsigned char *)"__unisacc_", 10)))
                if (fwm_addname(locals, &nlocals, p, n)) goto done;
        }
        for (i = 0; i < na; i = i + 1) {
            int quoted; int inquote; int j;
            quoted = fwm_prefix(a[i], ".str "); inquote = 0;
            for (j = 0; j < a[i].n; ) {
                int k; const unsigned char *p; int n; int v;
                if (quoted && a[i].p[j] == '"') inquote = 1;
                if (inquote || !fwm_isid(a[i].p[j])) { j = j + 1; continue; }
                k = j + 1; while (k < a[i].n && fwm_isid(a[i].p[k])) k = k + 1;
                p = a[i].p + j; n = k - j; v = 0;
                if (n > 11 && fwm_memeq(p, (const unsigned char *)"__unisacc_", 10) && (p[10] == 'L' || p[10] == 'R') && fwm_number(p, n, 11, &v) && v > labmax) labmax = v;
                if (p[0] == 'S' && fwm_number(p, n, 1, &v) && v > strmax) strmax = v;
                j = k;
            }
        }
        if (labmax > 1000000 || strmax > 1000000) goto done;
        for (i = 0; i < na; i = i + 1) {
            if (i == ainit) {
                int j;
                for (j = body; j < main; j = j + 1) {
                    if (fwm_prefix(b[j], ".global ") || fwm_prefix(b[j], ".extern ") ||
                        fwm_prefix(b[j], ".gdef ")) continue;
                    if (fwm_rewrite(out, b[j], locals, nlocals, labmax, strmax + 1, unit)) goto done;
                }
            }
            if (i == insert_at) {
                int j;
                for (j = sinit + 1; j < stub_calls; j = j + 1)
                    if (fwm_rewrite(out, b[j], locals, nlocals, labmax, strmax + 1, unit)) goto done;
            }
            if (i == lastret) {
                int j;
                for (j = stub_calls; j < sret - 1; j = j + 1)
                    if (fwm_rewrite(out, b[j], locals, nlocals, labmax, strmax + 1, unit)) goto done;
            }
            fwm_line(out, a[i]);
        }
        {
            int j;
            for (j = sret + 1; j < nb; j = j + 1) if (fwm_prefix(b[j], ".str "))
                if (fwm_rewrite(out, b[j], locals, nlocals, labmax, strmax + 1, unit)) goto done;
        }
    }
    ok = 1;
done:
    fwm_drop(a); fwm_drop(b); fwm_drop(u); fwm_drop(locals); fwm_drop(globals);
    if (!ok) { fwm_drop(out->b); fwm_clear(out); }
    return ok;
}
