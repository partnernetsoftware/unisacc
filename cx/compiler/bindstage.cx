#pragma unisa module bindstage
/* Stage-name existence. No libc and no include.
   Rows are injected. The first row whose route and name both match
   returns 1. A finished scan returns 0. bx_stage_out also requires
   the row's out field. bx_stage_in requires the row's in field.
   bx_stage_model writes that row's model and does not rescan STAGES.
   bx_stage_route matches the route only. The STAGES walk stays in exec/c.
   Return 4 is not the old strcmp. */
static int bx_eq(const char *a, const char *b) {
    int i;
    i = 0;
    while (a[i] && a[i] == b[i]) i++;
    return a[i] == b[i];
}
int bx_stage_present(const char *route, const char *name,
                     const char *const *routes, const char *const *names, int n) {
    int i;
    if (!route || !name || n < 0) return 4;
    if (n == 0) return 0;
    if (!routes || !names) return 4;
    for (i = 0; i < n; i++) {
        if (!routes[i] || !names[i]) return 4;
        if (bx_eq(route, routes[i]) && bx_eq(name, names[i])) return 1;
    }
    return 0;
}
int bx_stage_out(const char *route, const char *name, const char *out,
                 const char *const *routes, const char *const *names,
                 const char *const *outs, int n) {
    int i;
    if (!route || !name || !out || n < 0) return 4;
    if (n == 0) return 0;
    if (!routes || !names || !outs) return 4;
    for (i = 0; i < n; i++) {
        if (!routes[i] || !names[i] || !outs[i]) return 4;
        if (bx_eq(route, routes[i]) && bx_eq(name, names[i]) && bx_eq(out, outs[i])) return 1;
    }
    return 0;
}
int bx_stage_in(const char *route, const char *name, const char *text,
                const char *const *routes, const char *const *names,
                const char *const *ins, int n) {
    int i;
    if (!route || !name || !text || n < 0) return 4;
    if (n == 0) return 0;
    if (!routes || !names || !ins) return 4;
    for (i = 0; i < n; i = i + 1) {
        if (!routes[i] || !names[i] || !ins[i]) return 4;
        if (bx_eq(route, routes[i]) && bx_eq(name, names[i]) && bx_eq(text, ins[i])) return 1;
    }
    return 0;
}
int bx_stage_model(const char *route, const char *name,
                   const char *const *routes, const char *const *names,
                   const int *models, int n, int *slot) {
    int i;
    if (!route || !name || !slot || n < 0) return 4;
    if (n == 0) return 0;
    if (!routes || !names || !models) return 4;
    for (i = 0; i < n; i = i + 1) {
        if (!routes[i] || !names[i]) return 4;
        if (bx_eq(route, routes[i]) && bx_eq(name, names[i])) {
            *slot = models[i];
            return 1;
        }
    }
    return 0;
}
int bx_stage_route(const char *route, const char *const *routes, int n) {
    int i;
    if (!route || n < 0) return 4;
    if (n == 0) return 0;
    if (!routes) return 4;
    for (i = 0; i < n; i = i + 1) {
        if (!routes[i]) return 4;
        if (bx_eq(route, routes[i])) return 1;
    }
    return 0;
}
