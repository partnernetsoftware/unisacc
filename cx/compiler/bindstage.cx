#pragma unisa module bindstage
/* Stage-name existence. No libc and no include.
   The STAGES table, PS, and strcmp stay in exec/c/bind.c.
   Rows are injected. The first row whose route and name both match
   returns 1. A finished scan returns 0. */
static int bx_eq(const char *a, const char *b) {
    int i;
    i = 0;
    while (a[i] && a[i] == b[i]) i++;
    return a[i] == b[i];
}
int bx_stage_present(const char *route, const char *name,
                     const char *const *routes, const char *const *names, int n) {
    int i;
    if (!route || !name || n < 0) return 4;
    if (n == 0) return 0;
    if (!routes || !names) return 4;
    for (i = 0; i < n; i++) {
        if (!routes[i] || !names[i]) return 4;
        if (bx_eq(route, routes[i]) && bx_eq(name, names[i])) return 1;
    }
    return 0;
}
