}
static int bx_need(int *need, int more) {
    if (more < 0 || *need < 0 || more > 2147483647 - *need) return 1;
    *need = *need + more;
    return 0;
}
static void bx_put(char *out, int *at, const char *s) {
    int i;
    i = 0;
    while (s[i]) { out[*at] = s[i]; *at = *at + 1; i++; }
}
static int bx_join5(const char *a, const char *b, const char *c, const char *d, const char *e, char *out, int cap) {
    int need, at;
    need = 0;
    if (!out || cap < 1) return 4;
    if (bx_need(&need, bx_part(a)) || bx_need(&need, bx_part(b)) || bx_need(&need, bx_part(c)) || bx_need(&need, bx_part(d)) || bx_need(&need, bx_part(e))) return 1;
    if (need >= cap) return 1;
    at = 0;
    if (a) bx_put(out, &at, a);
    if (b) bx_put(out, &at, b);
    if (c) bx_put(out, &at, c);
    if (d) bx_put(out, &at, d);
    if (e) bx_put(out, &at, e);
    out[at] = 0;
    return 0;
}
static int bx_digits(int v, char *buf) {
    char tmp[16];
    int n, i, neg;
    unsigned int u;
    neg = 0;
    if (v < 0) {
        neg = 1;
        u = (unsigned int)(-(v + 1)) + 1;
    } else u = (unsigned int)v;
    n = 0;
    if (u == 0) { tmp[n] = '0'; n = 1; }
    while (u) { tmp[n] = (char)('0' + (u % 10)); n++; u = u / 10; }
    i = 0;
    if (neg) { buf[i] = '-'; i++; }
    while (n) { n--; buf[i] = tmp[n]; i++; }
    return i;
}
const char *bx_read_die(int act) {
    if (act == 2) return "cannot read input";
    if (act == 3) return "close failed";
    if (act == 4) return "file too large";
    if (act == 6) return "out of memory";
    if (act == 0 || act == 1) return 0;
    return "bad input argument";
}
