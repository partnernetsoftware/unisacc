#pragma unisa module bindhost
/* Pure gates in host_symbol_stream and host_compile. No libc and
   no include. tape_domain, host_stage_present, xrealloc, memcpy of
   the tape, runroute, host_side_write, host_dl_slot, host_bind, and
   resource_u64 stay in exec/c/bind.c. */
static int bx_nz(int v) {
    return v != 0;
}
int bx_sym_model(int present) {
    if (bx_nz(present)) return 0;
    return 1;
}
int bx_sym_span(int n) {
    if (n > 2147483637) return 1;
    return 0;
}
int bx_sym_bytes(int n) {
    return n + 10;
}
int bx_sym_head(int target, unsigned char *out) {
    if (!out) return 4;
    out[0] = 'U'; out[1] = 'S'; out[2] = 'L'; out[3] = 'S';
    out[4] = 'Y'; out[5] = 'M'; out[6] = '1'; out[7] = '\n';
    out[8] = (unsigned char)target;
    out[9] = 0;
    return 0;
}
int bx_host_skip(int target, int mode) {
    if (!target) return 1;
    if (mode != 0 && mode != 3) return 1;
    return 0;
}
int bx_host_from(const char *first) {
    if (first) return 1;
    return 0;
}
int bx_host_side(int rc, const char *symbols) {
    if (bx_nz(rc) || !symbols) return 0;
    return 1;
}
int bx_host_kind(int native) {
    if (bx_nz(native)) return 2;
    return 1;
}
int bx_host_fill(int native) {
    if (bx_nz(native)) return 0;
    return 1;
}
int bx_host_bit(int j, int nonzero, int *out) {
    if (!out) return 4;
    if (j < 0 || j > 3) return 4;
    if (!bx_nz(nonzero)) { *out = 0; return 0; }
    *out = 1 << j;
    return 0;
}
int bx_host_keyn(void) {
    return 13;
}
int bx_host_elf(int mode, int present) {
    if (mode == 3 && !bx_nz(present)) return 1;
    return 0;
}
/* Remaining compiler.c refusals. snprintf, tbc_decode, tbc_encode,
   tape_domain_available, and clierror stay in exec/c. */
const char *bx_compat_why(int rc, int defrun, const char *src) {
    if (rc != 9) return 0;
    if (bx_nz(defrun) && src)
        return "missing compatibility argument (arguments for the program go after --: unisacc prog.c -- -x)";
    return "missing compatibility argument";
}
int bx_opt_dash(const char *a) {
    if (!a) return 4;
    if (a[0] == '-' && a[1]) return 1;
    return 0;
}
const char *bx_opt_why(int defrun, const char *src) {
    if (bx_nz(defrun) && src)
        return "option not migrated (arguments for the program go after --: unisacc prog.c -- --flag)";
    return "option not migrated";
}
const char *bx_src_why(const char *src) {
    if (!src) return "expected a C source file";
    return 0;
}
const char *bx_mix_why(int is_object) {
    if (bx_nz(is_object)) return 0;
    return "mix of objects and sources: compile each source with -c -b os/arch -funit first";
}
int bx_tape_need(int mode, int present) {
    if (mode == 1 || mode == 4) return 0;
    if (bx_nz(present)) return 0;
    return 1;
}
const char *bx_tape_why(void) {
    return "tape domain: required tapecheck model is missing";
}
int bx_tapebin_bad(int origin, int decoded) {
    if (!origin || decoded) return 1;
    return 0;
}
const char *bx_tapebin_why(void) {
    return "invalid tapebin or origin target mismatch";
}
int bx_name_fit(int n, int cap) {
    if (cap < 1) return 4;
    if (n < 0 || n >= cap) return 1;
    return 0;
}
const char *bx_name_why(void) {
    return "target name too long";
}
const char *bx_cache_why(int lk, int kind) {
    if (lk >= 0) return 0;
    if (kind == 0) return "reuse: cache read failed";
    if (kind == 1) return "host reuse: cache read failed";
    if (kind == 2) return "e3 reuse: cache read failed";
    if (kind == 3) return "artifact reuse: cache read failed";
    return 0;
}
int bx_frame_fit(int unit_n, int namelen) {
    long framed;
    framed = (long)unit_n + 4 + (long)namelen;
    if (framed > 2147483647) return 1;
    return 0;
}
const char *bx_frame_why(void) {
    return "unit frame too large";
}
int bx_encode_bad(int emitbin, int encoded) {
    if (bx_nz(emitbin) && encoded) return 1;
    return 0;
}
const char *bx_encode_why(void) {
    return "cannot encode tapebin";
}
const char *bx_route_why(void) {
    return "object unit route is absent from the selected package";
}
const char *bx_model_why(void) {
    return "bind: required host-symbols model is missing";
}
