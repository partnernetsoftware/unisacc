    if (bx_eq(a, "--strict-resource-flow")) return 1;
    if (bx_eq(a, "--resource-ledger")) return 2;
    return 0;
}
const char *bx_temp_dir(int kind, const char *tmpdir, const char *temp) {
    if (kind == 0) {
        if (tmpdir && tmpdir[0]) return tmpdir;
        if (temp && temp[0]) return temp;
        return "/tmp";
    }
    if (kind == 1) {
        if (tmpdir && tmpdir[0]) return tmpdir;
        return "/tmp";
    }
    return 0;
}
int bx_jobs(const char *text) {
    int i, sign, any;
    long long n;
    if (!text) return 8;
    i = 0;
    while (text[i] == ' ' || text[i] == '\t' || text[i] == '\n' || text[i] == '\r' || text[i] == '\v' || text[i] == '\f') i++;
    sign = 1;
    if (text[i] == '+' || text[i] == '-') {
        if (text[i] == '-') sign = -1;
        i++;
    }
    any = 0;
    n = 0;
    while (text[i] >= '0' && text[i] <= '9') {
        n = n * 10 + (text[i] - '0');
        any = 1;
        i++;
        if (n > 2147483648LL) break;
    }
    if (!any) return 0;
    if (sign < 0) {
        if (n >= 2147483648LL) return -2147483647 - 1;
        return (int)(-n);
    }
    if (n > 2147483647LL) return 2147483647;
    return (int)n;
}
int bx_jobs_pool(int jobs) {
    if (jobs > 64) return 64;
    return jobs;
}
int bx_unit_cache(int deps, const char *uc) {
    if (deps) return 0;
    if (uc && uc[0] == '0' && uc[1] == 0) return 0;
    return 1;
}
int bx_two_pass(const char *v) {
    if (v && v[0] == '1' && v[1] == 0) return 1;
    return 0;
}
