    if (!pkg || !argv0) return 0;
    if (bx_eq(pkg, argv0)) return 0;
    return pkg;
}
int bx_copy_fit(const char *src, char *out, int cap) {
    int n, i;
    if (!src || !out || cap < 1) return 4;
    n = bx_nlen(src);
    if (n >= cap) return 1;
    for (i = 0; i < n; i++) out[i] = src[i];
    out[n] = 0;
    return 0;
}
int bx_s_line(const char *err, char *out, int cap) {
    if (!err) return 4;
    return bx_join5("unisacc: error: -S: ", err, "\n", 0, 0, out, cap);
}
int bx_route_line(int kind, const char *target, int warn, int multi, int level, char *out, int cap) {
    char dec[16];
    int dn, need, at, i;
    if (kind < 0 || kind > 4) return 2;
    if (!target || !out || cap < 1) return 4;
    dn = 0;
    if (kind != 3 && kind != 4) dn = bx_digits(level, dec);
    need = 0;
    if (bx_need(&need, bx_nlen(target))) return 1;
    if (kind == 0) {
        if (bx_need(&need, 16) || bx_need(&need, dn)) return 1;
    } else if (kind == 1) {
        if (bx_need(&need, 14) || bx_need(&need, dn)) return 1;
    } else if (kind == 4) {
        if (bx_need(&need, 7)) return 1;
    } else if (kind == 3) {
        if (bx_need(&need, 1) || (warn && bx_need(&need, 5)) || bx_need(&need, 4)) return 1;
    } else {
        if (bx_need(&need, 1) || (warn && bx_need(&need, 5)) || (multi && bx_need(&need, 6)) || bx_need(&need, 7) || bx_need(&need, dn)) return 1;
    }
    if (need >= cap) return 1;
    at = 0;
    bx_put(out, &at, target);
    if (kind == 0) bx_put(out, &at, "/multi/fwdexec/O");
    else if (kind == 1) bx_put(out, &at, "/multi/image/O");
    else if (kind == 4) bx_put(out, &at, "/memory");
    else {
        out[at] = '/';
        at++;
        if (warn) bx_put(out, &at, "warn/");
        if (kind == 2 && multi) bx_put(out, &at, "multi/");
        if (kind == 2) bx_put(out, &at, "image/O");
        else bx_put(out, &at, "unit");
    }
    for (i = 0; i < dn; i++) { out[at] = dec[i]; at++; }
    out[at] = 0;
    return 0;
}
int bx_unit_file(const char *dir, int pid, int index, char *out, int cap) {
    char a[16], b[16];
    int an, bn, need, at, i;
    if (!dir || !out || cap < 1) return 4;
    an = bx_digits(pid, a);
    bn = bx_digits(index, b);
    need = 0;
    if (bx_need(&need, bx_nlen(dir)) || bx_need(&need, 9) || bx_need(&need, an) || bx_need(&need, 1) || bx_need(&need, bn)) return 1;
    if (need >= cap) return 1;
    at = 0;
    bx_put(out, &at, dir);
    bx_put(out, &at, "/ua-unit-");
    for (i = 0; i < an; i++) { out[at] = a[i]; at++; }
    out[at] = '-';
    at++;
    for (i = 0; i < bn; i++) { out[at] = b[i]; at++; }
    out[at] = 0;
    return 0;
}
int bx_pid_file(const char *path, int pid, char *out, int cap) {
    char dec[16];
    int dn, need, at, i;
    if (!path || !out || cap < 1) return 4;
    dn = bx_digits(pid, dec);
    need = 0;
    if (bx_need(&need, bx_nlen(path)) || bx_need(&need, 1) || bx_need(&need, dn)) return 1;
    if (need >= cap) return 1;
    at = 0;
    bx_put(out, &at, path);
    out[at] = '.';
    at++;
    for (i = 0; i < dn; i++) { out[at] = dec[i]; at++; }
    out[at] = 0;
    return 0;
}
static int bx_hex(unsigned long long v, char *buf) {
    char tmp[16];
    int n, i;
    unsigned int d;
    n = 0;
    if (v == 0) { buf[0] = '0'; return 1; }
    while (v) {
        d = (unsigned int)(v & 15ull);
        tmp[n] = (char)(d < 10u ? '0' + d : 'a' + (d - 10u));
        n++;
        v = v >> 4;
    }
    i = 0;
    while (n) { n--; buf[i] = tmp[n]; i++; }
    return i;
}
int bx_fwd_path(int win, const char *dir, unsigned long long tag, char *out, int cap) {
    char hex[16];
    const char *pre;
    int hn, need, at, i;
    if (!out || cap < 1) return 4;
    if (win) {
        if (!dir) return 4;
        pre = "\\unisacc-forward-";
    } else {
        dir = "/tmp";
        pre = "/unisacc-forward-";
    }
    hn = bx_hex(tag, hex);
    need = 0;
    if (bx_need(&need, bx_nlen(dir)) || bx_need(&need, bx_nlen(pre)) || bx_need(&need, hn) || bx_need(&need, 2)) return 1;
    if (need >= cap) return 1;
    at = 0;
    bx_put(out, &at, dir);
    bx_put(out, &at, pre);
    for (i = 0; i < hn; i++) { out[at] = hex[i]; at++; }
    out[at] = '.';
    at++;
    out[at] = 'c';
    at++;
    out[at] = 0;
    return 0;
}
static int bx_dbg3(const char *a, int hx, int x, const char *b, int hy, int y, const char *c, int hz, int z, const char *text, char *out, int cap) {
    char dx[16], dy[16], dz[16];
    int nx, ny, nz, need, at, i;
    if (!out || cap < 1) return 4;
    nx = hx ? bx_digits(x, dx) : 0;
    ny = hy ? bx_digits(y, dy) : 0;
    nz = hz ? bx_digits(z, dz) : 0;
    need = 0;
    if (bx_need(&need, a ? bx_nlen(a) : 0) || bx_need(&need, nx) || bx_need(&need, b ? bx_nlen(b) : 0) || bx_need(&need, ny)
        || bx_need(&need, c ? bx_nlen(c) : 0) || bx_need(&need, nz) || bx_need(&need, text ? bx_nlen(text) : 0) || bx_need(&need, 1)) return 1;
    if (need >= cap) return 1;
    at = 0;
    if (a) bx_put(out, &at, a);
    for (i = 0; i < nx; i++) { out[at] = dx[i]; at++; }
    if (b) bx_put(out, &at, b);
    for (i = 0; i < ny; i++) { out[at] = dy[i]; at++; }
    if (c) bx_put(out, &at, c);
    for (i = 0; i < nz; i++) { out[at] = dz[i]; at++; }
    if (text) bx_put(out, &at, text);
    out[at] = '\n';
    at++;
    out[at] = 0;
    return 0;
}
int bx_dbg_probe(int kind, int lk, const char *route, char *out, int cap) {
    const char *head;
    if (kind != 0 && kind != 1) return 2;
    if (!route || !route[0]) return 4;
    head = kind ? "unisacc: rr early multi-image probe lk=" : "unisacc: rr early multi-run probe lk=";
    return bx_dbg3(head, 1, lk, " route=", 0, 0, 0, 0, 0, route, out, cap);
}
int bx_dbg_hexfail(int nsources, char *out, int cap) {
    return bx_dbg3("unisacc: rr early sources_hex failed nsources=", 1, nsources, 0, 0, 0, 0, 0, 0, 0, out, cap);
}
int bx_dbg_lookup(int lk, int mode, const char *route, char *out, int cap) {
    if (!route || !route[0]) return 4;
    return bx_dbg3("unisacc: rr early lookup lk=", 1, lk, " mode=", 1, mode, " route=", 0, 0, route, out, cap);
}
int bx_dbg_host(int rc, int tape_n, int attrs_n, char *out, int cap) {
    return bx_dbg3("unisacc: host reuse store failed rc=", 1, rc, " tape_n=", 1, tape_n, " attrs_n=", 1, attrs_n, 0, out, cap);
}
int bx_dbg_stub(int rc, int receipts, int absent, char *out, int cap) {
    return bx_dbg3("unisacc: rr stub store rc=", 1, rc, " receipts=", 1, receipts, " absent=", 1, absent, 0, out, cap);
}
const char *bx_file_mode(int kind) {
    if (kind == 0) return "rb";
    if (kind == 1) return "wb";
    if (kind == 2) return "w";
    return 0;
}
int bx_open_miss(int kind, int opened, int enoent) {
    if (opened) return 0;
    if (kind == 0) return enoent ? -1 : -3;
    if (kind == 1) return 1;
    if (kind == 2) return -1;
    return 4;
}
int bx_env_temp(const char *td) {
    if (td && td[0]) return 0;
    return 1;
}
const char *bx_env_dot(const char *p) {
    if (p) return p;
    return ".";
}
int bx_env_set(const char *v) {
    if (v && v[0]) return 1;
    return 0;
}
const char *bx_env_blank(const char *v) {
    if (v && !v[0]) return 0;
    return v;
}
int bx_loader_why(const char *loader, char *out, int cap) {
    if (!loader || !loader[0]) return 4;
    return bx_join5("this program calls the host C library, and running it needs the host's dynamic loader ",
        loader,
        ", which could not be opened here (as on a system without glibc); write the program with -o and run it where glibc is installed",
        0, 0, out, cap);
}
