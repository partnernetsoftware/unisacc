#pragma unisa module codecgate
/* Pure returns from exec/c/codec.h. The bitstream, the CRC table, and
   puff stay in that header and in cx/runtime/codec.cx. A missing buffer
   returns -12, matching unisa_inflate. A nonzero puff code is returned
   as-is. Counts that differ after a zero code return 3. A block type
   other than 0, 1, or 2 returns -1. A negative type returns 4. That 4
   was not on the old path, which only sees two bits. A set error flag
   returns 2, matching the bits failure. One CRC reflection step xors
   3988292384 when the low bit is set. The value is masked to 32 bits. */
int cd_inflate(int out_present, int in_present, int rc, int n_same, int m_same) {
    if (out_present == 0 || in_present == 0) return 0 - 12;
    if (rc) return rc;
    if (n_same == 0 || m_same == 0) return 3;
    return 0;
}
int cd_puff_type(int type) {
    if (type < 0) return 4;
    if (type == 0 || type == 1 || type == 2) return 0;
    return 0 - 1;
}
int cd_bits_err(int error) {
    if (error) return 2;
    return 0;
}
/* bitcnt < need means another input byte is required. A negative count
   returns 4. bits() does not treat 4 as a request for another byte. */
int cd_bits_more(int bitcnt, int need) {
    if (bitcnt < 0 || need < 0) return 4;
    if (bitcnt < need) return 1;
    return 0;
}
/* incnt == inlen is the old end of input. That returns 2, matching bits(). */
int cd_bits_end(unsigned long long incnt, unsigned long long inlen) {
    if (incnt == inlen) return 2;
    return 0;
}
/* OR one input byte into the bit buffer at bitcnt. A null out, a byte
   outside 0..255, or a shift outside 0..56 returns 4 and writes nothing. */
int cd_bits_join(unsigned long long val, int byte, int bitcnt, unsigned long long *out) {
    if (!out) return 4;
    if (byte < 0 || byte > 255 || bitcnt < 0 || bitcnt > 56) return 4;
    *out = val | ((unsigned long long)byte << bitcnt);
    return 0;
}
/* bitcnt + n. A null out or a negative operand returns 4 and writes nothing. */
int cd_bits_add(int bitcnt, int n, int *out) {
    if (!out) return 4;
    if (bitcnt < 0 || n < 0) return 4;
    *out = bitcnt + n;
    return 0;
}
/* val >> need, the bits left in the buffer. */
int cd_bits_keep(unsigned long long val, int need, int *out) {
    if (!out) return 4;
    if (need < 0 || need > 62) return 4;
    *out = (int)(val >> need);
    return 0;
}
/* bitcnt - need. */
int cd_bits_left(int bitcnt, int need, int *out) {
    if (!out) return 4;
    if (bitcnt < 0 || need < 0) return 4;
    *out = bitcnt - need;
    return 0;
}
/* Low need bits of val. need 0 yields 0. */
int cd_bits_mask(unsigned long long val, int need, int *out) {
    if (!out) return 4;
    if (need < 0 || need > 62) return 4;
    if (need == 0) {
        *out = 0;
        return 0;
    }
    *out = (int)(val & ((1ull << need) - 1ull));
    return 0;
}
/* One step of while (symbol--). symbol 0 stops and writes nothing.
   A positive symbol writes the current index, then symbol-1 and index+1.
   A null pointer or a negative argument returns 4. dynamic() does not
   return that 4. */
int cd_len_step(int symbol, int index, int *next_symbol, int *next_index) {
    if (!next_symbol || !next_index) return 4;
    if (symbol < 0 || index < 0) return 4;
    if (symbol == 0) return 0;
    *next_symbol = symbol - 1;
    *next_index = index + 1;
    return 1;
}
/* Block type 0, 1, 2 is that type. Any other non-negative type returns -1.
   A negative type returns 4. puff maps every value other than 0, 1, 2 to -1,
   so 4 is not a puff return. */
int cd_block_pick(int type) {
    if (type < 0) return 4;
    if (type == 0 || type == 1 || type == 2) return type;
    return 0 - 1;
}
/* Continue only when the block returned 0 and this is not the last block.
   Any other err or a nonzero last returns 0. */
int cd_puff_more(int err, int last) {
    if (err != 0) return 0;
    if (last != 0) return 0;
    return 1;
}
/* err <= 0 writes the consumed lengths. A positive err returns 0. */
int cd_puff_keep(int err) {
    if (err <= 0) return 1;
    return 0;
}
/* Stored length complement. which 0 is the low byte, 1 is the next byte.
   A mismatch returns -2. A null-sized bad argument returns 4, which stored
   does not return. */
int cd_stored_byte(int len, int which, int got) {
    int want;
    if (len < 0 || got < 0 || got > 255 || which < 0 || which > 1) return 4;
    if (which == 0) want = (~len) & 255;
    else want = ((~len) >> 8) & 255;
    if (got != want) return 0 - 2;
    return 0;
}
/* at + add past cap returns over. over is 2 for input and 1 for output.
   Any other over returns 4. stored does not return that 4. */
int cd_room(unsigned long long at, unsigned long long add, unsigned long long cap, int over) {
    if (over != 1 && over != 2) return 4;
    if (at + add > cap) return over;
    return 0;
}
/* dynamic() repeat: 16 copies the previous length and reads 2 bits, base 3.
   index 0 on symbol 16 returns -5. 17 reads 3 bits, base 3, fill 0.
   Anything else, including 18, reads 7 bits, base 11, fill 0.
   A null pointer or a negative index or symbol returns 4. That 4 is not
   a return of dynamic(). */
int cd_len_rep(int symbol, int index, int *bits_n, int *base, int *copy) {
    if (!bits_n || !base || !copy) return 4;
    if (index < 0 || symbol < 0) return 4;
    if (symbol == 16) {
        if (index == 0) return 0 - 5;
        *bits_n = 2;
        *base = 3;
        *copy = 1;
        return 0;
    }
    if (symbol == 17) {
        *bits_n = 3;
        *base = 3;
        *copy = 0;
        return 0;
    }
    *bits_n = 7;
    *base = 11;
    *copy = 0;
    return 0;
}
/* index + count past nlen + ndist returns -6. A negative argument returns 4.
   That 4 is not a return of dynamic(). */
int cd_len_room(int index, int count, int nlen, int ndist) {
    if (index < 0 || count < 0 || nlen < 0 || ndist < 0) return 4;
    if (index + count > nlen + ndist) return 0 - 6;
    return 0;
}
unsigned long long cd_crc_step(unsigned long long c) {
    unsigned long long n;
    n = c & 4294967295ull;
    if (n & 1ull) return ((n >> 1) ^ 3988292384ull) & 4294967295ull;
    return (n >> 1) & 4294967295ull;
}
