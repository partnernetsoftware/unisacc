#pragma unisa module codecgate
/* Pure returns from exec/c/codec.h. The bitstream, the CRC table, and
   puff stay in that header and in cx/runtime/codec.cx. A missing buffer
   returns -12, matching unisa_inflate. A nonzero puff code is returned
   as-is. Counts that differ after a zero code return 3. A block type
   other than 0, 1, or 2 returns -1. A negative type returns 4. That 4
   was not on the old path, which only sees two bits. A set error flag
   returns 2, matching the bits failure. One CRC reflection step xors
   3988292384 when the low bit is set. The value is masked to 32 bits. */
int cd_inflate(int out_present, int in_present, int rc, int n_same, int m_same) {
    if (out_present == 0 || in_present == 0) return 0 - 12;
    if (rc) return rc;
    if (n_same == 0 || m_same == 0) return 3;
    return 0;
}
int cd_puff_type(int type) {
    if (type < 0) return 4;
    if (type == 0 || type == 1 || type == 2) return 0;
    return 0 - 1;
}
int cd_bits_err(int error) {
    if (error) return 2;
    return 0;
}
unsigned long long cd_crc_step(unsigned long long c) {
    unsigned long long n;
    n = c & 4294967295ull;
    if (n & 1ull) return ((n >> 1) ^ 3988292384ull) & 4294967295ull;
    return (n >> 1) & 4294967295ull;
}
