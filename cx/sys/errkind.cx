#pragma unisa module errkind
#pragma unisa dock
/* L0 sys/errkind: classify a normalized error code by how the caller handles it
   (docs/cx/design-core.md section 11 rule (2), prd_cx.md 0.7 C5).  No #include: the E*
   names come with the implicit prelude.  Pure: no syscall, no state, no platform branch.
   The class list may grow; callers must keep a fallback branch (SY_K_OTHER). */

enum {
    SY_K_NONE = 0,       /* e == 0: not an error */
    SY_K_NOTFOUND,       /* ENOENT, ESRCH */
    SY_K_EXISTS,         /* EEXIST */
    SY_K_PERM,           /* EACCES, EPERM, EROFS */
    SY_K_NOTDIR,         /* ENOTDIR */
    SY_K_ISDIR,          /* EISDIR */
    SY_K_NOTEMPTY,       /* ENOTEMPTY */
    SY_K_AGAIN,          /* EAGAIN, EINTR, EBUSY */
    SY_K_PIPE,           /* EPIPE, ECONNRESET: peer went away */
    SY_K_REFUSED,        /* ECONNREFUSED */
    SY_K_TIMEOUT,        /* ETIMEDOUT */
    SY_K_INVAL,          /* EINVAL, EFAULT */
    SY_K_BADH,           /* EBADF: bad handle */
    SY_K_RANGE,          /* ERANGE, ENAMETOOLONG, E2BIG, EOVERFLOW: capacity */
    SY_K_NOMEM,          /* ENOMEM, ENOSPC, EMFILE, ENFILE: resource exhausted */
    SY_K_UNSUPPORTED,    /* ENOSYS */
    SY_K_NAME,           /* name resolution; no normalized code maps here yet */
    SY_K_OTHER           /* every code not listed above */
};

/* The SY_K_* class of E, given as errno (E > 0) or as a sy_* -errno (E < 0).
   0 is SY_K_NONE; an unknown code is SY_K_OTHER.  Never fails. */
int sy_err_kind(int e) {
    if (e == 0) return SY_K_NONE;
    if (e < 0) {
        if (e == -2147483647 - 1) return SY_K_OTHER;   /* INT_MIN has no positive twin */
        e = -e;
    }
    if (e == ENOENT || e == ESRCH) return SY_K_NOTFOUND;
    if (e == EEXIST) return SY_K_EXISTS;
    if (e == EACCES || e == EPERM || e == EROFS) return SY_K_PERM;
    if (e == ENOTDIR) return SY_K_NOTDIR;
    if (e == EISDIR) return SY_K_ISDIR;
    if (e == ENOTEMPTY) return SY_K_NOTEMPTY;
    if (e == EAGAIN || e == EINTR || e == EBUSY) return SY_K_AGAIN;
    if (e == EPIPE || e == ECONNRESET) return SY_K_PIPE;
    if (e == ECONNREFUSED) return SY_K_REFUSED;
    if (e == ETIMEDOUT) return SY_K_TIMEOUT;
    if (e == EINVAL || e == EFAULT) return SY_K_INVAL;
    if (e == EBADF) return SY_K_BADH;
    if (e == ERANGE || e == ENAMETOOLONG || e == E2BIG || e == EOVERFLOW) return SY_K_RANGE;
    if (e == ENOMEM || e == ENOSPC || e == EMFILE || e == ENFILE) return SY_K_NOMEM;
    if (e == ENOSYS) return SY_K_UNSUPPORTED;
    return SY_K_OTHER;
}
