#pragma unisa module env
/* L0 sys/env: the process environment (plans/cx-layers.md). The only file in
   cx/sys/ that calls getenv; upper layers ask here. No #include: <stdlib.h>
   comes with the implicit prelude.
   Note: setenv in this runtime is an in-process table that a child process
   does not see; pass a child its environment through env(1) or its argv. */

/* The value of NAME, or 0 when NAME is unset. The string belongs to the
   environment: copy it before the next sy_env call if it must outlive it. */
const char *sy_env(const char *name) {
    if (!name || !name[0]) return 0;
    return getenv(name);
}

/* NAME's value when set and non-empty, else FALLBACK. */
const char *sy_env_or(const char *name, const char *fallback) {
    const char *v = sy_env(name);
    return v && v[0] ? v : fallback;
}
