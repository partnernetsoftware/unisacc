#pragma unisa module mem
#include <sys/mman.h>
/* L0 sys/mem: anonymous reserve and permission changes (plans/cx-layers.md).
   <sys/mman.h> is not in the prelude. 0 on success, -errno on failure.
   Windows has no mmap here: -ENOSYS. Elsewhere the gates are __mmap,
   __munmap and __mprotect, so this unit does not reference the libc names.
   Exported functions stay outside #if. */

static int sym_fail(void) { return errno ? -errno : -1; }

static int sym_map(void **out, long n) {
#if defined(_WIN32)
    (void)out;
    (void)n;
    return -ENOSYS;
#else
    long result;
    errno = 0;
    result = __mmap(0, (long)n, (long)PROT_NONE, (long)(MAP_PRIVATE | MAP_ANON), -1, 0);
    if (result < 0) {
        errno = (int)-result;
        return sym_fail();
    }
    if (!result) return sym_fail();
    *out = (void *)result;
    return 0;
#endif
}

static int sym_unmap(void *p, long n) {
#if defined(_WIN32)
    (void)p;
    (void)n;
    return -ENOSYS;
#else
    long result;
    errno = 0;
    result = __munmap((long)p, (long)n);
    if (result < 0) {
        errno = (int)-result;
        return sym_fail();
    }
    return 0;
#endif
}

/* kind 1: read and write. kind 2: read and execute. PROT_* exist only
   outside _WIN32, so the exported functions pass a kind, not those names. */
static int sym_prot(void *p, long n, int kind) {
#if defined(_WIN32)
    (void)p;
    (void)n;
    (void)kind;
    return -ENOSYS;
#else
    int prot;
    long result;
    errno = 0;
    if (kind == 1) prot = PROT_READ | PROT_WRITE;
    else prot = PROT_READ | PROT_EXEC;
    result = __mprotect((long)p, (long)n, (long)prot);
    if (result < 0) {
        errno = (int)-result;
        return sym_fail();
    }
    return 0;
#endif
}

/* Map N bytes of anonymous private memory, no access, into *OUT. */
int sy_map_none(void **out, long n) {
    if (!out || n < 0) return -EINVAL;
    *out = 0;
    return sym_map(out, n);
}

/* Drop a mapping from sy_map_none. */
int sy_unmap(void *p, long n) {
    if (!p || n < 0) return -EINVAL;
    return sym_unmap(p, n);
}

/* Allow read and write on N bytes at P. */
int sy_protect_rw(void *p, long n) {
    if (!p || n < 0) return -EINVAL;
    return sym_prot(p, n, 1);
}

/* Allow read and execute on N bytes at P. */
int sy_protect_rx(void *p, long n) {
    if (!p || n < 0) return -EINVAL;
    return sym_prot(p, n, 2);
}
