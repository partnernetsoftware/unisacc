#pragma unisa module sysinfo
#pragma unisa dock
/* L0 sys/sysinfo: target names, page size, errno and signal name tables, one write, a 64-bit seek
   (prd_cx.md 0.7 C5, build/std-surface.tsv cx.sys).  No #include; no libc call outside the prelude
   syscall wrappers.  The numbers come from the prelude's own E* and SIG* names, so each target gets
   its own values; platform differences live only in the static _os helpers. */

static const char *sy_os_name_os(void) {
#ifdef _WIN32
    return "windows";
#else
#ifdef __APPLE__
    return "macos";
#else
    return "linux";
#endif
#endif
}

/* Target OS word: "linux", "macos" or "windows". Never 0. */
const char *sy_os_name(void) { return sy_os_name_os(); }

static const char *sy_arch_name_os(void) {
#ifdef __aarch64__
    return "arm64";
#else
    return "x86_64";
#endif
}

/* Target architecture word: "x86_64" or "arm64". Never 0. */
const char *sy_arch_name(void) { return sy_arch_name_os(); }

static long sy_page_size_os(void) {
#if defined(__APPLE__) && defined(__aarch64__)
    return 16384;
#else
    return 4096;
#endif
}

/* The virtual-memory page size in bytes (4096; 16384 on macOS arm64). */
long sy_page_size(void) { return sy_page_size_os(); }

typedef struct { const char *name; int val; } sy_nv;

#define SYI_E(x) { #x, x }
static const sy_nv sy_errno_tab[] = {
    SYI_E(EPERM), SYI_E(ENOENT), SYI_E(ESRCH), SYI_E(EINTR), SYI_E(EIO), SYI_E(ENXIO), SYI_E(E2BIG),
    SYI_E(ENOEXEC), SYI_E(EBADF), SYI_E(ECHILD), SYI_E(EAGAIN), SYI_E(ENOMEM), SYI_E(EACCES),
    SYI_E(EFAULT), SYI_E(EBUSY), SYI_E(EEXIST), SYI_E(EXDEV), SYI_E(ENODEV), SYI_E(ENOTDIR),
    SYI_E(EISDIR), SYI_E(EINVAL), SYI_E(ENFILE), SYI_E(EMFILE), SYI_E(ENOTTY), SYI_E(EFBIG),
    SYI_E(ENOSPC), SYI_E(ESPIPE), SYI_E(EROFS), SYI_E(EMLINK), SYI_E(EPIPE), SYI_E(EDOM),
    SYI_E(ERANGE), SYI_E(EDEADLK), SYI_E(ENAMETOOLONG), SYI_E(ENOLCK), SYI_E(ENOSYS),
    SYI_E(ENOTEMPTY), SYI_E(ELOOP), SYI_E(EOVERFLOW), SYI_E(EILSEQ), SYI_E(ENOTSOCK),
    SYI_E(EMSGSIZE), SYI_E(EPROTOTYPE), SYI_E(ENOPROTOOPT), SYI_E(EPROTONOSUPPORT),
    SYI_E(EOPNOTSUPP), SYI_E(EAFNOSUPPORT), SYI_E(EADDRINUSE), SYI_E(EADDRNOTAVAIL),
    SYI_E(ENETDOWN), SYI_E(ENETUNREACH), SYI_E(ECONNABORTED), SYI_E(ECONNRESET), SYI_E(ENOBUFS),
    SYI_E(EISCONN), SYI_E(ENOTCONN), SYI_E(ETIMEDOUT), SYI_E(ECONNREFUSED), SYI_E(EHOSTUNREACH),
    SYI_E(EALREADY), SYI_E(EINPROGRESS), SYI_E(ESTALE), SYI_E(EDQUOT), SYI_E(ECANCELED),
    { 0, 0 }
};

#define SYI_S(x) { #x, x }
static const sy_nv sy_sig_tab[] = {
    SYI_S(SIGHUP), SYI_S(SIGINT), SYI_S(SIGQUIT), SYI_S(SIGILL), SYI_S(SIGABRT), SYI_S(SIGFPE),
    SYI_S(SIGKILL), SYI_S(SIGSEGV), SYI_S(SIGPIPE), SYI_S(SIGTERM), SYI_S(SIGUSR1), SYI_S(SIGUSR2),
    { 0, 0 }
};

static const char *syi_name(const sy_nv *t, int v) {
    int i;
    for (i = 0; t[i].name; i++) if (t[i].val == v) return t[i].name;
    return 0;
}

static int syi_of(const sy_nv *t, const char *name) {
    int i;
    if (!name) return 0;
    for (i = 0; t[i].name; i++) {
        const char *a = t[i].name, *b = name;
        while (*a && *a == *b) { a++; b++; }
        if (*a == 0 && *b == 0) return t[i].val;
    }
    return 0;
}

/* The errno name of E ("ENOENT"); E may be given as errno or as -errno. 0 for 0 or an unknown code. */
const char *sy_errno_name(int e) {
    if (e == 0 || e == -2147483647 - 1) return 0;
    return syi_name(sy_errno_tab, e < 0 ? -e : e);
}

/* The positive errno value of NAME ("ENOENT") on this target; 0 when NAME is 0 or unknown. */
int sy_errno_of(const char *name) { return syi_of(sy_errno_tab, name); }

/* The signal name of SIG ("SIGINT"); 0 for an unknown number. */
const char *sy_sig_name(int sig) { return sig <= 0 ? 0 : syi_name(sy_sig_tab, sig); }

/* The signal number of NAME ("SIGUSR1") on this target; 0 when unknown. */
int sy_sig_number(const char *name) { return syi_of(sy_sig_tab, name); }

/* One write(2): the count (maybe fewer than N), or -errno; EINTR retried. N == 0 returns 0. */
long sy_write(int fd, const void *buf, long n) {
    ssize_t k;
    if (fd < 0 || (!buf && n > 0) || n < 0) return -EINVAL;
    if (n == 0) return 0;
    do { errno = 0; k = write(fd, buf, (size_t)n); } while (k < 0 && errno == EINTR);
    return k < 0 ? (errno ? -errno : -EIO) : (long)k;
}

/* Reposition FD with a 64-bit offset (WHENCE: SEEK_SET, SEEK_CUR, SEEK_END). The new offset, or -errno. */
int64_t sy_seek64(int fd, int64_t off, int whence) {
    off_t r;
    if (fd < 0 || whence < 0 || whence > 2) return -EINVAL;
    errno = 0;
    r = lseek(fd, (off_t)off, whence);
    return r < 0 ? (errno ? -(int64_t)errno : -(int64_t)EIO) : (int64_t)r;
}
