#pragma unisa module runlaunch
#pragma unisa dock
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.posix
/* L0 sys/runlaunch: the tmpfile -run launch (pp-targets.tsv run_launch=tmpfile:
   osx/* and win/*). A private 0700 directory under TMPDIR holds the image; the
   child runs and is waited for; file and directory go either way. The child's
   status is returned (128+N for signal N). Platform spawn stays in rl_run_os:
   Apple fork/execv, Windows CreateProcessA via hostcall; every other host is
   -ENOSYS so a non-tmpfile slice (lnx memfd) carries no process-spawn code. */

/* Image basename under the private directory (Windows needs a .exe suffix). */
static const char *rl_imgname_os(void) {
#if defined(_WIN32)
    return "a.exe";
#else
    return "a.out";
#endif
}

/* MS C runtime command-line quoting into DST[at..cap). New at, or -1. */
static int rl_cmdarg(char *dst, int at, int cap, const char *s) {
    int i, b, q;
    q = s[0] == 0;
    for (i = 0; s[i]; i = i + 1) if (s[i] == 32 || s[i] == 9 || s[i] == 34) q = 1;
    if (!q) {
        for (i = 0; s[i]; i = i + 1) { if (at >= cap) return -1; dst[at] = s[i]; at = at + 1; }
        return at;
    }
    if (at >= cap) return -1; dst[at] = 34; at = at + 1;
    for (i = 0; ; i = i + 1) {
        b = 0; while (s[i] == 92) { b = b + 1; i = i + 1; }
        if (s[i] == 0) b = b * 2; else if (s[i] == 34) b = b * 2 + 1;
        while (b > 0) { if (at >= cap) return -1; dst[at] = 92; at = at + 1; b = b - 1; }
        if (s[i] == 0) break;
        if (at >= cap) return -1; dst[at] = s[i]; at = at + 1;
    }
    if (at >= cap) return -1; dst[at] = 34; return at + 1;
}

/* Start PATH with ARGV and wait: its status, or -errno. Only the tmpfile slices have it. */
static int rl_run_os(const char *path, char **argv) {
#if defined(__APPLE__)
    int st, pid = fork();
    if (pid < 0) return -errno;
    if (pid == 0) { execv(path, argv); _exit(127); }
    while (waitpid(pid, &st, 0) < 0) if (errno != EINTR) return -errno;
    return WIFEXITED(st) ? WEXITSTATUS(st) : 128 + WTERMSIG(st);
#elif defined(_WIN32)
    static __u_word cp, wf, ge, ch;
    static char cmd[8192];
    __u_word si[13], pi[3], a[10];
    __u_word code;
    int i, at, r;
    char *sb;
    if (!cp) {
        cp = _ux_sym("CreateProcessA");
        wf = _ux_sym("WaitForSingleObject");
        ge = _ux_sym("GetExitCodeProcess");
        ch = _ux_sym("CloseHandle");
    }
    if (!cp || !wf || !ge || !ch) return -ENOSYS;
    at = 0;
    for (i = 0; argv[i]; i = i + 1) {
        if (i) { if (at >= 8190) return -E2BIG; cmd[at] = 32; at = at + 1; }
        at = rl_cmdarg(cmd, at, 8190, argv[i]);
        if (at < 0) return -E2BIG;
    }
    cmd[at] = 0;
    for (i = 0; i < 13; i = i + 1) si[i] = 0;
    for (i = 0; i < 3; i = i + 1) pi[i] = 0;
    for (i = 0; i < 10; i = i + 1) a[i] = 0;
    sb = (char *)si; *(int *)sb = 104;   /* STARTUPINFOA.cb (LLP64) */
    a[0] = (__u_word)path;
    a[1] = (__u_word)cmd;
    a[4] = 1;                              /* bInheritHandles */
    a[8] = (__u_word)si;
    a[9] = (__u_word)pi;
    r = (int)(__hostcall(cp, a) & 0xFFFFFFFFL);
    if (!r) { _ux_fail(); return errno ? -errno : -1; }
    if (pi[1]) _ux_call(ch, pi[1], 0, 0, 0);   /* close hThread */
    _ux_call(wf, pi[0], 0xFFFFFFFFL, 0, 0);
    code = 0;
    if (!(_ux_call(ge, pi[0], (__u_word)&code, 0, 0) & 0xFFFFFFFFL)) {
        _ux_call(ch, pi[0], 0, 0, 0);
        _ux_fail();
        return errno ? -errno : -1;
    }
    _ux_call(ch, pi[0], 0, 0, 0);
    return (int)(code & 0xff);
#else
    (void)path; (void)argv;
    return -ENOSYS;
#endif
}

int rl_tmpfile_exec(const unsigned char *image, long n, char **argv) {
    const char *tmp = sy_tmpdir();
    char dir[4096], path[4200];
    char **av;
    int k, fd, rc;
    rc = -EEXIST;
    for (k = 0; k < 16 && rc == -EEXIST; k++) {
        rc = cx_fmt(dir, sizeof dir, "%s/unisacc-run.%d.%d", tmp, (int)getpid(), (int)((sy_now_ms() + k) & 0xffffff)) ? -ENAMETOOLONG : sy_mkdir(dir, 0700);
    }
    if (rc) { fprintf(stderr, "unisacc: -run: cannot make a directory in TMPDIR %s (errno %d); set TMPDIR to a writable directory or write the program with -o\n", tmp, -rc); return 1; }
    (void)cx_fmt(path, sizeof path, "%s/%s", dir, rl_imgname_os());   /* dir < 4096 bytes: fits in path */
    for (k = 0; argv[k]; k++) {}
    av = malloc(sizeof(char *) * (size_t)(k + 1));
    fd = av ? sy_open_new(path, 0700) : -ENOMEM;
    rc = fd < 0 ? fd : sy_write_all(fd, image, n);
    if (fd >= 0 && sy_close(fd) && !rc) rc = -EIO;
    if (!rc) rc = sy_chmod(path, 0700);
    if (!rc) {
        av[0] = path;
        for (k = 1; argv[k - 1] && argv[k]; k++) av[k] = argv[k];
        av[k] = 0;
        fflush(stdout); fflush(stderr);
        rc = rl_run_os(path, av);
        if (rc < 0) fprintf(stderr, "unisacc: -run: cannot execute from TMPDIR %s (errno %d); set TMPDIR to an executable directory or write the program with -o\n", tmp, -rc);
    } else fprintf(stderr, "unisacc: -run: cannot write the program into TMPDIR %s (errno %d); set TMPDIR to a writable directory or write the program with -o\n", tmp, -rc);
    free(av);
    sy_unlink(path);
    sy_rmdir(dir);
    return rc < 0 ? 1 : rc;
}

/* Directory-open flags for rl_run_link; Windows' prelude has no O_NOFOLLOW or
   O_DIRECTORY (and sy_openat is -ENOSYS there anyway). */
static int rl_dirflags_os(void) {
#if defined(_WIN32)
    return 0;
#else
    return O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC;
#endif
}

/* The kernel names an exec'd process (comm) after the exec path's basename, so
   the memfd launch's execveat(63, "", AT_EMPTY_PATH) shows up as "63". Open
   TMPDIR/unisacc-run-UID as a directory fd D (no symlink followed, owner must
   be this euid, mode 0700), make D/BASE (BASE = ARGV0's basename) a fixed
   symlink to /proc/self/fd/63, and write DST = /proc/self/fd/D/BASE: an exec
   of DST is pinned to the checked directory and comm is BASE. Returns D
   (close-on-exec, never 63; the caller closes it if the exec fails), or -1
   when any step fails (the caller keeps the AT_EMPTY_PATH exec). */
int rl_run_link(const char *argv0, char *dst, int cap) {
    char dir[4096], got[32];
    const char *b, *s;
    sy_stat_t st;
    long r;
    int mk, d;
    b = argv0 ? argv0 : "";
    for (s = b; *s; s++) if (*s == '/') b = s + 1;
    if (!b[0] || !strcmp(b, ".") || !strcmp(b, "..")) b = "unisacc-run";
    if (cx_fmt(dir, sizeof dir, "%s/unisacc-run-%d", sy_tmpdir(), sy_uid())) return -1;
    mk = sy_mkdir(dir, 0700);
    if (mk && mk != -EEXIST) return -1;
    d = sy_openat(sy_at_fdcwd(), dir, rl_dirflags_os(), 0);
    if (d < 0) return -1;
    mk = d == 63 || sy_fstat(d, &st) || st.kind != 'd' || st.uid != sy_euid() || (st.mode & 0777) != 0700
        || cx_fmt(dst, cap, "/proc/self/fd/%d/%s", d, b);
    if (!mk) { mk = sy_symlink("/proc/self/fd/63", dst); mk = mk && mk != -EEXIST; }
    r = mk ? 0 : sy_readlink(dst, got, sizeof got - 1);
    got[r == 16 ? 16 : 0] = 0;
    if (mk || strcmp(got, "/proc/self/fd/63")) { sy_close(d); return -1; }
    return d;
}
