#pragma unisa module dlcall
#include <dlfcn.h>
/* L0 sys/dlcall: the host loader calls, split from sys.dl.
   dlopen/dlsym/dlclose are undeclared host imports; the static 33-object
   product cannot import them, so sys.dl (used by host.cx through
   sy_dl_addr) must not carry them. Programs that really load a library
   use this module instead; a whole-program or -run image is dynamically
   linked for the import. Windows has no dlfcn: open and sym return 0,
   close returns -ENOSYS. Exported functions stay outside #if. */

static void *dcl_open(const char *path, int mode) {
#if defined(_WIN32)
    (void)path;
    (void)mode;
    return 0;
#else
    return dlopen(path, mode);
#endif
}

static void *dcl_sym(void *handle, const char *name) {
#if defined(_WIN32)
    (void)handle;
    (void)name;
    return 0;
#else
    return dlsym(handle, name);
#endif
}

static int dcl_close(void *handle) {
#if defined(_WIN32)
    (void)handle;
    return -ENOSYS;
#else
    int rc;
    errno = 0;
    rc = dlclose(handle);
    if (rc == 0) return 0;
    return errno ? -errno : -EIO;
#endif
}

void *sy_dlopen(const char *path, int mode) { return dcl_open(path, mode); }

void *sy_dlsym(void *handle, const char *name) { return dcl_sym(handle, name); }

int sy_dlclose(void *handle) { return dcl_close(handle); }
