#pragma unisa module syscall
#pragma unisa dock
/* L0 sys/syscall: thin wrapper over the compiler's __syscall6 intrinsic
   (6 operands: syscall number nr + 5 arguments a0..a4).
   No syscall number constants live here; callers obtain per-target numbers
   from sys.sysnums (exec/facts/sys-syscalls.tsv).
   On Linux and macOS, forwards to __syscall6(_UNISA_SC(nr), a0..a4) and
   returns the kernel result or -errno. On Windows, returns -ENOSYS. */

static long sy_syscall6_os(long nr, long a0, long a1, long a2, long a3, long a4) {
#if defined(_WIN32)
    (void)nr; (void)a0; (void)a1; (void)a2; (void)a3; (void)a4;
    return -ENOSYS;
#else
    return __syscall6(_UNISA_SC(nr), a0, a1, a2, a3, a4);
#endif
}

long sy_syscall6(long nr, long a0, long a1, long a2, long a3, long a4) {
    return sy_syscall6_os(nr, a0, a1, a2, a3, a4);
}
