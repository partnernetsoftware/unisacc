#pragma unisa module proc
#pragma unisa dock
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use sys.env
/* L0 sys/proc: child processes (plans/cx-layers.md). Windows does not provide
   the fork/exec or process-group contracts below; those operations return -ENOSYS.
   Exit status as one int:
   0..255 an exit code, 128+N killed by signal N, -errno when it could not run
   or be waited for. No #include: fork/pipe/exec/waitpid/kill come with the
   implicit prelude. A run with a time limit is cx_runv_timeout until that
   moves here. An APE (unisacc.com) cannot be exec'd directly: run it as
   {"sh", path, ...}. */

/* Pre-spawn hooks: a layer above (stdio) registers a function that runs, in
   registration order, before every fork this module does. Plain function
   pointers, no platform branch. Returns 0, or -EINVAL for NULL, -ENOSPC when
   full; registering the same function twice is a no-op. */
#define SY_ATSPAWN_MAX 8
static void (*sy_atspawn_fn[SY_ATSPAWN_MAX])(void);
static int sy_atspawn_n;
int sy_atspawn(void (*fn)(void)) {
    int i;
    if (!fn) return -EINVAL;
    for (i = 0; i < sy_atspawn_n; i++) if (sy_atspawn_fn[i] == fn) return 0;
    if (sy_atspawn_n >= SY_ATSPAWN_MAX) return -ENOSPC;
    sy_atspawn_fn[sy_atspawn_n++] = fn;
    return 0;
}
static void sy_prespawn(void) {
    int i;
    for (i = 0; i < sy_atspawn_n; i++) sy_atspawn_fn[i]();
}

static int sy_status(int st) {
    if (WIFEXITED(st)) return WEXITSTATUS(st);
    if (WIFSIGNALED(st)) return 128 + WTERMSIG(st);
    return -EINVAL;
}

/* Run ARGV (argv[0] found on PATH) to the end; its stdout and stderr go to
   OUT (NUL-terminated; what does not fit in CAP-1 bytes is read and dropped,
   and *CUT is set when given). The exit status, as above. */
static int syp_run_os(char **argv, char *out, int cap, int *cut) {
    if (cut) *cut = 0;
    if (!argv || !argv[0]) return -EINVAL;
#if defined(_WIN32)
    (void)out; (void)cap;
    return -ENOSYS;
#else
    int p[2], st;
    size_t off = 0;
    pid_t pid;
    if (pipe(p) != 0) return -errno;
    sy_prespawn();
    pid = fork();
    if (pid < 0) { int e = errno; close(p[0]); close(p[1]); return -e; }
    if (pid == 0) {
        dup2(p[1], 1); dup2(p[1], 2);
        close(p[0]); close(p[1]);
        execvp(argv[0], argv);
        _exit(127);
    }
    close(p[1]);
    for (;;) {
        char tmp[4096];
        ssize_t k = read(p[0], tmp, sizeof tmp);
        if (k < 0 && errno == EINTR) continue;
        if (k <= 0) break;
        if (out && cap > 1) {
            size_t take = (size_t)k;
            if (off + take > (size_t)cap - 1) { take = (size_t)cap - 1 - off; if (cut) *cut = 1; }
            { void *cx_kept = memcpy(out + off, tmp, take); (void)cx_kept; }
            off += take;
        } else if (cut) *cut = 1;
    }
    if (out && cap > 0) out[off] = 0;
    close(p[0]);
    while (waitpid(pid, &st, 0) < 0) if (errno != EINTR) return -errno;
    return sy_status(st);
#endif
}
int sy_run(char **argv, char *out, int cap, int *cut) { return syp_run_os(argv, out, cap, cut); }

/* Start ARGV in the background, in its own process group (so sy_kill takes
   its children too), stdin from /dev/null. Its pid, or -errno. */
static int syp_spawn_os(char **argv) {
    if (!argv || !argv[0]) return -EINVAL;
#if defined(_WIN32)
    return -ENOSYS;
#else
    pid_t pid;
    sy_prespawn();
    pid = fork();
    if (pid < 0) return -errno;
    if (pid == 0) {
        int dn = open("/dev/null", O_RDONLY);
        sy_setpgid(0, 0);   /* The raw syscall, not the prelude's libc forward. */
        if (dn >= 0) { dup2(dn, 0); close(dn); }
        execvp(argv[0], argv);
        _exit(127);
    }
    return (int)pid;
#endif
}
int sy_spawn(char **argv) { return syp_spawn_os(argv); }

/* Start ARGV (argv[0] a path: not looked up on PATH) in THIS process group and
   session, stdin/stdout/stderr inherited: a terminal stays the child's terminal
   and the child stays in its foreground group (sy_spawn makes its own group,
   which cannot read the terminal). Descriptor KEEP (-1: none) is left open
   across exec; every other descriptor keeps its own close-on-exec flag. Its
   pid, or -errno; a failed exec comes back as its errno (over a close-on-exec
   pipe), not as a child that exits 127. */
static int syp_inherit_os(char **argv, int keep) {
    if (!argv || !argv[0]) return -EINVAL;
#if defined(_WIN32)
    (void)keep;
    return -ENOSYS;
#else
    int p[2], e = 0, st;
    long k;
    pid_t pid;
    if (pipe(p) != 0) return -errno;
    if (fcntl(p[0], F_SETFD, FD_CLOEXEC) != 0 || fcntl(p[1], F_SETFD, FD_CLOEXEC) != 0) {
        e = errno; close(p[0]); close(p[1]); return -e;
    }
    sy_prespawn();
    pid = fork();
    if (pid < 0) { e = errno; close(p[0]); close(p[1]); return -e; }
    if (pid == 0) {
        close(p[0]);
        if (keep >= 0 && fcntl(keep, F_SETFD, 0) != 0) e = errno;
        else { execv(argv[0], argv); e = errno; }
        write(p[1], &e, sizeof e);
        _exit(127);
    }
    close(p[1]);
    do k = read(p[0], &e, sizeof e); while (k < 0 && errno == EINTR);
    close(p[0]);
    if (k == (long)sizeof e) {
        while (waitpid(pid, &st, 0) < 0 && errno == EINTR) {}
        return e ? -e : -EIO;
    }
    return (int)pid;
#endif
}
int sy_spawn_inherit(char **argv, int keep) { return syp_inherit_os(argv, keep); }

/* Run FN(UD) in a forked child that leads a new session (no controlling
   terminal; sy_killpg(pid, 9) takes its whole group), stdin from /dev/null,
   stdout into a pipe whose read end is FDS[0] and stderr into FDS[1] (both
   close-on-exec in the parent). The child exits with FN's return value and
   does not flush stdio: FN writes with sy_write_all. Its pid, or -errno. */
static int syp_session_os(int (*fn)(void *), void *ud, int fds[2]) {
    if (!fn || !fds) return -EINVAL;
#if defined(_WIN32)
    (void)ud;
    return -ENOSYS;
#else
    int po[2], pe[2], e;
    pid_t pid;
    if (pipe(po) != 0) return -errno;
    if (pipe(pe) != 0) { e = errno; close(po[0]); close(po[1]); return -e; }
    sy_prespawn();
    pid = fork();
    if (pid < 0) { e = errno; close(po[0]); close(po[1]); close(pe[0]); close(pe[1]); return -e; }
    if (pid == 0) {
        int dn;
        sy_setsid();   /* a fresh fork is never a group leader: this cannot be -EPERM */
        dn = open("/dev/null", O_RDONLY);
        if (dn >= 0) { dup2(dn, 0); close(dn); }
        dup2(po[1], 1); dup2(pe[1], 2);
        close(po[0]); close(po[1]); close(pe[0]); close(pe[1]);
        _exit(fn(ud) & 255);
    }
    close(po[1]); close(pe[1]);
    fcntl(po[0], F_SETFD, FD_CLOEXEC);
    fcntl(pe[0], F_SETFD, FD_CLOEXEC);
    fds[0] = po[0];
    fds[1] = pe[0];
    return (int)pid;
#endif
}
int sy_fork_session(int (*fn)(void *), void *ud, int fds[2]) { return syp_session_os(fn, ud, fds); }

enum {
    SY_SPAWN_STDERR_SPLIT = 1,   /* stderr into its own pipe (*err_fd), not merged into *out_fd */
    SY_SPAWN_STDIN_INHERIT = 2,  /* keep the caller's stdin instead of /dev/null */
    SY_SPAWN_NO_PATH = 4         /* argv[0] is a path: execv, not looked up on PATH */
};

/* Create a pipe, both ends close-on-exec, into FDS[0] = read end, FDS[1] = write end.
   0, or -errno (both ends closed on any failure).  The bounded single syscall behind
   the spawn/run helpers: an upper layer needing a bare pipe uses this, not libc pipe. */
static int syp_pipe_os(int fds[2]) {
    if (!fds) return -EINVAL;
    errno = 0;
    if (pipe(fds) != 0) return -errno;
#if !defined(_WIN32)
    if (fcntl(fds[0], F_SETFD, FD_CLOEXEC) != 0 || fcntl(fds[1], F_SETFD, FD_CLOEXEC) != 0) {
        int e = errno;
        close(fds[0]); close(fds[1]);
        return -e;
    }
#endif
    /* The Windows pipe provider creates non-inheritable handles. */
    return 0;
}
int sy_pipe(int fds[2]) { return syp_pipe_os(fds); }

/* Create a pipe with FLAGS applied to both ends (SY_PIPE_CLOEXEC, SY_PIPE_NONBLOCK, from
   sys.posix) into FDS[0] = read end, FDS[1] = write end.  0, or -errno (both ends closed on
   any failure): -EINVAL for a null FDS or an unknown flag bit.  Linux creates the pipe and
   sets the flags in one pipe2 system call, so no other thread can fork between the two.
   macOS has no pipe2: it creates the pipe and then sets each flag with fcntl, which is NOT
   atomic -- a fork in another thread between the two steps lets the child inherit the end.
   Windows has no pipe2 contract here and returns -ENOSYS (sy_pipe, whose handles are never
   inherited, is the Windows call). */
static int syp_pipe2_os(int fds[2], int flags) {
#if defined(_WIN32)
    (void)fds; (void)flags;
    return -ENOSYS;
#else
    int r, i, e, fl;
    r = sy_pipe2_sys(fds, flags);
    if (r != -ENOSYS) return r;
    errno = 0;
    if (pipe(fds) != 0) return -errno;
    for (i = 0; i < 2; i++) {
        if (flags & SY_PIPE_CLOEXEC) {
            if (fcntl(fds[i], F_SETFD, FD_CLOEXEC) != 0) { e = errno; close(fds[0]); close(fds[1]); return -e; }
        }
        if (flags & SY_PIPE_NONBLOCK) {
            fl = fcntl(fds[i], F_GETFL);
            if (fl < 0 || fcntl(fds[i], F_SETFL, fl | O_NONBLOCK) != 0) { e = errno; close(fds[0]); close(fds[1]); return -e; }
        }
    }
    return 0;
#endif
}
int sy_pipe2(int fds[2], int flags) {
    if (!fds || (flags & ~(SY_PIPE_CLOEXEC | SY_PIPE_NONBLOCK))) return -EINVAL;
    return syp_pipe2_os(fds, flags);
}

/* ---- the one spawn-options struct (build/std-surface.tsv area process) ---- */

enum {
    SY_STDIO_INHERIT = -1,        /* keep the caller's descriptor */
    SY_STDIO_NULL = -2,           /* /dev/null */
    SY_STDIO_PIPE = -3,           /* a pipe; the parent's end comes back in sy_child_t */
    SY_SPAWN_ERR_TO_OUT = 8       /* stderr is stdout's descriptor (after the stdout setup) */
};

typedef struct {
    char **argv;          /* argv[0] found on PATH unless SY_SPAWN_NO_PATH */
    char **env;           /* 0: inherit; else the whole environment, NULL-terminated */
    const char *cwd;      /* 0: the caller's */
    int in_fd, out_fd, err_fd;   /* an fd, or SY_STDIO_INHERIT/NULL/PIPE */
    int flags;            /* SY_SPAWN_NO_PATH, SY_SPAWN_ERR_TO_OUT */
    int pgroup;           /* 0 inherit without a deadline, otherwise create a group; -1 create, >0 join */
    long deadline_ms;     /* 0: none; otherwise kill the process group on expiry */
} sy_spawn_t;

typedef struct {
    int pid;
    int in_fd, out_fd, err_fd;   /* parent ends of PIPE stdio, else -1 */
    long deadline_at_ms;         /* sy_now_ms() at expiry, 0 none */
    int h;                       /* process group to signal (0: the pid alone) */
    int own_slot;
    unsigned own_gen;
} sy_child_t;

typedef struct { int exited; int code; int sig; int timed_out; int raw; } sy_exit_t;

/* All inherit, no deadline. */
void sy_spawn_init(sy_spawn_t *o) {
    if (!o) return;
    o->argv = 0; o->env = 0; o->cwd = 0;
    o->in_fd = o->out_fd = o->err_fd = SY_STDIO_INHERIT;
    o->flags = 0; o->pgroup = 0; o->deadline_ms = 0;
}

/* A wait status taken apart. 0, or -EINVAL when neither exited nor signalled. */
int sy_exit_decode(int raw, sy_exit_t *st) {
    if (!st) return -EINVAL;
    st->exited = 0; st->code = 0; st->sig = 0; st->timed_out = 0; st->raw = raw;
    if (WIFEXITED(raw)) { st->exited = 1; st->code = WEXITSTATUS(raw); return 0; }
    if (WIFSIGNALED(raw)) { st->sig = WTERMSIG(raw); return 0; }
    return -EINVAL;
}

/* The shell's view: the code, 128+sig for a signal, 124 for a timeout. */
int sy_exit_code(const sy_exit_t *st) {
    if (!st) return -EINVAL;
    if (st->timed_out) return 124;
    if (st->exited) return st->code;
    return 128 + st->sig;
}

#if !defined(_WIN32)
static void syp_dup_null_os(int fd, int mode) {
    int dn = open("/dev/null", mode);
    if (dn >= 0) { dup2(dn, fd); close(dn); }
}

static void syp_child_exec_os(const sy_spawn_t *o, int group, int *pi, int *po, int *pe, int ps1) {
    int e;
    char **argv = o->argv;
    if (group) {
        int rc = sy_setpgid(0, group < 0 ? 0 : group);
        if (rc < 0) {
            e = -rc;
            write(ps1, &e, sizeof e);
            _exit(127);
        }
    }
    if (o->in_fd == SY_STDIO_NULL) syp_dup_null_os(0, O_RDONLY);
    else if (o->in_fd == SY_STDIO_PIPE) dup2(pi[0], 0);
    else if (o->in_fd >= 0) dup2(o->in_fd, 0);
    if (o->out_fd == SY_STDIO_NULL) syp_dup_null_os(1, O_WRONLY);
    else if (o->out_fd == SY_STDIO_PIPE) dup2(po[1], 1);
    else if (o->out_fd >= 0) dup2(o->out_fd, 1);
    if (o->flags & SY_SPAWN_ERR_TO_OUT) dup2(1, 2);
    else if (o->err_fd == SY_STDIO_NULL) syp_dup_null_os(2, O_WRONLY);
    else if (o->err_fd == SY_STDIO_PIPE) dup2(pe[1], 2);
    else if (o->err_fd >= 0) dup2(o->err_fd, 2);
    if (o->cwd && chdir(o->cwd) != 0) e = errno;
    else if (o->env) {
        const char *path = sy_env("PATH");
        char buf[4096];
        const char *a0 = argv[0];
        int has_slash = 0, al = 0;
        while (a0[al]) { if (a0[al] == '/') has_slash = 1; al++; }
        e = ENOENT;
        if ((o->flags & SY_SPAWN_NO_PATH) || has_slash || !path) { execve(a0, argv, o->env); e = errno; }
        else {
            while (*path) {
                int n = 0, k;
                while (path[n] && path[n] != ':') n++;
                if (n + 1 + al + 1 <= (int)sizeof buf) {
                    for (k = 0; k < n; k++) buf[k] = path[k];
                    if (n == 0) { buf[0] = '.'; n = 1; }
                    buf[n] = '/';
                    for (k = 0; k <= al; k++) buf[n + 1 + k] = a0[k];
                    execve(buf, argv, o->env);
                    if (errno != ENOENT && errno != ENOTDIR) e = errno;
                }
                path += n;
                if (*path == ':') path++;
            }
        }
    } else {
        if (o->flags & SY_SPAWN_NO_PATH) execv(argv[0], argv); else execvp(argv[0], argv);
        e = errno;
    }
    write(ps1, &e, sizeof e);
    _exit(127);
}
#endif

/* Start a child as O describes. 0 and *C filled, or -errno (-ENOENT no such program,
   -EINVAL empty argv); a failed chdir or exec comes back as its errno over a close-on-exec
   pipe, with nothing left open and the child reaped. */
/* L0 Unified Process Ownership Table (fable C3 design, invariants I1..I8).
   Table owns pid; caller holds borrowed sy_child_t. */
enum { SYP_OWN_CAP = 64 };
enum { SYP_SLOT_FREE = 0, SYP_SLOT_RESERVED = 1, SYP_SLOT_LIVE = 2, SYP_SLOT_ABANDONED = 3, SYP_SLOT_LOST = 4 };
typedef struct {
    int state;
    int pid;
    int pgid;
    unsigned gen;
} SypOwnSlot;
static SypOwnSlot syp_own[SYP_OWN_CAP];
static int syp_own_owner_pid;
static int syp_own_lost;
static int syp_own_atexit_armed;
static unsigned syp_own_gen_seq;

typedef struct { int state; int pid; int pgid; unsigned gen; } sy_proc_test_slot_t;
typedef struct { int kind; int slot; int pid; int rc; int extra; } sy_proc_test_ev_t;
enum {
    SYP_EV_ATEXIT_ARM = 1,
    SYP_EV_RESERVE = 2,
    SYP_EV_SETUP = 3,
    SYP_EV_FORK = 4,
    SYP_EV_COMMIT = 5,
    SYP_EV_HANDSHAKE = 6,
    SYP_EV_DRAIN_KILL = 7,
    SYP_EV_DRAIN_WAIT = 8
};
enum { SYP_TEST_EV_CAP = 256, SYP_TEST_INJ_CAP = 32 };
static sy_proc_test_ev_t syp_test_evs[SYP_TEST_EV_CAP];
static int syp_test_ev_n;
static int syp_test_setup_step;
static int syp_test_setup_err;
static int syp_test_hs_wait_err;
static long syp_test_clock_delta;
typedef struct { int active; int callsite; int pid; int count; int err; } syp_test_inj_t;
static syp_test_inj_t syp_test_injs[SYP_TEST_INJ_CAP];

static void syp_test_ev_push(int kind, int slot, int pid, int rc, int extra) {
    if (syp_test_ev_n < SYP_TEST_EV_CAP) {
        sy_proc_test_ev_t *e = &syp_test_evs[syp_test_ev_n++];
        e->kind = kind; e->slot = slot; e->pid = pid; e->rc = rc; e->extra = extra;
    }
}
static int syp_test_take_setup_err(int step) {
    if (syp_test_setup_step == step && syp_test_setup_err != 0) {
        int e = syp_test_setup_err;
        syp_test_setup_step = 0;
        syp_test_setup_err = 0;
        return e;
    }
    return 0;
}
static int syp_test_take_hs_wait_err(void) {
    if (syp_test_hs_wait_err != 0) {
        int e = syp_test_hs_wait_err;
        syp_test_hs_wait_err = 0;
        return e;
    }
    return 0;
}
static int syp_test_take_syscall(int callsite, int pid, int *out_err) {
    int i;
    for (i = 0; i < SYP_TEST_INJ_CAP; i++) {
        if (syp_test_injs[i].active && syp_test_injs[i].callsite == callsite &&
            (syp_test_injs[i].pid == 0 || syp_test_injs[i].pid == pid)) {
            *out_err = syp_test_injs[i].err;
            if (syp_test_injs[i].count > 0) {
                syp_test_injs[i].count--;
                if (syp_test_injs[i].count == 0) syp_test_injs[i].active = 0;
            }
            return 1;
        }
    }
    return 0;
}
static long syp_now_ms(void) {
    long t = sy_now_ms();
    return t < 0 ? t : t + syp_test_clock_delta;
}

static void syp_own_check_owner(void) {
    int me = (int)getpid();
    if (syp_own_owner_pid != me) {
        int i;
        for (i = 0; i < SYP_OWN_CAP; i++) {
            syp_own[i].state = SYP_SLOT_FREE;
            syp_own[i].pid = 0;
            syp_own[i].pgid = 0;
        }
        syp_own_lost = 0;
        syp_own_owner_pid = me;
    }
}

static int syp_own_find_pid(int pid) {
    int i;
    if (pid <= 0) return -1;
    syp_own_check_owner();
    for (i = 0; i < SYP_OWN_CAP; i++) {
        if ((syp_own[i].state == SYP_SLOT_LIVE || syp_own[i].state == SYP_SLOT_ABANDONED || syp_own[i].state == SYP_SLOT_LOST) && syp_own[i].pid == pid) return i;
    }
    return -1;
}

static int syp_own_find_handle(const sy_child_t *c) {
    int idx;
    if (!c || c->pid <= 0) return -1;
    syp_own_check_owner();
    idx = c->own_slot;
    if (idx < 0 || idx >= SYP_OWN_CAP) return -1;
    if (syp_own[idx].gen != c->own_gen || syp_own[idx].pid != c->pid) return -1;
    if (syp_own[idx].state != SYP_SLOT_LIVE && syp_own[idx].state != SYP_SLOT_ABANDONED && syp_own[idx].state != SYP_SLOT_LOST) return -1;
    return idx;
}

static void syp_own_on_reap(int pid) {
    int idx = syp_own_find_pid(pid);
    if (idx >= 0) {
        if (syp_own[idx].state == SYP_SLOT_LOST && syp_own_lost > 0) syp_own_lost--;
        syp_own[idx].state = SYP_SLOT_FREE;
        syp_own[idx].pid = 0;
        syp_own[idx].pgid = 0;
        syp_own[idx].gen++;
    }
}

static void syp_own_sweep_abandoned(void) {
    int i;
    for (i = 0; i < SYP_OWN_CAP; i++) {
        if ((syp_own[i].state == SYP_SLOT_ABANDONED || syp_own[i].state == SYP_SLOT_LOST) && syp_own[i].pid > 0) {
            int raw;
            pid_t w = waitpid((pid_t)syp_own[i].pid, &raw, WNOHANG);
            if (w == (pid_t)syp_own[i].pid) {
                syp_own_on_reap((int)w);
            } else if (w < 0 && errno == ECHILD) {
                if (syp_own[i].state != SYP_SLOT_LOST) {
                    syp_own[i].state = SYP_SLOT_LOST;
                    syp_own_lost++;
                }
            }
        }
    }
}

static int syp_own_reserve(void) {
    int i;
    syp_own_check_owner();
    syp_own_sweep_abandoned();
    for (i = 0; i < SYP_OWN_CAP; i++) {
        if (syp_own[i].state == SYP_SLOT_FREE) {
            syp_own[i].state = SYP_SLOT_RESERVED;
            syp_own[i].pid = 0;
            syp_own[i].pgid = 0;
            return i;
        }
    }
    return -EAGAIN;
}

static void syp_own_unreserve(int slot) {
    if (slot >= 0 && slot < SYP_OWN_CAP && syp_own[slot].state == SYP_SLOT_RESERVED) {
        syp_own[slot].state = SYP_SLOT_FREE;
        syp_own[slot].pid = 0;
        syp_own[slot].pgid = 0;
    }
}

static void syp_own_commit(int slot, int pid, int pgid) {
    if (slot >= 0 && slot < SYP_OWN_CAP) {
        syp_own[slot].state = SYP_SLOT_LIVE;
        syp_own[slot].pid = pid;
        syp_own[slot].pgid = pgid;
        syp_own[slot].gen = ++syp_own_gen_seq;
    }
}

static int syp_inject_match(int pid, const char *env_name) {
    const char *p = sy_env("UNISACC_PROC_INJECT_PID");
    const char *v = sy_env(env_name);
    if (!v || !v[0] || (v[0] == '0' && !v[1])) return 0;
    if (p && p[0]) {
        int want = 0, i = 0;
        while (p[i] >= '0' && p[i] <= '9') { want = want * 10 + (p[i] - '0'); i++; }
        if (want > 0 && want != pid) return 0;
    }
    return 1;
}

int sy_proc_own_stats(int *live, int *abandoned, int *lost) {
    int i, l = 0, a = 0;
    syp_own_check_owner();
    for (i = 0; i < SYP_OWN_CAP; i++) {
        if (syp_own[i].state == SYP_SLOT_LIVE) l++;
        else if (syp_own[i].state == SYP_SLOT_ABANDONED) a++;
    }
    if (live) *live = l;
    if (abandoned) *abandoned = a;
    if (lost) *lost = syp_own_lost;
    return 0;
}

int sy_proc_own_drain(int budget_ms) {
    int i, elapsed = 0, rem = 0;
    syp_own_check_owner();
    for (i = 0; i < SYP_OWN_CAP; i++) {
        if (syp_own[i].state == SYP_SLOT_ABANDONED && syp_own[i].pid > 0) {
            if (syp_own[i].pgid > 0) (void)kill(-(pid_t)syp_own[i].pgid, SIGKILL);
            (void)kill((pid_t)syp_own[i].pid, SIGKILL);
            syp_test_ev_push(SYP_EV_DRAIN_KILL, i, syp_own[i].pid, 0, syp_own[i].state);
        }
    }
    for (;;) {
        rem = 0;
        for (i = 0; i < SYP_OWN_CAP; i++) {
            if ((syp_own[i].state == SYP_SLOT_ABANDONED || syp_own[i].state == SYP_SLOT_LOST) && syp_own[i].pid > 0) {
                int raw;
                pid_t w;
                int inj_e = 0;
                if (syp_test_take_syscall(3, syp_own[i].pid, &inj_e)) {
                    if (inj_e == 0) { w = 0; }
                    else { errno = inj_e; w = -1; }
                } else
                w = waitpid((pid_t)syp_own[i].pid, &raw, WNOHANG);
                syp_test_ev_push(SYP_EV_DRAIN_WAIT, i, syp_own[i].pid, (int)w, w < 0 ? errno : 0);
                if (w == (pid_t)syp_own[i].pid) {
                    syp_own_on_reap((int)w);
                } else if (w < 0 && errno == ECHILD) {
                    if (syp_own[i].state != SYP_SLOT_LOST) {
                        syp_own[i].state = SYP_SLOT_LOST;
                        syp_own_lost++;
                    }
                    rem++;
                } else {
                    rem++;
                }
            } else if (syp_own[i].state == SYP_SLOT_LIVE || syp_own[i].state == SYP_SLOT_RESERVED) {
                rem++;
            }
        }
        if (rem == 0 || elapsed >= budget_ms) break;
        sy_sleep_ms(5);
        elapsed += 5;
    }
    return rem;
}

static void syp_own_atexit_fn(void) {
    int rem = sy_proc_own_drain(200);
    if (rem > 0) fprintf(stderr, "PROC_RESIDUE n=%d\n", rem);
}

static int syp_atexit_arm(void) {
    const char *inj = sy_env("UNISACC_PROC_INJECT_ATEXIT_FAIL");
    if (inj && inj[0] == '1' && !inj[1]) { syp_test_ev_push(SYP_EV_ATEXIT_ARM, -1, 0, -ENOMEM, 0); return -ENOMEM; }
    if (!syp_own_atexit_armed) {
        if (atexit(syp_own_atexit_fn) != 0) { syp_test_ev_push(SYP_EV_ATEXIT_ARM, -1, 0, -ENOMEM, 0); return -ENOMEM; }
        syp_own_atexit_armed = 1;
    }
    syp_test_ev_push(SYP_EV_ATEXIT_ARM, -1, 0, 0, syp_own_atexit_armed);
    return 0;
}

static void syp_exit_zero(sy_exit_t *st) {
    if (!st) return;
    memset(st, 0, sizeof *st);
}

static int syp_proc_spawn_os(const sy_spawn_t *o, sy_child_t *c) {
    if (!o || !c || !o->argv || !o->argv[0]) return -EINVAL;
    c->pid = 0; c->in_fd = c->out_fd = c->err_fd = -1; c->deadline_at_ms = 0; c->h = 0;
#if defined(_WIN32)
    return -ENOSYS;
#else
    int pi[2] = {-1, -1}, po[2] = {-1, -1}, pe[2] = {-1, -1}, ps[2] = {-1, -1}, e = 0, st, i, slot, ar;
    int group = o->pgroup;
    if (!group && o->deadline_ms > 0) group = -1;
    long k;
    pid_t pid = -1;
    if ((ar = syp_atexit_arm()) != 0) return ar;
    slot = syp_own_reserve();
    syp_test_ev_push(SYP_EV_RESERVE, slot, 0, slot < 0 ? slot : 0, 0);
    if (slot < 0) return slot;
    if ((e = syp_test_take_setup_err(1)) != 0) { syp_test_ev_push(SYP_EV_SETUP, slot, 0, -e, 1); syp_own_unreserve(slot); return -e; }
    if (pipe(ps) != 0) { syp_test_ev_push(SYP_EV_SETUP, slot, 0, -errno, 1); syp_own_unreserve(slot); return -errno; }
    if ((e = syp_test_take_setup_err(2)) != 0) { /* injected fcntl error */ }
    else
    if (fcntl(ps[0], F_SETFD, FD_CLOEXEC) != 0 || fcntl(ps[1], F_SETFD, FD_CLOEXEC) != 0) e = errno;
    if (!e && (e = syp_test_take_setup_err(3)) != 0) { /* injected stdio pipe error */ }
    if (!e && o->in_fd == SY_STDIO_PIPE && pipe(pi) != 0) e = errno;
    if (!e && o->out_fd == SY_STDIO_PIPE && pipe(po) != 0) e = errno;
    if (!e && o->err_fd == SY_STDIO_PIPE && !(o->flags & SY_SPAWN_ERR_TO_OUT) && pipe(pe) != 0) e = errno;
    syp_test_ev_push(SYP_EV_SETUP, slot, 0, e ? -e : 0, 0);
    if (!e) {
        const char *ff = sy_env("UNISACC_PROC_INJECT_FORK_FAIL");
        if (ff && ff[0] == '1' && !ff[1]) e = EAGAIN;
        else { sy_prespawn(); pid = fork(); if (pid < 0) e = errno; }
        syp_test_ev_push(SYP_EV_FORK, slot, (int)pid, e ? -e : 0, 0);
    }
    if (e) {
        int *all[4];
        all[0] = ps; all[1] = pi; all[2] = po; all[3] = pe;
        for (i = 0; i < 4; i++) { if (all[i][0] >= 0) close(all[i][0]); if (all[i][1] >= 0) close(all[i][1]); }
        syp_own_unreserve(slot);
        return -e;
    }
    if (pid == 0) {
        close(ps[0]);
        if (pi[1] >= 0) close(pi[1]);
        if (po[0] >= 0) close(po[0]);
        if (pe[0] >= 0) close(pe[0]);
        syp_child_exec_os(o, group, pi, po, pe, ps[1]);
    }
    close(ps[1]);
    syp_own_commit(slot, (int)pid, group < 0 ? (int)pid : group);
    syp_test_ev_push(SYP_EV_COMMIT, slot, (int)pid, 0, (int)syp_own[slot].gen);
    if (pi[0] >= 0) close(pi[0]);
    if (po[1] >= 0) close(po[1]);
    if (pe[1] >= 0) close(pe[1]);
    do k = read(ps[0], &e, sizeof e); while (k < 0 && errno == EINTR);
    close(ps[0]);
    syp_test_ev_push(SYP_EV_HANDSHAKE, slot, (int)pid, (int)k, e);
    if (k == (long)sizeof e) {
        pid_t w;
        if (pi[1] >= 0) close(pi[1]);
        if (po[0] >= 0) close(po[0]);
        if (pe[0] >= 0) close(pe[0]);
        {
            int hs_e = syp_test_take_hs_wait_err();
            if (hs_e != 0) { w = -1; errno = hs_e; }
            else { do w = waitpid(pid, &st, 0); while (w < 0 && errno == EINTR); }
        }
        if (w == pid) syp_own_on_reap((int)pid);
        else {
            int idx = syp_own_find_pid((int)pid);
            if (idx >= 0) {
                if (errno == ECHILD) { syp_own[idx].state = SYP_SLOT_LOST; syp_own_lost++; }
                else syp_own[idx].state = SYP_SLOT_ABANDONED;
            }
        }
        return e ? -e : -EIO;
    }
    if (pi[1] >= 0) fcntl(pi[1], F_SETFD, FD_CLOEXEC);
    if (po[0] >= 0) fcntl(po[0], F_SETFD, FD_CLOEXEC);
    if (pe[0] >= 0) fcntl(pe[0], F_SETFD, FD_CLOEXEC);
    c->pid = (int)pid; c->in_fd = pi[1]; c->out_fd = po[0]; c->err_fd = pe[0];
    if (o->deadline_ms > 0) {
        long now = syp_now_ms();
        c->deadline_at_ms = (now < 0 ? 0 : now) + o->deadline_ms;
        if (c->deadline_at_ms == 0) c->deadline_at_ms = 1;
    }
    c->h = group < 0 ? (int)pid : group;
    c->own_slot = slot;
    c->own_gen = syp_own[slot].gen;
    return 0;
#endif
}
int sy_proc_spawn(const sy_spawn_t *o, sy_child_t *c) { return syp_proc_spawn_os(o, c); }

/* Signal the child (its whole group when it has one). 0, or -errno (-ESRCH once gone). */
int sy_proc_kill(sy_child_t *c, int sig) {
    int idx;
    if (!c) return -EINVAL;
    if (c->pid == -2) return -EINVAL;
    if (c->pid == -1) return -ESRCH;
    if (c->pid == -3) return -ESRCH;
    if (c->pid <= 0) return -EINVAL;
    idx = syp_own_find_handle(c);
    if (idx < 0) { c->pid = -1; return -ESRCH; }
    if (syp_own[idx].state == SYP_SLOT_LOST) return -ESRCH;
    if (syp_inject_match(c->pid, "UNISACC_PROC_INJECT_KILL_EPERM")) return -EPERM;
    {
        int inj_e = 0;
        if (syp_test_take_syscall(2, c->pid, &inj_e) && inj_e > 0) return -inj_e;
    }
    errno = 0;
    if (c->h > 0) { if (kill(-(pid_t)c->h, sig) == 0) return 0; if (errno != ESRCH) return -errno; }
    errno = 0;
    return kill((pid_t)c->pid, sig) == 0 ? 0 : (errno ? -errno : -EIO);
}

static int syp_reap(sy_child_t *c, int nohang, sy_exit_t *st) {
    int raw;
    pid_t w;
    syp_exit_zero(st);
    if (syp_inject_match(c->pid, "UNISACC_PROC_INJECT_WAIT_ERR")) return -EINTR;
    if (syp_inject_match(c->pid, "UNISACC_PROC_INJECT_ECHILD")) {
        int idx = syp_own_find_handle(c);
        if (idx >= 0 && syp_own[idx].state != SYP_SLOT_LOST) { syp_own[idx].state = SYP_SLOT_LOST; syp_own_lost++; }
        return -ECHILD;
    }
    for (;;) {
        {
            int inj_e = 0;
            if (syp_test_take_syscall(1, c->pid, &inj_e)) {
                if (inj_e == 0) return 0;
                errno = inj_e;
                w = -1;
            } else {
                w = waitpid((pid_t)c->pid, &raw, nohang ? WNOHANG : 0);
            }
        }
        if (w == (pid_t)c->pid) break;
        if (w == 0) return 0;
        if (errno != EINTR) {
            if (errno == ECHILD) {
                int idx = syp_own_find_handle(c);
                if (idx >= 0 && syp_own[idx].state != SYP_SLOT_LOST) { syp_own[idx].state = SYP_SLOT_LOST; syp_own_lost++; }
            }
            return -errno;
        }
    }
    syp_own_on_reap(c->pid);
    c->pid = -3;
    c->deadline_at_ms = (long)(unsigned)raw;
    if (st) sy_exit_decode(raw, st);
    return 1;
}

/* 1 reaped (*ST filled), 0 still running, -errno. */
int sy_proc_try_wait(sy_child_t *c, sy_exit_t *st) {
    syp_exit_zero(st);
    if (!c) return -EINVAL;
    if (c->pid == -2) return -EINVAL;
    if (c->pid == -1) return -ESRCH;
    if (c->pid == -3) {
        if (st) {
            sy_exit_decode((int)(unsigned)c->deadline_at_ms, st);
            if ((c->deadline_at_ms >> 32) & 1L) st->timed_out = 1;
        }
        return 1;
    }
    if (c->pid <= 0) return -EINVAL;
    if (syp_own_find_handle(c) < 0) { c->pid = -1; return -ESRCH; }
    return syp_reap(c, 1, st);
}

/* On expiry, signal the group with SIGKILL and reap the direct child.
   Descendants that leave the group are outside this contract. */
int sy_proc_wait(sy_child_t *c, sy_exit_t *st) {
    int r, timed = 0;
    syp_exit_zero(st);
    if (!c) return -EINVAL;
    if (c->pid == -2) return -EINVAL;
    if (c->pid == -1) return -ESRCH;
    if (c->pid == -3) {
        if (st) {
            sy_exit_decode((int)(unsigned)c->deadline_at_ms, st);
            if ((c->deadline_at_ms >> 32) & 1L) st->timed_out = 1;
        }
        return 0;
    }
    if (c->pid <= 0) return -EINVAL;
    if (syp_own_find_handle(c) < 0) { c->pid = -1; return -ESRCH; }
    if (c->deadline_at_ms > 0) {
        for (;;) {
            long now = syp_now_ms();
            r = syp_reap(c, 1, st);
            if (r != 0) break;
            if (now >= c->deadline_at_ms) {
                r = sy_proc_kill(c, SIGKILL);
                if (r < 0 && r != -ESRCH) return r;
                timed = 1;
                break;
            }
            sy_sleep_ms(now + 5 > c->deadline_at_ms ? c->deadline_at_ms - now : 5);
        }
        if (r == 1) return 0;
        if (r < 0) return r;
    }
    r = syp_reap(c, 0, st);
    if (r < 0) return r;
    if (st && timed) st->timed_out = 1;
    return 0;
}

int sy_proc_end(sy_child_t *c, int grace_ms, sy_exit_t *st) {
    long end, g;
    int r, kr, idx;
    syp_exit_zero(st);
    if (!c || grace_ms < 0) return -EINVAL;
    if (c->pid == -2) return -EINVAL;
    if (c->pid == -1) return -ESRCH;
    if (c->pid == -3) return -ESRCH;
    if (c->pid <= 0) return -EINVAL;
    idx = syp_own_find_handle(c);
    if (idx < 0) { c->pid = -1; return -ESRCH; }
    if (syp_own[idx].state == SYP_SLOT_LOST) return -ESRCH;
    end = syp_now_ms() + grace_ms;
    sy_proc_kill(c, SIGTERM);
    for (g = 0; g < grace_ms; g += 5) {
        if (syp_now_ms() >= end) break;
        sy_sleep_ms(5);
    }
    kr = sy_proc_kill(c, SIGKILL);
    for (g = 0; g < 40; g++) {
        r = sy_proc_try_wait(c, st);
        if (r != 0) return r < 0 ? r : 0;
        sy_sleep_ms(5);
    }
    return (kr < 0 && kr != -ESRCH) ? kr : -ETIMEDOUT;
}

/* Close the parent ends of the pipes; neither kills nor waits.
   If the child is still LIVE in the ownership table, transfer it to ABANDONED. */
int sy_proc_close(sy_child_t *c) {
    int idx;
    if (!c) return -EINVAL;
    if (c->in_fd >= 0) close(c->in_fd);
    if (c->out_fd >= 0) close(c->out_fd);
    if (c->err_fd >= 0) close(c->err_fd);
    c->in_fd = c->out_fd = c->err_fd = -1;
    idx = syp_own_find_handle(c);
    if (idx >= 0 && syp_own[idx].state == SYP_SLOT_LIVE) {
        syp_own[idx].state = SYP_SLOT_ABANDONED;
        c->pid = -2;
    } else if (idx >= 0 && syp_own[idx].state == SYP_SLOT_LOST) {
        c->pid = -2;
    } else if (c->pid > 0) {
        c->pid = -1;
    }
    return 0;
}

/* spawn + wait + close. PIPE stdio is refused (-EINVAL): nothing would drain it. */
int sy_proc_run(const sy_spawn_t *o, sy_exit_t *st) {
    sy_child_t c;
    int r;
    if (!o || !st) return -EINVAL;
    if (o->in_fd == SY_STDIO_PIPE || o->out_fd == SY_STDIO_PIPE || o->err_fd == SY_STDIO_PIPE) return -EINVAL;
    r = sy_proc_spawn(o, &c);
    if (r < 0) return r;
    r = sy_proc_wait(&c, st);
    sy_proc_close(&c);
    return r;
}

/* The parent's pid, or -ENOSYS where the prelude has no getppid. */
static int syp_ppid_os(void) {
#if defined(_WIN32)
    return -ENOSYS;
#else
    return (int)getppid();
#endif
}
int sy_ppid(void) { return syp_ppid_os(); }

/* Start ARGV in its own process group (sy_kill/sy_killpg take its children too), in directory
   CWD (0: the caller's), stdin from /dev/null, stdout and stderr merged into one pipe whose read
   end is *OUT_FD (close-on-exec in the parent).  FLAGS: SY_SPAWN_STDERR_SPLIT puts stderr into
   *ERR_FD instead (ERR_FD required then); SY_SPAWN_STDIN_INHERIT keeps stdin; SY_SPAWN_NO_PATH uses
   execv.  Its pid, or -errno; a failed chdir or exec comes back as its errno (over a close-on-exec
   pipe), with no read end left open and the child reaped. */
int sy_spawn_pipe(char **argv, const char *cwd, int flags, int *out_fd, int *err_fd) {
    sy_spawn_t o;
    sy_child_t c;
    int split = flags & SY_SPAWN_STDERR_SPLIT, r;
    if (!argv || !argv[0] || !out_fd || (split && !err_fd)) return -EINVAL;
    sy_spawn_init(&o);
    o.argv = argv; o.cwd = cwd; o.pgroup = -1;
    o.flags = flags & SY_SPAWN_NO_PATH;
    o.in_fd = (flags & SY_SPAWN_STDIN_INHERIT) ? SY_STDIO_INHERIT : SY_STDIO_NULL;
    o.out_fd = SY_STDIO_PIPE;
    if (split) o.err_fd = SY_STDIO_PIPE; else o.flags |= SY_SPAWN_ERR_TO_OUT;
    r = sy_proc_spawn(&o, &c);
    if (r < 0) return r;
    *out_fd = c.out_fd;
    if (split) *err_fd = c.err_fd;
    return c.pid;
}

enum { SY_WAIT_NOHANG = 1 };

static int syp_wait_status_os(int pid, int nohang, int *exited, int *code, int *sig) {
    int st;
    pid_t w;
#if defined(_WIN32)
    if (pid == -1) return -ENOSYS;
#endif
    for (;;) {
        w = waitpid((pid_t)pid, &st, nohang ? WNOHANG : 0);
        if (w > 0) break;
        if (w == 0) return 0;
        if (errno != EINTR) return -errno;
    }
    if (exited) *exited = WIFEXITED(st) ? 1 : 0;
    if (code) *code = WIFEXITED(st) ? WEXITSTATUS(st) : 0;
    if (sig) *sig = WIFSIGNALED(st) ? WTERMSIG(st) : 0;
    syp_own_on_reap((int)w);
    return (int)w;
}

/* Wait for PID with the status taken apart: *EXITED 1 and *CODE the exit code, or *EXITED 0 and
   *SIG the terminating signal (any pointer may be 0). NOHANG: 0 while it still runs. PID once
   reaped, or -errno. */
int sy_wait_status(int pid, int nohang, int *exited, int *code, int *sig) {
    if (pid <= 0) return -EINVAL;
    return syp_wait_status_os(pid, nohang, exited, code, sig);
}

/* Reap any direct child and return its PID. In nohang mode, 0 means
   children exist but none is ready. -ECHILD means there are no children.
   Only a positive result writes the optional status outputs. */
int sy_wait_any(int nohang, int *exited, int *code, int *sig) {
    return syp_wait_status_os(-1, nohang, exited, code, sig);
}

typedef struct { long user_ms; long sys_ms; long maxrss_kb; } sy_rusage_t;

static int syp_wait_rusage_os(int pid, int nohang, sy_rusage_t *out) {
#if defined(_WIN32)
    (void)pid; (void)nohang; (void)out;
    return -ENOSYS;
#else
    /* wait4 uses a native timeval pair followed by fourteen native longs. */
#if defined(__APPLE__)
    typedef struct { long sec; int usec; } syp_rusage_timeval;
#else
    typedef struct { long sec; long usec; } syp_rusage_timeval;
#endif
    struct {
        syp_rusage_timeval user;
        syp_rusage_timeval sys;
        long maxrss;
        long rest[13];
    } usage;
    long w;
    do {
        w = __syscall6(_UNISA_SC(_UNISA_NR_wait4), (long)pid, 0, nohang ? WNOHANG : 0, (long)&usage, 0);
    } while (w == -EINTR);
    if (w <= 0) return (int)w;
    out->user_ms = usage.user.sec * 1000 + usage.user.usec / 1000;
    out->sys_ms = usage.sys.sec * 1000 + usage.sys.usec / 1000;
#if defined(__APPLE__)
    out->maxrss_kb = usage.maxrss / 1024;
#else
    out->maxrss_kb = usage.maxrss;
#endif
    if (w > 0) syp_own_on_reap((int)w);
    return (int)w;
#endif
}

/* Reap a positive PID with its own usage. Times are truncated to milliseconds,
   high-water RSS is in KiB. Only a positive return writes OUT. */
int sy_wait_rusage(int pid, int nohang, sy_rusage_t *out) {
    if (pid <= 0 || !out) return -EINVAL;
    return syp_wait_rusage_os(pid, nohang, out);
}

/* Send signal SIG to the one process PID (no group). 0, or -errno. */
int sy_signal(int pid, int sig) {
    if (pid <= 0) return -EINVAL;   /* 0 and -1 would mean my group / everything */
    errno = 0;
    return kill((pid_t)pid, sig) == 0 ? 0 : (errno ? -errno : -EIO);
}

/* Wait for PID. NOHANG: -EAGAIN while it still runs. The exit status, as above. */
int sy_wait(int pid, int nohang) {
    int st;
    pid_t w;
    if (pid <= 0) return -EINVAL;
    for (;;) {
        w = waitpid((pid_t)pid, &st, nohang ? WNOHANG : 0);
        if (w == (pid_t)pid) { syp_own_on_reap((int)w); return sy_status(st); }
        if (w == 0) return -EAGAIN;
        if (errno != EINTR) return -errno;
    }
}

/* Kill PID's process group and PID with SIGKILL, then reap PID. Its status
   (normally 128+9), or -errno when PID was not ours to reap. */
int sy_kill(int pid) {
    int idx;
    if (pid <= 0) return -EINVAL;
    idx = syp_own_find_pid(pid);
    if (idx >= 0 && syp_own[idx].state == SYP_SLOT_LOST) return -ESRCH;
    kill(-(pid_t)pid, SIGKILL);
    kill((pid_t)pid, SIGKILL);
    return sy_wait(pid, 0);
}

/* This process's pid. */
int sy_pid(void) { return (int)getpid(); }

void sy_proc_test_reset(void) {
    int i;
    syp_test_ev_n = 0;
    syp_test_setup_step = 0;
    syp_test_setup_err = 0;
    syp_test_hs_wait_err = 0;
    syp_test_clock_delta = 0;
    for (i = 0; i < SYP_TEST_INJ_CAP; i++) syp_test_injs[i].active = 0;
}
int sy_proc_test_slot(int idx, sy_proc_test_slot_t *out) {
    if (!out || idx < 0 || idx >= SYP_OWN_CAP) return -EINVAL;
    syp_own_check_owner();
    out->state = syp_own[idx].state;
    out->pid = syp_own[idx].pid;
    out->pgid = syp_own[idx].pgid;
    out->gen = syp_own[idx].gen;
    return 0;
}
void sy_proc_test_meta(int *owner_pid, int *lost, int *atexit_armed, unsigned *gen_seq) {
    syp_own_check_owner();
    if (owner_pid) *owner_pid = syp_own_owner_pid;
    if (lost) *lost = syp_own_lost;
    if (atexit_armed) *atexit_armed = syp_own_atexit_armed;
    if (gen_seq) *gen_seq = syp_own_gen_seq;
}
int sy_proc_test_events_count(void) { return syp_test_ev_n; }
int sy_proc_test_event(int idx, sy_proc_test_ev_t *out) {
    if (!out || idx < 0 || idx >= syp_test_ev_n) return -EINVAL;
    *out = syp_test_evs[idx];
    return 0;
}
void sy_proc_test_inject_setup_err(int step, int err) {
    syp_test_setup_step = step;
    syp_test_setup_err = err;
}
void sy_proc_test_inject_handshake_wait_err(int err) {
    syp_test_hs_wait_err = err;
}
void sy_proc_test_inject_syscall(int callsite, int pid, int count, int err) {
    int i;
    for (i = 0; i < SYP_TEST_INJ_CAP; i++) {
        if (!syp_test_injs[i].active) {
            syp_test_injs[i].active = 1;
            syp_test_injs[i].callsite = callsite;
            syp_test_injs[i].pid = pid;
            syp_test_injs[i].count = count;
            syp_test_injs[i].err = err;
            return;
        }
    }
}
void sy_proc_test_clock_advance(long delta_ms) {
    syp_test_clock_delta += delta_ms;
}
