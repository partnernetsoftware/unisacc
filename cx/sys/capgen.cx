#pragma unisa module capgen
#pragma unisa dock
/* Generated by tools/cap-gen.cx --write from build/std-surface.tsv; do not edit by hand.
   Entry = 1 iff no row with that cap is refused in the target column (lnx, osx, win). */
enum {
    SY_CAP_AT = 0,
    SY_CAP_SYMLINK = 1,
    SY_CAP_FIFO = 2,
    SY_CAP_FLOCK = 3,
    SY_CAP_MEMFD_EXEC = 4,
    SY_CAP_PGROUP = 5,
    SY_CAP_PROC_TREE = 6,
    SY_CAP_SOCKETPAIR = 7,
    SY_CAP_DUP2 = 8,
    SY_CAP_MMAP_EXEC = 9,
    SY_CAP_POSIX_SIGNAL = 10,
    SY_CAP_TERMIOS = 11,
    SY_CAP_COUNT = 12
};
static const char *const sy_cap_names[SY_CAP_COUNT] = {
    "at",
    "symlink",
    "fifo",
    "flock",
    "memfd-exec",
    "pgroup",
    "proc-tree",
    "socketpair",
    "dup2",
    "mmap-exec",
    "posix-signal",
    "termios",
};
static const unsigned char sy_cap_tab[SY_CAP_COUNT][3] = {
    {1, 1, 0},   /* at: refused rows lnx=0 osx=0 win=5 */
    {1, 1, 0},   /* symlink: refused rows lnx=0 osx=0 win=2 */
    {1, 1, 0},   /* fifo: refused rows lnx=0 osx=0 win=1 */
    {1, 1, 0},   /* flock: refused rows lnx=0 osx=0 win=1 */
    {0, 1, 1},   /* memfd-exec: refused rows lnx=1 osx=0 win=0 UNVERIFIED */
    {1, 1, 0},   /* pgroup: refused rows lnx=0 osx=0 win=6 */
    {1, 0, 0},   /* proc-tree: refused rows lnx=0 osx=2 win=2 */
    {1, 1, 0},   /* socketpair: refused rows lnx=0 osx=0 win=1 */
    {1, 1, 0},   /* dup2: refused rows lnx=0 osx=0 win=1 */
    {1, 1, 0},   /* mmap-exec: refused rows lnx=0 osx=0 win=4 */
    {1, 0, 0},   /* posix-signal: refused rows lnx=0 osx=1 win=4 */
    {1, 1, 0},   /* termios: refused rows lnx=0 osx=0 win=4 */
};
/* the table is module-private: cap.cx reads it through this exported getter */
int sy_cap_tab_get(int cap, int col) {
    if (cap < 0 || cap >= SY_CAP_COUNT || col < 0 || col > 2) return 0;
    return sy_cap_tab[cap][col];
}
