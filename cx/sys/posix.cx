#pragma unisa module posix
#pragma unisa dock
#pragma unisa use sys.sysnums
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
/* L0 sys/posix: the POSIX calls the carried runtime does not provide on
   0.0.43 (plans/cx-layers.md; apps/csih/docs/python-debt.md BLOCKED list),
   made from the system calls themselves. No #include: __syscall6 is the
   compiler's intrinsic and _UNISA_SC the prelude's syscall-class macro;
   struct flock, F_SETLK and fcntl come with the prelude.
   0 or a value on success, -errno on failure, as everywhere in cx/sys.
   Targets: Linux x86_64 and arm64, macOS x86_64 and arm64. Elsewhere
   (Windows) every call is -ENOSYS: stated, not emulated. The interface is
   the same on every target; only the numbers below differ. */

/* syp_dents: getdents64 on Linux, getdirentries64 on macOS (different record layouts, see sy_dir_names). */
#if defined(__APPLE__)
#define SYP_NUM(name) (sn_osx_x86_64_##name##_hi * 65536L + sn_osx_x86_64_##name##_lo)
#elif defined(__linux__) && defined(__aarch64__)
#define SYP_NUM(name) (sn_lnx_arm64_##name##_hi * 65536L + sn_lnx_arm64_##name##_lo)
#elif defined(__linux__) && defined(__x86_64__)
#define SYP_NUM(name) (sn_lnx_x86_64_##name##_hi * 65536L + sn_lnx_x86_64_##name##_lo)
#else
#define SYP_NUM(name) (sn_fallback_##name##_hi * 65536L + sn_fallback_##name##_lo)
#endif
static const long syp_ok = SYP_NUM(syp_ok), syp_setsid = SYP_NUM(syp_setsid),
    syp_getpgid = SYP_NUM(syp_getpgid), syp_socketpair = SYP_NUM(syp_socketpair),
    syp_ioctl = SYP_NUM(syp_ioctl), syp_openat = SYP_NUM(syp_openat),
    syp_linkat = SYP_NUM(syp_linkat), syp_flock = SYP_NUM(syp_flock),
    syp_mkdirat = SYP_NUM(syp_mkdirat), syp_unlinkat = SYP_NUM(syp_unlinkat),
    syp_dents = SYP_NUM(syp_dents), syp_mac = SYP_NUM(syp_mac),
    syp_at_removedir = SYP_NUM(syp_at_removedir), syp_tiocgpgrp = SYP_NUM(syp_tiocgpgrp),
    syp_tiocspgrp = SYP_NUM(syp_tiocspgrp), syp_at_fdcwd = SYP_NUM(syp_at_fdcwd);
static const long syp_setpgid = SYP_NUM(sy_setpgid);
#undef SYP_NUM

/* __syscall6 returns -errno on failure on every target (the carried headers
   rely on the same: include/unistd.h wraps it in _unisa_ret). */
static long syp(long n, long a, long b, long c, long d, long e) {
#if defined(_WIN32)
    (void)n; (void)a; (void)b; (void)c; (void)d; (void)e;
    return -ENOSYS;
#else
    if (!syp_ok) return -ENOSYS;
    return __syscall6(_UNISA_SC(n), a, b, c, d, e);
#endif
}

/* The raw setpgid system call (the prelude's setpgid is forwarded to the host C library, whose
   errno is not this unit's). Windows has no process groups here. */
/* Put process PID (0: this one) into process group PGID (0: the group whose id is PID, a new
   group led by it). 0, or -errno: -EINVAL for a negative argument, -ESRCH when PID is neither
   this process nor a child, -EACCES for a child that has already exec'd, -EPERM for a session
   leader or a group in another session; -ENOSYS on Windows. */
int sy_setpgid(int pid, int pgid) {
    if (pid < 0 || pgid < 0) return -EINVAL;
    return (int)syp(syp_setpgid, pid, pgid, 0, 0, 0);
}

/* The directory fd that means "relative to the current directory" for
   sy_openat/sy_linkat (-1 where these calls are unavailable). */
int sy_at_fdcwd(void) { return (int)syp_at_fdcwd; }

/* Start a new session (the caller becomes its leader, with no controlling
   tty). The new session id, or -errno (-EPERM for a group leader). */
long sy_setsid(void) { return syp(syp_setsid, 0, 0, 0, 0, 0); }

/* The process group of PID (0: this process), or -errno. */
long sy_getpgid(int pid) { return syp(syp_getpgid, pid, 0, 0, 0, 0); }

/* Send SIG to every process of group PGRP. 0, or -errno. */
int sy_killpg(int pgrp, int sig) {
    if (pgrp <= 1) return -EINVAL;   /* 0 and 1 would mean "my group" and "everything" */
    errno = 0;
    return kill(-(pid_t)pgrp, sig) == 0 ? 0 : (errno ? -errno : -EIO);
}

/* A connected pair of AF_UNIX stream sockets into SV. 0, or -errno. */
int sy_socketpair(int sv[2]) {
    if (!sv) return -EINVAL;
    return (int)syp(syp_socketpair, 1 /* AF_UNIX */, 1 /* SOCK_STREAM */, 0, (long)sv, 0);
}

/* The foreground process group of the terminal on FD, or -errno (-ENOTTY). */
long sy_tcgetpgrp(int fd) {
    int pg = -1;
    long r = syp(syp_ioctl, fd, syp_tiocgpgrp, (long)&pg, 0, 0);
    return r < 0 ? r : pg;
}

/* Make PGRP the foreground process group of the terminal on FD. 0, or -errno. */
int sy_tcsetpgrp(int fd, int pgrp) {
    int pg = pgrp;
    return (int)syp(syp_ioctl, fd, syp_tiocspgrp, (long)&pg, 0, 0);
}

/* openat(2): PATH relative to directory DFD (sy_at_fdcwd() for the cwd). The fd, or -errno. */
int sy_openat(int dfd, const char *path, int flags, int mode) {
    if (!path || !path[0]) return -EINVAL;
    return (int)syp(syp_openat, dfd, (long)path, flags, mode, 0);
}

/* linkat(2): a new hard link NEWP (in NEWD) to OLDP (in OLDD). 0, or -errno (-EEXIST: NEWP exists). */
int sy_linkat(int oldd, const char *oldp, int newd, const char *newp, int flags) {
    if (!oldp || !oldp[0] || !newp || !newp[0]) return -EINVAL;
    return (int)syp(syp_linkat, oldd, (long)oldp, newd, (long)newp, flags);
}

/* mkdirat(2): directory NAME in DFD with MODE. 0, or -errno (-EEXIST when it exists). */
int sy_mkdirat(int dfd, const char *name, int mode) {
    if (!name || !name[0]) return -EINVAL;
    return (int)syp(syp_mkdirat, dfd, (long)name, mode, 0, 0);
}

/* unlinkat(2): remove NAME in DFD; DIR 1 removes an (empty) directory. 0, or -errno.
   An L0 primitive for code that owns the entry it removes (a temp file it just
   made); deleting trees and user paths goes through cx_rmtree, the guard. */
int sy_unlinkat(int dfd, const char *name, int dir) {
    if (!name || !name[0]) return -EINVAL;
    return (int)syp(syp_unlinkat, dfd, (long)name, dir ? syp_at_removedir : 0, 0, 0);
}

/* The entry names of the open directory DFD (without "." and ".."), each
   NUL-terminated, one after another in OUT. The count, -ENOSPC when OUT is
   too small, or -errno. Reads from the start: DFD's offset is rewound first.
   Linux records (getdents64): reclen at byte 16, name at 19. macOS records
   (getdirentries64): reclen at 16, namlen at 18, name at 21 -- written from
   <sys/dirent.h>, not yet run on a Mac. */
int sy_dir_names(int dfd, char *out, int cap) {
    static char buf[8192];
    int count = 0, used = 0;
    long base = 0;
    if (!out || cap < 1) return -EINVAL;
    if (lseek(dfd, 0, SEEK_SET) < 0) return -errno;
    for (;;) {
        long n = syp_mac ? syp(syp_dents, dfd, (long)buf, sizeof buf, (long)&base, 0)
                         : syp(syp_dents, dfd, (long)buf, sizeof buf, 0, 0);
        long at = 0;
        if (n < 0) return (int)n;
        if (n == 0) break;
        while (at < n) {
            unsigned short reclen = (unsigned short)((unsigned char)buf[at + 16] | ((unsigned char)buf[at + 17] << 8));
            const char *name = buf + at + (syp_mac ? 21 : 19);
            int len = 0;
            if (reclen == 0) return -EIO;
            if (syp_mac) len = (unsigned char)buf[at + 18] | ((unsigned char)buf[at + 19] << 8);
            else while (name + len < buf + at + reclen && name[len]) len++;
            if (!(len == 1 && name[0] == '.') && !(len == 2 && name[0] == '.' && name[1] == '.')) {
                if (used + len + 1 > cap) return -ENOSPC;
                { void *cx_kept = memcpy(out + used, name, (size_t)len); (void)cx_kept; }
                out[used + len] = 0;
                used += len + 1;
                count++;
            }
            at += reclen;
        }
    }
    return count;
}

/* Terminal modes, saved and put back whole (the kernel's termios through its
   ioctl: TCGETS/TCSETS[F] on Linux, TIOCGETA/TIOCSETA[F] on macOS). Opaque:
   only sy_tty_get fills it, and two are compared with sy_tty_same. */
typedef struct { unsigned char b[128]; } sy_tty_t;
#if defined(__APPLE__)
static const long syp_tcgets = 0x40487413L, syp_tcsets = 0x80487414L, syp_tcsetsf = 0x80487416L;
#else
static const long syp_tcgets = 0x5401L, syp_tcsets = 0x5402L, syp_tcsetsf = 0x5404L;
#endif

/* The modes of the terminal on FD into T. 0, or -errno (-ENOTTY: not a terminal). */
int sy_tty_get(int fd, sy_tty_t *t) {
    if (!t) return -EINVAL;
    memset(t, 0, sizeof *t);
    return (int)syp(syp_ioctl, fd, syp_tcgets, (long)t->b, 0, 0);
}

/* Set the terminal on FD to T. FLUSH 1 first waits for output to drain and
   drops unread input (TCSAFLUSH), 0 applies at once (TCSANOW). 0, or -errno. */
int sy_tty_set(int fd, const sy_tty_t *t, int flush) {
    if (!t) return -EINVAL;
    return (int)syp(syp_ioctl, fd, flush ? syp_tcsetsf : syp_tcsets, (long)t->b, 0, 0);
}

/* 1 when A and B hold the same modes. */
int sy_tty_same(const sy_tty_t *a, const sy_tty_t *b) {
    return a && b && memcmp(a->b, b->b, sizeof a->b) == 0;
}

/* flock(2) on FD: OP is 1 shared, 2 exclusive, 8 unlock, |4 not to wait.
   0, or -errno (-EWOULDBLOCK when held and not waiting). */
int sy_flock(int fd, int op) { return (int)syp(syp_flock, fd, op, 0, 0, 0); }

/* A POSIX record lock over all of FD (the lockf/fcntl kind, not flock's):
   WRITE 1 exclusive / 0 shared, WAIT 1 to block. Unlock with sy_unlockf.
   0, or -errno (-EAGAIN or -EACCES when held elsewhere and not waiting). */
/* Windows has no fcntl or struct flock in its prelude: both are -ENOSYS there (the same
   shape as sy_mkfifo); an unguarded struct flock made every Windows image that links
   sys.posix fail to compile ("incomplete struct"). */
static int syp_lockf_os(int fd, int kind, int wait) {   /* kind 0 shared, 1 exclusive, 2 unlock */
#ifdef _WIN32
    (void)fd; (void)kind; (void)wait;
    return -ENOSYS;
#else
    struct flock l;
    memset(&l, 0, sizeof l);
    l.l_type = kind == 2 ? F_UNLCK : kind ? F_WRLCK : F_RDLCK;
    l.l_whence = SEEK_SET;
    errno = 0;
    return fcntl(fd, wait ? F_SETLKW : F_SETLK, &l) == 0 ? 0 : (errno ? -errno : -EIO);
#endif
}

int sy_lockf(int fd, int write, int wait) { return syp_lockf_os(fd, write ? 1 : 0, wait); }

int sy_unlockf(int fd) { return syp_lockf_os(fd, 2, 0); }

/* Current RLIMIT_AS soft limit in bytes, or -1 when it is unlimited, unknown,
   or the platform has no address-space limit (Windows). getrlimit is the
   Linux x86_64 syscall class 97; _UNISA_SC maps it per platform. */
static long syp_rlimit_as_os(void) {
#if defined(_WIN32)
    return -1;
#else
    struct { unsigned long cur, max; } rl = {0, 0};
    long rc;
    rc = (long)__syscall6(_UNISA_SC(97), 9, (long)&rl, 0, 0, 0);   /* getrlimit, RLIMIT_AS */
    if (rc < 0) return -1;
    if (rl.cur == ~0UL) return -1;                                  /* RLIM_INFINITY */
    if (rl.cur > 0x7FFFFFFFFFFFL) return -1;
    return (long)rl.cur;
#endif
}

long sy_rlimit_as(void) {
    return syp_rlimit_as_os();
}

/* ---- W3: directory iterator with kinds, remove_all, link, utimes, pread/pwrite
   (build/std-surface.tsv rows).  Linux first-class; macOS written from the headers (not run on a Mac);
   Windows: every call here is -ENOSYS (stated, not emulated). ---- */

typedef struct { int h; int kind; long name_n; char name[256]; } sy_dir_t;

#define SYP_DSLOTS 32
static struct { int used, fd; long pos, len, base; char path[512]; unsigned char buf[4096]; } syp_ds[SYP_DSLOTS];

/* Directory-open flags; Windows' prelude has no O_DIRECTORY (and sy_openat is -ENOSYS there anyway). */
static int syp_dirflags_os(void) {
#if defined(_WIN32)
    return 0;
#else
    return O_RDONLY | O_DIRECTORY;
#endif
}

/* Open directory PATH for iteration with sy_dir_next.  0, or -errno (-EMFILE: 32 iterators open). */
int sy_dir_open(sy_dir_t *d, const char *path) {
    int i, fd;
    if (!d || !path || !path[0]) return -EINVAL;
    memset(d, 0, sizeof *d);
    for (i = 0; i < SYP_DSLOTS && syp_ds[i].used; i++) {}
    if (i == SYP_DSLOTS) return -EMFILE;
    fd = sy_openat(sy_at_fdcwd(), path, syp_dirflags_os(), 0);
    if (fd < 0) return fd;
    syp_ds[i].used = 1;
    syp_ds[i].fd = fd;
    syp_ds[i].pos = syp_ds[i].len = syp_ds[i].base = 0;
    syp_ds[i].path[0] = 0;
    if (strlen(path) < sizeof syp_ds[i].path) { if (mm_copy(syp_ds[i].path, (long)sizeof syp_ds[i].path, path, (long)strlen(path) + 1)) syp_ds[i].path[0] = 0; }
    d->h = i + 1;
    return 0;
}

/* The next entry of D (not "." or ".."): 1 with D->name, D->name_n and D->kind set ('f' 'd' 'l' 's' 'p' or '?'),
   0 at the end, -errno otherwise (-ENAMETOOLONG: the name is over 255 bytes; the entry is skipped). */
int sy_dir_next(sy_dir_t *d) {
    int i;
    if (!d || d->h < 1 || d->h > SYP_DSLOTS || !syp_ds[d->h - 1].used) return -EBADF;
    i = d->h - 1;
    for (;;) {
        long at, reclen, len, ty;
        const unsigned char *r;
        const char *name;
        if (syp_ds[i].pos >= syp_ds[i].len) {
            long n = syp_mac ? syp(syp_dents, syp_ds[i].fd, (long)syp_ds[i].buf, sizeof syp_ds[i].buf, (long)&syp_ds[i].base, 0)
                             : syp(syp_dents, syp_ds[i].fd, (long)syp_ds[i].buf, sizeof syp_ds[i].buf, 0, 0);
            if (n < 0) return (int)n;
            if (n == 0) return 0;
            syp_ds[i].pos = 0;
            syp_ds[i].len = n;
        }
        at = syp_ds[i].pos;
        r = syp_ds[i].buf + at;
        reclen = r[16] | (r[17] << 8);
        if (reclen < 20) return -EIO;
        syp_ds[i].pos += reclen;
        name = (const char *)r + (syp_mac ? 21 : 19);
        ty = syp_mac ? r[20] : r[18];
        if (syp_mac) len = r[18] | (r[19] << 8);
        else { len = 0; while (at + 19 + len < syp_ds[i].len && at + 19 + len < at + reclen && name[len]) len++; }
        ty = syp_mac ? r[20] : r[18];
        if ((len == 1 && name[0] == '.') || (len == 2 && name[0] == '.' && name[1] == '.')) continue;
        if (len > 255) return -ENAMETOOLONG;
        if (mm_copy(d->name, (long)sizeof d->name, name, len)) return -ENAMETOOLONG;
        d->name[len] = 0;
        d->name_n = len;
        d->kind = ty == 8 ? 'f' : ty == 4 ? 'd' : ty == 10 ? 'l' : ty == 12 ? 's' : ty == 1 ? 'p' : '?';
        if (ty == 0) {
            char full[1024];
            sy_stat_t st;
            if (!cx_fmt(full, sizeof full, "%s/%s", syp_ds[i].path, d->name) && sy_lstat(full, &st) == 0) d->kind = st.kind;
        }
        return 1;
    }
}

/* Close D.  0, or -EBADF (never opened, or already closed). */
int sy_dir_close(sy_dir_t *d) {
    int i, rc;
    if (!d || d->h < 1 || d->h > SYP_DSLOTS || !syp_ds[d->h - 1].used) return -EBADF;
    i = d->h - 1;
    rc = sy_close(syp_ds[i].fd);
    syp_ds[i].used = 0;
    d->h = 0;
    return rc;
}

static int syp_rm_all(const char *path, int depth) {
    sy_stat_t st;
    int rc;
    sy_dir_t d;
    char child[1024];
    rc = sy_lstat(path, &st);
    if (rc == -ENOENT) return 0;
    if (rc) return rc;
    if (st.kind != 'd') return sy_unlink(path);
    if (depth >= SYP_DSLOTS - 1) return -ELOOP;
    rc = sy_dir_open(&d, path);
    if (rc) return rc;
    for (;;) {
        int n = sy_dir_next(&d);
        if (n < 0) { rc = n; break; }
        if (n == 0) break;
        if (cx_fmt(child, sizeof child, "%s/%s", path, d.name)) { rc = -ENAMETOOLONG; break; }
        rc = syp_rm_all(child, depth + 1);
        if (rc && rc != -ENOENT) break;
        rc = 0;
    }
    sy_dir_close(&d);
    if (rc) return rc;
    return sy_rmdir(path);
}

/* rm -r PATH (Rust remove_dir_all; Node rm recursive).  Never follows a symbolic link; an absent PATH is 0;
   "", "/", "." and ".." are -EINVAL.  0, or the first -errno. */
int sy_remove_all(const char *path) {
    if (!path || !path[0] || !strcmp(path, "/") || !strcmp(path, ".") || !strcmp(path, "..")) return -EINVAL;
    return syp_rm_all(path, 0);
}

/* link(2): FROM gets a second name TO.  0, or -errno (-EEXIST).  -ENOSYS on Windows. */
int sy_link(const char *from, const char *to) {
    return sy_linkat(sy_at_fdcwd(), from, sy_at_fdcwd(), to, 0);
}

/* Set PATH's access and modification times (seconds + nanoseconds; follows symbolic links).
   0, or -errno; -EINVAL for ns outside 0..999999999; -ENOSYS on Windows. */
static long syp_sc3_os(long num, long a, long b, long c, long d) {
#ifdef _WIN32
    (void)num; (void)a; (void)b; (void)c; (void)d;
    return -ENOSYS;
#else
    return __syscall6(_UNISA_SC(num), a, b, c, d, 0);
#endif
}

int sy_utimes(const char *path, long atime_s, long atime_ns, long mtime_s, long mtime_ns) {
    long ts[4];
    if (!path || !path[0] || atime_ns < 0 || atime_ns > 999999999L || mtime_ns < 0 || mtime_ns > 999999999L) return -EINVAL;
    ts[0] = atime_s; ts[1] = atime_ns; ts[2] = mtime_s; ts[3] = mtime_ns;
    return (int)syp_sc3_os(280, sy_at_fdcwd(), (long)path, (long)ts, 0);
}

/* read at byte offset OFF without moving the file position.  Bytes read (0 at end), or -errno. */
long sy_pread(int fd, void *buf, long n, int64_t off) {
    if (!buf || n < 0 || off < 0) return -EINVAL;
    return syp_sc3_os(17, fd, (long)buf, n, (long)off);
}

/* write at byte offset OFF without moving the file position.  Bytes written, or -errno. */
long sy_pwrite(int fd, const void *buf, long n, int64_t off) {
    if (!buf || n < 0 || off < 0) return -EINVAL;
    return syp_sc3_os(18, fd, (long)buf, n, (long)off);
}
