#pragma unisa module posix
/* L0 sys/posix: the POSIX calls the carried runtime does not provide on
   0.0.43 (plans/cx-layers.md; apps/csih/docs/python-debt.md BLOCKED list),
   made from the system calls themselves. No #include: __syscall6 is the
   compiler's intrinsic and _UNISA_SC the prelude's syscall-class macro;
   struct flock, F_SETLK and fcntl come with the prelude.
   0 or a value on success, -errno on failure, as everywhere in cx/sys.
   Targets: Linux x86_64 and arm64, macOS x86_64 and arm64. Elsewhere
   (Windows) every call is -ENOSYS: stated, not emulated. The interface is
   the same on every target; only the numbers below differ. */

/* syp_dents: getdents64 on Linux, getdirentries64 on macOS (different record layouts, see sy_dir_names). */
#if defined(__APPLE__)
static const long syp_ok = 1, syp_setsid = 147, syp_getpgid = 151, syp_socketpair = 135, syp_ioctl = 54,
                  syp_openat = 463, syp_linkat = 471, syp_flock = 131,
                  syp_mkdirat = 475, syp_unlinkat = 472, syp_dents = 344, syp_mac = 1, syp_at_removedir = 0x80,
                  syp_tiocgpgrp = 0x40047477L, syp_tiocspgrp = 0x80047476L, syp_at_fdcwd = -2;
#elif defined(__linux__) && defined(__aarch64__)
static const long syp_ok = 1, syp_setsid = 157, syp_getpgid = 155, syp_socketpair = 199, syp_ioctl = 29,
                  syp_openat = 56, syp_linkat = 37, syp_flock = 32,
                  syp_mkdirat = 34, syp_unlinkat = 35, syp_dents = 61, syp_mac = 0, syp_at_removedir = 0x200,
                  syp_tiocgpgrp = 0x540FL, syp_tiocspgrp = 0x5410L, syp_at_fdcwd = -100;
#elif defined(__linux__) && defined(__x86_64__)
static const long syp_ok = 1, syp_setsid = 112, syp_getpgid = 121, syp_socketpair = 53, syp_ioctl = 16,
                  syp_openat = 257, syp_linkat = 265, syp_flock = 73,
                  syp_mkdirat = 258, syp_unlinkat = 263, syp_dents = 217, syp_mac = 0, syp_at_removedir = 0x200,
                  syp_tiocgpgrp = 0x540FL, syp_tiocspgrp = 0x5410L, syp_at_fdcwd = -100;
#else
static const long syp_ok = 0, syp_setsid = 0, syp_getpgid = 0, syp_socketpair = 0, syp_ioctl = 0,
                  syp_openat = 0, syp_linkat = 0, syp_flock = 0,
                  syp_mkdirat = 0, syp_unlinkat = 0, syp_dents = 0, syp_mac = 0, syp_at_removedir = 0,
                  syp_tiocgpgrp = 0, syp_tiocspgrp = 0, syp_at_fdcwd = -1;
#endif

/* __syscall6 returns -errno on failure on every target (the carried headers
   rely on the same: include/unistd.h wraps it in _unisa_ret). */
static long syp(long n, long a, long b, long c, long d, long e) {
#if defined(_WIN32)
    (void)n; (void)a; (void)b; (void)c; (void)d; (void)e;
    return -ENOSYS;
#else
    if (!syp_ok) return -ENOSYS;
    return __syscall6(_UNISA_SC(n), a, b, c, d, e);
#endif
}

/* The directory fd that means "relative to the current directory" for
   sy_openat/sy_linkat (-1 where these calls are unavailable). */
int sy_at_fdcwd(void) { return (int)syp_at_fdcwd; }

/* Start a new session (the caller becomes its leader, with no controlling
   tty). The new session id, or -errno (-EPERM for a group leader). */
long sy_setsid(void) { return syp(syp_setsid, 0, 0, 0, 0, 0); }

/* The process group of PID (0: this process), or -errno. */
long sy_getpgid(int pid) { return syp(syp_getpgid, pid, 0, 0, 0, 0); }

/* Send SIG to every process of group PGRP. 0, or -errno. */
int sy_killpg(int pgrp, int sig) {
    if (pgrp <= 1) return -EINVAL;   /* 0 and 1 would mean "my group" and "everything" */
    errno = 0;
    return kill(-(pid_t)pgrp, sig) == 0 ? 0 : (errno ? -errno : -EIO);
}

/* A connected pair of AF_UNIX stream sockets into SV. 0, or -errno. */
int sy_socketpair(int sv[2]) {
    if (!sv) return -EINVAL;
    return (int)syp(syp_socketpair, 1 /* AF_UNIX */, 1 /* SOCK_STREAM */, 0, (long)sv, 0);
}

/* The foreground process group of the terminal on FD, or -errno (-ENOTTY). */
long sy_tcgetpgrp(int fd) {
    int pg = -1;
    long r = syp(syp_ioctl, fd, syp_tiocgpgrp, (long)&pg, 0, 0);
    return r < 0 ? r : pg;
}

/* Make PGRP the foreground process group of the terminal on FD. 0, or -errno. */
int sy_tcsetpgrp(int fd, int pgrp) {
    int pg = pgrp;
    return (int)syp(syp_ioctl, fd, syp_tiocspgrp, (long)&pg, 0, 0);
}

/* openat(2): PATH relative to directory DFD (sy_at_fdcwd() for the cwd). The fd, or -errno. */
int sy_openat(int dfd, const char *path, int flags, int mode) {
    if (!path || !path[0]) return -EINVAL;
    return (int)syp(syp_openat, dfd, (long)path, flags, mode, 0);
}

/* linkat(2): a new hard link NEWP (in NEWD) to OLDP (in OLDD). 0, or -errno (-EEXIST: NEWP exists). */
int sy_linkat(int oldd, const char *oldp, int newd, const char *newp, int flags) {
    if (!oldp || !oldp[0] || !newp || !newp[0]) return -EINVAL;
    return (int)syp(syp_linkat, oldd, (long)oldp, newd, (long)newp, flags);
}

/* mkdirat(2): directory NAME in DFD with MODE. 0, or -errno (-EEXIST when it exists). */
int sy_mkdirat(int dfd, const char *name, int mode) {
    if (!name || !name[0]) return -EINVAL;
    return (int)syp(syp_mkdirat, dfd, (long)name, mode, 0, 0);
}

/* unlinkat(2): remove NAME in DFD; DIR 1 removes an (empty) directory. 0, or -errno.
   An L0 primitive for code that owns the entry it removes (a temp file it just
   made); deleting trees and user paths goes through cx_rmtree, the guard. */
int sy_unlinkat(int dfd, const char *name, int dir) {
    if (!name || !name[0]) return -EINVAL;
    return (int)syp(syp_unlinkat, dfd, (long)name, dir ? syp_at_removedir : 0, 0, 0);
}

/* The entry names of the open directory DFD (without "." and ".."), each
   NUL-terminated, one after another in OUT. The count, -ENOSPC when OUT is
   too small, or -errno. Reads from the start: DFD's offset is rewound first.
   Linux records (getdents64): reclen at byte 16, name at 19. macOS records
   (getdirentries64): reclen at 16, namlen at 18, name at 21 -- written from
   <sys/dirent.h>, not yet run on a Mac. */
int sy_dir_names(int dfd, char *out, int cap) {
    static char buf[8192];
    int count = 0, used = 0;
    long base = 0;
    if (!out || cap < 1) return -EINVAL;
    if (lseek(dfd, 0, SEEK_SET) < 0) return -errno;
    for (;;) {
        long n = syp_mac ? syp(syp_dents, dfd, (long)buf, sizeof buf, (long)&base, 0)
                         : syp(syp_dents, dfd, (long)buf, sizeof buf, 0, 0);
        long at = 0;
        if (n < 0) return (int)n;
        if (n == 0) break;
        while (at < n) {
            unsigned short reclen = (unsigned short)((unsigned char)buf[at + 16] | ((unsigned char)buf[at + 17] << 8));
            const char *name = buf + at + (syp_mac ? 21 : 19);
            int len = 0;
            if (reclen == 0) return -EIO;
            if (syp_mac) len = (unsigned char)buf[at + 18] | ((unsigned char)buf[at + 19] << 8);
            else while (name + len < buf + at + reclen && name[len]) len++;
            if (!(len == 1 && name[0] == '.') && !(len == 2 && name[0] == '.' && name[1] == '.')) {
                if (used + len + 1 > cap) return -ENOSPC;
                { void *cx_kept = memcpy(out + used, name, (size_t)len); (void)cx_kept; }
                out[used + len] = 0;
                used += len + 1;
                count++;
            }
            at += reclen;
        }
    }
    return count;
}

/* Terminal modes, saved and put back whole (the kernel's termios through its
   ioctl: TCGETS/TCSETS[F] on Linux, TIOCGETA/TIOCSETA[F] on macOS). Opaque:
   only sy_tty_get fills it, and two are compared with sy_tty_same. */
typedef struct { unsigned char b[128]; } sy_tty_t;
#if defined(__APPLE__)
static const long syp_tcgets = 0x40487413L, syp_tcsets = 0x80487414L, syp_tcsetsf = 0x80487416L;
#else
static const long syp_tcgets = 0x5401L, syp_tcsets = 0x5402L, syp_tcsetsf = 0x5404L;
#endif

/* The modes of the terminal on FD into T. 0, or -errno (-ENOTTY: not a terminal). */
int sy_tty_get(int fd, sy_tty_t *t) {
    if (!t) return -EINVAL;
    memset(t, 0, sizeof *t);
    return (int)syp(syp_ioctl, fd, syp_tcgets, (long)t->b, 0, 0);
}

/* Set the terminal on FD to T. FLUSH 1 first waits for output to drain and
   drops unread input (TCSAFLUSH), 0 applies at once (TCSANOW). 0, or -errno. */
int sy_tty_set(int fd, const sy_tty_t *t, int flush) {
    if (!t) return -EINVAL;
    return (int)syp(syp_ioctl, fd, flush ? syp_tcsetsf : syp_tcsets, (long)t->b, 0, 0);
}

/* 1 when A and B hold the same modes. */
int sy_tty_same(const sy_tty_t *a, const sy_tty_t *b) {
    return a && b && memcmp(a->b, b->b, sizeof a->b) == 0;
}

/* flock(2) on FD: OP is 1 shared, 2 exclusive, 8 unlock, |4 not to wait.
   0, or -errno (-EWOULDBLOCK when held and not waiting). */
int sy_flock(int fd, int op) { return (int)syp(syp_flock, fd, op, 0, 0, 0); }

/* A POSIX record lock over all of FD (the lockf/fcntl kind, not flock's):
   WRITE 1 exclusive / 0 shared, WAIT 1 to block. Unlock with sy_unlockf.
   0, or -errno (-EAGAIN or -EACCES when held elsewhere and not waiting). */
int sy_lockf(int fd, int write, int wait) {
    struct flock l;
    memset(&l, 0, sizeof l);
    l.l_type = write ? F_WRLCK : F_RDLCK;
    l.l_whence = SEEK_SET;
    errno = 0;
    return fcntl(fd, wait ? F_SETLKW : F_SETLK, &l) == 0 ? 0 : (errno ? -errno : -EIO);
}

int sy_unlockf(int fd) {
    struct flock l;
    memset(&l, 0, sizeof l);
    l.l_type = F_UNLCK;
    l.l_whence = SEEK_SET;
    errno = 0;
    return fcntl(fd, F_SETLK, &l) == 0 ? 0 : (errno ? -errno : -EIO);
}
