#pragma unisa module fd
/* Descriptor duplication. dup is in the prelude on every target.
   dup2 is not: the Windows prelude refuses that name, because a HANDLE
   cannot be placed at a chosen number. Platform differences stay in the
   static helpers. No #include: unistd.h comes with the prelude.
   A negative descriptor is -EINVAL and does not call the kernel.
   A failed call returns -errno, or -EIO when errno stays 0.
   sy_dup returns the new descriptor. sy_dup2 returns NEWFD.
   On Windows sy_dup2 returns -ENOSYS. */
static int sy_dup_os(int fd) {
    int n;
    errno = 0;
    n = dup(fd);
    if (n < 0) return errno ? -errno : -EIO;
    return n;
}
static int sy_dup2_os(int oldfd, int newfd) {
#ifdef _WIN32
    (void)oldfd;
    (void)newfd;
    return -ENOSYS;
#else
    int n;
    errno = 0;
    n = dup2(oldfd, newfd);
    if (n < 0) return errno ? -errno : -EIO;
    return n;
#endif
}
int sy_dup(int fd) {
    if (fd < 0) return -EINVAL;
    return sy_dup_os(fd);
}
int sy_dup2(int oldfd, int newfd) {
    if (oldfd < 0 || newfd < 0) return -EINVAL;
    return sy_dup2_os(oldfd, newfd);
}
