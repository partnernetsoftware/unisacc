#pragma unisa module fs
#pragma unisa dock
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
/* L0 sys/fs: directories, modes and stat (plans/cx-layers.md). Errors are
   returned, never hidden: 0 or a value on success, -errno on failure.
   No #include: <sys/stat.h>, <fcntl.h> and errno come with the implicit
   prelude. Whole-file read/write stays cx_read/cx_write for now. */

typedef struct {
    long size;      /* bytes */
    long ino;
    long mtime;     /* seconds */
    int mode;       /* permission bits, 07777 */
    int kind;       /* 'f' regular, 'd' directory, 'l' symlink (sy_lstat only), 's' socket, 'p' fifo, '?' other */
    long uid;       /* owner */
    unsigned long dev;   /* device. Linux and macOS: (dev, ino) names one file. Windows leaves both 0. */
    long ctime;     /* status-change time, seconds. POSIX: last inode change, not settable by the
                       owner. Windows: creation time (a rewritten file keeps it only when the
                       bytes are written in place). */
} sy_stat_t;

static int sy_fail(void) { return errno ? -errno : -1; }

static void sy_fill(const struct stat *s, sy_stat_t *out) {
    out->size = (long)s->st_size;
    out->ino = (long)s->st_ino;
    out->mtime = (long)s->st_mtime;
    out->mode = (int)(s->st_mode & 07777);
    out->kind = S_ISREG(s->st_mode) ? 'f' : S_ISDIR(s->st_mode) ? 'd' : S_ISLNK(s->st_mode) ? 'l'
              : S_ISSOCK(s->st_mode) ? 's' : S_ISFIFO(s->st_mode) ? 'p' : '?';
    out->uid = (long)s->st_uid;
    out->dev = (unsigned long)s->st_dev;
    out->ctime = (long)s->st_ctime;
}

/* fstat FD into OUT. 0, or -errno. */
int sy_fstat(int fd, sy_stat_t *out) {
    struct stat s;
    errno = 0;
    if (!out) return -EINVAL;
    if (fstat(fd, &s) != 0) return sy_fail();
    sy_fill(&s, out);
    return 0;
}

/* Byte size of FD when it is a regular file. The size (0 is an empty file),
   or -1 when fstat fails or FD is not a regular file. Callers that only need
   this number do not copy sy_stat_t. */
long sy_reg_size(int fd) {
    sy_stat_t st;
    if (sy_fstat(fd, &st) != 0 || st.kind != 'f' || st.size < 0) return -1;
    return st.size;
}

/* Open PATH with the prelude's O_* FLAGS and MODE (used with O_CREAT), retrying EINTR. The fd, or -errno. */
int sy_open(const char *path, int flags, int mode) {
    int fd;
    if (!path || !path[0]) return -EINVAL;
    do { errno = 0; fd = open(path, flags, mode); } while (fd < 0 && errno == EINTR);
    return fd < 0 ? sy_fail() : fd;
}

/* Windows' prelude open has no O_CLOEXEC, O_NOFOLLOW, or O_NONBLOCK.
   Those flags stay here. Linux keeps the values host.cx used to pass. */
static int sy_open_new_os(const char *path, int mode) {
#ifdef _WIN32
    return sy_open(path, O_WRONLY | O_CREAT | O_EXCL, mode);
#else
    return sy_open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, mode);
#endif
}

static int sy_open_read_os(const char *path) {
#ifdef _WIN32
    return sy_open(path, O_RDONLY, 0);
#else
    return sy_open(path, O_RDONLY | O_NONBLOCK, 0);
#endif
}

/* Create a new file. -EEXIST when PATH is already there. The fd, or -errno.
   Linux: close-on-exec, and a final symlink is not followed. */
int sy_open_new(const char *path, int mode) {
    if (!path || !path[0]) return -EINVAL;
    return sy_open_new_os(path, mode);
}

/* Open PATH for reading. The fd, or -errno. Linux sets O_NONBLOCK. */
int sy_open_read(const char *path) {
    if (!path || !path[0]) return -EINVAL;
    return sy_open_read_os(path);
}

/* The canonical absolute path of PATH (symlinks, '.' and '..' resolved) into DST of CAP bytes.
   Its length, or -errno (-ENAMETOOLONG when it does not fit). Two names of one file give the same
   result, so module and file identity can compare these. */
int sy_realpath(const char *path, char *dst, int cap) {
    char tmp[4096];
    long n;
    if (!path || !path[0] || !dst || cap < 2) return -EINVAL;
    errno = 0;
    if (!realpath(path, tmp)) return sy_fail();
    n = 0; while (tmp[n]) n++;
    if (n + 1 > cap) return -ENAMETOOLONG;
    { long i; for (i = 0; i <= n; i++) dst[i] = tmp[i]; }
    return (int)n;
}

/* This process's executable path into DST. Its length, or -errno.
   Linux reads /proc/self/exe. Windows calls GetModuleFileNameA (kernel32). */
static int sy_self_path_os(char *dst, int cap) {
#ifdef _WIN32
    static __u_word fn;
    __u_word n;
    if (!fn) fn = _ux_sym("GetModuleFileNameA");
    if (!fn) return -ENOSYS;
    n = _ux_call(fn, 0, (__u_word)dst, (__u_word)cap, 0) & 0xFFFFFFFFL;
    if (n == 0) { _ux_fail(); return sy_fail(); }
    if (n >= (__u_word)cap) return -ENAMETOOLONG;
    return (int)n;
#else
    long n;
    errno = 0;
    n = readlink("/proc/self/exe", dst, (size_t)cap - 1);
    if (n < 0) return sy_fail();
    if (n >= cap) return -ENAMETOOLONG;
    dst[n] = 0;
    return (int)n;
#endif
}

int sy_self_path(char *dst, int cap) {
    if (!dst || cap < 2) return -EINVAL;
    return sy_self_path_os(dst, cap);
}

/* Reposition FD to OFF from WHENCE (the prelude's SEEK_SET/SEEK_CUR/SEEK_END). The new offset, or -errno. */
long sy_lseek(int fd, long off, int whence) {
    off_t r;
    errno = 0;
    r = lseek(fd, (off_t)off, whence);
    return r < 0 ? sy_fail() : (long)r;
}

/* Read up to N bytes from FD (retrying EINTR). The count, 0 at end, or -errno. */
long sy_read(int fd, void *buf, long n) {
    ssize_t k;
    do { errno = 0; k = read(fd, buf, (size_t)n); } while (k < 0 && errno == EINTR);
    return k < 0 ? sy_fail() : (long)k;
}

/* One read, EINTR not retried: a single interrupted read is -EINTR.  The count,
   0 at end, or -errno.  For callers whose contract is exactly one read and a
   signal means an error, not a silent retry (input.cx's cxi_read). */
long sy_read_once(int fd, void *buf, long n) {
    ssize_t k;
    errno = 0;
    k = read(fd, buf, (size_t)n);
    return k < 0 ? sy_fail() : (long)k;
}

/* Read exactly N bytes into BUF (retrying EINTR, the read half of sy_write_all).
   0 on success; -errno on error; -EIO when the end of input arrives before N
   bytes (a short read is a named error, not a silent partial). */
int sy_read_full(int fd, void *buf, long n) {
    char *p = buf;
    if (fd < 0 || !buf || n < 0) return -EINVAL;
    while (n > 0) {
        ssize_t k;
        errno = 0;
        k = read(fd, p, (size_t)n);
        if (k < 0 && errno == EINTR) continue;
        if (k <= 0) return k < 0 ? sy_fail() : -EIO;
        p += k;
        n -= (long)k;
    }
    return 0;
}

/* Write all N bytes of BUF to FD (a file or pipe; sockets: sy_send_all). 0, or -errno. */
int sy_write_all(int fd, const void *buf, long n) {
    const char *p = buf;
    while (n > 0) {
        ssize_t k;
        errno = 0;
        k = write(fd, p, (size_t)n);
        if (k < 0 && errno == EINTR) continue;
        if (k <= 0) return k < 0 ? sy_fail() : -EIO;
        p += k;
        n -= (long)k;
    }
    return 0;
}

/* fsync FD. 0, or -errno. */
int sy_fsync(int fd) {
    errno = 0;
    return fsync(fd) == 0 ? 0 : sy_fail();
}

/* fdatasync is not in the implicit prelude, so this L0 unit calls the raw
   syscall (Linux x86_64 75, aarch64 83).  Windows and macOS return -ENOSYS
   (no prelude _commit / fdatasync). */
static int sy_fdatasync_os(int fd) {
#ifdef _WIN32
    (void)fd;
    return -ENOSYS;
#elif defined(__linux__) && defined(__x86_64__)
    return (int)__syscall6(75, (long)fd, 0, 0, 0, 0);
#elif defined(__linux__) && defined(__aarch64__)
    return (int)__syscall6(83, (long)fd, 0, 0, 0, 0);
#else
    /* Darwin: fall back to fsync (stronger than fdatasync, so it is safe);
       the prelude has fsync but not fdatasync. */
    return sy_fsync(fd);
#endif
}

/* Flush FD's data (not the inode metadata) to disk (Rust std::fs::File::sync_data,
   POSIX fdatasync).  Faster than sy_fsync when the size/atime do not need to be
   durable.  0, or -errno. */
int sy_fdatasync(int fd) {
    if (fd < 0) return -EINVAL;
    return sy_fdatasync_os(fd);
}

/* The prelude ftruncate is a POSIX call; Windows has _chsize_s. */
static int sy_truncate_os(int fd, long size) {
#ifdef _WIN32
    (void)fd;
    (void)size;
    return -ENOSYS;
#else
    errno = 0;
    return ftruncate(fd, (off_t)size) == 0 ? 0 : sy_fail();
#endif
}

/* Set FD's length to SIZE bytes (Rust std::fs::File::set_len, POSIX ftruncate).
   A larger SIZE extends (the new bytes read as zero); a smaller SIZE truncates.
   0, or -errno: -EINVAL for a negative SIZE or a bad FD, -ENOSYS on Windows. */
int sy_truncate(int fd, long size) {
    if (fd < 0 || size < 0) return -EINVAL;
    return sy_truncate_os(fd, size);
}

/* Close FD. 0, or -errno. */
int sy_close(int fd) {
    errno = 0;
    return close(fd) == 0 ? 0 : sy_fail();
}

/* Make PATH (one level) with MODE. 0, or -errno (-EEXIST when it exists). */
int sy_mkdir(const char *path, int mode) {
    errno = 0;
    if (!path || !path[0]) return -EINVAL;
    return mkdir(path, (mode_t)mode) == 0 ? 0 : sy_fail();
}

/* mkfifo is not in the implicit prelude, so this L0 unit makes the FIFO with the
   raw mknodat syscall (Linux x86_64 259, aarch64 33; AT_FDCWD is -100).  Windows
   has no FIFO: -ENOSYS. */
static int sy_mkfifo_os(const char *path, int mode) {
#ifdef _WIN32
    (void)path;
    (void)mode;
    return -ENOSYS;
#elif defined(__linux__) && defined(__x86_64__)
    return (int)__syscall6(259, -100, (long)path, (long)(S_IFIFO | (mode & 07777)), 0, 0);
#elif defined(__linux__) && defined(__aarch64__)
    return (int)__syscall6(33, -100, (long)path, (long)(S_IFIFO | (mode & 07777)), 0, 0);
#else
    /* Darwin: the prelude has no mkfifo either; return -ENOSYS until a macOS
       syscall thunk is needed. */
    (void)path;
    (void)mode;
    return -ENOSYS;
#endif
}

/* Copy SRC to DST byte-for-byte (Rust std::fs::copy).  Built on sy_open + sy_read
   + sy_write_all, so no single POSIX call is needed and every platform has the
   parts.  The destination is created (O_TRUNC) with MODE.  A short read that is
   not end-of-input is -EIO.  0, or -errno. */
int sy_copy(const char *src, const char *dst, int mode) {
    int in, out, rc;
    char buf[8192];
    if (!src || !src[0] || !dst || !dst[0]) return -EINVAL;
    in = sy_open(src, O_RDONLY, 0);
    if (in < 0) return in;
    out = sy_open(dst, O_WRONLY | O_CREAT | O_TRUNC, mode);
    if (out < 0) { sy_close(in); return out; }
    for (;;) {
        long n = sy_read(in, buf, (long)sizeof buf);
        if (n < 0) { rc = (int)n; break; }
        if (n == 0) { rc = 0; break; }
        rc = sy_write_all(out, buf, n);
        if (rc) break;
    }
    sy_close(out);
    sy_close(in);
    return rc;
}

/* Make PATH a FIFO (named pipe) with MODE permission bits (Rust std::os::unix::
   fs::symlink's sibling; POSIX mkfifo).  0, or -errno: -EINVAL for an empty
   PATH, -ENOSYS on Windows and macOS. */
int sy_mkfifo(const char *path, int mode) {
    if (!path || !path[0]) return -EINVAL;
    return sy_mkfifo_os(path, mode);
}

/* Set PATH's permission bits. 0, or -errno. */
int sy_chmod(const char *path, int mode) {
    errno = 0;
    if (!path || !path[0]) return -EINVAL;
    return chmod(path, (mode_t)mode) == 0 ? 0 : sy_fail();
}

/* Make PATH this process's working directory. 0, or -errno (-EINVAL for an empty PATH).
   The prelude chdir is SetCurrentDirectoryA on Windows. */
int sy_chdir(const char *path) {
    errno = 0;
    if (!path || !path[0]) return -EINVAL;
    return chdir(path) == 0 ? 0 : sy_fail();
}

/* Windows: GetFileAttributesExA has no device or inode. (dev, ino) cannot
   say that two names are one file there; both fields stay 0. */
static int sy_stat_os(const char *path, sy_stat_t *out) {
#ifdef _WIN32
    static __u_word fn;
    unsigned int d[9];
    __u_word ticks;
    if (!fn) fn = _ux_sym("GetFileAttributesExA");
    if (!fn) return -ENOSYS;
    if (!(_ux_call(fn, (__u_word)path, 0, (__u_word)d, 0) & 0xFFFFFFFFL)) {
        _ux_fail();
        return sy_fail();
    }
    out->size = (long)(((__u_word)d[7] << 32) | (__u_word)d[8]);
    ticks = ((__u_word)d[6] << 32) | (__u_word)d[5];
    out->mtime = ticks > 116444736000000000LL ? (long)((ticks - 116444736000000000LL) / 10000000LL) : 0;
    out->mode = 0;
    out->kind = (d[0] & 0x10) ? 'd' : 'f';
    out->uid = 0;
    out->ino = 0;
    out->dev = 0;
    ticks = ((__u_word)d[4] << 32) | (__u_word)d[3];
    out->ctime = ticks > 116444736000000000LL ? (long)((ticks - 116444736000000000LL) / 10000000LL) : 0;
    return 0;
#else
    struct stat s;
    errno = 0;
    if (stat(path, &s) != 0) return sy_fail();
    sy_fill(&s, out);
    return 0;
#endif
}

/* stat PATH (following links) into OUT. 0, or -errno. */
int sy_stat(const char *path, sy_stat_t *out) {
    if (!path || !path[0] || !out) return -EINVAL;
    return sy_stat_os(path, out);
}

/* The prelude's Windows lstat is a call to stat, and stat is not a Windows
   function. This branch does not call either. A symlink is not kind 'l'. */
static int sy_lstat_os(const char *path, sy_stat_t *out) {
#ifdef _WIN32
    return sy_stat_os(path, out);
#else
    struct stat s;
    errno = 0;
    if (lstat(path, &s) != 0) return sy_fail();
    sy_fill(&s, out);
    return 0;
#endif
}

/* lstat PATH (a link is reported as kind 'l') into OUT. 0, or -errno.
   On Windows, kind is 'f' or 'd' only. */
int sy_lstat(const char *path, sy_stat_t *out) {
    if (!path || !path[0] || !out) return -EINVAL;
    return sy_lstat_os(path, out);
}

/* 1 when PATH is a regular file, 0 when it exists and is not, -ENOENT when
   absent, otherwise -errno. Linux uses lstat, so a symlink is not regular. */
int sy_is_reg(const char *path) {
    sy_stat_t st;
    int rc;
    if (!path || !path[0]) return -EINVAL;
    rc = sy_lstat(path, &st);
    if (rc != 0) return rc;
    return st.kind == 'f' ? 1 : 0;
}

/* Rename FROM to TO. 0, or -errno. */
int sy_rename(const char *from, const char *to) {
    errno = 0;
    if (!from || !from[0] || !to || !to[0]) return -EINVAL;
    return rename(from, to) == 0 ? 0 : sy_fail();
}

/* Unlink PATH. 0, or -errno. */
int sy_unlink(const char *path) {
    errno = 0;
    if (!path || !path[0]) return -EINVAL;
    return unlink(path) == 0 ? 0 : sy_fail();
}

/* Remove the empty directory PATH (Rust std::fs::remove_dir). 0, or -errno:
   -EINVAL for an empty argument, -ENOTEMPTY / -EEXIST / -ENOTDIR from the
   prelude rmdir. */
int sy_rmdir(const char *path) {
    errno = 0;
    if (!path || !path[0]) return -EINVAL;
    return rmdir(path) == 0 ? 0 : sy_fail();
}

/* The prelude symlink is a POSIX system call; Windows has none here. */
static int sy_symlink_os(const char *target, const char *link) {
#ifdef _WIN32
    (void)target;
    (void)link;
    return -ENOSYS;
#else
    errno = 0;
    return symlink(target, link) == 0 ? 0 : sy_fail();
#endif
}

/* Make LINK a symbolic link holding TARGET (not checked: a dangling link is allowed).
   0, or -errno: -EINVAL for an empty argument, -EEXIST when LINK exists; -ENOSYS on Windows. */
int sy_symlink(const char *target, const char *link) {
    if (!target || !target[0] || !link || !link[0]) return -EINVAL;
    return sy_symlink_os(target, link);
}

/* The prelude readlink is a POSIX system call; Windows has none here. */
static long sy_readlink_os(const char *path, char *dst, long cap) {
#ifdef _WIN32
    (void)path;
    (void)dst;
    (void)cap;
    return -ENOSYS;
#else
    long n;
    errno = 0;
    n = readlink(path, dst, (size_t)cap);
    if (n < 0) return sy_fail();
    return n;
#endif
}

/* Read the target PATH of the symbolic link PATH into DST (Rust std::fs::read_link).
   The target is written without a terminator when it exactly fills CAP; the caller
   may NUL-terminate at the returned length when it is < CAP.  Returns the target
   byte length, or -errno: -EINVAL for an empty/null argument, -EINVAL for a null
   DST or non-positive CAP, -ENOSYS on Windows. */
long sy_readlink(const char *path, char *dst, long cap) {
    if (!path || !path[0] || !dst || cap <= 0) return -EINVAL;
    return sy_readlink_os(path, dst, cap);
}

/* Same Windows limit as sy_lstat: do not call the prelude lstat. */
static int sy_exists_os(const char *path) {
#ifdef _WIN32
    sy_stat_t st;
    int rc;
    rc = sy_stat_os(path, &st);
    if (rc == 0) return 1;
    return rc == -ENOENT ? 0 : rc;
#else
    struct stat s;
    errno = 0;
    if (lstat(path, &s) == 0) return 1;
    return errno == ENOENT ? 0 : sy_fail();
#endif
}

/* 1 when PATH exists, 0 only when it does not (ENOENT), -errno for every
   other failure (ENOTDIR, EACCES, ...) and for an empty PATH: those are not
   "absent".  THIS IS THE ONE L0 CALL THAT IS A BOOLEAN -- sy_stat, sy_access
   and every other L0 function answer "0 means success", so `sy_exists(p) == 0`
   asks for "absent" and reads as the opposite of what it looks like. */
int sy_exists(const char *path) {
    if (!path || !path[0]) return -EINVAL;
    return sy_exists_os(path);
}

/* The prelude access is a POSIX call; Windows has no prelude _access here. */
static int sy_access_os(const char *path, int mode) {
#ifdef _WIN32
    (void)path;
    (void)mode;
    return -ENOSYS;
#else
    errno = 0;
    return access(path, mode) == 0 ? 0 : sy_fail();
#endif
}

/* Test PATH's accessibility for MODE (R_OK|W_OK|X_OK or F_OK, the prelude's flags;
   Rust std::fs::metadata's permission half).  0 when accessible, -errno otherwise
   (-ENOENT absent, -EACCES denied).  -EINVAL for an empty PATH. */
int sy_access(const char *path, int mode) {
    if (!path || !path[0]) return -EINVAL;
    return sy_access_os(path, mode);
}

/* ---- W3: whole-file and directory-tree completion (build/std-surface.tsv cx.os rows) ---- */

/* mkdir -p (Rust create_dir_all; Node mkdir recursive).  Every missing ancestor is made with MODE.
   0 (an existing directory counts), -ENOTDIR when PATH or an ancestor exists and is not a directory,
   else -errno.  Both '/' and (Windows) '\\' separate components. */
int sy_mkdir_all(const char *path, int mode) {
    char buf[4096];
    long n, i;
    int rc;
    sy_stat_t st;
    if (!path || !path[0]) return -EINVAL;
    n = (long)strlen(path);
    if (n >= (long)sizeof buf) return -ENAMETOOLONG;
    if (mm_copy(buf, (long)sizeof buf, path, n + 1)) return -ENAMETOOLONG;
    while (n > 1 && (buf[n - 1] == '/' || buf[n - 1] == '\\')) buf[--n] = 0;
    for (i = 1; i <= n; i++) {
        if (buf[i] != '/' && buf[i] != '\\' && buf[i] != 0) continue;
        {
            char keep = buf[i];
            buf[i] = 0;
            rc = sy_mkdir(buf, mode);
            if (rc == -EEXIST || rc == -EISDIR) {
                if (sy_stat(buf, &st) != 0 || st.kind != 'd') return -ENOTDIR;
                rc = 0;
            }
            buf[i] = keep;
            if (rc != 0) return rc;
        }
    }
    return 0;
}

/* Read all of PATH into a new buffer (*OUT, free with mm_free; one 0 byte follows the data and is not
   counted in *N).  MAX > 0 bounds the size: a larger file is -EFBIG, nothing allocated.  -errno
   otherwise; -ENOMEM when the buffer cannot be had. */
int sy_read_file(const char *path, unsigned char **out, int64_t *n, int64_t max) {
    int fd;
    sy_stat_t st;
    int64_t cap, got = 0;
    unsigned char *buf;
    if (!path || !out || !n) return -EINVAL;
    *out = 0;
    *n = 0;
    fd = sy_open(path, O_RDONLY, 0);
    if (fd < 0) return fd;
    cap = 4096;
    if (sy_fstat(fd, &st) == 0 && st.kind == 'f' && st.size > 0) cap = (int64_t)st.size + 1;
    if (max > 0 && cap > max + 1) cap = max + 1;
    buf = (unsigned char *)mm_alloc((size_t)cap + 1);
    if (!buf) { sy_close(fd); return -ENOMEM; }
    for (;;) {
        long r;
        if (got == cap) {
            unsigned char *nb;
            int64_t nc = cap * 2;
            if (max > 0 && got > max) break;
            nb = (unsigned char *)mm_alloc((size_t)nc + 1);
            if (!nb) { mm_free(buf); sy_close(fd); return -ENOMEM; }
            if (mm_copy(nb, (long)nc, buf, (long)got)) { mm_free(nb); mm_free(buf); sy_close(fd); return -EIO; }
            mm_free(buf);
            buf = nb;
            cap = nc;
        }
        r = sy_read(fd, buf + got, (long)(cap - got));
        if (r < 0) { mm_free(buf); sy_close(fd); return (int)r; }
        if (r == 0) break;
        got += r;
        if (max > 0 && got > max) break;
    }
    sy_close(fd);
    if (max > 0 && got > max) { mm_free(buf); return -EFBIG; }
    buf[got] = 0;
    *out = buf;
    *n = got;
    return 0;
}

static int sy_put_all(int fd, const void *buf, int64_t n) {
    const unsigned char *p = (const unsigned char *)buf;
    while (n > 0) {
        long w = write(fd, p, (size_t)(n > (1 << 30) ? (1 << 30) : n));
        if (w < 0) { if (errno == EINTR) continue; return sy_fail(); }
        if (w == 0) return -EIO;
        p += w;
        n -= w;
    }
    return 0;
}

static int sy_put_file(const char *path, const void *buf, int64_t n, int mode, int flags) {
    int fd, rc;
    if (!path || !path[0] || n < 0 || (n > 0 && !buf)) return -EINVAL;
    fd = sy_open(path, O_WRONLY | O_CREAT | flags, mode);
    if (fd < 0) return fd;
    rc = sy_put_all(fd, buf, n);
    if (sy_close(fd) != 0 && rc == 0) rc = -EIO;
    return rc;
}

/* Create or truncate PATH (MODE when created) and write N bytes.  0, or -errno.  Not atomic. */
int sy_write_file(const char *path, const void *buf, int64_t n, int mode) {
    return sy_put_file(path, buf, n, mode, O_TRUNC);
}

/* Append N bytes to PATH, creating it with MODE.  0, or -errno. */
int sy_append_file(const char *path, const void *buf, int64_t n, int mode) {
    return sy_put_file(path, buf, n, mode, O_APPEND);
}

static int sy_tmp_name(char *out, int cap, const char *dir, const char *prefix, const char *tag) {
    static unsigned long ctr;
    unsigned long v;
    int i, k = 0, n = 0;
    const char *a = dir;
    const char *al = "abcdefghijklmnopqrstuvwxyz0123456789";
    ctr++;
    v = ctr * 2654435761UL + (unsigned long)getpid() * 40503UL + (unsigned long)(size_t)&v;
    if (cap < 2) return -ERANGE;
    if (a && a[0]) {
        for (i = 0; a[i]; i++) { if (n + 1 >= cap) return -ERANGE; out[n++] = a[i]; }
        if (out[n - 1] != '/' && out[n - 1] != '\\') { if (n + 1 >= cap) return -ERANGE; out[n++] = '/'; }
    }
    for (i = 0; prefix && prefix[i]; i++) { if (n + 1 >= cap) return -ERANGE; out[n++] = prefix[i]; }
    for (i = 0; tag && tag[i]; i++) { if (n + 1 >= cap) return -ERANGE; out[n++] = tag[i]; }
    for (k = 0; k < 8; k++) {
        if (n + 1 >= cap) return -ERANGE;
        out[n++] = al[v % 36];
        v = v / 36 + v * 31 + 7;
    }
    out[n] = 0;
    return 0;
}

/* Replace PATH with N bytes: write a sibling temporary, fsync, rename over PATH.  On failure PATH is
   untouched and the temporary is removed.  0, or -errno. */
int sy_write_atomic(const char *path, const void *buf, int64_t n, int mode) {
    char tmp[4352];
    int fd, rc, tries;
    if (!path || !path[0] || n < 0 || (n > 0 && !buf)) return -EINVAL;
    if (strlen(path) > 4000) return -ENAMETOOLONG;
    for (tries = 0; tries < 16; tries++) {
        rc = sy_tmp_name(tmp, sizeof tmp, 0, path, ".tmp.");
        if (rc) return rc;
        fd = sy_open(tmp, O_WRONLY | O_CREAT | O_EXCL, mode);
        if (fd == -EEXIST) continue;
        if (fd < 0) return fd;
        rc = sy_put_all(fd, buf, n);
        if (rc == 0) rc = sy_fsync(fd);
        if (sy_close(fd) != 0 && rc == 0) rc = -EIO;
        if (rc == 0) rc = sy_rename(tmp, path);
        if (rc != 0) sy_unlink(tmp);
        return rc;
    }
    return -EEXIST;
}

/* Make a fresh directory (mode 0700) DIR/PREFIXxxxxxxxx and write its path into PATH (CAP bytes).
   0, -ERANGE when PATH is too small, else -errno. */
int sy_mkdtemp(const char *dir, const char *prefix, char *path, int cap) {
    int tries, rc;
    if (!path || cap < 1 || !dir || !dir[0]) return -EINVAL;
    for (tries = 0; tries < 32; tries++) {
        rc = sy_tmp_name(path, cap, dir, prefix ? prefix : "", "");
        if (rc) { path[0] = 0; return rc; }
        rc = sy_mkdir(path, 0700);
        if (rc == 0) return 0;
        if (rc != -EEXIST) { path[0] = 0; return rc; }
    }
    path[0] = 0;
    return -EEXIST;
}
