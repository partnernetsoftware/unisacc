#pragma unisa module fs
/* L0 sys/fs: directories, modes and stat (plans/cx-layers.md). Errors are
   returned, never hidden: 0 or a value on success, -errno on failure.
   No #include: <sys/stat.h>, <fcntl.h> and errno come with the implicit
   prelude. Whole-file read/write stays cx_read/cx_write for now. */

typedef struct {
    long size;      /* bytes */
    long ino;
    long mtime;     /* seconds */
    int mode;       /* permission bits, 07777 */
    int kind;       /* 'f' regular, 'd' directory, 'l' symlink (sy_lstat only), '?' other */
    long uid;       /* owner */
    unsigned long dev;   /* device; (dev, ino) names one file across hard links and mounts */
} sy_stat_t;

static int sy_fail(void) { return errno ? -errno : -1; }

static void sy_fill(const struct stat *s, sy_stat_t *out) {
    out->size = (long)s->st_size;
    out->ino = (long)s->st_ino;
    out->mtime = (long)s->st_mtime;
    out->mode = (int)(s->st_mode & 07777);
    out->kind = S_ISREG(s->st_mode) ? 'f' : S_ISDIR(s->st_mode) ? 'd' : S_ISLNK(s->st_mode) ? 'l' : '?';
    out->uid = (long)s->st_uid;
    out->dev = (unsigned long)s->st_dev;
}

/* fstat FD into OUT. 0, or -errno. */
int sy_fstat(int fd, sy_stat_t *out) {
    struct stat s;
    errno = 0;
    if (!out) return -EINVAL;
    if (fstat(fd, &s) != 0) return sy_fail();
    sy_fill(&s, out);
    return 0;
}

/* Open PATH with the prelude's O_* FLAGS and MODE (used with O_CREAT), retrying EINTR. The fd, or -errno. */
int sy_open(const char *path, int flags, int mode) {
    int fd;
    if (!path || !path[0]) return -EINVAL;
    do { errno = 0; fd = open(path, flags, mode); } while (fd < 0 && errno == EINTR);
    return fd < 0 ? sy_fail() : fd;
}

/* Windows' prelude open has no O_CLOEXEC, O_NOFOLLOW, or O_NONBLOCK.
   Those flags stay here. Linux keeps the values host.cx used to pass. */
static int sy_open_new_os(const char *path, int mode) {
#ifdef _WIN32
    return sy_open(path, O_WRONLY | O_CREAT | O_EXCL, mode);
#else
    return sy_open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, mode);
#endif
}

static int sy_open_read_os(const char *path) {
#ifdef _WIN32
    return sy_open(path, O_RDONLY, 0);
#else
    return sy_open(path, O_RDONLY | O_NONBLOCK, 0);
#endif
}

/* Create a new file. -EEXIST when PATH is already there. The fd, or -errno.
   Linux: close-on-exec, and a final symlink is not followed. */
int sy_open_new(const char *path, int mode) {
    if (!path || !path[0]) return -EINVAL;
    return sy_open_new_os(path, mode);
}

/* Open PATH for reading. The fd, or -errno. Linux sets O_NONBLOCK. */
int sy_open_read(const char *path) {
    if (!path || !path[0]) return -EINVAL;
    return sy_open_read_os(path);
}

/* The canonical absolute path of PATH (symlinks, '.' and '..' resolved) into DST of CAP bytes.
   Its length, or -errno (-ENAMETOOLONG when it does not fit). Two names of one file give the same
   result, so module and file identity can compare these. */
int sy_realpath(const char *path, char *dst, int cap) {
    char tmp[4096];
    long n;
    if (!path || !path[0] || !dst || cap < 2) return -EINVAL;
    errno = 0;
    if (!realpath(path, tmp)) return sy_fail();
    n = 0; while (tmp[n]) n++;
    if (n + 1 > cap) return -ENAMETOOLONG;
    { long i; for (i = 0; i <= n; i++) dst[i] = tmp[i]; }
    return (int)n;
}

/* Reposition FD to OFF from WHENCE (the prelude's SEEK_SET/SEEK_CUR/SEEK_END). The new offset, or -errno. */
long sy_lseek(int fd, long off, int whence) {
    off_t r;
    errno = 0;
    r = lseek(fd, (off_t)off, whence);
    return r < 0 ? sy_fail() : (long)r;
}

/* Read up to N bytes from FD (retrying EINTR). The count, 0 at end, or -errno. */
long sy_read(int fd, void *buf, long n) {
    ssize_t k;
    do { errno = 0; k = read(fd, buf, (size_t)n); } while (k < 0 && errno == EINTR);
    return k < 0 ? sy_fail() : (long)k;
}

/* Write all N bytes of BUF to FD (a file or pipe; sockets: sy_send_all). 0, or -errno. */
int sy_write_all(int fd, const void *buf, long n) {
    const char *p = buf;
    while (n > 0) {
        ssize_t k;
        errno = 0;
        k = write(fd, p, (size_t)n);
        if (k < 0 && errno == EINTR) continue;
        if (k <= 0) return k < 0 ? sy_fail() : -EIO;
        p += k;
        n -= (long)k;
    }
    return 0;
}

/* fsync FD. 0, or -errno. */
int sy_fsync(int fd) {
    errno = 0;
    return fsync(fd) == 0 ? 0 : sy_fail();
}

/* Close FD. 0, or -errno. */
int sy_close(int fd) {
    errno = 0;
    return close(fd) == 0 ? 0 : sy_fail();
}

/* Make PATH (one level) with MODE. 0, or -errno (-EEXIST when it exists). */
int sy_mkdir(const char *path, int mode) {
    errno = 0;
    if (!path || !path[0]) return -EINVAL;
    return mkdir(path, (mode_t)mode) == 0 ? 0 : sy_fail();
}

/* Set PATH's permission bits. 0, or -errno. */
int sy_chmod(const char *path, int mode) {
    errno = 0;
    if (!path || !path[0]) return -EINVAL;
    return chmod(path, (mode_t)mode) == 0 ? 0 : sy_fail();
}

/* stat PATH (following links) into OUT. 0, or -errno. */
int sy_stat(const char *path, sy_stat_t *out) {
    struct stat s;
    errno = 0;
    if (!path || !path[0] || !out) return -EINVAL;
    if (stat(path, &s) != 0) return sy_fail();
    sy_fill(&s, out);
    return 0;
}

/* lstat PATH (a link is reported as kind 'l') into OUT. 0, or -errno. */
int sy_lstat(const char *path, sy_stat_t *out) {
    struct stat s;
    errno = 0;
    if (!path || !path[0] || !out) return -EINVAL;
    if (lstat(path, &s) != 0) return sy_fail();
    sy_fill(&s, out);
    return 0;
}

/* Rename FROM to TO. 0, or -errno. */
int sy_rename(const char *from, const char *to) {
    errno = 0;
    if (!from || !from[0] || !to || !to[0]) return -EINVAL;
    return rename(from, to) == 0 ? 0 : sy_fail();
}

/* Unlink PATH. 0, or -errno. */
int sy_unlink(const char *path) {
    errno = 0;
    if (!path || !path[0]) return -EINVAL;
    return unlink(path) == 0 ? 0 : sy_fail();
}

/* 1 when PATH exists, 0 only when it does not (ENOENT), -errno for every
   other failure (ENOTDIR, EACCES, ...): those are not "absent". */
int sy_exists(const char *path) {
    struct stat s;
    errno = 0;
    if (!path || !path[0]) return -EINVAL;
    if (lstat(path, &s) == 0) return 1;
    return errno == ENOENT ? 0 : sy_fail();
}
