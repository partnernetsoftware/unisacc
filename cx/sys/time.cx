#pragma unisa module time
#pragma unisa dock
/* L0 sys/time: clocks, local-time text, sleeping and file times (plans/cx-layers.md).
   L0 exception (agreed for cx/sys/ only): <time.h>, <poll.h> and <sys/time.h>
   are not in the implicit prelude, and the carried headers already hold the
   per-target code (Linux clock syscalls, macOS libSystem clock_gettime,
   Windows clock adapters). They are included here, in one L0 unit, instead
   of copying that code or adding them to every unit's prelude. Upper layers
   see only the sy_* below.
   Other time and file-time operations retain their carried-header paths. */
#include <poll.h>
#include <sys/time.h>
#include <time.h>

/* Monotonic milliseconds from an arbitrary origin. On macOS the carried
   CLOCK_MONOTONIC uses libSystem clock_gettime, not the wall clock.
   -1 when the clock cannot be read. */
long sy_now_ms(void) {
    struct timespec t;
    if (clock_gettime(CLOCK_MONOTONIC, &t) != 0) return -1;
    return (long)t.tv_sec * 1000 + t.tv_nsec / 1000000;
}

/* Wall-clock seconds since the epoch, or -1. */
long sy_wall_s(void) {
    struct timespec t;
    if (clock_gettime(CLOCK_REALTIME, &t) != 0) return -1;
    return (long)t.tv_sec;
}

/* A clock reading: whole seconds and nanoseconds (0..999999999). */
typedef struct { long sec; long nsec; } sy_ts_t;

static int syt_clock(int id, sy_ts_t *t) {
    struct timespec s;
    if (!t) return -EINVAL;
    errno = 0;
    if (clock_gettime(id, &s) != 0) return errno ? -errno : -EIO;
    t->sec = (long)s.tv_sec;
    t->nsec = (long)s.tv_nsec;
    return 0;
}

/* The monotonic clock (same origin as sy_now_ms, retaining nanoseconds) into T.
   0, or -errno. */
int sy_mono(sy_ts_t *t) { return syt_clock(CLOCK_MONOTONIC, t); }

/* The wall clock (since the epoch) into T. 0, or -errno. */
int sy_wall(sy_ts_t *t) { return syt_clock(CLOCK_REALTIME, t); }

/* TO minus FROM in milliseconds (negative when TO is earlier), rounded toward zero. */
long sy_ts_ms(const sy_ts_t *from, const sy_ts_t *to) {
    long ns;
    if (!from || !to) return 0;
    ns = (to->sec - from->sec) * 1000000000L + (to->nsec - from->nsec);
    return ns / 1000000L;
}

/* SEC (seconds since the epoch) as local time, formatted by strftime FMT into
   OUT (CAP bytes, NUL-terminated). The length, -ERANGE when it does not fit,
   -EINVAL for a bad argument or a time localtime cannot represent. */
int sy_local_fmt(char *out, int cap, const char *fmt, long sec) {
    struct tm tm;
    time_t t = (time_t)sec;
    size_t n;
    if (!out || cap < 1 || !fmt) return -EINVAL;
    out[0] = 0;
    if (!localtime_r(&t, &tm)) return -EINVAL;
    if (!fmt[0]) return 0;
    n = strftime(out, (size_t)cap, fmt, &tm);
    if (n == 0) { out[0] = 0; return -ERANGE; }
    return (int)n;
}

/* Windows has no poll: a nap is the carried nanosleep (Sleep), and there is no
   readiness wait for an fd. Elsewhere both are poll. The exported functions have
   no #if. */
static int syt_nap(int ms) {
#ifdef _WIN32
    struct timespec q;
    q.tv_sec = ms / 1000; q.tv_nsec = (long)(ms % 1000) * 1000000L;
    return nanosleep(&q, NULL);
#else
    return poll(NULL, 0, ms);
#endif
}
static int syt_readable(int fd, long ms) {
#ifdef _WIN32
    (void)fd; (void)ms;
    return -ENOSYS;
#else
    struct pollfd p;
    int r;
    p.fd = fd; p.events = POLLIN; p.revents = 0;
    do r = poll(&p, 1, ms < 0 ? -1 : (int)(ms > 2000000000L ? 2000000000L : ms));
    while (r < 0 && errno == EINTR);
    if (r < 0) return -errno;
    return r > 0 ? 1 : 0;
#endif
}

/* Sleep MS milliseconds (poll with no fds; Windows: Sleep); an interruption resumes
   for what is left. 0, or -errno. */
int sy_sleep_ms(long ms) {
    long end = sy_now_ms() + ms, left = ms;
    while (left > 0) {
        if (syt_nap((int)(left > 2000000000L ? 2000000000L : left)) < 0 && errno != EINTR) return -errno;
        left = end - sy_now_ms();
    }
    return 0;
}

/* Wait up to MS (negative: forever) for FD to be readable (or hung up).
   1 readable, 0 timed out, -errno; -ENOSYS on Windows (no readiness wait here). */
int sy_readable(int fd, long ms) { return syt_readable(fd, ms); }

/* Linux: utimensat (x86_64 280, aarch64 88, AT_FDCWD -100). The two times are
   one second, matching sy_set_mtime. Apple keeps the libc utimes import.
   This unit does not define utimes. */
static int syt_utimes_os(const char *path, long sec) {
#if defined(__linux__)
    long ts[4];
    long result;
    ts[0] = sec;
    ts[1] = 0;
    ts[2] = sec;
    ts[3] = 0;
#if defined(__aarch64__)
    result = __syscall6(88, -100, (long)path, (long)ts, 0, 0);
#else
    result = __syscall6(280, -100, (long)path, (long)ts, 0, 0);
#endif
    if (result < 0) {
        errno = (int)-result;
        return -1;
    }
    return 0;
#elif defined(_WIN32)
    (void)path;
    (void)sec;
    return -1;
#else
    struct timeval tv[2];
    tv[0].tv_sec = tv[1].tv_sec = (time_t)sec;
    tv[0].tv_usec = tv[1].tv_usec = 0;
    return utimes(path, tv);
#endif
}

/* Windows has no utimes. Query the path with GetFileAttributesExA so a missing
   path still returns -ENOENT, then set both times with SetFileTime. The
   exported function has no #if. */
static int syt_set_mtime(const char *path, long sec) {
#ifdef _WIN32
    static __u_word attr_fn, create_fn, set_fn, close_fn;
    unsigned int attr[9], ft[2];
    __u_word ticks, handle, a[10];
    int i, err;
    if (!attr_fn) {
        attr_fn = _ux_sym("GetFileAttributesExA");
        create_fn = _ux_sym("CreateFileA");
        set_fn = _ux_sym("SetFileTime");
        close_fn = _ux_sym("CloseHandle");
    }
    if (!attr_fn || !create_fn || !set_fn || !close_fn) return -ENOSYS;
    if (!(_ux_call(attr_fn, (__u_word)path, 0, (__u_word)attr, 0) & 0xFFFFFFFFL)) {
        _ux_fail();
        return errno ? -errno : -EIO;
    }
    ticks = ((__u_word)sec) * 10000000LL + 116444736000000000LL;
    ft[0] = (unsigned int)ticks;
    ft[1] = (unsigned int)(ticks >> 32);
    i = 0;
    while (i < 10) { a[i] = 0; i++; }
    a[0] = (__u_word)path;
    a[1] = 0x100;       /* FILE_WRITE_ATTRIBUTES */
    a[2] = 7;           /* FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE */
    a[4] = 3;           /* OPEN_EXISTING */
    a[5] = 0x02000000;  /* FILE_FLAG_BACKUP_SEMANTICS, so a directory opens too */
    handle = __hostcall(create_fn, a);
    if (handle == 0 || handle + 1 == 0) {
        _ux_fail();
        return errno ? -errno : -EIO;
    }
    i = 0;
    while (i < 10) { a[i] = 0; i++; }
    a[0] = handle;
    a[2] = (__u_word)ft;
    a[3] = (__u_word)ft;
    if (!(__hostcall(set_fn, a) & 0xFFFFFFFFL)) {
        _ux_fail();
        err = errno ? -errno : -EIO;
        _ux_call(close_fn, handle, 0, 0, 0);
        return err;
    }
    if (!(_ux_call(close_fn, handle, 0, 0, 0) & 0xFFFFFFFFL)) {
        _ux_fail();
        return errno ? -errno : -EIO;
    }
    return 0;
#else
    struct stat s;
    errno = 0;
    if (stat(path, &s) != 0) return errno ? -errno : -EIO;
    errno = 0;
    if (syt_utimes_os(path, sec) == 0) return 0;
    return errno ? -errno : -EIO;
#endif
}

/* Set PATH's access and modification times to SEC (whole seconds). 0, or -errno.
   The path is stat'ed first on non-Windows so ENOENT, ENOTDIR and EACCES come
   from stat. The set itself is syt_utimes_os (Linux utimensat, Apple utimes);
   a failure there with no errno is -EIO. */
int sy_set_mtime(const char *path, long sec) {
    if (!path || !path[0]) return -EINVAL;
    return syt_set_mtime(path, sec);
}

/* Monotonic nanoseconds (same origin as sy_now_ms), 64 bits wide so Windows' 32-bit
   long does not limit it. Negative -errno when the clock cannot be read. */
int64_t sy_mono_ns(void) {
    sy_ts_t t;
    int r = sy_mono(&t);
    if (r < 0) return (int64_t)r;
    return (int64_t)t.sec * 1000000000LL + (int64_t)t.nsec;
}

/* A point on the monotonic clock; at_ns 0 means no deadline. */
typedef struct { int64_t at_ns; } sy_deadline_t;

sy_deadline_t sy_deadline_never(void) {
    sy_deadline_t d;
    d.at_ns = 0;
    return d;
}

/* MS from now; MS <= 0 gives a deadline that has already passed. */
sy_deadline_t sy_deadline_in(long ms) {
    sy_deadline_t d;
    int64_t now = sy_mono_ns();
    if (now < 0) now = 0;
    d.at_ns = ms <= 0 ? now : now + (int64_t)ms * 1000000LL;
    if (d.at_ns <= 0) d.at_ns = 1;
    return d;
}

/* Milliseconds left, rounded up: 0 once passed, -1 for no deadline. */
long sy_deadline_left(const sy_deadline_t *d) {
    int64_t now, rest;
    if (!d || d->at_ns == 0) return -1;
    now = sy_mono_ns();
    if (now < 0) return 0;
    rest = d->at_ns - now;
    if (rest <= 0) return 0;
    rest = (rest + 999999LL) / 1000000LL;
    return rest > 2000000000LL ? 2000000000L : (long)rest;
}

/* 1 when the deadline has passed, 0 otherwise (no deadline: 0). */
int sy_deadline_passed(const sy_deadline_t *d) {
    if (!d || d->at_ns == 0) return 0;
    return sy_deadline_left(d) == 0 ? 1 : 0;
}

/* The earlier of two deadlines; a missing one (at_ns 0) yields to the other. */
sy_deadline_t sy_deadline_min(const sy_deadline_t *a, const sy_deadline_t *b) {
    if (!a || a->at_ns == 0) return b ? *b : sy_deadline_never();
    if (!b || b->at_ns == 0) return *a;
    return a->at_ns <= b->at_ns ? *a : *b;
}

/* Sleep up to D, resuming after an interruption. 0, -EINVAL for no deadline or NULL. */
int sy_sleep_until(const sy_deadline_t *d) {
    long left;
    if (!d || d->at_ns == 0) return -EINVAL;
    while ((left = sy_deadline_left(d)) > 0) {
        int r = sy_sleep_ms(left);
        if (r < 0) return r;
    }
    return 0;
}

/* Index of the earliest of DS[0..N), with *WAIT_MS its sy_deadline_left; -1 when none has a
   deadline (*WAIT_MS -1); -EINVAL for a bad argument. */
int sy_timer_next(const sy_deadline_t *ds, int n, long *wait_ms) {
    int i, best = -1;
    if (!wait_ms || n < 0 || (n > 0 && !ds)) return -EINVAL;
    for (i = 0; i < n; i++)
        if (ds[i].at_ns != 0 && (best < 0 || ds[i].at_ns < ds[best].at_ns)) best = i;
    *wait_ms = best < 0 ? -1 : sy_deadline_left(&ds[best]);
    return best;
}
