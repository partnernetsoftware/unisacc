#pragma unisa module cap
#pragma unisa dock
#pragma unisa use sys.capgen
/* L0 sys/cap: runtime capability query (prd_cx.md 0.7 C5).  sy_cap(SY_CAP_X) is 1 when the target
   refuses no function tagged `cap=X` in build/std-surface.tsv; an unknown value is 0.  The values are
   the generated table sy_cap_tab (tools/cap-gen.cx); this file only picks the target column. */

/* Target column of sy_cap_tab: 0 lnx, 1 osx, 2 win. */
static int sy_cap_col_os(void) {
#ifdef _WIN32
    return 2;
#else
#ifdef __APPLE__
    return 1;
#else
    return 0;
#endif
#endif
}

int sy_cap(int cap) {
    if (cap < 0 || cap >= SY_CAP_COUNT) return 0;
    return sy_cap_tab_get(cap, sy_cap_col_os()) ? 1 : 0;
}
