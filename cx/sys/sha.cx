#pragma unisa module sha
/* L0 sys/sha: SHA-256 of a memory block as 64 lowercase hex digits.
   Linux x86_64 asks the kernel AF_ALG socket (same layout and calls as
   exec/c/runreuse.h rr_afalg_hex): socket(38, 5, 0), bind "hash"/"sha256",
   accept, one write of the whole block, one read of 32 bytes.
   A short write is not continued: a second write would be a second record.
   Any failure returns non-zero and leaves hex empty, so the caller can fall
   back to cx_sha256_hex. Other targets return non-zero at once.
   The public function has no #if: the module scan rejects a conditional
   export. The platform split stays in the static helper.
   L0 exception (cx/sys only): <sys/socket.h> is not in the implicit prelude. */
#include <sys/socket.h>

static int sy_sha256_af(const void *data, long n, char hex[65]) {
#if defined(__linux__) && defined(__x86_64__)
    struct { unsigned short family; unsigned char type[14]; unsigned feat, mask; unsigned char name[64]; } addr;
    int sfd, bfd, i;
    unsigned char md[32];
    ssize_t sent, got;
    if (!hex || n < 0 || (!data && n > 0)) return 1;
    hex[0] = 0;
    memset(&addr, 0, sizeof addr);
    addr.family = 38; /* Linux AF_ALG */
    { void *cx_kept = memcpy(addr.type, "hash", 5); (void)cx_kept; }
    { void *cx_kept = memcpy(addr.name, "sha256", 7); (void)cx_kept; }
    sfd = socket(38, 5, 0); /* SOCK_SEQPACKET */
    if (sfd < 0) return 1;
    if (bind(sfd, (const struct sockaddr *)&addr, sizeof addr)) { close(sfd); return 1; }
    bfd = accept(sfd, 0, 0);
    if (bfd < 0) { close(sfd); return 1; }
    do { errno = 0; sent = write(bfd, data, (size_t)n); } while (sent < 0 && errno == EINTR);
    if (sent != (ssize_t)n) { close(bfd); close(sfd); return 1; }
    do { errno = 0; got = read(bfd, md, 32); } while (got < 0 && errno == EINTR);
    close(bfd);
    close(sfd);
    if (got != 32) return 1;
    for (i = 0; i < 32; i++) {
        hex[2 * i] = "0123456789abcdef"[md[i] >> 4];
        hex[2 * i + 1] = "0123456789abcdef"[md[i] & 15];
    }
    hex[64] = 0;
    return 0;
#else
    (void)data;
    (void)n;
    if (hex) hex[0] = 0;
    return 1;
#endif
}

int sy_sha256_hex(const void *data, long n, char hex[65]) {
    return sy_sha256_af(data, n, hex);
}
