#pragma unisa module bytes
/* L0 mem/bytes: length-checked byte copy, move, fill and compare, so that upper layers need no
   memcpy/memmove/memset/memcmp (tests/cxraw.cx).  Every call names the destination capacity; a
   request that does not fit is refused before any byte is written.
     mm_copy(dst, dcap, src, n)   0, or -EINVAL (null with n > 0, negative n or dcap), -ERANGE (n > dcap);
                                  dst and src must not overlap (use mm_move)
     mm_move(dst, dcap, src, n)   as mm_copy, overlap allowed
     mm_fill(dst, dcap, byte, n)  as mm_copy, every byte set to BYTE & 255
     mm_same(a, b, n)             1 when the n bytes are equal, 0 when not (or n < 0, or a null with n > 0)
     mm_cmp(a, b, n)              <0, 0, >0 as unsigned bytes; 0 for n <= 0
   n == 0 is always allowed and touches nothing.  This module is the bottom layer: it may call libc. */

static int mm_check(const void *dst, long dcap, const void *src, long n) {
    if (n < 0 || dcap < 0) return -EINVAL;
    if (n == 0) return 0;
    if (!dst || !src) return -EINVAL;
    if (n > dcap) return -ERANGE;
    return 1;
}

int mm_copy(void *dst, long dcap, const void *src, long n) {
    int r = mm_check(dst, dcap, src, n);
    if (r <= 0) return r;
    { void *kept = memcpy(dst, src, (size_t)n); (void)kept; }
    return 0;
}

int mm_move(void *dst, long dcap, const void *src, long n) {
    int r = mm_check(dst, dcap, src, n);
    if (r <= 0) return r;
    { void *kept = memmove(dst, src, (size_t)n); (void)kept; }
    return 0;
}

int mm_fill(void *dst, long dcap, int byte, long n) {
    int r = mm_check(dst, dcap, dst, n);
    if (r <= 0) return r;
    { void *kept = memset(dst, byte & 255, (size_t)n); (void)kept; }
    return 0;
}

int mm_same(const void *a, const void *b, long n) {
    if (n < 0) return 0;
    if (n == 0) return 1;
    if (!a || !b) return 0;
    return memcmp(a, b, (size_t)n) == 0;
}

int mm_cmp(const void *a, const void *b, long n) {
    if (n <= 0 || !a || !b) return 0;
    return memcmp(a, b, (size_t)n);
}
