#pragma unisa module heap
/* L0 mem/heap: single-block heap allocation, so that upper layers need no malloc/calloc/realloc/free/
   strdup (tests/cxraw.cx).  The semantics are libc's, so a migration is a mechanical rename; ownership
   and bounds checks are not added here (cx/core/memory.cx holds the handle-checked form, mem.arena the
   grouped form).
     mm_alloc(n)      n > 0 bytes, or 0 (failure, or n <= 0)
     mm_zalloc(n)     as mm_alloc, zero-filled (calloc)
     mm_grow(p, n)    realloc: the block moved or grown to n > 0 bytes; on failure 0 and P stays valid;
                      p == 0 allocates; n <= 0 is refused with 0 and P left alone (no free-by-realloc)
     mm_free(p)       free; mm_free(0) does nothing
     mm_strdup(s)     a heap copy of the NUL-terminated S, or 0 (failure, or s == 0)
   This module is the bottom layer: it may call libc. */

void *mm_alloc(long n) {
    if (n <= 0) return 0;
    return malloc((size_t)n);
}

void *mm_zalloc(long n) {
    if (n <= 0) return 0;
    return calloc(1, (size_t)n);
}

void *mm_grow(void *p, long n) {
    if (n <= 0) return 0;
    return realloc(p, (size_t)n);
}

void mm_free(void *p) {
    if (p) free(p);
}

char *mm_strdup(const char *s) {
    size_t n;
    char *d;
    if (!s) return 0;
    n = strlen(s);
    d = malloc(n + 1);
    if (!d) return 0;
    { void *kept = memcpy(d, s, n + 1); (void)kept; }
    return d;
}
