# Bytes are the identity of this repository: the product closure digest hashes file contents,
# so no platform may rewrite line endings on checkout (Windows runners default to autocrlf).
* -text
agentwork/ledger.tsv merge=union
build/pkg-gaps.tsv merge=union
# Registry tables: every new check appends one row to each; parallel patches collide at the tail.
# Union is safe here because tests/run.cx metadata validation rejects duplicate batch/coverage ids
# (tools/cxlib/testplan.cx), so a same-row edit on both sides surfaces as a loud metadata failure.
tests/batches.tsv merge=union
tests/coverage.tsv merge=union
tests/tools-compile-sources.tsv merge=union
