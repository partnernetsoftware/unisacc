/* New compiler entry. archive/reference-c/unisacc.c and
   archive/reference-c/exec/c/compiler.c are reference only.
   Seven byte streams from Paper A. Word class comes from bindhost. */
#pragma unisa use compiler.bindhost
#pragma unisa use compiler.bindsym
#pragma unisa use compiler.hostbind
#pragma unisa use driver.cli
#pragma unisa use driver.archive
#pragma unisa use driver.route
#pragma unisa use driver.deps
#pragma unisa use driver.input
#pragma unisa use compiler.asmtext
/* 1 ar, 2 as, 3 nm/objdump, 11 version, 12 help, 13 --, 20 source.
   0 is an ordinary word. A null pointer returns 4. */
int us_word(const char *word, int is_object) {
    int tool;
    int cli;
    int src;
    if (!word) return 4;
    tool = bx_tool(word);
    if (tool == 4) return 4;
    if (tool == 1 || tool == 2 || tool == 3) return tool;
    cli = bx_cli_word(word);
    if (cli == 4) return 4;
    if (cli == 1) return 11;
    if (cli == 2) return 12;
    if (cli == 3) return 13;
    src = bx_more_src(word, is_object);
    if (src == 4) return 4;
    if (src == 1) return 20;
    return 0;
}
int us_version(const char **out) {
    if (!out) return 4;
    *out = "0.0.43";
    return 0;
}
int us_help(const char **out) {
    if (!out) return 4;
    *out = "unisacc FILE [-S|-c|-o FILE|-run]\nDiagnostic, non-stable: --emit-host-symbols FILE (-S/-c/-o, not -run)\nDiagnostic, non-stable: --host-provider FILE (12-byte capability filter; no addresses)\n";
    return 0;
}
int us_stream_count(void) {
    return 7;
}
int us_stream_name(int index, const char **out) {
    if (!out) return 4;
    if (index == 0) { *out = "e2"; return 0; }
    if (index == 1) { *out = "e1"; return 0; }
    if (index == 2) { *out = "e3"; return 0; }
    if (index == 3) { *out = "e4"; return 0; }
    if (index == 4) { *out = "prune"; return 0; }
    if (index == 5) { *out = "lower"; return 0; }
    if (index == 6) { *out = "elf"; return 0; }
    return 2;
}
static char us_in[262144];
static char us_obj[1048576];
static long us_objn;
int us_emit(char *p, long n) {
    long i;
    if (!p || n < 0 || us_objn > 1048576 - n) return 1;
    i = 0;
    while (i < n) {
        us_obj[us_objn] = p[i];
        us_objn = us_objn + 1;
        i = i + 1;
    }
    return 0;
}
int us_read(const char *path, long *n) {
    FILE *f;
    long got;
    if (!path || !n) return 4;
    f = fopen(path, "rb");
    if (!f) return 1;
    got = (long)fread(us_in, 1, 262143, f);
    if (fclose(f)) return 1;
    us_in[got] = 0;
    *n = got;
    return 0;
}
int us_as(int argc, char **argv) {
    const char *in;
    const char *out;
    char line[256];
    int i;
    int arch;
    int explicit;
    int head;
    long n;
    FILE *f;
    in = 0;
    out = "a.out";
    arch = 0;
    explicit = 0;
    i = 2;
    while (i < argc) {
        if (argv[i][0] == '-' && argv[i][1]) {
            if (!strcmp(argv[i], "-o") && i + 1 < argc) {
                out = argv[i + 1];
                i = i + 2;
                continue;
            }
            if (!strcmp(argv[i], "-b") && i + 1 < argc) {
                arch = bx_as_arch(argv[i + 1]);
                if (arch != 0 && arch != 1) {
                    fputs(bx_as_targets(), stderr);
                    return 2;
                }
                explicit = 1;
                i = i + 2;
                continue;
            }
            if (bx_as_opt_line(argv[i], line, 256) == 0) fputs(line, stderr);
            else fprintf(stderr, "as: unknown option %s\n", argv[i]);
            return 2;
        }
        in = argv[i];
        i = i + 1;
    }
    if (!in) {
        fputs(bx_as_usage(), stderr);
        return 2;
    }
    if (us_read(in, &n)) {
        fprintf(stderr, "as: cannot read %s\n", in);
        return 1;
    }
    us_objn = 0;
    if (at_bind(us_emit)) return 1;
    head = at_header_arch(us_in, n);
    if (explicit && head >= 0 && head != arch) {
        if (bx_as_head_line(in, line, 256) == 0) fputs(line, stderr);
        else fprintf(stderr, "as: %s: -S header target conflicts with -b\n", in);
        return 1;
    }
    if (at_asm(us_in, n, arch)) {
        if (bx_as_err_line(in, at_line(), at_error(), line, 256) == 0) fputs(line, stderr);
        else fprintf(stderr, "as: %s:%d: %s\n", in, at_line(), at_error()[0] ? at_error() : "error");
        return 1;
    }
    f = fopen(out, "wb");
    if (!f) {
        if (bx_as_write_line(out, line, 256) == 0) fputs(line, stderr);
        else fprintf(stderr, "as: cannot write %s\n", out);
        return 1;
    }
    if (fwrite(us_obj, 1, (size_t)us_objn, f) != (size_t)us_objn || fclose(f)) {
        if (bx_as_write_line(out, line, 256) == 0) fputs(line, stderr);
        else fprintf(stderr, "as: cannot write %s\n", out);
        return 1;
    }
    return 0;
}
int us_view(int argc, char **argv) {
    int dis;
    const char *path;
    char line[256];
    long n;
    dis = argv[1][0] == 'o';
    if (dis ? (argc != 4 || strcmp(argv[2], "-d")) : argc != 3) {
        fputs(bx_view_usage(dis), stderr);
        return 2;
    }
    path = argv[dis ? 3 : 2];
    if (us_read(path, &n)) {
        fprintf(stderr, "%s: cannot read %s\n", dis ? "objdump" : "nm", path);
        return 1;
    }
    us_objn = 0;
    if (at_bind(us_emit)) return 1;
    if (dis ? at_dis(us_in, n) : at_nm(us_in, n)) {
        if (bx_view_err_line(dis, path, at_error(), line, 256) == 0) fputs(line, stderr);
        else fprintf(stderr, "%s: %s: %s\n", dis ? "objdump" : "nm", path, at_error());
        return 1;
    }
    if (us_objn) fwrite(us_obj, 1, (size_t)us_objn, stdout);
    return 0;
}
int us_ar(int argc, char **argv) {
    char why[128];
    if (argc < 4) {
        fputs(bx_ar_usage(), stderr);
        return 2;
    }
    if (cxr_operation(argv[2], why, 128)) {
        fputs(why, stderr);
        return 2;
    }
    return 2;
}
int us_inc_read(void *ud, const char *path, int n, char *dst, int cap, int *outn) {
    char name[1024];
    unsigned char *b;
    long len;
    char why[64];
    int i;
    int rc;
    (void)ud;
    if (!path || !dst || !outn || n < 0 || cap < 0) return 4;
    if (n >= 1024) return 4;
    i = 0;
    while (i < n) {
        name[i] = path[i];
        i = i + 1;
    }
    name[n] = 0;
    b = 0;
    len = 0;
    rc = cxi_read(name, &b, &len, why, 64);
    if (rc) {
        free(b);
        if (rc == 1) return 1;
        return 2;
    }
    if (len > cap) {
        free(b);
        return 2;
    }
    i = 0;
    while (i < (int)len) {
        dst[i] = (char)b[i];
        i = i + 1;
    }
    *outn = (int)len;
    free(b);
    return 0;
}
int us_fail(const char *s) {
    char line[512];
    if (!s) return 1;
    if (bx_cli_line(s, line, 512) == 0) {
        fputs(line, stderr);
        return 1;
    }
    fprintf(stderr, "unisacc: model driver: %s\n", s);
    return 1;
}
int main(int argc, char **argv) {
    static CxcState opts;
    char why[128];
    const char *src;
    const char *text;
    const char *shown;
    static char objname[520];
    unsigned char *gotb;
    long gotn;
    int ppn;
    int didpp;
    int i;
    int next;
    int parsed;
    int kind;
    src = 0;
    if (argc < 2) return us_fail(bx_src_why(0));
    kind = us_word(argv[1], 0);
    if (kind == 1) return us_ar(argc, argv);
    if (kind == 2) return us_as(argc, argv);
    if (kind == 3) return us_view(argc, argv);
    if (cxc_default_run(&opts, argv, argc, why, 128)) return us_fail(why);
    i = 1;
    while (i < argc) {
        next = i;
        parsed = cxc_step(&opts, argv, argc, &next, why, 128);
        if (parsed == 0) {
            i = next;
            continue;
        }
        if (parsed == 5 || parsed == 7) return us_fail(why);
        if (parsed != 1) return us_fail(why);
        kind = us_word(argv[i], 0);
        if (kind == 11) {
            if (us_version(&text) != 0) return 1;
            printf("unisacc %s\n", text);
            return 0;
        }
        if (kind == 12) {
            if (us_help(&text) != 0) return 1;
            printf("%s", text);
            return 0;
        }
        if (kind == 13) break;
        if (bx_opt_dash(argv[i]) == 1) return us_fail(bx_opt_why(opts.defrun, src));
        if (!src) src = argv[i];
        i = i + 1;
    }
    if (!src) return us_fail(bx_src_why(0));
    shown = opts.out;
    gotb = 0;
    gotn = 0;
    ppn = 0;
    didpp = 0;
    {
        CxtIn in;
        CxtOut outv;
        char why2[512];
        char route[96];
        const char *tgt;
        int mode2;
        int runit2;
        int clear2;
        int need;
        int obj;
        int asmw;
        int rc;
        mode2 = opts.mode;
        need = 0;
        obj = 0;
        asmw = 0;
        rc = cxt_object(opts.mode, opts.sawc, opts.sawS, opts.funit, opts.target, opts.out, 0, &mode2, &need, &obj, &asmw, why2, 512);
        if (rc == 4) {
            fputs(why2, stderr);
            return 1;
        }
        if (rc) return us_fail(why2);
        tgt = opts.target;
        runit2 = opts.runit;
        clear2 = 0;
        in.mode = mode2;
        in.level = opts.level;
        in.warnings = opts.warnings;
        in.nsources = 1;
        in.runit = runit2;
        in.emitbin = opts.emitbin;
        in.deponly = opts.deponly;
        in.src_tape = 0;
        in.src_tapebin = 0;
        in.linking = 0;
        in.single = 0;
        in.exec_restart = 0;
        in.target = tgt;
        in.native = "lnx/x86_64";
        in.linked_target = 0;
        in.only_target = 0;
        outv.target = &tgt;
        outv.mode = &mode2;
        outv.runit = &runit2;
        outv.clear_deps = &clear2;
        rc = cxt_decide(&in, &outv, why2, 512);
        if (rc == 4) {
            fputs(why2, stderr);
            return 1;
        }
        if (rc) return us_fail(why2);
        if (bx_diag_opt(opts.host_symbols_path, opts.host_provider_path, hb_target_id(tgt), mode2, opts.emitbin, asmw))
            return us_fail("bind: diagnostic option mode/target not supported");
        if (bx_diag_run(opts.host_symbols_path, runit2))
            return us_fail("bind: --emit-host-symbols cannot be used with -run or stdout");
        rc = cxt_text(tgt, mode2, 1, opts.warnings, opts.level, route, 96, why2, 512);
        if (rc) return us_fail(why2);
        if (need) {
            rc = cxd_default_target(src, objname, 520, why2, 512);
            if (rc) return us_fail(why2);
            shown = objname;
        }
        {
            char reason[128];
            char line[512];
            int act;
            int pr;
            const char *shown_in;
            rc = cxi_read(src, &gotb, &gotn, reason, 128);
            act = bx_read_act(rc);
            if (act == 1) {
                if (bx_read_open_line(src, reason, line, 512) == 0) fputs(line, stderr);
                else fprintf(stderr, "unisacc: error: cannot open %s%s%s\n", src, reason[0] ? ": " : "", reason);
                return 1;
            }
            if (act == 2) {
                shown_in = bx_read_stdin(src) == 1 ? "stdin" : src;
                if (bx_read_fail_line(shown_in, line, 512) == 0) fputs(line, stderr);
                else fprintf(stderr, "run: cannot read %s\n", shown_in);
                fputs("run: cannot read input\n", stderr);
                return 1;
            }
            if (act) {
                fprintf(stderr, "run: %s\n", bx_read_die(act));
                return 1;
            }
            if (gotn > 2147483647L) {
                free(gotb);
                fprintf(stderr, "run: %s\n", bx_read_die(4));
                return 1;
            }
            if (mode2 == 1) {
                pr = pp_splice((char *)gotb, (int)gotn, (char *)gotb, (int)gotn, &ppn);
                if (pr == 0) pr = pp_decomment((char *)gotb, ppn, (char *)gotb, (int)gotn, &ppn);
                if (pr == 2) {
                    free(gotb);
                    fputs("unisacc: error: unterminated comment\n", stderr);
                    return 1;
                }
                if (pr) {
                    free(gotb);
                    return us_fail("preprocess failed");
                }
                {
                    char *outb;
                    char *work;
                    char why3[128];
                    int outn;
                    long cap;
                    cap = (long)ppn * 8 + 4096;
                    outb = (char *)malloc((size_t)cap);
                    work = (char *)malloc(65536);
                    if (!outb || !work) {
                        free(outb);
                        free(work);
                        free(gotb);
                        fprintf(stderr, "run: %s\n", bx_read_die(6));
                        return 1;
                    }
                    outn = 0;
                    pr = pp_expand((char *)gotb, ppn, outb, (int)cap, &outn, work, 65536, us_inc_read, 0, why3, 128);
                    free(work);
                    if (pr == 2) {
                        free(outb);
                        free(gotb);
                        fputs("unisacc: error: unterminated comment\n", stderr);
                        return 1;
                    }
                    if (pr == 3) {
                        free(outb);
                        free(gotb);
                        fprintf(stderr, "unisacc: error: %s\n", why3);
                        return 1;
                    }
                    if (pr) {
                        free(outb);
                        free(gotb);
                        return us_fail("preprocess failed");
                    }
                    free(gotb);
                    gotb = (unsigned char *)outb;
                    ppn = outn;
                }
                didpp = 1;
            }
        }
        printf("route=%s\n", route);
        printf("obj=%d\n", obj);
    }
    printf("out=%s\n", shown ? shown : "-");
    printf("src=%s\n", src ? src : "-");
    printf("target=%s\n", opts.target ? opts.target : "-");
    printf("mode=%d\n", opts.mode);
    printf("runit=%d\n", opts.runit);
    printf("bytes=%ld\n", gotn);
    if (didpp) {
        printf("pp=%d\n", ppn);
        if (ppn > 0 && fwrite(gotb, 1, (size_t)ppn, stdout) != (size_t)ppn) {
            free(gotb);
            return 1;
        }
    }
    free(gotb);
    return 0;
}
