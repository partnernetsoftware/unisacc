/* hs_out_* split out of src/host.cx (C44-SIZE-01); same bootstrap layer, libc as there. */
#pragma unisa module hostout
void hs_why(char *why, int cap, const char *msg);

static int hs_pump(int fd, const unsigned char *bytes, long length) {
    long done;
    done = 0;
    while (done < length) {
        long wrote;
        wrote = (long)write(fd, bytes + done, (size_t)(length - done));
        if (wrote < 0 && errno == EINTR) continue;
        if (wrote <= 0 || wrote > length - done) return -1;
        done = done + wrote;
    }
    return 0;
}

static int hs_out_arg(const unsigned char *data, long length, char *why, int cap) {
    if (length < 0 || (length > 0 && !data)) { hs_why(why, cap, "bad output argument"); return 5; }
    return 0;
}

static int hs_out_fd(int fd, const unsigned char *data, long length,
                     char *why, int cap) {
    int bad;
    bad = hs_out_arg(data, length, why, cap);
    if (bad) return bad;
    if (hs_pump(fd, data, length)) {
        hs_why(why, cap, "short output write");
        return 2;
    }
    hs_why(why, cap, 0);
    return 0;
}

static int hs_out_direct(const char *path, const unsigned char *data,
                         long length, char *why, int cap) {
    int fd;
    int bad;
    bad = hs_out_arg(data, length, why, cap);
    if (bad) return bad;
    fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0755);
    if (fd < 0) { hs_why(why, cap, "cannot open output"); return 1; }
    if (hs_pump(fd, data, length)) {
        close(fd);
        hs_why(why, cap, "short output write");
        return 2;
    }
    if (close(fd) < 0) { hs_why(why, cap, "cannot close output"); return 3; }
    hs_why(why, cap, 0);
    return 0;
}

static int hs_out_commit(const char *path, const unsigned char *data,
                         long length, char *why, int cap) {
    char *tmp;
    const char *slash;
    long plen;
    int directory;
    int attempt;
    int fd;
    int n;
    int bad;
    int sy_open_new(const char *, int);
    bad = hs_out_arg(data, length, why, cap);
    if (bad) return bad;
    plen = 0;
    while (path[plen]) plen = plen + 1;
    tmp = malloc((size_t)plen + 80);
    if (!tmp) { hs_why(why, cap, "cannot open output"); return 1; }
    slash = strrchr(path, '/');
    directory = slash ? (int)(slash - path + 1) : 0;
    fd = -1;
    attempt = 0;
    while (attempt < 100) {
        n = snprintf(tmp, (size_t)plen + 80, "%.*s.unisacc-%ld-%d.tmp",
                     directory, path, (long)getpid(), attempt);
        if (n < 0 || n >= plen + 80) goto openfail;
        fd = sy_open_new(tmp, 0755);
        if (fd >= 0) break;
        if (fd != -EEXIST) goto openfail;
        attempt = attempt + 1;
    }
    if (fd < 0) goto openfail;
    if (hs_pump(fd, data, length)) { close(fd); goto writefail; }
    if (close(fd) < 0) goto closefail;
    if (rename(tmp, path)) goto commitfail;
    free(tmp);
    hs_why(why, cap, 0);
    return 0;
openfail:
    free(tmp);
    hs_why(why, cap, "cannot open output");
    return 1;
writefail:
    unlink(tmp);
    free(tmp);
    hs_why(why, cap, "short output write");
    return 2;
closefail:
    unlink(tmp);
    free(tmp);
    hs_why(why, cap, "cannot close output");
    return 3;
commitfail:
    unlink(tmp);
    free(tmp);
    hs_why(why, cap, "cannot commit output");
    return 4;
}

int hs_write_out(const char *path, const unsigned char *data, long length,
                 char *why, int cap) {
    int sy_is_reg(const char *);
    int ordinary;
    int rc;
    if (!path || (path[0] == '-' && path[1] == 0)) return hs_out_fd(1, data, length, why, cap);
    if (!path[0]) { hs_why(why, cap, "cannot open output"); return 1; }
    rc = sy_is_reg(path);
    if (rc < 0 && rc != -ENOENT) { hs_why(why, cap, "cannot open output"); return 1; }
    ordinary = rc == 1 || rc == -ENOENT;
    if (!ordinary) return hs_out_direct(path, data, length, why, cap);
    return hs_out_commit(path, data, length, why, cap);
}
