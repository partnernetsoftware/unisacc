/* `unisacc stream STAGE` (lnx/x86_64 M1 entry): delegates body to cx/driver/drivestream_m1_impl.cx
   so src/ stays within tests/srcshape.tsv while leaving src/drivestream.cx untouched for the other 5 targets. */
#pragma unisa module drivestream_m1
#pragma unisa use driver.drivestream_m1_impl
#pragma unisa use stages
#pragma unisa use driveutil
#pragma unisa use host
extern int pm_open(const unsigned char *, long, char *, int), pm_close(void);
extern int ex_ri_arm(const char *, int, const unsigned char *, long), ex_touch(void), bd_touch(void);

int dv_stream(int argc, char **argv) {
    DsM1Ops ops = {
        st_touch, st_attr_reset, st_extra_reset, st_dirs, st_extra_put,
        st_attr_exchange, st_span, hs_container, hs_read, dv_cx,
        pm_open, pm_close, ex_ri_arm, ex_touch, bd_touch
    };
    return ds_m1_entry(argc, argv, &ops);
}
