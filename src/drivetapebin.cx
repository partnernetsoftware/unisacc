/* Tapebin validation and text-tape exchange. drive.cx calls dv_tapebin_check
   when a source ends in .tapebin. The tapegate checks (tb2_*) and the path
   classifiers (cxp_tapebin_*) are separate objects; this module only joins
   them into the check the driver used to run inline. On success the caller's
   byte buffer is swapped for the decoded text tape and *as_tape is set.
   Failure 2 means incomplete framing; 1 retains the format/origin sentence. */
#pragma unisa module drivetapebin

#pragma unisa use compiler.tapegate
#pragma unisa use driver.path

static int dv_tapebin_sha_bad(const unsigned char *b, long n) {
    unsigned char dig[32];
    int i;
    if (!b || n < 136) return 1;
    cx_sha256(b + 64, (size_t)(n - 64), dig);
    i = 0;
    while (i < 32) {
        if (dig[i] != b[28 + i]) return 1;
        i = i + 1;
    }
    return 0;
}

int dv_tapebin_check(const char *src, const char *tgt,
                     unsigned char **gotb, long *gotn, int *as_tape) {
    int origin, magic, k, minor, nsec, aligned, end, i, bad, textn;
    int soff[4], slen[4], scnt[4];
    long long roff, rlen, rcnt;
    const char *mag;
    char *text;
    if (!cxp_tapebin_path(src)) return 0;
    origin = cxp_tapebin_target(tgt);
    if (*gotn <= 33554432L && (*gotn < 136 || !tb2_origin(*gotb, (int)*gotn, origin, 0)) &&
        tb2_carrier(*gotb, (int)*gotn) == 2) {
        free(*gotb); return 2;
    }
    mag = "UTAPEBIN";
    magic = *gotn >= 136 && *gotb != 0;
    k = 0;
    while (magic && k < 8) {
        if ((*gotb)[k] != mag[k]) magic = 0;
        k = k + 1;
    }
    minor = 0;
    nsec = 0;
    bad = 0;
    text = 0;
    textn = 0;
    /* magic, fixed fields, section count, origin, digest, then every directory
       row. Records that fail also use the product sentence. Text that passes
       replaces the bytes and follows the tape route. */
    if (!origin || !magic || *gotn > 33554432L) bad = 1;
    else if (tb2_magic(*gotb, (int)*gotn) || tb2_fixed(*gotb, (int)*gotn, &minor) ||
             tb2_nsec(*gotb, (int)*gotn, &nsec) ||
             tb2_origin(*gotb, (int)*gotn, origin, 0) ||
             dv_tapebin_sha_bad(*gotb, *gotn)) bad = 1;
    else {
        end = 64 + 24 * nsec;
        i = 0;
        while (i < nsec && !bad) {
            aligned = tb2_align(end);
            roff = -1;
            rlen = -1;
            rcnt = -1;
            if (aligned < 0 || tb2_row(*gotb, (int)*gotn, i, aligned, &roff, &rlen, &rcnt) ||
                rcnt < 0 || rcnt > *gotn || roff > 2147483647LL || rlen > 2147483647LL ||
                tb2_zeros(*gotb, (int)*gotn, end, (int)roff)) bad = 1;
            else {
                soff[i] = (int)roff;
                slen[i] = (int)rlen;
                scnt[i] = (int)rcnt;
                end = (int)roff + (int)rlen;
            }
            i = i + 1;
        }
        if (!bad && (i != nsec || tb2_extra(nsec, nsec == 4 ? rlen : 0, nsec == 4 ? rcnt : 0))) bad = 1;
        if (!bad && tb2_end(end, (int)*gotn)) bad = 2;
        if (!bad) bad = tb2_text(*gotb, (int)*gotn, minor, soff, slen, scnt, &text, &textn);
    }
    if (bad) {
        free(text);
        free(*gotb);
        return bad == 2 ? 2 : 1;
    }
    free(*gotb);
    *gotb = (unsigned char *)text;
    *gotn = textn;
    *as_tape = 1;
    return 0;
}
