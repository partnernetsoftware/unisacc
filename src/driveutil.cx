/* Shared helpers for drive.cx and driveunits.cx (no use cycle). */
#pragma unisa module driveutil
#pragma unisa use text.text
#pragma unisa use runtime.holdframe
#pragma unisa use sys.fs
static int dv_sb(const char *b, long k) {
    long i = (k >= 3 && (b[0] & 255) == 239 && (b[1] & 255) == 187 && (b[2] & 255) == 191) ? 3 : 0;
    if (i + 5 >= k || b[i] != '#' || b[i + 1] != '!') return 0;
    for (i += 2; i + 3 < k && b[i] != '\n'; i++)
        if (b[i] == '-' && b[i + 1] == 'r' && b[i + 2] == 'u' && b[i + 3] == 'n') return 1;
    return 0;
}
int dv_cx(const char *s) {
    char b[512]; int n = 0, fd; long k;
    while (s && s[n]) n++;
    if (n >= 3 && s[n - 3] == '.' && s[n - 2] == 'c' && s[n - 1] == 'x') return 1;
    if (!s || (n >= 2 && s[n - 2] == '.' && (s[n - 1] == 'c' || s[n - 1] == 'h' || s[n - 1] == 's' || s[n - 1] == 'S' || s[n - 1] == 'o' || s[n - 1] == 'a'))) return 0;
    fd = sy_open_read(s); k = fd < 0 ? 0 : sy_read_once(fd, b, 512);
    return (fd >= 0 ? (sy_close(fd), 0) : 0) + dv_sb(b, k);
}
int dv_len(const char *s) { int n = 0; while (s && s[n]) n++; return n; }
void dv_why(char *why, int cap, const char *s) { long n = (!why || cap <= 0) ? -1 : tx_len(s, (long)cap); if (why && cap > 0 && (n < 0 || tx_copy(why, (long)cap, s, n))) why[0] = 0; }
void dv_hold_drop(void) { hf_drop(); }
