/* Shared helpers for drive.cx and driveunits.cx (no use cycle). */
#pragma unisa module driveutil
#pragma unisa use text.text
#pragma unisa use runtime.holdframe
int dv_cx(const char *s) {
    int n;
    if (!s) return 0;
    n = 0;
    while (s[n]) n = n + 1;
    if (n >= 3 && s[n - 3] == '.' && s[n - 2] == 'c' && s[n - 1] == 'x') return 1;
    return 0;
}
int dv_len(const char *s) {
    int n;
    n = 0;
    if (!s) return 0;
    while (s[n]) n = n + 1;
    return n;
}
void dv_why(char *why, int cap, const char *s) {
    long n;
    if (!why || cap <= 0) return;
    n = tx_len(s, (long)cap);
    if (n < 0 || tx_copy(why, (long)cap, s, n)) why[0] = 0;
}
void dv_hold_drop(void) { hf_drop(); }
