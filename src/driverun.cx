/* -run memory-image exec + forward exec. dv_store_exec/dv_bind_args/dv_memory
   exported; dv_join private. process slots passed in; mem slots private. */
#pragma unisa module driverun

#pragma unisa use host
#pragma unisa use runcache
#pragma unisa use stages
#pragma unisa use sys.env
#pragma unisa use runtime.memlayout
#pragma unisa use driveutil

static unsigned char dv_text_b[8];
static unsigned char dv_res_b[8];
static unsigned char dv_dl_b[4][8];
static const char *dv_dl_key[4] = {
    "\0process/dl/0", "\0process/dl/1", "\0process/dl/2", "\0process/dl/3"
};

static int dv_join(char *dst, int cap, const char *a, const char *b) {
    int i;
    int j;
    if (!dst || cap <= 0 || !a || !b) return 1;
    i = 0;
    while (a[i]) {
        if (i + 1 >= cap) return 1;
        dst[i] = a[i];
        i = i + 1;
    }
    j = 0;
    while (b[j]) {
        if (i + 1 >= cap) return 1;
        dst[i] = b[j];
        i = i + 1;
        j = j + 1;
    }
    dst[i] = 0;
    return 0;
}

int dv_bind_args(int argc, char **argv, int argstart, const char *src,
                 unsigned char *argc_b, unsigned char *argv_b, char ***runargs_out) {
    int count;
    int envn;
    int j;
    char **v;
    char **env;
    count = 1 + argc - argstart;
    if (!src || count < 1) return 1;
    env = sy_env_vec();
    envn = 0;
    if (env) while (env[envn]) envn = envn + 1;
    v = malloc((size_t)(count + envn + 2) * sizeof(char *));
    if (!v) return 1;
    v[0] = (char *)src;
    j = argstart;
    while (j < argc) {
        v[j - argstart + 1] = argv[j];
        j = j + 1;
    }
    v[count] = 0;
    j = 0;
    while (j < envn) {
        v[count + 1 + j] = env[j];
        j = j + 1;
    }
    v[count + 1 + envn] = 0;
    free(*runargs_out);
    *runargs_out = v;
    if (hs_le64(argc_b, (unsigned long long)count)) return 1;
    if (hs_le64(argv_b, (unsigned long long)(uintptr_t)v)) return 1;
    return 0;
}

int dv_memory(const char *tgt, const char *src, int cx,
              unsigned char *lower, long lowern,
              unsigned char *base, long reserved,
              char *why, int cap, int *code) {
    char mroute[96];
    unsigned char *image;
    long imagen;
    long long dataoff;
    long long size;
    int text;
    int extent;
    int stored;
    int entry;
    int pr;
    int i;
    if (!code) return 4;
    *code = 0;
    if (dv_join(mroute, 96, tgt, "/memory")) {
        free(lower);
        return 1;
    }
    if (hs_le64(dv_text_b, (unsigned long long)(uintptr_t)base) ||
        hs_le64(dv_res_b, (unsigned long long)reserved)) {
        free(lower);
        return 1;
    }
    if (st_extra_put("\0memory/text", 12, dv_text_b, 8) ||
        st_extra_put("\0memory/reserve", 15, dv_res_b, 8)) {
        free(lower);
        return 1;
    }
    i = 0;
    while (i < 4) {
        hs_dl_le(i, dv_dl_b[i]); /* unreachable on the object route: see dv_memory's callers */
        if (st_extra_put(dv_dl_key[i], 13, dv_dl_b[i], 8)) { free(lower); return 1; }
        i = i + 1;
    }
    image = 0;
    imagen = 0;
    pr = st_span(mroute, tgt, src, cx, 0, 0, 0, lower, lowern, &image, &imagen, why, cap);
    if (pr) return pr;
    if (!image || imagen < 0 || imagen > 2147483647L) {
        free(image);
        return 1;
    }
    pr = mem_image(image, (int)imagen, &text, &extent, &stored, &entry);
    if (pr) {
        free(image);
        if (pr == 3) {
            if (why && cap > 0) {
                const char *m;
                m = "memory image extent too large";
                i = 0;
                while (m[i] && i + 1 < cap) { why[i] = m[i]; i = i + 1; }
                why[i] = 0;
            }
        } else if (pr == 2) {
            if (why && cap > 0) {
                const char *m;
                m = "bad memory image bounds";
                i = 0;
                while (m[i] && i + 1 < cap) { why[i] = m[i]; i = i + 1; }
                why[i] = 0;
            }
        }
        return 1;
    }
    mem_place(text, extent, &dataoff, &size);
    if (!mem_span_ok(size) || size > reserved || dataoff < 0 || dataoff > 2147483647LL || size > 2147483647LL) {
        free(image);
        return 1;
    }
    if (hs_commit(base, (long)size)) {
        free(image);
        return 1;
    }
    if (hs_copy_image(base, (long)dataoff, image, text, stored)) {
        free(image);
        return 1;
    }
    free(image);
    if (hs_protect_code(base, (long)dataoff)) return 1;
    *code = hs_enter(base, entry);
    return 0;
}

/* Store a forward ELF, then exec it with this run's argv. The bytes are the
   image from after the process slots were popped, so they do not carry argv. */
int dv_store_exec(const unsigned char *body, long bodyn, char **args) {
    if (body && bodyn >= 4 && body[0] == 127 && body[1] == 'E' && body[2] == 'L' && body[3] == 'F')
        (void)rc_store_elf(body, bodyn);
    return hs_forward_exec(body, bodyn, args);
}
