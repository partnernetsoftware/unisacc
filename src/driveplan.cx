/* -cx-plan / -cx-interface and the .cx use-closure expand. drive.cx calls
   dv_cx_flags and dv_expand after the argument walk. srcv is the drive's
   source vector (dv_srcv) passed in; dv_expand rewrites it in place via the
   pointer. forced/forced_n are the drive's -D/-U include list, read-only.
   No Cxc* layout is named here (C44-DRIVE-TYPES-01). */
#pragma unisa module driveplan

#pragma unisa use compiler.cxmod
#pragma unisa use host
#pragma unisa use runtime.runexec

static int dv_cxm_open(void) {
    char td[512];
    if (hs_cxm_tmpdir(td, 512)) {
        fputs("unisacc: model driver: tmpdir\n", stderr);
        return 1;
    }
    if (cxm_bind(hs_cxm_rd, hs_cxm_wr, hs_cxm_say, hs_cxm_sha, td)) {
        fputs("unisacc: model driver: modules\n", stderr);
        return 1;
    }
    return 0;
}

/* -cx-interface prints one module and returns. -cx-plan prints the unit
   list and returns. Other commands return -1 so the compile walk continues. */
int dv_cx_flags(int nsrc, const char **srcv, const unsigned char *forced, long forced_n) {
    char *paths[64];
    int i;
    if (!cxm_wants_interface() && !cxm_wants_plan()) return -1;
    if (nsrc < 1 || ex_ri_finish()) return nsrc < 1 ? 1 : 2;
    if (dv_cxm_open()) return 1;
    if (cxm_wants_interface()) return cxm_interface((char *)srcv[0]);
    cxm_set_on(0);
    i = 0;
    while (i < nsrc) {
        paths[i] = (char *)srcv[i];
        i = i + 1;
    }
    if (cxm_plan(paths, nsrc)) return 1;
    {
        char *incv[32];
        int ninc;
        long at;
        ninc = 0;
        at = 0;
        while (at < forced_n) {
            if (ninc >= 32) return 1;
            incv[ninc] = (char *)(forced + at);
            ninc = ninc + 1;
            while (at < forced_n && forced[at]) at = at + 1;
            if (at >= forced_n) return 1;
            at = at + 1;
        }
        return cxm_planprint(incv, ninc);
    }
}

/* One .cx on the command line: cxm_plan appends its use closure.
   The paths stay in srcv. CXIF includes are published per unit later. */
int dv_expand(int *nsrc, const char **srcv, int funit) {
    char *paths[64];
    int i;
    int any;
    int n;
    if (!nsrc || *nsrc < 1) return 1;
    any = 0;
    i = 0;
    while (i < *nsrc) {
        if (cxm_iscxpath((char *)srcv[i])) any = 1;
        i = i + 1;
    }
    if (!any) return 0;
    if (dv_cxm_open()) return 1;
    cxm_set_on(0); cxm_set_funit(funit);
    i = 0;
    while (i < *nsrc) {
        paths[i] = (char *)srcv[i];
        i = i + 1;
    }
    if (cxm_plan(paths, *nsrc)) return 1;
    n = cxm_count();
    if (n < 1 || n > 64) {
        fputs("unisacc: model driver: modules\n", stderr);
        return 1;
    }
    i = 0;
    while (i < n) {
        srcv[i] = cxm_unit_path(i);
        i = i + 1;
    }
    *nsrc = n;
    return 0;
}
