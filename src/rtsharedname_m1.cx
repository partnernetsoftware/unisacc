#pragma unisa module rtsharedname_m1
#pragma unisa use driver.m25_m1_impl
/* lnx/x86_64 S3 authoritative wrapper for m25.o (compiler.rtsharedname).
 * Delegates all 7 exports to cx/driver/m25_m1_impl.cx (TapeUnitSpec / m25.tapeslice),
 * leaving cx/compiler/rtsharedname.cx byte-unchanged for the other 5 targets. */
int rts_count(void) { return m25_m1_rts_count(); }
int rts_at(int i, const char **group, const char **probe, int *provider,
           const char **unit_macro, const char **extern_macro) {
    return m25_m1_rts_at(i, group, probe, provider, unit_macro, extern_macro);
}
int rts_symbol_count(int i) { return m25_m1_rts_symbol_count(i); }
int rts_covers(int i, const char *name) { return m25_m1_rts_covers(i, name); }
const char *rts_used_name(int i, int m) { return m25_m1_rts_used_name(i, m); }
int rts_used_count(int i) { return m25_m1_rts_used_count(i); }
int rts_used(int i, const char *name) { return m25_m1_rts_used(i, name); }
