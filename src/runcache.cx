#pragma unisa module runcache
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.sha
#pragma unisa use runtime.rcident
#pragma unisa use runtime.modelcache
#pragma unisa use runtime.unitcache
#pragma unisa use mem.bytes
#pragma unisa use compiler.cxmod
#pragma unisa use driver.nnext
/* Cross-process reuse of a -run frontend tape (USE33) and of the forward ELF
   (USE34, file <key>.host). The key binds the candidate file (entry plus the
   attached P3), the route, and the sources. Arguments after "--" are not part of the key.
   \0process/argc and \0process/argv are 8-byte pointers to this process.
   drive pushes them before the stages. The forward ELF is built only after
   those two resources are popped, and hs_forward_exec supplies the argv of
   this run. The e3 tape is replayed through the later stages, which bind the
   pointers again. Neither cache entry is the tape dv_run_lower returns while
   those resources are still published.
   Direct libc stays out of this file: cx_read, cx_write, cx_sha256_hex, tx_*,
   sy_stat / sy_lstat (follow vs not), sy_env, sy_uid, sy_cwd.
   A block of 4 KiB or more is hashed by rk_hex with sy_sha256_hex (kernel AF_ALG).
   A non-zero return falls back to cx_sha256_hex. Smaller blocks stay on cx_sha256_hex. */
static int rc_on;
static int rc_armed;
static int rc_broken;
static char rc_prod[65];
static char rc_src[65];
static char rc_srcraw[65];   /* digest of the source argv spellings (verbatim, NUL separated); -c object route */
static char rc_raw[65];
static int rc_pin;
static char rc_target[96];
static int rc_level;
static int rc_mode;
static int rc_nsrc;
static char **rc_have;
static int rc_nh;
static char **rc_miss;
static int rc_nm;

static void *rc_alloc(long n) {
    void *hs_alloc(long);
    return hs_alloc(n);
}

static void rc_release(void *p) {
    void hs_free(void *);
    hs_free(p);
}

static int rc_cat(char *dst, int cap, int *at, const char *s) {
    long tx_len(const char *, long);
    int tx_copy(char *, long, const char *, long);
    long n;
    if (!dst || !at || !s || *at < 0 || *at >= cap) return 1;
    n = tx_len(s, 4096);
    if (n < 0) return 1;
    if (tx_copy(dst + *at, (long)(cap - *at), s, n)) return 1;
    *at = *at + (int)n;
    return 0;
}

static int rc_cat_u(char *dst, int cap, int *at, unsigned long long v) {
    char rev[24];
    char tmp[24];
    int r;
    int i;
    r = 0;
    if (v == 0) rev[r++] = '0';
    while (v) {
        rev[r++] = (char)('0' + (int)(v % 10));
        v = v / 10;
    }
    i = 0;
    while (r) tmp[i++] = rev[--r];
    tmp[i] = 0;
    return rc_cat(dst, cap, at, tmp);
}

static int rc_say(const char *s) {
    long tx_len(const char *, long);
    int hs_cxm_say(int, char *, int);
    long n;
    n = tx_len(s, 4000);
    if (n < 0) return 1;
    return hs_cxm_say(2, (char *)s, (int)n);
}

static int rc_debug(void) {
    const char *sy_env(const char *);
    const char *e;
    e = sy_env("UNISACC_RR_DEBUG");
    return e && e[0] ? 1 : 0;
}

static int rc_time_on(void) {
    const char *sy_env(const char *);
    const char *e;
    e = sy_env("UNISACC_RR_TIME");
    return e && e[0] ? 1 : 0;
}

static void rc_report(int hit, long long ns) {
    char line[160];
    int at;
    if (!rc_time_on()) return;
    at = 0;
    if (rc_cat(line, 160, &at, "RR_TIME\tlookup_hit=")) return;
    if (rc_cat_u(line, 160, &at, (unsigned long long)hit)) return;
    if (rc_cat(line, 160, &at, "\tns=")) return;
    if (rc_cat_u(line, 160, &at, ns < 0 ? 0 : (unsigned long long)ns)) return;
    if (rc_cat(line, 160, &at, "\n")) return;
    rc_say(line);
}

static void rc_dbg_path(const char *tag, const char *path) {
    char line[4200];
    int at;
    if (!rc_debug() || !tag || !path) return;
    at = 0;
    if (rc_cat(line, 4200, &at, tag)) return;
    if (rc_cat(line, 4200, &at, "\t")) return;
    if (rc_cat(line, 4200, &at, path)) return;
    if (rc_cat(line, 4200, &at, "\n")) return;
    rc_say(line);
}

static void rc_drop(char **list, int n) {
    int i;
    if (!list) return;
    i = 0;
    while (i < n) {
        rc_release(list[i]);
        i = i + 1;
    }
    rc_release(list);
}

static int rc_has(char **list, int n, const char *path) {
    int tx_eq(const char *, const char *, long);
    int i;
    i = 0;
    while (i < n) {
        if (tx_eq(list[i], path, 4096)) return 1;
        i = i + 1;
    }
    return 0;
}

static int rc_push(char ***list, int *n, const char *path) {
    long tx_len(const char *, long);
    int tx_copy(char *, long, const char *, long);
    char **next;
    char *copy;
    long ln;
    int i;
    if (*n >= 4096) return 1;
    ln = tx_len(path, 4096);
    if (ln < 0) return 1;
    copy = rc_alloc(ln + 1);
    if (!copy) return 1;
    if (tx_copy(copy, ln + 1, path, ln)) {
        rc_release(copy);
        return 1;
    }
    next = rc_alloc((long)(*n + 1) * (long)sizeof(char *));
    if (!next) {
        rc_release(copy);
        return 1;
    }
    i = 0;
    while (i < *n) {
        next[i] = (*list)[i];
        i = i + 1;
    }
    next[*n] = copy;
    rc_release(*list);
    *list = next;
    *n = *n + 1;
    return 0;
}

static void rc_on_file(const char *path, int present) {
    if (!rc_armed || rc_broken || !path || !path[0]) return;
    if (present) {
        if (rc_has(rc_have, rc_nh, path)) return;
        if (rc_push(&rc_have, &rc_nh, path)) rc_broken = 1;
        return;
    }
    if (rc_has(rc_have, rc_nh, path) || rc_has(rc_miss, rc_nm, path)) return;
    if (rc_push(&rc_miss, &rc_nm, path)) rc_broken = 1;
}

static int rc_app(unsigned char **b, long *n, long *cap, const void *p, long k) {
    int tx_copy(char *, long, const char *, long);
    unsigned char *nb;
    long c;
    long i;
    if (k < 0) return 1;
    if (*n > 2147483647L - k - 1) return 1;
    if (*n + k + 1 > *cap) {
        c = *cap > 0 ? *cap : 256;
        while (c < *n + k + 1) {
            if (c > 1073741824L) return 1;
            c = c * 2;
        }
        nb = rc_alloc(c);
        if (!nb) return 1;
        i = 0;
        while (i < *n) {
            nb[i] = (*b)[i];
            i = i + 1;
        }
        rc_release(*b);
        *b = nb;
        *cap = c;
    }
    if (k == 0) return 0;
    if (tx_copy((char *)(*b + *n), k + 1, (const char *)p, k)) return 1;
    *n = *n + k;
    return 0;
}

static int rc_off(void) {
    const char *sy_env(const char *);
    int tx_eq(const char *, const char *, long);
    const char *e;
    e = sy_env("UNISACC_RUN_CACHE");
    return e && tx_eq(e, "0", 8) ? 1 : 0;
}


static int rc_route(char *dst, int cap, int elf) {
    int at;
    at = 0;
    if (rc_cat(dst, cap, &at, rc_target)) return 1;
    if (rc_nsrc > 1) {
        if (rc_cat(dst, cap, &at, elf ? "/multi/fwdexec/O" : "/multi/run/O")) return 1;
    } else if (rc_cat(dst, cap, &at, elf ? "/image/O" : "/run/O")) return 1;
    if (rc_cat_u(dst, cap, &at, (unsigned long long)rc_mode)) return 1;
    if (rc_cat_u(dst, cap, &at, (unsigned long long)rc_level)) return 1;
    return 0;
}

/* X1 (cx/runtime/rcident.cx rk_*): pin 0 is the root-independent key, pin 1 the key of an entry naming __FILE__ */
static int rc_key(char key[65], const char *route, int pin) {
    char blob[768];
    int at;
    at = 0;
    /* 0.0.99: the -c object route (rc_mode==5) also binds the source argv spelling (srcraw), because the
     * object embeds that spelling (relative source -> 'x.cx', absolute -> '/dir/x.cx') and a key without
     * it makes a second directory reuse the first directory's object with the wrong embedded path. -run
     * and -o executable stay root-independent (X1). ver=14 for the new key.
     * Escape hatch: UNISACC_RUN_CACHE_KEY_OLD=1 reverts ONLY the key layout (ver 14 -> 13, drops the
     * srcraw line) for one release, to localize a red. Both layouts use the
     * versioned source and dependency path-pinning rule. */
    {
        const char *old = sy_env("UNISACC_RUN_CACHE_KEY_OLD");
        int legacy = (old && old[0] && old[0] != '0');
        int bindraw = (!legacy && rc_mode == 5 && pin == 0 && rc_srcraw[0]);
        if (rc_cat(blob, 768, &at, legacy ? "USE33\nver=13\nmode=" : "USE33\nver=14\nmode=") || rc_cat(blob, 768, &at, rc_prod) ||
            rc_cat_u(blob, 768, &at, (unsigned long long)rc_mode) || rc_cat(blob, 768, &at, "\npkg=") || rc_cat(blob, 768, &at, rc_prod) ||
            rc_cat(blob, 768, &at, "\nroute=") || rc_cat(blob, 768, &at, route) ||
            rc_cat(blob, 768, &at, "\ntarget=") || rc_cat(blob, 768, &at, rc_target) ||
            rc_cat(blob, 768, &at, "\nlevel=") || rc_cat_u(blob, 768, &at, (unsigned long long)rc_level) ||
            rc_cat(blob, 768, &at, pin ? "\npin=1\nsrc=" : "\npin=0\nsrc=") || rc_cat(blob, 768, &at, pin ? rc_raw : rc_src)) return 1;
        if (bindraw && (rc_cat(blob, 768, &at, "\nsrcraw=") || rc_cat(blob, 768, &at, rc_srcraw))) return 1;
        if (rc_cat(blob, 768, &at, "\n")) return 1;
    }
    cx_sha256_hex(blob, (size_t)at, key);
    return 0;
}

static int rc_join(char *dst, int cap, const char *dir, const char *key, int host) {
    int at;
    at = 0;
    if (rc_cat(dst, cap, &at, dir)) return 1;
    if (rc_cat(dst, cap, &at, "/")) return 1;
    if (rc_cat(dst, cap, &at, key)) return 1;
    if (host && rc_cat(dst, cap, &at, ".host")) return 1;
    return 0;
}

static void rc_put32(unsigned char *p, unsigned v) {
    p[0] = (unsigned char)(v & 255u);
    p[1] = (unsigned char)((v >> 8) & 255u);
    p[2] = (unsigned char)((v >> 16) & 255u);
    p[3] = (unsigned char)((v >> 24) & 255u);
}

static void rc_put64(unsigned char *p, unsigned long long v) {
    int i;
    i = 0;
    while (i < 8) {
        p[i] = (unsigned char)(v & 255ull);
        v = v >> 8;
        i = i + 1;
    }
}

static unsigned rc_get32(const unsigned char *p) {
    return (unsigned)p[0] | ((unsigned)p[1] << 8) | ((unsigned)p[2] << 16) | ((unsigned)p[3] << 24);
}

static int rc_still_absent(const char *path) {
    int sy_stat(const char *, sy_stat_t *);
    sy_stat_t st;
    int rc;
    /* Follow links. Only ENOENT is still absent. ENOTDIR and EACCES invalidate. */
    rc = sy_stat(path, &st);
    if (rc == 0) return 0;
    return rc == -ENOENT;
}

static int rc_atomic(const char *dir, const char *final_path, const unsigned char *data, long n) {
    int mc_cache_lock(const char *);
    int mc_cache_publish(const char *, const char *, const char *, int);
    int sy_close(int);
    int sy_unlink(const char *);
    int hs_pid(void);
    long long hs_ns(void);
    char tmp[700];
    int at;
    int lockfd;
    long long ns;
    int pid;
    at = 0;
    if (rc_cat(tmp, 700, &at, final_path)) return 1;
    if (rc_cat(tmp, 700, &at, ".")) return 1;
    pid = hs_pid();
    if (pid < 0) pid = 0;
    if (rc_cat_u(tmp, 700, &at, (unsigned long long)pid)) return 1;
    if (rc_cat(tmp, 700, &at, ".")) return 1;
    ns = hs_ns();
    if (ns < 0) ns = 0;
    if (rc_cat_u(tmp, 700, &at, (unsigned long long)ns)) return 1;
    if (rc_cat(tmp, 700, &at, ".tmp")) return 1;
    lockfd = mc_cache_lock(dir);
    if (lockfd < 0) return 1;
    if (cx_write(tmp, data, (size_t)n)) {
        sy_unlink(tmp);
        sy_close(lockfd);
        return 1;
    }
    if (mc_cache_publish(dir, tmp, final_path, lockfd)) {
        sy_unlink(tmp);
        return 1;
    }
    return 0;
}

static int rc_store_kind(int elf, const unsigned char *tape, long tn) {
    int mc_cache_dir(char *, int);
    int sy_stat(const char *, sy_stat_t *);
    long tx_len(const char *, long);
    char dir[400];
    char route[160];
    char key[65];
    char path[560];
    char hex[65];
    unsigned char *payload;
    long at;
    long cap;
    unsigned i;
    unsigned hn;
    unsigned abn;
    int pin;
    if (!rc_on || rc_broken || !cxn_cache_allowed() || !tape || tn < 0 || tn > (1L << 26)) return 1;
    hn = (unsigned)rc_nh;
    abn = (unsigned)rc_nm;
    if (mc_cache_dir(dir, 400)) return 1;
    if (rc_route(route, 160, elf)) return 1;
    pin = rk_pinned(rc_have, rc_nh, rc_pin);
    if (pin < 0 || rc_key(key, route, pin)) return 1;
    if (rc_join(path, 560, dir, key, elf)) return 1;
    payload = 0;
    at = 0;
    cap = 0;
    if (rc_app(&payload, &at, &cap, elf ? "USE34\n\0\0" : "USE33\n\0\0", 8)) goto bad;
    {
        unsigned char le[16];
        rc_put32(le, (unsigned)tn);
        rc_put32(le + 4, 0);
        rc_put32(le + 8, hn);
        rc_put32(le + 12, abn);
        if (rc_app(&payload, &at, &cap, le, 16)) goto bad;
    }
    if (rk_hex(tape, tn, hex)) goto bad;
    if (rc_app(&payload, &at, &cap, hex, 64)) goto bad;
    i = 0;
    while (i < hn) {
        sy_stat_t st;
        unsigned char meta[16];
        unsigned char lb[2];
        long pl;
        char one[65];
        const char *rp;
        rp = pin ? rc_have[i] : rk_norm(rc_have[i]);
        pl = tx_len(rp, 4096);
        if (pl <= 0 || pl > 4096) goto bad;
        if (sy_stat(rc_have[i], &st) || st.kind != 'f' || rk_file(rc_have[i], one, 0)) goto bad;
        lb[0] = (unsigned char)(pl & 255);
        lb[1] = (unsigned char)((pl >> 8) & 255);
        rc_put64(meta, (unsigned long long)st.size);
        rc_put64(meta + 8, (unsigned long long)st.mtime);
        if (rc_app(&payload, &at, &cap, lb, 2) || rc_app(&payload, &at, &cap, rp, pl) ||
            rc_app(&payload, &at, &cap, meta, 16) || rc_app(&payload, &at, &cap, one, 64))
            goto bad;
        if (rc_debug()) rc_dbg_path("RR_PRESENT", rc_have[i]);
        i = i + 1;
    }
    i = 0;
    while (i < abn) {
        unsigned char lb[2];
        long pl;
        const char *rp;
        rp = pin ? rc_miss[i] : rk_norm(rc_miss[i]);
        pl = tx_len(rp, 4096);
        if (pl <= 0 || pl > 4096) goto bad;
        lb[0] = (unsigned char)(pl & 255);
        lb[1] = (unsigned char)((pl >> 8) & 255);
        if (rc_app(&payload, &at, &cap, lb, 2) || rc_app(&payload, &at, &cap, rp, pl)) goto bad;
        if (rc_debug()) rc_dbg_path("RR_ABSENT", rc_miss[i]);
        i = i + 1;
    }
    if (tn && rc_app(&payload, &at, &cap, tape, tn)) goto bad;
    if (rc_atomic(dir, path, payload, at)) goto bad;
    rc_release(payload);
    return 0;
bad:
    rc_release(payload);
    return 1;
}

/* Try one pin key: 1 with TAPE/TN set on a verified hit, 0 on any miss.
   Both the unpinned and pinned keys are tried by the caller, so a file whose pin flipped
   (e.g. a header gained __FILE__) does not leave the unit permanently cold behind a stale
   entry of the other pin: the stale entry fails its receipt check and the other key is read. */
static int rc_try(int elf, const char *dir, const char *route, int pin, unsigned char **tapeout, long *tnout) {
    int sy_lstat(const char *, sy_stat_t *);
    int tx_same(const char *, long, const char *, long);
    char key[65];
    char path[560];
    char hex[65];
    char got[65];
    unsigned char *file;
    unsigned char *tape;
    sy_stat_t st;
    size_t fn;
    long n;
    long at;
    unsigned tn;
    unsigned an;
    unsigned hn;
    unsigned abn;
    unsigned i;
    const char *magic;
    if (rc_key(key, route, pin) || rc_join(path, 560, dir, key, elf)) return 0;
    if (sy_lstat(path, &st) || st.kind != 'f' || st.size < 88 || st.size > (1L << 26)) return 0;
    file = (unsigned char *)cx_read(path, &fn);
    if (!file) return 0;
    magic = elf ? "USE34\n\0\0" : "USE33\n\0\0";
    n = (long)fn;
    if (n < 88 || !tx_same((const char *)file, 8, magic, 8)) goto miss;
    tn = rc_get32(file + 8);
    an = rc_get32(file + 12);
    hn = rc_get32(file + 16);
    abn = rc_get32(file + 20);
    if (tn > (1u << 26) || an > (1u << 26) || hn > 65536u || abn > 65536u) goto miss;
    at = 24;
    if (at + 64 > n) goto miss;
    i = 0;
    while (i < 64) {
        got[i] = (char)file[at + i];
        i = i + 1;
    }
    got[64] = 0;
    at = at + 64;
    i = 0;
    while (i < hn) {
        unsigned pl;
        char pp[4097];
        char cur[65];
        int tx_copy(char *, long, const char *, long);
        if (at + 2 > n) goto miss;
        pl = (unsigned)file[at] | ((unsigned)file[at + 1] << 8);
        at = at + 2;
        if (!pl || pl > 4096 || at + (long)pl + 16 + 64 > n) goto miss;
        if (tx_copy(pp, 4097, (const char *)(file + at), (long)pl)) goto miss;
        at = at + (long)pl + 16;
        if (rk_file(pp, cur, 0) || !tx_same(cur, 64, (const char *)(file + at), 64)) {
            if (rc_debug()) rc_dbg_path("RR_MISS\tpresent", pp);
            goto miss;
        }
        at = at + 64;
        i = i + 1;
    }
    i = 0;
    while (i < abn) {
        unsigned pl;
        char pp[4097];
        int tx_copy(char *, long, const char *, long);
        if (at + 2 > n) goto miss;
        pl = (unsigned)file[at] | ((unsigned)file[at + 1] << 8);
        at = at + 2;
        if (!pl || pl > 4096 || at + (long)pl > n) goto miss;
        if (tx_copy(pp, 4097, (const char *)(file + at), (long)pl)) goto miss;
        at = at + (long)pl;
        if (!rc_still_absent(pp)) {
            if (rc_debug()) rc_dbg_path("RR_MISS\tabsent", pp);
            goto miss;
        }
        i = i + 1;
    }
    if (n - at != (long)tn + (long)an) goto miss;
    if (rk_hex(file + at, (long)tn, hex)) goto miss;
    if (!tx_same(hex, 64, got, 64)) goto miss;
    tape = rc_alloc(tn ? (long)tn : 1);
    if (!tape) goto miss;
    mm_copy(tape, (long)tn, file + at, (long)tn);
    rc_release(file);
    *tapeout = tape;
    *tnout = (long)tn;
    mc_cache_touch(dir, path);
    return 1;
miss:
    rc_release(file);
    return 0;
}

static int rc_lookup_kind(int elf, unsigned char **out, long *outn) {
    long long hs_ns(void);
    char dir[400];
    char route[160];
    unsigned char *tape;
    long tn;
    long long t0;
    long long t1;
    int pin;
    if (out) *out = 0;
    if (outn) *outn = 0;
    if (!rc_on || !cxn_cache_allowed() || !out || !outn) return 0;
    t0 = hs_ns();
    if (mc_cache_dir(dir, 400) || rc_route(route, 160, elf)) { t1 = hs_ns(); rc_report(0, t1 - t0); return 0; }
    pin = 0;
    while (pin < 2) {
        tape = 0;
        tn = 0;
        if (rc_try(elf, dir, route, pin, &tape, &tn)) {
            *out = tape;
            *outn = tn;
            t1 = hs_ns();
            rc_report(elf ? 2 : 1, t1 - t0);
            return 1;
        }
        pin = pin + 1;
    }
    t1 = hs_ns();
    rc_report(0, t1 - t0);
    return 0;
}

int rc_open(const char *product, int argc, char **argv, const char **sources, int nsrc,
            const char *target, int level, int warnings, int tape, int deps, int mode) {
    int tx_eq(const char *, const char *, long);
    int tx_copy(char *, long, const char *, long);
    long tx_len(const char *, long);
    long n;
    rc_drop(rc_have, rc_nh);
    rc_drop(rc_miss, rc_nm);
    rc_have = 0;
    rc_nh = 0;
    rc_miss = 0;
    rc_nm = 0;
    rc_on = 0;
    rc_armed = 0;
    rc_broken = 0;
    rc_prod[0] = 0;
    rc_src[0] = 0;
    rc_srcraw[0] = 0;
    rc_raw[0] = 0;
    rc_pin = 0;
    /* Resource-flow capture rewrites a ledger on every build, and --strict-resource-flow
       replays it; a cache hit would skip both, so capture disables the cache entirely. */
    if ((rc_off() && rc_time_on() && (rc_report(0, 1), 1)) || rc_off() || tape || deps) return 0;
    if (!cxn_cache_allowed() || uc_open(product, target) || warnings) return 0; /* uc_open: 1 when resource flow is pinned; the unit cache may stay on under warnings */
    if (nsrc < 1 || nsrc > DV_MAXU || level < 0 || !product || !target || !sources) return 0;
    if (!tx_eq(target, "lnx/x86_64", 32)) return 0;
    n = tx_len(target, 96);
    if (n < 0 || tx_copy(rc_target, 96, target, n)) return 0;
    rc_level = level;
    rc_mode = mode;
    rc_nsrc = nsrc;
    if (rk_prod(product, rc_prod)) return 0;
    if (rk_open() || rk_sources2(argc, argv, sources, nsrc, rc_prod, rc_src, rc_raw, &rc_pin)) return 0;
    /* rc_srcraw: digest of the source argv spellings verbatim (NUL separated), for the -c object key.
       Only the strings dv_srcv holds are used, so no file is read; a relative 'x.cx' and an absolute
       '/d/x.cx' differ, which is what the embedded .unisa.tape records. */
    {
        unsigned char *rb = 0; long rn = 0, rcap = 0, sj;
        int anyn = 0;
        for (sj = 0; sj < nsrc; sj++) {
            long sl;
            if (!sources[sj]) { anyn = -1; break; }
            sl = tx_len(sources[sj], 4096);
            if (sl < 0 || rc_app(&rb, &rn, &rcap, sources[sj], sl + 1)) { anyn = -1; break; }
        }
        if (anyn == 0 && rn > 0) (void)rk_hex(rb, rn, rc_srcraw);
        rc_release(rb);
    }
    rc_on = 1;
    if (rc_debug()) {
        char line[180];
        int at;
        at = 0;
        if (rc_cat(line, 180, &at, "RR_PROD\t") == 0 && rc_cat(line, 180, &at, rc_prod) == 0 &&
            rc_cat(line, 180, &at, "\n") == 0)
            rc_say(line);
    }
    return 1;
}

int rc_arm(void) {
    if (!rc_on) return 0;
    rc_armed = 1;
    return uc_note_set(rc_on_file);
}

int rc_lookup_elf(unsigned char **b, long *n) {
    return rc_lookup_kind(1, b, n);
}

int rc_lookup_e3(unsigned char **b, long *n) {
    return rc_lookup_kind(0, b, n);
}

int rc_store_elf(const unsigned char *b, long n) {
    return rc_store_kind(1, b, n);
}

int rc_store_e3(const unsigned char *b, long n) {
    return rc_store_kind(0, b, n);
}
