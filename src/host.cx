#pragma unisa module host
#pragma unisa use sys.mem
#pragma unisa use sys.dl
/* Host file and clock. time.h is not in the prelude (edition 2).
   Exclusive create and nonblocking read go through sys.fs (sy_open_new,
   sy_open_read). The executable path goes through sy_self_path. Replacing
   an output asks sy_is_reg instead of lstat. Each is declared at the call:
   drive.o already contains those bodies via runcache, and a second use
   would define sy_fstat twice.
   mmap and the loader symbols are sys.mem and sys.dl.
   hs_ns includes time.h and calls its static clock_gettime. A local extern
   declaration was forwarded to the host; on win that pointer was wrapped
   with __unisa_ccw_of and lowering rejected the wrapper. The header already
   reads the monotonic clock per target (Win32 performance counter, Linux
   syscall, macOS gettimeofday) and is not exported from this module.
   core_host_panic and core_host_fetch are the execution core's host hooks.
   Drive-supplied CLI resources win, then package resources (predefines and
   \0hdr/), then cwd-relative \0inc/q/ and \0inc/a/ files.
   The package path is UNISA_CONTAINER when that is set. Otherwise it is the
   entry executable if that file carries a UNIPKG1 trailer, else unisacc.com
   beside that executable (/proc/self/exe). It does not use the working directory. */
#include <time.h>

static void hs_why(char *why, int cap, const char *msg) {
    int i;
    if (!why || cap <= 0) return;
    i = 0;
    if (msg) while (msg[i] && i + 1 < cap) { why[i] = msg[i]; i = i + 1; }
    why[i] = 0;
}

static int hs_copy(char *dst, int cap, const char *src) {
    int i;
    if (!dst || cap <= 0 || !src) return 1;
    i = 0;
    while (src[i] && i + 1 < cap) { dst[i] = src[i]; i = i + 1; }
    if (src[i]) { dst[0] = 0; return 1; }
    dst[i] = 0;
    return 0;
}

static void hs_miss(char *why, int cap, const char *path) {
    const char *head;
    const char *tail;
    int i;
    int j;
    int room;
    int tlen;
    head = "no package at ";
    tail = "; set UNISA_CONTAINER=/path/to/unisacc.com";
    if (!why || cap <= 0) return;
    i = 0;
    while (head[i] && i + 1 < cap) { why[i] = head[i]; i = i + 1; }
    tlen = 0;
    while (tail[tlen]) tlen = tlen + 1;
    room = cap - 1 - i;
    if (tlen >= room) {
        i = 0;
        while (tail[i] && i + 1 < cap) { why[i] = tail[i]; i = i + 1; }
        why[i] = 0;
        return;
    }
    room = room - tlen;
    j = 0;
    if (path) while (path[j] && j < room) { why[i] = path[j]; i = i + 1; j = j + 1; }
    j = 0;
    while (tail[j]) { why[i] = tail[j]; i = i + 1; j = j + 1; }
    why[i] = 0;
}

static int hs_trailer(const char *path) {
    FILE *f;
    unsigned char foot[16];
    if (!path || !path[0]) return 0;
    f = fopen(path, "rb");
    if (!f) return 0;
    if (fseek(f, -16, SEEK_END) || fread(foot, 1, 16, f) != 16) { fclose(f); return 0; }
    fclose(f);
    return foot[0] == 'U' && foot[1] == 'N' && foot[2] == 'I' && foot[3] == 'P' &&
           foot[4] == 'K' && foot[5] == 'G' && foot[6] == '1' && foot[7] == '\n';
}

static int hs_self(char *dst, int cap, const char *argv0) {
    int sy_self_path(char *, int);
    int n;
    if (!dst || cap < 2) return 1;
    n = sy_self_path(dst, cap);
    if (n > 0) return 0;
    if (argv0 && argv0[0] == '/') return hs_copy(dst, cap, argv0);
    dst[0] = 0;
    return 1;
}

static int hs_beside(char *dst, int cap, const char *exe) {
    const char *name;
    int i;
    int slash;
    int n;
    name = "unisacc.com";
    if (!dst || cap < 2 || !exe || !exe[0]) return 1;
    slash = -1;
    i = 0;
    while (exe[i]) {
        if (exe[i] == '/') slash = i;
        i = i + 1;
    }
    if (slash < 0) return 1;
    n = slash + 1;
    if (n + 12 >= cap) return 1;
    i = 0;
    while (i < n) { dst[i] = exe[i]; i = i + 1; }
    i = 0;
    while (name[i]) { dst[n + i] = name[i]; i = i + 1; }
    dst[n + i] = 0;
    if (!strcmp(dst, exe)) return 1;
    return 0;
}

int hs_container(char *dst, int cap, const char *argv0, char *why, int wcap) {
    const char *env;
    char self[512];
    char side[512];
    if (!dst || cap <= 0) return 4;
    dst[0] = 0;
    env = getenv("UNISA_CONTAINER");
    if (env && env[0]) {
        if (hs_copy(dst, cap, env)) {
            hs_why(why, wcap, "UNISA_CONTAINER path does not fit; set UNISA_CONTAINER=/path/to/unisacc.com");
            return 1;
        }
        return 0;
    }
    if (hs_self(self, 512, argv0)) {
        hs_miss(why, wcap, 0);
        return 1;
    }
    if (hs_trailer(self)) {
        if (hs_copy(dst, cap, self)) {
            hs_miss(why, wcap, self);
            return 1;
        }
        return 0;
    }
    if (hs_beside(side, 512, self) == 0 && hs_trailer(side)) {
        if (hs_copy(dst, cap, side)) {
            hs_miss(why, wcap, side);
            return 1;
        }
        return 0;
    }
    hs_miss(why, wcap, self);
    return 1;
}

int hs_read(const char *path, unsigned char **out, long *n, char *why, int cap) {
    FILE *f;
    unsigned char *b;
    unsigned char *nb;
    long len;
    long room;
    long nroom;
    size_t got;
    if (!path || !out || !n) return 4;
    *out = 0;
    *n = 0;
    f = fopen(path, "rb");
    if (!f) { hs_why(why, cap, "cannot open"); return 1; }
    b = 0;
    len = 0;
    room = 0;
    for (;;) {
        if (len == room) {
            if (room > 1073741824L) {
                free(b); fclose(f); hs_why(why, cap, "file too large"); return 1;
            }
            nroom = room ? room * 2 : 4096;
            nb = realloc(b, (size_t)nroom);
            if (!nb) {
                free(b); fclose(f); hs_why(why, cap, "out of memory"); return 1;
            }
            b = nb;
            room = nroom;
        }
        got = fread(b + len, 1, (size_t)(room - len), f);
        len = len + (long)got;
        if (got == 0) break;
    }
    if (ferror(f)) {
        free(b); fclose(f); hs_why(why, cap, "cannot read"); return 1;
    }
    if (fclose(f)) { free(b); hs_why(why, cap, "cannot close"); return 1; }
    *out = b;
    *n = len;
    hs_why(why, cap, 0);
    return 0;
}

static int hs_pump(int fd, const unsigned char *bytes, long length) {
    long done;
    done = 0;
    while (done < length) {
        long wrote;
        wrote = (long)write(fd, bytes + done, (size_t)(length - done));
        if (wrote < 0 && errno == EINTR) continue;
        if (wrote <= 0 || wrote > length - done) return -1;
        done = done + wrote;
    }
    return 0;
}

static int hs_out_arg(const unsigned char *data, long length, char *why, int cap) {
    if (length < 0 || (length > 0 && !data)) {
        hs_why(why, cap, "bad output argument");
        return 5;
    }
    return 0;
}

static int hs_out_fd(int fd, const unsigned char *data, long length, char *why, int cap) {
    int bad;
    bad = hs_out_arg(data, length, why, cap);
    if (bad) return bad;
    if (hs_pump(fd, data, length)) {
        hs_why(why, cap, "short output write");
        return 2;
    }
    hs_why(why, cap, 0);
    return 0;
}

static int hs_out_direct(const char *path, const unsigned char *data, long length, char *why, int cap) {
    int fd;
    int bad;
    bad = hs_out_arg(data, length, why, cap);
    if (bad) return bad;
    fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0755);
    if (fd < 0) { hs_why(why, cap, "cannot open output"); return 1; }
    if (hs_pump(fd, data, length)) {
        close(fd);
        hs_why(why, cap, "short output write");
        return 2;
    }
    if (close(fd) < 0) { hs_why(why, cap, "cannot close output"); return 3; }
    hs_why(why, cap, 0);
    return 0;
}

static int hs_out_commit(const char *path, const unsigned char *data, long length, char *why, int cap) {
    char *tmp;
    const char *slash;
    long plen;
    int directory;
    int attempt;
    int fd;
    int n;
    int bad;
    int sy_open_new(const char *, int);
    bad = hs_out_arg(data, length, why, cap);
    if (bad) return bad;
    plen = 0;
    while (path[plen]) plen = plen + 1;
    tmp = malloc((size_t)plen + 80);
    if (!tmp) { hs_why(why, cap, "cannot open output"); return 1; }
    slash = strrchr(path, '/');
    directory = slash ? (int)(slash - path + 1) : 0;
    fd = -1;
    attempt = 0;
    while (attempt < 100) {
        n = snprintf(tmp, (size_t)plen + 80, "%.*s.unisacc-%ld-%d.tmp", directory, path, (long)getpid(), attempt);
        if (n < 0 || n >= plen + 80) {
            free(tmp);
            hs_why(why, cap, "cannot open output");
            return 1;
        }
        fd = sy_open_new(tmp, 0755);
        if (fd >= 0) break;
        if (fd != -EEXIST) {
            free(tmp);
            hs_why(why, cap, "cannot open output");
            return 1;
        }
        attempt = attempt + 1;
    }
    if (fd < 0) {
        free(tmp);
        hs_why(why, cap, "cannot open output");
        return 1;
    }
    if (hs_pump(fd, data, length)) {
        close(fd);
        unlink(tmp);
        free(tmp);
        hs_why(why, cap, "short output write");
        return 2;
    }
    if (close(fd) < 0) {
        unlink(tmp);
        free(tmp);
        hs_why(why, cap, "cannot close output");
        return 3;
    }
    if (rename(tmp, path)) {
        unlink(tmp);
        free(tmp);
        hs_why(why, cap, "cannot commit output");
        return 4;
    }
    free(tmp);
    hs_why(why, cap, 0);
    return 0;
}

int hs_write_out(const char *path, const unsigned char *data, long length, char *why, int cap) {
    int sy_is_reg(const char *);
    int ordinary;
    int rc;
    if (!path || (path[0] == '-' && path[1] == 0)) return hs_out_fd(1, data, length, why, cap);
    if (!path[0]) { hs_why(why, cap, "cannot open output"); return 1; }
    rc = sy_is_reg(path);
    if (rc < 0 && rc != -ENOENT) { hs_why(why, cap, "cannot open output"); return 1; }
    ordinary = rc == 1 || rc == -ENOENT;
    if (!ordinary) return hs_out_direct(path, data, length, why, cap);
    return hs_out_commit(path, data, length, why, cap);
}

/* Upper layers call these instead of malloc and free. */
void *hs_alloc(long n) {
    if (n <= 0 || n > 2147483647L) return 0;
    return malloc((size_t)n);
}

void hs_free(void *p) {
    free(p);
}

int hs_pid(void) {
    return (int)getpid();
}

long long hs_ns(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts)) return -1;
    return (long long)ts.tv_sec * 1000000000LL + (long long)ts.tv_nsec;
}

void core_host_panic(const char *reason) {
    fputs(reason ? reason : "panic", stderr);
    fputc('\n', stderr);
    exit(1);
}

struct hs_slot { const unsigned char *key; int n; const unsigned char *b; int len; };
static struct hs_slot hs_tab[24];
static int hs_ntab;
/* Set while a run-cache compile wants include receipts. NULL the rest of the time.
   present is 1 after a full read, 0 when the open failed with ENOENT only. */
static void (*hs_file_note)(const char *path, int present);

int hs_file_note_set(void (*fn)(const char *, int)) {
    hs_file_note = fn;
    return 0;
}

int hs_cli_reset(void) {
    hs_ntab = 0;
    return 0;
}

int hs_cli_put(const unsigned char *key, int n, const unsigned char *b, int len) {
    if (!key || n <= 0 || len < 0 || (len > 0 && !b)) return 4;
    if (hs_ntab >= 24) return 1;
    hs_tab[hs_ntab].key = key;
    hs_tab[hs_ntab].n = n;
    hs_tab[hs_ntab].b = b;
    hs_tab[hs_ntab].len = len;
    hs_ntab = hs_ntab + 1;
    return 0;
}

static int hs_cli(const unsigned char *key, int n, unsigned char **bytes, int *len) {
    int i;
    int k;
    i = 0;
    while (i < hs_ntab) {
        if (hs_tab[i].n == n) {
            k = 0;
            while (k < n && hs_tab[i].key[k] == key[k]) k = k + 1;
            if (k == n) {
                *bytes = (unsigned char *)hs_tab[i].b;
                *len = hs_tab[i].len;
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

static int hs_file(const unsigned char *p, int n, unsigned char **bytes, int *len) {
    char path[4096];
    unsigned char *b;
    unsigned char *nb;
    long room;
    long nroom;
    long gotn;
    size_t got;
    FILE *f;
    int i;
    if (n < 0 || n >= 4096) return 0;
    i = 0;
    while (i < n) {
        if (p[i] == 0) return 0;
        path[i] = (char)p[i];
        i = i + 1;
    }
    path[n] = 0;
    f = fopen(path, "rb");
    if (!f) {
        if (errno == ENOENT) {
            if (hs_file_note) hs_file_note(path, 0);
            return 0;
        }
        core_host_panic("cannot open input");
    }
    b = 0;
    gotn = 0;
    room = 0;
    for (;;) {
        if (gotn == room) {
            if (room > 1073741824L) {
                free(b);
                fclose(f);
                core_host_panic("file too large");
            }
            nroom = room ? room * 2 : 4096;
            nb = realloc(b, (size_t)nroom);
            if (!nb) {
                free(b);
                fclose(f);
                core_host_panic("out of memory");
            }
            b = nb;
            room = nroom;
        }
        got = fread(b + gotn, 1, (size_t)(room - gotn), f);
        gotn = gotn + (long)got;
        if (got == 0) break;
    }
    if (ferror(f)) {
        free(b);
        fclose(f);
        core_host_panic("cannot read input");
    }
    if (fclose(f)) {
        free(b);
        core_host_panic("cannot close input");
    }
    if (gotn > 2147483647L) {
        free(b);
        core_host_panic("file too large");
    }
    *bytes = b ? b : (unsigned char *)realloc(0, 1);
    if (!*bytes) core_host_panic("out of memory");
    *len = (int)gotn;
    if (hs_file_note) hs_file_note(path, 1);
    return 2;
}

int core_host_fetch(const unsigned char *key, int n, unsigned char **bytes, int *len) {
    const unsigned char *pb;
    int pl;
    int pr;
    extern int pm_res(const unsigned char *, int, const unsigned char **, int *);
    if (n < 0 || (n > 0 && !key) || !bytes || !len)
        core_host_panic("INTERFACE_ERROR resource-fetch-bad-arguments");
    *bytes = 0;
    *len = 0;
    if (!key || n == 0) return 0;
    if (hs_cli(key, n, bytes, len)) return 1;
    pb = 0;
    pl = 0;
    pr = pm_res(key, n, &pb, &pl);
    if (pr == 0) {
        *bytes = (unsigned char *)pb;
        *len = pl;
        return 1;
    }
    if (n >= 7 && key[0] == 0 && key[1] == 'i' && key[2] == 'n' && key[3] == 'c' &&
        key[4] == '/' && (key[5] == 'q' || key[5] == 'a') && key[6] == '/')
        return hs_file(key + 7, n - 7, bytes, len);
    return 0;
}

int hs_le64(unsigned char *dst, unsigned long long v) {
    int i;
    if (!dst) return 4;
    i = 0;
    while (i < 8) {
        dst[i] = (unsigned char)(v & 255ull);
        v = v >> 8;
        i = i + 1;
    }
    return 0;
}

int hs_dl_le(int slot, unsigned char *dst) {
    unsigned long long v;
    if (!dst || sy_dl_addr(slot, &v)) return 4;
    return hs_le64(dst, v);
}

int hs_reserve(unsigned char **base, long *reserved) {
    void *p;
    long n;
    if (!base || !reserved) return 4;
    *base = 0;
    *reserved = 0;
    n = 2147467264L;
    if (sy_map_none(&p, n)) return 1;
    *base = (unsigned char *)p;
    *reserved = n;
    return 0;
}

int hs_release(unsigned char *base, long reserved) {
    if (!base || reserved < 0) return 4;
    if (sy_unmap(base, reserved)) return 1;
    return 0;
}

int hs_commit(unsigned char *base, long size) {
    if (!base || size < 0) return 4;
    if (sy_protect_rw(base, size)) return 1;
    return 0;
}

int hs_copy_image(unsigned char *base, long dataoff, const unsigned char *bytes, long text, long stored) {
    if (!base || !bytes || dataoff < 0 || text < 0 || stored < 0) return 4;
    { void *cx_kept = memcpy(base, bytes + 40, (size_t)text); (void)cx_kept; }
    if (stored) { void *cx_kept = memcpy(base + dataoff, bytes + 40 + text, (size_t)stored); (void)cx_kept; }
    return 0;
}

int hs_protect_code(unsigned char *base, long dataoff) {
    if (!base || dataoff < 0) return 4;
    if (sy_protect_rx(base, dataoff)) return 1;
    return 0;
}

int hs_enter(unsigned char *base, int entryoff) {
    int (*entry)(long, long);
    if (!base || entryoff < 0) return 1;
    entry = (int (*)(long, long))(base + entryoff);
    return entry(0, 0);
}

/* A static Linux image has no host loader in this process. A -run that
   forwards to the host C library is the dynamic ELF the image route writes.
   memfd + execveat(AT_EMPTY_PATH) replaces this process. There is no
   on-disk fallback and no return into hs_enter. Numbers match hostnative:
   x86_64 memfd 319, execveat 322, close 3, write 1. */
#if defined(__aarch64__)
#define HS_MEMFD 279L
#define HS_EXECVEAT 281L
#define HS_CLOSE 57L
#define HS_WRITE 64L
#define HS_LOADER "/lib/ld-linux-aarch64.so.1"
#else
#define HS_MEMFD 319L
#define HS_EXECVEAT 322L
#define HS_CLOSE 3L
#define HS_WRITE 1L
#define HS_LOADER "/lib64/ld-linux-x86-64.so.2"
#endif

/* Win has no memfd/execveat. The generic `.sys syscall` op is not lowered
   there, so this helper returns -1 and hs_forward_exec reports that. */
static long hs_fx(long nr, long a, long b, long c, long d, long e) {
#if defined(_WIN32)
    (void)nr; (void)a; (void)b; (void)c; (void)d; (void)e;
    return -1;
#else
    return __syscall6(nr, a, b, c, d, e);
#endif
}

int hs_forward_exec(const unsigned char *image, long n, char **argv) {
    char **envp;
    long fd;
    long wrote;
    long err;
    long done;
    int noloader;
    if (!image || n < 0 || !argv) return 1;
    envp = argv;
    while (*envp) envp = envp + 1;
    envp = envp + 1;
    fflush(stdout);
    fflush(stderr);
    noloader = 0;
    fd = hs_fx(HS_MEMFD, (long)"unisacc-run", 1 | 16, 0, 0, 0);
    if (fd == -22) fd = hs_fx(HS_MEMFD, (long)"unisacc-run", 1, 0, 0, 0);
    if (fd >= 0) {
        done = 0;
        err = 0;
        while (done < n) {
            wrote = hs_fx(HS_WRITE, fd, (long)(image + done), n - done, 0, 0);
            if (wrote == -4) continue;
            if (wrote <= 0) {
                err = -5;
                break;
            }
            done = done + wrote;
        }
        if (!err) err = hs_fx(HS_EXECVEAT, fd, (long)"", (long)argv, (long)envp, 0x1000L);
        noloader = err == -2;
        hs_fx(HS_CLOSE, fd, 0, 0, 0, 0);
    } else err = fd;
    if (noloader) {
        fprintf(stderr, "unisacc: model driver: this program calls the host C library, and running it needs the host's dynamic loader %s, which could not be opened here (as on a system without glibc); write the program with -o and run it where glibc is installed\n", HS_LOADER);
        return 1;
    }
    fprintf(stderr, "unisacc: model driver: this program calls the host C library, and its image could not be started from an anonymous memory file (errno %ld); write the program with -o and run that\n", (long)(-err));
    return 1;
}

/* cxmod's injected file callbacks. rd: byte count, -1 only for ENOENT,
   -2 when the buffer fills, -3 for any other open/read/close failure.
   wr replaces the destination by rename so a reader never sees a prefix. */
int hs_cxm_rd(char *path, char *buf, int cap) {
    int fd;
    int n;
    int bad;
    struct stat st;
    ssize_t z;
    int sy_open_read(const char *);
    if (!path || !buf || cap <= 0) return -3;
    fd = sy_open_read(path);
    if (fd < 0) return fd == -ENOENT ? -1 : -3;
    if (fstat(fd, &st) || !S_ISREG(st.st_mode)) {
        close(fd);
        return -3;
    }
    n = 0;
    bad = 0;
    while (n < cap) {
        z = read(fd, buf + n, (size_t)(cap - n));
        if (z < 0 && errno == EINTR) continue;
        if (z < 0) { bad = 1; break; }
        if (z == 0) break;
        n = n + (int)z;
    }
    if (close(fd)) bad = 1;
    if (bad) return -3;
    if (n >= cap) return -2;
    return n;
}

int hs_cxm_wr(char *path, char *buf, int n) {
    char tmp[544];
    int fd;
    int at;
    int k;
    ssize_t z;
    if (!path || (n > 0 && !buf) || n < 0) return 1;
    k = snprintf(tmp, sizeof tmp, "%s.%d", path, (int)getpid());
    if (k < 0 || (size_t)k >= sizeof tmp) return 1;
    fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd < 0) return 1;
    at = 0;
    while (at < n) {
        z = write(fd, buf + at, (size_t)(n - at));
        if (z < 0 && errno == EINTR) continue;
        if (z <= 0) {
            close(fd);
            unlink(tmp);
            return 1;
        }
        at = at + (int)z;
    }
    if (close(fd)) {
        unlink(tmp);
        return 1;
    }
    if (rename(tmp, path)) {
        unlink(tmp);
        return 1;
    }
    return 0;
}

int hs_cxm_say(int fd, char *s, int n) {
    FILE *out;
    if (!s || n < 0) return 1;
    out = fd == 1 ? stdout : stderr;
    if (n && fwrite(s, 1, (size_t)n, out) != (size_t)n) return 1;
    return 0;
}

void hs_cxm_sha(char *p, int n, char *hex) {
    if (!hex) return;
    cx_sha256_hex(p, n > 0 ? (size_t)n : 0, hex);
}

int hs_cxm_tmpdir(char *dst, int cap) {
    const char *td;
    int i;
    if (!dst || cap <= 1) return 1;
    td = getenv("TMPDIR");
    if (!td || !td[0]) td = getenv("TEMP");
    if (!td || !td[0]) td = "/tmp";
    i = 0;
    while (td[i] && i + 1 < cap) {
        dst[i] = td[i];
        i = i + 1;
    }
    if (td[i]) return 1;
    dst[i] = 0;
    return 0;
}
