#pragma unisa module executor
#pragma unisa use core.execute
/* CxModel matches cx/runtime/model_lifetime.cx. CxDecode matches model_decode.cx.
   CxCodecCrc matches cx/runtime/codec.cx. Those bodies are other objects. */
typedef struct UnisaModel {
    int loaded;
    int ns,nq,nrg,nstr,start,isnet,topmax,nqa;
    char **str; int *strl; int *qoff,*qlen; int64_t *qa;
    int *smode,*rowc,**rowk,**rown,**rowq; int *nlo,*nhi,*bn,*bq,*rets; unsigned char **retok;
} CxModel;
typedef struct CxDecode {
    CxModel model;
    void *(*allocate)(void *, size_t);
    void (*release)(void *);
    const char *why;
} CxDecode;
typedef struct { uint32_t table[4][256]; } CxCodecCrc;
typedef struct CxCoreStack CxCoreStack;
typedef struct CxCoreFrames CxCoreFrames;
typedef struct CxSparse CxSparse;
typedef struct CxBlobs CxBlobs;
typedef struct CxResources CxResources;
/* Host hooks are defined in host.cx. Image and memory bind stay in bind.cx.
   -E runs the e2 model and returns its output bytes. */
int ex_touch(void) {
    char dig[32];
    long long next;
    const char *why;
    int z;
    int64_t core_alu32(int, int64_t, int64_t);
    int64_t core_alu64(int, int64_t, int64_t, int *);
    int core_run_take(int);
    int core_run_budget(long long, long long, long long *, const char **);
    int core_decimal(char *, int64_t);
    void core_stack_push(CxCoreStack *, int);
    void core_frame_pop(CxCoreFrames *);
    int64_t core_memory_get(const CxSparse *, int64_t);
    void core_memory_set(CxSparse *, int64_t, int64_t);
    int core_blob_add(CxBlobs *, const unsigned char *, int);
    int core_resource_find(CxResources *, CxBlobs *, const unsigned char *, int);
    if (core_alu32(0, 1, 2) != 3) return 1;
    if (core_alu64(0, 1, 2, &z) != 3 || z) return 1;
    if (core_run_take(0) != 1) return 1;
    if (core_run_budget(0, 1, &next, &why)) return 1;
    if (core_decimal(dig, 0) != 1 || dig[0] != '0') return 1;
    (void)core_stack_push;
    (void)core_frame_pop;
    (void)core_memory_get;
    (void)core_memory_set;
    (void)core_blob_add;
    (void)core_resource_find;
    return 0;
}

static void ex_why(char *why, int cap, const char *msg) {
    int i;
    if (!why || cap <= 0) return;
    i = 0;
    if (msg) while (msg[i] && i + 1 < cap) { why[i] = msg[i]; i = i + 1; }
    why[i] = 0;
}
static void *ex_alloc(void *p, size_t n) { return realloc(p, n ? n : 1); }
static void ex_drop(void *p) { free(p); }

static void ex_model(CoreModel *m, CxModel *src) {
    memset(m, 0, sizeof *m);
    m->ns = src->ns;
    m->nq = src->nq;
    m->nrg = src->nrg;
    m->start = src->start;
    m->isnet = src->isnet;
    m->str = src->str;
    m->strl = src->strl;
    m->qoff = src->qoff;
    m->qlen = src->qlen;
    m->qa = src->qa;
    m->mode = src->smode;
    m->count = src->rowc;
    m->keys = src->rowk;
    m->next = src->rown;
    m->seq = src->rowq;
    m->lo = src->nlo;
    m->hi = src->nhi;
    m->base_next = src->bn;
    m->base_seq = src->bq;
    m->ret_seq = src->rets;
    m->ret_ok = src->retok;
}

int ex_pp(const unsigned char *comp, long n, int raw, unsigned crc, int compressed,
          unsigned char *input, int inputn, const char *src,
          unsigned char **outb, long *outn, char *why, int cap) {
    unsigned char *rawb;
    int own;
    CxDecode dec;
    CxCodecCrc ctx;
    CoreModel model;
    CoreResult result;
    uint32_t got;
    int st;
    int cxcodec_inflate(unsigned char *, unsigned long, const unsigned char *, unsigned long);
    int cxcodec_crc_init(CxCodecCrc *);
    int cxcodec_crc(CxCodecCrc *, const char *, int, uint32_t *);
    int cxmd_decode(CxDecode *, const unsigned char *, long);
    void cxml_release(CxModel *, void (*)(void *));
    if (!outb || !outn || n < 0 || raw <= 0 || inputn < 0 || (n > 0 && !comp) || (inputn > 0 && !input)) {
        ex_why(why, cap, "bad argument");
        return 4;
    }
    *outb = 0;
    *outn = 0;
    if (raw > 1073741824 || n > 1073741824L) {
        ex_why(why, cap, "model too large");
        return 1;
    }
    own = 0;
    rawb = 0;
    if (compressed) {
        rawb = malloc((size_t)raw);
        if (!rawb) { ex_why(why, cap, "out of memory"); return 1; }
        own = 1;
        if (cxcodec_inflate(rawb, (unsigned long)raw, comp, (unsigned long)n)) {
            free(rawb);
            ex_why(why, cap, "inflate");
            return 1;
        }
        if (cxcodec_crc_init(&ctx) || cxcodec_crc(&ctx, (const char *)rawb, raw, &got) || got != (uint32_t)crc) {
            free(rawb);
            ex_why(why, cap, "model crc");
            return 1;
        }
    } else {
        rawb = (unsigned char *)comp;
    }
    memset(&dec, 0, sizeof dec);
    dec.allocate = ex_alloc;
    dec.release = ex_drop;
    if (cxmd_decode(&dec, rawb, raw)) {
        ex_why(why, cap, dec.why ? dec.why : "invalid model input");
        cxml_release(&dec.model, ex_drop);
        if (own) free(rawb);
        return 1;
    }
    if (own) free(rawb);
    ex_model(&model, &dec.model);
    memset(&result, 0, sizeof result);
    st = core_run(&model, input, inputn, src ? src : "", 400000000000LL, &result);
    if (st) {
        int lim;
        int i;
        char msg[160];
        lim = 0;
        if (result.reason) {
            if (result.reason_n > 0) lim = result.reason_n;
            else while (result.reason[lim] && lim < 120) lim = lim + 1;
        }
        if (lim > 120) lim = 120;
        i = 0;
        while (i < lim) { msg[i] = result.reason[i]; i = i + 1; }
        msg[i] = 0;
        cxml_release(&dec.model, ex_drop);
        if (result.err.b) free(result.err.b);
        free(result.out.b);
        ex_why(why, cap, msg[0] ? msg : "e2");
        return st;
    }
    cxml_release(&dec.model, ex_drop);
    if (result.err.b) free(result.err.b);
    *outb = result.out.b;
    *outn = result.out.n;
    ex_why(why, cap, 0);
    return 0;
}

static CxDecode ex_dec;
static CoreModel ex_core;
static int ex_held;

int ex_inflate(unsigned char *out, unsigned long outlen,
               const unsigned char *in, unsigned long inlen) {
    int cxcodec_inflate(unsigned char *, unsigned long, const unsigned char *, unsigned long);
    return cxcodec_inflate(out, outlen, in, inlen);
}

unsigned ex_crc32(char *p, int n) {
    CxCodecCrc ctx;
    uint32_t got;
    int cxcodec_crc_init(CxCodecCrc *);
    int cxcodec_crc(CxCodecCrc *, const char *, int, uint32_t *);
    if (!p || n < 0) return 0;
    if (cxcodec_crc_init(&ctx) || cxcodec_crc(&ctx, p, n, &got)) return 0;
    return got;
}

void ex_unload(void) {
    void cxml_release(CxModel *, void (*)(void *));
    if (!ex_held) return;
    cxml_release(&ex_dec.model, ex_drop);
    ex_held = 0;
}

int ex_load(const unsigned char *raw, int n, char *why, int cap) {
    int cxmd_decode(CxDecode *, const unsigned char *, long);
    void cxml_release(CxModel *, void (*)(void *));
    if (ex_held) ex_unload();
    if (!raw || n <= 0) {
        ex_why(why, cap, "bad argument");
        return 4;
    }
    memset(&ex_dec, 0, sizeof ex_dec);
    ex_dec.allocate = ex_alloc;
    ex_dec.release = ex_drop;
    if (cxmd_decode(&ex_dec, raw, n)) {
        ex_why(why, cap, ex_dec.why ? ex_dec.why : "invalid model input");
        cxml_release(&ex_dec.model, ex_drop);
        return 1;
    }
    ex_model(&ex_core, &ex_dec.model);
    ex_held = 1;
    ex_why(why, cap, 0);
    return 0;
}

int ex_exec(unsigned char *input, int inputn, const char *src,
            unsigned char **outb, long *outn, char *why, int cap) {
    CoreResult result;
    int st;
    char msg[160];
    int lim;
    int i;
    if (!outb || !outn || inputn < 0 || (inputn > 0 && !input)) {
        ex_why(why, cap, "bad argument");
        return 4;
    }
    *outb = 0;
    *outn = 0;
    if (!ex_held) {
        ex_why(why, cap, "model");
        return 1;
    }
    memset(&result, 0, sizeof result);
    st = core_run(&ex_core, input, inputn, src ? src : "", 400000000000LL, &result);
    lim = 0;
    if (st && result.reason) {
        if (result.reason_n > 0) lim = result.reason_n;
        else while (result.reason[lim] && lim < 120) lim = lim + 1;
    }
    if (lim > 120) lim = 120;
    i = 0;
    while (i < lim) { msg[i] = result.reason[i]; i = i + 1; }
    msg[i] = 0;
    if (st == 1 && result.reason_n > 0 && result.reason) {
        fputs("reject: ", stderr);
        fwrite(result.reason, 1, (size_t)result.reason_n, stderr);
        fputc('\n', stderr);
    } else if (st == 2 && result.reason) {
        fputs("run: ", stderr);
        fputs(result.reason, stderr);
        fputc('\n', stderr);
    } else if (st == 3) {
        fprintf(stderr, "step budget exhausted (budget %lld steps)\n", 400000000000LL);
    }
    if (result.err.n > 0 && result.err.b)
        fwrite(result.err.b, 1, (size_t)result.err.n, stderr);
    {
        int noted;
        noted = st && ((st == 1 && result.reason_n > 0 && result.reason) ||
                       (st == 2 && result.reason) || st == 3 || result.err.n > 0);
        if (result.err.b) free(result.err.b);
        ex_unload();
        if (st) {
            free(result.out.b);
            if (noted) ex_why(why, cap, 0);
            else ex_why(why, cap, msg[0] ? msg : "model");
            return st;
        }
    }
    *outb = result.out.b;
    *outn = result.out.n;
    ex_why(why, cap, 0);
    return 0;
}
