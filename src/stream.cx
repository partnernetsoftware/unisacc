#pragma unisa module stream
/* Seven byte streams. Names and model files match
   exec/pipeline/image-stages.tsv. No libc and no include. */
int st_count(void) {
    return 7;
}
int st_at(int index, const char **name, const char **model) {
    if (!name || !model) return 4;
    if (index == 0) { *name = "e2"; *model = "e2.net"; return 0; }
    if (index == 1) { *name = "e1"; *model = "e1.net"; return 0; }
    if (index == 2) { *name = "e3"; *model = "e3.net"; return 0; }
    if (index == 3) { *name = "e4"; *model = "e4.net"; return 0; }
    if (index == 4) { *name = "prune"; *model = "prune.net"; return 0; }
    if (index == 5) { *name = "lower"; *model = "lower.net"; return 0; }
    if (index == 6) { *name = "elf"; *model = "elf.net"; return 0; }
    return 2;
}
