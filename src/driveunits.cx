/* Multi-source unit framing and forwarding-stub splice; srcv is drive's dv_srcv. */
#pragma unisa module driveunits
#pragma unisa use driver.input
#pragma unisa use entrybind
#pragma unisa use stages
#pragma unisa use runtime.holdframe
#pragma unisa use runtime.attribute_frame
#pragma unisa use runtime.unitcache
#pragma unisa use host
#pragma unisa use compiler.fwdstub
#pragma unisa use driveutil
#pragma unisa use compiler.cxmod
#pragma unisa use runtime.frames

static int dv_unit_route(char *dst, int cap, const char *tgt) {
    int i;
    int k;
    const char *suf;
    suf = "/unit";
    i = 0;
    while (tgt[i]) {
        if (i + 1 >= cap) return 1;
        dst[i] = tgt[i];
        i = i + 1;
    }
    k = 0;
    while (suf[k]) {
        if (i + 1 >= cap) return 1;
        dst[i] = suf[k];
        i = i + 1;
        k = k + 1;
    }
    dst[i] = 0;
    return 0;
}


int dv_units(const char *tgt, int nsrc, const char **srcv, unsigned char **out, long *outn, char *why, int cap) {
    char uroute[96];
    unsigned char *frame;
    long fn;
    long fcap;
    int j;
    int st_units(int);
    /* Phase B: restore first-pass frames; publish unit count so rt-shared macros match a whole compile. Failed restore refuses. */
    if (hf_phase_b()) {
        if (st_units(nsrc) || !(*out = hs_alloc(8))) return 1;
        *outn = 8;
        return 0;
    }
    if (hf_phase_refused()) { dv_why(why, cap, "phase checkpoint: UNISACC_PHASE_IN unreadable or receipt mismatch"); return 1; }
    if (dv_unit_route(uroute, 96, tgt)) {
        if (why && cap > 0) why[0] = 0;
        return 1;
    }
    frame = 0;
    fn = 0;
    fcap = 0;
    if (st_units(nsrc)) return 1;
    j = 0;
    while (j < nsrc) {
        unsigned char *cur;
        unsigned char *next;
        long curn;
        long nextn;
        long srcn;
        int pr;
        int act;
        int namelen;
        long framed;
        char reason[128];
        char line[512];
        cur = 0;
        srcn = 0;
        pr = cxi_read(srcv[j], &cur, &srcn, reason, 128);
        act = bx_read_act(pr);
        if (act) {
            free(frame);
            if (act == 1) {
                if (bx_read_open_line(srcv[j], reason, line, 512) == 0) fputs(line, stderr);
                else fprintf(stderr, "unisacc: error: cannot open %s%s%s\n", srcv[j], reason[0] ? ": " : "", reason);
            } else if (act == 2) {
                const char *shown_in;
                shown_in = bx_read_stdin(srcv[j]) == 1 ? "stdin" : srcv[j];
                if (bx_read_fail_line(shown_in, line, 512) == 0) fputs(line, stderr);
                else fprintf(stderr, "run: cannot read %s\n", shown_in);
                fputs("run: cannot read input\n", stderr);
            } else fprintf(stderr, "run: %s\n", bx_read_die(act));
            return 5;
        }
        if (srcn > 2147483647L) {
            free(cur);
            free(frame);
            fprintf(stderr, "run: %s\n", bx_read_die(4));
            return 5;
        }
        next = 0;
        nextn = 0;
        pr = uc_span(st_span, st_pub, st_attr_exchange, uroute, tgt, srcv[j], dv_cx(srcv[j]), (unsigned)j, cur, srcn, &next, &nextn, why, cap);
        if (pr) {
            free(frame);
            if (pr == 3 && why && cap > 8) {
                why[0] = 'u'; why[1] = 'n'; why[2] = 'i'; why[3] = 't'; why[4] = 's'; why[5] = 0;
            }
            return pr == 4 ? 1 : pr;
        }
        cur = next;
        curn = nextn;
        if (fr_add(&frame, &fn, &fcap, srcv[j], dv_len(srcv[j]), cur, curn)) {
            free(cur);
            free(frame);
            if (why && cap > 0) why[0] = 0;
            return 1;
        }
        free(cur);
        j = j + 1;
    }
    *out = frame;
    *outn = fn;
    return 0;
}

static void dv_move(unsigned char *d, const unsigned char *s, long n) {
    long i;
    if (!d || !s || n <= 0) return;
    i = 0;
    while (i < n) {
        d[i] = s[i];
        i = i + 1;
    }
}

static long dv_rd32(const unsigned char *p) {
    return (long)((unsigned)p[0] | ((unsigned)p[1] << 8) |
                  ((unsigned)p[2] << 16) | ((unsigned)p[3] << 24));
}

static void dv_recs_free(unsigned char **recs, int *rcnt, int *fill, int nu) {
    int i;
    if (recs) {
        i = 0;
        while (i < nu) {
            hs_free(recs[i]);
            i = i + 1;
        }
    }
    hs_free(recs);
    hs_free(rcnt);
    hs_free(fill);
}

/* Copy framed units and attribute table from before e3. */
int dv_fwd_keep(const unsigned char *fr, long frn) {
    unsigned char *ab;
    long an;
    long ac;
    long saved;
    if (hf_phase_b()) return 0;
    ab = 0;
    an = 0;
    ac = 0;
    dv_hold_drop();
    hs_phase_arm(0);
    if (!fr || frn <= 0 || st_attr_exchange(&ab, &an, &ac)) return 1;
    saved = an;
    if (hf_keep(fr, frn, saved > 0 ? ab : 0, saved)) {
        st_attr_exchange(&ab, &an, &ac);
        return 1;
    }
    if (st_attr_exchange(&ab, &an, &ac)) return 1;
    hs_phase_arm(0);
    return 0;
}

/* One unit route compile as a frame chunk: length, name, bytes. */
static int dv_compile_frame(const char *tgt, const char *file, unsigned unit,
                            unsigned char **out, long *outn, char *why, int cap) {
    char uroute[96];
    char reason[128];
    char line[512];
    unsigned char *cur;
    unsigned char *next;
    long srcn;
    long nextn;
    long framed;
    int namelen;
    int pr;
    int act;
    int k;
    *out = 0;
    *outn = 0;
    if (dv_unit_route(uroute, 96, tgt)) {
        dv_why(why, cap, "unit route");
        return 1;
    }
    cur = 0;
    srcn = 0;
    pr = cxi_read(file, &cur, &srcn, reason, 128);
    act = bx_read_act(pr);
    if (act) {
        hs_free(cur);
        if (act == 1) {
            if (bx_read_open_line(file, reason, line, 512) == 0) fputs(line, stderr);
            else fprintf(stderr, "unisacc: error: cannot open %s%s%s\n", file, reason[0] ? ": " : "", reason);
        } else if (act == 2) {
            const char *shown_in;
            shown_in = bx_read_stdin(file) == 1 ? "stdin" : file;
            if (bx_read_fail_line(shown_in, line, 512) == 0) fputs(line, stderr);
            else fprintf(stderr, "run: cannot read %s\n", shown_in);
            fputs("run: cannot read input\n", stderr);
        } else fprintf(stderr, "run: %s\n", bx_read_die(act));
        return 5;
    }
    next = 0;
    nextn = 0;
    pr = st_span(uroute, tgt, file, dv_cx(file), unit, 0, 0, cur, srcn, &next, &nextn, why, cap);
    if (pr) return pr == 4 ? 1 : pr;
    namelen = dv_len(file);
    if (namelen < 0 || nextn < 0 || nextn > 2147483647L - 8 - namelen) {
        hs_free(next);
        dv_why(why, cap, "forwarding stub");
        return 1;
    }
    framed = nextn + 4 + namelen;
    {
        unsigned char *fb = 0;
        long fn2 = 0, fc2 = 0;
        if (fr_add(&fb, &fn2, &fc2, file, namelen, next, nextn)) {
            hs_free(next);
            dv_why(why, cap, "out of memory");
            return 1;
        }
        hs_free(next);
        *out = fb;
        *outn = fn2;
        return 0;
    }
}

/* Read holdframe + attr table into recs; on failure free recs and drop. */
static int dv_splice_prep(int nsrc, int *nu, long *head, long *count, unsigned char **fr, long *frn,
                          unsigned char **at, long *atn, int **rcnt, int **fill, unsigned char ***recs,
                          char *why, int cap) {
    int i;
    *fr = hf_frames(frn);
    *at = hf_attrs(atn);
    *nu = nsrc - 1;
    if (!*fr || *frn < 8 || *nu < 1 || *nu > DV_MAXU - 1) {
        dv_why(why, cap, "forwarding stub");
        dv_hold_drop();
        return 1;
    }
    *head = 4 + dv_rd32(*fr);
    if (*head < 8 || *head > *frn) {
        dv_why(why, cap, "forwarding stub");
        dv_hold_drop();
        return 1;
    }
    *count = 0;
    if (*atn) {
        if (*atn < 4 || !*at) {
            dv_why(why, cap, "cli");
            dv_hold_drop();
            return 1;
        }
        *count = dv_rd32(*at);
        if (*count < 0 || *count > 1000000L || 4 + 9 * *count != *atn) {
            dv_why(why, cap, "cli");
            dv_hold_drop();
            return 1;
        }
    }
    *rcnt = hs_alloc((long)*nu * (long)sizeof(int));
    *fill = hs_alloc((long)*nu * (long)sizeof(int));
    *recs = hs_alloc((long)*nu * (long)sizeof(unsigned char *));
    if (!*rcnt || !*fill || !*recs) {
        hs_free(*rcnt);
        hs_free(*fill);
        hs_free(*recs);
        dv_why(why, cap, "out of memory");
        dv_hold_drop();
        return 1;
    }
    i = 0;
    while (i < *nu) {
        (*rcnt)[i] = 0;
        (*fill)[i] = 0;
        (*recs)[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < *count) {
        long uidx;
        uidx = dv_rd32(*at + 4 + 9 * i);
        if (uidx < 0 || uidx >= *nu) {
            dv_recs_free(*recs, *rcnt, *fill, *nu);
            dv_why(why, cap, "cli");
            dv_hold_drop();
            return 1;
        }
        (*rcnt)[uidx] = (*rcnt)[uidx] + 1;
        i = i + 1;
    }
    i = 0;
    while (i < *nu) {
        if ((*rcnt)[i] > 0) {
            (*recs)[i] = hs_alloc((long)(*rcnt)[i] * 5);
            if (!(*recs)[i]) {
                dv_recs_free(*recs, *rcnt, *fill, *nu);
                dv_why(why, cap, "out of memory");
                dv_hold_drop();
                return 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    while (i < *count) {
        const unsigned char *rec;
        long uidx;
        rec = *at + 4 + 9 * i;
        uidx = dv_rd32(rec);
        dv_move((*recs)[uidx] + 5L * (*fill)[uidx], rec + 4, 5);
        (*fill)[uidx] = (*fill)[uidx] + 1;
        i = i + 1;
    }
    if (st_attr_reset()) {
        dv_recs_free(*recs, *rcnt, *fill, *nu);
        dv_why(why, cap, "cli");
        dv_hold_drop();
        return 1;
    }
    return 0;
}

/* Rebuild attr table in restart order; splice stub after first unit. */
int dv_fwd_splice(const char *tgt, int nsrc, const char **srcv, unsigned char **out, long *outn, char *why, int cap) {
    int nu, u, pr;
    int *rcnt, *fill;
    unsigned char **recs;
    unsigned char *ab, *stub, *joined;
    long count, an, ac, head, stubn, total;
    unsigned char *dv_hold_fr;
    long dv_hold_frn;
    unsigned char *dv_hold_at;
    long dv_hold_atn;
    static unsigned char one = 1;
    *out = 0;
    *outn = 0;
    if (dv_splice_prep(nsrc, &nu, &head, &count, &dv_hold_fr, &dv_hold_frn,
                       &dv_hold_at, &dv_hold_atn, &rcnt, &fill, &recs, why, cap))
        return 1;
    ab = 0;
    an = 0;
    ac = 0;
    if (rcnt[0] > 0) {
        pr = cxaf_merge(&ab, &an, &ac, recs[0], (long)rcnt[0], 0, realloc);
        if (pr != 1) {
            hs_free(ab);
            dv_recs_free(recs, rcnt, fill, nu);
            dv_why(why, cap, "cli");
            dv_hold_drop();
            return 1;
        }
    }
    if (st_attr_exchange(&ab, &an, &ac)) {
        hs_free(ab);
        dv_recs_free(recs, rcnt, fill, nu);
        dv_why(why, cap, "cli");
        dv_hold_drop();
        return 1;
    }
    if ((fwd_ccw_on() || hf_phase_b()) && st_extra_put("\0cli/ccw", 8, &one, 1)) {
        dv_recs_free(recs, rcnt, fill, nu);
        dv_why(why, cap, "cli");
        dv_hold_drop();
        return 1;
    }
    stub = 0;
    stubn = 0;
    pr = dv_compile_frame(tgt, srcv[1], 1, &stub, &stubn, why, cap);
    if (pr) {
        dv_recs_free(recs, rcnt, fill, nu);
        dv_hold_drop();
        return pr;
    }
    ab = 0;
    an = 0;
    ac = 0;
    if (st_attr_exchange(&ab, &an, &ac)) {
        hs_free(stub);
        dv_recs_free(recs, rcnt, fill, nu);
        dv_why(why, cap, "cli");
        dv_hold_drop();
        return 1;
    }
    u = 1;
    while (u < nu) {
        if (rcnt[u] > 0) {
            pr = cxaf_merge(&ab, &an, &ac, recs[u], (long)rcnt[u], (unsigned)(u + 1), realloc);
            if (pr != 1) {
                hs_free(ab);
                hs_free(stub);
                dv_recs_free(recs, rcnt, fill, nu);
                dv_why(why, cap, "cli");
                dv_hold_drop();
                return 1;
            }
        }
        u = u + 1;
    }
    if (st_attr_exchange(&ab, &an, &ac)) {
        hs_free(ab);
        hs_free(stub);
        dv_recs_free(recs, rcnt, fill, nu);
        dv_why(why, cap, "cli");
        dv_hold_drop();
        return 1;
    }
    if (stubn > 2147483647L - dv_hold_frn) {
        hs_free(stub);
        dv_recs_free(recs, rcnt, fill, nu);
        dv_why(why, cap, "forwarding stub");
        dv_hold_drop();
        return 1;
    }
    total = dv_hold_frn + stubn;
    joined = hs_alloc(total);
    if (!joined) {
        hs_free(stub);
        dv_recs_free(recs, rcnt, fill, nu);
        dv_why(why, cap, "out of memory");
        dv_hold_drop();
        return 1;
    }
    dv_move(joined, dv_hold_fr, head);
    dv_move(joined + head, stub, stubn);
    if (dv_hold_frn > head)
        dv_move(joined + head + stubn, dv_hold_fr + head, dv_hold_frn - head);
    hs_free(stub);
    dv_recs_free(recs, rcnt, fill, nu);
    dv_hold_drop();
    *out = joined;
    *outn = total;
    return 0;
}
int dv_fwd_restore(unsigned char **out, long *outn, char *why, int cap) {
    unsigned char *ab = 0; long an = 0, ac = 0;
    if (st_attr_reset() || hf_take(out, outn, &ab, &an) || (ac = an, st_attr_exchange(&ab, &an, &ac))) { hs_free(ab); dv_why(why, cap, "phase checkpoint"); return 1; }
    return 0;
}
