#pragma unisa module packmodel
#pragma unisa use runtime.packagefooter
#pragma unisa use runtime.package_decode
#pragma unisa use runtime.package_lifetime
typedef struct { uint32_t table[4][256]; } CxCodecCrc;
/* Locate the installed container footer and decode its package directory.
   Model bodies stay with the stage that asks for them. */
/* Bounded z-string equality. A missing NUL within PM_ZCAP compares unequal.
   This object does not use text.text: drive.o already carries tx_*. */
enum { PM_ZCAP = 1 << 20 };

static int pm_eqz(const char *a, const char *b) {
    long i;
    if (!a || !b) return a == b;
    for (i = 0; i < PM_ZCAP; i++) {
        if (a[i] != b[i]) return 0;
        if (!a[i]) return 1;
    }
    return 0;
}

static void pm_why(char *why, int cap, const char *msg) {
    int i;
    if (!why || cap <= 0) return;
    i = 0;
    if (msg) while (msg[i] && i + 1 < cap) { why[i] = msg[i]; i = i + 1; }
    why[i] = 0;
}
static void *pm_alloc(void *p, size_t n) { return realloc(p, n ? n : 1); }
static void pm_drop(void *p) { free(p); }
static CxPackageDecode pm_dec;
static int pm_held;

int pm_close(void) {
    if (pm_held) cxpl_release(&pm_dec.package, pm_drop);
    pm_held = 0;
    return 0;
}

int pm_open(const unsigned char *data, long n, char *why, int cap) {
    PackageFooter foot;
    CxCodecCrc crc;
    const unsigned char *span;
    const char *msg;
    int cxcodec_crc_init(CxCodecCrc *);
    int ml_load(void *, void *, const unsigned char *, long, int (*)(void *, const unsigned char *, long), const char *(*)(void *), void (*)(void *, void *), void (*)(void *), void (*)(const char *));
    if (!data || n < 0) { pm_why(why, cap, "bad argument"); return 4; }
    if (ml_load(0, 0, 0, 0, 0, 0, 0, 0, 0) != 2) {
        pm_why(why, cap, "modelload"); return 1;
    }
    if (cxcodec_crc_init(&crc)) { pm_why(why, cap, "codec"); return 1; }
    if (!packagefooter_locate_bytes(data, n, &foot)) {
        pm_why(why, cap, "bad or missing package footer"); return 1;
    }
    if (foot.package_offset < 0 || foot.package_length < 0 ||
        foot.package_offset > n || foot.package_length > n - foot.package_offset) {
        pm_why(why, cap, "bad or missing package footer"); return 1;
    }
    span = data + foot.package_offset;
    pm_close();
    memset(&pm_dec, 0, sizeof pm_dec);
    pm_dec.allocate = pm_alloc;
    pm_dec.release = pm_drop;
    if (cxpk_decode(&pm_dec, span, foot.package_length)) {
        msg = pm_dec.why ? pm_dec.why : "invalid package input";
        pm_why(why, cap, msg);
        cxpl_release(&pm_dec.package, pm_drop);
        return 1;
    }
    pm_held = 1;
    pm_why(why, cap, 0);
    return 0;
}

int pm_model(const char *route, const char *stage, const unsigned char **bytes, long *n,
             int *raw, unsigned *crc, int *compressed) {
    int i;
    CxPackage *p;
    if (!pm_held || !route || !stage || !bytes || !n || !raw || !crc || !compressed) return 4;
    p = &pm_dec.package;
    i = 0;
    while (i < p->s) {
        CxPackageStage *s;
        int mi;
        s = &p->stages[i];
        if (pm_eqz(s->route, route) && pm_eqz(s->name, stage)) {
            mi = s->model;
            if (mi < 0 || mi >= p->m) return 1;
            *bytes = p->b + p->off[mi];
            *n = p->len[mi];
            *raw = p->raw[mi];
            *crc = p->crc[mi];
            *compressed = p->ver >= 3;
            return 0;
        }
        i = i + 1;
    }
    return 2;
}

int pm_res(const unsigned char *key, int n, const unsigned char **bytes, int *len) {
    int i;
    CxPackage *p;
    if (!pm_held || !key || n < 0 || !bytes || !len) return 4;
    p = &pm_dec.package;
    i = 0;
    while (i < p->nr) {
        CxPackageResource *r;
        r = &p->res[i];
        if (r->n == n && !memcmp(p->b + r->name, key, (size_t)n)) {
            *bytes = p->b + r->data;
            *len = r->len;
            return 0;
        }
        i = i + 1;
    }
    return 2;
}

int pm_ver(void) {
    if (!pm_held) return 0;
    return pm_dec.package.ver;
}

int pm_along(const char *route, int index, const char **name) {
    int i;
    int k;
    CxPackage *p;
    if (!pm_held || !route || index < 0 || !name) return 4;
    p = &pm_dec.package;
    i = 0;
    k = 0;
    while (i < p->s) {
        CxPackageStage *s;
        s = &p->stages[i];
        if (pm_eqz(s->route, route)) {
            if (k == index) {
                *name = s->name;
                return 0;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    return 2;
}
