#pragma unisa module network
/* Eighteen decision nets, gold stage order. No libc and no include.
   The bytes of a decision come from the weight module, not from a TSV reread. */
int nw_count(void) {
    return 18;
}
int nw_name(int index, const char **out) {
    if (!out) return 4;
    if (index == 0) { *out = "pp"; return 0; }
    if (index == 1) { *out = "lex"; return 0; }
    if (index == 2) { *out = "parse"; return 0; }
    if (index == 3) { *out = "type"; return 0; }
    if (index == 4) { *out = "scope"; return 0; }
    if (index == 5) { *out = "irsel"; return 0; }
    if (index == 6) { *out = "enc"; return 0; }
    if (index == 7) { *out = "reloc"; return 0; }
    if (index == 8) { *out = "regmap"; return 0; }
    if (index == 9) { *out = "tyinfo"; return 0; }
    if (index == 10) { *out = "pfconv"; return 0; }
    if (index == 11) { *out = "peep"; return 0; }
    if (index == 12) { *out = "opinfo"; return 0; }
    if (index == 13) { *out = "prec"; return 0; }
    if (index == 14) { *out = "binsel"; return 0; }
    if (index == 15) { *out = "isel"; return 0; }
    if (index == 16) { *out = "abi"; return 0; }
    if (index == 17) { *out = "combo"; return 0; }
    return 2;
}
