/* Object and archive join. src/unisacc.cx does not use this file.
   drive.cx calls dv_link_objects by name and passes its source vector, so
   this object keeps no view of the driver's argument list. tapelink (tl_*),
   archive (cxr_member), and path (cxp_archive_path) stay in their own
   objects; the host input phrases (cxi_read, bx_read_*) stay in drive.o and
   are named inside the function that calls them. The tape bytes are handed
   to the caller on success; the caller owns them. One link at a time. */
#pragma unisa module drivelink
#pragma unisa use compiler.rtsharedname
#pragma unisa use sys.io

/* Tape bytes emitted by tapelink. Handed to the caller on success. */
static unsigned char *dv_linkb;
static long dv_linkn;
static long dv_linkcap;
static long dv_link_tail; static int dv_link_units;   /* where the trailer starts, and the units before it */

static int dv_link_emit(int c) {
    unsigned char *nb;
    long cap;
    if (dv_linkn < 0 || dv_linkn >= dv_linkcap) {
        if (dv_linkcap > 1073741824L) {
            fputs("link: out of memory\n", stderr);
            exit(1);
        }
        cap = dv_linkcap > 0 ? dv_linkcap * 2 : 4096;
        if (cap <= dv_linkn) cap = dv_linkn + 64;
        nb = (unsigned char *)realloc(dv_linkb, (size_t)cap);
        if (!nb) {
            fputs("link: out of memory\n", stderr);
            exit(1);
        }
        dv_linkb = nb;
        dv_linkcap = cap;
    }
    dv_linkb[dv_linkn] = (unsigned char)(c & 255);
    dv_linkn = dv_linkn + 1;
    return 0;
}

static int dv_link_die(char *m) {
    if (m) fputs(m, stderr);
    exit(1);
    return 1;
}

/* RT-SHARED: 自带私有流表的对象，tape 里有 `.bss g_<probe> <n>` 定义行（probe 名来自生成物）。
   链接 ≥2 个这样的对象时跨单元 FILE 状态不共享：出声，但**不改 rc**（报错会让今天能链接的
   程序失败）。 */
static int dv_shared_has, dv_shared_warned;

/* a[0..n) == b[0..n)：不用 libc（cxlibc / cxraw 对 src/ 只降不升） */
static int dv_pre(const char *a, const char *b, long n) { long i; for (i = 0; i < n; i++) if (a[i] != b[i]) return 0; return 1; }

/* 对象里是否**真的用到**了某一族的运行库状态:tape 里出现 `call <used_symbol>`。
   只带 `.bss g_<probe>` 而不调用任何 used symbol 的对象不算自带私有流表 ——
   每个 .cx 单元对象都带运行库预置的 .bss 行,旧判据"表存在"因此对任意两个 .cx 对象都误报。 */
static int dv_line_has_call(const char *t, long at, long j, const char *sym, long sn) {
    long k = at;
    while (k < j && (t[k] == ' ' || t[k] == 9)) k++;
    if (j - k < 6 || !dv_pre(t + k, "call ", 5)) return 0;
    k += 5;
    return j - k == sn && dv_pre(t + k, sym, sn);
}
/* 私有流表 = 本对象定义了 `.bss g_<probe>` 却没有 `.global g_<probe>`:RT_UNIT 单元导出它(全程序一份),
   RT_EXTERN 单元只有 `.extern g_<probe>`,两者都不是私有。 */
static int dv_line_is(const char *t, long at, long j, const char *dir, long dn, const char *p, long pn) {
    long k = at;
    while (k < j && (t[k] == ' ' || t[k] == 9)) k++;
    if (j - k < dn + 2 + pn || !dv_pre(t + k, dir, dn) || !dv_pre(t + k + dn, "g_", 2) || !dv_pre(t + k + dn + 2, p, pn)) return 0;
    k += dn + 2 + pn;
    return k == j || t[k] == ' ' || t[k] == 9;
}
static int dv_private(const char *t, long tl, const char *p) {
    long at, j, pn; int bss = 0;
    for (pn = 0; p[pn]; pn++) {}
    for (at = 0; at < tl; at = j + 1) {
        for (j = at; j < tl && t[j] != 10; j++) {}
        if (dv_line_is(t, at, j, ".global ", 8, p, pn)) return 0;
        if (dv_line_is(t, at, j, ".bss ", 5, p, pn)) bss = 1;
    }
    return bss;
}
static int dv_used(const char *t, long tl) {
    int i, n, prov, m, sn; const char *g, *p, *u, *e, *sym;
    for (i = 0, n = rts_count(); i < n; i++) {
        long at = 0, j;
        if (rts_at(i, &g, &p, &prov, &u, &e)) continue;
        if (rts_used_count(i) <= 0 || !dv_private(t, tl, p)) continue;
        for (m = 0; m < rts_used_count(i); m++) {
            sym = rts_used_name(i, m);
            if (!sym) continue;
            for (sn = 0; sym[sn]; sn++) {}
            for (at = 0; at < tl; at = j + 1) {
                for (j = at; j < tl && t[j] != 10; j++) {}
                if (dv_line_has_call(t, at, j, sym, sn)) return 1;
            }
        }
    }
    return 0;
}

static void dv_note_shared(const char *t, long tl) {
    if (!dv_used(t, tl)) return;
    if (++dv_shared_has == 2 && !dv_shared_warned++) sy_eprintf("unisacc: warning: 2 objects each carry a private stdio table (cross-unit FILE state is not shared; compile the program in one invocation or link the RT_UNIT entity)\n");
}

static int dv_take_unit(char *t, long tl, int u) {
    void tl_adopt_first(void);
    int tl_target_differs(void);
    const char *tl_first_text(void);
    const char *tl_target_text(void);
    int tl_unitver(char *, int);
    int tl_unit(char *, int, int);
    int tl_note_links(char *, long);
    if (tl < 0 || tl > 2147483647L) {
        fputs("link: malformed unit tape payload\n", stderr);
        exit(1);
    }
    if (u == 0) tl_adopt_first();
    else if (tl_target_differs()) {
        fprintf(stderr, "unisacc: error: the objects were compiled for different targets (%s, %s)\n",
                tl_first_text(), tl_target_text());
        return 1;
    }
    tl_unitver(t, (int)tl);
    tl_unit(t, (int)tl, u);
    tl_note_links(t, tl);
    dv_note_shared(t, tl);
    return 0;
}

static unsigned char *dv_load(const char *path, long *n) {
    unsigned char *b;
    long bn;
    char reason[128];
    char line[512];
    int rc;
    int act;
    int cxi_read(const char *, unsigned char **, long *, char *, long);
    int bx_read_act(int);
    int bx_read_open_line(const char *, const char *, char *, int);
    int bx_read_stdin(const char *);
    int bx_read_fail_line(const char *, char *, int);
    const char *bx_read_die(int);
    const char *shown;
    b = 0;
    bn = 0;
    reason[0] = 0;
    rc = cxi_read(path, &b, &bn, reason, 128);
    act = bx_read_act(rc);
    if (act == 1) {
        if (bx_read_open_line(path, reason, line, 512) == 0) fputs(line, stderr);
        else fprintf(stderr, "unisacc: error: cannot open %s%s%s\n", path, reason[0] ? ": " : "", reason);
        exit(1);
    }
    if (act == 2) {
        shown = bx_read_stdin(path) == 1 ? "stdin" : path;
        if (bx_read_fail_line(shown, line, 512) == 0) fputs(line, stderr);
        else fprintf(stderr, "run: cannot read %s\n", shown);
        fputs("run: cannot read input\n", stderr);
        exit(1);
    }
    if (act || bn > 2147483647L) {
        fprintf(stderr, "run: %s\n", bx_read_die(act ? act : 4));
        free(b);
        exit(1);
    }
    *n = bn;
    return b;
}

/* Product link_objects: every object, then archive members that resolve a name.
   srcs holds the n inputs the driver selected; the first one names the link. */
int dv_link_objects(int n, const char **srcs, unsigned char **out, long *outn) {
    int tl_bind(int (*)(int), int (*)(char *));
    int tl_begin(void);
    char *tl_tape(char *, long, long *);
    int tl_needs(char *, long);
    int tl_check_undef(void);
    int tl_entry_missing(void);
    int tl_finish(int);
    int cxr_member(char *, long, int, char *, long, char **, long *, char *, long);
    int cxp_archive_path(const char *);
    const char *bx_read_die(int);
    int p, u, i, rc, changed;
    long bn, tl, ml;
    unsigned char *b;
    char *t, *m, *used;
    char nm[256];
    char why[128];
    dv_linkn = 0;
    if (tl_bind(dv_link_emit, dv_link_die) || tl_begin()) return 1;
    u = 0;
    p = 0;
    while (p < n) {
        if (cxp_archive_path(srcs[p])) {
            p = p + 1;
            continue;
        }
        b = dv_load(srcs[p], &bn);
        tl = 0;
        t = tl_tape((char *)b, bn, &tl);
        if (!t) {
            fprintf(stderr, "unisacc: error: %s carries no unit tape (compile it with -c -b os/arch -funit; objects from other compilers are not linked yet)\n", srcs[p]);
            free(b);
            return 1;
        }
        if (dv_take_unit(t, tl, u)) {
            free(b);
            return 1;
        }
        u = u + 1;
        free(b);
        p = p + 1;
    }
    p = 0;
    while (p < n) {
        if (!cxp_archive_path(srcs[p])) {
            p = p + 1;
            continue;
        }
        b = dv_load(srcs[p], &bn);
        used = (char *)calloc(65536, 1);
        if (!used) {
            free(b);
            fprintf(stderr, "run: %s\n", bx_read_die(6));
            exit(1);
        }
        changed = 1;
        while (changed) {
            changed = 0;
            i = 0;
            while (i < 65536) {
                m = 0;
                ml = 0;
                rc = cxr_member((char *)b, bn, i, nm, 256, &m, &ml, why, 128);
                if (rc == 1) break;
                if (rc) {
                    fputs(why, stderr);
                    free(used);
                    free(b);
                    return 1;
                }
                if (!used[i]) {
                    tl = 0;
                    t = tl_tape(m, ml, &tl);
                    if (t && tl_needs(t, tl)) {
                        if (dv_take_unit(t, tl, u)) {
                            free(used);
                            free(b);
                            return 1;
                        }
                        u = u + 1;
                        used[i] = 1;
                        changed = 1;
                    }
                }
                i = i + 1;
            }
        }
        free(used);
        free(b);
        p = p + 1;
    }
    if (!u) {
        fprintf(stderr, "link: no input unit selected from %s\n", srcs[0]);
        return 1;
    }
    if (tl_check_undef()) return 1;
    if (tl_entry_missing()) {
        fprintf(stderr, "link: missing _start entry in %s\n", srcs[0]);
        return 1;
    }
    dv_link_tail = dv_linkn;
    dv_link_units = u;
    tl_finish(u);
    *out = dv_linkb;
    *outn = dv_linkn;
    dv_linkb = 0;
    dv_linkn = 0;
    dv_linkcap = 0;
    return 0;
}

/* Reopen the finished link at its trailer for one more unit tape (the forwarding stub
   unit of the fwdsig stage), check the externs again, and close it. *b is the linked
   tape handed out above; it comes back with the unit joined. */
int dv_link_more(unsigned char **b, long *n, char *t, long tl) {
    int tl_unitver(char *, int); int tl_unit(char *, int, int); int tl_note_links(char *, long);
    int tl_check_undef(void); int tl_finish(int);
    dv_linkb = *b; dv_linkcap = *n; dv_linkn = dv_link_tail;
    tl_unitver(t, (int)tl); tl_unit(t, (int)tl, dv_link_units); tl_note_links(t, tl);
    (void)tl_check_undef();   /* a miss leaves through dv_link_die */
    tl_finish(dv_link_units + 1);
    *b = dv_linkb; *n = dv_linkn;
    dv_linkb = 0; dv_linkn = 0; dv_linkcap = 0;
    return 0;
}
