#pragma unisa module drive
#pragma unisa use text.text
#pragma unisa use runcache
#pragma unisa use sys.env
/* Layouts match cx/driver/cli.cx, compat.cx, and route.cx. Those modules
   are other objects; this file only names their functions. */
typedef struct {
    unsigned char **defs;
    unsigned char **undefs;
    unsigned char **forced;
    unsigned char **incdir;
    unsigned char **quotedir;
    unsigned char **errorlimit;
    long *defs_n;
    long *undefs_n;
    long *forced_n;
    long *incdir_n;
    long *quotedir_n;
    long *error_n;
    long *defs_cap;
    long *undefs_cap;
    long *forced_cap;
    long *incdir_cap;
    long *quotedir_cap;
    long *error_cap;
    const char *last_include;
} CxcResources;
typedef struct {
    int (*record)(unsigned char **, long *, long *, const char *, char *, long);
    int (*line)(unsigned char **, long *, long *, const char *, char *, long);
    int (*cancel)(unsigned char **, long *, const char *, char *, long);
} CxcOps;
typedef struct {
    const char *out;
    const char *target;
    const char *pkg;
    const char *deps;
    const char *host_symbols_path;
    const char *host_provider_path;
    const char **deptargets;
    int *depquoted;
    int deptarget_cap;
    int ndeptargets;
    int mode;
    int level;
    int explicit_image;
    int runit;
    int force_origin;
    int emitbin;
    int deponly;
    int depphony;
    int sawc;
    int sawS;
    int funit;
    int warnings;
    int defrun;
    int werror;
    int nostd;
    int notrim;
    CxcResources *res;
    CxcOps *ops;
} CxcState;
typedef struct {
    char **libs;
    int *n;
    int cap;
} CxpState;
typedef struct {
    int mode;
    int level;
    int warnings;
    int nsources;
    int runit;
    int emitbin;
    int deponly;
    int src_tape;
    int src_tapebin;
    int linking;
    int single;
    int exec_restart;
    const char *target;
    const char *native;
    const char *linked_target;
    const char *only_target;
} CxtIn;
typedef struct {
    const char **target;
    int *mode;
    int *runit;
    int *clear_deps;
} CxtOut;
/* Command walk, route text, then the model chain.
   as, nm, objdump, and ar are src/driveface.cx. Forward lowering is
   src/driveroute.cx. This file calls those four by name. A -run whose
   side-car lists host functions finishes on the image route and
   hs_forward_exec replaces this process.
   A missing model step prints NOT_IMPLEMENTED and the stop name.
   ar members go through cxr_append and cxr_member. as, nm, and objdump
   stay on the tools already wired. -cx-plan and -cx-interface return
   through cxm_planprint and cxm_interface. -D/-U/-I/-include fill the
   caller-owned args blocks. -l/-L/-x go through cxp_step into the
   caller-owned library list. executor and packmodel are linked from
   src/entryexec.cx; this file calls them by name. A .tape source is tapecheck, then the
   backend from prune or e4. A .tapebin that is not a container, or whose
   digest does not match, or whose directory or records do not line up,
   is the product refusal. A package that passes is canonical tape text
   and then follows the tape route. Object inputs (.o .obj .a) are joined
   here into one tape before that route. The join calls the tapelink
   object; this file does not compile that module into this unit. */
static int dv_word(const char *word, int is_object) {
    int tool;
    int cli;
    int src;
    int bx_tool(const char *);
    int bx_cli_word(const char *);
    int bx_more_src(const char *, int);
    if (!word) return 4;
    tool = bx_tool(word);
    if (tool == 4) return 4;
    if (tool == 1 || tool == 2 || tool == 3) return tool;
    cli = bx_cli_word(word);
    if (cli == 4) return 4;
    if (cli == 1) return 11;
    if (cli == 2) return 12;
    if (cli == 3) return 13;
    src = bx_more_src(word, is_object);
    if (src == 4) return 4;
    if (src == 1) return 20;
    return 0;
}
static int dv_compat_word(const char *a) {
    if (!a || a[0] != '-') return 0;
    return a[1] == 'l' || a[1] == 'L' || a[1] == 'x';
}
static int dv_fail(const char *s) {
    char line[512];
    int bx_cli_line(const char *, char *, int);
    if (!s) return 1;
    if (bx_cli_line(s, line, 512) == 0) {
        fputs(line, stderr);
        return 1;
    }
    fprintf(stderr, "unisacc: model driver: %s\n", s);
    return 1;
}
static int dv_tapebin_sha_bad(const unsigned char *b, long n) {
    unsigned char dig[32];
    int i;
    if (!b || n < 136) return 1;
    cx_sha256(b + 64, (size_t)(n - 64), dig);
    i = 0;
    while (i < 32) {
        if (dig[i] != b[28 + i]) return 1;
        i = i + 1;
    }
    return 0;
}
static int dv_cx(const char *s) {
    int n;
    if (!s) return 0;
    n = 0;
    while (s[n]) n = n + 1;
    if (n >= 3 && s[n - 3] == '.' && s[n - 2] == 'c' && s[n - 1] == 'x') return 1;
    return 0;
}
static void dv_time(const char *phase, long long a, long long b) {
    const char *env;
    env = getenv("UNISACC_RR_TIME");
    if (!env || !env[0] || a < 0 || b < 0 || !phase || phase[0] != 'p') return;
    fprintf(stderr, "RR_TIME\tconstruction\tns=%lld\n", b - a > 0 ? b - a : 1);
}
static const unsigned char dv_cxh[] = "cx.h";
static unsigned char *dv_defs;
static unsigned char *dv_undefs;
static unsigned char *dv_forced;
static unsigned char *dv_incdir;
static unsigned char *dv_quotedir;
static unsigned char *dv_errb;
static unsigned char *dv_withcx;
static long dv_defs_n, dv_defs_cap;
static long dv_undefs_n, dv_undefs_cap;
static long dv_forced_n, dv_forced_cap;
static long dv_incdir_n, dv_incdir_cap;
static long dv_quotedir_n, dv_quotedir_cap;
static long dv_err_n, dv_err_cap;
static long dv_withcx_n, dv_withcx_cap;
static CxcResources dv_res;
static CxcOps dv_ops;
static const char *dv_srcv[64];
static int dv_cxm_open(void) {
    char td[512];
    int cxm_bind(int (*)(char *, char *, int), int (*)(char *, char *, int), int (*)(int, char *, int), void (*)(char *, int, char *), char *);
    int hs_cxm_tmpdir(char *, int);
    int hs_cxm_rd(char *, char *, int);
    int hs_cxm_wr(char *, char *, int);
    int hs_cxm_say(int, char *, int);
    void hs_cxm_sha(char *, int, char *);
    if (hs_cxm_tmpdir(td, 512)) {
        fputs("unisacc: model driver: tmpdir\n", stderr);
        return 1;
    }
    if (cxm_bind(hs_cxm_rd, hs_cxm_wr, hs_cxm_say, hs_cxm_sha, td)) {
        fputs("unisacc: model driver: modules\n", stderr);
        return 1;
    }
    return 0;
}
/* -cx-interface prints one module and returns. -cx-plan prints the unit
   list and returns. Other commands return -1 so the compile walk continues. */
static int dv_cx_flags(int nsrc) {
    char *paths[64];
    int cxm_wants_interface(void); int ex_ri_finish(void);
    int cxm_wants_plan(void);
    int cxm_interface(char *);
    void cxm_set_on(int);
    int cxm_plan(char **, int);
    int cxm_planprint(char **, int);
    int i;
    if (!cxm_wants_interface() && !cxm_wants_plan()) return -1;
    if (nsrc < 1 || ex_ri_finish()) return nsrc < 1 ? 1 : 2;
    if (dv_cxm_open()) return 1;
    if (cxm_wants_interface()) return cxm_interface((char *)dv_srcv[0]);
    cxm_set_on(0);
    i = 0;
    while (i < nsrc) {
        paths[i] = (char *)dv_srcv[i];
        i = i + 1;
    }
    if (cxm_plan(paths, nsrc)) return 1;
    {
        char *incv[32];
        int ninc;
        long at;
        ninc = 0;
        at = 0;
        while (at < dv_forced_n) {
            if (ninc >= 32) return 1;
            incv[ninc] = (char *)(dv_forced + at);
            ninc = ninc + 1;
            while (at < dv_forced_n && dv_forced[at]) at = at + 1;
            if (at >= dv_forced_n) return 1;
            at = at + 1;
        }
        return cxm_planprint(incv, ninc);
    }
}
/* One .cx on the command line: cxm_plan appends its use closure.
   The paths stay in dv_srcv. CXIF includes are published per unit later. */
static int dv_expand(int *nsrc, int funit) {
    char *paths[64];
    int cxm_iscxpath(char *);
    void cxm_set_on(int); void cxm_set_funit(int);
    int cxm_plan(char **, int);
    int cxm_count(void);
    char *cxm_unit_path(int);
    int i;
    int any;
    int n;
    if (!nsrc || *nsrc < 1) return 1;
    any = 0;
    i = 0;
    while (i < *nsrc) {
        if (cxm_iscxpath((char *)dv_srcv[i])) any = 1;
        i = i + 1;
    }
    if (!any) return 0;
    if (dv_cxm_open()) return 1;
    cxm_set_on(0); cxm_set_funit(funit);
    i = 0;
    while (i < *nsrc) {
        paths[i] = (char *)dv_srcv[i];
        i = i + 1;
    }
    if (cxm_plan(paths, *nsrc)) return 1;
    n = cxm_count();
    if (n < 1 || n > 64) {
        fputs("unisacc: model driver: modules\n", stderr);
        return 1;
    }
    i = 0;
    while (i < n) {
        dv_srcv[i] = cxm_unit_path(i);
        i = i + 1;
    }
    *nsrc = n;
    return 0;
}
static int dv_len(const char *s) {
    int n;
    n = 0;
    if (!s) return 0;
    while (s[n]) n = n + 1;
    return n;
}
static int dv_put_key(const char *key, int kn, const unsigned char *b, long n) {
    int hs_cli_put(const unsigned char *, int, const unsigned char *, int);
    if (n <= 0) return 0;
    if (n > 2147483647L) return 1;
    return hs_cli_put((const unsigned char *)key, kn, b, (int)n);
}
static int dv_cli(const char *tgt, const char *src, int cx, int nostd) {
    char why[96];
    int n;
    int hs_cli_reset(void); int sy_setenv(const char *, const char *, int);
    int hs_cli_put(const unsigned char *, int, const unsigned char *, int);
    int cxa_record(unsigned char **, long *, long *, const char *, char *, long);
    int cxa_raw(unsigned char **, long *, long *, const unsigned char *, long, char *, long);
    if (!tgt || !src) return 4;
    if (hs_cli_reset() || (nostd && sy_setenv("UNISA_NOSTDINC", "1", 1))) return 1;
    n = dv_len(tgt);
    if (hs_cli_put((const unsigned char *)"\0cli/target", 11, (const unsigned char *)tgt, n)) return 1;
    n = dv_len(src);
    if (hs_cli_put((const unsigned char *)"\0cli/source", 11, (const unsigned char *)src, n + 1)) return 1;
    if (dv_put_key("\0cli/defines", 12, dv_defs, dv_defs_n)) return 1;
    if (dv_put_key("\0cli/undefines", 14, dv_undefs, dv_undefs_n)) return 1;
    if (cx) {
        dv_withcx_n = 0;
        if (cxa_record(&dv_withcx, &dv_withcx_n, &dv_withcx_cap, "cx.h", why, 96)) return 1;
        if (dv_forced_n > 0 && cxa_raw(&dv_withcx, &dv_withcx_n, &dv_withcx_cap, dv_forced, dv_forced_n, why, 96)) return 1;
        if (dv_put_key("\0cli/includes", 13, dv_withcx, dv_withcx_n)) return 1;
    } else if (dv_put_key("\0cli/includes", 13, dv_forced, dv_forced_n)) return 1;
    if (dv_put_key("\0cli/include-dir", 16, dv_incdir, dv_incdir_n)) return 1;
    if (dv_put_key("\0cli/quote-dir", 14, dv_quotedir, dv_quotedir_n)) return 1;
    if (dv_put_key("\0cli/error-limit", 16, dv_errb, dv_err_n)) return 1;
    return 0;
}
static int dv_unit_route(char *dst, int cap, const char *tgt) {
    int i;
    int k;
    const char *suf;
    suf = "/unit";
    i = 0;
    while (tgt[i]) {
        if (i + 1 >= cap) return 1;
        dst[i] = tgt[i];
        i = i + 1;
    }
    k = 0;
    while (suf[k]) {
        if (i + 1 >= cap) return 1;
        dst[i] = suf[k];
        i = i + 1;
        k = k + 1;
    }
    dst[i] = 0;
    return 0;
}
static int dv_need(unsigned char **b, long *n, long *cap, long more) {
    unsigned char *nb;
    long room;
    if (more < 0 || *n > 2147483647L - more) return 1;
    if (*n + more <= *cap) return 0;
    room = *cap ? *cap : 4096;
    while (room < *n + more) {
        if (room > 1073741824L) return 1;
        room = room * 2;
    }
    nb = realloc(*b, (size_t)room);
    if (!nb) return 1;
    *b = nb;
    *cap = room;
    return 0;
}
static void dv_le(unsigned char *b, long at, long v) {
    int k;
    k = 0;
    while (k < 4) {
        b[at + k] = (unsigned char)((v >> (8 * k)) & 255);
        k = k + 1;
    }
}
static int dv_units(const char *tgt, int nsrc, unsigned char **out, long *outn, char *why, int cap) {
    char uroute[96];
    int cxi_read(const char *, unsigned char **, long *, char *, long);
    int bx_read_act(int);
    int bx_read_open_line(const char *, const char *, char *, int);
    int bx_read_stdin(const char *);
    int bx_read_fail_line(const char *, char *, int);
    const char *bx_read_die(int);
    int st_span(const char *, const char *, const char *, int, unsigned, const char *, const char *, unsigned char *, long, unsigned char **, long *, char *, int);
    unsigned char *frame;
    long fn;
    long fcap;
    int j;
    if (dv_unit_route(uroute, 96, tgt)) {
        if (why && cap > 0) why[0] = 0;
        return 1;
    }
    frame = 0;
    fn = 0;
    fcap = 0;
    j = 0;
    while (j < nsrc) {
        unsigned char *cur;
        unsigned char *next;
        long curn;
        long nextn;
        long srcn;
        int pr;
        int act;
        int namelen;
        long framed;
        char reason[128];
        char line[512];
        cur = 0;
        srcn = 0;
        pr = cxi_read(dv_srcv[j], &cur, &srcn, reason, 128);
        act = bx_read_act(pr);
        if (act) {
            free(frame);
            if (act == 1) {
                if (bx_read_open_line(dv_srcv[j], reason, line, 512) == 0) fputs(line, stderr);
                else fprintf(stderr, "unisacc: error: cannot open %s%s%s\n", dv_srcv[j], reason[0] ? ": " : "", reason);
            } else if (act == 2) {
                const char *shown_in;
                shown_in = bx_read_stdin(dv_srcv[j]) == 1 ? "stdin" : dv_srcv[j];
                if (bx_read_fail_line(shown_in, line, 512) == 0) fputs(line, stderr);
                else fprintf(stderr, "run: cannot read %s\n", shown_in);
                fputs("run: cannot read input\n", stderr);
            } else fprintf(stderr, "run: %s\n", bx_read_die(act));
            return 5;
        }
        if (srcn > 2147483647L) {
            free(cur);
            free(frame);
            fprintf(stderr, "run: %s\n", bx_read_die(4));
            return 5;
        }
        next = 0;
        nextn = 0;
        pr = st_span(uroute, tgt, dv_srcv[j], dv_cx(dv_srcv[j]), (unsigned)j,
                     0, 0, cur, srcn, &next, &nextn, why, cap);
        if (pr) {
            free(frame);
            if (pr == 3 && why && cap > 8) {
                why[0] = 'u'; why[1] = 'n'; why[2] = 'i'; why[3] = 't'; why[4] = 's'; why[5] = 0;
            }
            return pr == 4 ? 1 : pr;
        }
        cur = next;
        curn = nextn;
        namelen = dv_len(dv_srcv[j]);
        framed = curn + 4 + namelen;
        if (dv_need(&frame, &fn, &fcap, 4 + framed)) {
            free(cur);
            free(frame);
            if (why && cap > 0) why[0] = 0;
            return 1;
        }
        dv_le(frame, fn, framed);
        fn = fn + 4;
        dv_le(frame, fn, namelen);
        fn = fn + 4;
        {
            int k;
            k = 0;
            while (k < namelen) {
                frame[fn] = (unsigned char)dv_srcv[j][k];
                fn = fn + 1;
                k = k + 1;
            }
        }
        if (curn) { void *cx_kept = memcpy(frame + fn, cur, (size_t)curn); (void)cx_kept; }
        fn = fn + curn;
        free(cur);
        j = j + 1;
    }
    *out = frame;
    *outn = fn;
    return 0;
}

static unsigned char dv_argc_b[8];
static unsigned char dv_argv_b[8];
static unsigned char dv_text_b[8];
static unsigned char dv_res_b[8];
static unsigned char dv_dl_b[4][8];
static const char *dv_dl_key[4] = {
    "\0process/dl/0", "\0process/dl/1", "\0process/dl/2", "\0process/dl/3"
};
static char **dv_runargs;
/* One byte 1. The product publishes this for \0cli/object and \0cli/funit. */
static unsigned char dv_one = 1;
/* First-pass unit frames and their attribute table. The restart splices
   the stub unit in and retargets the records; it does not compile the
   original units again. */
static unsigned char *dv_hold_fr;
static long dv_hold_frn;
static unsigned char *dv_hold_at;
static long dv_hold_atn;

static void dv_move(unsigned char *d, const unsigned char *s, long n) {
    long i;
    if (!d || !s || n <= 0) return;
    i = 0;
    while (i < n) {
        d[i] = s[i];
        i = i + 1;
    }
}

static void dv_hold_drop(void) {
    void hs_free(void *);
    hs_free(dv_hold_fr);
    hs_free(dv_hold_at);
    dv_hold_fr = 0;
    dv_hold_frn = 0;
    dv_hold_at = 0;
    dv_hold_atn = 0;
}

static void dv_why(char *why, int cap, const char *s) {
    long tx_len(const char *, long);
    int tx_copy(char *, long, const char *, long);
    long n;
    if (!why || cap <= 0) return;
    n = tx_len(s, (long)cap);
    if (n < 0 || tx_copy(why, (long)cap, s, n)) why[0] = 0;
}

static long dv_rd32(const unsigned char *p) {
    return (long)((unsigned)p[0] | ((unsigned)p[1] << 8) |
                  ((unsigned)p[2] << 16) | ((unsigned)p[3] << 24));
}

static void dv_recs_free(unsigned char **recs, int *rcnt, int *fill, int nu) {
    void hs_free(void *);
    int i;
    if (recs) {
        i = 0;
        while (i < nu) {
            hs_free(recs[i]);
            i = i + 1;
        }
    }
    hs_free(recs);
    hs_free(rcnt);
    hs_free(fill);
}

/* Copy the framed units and the attribute table from before e3. */
static int dv_fwd_keep(const unsigned char *fr, long frn) {
    unsigned char *ab;
    unsigned char *cp;
    unsigned char *fp;
    long an;
    long ac;
    long saved;
    int st_attr_exchange(unsigned char **, long *, long *);
    void *hs_alloc(long);
    void hs_free(void *);
    ab = 0;
    an = 0;
    ac = 0;
    dv_hold_drop();
    if (!fr || frn <= 0) return 1;
    if (st_attr_exchange(&ab, &an, &ac)) return 1;
    saved = an;
    cp = 0;
    if (saved > 0) {
        cp = hs_alloc(saved);
        if (!cp) {
            st_attr_exchange(&ab, &an, &ac);
            return 1;
        }
        dv_move(cp, ab, saved);
    }
    if (st_attr_exchange(&ab, &an, &ac)) {
        hs_free(cp);
        return 1;
    }
    fp = hs_alloc(frn);
    if (!fp) {
        hs_free(cp);
        return 1;
    }
    dv_move(fp, fr, frn);
    dv_hold_fr = fp;
    dv_hold_frn = frn;
    dv_hold_at = cp;
    dv_hold_atn = saved;
    return 0;
}

/* One unit route compile, wrapped as a frame chunk: length, name, bytes. */
static int dv_compile_frame(const char *tgt, const char *file, unsigned unit,
                            unsigned char **out, long *outn, char *why, int cap) {
    char uroute[96];
    char reason[128];
    char line[512];
    unsigned char *cur;
    unsigned char *next;
    unsigned char *chunk;
    long srcn;
    long nextn;
    long framed;
    int namelen;
    int pr;
    int act;
    int k;
    int cxi_read(const char *, unsigned char **, long *, char *, long);
    int bx_read_act(int);
    int bx_read_open_line(const char *, const char *, char *, int);
    int bx_read_stdin(const char *);
    int bx_read_fail_line(const char *, char *, int);
    const char *bx_read_die(int);
    int st_span(const char *, const char *, const char *, int, unsigned, const char *, const char *, unsigned char *, long, unsigned char **, long *, char *, int);
    void *hs_alloc(long);
    void hs_free(void *);
    *out = 0;
    *outn = 0;
    if (dv_unit_route(uroute, 96, tgt)) {
        dv_why(why, cap, "unit route");
        return 1;
    }
    cur = 0;
    srcn = 0;
    pr = cxi_read(file, &cur, &srcn, reason, 128);
    act = bx_read_act(pr);
    if (act) {
        hs_free(cur);
        if (act == 1) {
            if (bx_read_open_line(file, reason, line, 512) == 0) fputs(line, stderr);
            else fprintf(stderr, "unisacc: error: cannot open %s%s%s\n", file, reason[0] ? ": " : "", reason);
        } else if (act == 2) {
            const char *shown_in;
            shown_in = bx_read_stdin(file) == 1 ? "stdin" : file;
            if (bx_read_fail_line(shown_in, line, 512) == 0) fputs(line, stderr);
            else fprintf(stderr, "run: cannot read %s\n", shown_in);
            fputs("run: cannot read input\n", stderr);
        } else fprintf(stderr, "run: %s\n", bx_read_die(act));
        return 5;
    }
    next = 0;
    nextn = 0;
    pr = st_span(uroute, tgt, file, dv_cx(file), unit, 0, 0, cur, srcn, &next, &nextn, why, cap);
    if (pr) return pr == 4 ? 1 : pr;
    namelen = dv_len(file);
    if (namelen < 0 || nextn < 0 || nextn > 2147483647L - 8 - namelen) {
        hs_free(next);
        dv_why(why, cap, "forwarding stub");
        return 1;
    }
    framed = nextn + 4 + namelen;
    chunk = hs_alloc(4 + framed);
    if (!chunk) {
        hs_free(next);
        dv_why(why, cap, "out of memory");
        return 1;
    }
    dv_le(chunk, 0, framed);
    dv_le(chunk, 4, (long)namelen);
    k = 0;
    while (k < namelen) {
        chunk[8 + k] = (unsigned char)file[k];
        k = k + 1;
    }
    if (nextn) dv_move(chunk + 8 + namelen, next, nextn);
    hs_free(next);
    *out = chunk;
    *outn = 4 + framed;
    return 0;
}

/* Rebuild the attribute table in restart order and splice the stub frame
   after the first unit. ccw is published before the stub compile. */
static int dv_fwd_splice(const char *tgt, int nsrc, unsigned char **out, long *outn, char *why, int cap) {
    int nu;
    int i;
    int u;
    int pr;
    int *rcnt;
    int *fill;
    unsigned char **recs;
    unsigned char *ab;
    unsigned char *stub;
    unsigned char *joined;
    long count;
    long an;
    long ac;
    long head;
    long stubn;
    long total;
    int st_attr_reset(void);
    int st_attr_exchange(unsigned char **, long *, long *);
    int st_extra_put(const char *, int, const unsigned char *, int);
    int cxaf_merge(unsigned char **, long *, long *, const unsigned char *, long, unsigned, void *(*)(void *, size_t));
    int fwd_ccw_on(void);
    void *hs_alloc(long);
    void hs_free(void *);
    *out = 0;
    *outn = 0;
    nu = nsrc - 1;
    if (!dv_hold_fr || dv_hold_frn < 8 || nu < 1 || nu > 63) {
        dv_why(why, cap, "forwarding stub");
        dv_hold_drop();
        return 1;
    }
    head = 4 + dv_rd32(dv_hold_fr);
    if (head < 8 || head > dv_hold_frn) {
        dv_why(why, cap, "forwarding stub");
        dv_hold_drop();
        return 1;
    }
    count = 0;
    if (dv_hold_atn) {
        if (dv_hold_atn < 4 || !dv_hold_at) {
            dv_why(why, cap, "cli");
            dv_hold_drop();
            return 1;
        }
        count = dv_rd32(dv_hold_at);
        if (count < 0 || count > 1000000L || 4 + 9 * count != dv_hold_atn) {
            dv_why(why, cap, "cli");
            dv_hold_drop();
            return 1;
        }
    }
    rcnt = hs_alloc((long)nu * (long)sizeof(int));
    fill = hs_alloc((long)nu * (long)sizeof(int));
    recs = hs_alloc((long)nu * (long)sizeof(unsigned char *));
    if (!rcnt || !fill || !recs) {
        hs_free(rcnt);
        hs_free(fill);
        hs_free(recs);
        dv_why(why, cap, "out of memory");
        dv_hold_drop();
        return 1;
    }
    i = 0;
    while (i < nu) {
        rcnt[i] = 0;
        fill[i] = 0;
        recs[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < count) {
        long uidx;
        uidx = dv_rd32(dv_hold_at + 4 + 9 * i);
        if (uidx < 0 || uidx >= nu) {
            dv_recs_free(recs, rcnt, fill, nu);
            dv_why(why, cap, "cli");
            dv_hold_drop();
            return 1;
        }
        rcnt[uidx] = rcnt[uidx] + 1;
        i = i + 1;
    }
    i = 0;
    while (i < nu) {
        if (rcnt[i] > 0) {
            recs[i] = hs_alloc((long)rcnt[i] * 5);
            if (!recs[i]) {
                dv_recs_free(recs, rcnt, fill, nu);
                dv_why(why, cap, "out of memory");
                dv_hold_drop();
                return 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    while (i < count) {
        const unsigned char *rec;
        long uidx;
        rec = dv_hold_at + 4 + 9 * i;
        uidx = dv_rd32(rec);
        dv_move(recs[uidx] + 5L * fill[uidx], rec + 4, 5);
        fill[uidx] = fill[uidx] + 1;
        i = i + 1;
    }
    if (st_attr_reset()) {
        dv_recs_free(recs, rcnt, fill, nu);
        dv_why(why, cap, "cli");
        dv_hold_drop();
        return 1;
    }
    ab = 0;
    an = 0;
    ac = 0;
    if (rcnt[0] > 0) {
        pr = cxaf_merge(&ab, &an, &ac, recs[0], (long)rcnt[0], 0, realloc);
        if (pr != 1) {
            hs_free(ab);
            dv_recs_free(recs, rcnt, fill, nu);
            dv_why(why, cap, "cli");
            dv_hold_drop();
            return 1;
        }
    }
    if (st_attr_exchange(&ab, &an, &ac)) {
        hs_free(ab);
        dv_recs_free(recs, rcnt, fill, nu);
        dv_why(why, cap, "cli");
        dv_hold_drop();
        return 1;
    }
    if (fwd_ccw_on() && st_extra_put("\0cli/ccw", 8, &dv_one, 1)) {
        dv_recs_free(recs, rcnt, fill, nu);
        dv_why(why, cap, "cli");
        dv_hold_drop();
        return 1;
    }
    stub = 0;
    stubn = 0;
    pr = dv_compile_frame(tgt, dv_srcv[1], 1, &stub, &stubn, why, cap);
    if (pr) {
        dv_recs_free(recs, rcnt, fill, nu);
        dv_hold_drop();
        return pr;
    }
    ab = 0;
    an = 0;
    ac = 0;
    if (st_attr_exchange(&ab, &an, &ac)) {
        hs_free(stub);
        dv_recs_free(recs, rcnt, fill, nu);
        dv_why(why, cap, "cli");
        dv_hold_drop();
        return 1;
    }
    u = 1;
    while (u < nu) {
        if (rcnt[u] > 0) {
            pr = cxaf_merge(&ab, &an, &ac, recs[u], (long)rcnt[u], (unsigned)(u + 1), realloc);
            if (pr != 1) {
                hs_free(ab);
                hs_free(stub);
                dv_recs_free(recs, rcnt, fill, nu);
                dv_why(why, cap, "cli");
                dv_hold_drop();
                return 1;
            }
        }
        u = u + 1;
    }
    if (st_attr_exchange(&ab, &an, &ac)) {
        hs_free(ab);
        hs_free(stub);
        dv_recs_free(recs, rcnt, fill, nu);
        dv_why(why, cap, "cli");
        dv_hold_drop();
        return 1;
    }
    if (stubn > 2147483647L - dv_hold_frn) {
        hs_free(stub);
        dv_recs_free(recs, rcnt, fill, nu);
        dv_why(why, cap, "forwarding stub");
        dv_hold_drop();
        return 1;
    }
    total = dv_hold_frn + stubn;
    joined = hs_alloc(total);
    if (!joined) {
        hs_free(stub);
        dv_recs_free(recs, rcnt, fill, nu);
        dv_why(why, cap, "out of memory");
        dv_hold_drop();
        return 1;
    }
    dv_move(joined, dv_hold_fr, head);
    dv_move(joined + head, stub, stubn);
    if (dv_hold_frn > head)
        dv_move(joined + head + stubn, dv_hold_fr + head, dv_hold_frn - head);
    hs_free(stub);
    dv_recs_free(recs, rcnt, fill, nu);
    dv_hold_drop();
    *out = joined;
    *outn = total;
    return 0;
}

/* Tape bytes emitted by tapelink. Handed to the caller on success. */
static unsigned char *dv_linkb;
static long dv_linkn;
static long dv_linkcap;

static int dv_join(char *dst, int cap, const char *a, const char *b) {
    int i;
    int j;
    if (!dst || cap <= 0 || !a || !b) return 1;
    i = 0;
    while (a[i]) {
        if (i + 1 >= cap) return 1;
        dst[i] = a[i];
        i = i + 1;
    }
    j = 0;
    while (b[j]) {
        if (i + 1 >= cap) return 1;
        dst[i] = b[j];
        i = i + 1;
        j = j + 1;
    }
    dst[i] = 0;
    return 0;
}

static int dv_bind_args(int argc, char **argv, int argstart, const char *src) {
    int count;
    int hs_le64(unsigned char *, unsigned long long);
    int envn;
    int j;
    char **v;
    char **env;
    count = 1 + argc - argstart;
    if (!src || count < 1) return 1;
    env = sy_env_vec();
    envn = 0;
    if (env) while (env[envn]) envn = envn + 1;
    v = malloc((size_t)(count + envn + 2) * sizeof(char *));
    if (!v) return 1;
    v[0] = (char *)src;
    j = argstart;
    while (j < argc) {
        v[j - argstart + 1] = argv[j];
        j = j + 1;
    }
    v[count] = 0;
    j = 0;
    while (j < envn) {
        v[count + 1 + j] = env[j];
        j = j + 1;
    }
    v[count + 1 + envn] = 0;
    free(dv_runargs);
    dv_runargs = v;
    if (hs_le64(dv_argc_b, (unsigned long long)count)) return 1;
    if (hs_le64(dv_argv_b, (unsigned long long)(uintptr_t)v)) return 1;
    return 0;
}

static int dv_memory(const char *tgt, const char *src, int cx,
                     unsigned char *lower, long lowern,
                     unsigned char *base, long reserved,
                     char *why, int cap, int *code) {
    char mroute[96];
    unsigned char *image;
    long imagen;
    long long dataoff;
    long long size;
    int text;
    int extent;
    int stored;
    int entry;
    int pr;
    int i;
    int hs_le64(unsigned char *, unsigned long long);
    int st_extra_put(const char *, int, const unsigned char *, int);
    int hs_dl_le(int, unsigned char *);
    int st_span(const char *, const char *, const char *, int, unsigned, const char *, const char *, unsigned char *, long, unsigned char **, long *, char *, int);
    int mem_image(const unsigned char *, int, int *, int *, int *, int *);
    void mem_place(int, int, long long *, long long *);
    int mem_span_ok(long long);
    int hs_commit(unsigned char *, long);
    int hs_copy_image(unsigned char *, long, const unsigned char *, long, long);
    int hs_protect_code(unsigned char *, long);
    int hs_enter(unsigned char *, int);
    if (!code) return 4;
    *code = 0;
    if (dv_join(mroute, 96, tgt, "/memory")) {
        free(lower);
        return 1;
    }
    if (hs_le64(dv_text_b, (unsigned long long)(uintptr_t)base) ||
        hs_le64(dv_res_b, (unsigned long long)reserved)) {
        free(lower);
        return 1;
    }
    if (st_extra_put("\0memory/text", 12, dv_text_b, 8) ||
        st_extra_put("\0memory/reserve", 15, dv_res_b, 8)) {
        free(lower);
        return 1;
    }
    i = 0;
    while (i < 4) {
        hs_dl_le(i, dv_dl_b[i]); if (st_extra_put(dv_dl_key[i], 13, dv_dl_b[i], 8)) {
            free(lower);
            return 1;
        }
        i = i + 1;
    }
    image = 0;
    imagen = 0;
    pr = st_span(mroute, tgt, src, cx, 0, 0, 0, lower, lowern, &image, &imagen, why, cap);
    if (pr) return pr;
    if (!image || imagen < 0 || imagen > 2147483647L) {
        free(image);
        return 1;
    }
    pr = mem_image(image, (int)imagen, &text, &extent, &stored, &entry);
    if (pr) {
        free(image);
        if (pr == 3) {
            if (why && cap > 0) {
                const char *m;
                m = "memory image extent too large";
                i = 0;
                while (m[i] && i + 1 < cap) { why[i] = m[i]; i = i + 1; }
                why[i] = 0;
            }
        } else if (pr == 2) {
            if (why && cap > 0) {
                const char *m;
                m = "bad memory image bounds";
                i = 0;
                while (m[i] && i + 1 < cap) { why[i] = m[i]; i = i + 1; }
                why[i] = 0;
            }
        }
        return 1;
    }
    mem_place(text, extent, &dataoff, &size);
    if (!mem_span_ok(size) || size > reserved || dataoff < 0 || dataoff > 2147483647LL || size > 2147483647LL) {
        free(image);
        return 1;
    }
    if (hs_commit(base, (long)size)) {
        free(image);
        return 1;
    }
    if (hs_copy_image(base, (long)dataoff, image, text, stored)) {
        free(image);
        return 1;
    }
    free(image);
    if (hs_protect_code(base, (long)dataoff)) return 1;
    *code = hs_enter(base, entry);
    return 0;
}

static int dv_link_emit(int c) {
    unsigned char *nb;
    long cap;
    if (dv_linkn < 0 || dv_linkn >= dv_linkcap) {
        if (dv_linkcap > 1073741824L) {
            fputs("link: out of memory\n", stderr);
            exit(1);
        }
        cap = dv_linkcap > 0 ? dv_linkcap * 2 : 4096;
        if (cap <= dv_linkn) cap = dv_linkn + 64;
        nb = (unsigned char *)realloc(dv_linkb, (size_t)cap);
        if (!nb) {
            fputs("link: out of memory\n", stderr);
            exit(1);
        }
        dv_linkb = nb;
        dv_linkcap = cap;
    }
    dv_linkb[dv_linkn] = (unsigned char)(c & 255);
    dv_linkn = dv_linkn + 1;
    return 0;
}

static int dv_link_die(char *m) {
    if (m) fputs(m, stderr);
    exit(1);
    return 1;
}

/* Same sentences as the product when the formatted line is unavailable. */
static int dv_take_unit(char *t, long tl, int u) {
    void tl_adopt_first(void);
    int tl_target_differs(void);
    const char *tl_first_text(void);
    const char *tl_target_text(void);
    int tl_unitver(char *, int);
    int tl_unit(char *, int, int);
    int tl_note_links(char *, long);
    if (tl < 0 || tl > 2147483647L) {
        fputs("link: malformed unit tape payload\n", stderr);
        exit(1);
    }
    if (u == 0) tl_adopt_first();
    else if (tl_target_differs()) {
        fprintf(stderr, "unisacc: error: the objects were compiled for different targets (%s, %s)\n",
                tl_first_text(), tl_target_text());
        return 1;
    }
    tl_unitver(t, (int)tl);
    tl_unit(t, (int)tl, u);
    tl_note_links(t, tl);
    return 0;
}

static unsigned char *dv_load(const char *path, long *n) {
    unsigned char *b;
    long bn;
    char reason[128];
    char line[512];
    int rc;
    int act;
    int cxi_read(const char *, unsigned char **, long *, char *, long);
    int bx_read_act(int);
    int bx_read_open_line(const char *, const char *, char *, int);
    int bx_read_stdin(const char *);
    int bx_read_fail_line(const char *, char *, int);
    const char *bx_read_die(int);
    const char *shown;
    b = 0;
    bn = 0;
    reason[0] = 0;
    rc = cxi_read(path, &b, &bn, reason, 128);
    act = bx_read_act(rc);
    if (act == 1) {
        if (bx_read_open_line(path, reason, line, 512) == 0) fputs(line, stderr);
        else fprintf(stderr, "unisacc: error: cannot open %s%s%s\n", path, reason[0] ? ": " : "", reason);
        exit(1);
    }
    if (act == 2) {
        shown = bx_read_stdin(path) == 1 ? "stdin" : path;
        if (bx_read_fail_line(shown, line, 512) == 0) fputs(line, stderr);
        else fprintf(stderr, "run: cannot read %s\n", shown);
        fputs("run: cannot read input\n", stderr);
        exit(1);
    }
    if (act || bn > 2147483647L) {
        fprintf(stderr, "run: %s\n", bx_read_die(act ? act : 4));
        free(b);
        exit(1);
    }
    *n = bn;
    return b;
}

/* Product link_objects: every object, then archive members that resolve a name. */
static int dv_link_objects(int n, unsigned char **out, long *outn) {
    int tl_bind(int (*)(int), int (*)(char *));
    int tl_begin(void);
    char *tl_tape(char *, long, long *);
    int tl_needs(char *, long);
    int tl_check_undef(void);
    int tl_entry_missing(void);
    int tl_os(char *, int);
    int tl_num(int);
    int cxr_member(char *, long, int, char *, long, char **, long *, char *, long);
    int cxp_archive_path(const char *);
    const char *bx_read_die(int);
    int p;
    int u;
    int k;
    int i;
    int rc;
    int changed;
    long bn;
    long tl;
    long ml;
    unsigned char *b;
    char *t;
    char *m;
    char *used;
    char nm[256];
    char why[128];
    dv_linkn = 0;
    if (tl_bind(dv_link_emit, dv_link_die) || tl_begin()) return 1;
    u = 0;
    p = 0;
    while (p < n) {
        if (cxp_archive_path(dv_srcv[p])) {
            p = p + 1;
            continue;
        }
        b = dv_load(dv_srcv[p], &bn);
        tl = 0;
        t = tl_tape((char *)b, bn, &tl);
        if (!t) {
            fprintf(stderr, "unisacc: error: %s carries no unit tape (compile it with -c -b os/arch -funit; objects from other compilers are not linked yet)\n", dv_srcv[p]);
            free(b);
            return 1;
        }
        if (dv_take_unit(t, tl, u)) {
            free(b);
            return 1;
        }
        u = u + 1;
        free(b);
        p = p + 1;
    }
    p = 0;
    while (p < n) {
        if (!cxp_archive_path(dv_srcv[p])) {
            p = p + 1;
            continue;
        }
        b = dv_load(dv_srcv[p], &bn);
        used = (char *)calloc(65536, 1);
        if (!used) {
            free(b);
            fprintf(stderr, "run: %s\n", bx_read_die(6));
            exit(1);
        }
        changed = 1;
        while (changed) {
            changed = 0;
            i = 0;
            while (i < 65536) {
                m = 0;
                ml = 0;
                rc = cxr_member((char *)b, bn, i, nm, 256, &m, &ml, why, 128);
                if (rc == 1) break;
                if (rc) {
                    fputs(why, stderr);
                    free(used);
                    free(b);
                    return 1;
                }
                if (!used[i]) {
                    tl = 0;
                    t = tl_tape(m, ml, &tl);
                    if (t && tl_needs(t, tl)) {
                        if (dv_take_unit(t, tl, u)) {
                            free(used);
                            free(b);
                            return 1;
                        }
                        u = u + 1;
                        used[i] = 1;
                        changed = 1;
                    }
                }
                i = i + 1;
            }
        }
        free(used);
        free(b);
        p = p + 1;
    }
    if (!u) {
        fprintf(stderr, "link: no input unit selected from %s\n", dv_srcv[0]);
        return 1;
    }
    if (tl_check_undef()) return 1;
    if (tl_entry_missing()) {
        fprintf(stderr, "link: missing _start entry in %s\n", dv_srcv[0]);
        return 1;
    }
    tl_os("__init:\n", 8);
    k = 0;
    while (k < u) {
        tl_os("  call __init_u", 15);
        tl_num(k);
        tl_os("\n", 1);
        k = k + 1;
    }
    tl_os("  ret\n", 6);
    *out = dv_linkb;
    *outn = dv_linkn;
    dv_linkb = 0;
    dv_linkn = 0;
    dv_linkcap = 0;
    return 0;
}

/* Store a forward ELF, then exec it with this run's argv. The bytes are the
   image from after the process slots were popped, so they do not carry argv. */
static int dv_store_exec(const unsigned char *body, long bodyn, char **args) {
    int rc_store_elf(const unsigned char *, long);
    int hs_forward_exec(const unsigned char *, long, char **);
    if (body && bodyn >= 4 && body[0] == 127 && body[1] == 'E' && body[2] == 'L' && body[3] == 'F')
        (void)rc_store_elf(body, bodyn);
    return hs_forward_exec(body, bodyn, args);
}

int dv_main(int argc, char **argv) {
    static CxcState opts;
    char why[128];
    const char *src;
    const char *text;
    const char *shown;
    static char objname[520];
    unsigned char *gotb;
    unsigned char *pkg;
    long gotn;
    long pkgn;
    int i;
    int next;
    int parsed;
    int kind;
    int nsrc;
    int argstart;
    int dv_fwd_pass;
    int dv_fwd_exec;
    char cont[512];
    char gap[32];
    char preason[128];
    long long t0;
    long long t1;
    int ex_touch(void); int ex_cap_gate(int *, char **); int ex_ri_arm(const char *, int, const unsigned char *, long); void ex_alu_note(int); int sy_setenv(const char *, const char *, int); int ex_ri_say(const char *, const char *); int ex_ri_emit(const char *, const unsigned char *, long, char *, int, const char *, int); int ex_ri_die(const char *, int); int ex_ri_argv(int);
    int pm_open(const unsigned char *, long, char *, int);
    int pm_close(void);
    int pm_model(const char *, const char *, const unsigned char **, long *, int *, unsigned *, int *);
    int ex_pp(const unsigned char *, long, int, unsigned, int, unsigned char *, int, const char *, unsigned char **, long *, char *, int);
    int dv_ar(int, char **);
    int dv_as(int, char **);
    int dv_view(int, char **);
    int dv_run_lower(const char *, const char *, const char *, int, int, int, unsigned char *, long, unsigned char **, long *, char *, int, int *);
    int dv_fwd_replay(void);
    const char *dv_fwd_file(void);
    void hs_free(void *);
    int fwd_ccw_on(void);
    char **fwd_lib_slot(void);
    int *fwd_lib_count(void);
    int cxm_flag(char *);
    const char *bx_src_why(const char *);
    int cxc_default_run(CxcState *, char **, int, char *, long);
    int cxc_step(CxcState *, char **, int, int *, char *, long);
    int cxp_step(CxpState *, char **, int, int *, char *, long);
    const char *bx_compat_why(int, int, const char *);
    int bx_opt_dash(const char *);
    const char *bx_opt_why(int, const char *);
    int cxt_object(int, int, int, int, const char *, const char *, int, int *, int *, int *, int *, char *, long);
    int cxp_tape_path(const char *);
    int cxp_tapebin_path(const char *);
    int cxp_object_path(const char *);
    const char *tl_first_text(void);
    int cxt_decide(const CxtIn *, CxtOut *, char *, long);
    int bx_diag_opt(const char *, const char *, int, int, int, int);
    int hb_target_id(const char *);
    int bx_diag_run(const char *, int);
    int cxt_text(const char *, int, int, int, int, char *, long, char *, long);
    int cxd_default_target(const char *, char *, long, char *, long);
    long long hs_ns(void);
    int cxi_read(const char *, unsigned char **, long *, char *, long);
    int bx_read_act(int);
    int bx_read_open_line(const char *, const char *, char *, int);
    int bx_read_stdin(const char *);
    int bx_read_fail_line(const char *, char *, int);
    const char *bx_read_die(int);
