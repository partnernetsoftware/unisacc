#pragma unisa module drive
#pragma unisa use host
#pragma unisa use packmodel
#pragma unisa use executor
#pragma unisa use stages
#pragma unisa use bind
#pragma unisa use driver.cli
#pragma unisa use driver.archive
#pragma unisa use driver.route
#pragma unisa use driver.deps
#pragma unisa use driver.input
#pragma unisa use entrybind
#pragma unisa use runtime.memlayout
#pragma unisa use compiler.asmtext
#pragma unisa use compiler.fwdsig
#pragma unisa use compiler.fwdstub
#pragma unisa use compiler.fwdmerge
#pragma unisa use compiler.fwdincrement
#pragma unisa use compiler.cxmod
/* Command walk, route text, then the model chain.
   A missing model step prints NOT_IMPLEMENTED and the stop name.
   ar members go through cxr_append and cxr_member. as, nm, and objdump
   stay on the tools already wired. -cx-plan and -cx-interface return
   through cxm_planprint and cxm_interface. */
static char dv_in[262144];
static char dv_obj[1048576];
static long dv_objn;

static int dv_word(const char *word, int is_object) {
    int tool;
    int cli;
    int src;
    if (!word) return 4;
    tool = bx_tool(word);
    if (tool == 4) return 4;
    if (tool == 1 || tool == 2 || tool == 3) return tool;
    cli = bx_cli_word(word);
    if (cli == 4) return 4;
    if (cli == 1) return 11;
    if (cli == 2) return 12;
    if (cli == 3) return 13;
    src = bx_more_src(word, is_object);
    if (src == 4) return 4;
    if (src == 1) return 20;
    return 0;
}
static int dv_fail(const char *s) {
    char line[512];
    if (!s) return 1;
    if (bx_cli_line(s, line, 512) == 0) {
        fputs(line, stderr);
        return 1;
    }
    fprintf(stderr, "unisacc: model driver: %s\n", s);
    return 1;
}
static int dv_emit(char *p, long n) {
    long i;
    if (!p || n < 0 || dv_objn > 1048576 - n) return 1;
    i = 0;
    while (i < n) {
        dv_obj[dv_objn] = p[i];
        dv_objn = dv_objn + 1;
        i = i + 1;
    }
    return 0;
}
static int dv_read(const char *path, long *n) {
    FILE *f;
    long got;
    if (!path || !n) return 4;
    f = fopen(path, "rb");
    if (!f) return 1;
    got = (long)fread(dv_in, 1, 262143, f);
    if (fclose(f)) return 1;
    dv_in[got] = 0;
    *n = got;
    return 0;
}
static int dv_as(int argc, char **argv) {
    const char *in;
    const char *out;
    char line[256];
    int i;
    int arch;
    int explicit;
    int head;
    long n;
    FILE *f;
    in = 0;
    out = "a.out";
    arch = 0;
    explicit = 0;
    i = 2;
    while (i < argc) {
        if (argv[i][0] == '-' && argv[i][1]) {
            if (!strcmp(argv[i], "-o") && i + 1 < argc) {
                out = argv[i + 1];
                i = i + 2;
                continue;
            }
            if (!strcmp(argv[i], "-b") && i + 1 < argc) {
                arch = bx_as_arch(argv[i + 1]);
                if (arch != 0 && arch != 1) {
                    fputs(bx_as_targets(), stderr);
                    return 2;
                }
                explicit = 1;
                i = i + 2;
                continue;
            }
            if (bx_as_opt_line(argv[i], line, 256) == 0) fputs(line, stderr);
            else fprintf(stderr, "as: unknown option %s\n", argv[i]);
            return 2;
        }
        in = argv[i];
        i = i + 1;
    }
    if (!in) {
        fputs(bx_as_usage(), stderr);
        return 2;
    }
    if (dv_read(in, &n)) {
        fprintf(stderr, "as: cannot read %s\n", in);
        return 1;
    }
    dv_objn = 0;
    if (at_bind(dv_emit)) return 1;
    head = at_header_arch(dv_in, n);
    if (explicit && head >= 0 && head != arch) {
        if (bx_as_head_line(in, line, 256) == 0) fputs(line, stderr);
        else fprintf(stderr, "as: %s: -S header target conflicts with -b\n", in);
        return 1;
    }
    if (at_asm(dv_in, n, arch)) {
        if (bx_as_err_line(in, at_line(), at_error(), line, 256) == 0) fputs(line, stderr);
        else fprintf(stderr, "as: %s:%d: %s\n", in, at_line(), at_error()[0] ? at_error() : "error");
        return 1;
    }
    f = fopen(out, "wb");
    if (!f) {
        if (bx_as_write_line(out, line, 256) == 0) fputs(line, stderr);
        else fprintf(stderr, "as: cannot write %s\n", out);
        return 1;
    }
    if (fwrite(dv_obj, 1, (size_t)dv_objn, f) != (size_t)dv_objn || fclose(f)) {
        if (bx_as_write_line(out, line, 256) == 0) fputs(line, stderr);
        else fprintf(stderr, "as: cannot write %s\n", out);
        return 1;
    }
    return 0;
}
static int dv_view(int argc, char **argv) {
    int dis;
    const char *path;
    char line[256];
    long n;
    dis = argv[1][0] == 'o';
    if (dis ? (argc != 4 || strcmp(argv[2], "-d")) : argc != 3) {
        fputs(bx_view_usage(dis), stderr);
        return 2;
    }
    path = argv[dis ? 3 : 2];
    if (dv_read(path, &n)) {
        fprintf(stderr, "%s: cannot read %s\n", dis ? "objdump" : "nm", path);
        return 1;
    }
    dv_objn = 0;
    if (at_bind(dv_emit)) return 1;
    if (dis ? at_dis(dv_in, n) : at_nm(dv_in, n)) {
        if (bx_view_err_line(dis, path, at_error(), line, 256) == 0) fputs(line, stderr);
        else fprintf(stderr, "%s: %s: %s\n", dis ? "objdump" : "nm", path, at_error());
        return 1;
    }
    if (dv_objn) fwrite(dv_obj, 1, (size_t)dv_objn, stdout);
    return 0;
}
static int dv_ar_read(const char *path, unsigned char **b, long *n) {
    char reason[128];
    char line[512];
    int rc;
    int act;
    const char *shown;
    *b = 0;
    *n = 0;
    rc = cxi_read(path, b, n, reason, 128);
    act = bx_read_act(rc);
    if (!act && *n > 2147483647L) act = 4;
    if (!act) return 0;
    free(*b);
    *b = 0;
    *n = 0;
    if (act == 1) {
        if (bx_read_open_line(path, reason, line, 512) == 0) fputs(line, stderr);
        else fprintf(stderr, "unisacc: error: cannot open %s%s%s\n", path, reason[0] ? ": " : "", reason);
        return 1;
    }
    if (act == 2) {
        shown = bx_read_stdin(path) == 1 ? "stdin" : path;
        if (bx_read_fail_line(shown, line, 512) == 0) fputs(line, stderr);
        else fprintf(stderr, "run: cannot read %s\n", shown);
        fputs("run: cannot read input\n", stderr);
        return 1;
    }
    fprintf(stderr, "run: %s\n", bx_read_die(act));
    return 1;
}
static int dv_ar_room(long cap, long n, long namesz) {
    long long need;
    if (n < 0 || namesz < 0) return 1;
    need = (long long)n + 400 + (long long)namesz;
    if (need < 0) return 1;
    if ((long long)cap > 9223372036854775807LL - need) return 1;
    return 0;
}
static int dv_ar_write(const char *path, const unsigned char *data, long n) {
    char why[128];
    char line[512];
    if (!hs_write_out(path, data, n, why, 128)) return 0;
    if (bx_ar_write_line(path, line, 512) == 0) fputs(line, stderr);
    else fprintf(stderr, "ar: cannot write %s\n", path);
    return 1;
}
static int dv_ar(int argc, char **argv) {
    const char *op;
    const char *lib;
    char why[128];
    int op0;
    int i;
    if (argc < 4) {
        fputs(bx_ar_usage(), stderr);
        return 2;
    }
    op = argv[2];
    lib = argv[3];
    if (cxr_operation(op, why, 128)) {
        fputs(why, stderr);
        return 2;
    }
    op0 = op[0] & 255;
    if (op0 == 'r' || op0 == 'q') {
        long cap;
        unsigned char *ab;
        long at;
        cap = 8;
        i = 4;
        while (i < argc) {
            unsigned char *b;
            long n;
            long namesz;
            if (dv_ar_read(argv[i], &b, &n)) return 1;
            namesz = dv_len(argv[i]);
            free(b);
            if (dv_ar_room(cap, n, namesz)) {
                fputs(bx_ar_big(), stderr);
                return 1;
            }
            cap = cap + n + 400 + namesz;
            i = i + 1;
        }
        ab = malloc((size_t)cap);
        if (!ab) {
            fprintf(stderr, "run: %s\n", bx_read_die(6));
            return 1;
        }
        memcpy(ab, "!<arch>\n", 8);
        at = 8;
        i = 4;
        while (i < argc) {
            unsigned char *b;
            long n;
            long next;
            int rc;
            if (dv_ar_read(argv[i], &b, &n)) {
                free(ab);
                return 1;
            }
            next = 0;
            rc = cxr_append((char *)ab, cap, at, argv[i], (char *)b, n, &next, why, 128);
            free(b);
            if (rc) {
                fputs(why, stderr);
                free(ab);
                return 1;
            }
            at = next;
            i = i + 1;
        }
        if (dv_ar_write(lib, ab, at)) {
            free(ab);
            return 1;
        }
        free(ab);
        return 0;
    }
    {
        unsigned char *b;
        long n;
        char nm[256];
        if (dv_ar_read(lib, &b, &n)) return 1;
        if (n < 8 || memcmp(b, "!<arch>\n", 8)) {
            free(b);
            fputs(bx_ar_kind(), stderr);
            return 1;
        }
        i = 0;
        for (;;) {
            long ml;
            char *m;
            int rc;
            ml = 0;
            m = 0;
            rc = cxr_member((char *)b, n, i, nm, 256, &m, &ml, why, 128);
            if (rc == 1) break;
            if (rc) {
                fputs(why, stderr);
                free(b);
                return 1;
            }
            if (op0 == 't') {
                fputs(nm, stdout);
                fputc('\n', stdout);
            } else if (op0 == 'x') {
                if (dv_ar_write(nm, (const unsigned char *)m, ml)) {
                    free(b);
                    return 1;
                }
            } else {
                free(b);
                fputs(bx_ar_op(), stderr);
                return 2;
            }
            i = i + 1;
        }
        free(b);
        return 0;
    }
}
static int dv_cx(const char *s) {
    int n;
    if (!s) return 0;
    n = 0;
    while (s[n]) n = n + 1;
    if (n >= 3 && s[n - 3] == '.' && s[n - 2] == 'c' && s[n - 1] == 'x') return 1;
    return 0;
}
static void dv_time(const char *phase, long long a, long long b) {
    const char *env;
    env = getenv("UNISACC_RR_TIME");
    if (!env || !env[0] || a < 0 || b < 0) return;
    fprintf(stderr, "RR_TIME %s ns=%lld\n", phase, b - a);
}
static const unsigned char dv_cxh[] = "cx.h";
static const char *dv_srcv[64];
static int dv_cxm_open(void) {
    char td[512];
    if (hs_cxm_tmpdir(td, 512)) {
        fputs("unisacc: model driver: tmpdir\n", stderr);
        return 1;
    }
    if (cxm_bind(hs_cxm_rd, hs_cxm_wr, hs_cxm_say, hs_cxm_sha, td)) {
        fputs("unisacc: model driver: modules\n", stderr);
        return 1;
    }
    return 0;
}
/* -cx-interface prints one module and returns. -cx-plan prints the unit
   list and returns. Other commands return -1 so the compile walk continues. */
static int dv_cx_flags(int nsrc) {
    char *paths[64];
    int i;
    if (!cxm_wants_interface() && !cxm_wants_plan()) return -1;
    if (nsrc < 1) return 1;
    if (dv_cxm_open()) return 1;
    if (cxm_wants_interface()) return cxm_interface((char *)dv_srcv[0]);
    cxm_set_on(0);
    i = 0;
    while (i < nsrc) {
        paths[i] = (char *)dv_srcv[i];
        i = i + 1;
    }
    if (cxm_plan(paths, nsrc)) return 1;
    return cxm_planprint(0, 0);
}
/* One .cx on the command line: cxm_plan appends its use closure.
   The paths stay in dv_srcv. CXIF includes are published per unit later. */
static int dv_expand(int *nsrc) {
    char *paths[64];
    int i;
    int any;
    int n;
    if (!nsrc || *nsrc < 1) return 1;
    any = 0;
    i = 0;
    while (i < *nsrc) {
        if (cxm_iscxpath((char *)dv_srcv[i])) any = 1;
        i = i + 1;
    }
    if (!any) return 0;
    if (dv_cxm_open()) return 1;
    cxm_set_on(0);
    i = 0;
    while (i < *nsrc) {
        paths[i] = (char *)dv_srcv[i];
        i = i + 1;
    }
    if (cxm_plan(paths, *nsrc)) return 1;
    n = cxm_count();
    if (n < 1 || n > 64) {
        fputs("unisacc: model driver: modules\n", stderr);
        return 1;
    }
    i = 0;
    while (i < n) {
        dv_srcv[i] = cxm_unit_path(i);
        i = i + 1;
    }
    *nsrc = n;
    return 0;
}
static int dv_len(const char *s) {
    int n;
    n = 0;
    if (!s) return 0;
    while (s[n]) n = n + 1;
    return n;
}
static int dv_cli(const char *tgt, const char *src, int cx) {
    int n;
    if (!tgt || !src) return 4;
    if (hs_cli_reset()) return 1;
    n = dv_len(tgt);
    if (hs_cli_put((const unsigned char *)"\0cli/target", 11, (const unsigned char *)tgt, n)) return 1;
    n = dv_len(src);
    if (hs_cli_put((const unsigned char *)"\0cli/source", 11, (const unsigned char *)src, n + 1)) return 1;
    if (cx && hs_cli_put((const unsigned char *)"\0cli/includes", 13, dv_cxh, (int)sizeof dv_cxh)) return 1;
    return 0;
}
static int dv_unit_route(char *dst, int cap, const char *tgt) {
    int i;
    int k;
    const char *suf;
    suf = "/unit";
    i = 0;
    while (tgt[i]) {
        if (i + 1 >= cap) return 1;
        dst[i] = tgt[i];
        i = i + 1;
    }
    k = 0;
    while (suf[k]) {
        if (i + 1 >= cap) return 1;
        dst[i] = suf[k];
        i = i + 1;
        k = k + 1;
    }
    dst[i] = 0;
    return 0;
}
static int dv_need(unsigned char **b, long *n, long *cap, long more) {
    unsigned char *nb;
    long room;
    if (more < 0 || *n > 2147483647L - more) return 1;
    if (*n + more <= *cap) return 0;
    room = *cap ? *cap : 4096;
    while (room < *n + more) {
        if (room > 1073741824L) return 1;
        room = room * 2;
    }
    nb = realloc(*b, (size_t)room);
    if (!nb) return 1;
    *b = nb;
    *cap = room;
    return 0;
}
static void dv_le(unsigned char *b, long at, long v) {
    int k;
    k = 0;
    while (k < 4) {
        b[at + k] = (unsigned char)((v >> (8 * k)) & 255);
        k = k + 1;
    }
}
static int dv_units(const char *tgt, int nsrc, unsigned char **out, long *outn, char *why, int cap) {
    char uroute[96];
    unsigned char *frame;
    long fn;
    long fcap;
    int j;
    if (dv_unit_route(uroute, 96, tgt)) {
        if (why && cap > 0) why[0] = 0;
        return 1;
    }
    frame = 0;
    fn = 0;
    fcap = 0;
    j = 0;
    while (j < nsrc) {
        unsigned char *cur;
        unsigned char *next;
        long curn;
        long nextn;
        long srcn;
        int pr;
        int act;
        int namelen;
        long framed;
        char reason[128];
        char line[512];
        cur = 0;
        srcn = 0;
        pr = cxi_read(dv_srcv[j], &cur, &srcn, reason, 128);
        act = bx_read_act(pr);
        if (act) {
            free(frame);
            if (act == 1) {
                if (bx_read_open_line(dv_srcv[j], reason, line, 512) == 0) fputs(line, stderr);
                else fprintf(stderr, "unisacc: error: cannot open %s%s%s\n", dv_srcv[j], reason[0] ? ": " : "", reason);
            } else if (act == 2) {
                const char *shown_in;
                shown_in = bx_read_stdin(dv_srcv[j]) == 1 ? "stdin" : dv_srcv[j];
                if (bx_read_fail_line(shown_in, line, 512) == 0) fputs(line, stderr);
                else fprintf(stderr, "run: cannot read %s\n", shown_in);
                fputs("run: cannot read input\n", stderr);
            } else fprintf(stderr, "run: %s\n", bx_read_die(act));
            return 5;
        }
        if (srcn > 2147483647L) {
            free(cur);
            free(frame);
            fprintf(stderr, "run: %s\n", bx_read_die(4));
            return 5;
        }
        next = 0;
        nextn = 0;
        pr = st_span(uroute, tgt, dv_srcv[j], dv_cx(dv_srcv[j]), (unsigned)j,
                     0, 0, cur, srcn, &next, &nextn, why, cap);
        if (pr) {
            free(frame);
            if (pr == 3 && why && cap > 8) {
                why[0] = 'u'; why[1] = 'n'; why[2] = 'i'; why[3] = 't'; why[4] = 's'; why[5] = 0;
            }
            return pr == 4 ? 1 : pr;
        }
        cur = next;
        curn = nextn;
        namelen = dv_len(dv_srcv[j]);
        framed = curn + 4 + namelen;
        if (dv_need(&frame, &fn, &fcap, 4 + framed)) {
            free(cur);
            free(frame);
            if (why && cap > 0) why[0] = 0;
            return 1;
        }
        dv_le(frame, fn, framed);
        fn = fn + 4;
        dv_le(frame, fn, namelen);
        fn = fn + 4;
        {
            int k;
            k = 0;
            while (k < namelen) {
                frame[fn] = (unsigned char)dv_srcv[j][k];
                fn = fn + 1;
                k = k + 1;
            }
        }
        if (curn) memcpy(frame + fn, cur, (size_t)curn);
        fn = fn + curn;
        free(cur);
        j = j + 1;
    }
    *out = frame;
    *outn = fn;
    return 0;
}

static unsigned char dv_argc_b[8];
static unsigned char dv_argv_b[8];
static unsigned char dv_text_b[8];
static unsigned char dv_res_b[8];
static unsigned char dv_dl_b[4][8];
static const char *dv_dl_key[4] = {
    "\0process/dl/0", "\0process/dl/1", "\0process/dl/2", "\0process/dl/3"
};
static char **dv_runargs;

static int dv_join(char *dst, int cap, const char *a, const char *b) {
    int i;
    int j;
    if (!dst || cap <= 0 || !a || !b) return 1;
    i = 0;
    while (a[i]) {
        if (i + 1 >= cap) return 1;
        dst[i] = a[i];
        i = i + 1;
    }
    j = 0;
    while (b[j]) {
        if (i + 1 >= cap) return 1;
        dst[i] = b[j];
        i = i + 1;
        j = j + 1;
    }
    dst[i] = 0;
    return 0;
}

static int dv_bind_args(int argc, char **argv, int argstart, const char *src) {
    int count;
    int envn;
    int j;
    char **v;
    count = 1 + argc - argstart;
    if (!src || count < 1) return 1;
    envn = 0;
    if (environ) while (environ[envn]) envn = envn + 1;
    v = malloc((size_t)(count + envn + 2) * sizeof(char *));
    if (!v) return 1;
    v[0] = (char *)src;
    j = argstart;
    while (j < argc) {
        v[j - argstart + 1] = argv[j];
        j = j + 1;
    }
    v[count] = 0;
    j = 0;
    while (j < envn) {
        v[count + 1 + j] = environ[j];
        j = j + 1;
    }
    v[count + 1 + envn] = 0;
    free(dv_runargs);
    dv_runargs = v;
    if (hs_le64(dv_argc_b, (unsigned long long)count)) return 1;
    if (hs_le64(dv_argv_b, (unsigned long long)(uintptr_t)v)) return 1;
    return 0;
}

static int dv_memory(const char *tgt, const char *src, int cx,
                     unsigned char *lower, long lowern,
                     unsigned char *base, long reserved,
                     char *why, int cap, int *code) {
    char mroute[96];
    unsigned char *image;
    long imagen;
    long long dataoff;
    long long size;
    int text;
    int extent;
    int stored;
    int entry;
    int pr;
    int i;
    if (!code) return 4;
    *code = 0;
    if (dv_join(mroute, 96, tgt, "/memory")) {
        free(lower);
        return 1;
    }
    if (hs_le64(dv_text_b, (unsigned long long)(uintptr_t)base) ||
        hs_le64(dv_res_b, (unsigned long long)reserved)) {
        free(lower);
        return 1;
    }
    if (st_extra_put("\0memory/text", 12, dv_text_b, 8) ||
        st_extra_put("\0memory/reserve", 15, dv_res_b, 8)) {
        free(lower);
        return 1;
    }
    i = 0;
    while (i < 4) {
        if (hs_dl_le(i, dv_dl_b[i]) || st_extra_put(dv_dl_key[i], 13, dv_dl_b[i], 8)) {
            free(lower);
            return 1;
        }
        i = i + 1;
    }
    image = 0;
    imagen = 0;
    pr = st_span(mroute, tgt, src, cx, 0, 0, 0, lower, lowern, &image, &imagen, why, cap);
    if (pr) return pr;
    if (!image || imagen < 0 || imagen > 2147483647L) {
        free(image);
        return 1;
    }
    pr = mem_image(image, (int)imagen, &text, &extent, &stored, &entry);
    if (pr) {
        free(image);
        if (pr == 3) {
            if (why && cap > 0) {
                const char *m;
                m = "memory image extent too large";
                i = 0;
                while (m[i] && i + 1 < cap) { why[i] = m[i]; i = i + 1; }
                why[i] = 0;
            }
        } else if (pr == 2) {
            if (why && cap > 0) {
                const char *m;
                m = "bad memory image bounds";
                i = 0;
                while (m[i] && i + 1 < cap) { why[i] = m[i]; i = i + 1; }
                why[i] = 0;
            }
        }
        return 1;
    }
    mem_place(text, extent, &dataoff, &size);
    if (!mem_span_ok(size) || size > reserved || dataoff < 0 || dataoff > 2147483647LL || size > 2147483647LL) {
        free(image);
        return 1;
    }
    if (hs_commit(base, (long)size)) {
        free(image);
        return 1;
    }
    if (hs_copy_image(base, (long)dataoff, image, text, stored)) {
        free(image);
        return 1;
    }
    free(image);
    if (hs_protect_code(base, (long)dataoff)) return 1;
    *code = hs_enter(base, entry);
    return 0;
}

static const char *dv_fw_tgt;
static char dv_fw_why[128];
static unsigned char dv_funit_one = 1;
static char dv_fwd_path[] = "/tmp/unisacc-forward-entry.c";

static void dv_setwhy(char *why, int cap, const char *s) {
    int i;
    if (!why || cap <= 0) return;
    i = 0;
    if (s) while (s[i] && i + 1 < cap) { why[i] = s[i]; i = i + 1; }
    why[i] = 0;
}

static int dv_fw_replay(void) {
    const char *e;
    e = getenv("UNISA_FWD_REPLAY");
    if (e && e[0]) return 1;
    return 0;
}

static void *dv_fw_alloc(void *p, long long n) {
    return realloc(p, n ? (size_t)n : 1);
}

static void dv_fw_release(void *p) { free(p); }

static void dv_fw_fail(char *m) {
    fprintf(stderr, "unisacc: %s\n", m ? m : "forward");
    exit(1);
}

static int dv_fwd_win(const char *t) {
    if (t && t[0] == 'w' && t[1] == 'i' && t[2] == 'n' && t[3] == '/') return 1;
    return 0;
}

static int dv_fw_take(char *route, const char *first, const char *last, void *buf, char *src) {
    FwiBuf *u;
    unsigned char *in;
    unsigned char *out;
    long inn;
    long outn;
    int pr;
    u = (FwiBuf *)buf;
    if (!u || !route || !dv_fw_tgt || !src) return 1;
    in = u->b;
    inn = u->n;
    u->b = 0;
    u->n = 0;
    u->cap = 0;
    u->at = 0;
    out = 0;
    outn = 0;
    dv_fw_why[0] = 0;
    pr = st_span(route, dv_fw_tgt, src, 0, 0, first, last, in, inn, &out, &outn, dv_fw_why, 128);
    if (pr) return 1;
    if (outn < 0 || outn > 2147483647L) {
        free(out);
        dv_setwhy(dv_fw_why, 128, "model too large");
        return 1;
    }
    u->b = out;
    u->n = (int)outn;
    u->cap = (int)outn;
    return 0;
}

static int dv_fw_front(char *route, char *stage, void *buf, char *src) {
    return dv_fw_take(route, 0, stage, buf, src);
}

static int dv_fw_range(char *route, char *a, char *b, void *buf, char *src) {
    int pr;
    if (st_extra_put("\0cli/funit", (int)(sizeof "\0cli/funit" - 1), &dv_funit_one, 1)) return 1;
    pr = dv_fw_take(route, a, b, buf, src);
    if (st_extra_pop()) return 1;
    return pr;
}

static int dv_fw_merge(const void *base, const void *stub, const void *unit, int unitn, void *merged) {
    return fwm_merge((const FwmBuf *)base, (const FwmBuf *)stub, (const FwmBuf *)unit, unitn, (FwmBuf *)merged);
}

static int dv_fwd_one(const unsigned char *b, unsigned long long n, unsigned long long *at,
                      const char **nm, unsigned long long *nl, USForwardSig *sig, char *why, int cap) {
    unsigned long long sl;
    int bad;
    int k;
    char line[1100];
    if (us_fw_u64(b, n, at, nl) || *nl > 1024 || *nl > n - *at) {
        dv_setwhy(why, cap, "forwarding side-car malformed");
        return 1;
    }
    *nm = (const char *)b + *at;
    *at = *at + *nl;
    if (us_fw_u64(b, n, at, &sl) || sl > n - *at) {
        dv_setwhy(why, cap, "forwarding side-car malformed");
        return 1;
    }
    memset(sig, 0, sizeof *sig);
    bad = us_forward_sig_decode(b + *at, sl, *nm, *nl, sig);
    *at = *at + sl;
    if (fw_undef(bad, sig->structbyval, sig->ret.structbyval, sig->n)) {
        if (fw_undef_line(*nm, (int)*nl, line, 1100) == 0) fputs(line, stderr);
        dv_setwhy(why, cap, "undefined function");
        return 1;
    }
    k = 0;
    while (k < sig->n) {
        if (sig->args[k].callback) {
            if (fw_undef_line(*nm, (int)*nl, line, 1100) == 0) fputs(line, stderr);
            dv_setwhy(why, cap, "undefined function");
            return 1;
        }
        k = k + 1;
    }
    (void)fwm_export((const unsigned char *)*nm, (int)*nl);
    return 0;
}

static int dv_fwd_emit(const char *nm, unsigned long long nl, const USForwardSig *sig, char *why, int cap) {
    int kk[33];
    int ww[33];
    int uu[33];
    int k;
    int emitted;
    char line[1100];
    k = 0;
    while (k < sig->n) {
        kk[k] = sig->args[k].kind;
        ww[k] = sig->args[k].width;
        uu[k] = 0;
        k = k + 1;
    }
    if (sig->variadic)
        emitted = fwd_emit_var((char *)nm, (int)nl, sig->n, kk, ww, sig->ret.isvoid, sig->ret.kind, sig->ret.width, sig->ret.uns);
    else
        emitted = fwd_emit((char *)nm, (int)nl, sig->n, kk, ww, uu, sig->ret.isvoid, sig->ret.kind, sig->ret.width, sig->ret.uns);
    fwd_pclear();
    if (fw_emit_miss(emitted)) {
        if (fw_undef_line(nm, (int)nl, line, 1100) == 0) fputs(line, stderr);
        dv_setwhy(why, cap, "undefined function");
        return 1;
    }
    return 0;
}

static int dv_fwd_stub(const unsigned char *b, unsigned long long n, unsigned long long at,
                       unsigned long long cnt, unsigned long long ccwc, const char *tgt,
                       char *why, int cap) {
    unsigned long long r;
    if (fwm_bind(dv_fw_alloc, dv_fw_release, dv_fw_fail)) {
        dv_setwhy(why, cap, "out of memory");
        return 1;
    }
    fwm_reset();
    fwd_reset();
    fwd_set_ccw(ccwc > 0);
    fwd_set_maxargs(dv_fwd_win(tgt) ? 4 : 0);
    r = 0;
    while (r < cnt) {
        const char *nm;
        unsigned long long nl;
        USForwardSig sig;
        if (dv_fwd_one(b, n, &at, &nm, &nl, &sig, why, cap)) return 1;
        if (dv_fwd_emit(nm, nl, &sig, why, cap)) return 1;
        r = r + 1;
    }
    if (fwd_count() > 0) fwd_emit_libs();
    return 0;
}

static int dv_fwd_merge(const char *route, const char *tgt, const char *src, int cx,
                        int level, int nsrc, unsigned char *tape, long tapen,
                        unsigned char **out, long *outn, char *why, int cap) {
    FwiBuf base;
    FwiBuf merged;
    FwiBuf attrs;
    FwiRi ri[1];
    int nri;
    int attr_unit;
    int attr_slot;
    int fast;
    unsigned char *hold;
    long hn;
    long hc;
    const char *cont;
    base.b = tape;
    base.at = 0;
    base.n = (int)tapen;
    base.cap = (int)tapen + 1;
    merged.b = 0;
    merged.at = 0;
    merged.n = 0;
    merged.cap = 0;
    attrs.b = 0;
    attrs.at = 0;
    attrs.n = 0;
    attrs.cap = 0;
    ri[0].name = 0;
    ri[0].n = 0;
    ri[0].data = 0;
    ri[0].len = 0;
    nri = 0;
    attr_unit = 0;
    attr_slot = -1;
    dv_fw_tgt = tgt;
    dv_fw_why[0] = 0;
    hold = 0;
    hn = 0;
    hc = 0;
    if (st_attr_exchange(&hold, &hn, &hc)) {
        free(tape);
        dv_setwhy(why, cap, "cli");
        return 1;
    }
    fast = fwd_incremental(tgt, level, &base, nsrc, &merged, ri, &nri, &attrs, &attr_unit, &attr_slot,
                           dv_fwd_path, dv_fw_replay, fwm_overflowed, fwd_count, fwd_text,
                           dv_fw_alloc, dv_fw_release, dv_fw_front, dv_fw_range, dv_fw_merge);
    st_attr_exchange(&hold, &hn, &hc);
    free(hold);
    free(tape);
    cont = level ? "e4" : "prune";
    if (fast > 0)
        return st_span(route, tgt, src, cx, 0, cont, 0, merged.b, merged.n, out, outn, why, cap);
    free(merged.b);
    if (fast < 0) {
        dv_setwhy(why, cap, dv_fw_why[0] ? dv_fw_why : "forwarding stub");
        return 1;
    }
    dv_setwhy(why, cap, "forwarding increment refused");
    return 1;
}

static int dv_run_lower(const char *route, const char *tgt, const char *src, int cx,
                        int level, int nsrc, unsigned char *in, long inn,
                        unsigned char **out, long *outn, char *why, int cap) {
    unsigned char *e3;
    unsigned char *tape;
    long e3n;
    unsigned long long n;
    unsigned long long at;
    unsigned long long tl;
    unsigned long long cnt;
    unsigned long long ccwc;
    int pr;
    const char *cont;
    if (!out || !outn) {
        free(in);
        return 4;
    }
    *out = 0;
    *outn = 0;
    if (st_extra_put("\0cli/run-forward", (int)(sizeof "\0cli/run-forward" - 1), &dv_funit_one, 1)) {
        free(in);
        dv_setwhy(why, cap, "cli");
        return 1;
    }
    e3 = 0;
    e3n = 0;
    pr = st_span(route, tgt, src, cx, 0, 0, "e3", in, inn, &e3, &e3n, why, cap);
    st_extra_pop();
    if (pr) return pr;
    n = (unsigned long long)e3n;
    if (fw_side_head(e3, n)) {
        free(e3);
        dv_setwhy(why, cap, "forwarding side-car missing");
        return 1;
    }
    at = 7;
    if (us_fw_u64(e3, n, &at, &tl) || us_fw_u64(e3, n, &at, &cnt) || us_fw_u64(e3, n, &at, &ccwc) ||
        fw_side_bad(ccwc, tl, n, at) || tl > 2147483647ULL) {
        free(e3);
        dv_setwhy(why, cap, "forwarding side-car malformed");
        return 1;
    }
    tape = malloc((size_t)tl + 1);
    if (!tape) {
        free(e3);
        dv_setwhy(why, cap, "out of memory");
        return 1;
    }
    if (tl) memcpy(tape, e3 + at, (size_t)tl);
    tape[tl] = 0;
    at = at + tl;
    cont = level ? "e4" : "prune";
    if (cnt == 0) {
        free(e3);
        return st_span(route, tgt, src, cx, 0, cont, 0, tape, (long)tl, out, outn, why, cap);
    }
    if (dv_fwd_stub(e3, n, at, cnt, ccwc, tgt, why, cap)) {
        free(tape);
        free(e3);
        return 1;
    }
    free(e3);
    return dv_fwd_merge(route, tgt, src, cx, level, nsrc, tape, (long)tl, out, outn, why, cap);
}

int dv_main(int argc, char **argv) {
    static CxcState opts;
    char why[128];
    const char *src;
    const char *text;
    const char *shown;
    static char objname[520];
    unsigned char *gotb;
    unsigned char *pkg;
    long gotn;
    long pkgn;
    int i;
    int next;
    int parsed;
    int kind;
    int nsrc;
    int argstart;
    char cont[512];
    char gap[32];
    char preason[128];
    long long t0;
    long long t1;
    src = 0;
    nsrc = 0;
    argstart = argc;
    if (argc < 2) return dv_fail(bx_src_why(0));
    kind = dv_word(argv[1], 0);
    if (kind == 1) return dv_ar(argc, argv);
    if (kind == 2) return dv_as(argc, argv);
    if (kind == 3) return dv_view(argc, argv);
    if (cxc_default_run(&opts, argv, argc, why, 128)) return dv_fail(why);
    i = 1;
    while (i < argc) {
        next = i;
        parsed = cxc_step(&opts, argv, argc, &next, why, 128);
        if (parsed == 0) {
            i = next;
            continue;
        }
        if (parsed == 5 || parsed == 7) return dv_fail(why);
        if (parsed != 1) return dv_fail(why);
        kind = dv_word(argv[i], 0);
        if (kind == 11) {
            text = "0.0.43";
            printf("unisacc %s\n", text);
            return 0;
        }
        if (kind == 12) {
            text = "unisacc FILE [-S|-c|-o FILE|-run]\nDiagnostic, non-stable: --emit-host-symbols FILE (-S/-c/-o, not -run)\nDiagnostic, non-stable: --host-provider FILE (12-byte capability filter; no addresses)\n";
            printf("%s", text);
            return 0;
        }
        if (kind == 13) {
            if (opts.runit) argstart = i + 1;
            break;
        }
        if (opts.runit && src && kind != 20) {
            argstart = i;
            break;
        }
        if (cxm_flag(argv[i])) {
            i = i + 1;
            continue;
        }
        if (bx_opt_dash(argv[i]) == 1) return dv_fail(bx_opt_why(opts.defrun, src));
        if (nsrc >= 64) return dv_fail("too many sources");
        dv_srcv[nsrc] = argv[i];
        if (!src) src = argv[i];
        nsrc = nsrc + 1;
        i = i + 1;
    }
    if (!src) return dv_fail(bx_src_why(0));
    {
        int fr;
        fr = dv_cx_flags(nsrc);
        if (fr >= 0) return fr;
    }
    if (dv_expand(&nsrc)) return 1;
    shown = opts.out;
    gotb = 0;
    gotn = 0;
    pkg = 0;
    pkgn = 0;
    {
        CxtIn in;
        CxtOut outv;
        char why2[512];
        char route[96];
        const char *tgt;
        int mode2;
        int runit2;
        int clear2;
        int need;
        int obj;
        int asmw;
        int rc;
        mode2 = opts.mode;
        need = 0;
        obj = 0;
        asmw = 0;
        rc = cxt_object(opts.mode, opts.sawc, opts.sawS, opts.funit, opts.target, opts.out, 0, &mode2, &need, &obj, &asmw, why2, 512);
        if (rc == 4) {
            fputs(why2, stderr);
            return 1;
        }
        if (rc) return dv_fail(why2);
        tgt = opts.target;
        runit2 = opts.runit;
        clear2 = 0;
        in.mode = mode2;
        in.level = opts.level;
        in.warnings = opts.warnings;
        in.nsources = nsrc;
        in.runit = runit2;
        in.emitbin = opts.emitbin;
        in.deponly = opts.deponly;
        in.src_tape = 0;
        in.src_tapebin = 0;
        in.linking = 0;
        in.single = 0;
        in.exec_restart = 0;
        in.target = tgt;
        in.native = "lnx/x86_64";
        in.linked_target = 0;
        in.only_target = 0;
        outv.target = &tgt;
        outv.mode = &mode2;
        outv.runit = &runit2;
        outv.clear_deps = &clear2;
        rc = cxt_decide(&in, &outv, why2, 512);
        if (rc == 4) {
            fputs(why2, stderr);
            return 1;
        }
        if (rc) return dv_fail(why2);
        if (bx_diag_opt(opts.host_symbols_path, opts.host_provider_path, hb_target_id(tgt), mode2, opts.emitbin, asmw))
            return dv_fail("bind: diagnostic option mode/target not supported");
        if (bx_diag_run(opts.host_symbols_path, runit2))
            return dv_fail("bind: --emit-host-symbols cannot be used with -run or stdout");
        rc = cxt_text(tgt, mode2, nsrc, opts.warnings, opts.level, route, 96, why2, 512);
        if (rc) return dv_fail(why2);
        if (need) {
            rc = cxd_default_target(src, objname, 520, why2, 512);
            if (rc) return dv_fail(why2);
            shown = objname;
        }
        (void)shown;
        (void)obj;
        {
            char reason[128];
            char line[512];
            int act;
            const char *shown_in;
            t0 = hs_ns();
            rc = cxi_read(src, &gotb, &gotn, reason, 128);
            t1 = hs_ns();
            dv_time("read", t0, t1);
            act = bx_read_act(rc);
            if (act == 1) {
                if (bx_read_open_line(src, reason, line, 512) == 0) fputs(line, stderr);
                else fprintf(stderr, "unisacc: error: cannot open %s%s%s\n", src, reason[0] ? ": " : "", reason);
                return 1;
            }
            if (act == 2) {
                shown_in = bx_read_stdin(src) == 1 ? "stdin" : src;
                if (bx_read_fail_line(shown_in, line, 512) == 0) fputs(line, stderr);
                else fprintf(stderr, "run: cannot read %s\n", shown_in);
                fputs("run: cannot read input\n", stderr);
                return 1;
            }
            if (act) {
                fprintf(stderr, "run: %s\n", bx_read_die(act));
                return 1;
            }
            if (gotn > 2147483647L) {
                free(gotb);
                fprintf(stderr, "run: %s\n", bx_read_die(4));
                return 1;
            }
        }
        if (ex_touch()) {
            free(gotb);
            fputs("unisacc: model driver: alu\n", stderr);
            return 1;
        }
        if (bd_touch()) {
            free(gotb);
            fputs("unisacc: model driver: bind\n", stderr);
            return 1;
        }
        if (st_touch()) {
            free(gotb);
            fputs("unisacc: model driver: stages\n", stderr);
            return 1;
        }
        if (hs_container(cont, 512, argv[0], preason, 128)) {
            free(gotb);
            fprintf(stderr, "unisacc: model driver: package %s\n", preason[0] ? preason : "cannot open");
            return 1;
        }
        if (hs_read(cont, &pkg, &pkgn, preason, 128)) {
            free(gotb);
            fprintf(stderr, "unisacc: model driver: package cannot open %s; set UNISA_CONTAINER=/path/to/unisacc.com\n", cont);
            return 1;
        }
        t0 = hs_ns();
        rc = pm_open(pkg, pkgn, preason, 128);
        t1 = hs_ns();
        dv_time("package", t0, t1);
        if (rc) {
            free(pkg);
            free(gotb);
            fprintf(stderr, "unisacc: model driver: %s\n", preason[0] ? preason : "package");
            return 1;
        }
        if (st_gap(mode2, opts.level, gap, 32)) {
            pm_close();
            free(pkg);
            free(gotb);
            return 1;
        }
        if (!strcmp(gap, "e2")) {
            if (dv_cli(tgt, src, dv_cx(src))) {
                pm_close();
                free(pkg);
                free(gotb);
                fputs("unisacc: model driver: cli\n", stderr);
                return 1;
            }
            const unsigned char *mb;
            unsigned char *body;
            long mn;
            long bodyn;
            int raw;
            int compressed;
            unsigned crcsum;
            int pr;
            mb = 0;
            body = 0;
            mn = 0;
            bodyn = 0;
            raw = 0;
            compressed = 0;
            crcsum = 0;
            pr = pm_model(route, "e2", &mb, &mn, &raw, &crcsum, &compressed);
            if (pr) {
                pm_close();
                free(pkg);
                free(gotb);
                fputs("unisacc: model driver: e2 model\n", stderr);
                return 1;
            }
            pr = ex_pp(mb, mn, raw, crcsum, compressed, gotb, (int)gotn, src, &body, &bodyn, preason, 128);
            pm_close();
            free(pkg);
            free(gotb);
            if (pr) {
                fprintf(stderr, "unisacc: model driver: %s\n", preason[0] ? preason : "e2");
                return 2;
            }
            if (bodyn && fwrite(body, 1, (size_t)bodyn, stdout) != (size_t)bodyn) {
                free(body);
                return 1;
            }
            free(body);
            return 0;
        }
        st_attr_reset();
        st_extra_reset();
        if (mode2 == 3 && nsrc >= 1) {
            if (dv_bind_args(argc, argv, argstart, src) ||
                st_extra_put("\0process/argc", 13, dv_argc_b, 8) ||
                st_extra_put("\0process/argv", 13, dv_argv_b, 8)) {
                free(gotb);
                fputs("unisacc: model driver: argv\n", stderr);
                return 1;
            }
        }
        if (nsrc > 1) {
            unsigned char *framed;
            long framedn;
            int ur;
            framed = 0;
            framedn = 0;
            free(gotb);
            gotb = 0;
            gotn = 0;
            ur = dv_units(tgt, nsrc, &framed, &framedn, preason, 128);
            if (ur == 5) {
                pm_close();
                free(pkg);
                return 1;
            }
            if (ur == 3) {
                pm_close();
                free(pkg);
                fprintf(stderr, "route=%s/unit\n", tgt);
                fprintf(stderr, "NOT_IMPLEMENTED units\n");
                return 2;
            }
            if (ur) {
                pm_close();
                free(pkg);
                if (!preason[0]) {
                    if (ur == 1 || ur == 2 || ur == 3) return ur;
                    return 1;
                }
                fprintf(stderr, "unisacc: model driver: %s\n", preason);
                return ur == 2 ? 2 : 1;
            }
            gotb = framed;
            gotn = framedn;
        }
        {
            unsigned char *body;
            long bodyn;
            int pr;
            const char *dest;
            int wr;
            body = 0;
            bodyn = 0;
            if (mode2 == 3)
                pr = dv_run_lower(route, tgt, src, dv_cx(src), opts.level, nsrc,
                                  gotb, gotn, &body, &bodyn, preason, 128);
            else
                pr = st_span(route, tgt, src, dv_cx(src), 0, 0, 0, gotb, gotn, &body, &bodyn, preason, 128);
            if (pr == 3) {
                pm_close();
                free(pkg);
                fprintf(stderr, "route=%s\n", route);
                fprintf(stderr, "NOT_IMPLEMENTED %s\n", gap);
                return 2;
            }
            if (pr) {
                pm_close();
                free(pkg);
                if (!preason[0]) {
                    if (pr == 1 || pr == 2 || pr == 3) return pr;
                    return 1;
                }
                fprintf(stderr, "unisacc: model driver: %s\n", preason);
                return pr == 2 ? 2 : 1;
            }
            if (mode2 == 3 && nsrc >= 1) {
                unsigned char *base;
                long reserved;
                int code;
                int mr;
                base = 0;
                reserved = 0;
                code = 0;
                if (hs_reserve(&base, &reserved)) {
                    pm_close();
                    free(pkg);
                    free(body);
                    fputs("unisacc: model driver: cannot reserve native memory\n", stderr);
                    return 1;
                }
                mr = dv_memory(tgt, src, dv_cx(src), body, bodyn, base, reserved, preason, 128, &code);
                pm_close();
                free(pkg);
                if (mr == 3) {
                    hs_release(base, reserved);
                    fprintf(stderr, "route=%s/memory\n", tgt);
                    fprintf(stderr, "NOT_IMPLEMENTED %s\n", gap);
                    return 2;
                }
                if (mr) {
                    hs_release(base, reserved);
                    fprintf(stderr, "unisacc: model driver: %s\n", preason[0] ? preason : "memory");
                    fprintf(stderr, "route=%s/memory\n", tgt);
                    return mr == 2 ? 2 : 1;
                }
                return code;
            }
            pm_close();
            free(pkg);
            if (mode2 == 2 || mode2 == 0) {
                dest = shown;
                if (!dest || !dest[0] || !strcmp(dest, "-")) dest = 0;
                wr = hs_write_out(dest, body, bodyn, preason, 128);
                free(body);
                if (wr) {
                    fprintf(stderr, "unisacc: model driver: %s\n", preason[0] ? preason : "cannot open output");
                    return 1;
                }
                return 0;
            }
            free(body);
            fprintf(stderr, "route=%s\n", route);
            fprintf(stderr, "NOT_IMPLEMENTED %s\n", gap);
            return 2;
        }
    }
}
