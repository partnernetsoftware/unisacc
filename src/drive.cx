/* Layouts match cx/driver/cli.cx, compat.cx, and route.cx. Those modules
   are other objects; this file only names their functions. */
typedef struct {
    unsigned char **defs;
    unsigned char **undefs;
    unsigned char **forced;
    unsigned char **incdir;
    unsigned char **quotedir;
    unsigned char **errorlimit;
    long *defs_n;
    long *undefs_n;
    long *forced_n;
    long *incdir_n;
    long *quotedir_n;
    long *error_n;
    long *defs_cap;
    long *undefs_cap;
    long *forced_cap;
    long *incdir_cap;
    long *quotedir_cap;
    long *error_cap;
    const char *last_include;
} CxcResources;
typedef struct {
    int (*record)(unsigned char **, long *, long *, const char *, char *, long);
    int (*line)(unsigned char **, long *, long *, const char *, char *, long);
    int (*cancel)(unsigned char **, long *, const char *, char *, long);
} CxcOps;
typedef struct {
    const char *out;
    const char *target;
    const char *pkg;
    const char *deps;
    const char *host_symbols_path;
    const char **deptargets;
    int *depquoted;
    int deptarget_cap;
    int ndeptargets;
    int mode;
    int level;
    int explicit_image;
    int runit;
    int force_origin;
    int emitbin;
    int deponly;
    int depphony;
    int sawc;
    int sawS;
    int funit;
    int warnings;
    int defrun;
    int werror;
    int nostd;
    int notrim;
    CxcResources *res;
    CxcOps *ops;
} CxcState;
typedef struct {
    char **libs;
    int *n;
    int cap;
} CxpState;
typedef struct {
    int mode;
    int level;
    int warnings;
    int nsources;
    int runit;
    int emitbin;
    int deponly;
    int src_tape;
    int src_tapebin;
    int linking;
    int single;
    int exec_restart;
    const char *target;
    const char *native;
    const char *linked_target;
    const char *only_target;
} CxtIn;
typedef struct {
    const char **target;
    int *mode;
    int *runit;
    int *clear_deps;
} CxtOut;
/* Command walk, route text, then the model chain.
   as, nm, objdump, and ar are src/driveface.cx. Forward lowering is
   src/driveroute.cx. This file calls those four by name. A -run whose
   side-car lists host functions finishes on the image route and
   hs_forward_exec replaces this process.
   A missing model step prints NOT_IMPLEMENTED and the stop name.
   ar members go through cxr_append and cxr_member. as, nm, and objdump
   stay on the tools already wired. -cx-plan and -cx-interface return
   through cxm_planprint and cxm_interface. -D/-U/-I/-include fill the
   caller-owned args blocks. -l/-L/-x go through cxp_step into the
   caller-owned library list. executor and packmodel are linked from
   src/entryexec.cx; this file calls them by name. A .tape source is tapecheck, then the
   backend from prune or e4. A .tapebin that is not a container, or whose
   digest does not match, or whose directory or records do not line up,
   is the product refusal. A package that passes is canonical tape text
   and then follows the tape route. Object inputs (.o .obj .a) are joined
   in src/drivelink.cx into one tape before that route, and dv_link_objects
   is called there with this file's source vector. The join calls the
   tapelink object; neither file compiles that module into its unit. */

static int dv_fail(const char *s) {
    char line[512];
    int bx_cli_line(const char *, char *, int);
    if (!s) return 1;
    if (bx_cli_line(s, line, 512) == 0) {
        fputs(line, stderr);
        return 1;
    }
    fprintf(stderr, "unisacc: model driver: %s\n", s);
    return 1;
}
static void dv_time(const char *phase, long long a, long long b) {
    const char *env;
    env = getenv("UNISACC_RR_TIME");
    if (!env || !env[0] || a < 0 || b < 0 || !phase || phase[0] != 'p') return;
    fprintf(stderr, "RR_TIME\tconstruction\tns=%lld\n", b - a > 0 ? b - a : 1);
}
static const unsigned char dv_cxh[] = "cx.h";
static unsigned char *dv_defs;
static unsigned char *dv_undefs;
static unsigned char *dv_forced;
static unsigned char *dv_incdir;
static unsigned char *dv_quotedir;
static unsigned char *dv_errb;
static unsigned char *dv_withcx;
static long dv_defs_n, dv_defs_cap;
static long dv_undefs_n, dv_undefs_cap;
static long dv_forced_n, dv_forced_cap;
static long dv_incdir_n, dv_incdir_cap;
static long dv_quotedir_n, dv_quotedir_cap;
static long dv_err_n, dv_err_cap;
static long dv_withcx_n, dv_withcx_cap;
static CxcResources dv_res;
static CxcOps dv_ops;
static const char *dv_srcv[DV_MAXU];
static int dv_put_key(const char *key, int kn, const unsigned char *b, long n) {
    int hs_cli_put(const unsigned char *, int, const unsigned char *, int);
    if (n <= 0) return 0;
    if (n > 2147483647L) return 1;
    return hs_cli_put((const unsigned char *)key, kn, b, (int)n);
}
static int dv_cxbase(void) {
    char why[96];
    int st_includebase(const unsigned char *, int); int cxa_raw(unsigned char **, long *, long *, const unsigned char *, long, char *, long);
    if (st_includebase(0, 0)) return 1;
    dv_withcx_n = 0;
    if (cxa_raw(&dv_withcx, &dv_withcx_n, &dv_withcx_cap, dv_cxh, sizeof dv_cxh, why, 96) ||
        (dv_forced_n > 0 && cxa_raw(&dv_withcx, &dv_withcx_n, &dv_withcx_cap, dv_forced, dv_forced_n, why, 96))) return 1;
    return dv_withcx_n > 2147483647L ? 1 : st_includebase(dv_withcx, (int)dv_withcx_n);
}
static int dv_cli(const char *tgt, const char *src, int cx, int nostd) {
    int n;
    int hs_cli_reset(void); int sy_setenv(const char *, const char *, int); int st_includebase(const unsigned char *, int);
    int hs_cli_put(const unsigned char *, int, const unsigned char *, int);
    if (!tgt || !src) return 4;
    if (hs_cli_reset() || (cx ? dv_cxbase() : st_includebase(0, 0)) || (nostd && sy_setenv("UNISA_NOSTDINC", "1", 1))) return 1;
    n = dv_len(tgt);
    if (hs_cli_put((const unsigned char *)"\0cli/target", 11, (const unsigned char *)tgt, n)) return 1;
    n = dv_len(src);
    if (hs_cli_put((const unsigned char *)"\0cli/source", 11, (const unsigned char *)src, n + 1)) return 1;
    if (dv_put_key("\0cli/defines", 12, dv_defs, dv_defs_n)) return 1;
    if (dv_put_key("\0cli/undefines", 14, dv_undefs, dv_undefs_n)) return 1;
    if (dv_put_key("\0cli/includes", 13, cx ? dv_withcx : dv_forced, cx ? dv_withcx_n : dv_forced_n)) return 1;
    if (dv_put_key("\0cli/include-dir", 16, dv_incdir, dv_incdir_n)) return 1;
    if (dv_put_key("\0cli/quote-dir", 14, dv_quotedir, dv_quotedir_n)) return 1;
    if (dv_put_key("\0cli/error-limit", 16, dv_errb, dv_err_n)) return 1;
    return 0;
}
static unsigned char dv_argc_b[8];
static unsigned char dv_argv_b[8];
static char **dv_runargs;
/* One byte 1. The product publishes this for \0cli/object and \0cli/funit. */
static unsigned char dv_one = 1;

/* Rebuild the attribute table in restart order and splice the stub frame
   after the first unit. ccw is published before the stub compile. */
/* Finish the run once the model chain produced `body`: the tokens route writes
   the text tape to stdout, the object/exec/image routes write a file through
   ex_ri_emit, and every other mode is a named NOT_IMPLEMENTED stop. Split out of
   dv_main (C44-PACKAGE-01): dv_main keeps the routing, this keeps the output
   contract. Returns the process exit code. */
/* -run finishes on this process: either the forward image is exec'd in place
   (execf) or the memory-image route builds and runs the image here. Every path
   closes the package first. Split out of dv_main (C44-PACKAGE-01): the caller
   has already established mode2 == 3 && nsrc >= 1. */
/* Read the source (unless a tape is already present), validate a .tapebin,
   publish UNISA_CONTAINER from -p, and resolve the container. Any failure prints
   and asks the caller to exit 1. Split out of dv_main (C44-PACKAGE-01). */
/* Parse the command line, answer --version/--help, and expand the source list.
   Returns -1 to continue with the routing, or the process exit code (0 for
   --version/--help, which do stop). Split out of dv_main (C44-PACKAGE-01). */
/* Object inputs are joined into one tape before the tape route: every source
   must be an object, then dv_link_objects builds the tape. Split out of dv_main
   (C44-PACKAGE-01); returns 1 when the caller must stop. */
static int dv_link_objects_route(const char *src, char **srcv, int *nsrcp,
                                 unsigned char **gotb, long *gotn, int *as_tape) {
    int cxp_object_path(const char *); int dv_fail(const char *);
    int dv_link_objects(int, char **, unsigned char **, long *);
    int j;
    j = 0;
    while (j < *nsrcp) {
        if (!cxp_object_path(srcv[j]))
            return dv_fail("mix of objects and sources: compile each source with -c -b os/arch -funit first");
        j = j + 1;
    }
    if (dv_link_objects(*nsrcp, srcv, gotb, gotn)) return 1;
    *nsrcp = 1;
    *as_tape = 1;
    return 0;
}

static int dv_parse(CxcState *opts, char **argv, int argc, char *why,
                    const char **srcp, int *nsrcp, int *argstartp) {
    /* Local prototypes: a .cx module refuses a top-level declaration it does not define. */
    char **fwd_lib_slot(void); int *fwd_lib_count(void);
    int dv_parse_args(CxcState *, CxpState *, const char **, int *, const char **, int *, char *, int, char **, int, int, int (*)(const char *));
    int ex_ri_say(const char *, const char *);
    int dv_fail(const char *); const char *bx_src_why(const char *);
    int dv_cx_flags(int, const char **, unsigned char **, int);
    int cxp_object_path(const char *); int cxp_tapebin_path(const char *); int cxp_tape_path(const char *);
    int dv_expand(int *, const char **, int); void cxc_object_defaults(CxcState *, const char *);
    CxpState compat;
    int kind; int fr; const char *text;
    compat.libs = fwd_lib_slot(); compat.n = fwd_lib_count(); compat.cap = 16;
    kind = dv_parse_args(opts, &compat, dv_srcv, nsrcp, srcp, argstartp, why, argc, argv, &opts->runit, &opts->defrun, dv_fail);
    /* 11 is --version, 12 is --help: both stop with one line of text. */
    if (kind == 11 || kind == 12) {
        text = kind == 11 ? "0.0.47" : "unisacc FILE [-S|-c|-o FILE|-run]\nDiagnostic, non-stable: --emit-host-symbols FILE (-S only; ignored with -c and -o)\n";
        return kind == 11 ? ex_ri_say("unisacc %s\n", text) : ex_ri_say("%s", text);
    }
    if (kind == 1) return 1;
    if (!*srcp) return dv_fail(bx_src_why(0));
    fr = dv_cx_flags(*nsrcp, dv_srcv, dv_forced, dv_forced_n);
    if (fr >= 0) return fr;
    cxc_object_defaults(opts, tn_self());
    if (!cxp_object_path(*srcp) && !cxp_tapebin_path(*srcp) && !cxp_tape_path(*srcp))
        if (dv_expand(nsrcp, dv_srcv, opts->funit)) return 1;
    return 0 - 1;   /* not an exit code: carry on with the routing */
}

static int dv_read_input(const char *src, const char *tgt, int *as_tape,
                         unsigned char **gotb, long *gotn, const char *argv0,
                         const char *pkg, char *cont, int contcap, char *preason) {
    /* Local prototypes: a .cx module refuses a top-level declaration it does not define. */
    long long hs_ns(void); int cxi_read(const char *, unsigned char **, long *, char *, long);
    int bx_read_act(int); int bx_read_open_line(const char *, const char *, char *, int);
    int bx_read_stdin(const char *); int bx_read_fail_line(const char *, char *, int);
    const char *bx_read_die(int); int cxp_tapebin_path(const char *);
    int dv_tapebin_check(const char *, const char *, unsigned char **, long *, int *);
    int sy_setenv(const char *, const char *, int); int hs_container(char *, int, const char *, char *, int);
    int dv_fail(const char *); void dv_time(const char *, long long, long long);
    if (!*as_tape) {
        char reason[128]; char line[512]; const char *shown_in;
        int act; int rc; long long t0; long long t1;
        t0 = hs_ns(); rc = cxi_read(src, gotb, gotn, reason, 128); t1 = hs_ns();
        dv_time("read", t0, t1); act = bx_read_act(rc);
        if (act == 1) {
            if (bx_read_open_line(src, reason, line, 512) == 0) fputs(line, stderr);
            else fprintf(stderr, "unisacc: error: cannot open %s%s%s\n", src, reason[0] ? ": " : "", reason);
            return 1;
        }
        if (act == 2) {
            shown_in = bx_read_stdin(src) == 1 ? "stdin" : src;
            if (bx_read_fail_line(shown_in, line, 512) == 0) fputs(line, stderr);
            else fprintf(stderr, "run: cannot read %s\n", shown_in);
            fputs("run: cannot read input\n", stderr); return 1;
        }
        if (act) { fprintf(stderr, "run: %s\n", bx_read_die(act)); return 1; }
        if (*gotn > 2147483647L) { free(*gotb); fprintf(stderr, "run: %s\n", bx_read_die(4)); return 1; }
    }
    if (cxp_tapebin_path(src)) {
        int binrc; binrc = dv_tapebin_check(src, tgt, gotb, gotn, as_tape);
        if (binrc) return dv_fail(binrc == 2 ? "reject: tape truncated" : "invalid tapebin or origin target mismatch");
    }
    sy_setenv("UNISA_CONTAINER", pkg ? pkg : "", pkg && pkg[0] ? 1 : 0);
    if (hs_container(cont, contcap, argv0, preason, 128)) {
        free(*gotb);
        fprintf(stderr, "unisacc: model driver: package %s\n", preason[0] ? preason : "cannot open");
        return 1;
    }
    return 0;
}

static int dv_run_route(int execf, unsigned char *body, long bodyn, char **runargs,
                        unsigned char *pkg, const char *tgt, const char *src,
                        char *preason, const char *gap) {
    /* Local prototypes: a .cx module refuses a top-level function declaration
       that the module does not define. */
    int pm_close(void);
    int hs_reserve(unsigned char **, long *);
    int hs_release(unsigned char *, long);
    int dv_store_exec(const unsigned char *, long, char **);
    int dv_memory(const char *, const char *, int, unsigned char *, long,
                  unsigned char *, long, char *, int, int *);
    int dv_cx(const char *);
    unsigned char *base;
    long reserved;
    int code;
    int mr;
    if (execf) {
        code = dv_store_exec(body, bodyn, runargs);
        pm_close();
        free(pkg);
        free(body);
        return code;
    }
    base = 0;
    reserved = 0;
    code = 0;
    if (hs_reserve(&base, &reserved)) {
        pm_close();
        free(pkg);
        free(body);
        fputs("unisacc: model driver: cannot reserve native memory\n", stderr);
        return 1;
    }
    mr = dv_memory(tgt, src, dv_cx(src), body, bodyn, base, reserved, preason, 128, &code);
    pm_close();
    free(pkg);
    if (mr == 3) {
        hs_release(base, reserved);
        fprintf(stderr, "route=%s/memory\n", tgt);
        fprintf(stderr, "NOT_IMPLEMENTED %s\n", gap);
        return 2;
    }
    if (mr) {
        hs_release(base, reserved);
        fprintf(stderr, "unisacc: model driver: %s\n", preason[0] ? preason : "memory");
        fprintf(stderr, "route=%s/memory\n", tgt);
        return mr == 2 ? 2 : 1;
    }
    return code;
}

static int dv_finish(int mode2, const char *shown, int runit2, int asmw,
                     unsigned char *body, long bodyn, const char *preason,
                     const char *symbols, const char *tgt, int emitbin,
                     const char *route, const char *gap) {
        /* Local prototypes: a .cx module refuses a top-level function declaration
           that the module does not define, so the names this function calls in
           other units are declared here, the way dv_cli and dv_main do. */
        int ex_ri_emit(const char *, const unsigned char *, long, char *, int, const char *, int);
        int hb_target_id(const char *); int cxp_tapebin_target(const char *);
        int tb_encode(const char *, long, int, unsigned char **, long *); void mm_free(void *);
        const char *dest; int wr; unsigned char *enc; long encn;
    if (mode2 == 4) {
        if (bodyn && fwrite(body, 1, (size_t)bodyn, stdout) != (size_t)bodyn) {
            free(body);
            return 1;
        }
        free(body);
        return 0;
    }
    if (mode2 == 2 || mode2 == 0 || (mode2 == 5 && !asmw)) {
        dest = shown;
        if (mode2 == 0 && !runit2 && (!dest || !dest[0])) dest = "a.out";
        else if (!dest || !dest[0] || tx_eqz(dest, "-")) dest = 0;
        /* --tapebin (-S): encode the tape text body into a UTAPEBIN container
           (origin from the target). Short-circuit keeps the if count flat; on
           encode failure the text tape is emitted unchanged. */
        enc = 0; encn = 0;
        emitbin && mode2 == 2 && tb_encode((const char *)body, bodyn, cxp_tapebin_target(tgt), &enc, &encn) > 0
            && (mm_free(body), body = enc, bodyn = encn, 1);
        /* ex_ri_emit finishes a strict trace before any byte is written.
           Return 2 leaves that refusal on stderr and creates no file.
           Return 1 is a write failure; its reason is already on stderr. */
        wr = ex_ri_emit(dest, body, bodyn, preason, 128, mode2 == 2 ? symbols : 0, hb_target_id(tgt)); { int rc_store_elf(const unsigned char *, long); (void)((!wr && bodyn >= 4 && body[0] == 127 && body[1] == 'E' && body[2] == 'L' && body[3] == 'F') && (rc_store_elf(body, bodyn), 1)); }
        mm_free(body);
        return wr;   /* 0 on success, the writer's code otherwise */
    }
    free(body);
    fprintf(stderr, "route=%s\n", route);
    fprintf(stderr, "NOT_IMPLEMENTED %s\n", gap);
    return 2;
}

int dv_main(int argc, char **argv) {
    static CxcState opts;
    char why[128];
    const char *src; const char *text;
    const char *shown;
    static char objname[520];
    unsigned char *gotb;
    unsigned char *pkg;
    long gotn;
    long pkgn;
    int i;
    int next;
    int parsed;
    int kind;
    int nsrc;
    int argstart;
    int dv_fwd_pass;
    int dv_fwd_exec;
    char cont[512];
    char gap[32];
    char preason[128];
    long long t0;
    long long t1;
/* Names drive.cx calls in other units, declared extern at file scope so
   dv_main stays a control-flow function instead of carrying its own
   prototypes (C44-PACKAGE-01 step 1). */
extern int ex_touch(void); int ex_cap_gate(int *, char **); int ex_ri_arm(const char *, int, const unsigned char *, long); void ex_alu_note(int); int sy_setenv(const char *, const char *, int);
int ex_ri_say(const char *, const char *); int ex_ri_emit(const char *, const unsigned char *, long, char *, int, const char *, int); int ex_ri_die(const char *, int); int ex_ri_argv(int);
extern int pm_open(const unsigned char *, long, char *, int); extern int pm_close(void); extern int pm_model(const char *, const char *, const unsigned char **, long *, int *, unsigned *, int *);
extern int ex_pp(const unsigned char *, long, int, unsigned, int, unsigned char *, int, const char *, unsigned char **, long *, char *, int); extern int dv_ar(int, char **);
extern int dv_as(int, char **); extern int dv_view(int, char **); extern int dv_stream(int, char **);
extern int dv_run_lower(const char *, const char *, const char *, int, int, int, unsigned char *, long, unsigned char **, long *, char *, int, int *, int); extern int dv_run_lower_n(const char *, const char *, const char *, int, int, int, const char *const *, unsigned char *, long, unsigned char **, long *, char *, int, int *, int); extern int dv_fwd_replay(void);
extern const char *dv_fwd_file(void); extern void hs_free(void *); extern int fwd_ccw_on(void); extern char **fwd_lib_slot(void); extern int *fwd_lib_count(void);
extern const char *bx_src_why(const char *); extern int cxc_default_run(CxcState *, char **, int, char *, long);
extern int cxt_object(int, int, int, int, const char *, const char *, int, int *, int *, int *, int *, char *, long); extern int cxp_tape_path(const char *); extern int cxp_tapebin_path(const char *);
extern int cxp_object_path(const char *); extern const char *tl_first_text(void); extern int cxt_decide(const CxtIn *, CxtOut *, char *, long);
extern int bx_diag_opt(const char *, int, int, int, int); extern int hb_target_id(const char *); extern int bx_diag_run(const char *, int);
extern int cxt_text(const char *, int, int, int, int, char *, long, char *, long); extern int cxd_default_target(const char *, char *, long, char *, long); extern long long hs_ns(void);
extern int bd_touch(void); extern int st_touch(void); extern int hs_read(const char *, unsigned char **, long *, char *, int); extern int st_gap(int, int, char *, int); extern int st_attr_reset(void);
extern int st_extra_reset(void); extern int st_extra_put(const char *, int, const unsigned char *, int);
extern int st_dirs(const unsigned char *, int, const unsigned char *, int, const unsigned char *, int); int st_includebase(const unsigned char *, int); int cxm_on_now(void);
extern int st_span(const char *, const char *, const char *, int, unsigned, const char *, const char *, unsigned char *, long, unsigned char **, long *, char *, int);
extern int ex_ri_hit(const unsigned char *, long, char **); extern int rc_open(const char *, int, char **, const char **, int, const char *, int, int, int, int, int);
extern int rc_lookup_elf(unsigned char **, long *); extern int rc_arm(void); extern int cxa_record(unsigned char **, long *, long *, const char *, char *, long);
extern int cxa_line(unsigned char **, long *, long *, const char *, char *, long); extern int cxa_cancel(unsigned char **, long *, const char *, char *, long);
    src = 0; nsrc = 0; argstart = argc;
    if ((kind = ex_cap_gate(&argc, argv)) != 0) return kind == 2 ? 2 : dv_fail(bx_src_why(0));
    kind = dv_word(argv[1], 0);
    if (kind == 1) return dv_ar(argc, argv);
    if (kind == 2) return dv_as(argc, argv);
    if (kind == 3 || kind == 5) return kind == 3 ? dv_view(argc, argv) : dv_stream(argc, argv);
    if (cxc_default_run(&opts, argv, argc, why, 128)) return dv_fail(why);
    dv_defs_n = 0; dv_undefs_n = 0; dv_forced_n = 0;
    dv_incdir_n = 0; dv_quotedir_n = 0; dv_err_n = 0;
    /* The parser and the include machinery write through these pointers;
       both structures are file-scope statics filled once per run. */
    dv_ops.record = cxa_record; dv_ops.line = cxa_line; dv_ops.cancel = cxa_cancel;
    dv_res.defs = &dv_defs; dv_res.undefs = &dv_undefs; dv_res.forced = &dv_forced;
    dv_res.incdir = &dv_incdir; dv_res.quotedir = &dv_quotedir; dv_res.errorlimit = &dv_errb;
    dv_res.defs_n = &dv_defs_n; dv_res.undefs_n = &dv_undefs_n; dv_res.forced_n = &dv_forced_n;
    dv_res.incdir_n = &dv_incdir_n; dv_res.quotedir_n = &dv_quotedir_n; dv_res.error_n = &dv_err_n;
    dv_res.defs_cap = &dv_defs_cap; dv_res.undefs_cap = &dv_undefs_cap; dv_res.forced_cap = &dv_forced_cap;
    dv_res.incdir_cap = &dv_incdir_cap; dv_res.quotedir_cap = &dv_quotedir_cap; dv_res.error_cap = &dv_err_cap;
    dv_res.last_include = 0;
    opts.res = &dv_res;
    opts.ops = &dv_ops;
    i = dv_parse(&opts, argv, argc, why, &src, &nsrc, &argstart);
    if (i >= 0) return i;
    shown = opts.out;
    gotb = 0;
    gotn = 0;
    dv_fwd_pass = 0;
    dv_fwd_exec = 0;
    pkg = 0;
    pkgn = 0;
    {
        CxtIn in;
        CxtOut outv;
        char why2[512];
        char route[96];
        const char *tgt;
        int mode2;
        int runit2;
        int clear2;
        int need;
        int obj;
        int asmw;
        int as_tape;
        int image_fwd;
        int rc;
        mode2 = opts.mode;
        need = 0;
        obj = 0;
        asmw = 0;
        as_tape = 0;
        image_fwd = 0;
        rc = cxt_object(opts.mode, opts.sawc, opts.sawS, opts.funit, opts.target, opts.out, cxp_object_path(src), &mode2, &need, &obj, &asmw, why2, 512);
        if (rc == 4) {
            fputs(why2, stderr);
            return 1;
        }
        if (rc) return dv_fail(why2);
        if (cxp_object_path(src) && dv_link_objects_route(src, dv_srcv, &nsrc, &gotb, &gotn, &as_tape)) return 1;
        tgt = opts.target;
        runit2 = opts.runit;
        clear2 = 0;
        in.mode = mode2; in.level = opts.level; in.warnings = opts.warnings; in.nsources = nsrc;
        in.runit = runit2; in.emitbin = opts.emitbin; in.deponly = opts.deponly;
        in.src_tape = cxp_tape_path(src) || as_tape; in.src_tapebin = cxp_tapebin_path(src);
        in.linking = as_tape ? 1 : 0; in.single = 0; in.exec_restart = 0; in.target = tgt;
        in.native = tn_self(); in.linked_target = as_tape ? tl_first_text() : 0; in.only_target = 0;
        outv.target = &tgt; outv.mode = &mode2; outv.runit = &runit2; outv.clear_deps = &clear2;
        rc = cxt_decide(&in, &outv, why2, 512);
        if (rc == 4) {
            fputs(why2, stderr);
            return 1;
        }
        if (rc) return dv_fail(why2);
        if (bx_diag_opt(opts.host_symbols_path, hb_target_id(tgt), mode2, opts.emitbin, asmw))
            return dv_fail("bind: diagnostic option mode/target not supported");
        if (bx_diag_run(opts.host_symbols_path, runit2))
            return dv_fail("bind: --emit-host-symbols cannot be used with -run or stdout");
        rc = cxt_text(tgt, mode2, nsrc, opts.warnings, opts.level, route, 96, why2, 512);
        if (rc) return dv_fail(why2);
        /* osx, lnx, and win images forward host calls. Objects, tapes, and
           -E never reach this with mode 0. The second pass keeps the stub. */
        if (mode2 == 0 && !as_tape && !opts.emitbin && tgt && !cxp_tape_path(src) &&
            ((tgt[0] == 'o' && tgt[1] == 's' && tgt[2] == 'x' && tgt[3] == '/') ||
             (tgt[0] == 'l' && tgt[1] == 'n' && tgt[2] == 'x' && tgt[3] == '/') ||
             (tgt[0] == 'w' && tgt[1] == 'i' && tgt[2] == 'n' && tgt[3] == '/')))
            image_fwd = 1;
        if (need) {
            rc = cxd_default_target(src, objname, 520, why2, 512);
            if (rc) return dv_fail(why2);
            shown = objname;
        }
        (void)shown;
        (void)obj;
        if (dv_read_input(src, tgt, &as_tape, &gotb, &gotn, argv[0], opts.pkg, cont, 512, preason)) return 1;
        /* A cache hit execs the image and skips models. Pass 2 does not look.
           A miss arms the include receipts for the store. */
        if ((mode2 == 3 || mode2 == 0) && nsrc >= 1 && !dv_fwd_pass && !as_tape && !cxp_tape_path(src)) {
            int ready;
            unsigned char *cached;
            long cachedn;
            int code;
            cached = 0;
            cachedn = 0;
            /* -run binds argv into process slots; -o has no program, argstart == argc. */
            if ((code = ex_ri_die(route, mode2)) != 0 || (mode2 == 3 && dv_bind_args(argc, argv, argstart, src, dv_argc_b, dv_argv_b, &dv_runargs))) {
                hs_free(gotb);
                /* code 2 is the route refusal already printed; 0 is the argv bind. */
                return ex_ri_argv(code);
            }
            ready = rc_open(cont, argc, argv, dv_srcv, nsrc, tgt, opts.level, opts.warnings,
                            (as_tape || cxp_tape_path(src)) ? 1 : 0, opts.deponly, mode2);
            if (ready && rc_lookup_elf(&cached, &cachedn) == 1) {
                code = mode2 == 3 ? ex_ri_hit(cached, cachedn, dv_runargs) : ex_ri_emit(opts.out && opts.out[0] ? opts.out : "a.out", cached, cachedn, preason, 128, 0, hb_target_id(tgt));
                hs_free(cached);
                hs_free(gotb);
                return code;
            }
            if (ready) (void)rc_arm();
        }
        if ((rc = ex_ri_arm(route, mode2, gotb, gotn)) != 0 || ex_touch()) {
            free(gotb);
            ex_alu_note(rc);
            return rc ? rc : 1;
        }
        if (bd_touch()) {
            free(gotb);
            fputs("unisacc: model driver: bind\n", stderr);
            return 1;
        }
        if (st_touch()) {
            free(gotb);
            fputs("unisacc: model driver: stages\n", stderr);
            return 1;
        }
        if (hs_read(cont, &pkg, &pkgn, preason, 128)) {
            free(gotb);
            fprintf(stderr, "unisacc: model driver: package cannot open %s; set UNISA_CONTAINER=/path/to/unisacc.com\n", cont);
            return 1;
        }
        t0 = hs_ns();
        rc = pm_open(pkg, pkgn, preason, 128);
        t1 = hs_ns();
        dv_time("package", t0, t1);
        if (rc) {
            free(pkg);
            free(gotb);
            fprintf(stderr, "unisacc: model driver: %s\n", preason[0] ? preason : "package");
            return 1;
        }
        if (st_gap(mode2, opts.level, gap, 32)) {
            pm_close();
            free(pkg);
            free(gotb);
            return 1;
        }
        if (tx_eqz(gap, "e2")) {
            if (dv_cli(tgt, src, dv_cx(src), opts.nostd)) {
                pm_close();
                free(pkg);
                free(gotb);
                fputs("unisacc: model driver: cli\n", stderr);
                return 1;
            }
            const unsigned char *mb;
            unsigned char *body;
            long mn;
            long bodyn;
            int raw;
            int compressed;
            unsigned crcsum;
            int pr;
            mb = 0;
            body = 0;
            mn = 0;
            bodyn = 0;
            raw = 0;
            compressed = 0;
            crcsum = 0;
            pr = pm_model(route, "e2", &mb, &mn, &raw, &crcsum, &compressed);
            if (pr) {
                pm_close();
                free(pkg);
                free(gotb);
                fputs("unisacc: model driver: e2 model\n", stderr);
                return 1;
            }
            pr = ex_pp(mb, mn, raw, crcsum, compressed, gotb, (int)gotn, src, &body, &bodyn, preason, 128);
            pm_close();
            free(pkg);
            free(gotb);
            if (pr) {
                fprintf(stderr, "unisacc: model driver: %s\n", preason[0] ? preason : "e2");
                return 2;
            }
            if (bodyn && fwrite(body, 1, (size_t)bodyn, stdout) != (size_t)bodyn) {
                free(body);
                return 1;
            }
            free(body);
            return 0;
        }
        st_attr_reset();
        st_extra_reset();
        if ((dv_forced_n > 0 && (dv_cx(src) || cxm_on_now()) ? dv_cxbase() : st_includebase(0, 0)) || (obj && st_extra_put("\0cli/object", 11, &dv_one, 1)) ||
            (opts.funit && st_extra_put("\0cli/funit", 10, &dv_one, 1)) ||
            (dv_defs_n > 0 && st_extra_put("\0cli/defines", 12, dv_defs, (int)dv_defs_n)) ||
            (dv_forced_n > 0 && !dv_cx(src) && st_extra_put("\0cli/includes", 13, dv_forced, (int)dv_forced_n)) ||
            (opts.nostd && st_extra_put("\0cli/nostdinc", 13, &dv_one, 1)) ||
            st_dirs(dv_incdir, (int)dv_incdir_n, dv_quotedir, (int)dv_quotedir_n, dv_errb, (int)dv_err_n)) {
            pm_close();
            free(pkg);
            free(gotb);
            fputs("unisacc: model driver: cli\n", stderr);
            return 1;
        }
dv_replay:
        /* Args were bound before the package was opened, on pass 1.
           The slots are published again here so e3 still sees them.
           The image ELF is built only after they are popped. */
        if (mode2 == 3 && nsrc >= 1) {
            if (st_extra_put("\0process/argc", 13, dv_argc_b, 8) ||
                st_extra_put("\0process/argv", 13, dv_argv_b, 8)) {
                free(gotb);
                fputs("unisacc: model driver: argv\n", stderr);
                return 1;
            }
        }
        /* Single-source restart compiles every unit with ccw already published.
           A multi-source restart does not come back here. */
        if (dv_fwd_pass && fwd_ccw_on() && st_extra_put("\0cli/ccw", 8, &dv_one, 1)) {
            pm_close();
            hs_free(pkg);
            hs_free(gotb);
            fputs("unisacc: model driver: cli\n", stderr);
            return 1;
        }
        if (nsrc > 1) {
            unsigned char *framed;
            long framedn;
            int ur;
            framed = 0;
            framedn = 0;
            free(gotb);
            gotb = 0;
            gotn = 0;
            ur = dv_units(tgt, nsrc, dv_srcv, &framed, &framedn, preason, 128);
            if (ur == 5) {
                pm_close();
                free(pkg);
                return 1;
            }
            if (ur == 3) {
                pm_close();
                free(pkg);
                fprintf(stderr, "route=%s/unit\n", tgt);
                fprintf(stderr, "NOT_IMPLEMENTED units\n");
                return 2;
            }
            if (ur) {
                pm_close();
                free(pkg);
                if (!preason[0]) {
                    if (ur == 1 || ur == 2 || ur == 3) return ur;
                    return 1;
                }
                fprintf(stderr, "unisacc: model driver: %s\n", preason);
                return ur == 2 ? 2 : 1;
            }
            gotb = framed;
            gotn = framedn;
        }
        {
            unsigned char *body;
            long bodyn;
            int pr;
            int execf;
            int lowered;
            body = 0;
            bodyn = 0;
            execf = 0;
            lowered = 0;
            if ((mode2 == 3 || image_fwd) && !dv_fwd_pass && !as_tape && !cxp_tape_path(src)) {
                if (nsrc > 1 && gotb && gotn > 0 && dv_fwd_keep(gotb, gotn)) {
                    pm_close();
                    hs_free(pkg);
                    hs_free(gotb);
                    fputs("unisacc: model driver: cli\n", stderr);
                    return 1;
                }
                lowered = 1;
                /* UNDEF-LINK-RC0: hand the lower stage every unit, not just the first, so its
                   unresolved-extern check sees prototypes declared in later units. */
                pr = dv_run_lower_n(route, tgt, src, dv_cx(src), opts.level, nsrc,
                                    dv_srcv, gotb, gotn, &body, &bodyn, preason, 128, &execf, mode2 != 3);
            }
            else if (as_tape || cxp_tape_path(src)) {
                unsigned char *mid;
                long midn;
                const char *from;
                mid = 0, midn = 0;
                /* -run's argv binds here: the cache branch above skips tapes */
                pr = (mode2 == 3 && dv_bind_args(argc, argv, argstart, src, dv_argc_b, dv_argv_b, &dv_runargs))
                     ? (tx_copy(preason, 128, "argv", 5), 1) : st_span(route, tgt, src, dv_cx(src), 0, "tapecheck", "tapecheck", gotb, gotn, &mid, &midn, preason, 128);
                if (!pr && mode2 != 2) {
                    from = opts.level > 0 ? "e4" : "prune";
                    pr = st_span(route, tgt, src, dv_cx(src), 0, from, 0,
                                 mid, midn, &body, &bodyn, preason, 128);
                } else if (!pr) {
                    body = mid;
                    bodyn = midn;
                }
            } else
                pr = st_span(route, tgt, src, dv_cx(src), 0, 0, 0, gotb, gotn, &body, &bodyn, preason, 128);
            if (lowered && !pr && dv_fwd_replay()) {
                const char *stub;
                int k;
                stub = dv_fwd_file();
                /* The e3 span already freed the input. The stub is inserted
                   after the first source, which is where the restart puts it. */
                gotb = 0;
                gotn = 0;
                if (!stub || nsrc >= DV_MAXU) {
                    dv_hold_drop();
                    pm_close();
                    hs_free(pkg);
                    fprintf(stderr, stub ? "unisacc: model driver: too many sources with forwarding stub (%d, limit %d)\n" : "unisacc: model driver: forwarding stub: cannot create file\n", nsrc, (int)DV_MAXU);
                    return 1;
                }
                k = nsrc;
                while (k > 1) {
                    dv_srcv[k] = dv_srcv[k - 1];
                    k = k - 1;
                }
                dv_srcv[1] = stub;
                nsrc = nsrc + 1;
                dv_fwd_pass = 1;
                /* -run's restart is an image, then forward_exec. -o stays an image write. */
                if (mode2 == 3) {
                    dv_fwd_exec = 1;
                    mode2 = 0;
                    runit2 = 0;
                }
                rc = cxt_text(tgt, mode2, nsrc, opts.warnings, opts.level, route, 96, why2, 512);
                if (rc) {
                    dv_hold_drop();
                    pm_close();
                    hs_free(pkg);
                    return dv_fail(why2);
                }
                if (hf_frames(0)) {
                    pr = dv_fwd_splice(tgt, nsrc, dv_srcv, &gotb, &gotn, preason, 128);
                    if (!pr)
                        pr = st_span(route, tgt, src, dv_cx(src), 0, 0, 0, gotb, gotn, &body, &bodyn, preason, 128);
                } else
                    goto dv_replay;
            } else
                dv_hold_drop();
            if (pr == 3) {
                pm_close();
                free(pkg);
                fprintf(stderr, "route=%s\n", route);
                fprintf(stderr, "NOT_IMPLEMENTED %s\n", gap);
                return 2;
            }
            if (pr) {
                pm_close();
                free(pkg);
                if (!preason[0]) {
                    if (pr == 1 || pr == 2 || pr == 3) return pr;
                    return 1;
                }
                fprintf(stderr, "unisacc: model driver: %s\n", preason);
                return pr == 2 ? 2 : 1;
            }
            if (dv_fwd_exec) {
                int code;
                code = dv_store_exec(body, bodyn, dv_runargs);
                pm_close();
                hs_free(pkg);
                hs_free(body);
                return code;
            }
            if (mode2 == 3 && nsrc >= 1)
                return dv_run_route(execf, body, bodyn, dv_runargs, pkg, tgt, src, preason, gap);
            pm_close();
            free(pkg);
            /* mode 4 is the tokens route: tokenpp then tokenlex, on stdout.
               mode 5 without an assembly path is the object route: the span
               already ran lower and the object ELF stage. Assembly -S stays
               on the old stop until that route is the tape text. */
            return dv_finish(mode2, shown, runit2, asmw, body, bodyn, preason,
                             opts.host_symbols_path, tgt, opts.emitbin, route, gap);
        }
    }
}
