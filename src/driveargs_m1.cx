#pragma unisa module driveargs_m1
#pragma unisa use driver.driveargs_m1_impl
#pragma unisa use entrybind
#pragma unisa use driveutil
#pragma unisa use compiler.cxmod
int dv_word(const char *word, int is_object) { return da_m1_dv_word(word, is_object, dv_cx); }
int dv_parse_args(void *opts, void *compat, char **srcv, int *nsrc, const char **src,
                  int *argstart, char *why, int argc, char **argv,
                  int *runit, int *defrun, int (*fail)(const char *)) {
    DaM1Ops ops = { (int)DV_MAXU, dv_cx, cxm_flag, bx_opt_dash, bx_opt_why, bx_compat_why };
    return da_m1_parse_args(&ops, opts, compat, srcv, nsrc, src, argstart, why, argc, argv, runit, defrun, fail);
}
