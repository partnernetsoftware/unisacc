/* Six image targets, independent container bounds/machine oracles. Only the
 * Linux x86_64 image is executed here. Foreign native execution is NOT_RUN. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
static int assertions,failures;
static void die(const char *s){fprintf(stderr,"formats: %s\n",s);exit(2);}
static void ck(int ok,const char *s){assertions++;if(!ok)failures++;printf("%s\t%s\n",ok?"PASS":"FAIL",s);}
static unsigned long long get(const unsigned char *p,int n){unsigned long long v=0;int i;for(i=n-1;i>=0;i--)v=(v<<8)|p[i];return v;}
static int span(size_t total,unsigned long long at,unsigned long long n){return at<=total&&n<=total-at;}
static int elf(const unsigned char *p,size_t n,int arm){if(n<64||memcmp(p,"\177ELF\2\1\1",7)||get(p+16,2)!=2||get(p+18,2)!=(arm?183:62)||get(p+52,2)!=64||get(p+54,2)!=56)return 0;unsigned long long at=get(p+32,8),count=get(p+56,2),entry=get(p+24,8);int executable=0;if(!count||!span(n,at,count*56))return 0;size_t i;for(i=0;i<count;i++){const unsigned char *q=p+at+i*56;if(get(q,4)!=1)continue;unsigned long long off=get(q+8,8),va=get(q+16,8),files=get(q+32,8),mem=get(q+40,8),align=get(q+48,8);if(!span(n,off,files)||mem<files||(align&&(align&(align-1)))||(align>1&&(off%align!=va%align)))return 0;if((get(q+4,4)&1)&&entry>=va&&entry-va<files)executable=1;}return executable;}
static int macho(const unsigned char *p,size_t n,int arm){if(n<32||get(p,4)!=0xfeedfacfULL||get(p+4,4)!=(arm?0x100000cULL:0x1000007ULL)||get(p+12,4)!=2)return 0;unsigned long long count=get(p+16,4),size=get(p+20,4),at=32;int segments=0;if(!count||!span(n,32,size))return 0;size_t i;for(i=0;i<count;i++){if(!span(n,at,8))return 0;unsigned long long cmd=get(p+at,4),len=get(p+at+4,4);if(len<8||len>32+size-at)return 0;if(cmd==0x19){if(len<72)return 0;unsigned long long off=get(p+at+40,8),files=get(p+at+48,8),mem=get(p+at+32,8),sections=get(p+at+64,4);if(!span(n,off,files)||mem<files||sections>(len-72)/80)return 0;segments++;}at+=len;}return at==32+size&&segments>0;}
static int pe(const unsigned char *p,size_t n,int arm){if(n<64||memcmp(p,"MZ",2))return 0;unsigned long long at=get(p+60,4);if(!span(n,at,24)||memcmp(p+at,"PE\0\0",4)||get(p+at+4,2)!=(arm?0xaa64:0x8664))return 0;unsigned long long count=get(p+at+6,2),opt=get(p+at+20,2);if(opt<112||!span(n,at+24,opt)||get(p+at+24,2)!=0x20b)return 0;unsigned long long entry=get(p+at+40,4);at+=24+opt;if(!count||!span(n,at,count*40))return 0;size_t i;int executable=0;for(i=0;i<count;i++){const unsigned char *q=p+at+i*40;unsigned long long bytes=get(q+16,4),off=get(q+20,4),va=get(q+12,4);if(!span(n,off,bytes))return 0;if((get(q+36,4)&0x20000000)&&entry>=va&&entry-va<bytes)executable=1;}return executable;}
static void path(char *p,size_t cap,const char *a,const char *b){int n=snprintf(p,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path");}
static void digest(const char *p,char *h){size_t n;char *s=cx_read(p,&n);if(!s)die(p);cx_sha256_hex(s,n,h);free(s);}
int main(int argc,char **argv){char root[4096],product[4400],bound[4400],src[4400],image[4400],label[128],before[65],after[65],why[1024];if(argc!=3||!realpath(argv[1],root)||argv[2][0]!='/'||mkdir(argv[2],0700))return 2;path(product,sizeof product,root,"unisacc.com");path(bound,sizeof bound,root,"tools/bound");path(src,sizeof src,argv[2],"return7.c");int f=open(src,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC,0600);const char *source="int main(void){return 7;}\n";if(f<0||write(f,source,strlen(source))!=(ssize_t)strlen(source)||close(f))die("fixture");digest(product,before);
 const char *target[]={"lnx/x86_64","lnx/arm64","osx/x86_64","osx/arm64","win/x86_64","win/arm64"};int i;for(i=0;i<6;i++){char file[40];snprintf(file,sizeof file,"target%d.image",i);path(image,sizeof image,argv[2],file);char *v[]={bound,"12","sh",product,"-O2","-b",(char *)target[i],src,"-o",image,0};np_result r;if(np_run(v,root,0,15,&r,why,sizeof why))die(why);snprintf(label,sizeof label,"image.%s.compile",target[i]);int ok=r.rc==0&&!r.errn;ck(ok,label);if(!ok&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(!ok)continue;size_t n;unsigned char *p=(unsigned char *)cx_read(image,&n);if(!p)die("image read");ok=i<2?elf(p,n,i%2):i<4?macho(p,n,i%2):pe(p,n,i%2);snprintf(label,sizeof label,"image.%s.machine-and-container-bounds",target[i]);ck(ok,label);free(p);if(i==0){char *run[]={bound,"5",image,0};if(np_run(run,root,0,8,&r,why,sizeof why))die(why);ck(r.rc==7&&!r.outn&&!r.errn,"image.lnx/x86_64.independent-return7");np_free(&r);}else printf("NOT_RUN\tnative-host.%s\n",target[i]);}
 digest(product,after);ck(tx_eq(before, after, 1L << 20),"candidate-unchanged");printf("FORMATS\tassertions=%d\tfailed=%d\tscope=six-image-containers-and-one-native-host\n",assertions,failures);return failures?1:0;}
