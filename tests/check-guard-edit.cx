#!/usr/bin/env -S unisacc.com -run
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use text.text
/* check-guard-edit.cx -- .claude/hooks/guard-edit.ts (GUARD-EDIT-V1): each Bash command string is fed to
 * the hook as PreToolUse JSON on stdin and the exit code is asserted (2 = refused, 0 = allowed).
 *   sh ./unisacc.com tests/check-guard-edit.cx -- ROOT TMPDIR
 * Every child runs under tools/bound with a 20 second deadline (rc 142 on expiry, which no case expects). */
typedef struct { const char *name; const char *cmd; int want; } Case;
static const Case cases[] = {
    /* rule a: script interpreters in command position */
    {"py-c", "python3 -c 1", 2},
    {"py-stdin", "python3 -", 2},
    {"py-bare", "python3", 2},
    {"py-plain", "python x.py", 2},
    {"py-after-and", "ls && python3 x.py", 2},
    {"py-after-pipe", "cat f | python3 -", 2},
    {"py-after-semi", "ls; python3 x.py", 2},
    {"py-after-subst", "x=$(python3 -V)", 2},
    {"py-after-backtick", "x=`python3 -V`", 2},
    {"py-env-prefix", "A=1 python3 x.py", 2},
    {"node-cmd", "node x.js", 2},
    {"bun-cmd", "bun run x.ts", 2},
    {"perl-cmd", "perl -e 1", 2},
    {"ruby-cmd", "ruby x.rb", 2},
    {"py-abs-path", "/usr/bin/python3 x.py", 2},
    /* rule a negatives */
    {"which-py", "which python3", 0},
    {"echo-quoted-py", "echo \"python3\"", 0},
    {"echo-single-py", "echo 'python3 -c 1'", 0},
    {"grep-py", "grep -n python3 notes.txt", 0},
    {"git-grep-py", "git grep -n python3 -- tools", 0},
    {"command-v-py", "command -v python3", 0},
    {"hook-bun", "bun .claude/hooks/guard-edit.ts", 0},
    {"hook-bun-env", "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edit.ts\"", 0},
    {"heredoc-py", "cat > /tmp/x.txt <<'EOF'\npython3 -c 1\ngit stash\nEOF", 0},
    /* rule b: destructive git */
    {"git-stash", "git stash", 2},
    {"git-stash-pop", "git stash pop", 2},
    {"git-clean", "git clean -fd", 2},
    {"git-reset-hard", "git reset --hard HEAD", 2},
    {"git-checkout-dd", "git checkout -- tools/x.cx", 2},
    {"git-checkout-dot", "git checkout .", 2},
    {"git-restore-dot", "git restore .", 2},
    {"git-autostash", "git rebase --autostash origin/main", 2},
    {"git-pull-autostash", "git pull --rebase --autostash", 2},
    {"git-C-stash", "git -C /tmp stash", 2},
    {"git-after-and", "ls && git stash pop", 2},
    /* rule b negatives */
    {"log-grep-stash", "git log --grep=stash", 0},
    {"git-grep-stash", "git grep -n stash", 0},
    {"echo-git-stash", "echo \"git stash\"", 0},
    {"reset-soft", "git reset --soft HEAD~1", 0},
    {"checkout-branch", "git checkout main", 0},
    {"restore-one", "git restore tools/x.cx", 0},
    {"status", "git status --short", 0},
    {"pull-rebase", "git pull --rebase", 0},
    /* rule c: --no-verify */
    {"commit-noverify", "git commit --no-verify -m x", 2},
    {"commit-noverify-late", "git commit -m x --no-verify", 2},
    {"push-noverify", "git push --no-verify origin HEAD:main", 2},
    {"commit-n-short", "git commit -n -m x", 0},
    {"commit-plain", "git commit -m x -- tools/a.cx", 0},
    {"push-plain", "git push origin HEAD:main", 0},
    {"msg-noverify-text", "git commit -m \"do not use --no-verify\" -- a", 0},
    /* existing rules do not regress */
    {"sed-i-repo", "sed -i s/a/b/ /home/devali/repos/unisacc/tools/x.cx", 2},
    {"sed-i-tmp", "sed -i s/a/b/ /tmp/x.txt", 0},
    {"redirect-repo", "echo a > /home/devali/repos/unisacc/x.txt", 2},
    {"redirect-tmp", "echo a > /tmp/x.txt", 0},
    {"tee-repo", "echo a | tee /home/devali/repos/unisacc/x.txt", 2},
    {"git-clone", "git clone x y", 2},
    {"wt-ok-rel", "git worktree add .claude/worktrees/v0.0.65 -b v0.0.65", 0},
    {"wt-ok-abs", "git worktree add /home/devali/repos/unisacc/.claude/worktrees/v0.0.65 -b v0.0.65 origin/main", 0},
    {"wt-deny-tmp", "git worktree add /tmp/x", 2},
    {"wt-deny-up", "git worktree add ../x", 2},
    {"wt-deny-name", "git worktree add .claude/worktrees/foo", 2},
    {"plain-ls", "ls -la", 0},
    {"sh-unisacc", "sh ./unisacc.com tools/x.cx -- a", 0},
    {"plain-grep", "grep -rn foo cx | head", 0},
    /* 2026-11-14: repository-root out/ must not be created or written (relative forms, cd prefix, chains) */
    {"out-mkdir-p", "mkdir -p out", 2},
    {"out-mkdir", "mkdir out", 2},
    {"out-mkdir-slash", "mkdir -p ./out/", 2},
    {"out-cp", "cp a out/b", 2},
    {"out-mv", "mv a out/b", 2},
    {"out-touch", "touch out/x", 2},
    {"out-redirect", "echo a > out/x", 2},
    {"out-cd-mkdir", "cd /home/devali/repos/unisacc; mkdir -p out", 2},
    {"out-cd-and-cp", "cd /home/devali/repos/unisacc && cp /tmp/t1.cx out/sp-t1.cx", 2},
    {"out-abs-cp", "cp a /home/devali/repos/unisacc/out/b", 2},
    {"out-tmp-mkdir", "mkdir -p /tmp/unisacc-x/out", 0},
    {"out-tmp-cp", "cp a /tmp/b", 0},
    {"out-tmp-cd-cp", "cd /tmp/w; cp a out/b", 0},
    {"out-read-cp", "cp out/a /tmp/b", 0},
    /* 2026-11-14: cd prefix / sh -c / ex must not bypass in-place edit rules (subagent sed -i incident) */
    {"ip-sed-rel", "sed -i s/a/b/ tools/domain.cx", 2},
    {"ip-sed-long", "sed --in-place s/a/b/ tools/domain.cx", 2},
    {"ip-sed-bak", "sed -i.bak s/a/b/ tools/domain.cx", 2},
    {"ip-perl-pi", "perl -pi -e s/a/b/ tools/domain.cx", 2},
    {"ip-awk-inplace", "awk -i inplace 1 tools/domain.cx", 2},
    {"ip-printf-append", "printf x >> tests/outdep.tsv", 2},
    {"ip-echo-append", "echo x >> tests/outdep.tsv", 2},
    {"ip-tee-rel", "echo x | tee tests/outdep.tsv", 2},
    {"ip-cat-redirect", "cat > tools/x.cx", 2},
    {"ip-cd-sed", "cd /home/devali/repos/unisacc && sed -i s/a/b/ tools/domain.cx", 2},
    {"ip-cd-printf", "cd /home/devali/repos/unisacc && printf x >> tests/outdep.tsv", 2},
    {"ip-cd-sub-sed", "cd /home/devali/repos/unisacc/tools && sed -i s/a/b/ domain.cx", 2},
    {"ip-sh-c-sed", "sh -c 'sed -i s/a/b/ tools/domain.cx'", 2},
    {"ip-bash-c-append", "bash -c \"echo x >> tests/outdep.tsv\"", 2},
    {"ip-ex", "ex -c wq tools/domain.cx", 2},
    {"ip-cd-tmp-sed", "cd /tmp/w && sed -i s/a/b/ x.txt", 0},
    {"ip-sh-c-tmp", "sh -c 'echo x >> /tmp/x.txt'", 0},
    {"ip-sed-read", "sed -n 1,5p tools/domain.cx", 0},
};

static int failed, assertions;
static char tmpdir[4096], outbuf[8192];

static void json_cmd(const char *c, char *o, int cap) {
    int n = 0;
    const char *h = "{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"";
    while (*h && n < cap - 8) o[n++] = *h++;
    for (; *c && n < cap - 8; c++) {
        if (*c == '"' || *c == '\\') { o[n++] = '\\'; o[n++] = *c; }
        else if (*c == '\n') { o[n++] = '\\'; o[n++] = 'n'; }
        else o[n++] = *c;
    }
    h = "\"}}";
    while (*h) o[n++] = *h++;
    o[n] = 0;
}

static int run_hook(const char *root, const char *cmd) {
    char json[4096], jp[4400], sh[9000], bnd[4400], hk[4400];
    char *av[8]; int cut = 0;
    json_cmd(cmd, json, sizeof json);
    if (cx_path_join(jp, sizeof jp, tmpdir, "guard-in.json")) return -1;
    if (cx_write(jp, json, tx_len(json, sizeof json))) return -1;
    if (cx_path_join(bnd, sizeof bnd, root, "tools/bound")) return -1;
    if (cx_path_join(hk, sizeof hk, root, ".claude/hooks/guard-edit.ts")) return -1;
    if (cx_fmt(sh, sizeof sh, "bun %s < %s", hk, jp)) return -1;
    av[0] = bnd; av[1] = "20"; av[2] = "sh"; av[3] = "-c"; av[4] = sh; av[5] = 0;
    return sy_run(av, outbuf, sizeof outbuf, &cut);
}

int main(int argc, char **argv) {
    int i, n = (int)(sizeof cases / sizeof cases[0]);
    if (argc != 3) { fputs("usage: ROOT TMPDIR\n", stderr); return 2; }
    if (cx_fmt(tmpdir, sizeof tmpdir, "%s", argv[2])) return 2;
    sy_mkdir_all(tmpdir, 0700);
    for (i = 0; i < n; i++) {
        int rc = run_hook(argv[1], cases[i].cmd);
        int ok = rc == cases[i].want;
        assertions++;
        if (!ok) failed++;
        printf("%s\t%s\twant=%d\tgot=%d\n", ok ? "PASS" : "FAIL", cases[i].name, cases[i].want, rc);
    }
    /* write-domain branch (tools/domain.cx registry): Edit/Write refused only when UNISACC_AGENT is set and another agent holds the path */
    {
        static const struct { const char *name, *tool, *env, *path; int want; } dc[] = {
            {"dom-noagent-edit", "Edit", "", "/home/devali/repos/unisacc/tools/x.cx", 0},
            {"dom-other-edit", "Edit", "UNISACC_AGENT=bob", "/home/devali/repos/unisacc/tools/x.cx", 2},
            {"dom-other-write", "Write", "UNISACC_AGENT=bob", "/home/devali/repos/unisacc/tools/y/z.cx", 2},
            {"dom-own-edit", "Edit", "UNISACC_AGENT=alice", "/home/devali/repos/unisacc/tools/x.cx", 0},
            {"dom-free-path", "Edit", "UNISACC_AGENT=bob", "/home/devali/repos/unisacc/src/x.c", 0},
            {"dom-outside-repo", "Write", "UNISACC_AGENT=bob", "/tmp/x.txt", 0},
        };
        char tp[4400], jp[4400], hk[4400], bnd[4400], row[600], json[2048], sh[9000]; int d;
        cx_path_join(tp, sizeof tp, tmpdir, "guard-domains.tsv");
        cx_fmt(row, sizeof row, "alice\ttools/\t4102444800\t-\n");
        cx_write(tp, row, tx_len(row, sizeof row));
        cx_path_join(jp, sizeof jp, tmpdir, "guard-dom.json");
        cx_path_join(bnd, sizeof bnd, argv[1], "tools/bound");
        cx_path_join(hk, sizeof hk, argv[1], ".claude/hooks/guard-edit.ts");
        for (d = 0; d < (int)(sizeof dc / sizeof dc[0]); d++) {
            char *av[8]; int cut = 0, rc, ok;
            cx_fmt(json, sizeof json, "{\"tool_name\":\"%s\",\"tool_input\":{\"file_path\":\"%s\"}}", dc[d].tool, dc[d].path);
            cx_write(jp, json, tx_len(json, sizeof json));
            cx_fmt(sh, sizeof sh, "UNISACC_DOMAINS=%s %s bun %s < %s", tp, dc[d].env, hk, jp);
            av[0] = bnd; av[1] = "20"; av[2] = "sh"; av[3] = "-c"; av[4] = sh; av[5] = 0;
            rc = sy_run(av, outbuf, sizeof outbuf, &cut);
            ok = rc == dc[d].want; assertions++; if (!ok) failed++;
            printf("%s\t%s\twant=%d\tgot=%d\n", ok ? "PASS" : "FAIL", dc[d].name, dc[d].want, rc);
        }
    }
    printf("GUARD_EDIT\tassertions=%d\tfailed=%d\n", assertions, failed);
    return failed ? 1 : 0;
}
