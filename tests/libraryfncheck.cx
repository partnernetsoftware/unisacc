#include <stdint.h>
/* Model-only. Dynamic C owns verdicts; native executor and Python are observers. */
static uint64_t u64(const unsigned char*p){uint64_t n=0;for(int j=0;j<8;j++)n|=(uint64_t)p[j]<<(8*j);return n;}
static unsigned u32(const unsigned char*p){unsigned n=0;for(int j=0;j<4;j++)n|=(unsigned)p[j]<<(8*j);return n;}
static int puthex(const char*p,const char*h){if(!strcmp(h,"-"))return cx_write(p,"",0);size_t n=strlen(h);if(n%2)return 1;unsigned char*b=malloc(n/2+1);if(!b)return 1;for(size_t i=0;i<n;i+=2){unsigned v;if(sscanf(h+i,"%2x",&v)!=1)return 1;b[i/2]=v;}int r=cx_write(p,b,n/2);free(b);return r;}
static int same(const char*a,const char*b){size_t n,m;char*x=cx_read(a,&n),*y=cx_read(b,&m);int ok=x&&y&&n==m&&!memcmp(x,y,n);free(x);free(y);return ok;}
static int frame(const unsigned char*p,size_t n){if(n<20||memcmp(p,"UNILOW1\n",8))return 1;uint64_t z=u64(p+8);unsigned c=u32(p+16);if(z>n-20||c>(n-20-z)/20||n!=20+z+20*c)return 1;uint64_t end=0;for(unsigned i=0;i<c;i++){const unsigned char*r=p+20+z+20*i;uint64_t at=u64(r);if(u32(r+8)!=1||at>=z||at<end||p[20+at]!='0'||u32(r+12)<256||u32(r+16))return 1;end=at+1;}return 0;}
int main(int argc,char**argv){
 if(argc!=2)return 2;size_t n;char*l=cx_read("tests/libraryfn-cases.tsv",&n);if(!l)return 2;
 const char*names[]={"input","contract","selection","legacy","expected","baseline","out","err","oracle","oracle.err","replay"};char path[11][4096],cmd[24000];for(int i=0;i<11;i++)snprintf(path[i],4096,"%s/%s",argv[1],names[i]);int count=0;
 for(char*p=l;*p;){char*e=strchr(p,'\n');if(!e)return 2;*e=0;if(*p!='#'){
  char*f[10];f[0]=p;int k=1;for(char*q=p;*q;q++)if(*q=='\t'){*q=0;if(k==10)return 2;f[k++]=q+1;}if(k!=10)return 2;
  for(int i=0;i<4;i++)if(puthex(path[i],f[i+1]))return 2;if(puthex(path[4],f[8])||puthex(path[5],f[9]))return 2;
  snprintf(cmd,sizeof cmd,"python3 -c 'import sys;from unisa.libraryfnlower import fragment;sys.stdout.buffer.write(fragment(open(sys.argv[1]).read(),open(sys.argv[2],\"rb\").read(),{\"r1\":\"rdi\"},bool(int(sys.argv[4])),open(sys.argv[3],\"rb\").read()))' '%s' '%s' '%s' %s >'%s' 2>'%s'",path[0],path[2],path[1],f[5],path[8],path[9]);int ref=cx_run_timeout(cmd,3,0,0);if(ref!=atoi(f[6])||(!ref&&!same(path[8],path[4]))){printf("CONTRACT_RED %s frozen/reference\n",f[0]);return 1;}
  for(int format=0;format<2;format++){
   snprintf(cmd,sizeof cmd,"'%s/runner' '%s/model.%s' '%s' '%s' '%s' %s '%s' unused >'%s' 2>'%s'",argv[1],argv[1],format?"net":"tbl",path[0],path[1],path[2],f[5],path[3],path[6],path[7]);int rc=cx_run_timeout(cmd,3,0,0);size_t on,en;unsigned char*o=(unsigned char*)cx_read(path[6],&on);char*err=cx_read(path[7],&en);if(!o||!err)return 2;
   if(rc!=atoi(f[6])||(rc&&(on||!strstr(err,f[7])))){printf("CONTRACT_RED %s format=%d rc=%d %s\n",f[0],format,rc,err);return 1;}
   if(!rc){
    char*redir=strstr(cmd," >");if(!redir)return 2;*redir=0;char replay[28000];snprintf(replay,sizeof replay,"cd /var/tmp && env UNISA_OBSERVATION_VARIANT=changed TMPDIR=/var/tmp %s >'%s' 2>'%s/replay.err'",cmd,path[10],argv[1]);if(cx_run_timeout(replay,3,0,0)||!same(path[6],path[10]))return 1;
    if(on<24||memcmp(o,"USLOWP1\n",8))return 1;uint64_t a=u64(o+8),b=u64(o+16);if(a>on-24||b!=on-24-a||frame(o+24,(size_t)a)||frame(o+24+a,(size_t)b))return 1;
    size_t rn;char*r=cx_read(path[4],&rn);if(!r||rn!=b||memcmp(r,o+24+a,b)){printf("CONTRACT_RED %s fragment/reference\n",f[0]);return 1;}free(r);
    if(strcmp(f[9],"-")&&!same(path[5],path[6])){printf("CONTRACT_RED %s legacy baseline\n",f[0]);return 1;}
   }free(o);free(err);
  }count++;
 }p=e+1;}free(l);printf("libraryfn-model: %d fixtures; tbl/net; fragment/reference exact; provenance NEG; legacy baseline; cwd/env replay\n",count);return count==13?0:1;
}
