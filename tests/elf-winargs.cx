/* Product win/x86_64 image must contain the WINARGS body from the fact table
 * once. Expectation is regenerated from enc-x86win-winargs.tsv, not a stale
 * 93-byte literal. Capacity fact WIN_ARGVA_BYTES must match the encoded bound.
 * sh ./unisacc.com tests/elf-winargs.cx -- PRODUCT_COM */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.sig
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use mem.heap

static int assertions, failures;
static unsigned char body[512];
static int body_n;

static void die(const char *s) { sy_eprintf("elf-winargs: REFUSE %s\n", s); sy_exit(2); }
static void ck(int ok, const char *name) {
    assertions++;
    if (ok) sy_printf("PASS\telf-winargs.%s\n", name);
    else { failures++; sy_printf("FAIL\telf-winargs.%s\n", name); }
}
static unsigned long u16(const unsigned char *p) { return p[0] | ((unsigned long)p[1] << 8); }
static unsigned long u32(const unsigned char *p) { return u16(p) | (u16(p + 2) << 16); }

static int load_body(const char *root) {
    char path[4400]; size_t n; char *t; size_t i;
    if (cx_fmt(path, sizeof path, "%s/exec/facts/enc-x86win-winargs.tsv", root)) return 0;
    t = cx_read(path, &n);
    if (!t) return 0;
    body_n = 0;
    i = 0;
    while (i < n) {
        size_t e = i;
        while (e < n && t[e] != '\n') e++;
        if (e > i && t[i] != '#') {
            unsigned long v = 0;
            size_t k = i;
            while (k < e && t[k] >= '0' && t[k] <= '9') {
                v = v * 10 + (unsigned long)(t[k] - '0');
                if (v > 255) { mm_free(t); return 0; }
                k++;
            }
            if (k == i || body_n >= (int)sizeof body) { mm_free(t); return 0; }
            body[body_n++] = (unsigned char)v;
        }
        i = e < n ? e + 1 : e;
    }
    mm_free(t);
    return body_n > 20;
}

static long load_bytes_fact(const char *root) {
    char path[4400]; size_t n; char *t; size_t i;
    const char *key = "lower\tWIN_ARGVA_BYTES\t";
    int kn, found = 0;
    long bytes = 0;
    if (cx_fmt(path, sizeof path, "%s/exec/facts/enc-literals.tsv", root)) return -1;
    t = cx_read(path, &n);
    if (!t) return -1;
    kn = tx_len(key, 64);
    i = 0;
    while (i < n) {
        size_t e = i;
        while (e < n && t[e] != '\n') e++;
        if (e > i && (int)(e - i) >= kn && !tx_cmp(t + i, (long)(e - i) > kn ? kn : (long)(e - i), key, kn) && (int)(e - i) >= kn) {
            /* tx_cmp 0 means equal for min length — require prefix */
        }
        if (e > i && (int)(e - i) > kn) {
            int eq = 1, k;
            for (k = 0; k < kn; k++) if (t[i + k] != key[k]) { eq = 0; break; }
            if (eq) {
                size_t p = i + (size_t)kn;
                long v = 0;
                found++;
                while (p < e && t[p] >= '0' && t[p] <= '9') {
                    v = v * 10 + (t[p] - '0');
                    p++;
                }
                bytes = v;
            }
        }
        i = e < n ? e + 1 : e;
    }
    mm_free(t);
    if (found != 1) return -1;
    return bytes;
}

static int count_hits(const unsigned char *b, long n) {
    long i, k, hit = 0;
    if (n < body_n || body_n <= 0) return 0;
    for (i = 0; i + body_n <= n; i++) {
        k = 0;
        while (k < body_n && b[i + k] == body[k]) k++;
        if (k == body_n) hit++;
    }
    return (int)hit;
}

static int bound_in_body(long limit) {
    int i;
    unsigned char le[4];
    le[0] = (unsigned char)(limit & 255);
    le[1] = (unsigned char)((limit >> 8) & 255);
    le[2] = (unsigned char)((limit >> 16) & 255);
    le[3] = (unsigned char)((limit >> 24) & 255);
    for (i = 0; i + 7 <= body_n; i++) {
        if (body[i] == 0x48 && body[i + 1] == 0x81 && body[i + 2] == 0xf9
            && body[i + 3] == le[0] && body[i + 4] == le[1] && body[i + 5] == le[2] && body[i + 6] == le[3])
            return 1;
    }
    return 0;
}

int main(int argc, char **argv) {
    char root[4096], work[4400], src[4600], out[4600], bound[4400];
    char *v[16];
    char why[512];
    np_result r;
    unsigned char img[16384];
    int fd, hits;
    long sz, bytes, limit, soi;
    const char *com;
    char selfcom[4400];
    root[0] = 0;
    if (argc >= 2 && argv[1][0] == '/') com = argv[1];
    else {
        if (sy_cwd(root, sizeof root) < 0) die("cwd");
        if (cx_fmt(selfcom, sizeof selfcom, "%s/unisacc.com", root)) die("com");
        com = selfcom;
    }
    if (root[0] == 0 && sy_cwd(root, sizeof root) < 0) die("cwd");
    if (!load_body(root)) die("winargs fact table");
    bytes = load_bytes_fact(root);
    ck(bytes > 0 && (bytes % 8) == 0, "capacity-row");
    limit = bytes / 8 - 1;
    ck(limit >= 16384, "capacity-ge-16384");
    ck(bound_in_body(limit), "encoded-bound-equals-fact");
    if (cx_fmt(work, sizeof work, "%s/elfwin-XXXXXX", sy_env_or("TMPDIR", "/tmp")) || !mkdtemp(work)) die("work");
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", root)) die("bound");
    if (cx_fmt(src, sizeof src, "%s/m.c", work) || cx_fmt(out, sizeof out, "%s/m.exe", work)) die("leaf");
    fd = sy_open_new(src, 0644);
    if (fd < 0) die("create");
    if (sy_write_all(fd, "int main(void){return 7;}\n", 26) || sy_close(fd)) die("write");
    v[0] = bound; v[1] = "20"; v[2] = "env"; v[3] = "-u"; v[4] = "UNISA_CONTAINER";
    v[5] = "sh"; v[6] = (char *)com; v[7] = "-b"; v[8] = "win/x86_64"; v[9] = "-o";
    v[10] = out; v[11] = src; v[12] = 0;
    if (np_run(v, root, 0, 20, &r, why, sizeof why)) die(why);
    ck(r.rc == 0, "compile-rc0");
    np_free(&r);
    fd = sy_open_read(out);
    if (fd < 0) die("open image");
    sz = sy_reg_size(fd);
    ck(sz > 64 && sz <= 5120 + 512, "image-budget");
    if (sz < 64 || sz > (long)sizeof img) { sy_close(fd); die("size"); }
    if (sy_read_full(fd, img, sz) || sy_close(fd)) die("read");
    ck(img[0] == 'M' && img[1] == 'Z', "mz");
    {
        unsigned long pe = u32(img + 60);
        soi = 0;
        if (pe + 88 <= (unsigned long)sz && img[pe] == 'P' && img[pe + 1] == 'E')
            soi = (long)u32(img + pe + 80);
        ck(soi > 0, "sizeofimage-reported");
        sy_printf("OBS\telf-winargs.sizeofimage=%ld\tfile=%ld\n", soi, sz);
    }
    hits = count_hits(img, sz);
    ck(hits == 1, "winargs-once");
    cx_rmtree(work);
    sy_printf("ELF_WINARGS\tassertions=%d\tfailed=%d\thits=%d\tbody=%d\tlimit=%ld\n",
              assertions, failures, hits, body_n, limit);
    sy_exit(failures ? 1 : 0);
    return 1;
}
