/* Product win/x86_64 image must contain the declared WINARGS_BODY template
   once. The bytes are the fact table, not a copy of a previous image.
   sh ./unisacc.com tests/elf-winargs.cx -- PRODUCT_COM */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.sig
#pragma unisa use sys.proc
#pragma unisa use text.text

static int assertions, failures;
static const unsigned char body[] = {
    0x0f, 0xb6, 0x06, 0x3c, 0x20, 0x74, 0x04, 0x3c, 0x09, 0x75, 0x05, 0x48, 0xff, 0xc6, 0xeb, 0xf0,
    0x84, 0xc0, 0x74, 0x49, 0x48, 0x83, 0xf9, 0x3f, 0x7d, 0x43, 0x49, 0x89, 0x3c, 0xc8, 0x48, 0xff,
    0xc1, 0x45, 0x31, 0xc9, 0x0f, 0xb6, 0x06, 0x84, 0xc0, 0x74, 0x2f, 0x3c, 0x22, 0x75, 0x09, 0x41,
    0x83, 0xf1, 0x01, 0x48, 0xff, 0xc6, 0xeb, 0xec, 0x45, 0x85, 0xc9, 0x75, 0x08, 0x3c, 0x20, 0x74,
    0x0e, 0x3c, 0x09, 0x74, 0x0a, 0x88, 0x07, 0x48, 0xff, 0xc7, 0x48, 0xff, 0xc6, 0xeb, 0xd5, 0xc6,
    0x07, 0x00, 0x48, 0xff, 0xc7, 0x48, 0xff, 0xc6, 0xeb, 0xa6, 0xc6, 0x07, 0x00
};

static void die(const char *s) { sy_eprintf("elf-winargs: REFUSE %s\n", s); sy_exit(2); }
static void ck(int ok, const char *name) {
    assertions++;
    if (ok) sy_printf("PASS\telf-winargs.%s\n", name);
    else { failures++; sy_printf("FAIL\telf-winargs.%s\n", name); }
}

static int count(const unsigned char *b, long n) {
    long i, k, hit;
    hit = 0;
    if (n < (long)sizeof body) return 0;
    for (i = 0; i + (long)sizeof body <= n; i++) {
        k = 0;
        while (k < (long)sizeof body && b[i + k] == body[k]) k++;
        if (k == (long)sizeof body) hit++;
    }
    return (int)hit;
}

int main(int argc, char **argv) {
    char root[4096], work[4400], src[4600], out[4600], bound[4400];
    char *v[16];
    char why[512];
    np_result r;
    unsigned char img[8192];
    int fd, hits;
    long sz;
    const char *com;
    char selfcom[4400];
    root[0] = 0;
    if (argc >= 2 && argv[1][0] == '/') com = argv[1];
    else {
        if (sy_cwd(root, sizeof root) < 0) die("cwd");
        if (cx_fmt(selfcom, sizeof selfcom, "%s/unisacc.com", root)) die("com");
        com = selfcom;
    }
    if (root[0] == 0 && sy_cwd(root, sizeof root) < 0) die("cwd");
    if (cx_fmt(work, sizeof work, "%s/out/elfwin-%d", root, sy_pid())) die("work");
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", root)) die("bound");
    if (sy_exists(work) != 0) die("work exists");
    if (sy_mkdir(work, 0700)) die("mkdir");
    if (cx_fmt(src, sizeof src, "%s/m.c", work) || cx_fmt(out, sizeof out, "%s/m.exe", work)) die("leaf");
    fd = sy_open_new(src, 0644);
    if (fd < 0) die("create");
    if (sy_write_all(fd, "int main(void){return 7;}\n", 26) || sy_close(fd)) die("write");
    v[0] = bound; v[1] = "20"; v[2] = "env"; v[3] = "-u"; v[4] = "UNISA_CONTAINER";
    v[5] = "sh"; v[6] = (char *)com; v[7] = "-b"; v[8] = "win/x86_64"; v[9] = "-o";
    v[10] = out; v[11] = src; v[12] = 0;
    if (np_run(v, root, 0, 20, &r, why, sizeof why)) die(why);
    ck(r.rc == 0, "compile-rc0");
    np_free(&r);
    fd = sy_open_read(out);
    if (fd < 0) die("open image");
    sz = sy_reg_size(fd);
    ck(sz == 5120, "image-5120");
    if (sz < 64 || sz > (long)sizeof img) { sy_close(fd); die("size"); }
    if (sy_read_full(fd, img, sz) || sy_close(fd)) die("read");
    ck(img[0] == 'M' && img[1] == 'Z', "mz");
    hits = count(img, sz);
    ck(hits == 1, "winargs-once");
    sy_printf("ELF_WINARGS\tassertions=%d\tfailed=%d\thits=%d\tbytes=%d\n", assertions, failures, hits, (int)sizeof body);
    sy_exit(failures ? 1 : 0);
    return 1;
}
