/* Contract checker is dynamic C; native generic executor is an observer.  References are frozen (W1-F): the data
   fragment and wrapper columns of the cases file, captured once from the Python seed import reference at HEAD
   e3c4b123 (a data row field 9, source-ref-count, documents that capture and is no longer read).  No interpreter runs here. */
static int puthex(const char*path,const char*hex){if(!strcmp(hex,"-"))return cx_write(path,"",0);size_t n=strlen(hex);if(n%2)return 1;unsigned char*b=malloc(n/2+1);if(!b)return 1;for(size_t i=0;i<n;i+=2){unsigned v;if(sscanf(hex+i,"%2x",&v)!=1)return 1;b[i/2]=v;}int r=cx_write(path,b,n/2);free(b);return r;}
static int data_no_address(const char*bytes,size_t n,const char*diagnostic){const char*p=strrchr(diagnostic,' ');if(!p||p[1]!='0'||p[2]!='x')return 1;char*end;unsigned long long address=strtoull(p+1,&end,16);if(!address||!end||(*end!='\n'&&*end))return 1;unsigned char le[8],be[8];for(int i=0;i<8;i++){le[i]=(unsigned char)(address>>(8*i));be[7-i]=le[i];}for(size_t i=0;i+8<=n;i++)if(!memcmp(bytes+i,le,8)||!memcmp(bytes+i,be,8))return 1;char formats[3][48];snprintf(formats[0],48,"%llu",address);snprintf(formats[1],48,"%llx",address);snprintf(formats[2],48,"0x%llx",address);for(int k=0;k<3;k++){size_t z=strlen(formats[k]);for(size_t i=0;i+z<=n;i++)if(!memcmp(bytes+i,formats[k],z))return 1;}return 0;}
static int data_case(char **f,const char*dir){char path[7][4096],cmd[20000];const char*name[]={"data-tokens","data-contract","data-legacy","data-selection","data-expected","data-out","data-err"};for(int i=0;i<7;i++)snprintf(path[i],4096,"%s/%s",dir,name[i]);for(int i=0;i<4;i++)if(puthex(path[i],f[i+1]))return 2;if(puthex(path[4],f[7]))return 2;if(strcmp(f[6],"0")&&strcmp(f[6],"1"))return 2;char *first=NULL,*firsterr=NULL;size_t firstn=0;int loops=atoi(f[6])?2:3;for(int pass=0;pass<loops;pass++){const char*model=pass==1?"model.tbl":"model.net",*provider=pass==2?"B":"A";snprintf(cmd,sizeof cmd,"'%s/runner' '%s/%s' '%s' '%s' '%s' %s '%s' '%s' >'%s' 2>'%s'",dir,dir,model,path[0],path[1],path[2],provider,path[3],f[5],path[5],path[6]);int rc=cx_run_timeout(cmd,3,0,0);size_t n,en;char*out=cx_read(path[5],&n),*err=cx_read(path[6],&en);if(!out||!err)return 2;if(rc!=atoi(f[6])){printf("CONTRACT_RED %s rc=%d expected=%s\n",f[0],rc,f[6]);return 1;}if(rc){if(n||!strstr(err,f[8])){printf("CONTRACT_RED %s named refusal\n",f[0]);return 1;}}else{if(n<32||memcmp(out,"USTFLOW2",8))return 1;uint64_t sizes[3]={0};for(int j=0;j<3;j++)for(int z=0;z<8;z++)sizes[j]|=(uint64_t)(unsigned char)out[8+8*j+z]<<(8*z);if(sizes[0]>n-32||sizes[1]>n-32-sizes[0]||sizes[2]!=n-32-sizes[0]-sizes[1])return 1;size_t wantn;char*want=cx_read(path[4],&wantn);if(!want||sizes[2]!=wantn||memcmp(out+32+sizes[0]+sizes[1],want,wantn)){printf("CONTRACT_RED %s data fragment/frozen reference\n",f[0]);return 1;}free(want);if(data_no_address(out+32+sizes[0]+sizes[1],(size_t)sizes[2],err)){printf("CONTRACT_RED %s address in data fragment\n",f[0]);return 1;}if(!pass){first=malloc(n?n:1);memcpy(first,out,n);firstn=n;firsterr=malloc(en+1);memcpy(firsterr,err,en+1);}else if(n!=firstn||memcmp(out,first,n))return 1;if(pass==2){char*a=strrchr(firsterr,' '),*b=strrchr(err,' ');if(!strstr(firsterr,"observation-data-provider A")||!strstr(err,"observation-data-provider B")||!a||!b||!strcmp(a,b))return 1;}}free(out);free(err);}free(first);free(firsterr);return 0;}
int main(int argc,char**argv){if(argc!=2)return 2;size_t n;char ledger[4096];snprintf(ledger,sizeof ledger,"%s/cases.tsv",argv[1]);char*list=cx_read(ledger,&n);if(!list)return 2;char paths[5][4096],cmd[16384];const char*names[]={"tokens","contract","legacy","out","err"};for(int i=0;i<5;i++)snprintf(paths[i],4096,"%s/%s",argv[1],names[i]);int count=0;
for(char*p=list;*p;){char*e=strchr(p,'\n');if(!e)return 2;*e=0;if(*p!='#'){char*f[10];f[0]=p;int k=1;for(char*q=p;*q;q++)if(*q=='\t'){*q=0;if(k==10)return 2;f[k++]=q+1;}if(k==10){int dr=data_case(f,argv[1]);if(dr)return dr;count++;p=e+1;continue;}if(k!=8)return 2;for(int i=0;i<3;i++)if(puthex(paths[i],f[i+1]))return 2;
snprintf(cmd,sizeof cmd,"'%s/runner' '%s/model.net' '%s' '%s' '%s' >'%s' 2>'%s'",argv[1],argv[1],paths[0],paths[1],paths[2],paths[3],paths[4]);int rc=cx_run_timeout(cmd,3,0,0);if(!strcmp(f[0],"used")){char pair[16384],oa[4096],ob[4096],ea[4096],eb[4096];snprintf(oa,sizeof oa,"%s/pairA",argv[1]);snprintf(ob,sizeof ob,"%s/pairB",argv[1]);snprintf(ea,sizeof ea,"%s/contextA",argv[1]);snprintf(eb,sizeof eb,"%s/contextB",argv[1]);snprintf(pair,sizeof pair,"env UNISA_OBSERVATION_CONTEXT=A '%s/runner' '%s/model.net' '%s' '%s' '%s' A >'%s' 2>'%s'",argv[1],argv[1],paths[0],paths[1],paths[2],oa,ea);if(cx_run_timeout(pair,3,0,0))return 1;snprintf(pair,sizeof pair,"env UNISA_OBSERVATION_CONTEXT=B '%s/runner' '%s/model.net' '%s' '%s' '%s' B >'%s' 2>'%s'",argv[1],argv[1],paths[0],paths[1],paths[2],ob,eb);if(cx_run_timeout(pair,3,0,0))return 1;size_t an,bn,xn,yn;char*a=cx_read(oa,&an),*b=cx_read(ob,&bn),*x=cx_read(ea,&xn),*y=cx_read(eb,&yn);if(!a||!b||an!=bn||memcmp(a,b,an)||!x||!y||!strstr(x,"observation-provider A")||!strstr(y,"observation-provider B")||!strrchr(x,' ')||!strrchr(y,' ')||!strcmp(strrchr(x,' '),strrchr(y,' ')))return 1;free(a);free(b);free(x);free(y);}size_t on,en;char*o=cx_read(paths[3],&on),*err=cx_read(paths[4],&en);if(!o||!err)return 2;if(rc!=atoi(f[4])){printf("CONTRACT_RED %s rc=%d expected=%s\n",f[0],rc,f[4]);return 1;}if(rc){if(on||!strstr(err,f[6])){printf("CONTRACT_RED %s named empty refusal\n",f[0]);return 1;}}
else {char*body=o;size_t bn=on;char*fragment=NULL;size_t fn=0;if(on>=24&&!memcmp(o,"USTFLOW1",8)){uint64_t mn=0,ff=0;for(int z=0;z<8;z++){mn|=(uint64_t)(unsigned char)o[8+z]<<(8*z);ff|=(uint64_t)(unsigned char)o[16+z]<<(8*z);}if(mn>on-24||ff!=on-24-mn)return 1;body=malloc((size_t)mn+1);if(!body)return 2;memcpy(body,o+24,(size_t)mn);body[mn]=0;bn=(size_t)mn;fragment=o+24+mn;fn=(size_t)ff;}int em=strstr(body,".libraryfn")!=0;if(em!=atoi(f[5])){printf("CONTRACT_RED %s wrapper ownership\n",f[0]);return 1;}if(em){char rp[4096];snprintf(rp,sizeof rp,"%s/reference",argv[1]);if(!strcmp(f[7],"-")||puthex(rp,f[7]))return 2;size_t wn;char*w=cx_read(rp,&wn);if(!w||wn>bn||memcmp(body+bn-wn,w,wn)||!fragment||fn!=wn||memcmp(fragment,w,wn)){printf("CONTRACT_RED wrapper/reference bytes\n");return 1;}free(w);}if(!strcmp(f[0],"legacy")&&!strstr(body,"imm r1, 4096"))return 1;if(!em&&(fn||strcmp(f[7],"-")))return 1;if(body!=o)free(body);}free(o);free(err);count++;}p=e+1;}free(list);printf("libraryfunctionimports: %d fixtures; ordinary wrapper/frozen reference exact; unused/defined absent; named duplicate-owner\n",count);return count?0:1;}
