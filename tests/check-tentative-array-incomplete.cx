/* Candidate front-end regression checks for file-scope incomplete tentative arrays.
 * Usage: cx tests/check-tentative-array-incomplete.cx -- [COMPILER_PATH] */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.posix
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use cxlib.netpack

static char prod[4096], tdir[4096];
static int use_sh, passed, failed;

static int tai_exec(char **argv, char *out, long cap) {
    np_result r = {0}; char why[256] = {0};
    int tr = np_run(argv, 0, 0, 30, &r, why, sizeof why);
    long n = 0;
    if (r.out && r.outn > 0) {
        long k = (long)r.outn < cap - 1 ? (long)r.outn : cap - 1;
        for (long i = 0; i < k; i++) out[n++] = r.out[i];
    }
    if (r.err && r.errn > 0 && n < cap - 1) {
        long k = (long)r.errn < (cap - 1 - n) ? (long)r.errn : (cap - 1 - n);
        for (long i = 0; i < k; i++) out[n++] = r.err[i];
    }
    out[n] = 0;
    int rc = (tr || r.residue) ? -1 : r.rc;
    np_free(&r);
    return rc;
}

static void tai_head(const char *s, char *dst, size_t cap) {
    size_t i = 0;
    for (; s[i] && s[i] != '\n' && s[i] != '\r' && i + 1 < cap; i++)
        dst[i] = (s[i] == '\t') ? ' ' : s[i];
    dst[i] = 0;
    if (!i) { dst[0] = '-'; dst[1] = 0; }
}

static void check_case(const char *id, const char *src, int expect_rc0, const char *want_err) {
    char sp[4200], op[4200], buf[4096], fl[180];
    if (cx_fmt(sp, sizeof sp, "%s/%s.c", tdir, id) ||
        cx_fmt(op, sizeof op, "%s/%s.o", tdir, id) || cx_write(sp, src, strlen(src))) {
        failed++; sy_printf("TENTARR_CASE\t%s\tFAIL\tfixture-write\n", id); return;
    }
    char *v_sh[] = {"sh", prod, "-c", sp, "-o", op, 0};
    char *v_bin[] = {prod, "-c", sp, "-o", op, 0};
    int rc = tai_exec(use_sh ? v_sh : v_bin, buf, sizeof buf);
    tai_head(buf, fl, sizeof fl);
    int ok = expect_rc0 ? (rc == 0) : (rc > 0 && (!want_err || strstr(buf, want_err) != 0));
    if (ok) passed++; else failed++;
    sy_printf("TENTARR_CASE\t%s\t%s\twant_rc0=%d\tgot_rc=%d\terr=%s\n",
              id, ok ? "PASS" : "FAIL", expect_rc0, rc, fl);
}

int main(int argc, char **argv) {
    const char *p = (argc >= 2) ? argv[1] : "./unisacc.com";
    if (sy_realpath(p, prod, sizeof prod) < 0) return 2;
    size_t pl = strlen(prod);
    use_sh = (pl >= 4 && strcmp(prod + pl - 4, ".com") == 0);
    if (argc > 2 || sy_mkdtemp(sy_tmpdir(), "b1-tai-", tdir, sizeof tdir)) return 2;

    /* Positive controls: RED on 0.0.93 baseline (P1..P6 fail with incomplete array declaration) -> GREEN on 0.0.99 */
    check_case("P1-static-before-global", "static int t[];\nint g;\n", 1, 0);
    check_case("P2-static-eof", "static int t[];\n", 1, 0);
    check_case("P3-tentative-eof", "int t[];\n", 1, 0);
    check_case("P4-static-before-main", "static int t[];\nint main(void) { return t[0]; }\n", 1, 0);
    check_case("P5-tentative-use-write", "int t[];\nint main(void) { t[0] = 1; return t[0] - 1; }\n", 1, 0);
    check_case("P6-static-forward-init-after-fn",
               "static int t[];\nint helper(void) { return t[1]; }\nstatic int t[] = {10, 20, 30};\nint main(void) { return helper() == 20 ? 0 : 1; }\n",
               1, 0);
    check_case("P7-static-init-then-global", "static int t[] = {1, 2, 3};\nint g;\n", 1, 0);

    /* Negative controls: must remain REJECTED (rc!=0) */
    check_case("N1-tentative-type-conflict", "int t[];\ndouble t;\n", 0, "conflicting types");
    check_case("N2-static-init-size-conflict", "static int t[] = {1, 2};\nstatic int t[4];\n", 0, "conflicting types");
    check_case("N3-zero-size-array", "int t[0];\n", 0, "greater than zero");

    if (sy_remove_all(tdir)) failed++;
    sy_printf("TENTARR_SUMMARY\tpassed=%d\tfailed=%d\ttotal=%d\n", passed, failed, passed + failed);
    return failed ? 1 : 0;
}
