/* ROOT PRODUCT NEW_ABS_OUT. Actual product invocations, no private model pins.
   One bounded wave tests the new E2/E1/E3 consumption edges on Linux/x86_64. */
#pragma unisa use cxlib.netpack
static char root[4096],product[4096],work[4096],bound[4400];
static const char *names[]={"macro-keys","stringization","pp-number","erased-body","parameter","initial-digit","symbols","multi","limit63","caret","erased-number","discarded-number"};
static char files[12][4400],second[4400];
static void die(const char *s){fprintf(stderr,"ucn-identities: %s errno=%d\n",s,errno);exit(2);}
static void path(char *p,size_t cap,const char *a,const char *b){if(cx_path_join(p,cap,a,b))die("path");}
static void save(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive output");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("write");at+=(size_t)z;}if(close(fd))die("close");}
static void digest(char h[65]){size_t n;char *s=cx_read(product,&n);if(!s)die("candidate read");cx_sha256_hex(s,n,h);free(s);}
static void logbytes(int i,const char *suffix,const char *s,size_t n){char leaf[160],p[4400];if(cx_fmt(leaf,sizeof leaf,"%s.%s",names[i],suffix)<0)die("format");path(p,sizeof p,work,leaf);save(p,s,n);}
/* E2 ignores only layout between tokens here. The pp-number case ALSO checks
   each required contiguous spelling, so inserted separators cannot pass. */
static int region(const char *s,size_t n,const char *want){
 const char *a=strstr(s,"UCN_OUTPUT_BEGIN"),*b=a?strstr(a+16,"UCN_OUTPUT_END"):0;if(!a||!b)return 0;a+=16;size_t j=0;
 for(const char *p=a;p<b;p++){unsigned char c=(unsigned char)*p;if(c==' '||c=='\t'||c=='\n'||c=='\r')continue;if(!want[j]||want[j++]!=(char)c)return 0;}return !want[j];
}
static int one(int i){
 char *v[12]={bound,"12","sh",product,0};int k=4;
 if(i<6||i>=10)v[k++]="-E";else{v[k++]="-O0";v[k++]="-run";}
 v[k++]=files[i];if(i==7)v[k++]=second;v[k]=0;
 np_result r={0};char why[1024];int transport=np_run(v,root,0,15,&r,why,sizeof why);
 logbytes(i,"stdout",r.out,r.outn);logbytes(i,"stderr",r.err,r.errn);
 char status[120];int z=cx_fmt(status,sizeof status,"transport=%d rc=%d\n",transport,r.rc);if(z<0)die("format");logbytes(i,"status",status,strlen(status));
 int ok=!transport;
 if(i==0)ok=ok&&!r.rc&&!r.errn&&region(r.out,r.outn,"intobserved=7;intgone=1;");
 else if(i==1)ok=ok&&!r.rc&&!r.errn&&region(r.out,r.outn,"\"\\u00E9\"");
 else if(i==2)ok=ok&&!r.rc&&!r.errn&&region(r.out,r.outn,"1\\u00e91e1.e0xE+e\"1\\u0024\"\"1\\U0001F600\"")&&strstr(r.out,"1\\u00e9")&&strstr(r.out,"1e")&&strstr(r.out,"1.e")&&strstr(r.out,"0xE+e");
 else if((i>=3&&i<=5)||i>=10){const char *reason=i==5?"universal character name digit cannot start identifier":"invalid universal character name";ok=ok&&r.rc==1&&!r.outn&&r.errn&&strstr(r.err,reason);}
 /* The diagnostic renderer adds two spaces before source and caret lines.
    Column12 therefore has eleven source columns plus two renderer spaces. */
 else if(i==9)ok=ok&&r.rc==1&&!r.outn&&r.errn&&strstr(r.err,":2:12: error: unknown identifier")&&strstr(r.err,"\n      return \\u00E9missing;\n             ^\n1 error generated.\n");
 else ok=ok&&!r.rc&&!r.outn&&!r.errn;
 int unknown=transport||r.rc==142||r.rc==143||r.rc>=128||r.rc<0;
 if(transport)fprintf(stderr,"%s\n",why);np_free(&r);return unknown?3:ok?0:1;
}
int main(int argc,char **argv){
 if(argc!=4||!realpath(argv[1],root)||!realpath(argv[2],product)||argv[3][0]!='/'||strlen(argv[3])>=sizeof work)die("ROOT PRODUCT NEW_ABS_OUT");
#if !defined(__linux__) || !defined(__x86_64__)
 puts("NOT_RUN UCN_IDENTITIES requires native Linux/x86_64");return 3;
#endif
 if(cx_fmt(work,sizeof work,"%s",argv[3])<0||mkdir(work,0700))die("fresh output");path(bound,sizeof bound,root,"tools/bound");
 unsetenv("UNISACC_RF_CAPTURE");unsetenv("UNISACC_RF_STRICT");unsetenv("UNISA_ATTRIBUTES");unsetenv("UNISACC_RR_DEBUG");unsetenv("UNISACC_RR_TIME");setenv("UNISACC_RUN_CACHE","0",1);
 const char *text[]={
  "#define \\u00e9M 7\n#define F(\\u00e9p) \\U000000E9p\nUCN_OUTPUT_BEGIN\nint observed=F(\\U000000E9M);\n#undef \\u00E9M\n#ifdef \\u00e9M\nint gone=0;\n#else\nint gone=1;\n#endif\nUCN_OUTPUT_END\n",
  "#define S(\\u00e9p) #\\U000000E9p\nUCN_OUTPUT_BEGIN\nS(\\u00E9)\nUCN_OUTPUT_END\n",
  "#define e 99\n#define u00e9 88\n#define F(x) x\n#define S(x) #x\n#define UNUSED 1\\u0024 1\\U0001F600\nUCN_OUTPUT_BEGIN\nF(1\\u00e9)\n1e\n1.e\n0xE+e\nS(1\\u0024)\nS(1\\U0001F600)\nUCN_OUTPUT_END\n",
  "#define UNUSED \\u0041\nint main(void){return 0;}\n",
  "#define F(a\\uD800) 1\nint main(void){return 0;}\n",
  "#define \\u0660 1\nint main(void){return 0;}\n",
  "int \\u00e9g=3; int \\u00E9f(int);\nint \\U000000e9f(int \\u00E9p){typedef int \\u00e9T;struct \\u00e9S{int \\u00e9m;};struct \\U000000E9S \\u00e9o={2};enum{\\u00e9E=1};\\U000000E9T \\u00e9v=\\U000000E9p+\\U000000E9g;goto \\U000000e9label;\\u00E9label:return \\U000000E9v+\\U000000E9o.\\U000000E9m+\\U000000E9E;}\nint main(void){return \\u00e9f(4)-10;}\n",
  "static int \\u00e9s=10;static int \\u00E9f(void){return \\U000000e9s;}int b(void);int a(void){return \\U000000E9f();}int main(void){return a()+b()-30;}\n",
  "",
  "int main(void){\n    return \\u00E9missing;\n}\n",
  "#define UNUSED 1\\u0041\nint main(void){return 0;}\n",
  "#define DROP(x) 1\nint main(void){return DROP(1\\uD800);}\n"
 };
 for(int i=0;i<12;i++){char leaf[160];if(cx_fmt(leaf,sizeof leaf,"%s.cx",names[i])<0)die("format");path(files[i],sizeof files[i],work,leaf);if(i!=8)save(files[i],text[i],strlen(text[i]));}
 /* C99 counts each UCN as one internal-name character. Exercise emitted
    static object/function symbols as well as a stack-local identifier. */
 np_buf longname={0};np_puts(&longname,"static int v");for(int i=0;i<62;i++)np_puts(&longname,"\\u00e9");
 np_puts(&longname,"=2;static int f");for(int i=0;i<62;i++)np_puts(&longname,"\\u00e9");
 np_puts(&longname,"(void){return v");for(int i=0;i<62;i++)np_puts(&longname,"\\U000000E9");
 np_puts(&longname,";}int main(void){int ");for(int i=0;i<63;i++)np_puts(&longname,"\\u00e9");
 np_puts(&longname,"=5;return f");for(int i=0;i<62;i++)np_puts(&longname,"\\U000000E9");
 np_puts(&longname,"()+");for(int i=0;i<63;i++)np_puts(&longname,"\\U000000E9");np_puts(&longname,"-7;}\n");save(files[8],longname.p,longname.n);free(longname.p);
 path(second,sizeof second,work,"multi-second.cx");const char *two="static int \\U000000E9s=20;static int \\U000000e9f(void){return \\u00E9s;}int b(void){return \\u00e9f();}\n";save(second,two,strlen(two));
 char before[65],after[65];digest(before);int failed=0,unverified=0;
 for(int first=0;first<12;first+=4){int count=12-first;if(count>4)count=4;pid_t ids[4];fflush(stdout);for(int j=0;j<count;j++){ids[j]=fork();if(ids[j]<0)die("fork");if(!ids[j])exit(one(first+j));}
  for(int j=0;j<count;j++){int st;pid_t p;do{p=waitpid(ids[j],&st,0);}while(p<0&&errno==EINTR);int unknown=p!=ids[j]||!WIFEXITED(st)||(WIFEXITED(st)&&WEXITSTATUS(st)==3);int ok=!unknown&&WEXITSTATUS(st)==0;if(unknown)unverified++;else if(!ok)failed++;printf("%s\tucn-identities.%s\n",unknown?"UNVERIFIED":ok?"PASS":"FAIL",names[first+j]);}
 }
 digest(after);int unchanged=!strcmp(before,after);if(!unchanged)failed++;printf("%s\tucn-identities.candidate-unchanged\n",unchanged?"PASS":"FAIL");
 puts("NOT_CLAIMED full-C99-complete-E2-E3-N22-or-foreign-native-hosts");printf("UCN_IDENTITIES assertions=13 failed=%d unverified=%d candidate=%s\n",failed,unverified,before);return unverified?3:failed?1:0;
}
