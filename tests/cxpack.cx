#!/usr/bin/env -S unisacc.com -run
/* cxpack.cx -- package manifest and import identity for one directory.
   A directory holds cxpack.tsv. Each row is name, path, public names.
   The path must be the name with '.' turned into '/' and ".cx" appended,
   the same beside-file rule the compiler uses for `#pragma unisa use`.
   Public names are a sorted subset of the non-static functions defined in
   that file. A static function is file-local and cannot be listed.
   `std` and `std.cx` are the prelude and are not rows.
   This file has no preprocessor include. It does not change the compiler:
   a non-static function that is left off the public list is still exported
   by CXIF v0. The check below is the lint.
   usage, from the repo root:
     sh ./unisacc.com -run tests/cxpack.cx -- --check DIR
     sh ./unisacc.com -run tests/cxpack.cx -- --fixtures
   --check exits 1 when the package breaks the contract, 2 on usage or I/O.
   --fixtures runs the committed packages and one temporary include case. */

#define CXPK_MOD 16
#define CXPK_NAME 64
#define CXPK_FUN 24
#define CXPK_USE 8
#define CXPK_CALL 24
#define CXPK_EXP 8
#define CXPK_FILES 32

typedef struct {
    char name[CXPK_NAME];
    char path[CXPK_NAME];
    char pragma_name[CXPK_NAME];
    int has_pragma;
    int pragma_bad;
    char exp[CXPK_EXP][CXPK_NAME];
    int nexp;
    char pub[CXPK_FUN][CXPK_NAME];
    int npub;
    char loc[CXPK_FUN][CXPK_NAME];
    int nloc;
    char use[CXPK_USE][CXPK_NAME];
    int nuse;
    char call[CXPK_CALL][CXPK_NAME];
    int ncall;
    int inc;
    int overflow;
} Mod;

static Mod mods[CXPK_MOD];
static int nmod;
static int fails;
static char logb[12000];
static size_t logn;

static void addlog(const char *s) {
    size_t n = strlen(s);
    printf("%s\n", s);
    if (logn + n + 2 < sizeof logb) {
        {void *cx_kept=memcpy(logb + logn, s, n);(void)cx_kept;}
        logn += n;
        logb[logn++] = '\n';
        logb[logn] = 0;
    }
}

static void fail(const char *s) { fails++; addlog(s); }

static int putname(char *dst, const char *src) {
    size_t n = strlen(src);
    if (n == 0 || n + 1 > CXPK_NAME) return -1;
    {void *cx_kept=memcpy(dst, src, n + 1);(void)cx_kept;}
    return 0;
}

static int good_mod(const char *s) {
    int st = 1;
    if (!*s || strlen(s) + 1 > CXPK_NAME) return 0;
    while (*s) {
        if (*s == '.') { if (st) return 0; st = 1; s++; continue; }
        if (st) { if (!((*s >= 'a' && *s <= 'z') || *s == '_')) return 0; st = 0; }
        else if (!((*s >= 'a' && *s <= 'z') || (*s >= '0' && *s <= '9') || *s == '_')) return 0;
        s++;
    }
    return st == 0;
}

static int good_ident(const char *s) {
    if (!*s || strlen(s) + 1 > CXPK_NAME) return 0;
    if (!((*s >= 'A' && *s <= 'Z') || (*s >= 'a' && *s <= 'z') || *s == '_')) return 0;
    s++;
    while (*s) {
        if (!((*s >= 'A' && *s <= 'Z') || (*s >= 'a' && *s <= 'z') || (*s >= '0' && *s <= '9') || *s == '_')) return 0;
        s++;
    }
    return 1;
}

static int name_path(const char *name, char *out) {
    size_t n = strlen(name), i;
    if (n + 4 >= CXPK_NAME) return -1;
    for (i = 0; i < n; i++) out[i] = name[i] == '.' ? '/' : name[i];
    memcpy(out + n, ".cx", 4);
    return 0;
}

static const char *stem_of(const char *name) {
    const char *s = name;
    while (*name) { if (*name == '.') s = name + 1; name++; }
    return s;
}

static int is_id0(int c) { return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_'; }
static int is_id(int c) { return is_id0(c) || (c >= '0' && c <= '9'); }

static int is_kw(const char *s) {
    static const char *k[] = {
        "auto", "break", "case", "char", "const", "continue", "default", "do", "double", "else", "enum",
        "extern", "float", "for", "goto", "if", "inline", "int", "long", "register", "restrict", "return",
        "short", "signed", "sizeof", "static", "struct", "switch", "typedef", "union", "unsigned", "void",
        "volatile", "while", "_Bool", 0
    };
    int i;
    for (i = 0; k[i]; i++) if (!strcmp(s, k[i])) return 1;
    return 0;
}

static int add_slot(char slot[][CXPK_NAME], int *n, int cap, const char *s) {
    int i;
    if (*n >= cap) return -1;
    for (i = 0; i < *n; i++) if (!strcmp(slot[i], s)) return 1;
    if (putname(slot[*n], s)) return -1;
    (*n)++;
    return 0;
}

static void take_word(const char *b, size_t e, size_t *i, size_t *w) {
    while (*i < e && (b[*i] & 255) <= 32) (*i)++;
    *w = *i;
    while (*i < e && (b[*i] & 255) > 32) (*i)++;
}

static void directive_fix(Mod *m, const char *b, size_t n, size_t i) {
    size_t e = i, w, kind_b, kind_e, name_b, name_e;
    char kind[CXPK_NAME], name[CXPK_NAME];
    while (e < n && b[e] != '\n') e++;
    i++;
    take_word(b, e, &i, &w);
    if (i - w == 7 && !memcmp(b + w, "include", 7)) { m->inc = 1; return; }
    if (!(i - w == 6 && !memcmp(b + w, "pragma", 6))) return;
    take_word(b, e, &i, &w);
    if (!(i - w == 5 && !memcmp(b + w, "unisa", 5))) return;
    take_word(b, e, &i, &kind_b);
    kind_e = i;
    if (kind_e == kind_b || kind_e - kind_b >= CXPK_NAME) { m->pragma_bad = 1; return; }
    {void *cx_kept=memcpy(kind, b + kind_b, kind_e - kind_b);(void)cx_kept;} kind[kind_e - kind_b] = 0;
    if (strcmp(kind, "use") && strcmp(kind, "module")) { m->pragma_bad = 1; return; }
    take_word(b, e, &i, &name_b);
    name_e = i;
    if (name_e == name_b || name_e - name_b >= CXPK_NAME) { m->pragma_bad = 1; return; }
    {void *cx_kept=memcpy(name, b + name_b, name_e - name_b);(void)cx_kept;} name[name_e - name_b] = 0;
    while (i < e && (b[i] & 255) <= 32) i++;
    if (i < e) { m->pragma_bad = 1; return; }
    if (!good_mod(name) && strcmp(name, "std.cx")) { m->pragma_bad = 1; return; }
    if (!strcmp(kind, "module")) {
        if (m->has_pragma) { m->pragma_bad = 1; return; }
        m->has_pragma = 1;
        {void *cx_kept=memcpy(m->pragma_name, name, strlen(name) + 1);(void)cx_kept;}
    } else if (add_slot(m->use, &m->nuse, CXPK_USE, name)) m->overflow = 1;
}

static int scan_src(Mod *m, const char *b, size_t n) {
    size_t i = 0;
    int bol = 1, depth = 0, paren = 0, item_static = 0, have_last = 0, have_pend = 0, pend_static = 0;
    char last[CXPK_NAME], pend[CXPK_NAME];
    last[0] = pend[0] = 0;
    while (i < n) {
        unsigned char c = (unsigned char)b[i];
        if (c == '\n') { bol = 1; i++; continue; }
        if (bol && (c == ' ' || c == '\t' || c == '\r')) { i++; continue; }
        if (bol && c == '#') { directive_fix(m, b, n, i); while (i < n && b[i] != '\n') i++; continue; }
        bol = 0;
        if (c == '/' && i + 1 < n && b[i + 1] == '/') { while (i < n && b[i] != '\n') i++; continue; }
        if (c == '/' && i + 1 < n && b[i + 1] == '*') {
            i += 2;
            while (i + 1 < n && !(b[i] == '*' && b[i + 1] == '/')) i++;
            if (i + 1 < n) i += 2;
            continue;
        }
        if (c == '"' || c == '\'') {
            unsigned char q = c; i++;
            while (i < n && (unsigned char)b[i] != q) {
                if (b[i] == '\\' && i + 1 < n) i += 2;
                else i++;
            }
            if (i < n) i++;
            continue;
        }
        if (is_id0(c)) {
            char id[CXPK_NAME];
            size_t k = 0;
            while (i < n && is_id((unsigned char)b[i])) {
                if (k + 1 < CXPK_NAME) id[k++] = b[i];
                else m->overflow = 1;
                i++;
            }
            id[k] = 0;
            if (depth == 0 && paren == 0 && !strcmp(id, "static")) item_static = 1;
            if (!is_kw(id)) { {void *cx_kept=memcpy(last, id, k + 1);(void)cx_kept;} have_last = 1; }
            continue;
        }
        if (c == '(') {
            if (paren == 0 && have_last) {
                if (depth == 0) { {void *cx_kept=memcpy(pend, last, strlen(last) + 1);(void)cx_kept;} have_pend = 1; pend_static = item_static; }
                else if (add_slot(m->call, &m->ncall, CXPK_CALL, last)) m->overflow = 1;
            }
            paren++; have_last = 0; i++; continue;
        }
        if (c == ')') { if (paren > 0) paren--; i++; continue; }
        if (c == '{') {
            if (depth == 0 && paren == 0 && have_pend) {
                int rc = add_slot(pend_static ? m->loc : m->pub, pend_static ? &m->nloc : &m->npub, CXPK_FUN, pend);
                if (rc) m->overflow = 1;
                have_pend = 0;
            }
            depth++; i++; continue;
        }
        if (c == '}') {
            if (depth > 0) depth--;
            if (depth == 0) { item_static = 0; have_last = 0; have_pend = 0; }
            i++; continue;
        }
        if (c == ';' && depth == 0 && paren == 0) { item_static = 0; have_last = 0; have_pend = 0; i++; continue; }
        i++;
    }
    return 0;
}

static int split_exp(Mod *m, const char *s) {
    if (!*s) return 0;
    while (*s) {
        const char *b = s;
        char name[CXPK_NAME];
        size_t n;
        while (*s && *s != ',') s++;
        n = (size_t)(s - b);
        if (n == 0 || n + 1 > CXPK_NAME) return -1;
        {void *cx_kept=memcpy(name, b, n);(void)cx_kept;} name[n] = 0;
        if (!good_ident(name)) return -1;
        if (m->nexp > 0 && strcmp(m->exp[m->nexp - 1], name) >= 0) return -2;
        if (m->nexp >= CXPK_EXP) return -1;
        {void *cx_kept=memcpy(m->exp[m->nexp], name, n + 1);(void)cx_kept;}
        m->nexp++;
        if (*s == ',') s++;
    }
    return 0;
}

static int has_name(char slot[][CXPK_NAME], int n, const char *s) {
    int i;
    for (i = 0; i < n; i++) if (!strcmp(slot[i], s)) return 1;
    return 0;
}

static Mod *find_mod(const char *name) {
    int i;
    for (i = 0; i < nmod; i++) if (!strcmp(mods[i].name, name)) return &mods[i];
    return 0;
}

typedef struct { const char *dir; size_t nd; int n; char path[CXPK_FILES][512]; } Walk;

static int on_file(const char *path, void *ctx) {
    Walk *w = ctx;
    size_t n = strlen(path);
    if (n < 3 || strcmp(path + n - 3, ".cx")) return 0;
    if (w->n >= CXPK_FILES || n + 1 > 512) return 1;
    {void *cx_kept=memcpy(w->path[w->n], path, n + 1);(void)cx_kept;}
    w->n++;
    return 0;
}

static int load_row(const char *dir, char *line) {
    char *t1, *t2, expect[CXPK_NAME], full[512], msg[256];
    Mod *m;
    char *src; size_t n;
    int rc;
    if (nmod >= CXPK_MOD) { fail("cxpack: too many modules"); return -1; }
    t1 = strchr(line, '\t');
    t2 = t1 ? strchr(t1 + 1, '\t') : 0;
    if (!t1 || !t2 || strchr(t2 + 1, '\t')) { fail("cxpack: bad row"); return -1; }
    *t1 = 0; *t2 = 0;
    if (!good_mod(line)) { cx_fmt(msg, sizeof msg, "cxpack: bad module name %s", line); fail(msg); return -1; }
    if (find_mod(line)) { cx_fmt(msg, sizeof msg, "cxpack: duplicate module %s", line); fail(msg); return -1; }
    m = &mods[nmod];
    memset(m, 0, sizeof *m);
    if (putname(m->name, line)) return -1;
    if (name_path(line, expect)) return -1;
    if (strcmp(expect, t1 + 1)) {
        cx_fmt(msg, sizeof msg, "cxpack: path identity: %s maps to %s, row says %s", line, expect, t1 + 1);
        fail(msg);
    }
    if (putname(m->path, expect)) return -1;
    rc = split_exp(m, t2 + 1);
    if (rc == -2) { fail("cxpack: exports not sorted"); return -1; }
    if (rc) { fail("cxpack: bad exports"); return -1; }
    nmod++;
    if (cx_path_join(full, sizeof full, dir, expect)) { fail("cxpack: path too long"); return -1; }
    src = cx_read(full, &n);
    if (!src) { cx_fmt(msg, sizeof msg, "cxpack: missing module %s", expect); fail(msg); return 0; }
    scan_src(m, src, n);
    free(src);
    return 0;
}

/* 0 clean, >0 contract failures, -1 I/O or a malformed manifest */
static int check_dir(const char *dir) {
    char man[512], msg[320], *b, *line;
    size_t n, i, e;
    int k, c;
    Walk walk;
    fails = 0; logn = 0; logb[0] = 0; nmod = 0;
    if (cx_path_join(man, sizeof man, dir, "cxpack.tsv")) { fprintf(stderr, "cxpack: path too long\n"); return -1; }
    b = cx_read(man, &n);
    if (!b) { fprintf(stderr, "cxpack: cannot read %s\n", man); return -1; }
    i = 0;
    while (i < n) {
        e = i; while (e < n && b[e] != '\n') e++;
        if (e < n) b[e] = 0;
        if (e > i && b[e - 1] == '\r') b[e - 1] = 0;
        line = b + i;
        if (*line && *line != '#') { if (load_row(dir, line)) { free(b); return -1; } }
        i = e + 1;
    }
    free(b);
    if (nmod == 0) { fail("cxpack: empty manifest"); return fails; }
    memset(&walk, 0, sizeof walk);
    walk.dir = dir; walk.nd = strlen(dir);
    if (cx_walk(dir, on_file, &walk)) { fprintf(stderr, "cxpack: cannot list %s\n", dir); return -1; }
    for (k = 0; k < walk.n; k++) {
        const char *rel;
        int known = 0, u;
        if (strncmp(walk.path[k], dir, walk.nd) || walk.path[k][walk.nd] != '/') continue;
        rel = walk.path[k] + walk.nd + 1;
        for (u = 0; u < nmod; u++) if (!strcmp(mods[u].path, rel)) known = 1;
        if (!known) { cx_fmt(msg, sizeof msg, "cxpack: unlisted module %s", rel); fail(msg); }
    }
    for (k = 0; k < nmod; k++) {
        Mod *m = &mods[k];
        if (m->overflow) { cx_fmt(msg, sizeof msg, "cxpack: too many names in %s", m->name); fail(msg); }
        if (m->inc) { cx_fmt(msg, sizeof msg, "cxpack: module include: %s", m->path); fail(msg); }
        if (m->pragma_bad) { cx_fmt(msg, sizeof msg, "cxpack: bad pragma in %s", m->path); fail(msg); }
        if (m->has_pragma && strcmp(m->pragma_name, stem_of(m->name))) {
            cx_fmt(msg, sizeof msg, "cxpack: module pragma %s is not stem %s", m->pragma_name, stem_of(m->name));
            fail(msg);
        }
        for (c = 0; c < m->nexp; c++) {
            if (has_name(m->loc, m->nloc, m->exp[c])) {
                cx_fmt(msg, sizeof msg, "cxpack: export is file-local: %s in %s", m->exp[c], m->name);
                fail(msg);
            } else if (!has_name(m->pub, m->npub, m->exp[c])) {
                cx_fmt(msg, sizeof msg, "cxpack: export not defined: %s in %s", m->exp[c], m->name);
                fail(msg);
            }
        }
        for (c = 0; c < m->nuse; c++) {
            if (!strcmp(m->use[c], "std") || !strcmp(m->use[c], "std.cx")) continue;
            if (!find_mod(m->use[c])) { cx_fmt(msg, sizeof msg, "cxpack: unknown import %s", m->use[c]); fail(msg); }
        }
        for (c = 0; c < m->ncall; c++) {
            int u;
            for (u = 0; u < nmod; u++) {
                if (u == k) continue;
                if (has_name(mods[u].loc, mods[u].nloc, m->call[c]) ||
                    (has_name(mods[u].pub, mods[u].npub, m->call[c]) && !has_name(mods[u].exp, mods[u].nexp, m->call[c]))) {
                    cx_fmt(msg, sizeof msg, "cxpack: not exported: %s from %s", m->call[c], mods[u].name);
                    fail(msg);
                } else if (has_name(mods[u].exp, mods[u].nexp, m->call[c]) && !has_name(m->use, m->nuse, mods[u].name)) {
                    cx_fmt(msg, sizeof msg, "cxpack: import missing for %s from %s", m->call[c], mods[u].name);
                    fail(msg);
                }
            }
        }
    }
    if (!fails) { cx_fmt(msg, sizeof msg, "cxpack: ok: %d modules", nmod); addlog(msg); }
    return fails;
}

static int expect(const char *dir, int want_fail, const char *needle) {
    int rc = check_dir(dir);
    if ((want_fail ? rc <= 0 : rc != 0) || (needle && !strstr(logb, needle))) {
        fprintf(stderr, "cxpack: fixture %s rc %d\n%s", dir, rc, logb);
        return 1;
    }
    printf("cxpack: fixture %s matched\n", dir);
    return 0;
}

static int include_case(void) {
    const char *dir = "/tmp/cxpack-inc";
    const char *tsv = "main\tmain.cx\t\nmark\tmark.cx\tpack_mark\n";
    const char *main_src = "#pragma unisa module main\n#pragma unisa use mark\nint main(void) { return pack_mark(1); }\n";
    const char *mark_src = "#include <stdio.h>\n#pragma unisa module mark\nint pack_mark(int n) { return n; }\n";
    char *o = 0; size_t n = 0; char path[512]; int rc;
    if (cx_run("rm -rf /tmp/cxpack-inc && mkdir -p /tmp/cxpack-inc", &o, &n) != 0) {
        fprintf(stderr, "cxpack: cannot prepare /tmp/cxpack-inc\n"); free(o); return 1;
    }
    free(o);
    if (cx_path_join(path, sizeof path, dir, "cxpack.tsv") || cx_write(path, tsv, strlen(tsv))) return 1;
    if (cx_path_join(path, sizeof path, dir, "main.cx") || cx_write(path, main_src, strlen(main_src))) return 1;
    if (cx_path_join(path, sizeof path, dir, "mark.cx") || cx_write(path, mark_src, strlen(mark_src))) return 1;
    rc = expect(dir, 1, "cxpack: module include: mark.cx");
    o = 0;
    cx_run("rm -rf /tmp/cxpack-inc", &o, &n);
    free(o);
    return rc;
}

static int at_root(void) {
    char *cdup = 0; size_t cl = 0; int rc = cx_run("git rev-parse --show-cdup", &cdup, &cl);
    int bad = rc != 0 || !cdup || cl > 1;
    free(cdup);
    if (bad) fprintf(stderr, "cxpack: run from the repo root\n");
    return bad ? -1 : 0;
}

int main(int argc, char **argv) {
    int bad = 0;
    if (at_root()) return 2;
    if (argc == 3 && !strcmp(argv[1], "--check")) {
        int rc = check_dir(argv[2]);
        return rc < 0 ? 2 : rc > 0 ? 1 : 0;
    }
    if (argc == 2 && !strcmp(argv[1], "--fixtures")) {
        bad += expect("tests/cxpack/ok", 0, "cxpack: ok: 2 modules");
        bad += expect("tests/cxpack/bad-use", 1, "cxpack: unknown import gone");
        bad += expect("tests/cxpack/bad-call", 1, "cxpack: not exported: pack_extra from mark");
        bad += expect("tests/cxpack/bad-export", 1, "cxpack: export is file-local: pack_hide in mark");
        bad += expect("tests/cxpack/bad-ident", 1, "cxpack: path identity: mark maps to mark.cx, row says other.cx");
        bad += include_case();
        if (bad) return 1;
        printf("cxpack: fixtures ok\n");
        return 0;
    }
    fprintf(stderr, "usage: cxpack.cx --check DIR | --fixtures\n");
    return 2;
}
