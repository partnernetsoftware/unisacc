/* check-pp-targets-lines.cx -- 逐行一致:exec/facts/pp-targets.tsv 的每一行
 * (os, arch, run_launch) 必须与 cx/compiler/targetname.cx 里生成的第 N 个分支逐字对应。
 *
 *   sh ./unisacc.com tools/check-pp-targets-lines.cx -- ROOT
 *
 * 断言(每个目标 4 条,共 24 条 + 3 条结构):
 *   - tn_at(N) 返回的 os/arch 等于表第 N 行的前两列
 *   - 生成文件里第 N 个 `#if/#elif defined(<os宏>) && defined(<arch宏>)` 的两个宏
 *     等于 exec/pp/predefines.tsv 里该 os / 该 arch 的首个宏
 *   - 该分支 `#define SELF_TARGET` 的值等于 "<os>/<arch>"
 *   - 该分支 `#define SELF_LAUNCH` 的值等于表第 N 行的第三列
 * 这样表的第三列(而不是只有当前宿主那一行)也被覆盖。
 */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use compiler.targetname

#define MAXT 8
static char root[4096];
static int asserts, failed;
static void die(const char *s) { fprintf(stderr, "check-pp-targets-lines: REFUSE %s errno=%d\n", s, errno); exit(2); }
static void ck(int ok, const char *what, const char *detail) {
    asserts++;
    if (!ok) failed++;
    printf("%s\t%s%s%s\n", ok ? "PASS" : "FAIL", what, detail && *detail ? "\t" : "", detail ? detail : "");
}
static char *slurp(const char *rel, size_t *n) {
    char p[4400];
    if (cx_fmt(p, sizeof p, "%s/%s", root, rel)) die("path");
    { char *s = cx_read(p, n); if (!s) die(rel); return s; }
}
/* 在一行里按 TAB 切第 k 段 */
static int col(const char *s, size_t n, int k, char *dst, size_t cap) {
    size_t at = 0; int i;
    for (i = 0; i < k; i++) { while (at < n && s[at] != '\t' && s[at] != '\n') at++; if (at >= n || s[at] == '\n') return 0; at++; }
    { size_t kk = 0; while (at < n && s[at] != '\t' && s[at] != '\n' && kk + 1 < cap) dst[kk++] = s[at++]; dst[kk] = 0; }
    return 1;
}
/* 从 predefines 里找 "os\t<name>\t<macro>" 或 "arch\t<name>\t<macro>" 的首个宏 */
static int first_macro(const char *pre, size_t pn, const char *kind, const char *name, char *dst, size_t cap) {
    size_t at = 0;
    while (at < pn) {
        size_t e = at; char a[32], b[32];
        while (e < pn && pre[e] != '\n') e++;
        if (e > at && pre[at] != '#') {
            if (col(pre + at, e - at, 0, a, sizeof a) && col(pre + at, e - at, 1, b, sizeof b) &&
                !strcmp(a, kind) && !strcmp(b, name)) {
                if (!col(pre + at, e - at, 2, dst, cap)) return 0;
                return 1;
            }
        }
        at = e + 1;
    }
    return 0;
}
/* 在生成文件里找第 n 个 "#if defined(X) && defined(Y)"(n 从 0 起),返回其后的
   SELF_TARGET / SELF_LAUNCH 值 */
static int branch(const char *g, size_t gn, int n, char *mo, size_t moc, char *ma, size_t mac, char *tgt, size_t tc, char *lnch, size_t lc, char *policy, size_t pc) {
    size_t at = 0; int seen = 0;
    while (at < gn) {
        size_t e = at;
        while (e < gn && g[e] != '\n') e++;
        if (e > at && (!memcmp(g + at, "#if defined(", 12) || !memcmp(g + at, "#elif defined(", 14))) {
            if (seen == n) {
                const char *p = g + at;
                const char *x = memchr(p, '(', (size_t)(e - at));
                const char *y;
                size_t k = 0;
                if (!x) return 0;
                x++;
                while (x < g + e && *x != ')') { if (k + 1 < moc) mo[k++] = *x; x++; }
                mo[k] = 0;
                y = x ? memchr(x, '(', (size_t)(g + e - x)) : 0;
                if (!y) return 0;
                y++; k = 0;
                while (y < g + e && *y != ')') { if (k + 1 < mac) ma[k++] = *y; y++; }
                ma[k] = 0;
                /* 该分支后两行是 #define SELF_TARGET / SELF_LAUNCH */
                { size_t q = e + 1; int got = 0;
                  while (q < gn && got < 3) {
                      size_t qe = q; char v[64];
                      while (qe < gn && g[qe] != '\n') qe++;
                      if (qe - q > 15 && !memcmp(g + q, "#define SELF_", 13)) {
                          size_t s = q; size_t kk = 0;
                          while (s < qe && g[s] != '"') s++;
                          s++;
                          while (s < qe && g[s] != '"' && kk + 1 < sizeof v) v[kk++] = g[s++];
                          v[kk] = 0;
                          if (!memcmp(g + q, "#define SELF_TARGET", 19)) { size_t j; for (j = 0; j + 1 < tc && v[j]; j++) tgt[j] = v[j]; tgt[j] = 0; got++; }
                          else if (!memcmp(g + q, "#define SELF_TAPE_DEFAULT", 25)) { size_t j; for (j = 0; j + 1 < pc && v[j]; j++) policy[j] = v[j]; policy[j] = 0; got++; }
                          else if (!memcmp(g + q, "#define SELF_LAUNCH", 19)) { size_t j; for (j = 0; j + 1 < lc && v[j]; j++) lnch[j] = v[j]; lnch[j] = 0; got++; }
                      }
                      q = qe + 1;
                  }
                  return got == 3; }
            }
            seen++;
        }
        at = e + 1;
    }
    return 0;
}
int main(int argc, char **argv) {
    size_t tn = 0, pn = 0, gn = 0;
    char *tab, *pre, *gen;
    char rows[MAXT][4][32];
    int n = 0, i;
    if (argc > 2) { fputs("usage: [ROOT]\n", stderr); return 2; }
    if (argc == 2) { if (!realpath(argv[1], root)) die("root"); }
    else { if (sy_cwd(root, sizeof root) < 0) die("cwd"); }
    tab = slurp("exec/facts/pp-targets.tsv", &tn);
    pre = slurp("exec/pp/predefines.tsv", &pn);
    gen = slurp("cx/sys/hostid.cx", &gn);
    { size_t at = 0;
      while (at < tn) {
          size_t e = at;
          while (e < tn && tab[e] != '\n') e++;
          if (e > at && tab[at] != '#') {
              if (n >= MAXT) die("table rows");
              if (!col(tab + at, e - at, 0, rows[n][0], sizeof rows[n][0]) ||
                  !col(tab + at, e - at, 1, rows[n][1], sizeof rows[n][1]) ||
                  !col(tab + at, e - at, 2, rows[n][2], sizeof rows[n][2]) ||
                  !col(tab + at, e - at, 3, rows[n][3], sizeof rows[n][3])) die("table cols");
              n++;
          }
          at = e + 1;
      } }
    ck(n == 6, "table-six-rows", "");
    ck(tn_at(0, 0, 0) == 4, "tn_at-null-out-returns-4", "");
    { const char *dummy_os = 0, *dummy_arch = 0;
      ck(tn_at(0, &dummy_os, &dummy_arch) == 0 && dummy_os && dummy_arch, "tn_at-row-0-reachable", "");
      ck(tn_at(n, &dummy_os, &dummy_arch) == 2, "tn_at-out-of-range-returns-2", ""); }
    for (i = 0; i < n; i++) {
        const char *os = 0, *arch = 0;
        char mo[32], ma[32], tgt[64], lnch[32], policy[32], want_os[32], want_arch[32], detail[200];
        int ok_at = tn_at(i, &os, &arch) == 0 && os && arch && !strcmp(os, rows[i][0]) && !strcmp(arch, rows[i][1]);
        if (cx_fmt(detail, sizeof detail, "row=%d %s/%s", i, rows[i][0], rows[i][1])) die("detail");
        ck(ok_at, "tn_at-matches-table-row", detail);
        if (!first_macro(pre, pn, "os", rows[i][0], want_os, sizeof want_os) ||
            !first_macro(pre, pn, "arch", rows[i][1], want_arch, sizeof want_arch)) die("predefines macros");
        if (!branch(gen, gn, i, mo, sizeof mo, ma, sizeof ma, tgt, sizeof tgt, lnch, sizeof lnch, policy, sizeof policy)) {
            if (cx_fmt(detail, sizeof detail, "branch=%d missing", i)) die("detail");
            ck(0, "generated-branch-present", detail);
            continue;
        }
        { char want[80];
          if (cx_fmt(detail, sizeof detail, "branch=%d %s+%s", i, mo, ma)) die("detail");
          ck(!strcmp(mo, want_os) && !strcmp(ma, want_arch), "branch-macros-match-predefines", detail); }
        if (cx_fmt(detail, sizeof detail, "branch=%d target=%s", i, tgt)) die("detail");
        { char want[80]; if (cx_fmt(want, sizeof want, "%s/%s", rows[i][0], rows[i][1])) die("want");
          ck(!strcmp(tgt, want), "branch-self-target-matches-table", detail); }
        if (cx_fmt(detail, sizeof detail, "branch=%d launch=%s table=%s", i, lnch, rows[i][2])) die("detail");
        ck(!strcmp(lnch, rows[i][2]), "branch-self-launch-matches-table", detail);
        ck(!strcmp(policy, rows[i][3]), "branch-tape-default-matches-table", detail);
        { char expected[80]; if(cx_fmt(expected,sizeof expected,"%s/%s",rows[i][0],rows[i][1]))die("policy target");
          ck(!strcmp(policy,!strcmp(rows[i][0],"osx")?expected:"lnx/x86_64"),"only-osx-tape-default-is-native",detail); }
    }
    printf("PP_TARGETS_LINES\tassertions=%d\tfailed=%d\n", asserts, failed);
    return failed ? 1 : 0;
}
