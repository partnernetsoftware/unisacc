/* CX0/E2 independent inventory and bounded local probes. No saved verdicts.
 * --list [--group cx0|e2|boundary]
 * --all [ROOT NEW_ABS_OUT MODEL READER] [--group cx0|e2|boundary]
 * --smoke NEW_ABS_OUT                         (only the finite planner probe)
 * --case ID [ROOT NEW_ABS_OUT MODEL READER]
 * bundle probe: --case probe.cx0.bundle NEW_ABS_OUT MODEL
 * E2 probe: --case probe.boundary.e2 NEW_ABS_OUT READER MODEL
 * Required parent contracts remain unsatisfied by finite probes. Original E2
 * cells are read from the canonical matrix; its historical results are ignored.
 * Unified --smoke/--case probe syntax also accepts ROOT NEW_OUT MODEL READER.
 * --all without inputs reports missing evidence. With inputs it runs bounded
 * finite leaves and still returns nonzero for every open parent contract.
 * allsession supplies existing checked IO, digest, clock and evidence helpers;
 * these local transcripts are not session receipts or cached verdicts. */
#pragma unisa use cxlib.allsession
typedef struct {char *id,*group,*kind,*implementation,*probe,*input,*expect,*source;} contract;
static contract rows[192];static int nrows;static char root[4096],work[4096],why[1700];static long long deadline;
static void die(const char *s){fprintf(stderr,"preprocess-suite: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void join(char out[4400],const char *a,const char *b){if(cx_path_join(out,4400,a,b))die("path-bound");}
static char *duplicate(const char *s){size_t n=strlen(s);char *p=malloc(n+1);if(!p)die("allocation");{void *cx_kept=memcpy(p,s,n+1);(void)cx_kept;}return p;}
static int split(char *s,char **f,int cap){int n=1;f[0]=s;for(char *p=s;*p;p++)if(*p=='\t'){if(n==cap)return -1;*p=0;f[n++]=p+1;}return n;}
static char *read_metadata(const char *name,size_t *n){char p[4400];join(p,root,name);char *s=as_read(p,0,n,why,sizeof why);if(!s)die(why);if(*n>1048576||memchr(s,0,*n)||(*n&&s[*n-1]!='\n'))die("metadata-shape");return s;}
static void add(char **f){
 if(nrows==192)die("inventory-bound");for(int j=0;j<8;j++)if(!f[j][0]||strchr(f[j],'\r'))die("empty-or-CR-field");
 for(int i=0;i<nrows;i++)if(!strcmp(rows[i].id,f[0]))die("duplicate-contract-id");
 if(strcmp(f[1],"cx0")&&strcmp(f[1],"e2")&&strcmp(f[1],"boundary"))die("group");
 if(strcmp(f[2],"contract")&&strcmp(f[2],"probe"))die("kind");
 if(strcmp(f[3],"PARTIAL")&&strcmp(f[3],"NOT_IMPLEMENTED")&&strcmp(f[3],"NEEDS_PRODUCT_CHANGE")&&strcmp(f[3],"NEEDS_FOREIGN_HOST")&&strcmp(f[3],"IMPLEMENTED"))die("implementation");
 if(!strcmp(f[2],"contract")&&!strcmp(f[3],"IMPLEMENTED"))die("required-contract-needs-evidence-mapping-before-implementation-status");
 contract *r=rows+nrows++;r->id=duplicate(f[0]);r->group=duplicate(f[1]);r->kind=duplicate(f[2]);r->implementation=duplicate(f[3]);r->probe=duplicate(f[4]);r->input=duplicate(f[5]);r->expect=duplicate(f[6]);r->source=duplicate(f[7]);
}
static void load(void){
 size_t n;char *s=read_metadata("tests/preprocess/contracts.tsv",&n),*line=s;int contracts=0,probes=0;
 while(*line){char *e=strchr(line,'\n');if(!e)die("fact-table-final-LF");*e=0;if(*line&&*line!='#'){char *f[8];if(split(line,f,8)!=8)die("fact-table-columns");add(f);if(!strcmp(f[2],"contract"))contracts++;else probes++;}line=e+1;}free(s);
 if(contracts!=27||probes!=3)die("CX0-eight-E2-eight-boundary-eleven-and-three-probes-required");
 s=read_metadata("tests/stream-e2-domain-matrix.tsv",&n);line=s;int local=0,foreign=0;
 while(*line){char *e=strchr(line,'\n');if(!e)die("E2-matrix-final-LF");*e=0;if(*line&&*line!='#'){
  char *f[9];if(split(line,f,9)!=9)die("E2-matrix-columns");if(!strcmp(f[2],"yes")){
   int native=!strcmp(f[0],"lnx/x86_64");char id[256],src[1200],input[256];
   int z=snprintf(id,sizeof id,"%s",f[1]);if(z<0||(size_t)z>=sizeof id)die("E2-id-bound");
   z=snprintf(src,sizeof src,"tests/stream-e2-domain-matrix.tsv; %s; oracle=%s",f[6],f[7]);if(z<0||(size_t)z>=sizeof src)die("E2-source-bound");
   z=snprintf(input,sizeof input,"host=%s; required original E2 cell; sealed-adapter migration",f[0]);if(z<0||(size_t)z>=sizeof input)die("E2-input-bound");
   char *record[]={id,"e2","contract",native?"NOT_IMPLEMENTED":"NEEDS_FOREIGN_HOST","-",input,f[5],src};add(record);if(native)local++;else foreign++;
  }
 }line=e+1;}free(s);
 /* The matrix may grow, but shrinking this declared baseline is an error. */
 if(local<62||foreign!=5)die("E2-required-baseline-missing");
 for(int i=0;i<nrows;i++)if(!strcmp(rows[i].kind,"contract")&&strcmp(rows[i].probe,"-")){
  int found=0;for(int j=0;j<nrows;j++)if(!strcmp(rows[i].probe,rows[j].id)&&!strcmp(rows[j].kind,"probe"))found++;if(found!=1)die("probe-reference");
 }
}
static int selected(const contract *r,const char *group){return !group||!strcmp(group,r->group);}
static void show(const contract *r,const char *status){printf("%s\t%s\tgroup=%s\tkind=%s\timplementation=%s\tprobe=%s\tinput=%s\texpected=%s\tsource=%s\n",status,r->id,r->group,r->kind,r->implementation,r->probe,r->input,r->expect,r->source);}
static int inventory(const char *group,int list){int required=0,probes=0;for(int i=0;i<nrows;i++)if(selected(rows+i,group)){if(!strcmp(rows[i].kind,"contract")){required++;show(rows+i,list?"CONTRACT":"NOT_COVERED");}else{probes++;show(rows+i,list?"PROBE":"NOT_RUN");}}
 printf("PREPROCESS_INVENTORY\trequired=%d\tfinite_probes=%d\texecuted=0\tmissing_evidence=%d\tqualification=NOT_QUALIFIED\n",required,probes,required);return list?0:3;
}
static void hash(const char *p,char out[65]){if(as_sha_file(p,1,out,0,why,sizeof why))die(why);}
static void save(const char *name,const char *s,size_t n){char p[4400];join(p,work,name);if(as_save_new(p,s,n,why,sizeof why))die(why);}
static int marker(const char *s,size_t n,const char *want){size_t wn=strlen(want),at=0;int found=0;while(at<n){size_t end=at;while(end<n&&s[end]!='\n')end++;if(end-at>=wn&&!memcmp(s+at,want,wn)&&(end-at==wn||s[at+wn]=='\t'))found++;at=end<n?end+1:end;}return found;}
static int probe(const contract *c,int argc,char **argv){
 int plan=!strcmp(c->probe,"plan"),bundle=!strcmp(c->probe,"bundle"),e2=!strcmp(c->probe,"e2");
 if((!plan&&!bundle&&!e2)||argc!=(plan?1:bundle?2:3))die("probe-arguments-see-source-usage");
 char outbase[4400],canonical_out[4096],parent[4096];join(outbase,root,"out");if(!realpath(outbase,canonical_out))die("root-out");
 if(argv[0][0]!='/'||strlen(argv[0])>=sizeof work||strpbrk(argv[0],"\t\r\n"))die("absolute-new-output-required");{void *cx_kept=memcpy(work,argv[0],strlen(argv[0])+1);(void)cx_kept;}
 char *slash=strrchr(work,'/');if(!slash||!slash[1])die("output-leaf");size_t plen=(size_t)(slash-work);if(plen>=sizeof parent)die("parent-bound");{void *cx_kept=memcpy(parent,work,plen);(void)cx_kept;}parent[plen]=0;
 char canon[4096];if(!realpath(parent,canon)||strcmp(parent,canon))die("canonical-output-parent");size_t base=strlen(canonical_out);if(strncmp(parent,canonical_out,base)||(parent[base]&&parent[base]!='/'))die("output-must-be-below-root-out");
 if(mkdir(work,0700))die("exclusive-probe-output");
 char candidate[4400],source[4400],childout[4400],model[4096],reader[4096],before[12][65],after[65],support[8][4400];join(candidate,root,"unisacc.com");join(source,root,c->source);join(childout,work,"cases");
 const char *deps[]={"cx/cx0/plan.cx","cx/cx0/bundle.cx","tests/preprocess/suite.cx","tests/preprocess/contracts.tsv","tests/stream-e2-domain-matrix.tsv","tools/cxlib/netpack.cx","tools/cxlib/allsession.cx","tools/cxlib/testplan.cx"};
 char *watched[12]={candidate,source,0,0};int nw=2;for(int i=0;i<8;i++){join(support[i],root,deps[i]);watched[nw++]=support[i];}
 if(bundle||e2){const char *mp=argv[bundle?1:2];if(!realpath(mp,model)||strcmp(model,mp))die("canonical-model");watched[nw++]=model;}
 if(e2){if(!realpath(argv[1],reader)||strcmp(reader,argv[1]))die("canonical-reader");watched[nw++]=reader;}
 for(int i=0;i<nw;i++)hash(watched[i],before[i]);
 np_buf args={0};char *v[12];int count=0;v[count++]="sh";v[count++]=candidate;v[count++]=source;v[count++]="--";v[count++]=root;
 if(e2){v[count++]=reader;v[count++]=model;v[count++]=childout;}else{v[count++]=childout;if(bundle)v[count++]=model;}v[count]=0;
 for(int i=0;i<count;i++){np_putll(&args,i);np_puts(&args,"\t");np_puts(&args,v[i]);np_puts(&args,"\n");}save("argv.tsv",args.p,args.n);free(args.p);
 int seconds=35;long long now=as_now();if(deadline&&now>=0){long long left=(deadline-now)/1000000000LL-3;if(left<1){printf("NOT_RUN\t%s\treason=outer-command-budget\n",c->id);return 3;}if(left<seconds)seconds=(int)left;}
 np_result r={0};long long start=as_now();int transport=np_run(v,root,0,seconds,&r,why,sizeof why);long long stop=as_now();int timed=transport&&strstr(why,"TimeoutExpired");
 save("stdout",r.out,r.outn);save("stderr",r.err,r.errn);if(transport)save("transport-error",why,strlen(why));
 int stable=1;for(int i=0;i<nw;i++){hash(watched[i],after);if(strcmp(before[i],after))stable=0;}
 const char *expected=plan?"CX0_UNIT":bundle?"CX0_BUNDLE":"CX0_E2";
 int ok=!transport&&!r.rc&&stable&&marker(r.out,r.outn,expected)==1&&!marker(r.out,r.outn,"FAIL");
 np_buf identity={0};np_puts(&identity,"SCOPE\tlocal-live-content-before-and-after;not-atomic-snapshot;no-session-qualification\n");for(int i=0;i<nw;i++){np_puts(&identity,watched[i]);np_puts(&identity,"\t");np_puts(&identity,before[i]);np_puts(&identity,"\n");}save("identity.tsv",identity.p,identity.n);free(identity.p);
 char status[600];int z=snprintf(status,sizeof status,"status\t%s\nrc\t%d\ntransport\t%d\nidentity_stable\t%d\nchild_elapsed_ns\t%lld\n",ok?"PASS":timed?"TIMEOUT":"FAIL",r.rc,transport,stable,start>=0&&stop>=start?stop-start:-1LL);if(z<0||(size_t)z>=sizeof status)die("status-bound");save("status.tsv",status,(size_t)z);
 if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.errn)fwrite(r.err,1,r.errn,stderr);
 printf("PREPROCESS_PROBE\tid=%s\tstatus=%s\trc=%d\ttransport=%d\tidentity_stable=%d\tcandidate=%s\thost=lnx/x86_64\ttarget=lnx/x86_64\tscope=finite-local-probe-no-U1-U2-qualification\n",c->id,ok?"PASS":timed?"TIMEOUT":"FAIL",r.rc,transport,stable,before[0]);
 puts("TIMING\tchild_compile_and_execute_ns=see-status.tsv\tstartup_construction_loading_inference_output_validation_cold_hot=UNMEASURED");np_free(&r);return ok?0:timed?3:1;
}
static int unified(const contract *c,char **v){char canonical[4096];if(!realpath(v[0],canonical)||strcmp(canonical,v[0])||strcmp(canonical,root))die("ROOT-must-match-suite-repository");char *p[3];p[0]=v[1];if(!strcmp(c->probe,"plan"))return probe(c,1,p);if(!strcmp(c->probe,"bundle")){p[1]=v[2];return probe(c,2,p);}p[1]=v[3];p[2]=v[2];return probe(c,3,p);}
static int leaf_selected(const contract *c,const char *group){if(selected(c,group))return 1;for(int i=0;i<nrows;i++)if(selected(rows+i,group)&&!strcmp(rows[i].probe,c->id))return 1;return 0;}
static int run_leaves(char **v,const char *group){
 char canonical[4096],output_parent[4096],base[4400],outcanon[4096];if(!realpath(v[0],canonical)||strcmp(canonical,v[0])||strcmp(canonical,root))die("ROOT-must-match-suite-repository");
 size_t vn=strlen(v[1]);if(v[1][0]!='/'||vn>=sizeof output_parent||strpbrk(v[1],"\t\r\n"))die("absolute-wave-output");{void *cx_kept=memcpy(output_parent,v[1],vn+1);(void)cx_kept;}char *last=strrchr(output_parent,'/');if(!last||!last[1])die("wave-output-leaf");*last=0;if(!realpath(output_parent,canonical)||strcmp(canonical,output_parent))die("canonical-wave-parent");join(base,root,"out");if(!realpath(base,outcanon))die("root-out");size_t bn=strlen(outcanon);if(strncmp(canonical,outcanon,bn)||(canonical[bn]&&canonical[bn]!='/'))die("wave-output-below-root-out");
 if(mkdir(v[1],0700))die("exclusive-wave-output");int fail=0,executed=0;
 for(int i=0;i<nrows;i++)if(!strcmp(rows[i].kind,"probe")&&leaf_selected(rows+i,group)){
  long long now=as_now();if(now<0)die("monotonic-clock");if(deadline-now<5000000000LL){printf("NOT_RUN\t%s\treason=outer-command-budget;use-single-case-to-run\n",rows[i].id);continue;}
  char leaf[4400];join(leaf,v[1],rows[i].probe);char *args[]={v[0],leaf,v[2],v[3]};int rc=unified(rows+i,args);executed++;if(rc==1||rc==2)fail++;
 }
 printf("PREPROCESS_WAVE\tfinite_leaf_attempts=%d\tfailed=%d\tqualification=NOT_QUALIFIED\tnext=run-any-budget-skipped-leaf-with--case\n",executed,fail);return fail?1:3;
}
int main(int argc,char **argv){
 long long started=as_now();if(started<0)die("monotonic-clock");deadline=started+35000000000LL;
 const char *outer=getenv("UNISACC_BOUND_DEADLINE_MONO");if(outer&&*outer){char *end;double limit=strtod(outer,&end);if(*end||limit<=(double)started/1e9)die("outer-deadline");if(limit<(double)deadline/1e9)deadline=(long long)(limit*1e9)-2000000000LL;}
 char source[4096];if(!realpath(argv[0],source))die("source-location");const char *suffix="/tests/preprocess/suite.cx";size_t sn=strlen(source),tail=strlen(suffix);if(sn<=tail||strcmp(source+sn-tail,suffix))die("source-layout");source[sn-tail]=0;{void *cx_kept=memcpy(root,source,sn-tail+1);(void)cx_kept;}load();
 if(argc<2)die("usage --list | --all [ROOT NEW_OUT MODEL READER] | --smoke NEW_OUT | --case ID [NEW_OUT [READER MODEL]]");
 if(!strcmp(argv[1],"--case")){if(argc<3)die("case-id-required");for(int i=0;i<nrows;i++)if(!strcmp(argv[2],rows[i].id)){if(!strcmp(rows[i].kind,"probe"))return argc==7?unified(rows+i,argv+3):probe(rows+i,argc-3,argv+3);if(argc!=3&&argc!=7)die("contract-case-takes-ID-or-ID-ROOT-OUT-MODEL-READER");show(rows+i,"NOT_COVERED");if(argc==7&&strcmp(rows[i].probe,"-")){for(int j=0;j<nrows;j++)if(!strcmp(rows[j].id,rows[i].probe)){int rc=unified(rows+j,argv+3);printf("PREPROCESS_CONTRACT\tid=%s\tfinite_probe_rc=%d\tfull_contract=NOT_COVERED\n",rows[i].id,rc);return rc==1||rc==2?rc:3;}}return 3;}die("unknown-contract-id");}
 if(!strcmp(argv[1],"--smoke")){if(argc!=3&&argc!=6)die("smoke-requires-NEW_OUT-or-ROOT-NEW_OUT-MODEL-READER");for(int i=0;i<nrows;i++)if(!strcmp(rows[i].id,"probe.cx0.plan"))return argc==6?unified(rows+i,argv+2):probe(rows+i,1,argv+2);die("planner-probe-missing");}
 int list=!strcmp(argv[1],"--list"),all=!strcmp(argv[1],"--all");if(!list&&!all)die("unknown-mode");const char *group=0;char **inputs=0;
 for(int i=2;i<argc;i++){if(!strcmp(argv[i],"--group")){if(group||++i==argc)die("group-argument");group=argv[i];if(strcmp(group,"cx0")&&strcmp(group,"e2")&&strcmp(group,"boundary"))die("unknown-group");}else if(all&&!inputs&&i+3<argc){inputs=argv+i;i+=3;}else die("mode-arguments");}
 int rc=inventory(group,list);if(inputs)return run_leaves(inputs,group);return rc;
}
