/* Independent CX -> classic-C projection controls. ROOT NEW_ABS_OUT.
 * Handwritten inserted C gold checks file-scope privacy conversion while local
 * statics, strings and comments survive. No live product source is mutated. */
#pragma unisa use cxlib.allsession
static char root[4096],work[4096],generator[4400],candidate[4400],why[1700];
static int assertions,failed,calls;static long long deadline;
static void die(const char *s){fprintf(stderr,"cx0-projection-test: %s errno=%d\n",s,errno);exit(2);}
static void path(char out[4400],const char *a,const char *b){if(cx_path_join(out,4400,a,b))die("path-bound");}
static void ck(int ok,const char *s){assertions++;if(!ok)failed++;printf("%s\tcx0-projection.%s\n",ok?"PASS":"FAIL",s);}
static char *read_checked(const char *file,size_t *n){char *p=as_read(file,1,n,why,sizeof why);if(!p)die(why);return p;}
static void put(const char *file,const void *p,size_t n){if(cx_write(file,p,n))die("write-owned-fixture");}
static char *insert(const char *source,const char *anchor,const char *text){const char *at=strstr(source,anchor);if(!at||strstr(at+1,anchor))die("fixture-anchor");at+=strlen(anchor);size_t n=strlen(source),a=(size_t)(at-source),m=strlen(text);char *p=malloc(n+m+1);if(!p)die("allocation");memcpy(p,source,a);memcpy(p+a,text,m);memcpy(p+a+m,source+a,n-a+1);return p;}
static int missing(const char *file){struct stat st;if(!lstat(file,&st))return 0;if(errno!=ENOENT)die("missing-file-stat");return 1;}
static int equals(const char *file,const void *p,size_t n){size_t z;char *b=read_checked(file,&z);int same=z==n&&!memcmp(p,b,n);free(b);return same;}
static np_result invoke(int check,const char *source,const char *output){
 char *v[12];int n=0;v[n++]="sh";v[n++]=candidate;v[n++]=generator;v[n++]="--";if(check)v[n++]="--check";if(source){v[n++]="--source";v[n++]=(char *)source;}if(output){v[n++]="--output";v[n++]=(char *)output;}v[n]=0;
 long long left=(deadline-as_now())/1000000000LL;if(left<2)die("total-budget-exhausted");int seconds=left<12?(int)left:12;np_result r={0};if(np_run(v,root,0,seconds,&r,why,sizeof why))die(why);
 char name[100],file[4400];snprintf(name,sizeof name,"%02d.stdout",++calls);path(file,work,name);put(file,r.out,r.outn);snprintf(name,sizeof name,"%02d.stderr",calls);path(file,work,name);put(file,r.err,r.errn);
 snprintf(name,sizeof name,"%02d.status",calls);path(file,work,name);char status[80];int z=snprintf(status,sizeof status,"rc\t%d\n",r.rc);if(z<0||(size_t)z>=sizeof status)die("status-bound");put(file,status,(size_t)z);return r;
}
int main(int argc,char **argv){
 if(argc!=3||!realpath(argv[1],root)||argv[2][0]!='/'||strlen(argv[2])>=sizeof work)die("usage ROOT NEW_ABS_OUT");memcpy(work,argv[2],strlen(argv[2])+1);if(mkdir(work,0700))die("exclusive-output");deadline=as_now()+40000000000LL;
 path(generator,root,"tools/cx0-extract.cx");path(candidate,root,"unisacc.com");char live[4400],module[4400],prefix[4400],generated[4400],changed_source[4400],changed_c[4400],bad_source[4400],absent[4400],never[4400];
 path(live,root,"src/cxmod.c");path(module,root,"cx/cx0/plan.cx");path(prefix,root,"cx/cx0/compat-prefix.c.in");path(generated,work,"projected.c");path(changed_source,work,"changed-plan.cx");path(changed_c,work,"changed.c");path(bad_source,work,"missing-marker.cx");path(absent,work,"absent.c");path(never,work,"never.c");
 char *watched[]={live,module,prefix,generator,candidate};char before[5][65],after[65];for(int i=0;i<5;i++)if(as_sha_file(watched[i],1,before[i],0,why,sizeof why))die(why);
 size_t cn,mn;char *classic=read_checked(live,&cn),*cx=read_checked(module,&mn);np_result r=invoke(0,0,generated);ck(!r.rc&&!r.errn&&strstr(r.out,"PREPARED"),"generate-from-authoritative-CX");np_free(&r);ck(equals(generated,classic,cn),"compatibility-output-byte-identical-to-live-C");
 struct stat prior,after_stat;if(stat(generated,&prior))die("generated-stat");r=invoke(1,0,generated);ck(!r.rc&&!r.errn&&strstr(r.out,"EXACT"),"check-exact-projection");np_free(&r);if(stat(generated,&after_stat))die("generated-after-stat");ck(prior.st_dev==after_stat.st_dev&&prior.st_ino==after_stat.st_ino,"check-does-not-replace-output");
 char *corrupt=malloc(cn);if(!corrupt)die("allocation");memcpy(corrupt,classic,cn);corrupt[0]='X';put(generated,corrupt,cn);r=invoke(1,0,generated);ck(r.rc==2&&!r.outn&&strstr(r.err,"generated-classic-projection-differs"),"check-refuses-changed-C");np_free(&r);ck(equals(generated,corrupt,cn),"check-does-not-repair-or-truncate");free(corrupt);
 r=invoke(0,0,generated);ck(!r.rc&&!r.errn&&equals(generated,classic,cn),"generation-repairs-owned-stale-projection");np_free(&r);if(stat(generated,&prior))die("repaired-stat");r=invoke(0,0,generated);ck(!r.rc&&!r.errn&&strstr(r.out,"UNCHANGED"),"generation-recognizes-exact-bytes");np_free(&r);if(stat(generated,&after_stat))die("unchanged-stat");ck(prior.st_dev==after_stat.st_dev&&prior.st_ino==after_stat.st_ino,"unchanged-generation-does-not-replace");
 r=invoke(1,0,absent);ck(r.rc==2&&!r.outn&&strstr(r.err,"projection-differs")&&missing(absent),"check-missing-output-never-publishes");np_free(&r);
 const char *cx_insert="/* static int cxm_comment; braces { } */\nstatic int cxm_projection_private(void) { static int saved; const char *s=\"static int cxm_literal\"; return saved+(s[0]=='s'); }\n";
 const char *c_insert="/* static int cxm_comment; braces { } */\nint cxm_projection_private(void) { static int saved; const char *s=\"static int cxm_literal\"; return saved+(s[0]=='s'); }\n";
 char *changed=insert(cx,"#define CXM_MAXU 64\n",cx_insert),*expected=insert(classic,"#define CXM_MAXU 64\n",c_insert);put(changed_source,changed,strlen(changed));free(changed);r=invoke(0,changed_source,changed_c);ck(!r.rc&&!r.errn&&equals(changed_c,expected,strlen(expected)),"CX-edit-propagates-with-handwritten-visibility-gold");np_free(&r);free(expected);
 char *marker=strstr(cx,"/* CX0_COMPAT_BODY_BEGIN */");if(!marker)die("marker-fixture");marker[0]='X';put(bad_source,cx,mn);r=invoke(0,bad_source,never);ck(r.rc==2&&!r.outn&&strstr(r.err,"body-markers-required")&&missing(never),"missing-body-marker-refused-without-output");np_free(&r);free(cx);
 r=invoke(0,0,module);ck(r.rc==2&&!r.outn&&strstr(r.err,"must-not-alias-source-or-prefix"),"generation-cannot-overwrite-CX-authority");np_free(&r);
 for(int i=0;i<5;i++){if(as_sha_file(watched[i],1,after,0,why,sizeof why))die(why);char label[80];snprintf(label,sizeof label,"input-%d-byte-unchanged",i);ck(!strcmp(before[i],after),label);}free(classic);
 printf("CX0_PROJECTION\tassertions=%d\tfailed=%d\tclassic_sha256=%s\tscope=CX-authority-classic-byte-projection-no-product-rebuild\n",assertions,failed,before[0]);return failed?1:0;
}
