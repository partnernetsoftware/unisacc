/* Compile through the explicit driver with a generated native runtime
 * provider, then execute with one new writable output-file argument. */
#pragma unisa use runtime_native_state
static int checks,failed;
static void ck(int ok,const char *name){checks++;if(!ok)failed++;fprintf(stdout,"%s\truntime-native.%s\n",ok?"PASS":"FAIL",name);}
int main(int argc,char **argv){
 if(argc!=2)return 2;char *p=rn_allocate();int captured_errno=errno;
 ck(p&&!strcmp(p,"producer")&&captured_errno==37,"cross-unit-allocation-and-errno");
 if(p){strcpy(p,"consumer");ck(rn_validate(p),"consumer-write-visible-to-producer");free(p);}else ck(0,"consumer-write-visible-to-producer");
 char *q=rn_allocate();ck(q&&!strcmp(q,"producer"),"producer-allocation-after-consumer-free");free(q);
 FILE *f=rn_open(argv[1]);if(f){fputs("consumer",f);if(fclose(f))f=0;}size_t n=0;char *s=f?cx_read(argv[1],&n):0;
 ck(s&&n==17&&!memcmp(s,"producer-consumer",17),"cross-unit-stdio-buffer-and-close");free(s);
 ck(rn_invalid_group(),"native-setpgid-invalid-pid-errno");
 fprintf(stdout,"RUNTIME_NATIVE\tassertions=%d\tfailed=%d\n",checks,failed);return failed?1:0;
}
