#pragma unisa module runtime_native_state
/* Runtime allocation/errno/stdio definitions live in the single native
 * provider. This consumer module owns no libc state of its own. */
char *rn_allocate(void){char *p=malloc(64);if(p)strcpy(p,"producer");errno=37;return p;}
int rn_validate(const char *p){return !strcmp(p,"consumer");}
FILE *rn_open(const char *path){FILE *f=fopen(path,"wb");if(f)fputs("producer-",f);return f;}
int rn_invalid_group(void){errno=0;int rc=setpgid(-1,0);return rc==-1&&errno==EINVAL;}
