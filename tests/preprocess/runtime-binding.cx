#pragma unisa use cxlib.netpack
static char work[4096],headers[4400],provider[4400],entry[4400],profile[4400];static char **args;static int checks,failed;
static void die(const char *s){fprintf(stderr,"runtime-binding-test: %s errno=%d\n",s,errno);exit(2);}
static void path(char *p,const char *s){if(cx_path_join(p,4400,work,s))die("path");}
static void save(const char *s,const char *text){char p[4400];path(p,s);if(cx_write(p,text,strlen(text)))die("write");}
static void config(const char *ps,const char *ds){char text[28000];int n=snprintf(text,sizeof text,"CXDRIVER1\nTarget\tlnx/x86_64\nHeaderRoot\t%s\nStreams\t%s\nE2Adapter\t%s\nStageAdapter\t%s\nPipeline\t%s\nProduct\t%s\nRuntimeProvider\t%s\nRuntimeProviderSHA\t%s\nRuntimeDeclarationsSHA\t%s\n",headers,args[3],args[4],args[5],args[6],args[7],provider,ps,ds);if(n<0||(size_t)n>=sizeof text)die("config");save("profile.tsv",text);}
static void run(const char *label,int want,const char *reason){char out[4400],why[1024];path(out,label);char *v[]={args[2],"--profile",profile,"--out",out,entry,0};np_result r={0};if(np_run(v,args[1],0,12,&r,why,sizeof why))die(why);int ok=r.rc==want&&!r.outn&&(reason?strstr(r.err,reason)!=0:!r.errn);if(reason){char p[4600];if(cx_path_join(p,sizeof p,out,"pipeline"))die("path");struct stat st;errno=0;ok=ok&&lstat(p,&st)&&errno==ENOENT;}
 checks++;if(!ok){failed++;fprintf(stderr,"%s rc=%d stderr=%s\n",label,r.rc,r.err);}printf("%s\truntime-binding.%s\n",ok?"PASS":"FAIL",label);np_free(&r);}
int main(int argc,char **argv){if(argc!=9||argv[8][0]!='/'||strlen(argv[8])>=sizeof work)die("ROOT DRIVER STREAMS E2 STAGE PIPELINE PRODUCT NEW_OUT");args=argv;strcpy(work,argv[8]);if(mkdir(work,0700))die("exclusive-out");path(headers,"headers");if(mkdir(headers,0700))die("headers");path(provider,"runtime.c");path(entry,"entry.cx");path(profile,"profile.tsv");
 const char *h="int runtime_value(void);\n",*p="int runtime_value(void){return 7;}\n";char hh[65],ph[65],dh[65],manifest[200],duplicate[400];cx_sha256_hex(h,strlen(h),hh);cx_sha256_hex(p,strlen(p),ph);snprintf(manifest,sizeof manifest,"I\tcx.h\t%s\n",hh);cx_sha256_hex(manifest,strlen(manifest),dh);save("headers/cx.h",h);save("headers/declaration-identity.tsv",manifest);save("runtime.c",p);save("entry.cx","int main(void){return runtime_value();}\n");config(ph,dh);run("matching-pair",7,0);
 save("runtime.c","int runtime_value(void){return 9;}\n");run("wrong-provider",2,"runtime-provider-sha-mismatch");save("runtime.c",p);
 save("headers/cx.h","int runtime_value(void); /* changed */\n");run("wrong-header",2,"runtime-declaration-header-sha-mismatch");save("headers/cx.h",h);
 save("headers/declaration-identity.tsv","I\tcx.h\tbad\n");run("wrong-manifest",2,"runtime-declarations-sha-mismatch");
 snprintf(duplicate,sizeof duplicate,"%s%s",manifest,manifest);char dd[65];cx_sha256_hex(duplicate,strlen(duplicate),dd);save("headers/declaration-identity.tsv",duplicate);config(ph,dd);run("duplicate-header",2,"runtime-declaration-duplicate");save("headers/declaration-identity.tsv",manifest);config(ph,dh);
 save("headers/unlisted.h","int extra;\n");run("unlisted-header",2,"runtime-declaration-unlisted-header");char extra[4400];path(extra,"headers/unlisted.h");if(unlink(extra))die("unlink");
 const char *other="int runtime_value(void){return 9;}\n";save("headers/runtime.c",other);run("wrong-provider-resource",2,"runtime-provider-resource-sha-mismatch");char oh[65],om[400],od[65];cx_sha256_hex(other,strlen(other),oh);snprintf(om,sizeof om,"%sI\truntime.c\t%s\n",manifest,oh);cx_sha256_hex(om,strlen(om),od);save("headers/declaration-identity.tsv",om);config(ph,od);run("listed-wrong-provider-resource",2,"runtime-provider-resource-sha-mismatch");save("headers/declaration-identity.tsv",manifest);config(ph,dh);path(extra,"headers/runtime.c");if(unlink(extra))die("unlink");
 path(extra,"headers/declaration-identity.tsv");if(unlink(extra))die("unlink");run("missing-manifest",2,"runtime-declarations-missing");save("headers/declaration-identity.tsv",manifest);
 const char *xh="int extra;\n";char xs[65],xm[400],xd[65];cx_sha256_hex(xh,strlen(xh),xs);snprintf(xm,sizeof xm,"%sI\tx\t%s\n",manifest,xs);cx_sha256_hex(xm,strlen(xm),xd);save("headers/x",xh);save("headers/declaration-identity.tsv",xm);config(ph,xd);run("single-byte-header-name",7,0);path(extra,"headers/x");if(unlink(extra))die("unlink");save("headers/declaration-identity.tsv",manifest);config(ph,dh);
 run("recovery",7,0);printf("RUNTIME_BINDING\tassertions=%d\tfailed=%d\n",checks,failed);return failed?1:0;}
