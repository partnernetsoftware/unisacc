/* ROOT PRODUCT PACKAGE NEW_ABS_OUT [--installed]. Default fast-lane mode retains
 * the old product's long-name failure and checks a private package. --installed
 * requires ROOT/unisacc.com and checks the installed fix without an override.
 * Child bound5/transport6 match the existing header-location contract. */
#pragma unisa use cxlib.netpack
static char root[4096],product[4096],package[4096],work[4096],bound[4400];static int checks,failed,seq;
static void die(const char *s){fprintf(stderr,"pp-fullname: %s errno=%d\n",s,errno);exit(2);}
static void ck(int ok,const char *s){checks++;if(!ok)failed++;printf("%s\tpp-fullname.%s\n",ok?"PASS":"FAIL",s);}
static void path(char p[4400],const char *leaf){if(cx_path_join(p,4400,work,leaf))die("path");}
static void save(const char *p,const char *s){if(cx_write(p,s,strlen(s)))die("save");}
static void hash(const char *p,char h[65]){size_t n;char *s=cx_read(p,&n);if(!s)die("hash");cx_sha256_hex(s,n,h);free(s);}
static np_result run(const char *source,const char *header,int pp,int private,const char *name){char *v[16];int k=0;v[k++]=bound;v[k++]="5";v[k++]="sh";v[k++]=product;if(private){v[k++]="--models";v[k++]=package;}if(pp)v[k++]="-E";v[k++]="-include";v[k++]=(char *)header;v[k++]=(char *)source;v[k]=0;np_result r={0};char why[1200];int transport=np_run(v,work,0,6,&r,why,sizeof why);char file[4400],leaf[200];snprintf(leaf,sizeof leaf,"%02d-%s.stdout",++seq,name);path(file,leaf);if(cx_write(file,r.out,r.outn))die("stdout");snprintf(leaf,sizeof leaf,"%02d-%s.stderr",seq,name);path(file,leaf);if(cx_write(file,r.err,r.errn))die("stderr");if(transport)die(why);return r;}
int main(int argc,char **argv){
 int installed=argc==6&&!strcmp(argv[5],"--installed");if((argc!=5&&!installed)||!realpath(argv[1],root)||!realpath(argv[2],product)||!realpath(argv[3],package)||argv[4][0]!='/'||strlen(argv[4])>=sizeof work)die("usage ROOT PRODUCT PACKAGE NEW_ABS_OUT [--installed]");if(installed){char expected[4400];if(cx_path_join(expected,sizeof expected,root,"unisacc.com")||strcmp(product,expected))die("installed-product-required");}strcpy(work,argv[4]);if(mkdir(work,0700))die("exclusive-output");if(cx_path_join(bound,sizeof bound,root,"tools/bound"))die("bound");char before_product[65],before_package[65],after[65];hash(product,before_product);hash(package,before_package);
 char header[4400],source[4400],sim[4400],text[14000];path(header,"semantic-header-name-over-sixty-two-bytes.h");path(source,"long-name.c");if(strlen(header)<=62)die("long-name-fixture-domain");save(header,"const char *before=__FILE__;\nconst char *after=__FILE__;\nint afterline=__LINE__;\n");int z=snprintf(text,sizeof text,"static int eq(const char *a,const char *b){int i=0;while(a[i]&&a[i]==b[i])i++;return a[i]==b[i];}\n#line 77\nint main(void){const char *want=\"%s\";return !eq(before,want)||!eq(after,want)||afterline!=3||__LINE__!=77||!eq(__FILE__,\"%s\");}\n",header,source);if(z<0||(size_t)z>=sizeof text)die("main-bound");save(source,text);
 np_result old=run(source,header,0,0,"long-base"),fresh=run(source,header,0,1,"long-package");ck(old.rc==(installed?0:1)&&!old.outn&&!old.errn,installed?"installed-full-name-and-line-inheritance":"installed-long-name-failure-retained");ck(!fresh.rc&&!fresh.outn&&!fresh.errn,"package-full-name-and-line-inheritance");np_free(&old);np_free(&fresh);
 path(sim,"sim-input.c");z=snprintf(text,sizeof text,"#include \"%s\"\n#line 77\nconst char *sourcefile=__FILE__;\n",header);if(z<0||(size_t)z>=sizeof text)die("sim-bound");save(sim,text);
 char inner[4400];path(inner,"inner.h");save(inner,"const char *inner_file=__FILE__;\nint inner_line=__LINE__;\n");const char *heads[]={"#define V 3\n","#define V 1 \\\n+2\nconst char *f=__FILE__;\n","#define V 1 \\\r\n+2\r\nconst char *f=__FILE__;\r\n","#line 77\nconst char *f=__FILE__;\nint n=__LINE__;\n","#line 88 \"virtual-name.h\"\nconst char *f=__FILE__;\n","#include \"inner.h\"\nconst char *f=__FILE__;\n","/* a */\n#define STR(X) #X\nconst char *s=STR(x);\n","#define D(x) ((x)+(x))\nint v=D(3);\n"};
 for(int i=0;i<8;i++){char leaf[100],relative[100],label[100];snprintf(relative,sizeof relative,"short-%d.h",i);path(header,relative);save(header,heads[i]);snprintf(leaf,sizeof leaf,"short-%d.c",i);path(source,leaf);save(source,"int after_header=__LINE__;\n");snprintf(label,sizeof label,"short-%d-base",i);old=run(source,relative,1,0,label);snprintf(label,sizeof label,"short-%d-private",i);fresh=run(source,relative,1,1,label);snprintf(label,sizeof label,"short-%d-byte-equivalent",i);int expected=(i==3||i==4)?1:0;ck(old.rc==expected&&fresh.rc==expected&&old.outn==fresh.outn&&old.errn==fresh.errn&&!memcmp(old.out,fresh.out,old.outn)&&!memcmp(old.err,fresh.err,old.errn),label);np_free(&old);np_free(&fresh);}
 path(header,"rejected-header-line-over-sixty-two-bytes.h");path(source,"header-line-refusal.c");save(header,"#line 77\nconst char *f=__FILE__;\n");save(source,"int main(void){return 0;}\n");old=run(source,header,0,0,"header-line-base");fresh=run(source,header,0,1,"header-line-private");ck(old.rc==1&&!old.outn&&strstr(old.err,"not covered: this form of #line"),"installed-header-line-named-refusal");ck(fresh.rc==1&&!fresh.outn&&strstr(fresh.err,"not covered: this form of #line"),"private-header-line-named-refusal");np_free(&old);np_free(&fresh);
 hash(product,after);ck(!strcmp(before_product,after),"installed-candidate-unchanged");hash(package,after);ck(!strcmp(before_package,after),"package-unchanged");printf("PP_FULLNAME\tassertions=%d\tfailed=%d\tscope=%s\n",checks,failed,installed?"installed-product-plus-explicit-package":"baseline-red-vs-explicit-package");return failed?1:0;
}
