/* Authentication component verdict only, not invocation/ABI. Production probe checks actual registry/frame state. */
#include "cx.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
static int status(const char *d,const char*n,int expected){char p[4096];size_t z;snprintf(p,sizeof p,"%s/%s/status",d,n);char*b=cx_read(p,&z);if(!b)return 2;int okay=atoi(b)==expected;free(b);return okay?0:1;}
static int empty(const char*d,const char*n){char p[4096];size_t z;snprintf(p,sizeof p,"%s/%s/stdout",d,n);char*b=cx_read(p,&z);if(!b)return 2;free(b);return z?1:0;}
static int text(const char*d,const char*n,const char*needle){char p[4096];size_t z;snprintf(p,sizeof p,"%s/%s/stderr",d,n);char*b=cx_read(p,&z);if(!b)return 2;int okay=strstr(b,needle)!=NULL;free(b);return okay?0:1;}
int main(int argc,char**argv){if(argc!=2)return 2;const char*d=argv[1];if(status(d,"auth-AA",0)||status(d,"auth-AB",1)||empty(d,"auth-AA")||empty(d,"auth-AB"))return 1;
 if(text(d,"auth-AA","candidate-auth rc=0 named= output_committed=1")||text(d,"auth-AB","candidate-auth rc=1 named=native callable lacks frozen candidate declaration output_committed=0"))return 1;
 puts("candidate authentication AA accepted, AB named-refused without commit; no invocation/ABI claim");return 0;}
