#!/usr/bin/env -S unisacc.com -run
/* Record frozen NEG evidence only. No model/oracle execution, no gate authority. */
static int check(const char*root,const char*name,const char*sha,size_t want){char path[4096],h[65],*b;size_t n;snprintf(path,sizeof path,"%s/%s",root,name);b=cx_read(path,&n);if(!b)return 0;cx_sha256_hex(b,n,h);free(b);return n==want&&!strcmp(h,sha);}
int main(int argc,char**argv){char path[4096],*b;size_t n;if(argc!=2){fprintf(stderr,"usage: lowernegledger.cx FROZEN_RED_DIR\n");return 2;}
 if(!check(argv[1],"input.bytes","ce773b87709a04bbcb0ead74fea94b1f20fa4a4d185fc06a24a9bc703dd99613",2)||!check(argv[1],"output.bytes","034ed2cdf94706615f4cad4cae78c5dd8d31494f140b9aa05f71d2c8660cd286",106)){fprintf(stderr,"NEG evidence integrity FAIL; STOP\n");return 1;}
 snprintf(path,sizeof path,"%s/status.txt",argv[1]);b=cx_read(path,&n);if(!b||n!=2||memcmp(b,"0\n",2)){fprintf(stderr,"NEG model rc missing/changed; STOP\n");return 1;}free(b);
 if(!check(argv[1],"comparison.tsv","4d5ea512a6c511e1fe8bb3fa3c83567db3604d46d3cf12be9afe37237ae108b4",319)||!check(argv[1],"reference-diagnostic.txt","f2fa0674bd1e1319e68339506c597e92645b61009f166f4fe1672f1a6d605477",39)){fprintf(stderr,"NEG reference record integrity FAIL; STOP\n");return 1;}
 /* capture.stderr is an observer's wrapper message, not model/reference verdict evidence. */
 puts("NEG-001 RECORDED EXPECTED_RED NEEDS_RULING: model rc0/106 bytes, reference rc1/empty stdout; refusal owner undecided; no PASS, no live rerun, no reuse grant");return 77;
}
