/* tests/check-limits.cx -- FAST-3: one fact, one value, across tables and code.
 *
 *   sh ./unisacc.com tests/check-limits.cx [LIMITS.tsv]
 *
 * T1 proves each net equals its own table; it cannot see two tables disagreeing.
 * The 65-source bug was exactly that: one table said 128, another still said 64.
 * Every row of exec/facts/limits.tsv names a file and the exact text it must
 * contain; all rows of one name must carry one value.  Also: the whole-o source
 * list in release-build and the object list in entry-build must be the same set. */
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use cxlib.chainfacts
static int failed;
static char *slurp(const char *p, size_t *np) {
    FILE *f = fopen(p, "rb"); size_t cap = 1 << 26, n = 0; char *b;
    if (!f) return 0;
    b = malloc(cap); if (!b) { fclose(f); return 0; }
    n = fread(b, 1, cap - 1, f); fclose(f); b[n] = 0; if (np) *np = n;
    return b;
}
static void bad(const char *what, const char *a, const char *b) { printf("FAIL\t%s\t%s\t%s\n", what, a, b); failed++; }
/* Read the authority independently of the generated API, preserving ordered
 * key/source equality and rejecting duplicates rather than comparing copies. */
static void roots_check(void) {
    char *t = slurp("build/chain-facts.tsv", 0);
    char keys[128][160], sources[128][160]; int n = 0;
    if (!t) { bad("object-list-unreadable", "build/chain-facts.tsv", "-"); return; }
    for (char *p = t; p && *p; ) {
        char *nl = strchr(p, '\n'); if (nl) *nl = 0;
        if (!strncmp(p, "root\t", 5)) {
            char *k = p + 5, *s = strchr(k, '\t');
            if (!s || strchr(s + 1, '\t') || n == 128) { bad("object-root-row", p, "-"); }
            else {
                *s++ = 0;
                if (!*k || !*s || strlen(k) >= 160 || strlen(s) >= 160) bad("object-root-bound", k, s);
                else {
                    for (int j = 0; j < n; j++) if (!strcmp(keys[j], k) || !strcmp(sources[j], s)) bad("object-root-duplicate", k, s);
                    if (cx_fmt(keys[n], sizeof keys[n], "%s", k) || cx_fmt(sources[n], sizeof sources[n], "%s", s)) bad("object-root-bound", k, s);
                    const char *gk = cf_root_key(n), *gs = cf_root_source(n);
                    if (!gk || strcmp(k, gk)) bad("object-key", k, gk ? gk : "-");
                    if (!gs || strcmp(s, gs)) bad("object-source", s, gs ? gs : "-");
                    n++;
                }
            }
        }
        p = nl ? nl + 1 : 0;
    }
    if (!n || n != cf_root_count()) bad("object-count", "facts", "generated");
    free(t);
    static const char *sites[] = {"tools/release-build.cx", "tools/entry-build.cx"};
    static const char *contracts[][4] = {
        {"#define RB_WHOLE_SRC cf_root_count()", "for (i = 0; i < RB_WHOLE_SRC; i++) {", "rb_cat(srcs[i], RB_FULL, argv[2], 1, cf_root_source(i));", "v[n++] = srcs[i];"},
        {"#define EB_OBJ cf_root_count()", "for (i = 0; i < EB_OBJ; i++) {", "keys[i] = cf_root_key(i); src_rel[i] = cf_root_source(i);", "eb_join(srcs_b[i], 576, root, src_rel[i]);"}
    };
    for (int i = 0; i < 2; i++) {
        char *b = slurp(sites[i], 0);
        if (!b) { bad("object-list-unreadable", sites[i], "-"); continue; }
        if (!strstr(b, "#pragma unisa use cxlib.chainfacts")) bad("object-consumer-module", sites[i], "-");
        for (int j = 0; j < 4; j++) if (!strstr(b, contracts[i][j])) bad("object-consumer", sites[i], contracts[i][j]);
        if (strstr(b, "rb_whole_src[") || strstr(b, "src_rel[EB_OBJ] =") || strstr(b, "keys[EB_OBJ] =")) bad("object-local-table", sites[i], "-");
        for (int j = 0; j < n; j++) {
            char quoted[164]; cx_fmt(quoted, sizeof quoted, "\"%s\"", sources[j]);
            if (strstr(b, quoted)) bad("object-local-source", sites[i], sources[j]);
        }
        free(b);
    }
}

/* ---- NN-NF: op index / arity / print name have ONE source, exec/facts/core-ops.tsv ----
 * Eight copies of the arity table and three literal 56s (plus OP_COUNT) must agree with it,
 * and both naming orders (executor order and DSL/delta order) must cover the same set.
 * Without this, adding an opcode means editing nine places and drifting silently (e2stream
 * already lacked INC). */
static char op_name[96][32], op_arity[96][8], op_index[96][8];
static int op_rows;
static int ops_load(void) {
    char *t = slurp("exec/facts/core-ops.tsv", 0);
    if (!t) return 0;
    for (char *line = t; line && *line; ) {
        char *nl = strchr(line, '\n'), *f[3]; int k = 0; char *p = line;
        if (nl) *nl = 0;
        if (*line != '#' && *line) {
            f[k++] = p; while (k < 3 && (p = strchr(p, '\t'))) { *p++ = 0; f[k++] = p; }
            if (k == 3 && op_rows < 96) {
                cx_fmt(op_name[op_rows], 32, "%s", f[0]);
                cx_fmt(op_index[op_rows], 8, "%s", f[1]);
                cx_fmt(op_arity[op_rows], 8, "%s", f[2]);
                op_rows++;
            }
        }
        line = nl ? nl + 1 : 0;
    }
    free(t);
    return op_rows;
}

/* the arity list as a comma string, built from the table */
static void ops_arity_list(char *out, size_t cap) {
    size_t at = 0;
    out[0] = 0;
    for (int i = 0; i < op_rows; i++) {
        size_t len = strlen(op_arity[i]);
        if (at + len + (i ? 1 : 0) + 1 > cap) break;
        if (i) out[at++] = ',';
        for (size_t j = 0; j < len; j++) out[at++] = op_arity[i][j];
        out[at] = 0;
    }
}

/* Every listed file must carry the table's arity list.  The copies differ in
 * layout only -- one line, wrapped over two lines, or with spaces after the
 * commas -- so the comparison runs on a whitespace-stripped copy; a raw
 * substring test would pass on some copies and fail on others for no reason. */
static void ops_check_arities(char *list) {
    static const char *sites[] = {
        "cx/core/execute.cx", "exec/c/core.h", "cx/runtime/model_decode.cx",
        "cx/runtime/network_structure.cx", "cx/core/coregate.cx", "seed/pack.c",
        "tools/cxlib/e2stream.cx", "tests/stream-e1-lex144.cx"
    };
    for (unsigned i = 0; i < sizeof sites / sizeof *sites; i++) {
        size_t n = 0, at = 0;
        char *b = slurp(sites[i], &n), *flat;
        if (!b) { bad("ops-cannot-read", sites[i], "-"); continue; }
        flat = malloc(n + 1);
        if (!flat) { bad("ops-cannot-read", sites[i], "-"); free(b); continue; }
        for (size_t j = 0; j < n; j++) {
            unsigned char c = (unsigned char)b[j];
            if (c != ' ' && c != '\t' && c != '\n' && c != '\r') flat[at++] = (char)c;
        }
        flat[at] = 0;
        if (!strstr(flat, list)) bad("ops-arity-disagrees", sites[i], list);
        free(flat);
        free(b);
    }
}

/* the places that write the op count literally must equal the table's row count */
static void ops_check_counts(void) {
    static const char *sites[] = {
        "cx/runtime/model_decode.cx", "cx/runtime/network_structure.cx", "cx/core/coregate.cx"
    };
    static const char *defs[] = {"exec/c/asm/actions.h", "cx/core/execute.cx"};
    char want[64];
    for (unsigned i = 0; i < sizeof sites / sizeof *sites; i++) {
        char *b = slurp(sites[i], 0);
        if (!b) { bad("ops-cannot-read", sites[i], "-"); continue; }
        cx_fmt(want, sizeof want, "op >= %d", op_rows);
        if (!strstr(b, want)) bad("ops-count-disagrees", sites[i], want);
        free(b);
    }
    cx_fmt(want, sizeof want, "#define OP_COUNT %d", op_rows);
    char *b = slurp(defs[0], 0);
    if (!b) bad("ops-cannot-read", defs[0], "-");
    else { if (!strstr(b, want)) bad("ops-count-disagrees", defs[0], want); free(b); }
    b = slurp(defs[1], 0);
    if (!b) bad("ops-cannot-read", defs[1], "-");
    else { if (!strstr(b, "int ARITY[NOP_]")) bad("ops-count-disagrees", defs[1], "int ARITY[NOP_]"); free(b); }
    /* the two assembly dispatch tables are one entry per opcode; a short table reads past its end */
    static const char *tabs[][2] = {
        {"exec/c/asm/action_x86_64.S", "-Lxatable"},
        {"exec/c/asm/action_arm64.S", "-Latable"}
    };
    for (unsigned i = 0; i < sizeof tabs / sizeof *tabs; i++) {
        b = slurp(tabs[i][0], 0);
        if (!b) { bad("ops-cannot-read", tabs[i][0], "-"); continue; }
        int n = 0;
        for (char *p = b; (p = strstr(p, tabs[i][1])) != 0; p += strlen(tabs[i][1])) n++;
        if (n != op_rows) { cx_fmt(want, sizeof want, "%d", n); bad("ops-dispatch-count", tabs[i][0], want); }
        free(b);
    }
}

/* Both naming orders must name the same op set as the table.  The DSL order
 * (delta/e2stream) is a naming space of its own that maps back by name; the
 * executor order (seed and the dump/pack tools) is the printed enum order.
 * A missing name here is how e2stream silently lost INC. */
static void ops_check_dsl_names(void) {
    static const char *sites[] = {
        "tools/cxlib/delta.cx", "tools/cxlib/e2stream.cx",
        "seed/tbl.c", "tools/net-dump.cx", "tools/cxlib/netpack.cx",
        "tools/p3-member-consume.cx", "exec/c/qprefixcheck.cx"
    };
    for (unsigned i = 0; i < sizeof sites / sizeof *sites; i++) {
        char *b = slurp(sites[i], 0);
        if (!b) { bad("ops-cannot-read", sites[i], "-"); continue; }
        for (int r = 0; r < op_rows; r++) {
            char quoted[48];
            cx_fmt(quoted, sizeof quoted, "\"%s\"", op_name[r]);
            if (!strstr(b, quoted)) bad("ops-name-missing", sites[i], op_name[r]);
        }
        free(b);
    }
}

int main(int argc, char **argv) {
    const char *path = argc > 1 ? argv[1] : "exec/facts/limits.tsv";
    char *t = slurp(path, 0), *line; char name[64] = "", value[32] = ""; int rows = 0;
    if (!t) { printf("FAIL\tcannot-read\t%s\t-\n", path); return 2; }
    for (line = t; line && *line; ) {
        char *nl = strchr(line, '\n'); char *f[4]; int k = 0; char *p = line;
        if (nl) *nl = 0;
        if (*line != '#' && *line) {
            f[k++] = p; while (k < 4 && (p = strchr(p, '\t'))) { *p++ = 0; f[k++] = p; }
            if (k != 4) { bad("bad-row", line, "-"); }
            else {
                char want[256], *o = want; const char *q; char *body;
                rows++;
                if (!strcmp(name, f[0]) && strcmp(value, f[1])) bad("value-differs", f[0], f[1]);
                if (cx_fmt(name, sizeof name, "%s", f[0]) || cx_fmt(value, sizeof value, "%s", f[1])) bad("field-bound", f[0], f[1]);
                for (q = f[3]; *q && o < want + 200; ) {
                    if (q[0] == '{' && q[1] == '}') { const char *v = f[1]; while (*v) *o++ = *v++; q += 2; } else *o++ = *q++;
                }
                *o = 0;
                body = slurp(f[2], 0);
                if (!body) bad("cannot-read", f[2], "-");
                else if (!strstr(body, want)) bad("site-disagrees", f[2], want);
                free(body);
            }
        }
        line = nl ? nl + 1 : 0;
    }
    roots_check();
    if (!rows) bad("no-rows", path, "-");
    if (ops_load()) {
        char list[512];
        ops_arity_list(list, sizeof list);
        ops_check_arities(list);
        ops_check_counts();
        ops_check_dsl_names();
    } else {
        bad("ops-table-unreadable", "exec/facts/core-ops.tsv", "-");
    }
    if (failed) { printf("LIMITS\tfailed=%d\n", failed); return 1; }
    printf("LIMITS\trows=%d\tops=%d\tstatus=PASS\n", rows, op_rows); return 0;
}
