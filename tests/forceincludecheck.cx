#!/usr/bin/env -S unisacc.com -run
/* forceincludecheck.cx PRODUCT [--cc]
   Black-box forced-header source identity and line positions. --cc treats PRODUCT
   as a system C compiler; otherwise it accepts a .com or a native classic driver.
   No model/stamp inspection. Each child has its own 10-second process-group bound.
   Kept outside gate.sh until a fresh product is accepted by the owner. */
static char D[4096], P[4096];
static int systemcc, checks;
static int put(const char *name, const char *body) {
    char path[8192]; snprintf(path,sizeof path,"%s/%s",D,name);
    return cx_write(path,body,strlen(body));
}
static int child(const char *args, char **out) {
    char cmd[16384]; size_t n;
    snprintf(cmd,sizeof cmd,"cd '%s' && %s'%s' %s 2>err",D,
             !systemcc && strstr(P,".com") ? "sh " : "",P,args);
    return cx_run_timeout(cmd,10,out,&n);
}
static int probe(const char *name, const char *flags, const char *body,
                 const char *diagnostic, int forward) {
    char args[8192], *out=0, *err=0, path[8192]; size_t n; int rc, ok;
    if (put("main.c",body)) return 1;
    snprintf(args,sizeof args,systemcc ? "%s main.c -o out" : "-run %s main.c",flags);
    rc=child(args,&out);
    if (systemcc && !diagnostic && rc==0) {
        free(out); out=0;
        snprintf(args,sizeof args,"cd '%s' && ./out 2>err",D);
        rc=cx_run_timeout(args,10,&out,&n);
    }
    snprintf(path,sizeof path,"%s/err",D);err=cx_read(path,&n);
    ok=diagnostic ? rc==1 && err && strstr(err,diagnostic) :
        rc==0 && out && !strcmp(out,forward ? "pass\n" : "");
    printf("forceinclude %-24s %s\n",name,ok ? "pass" : "FAIL");
    if (!ok) fprintf(stderr,"rc=%d stdout=%s stderr=%s\n",rc,out ? out : "<missing>",err ? err : "<missing>");
    free(out);free(err);checks++;
    return !ok;
}
int main(int argc, char **argv) {
    char own[]="/tmp/forceincludeXXXXXX", cwd[4096], path[8192]; int fail=0;
    const char *head=
        "static int eq(const char *a,const char *b){if(a[0]=='.' && a[1]=='/')a+=2;while(*a && *a==*b){a++;b++;}return *a==*b;}\n";
    char plain[8192],forward[8192],single[8192],normal[8192],mapped[8192],spliced[8192];
    char absolute[8192], flags[8192];
    const char *condition="eq(w1,\"sub/h.h\") && l1==2 && eq(w2,\"sub/h2.h\") && l2==3 && (eq(wn,\"nested.h\") || eq(wn,\"sub/nested.h\")) && ln==2 && eq(wmain,\"main.c\") && lmain==2";
    if (argc<2 || argc>3 || (argc==3 && strcmp(argv[2],"--cc"))) return 2;
    systemcc=argc==3;
    if (!getcwd(cwd,sizeof cwd) || !mkdtemp(own)) return 2;
    snprintf(D,sizeof D,"%s",own);
    if (argv[1][0]=='/') snprintf(P,sizeof P,"%s",argv[1]);
    else snprintf(P,sizeof P,"%s/%s",cwd,argv[1]);
    if (strchr(P,39)) return 2;
    snprintf(path,sizeof path,"%s/sub",D); if (mkdir(path,0700)) return 2;
    if (put("sub/h.h","static const char *w1=__FILE__;\nstatic int l1=__LINE__;\n") ||
        put("sub/h2.h","#include \"nested.h\"\nstatic const char *w2=__FILE__;\nstatic int l2=__LINE__;\n") ||
        put("sub/nested.h","static const char *wn=__FILE__;\nstatic int ln=__LINE__;\n") ||
        put("sub/bad.h","int broken = ;\n") ||
        put("sub/relative.h","#include \"h.h\"\n#include <stdio.h>\n")) return 2;
    snprintf(plain,sizeof plain,"static const char *wmain=__FILE__;\nstatic int lmain=__LINE__;\n%sint main(void){return (%s)?0:7;}\n",head,condition);
    snprintf(forward,sizeof forward,"static const char *wmain=__FILE__;\nstatic int lmain=__LINE__;\n#include <stdio.h>\nlong sysconf(int);\n%sint main(void){if(!(%s) || sysconf(29)<=0)return 7;puts(\"pass\");return 0;}\n",head,condition);
    if (probe("two/nested/plain","-include sub/h.h -include sub/h2.h",plain,0,0)) goto red;
    if (probe("two/nested/forward","-include sub/h.h -include sub/h2.h",forward,0,1)) goto red;
    snprintf(single,sizeof single,"#include <stdio.h>\nlong sysconf(int);\n%sint main(void){if(!eq(w1,\"sub/h.h\") || l1!=2 || sysconf(29)<=0)return 7;puts(\"pass\");return 0;}\n",head);
    if (probe("single/forward","-include sub/h.h",single,0,1)) goto red;
    snprintf(normal,sizeof normal,"#include \"sub/h.h\"\n#include \"sub/h2.h\"\n%sint main(void){return eq(w1,\"sub/h.h\") && l1==2 && eq(w2,\"sub/h2.h\") && l2==3 && (eq(wn,\"nested.h\") || eq(wn,\"sub/nested.h\")) && ln==2 && __LINE__==4 ? 0:7;}\n",head);
    if (probe("ordinary-include","",normal,0,0)) goto red;
    snprintf(absolute,sizeof absolute,"%sint main(void){return eq(w2,\"%s/sub/h2.h\") && l2==3 && (eq(wn,\"nested.h\") || eq(wn,\"%s/sub/nested.h\")) && ln==2 ? 0:7;}\n",head,D,D);
    snprintf(flags,sizeof flags,"-include '%s/sub/h2.h'",D);
    if (probe("absolute/nested/plain",flags,absolute,0,0)) goto red;
    snprintf(absolute,sizeof absolute,"%sint main(void){return (eq(w1,\"h.h\") || eq(w1,\"sub/h.h\")) && l1==2 && eq(w2,\"%s/sub/h2.h\") && l2==3 && (eq(wn,\"nested.h\") || eq(wn,\"%s/sub/nested.h\")) && ln==2 ? 0:7;}\n",head,D,D);
    /* The relative header ends with a bundled header: its incdisk=0 must
       not leak into the following absolute disk include. */
    snprintf(flags,sizeof flags,"-include sub/relative.h -include '%s/sub/h2.h'",D);
    if (probe("relative-then-absolute",flags,absolute,0,0)) goto red;
    snprintf(mapped,sizeof mapped,"#line 40 \"logical.c\"\nstatic const char *wm=__FILE__;\nstatic int lm=__LINE__;\n%sint main(void){return eq(wm,\"logical.c\") && lm==41 && eq(w1,\"sub/h.h\") && l1==2 ? 0:7;}\n",head);
    if (probe("main-line-directive","-include sub/h.h",mapped,0,0)) goto red;
    snprintf(spliced,sizeof spliced,"#define V \\\n7\nstatic int lm=__LINE__;\n%sint main(void){return V==7 && lm==3 && eq(w1,\"sub/h.h\") && l1==2 ? 0:7;}\n",head);
    if (probe("main-continuation","-include sub/h.h",spliced,0,0)) goto red;
    if (probe("bad-header/plain","-include sub/bad.h","int main(void){return 0;}\n","sub/bad.h:1:14:",0)) goto red;
    if (probe("bad-header/forward-source","-include sub/bad.h","#include <stdio.h>\nlong sysconf(int);\nint main(void){puts(\"pass\");return sysconf(29)>0?0:7;}\n","sub/bad.h:1:14:",0)) goto red;
    if (probe("main-diagnostic","-include sub/h.h -include sub/h2.h","int main(void){\n return missing;\n}\n","main.c:2:9:",0)) goto red;
    printf("forceincludecheck %d checks PASS\n",checks);
    goto cleanup;
red:
    fail=1;
cleanup:
    /* Preserve the first failing scratch for diagnosis; remove successful probes. */
    if (fail) fprintf(stderr,"scratch %s\n",D);
    else {
        const char *files[]={"sub/h.h","sub/h2.h","sub/nested.h","sub/bad.h","sub/relative.h","main.c","out","err",0};int i;
        for(i=0;files[i];i++){snprintf(path,sizeof path,"%s/%s",D,files[i]);unlink(path);}
        snprintf(path,sizeof path,"%s/sub",D);rmdir(path);rmdir(D);
    }
    return fail;
}
