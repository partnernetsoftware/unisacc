/* ROOT CTX MODELS PAYLOAD G1 G2 G3 NEW_ABS_OUT cycle|depth; caller bound55.
 * Real positive --verify-chain20 prerequisite, one negative target20, final
 * complete-source observation8: explicit child budgets48s. No new models,
 * HOST, slices or products are built. The private graph is deliberately only
 * traversal syntax, NOT valid generations or historical execution evidence.
 * Two nodes form a cycle; 65 distinct nodes exceed admission's64-node bound.
 * This does not measure a valid64-generation chain's worst-case wall time.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
static char root[4096],ctx[4096],models[4096],payload[4096],gen[3][4096],work[4096],self[4096],ccpath[4096],source_expected[65];
static char bound[4400],product[4400],tool[4400],ident[4400],netpack[4400],bound_source[4400],graph[4400],probe[4400],nodes[65][4400];
static int assertions,failures;
static void die(const char *s){fprintf(stderr,"hostseed-ancestry-controls: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static void clean(const char *p){if(!p[0]||strpbrk(p,"\r\n\t"))die("unclean-path");}
static void ck(int ok,const char *s){assertions++;if(!ok)failures++;printf("%s\thostseed-ancestry-controls.%s\n",ok?"PASS":"FAIL",s);}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input-absent":"input-stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>134217728)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC);if(fd<0||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)die("input-descriptor");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("input-extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||bad||closed)die("input-changed-or-close");s[*n]=0;return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void write_new(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-private-output");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("output-write");at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("output-close");}
static void save(const char *name,const char *s,size_t n){char p[4400];path(p,work,name);write_new(p,s,n);}
static void row(np_buf *b,const char *k,const char *v){np_puts(b,k);np_puts(b,"\t");np_puts(b,v);np_puts(b,"\n");}
static int missing(const char *p){struct stat st;errno=0;if(!lstat(p,&st))return 0;if(errno!=ENOENT)die("probe-existence-IO");return 1;}
static int within(const char *p,const char *base){size_t n=strlen(base);return !strncmp(p,base,n)&&(!p[n]||p[n]=='/');}
/* These two extracted fields are not admission authority. The real tool's
 * subsequent exact positive verification must succeed before graph creation.
 * Complete original bytes are also inventoried across all commands. */
static void context_inputs(void){char p[4400];path(p,ctx,"context.tsv");size_t n;char *s=load(p,&n);if(memchr(s,0,n)||memchr(s,'\r',n))die("context-wire");const char *keys[]={"\ncc\t","\nsource\t"};for(int i=0;i<2;i++){char *at=strstr(s,keys[i]);if(!at||strstr(at+1,keys[i]))die("unique-context-input");at+=strlen(keys[i]);char *end=strchr(at,'\n');if(!end||end==at)die("context-input-extent");size_t z=(size_t)(end-at);if(!i){if(z>=sizeof ccpath)die("CC-path-bound");memcpy(ccpath,at,z);ccpath[z]=0;clean(ccpath);if(ccpath[0]!='/')die("absolute-CC-path");}else{if(z!=64)die("source-hash-extent");for(size_t j=0;j<z;j++)if(!((at[j]>='0'&&at[j]<='9')||(at[j]>='a'&&at[j]<='f')))die("source-hash-hex");memcpy(source_expected,at,64);source_expected[64]=0;}}free(s);}
typedef struct {char *line;} Entry;static Entry entries[4096];static int nentries;
static void entry(const char *p,const char *label){if(nentries==4096)die("manifest-capacity");struct stat st;if(lstat(p,&st))die("manifest-stat");char h[65],text[5000];if(S_ISDIR(st.st_mode))strcpy(h,"-");else{if(!S_ISREG(st.st_mode))die("manifest-special-input");digest(p,h);}int n=snprintf(text,sizeof text,"%s\t%s\t%o\t%s\n",S_ISDIR(st.st_mode)?"DIR":"FILE",label,(unsigned)(st.st_mode&07777),h);if(n<0||(size_t)n>=sizeof text)die("manifest-row");entries[nentries++].line=strdup(text);if(!entries[nentries-1].line)die("manifest-allocation");}
static void walk(const char *base,const char *relative,const char *label){char p[4400],id[4400];if(*relative){path(p,base,relative);path(id,label,relative);}else{strcpy(p,base);strcpy(id,label);}entry(p,id);struct stat st;if(lstat(p,&st))die("manifest-stat");if(!S_ISDIR(st.st_mode))return;DIR *d=opendir(p);if(!d)die("manifest-directory");for(;;){errno=0;struct dirent *e=readdir(d);if(!e){int saved=errno,closed=closedir(d);if(saved||closed)die("manifest-directory-close");break;}if(tx_eq(e->d_name, ".", 1L << 20)||tx_eq(e->d_name, "..", 1L << 20))continue;clean(e->d_name);char next[4400];if(*relative)path(next,relative,e->d_name);else{if(strlen(e->d_name)>=sizeof next)die("manifest-name");strcpy(next,e->d_name);}walk(base,next,label);}}
static int compare_entry(const void *a,const void *b){return strcmp(((const Entry *)a)->line,((const Entry *)b)->line);}
static np_buf finish_manifest(void){qsort(entries,(size_t)nentries,sizeof *entries,compare_entry);np_buf b={0};np_puts(&b,"hostseed-ancestry-inventory-v1\n");for(int i=0;i<nentries;i++){np_puts(&b,entries[i].line);free(entries[i].line);entries[i].line=0;}return b;}
static np_buf original_manifest(void){nentries=0;walk(ctx,"","CTX");for(int i=0;i<3;i++){char name[8];snprintf(name,sizeof name,"G%d",i+1);walk(gen[i],"",name);}const char *paths[]={models,payload,product,tool,ident,self,ccpath,bound,bound_source,netpack};const char *names[]={"MODELS","PAYLOAD","ROOT_PRODUCT","HOSTSEED_TOOL","IDENTITY_SOURCE","CONTROL_SOURCE","CC_BINARY","WATCHDOG","WATCHDOG_C_SOURCE","NETPACK"};for(int i=0;i<10;i++)entry(paths[i],names[i]);return finish_manifest();}
static np_buf graph_manifest(void){nentries=0;walk(graph,"","SYNTHETIC_GRAPH");return finish_manifest();}
static np_result command(char **v,int seconds,const char *label){np_buf b={0};for(int i=0;v[i];i++){char name[32];snprintf(name,sizeof name,"arg-%d",i);row(&b,name,v[i]);}char name[100];snprintf(name,sizeof name,"%s.argv.tsv",label);save(name,b.p,b.n);free(b.p);if(unsetenv("UNISACC_RF_CAPTURE")||unsetenv("UNISA_ATTRIBUTES"))die("clear-ambient-state");char why[1024];np_result r;if(np_run(v,root,0,seconds+2,&r,why,sizeof why)){snprintf(name,sizeof name,"%s.error",label);save(name,why,strlen(why));snprintf(name,sizeof name,"%s.status",label);const char *s="rc\tUNAVAILABLE\nstreams\tUNAVAILABLE-transport-error\n";save(name,s,strlen(s));die(why);}snprintf(name,sizeof name,"%s.stdout",label);save(name,r.out,r.outn);snprintf(name,sizeof name,"%s.stderr",label);save(name,r.err,r.errn);char status[40];int n=snprintf(status,sizeof status,"rc\t%d\n",r.rc);snprintf(name,sizeof name,"%s.status",label);save(name,status,(size_t)n);return r;}
static void positive(void){char *v[]={bound,"20","sh",product,tool,"--","--verify-chain",root,ctx,models,payload,gen[0],gen[1],gen[2],0};np_result r=command(v,20,"baseline");const char *out="VERIFIED\thostseed-fixed-P3-chain\tstages=3\tno-N22-no-test-result\nNOT_CLAIMED\tindependent-initial-source-measurement-hermetic-host-build-NN-or-ASM-kernel-source-rebuild-complete-N22-or-foreign-hosts\n";int rc=!r.rc,stdout_ok=r.outn==strlen(out)&&!memcmp(r.out,out,r.outn),stderr_ok=!r.errn;ck(rc,"actual-positive-chain-rc0");ck(stdout_ok,"actual-positive-chain-exact-summary");ck(stderr_ok,"actual-positive-chain-empty-stderr");np_free(&r);if(!rc||!stdout_ok||!stderr_ok)die("positive-prerequisite-failed-target-NOT_RUN");}
static np_buf stage_copy(const char *s,size_t n,const char *kind,const char *builder){
 if(memchr(s,0,n)||memchr(s,'\r',n)||n<19||memcmp(s,"hostseed-stage-v1\n",18)||np_count(s,n,"\n",1)!=16)die("positive-G1-stage-15-field-shape");char host[4400];path(host,ctx,"HOST");np_buf old={0},replacement={0},first={0},result={0};np_puts(&old,"\nbuilder-kind\tnative\n");np_puts(&replacement,"\nbuilder-kind\t");np_puts(&replacement,kind);np_puts(&replacement,"\n");if(np_count(s,n,old.p,old.n)!=1)die("unique-original-native-kind");np_replace(s,n,old.p,old.n,replacement.p,replacement.n,1,&first);free(old.p);free(replacement.p);old=(np_buf){0};replacement=(np_buf){0};np_puts(&old,"\nbuilder\t");np_puts(&old,host);np_puts(&old,"\n");np_puts(&replacement,"\nbuilder\t");np_puts(&replacement,builder);np_puts(&replacement,"\n");if(np_count(first.p,first.n,old.p,old.n)!=1)die("unique-original-HOST-builder");np_replace(first.p,first.n,old.p,old.n,replacement.p,replacement.n,1,&result);free(old.p);free(replacement.p);free(first.p);return result;
}
static void synthetic_graph(int depth){int count=depth?65:2;path(graph,work,"synthetic-traversal-only");if(mkdir(graph,0700))die("new-synthetic-graph");for(int i=0;i<count;i++){char name[32];snprintf(name,sizeof name,"node-%02d",i);path(nodes[i],graph,name);if(mkdir(nodes[i],0700))die("new-synthetic-node");}char p[4400];path(p,gen[0],"stage.tsv");size_t n;char *base=load(p,&n);for(int i=0;i<count;i++){char builder[4400];const char *kind="ape";if(depth&&i==64){path(builder,ctx,"HOST");kind="native";}else path(builder,nodes[depth?i+1:(i+1)%2],"unisacc-seed.com");np_buf stage=stage_copy(base,n,kind,builder);path(p,nodes[i],"stage.tsv");write_new(p,stage.p,stage.n);size_t got;char *actual=load(p,&got);if(got!=stage.n||memcmp(actual,stage.p,got))die("synthetic-stage-copy-bytes");free(actual);free(stage.p);path(p,nodes[i],"unisacc-seed.com");const char *placeholder="SYNTHETIC-TRAVERSAL-ONLY\n";write_new(p,placeholder,strlen(placeholder));}free(base);ck(1,depth?"65-distinct-private-traversal-nodes-not-generations":"two-private-traversal-nodes-form-cycle-not-generations");}
static int named_reason(const np_result *r,const char *reason){char prefix[350];int n=snprintf(prefix,sizeof prefix,"hostseed-step: REFUSE %s errno=",reason);if(n<0||(size_t)n>=sizeof prefix||r->errn<(size_t)n+2||memcmp(r->err,prefix,(size_t)n))return 0;size_t at=(size_t)n;if(r->err[at]=='-')at++;size_t first=at;while(at<r->errn&&r->err[at]>='0'&&r->err[at]<='9')at++;return at>first&&at+1==r->errn&&r->err[at]=='\n';}
static void final_source(void){char *v[]={bound,"8","sh",product,ident,"--",root,0};np_result r=command(v,8,"source-after");int shape=!r.rc&&!r.errn&&r.outn==65&&r.out[64]=='\n';if(shape)for(int i=0;i<64;i++)if(!((r.out[i]>='0'&&r.out[i]<='9')||(r.out[i]>='a'&&r.out[i]<='f')))shape=0;ck(shape,"final-actual-full-source-observation");ck(shape&&!memcmp(r.out,source_expected,64),"final-full-source-matches-actual-positive-context");np_free(&r);}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN hostseed-ancestry-controls requires Linux/x86_64\n",stderr);return 3;
#endif
 if(argc!=10||!realpath(argv[1],root)||!realpath(argv[2],ctx)||!realpath(argv[3],models)||!realpath(argv[4],payload)||argv[8][0]!='/'||strlen(argv[8])>=sizeof work||!realpath(__FILE__,self))die("usage-ROOT-CTX-MODELS-PAYLOAD-G1-G2-G3-NEW_OUT-cycle-or-depth");for(int i=0;i<3;i++)if(!realpath(argv[5+i],gen[i]))die("generation-realpath");if(tx_eq(gen[0], gen[1], 1L << 20)||tx_eq(gen[0], gen[2], 1L << 20)||tx_eq(gen[1], gen[2], 1L << 20))die("three-distinct-original-generations-required");int depth=!strcmp(argv[9],"depth");if(!depth&&!tx_eq(argv[9], "cycle", 1L << 20))die("unknown-CASE");clean(root);clean(ctx);clean(models);clean(payload);for(int i=0;i<3;i++)clean(gen[i]);clean(argv[8]);
 char parent[4096],base[4096],leaf[4096];strcpy(parent,argv[8]);char *slash=strrchr(parent,'/');if(!slash||!slash[1]||tx_eq(slash+1, ".", 1L << 20)||tx_eq(slash+1, "..", 1L << 20))die("output-leaf");strcpy(leaf,slash+1);if(slash==parent)slash[1]=0;else *slash=0;if(!realpath(parent,base))die("output-parent");int z=snprintf(work,sizeof work,"%s%s%s",base,tx_eq(base, "/", 1L << 20)?"":"/",leaf);if(z<0||(size_t)z>=sizeof work||within(work,ctx)||within(work,gen[0])||within(work,gen[1])||within(work,gen[2]))die("output-aliases-original");if(mkdir(work,0700))die("new-output-required");path(bound,root,"tools/bound");path(bound_source,root,"tools/bound.c");path(product,root,"unisacc.com");path(tool,root,"tools/hostseed-step.cx");path(ident,root,"seed/ident.c");path(netpack,root,"tools/cxlib/netpack.cx");path(probe,work,"must-stay-absent");context_inputs();np_buf before=original_manifest();save("original-before.tsv",before.p,before.n);positive();synthetic_graph(depth);np_buf graph_before=graph_manifest();save("graph-before.tsv",graph_before.p,graph_before.n);char builder[4400];path(builder,nodes[0],"unisacc-seed.com");char *v[]={bound,"20","sh",product,tool,"--",root,ctx,"ape",builder,models,payload,probe,"invalid-probe",0};np_result r=command(v,20,"target");ck(r.rc==2,"target-rc2");ck(!r.outn,"target-empty-stdout");ck(named_reason(&r,depth?"parent-ancestry-depth-bound":"parent-ancestry-cycle"),"target-exact-guard-reason");np_free(&r);ck(missing(probe),"guard-rejects-before-any-new-stage");final_source();np_buf after=original_manifest();save("original-after.tsv",after.p,after.n);ck(before.n==after.n&&!memcmp(before.p,after.p,before.n),"all-original-context-generations-inputs-tools-unchanged");free(before.p);free(after.p);np_buf graph_after=graph_manifest();save("graph-after.tsv",graph_after.p,graph_after.n);ck(graph_before.n==graph_after.n&&!memcmp(graph_before.p,graph_after.p,graph_before.n),"private-synthetic-graph-unchanged");free(graph_before.p);free(graph_after.p);
 puts("SCOPE\tsynthetic-traversal-guard-after-real-positive-chain\tno-product-model-or-HOST-build\tvalid64-generation-time=UNMEASURED");puts("NOT_CLAIMED\tNN-or-ASM-source-reconstruction-hermetic-hostdeps-historical-execution-full-N22-or-foreign-hosts");puts("TIMING\tinternal-phases-and-cold-hot=UNMEASURED");printf("HOSTSEED_ANCESTRY_CONTROLS\tcase=%s\tassertions=%d\tfailed=%d\tactual-commands=3\texplicit-child-budgets=48\n",argv[9],assertions,failures);return failures?1:0;
}
