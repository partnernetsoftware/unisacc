#!/usr/bin/env -S unisacc.com -run
/* sourcelabelcheck.cx PRODUCT [SCRATCH] -- black-box record of how the PHYSICAL directory of a
   source file changes what the product writes (0.0.43 fixed logical source name, step 0).

   The same three probes are placed in two different directories under the same basename
   (dir-a/src/ and dir-b/elsewhere/):
     probe_file.c  prints __FILE__                   (a path that the product must not leak)
     probe_diag.c  a syntax error                    (the diagnostic names the file)
     probe_inc.c   #include "rel.h", rel.h beside it (a quoted include resolved from the file)
   Each probe is run in five modes (-S, -c -o, -o, -run, -c -MF), once from each directory.
   The record compares, per mode and probe: the exit status, stdout, stderr and the file the mode
   writes, and says which of those bytes carry their own physical directory name.

   This is a RECORD, not a verdict: it prints what differs and exits 77 when the record is complete.
   Exit 1: the checker itself could not write or run (an error of the harness, not of the product).
   Exit 2: usage.  Not in the gate; see tests/ungated-checks.tsv. */
#include <cx.h>

static char ROOT[3000];
static char DIRA[3100], DIRB[3100];
static int harness;

static int put(const char *path, const char *text) {
    if (cx_write(path, text, strlen(text))) { fprintf(stderr, "cannot write %s\n", path); harness++; return 1; }
    return 0;
}

/* a file's bytes, or an empty string when it is missing (the mode wrote nothing) */
static char *bytes(const char *path, size_t *n) {
    char *b = cx_read(path, n);
    if (!b) { *n = 0; return ""; }
    return b;
}

static int same(const char *a, size_t na, const char *b, size_t nb) { return na == nb && !memcmp(a, b, na); }

/* the whole buffer, not a prefix: a path can sit anywhere in a 27 KB -S listing */
static int carries(const char *b, size_t n, const char *mark) {
    size_t m = strlen(mark), i;
    if (m == 0 || n < m) return 0;
    for (i = 0; i + m <= n; i++) if (!memcmp(b + i, mark, m)) return 1;
    return 0;
}

static const char *PROBE[] = {"probe_file", "probe_diag", "probe_inc", 0};
static const char *TEXT[] = {
    "#include <stdio.h>\nint main(void) { puts(__FILE__); return 0; }\n",
    "int main(void) { int x = ; return x; }\n",
    "#include \"rel.h\"\nint main(void) { return REL; }\n",
};
static const char *MODE[] = {"S", "c", "o", "run", "d", 0};

/* the file a mode writes besides its stdout: the object, the image, or the -MF dependency file */
static const char *ext_of(const char *mode) {
    return !strcmp(mode, "c") ? "obj" : !strcmp(mode, "d") ? "d" : "bin";
}

/* one run of PRODUCT in MODE on DIR/PROBE.c; stdout, stderr and the written file land beside it */
static int run(const char *product, const char *dir, const char *probe, const char *mode, int *rc) {
    char cmd[8192], src[3300], out[3300], err[3300], res[3300];
    snprintf(src, sizeof src, "%s/%s.c", dir, probe);
    snprintf(err, sizeof err, "%s/%s.err", dir, probe);
    snprintf(out, sizeof out, "%s/%s.out", dir, probe);
    snprintf(res, sizeof res, "%s/%s.%s", dir, probe, ext_of(mode));
    snprintf(cmd, sizeof cmd, "rm -f '%s' '%s' '%s' '%s/%s.dobj'", out, err, res, dir, probe);
    cx_run(cmd, 0, 0);
    if (!strcmp(mode, "S"))        snprintf(cmd, sizeof cmd, "sh '%s' -S '%s' >'%s' 2>'%s'", product, src, out, err);
    else if (!strcmp(mode, "c"))   snprintf(cmd, sizeof cmd, "sh '%s' -c '%s' -o '%s' 2>'%s'", product, src, res, err);
    else if (!strcmp(mode, "o"))   snprintf(cmd, sizeof cmd, "sh '%s' '%s' -o '%s' 2>'%s'", product, src, res, err);
    else if (!strcmp(mode, "d"))   snprintf(cmd, sizeof cmd, "sh '%s' -c '%s' -o '%s/%s.dobj' -MF '%s' 2>'%s'", product, src, dir, probe, res, err);
    else                           snprintf(cmd, sizeof cmd, "sh '%s' -run '%s' >'%s' 2>'%s'", product, src, out, err);
    *rc = cx_run(cmd, 0, 0);
    return 0;
}

int main(int argc, char **argv) {
    if (argc < 2 || argc > 3) { fprintf(stderr, "usage: sourcelabelcheck.cx PRODUCT [SCRATCH]\n"); return 2; }
    const char *product = argv[1];
    if (argc == 3) snprintf(ROOT, sizeof ROOT, "%s", argv[2]);
    else {
        char tmpl[] = "/tmp/sourcelabel-XXXXXX";
        if (!mkdtemp(tmpl)) { fprintf(stderr, "cannot make a scratch directory\n"); return 1; }
        snprintf(ROOT, sizeof ROOT, "%s", tmpl);
    }
    snprintf(DIRA, sizeof DIRA, "%s/dir-a/src", ROOT);
    snprintf(DIRB, sizeof DIRB, "%s/dir-b/elsewhere", ROOT);
    char cmd[8192];
    snprintf(cmd, sizeof cmd, "mkdir -p '%s' '%s'", DIRA, DIRB);
    if (cx_run(cmd, 0, 0)) { fprintf(stderr, "cannot make %s and %s\n", DIRA, DIRB); return 1; }
    for (int d = 0; d < 2; d++) {
        const char *dir = d ? DIRB : DIRA;
        for (int i = 0; PROBE[i]; i++) {
            char path[3300];
            snprintf(path, sizeof path, "%s/%s.c", dir, PROBE[i]);
            if (put(path, TEXT[i])) return 1;
        }
        char rel[3300]; snprintf(rel, sizeof rel, "%s/rel.h", dir);
        if (put(rel, "#define REL 7\n")) return 1;
    }
    printf("sourcelabel record: product=%s\n", product);
    printf("  A=%s\n  B=%s\n", DIRA, DIRB);
    printf("  %-11s %-4s %-4s  %-8s %-8s %-8s  %s\n", "probe", "mode", "rc", "stdout", "stderr", "file", "physical dir in (A out/err/file | B out/err/file)");
    int cases = 0, differ = 0;
    for (int i = 0; PROBE[i]; i++) {
        for (int m = 0; MODE[m]; m++) {
            int rcA = 0, rcB = 0;
            run(product, DIRA, PROBE[i], MODE[m], &rcA);
            run(product, DIRB, PROBE[i], MODE[m], &rcB);
            char pa[3300], pb[3300], oa[3400], ob[3400], ea[3400], eb[3400], ra[3400], rb[3400];
            snprintf(pa, sizeof pa, "%s/%s", DIRA, PROBE[i]); snprintf(pb, sizeof pb, "%s/%s", DIRB, PROBE[i]);
            snprintf(oa, sizeof oa, "%s.out", pa); snprintf(ob, sizeof ob, "%s.out", pb);
            snprintf(ea, sizeof ea, "%s.err", pa); snprintf(eb, sizeof eb, "%s.err", pb);
            const char *ext = ext_of(MODE[m]);
            int hasfile = strcmp(MODE[m], "S") && strcmp(MODE[m], "run");
            snprintf(ra, sizeof ra, "%s.%s", pa, ext); snprintf(rb, sizeof rb, "%s.%s", pb, ext);
            size_t na, nb; char *ba, *bb;
            int carA = 0, carB = 0, sfile = -1;
            ba = bytes(oa, &na); bb = bytes(ob, &nb); int so = same(ba, na, bb, nb);
            if (carries(ba, na, "dir-a")) carA |= 1;
            if (carries(bb, nb, "dir-b")) carB |= 1;
            ba = bytes(ea, &na); bb = bytes(eb, &nb); int se = same(ba, na, bb, nb);
            if (carries(ba, na, "dir-a")) carA |= 2;
            if (carries(bb, nb, "dir-b")) carB |= 2;
            if (hasfile) {
                ba = bytes(ra, &na); bb = bytes(rb, &nb); sfile = same(ba, na, bb, nb);
                if (carries(ba, na, "dir-a")) carA |= 4;
                if (carries(bb, nb, "dir-b")) carB |= 4;
            }
            cases++;
            if (!so || !se || sfile == 0) differ++;
            printf("  %-11s %-4s %-4d  %-8s %-8s %-8s  A:%s%s%s  B:%s%s%s\n",
                   PROBE[i], MODE[m], rcA == rcB ? rcA : -999,
                   so ? "same" : "DIFF", se ? "same" : "DIFF",
                   sfile < 0 ? "n/a" : sfile ? "same" : "DIFF",
                   carA & 1 ? "out" : "-", carA & 2 ? "/err" : "/-", carA & 4 ? "/file" : "/-",
                   carB & 1 ? "out" : "-", carB & 2 ? "/err" : "/-", carB & 4 ? "/file" : "/-");
            if (rcA != rcB) printf("      rc differs: A=%d B=%d\n", rcA, rcB);
        }
    }
    printf("record complete: %d cases, %d with a difference between the two physical directories\n", cases, differ);
    if (harness) return 1;
    return 77;
}
