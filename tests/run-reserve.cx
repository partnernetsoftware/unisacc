/* tests/run-reserve.cx -- res.mem.run-reserve on the installed product.
 *
 *   sh ./unisacc.com tests/run-reserve.cx
 *
 * -run under ulimit -v 40000 must print "run: out of memory", exit 2,
 * and write nothing to stdout. An unlimited -run of the same program
 * returns 7 before and after that refusal.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.sig
#pragma unisa use text.text

static char root[4096], work[4400], com[4400], bound[4400];
static int assertions, failures;

static void die(const char *s) { sy_eprintf("run-reserve: REFUSE %s\n", s); sy_exit(2); }
static void ck(int ok, const char *name) {
    assertions++;
    if (ok) sy_printf("PASS\trun-reserve.%s\n", name);
    else { failures++; sy_printf("FAIL\trun-reserve.%s\n", name); }
}
static np_result go(const char *limit, char **args) {
    char *v[16], script[96]; int n = 0, k; char why[256]; np_result r;
    v[n++] = bound; v[n++] = "25"; v[n++] = "sh";
    if (limit) {
        if (cx_fmt(script, sizeof script, "ulimit %s; exec sh \"$0\" \"$@\"", limit)) die("script");
        v[n++] = "-c"; v[n++] = script;
    }
    v[n++] = com;
    for (k = 0; args[k] && n < 15; k++) v[n++] = args[k];
    v[n] = 0;
    if (np_run(v, work, 0, 40, &r, why, sizeof why)) die(why);
    return r;
}

int main(void) {
    char src[4600];
    char *a[] = {"-run", "t.c", 0};
    np_result r;
    if (sy_cwd(root, sizeof root) < 0) die("cwd");
    if (cx_fmt(work, sizeof work, "%s/run-reserve-XXXXXX", sy_env_or("TMPDIR", "/tmp")) || !mkdtemp(work)) die("work");
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", root)) die("com");
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", root)) die("bound");
    if (cx_fmt(src, sizeof src, "%s/t.c", work)) die("src");
    if (cx_write(src, "int main(void){return 7;}\n", 26)) die("write");
    r = go(0, a);
    ck(r.rc == 7 && !r.outn && !r.errn, "unlimited-returns-7");
    np_free(&r);
    r = go("-v 40000", a);
    ck(r.rc == 2 && !r.outn && r.errn && tx_find(r.err, (long)r.errn, "run: out of memory", 18) >= 0, "low-named-refusal");
    np_free(&r);
    r = go(0, a);
    ck(r.rc == 7 && !r.outn && !r.errn, "after-refusal-returns-7");
    np_free(&r);
    cx_rmtree(work);
    sy_printf("RUN_RESERVE\tassertions=%d\tfailed=%d\n", assertions, failures);
    return failures ? 1 : 0;
}
