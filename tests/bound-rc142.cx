/* tests/bound-rc142.cx -- res.runner.bound-rc142 on the installed tree.
 *
 *   sh ./unisacc.com tests/bound-rc142.cx
 *
 * tools/bound 1 sleep 3 exits 142. That code is a deadline, so the
 * classification line is UNKNOWN, not a product exit. A command that
 * finishes inside the bound stays rc 0 and is not UNKNOWN.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.sig

static char root[4096], bound[4400];
static int assertions, failures;

static void die(const char *s) { sy_eprintf("bound-rc142: REFUSE %s\n", s); sy_exit(2); }
static void ck(int ok, const char *name) {
    assertions++;
    if (ok) sy_printf("PASS\tbound-rc142.%s\n", name);
    else { failures++; sy_printf("FAIL\tbound-rc142.%s\n", name); }
}
static np_result runb(char **args) {
    char *v[8]; int n = 0, k; char why[256]; np_result r;
    v[n++] = bound;
    for (k = 0; args[k] && n < 7; k++) v[n++] = args[k];
    v[n] = 0;
    if (np_run(v, root, 0, 20, &r, why, sizeof why)) die(why);
    return r;
}

int main(void) {
    np_result r;
    if (sy_cwd(root, sizeof root) < 0) die("cwd");
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", root)) die("bound");
    { char *a[] = {"1", "sleep", "3", 0}; r = runb(a);
      ck(r.rc == 142, "deadline-rc142");
      if (r.rc == 142) sy_printf("CLASSIFY\trc142\tUNKNOWN\n");
      np_free(&r); }
    { char *a[] = {"2", "true", 0}; r = runb(a);
      ck(r.rc == 0, "finished-command-rc0");
      np_free(&r); }
    sy_printf("BOUND_RC142\tassertions=%d\tfailed=%d\n", assertions, failures);
    return failures ? 1 : 0;
}
