/* Generic material contract, using a miniature registry and the real product.
 * prepare ROOT NEW_FIXTURE copies immutable inputs and runs metadata controls.
 * Exercise all-waves init/material/wave and executor/start/run/finish separately
 * (each under tools/bound 55), then verify FIXTURE SESSION RUN_BATCH_ELF.
 * Fixture qualification is solely this two-row synthetic contract, never the
 * repository release registry. No source identity or execution result is faked. */
#pragma unisa use cxlib.allsession
#pragma unisa use text.text
static char why[1700];static int assertions,failed;
static const char *literal="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
static const char *other="1123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
static void die(const char *s){fprintf(stderr,"typed-materials: %s %s errno=%d\n",s,why,errno);exit(2);}
static void check(const char *s,int ok){assertions++;if(!ok)failed++;printf("TYPED_CONTROL\t%s\t%s\n",ok?"PASS":"FAIL",s);}
static void join(char *p,size_t n,const char *a,const char *b){int z=snprintf(p,n,"%s/%s",a,b);if(z<0||(size_t)z>=n)die("path-bound");}
static void write_file(const char *p,const char *s,size_t n,int fresh){int f=open(p,O_WRONLY|O_CREAT|(fresh?O_EXCL:O_TRUNC)|O_CLOEXEC,0600);if(f<0)die("write-open");size_t at=0;while(at<n){ssize_t z=write(f,s+at,n-at);if(z<=0)die("write");at+=(size_t)z;}if(close(f))die("close");}
static char *read_file(const char *p,size_t *n){char *s=as_read(p,0,n,why,sizeof why);if(!s)die("read");return s;}
static void copy_file(const char *src,const char *dst){size_t n;char *s=read_file(src,&n);write_file(dst,s,n,1);struct stat st;if(stat(src,&st)||chmod(dst,st.st_mode&0777))die("copy-mode");free(s);}
static void copy_tree(const char *src,const char *dst){struct stat st;if(lstat(src,&st))die("copy-stat");if(S_ISREG(st.st_mode)){copy_file(src,dst);return;}if(S_ISLNK(st.st_mode)){char t[4096];ssize_t n=readlink(src,t,sizeof t-1);if(n<0||n>=(ssize_t)sizeof t-1)die("copy-link");t[n]=0;if(symlink(t,dst))die("copy-symlink");return;}if(!S_ISDIR(st.st_mode)||mkdir(dst,0700))die("copy-directory");DIR *d=opendir(src);if(!d)die("copy-opendir");struct dirent *e;while((e=readdir(d)))if(!tx_eq(e->d_name, ".", 1L << 20)&&!tx_eq(e->d_name, "..", 1L << 20)){char a[4400],b[4400];join(a,sizeof a,src,e->d_name);join(b,sizeof b,dst,e->d_name);copy_tree(a,b);}closedir(d);}
static void registry(np_buf *b,const char *spec,const char *args){np_puts(b,"id\timplementation\tlayer\tsource\tmode\tplatform\tbudget_seconds\tmaterials\tentry\targs\tcoverage\texpect\n");np_puts(b,"typed-wave\tIMPLEMENTED\tcontract\ttests/tiny.cx\tSOURCE\tlnx/x86_64\t12\t");np_puts(b,spec);np_puts(b,"\ttests/tiny.cx\t");np_puts(b,args);np_puts(b,"\ttyped.wave\trc0:TYPED_LEAF\ntyped-split\tIMPLEMENTED\tcontract\ttests/tiny.cx\tSOURCE\tlnx/x86_64\t12\t");np_puts(b,spec);np_puts(b,"\ttests/tiny.cx\t");np_puts(b,args);np_puts(b,"\ttyped.split\trc0:TYPED_LEAF\n");}
static const char *coverage="id\tlayer\timplementation\texpected_or_gap\tsource\ntyped.wave\tcontract\tIMPLEMENTED\tvalue+path preserved\ttests/tiny.cx\ntyped.split\tcontract\tIMPLEMENTED\tsealed split receipt\ttests/tiny.cx\n";
static int metadata(const char *root,const char *spec,const char *args){np_buf b={0,0,0};registry(&b,spec,args);tp_summary sum;int rc=tp_analyze(root,b.p,b.n,coverage,strlen(coverage),0,&sum,why,sizeof why);free(b.p);return rc;}
static int conflicting_metadata(const char *root){np_buf a={0,0,0},b={0,0,0};registry(&a,"literal:sha256,asset","{literal};{asset}");np_replace(a.p,a.n,"literal:sha256,asset",strlen("literal:sha256,asset"),"literal:path,asset",strlen("literal:path,asset"),1,&b);tp_summary sum;int rc=tp_analyze(root,b.p,b.n,coverage,strlen(coverage),0,&sum,why,sizeof why);free(a.p);free(b.p);return rc&&strstr(why,"material-type-conflict");}
static int prepare(const char *root,const char *out){if(mkdir(out,0700))die("new-fixture-required");static const char *dirs[]={"tests","tools","tools/cxlib","cx","out","exec","exec/c","exec/c/asm","src","kernel","weights","seed","iterate","iterate/kernel"};for(size_t i=0;i<sizeof dirs/sizeof dirs[0];i++){char p[4400];join(p,sizeof p,out,dirs[i]);if(mkdir(p,0700))die("mkdir");}
 char a[4400],b[4400];join(a,sizeof a,root,"include");join(b,sizeof b,out,"include");copy_tree(a,b);
 static const char *files[]={"unisacc.com","seed/ident.c","seed/sha256.h","iterate/kernel/typekw.tsv","tools/bound","tools/bound.c","tools/cxbin","tools/safedel.cx","tools/lib.sh","tools/build_ref.sh","tools/export_ref.sh","tools/refshim.h","tools/reffoot.h","tools/sourceflat.cx","tools/all-waves.cx","tests/run-batch.cx","tools/cxlib/allsession.cx","tools/cxlib/testplan.cx","tools/cxlib/netpack.cx"};for(size_t i=0;i<sizeof files/sizeof files[0];i++){join(a,sizeof a,root,files[i]);join(b,sizeof b,out,files[i]);copy_file(a,b);}join(b,sizeof b,out,"tests/cxlib");if(symlink("../tools/cxlib",b))die("module-link");
 const char *tiny="int main(int argc,char **argv){if(argc!=3||strcmp(argv[1],\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"))return 1;size_t n;char *s=cx_read(argv[2],&n);int ok=s&&n==6&&!memcmp(s,\"asset\\n\",6);free(s);if(ok)puts(\"TYPED_LEAF\");return !ok;}\n";
 join(b,sizeof b,out,"tests/tiny.cx");write_file(b,tiny,strlen(tiny),1);join(b,sizeof b,out,"out/asset");write_file(b,"asset\n",6,1);
 np_buf reg={0,0,0};registry(&reg,"literal:sha256,asset","{literal};{asset}");join(b,sizeof b,out,"tests/batches.tsv");write_file(b,reg.p,reg.n,1);free(reg.p);join(b,sizeof b,out,"tests/coverage.tsv");write_file(b,coverage,strlen(coverage),1);
 check("typed-metadata",!metadata(out,"literal:sha256,asset","{literal};{asset}"));check("legacy-path-metadata",!metadata(out,"literal,asset:path","{literal};{asset}"));check("unknown-type",metadata(out,"literal:unknown,asset","{literal};{asset}")!=0);check("sha-path-suffix",metadata(out,"literal:sha256,asset","{literal}/file;{asset}")!=0);check("duplicate-across-types",metadata(out,"literal:sha256,literal:path","{literal}")!=0);
 check("cross-row-type-conflict",conflicting_metadata(out));check("mixed-sentinel-rejected",metadata(out,"literal,-","{literal}")!=0);check("lowercase-hex",tp_material_value(2,literal)&&!tp_material_value(2,"ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef0123456789ab"));check("short-hex",!tp_material_value(2,"abc"));check("nonhex",!tp_material_value(2,"g123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"));check("cross-type-values",!tp_material_value(2,"/tmp/value")&&!tp_material_value(1,literal));
 np_buf map={0,0,0};np_puts(&map,"literal\t");np_puts(&map,literal);np_puts(&map,"\nasset\t");join(b,sizeof b,out,"out/asset");np_puts(&map,b);np_puts(&map,"\n");join(b,sizeof b,out,"out/map.tsv");write_file(b,map.p,map.n,1);free(map.p);printf("FIXTURE\t%s\tprepared-only\n",out);return failed?1:0;
}
static void replace_file(const char *p,const char *old,const char *nw){size_t n;char *s=read_file(p,&n);if(np_count(s,n,old,strlen(old))!=1)die("replace-not-unique");np_buf b={0,0,0};np_replace(s,n,old,strlen(old),nw,strlen(nw),1,&b);write_file(p,b.p,b.n,0);free(s);free(b.p);}
static void rechain(const char *p){size_t n,at=0;char *s=read_file(p,&n);np_buf b={0,0,0};while(at<n){size_t end=at;while(end<n&&s[end]!='\n')end++;if(end-at>6&&!memcmp(s+at,"BLOCK\t",6)){const char *pv=0;for(size_t i=at;i+6<=end;i++)if(!memcmp(s+i,"\tprev=",6))pv=s+i;if(!pv)die("rechain");char h[65];cx_sha256_hex(b.p?b.p:"",b.n,h);np_put(&b,s+at,(size_t)(pv-s-at));np_puts(&b,"\tprev=");np_puts(&b,h);np_puts(&b,"\n");}else np_put(&b,s+at,end-at+1);at=end+1;}write_file(p,b.p,b.n,0);free(s);free(b.p);}
static char *aggregate_text;
static int aggregate(const char *root,const char *session){char log[4400];join(log,sizeof log,root,"out/typed-aggregate.log");fflush(stdout);int save=dup(1),fd=open(log,O_WRONLY|O_CREAT|O_TRUNC,0600);if(save<0||fd<0||dup2(fd,1)<0)die("redirect");close(fd);int rc=as_aggregate(root,session);fflush(stdout);if(dup2(save,1)<0)die("restore");close(save);free(aggregate_text);size_t n;aggregate_text=read_file(log,&n);return rc;}
static void runner_reject(const char *root,const char *runner,const char *value,const char *name){char parent[4400],asset[4400],a[4400],b[4400];join(parent,sizeof parent,root,"out/negative");join(asset,sizeof asset,root,"out/asset");{if(cx_fmt(a,sizeof a,"literal=%s",value))die("format-bound");}{if(cx_fmt(b,sizeof b,"asset=%s",asset))die("format-bound");}char *v[]={(char *)runner,(char *)root,parent,"typed-wave",a,b,0};np_result r;int rc=np_run(v,root,0,8,&r,why,sizeof why);check(name,!rc&&r.rc==2&&strstr(r.err,"material typed value"));np_free(&r);}
static void runner_path_reject(const char *root,const char *runner,const char *suffix,const char *reason,const char *name){char parent[4400],asset[4400],a[4400],b[4400];join(parent,sizeof parent,root,"out/negative");join(asset,sizeof asset,root,suffix);{if(cx_fmt(a,sizeof a,"literal=%s",literal))die("format-bound");}{if(cx_fmt(b,sizeof b,"asset=%s",asset))die("format-bound");}char *v[]={(char *)runner,(char *)root,parent,"typed-wave",a,b,0};np_result r;int rc=np_run(v,root,0,8,&r,why,sizeof why);check(name,!rc&&r.rc==2&&strstr(r.err,reason));np_free(&r);}
static int verify(const char *root,const char *session,const char *runner){
 check("actual-wave-and-split-aggregate",aggregate(root,session)==0);as_manifest m;if(as_load(session,&m,why,sizeof why))die("manifest");const as_material *x=as_find_material(&m,"literal");check("literal-manifest-type",x&&x->kind==2&&tx_eq(x->path, literal, 1L << 20)&&x->entries==0&&!tx_eq(x->content, literal, 1L << 20));check("path-manifest-type",as_find_material(&m,"asset")&&as_find_material(&m,"asset")->kind==1);char receipt[4400],receipt_sha[65];if(!m.nref)die("missing-real-receipt");join(receipt,sizeof receipt,session,m.ref[0].rel);{if(cx_fmt(receipt_sha,sizeof receipt_sha,"%s",m.ref[0].sha))die("sha-bound");}as_free(&m);
 char p[4400],mp[4400];join(p,sizeof p,session,"session.tsv");join(mp,sizeof mp,session,"materials.tsv");size_t n,mn;char *original=read_file(p,&n),*map=read_file(mp,&mn);
 char old[200],nw[200];{if(cx_fmt(old,sizeof old,"MATERIAL\tliteral\t%s\t",literal))die("format-bound");}{if(cx_fmt(nw,sizeof nw,"MATERIAL\tliteral\t%s\t",other))die("format-bound");}replace_file(p,old,nw);rechain(p);check("manifest-literal-rechained-rejected",aggregate(root,session)==2&&strstr(aggregate_text,"material-map-binding"));write_file(p,original,n,0);check("manifest-restored",aggregate(root,session)==0);
 replace_file(p,"\ttype=sha256\n","\ttype=unknown\n");rechain(p);check("unknown-wire-type-rejected",aggregate(root,session)==2);write_file(p,original,n,0);
 replace_file(mp,literal,other);check("map-literal-mutation-rejected",aggregate(root,session)==2);write_file(mp,map,mn,0);check("map-restored",aggregate(root,session)==0);
 size_t rn;char *receipt_original=read_file(receipt,&rn);replace_file(receipt,"\ttype=sha256\n","\ttype=path\n");char changed_sha[65];if(as_sha_file(receipt,0,changed_sha,0,why,sizeof why))die("receipt-hash");replace_file(p,receipt_sha,changed_sha);rechain(p);check("receipt-cross-type-rehashed-rejected",aggregate(root,session)==1&&strstr(aggregate_text,"receipt-material-identity"));write_file(receipt,receipt_original,rn,0);write_file(p,original,n,0);free(receipt_original);check("receipt-restored",aggregate(root,session)==0);
 char dir[4400];join(dir,sizeof dir,root,"out/negative");if(mkdir(dir,0700))die("negative-dir");runner_reject(root,runner,"abc","run-batch-short-hex");runner_reject(root,runner,"/tmp/file","run-batch-path-as-literal");runner_path_reject(root,runner,"out/asset/child","material path stat","run-batch-enotdir-is-error");runner_path_reject(root,runner,"out/absent","material path absent","run-batch-enoent-is-absent");free(original);free(map);free(aggregate_text);aggregate_text=0;return failed?1:0;
}
int main(int argc,char **argv){int rc;if(argc==4&&tx_eq(argv[1], "prepare", 1L << 20))rc=prepare(argv[2],argv[3]);else if(argc==5&&tx_eq(argv[1], "verify", 1L << 20))rc=verify(argv[2],argv[3],argv[4]);else{fputs("usage: prepare ROOT NEW_FIXTURE | verify FIXTURE SESSION RUN_BATCH_ELF\n",stderr);return 2;}printf("TYPED_MATERIALS\tassertions=%d\tfailed=%d\tscope=synthetic-contract-only\n",assertions,failed);return rc;}
