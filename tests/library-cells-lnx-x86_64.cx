/* Library domain cells closable through the installed product alone (tests/library-domain-matrix.tsv,
 * branch C/L1).  Usage: ROOT NEW_ABS_OUT.  Every program below is compiler input data written to the
 * private output directory at run time and executed by `sh ROOT/unisacc.com` (default -run); no host
 * compiler, no prebuilt fixture.
 *
 * Cells and oracles (hand-derived, never taken from product output):
 *  lib.ffi.unisacc_ffi        include/unisacc_ffi.h against host glibc and libz:
 *                             strlen("hello, world") = 12; abs(-7) = 7;
 *                             snprintf(buf,32,"%d-%.1f",42,2.5) -> "42-2.5", returns 6 (C99 7.19.6.5);
 *                             adler32_combine(adler32("a")=0x00620062, adler32("b")=0x00630063, 1)
 *                             = adler32("ab") = 0x012600c4 (RFC 1950 8.2: s1=1+97+98, s2=98+196);
 *                             dlsym of an absent name -> NULL and dlerror ends ": undefined symbol: NAME";
 *                             dlopen of an absent file -> NULL and dlerror
 *                             "NAME: cannot open shared object file: No such file or directory" (glibc);
 *                             dlclose of a live handle -> 0; a NULL value vector -> -3 (header contract).
 *  lib.layout.api-structs     exec/c/libunisacc.h compiled by the product: us_type_descriptor is six
 *                             uint64_t -> size 48, offsets 0,8,..,40; us_signature (x86-64 psABI LP64):
 *                             kind 0, result 8 (align 8, 48 B), args 56, count 64, variadic 72,
 *                             extent 80, writable 88, size 96.
 *  lib.layout.host-headers    carried <sys/stat.h>, <time.h>, <sys/time.h> against glibc x86_64
 *                             bits/struct_stat.h: stat 144 B; st_dev 0, st_ino 8, st_nlink 16, st_mode 24,
 *                             st_uid 28, st_gid 32, st_rdev 40, st_size 48, st_blksize 56, st_blocks 64,
 *                             st_atime 72, st_mtime 88, st_ctime 104; timespec/timeval 16 B, 0 and 8;
 *                             stat("/dev/null") is S_IFCHR with st_rdev makedev(1,3) = 0x103.
 *                             struct dirent is recorded as OBSERVED only: the carried type has no
 *                             d_off/d_reclen, so it is not the glibc layout (cell stays open).
 *  lib.cb.wrapper-index-beyond-10  101 distinct address-taken comparators (wrapper indices 0..100,
 *                             one-, two- and three-digit labels) each sort {7,0} -> {0,7} through
 *                             host-forwarded qsort (getpgrp() enables Linux host forwarding, as in
 *                             tests/callback-wrapper-index.cx); literal "CBW101\t203\n".
 * Every child must exit 0 with exactly the expected stdout and empty stderr; a watchdog, signal or
 * transport result is a FAIL, never a pass.  A check this host cannot exercise prints UNVERIFIED and
 * the batch exits 3.  Linux x86_64 only; foreign hosts are NOT_RUN. */
#pragma unisa use cxlib.netpack
static char root[4096], work[4096], com[4200], bound[4200], incflag[4300];
static int assertions, failures, unverified;
static void die(const char *s) { fprintf(stderr, "library-cells: REFUSE %s errno=%d\n", s, errno); exit(2); }
static void ck(int ok, const char *label) { assertions++; if (!ok) failures++; printf("%s\t%s\n", ok ? "PASS" : "FAIL", label); }
static void unv(const char *label, const char *why) { unverified++; printf("UNVERIFIED\t%s\t%s\n", label, why); }
static void path(char *o, size_t cap, const char *a, const char *b) { int n = snprintf(o, cap, "%s/%s", a, b); if (n < 0 || (size_t)n >= cap) die("path"); }
static void copy_fit(char *d, size_t cap, const char *s) { size_t n = strlen(s), i; if (n + 1 > cap) die("copy-bound"); for (i = 0; i < n + 1; i++) d[i] = s[i]; }
static int within(const char *p, const char *base) { size_t n = strlen(base); return !strncmp(p, base, n) && (!p[n] || p[n] == '/'); }
static void saved(const char *name, const void *s, size_t n) {
    char p[4400]; path(p, sizeof p, work, name);
    int f = open(p, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600); size_t at = 0; if (f < 0) die(p);
    while (at < n) { ssize_t k = write(f, (const char *)s + at, n - at); if (k < 0 && errno == EINTR) continue; if (k <= 0) die("write"); at += (size_t)k; }
    if (close(f)) die("close");
}
static void sha_file(const char *p, char h[65]) {
    struct stat st; errno = 0; if (lstat(p, &st) || !S_ISREG(st.st_mode)) die("regular-input");
    size_t n; char *s = cx_read(p, &n); if (!s || n != (size_t)st.st_size) die("input-extent"); cx_sha256_hex(s, n, h); free(s);
}

/* ---- compiler input data -------------------------------------------------------------------- */
static const char *FFI_C =
"#include <stdio.h>\n#include <string.h>\n#include <unisacc_ffi.h>\n"
"int main(void) {\n"
"    void *f = uffi_dlsym(UFFI_RTLD_DEFAULT, \"strlen\");\n"
"    long n = 0; const char *s = \"hello, world\"; void *v1[1]; int k1[1]; k1[0] = UFFI_POINTER; v1[0] = &s;\n"
"    int rc = uffi_call(f, UFFI_LONG, k1, v1, 1, -1, &n); printf(\"strlen rc=%d value=%ld\\n\", rc, n);\n"
"    void *absf = uffi_dlsym(UFFI_RTLD_DEFAULT, \"abs\"); long r = 0; int m = -7; int ka[1]; void *va[1]; ka[0] = UFFI_INT; va[0] = &m;\n"
"    rc = uffi_call(absf, UFFI_INT, ka, va, 1, -1, &r); printf(\"abs rc=%d value=%d\\n\", rc, (int)r);\n"
"    void *snp = uffi_dlsym(UFFI_RTLD_DEFAULT, \"snprintf\"); char buf[32]; char *bp = buf; long cap = 32; const char *fmt = \"%d-%.1f\";\n"
"    int i42 = 42; double d = 2.5; int ks[5]; void *vs[5]; long w = 0;\n"
"    ks[0] = UFFI_POINTER; ks[1] = UFFI_ULONG; ks[2] = UFFI_POINTER; ks[3] = UFFI_INT; ks[4] = UFFI_DOUBLE;\n"
"    vs[0] = &bp; vs[1] = &cap; vs[2] = &fmt; vs[3] = &i42; vs[4] = &d; memset(buf, 0, sizeof buf);\n"
"    rc = uffi_call(snp, UFFI_INT, ks, vs, 5, 3, &w); printf(\"snprintf rc=%d value=%d text=%s\\n\", rc, (int)w, buf);\n"
"    void *z = uffi_dlopen(\"libz.so.1\", 2);\n"
"    if (!z) puts(\"libz absent\");\n"
"    else {\n"
"        void *comb = uffi_dlsym(z, \"adler32_combine\"); unsigned long a1 = 0x00620062UL, a2 = 0x00630063UL, out = 0; long len2 = 1;\n"
"        int kc[3]; void *vc[3]; kc[0] = UFFI_ULONG; kc[1] = UFFI_ULONG; kc[2] = UFFI_LONG; vc[0] = &a1; vc[1] = &a2; vc[2] = &len2;\n"
"        rc = comb ? uffi_call(comb, UFFI_ULONG, kc, vc, 3, -1, &out) : -99; printf(\"adler32_combine rc=%d value=%08lx\\n\", rc, out);\n"
"        void *missing = uffi_dlsym(z, \"no_such_symbol_lc\"); const char *e = uffi_dlerror(); const char *tail = \": undefined symbol: no_such_symbol_lc\";\n"
"        size_t el = e ? strlen(e) : 0, tl = strlen(tail);\n"
"        printf(\"dlsym-missing null=%d error-suffix=%d\\n\", missing == 0, el >= tl && !strcmp(e + el - tl, tail));\n"
"        printf(\"dlclose=%d\\n\", uffi_dlclose(z));\n"
"    }\n"
"    void *none = uffi_dlopen(\"nonexistent_library_cells.so\", 2); const char *e2 = uffi_dlerror();\n"
"    printf(\"dlopen-missing null=%d error=%s\\n\", none == 0, e2 ? e2 : \"(null)\");\n"
"    rc = uffi_call(f, UFFI_LONG, k1, 0, 1, -1, &n); printf(\"null-vector rc=%d\\n\", rc);\n"
"    return 0;\n}\n";
static const char *FFI_WANT[] = {
    "strlen rc=0 value=12", "abs rc=0 value=7", "snprintf rc=0 value=6 text=42-2.5",
    "adler32_combine rc=0 value=012600c4", "dlsym-missing null=1 error-suffix=1", "dlclose=0",
    "dlopen-missing null=1 error=nonexistent_library_cells.so: cannot open shared object file: No such file or directory",
    "null-vector rc=-3"};
static const char *FFI_LABEL[] = {"strlen-12", "abs-7", "snprintf-variadic-42-2.5", "libz-adler32-combine-0x012600c4",
    "dlsym-missing-null-and-dlerror", "dlclose-0", "dlopen-missing-dlerror", "null-vector-refused-minus3"};

static const char *LAYOUT_C =
"#include <stdio.h>\n#include <stddef.h>\n#include <sys/stat.h>\n#include <sys/time.h>\n#include <dirent.h>\n#include <time.h>\n"
"#include \"exec/c/libunisacc.h\"\n"
"int main(void) {\n"
"    printf(\"stat size=%d dev=%d ino=%d nlink=%d mode=%d uid=%d gid=%d rdev=%d size_=%d blksize=%d blocks=%d atime=%d mtime=%d ctime=%d\\n\",\n"
"        (int)sizeof(struct stat), (int)offsetof(struct stat, st_dev), (int)offsetof(struct stat, st_ino), (int)offsetof(struct stat, st_nlink),\n"
"        (int)offsetof(struct stat, st_mode), (int)offsetof(struct stat, st_uid), (int)offsetof(struct stat, st_gid), (int)offsetof(struct stat, st_rdev),\n"
"        (int)offsetof(struct stat, st_size), (int)offsetof(struct stat, st_blksize), (int)offsetof(struct stat, st_blocks),\n"
"        (int)offsetof(struct stat, st_atime), (int)offsetof(struct stat, st_mtime), (int)offsetof(struct stat, st_ctime));\n"
"    printf(\"timespec size=%d sec=%d nsec=%d\\n\", (int)sizeof(struct timespec), (int)offsetof(struct timespec, tv_sec), (int)offsetof(struct timespec, tv_nsec));\n"
"    printf(\"timeval size=%d sec=%d usec=%d\\n\", (int)sizeof(struct timeval), (int)offsetof(struct timeval, tv_sec), (int)offsetof(struct timeval, tv_usec));\n"
"    printf(\"dirent size=%d ino=%d type=%d name=%d\\n\", (int)sizeof(struct dirent), (int)offsetof(struct dirent, d_ino),\n"
"        (int)offsetof(struct dirent, d_type), (int)offsetof(struct dirent, d_name));\n"
"    printf(\"us_type_descriptor size=%d depth=%d base=%d shape=%d kind=%d width=%d uns=%d\\n\", (int)sizeof(us_type_descriptor),\n"
"        (int)offsetof(us_type_descriptor, depth), (int)offsetof(us_type_descriptor, base), (int)offsetof(us_type_descriptor, shape),\n"
"        (int)offsetof(us_type_descriptor, kind), (int)offsetof(us_type_descriptor, width), (int)offsetof(us_type_descriptor, uns));\n"
"    printf(\"us_signature size=%d kind=%d result=%d args=%d count=%d variadic=%d extent=%d writable=%d\\n\", (int)sizeof(us_signature),\n"
"        (int)offsetof(us_signature, kind), (int)offsetof(us_signature, result), (int)offsetof(us_signature, args), (int)offsetof(us_signature, count),\n"
"        (int)offsetof(us_signature, variadic), (int)offsetof(us_signature, extent), (int)offsetof(us_signature, writable));\n"
"    struct stat st; int rc = stat(\"/dev/null\", &st);\n"
"    printf(\"devnull rc=%d chr=%d rdev=%lx\\n\", rc, rc == 0 && (st.st_mode & S_IFMT) == S_IFCHR, rc == 0 ? (unsigned long)st.st_rdev : 0UL);\n"
"    return 0;\n}\n";
/* line index 3 (dirent) is an observation, not an assertion */
static const char *LAYOUT_WANT[] = {
    "stat size=144 dev=0 ino=8 nlink=16 mode=24 uid=28 gid=32 rdev=40 size_=48 blksize=56 blocks=64 atime=72 mtime=88 ctime=104",
    "timespec size=16 sec=0 nsec=8", "timeval size=16 sec=0 usec=8", 0,
    "us_type_descriptor size=48 depth=0 base=8 shape=16 kind=24 width=32 uns=40",
    "us_signature size=96 kind=0 result=8 args=56 count=64 variadic=72 extent=80 writable=88",
    "devnull rc=0 chr=1 rdev=103"};
static const char *LAYOUT_LABEL[] = {"lib.layout.host-headers.stat-glibc-x86_64", "lib.layout.host-headers.timespec",
    "lib.layout.host-headers.timeval", "lib.layout.host-headers.dirent", "lib.layout.api-structs.us_type_descriptor-48",
    "lib.layout.api-structs.us_signature-96", "lib.layout.host-headers.stat-devnull-chr-rdev-0x103"};

enum { NCB = 101 };
static char *wrapper_source(size_t *n) {
    size_t cap = 65536, at = 0; char *s = malloc(cap); if (!s) die("cbw-allocation");
#define EMIT(...) do { int z = snprintf(s + at, cap - at, __VA_ARGS__); if (z < 0 || (size_t)z >= cap - at) die("cbw-bound"); at += (size_t)z; } while (0)
    EMIT("#include <stdio.h>\n#include <stdlib.h>\n#include <unistd.h>\n");
    for (int i = 0; i < NCB; i++) EMIT("static int cb_%d(const void *a, const void *b) { int x = *(const int *)a, y = *(const int *)b; return ((x > y) - (x < y)) * %d; }\n", i, i + 1);
    EMIT("int main(void) {\n    int checks = 0, v[2]; if (getpgrp() <= 0) return 90; checks++;\n");
    for (int i = 0; i < NCB; i++) EMIT("    v[0] = 7; v[1] = 0; qsort(v, 2, sizeof v[0], cb_%d); if (v[0] != 0 || v[1] != 7) return 1; checks += 2;\n", i);
    EMIT("    printf(\"CBW%d\\t%%d\\n\", checks); return 0;\n}\n", NCB);
#undef EMIT
    *n = at; return s;
}

/* ---- product runs ----------------------------------------------------------------------------- */
static np_result product(const char *const *args, const char *name) {
    char *v[24], why[1024], op[256]; int n = 0, i; np_result r;
    v[n++] = bound; v[n++] = "25"; v[n++] = "sh"; v[n++] = com; for (i = 0; args[i]; i++) { if (n >= 23) die("argv"); v[n++] = (char *)args[i]; } v[n] = 0;
    if (np_run(v, work, 0, 28, &r, why, sizeof why)) die(why);
    { int z = snprintf(op, sizeof op, "%s.stdout", name); if (z < 0 || (size_t)z >= sizeof op) die("evidence"); saved(op, r.out, r.outn); }
    { int z = snprintf(op, sizeof op, "%s.stderr", name); if (z < 0 || (size_t)z >= sizeof op) die("evidence"); saved(op, r.err, r.errn); }
    return r;
}
/* split stdout into at most cap lines; returns the count, or -1 when the text does not end in LF */
static int lines(const np_result *r, char out[][512], int cap) {
    int k = 0; size_t at = 0;
    if (!r->outn || r->out[r->outn - 1] != '\n') return -1;
    while (at < r->outn) {
        size_t e = at; while (r->out[e] != '\n') e++;
        if (k == cap || e - at >= 512) return -1;
        memcpy(out[k], r->out + at, e - at); out[k][e - at] = 0; k++; at = e + 1;
    }
    return k;
}
static void child_clean(const np_result *r, const char *label) {
    char l[160]; snprintf(l, sizeof l, "%s.exit-0-empty-stderr", label);
    if (r->rc || r->errn) { fprintf(stderr, "library-cells: %s rc=%d\n", label, r->rc); if (r->errn) fwrite(r->err, 1, r->errn, stderr); }
    ck(!r->rc && !r->errn, l);
}

static void ffi_cell(void) {
    saved("ffi.c", FFI_C, strlen(FFI_C));
    const char *args[] = {"ffi.c", 0}; np_result r = product(args, "ffi");
    child_clean(&r, "lib.ffi.unisacc_ffi");
    char got[16][512]; int n = lines(&r, got, 16), libz = 1, i;
    for (i = 0; i < n; i++) if (!strcmp(got[i], "libz absent")) libz = 0;
    if (!libz) {   /* the host lacks libz.so.1: three libz checks cannot run here */
        ck(n == 6, "lib.ffi.unisacc_ffi.line-count");
        static const int keep[] = {0, 1, 2, 6, 7}; int at = 0;
        for (i = 0; i < 5; i++) { while (at < n && !strcmp(got[at], "libz absent")) at++; char l[160]; snprintf(l, sizeof l, "lib.ffi.unisacc_ffi.%s", FFI_LABEL[keep[i]]); ck(at < n && !strcmp(got[at], FFI_WANT[keep[i]]), l); at++; }
        unv("lib.ffi.unisacc_ffi.libz-adler32-combine-0x012600c4", "host has no libz.so.1");
        unv("lib.ffi.unisacc_ffi.dlsym-missing-null-and-dlerror", "host has no libz.so.1");
        unv("lib.ffi.unisacc_ffi.dlclose-0", "host has no libz.so.1");
    } else {
        ck(n == 8, "lib.ffi.unisacc_ffi.line-count");
        for (i = 0; i < 8; i++) { char l[160]; snprintf(l, sizeof l, "lib.ffi.unisacc_ffi.%s", FFI_LABEL[i]); ck(i < n && !strcmp(got[i], FFI_WANT[i]), l); }
    }
    np_free(&r);
}
static void layout_cell(void) {
    saved("layout.c", LAYOUT_C, strlen(LAYOUT_C));
    const char *args[] = {incflag, "layout.c", 0}; np_result r = product(args, "layout");
    child_clean(&r, "lib.layout.product-compiled");
    char got[16][512]; int n = lines(&r, got, 16), i;
    ck(n == 7, "lib.layout.line-count");
    for (i = 0; i < 7; i++) {
        if (!LAYOUT_WANT[i]) { printf("OBSERVED\t%s\t%s\n", LAYOUT_LABEL[i], i < n ? got[i] : "(missing)"); continue; }
        ck(i < n && !strcmp(got[i], LAYOUT_WANT[i]), LAYOUT_LABEL[i]);
    }
    np_free(&r);
}
static void wrapper_cell(void) {
    size_t n; char *s = wrapper_source(&n); saved("cbw.c", s, n); free(s);
    const char *args[] = {"cbw.c", 0}; np_result r = product(args, "cbw");
    child_clean(&r, "lib.cb.wrapper-index-beyond-10");
    static const char want[] = "CBW101\t203\n";
    ck(r.outn == sizeof want - 1 && !memcmp(r.out, want, sizeof want - 1), "lib.cb.wrapper-index-beyond-10.indices-0-100-sorted-203");
    np_free(&r);
}

int main(int argc, char **argv) {
#if !defined(__linux__) || !defined(__x86_64__)
    fputs("NOT_RUN library-cells needs Linux/x86_64\n", stderr); puts("LIBRARY_CELLS\tassertions=0\tfailed=0\tunverified=1"); return 3;
#endif
    if (argc != 3 || !realpath(argv[1], root) || argv[2][0] != '/') die("usage ROOT NEW_ABS_OUT");
    char parent[4096], base[4096], leaf[4096]; copy_fit(parent, sizeof parent, argv[2]);
    char *slash = strrchr(parent, '/'); if (!slash || !slash[1] || !strcmp(slash + 1, ".") || !strcmp(slash + 1, "..")) die("output-leaf");
    copy_fit(leaf, sizeof leaf, slash + 1); if (slash == parent) slash[1] = 0; else *slash = 0;
    if (!realpath(parent, base)) die("output-parent");
    int z = snprintf(work, sizeof work, "%s%s%s", base, !strcmp(base, "/") ? "" : "/", leaf); if (z < 0 || (size_t)z >= sizeof work) die("output-bound");
    if (!within(work, base) || mkdir(work, 0700)) die("new-output-required");
    path(com, sizeof com, root, "unisacc.com"); path(bound, sizeof bound, root, "tools/bound");
    z = snprintf(incflag, sizeof incflag, "-I%s", root); if (z < 0 || (size_t)z >= sizeof incflag) die("include-flag");
    static const char *dep_names[] = {"unisacc.com", "include/unisacc_ffi.h", "exec/c/libunisacc.h", "include/sys/stat.h", "include/dirent.h"};
    enum { ND = 5 }; char dep_before[ND][65], dep_after[65], dp[4400];
    for (int i = 0; i < ND; i++) { path(dp, sizeof dp, root, dep_names[i]); sha_file(dp, dep_before[i]); }
    printf("CANDIDATE\t%s\n", dep_before[0]);
    ffi_cell();
    layout_cell();
    wrapper_cell();
    for (int i = 0; i < ND; i++) { char l[96]; path(dp, sizeof dp, root, dep_names[i]); sha_file(dp, dep_after);
        snprintf(l, sizeof l, "inputs-unchanged.%s", dep_names[i]); for (char *q = l; *q; q++) if (*q == '/') *q = '-'; ck(!strcmp(dep_after, dep_before[i]), l); }
    puts("NOT_CLAIMED\tlibrary-C-API-cells(no-product-built-libunisacc)-dirent-glibc-layout-foreign-hosts");
    printf("LIBRARY_CELLS\tassertions=%d\tfailed=%d\tunverified=%d\n", assertions, failures, unverified);
    return failures ? 1 : unverified ? 3 : 0;
}
