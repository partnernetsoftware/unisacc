# C99 features this compiler does not support yet, one per line:
# <probe> <reason>.  They are counted separately, and a knownfail that
# starts PASSING is a failure -- so the list cannot rot, and closing a gap
# means deleting a line here.
#
# This is the 0.0.6 work item [S-10 #9]: the goal is an empty list.
03_empty_varargs    ##__VA_ARGS__ is a GNU extension; C99 has no way to omit the last argument
04_func_name        __func__ is a C99 predefined identifier, not implemented
05_pragma_operator  the _Pragma operator is not implemented
07_hex_float        hexadecimal floating literals (0x1.8p1) are not lexed
08_ucn_ident        universal character names in identifiers are not supported
13_bool             <stdbool.h> is not carried
14_underscore_bool  _Bool is not a type here; 1 and 0 are ints
1b_flexible_array   a flexible array member `char d[]` needs a constant here
35_comma_ternary    the comma operator is not parsed in an expression
43_va_copy          va_copy is not in <stdarg.h>
53_inttypes         <inttypes.h> and its PRId64 family are not carried
56_strtod_family    strtod/strtof/strtold are not in <stdlib.h>
