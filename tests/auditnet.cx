#!/usr/bin/env -S unisacc.com -run
/* auditnet.cx -- the release gate re-checks every constructed network of the candidate (0.0.22 P1-C1), ported from
   tests/auditnet.py (2026-10-22, the owner's direction: the toolchain moves off Python).
   The candidate build retains each distinct (table, network) pair it packed in <candidate dir>/model-audit/ with
   models.json (exec/c/compilerpack.py retain_models).  Here each pair's hashes are re-verified and
   `run --check-net TABLE NET` enumerates the full domain again; the count goes into the release receipt.
   Fails on an empty audit, a hash mismatch, or any check failure: nothing checked is red.
   usage: MODEL_COM=PRODUCT [AUDIT_DIR=DIR] [EXEC_CC=cc] sh ./unisacc.com -run tests/auditnet.cx
   As the Python gate: argv is ignored; MODEL_COM is required; AUDIT_DIR defaults to model-audit beside MODEL_COM;
   paths are spelled as pathlib spells them (the summary line prints the audit directory); exec/c/run.c is built
   under the tests/bound watchdog (50 s) into a private temporary directory, each check under it (30 s); pairs are
   taken in key order; a key is shown by its first 16 characters and a failed check by the last 200 characters of
   its stderr (strict UTF-8).  Every error the Python gate raised (unreadable or malformed models.json, a missing
   file, a failed build) is a message on stderr and exit 1. */

static char *tmpdir_path;                 /* removed at exit, as TemporaryDirectory does on any exit */

static void rm_rf(const char *p) {
    struct stat s; DIR *d; struct dirent *e;
    if (lstat(p, &s) != 0) return;
    if (S_ISDIR(s.st_mode) && (d = opendir(p))) {
        while ((e = readdir(d))) {
            char *c; size_t l;
            if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
            l = strlen(p) + strlen(e->d_name) + 2; c = malloc(l);
            if (!c) break;
            snprintf(c, l, "%s/%s", p, e->d_name); rm_rf(c); free(c);
        }
        closedir(d); rmdir(p);
    } else unlink(p);
}
static void cleanup(void) { if (tmpdir_path) { rm_rf(tmpdir_path); tmpdir_path = 0; } }
static void die(const char *fmt, const char *arg) {
    fflush(stdout); fputs("auditnet: ", stderr); fprintf(stderr, fmt, arg); fputc('\n', stderr); exit(1);
}

/* ---------- pathlib spelling (PurePosixPath): '//' root kept, '///'.. is '/', empty and '.' parts dropped ---------- */
static char *pnorm(const char *in) {
    size_t n = strlen(in), o = 0, i = 0; char *r = malloc(n + 2);
    if (!r) die("%s", "out of memory");
    if (in[0] == '/') {
        if (in[1] == '/' && in[2] != '/') { r[o++] = '/'; r[o++] = '/'; i = 2; } else { r[o++] = '/'; i = 1; }
    }
    {
        size_t rootlen = o;
        while (i < n) {
            size_t j = i;
            while (j < n && in[j] != '/') j++;
            if (j > i && !(j - i == 1 && in[i] == '.')) {
                if (o > rootlen) r[o++] = '/';
                memcpy(r + o, in + i, j - i); o += j - i;
            }
            i = j + 1;
        }
        if (o == 0) r[o++] = '.';
    }
    r[o] = 0; return r;
}
static char *xdup(const char *s) {                /* not strdup: the carried libc lacks it and -run would forward it */
    size_t l = strlen(s) + 1; char *r = malloc(l);
    if (!r) die("%s", "out of memory");
    memcpy(r, s, l); return r;
}
static size_t rootlen(const char *p) { return p[0] != '/' ? 0 : (p[1] == '/' && p[2] != '/') ? 2 : 1; }
static char *pparent(const char *p) {             /* p already normalised */
    size_t rl = rootlen(p); const char *s = strrchr(p, '/'); char *r;
    if (!strcmp(p, ".") || strlen(p) == rl) return xdup(p);
    if (!s || (size_t)(s - p) < rl) return xdup(rl ? (rl == 2 ? "//" : "/") : ".");
    if ((size_t)(s - p) + 1 == rl) { r = malloc(rl + 1); memcpy(r, p, rl); r[rl] = 0; return r; }
    r = malloc(s - p + 1); memcpy(r, p, s - p); r[s - p] = 0; return r;
}
static char *pjoin(const char *base, const char *name, size_t namelen, const char *suffix) {
    size_t bl = strlen(base), sl = strlen(suffix); char *t = malloc(bl + namelen + sl + 3), *r;
    if (!t) die("%s", "out of memory");
    if (namelen && name[0] == '/') { memcpy(t, name, namelen); memcpy(t + namelen, suffix, sl + 1); }
    else {
        memcpy(t, base, bl);
        if (!(bl && base[bl - 1] == '/')) t[bl++] = '/';
        memcpy(t + bl, name, namelen); memcpy(t + bl + namelen, suffix, sl + 1);
    }
    r = pnorm(t); free(t); return r;
}

/* ---------- strict UTF-8 (CPython's decoder): no overlongs, no surrogates, nothing past U+10FFFF ---------- */
static int utf8_ok(const unsigned char *s, size_t n) {
    size_t i = 0;
    while (i < n) {
        unsigned c = s[i]; int k; unsigned lo = 0x80, hi = 0xBF;
        if (c < 0x80) { i++; continue; }
        if (c >= 0xC2 && c <= 0xDF) k = 1;
        else if (c >= 0xE0 && c <= 0xEF) { k = 2; if (c == 0xE0) lo = 0xA0; if (c == 0xED) hi = 0x9F; }
        else if (c >= 0xF0 && c <= 0xF4) { k = 3; if (c == 0xF0) lo = 0x90; if (c == 0xF4) hi = 0x8F; }
        else return 0;
        if (n - i < (size_t)k + 1) return 0;
        if (s[i + 1] < lo || s[i + 1] > hi) return 0;
        { int m; for (m = 2; m <= k; m++) if (s[i + m] < 0x80 || s[i + m] > 0xBF) return 0; }
        i += k + 1;
    }
    return 1;
}
static size_t prefix_chars(const char *s, size_t n, size_t chars) {   /* byte length of the first CHARS code points */
    size_t i = 0, c = 0;
    while (i < n && c < chars) { i++; while (i < n && ((unsigned char)s[i] & 0xC0) == 0x80) i++; c++; }
    return i;
}
static size_t suffix_start(const char *s, size_t n, size_t chars) {   /* byte offset of the last CHARS code points */
    size_t i = n, c = 0;
    while (i > 0 && c < chars) { i--; while (i > 0 && ((unsigned char)s[i] & 0xC0) == 0x80) i--; c++; }
    return i;
}

/* ---------- json.loads, enough of it: values, objects with last-wins duplicate keys, Python truthiness ---------- */
enum { J_NULL, J_FALSE, J_TRUE, J_NUM, J_STR, J_ARR, J_OBJ };
typedef struct J { int t, zero; char *s; size_t sn; int n, cap; char **ks; size_t *kn; struct J **v; } J;
static const char *jp, *je;
static void jfail(void) { die("%s", "models.json is not valid JSON"); }
static void jws(void) { while (jp < je && (*jp == ' ' || *jp == '\t' || *jp == '\n' || *jp == '\r')) jp++; }
static J *jnew(int t) { J *j = calloc(1, sizeof *j); if (!j) die("%s", "out of memory"); j->t = t; return j; }
static int hexv(int c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1; }
static int hex4(const char *p) {
    int i, v = 0, h;
    if (je - p < 4) jfail();
    for (i = 0; i < 4; i++) { if ((h = hexv((unsigned char)p[i])) < 0) jfail(); v = v * 16 + h; }
    return v;
}
static void put_cp(char *o, size_t *k, unsigned cp) {        /* lone surrogates kept as their 3-byte spelling */
    if (cp < 0x80) o[(*k)++] = (char)cp;
    else if (cp < 0x800) { o[(*k)++] = (char)(0xC0 | cp >> 6); o[(*k)++] = (char)(0x80 | (cp & 0x3F)); }
    else if (cp < 0x10000) { o[(*k)++] = (char)(0xE0 | cp >> 12); o[(*k)++] = (char)(0x80 | ((cp >> 6) & 0x3F)); o[(*k)++] = (char)(0x80 | (cp & 0x3F)); }
    else { o[(*k)++] = (char)(0xF0 | cp >> 18); o[(*k)++] = (char)(0x80 | ((cp >> 12) & 0x3F)); o[(*k)++] = (char)(0x80 | ((cp >> 6) & 0x3F)); o[(*k)++] = (char)(0x80 | (cp & 0x3F)); }
}
static char *jstr(size_t *len) {                  /* jp at the opening quote */
    const char *p = jp + 1, *q = p; size_t k = 0; char *o;
    while (q < je && *q != '"') { if (*q == '\\') q++; q++; }
    if (q >= je) jfail();
    o = malloc(q - p + 1); if (!o) die("%s", "out of memory");
    while (p < je && *p != '"') {
        unsigned char c = (unsigned char)*p;
        if (c < 0x20) jfail();                    /* strict: no raw control characters */
        if (c != '\\') { o[k++] = (char)c; p++; continue; }
        if (++p >= je) jfail();
        switch (*p) {
        case '"': o[k++] = '"'; p++; break;   case '\\': o[k++] = '\\'; p++; break;
        case '/': o[k++] = '/'; p++; break;   case 'b': o[k++] = '\b'; p++; break;
        case 'f': o[k++] = '\f'; p++; break;  case 'n': o[k++] = '\n'; p++; break;
        case 'r': o[k++] = '\r'; p++; break;  case 't': o[k++] = '\t'; p++; break;
        case 'u': {
            unsigned cp = (unsigned)hex4(p + 1); p += 5;
            if (cp >= 0xD800 && cp <= 0xDBFF && je - p >= 6 && p[0] == '\\' && p[1] == 'u') {
                unsigned lo = (unsigned)hex4(p + 2);
                if (lo >= 0xDC00 && lo <= 0xDFFF) { cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00); p += 6; }
            }
            put_cp(o, &k, cp); break;
        }
        default: jfail();
        }
    }
    if (p >= je) jfail();
    jp = p + 1; o[k] = 0; *len = k; return o;
}
static J *jval(int depth);
static void obj_put(J *o, char *k, size_t kn, J *v) {
    int i;
    for (i = 0; i < o->n; i++) if (o->kn[i] == kn && !memcmp(o->ks[i], k, kn)) { o->v[i] = v; free(k); return; }
    if (o->n == o->cap) {
        o->cap = o->cap ? o->cap * 2 : 16;
        o->ks = realloc(o->ks, o->cap * sizeof *o->ks); o->kn = realloc(o->kn, o->cap * sizeof *o->kn); o->v = realloc(o->v, o->cap * sizeof *o->v);
        if (!o->ks || !o->kn || !o->v) die("%s", "out of memory");
    }
    o->ks[o->n] = k; o->kn[o->n] = kn; o->v[o->n] = v; o->n++;
}
static J *jnum(void) {
    const char *s = jp, *p = jp; int frac = 0; size_t digits; char *buf; J *j;
    if (p < je && *p == '-') p++;
    if (je - p >= 8 && !memcmp(p, "Infinity", 8) && (p > s)) { jp = p + 8; j = jnew(J_NUM); return j; }
    if (p >= je || *p < '0' || *p > '9') jfail();
    if (*p == '0') p++; else while (p < je && *p >= '0' && *p <= '9') p++;
    digits = (size_t)(p - s) - (*s == '-');
    if (p < je && *p == '.' && p + 1 < je && p[1] >= '0' && p[1] <= '9') { frac = 1; p++; while (p < je && *p >= '0' && *p <= '9') p++; }
    if (p < je && (*p == 'e' || *p == 'E')) {
        const char *q = p + 1;
        if (q < je && (*q == '+' || *q == '-')) q++;
        if (q < je && *q >= '0' && *q <= '9') { frac = 1; p = q; while (p < je && *p >= '0' && *p <= '9') p++; }
    }
    if (!frac && digits > 4300) die("%s", "models.json: integer literal too long");   /* int max str digits */
    buf = malloc(p - s + 1); memcpy(buf, s, p - s); buf[p - s] = 0;
    j = jnew(J_NUM); j->zero = strtod(buf, 0) == 0.0; free(buf);
    jp = p; return j;
}
static J *jval(int depth) {
    J *j;
    if (depth > 900) die("%s", "models.json nests too deeply");
    jws();
    if (jp >= je) jfail();
    switch (*jp) {
    case '{': {
        j = jnew(J_OBJ); jp++; jws();
        if (jp < je && *jp == '}') { jp++; return j; }
        for (;;) {
            char *k; size_t kn; J *v;
            jws(); if (jp >= je || *jp != '"') jfail();
            k = jstr(&kn); jws();
            if (jp >= je || *jp != ':') jfail();
            jp++; v = jval(depth + 1); obj_put(j, k, kn, v); jws();
            if (jp < je && *jp == ',') { jp++; continue; }
            if (jp < je && *jp == '}') { jp++; return j; }
            jfail();
        }
    }
    case '[': {
        j = jnew(J_ARR); jp++; jws();
        if (jp < je && *jp == ']') { jp++; return j; }
        for (;;) {
            jval(depth + 1); j->n++; jws();
            if (jp < je && *jp == ',') { jp++; continue; }
            if (jp < je && *jp == ']') { jp++; return j; }
            jfail();
        }
    }
    case '"': j = jnew(J_STR); j->s = jstr(&j->sn); return j;
    case 'n': if (je - jp >= 4 && !memcmp(jp, "null", 4)) { jp += 4; return jnew(J_NULL); } jfail();
    case 't': if (je - jp >= 4 && !memcmp(jp, "true", 4)) { jp += 4; return jnew(J_TRUE); } jfail();
    case 'f': if (je - jp >= 5 && !memcmp(jp, "false", 5)) { jp += 5; return jnew(J_FALSE); } jfail();
    case 'N': if (je - jp >= 3 && !memcmp(jp, "NaN", 3)) { jp += 3; return jnew(J_NUM); } jfail();
    case 'I': if (je - jp >= 8 && !memcmp(jp, "Infinity", 8)) { jp += 8; return jnew(J_NUM); } jfail();
    default: return jnum();
    }
    return 0;
}
static int truthy(const J *j) {
    switch (j->t) {
    case J_NULL: case J_FALSE: return 0;
    case J_NUM: return !j->zero;
    case J_STR: return j->sn > 0;
    default: return j->n > 0;
    }
}
static J *jget(const J *o, const char *key) {      /* rec[key]: a dict, and the key present */
    int i; size_t kl = strlen(key);
    if (o->t != J_OBJ) die("%s", "models.json: a record is not an object");
    for (i = 0; i < o->n; i++) if (o->kn[i] == kl && !memcmp(o->ks[i], key, kl)) return o->v[i];
    die("models.json: a record has no %s", key); return 0;
}

/* ---------- files and processes ---------- */
static void sha_file(const char *path, char hex[65]) {   /* pathlib read_bytes: a directory or a missing file is an error */
    int fd = open(path, O_RDONLY); struct stat s; char *b = 0; size_t n = 0, cap = 0; ssize_t r;
    if (fd < 0 || fstat(fd, &s) != 0 || S_ISDIR(s.st_mode)) die("cannot read %s", path);
    for (;;) {
        if (cap - n < 65536) { cap = cap ? cap * 2 : 1 << 20; b = realloc(b, cap); if (!b) die("%s", "out of memory"); }
        r = read(fd, b + n, cap - n);
        if (r < 0) { if (errno == EINTR) continue; die("cannot read %s", path); }
        if (r == 0) break;
        n += (size_t)r;
    }
    close(fd); cx_sha256_hex(b, n, hex); free(b);
}
static int status_rc(int st) { return WIFEXITED(st) ? WEXITSTATUS(st) : 128 + WTERMSIG(st); }
/* the child inherits stdout and stderr (subprocess.run without capture) */
static int run_inherit(char *const argv[]) {
    pid_t pid; int st;
    fflush(NULL);
    pid = fork();
    if (pid < 0) die("%s", "fork failed");
    if (pid == 0) { execv(argv[0], argv); fprintf(stderr, "auditnet: cannot execute %s\n", argv[0]); _exit(127); }
    while (waitpid(pid, &st, 0) < 0) if (errno != EINTR) die("%s", "wait failed");
    return status_rc(st);
}
/* capture_output=True: stdout taken and dropped, stderr returned */
static int run_capture_err(char *const argv[], char **err, size_t *errn) {
    pid_t pid; int st, pfd[2]; char *b = 0; size_t n = 0, cap = 0; ssize_t r;
    fflush(NULL);
    if (pipe(pfd) != 0) die("%s", "pipe failed");
    pid = fork();
    if (pid < 0) die("%s", "fork failed");
    if (pid == 0) {
        int nul = open("/dev/null", O_WRONLY);
        close(pfd[0]);
        if (nul < 0 || dup2(nul, 1) < 0 || dup2(pfd[1], 2) < 0) _exit(126);
        close(nul); close(pfd[1]);
        execv(argv[0], argv); _exit(127);
    }
    close(pfd[1]);
    for (;;) {
        if (cap - n < 4096) { cap = cap ? cap * 2 : 65536; b = realloc(b, cap); if (!b) die("%s", "out of memory"); }
        r = read(pfd[0], b + n, cap - n);
        if (r < 0) { if (errno == EINTR) continue; break; }
        if (r == 0) break;
        n += (size_t)r;
    }
    close(pfd[0]);
    while (waitpid(pid, &st, 0) < 0) if (errno != EINTR) die("%s", "wait failed");
    *err = b; *errn = n; return status_rc(st);
}
static char *make_tmpdir(void) {                  /* tempfile.gettempdir order, then mkdtemp with the gate's prefix */
    const char *cand[7]; char cwd[PATH_MAX]; int i, k = 0;
    cand[k++] = getenv("TMPDIR"); cand[k++] = getenv("TEMP"); cand[k++] = getenv("TMP");
    cand[k++] = "/tmp"; cand[k++] = "/var/tmp"; cand[k++] = "/usr/tmp";
    cand[k++] = getcwd(cwd, sizeof cwd) ? cwd : ".";
    for (i = 0; i < k; i++) {
        char *t; size_t l;
        if (!cand[i] || !*cand[i]) continue;
        l = strlen(cand[i]) + 32; t = malloc(l);
        snprintf(t, l, "%s/unisacc-auditnet-XXXXXX", cand[i]);
        if (mkdtemp(t)) return t;
        free(t);
    }
    die("%s", "no usable temporary directory"); return 0;
}
static char **SK; static size_t *SKN;
static int idxcmp(const void *a, const void *b) {
    int i = *(const int *)a, j = *(const int *)b; size_t m = SKN[i] < SKN[j] ? SKN[i] : SKN[j];
    int c = memcmp(SK[i], SK[j], m);
    return c ? c : SKN[i] < SKN[j] ? -1 : SKN[i] > SKN[j];
}

int main(int argc, char **argv) {
    const char *mc = getenv("MODEL_COM"), *ad; char *product, *audit, *mj, *buf, root[PATH_MAX], *rp;
    char *bound, *runc, *run, *cc; size_t n; J *top, *pairs = 0; int i, bad = 0, *order;
    (void)argc; (void)argv;
    if (!mc || !*mc) { fputs("auditnet: MODEL_COM required\n", stderr); return 1; }
    product = pnorm(mc);
    ad = getenv("AUDIT_DIR");
    audit = ad ? pnorm(ad) : pjoin(pparent(product), "model-audit", 11, "");
    mj = pjoin(audit, "models.json", 11, "");
    buf = cx_read(mj, &n);
    { struct stat s; if (!buf || stat(mj, &s) != 0 || S_ISDIR(s.st_mode)) die("cannot read %s", mj); }
    if (!utf8_ok((const unsigned char *)buf, n)) die("%s is not UTF-8", mj);
    jp = buf; je = buf + n;
    top = jval(0); jws(); if (jp != je) jfail();
    if (top->t == J_OBJ) { for (i = 0; i < top->n; i++) if (top->kn[i] == 5 && !memcmp(top->ks[i], "pairs", 5)) pairs = top->v[i]; }
    else die("%s", "models.json: the top level is not an object");
    if (!pairs) die("%s", "models.json has no pairs");
    if (!truthy(pairs)) { fputs("auditnet: empty audit\n", stderr); return 1; }

    /* ROOT = the repository holding this file (Path(__file__).resolve().parents[1]) */
    if (!(rp = realpath(__FILE__, root))) die("cannot resolve %s", __FILE__);
    { char *s = strrchr(root, '/'); if (s) *s = 0; s = strrchr(root, '/'); if (s && s != root) *s = 0; else if (s) s[1] = 0; }
    bound = pjoin(root, "tests/bound", 11, ""); runc = pjoin(root, "exec/c/run.c", 12, "");

    tmpdir_path = make_tmpdir(); atexit(cleanup);
    run = pjoin(tmpdir_path, "run", 3, "");
    cc = getenv("EXEC_CC"); if (!cc) cc = "cc";
    {
        char *av[] = { bound, "50", cc, "-O2", "-o", run, runc, 0 }; int rc = run_inherit(av);
        if (rc) { fflush(stdout); fprintf(stderr, "auditnet: building %s exited %d\n", runc, rc); exit(1); }
    }
    if (pairs->t != J_OBJ) die("%s", "models.json: pairs is not an object");
    order = malloc((pairs->n ? pairs->n : 1) * sizeof *order);
    for (i = 0; i < pairs->n; i++) order[i] = i;
    SK = pairs->ks; SKN = pairs->kn; qsort(order, pairs->n, sizeof *order, idxcmp);
    for (i = 0; i < pairs->n; i++) {
        int k = order[i]; const char *key = pairs->ks[k]; size_t kn = pairs->kn[k], k16 = prefix_chars(key, kn, 16);
        J *rec = pairs->v[k], *want; char *net, *tbl, hex[65]; int ok;
        if (memchr(key, 0, kn)) die("%s", "models.json: a key holds NUL");
        net = pjoin(audit, key, kn, ".net"); tbl = pjoin(audit, key, kn, ".tbl");
        sha_file(net, hex); want = jget(rec, "network_sha256");
        ok = want->t == J_STR && want->sn == 64 && !memcmp(want->s, hex, 64);
        if (ok) { sha_file(tbl, hex); want = jget(rec, "table_sha256"); ok = want->t == J_STR && want->sn == 64 && !memcmp(want->s, hex, 64); }
        if (!ok) {
            fputs("auditnet FAIL hash ", stdout); fwrite(key, 1, k16, stdout); fputc('\n', stdout); bad++; free(net); free(tbl); continue;
        }
        {
            char *av[] = { bound, "30", run, "--check-net", tbl, net, 0 }; char *err = 0; size_t en = 0;
            int rc = run_capture_err(av, &err, &en);
            if (rc) {
                size_t from;
                if (!utf8_ok((const unsigned char *)(err ? err : ""), en)) die("%s", "check-net stderr is not UTF-8");
                from = suffix_start(err ? err : "", en, 200);
                fputs("auditnet FAIL check-net ", stdout); fwrite(key, 1, k16, stdout); fputc(' ', stdout);
                fwrite(err + from, 1, en - from, stdout); fputc('\n', stdout); bad++;
            }
            free(err);
        }
        free(net); free(tbl);
    }
    printf("auditnet  networks %d   checked %d   failed %d   (%s)\n", pairs->n, pairs->n - bad, bad, audit);
    return bad ? 1 : 0;
}
