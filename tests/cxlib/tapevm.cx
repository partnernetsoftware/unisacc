/* tapevm.cx -- unisa/tape.py parse() and unisa/vm.py VM.run_reference() (with unisa/fp.py) as a .cx module
   (2026-10-23, the py->cx port wave; first user tests/volatilecomma.cx).  Use it with `#pragma unisa use
   cxlib.tapevm` from a .cx file in tests/.
     tv_parse(CP, N, why, whylen)     parse(str) over N code points: the tape, or 0 with WHY set to the exception's
                                      last line (`ValueError: line 3: invalid integer literal`, `AssertionError: line
                                      2: unknown op 'foo'`, ...) exactly as tape.py raises it
     tv_parse_latin1(B, N, ...)       parse(bytes.decode('latin1'))
     tv_parse_utf8(B, N, ...)         parse(bytes.decode('utf-8')) (strict: a UnicodeDecodeError line on bad input)
     tv_sym(T, NAME, &addr), tv_label(T, NAME, &pc)   tape.syms[NAME], tape.labels[NAME]: 1 when present
     tv_vm_init(VM, T, MAXSTEPS, ARGV, ARGC, why, whylen)   VM(tape, max_steps, argv): 16 MB memory, data at
                                      DATA_BASE, argv then the environment (os.environ order, latin-1 'replace')
     tv_vm_run(VM, &code, why, whylen)   run(): 0 with CODE the halt code (VM->out/outn the output bytes,
                                      VM->steps the steps), or -1 with WHY the exception's last line (KeyError for
                                      an unknown label, `AssertionError: vm: unhandled '.hostcall'`, ...).  A fault
                                      (halt 139) prints the vm.py `vm fault: ...` line on stderr, as vm.py does.
     tv_insn_repr(T, PC, out, outlen) repr of code[PC] (Insn.__repr__)
   VM->on_ld(VM->ctx, ADDR, WIDTH) is called before every memory read the VM makes through VM.ld (load64, .ld,
   callm, ret) -- the hook a TraceVM subclass overrides.  Every halt, step count, register and memory effect follows
   run_reference.  Not covered (refused with a `tapevm: ... not covered` line, never answered differently): a store
   or read(2) that would grow vm.py's bytearray past the 16 MB machine, and data, argv or environment that would not
   fit below it.  Floating point follows fp.py (sqrt correctly rounded in integer arithmetic, no libm).
   No exported objects or macros (CXIF v0). */
#pragma unisa module tapevm

typedef struct tv_arg { int kind; int reg; unsigned long long u; int neg; char *s; } tv_arg;   /* kind: 'r' 'i' 'L' 's' */
typedef struct tv_insn { int op; int n; tv_arg a[7]; } tv_insn;
typedef struct tv_seg { size_t off, len; unsigned char *p; } tv_seg;
typedef struct tv_ent { char *k; unsigned long long v; } tv_ent;
typedef struct tv_map { tv_ent *e; size_t n, cap; } tv_map;
typedef struct tv_tape {
    tv_insn *code; size_t ncode, capcode;
    tv_map labels, syms;
    tv_seg *segs; size_t nseg, capseg;
    size_t ndata;
    size_t nrecords; int first_unit;
} tv_tape;
typedef struct tv_vm {
    tv_tape *t; unsigned char *mem;
    unsigned long long r[8], brk, pc_now;
    unsigned long long *argv; size_t nargv, nargs;
    unsigned char *out; size_t outn, outcap;
    long long steps, max_steps;
    void (*on_ld)(void *ctx, unsigned long long addr, long long width);
    void *ctx;
} tv_vm;

/* ---- op table (tape.SHAPE, fp.OPS3/OPS2 appended) ------------------------------------------------------------ */
static const char *const TV_OPS[][2] = {
    {"imm", "ri"}, {"mov", "rr"}, {"add64", "rrr"}, {"sub64", "rrr"}, {"mul64", "rrr"}, {"xor64", "rrr"},
    {"and64", "rrr"}, {"or64", "rrr"}, {"shl64", "rrr"}, {"shr64", "rrr"}, {"lshr64", "rrr"}, {".div", "rrr"},
    {".mod", "rrr"}, {".udiv", "rrr"}, {".umod", "rrr"}, {"slt64", "rrr"}, {"sle64", "rrr"}, {"ult64", "rrr"},
    {"ule64", "rrr"}, {"eq", "rrr"}, {"ne", "rrr"}, {"load64", "rri"}, {"store64", "rir"}, {".ld", "rrii"},
    {".st", "riri"}, {".lea", "rs"}, {".zero", "rii"}, {"jump", "L"}, {"jumpz", "rL"}, {"call", "L"},
    {"callr", "r"}, {"callm", "ri"}, {".hostcall", "rr"}, {".librarycall", "rr"}, {".libraryaddr", "rsiiii"},
    {".libraryfn", "ri"}, {".hostaddr", "ri"}, {"ret", ""}, {".frame", "i"}, {".arg", "ir"}, {".print", "r"},
    {".write", "rr"}, {".exit", "r"}, {".sys", "srrr"}, {".sys6", "srrrrrr"}, {".argc", "r"}, {".argv", "rr"},
    {"nop", ""},
    {"fadd64", "rrr"}, {"fsub64", "rrr"}, {"fmul64", "rrr"}, {"fdiv64", "rrr"}, {"flt64", "rrr"}, {"fle64", "rrr"},
    {"feq64", "rrr"}, {"fadd32", "rrr"}, {"fsub32", "rrr"}, {"fmul32", "rrr"}, {"fdiv32", "rrr"}, {"flt32", "rrr"},
    {"fle32", "rrr"}, {"feq32", "rrr"},
    {"cvtid", "rr"}, {"cvtud", "rr"}, {"cvtis", "rr"}, {"cvtus", "rr"}, {"cvtdi", "rr"}, {"cvtdu", "rr"},
    {"cvtsd", "rr"}, {"cvtds", "rr"}, {"fsqrt64", "rr"}, {"fsqrt32", "rr"},
};
enum {
    O_IMM, O_MOV, O_ADD, O_SUB, O_MUL, O_XOR, O_AND, O_OR, O_SHL, O_SHR, O_LSHR, O_DIV, O_MOD, O_UDIV, O_UMOD,
    O_SLT, O_SLE, O_ULT, O_ULE, O_EQ, O_NE, O_LOAD64, O_STORE64, O_LD, O_ST, O_LEA, O_ZERO, O_JUMP, O_JUMPZ, O_CALL,
    O_CALLR, O_CALLM, O_HOSTCALL, O_LIBRARYCALL, O_LIBRARYADDR, O_LIBRARYFN, O_HOSTADDR, O_RET, O_FRAME, O_ARG,
    O_PRINT, O_WRITE, O_EXIT, O_SYS, O_SYS6, O_ARGC, O_ARGV, O_NOP, O_FP3, O_FP2 = O_FP3 + 14, O_NOPS = O_FP2 + 10
};
static int tv_opindex(const char *s) { int i; for (i = 0; i < O_NOPS; i++) if (!strcmp(TV_OPS[i][0], s)) return i; return -1; }

#define TV_MEM 0x1000000ull
#define TV_DATA_BASE 0x100ull
#define TV_MASK 0xFFFFFFFFFFFFFFFFull

/* ---- small utilities ----------------------------------------------------------------------------------------- */
static void *tv_alloc(size_t n) { void *p = calloc(1, n ? n : 1); if (!p) { fputs("MemoryError\n", stderr); exit(1); } return p; }
static void *tv_grow(void *p, size_t *cap, size_t need, size_t elem) {
    if (need > *cap) {
        size_t c = *cap ? *cap : 16; void *g;
        while (c < need) c *= 2;
        g = realloc(p, c * elem); if (!g) { fputs("MemoryError\n", stderr); exit(1); }
        p = g; *cap = c;
    }
    return p;
}
static unsigned long tv_hash(const char *s) { unsigned long h = 5381; while (*s) h = h * 33 + (unsigned char)*s++; return h; }
static tv_ent *tv_find(tv_map *m, const char *k) {
    size_t i;
    if (!m->cap) return 0;
    for (i = tv_hash(k) & (m->cap - 1); m->e[i].k; i = (i + 1) & (m->cap - 1)) if (!strcmp(m->e[i].k, k)) return &m->e[i];
    return 0;
}
static void tv_put(tv_map *m, const char *k, unsigned long long v) {   /* dict[k] = v */
    tv_ent *e = tv_find(m, k); size_t i;
    if (e) { e->v = v; return; }
    if (2 * (m->n + 1) > m->cap) {
        tv_map g; size_t j;
        g.cap = m->cap ? 2 * m->cap : 64; g.n = 0; g.e = tv_alloc(g.cap * sizeof *g.e);
        for (j = 0; j < m->cap; j++) if (m->e[j].k) {
            for (i = tv_hash(m->e[j].k) & (g.cap - 1); g.e[i].k; i = (i + 1) & (g.cap - 1)) ;
            g.e[i] = m->e[j]; g.n++;
        }
        free(m->e); *m = g;
    }
    for (i = tv_hash(k) & (m->cap - 1); m->e[i].k; i = (i + 1) & (m->cap - 1)) ;
    m->e[i].k = tv_alloc(strlen(k) + 1); strcpy(m->e[i].k, k); m->e[i].v = v; m->n++;
}
int tv_sym(tv_tape *t, const char *name, unsigned long long *v) { tv_ent *e = tv_find(&t->syms, name); if (e && v) *v = e->v; return e != 0; }
int tv_label(tv_tape *t, const char *name, unsigned long long *v) { tv_ent *e = tv_find(&t->labels, name); if (e && v) *v = e->v; return e != 0; }

/* code points <-> UTF-8 */
static size_t tv_enc(unsigned c, char *o) {
    if (c < 0x80) { o[0] = (char)c; return 1; }
    if (c < 0x800) { o[0] = (char)(0xC0 | (c >> 6)); o[1] = (char)(0x80 | (c & 0x3F)); return 2; }
    if (c < 0x10000) { o[0] = (char)(0xE0 | (c >> 12)); o[1] = (char)(0x80 | ((c >> 6) & 0x3F)); o[2] = (char)(0x80 | (c & 0x3F)); return 3; }
    o[0] = (char)(0xF0 | (c >> 18)); o[1] = (char)(0x80 | ((c >> 12) & 0x3F)); o[2] = (char)(0x80 | ((c >> 6) & 0x3F)); o[3] = (char)(0x80 | (c & 0x3F)); return 4;
}
static char *tv_utf8(const unsigned *s, size_t n) {
    char *o = tv_alloc(4 * n + 1); size_t i, j = 0;
    for (i = 0; i < n; i++) j += tv_enc(s[i], o + j);
    o[j] = 0; return o;
}
static int tv_printable(unsigned c) {   /* str.isprintable, close enough for tape text */
    if (c < 0x20 || (c >= 0x7F && c <= 0xA0) || c == 0xAD) return 0;
    if (c == 0x1680 || (c >= 0x2000 && c <= 0x200F) || (c >= 0x2028 && c <= 0x202F) || (c >= 0x205F && c <= 0x206F)) return 0;
    if (c == 0x3000 || c == 0xFEFF || (c >= 0xD800 && c <= 0xF8FF) || c == 0xFFFE || c == 0xFFFF || c >= 0xF0000) return 0;
    return 1;
}
static void tv_repr(const unsigned *s, size_t n, char *o, size_t olen) {   /* repr(str) */
    size_t i, j = 0; int sq = 0, dq = 0; char q, t[16]; size_t k;
    for (i = 0; i < n; i++) { if (s[i] == '\'') sq = 1; if (s[i] == '"') dq = 1; }
    q = sq && !dq ? '"' : '\'';
#define TV_P(p, m) do { size_t m_ = (m); if (j + m_ < olen) { memcpy(o + j, (p), m_); j += m_; } } while (0)
    TV_P(&q, 1);
    for (i = 0; i < n; i++) {
        unsigned c = s[i];
        if (c == (unsigned char)q || c == '\\') { t[0] = '\\'; t[1] = (char)c; TV_P(t, 2); }
        else if (c == '\n') TV_P("\\n", 2);
        else if (c == '\r') TV_P("\\r", 2);
        else if (c == '\t') TV_P("\\t", 2);
        else if (tv_printable(c)) { k = tv_enc(c, t); TV_P(t, k); }
        else {
            if (c < 0x100) snprintf(t, sizeof t, "\\x%02x", c);
            else if (c < 0x10000) snprintf(t, sizeof t, "\\u%04x", c);
            else snprintf(t, sizeof t, "\\U%08x", c);
            TV_P(t, strlen(t));
        }
    }
    TV_P(&q, 1);
#undef TV_P
    o[j] = 0;
}
static int tv_space(unsigned c) {   /* str.isspace */
    return (c >= 9 && c <= 13) || (c >= 0x1C && c <= 0x20) || c == 0x85 || c == 0xA0 || c == 0x1680
        || (c >= 0x2000 && c <= 0x200A) || c == 0x2028 || c == 0x2029 || c == 0x202F || c == 0x205F || c == 0x3000;
}
static int tv_linebreak(unsigned c) {   /* str.splitlines boundaries (\r\n handled by the caller) */
    return c == '\n' || c == '\r' || c == 0x0B || c == 0x0C || c == 0x1C || c == 0x1D || c == 0x1E || c == 0x85 || c == 0x2028 || c == 0x2029;
}

/* a token: a slice of code points */
typedef struct tv_tok { const unsigned *p; size_t n; } tv_tok;
static int tv_split(const unsigned *s, size_t n, tv_tok *out, int max) {   /* str.split() */
    size_t i = 0; int k = 0;
    while (i < n) {
        size_t b;
        while (i < n && tv_space(s[i])) i++;
        if (i >= n) break;
        b = i;
        while (i < n && !tv_space(s[i])) i++;
        if (k < max) { out[k].p = s + b; out[k].n = i - b; }
        k++;
    }
    return k;
}
static int tv_teq(tv_tok t, const char *s) { size_t i; for (i = 0; i < t.n; i++) if (!s[i] || t.p[i] != (unsigned char)s[i]) return 0; return s[t.n] == 0; }

/* _tape_integer: value as (u mod 2^64, neg); 0, or -1 with WHY */
static int tv_integer(tv_tok tok, int line, int decimal, unsigned long long *u, int *neg, char *why, size_t wl) {
    const unsigned *p = tok.p; size_t n = tok.n, i; unsigned base = 10; int negative; unsigned long long limit, value = 0;
    for (i = 0; i < n; i++) if (p[i] == '_') { snprintf(why, wl, "ValueError: line %d: invalid integer literal", line); return -1; }
    negative = n && p[0] == '-';
    if (n && (p[0] == '+' || p[0] == '-')) { p++; n--; }
    if (!decimal && n >= 2 && p[0] == '0') {
        unsigned c = p[1] | 0x20;
        if (p[1] < 0x80 && (c == 'x' || c == 'o' || c == 'b')) { base = c == 'x' ? 16 : c == 'o' ? 8 : 2; p += 2; n -= 2; }
    }
    if (!n) { snprintf(why, wl, "ValueError: line %d: invalid integer literal", line); return -1; }
    for (i = 0; i < n; i++) {
        unsigned c = p[i], d;
        if (c >= '0' && c <= '9') d = c - '0';
        else if (c >= 'a' && c <= 'f') d = c - 'a' + 10;
        else if (c >= 'A' && c <= 'F') d = c - 'A' + 10;
        else d = 99;
        if (d >= base) { snprintf(why, wl, "ValueError: line %d: invalid integer literal", line); return -1; }
    }
    if (!decimal && base == 10 && n > 1 && p[0] == '0') {
        for (i = 1; i < n; i++) if (p[i] != '0') { snprintf(why, wl, "ValueError: line %d: invalid integer literal", line); return -1; }
    }
    limit = negative ? 0x8000000000000000ull : TV_MASK;
    for (i = 0; i < n; i++) {
        unsigned c = p[i] | 0x20, d = c <= '9' ? p[i] - '0' : c - 'a' + 10;
        if (value > (limit - d) / base) { snprintf(why, wl, "ValueError: line %d: integer literal out of 64-bit word range", line); return -1; }
        value = value * base + d;
    }
    *neg = negative && value != 0;
    *u = negative ? (0 - value) : value;
    return 0;
}

/* ---- the data area -------------------------------------------------------------------------------------------- */
static void tv_data_bytes(tv_tape *t, const unsigned char *b, size_t n) {
    tv_seg *s;
    if (!n) return;
    t->segs = tv_grow(t->segs, &t->capseg, t->nseg + 1, sizeof *t->segs);
    s = &t->segs[t->nseg++]; s->off = t->ndata; s->len = n; s->p = tv_alloc(n); memcpy(s->p, b, n);
    t->ndata += n;
}
static void tv_string(tv_tape *t, const char *name, const unsigned char *raw, size_t n, int zero, size_t align) {
    if (tv_find(&t->syms, name)) return;
    if (align > 1) t->ndata += (align - t->ndata % align) % align;
    tv_put(&t->syms, name, TV_DATA_BASE + t->ndata);
    if (zero) t->ndata += n; else tv_data_bytes(t, raw, n);
}

/* ---- parse ---------------------------------------------------------------------------------------------------- */
static int tv_fail(char *why, size_t wl, const char *cls, int line, const char *msg) {
    if (line) snprintf(why, wl, "%s: line %d: %s", cls, line, msg); else snprintf(why, wl, "%s: %s", cls, msg);
    return -1;
}
static int tv_unpack(char *why, size_t wl, int got) {
    if (got < 2) snprintf(why, wl, "ValueError: not enough values to unpack (expected 2, got %d)", got);
    else snprintf(why, wl, "ValueError: too many values to unpack (expected 2, got %d)", got);
    return -1;
}
static int tv_unescape(const unsigned *s, size_t n, unsigned char **out, size_t *outn, char *why, size_t wl) {
    unsigned char *o = tv_alloc(n + 1); size_t i = 0, j = 0;
    while (i < n) {
        unsigned c = s[i];
        if (j >= 1048576) { free(o); snprintf(why, wl, "ValueError: tape: .str exceeds tape reader capacity"); return -1; }
        if (c == '\\' && i + 1 < n) {
            unsigned e = s[i + 1];
            if (e == 'x') {
                int k, ok = i + 3 < n;
                for (k = 2; ok && k < 4; k++) { unsigned h = s[i + k]; ok = (h >= '0' && h <= '9') || (h >= 'a' && h <= 'f') || (h >= 'A' && h <= 'F'); }
                if (!ok) { free(o); snprintf(why, wl, "ValueError: tape: malformed hex escape"); return -1; }
                { unsigned h1 = s[i + 2] | 0x20, h2 = s[i + 3] | 0x20;
                  o[j++] = (unsigned char)(((h1 <= '9' ? s[i + 2] - '0' : h1 - 'a' + 10) << 4) | (h2 <= '9' ? s[i + 3] - '0' : h2 - 'a' + 10)); }
                i += 4; continue;
            }
            switch (e) { case 'n': c = '\n'; break; case 't': c = '\t'; break; case 'r': c = '\r'; break; case '0': c = 0; break; default: c = e; }
            if (c > 0xFF) {
                char r[32]; unsigned one = c; tv_repr(&one, 1, r, sizeof r); free(o);
                snprintf(why, wl, "UnicodeEncodeError: 'latin-1' codec can't encode character %s in position 0: ordinal not in range(256)", r);
                return -1;
            }
            o[j++] = (unsigned char)c; i += 2; continue;
        }
        if (c == '\\') { free(o); snprintf(why, wl, "ValueError: tape: trailing string escape"); return -1; }
        if (c == '"') { free(o); snprintf(why, wl, "ValueError: tape: unescaped quote in .str"); return -1; }
        if (c > 0xFF) {
            char r[32]; tv_repr(&c, 1, r, sizeof r); free(o);
            snprintf(why, wl, "UnicodeEncodeError: 'latin-1' codec can't encode character %s in position 0: ordinal not in range(256)", r);
            return -1;
        }
        o[j++] = (unsigned char)c; i++;
    }
    *out = o; *outn = j;
    return 0;
}
static int tv_ident(tv_tok t) {   /* [A-Za-z_][A-Za-z_0-9.$]* */
    size_t i;
    if (!t.n) return 0;
    for (i = 0; i < t.n; i++) {
        unsigned c = t.p[i];
        int a = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_';
        if (!(a || (i && ((c >= '0' && c <= '9') || c == '.' || c == '$')))) return 0;
    }
    return 1;
}
static int tv_startswith(const unsigned *s, size_t n, const char *p) { size_t i; for (i = 0; p[i]; i++) if (i >= n || s[i] != (unsigned char)p[i]) return 0; return 1; }

static int tv_line(tv_tape *t, const unsigned *raw, size_t rn, int lineno, char *why, size_t wl) {
    const unsigned *s; size_t n, i; tv_tok tk[16]; int k, q = 0;
    /* _strip_comment */
    for (i = 0; i < rn; i++) {
        if (q) { if (raw[i] == '\\') { i++; continue; } if (raw[i] == '"') q = 0; }
        else if (raw[i] == '"') q = 1;
        else if (raw[i] == ';') { rn = i; break; }
    }
    s = raw; n = rn;
    while (n && tv_space(s[0])) { s++; n--; }
    while (n && tv_space(s[n - 1])) n--;
    if (!n) return 0;
    if (tv_startswith(s, n, ".bss ")) {
        unsigned long long u; int neg; char *name;
        k = tv_split(s + 5, n - 5, tk, 16);
        if (k != 2) return tv_unpack(why, wl, k);
        if (tv_integer(tk[1], lineno, 1, &u, &neg, why, wl)) return -1;
        if (neg) return tv_fail(why, wl, "ValueError", lineno, "invalid .bss size");
        if (u > 0x10000000000ull) { snprintf(why, wl, "tapevm: line %d: .bss of %llu bytes not covered", lineno, u); return -1; }
        name = tv_utf8(tk[0].p, tk[0].n);
        tv_string(t, name, 0, (size_t)u, 1, 8);
        free(name); t->nrecords++;
        return 0;
    }
    k = tv_split(s, n, tk, 16);
    if (tv_teq(tk[0], ".unit")) {
        if (k != 2 || !tv_teq(tk[1], "2") || t->nrecords) return tv_fail(why, wl, "ValueError", lineno, "malformed unit version record");
        t->nrecords++; t->first_unit = 1;
        return 0;
    }
    if (tv_teq(tk[0], ".global") || tv_teq(tk[0], ".extern") || tv_teq(tk[0], ".gdef")) {
        if (k != 2 || !tv_ident(tk[1])) return tv_fail(why, wl, "ValueError", lineno, "malformed linkage record");
        if (tv_teq(tk[0], ".gdef") && !(t->nrecords && t->first_unit)) return tv_fail(why, wl, "ValueError", lineno, ".gdef needs .unit 2");
        t->nrecords++;
        return 0;
    }
    if (tv_startswith(s, n, ".str ")) {
        const unsigned *r = s + 5; size_t rl = n - 5, a; unsigned char *blob; size_t bn; char *name;
        while (rl && tv_space(r[0])) { r++; rl--; }
        while (rl && tv_space(r[rl - 1])) rl--;
        for (a = 0; a < rl && !tv_space(r[a]); a++) ;
        { size_t b = a; while (b < rl && tv_space(r[b])) b++;
          if (b >= rl) return tv_unpack(why, wl, 1);
          { const unsigned *lit = r + b; size_t ln = rl - b;
            while (ln && tv_space(lit[ln - 1])) ln--;
            if (ln < 2 || lit[0] != '"' || lit[ln - 1] != '"') return tv_fail(why, wl, "ValueError", lineno, "malformed .str literal");
            if (tv_unescape(lit + 1, ln - 2, &blob, &bn, why, wl)) return -1; } }
        name = tv_utf8(r, a);
        tv_string(t, name, blob, bn, 0, 1);
        free(name); free(blob); t->nrecords++;
        return 0;
    }
    if (s[n - 1] == ':') {
        int sp = 0;
        for (i = 0; i + 1 < n; i++) if (s[i] == ' ') sp = 1;
        if (!sp) {
            char *name = tv_utf8(s, n - 1);
            tv_put(&t->labels, name, t->ncode);
            free(name); t->nrecords++;
            return 0;
        }
    }
    {   /* an instruction */
        unsigned *body = tv_alloc(n * sizeof *body); tv_tok parts[24], grouped[24]; int np, ng = 0, op, j; char *opname; tv_insn *in; const char *shape;
        for (i = 0; i < n; i++) body[i] = (s[i] == '[' || s[i] == ']' || s[i] == ',') ? ' ' : s[i];
        np = tv_split(body, n, parts, 24);
        if (np == 0) { free(body); snprintf(why, wl, "IndexError: list index out of range"); return -1; }
        opname = tv_utf8(parts[0].p, parts[0].n);
        op = tv_opindex(opname);
        if (op < 0) {
            char r[512], m[600]; tv_repr(parts[0].p, parts[0].n, r, sizeof r);
            snprintf(m, sizeof m, "unknown op %s", r); free(opname); free(body);
            return tv_fail(why, wl, "AssertionError", lineno, m);
        }
        shape = TV_OPS[op][1];
        for (j = 1; j < np && j < 24; j++) {   /* _regroup */
            tv_tok tok = parts[j]; size_t c, cut = 0; int found = 0;
            if ((op == O_LOAD64 || op == O_STORE64 || op == O_LD || op == O_ST || op == O_ZERO || op == O_CALLM) && tok.n && tok.p[0] == 'r') {
                for (c = 1; c < tok.n; c++) if (tok.p[c] == '+' || tok.p[c] == '-') { found = 1; cut = c; }
            }
            if (found && ng + 2 <= 24) { grouped[ng].p = tok.p; grouped[ng++].n = cut; grouped[ng].p = tok.p + cut; grouped[ng++].n = tok.n - cut; }
            else if (ng < 24) grouped[ng++] = tok;
        }
        if (np > 24 || ng != (int)strlen(shape)) {
            char m[128]; snprintf(m, sizeof m, "wrong operand count for %s", opname); free(opname); free(body);
            return tv_fail(why, wl, "ValueError", lineno, m);
        }
        t->code = tv_grow(t->code, &t->capcode, t->ncode + 1, sizeof *t->code);
        in = &t->code[t->ncode]; memset(in, 0, sizeof *in); in->op = op; in->n = ng;
        for (j = 0; j < ng; j++) {
            tv_arg *a = &in->a[j]; a->kind = shape[j];
            if (shape[j] == 'r') {
                if (!(grouped[j].n == 2 && grouped[j].p[0] == 'r' && grouped[j].p[1] >= '0' && grouped[j].p[1] <= '7')) {
                    char r[512], m[600]; tv_repr(grouped[j].p, grouped[j].n, r, sizeof r);
                    snprintf(m, sizeof m, "%s is not a register", r); free(opname); free(body);
                    return tv_fail(why, wl, "AssertionError", lineno, m);
                }
                a->reg = (int)(grouped[j].p[1] - '0');
            } else if (shape[j] == 'i') {
                if (tv_integer(grouped[j], lineno, 0, &a->u, &a->neg, why, wl)) { free(opname); free(body); return -1; }
            } else {
                if (shape[j] == 's' && grouped[j].n && (grouped[j].p[0] == '+' || grouped[j].p[0] == '-' || (grouped[j].p[0] >= '0' && grouped[j].p[0] <= '9'))) {
                    if (tv_integer(grouped[j], lineno, 0, &a->u, &a->neg, why, wl)) { free(opname); free(body); return -1; }
                    a->reg = 1;   /* numeric spelling: int(s, 0) is this value */
                } else if (shape[j] == 's' && !grouped[j].n) a->reg = 0;
                a->s = tv_utf8(grouped[j].p, grouped[j].n);
            }
        }
        t->ncode++; t->nrecords++;
        free(opname); free(body);
    }
    return 0;
}

tv_tape *tv_parse(const unsigned *cp, size_t n, char *why, size_t whylen) {
    tv_tape *t = tv_alloc(sizeof *t); size_t i = 0; int lineno = 0;
    while (i < n) {
        size_t b = i;
        while (i < n && !tv_linebreak(cp[i])) i++;
        lineno++;
        if (tv_line(t, cp + b, i - b, lineno, why, whylen)) return 0;
        if (i < n) { if (cp[i] == '\r' && i + 1 < n && cp[i + 1] == '\n') i++; i++; }
    }
    return t;
}
tv_tape *tv_parse_latin1(const char *b, size_t n, char *why, size_t whylen) {
    unsigned *cp = tv_alloc((n + 1) * sizeof *cp); size_t i; tv_tape *t;
    for (i = 0; i < n; i++) cp[i] = (unsigned char)b[i];
    t = tv_parse(cp, n, why, whylen); free(cp); return t;
}
tv_tape *tv_parse_utf8(const char *b, size_t n, char *why, size_t whylen) {
    const unsigned char *s = (const unsigned char *)b; unsigned *cp = tv_alloc((n + 1) * sizeof *cp); size_t i = 0, m = 0; tv_tape *t;
    while (i < n) {
        unsigned c = s[i], lo = 0x80, hi = 0xBF, v; int need = 0, k;
        if (c < 0x80) { cp[m++] = c; i++; continue; }
        if (c >= 0xC2 && c <= 0xDF) need = 1;
        else if (c >= 0xE0 && c <= 0xEF) { need = 2; if (c == 0xE0) lo = 0xA0; if (c == 0xED) hi = 0x9F; }
        else if (c >= 0xF0 && c <= 0xF4) { need = 3; if (c == 0xF0) lo = 0x90; if (c == 0xF4) hi = 0x8F; }
        if (!need) { free(cp); snprintf(why, whylen, "UnicodeDecodeError: 'utf-8' codec can't decode byte 0x%02x in position %lu: invalid start byte", c, (unsigned long)i); return 0; }
        v = c & (0x3F >> need);
        for (k = 1; k <= need; k++) {
            unsigned d;
            if (i + (size_t)k >= n) { free(cp); snprintf(why, whylen, "UnicodeDecodeError: 'utf-8' codec can't decode byte 0x%02x in position %lu: unexpected end of data", c, (unsigned long)i); return 0; }
            d = s[i + k];
            if (k == 1 ? (d < lo || d > hi) : (d < 0x80 || d > 0xBF)) { free(cp); snprintf(why, whylen, "UnicodeDecodeError: 'utf-8' codec can't decode byte 0x%02x in position %lu: invalid continuation byte", c, (unsigned long)i); return 0; }
            v = (v << 6) | (d & 0x3F);
        }
        cp[m++] = v; i += (size_t)need + 1;
    }
    t = tv_parse(cp, m, why, whylen); free(cp); return t;
}

/* ---- Insn repr ------------------------------------------------------------------------------------------------- */
static void tv_argstr(const tv_arg *a, char *o, size_t ol) {
    if (a->kind == 'r') snprintf(o, ol, "r%d", a->reg);
    else if (a->kind == 'i') { if (a->neg) snprintf(o, ol, "%lld", (long long)a->u); else snprintf(o, ol, "%llu", a->u); }
    else snprintf(o, ol, "%s", a->s);
}
void tv_insn_repr(tv_tape *t, size_t pc, char *out, size_t outlen) {
    const tv_insn *in = &t->code[pc]; size_t j = 0; int i; char a[512];
    j = (size_t)snprintf(out, outlen, "%s ", TV_OPS[in->op][0]);
    for (i = 0; i < in->n && j < outlen; i++) {
        tv_argstr(&in->a[i], a, sizeof a);
        j += (size_t)snprintf(out + j, outlen - j, "%s%s", i ? ", " : "", a);
    }
}

/* ---- the machine ---------------------------------------------------------------------------------------------- */
static void tv_outadd(tv_vm *vm, const unsigned char *p, size_t n) {
    vm->out = tv_grow(vm->out, &vm->outcap, vm->outn + n + 1, 1);
    if (n) memcpy(vm->out + vm->outn, p, n);
    vm->outn += n;
}
/* the environment as os.environ holds it, then "%s=%s".encode('latin-1', 'replace') */
static size_t tv_envbytes(const char *e, unsigned char *o) {
    const unsigned char *s = (const unsigned char *)e; size_t i = 0, j = 0, n = strlen(e);
    while (i < n) {
        unsigned c = s[i], lo = 0x80, hi = 0xBF, v; int need = 0, k;
        if (c < 0x80) { o[j++] = (unsigned char)c; i++; continue; }
        if (c >= 0xC2 && c <= 0xDF) need = 1;
        else if (c >= 0xE0 && c <= 0xEF) { need = 2; if (c == 0xE0) lo = 0xA0; if (c == 0xED) hi = 0x9F; }
        else if (c >= 0xF0 && c <= 0xF4) { need = 3; if (c == 0xF0) lo = 0x90; if (c == 0xF4) hi = 0x8F; }
        if (!need) { o[j++] = '?'; i++; continue; }
        v = c & (0x3F >> need);
        for (k = 1; k <= need; k++) {
            unsigned d = i + (size_t)k < n ? s[i + k] : 0x100;
            if (k == 1 ? (d < lo || d > hi) : (d < 0x80 || d > 0xBF)) break;
            v = (v << 6) | (d & 0x3F);
        }
        if (k <= need) { o[j++] = '?'; i++; continue; }   /* surrogateescape: each undecodable byte is one '?' */
        o[j++] = v < 0x100 ? (unsigned char)v : '?';
        i += (size_t)need + 1;
    }
    o[j++] = 0;
    return j;
}
int tv_vm_init(tv_vm *vm, tv_tape *t, long long max_steps, char *const *argv, int argc, char *why, size_t whylen) {
    size_t i, p, room = 65536, nenv = 0; char **e;
    memset(vm, 0, sizeof *vm);
    vm->t = t; vm->max_steps = max_steps; vm->brk = TV_MEM / 2;
    if (TV_DATA_BASE + t->ndata > TV_MEM) {
        for (i = 0; i < t->nseg; i++) if (TV_DATA_BASE + t->segs[i].off + t->segs[i].len > TV_MEM) {
            snprintf(why, whylen, "tapevm: initialised data past the 16 MB machine not covered"); return -1;
        }
    }
    vm->mem = tv_alloc(TV_MEM);
    for (i = 0; i < t->nseg; i++) memcpy(vm->mem + TV_DATA_BASE + t->segs[i].off, t->segs[i].p, t->segs[i].len);
    for (e = environ; e && *e; e++) nenv++;
    vm->argv = tv_alloc(((size_t)argc + nenv + 2) * sizeof *vm->argv);
    p = TV_DATA_BASE + t->ndata + 64;
    for (i = 0; i < (size_t)argc; i++) {
        size_t l = strlen(argv[i]) + 1;
        if (p + l > TV_MEM) { snprintf(why, whylen, "tapevm: argv past the 16 MB machine not covered"); return -1; }
        memcpy(vm->mem + p, argv[i], l); vm->argv[vm->nargv++] = p; p += l;
    }
    vm->nargs = vm->nargv;
    vm->argv[vm->nargv++] = 0;
    {   /* os.environ: entries with '=', the first of a repeated name */
        char **seen = tv_alloc((nenv + 1) * sizeof *seen); size_t nseen = 0, k;
        unsigned char *b;
        for (e = environ; e && *e; e++) {
            const char *eq = strchr(*e, '='); int dup = 0; size_t l;
            if (!eq) continue;
            for (k = 0; k < nseen && !dup; k++) { size_t kl = (size_t)(strchr(seen[k], '=') - seen[k]); dup = kl == (size_t)(eq - *e) && !memcmp(seen[k], *e, kl); }
            if (dup) continue;
            seen[nseen++] = *e;
            b = tv_alloc(strlen(*e) + 2);
            l = tv_envbytes(*e, b);
            if (l > room) { free(b); break; }
            room -= l;
            if (p + l > TV_MEM) { free(b); free(seen); snprintf(why, whylen, "tapevm: environment past the 16 MB machine not covered"); return -1; }
            memcpy(vm->mem + p, b, l); vm->argv[vm->nargv++] = p; p += l; free(b);
        }
        free(seen);
    }
    vm->r[7] = TV_MEM;
    return 0;
}

static long long tv_sval(const tv_arg *a) { return (long long)a->u; }   /* the integer operand (wrapped to 64 bits) */
static int tv_halt(tv_vm *vm, int *code, int c, unsigned long long fault_addr, int fault) {
    if (fault) {
        char r[1024]; tv_insn_repr(vm->t, (size_t)vm->pc_now, r, sizeof r);
        fprintf(stderr, "vm fault: address 0x%llx at pc %llu (%s) after %lld steps\n", fault_addr, vm->pc_now, r, vm->steps);
        fflush(stderr);
    }
    *code = c;
    return 0;
}
/* VM.ld(a, w): the hook first, then mem[a:a+w] little-endian, sign-extended below 8 bytes */
static int tv_ld(tv_vm *vm, unsigned long long a, long long w, unsigned long long *v, char *why, size_t wl) {
    unsigned long long x = 0; long long i;
    if (vm->on_ld) vm->on_ld(vm->ctx, a, w);
    if (w <= 0) { snprintf(why, wl, "ValueError: negative shift count"); return -1; }
    for (i = 0; i < w && i < 8; i++) if (a + (unsigned long long)i < TV_MEM && a + (unsigned long long)i >= a) x |= (unsigned long long)vm->mem[a + (unsigned long long)i] << (8 * i);
    if (w < 8 && ((x >> (w * 8 - 1)) & 1)) x |= TV_MASK << (w * 8);
    *v = x;
    return 0;
}
static int tv_st(tv_vm *vm, unsigned long long a, unsigned long long v, long long w, char *why, size_t wl) {
    long long i;
    if (w < 0) { snprintf(why, wl, "ValueError: negative shift count"); return -1; }
    if (w == 0) return 0;
    if (a >= TV_MEM || (unsigned long long)w > TV_MEM - a) { snprintf(why, wl, "tapevm: store of %lld bytes at 0x%llx past the 16 MB machine not covered", w, a); return -1; }
    for (i = 0; i < w; i++) vm->mem[a + (unsigned long long)i] = i < 8 ? (unsigned char)(v >> (8 * i)) : 0;
    return 0;
}
static void tv_repr_utf8(const char *name, char *r, size_t rl) {   /* repr(str) of UTF-8 text */
    unsigned cp[512]; size_t n = 0; const unsigned char *s = (const unsigned char *)name;
    while (*s && n < 511) {
        unsigned c = *s; int l = 1;
        if (c >= 0xF0 && s[1] && s[2] && s[3]) { c = ((c & 7) << 18) | ((s[1] & 0x3Fu) << 12) | ((s[2] & 0x3Fu) << 6) | (s[3] & 0x3Fu); l = 4; }
        else if (c >= 0xE0 && s[1] && s[2]) { c = ((c & 0xF) << 12) | ((s[1] & 0x3Fu) << 6) | (s[2] & 0x3Fu); l = 3; }
        else if (c >= 0xC0 && s[1]) { c = ((c & 0x1F) << 6) | (s[1] & 0x3Fu); l = 2; }
        cp[n++] = c; s += l;
    }
    tv_repr(cp, n, r, rl);
}
static int tv_label_pc(tv_vm *vm, const char *name, unsigned long long *pc, char *why, size_t wl) {   /* labels[name] */
    tv_ent *e = tv_find(&vm->t->labels, name); char r[600];
    if (e) { *pc = e->v; return 0; }
    tv_repr_utf8(name, r, sizeof r);
    snprintf(why, wl, "KeyError: %s", r);
    return -1;
}

/* ---- fp.py ---------------------------------------------------------------------------------------------------- */
static double tv_d(unsigned long long x) { double f; memcpy(&f, &x, 8); return f; }
static unsigned long long tv_bd(double f) { unsigned long long x; memcpy(&x, &f, 8); return x; }
static double tv_s(unsigned long long x) { unsigned u = (unsigned)(x & 0xFFFFFFFFu); float f; memcpy(&f, &u, 4); return (double)f; }
static unsigned long long tv_bs(double f) {
    float g; unsigned u;
    if (f != f) return 0x7FC00000ull | ((tv_bd(f) >> 63) ? 0x80000000ull : 0);
    if (f >= 3.4028235677973366e+38) return 0x7F800000ull;
    if (f <= -3.4028235677973366e+38) return 0xFF800000ull;
    g = (float)f; memcpy(&u, &g, 4); return u;
}
static double tv_pow2(int e) {   /* 2^e for -1022 <= e <= 1023 */
    return tv_d((unsigned long long)(e + 1023) << 52);
}
static double tv_u2d(unsigned long long x) {   /* float(int) of 0 <= x < 2^64, one rounding */
    if (x < 0x8000000000000000ull) return (double)(long long)x;
    return (double)(long long)((x >> 1) | (x & 1)) * 2.0;
}
static double tv_div(double a, double b) {
    if (b != 0.0) return a / b;
    if (a != a || a == 0.0) return tv_d(0x7FF8000000000000ull);
    return ((tv_bd(a) >> 63) != (tv_bd(b) >> 63)) ? tv_d(0xFFF0000000000000ull) : tv_d(0x7FF0000000000000ull);
}
/* correctly rounded sqrt of a positive finite double, in integer arithmetic */
static double tv_sqrt(double a) {
    unsigned long long b = tv_bd(a), m = b & 0x000FFFFFFFFFFFFFull, hi, lo, rh = 0, rl = 0, oh, ol, s; int e = (int)((b >> 52) & 0x7FF), E, k;
    if (a != a || a < 0) return tv_d(0x7FF8000000000000ull);
    if (a == 0 || e == 0x7FF) return a;
    if (e == 0) { e = 1; while (!(m & 0x0010000000000000ull)) { m <<= 1; e--; } }
    else m |= 0x0010000000000000ull;
    e -= 1075;                          /* a = m * 2^e, 2^52 <= m < 2^53 */
    if (e & 1) { m <<= 1; e -= 1; }
    E = e / 2;
    /* M = m << 56 as (hi, lo) */
    hi = m >> 8; lo = m << 56;
    /* bit-by-bit isqrt: one = 4^63 down */
    oh = 0x4000000000000000ull; ol = 0;
    while (oh > hi || (oh == hi && ol > lo)) { ol = (ol >> 2) | (oh << 62); oh >>= 2; }
    while (oh || ol) {
        unsigned long long th = rh + oh + ((rl + ol) < rl), tl = rl + ol;
        if (hi > th || (hi == th && lo >= tl)) {
            hi = hi - th - (lo < tl); lo = lo - tl;
            rl = (rl >> 1) | (rh << 63); rh >>= 1;
            rh += oh + ((rl + ol) < rl); rl += ol;
        } else { rl = (rl >> 1) | (rh << 63); rh >>= 1; }
        ol = (ol >> 2) | (oh << 62); oh >>= 2;
    }
    s = rl;                              /* 2^54 <= s < 2^55; remainder (hi, lo) */
    k = (hi | lo) != 0;
    {
        unsigned long long q = s >> 2; int g = (int)((s >> 1) & 1), st = (int)(s & 1) | k;
        if (g && (st || (q & 1))) q++;
        if (q >> 53) { q >>= 1; E++; }
        return (double)(long long)q * tv_pow2(E - 26);
    }
}
static unsigned long long tv_i2f32(long long sv, unsigned long long uv, int is_signed) {
    int neg = is_signed && sv < 0, sh, bl = 0; unsigned long long v = is_signed ? (neg ? 0 - (unsigned long long)sv : (unsigned long long)sv) : uv, q, rem, half; double f;
    if (v < (1ull << 53)) return tv_bs(neg ? -(double)v : (double)v);
    { unsigned long long t = v; while (t) { bl++; t >>= 1; } }
    sh = bl - 24;
    q = v >> sh; rem = v & ((1ull << sh) - 1); half = 1ull << (sh - 1);
    if (rem > half || (rem == half && (q & 1))) q++;
    f = (double)(long long)q * tv_pow2(sh);
    return tv_bs(neg ? -f : f);
}
static unsigned long long tv_f2int(double f, int is_unsigned) {
    if (f != f) return 0;
    if (is_unsigned) {
        if (f >= 18446744073709551616.0) return TV_MASK;
        if (f <= -1.0) return 0;
        if (f < 1.0) return 0;
        if (f >= 9223372036854775808.0) return (unsigned long long)(long long)(f - 9223372036854775808.0) + 0x8000000000000000ull;
        return (unsigned long long)(long long)f;
    }
    if (f >= 9223372036854775808.0) return 0x7FFFFFFFFFFFFFFFull;
    if (f < -9223372036854775808.0) return 0x8000000000000000ull;
    return (unsigned long long)(long long)f;
}
static unsigned long long tv_op3(int k, unsigned long long x, unsigned long long y) {
    int w64 = k < 7; int o = k % 7; double a = w64 ? tv_d(x) : tv_s(x), b = w64 ? tv_d(y) : tv_s(y), r;
    switch (o) {
    case 0: r = a + b; break;
    case 1: r = a - b; break;
    case 2: r = a * b; break;
    case 3: r = tv_div(a, b); break;
    case 4: return a < b ? 1 : 0;
    case 5: return a <= b ? 1 : 0;
    default: return a == b ? 1 : 0;
    }
    return w64 ? tv_bd(r) : tv_bs(r);
}
static unsigned long long tv_op2(int k, unsigned long long x) {
    switch (k) {
    case 0: return tv_bd((double)(long long)x);
    case 1: return tv_bd(tv_u2d(x));
    case 2: return tv_i2f32((long long)x, 0, 1);
    case 3: return tv_i2f32(0, x, 0);
    case 4: return tv_f2int(tv_d(x), 0);
    case 5: return tv_f2int(tv_d(x), 1);
    case 6: return tv_bd(tv_s(x));
    case 7: return tv_bs(tv_d(x));
    case 8: return tv_bd(tv_sqrt(tv_d(x)));
    default: return tv_bs(tv_sqrt(tv_s(x)));
    }
}

/* ---- syscalls (vm.py VM.syscall) -------------------------------------------------------------------------------- */
static char *tv_cstr(tv_vm *vm, unsigned long long p) {
    size_t e = (size_t)p, n; char *s;
    if (p >= TV_MEM) { s = tv_alloc(1); return s; }
    while (e < TV_MEM && vm->mem[e]) e++;
    n = e - (size_t)p; s = tv_alloc(n + 1); memcpy(s, vm->mem + p, n); return s;
}
static unsigned long long tv_neg_errno(void) { return 0 - (unsigned long long)(errno ? errno : 1); }
static int tv_syscall(tv_vm *vm, const char *name, unsigned long long *a, unsigned long long *ret, int *halted, char *why, size_t wl) {
    *halted = 0;
    if (!strcmp(name, "mmap")) {
        unsigned long long n, p = vm->brk;
        if (a[1] > TV_MEM) { *ret = TV_MASK; return 0; }
        n = (a[1] + 0xFFF) & ~0xFFFull;
        if (p + n > TV_MEM - 0x10000) { *ret = TV_MASK; return 0; }
        vm->brk = p + n; memset(vm->mem + p, 0, (size_t)n); *ret = p; return 0;
    }
    if (!strcmp(name, "mprotect") || !strcmp(name, "munmap")) { *ret = 0; return 0; }
    if (!strcmp(name, "write")) {
        size_t s = a[1] < TV_MEM ? (size_t)a[1] : TV_MEM, e = (a[2] > TV_MEM - s) ? TV_MEM : s + (size_t)a[2];
        if (a[0] == 1 || a[0] == 2) { tv_outadd(vm, vm->mem + s, e - s); *ret = a[2]; return 0; }
        { ssize_t k = write((int)a[0], vm->mem + s, e - s); *ret = k < 0 ? tv_neg_errno() : (unsigned long long)k; return 0; }
    }
    if (!strcmp(name, "read")) {
        unsigned char *b; ssize_t k; size_t want = a[2] > TV_MEM ? TV_MEM : (size_t)a[2];
        b = tv_alloc(want + 1); k = read((int)a[0], b, want);
        if (k < 0) { free(b); *ret = tv_neg_errno(); return 0; }
        if (k > 0 && (a[1] >= TV_MEM || (unsigned long long)k > TV_MEM - a[1])) { free(b); snprintf(why, wl, "tapevm: read(2) into 0x%llx past the 16 MB machine not covered", a[1]); return -1; }
        if (k > 0) memcpy(vm->mem + a[1], b, (size_t)k);
        free(b); *ret = (unsigned long long)k; return 0;
    }
    if (!strcmp(name, "open")) {
        char *p = tv_cstr(vm, a[0]); int f = (int)(a[1] & 3), fd;
        if (a[1] & 64) f |= O_CREAT;
        if (a[1] & 512) f |= O_TRUNC;
        if (a[1] & 1024) f |= O_APPEND;
        fd = open(p, f, (int)(a[2] ? a[2] : 0644)); free(p);
        *ret = fd < 0 ? tv_neg_errno() : (unsigned long long)fd; return 0;
    }
    if (!strcmp(name, "close")) { *ret = close((int)a[0]) ? tv_neg_errno() : 0; return 0; }
    if (!strcmp(name, "lseek")) { off_t o = lseek((int)a[0], (off_t)(long long)a[1], (int)a[2]); *ret = o < 0 ? tv_neg_errno() : (unsigned long long)o; return 0; }
    if (!strcmp(name, "unlink")) { char *p = tv_cstr(vm, a[0]); *ret = unlink(p) ? tv_neg_errno() : 0; free(p); return 0; }
    if (!strcmp(name, "rename")) { char *p = tv_cstr(vm, a[0]), *q = tv_cstr(vm, a[1]); *ret = rename(p, q) ? tv_neg_errno() : 0; free(p); free(q); return 0; }
    if (!strcmp(name, "exit")) { *halted = 1; *ret = a[0] & 0xFF; return 0; }
    {   char r[600]; tv_repr_utf8(name, r, sizeof r);
        snprintf(why, wl, "AssertionError: vm: unsupported syscall %s", r); }
    return -1;
}

/* ---- run_reference ------------------------------------------------------------------------------------------------ */
int tv_vm_run(tv_vm *vm, int *code, char *why, size_t wl) {
    tv_tape *t = vm->t; unsigned long long *r = vm->r, pc = 0, v, ad;
    tv_ent *st = tv_find(&t->labels, "_start");
    if (st) pc = st->v; else { st = tv_find(&t->labels, "main"); if (st) pc = st->v; }
    for (;;) {
        tv_insn *in; tv_arg *a; int op;
        vm->steps++;
        if (vm->steps > vm->max_steps) return tv_halt(vm, code, 124, 0, 0);
        if (pc >= t->ncode) return tv_halt(vm, code, (int)(r[0] & 0xFF), 0, 0);
        in = &t->code[pc]; a = in->a; op = in->op;
        vm->pc_now = pc;
        pc++;
#define R(i) r[a[i].reg]
#define ADDR(bi, oi) do { ad = R(bi) + a[oi].u; if (ad >= TV_MEM) return tv_halt(vm, code, 139, ad, 1); } while (0)
        switch (op) {
        case O_IMM: R(0) = a[1].u; break;
        case O_MOV: R(0) = R(1); break;
        case O_ADD: R(0) = R(1) + R(2); break;
        case O_SUB: R(0) = R(1) - R(2); break;
        case O_MUL: R(0) = R(1) * R(2); break;
        case O_AND: R(0) = R(1) & R(2); break;
        case O_OR: R(0) = R(1) | R(2); break;
        case O_SHL: R(0) = R(1) << (R(2) & 63); break;
        case O_SHR: { long long x = (long long)R(1); int s = (int)(R(2) & 63); R(0) = (unsigned long long)(x < 0 ? ~((~x) >> s) : x >> s); } break;
        case O_LSHR: R(0) = R(1) >> (R(2) & 63); break;
        case O_XOR: R(0) = R(1) ^ R(2); break;
        case O_UDIV: case O_UMOD: {
            unsigned long long x = R(1), y = R(2);
            if (!y) return tv_halt(vm, code, 136, 0, 0);
            R(0) = op == O_UDIV ? x / y : x % y; } break;
        case O_DIV: case O_MOD: {
            long long x = (long long)R(1), y = (long long)R(2); unsigned long long ux, uy, q;
            if (!y) return tv_halt(vm, code, 136, 0, 0);
            ux = x < 0 ? 0 - (unsigned long long)x : (unsigned long long)x; uy = y < 0 ? 0 - (unsigned long long)y : (unsigned long long)y;
            q = ux / uy; if ((x < 0) != (y < 0)) q = 0 - q;
            R(0) = op == O_DIV ? q : (unsigned long long)x - q * (unsigned long long)y; } break;
        case O_SLT: R(0) = (long long)R(1) < (long long)R(2); break;
        case O_SLE: R(0) = (long long)R(1) <= (long long)R(2); break;
        case O_ULT: R(0) = R(1) < R(2); break;
        case O_ULE: R(0) = R(1) <= R(2); break;
        case O_EQ: R(0) = R(1) == R(2); break;
        case O_NE: R(0) = R(1) != R(2); break;
        case O_LOAD64: ADDR(1, 2); if (tv_ld(vm, ad, 8, &v, why, wl)) return -1; R(0) = v; break;
        case O_STORE64: ADDR(0, 1); if (tv_st(vm, ad, R(2), 8, why, wl)) return -1; break;
        case O_LD: ADDR(1, 2); if (tv_ld(vm, ad, a[3].neg ? tv_sval(&a[3]) : (a[3].u > 0x7FFFFFFFFFFFFFFFull ? 0x7FFFFFFFFFFFFFFFll : (long long)a[3].u), &v, why, wl)) return -1; R(0) = v; break;
        case O_ST: ADDR(0, 1); if (tv_st(vm, ad, R(2), a[3].neg ? tv_sval(&a[3]) : (a[3].u > 0x7FFFFFFFFFFFFFFFull ? 0x7FFFFFFFFFFFFFFFll : (long long)a[3].u), why, wl)) return -1; break;
        case O_LEA: {
            tv_ent *e = tv_find(&t->syms, a[1].s);
            if (!e) e = tv_find(&t->labels, a[1].s);
            if (e) R(0) = e->v;
            else if (a[1].reg) R(0) = a[1].u;
            else {
                char rr[600];
                tv_repr_utf8(a[1].s, rr, sizeof rr);
                snprintf(why, wl, "ValueError: invalid literal for int() with base 0: %s", rr);
                return -1;
            } } break;
        case O_ZERO: {
            long long n = a[2].neg ? tv_sval(&a[2]) : (a[2].u > 0x7FFFFFFFFFFFFFFFull ? 0x7FFFFFFFFFFFFFFFll : (long long)a[2].u);
            ADDR(0, 1);
            if (n > 0) {
                if ((unsigned long long)n > TV_MEM - ad) { snprintf(why, wl, "tapevm: .zero past the 16 MB machine not covered"); return -1; }
                memset(vm->mem + ad, 0, (size_t)n);
            } else if (n < 0 && (long long)ad + n < 0) { snprintf(why, wl, "tapevm: .zero with a negative size not covered"); return -1; }
        } break;
        case O_JUMP: if (tv_label_pc(vm, a[0].s, &pc, why, wl)) return -1; break;
        case O_JUMPZ: if (!R(0) && tv_label_pc(vm, a[1].s, &pc, why, wl)) return -1; break;
        case O_CALL: {
            unsigned long long ret = pc;
            r[7] -= 8; if (tv_st(vm, r[7], ret, 8, why, wl)) return -1;
            if (tv_label_pc(vm, a[0].s, &pc, why, wl)) return -1; } break;
        case O_CALLR: {
            unsigned long long ret = pc, target = R(0);
            r[7] -= 8; if (tv_st(vm, r[7], ret, 8, why, wl)) return -1;
            pc = target; } break;
        case O_CALLM: {
            unsigned long long ret = pc, target;
            ADDR(0, 1); if (tv_ld(vm, ad, 8, &target, why, wl)) return -1;
            r[7] -= 8; if (tv_st(vm, r[7], ret, 8, why, wl)) return -1;
            pc = target; } break;
        case O_RET: if (tv_ld(vm, r[7], 8, &v, why, wl)) return -1; pc = v; r[7] += 8; break;
        case O_FRAME: r[7] -= a[0].u; break;
        case O_ARG: {
            long long i = a[0].neg ? tv_sval(&a[0]) : (a[0].u > 0x7FFFFFFFFFFFFFFFull ? 0x7FFFFFFFFFFFFFFFll : (long long)a[0].u);
            if (i < -8 || i > 7) { snprintf(why, wl, "IndexError: list assignment index out of range"); return -1; }
            r[(i + 8) % 8] = r[a[1].reg]; } break;
        case O_PRINT: {
            char b[32]; int n = snprintf(b, sizeof b, "%lld", (long long)R(0));
            tv_outadd(vm, (const unsigned char *)b, (size_t)n);
            r[0] = 0; r[1] = r[2] = 0xDEAD5EA1DEAD5EA1ull; } break;
        case O_WRITE: {
            unsigned long long p = R(0), n = R(1); size_t s = p < TV_MEM ? (size_t)p : TV_MEM, e = n > TV_MEM - s ? TV_MEM : s + (size_t)n;
            tv_outadd(vm, vm->mem + s, e - s);
            r[0] = n; r[1] = r[2] = 0xDEAD5EA1DEAD5EA1ull; } break;
        case O_ARGC: R(0) = vm->nargs; break;
        case O_ARGV: { unsigned long long k = R(1); R(0) = k < vm->nargv ? vm->argv[k] : 0; } break;
        case O_SYS: case O_SYS6: {
            unsigned long long sa[6] = { 0, 0, 0, 0, 0, 0 }, ret; int i, halted;
            for (i = 1; i < in->n; i++) sa[i - 1] = r[a[i].reg];
            if (tv_syscall(vm, a[0].s, sa, &ret, &halted, why, wl)) return -1;
            if (halted) return tv_halt(vm, code, (int)ret, 0, 0);
            r[0] = ret; r[1] = r[2] = 0xDEAD5EA1DEAD5EA1ull; } break;
        case O_EXIT: return tv_halt(vm, code, (int)(R(0) & 0xFF), 0, 0);
        case O_NOP: break;
        default:
            if (op >= O_FP3 && op < O_FP2) { R(0) = tv_op3(op - O_FP3, R(1), R(2)); break; }
            if (op >= O_FP2 && op < O_NOPS) { R(0) = tv_op2(op - O_FP2, R(1)); break; }
            snprintf(why, wl, "AssertionError: vm: unhandled '%s'", TV_OPS[op][0]);
            return -1;
        }
#undef R
#undef ADDR
    }
}
