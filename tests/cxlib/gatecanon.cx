/* gatecanon: pure-data fingerprint engine. Include cx.h and cxlib/pyjson.cx first.
   gc_dump returns caller-owned malloc storage. Other APIs fail closed (stderr,
   exit 2) on invalid shapes, excessive depth, overflow or allocation failure.
   Values must remain alive AND immutable until gc_reset; no input is modified.
   gc_aliases copies pairs; changing aliases invalidates all component hashes.
   Merkle wire v1: component = SHA256("unisacc-gate-component-v1\\0" +
   portable(canonical(value))); identity = SHA256("unisacc-gate-identity-v1\\0"
   + canonical([kind, [component_hex, ...]])). Identity must be an array;
   order, cardinality and whole/narrow kind are retained. This intentionally
   changes old stamps: use fresh queue state. No metadata or file I/O here. */
#pragma unisa module gatecanon

typedef struct gc_buf { char *p; size_t n, cap; } gc_buf;
typedef struct gc_alias { char *raw, *replacement; size_t rn, sn, chars; } gc_alias;
typedef struct gc_cache { const pj_value *node; char hex[65]; struct gc_cache *next; } gc_cache;
static gc_alias *gc_pairs;
static size_t gc_pair_count;
#define GC_BUCKETS 4093
static gc_cache *gc_buckets[GC_BUCKETS];
static void gc_fail(const char *why) { fprintf(stderr, "gatecanon: %s\n", why); exit(2); }
static void *gc_alloc(size_t n) { void *p = malloc(n ? n : 1); if (!p) gc_fail("allocation failure"); return p; }
static void gc_put(gc_buf *b, const char *s, size_t n) {
    size_t need, cap; char *p;
    if (n > (size_t)-1 - b->n - 1) gc_fail("size overflow");
    need = b->n + n + 1;
    if (need > b->cap) {
        cap = b->cap ? b->cap : 256;
        while (cap < need) { if (cap > (size_t)-1 / 2) { cap = need; break; } cap *= 2; }
        p = realloc(b->p, cap); if (!p) gc_fail("allocation failure"); b->p = p; b->cap = cap;
    }
    if (n) memcpy(b->p + b->n, s, n);
    b->n += n; b->p[b->n] = 0;
}
/* Accept UTF-8 scalar bytes plus encoded lone surrogates (pyjson's internal
   representation); reject alternative byte encodings of the same JSON string. */
static void gc_utf8(const char *s, size_t n) {
    size_t i=0;
    while(i<n) {
        unsigned char c=(unsigned char)s[i++]; unsigned long cp; size_t more;
        if(c<0x80) continue;
        if(c>=0xC2&&c<=0xDF){cp=c&31;more=1;}
        else if(c>=0xE0&&c<=0xEF){cp=c&15;more=2;}
        else if(c>=0xF0&&c<=0xF4){cp=c&7;more=3;}
        else gc_fail("invalid UTF-8");
        if(more>n-i) gc_fail("truncated UTF-8");
        for(size_t j=0;j<more;j++){
            unsigned char d=(unsigned char)s[i++];
            if((d&0xC0)!=0x80) gc_fail("invalid UTF-8 continuation");
            cp=(cp<<6)|(d&63);
        }
        if((more==1&&cp<0x80)||(more==2&&cp<0x800)||(more==3&&cp<0x10000)||cp>0x10FFFF)
            gc_fail("noncanonical UTF-8");
    }
}
static int gc_keycmp(const pj_value *a, const pj_value *b) {
    size_t n = a->n < b->n ? a->n : b->n;
    int c = memcmp(a->s, b->s, n);
    return c ? c : a->n < b->n ? -1 : a->n > b->n ? 1 : 0;
}
static void gc_emit(gc_buf *b, const pj_value *v, unsigned depth) {
    size_t i, j, count; size_t *order; char *p; size_t n;
    if (!v || depth > 900) gc_fail("null node, cycle or excessive depth");
    if (v->type == PJ_ARR || v->type == PJ_OBJ) {
        if (v->len && !v->items) gc_fail("missing container items");
        if (v->type == PJ_ARR) {
            gc_put(b, "[", 1);
            for (i = 0; i < v->len; i++) { if (i) gc_put(b, ", ", 2); gc_emit(b, v->items[i], depth + 1); }
            gc_put(b, "]", 1); return;
        }
        if (v->len % 2) gc_fail("odd object length");
        count = v->len / 2;
        if (count > (size_t)-1 / sizeof *order) gc_fail("object size overflow");
        order = gc_alloc(count * sizeof *order);
        for (i = 0; i < count; i++) {
            pj_value *key = v->items[2 * i];
            if (!key || key->type != PJ_STR || !key->s) gc_fail("non-string object key");
            gc_utf8(key->s, key->n);
            order[i] = i;
        }
        /* Stable index mergesort; never reorder the caller's object. */
        if (count > 1) {
            size_t width, start, mid, end, a, c, k; size_t *tmp = gc_alloc(count * sizeof *tmp);
            for (width = 1; width < count;) {
                for (start = 0; start < count; start = end) {
                    mid = count - start < width ? count : start + width;
                    end = count - mid < width ? count : mid + width;
                    a = start; c = mid; k = start;
                    while (a < mid || c < end) {
                        if (c == end || (a < mid && gc_keycmp(v->items[2 * order[a]], v->items[2 * order[c]]) <= 0)) tmp[k++] = order[a++];
                        else tmp[k++] = order[c++];
                    }
                }
                memcpy(order, tmp, count * sizeof *order);
                if (width > count / 2) break;
                width *= 2;
            }
            free(tmp);
        }
        gc_put(b, "{", 1);
        for (j = 0; j < count; j++) {
            i = order[j];
            if (j && !gc_keycmp(v->items[2 * order[j - 1]], v->items[2 * i])) gc_fail("duplicate object key");
            if (j) gc_put(b, ", ", 2);
            gc_emit(b, v->items[2 * i], depth + 1); gc_put(b, ": ", 2);
            gc_emit(b, v->items[2 * i + 1], depth + 1);
        }
        free(order); gc_put(b, "}", 1); return;
    }
    if (v->type < PJ_NULL || v->type > PJ_STR) gc_fail("unknown primitive type");
    if ((v->type == PJ_STR || v->type == PJ_INT) && !v->s) gc_fail("missing primitive bytes");
    if (v->type == PJ_STR) gc_utf8(v->s, v->n);
    /* Reuse pyjson's ensure_ascii escapes, integer spelling and float repr. */
    if (pj_dumps(v, -1, &p, &n)) gc_fail("primitive serialization failure");
    gc_put(b, p, n); free(p);
}
char *gc_dump(pj_value *v, size_t *n) {
    gc_buf b = {0, 0, 0}; if (!n) gc_fail("missing dump length");
    gc_emit(&b, v, 0); *n = b.n; return b.p;
}
void gc_reset(void) {
    size_t i; gc_cache *p, *next;
    for (i = 0; i < GC_BUCKETS; i++) { for (p = gc_buckets[i]; p; p = next) { next = p->next; free(p); } gc_buckets[i] = 0; }
}
static char *gc_copy(const char *s, size_t n) { char *p; if (n == (size_t)-1) gc_fail("string size overflow"); p = gc_alloc(n + 1); if (n) memcpy(p, s, n); p[n] = 0; return p; }
void gc_aliases(pj_value *pairs) {
    size_t i, j, k; gc_alias *fresh, t;
    if (!pairs || pairs->type != PJ_ARR || (pairs->len && !pairs->items)) gc_fail("aliases must be an array");
    if (pairs->len > (size_t)-1 / sizeof *fresh) gc_fail("alias count overflow");
    fresh = gc_alloc(pairs->len * sizeof *fresh);
    for (i = 0; i < pairs->len; i++) {
        pj_value *p = pairs->items[i], *raw, *rep;
        if (!p || p->type != PJ_ARR || p->len != 2 || !p->items) gc_fail("alias must be a pair");
        raw = p->items[0]; rep = p->items[1];
        if (!raw || !rep || raw->type != PJ_STR || rep->type != PJ_STR || !raw->s || !rep->s || !raw->n) gc_fail("alias strings must have nonempty raw");
        gc_utf8(raw->s, raw->n); gc_utf8(rep->s, rep->n);
        fresh[i].raw = gc_copy(raw->s, raw->n); fresh[i].rn = raw->n;
        fresh[i].replacement = gc_copy(rep->s, rep->n); fresh[i].sn = rep->n;
        fresh[i].chars = 0;
        for (k = 0; k < raw->n; k++) if (((unsigned char)raw->s[k] & 0xC0) != 0x80) fresh[i].chars++;
        t = fresh[i]; j = i;
        while (j && fresh[j - 1].chars < t.chars) { fresh[j] = fresh[j - 1]; j--; }
        fresh[j] = t;
    }
    gc_reset();
    for (i = 0; i < gc_pair_count; i++) { free(gc_pairs[i].raw); free(gc_pairs[i].replacement); }
    free(gc_pairs); gc_pairs = fresh; gc_pair_count = pairs->len;
}
static char *gc_portable(char *p, size_t *n) {
    size_t a, i, begin;
    for (a = 0; a < gc_pair_count; a++) {
        gc_alias *pair = gc_pairs + a; gc_buf b = {0, 0, 0};
        begin = 0; i = 0;
        while (i < *n) {
            if (pair->rn <= *n - i && !memcmp(p + i, pair->raw, pair->rn)) {
                gc_put(&b, p + begin, i - begin); gc_put(&b, pair->replacement, pair->sn);
                i += pair->rn; begin = i;
            } else i++;
        }
        gc_put(&b, p + begin, *n - begin); free(p); p = b.p; *n = b.n;
    }
    return p;
}
void gc_hash_json(pj_value *v, int portable_flag, char out[65]) {
    size_t n; char *p = gc_dump(v, &n); if (!out) gc_fail("missing hash output");
    if (portable_flag) p = gc_portable(p, &n);
    cx_sha256_hex(p, n, out); free(p);
}
static const char *gc_component(pj_value *v) {
    size_t bucket = ((size_t)v / sizeof(void *)) % GC_BUCKETS, n;
    gc_cache *p; char *s; gc_buf b = {0, 0, 0};
    static const char domain[] = "unisacc-gate-component-v1";
    for (p = gc_buckets[bucket]; p; p = p->next) if (p->node == v) return p->hex;
    s = gc_dump(v, &n); s = gc_portable(s, &n);
    gc_put(&b, domain, sizeof domain); gc_put(&b, s, n); free(s);
    p = gc_alloc(sizeof *p); p->node = v; cx_sha256_hex(b.p, b.n, p->hex); free(b.p);
    p->next = gc_buckets[bucket]; gc_buckets[bucket] = p; return p->hex;
}
void gc_stamp(const char *kind, pj_value *identity, char out[65]) {
    size_t i; pj_out quoted = {0, 0, 0}; gc_buf b = {0, 0, 0};
    static const char domain[] = "unisacc-gate-identity-v1";
    if (!kind || !*kind || !out || !identity || identity->type != PJ_ARR || (identity->len && !identity->items)) gc_fail("invalid stamp identity/kind");
    gc_put(&b, domain, sizeof domain); gc_put(&b, "[", 1);
    pj_dump_str(&quoted, kind, strlen(kind)); gc_put(&b, quoted.p, quoted.n); free(quoted.p);
    gc_put(&b, ", [", 3);
    for (i = 0; i < identity->len; i++) {
        if (i) gc_put(&b, ", ", 2);
        gc_put(&b, "\"", 1); gc_put(&b, gc_component(identity->items[i]), 64); gc_put(&b, "\"", 1);
    }
    gc_put(&b, "]]", 2); cx_sha256_hex(b.p, b.n, out); free(b.p);
}
