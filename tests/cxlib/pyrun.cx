/* pyrun.cx -- Python's subprocess.run(capture_output=True, timeout=T, cwd=C, env=dict(os.environ, K=V)), the
   values a check script prints from it (bytes repr, bytes.decode(errors='replace')), sys.executable,
   time.monotonic() and tempfile.TemporaryDirectory, as a .cx module (2026-10-23, the py->cx port wave; first users
   tests/identitynegativecheck.cx and tests/volatilecomma.cx).  Use it with `#pragma unisa use cxlib.pyrun` from a
   .cx file in tests/.
     pr_run(ARGV, CWD, ENVK, ENVV, SECS, &res, why, whylen)
         run ARGV (PATH lookup as execvp) in CWD (0: ours) with ENVK=ENVV added to our environment (ENVK 0: none);
         stdout and stderr captured separately (through unlinked temporary files, so a child's own children cannot
         hold the call open); res.rc is the returncode as Python reports it (-N for signal N).  0, or -1 with WHY
         set to the exception's last line: `FileNotFoundError: [Errno 2] No such file or directory: 'ARGV0'` (or the
         PermissionError/OSError of the failed exec, or of CWD), or `subprocess.TimeoutExpired: Command '[...]' timed
         out after SECS seconds` (the child is SIGKILLed, as Python's run() kills it).
     pr_free(&res)
     pr_repr_bytes(S, N)       repr(bytes) of S, malloc'd: b'...' with Python's quote choice and escapes
     pr_repr_strlist(V, N)     repr(list of str), malloc'd: ['a', 'b'] (str repr as rtc_pyrepr)
     pr_decode_replace(S, N, &m)  bytes.decode('utf-8', errors='replace') re-encoded as UTF-8, malloc'd (M bytes)
     pr_python(out, outlen)    sys.executable for `python3 SCRIPT` from PATH: the first executable python3 in PATH
     pr_monotonic()            time.monotonic()
     pr_tempdir(PREFIX, out, outlen)  tempfile.TemporaryDirectory(prefix=PREFIX).name: a fresh 0700 directory
                               under TMPDIR, TEMP, TMP or /tmp (the first one set), absolute; 0, or -1 with errno
     pr_rmtree(PATH)           shutil.rmtree, errors ignored (the TemporaryDirectory cleanup)
   Prelude gap: <time.h> (clock_gettime, CLOCK_MONOTONIC) is included -- cx.h edition 1 leaves time.h explicit.
   No exported objects or macros (CXIF v0). */
#pragma unisa module pyrun
#pragma unisa use runtimecopy
#include <time.h>

typedef struct pr_result { int rc; char *out; size_t outn; char *err; size_t errn; } pr_result;

double pr_monotonic(void) {
    struct timespec t;
    clock_gettime(CLOCK_MONOTONIC, &t);
    return (double)t.tv_sec + (double)t.tv_nsec / 1e9;
}

/* ---- Python text ---------------------------------------------------------------------------------------------- */
typedef struct pr_buf { char *p; size_t n, cap; } pr_buf;
static void pr_put(pr_buf *b, const char *s, size_t n) {
    if (b->n + n + 1 > b->cap) {
        size_t c = b->cap ? b->cap : 128; char *g;
        while (c < b->n + n + 1) c *= 2;
        if (!(g = realloc(b->p, c))) { fputs("MemoryError\n", stderr); exit(1); }
        b->p = g; b->cap = c;
    }
    if (n) memcpy(b->p + b->n, s, n);
    b->n += n; b->p[b->n] = 0;
}
char *pr_repr_bytes(const char *str, size_t n) {
    const unsigned char *s = (const unsigned char *)str; pr_buf b = { 0, 0, 0 }; size_t i; int sq = 0, dq = 0; char q, t[8];
    for (i = 0; i < n; i++) { if (s[i] == '\'') sq = 1; if (s[i] == '"') dq = 1; }
    q = sq && !dq ? '"' : '\'';
    pr_put(&b, "b", 1); pr_put(&b, &q, 1);
    for (i = 0; i < n; i++) {
        unsigned c = s[i];
        if (c == (unsigned char)q || c == '\\') { t[0] = '\\'; t[1] = (char)c; pr_put(&b, t, 2); }
        else if (c == '\t') pr_put(&b, "\\t", 2);
        else if (c == '\n') pr_put(&b, "\\n", 2);
        else if (c == '\r') pr_put(&b, "\\r", 2);
        else if (c < 0x20 || c >= 0x7F) { snprintf(t, sizeof t, "\\x%02x", c); pr_put(&b, t, 4); }
        else { t[0] = (char)c; pr_put(&b, t, 1); }
    }
    pr_put(&b, &q, 1);
    return b.p;
}
char *pr_repr_strlist(char *const *v, size_t n) {
    pr_buf b = { 0, 0, 0 }; size_t i;
    pr_put(&b, "[", 1);
    for (i = 0; i < n; i++) {
        size_t l = strlen(v[i]), cap = 4 * l + 8; char *r = malloc(cap);
        if (!r) { fputs("MemoryError\n", stderr); exit(1); }
        rtc_pyrepr(v[i], l, r, cap);
        if (i) pr_put(&b, ", ", 2);
        pr_put(&b, r, strlen(r)); free(r);
    }
    pr_put(&b, "]", 1);
    return b.p;
}
/* errors='replace': one U+FFFD per maximal invalid subpart (CPython's UTF-8 decoder) */
char *pr_decode_replace(const char *str, size_t n, size_t *m) {
    const unsigned char *s = (const unsigned char *)str; pr_buf b = { 0, 0, 0 }; size_t i = 0;
    pr_put(&b, "", 0);
    while (i < n) {
        unsigned c = s[i], lo = 0x80, hi = 0xBF; int need = 0, k;
        if (c < 0x80) { pr_put(&b, (const char *)s + i, 1); i++; continue; }
        if (c >= 0xC2 && c <= 0xDF) need = 1;
        else if (c >= 0xE0 && c <= 0xEF) { need = 2; if (c == 0xE0) lo = 0xA0; if (c == 0xED) hi = 0x9F; }
        else if (c >= 0xF0 && c <= 0xF4) { need = 3; if (c == 0xF0) lo = 0x90; if (c == 0xF4) hi = 0x8F; }
        if (!need) { pr_put(&b, "\xEF\xBF\xBD", 3); i++; continue; }
        for (k = 1; k <= need; k++) {
            unsigned d = i + (size_t)k < n ? s[i + k] : 0x100;
            if (k == 1 ? (d < lo || d > hi) : (d < 0x80 || d > 0xBF)) break;
        }
        if (k <= need) { pr_put(&b, "\xEF\xBF\xBD", 3); i += (size_t)k; }
        else { pr_put(&b, (const char *)s + i, (size_t)need + 1); i += (size_t)need + 1; }
    }
    *m = b.n;
    return b.p;
}

/* ---- sys.executable, tempfile ---------------------------------------------------------------------------------- */
int pr_python(char *out, size_t outlen) {
    const char *path = getenv("PATH"), *p, *e; char cand[4096], cwd[4096];
    if (!path) path = "/bin:/usr/bin";
    for (p = path; ; p = e + 1) {
        size_t l;
        e = strchr(p, ':'); if (!e) e = p + strlen(p);
        l = (size_t)(e - p);
        if (l == 0) snprintf(cand, sizeof cand, "python3");
        else snprintf(cand, sizeof cand, "%.*s/python3", (int)l, p);
        if (access(cand, X_OK) == 0) {
            struct stat st;
            if (stat(cand, &st) == 0 && S_ISREG(st.st_mode)) {
                if (cand[0] == '/') snprintf(out, outlen, "%s", cand);
                else { if (!getcwd(cwd, sizeof cwd)) return -1; snprintf(out, outlen, "%s/%s", cwd, cand); }
                return 0;
            }
        }
        if (!*e) break;
    }
    snprintf(out, outlen, "python3");
    return -1;
}
int pr_tempdir(const char *prefix, char *out, size_t outlen) {
    const char *names[3] = { "TMPDIR", "TEMP", "TMP" }, *d = 0; char tmpl[4096], cwd[4096]; int i;
    for (i = 0; i < 3 && !d; i++) { const char *v = getenv(names[i]); if (v && *v) d = v; }
    if (!d) d = "/tmp";
    if (d[0] != '/') { if (!getcwd(cwd, sizeof cwd)) return -1; snprintf(tmpl, sizeof tmpl, "%s/%s/%sXXXXXX", cwd, d, prefix); }
    else snprintf(tmpl, sizeof tmpl, "%s/%sXXXXXX", d, prefix);
    if (!mkdtemp(tmpl)) return -1;
    snprintf(out, outlen, "%s", tmpl);
    return 0;
}
void pr_rmtree(const char *d) {
    DIR *dp = opendir(d); struct dirent *e; char p[8192]; struct stat st;
    if (dp) {
        while ((e = readdir(dp))) {
            if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
            snprintf(p, sizeof p, "%s/%s", d, e->d_name);
            if (lstat(p, &st) == 0 && S_ISDIR(st.st_mode)) pr_rmtree(p); else unlink(p);
        }
        closedir(dp);
    }
    rmdir(d);
}

/* ---- subprocess.run ------------------------------------------------------------------------------------------- */
static int pr_tmpfile(void) {
    char t[4096]; const char *d = getenv("TMPDIR"); int fd;
    snprintf(t, sizeof t, "%s/pyrunXXXXXX", d && *d ? d : "/tmp");
    fd = mkstemp(t);
    if (fd >= 0) unlink(t);
    return fd;
}
static char *pr_slurp_fd(int fd, size_t *n) {
    pr_buf b = { 0, 0, 0 }; char t[65536]; ssize_t k;
    pr_put(&b, "", 0);
    lseek(fd, 0, SEEK_SET);
    while ((k = read(fd, t, sizeof t)) > 0) pr_put(&b, t, (size_t)k);
    *n = b.n;
    return b.p;
}
void pr_free(pr_result *r) { free(r->out); free(r->err); r->out = r->err = 0; r->outn = r->errn = 0; }
int pr_run(char *const argv[], const char *cwd, const char *envk, const char *envv, double secs, pr_result *res,
           char *why, size_t whylen) {
    int of = pr_tmpfile(), ef = pr_tmpfile(), pfd[2], st = 0, err[2] = { 0, 0 };
    pid_t pid; ssize_t k; double deadline;
    res->rc = 0; res->out = res->err = 0; res->outn = res->errn = 0;
    if (of < 0 || ef < 0 || pipe(pfd) != 0) { snprintf(why, whylen, "OSError: cannot capture output"); return -1; }
    fcntl(pfd[1], F_SETFD, FD_CLOEXEC);
    deadline = pr_monotonic() + secs;
    pid = fork();
    if (pid < 0) { snprintf(why, whylen, "OSError: fork failed"); return -1; }
    if (pid == 0) {
        int fd = open("/dev/null", O_RDONLY);
        close(pfd[0]);
        if (fd >= 0) { dup2(fd, 0); close(fd); }
        dup2(of, 1); dup2(ef, 2); close(of); close(ef);
        if (envk) setenv(envk, envv, 1);
        if (cwd && chdir(cwd) != 0) { err[0] = 1; err[1] = errno; k = write(pfd[1], err, sizeof err); _exit(255); }
        execvp(argv[0], argv);
        err[0] = 2; err[1] = errno; k = write(pfd[1], err, sizeof err); (void)k;
        _exit(255);
    }
    close(pfd[1]);
    k = read(pfd[0], err, sizeof err);
    close(pfd[0]);
    if (k == (ssize_t)sizeof err) {
        waitpid(pid, &st, 0); close(of); close(ef);
        rtc_oserror(err[1], err[0] == 1 ? cwd : argv[0], why, whylen);
        return -1;
    }
    for (;;) {
        pid_t w = waitpid(pid, &st, WNOHANG);
        if (w == pid) break;
        if (w < 0) { close(of); close(ef); snprintf(why, whylen, "ChildProcessError: wait failed"); return -1; }
        if (pr_monotonic() >= deadline) {
            size_t n = 0; char *l;
            kill(pid, SIGKILL); waitpid(pid, &st, 0); close(of); close(ef);
            for (n = 0; argv[n]; n++) ;
            l = pr_repr_strlist(argv, n);
            if (secs == (double)(long)secs) snprintf(why, whylen, "subprocess.TimeoutExpired: Command '%s' timed out after %ld seconds", l, (long)secs);
            else snprintf(why, whylen, "subprocess.TimeoutExpired: Command '%s' timed out after %g seconds", l, secs);
            free(l);
            return -1;
        }
        usleep(1000);
    }
    res->rc = WIFSIGNALED(st) ? -WTERMSIG(st) : WEXITSTATUS(st);
    res->out = pr_slurp_fd(of, &res->outn); res->err = pr_slurp_fd(ef, &res->errn);
    close(of); close(ef);
    return 0;
}
