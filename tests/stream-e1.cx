/* Independent E1 stream oracle (UNIPP1/pp -> USLATTR1+UNITOK1).
 * ROOT STREAM_DIR NEW_OUTDIR; Linux/x86_64 only. Uses stream2.com from prepared
 * seven-stream material; inputs are hand-built UNIPP1 (no live E2 coupling).
 * Finite oracle; full lex gold table remains separate. */
#pragma unisa use cxlib.netpack
static char root[4096],streams[4096],work[4096],bound[4200],inc[4200],product[4200],e1bin[4200];
static char e1_id[65],product_before[65],product_after[65];
static const char *e1_pin="b240db07a6607a03b745165fa3a993d20195db568bc0bd907506ff109ea64f3b";
static int assertions,failures;
static void die(const char *s){fprintf(stderr,"stream-e1: %s\n",s);exit(2);}
static void check(int ok,const char *s){assertions++;if(!ok)failures++;printf("%s\t%s\n",ok?"PASS":"FAIL",s);}
static void path(char *out,size_t cap,const char *dir,const char *name){int n=snprintf(out,cap,"%s/%s",dir,name);if(n<0||(size_t)n>=cap)die("path");}
static void saved(const char *p,const void *s,size_t n){int f=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC,0600);size_t at=0;if(f<0)die("exclusive-create");while(at<n){ssize_t k=write(f,(char *)s+at,n-at);if(k<0&&errno==EINTR)continue;if(k<=0)die("write");at+=(size_t)k;}if(close(f))die("close");}
static char *loaded(const char *p,size_t *n){char *s=cx_read(p,n);if(!s)die(p);return s;}
static void digest(const char *p,char *hex){size_t n;char *s=loaded(p,&n);cx_sha256_hex(s,n,hex);free(s);}
static unsigned little(const unsigned char *p){return (unsigned)p[0]|(unsigned)p[1]<<8|(unsigned)p[2]<<16|(unsigned)p[3]<<24;}
static void write_unipp1(const char *leaf,const char *body){
 unsigned char hdr[27];size_t bn=strlen(body);unsigned len=(unsigned)bn;int i;
 if(bn>65535)die("pp-body-bound");memcpy(hdr,"UNIPP1",6);hdr[6]=0;
 hdr[7]=(unsigned char)(len);hdr[8]=(unsigned char)(len>>8);hdr[9]=(unsigned char)(len>>16);hdr[10]=(unsigned char)(len>>24);
 for(i=11;i<27;i++)hdr[i]=0;
 char p[4200];path(p,sizeof p,work,leaf);{unsigned char *all=malloc(27+bn);if(!all)die("alloc");memcpy(all,hdr,27);memcpy(all+27,body,bn);saved(p,all,27+bn);free(all);}}
static int uslattr1(const unsigned char *b,size_t n,unsigned *count,const unsigned char **pay,size_t *pn){
 unsigned plen;if(n<16||memcmp(b,"USLATTR1",8))return 0;*count=little(b+8);plen=little(b+12);
 if(16+(size_t)(*count)*5+(size_t)plen!=n)return 0;*pay=b+16+(size_t)(*count)*5;*pn=plen;return 1;}
/* UNITOK1 carries an exact UNIPP1 echo of length tn; token positions follow. */
static int unitok1(const unsigned char *pay,size_t pn,const char *src_body){
 unsigned tn;size_t sn=strlen(src_body);const unsigned char *echo;
 if(pn<12||memcmp(pay,"UNITOK1\0",8))return 0;tn=little(pay+8);
 if(tn!=27+sn||12+(size_t)tn>pn)return 0;echo=pay+12;
 if(memcmp(echo,"UNIPP1\0",7)||little(echo+7)!=sn)return 0;
 for(size_t i=11;i<27;i++)if(echo[i])return 0;
 return !memcmp(echo+27,src_body,sn);}
static np_result invoke(const char *input_leaf,const char *evidence_leaf){
 char src[4200],outp[4400],errp[4400],label[4200];int z;path(src,sizeof src,work,input_leaf);
 path(label,sizeof label,work,"label.c");/* logical source name for diagnostics */
 z=snprintf(outp,sizeof outp,"%s/%s.stdout",work,evidence_leaf);if(z<0||(size_t)z>=sizeof outp)die("stdout-path");
 z=snprintf(errp,sizeof errp,"%s/%s.stderr",work,evidence_leaf);if(z<0||(size_t)z>=sizeof errp)die("stderr-path");
 {struct stat st;if(lstat(label,&st)){if(errno!=ENOENT)die("label-stat");const char *s="int main(void){return 0;}\n";saved(label,s,strlen(s));}else if(!S_ISREG(st.st_mode))die("label-regular");}
 char *v[]={bound,"12",e1bin,src,label,inc,0};np_result r;char why[1024];
 const char *env[]={"UNISA_ATTRIBUTES=","UNISA_MAXSTEPS=200000000",0};
 if(np_run(v,root,env,14,&r,why,sizeof why))die(why);
 saved(outp,r.out,r.outn);saved(errp,r.err,r.errn);return r;}
static void positive(const char *name,const char *body){
 char t[160];unsigned count=0;const unsigned char *pay=0;size_t pn=0;
 write_unipp1(name,body);np_result r=invoke(name,name);
 snprintf(t,sizeof t,"%s.accept-rc0-empty-stderr",name);check(!r.rc&&!r.errn,t);
 snprintf(t,sizeof t,"%s.uslattr1-frame",name);check(uslattr1((unsigned char *)r.out,r.outn,&count,&pay,&pn)&&count==0,t);
 snprintf(t,sizeof t,"%s.unitok1-embeds-source",name);check(pay&&unitok1(pay,pn,body),t);
 np_free(&r);}
static void refuse(const char *name,const void *bytes,size_t n,const char *needle){
 char sp[4200],t[160];path(sp,sizeof sp,work,name);saved(sp,bytes,n);
 np_result r=invoke(name,name);
 snprintf(t,sizeof t,"%s.reject-nonzero-rc",name);check(!!r.rc,t);
 snprintf(t,sizeof t,"%s.reject-empty-stdout",name);check(!r.outn,t);
 snprintf(t,sizeof t,"%s.reject-named-oracle",name);check(r.errn&&strstr(r.err,needle),t);
 np_free(&r);}
int main(int argc,char **argv){
 if(argc!=4){fputs("usage: ROOT STREAM_DIR NEW_OUTDIR\n",stderr);return 2;}
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("UNVERIFIED: stream-e1 requires Linux/x86_64\n",stderr);return 77;
#endif
 if(!realpath(argv[1],root)||!realpath(argv[2],streams))die("resolve");
 if(argv[3][0]!='/'||strlen(argv[3])>=sizeof work)die("absolute-new-outdir");strcpy(work,argv[3]);
 if(mkdir(work,0700))die("new-outdir-must-be-absent");
 path(bound,sizeof bound,root,"tools/bound");path(inc,sizeof inc,root,"include");
 path(product,sizeof product,root,"unisacc.com");path(e1bin,sizeof e1bin,streams,"unisacc-stream2.com");
 digest(product,product_before);digest(e1bin,e1_id);
 if(strcmp(e1_id,e1_pin))die("material.stream2-identity");check(1,"material.stream2-identity");
 positive("plain.pp","int main(void){return 0;}\n");
 positive("intlit.pp","int x=42;\n");
 positive("spaces.pp","int   z;\n");
 {const char *needle="malformed preprocessing locations";
  refuse("bad-magic.pp","BADMAGIC",8,needle);
  refuse("empty.pp","",0,needle);
  {unsigned char trunc[10];memcpy(trunc,"UNIPP1",6);trunc[6]=0;trunc[7]=1;trunc[8]=0;trunc[9]=0;refuse("trunc.pp",trunc,10,needle);}
  {const char *body="int x;\n";unsigned char bad[40];unsigned lie=(unsigned)strlen(body)+5;int i;
   memcpy(bad,"UNIPP1",6);bad[6]=0;bad[7]=(unsigned char)lie;bad[8]=bad[9]=bad[10]=0;for(i=11;i<27;i++)bad[i]=0;
   memcpy(bad+27,body,strlen(body));refuse("bad-len.pp",bad,27+strlen(body),needle);}}
 {char a[4200],why[1024];path(a,sizeof a,work,"plain.pp");char lab[4200];path(lab,sizeof lab,work,"label.c");
  char *cmd[]={bound,"12",e1bin,a,lab,inc,0};const char *env[]={"UNISA_ATTRIBUTES=","UNISA_MAXSTEPS=200000000",0};
  np_result r1,r2;if(np_run(cmd,root,env,14,&r1,why,sizeof why)||np_run(cmd,root,env,14,&r2,why,sizeof why))die(why);
  check(r1.outn==r2.outn&&r1.outn&&!memcmp(r1.out,r2.out,r1.outn),"replay.stdout-stable");
  np_free(&r1);np_free(&r2);}
 digest(product,product_after);check(!strcmp(product_before,product_after),"root-product-stable");
 digest(e1bin,e1_id);check(!strcmp(e1_id,e1_pin),"material.stream2-stable");
 printf("STREAM_E1\tassertions=%d\tfailed=%d\tscope=independent-e1-io-and-named-refusal-linux-x86_64\n",assertions,failures);
 puts("NOT_CLAIMED\tseven-stream-chain-full-lex-gold-table-attribute-sidecar-six-host-or-streamseal-shape");
 return failures?1:0;}
