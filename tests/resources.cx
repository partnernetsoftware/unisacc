/* Product-facing ResourceInput/strict-ledger batch. No shell command strings,
 * legacy runner, Python, or saved PASS. Each fixture is a private generation.
 * ROOT ABS_NEW_OUT [APE_OR_NATIVE_ELF] [--trace|--multi|--trace-output]. Each mode is its own
 * <=55-second batch; --trace/--multi do not replace the original SC1 obligations. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use sys.env
static char root[4096],work[4096],product[4400],bound[4400],src[4400],capdir[4400],container[4400];
static int native_driver;static const char *second_ledger;
static int assertions,failures;static char *ledger;static size_t ledger_n;
static void die(const char *s){fprintf(stderr,"resources: %s\n",s);exit(2);}
static void path(char *p,size_t cap,const char *a,const char *b){int n=snprintf(p,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path bound");}
static char *load(const char *p,size_t *n){char *s=cx_read(p,n);if(!s)die(p);return s;}
static void save(const char *p,const char *s,size_t n){int f=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC,0600);if(f<0)die("exclusive fixture");while(n){ssize_t k=write(f,s,n);if(k<0&&errno==EINTR)continue;if(k<=0)die("fixture write");s+=k;n-=(size_t)k;}if(close(f))die("fixture close");}
static void ck(int ok,const char *s){assertions++;if(!ok)failures++;printf("%s\tresources.%s\n",ok?"PASS":"FAIL",s);}
static void digest(const char *p,char *h){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static np_result invoke(const char *dir,const char *cwd,const char *capture,const char *name){char env[4600],err[1024],p[4400];snprintf(env,sizeof env,"UNISACC_RF_CAPTURE=%s",capture?capture:"");const char *adds[]={env,0};char *v[20];int n=0;v[n++]=bound;v[n++]="8";if(!native_driver)v[n++]="sh";v[n++]=product;if(native_driver){v[n++]="--models";v[n++]=container;}if(dir){v[n++]="--strict-resource-flow";v[n++]="--resource-ledger";v[n++]=(char *)dir;if(second_ledger){v[n++]="--resource-ledger";v[n++]=(char *)second_ledger;}}v[n++]="-O0";v[n++]="-b";v[n++]="lnx/x86_64";v[n++]="-S";v[n++]=src;v[n++]="-o";v[n++]="-";v[n]=0;np_result r;if(np_run(v,cwd,capture?adds:0,10,&r,err,sizeof err))die(err);char file[120];snprintf(file,sizeof file,"%s.stdout",name);path(p,sizeof p,work,file);save(p,r.out,r.outn);snprintf(file,sizeof file,"%s.stderr",name);path(p,sizeof p,work,file);save(p,r.err,r.errn);return r;}
static void material(const char *name,const char *table,size_t n,char *out){path(out,4400,work,name);if(mkdir(out,0700))die("fixture directory");DIR *d=opendir(capdir);struct dirent *e;if(!d)die("capture directory");while((e=readdir(d))){if(tx_eqz(e->d_name, ".")||tx_eqz(e->d_name, "..")||tx_eqz(e->d_name, "resources.tsv"))continue;char p[4400],q[4400];size_t z;path(p,sizeof p,capdir,e->d_name);path(q,sizeof q,out,e->d_name);char *b=load(p,&z);save(q,b,z);free(b);}if(closedir(d))die("closedir");char p[4400];path(p,sizeof p,out,"resources.tsv");save(p,table,n);}
static void refuse(const char *name,const char *table,size_t n,const char *reason){char dir[4400];material(name,table,n,dir);np_result r=invoke(dir,root,0,name);int ok=r.rc==2&&!r.outn&&strstr(r.err,reason);ck(ok,name);if(!ok)fprintf(stderr,"resources %s actual rc=%d stderr=%.*s\n",name,r.rc,(int)r.errn,r.err);np_free(&r);}
static void appended(const char *name,const char *row,size_t n,const char *reason){np_buf b={0};np_put(&b,ledger,ledger_n);np_put(&b,row,n);refuse(name,b.p,b.n,reason);free(b.p);}
static void positive_blob(const char *name,const char *bytes,size_t n){char hash[65],row[256],dir[4400],p[4400];cx_sha256_hex(bytes,n,hash);int k=snprintf(row,sizeof row,"ff\t1\tbinary.dat\t%lu\t%s\n",(unsigned long)n,hash);np_buf b={0};np_put(&b,ledger,ledger_n);np_put(&b,row,(size_t)k);material(name,b.p,b.n,dir);free(b.p);path(p,sizeof p,dir,"binary.dat");save(p,bytes,n);np_result r=invoke(dir,root,0,name);path(p,sizeof p,work,"normal.stdout");size_t wanted_n;char *wanted=load(p,&wanted_n);ck(r.rc==0&&!r.errn&&r.outn==wanted_n&&!memcmp(r.out,wanted,wanted_n),name);free(wanted);np_free(&r);}
static void repeated(void){char first[4400],bad[4400],p[4400];char *changed=malloc(ledger_n+1);if(!changed)die("repeat allocation");memcpy(changed,ledger,ledger_n);changed[ledger_n]=0;char *stage=strstr(changed,"stage=e3:");if(!stage)die("repeat stage");stage[7]='2';material("repeat-first",changed,ledger_n,first);free(changed);second_ledger=capdir;np_result r=invoke(first,root,0,"repeat-last-wins");second_ledger=0;path(p,sizeof p,work,"normal.stdout");size_t z;char *want=load(p,&z);ck(r.rc==0&&!r.errn&&r.outn==z&&!memcmp(r.out,want,z),"repeat-last-wins");free(want);np_free(&r);np_buf b={0};np_put(&b,ledger,ledger_n);const char row[]="ff\t0\t-\t0\t-\0hidden\n";np_put(&b,row,sizeof row-1);material("repeat-bad-second",b.p,b.n,bad);free(b.p);second_ledger=bad;r=invoke(capdir,root,0,"repeat-second-refused");second_ledger=0;ck(r.rc==2&&!r.outn&&strstr(r.err,"resource-row-nul"),"repeat-second-refused");np_free(&r);}
static void additional(void){const char *empty_hash="e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";char row[256];const char zero[1]={0};positive_blob("present-empty",zero,0);positive_blob("present-nul-byte",zero,1);int n=snprintf(row,sizeof row,"ff\t1\tabsent.dat\t0\t%s\n",empty_hash);appended("missing-blob",row,(size_t)n,"resource-bytes-absent");n=snprintf(row,sizeof row,"ff\t1\t../escape\t0\t%s\n",empty_hash);appended("blob-path-escape",row,(size_t)n,"resource-blob-malformed");
 char *at=strstr(ledger,"00636c692f746172676574\t");if(!at||at==ledger||at[-1]!='\n')die("unique requested target row");char *end=memchr(at,'\n',ledger_n-(size_t)(at-ledger));if(!end)die("target row extent");np_buf missing={0};np_put(&missing,ledger,(size_t)(at-ledger));np_put(&missing,end+1,ledger_n-(size_t)(end+1-ledger));refuse("missing-requested-key",missing.p,missing.n,"MISSING_EXPLICIT_RESOURCE 00636c692f746172676574");free(missing.p);
}
/* SC2 is an ordered trace. A SC1 conversion is legal only if every reply for
 * a repeated key has the same presence, length and actual bytes. */
typedef struct {char *key,*bytes;size_t n;int present;} CanonRow;
static int canonical(const char *dir,const char *trace,size_t n,np_buf *map){
 if(n<6||memcmp(trace,"#SC2\t",5)||memchr(trace,0,n))die("SC2 canonical input");
 const char *end=memchr(trace,'\n',n);if(!end)die("SC2 canonical identity");size_t at=(size_t)(end-trace)+1;np_put(map,trace,at);map->p[3]='1';
 CanonRow *rows=calloc(4096,sizeof *rows);if(!rows)die("canonical allocation");int count=0,ok=1;
 while(at<n){size_t next=at;while(next<n&&trace[next]!='\n')next++;if(next==n)die("canonical truncated row");char *line=malloc(next-at+1);if(!line)die("canonical line");memcpy(line,trace+at,next-at);line[next-at]=0;char *fields[5];fields[0]=line;
  for(int k=1;k<5;k++){char *tab=strchr(fields[k-1],'\t');if(!tab)die("canonical fields");*tab=0;fields[k]=tab+1;}if(strchr(fields[4],'\t'))die("canonical fields");
  size_t keylen=strlen(fields[0]);if(!keylen||(keylen&1)||keylen>1024)die("canonical key");for(size_t q=0;q<keylen;q++){char c=fields[0][q];if(c>='A'&&c<='F')c=(char)(c-'A'+'a');if(!((c>='0'&&c<='9')||(c>='a'&&c<='f')))die("canonical key hex");fields[0][q]=c;}
  int present=!strcmp(fields[1],"1");if(!present&&!tx_eqz(fields[1], "0"))die("canonical presence");char *value=0;size_t length=0;
  if(present){char p[4400],hash[65],*tail;errno=0;unsigned long declared=strtoul(fields[3],&tail,10);if(errno||!*fields[3]||*tail)die("canonical length");path(p,sizeof p,dir,fields[2]);value=load(p,&length);cx_sha256_hex(value,length,hash);if(declared!=length||!tx_eqz(hash, fields[4]))die("canonical bytes identity");}
  else if(!tx_eqz(fields[2], "-")||!tx_eqz(fields[3], "0")||!tx_eqz(fields[4], "-"))die("canonical absent");
  int found=-1;for(int k=0;k<count;k++)if(tx_eqz(rows[k].key, fields[0])){found=k;break;}
  if(found>=0){CanonRow *old=&rows[found];if(old->present!=present||old->n!=length||(present&&length&&memcmp(old->bytes,value,length))){ok=0;free(value);free(line);break;}free(value);}
  else{if(count==4096)die("canonical quota");rows[count].key=strdup(fields[0]);if(!rows[count].key)die("canonical key");rows[count].bytes=value;rows[count].n=length;rows[count].present=present;count++;np_put(map,trace+at,next-at+1);}
  free(line);at=next+1;
 }
 for(int k=0;k<count;k++){free(rows[k].key);free(rows[k].bytes);}free(rows);return ok;
}
static void canonical_controls(const char *trace,size_t n){
 const char *header=memchr(trace,'\n',n);if(!header)die("canonical control header");size_t at=(size_t)(header-trace)+1,start=0,end=0,keyn=0;
 while(at<n){size_t next=at;while(next<n&&trace[next]!='\n')next++;const char *tab=memchr(trace+at,'\t',next-at);if(!tab||next==n)die("canonical control row");if(tab+2<trace+next&&tab[1]=='1'&&tab[2]=='\t'){start=at;end=next+1;keyn=(size_t)(tab-(trace+at));break;}at=next+1;}
 if(!end)die("canonical control present row");np_buf input={0},map={0},base={0};if(!canonical(capdir,trace,n,&base))die("canonical baseline changes answers");np_put(&input,trace,n);np_put(&input,trace+start,end-start);int ok=canonical(capdir,input.p,input.n,&map);ck(ok&&map.n==base.n&&!memcmp(map.p,base.p,base.n),"canonical-identical-repeat-deduplicates");free(input.p);free(map.p);input=(np_buf){0};map=(np_buf){0};np_put(&input,trace,n);np_put(&input,trace+start,keyn);np_puts(&input,"\t0\t-\t0\t-\n");ok=canonical(capdir,input.p,input.n,&map);ck(!ok,"canonical-changed-presence-refused");free(input.p);free(map.p);free(base.p);
}
static int command_prefix(char **v,int seconds){int n=0;v[n++]=bound;v[n++]=seconds==12?"12":"8";if(!native_driver)v[n++]="sh";v[n++]=product;if(native_driver){v[n++]="--models";v[n++]=container;}return n;}
static np_result command(char **v,const char *cwd,const char *capture,int seconds,const char *name){char env[4600],why[1024],p[4400],file[140];snprintf(env,sizeof env,"UNISACC_RF_CAPTURE=%s",capture?capture:"");const char *adds[]={env,"UNISA_JOBS=1",0};np_result r;if(np_run(v,cwd,adds,seconds+2,&r,why,sizeof why))die(why);snprintf(file,sizeof file,"%s.stdout",name);path(p,sizeof p,work,file);save(p,r.out,r.outn);snprintf(file,sizeof file,"%s.stderr",name);path(p,sizeof p,work,file);save(p,r.err,r.errn);return r;}
static int transcript_same(np_result *r,const char *name){char p[4400];size_t n;path(p,sizeof p,work,"normal.stdout");char *want=load(p,&n);int ok=r->rc==0&&!r->errn&&r->outn==n&&!memcmp(r->out,want,n);ck(ok,name);if(!ok&&r->errn)fwrite(r->err,1,r->errn,stderr);free(want);return ok;}
static void trace_batch(const char *trace,size_t n){
 const char *e=memchr(trace,'\n',n);if(!e)die("trace identity");size_t h=(size_t)(e-trace)+1,a=h,ae=a;while(ae<n&&trace[ae]!='\n')ae++;if(ae==n)die("trace first event");ae++;const char *tab=memchr(trace+a,'\t',ae-a);if(!tab)die("trace key");size_t keyn=(size_t)(tab-(trace+a)),b=ae,be=b;
 while(b<n){be=b;while(be<n&&trace[be]!='\n')be++;if(be==n)die("trace event extent");be++;const char *bt=memchr(trace+b,'\t',be-b);if(!bt)die("trace event key");if((size_t)(bt-(trace+b))!=keyn||memcmp(trace+a,trace+b,keyn))break;b=be;}if(b==n)die("trace needs two distinct keys");
 np_buf swapped={0};np_put(&swapped,trace,h);np_put(&swapped,trace+b,be-b);np_put(&swapped,trace+ae,b-ae);np_put(&swapped,trace+a,ae-a);np_put(&swapped,trace+be,n-be);refuse("trace-wrong-order",swapped.p,swapped.n,"resource-trace-key-mismatch");free(swapped.p);
 size_t last=n-1;while(last>h&&trace[last-1]!='\n')last--;refuse("trace-tail-missing",trace,last,"MISSING_EXPLICIT_RESOURCE");np_buf extra={0};np_put(&extra,trace,n);np_puts(&extra,"ff\t0\t-\t0\t-\n");refuse("trace-unconsumed",extra.p,extra.n,"resource-trace-unconsumed");free(extra.p);
 char recap[4400],p[4400];path(recap,sizeof recap,work,"strict-recapture");np_result r=invoke(capdir,root,recap,"trace-strict-capture");transcript_same(&r,"trace-strict-capture-preserves-bytes");np_free(&r);size_t z;path(p,sizeof p,recap,"resources.tsv");char *again=load(p,&z);ck(z==n&&!memcmp(again,trace,n),"trace-strict-capture-same-events");free(again);r=invoke(recap,root,0,"trace-recaptured-replay");transcript_same(&r,"trace-recaptured-replay");np_free(&r);
 const char *flags[]={"--version","-cx-plan"};for(int i=0;i<2;i++){char *v[16],name[80];int vn=command_prefix(v,8);v[vn++]="--strict-resource-flow";v[vn++]="--resource-ledger";v[vn++]=capdir;v[vn++]=(char *)flags[i];if(i)v[vn++]=src;v[vn]=0;snprintf(name,sizeof name,"trace-metadata-%s",i?"plan":"version");r=command(v,root,0,8,name);ck(r.rc==2&&!r.outn&&r.errn&&strstr(r.err,"resource-trace-not-started"),name);np_free(&r);}
 canonical_controls(trace,n);
}
static np_result multi_invoke(const char *a,const char *b,const char *dir,const char *capture,const char *name){char *v[24];int n=command_prefix(v,12);if(dir){v[n++]="--strict-resource-flow";v[n++]="--resource-ledger";v[n++]=(char *)dir;}v[n++]="-O0";v[n++]="-b";v[n++]="lnx/x86_64";v[n++]="-S";v[n++]=(char *)a;v[n++]=(char *)b;v[n++]="-o";v[n++]="-";v[n]=0;return command(v,root,capture,12,name);}
/* ri.capture.parallel-jobs: capture or strict multi-source with UNISA_JOBS=2 is refused by name, with no stdout and no capture written */
static int jobs2_refused(const char *a,const char *b,const char *dir,const char *capture){char *v[24],env[4600],why[1024];int n=command_prefix(v,12);if(dir){v[n++]="--strict-resource-flow";v[n++]="--resource-ledger";v[n++]=(char *)dir;}v[n++]="-O0";v[n++]="-b";v[n++]="lnx/x86_64";v[n++]="-S";v[n++]=(char *)a;v[n++]=(char *)b;v[n++]="-o";v[n++]="-";v[n]=0;
 if(cx_fmt(env,sizeof env,"UNISACC_RF_CAPTURE=%s",capture?capture:""))die("capture env");const char *adds[]={"UNISA_JOBS=2",env,0};
 np_result r;if(np_run(v,root,adds,14,&r,why,sizeof why))die(why);const char *reason="INTERFACE_ERROR resource-capture-parallel-unsupported UNISA_JOBS=2 ";
 int ok=r.rc==2&&!r.outn&&tx_find(r.err,(long)r.errn,reason,tx_len(reason,256))>=0;sy_stat_t s;if(capture)ok=ok&&sy_lstat(capture,&s)==-ENOENT;np_free(&r);return ok;}
static void multi_batch(void){
 char a[4400],b[4400],p[4400],tape[4400],image[4400];path(a,sizeof a,work,"a.cx");path(b,sizeof b,work,"b.c");const char *aa="int helper(void){return 3;}\n",*bb="int helper(void); int main(void){return helper()+4;}\n";save(a,aa,strlen(aa));save(b,bb,strlen(bb));path(capdir,sizeof capdir,work,"multi-capture");np_result normal=multi_invoke(a,b,0,0,"multi-normal");np_result captured=multi_invoke(a,b,0,capdir,"multi-capture");np_result replay=multi_invoke(a,b,capdir,0,"multi-replay");ck(normal.rc==0&&!normal.errn&&normal.outn>0,"multi-default-accept");ck(captured.rc==0&&!captured.errn&&captured.outn==normal.outn&&normal.outn>0&&!memcmp(captured.out,normal.out,normal.outn),"multi-capture-preserves-bytes");ck(replay.rc==0&&!replay.errn&&replay.outn==captured.outn&&captured.outn>0&&!memcmp(replay.out,captured.out,captured.outn),"multi-trace-replay-exact-bytes");if(replay.errn)fwrite(replay.err,1,replay.errn,stderr);
 size_t n;path(p,sizeof p,capdir,"resources.tsv");char *trace=load(p,&n);ck(n>5&&!memcmp(trace,"#SC2\t",5),"multi-SC2-identity");np_buf map={0};ck(!canonical(capdir,trace,n,&map),"multi-changed-reply-cannot-be-SC1-map");free(map.p);free(trace);
 if(captured.rc==0&&captured.outn){path(tape,sizeof tape,work,"multi.tape");save(tape,captured.out,captured.outn);path(image,sizeof image,work,"multi.elf");char *v[16];int vn=command_prefix(v,12);v[vn++]="-b";v[vn++]="lnx/x86_64";v[vn++]=tape;v[vn++]="-o";v[vn++]=image;v[vn]=0;np_result built=command(v,root,0,12,"multi-tape-image");int ok=built.rc==0&&!built.outn&&!built.errn;ck(ok,"multi-tape-image-accept");if(built.errn)fwrite(built.err,1,built.errn,stderr);np_free(&built);if(ok){char *run[]={bound,"3",image,0};np_result ran=command(run,root,0,3,"multi-execute");ck(ran.rc==7&&!ran.outn&&!ran.errn,"multi-independent-return7");np_free(&ran);}}
 {char cap2[4400];path(cap2,sizeof cap2,work,"multi-capture-jobs2");ck(jobs2_refused(a,b,0,cap2),"multi-capture-jobs2-refused");ck(jobs2_refused(a,b,capdir,0),"multi-strict-jobs2-refused");}
 np_free(&normal);np_free(&captured);np_free(&replay);
}
static int output_absent(const char *p){struct stat st;errno=0;if(!lstat(p,&st))return 0;if(errno!=ENOENT)die("output existence check");return 1;}
static np_result symbol_invoke(const char *dir,const char *capture,const char *symbols,const char *output,const char *name){char *v[24];int n=command_prefix(v,8);if(dir){v[n++]="--strict-resource-flow";v[n++]="--resource-ledger";v[n++]=(char *)dir;}v[n++]="-O0";v[n++]="-b";v[n++]="lnx/x86_64";v[n++]="-S";v[n++]=src;v[n++]="--emit-host-symbols";v[n++]=(char *)symbols;v[n++]="-o";v[n++]=(char *)output;v[n]=0;return command(v,root,capture,8,name);}
static void trace_output_batch(void){
 char symbols[4400],replayed_symbols[4400],denied_symbols[4400],denied_output[4400],p[4400],bad[4400],mapdir[4400];path(capdir,sizeof capdir,work,"output-capture");path(symbols,sizeof symbols,work,"capture.symbols");path(replayed_symbols,sizeof replayed_symbols,work,"replay.symbols");path(denied_symbols,sizeof denied_symbols,work,"unconsumed.symbols");path(denied_output,sizeof denied_output,work,"unconsumed.tape");
 /* Capture the symbol-stream execution too: it may have its own fetches.
  * A trace made without that stage would not isolate the final surplus check. */
 np_result captured=symbol_invoke(0,capdir,symbols,"-","output-capture");int valid=captured.rc==0&&!captured.errn&&captured.outn>0;ck(valid,"output-capture-with-symbols-accept");if(captured.errn)fwrite(captured.err,1,captured.errn,stderr);if(!valid){np_free(&captured);return;}
 size_t sn,tn;char *sym=load(symbols,&sn);/* Output contract: research/c43-late-binding-step0.md, empty Linux program requirements. */static const unsigned char gold[12]={'U','N','I','S','Y','M','1','\n',1,0,0,0};ck(sn==sizeof gold&&!memcmp(sym,gold,sizeof gold),"output-capture-symbol-bytes-header");path(p,sizeof p,capdir,"resources.tsv");char *trace=load(p,&tn);ck(tn>5&&!memcmp(trace,"#SC2\t",5),"output-capture-SC2");
 np_result replay=symbol_invoke(capdir,0,replayed_symbols,"-","output-valid-replay");valid=replay.rc==0&&!replay.errn&&replay.outn==captured.outn&&!memcmp(replay.out,captured.out,captured.outn);ck(valid,"output-valid-trace-replay-bytes");if(replay.errn)fwrite(replay.err,1,replay.errn,stderr);np_free(&replay);if(!valid){free(sym);free(trace);np_free(&captured);return;}size_t rn;char *rs=load(replayed_symbols,&rn);ck(rn==sn&&!memcmp(rs,sym,sn),"output-valid-replay-symbol-bytes");free(rs);free(sym);np_free(&captured);
 np_buf extra={0};np_put(&extra,trace,tn);np_puts(&extra,"ff\t0\t-\t0\t-\n");material("output-extra-event",extra.p,extra.n,bad);free(extra.p);replay=symbol_invoke(bad,0,denied_symbols,denied_output,"output-surplus-refused");ck(replay.rc==2&&!replay.outn&&replay.errn&&strstr(replay.err,"resource-trace-unconsumed"),"output-surplus-refused-before-output");np_free(&replay);ck(output_absent(denied_symbols),"output-surplus-no-symbol-sidefile");ck(output_absent(denied_output),"output-surplus-no-primary-file");
 np_buf map={0};int consistent=canonical(capdir,trace,tn,&map);ck(consistent,"output-SC1-map-consistent");if(!consistent)die("symbol trace cannot be a SC1 map");material("output-SC1-map",map.p,map.n,mapdir);free(map.p);free(trace);
 const char *flags[]={"--version","--help"};for(int i=0;i<2;i++){np_result results[2];for(int strict=0;strict<2;strict++){char *v[16],name[100];int n=command_prefix(v,8);if(strict){v[n++]="--strict-resource-flow";v[n++]="--resource-ledger";v[n++]=mapdir;}v[n++]=(char *)flags[i];v[n]=0;snprintf(name,sizeof name,"output-SC1-%s-%s",i?"help":"version",strict?"strict":"plain");results[strict]=command(v,root,0,8,name);}np_result *a=&results[0],*b=&results[1];char name[100];snprintf(name,sizeof name,"output-plain-%s-accept",i?"help":"version");ck(a->rc==0&&!a->errn&&a->outn>0,name);snprintf(name,sizeof name,"output-SC1-%s-compatible",i?"help":"version");ck(b->rc==0&&!b->errn&&a->rc==0&&a->outn>0&&a->outn==b->outn&&!memcmp(a->out,b->out,a->outn),name);np_free(a);np_free(b);}
 /* Both flag orders normalize to run mode; -c/-S with an explicit target
  * normalizes to object mode. Neither is the supported trace tape route. */
 for(int kind=0;kind<3;kind++){char *v[24],name[100];int n=command_prefix(v,8);v[n++]="--strict-resource-flow";v[n++]="--resource-ledger";v[n++]=capdir;v[n++]="-O0";v[n++]="-b";v[n++]="lnx/x86_64";v[n++]=kind==1?"-run":"-S";v[n++]=kind==0?"-run":kind==1?"-S":"-c";v[n++]=src;v[n++]="-o";v[n++]="-";v[n]=0;snprintf(name,sizeof name,"output-trace-route-%s",kind==0?"S-run":kind==1?"run-S":"S-object");replay=command(v,root,0,8,name);ck(replay.rc==2&&!replay.outn&&replay.errn&&strstr(replay.err,"resource-route-unsupported"),name);np_free(&replay);}
}
static int finish(const char *before,const char *container_before,const char *scope){char after[65];digest(product,after);ck(tx_eqz(before, after),"candidate-unchanged");if(native_driver){digest(container,after);ck(tx_eqz(container_before, after),"model-container-unchanged");}puts("TIMING\tstartup_construction_loading_inference_output_validation=UNMEASURED\tcold_hot=UNMEASURED");printf("RESOURCES\tassertions=%d\tfailed=%d\tscope=%s\n",assertions,failures,scope);return failures?1:0;}
/* ri.frame.strict-needs-ledger and ri.frame.ledger-dir-absent: --strict-resource-flow alone is refused with the exact message;
   an absent ledger is resource-ledger-absent, while ENOTDIR and EACCES are read failures with their errno, never absence */
static int ledger_case(const char *name,const char *dir,const char *reason,const char *detail,int exact){char *v[20];int n=command_prefix(v,8);v[n++]="--strict-resource-flow";if(dir){v[n++]="--resource-ledger";v[n++]=(char *)dir;}v[n++]="-O0";v[n++]="-b";v[n++]="lnx/x86_64";v[n++]="-S";v[n++]=src;v[n++]="-o";v[n++]="-";v[n]=0;
 np_result r=command(v,root,0,8,name);long rn=tx_len(reason,256);
 int ok=r.rc==2&&!r.outn&&(exact?tx_same(r.err,(long)r.errn,reason,rn):tx_find(r.err,(long)r.errn,reason,rn)>=0);
 if(detail)ok=ok&&tx_find(r.err,(long)r.errn,detail,tx_len(detail,64))>=0;
 np_free(&r);return ok;}
/* ri.id.optimisation-bound and ri.id.target-bound: the -O0 lnx/x86_64 ledger replayed at another level or for another
   target is refused by its stage identity, naming both, with no output (never compiled for the ledger's target) */
static int bound_case(const char *name,const char *level,const char *target){char *v[20],want[256];int n=command_prefix(v,8);v[n++]="--strict-resource-flow";v[n++]="--resource-ledger";v[n++]=capdir;v[n++]=(char *)level;v[n++]="-b";v[n++]=(char *)target;v[n++]="-S";v[n++]=src;v[n++]="-o";v[n++]="-";v[n]=0;
 if(cx_fmt(want,sizeof want,"INTERFACE_ERROR resource-identity-mismatch stage ledger=e3:lnx/x86_64/tape/O0 run=e3:%s/tape/%s\n",target,level+1))die("want");
 np_result r=command(v,root,0,8,name);int ok=r.rc==2&&!r.outn&&tx_find(r.err,(long)r.errn,want,tx_len(want,256))>=0;np_free(&r);return ok;}
static void identity_bounds(void){
 const char *names[5]={"bound-O1","bound-O2","bound-lnx-arm64","bound-osx-x86_64","bound-win-x86_64"};
 const char *levels[5]={"-O1","-O2","-O0","-O0","-O0"},*targets[5]={"lnx/x86_64","lnx/x86_64","lnx/arm64","osx/x86_64","win/x86_64"};
 for(int i=0;i<5;i++)ck(bound_case(names[i],levels[i],targets[i]),names[i]);
}
/* ri.frame.key-length-bound: a quote include named so its key "\0inc/q/NAME" is 512 bytes is captured and replayed;
   at 513 bytes capture is refused capture-key-length, and a strict fetch (ledger re-bound to that source) is refused
   "resource key too long", both with empty stdout */
static void key_source(const char *dir,int keylen,char *src_name,int cap){
 char name[600],p[1200];int at=0;
 for(int s=0;s<5;s++){for(int k=0;k<99;k++)name[at++]='d';name[at]=0;if(cx_fmt(p,sizeof p,"%s/%s",dir,name)||(sy_mkdir(p,0700)&&sy_exists(p)!=1))die("key dir");name[at++]='/';}
 int hs=keylen-7-at-2;for(int k=0;k<hs;k++)name[at++]='h';name[at++]='.';name[at++]='h';name[at]=0;
 if(cx_fmt(p,sizeof p,"%s/%s",dir,name))die("key header");save(p,"int v=1;\n",9);
 char body[700];if(cx_fmt(src_name,cap,"m%d.c",keylen)||cx_fmt(p,sizeof p,"%s/%s",dir,src_name)||cx_fmt(body,sizeof body,"#include \"%s\"\nint main(void){return v;}\n",name))die("key source");save(p,body,tx_len(body,sizeof body));}
static np_result key_run(const char *dir,const char *ledger,const char *capture,const char *srcname,const char *name){char *v[20];int n=command_prefix(v,8);if(ledger){v[n++]="--strict-resource-flow";v[n++]="--resource-ledger";v[n++]=(char *)ledger;}v[n++]="-O0";v[n++]="-b";v[n++]="lnx/x86_64";v[n++]="-S";v[n++]=(char *)srcname;v[n++]="-o";v[n++]="-";v[n]=0;return command(v,dir,capture,8,name);}
static void key_length_bound(void){
 char dir[4400],s512[32],s513[32],cap512[4400],cap513[4400],p[4400];path(dir,sizeof dir,work,"keylen");if(sy_mkdir(dir,0700))die("keylen dir");
 key_source(dir,512,s512,sizeof s512);key_source(dir,513,s513,sizeof s513);path(cap512,sizeof cap512,dir,"cap512");path(cap513,sizeof cap513,dir,"cap513");
 np_result a=key_run(dir,0,cap512,s512,"key-512-capture");ck(a.rc==0&&!a.errn&&a.outn>0,"key-512-capture-accept");
 np_result b=key_run(dir,cap512,0,s512,"key-512-strict");ck(b.rc==0&&!b.errn&&b.outn==a.outn&&a.outn>0&&mm_same(b.out,a.out,(long)a.outn),"key-512-strict-accept");np_free(&b);np_free(&a);
 np_result c=key_run(dir,0,cap513,s513,"key-513-capture");ck(c.rc==2&&!c.outn&&tx_find(c.err,(long)c.errn,"INTERFACE_ERROR capture-key-length",34)>=0,"key-513-capture-refused");np_free(&c);
 /* the 512 ledger re-bound to the 513 source (input_sha256 is the source digest) reaches the fetch of the 513-byte key */
 size_t tn,sn;path(p,sizeof p,cap512,"resources.tsv");char *table=load(p,&tn);path(p,sizeof p,dir,s513);char *srcb=load(p,&sn);char hash[65];cx_sha256_hex(srcb,sn,hash);mm_free(srcb);
 long at=tx_find(table,(long)tn,"input_sha256=",13);if(at<0||at+13+64>(long)tn)die("key identity");for(int k=0;k<64;k++)table[at+13+k]=hash[k];
 char keep[4400];if(tx_copy(keep,sizeof keep,capdir,tx_len(capdir,sizeof capdir))||tx_copy(capdir,sizeof capdir,cap512,tx_len(cap512,sizeof cap512)))die("capdir");
 char ledger513[4400];material("keylen-strict-513",table,tn,ledger513);if(tx_copy(capdir,sizeof capdir,keep,tx_len(keep,sizeof keep)))die("capdir");mm_free(table);
 np_result d=key_run(dir,ledger513,0,s513,"key-513-strict");ck(d.rc==2&&!d.outn&&tx_find(d.err,(long)d.errn,"resource key too long",21)>=0,"key-513-strict-refused");np_free(&d);
}
static void ledger_preconditions(void){
 char none[4400],file[4400],locked[4400];path(none,sizeof none,work,"ledger-none");path(file,sizeof file,work,"ledger-file");path(locked,sizeof locked,work,"ledger-locked");
 save(file,"x",1);if(sy_mkdir(locked,0700)||sy_chmod(locked,0))die("locked ledger");
 const char *strict="unisacc: --strict-resource-flow needs --resource-ledger DIR\n";
 const char *names[4]={"strict-needs-ledger","ledger-absent","ledger-enotdir","ledger-eacces"},*dirs[4]={0,none,file,locked};
 const char *reasons[4]={strict,"INTERFACE_ERROR resource-ledger-absent ","INTERFACE_ERROR resource-ledger-read-failed ","INTERFACE_ERROR resource-ledger-read-failed "},*details[4]={0,0,"errno=20","errno=13"};
 for(int i=0;i<4;i++){int ok=ledger_case(names[i],dirs[i],reasons[i],details[i],i==0);
  if(i==3&&sy_euid()==0)ok=0;   /* root reads a mode-0 directory: EACCES cannot be produced, so this is not a PASS */
  ck(ok,names[i]);}
 if(sy_chmod(locked,0700))die("unlock ledger");
}
int main(int argc,char **argv){int trace_mode=argc>3&&tx_eqz(argv[argc-1], "--trace"),multi_mode=argc>3&&tx_eqz(argv[argc-1], "--multi"),output_mode=argc>3&&tx_eqz(argv[argc-1], "--trace-output");if(trace_mode||multi_mode||output_mode)argc--;if((argc!=3&&argc!=4)||!realpath(argv[1],root)||argv[2][0]!='/'||strlen(argv[2])>=sizeof work)return 2;strcpy(work,argv[2]);if(mkdir(work,0700))die("new work directory");path(container,sizeof container,root,"unisacc.com");strcpy(product,container);if(argc==4){if(!realpath(argv[3],product))die("native driver path");size_t size;char *bytes=load(product,&size);if(size>=4&&!memcmp(bytes,"\177ELF",4)){native_driver=1;}else if(size>=16&&!memcmp(bytes+size-16,"UNIPKG1\n",8)){strcpy(container,product);}else die("optional candidate must be a native ELF driver or packaged product");free(bytes);}path(bound,sizeof bound,root,"tools/bound");path(src,sizeof src,work,"fixture.c");const char *code="int main(void){return 7;}\n";save(src,code,strlen(code));char before[65],after[65],container_before[65];digest(product,before);digest(container,container_before);
 if(unsetenv("UNISACC_RF_CAPTURE"))die("clear inherited capture");if(setenv("UNISA_JOBS","1",1))die("serial resource jobs");if(output_mode){trace_output_batch();return finish(before,container_before,"SC2-output-fail-closed-SC1-metadata-and-route-boundaries");}if(multi_mode){multi_batch();return finish(before,container_before,"SC2-mixed-CX-C-multiTU-and-tape-return7");}np_result normal=invoke(0,root,0,"normal");ck(normal.rc==0&&!normal.errn&&normal.outn>0,"default-accept");if(normal.rc)return 1;path(capdir,sizeof capdir,work,"capture");np_result captured=invoke(0,root,capdir,"capture");ck(captured.rc==0&&!captured.errn&&captured.outn==normal.outn&&!memcmp(captured.out,normal.out,normal.outn),"capture-preserves-output");np_free(&captured);char p[4400];path(p,sizeof p,capdir,"resources.tsv");ledger=load(p,&ledger_n);ck(ledger_n>5&&!memcmp(ledger,"#SC2\t",5),"capture-has-identity");
 np_result raw=invoke(capdir,root,0,"SC2-original-replay");int raw_ok=transcript_same(&raw,"SC2-original-byte-replay");np_free(&raw);if(!raw_ok){np_free(&normal);free(ledger);return finish(before,container_before,"SC2-original-replay-failed-no-map-conversion");}if(trace_mode){np_free(&normal);trace_batch(ledger,ledger_n);free(ledger);return finish(before,container_before,"SC2-ordered-trace-refusals-recapture-and-metadata");}canonical_controls(ledger,ledger_n);np_buf canonical_map={0};int converted=canonical(capdir,ledger,ledger_n,&canonical_map);ck(converted,"SC2-canonical-map-consistent");if(!converted)die("trace cannot be canonicalized without losing changing answers");char mapdir[4400];material("SC1-canonical-map",canonical_map.p,canonical_map.n,mapdir);strcpy(capdir,mapdir);free(ledger);ledger=canonical_map.p;ledger_n=canonical_map.n;np_result replay=invoke(capdir,root,0,"replay");ck(replay.rc==0&&!replay.errn&&replay.outn==normal.outn&&!memcmp(replay.out,normal.out,normal.outn),"strict-byte-replay");np_free(&replay);char cwd[4400];path(cwd,sizeof cwd,work,"other-cwd");if(mkdir(cwd,0700))die("cwd directory");replay=invoke(capdir,cwd,0,"cwd");ck(replay.rc==0&&!replay.errn&&replay.outn==normal.outn&&!memcmp(replay.out,normal.out,normal.outn),"strict-cwd-independent");np_free(&replay);np_free(&normal);
 char *end=memchr(ledger,'\n',ledger_n);if(!end)die("identity line");size_t header=(size_t)(end-ledger)+1;refuse("missing-identity",ledger+header,ledger_n-header,"resource-identity-absent");char *changed=malloc(ledger_n+1);if(!changed)die("allocation");memcpy(changed,ledger,ledger_n);changed[ledger_n]=0;char *stage=strstr(changed,"stage=e3:");if(!stage)die("stage field");stage[7]='2';refuse("wrong-stage",changed,ledger_n,"resource-identity-mismatch stage");memcpy(changed,ledger,ledger_n);char *hash=strstr(changed,"input_sha256=");if(!hash)die("input field");hash[13]=hash[13]=='0'?'1':'0';refuse("wrong-input",changed,ledger_n,"resource-identity-mismatch input");free(changed);
 const char *row="ff\t0\t-\t0\t-\n",*extra="ff\t0\t-\t0\t-\textra\n";appended("extra-fields",extra,strlen(extra),"resource-row-fields");appended("bad-key","fg\t0\t-\t0\t-\n",11,"resource-key-malformed");appended("bad-presence","ff\t2\t-\t0\t-\n",11,"resource-presence-invalid");appended("bad-length","ff\t0\t-\t00\t-\n",12,"resource-length-invalid");appended("bad-absent","ff\t0\tdata\t0\t-\n",14,"resource-absent-malformed");appended("truncated-row",row,strlen(row)-1,"resource-row-truncated");
 np_buf two={0};np_puts(&two,row);np_puts(&two,row);appended("duplicate-key",two.p,two.n,"duplicate-resource-key");free(two.p);
 /* ri.frame.identity-malformed (hex half): a non-hex input digest is a malformed identity.  The stage-label half is a
    product gap: a label outside {e3,lower,source} is parsed and then reported as resource-identity-mismatch. */
 {long at=tx_find(ledger,(long)ledger_n,"input_sha256=",13);char *bad=mm_alloc((long)ledger_n+1);if(at<0||!bad||mm_copy(bad,(long)ledger_n+1,ledger,(long)ledger_n))die("input field");bad[at+13]='g';refuse("malformed-input-hex",bad,ledger_n,"resource-identity-malformed");mm_free(bad);}
 /* ri.frame.row-field-too-long: a 4096-byte field is one above the parser bound (width >= 4096) */
 {np_buf longrow={0};np_puts(&longrow,"ff\t0\t");for(int k=0;k<4096;k++)np_put(&longrow,"a",1);np_puts(&longrow,"\t0\t-\n");appended("row-field-4096",longrow.p,longrow.n,"resource-row-field-too-long");mm_free(longrow.p);}
 const char nulrow[]="ff\t0\t-\t0\t-\0hidden\n";appended("embedded-nul-row",nulrow,sizeof nulrow-1,"resource-row-nul");np_buf nulheader={0};np_put(&nulheader,ledger,header-1);np_put(&nulheader,"\0hidden\n",8);np_put(&nulheader,ledger+header,ledger_n-header);refuse("embedded-nul-header",nulheader.p,nulheader.n,"resource-row-nul");free(nulheader.p);
 ledger_preconditions();identity_bounds();key_length_bound();repeated();additional();replay=invoke(capdir,root,0,"recovery");path(p,sizeof p,work,"normal.stdout");size_t recovery_n;char *recovery=load(p,&recovery_n);ck(replay.rc==0&&!replay.errn&&replay.outn==recovery_n&&!memcmp(replay.out,recovery,recovery_n),"strict-recovery-after-refusals");free(recovery);np_free(&replay);free(ledger);return finish(before,container_before,"SC1-map-compatibility-from-verified-SC2-trace");}
