/* Product-facing ResourceInput/strict-ledger batch. No shell command strings,
 * legacy runner, Python, or saved PASS. Each fixture is a private generation. */
#pragma unisa use cxlib.netpack
static char root[4096],work[4096],product[4400],bound[4400],src[4400],capdir[4400],container[4400];
static int native_driver;
static int assertions,failures;static char *ledger;static size_t ledger_n;
static void die(const char *s){fprintf(stderr,"resources: %s\n",s);exit(2);}
static void path(char *p,size_t cap,const char *a,const char *b){int n=snprintf(p,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path bound");}
static char *load(const char *p,size_t *n){char *s=cx_read(p,n);if(!s)die(p);return s;}
static void save(const char *p,const char *s,size_t n){int f=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC,0600);if(f<0)die("exclusive fixture");while(n){ssize_t k=write(f,s,n);if(k<0&&errno==EINTR)continue;if(k<=0)die("fixture write");s+=k;n-=(size_t)k;}if(close(f))die("fixture close");}
static void ck(int ok,const char *s){assertions++;if(!ok)failures++;printf("%s\tresources.%s\n",ok?"PASS":"FAIL",s);}
static void digest(const char *p,char *h){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static np_result invoke(const char *dir,const char *cwd,const char *capture,const char *name){char env[4600],err[1024],p[4400];snprintf(env,sizeof env,"UNISACC_RF_CAPTURE=%s",capture?capture:"");const char *adds[]={env,0};char *v[20];int n=0;v[n++]=bound;v[n++]="8";if(!native_driver)v[n++]="sh";v[n++]=product;if(native_driver){v[n++]="--models";v[n++]=container;}if(dir){v[n++]="--strict-resource-flow";v[n++]="--resource-ledger";v[n++]=(char *)dir;}v[n++]="-O0";v[n++]="-b";v[n++]="lnx/x86_64";v[n++]="-S";v[n++]=src;v[n++]="-o";v[n++]="-";v[n]=0;np_result r;if(np_run(v,cwd,capture?adds:0,10,&r,err,sizeof err))die(err);char file[120];snprintf(file,sizeof file,"%s.stdout",name);path(p,sizeof p,work,file);save(p,r.out,r.outn);snprintf(file,sizeof file,"%s.stderr",name);path(p,sizeof p,work,file);save(p,r.err,r.errn);return r;}
static void material(const char *name,const char *table,size_t n,char *out){path(out,4400,work,name);if(mkdir(out,0700))die("fixture directory");DIR *d=opendir(capdir);struct dirent *e;if(!d)die("capture directory");while((e=readdir(d))){if(!strcmp(e->d_name,".")||!strcmp(e->d_name,"..")||!strcmp(e->d_name,"resources.tsv"))continue;char p[4400],q[4400];size_t z;path(p,sizeof p,capdir,e->d_name);path(q,sizeof q,out,e->d_name);char *b=load(p,&z);save(q,b,z);free(b);}if(closedir(d))die("closedir");char p[4400];path(p,sizeof p,out,"resources.tsv");save(p,table,n);}
static void refuse(const char *name,const char *table,size_t n,const char *reason){char dir[4400];material(name,table,n,dir);np_result r=invoke(dir,root,0,name);int ok=r.rc==2&&!r.outn&&strstr(r.err,reason);ck(ok,name);if(!ok)fprintf(stderr,"resources %s actual rc=%d stderr=%.*s\n",name,r.rc,(int)r.errn,r.err);np_free(&r);}
static void appended(const char *name,const char *row,size_t n,const char *reason){np_buf b={0};np_put(&b,ledger,ledger_n);np_put(&b,row,n);refuse(name,b.p,b.n,reason);free(b.p);}
int main(int argc,char **argv){if((argc!=3&&argc!=4)||!realpath(argv[1],root)||argv[2][0]!='/'||strlen(argv[2])>=sizeof work)return 2;strcpy(work,argv[2]);if(mkdir(work,0700))die("new work directory");path(container,sizeof container,root,"unisacc.com");strcpy(product,container);if(argc==4){if(!realpath(argv[3],product))die("native driver path");size_t size;char *bytes=load(product,&size);if(size<4||memcmp(bytes,"\177ELF",4))die("optional driver must be a native ELF");free(bytes);native_driver=1;}path(bound,sizeof bound,root,"tools/bound");path(src,sizeof src,work,"fixture.c");const char *code="int main(void){return 7;}\n";save(src,code,strlen(code));char before[65],after[65],container_before[65];digest(product,before);digest(container,container_before);
 if(unsetenv("UNISACC_RF_CAPTURE"))die("clear inherited capture");np_result normal=invoke(0,root,0,"normal");ck(normal.rc==0&&!normal.errn&&normal.outn>0,"default-accept");if(normal.rc)return 1;path(capdir,sizeof capdir,work,"capture");np_result captured=invoke(0,root,capdir,"capture");ck(captured.rc==0&&!captured.errn&&captured.outn==normal.outn&&!memcmp(captured.out,normal.out,normal.outn),"capture-preserves-output");np_free(&captured);char p[4400];path(p,sizeof p,capdir,"resources.tsv");ledger=load(p,&ledger_n);ck(ledger_n>5&&!memcmp(ledger,"#SC1\t",5),"capture-has-identity");
 np_result replay=invoke(capdir,root,0,"replay");ck(replay.rc==0&&!replay.errn&&replay.outn==normal.outn&&!memcmp(replay.out,normal.out,normal.outn),"strict-byte-replay");np_free(&replay);char cwd[4400];path(cwd,sizeof cwd,work,"other-cwd");if(mkdir(cwd,0700))die("cwd directory");replay=invoke(capdir,cwd,0,"cwd");ck(replay.rc==0&&!replay.errn&&replay.outn==normal.outn&&!memcmp(replay.out,normal.out,normal.outn),"strict-cwd-independent");np_free(&replay);np_free(&normal);
 char *end=memchr(ledger,'\n',ledger_n);if(!end)die("identity line");size_t header=(size_t)(end-ledger)+1;refuse("missing-identity",ledger+header,ledger_n-header,"resource-identity-absent");char *changed=malloc(ledger_n+1);if(!changed)die("allocation");memcpy(changed,ledger,ledger_n);changed[ledger_n]=0;char *stage=strstr(changed,"stage=e3:");if(!stage)die("stage field");stage[7]='2';refuse("wrong-stage",changed,ledger_n,"resource-identity-mismatch stage");memcpy(changed,ledger,ledger_n);char *hash=strstr(changed,"input_sha256=");if(!hash)die("input field");hash[13]=hash[13]=='0'?'1':'0';refuse("wrong-input",changed,ledger_n,"resource-identity-mismatch input");free(changed);
 const char *row="ff\t0\t-\t0\t-\n",*extra="ff\t0\t-\t0\t-\textra\n";appended("extra-fields",extra,strlen(extra),"resource-row-fields");appended("bad-key","fg\t0\t-\t0\t-\n",11,"resource-key-malformed");appended("bad-presence","ff\t2\t-\t0\t-\n",11,"resource-presence-invalid");appended("bad-length","ff\t0\t-\t00\t-\n",12,"resource-length-invalid");appended("bad-absent","ff\t0\tdata\t0\t-\n",14,"resource-absent-malformed");appended("truncated-row",row,strlen(row)-1,"resource-row-truncated");
 np_buf two={0};np_puts(&two,row);np_puts(&two,row);appended("duplicate-key",two.p,two.n,"duplicate-resource-key");free(two.p);
 const char nulrow[]="ff\t0\t-\t0\t-\0hidden\n";appended("embedded-nul-row",nulrow,sizeof nulrow-1,"resource-row-nul");np_buf nulheader={0};np_put(&nulheader,ledger,header-1);np_put(&nulheader,"\0hidden\n",8);np_put(&nulheader,ledger+header,ledger_n-header);refuse("embedded-nul-header",nulheader.p,nulheader.n,"resource-row-nul");free(nulheader.p);
 digest(product,after);ck(!strcmp(before,after),"candidate-unchanged");if(native_driver){digest(container,after);ck(!strcmp(container_before,after),"model-container-unchanged");}free(ledger);printf("RESOURCES\tassertions=%d\tfailed=%d\tscope=strict-ledger-product-capture-replay-and-refusal\n",assertions,failures);return failures?1:0;}
