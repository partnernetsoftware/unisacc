/* Finite material-only union contract. CLI: ROOT CTX FRESH_SID.
 * Four nonmutating argument controls, two fresh reordered net-leaf views,
 * an independent tool-only union, and parent survival: 36 obligations.
 * Producer outer142 remains UNKNOWN; no NN inference or full-package claim. */
#pragma unisa use cxlib.sourcepackage
static int assertions,failed;
static void check(int ok,const char *s){assertions++;if(!ok)failed++;printf("%s\t%s\n",ok?"PASS":"FAIL",s);}
static int zero(const sp_result *r){const unsigned char *p=(const unsigned char *)r;for(size_t i=0;i<sizeof *r;i++)if(p[i])return 0;return 1;}
static void negative(const char *root,const char *ctx,const char *sid,const char *const *ids,int n,const char *label){sp_result r;char why[1200];memset(&r,0xa5,sizeof r);memset(why,'!',sizeof why);int rc=sp_verify_jobs_snapshot(root,ctx,ids,n,sid,20,&r,why,sizeof why);check(rc==-1,label);check(memchr(why,0,sizeof why)&&!strcmp(why,"source-package-snapshot-arguments"),"early-argument-refusal-is-exact");check(zero(&r),"negative-clears-entire-result");}
static sp_result positive(const char *root,const char *ctx,const char *sid,const char *const *ids,int n,int jobs,int models){sp_result r;char why[1200];memset(&r,0xa5,sizeof r);int rc=sp_verify_jobs_snapshot(root,ctx,ids,n,sid,20,&r,why,sizeof why);check(!rc,"fresh-material-job-union");if(rc){fprintf(stderr,"%s\n",why);exit(2);}check(!why[0],"success-reason-empty");check(r.jobs==jobs&&r.models==models,"unique-job-and-complete-net-domains");check(!strcmp(r.source,sid),"caller-fresh-source-matches-context");check(!strcmp(r.verifier,"5cbceaa8a5bd424b5a40005c8b29c7db4f4ea70c982892a3bdeed9416c915aff"),"executing-module-source-identity");check(r.physical_reads>0&&r.elapsed_ns>0,"fresh-physical-reads-and-measured-time");check(strlen(r.artifact)==64&&strlen(r.receipt)==64&&strlen(r.manifest)==64&&strcmp(r.artifact,r.receipt),"outputs-and-receipts-have-separate-domains");printf("UNION\tjobs=%d\tmodels=%d\treads=%d\tns=%lld\tartifact=%s\treceipt=%s\twitness=%s\n",r.jobs,r.models,r.physical_reads,r.elapsed_ns,r.artifact,r.receipt,r.witness);return r;}
int main(int argc,char **argv){if(argc!=4)return 2;const char *a[]={"net-shared-e3","net-warnparse","net-errorparse"},*b[]={"net-errorparse","net-shared-e3","net-warnparse"},*tools[]={"tool-gen","tool-tbl","tool-net"},*dup[]={"net-shared-e3","net-shared-e3"},*unknown[]={"net-not-a-model"};negative(argv[1],argv[2],argv[3],a,0,"empty-leaf-set-refused");negative(argv[1],argv[2],argv[3],dup,2,"duplicate-explicit-leaf-refused");negative(argv[1],argv[2],argv[3],unknown,1,"unknown-leaf-refused");negative(argv[1],argv[2],"bad",a,3,"malformed-fresh-source-refused");pid_t caller=getpid();sp_result before=positive(argv[1],argv[2],argv[3],a,3,12,3),after=positive(argv[1],argv[2],argv[3],b,3,12,3);check(!strcmp(before.artifact,after.artifact)&&!strcmp(before.receipt,after.receipt)&&!strcmp(before.manifest,after.manifest),"explicit-leaf-order-does-not-change-canonical-union");check(!strcmp(before.witness,after.witness)&&before.physical_reads==after.physical_reads,"independent-fresh-views-have-stable-data-witness");positive(argv[1],argv[2],argv[3],tools,3,3,0);check(caller==getpid(),"parent-survives-private-validation");puts("SCOPE\tmaterial-only;two-native-job-outer142-terminations-remain-UNKNOWN;no-NN-inference-or-current107-package-claim");printf("SOURCE_JOB_UNION\tassertions=%d\tfailed=%d\n",assertions,failed);return failed?1:0;}
