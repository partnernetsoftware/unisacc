#pragma unisa use text.text
#!/usr/bin/env -S unisacc.com -run
/* cxinclude.cx -- CX0 ratchet of plans/cx-modules.md: per tracked .cx module, the number of preprocessor include
   directives, i.e. lines that are optional blanks, a hash mark, optional blanks, then the word include.  A .cx
   module has its prelude (include/cx.h) built in and must not use #include.  A new module starts and stays at 0;
   a row already in tests/cxinclude.tsv is debt and only goes down.  The libc/POSIX docking units listed in
   tests/cxinclude-boundary.tsv (include/, tools/cxcc-hostinc/ and the L0 cx/sys/) may use #include; they are not
   module rows.  The boundary file also takes exact entries FILE.cx<TAB>REASON for single files that belong to the
   bottom layer although they live elsewhere (header-surface probes that test a carried header by including it); an
   entry without a reason, or not naming a .cx file, is refused with rc 2.
   This file itself has none: everything it calls comes from the prelude.
   usage, from the repo root:
     sh ./unisacc.com -run tests/cxinclude.cx -- --check   rc 1 naming each file whose count rose above its row in
                                                           tests/cxinclude.tsv, or that has no row and a count
                                                           above 0; rc 0 otherwise.  Ends with a one-line summary.
     sh ./unisacc.com -run tests/cxinclude.cx -- --write   rewrite tests/cxinclude.tsv only when every module count is
                                                           at or below its row.  A new include or a higher count
                                                           leaves the file unchanged and exits 1.
   The files are `git ls-files -s -z '*.cx' ':(exclude)archive/'` (tracked or staged; an untracked scratch .cx is not
   a module of the tree and is ignored on purpose; archive/ is reference-only and outside the ratchet), read from the
   work tree; a tracked file missing there counts 0.  A tracked symlink is skipped: its target counts under its own path.
   tests/cxinclude.tsv rows are PATH<TAB>COUNT, written only for counts above 0: a file without a row is held at 0,
   so the baseline only lists what is still to remove.  Lines of the .tsv that start with a hash mark are comments.
   A stale row (file no longer tracked) is reported and ignored.  rc 2: usage, not at the repo root, git or I/O
   trouble. */

#define BASELINE "tests/cxinclude.tsv"
#define BOUNDARY "tests/cxinclude-boundary.tsv"
#define MAXROWS 4096
#define MAXPREF 32

typedef struct { char *path; int count; int used; } Row;
static Row rows[MAXROWS];
static int nrows;
static char *pref[MAXPREF];
static int npref;
#define MAXEXACT 64
static char exact[MAXEXACT][512];   /* single bottom-layer .cx files (header-surface probes), each with a reason */
static int nexact;

/* include directives in b[0..n) */
static int count_includes(const char *b, size_t n) {
    size_t i = 0, j; int c = 0;
    while (i < n) {
        j = i;
        while (j < n && (b[j] == ' ' || b[j] == '\t')) j++;
        if (j < n && b[j] == '#') {
            j++;
            while (j < n && (b[j] == ' ' || b[j] == '\t')) j++;
            if (n - j >= 7 && !memcmp(b + j, "include", 7)) c++;
        }
        while (i < n && b[i] != '\n') i++;
        i++;
    }
    return c;
}

/* the baseline rows; -1 when it cannot be read or a row is malformed */
static int load_baseline(void) {
    size_t n, i = 0, e, t; char *b = cx_read(BASELINE, &n);
    if (!b) { fprintf(stderr, "cxinclude: cannot read %s (run --write once)\n", BASELINE); return -1; }
    while (i < n) {
        e = i; while (e < n && b[e] != '\n') e++;
        if (e < n) b[e] = 0;                         /* cx_read leaves b[n] == 0 for a last line without newline */
        if (e > i && b[e - 1] == '\r') b[e - 1] = 0;
        if (e > i && b[i] != '#') {
            char *line = b + i, *tab = strchr(line, '\t'), *end; long v;
            if (!tab || nrows == MAXROWS) { fprintf(stderr, "cxinclude: %s: bad row '%s'\n", BASELINE, line); free(b); return -1; }
            *tab = 0; v = strtol(tab + 1, &end, 10);
            if (end == tab + 1 || *end || v < 0) { fprintf(stderr, "cxinclude: %s: bad count for %s\n", BASELINE, line); free(b); return -1; }
            t = strlen(line) + 1; rows[nrows].path = malloc(t); memcpy(rows[nrows].path, line, t);
            rows[nrows].count = (int)v; rows[nrows].used = 0; nrows++;
        }
        i = e + 1;
    }
    free(b); return 0;
}

static Row *find_row(const char *path) {
    int k;
    for (k = 0; k < nrows; k++) if (tx_eq(rows[k].path, path, 1L << 20)) return &rows[k];
    return 0;
}

/* docking prefixes; -1 when the list is missing or a row does not end with / */
static int load_boundary(void) {
    size_t n, i = 0, e, t; char *b = cx_read(BOUNDARY, &n);
    if (!b) { fprintf(stderr, "cxinclude: cannot read %s\n", BOUNDARY); return -1; }
    while (i < n) {
        e = i; while (e < n && b[e] != '\n') e++;
        if (e < n) b[e] = 0;
        if (e > i && b[e - 1] == '\r') b[e - 1] = 0;
        if (e > i && b[i] != '#') {
            char *line = b + i, *tab = line;
            while (*tab && *tab != '\t') tab++;
            if (*tab) {   /* one exact docking unit with a mandatory reason: FILE<TAB>REASON */
                size_t pl = (size_t)(tab - line);
                if (nexact == MAXEXACT) { fprintf(stderr, "cxinclude: %s: too many exact entries\n", BOUNDARY); return -1; }   /* rc 2 exits */
                if (pl < 2 || pl >= sizeof exact[0] || !tab[1] || !(line[pl - 1] == 'x' || line[pl - 1] == 'c' || line[pl - 1] == 'h' || line[pl - 1] == 'n')) {
                    fprintf(stderr, "cxinclude: exact boundary entry must be a .cx/.c/.h/.c.in FILE<TAB>reason: %s\n", line); return -1;
                }
                { size_t q; for (q = 0; q < pl; q++) exact[nexact][q] = line[q]; exact[nexact][pl] = 0; }
                nexact++;
                i = e + 1;
                continue;
            }
            if (npref == MAXPREF) { fprintf(stderr, "cxinclude: %s: too many prefixes\n", BOUNDARY); free(b); return -1; }
            t = strlen(line);
            if (t < 2 || line[t - 1] != '/') { fprintf(stderr, "cxinclude: boundary prefix must end with /: %s\n", line); free(b); return -1; }
            pref[npref] = malloc(t + 1); memcpy(pref[npref], line, t + 1); npref++;
        }
        i = e + 1;
    }
    free(b);
    if (!npref) { fprintf(stderr, "cxinclude: %s: no prefixes\n", BOUNDARY); return -1; }
    return 0;
}

/* `#pragma unisa dock` (bare, or `dock include|libc`) in the unit's first lines: the
   unit declares that it is a docking unit.  Per plans/cx-dock-pragma.md only modules
   (a `#pragma unisa module` unit, or one another unit `use`s) are subject to the rule;
   a pure script is neither, so it is never asked for a dock and never exempted by
   claiming one. */
static int has_dock(const char *b, size_t n) {
    size_t i = 0;
    while (i < n) {
        size_t e = i, j;
        while (e < n && b[e] != '\n') e++;
        j = i;
        while (j < e && (b[j] == ' ' || b[j] == '\t')) j++;
        if (j < e && b[j] == '#') {
            j++;
            while (j < e && (b[j] == ' ' || b[j] == '\t')) j++;
            if (e - j >= 6 && !memcmp(b + j, "pragma", 6)) {
                j += 6;
                while (j < e && (b[j] == ' ' || b[j] == '\t')) j++;
                if (e - j >= 5 && !memcmp(b + j, "unisa", 5)) {
                    j += 5;
                    while (j < e && (b[j] == ' ' || b[j] == '\t')) j++;
                    if (e - j >= 4 && !memcmp(b + j, "dock", 4) &&
                        (j + 4 == e || b[j + 4] == ' ' || b[j + 4] == '\t')) return 1;
                }
            }
        }
        i = e + 1;
    }
    return 0;
}

/* a unit that is a module: declares `#pragma unisa module`, or another unit `use`s it */
static int is_module(const char *path, const char *b, size_t n) {
    size_t i = 0;
    while (i < n) {
        size_t e = i, j;
        while (e < n && b[e] != '\n') e++;
        j = i;
        while (j < e && (b[j] == ' ' || b[j] == '\t')) j++;
        if (j < e && b[j] == '#' && e - j >= 6 && !memcmp(b + j + 1, "pragma", 6)) {
            j += 7;
            while (j < e && (b[j] == ' ' || b[j] == '\t')) j++;
            if (e - j >= 5 && !memcmp(b + j, "unisa", 5)) {
                j += 5;
                while (j < e && (b[j] == ' ' || b[j] == '\t')) j++;
                if (e - j >= 6 && !memcmp(b + j, "module", 6)) return 1;
            }
        }
        i = e + 1;
    }
    (void)path;
    return 0;
}

/* docking units by path prefix or exact path -- and, when the unit is a module, only
   if it also declares a dock.  A non-module script is not asked (plans/cx-dock-pragma.md). */
static int is_boundary(const char *path, const char *b, size_t n) {
    int k; size_t m;
    for (k = 0; k < npref; k++) {
        m = strlen(pref[k]);
        if (!strncmp(path, pref[k], m)) return has_dock(b, n) || !is_module(path, b, n);
    }
    for (k = 0; k < nexact; k++) {   /* exact entries: whole-path equality, no prefix reach.
                                        An exact entry names one unit the boundary file itself
                                        licenses (a header-surface probe), so it stands in for a
                                        dock until that lane adds one (omp-cc 2026-11-04). */
        const char *a = path, *x = exact[k];
        while (*a && *a == *x) { a++; x++; }
        if (!*a && !*x) return 1;
    }
    return 0;
}

/* headers under the docking prefixes; their #include lines are allowed */
static int boundary_headers(int *files, int *incs) {
    char *list = 0, *p, *end; size_t ln = 0; int rc;
    rc = cx_run("git ls-files -z -- include tools/cxcc-hostinc", &list, &ln);
    if (rc != 0 || !list) { fprintf(stderr, "cxinclude: git ls-files failed (rc %d)\n", rc); return -1; }
    *files = 0; *incs = 0;
    for (p = list, end = list + ln; p < end; p += strlen(p) + 1) {
        size_t n, L; char *src; int c;
        if (!*p) continue;
        L = strlen(p);
        if (L < 3 || p[L - 2] != '.' || p[L - 1] != 'h') continue;
        src = cx_read(p, &n);
        if (!src || !is_boundary(p, src, n)) { free(src); continue; }
        c = count_includes(src, n);
        free(src);
        (*files)++; (*incs) += c;
    }
    free(list);
    return 0;
}

static int append(char **buf, size_t *len, size_t *cap, const char *s) {
    size_t n = strlen(s); char *t;
    if (*len + n + 1 > *cap) {
        *cap = (*len + n + 1) * 2; t = realloc(*buf, *cap);
        if (!t) return -1;
        *buf = t;
    }
    memcpy(*buf + *len, s, n + 1); *len += n; return 0;
}

/* One `git ls-files -s -z` record, "MODE SHA STAGE<TAB>PATH": the path, or 0 for a tracked symlink
   (mode 120000), whose target is counted once under its own tracked path. */
static char *ls_path(char *rec) {
    static const char link[] = "120000 ";
    int k;
    for (k = 0; link[k] && rec[k] == link[k]; k++) ;
    if (!link[k]) return 0;
    while (*rec && *rec != '\t') rec++;
    return *rec ? rec + 1 : 0;
}

/* --files uses exact repo-relative paths (an optional leading ./ is ignored).
   Membership is checked before opening source; metadata and scanner self-checks
   remain global. Full --check and baseline-writing modes are unchanged. */
static int selected(int argc, char **argv, const char *path) {
    int i;
    if (argc == 2) return 1;
    for (i = 3; i < argc; i++) {
        const char *p = argv[i];
        while (p[0] == '.' && p[1] == '/') p += 2;
        if (tx_eq(p, path, 1L << 20)) return 1;
    }
    return 0;
}
int main(int argc, char **argv) {
    char *list = 0, *cdup = 0, *rec, *p, *end, *out = 0, line[4200]; size_t ln = 0, cl = 0, olen = 0, ocap = 0;
    int check, files = 0, total = 0, over = 0, under = 0, base_total = 0, bfiles = 0, binc = 0, hfiles = 0, hinc = 0, k, rc;
    if (argc < 2 || (argc != 2 && (argc < 4 || !tx_eq(argv[1], "--check", 1L << 20) || !tx_eq(argv[2], "--files", 1L << 20)))) {
        fprintf(stderr, "usage: cxinclude.cx --check [--files PATH...] | --write (from the repo root)\n"); return 2;
    }
    if (!tx_eq(argv[1], "--check", 1L << 20) && !tx_eq(argv[1], "--write", 1L << 20)) return 2;
    /* Rule/configuration edits affect every file, not just the selected paths. */
    if (argc > 2 && (selected(argc, argv, "tests/cxinclude.cx") || selected(argc, argv, "tests/cxinclude.tsv") || selected(argc, argv, "tests/cxinclude-boundary.tsv"))) {
        fprintf(stderr, "cxinclude: --files expands to full scan for rule/baseline/configuration change\n");
        argc = 2;
    }
    check = tx_eq(argv[1], "--check", 1L << 20);
    rc = cx_run("git rev-parse --show-cdup", &cdup, &cl);
    if (rc != 0 || !cdup || cl > 1) { fprintf(stderr, "cxinclude: run from the repo root\n"); return 2; }
    if (load_boundary() < 0) return 2;
    if (load_baseline() < 0) return 2;
    rc = cx_run("git ls-files -s -z -- '*.cx' ':(glob)cx/**/*.c' ':(glob)cx/**/*.h' ':(glob)cx/**/*.c.in' ':(exclude)archive/'", &list, &ln);
    if (rc != 0 || !list) { fprintf(stderr, "cxinclude: git ls-files failed (rc %d)\n", rc); return 2; }
    if (!check) {
        append(&out, &olen, &ocap, "# tests/cxinclude.tsv -- written by tests/cxinclude.cx --write; per tracked unit its include directives.\n");
        append(&out, &olen, &ocap, "# Every .cx module, plus the .c/.h/.c.in cx/ keeps under a directory. A module must not use\n");
        append(&out, &olen, &ocap, "# #include. Rows are debt and only go down. No row means 0.\n");
        append(&out, &olen, &ocap, "# The bottom layer in tests/cxinclude-boundary.tsv (include/, tools/cxcc-hostinc/, cx/sys/) docks libc/POSIX and has no rows here.\n");
        append(&out, &olen, &ocap, "# --write refuses a new row or a higher count and leaves this file unchanged.\n");
        append(&out, &olen, &ocap, "# path\tincludes\n");
    }
    for (rec = list, end = list + ln; rec < end; rec += strlen(rec) + 1) {
        size_t n; char *src; int c; Row *r; int docked;
        if (!(p = ls_path(rec)) || !*p) continue;
        if (!selected(argc, argv, p)) continue;
        src = cx_read(p, &n);
        c = src ? count_includes(src, n) : 0;
        docked = src && is_boundary(p, src, n);
        free(src);
        if (docked) {
            bfiles++; binc += c;
            if ((r = find_row(p))) r->used = 1;
            continue;
        }
        files++; total += c;
        r = find_row(p);
        if (r) r->used = 1;
        if (c > (r ? r->count : 0)) {
            if (r) printf("cxinclude: module %s has %d include lines, baseline %d\n", p, c, r->count);
            else printf("cxinclude: module %s has %d include lines and no baseline row (an upper-layer unit must not use #include)\n", p, c);
            over++;
        } else if (r && c < r->count) under++;
        if (!check && c > 0 && c <= (r ? r->count : 0)) {
            if (cx_fmt(line, sizeof line, "%s\t%d\n", p, c)) { fprintf(stderr, "cxinclude: path too long: %s\n", p); return 2; }
            if (append(&out, &olen, &ocap, line) < 0) { fprintf(stderr, "cxinclude: out of memory\n"); return 2; }
        }
    }
    free(list); free(cdup);
    if (boundary_headers(&hfiles, &hinc) < 0) return 2;
    bfiles += hfiles; binc += hinc;
    for (k = 0; k < nrows; k++) {
        base_total += rows[k].count;
        if (selected(argc, argv, rows[k].path) && !rows[k].used) printf("cxinclude: stale row %s (not a tracked unit; --write drops it)\n", rows[k].path);
    }
    if (argc > 2) printf("cxinclude: --files subset; boundary headers still scanned globally; baseline total is global\n");
    printf("cxinclude: %s: %d units, %d include lines (baseline %d); %d above baseline, %d below (--write ratchets down)\n",
           over ? "FAIL" : "ok", files, total, base_total, over, under);
    printf("cxinclude: boundary: %d docking headers, %d include lines allowed\n", bfiles, binc);
    if (!check) {
        if (over) {
            fprintf(stderr, "cxinclude: --write refused, %s unchanged\n", BASELINE);
            free(out);
            return 1;
        }
        if (cx_write(BASELINE, out, olen) != 0) { fprintf(stderr, "cxinclude: cannot write %s\n", BASELINE); return 2; }
        free(out);
        printf("cxinclude: wrote %s: %d units, %d include lines\n", BASELINE, files, total);
    }
    return over ? 1 : 0;
}
