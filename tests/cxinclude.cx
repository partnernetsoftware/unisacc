#!/usr/bin/env -S unisacc.com -run
/* cxinclude.cx -- CX0 ratchet of plans/cx-modules.md: per tracked .cx module, the number of preprocessor include
   directives, i.e. lines that are optional blanks, a hash mark, optional blanks, then the word include.  A .cx
   module has its prelude (include/cx.h) built in and must not use #include.  A new module starts and stays at 0;
   a row already in tests/cxinclude.tsv is debt and only goes down.  The libc/POSIX docking units listed in
   tests/cxinclude-boundary.tsv (include/ and tools/cxcc-hostinc/) may use #include; they are not module rows.
   This file itself has none: everything it calls comes from the prelude.
   usage, from the repo root:
     sh ./unisacc.com -run tests/cxinclude.cx -- --check   rc 1 naming each file whose count rose above its row in
                                                           tests/cxinclude.tsv, or that has no row and a count
                                                           above 0; rc 0 otherwise.  Ends with a one-line summary.
     sh ./unisacc.com -run tests/cxinclude.cx -- --write   rewrite tests/cxinclude.tsv only when every module count is
                                                           at or below its row.  A new include or a higher count
                                                           leaves the file unchanged and exits 1.
   The files are `git ls-files -z '*.cx' ':(exclude)archive/'` (tracked or staged; an untracked scratch .cx is not a
   module of the tree and is ignored on purpose; archive/ is reference-only and outside the ratchet), read from the
   work tree; a tracked file missing there counts 0.
   tests/cxinclude.tsv rows are PATH<TAB>COUNT, written only for counts above 0: a file without a row is held at 0,
   so the baseline only lists what is still to remove.  Lines of the .tsv that start with a hash mark are comments.
   A stale row (file no longer tracked) is reported and ignored.  rc 2: usage, not at the repo root, git or I/O
   trouble. */

#define BASELINE "tests/cxinclude.tsv"
#define BOUNDARY "tests/cxinclude-boundary.tsv"
#define MAXROWS 4096
#define MAXPREF 32

typedef struct { char *path; int count; int used; } Row;
static Row rows[MAXROWS];
static int nrows;
static char *pref[MAXPREF];
static int npref;

/* include directives in b[0..n) */
static int count_includes(const char *b, size_t n) {
    size_t i = 0, j; int c = 0;
    while (i < n) {
        j = i;
        while (j < n && (b[j] == ' ' || b[j] == '\t')) j++;
        if (j < n && b[j] == '#') {
            j++;
            while (j < n && (b[j] == ' ' || b[j] == '\t')) j++;
            if (n - j >= 7 && !memcmp(b + j, "include", 7)) c++;
        }
        while (i < n && b[i] != '\n') i++;
        i++;
    }
    return c;
}

/* the baseline rows; -1 when it cannot be read or a row is malformed */
static int load_baseline(void) {
    size_t n, i = 0, e, t; char *b = cx_read(BASELINE, &n);
    if (!b) { fprintf(stderr, "cxinclude: cannot read %s (run --write once)\n", BASELINE); return -1; }
    while (i < n) {
        e = i; while (e < n && b[e] != '\n') e++;
        if (e < n) b[e] = 0;                         /* cx_read leaves b[n] == 0 for a last line without newline */
        if (e > i && b[e - 1] == '\r') b[e - 1] = 0;
        if (e > i && b[i] != '#') {
            char *line = b + i, *tab = strchr(line, '\t'), *end; long v;
            if (!tab || nrows == MAXROWS) { fprintf(stderr, "cxinclude: %s: bad row '%s'\n", BASELINE, line); free(b); return -1; }
            *tab = 0; v = strtol(tab + 1, &end, 10);
            if (end == tab + 1 || *end || v < 0) { fprintf(stderr, "cxinclude: %s: bad count for %s\n", BASELINE, line); free(b); return -1; }
            t = strlen(line) + 1; rows[nrows].path = malloc(t); memcpy(rows[nrows].path, line, t);
            rows[nrows].count = (int)v; rows[nrows].used = 0; nrows++;
        }
        i = e + 1;
    }
    free(b); return 0;
}

static Row *find_row(const char *path) {
    int k;
    for (k = 0; k < nrows; k++) if (!strcmp(rows[k].path, path)) return &rows[k];
    return 0;
}

/* docking prefixes; -1 when the list is missing or a row does not end with / */
static int load_boundary(void) {
    size_t n, i = 0, e, t; char *b = cx_read(BOUNDARY, &n);
    if (!b) { fprintf(stderr, "cxinclude: cannot read %s\n", BOUNDARY); return -1; }
    while (i < n) {
        e = i; while (e < n && b[e] != '\n') e++;
        if (e < n) b[e] = 0;
        if (e > i && b[e - 1] == '\r') b[e - 1] = 0;
        if (e > i && b[i] != '#') {
            char *line = b + i;
            if (npref == MAXPREF) { fprintf(stderr, "cxinclude: %s: too many prefixes\n", BOUNDARY); free(b); return -1; }
            t = strlen(line);
            if (t < 2 || line[t - 1] != '/') { fprintf(stderr, "cxinclude: boundary prefix must end with /: %s\n", line); free(b); return -1; }
            pref[npref] = malloc(t + 1); memcpy(pref[npref], line, t + 1); npref++;
        }
        i = e + 1;
    }
    free(b);
    if (!npref) { fprintf(stderr, "cxinclude: %s: no prefixes\n", BOUNDARY); return -1; }
    return 0;
}

static int is_boundary(const char *path) {
    int k; size_t n;
    for (k = 0; k < npref; k++) {
        n = strlen(pref[k]);
        if (!strncmp(path, pref[k], n)) return 1;
    }
    return 0;
}

/* headers under the docking prefixes; their #include lines are allowed */
static int boundary_headers(int *files, int *incs) {
    char *list = 0, *p, *end; size_t ln = 0; int rc;
    rc = cx_run("git ls-files -z -- include tools/cxcc-hostinc", &list, &ln);
    if (rc != 0 || !list) { fprintf(stderr, "cxinclude: git ls-files failed (rc %d)\n", rc); return -1; }
    *files = 0; *incs = 0;
    for (p = list, end = list + ln; p < end; p += strlen(p) + 1) {
        size_t n, L; char *src; int c;
        if (!*p || !is_boundary(p)) continue;
        L = strlen(p);
        if (L < 3 || p[L - 2] != '.' || p[L - 1] != 'h') continue;
        src = cx_read(p, &n);
        c = src ? count_includes(src, n) : 0;
        free(src);
        (*files)++; (*incs) += c;
    }
    free(list);
    return 0;
}

static int append(char **buf, size_t *len, size_t *cap, const char *s) {
    size_t n = strlen(s); char *t;
    if (*len + n + 1 > *cap) {
        *cap = (*len + n + 1) * 2; t = realloc(*buf, *cap);
        if (!t) return -1;
        *buf = t;
    }
    memcpy(*buf + *len, s, n + 1); *len += n; return 0;
}

int main(int argc, char **argv) {
    char *list = 0, *cdup = 0, *p, *end, *out = 0, line[4200]; size_t ln = 0, cl = 0, olen = 0, ocap = 0;
    int check, files = 0, total = 0, over = 0, under = 0, base_total = 0, bfiles = 0, binc = 0, hfiles = 0, hinc = 0, k, rc;
    if (argc != 2 || (strcmp(argv[1], "--check") && strcmp(argv[1], "--write"))) {
        fprintf(stderr, "usage: cxinclude.cx --check | --write   (from the repo root)\n"); return 2;
    }
    check = !strcmp(argv[1], "--check");
    rc = cx_run("git rev-parse --show-cdup", &cdup, &cl);
    if (rc != 0 || !cdup || cl > 1) { fprintf(stderr, "cxinclude: run from the repo root\n"); return 2; }
    if (load_boundary() < 0) return 2;
    if (load_baseline() < 0) return 2;
    rc = cx_run("git ls-files -z -- '*.cx' ':(exclude)archive/'", &list, &ln);
    if (rc != 0 || !list) { fprintf(stderr, "cxinclude: git ls-files failed (rc %d)\n", rc); return 2; }
    if (!check) {
        append(&out, &olen, &ocap, "# tests/cxinclude.tsv -- written by tests/cxinclude.cx --write; per tracked .cx module its include directives.\n");
        append(&out, &olen, &ocap, "# A .cx module must not use #include. Rows are debt and only go down. No row means 0.\n");
        append(&out, &olen, &ocap, "# include/ and tools/cxcc-hostinc/ are the libc/POSIX docking units and are not rows here.\n");
        append(&out, &olen, &ocap, "# --write refuses a new row or a higher count and leaves this file unchanged.\n");
        append(&out, &olen, &ocap, "# path\tincludes\n");
    }
    for (p = list, end = list + ln; p < end; p += strlen(p) + 1) {
        size_t n; char *src; int c; Row *r;
        if (!*p) continue;
        src = cx_read(p, &n);
        c = src ? count_includes(src, n) : 0;
        free(src);
        if (is_boundary(p)) {
            bfiles++; binc += c;
            if ((r = find_row(p))) r->used = 1;
            continue;
        }
        files++; total += c;
        r = find_row(p);
        if (r) r->used = 1;
        if (c > (r ? r->count : 0)) {
            if (r) printf("cxinclude: module %s has %d include lines, baseline %d\n", p, c, r->count);
            else printf("cxinclude: module %s has %d include lines and no baseline row (a .cx module must not use #include)\n", p, c);
            over++;
        } else if (r && c < r->count) under++;
        if (!check && c > 0 && c <= (r ? r->count : 0)) {
            if (strlen(p) + 16 > sizeof line) { fprintf(stderr, "cxinclude: path too long: %s\n", p); return 2; }
            snprintf(line, sizeof line, "%s\t%d\n", p, c);
            if (append(&out, &olen, &ocap, line) < 0) { fprintf(stderr, "cxinclude: out of memory\n"); return 2; }
        }
    }
    free(list); free(cdup);
    if (boundary_headers(&hfiles, &hinc) < 0) return 2;
    bfiles += hfiles; binc += hinc;
    for (k = 0; k < nrows; k++) {
        base_total += rows[k].count;
        if (!rows[k].used) printf("cxinclude: stale row %s (not a tracked .cx; --write drops it)\n", rows[k].path);
    }
    printf("cxinclude: %s: %d .cx modules, %d include lines (baseline %d); %d above baseline, %d below (--write ratchets down)\n",
           over ? "FAIL" : "ok", files, total, base_total, over, under);
    printf("cxinclude: boundary: %d docking headers, %d include lines allowed\n", bfiles, binc);
    if (!check) {
        if (over) {
            fprintf(stderr, "cxinclude: --write refused, %s unchanged\n", BASELINE);
            free(out);
            return 1;
        }
        if (cx_write(BASELINE, out, olen) != 0) { fprintf(stderr, "cxinclude: cannot write %s\n", BASELINE); return 2; }
        free(out);
        printf("cxinclude: wrote %s: %d .cx modules, %d include lines\n", BASELINE, files, total);
    }
    return over ? 1 : 0;
}
