/* ROOT EXISTING_MATERIAL FIXTURE_REL NEW_ABS_OUT CASE_ID.
 * Run exactly one case per caller-owned tools/bound 55 invocation.
 * Baseline and changed clone each use --verify-native with bound18; no build,
 * fixture execution, source mutation or original-material mutation is done.
 * Linux/x86_64 only; FIFO uses the existing raw mknodat syscall convention. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
static char root[4096],original[4096],work[4096],clone[4400],product[4400],tool[4400],bound[4400];
static const char *leaves[]={"runtime.c","material.tsv","native.tsv","runtime-native"};
static char *bytes[4];static size_t sizes[4];static char hashes[4][65];static int assertions,failures;
static void die(const char *s){fprintf(stderr,"ri-material-controls: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void join(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path bound");}
static void ck(int ok,const char *name){assertions++;if(!ok)failures++;printf("%s\tri-material-controls.%s\n",ok?"PASS":"FAIL",name);}
static char *readfile(const char *p,size_t *n){struct stat a,b;if(lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)die("bounded regular file");int fd=open(p,O_RDONLY|O_NOFOLLOW|O_CLOEXEC|O_NONBLOCK);if(fd<0||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)die("read descriptor identity");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("read extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||bad||closed)die("changed input or close");s[*n]=0;return s;}
static void writefile(const char *p,const char *s,size_t n,int mode,int exclusive){int fd=open(p,O_WRONLY|O_NOFOLLOW|O_CLOEXEC|(exclusive?O_CREAT|O_EXCL:O_TRUNC),mode);if(fd<0)die("private output open");struct stat st;if(fstat(fd,&st)||!S_ISREG(st.st_mode)||fchmod(fd,(mode_t)mode))die("private output descriptor");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("private output write");at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("private output close");}
static void evidence(const char *label,const char *suffix,const char *s,size_t n){char name[160],p[4400];int z=snprintf(name,sizeof name,"%s.%s",label,suffix);if(z<0||(size_t)z>=sizeof name)die("evidence name");join(p,work,name);writefile(p,s,n,0600,1);}
static np_result verify(const char *material,const char *fixture,const char *label){char *v[]={bound,"18","sh",product,tool,"--","--verify-native",root,(char *)material,(char *)fixture,0};char why[1024],status[40];if(unsetenv("UNISACC_RF_CAPTURE"))die("clear ambient capture");np_result r;if(np_run(v,root,0,18,&r,why,sizeof why))die(why);evidence(label,"stdout",r.out,r.outn);evidence(label,"stderr",r.err,r.errn);int n=snprintf(status,sizeof status,"rc\t%d\n",r.rc);evidence(label,"status",status,(size_t)n);return r;}
/* errno is incidental state, not the named rejection contract: accept exactly
 * one reason line, followed only by a signed decimal errno and its newline. */
static int reason_is(const np_result *r,const char *reason){char prefix[300];int n=snprintf(prefix,sizeof prefix,"ri-material: REFUSE %s errno=",reason);if(n<0||(size_t)n>=sizeof prefix||r->errn<(size_t)n+2||memcmp(r->err,prefix,(size_t)n))return 0;size_t at=(size_t)n;if(r->err[at]=='-')at++;size_t start=at;while(at<r->errn&&r->err[at]>='0'&&r->err[at]<='9')at++;return at>start&&at+1==r->errn&&r->err[at]=='\n';}
static int accepted(const np_result *r){char expected[512];int n=snprintf(expected,sizeof expected,"VERIFIED\tri-native\tartifact=%s\tbytes=%lu\tflags=-O2 -fno-trim-libc -b lnx/x86_64 -o -\tno-test-result\nVERIFIED\tri-material\tno-test-result\n",hashes[3],(unsigned long)sizes[3]);return n>0&&(size_t)n<sizeof expected&&!r->rc&&!r->errn&&r->outn==(size_t)n&&!memcmp(r->out,expected,(size_t)n);}
static int within(const char *p,const char *dir){size_t n=strlen(dir);return !strncmp(p,dir,n)&&(!p[n]||p[n]=='/');}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN ri-material-controls requires Linux/x86_64\n",stderr);return 3;
#endif
 const char *names[]={"control-valid","native-byte-flip","missing-native-receipt","symlink-native","fifo-receipt","corrupt-runtime.c","corrupt-flags-receipt"};int which=-1;
 if(argc!=6||!realpath(argv[1],root)||!realpath(argv[2],original)||!argv[3][0]||argv[3][0]=='/'||strstr(argv[3],"..")||strpbrk(argv[3],"\\\r\n\t")||argv[4][0]!='/'||strlen(argv[4])>=sizeof work)die("usage ROOT EXISTING_MATERIAL FIXTURE_REL NEW_ABS_OUT CASE_ID");for(int i=0;i<7;i++)if(tx_eqz(argv[5], names[i]))which=i;if(which<0)die("unknown CASE_ID");
 /* Canonicalize the existing parent, keeping the output leaf genuinely new.
  * A clone may not be created inside the original material directory. */
 char parent[4096],canonical[4096];strcpy(parent,argv[4]);char *slash=strrchr(parent,'/');if(!slash||!slash[1]||tx_eqz(slash+1, ".")||tx_eqz(slash+1, ".."))die("output leaf");char leaf[4096];strcpy(leaf,slash+1);if(slash==parent)slash[1]=0;else *slash=0;if(!realpath(parent,canonical))die("output parent");int z=snprintf(work,sizeof work,"%s%s%s",canonical,tx_eqz(canonical, "/")?"":"/",leaf);if(z<0||(size_t)z>=sizeof work||within(work,original))die("output aliases original material");if(mkdir(work,0700))die("new private output required");join(clone,work,"material");if(mkdir(clone,0700))die("new clone directory");join(bound,root,"tools/bound");join(product,root,"unisacc.com");join(tool,root,"tools/ri-material.cx");
 for(int i=0;i<4;i++){char p[4400],q[4400];join(p,original,leaves[i]);bytes[i]=readfile(p,&sizes[i]);cx_sha256_hex(bytes[i],sizes[i],hashes[i]);join(q,clone,leaves[i]);writefile(q,bytes[i],sizes[i],i==3?0700:0600,1);size_t n;char *copy=readfile(q,&n);ck(n==sizes[i]&&!memcmp(copy,bytes[i],n),leaves[i]);free(copy);printf("ORIGINAL\t%s\tsha256=%s\tbytes=%lu\n",leaves[i],hashes[i],(unsigned long)sizes[i]);}
 np_result baseline=verify(original,argv[3],"original-valid");int valid=accepted(&baseline);ck(valid,"original-valid");np_free(&baseline);if(!valid)die("original material must verify before mutation");
 char p[4400];const char *reason=0;
 if(which==1){if(sizes[3]<64)die("native header extent");/* ELF EI_PAD: preserves the verifier's executable-format admission. */bytes[3][15]^=1;join(p,clone,leaves[3]);writefile(p,bytes[3],sizes[3],0700,0);reason="material changed";}
 if(which==2){join(p,clone,"native.tsv");if(unlink(p))die("private receipt removal");reason="native artifact and receipt both required";}
 if(which==3){char target[4400];join(p,clone,"runtime-native");join(target,original,"runtime-native");if(unlink(p)||symlink(target,p))die("private native symlink");reason="material leaf is not regular";}
 if(which==4){join(p,clone,"native.tsv");if(unlink(p))die("private receipt removal");/* Linux x86_64 syscall_64.tbl: mknodat=259. */if(_unisa_ret(__syscall6(259,-100,(long)p,S_IFIFO|0600,0,0)))die("private FIFO creation");reason="material leaf is not regular";}
 if(which==5){if(!sizes[0])die("runtime source empty");bytes[0][0]^=1;join(p,clone,"runtime.c");writefile(p,bytes[0],sizes[0],0600,0);reason="material changed";}
 if(which==6){const char *needle="\nflags\t-O2 -fno-trim-libc -b lnx/x86_64 -o -\n";char *at=strstr(bytes[2],needle);if(!at||strstr(at+1,needle))die("unique native flags");at[strlen("\nflags\t-O")]='3';join(p,clone,"native.tsv");writefile(p,bytes[2],sizes[2],0600,0);reason="material changed";}
 np_result result=verify(clone,argv[3],names[which]);ck(which==0?accepted(&result):result.rc==2&&!result.outn&&reason_is(&result,reason),names[which]);np_free(&result);
 for(int i=0;i<4;i++){char q[4400],h[65],label[100];size_t n;join(q,original,leaves[i]);char *s=readfile(q,&n);cx_sha256_hex(s,n,h);snprintf(label,sizeof label,"original-unchanged.%s",leaves[i]);ck(n==sizes[i]&&tx_eqz(h, hashes[i]),label);free(s);free(bytes[i]);}
 puts("NOT_CLAIMED\tfixture-behavior-product-rebuild-foreign-hosts-or-general-filesystem-race-safety");puts("TIMING\tstartup_construction_loading_output_validation_cold_hot=UNMEASURED");printf("RI_MATERIAL_CONTROLS\tcase=%s\tassertions=%d\tfailed=%d\texecuted-cases=1\n",names[which],assertions,failures);return failures?1:0;
}
