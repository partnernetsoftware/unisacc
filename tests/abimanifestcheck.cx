#!/usr/bin/env -S unisacc.com -run
/* abimanifestcheck.cx [--root DIR] --write PATH | --check | --selftest -- the library/host ABI contract as data.

   --write PATH  derive the contract from the sources and write it to PATH.
   --check       derive it and compare with the committed tests/abi.manifest; every difference is
                 printed as added / removed / changed and the exit code is 1.  An ABI change is then
                 a reviewed manifest diff, not a side effect of new product bytes.
   --selftest    copy the inputs to a scratch tree, break the contract one way at a time and
                 require every break to be reported.  The real sources are never edited.

   Reads sources only; never builds or runs the product under test.  Dynamic C: the product runs
   this file itself (`unisacc.com -run`).  tests/abimanifest.py and tests/abimanifestcheck.py are
   the earlier Python references; this file must write the same bytes as `abimanifest.py --write`.
   The rules below are those of the reference's docstring, with each regular expression spelled
   out as an explicit scan (the comments quote the expression a scan stands for).

   Line format: SECTION <tab> KEY <tab> VALUE, sorted by (SECTION, KEY).  A rule that stops
   matching its source is an error ("cannot derive"), never an empty section.

   Known difference from the reference: whitespace and identifier characters are ASCII here
   (Python's \s and \w also accept non-ASCII ones, and splitlines also breaks at U+0085,
   U+2028 and U+2029). */
#include <cx.h>

#define MANIFEST "tests/abi.manifest"
#define HEAD "# ABI contract manifest.  Generated by `python3 tests/abimanifest.py --write`; do not edit.\n" \
             "# Checked by tests/abimanifestcheck.py --check.  Rules: the docstring of tests/abimanifest.py.\n" \
             "# section\tkey\tvalue\n"

static const char *TABLE_DIRS[] = {"exec", "exec/lower", "exec/parse2", "exec/facts", "exec/enc", "exec/nativeabi", 0};
static const char *TABLE_WORDS[] = {"library", "ccinterop", "codeprivate", "hostbridge", "abi", "syscall", "sysprep", "signature",
    "modelinput", "modelbindings", "modelcandidates", "modelgraphequality", "layoutfacts",
    "layoutprovenance", "memorylayout", 0};

typedef struct { char *s; char *k; char *v; } Entry;
typedef struct { Entry *v; long n; long cap; } Entries;
typedef struct { char **v; long n; long cap; } Names;
typedef struct { char *b; long n; long cap; } Text;
typedef struct { char *name; char *sig; } Pair;

static char root[2048] = ".";
static char why[2048];
static int underived;
static Entries ents;
static Names inputs;

static void *xmalloc(long n) {
    void *p = malloc(n > 0 ? n : 1);
    if (!p) { fprintf(stderr, "abimanifestcheck.cx: out of memory\n"); exit(2); }
    return p;
}
static void cannot(const char *a, const char *b) {
    if (!underived) { snprintf(why, sizeof why, "%s%s", a, b ? b : ""); underived = 1; }
}
static void put(Text *t, const char *s, long n) {
    if (t->n + n + 1 > t->cap) {
        long cap = t->cap ? t->cap : 256; char *b;
        while (cap < t->n + n + 1) cap *= 2;
        b = xmalloc(cap);
        if (t->n) memcpy(b, t->b, t->n);
        if (t->b) free(t->b);
        t->b = b; t->cap = cap;
    }
    if (n) memcpy(t->b + t->n, s, n);
    t->n += n; t->b[t->n] = 0;
}
static void puts_(Text *t, const char *s) { put(t, s, (long)strlen(s)); }
static char *sdup(const char *s, long n) { char *o = xmalloc(n + 1); if (n) memcpy(o, s, n); o[n] = 0; return o; }
static void push(Names *v, const char *s) {
    if (v->n == v->cap) {
        long cap = v->cap ? 2 * v->cap : 64; char **g = xmalloc(cap * (long)sizeof *g);
        if (v->n) memcpy(g, v->v, v->n * sizeof *g);
        if (v->v) free(v->v);
        v->v = g; v->cap = cap;
    }
    v->v[v->n++] = sdup(s, (long)strlen(s));
}
static int has(const Names *v, const char *s) {
    long i;
    for (i = 0; i < v->n; i++) if (!strcmp(v->v[i], s)) return 1;
    return 0;
}
/* byte order, which for UTF-8 is Python's code point order */
static int order(const char *a, const char *b) {
    const unsigned char *x = (const unsigned char *)a, *y = (const unsigned char *)b;
    while (*x && *x == *y) { x++; y++; }
    return (int)*x - (int)*y;
}
static int by_name(const void *a, const void *b) { return order(*(char *const *)a, *(char *const *)b); }
static int by_key(const Entry *a, const Entry *b) {
    int c = order(a->s, b->s);
    return c ? c : order(a->k, b->k);
}
static int by_entry(const void *a, const void *b) {
    int c = by_key((const Entry *)a, (const Entry *)b);
    return c ? c : order(((const Entry *)a)->v, ((const Entry *)b)->v);
}

static int isws(int c) { return c == 32 || (c >= 9 && c <= 13) || (c >= 28 && c <= 31); }
static int isdig(int c) { return c >= '0' && c <= '9'; }
static int isw(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || isdig(c) || c == '_'; }

/* re.sub(r'\s+', ' ', text).strip() */
static char *squash(const char *t, long n) {
    char *o = xmalloc(n + 1); long i, k = 0; int gap = 0;
    for (i = 0; i < n; i++) {
        if (isws(t[i])) { gap = 1; continue; }
        if (gap && k) o[k++] = ' ';
        gap = 0; o[k++] = t[i];
    }
    o[k] = 0; return o;
}
/* re.sub(r'\s*\*\s*', '*', s), in place */
static void starfix(char *s) {
    long i = 0, k = 0, j;
    while (s[i]) {
        if (isws(s[i])) { j = i; while (isws(s[j])) j++; if (s[j] == '*') { i = j; continue; } }
        if (s[i] == '*') { s[k++] = '*'; i++; while (isws(s[i])) i++; continue; }
        s[k++] = s[i++];
    }
    s[k] = 0;
}
static int at(const char *t, long n, long i, const char *lit) {
    long m = (long)strlen(lit);
    return i >= 0 && i + m <= n && !memcmp(t + i, lit, m);
}
static long find(const char *t, long n, long from, const char *lit) {
    long m = (long)strlen(lit), i;
    for (i = from; i + m <= n; i++) if (t[i] == lit[0] && !memcmp(t + i, lit, m)) return i;
    return -1;
}
/* re.sub(r'/\*.*?\*\/', ' ', text, flags=re.S) */
static char *uncomment(const char *t, long n, long *outn) {
    char *o = xmalloc(n + 1); long i = 0, k = 0, e;
    while (i < n) {
        if (t[i] == '/' && i + 1 < n && t[i + 1] == '*' && (e = find(t, n, i + 2, "*/")) >= 0) { o[k++] = ' '; i = e + 2; continue; }
        o[k++] = t[i++];
    }
    o[k] = 0; *outn = k; return o;
}
/* str.splitlines: the line at i is [i, *end); returns where the next one starts */
static long line(const char *t, long n, long i, long *end) {
    long e = i;
    while (e < n && !(t[e] == '\n' || t[e] == '\r' || t[e] == 11 || t[e] == 12 || (t[e] >= 28 && t[e] <= 30))) e++;
    *end = e;
    if (e < n && t[e] == '\r' && e + 1 < n && t[e + 1] == '\n') return e + 2;
    return e + 1;
}

static void add(const char *s, const char *k, const char *v) {
    Entry *e;
    if (underived) return;
    if (ents.n == ents.cap) {
        long cap = ents.cap ? 2 * ents.cap : 512; Entry *g = xmalloc(cap * (long)sizeof *g);
        if (ents.n) memcpy(g, ents.v, ents.n * sizeof *g);
        if (ents.v) free(ents.v);
        ents.v = g; ents.cap = cap;
    }
    e = &ents.v[ents.n++];
    e->s = sdup(s, (long)strlen(s)); e->k = sdup(k, (long)strlen(k)); e->v = squash(v, (long)strlen(v));
}
static char *cat(const char *a, const char *b) {
    long x = (long)strlen(a), y = (long)strlen(b); char *o = xmalloc(x + y + 1);
    memcpy(o, a, x); memcpy(o + x, b, y); o[x + y] = 0; return o;
}

/* a ROOT-relative input, whole; 0 (and "cannot derive") when it cannot be read */
static char *rd(const char *rel, long *n) {
    char path[4096]; size_t len = 0; char *b;
    snprintf(path, sizeof path, "%s/%s", root, rel);
    b = cx_read(path, &len);
    if (!b) { cannot("cannot read ", rel); *n = 0; return 0; }
    if (!has(&inputs, rel)) push(&inputs, rel);
    *n = (long)len; return b;
}
/* regular files DIR/PREFIX*SUFFIX under ROOT, appended as ROOT-relative paths (unsorted) */
static void list(const char *dir, const char *prefix, const char *suffix, Names *out) {
    char path[4096]; DIR *d; struct dirent *e; struct stat st;
    long pl = (long)strlen(prefix), sl = (long)strlen(suffix), l;
    snprintf(path, sizeof path, "%s/%s", root, dir);
    d = opendir(path);
    if (!d) return;
    while ((e = readdir(d))) {
        l = (long)strlen(e->d_name);
        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
        if (l < pl + sl || memcmp(e->d_name, prefix, pl) || memcmp(e->d_name + l - sl, suffix, sl)) continue;
        snprintf(path, sizeof path, "%s/%s/%s", root, dir, e->d_name);
        if (stat(path, &st) != 0 || !S_ISREG(st.st_mode)) continue;
        snprintf(path, sizeof path, "%s/%s", dir, e->d_name);
        push(out, path);
    }
    closedir(d);
}
static void sortnames(Names *v) { if (v->n > 1) qsort(v->v, v->n, sizeof *v->v, by_name); }

/* `int f(const char *name, size_t n)` -> `int(const char*,size_t)`: names are not ABI.
   Result t[rb,re), parameters t[pb,pe). */
static char *types_only(const char *t, long rb, long re, long pb, long pe) {
    Text o; char *r, *p; long i, a = pb, s, e, b; char keep;
    memset(&o, 0, sizeof o);
    r = squash(t + rb, re - rb); starfix(r); puts_(&o, r); puts_(&o, "("); free(r);
    for (i = pb; i <= pe; i++) {
        if (i < pe && t[i] != ',') continue;
        p = squash(t + a, i - a);
        e = (long)strlen(p); s = e;
        while (s > 0 && isw(p[s - 1])) s--;
        if (s < e && !isdig(p[s])) {                   /* re.sub(r'\b[A-Za-z_]\w*$', '', p).strip() */
            b = s; while (b > 0 && p[b - 1] == ' ') b--;
            keep = p[b]; p[b] = 0;
            if (!b || !strcmp(p, "const") || !strcmp(p, "unsigned") || !strcmp(p, "struct")) p[b] = keep;
        }
        starfix(p);
        if (a != pb) puts_(&o, ",");
        puts_(&o, p); free(p); a = i + 1;
    }
    puts_(&o, ")");
    return o.b;
}

/* the rest of an export after its result type: `us_\w+\s*\(([^)]*)\)\s*;` (or `{` for a definition) at q */
static int export_tail(const char *t, long n, long q, int def, long *e, long *r, long *c, long *k) {
    if (q < 1 || isw(t[q - 1]) || !at(t, n, q, "us_") || q + 3 >= n || !isw(t[q + 3])) return 0;
    *e = q + 3; while (*e < n && isw(t[*e])) (*e)++;
    *r = *e; while (*r < n && isws(t[*r])) (*r)++;
    if (*r >= n || t[*r] != '(') return 0;
    *c = *r + 1; while (*c < n && t[*c] != ')') (*c)++;
    if (*c >= n) return 0;
    *k = *c + 1; while (*k < n && isws(t[*k])) (*k)++;
    return *k < n && t[*k] == (def ? '{' : ';');
}
/* header:      r'\bUS_API\s+([^;(]+?)\b(us_\w+)\s*\(([^)]*)\)\s*;'
   definitions: r'^API\s+([^;(\n]+?)\b(us_\w+)\s*\(([^)]*)\)\s*\{'  (re.M)
   A repeated name replaces the earlier one, as in a dict.  Returns the number of distinct names. */
static long exports(const char *t, long n, int def, Pair *out, long max) {
    long i = 0, count = 0, p, w, g, q, e = 0, r = 0, c = 0, k = 0, j; int ok; char *name;
    while (i < n) {
        if (def ? !((i == 0 || t[i - 1] == '\n') && at(t, n, i, "API")) : !((i == 0 || !isw(t[i - 1])) && at(t, n, i, "US_API"))) { i++; continue; }
        w = i + (def ? 3 : 6); p = w;
        while (p < n && isws(t[p])) p++;
        if (p == w) { i++; continue; }
        g = p; ok = 0;
        for (q = g + 1; q < n; q++) {
            if (t[q - 1] == ';' || t[q - 1] == '(' || (def && t[q - 1] == '\n')) break;
            if (export_tail(t, n, q, def, &e, &r, &c, &k)) { ok = 1; break; }
        }
        /* \s+ gives one character back so that the result type is that single space */
        if (!ok && g - w >= 2 && !(def && t[g - 1] == '\n') && export_tail(t, n, g, def, &e, &r, &c, &k)) { ok = 1; q = g; }
        if (!ok) { i++; continue; }
        name = sdup(t + q, e - q);
        for (j = 0; j < count; j++) if (!strcmp(out[j].name, name)) break;
        if (j == count) {
            if (count == max) { cannot("too many exports", 0); return count; }
            out[count++].name = name;
        }
        out[j].sig = types_only(t, g, q, r + 1, c);
        i = k + 1;
    }
    return count;
}
static long count(const char *t, long n, const char *lit) {
    long m = (long)strlen(lit), i = 0, c = 0;
    while ((i = find(t, n, i, lit)) >= 0) { c++; i += m; }
    return c;
}

/* r'typedef\s+struct\s+(\w+)\s*\{(.*?)\}\s*(\w+)\s*;' (re.S): fields in order, by the typedef name */
static void structs(const char *t, long n) {
    long i = 0, p, b, c = 0, r = 0, nb = 0, ne = 0, a, j, found = 0; int ok; Text v; char *name, *f;
    while (i < n) {
        if (!at(t, n, i, "typedef")) { i++; continue; }
        p = i + 7;
        if (p >= n || !isws(t[p])) { i++; continue; }
        while (p < n && isws(t[p])) p++;
        if (!at(t, n, p, "struct")) { i++; continue; }
        p += 6;
        if (p >= n || !isws(t[p])) { i++; continue; }
        while (p < n && isws(t[p])) p++;
        b = p; while (p < n && isw(t[p])) p++;
        if (p == b) { i++; continue; }
        while (p < n && isws(t[p])) p++;
        if (p >= n || t[p] != '{') { i++; continue; }
        b = p + 1; ok = 0;
        for (c = b; c < n; c++) {
            if (t[c] != '}') continue;
            r = c + 1; while (r < n && isws(t[r])) r++;
            nb = r; while (r < n && isw(t[r])) r++;
            ne = r; if (ne == nb) continue;
            while (r < n && isws(t[r])) r++;
            if (r < n && t[r] == ';') { ok = 1; break; }
        }
        if (!ok) { i++; continue; }
        memset(&v, 0, sizeof v); puts_(&v, "");
        for (a = b, j = b; j <= c; j++) {
            if (j < c && t[j] != ';') continue;
            f = squash(t + a, j - a);
            if (*f) { if (v.n) puts_(&v, "; "); puts_(&v, f); }
            free(f); a = j + 1;
        }
        name = sdup(t + nb, ne - nb);
        add("struct", name, v.b); found++;
        i = r + 1;
    }
    if (!found) cannot("no public struct in libunisacc.h", 0);
}

/* re.search(re.escape(declaration) + r'\s*=\s*\{(.*?)\};', text, re.S), then
   re.split(r',(?![^()]*\))', group): a comma splits unless the next parenthesis after it closes one. */
static long initializer(const char *t, long n, const char *decl, char **items, long max) {
    long i = 0, p, g = -1, e = -1, a, j, k, cnt = 0, m = (long)strlen(decl);
    while ((i = find(t, n, i, decl)) >= 0) {
        p = i + m; while (p < n && isws(t[p])) p++;
        if (p < n && t[p] == '=') {
            p++; while (p < n && isws(t[p])) p++;
            if (p < n && t[p] == '{' && (e = find(t, n, p + 1, "};")) >= 0) { g = p + 1; break; }
        }
        i++;
    }
    if (g < 0) { cannot("no initializer ", decl); return 0; }
    for (a = g, j = g; j <= e; j++) {
        if (j < e) {
            if (t[j] != ',') continue;
            for (k = j + 1; k < e && t[k] != '(' && t[k] != ')'; k++) ;
            if (k < e && t[k] == ')') continue;
        }
        if (cnt == max) { cannot("too many items in ", decl); return 0; }
        items[cnt++] = squash(t + a, j - a); a = j + 1;
    }
    return cnt;
}

/* r'^(static [^\n;{}]*\bNAME\s*\([^)]*\))\s*\{' (re.M), exactly once; the body by brace counting.
   Signature t[*sb,*se), body t[*bb,*be).  0 when not derivable. */
static int function(const char *t, long n, const char *name, long *sb, long *se, long *bb, long *be) {
    long i = 0, e, q, r, c, k, m = (long)strlen(name), found = 0, brace = 0, depth = 0, x; char num[32];
    while (i < n) {
        if (!((i == 0 || t[i - 1] == '\n') && at(t, n, i, "static "))) { i++; continue; }
        e = i + 7; while (e < n && t[e] != '\n' && t[e] != ';' && t[e] != '{' && t[e] != '}') e++;
        k = -1;
        for (q = e; q >= i + 7; q--) {
            if (isw(t[q - 1]) || !at(t, n, q, name)) continue;
            r = q + m; while (r < n && isws(t[r])) r++;
            if (r >= n || t[r] != '(') continue;
            c = r + 1; while (c < n && t[c] != ')') c++;
            if (c >= n) continue;
            k = c + 1; while (k < n && isws(t[k])) k++;
            if (k < n && t[k] == '{') break;
            k = -1;
        }
        if (k < 0) { i++; continue; }
        if (!found) { *sb = i; *se = c + 1; brace = k; }
        found++; i = k + 1;
    }
    if (found != 1) { snprintf(num, sizeof num, "%ld definitions of ", found); cannot(num, name); return 0; }
    for (x = brace; x < n; x++) {
        if (t[x] == '{') depth++;
        if (t[x] == '}') depth--;
        if (depth == 0) break;
    }
    if (depth != 0 || x >= n) { cannot("unbalanced body of ", name); return 0; }
    *bb = brace + 1; *be = x;
    return 1;
}

/* r'\s*(if\s*\(.*?\)\s*(?:\{.*?\}|return[^;]*;))' matched at the start of code (re.S) */
static char *leading_guard(const char *t, long n) {
    long p = 0, b, c, r, e;
    while (p < n && isws(t[p])) p++;
    b = p;
    if (!at(t, n, p, "if")) return 0;
    p += 2; while (p < n && isws(t[p])) p++;
    if (p >= n || t[p] != '(') return 0;
    for (c = p + 1; c < n; c++) {
        if (t[c] != ')') continue;
        r = c + 1; while (r < n && isws(t[r])) r++;
        if (r < n && t[r] == '{') { e = find(t, n, r + 1, "}"); if (e >= 0) return sdup(t + b, e + 1 - b); }
        else if (at(t, n, r, "return")) { e = find(t, n, r + 6, ";"); if (e >= 0) return sdup(t + b, e + 1 - b); }
    }
    return 0;
}
/* the body must be r'\s*#ifdef _WIN32\n(.*?)\n#else\n(.*?)\n#endif\s*' in full (re.S) */
static void guards(const char *library, long n, const char *name) {
    long sb, se, bb, be, m, p, e, f, x, tail; char *body, *g, *key; int arm;
    if (underived || !function(library, n, name, &sb, &se, &bb, &be)) return;
    body = uncomment(library + bb, be - bb, &m);
    p = 0; while (p < m && isws(body[p])) p++;
    e = -1; f = -1;
    if (at(body, m, p, "#ifdef _WIN32\n")) {
        p += 14;
        e = find(body, m, p, "\n#else\n");
        if (e >= 0) {
            for (f = find(body, m, e + 7, "\n#endif"); f >= 0; f = find(body, m, f + 1, "\n#endif")) {
                tail = 1;
                for (x = f + 7; x < m; x++) if (!isws(body[x])) tail = 0;
                if (tail) break;
            }
        }
    }
    if (e < 0 || f < 0) { cannot(name, " is not one #ifdef _WIN32 / #else / #endif"); return; }
    for (arm = 0; arm < 2; arm++) {
        g = arm ? leading_guard(body + e + 7, f - (e + 7)) : leading_guard(body + p, e - p);
        if (!g) { cannot(arm ? "no leading guard (posix) in " : "no leading guard (windows) in ", name); return; }
        key = cat(name, arm ? "/posix" : "/windows");
        add("guard", key, g);
        free(key); free(g);
    }
    free(body);
}

static void derive_library(void) {
    long hn0, hn, ln, i, j, k, o, nd, nf, napi, nn, nv, nl, sb, se, bb, be, tn, bl; int ok;
    char *raw, *un, *header, *library, *value, *text = 0, *body, *sig, *sq, *b, hex[65], key[32], num[32];
    Pair declared[256], defined[256]; char *names[256], *values[256], *lengths[256];
    Names libs; Text all, line_;
    raw = rd("exec/c/libunisacc.h", &hn0);
    if (!raw) return;
    /* header = re.sub(r'^\s*#.*$', '', uncomment(text), flags=re.M) */
    un = uncomment(raw, hn0, &hn0); header = xmalloc(hn0 + 1);
    for (i = 0, o = 0; i < hn0; ) {
        if (i == 0 || un[i - 1] == '\n') {
            j = i; while (j < hn0 && isws(un[j])) j++;
            if (j < hn0 && un[j] == '#') { while (j < hn0 && un[j] != '\n') j++; i = j; if (i < hn0) header[o++] = un[i++]; continue; }
        }
        header[o++] = un[i++];
    }
    header[o] = 0; hn = o;
    library = rd("exec/c/libunisacc.c", &ln);
    if (!library) return;
    nd = exports(header, hn, 0, declared, 256);
    nf = exports(library, ln, 1, defined, 256);
    if (underived) return;
    if (!nd) { cannot("no US_API declaration in exec/c/libunisacc.h", 0); return; }
    if (count(header, hn, "US_API") != nd) { cannot("a US_API line in libunisacc.h is not a function declaration this rule reads", 0); return; }
    for (i = 0, napi = 0; i < ln; i++)
        if ((i == 0 || library[i - 1] == '\n') && at(library, ln, i, "API") && !(i + 3 < ln && isw(library[i + 3]))) napi++;
    if (napi != nf) { cannot("an API definition in libunisacc.c is not read by this rule", 0); return; }
    memset(&line_, 0, sizeof line_);
    for (i = 0; i < nd; i++) {
        for (j = 0; j < nf; j++) if (!strcmp(declared[i].name, defined[j].name)) break;
        if (j == nf || strcmp(declared[i].sig, defined[j].sig)) { puts_(&line_, line_.n ? ", " : ""); puts_(&line_, declared[i].name); }
    }
    for (j = 0; j < nf; j++) {
        for (i = 0; i < nd; i++) if (!strcmp(declared[i].name, defined[j].name)) break;
        if (i == nd) { puts_(&line_, line_.n ? ", " : ""); puts_(&line_, defined[j].name); }
    }
    if (line_.n) { cannot("header and definition disagree: ", line_.b); return; }
    for (i = 0; i < nd; i++) add("export", declared[i].name, declared[i].sig);
    structs(header, hn);
    b = rd("exec/c/buildlibrary.py", &bl);
    if (!b) return;
    add("visibility", "exec/c/buildlibrary.py", find(b, bl, 0, "'-fvisibility=hidden'") >= 0 ? "hidden" : "DEFAULT");
    free(b);

    /* callback, callback-fn */
    nn = initializer(library, ln, "const char *names[]", names, 256);
    nv = initializer(library, ln, "uint64_t vals[]", values, 256);
    nl = initializer(library, ln, "int lengths[]", lengths, 256);
    if (underived) return;
    if (nn != nv || nv != nl) { cannot("names/vals/lengths differ in length", 0); return; }
    snprintf(num, sizeof num, "%ld", nn);
    b = cat(cat("for (int i=0;i<", num), ";i++) {resource_u64(scalar[i],vals[i])");
    if (find(library, ln, 0, b) < 0) { cannot("the resource loop bound is not the array length", 0); return; }
    for (i = 0; i < nn && !underived; i++) {
        k = (long)strlen(names[i]);                    /* re.fullmatch(r'"\\0[^"\\]+"', name) */
        ok = k >= 5 && names[i][0] == '"' && names[i][1] == '\\' && names[i][2] == '0' && names[i][k - 1] == '"';
        for (j = 3; ok && j < k - 1; j++) if (names[i][j] == '"' || names[i][j] == '\\') ok = 0;
        if (!ok) { cannot("resource name not a \\0 literal: ", names[i]); return; }
        for (j = 0, o = 0; isdig(lengths[i][j]) && j < 9; j++) o = o * 10 + (lengths[i][j] - '0');
        if (!j || lengths[i][j] || o != k - 4 + 1) { cannot(cat(cat("declared length of ", names[i]), " is "), lengths[i]); return; }
        memset(&line_, 0, sizeof line_);
        put(&line_, names[i] + 1, k - 2); puts_(&line_, " = "); puts_(&line_, values[i]);
        puts_(&line_, " (n="); puts_(&line_, lengths[i]); puts_(&line_, ")");
        snprintf(key, sizeof key, "%02ld", i);
        add("callback", key, line_.b);
        value = values[i];                             /* re.fullmatch(r'\(uintptr_t\)([A-Za-z_]\w*)', value) */
        if (strncmp(value, "(uintptr_t)", 11) || !value[11] || isdig(value[11])) continue;
        for (j = 11; value[j] && isw(value[j]); j++) ;
        if (value[j]) continue;
        if (!text) {                                   /* libunisacc.c, a newline, then every exec/c/library*.h */
            memset(&libs, 0, sizeof libs); memset(&all, 0, sizeof all);
            list("exec/c", "library", ".h", &libs); sortnames(&libs);
            put(&all, library, ln); puts_(&all, "\n");
            for (j = 0; j < libs.n; j++) { b = rd(libs.v[j], &bl); if (!b) return; put(&all, b, bl); free(b); }
            text = all.b; tn = all.n;
        }
        if (!function(text, tn, value + 11, &sb, &se, &bb, &be)) return;
        sig = squash(text + sb, se - sb); body = squash(text + bb, be - bb);
        cx_sha256_hex(body, strlen(body), hex);
        sq = cat(cat(sig, " body-sha256="), hex);
        add("callback-fn", value + 11, sq);
        free(sig); free(body);
    }
    guards(library, ln, "library_mmap");
    guards(library, ln, "library_munmap");
}

/* resource: r'"\\0([^"\\]+)"' in exec/c/*.c, exec/c/*.h, exec/c/asm/*.c, by file and order */
static void derive_resources(void) {
    Names files; long f, n, i, e, ordinal; char *t, *lit, key[4200];
    memset(&files, 0, sizeof files);
    list("exec/c", "", ".c", &files); list("exec/c", "", ".h", &files); list("exec/c/asm", "", ".c", &files);
    sortnames(&files);
    for (f = 0; f < files.n && !underived; f++) {
        t = rd(files.v[f], &n);
        if (!t) return;
        for (i = 0, ordinal = 0; i + 4 < n; ) {
            if (t[i] != '"' || t[i + 1] != '\\' || t[i + 2] != '0') { i++; continue; }
            e = i + 3; while (e < n && t[e] != '"' && t[e] != '\\') e++;
            if (e == i + 3 || e >= n || t[e] != '"') { i++; continue; }
            lit = sdup(t + i + 3, e - (i + 3));
            snprintf(key, sizeof key, "%s#%03ld", files.v[f], ordinal++);
            add("resource", key, lit); free(lit);
            i = e + 1;
        }
        free(t);
    }
}

/* dlslot: each `if (i == N) return X;` of src/host_dl.h with the preprocessor conditions around it */
static void derive_dlslots(void) {
    long n, i, next, e, a, b, p, d, depth = 0, found = 0, j; char *t, *stack[64], *s, *value; Text key;
    t = rd("src/host_dl.h", &n);
    if (!t) return;
    for (i = 0; i < n; i = next) {
        next = line(t, n, i, &e);
        a = i; b = e;
        while (a < b && isws(t[a])) a++;
        while (b > a && isws(t[b - 1])) b--;
        s = t + a;
        if (a < b && s[0] == '#') {
            p = 1; while (a + p < b && isws(s[p])) p++;
            if (at(s, b - a, p, "if")) {
                if (depth == 64) { cannot("#if nesting too deep in host_dl.h", 0); return; }
                stack[depth++] = squash(s, b - a);
            } else if (at(s, b - a, p, "else")) {
                if (!depth) { cannot("unbalanced #else in host_dl.h", 0); return; }
                stack[depth - 1] = cat("else of ", stack[depth - 1]);
            } else if (at(s, b - a, p, "endif")) {
                if (!depth) { cannot("unbalanced #endif in host_dl.h", 0); return; }
                depth--;
            }
        }
        /* r'if \(i == (\d+)\) return (.*);$' */
        if (!at(s, b - a, 0, "if (i == ")) continue;
        p = 9; d = p; while (a + p < b && isdig(s[p])) p++;
        if (p == d || !at(s, b - a, p, ") return ") || s[b - a - 1] != ';' || b - a - 1 < p + 9) continue;
        memset(&key, 0, sizeof key); puts_(&key, "");
        for (j = 0; j < depth; j++) { if (j) puts_(&key, " && "); puts_(&key, stack[j]); }
        puts_(&key, " | "); put(&key, s + d, p - d);
        value = sdup(s + p + 9, b - a - 1 - (p + 9));
        add("dlslot", key.b, value); found++;
        free(value); free(key.b);
    }
    if (!found || depth) cannot("no loader slot rule found in src/host_dl.h", 0);
    free(t);
}

/* gate: r'^    if \((isname\(t, "__.*?)\) \{' (re.M|re.S) blocks of src/front_parse.c that emit a
   dot-directive (r'es\("  (\.[a-z0-9]+)') before the block's closing `\n    }\n`; one line per
   r'isname\(t, "(__\w+)", (\d+)\)' in the condition. */
static void derive_gates(void) {
    static const char *opener = "    if (isname(t, \"__";
    long n, i = 0, gb, ge, bend, rend, j, e, k, x, y, len, gates = 0, m = (long)strlen(opener);
    char *t, *emitted[64], *tmp, *name; long ne; Text v;
    t = rd("src/front_parse.c", &n);
    if (!t) return;
    while (i < n && !underived) {
        if (!((i == 0 || t[i - 1] == '\n') && at(t, n, i, opener))) { i++; continue; }
        ge = find(t, n, i + m, ") {");
        if (ge < 0) break;
        gb = i + 8; bend = ge + 3; i = bend;
        rend = find(t, n, bend, "\n    }\n");
        if (rend < 0) rend = n - 1 > bend ? n - 1 : bend;          /* the reference's parser[end:-1] */
        for (j = bend, ne = 0; j < rend; j++) {
            if (!at(t, rend, j, "es(\"  .")) continue;
            e = j + 7; while (e < rend && ((t[e] >= 'a' && t[e] <= 'z') || isdig(t[e]))) e++;
            if (e == j + 7) continue;
            tmp = sdup(t + j + 6, e - (j + 6));
            for (k = 0; k < ne; k++) if (!strcmp(emitted[k], tmp)) break;
            if (k == ne) { if (ne == 64) { cannot("too many directives in one gate block", 0); return; } emitted[ne++] = tmp; }
            j = e - 1;
        }
        if (!ne) continue;
        qsort(emitted, ne, sizeof *emitted, by_name);
        memset(&v, 0, sizeof v);
        for (k = 0; k < ne; k++) { if (k) puts_(&v, " "); puts_(&v, emitted[k]); }
        for (j = gb; j < ge; j++) {
            if (!at(t, ge, j, "isname(t, \"__")) continue;
            x = j + 11; e = x + 2; while (e < ge && isw(t[e])) e++;
            if (e == x + 2 || !at(t, ge, e, "\", ")) continue;
            y = e + 3; k = y; len = 0; while (k < ge && isdig(t[k])) { if (len < 100000) len = len * 10 + (t[k] - '0'); k++; }
            if (k == y || k >= ge || t[k] != ')') continue;
            name = sdup(t + x, e - x);
            if (e - x != len) { cannot("isname length does not match the name ", name); return; }
            add("gate", name, v.b); gates++;
            j = k;
        }
    }
    if (!gates) cannot("no syscall gate found in src/front_parse.c", 0);
    free(t);
}

/* image-path: r'"(/[^"\\]+)"' in src/back_image.c */
static void derive_image_paths(void) {
    long n, i, e, ordinal = 0; char *t, *path, key[32];
    t = rd("src/back_image.c", &n);
    if (!t) return;
    for (i = 0; i + 3 < n; ) {
        if (t[i] != '"' || t[i + 1] != '/') { i++; continue; }
        e = i + 2; while (e < n && t[e] != '"' && t[e] != '\\') e++;
        if (e == i + 2 || e >= n || t[e] != '"') { i++; continue; }
        path = sdup(t + i + 1, e - (i + 1));
        snprintf(key, sizeof key, "%02ld", ordinal++);
        add("image-path", key, path); free(path);
        i = e + 1;
    }
    if (!ordinal) cannot("no absolute path literal in src/back_image.c", 0);
    free(t);
}

/* parse2-call: the `call` rows of exec/parse2/body-manifest.tsv whose stem starts with `library` */
static void derive_parse2_calls(void) {
    long n, i, next, e, j, ordinal = 0; char *t, *row, key[32];
    t = rd("exec/parse2/body-manifest.tsv", &n);
    if (!t) return;
    for (i = 0; i < n; i = next) {
        next = line(t, n, i, &e);
        if (!at(t, e, i, "call\tlibrary")) continue;
        row = sdup(t + i + 5, e - (i + 5));
        for (j = 0; row[j]; j++) if (row[j] == '\t') row[j] = ' ';
        snprintf(key, sizeof key, "%02ld", ordinal++);
        add("parse2-call", key, row); free(row);
    }
    if (!ordinal) cannot("no library call in exec/parse2/body-manifest.tsv", 0);
    free(t);
}

static int abi_word(const char *name) {
    int w;
    for (w = 0; TABLE_WORDS[w]; w++) if (strstr(name, TABLE_WORDS[w])) return 1;
    return 0;
}
static const char *basename_(const char *path) {
    const char *s = strrchr(path, '/');
    return s ? s + 1 : path;
}
/* table, table-dep, bridge */
static void derive_tables(void) {
    Names all, tables, bridge; long d, f, n, i, next, e, j, k, a, tabs, col[5], fb, fe, sl;
    char *t, hex[65], value[160], *stem, *fact, *key, *path;
    memset(&all, 0, sizeof all); memset(&tables, 0, sizeof tables); memset(&bridge, 0, sizeof bridge);
    for (d = 0; TABLE_DIRS[d]; d++) list(TABLE_DIRS[d], "", ".tsv", &all);
    sortnames(&all);
    for (f = 0; f < all.n; f++)
        if (!strncmp(all.v[f], "exec/nativeabi/", 15) || abi_word(basename_(all.v[f]))) push(&tables, all.v[f]);
    if (!tables.n) { cannot("no ABI table found", 0); return; }
    for (f = 0; f < tables.n && !underived; f++) {
        t = rd(tables.v[f], &n);
        if (!t) return;
        cx_sha256_hex(t, n, hex);
        snprintf(value, sizeof value, "sha256=%s bytes=%ld", hex, n);
        add("table", tables.v[f], value);
        sl = (long)strlen(tables.v[f]);
        if (sl < 13 || strcmp(tables.v[f] + sl - 13, "-manifest.tsv")) { free(t); continue; }
        for (i = 0; i < n; i = next) {
            next = line(t, n, i, &e);
            if (i < e && t[i] == '#') continue;
            for (j = i, tabs = 0; j < e && tabs < 5; j++) if (t[j] == '\t') col[tabs++] = j;
            if (tabs < 4) continue;                    /* fewer than five fields */
            stem = sdup(t + col[0] + 1, col[1] - (col[0] + 1));
            a = (long)strlen(stem);                    /* PurePosixPath(stem).name */
            while (a > 1 && stem[a - 1] == '/') a--;
            path = sdup(stem, a);
            if (strcmp(stem, "-") && !abi_word(strcmp(basename_(path), ".") ? basename_(path) : "")) {
                key = cat(cat(tables.v[f], " stem "), stem);
                add("table-dep", key, "unhashed"); free(key);
            }
            free(path); free(stem);
            fb = col[3] + 1; fe = tabs == 5 ? col[4] : e;
            for (a = fb, k = fb; k <= fe; k++) {
                if (k < fe && t[k] != '+') continue;
                fact = at(t, k, a, "fact:") ? sdup(t + a + 5, k - (a + 5)) : sdup(t + a, k - a);
                a = k + 1;
                if (!*fact || !strcmp(fact, "-")) { free(fact); continue; }
                path = cat(cat("exec/facts/", fact), ".tsv");
                if (!has(&tables, path)) {
                    key = cat(cat(tables.v[f], " facts "), fact);
                    add("table-dep", key, "unhashed"); free(key);
                }
                free(path); free(fact);
            }
        }
        free(t);
    }
    list("exec/c", "library", ".h", &bridge); list("exec/c", "librarycall", ".S", &bridge);
    sortnames(&bridge);
    push(&bridge, "exec/c/forwardsignature.h"); push(&bridge, "src/host_dl.h");
    for (f = 0; f < bridge.n && !underived; f++) {
        t = rd(bridge.v[f], &n);
        if (!t) return;
        cx_sha256_hex(t, n, hex);
        snprintf(value, sizeof value, "sha256=%s", hex);
        add("bridge", bridge.v[f], value);
        free(t);
    }
}

/* The sorted entries of the tree at root into ents (and every file read into inputs).  0 when a
   rule no longer matches its source; why says which. */
static int derive(void) {
    long i, k;
    ents.n = 0; inputs.n = 0; underived = 0; why[0] = 0;
    derive_library();
    if (!underived) derive_resources();
    if (!underived) derive_dlslots();
    if (!underived) derive_gates();
    if (!underived) derive_image_paths();
    if (!underived) derive_parse2_calls();
    if (!underived) derive_tables();
    if (underived) return 0;
    if (ents.n > 1) qsort(ents.v, ents.n, sizeof *ents.v, by_entry);
    for (i = 0, k = 0; i < ents.n; i++)
        if (!k || by_entry(&ents.v[k - 1], &ents.v[i])) ents.v[k++] = ents.v[i];
    ents.n = k;
    for (i = 1; i < ents.n; i++)
        if (!by_key(&ents.v[i - 1], &ents.v[i])) { cannot("duplicate manifest key ", ents.v[i].k); return 0; }
    return 1;
}
static void render(Text *o) {
    long i;
    puts_(o, HEAD);
    for (i = 0; i < ents.n; i++) {
        puts_(o, ents.v[i].s); puts_(o, "\t"); puts_(o, ents.v[i].k); puts_(o, "\t"); puts_(o, ents.v[i].v); puts_(o, "\n");
    }
}

/* Compare the tree at root with its committed manifest; the readable lines go to out.  1 when
   they differ or nothing could be derived. */
static int check(Text *out) {
    char path[4096]; char *text; size_t len = 0; long n, i, next, e, t1, t2, j, a, b; int c;
    Entries old; Entry row; Text now;
    memset(&old, 0, sizeof old); memset(&now, 0, sizeof now); puts_(out, "");
    if (!derive()) { puts_(out, "  FAIL cannot derive the contract: "); puts_(out, why); puts_(out, "\n"); return 1; }
    snprintf(path, sizeof path, "%s/%s", root, MANIFEST);
    text = cx_read(path, &len); n = (long)len;
    if (!text) { puts_(out, "  FAIL no committed manifest (cannot read): " MANIFEST "\n"); return 1; }
    old.v = xmalloc((n / 4 + 1) * (long)sizeof *old.v);
    for (i = 0; i < n; i = next) {
        next = line(text, n, i, &e);
        if (i == e || text[i] == '#') continue;
        for (t1 = i; t1 < e && text[t1] != '\t'; t1++) ;
        for (t2 = t1 + 1; t2 < e && text[t2] != '\t'; t2++) ;
        if (t2 >= e) { puts_(out, "  FAIL " MANIFEST " is not section<tab>key<tab>value\n"); return 1; }
        row.s = sdup(text + i, t1 - i); row.k = sdup(text + t1 + 1, t2 - (t1 + 1)); row.v = sdup(text + t2 + 1, e - (t2 + 1));
        for (j = 0; j < old.n; j++) if (!by_key(&old.v[j], &row)) break;     /* a repeated key: the last one counts */
        old.v[j] = row;
        if (j == old.n) old.n++;
    }
    if (old.n > 1) qsort(old.v, old.n, sizeof *old.v, by_entry);
    for (a = 0, b = 0; a < old.n || b < ents.n; ) {
        c = a == old.n ? 1 : b == ents.n ? -1 : by_key(&old.v[a], &ents.v[b]);
        if (c > 0) {
            puts_(out, "  added    "); puts_(out, ents.v[b].s); puts_(out, " "); puts_(out, ents.v[b].k);
            puts_(out, " = "); puts_(out, ents.v[b].v); puts_(out, "\n"); b++;
        } else if (c < 0) {
            puts_(out, "  removed  "); puts_(out, old.v[a].s); puts_(out, " "); puts_(out, old.v[a].k);
            puts_(out, " (was "); puts_(out, old.v[a].v); puts_(out, ")\n"); a++;
        } else {
            if (strcmp(old.v[a].v, ents.v[b].v)) {
                puts_(out, "  changed  "); puts_(out, old.v[a].s); puts_(out, " "); puts_(out, old.v[a].k);
                puts_(out, "\n             manifest: "); puts_(out, old.v[a].v);
                puts_(out, "\n             sources:  "); puts_(out, ents.v[b].v); puts_(out, "\n");
            }
            a++; b++;
        }
    }
    render(&now);
    if (!out->n && (now.n != n || memcmp(now.b, text, n))) puts_(out, "  changed  formatting or order of " MANIFEST " (regenerate it)\n");
    if (!ents.n) puts_(out, "  FAIL nothing derived\n");
    free(text); free(now.b);
    return out->n != 0;
}

/* ---- self-test: scratch copies only ---- */
static char base[2048], scratch[2048];
static Names dirty;
static int stfail;

static void mkparents(const char *path) {
    char b[4096]; long i;
    snprintf(b, sizeof b, "%s", path);
    for (i = 1; b[i]; i++) if (b[i] == '/') { b[i] = 0; mkdir(b, 0777); b[i] = '/'; }
}
static void copy_in(const char *rel) {
    char from[4096], to[4096]; size_t n = 0; char *b;
    snprintf(from, sizeof from, "%s/%s", base, rel); snprintf(to, sizeof to, "%s/%s", scratch, rel);
    b = cx_read(from, &n);
    mkparents(to);
    if (!b || cx_write(to, b, n)) { printf("selftest FAIL: cannot copy %s\n", rel); stfail = 1; }
    if (b) free(b);
}
static void rmtree(const char *dir) {
    DIR *d = opendir(dir); struct dirent *e; struct stat st; Names v; long i; char path[4096];
    memset(&v, 0, sizeof v);
    if (d) {
        while ((e = readdir(d))) if (strcmp(e->d_name, ".") && strcmp(e->d_name, "..")) push(&v, e->d_name);
        closedir(d);
    }
    for (i = 0; i < v.n; i++) {
        snprintf(path, sizeof path, "%s/%s", dir, v.v[i]);
        if (lstat(path, &st) == 0 && S_ISDIR(st.st_mode)) rmtree(path); else unlink(path);
        free(v.v[i]);
    }
    if (v.v) free(v.v);
    rmdir(dir);
}
/* Replace the one occurrence of old in the scratch copy of rel. */
static void edit(const char *rel, const char *old, const char *new_) {
    char path[4096]; size_t len = 0; char *b; long n, i, m = (long)strlen(old); Text o;
    snprintf(path, sizeof path, "%s/%s", scratch, rel);
    b = cx_read(path, &len); n = (long)len;
    if (!b || count(b, n, old) != 1) { printf("selftest FAIL: %s: the fixture text does not occur exactly once: %s\n", rel, old); stfail = 1; return; }
    i = find(b, n, 0, old);
    memset(&o, 0, sizeof o);
    put(&o, b, i); puts_(&o, new_); put(&o, b + i + m, n - (i + m));
    if (cx_write(path, o.b, o.n)) { printf("selftest FAIL: cannot write %s\n", path); stfail = 1; }
    push(&dirty, rel); free(b); free(o.b);
}
static void append(const char *rel, const char *more) {
    char path[4096]; size_t len = 0; char *b; Text o;
    snprintf(path, sizeof path, "%s/%s", scratch, rel);
    b = cx_read(path, &len);
    if (!b) { printf("selftest FAIL: cannot read %s\n", path); stfail = 1; return; }
    memset(&o, 0, sizeof o); put(&o, b, (long)len); puts_(&o, more);
    if (cx_write(path, o.b, o.n)) stfail = 1;
    push(&dirty, rel); free(b); free(o.b);
}
static void removefile(const char *rel) {
    char path[4096];
    snprintf(path, sizeof path, "%s/%s", scratch, rel);
    if (unlink(path)) { printf("selftest FAIL: cannot remove %s\n", path); stfail = 1; }
    push(&dirty, rel);
}

#define LIBH "exec/c/libunisacc.h"
#define LIBC "exec/c/libunisacc.c"
#define TABLE "exec/lower/codeprivate-result.tsv"
static const char *case_name[] = {
    "renamed export", "export renamed in the header only", "changed export parameter type",
    "export definition without a declaration", "reordered struct field", "reordered resource name",
    "reordered resource names of different length", "resource length not matching its name",
    "changed table hash", "removed table", "MAP_FIXED no longer rejected", "munmap range test changed",
    "loader import in a unisacc-built Linux compiler", "new syscall gate name", "changed ELF interpreter path",
    "hand-edited manifest", "missing manifest", 0};
static const char *case_expect[] = {
    "removed  export us_sym_typed", "cannot derive", "changed  export us_compile",
    "cannot derive", "changed  struct us_signature", "changed  callback 00",
    "cannot derive", "cannot derive",
    "changed  table " TABLE, "removed  table " TABLE, "changed  guard library_mmap/posix", "changed  callback-fn library_munmap",
    "added    dlslot #if defined(__linux__) | 0", "added    gate __openat", "changed  image-path 00",
    "changed  export us_new", "no committed manifest"};
static void mutate(int number) {
    switch (number) {
    case 0: edit(LIBH, "us_sym_typed(", "us_symbol_typed("); edit(LIBC, "API void *us_sym_typed(", "API void *us_symbol_typed("); break;
    case 1: edit(LIBH, "us_sym_typed(", "us_symbol_typed("); break;
    case 2: edit(LIBH, "const char *target, int optimisation", "const char *target, long optimisation");
            edit(LIBC, "us_compile(us_context *c,const char *target,int level)", "us_compile(us_context *c,const char *target,long level)"); break;
    case 3: edit(LIBC, "API int us_relocate(", "API int us_extra(us_context *c) { return 0; }\nAPI int us_relocate("); break;
    case 4: edit(LIBH, "size_t count;\n    unsigned variadic;", "unsigned variadic;\n    size_t count;"); break;
    case 5: edit(LIBC, "\"\\0process/argc\",\"\\0process/argv\"", "\"\\0process/argv\",\"\\0process/argc\""); break;
    case 6: edit(LIBC, "\"\\0library/mmap\",\"\\0library/munmap\"", "\"\\0library/munmap\",\"\\0library/mmap\""); break;
    case 7: edit(LIBC, "int lengths[]={13,13,12,", "int lengths[]={13,13,13,"); break;
    case 8: append(TABLE, "#\n"); break;
    case 9: removefile(TABLE); break;
    case 10: edit(LIBC, "if (!active || length<=0 || (flags&MAP_FIXED)) return -EINVAL;", "if (!active || length<=0) return -EINVAL;"); break;
    case 11: edit(LIBC, "if (begin>=lo && end<=hi) break;", "if (begin>=lo) break;"); break;
    case 12: edit("src/host_dl.h", "#if defined(__linux__) && !defined(__UNISA__)\n    if (i == 0)", "#if defined(__linux__)\n    if (i == 0)"); break;
    case 13: edit("src/front_parse.c", "isname(t, \"__getdents64\", 12) || isname(t, \"__open\", 6) ||",
                  "isname(t, \"__getdents64\", 12) || isname(t, \"__openat\", 8) || isname(t, \"__open\", 6) ||"); break;
    case 14: edit("src/back_image.c", "\"/lib/ld-linux-aarch64.so.1\"", "\"/lib/ld-musl-aarch64.so.1\""); break;
    case 15: edit(MANIFEST, "export\tus_new\tus_context*(const char*)", "export\tus_new\tus_context*(void)"); break;
    case 16: removefile(MANIFEST); break;
    }
}
static int selftest(void) {
    Names files; Text clean, out; long i; int number, bad; char path[4096]; const char *tmp = getenv("TMPDIR");
    memset(&files, 0, sizeof files); memset(&clean, 0, sizeof clean); memset(&out, 0, sizeof out);
    snprintf(base, sizeof base, "%s", root);
    if (!derive()) { printf("selftest FAIL: cannot derive the contract: %s\n", why); return 1; }
    render(&clean);
    for (i = 0; i < inputs.n; i++) push(&files, inputs.v[i]);
    snprintf(scratch, sizeof scratch, "%s/abimanifest-XXXXXX", tmp && *tmp ? tmp : "/tmp");
    if (!mkdtemp(scratch)) { printf("selftest FAIL: no scratch directory %s\n", scratch); return 1; }
    for (i = 0; i < files.n; i++) copy_in(files.v[i]);
    snprintf(path, sizeof path, "%s/%s", scratch, MANIFEST);
    mkparents(path);
    if (cx_write(path, clean.b, clean.n)) stfail = 1;
    snprintf(root, sizeof root, "%s", scratch);
    if (!stfail && check(&out)) { printf("selftest FAIL: an unchanged tree must pass\n%s", out.b); stfail = 1; }
    for (number = 0; case_name[number] && !stfail; number++) {
        dirty.n = 0; out.n = 0;
        mutate(number);
        if (stfail) break;
        bad = check(&out);
        if (!bad) { printf("selftest FAIL: %s must fail\n", case_name[number]); stfail = 1; }
        else if (find(out.b, out.n, 0, case_expect[number]) < 0) {
            printf("selftest FAIL: %s: expected \"%s\" in\n%s", case_name[number], case_expect[number], out.b); stfail = 1;
        }
        for (i = 0; i < dirty.n; i++) {                /* back to the clean scratch tree */
            if (strcmp(dirty.v[i], MANIFEST)) copy_in(dirty.v[i]);
            else if (cx_write(path, clean.b, clean.n)) stfail = 1;
        }
    }
    out.n = 0;
    if (!stfail && check(&out)) { printf("selftest FAIL: the restored scratch tree must pass again\n%s", out.b); stfail = 1; }
    rmtree(scratch);
    if (stfail) { printf("abimanifestcheck.cx: SELFTEST FAILED\n"); return 1; }
    printf("abimanifestcheck.cx: unchanged tree passes; %d contract breaks each fail:", number);
    for (number = 0; case_name[number]; number++) printf("%s %s", number ? ";" : "", case_name[number]);
    printf("\n");
    return 0;
}

int main(int argc, char **argv) {
    Text out; int bad, a = 1;
    memset(&out, 0, sizeof out);
    if (argc > 2 && !strcmp(argv[1], "--root")) { snprintf(root, sizeof root, "%s", argv[2]); a = 3; }
    if (argc == a + 1 && !strcmp(argv[a], "--selftest")) return selftest();
    if (argc == a + 2 && !strcmp(argv[a], "--write")) {
        if (!derive()) { fprintf(stderr, "abimanifestcheck.cx: cannot derive: %s\n", why); return 1; }
        render(&out);
        if (cx_write(argv[a + 1], out.b, out.n)) { fprintf(stderr, "abimanifestcheck.cx: cannot write %s\n", argv[a + 1]); return 1; }
        printf("abimanifestcheck.cx: wrote %s, %ld entries\n", argv[a + 1], ents.n);
        return 0;
    }
    if (argc != a + 1 || strcmp(argv[a], "--check")) {
        fprintf(stderr, "usage: abimanifestcheck.cx [--root DIR] --write PATH | --check | --selftest\n");
        return 2;
    }
    bad = check(&out);
    if (out.n) printf("%s", out.b);
    if (bad) {
        printf("abimanifestcheck.cx  FAILED: %s differs from the sources. If the ABI change is intended, run\n"
               "  sh ./unisacc.com -run tests/abimanifestcheck.cx -- --write %s\nand commit the manifest with the change.\n", MANIFEST, MANIFEST);
        return 1;
    }
    printf("abimanifestcheck.cx  %s matches the sources\n", MANIFEST);
    return 0;
}
