#pragma unisa module gate
#pragma unisa use leaf
/* Outer module. The consumer names cxnest.gate and does not name leaf.
   The export calls a file-local helper. That helper calls the inner export. */
static int cxnest_wrap(int a, int b) { return cxnest_leaf(a, b) + 1; }
int cxnest_fold(int a, int b) { return cxnest_wrap(a, b); }
