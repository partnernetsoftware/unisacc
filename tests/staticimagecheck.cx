#!/usr/bin/env -S unisacc.com -run
/* staticimagecheck.cx PRODUCT.com | --selftest -- the Linux compiler images inside a product are static.

   A product names each POSIX compiler gzip member in its launch-script offset table.  The Linux ones must be static
   ELF: exactly one per architecture, at least one PT_LOAD, no PT_INTERP, no PT_DYNAMIC.  A
   dynamic image needs the system's loader and libc before it can print a usage line.
   (Structurally static is all this shows: it does not prove the image starts on every kernel.)
   0.0.42 built a candidate whose Linux images had silently become dynamic; every gate host has
   glibc, so the behaviour gate stayed green.  This reads headers only and never runs the
   product under test.  The inflater is the product's own (exec/c/codec.h).

   Exit 0: both architectures present once, each static.  Exit 1: anything else, including
   "nothing could be checked".  tests/staticimagecheck.py is the earlier Python reference. */
#include <cx.h>
#include "../exec/c/codec.h"

#define PT_LOAD 1
#define PT_DYNAMIC 2
#define PT_INTERP 3

static unsigned long rd(const unsigned char *p, int n) {
    unsigned long v = 0; int i;
    for (i = n - 1; i >= 0; i--) v = (v << 8) | p[i];
    return v;
}

/* One gzip member at b[at..]: the inflated image (malloc'd) and its length, or 0 when the bytes
   there are not a complete member (the magic also occurs by chance inside compressed data). */
static unsigned char *member(const unsigned char *b, unsigned long size, unsigned long at,
                             unsigned long *outlen, unsigned long *used) {
    unsigned long p = at + 10, n = 0, m; int flags; unsigned char *out;
    if (size - at < 18 || b[at] != 0x1f || b[at + 1] != 0x8b || b[at + 2] != 8) return 0;
    flags = b[at + 3];
    if (flags & 0xe0) return 0;
    if (flags & 4) { if (p + 2 > size) return 0; p += 2 + rd(b + p, 2); }
    if (flags & 8) { while (p < size && b[p]) p++; p++; }
    if (flags & 16) { while (p < size && b[p]) p++; p++; }
    if (flags & 2) p += 2;
    if (p >= size) return 0;
    m = size - p;
    if (puff(0, &n, b + p, &m)) return 0;              /* length pass */
    if (n > 2147483647UL || p + m + 8 > size || rd(b + p + m + 4, 4) != (n & 0xffffffffUL)) return 0;
    out = malloc(n ? n : 1);
    if (!out) return 0;
    m = size - p;
    if (puff(out, &n, b + p, &m)) { free(out); return 0; }
    *outlen = n; *used = p + m + 8 - at;
    return out;
}

/* 0: not a little-endian ELF64 for x86_64/aarch64.  Otherwise the machine (62 or 183); *bad is
   set and a line printed when the image breaks the contract. */
static int image(const unsigned char *e, unsigned long n, unsigned long at, int *bad) {
    unsigned long phoff, phentsize, phnum, k; int machine, load = 0, interp = 0, dynamic = 0;
    const char *arch;
    if (n < 64 || e[0] != 0x7f || e[1] != 'E' || e[2] != 'L' || e[3] != 'F' || e[4] != 2 || e[5] != 1) return 0;
    machine = (int)rd(e + 18, 2);
    if (machine != 62 && machine != 183) return 0;
    arch = machine == 62 ? "x86_64" : "aarch64";
    phoff = rd(e + 32, 8); phentsize = rd(e + 54, 2); phnum = rd(e + 56, 2);
    if (phentsize < 56 || phoff > n || phnum > (n - phoff) / phentsize) {
        printf("  FAIL lnx/%s image at %lu: program headers outside the image\n", arch, at); *bad = 1; return machine;
    }
    for (k = 0; k < phnum; k++) {
        unsigned long t = rd(e + phoff + k * phentsize, 4);
        if (t == PT_LOAD) load = 1;
        if (t == PT_INTERP) interp = 1;
        if (t == PT_DYNAMIC) dynamic = 1;
    }
    if (!load) { printf("  FAIL lnx/%s image at %lu has no PT_LOAD (%lu program headers)\n", arch, at, phnum); *bad = 1; }
    else if (interp || dynamic) {
        printf("  FAIL lnx/%s image at %lu is dynamic:%s%s\n", arch, at, interp ? " PT_INTERP" : "", dynamic ? " PT_DYNAMIC" : ""); *bad = 1;
    } else printf("  ok   lnx/%s image at %lu: static, %lu program headers\n", arch, at, phnum);
    return machine;
}

/* The launcher uses one-based tail offsets and exact compressed lengths. Only its table
   before esac names executable members; unrelated gzip bytes are not product slots. */
typedef struct { unsigned long at, len; int count; } Slot;
static int number(const unsigned char *b, unsigned long end, unsigned long *p, unsigned long *v) {
    unsigned long start = *p, n = 0;
    while (*p < end && b[*p] >= '0' && b[*p] <= '9') {
        unsigned long digit = b[(*p)++] - '0';
        if (n > (~0UL - digit) / 10) return 0;
        n = n * 10 + digit;
    }
    *v = n; return *p > start;
}
static int slots(const unsigned char *b, unsigned long size, Slot *x, Slot *a, unsigned long *script_end) {
    unsigned long i = 0, end, p, o, n, k, cap = size < 4096 ? size : 4096; Slot *slot;
    int in_case = 0, closed = 0;
    if (size < 8 || memcmp(b, "MZqFpD='", 8)) return 1;
    while (i < cap) {
        end = i; while (end < cap && b[end] != '\n') end++;
        p = i; while (p < end && b[p] == ' ') p++;
        if (end - p == 12 && !memcmp(b + p, "case \"$u\" in", 12)) { if (in_case) return 1; in_case = 1; }
        if (end - p == 4 && !memcmp(b + p, "esac", 4)) { closed = in_case; *script_end = end + 1; break; }
        slot = 0;
        if (in_case && end - p >= 15 && !memcmp(b + p, "Linuxx86_64) o=", 15)) { slot = x; p += 15; }
        else if (in_case && end - p >= 28 && !memcmp(b + p, "Linuxaarch64|Linuxarm64) o=", 27)) { slot = a; p += 27; }
        else if (in_case && end - p >= 5 && !memcmp(b + p, "Linux", 5)) return 1;
        if (slot) {
            if (++slot->count != 1 || !number(b, end, &p, &o) || !o) return 1;
            if (end - p < 3 || memcmp(b + p, " n=", 3)) return 1; p += 3;
            if (!number(b, end, &p, &n) || !n || end - p < 3 || memcmp(b + p, " k=", 3)) return 1; p += 3;
            for (k = 0; k < 16; k++, p++) if (p >= end || !((b[p] >= '0' && b[p] <= '9') || (b[p] >= 'a' && b[p] <= 'f'))) return 1;
            if (end - p != 2 || memcmp(b + p, ";;", 2)) return 1;
            slot->at = o - 1; slot->len = n;
            if (slot->at > size || n > size - slot->at) return 1;
        }
        i = end + 1;
    }
    if (!closed || x->count != 1 || a->count != 1 || x->at < *script_end || a->at < *script_end) return 1;
    if (x->at < a->at + a->len && a->at < x->at + x->len) return 1;
    return 0;
}
static int check(const unsigned char *b, unsigned long size) {
    Slot x, a, *slot; unsigned long script_end = 0, n, used; int bad = 0, j, m;
    memset(&x, 0, sizeof x); memset(&a, 0, sizeof a);
    if (slots(b, size, &x, &a, &script_end)) { puts("  FAIL invalid/missing APE Linux launch slots"); return 1; }
    for (j = 0; j < 2; j++) {
        unsigned char *e; slot = j ? &a : &x;
        e = member(b, slot->at + slot->len, slot->at, &n, &used);
        if (!e) { puts("  FAIL launch slot is not a complete gzip member"); bad = 1; continue; }
        if (used != slot->len || crc((char *)e, n) != rd(b + slot->at + used - 8, 4)) {
            puts("  FAIL gzip length/CRC differs from launch slot"); bad = 1;
        }
        m = image(e, n, slot->at, &bad);
        if (m != (j ? 183 : 62)) { puts("  FAIL launch slot ELF architecture mismatch"); bad = 1; }
        free(e);
    }
    return bad;
}

/* Self-test fixtures: a minimal ELF64 with the given program header types, wrapped as a gzip
   member whose deflate stream is one stored block (no compressor needed). */
static unsigned long put_elf(unsigned char *o, int machine, const int *types, int count) {
    int k;
    memset(o, 0, 64 + 56 * count);
    o[0] = 0x7f; o[1] = 'E'; o[2] = 'L'; o[3] = 'F'; o[4] = 2; o[5] = 1;
    o[18] = machine & 255; o[19] = machine >> 8;
    o[32] = 64; o[54] = 56; o[56] = count;
    for (k = 0; k < count; k++) o[64 + 56 * k] = types[k];
    return 64 + 56 * count;
}
static unsigned long put_member(unsigned char *o, const unsigned char *data, unsigned long n) {
    unsigned long c = crc((char *)data, (int)n), p = 0; int k;
    o[p++] = 0x1f; o[p++] = 0x8b; o[p++] = 8; for (k = 0; k < 7; k++) o[p++] = 0;
    o[p++] = 1; o[p++] = n & 255; o[p++] = n >> 8; o[p++] = ~n & 255; o[p++] = (~n >> 8) & 255;
    memcpy(o + p, data, n); p += n;
    for (k = 0; k < 4; k++) o[p++] = (c >> (8 * k)) & 255;
    for (k = 0; k < 4; k++) o[p++] = (n >> (8 * k)) & 255;
    o[p++] = 'p'; o[p++] = 'a'; o[p++] = 'd';
    return p;
}
static unsigned long fixture_bytes(unsigned char *file, const int *spec) {
    /* spec: machine, count, types..., repeated; machine 0 ends; machine -1 adds a truncated ELF */
    unsigned char e[1024]; unsigned long size = 512, n, off[2] = {0,0}, len[2] = {0,0}; int index = 0;
    memset(file, ' ', 512); file[511] = '\n';
    while (*spec) {
        if (*spec == -1) { int t[2] = {1, 1}; n = put_elf(e, 62, t, 2); n = 80; spec++; }
        else { n = put_elf(e, spec[0], spec + 2, spec[1]); spec += 2 + spec[1]; }
        if (index < 2) off[index] = size + 1;
        n = put_member(file + size, e, n) - 3; /* padding is not part of the gzip slot */
        if (index < 2) len[index] = n;
        size += n; index++;
    }
    snprintf((char *)file, 511, "MZqFpD='\nu=x\ncase \"$u\" in\n  Linuxx86_64) o=%lu n=%lu k=0000000000000000;;\n  Linuxaarch64|Linuxarm64) o=%lu n=%lu k=0000000000000000;;\nesac\n", off[0], len[0], off[1], len[1]);
    return size;
}
static int fixture(const char *name, int want, const int *spec) {
    unsigned char file[4096]; unsigned long size = fixture_bytes(file, spec); int got;
    got = check(file, size);
    if (got != want) { printf("selftest FAIL: %s: got %d, want %d\n", name, got, want); return 1; }
    return 0;
}
static int slot_fixtures(void) {
    static const int ok[] = {62,2,1,1,183,2,1,1,0};
    unsigned char base[4096], f[4096], extra[1024]; unsigned long size = fixture_bytes(base, ok), n; int bad = 0, mode;
    const char *names[] = {"missing table plus gzip decoys", "slot outside file", "overlapping slots", "duplicate launch label", "wrong declared length", "wrong architecture", "gzip CRC corruption", "unknown Linux slot"};
    for (mode = 0; mode < 8; mode++) {
        char *line_, *v; Slot x, a; unsigned long end = 0;
        memcpy(f, base, size); memset(&x,0,sizeof x); memset(&a,0,sizeof a);
        if (slots(f,size,&x,&a,&end)) return 1;
        line_ = strstr((char *)f, "Linuxx86_64) o="); v = line_ + strlen("Linuxx86_64) o=");
        if (mode == 0) f[0] = 'X';
        if (mode == 1) memcpy(v, "999", 3);
        if (mode == 2) { line_ = strstr((char *)f, "Linuxaarch64|Linuxarm64) o="); memcpy(line_ + strlen("Linuxaarch64|Linuxarm64) o="), "513", 3); }
        if (mode == 3 || mode == 7) {
            line_ = strstr((char *)f, "esac");
            snprintf(line_, 512 - (line_ - (char *)f), "%s) o=513 n=199 k=0000000000000000;;\nesac\n", mode == 3 ? "Linuxx86_64" : "Linuxunknown");
        }
        if (mode == 4) { v = strstr(v, " n=") + 3; v[2]--; }
        if (mode == 5) f[x.at + 15 + 18] = 183; /* stored deflate ELF byte; CRC mismatch also catches */
        if (mode == 6) f[x.at + x.len - 8] ^= 1;
        if (!check(f,size)) { printf("selftest FAIL: %s must fail\n",names[mode]); bad = 1; }
    }
    /* Unselected valid ELF cannot substitute for selected non-ELF. */
    memcpy(f,base,size); f[512 + 15] = 'X';
    { int types[2] = {1,1}; n = put_elf(extra,62,types,2); }
    size += put_member(f + size,extra,n) - 3;
    if (!check(f,size)) { puts("selftest FAIL: appended static decoy replaced corrupt official slot"); bad = 1; }
    puts("staticimage launch-slot fixtures: missing/duplicate/unknown/outside/overlap/length/CRC/wrong-arch and appended decoy checked");
    return bad;
}
static int selftest(void) {
    int bad = 0;
    static const int ok[] = {62, 2, 1, 1, 183, 2, 1, 1, 0};
    static const int interp[] = {62, 3, 1, 3, 1, 183, 2, 1, 1, 0};
    static const int dyn[] = {62, 2, 1, 1, 183, 2, 1, 2, 0};
    static const int onearch[] = {62, 2, 1, 1, 0};
    static const int none[] = {0};
    static const int trunc[] = {-1, 183, 2, 1, 1, 0};
    static const int nophdr[] = {62, 0, 183, 2, 1, 1, 0};
    static const int noload[] = {62, 1, 4, 183, 2, 1, 1, 0};
    static const int extra[] = {62, 2, 1, 3, 183, 2, 1, 1, 62, 2, 1, 1, 0};
    static const int dup[] = {62, 2, 1, 1, 183, 2, 1, 1, 62, 2, 1, 1, 0};
    static const int wrongarch[] = {62, 2, 1, 1, 62, 2, 1, 1, 0};
    crc_init();
    bad |= slot_fixtures();
    bad |= fixture("two static images", 0, ok);
    bad |= fixture("PT_INTERP", 1, interp);
    bad |= fixture("PT_DYNAMIC", 1, dyn);
    bad |= fixture("one architecture missing", 1, onearch);
    bad |= fixture("no image at all", 1, none);
    bad |= fixture("headers outside the image", 1, trunc);
    bad |= fixture("no program headers", 1, nophdr);
    bad |= fixture("no PT_LOAD", 1, noload);
    bad |= fixture("an extra static member beside a dynamic one", 1, extra);
    bad |= fixture("extra static gzip outside launch slots is ignored", 0, dup);
    bad |= fixture("valid gzip with wrong slot architecture", 1, wrongarch);
    printf("staticimagecheck.cx: %s\n", bad ? "SELFTEST FAILED" :
        "formal slots pass; INTERP/DYNAMIC, bad table/member/architecture/headers fail; unrelated gzip ignored");
    return bad;
}

int main(int argc, char **argv) {
    char *b; size_t size; int bad;
    if (argc == 2 && !strcmp(argv[1], "--selftest")) return selftest();
    if (argc != 2) { fprintf(stderr, "usage: staticimagecheck.cx PRODUCT.com | --selftest\n"); return 2; }
    b = cx_read(argv[1], &size);
    if (!b) { printf("staticimagecheck.cx: cannot read %s\n", argv[1]); return 1; }
    crc_init();
    bad = check((const unsigned char *)b, (unsigned long)size);
    printf("staticimagecheck.cx  %s  %s\n", argv[1], bad ? "FAILED" : "linux images static");
    return bad;
}
