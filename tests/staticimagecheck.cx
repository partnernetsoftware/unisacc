#!/usr/bin/env -S unisacc.com -run
/* staticimagecheck.cx PRODUCT.com | --selftest -- the Linux compiler images inside a product are static.

   A product carries one gzip member per POSIX compiler image.  The Linux ones must be static
   ELF: exactly one per architecture, at least one PT_LOAD, no PT_INTERP, no PT_DYNAMIC.  A
   dynamic image needs the system's loader and libc before it can print a usage line.
   (Structurally static is all this shows: it does not prove the image starts on every kernel.)
   0.0.42 built a candidate whose Linux images had silently become dynamic; every gate host has
   glibc, so the behaviour gate stayed green.  This reads headers only and never runs the
   product under test.  The inflater is the product's own (exec/c/codec.h).

   Exit 0: both architectures present once, each static.  Exit 1: anything else, including
   "nothing could be checked".  tests/staticimagecheck.py is the earlier Python reference. */
#include <cx.h>
#include "../exec/c/codec.h"

#define PT_LOAD 1
#define PT_DYNAMIC 2
#define PT_INTERP 3

static unsigned long rd(const unsigned char *p, int n) {
    unsigned long v = 0; int i;
    for (i = n - 1; i >= 0; i--) v = (v << 8) | p[i];
    return v;
}

/* One gzip member at b[at..]: the inflated image (malloc'd) and its length, or 0 when the bytes
   there are not a complete member (the magic also occurs by chance inside compressed data). */
static unsigned char *member(const unsigned char *b, unsigned long size, unsigned long at,
                             unsigned long *outlen, unsigned long *used) {
    unsigned long p = at + 10, n = 0, m; int flags; unsigned char *out;
    if (size - at < 18 || b[at] != 0x1f || b[at + 1] != 0x8b || b[at + 2] != 8) return 0;
    flags = b[at + 3];
    if (flags & 4) { if (p + 2 > size) return 0; p += 2 + rd(b + p, 2); }
    if (flags & 8) { while (p < size && b[p]) p++; p++; }
    if (flags & 16) { while (p < size && b[p]) p++; p++; }
    if (flags & 2) p += 2;
    if (p >= size) return 0;
    m = size - p;
    if (puff(0, &n, b + p, &m)) return 0;              /* length pass */
    if (p + m + 8 > size || rd(b + p + m + 4, 4) != (n & 0xffffffffUL)) return 0;
    out = malloc(n ? n : 1);
    if (!out) return 0;
    m = size - p;
    if (puff(out, &n, b + p, &m)) { free(out); return 0; }
    *outlen = n; *used = p + m + 8 - at;
    return out;
}

/* 0: not a little-endian ELF64 for x86_64/aarch64.  Otherwise the machine (62 or 183); *bad is
   set and a line printed when the image breaks the contract. */
static int image(const unsigned char *e, unsigned long n, unsigned long at, int *bad) {
    unsigned long phoff, phentsize, phnum, k; int machine, load = 0, interp = 0, dynamic = 0;
    const char *arch;
    if (n < 64 || e[0] != 0x7f || e[1] != 'E' || e[2] != 'L' || e[3] != 'F' || e[4] != 2 || e[5] != 1) return 0;
    machine = (int)rd(e + 18, 2);
    if (machine != 62 && machine != 183) return 0;
    arch = machine == 62 ? "x86_64" : "aarch64";
    phoff = rd(e + 32, 8); phentsize = rd(e + 54, 2); phnum = rd(e + 56, 2);
    if (phentsize < 56 || phoff > n || phnum > (n - phoff) / phentsize) {
        printf("  FAIL lnx/%s image at %lu: program headers outside the image\n", arch, at); *bad = 1; return machine;
    }
    for (k = 0; k < phnum; k++) {
        unsigned long t = rd(e + phoff + k * phentsize, 4);
        if (t == PT_LOAD) load = 1;
        if (t == PT_INTERP) interp = 1;
        if (t == PT_DYNAMIC) dynamic = 1;
    }
    if (!load) { printf("  FAIL lnx/%s image at %lu has no PT_LOAD (%lu program headers)\n", arch, at, phnum); *bad = 1; }
    else if (interp || dynamic) {
        printf("  FAIL lnx/%s image at %lu is dynamic:%s%s\n", arch, at, interp ? " PT_INTERP" : "", dynamic ? " PT_DYNAMIC" : ""); *bad = 1;
    } else printf("  ok   lnx/%s image at %lu: static, %lu program headers\n", arch, at, phnum);
    return machine;
}

/* 1 when the product fails the contract. */
static int check(const unsigned char *b, unsigned long size) {
    unsigned long at = 0, n, used; int bad = 0, x86 = 0, arm = 0, m;
    while (at + 18 <= size) {
        unsigned char *e;
        if (b[at] != 0x1f || b[at + 1] != 0x8b || b[at + 2] != 8) { at++; continue; }
        e = member(b, size, at, &n, &used);
        if (!e) { at++; continue; }
        m = image(e, n, at, &bad);
        if (m == 62) x86++;
        if (m == 183) arm++;
        free(e); at += used;
    }
    if (!arm) { printf("  FAIL no lnx/aarch64 image found\n"); bad = 1; }
    else if (arm != 1) { printf("  FAIL %d lnx/aarch64 images found, want exactly 1\n", arm); bad = 1; }
    if (!x86) { printf("  FAIL no lnx/x86_64 image found\n"); bad = 1; }
    else if (x86 != 1) { printf("  FAIL %d lnx/x86_64 images found, want exactly 1\n", x86); bad = 1; }
    return bad;
}

/* Self-test fixtures: a minimal ELF64 with the given program header types, wrapped as a gzip
   member whose deflate stream is one stored block (no compressor needed). */
static unsigned long put_elf(unsigned char *o, int machine, const int *types, int count) {
    int k;
    memset(o, 0, 64 + 56 * count);
    o[0] = 0x7f; o[1] = 'E'; o[2] = 'L'; o[3] = 'F'; o[4] = 2; o[5] = 1;
    o[18] = machine & 255; o[19] = machine >> 8;
    o[32] = 64; o[54] = 56; o[56] = count;
    for (k = 0; k < count; k++) o[64 + 56 * k] = types[k];
    return 64 + 56 * count;
}
static unsigned long put_member(unsigned char *o, const unsigned char *data, unsigned long n) {
    unsigned long c = crc((char *)data, (int)n), p = 0; int k;
    o[p++] = 0x1f; o[p++] = 0x8b; o[p++] = 8; for (k = 0; k < 7; k++) o[p++] = 0;
    o[p++] = 1; o[p++] = n & 255; o[p++] = n >> 8; o[p++] = ~n & 255; o[p++] = (~n >> 8) & 255;
    memcpy(o + p, data, n); p += n;
    for (k = 0; k < 4; k++) o[p++] = (c >> (8 * k)) & 255;
    for (k = 0; k < 4; k++) o[p++] = (n >> (8 * k)) & 255;
    o[p++] = 'p'; o[p++] = 'a'; o[p++] = 'd';
    return p;
}
static int fixture(const char *name, int want, const int *spec) {
    /* spec: machine, count, types..., repeated; machine 0 ends; machine -1 adds a truncated ELF */
    unsigned char file[4096], e[1024]; unsigned long size = 0, n; int got;
    memcpy(file, "MZ-fixture", 10); size = 10;
    while (*spec) {
        if (*spec == -1) { int t[2] = {1, 1}; n = put_elf(e, 62, t, 2); n = 80; spec++; }
        else { n = put_elf(e, spec[0], spec + 2, spec[1]); spec += 2 + spec[1]; }
        size += put_member(file + size, e, n);
    }
    got = check(file, size);
    if (got != want) { printf("selftest FAIL: %s: got %d, want %d\n", name, got, want); return 1; }
    return 0;
}
static int selftest(void) {
    int bad = 0;
    static const int ok[] = {62, 2, 1, 1, 183, 2, 1, 1, 0};
    static const int interp[] = {62, 3, 1, 3, 1, 183, 2, 1, 1, 0};
    static const int dyn[] = {62, 2, 1, 1, 183, 2, 1, 2, 0};
    static const int onearch[] = {62, 2, 1, 1, 0};
    static const int none[] = {0};
    static const int trunc[] = {-1, 183, 2, 1, 1, 0};
    static const int nophdr[] = {62, 0, 183, 2, 1, 1, 0};
    static const int noload[] = {62, 1, 4, 183, 2, 1, 1, 0};
    static const int extra[] = {62, 2, 1, 3, 183, 2, 1, 1, 62, 2, 1, 1, 0};
    static const int dup[] = {62, 2, 1, 1, 183, 2, 1, 1, 62, 2, 1, 1, 0};
    crc_init();
    bad |= fixture("two static images", 0, ok);
    bad |= fixture("PT_INTERP", 1, interp);
    bad |= fixture("PT_DYNAMIC", 1, dyn);
    bad |= fixture("one architecture missing", 1, onearch);
    bad |= fixture("no image at all", 1, none);
    bad |= fixture("headers outside the image", 1, trunc);
    bad |= fixture("no program headers", 1, nophdr);
    bad |= fixture("no PT_LOAD", 1, noload);
    bad |= fixture("an extra static member beside a dynamic one", 1, extra);
    bad |= fixture("a duplicate static member", 1, dup);
    printf("staticimagecheck.cx: %s\n", bad ? "SELFTEST FAILED" :
        "static pass; PT_INTERP, PT_DYNAMIC, missing or duplicate architecture, no image, no PT_LOAD, empty and truncated headers fail");
    return bad;
}

int main(int argc, char **argv) {
    char *b; size_t size; int bad;
    if (argc == 2 && !strcmp(argv[1], "--selftest")) return selftest();
    if (argc != 2) { fprintf(stderr, "usage: staticimagecheck.cx PRODUCT.com | --selftest\n"); return 2; }
    b = cx_read(argv[1], &size);
    if (!b) { printf("staticimagecheck.cx: cannot read %s\n", argv[1]); return 1; }
    bad = check((const unsigned char *)b, (unsigned long)size);
    printf("staticimagecheck.cx  %s  %s\n", argv[1], bad ? "FAILED" : "linux images static");
    return bad;
}
