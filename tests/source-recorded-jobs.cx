/* Finite recorded-material role contract. CLI ROOT CTX RECORDED_SID.
 * Actual CTX/identity-helper observes current ROOT before/after; the API does
 * not measure a source by itself. Scope requires current SID != recorded SID.
 * Two fresh three-net material views; original fresh API must reject the actual
 * current SID against the old context. Original records are never rewritten.
 * Caller55; source4x2 + positive6x2 + old-fresh6 + wrong-recorded6 =32 child
 * seconds. Remaining negatives reject before fork. No NN generation/inference,
 * mutation, clone, historical-source snapshot, or applicability/PASS cache.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.sourcepackage
#pragma unisa use text.text
static int assertions,failures;
static char root[4096],ctx[4096],bound[4400],helper[4400],module[4400],context[4400];
static const char *ids[]={"net-shared-e3","net-warnparse","net-errorparse"};
static void die(const char *s){fprintf(stderr,"source-recorded-jobs: %s errno=%d\n",s,errno);exit(2);}
static void check(int ok,const char *s){assertions++;if(!ok)failures++;printf("%s\t%s\n",ok?"PASS":"FAIL",s);}
static void path(char p[4400],const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static int hex(const char *s){if(strlen(s)!=64)return 0;for(int i=0;i<64;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;return 1;}
static int zero(const void *s,size_t n){const unsigned char *p=s;for(size_t i=0;i<n;i++)if(p[i])return 0;return 1;}
static void digest(const char *p,char h[65]){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>8388608)die("small-normal-input");np_buf b={0};if(np_readfile(p,&b))die("input-read");cx_sha256_hex(b.p,b.n,h);free(b.p);}
static void fresh(char out[65]){char *v[]={bound,"4",helper,root,0};np_result r={0};char why[1000];int transport=np_run(v,root,0,4,&r,why,sizeof why);int ok=!transport&&!r.rc&&!r.errn&&r.outn==65&&r.out[64]=='\n';if(ok){memcpy(out,r.out,64);out[64]=0;ok=hex(out);}if(!ok){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("actual-current-identity-helper");}np_free(&r);}
static int named(const char *why){const char *p="source-package-snapshot-refused: sourcepackage: REFUSE receipt-bytes-mismatch errno=";size_t n=strlen(p);if(strncmp(why,p,n))return 0;why+=n;if(*why=='-')why++;int digits=0;while(*why>='0'&&*why<='9'){why++;digits++;}return digits&&why[0]=='\n'&&!why[1];}
static void argument(const char *recorded,const char *current,const char *const *leaves,int n,int seconds,const char *label){sp_recorded_jobs_result r;char why[1200];memset(&r,0xa5,sizeof r);memset(why,'!',sizeof why);int rc=sp_verify_recorded_jobs_snapshot(root,ctx,leaves,n,recorded,current,seconds,&r,why,sizeof why);check(rc==-1,label);check(memchr(why,0,sizeof why)&&tx_eqz(why, "source-package-recorded-jobs-arguments"),"recorded-arguments-exact-reason");check(zero(&r,sizeof r),"recorded-arguments-clear-entire-output");}
static void positive(const char *recorded,const char *current,const char *module_sha,sp_recorded_jobs_result *r){char why[1200];memset(r,0xa5,sizeof *r);int rc=sp_verify_recorded_jobs_snapshot(root,ctx,ids,3,recorded,current,6,r,why,sizeof why);check(!rc,"fresh-recorded-material-view");if(rc){fprintf(stderr,"%s\n",why);exit(2);}check(!why[0],"recorded-success-reason-empty");check(tx_eqz(r->current_source, current)&&tx_eqz(r->recorded_source, recorded)&&tx_eqz(r->material.source, recorded),"current-and-recorded-source-roles-are-distinct");check(r->material.jobs==12&&r->material.models==3,"actual-three-net-twelve-job-closure");check(r->material.physical_reads>0&&r->material.elapsed_ns>0,"actual-fresh-reads-and-elapsed");check(tx_eqz(r->material.verifier, module_sha),"current-executing-module-source-identity");check(hex(r->binding)&&!tx_eqz(r->binding, r->material.witness),"recorded-binding-separate-from-material-witness");printf("RECORDED_VIEW\tcurrent=%s\trecorded=%s\tjobs=%d\tmodels=%d\treads=%d\tns=%lld\tbinding=%s\n",r->current_source,r->recorded_source,r->material.jobs,r->material.models,r->material.physical_reads,r->material.elapsed_ns,r->binding);}
static int stable(const sp_recorded_jobs_result *a,const sp_recorded_jobs_result *b){const sp_result *x=&a->material,*y=&b->material;const char *v[]={x->source,x->artifact,x->manifest,x->receipt,x->witness,x->epoch_artifact,x->epoch_record,x->epoch_path,x->producer,x->foundation,x->verifier,x->digest_module,a->current_source,a->recorded_source,a->binding};const char *w[]={y->source,y->artifact,y->manifest,y->receipt,y->witness,y->epoch_artifact,y->epoch_record,y->epoch_path,y->producer,y->foundation,y->verifier,y->digest_module,b->current_source,b->recorded_source,b->binding};for(int i=0;i<15;i++)if(!tx_eqz(v[i], w[i]))return 0;return x->jobs==y->jobs&&x->models==y->models&&x->physical_reads==y->physical_reads;}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN source-recorded-jobs requires Linux/x86_64 LP64\n",stderr);return 3;
#endif
 if(argc!=4||sizeof(long)!=8||!realpath(argv[1],root)||!realpath(argv[2],ctx)||!hex(argv[3]))die("usage ROOT CTX RECORDED_SID");
 path(bound,root,"tools/bound");path(helper,ctx,"identity-helper");path(context,ctx,"context.tsv");path(module,root,"tools/cxlib/sourcepackage.cx");char current[65],after_current[65],before[3][65],after[65];const char *inputs[]={helper,context,module};for(int i=0;i<3;i++)digest(inputs[i],before[i]);fresh(current);check(strcmp(current,argv[3])!=0,"actual-current-source-differs-from-recorded-source");if(tx_eqz(current, argv[3]))die("this-finite-contract-requires-actual-current-vs-recorded-mismatch");pid_t caller=getpid();
 sp_recorded_jobs_result a,b;positive(argv[3],current,before[2],&a);
 const char *duplicate[]={"net-shared-e3","net-shared-e3"};argument(argv[3],"bad",ids,3,2,"malformed-current-refused");argument("bad",current,ids,3,2,"malformed-recorded-refused");argument(argv[3],current,ids,0,2,"empty-recorded-leaf-set-refused");argument(argv[3],current,duplicate,2,2,"duplicate-recorded-leaf-refused");argument(argv[3],current,ids,3,0,"zero-seconds-refused");argument(argv[3],current,ids,3,56,"over55-seconds-refused");
 char why[1200];sp_result old;memset(&old,0xa5,sizeof old);int rc=sp_verify_jobs_snapshot(root,ctx,ids,3,current,6,&old,why,sizeof why);check(rc==-1,"original-fresh-API-rejects-real-current-source-against-old-context");check(memchr(why,0,sizeof why)&&named(why),"original-fresh-API-exact-canonical-context-refusal");check(zero(&old,sizeof old),"original-fresh-API-clears-entire-output");
 char wrong[65];memset(wrong,'0',64);wrong[64]=0;if(tx_eqz(wrong, argv[3]))memset(wrong,'1',64);memset(&b,0xa5,sizeof b);rc=sp_verify_recorded_jobs_snapshot(root,ctx,ids,3,wrong,current,6,&b,why,sizeof why);check(rc==-1,"wrong-recorded-source-refused");check(memchr(why,0,sizeof why)&&named(why),"wrong-recorded-source-exact-canonical-context-refusal");check(zero(&b,sizeof b),"wrong-recorded-source-clears-entire-output");
 memset(&b,0xa5,sizeof b);memset(why,'!',sizeof why);rc=sp_verify_recorded_jobs_snapshot(root,ctx,ids,3,argv[3],current,2,&b,why,0);check(rc==-1&&zero(&b,sizeof b)&&why[0]=='!',"zero-capacity-refuses-clears-output-and-does-not-write-reason");rc=sp_verify_recorded_jobs_snapshot(root,ctx,ids,3,argv[3],current,2,0,why,sizeof why);check(rc==-1&&tx_eqz(why, "source-package-recorded-jobs-arguments"),"NULL-output-refuses-with-exact-reason");
 positive(argv[3],current,before[2],&b);check(stable(&a,&b),"new-fresh-view-recovers-all-material-identities-and-read-counts");fresh(after_current);check(tx_eqz(current, after_current),"actual-current-helper-endpoints-stable");for(int i=0;i<3;i++){digest(inputs[i],after);check(tx_eqz(before[i], after),"helper-context-module-input-bytes-unchanged");}check(caller==getpid(),"parent-survives-all-API-refusals");
 puts("NOT_CLAIMED\thistorical03a5-full-source-snapshot-current-gen-replay-applicability-NN-inference-current-package-or-PASS-cache\nSCOPE\tcurrent-SID-observed-by-test-helper;API-only-accepts-caller-fresh-source-claim;wrong-valid-current-SID-not-self-detected");printf("SOURCE_RECORDED_JOBS\tassertions=%d\tfailed=%d\n",assertions,failures);return failures?1:0;
}
