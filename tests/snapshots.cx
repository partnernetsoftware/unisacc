/* Prepare actual source, execute it fresh, then regenerate/verify the material.
 * The shared C implementation remains C; this driver and fixture use default-run.
 * ROOT ABS_NEW_OUT, each constructor/child bounded below the outer 55s watchdog. */
#pragma unisa use cxlib.netpack
static void die(const char *s){fprintf(stderr,"snapshots-driver: %s\n",s);exit(2);}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path");}
static void call(char **argv,const char *root,int budget,const char *out,const char *name){np_result r;char why[1024],p[4400],file[120];if(np_run(argv,root,0,budget,&r,why,sizeof why))die(why);snprintf(file,sizeof file,"%s.stdout",name);path(p,out,file);if(cx_write(p,r.out,r.outn))die("stdout log");snprintf(file,sizeof file,"%s.stderr",name);path(p,out,file);if(cx_write(p,r.err,r.errn))die("stderr log");if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.errn)fwrite(r.err,1,r.errn,stderr);int rc=r.rc;np_free(&r);if(rc)exit(rc<0?128-rc:rc);}
int main(int argc,char **argv){char root[4096],product[4400],bound[4400],tool[4400],material[4400],program[4400],cases[4400];if(argc!=3||!realpath(argv[1],root)||argv[2][0]!='/'||mkdir(argv[2],0700))return 2;path(product,root,"unisacc.com");path(bound,root,"tools/bound");path(tool,root,"tools/ledger-material.cx");path(material,argv[2],"material");path(program,material,"snapshot.cx");path(cases,argv[2],"cases");char *prep[]={bound,"18","sh",product,tool,"--",root,material,"tests/cases/snapshot.cx",0};call(prep,root,20,argv[2],"prepare");char *run[]={bound,"16","sh",product,program,"--",cases,0};call(run,root,18,argv[2],"execute");char *verify[]={bound,"18","sh",product,tool,"--","--verify",root,material,"tests/cases/snapshot.cx",0};call(verify,root,20,argv[2],"verify");return 0;}
