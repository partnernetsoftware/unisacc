/* Pure helper test. The mock records ownership boundaries but does not allocate
 * or free product buffers; memory lifetime and real models are separate checks. */
#pragma unisa use driver.emissionroute
static int checks,failed,ncalls,fail_at,fail_code;
static unsigned char input_bytes[]={65,0,66},middle_bytes[]={77,0,78},final_bytes[]={70,0,71},sentinel_bytes[]={83};
static const char route_text[]="osx/arm64/object/O2",target_text[]="osx/arm64",source_text[]="unit-name.cx";
typedef struct {const char *route,*target,*source,*first,*last;int cx;unsigned unit;unsigned char*input;long inputn;unsigned char**output;long*outputn;char*reason;int cap;} Call;
static Call calls[3];
static void ck(int yes,const char*label){checks++;failed+=!yes;printf("%s\t%s\n",yes?"PASS":"FAIL",label);}
static int text(const char*a,const char*b){return (!a&&!b)||(a&&b&&!strcmp(a,b));}
static int span_mock(const char*route,const char*target,const char*source,int cx,unsigned unit,const char*first,const char*last,unsigned char*in,long inn,unsigned char**out,long*outn,char*why,int cap){
 int index=ncalls++;if(index>=3)return 99;Call*c=calls+index;c->route=route;c->target=target;c->source=source;c->cx=cx;c->unit=unit;c->first=first;c->last=last;c->input=in;c->inputn=inn;c->output=out;c->outputn=outn;c->reason=why;c->cap=cap;
 /* This matches st_span's output-slot initialization, not extra helper policy. */
 if(!out||!outn)return 4;*out=0;*outn=0;
 if(why&&cap>0){int n=snprintf(why,(size_t)cap,"mock-%d-%s",index+1,fail_at==index+1?"failure":"success");if(n<0||n>=cap)return 98;}
 if(fail_at==index+1)return fail_code;
 *out=index==0?middle_bytes:final_bytes;*outn=index==0?3:2;return 0;
}
static void verify_case(const char*label,int object,int level,const char*first,int split,int failure,int expected_status){
 ncalls=0;fail_at=failure;fail_code=expected_status;unsigned char*out=sentinel_bytes;long outn=444;char reason[97]="initial-reason";
 int status=dver_span(span_mock,object,level,route_text,target_text,source_text,7,0x11223344U,first,input_bytes,3,&out,&outn,reason,97);
 int wanted=failure==1?1:split?2:1;printf("CASE\t%s\tstatus=%d\tcalls=%d\n",label,status,ncalls);
 ck(status==(failure?expected_status:0),"callback status returned exactly");ck(ncalls==wanted,"exact span count with no post-failure call");
 for(int i=0;i<ncalls&&i<3;i++){Call*c=calls+i;ck(c->route==route_text&&c->target==target_text&&c->source==source_text,"route target source borrowed pointers retained");ck(c->cx==7&&c->unit==0x11223344U,"cx and full unsigned unit retained");ck(c->reason==reason&&c->cap==97,"same reason buffer and capacity retained");ck(c->input==(i?middle_bytes:input_bytes)&&c->inputn==3,"input bytes identity and exact length retained");
 if(!split){ck(c->first==first&&!c->last,"direct call keeps first and null last");ck(c->output==&out&&c->outputn==&outn,"direct output slots remain caller slots");}
 else if(!i){ck(c->first==first&&text(c->last,level?"e4":"tapecheck"),"front stop is e4 or tapecheck and input first retained");ck(c->output!=&out&&c->outputn!=&outn,"front uses private intermediate output slots");}
 else{ck(text(c->first,"lower")&&!c->last,"backend starts lower with unbounded route tail");ck(c->output==&out&&c->outputn==&outn,"backend receives original output slots");}}
 char wanted_reason[97];int len=snprintf(wanted_reason,sizeof wanted_reason,"mock-%d-%s",wanted,failure?"failure":"success");if(len<0||(size_t)len>=sizeof wanted_reason){failed++;return;}
 ck(!strcmp(reason,wanted_reason),"last callback reason preserved verbatim");
 if(failure&&split&&failure==1)ck(out==sentinel_bytes&&outn==444,"front failure does not invent writes to caller output slots");
 else if(failure)ck(!out&&!outn,"reached failure callback owns clearing its output slots");
 else ck(out==(split?final_bytes:middle_bytes)&&outn==(split?2:3),"successful callback output identity and size retained");
}
static void target_cases(void){const char*arm="osx/arm64",*x64="osx/x86_64",*linux="lnx/x86_64",*explicit_target="win/arm64",*empty="";
 ck(dver_tape_target(0,1,2,0,arm)==arm,"bare-S takes passed osx ARM policy");ck(dver_tape_target(0,1,2,0,x64)==x64,"bare-S takes passed osx x64 policy");ck(dver_tape_target(0,1,2,0,linux)==linux,"legacy non-osx policy is retained");ck(dver_tape_target(explicit_target,1,2,0,arm)==explicit_target,"explicit target always wins");ck(dver_tape_target(empty,1,2,0,arm)==empty,"present empty target is not invented as missing");ck(!dver_tape_target(0,0,2,0,arm),"non-S keeps generic target selection");ck(!dver_tape_target(0,1,0,0,arm),"image mode keeps generic target selection");ck(!dver_tape_target(0,1,1,0,arm),"preprocessing mode keeps generic target selection");ck(!dver_tape_target(0,1,4,0,arm),"token mode keeps generic target selection");ck(!dver_tape_target(0,1,2,1,arm),"origin-bearing input keeps its target policy");ck(!dver_tape_target(0,1,2,0,0),"missing policy stays missing without invented fallback");}
int main(int argc,char**argv){if(argc!=1)return 2;(void)argv;
 verify_case("source-object-O0",1,0,0,1,0,0);verify_case("source-object-O1",1,1,0,1,0,0);verify_case("source-object-O2",1,2,0,1,0,0);
 verify_case("tape-object-O0",1,0,"lower",0,0,0);verify_case("tape-object-O1",1,1,"e4",1,0,0);verify_case("tape-object-O2",1,2,"e4",1,0,0);
 verify_case("non-object-source-O0",0,0,0,0,0,0);verify_case("non-object-source-O1",0,1,0,0,0,0);verify_case("non-object-source-O2",0,2,0,0,0,0);verify_case("non-object-tape-O0",0,0,"prune",0,0,0);verify_case("non-object-tape-O2",0,2,"e4",0,0,0);
 verify_case("source-front-failure",1,0,0,1,1,3);verify_case("optimized-front-failure",1,2,0,1,1,4);verify_case("tape-front-failure",1,1,"e4",1,1,7);
 verify_case("source-backend-failure",1,0,0,1,2,4);verify_case("optimized-backend-failure",1,2,0,1,2,3);verify_case("tape-backend-failure",1,1,"e4",1,2,9);verify_case("direct-failure",0,2,0,0,1,5);
 target_cases();printf("EMISSION_ROUTE_CHECK\tchecks=%d\tfailed=%d\tscope=pure-helper-no-product-or-lifetime-qualification\n",checks,failed);return failed?1:0;}
