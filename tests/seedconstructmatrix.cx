#!/usr/bin/env -S unisacc.com -run
/* seedconstructmatrix.cx -- R20-1 B: byte-compare the C99 and Python constructors on product delta graphs; the
   include-free port of tests/seedconstructmatrix.py (2026-10-23).  Same groups, same stdout line, same rc:
     sh tests/cxbin tests/seedconstructmatrix.cx GROUP        (gate form; or sh ./unisacc.com -run ... -- GROUP)
   GROUP is shared, features, features-1..3, object, or one of lnx/arm64 lnx/x86_64 osx/arm64 osx/x86_64
   win/arm64 win/x86_64.  Each invocation owns a seed-matrix-XXXXXX scratch tree under TMPDIR (TEMP, TMP, /tmp),
   removed on every exit, and a 55 s total budget; every step runs with cwd = ROOT under min(50, remaining) s.
   seed/net.c and seed/tbl.c are built by unisacc.com (-fno-trim-libc); per spec: python3 GENERATOR GRAPH FLAGS...,
   python3 exec/c/tbl.py GRAPH TABLE, seed-tbl GRAPH CTABLE (tables must match byte for byte), python3
   exec/c/net.py TABLE PYNET, seed-net TABLE CNET (networks must match).  The Python constructors are the system
   under test and are invoked, not reimplemented.  Child stdout/stderr are captured, shown only in a failure.
   Errors print the last line of the Python traceback (RuntimeError / AssertionError / subprocess.TimeoutExpired /
   FileNotFoundError, same text, same reprs) on stderr, rc 1; a bad group is the SystemExit text, rc 1, after the
   two seed builds (as in the .py).  Differences: the usage line names seedconstructmatrix.cx; no traceback
   frames; a timed-out step's whole process group is killed (Python killed the child only).
   ROOT is the parent of this file's directory (__FILE__, resolved against the working directory when relative:
   every caller runs from the repository root).  "python3" is the first python3 on PATH (sys.executable).
   tests/seedmatrixprepared.cx carries its own copy of SHARED and names this file as an actor seed; keep SHARED
   here and there in step.
   Headers below are ones the cx prelude does not yet provide (CX1 in flight): time.h (clock_gettime),
   fcntl.h (open, FD_CLOEXEC), errno.h. */
#include <time.h>
#include <fcntl.h>
#include <errno.h>

#define PATHN 4096
static char ROOT[PATHN], TMP[PATHN], PY[PATHN], OUTF[PATHN], ERRF[PATHN];
static double DEADLINE;

typedef struct { const char *name, *script; const char *flags[6]; } Spec;
static const char *TARGETS[] = { "lnx/arm64", "lnx/x86_64", "osx/arm64", "osx/x86_64", "win/arm64", "win/x86_64", 0 };
static const Spec SHARED[] = {
    {"e2", "exec/build/gen.py", {"pp", "--shared-predefines", 0}},
    {"e1", "exec/build/gen.py", {"lex", "--typed", 0}},
    {"e3", "exec/build/gen.py", {"parse2", 0}},
    {"e4", "exec/build/gen.py", {"opt", "--o2", 0}},
    {"o1", "exec/build/gen.py", {"opt", 0}},
    {"prune", "exec/build/gen.py", {"prune", 0}},
    {"nativeabi", "exec/build/gen.py", {"nativeabi", 0}},
    {0, 0, {0}} };
static const Spec FEATURES[] = {
    {"tokenpp", "exec/build/gen.py", {"pp", "--shared-predefines", "--no-autoinc", 0}},
    {"tokenlex", "exec/build/gen.py", {"lex", 0}},
    {"warnlex", "exec/build/gen.py", {"lex", "--locations", 0}},
    {"warnparse", "exec/build/gen.py", {"parse2", "--warnings", "--errors", 0}},
    {"warnunits", "exec/build/gen.py", {"parse2/units", "--locations", 0}},
    {"errorparse", "exec/build/gen.py", {"parse2", "--errors", 0}},
    {"warnpp-shared", "exec/build/gen.py", {"pp", "--locations", "--shared-predefines", 0}},
    {0, 0, {0}} };
/* Three parse2-sized models (~30-35 s cold each) cannot share one 55 s job. */
static const struct { const char *shard; const char *names[4]; } FEATURE_SHARDS[] = {
    {"features-1", {"warnparse", "tokenpp", "tokenlex", 0}},
    {"features-2", {"errorparse", "warnlex", 0}},
    {"features-3", {"warnunits", "warnpp-shared", 0}},
    {0, {0}} };

/* ---- scratch tree (tempfile.TemporaryDirectory) ---- */
/* an uncaught exception: the traceback's last line on stderr, rc 1 (the scratch tree is removed first) */
static void raise_line(const char *line) {
    fflush(stdout);
    if (TMP[0]) { cx_rmtree(TMP); TMP[0] = 0; }
    fprintf(stderr, "%s\n", line); fflush(stderr); exit(1);
}

/* ---- growable string and Python reprs ---- */
typedef struct { char *s; size_t n, cap; } Buf;
static void bput(Buf *b, const char *s, size_t n) {
    if (b->n + n + 1 > b->cap) {
        size_t c = b->cap ? b->cap : 256; char *t;
        while (b->n + n + 1 > c) c *= 2;
        if (!(t = realloc(b->s, c))) { fprintf(stderr, "MemoryError\n"); exit(1); }
        b->s = t; b->cap = c;
    }
    memcpy(b->s + b->n, s, n); b->n += n; b->s[b->n] = 0;
}
static void bstr(Buf *b, const char *s) { bput(b, s, strlen(s)); }
/* repr(str) for argv text (bytes >= 0x80 kept as is: printable non-ASCII stays literal in Python too) and
   repr(bytes) (BYTES=1: b prefix, every byte >= 0x7f as \xNN) */
static void brepr(Buf *b, const char *s, size_t n, int bytes) {
    size_t i; char q = '\'', t[8]; int sq = 0, dq = 0;
    for (i = 0; i < n; i++) { if (s[i] == '\'') sq = 1; else if (s[i] == '"') dq = 1; }
    if (sq && !dq) q = '"';
    if (bytes) bstr(b, "b");
    bput(b, &q, 1);
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)s[i];
        if (c == '\\' || c == (unsigned char)q) { t[0] = '\\'; t[1] = (char)c; bput(b, t, 2); }
        else if (c == '\t') bstr(b, "\\t");
        else if (c == '\n') bstr(b, "\\n");
        else if (c == '\r') bstr(b, "\\r");
        else if (c < 0x20 || c == 0x7f || (bytes && c >= 0x80)) { snprintf(t, sizeof t, "\\x%02x", c); bstr(b, t); }
        else bput(b, (const char *)&c, 1);
    }
    bput(b, &q, 1);
}
static void bargs(Buf *b, char **argv) {          /* repr(tuple) */
    int i; bstr(b, "(");
    for (i = 0; argv[i]; i++) { if (i) bstr(b, ", "); brepr(b, argv[i], strlen(argv[i]), 0); }
    if (i == 1) bstr(b, ",");
    bstr(b, ")");
}
static void bfloat(Buf *b, double x) {            /* repr(float): shortest round-trip */
    char t[64]; int p;
    for (p = 1; p <= 17; p++) { snprintf(t, sizeof t, "%.*g", p, x); if (strtod(t, 0) == x) break; }
    if (!strchr(t, '.') && !strchr(t, 'e') && !strchr(t, 'n') && !strchr(t, 'i')) strcat(t, ".0");
    bstr(b, t);
}

static double now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (double)t.tv_sec + (double)t.tv_nsec / 1e9; }

/* ---- run(deadline, *args): subprocess.run(args, cwd=ROOT, capture_output=True, timeout=min(50, remaining)) ---- */
static void run(char **argv) {
    double remaining = DEADLINE - now(), limit, start; int rc, st = 0, of, ef, pp[2], err = 0; pid_t pid, w; ssize_t k;
    Buf m = {0, 0, 0};
    if (remaining <= 0) raise_line("RuntimeError: seed matrix exceeded 55 s");
    limit = remaining < 50 ? remaining : 50;
    fflush(stdout); fflush(stderr);
    of = open(OUTF, O_WRONLY | O_CREAT | O_TRUNC, 0600); ef = open(ERRF, O_WRONLY | O_CREAT | O_TRUNC, 0600);
    if (of < 0 || ef < 0 || pipe(pp)) raise_line("OSError: cannot capture a child's output");
    fcntl(pp[1], F_SETFD, FD_CLOEXEC);
    pid = fork();
    if (pid < 0) raise_line("OSError: fork failed");
    if (pid == 0) {
        setpgid(0, 0); close(pp[0]);
        dup2(of, 1); dup2(ef, 2); close(of); close(ef);
        if (chdir(ROOT)) { err = errno; if (write(pp[1], &err, sizeof err) < 0) {} _exit(127); }
        execvp(argv[0], argv);
        err = errno; if (write(pp[1], &err, sizeof err) < 0) {} _exit(127);
    }
    close(pp[1]); close(of); close(ef);
    k = read(pp[0], &err, sizeof err); close(pp[0]);
    if (k == (ssize_t)sizeof err) {                /* the child never ran: Python raises from Popen */
        waitpid(pid, &st, 0);
        bstr(&m, err == ENOENT ? "FileNotFoundError: [Errno 2] No such file or directory: "
                 : err == EACCES ? "PermissionError: [Errno 13] Permission denied: " : "OSError: cannot execute: ");
        brepr(&m, argv[0], strlen(argv[0]), 0);
        raise_line(m.s);
    }
    start = now();
    for (;;) {
        w = waitpid(pid, &st, WNOHANG);
        if (w == pid) { rc = WIFSIGNALED(st) ? -WTERMSIG(st) : WEXITSTATUS(st); break; }
        if (w < 0) raise_line("ChildProcessError: waitpid failed");
        if (now() - start >= limit) {
            kill(-pid, SIGKILL); kill(pid, SIGKILL); waitpid(pid, &st, 0);
            bstr(&m, "subprocess.TimeoutExpired: Command '"); bargs(&m, argv); bstr(&m, "' timed out after ");
            if (remaining < 50) bfloat(&m, limit); else bstr(&m, "50");
            bstr(&m, " seconds");
            raise_line(m.s);
        }
        usleep(10000);
    }
    if (rc) {   /* RuntimeError(f"{args}: rc={p.returncode}: {p.stderr[-1000:]!r}") */
        size_t n = 0; char *e = cx_read(ERRF, &n), t[32];
        if (!e) { e = malloc(1); n = 0; }
        bstr(&m, "RuntimeError: "); bargs(&m, argv);
        snprintf(t, sizeof t, ": rc=%d: ", rc); bstr(&m, t);
        brepr(&m, n > 1000 ? e + n - 1000 : e, n > 1000 ? 1000 : n, 1);
        raise_line(m.s);
    }
}
static char *read_bytes(const char *path, size_t *n) {   /* Path.read_bytes() */
    char *b = cx_read(path, n);
    if (!b) {
        Buf m = {0, 0, 0};
        bstr(&m, "FileNotFoundError: [Errno 2] No such file or directory: "); brepr(&m, path, strlen(path), 0);
        raise_line(m.s);
    }
    return b;
}
static int same_file(const char *a, const char *b) {
    size_t na, nb; char *x = read_bytes(a, &na), *y = read_bytes(b, &nb); int r = na == nb && !memcmp(x, y, na);
    free(x); free(y); return r;
}

/* ---- specs(group) ---- */
#define NAMEN 64
typedef struct { char name[NAMEN]; const char *script; const char *flags[6]; } Job;
static int specs(const char *group, Job *out) {
    int n = 0, i, j, k;
    if (!strcmp(group, "shared") || !strcmp(group, "features")) {
        const Spec *s = !strcmp(group, "shared") ? SHARED : FEATURES;
        for (i = 0; s[i].name; i++, n++) {
            snprintf(out[n].name, NAMEN, "%s", s[i].name); out[n].script = s[i].script;
            for (j = 0; j < 6; j++) out[n].flags[j] = s[i].flags[j];
        }
        return n;
    }
    for (k = 0; FEATURE_SHARDS[k].shard; k++) if (!strcmp(group, FEATURE_SHARDS[k].shard)) {
        for (i = 0; FEATURES[i].name; i++) for (j = 0; FEATURE_SHARDS[k].names[j]; j++)
            if (!strcmp(FEATURES[i].name, FEATURE_SHARDS[k].names[j])) {   /* FEATURES order */
                int f; snprintf(out[n].name, NAMEN, "%s", FEATURES[i].name); out[n].script = FEATURES[i].script;
                for (f = 0; f < 6; f++) out[n].flags[f] = FEATURES[i].flags[f];
                n++;
            }
        return n;
    }
    if (!strcmp(group, "object")) {
        static const char *arches[] = { "arm64", "x86_64" };
        for (i = 0; i < 2; i++) {
            int arm = i == 0;
            snprintf(out[n].name, NAMEN, "object-%s-lower", arches[i]); out[n].script = "exec/build/gen.py";
            out[n].flags[0] = "lower"; out[n].flags[1] = "--full"; out[n].flags[2] = "--object";
            out[n].flags[3] = arm ? "--arm64" : 0; out[n].flags[4] = 0; n++;
            snprintf(out[n].name, NAMEN, "object-%s-elf", arches[i]); out[n].script = "exec/build/gen.py";
            out[n].flags[0] = arm ? "enc/arm" : "enc"; out[n].flags[1] = "--object"; out[n].flags[2] = 0; n++;
        }
        return n;
    }
    for (k = 0; TARGETS[k]; k++) if (!strcmp(group, TARGETS[k])) break;
    if (!TARGETS[k]) {
        Buf m = {0, 0, 0};
        bstr(&m, "group must be shared, features, object, or one of ");
        for (k = 0; TARGETS[k]; k++) { if (k) bstr(&m, ", "); bstr(&m, TARGETS[k]); }
        raise_line(m.s);                        /* SystemExit(str): the text alone, rc 1 */
    }
    {
        int osx = !strncmp(group, "osx/", 4), win = !strncmp(group, "win/", 4), arm = !strcmp(group + 4, "arm64");
        const char *image = osx ? "--macho" : win ? "--pe" : "--elf";
        j = 0;
        snprintf(out[0].name, NAMEN, "lower"); out[0].script = "exec/build/gen.py";
        out[0].flags[j++] = "lower"; out[0].flags[j++] = "--full";
        if (osx) out[0].flags[j++] = "--osx"; else if (win) out[0].flags[j++] = "--win";
        if (arm) out[0].flags[j++] = "--arm64";
        out[0].flags[j] = 0;
        snprintf(out[1].name, NAMEN, "elf"); out[1].script = "exec/build/gen.py";
        out[1].flags[0] = arm ? "enc/arm" : "enc"; out[1].flags[1] = image; out[1].flags[2] = 0;
    }
    return 2;
}

static void find_python(void) {                  /* sys.executable: the python3 the gate's PATH names */
    const char *path = getenv("PATH"), *p, *e; char cand[PATHN];
    snprintf(PY, sizeof PY, "python3");
    for (p = path ? path : ""; *p; p = *e ? e + 1 : e) {
        size_t l; e = strchr(p, ':'); if (!e) e = p + strlen(p);
        l = (size_t)(e - p);
        snprintf(cand, sizeof cand, "%.*s/python3", (int)(l ? l : 1), l ? p : ".");
        if (access(cand, X_OK) == 0) {
            if (cand[0] != '/') { char cwd[PATHN]; if (getcwd(cwd, sizeof cwd)) { snprintf(PY, sizeof PY, "%s/%s", cwd, cand); return; } }
            snprintf(PY, sizeof PY, "%s", cand); return;
        }
    }
}

int main(int argc, char **argv) {
    char here[PATHN], *slash, com[PATHN], cnet[PATHN], ctbl[PATHN];
    const char *tmp, *group; Job jobs[16]; int n, i; Buf done = {0, 0, 0};
    if (argc != 2) { fprintf(stderr, "usage: seedconstructmatrix.cx GROUP\n"); return 1; }
    group = argv[1];
    DEADLINE = now() + 55;
    /* ROOT = Path(__file__).resolve().parents[1] */
    snprintf(here, sizeof here, "%s", __FILE__);
    slash = strrchr(here, '/');
    if (slash) *slash = 0; else snprintf(here, sizeof here, ".");
    { char t[PATHN]; snprintf(t, sizeof t, "%s/..", here);
      if (!realpath(t, ROOT)) { fprintf(stderr, "FileNotFoundError: cannot resolve the repository root %s\n", t); return 1; } }
    find_python();
    tmp = getenv("TMPDIR");
    if (!tmp || !*tmp) tmp = getenv("TEMP");
    if (!tmp || !*tmp) tmp = getenv("TMP");
    if (!tmp || !*tmp) tmp = "/tmp";
    if (tmp[0] != '/') { char cwd[PATHN]; if (!getcwd(cwd, sizeof cwd)) raise_line("OSError: getcwd"); snprintf(TMP, sizeof TMP, "%s/%s/seed-matrix-XXXXXX", cwd, tmp); }
    else snprintf(TMP, sizeof TMP, "%s/seed-matrix-XXXXXX", tmp);
    if (!mkdtemp(TMP)) { TMP[0] = 0; raise_line("FileNotFoundError: No usable temporary directory found"); }
    snprintf(OUTF, sizeof OUTF, "%s/.stdout", TMP); snprintf(ERRF, sizeof ERRF, "%s/.stderr", TMP);
    snprintf(com, sizeof com, "%s/unisacc.com", ROOT);
    /* 0.0.25 B1: the seed constructor is built by unisacc.com (the installed previous release), not by the system cc */
    snprintf(cnet, sizeof cnet, "%s/seed-net", TMP);
    { char *a[] = {"sh", com, "-fno-trim-libc", "seed/net.c", "-o", cnet, 0}; run(a); }
    snprintf(ctbl, sizeof ctbl, "%s/seed-tbl", TMP);   /* 0.0.25 B2: delta JSON -> flat table in C as well */
    { char *a[] = {"sh", com, "-fno-trim-libc", "seed/tbl.c", "-o", ctbl, 0}; run(a); }
    n = specs(group, jobs);
    for (i = 0; i < n; i++) {
        char graph[PATHN], table[PATHN], py[PATHN], c[PATHN], ctable[PATHN], *a[16], t[64]; int k = 0, f; struct stat s;
        Buf m = {0, 0, 0};
        snprintf(graph, sizeof graph, "%s/%s.json", TMP, jobs[i].name); snprintf(table, sizeof table, "%s/%s.tbl", TMP, jobs[i].name);
        snprintf(py, sizeof py, "%s/%s.py.net", TMP, jobs[i].name); snprintf(c, sizeof c, "%s/%s.c.net", TMP, jobs[i].name);
        a[k++] = PY; a[k++] = (char *)jobs[i].script; a[k++] = graph;
        for (f = 0; jobs[i].flags[f]; f++) a[k++] = (char *)jobs[i].flags[f];
        a[k] = 0; run(a);
        { char *b[] = {PY, "exec/c/tbl.py", graph, table, 0}; run(b); }
        snprintf(ctable, sizeof ctable, "%s/%s.c.tbl", TMP, jobs[i].name);
        { char *b[] = {ctbl, graph, ctable, 0}; run(b); }
        if (!same_file(table, ctable)) {
            bstr(&m, "AssertionError: "); bstr(&m, group); bstr(&m, "/"); bstr(&m, jobs[i].name);
            bstr(&m, ": seed/tbl.c table differs from exec/c/tbl.py"); raise_line(m.s);
        }
        { char *b[] = {PY, "exec/c/net.py", table, py, 0}; run(b); }
        { char *b[] = {cnet, table, c, 0}; run(b); }
        if (!same_file(py, c)) {
            bstr(&m, "AssertionError: "); bstr(&m, group); bstr(&m, "/"); bstr(&m, jobs[i].name);
            bstr(&m, ": first differing network byte"); raise_line(m.s);
        }
        if (stat(c, &s)) raise_line("FileNotFoundError: network vanished");
        if (done.n) bstr(&done, " ");
        snprintf(t, sizeof t, "%s=%lld", jobs[i].name, (long long)s.st_size); bstr(&done, t);
    }
    cx_rmtree(TMP); TMP[0] = 0;
    printf("seed matrix %s: %d byte-identical tables and networks (seed/tbl.c, seed/net.c); %s\n", group, n, done.s ? done.s : "");
    return 0;
}
