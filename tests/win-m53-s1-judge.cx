/* tests/win-m53-s1-judge.cx -- Independent .cx judge for win-m53-s1-parity.
 * Never executes the candidate APE. Independently parses the trusted candidate APE
 * (UNIPKG1 footer via runtime.packagefooter) or P4 carrier to extract
 * tape/lnx-x86_64/m53.tapeslice, verifies SLICE against the extracted bytes,
 * binds all 12 vectors (id, len, expect_ret, input_sha) to vectors.tsv rejecting
 * duplicates, verifies locators.tsv, and verifies the v3 receipt via cxlib.receipt. */
#pragma unisa use cxlib.receipt
#pragma unisa use runtime.packagefooter
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.sha
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.text

static int is_hex64(const char *s) {
    int i;
    if (!s) return 0;
    for (i = 0; i < 64; i++) {
        char c = s[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 0;
    }
    return s[64] == 0 ? 1 : 0;
}

static int file_sha256_hex(const char *path, char out[65], int64_t max_bytes) {
    unsigned char *b = 0;
    int64_t n = 0;
    if (sy_read_file(path, &b, &n, max_bytes) != 0 || !b) {
        if (b) mm_free(b);
        return 1;
    }
    int hrc = sy_sha256_hex(b, n, out);
    mm_free(b);
    return (hrc == 0 && out[0]) ? 0 : 1;
}

static int parse_u64_dec(const char *s, long *pos, long end, unsigned long long *out) {
    unsigned long long v = 0;
    int any = 0;
    while (*pos < end && (s[*pos] == ' ' || s[*pos] == '\t')) (*pos)++;
    while (*pos < end && s[*pos] >= '0' && s[*pos] <= '9') {
        v = v * 10ULL + (unsigned long long)(s[*pos] - '0');
        (*pos)++;
        any = 1;
    }
    if (!any) return 1;
    *out = v;
    return 0;
}

static int parse_i64_dec(const char *s, long *out) {
    long v = 0;
    int neg = 0, any = 0;
    if (!s || !*s) return 1;
    if (*s == '-') { neg = 1; s++; }
    while (*s >= '0' && *s <= '9') {
        v = v * 10L + (long)(*s - '0');
        s++;
        any = 1;
    }
    if (!any || *s != 0) return 1;
    *out = neg ? -v : v;
    return 0;
}

/* Extract P4 entry "tape/lnx-x86_64/m53.tapeslice" from candidate APE or raw P4 carrier. */
static int extract_slice_from_ape(const unsigned char *b, int64_t n,
                                  unsigned char **out_buf, int64_t *out_len) {
    const unsigned char *p4 = 0;
    long p4_len = 0, pos = 0, i;
    const char *want_key = "tape/lnx-x86_64/m53.tapeslice";
    long want_klen = (long)strlen(want_key);
    unsigned long long pm = 0, ps = 0, nr = 0;
    int found = 0;

    if (!b || n < 16) return 1;
    if (n >= 4 && b[0] == 'P' && b[1] == ' ' && b[2] == '4' && b[3] == ' ') {
        p4 = b;
        p4_len = (long)n;
    } else {
        PackageFooter pf;
        if (!packagefooter_locate_bytes(b, (long)n, &pf)) return 1;
        if (pf.package_offset < 0 || pf.package_length < 10 ||
            pf.package_offset + pf.package_length > (long)n) return 1;
        p4 = b + pf.package_offset;
        p4_len = pf.package_length;
    }

    if (p4_len < 10 || p4[0] != 'P' || p4[1] != ' ' || p4[2] != '4' || p4[3] != ' ') return 1;
    {
        long nl = 0;
        while (nl < p4_len && p4[nl] != '\n') nl++;
        if (nl >= p4_len) return 1;
        pos = 4;
        if (parse_u64_dec((const char *)p4, &pos, nl, &pm) != 0 ||
            parse_u64_dec((const char *)p4, &pos, nl, &ps) != 0 ||
            parse_u64_dec((const char *)p4, &pos, nl, &nr) != 0) return 1;
        pos = nl + 1;
    }
    for (i = 0; i < (long)ps; i++) {
        while (pos < p4_len && p4[pos] != '\n') pos++;
        if (pos >= p4_len) return 1;
        pos++;
    }
    for (i = 0; i < (long)pm; i++) {
        long nl = pos;
        unsigned long long ml = 0;
        while (nl < p4_len && p4[nl] != '\n') nl++;
        if (nl >= p4_len || p4[pos] != 'M' || p4[pos + 1] != ' ') return 1;
        pos += 2;
        if (parse_u64_dec((const char *)p4, &pos, nl, &ml) != 0) return 1;
        pos = nl + 1 + (long)ml;
        if (pos > p4_len) return 1;
    }
    for (i = 0; i < (long)nr; i++) {
        long nl = pos;
        unsigned long long kl = 0, dl = 0, rl = 0, co = 0;
        while (nl < p4_len && p4[nl] != '\n') nl++;
        if (nl >= p4_len || p4[pos] != 'F' || p4[pos + 1] != ' ') return 1;
        pos += 2;
        if (parse_u64_dec((const char *)p4, &pos, nl, &kl) != 0 ||
            parse_u64_dec((const char *)p4, &pos, nl, &dl) != 0 ||
            parse_u64_dec((const char *)p4, &pos, nl, &rl) != 0 ||
            parse_u64_dec((const char *)p4, &pos, nl, &co) != 0) return 1;
        pos = nl + 1;
        if ((long)(kl + dl) < 0 || pos + (long)(kl + dl) > p4_len) return 1;
        if ((long)kl == want_klen && memcmp(p4 + pos, want_key, (size_t)want_klen) == 0) {
            unsigned char *cp;
            if (found || co != 0 || dl != rl || dl < 128ULL || dl > (4ULL << 20)) return 1;
            cp = (unsigned char *)mm_alloc((size_t)dl);
            if (!cp) return 1;
            mm_copy(cp, (long)dl, p4 + pos + (long)kl, (long)dl);
            *out_buf = cp;
            *out_len = (int64_t)dl;
            found = 1;
        }
        pos += (long)(kl + dl);
    }
    return found ? 0 : 1;
}

static int has_exact_line(const char *buf, long len, const char *want) {
    long wlen = (long)strlen(want);
    long pos = 0;
    while (pos < len) {
        long e = pos;
        while (e < len && buf[e] != '\n') e++;
        if (e - pos == wlen && memcmp(buf + pos, want, (size_t)wlen) == 0) return 1;
        pos = (e < len) ? (e + 1) : len;
    }
    return 0;
}

typedef struct {
    int present;
    int seen;
    long len;
    int expect_ret;
    char input_sha[65];
} vec_spec_t;

static int split_tabs(char *line, char **cols, int max_cols) {
    int n = 0;
    char *p = line;
    if (!line) return 0;
    for (;;) {
        if (n >= max_cols) return -1;
        cols[n++] = p;
        while (*p && *p != '\t') p++;
        if (*p == 0) break;
        *p++ = 0;
    }
    return n;
}

static int load_vectors(const char *path, vec_spec_t specs[12], int *want_pos, int *want_neg) {
    unsigned char *b = 0;
    int64_t n = 0;
    long pos = 0, line_no = 0;
    int count = 0;
    *want_pos = 0; *want_neg = 0;
    mm_fill(specs, (long)(12 * sizeof(vec_spec_t)), 0, (long)(12 * sizeof(vec_spec_t)));
    if (sy_read_file(path, &b, &n, 1 << 20) != 0 || !b || n <= 0) {
        if (b) mm_free(b);
        return 1;
    }
    while (pos < (long)n) {
        long e = pos;
        char line[512];
        char *cols[8];
        int nc;
        while (e < (long)n && b[e] != '\n') e++;
        if (e > pos && b[e - 1] == '\r') { mm_free(b); sy_eprintf("REFUSE cr-in-vectors\n"); return 1; }
        if (e - pos >= (long)sizeof line) { mm_free(b); return 1; }
        mm_copy(line, (long)sizeof line, b + pos, e - pos);
        line[e - pos] = 0;
        pos = (e < (long)n) ? (e + 1) : (long)n;
        line_no++;
        if (line_no == 1) {
            if (!tx_eqz(line, "id\tlen\tptr_nonnull\tkind\texpect_ret\tinput_sha")) {
                mm_free(b);
                sy_eprintf("REFUSE bad-vectors-header\n");
                return 1;
            }
            continue;
        }
        nc = split_tabs(line, cols, 8);
        if (nc != 6) { mm_free(b); sy_eprintf("REFUSE bad-vectors-row\n"); return 1; }
        {
            long vid = -1, vlen = 0, vret = -1;
            if (parse_i64_dec(cols[0], &vid) != 0 || vid < 0 || vid >= 12 ||
                parse_i64_dec(cols[1], &vlen) != 0 ||
                parse_i64_dec(cols[4], &vret) != 0 || (vret != 0 && vret != 1) ||
                !is_hex64(cols[5])) {
                mm_free(b);
                sy_eprintf("REFUSE bad-table-input-sha\n");
                return 1;
            }
            if (specs[vid].present) {
                mm_free(b);
                sy_eprintf("REFUSE duplicate-table-vector\n");
                return 1;
            }
            specs[vid].present = 1;
            specs[vid].len = vlen;
            specs[vid].expect_ret = (int)vret;
            mm_copy(specs[vid].input_sha, 65, cols[5], 64);
            specs[vid].input_sha[64] = 0;
            count++;
            if (vret == 1) (*want_pos)++; else (*want_neg)++;
        }
    }
    mm_free(b);
    return count == 12 ? 0 : 1;
}

static int verify_output(const char *out_path, const char *expect_target,
                         vec_spec_t specs[12], int want_pos, int want_neg) {
    unsigned char *b = 0;
    int64_t n = 0;
    long pos = 0;
    int vecs = 0, sum = 0, i;
    if (sy_read_file(out_path, &b, &n, 1 << 20) != 0 || !b || n <= 0) {
        if (b) mm_free(b);
        return 1;
    }
    while (pos < (long)n) {
        long e = pos;
        char line[512];
        while (e < (long)n && b[e] != '\n') e++;
        if (e > pos && b[e - 1] == '\r') { mm_free(b); sy_eprintf("REFUSE cr-in-output\n"); return 1; }
        if (e - pos >= (long)sizeof line) { mm_free(b); sy_eprintf("REFUSE output-line-too-long\n"); return 1; }
        mm_copy(line, (long)sizeof line, b + pos, e - pos);
        line[e - pos] = 0;
        pos = (e < (long)n) ? (e + 1) : (long)n;
        if (strncmp(line, "VEC\t", 4) == 0) {
            char *cols[10];
            int nc = split_tabs(line, cols, 10);
            long vid = -1, steps = 0;
            char want_f[128];
            if (nc != 8) { mm_free(b); sy_eprintf("REFUSE bad-vec-fields\n"); return 1; }
            if (parse_i64_dec(cols[1], &vid) != 0 || vid < 0 || vid >= 12 || !specs[vid].present) {
                mm_free(b); sy_eprintf("REFUSE unknown-vector\n"); return 1;
            }
            if (specs[vid].seen) {
                mm_free(b); sy_eprintf("REFUSE duplicate-vector\n"); return 1;
            }
            cx_fmt(want_f, sizeof want_f, "len=%ld", specs[vid].len);
            if (!tx_eqz(cols[2], want_f)) { mm_free(b); sy_eprintf("REFUSE bad-vector-len\n"); return 1; }
            cx_fmt(want_f, sizeof want_f, "native=%d", specs[vid].expect_ret);
            if (!tx_eqz(cols[3], want_f)) { mm_free(b); sy_eprintf("REFUSE bad-vector-native\n"); return 1; }
            cx_fmt(want_f, sizeof want_f, "portable=%d", specs[vid].expect_ret);
            if (!tx_eqz(cols[4], want_f)) { mm_free(b); sy_eprintf("REFUSE bad-vector-portable\n"); return 1; }
            cx_fmt(want_f, sizeof want_f, "s1_def=%d", specs[vid].expect_ret);
            if (!tx_eqz(cols[5], want_f)) { mm_free(b); sy_eprintf("REFUSE bad-vector-s1def\n"); return 1; }
            if (strncmp(cols[6], "steps=", 6) != 0 || parse_i64_dec(cols[6] + 6, &steps) != 0 || steps <= 0) {
                mm_free(b); sy_eprintf("REFUSE bad-vector-steps\n"); return 1;
            }
            cx_fmt(want_f, sizeof want_f, "in_sha=%s", specs[vid].input_sha);
            if (!tx_eqz(cols[7], want_f)) { mm_free(b); sy_eprintf("REFUSE bad-vector-in-sha\n"); return 1; }
            specs[vid].seen = 1;
            vecs++;
        } else if (strncmp(line, "SUMMARY\t", 8) == 0) {
            char want_mid[160];
            long l = (long)strlen(line);
            cx_fmt(want_mid, sizeof want_mid, "\ttarget=%s\tvectors=12\tpos=%d\tneg=%d\t",
                   expect_target, want_pos, want_neg);
            if (strstr(line, want_mid) == 0 || l < 13 || !tx_eqz(line + l - 13, "\tverdict=PASS")) {
                mm_free(b); sy_eprintf("REFUSE bad-summary\n"); return 1;
            }
            sum++;
        } else {
            mm_free(b); sy_eprintf("REFUSE unexpected-output-line\n"); return 1;
        }
    }
    mm_free(b);
    if (vecs != 12 || sum != 1) { sy_eprintf("REFUSE missing-vector\n"); return 1; }
    for (i = 0; i < 12; i++) {
        if (!specs[i].seen) { sy_eprintf("REFUSE missing-vector\n"); return 1; }
    }
    return 0;
}

static int check_receipt_min_ts(const char *rcpt_path, long disp_ts) {
    unsigned char *b = 0;
    int64_t n = 0;
    long pos = 0, rts = 0;
    int found = 0;
    if (sy_read_file(rcpt_path, &b, &n, 65536) != 0 || !b) return 1;
    while (pos < (long)n) {
        long e = pos;
        char line[256];
        while (e < (long)n && b[e] != '\n') e++;
        if (e - pos < (long)sizeof line) {
            mm_copy(line, (long)sizeof line, b + pos, e - pos);
            line[e - pos] = 0;
            if (strncmp(line, "ts\t", 3) == 0 && parse_i64_dec(line + 3, &rts) == 0) found = 1;
        }
        pos = (e < (long)n) ? (e + 1) : (long)n;
    }
    mm_free(b);
    return (found && rts >= disp_ts - 60L) ? 0 : 1;
}

int main(void) {
    const char *cand_ape = sy_env("CAND_APE");
    const char *cand_sha = sy_env("CAND_SHA");
    const char *disp_s = sy_env("DISP_TS");
    const char *now_s = sy_env("NOW_TS");
    const char *run_id = sy_env("RUN_ID");
    const char *rev = sy_env("SOURCE_COMMIT");
    const char *expect_target = sy_env("EXPECT_TARGET");
    const char *rcpt = sy_env("RCPT");
    const char *outf = sy_env("OUT");
    const char *slicef = sy_env("SLICE");
    const char *locf = sy_env("LOC");
    const char *vectors = sy_env("VECTORS");
    const char *job = sy_env("JOB");
    const char *baseline = sy_env("BASELINE");
    long disp_ts = 0, now_ts = 0;
    unsigned char *ape_b = 0, *sl_b = 0, *loc_b = 0;
    int64_t ape_n = 0, sl_n = 0, loc_n = 0;
    char got_cand[65], trusted_sl[65], got_sl[65], out_sha[65], job_sha[65], base_sha[65], vec_sha[65], in_sha[65];
    char manifest[512], want_line[256];
    vec_spec_t specs[12];
    int want_pos = 0, want_neg = 0;

    if (!vectors || !vectors[0]) vectors = "tests/fixtures/win-m53-s1/vectors.tsv";
    if (!job || !job[0]) job = "tests/fixtures/win-m53-s1/job.tsv";
    if (!baseline || !baseline[0]) baseline = "cx/runtime/stream_attributes.cx";

    if (!cand_ape || !cand_sha || !disp_s || !now_s || !run_id || !rev || !expect_target ||
        !rcpt || !outf || !slicef || !locf ||
        parse_i64_dec(disp_s, &disp_ts) != 0 || parse_i64_dec(now_s, &now_ts) != 0 ||
        !is_hex64(cand_sha)) {
        sy_eprintf("REFUSE bad-env\n");
        return 2;
    }

    if (sy_read_file(cand_ape, &ape_b, &ape_n, 64 << 20) != 0 || !ape_b || ape_n < 16) {
        if (ape_b) mm_free(ape_b);
        sy_eprintf("REFUSE missing-candidate-ape\n");
        return 1;
    }
    if (sy_sha256_hex(ape_b, ape_n, got_cand) != 0 || !tx_eqz(got_cand, cand_sha)) {
        mm_free(ape_b);
        sy_eprintf("REFUSE candidate-sha-mismatch\n");
        return 1;
    }
    if (extract_slice_from_ape(ape_b, ape_n, &sl_b, &sl_n) != 0) {
        mm_free(ape_b);
        sy_eprintf("REFUSE missing-slice-key\n");
        return 1;
    }
    mm_free(ape_b);
    if (sy_sha256_hex(sl_b, sl_n, trusted_sl) != 0) {
        mm_free(sl_b);
        sy_eprintf("REFUSE hash-trusted-slice\n");
        return 1;
    }
    mm_free(sl_b);

    if (file_sha256_hex(slicef, got_sl, 4 << 20) != 0 || !tx_eqz(got_sl, trusted_sl)) {
        sy_eprintf("REFUSE slice-mismatch\n");
        return 1;
    }
    if (file_sha256_hex(outf, out_sha, 1 << 20) != 0 ||
        file_sha256_hex(job, job_sha, 1 << 20) != 0 ||
        file_sha256_hex(baseline, base_sha, 4 << 20) != 0 ||
        file_sha256_hex(vectors, vec_sha, 1 << 20) != 0) {
        sy_eprintf("REFUSE missing-input-artifact\n");
        return 1;
    }
    if (cx_fmt(manifest, sizeof manifest,
               "job\t%s\nbaseline\t%s\nslice\t%s\nvectors\t%s\n",
               job_sha, base_sha, trusted_sl, vec_sha) != 0 ||
        sy_sha256_hex((const unsigned char *)manifest, (int64_t)strlen(manifest), in_sha) != 0) {
        sy_eprintf("REFUSE hash-inputs-manifest\n");
        return 1;
    }

    if (sy_read_file(locf, &loc_b, &loc_n, 65536) != 0 || !loc_b || loc_n <= 0) {
        if (loc_b) mm_free(loc_b);
        sy_eprintf("REFUSE missing-locators\n");
        return 1;
    }
    cx_fmt(want_line, sizeof want_line, "target\t%s", expect_target);
    if (!has_exact_line((const char *)loc_b, (long)loc_n, want_line)) { mm_free(loc_b); sy_eprintf("REFUSE bad-target-locator\n"); return 1; }
    cx_fmt(want_line, sizeof want_line, "candidate_sha\t%s", cand_sha);
    if (!has_exact_line((const char *)loc_b, (long)loc_n, want_line)) { mm_free(loc_b); sy_eprintf("REFUSE bad-candidate-locator\n"); return 1; }
    cx_fmt(want_line, sizeof want_line, "slice_sha\t%s", trusted_sl);
    if (!has_exact_line((const char *)loc_b, (long)loc_n, want_line)) { mm_free(loc_b); sy_eprintf("REFUSE bad-slice-locator\n"); return 1; }
    cx_fmt(want_line, sizeof want_line, "vectors_sha\t%s", vec_sha);
    if (!has_exact_line((const char *)loc_b, (long)loc_n, want_line)) { mm_free(loc_b); sy_eprintf("REFUSE bad-vectors-sha\n"); return 1; }
    if (!has_exact_line((const char *)loc_b, (long)loc_n, "slice_source\tdelivered_ape:tape/lnx-x86_64/m53.tapeslice")) {
        mm_free(loc_b); sy_eprintf("REFUSE bad-slice-source\n"); return 1;
    }
    mm_free(loc_b);

    if (load_vectors(vectors, specs, &want_pos, &want_neg) != 0) return 1;
    if (verify_output(outf, expect_target, specs, want_pos, want_neg) != 0) return 1;

    {
        rc_expect_t exp;
        mm_fill(&exp, (long)sizeof exp, 0, (long)sizeof exp);
        exp.run_id = run_id;
        exp.rev = rev;
        exp.unit = "m53";
        exp.target = expect_target;
        exp.candidate_sha = cand_sha;
        exp.inputs_sha = in_sha;
        exp.output_path = outf;
        exp.producer = "win-m53-s1-parity";
        exp.purpose = "s1-parity";
        exp.expect_rc = 0;
        exp.expect_verdict = "PASS";
        exp.now_ts = (int64_t)now_ts;
        exp.max_age_s = 86400;
        exp.max_future_s = 60;
        exp.allow_fail_verdict = 0;
        if (rc_verify(rcpt, &exp) != RC_OK || check_receipt_min_ts(rcpt, disp_ts) != 0) {
            sy_eprintf("REFUSE bad-receipt\t%s\n", rc_why());
            return 1;
        }
    }

    sy_printf("JUDGE_OK\ttarget=%s\tslice_sha=%s\tvectors_sha=%s\n", expect_target, trusted_sl, vec_sha);
    return 0;
}
