#pragma unisa use sysx.process
/* tests/facts-current.cx -- every exec/facts table equals what tools/facts-gen.cx writes now
 * (2026-11-05).  A fact table that drifts from its generator -- hand-edited, or left behind
 * when the generator changed (the header records the generator's own sha) -- is a second,
 * silent source of the fact.  This runs `facts-gen --check .` and fails on any DIFF row.
 *   sh ./unisacc.com tests/facts-current.cx
 * Prints the DIFF rows and FACTS_CURRENT<TAB>tables=N<TAB>diff=M. */
int main(void){
 char *v[]={"tools/bound","55","sh","./unisacc.com","tools/facts-gen.cx","--","--check",".",0};
 np_result r={0};char why[256];int tables=0,diff=0;long i=0;
 if(np_run(v,".",0,58,&r,why,sizeof why)){fprintf(stderr,"facts-current: %s\n",why);return 2;}
 while(r.out&&i<(long)r.outn){
  long e=i;while(e<(long)r.outn&&r.out[e]!='\n')e++;
  if(e-i>=5&&!memcmp(r.out+i,"SAME\t",5))tables++;
  else if(e-i>=5&&!memcmp(r.out+i,"DIFF\t",5)){tables++;diff++;printf("%.*s\n",(int)(e-i),r.out+i);}
  i=e+1;
 }
 printf("FACTS_CURRENT\ttables=%d\tdiff=%d\n",tables,diff);
 return r.rc||diff||!tables?1:0;
}
