/* 2a model selftest: the product is an observer, not a fresh product witness.
   Reference = the frozen expected-bytes column of tests/librarycontract-cases.tsv (captured once from the Python
   seed reference, W1-F); no interpreter runs here. */
static int hex_equal_file(const char *hex,const char *path){size_t n;char*x=cx_read(path,&n);if(!x)return 0;int ok=strlen(hex)==2*n;for(size_t i=0;ok&&i<n;i++){unsigned v;if(sscanf(hex+2*i,"%2x",&v)!=1||(unsigned char)x[i]!=(unsigned char)v)ok=0;}free(x);return ok;}
int main(int argc,char **argv){
 if(argc!=2)return 2;char in[4096],mo[4096],me[4096],cmd[16384];size_t n;
 snprintf(in,sizeof in,"%s/input",argv[1]);snprintf(mo,sizeof mo,"%s/model.out",argv[1]);snprintf(me,sizeof me,"%s/model.err",argv[1]);
 char *list=cx_read("tests/librarycontract-cases.tsv",&n);if(!list)return 2;int accepted=0,refused=0;
 for(char*p=list;*p;){char*end=strchr(p,'\n');if(!end)return 2;*end=0;if(*p!='#'){
  char*hex=strchr(p,'\t');if(!hex)return 2;*hex++=0;char*code=strchr(hex,'\t');if(!code)return 2;*code++=0;char*expected=strchr(code,'\t');if(expected)*expected++=0;int want=atoi(code);size_t hn=strlen(hex);if(hn%2)return 2;
  if(!want&&(!expected||!*expected)){printf("MECHANISM %s accepted row without frozen expected bytes\n",p);return 2;}
  unsigned char*b=malloc(hn/2+1);if(!b)return 2;for(size_t i=0;i<hn;i+=2){unsigned v;if(sscanf(hex+i,"%2x",&v)!=1)return 2;b[i/2]=(unsigned char)v;}
  if(cx_write(in,b,hn/2))return 2;free(b);
  snprintf(cmd,sizeof cmd,"'%s/run' '%s/model.net' '%s' >'%s' 2>'%s'",argv[1],argv[1],in,mo,me);int m=cx_run_timeout(cmd,3,0,0);
  if(m!=want){printf("CONTRACT_RED %s model=%d expected=%d\n",p,m,want);return 1;}
  if(!want){if(!hex_equal_file(expected,mo)){printf("CONTRACT_RED %s output differs from frozen reference\n",p);return 1;}accepted++;}
  else{size_t mn,en;char*x=cx_read(mo,&mn),*e=cx_read(me,&en);int ok=x&&mn==0&&e&&strstr(e,"library contract");free(x);free(e);if(!ok){printf("CONTRACT_RED %s empty/named refusal fails\n",p);return 1;}refused++;}
 }p=end+1;}
 free(list);printf("librarycontract-model: accept=%d refuse=%d exact frozen reference bytes; named empty refusals\n",accepted,refused);return 0;
}
