#!/usr/bin/env -S unisacc.com -run
/* tests/cxlibc.cx -- layering ratchet over every direct libc/POSIX call of an upper-layer .cx
   (plans/cxlibc-2026-10-30.md).  The names are not a hand list: tools/symindex.cx external classifies
   every called name that no indexed .cx defines -- libc when the flattened prelude include/cx-flat.h
   defines, declares or #defines it, host when nothing does (forwarded to the host C library or to C
   code outside .cx), runtime for _-prefixed and cx_* names, lang for va_start, offsetof, ... -- and
   the count per file here is libc + host.  The bottom layer is exempt: the prefixes and exact files
   of tests/cxraw-layers.tsv, plus include/ and tools/cxcc-hostinc/; archive/ and ujs/ (paper B)
   are not scanned.  apps/csih is upper layer: its rows are csih's debt.
     sh ./unisacc.com tests/cxlibc.cx -- --check   rc 1 naming each file above its row, or with no
                                                   row and a count above 0 (a new file must be 0)
     sh ./unisacc.com tests/cxlibc.cx -- --write   only down: refuses (rc 1, nothing written) while
                                                   any file is above its row or has no row; else
                                                   rewrites the rows with the counts, dropping 0
                                                   and stale rows
     sh ./unisacc.com tests/cxlibc.cx -- --init    the first baseline; refused when tests/cxlibc.tsv
                                                   exists
   One symindex query (under tools/bound 50) does the scan; rc 2 when it fails. */
#define BASELINE "tests/cxlibc.tsv"
#define LAYERS "tests/cxraw-layers.tsv"
#define MAXROWS 8192
#define HN 16384
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use text.text
#pragma unisa use text.num
#pragma unisa use mem.heap

static const char *bottom[80];
static int nbottom;

typedef struct { const char *path; long count; int used; } Row;
static Row rows[MAXROWS];
static int nrows, hrow[HN];
typedef struct { const char *path; long count; } Ext;
static Ext ext[MAXROWS];
static int next_, hext[HN];

static unsigned long hashz(const char *s) { unsigned long h = 1469598103934665603UL; while (*s) { h ^= (unsigned char)*s++; h *= 1099511628211UL; } return h; }
/* the index of PATH in rows / ext, -1 when absent (then added with index V when ADD) */
static int row_find(const char *path, int add, int v) {
    unsigned long h = hashz(path) & (HN - 1);
    while (hrow[h]) { if (tx_eqz(rows[hrow[h] - 1].path, path)) return hrow[h] - 1; h = (h + 1) & (HN - 1); }
    if (add) hrow[h] = v + 1;
    return -1;
}
static int ext_find(const char *path, int add, int v) {
    unsigned long h = hashz(path) & (HN - 1);
    while (hext[h]) { if (tx_eqz(ext[hext[h] - 1].path, path)) return hext[h] - 1; h = (h + 1) & (HN - 1); }
    if (add) hext[h] = v + 1;
    return -1;
}

/* a whole file (kept for the process: rows point into it); 0 when unreadable */
static char *slurp_file(const char *path, long *n) {
    size_t k; char *b = cx_read(path, &k);
    *n = (long)k;
    return b;
}
static int load_layers(void) {
    long n, i = 0; char *b = slurp_file(LAYERS, &n);
    if (!b) { sy_eprintf("cxlibc: cannot read %s\n", LAYERS); return -1; }
    while (i < n) {
        long e = tx_chr(b + i, n - i, '\n'), ln = e < 0 ? n - i : e;
        b[i + ln] = 0;
        if (ln > 0 && b[i] != '#') {
            if (nbottom == 78) { sy_eprintf("cxlibc: %s: too many rows\n", LAYERS); return -1; }
            bottom[nbottom++] = b + i;
        }
        i += ln + 1;
    }
    bottom[nbottom++] = "include/";
    bottom[nbottom++] = "tools/cxcc-hostinc/";
    return 0;
}
/* exempt (bottom layer) or not scanned */
static int skipped(const char *p) {
    long pl = tx_len(p, 4096); int k;
    if (tx_prefix(p, pl, "archive/", 8) || tx_prefix(p, pl, "ujs/", 4)) return 1;
    for (k = 0; k < nbottom; k++) {
        long bl = tx_len(bottom[k], 4096);
        if (bl && bottom[k][bl - 1] == '/' ? tx_prefix(p, pl, bottom[k], bl) : tx_eqz(p, bottom[k])) return 1;
    }
    return 0;
}

static int load_baseline(void) {
    long n, i = 0; char *b = slurp_file(BASELINE, &n);
    if (!b) { sy_eprintf("cxlibc: cannot read %s (run --init once)\n", BASELINE); return -1; }
    while (i < n) {
        long e = tx_chr(b + i, n - i, '\n'), ln = e < 0 ? n - i : e, tab; char *line = b + i, *end; long v;
        line[ln] = 0;
        if (ln > 0 && line[ln - 1] == '\r') line[--ln] = 0;
        if (ln > 0 && line[0] != '#') {
            tab = tx_chr(line, ln, '\t');
            if (tab <= 0 || nrows == MAXROWS) { sy_eprintf("cxlibc: %s: bad row '%s'\n", BASELINE, line); return -1; }
            line[tab] = 0; v = tx_strtol(line + tab + 1, &end, 10);
            if (end == line + tab + 1 || *end || v < 0) { sy_eprintf("cxlibc: %s: bad count for %s\n", BASELINE, line); return -1; }
            if (row_find(line, 0, 0) >= 0) { sy_eprintf("cxlibc: %s: duplicate row %s\n", BASELINE, line); return -1; }
            rows[nrows].path = line; rows[nrows].count = v; rows[nrows].used = 0;
            row_find(line, 1, nrows); nrows++;
        }
        i += ln + 1;
    }
    return 0;
}

/* all of FD into a heap buffer, NUL-terminated */
static char *drain(int fd, long *n) {
    long cap = 1 << 16, r; char *b = mm_alloc(cap);
    *n = 0;
    while (b && (r = sy_read(fd, b + *n, cap - 1 - *n)) > 0) {
        *n += r;
        if (*n + 1 >= cap) { char *g = mm_grow(b, cap * 2); if (!g) { mm_free(b); return 0; } b = g; cap *= 2; }
    }
    if (b) b[*n] = 0;
    return b;
}
/* runs ARGV with stdout and stderr in one pipe; its output, and its exit code in *RC (-1 when not exited) */
static char *run(char **argv, long *n, int *rc) {
    int ofd, pid = sy_spawn_pipe(argv, 0, 0, &ofd, 0), ex = 0, code = 0, sig = 0; char *o;
    *rc = -1;
    if (pid < 0) return 0;
    o = drain(ofd, n);
    sy_close(ofd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) == pid && ex) *rc = code;
    return o;
}

/* the EXTERNAL rows of tools/symindex.cx external --tracked: path -> libc + host */
static int load_external(void) {
    char *v[] = {"./tools/bound", "50", "sh", "./unisacc.com", "tools/symindex.cx", "--", "external", "--tracked", 0};
    long n, i = 0; int rc, summary = 0; char *o = run(v, &n, &rc);
    if (!o || rc != 0) { sy_eprintf("cxlibc: ERROR: symindex external rc %d\n%s", rc, o ? o : ""); return -1; }
    while (i < n) {
        long e = tx_chr(o + i, n - i, '\n'), ln = e < 0 ? n - i : e; char *l = o + i, *f[6]; int k = 0; long q;
        l[ln] = 0;
        if (tx_prefix(l, ln, "EXTERNALS\t", 10)) summary = 1;
        else if (tx_prefix(l, ln, "EXTERNAL\t", 9)) {
            char *end1, *end2; long lc, hc;
            f[k++] = l;
            for (q = 0; q < ln && k < 6; q++) if (l[q] == '\t') { l[q] = 0; f[k++] = l + q + 1; }
            if (k != 6 || !tx_prefixz(f[2], "libc=", 5) || !tx_prefixz(f[3], "host=", 5) || next_ == MAXROWS) { sy_eprintf("cxlibc: ERROR: bad symindex row %s\n", l); return -1; }
            lc = tx_strtol(f[2] + 5, &end1, 10); hc = tx_strtol(f[3] + 5, &end2, 10);
            if (*end1 || *end2 || ext_find(f[1], 0, 0) >= 0) { sy_eprintf("cxlibc: ERROR: bad symindex row %s\n", f[1]); return -1; }
            ext[next_].path = f[1]; ext[next_].count = lc + hc;
            ext_find(f[1], 1, next_); next_++;
        }
        i += ln + 1;
    }
    if (!summary) { sy_eprintf("cxlibc: ERROR: no EXTERNALS line from symindex\n"); return -1; }
    return 0;
}

typedef struct { char *p; long n, cap; } Buf;
static int put(Buf *b, const char *s) {
    long n = tx_len(s, 1 << 20);
    if (b->n + n + 1 > b->cap) {
        long c = (b->n + n + 1) * 2; char *t = mm_grow(b->p, c);
        if (!t) return -1;
        b->p = t; b->cap = c;
    }
    if (n && tx_copy(b->p + b->n, b->cap - b->n, s, n)) return -1;
    b->n += n; b->p[b->n] = 0;
    return 0;
}

int main(int argc, char **argv) {
    int check, init, files = 0, over = 0, under = 0, k, rc; long total = 0, base_total = 0, ln, at;
    char *list; Buf out = {0, 0, 0};
    char *gv[] = {"git", "ls-files", "-s", "-z", "--", "*.cx", ":(exclude)archive/", ":(exclude)ujs/", 0};
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write") && !tx_eqz(argv[1], "--init"))) {
        sy_eprintf("usage: cxlibc.cx --check | --write | --init   (from the repo root)\n"); return 2;
    }
    check = tx_eqz(argv[1], "--check"); init = tx_eqz(argv[1], "--init");
    if (sy_exists(".git") != 1 || sy_exists(LAYERS) != 1) { sy_eprintf("cxlibc: run from the repo root\n"); return 2; }
    if (init) {
        int r = sy_exists(BASELINE);
        if (r == 1) { sy_eprintf("cxlibc: %s exists; --init writes only the first baseline (use --write)\n", BASELINE); return 2; }
        if (r < 0) { sy_eprintf("cxlibc: cannot stat %s: %s\n", BASELINE, sy_strerror(r)); return 2; }
    } else if (load_baseline() < 0) return 2;
    if (load_layers() < 0 || load_external() < 0) return 2;
    list = run(gv, &ln, &rc);
    if (!list || rc != 0) { sy_eprintf("cxlibc: git ls-files failed (rc %d)\n", rc); return 2; }
    if (put(&out, "# tests/cxlibc.tsv -- written by tests/cxlibc.cx --init / --write; change it only through them.\n"
                  "# Direct libc/POSIX calls per upper-layer .cx: libc (named by the prelude include/cx-flat.h) + host (defined\n"
                  "# by no .cx), from tools/symindex.cx external.  Exempt: tests/cxraw-layers.tsv, include/, tools/cxcc-hostinc/;\n"
                  "# archive/ and ujs/ are not scanned.  Every row is debt and only goes down (--write refuses to raise or add);\n"
                  "# a file without a row stays at 0.  Rows under apps/csih/ are csih's debt.  plans/cxlibc-2026-10-30.md\n"
                  "# path\tcalls\n")) return 2;
    for (at = 0; at < ln; ) {   /* "MODE SHA STAGE\tPATH\0"; tracked symlinks (120000) are counted under their target */
        char *rec = list + at, *p; long rl = tx_len(rec, ln - at), tab = tx_chr(rec, rl, '\t'), c; int x, r;
        at += rl + 1;
        if (tab < 0 || tx_prefix(rec, rl, "120000 ", 7)) continue;
        p = rec + tab + 1;
        if (!*p || skipped(p)) continue;
        x = ext_find(p, 0, 0);
        c = x >= 0 ? ext[x].count : 0;
        files++; total += c;
        r = row_find(p, 0, 0);
        if (r >= 0) rows[r].used = 1;
        if (!init && c > (r >= 0 ? rows[r].count : 0)) {
            if (r >= 0) sy_printf("cxlibc: %s has %ld calls, baseline %ld\n", p, c, rows[r].count);
            else sy_printf("cxlibc: %s has %ld calls and no baseline row (a new .cx must have 0)\n", p, c);
            over++;
        } else if (r >= 0 && c < rows[r].count) under++;
        if (c > 0) {
            char line[4200];
            if (cx_fmt(line, sizeof line, "%s\t%ld\n", p, c) || put(&out, line)) { sy_eprintf("cxlibc: row too long: %s\n", p); return 2; }
        }
    }
    for (k = 0; k < nrows; k++) {
        base_total += rows[k].count;
        if (!rows[k].used) sy_printf("cxlibc: stale row %s (not a scanned upper-layer .cx; --write drops it)\n", rows[k].path);
    }
    if (!check) {
        if (over) { sy_printf("cxlibc: FAIL: --write refuses: %d files above their row or without one (it only ratchets down)\n", over); return 1; }
        if (cx_write(BASELINE, out.p, (size_t)out.n) != 0) { sy_eprintf("cxlibc: cannot write %s\n", BASELINE); return 2; }
        sy_printf("cxlibc: wrote %s: %d .cx files, %ld calls (baseline was %ld)\n", BASELINE, files, total, base_total);
        return 0;
    }
    sy_printf("cxlibc: %s: %d .cx files, %ld calls (baseline %ld); %d above baseline, %d below (--write ratchets down)\n",
              over ? "FAIL" : "ok", files, total, base_total, over, under);
    return over ? 1 : 0;
}
