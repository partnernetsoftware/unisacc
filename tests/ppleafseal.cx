#!/usr/bin/env -S unisacc.com -run
/* Verify frozen byte records only. No generator/oracle/model execution. No stamp or reuse grant. */
#include <cx.h>
#define LIMIT 2048
static const char *roles[]={"builder","executor","resource","rule","harness",0};
/* --write-seal: the same checks, then measurement.tsv and identity.tsv are written instead of compared (reseal). */
static int writing;
typedef struct {char *path,*role,*sha;unsigned long size;} Dep;
typedef struct {char *b;size_t n,cap;} Text;
static Dep deps[LIMIT];static int nd;
static void put(Text*t,const char*s,size_t n){if(t->n+n+1>t->cap){t->cap=(t->n+n+1)*2+64;t->b=realloc(t->b,t->cap);if(!t->b)exit(2);}memcpy(t->b+t->n,s,n);t->n+=n;t->b[t->n]=0;}
static int bad(const char*s){printf("ppleafseal: FAIL %s\n",s);return 1;}
static int safe(const char*s){const char*p=s,*q;if(!*s||*s=='/'||strchr(s,'\\'))return 0;while(*p){q=strchr(p,'/');if(!q)q=p+strlen(p);if(q==p||(q-p==1&&*p=='.')||(q-p==2&&p[0]=='.'&&p[1]=='.'))return 0;p=*q?q+1:q;}return 1;}
static int hex64(const char*s){int i;if(strlen(s)!=64)return 0;for(i=0;i<64;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;return 1;}
static int decimal(const char*s,unsigned long*n){unsigned long v=0,d;int i;if(!*s)return 0;for(i=0;s[i];i++){d=s[i]-'0';if(d>9||v>(~0UL-d)/10)return 0;v=v*10+d;}*n=v;return 1;}
static int fields(char*p,char**f,int max){int n=1;f[0]=p;while(*p){if(*p=='\t'){*p=0;if(n==max)return -1;f[n++]=p+1;}p++;}return n;}
static char *load(const char*dir,const char*name,size_t*n){char p[4096];if(!safe(name)||snprintf(p,sizeof p,"%s/%s",dir,name)>=sizeof p)return 0;return cx_read(p,n);}
static int match(const char*dir,const char*name,const char*length,const char*sha,Text*out){size_t n;unsigned long want;char h[65],*b;if(!safe(name)||!decimal(length,&want)||!hex64(sha))return 0;b=load(dir,name,&n);if(!b)return 0;cx_sha256_hex(b,n,h);if(out)put(out,b,n);free(b);return n==want&&!strcmp(h,sha);}
static int cmpstr(const void*a,const void*b){return strcmp(*(char*const*)a,*(char*const*)b);}
static void identity(char**rows,int n,char hex[65]){Text t={0};int i;qsort(rows,n,sizeof(char*),cmpstr);for(i=0;i<n;i++){put(&t,rows[i],strlen(rows[i]));put(&t,"\n",1);}cx_sha256_hex(t.b?t.b:"",t.n,hex);free(t.b);}
static int expected(const char*data){char*b,*p,*end,*f[3];size_t n;int seen[LIMIT]={0},i,count=0;b=load(data,"closure.expected.tsv",&n);if(!b)return bad("independent closure inventory missing");p=b;while(*p){end=strchr(p,'\n');if(!end)return bad("closure inventory truncated");*end=0;if(fields(p,f,3)!=2)return bad("closure inventory record");for(i=0;i<nd;i++)if(!strcmp(deps[i].path,f[1]))break;if(i==nd||strcmp(deps[i].role,f[0])||seen[i]++)return bad("measured dependency omitted/relabeled");count++;p=end+1;}free(b);if(count!=nd)return bad("dependency inventory differs");return 0;}
static int putfile(const char*dir,const char*name,const char*text){char p[4096];FILE*f;if(!safe(name)||snprintf(p,sizeof p,"%s/%s",dir,name)>=sizeof p)return bad("seal path");f=fopen(p,"wb");if(!f)return bad("seal write");fwrite(text,1,strlen(text),f);return fclose(f)?bad("seal write"):0;}
static int metadata(const char *data){size_t n;char *b=load(data,"measurement.tsv",&n);const char *want="schema\tpp-literals-seal-v1\nleaf\texec-pp-literals\nstage\te2\ntarget\tlnx/x86_64\nmodes\tplain+locations\nprotocol\tpp.text+UNIPP1\ncoverage\tnamed-leaf\nscope\tmeasured\nreview\trequired\nexternal-contract\tnone-read\n";if(writing){free(b);return putfile(data,"measurement.tsv",want);}
 if(!b||n!=strlen(want)||memcmp(b,want,n)){free(b);return bad("unsupported/missing measurement identity");}free(b);return 0;}
static int check(const char*data,const char*root,const char*override,int observer){char*b,*p,*end,*f[24],h[65],*rows[LIMIT];size_t n;int i,k,nrows=0,accepts=0,refusals=0,models=0,ac[4]={0},rf[4]={0},located[4]={0};char*modelsha[4],*ids[64];int nids=0;unsigned long rc;char core[65],proof[65];Text result={0};
 if(metadata(data))return 1;nd=0;b=load(data,override?override:"dependencies.tsv",&n);if(!b)return bad("dependencies missing");p=b;
 while(*p){end=strchr(p,'\n');if(!end)return bad("dependency record truncated");*end=0;if(fields(p,f,5)!=4||!safe(f[1])||!decimal(f[2],&rc)||!hex64(f[3]))return bad("bad dependency record");for(i=0;roles[i]&&strcmp(roles[i],f[0]);i++);if(!roles[i]||nd==LIMIT)return bad("unknown/capacity dependency role");for(i=0;i<nd;i++)if(!strcmp(f[1],deps[i].path))return bad("duplicate dependency");
 deps[nd].path=strdup(f[1]);deps[nd].role=strdup(f[0]);deps[nd].sha=strdup(f[3]);deps[nd++].size=rc;
 if((strcmp(f[0],"harness")!=0)&&!match(root,f[1],f[2],f[3],0))return bad("construction/executor/resource identity changed");p=end+1;}free(b);
 if(expected(data))return 1;
 b=load(data,"streams.tsv",&n);if(!b)return bad("streams missing");p=b;
 while(*p){Text err={0},out={0};char tuple[512];end=strchr(p,'\n');if(!end)return bad("stream record truncated");*end=0;if(fields(p,f,24)!=19||strcmp(f[0],"case")||!decimal(f[3],&rc))return bad("bad stream record");
 for(k=4;k<=16;k+=3)if(!match(data,f[k],f[k+1],f[k+2],k==10?&err:(k==7?&out:0)))return bad("input/model/output byte identity changed");
 for(i=0;i<nids;i++)if(!strcmp(ids[i],f[1]))return bad("duplicate case identity");if(nids==64)return bad("too many cases");ids[nids++]=strdup(f[1]);
 if(!strcmp(f[2],"accept")){if(rc)return bad("accepted case has nonzero rc");accepts++;}else if(!strcmp(f[2],"refuse")){if(!rc||rc>125||rc==77||out.n||err.n<8||memcmp(err.b,"reject: ",8))return bad("refusal is not completed named coverage");refusals++;}else return bad("unknown verdict");
 for(i=0;i<models;i++)if(!strcmp(modelsha[i],f[15]))break;if(i==models){if(models==4)return bad("unexpected model count");modelsha[models++]=strdup(f[15]);}
 if(rc)rf[i]++;else{ac[i]++;if(out.n>=6&&!memcmp(out.b,"UNIPP1",6))located[i]++;}
 snprintf(tuple,sizeof tuple,"input=%s model=%s source-label=%s",f[6],f[15],f[18]);rows[nrows++]=strdup(tuple);
 put(&result,f[2],strlen(f[2]));put(&result,f[9],64);put(&result,f[12],64);free(err.b);free(out.b);p=end+1;
 }
 free(b);if(accepts!=6||refusals!=38||models!=2||nrows!=44||ac[0]!=3||ac[1]!=3||rf[0]!=19||rf[1]!=19||located[0]+located[1]!=3||(located[0]!=0&&located[0]!=3))return bad("measured plain/located coverage lost");
 /* Runtime language resources are explicit inputs; tools/env/adapter observations excluded. */
 for(i=0;i<nd;i++)if(!strcmp(deps[i].role,"resource")){char tuple[4096];snprintf(tuple,sizeof tuple,"resource=%s sha=%s",deps[i].path,deps[i].sha);rows[nrows++]=strdup(tuple);}
 b=load(data,"resources.tsv",&n);if(!b)return bad("resource transcript missing");p=b;k=0;
 while(*p){end=strchr(p,'\n');if(!end)return bad("resource transcript truncated");*end=0;if(fields(p,f,8)!=7||strcmp(f[0],"resource")||strncmp(f[3],"hdr/",4)||!safe(f[3]+4)||!match(data,f[4],f[5],f[6],0))return bad("resource response changed");for(i=0;i<nids;i++)if(!strcmp(ids[i],f[1]))break;if(i==nids)return bad("resource transcript has no case");{char tuple[512];snprintf(tuple,sizeof tuple,"resource=%s sha=%s",f[3],f[6]);rows[nrows++]=strdup(tuple);}k++;p=end+1;}free(b);if(k!=14)return bad("measured header response coverage lost");
 rows[nrows++]=strdup("e2 target=lnx/x86_64 modes=plain+locations protocol=pp.text+UNIPP1");
 identity(rows,nrows,core);cx_sha256_hex(result.b,result.n,proof);free(result.b);for(i=0;i<nrows;i++)free(rows[i]);
 {char want[160];snprintf(want,sizeof want,"core\t%s\nproof\t%s\n",core,proof);if(writing)return putfile(data,"identity.tsv",want);b=load(data,"identity.tsv",&n);if(!b||n!=strlen(want)||memcmp(b,want,n)){free(b);return bad("frozen core/output identity differs");}free(b);}
 if(observer)puts("ppleafseal observation: NOT_RULED; archived host/tool identity is a separate record, neither PASS nor FAIL");
 printf("ppleafseal: %d dependencies; 6 accepts, 38 refusals, 2 models; core-inputs %s; output-proof %s; observer %s; review required/no reuse grant\n",nd,core,proof,observer?"checked":"separate");return 0;
}
static int negative(const char*data,const char*root){char*b,*p,*end;size_t n;char path[4096],dir[]="/tmp/ppleaf-negative-XXXXXX";Text t={0};int omitted=0,rc;
 b=load(data,"dependencies.tsv",&n);if(!b||!mkdtemp(dir))return bad("negative setup");p=b;while(*p){end=strchr(p,'\n');if(!end)return bad("negative record truncated");if(!strncmp(p,"rule\texec/pp/",13)&&!omitted)omitted=1;else put(&t,p,end+1-p);p=end+1;}free(b);if(!omitted)return bad("no measured pp rule to omit");snprintf(path,sizeof path,"%s/dependencies.tsv",dir);cx_write(path,t.b,t.n);
 /* Override file is absolute only in this test's private loader, data remains immutable. */
 {char saved[4096];snprintf(saved,sizeof saved,"%s/negative.tsv",data);(void)saved;}
 /* check's override is a data-relative path: make a scratch data directory with symlinks
    to all immutable inputs, except our deliberately incomplete dependency list. */
 {DIR*d=opendir(data);struct dirent*e;char src[4096],dst[4096];while((e=readdir(d))){if(!strcmp(e->d_name,".")||!strcmp(e->d_name,"..")||!strcmp(e->d_name,"dependencies.tsv"))continue;snprintf(src,sizeof src,"%s/%s",data,e->d_name);snprintf(dst,sizeof dst,"%s/%s",dir,e->d_name);if(src[0]!='/'){char cwd[2048],full[4096];getcwd(cwd,sizeof cwd);snprintf(full,sizeof full,"%s/%s",cwd,src);symlink(full,dst);}else symlink(src,dst);}closedir(d);}
 rc=check(dir,root,0,0);if(!rc)return bad("omitted real rule escaped closure inventory");
 /* Restore dependencies; an observer-only mutation must not change the core input ID. */
 {char src[4096],cwd[2048];getcwd(cwd,sizeof cwd);snprintf(src,sizeof src,"%s%s%s/dependencies.tsv",data[0]=='/'?"":cwd,data[0]=='/'?"":"/",data);snprintf(path,sizeof path,"%s/dependencies.tsv",dir);unlink(path);symlink(src,path);}
 if(check(dir,root,0,0))return bad("restored dependency baseline failed");
 /* Mutate real dependencies in a private root, never the shared checkout. */
 {char mirror[]="/tmp/ppleaf-root-XXXXXX",src[4096],dst[4096],cwd[2048];int j;const char*targets[]={"exec/pp/predefines.tsv","include/stdarg.h"};
 if(!mkdtemp(mirror)||!getcwd(cwd,sizeof cwd))return bad("private root setup");
 for(j=0;j<nd;j++){char*slash;snprintf(dst,sizeof dst,"%s/%s",mirror,deps[j].path);for(slash=dst+strlen(mirror)+1;*slash;slash++)if(*slash=='/'){*slash=0;mkdir(dst,0700);*slash='/';}snprintf(src,sizeof src,"%s%s%s/%s",root[0]=='/'?"":cwd,root[0]=='/'?"":"/",root,deps[j].path);if(symlink(src,dst))return bad("private dependency link");}
 if(check(data,mirror,0,0))return bad("private root baseline failed");
 for(j=0;j<2;j++){char*original;size_t size;snprintf(dst,sizeof dst,"%s/%s",mirror,targets[j]);original=cx_read(dst,&size);if(!original)return bad("mutation target absent");unlink(dst);Text changed={0};put(&changed,original,size);put(&changed,"\n",1);cx_write(dst,changed.b,changed.n);free(changed.b);free(original);if(!check(data,mirror,0,0))return bad("changed measured rule/header escaped");unlink(dst);snprintf(src,sizeof src,"%s%s%s/%s",root[0]=='/'?"":cwd,root[0]=='/'?"":"/",root,targets[j]);symlink(src,dst);}
 /* Symlinks and modified copies remain in the private diagnostic directory only. */
 }
 if(check(dir,root,0,0))return bad("restored core verification failed");

 {DIR*d=opendir(dir);struct dirent*e;while((e=readdir(d))){if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;snprintf(path,sizeof path,"%s/%s",dir,e->d_name);unlink(path);}closedir(d);rmdir(dir);}free(t.b);if(!rc)return bad("omitted real rule escaped closure inventory");puts("ppleafseal negative: PASS omission, predefines content change, included stdarg header content change rejected; shared inputs untouched");return 0;
}
int main(int argc,char**argv){if(argc==4&&!strcmp(argv[1],"--check-core"))return check(argv[2],argv[3],0,0);if(argc==4&&!strcmp(argv[1],"--write-seal")){writing=1;return check(argv[2],argv[3],0,0);}if(argc==4&&!strcmp(argv[1],"--check-observation")){puts("ppleafseal observation: NOT_RULED; record only, no core PASS/FAIL decision");return 0;}if(argc==4&&!strcmp(argv[1],"--negative"))return negative(argv[2],argv[3]);fprintf(stderr,"usage: ppleafseal.cx --check-core|--write-seal|--check-observation|--negative DATA ROOT\n");return 2;}
