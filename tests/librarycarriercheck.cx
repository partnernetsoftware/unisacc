#!/usr/bin/env -S unisacc.com -run
/* librarycarriercheck.cx -- explicit fixture certificates only; no model/public carrier acceptance claim.  Ported from
   tests/librarycarriercheck.py (2026-10-23, the owner's direction: the toolchain moves off Python).
   usage: sh ./unisacc.com -run tests/librarycarriercheck.cx -- [-h] [--arch {arm64,x86_64}]
   Run from the repository root (ROOT is the working directory).  In a fresh temporary directory
   (TMPDIR or /tmp, prefix r10-carrier-mechanical-) exec/c/*.h are copied to headers/ and tests/librarycarriercheck.c
   to probe.c; the probe is then built with $CC (default cc) -std=c11 -O1 -Wall -Wextra -Wno-unused-function -lffi and
   run, once plain and once with -fsanitize=address,undefined, every step under `tests/bound 20`.  The child's output
   goes straight through.  A step that fails is fatal, rc 1, as CalledProcessError was; the temporary directory is
   removed either way.  On Darwin the build gets -arch ARCH; an arm64 host running --arch x86_64 runs under
   `arch -x86_64`.
   Arguments follow argparse: -h/--help (prefixes too), --arch VALUE or --arch=VALUE (prefixes too, last one wins),
   usage errors are rc 2 on stderr.  The usage text keeps argparse's prog name from the original
   (librarycarriercheck.py) so the help and error text are byte-identical to it. */
#include <utime.h>

static const char *PROG = "librarycarriercheck.py";
static const char *USAGE = "usage: librarycarriercheck.py [-h] [--arch {arm64,x86_64}]\n";
static char ROOT[4096], TD[4200];

static void rmtree(const char *p) {
    struct stat s; DIR *d; struct dirent *e;
    if (lstat(p, &s) != 0) return;
    if (!S_ISDIR(s.st_mode)) { unlink(p); return; }
    if ((d = opendir(p))) {
        while ((e = readdir(d))) {
            char c[8192];
            if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
            snprintf(c, sizeof c, "%s/%s", p, e->d_name); rmtree(c);
        }
        closedir(d);
    }
    rmdir(p);
}
static void die(const char *fmt, const char *a) {
    fflush(stdout); fprintf(stderr, fmt, a); fputc('\n', stderr);
    if (TD[0]) rmtree(TD);
    exit(1);
}
static void usage_error(const char *msg, const char *a) {
    fflush(stdout); fputs(USAGE, stderr); fprintf(stderr, "%s: error: ", PROG); fprintf(stderr, msg, a); fputc('\n', stderr);
    exit(2);
}

/* shutil.copy2: content, then permission bits and access/modification times */
static void copy2(const char *src, const char *dst) {
    char buf[65536]; int in, out; ssize_t n; struct stat s; struct utimbuf t;
    if ((in = open(src, O_RDONLY)) < 0) die("librarycarriercheck: cannot read %s", src);
    if (fstat(in, &s) != 0) die("librarycarriercheck: cannot stat %s", src);
    if (S_ISDIR(s.st_mode)) die("librarycarriercheck: is a directory: %s", src);
    if ((out = open(dst, O_WRONLY | O_CREAT | O_TRUNC, 0666)) < 0) die("librarycarriercheck: cannot write %s", dst);
    while ((n = read(in, buf, sizeof buf)) > 0)
        if (write(out, buf, (size_t)n) != n) die("librarycarriercheck: cannot write %s", dst);
    if (n < 0) die("librarycarriercheck: cannot read %s", src);
    close(in); close(out);
    chmod(dst, s.st_mode & 07777);
    t.actime = s.st_atime; t.modtime = s.st_mtime; utime(dst, &t);   /* seconds; the probe build ignores them */
}

/* subprocess.run([ROOT/tests/bound, '20', *ARGS], check=True): stdio inherited; a nonzero exit is fatal */
static void run(char **args) {
    char *a[64], bound[4200]; int k = 0, st = 0, rc, i; pid_t pid;
    snprintf(bound, sizeof bound, "%s/tests/bound", ROOT);
    a[k++] = bound; a[k++] = "20";
    while (*args && k < 63) a[k++] = *args++;
    a[k] = 0;
    fflush(stdout); fflush(stderr);
    pid = fork();
    if (pid < 0) die("librarycarriercheck: fork failed for %s", bound);
    if (pid == 0) { execvp(a[0], a); _exit(127); }
    while (waitpid(pid, &st, 0) < 0) if (errno != EINTR) die("librarycarriercheck: wait failed for %s", bound);
    rc = WIFEXITED(st) ? WEXITSTATUS(st) : WIFSIGNALED(st) ? -WTERMSIG(st) : 1;
    if (rc == 0) return;
    fprintf(stderr, "librarycarriercheck: command '[");
    for (i = 0; a[i]; i++) fprintf(stderr, "%s'%s'", i ? ", " : "", a[i]);
    fprintf(stderr, "]' returned non-zero exit status %d.\n", rc);
    if (TD[0]) rmtree(TD);
    exit(1);
}

/* argparse: is this token an option string (not a value)?  '-' alone, negative numbers and '-x y' with a space
   (no option prefix match) are values */
static int looks_negnum(const char *s) {
    const char *p = s + 1; int dig = 0, dot = 0;
    if (*s != '-') return 0;
    for (; *p; p++) { if (*p >= '0' && *p <= '9') dig = 1; else if (*p == '.' && !dot) dot = 1; else return 0; }
    return dig;
}
static int prefix_of(const char *p, size_t n, const char *opt) { return n >= 3 && n <= strlen(opt) && !strncmp(p, opt, n); }
/* which option a '--' token names: 1 help, 2 arch, 0 none; EQ gets the explicit value after '=' or NULL */
static int long_opt(const char *s, const char **eq) {
    const char *e = strchr(s, '='); size_t n = e ? (size_t)(e - s) : strlen(s);
    *eq = e ? e + 1 : 0;
    if (prefix_of(s, n, "--help")) return 1;
    if (prefix_of(s, n, "--arch")) return 2;
    return 0;
}
static int is_option(const char *s) {
    const char *eq;
    if (s[0] != '-' || !s[1]) return 0;
    if (!strcmp(s, "--")) return 1;
    if (s[1] == '-' && long_opt(s, &eq)) return 1;
    if (s[1] == 'h') return 1;
    if (looks_negnum(s)) return 0;
    if (strchr(s, ' ')) return 0;
    return 1;
}

static void parse(int argc, char **argv, const char **arch) {
    static char extras[8192]; size_t xl = 0; int i, help = 0;
    extras[0] = 0;
    for (i = 1; i < argc; i++) {
        const char *s = argv[i], *eq = 0; int o = 0;
        if (!strcmp(s, "--")) {   /* everything from here on is left over, '--' included */
            for (; i < argc; i++) xl += (size_t)snprintf(extras + xl, xl < sizeof extras ? sizeof extras - xl : 0, "%s%s", xl ? " " : "", argv[i]);
            break;
        }
        if (s[0] == '-' && s[1] == '-') o = long_opt(s, &eq);
        else if (s[0] == '-' && s[1] == 'h') o = 1;
        if (o == 1) {   /* --help=X, -h=X and -h-X are refused; -hX is -h followed by -X, and help wins */
            if (eq && s[1] == '-') usage_error("argument -h/--help: ignored explicit argument '%s'", eq);
            if (s[1] == '-' || (s[2] != '=' && s[2] != '-')) { help = 1; break; }
            usage_error("argument -h/--help: ignored explicit argument '%s'", s + 2 + (s[2] == '='));
        } else if (o == 2) {
            const char *v = eq;
            if (!v) {
                if (i + 1 >= argc || is_option(argv[i + 1])) usage_error("argument --arch: expected one argument", 0);
                v = argv[++i];
            }
            if (strcmp(v, "arm64") && strcmp(v, "x86_64"))
                usage_error("argument --arch: invalid choice: '%s' (choose from 'arm64', 'x86_64')", v);
            *arch = v;
        } else xl += (size_t)snprintf(extras + xl, xl < sizeof extras ? sizeof extras - xl : 0, "%s%s", xl ? " " : "", s);
    }
    if (help) {
        printf("%s\noptions:\n  -h, --help            show this help message and exit\n  --arch {arm64,x86_64}\n", USAGE);
        exit(0);
    }
    if (xl) usage_error("unrecognized arguments: %s", extras);
}

/* uname FLAG, its first line; "" when uname cannot run (the libc here has no uname(2)) */
static char *uname_field(char *flag) {
    char *a[] = { "uname", flag, 0 }, *out = 0; size_t n = 0;
    if (cx_runv_timeout(a, 10, &out, &n) != 0 || !out) { free(out); return ""; }
    out[strcspn(out, "\r\n")] = 0;
    return out;
}

int main(int argc, char **argv) {
    const char *arch = 0, *host, *cc, *tmp; int darwin, san; char *mach, *sys;
    char rt[4300], probe[4300], src[4300], cdir[4300];
    DIR *d; struct dirent *e;
    parse(argc, argv, &arch);
    if (getcwd(ROOT, sizeof ROOT) == 0) return 2;
    mach = uname_field("-m"); sys = uname_field("-s");   /* platform.machine(), platform.system() */
    host = (!strcmp(mach, "arm64") || !strcmp(mach, "aarch64")) ? "arm64" : "x86_64";
    if (!arch) arch = host;
    darwin = !strcmp(sys, "Darwin");
    cc = getenv("CC"); if (!cc) cc = "cc";
    tmp = getenv("TMPDIR");   /* tempfile.gettempdir(): TMPDIR, TEMP, TMP, then /tmp */
    if (!tmp || !*tmp) tmp = getenv("TEMP");
    if (!tmp || !*tmp) tmp = getenv("TMP");
    if (!tmp || !*tmp) tmp = "/tmp";
    if (tmp[0] == '/') snprintf(TD, sizeof TD, "%s/r10-carrier-mechanical-XXXXXX", tmp);
    else snprintf(TD, sizeof TD, "%s/%s/r10-carrier-mechanical-XXXXXX", ROOT, tmp);
    if (!mkdtemp(TD)) { const char *t = tmp; TD[0] = 0; die("librarycarriercheck: cannot create a temporary directory under %s", t); }
    snprintf(rt, sizeof rt, "%s/headers", TD);
    if (mkdir(rt, 0777) != 0) die("librarycarriercheck: cannot create %s", rt);
    snprintf(cdir, sizeof cdir, "%s/exec/c", ROOT);
    if ((d = opendir(cdir))) {   /* (ROOT/'exec/c').glob('*.h') */
        while ((e = readdir(d))) {
            size_t n = strlen(e->d_name); char from[8400], to[8400];
            if (n < 2 || strcmp(e->d_name + n - 2, ".h")) continue;
            snprintf(from, sizeof from, "%s/%s", cdir, e->d_name);
            snprintf(to, sizeof to, "%s/%s", rt, e->d_name);
            copy2(from, to);
        }
        closedir(d);
    }
    snprintf(src, sizeof src, "%s/tests/librarycarriercheck.c", ROOT);
    snprintf(probe, sizeof probe, "%s/probe.c", TD);
    copy2(src, probe);
    for (san = 0; san <= 1; san++) {
        char exe[4300], *b[32], *r[8]; int k = 0, j = 0;
        snprintf(exe, sizeof exe, "%s/%s", TD, san ? "san" : "normal");
        b[k++] = (char *)cc;
        if (darwin) { b[k++] = "-arch"; b[k++] = (char *)arch; }
        b[k++] = "-std=c11"; b[k++] = "-O1"; b[k++] = "-Wall"; b[k++] = "-Wextra"; b[k++] = "-Wno-unused-function";
        b[k++] = "-I"; b[k++] = rt; b[k++] = probe; b[k++] = "-lffi"; b[k++] = "-o"; b[k++] = exe;
        if (san) { b[k++] = "-fsanitize=address,undefined"; b[k++] = "-fno-omit-frame-pointer"; b[k++] = "-g"; }
        b[k] = 0;
        run(b);
        if (!strcmp(host, "arm64") && !strcmp(arch, "x86_64")) { r[j++] = "arch"; r[j++] = "-x86_64"; }
        r[j++] = exe; r[j] = 0;
        run(r);
    }
    rmtree(TD);
    printf("explicit carrier mechanical normal + ASan/UBSan passed on %s\n", arch);
    return 0;
}
