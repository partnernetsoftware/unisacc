/* Formal batch wrapper for a prebuilt O2 ELF of tools/p3-nn-asm-provenance.cx.
 * ROOT SOURCE_CTX PACK_CTX GEN_C GEN_B TOOL_ELF NEW_ABS_OUT
 * Compile the ELF in a separate outer55 prepare; this leaf only verifies. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
static char root[4096],ctx[4096],pc[4096],genc[4096],genb[4096],elf[4096],work[4096];
static char bound[4400],product[4400],tool[4400];
static int checks,failed;
static void die(const char *s){fprintf(stderr,"p3-nn-asm-provenance-test: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void ck(int ok,const char *s){checks++;if(!ok)failed++;printf("%s\tp3-nn-asm-provenance-test.%s\n",ok?"PASS":"FAIL",s);}
static void path(char *out,size_t cap,const char *a,const char *b){int n=snprintf(out,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path-bound");}
static void copy_fit(char *dst,size_t cap,const char *src){size_t i=0;if(!cap)die("copy-bound");while(src[i]&&i+1<cap){dst[i]=src[i];i++;}if(src[i])die("copy-bound");dst[i]=0;}
static int within(const char *p,const char *base){size_t n=strlen(base);return !strncmp(p,base,n)&&(!p[n]||p[n]=='/');}
static char *load(const char *p,size_t *n){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>8388608)die("regular-input");char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("input-extent");return s;}
static void hash(const char *p,char out[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,out);free(s);}
static void save(const char *name,const char *s,size_t n){char p[4400];path(p,sizeof p,work,name);int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-evidence");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("evidence-write");at+=(size_t)z;}if(fsync(fd)||close(fd))die("evidence-close");}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN p3-nn-asm-provenance-test needs Linux/x86_64\n",stderr);return 3;
#endif
 if(argc!=8||!realpath(argv[1],root)||!realpath(argv[2],ctx)||!realpath(argv[3],pc)||!realpath(argv[4],genc)||!realpath(argv[5],genb)||!realpath(argv[6],elf)||argv[7][0]!='/')die("usage ROOT SOURCE_CTX PACK_CTX GEN_C GEN_B TOOL_ELF NEW_ABS_OUT");
 char parent[4096],base[4096],leaf[4096];copy_fit(parent,sizeof parent,argv[7]);char *slash=strrchr(parent,'/');if(!slash||!slash[1]||tx_eq(slash+1, ".", 1L << 20)||tx_eq(slash+1, "..", 1L << 20))die("output-leaf");copy_fit(leaf,sizeof leaf,slash+1);if(slash==parent)slash[1]=0;else *slash=0;if(!realpath(parent,base))die("output-parent");int z=snprintf(work,sizeof work,"%s%s%s",base,tx_eq(base, "/", 1L << 20)?"":"/",leaf);if(z<0||(size_t)z>=sizeof work||within(work,ctx)||within(work,pc)||within(work,genc)||within(work,genb)||within(work,elf))die("output-aliases-input");if(mkdir(work,0700))die("new-output-required");
 path(bound,sizeof bound,root,"tools/bound");path(product,sizeof product,root,"unisacc.com");path(tool,sizeof tool,root,"tools/p3-nn-asm-provenance.cx");
 char before[3][65];hash(product,before[0]);hash(tool,before[1]);hash(elf,before[2]);
 if(access(elf,X_OK))die("tool-elf-executable");
 char *cmd[]={bound,"50",elf,root,ctx,pc,genc,genb,0};
 np_result r;char why[1024];if(np_run(cmd,root,0,52,&r,why,sizeof why))die(why);
 save("tool.stdout",r.out,r.outn);save("tool.stderr",r.err,r.errn);
 {char status[40];int sn=snprintf(status,sizeof status,"rc\t%d\n",r.rc);save("tool.status",status,(size_t)sn);}
 int ok=!r.rc&&!r.errn&&r.outn&&strstr(r.out,"P3_NN_ASM_PROVENANCE\t")&&strstr(r.out,"failed=0");
 ck(ok,"tool-verified");if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(!ok)die("provenance-required");
 char after[65];hash(product,after);ck(tx_eq(after, before[0], 1L << 20),"product-unchanged");hash(tool,after);ck(tx_eq(after, before[1], 1L << 20),"tool-source-unchanged");hash(elf,after);ck(tx_eq(after, before[2], 1L << 20),"tool-elf-unchanged");
 puts("NOT_CLAIMED\thostseed-payload-trust-rewrite-hermetic-host-CC-libz-classic18-MODEL-in-P3-complete-N22-foreign-hosts");
 printf("P3_NN_ASM_PROVENANCE_BATCH\tassertions=%d\tfailed=%d\n",checks,failed);return failed?1:0;
}
