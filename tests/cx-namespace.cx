#!/usr/bin/env -S unisacc.com -run
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use text.text
/* cx-namespace.cx -- lock the cxmod namespace/conflict rejection. usage: ROOT PRODUCT NEW_DIR */
static int fails, checks;
static char dir[4096];
static void note(int ok, const char *name) { printf("%s\t%s\n", ok ? "PASS" : "FAIL", name); checks++; if (!ok) fails++; }
static int write_file(const char *rel, const char *s) { char p[4096]; if (cx_path_join(p, sizeof p, dir, rel)) return 1; return cx_write(p, s, tx_len(s, 1L << 20)); }
static int plan_rc(const char *product, const char *main, int exp, const char *want, char *out, int cap) {
    char full[4096]; char *av[8]; int rc, cut = 0; long n;
    if (cx_path_join(full, sizeof full, dir, main)) return 0;
    av[0] = "sh"; av[1] = (char *)product; av[2] = "-cx-plan"; av[3] = full; av[4] = 0;
    rc = sy_run(av, out, cap, &cut);
    if (rc != exp) return 0;
    if (want) { n = tx_len(want, 512); if (tx_find(out, tx_len(out, cap), want, n) < 0) return 0; }
    return 1;
}
int main(int argc, char **argv) {
    char out[8192]; char root[4096], product[4096];
    if (argc != 4 || !realpath(argv[1], root) || !realpath(argv[2], product) || !argv[3][0]) { fputs("usage: ROOT PRODUCT NEW_DIR\n", stderr); return 2; }
    { if (cx_fmt(dir, sizeof dir, "%s", argv[3])) return 2; }
    if (sy_mkdir(dir, 0700) != 0) { perror("output dir"); return 2; }
    (void)root;
    write_file("a.cx", "#pragma unisa module a\nint clash(void){return 1;}\n");
    write_file("b.cx", "#pragma unisa module b\nint clash(void){return 2;}\n");
    write_file("c1.cx", "#pragma unisa use a\n#pragma unisa use b\nint main(void){return clash();}\n");
    note(plan_rc(product, "c1.cx", 1, "clash exported by both a", out, sizeof out), "exported-by-both-refused");
    write_file("m2.cx", "#pragma unisa module m2\nint val(void){return 1;}\n");
    write_file("c2.cx", "#pragma unisa use m2\nint val(void){return 2;}\nint main(void){return val();}\n");
    note(plan_rc(product, "c2.cx", 1, "val is exported by m2", out, sizeof out), "unit-defines-export-refused");
    write_file("t3.cx", "#pragma unisa module t3\nstruct S { int x; };\nint fa(void){return 1;}\n");
    write_file("t4.cx", "#pragma unisa module t4\nstruct S { int y; };\nint fb(void){return 2;}\n");
    write_file("c3.cx", "#pragma unisa use t3\n#pragma unisa use t4\nint main(void){return fa()+fb();}\n");
    note(plan_rc(product, "c3.cx", 1, "type struct S from t3 and t4", out, sizeof out), "type-from-two-refused");
    write_file("ok.cx", "#pragma unisa module ok\nint fine(void){return 5;}\n");
    write_file("c4.cx", "#pragma unisa use ok\nint main(void){return fine();}\n");
    note(plan_rc(product, "c4.cx", 0, 0, out, sizeof out), "no-clash-plans");
    /* symbol-level import + alias: use a::clash as ca and b::clash as cb, the clash is renamed away */
    write_file("ca1.cx", "#pragma unisa use a::clash as ca\n#pragma unisa use b::clash as cb\nint main(void){return ca()+cb();}\n");
    note(plan_rc(product, "ca1.cx", 0, 0, out, sizeof out), "alias-renames-away-clash");
    /* symbol-level import without alias: use aa::other imports only other, so bb's clash no longer clashes */
    write_file("aa.cx", "#pragma unisa module aa\nint clash(void){return 1;}\nint other(void){return 7;}\n");
    write_file("bb.cx", "#pragma unisa module bb\nint clash(void){return 2;}\n");
    write_file("cs1.cx", "#pragma unisa use aa::other\n#pragma unisa use bb::clash\nint main(void){return other()+clash();}\n");
    note(plan_rc(product, "cs1.cx", 0, 0, out, sizeof out), "symbol-import-filters-unused");
    write_file("cy1.cx", "#pragma unisa module cy1\n#pragma unisa use cy2\nint c1(void){return c2();}\n");
    write_file("cy2.cx", "#pragma unisa module cy2\n#pragma unisa use cy1\nint c2(void){return c1();}\n");
    write_file("c5.cx", "#pragma unisa use cy1\nint main(void){return c1();}\n");
    note(plan_rc(product, "c5.cx", 1, "module cycle", out, sizeof out), "import-cycle-refused");
    write_file("cy3.cx", "#pragma unisa module cy3\n#pragma unisa use cy3\nint c3(void){return 3;}\n");
    write_file("c6.cx", "#pragma unisa use cy3\nint main(void){return c3();}\n");
    note(plan_rc(product, "c6.cx", 1, "module cycle", out, sizeof out), "self-cycle-refused");
    printf("CX_NAMESPACE\tchecks=%d\tfailed=%d\n", checks, fails);
    return fails ? 1 : 0;
}
