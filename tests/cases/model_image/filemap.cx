#pragma unisa module filemap
/* Test fixture only. This is not a product mapping API. */
int sy_map_file_ro(void **out,int fd,long n){
    void *mmap(void *,size_t,int,int,int,long);
    if(!out||fd<0||n<=0)return -EINVAL;
    *out=0;void *p=mmap(0,(size_t)n,1,2,fd,0);
    if((long)p==-1)return -errno;
    if(!p)return -ENOMEM;
    *out=p;return 0;
}
