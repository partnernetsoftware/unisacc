#pragma unisa module model_image
#pragma unisa use model_lifetime
/* CXMI0001: little-endian LP64 host layout, version 1. Header: magic[8],
 * version u64, exact total u64, eight nonnegative scalar u64s, sixteen
 * top-level offsets u64. Pointer tables contain image-relative u64 offsets.
 * Blocks are canonical, ordered, eight-byte aligned, and never overlap.
 * A present empty block occupies one zero byte; offset zero means NULL.
 * Numeric blocks are native int32/int64 on the explicitly checked host ABI.
 * The caller owns image lifetime; only image_view may be released by view users.
 */
static long mi_get(const unsigned char *p) {
    unsigned long long v = 0;
    for (int i=0;i<8;i++) v |= (unsigned long long)p[i] << (8*i);
    if (v > 9223372036854775807ULL) return -1;
    return (long)v;
}
static void mi_put(unsigned char *p, long v) {
    for (int i=0;i<8;i++) p[i]=(unsigned char)((unsigned long long)v >> (8*i));
}
static int mi_abi(void) {
    int one=1;
    return sizeof(int)==4 && sizeof(int64_t)==8 && sizeof(long)==8 && sizeof(void *)==8 && *(unsigned char *)&one==1;
}
static int mi_shape(const CxModel *m) {
    if (!m || !mi_abi() || m->ns<0 || m->nq<0 || m->nrg<0 || m->nstr<0 || m->nstr==2147483647 || m->start<0 || m->topmax<0 || m->nqa<0 || (m->isnet!=0 && m->isnet!=1)) return 0;
    if ((m->ns && m->start>=m->ns) || (!m->ns && m->start)) return 0;
    if (m->str && !m->strl) return 0;
    if (m->ns && (!m->smode || !m->rowc)) return 0;
    for (int s=0;s<m->ns;s++) {
        if (m->rowc[s]<0 || m->smode[s]<0 || m->smode[s]>2) return 0;
        if (!m->isnet && m->smode[s]!=1 && m->rowk && m->rowk[s]) return 0;
    }
    return 1;
}
static void mi_fields(const CxModel *m, const void **p, long *n, int *w) {
    p[0]=m->str; p[1]=m->strl; p[2]=m->qoff; p[3]=m->qlen; p[4]=m->qa;
    p[5]=m->smode; p[6]=m->rowc; p[7]=m->rowk; p[8]=m->rown; p[9]=m->rowq;
    p[10]=m->nlo; p[11]=m->nhi; p[12]=m->bn; p[13]=m->bq; p[14]=m->rets; p[15]=m->retok;
    for(int i=0;i<16;i++) { n[i]=m->ns; w[i]=4; }
    n[0]=(long)m->nstr+1; n[1]=n[0]; n[2]=m->nq; n[3]=m->nq; n[4]=m->nqa;
    w[0]=8; w[4]=8; w[7]=8; w[8]=8; w[9]=8; w[15]=8;
}
/* Advances only after checked multiplication, alignment, and addition. */
static long mi_slot(long *at, long count, int width) {
    long bytes, off;
    if (count<0 || width<=0 || count>9223372036854775807L/width || *at>9223372036854775800L) return -1;
    bytes=count*width; if (!bytes) bytes=1;
    off=(*at+7)&~7L;
    if (bytes>9223372036854775807L-off) return -1;
    *at=off+bytes;
    return off;
}
static long mi_pack(const CxModel *m, unsigned char *out) {
