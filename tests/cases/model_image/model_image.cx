            else if(t==4) { count=m.ns; width=1; }
            else { count=(m.isnet || m.smode[s]==1)?m.rowc[s]:257; width=4; }
            if(!mi_span(image,size,pos,count,width,&at) || (t==1 && !m.isnet && m.smode[s]!=1 && pos)) { release(pool); return 1; }
            tab[s]=pos?(void *)(image+pos):0;
