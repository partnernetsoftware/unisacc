        tab=pool+used; used+=n[f]?n[f]:1;
        if(!t) m.str=(char **)tab;
        else if(t==1) m.rowk=(int **)tab;
        else if(t==2) m.rown=(int **)tab;
        else if(t==3) m.rowq=(int **)tab;
        else m.retok=(unsigned char **)tab;
