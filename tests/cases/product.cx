/* Original batch fixtures; arithmetic expectations are independently hand-derived.
 * Raw pointers, callbacks and malloc/free exercise existing unsafe C behavior.
 * This module does not establish static ownership or borrowing guarantees. */
#pragma unisa module product
static int batch_calls;
static int sum(int a,int b){return a+b;}
static int fac(int n){return n<2?1:n*fac(n-1);}
static int fib(int n){return n<2?n:fib(n-1)+fib(n-2);}
static int square(int n){return n*n;}
typedef struct {int quantity;int price;} BatchRow;
static void setprice(BatchRow *r,int n){r->price=n;}
static int nextcall(void){batch_calls++;return batch_calls;}
int product_count(void){return 16;}
void product_values(long *v){
 BatchRow rows[3]={{1,4},{2,6},{3,6}};int i,t,hit=0;int (*fn)(int)=square;
 char overlap[8]="abcde",buf[32],hex[65],*tail;int *p;
 v[0]=sum(19,23);v[1]=fac(6);v[2]=fib(10);
 t=0;for(i=0;i<3;i++)t+=rows[i].quantity*rows[i].price;v[3]=t;
 setprice(&rows[0],17);v[4]=rows[0].price;v[5]=fn(9);
 t=0;for(i=0;i<10;i++){if(i%2==0)continue;t+=i;}v[6]=t;
 if(0&&++hit)hit++;if(1||++hit){}v[7]=hit;
 memmove(overlap+1,overlap,4);v[8]=strcmp(overlap,"aabcd");
 v[9]=snprintf(buf,sizeof buf,"%d:%s",-17,"abc");v[10]=strcmp(buf,"-17:abc");
 v[11]=strtol("-123x",&tail,10);v[12]=(unsigned char)*tail;
 p=malloc(10*sizeof(int));if(!p){v[13]=-1;}else{t=0;for(i=0;i<10;i++){p[i]=i;t+=p[i];}v[13]=t;free(p);}
 cx_sha256_hex("abc",3,hex);v[14]=strcmp(hex,"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
 batch_calls=0;nextcall();v[15]=nextcall();
}
