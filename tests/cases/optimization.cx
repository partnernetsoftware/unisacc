/* Defined C integer/alias/control-flow behavior. Input is supplied at runtime;
 * expected values live independently in the driver, never in this module. */
#pragma unisa module optimization

static int alias_store(int *p,int *q,int value){*p=4;*q=value;return *p;}
static int choose(int n){switch(n){case -1:return -3;case 0:return 7;case 1:return 11;case 2:return 13;default:return 17;}}
static int triangular(int n){return n? n+triangular(n-1):0;}
typedef struct {int a;int b;} OptPair;

int optimization_count(void){return 14;}
void optimization_values(int input,long *out){
 int i,total,a,b,hit=0,value=1;
 unsigned int u=0xfffffffdu;
 signed char small=(signed char)(-input);
 unsigned char byte=250;
 OptPair p={input,3},q=p;
 out[0]=(input+3)*5-(input+3)*2;
 a=-(input*3+2);out[1]=(a/5)*10+a%5;
 out[2]=(0x80000000u>>28)+((unsigned int)input<<2);
 out[3]=(int)(u+(unsigned int)input);
 out[4]=small+byte;
 out[5]=alias_store(&a,&a,input);
 out[6]=alias_store(&a,&b,input);
 total=0;for(i=0;i<input+2;i++){if(i==input+1)break;if(i%3==0)continue;total+=i;}out[7]=total;
 total=0;for(i=0;i<input;i++)total+=i*i;out[8]=total;
 total=input;for(i=-1;i<4;i++)total+=choose(i);out[9]=total;
 if(0&&++hit)hit++;if(1||++hit){}a=input>0?input+1:++hit;out[10]=a*10+hit;
 for(i=0;i<input;i++){if(i%2)value+=i;else value-=i;}out[11]=value;
 out[12]=triangular(input);
 q.b=5;out[13]=p.a*p.b+q.a*q.b;
}
