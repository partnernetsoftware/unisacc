#pragma unisa module hash
#pragma unisa use records

static medium_u64 helper(medium_u64 h, unsigned int byte) {
    return (h ^ (medium_u64)(byte & 255)) * 1099511628211ULL;
}

medium_u64 medium_record_hash(const medium_record *r) {
    medium_u64 h = 14695981039346656037ULL;
    unsigned int j;
    /* Explicit little-endian field encoding, never raw structure bytes. */
    for (j = 0; j < 4; j++) h = helper(h, r->key >> (j * 8));
    for (j = 0; j < 4; j++) h = helper(h, r->origin >> (j * 8));
    for (j = 0; j < 8; j++) {
        h = helper(h, (unsigned int)((r->value >> (j * 8)) & 255));
    }
    for (j = 0; j < 7; j++) h = helper(h, (unsigned char)r->tag[j]);
    return h;
}

medium_u64 medium_digest(const medium_record *a, unsigned int n) {
    medium_u64 h = 0x243f6a8885a308d3ULL;
    unsigned int i;
    for (i = 0; i < n; i++) {
        medium_u64 item = medium_record_hash(&a[i]);
        h = ((h << 9) | (h >> 55)) ^ item;
        h = h * 0x9e3779b185ebca87ULL + i;
    }
    return h;
}

medium_u64 medium_bag(const medium_record *a, unsigned int n) {
    medium_u64 sum = 0;
    unsigned int i;
    for (i = 0; i < n; i++) sum += medium_record_hash(&a[i]);
    return sum;
}
