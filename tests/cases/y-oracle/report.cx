#pragma unisa module report
#pragma unisa use records
#pragma unisa use graph

static unsigned int helper(medium_u64 value, unsigned int shift) {
    return (unsigned int)((value >> shift) & 0xffffffffULL);
}

int medium_failure(unsigned int code) {
    printf("whole-front-medium failure=%u\n", code);
    return (int)code;
}

void medium_report(unsigned int count, medium_u64 ascending,
                   medium_u64 descending, medium_u64 bag,
                   const medium_graph_result *graph) {
    /* Two fixed-width halves avoid LLP64 long/printf width differences. */
    printf("whole-front-medium records=%u nodes=%u reachable=%u diameter=%u\n",
           count, medium_graph_nodes(), graph->reachable, graph->diameter);
    printf("ascending=%08x%08x descending=%08x%08x\n",
           helper(ascending, 32), helper(ascending, 0),
           helper(descending, 32), helper(descending, 0));
    printf("bag=%08x%08x graph=%08x%08x\n",
           helper(bag, 32), helper(bag, 0),
           helper(graph->digest, 32), helper(graph->digest, 0));
}
