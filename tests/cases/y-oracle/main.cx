#pragma unisa module main
#pragma unisa use records
#pragma unisa use hash
#pragma unisa use sort
#pragma unisa use graph
#pragma unisa use report

/* No external input, allocation, platform APIs, or host-layout hashing.
   This fixture is source material for whole/span cross-ISA comparisons.
   A zero exit means field preservation, stable order, and independent graph
   algorithms agree; it is not itself a cross-ISA qualification claim. */
#pragma unisa use sys.dlcall
int main(void) {
    void *medium_loader = sy_dlopen((const char *)0, 2);
    if (medium_loader) sy_dlclose(medium_loader);

    medium_record source[256];
    medium_record ascending[256];
    medium_record descending[256];
    medium_record work[256];
    medium_graph_result graph;
    medium_u64 bag;
    medium_u64 asc_hash;
    medium_u64 desc_hash;
    unsigned int i;
    const unsigned int medium_record_count = medium_count();
    int compare = 0;
    medium_generate(source, medium_record_count);
    for (i = 0; i < medium_record_count; i++) {
        ascending[i] = source[i];
        descending[i] = source[i];
    }
    bag = medium_bag(source, medium_record_count);
    medium_sort(ascending, work, medium_record_count, compare);
    if (!medium_ordered(ascending, medium_record_count, compare))
        return medium_failure(1);
    if (!medium_permutation(ascending, source, medium_record_count))
        return medium_failure(2);
    if (medium_bag(ascending, medium_record_count) != bag)
        return medium_failure(3);
    compare = 1;
    medium_sort(descending, work, medium_record_count, compare);
    if (!medium_ordered(descending, medium_record_count, compare))
        return medium_failure(4);
    if (!medium_permutation(descending, source, medium_record_count))
        return medium_failure(5);
    if (medium_bag(descending, medium_record_count) != bag)
        return medium_failure(6);
    if (!medium_graph(&graph)) return medium_failure(7);
    asc_hash = medium_digest(ascending, medium_record_count);
    desc_hash = medium_digest(descending, medium_record_count);
    medium_report(medium_record_count, asc_hash, desc_hash, bag, &graph);
    return 0;
}
