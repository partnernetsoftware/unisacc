/* The runner owns the deadline; the registered checker and extractor are prepared materials. */
#pragma unisa use sys.proc

int main(int argc, char **argv) {
    if (argc < 3 || argv[1][0] != '/') return 2;
    if (!strcmp(argv[2], "--core")) {
        if (argc != 4 || argv[3][0] != '/') return 2;
    } else if (argc != 3 || strcmp(argv[2], "--exports")) return 2;
    sy_spawn_t opt;
    sy_child_t child;
    sy_exit_t status;
    sy_spawn_init(&opt);
    opt.argv = argv + 1;
    opt.deadline_ms = 55000;
    if (sy_proc_spawn(&opt, &child) || sy_proc_wait(&child, &status)) return 2;
    return sy_exit_code(&status);
}
