/* Fault-injection fixture for the actual shared C ledger. This prefix wraps
 * allocation and OS boundaries only; ledger parsing/writing stays verbatim. */
static long sn_live,sn_allocs,sn_fail_alloc=-1,sn_fds,sn_streams;static int sn_fail_close=-1,sn_fail_fclose=-1,sn_clobber_cleanup;
static long sn_fail_link=-1,sn_links,sn_commit_at;
static int sn_fail_dir=-1,sn_table_reads,sn_blob_reads,sn_count_reads,sn_grow_empty,sn_empty_fd=-1;static char sn_empty_path[4096];
static void *sn_malloc(size_t n){sn_allocs++;if(sn_fail_alloc==0)return 0;if(sn_fail_alloc>0)sn_fail_alloc--;void *p=malloc(n);if(p)sn_live++;return p;}
static void *sn_realloc(void *p,size_t n){sn_allocs++;if(sn_fail_alloc==0)return 0;if(sn_fail_alloc>0)sn_fail_alloc--;int fresh=(p==0);void *q=realloc(p,n);if(q&&fresh)sn_live++;return q;}
static void sn_free(void *p){if(p)sn_live--;free(p);}
static int sn_open(const char *p,int flags){if(sn_count_reads){const char *name=strrchr(p,'/');name=name?name+1:p;if(!strcmp(name,"resources.tsv"))sn_table_reads++;if(!strcmp(name,"resource-002.bytes"))sn_blob_reads++;}int fd=open(p,flags);if(fd>=0)sn_fds++;if(sn_grow_empty){const char *name=strrchr(p,'/');if(name&&!strcmp(name+1,"resource-001.bytes")){sn_empty_fd=fd;if(strlen(p)>=sizeof sn_empty_path)return -1;strcpy(sn_empty_path,p);}}return fd;}
static int sn_fstat(int fd,struct stat *st){int r=fstat(fd,st);if(!r&&sn_grow_empty&&fd==sn_empty_fd){int out=open(sn_empty_path,O_WRONLY|O_APPEND);if(out<0||write(out,"x",1)!=1||close(out))exit(2);sn_grow_empty=0;}return r;}
static int sn_close(int fd){int r=close(fd);if(!r)sn_fds--;if(sn_fail_close==0){errno=EIO;return -1;}if(sn_fail_close>0)sn_fail_close--;return r;}
static FILE *sn_fopen(const char *p,const char *mode){FILE *f=fopen(p,mode);if(f)sn_streams++;return f;}
static int sn_fclose(FILE *f){int r=fclose(f);sn_streams--;if(sn_fail_fclose==0){errno=EIO;return EOF;}if(sn_fail_fclose>0)sn_fail_fclose--;return r;}
static int sn_rmdir(const char *p){int r=rmdir(p);if(sn_clobber_cleanup)errno=EIO;return r;}
static struct dirent *sn_readdir(DIR *d){if(sn_fail_dir==0){errno=EIO;return 0;}if(sn_fail_dir>0)sn_fail_dir--;return readdir(d);}
static long sn_syscall(long nr,long a,long b,long c,long d,long e){
 long expected;
#if defined(__APPLE__)
 expected=0x2000009L;
#elif defined(__x86_64__)
 expected=86;
#else
 expected=37;
#endif
 if(nr!=expected)return -ENOSYS;
 const char *to=(const char *)(nr==37?d:b),*name=strrchr(to,'/');name=name?name+1:to;
 sn_links++;if(!strcmp(name,"COMMIT"))sn_commit_at=sn_links;
 if(sn_fail_link==0)return -EIO;if(sn_fail_link>0)sn_fail_link--;
#if defined(__APPLE__)
 return __syscall6(0x2000009L,a,b,c,d,e);
#elif defined(__x86_64__)
 return __syscall6(86,a,b,c,d,e);
#else
 return __syscall6(37,a,b,c,d,e);
#endif
}
#define malloc sn_malloc
#define realloc sn_realloc
#define free sn_free
#define open sn_open
#define fstat sn_fstat
#define close sn_close
#define fopen sn_fopen
#define fclose sn_fclose
#define rmdir sn_rmdir
#define readdir sn_readdir
#define __syscall6 sn_syscall
/* LEDGER_BODY */
#undef malloc
#undef realloc
#undef free
#undef open
#undef fstat
#undef close
#undef fopen
#undef fclose
#undef rmdir
#undef readdir
#undef __syscall6

static int sn_released(void){return !sn_live&&!sn_fds&&!sn_streams;}
static int assertions,failures;static char base[4096],good[4096];
static const char *stage="lower:lnx/x86_64/run/O0";
static const unsigned char input[]="abc",ka[]="alpha",ke[]={0,'e','m','p','t','y'},kb[]={'k',0,'x'},binary[]={0,255,1};
static RLBlob blobs[3];
static void die(const char *s){fprintf(stderr,"snapshots: fixture %s errno=%d\n",s,errno);exit(2);}
static void ck(int ok,const char *name){assertions++;if(!ok)failures++;printf("%s\tsnapshot.%s\n",ok?"PASS":"FAIL",name);}
static void join(char *p,const char *a,const char *b){int n=snprintf(p,4096,"%s/%s",a,b);if(n<0||n>=4096)die("path");}
static int absent(const char *p){struct stat st;errno=0;if(!lstat(p,&st))return 0;if(errno!=ENOENT)die("existence check");return 1;}
static char *load(const char *p,size_t *n){char *b=cx_read(p,n);if(!b)die(p);return b;}
static void save(const char *p,const void *data,size_t n,int exclusive){int fd=open(p,O_WRONLY|O_CREAT|O_CLOEXEC|(exclusive?O_EXCL:O_TRUNC),0600);if(fd<0)die("fixture output");const char *b=data;while(n){ssize_t z=write(fd,b,n);if(z<0&&errno==EINTR)continue;if(z<=0)die("fixture write");b+=z;n-=(size_t)z;}if(close(fd))die("fixture close");}
static void copy(const char *name,char *out){join(out,base,name);if(mkdir(out,0700))die("clone directory");DIR *d=opendir(good);if(!d)die("clone input");struct dirent *e;while((e=readdir(d))){if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;char a[4096],b[4096];size_t n;join(a,good,e->d_name);join(b,out,e->d_name);char *s=load(a,&n);save(b,s,n,1);free(s);}if(closedir(d))die("clone close");}
static void resign(const char *dir,const char *name){char path[4096],hash[65];size_t n,cn;join(path,dir,name);char *s=load(path,&n);cx_sha256_hex(s,n,hash);free(s);join(path,dir,"COMMIT");s=load(path,&cn);size_t at=0;int changed=0;while(at<cn){size_t end=at;while(end<cn&&s[end]!='\n')end++;if(end==cn)die("commit fixture");if(end-at==66+strlen(name)&&!memcmp(s+at+66,name,strlen(name))){memcpy(s+at,hash,64);changed++;}at=end+1;}if(changed!=1)die("resign fixture name");save(path,s,cn,0);free(s);}
static void reject(const char *dir,const char *label,const char *reason){char err[512]={0},name[140];RLLedger L={0};int r=rl_snapshot_load(dir,label,&L,0,err,sizeof err);snprintf(name,sizeof name,"%s.reason",reason);ck(r==1&&strstr(err,reason),name);snprintf(name,sizeof name,"%s.released",reason);ck(!L.rows&&!L.n&&!L.has_id&&sn_released(),name);if(!(r==1&&strstr(err,reason)))fprintf(stderr,"snapshot actual rc=%d err=%s\n",r,err);rl_clear(&L);}
static int write_snapshot(const char *name,const RLBlob *b,int count,char *dir,char *err){join(dir,base,name);return rl_snapshot_write(dir,stage,input,3,b,count,err,512);}
