/* own-flow real fixture (r1): pattern of tools/chain-run.cx:853-854 at 58cb6cde55.  old is released inside
   the if, and after the if its value still selects "prev" or "none" and gates the write (an indeterminate
   pointer value read after free, C11 6.2.4p2; not a dereference) -> E2 */
#pragma unisa use mem.heap
#pragma unisa use text.text
int r1(char *p, char *prev, long cap) {
    long n = 0; int changed = 0; const char *shown;
    char *old = cx_read(p, &n);
    if (old) { if (tx_copy(prev, cap, old, n)) return 2; free(old); changed = 1; }
    shown = old ? prev : "none";
    if (!old || changed) return shown[0];
    return 0;
}
