/* own-flow fixture (i): released, allocated again into the same name, then used -> OK */
#pragma unisa use mem.heap
int fi(void) {
    int *p = mm_alloc(sizeof(int));
    if (!p) return -1;
    mm_free(p);
    p = mm_alloc(sizeof(int));
    if (!p) return -1;
    *p = 5;
    mm_free(p);
    return 0;
}
