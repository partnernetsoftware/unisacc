/* own-flow fixture (q3): returning a parameter and static storage is not a transfer -> OK */
#pragma unisa use mem.heap
static char buf[16];
char *pass(char *p) { return p; }
char *sbuf(void) { return buf; }
char *both(char *p, int k) {
    char *t = mm_alloc(4);
    if (!t) return p;
    mm_free(t);
    if (k) return (p);
    return buf;
}
