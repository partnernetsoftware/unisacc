/* own-flow product fixture P4: the release reaches L1 only through three backward gotos (L0 -> L3 -> L2 -> L1),
   so two passes over the body are not enough; the walk repeats until the labels are stable -> E2 */
void f(char *p, int x) {
    if (x == 0) goto L0;
L1: use(p); return;
L2: goto L1;
L3: goto L2;
L0: free(p); goto L3;
}
