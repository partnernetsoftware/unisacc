#define FREE(x) free(x)
#define LEN(x) tx_len(x, 8)
/* own-flow R1-fix accept controls, one per new rule; the matching reject fixture is named on each function */
/* loop exit = union of break states (reject: r1-r13, r1-r22): only a live state breaks out */
void k_loopexit(char *p, int n) { for (;;) { if (n) { free(p); return; } if (n > 3) break; n++; } use(p); }
/* label = union of predecessors (reject: r1-r06): the jump carries a reassigned p */
void k_label(char *p, int n) { free(p); p = 0; goto out; out: use(p); }
/* same-file releaser macro (reject: r1-r07): reassigned after FREE, and a non-releasing macro */
void k_macro(char *p) { LEN(p); FREE(p); p = 0; use(p); }
/* parenthesized and cast releaser argument (reject: r1-r18) */
void k_paren(char *p) { free((void *)(p)); p = 0; use(p); }
/* unbraced loop body repeated (reject: r1-r17): uses only, release after the loop */
void k_while(char *p, int n) { while (n--) use(p); free(p); }
/* case fallthrough (reject: r1-r03): the falling group reassigns before the next group uses */
void k_case(char *p, int a) { switch (a) { case 1: free(p); p = 0; case 2: use(p); break; default: break; } use(p); }
/* case group ending in break carries out (reject twin of r1-r21) */
void k_casebreak(char *p, int a) { switch (a) { case 1: free(p); break; default: break; } use(p); }
/* unbraced else from the pre-branch state (reject: r1-r14 line 4) */
void k_else(char *p, int a) { if (a) { free(p); return; } else use(p); use(p); }
