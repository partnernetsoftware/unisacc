/* own-flow product fixture P1: the two #if branches each open a brace, so the cleaned unit has unbalanced braces;
   the flow check cannot read it and must refuse by name (unit) instead of passing it silently */
int f(char *p, int x) {
#if FLOW_A
    if (x) {
#else
    if (x + 1) {
#endif
        free(p);
        return *p;
    }
    return 0;
}
