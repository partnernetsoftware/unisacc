/* own-flow product fixture P8: 65 nested loops, one more than the 64 the flow check keeps; the check must refuse
   by name instead of skipping the innermost body (and the use after it) */
void f(char *p, int x) {
    while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x)
    while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x)
    while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x)
    while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x)
    while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x)
    while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x) while (x)
    while (x) while (x) while (x) while (x) while (x)
        { free(p); use(p); }
    use(p);
}
