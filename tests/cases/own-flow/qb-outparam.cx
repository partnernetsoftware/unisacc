/* own-flow fixture (qb): writing through an output parameter and returning the parameter is not a transfer
   (fill2, fill3 OK); assigning the name itself and returning it still is (mk2 E1) */
#pragma unisa use mem.heap
char **fill2(char **out, long n) { *out = mm_alloc(n); return out; }
char **fill3(char **out, long n) { if (n) *out = mm_alloc(n); else *out = 0; return out; }
char *mk2(long n) { char *p; p = mm_alloc(n); return p; }
