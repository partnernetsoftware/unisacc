/* own-flow real fixture (r3): pattern of tools/check-lower-row-origin.cx:143 at 58cb6cde55.  m is released
   inside the if and on the next statement m selects the needle text (pointer value read after free, not a
   dereference) -> E2 */
#pragma unisa use mem.heap
int r3(const char *manifest, char *h, char *needle, long cap) {
    long n; int ok = 1;
    char *m = cx_read(manifest, &n);
    if (m) { cx_sha256_hex(m, n, h); free(m); } else ok = 0;
    if (cx_fmt(needle, cap, "watch_sha=%s", m ? h : "")) return 2;
    return ok;
}
