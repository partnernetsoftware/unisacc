/* own-flow fixture (d): released on one branch only, used after the merge (possibly freed) -> E2 */
#pragma unisa use mem.heap
int fd(int bad) {
    int *p = mm_alloc(sizeof(int));
    if (!p) return -1;
    *p = 1;
    if (bad) {
        mm_free(p);
    } else {
        *p = 2;
    }
    return *p;
}
