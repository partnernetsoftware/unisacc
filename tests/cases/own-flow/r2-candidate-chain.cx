/* own-flow real fixture (r2): pattern of tools/check-candidate-chain.cx:117-122 at 58cb6cde55.  The table
   buffer tb is released, then tb is tested again inside two ck() conditions (pointer value read after
   free, not a dereference) -> E2 */
#pragma unisa use mem.heap
int ck(int ok, const char *what);
int r2(const char *path) {
    long n = 0; int rows = 0;
    char *tb = cx_read(path, &n);
    if (tb) rows = (int)n;
    free(tb);
    ck(tb && rows >= 100, "call-plan-kinds-cover-the-real-phase-table");
    ck(tb && rows > 0, "call-plan-group-names-one-list-for-issuer-and-target-validator");
    return rows;
}
