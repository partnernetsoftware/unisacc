/* own-flow fixture (qg): the block is freed and the name reassigned to static storage before the return ->
   KNOWN-LIMIT (m16): E1 is flow insensitive, so p still counts as owned and the function is refused */
#pragma unisa use mem.heap
static char sb[4];
char *mk(long n) { char *p; p = mm_alloc(n); mm_free(p); p = sb; return p; }
