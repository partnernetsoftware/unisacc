/* own-flow fixture (j): the same pattern as (a) under the prototype escape marker; the function is
   exempt and counted as unsafe=1 (the #pragma unisa unsafe form arrives with P1) -> UNSAFE */
#pragma unisa use mem.heap
int fj(void) {
    // own-flow: unsafe
    int *p = mm_alloc(sizeof(int));
    if (!p) return -1;
    mm_free(p);
    return *p;
}
