/* tests/cases/wt-probe.cx -- negative control for the wt gate in tools/all-waves.cx.
 *
 *   sh ./unisacc.com tests/cases/wt-probe.cx [-- ROOT]
 *
 * Writes one file under ROOT/src/ (a shared path outside every batch's own out/<id> tree, and
 * outside the harness digest), then prints the marker the probe batch expects.  A wave containing
 * this probe must come back UNKNOWN with reason=worktree-changed-during-wave, because `git status`
 * before and after the wave differ on a shared path.
 *
 * This file is a fixture, not a registered batch: it is deliberately not in tests/batches.tsv, so
 * no ordinary session runs it.  Exit 0 when the file was written, 2 on usage/IO. */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.io

static char g_root[4096];
int main(int argc, char **argv) {
    char p[4400];
    const char *body = "/* wt-probe: written by tests/cases/wt-probe.cx to prove the wt gate fires */\n";
    if (argc > 3) { fputs("usage: [-- ROOT]\n", stderr); return 2; }
    if (argc == 3) { if (!realpath(argv[2], g_root)) return 2; }
    else if (argc == 2) { if (!realpath(argv[1], g_root)) return 2; }
    else if (sy_cwd(g_root, sizeof g_root) < 0) return 2;
    if (cx_fmt(p, sizeof p, "%s/src/_wt_probe.cx", g_root)) return 2;
    if (cx_write(p, body, strlen(body))) { fprintf(stderr, "wt-probe: cannot write %s errno=%d\n", p, errno); return 2; }
    printf("WT_PROBE\twrote\t%s\n", p);
    return 0;
}
