/* own-escape: EXPECT=reject1 (b) unit declares owns mk; mk2 also returns an owned block undeclared (plans/v0.0.77.md 1.3) */
#pragma unisa use mem.heap
#pragma unisa owns mk
char *mk(long n) {
    char *p = mm_alloc(n);
    return p;
}
char *mk2(long n) {
    char *q = mm_alloc(n);
    return q;
}
