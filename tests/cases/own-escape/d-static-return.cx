/* own-escape: EXPECT=accept (d) static function returns an mm_alloc block without owns; mk is declared */
#pragma unisa use mem.heap
#pragma unisa owns mk
static char *inner(long n) {
    char *p = mm_alloc(n);
    return p;
}
char *mk(long n) {
    char *q = mm_alloc(n);
    return q;
}
int touch(long n) {
    char *r = inner(n);
    mm_free(r);
    return 0;
}
