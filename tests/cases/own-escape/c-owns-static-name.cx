/* own-escape: EXPECT=reject2 (c) owns names a static function, no non-static function of that name */
#pragma unisa use mem.heap
#pragma unisa owns hid
static char *hid(long n) {
    char *p = mm_alloc(n);
    return p;
}
char *use_hid(long n) {
    char *p = hid(n);
    mm_free(p);
    return 0;
}
