/* own-escape: EXPECT=accept (e) returning a borrowed parameter and return done(q, 2) are not escapes */
#pragma unisa use mem.heap
#pragma unisa owns mk
static int done(char *q, int code) {
    mm_free(q);
    return code;
}
char *mk(long n) {
    char *p = mm_alloc(n);
    return p;
}
char *pass(char *b) {
    return b;
}
int work(long n) {
    char *q = mm_alloc(n);
    return done(q, 2);
}
