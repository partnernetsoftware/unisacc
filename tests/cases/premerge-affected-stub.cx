/* Stand-in for tools/affected.cx in the premerge-selfcheck item 12 fixtures (tools/check-premerge-selfcheck.cx --flip).
 * --files ... --list-only: a fixed selection of three batches (two real, one tools-compile that the item must skip).
 * --ids A,B --run: BATCH_RUN rows whose status is read from tests/state.txt (lines `id=1` for a passing batch, `id=0` for a failing one) of the tree it runs in,
 * so a patch that edits tests/state.txt flips a batch exactly in the patched tree. */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use text.text
#pragma unisa use mem.heap

int main(int argc, char **argv) {
    int i, list = 0;
    const char *ids = 0;
    size_t n = 0;
    char *s;
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--list-only")) list = 1;
        else if (!strcmp(argv[i], "--ids") && i + 1 < argc) ids = argv[++i];
    }
    if (list) {
        printf("AFFECTED\tb-good\twhy=x\tvia=source\n");
        printf("AFFECTED\tb-refuse-neg\twhy=x\tvia=literal\n");
        printf("AFFECTED\ttools-compile-000\twhy=x\tvia=use\n");
        printf("AFFECTED_SUMMARY\tchanged=1\tbatches=3\tscanned=3\n");
        return 0;
    }
    s = (char *)cx_read("tests/state.txt", &n);
    if (!s) return 2;
    while (ids && *ids) {
        char id[64];
        int il = 0;
        const char *p;
        while (*ids && *ids != ',' && il < 63) id[il++] = *ids++;
        id[il] = 0;
        if (*ids == ',') ids++;
        for (p = s; p && *p; ) {
            if (!strncmp(p, id, (size_t)il) && p[il] == '=') {
                const char *v = p + il + 1;
                int vl = 0;
                while (v[vl] && v[vl] != '\n') vl++;
                printf("BATCH_RUN\tid=%s\tstatus=%s\trc=0\n", id, vl == 1 && v[0] == '1' ? "PASS" : "FAIL");
                break;
            }
            p = strchr(p, '\n');
            if (p) p++;
        }
    }
    return 0;
}
