/* C99 library/ABI fixtures, not an imported host-library provider.
 * Values are observed here; the driver owns the independent expected values.
 * Raw pointers are used with normal C lifetimes, not checked ownership. */
#pragma unisa module library_abi

typedef struct { long long first; long long second; } library_abi_pair;
typedef struct { unsigned char tag; int count; double ratio; short tail; } LibraryLayout;
static int comparator_calls;

static int ascending(const void *a,const void *b){
 int x=*(const int *)a,y=*(const int *)b;
 comparator_calls++;
 return (x>y)-(x<y);
}
static long byte_sum(const unsigned char *p,int n){long v=0;int i;for(i=0;i<n;i++)v+=p[i];return v;}

int library_abi_count(void){return 48;}

/* Eight distinct scalar arguments force argument slots beyond the first few.
 * The public call crosses a real .cx module boundary. */
long long library_abi_pressure(long long a,long long b,long long c,long long d,
                             long long e,long long f,long long g,long long h){
 return a+2*b+3*c+4*d+5*e+6*f+7*g+8*h;
}
double library_abi_mixed(int a,double b,long long c,double d,
                         int e,double f,long long g,double h){
 return a+2*b+3*c+4*d+5*e+6*f+7*g+8*h;
}
library_abi_pair library_abi_pair_adjust(library_abi_pair p,long long delta){
 library_abi_pair result;
 result.first=p.second+delta;result.second=p.first-delta;
 return result;
}
long long library_abi_variadic(int tag,...){
 va_list ap;int a;double b;long long c;
 va_start(ap,tag);a=va_arg(ap,int);b=va_arg(ap,double);c=va_arg(ap,long long);va_end(ap);
 return tag+a+(long long)(b*4)+c;
}
long library_abi_va_copy(int tag,...){
 va_list a,b;int x,y,z,w;
 va_start(a,tag);va_copy(b,a);
 x=va_arg(a,int);y=va_arg(a,int);z=va_arg(b,int);w=va_arg(b,int);
 va_end(b);va_end(a);
 return x+y+10*z+w;
}

void library_abi_values(long *v){
 LibraryLayout layout[2];int values[6]={9,-4,3,12,0,3};
 int i,key,*found,n;char guard[8],format[40],*tail;
 const unsigned char binary[5]={65,0,66,255,67};
 const unsigned char high[1]={128},low[1]={127};
 const char *nodigits="  +oops";
 unsigned char *p,*grown,*shrunk,*failed,*fresh;const unsigned char *at;
 unsigned long converted;long parsed;double decimal;
 char moved[7]="abcdef";

 /* SysV LP64 layout: char@0, int@4, double@8, short@16, total24.
  * No padding-byte contents or inactive union member are inspected. */
 v[0]=sizeof(LibraryLayout);v[1]=offsetof(LibraryLayout,count);
 v[2]=offsetof(LibraryLayout,ratio);v[3]=offsetof(LibraryLayout,tail);
 v[4]=(char *)&layout[1]-(char *)&layout[0];

 comparator_calls=0;qsort(values,6,sizeof(int),ascending);
 for(i=0;i<6;i++)v[5+i]=values[i];
 v[11]=comparator_calls>0;
 key=9;found=bsearch(&key,values,6,sizeof(int),ascending);v[12]=found?*found:-1;
 key=8;v[13]=bsearch(&key,values,6,sizeof(int),ascending)==NULL;
 v[14]=bsearch(&key,values,0,sizeof(int),ascending)==NULL;

 memset(guard,122,sizeof guard);
 v[15]=snprintf(guard+1,4,"%s","abcdef");
 v[16]=memcmp(guard+1,"abc\0",4)==0;
 v[17]=guard[0]==122&&guard[5]==122&&guard[7]==122;
 v[18]=snprintf(NULL,0,"%s:%d","xy",17);
 n=snprintf(format,sizeof format,"%*.*s|%lld",5,3,"abcdef",-4294967297LL);
 v[19]=n;v[20]=strcmp(format,"  abc|-4294967297")==0;

 at=memchr(binary,0,5);v[21]=at?at-binary:-1;
 at=memchr(binary,255,5);v[22]=at?at-binary:-1;
 v[23]=memchr(binary,68,5)==NULL;
 n=memcmp(high,low,1);v[24]=(n>0)-(n<0);

 parsed=strtol(" \t-0x2a!",&tail,0);v[25]=parsed;v[26]=(unsigned char)*tail;
 parsed=strtol(nodigits,&tail,10);v[27]=parsed;v[28]=tail==nodigits;
 errno=0;converted=strtoul("18446744073709551616!",&tail,10);
 v[29]=converted==ULONG_MAX;v[30]=errno;v[31]=(unsigned char)*tail;
 decimal=strtod("  -12.5tail",&tail);v[32]=(long)(decimal*2);v[33]=(unsigned char)*tail;

 /* Each dependent observation stays at the driver's NOT_RUN sentinel when
  * allocation preparation fails. Realloc failure must preserve the live block.
  * No pointer identity, zero-size allocation or freed contents are assumed. */
 p=calloc(5,3);v[34]=p!=NULL;if(!p)return;
 v[35]=byte_sum(p,15)==0;
 for(i=0;i<15;i++)p[i]=(unsigned char)(i+1);
 grown=realloc(p,64);v[36]=grown!=NULL;if(!grown){free(p);return;}
 v[37]=byte_sum(grown,15);
 shrunk=realloc(grown,7);v[38]=shrunk!=NULL;if(!shrunk){free(grown);return;}
 v[39]=byte_sum(shrunk,7);
 failed=realloc(shrunk,(size_t)-1);v[40]=failed==NULL;
 if(failed){free(failed);return;}
 v[41]=byte_sum(shrunk,7);free(shrunk);
 fresh=realloc(NULL,9);v[42]=fresh!=NULL;if(fresh)free(fresh);
 p=calloc((size_t)-1,2);v[43]=p==NULL;if(p)free(p);
 free(NULL);v[44]=1;
 memmove(moved,moved+1,5);v[45]=strcmp(moved,"bcdeff")==0;
 n=strcmp("abc","abd");v[46]=(n>0)-(n<0);
 n=strcmp("abd","abc");v[47]=(n>0)-(n<0);
}
