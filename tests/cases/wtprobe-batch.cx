/* wtprobe-batch -- the negative control for the wt gate in tools/all-waves.cx.
 *
 *   sh ./unisacc.com tests/cases/wtprobe-batch.cx
 *
 * Writes one file under ROOT/src/ (a shared path outside every batch's own out/<id> tree and
 * outside the harness digest), then prints WTPROBE.  A wave containing it must come back UNKNOWN
 * with reason=worktree-changed-during-wave.  It is a fixture: not in tests/batches.tsv, so no
 * ordinary session runs it; tests/check-wt-gate.cx adds it for one wave and removes the file. */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.io
int main(void) {
    char *v[] = {"sh", "./unisacc.com", "tests/cases/wt-probe.cx", 0};
    np_result r = {0}; char why[512] = {0};
    if (np_run(v, 0, 0, 20, &r, why, sizeof why)) { fprintf(stderr, "wtprobe: %s\n", why); return 2; }
    if (r.errn) fwrite(r.err, 1, r.errn, stderr);
    printf("WTPROBE\t%s", r.out && r.outn ? r.out : "no-output\n");
    np_free(&r);
    return r.rc ? 1 : 0;
}
