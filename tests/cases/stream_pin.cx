#pragma unisa module stream_pin
/* The override is an explicit input fixed by the caller/session. Returned
 * strings borrow argv or the historical constant for this process lifetime. */
const char *stream_expected_pin(const char *override,const char *historical,const char *stage){
 if(!override)return historical;
 if(strlen(override)!=64){fprintf(stderr,"stream-pin: expected-pin-shape stage=%s\n",stage);exit(2);}
 for(int i=0;i<64;i++)if(!((override[i]>='0'&&override[i]<='9')||(override[i]>='a'&&override[i]<='f'))){fprintf(stderr,"stream-pin: expected-pin-shape stage=%s\n",stage);exit(2);}
 printf("MATERIAL\tmode=explicit-regression-pin\tstream=%s\tsha256=%s\n",stage,override);return override;
}
/* streams-material 的壳材料(scope=product-stream-shim)没有固定历史 sha:此时钉子取自材料自己的 streams.json,
 * 并由调用方回报 MATERIAL mode=receipt-override。返回 1 = 已覆写(out 为 64 位小写十六进制),0 = 无此收据字段。
 * unit 为 NULL 取顶层字段,否则取该 stream_unit 记录内的字段。 */
int stream_receipt_pin(const char *json,const char *unit,const char *key,char out[65]){
 char needle[96];const char *a=json,*end=0;int n;
 if(!json||!strstr(json,"\"scope\":\"product-stream-shim\""))return 0;
 if(unit){n=snprintf(needle,sizeof needle,"\"stream_unit\":\"%s\"",unit);if(n<0||(size_t)n>=sizeof needle)return 0;a=strstr(json,needle);if(!a)return 0;end=strchr(a,'}');if(!end)return 0;}
 n=snprintf(needle,sizeof needle,"\"%s\":\"",key);if(n<0||(size_t)n>=sizeof needle)return 0;
 a=strstr(a,needle);if(!a||(end&&a>end))return 0;a+=n;
 for(int i=0;i<64;i++){char c=a[i];if(!((c>='0'&&c<='9')||(c>='a'&&c<='f')))return 0;out[i]=c;}
 if(a[64]!='"')return 0;out[64]=0;return 1;}
