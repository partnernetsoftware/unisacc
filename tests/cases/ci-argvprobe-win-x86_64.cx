/* ci-argvprobe-win-x86_64.cx -- what the win PE startup hands to main.
 *
 *   ci-argvprobe-win-x86_64.exe A B
 *
 * Prints argc, the argv array address, and argv[0..2] as pointer plus string.  The CI
 * symptom this pins down is `argv[1] == NULL` and a 0xC0000005 on the first dereference
 * in `direct.exe`; which of the three shapes it is decides the fix:
 *   argv[1] == 0 while argv[0] is fine  -> only the first slot was written
 *   argv array address 0 / crash on use -> the write landed on an uncommitted page
 *   argc == 0                           -> winargs never ran, or ran after main
 * Built by the product itself (-b win/x86_64), the same way ci-argv-win-x86_64.exe is.
 * No #include: printf comes with the implicit prelude. */
#pragma unisa use sys.io

int main(int argc, char **argv) {
    int i;
    printf("argc=%d\n", argc);
    printf("argv_array=%p\n", (void *)argv);
    for (i = 0; i < 3; i++) {
        printf("argv[%d]=%p", i, (void *)(i < argc ? argv[i] : 0));
        if (i < argc && argv[i]) printf(" \"%s\"", argv[i]);
        printf("\n");
    }
    return 0;
}
