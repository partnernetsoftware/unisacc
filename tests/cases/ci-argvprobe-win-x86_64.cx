#include <stdio.h>
/* winargvprobe: what does the win PE startup actually hand to main?
 *   winargvprobe A B
 * Prints argc, the argv array address, and for argv[0..2] the pointer and the string.
 * A wrong or missing argv shows up as a pointer of 0 / (null) / a crash on the first
 * dereference, which is exactly the CI symptom (argv[1] == NULL, direct.exe 0xC0000005). */
int main(int argc, char **argv) {
    int i;
    printf("argc=%d\n", argc);
    printf("argv_array=%p\n", (void *)argv);
    for (i = 0; i < 3; i++) {
        printf("argv[%d]=%p", i, (void *)(i < argc ? argv[i] : 0));
        if (i < argc && argv[i]) printf(" \"%s\"", argv[i]);
        printf("\n");
    }
    return 0;
}
