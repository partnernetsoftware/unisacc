/* Header-free witness for tools/ri-material.cx, not a replacement executor.
 * CLI: MODE ABS_NEW_DIR; one fresh private directory and one group per process.
 * Positive groups: precedence, blob-cache, snapshot-map, strict-map.
 * Fatal gold: strict-missing -> rc2, empty stdout, stderr contains exactly the
 * missing-key reason MISSING_EXPLICIT_RESOURCE 6d697373696e67 (key "missing").
 * null0 retains the memcpy pointer hook: rc86 rejects an invalid zero copy.
 * Success also requires owned empty slots, growth, nonempty copies and cleanup.
 *
 * PK below is independently assembled synthetic lookup storage. No P3 package
 * loading, full model route, capture/session errors, foreign-host qualification
 * or general memory-safety claim is made by this fixture. All ordinary empty
 * spans have a nonNULL source; NULL,0 is exercised separately in null0.
 */
static int ric_watch_null0;
static void *ric_checked_memcpy(void *dst,const void *src,size_t n){
 if(ric_watch_null0&&n==0&&(!dst||!src)){
  fputs("INVALID_COPY core_badd-null0 memcpy(NULL,0)\n",stderr);exit(86);
 }
 return memcpy(dst,src,n);
}
#define memcpy ric_checked_memcpy
/* RUNTIME_BODY */
#undef memcpy

static int ric_assertions,ric_failures;
static char ric_base[4096];
static const char *ric_stage="lower:lnx/x86_64/run/O0";
static const unsigned char ric_input[]={'a','b','c'},ric_empty[1]={0};
static const unsigned char ric_R[]={'R',0,129},ric_P[]={'P',0,254},ric_D[]={'D',0,255};
static const unsigned char ric_S[]={'S',0,128},ric_L[]={'L',0,253};
static unsigned char ric_PK[1024];static Resource ric_resources[16];static int ric_used;

static void ric_fail(const char *why){fprintf(stderr,"ri-consumers: SETUP_ERROR %s errno=%d\n",why,errno);exit(90);}
static void ric_ck(int ok,const char *name){ric_assertions++;if(!ok)ric_failures++;printf("%s\tri-consumers.%s\n",ok?"PASS":"FAIL",name);}
static void ric_join(char *p,const char *a,const char *b){int n=snprintf(p,4096,"%s/%s",a,b);if(n<0||n>=4096)ric_fail("path bound");}
static void ric_store(const char *path,const unsigned char *bytes,size_t n,int exclusive){
 int fd=open(path,O_WRONLY|O_CLOEXEC|O_NOFOLLOW|(exclusive?O_CREAT|O_EXCL:O_TRUNC),0600);
 if(fd<0)ric_fail("private file open");size_t at=0;
 while(at<n){ssize_t z=write(fd,bytes+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);ric_fail("private file write");}at+=(size_t)z;}
 if(close(fd))ric_fail("private file close");
}
static unsigned char *ric_load(const char *path,size_t *n){
 struct stat st;if(lstat(path,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>1048576)ric_fail("private regular file");
 int fd=open(path,O_RDONLY|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK);if(fd<0)ric_fail("private read open");
 *n=(size_t)st.st_size;unsigned char *p=malloc(*n+1);if(!p){close(fd);ric_fail("private read allocation");}
 size_t at=0;while(at<*n){ssize_t z=read(fd,p+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){free(p);close(fd);ric_fail("private read extent");}at+=(size_t)z;}
 unsigned char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);
 int closed=close(fd);if(z||closed){free(p);ric_fail("private read end");}p[*n]=0;return p;
}
static void ric_reset(void){
 RF_STRICT=0;RF_LOADED=0;rl_clear(&RF_LEDGER);RI_SNAP_ON=0;rl_clear(&RI_SNAP);
 RI=0;NRI=0;RES=ric_resources;NR=0;PB=ric_PK;PN=2;ric_used=2;ric_PK[0]='P';ric_PK[1]='K';INCDIR=0;
 rf_capture_set=0;if(setenv("UNISACC_RF_CAPTURE","",1))ric_fail("disable ambient capture");
}
static void ric_pk(const unsigned char *key,int kn,const unsigned char *value,int vn){
 if(kn<1||vn<0||NR>=16||ric_used+kn+(vn?vn:1)>(int)sizeof ric_PK)ric_fail("synthetic PK bounds");
 Resource *r=&ric_resources[NR++];r->name=ric_used;r->n=kn;memcpy(ric_PK+ric_used,key,(size_t)kn);ric_used+=kn;
 r->data=ric_used;r->len=vn;if(vn)memcpy(ric_PK+ric_used,value,(size_t)vn);else ric_PK[ric_used]=0;ric_used+=vn?vn:1;PN=ric_used;
}
static void ric_disk(const char *name,const unsigned char *value,size_t n){char p[4096];ric_join(p,ric_base,name);ric_store(p,value,n,1);}
static void ric_fetch(const unsigned char *key,int kn,int wanted_owned,const unsigned char *wanted,int wn,const char *label){
 unsigned char sentinel[1]={42},*value=sentinel;int n=-77;
 int owned=core_host_fetch(key,kn,&value,&n);
 int ok=owned==wanted_owned&&n==wn;
 if(wanted_owned)ok=ok&&value&&(wn==0||!memcmp(value,wanted,(size_t)wn));else ok=ok&&!value&&n==0;
 ric_ck(ok,label);if(owned==2)free(value);
}
static int ric_blob_is(const CoreBlobs *b,int id,const unsigned char *wanted,int n){
 return id>0&&id<b->n&&b->entries[id].n==n&&b->entries[id].b&&(n==0||!memcmp(b->entries[id].b,wanted,(size_t)n));
}
static void ric_core_clear(CoreResources *r,CoreBlobs *b){
 int i;for(i=0;i<r->n;i++)free(r->entries[i].p);free(r->entries);memset(r,0,sizeof *r);
 for(i=0;i<b->n;i++)free(b->entries[i].b);free(b->entries);memset(b,0,sizeof *b);
}
static void ric_precedence(void){
 static const unsigned char shared[]="shared.bin",pkempty[]="pk-empty";
 ResourceInput rows[1]={{shared,10,ric_R,3}};RI=rows;NRI=1;ric_pk(shared,10,ric_P,3);ric_disk("shared.bin",ric_D,3);
 ric_fetch(shared,10,1,ric_R,3,"precedence.RI-over-RES-and-disk");NRI=0;
 ric_fetch(shared,10,1,ric_P,3,"precedence.RES-over-disk");NR=0;
 ric_fetch(shared,10,2,ric_D,3,"precedence.disk-owned-by-caller");
 ric_fetch((const unsigned char *)"nowhere",7,0,ric_empty,0,"precedence.missing-clears-output");
 ric_pk(pkempty,8,ric_empty,0);ric_disk("pk-empty",ric_D,3);
 ric_fetch(pkempty,8,1,ric_empty,0,"precedence.RES-empty-shadows-disk-nonempty");
 ric_disk("disk-empty",ric_empty,0);ric_fetch((const unsigned char *)"disk-empty",10,2,ric_empty,0,"precedence.disk-empty-still-present");
 RI=0;NRI=0;RES=0;NR=0;PB=0;PN=0;
}
static void ric_blob_cache(void){
 static const unsigned char a[]={'k',0,255,'x'},b[]={'k',0,254,'x'},e[]={'e',0,'k'},missing[]={'n',0,'?'};
 static const unsigned char av[]={'A',0,255,'Z'},bv[]={'B',0,254};
 ResourceInput rows[2]={{a,4,av,4},{e,3,ric_empty,0}};RI=rows;NRI=2;ric_pk(b,4,bv,3);
 CoreResources cache={0};CoreBlobs blobs={0};int zero=core_badd(&blobs,ric_empty,0);
 ric_ck(zero==0&&blobs.n==1&&blobs.entries&&blobs.entries[0].b&&blobs.entries[0].n==0,"blob.zero-is-reserved-owned-slot");
 unsigned char query[4];memcpy(query,a,4);int first=core_rfind(&cache,&blobs,query,4);
 ric_ck(ric_blob_is(&blobs,first,av,4),"blob.RI-opaque-binary-key-and-value");
 ric_ck(cache.n==1&&cache.entries&&cache.entries[0].p!=query&&!memcmp(cache.entries[0].p,a,4),"cache.owns-query-key-copy");
 ric_ck(first>0&&first<blobs.n&&blobs.entries[first].b!=av,"blob.owns-borrowed-RI-value-copy");
 query[0]='x';int count=blobs.n,entries=cache.n,again=core_rfind(&cache,&blobs,a,4);
 ric_ck(again==first&&blobs.n==count&&cache.n==entries,"cache.repeated-present-keeps-id-and-slots");
 int second=core_rfind(&cache,&blobs,b,4);
 ric_ck(second!=first&&ric_blob_is(&blobs,second,bv,3),"blob.RES-distinguishes-bytes-after-NUL");
 count=blobs.n;int prefix=core_rfind(&cache,&blobs,a,3);
 ric_ck(prefix==0&&blobs.n==count,"cache.key-length-is-significant");
 int absent=core_rfind(&cache,&blobs,missing,3);entries=cache.n;count=blobs.n;
 ric_ck(absent==0,"blob.absent-is-zero");again=core_rfind(&cache,&blobs,missing,3);
 ric_ck(again==0&&cache.n==entries&&blobs.n==count,"cache.repeated-absent-keeps-cache-and-blob-count");
 int empty_id=core_rfind(&cache,&blobs,e,3);count=blobs.n;entries=cache.n;
 ric_ck(empty_id!=0&&ric_blob_is(&blobs,empty_id,ric_empty,0),"blob.present-empty-is-positive-owned-slot");
 again=core_rfind(&cache,&blobs,e,3);
 ric_ck(again==empty_id&&cache.n==entries&&blobs.n==count,"cache.repeated-empty-keeps-positive-id");
 ric_core_clear(&cache,&blobs);ric_ck(!cache.entries&&!cache.n&&!blobs.entries&&!blobs.n,"cache.explicit-owned-storage-clear");RI=0;NRI=0;
}
/* Re-sign exactly the private resources.tsv entry, retaining all other
 * COMMIT bytes and all other files. The production writer is untouched. */
static void ric_resign_table(const char *dir){
 char table[4096],commit[4096],hash[65];size_t n,cn;ric_join(table,dir,"resources.tsv");unsigned char *s=ric_load(table,&n);
 unisa_sha256_hex(s,n,hash);free(s);
 ric_join(commit,dir,"COMMIT");s=ric_load(commit,&cn);size_t at=0;int changed=0;
 while(at<cn){size_t end=at;while(end<cn&&s[end]!='\n')end++;if(end==cn){free(s);ric_fail("COMMIT row extent");}
  if(end-at==66+strlen("resources.tsv")&&s[at+64]==' '&&s[at+65]==' '&&!memcmp(s+at+66,"resources.tsv",strlen("resources.tsv"))){memcpy(s+at,hash,64);changed++;}at=end+1;
 }
 if(changed!=1){free(s);ric_fail("one table COMMIT hash");}ric_store(commit,s,cn,0);free(s);
}
/* ABSENT has no blob and remains a real map row. */
static void ric_append_absent(const char *dir){
 char table[4096];size_t n;ric_join(table,dir,"resources.tsv");unsigned char *s=ric_load(table,&n);
 const char *row="626c6f636b6564\t0\t-\t0\t-\n";size_t rn=strlen(row);unsigned char *next=malloc(n+rn);if(!next){free(s);ric_fail("absent row allocation");}
 memcpy(next,s,n);memcpy(next+n,row,rn);ric_store(table,next,n+rn,0);free(next);free(s);ric_resign_table(dir);
}
static void ric_snapshot_map(void){
 static const unsigned char hit[]="hit",zero[]="zero",blocked[]="blocked",binary[]={'s',0,254},sv[]={1,0,255};
 ResourceInput rows[5]={{hit,3,ric_R,3},{zero,4,ric_R,3},{blocked,7,ric_R,3},{(const unsigned char *)"ri-fallback",11,ric_R,3},{binary,3,ric_R,3}};
 RI=rows;NRI=5;ric_pk(hit,3,ric_P,3);ric_pk(zero,4,ric_P,3);ric_pk(blocked,7,ric_P,3);ric_pk((const unsigned char *)"pk-fallback",11,ric_P,3);ric_pk(binary,3,ric_P,3);
 ric_disk("hit",ric_D,3);ric_disk("zero",ric_D,3);ric_disk("blocked",ric_D,3);ric_disk("disk-fallback",ric_D,3);
 RLBlob blobs[3]={{hit,3,ric_S,3},{zero,4,ric_empty,0},{binary,3,sv,3}};char dir[4096],err[512];ric_join(dir,ric_base,"snapshot");
 if(rl_snapshot_write(dir,ric_stage,ric_input,3,blobs,3,err,sizeof err)){fprintf(stderr,"snapshot setup: %s\n",err);ric_fail("snapshot write");}
 ric_append_absent(dir);if(rf_snapshot_load_ri(dir,ric_stage,&RI_SNAP,0,err,sizeof err)){fprintf(stderr,"snapshot setup: %s\n",err);ric_fail("snapshot map load");}
 const RLRow *row=rl_find(&RI_SNAP,blocked,7);
 ric_ck(RI_SNAP.n==4&&row&&!row->present&&!row->value&&!row->vn,"snapshot.valid-resigned-ABSENT-row-retained");
 ric_ck(!rl_find(&RI_SNAP,(const unsigned char *)"ri-fallback",11),"snapshot.MISSING-is-not-ABSENT-row");
 RI_SNAP_ON=1;ric_fetch(hit,3,1,ric_S,3,"snapshot.PRESENT-shadows-all-lower-providers");
 ric_fetch(zero,4,1,ric_empty,0,"snapshot.EMPTY-shadows-nonempty-lower-providers");
 ric_fetch(binary,3,1,sv,3,"snapshot.opaque-binary-key-and-value");
 int nri=NRI,nr=NR;RI_SNAP_ON=0;ric_fetch(blocked,7,1,ric_R,3,"snapshot.absent-control-RI-exists");RI_SNAP_ON=1;
 ric_fetch(blocked,7,0,ric_empty,0,"snapshot.ABSENT-masks-RI");NRI=0;RI_SNAP_ON=0;
 ric_fetch(blocked,7,1,ric_P,3,"snapshot.absent-control-RES-exists");RI_SNAP_ON=1;ric_fetch(blocked,7,0,ric_empty,0,"snapshot.ABSENT-masks-RES");NR=0;RI_SNAP_ON=0;
 ric_fetch(blocked,7,2,ric_D,3,"snapshot.absent-control-disk-exists");RI_SNAP_ON=1;ric_fetch(blocked,7,0,ric_empty,0,"snapshot.ABSENT-masks-disk");NRI=nri;NR=nr;
 ric_fetch((const unsigned char *)"ri-fallback",11,1,ric_R,3,"snapshot.MISSING-falls-back-to-RI");
 ric_fetch((const unsigned char *)"pk-fallback",11,1,ric_P,3,"snapshot.MISSING-falls-back-to-RES");
 ric_fetch((const unsigned char *)"disk-fallback",13,2,ric_D,3,"snapshot.MISSING-falls-back-to-disk");
 CoreResources cache={0};CoreBlobs b={0};core_badd(&b,ric_empty,0);int empty_id=core_rfind(&cache,&b,zero,4),absent_id=core_rfind(&cache,&b,blocked,7);
 ric_ck(empty_id>0&&ric_blob_is(&b,empty_id,ric_empty,0)&&absent_id==0,"snapshot.core-consumer-empty-versus-absent-id");
 ric_core_clear(&cache,&b);RI_SNAP_ON=0;rl_clear(&RI_SNAP);ric_ck(!RI_SNAP.rows&&!RI_SNAP.n&&!RI_SNAP.has_id,"snapshot.loaded-map-explicitly-cleared");
 /* Only one table byte changes SC1 to SC2; identity, rows and blobs remain
  * intact, and the actual table hash is re-signed so COMMIT cannot mask the
  * intended trace-versus-map refusal. */
 char table[4096];size_t tn;ric_join(table,dir,"resources.tsv");unsigned char *ts=ric_load(table,&tn);
 if(tn<5||memcmp(ts,"#SC1\t",5)){free(ts);ric_fail("snapshot SC1 header for trace control");}
 ts[3]='2';ric_store(table,ts,tn,0);free(ts);ric_resign_table(dir);
 RLLedger rejected={0};err[0]=0;int rc=rf_snapshot_load_ri(dir,ric_stage,&rejected,0,err,sizeof err);
 int refused=rc==1&&!strcmp(err,"INTERFACE_ERROR snapshot-trace-ledger-not-map")&&!rejected.rows&&!rejected.n&&!rejected.has_id&&!rejected.trace&&!rejected.cursor&&!rejected.stage[0]&&!rejected.input_hex[0];
 rl_clear(&rejected);ric_ck(refused&&!rejected.rows&&!rejected.n&&!rejected.has_id&&!rejected.trace&&!rejected.cursor&&!rejected.stage[0]&&!rejected.input_hex[0],"snapshot.resigned-SC2-refused-as-map-and-empty-clearable");RI=0;NRI=0;
}
static void ric_strict_setup(void){
 static const unsigned char hit[]="hit",zero[]="zero",blocked[]="blocked",missing[]="missing";
 static ResourceInput rows[4];rows[0]=(ResourceInput){hit,3,ric_R,3};rows[1]=(ResourceInput){zero,4,ric_R,3};rows[2]=(ResourceInput){blocked,7,ric_R,3};rows[3]=(ResourceInput){missing,7,ric_R,3};RI=rows;NRI=4;
 ric_pk(hit,3,ric_P,3);ric_pk(zero,4,ric_P,3);ric_pk(blocked,7,ric_P,3);ric_pk(missing,7,ric_P,3);ric_disk("hit",ric_D,3);ric_disk("zero",ric_D,3);ric_disk("blocked",ric_D,3);ric_disk("missing",ric_D,3);
 char dir[4096],p[4096],sha[65],table[1024],err[512];ric_join(dir,ric_base,"ledger");if(mkdir(dir,0700))ric_fail("strict ledger directory");
 ric_join(p,dir,"value.bytes");ric_store(p,ric_L,3,1);unisa_sha256_hex(ric_L,3,sha);ric_join(p,dir,"empty.bytes");ric_store(p,ric_empty,0,1);
 int n=snprintf(table,sizeof table,"#SC1\tstage=lower:lnx/x86_64/tape/O0\tinput_sha256=ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\n686974\t1\tvalue.bytes\t3\t%s\n7a65726f\t1\tempty.bytes\t0\te3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\n626c6f636b6564\t0\t-\t0\t-\n",sha);
 if(n<0||(size_t)n>=sizeof table)ric_fail("strict table size");ric_join(p,dir,"resources.tsv");ric_store(p,(const unsigned char *)table,(size_t)n,1);
 if(rl_load(dir,&RF_LEDGER,err,sizeof err)){fprintf(stderr,"strict setup: %s\n",err);ric_fail("strict ledger load");}RF_LOADED=1;RF_STRICT=1;
 if(rf_identity_gate(ric_input,3,2,"lnx/x86_64/tape/O0","lower"))ric_fail("strict identity gate");
}
static void ric_strict_map(void){
 ric_strict_setup();ric_fetch((const unsigned char *)"hit",3,1,ric_L,3,"strict.SC1-PRESENT-is-only-source");
 ric_fetch((const unsigned char *)"zero",4,1,ric_empty,0,"strict.SC1-EMPTY-masks-lower-nonempty");
 ric_fetch((const unsigned char *)"blocked",7,0,ric_empty,0,"strict.SC1-ABSENT-masks-lower-present");
 ric_ck(!rl_find(&RF_LEDGER,(const unsigned char *)"missing",7),"strict.missing-key-really-unlisted");
 RF_STRICT=0;RF_LOADED=0;rl_clear(&RF_LEDGER);ric_ck(!RF_LEDGER.rows&&!RF_LEDGER.n&&!RF_LEDGER.has_id,"strict.owned-ledger-cleared");RI=0;NRI=0;
}
int main(int argc,char **argv){
 if(argc!=3||argv[2][0]!='/'||strlen(argv[2])>=sizeof ric_base)return 90;const char *mode=argv[1];
 if(strcmp(mode,"precedence")&&strcmp(mode,"blob-cache")&&strcmp(mode,"snapshot-map")&&strcmp(mode,"strict-map")&&strcmp(mode,"strict-missing")&&strcmp(mode,"null0"))return 90;
 if(mkdir(argv[2],0700)||!realpath(argv[2],ric_base)||chdir(ric_base))ric_fail("fresh private directory");ric_reset();
 if(!strcmp(mode,"strict-missing")){
  ric_strict_setup();unsigned char *value=0;int n=0;int rc=core_host_fetch((const unsigned char *)"missing",7,&value,&n);
  fprintf(stderr,"FAIL strict-missing unexpectedly returned rc=%d length=%d\n",rc,n);if(rc==2)free(value);return 1;
 }
 if(!strcmp(mode,"null0")){
  CoreBlobs b={0};if(core_badd(&b,ric_empty,0)!=0)ric_fail("reserved-zero setup");ric_watch_null0=1;int id=core_badd(&b,0,0);ric_watch_null0=0;
  ric_ck(id==1&&b.n==2,"null0.empty-still-occupies-positive-slot");
  ric_ck(b.entries[0].b&&b.entries[1].b&&b.entries[0].b!=b.entries[1].b&&!b.entries[1].n,"null0.empty-keeps-separate-owned-allocation");
  static const unsigned char value[]={1,0,255,7};int full=core_badd(&b,value,4);
  ric_ck(full==2&&ric_blob_is(&b,full,value,4)&&b.entries[full].b!=value,"null0.nonempty-copy-unchanged");
  while(b.n<64)core_badd(&b,ric_empty,0);int capacity=b.cap;ric_watch_null0=1;id=core_badd(&b,0,0);ric_watch_null0=0;
  int intact=id==64&&b.n==65&&capacity==64&&b.cap==128&&ric_blob_is(&b,full,value,4);for(int i=0;i<b.n;i++)if(!b.entries[i].b||(i!=full&&b.entries[i].n))intact=0;
  ric_ck(intact,"null0.grows-before-slot-write-and-preserves-values");CoreResources r={0};ric_core_clear(&r,&b);ric_ck(!b.entries&&!b.n&&!b.cap,"null0.all-owned-slots-cleared");
  printf("RI_NULL0\tassertions=%d\tfailed=%d\n",ric_assertions,ric_failures);return ric_failures?1:0;
 }
 if(!strcmp(mode,"precedence"))ric_precedence();else if(!strcmp(mode,"blob-cache"))ric_blob_cache();else if(!strcmp(mode,"snapshot-map"))ric_snapshot_map();else ric_strict_map();
 RI=0;NRI=0;RES=0;NR=0;PB=0;PN=0;RI_SNAP_ON=0;RF_STRICT=0;RF_LOADED=0;rl_clear(&RI_SNAP);rl_clear(&RF_LEDGER);
 puts("NOT_CLAIMED\tP3-loading-full-model-route-capture-errors-foreign-hosts-or-general-memory-safety");
 puts("TIMING\tstartup_loading_lookup_output_validation_cold_hot=UNMEASURED");
 printf("RI_CONSUMERS\tmode=%s\tassertions=%d\tfailed=%d\tscope=actual-C-consumer-lookup-and-SC1-snapshot-map\n",mode,ric_assertions,ric_failures);return ric_failures?1:0;
}
