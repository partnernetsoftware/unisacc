/* E1 must keep spelling/offsets; E3 must consume prefixes as character syntax.
   L is C99; u/U/u8 are the product's existing extensions. */
enum { PREFIX_ENUM = L'A' };
static int prefix_value = L'\101';
int main(void) {
    int failed = 0;
    if ('x' != 120 || L'x' != 120 || u'x' != 120 || U'x' != 120 || u8'x' != 120) failed++;
    if (L'\n' != 10 || u'\x41' != 65 || U'\101' != 65 || u8'\t' != 9) failed++;
    if (L'e' != 101 || U'U' != 85 || u'l' != 108 || u8'F' != 70) failed++;
    if (sizeof('x') != sizeof(int) || sizeof(L'x') != sizeof(int)) failed++;
    if (PREFIX_ENUM != 65 || prefix_value != 65) failed++;
    printf("CHARACTER_PREFIX failed=%d\n", failed);
    return failed ? 1 : 7;
}
