/* Prepared transport for the two tree-header preprocessor observers. */
#pragma unisa use cxlib.netpack
int main(int argc, char **argv) {
    if (argc < 4) return 2;
    int seconds = atoi(argv[2]);
    if (seconds != 6 && seconds != 12) return 2;
    np_result res = {0};
    char why[1024] = "";
    int transport = np_run(argv + 3, argv[1], 0, seconds, &res, why, sizeof why);
    printf("PPC1 %d %d %zu %zu %zu\n", transport, res.rc, res.outn, res.errn, strlen(why));
    if (res.outn) fwrite(res.out, 1, res.outn, stdout);
    putchar(0);
    if (res.errn) fwrite(res.err, 1, res.errn, stdout);
    putchar(0);
    fwrite(why, 1, strlen(why) + 1, stdout);
    np_free(&res);
    return ferror(stdout) ? 2 : 0;
}
