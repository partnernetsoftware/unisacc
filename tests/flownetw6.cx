#!/usr/bin/env -S unisacc.com -run
/* flownetw6.cx -- the W6 gate of plans/m4-flownet-cx-module.md section 9 (flownet as the cornerstone).
     usage (repository root):
       sh ./unisacc.com -run tests/flownetw6.cx -- b1 ROOT
           B1, mechanism and domain apart: ROOT/flownet holds mechanism only -- no consumer's domain data, no consumer's
           name.  The consumers are found, not listed: every .cx under ROOT/tests and ROOT/adapter with the line
           `#pragma unisa use flownet.api` (its file name, and its directory unless that is tests or adapter), every
           directory holding a flownet contract (a contract.tsv with a net row) under the same trees (its name, or its
           parent's when it is called tables), and the two domains prd.md section 0 names (tdesc, ujs).  Each contract
           gives its names (every field of every row after the row's kind) and its gold tables DIR/NET.gold.tsv give
           the domain data: every row and every token (a field name or value, a class, a cell) that holds a letter or
           a digit.  A row is compared by its words: a line is split at blanks and at the punctuation of tables, prose,
           lists and initialisers, and each piece loses the punctuation around it ("- A3:" is A3, "->" is nothing).
           Six rules over every entry of ROOT/flownet, each finding named:
             files    an entry is a regular file named *.cx (the code) or *.md (its documentation); a directory, a link,
                      a table (*.tsv) or any other file is red -- a domain's tables belong to its consumer, which
                      hands them in (fn_label_source, fn_build, or a DIR it names)
             names    no entry name and no line of any entry's text (code, comments, documentation) names a consumer,
                      in any case, also spelled apart by '-' or '.' ("t-desc", "u.j.s")
             literals no string literal of a flownet/*.cx (escapes decoded, adjacent literals joined as C joins them) is
                      a consumer's name or token of a marked shape (an upper-case letter, a '_', a '.' or ':' inside,
                      letters with digits: P.A3, A3, s_null), and no .cx holds two or more distinct literals that are
                      plain consumer words (lower-case words, numbers: deref, index, adj) -- the format's own words
                      (net, field, class, flow and the contracts' row kinds) are mechanism, never domain
             rows     no line of a documentation file, of a .cx comment, of a .cx string literal or of the literals of
                      one .cx source line taken together is a consumer's gold or contract row or holds one of 3 or more
                      words as a run -- the table copied as text, bullets, a list or an initialiser
             spread   no entry holds, across its lines, 3 or more distinct rows of one consumer table (all of a table
                      that has fewer) as words in order with at most 3 other words between two -- the table rewritten
                      as prose or arrows ("P holds A3: ok", "- P.P deref -> next"), a row per comment
             table    no such text has the shape of a flownet table: a "net<TAB>" line and after it a "field<TAB>" or
                      "class<TAB>" line (any domain's table, found or not); and no line of an entry (code included)
                      holds, in order with at most 3 other words between, 4 consecutive numbers of a gold table's
                      class row or answer column one of which is 10 or more (the answers as an int array)
           Not a lexical matter, and so not this gate's: answers re-encoded so that no word or number of the gold
           survives (an ok/bad matrix as bits).  Such answers used by flownet are caught by the W3 sweep (each
           injected answer perturbed must change the result or be refused), unused ones by review.
           The scan proves itself first, in memory: seeded entries and texts -- a table directory, a gold table, a
           contract, a link, a consumer's name in a comment, in upper case, spelled apart, in a .md file's name or
           text, contract names and gold words as literals, also split and hex-escaped; for every gold table found,
           its text as a .md file, as one string literal of a .cx, as an initialiser of its rows, as bullets, as
           arrows, as prose with a word between every two of a row's words, as a numbered list and as one // comment
           per row; the numbers of a class row as an int array -- must give the findings of the rules they seed, and
           clean controls (prose with a short contract name inside a word, the table format described in a comment,
           mechanism literals, one plain consumer word as a literal, a format word a consumer's gold also holds) none.  The discovery must find at least two
           consumers, one contract and one gold table, else the scan is not trusted.
   rc 0 PASS, 1 red (each finding named), 2 usage or I/O.  No #include: the prelude is built in. */

static int quiet;                    /* the self-test counts without printing */
static int nfound, fired;            /* findings, and the rules that gave them (bits R_*) */
enum { R_FILES = 1, R_NAMES = 2, R_LIT = 4, R_DATA = 8, R_TABLE = 16, R_SPREAD = 32 };
enum { GAP = 3, SPREAD_MIN = 3, NUMWIN = 4 };

static void die(const char *why) { fprintf(stderr, "flownetw6: %s\n", why); exit(2); }
static char *fmt(const char *f, ...) {
    va_list ap; size_t cap = 256; int n; char *p = 0;
    for (;;) {
        char *g = realloc(p, cap);
        if (!g) { free(p); die("out of memory"); }
        p = g; va_start(ap, f); n = vsnprintf(p, cap, f, ap); va_end(ap);
        if (n < 0) die("cannot format");
        if ((size_t)n < cap) return p;
        cap = (size_t)n + 1;
    }
}
static void finding(int rule, const char *where, int line, const char *why) {
    nfound++; fired |= rule;
    if (quiet) return;
    if (line > 0) printf("FAIL %s:%d: %s\n", where, line, why);
    else printf("FAIL %s: %s\n", where, why);
}
static int ends(const char *s, const char *t) { size_t a = strlen(s), b = strlen(t); return a >= b && !strcmp(s + a - b, t); }
static const char *base(const char *p) { const char *s = strrchr(p, '/'); return s ? s + 1 : p; }

/* ---------- a growable byte buffer ---------- */
typedef struct { char *p; size_t n, cap; } buf;
static void bput(buf *b, const char *s, size_t k) {
    if (b->n + k + 1 > b->cap) {
        size_t c = b->cap ? b->cap : 256; char *g;
        while (c < b->n + k + 1) c *= 2;
        if (!(g = realloc(b->p, c))) die("out of memory");
        b->p = g; b->cap = c;
    }
    memcpy(b->p + b->n, s, k); b->n += k; b->p[b->n] = 0;
}
static void bput0(buf *b, const char *s) { bput(b, s, strlen(s)); }

/* ---------- a string set (open addressing) ---------- */
typedef struct { char **v; size_t cap, n; } set;
static size_t hsh(const char *s, size_t k) { size_t h = 5381; while (k--) h = h * 33 + (unsigned char)*s++; return h; }
static int set_has(const set *S, const char *s, size_t k) {
    size_t i;
    if (!S->cap) return 0;
    for (i = hsh(s, k) & (S->cap - 1); S->v[i]; i = (i + 1) & (S->cap - 1))
        if (strlen(S->v[i]) == k && !memcmp(S->v[i], s, k)) return 1;
    return 0;
}
static void set_add(set *S, const char *s, size_t k) {
    size_t i;
    if (set_has(S, s, k)) return;
    if (2 * (S->n + 1) > S->cap) {
        set T; size_t j;
        T.cap = S->cap ? 2 * S->cap : 64; T.n = 0;
        if (!(T.v = calloc(T.cap, sizeof(char *)))) die("out of memory");
        for (j = 0; j < S->cap; j++) if (S->v[j]) {
            for (i = hsh(S->v[j], strlen(S->v[j])) & (T.cap - 1); T.v[i]; i = (i + 1) & (T.cap - 1)) ;
            T.v[i] = S->v[j]; T.n++;
        }
        free(S->v); *S = T;
    }
    for (i = hsh(s, k) & (S->cap - 1); S->v[i]; i = (i + 1) & (S->cap - 1)) ;
    if (!(S->v[i] = malloc(k + 1))) die("out of memory");
    memcpy(S->v[i], s, k); S->v[i][k] = 0; S->n++;
}

/* ---------- words: a line split at blanks and at the punctuation of tables, prose, lists and initialisers; each
   piece trimmed of the punctuation around it (raw: untrimmed, for the vocabulary) ---------- */
static int sep(int c) { return c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == ',' || c == '{' || c == '}' || c == '"' || c == '\'' || c == '|' || c == '(' || c == ')' || c == ';' || c == '*' || c == '/' || c == '`'; }
static int trim(int c) { return c && strchr(".:;!?-=<>[]#+%&^~@$\\", c) != 0; }
static int alnum_in(const char *s, size_t k) { while (k--) if (isalnum((unsigned char)*s++)) return 1; return 0; }
#define MAXTOK 4096
static const char *tk[MAXTOK]; static size_t tl[MAXTOK];
static int tokens(const char *s, size_t L, int raw) {      /* into tk/tl; the count (capped at MAXTOK) */
    size_t i = 0; int m = 0;
    while (i < L && m < MAXTOK) {
        const char *a; size_t k;
        while (i < L && sep((unsigned char)s[i])) i++;
        if (i == L) break;
        a = s + i;
        while (i < L && !sep((unsigned char)s[i])) i++;
        k = (size_t)(s + i - a);
        if (!raw) { while (k && trim((unsigned char)*a)) { a++; k--; } while (k && trim((unsigned char)a[k - 1])) k--; }
        if (k) { tk[m] = a; tl[m] = k; m++; }
    }
    return m;
}
static void join(buf *b, int from, int k) {            /* words from..from+k-1, one blank apart */
    int j;
    b->n = 0; bput(b, "", 0);
    for (j = 0; j < k; j++) { if (j) bput(b, " ", 1); bput(b, tk[from + j], tl[from + j]); }
}
static int digits(const char *s, size_t k) { if (!k) return 0; while (k--) if (!isdigit((unsigned char)*s++)) return 0; return 1; }
static int marked(const char *s) {                     /* a word of a marked shape: P.A3, A3, s_null, P:inc */
    int lo = 0, dg = 0; size_t k = strlen(s), j;
    for (j = 0; j < k; j++) {
        unsigned char c = (unsigned char)s[j];
        if (isupper(c) || c == '_') return 1;
        if ((c == '.' || c == ':') && j && j + 1 < k) return 1;
        if (islower(c)) lo = 1; else if (isdigit(c)) dg = 1;
    }
    return lo && dg;
}

/* ---------- the discovered names, vocabulary and rows ---------- */
static set ident;                    /* consumer identities, lower case (substring, any case) */
static set lit;                      /* contract names (exact literal) */
static set voc;                      /* gold words with a letter or digit (exact literal) */
static set fmtw;                     /* the format's own words: never domain */
static set rows;                     /* gold and contract rows, words one blank apart (2 or more words) */
static set numw;                     /* 4 consecutive numbers of a class row or an answer column */
static int runlen[MAXTOK + 1];       /* runlen[k]: some row of k >= 3 words is known */
static int nconsumers, ncontracts, ngolds;
static const char *rootpfx; static size_t rootlen;   /* ROOT/, left out of a table's name */
#define MAXGOLD 64
#define MAXGRP (2 * MAXGOLD)
static char *goldpath[MAXGOLD], *goldtext[MAXGOLD]; static const char *goldshow[MAXGOLD]; static int goldrows[MAXGOLD];
static char *grpname[MAXGRP]; static int grpsize[MAXGRP], ngrp;
/* the rows for the spread rule: words, the table (group) they come from, chained by first word */
#define MAXROWS 32768
#define NBUCKET 16384
static char *rtxt[MAXROWS]; static int rn[MAXROWS], rgrp[MAXROWS], rnext[MAXROWS], nrow;
static const char **rw[MAXROWS]; static size_t *rwl[MAXROWS];
static int bucket[NBUCKET];

static void add_ident(const char *s, size_t k) {
    char *low = malloc(k + 1); size_t j;
    if (!low) die("out of memory");
    for (j = 0; j < k; j++) low[j] = (char)tolower((unsigned char)s[j]);
    if (k) set_add(&ident, low, k);
    free(low);
}
static void add_dir_of(const char *path, const char *skip) {   /* the name of PATH's directory, unless it is SKIP */
    const char *e = strrchr(path, '/'), *s;
    if (!e) return;
    for (s = e; s > path && s[-1] != '/'; s--) ;
    if (*skip && (size_t)(e - s) == strlen(skip) && !strncmp(s, skip, strlen(skip))) {   /* tables: the parent's name */
        if (s == path) return;
        e = s - 1; for (s = e; s > path && s[-1] != '/'; s--) ;
    }
    if (!((size_t)(e - s) == 5 && !strncmp(s, "tests", 5)) && !((size_t)(e - s) == 7 && !strncmp(s, "adapter", 7))) add_ident(s, (size_t)(e - s));
}
static int new_group(const char *name) {
    if (ngrp == MAXGRP) die("more tables than the limit");
    grpname[ngrp] = fmt("%s", rootlen && !strncmp(name, rootpfx, rootlen) ? name + rootlen : name); grpsize[ngrp] = 0;
    return ngrp++;
}
static void spread_row(int g, int from, int m) {       /* words from..m-1 of tk as a row of group G */
    buf b = { 0, 0, 0 }; int j; char *p; size_t h;
    if (m - from < 2) return;
    if (nrow == MAXROWS) die("more rows than the limit");
    join(&b, from, m - from);
    rtxt[nrow] = b.p; rn[nrow] = m - from; rgrp[nrow] = g; grpsize[g]++;
    if (!(rw[nrow] = malloc(sizeof(char *) * (size_t)rn[nrow])) || !(rwl[nrow] = malloc(sizeof(size_t) * (size_t)rn[nrow]))) die("out of memory");
    for (p = b.p, j = 0; j < rn[nrow]; j++) {
        char *q = strchr(p, ' ');
        rw[nrow][j] = p; rwl[nrow][j] = q ? (size_t)(q - p) : strlen(p);
        if (q) p = q + 1;
    }
    h = hsh(rw[nrow][0], rwl[nrow][0]) & (NBUCKET - 1);
    rnext[nrow] = bucket[h] - 1; bucket[h] = nrow + 1;
    nrow++;
}
static void strong_row(int from, int m) {
    buf b = { 0, 0, 0 };
    if (m - from < 2) return;
    join(&b, from, m - from); set_add(&rows, b.p, b.n); free(b.p);
    if (m - from >= 3) runlen[m - from] = 1;
}
static void add_numbers(const char **w, const size_t *wl, int n) {   /* every NUMWIN consecutive numbers, one >= 10 */
    int i, j;
    for (i = 0; i + NUMWIN <= n; i++) {
        buf b = { 0, 0, 0 }; int big = 0;
        for (j = 0; j < NUMWIN; j++) {
            if (j) bput(&b, " ", 1);
            bput(&b, w[i + j], wl[i + j]);
            if (wl[i + j] >= 2) big = 1;
        }
        if (big) set_add(&numw, b.p, b.n);
        free(b.p);
    }
}
/* one row of a table (not a comment) of group G: its words as a row; GOLD: also its raw words as vocabulary (the kind
   of a field or class row is format, not domain), the numbers of a class row, the answer (last word) */
#define MAXANS 8192
static const char *answ[MAXANS]; static size_t ansl[MAXANS]; static int nans;
static int add_row(const char *p, size_t L, int gold, int g) {
    int m, j, kind = 0;
    if (gold) {
        m = tokens(p, L, 1);
        if (m && ((tl[0] == 5 && !strncmp(tk[0], "field", 5)) || (tl[0] == 5 && !strncmp(tk[0], "class", 5)))) kind = tk[0][0] == 'c' ? 2 : 1;
        for (j = kind ? 1 : 0; j < m; j++) if (alnum_in(tk[j], tl[j])) set_add(&voc, tk[j], tl[j]);
    }
    m = tokens(p, L, 0);
    if (m < 2) return 0;
    strong_row(0, m);
    if (kind) strong_row(1, m);
    spread_row(g, kind ? 1 : 0, m);
    if (kind == 2) {                                   /* the class row's numbers, in order */
        const char *w[MAXTOK]; size_t wl[MAXTOK]; int n = 0;
        for (j = 1; j < m; j++) if (digits(tk[j], tl[j])) { w[n] = tk[j]; wl[n] = tl[j]; n++; }
        add_numbers(w, wl, n);
    } else if (gold && !kind && nans < MAXANS) {
        char *c = malloc(tl[m - 1] + 1);
        if (!c) die("out of memory");
        memcpy(c, tk[m - 1], tl[m - 1]); c[tl[m - 1]] = 0;
        answ[nans] = c; ansl[nans] = tl[m - 1]; nans++;
    }
    return 1;
}
static void read_gold(const char *dir, const char *net, size_t k) {
    char *nm = malloc(k + 1), *path, *b, *p, *q; size_t n; int nr = 0, g, i0;
    if (!nm) die("out of memory");
    memcpy(nm, net, k); nm[k] = 0;
    path = fmt("%s/%s.gold.tsv", dir, nm); free(nm);
    if (!(b = cx_read(path, &n))) { free(path); return; }       /* a net without a gold table (its gold is injected) */
    g = new_group(path); nans = 0;
    for (p = b; *p; p = q + 1) {
        char *nl = strchr(p, '\n');
        q = nl ? nl : p + strlen(p);
        if (*p != '#' && p < q && !(q - p > 4 && !strncmp(p, "net\t", 4))) nr += add_row(p, (size_t)(q - p), 1, g);
        if (!nl) break;
    }
    {                                                  /* the answer column, if it is numbers */
        const char *w[MAXANS]; size_t wl[MAXANS]; int n2 = 0;
        for (i0 = 0; i0 < nans; i0++) {
            if (digits(answ[i0], ansl[i0])) { w[n2] = answ[i0]; wl[n2] = ansl[i0]; n2++; }
            else { add_numbers(w, wl, n2); n2 = 0; }
        }
        add_numbers(w, wl, n2);
        for (i0 = 0; i0 < nans; i0++) free((char *)answ[i0]);
        nans = 0;
    }
    if (ngolds == MAXGOLD) die("more gold tables than the limit");
    goldpath[ngolds] = path; goldshow[ngolds] = rootlen && !strncmp(path, rootpfx, rootlen) ? path + rootlen : path; goldtext[ngolds] = b; goldrows[ngolds] = nr; ngolds++;
}
static int discover(const char *path, void *ctx) {
    char *b; size_t n;
    (void)ctx;
    if (strstr(path, "/flownet/")) return 0;                 /* flownet itself, and the module links beside a consumer */
    if (ends(path, ".cx")) {
        if (!(b = cx_read(path, &n))) { fprintf(stderr, "flownetw6: %s: cannot read\n", path); exit(2); }
        if (!strncmp(b, "#pragma unisa use flownet.api\n", 30) || strstr(b, "\n#pragma unisa use flownet.api\n")) {
            const char *s = base(path);
            nconsumers++;
            add_ident(s, strlen(s) - 3);
            add_dir_of(path, "");
        }
        free(b);
    } else if (!strcmp(base(path), "contract.tsv")) {
        char *p, *q, *dir; int g;
        if (!(b = cx_read(path, &n))) { fprintf(stderr, "flownetw6: %s: cannot read\n", path); exit(2); }
        if (strncmp(b, "net\t", 4) && !strstr(b, "\nnet\t")) { free(b); return 0; }   /* not a flownet contract */
        ncontracts++;
        add_dir_of(path, "tables");
        g = new_group(path);
        dir = fmt("%.*s", (int)(base(path) - 1 - path), path);
        for (p = b; *p; p = q + 1) {             /* every row but comments: the fields after the row's kind */
            char *nl = strchr(p, '\n'), *f;
            q = nl ? nl : p + strlen(p);
            if (*p != '#' && p < q) {
                add_row(p, (size_t)(q - p), 0, g);
                f = memchr(p, '\t', (size_t)(q - p));
                if (f) set_add(&fmtw, p, (size_t)(f - p));
                while (f && f < q) {
                    char *gg = memchr(f + 1, '\t', (size_t)(q - f - 1)), *end = gg ? gg : q;
                    if (end > f + 1) set_add(&lit, f + 1, (size_t)(end - f - 1));
                    if (q - p > 4 && !strncmp(p, "net\t", 4) && end > f + 1) read_gold(dir, f + 1, (size_t)(end - f - 1));
                    f = gg;
                }
            }
            if (!nl) break;
        }
        free(dir); free(b);
    }
    return 0;
}

/* ---------- the rules over texts ---------- */
static void names_in(const char *label, int line, const char *s, size_t L) {   /* the longest consumer name S holds */
    char *low = malloc(L + 1), *apart = malloc(L + 1); size_t j, i, k = 0; const char *best = 0;
    if (!low || !apart) die("out of memory");
    for (j = 0; j < L; j++) {
        low[j] = (char)tolower((unsigned char)s[j]);
        if (low[j] != '-' && low[j] != '.') apart[k++] = low[j];
    }
    low[L] = 0; apart[k] = 0;
    for (i = 0; i < ident.cap; i++)
        if (ident.v[i] && (strstr(low, ident.v[i]) || strstr(apart, ident.v[i])) && (!best || strlen(ident.v[i]) > strlen(best))) best = ident.v[i];
    if (best) { char *w = fmt("names the consumer '%s' (flownet names no consumer)", best); finding(R_NAMES, label, line, w); free(w); }
    free(low); free(apart);
}
static int weq(int i, const char *w, size_t k) { return tl[i] == k && !memcmp(tk[i], w, k); }
/* W in order among tk[0..m), at most GAP other words between two; AT >= 0: W's first word is tk[AT] */
static int gapped(const char *const *w, const size_t *wl, int n, int at, int m) {
    static char cur[MAXTOK], nxt[MAXTOK];
    int i, j, d, any = 0, lo = at < 0 ? 0 : at, hi = m;
    if (at >= 0 && (long)at + (long)(n - 1) * (GAP + 1) + 1 < (long)m) hi = at + (n - 1) * (GAP + 1) + 1;
    for (i = lo; i < hi; i++) { cur[i] = (char)((at < 0 || i == at) && weq(i, w[0], wl[0])); any |= cur[i]; }
    for (j = 1; j < n && any; j++) {
        any = 0;
        for (i = lo; i < hi; i++) {
            nxt[i] = 0;
            if (weq(i, w[j], wl[j])) for (d = 1; d <= GAP + 1 && i - d >= lo; d++) if (cur[i - d]) { nxt[i] = 1; any = 1; break; }
        }
        memcpy(cur + lo, nxt + lo, (size_t)(hi - lo));
    }
    return any;
}
/* the spread rule's book for the entry being scanned: rows seen (by stamp), per group how many, and where first */
static int stamp, rowseen[MAXROWS], grpcnt[MAXGRP], grpline[MAXGRP]; static char *grprow[MAXGRP];
static void spread_reset(void) { int g; stamp++; for (g = 0; g < ngrp; g++) { grpcnt[g] = 0; free(grprow[g]); grprow[g] = 0; } }
static void spread_line(int m, int line) {            /* the rows tk[0..m) holds, words in order */
    int i, r;
    for (i = 0; i < m; i++)
        for (r = bucket[hsh(tk[i], tl[i]) & (NBUCKET - 1)] - 1; r >= 0; r = rnext[r])
            if (rowseen[r] != stamp && weq(i, rw[r][0], rwl[r][0]) && gapped(rw[r], rwl[r], rn[r], i, m)) {
                int g = rgrp[r];
                rowseen[r] = stamp;
                if (!grpcnt[g]++) { grpline[g] = line; grprow[g] = fmt("%s", rtxt[r]); }
            }
}
static void spread_end(const char *label) {
    int g;
    for (g = 0; g < ngrp; g++) {
        int need = grpsize[g] < SPREAD_MIN ? grpsize[g] : SPREAD_MIN;
        if (need >= 1 && grpcnt[g] >= need) {
            char *w = fmt("holds %d distinct rows of %s as words in order (first \"%s\"; the table rewritten -- domain data belongs to its consumer)", grpcnt[g], grpname[g], grprow[g]);
            finding(R_SPREAD, label, grpline[g], w); free(w);
        }
    }
}
static int numbers_in(int m) {                         /* a class row's or answer column's numbers, in order */
    size_t i; int n;
    for (i = 0; i < numw.cap; i++) if (numw.v[i]) {
        const char *w[NUMWIN]; size_t wl[NUMWIN]; char *p = numw.v[i];
        for (n = 0; n < NUMWIN; n++) { char *q = strchr(p, ' '); w[n] = p; wl[n] = q ? (size_t)(q - p) : strlen(p); if (q) p = q + 1; }
        if (gapped(w, wl, NUMWIN, -1, m)) return 1;
    }
    return 0;
}
static int row_in(int m, buf *b) {                     /* the row tk[0..m) is or holds as a run (into B), or 0 */
    int i, k;
    if (m >= 2) { join(b, 0, m); if (set_has(&rows, b->p, b->n)) return 1; }
    for (k = 3; k < m; k++) if (runlen[k])
        for (i = 0; i + k <= m; i++) { join(b, i, k); if (set_has(&rows, b->p, b->n)) return 1; }
    return 0;
}
/* rows, spread and table over the text T of LEN bytes (a document, a comment, a literal, a source line's literals):
   one rows finding per text (its first row, and how many lines hold one), one table finding per text; the spread
   rule's book grows */
static void data_in(const char *label, int line0, int adv, const char *what, const char *t, size_t len) {
    const char *p = t, *e = t + len; int line = line0, hits = 0, first = 0, sawnet = 0, table = 0, m; buf b = { 0, 0, 0 }; char *row = 0;
    while (p < e) {
        const char *nl = memchr(p, '\n', (size_t)(e - p)), *q = nl ? nl : e;
        m = tokens(p, (size_t)(q - p), 0);
        if (row_in(m, &b)) { if (!hits++) { first = line; row = fmt("%s", b.p); } }
        m = tokens(p, (size_t)(q - p), 0);
        spread_line(m, line);
        if (q - p >= 4 && !strncmp(p, "net\t", 4)) sawnet = 1;
        else if (sawnet && !table && q - p >= 6 && (!strncmp(p, "field\t", 6) || !strncmp(p, "class\t", 6))) table = line;
        if (!nl) break;
        p = nl + 1; line += adv;
    }
    if (hits) {
        char *w = fmt("%s holds a consumer's table row \"%s\" (%d line(s) hold one; domain data belongs to its consumer)", what, row, hits);
        finding(R_DATA, label, first, w); free(w);
    }
    if (table) {
        char *w = fmt("%s has the shape of a flownet table (a net row, then a field or class row)", what);
        finding(R_TABLE, label, table, w); free(w);
    }
    free(row); free(b.p);
}
static void numbers_text(const char *label, const char *t) {   /* every line of an entry, code included */
    const char *p = t; int line = 1;
    while (*p) {
        const char *e = strchr(p, '\n'); size_t L = e ? (size_t)(e - p) : strlen(p);
        if (numbers_in(tokens(p, L, 0))) {
            finding(R_TABLE, label, line, "holds, in order, 4 numbers of a consumer's class row or answer column (the answers as numbers)");
            return;
        }
        if (!e) break;
        p = e + 1; line++;
    }
}
static int hexv(int c) { return isdigit(c) ? c - '0' : isxdigit(c) ? tolower(c) - 'a' + 10 : -1; }
/* the literals of a .cx: count the plain consumer words (distinct) and name the marked ones */
static set plainhit; static char *plainfirst; static int plainline;
static void literal(const char *label, int line, const char *s, size_t k) {
    int name = set_has(&lit, s, k), word = set_has(&voc, s, k);
    if ((!name && !word) || set_has(&fmtw, s, k)) return;
    if (marked(s)) {
        char *w = fmt("the string literal \"%s\" is a %s (domain vocabulary as data)", s, name ? "name a consumer's contract gives" : "word of a consumer's gold table");
        finding(R_LIT, label, line, w); free(w);
    } else if (!set_has(&plainhit, s, k)) {
        set_add(&plainhit, s, k);
        if (!plainfirst) { plainfirst = fmt("%s", s); plainline = line; }
        else if (plainhit.n == 2) {
            char *w = fmt("the string literals \"%s\" (line %d) and \"%s\" are %s consumer words (domain vocabulary as data)", plainfirst, plainline, s, "plain");
            finding(R_LIT, label, line, w); free(w);
        }
    }
}
/* the text T of LABEL, an entry of flownet/ (CX: a .cx, else a document) */
static void check_text(const char *label, const char *t, int cx) {
    const char *p = t; int line = 1;
    buf lits = { 0, 0, 0 }, dec = { 0, 0, 0 };
    while (*p) {                                       /* names: every line */
        const char *e = strchr(p, '\n'); size_t L = e ? (size_t)(e - p) : strlen(p);
        names_in(label, line, p, L);
        if (!e) break;
        p = e + 1; line++;
    }
    spread_reset();
    numbers_text(label, t);
    if (!cx) { data_in(label, 1, 1, "the text", t, strlen(t)); spread_end(label); return; }
    { size_t i; for (i = 0; i < plainhit.cap; i++) { free(plainhit.v[i]); } free(plainhit.v); plainhit.v = 0; plainhit.cap = plainhit.n = 0; free(plainfirst); plainfirst = 0; }
    bput(&lits, "", 0);
    for (p = t, line = 1; *p; p++) {                   /* comments, literals, and each source line's literals */
        if (*p == '\n') { if (lits.n) data_in(label, line, 0, "the string literals of this line", lits.p, lits.n); lits.n = 0; line++; continue; }
        if (p[0] == '/' && p[1] == '*') {
            const char *s = p + 2; int l0 = line;
            for (p += 2; *p && !(p[0] == '*' && p[1] == '/'); p++) if (*p == '\n') line++;
            data_in(label, l0, 1, "a comment", s, (size_t)(p - s));
            if (!*p) break;
            p++; continue;
        }
        if (p[0] == '/' && p[1] == '/') { const char *s = p + 2; while (p[1] && p[1] != '\n') p++; data_in(label, line, 1, "a comment", s, (size_t)(p + 1 - s)); continue; }
        if (*p == '\'') { for (p++; *p && *p != '\'' && *p != '\n'; p++) if (*p == '\\' && p[1]) p++; if (!*p) break; continue; }
        if (*p == '"') {                               /* one literal: adjacent ones joined, escapes decoded */
            int l0 = line;
            dec.n = 0; bput(&dec, "", 0);
            for (;;) {
                for (p++; *p && *p != '"' && *p != '\n'; p++) {
                    char c = *p;
                    if (c == '\\' && p[1]) {
                        int v = 0, j;
                        p++;
                        if (*p == 'x') { for (j = 0; isxdigit((unsigned char)p[1]); j++) { v = v * 16 + hexv((unsigned char)p[1]); p++; } c = j ? (char)v : 'x'; }
                        else if (*p >= '0' && *p <= '7') { for (j = 0; j < 3 && *p >= '0' && *p <= '7'; j++) { v = v * 8 + (*p - '0'); p++; } p--; c = (char)v; }
                        else c = *p == 'n' ? '\n' : *p == 't' ? '\t' : *p == 'r' ? '\r' : *p == 'a' ? '\a' : *p == 'b' ? '\b' : *p == 'f' ? '\f' : *p == 'v' ? '\v' : *p;
                        if (!c) c = ' ';
                    }
                    bput(&dec, &c, 1);
                }
                if (*p != '"') break;                  /* unterminated: at the line's end or the text's */
                {                                      /* a literal right after (blanks, newlines, comments between)? */
                    const char *r = p + 1; int nl = 0;
                    for (;;) {
                        while (*r == ' ' || *r == '\t' || *r == '\r' || *r == '\n') { if (*r == '\n') nl++; r++; }
                        if (r[0] == '/' && r[1] == '*') { const char *z = strstr(r + 2, "*/"); if (!z) break; for (; r < z; r++) if (*r == '\n') nl++; r = z + 2; continue; }
                        break;
                    }
                    if (*r != '"') break;
                    line += nl; p = r;
                }
            }
            literal(label, l0, dec.p, dec.n);
            if (lits.n) bput(&lits, " ", 1);
            bput(&lits, dec.p, dec.n);
            if (!*p) break;
            if (*p == '\n') { if (lits.n) data_in(label, line, 0, "the string literals of this line", lits.p, lits.n); lits.n = 0; line++; }
        }
    }
    if (lits.n) data_in(label, line, 0, "the string literals of this line", lits.p, lits.n);
    spread_end(label);
    free(lits.p); free(dec.p);
}
/* one entry NAME of flownet/ (DIR the label's directory) of kind K ('f' regular, 'd' directory, 'l' link, 'o' other)
   and, for a regular file, its text T */
static void check_entry(const char *dir, const char *name, int k, const char *t) {
    char *w = fmt("%s/%s", dir, name);
    if (k == 'd') finding(R_FILES, w, 0, "a directory in flownet/ (a domain's tables belong to its consumer)");
    else if (k == 'l') finding(R_FILES, w, 0, "a link in flownet/ (flownet holds its own code only)");
    else if (k != 'f') finding(R_FILES, w, 0, "not a regular file");
    else if (ends(name, ".tsv")) finding(R_FILES, w, 0, "a table in flownet/ (domain data belongs to its consumer, handed in through fn_label_source / fn_build)");
    else if (!ends(name, ".cx") && !ends(name, ".md")) finding(R_FILES, w, 0, "neither mechanism code (.cx) nor its documentation (.md)");
    names_in(w, 0, name, strlen(name));
    if (k == 'f' && t) check_text(w, t, ends(name, ".cx"));
    free(w);
}

/* ---------- the self-test: seeded entries and texts give the findings of the rules they seed ---------- */
static int seed(const char *what, const char *name, int kind, const char *text, int want) {
    nfound = 0; fired = 0;
    check_entry("seed", name, kind, text);
    if (want ? (fired & want) != want : nfound != 0) {
        printf("FAIL self-test: %s (%s) gives %d finding(s) of rules %#x, want %s%#x\n", what, name, nfound, fired, want ? "rules " : "none, not ", want ? want : fired);
        return 0;
    }
    return 1;
}
static char *as_literal(const char *t) {               /* T as the body of one C string literal */
    buf b = { 0, 0, 0 };
    bput(&b, "", 0);
    for (; *t; t++)
        if (*t == '\n') bput0(&b, "\\n"); else if (*t == '\t') bput0(&b, "\\t");
        else if (*t == '"' || *t == '\\') { bput(&b, "\\", 1); bput(&b, t, 1); } else bput(&b, t, 1);
    return b.p;
}
static char *as_initialiser(const char *t) {           /* the rows of T as {"a","b",...}, all on one line */
    buf b = { 0, 0, 0 }; const char *p = t, *q;
    bput0(&b, "static const char *const rows[][8] = { ");
    for (; *p; p = q + 1) {
        const char *nl = strchr(p, '\n'), *f, *g;
        q = nl ? nl : p + strlen(p);
        if (*p != '#' && p < q) {
            bput0(&b, "{");
            for (f = p; f < q; f = g + 1) {
                g = memchr(f, '\t', (size_t)(q - f)); if (!g) g = q;
                if (f > p) bput0(&b, ",");
                bput0(&b, "\""); { char *s = fmt("%.*s", (int)(g - f), f), *e = as_literal(s); bput0(&b, e); free(e); free(s); } bput0(&b, "\"");
                if (g == q) break;
            }
            bput0(&b, "}, ");
        }
        if (!nl) break;
    }
    bput0(&b, "};\n");
    return b.p;
}
/* the data rows of T (no comment, no net/field/class row) rewritten one per line: HOW 'b' "- a b c", 'a' "- a b -> c",
   'p' "a holds b holds c.", 'n' "N. a b c", 'c' "// a b c" (in a .cx) */
static char *rewrite(const char *t, int how) {
    buf b = { 0, 0, 0 }; const char *p = t, *q; int n = 0;
    bput(&b, "", 0);
    if (how == 'c') bput0(&b, "int x;\n");
    for (; *p; p = q + 1) {
        const char *nl = strchr(p, '\n'), *f, *g;
        q = nl ? nl : p + strlen(p);
        if (*p != '#' && p < q && strncmp(p, "net\t", 4) && strncmp(p, "field\t", 6) && strncmp(p, "class\t", 6)) {
            char *e = fmt("%d. ", ++n);
            bput0(&b, how == 'b' || how == 'a' ? "- " : how == 'n' ? e : how == 'c' ? "// " : "");
            free(e);
            for (f = p; f < q; f = g + 1) {
                g = memchr(f, '\t', (size_t)(q - f)); if (!g) g = q;
                if (f > p) bput0(&b, how == 'p' ? " holds " : how == 'a' && g == q ? " -> " : " ");
                bput(&b, f, (size_t)(g - f));
                if (g == q) break;
            }
            bput0(&b, how == 'p' ? ".\n" : "\n");
        }
        if (!nl) break;
    }
    return b.p;
}
static int selftest(void) {
    int ok = 1, i; const char *who = 0; char *t, *u, *nm; size_t j;
    for (j = 0; j < ident.cap; j++) if (ident.v[j] && (!who || strlen(ident.v[j]) > strlen(who))) who = ident.v[j];
    quiet = 1;
    ok &= seed("clean code", "api.cx", 'f', "int x;\n", 0);
    ok &= seed("clean documentation", "README.md", 'f', "# flownet\nThe flow x net mechanism: a consumer hands in its tables.\n", 0);
    ok &= seed("a table directory", "tdesc", 'd', 0, R_FILES);
    ok &= seed("a gold table", "adj.gold.tsv", 'f', "", R_FILES);
    ok &= seed("a contract", "contract.tsv", 'f', "", R_FILES);
    ok &= seed("a link", "nets.cx", 'l', 0, R_FILES);
    ok &= seed("another file", "notes.txt", 'f', "", R_FILES);
    ok &= seed("a consumer's file in a comment", "a.cx", 'f', "/* the gold of tests/tdescprobe.cx */\nint x;\n", R_NAMES);
    ok &= seed("a consumer's directory in a comment", "a.cx", 'f', "/* see adapter/UJSWASM */\n", R_NAMES);
    ok &= seed("a domain in upper case", "a.cx", 'f', "/* the TDESC algebra */\n", R_NAMES);
    ok &= seed("a domain spelled apart by '-'", "a.cx", 'f', "/* the t-desc probe */\n", R_NAMES);
    ok &= seed("a domain spelled apart by '.'", "a.md", 'f', "the u.j.s adapter\n", R_NAMES);
    t = fmt("consumer tests/%s.cx uses its tables\n", who);
    ok &= seed("a consumer's name in a document's text", "notes.md", 'f', t, R_NAMES); free(t);
    nm = fmt("%s.md", who);
    ok &= seed("a consumer's name as a document's name", nm, 'f', "flownet\n", R_NAMES); free(nm);
    ok &= seed("two contract names as literals", "a.cx", 'f', "static const char *a = \"adj\", *b = \"sz\";\n", R_LIT);
    ok &= seed("a contract phase and a gold word as literals", "a.cx", 'f', "int f(void) { return g(\"size\", \"x\") + g(\"deref\", 0); }\n", R_LIT);
    ok &= seed("two gold words as literals", "a.cx", 'f', "if (!strcmp(lab, \"deref\")) return 1;\nif (!strcmp(lab, \"index\")) return 2;\n", R_LIT);
    ok &= seed("gold words split into adjacent literals", "a.cx", 'f', "if (!strcmp(lab, \"de\" \"ref\")) return 1;\nif (!strcmp(lab, \"in\"\n  /* x */ \"dex\")) return 2;\n", R_LIT);
    ok &= seed("a marked gold word hex-escaped", "a.cx", 'f', "if (!strcmp(at, \"\\x50.\\x50\")) return 1;\n", R_LIT);
    ok &= seed("a marked gold word octal-escaped", "a.cx", 'f', "if (!strcmp(at, \"\\101\" \"3\")) return 1;\n", R_LIT);
    ok &= seed("a foreign table in a document", "x.md", 'f', "net\tq\nfield\tk\ta\tb\nclass\ty\tn\na\ty\nb\tn\n", R_TABLE);
    ok &= seed("the size classes as an int array", "nets.cx", 'f', "static const int cls[] = { 8, 12, 24, 36, 72, 108 };\n", R_TABLE);
    set_add(&voc, "flow", 4);                         /* as if a consumer's gold held a format word: still mechanism */
    ok &= seed("clean prose and literals", "a.cx", 'f',
               "/* adjust the size of a flow; ap and sz */\nstatic const char *a = \"flow\", *b = \"net\"; char c = '\"';\n"
               "/* a gold table: net NAME, then field NAME v..., then class c..., then one row per key */\n"
               "static const char *f = \"%s/%s.gold.tsv\", *s = \",\", *q = \"?\", *n = \"net\\t\", *m = \"field\\t\", *k = \"class\", *r = \"deref\";\n"
               "static const int w[] = { 1, 2, 4, 8, 16, 32 };\n", 0);
    for (i = 0; i < ngolds; i++) {                    /* every gold table found, smuggled eight ways */
        int want = R_TABLE | (goldrows[i] ? R_DATA : 0), r = goldrows[i] ? R_DATA | R_SPREAD : 0, h;
        static const char hows[] = "bapnc";
        static const char *const hown[] = { "bullets", "arrows", "prose", "a numbered list", "one // comment per row" };
        char *what = fmt("%s as a document", goldshow[i]);
        ok &= seed(what, "adj.gold.md", 'f', goldtext[i], want); free(what);
        u = as_literal(goldtext[i]); t = fmt("static const char *t = \"%s\";\n", u); free(u);
        what = fmt("%s as one string literal", goldshow[i]);
        ok &= seed(what, "zdata.cx", 'f', t, want); free(what); free(t);
        t = as_initialiser(goldtext[i]);
        what = fmt("%s as an initialiser of its rows", goldshow[i]);
        ok &= seed(what, "nets.cx", 'f', t, R_LIT | (goldrows[i] ? R_DATA : 0)); free(what); free(t);
        for (h = 0; hows[h]; h++) {
            t = rewrite(goldtext[i], hows[h]);
            what = fmt("%s as %s", goldshow[i], hown[h]);
            ok &= seed(what, hows[h] == 'c' ? "nets.cx" : "sizes.md", 'f', t, hows[h] == 'p' || hows[h] == 'n' ? R_SPREAD & r : r); free(what); free(t);
        }
    }
    quiet = 0; nfound = 0; fired = 0;
    return ok;
}

static int cmd_b1(const char *root) {
    char *fd = fmt("%s/flownet", root), *td = fmt("%s/tests", root), *ad = fmt("%s/adapter", root);
    DIR *d; struct dirent *e; int nfiles = 0, ncx = 0, nmd = 0; size_t i;
    static const char *const fw[] = { "net", "field", "class", "flow" };
    for (i = 0; i < 4; i++) set_add(&fmtw, fw[i], strlen(fw[i]));
    rootpfx = fmt("%s/", root); rootlen = strlen(rootpfx);
    if (cx_walk(td, discover, 0) < 0 || cx_walk(ad, discover, 0) < 0) { fprintf(stderr, "flownetw6: cannot walk %s or %s\n", td, ad); return 2; }
    add_ident("tdesc", 5); add_ident("ujs", 3);   /* the domains of prd.md section 0 */
    if (nconsumers < 2 || ncontracts < 1 || ngolds < 1) {
        printf("flownetw6 b1: FAIL (the discovery found %d consumers, %d contracts and %d gold tables, want at least 2, 1 and 1: not trusted)\n", nconsumers, ncontracts, ngolds);
        return 1;
    }
    if (!selftest()) { printf("flownetw6 b1: FAIL (the scan does not find what it seeds: not trusted)\n"); return 1; }
    if (!(d = opendir(fd))) { fprintf(stderr, "flownetw6: %s: cannot read\n", fd); return 2; }
    while ((e = readdir(d))) {
        char *p, *b = 0; struct stat st; int k; size_t n;
        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
        p = fmt("%s/%s", fd, e->d_name);
        if (lstat(p, &st)) { fprintf(stderr, "flownetw6: %s: cannot stat\n", p); return 2; }
        k = S_ISLNK(st.st_mode) ? 'l' : S_ISDIR(st.st_mode) ? 'd' : S_ISREG(st.st_mode) ? 'f' : 'o';
        nfiles++;
        if (k == 'f') {
            if (!(b = cx_read(p, &n))) { fprintf(stderr, "flownetw6: %s: cannot read\n", p); return 2; }
            if (strlen(b) != n) finding(R_FILES, p, 0, "holds a NUL byte (not text)");
            if (ends(e->d_name, ".cx")) ncx++; else if (ends(e->d_name, ".md")) nmd++;
        }
        check_entry("flownet", e->d_name, k, b);
        free(b); free(p);
    }
    closedir(d);
    if (ncx < 5) { printf("flownetw6 b1: FAIL (%d .cx files in flownet/, want fnx, contract, nets, flow, api)\n", ncx); return 1; }
    if (nfound) { printf("flownetw6 b1: FAIL (%d finding(s) in flownet/)\n", nfound); return 1; }
    printf("flownetw6 b1: PASS (flownet/: %d entries, %d .cx, %d .md, mechanism only -- no table, directory or link; no consumer named in a name or a text; no consumer name or gold word as a literal (marked: one; plain: two); no gold or contract row as a line or run, no 3 rows of one table spread as words in order, no table shape and no gold numbers in order; consumers found: %d, contracts: %d, gold tables: %d; names:",
           nfiles, ncx, nmd, nconsumers, ncontracts, ngolds);
    for (i = 0; i < ident.cap; i++) if (ident.v[i]) printf(" %s", ident.v[i]);
    printf("; contract names: %d, gold words: %d, rows: %d, spread rows: %d, number runs: %d; self-test green, every gold table found eight ways)\n", (int)lit.n, (int)voc.n, (int)rows.n, nrow, (int)numw.n);
    return 0;
}

int main(int argc, char **argv) {
    if (argc == 3 && !strcmp(argv[1], "b1")) return cmd_b1(argv[2]);
    fprintf(stderr, "usage: flownetw6.cx b1 ROOT\n");
    return 2;
}
