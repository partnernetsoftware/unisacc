/* Run the real ledger snapshot fixture with the CX-owned ledger operations.
 * Material is prepared and verified by the existing source-preserving tool;
 * the CX-wired copy is separate and never changes the prepared material.
 * The tool and the wired fixture are built to native images first (PREPARED,
 * own bound); the three asserted steps keep their bounds and time the run only.
 * No cxlib.netpack here: it costs this check about four seconds of cold compile
 * (see tools/cxlib/toolprep.cx) and the steps are already bounded by tools/bound;
 * the runtime's cx_runv_timeout is the outer safety net and the child's stderr
 * reaches this process's stderr directly. */
#pragma unisa use cxlib.toolprep
static void die(const char *s){fprintf(stderr,"snapshots-cx: %s\n",s);exit(2);}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path");}
static void call(char **v,int seconds,const char *out,const char *label){
    char *o=0;size_t on=0;char p[4400],name[128];
    int rc=cx_runv_timeout(v,seconds,&o,&on);
    {if(cx_fmt(name,sizeof name,"%s.stdout",label))die("format-bound");}path(p,out,name);if(cx_write(p,o?o:"",on))die("stdout");
    if(on)fwrite(o,1,on,stdout);free(o);
    if(rc)exit(rc<0?2:rc);
}
int main(int argc,char **argv){
    char root[4096],product[4400],bound[4400],tool[4400],toolbin[4400],ident[4400],material[4400],program[4400],wired[4400],wiredbin[4400],runtime[4400],link[4400],cases[4400],why[256];
    if(argc!=3||!realpath(argv[1],root)||argv[2][0]!='/'||mkdir(argv[2],0700))die("usage ROOT ABS_NEW_OUT");
    if(chdir(root))die("root");
    path(product,root,"unisacc.com");path(bound,root,"tools/bound");path(tool,root,"tools/ledger-material.cx");path(toolbin,argv[2],"ledger-material.native");path(ident,root,"seed/ident.c");
    path(material,argv[2],"material");path(program,material,"snapshot.cx");path(wired,argv[2],"snapshot-cx.cx");path(wiredbin,argv[2],"snapshot-cx.native");
    path(runtime,root,"cx/runtime");path(link,argv[2],"runtime");path(cases,argv[2],"cases");
    /* ledger-material measures the source identity itself (sh PRODUCT seed/ident.c -- ROOT, twice per call).
       The same command runs here beside the tool build only to fill the run cache; its result is not read. */
    char *identity[]={"sh",product,ident,"--",root,0};int warm=tq_warm_start(root,15,identity);
    if(tq_native(root,tool,toolbin,why,sizeof why))die(why);
    tq_warm_join(warm);
    char *prep[]={bound,"18",toolbin,root,material,"tests/cases/snapshot.cx",0};call(prep,20,argv[2],"prepare");
    if(symlink(runtime,link))die("module link");
    size_t n;char *s=cx_read(program,&n);if(!s)die("prepared fixture");
    const char *prefix="#pragma unisa use runtime.source_frame\n#define UNISA_CX_SOURCE_FRAME\n";
    FILE *f=fopen(wired,"wb");if(!f||fwrite(prefix,1,strlen(prefix),f)!=strlen(prefix)||fwrite(s,1,n,f)!=n||fclose(f))die("wired fixture");free(s);
    if(tq_native(root,wired,wiredbin,why,sizeof why))die(why);
    char *run[]={bound,"16",wiredbin,cases,0};call(run,18,argv[2],"execute");
    char *verify[]={bound,"18",toolbin,"--verify",root,material,"tests/cases/snapshot.cx",0};call(verify,20,argv[2],"verify");
    puts("SNAPSHOTS_CX\tscope=source-wired-CX-ledger-operations-linux-x86_64-not-installed-or-foreign");return 0;
}
