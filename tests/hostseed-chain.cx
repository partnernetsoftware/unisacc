/* ROOT HOST_CONTEXT MODELS PAYLOAD STAGE1 STAGE2 STAGE3 NEW_ABS_OUT.
 * Read-only chain verification plus actual byte comparisons; caller bound55.
 * Never constructs inputs or imports old PASS/N22/fixed-point receipts.
 * Fixed NN/P3 and packaged ASM kernels are declared binary trust inputs.
 */
#pragma unisa use cxlib.netpack
static char root[4096],work[4096],ctx[4096],models[4096],payload[4096],stages[3][4096],bound[4400],tool[4400],product[4400];
static int assertions,failures;static char watched[32][4400],identities[32][65];static int nwatched;
static void die(const char *s){fprintf(stderr,"hostseed-chain: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void join(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path bound");}
static void ck(int ok,const char *s){assertions++;if(!ok)failures++;printf("%s\thostseed-chain.%s\n",ok?"PASS":"FAIL",s);}
static char *load(const char *p,size_t *n){struct stat a,b;if(lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>134217728)die("bounded regular input");int fd=open(p,O_RDONLY|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK);if(fd<0||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)die("input descriptor");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("input extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||bad||closed)die("input changed");s[*n]=0;return s;}
static void hash(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void watch(const char *dir,const char *name){if(nwatched==32)die("watch capacity");join(watched[nwatched],dir,name);hash(watched[nwatched],identities[nwatched]);printf("INPUT\t%s\tsha256=%s\n",watched[nwatched],identities[nwatched]);nwatched++;}
static void save(const char *name,const char *s,size_t n){char p[4400];join(p,work,name);int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,0600);if(fd<0)die("exclusive evidence");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("evidence write");at+=(size_t)z;}if(close(fd))die("evidence close");}
static void verify(const char *label){if(unsetenv("UNISACC_RF_CAPTURE")||unsetenv("UNISA_ATTRIBUTES"))die("clear ambient resource state");char *v[]={bound,"20","sh",product,tool,"--","--verify-chain",root,ctx,models,payload,stages[0],stages[1],stages[2],0};char why[1024],name[100],status[40];np_result r;if(np_run(v,root,0,22,&r,why,sizeof why))die(why);snprintf(name,sizeof name,"%s.stdout",label);save(name,r.out,r.outn);snprintf(name,sizeof name,"%s.stderr",label);save(name,r.err,r.errn);int n=snprintf(status,sizeof status,"rc\t%d\n",r.rc);snprintf(name,sizeof name,"%s.status",label);save(name,status,(size_t)n);const char *expected="VERIFIED\thostseed-fixed-P3-chain\tstages=3\tno-N22-no-test-result\nNOT_CLAIMED\tindependent-initial-source-measurement-hermetic-host-build-NN-or-ASM-kernel-source-rebuild-complete-N22-or-foreign-hosts\n";int ok=!r.rc&&!r.errn&&r.outn==strlen(expected)&&!memcmp(r.out,expected,r.outn);ck(ok,label);if(!ok){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("complete source and parent receipts required");}np_free(&r);}
static void same(const char *a,const char *b,const char *name){size_t an,bn;char *av=load(a,&an),*bv=load(b,&bn);ck(an==bn&&!memcmp(av,bv,an),name);free(av);free(bv);}
static int within(const char *p,const char *base){size_t n=strlen(base);return !strncmp(p,base,n)&&(!p[n]||p[n]=='/');}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN hostseed-chain draft requires Linux/x86_64 host\n",stderr);return 3;
#endif
 if(argc!=9||!realpath(argv[1],root)||!realpath(argv[2],ctx)||!realpath(argv[3],models)||!realpath(argv[4],payload)||argv[8][0]!='/'||strlen(argv[8])>=sizeof work)die("usage ROOT HOST_CONTEXT MODELS PAYLOAD STAGE1 STAGE2 STAGE3 NEW_ABS_OUT");for(int i=0;i<3;i++)if(!realpath(argv[5+i],stages[i]))die("stage realpath");if(!strcmp(stages[0],stages[1])||!strcmp(stages[0],stages[2])||!strcmp(stages[1],stages[2]))die("three distinct generations required");char parent[4096],base[4096],leaf[4096];strcpy(parent,argv[8]);char *slash=strrchr(parent,'/');if(!slash||!slash[1]||!strcmp(slash+1,".")||!strcmp(slash+1,".."))die("output leaf");strcpy(leaf,slash+1);if(slash==parent)slash[1]=0;else *slash=0;if(!realpath(parent,base))die("output parent");int z=snprintf(work,sizeof work,"%s%s%s",base,!strcmp(base,"/")?"":"/",leaf);if(z<0||(size_t)z>=sizeof work||within(work,ctx)||within(work,stages[0])||within(work,stages[1])||within(work,stages[2]))die("output aliases input generation");if(mkdir(work,0700))die("new output required");join(bound,root,"tools/bound");join(tool,root,"tools/hostseed-step.cx");join(product,root,"unisacc.com");
 watch(root,"unisacc.com");watch(root,"tools/hostseed-step.cx");watch(root,"tests/hostseed-chain.cx");const char *context_files[]={"context.tsv","cc.version","identity-helper","HOST","host.tsv"};for(int i=0;i<5;i++)watch(ctx,context_files[i]);const char *files[]={"slice-win-x86_64","slice-lnx-x86_64","slice-lnx-arm64","slice-osx-x86_64","slice-osx-arm64","unisacc-seed.com"};for(int i=0;i<3;i++){watch(stages[i],"stage.tsv");for(int j=0;j<6;j++)watch(stages[i],files[j]);}/* 29 watched files; receipt bytes are independently revalidated twice. */
 char model_before[65],payload_before[65];hash(models,model_before);hash(payload,payload_before);verify("chain-before");for(int i=0;i<6;i++){char a[4400],b[4400],name[120];join(a,stages[1],files[i]);join(b,stages[2],files[i]);snprintf(name,sizeof name,"stage2-stage3.%s.exact-bytes",files[i]);same(a,b,name);}char final[4400];join(final,stages[2],"unisacc-seed.com");same(final,models,"stage3-is-declared-current-candidate");verify("chain-after");
 for(int i=0;i<nwatched;i++){char h[65],name[100];hash(watched[i],h);snprintf(name,sizeof name,"input-%d-unchanged",i);ck(!strcmp(h,identities[i]),name);}char after[65];hash(models,after);ck(!strcmp(after,model_before),"models-unchanged");hash(payload,after);ck(!strcmp(after,payload_before),"payload-unchanged");puts("NOT_CLAIMED\tindependent-initial-source-measurement-hermetic-host-build-NN-or-ASM-kernel-source-rebuild-complete-N22-or-foreign-hosts");puts("TIMING\tstartup_construction_loading_inference_output_validation_cold_hot=UNMEASURED");printf("HOSTSEED_CHAIN\tassertions=%d\tfailed=%d\tscope=fixed-P3-declared-kernel-three-generation-driver-lineage\n",assertions,failures);return failures?1:0;
}
