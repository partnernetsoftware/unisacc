/* p1.cx -- CX2a positive P1 (research/cx2-module-design.md 4): a .cx program that uses a module by name, with no
   include directive and no hand-written prototype.  `#pragma unisa use p1mod` adds tests/cx/p1mod.cx to the program and
   gives this unit the module's derived interface (CXIF): its typedef, enum and struct, and the prototypes of its
   non-static functions.  tests/cxmodcheck.cx runs it (and its cc oracle); stdout is the verdict. */
#pragma unisa use p1mod

static const int tab[2] = { 7, 7 };          /* p1mod.cx has a static tab too: no clash between units */
static int fails, checks;
static void check(int ok, const char *what) { checks++; if (!ok) { fails++; printf("FAIL %s\n", what); } }

int main(void) {
    p1_pair pr = p1_pair_make(3, 4);
    struct p1_box box;
    check(p1_radix(0) == 2 && p1_radix(1) == 3 && p1_radix(2) == -1, "radix");
    check(p1_lookup(0, 0) == 3 && p1_lookup(1, 2) == 9 && p1_lookup(2, 0) == -1, "lookup");
    check(pr.a == 3 && pr.b == 4, "struct by value across units");
    check(p1_pair_sum(&pr) == 7, "pointer to a module type");
    check(P1_RED == 0 && P1_BLUE == 2 && p1_colour_name(P1_BLUE)[0] == 'b', "enum constants");
    box.n = 5; check(p1_box_twice(&box) == 10, "tagged struct");
    check(tab[0] + tab[1] == 14, "own static");
    if (fails) return 1;
    printf("module reference ok (2 units, %d checks)\n", checks);
    return 0;
}
