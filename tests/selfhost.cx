/* Native rebuild equivalence: freshly produced objects, kernels, driver slices,
 * and full product. This is a two-generation fixed point, not three stages or
 * native execution on the foreign hosts. Run only after all construction steps.
 */
#pragma unisa use cxlib.rebuildcontext
static int assertions,failures;
static void die(const char *s){fprintf(stderr,"selfhost: %s\n",s);exit(2);}
static void path(char *p,size_t cap,const char *a,const char *b){int k=snprintf(p,cap,"%s/%s",a,b);if(k<0||(size_t)k>=cap)die("path");}
static char *load(const char *p,size_t *n){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>268435456)die(p);char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("read/size changed");return s;}
static void check(int ok,const char *label){assertions++;if(!ok)failures++;printf("%s\t%s\n",ok?"PASS":"FAIL",label);}
static void same(const char *a,const char *b,const char *label){size_t an,bn;char *av=load(a,&an),*bv=load(b,&bn);check(an==bn&&!memcmp(av,bv,an),label);free(av);free(bv);}
static void reads(const char *label,const rb_result *r){printf("READS\t%s\tlogical=%d\tphysical=%d\tretained_hits=%d\tretained_bytes=%lu\n",label,r->files,r->physical_reads,r->retained_hits,(unsigned long)r->retained_bytes);
 if(r->package_kind==2){printf("SOURCE_PACKAGE\t%s\tpackage_kind=source-package-v1\tproduct_context_schema=native-product-construction-v2\tsource_jobs=%d\tsource_models=%d\tsource_physical_reads=%d\tsource_elapsed_ns=%lld\n",label,r->source_jobs,r->source_models,r->source_physical_reads,r->source_elapsed_ns);printf("PACKAGE_EPOCH\t%s\tartifact=%s\trecord=%s\trecorded_source=%s\n",label,r->package_epoch_artifact,r->package_epoch_record,r->package_epoch_source);printf("BUILDER\t%s\traw=%s\trecord=%s\trecorded_source=%s\tkernel_context=%s\tproduct_context=%s\twitness=%s\n",label,r->bootstrap,r->builder_record,r->bootstrap_record_source,r->kernel_context,r->product_context,r->witness);}
 else printf("PACKAGE_KIND\t%s\tP7-refresh\tproduct_context_schema=native-product-construction-v1\n",label);
}
static void package_scope(const char *label,const rb_result *r){
 if(r->package_kind==2){printf("PACKAGE_SCOPE\t%s\tsource-package-complete-107-job-34-model-DAG-verified;model_inputs-is-flat-P7-path-count-only-not-source-DAG-count\n",label);printf("PROVENANCE_LIMIT\t%s\tv2-binds-builder-raw-and-record-and-package-epoch-raw-and-record;unsigned-consistency-not-historical-process-execution;P7-bootstrap-nonkernel-preservation-not-the-source-package-contract\n",label);}
 else{printf("NOT_REPRODUCED\t%s\toriginal-frozen-baseline-7f709-source-tree;actual-bootstrap-nonkernel-payload-preservation-is-checked-for-P7\n",label);printf("PROVENANCE_LIMIT\t%s\tunsigned-receipts-prove-consistency-not-historical-process-execution;product-context-v1-omits-bootstrap\n",label);}
}
static rb_result verify(const char *root,const char *gen,const char *pkg,const char *bootstrap,int current,const char *label){rb_result r;char why[1400];if(rb_verify(root,gen,pkg,bootstrap,current,&r,why,sizeof why)){fprintf(stderr,"selfhost: REFUSE %s %s\n",label,why);exit(2);}return r;}
int main(int argc,char **argv){if(argc!=6){fputs("usage: ROOT PRIOR_GENERATION PRIOR_PACKAGE FRESH_GENERATION FRESH_PACKAGE\n",stderr);return 2;}char root[4096],prior_gen[4096],prior_pkg[4096],fresh_gen[4096],fresh_pkg[4096],prior_bootstrap[4400],fresh_bootstrap[4400],a[4400],b[4400],rel[200],label[230];if(!realpath(argv[1],root)||!realpath(argv[2],prior_gen)||!realpath(argv[3],prior_pkg)||!realpath(argv[4],fresh_gen)||!realpath(argv[5],fresh_pkg))die("resolve explicit roots");if(!strcmp(prior_gen,fresh_gen))die("distinct generations required");path(prior_bootstrap,sizeof prior_bootstrap,prior_gen,"bootstrap-before-install.com");path(fresh_bootstrap,sizeof fresh_bootstrap,root,"unisacc.com");rb_result prior=verify(root,prior_gen,prior_pkg,prior_bootstrap,0,"prior"),fresh=verify(root,fresh_gen,fresh_pkg,fresh_bootstrap,1,"fresh");
 printf("PROVENANCE\tprior\tsource=%s\tbootstrap=%s\tproduct=%s\tpackage=%s\tmodel_inputs=%d\tfiles=%d\n",prior.source,prior.bootstrap,prior.product,prior.package,prior.model_inputs,prior.files);printf("PROVENANCE\tfresh\tsource=%s\tbootstrap=%s\tproduct=%s\tpackage=%s\tmodel_inputs=%d\tfiles=%d\tproduct_record=%s\tnative_install_receipt=%s\n",fresh.source,fresh.bootstrap,fresh.product,fresh.package,fresh.model_inputs,fresh.files,fresh.has_product_record?"PRESENT":"NOT_RECORDED",fresh.has_native?"PRESENT":"NOT_RECORDED");
 check(!strcmp(prior.source,fresh.source),"same-current-source-identity");check(!strcmp(fresh.bootstrap,fresh.root_product),"bootstrap-artifact-identity");
 const char *arch[]={"x86_64","arm64"};const char *units[]={"transition","arith","buffer","memory","intern","bytes","format","stack","action","run","bridge"};const char *ext[]={"s","o"};int i,j,k;for(i=0;i<2;i++){for(j=0;j<11;j++)for(k=0;k<2;k++){snprintf(rel,sizeof rel,"%s/%s.%s",arch[i],units[j],ext[k]);path(a,sizeof a,prior_gen,rel);path(b,sizeof b,fresh_gen,rel);snprintf(label,sizeof label,"rebuild.%s",rel);same(a,b,label);}snprintf(rel,sizeof rel,"%s.kernel",arch[i]);path(a,sizeof a,prior_gen,rel);path(b,sizeof b,fresh_gen,rel);same(a,b,rel);}
 const char *slices[]={"slice-win-x86_64","slice-lnx-x86_64","slice-lnx-arm64","slice-osx-x86_64","slice-osx-arm64"};for(i=0;i<5;i++){path(a,sizeof a,prior_gen,slices[i]);path(b,sizeof b,fresh_gen,slices[i]);same(a,b,slices[i]);}
 path(a,sizeof a,root,"unisacc.com");path(b,sizeof b,fresh_gen,"unisacc-next.com");same(a,b,"complete-product-fixed-point");rb_result prior_after=verify(root,prior_gen,prior_pkg,prior_bootstrap,0,"prior-after"),fresh_after=verify(root,fresh_gen,fresh_pkg,fresh_bootstrap,1,"fresh-after");check(!strcmp(prior.witness,prior_after.witness)&&!strcmp(fresh.witness,fresh_after.witness)&&!strcmp(prior.source,prior_after.source)&&!strcmp(fresh.source,fresh_after.source),"source-and-bootstrap-stable");
 reads("prior-before",&prior);reads("fresh-before",&fresh);reads("prior-after",&prior_after);reads("fresh-after",&fresh_after);
 check(!strcmp(prior.product,fresh.root_product),"prior-produced-current-root");check(!strcmp(prior.package,fresh.package),"same-prepared-package-identity");if(fresh.root_has_native)check(prior.has_native&&!strcmp(fresh.root_native,prior.native_receipt),"current-root-native-receipt-from-prior");else puts("NOT_RECORDED\tcurrent-root.native-construction-receipt");
 printf("NOT_REPRODUCED\tprior-bootstrap-historical-source\trecorded_source=%s\tcurrent_construction_source=%s\n",prior.bootstrap_record_source,prior.source);package_scope("prior",&prior);package_scope("fresh",&fresh);puts("NOT_CLAIMED\thost-seed-three-stage-N22-and-foreign-native-host-execution");puts("TIMING\tsource_snapshot_elapsed_ns=reported-per-endpoint;startup_source_identity_other_material_loading_output_validation_cold_hot=UNMEASURED");printf("SELFHOST\tassertions=%d\tfailed=%d\tscope=native-two-generation-artifact-fixed-point\n",assertions,failures);return failures?1:0;}
