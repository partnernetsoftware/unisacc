/* Pure-read aggregation of one tools/all-waves.cx session: ROOT SESSION (both canonical absolute).
 * Re-measures the live candidate, registry, source SID, harness trees and material fingerprints,
 * re-reads every receipt and saved stdout/stderr/status, re-derives each verdict and maps batches
 * to coverage rows.  It creates, changes and removes nothing.  rc 0 only for AGGREGATE QUALIFIED:
 * every IMPLEMENTED batch PASS in this session and zero unsatisfied or unresolved coverage rows.
 * rc 1 NOT_QUALIFIED (each reason named), rc 2 session refused. */
#pragma unisa use cxlib.allsession
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("all-aggregate: NOT_RUN requires Linux/x86_64\n",stderr);return 3;
#endif
 if(argc!=3){fputs("usage: ROOT SESSION\n",stderr);return 2;}
 return as_aggregate(argv[1],argv[2]);
}
