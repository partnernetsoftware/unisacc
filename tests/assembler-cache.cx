/* Private-copy tamper control: a changed executable must be rejected before
 * creating any object. No live generation input is mutated. */
#pragma unisa use cxlib.netpack
static void die(const char *s){fprintf(stderr,"assembler-cache: %s\n",s);exit(2);}
static void path(char *p,size_t cap,const char *a,const char *b){int n=snprintf(p,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path");}
static char *load(const char *p,size_t *n){char *s=cx_read(p,n);if(!s)die(p);return s;}
static void save(const char *p,const char *s,size_t n,int mode){int f=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC,mode);if(f<0)die("exclusive output");while(n){ssize_t k=write(f,s,n);if(k<0&&errno==EINTR)continue;if(k<=0)die("write");s+=k;n-=(size_t)k;}if(close(f))die("close");}
static void copy(const char *from,const char *to,const char *name,int mode){char a[4400],b[4400];size_t n;path(a,sizeof a,from,name);path(b,sizeof b,to,name);char *s=load(a,&n);save(b,s,n,mode);free(s);}
int main(int argc,char **argv){char root[4096],work[4096],p[4400],bound[4400],product[4400],tool[4400],why[1024];if(argc!=4||!realpath(argv[1],root)||argv[3][0]!='/'||strlen(argv[3])>=sizeof work)return 2;strcpy(work,argv[3]);if(mkdir(work,0700))die("new private directory");path(p,sizeof p,work,"assembler");if(mkdir(p,0700))die("assembler directory");path(p,sizeof p,work,"x86_64");if(mkdir(p,0700))die("source directory");
 const char *files[]={"identity-helper","identity-helper.sha256","context.sha256","assembler-native","assembler-native.tsv","assembler/assembler.cx","assembler/contracts.cx","assembler/material.tsv","x86_64-sources.tsv"};int i;for(i=0;i<9;i++)copy(argv[2],work,files[i],i==0||i==3?0700:0600);const char *units[]={"transition","arith","buffer","memory","intern","bytes","format","stack","action","run","bridge"};for(i=0;i<11;i++){char name[100];snprintf(name,sizeof name,"x86_64/%s.s",units[i]);copy(argv[2],work,name,0600);}
 path(p,sizeof p,work,"assembler-native");size_t n;char *bytes=load(p,&n);if(n<128)die("cache executable extent");int f=open(p,O_WRONLY|O_CLOEXEC);char changed=(char)(bytes[127]^1);free(bytes);if(f<0||lseek(f,127,SEEK_SET)!=127||write(f,&changed,1)!=1||close(f))die("damage private executable");path(bound,sizeof bound,root,"tools/bound");path(product,sizeof product,root,"unisacc.com");path(tool,sizeof tool,root,"tools/kernel-build.cx");char *v[]={bound,"40","sh",product,tool,"--",root,work,"assemble-x86_64",0};np_result r;if(np_run(v,root,0,45,&r,why,sizeof why))die(why);int refusal=r.rc==2&&strstr(r.err,"assembler cache source/artifact/context changed");printf("%s\tassembler-cache.executable-digest-refusal\n",refusal?"PASS":"FAIL");if(!refusal&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);int empty=1;for(i=0;i<11;i++){char name[100];struct stat st;snprintf(name,sizeof name,"x86_64/%s.o",units[i]);path(p,sizeof p,work,name);errno=0;if(lstat(p,&st)==0||errno!=ENOENT)empty=0;}printf("%s\tassembler-cache.no-object-created\n",empty?"PASS":"FAIL");printf("ASSEMBLER_CACHE\tassertions=2\tfailed=%d\tscope=private-executable-digest-negative-control\n",(!refusal)+(!empty));return refusal&&empty?0:1;}
