/* k6frozen.cx -- the K6 C references (seed/unisa_*.c) judged against frozen expected outputs (2026-10-23, unisa/
   detach W1-D; replaces the 20 tests/unisa*check.sh harnesses, which ran each reference next to its Python module).
   One generic point-sample runner, data per module: tests/k6/NAME.tsv holds the calls the old harness made of the
   compiled reference (argv, the input files and directories it opened, the stdin it read) with the rc, stdout, stderr
   and written files that the harness had just proven byte-equal to the Python side when it was captured (header of
   each table: capture method, harness verdict, sha256 identity of the Python modules and the C source at capture).
   No Python runs here: the reference side is frozen data, the C side is built and run every time.
   usage: sh ./tests/cxbin tests/k6frozen.cx NAME...       (NAME = a table under tests/k6/, e.g. bits, image-pe)
   Build: host `cc -std=c99 -O2 -w CCPRE... -o BIN SRC CCLIB...` (the old harnesses' command, 30 s bound).
   Each case runs in a fresh directory @ (made under $TMPDIR by mkdtemp, removed after the case and on every exit):
   inputs are written there at their recorded relative paths, the binary is moved to the recorded `bin` path (and back), `@/`
   at the start of an argument is that directory, stdin is the recorded bytes or /dev/null, 20 s bound; stdout,
   stderr and written files are compared after replacing the directory's absolute path with `@`.
   Table format (TAB-separated; values escape %, bytes outside 0x21..0x7e and a final space as %XX; an empty value is
   the key alone; `#` lines are comments):
     src PATH | bin RELPATH | ccpre FLAG | cclib FLAG        once, before the first case
     case N                                                  then, until `end`:
       arg VALUE                                             argv[0..] in order (argv[0] is @/BIN)
       dir RELPATH | file RELPATH VALUE | stdin VALUE        inputs
       rc N | out VALUE | outsha LEN SHA256 | err VALUE | errsha LEN SHA256
       wrote RELPATH VALUE | wrotesha RELPATH LEN SHA256     a file the call must have written
       same PATH                                             stdout must also equal this committed file (read-only)
   Output: one line per table, `k6 NAME: N cases equal ...`, rc 0.  First red stops: one `k6frozen: NAME case N
   (ARGS): ...` line, rc 1; a malformed table, a failed build or a scratch failure is rc 2. */
#pragma unisa use cxlib.pytempfile
#include <time.h>   /* time(): the per-call bound; cx.h edition 1 leaves time.h explicit */

#define PATHN 4096
typedef struct { char *p; size_t n, cap; } kbuf;
typedef struct { char *rel; char *v; size_t vn; int isdir; } kin;
typedef struct { char *rel; char *v; size_t vn; int sha; size_t len; } kwrote;
typedef struct {
    int id, rc, outsha, errsha, hasstdin;
    char **argv; int argc;
    kin *in; int nin;
    char *out; size_t outn; size_t outlen;
    char *err; size_t errn; size_t errlen;
    char *stdin_; size_t stdinn;
    kwrote *wr; int nwr;
    char **same; int nsame;
} kcase;

static char ROOT[PATHN], WD[PATHN], NAME[256];

static void cleanup(void) { if (WD[0]) { ptf_rmtree(WD); WD[0] = 0; } }
static void die(int rc, const char *fmt, const char *a, const char *b) {
    fflush(stdout);
    fprintf(stderr, "k6frozen: %s: ", NAME); fprintf(stderr, fmt, a ? a : "", b ? b : ""); fputc('\n', stderr);
    cleanup(); exit(rc);
}
static void *xrealloc(void *p, size_t n) { void *q = realloc(p, n ? n : 1); if (!q) die(2, "out of memory%s%s", 0, 0); return q; }
static char *xstrdup(const char *s) { size_t n = strlen(s); char *d = xrealloc(0, n + 1); memcpy(d, s, n + 1); return d; }
static void bput(kbuf *b, const char *s, size_t n) {
    if (b->n + n + 1 > b->cap) { size_t c = b->cap ? b->cap : 256; while (c < b->n + n + 1) c *= 2; b->p = xrealloc(b->p, c); b->cap = c; }
    if (n) memcpy(b->p + b->n, s, n);
    b->n += n; b->p[b->n] = 0;
}
static int hexv(int c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1; }
/* %XX unescape of S into a fresh buffer; -1 on a bad escape */
static int unesc(const char *s, char **out, size_t *outn) {
    kbuf b = { 0, 0, 0 }; size_t i, n = strlen(s);
    bput(&b, "", 0);
    for (i = 0; i < n; i++) {
        if (s[i] == '%') {
            int h, l;
            if (i + 2 >= n) return -1;
            h = hexv((unsigned char)s[i + 1]); l = h < 0 ? -1 : hexv((unsigned char)s[i + 2]);
            if (h < 0 || l < 0) return -1;
            { char c = (char)(h * 16 + l); bput(&b, &c, 1); }
            i += 2;
        } else bput(&b, s + i, 1);
    }
    *out = b.p; *outn = b.n;
    return 0;
}
/* printable excerpt of a value for a red line */
static char *show(const char *s, size_t n) {
    static char t[2][400]; static int k; char *o = t[k ^= 1]; size_t i, j = 0;
    for (i = 0; i < n && j + 8 < sizeof t[0]; i++) {
        unsigned c = (unsigned char)s[i];
        if (c >= 0x20 && c < 0x7f && c != '%') o[j++] = (char)c; else j += (size_t)snprintf(o + j, 8, "%%%02x", c);
    }
    if (i < n) { memcpy(o + j, "...", 3); j += 3; }
    o[j] = 0;
    return o;
}

/* ---- process: fork/exec with cwd, stdin file, stdout/stderr files, a time bound (SIGKILL after SECS); rc = exit status or 128+sig ---- */
static int spawn(char **argv, const char *cwd, const char *in, const char *out, const char *err, int secs) {
    pid_t pid; int st = 0;
    fflush(stdout); fflush(stderr);
    pid = fork();
    if (pid < 0) return -1;
    if (pid == 0) {
        int fi = open(in ? in : "/dev/null", O_RDONLY), fo = open(out, O_WRONLY | O_CREAT | O_TRUNC, 0600),
            fe = open(err, O_WRONLY | O_CREAT | O_TRUNC, 0600);
        if (fi < 0 || fo < 0 || fe < 0 || (cwd && chdir(cwd) != 0)) _exit(125);
        dup2(fi, 0); dup2(fo, 1); dup2(fe, 2); close(fi); close(fo); close(fe);
        execvp(argv[0], argv);
        _exit(126);
    }
    {
        time_t end = time(0) + secs;
        for (;;) {
            pid_t w = waitpid(pid, &st, WNOHANG);
            if (w == pid) break;
            if (w < 0) return -1;
            if (time(0) > end) { kill(pid, SIGKILL); waitpid(pid, &st, 0); break; }
            usleep(500);
        }
    }
    return WIFEXITED(st) ? WEXITSTATUS(st) : WIFSIGNALED(st) ? 128 + WTERMSIG(st) : -1;
}
static int mkdirs(const char *path) {     /* mkdir -p */
    char t[PATHN]; size_t i, n = strlen(path);
    if (n >= sizeof t) return -1;
    memcpy(t, path, n + 1);
    for (i = 1; i <= n; i++) {
        if (t[i] == '/' || t[i] == 0) {
            char c = t[i]; struct stat s;
            t[i] = 0;
            if (stat(t, &s) != 0) { if (mkdir(t, 0700) != 0) return -1; }
            else if (!S_ISDIR(s.st_mode)) return -1;
            t[i] = c;
        }
    }
    return 0;
}
static int safe_rel(const char *r) {      /* a recorded relative path stays inside the case directory */
    const char *p = r;
    if (!*r || r[0] == '/') return 0;
    while (*p) {
        if (p[0] == '.' && p[1] == '.' && (p[2] == '/' || p[2] == 0)) return 0;
        p = strchr(p, '/'); if (!p) break; p++;
    }
    return 1;
}
/* every occurrence of FROM in S replaced by TO */
static void normalise(const char *s, size_t n, const char *from, kbuf *o) {
    size_t i = 0, fl = strlen(from);
    o->n = 0; bput(o, "", 0);
    while (i < n) {
        if (fl && i + fl <= n && !memcmp(s + i, from, fl)) { bput(o, "@", 1); i += fl; }
        else { bput(o, s + i, 1); i++; }
    }
}
/* the got side of a red line: an excerpt, or the sha256 when the frozen side is a sha256 */
static const char *gotv(const kbuf *b, int sha) {
    static char hex[65];
    if (!sha) return show(b->p, b->n);
    cx_sha256_hex(b->p, b->n, hex);
    return hex;
}
static int same_blob(const char *got, size_t gn, int sha, const char *want, size_t wn, size_t wlen) {
    if (!sha) return gn == wn && !memcmp(got, want, gn);
    { char hex[65]; if (gn != wlen) return 0; cx_sha256_hex(got, gn, hex); return !strcmp(hex, want); }
}

/* ---- table ---------------------------------------------------------------------------------------------------- */
static char *SRC, *BIN; static char **CCPRE, **CCLIB; static int NPRE, NLIB;
static kcase *CASES; static int NCASE;

static void load(const char *path) {
    size_t n = 0, ln = 0; char *text = cx_read(path, &n), *line, *nl; kcase *c = 0;
    if (!text) die(2, "cannot read %s%s", path, 0);
    for (line = text; line < text + n; line = nl + 1) {
        char *key, *v1, *v2, *v3, lno[32];
        nl = memchr(line, '\n', (size_t)(text + n - line)); if (!nl) nl = text + n;
        *nl = 0; ln++;
        snprintf(lno, sizeof lno, "%zu", ln);
        if (!*line || line[0] == '#') continue;
        key = line; v1 = strchr(key, '\t'); v2 = v3 = 0;
        if (v1) { *v1++ = 0; v2 = strchr(v1, '\t'); if (v2) { *v2++ = 0; v3 = strchr(v2, '\t'); if (v3) *v3++ = 0; } }
#define NEED(cond) do { if (!(cond)) die(2, "malformed table line %s (%s)", lno, key); } while (0)
        if (!strcmp(key, "src")) { NEED(v1 && !c); SRC = xstrdup(v1); }
        else if (!strcmp(key, "bin")) { NEED(v1 && !c && safe_rel(v1)); BIN = xstrdup(v1); }
        else if (!strcmp(key, "ccpre")) { NEED(v1 && !c); CCPRE = xrealloc(CCPRE, (size_t)(NPRE + 1) * sizeof *CCPRE); CCPRE[NPRE++] = xstrdup(v1); }
        else if (!strcmp(key, "cclib")) { NEED(v1 && !c); CCLIB = xrealloc(CCLIB, (size_t)(NLIB + 1) * sizeof *CCLIB); CCLIB[NLIB++] = xstrdup(v1); }
        else if (!strcmp(key, "case")) {
            NEED(v1 && !c && SRC && BIN);
            CASES = xrealloc(CASES, (size_t)(NCASE + 1) * sizeof *CASES);
            c = &CASES[NCASE++]; memset(c, 0, sizeof *c); c->id = atoi(v1); c->rc = -1;
        } else if (!strcmp(key, "end")) { NEED(c && c->argc > 0 && c->rc >= 0 && c->out && c->err); c = 0; }
        else {
            NEED(c);
            if (!strcmp(key, "arg")) {
                char *v; size_t vn;
                NEED(unesc(v1 ? v1 : "", &v, &vn) == 0 && strlen(v) == vn);
                c->argv = xrealloc(c->argv, (size_t)(c->argc + 2) * sizeof *c->argv); c->argv[c->argc++] = v; c->argv[c->argc] = 0;
            } else if (!strcmp(key, "dir") || !strcmp(key, "file")) {
                kin *i; NEED(v1 && safe_rel(v1));
                c->in = xrealloc(c->in, (size_t)(c->nin + 1) * sizeof *c->in); i = &c->in[c->nin++];
                i->rel = xstrdup(v1); i->isdir = key[0] == 'd'; i->v = 0; i->vn = 0;
                if (!i->isdir) NEED(unesc(v2 ? v2 : "", &i->v, &i->vn) == 0);
            } else if (!strcmp(key, "stdin")) { NEED(!c->hasstdin && unesc(v1 ? v1 : "", &c->stdin_, &c->stdinn) == 0); c->hasstdin = 1; }
            else if (!strcmp(key, "rc")) { NEED(v1); c->rc = atoi(v1); }
            else if (!strcmp(key, "out")) { NEED(!c->out && unesc(v1 ? v1 : "", &c->out, &c->outn) == 0); }
            else if (!strcmp(key, "err")) { NEED(!c->err && unesc(v1 ? v1 : "", &c->err, &c->errn) == 0); }
            else if (!strcmp(key, "outsha")) { NEED(!c->out && v1 && v2 && strlen(v2) == 64); c->outsha = 1; c->outlen = (size_t)strtoul(v1, 0, 10); c->out = xstrdup(v2); }
            else if (!strcmp(key, "errsha")) { NEED(!c->err && v1 && v2 && strlen(v2) == 64); c->errsha = 1; c->errlen = (size_t)strtoul(v1, 0, 10); c->err = xstrdup(v2); }
            else if (!strcmp(key, "wrote") || !strcmp(key, "wrotesha")) {
                kwrote *w; NEED(v1 && safe_rel(v1));
                c->wr = xrealloc(c->wr, (size_t)(c->nwr + 1) * sizeof *c->wr); w = &c->wr[c->nwr++];
                w->rel = xstrdup(v1); w->sha = key[5] == 's'; w->len = 0; w->v = 0; w->vn = 0;
                if (w->sha) { NEED(v2 && v3 && strlen(v3) == 64); w->len = (size_t)strtoul(v2, 0, 10); w->v = xstrdup(v3); }
                else NEED(unesc(v2 ? v2 : "", &w->v, &w->vn) == 0);
            } else if (!strcmp(key, "same")) { NEED(v1); c->same = xrealloc(c->same, (size_t)(c->nsame + 1) * sizeof *c->same); c->same[c->nsame++] = xstrdup(v1); }
            else NEED(0);
        }
#undef NEED
    }
    if (c) die(2, "%s: last case has no end%s", path, 0);
    if (!NCASE) die(2, "%s: no cases%s", path, 0);
    free(text);
}

static char ARGS[1024];
static void red(const kcase *c, const char *what, const char *want, const char *got) {
    fflush(stdout);
    fprintf(stderr, "k6frozen: %s case %d (%s): %s differs: frozen '%s', got '%s'\n", NAME, c->id, ARGS, what, want, got);
    cleanup(); exit(1);
}

static void run_case(const kcase *c, const char *exe) {
    char cd[PATHN], p[PATHN * 2], fin[PATHN], fout[PATHN], ferr[PATHN], **av; int i, rc; size_t n;
    kbuf norm = { 0, 0, 0 }; char *got;
    ARGS[0] = 0;
    for (i = 1; i < c->argc; i++) {
        size_t l = strlen(ARGS);
        if (l + 4 < sizeof ARGS) snprintf(ARGS + l, sizeof ARGS - l, "%s%s", i > 1 ? " " : "", show(c->argv[i], strlen(c->argv[i])));
    }
    snprintf(cd, sizeof cd, "%s/c", WD);
    if (mkdirs(cd) != 0) die(2, "cannot create %s%s", cd, 0);
    snprintf(p, sizeof p, "%s/%s", cd, BIN);
    { char *s = strrchr(p, '/'); *s = 0; if (mkdirs(p) != 0) die(2, "cannot create %s%s", p, 0); *s = '/'; }
    if (rename(exe, p) != 0) die(2, "cannot move the reference to %s%s", p, 0);
    for (i = 0; i < c->nin; i++) {
        const kin *f = &c->in[i];
        snprintf(p, sizeof p, "%s/%s", cd, f->rel);
        if (f->isdir) { if (mkdirs(p) != 0) die(2, "cannot create %s%s", p, 0); continue; }
        { char *s = strrchr(p, '/'); *s = 0; if (mkdirs(p) != 0) die(2, "cannot create %s%s", p, 0); *s = '/'; }
        if (cx_write(p, f->v, f->vn) != 0) die(2, "cannot write %s%s", p, 0);
    }
    snprintf(fin, sizeof fin, "%s/stdin", WD); snprintf(fout, sizeof fout, "%s/stdout", WD); snprintf(ferr, sizeof ferr, "%s/stderr", WD);
    if (c->hasstdin && cx_write(fin, c->stdin_, c->stdinn) != 0) die(2, "cannot write %s%s", fin, 0);
    av = xrealloc(0, (size_t)(c->argc + 1) * sizeof *av);
    for (i = 0; i < c->argc; i++) {
        const char *a = c->argv[i];
        if (a[0] == '@' && (a[1] == '/' || a[1] == 0)) { av[i] = xrealloc(0, strlen(cd) + strlen(a) + 1); sprintf(av[i], "%s%s", cd, a + 1); }
        else av[i] = xstrdup(a);
    }
    av[c->argc] = 0;
    rc = spawn(av, cd, c->hasstdin ? fin : 0, fout, ferr, 20);
    snprintf(p, sizeof p, "%s/%s", cd, BIN);
    if (rename(p, exe) != 0) die(2, "cannot move the reference back from %s%s", p, 0);
    for (i = 0; i < c->argc; i++) free(av[i]);
    free(av);
    if (rc < 0 || rc == 125 || rc == 126) die(2, "cannot run the reference (%s)%s", ARGS, 0);
    if (rc != c->rc) { char w[16], g[16]; snprintf(w, sizeof w, "%d", c->rc); snprintf(g, sizeof g, "%d", rc); red(c, "rc", w, g); }
    got = cx_read(fout, &n); if (!got) die(2, "cannot read %s%s", fout, 0);
    normalise(got, n, cd, &norm); free(got);
    if (!same_blob(norm.p, norm.n, c->outsha, c->out, c->outn, c->outlen)) red(c, "stdout", c->outsha ? c->out : show(c->out, c->outn), gotv(&norm, c->outsha));
    for (i = 0; i < c->nsame; i++) {
        size_t m; char *want; snprintf(p, sizeof p, "%s/%s", ROOT, c->same[i]);
        if (!(want = cx_read(p, &m))) die(2, "cannot read %s%s", p, 0);
        if (m != norm.n || memcmp(want, norm.p, m)) red(c, "stdout against the committed snapshot", c->same[i], show(norm.p, norm.n));
        free(want);
    }
    got = cx_read(ferr, &n); if (!got) die(2, "cannot read %s%s", ferr, 0);
    normalise(got, n, cd, &norm); free(got);
    if (!same_blob(norm.p, norm.n, c->errsha, c->err, c->errn, c->errlen)) red(c, "stderr", c->errsha ? c->err : show(c->err, c->errn), gotv(&norm, c->errsha));
    for (i = 0; i < c->nwr; i++) {
        const kwrote *w = &c->wr[i];
        snprintf(p, sizeof p, "%s/%s", cd, w->rel);
        if (!(got = cx_read(p, &n))) red(c, w->rel, "written", "missing");
        normalise(got, n, cd, &norm); free(got);
        if (!same_blob(norm.p, norm.n, w->sha, w->v, w->vn, w->len)) red(c, w->rel, w->sha ? w->v : show(w->v, w->vn), gotv(&norm, w->sha));
    }
    free(norm.p);
    ptf_rmtree(cd);
}

static void run_table(const char *name) {
    char path[PATHN], exe[PATHN], src[PATHN], out[PATHN], err[PATHN], **av; int i, k = 0, rc;
    snprintf(NAME, sizeof NAME, "%s", name);
    for (i = 0; name[i]; i++) if (!((name[i] >= 'a' && name[i] <= 'z') || (name[i] >= '0' && name[i] <= '9') || name[i] == '-')) die(2, "bad table name%s%s", 0, 0);
    snprintf(path, sizeof path, "%s/tests/k6/%s.tsv", ROOT, name);
    SRC = BIN = 0; CCPRE = CCLIB = 0; NPRE = NLIB = 0; CASES = 0; NCASE = 0;
    load(path);
    if (ptf_mkdtemp(0, "unisacc-k6-", WD, sizeof WD) != 0) { WD[0] = 0; die(2, "cannot make a scratch directory%s%s", 0, 0); }
    snprintf(exe, sizeof exe, "%s/ref", WD); snprintf(src, sizeof src, "%s/%s", ROOT, SRC);
    snprintf(out, sizeof out, "%s/cc.out", WD); snprintf(err, sizeof err, "%s/cc.err", WD);
    av = xrealloc(0, (size_t)(NPRE + NLIB + 9) * sizeof *av);
    av[k++] = "cc"; av[k++] = "-std=c99"; av[k++] = "-O2"; av[k++] = "-w";
    for (i = 0; i < NPRE; i++) av[k++] = CCPRE[i];
    av[k++] = "-o"; av[k++] = exe; av[k++] = src;
    for (i = 0; i < NLIB; i++) av[k++] = CCLIB[i];
    av[k] = 0;
    rc = spawn(av, ROOT, 0, out, err, 30);
    free(av);
    if (rc != 0) {
        size_t n = 0; char *e = cx_read(err, &n);
        if (e && n) fwrite(e, 1, n, stderr);
        die(2, "compile red: %s%s", SRC, 0);
    }
    for (i = 0; i < NCASE; i++) run_case(&CASES[i], exe);
    printf("k6 %s: %d cases equal to the frozen reference (%s, tests/k6/%s.tsv)\n", name, NCASE, SRC, name);
    fflush(stdout);
    cleanup();
}

int main(int argc, char **argv) {
    char t[PATHN + 8]; int i;
    snprintf(NAME, sizeof NAME, "k6frozen");
    if (argc < 2) die(2, "usage: k6frozen.cx NAME... (tables under tests/k6/)%s%s", 0, 0);
    snprintf(t, sizeof t, "%s/../..", __FILE__);
    ptf_abspath(t, ROOT, sizeof ROOT);
    for (i = 1; i < argc; i++) run_table(argv[i]);
    return 0;
}
