#pragma unisa use text.text
/* Product regression for carried cx.h bounded formatting and path joining.
   Default trimming must retain both bodies; failures return the case number. */
int main(void) {
    char text[16], path[16], inplace[16] = "a/b", zero = 'Z';
    if (cx_fmt(text, sizeof text, "%s:%d", "ab", 7) || !tx_eqz(text, "ab:7")) return 1;
    if (cx_fmt(text, 4, "%s", "abcdef") != -1 || text[0]) return 2;
    if (cx_fmt(&zero, 0, "%d", 9) != -1 || zero != 'Z') return 3;
    if (cx_path_join(path, sizeof path, "a/b", "c.cx") || !tx_eqz(path, "a/b/c.cx")) return 4;
    if (cx_path_join(path, sizeof path, "a/b/", "c.cx") || !tx_eqz(path, "a/b/c.cx")) return 5;
    if (cx_path_join(path, 4, "a/b", "c.cx") != -1 || path[0]) return 6;
    if (cx_path_join(path, sizeof path, "a/b", "/bad") != -1 || path[0]) return 7;
    if (cx_path_join(path, sizeof path, "a/b", "") != -1 || path[0]) return 8;
    if (cx_path_join(inplace, sizeof inplace, inplace, "c.cx") || !tx_eqz(inplace, "a/b/c.cx")) return 9;
    puts("CX_BOUNDED_PASS");
    return 0;
}
