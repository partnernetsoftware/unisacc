#pragma unisa use text.text
/* outdep.cx -- a batch must not read leftovers under out/ (release qualification, 2026-11-05).
   A fresh clone has no out/.  An IMPLEMENTED batch whose entry source names an "out/..." path in
   a string literal depends on whatever an earlier run left there, so it passes here and fails in
   a clean clone (phase-pipe-single and cx-booter-ape both did after out/ was cleaned).  Materials
   belong in the batch's {out} argument or its materials column instead.
   For every IMPLEMENTED row of tests/batches.tsv the entry .cx is scanned for "out/ string
   literals (comments skipped); the count per batch is compared with tests/outdep.tsv, which only
   goes down.  A batch that creates and removes its own scratch directory still counts: the fix is
   to take that directory from {out}.
     sh ./unisacc.com -run tests/outdep.cx -- --check | --write */
/* --check --files PATH... selects IMPLEMENTED rows by entry source before reading
   it; changing tests/batches.tsv, the baseline, or this checker scans all rows. */
#define BASELINE "tests/outdep.tsv"
#define MAXR 1024

typedef struct { char id[128]; int count; int used; } Row;
static Row base[MAXR];
static int nbase;

/* "out/ occurrences that start a string literal, outside comments. */
static int count_out(const char *s, long n) {
    long i = 0; int c = 0;
    while (i < n) {
        if (s[i] == '/' && i + 1 < n && s[i + 1] == '*') { i += 2; while (i + 1 < n && !(s[i] == '*' && s[i + 1] == '/')) i++; i += 2; continue; }
        if (s[i] == '/' && i + 1 < n && s[i + 1] == '/') { while (i < n && s[i] != '\n') i++; continue; }
        if (s[i] == '\'') { i++; while (i < n && s[i] != '\'') { if (s[i] == '\\') i++; i++; } i++; continue; }
        if (s[i] == '"') {
            long j = i + 1;
            if ((j + 4 <= n && s[j] == 'o' && s[j + 1] == 'u' && s[j + 2] == 't' && s[j + 3] == '/') ||
                (j + 7 <= n && s[j] == '%' && s[j + 1] == 's' && s[j + 2] == '/' && s[j + 3] == 'o' && s[j + 4] == 'u' && s[j + 5] == 't' && s[j + 6] == '/') ||
                (j + 6 <= n && s[j] == '/' && s[j + 1] == 'h' && s[j + 2] == 'o' && s[j + 3] == 'm' && s[j + 4] == 'e' && s[j + 5] == '/') ||
                (j + 8 <= n && s[j] == '/' && s[j + 1] == 't' && s[j + 2] == 'm' && s[j + 3] == 'p' && s[j + 4] == '/' && s[j + 5] == '.' && s[j + 6] == '.' && s[j + 7] == '/'))
                c++;   /* "out/...", "%s/out/...", and absolute "/home/..." or "/tmp/../..." paths (one checkout only) */
            while (j < n && s[j] != '"') { if (s[j] == '\\') j++; j++; }
            i = j + 1; continue;
        }
        i++;
    }
    return c;
}

static int self_check(void) {
    static const char t[] = "/* \"out/a\" */ // \"out/b\"\nchar *a=\"out/c\", *b=\"x/out/d\", *c=\"%s/out/e\"; char q='\"'; char *d=\"out/f\";";
    return count_out(t, (long)sizeof t - 1) == 3;
}

static int load_baseline(void) {
    size_t n, i = 0; char *b = cx_read(BASELINE, &n);
    if (!b) { fprintf(stderr, "outdep: cannot read %s (run --write once)\n", BASELINE); return -1; }
    while (i < n) {
        size_t e = i; while (e < n && b[e] != '\n') e++;
        if (e > i && b[i] != '#') {
            size_t t = i; long v = 0;
            while (t < e && b[t] != '\t') t++;
            if (t == e || t - i >= 128 || nbase == MAXR) { fprintf(stderr, "outdep: bad row\n"); free(b); return -1; }
            { size_t k; for (k = i; k < t; k++) base[nbase].id[k - i] = b[k]; base[nbase].id[t - i] = 0;
              for (k = t + 1; k < e && b[k] >= '0' && b[k] <= '9'; k++) v = v * 10 + (b[k] - '0'); }
            base[nbase].count = (int)v; nbase++;
        }
        i = e + 1;
    }
    free(b); return 0;
}

int main(int argc, char **argv) {
    size_t tn; char *tsv; long at = 0; int check, batches = 0, total = 0, over = 0, under = 0, base_total = 0, k;
    char *out = 0; size_t olen = 0, ocap = 0;
    int scoped = argc >= 4 && tx_eqz(argv[1], "--check") && tx_eqz(argv[2], "--files"), full = !scoped;
    if (!scoped && (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write")))) {
        fprintf(stderr, "usage: outdep.cx --check [--files PATH...] | --write\n"); return 2;
    }
    /* Missing old paths from deletion/rename require the original full discovery. */
    for (k = 3; scoped && k < argc; k++) if (access(argv[k], F_OK) || tx_eqz(argv[k], "tests/batches.tsv") || tx_eqz(argv[k], BASELINE) || tx_eqz(argv[k], "tests/outdep.cx")) full = 1;
    if (!self_check()) { fprintf(stderr, "outdep: self-check failed\n"); return 2; }
    check = tx_eqz(argv[1], "--check");
    if (check && load_baseline() < 0) return 2;
    tsv = cx_read("tests/batches.tsv", &tn);
    if (!tsv) { fprintf(stderr, "outdep: cannot read tests/batches.tsv\n"); return 2; }
    if (!check) {
        static const char head[] = "# tests/outdep.tsv -- written by tests/outdep.cx --write.\n"
                                   "# IMPLEMENTED batches whose entry source names \"out/... in a string literal (a leftover a fresh clone lacks).\n"
                                   "# Counts only go down; materials belong in {out} or the materials column. A missing row is held at 0.\n# batch\tcount\n";
        out = malloc(ocap = sizeof head + 64 * 1024); if (!out) return 2;
        for (olen = 0; head[olen]; olen++) out[olen] = head[olen];
    }
    while (at < (long)tn) {
        long e = at; char f[13][512]; int nf = 0; long s = at;
        while (e < (long)tn && tsv[e] != '\n') e++;
        while (s <= e && nf < 13) {
            long q = s; int w = 0;
            while (q < e && tsv[q] != '\t') { if (w < 511) f[nf][w++] = tsv[q]; q++; }
            f[nf][w] = 0; nf++; s = q + 1;
        }
        at = e + 1;
        if (nf < 9 || !tx_eqz(f[1], "IMPLEMENTED")) continue;
        if (!full) { int selected = 0; for (k = 3; k < argc; k++) if (tx_eqz(f[8], argv[k])) selected = 1; if (!selected) continue; }
        {   size_t n; char *src = cx_read(f[8], &n); int c;
            if (!src) continue;
            c = count_out(src, (long)n); free(src);
            batches++; total += c;
            if (check) {
                Row *r = 0; int q;
                for (q = 0; q < nbase; q++) if (tx_eqz(base[q].id, f[0])) r = &base[q];
                if (r) r->used = 1;
                if (c > (r ? r->count : 0)) { printf("outdep: %s has %d out/ literals in %s, baseline %d\n", f[0], c, f[8], r ? r->count : 0); over++; }
                else if (r && c < r->count) under++;
            } else if (c > 0) {
                char line[200]; int w = 0;
                if (cx_fmt(line, sizeof line, "%s\t%d\n", f[0], c) || olen + sizeof line >= ocap) return 2;
                while (line[w]) out[olen++] = line[w++];
            }
        }
    }
    free(tsv);
    if (!check) {
        if (cx_write(BASELINE, out, olen)) { fprintf(stderr, "outdep: cannot write %s\n", BASELINE); return 2; }
        printf("outdep: wrote %s: %d batches, %d out/ literals\n", BASELINE, batches, total);
        return 0;
    }
    for (k = 0; k < nbase; k++) if (full || base[k].used) base_total += base[k].count;
    printf("outdep: %s: %d batches, %d out/ literals (baseline %d); %d above baseline, %d below (--write ratchets down)\n",
           over ? "FAIL" : "ok", batches, total, base_total, over, under);
    return over ? 1 : 0;
}
