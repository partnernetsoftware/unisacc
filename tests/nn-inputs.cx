/* ROOT SNAPSHOT_ROOT TRUSTED_READER. Linux/x86_64 LP64, outer55 unchanged.
 * Two actual complete ni_compare calls (initial and recovery), no tree cloning,
 * baseline writes, model construction, cached verdicts or host compilation.
 * Finite independent gold: complete libneed table SHA aea129...,10 Cdeps,
 * six ordered headers,two native table calls,internal native reads UNMEASURED.
 * ni_result exposes aggregate current/origin reads, not four separate endpoint
 * counters: check mirrored two-scan accounting and repeated real-call counts,
 * without inventing private per-endpoint observations. Current/origin include
 * body identities must remain distinct. This is necessary-input applicability,
 * not NN inference, model adoption, full PP equivalence or product qualification.
 */
#pragma unisa use sys.env
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.nninputs
#pragma unisa use cxlib.mixedprofiles
#pragma unisa use cxlib.libneedheaders
#pragma unisa use text.text
static int nit_assertions,nit_failures;
static const char *nit_table="aea1293b96da78c6a0cfaf0354e47e840d414de41bdea735bead30d736c8c853";
static void nit_die(const char *s){fprintf(stderr,"nn-inputs-test: %s errno=%d\n",s,errno);exit(2);}
static void nit_check(int ok,const char *label){nit_assertions++;if(!ok)nit_failures++;printf("%s\t%s\n",ok?"PASS":"FAIL",label);}
static void nit_part(int ok,const char *label,const char *part){char b[200];int n=snprintf(b,sizeof b,"%s.%s",label,part);if(n<0||(size_t)n>=sizeof b)nit_die("check-label-bound");nit_check(ok,b);}
static int nit_bytes(const void *p,size_t n,unsigned char value){const unsigned char *s=p;for(size_t i=0;i<n;i++)if(s[i]!=value)return 0;return 1;}
static int nit_hex(const char *s){for(int i=0;i<64;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;return s[64]==0;}
static long long nit_ns(void){struct timespec t={0};long rc=__syscall6(228,1,(long)&t,0,0,0);if(rc||t.tv_sec<0||t.tv_nsec<0||t.tv_nsec>=1000000000L||(unsigned long long)t.tv_sec>(unsigned long long)(LLONG_MAX-t.tv_nsec)/1000000000ULL)nit_die("monotonic-clock");return (long long)t.tv_sec*1000000000LL+t.tv_nsec;}
static int nit_fds(void){
    DIR *d=opendir("/proc/self/fd");if(!d)nit_die("fd-observer-open");int n=0;
    for(;;){errno=0;struct dirent *e=readdir(d);if(!e){int saved=errno,rc=closedir(d);if(saved||rc)nit_die("fd-observer-read-or-close");return n;}
        if(tx_eqz(e->d_name, ".")||tx_eqz(e->d_name, ".."))continue;
        for(const char *p=e->d_name;*p;p++)if(*p<'0'||*p>'9'){closedir(d);nit_die("fd-observer-nonnumeric-entry");}
        if(++n>4096){closedir(d);nit_die("fd-observer-bound");}}
}
static char *nit_load(const char *p,size_t *bytes){
    struct stat a,b;if(lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)nit_die("bounded-regular-input");
    int fd=open(p,O_RDONLY|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK);if(fd<0)nit_die("input-open");
    if(fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode){close(fd);nit_die("input-descriptor");}
    size_t n=(size_t)a.st_size,at=0;char *s=malloc(n+1);if(!s){close(fd);nit_die("allocation");}int bad=0;
    while(at<n){ssize_t k=read(fd,s+at,n-at);if(k<0&&errno==EINTR)continue;if(k<=0){bad=1;break;}at+=(size_t)k;}
    char extra;ssize_t k;do{k=read(fd,&extra,1);}while(k<0&&errno==EINTR);
    if(k||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode)bad=1;
    if(close(fd))bad=1;if(bad){free(s);nit_die("input-extent-identity-or-close");}s[n]=0;*bytes=n;return s;
}
static void nit_digest(const char *p,char h[65]){size_t n;char *s=nit_load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static int nit_elf64(const char *s,size_t n){return n>=64&&!memcmp(s,"\177ELF",4)&&(unsigned char)s[4]==2&&(unsigned char)s[5]==1&&(unsigned char)s[18]==62&&s[19]==0;}
static void nit_prepare_unknown(const char *root_arg,const char *reader,const char *reader_sha,const char *wrong,char path[4400],char sha[65]){
    /* All fixture writes end before the first ni_compare. The append preserves
     * every original ELF byte and its first64-byte prefix. Mode0400 prevents
     * accidental execution even if a broken validator tried to accept it. */
    size_t n;char *s=nit_load(wrong,&n);int root_shape=nit_elf64(s,n);free(s);
    nit_check(!root_shape,"wrong-root-reader.independent-non-ELF64-prefix-premise");if(root_shape)nit_die("wrong-root-reader-fixture-is-ELF64");
    s=nit_load(reader,&n);int source_shape=nit_elf64(s,n);nit_check(source_shape,"trusted-reader.independent-ELF64-little-endian-x64-prefix-premise");
    if(!source_shape||n>=16777216){free(s);nit_die("trusted-reader-fixture-shape-or-append-bound");}
    char original[65];cx_sha256_hex(s,n,original);if(!tx_eqz(original, reader_sha)){free(s);nit_die("trusted-reader-changed-before-fixture-preparation");}
    int z=snprintf(path,4400,"%s/nn-inputs-unknown-XXXXXX",sy_tmpdir());if(z<0||z>=4400||strlen(path)>700){free(s);nit_die("unknown-reader-path-bound");}
    int fd=mkstemp(path);if(fd<0){free(s);nit_die("private-unknown-reader-mkstemp");}
    size_t at=0;int bad=0;while(at<n){ssize_t w=write(fd,s+at,n-at);if(w<0&&errno==EINTR)continue;if(w<=0||(size_t)w>n-at){bad=1;break;}at+=(size_t)w;}
    unsigned char extra=0xa5;ssize_t w;if(!bad){do{w=write(fd,&extra,1);}while(w<0&&errno==EINTR);if(w!=1)bad=1;}
    if(!bad&&fsync(fd))bad=1;if(close(fd))bad=1;if(bad){free(s);nit_die("unknown-reader-write-sync-close");}
    if(chmod(path,0400)){free(s);nit_die("unknown-reader-freeze-mode");}
    size_t cloned_n;char *cloned=nit_load(path,&cloned_n);int shape=nit_elf64(cloned,cloned_n);
    nit_check(shape&&cloned_n>=64&&!memcmp(cloned,s,64),"unknown-reader.ELF64-prefix-remains-valid-and-identical");
    int exact=cloned_n==n+1&&!memcmp(cloned,s,n)&&(unsigned char)cloned[n]==extra;
    nit_check(exact,"unknown-reader.exact-original-full-ELF-plus-one-byte");
    cx_sha256_hex(cloned,cloned_n,sha);nit_check(strcmp(sha,reader_sha)!=0,"unknown-reader.actual-SHA-differs-from-trusted-reader");
    struct stat st;int frozen=!lstat(path,&st)&&S_ISREG(st.st_mode)&&(st.st_mode&07777)==0400;
    nit_check(frozen,"unknown-reader.frozen-private-nonexecutable-fixture-before-API-batch");
    free(cloned);free(s);if(!shape||!exact||!frozen||tx_eqz(sha, reader_sha))nit_die("unknown-reader-fixture-preconditions");
    printf("FIXTURE\tunknown-reader=%s\tsha256=%s\tmode=0400\tnever-executed\n",path,sha);
}
static int nit_reason(const char *why,const char *reason,const char *path){
    char prefix[1000];int n=snprintf(prefix,sizeof prefix,"%s path=%s errno=",reason,path);
    if(n<0||(size_t)n>=sizeof prefix||strncmp(why,prefix,(size_t)n))return 0;
    const char *p=why+n;if(*p=='-')p++;const char *digits=p;while(*p>='0'&&*p<='9')p++;return p!=digits&&!*p;
}
static void nit_negative(const char *root_arg,const char *origin,const char *reader,int no_out,int zero_cap,const char *label,const char *reason,const char *error_path){
    ni_result r;char why[1400];memset(&r,0xa5,sizeof r);memset(why,0xa5,sizeof why);
    int rc=ni_compare(root_arg,origin,reader,no_out?0:&r,why,zero_cap?0:sizeof why);
    nit_part(rc==-1,label,"explicit-refusal");
    if(zero_cap)nit_part(nit_bytes(why,sizeof why,0xa5),label,"zero-cap-reason-buffer-untouched");
    else{int terminated=memchr(why,0,sizeof why)!=0;nit_part(terminated&&(error_path?nit_reason(why,reason,error_path):tx_eqz(why, reason)),label,"exact-reason-and-path");if(terminated)printf("REFUSAL\t%s\t%s\n",label,why);}
    if(no_out)nit_part(nit_bytes(&r,sizeof r,0xa5),label,"no-result-destination-does-not-write-local-canary");
    else nit_part(nit_bytes(&r,sizeof r,0),label,"entire-A5-result-cleared-including-padding");
}
static int nit_phase_accounting(const ni_result *r){
    const long long phases[]={r->setup_ns,r->support_before_ns,r->support_after_ns,r->order_ns,r->current_before_ns,r->origin_before_ns,r->data_compare_ns,r->native_current_ns,r->native_origin_ns,r->native_compare_ns,r->current_after_ns,r->origin_after_ns,r->stability_compare_ns,r->finalhash_ns};
    long long sum=0;for(int i=0;i<14;i++){if(phases[i]<0||sum>LLONG_MAX-phases[i])return 0;sum+=phases[i];}
    return sum==r->elapsed_ns&&r->support_ns==r->support_before_ns+r->support_after_ns&&r->elapsed_ns>0&&r->native_current_ns>0&&r->native_origin_ns>0&&r->current_before_ns>0&&r->origin_before_ns>0&&r->current_after_ns>0&&r->origin_after_ns>0;
}
static ni_result nit_positive(const char *root_arg,const char *origin,const char *reader,const char *reader_sha,const char *module_sha,const char *label){
    ni_result r;char why[1400]={0};memset(&r,0xa5,sizeof r);long long begin=nit_ns();
    int rc=ni_compare(root_arg,origin,reader,&r,why,sizeof why);long long end=nit_ns();nit_part(rc==0,label,"actual-complete-compare-success");
    if(rc){if(memchr(why,0,sizeof why))fprintf(stderr,"NI_REFUSE\t%s\n",why);nit_die("positive-compare");}
    nit_part(!why[0],label,"empty-success-reason");
    nit_part(r.ctor_files==10&&r.ordered_headers==6&&r.native_table_calls==2&&r.native_internal_reads==-1,label,"complete-declared-input-domains-and-unmeasured-native-reads");
    const char *hashes[]={r.witness,r.data,r.ctor_cdeps,r.current_include,r.origin_include,r.libneed,r.autoinc_full,r.autoinc_facts,r.native_artifact,r.native_C_source,r.verifier,r.netpack,r.kernelsha,r.runtime_support};
    const char *names[]={"witness","data","Cdeps","current-include","origin-include","libneed","full-projection","facts-projection","reader-artifact","reader-source","NI-module","netpack","kernelsha","runtime-support"};
    int all_hex=1;for(int i=0;i<14;i++){char part[100];snprintf(part,sizeof part,"complete-lowerhex-identity.%s",names[i]);int valid=nit_hex(hashes[i]);nit_part(valid,label,part);if(!valid)all_hex=0;}
    if(!all_hex)nit_die("noncanonical-success-identity-fields");
    nit_part(r.physical_reads>0&&(long long)r.physical_reads==(long long)r.current_reads+r.origin_reads+r.support_reads,label,"witness-and-actual-read-accounting");
    nit_part(r.current_reads>0&&r.origin_reads>0&&r.support_reads>0&&r.current_reads==r.origin_reads&&!(r.current_reads%2)&&!(r.origin_reads%2),label,"mirrored-two-endpoint-per-root-read-accounting");
    nit_part(strcmp(r.current_include,r.origin_include)!=0,label,"different-header-bodies-remain-distinct-input-identities");
    nit_part(tx_eqz(r.libneed, nit_table),label,"complete-libneed-table-independent-literal-gold");
    nit_part(tx_eqz(r.native_artifact, reader_sha),label,"actual-reader-file-identity");
    nit_part(tx_eqz(r.verifier, module_sha),label,"actual-current-NI-module-identity");
    nit_part(r.data_files>0&&r.data_dirs>0&&r.data_symlinks>=0,label,"complete-observed-tree-domain");
    nit_part(r.full_triggers>r.facts_triggers&&r.facts_triggers>0&&strcmp(r.autoinc_full,r.autoinc_facts)!=0,label,"printf-projections-remain-independent-ordered-domains");
    nit_part(begin>=0&&end>=begin,label,"monotonic-observation-timing");nit_part(nit_phase_accounting(&r),label,"nonoverlapping-phase-accounting");
    printf("NI\t%s\twitness=%s\tdata=%s\tCdeps=%s\tcurrent_include=%s\torigin_include=%s\tlibneed=%s\tfull=%s\tfacts=%s\treads=%d\tcurrent=%d\torigin=%d\tsupport=%d\tnative_calls=%d\tnative_internal_reads=UNMEASURED\tcaller_elapsed_ns=%lld\n",label,r.witness,r.data,r.ctor_cdeps,r.current_include,r.origin_include,r.libneed,r.autoinc_full,r.autoinc_facts,r.physical_reads,r.current_reads,r.origin_reads,r.support_reads,r.native_table_calls,end-begin);
    printf("PHASE_NS\t%s\treader=%lld\tsetup=%lld\tsupport_before=%lld\tsupport_after=%lld\tsupport=%lld\torder=%lld\tcurrent_before=%lld\torigin_before=%lld\tcompare=%lld\tnative_current=%lld\tnative_origin=%lld\tnative_compare=%lld\tcurrent_after=%lld\torigin_after=%lld\tstability=%lld\tfinalhash=%lld\n",label,r.elapsed_ns,r.setup_ns,r.support_before_ns,r.support_after_ns,r.support_ns,r.order_ns,r.current_before_ns,r.origin_before_ns,r.data_compare_ns,r.native_current_ns,r.native_origin_ns,r.native_compare_ns,r.current_after_ns,r.origin_after_ns,r.stability_compare_ns,r.finalhash_ns);
    return r;
}
static void nit_stable(const ni_result *a,const ni_result *b){
    const char *av[]={a->witness,a->data,a->ctor_cdeps,a->current_include,a->origin_include,a->libneed,a->autoinc_full,a->autoinc_facts,a->native_artifact,a->native_C_source,a->verifier,a->netpack,a->kernelsha,a->runtime_support};
    const char *bv[]={b->witness,b->data,b->ctor_cdeps,b->current_include,b->origin_include,b->libneed,b->autoinc_full,b->autoinc_facts,b->native_artifact,b->native_C_source,b->verifier,b->netpack,b->kernelsha,b->runtime_support};
    const char *names[]={"witness","data","Cdeps","current-include","origin-include","libneed","full-projection","facts-projection","reader-artifact","reader-source","NI-module","netpack","kernelsha","runtime-support"};
    for(int i=0;i<14;i++)nit_part(tx_eqz(av[i], bv[i]),"recovery-stable-identity-excluding-timing",names[i]);
    nit_check(a->data_files==b->data_files&&a->data_dirs==b->data_dirs&&a->data_symlinks==b->data_symlinks&&a->ctor_files==b->ctor_files&&a->ordered_headers==b->ordered_headers&&a->full_triggers==b->full_triggers&&a->facts_triggers==b->facts_triggers,"recovery-all-logical-domain-counts-stable");
    nit_check(a->physical_reads==b->physical_reads&&a->current_reads==b->current_reads&&a->origin_reads==b->origin_reads&&a->support_reads==b->support_reads&&a->native_table_calls==b->native_table_calls&&a->native_internal_reads==b->native_internal_reads,"recovery-all-actual-read-counts-stable-without-timing-equality");
}
/* Separate actual cache lane: --cache-v2 ROOT ORIGIN MATERIAL FAST REFERENCE.
 * Only invocation-private copies are changed; pinned originals stay intact. */
static void nit_cache_write(const char *p,const void *s,size_t n,int mode){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,mode);if(fd<0)nit_die("cache-fixture-exclusive-create");size_t at=0;while(at<n){ssize_t z=write(fd,(const char *)s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)nit_die("cache-fixture-write");at+=(size_t)z;}if(close(fd))nit_die("cache-fixture-close");}
static int nit_cache_lane(char **argv){
 char root[4096],origin[4096],material[4096],fast[4096],reference[4096];if(!realpath(argv[2],root)||!realpath(argv[3],origin)||!realpath(argv[4],material)||!realpath(argv[5],fast)||!realpath(argv[6],reference))nit_die("cache-lane-realpaths");
 char dir[]="/tmp/unisacc-ni-cache-v2-XXXXXX";if(!mkdtemp(dir))nit_die("cache-lane-mkdtemp");char reader[4400],profile[4400];if(snprintf(reader,sizeof reader,"%s/reader",dir)>=(int)sizeof reader||snprintf(profile,sizeof profile,"%s.source-packages-v2.cache.tsv",reader)>=(int)sizeof profile)nit_die("cache-lane-path");size_t bytes;char *elf=nit_load(fast,&bytes);nit_cache_write(reader,elf,bytes,0700);free(elf);
 ni_result legacy={0},result={0};char why[1400];if(ni_compare(root,origin,reference,&legacy,why,sizeof why))nit_die(why);np_buf valid={0};if(ni_fast_profile_text(root,origin,material,reader,reference,legacy.current_include,&valid,why,sizeof why))nit_die(why);
 const char *old="libneed-native-code-cache-v1\n";nit_cache_write(profile,old,strlen(old),0600);int rc=ni_compare(root,origin,reader,&result,why,sizeof why);nit_check(rc==-1&&strstr(why,"legacy-or-wrong-code-cache-schema-refused"),"cache-v2.old-schema-refused-by-real-consumer");if(unlink(profile))nit_die("cache-fixture-unlink");
 const char *required[]={"identity-schema\t","current-necessary-source-inputs-sha256\t","origin-necessary-source-inputs-sha256\t","execution-key-sha256\t"};for(int i=0;i<4;i++){char *a=strstr(valid.p,required[i]),*end=a?strchr(a,'\n'):0;if(!a||!end)nit_die("cache-schema-field-required");np_buf missing={0};np_put(&missing,valid.p,(size_t)(a-valid.p));np_put(&missing,end+1,valid.n-(size_t)(end+1-valid.p));nit_cache_write(profile,missing.p,missing.n,0600);free(missing.p);rc=ni_compare(root,origin,reader,&result,why,sizeof why);nit_part(rc==-1&&strstr(why,"code-profile-unique-field"),"cache-v2.missing-field-refused-by-real-consumer",required[i]);if(unlink(profile))nit_die("cache-fixture-unlink");}
 nit_cache_write(profile,valid.p,valid.n,0600);rc=ni_compare(root,origin,reader,&result,why,sizeof why);nit_check(!rc&&result.native_source_kind==2&&result.native_table_calls==2&&nit_hex(result.native_profile),"cache-v2.rebuilt-profile-adopted-by-real-consumer");free(valid.p);if(unlink(profile)||unlink(reader)||rmdir(dir))nit_die("cache-fixture-cleanup");printf("NN_CACHE_V2\tassertions=%d\tfailed=%d\n",nit_assertions,nit_failures);return nit_failures?1:0;
}
/* Synthetic closed input roots exercise the real complete reader twice.
 * They are unit fixtures, not fresh source-SID/origin-DAG/NN qualification. */
static void nic_path(char out[4600],const char *base,const char *leaf){if(cx_fmt(out,4600,"%s/%s",base,leaf))nit_die("current-fixture-path");}
static void nic_save(const char *p,const char *text){nit_cache_write(p,text,strlen(text),0600);}
static void nic_copy(const char *source,const char *dest,int mode){size_t n;char *s=nit_load(source,&n);nit_cache_write(dest,s,n,mode);free(s);}
static void nic_dir(const char *base,const char *leaf){char p[4600];nic_path(p,base,leaf);if(mkdir(p,0700))nit_die("current-fixture-directory");}
static const char *nic_a="static int helper(void) { return 1; }\nstatic void exit(int n) { helper(); }\nstatic int printf(const char *fmt, ...) { return 0; }\n";
static const char *nic_b="__UNISA_LIBC_LINKAGE void _unisa_environ_init(void) { helper(); }\n";
static const char *nic_ob="__UNISA_LIBC_LINKAGE void _unisa_environ_init(void) { helper(); /* origin */ }\n";
static const char *nic_gen="#include \"json.h\"\n#include \"facts.h\"\n";
static const char *nic_gold="NAMES _unisa_environ_init exit helper printf\nKEY _unisa_environ_init _unisa_environ_init helper\nKEY exit exit helper\nKEY helper helper\nKEY printf printf\nROOTS_CLOSURE _unisa_environ_init exit helper\n";
static void nic_fixture(const char *actual,const char *dir,int origin){
 if(mkdir(dir,0700))nit_die("new-current-fixture");
 const char *dirs[]={"tools","tools/cxlib","seed","exec","exec/facts","exec/c","src","weights","include"};for(int i=0;i<9;i++)nic_dir(dir,dirs[i]);
 char p[4600],s[4600];const char *support[]={"tools/cxlib/nninputs.cx","tools/cxlib/netpack.cx","tools/cxlib/kernelsha.cx","tools/bound","tools/bound.c","seed/unisa_libneed.c","tools/libneed-native-profile.cx"};
 for(int i=0;i<7;i++){nic_path(s,actual,support[i]);nic_path(p,dir,support[i]);nic_copy(s,p,i==3?0700:0600);}
 const char *deps[]={"seed/gen.c","seed/json.h","seed/facts.h","seed/tbl.c","seed/net.c","exec/c/core.h","seed/compilerpack.c","seed/sha256.h","include/unisa_safedel.h","seed/pack.c"};
 const char *texts[]={nic_gen,"/* json leaf */\n","/* facts leaf */\n","#include \"json.h\"\n","#include \"../exec/c/core.h\"\n","/* core leaf */\n","#include \"json.h\"\n#include \"sha256.h\"\n#include \"../include/unisa_safedel.h\"\n","/* sha leaf */\n","/* safedel leaf */\n","/* pack leaf */\n"};
 for(int i=0;i<10;i++){nic_path(p,dir,deps[i]);nic_save(p,texts[i]);}
 nic_path(p,dir,"exec/facts/pp-autoinc.tsv");nic_save(p,"# value\na.h\nb.h\n");nic_path(p,dir,"src/model.txt");nic_save(p,"closed synthetic source bytes\n");nic_path(p,dir,"weights/model.txt");nic_save(p,"closed synthetic weight bytes\n");
 nic_path(p,dir,"include/a.h");nic_save(p,nic_a);nic_path(p,dir,"include/b.h");nic_save(p,origin?nic_ob:nic_b);
}
static ni_result nic_positive(const char *root,const char *origin,const char *reader,const char *label){
 ni_result r={0};char why[1400],gold[65];int rc=ni_compare(root,origin,reader,&r,why,sizeof why);nit_part(!rc,label,"actual-full-compare");if(rc)nit_die(why);
 cx_sha256_hex(nic_gold,strlen(nic_gold),gold);nit_part(!strcmp(r.libneed,gold),label,"independent-complete-table-gold");
 nit_part(r.native_source_kind==3&&!strcmp(r.reader_identity,"current-a4-v3"),label,"actual-current-source-ELF-pair");
 nit_part(r.native_table_calls==2&&r.native_internal_reads==-1&&r.ctor_files==10&&r.ordered_headers==2,label,"full-domains-and-two-real-native-calls");
 nit_part(r.current_reads==r.origin_reads&&r.current_reads>0&&!(r.current_reads%2)&&r.support_reads>0,label,"mirrored-before-after-physical-reads");
 nit_part(strcmp(r.current_include,r.origin_include)&&r.full_triggers>r.facts_triggers&&r.facts_triggers>0,label,"body-difference-and-printf-projections-preserved");
 return r;
}
static void nic_refuse(const char *root,const char *origin,const char *reader,const char *reason,const char *name){
 ni_result r;memset(&r,0xa5,sizeof r);char why[1400];int rc=ni_compare(root,origin,reader,&r,why,sizeof why);nit_check(rc==-1&&strstr(why,reason)&&nit_bytes(&r,sizeof r,0),name);
}
static np_result nic_run(char **v){np_result r={0};char why[1400];if(np_run(v,0,0,20,&r,why,sizeof why))nit_die(why);return r;}
static int nic_unit(char **argv){
 char actual[4096],reader[4096],writer[4096];if(!realpath(argv[2],actual)||!realpath(argv[3],reader)||!realpath(argv[4],writer))nit_die("current-unit-realpaths");
 char temp[]="/tmp/ni-current-unit-XXXXXX";if(!mkdtemp(temp))nit_die("current-unit-mkdtemp");char root[4600],origin[4600],p[4600],other[4600];nic_path(root,temp,"current");nic_path(origin,temp,"origin");nic_fixture(actual,root,0);nic_fixture(actual,origin,1);
 const char *which=argv[5];ni_result before=nic_positive(root,origin,reader,"current-before");
 if(!strcmp(which,"identity")){
 ni_reader_descriptor legacy={0},current={0},unknown={0};nit_check(ni_reader_profile("legacy-5f-v2",&legacy)&&legacy.host_kind==1&&legacy.cx_kind==2&&legacy.cx_registered,"legacy-descriptor-retained");
 nit_check(ni_reader_profile("current-a4-v3",&current)&&current.host_kind==3&&current.cx_registered&&current.cx_sha&&strcmp(current.cx_sha,legacy.cx_sha)&&strcmp(current.source_sha,legacy.source_sha)&&strcmp(current.host_sha,legacy.host_sha),"current-descriptor-distinct-no-placeholder-CX-hash");
 memset(&unknown,0xa5,sizeof unknown);nit_check(!ni_reader_profile("caller-hash",&unknown)&&nit_bytes(&unknown,sizeof unknown,0),"unknown-descriptor-zero-refused");
 mp_reader_material role={0};mp_profile full={0};nit_check(mp_reader_material_get("ni-current-a4-material-v1",&role)&&!strcmp(role.reader_identity,current.id)&&!role.source_package_admission&&!mp_get(role.id,&full),"current-reader-role-does-not-grant-mixed-model-admission");
 char *v[]={reader,"table",0,0};nic_path(p,root,"include");v[2]=p;np_result t=nic_run(v);nit_check(!t.rc&&!t.errn&&t.outn==strlen(nic_gold)&&!memcmp(t.out,nic_gold,t.outn),"HOSTREF-independent-entire-table-literal-gold");np_free(&t);
 char unknown_path[4600];nic_path(unknown_path,temp,"unknown-reader");size_t bytes;char *unknown_elf=nit_load(reader,&bytes);unknown_elf[bytes]=(char)0xa5;nit_cache_write(unknown_path,unknown_elf,bytes+1,0400);free(unknown_elf);nic_refuse(root,origin,unknown_path,"trusted-libneed-native-artifact-mismatch","valid-ELF-prefix-with-unknown-full-SHA-refused-before-execution");
 }else if(!strcmp(which,"closure")){
 nic_path(p,root,"seed/json.h");if(unlink(p))nit_die("leaf-remove");nic_save(p,"#include \"undeclared-leaf.h\"\n");nic_refuse(root,origin,reader,"constructor-transitive-quote-set-changed","changed-leaf-quote-refused");if(unlink(p))nit_die("leaf-restore");nic_save(p,"/* json leaf */\n");
 nic_path(p,root,"seed/gen.c");if(unlink(p))nit_die("gen-remove");nic_save(p,"#include HEADER\n");nic_refuse(root,origin,reader,"constructor-macro-or-nonliteral-include","macro-include-refused");if(unlink(p))nit_die("gen-restore");nic_save(p,nic_gen);
 nic_path(p,root,"seed/sha256.h");nic_path(other,temp,"saved-sha.h");if(rename(p,other))nit_die("dependency-remove");nic_refuse(root,origin,reader,"bounded-regular-file","missing-transitive-dependency-refused");if(rename(other,p))nit_die("dependency-restore");
 }else if(!strcmp(which,"includes")){
 nic_path(p,origin,"include/b.h");if(unlink(p)||symlink("a.h",p))nit_die("symlink-fixture");nic_refuse(root,origin,reader,"include-symlink-unsupported","include-symlink-refused");if(unlink(p))nit_die("symlink-restore");nic_save(p,nic_ob);
 nic_path(p,origin,"src/model.txt");if(unlink(p))nit_die("data-remove");nic_save(p,"changed synthetic source bytes\n");nic_refuse(root,origin,reader,"necessary-data-tree-mismatch","full-source-tree-difference-refused");if(unlink(p))nit_die("data-restore");nic_save(p,"closed synthetic source bytes\n");
 nic_path(p,origin,"include/a.h");if(chmod(p,0400))nit_die("mode-change");nic_refuse(root,origin,reader,"include-inventory-or-mode-mismatch","header-mode-difference-refused");if(chmod(p,0600))nit_die("mode-restore");
 }else if(!strcmp(which,"profiles")){
 nic_path(p,temp,"fast");size_t bytes;char *elf=nit_load(reader,&bytes);nit_cache_write(p,elf,bytes,0400);free(elf);
 char mat[4600],profile[4800];nic_path(mat,temp,"material");if(mkdir(mat,0700))nit_die("material-fixture");if(cx_fmt(profile,sizeof profile,"%s.source-packages-v3.cache.tsv",p))nit_die("profile-path");
 char *v[]={writer,"--create-current",root,origin,mat,p,reader,profile,0};np_result t=nic_run(v);struct stat st;errno=0;int absent=lstat(profile,&st)&&errno==ENOENT;nit_check(t.rc==2&&strstr(t.err,"bounded-regular-file")&&absent&&!strstr(t.out,"PROFILE_CREATED"),"current-create-refuses-absent-reconstructed-material-no-output");np_free(&t);
 if(cx_fmt(profile,sizeof profile,"%s.source-packages-v2.cache.tsv",p))nit_die("wrong-profile-path");t=nic_run(v);nit_check(t.rc==2&&strstr(t.err,"profile-must-be-FAST_ELF.source-packages-v3.cache.tsv"),"current-entry-cannot-write-legacy-profile-path");np_free(&t);
 v[1]="--create";if(cx_fmt(profile,sizeof profile,"%s.source-packages-v2.cache.tsv",p))nit_die("legacy-profile-path");t=nic_run(v);errno=0;absent=lstat(profile,&st)&&errno==ENOENT;nit_check(t.rc==2&&strstr(t.err,"actual-legacy-reference-role-required")&&absent,"current-reference-cannot-create-legacy-profile");np_free(&t);
 }else nit_die("unknown-current-case");
 ni_result after=nic_positive(root,origin,reader,"current-recovery");nit_check(!strcmp(before.witness,after.witness),"same-input-recovery-witness-stable");
 printf("NI_CURRENT_UNIT\tcase=%s\tassertions=%d\tfailed=%d\tscope=synthetic-full-input-scans-not-source-SID-DAG-or-NN-admission\n",which,nit_assertions,nit_failures);return nit_failures?1:0;
}

static int nir_wire(void){
 ni_reader_descriptor a={0},b={0};nit_check(ni_reader_profile("legacy-5f-v2",&a)&&ni_reader_profile("current-a4-v3",&b),"finite-reader-descriptors");
 nit_check(a.cx_kind==2&&b.cx_kind==4&&b.cx_registered&&b.cx_sha&&strcmp(a.cx_sha,b.cx_sha),"current-measured-CX-is-not-legacy");
 nit_check(strcmp(a.cache_schema,b.cache_schema)&&strcmp(a.cache_suffix,b.cache_suffix),"reconstructed-cache-domain-separated");
 np_buf p={0};lh_header_begin(&p);lh_header_row(&p,"include",0775,1,0,"");lh_header_row(&p,"include/a.h",0644,0,3,"abc");
 const char *gold="compiler-historical-include-inventory-v1\ndirectory\tinclude\t509\nheader-input\tinclude/a.h\t420\t3\tabc\n";
 nit_check(p.n==strlen(gold)&&!memcmp(p.p,gold,p.n),"independent-canonical-header-inventory-entire-gold");free(p.p);
 printf("NI_RECONSTRUCTED_WIRE\tassertions=%d\tfailed=%d\n",nit_assertions,nit_failures);return nit_failures?1:0;
}
static int nir_unit(char **argv){
 const char *root=argv[2],*origin=argv[3],*host=argv[4],*cx=argv[5],*mat=argv[6],*writer=argv[7],*which=argv[8];char why[1400];
 if(!strcmp(which,"gold")){
 char tmp[]="/tmp/ni-reconstructed-gold-XXXXXX";if(!mkdtemp(tmp))nit_die("gold-temp");char fixture[4600],include[4600];nic_path(fixture,tmp,"fixture");nic_fixture(root,fixture,0);nic_path(include,fixture,"include");
 char *a[]={ (char*)host,"table",include,0},*b[]={ (char*)cx,"table",include,0};np_result x=nic_run(a),y=nic_run(b);
 nit_check(!x.rc&&!y.rc&&!x.errn&&!y.errn&&x.outn==strlen(nic_gold)&&y.outn==strlen(nic_gold)&&!memcmp(x.out,nic_gold,x.outn)&&!memcmp(y.out,nic_gold,y.outn),"HOSTREF-and-saved-P53-CX-independent-entire-literal-gold");np_free(&x);np_free(&y);
 nic_path(include,root,"include");x=nic_run(a);y=nic_run(b);nit_check(!x.rc&&!y.rc&&!x.errn&&!y.errn&&x.outn==y.outn&&!memcmp(x.out,y.out,x.outn),"HOSTREF-CX-actual-current-include-entire-table-bytes");np_free(&x);np_free(&y);
 }else if(!strcmp(which,"host-ni")||!strcmp(which,"cx-ni")){
 ni_result r={0};int fast=!strcmp(which,"cx-ni");int rc=ni_compare(root,origin,fast?cx:host,&r,why,sizeof why);nit_check(!rc,"actual-full-NI-before-after-scans");if(rc)nit_die(why);
 nit_check(r.native_source_kind==(fast?4:3)&&!strcmp(r.reader_identity,"current-a4-v3")&&r.native_table_calls==2&&r.native_internal_reads==-1,"measured-reader-role-and-two-real-native-calls");
 nit_check(!fast||(r.native_profile[0]&&r.compiled_material[0]&&r.compiler_record[0]&&r.compiled_include[0]),"current-CX-reconstructed-profile-required");
 printf("NI_RECONSTRUCTED_OBSERVATION\treader=%s\tlibneed=%s\tdata=%s\tCdeps=%s\tcurrent_include=%s\torigin_include=%s\tctor_files=%d\tordered_headers=%d\treads=%d\tscope=necessary-inputs-only-for-reconstructed-record-no-full-SID-or-NN-qualification\n",fast?"CX":"HOSTREF",r.libneed,r.data,r.ctor_cdeps,r.current_include,r.origin_include,r.ctor_files,r.ordered_headers,r.physical_reads);
 }else if(!strcmp(which,"negative")){
 ni_result observed={0};if(ni_compare(root,origin,host,&observed,why,sizeof why))nit_die(why);
 char tmp[]="/tmp/ni-reconstructed-negative-XXXXXX";if(!mkdtemp(tmp))nit_die("negative-temp");char bad[4600],profile[4800];nic_path(bad,tmp,"reader");nic_copy(cx,bad,0700);nic_refuse(root,origin,bad,"bounded-regular-file","same-CX-without-required-v3-profile-refused");
 if(cx_fmt(profile,sizeof profile,"%s.source-packages-v3.cache.tsv",bad))nit_die("negative-profile-path");nic_save(profile,"libneed-native-code-cache-v2\n");nic_refuse(root,origin,bad,"current-reconstructed-code-cache-schema-required","legacy-profile-schema-cannot-admit-current-CX");
 np_buf out={0};int rc=ni_fast_profile_text(root,origin,mat,cx,host,observed.current_include,&out,why,sizeof why);nit_check(rc==-1&&!out.p&&!out.n,"legacy-encoder-cannot-admit-reconstructed-material");free(out.p);
 char copy[4600];nic_path(copy,tmp,"material");if(mkdir(copy,0700))nit_die("negative-material-dir");const char *names[]={"material.tsv","inputs.tsv","base-unisa_libneed.c","libneed.cx","bootstrap-input.com","bootstrap-input.com.build.json"};
 for(int i=0;i<6;i++){char a[4600],b[4600];nic_path(a,mat,names[i]);nic_path(b,copy,names[i]);nic_copy(a,b,i==4?0700:0600);}
 char record[4600];nic_path(record,copy,"bootstrap-input.com.build.json");if(unlink(record))nit_die("negative-record-remove");nic_save(record,"{\n  \"schema\": 1\n}\n");out=(np_buf){0};rc=ni_current_profile_text(root,origin,copy,cx,host,observed.current_include,&out,why,sizeof why);nit_check(rc==-1&&strstr(why,"code-profile-pinned-input-mismatch")&&!out.p&&!out.n,"original-schema-or-tampered-record-cannot-admit-current-material");free(out.p);
 char created[4800];if(cx_fmt(created,sizeof created,"%s.source-packages-v2.cache.tsv",cx))nit_die("wrong-created-path");char *v[]={ (char*)writer,"--create-current",(char*)root,(char*)origin,(char*)mat,(char*)cx,(char*)host,created,0};np_result r=nic_run(v);nit_check(r.rc==2&&strstr(r.err,"profile-must-be-FAST_ELF.source-packages-v3.cache.tsv"),"current-writer-refuses-legacy-output-channel");np_free(&r);
 }else nit_die("unknown-reconstructed-case");
 printf("NI_RECONSTRUCTED_UNIT\tcase=%s\tassertions=%d\tfailed=%d\tscope=only-for-reconstructed-record\n",which,nit_assertions,nit_failures);return nit_failures?1:0;
}


static int nir_producer(char **argv){
 const char *tool=argv[2],*root=argv[3],*saved=argv[4],*pos=argv[5],*neg=argv[6],*ident=argv[7];char tmp[]="/tmp/ni-reconstructed-producer-XXXXXX";if(!mkdtemp(tmp))nit_die("producer-temp");char fresh[4600],record[4800],expected[4800];nic_path(fresh,tmp,"saved.com");if(cx_fmt(record,sizeof record,"%s.build.json",fresh)||cx_fmt(expected,sizeof expected,"%s.build.json",saved))nit_die("producer-record-path");
 char *v[]={ (char*)tool,"--reconstruct-record",(char*)pos,(char*)neg,(char*)ident,(char*)saved,fresh,0};np_result t=nic_run(v);nit_check(!t.rc&&!t.errn&&strstr(t.out,"not-original-record")&&strstr(t.out,"wrong-commit=1"),"fresh-gate-reconstruction-success-not-original");np_free(&t);
 size_t an,bn;char *a=nit_load(record,&an),*b=nit_load(expected,&bn);nit_check(an==bn&&!memcmp(a,b,an),"deterministic-reconstructed-record-entire-bytes");free(a);free(b);
 char refused[4600];nic_path(refused,tmp,"wrong-commit.com");v[2]=(char*)neg;v[6]=refused;t=nic_run(v);struct stat st;errno=0;nit_check(t.rc==2&&(strstr(t.err,"P53_PROVENANCE-positive-SID-refused")||strstr(t.err,"P53_PROVENANCE-ident-artifact-or-source-refused"))&&lstat(refused,&st)&&errno==ENOENT,"wrong-commit-refused-before-output");np_free(&t);
 char wrong[4600];nic_path(wrong,tmp,"wrong-artifact.com");size_t n;a=nit_load(saved,&n);a[n]=(char)0xa5;nit_cache_write(wrong,a,n+1,0400);free(a);v[2]=(char*)pos;v[5]=wrong;t=nic_run(v);errno=0;nit_check(t.rc==2&&strstr(t.err,"P53_PROVENANCE-artifact-SHA-or-bytes-refused")&&lstat(refused,&st)&&errno==ENOENT,"wrong-artifact-refused-before-output");np_free(&t);
 char material[4600],receipt[4600];nic_path(material,tmp,"legacy-channel");nic_path(receipt,material,"material.tsv");char *legacy[]={ (char*)tool,"prepare",(char*)root,material,(char*)saved,0};t=nic_run(legacy);errno=0;nit_check(t.rc==2&&strstr(t.err,"unique-transform-fragment")&&lstat(receipt,&st)&&errno==ENOENT,"legacy-producer-refuses-reconstructed-schema-and-no-material-receipt");np_free(&t);
 printf("NI_RECONSTRUCTED_PRODUCER\tassertions=%d\tfailed=%d\n",nit_assertions,nit_failures);return nit_failures?1:0;
}

int main(int argc,char **argv){
 if(argc==8&&!strcmp(argv[1],"--reconstructed-producer"))return nir_producer(argv);
 if(argc==2&&!strcmp(argv[1],"--reconstructed-wire"))return nir_wire();
 if(argc==9&&!strcmp(argv[1],"--reconstructed-unit"))return nir_unit(argv);

#if !defined(__linux__) || !defined(__x86_64__)
    fputs("NOT_RUN nn-inputs requires Linux/x86_64-LP64\n",stderr);return 3;
#else
    if(argc==6&&!strcmp(argv[1],"--current-unit"))return nic_unit(argv);
    if(argc==7&&tx_eqz(argv[1],"--cache-v2"))return nit_cache_lane(argv);
    if(argc!=4||sizeof(long)!=8||sizeof(void *)!=8)nit_die("usage ROOT SNAPSHOT_ROOT TRUSTED_READER");
    char root_arg[4096],origin[4096],reader[4096],wrong[4400],missing[4400],module[4400],reader_sha[65],module_sha[65],unknown[4400],unknown_sha[65];
    if(!realpath(argv[1],root_arg)||!realpath(argv[2],origin)||!realpath(argv[3],reader)||tx_eqz(root_arg, origin))nit_die("distinct-real-roots-and-existing-reader-required");
    int n=snprintf(wrong,sizeof wrong,"%s/unisacc.com",root_arg);if(n<0||(size_t)n>=sizeof wrong||strlen(wrong)>700)nit_die("wrong-reader-path-bound");
    n=snprintf(missing,sizeof missing,"%s.nn-inputs-permanent-absent",reader);if(n<0||(size_t)n>=sizeof missing)nit_die("missing-reader-path-bound");
    struct stat st;errno=0;if(!lstat(missing,&st)||errno!=ENOENT)nit_die("missing-reader-precondition-must-be-ENOENT-only");
    n=snprintf(module,sizeof module,"%s/tools/cxlib/nninputs.cx",root_arg);if(n<0||(size_t)n>=sizeof module)nit_die("module-path-bound");
    int baseline=nit_fds();nit_digest(reader,reader_sha);nit_digest(module,module_sha);pid_t caller=getpid();
    nit_prepare_unknown(root_arg,reader,reader_sha,wrong,unknown,unknown_sha);
    ni_result first=nit_positive(root_arg,origin,reader,reader_sha,module_sha,"before");
    nit_negative(0,origin,reader,0,0,"null-root","nn-inputs-arguments",0);
    nit_negative(root_arg,origin,reader,0,1,"zero-reason-capacity","nn-inputs-arguments",0);
    nit_negative(root_arg,origin,reader,1,0,"null-output","nn-inputs-arguments",0);
    nit_negative(root_arg,root_arg,reader,0,0,"same-root-as-origin","distinct-real-root-and-native-paths","-");
    nit_negative(root_arg,origin,wrong,0,0,"wrong-actual-root-product-reader","trusted-libneed-native-ELF64-mismatch",wrong);
    nit_negative(root_arg,origin,missing,0,0,"missing-absolute-reader-with-observed-ENOENT","distinct-real-root-and-native-paths","-");
    nit_negative(root_arg,origin,unknown,0,0,"unknown-valid-ELF-reader","trusted-libneed-native-artifact-mismatch",unknown);
    nit_check(getpid()==caller,"parent-remains-alive-after-every-refusal");
    ni_result recovered=nit_positive(root_arg,origin,reader,reader_sha,module_sha,"recovery");nit_stable(&first,&recovered);
    char after[65];nit_digest(reader,after);nit_check(tx_eqz(reader_sha, after),"trusted-reader-original-bytes-unchanged");nit_digest(module,after);nit_check(tx_eqz(module_sha, after),"NI-module-original-bytes-unchanged");
    nit_digest(unknown,after);nit_check(tx_eqz(unknown_sha, after),"unknown-reader-frozen-bytes-unchanged-after-API-batch");
    nit_check(!lstat(unknown,&st)&&S_ISREG(st.st_mode)&&(st.st_mode&07777)==0400,"unknown-reader-remains-private-readonly-nonexecutable");
    errno=0;nit_check(lstat(missing,&st)==-1&&errno==ENOENT,"missing-reader-remains-absent-ENOENT-only");
    nit_check(nit_fds()==baseline,"all-positive-refusal-recovery-FDs-released");
    puts("NOT_COVERED\tdata-Cdep-domain-mutations;OS-cold-statistics;foreign-hosts;per-endpoint-private-read-counters;fresh-source-SID;full-origin-SP-DAG;NN-inference-model-adoption-or-complete-PP-fact-equivalence");
    puts("SCOPE\tpure-read-necessary-input-contract;two-real-full-positive-calls;phase-times-are-not-startup-statistics;no-baseline-or-result-cache;outer55-unchanged");
    printf("NN_INPUTS\tassertions=%d\tfailed=%d\n",nit_assertions,nit_failures);return nit_failures?1:0;
#endif
}
