/* ROOT SNAPSHOT_ROOT TRUSTED_READER. Linux/x86_64 LP64, outer55 unchanged.
 * Two actual complete ni_compare calls (initial and recovery), no tree cloning,
 * baseline writes, model construction, cached verdicts or host compilation.
 * Finite independent gold: complete libneed table SHA aea129...,10 Cdeps,
 * six ordered headers,two native table calls,internal native reads UNMEASURED.
 * ni_result exposes aggregate current/origin reads, not four separate endpoint
 * counters: check mirrored two-scan accounting and repeated real-call counts,
 * without inventing private per-endpoint observations. Current/origin include
 * body identities must remain distinct. This is necessary-input applicability,
 * not NN inference, model adoption, full PP equivalence or product qualification.
 */
#pragma unisa use cxlib.nninputs
#pragma unisa use text.text
static int nit_assertions,nit_failures;
static const char *nit_table="aea1293b96da78c6a0cfaf0354e47e840d414de41bdea735bead30d736c8c853";
static void nit_die(const char *s){fprintf(stderr,"nn-inputs-test: %s errno=%d\n",s,errno);exit(2);}
static void nit_check(int ok,const char *label){nit_assertions++;if(!ok)nit_failures++;printf("%s\t%s\n",ok?"PASS":"FAIL",label);}
static void nit_part(int ok,const char *label,const char *part){char b[200];int n=snprintf(b,sizeof b,"%s.%s",label,part);if(n<0||(size_t)n>=sizeof b)nit_die("check-label-bound");nit_check(ok,b);}
static int nit_bytes(const void *p,size_t n,unsigned char value){const unsigned char *s=p;for(size_t i=0;i<n;i++)if(s[i]!=value)return 0;return 1;}
static int nit_hex(const char *s){for(int i=0;i<64;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;return s[64]==0;}
static long long nit_ns(void){struct timespec t={0};long rc=__syscall6(228,1,(long)&t,0,0,0);if(rc||t.tv_sec<0||t.tv_nsec<0||t.tv_nsec>=1000000000L||(unsigned long long)t.tv_sec>(unsigned long long)(LLONG_MAX-t.tv_nsec)/1000000000ULL)nit_die("monotonic-clock");return (long long)t.tv_sec*1000000000LL+t.tv_nsec;}
static int nit_fds(void){
    DIR *d=opendir("/proc/self/fd");if(!d)nit_die("fd-observer-open");int n=0;
    for(;;){errno=0;struct dirent *e=readdir(d);if(!e){int saved=errno,rc=closedir(d);if(saved||rc)nit_die("fd-observer-read-or-close");return n;}
        if(tx_eq(e->d_name, ".", 1L << 20)||tx_eq(e->d_name, "..", 1L << 20))continue;
        for(const char *p=e->d_name;*p;p++)if(*p<'0'||*p>'9'){closedir(d);nit_die("fd-observer-nonnumeric-entry");}
        if(++n>4096){closedir(d);nit_die("fd-observer-bound");}}
}
static char *nit_load(const char *p,size_t *bytes){
    struct stat a,b;if(lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)nit_die("bounded-regular-input");
    int fd=open(p,O_RDONLY|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK);if(fd<0)nit_die("input-open");
    if(fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode){close(fd);nit_die("input-descriptor");}
    size_t n=(size_t)a.st_size,at=0;char *s=malloc(n+1);if(!s){close(fd);nit_die("allocation");}int bad=0;
    while(at<n){ssize_t k=read(fd,s+at,n-at);if(k<0&&errno==EINTR)continue;if(k<=0){bad=1;break;}at+=(size_t)k;}
    char extra;ssize_t k;do{k=read(fd,&extra,1);}while(k<0&&errno==EINTR);
    if(k||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode)bad=1;
    if(close(fd))bad=1;if(bad){free(s);nit_die("input-extent-identity-or-close");}s[n]=0;*bytes=n;return s;
}
static void nit_digest(const char *p,char h[65]){size_t n;char *s=nit_load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static int nit_elf64(const char *s,size_t n){return n>=64&&!memcmp(s,"\177ELF",4)&&(unsigned char)s[4]==2&&(unsigned char)s[5]==1&&(unsigned char)s[18]==62&&s[19]==0;}
static void nit_prepare_unknown(const char *root_arg,const char *reader,const char *reader_sha,const char *wrong,char path[4400],char sha[65]){
    /* All fixture writes end before the first ni_compare. The append preserves
     * every original ELF byte and its first64-byte prefix. Mode0400 prevents
     * accidental execution even if a broken validator tried to accept it. */
    size_t n;char *s=nit_load(wrong,&n);int root_shape=nit_elf64(s,n);free(s);
    nit_check(!root_shape,"wrong-root-reader.independent-non-ELF64-prefix-premise");if(root_shape)nit_die("wrong-root-reader-fixture-is-ELF64");
    s=nit_load(reader,&n);int source_shape=nit_elf64(s,n);nit_check(source_shape,"trusted-reader.independent-ELF64-little-endian-x64-prefix-premise");
    if(!source_shape||n>=16777216){free(s);nit_die("trusted-reader-fixture-shape-or-append-bound");}
    char original[65];cx_sha256_hex(s,n,original);if(strcmp(original,reader_sha)){free(s);nit_die("trusted-reader-changed-before-fixture-preparation");}
    int z=snprintf(path,4400,"%s/out/nn-inputs-unknown-XXXXXX",root_arg);if(z<0||z>=4400||strlen(path)>700){free(s);nit_die("unknown-reader-path-bound");}
    int fd=mkstemp(path);if(fd<0){free(s);nit_die("private-unknown-reader-mkstemp");}
    size_t at=0;int bad=0;while(at<n){ssize_t w=write(fd,s+at,n-at);if(w<0&&errno==EINTR)continue;if(w<=0||(size_t)w>n-at){bad=1;break;}at+=(size_t)w;}
    unsigned char extra=0xa5;ssize_t w;if(!bad){do{w=write(fd,&extra,1);}while(w<0&&errno==EINTR);if(w!=1)bad=1;}
    if(!bad&&fsync(fd))bad=1;if(close(fd))bad=1;if(bad){free(s);nit_die("unknown-reader-write-sync-close");}
    if(chmod(path,0400)){free(s);nit_die("unknown-reader-freeze-mode");}
    size_t cloned_n;char *cloned=nit_load(path,&cloned_n);int shape=nit_elf64(cloned,cloned_n);
    nit_check(shape&&cloned_n>=64&&!memcmp(cloned,s,64),"unknown-reader.ELF64-prefix-remains-valid-and-identical");
    int exact=cloned_n==n+1&&!memcmp(cloned,s,n)&&(unsigned char)cloned[n]==extra;
    nit_check(exact,"unknown-reader.exact-original-full-ELF-plus-one-byte");
    cx_sha256_hex(cloned,cloned_n,sha);nit_check(strcmp(sha,reader_sha)!=0,"unknown-reader.actual-SHA-differs-from-trusted-reader");
    struct stat st;int frozen=!lstat(path,&st)&&S_ISREG(st.st_mode)&&(st.st_mode&07777)==0400;
    nit_check(frozen,"unknown-reader.frozen-private-nonexecutable-fixture-before-API-batch");
    free(cloned);free(s);if(!shape||!exact||!frozen||tx_eq(sha, reader_sha, 1L << 20))nit_die("unknown-reader-fixture-preconditions");
    printf("FIXTURE\tunknown-reader=%s\tsha256=%s\tmode=0400\tnever-executed\n",path,sha);
}
static int nit_reason(const char *why,const char *reason,const char *path){
    char prefix[1000];int n=snprintf(prefix,sizeof prefix,"%s path=%s errno=",reason,path);
    if(n<0||(size_t)n>=sizeof prefix||strncmp(why,prefix,(size_t)n))return 0;
    const char *p=why+n;if(*p=='-')p++;const char *digits=p;while(*p>='0'&&*p<='9')p++;return p!=digits&&!*p;
}
static void nit_negative(const char *root_arg,const char *origin,const char *reader,int no_out,int zero_cap,const char *label,const char *reason,const char *error_path){
    ni_result r;char why[1400];memset(&r,0xa5,sizeof r);memset(why,0xa5,sizeof why);
    int rc=ni_compare(root_arg,origin,reader,no_out?0:&r,why,zero_cap?0:sizeof why);
    nit_part(rc==-1,label,"explicit-refusal");
    if(zero_cap)nit_part(nit_bytes(why,sizeof why,0xa5),label,"zero-cap-reason-buffer-untouched");
    else{int terminated=memchr(why,0,sizeof why)!=0;nit_part(terminated&&(error_path?nit_reason(why,reason,error_path):tx_eq(why, reason, 1L << 20)),label,"exact-reason-and-path");if(terminated)printf("REFUSAL\t%s\t%s\n",label,why);}
    if(no_out)nit_part(nit_bytes(&r,sizeof r,0xa5),label,"no-result-destination-does-not-write-local-canary");
    else nit_part(nit_bytes(&r,sizeof r,0),label,"entire-A5-result-cleared-including-padding");
}
static int nit_phase_accounting(const ni_result *r){
    const long long phases[]={r->setup_ns,r->support_before_ns,r->support_after_ns,r->order_ns,r->current_before_ns,r->origin_before_ns,r->data_compare_ns,r->native_current_ns,r->native_origin_ns,r->native_compare_ns,r->current_after_ns,r->origin_after_ns,r->stability_compare_ns,r->finalhash_ns};
    long long sum=0;for(int i=0;i<14;i++){if(phases[i]<0||sum>LLONG_MAX-phases[i])return 0;sum+=phases[i];}
    return sum==r->elapsed_ns&&r->support_ns==r->support_before_ns+r->support_after_ns&&r->elapsed_ns>0&&r->native_current_ns>0&&r->native_origin_ns>0&&r->current_before_ns>0&&r->origin_before_ns>0&&r->current_after_ns>0&&r->origin_after_ns>0;
}
static ni_result nit_positive(const char *root_arg,const char *origin,const char *reader,const char *reader_sha,const char *module_sha,const char *label){
    ni_result r;char why[1400]={0};memset(&r,0xa5,sizeof r);long long begin=nit_ns();
    int rc=ni_compare(root_arg,origin,reader,&r,why,sizeof why);long long end=nit_ns();nit_part(rc==0,label,"actual-complete-compare-success");
    if(rc){if(memchr(why,0,sizeof why))fprintf(stderr,"NI_REFUSE\t%s\n",why);nit_die("positive-compare");}
    nit_part(!why[0],label,"empty-success-reason");
    nit_part(r.ctor_files==10&&r.ordered_headers==6&&r.native_table_calls==2&&r.native_internal_reads==-1,label,"complete-declared-input-domains-and-unmeasured-native-reads");
    const char *hashes[]={r.witness,r.data,r.ctor_cdeps,r.current_include,r.origin_include,r.libneed,r.autoinc_full,r.autoinc_facts,r.native_artifact,r.native_C_source,r.verifier,r.netpack,r.kernelsha,r.runtime_support};
    const char *names[]={"witness","data","Cdeps","current-include","origin-include","libneed","full-projection","facts-projection","reader-artifact","reader-source","NI-module","netpack","kernelsha","runtime-support"};
    int all_hex=1;for(int i=0;i<14;i++){char part[100];snprintf(part,sizeof part,"complete-lowerhex-identity.%s",names[i]);int valid=nit_hex(hashes[i]);nit_part(valid,label,part);if(!valid)all_hex=0;}
    if(!all_hex)nit_die("noncanonical-success-identity-fields");
    nit_part(r.physical_reads>0&&(long long)r.physical_reads==(long long)r.current_reads+r.origin_reads+r.support_reads,label,"witness-and-actual-read-accounting");
    nit_part(r.current_reads>0&&r.origin_reads>0&&r.support_reads>0&&r.current_reads==r.origin_reads&&!(r.current_reads%2)&&!(r.origin_reads%2),label,"mirrored-two-endpoint-per-root-read-accounting");
    nit_part(strcmp(r.current_include,r.origin_include)!=0,label,"different-header-bodies-remain-distinct-input-identities");
    nit_part(tx_eq(r.libneed, nit_table, 1L << 20),label,"complete-libneed-table-independent-literal-gold");
    nit_part(tx_eq(r.native_artifact, reader_sha, 1L << 20),label,"actual-reader-file-identity");
    nit_part(tx_eq(r.verifier, module_sha, 1L << 20),label,"actual-current-NI-module-identity");
    nit_part(r.data_files>0&&r.data_dirs>0&&r.data_symlinks>=0,label,"complete-observed-tree-domain");
    nit_part(r.full_triggers>r.facts_triggers&&r.facts_triggers>0&&strcmp(r.autoinc_full,r.autoinc_facts)!=0,label,"printf-projections-remain-independent-ordered-domains");
    nit_part(begin>=0&&end>=begin,label,"monotonic-observation-timing");nit_part(nit_phase_accounting(&r),label,"nonoverlapping-phase-accounting");
    printf("NI\t%s\twitness=%s\tdata=%s\tCdeps=%s\tcurrent_include=%s\torigin_include=%s\tlibneed=%s\tfull=%s\tfacts=%s\treads=%d\tcurrent=%d\torigin=%d\tsupport=%d\tnative_calls=%d\tnative_internal_reads=UNMEASURED\tcaller_elapsed_ns=%lld\n",label,r.witness,r.data,r.ctor_cdeps,r.current_include,r.origin_include,r.libneed,r.autoinc_full,r.autoinc_facts,r.physical_reads,r.current_reads,r.origin_reads,r.support_reads,r.native_table_calls,end-begin);
    printf("PHASE_NS\t%s\treader=%lld\tsetup=%lld\tsupport_before=%lld\tsupport_after=%lld\tsupport=%lld\torder=%lld\tcurrent_before=%lld\torigin_before=%lld\tcompare=%lld\tnative_current=%lld\tnative_origin=%lld\tnative_compare=%lld\tcurrent_after=%lld\torigin_after=%lld\tstability=%lld\tfinalhash=%lld\n",label,r.elapsed_ns,r.setup_ns,r.support_before_ns,r.support_after_ns,r.support_ns,r.order_ns,r.current_before_ns,r.origin_before_ns,r.data_compare_ns,r.native_current_ns,r.native_origin_ns,r.native_compare_ns,r.current_after_ns,r.origin_after_ns,r.stability_compare_ns,r.finalhash_ns);
    return r;
}
static void nit_stable(const ni_result *a,const ni_result *b){
    const char *av[]={a->witness,a->data,a->ctor_cdeps,a->current_include,a->origin_include,a->libneed,a->autoinc_full,a->autoinc_facts,a->native_artifact,a->native_C_source,a->verifier,a->netpack,a->kernelsha,a->runtime_support};
    const char *bv[]={b->witness,b->data,b->ctor_cdeps,b->current_include,b->origin_include,b->libneed,b->autoinc_full,b->autoinc_facts,b->native_artifact,b->native_C_source,b->verifier,b->netpack,b->kernelsha,b->runtime_support};
    const char *names[]={"witness","data","Cdeps","current-include","origin-include","libneed","full-projection","facts-projection","reader-artifact","reader-source","NI-module","netpack","kernelsha","runtime-support"};
    for(int i=0;i<14;i++)nit_part(tx_eq(av[i], bv[i], 1L << 20),"recovery-stable-identity-excluding-timing",names[i]);
    nit_check(a->data_files==b->data_files&&a->data_dirs==b->data_dirs&&a->data_symlinks==b->data_symlinks&&a->ctor_files==b->ctor_files&&a->ordered_headers==b->ordered_headers&&a->full_triggers==b->full_triggers&&a->facts_triggers==b->facts_triggers,"recovery-all-logical-domain-counts-stable");
    nit_check(a->physical_reads==b->physical_reads&&a->current_reads==b->current_reads&&a->origin_reads==b->origin_reads&&a->support_reads==b->support_reads&&a->native_table_calls==b->native_table_calls&&a->native_internal_reads==b->native_internal_reads,"recovery-all-actual-read-counts-stable-without-timing-equality");
}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
    fputs("NOT_RUN nn-inputs requires Linux/x86_64-LP64\n",stderr);return 3;
#else
    if(argc!=4||sizeof(long)!=8||sizeof(void *)!=8)nit_die("usage ROOT SNAPSHOT_ROOT TRUSTED_READER");
    char root_arg[4096],origin[4096],reader[4096],wrong[4400],missing[4400],module[4400],reader_sha[65],module_sha[65],unknown[4400],unknown_sha[65];
    if(!realpath(argv[1],root_arg)||!realpath(argv[2],origin)||!realpath(argv[3],reader)||tx_eq(root_arg, origin, 1L << 20))nit_die("distinct-real-roots-and-existing-reader-required");
    int n=snprintf(wrong,sizeof wrong,"%s/unisacc.com",root_arg);if(n<0||(size_t)n>=sizeof wrong||strlen(wrong)>700)nit_die("wrong-reader-path-bound");
    n=snprintf(missing,sizeof missing,"%s.nn-inputs-permanent-absent",reader);if(n<0||(size_t)n>=sizeof missing)nit_die("missing-reader-path-bound");
    struct stat st;errno=0;if(!lstat(missing,&st)||errno!=ENOENT)nit_die("missing-reader-precondition-must-be-ENOENT-only");
    n=snprintf(module,sizeof module,"%s/tools/cxlib/nninputs.cx",root_arg);if(n<0||(size_t)n>=sizeof module)nit_die("module-path-bound");
    int baseline=nit_fds();nit_digest(reader,reader_sha);nit_digest(module,module_sha);pid_t caller=getpid();
    nit_prepare_unknown(root_arg,reader,reader_sha,wrong,unknown,unknown_sha);
    ni_result first=nit_positive(root_arg,origin,reader,reader_sha,module_sha,"before");
    nit_negative(0,origin,reader,0,0,"null-root","nn-inputs-arguments",0);
    nit_negative(root_arg,origin,reader,0,1,"zero-reason-capacity","nn-inputs-arguments",0);
    nit_negative(root_arg,origin,reader,1,0,"null-output","nn-inputs-arguments",0);
    nit_negative(root_arg,root_arg,reader,0,0,"same-root-as-origin","distinct-real-root-and-native-paths","-");
    nit_negative(root_arg,origin,wrong,0,0,"wrong-actual-root-product-reader","trusted-libneed-native-ELF64-mismatch",wrong);
    nit_negative(root_arg,origin,missing,0,0,"missing-absolute-reader-with-observed-ENOENT","distinct-real-root-and-native-paths","-");
    nit_negative(root_arg,origin,unknown,0,0,"unknown-valid-ELF-reader","trusted-libneed-native-artifact-mismatch",unknown);
    nit_check(getpid()==caller,"parent-remains-alive-after-every-refusal");
    ni_result recovered=nit_positive(root_arg,origin,reader,reader_sha,module_sha,"recovery");nit_stable(&first,&recovered);
    char after[65];nit_digest(reader,after);nit_check(tx_eq(reader_sha, after, 1L << 20),"trusted-reader-original-bytes-unchanged");nit_digest(module,after);nit_check(tx_eq(module_sha, after, 1L << 20),"NI-module-original-bytes-unchanged");
    nit_digest(unknown,after);nit_check(tx_eq(unknown_sha, after, 1L << 20),"unknown-reader-frozen-bytes-unchanged-after-API-batch");
    nit_check(!lstat(unknown,&st)&&S_ISREG(st.st_mode)&&(st.st_mode&07777)==0400,"unknown-reader-remains-private-readonly-nonexecutable");
    errno=0;nit_check(lstat(missing,&st)==-1&&errno==ENOENT,"missing-reader-remains-absent-ENOENT-only");
    nit_check(nit_fds()==baseline,"all-positive-refusal-recovery-FDs-released");
    puts("NOT_COVERED\tdata-Cdep-domain-mutations;OS-cold-statistics;foreign-hosts;per-endpoint-private-read-counters;fresh-source-SID;full-origin-SP-DAG;NN-inference-model-adoption-or-complete-PP-fact-equivalence");
    puts("SCOPE\tpure-read-necessary-input-contract;two-real-full-positive-calls;phase-times-are-not-startup-statistics;no-baseline-or-result-cache;outer55-unchanged");
    printf("NN_INPUTS\tassertions=%d\tfailed=%d\n",nit_assertions,nit_failures);return nit_failures?1:0;
#endif
}
