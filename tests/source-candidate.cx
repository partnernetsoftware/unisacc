/* ROOT GEN PKG historical-bootstrap|adopted-historical-bootstrap; outer55.
 * Finite initial-install profiles: original Source329/source-package-v1,
 * or Source0d/adoption-v1 with distinct NN447/controller329 epochs.
 * Actual ROOT/unisacc.com is still the historical-source builder. Inapplicable
 * conditions refuse, never skip/PASS. Checkpoint fixture path is explicit.
 * Each candidate API call freshly verifies its complete package and source.
 * Unsigned consistency is not historical process execution or N22 qualification.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.rebuildcontext
#pragma unisa use text.text
static int sc_assertions,sc_failures,sc_adopt;
static const char *sc_current="329cdb7077891074f638634dc7abdcd59ee39c368ad6ba1c2fcf867c3c63de2e";
static void sc_die(const char *s){fprintf(stderr,"source-candidate: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void sc_check(int ok,const char *label){sc_assertions++;if(!ok)sc_failures++;printf("%s\t%s\n",ok?"PASS":"FAIL",label);}
static void sc_part(int ok,const char *label,const char *part){char s[200];int n=snprintf(s,sizeof s,"%s.%s",label,part);if(n<0||(size_t)n>=sizeof s)sc_die("label-bound");sc_check(ok,s);}
static void sc_path(char *p,size_t cap,const char *base,const char *leaf){int n=snprintf(p,cap,"%s/%s",base,leaf);if(n<0||(size_t)n>=cap)sc_die("path-bound");}
static int sc_hex(const char *h){if(strlen(h)!=64)return 0;for(int i=0;i<64;i++)if(!((h[i]>='0'&&h[i]<='9')||(h[i]>='a'&&h[i]<='f')))return 0;return 1;}
static char *sc_read(const char *p,size_t *n,char hash[65]){
    struct stat a,b;if(lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>8388608)sc_die("regular-bounded-fixture");
    int fd=open(p,O_RDONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC);if(fd<0)sc_die("fixture-open");
    if(fstat(fd,&b)||!S_ISREG(b.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size){close(fd);sc_die("fixture-descriptor");}
    *n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s){close(fd);sc_die("allocation");}
    size_t at=0;int bad=0;
    while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){bad=1;break;}at+=(size_t)z;}
    char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);
    if(z||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)bad=1;
    if(close(fd))bad=1;if(bad){free(s);sc_die("fixture-extent-or-close");}
    s[*n]=0;cx_sha256_hex(s,*n,hash);return s;
}
static void sc_record_source(const char *s,size_t n,char source_out[65]){
    const char *key="\n  \"sources_sha256\": \"";size_t k=strlen(key);
    if(memchr(s,0,n)||np_count(s,n,key,k)!=1)sc_die("fixture-source-field");
    const char *at=strstr(s,key)+k;
    if((size_t)(at-s)>n||n-(size_t)(at-s)<65||at[64]!='\"')sc_die("fixture-source-field-extent");
    memcpy(source_out,at,64);source_out[64]=0;if(!sc_hex(source_out))sc_die("fixture-source-field-hex");
}
static rb_result sc_positive(const char *root_arg,const char *gen,const char *pkg,const char *builder,const char *raw,const char *record,const char *old_source,const char *label){
    rb_result out;memset(&out,0xa5,sizeof out);char why[2048];memset(why,'!',sizeof why);
    int rc=sc_adopt?rb_verify_adopted_candidate(root_arg,gen,pkg,builder,&out,why,sizeof why):rb_verify_candidate(root_arg,gen,pkg,builder,&out,why,sizeof why);
    sc_part(rc==0,label,"actual-candidate-admission");
    if(rc){if(memchr(why,0,sizeof why))fprintf(stderr,"%s\n",why);sc_die("positive-candidate-api");}
    sc_part(!why[0],label,"empty-success-reason");
    sc_part(tx_eq(out.source, sc_current, 1L << 20),label,"fresh-current-source-in-explicit-profile");
    if(!tx_eq(out.source, sc_current, 1L << 20)||tx_eq(out.bootstrap_record_source, out.source, 1L << 20))sc_die("historical-bootstrap-contract-not-applicable");
    sc_part(out.package_kind==(sc_adopt?3:2),label,"explicit-source-package-kind");
    sc_part(out.source_jobs==107&&out.source_models==34,label,"complete-DAG-107-jobs-34-models");
    sc_part(tx_eq(out.bootstrap, raw, 1L << 20)&&tx_eq(out.root_product, raw, 1L << 20),label,"actual-root-is-generation-builder");
    sc_part(tx_eq(out.bootstrap_record_source, old_source, 1L << 20)&&strcmp(out.bootstrap_record_source,out.source)!=0,label,"original-builder-source-is-historical");
    sc_part(tx_eq(out.builder_record, record, 1L << 20),label,"v2-builder-original-record-digest");
    sc_part(tx_eq(out.package_epoch_artifact, raw, 1L << 20)&&tx_eq(out.package_epoch_record, sc_adopt?"e0843c0c025f05e728c8584a7fd5db51965345316b65c6316815bd57787dbe45":record, 1L << 20),label,"package-epoch-raw-and-original-record");
    sc_part(tx_eq(out.package_epoch_source, sc_adopt?"447f794aeb8683492d73c520c163b45bac1d62e88dea2435b682a09772736bce":old_source, 1L << 20),label,"package-epoch-original-source");
    sc_part(sc_hex(out.product)&&sc_hex(out.package),label,"candidate-and-prepared-package-digests");
    sc_part(sc_hex(out.kernel_context)&&sc_hex(out.product_context)&&sc_hex(out.witness),label,"v2-context-and-observation-witness");
    sc_part(out.source_physical_reads>0&&out.physical_reads>0&&out.files>0,label,"fresh-physical-observations");
    sc_part(out.source_elapsed_ns>0,label,"independently-measured-source-snapshot");if(sc_adopt)sc_part(sc_hex(out.adoption_witness),label,"independent-adoption-reader-stable-witness");
    printf("CANDIDATE\t%s\tproduct=%s\tpackage=%s\tcontext=%s\twitness=%s\tsource_reads=%d\tsource_ns=%lld\n",label,out.product,out.package,out.product_context,out.witness,out.source_physical_reads,out.source_elapsed_ns);
    return out;
}
static int sc_zero(const rb_result *r){const unsigned char *p=(const unsigned char *)r;for(size_t i=0;i<sizeof *r;i++)if(p[i])return 0;return 1;}
static int sc_reason(const char *why,const char *reason,const char *path){
    char prefix[1400];int n=snprintf(prefix,sizeof prefix,"%s path=%s errno=",reason,path);
    if(n<0||(size_t)n>=sizeof prefix||strncmp(why,prefix,(size_t)n))return 0;
    const char *p=why+n;if(*p=='-')p++;const char *start=p;
    while(*p>='0'&&*p<='9')p++;return p!=start&&!*p;
}
static void sc_negative(const char *r,const char *gen,const char *pkg,const char *builder,int candidate,const char *label,const char *reason,const char *error_path){
    rb_result out;memset(&out,0xa5,sizeof out);char why[2048];memset(why,'!',sizeof why);
    int rc=candidate==2?rb_verify_candidate(r,gen,pkg,builder,&out,why,sizeof why):candidate==3?rb_verify_legacy_candidate(r,gen,pkg,builder,&out,why,sizeof why):candidate?(sc_adopt?rb_verify_adopted_candidate(r,gen,pkg,builder,&out,why,sizeof why):rb_verify_candidate(r,gen,pkg,builder,&out,why,sizeof why)):rb_verify(r,gen,pkg,builder,0,&out,why,sizeof why);
    sc_part(rc==-1,label,"explicit-refusal");
    int terminated=memchr(why,0,sizeof why)!=0;
    sc_part(terminated&&sc_reason(why,reason,error_path),label,"exact-reason-path-and-numeric-errno");
    sc_part(sc_zero(&out),label,"whole-result-cleared-including-padding");
    if(terminated)printf("REFUSAL\t%s\t%s\n",label,why);
}
static void sc_same(const rb_result *a,const rb_result *b){
    const char *av[]={a->source,a->bootstrap,a->bootstrap_record_source,a->product,a->package,a->kernel_context,a->product_context,a->witness,a->root_product,a->root_native,a->native_receipt,a->package_epoch_artifact,a->package_epoch_record,a->package_epoch_source,a->builder_record};
    const char *bv[]={b->source,b->bootstrap,b->bootstrap_record_source,b->product,b->package,b->kernel_context,b->product_context,b->witness,b->root_product,b->root_native,b->native_receipt,b->package_epoch_artifact,b->package_epoch_record,b->package_epoch_source,b->builder_record};
    const char *names[]={"source","builder-raw","builder-record-source","candidate-raw","prepared-package","kernel-context","v2-product-context","complete-witness","root-raw","root-native","native-receipt","package-epoch-raw","package-epoch-record","package-epoch-source","builder-record"};
    for(int i=0;i<15;i++)sc_part(tx_eq(av[i], bv[i], 1L << 20),"recovery",names[i]);
    sc_check(a->package_kind==b->package_kind&&a->source_jobs==b->source_jobs&&a->source_models==b->source_models&&a->model_inputs==b->model_inputs,"recovery.package-kind-and-logical-domains");
    sc_check(a->source_physical_reads==b->source_physical_reads&&a->physical_reads==b->physical_reads&&a->files==b->files&&a->retained_hits==b->retained_hits&&a->retained_bytes==b->retained_bytes,"recovery.physical-and-retention-counts");
    if(sc_adopt)sc_check(tx_eq(a->adoption_witness, b->adoption_witness, 1L << 20),"recovery.adoption-reader-stable-witness");
    sc_check(a->root_has_native==b->root_has_native&&a->has_native==b->has_native&&a->has_product_record==b->has_product_record,"recovery.optional-metadata-presence");
}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
    fprintf(stderr,"NOT_RUN source-candidate requires Linux/x86_64-LP64\n");return 3;
#else
    if(argc!=5||(strcmp(argv[4],"historical-bootstrap")&&!tx_eq(argv[4], "adopted-historical-bootstrap", 1L << 20))||sizeof(long)!=8||sizeof(void *)!=8)sc_die("usage ROOT GEN PKG historical-bootstrap|adopted-historical-bootstrap (Linux/x86_64-LP64)");
    sc_adopt=!strcmp(argv[4],"adopted-historical-bootstrap");if(sc_adopt)sc_current="0d59237f3250b59514a55ff529c77b665033e5feb71061f6fcaded0c7ef925c0";
    char r[4096],gen[4096],pkg[4096],paths[4][4400],hashes[4][65],old_source[65];
    if(!realpath(argv[1],r)||!realpath(argv[2],gen)||!realpath(argv[3],pkg))sc_die("explicit-roots");
    sc_path(paths[0],sizeof paths[0],r,"unisacc.com");
    sc_path(paths[1],sizeof paths[1],r,"unisacc.com.build.json");
    sc_path(paths[2],sizeof paths[2],r,sc_adopt?"out/c43-source329-origin-01/root/unisacc.com":"out/c43-u64-checkpoint-01/bootstrap.com");
    int n=snprintf(paths[3],sizeof paths[3],"%s.build.json",paths[2]);if(n<0||(size_t)n>=sizeof paths[3])sc_die("checkpoint-record-path");
    /* rb_bad bounds its rendered paths to1023 bytes; never weaken the exact
     * predicate by accepting a truncated fixture/root path. */
    if(strlen(paths[1])>1023||strlen(paths[2])>1023)sc_die("reason-path-bound");
    for(int i=0;i<4;i++){size_t bytes;char *s=sc_read(paths[i],&bytes,hashes[i]);if(i==1)sc_record_source(s,bytes,old_source);free(s);}
    if(tx_eq(old_source, sc_current, 1L << 20))sc_die("historical-bootstrap-contract-not-applicable-current-source-root");
    if(!tx_eq(hashes[0], hashes[2], 1L << 20)||!tx_eq(hashes[1], hashes[3], 1L << 20))sc_die("checkpoint-must-match-real-root-raw-and-original-record");
    sc_check(strcmp(paths[0],paths[2])!=0,"same-bytes-checkpoint-is-distinct-literal-path");
    pid_t caller=getpid();
    rb_result initial=sc_positive(r,gen,pkg,paths[0],hashes[0],hashes[1],old_source,"before");
    sc_negative(r,gen,pkg,paths[0],0,"legacy-mode-still-rejects-historical-root","build-record-identity-or-settings",paths[1]);
    sc_negative(r,gen,pkg,paths[2],1,"same-bytes-checkpoint-cannot-substitute-root-path","candidate-builder-must-be-current-root-path",paths[2]);
    if(sc_adopt){sc_negative(r,gen,pkg,paths[0],2,"adoption-cannot-enter-source-v1-mode","candidate-preinstall-requires-source-package-v1",pkg);sc_negative(r,gen,pkg,paths[0],3,"adoption-cannot-enter-legacy-mode","legacy-candidate-preinstall-requires-package-refresh",pkg);}
    sc_check(getpid()==caller,"parent-survives-both-refusals");
    rb_result final=sc_positive(r,gen,pkg,paths[0],hashes[0],hashes[1],old_source,"after");
    sc_same(&initial,&final);
    for(int i=0;i<4;i++){size_t bytes;char h[65],label[100];char *s=sc_read(paths[i],&bytes,h);free(s);snprintf(label,sizeof label,"input-%d-root-checkpoint-raw-or-record-unchanged",i);sc_check(tx_eq(h, hashes[i], 1L << 20),label);}
    puts(sc_adopt?"SCOPE\tinitial-preinstall-adopted-package-v1-and-product-context-v3;NN-epoch447-controller329-current-source0d;unsigned-consistency;no-root-write-or-installer;not-selfhost-N22-foreign-host-or-functional-PASS":"SCOPE\tinitial-preinstall-historical-bootstrap;source-package-v1-and-product-context-v2;unsigned-consistency-not-historical-execution;no-root-write-or-installer;not-selfhost-N22-foreign-host-or-functional-PASS");
    puts("TIMING\tsource_snapshot_ns=reported-per-endpoint;other-phases=UNMEASURED;outer55-unchanged");
    printf("SOURCE_CANDIDATE\tassertions=%d\tfailed=%d\n",sc_assertions,sc_failures);
    int failed=sc_failures?1:0;if(fflush(stdout)||ferror(stdout))return 2;return failed;
#endif
}
