#pragma unisa module cxhost_mod
/* Permanent fixture for the host module driver. No include. The export is one
   plain function so gcc and clang can compile the interface unisacc writes.
   cxhost_sum stays file-local. The interface names cxhost_add only. */
static int cxhost_sum(int a, int b) { return a + b; }
int cxhost_add(int a, int b) { return cxhost_sum(a, b); }
