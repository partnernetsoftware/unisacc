#!/usr/bin/env -S unisacc.com -run
/* librarysourcebitfieldimportcheck.cx -- Actual public V3 source to external V3 bitfield imports; mandatory calls and
   mismatched graph refusal.  Ported from tests/librarysourcebitfieldimportcheck.py (2026-10-23, the owner's
   direction: the toolchain moves off Python); copy_runtime and the pathlib/OSError details come from the shared
   module tests/cxlib/runtimecopy.cx, json.loads/json.dumps from tests/cxlib/pyjson.cx.
   usage: sh ./unisacc.com -run tests/librarysourcebitfieldimportcheck.cx -- [-h] [--package PACKAGE]
            [--arch {arm64,x86_64}] [--ffi-provider FFI_PROVIDER] [--evidence EVIDENCE]
            [--mode {fixed,callable,callbacks,variadic,pointee,longdouble}]
   ROOT is the directory above this file's (the .py's Path(__file__).resolve().parents[1]); run as a compiled binary
   (tests/cxbin) it is the working directory.  PACKAGE defaults to $MODEL_COM, else ROOT/unisacc.com.  TARGET is
   lnx/ARCH (osx/ARCH on Darwin; any other system is `ValueError: this native caller requires Darwin or Linux`);
   ARCH defaults to the host's.  The FFI provider is --ffi-provider, else $UNISACC_FFI_X86_PROVIDER (ARCH x86_64) or
   $UNISACC_FFI_PROVIDER: its manifest.json is checked as exec/c/buildlibrary.py provider_flags() checks it (schema
   1, TARGET, version 3.5.2, the pinned source tarball digest, and the byte size and sha256 of lib/libffi.a,
   include/ffi.h, include/ffitarget.h, include/ffi/ffi.h, include/ffi/ffitarget.h and LICENSE) and gives
   -I DIR/include and DIR/lib/libffi.a in place of -lffi.
   In a fresh temporary directory (TMPDIR, TEMP, TMP, /tmp; prefix r10-source-bitfield-) the runtime closure is
   copied (copy_runtime), the mode's probe tests/libraryabi/source-{bitfield,variadic,pointee,longdouble}-import.c
   becomes probe.c and PACKAGE compiler.pkg; then, each under `tests/bound 20` with output captured (a 25 s limit
   on top, as subprocess.run's):
     $CC [-arch ARCH] -std=c11 -O2 -g -fsanitize=address,undefined -fno-omit-frame-pointer -DSOURCE_TARGET="TARGET"
         [-DSOURCE_CALLABLE_IMPORT=1 | -DSOURCE_CALLBACK_IMPORT=1] -IRT [CFLAGS] probe.c RT/libunisacc.c
         RT/librarycall_ARCH.S LDFLAGS -o probe                                   (RT = TMP/exec/c, $CC default cc)
     [arch -ARCH] probe compiler.pkg        whose stdout must be the mode's one line
   and the source closure and the package must be unchanged.  Success prints
     {"status": "passed", "target": "TARGET", "native_calls": N}
   rc 0.  Any failure is the .py's uncaught exception: nothing on stdout, rc 1, and on stderr the end of the Python
   traceback (`AssertionError: {'command': [...], 'rc': N, 'stdout': '...', 'stderr': '...'}` for a failing step,
   `AssertionError: OUT` for wrong probe output, OUT as printed; FileNotFoundError, ValueError and
   json.decoder.JSONDecodeError lines as Python words them); the frames above it are not reproduced.
   --evidence PATH gets, either way once the package is hashed, json.dumps(record, indent=2) plus a newline (ASCII,
   \uXXXX escapes) with the .py's keys.
   Arguments follow argparse (unique prefixes, --opt=value, last one wins); usage errors are rc 2 on stderr; the
   prog name stays librarysourcebitfieldimportcheck.py so help and error text are byte-identical to the .py's.
   No #include: errno and the rest come with the prelude. */
#pragma unisa use cxlib.runtimecopy
#pragma unisa use cxlib.pyjson

static const char *PROG = "librarysourcebitfieldimportcheck.py";
static const char *USAGE =
    "usage: librarysourcebitfieldimportcheck.py [-h] [--package PACKAGE]\n"
    "                                           [--arch {arm64,x86_64}]\n"
    "                                           [--ffi-provider FFI_PROVIDER]\n"
    "                                           [--evidence EVIDENCE]\n"
    "                                           [--mode {fixed,callable,callbacks,variadic,pointee,longdouble}]\n";
static const char *SCOPE = "Actual public V3 source to external V3 bitfield imports; mandatory calls and mismatched graph refusal.";
static char ROOT[4096], TD[4300];
static char *EXC;   /* the last traceback line of the exception the .py would raise */

/* ---- byte buffers ---------------------------------------------------------------------------------------------- */
typedef struct Buf { unsigned char *p; size_t n, cap; } Buf;
static void bput(Buf *b, const void *d, size_t n) {
    if (b->n + n + 1 > b->cap) {
        size_t c = b->cap ? b->cap : 64;
        while (c < b->n + n + 1) c *= 2;
        b->p = realloc(b->p, c);
        if (!b->p) { fputs("MemoryError\n", stderr); exit(1); }
        b->cap = c;
    }
    if (n) memcpy(b->p + b->n, d, n);
    b->n += n; b->p[b->n] = 0;
}
static void bputs(Buf *b, const char *s) { bput(b, s, strlen(s)); }
static char *xstrdup(const char *s) { char *d = malloc(strlen(s) + 1); if (!d) { fputs("MemoryError\n", stderr); exit(1); } strcpy(d, s); return d; }
/* repr(str) appended to O */
static void brepr(Buf *o, const char *s, size_t n) {
    size_t cap = 4 * n + 8; char *t = malloc(cap);
    if (!t) { fputs("MemoryError\n", stderr); exit(1); }
    rtc_pyrepr(s, n, t, cap); bputs(o, t); free(t);
}
static char *xstrdup(const char *s);
static int fail(const char *line) { free(EXC); EXC = xstrdup(line); return -1; }

/* ---- text: UTF-8 (bytes.decode), universal newlines, json.dumps(str) ------------------------------------------ */
static long cp_at(const unsigned char *s, size_t n, size_t i, int *l, int *bad, int *eod) {
    unsigned c = s[i], lo = 0x80, hi = 0xBF; int need, k; long cp;
    *eod = 0;
    if (c < 0x80) { *l = 1; return c; }
    if (c >= 0xC2 && c <= 0xDF) { need = 1; cp = c & 0x1F; }
    else if (c >= 0xE0 && c <= 0xEF) { need = 2; cp = c & 0x0F; if (c == 0xE0) lo = 0xA0; if (c == 0xED) hi = 0x9F; }
    else if (c >= 0xF0 && c <= 0xF4) { need = 3; cp = c & 0x07; if (c == 0xF0) lo = 0x90; if (c == 0xF4) hi = 0x8F; }
    else { *bad = 1; return -1; }
    for (k = 1; k <= need; k++) {
        unsigned d;
        if (i + k >= n) { *bad = k; *eod = 1; return -1; }
        d = s[i + k];
        if (k == 1 ? (d < lo || d > hi) : (d & 0xC0) != 0x80) { *bad = k; return -1; }
        cp = (cp << 6) | (d & 0x3F);
    }
    *l = need + 1; return cp;
}
/* Python's bytes.decode('utf-8') error line, or 0 when S is valid */
static int utf8_error(const unsigned char *s, size_t n, char *msg, size_t cap) {
    size_t i = 0; int l, bad, eod;
    while (i < n) {
        if (cp_at(s, n, i, &l, &bad, &eod) < 0) {
            size_t end = eod ? n : i + (size_t)bad;
            const char *why = eod ? "unexpected end of data" : bad == 1 && (s[i] < 0xC2 || s[i] > 0xF4) ? "invalid start byte" : "invalid continuation byte";
            if (end == i + 1) snprintf(msg, cap, "UnicodeDecodeError: 'utf-8' codec can't decode byte 0x%02x in position %lu: %s", s[i], (unsigned long)i, why);
            else snprintf(msg, cap, "UnicodeDecodeError: 'utf-8' codec can't decode bytes in position %lu-%lu: %s", (unsigned long)i, (unsigned long)(end - 1), why);
            return 1;
        }
        i += (size_t)l;
    }
    return 0;
}
static void newlines(char *s, size_t *n) {   /* text mode: \r\n and a lone \r become \n */
    size_t i, j = 0;
    for (i = 0; i < *n; i++) {
        if (s[i] == '\r') { s[j++] = '\n'; if (i + 1 < *n && s[i + 1] == '\n') i++; }
        else s[j++] = s[i];
    }
    *n = j; s[j] = 0;
}
/* str(Path(P)): repeated slashes collapse, '.' components drop, a trailing slash goes; '' is '.' */
static void pathnorm(const char *p, char *o, size_t cap) {
    size_t j = 0; const char *s = p;
    if (p[0] == '/') { o[j++] = '/'; if (p[1] == '/' && p[2] != '/') o[j++] = '/'; }
    while (*s && j + 1 < cap) {
        const char *e; size_t n;
        while (*s == '/') s++;
        if (!*s) break;
        e = strchr(s, '/'); n = e ? (size_t)(e - s) : strlen(s);
        if (!(n == 1 && s[0] == '.')) {
            if (j && o[j - 1] != '/') o[j++] = '/';
            if (j + n + 1 > cap) n = cap - j - 1;
            memcpy(o + j, s, n); j += n;
        }
        s += n;
    }
    if (!j) o[j++] = '.';
    o[j] = 0;
}

/* ---- argparse ------------------------------------------------------------------------------------------------ */
static void usage_error(const char *msg, const char *a) {
    fflush(stdout); fputs(USAGE, stderr); fprintf(stderr, "%s: error: ", PROG); fprintf(stderr, msg, a); fputc('\n', stderr);
    exit(2);
}
static int looks_negnum(const char *s) {
    const char *p = s + 1; int dig = 0, dot = 0;
    if (*s != '-') return 0;
    for (; *p; p++) { if (*p >= '0' && *p <= '9') dig = 1; else if (*p == '.' && !dot) dot = 1; else return 0; }
    return dig;
}
static int prefix_of(const char *p, size_t n, const char *opt) { return n >= 3 && n <= strlen(opt) && !strncmp(p, opt, n); }
enum { O_NONE, O_HELP, O_PACKAGE, O_ARCH, O_PROVIDER, O_EVIDENCE, O_MODE };
static const char *ONAME[] = { "", "-h/--help", "--package", "--arch", "--ffi-provider", "--evidence", "--mode" };
static int long_opt(const char *s, const char **eq) {   /* the option a '--' token names (every prefix is unique) */
    const char *e = strchr(s, '='); size_t n = e ? (size_t)(e - s) : strlen(s);
    *eq = e ? e + 1 : 0;
    if (prefix_of(s, n, "--help")) return O_HELP;
    if (prefix_of(s, n, "--package")) return O_PACKAGE;
    if (prefix_of(s, n, "--arch")) return O_ARCH;
    if (prefix_of(s, n, "--ffi-provider")) return O_PROVIDER;
    if (prefix_of(s, n, "--evidence")) return O_EVIDENCE;
    if (prefix_of(s, n, "--mode")) return O_MODE;
    return O_NONE;
}
static int is_option(const char *s) {
    const char *eq;
    if (s[0] != '-' || !s[1]) return 0;
    if (!strcmp(s, "--")) return 1;
    if (s[1] == '-' && long_opt(s, &eq)) return 1;
    if (s[1] == 'h') return 1;
    if (looks_negnum(s)) return 0;
    if (strchr(s, ' ')) return 0;
    return 1;
}
static const char *MODES[] = { "fixed", "callable", "callbacks", "variadic", "pointee", "longdouble", 0 };
static void bad_choice(const char *opt, const char *v, const char *const *choices) {
    Buf m = { 0 }; int i;
    bputs(&m, "argument "); bputs(&m, opt); bputs(&m, ": invalid choice: "); brepr(&m, v, strlen(v)); bputs(&m, " (choose from ");
    for (i = 0; choices[i]; i++) { if (i) bputs(&m, ", "); brepr(&m, choices[i], strlen(choices[i])); }
    bputs(&m, ")");
    usage_error("%s", (char *)m.p);
}
typedef struct Args { const char *package, *arch, *provider, *evidence, *mode; } Args;
static void parse(int argc, char **argv, Args *a) {
    static const char *ARCHES[] = { "arm64", "x86_64", 0 };
    Buf extras = { 0 }; int i, help = 0;
    for (i = 1; i < argc; i++) {
        const char *s = argv[i], *eq = 0; int o = O_NONE;
        if (!strcmp(s, "--")) {
            for (; i < argc; i++) { if (extras.n) bputs(&extras, " "); bputs(&extras, argv[i]); }
            break;
        }
        if (s[0] == '-' && s[1] == '-') o = long_opt(s, &eq);
        else if (s[0] == '-' && s[1] == 'h') o = O_HELP;
        if (o == O_HELP) {
            if (eq && s[1] == '-') usage_error("argument -h/--help: ignored explicit argument '%s'", eq);
            if (s[1] == '-' || (s[2] != '=' && s[2] != '-')) { help = 1; break; }
            usage_error("argument -h/--help: ignored explicit argument '%s'", s + 2 + (s[2] == '='));
        } else if (o != O_NONE) {
            const char *v = eq;
            if (!v) {
                if (i + 1 >= argc || is_option(argv[i + 1])) { char m[128]; snprintf(m, sizeof m, "argument %s: expected one argument", ONAME[o]); usage_error("%s", m); }
                v = argv[++i];
            }
            if (o == O_ARCH) {
                if (strcmp(v, "arm64") && strcmp(v, "x86_64")) bad_choice("--arch", v, ARCHES);
                a->arch = v;
            } else if (o == O_MODE) {
                int k, ok = 0;
                for (k = 0; MODES[k]; k++) if (!strcmp(v, MODES[k])) ok = 1;
                if (!ok) bad_choice("--mode", v, MODES);
                a->mode = v;
            } else if (o == O_PACKAGE) a->package = v;
            else if (o == O_PROVIDER) a->provider = v;
            else a->evidence = v;
        } else { if (extras.n) bputs(&extras, " "); bputs(&extras, s); }
    }
    if (help) {
        printf("%s\noptions:\n  -h, --help            show this help message and exit\n  --package PACKAGE\n"
               "  --arch {arm64,x86_64}\n  --ffi-provider FFI_PROVIDER\n  --evidence EVIDENCE\n"
               "  --mode {fixed,callable,callbacks,variadic,pointee,longdouble}\n", USAGE);
        exit(0);
    }
    if (extras.n) usage_error("unrecognized arguments: %s", (char *)extras.p);
}

/* ---- the provider manifest -------------------------------------------------------------------------------- */
static int jeq_str(const pj_value *v, const char *s) { return v && v->type == PJ_STR && v->n == strlen(s) && !memcmp(v->s, s, v->n); }
/* buildlibrary.provider_flags(DIRECTORY, TARGET): 0 with CFLAG (-IDIR/include) and LDFLAG (DIR/lib/libffi.a) */
static int provider_flags(const char *directory, const char *target, char *cflag, char *ldflag, size_t cap) {
    static const char *REQUIRED[] = { "lib/libffi.a", "include/ffi.h", "include/ffitarget.h", "include/ffi/ffi.h",
                                      "include/ffi/ffitarget.h", "LICENSE", 0 };
    char dir[8192], mp[8400], why[16384]; char *text; size_t n = 0; pj_value *m, *arts; int i; struct stat st;
    if (rtc_resolve(directory, 1, dir, sizeof dir, why, sizeof why)) return fail(why);
    snprintf(mp, sizeof mp, "%s/manifest.json", dir);
    errno = 0;
    if (stat(mp, &st) != 0) { rtc_oserror(errno, mp, why, sizeof why); return fail(why); }
    if (S_ISDIR(st.st_mode)) { rtc_oserror(EISDIR, mp, why, sizeof why); return fail(why); }
    if (!(text = cx_read(mp, &n))) { rtc_oserror(errno ? errno : EIO, mp, why, sizeof why); return fail(why); }
    if (utf8_error((unsigned char *)text, n, why, sizeof why)) return fail(why);
    newlines(text, &n);
    if (!(m = pj_loads(text, n, why, sizeof why))) return fail(why);
    if (m->type != PJ_OBJ) return fail("ValueError: invalid FFI provider manifest");
    if (!pj_eq_int(pj_get(m, "schema"), 1) || !jeq_str(pj_get(m, "target"), target) || !jeq_str(pj_get(m, "version"), "3.5.2")
        || !jeq_str(pj_get(m, "source_tar_sha256"), "f3a3082a23b37c293a4fcd1053147b371f2ff91fa7ea1b2a52e335676bac82dc"))
        return fail("ValueError: unqualified FFI provider identity");
    arts = pj_get(m, "artifacts");   /* manifest.get('artifacts', {}): absent is an empty dict, null is not a dict */
    for (i = 0; REQUIRED[i]; i++) {
        pj_value *it = arts ? pj_get(arts, REQUIRED[i]) : 0;
        if (!it || it->type != PJ_OBJ) return fail("ValueError: incomplete FFI provider");
    }
    for (i = 0; REQUIRED[i]; i++) {
        pj_value *it = pj_get(arts, REQUIRED[i]); char p[8400], hex[65], line[256];
        snprintf(p, sizeof p, "%s/%s", dir, REQUIRED[i]);
        errno = 0;
        if (stat(p, &st) != 0) { rtc_oserror(errno, p, why, sizeof why); return fail(why); }
        snprintf(line, sizeof line, "ValueError: FFI provider content changed: %s", REQUIRED[i]);
        if (!pj_eq_int(pj_get(it, "bytes"), (long long)st.st_size)) return fail(line);
        if (rtc_sha_file(p, hex, why, sizeof why)) return fail(why);
        if (!jeq_str(pj_get(it, "sha256"), hex)) return fail(line);
    }
    snprintf(cflag, cap, "-I%s/include", dir);
    snprintf(ldflag, cap, "%s/lib/libffi.a", dir);
    return 0;
}

/* ---- steps ---------------------------------------------------------------------------------------------------- */
typedef struct Rec { char **argv; int argc, rc; char *out, *err; size_t outn, errn; } Rec;
static Rec RECS[4]; static int NREC;
static void argv_repr(Buf *o, char **v, int n) {
    int i;
    bputs(o, "[");
    for (i = 0; i < n; i++) { if (i) bputs(o, ", "); brepr(o, v[i], strlen(v[i])); }
    bputs(o, "]");
}
/* run(command): subprocess.run([ROOT/tests/bound, '20', *command], capture_output=True, text=True, timeout=25),
   recorded; rc 0 required.  0 with *OUT (the decoded stdout), or -1 with EXC */
static int run(char **command, char **out) {
    char **a; int k = 0, i, st = 0, n; pid_t pid; char op[4400], ep[4400], msg[512]; int of, ef;
    char *ob, *eb; size_t on = 0, en = 0; Rec *r; struct stat bs;
    for (n = 0; command[n]; n++) ;
    a = malloc((size_t)(n + 3) * sizeof *a);
    if (!a) { fputs("MemoryError\n", stderr); exit(1); }
    { char b[4200]; snprintf(b, sizeof b, "%s/tests/bound", ROOT); a[k++] = xstrdup(b); }
    a[k++] = "20";
    for (i = 0; i < n; i++) a[k++] = command[i];
    a[k] = 0;
    errno = 0;   /* Popen's exec failure, as the parent sees it */
    if (stat(a[0], &bs) != 0) { rtc_oserror(errno, a[0], msg, sizeof msg); return fail(msg); }
    if (access(a[0], X_OK) != 0) { rtc_oserror(EACCES, a[0], msg, sizeof msg); return fail(msg); }
    snprintf(op, sizeof op, "%s/.stdoutXXXXXX", TD); snprintf(ep, sizeof ep, "%s/.stderrXXXXXX", TD);
    of = mkstemp(op); ef = mkstemp(ep);   /* capture files (mkstemp: the prelude has no open/fileno) */
    if (of < 0 || ef < 0) { rtc_oserror(errno ? errno : EIO, TD, msg, sizeof msg); return fail(msg); }
    fflush(stdout); fflush(stderr);
    pid = fork();
    if (pid < 0) { rtc_oserror(errno, a[0], msg, sizeof msg); return fail(msg); }
    if (pid == 0) {
        dup2(of, 1); dup2(ef, 2); close(of); close(ef);
        execv(a[0], a); _exit(127);
    }
    close(of); close(ef);
    {   /* timeout=25: the child is killed and TimeoutExpired raised (polled: the prelude delivers no SIGALRM) */
        long ticks = 2500; pid_t w;
        for (;;) {
            w = waitpid(pid, &st, WNOHANG);
            if (w == pid) break;
            if (w < 0 && errno != EINTR) break;
            if (ticks-- <= 0) {
                Buf m = { 0 };
                kill(pid, SIGKILL); waitpid(pid, &st, 0);
                bputs(&m, "subprocess.TimeoutExpired: Command '"); argv_repr(&m, a, k); bputs(&m, "' timed out after 25 seconds");
                cx_remove(op); cx_remove(ep);
                return fail((char *)m.p);
            }
            usleep(10000);
        }
    }
    ob = cx_read(op, &on); eb = cx_read(ep, &en);
    cx_remove(op); cx_remove(ep);
    if (!ob) { ob = calloc(1, 1); on = 0; }
    if (!eb) { eb = calloc(1, 1); en = 0; }
    if (utf8_error((unsigned char *)ob, on, msg, sizeof msg) || utf8_error((unsigned char *)eb, en, msg, sizeof msg)) return fail(msg);
    newlines(ob, &on); newlines(eb, &en);
    r = &RECS[NREC++];
    r->argv = a; r->argc = k;
    r->rc = WIFEXITED(st) ? WEXITSTATUS(st) : WIFSIGNALED(st) ? -WTERMSIG(st) : 1;
    r->out = ob; r->outn = on; r->err = eb; r->errn = en;
    if (r->rc != 0) {
        Buf m = { 0 }; char t[32];
        bputs(&m, "AssertionError: {'command': "); argv_repr(&m, a, k);
        snprintf(t, sizeof t, ", 'rc': %d", r->rc); bputs(&m, t);
        bputs(&m, ", 'stdout': "); brepr(&m, ob, on);
        bputs(&m, ", 'stderr': "); brepr(&m, eb, en);
        bputs(&m, "}");
        free(EXC); EXC = (char *)m.p;
        return -1;
    }
    *out = ob;
    return 0;
}

/* ---- files ---------------------------------------------------------------------------------------------------- */
static void rmtree(const char *p) { cx_rmtree(p); }   /* through the one deletion guard (prelude cx_rmtree), errors ignored */
/* shutil.copy2 without the timestamps (nothing here reads them): content, then permission bits */
static int copy2(const char *src, const char *dst) {
    size_t n = 0; char *b; struct stat s; char why[9000];
    errno = 0;
    if (stat(src, &s) != 0) { rtc_oserror(errno, src, why, sizeof why); return fail(why); }
    if (S_ISDIR(s.st_mode)) { rtc_oserror(EISDIR, src, why, sizeof why); return fail(why); }
    if (!(b = cx_read(src, &n))) { rtc_oserror(errno ? errno : EIO, src, why, sizeof why); return fail(why); }
    errno = 0;
    if (cx_write(dst, b, n) != 0) { free(b); rtc_oserror(errno ? errno : EIO, dst, why, sizeof why); return fail(why); }
    free(b);
    chmod(dst, s.st_mode & 07777);
    return 0;
}
/* tempfile.gettempdir(): the first of TMPDIR, TEMP, TMP, /tmp, /var/tmp, /usr/tmp, the working directory that is a
   writable directory, made absolute */
static void gettempdir(char *out, size_t cap) {
    const char *c[7]; int i, k = 0; char cwd[4096];
    if (!getcwd(cwd, sizeof cwd)) strcpy(cwd, ".");
    c[k++] = getenv("TMPDIR"); c[k++] = getenv("TEMP"); c[k++] = getenv("TMP");
    c[k++] = "/tmp"; c[k++] = "/var/tmp"; c[k++] = "/usr/tmp"; c[k++] = cwd;
    for (i = 0; i < k; i++) {
        char abs[8400]; struct stat st;
        if (!c[i] || !*c[i]) continue;
        if (c[i][0] == '/') snprintf(abs, sizeof abs, "%s", c[i]); else snprintf(abs, sizeof abs, "%s/%s", cwd, c[i]);
        pathnorm(abs, out, cap);
        if (stat(out, &st) == 0 && S_ISDIR(st.st_mode) && access(out, W_OK | X_OK) == 0) return;
    }
    snprintf(out, cap, "%s", cwd);
}

/* ---- the evidence record ---------------------------------------------------------------------------------------- */
typedef struct Ev {
    const char *status, *target, *package_sha256, *mode;
    int passed, native_calls, callbacks;
    rtc_file *closure; size_t nclosure;
    const char *neg[2];
} Ev;
static pj_value *strlist(const char *const *v, int n) {
    pj_value *l = pj_list(); int i;
    for (i = 0; i < n; i++) pj_append(l, pj_strz(v[i]));
    return l;
}
static pj_value *ev_tree(const Ev *e) {   /* the .py's dict e, keys in its insertion order */
    static const char *CB[] = { "SCRIPT-to-fixed-native", "returned-native-indirect-call", "SCRIPT-closure-roundtrip" };
    pj_value *d = pj_dict(), *cmds = pj_list(); int c; size_t i;
    pj_set(d, "schema", pj_int(1)); pj_set(d, "status", pj_strz(e->status)); pj_set(d, "target", pj_strz(e->target));
    pj_set(d, "scope", pj_strz(SCOPE)); pj_set(d, "package_sha256", pj_strz(e->package_sha256));
    pj_set(d, "mode", pj_strz(e->mode));
    for (c = 0; c < NREC; c++) {
        Rec *r = &RECS[c]; pj_value *x = pj_dict();
        pj_set(x, "command", strlist((const char *const *)r->argv, r->argc)); pj_set(x, "rc", pj_int(r->rc));
        pj_set(x, "stdout", pj_str(r->out, r->outn)); pj_set(x, "stderr", pj_str(r->err, r->errn));
        pj_append(cmds, x);
    }
    pj_set(d, "commands", cmds);
    if (e->passed) {
        pj_value *sc = pj_dict(), *lv = pj_list();
        for (i = 0; i < e->nclosure; i++) pj_set(sc, e->closure[i].rel, pj_strz(e->closure[i].hex));
        pj_set(d, "source_closure", sc); pj_set(d, "native_calls", pj_int(e->native_calls));
        pj_append(lv, pj_int(0)); pj_append(lv, pj_int(1)); pj_append(lv, pj_int(2));
        pj_set(d, "optimisation_levels", lv); pj_set(d, "cross_origin_imports", pj_bool(1));
        pj_set(d, "negative_cases", strlist(e->neg, 2)); pj_set(d, "callback_paths", strlist(CB, e->callbacks ? 3 : 0));
    }
    return d;
}

/* ---- the check (the .py's try body) ----------------------------------------------------------------------------- */
static int check(Ev *e, const char *arch, const char *host, int darwin, const char *package, const char *cflag,
                 const char *ldflag) {
    char base[4096], rt[4400], dir[4400], why[16384], probe_src[4400], probe[4400], frozen[4400], exe[4400], def[128];
    char ldefault[] = "-lffi", lib[4400], call[4400];
    const char *mode = e->mode, *probe_name, *expected; char **cmd, *out; int k = 0; size_t i, nsrc;
    rtc_file *files; size_t nfiles; char (*before)[65], hex[65];
    gettempdir(base, sizeof base);
    snprintf(TD, sizeof TD, "%s/r10-source-bitfield-XXXXXX", base);
    if (!mkdtemp(TD)) { int err = errno; TD[0] = 0; rtc_oserror(err, base, why, sizeof why); return fail(why); }
    snprintf(dir, sizeof dir, "%s/exec", TD); mkdir(dir, 0777);
    snprintf(rt, sizeof rt, "%s/exec/c", TD);
    errno = 0;
    if (mkdir(rt, 0777) != 0) { rtc_oserror(errno, rt, why, sizeof why); return fail(why); }
    snprintf(dir, sizeof dir, "%s/src", TD);
    if (mkdir(dir, 0777) != 0) { rtc_oserror(errno, dir, why, sizeof why); return fail(why); }
    if (rtc_copy_runtime(ROOT, TD, &files, &nfiles, why, sizeof why)) return fail(why);
    probe_name = !strcmp(mode, "variadic") ? "source-variadic-import.c" : !strcmp(mode, "pointee") ? "source-pointee-import.c"
               : !strcmp(mode, "longdouble") ? "source-longdouble-import.c" : "source-bitfield-import.c";
    snprintf(probe_src, sizeof probe_src, "%s/tests/libraryabi/%s", ROOT, probe_name);
    /* before = {relpath: sha} over the runtime inputs (read again from ROOT) and the probe */
    nsrc = nfiles + 1;
    e->closure = calloc(nsrc, sizeof *e->closure); before = calloc(nsrc, sizeof *before);
    if (!e->closure || !before) { fputs("MemoryError\n", stderr); exit(1); }
    for (i = 0; i < nsrc; i++) {
        char p[8400]; char rel[4400];
        if (i < nfiles) snprintf(rel, sizeof rel, "%s", files[i].rel); else snprintf(rel, sizeof rel, "tests/libraryabi/%s", probe_name);
        snprintf(p, sizeof p, "%s/%s", ROOT, rel);
        if (rtc_sha_file(p, before[i], why, sizeof why)) return fail(why);
        e->closure[i].rel = xstrdup(rel); memcpy(e->closure[i].hex, before[i], 65);
    }
    snprintf(probe, sizeof probe, "%s/probe.c", TD);
    if (copy2(probe_src, probe)) return -1;
    snprintf(frozen, sizeof frozen, "%s/compiler.pkg", TD);
    if (copy2(package, frozen)) return -1;
    snprintf(exe, sizeof exe, "%s/probe", TD);
    cmd = calloc(32, sizeof *cmd);
    if (!cmd) { fputs("MemoryError\n", stderr); exit(1); }
    cmd[k++] = getenv("CC") ? getenv("CC") : "cc";
    if (darwin) { cmd[k++] = "-arch"; cmd[k++] = (char *)arch; }
    cmd[k++] = "-std=c11"; cmd[k++] = "-O2"; cmd[k++] = "-g"; cmd[k++] = "-fsanitize=address,undefined";
    cmd[k++] = "-fno-omit-frame-pointer";
    snprintf(def, sizeof def, "-DSOURCE_TARGET=\"%s\"", e->target); cmd[k++] = def;
    if (!strcmp(mode, "callable")) cmd[k++] = "-DSOURCE_CALLABLE_IMPORT=1";
    else if (!strcmp(mode, "callbacks")) cmd[k++] = "-DSOURCE_CALLBACK_IMPORT=1";
    snprintf(dir, sizeof dir, "-I%s", rt); cmd[k++] = dir;
    if (cflag) cmd[k++] = (char *)cflag;
    cmd[k++] = probe;
    snprintf(lib, sizeof lib, "%s/libunisacc.c", rt); cmd[k++] = lib;
    snprintf(call, sizeof call, "%s/librarycall_%s.S", rt, arch); cmd[k++] = call;
    cmd[k++] = ldflag ? (char *)ldflag : ldefault;
    cmd[k++] = "-o"; cmd[k++] = exe; cmd[k] = 0;
    if (run(cmd, &out)) return -1;
    k = 0;
    if (strcmp(host, arch)) { static char flag[32]; snprintf(flag, sizeof flag, "-%s", arch); cmd[k++] = "arch"; cmd[k++] = flag; }
    cmd[k++] = exe; cmd[k++] = frozen; cmd[k] = 0;
    expected = !strcmp(mode, "callbacks") ? "source callback imports: 900 public entries; SCRIPT callback, native callback and closure roundtrip preserved\n"
             : !strcmp(mode, "variadic") ? "source variadic imports: 900 script-to-native calls; provenance preserved\n"
             : !strcmp(mode, "pointee") ? "source pointee imports: 900 script-to-native calls; pointee identity preserved\n"
             : !strcmp(mode, "longdouble") ? (!strcmp(arch, "arm64") ? "source long double imports: 900 script-to-native calls; IEEE64 long double bit-exact\n"
                                                                      : "source long double imports: refused on a non-IEEE64 long double target\n")
             : "source imports: 900 script-to-native calls; provenance preserved\n";
    if (run(cmd, &out)) return -1;
    if (strcmp(out, expected)) {
        Buf m = { 0 };
        /* assert out == expected, out: the traceback ends with str(out), as printed (an empty message drops ': ') */
        bputs(&m, RECS[NREC - 1].outn ? "AssertionError: " : "AssertionError"); bput(&m, out, RECS[NREC - 1].outn);
        free(EXC); EXC = (char *)m.p; return -1;
    }
    /* assert before == {...} again and sha(package) == e['package_sha256'] */
    for (i = 0; i < nsrc; i++) {
        char p[8400];
        snprintf(p, sizeof p, "%s/%s", ROOT, e->closure[i].rel);
        if (rtc_sha_file(p, hex, why, sizeof why)) return fail(why);
        if (strcmp(hex, before[i])) return fail("AssertionError");
    }
    if (rtc_sha_file(package, hex, why, sizeof why)) return fail(why);
    if (strcmp(hex, e->package_sha256)) return fail("AssertionError");
    e->passed = 1; e->status = "passed"; e->nclosure = nsrc;
    e->native_calls = !strcmp(mode, "longdouble") && strcmp(arch, "arm64") ? 0 : 900;
    e->callbacks = !strcmp(mode, "callbacks");
    if (!strcmp(mode, "pointee")) { e->neg[0] = "pointee-double-vs-int"; e->neg[1] = "opaque-external-pointer"; }
    else {
        e->neg[0] = !strcmp(mode, "callbacks") ? "nested-callback-field-width" : !strcmp(mode, "variadic") ? "prefix-field-width" : "field-width";
        e->neg[1] = "unknown-source-layout";
    }
    return 0;
}

static char *uname_field(char *flag) {
    char *a[] = { "uname", flag, 0 }, *out = 0; size_t n = 0;
    if (cx_runv_timeout(a, 10, &out, &n) != 0 || !out) { free(out); return ""; }
    out[strcspn(out, "\r\n")] = 0;
    return out;
}
static void die_line(const char *line) { fflush(stdout); fprintf(stderr, "%s\n", line); exit(1); }

int main(int argc, char **argv) {
    Args a = { 0 }; Ev e = { 0 }; const char *host, *arch, *provider = 0, *pkgarg; char *mach, *sys;
    char target[64], cflag[8400], ldflag[8400], pkg[8192], why[16384], pkgsha[65], pnorm[8192]; int darwin, rc;
    size_t al;
    parse(argc, argv, &a);
    if (!a.mode) a.mode = "fixed";
    /* ROOT = Path(__file__).resolve().parents[1]; a compiled binary has no source path: the working directory */
    al = strlen(argv[0]);
    if (al > 3 && !strcmp(argv[0] + al - 3, ".cx") && realpath(argv[0], ROOT)) {
        int k; char *slash;
        for (k = 0; k < 2; k++) { slash = strrchr(ROOT, '/'); if (slash && slash != ROOT) *slash = 0; else { strcpy(ROOT, "/"); break; } }
    } else if (!getcwd(ROOT, sizeof ROOT)) return 2;
    mach = uname_field("-m"); sys = uname_field("-s");   /* platform.machine(), platform.system() */
    host = (!strcmp(mach, "arm64") || !strcmp(mach, "aarch64")) ? "arm64" : "x86_64";
    arch = a.arch ? a.arch : host;
    if (strcmp(sys, "Darwin") && strcmp(sys, "Linux")) die_line("ValueError: this native caller requires Darwin or Linux");
    darwin = !strcmp(sys, "Darwin");
    snprintf(target, sizeof target, "%s/%s", darwin ? "osx" : "lnx", arch);
    /* provider = a.ffi_provider or os.environ.get(...): a given --ffi-provider (even '', which is Path('.')) wins */
    if (a.provider) provider = a.provider;
    else {
        const char *v = getenv(!strcmp(arch, "x86_64") ? "UNISACC_FFI_X86_PROVIDER" : "UNISACC_FFI_PROVIDER");
        if (v && *v) provider = v;
    }
    if (provider) {
        pathnorm(provider, pnorm, sizeof pnorm);
        if (provider_flags(pnorm, target, cflag, ldflag, sizeof cflag)) die_line(EXC);
    }
    /* package = a.package.resolve(strict=True); default Path(os.environ.get('MODEL_COM', ROOT/'unisacc.com')) */
    if (a.package) pkgarg = a.package;
    else if (getenv("MODEL_COM")) pkgarg = getenv("MODEL_COM");
    else { static char d[4200]; snprintf(d, sizeof d, "%s/unisacc.com", ROOT); pkgarg = d; }
    pathnorm(pkgarg, pnorm, sizeof pnorm);
    if (rtc_resolve(pnorm, 1, pkg, sizeof pkg, why, sizeof why)) die_line(why);
    if (rtc_sha_file(pkg, pkgsha, why, sizeof why)) die_line(why);
    e.status = "failed"; e.target = target; e.package_sha256 = pkgsha; e.mode = a.mode;
    rc = check(&e, arch, host, darwin, pkg, provider ? cflag : 0, provider ? ldflag : 0);
    if (TD[0]) { rmtree(TD); TD[0] = 0; }
    if (a.evidence) {   /* finally: a.evidence.write_text(json.dumps(e, indent=2) + '\n') */
        Buf o = { 0 }; char ep[8192], *js; size_t jn; FILE *f; struct stat st;
        pj_dumps(ev_tree(&e), 2, &js, &jn); bput(&o, js, jn); bputs(&o, "\n");
        pathnorm(a.evidence, ep, sizeof ep);
        errno = 0;
        if (stat(ep, &st) == 0 && S_ISDIR(st.st_mode)) { rtc_oserror(EISDIR, ep, why, sizeof why); die_line(why); }
        if (!(f = fopen(ep, "w"))) { rtc_oserror(errno ? errno : EIO, ep, why, sizeof why); die_line(why); }
        if (fwrite(o.p, 1, o.n, f) != o.n || fclose(f) != 0) { rtc_oserror(errno ? errno : EIO, ep, why, sizeof why); die_line(why); }
    }
    if (rc) die_line(EXC);
    {
        pj_value *d = pj_dict(); char *js; size_t jn;   /* print(json.dumps({...})) */
        pj_set(d, "status", pj_strz(e.status)); pj_set(d, "target", pj_strz(target)); pj_set(d, "native_calls", pj_int(e.native_calls));
        pj_dumps(d, -1, &js, &jn); printf("%s\n", js);
    }
    return fflush(stdout) || ferror(stdout) ? 1 : 0;
}
