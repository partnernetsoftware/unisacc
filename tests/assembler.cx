 if(!rc){int valid=am_object_n>=64&&!memcmp(am_object,"\177ELF\2\1",6);unsigned long long sh=valid?at_rd(am_object+40,8):0;
  valid=valid&&sh<=am_object_n&&am_object_n-sh>=128;unsigned long long off=valid?at_rd(am_object+sh+64+24,8):0,n=valid?at_rd(am_object+sh+64+32,8):0;
  valid=valid&&off<=am_object_n&&n<=am_object_n-off&&n==wn&&(int)at_rd(am_object+18,2)==(arch?183:62);
