/* Same-candidate Linux/x86_64 host cell for the hosts domain matrix.
 * ROOT MATRIX PROFILE PROFILE_SHA NEW_OUT; or ROOT MATRIX COM_SHA NEW_OUT.
 * Expected identity is external, never inferred from the observed candidate.
 * Does not claim other five hosts, emulation, complete hosts parent, or N22. */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.candidateprofile
#pragma unisa use text.text
static char root[4096],matrix[4096],work[4096],bound[4400],product[4400];
static int checks,failed;
static void die(const char *s){fprintf(stderr,"hosts-lnx-x86_64: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void ck(int ok,const char *s){checks++;if(!ok)failed++;printf("%s\thosts-lnx-x86_64.%s\n",ok?"PASS":"FAIL",s);}
static void path(char *out,size_t cap,const char *a,const char *b){int n=snprintf(out,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path-bound");}
static void copy_fit(char *dst,size_t cap,const char *src){size_t i=0;if(!cap)die("copy-bound");while(src[i]&&i+1<cap){dst[i]=src[i];i++;}if(src[i])die("copy-bound");dst[i]=0;}
static int within(const char *p,const char *base){size_t n=strlen(base);return !strncmp(p,base,n)&&(!p[n]||p[n]=='/');}
static char *load(const char *p,size_t *n){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>8388608)die("regular-input");char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("input-extent");return s;}
static void hash(const char *p,char out[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,out);free(s);}
static void save(const char *name,const char *s,size_t n){char p[4400];path(p,sizeof p,work,name);int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-evidence");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("evidence-write");at+=(size_t)z;}if(fsync(fd)||close(fd))die("evidence-close");}
static void require_matrix_row(const char *text,const char *host,const char *cell,const char *status){char key[240];int n=snprintf(key,sizeof key,"%s\t%s\tyes\t%s\t",host,cell,status);if(n<0||(size_t)n>=sizeof key)die("matrix-key");const char *p=strstr(text,key);int ok=p&&(p==text||p[-1]=='\n');ck(ok,"matrix-row");if(!ok)die("matrix-row-mismatch");}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN hosts-same-candidate-lnx-x86_64 needs Linux/x86_64 builder\n",stderr);return 3;
#endif
 if((argc!=5&&argc!=6)||!realpath(argv[1],root)||!realpath(argv[2],matrix)||argv[argc-1][0]!='/')die("usage ROOT MATRIX PROFILE PROFILE_SHA NEW_ABS_OUT | ROOT MATRIX COM_SHA NEW_ABS_OUT");
 cpr_profile profile={0};const char *want;char profile_why[256];
 if(argc==6){if(cpr_load(argv[3],argv[4],&profile,profile_why,sizeof profile_why))die(profile_why);want=cpr_get(&profile,"candidate-sha256");if(!realpath(cpr_get(&profile,"candidate-path"),product))die("profile-candidate-path");}
 else {want=argv[3];if(strlen(want)!=64)die("expected-candidate-sha");for(int i=0;i<64;i++)if(!((want[i]>='0'&&want[i]<='9')||(want[i]>='a'&&want[i]<='f')))die("expected-candidate-sha");path(product,sizeof product,root,"unisacc.com");}
 char parent[4096],base[4096],leaf[4096];copy_fit(parent,sizeof parent,argv[argc-1]);char *slash=strrchr(parent,'/');if(!slash||!slash[1]||tx_eqz(slash+1, ".")||tx_eqz(slash+1, ".."))die("output-leaf");copy_fit(leaf,sizeof leaf,slash+1);if(slash==parent)slash[1]=0;else *slash=0;if(!realpath(parent,base))die("output-parent");int z=snprintf(work,sizeof work,"%s%s%s",base,tx_eqz(base, "/")?"":"/",leaf);if(z<0||(size_t)z>=sizeof work||within(work,matrix))die("output-aliases");if(mkdir(work,0700))die("new-output-required");
 path(bound,sizeof bound,root,"tools/bound");if(profile.raw)save("candidate-profile.tsv",profile.raw,profile.bytes);
 char before[65],after[65];
 hash(product,before);ck(tx_eqz(before, want),"product-equals-explicit-candidate-sha");if(failed)die("candidate-sha");
 size_t mn;char *mat=load(matrix,&mn);if(mn<80||memcmp(mat,"# Domain matrix for coverage row hosts",38)||memchr(mat,0,mn)){free(mat);die("matrix-wire");}
 require_matrix_row(mat,"lnx/x86_64","version-0.0.43","OBSERVED");
 require_matrix_row(mat,"lnx/x86_64","product-sha-stable","OBSERVED");
 require_matrix_row(mat,"lnx/x86_64","smoke-return7-subset","OBSERVED");
 require_matrix_row(mat,"lnx/arm64","version-0.0.43","BLOCKED");
 require_matrix_row(mat,"osx/arm64","version-0.0.43","BLOCKED");
 require_matrix_row(mat,"osx/x86_64","version-0.0.43","BLOCKED");
 require_matrix_row(mat,"win/x86_64","version-0.0.43","BLOCKED");
 require_matrix_row(mat,"win/arm64","version-0.0.43","BLOCKED");
 free(mat);
 char *ver[]={bound,"8","sh",product,"--version",0};np_result vr;char why[1024];
 if(np_run(ver,root,0,10,&vr,why,sizeof why))die(why);
 save("version.stdout",vr.out,vr.outn);save("version.stderr",vr.err,vr.errn);
 {char st[40];int sn=snprintf(st,sizeof st,"rc\t%d\n",vr.rc);save("version.status",st,(size_t)sn);}
 const char *expect="unisacc 0.0.43\n";
 ck(!vr.rc&&!vr.errn&&vr.outn==strlen(expect)&&!memcmp(vr.out,expect,vr.outn),"version-0.0.43");
 np_free(&vr);if(failed)die("version");
 /* Minimal smoke: compile and run a return-7 program through the product. */
 char src[4400],outb[4400];path(src,sizeof src,work,"ret7.c");path(outb,sizeof outb,work,"ret7.com");
 const char *body="int main(void){return 7;}\n";save("ret7.c",body,strlen(body));
 char *compile[]={bound,"20","sh",product,"-b","lnx/x86_64",src,"-o",outb,0};
 np_result cr;if(np_run(compile,root,0,22,&cr,why,sizeof why))die(why);
 save("compile.stdout",cr.out,cr.outn);save("compile.stderr",cr.err,cr.errn);
 {char st[40];int sn=snprintf(st,sizeof st,"rc\t%d\n",cr.rc);save("compile.status",st,(size_t)sn);}
 ck(!cr.rc&&!cr.errn,"smoke-compile");np_free(&cr);if(failed)die("compile");
 char *run[]={bound,"8",outb,0};np_result rr;if(np_run(run,root,0,10,&rr,why,sizeof why))die(why);
 save("run.stdout",rr.out,rr.outn);save("run.stderr",rr.err,rr.errn);
 {char st[40];int sn=snprintf(st,sizeof st,"rc\t%d\n",rr.rc);save("run.status",st,(size_t)sn);}
 ck(rr.rc==7&&!rr.errn&&!rr.outn,"smoke-return7");np_free(&rr);if(failed)die("run");
 hash(product,after);ck(tx_eqz(after, before),"product-sha-stable");
 if(profile.raw){ck(!cpr_stable(argv[3],&profile,profile_why,sizeof profile_why),"candidate-profile-unchanged");printf("PROFILE\tsha256=%s\n",profile.sha);}
 printf("HOST_CELL\tos=lnx\tarch=x86_64\tstatus=OBSERVED\tcandidate=%s\n",want);
 puts("NOT_CLAIMED\tlnx-arm64-osx-win-native-hosts-emulation-complete-hosts-parent-complete-N22");
 printf("HOSTS_LNX_X86_64\tassertions=%d\tfailed=%d\tscope=same-candidate-local-host-cell-only\n",checks,failed);
 cpr_clear(&profile);return failed?1:0;
}
