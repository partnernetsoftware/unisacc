/* ROOT MATERIAL NEW_ABS_OUT CASE_ID, caller bound55.
 * CASE: link | mixed-target | missing-definition | duplicate-definition |
 * old-unit-version | unsupported-osx-x86_64 | unsupported-osx-arm64 |
 * unsupported-win-x86_64 | unsupported-win-arm64. Material is independently
 * prepared by tools/object-material.cx; this test never compiles source units.
 * Linux ELF unit objects only; no Mach-O/COFF object or foreign-native claim.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
static char root[4096],mat[4096],work[4096],product[4400],bound[4400],tool[4400],self[4096],objects[3][4400];
static int assertions,failures;
static const char *leaves[]={"main-x86_64.o","value-x86_64.o","value-arm64.o"};
static void die(const char *s){fprintf(stderr,"objects: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path bound");}
static void ck(int ok,const char *s){assertions++;if(!ok)failures++;printf("%s\tobjects.%s\n",ok?"PASS":"FAIL",s);}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input absent":"input stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)die("bounded regular input");int fd=open(p,O_RDONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC);if(fd<0||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)die("input descriptor");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("read extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||bad||closed)die("input changed");s[*n]=0;return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void save(const char *name,const char *s,size_t n){char p[4400];path(p,work,name);int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive evidence");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("evidence write");at+=(size_t)z;}if(close(fd))die("evidence close");}
static np_result call(char **v,int seconds,const char *label){if(unsetenv("UNISACC_RF_CAPTURE")||unsetenv("UNISA_ATTRIBUTES"))die("clear ambient resource state");char why[1024],name[100],status[40];np_result r;if(np_run(v,root,0,seconds+2,&r,why,sizeof why))die(why);snprintf(name,sizeof name,"%s.stdout",label);save(name,r.out,r.outn);snprintf(name,sizeof name,"%s.stderr",label);save(name,r.err,r.errn);int n=snprintf(status,sizeof status,"rc\t%d\n",r.rc);snprintf(name,sizeof name,"%s.status",label);save(name,status,(size_t)n);np_buf args={0};for(int i=0;v[i];i++){char row[40];snprintf(row,sizeof row,"arg-%d\t",i);np_puts(&args,row);np_puts(&args,v[i]);np_puts(&args,"\n");}snprintf(name,sizeof name,"%s.argv.tsv",label);save(name,args.p,args.n);free(args.p);return r;}
static void verify(const char *label){char *v[]={bound,"20","sh",product,tool,"--","--verify",root,mat,0};np_result r=call(v,20,label);const char *gold="VERIFIED\tobjects-material\tno-test-result\n";int ok=!r.rc&&!r.errn&&r.outn==strlen(gold)&&!memcmp(r.out,gold,r.outn);ck(ok,label);if(!ok){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("verified material required");}np_free(&r);}
static unsigned long long get(const unsigned char *p,int n){unsigned long long v=0;for(int i=n-1;i>=0;i--)v=(v<<8)|p[i];return v;}
static int span(size_t n,unsigned long long at,unsigned long long len){return at<=n&&len<=n-at;}
/* Literal ELF ABI oracles: ELF64 little-endian, ET_REL=1, EM_X86_64=62,
 * EM_AARCH64=183, section entry64, symbol/RELA entry24. This is independent
 * container validation, not a decoder for the compiler's models or P3. */
static int relocatable(const unsigned char *p,size_t n,int arm){if(n<64||memcmp(p,"\177ELF\2\1\1",7)||get(p+16,2)!=1||get(p+18,2)!=(arm?183:62)||get(p+20,4)!=1||get(p+24,8)||get(p+32,8)||get(p+52,2)!=64||get(p+56,2)||get(p+58,2)!=64)return 0;unsigned long long off=get(p+40,8),count=get(p+60,2),strings=get(p+62,2);if(!count||count>256||strings>=count||!span(n,off,count*64))return 0;const unsigned char *names=p+(size_t)off+(size_t)strings*64;unsigned long long no=get(names+24,8),nn=get(names+32,8);if(get(names+4,4)!=3||!nn||!span(n,no,nn))return 0;int symbols=0,relocations=0;for(size_t i=0;i<(size_t)count;i++){const unsigned char *q=p+(size_t)off+i*64;unsigned long long type=get(q+4,4),at=get(q+24,8),len=get(q+32,8),align=get(q+48,8),link=get(q+40,4),info=get(q+44,4),entsize=get(q+56,8),name=get(q,4);if(type!=8&&!span(n,at,len))return 0;if(align&&(align&(align-1)))return 0;if(name>=nn||!memchr(p+(size_t)no+(size_t)name,0,(size_t)(nn-name)))return 0;if(type==2){if(entsize!=24||len%24||link>=count||info>len/24||get(p+(size_t)off+(size_t)link*64+4,4)!=3)return 0;symbols++;}if(type==4){if(entsize!=24||len%24||link>=count||info>=count||get(p+(size_t)off+(size_t)link*64+4,4)!=2)return 0;relocations++;}}return symbols>0&&relocations>0;}
static int executable(const unsigned char *p,size_t n){if(n<64||memcmp(p,"\177ELF\2\1\1",7)||get(p+16,2)!=2||get(p+18,2)!=62||get(p+52,2)!=64||get(p+54,2)!=56)return 0;unsigned long long off=get(p+32,8),count=get(p+56,2),entry=get(p+24,8);if(!count||count>256||!span(n,off,count*56))return 0;int x=0;for(size_t i=0;i<(size_t)count;i++){const unsigned char *q=p+(size_t)off+i*56;if(get(q,4)!=1)continue;unsigned long long at=get(q+8,8),va=get(q+16,8),len=get(q+32,8),mem=get(q+40,8);if(!span(n,at,len)||mem<len)return 0;if((get(q+4,4)&1)&&entry>=va&&entry-va<len)x=1;}return x;}
static int missing(const char *p){struct stat st;errno=0;if(!lstat(p,&st))return 0;if(errno!=ENOENT)die("output existence IO");return 1;}
static void refuse(char **v,const char *label,const char *reason,const char *output){np_result r=call(v,2,label);int ok=r.rc==1&&!r.outn&&r.errn==strlen(reason)&&!memcmp(r.err,reason,r.errn);ck(ok,label);if(!ok&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);char name[100];snprintf(name,sizeof name,"%s.no-output-created",label);ck(missing(output),name);}
static void link_and_run(const char *label){char out[4400],file[100],name[140];snprintf(file,sizeof file,"%s.elf",label);path(out,work,file);char *v[]={bound,"8","sh",product,objects[0],objects[1],"-o",out,0};np_result r=call(v,8,label);int ok=!r.rc&&!r.outn&&!r.errn;snprintf(name,sizeof name,"%s.product-link-accept",label);ck(ok,name);if(!ok&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(!ok)return;size_t n;unsigned char *bytes=(unsigned char *)load(out,&n);int valid=executable(bytes,n);free(bytes);snprintf(name,sizeof name,"%s.ELF64-x86_64-executable",label);ck(valid,name);if(!valid)return;char before[65],after[65];digest(out,before);if(chmod(out,0700))die("private executable permissions");char *run[]={bound,"2",out,0};snprintf(file,sizeof file,"%s.execute",label);r=call(run,2,file);snprintf(name,sizeof name,"%s.literal-exit7-empty-output",label);ck(r.rc==7&&!r.outn&&!r.errn,name);np_free(&r);digest(out,after);snprintf(name,sizeof name,"%s.image-unchanged",label);ck(tx_eqz(before, after),name);}
/* Locate the actual one PROGBITS metadata section, require its bounded
 * UNISATAPE1 header target and length, then exactly one first .unit 2 line.
 * No arbitrary whole-file first-match mutation or guessed file offset. */
static int unit_version_byte(const unsigned char *p,size_t n,size_t *version){if(!relocatable(p,n,0))return 0;unsigned long long sh=get(p+40,8),count=get(p+60,2);size_t start=0,end=0;int found=0;const char *prefix="UNISATAPE1 lnx/x86_64 ";size_t pn=strlen(prefix);for(size_t i=0;i<(size_t)count;i++){const unsigned char *q=p+(size_t)sh+i*64;size_t off=(size_t)get(q+24,8),len=(size_t)get(q+32,8);if(get(q+4,4)==1&&len>=pn&&!memcmp(p+off,prefix,pn)){found++;start=off+pn;end=off+len;}}if(found!=1)return 0;size_t at=start,length=0;int digits=0;while(at<end&&p[at]>='0'&&p[at]<='9'){unsigned d=(unsigned)(p[at++]-'0');if(length>(n-d)/10)return 0;length=length*10+d;digits++;}if(!digits||at==end||p[at++]!='\n'||length!=end-at||memchr(p+at,0,length))return 0;int seen=0,first=1;while(at<end){size_t e=at;while(e<end&&p[e]!='\n')e++;if(e==end)return 0;if(e>at&&p[at]!=';'){int isunit=e-at>=5&&!memcmp(p+at,".unit",5)&&(e-at==5||p[at+5]==' ');if(isunit){if(!first||seen||e-at!=7||memcmp(p+at,".unit 2",7))return 0;*version=at+6;seen++;}first=0;}at=e+1;}return seen==1;}
static int within(const char *p,const char *base){size_t n=strlen(base);return !strncmp(p,base,n)&&(!p[n]||p[n]=='/');}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN objects requires Linux/x86_64 host\n",stderr);return 3;
#endif
 if(argc!=5||!realpath(argv[1],root)||!realpath(argv[2],mat)||argv[3][0]!='/'||strlen(argv[3])>=sizeof work||!realpath(__FILE__,self))die("usage ROOT MATERIAL NEW_ABS_OUT CASE_ID");const char *mode=argv[4];const char *unsupported_cases[]={"unsupported-osx-x86_64","unsupported-osx-arm64","unsupported-win-x86_64","unsupported-win-arm64"};int unsupported=-1;for(int i=0;i<4;i++)if(tx_eqz(mode, unsupported_cases[i]))unsupported=i;if(unsupported<0&&!tx_eqz(mode, "link")&&!tx_eqz(mode, "mixed-target")&&!tx_eqz(mode, "missing-definition")&&!tx_eqz(mode, "duplicate-definition")&&!tx_eqz(mode, "old-unit-version"))die("unknown CASE_ID");char parent[4096],base[4096],leaf[4096];strcpy(parent,argv[3]);char *slash=strrchr(parent,'/');if(!slash||!slash[1]||tx_eqz(slash+1, ".")||tx_eqz(slash+1, ".."))die("output leaf");strcpy(leaf,slash+1);if(slash==parent)slash[1]=0;else *slash=0;if(!realpath(parent,base))die("output parent");int z=snprintf(work,sizeof work,"%s%s%s",base,tx_eqz(base, "/")?"":"/",leaf);if(z<0||(size_t)z>=sizeof work||within(work,mat)||strpbrk(work,"\t\r\n"))die("output aliases material");if(mkdir(work,0700))die("new private output required");path(product,root,"unisacc.com");path(bound,root,"tools/bound");path(tool,root,"tools/object-material.cx");for(int i=0;i<3;i++)path(objects[i],mat,leaves[i]);
 char watched[11][4400],hashes[11][65],after[65];path(watched[0],root,"unisacc.com");path(watched[1],root,"tools/object-material.cx");strcpy(watched[2],self);path(watched[3],root,"tools/cxlib/netpack.cx");path(watched[4],root,"seed/ident.c");path(watched[5],mat,"material.tsv");path(watched[6],mat,"main.cx");path(watched[7],mat,"value.cx");for(int i=0;i<3;i++)strcpy(watched[i+8],objects[i]);for(int i=0;i<11;i++){digest(watched[i],hashes[i]);printf("INPUT\t%s\tsha256=%s\n",watched[i],hashes[i]);}verify("material-before");int ready=1;for(int i=0;i<3;i++){size_t n;unsigned char *p=(unsigned char *)load(objects[i],&n);int ok=relocatable(p,n,i==2);free(p);char label[120];snprintf(label,sizeof label,"%s.literal-ELF64-ET_REL-machine-section-bounds",leaves[i]);ck(ok,label);if(!ok)ready=0;}puts("NOT_RUN\tnative-host.lnx-arm64\tobject-format-only");
 if(ready){if(tx_eqz(mode, "link"))link_and_run("positive");else{char output[4400];path(output,work,"refused.elf");if(tx_eqz(mode, "mixed-target")){char *v[]={bound,"2","sh",product,objects[0],objects[2],"-o",output,0};refuse(v,"mixed-target","unisacc: error: the objects were compiled for different targets (lnx/x86_64, lnx/arm64)\n",output);}
 else if(tx_eqz(mode, "missing-definition")){char *v[]={bound,"2","sh",product,objects[0],"-o",output,0};refuse(v,"missing-definition","link: undefined reference to object_value\n",output);}
 else if(tx_eqz(mode, "duplicate-definition")){char *v[]={bound,"2","sh",product,objects[0],objects[1],objects[1],"-o",output,0};refuse(v,"duplicate-definition","link: multiple definitions of object_value\n",output);}
 else if(tx_eqz(mode, "old-unit-version")){size_t n,version=0;unsigned char *p=(unsigned char *)load(objects[0],&n);int unique=unit_version_byte(p,n,&version);ck(unique,"private-unit-version-unique-bounded-metadata-precondition");if(unique){p[version]='1';save("old-unit.o",(char *)p,n);char old[4400],bh[65];path(old,work,"old-unit.o");digest(old,bh);char *v[]={bound,"2","sh",product,old,objects[1],"-o",output,0};refuse(v,"old-unit-version","link: malformed .unit record (recompile the object with this unisacc)\n",output);digest(old,after);ck(tx_eqz(bh, after),"private-old-unit-unchanged-by-refusal");}else puts("NOT_RUN\told-unit-version-refusal\tmetadata-precondition-failed");free(p);}
 else{const char *targets[]={"osx/x86_64","osx/arm64","win/x86_64","win/arm64"};char source[4400];path(source,mat,"main.cx");int i=unsupported;char file[80],label[100];snprintf(file,sizeof file,"unsupported-%d.o",i);path(output,work,file);char *v[]={bound,"2","sh",product,"-c","-funit","-b",(char *)targets[i],source,"-o",output,0};snprintf(label,sizeof label,"unsupported-object-target-%d",i);refuse(v,label,"unisacc: model driver: object output (-c -b) for this target is not on the product route yet (Linux targets are); the reference compiler writes Mach-O and COFF objects\n",output);}
 link_and_run("recovery");}}
 else puts("NOT_RUN\tobjects.execution\tobject-format-precondition-failed");for(int i=0;i<11;i++){digest(watched[i],after);char label[100];snprintf(label,sizeof label,"input-%d-unchanged",i);ck(tx_eqz(hashes[i], after),label);}verify("material-after");puts("NOT_CLAIMED\tMach-O-or-COFF-unit-objects-foreign-native-execution-system-linker-interop-or-full-format-and-negative-domain");puts("TIMING\tstartup_construction_loading_inference_output_validation_cold_hot=UNMEASURED");printf("OBJECTS\tcase=%s\tassertions=%d\tfailed=%d\tscope=actual-product-Linux-unit-object-link-format-and-refusal\n",mode,assertions,failures);return failures?1:0;
}
