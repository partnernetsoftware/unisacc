 else puts("NOT_RUN\tobjects.execution\tobject-format-precondition-failed");for(int i=0;i<11;i++){digest(watched[i],after);char label[100];snprintf(label,sizeof label,"input-%d-unchanged",i);ck(tx_eqz(hashes[i], after),label);}verify("material-after");puts(osx_profile?"NOT_CLAIMED\tsystem-linker-object-interop\tfull-Mach-O-object-domain":"NOT_CLAIMED\tMach-O-or-COFF-unit-objects-foreign-native-execution-system-linker-interop-or-full-format-and-negative-domain");puts("TIMING\tstartup_construction_loading_inference_output_validation_cold_hot=UNMEASURED");printf("OBJECTS\tcase=%s\tassertions=%d\tfailed=%d\tscope=%s\n",mode,assertions,failures,osx_profile?"actual-product-osx-unit-container-not-system-object":"actual-product-Linux-unit-object-link-format-and-refusal");return failures?1:execution_missing?3:0;
