#include <cx.h>
/* Verdict over two raw diagnostic payloads. Optional standalone-runner transport
   prefix is removed once; no fuzzy cause mapping and no signature alias. */
static int payload(const char*path,const char*expected){size_t n=0;char*b=cx_read(path,&n);if(!b)return 2;size_t at=0;const char*p="reject: ";size_t pn=strlen(p);if(n>=pn&&!memcmp(b,p,pn))at=pn;while(n>at&&(b[n-1]=='\n'||b[n-1]=='\r'))n--;size_t z=strlen(expected);int ok=n-at==z&&!memcmp(b+at,expected,z);free(b);return ok?0:1;}
int main(int argc,char**argv){if(argc!=4)return 2;int a=payload(argv[1],argv[3]),b=payload(argv[2],argv[3]);if(a||b){printf("CONTRACT_RED refusal-name e3=%d lower=%d\n",a,b);return a==2||b==2?2:1;}puts("same named cause and symbol; both complete diagnostic payloads exact");return 0;}
