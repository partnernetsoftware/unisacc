/* Pure-read finite snapshot API gate: ROOT SOURCE_CTX net-warnparse.
 * Linux/x86_64-LP64 bootstrap mechanism, not new-candidate qualification.
 * Outer55 unchanged. Endpoints: identity8 x2 + positive6 x2; at most four
 * negative children x2 =36 maximum child seconds. Current two negative child
 * cases are wrong valid64 source and unknown job; argument refusals fork none.
 * No files/directories/receipts are created, copied, mutated or resealed.
 * No NN construction or producer-result/PASS cache. The producer's old timeout
 * is independent evidence and is never rewritten by these material snapshots.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.sourcepackage
#pragma unisa use text.text

static int sjt_assertions,sjt_failures;
static const char *sjt_verifier="407f5ef7bd8cf0b65d1086db12b36ab6e19627dc8a0ed5f2e4002df8eae22442";
static const char *sjt_producer="dd6f5e6068289d04346f202035fb1ae3c84a10e254630c7ba5a650c7a06deb46";
static const char *sjt_foundation="9c2e71ef2094773bcada4c27a39871f3d0f5947555eb3ebe338aaddf203427ba";
static const char *sjt_digest_module="8ad60f9004f98b6bd68397668e1c6feabe468bb5be4b5ec9aedc4494aa541e31";
static void sjt_die(const char *s){fprintf(stderr,"source-job-snapshot: %s\n",s);exit(2);}
static void sjt_check(int ok,const char *label){sjt_assertions++;if(!ok)sjt_failures++;printf("%s\t%s\n",ok?"PASS":"FAIL",label);}
static void sjt_part(int ok,const char *label,const char *part){char b[200];int n=snprintf(b,sizeof b,"%s.%s",label,part);if(n<0||(size_t)n>=sizeof b)sjt_die("label-bound");sjt_check(ok,b);}
static void sjt_path(char *p,size_t cap,const char *a,const char *b){int n=snprintf(p,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)sjt_die("path-bound");}
static int sjt_hex(const char *p){for(int i=0;i<64;i++)if(!((p[i]>='0'&&p[i]<='9')||(p[i]>='a'&&p[i]<='f')))return 0;return p[64]==0;}
static int sjt_zero(const sp_result *r){const unsigned char *p=(const unsigned char *)r;for(size_t i=0;i<sizeof *r;i++)if(p[i])return 0;return 1;}
static void sjt_identity(const char *r,const char *ctx,char sid_out[65],const char *label){
    char wrapper[4400],helper[4400],why[1024];np_result result={0};
    sjt_path(wrapper,sizeof wrapper,r,"tools/bound");sjt_path(helper,sizeof helper,ctx,"identity-helper");
    char *v[]={wrapper,"8",helper,(char *)r,0};
    int transport=np_run(v,r,0,8,&result,why,sizeof why);
    int valid=!transport&&!result.rc&&!result.errn&&result.outn==65&&result.out[64]=='\n';
    if(valid){memcpy(sid_out,result.out,64);sid_out[64]=0;valid=sjt_hex(sid_out);}
    sjt_part(valid,label,"actual-fresh-helper-rc0-empty-stderr-65B-lowerhex");
    if(!valid){if(transport)fprintf(stderr,"%s\n",why);if(result.errn)fwrite(result.err,1,result.errn,stderr);np_free(&result);sjt_die("fresh-identity");}
    np_free(&result);
}
static sp_result sjt_positive(const char *r,const char *ctx,const char *job,const char *fresh,const char *label){
    sp_result out;memset(&out,0xa5,sizeof out);char why[2048];memset(why,'!',sizeof why);
    int rc=sp_verify_job_snapshot(r,ctx,job,fresh,6,&out,why,sizeof why);
    sjt_part(rc==0,label,"actual-snapshot-success");
    if(rc){fprintf(stderr,"%s\n",why);sjt_die("positive-snapshot");}
    sjt_part(!why[0],label,"empty-success-reason");
    sjt_part(tx_eqz(out.source, fresh),label,"fresh-source-bound");
    sjt_part(tx_eqz(out.producer, sjt_producer),label,"producer-pin");
    sjt_part(tx_eqz(out.foundation, sjt_foundation),label,"foundation-pin");
    sjt_part(tx_eqz(out.verifier, sjt_verifier),label,"verifier-module-pin");
    sjt_part(tx_eqz(out.digest_module, sjt_digest_module),label,"kernelsha-module-pin");
    sjt_part(out.jobs==6&&out.models==1,label,"three-tool-three-model-ancestry-counts");
    sjt_part(out.physical_reads>0&&out.physical_reads<=4096,label,"actual-physical-observation-count");
    sjt_part(out.elapsed_ns>0&&out.elapsed_ns<=6000000000LL,label,"measured-endpoint-within-six-seconds");
    return out;
}
static int sjt_child_reason(const char *why,const char *reason){
    char prefix[240];int n=snprintf(prefix,sizeof prefix,"source-package-snapshot-refused: sourcepackage: REFUSE %s errno=",reason);
    if(n<0||(size_t)n>=sizeof prefix||strncmp(why,prefix,(size_t)n))return 0;
    const char *p=why+n;if(*p=='-')p++;const char *digits=p;
    while(*p>='0'&&*p<='9')p++;
    return p!=digits&&p[0]=='\n'&&p[1]==0;
}
static void sjt_negative(const char *r,const char *ctx,const char *job,const char *fresh,int seconds,int null_result,const char *label,const char *reason,int child){
    sp_result out;memset(&out,0xa5,sizeof out);char why[2048];memset(why,'!',sizeof why);
    int rc=sp_verify_job_snapshot(r,ctx,job,fresh,seconds,null_result?0:&out,why,sizeof why);
    sjt_part(rc==-1,label,"explicit-negative-return");
    /* why must have a bounded NUL before any string predicate, even on a bug. */
    int terminated=memchr(why,0,sizeof why)!=0;
    sjt_part(terminated&&(child?sjt_child_reason(why,reason):tx_eqz(why, reason)),label,"exact-named-reason");
    if(!null_result)sjt_part(sjt_zero(&out),label,"whole-output-cleared-including-padding");
    if(terminated)printf("REFUSAL\t%s\t%s",label,why);
    if(terminated&&(!*why||why[strlen(why)-1]!='\n'))putchar('\n');
}
static void sjt_compare(const sp_result *a,const sp_result *b){
    sjt_check(tx_eqz(a->source, b->source),"recovery.source");
    sjt_check(tx_eqz(a->artifact, b->artifact),"recovery.actual-artifact");
    sjt_check(tx_eqz(a->manifest, b->manifest),"recovery.context-manifest");
    sjt_check(tx_eqz(a->receipt, b->receipt),"recovery.job-receipt");
    sjt_check(tx_eqz(a->witness, b->witness),"recovery.full-observed-view-witness");
    sjt_check(tx_eqz(a->epoch_artifact, b->epoch_artifact)&&tx_eqz(a->epoch_record, b->epoch_record)&&tx_eqz(a->epoch_path, b->epoch_path),"recovery.physical-epoch-raw-record-and-path");
    sjt_check(tx_eqz(a->producer, b->producer)&&tx_eqz(a->foundation, b->foundation)&&tx_eqz(a->verifier, b->verifier)&&tx_eqz(a->digest_module, b->digest_module),"recovery.producer-foundation-verifier-digest-identities");
    sjt_check(a->jobs==b->jobs&&a->models==b->models&&a->physical_reads==b->physical_reads,"recovery.logical-and-physical-observation-counts");
}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
    fprintf(stderr,"NOT_RUN source-job-snapshot requires Linux/x86_64-LP64\n");return 3;
#else
    if(argc!=4||sizeof(long)!=8||sizeof(void *)!=8)sjt_die("usage ROOT SOURCE_CTX net-warnparse (Linux/x86_64-LP64)");
    char r[4096],ctx[4096],before[65],after[65];
    if(!realpath(argv[1],r)||!realpath(argv[2],ctx)||!tx_eqz(argv[3], "net-warnparse"))sjt_die("roots-or-finite-job-domain");
    pid_t caller=getpid();sjt_identity(r,ctx,before,"before");
    sp_result initial=sjt_positive(r,ctx,argv[3],before,"before");
    char wrong[65];memcpy(wrong,before,65);wrong[0]=wrong[0]=='0'?'1':'0';
    sjt_negative(r,ctx,argv[3],wrong,2,0,"wrong-valid64-source","receipt-bytes-mismatch",1);
    sjt_negative(r,ctx,"unknown-source-job-snapshot-control",before,2,0,"unknown-job","unknown-or-PLANNED-job",1);
    const char *argument_reason="source-package-snapshot-arguments";
    sjt_negative(r,ctx,"",before,2,0,"empty-job",argument_reason,0);
    sjt_negative(r,ctx,0,before,2,0,"NULL-job",argument_reason,0);
    sjt_negative(r,ctx,argv[3],before,0,0,"seconds-zero",argument_reason,0);
    sjt_negative(r,ctx,argv[3],before,56,0,"seconds-over-maximum",argument_reason,0);
    sjt_negative(r,ctx,argv[3],before,2,1,"NULL-result",argument_reason,0);
    sjt_negative(0,ctx,argv[3],before,2,0,"NULL-root",argument_reason,0);
    sjt_negative(r,0,argv[3],before,2,0,"NULL-context",argument_reason,0);
    sjt_negative(r,ctx,argv[3],0,2,0,"NULL-fresh-source",argument_reason,0);
    memcpy(wrong,before,65);wrong[0]='G';
    sjt_negative(r,ctx,argv[3],wrong,2,0,"non-lowerhex-source",argument_reason,0);
    wrong[0]=before[0];wrong[63]=0;
    sjt_negative(r,ctx,argv[3],wrong,2,0,"short63-source",argument_reason,0);
    sjt_check(getpid()==caller,"parent-survives-all-refusals");
    sjt_identity(r,ctx,after,"after");sjt_check(tx_eqz(before, after),"fresh-source-observations-unchanged");
    sp_result final=sjt_positive(r,ctx,argv[3],after,"after");sjt_compare(&initial,&final);
    printf("OBSERVATION\tjob=%s\tartifact=%s\twitness=%s\tphysical_reads=%d\tbefore_ns=%lld\tafter_ns=%lld\n",argv[3],final.artifact,final.witness,final.physical_reads,initial.elapsed_ns,final.elapsed_ns);
    puts("SCOPE\tpure-read-material-contract;Linux-kernel-crypto-and-bootstrap-dependent;new-child-new-physical-view-per-call;no-atomic-snapshot-or-ABA-proof;not-new-candidate-or-historical-producer-PASS");
    puts("TIMING\tendpoint_ns=measured;startup-other-phases=UNMEASURED;outer55-and-original-producer-limits-unchanged");
    printf("SOURCE_JOB_SNAPSHOT\tassertions=%d\tfailed=%d\n",sjt_assertions,sjt_failures);
    int failed=sjt_failures?1:0;if(fflush(stdout)||ferror(stdout))return 2;return failed;
#endif
}
