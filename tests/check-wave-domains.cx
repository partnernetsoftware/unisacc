/* tests/check-wave-domains.cx -- tests/wave-domains.tsv decides which batches may share a wave.
 *
 *   sh ./unisacc.com tests/check-wave-domains.cx [-- ROOT]
 *
 * One predicate, one table: `serial`, `wt`, `hs` and `mi:<name>` all answer the same question --
 * may these two batches run at once.  A typo would silently widen the schedule, so every row is
 * checked:
 *   - the id exists in tests/batches.tsv and is IMPLEMENTED;
 *   - every domain token is one of serial / wt / hs / mi:<registered material name>;
 *   - `serial` is exclusive (it cannot be combined with another token);
 *   - reason and evidence are non-empty (an unexplained constraint is not a constraint);
 *   - no id appears twice.
 * Exit 0 when the table is well formed, 1 on any violation, 2 on usage/IO. */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.io
#pragma unisa use text.text

#define MAXROWS 128
static char g_root[4096];
static int asserts, failed;
static void die(const char *s) { fprintf(stderr, "check-wave-domains: REFUSE %s errno=%d\n", s, errno); exit(2); }
static void ck(int ok, const char *what, const char *detail) {
    asserts++;
    if (!ok) failed++;
    printf("%s\t%s%s%s\n", ok ? "PASS" : "FAIL", what, detail && *detail ? "\t" : "", detail ? detail : "");
}
static char *slurp(const char *rel, size_t *n) {
    char p[4400];
    if (cx_fmt(p, sizeof p, "%s/%s", g_root, rel)) die("path");
    { char *s = cx_read(p, n); if (!s) die(rel); return s; }
}
static int col(const char *s, size_t n, int k, char *dst, size_t cap) {
    size_t at = 0; int i;
    for (i = 0; i < k; i++) { while (at < n && s[at] != '\t' && s[at] != '\n') at++; if (at >= n || s[at] == '\n') return 0; at++; }
    { size_t kk = 0; while (at < n && s[at] != '\t' && s[at] != '\n' && kk + 1 < cap) dst[kk++] = s[at++]; dst[kk] = 0; }
    return 1;
}
static int implemented(const char *batches, size_t bn, const char *id) {
    size_t at = 0;
    while (at < bn) {
        size_t e = at; char name[128], impl[64];
        while (e < bn && batches[e] != '\n') e++;
        if (e > at && batches[at] != '#' && col(batches + at, e - at, 0, name, sizeof name) && !strcmp(name, id)) {
            if (col(batches + at, e - at, 1, impl, sizeof impl)) return !strcmp(impl, "IMPLEMENTED");
            return 0;
        }
        at = e + 1;
    }
    return -1;
}
/* is NAME declared anywhere in the materials columns (so `mi:NAME` names a real material)? */
static int material_declared(const char *batches, size_t bn, const char *name) {
    size_t at = 0, nl = strlen(name);
    while (at < bn) {
        size_t e = at;
        while (e < bn && batches[e] != '\n') e++;
        if (e > at && batches[at] != '#') {
            size_t k = at;
            while (k + nl <= e) {
                if (!memcmp(batches + k, name, nl) && (k == at || batches[k - 1] == '\t' || batches[k - 1] == ',' || batches[k - 1] == ';') &&
                    (k + nl == e || batches[k + nl] == '\t' || batches[k + nl] == ',' || batches[k + nl] == ';' || batches[k + nl] == '\n'))
                    return 1;
                k++;
            }
        }
        at = e + 1;
    }
    return 0;
}
/* validate one domain token; returns 1 when it is legal */
static int good_token(const char *t, const char *batches, size_t bn) {
    if (!strcmp(t, "serial") || !strcmp(t, "wt") || !strcmp(t, "hs") || !strcmp(t, "heavy")) return 1;
    if (!strncmp(t, "mi:", 3) && t[3]) return material_declared(batches, bn, t + 3);
    return 0;
}
int main(int argc, char **argv) {
    size_t n = 0, bn = 0;
    char *tab, *batches;
    char ids[MAXROWS][128];
    int rows = 0, i;
    if (argc > 3) die("usage: [-- ROOT]");
    if (argc == 3) { if (!realpath(argv[2], g_root)) die("root"); }
    else if (argc == 2) { if (!realpath(argv[1], g_root)) die("root"); }
    else if (sy_cwd(g_root, sizeof g_root) < 0) die("cwd");
    tab = slurp("tests/wave-domains.tsv", &n);
    batches = slurp("tests/batches.tsv", &bn);
    {   size_t at = 0;
        while (at < n) {
            size_t e = at; char id[128], dom[256], why[512], ev[512], detail[700];
            while (e < n && tab[e] != '\n') e++;
            if (e > at && tab[at] != '#') {
                int has_id = col(tab + at, e - at, 0, id, sizeof id);
                int has_dom = col(tab + at, e - at, 1, dom, sizeof dom);
                int has_why = col(tab + at, e - at, 2, why, sizeof why);
                int has_ev = col(tab + at, e - at, 3, ev, sizeof ev);
                if (!has_id || !id[0]) {
                    if (cx_fmt(detail, sizeof detail, "row=%d no id", rows + 1)) die("detail");
                    ck(0, "row-has-id", detail);
                    at = e + 1; continue;
                }
                if (rows >= MAXROWS) die("too many rows");
                {   size_t z; for (z = 0; id[z] && z + 1 < sizeof ids[0]; z++) ids[rows][z] = id[z]; ids[rows][z] = 0; }
                if (cx_fmt(detail, sizeof detail, "id=%s", id)) die("detail");
                ck(implemented(batches, bn, id) == 1, "id-is-an-implemented-batch", detail);
                if (cx_fmt(detail, sizeof detail, "id=%s domains=%s", id, has_dom ? dom : "")) die("detail");
                ck(has_dom && dom[0], "row-has-domains", detail);
                if (has_dom && dom[0]) {
                    size_t d = 0; int all_good = 1, ntok = 0, has_serial = 0;
                    while (dom[d]) {
                        char t[128]; size_t k = 0;
                        while (dom[d] && dom[d] != ',') { if (k + 1 < sizeof t) t[k++] = dom[d]; d++; }
                        t[k] = 0;
                        if (dom[d] == ',') d++;
                        if (!t[0]) continue;
                        ntok++;
                        if (!strcmp(t, "serial")) has_serial = 1;
                        if (!good_token(t, batches, bn)) all_good = 0;
                    }
                    if (cx_fmt(detail, sizeof detail, "id=%s domains=%s", id, dom)) die("detail");
                    ck(all_good, "domains-are-known-tokens", detail);
                    if (cx_fmt(detail, sizeof detail, "id=%s tokens=%d", id, ntok)) die("detail");
                    ck(!(has_serial && ntok > 1), "serial-is-exclusive", detail);
                }
                if (cx_fmt(detail, sizeof detail, "id=%s", id)) die("detail");
                ck(has_why && why[0] && has_ev && ev[0], "row-has-reason-and-evidence", detail);
                rows++;
            }
            at = e + 1;
        } }
    ck(rows > 0, "table-not-empty", "");
    for (i = 0; i < rows; i++) {
        int j;
        for (j = 0; j < i; j++) if (!strcmp(ids[i], ids[j])) break;
        if (j < i) { char detail[200]; if (cx_fmt(detail, sizeof detail, "id=%s", ids[i])) die("detail"); ck(0, "no-duplicate-id", detail); }
    }
    ck(1, "no-duplicate-id", "");
    printf("WAVE_DOMAINS\trows=%d\tassertions=%d\tfailed=%d\n", rows, asserts, failed);
    return failed ? 1 : 0;
}
