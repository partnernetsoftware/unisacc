/* Native, deterministic ELF fixture and byte-exact UNIKERN1 check.
 * Run: tests/kernel-link.cx -- fixture arm64|x86_64 OBJECT [bad-machine|bad-extent|bad-string|bad-scale|missing|duplicate|bad-entry|bad-target|duplicate-reloc]
 * Then tools/kernel-link.cx -- ISA BLOB OBJECT, and this tool -- check ISA BLOB.
 * Each fixture is constructed separately from the linker implementation.
 */
#pragma unisa use cxlib.elfkernel
#pragma unisa use text.text
static void kl_put(unsigned char *p, unsigned n, unsigned long long v) { unsigned i; for (i = 0; i < n; i++) p[i] = (unsigned char)(v >> (i * 8)); }
static unsigned long long kl_get(unsigned char *p, unsigned n) { unsigned i; unsigned long long v = 0; for (i = 0; i < n; i++) v |= (unsigned long long)p[i] << (i * 8); return v; }
static void kl_section(unsigned char *p, unsigned name, unsigned type, unsigned flags, unsigned off, unsigned size, unsigned link, unsigned info, unsigned align, unsigned entsize) {
    kl_put(p, 4, name); kl_put(p + 4, 4, type); kl_put(p + 8, 8, flags); kl_put(p + 24, 8, off); kl_put(p + 32, 8, size);
    kl_put(p + 40, 4, link); kl_put(p + 44, 4, info); kl_put(p + 48, 8, align); kl_put(p + 56, 8, entsize);
}
static int kl_fixture(int argc, char **argv) {
    unsigned char obj[848], expected[64], got[65]; unsigned arm; FILE *f; const char *mode; size_t n;
    if (argc < 4 || (strcmp(argv[2], "arm64") && !tx_eqz(argv[2], "x86_64"))) return 2;
    arm = tx_eqz(argv[2], "arm64");
    if (tx_eqz(argv[1], "check")) {
        memset(expected, 0, sizeof expected); memcpy(expected, "UNIKERN1", 8); kl_put(expected + 8, 8, arm ? 1 : 2);
        kl_put(expected + 24, 8, 16); kl_put(expected + 32, 8, 24);
        if (arm) kl_put(expected + 40, 4, 0x94000000ULL);
        else { expected[40] = 0xe8; expected[41] = 0xfb; expected[42] = 255; expected[43] = 255; expected[44] = 255; expected[45] = 0xc3; }
        f = fopen(argv[3], "rb"); if (!f) return 1;
        n = fread(got, 1, sizeof got, f); fclose(f);
        if (n != sizeof expected || memcmp(expected, got, sizeof expected)) return 1;
        puts("PASS byte-exact UNIKERN1 fixture"); return 0;
    }
    if (!tx_eqz(argv[1], "fixture")) return 2;
    mode = argc > 4 ? argv[4] : "ok";
    memset(obj, 0, sizeof obj); memcpy(obj, "\177ELF", 4); obj[4] = 2; obj[5] = 1; obj[6] = 1;
    kl_put(obj + 16, 2, 1); kl_put(obj + 18, 2, arm ? 183 : 62); kl_put(obj + 20, 4, 1); kl_put(obj + 40, 8, 336);
    kl_put(obj + 52, 2, 64); kl_put(obj + 58, 2, 64); kl_put(obj + 60, 2, 8); kl_put(obj + 62, 2, 7);
    if (arm) kl_put(obj + 64, 4, 0x94000000ULL); else { obj[64] = 0xe8; obj[69] = 0xc3; }
    kl_put(obj + 88, 8, arm ? 0 : 1); kl_put(obj + 96, 8, (2ULL << 32) | (arm ? 283 : 4)); kl_put(obj + 104, 8, arm ? 0 : ~3ULL);
    obj[140] = 3; kl_put(obj + 142, 2, 1);
    kl_put(obj + 160, 4, 1); obj[164] = 0x12; kl_put(obj + 166, 2, 1);
    kl_put(obj + 184, 4, 15); obj[188] = 0x11; kl_put(obj + 190, 2, 2);
    memcpy(obj + 208, "\0_kernel_entry\0_kernel_service\0", 31);
    memcpy(obj + 272, "\0.text\0.data\0.bss\0.rela.text\0.symtab\0.strtab\0.shstrtab\0", 55);
    kl_section(obj + 400, 1, 1, 6, 64, 16, 0, 0, 16, 0);
    kl_section(obj + 464, 7, 1, 3, 80, 8, 0, 0, 8, 0);
    kl_section(obj + 528, 13, 8, 3, 88, 0, 0, 0, 8, 0);
    kl_section(obj + 592, 18, 4, 0, 88, 24, 5, 1, 8, 24);
    kl_section(obj + 656, 29, 2, 0, 112, 96, 6, 2, 8, 24);
    kl_section(obj + 720, 37, 3, 0, 208, 64, 0, 0, 1, 0);
    kl_section(obj + 784, 45, 3, 0, 272, 64, 0, 0, 1, 0);
    if (tx_eqz(mode, "bad-machine")) kl_put(obj + 18, 2, 1);
    else if (tx_eqz(mode, "bad-extent")) kl_put(obj + 432, 8, ~0ULL);
    else if (tx_eqz(mode, "bad-string")) kl_put(obj + 160, 4, 64);
    else if (tx_eqz(mode, "missing")) kl_put(obj + 166, 2, 0);
    else if (tx_eqz(mode, "duplicate")) kl_put(obj + 184, 4, 1);
    else if (tx_eqz(mode, "bad-entry")) kl_put(obj + 168, 8, 16);
    else if (tx_eqz(mode, "bad-target")) kl_put(obj + 104, 8, 67108864);
    else if (tx_eqz(mode, "duplicate-reloc")) {
        /* Reuse the same 24-byte record extent for a second RELA section:
         * distinct headers targeting the same code must be rejected. */
        kl_section(obj + 528, 18, 4, 0, 88, 24, 5, 1, 8, 24);
    }
    else if (tx_eqz(mode, "bad-scale")) {
        if (!arm) return 2;
        kl_put(obj + 64, 4, 0xf9400000ULL); kl_put(obj + 96, 8, (3ULL << 32) | 286); kl_put(obj + 104, 8, 1);
    } else if (!tx_eqz(mode, "ok")) return 2;
    f = fopen(argv[3], "wb"); if (!f) return 1;
    n = fwrite(obj, 1, sizeof obj, f); if (fclose(f) || n != sizeof obj) return 1;
    return 0;
}
static int kl_checks,kl_failed;
static void kl_check(int ok,const char *name){kl_checks++;if(!ok)kl_failed++;printf("%s\tkernel-link.%s\n",ok?"PASS":"FAIL",name);}
static void kl_path(char *out,size_t n,const char *dir,const char *name){int k=snprintf(out,n,"%s/%s",dir,name);if(k<0||(size_t)k>=n)exit(2);}
static int kl_batch(const char *dir){
 if(dir[0]!='/'||mkdir(dir,0700))return 2;int i;char obj[4400],blob[4400],why[256],name[100];
 const char *arch[]={"x86_64","arm64"};
 for(i=0;i<2;i++){
  snprintf(name,sizeof name,"positive-%s.o",arch[i]);kl_path(obj,sizeof obj,dir,name);snprintf(name,sizeof name,"positive-%s.kernel",arch[i]);kl_path(blob,sizeof blob,dir,name);
  char *v[]={"kernel-link.cx","fixture",(char *)arch[i],obj,"ok",0};if(kl_fixture(5,v))return 2;
  const char *paths[]={obj};ek_result r=ek_link(i?1:2,blob,paths,1,why,sizeof why);kl_check(r.status==EK_OK,"positive-link");
  char *c[]={"kernel-link.cx","check",(char *)arch[i],blob,0};kl_check(r.status==EK_OK&&!kl_fixture(4,c),"independent-full-blob-bytes");
  r=ek_link(i?1:2,blob,paths,1,why,sizeof why);kl_check(r.status==EK_IO&&!kl_fixture(4,c),"exclusive-output-preserved");
 }
 const char *modes[]={"bad-machine","bad-extent","bad-string","missing","duplicate","bad-entry","bad-target","duplicate-reloc","bad-scale"};
 const char *reasons[]={"header","extent","symbol name","undefined global","duplicate global","entry","outside image","multiple RELA","scale"};
 for(i=0;i<9;i++){
  snprintf(name,sizeof name,"%s.o",modes[i]);kl_path(obj,sizeof obj,dir,name);snprintf(name,sizeof name,"%s.kernel",modes[i]);kl_path(blob,sizeof blob,dir,name);
  char *v[]={"kernel-link.cx","fixture",i==8?"arm64":"x86_64",obj,(char *)modes[i],0};if(kl_fixture(5,v))return 2;
  const char *paths[]={obj};ek_result r=ek_link(i==8?1:2,blob,paths,1,why,sizeof why);struct stat st;int missing=lstat(blob,&st)!=0&&errno==ENOENT;
  kl_check(r.status==EK_REJECT&&missing&&strstr(why,reasons[i]),modes[i]);if(r.status!=EK_REJECT||!strstr(why,reasons[i]))fprintf(stderr,"DETAIL\t%s\tstatus=%d\treason=%s\n",modes[i],r.status,why);
 }
 kl_path(obj,sizeof obj,dir,"directory-input");if(mkdir(obj,0700))return 2;kl_path(blob,sizeof blob,dir,"directory-input.kernel");const char *paths[]={obj};ek_result r=ek_link(2,blob,paths,1,why,sizeof why);kl_check(r.status==EK_REJECT&&strstr(why,"not regular"),"directory-before-open-refused");
 printf("KERNEL_LINK\tassertions=%d\tfailed=%d\tscope=synthetic-ELF-and-header\n",kl_checks,kl_failed);return kl_failed?1:0;
}
int main(int argc,char **argv){if(argc==3&&tx_eqz(argv[1], "batch"))return kl_batch(argv[2]);return kl_fixture(argc,argv);}
