/* ROOT HOST_CTX MODELS PAYLOAD STAGE1 STAGE2 STAGE3 SOURCE_CTX PACK_CTX OUT.
 * The existing full 41-assertion hostseed batch remains separate. This batch
 * requires its fixed P3 payload to be the live source-package output and
 * actually verifies the source job/model DAG after checking the chain.
 */
#pragma unisa use cxlib.netpack
static char root[4096],host_ctx[4096],models[4096],payload[4096],stage[3][4096],source_ctx[4096],pack_ctx[4096],work[4096];
static char bound[4400],product[4400],host_tool[4400],pack_tool[4400];
static char watched[12][4400],before[12][65];static int nw,checks,failed;
static void die(const char *why){fprintf(stderr,"hostseed-source-bind: REFUSE %s errno=%d\n",why,errno);exit(2);}
static void copy_fit(char *dst,size_t cap,const char *src){size_t i=0;if(!cap)die("copy-bound");while(src[i]&&i+1<cap){dst[i]=src[i];i++;}if(src[i])die("copy-bound");dst[i]=0;}
static void join(char *out,size_t cap,const char *dir,const char *name){int n=snprintf(out,cap,"%s/%s",dir,name);if(n<0||(size_t)n>=cap)die("path-bound");}
static int within(const char *p,const char *base){size_t n=strlen(base);return !strncmp(p,base,n)&&(!p[n]||p[n]=='/');}
static void ck(int ok,const char *name){checks++;if(!ok)failed++;printf("%s\thostseed-source-bind.%s\n",ok?"PASS":"FAIL",name);}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input-absent":"input-stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>134217728)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK);if(fd<0||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)die("input-descriptor");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("read-extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||bad||closed)die("input-changed");s[*n]=0;return s;}
static void hash(const char *p,char out[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,out);free(s);}
static void watch(const char *dir,const char *name){if(nw==12)die("watch-capacity");join(watched[nw],sizeof watched[nw],dir,name);hash(watched[nw],before[nw]);nw++;}
static void save(const char *name,const char *s,size_t n){char p[4400];join(p,sizeof p,work,name);int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-evidence");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("evidence-write");at+=(size_t)z;}if(fsync(fd)||close(fd))die("evidence-close");}
static void run(char **argv,int seconds,const char *name,const char *expected){char why[1024],file[120],status[40];np_result r;if(np_run(argv,root,0,seconds+2,&r,why,sizeof why))die(why);{int zn=snprintf(file,sizeof file,"%s.stdout",name);if(zn<0||(size_t)zn>=sizeof file)die("evidence-path");}save(file,r.out,r.outn);{int zn=snprintf(file,sizeof file,"%s.stderr",name);if(zn<0||(size_t)zn>=sizeof file)die("evidence-path");}save(file,r.err,r.errn);int n=snprintf(status,sizeof status,"rc\t%d\n",r.rc);{int zn=snprintf(file,sizeof file,"%s.status",name);if(zn<0||(size_t)zn>=sizeof file)die("evidence-path");}save(file,status,(size_t)n);int ok=!r.rc&&!r.errn&&r.outn==strlen(expected)&&!memcmp(r.out,expected,r.outn);ck(ok,name);if(!ok){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("live-chain-or-source-package-required");}np_free(&r);}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN hostseed-source-bind requires Linux/x86_64\n",stderr);return 3;
#endif
 if(argc!=11||!realpath(argv[1],root)||!realpath(argv[2],host_ctx)||!realpath(argv[3],models)||!realpath(argv[4],payload)||!realpath(argv[8],source_ctx)||!realpath(argv[9],pack_ctx)||argv[10][0]!='/'||strlen(argv[10])>=sizeof work)die("usage ROOT HOST_CTX MODELS PAYLOAD STAGE1 STAGE2 STAGE3 SOURCE_CTX PACK_CTX NEW_ABS_OUT");for(int i=0;i<3;i++)if(!realpath(argv[5+i],stage[i]))die("stage-realpath");if(!strcmp(stage[0],stage[1])||!strcmp(stage[0],stage[2])||!strcmp(stage[1],stage[2]))die("distinct-stages-required");char packed[4400];join(packed,sizeof packed,pack_ctx,"compiler.pkg");if(strcmp(payload,packed))die("payload-must-be-live-pack-context-package");char parent[4096],base[4096],leaf[4096];copy_fit(parent,sizeof parent,argv[10]);char *slash=strrchr(parent,'/');if(!slash||!slash[1]||!strcmp(slash+1,".")||!strcmp(slash+1,".."))die("output-leaf");copy_fit(leaf,sizeof leaf,slash+1);if(slash==parent)slash[1]=0;else *slash=0;if(!realpath(parent,base))die("output-parent");int z=snprintf(work,sizeof work,"%s%s%s",base,!strcmp(base,"/")?"":"/",leaf);if(z<0||(size_t)z>=sizeof work||within(work,host_ctx)||within(work,source_ctx)||within(work,pack_ctx)||within(work,stage[0])||within(work,stage[1])||within(work,stage[2]))die("output-aliases-input");if(mkdir(work,0700))die("new-output-required");join(bound,sizeof bound,root,"tools/bound");join(product,sizeof product,root,"unisacc.com");join(host_tool,sizeof host_tool,root,"tools/hostseed-step.cx");join(pack_tool,sizeof pack_tool,root,"tools/source-package-pack.cx");
 watch(root,"unisacc.com");watch(root,"tools/hostseed-step.cx");watch(root,"tools/source-package-pack.cx");watch(root,"tests/hostseed-source-bind.cx");watch(host_ctx,"context.tsv");watch(source_ctx,"context.tsv");watch(pack_ctx,"context.tsv");watch(pack_ctx,"compiler.pkg");for(int i=0;i<3;i++)watch(stage[i],"stage.tsv");
 char *host_argv[]={bound,"20","sh",product,host_tool,"--","--verify-chain",root,host_ctx,models,payload,stage[0],stage[1],stage[2],0};const char *host_expected="VERIFIED\thostseed-fixed-P3-chain\tstages=3\tno-N22-no-test-result\nNOT_CLAIMED\tindependent-initial-source-measurement-hermetic-host-build-NN-or-ASM-kernel-source-rebuild-complete-N22-or-foreign-hosts\n";run(host_argv,20,"hostseed",host_expected);
 char *pack_argv[]={bound,"35","sh",product,pack_tool,"--","--verify",root,source_ctx,pack_ctx,0};run(pack_argv,35,"source-package","VERIFIED\tsource-package-v1\tpure-read-no-NN-construction-no-test-result\n");
 for(int i=0;i<nw;i++){char now[65],name[80];hash(watched[i],now);{int zn=snprintf(name,sizeof name,"input-%d-unchanged",i);if(zn<0||(size_t)zn>=sizeof name)die("evidence-path");}ck(!strcmp(now,before[i]),name);}char a[65],b[65];hash(models,a);hash(product,b);ck(!strcmp(a,b),"models-is-installed-candidate");puts("NOT_CLAIMED\thistorical-source-execution-independent-initial-source-measurement-hermetic-host-build-classic18-MODEL-in-P3-complete-N22-or-foreign-hosts");printf("HOSTSEED_SOURCE_BIND\tassertions=%d\tfailed=%d\tscope=live-source-package-after-fixed-P3-chain\n",checks,failed);return failed?1:0;
}
