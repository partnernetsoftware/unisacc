/* ROOT RUNTIME_MAT DATA_MAT NEW_ABS_OUT CASE_ID; caller tools/bound 55.
 * One independently executed production-model variant per command. Prepare
 * source via ri-material, flow-native via ri-flow-material compile/seal, then data
 * via flow-native prepare separately. The profile uses default libc trimming.
 * No product/model construction, archived verdict or synthetic NN in this test.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.riflowmaterial
#pragma unisa use text.text
static char root[4096],runtime[4096],data[4096],work[4096],product[4400],tool[4400],bound[4400],image[4400],caseout[4400];
static int assertions,failures;
static void die(const char *s){fprintf(stderr,"ri-flow-parent: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void join(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path bound");}
static void ck(int ok,const char *s){assertions++;if(!ok)failures++;printf("%s\tri-flow-parent.%s\n",ok?"PASS":"FAIL",s);}
static char *load(const char *p,size_t *n){struct stat a,b;if(lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)die("bounded regular input");int fd=open(p,O_RDONLY|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK);if(fd<0||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)die("input descriptor");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("input extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||bad||closed)die("input changed");s[*n]=0;return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void save(const char *name,const char *s,size_t n){char p[4400];join(p,work,name);int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive evidence");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("evidence write");at+=(size_t)z;}if(close(fd))die("evidence close");}
static np_result call(char **v,int seconds,const char *label){char why[1024],name[160],status[40];if(unsetenv("UNISACC_RF_CAPTURE")||unsetenv("UNISA_ATTRIBUTES"))die("clear ambient resource state");np_result r;if(np_run(v,root,0,seconds,&r,why,sizeof why))die(why);snprintf(name,sizeof name,"%s.stdout",label);save(name,r.out,r.outn);snprintf(name,sizeof name,"%s.stderr",label);save(name,r.err,r.errn);int n=snprintf(status,sizeof status,"rc\t%d\n",r.rc);snprintf(name,sizeof name,"%s.status",label);save(name,status,(size_t)n);return r;}
static void verify(const char *label){char reported[65],actual[65];size_t bytes,n;int rc=rfm_verify_native(root,runtime,reported,&bytes);char *s=load(image,&n);cx_sha256_hex(s,n,actual);free(s);int ok=!rc&&n==bytes&&tx_eqz(actual, reported)&&tx_eqz(rfm_flags(), "-O2 -b lnx/x86_64 -o -");ck(ok,label);if(!ok)die("sealed flow profile prerequisite");printf("VERIFIED\tri-flow-native\tartifact=%s\tbytes=%lu\tflags=%s\tno-test-result\n",reported,(unsigned long)bytes,rfm_flags());}
static void pass(np_buf *b,const char *s){np_puts(b,"PASS\tri-flow.");np_puts(b,s);np_puts(b,"\n");}
static int transcript(const np_result *r,const char *mode,int lower){np_buf a={0},b={0};pass(&a,"data-before");pass(&a,"actual-snapshot-load");if(lower){pass(&a,"production-tapecheck-e4-prune-accept");pass(&a,"upstream-E3-and-consumer-lower-inputs-differ");pass(&a,"production-lower-accept");}else pass(&a,"production-E3-accept");pass(&a,"actual-SC2-consumer-input-identity");if(lower)np_puts(&a,"OBSERVATION\tlower-attributes-fetches=");else pass(&a,"actual-E3-model-attributes-fetch-presence-and-bytes");
 if(lower)np_puts(&b,"\tno-attributes-consumption-claim\n");pass(&b,"production-remaining-route-accept");pass(&b,"actual-ELF64-x86_64-output");pass(&b,"data-after");np_puts(&b,"NOT_CLAIMED\tfull-RI-domain-production-CLI-route-integration-foreign-hosts-or-general-memory-safety\n");char summary[240];snprintf(summary,sizeof summary,"RI_FLOW\tcase=%s\tassertions=%d\tfailed=0\tscope=actual-production-P3-model-source-adapter\n",mode,lower?9:8);np_puts(&b,summary);
 int ok=!r->rc&&!r->errn&&r->outn>=a.n+b.n&&!memcmp(r->out,a.p,a.n);size_t at=a.n;if(ok&&lower){size_t start=at;unsigned count=0;while(at<r->outn&&r->out[at]>='0'&&r->out[at]<='9'){if(count>4096){ok=0;break;}count=count*10+(unsigned)(r->out[at++]-'0');}if(at==start||count>4096)ok=0;}ok=ok&&r->outn-at==b.n&&!memcmp(r->out+at,b.p,b.n);free(a.p);free(b.p);return ok;}
static int inside(const char *p,const char *base){size_t n=strlen(base);return !strncmp(p,base,n)&&(!p[n]||p[n]=='/');}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN ri-flow-parent requires Linux/x86_64\n",stderr);return 3;
#endif
 if(argc!=6||!realpath(argv[1],root)||!realpath(argv[2],runtime)||!realpath(argv[3],data)||argv[4][0]!='/'||strlen(argv[4])>=sizeof work)die("usage ROOT RUNTIME_MAT DATA_MAT NEW_ABS_OUT CASE_ID");const char *mode=argv[5];int lower=!strcmp(mode,"e3-to-lower");if(!lower&&!tx_eqz(mode, "e3-empty")&&!tx_eqz(mode, "e3-absent")&&!tx_eqz(mode, "e3-missing"))die("unknown CASE_ID");
 char parent[4096],base[4096],leaf[4096];strcpy(parent,argv[4]);char *slash=strrchr(parent,'/');if(!slash||!slash[1]||tx_eqz(slash+1, ".")||tx_eqz(slash+1, ".."))die("output leaf");strcpy(leaf,slash+1);if(slash==parent)slash[1]=0;else *slash=0;if(!realpath(parent,base))die("output parent");int z=snprintf(work,sizeof work,"%s%s%s",base,tx_eqz(base, "/")?"":"/",leaf);if(z<0||(size_t)z>=sizeof work||inside(work,runtime)||inside(work,data))die("output aliases input material");if(mkdir(work,0700))die("new private output");join(caseout,work,"case");join(product,root,"unisacc.com");join(tool,root,"tools/ri-flow-material.cx");join(bound,root,"tools/bound");join(image,runtime,"flow-native");
 char watched[7][4400],before[7][65],after[65];join(watched[0],root,"unisacc.com");join(watched[1],root,"tests/cases/ri-flow.cx");join(watched[2],runtime,"flow-native");join(watched[3],runtime,"runtime.c");join(watched[4],runtime,"material.tsv");join(watched[5],runtime,"flow-native.tsv");join(watched[6],data,"material.tsv");for(int i=0;i<7;i++){digest(watched[i],before[i]);printf("INPUT\t%s\tsha256=%s\n",watched[i],before[i]);}verify("material-before");
 char *v[]={bound,"12",image,(char *)mode,product,data,caseout,0};np_result r=call(v,14,"consumer");int ok=transcript(&r,mode,lower);ck(ok,"exact-actual-production-consumer-transcript");if(!ok&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);
 if(ok){char program[4400],ph[65];join(program,caseout,"program");digest(program,ph);char *run[]={bound,"2",program,0};r=call(run,4,"execute");int expected=!strcmp(mode,"e3-empty")||tx_eqz(mode, "e3-absent")?0:7;ck(r.rc==expected&&!r.outn&&!r.errn,"handwritten-constructor-image-exit-oracle");np_free(&r);digest(program,after);ck(tx_eqz(ph, after),"generated-image-unchanged");}
 for(int i=0;i<7;i++){digest(watched[i],after);char name[80];snprintf(name,sizeof name,"input-%d-unchanged",i);ck(tx_eqz(before[i], after),name);}verify("material-after");puts("NOT_CLAIMED\tfull-RI-domain-installed-product-API-route-or-foreign-host-qualification");puts("TIMING\tstartup_construction_loading_inference_output_validation_cold_hot=UNMEASURED");printf("RI_FLOW_RUNNER\tcase=%s\tassertions=%d\tfailed=%d\texecuted-cases=1\n",mode,assertions,failures);return failures?1:0;
}
