/* Preparation-stage finite role tests. No native ELF identity, old NN result,
 * complete origin DAG or current model construction is qualified here. Full
 * source-origin/mixed positive and mutation batches remain required. */
#pragma unisa use cxlib.mixedprofiles
#pragma unisa use cxlib.netpack
static int checks,failed;
static void ck(int ok,const char *s){checks++;if(!ok)failed++;printf("%s\tmixed-profiles.%s\n",ok?"PASS":"FAIL",s);}
static int role_tests(void){mp_profile p={0},old={0};
 ck(mp_get("legacy-329-e252-v1",&old)&&old.origin_context_version==1&&old.current_union_jobs==49,"legacy-contract-retained");
 ck(mp_pair("f9-ace3-v1","f9fff160a091ac0004db69fe8b2713a4c448c22c963b8db89e3a4e2624540ec2","ace3b44700ce593e99084edf299011be5730e4dac1f157f0b97e816f16ee5916",&p)&&p.origin_context_version==2&&p.current_models==3&&p.adopted_models==31&&p.current_union_jobs==43,"audited-31-same-3-diff-role");
 ck(strcmp(p.origin_bootstrap,p.controller_bootstrap)&&!strcmp(p.origin_bootstrap,"94b549d1fbbbb29f9068492c17866aa8ea072f950fe4c7519d86cd989d0bb7f1")&&!strcmp(p.controller_bootstrap,"d65c14744390932885660cf62c0ce77db7eeb4cefa46094909f1e05b0ba21b9f"),"original-root94-distinct-from-installed-d65");
 ck(!mp_pair("f9-ace3-v1",old.origin_source,old.current_source,&p)&&!p.id&&!p.origin_source,"wrong-epoch-clears-output");
 ck(!mp_pair("legacy-329-e252-v1","f9fff160a091ac0004db69fe8b2713a4c448c22c963b8db89e3a4e2624540ec2","ace3b44700ce593e99084edf299011be5730e4dac1f157f0b97e816f16ee5916",&p)&&!p.id,"new-pair-cannot-inherit-legacy-role");
 ck(!mp_get("caller-supplied-sha256",&p)&&!p.id&&!p.current_source,"unknown-profile-refused");
 ck(!mp_get(0,&p)&&!p.id&&!mp_get("f9-ace3-v1",0),"invalid-output-and-null-profile-refused");
 const char *relative=0,*sha=0;
 ck(mp_host_capture("f9-ace3-v1","/usr/bin/x86_64-linux-gnu-gcc-11",&relative,&sha)&&!strcmp(relative,"out/origin-host-data-v1/cc")&&!strcmp(sha,"821af3c74506283c179ca413bb33e6b528805a4dd8a5c09df125e5ad560a9e89"),"fixed-historical-cc-data-role");
 ck(!mp_host_capture("legacy-329-e252-v1","/usr/bin/x86_64-linux-gnu-gcc-11",&relative,&sha)&&!relative&&!sha&&!mp_host_capture("f9-ace3-v1","/usr/bin/cc",&relative,&sha)&&!relative&&!sha,"no-arbitrary-or-legacy-host-fallback");
 printf("MIXED_PROFILES\tassertions=%d\tfailed=%d\tscope=material-role-only-not-execution-qualification\n",checks,failed);return failed?1:0;}
/* Each invocation runs one actual native origin snapshot or one named refusal,
 * rather than hiding several long endpoints behind a single timeout. The
 * supplied complete capture and historical context are never edited. */
int main(int argc,char **argv){
 if(argc==1)return role_tests();
 if(argc!=11||strcmp(argv[1],"--origin-case")||argv[10][0]!='/'||mkdir(argv[10],0700)){fputs("usage: --origin-case positive|unknown-profile|legacy-v3|wrong-origin-spec|aliased-snapshot SOURCE_ROOT TOOL_ROOT LOGICAL_ROOT SNAPSHOT_ROOT LOGICAL_PC EXEC_PROFILE NATIVE_VERIFIER NEW_ABS_OUT\n",stderr);return 2;}
 mp_profile role={0};if(!mp_get("f9-ace3-v1",&role))return 2;
 char *v[]={argv[9],"--snapshot","--material-profile",(char *)role.id,"--source-root",argv[3],argv[4],argv[5],argv[6],argv[7],(char *)role.origin_source,argv[8],0};
 char *legacy[]={argv[9],"--snapshot",argv[4],argv[5],argv[6],argv[7],(char *)role.origin_source,argv[8],0};const char *reason=0;char **call=v;
 if(!strcmp(argv[2],"unknown-profile")){v[3]="unreviewed-profile";reason="unknown-material-profile";}
 else if(!strcmp(argv[2],"legacy-v3")){call=legacy;reason="explicit-material-profile-version-required";}
 else if(!strcmp(argv[2],"wrong-origin-spec")){v[10]="329cdb7077891074f638634dc7abdcd59ee39c368ad6ba1c2fcf867c3c63de2e";reason="unknown-material-profile-or-origin-source";}
 else if(!strcmp(argv[2],"aliased-snapshot")){v[8]=v[7];reason="origin-root-or-profile-role";}
 else if(strcmp(argv[2],"positive")){fputs("unknown origin case\n",stderr);return 2;}
 np_result r={0};char why[1200],p[4400];if(np_run(call,argv[4],0,50,&r,why,sizeof why)){fprintf(stderr,"%s\n",why);return 2;}
 if(cx_path_join(p,sizeof p,argv[10],"stdout")||cx_write(p,r.out,r.outn)||cx_path_join(p,sizeof p,argv[10],"stderr")||cx_write(p,r.err,r.errn))return 2;
 if(reason)ck(r.rc==2&&!r.outn&&strstr(r.err,reason),argv[2]);
 else{ck(!r.rc&&!r.errn&&strstr(r.out,"source-origin-snapshot-v2\n")&&strstr(r.out,"material-profile\tf9-ace3-v1\n"),"actual-child-and-parent-profile-parser-accept");ck(!r.rc&&strstr(r.out,"jobs\t107\n")&&strstr(r.out,"models\t34\n")&&strstr(r.out,"epoch-artifact\t94b549d1fbbbb29f9068492c17866aa8ea072f950fe4c7519d86cd989d0bb7f1\n")&&strstr(r.out,"epoch-record\tfe5d0aec94bdf46fd3816806a0afc412105494684415816af30f7b810fa52f75\n"),"actual-full-origin-DAG-and-original-root94-record");}
 np_free(&r);printf("MIXED_PROFILE_ORIGIN\tcase=%s\tassertions=%d\tfailed=%d\tscope=material-only-not-NN-functional-PASS\n",argv[2],checks,failed);return failed?1:0;
}
