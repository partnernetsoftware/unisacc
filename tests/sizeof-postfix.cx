/* ROOT MODELS|- NEW_ABS_OUT positive|refusal. Linux/x86_64 LP64 only.
 * Each child keeps a 12 s bound.
 * This probes an explicit private model package or the installed candidate;
 * it never installs anything and grants no cross-candidate/release coverage. */
#pragma unisa use cxlib.netpack
static char root[4096],product[4400],bound[4400],work[4096],models[4096];
static int checks,failed;static const char *mode;
static void die(const char *s){fprintf(stderr,"sizeof-postfix: %s errno=%d\n",s,errno);exit(2);}
static void path(char *p,size_t cap,const char *a,const char *b){int z=snprintf(p,cap,"%s/%s",a,b);if(z<0||(size_t)z>=cap)die("path-bound");}
static void check(const char *label,int ok){checks++;if(!ok)failed++;printf("SIZEOF_CHECK\t%s\t%s\n",ok?"PASS":"FAIL",label);}
static void save(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC,0600);if(fd<0)die("exclusive-output");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("output-write");at+=(size_t)z;}if(close(fd))die("output-close");}
static np_result invoke(const char *id,const char *src){char source[4400],leaf[180];snprintf(leaf,sizeof leaf,"%s.cx",id);path(source,sizeof source,work,leaf);save(source,src,strlen(src));
 char *v[10];int n=0;v[n++]=bound;v[n++]="12";v[n++]="sh";v[n++]=product;if(models[0]){v[n++]="--models";v[n++]=models;}v[n++]=source;v[n]=0;np_buf args={0,0,0};for(int i=0;i<n;i++){np_putll(&args,i);np_puts(&args,"\t");np_puts(&args,v[i]);np_puts(&args,"\n");}char ap[4400];snprintf(leaf,sizeof leaf,"%s.argv.tsv",id);path(ap,sizeof ap,work,leaf);save(ap,args.p,args.n);free(args.p);np_result r={0};char why[1200];if(np_run(v,root,0,14,&r,why,sizeof why))die(why);
 char p[4400];snprintf(leaf,sizeof leaf,"%s.stderr",id);path(p,sizeof p,work,leaf);save(p,r.err,r.errn);snprintf(leaf,sizeof leaf,"%s.stdout",id);path(p,sizeof p,work,leaf);save(p,r.out,r.outn);char st[40];int z=snprintf(st,sizeof st,"rc=%d\n",r.rc);snprintf(leaf,sizeof leaf,"%s.status",id);path(p,sizeof p,work,leaf);save(p,st,(size_t)z);return r;
}
static void positive(const char *id,const char *relative,int expected,const char *marker){char srcpath[4400],label[200];path(srcpath,sizeof srcpath,root,relative);size_t n;char *s=cx_read(srcpath,&n);if(!s||memchr(s,0,n))die("probe-source");np_result r=invoke(id,s);free(s);snprintf(label,sizeof label,"%s.expected-default-run-exit",id);check(label,r.rc==expected&&!r.errn);snprintf(label,sizeof label,"%s.output",id);check(label,marker?strstr(r.out,marker)!=0:!r.outn);np_free(&r);}
static void refusal(const char *id,const char *src,const char *diagnostic){char source[4400],leaf[180],label[200];snprintf(leaf,sizeof leaf,"%s.cx",id);path(source,sizeof source,work,leaf);np_result r=invoke(id,src);snprintf(label,sizeof label,"%s.named-refusal-and-source-path",id);check(label,r.rc==1&&r.errn&&strstr(r.err,diagnostic)&&strstr(r.err,source));snprintf(label,sizeof label,"%s.empty-stdout",id);check(label,!r.outn);np_free(&r);}
static void digest(const char *p,char h[65]){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode))die("identity-regular-file");size_t n;char *s=cx_read(p,&n);if(!s||n!=(size_t)st.st_size)die("identity-read");cx_sha256_hex(s,n,h);free(s);}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("sizeof-postfix: NOT_RUN requires Linux/x86_64 LP64\n",stderr);return 3;
#endif
 if(sizeof(long)!=8||sizeof(void *)!=8)return 3;
 if(argc!=5||!realpath(argv[1],root)||argv[3][0]!='/'||strlen(argv[3])>=sizeof work||(strcmp(argv[4],"positive")&&strcmp(argv[4],"refusal")))die("usage ROOT MODELS|- NEW_ABS_OUT positive|refusal");if(strcmp(argv[2],"-")&&!realpath(argv[2],models))die("model-package");strcpy(work,argv[3]);mode=argv[4];if(mkdir(work,0700))die("new-output-required");path(product,sizeof product,root,"unisacc.com");path(bound,sizeof bound,root,"tools/bound");
 char before[65],after[65],mb[65],ma[65];digest(product,before);if(models[0])digest(models,mb);
 if(!strcmp(mode,"positive")){positive("indexed-argument","tests/pending/sizeof-indexed-member-arg.cx",7,0);positive("postfix-controls","tests/pending/sizeof-indexed-postfix-controls.cx",0,"SIZEOF_INDEXED_POSTFIX\n");positive("prior-member-controls","tests/pending/sizeof-member-controls.cx",0,"SIZEOF_MEMBER_CONTROL_PASS\n");positive("prior-global-member","tests/pending/sizeof-global-member.cx",0,"SIZEOF_GLOBAL_MEMBER");}
 else{refusal("missing-member","typedef struct {char name[32];} Row;static Row rows[2];static int width(unsigned long n){return n==32?7:1;}int main(void){int i=0;return width(sizeof rows[i].missing);}\n","not covered: member access");positive("recover-after-member","tests/pending/sizeof-indexed-member-arg.cx",7,0);refusal("bitfield","struct Bits{unsigned int field:3;};static struct Bits rows[2];int main(void){int i=0;return sizeof rows[i].field;}\n","not covered: bit-field storage unit");positive("recover-after-bitfield","tests/pending/sizeof-indexed-member-arg.cx",7,0);}
 digest(product,after);check("product-sha-stable",!strcmp(before,after));printf("IDENTITY\tproduct=%s\n",before);if(models[0]){digest(models,ma);check("private-package-sha-stable",!strcmp(mb,ma));printf("IDENTITY\tpackage=%s\n",mb);}
 printf("SIZEOF_POSTFIX\tmode=%s\tchecks=%d\tfailed=%d\tscope=explicit-local-model-contract\n",mode,checks,failed);return failed?1:0;
}
