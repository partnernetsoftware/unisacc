/* Independent input gold: real three-package builds and executable behavior.
 * NEW_RELATIVE_OUT only; all mutations belong to this new fixture directory. */
#pragma unisa use workspace.driver
static char work[4096],manifest[4400];static int checks,failed,sequence;
static void fail(const char *s){fprintf(stderr,"workspace-inputs: %s errno=%d\n",s,errno);exit(2);}
static void check(int ok,const char *name){checks++;if(!ok)failed++;printf("%s\tworkspace-inputs.%s\n",ok?"PASS":"FAIL",name);fflush(stdout);}
static void path(char out[4400],const char *name){if(snprintf(out,4400,"%s/%s",work,name)>=4400)fail("path");}
static void save(const char *name,const char *data){char p[4400];path(p,name);if(cx_write(p,data,strlen(data)))fail("save");}
static char *load(const char *name){char p[4400];path(p,name);size_t n;char *s=cx_read(p,&n);if(!s)fail("load");return s;}
static int command(const char *mode,const char *output,const char *package,char **text){char p[4400],log[4400],name[100];path(p,output);snprintf(name,sizeof name,"%02d-%s.log",++sequence,mode);path(log,name);pid_t pid=fork();if(pid<0)fail("fork");if(!pid){int fd=open(log,O_WRONLY|O_CREAT|O_EXCL,0600);if(fd<0)_exit(99);dup2(fd,1);dup2(fd,2);close(fd);char *v[]={"workspace",(char *)mode,manifest,p,"lnx/x86_64",(char *)package,0};int rc=cxw_main(package?6:5,v);fflush(stdout);_exit(rc);}int status;if(waitpid(pid,&status,0)!=pid)fail("wait");size_t n;*text=cx_read(log,&n);if(!*text)fail("log");return WIFEXITED(status)?WEXITSTATUS(status):99;}
static int execute(const char *directory,const char *artifact,const char *provider){char name[200],program[4400],dependency[4400];snprintf(name,sizeof name,"%s/%s",directory,artifact);path(program,name);if(provider){snprintf(name,sizeof name,"%s/a",directory);path(dependency,name);}char *v[]={program,provider?dependency:0,0};char *out=0;size_t n=0;int rc=cx_runv_timeout(v,3,&out,&n);free(out);return n?99:rc;}
static const char *initial="#include \"headers/value.h\"\nstatic int private_value(void){return VALUE;}\nint main(void){return private_value();}\n";
static const char *changed="#include \"headers/value.h\"\nstatic int private_value(void){return VALUE+6;}\nint main(void){return private_value();}\n";
int main(int argc,char **argv){
 if(argc!=2||argv[1][0]=='/'||strstr(argv[1],"..")||strlen(argv[1])>=sizeof work)fail("usage NEW_RELATIVE_OUT");strcpy(work,argv[1]);if(mkdir(work,0700))fail("exclusive-fixture");char p[4400];path(p,"headers");if(mkdir(p,0700))fail("headers");path(p,"docs");if(mkdir(p,0700))fail("docs");
 save("a.c",initial);save("headers/value.h","#define VALUE 3\n");save("b.cx","int main(int argc,char **argv){if(argc!=2)return 101;char *v[]={argv[1],0};char *out=0;size_t n=0;int rc=cx_runv_timeout(v,2,&out,&n);free(out);return n?102:rc+2;}\n");save("c.c","int main(void){return 7;}\n");save("docs/note.txt","first documentation\n");
 char recipe[12000];int n=snprintf(recipe,sizeof recipe,"CXWORK1\nP\ta\t%s/a.c\ta\tunisacc\t8\nP\tb\t%s/b.cx\tb\tunisacc\t8\nP\tc\t%s/c.c\tc\tunisacc\t8\nI\ta\timplementation\tprivate-source\t%s/a.c\nG\ta\timplementation\theaders\t%s/headers\nI\tb\timplementation\tconsumer-source\t%s/b.cx\nG\tb\ttest\ttest-docs\t%s/docs\nI\tc\timplementation\tindependent-source\t%s/c.c\nD\tb\tnormal\ta\n",work,work,work,work,work,work,work,work);if(n<0||(size_t)n>=sizeof recipe)fail("recipe");save("workspace.tsv",recipe);path(manifest,"workspace.tsv");
 char *text=0;int rc=command("build","base",0,&text);check(!rc,"three-packages-actually-built");free(text);check(execute("base","a",0)==3&&execute("base","b","a")==5&&execute("base","c",0)==7,"independent-return3-consumer5-independent7-gold");
 save("docs/note.txt","changed documentation\n");save("docs/new.txt","new test input\n");rc=command("resume","base",0,&text);check(!rc&&strstr(text,"REVERIFIED_PREPARED\ta\t")&&strstr(text,"REVERIFIED_PREPARED\tb\t")&&strstr(text,"REVERIFIED_PREPARED\tc\t")&&!strstr(text,"\nPREPARED\t"),"test-document-add-change-reuses-all-builds");free(text);check(execute("base","b","a")==5,"documentation-reuse-still-actually-executes-consumer");
 save("a.c",changed);rc=command("resume","base","b",&text);check(rc==2&&strstr(text,"stale-build-receipt: a"),"private-source-invalidates-dependent-closure");free(text);rc=command("resume","base","c",&text);check(!rc&&strstr(text,"REVERIFIED_PREPARED\tc\t")&&execute("base","c",0)==7,"independent-package-reverified-and-executed");free(text);
 rc=command("build","private","b",&text);check(!rc&&!strstr(text,"PREPARED\tc\t")&&execute("private","a",0)==9&&execute("private","b","a")==11,"only-dependent-closure-rebuilt-return9-and11-gold");free(text);
 save("headers/extra.h","");rc=command("resume","private","a",&text);check(rc==2&&strstr(text,"stale-build-receipt: a"),"added-header-invalidates-prepared-artifact");free(text);rc=command("build","added","a",&text);check(!rc&&execute("added","a",0)==9,"added-header-actually-rebuilt-with-same-semantic-gold");free(text);text=load("added/a.receipt");check(strstr(text,"F\textra.h\t0\te3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\n")!=0,"empty-header-name-length-digest-handwritten-gold");free(text);
 path(p,"headers/extra.h");if(unlink(p))fail("remove-owned-header");rc=command("resume","added","a",&text);check(rc==2&&strstr(text,"stale-build-receipt: a"),"deleted-header-invalidates-prepared-artifact");free(text);
 save("headers/value.h","#define VALUE 4\n");rc=command("resume","private","a",&text);check(rc==2&&strstr(text,"stale-build-receipt: a"),"changed-header-invalidates-prepared-artifact");free(text);rc=command("build","changed","b",&text);check(!rc&&execute("changed","a",0)==10&&execute("changed","b","a")==12,"changed-header-actually-evaluated-return10-and12-gold");free(text);
 path(p,"changed/a");size_t bytes;char *artifact=cx_read(p,&bytes);if(!artifact||!bytes)fail("artifact");artifact[0]^=1;if(cx_write(p,artifact,bytes))fail("corrupt-owned-artifact");free(artifact);rc=command("resume","changed","a",&text);check(rc==2&&strstr(text,"artifact-digest-mismatch"),"corrupt-artifact-refused-before-execution");free(text);
 path(p,"headers/link.h");if(symlink("value.h",p))fail("owned-symlink");rc=command("plan","unused","a",&text);check(rc==2&&strstr(text,"directory-symlink-refused"),"directory-member-symlink-refused");free(text);if(unlink(p))fail("remove-owned-symlink");
 char roots[3][4400];path(roots[0],"missing-directory");path(roots[1],"a.c/child");path(roots[2],"headerroot-link");if(symlink("headers",roots[2]))fail("owned-root-symlink");
 for(int i=0;i<3;i++){char one[12000];int z=snprintf(one,sizeof one,"CXWORK1\nP\ta\t%s/a.c\ta\tunisacc\t8\nI\ta\timplementation\tprivate-source\t%s/a.c\nG\ta\timplementation\theaders\t%s\n",work,work,roots[i]);if(z<0||(size_t)z>=sizeof one)fail("root-recipe");save("workspace.tsv",one);rc=command("plan","unused","a",&text);check(rc==2&&strstr(text,i==0?"missing-directory-input":"directory-root-open")&&(i==0||!strstr(text,"missing-directory-input")),i==0?"missing-directory-is-enoent":i==1?"enotdir-is-not-missing":"root-symlink-refused");free(text);}
 if(unlink(roots[2]))fail("remove-owned-root-symlink");save("workspace.tsv",recipe);path(p,"headers");if(chmod(p,0000))fail("deny-owned-headers");rc=command("plan","unused","a",&text);int permission_denied=rc==2&&strstr(text,"directory-root-open")&&strstr(text,"errno=13");if(chmod(p,0700))fail("restore-owned-headers");check(permission_denied,"eacces-is-not-missing");free(text);
 printf("WORKSPACE_INPUTS\tassertions=%d\tfailed=%d\n",checks,failed);return failed?1:0;
}
