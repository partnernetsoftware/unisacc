/* ROOT NEW_OUT DUT MODELS [--multi]. Local osx product contract; DUT is explicit and
 * may be an APE launcher or a native Mach-O slice. No x64 image is executed. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sysx.process
#pragma unisa use sys.hostid
static char root[4096],out[4096],dut[4096];static int shell,checks,failed;
static void die(const char*s){fprintf(stderr,"DRIVER_DEFAULT_TAPE REFUSE %s errno=%d\n",s,errno);exit(2);}
static void ck(int yes,const char*s){checks++;failed+=!yes;printf("%s\t%s\n",yes?"PASS":"FAIL",s);}
static void path(char*p,const char*leaf){if(cx_fmt(p,4400,"%s/%s",out,leaf))die("path");}
static void save(const char*leaf,const char*s,size_t n){char p[4400];path(p,leaf);if(cx_write(p,s,n))die("evidence write");}
static char*dt_read(const char*p,size_t*n){char*s=cx_read(p,n);if(!s)die("input read");return s;}
static void hash(const char*p,char h[65]){size_t n;char*s=dt_read(p,&n);if(sy_sha256_hex(s,n,h))cx_sha256_hex(s,n,h);free(s);}
static int call(const char*tag,const char*target,const char*first,const char*second,const char*leaf){char dest[4400];path(dest,leaf);char*v[16];int n=0;if(shell)v[n++]="sh";v[n++]=dut;v[n++]="-S";if(target){v[n++]="-b";v[n++]=(char*)target;}v[n++]=(char*)first;if(second)v[n++]=(char*)second;v[n++]="-o";v[n++]=dest;v[n]=0;np_result r={0};char why[512];if(np_run(v,root,0,8,&r,why,sizeof why)||r.residue)die("bounded DUT execution");char name[128];if(cx_fmt(name,sizeof name,"%s.stdout",tag))die("label");save(name,r.out,r.outn);if(cx_fmt(name,sizeof name,"%s.stderr",tag))die("label");save(name,r.err,r.errn);int rc=r.rc;printf("JOB\t%s\trc=%d\n",tag,rc);np_free(&r);return rc;}
static int same(const char*a,const char*b){char p[4400],q[4400];path(p,a);path(q,b);size_t n,m;char*x=dt_read(p,&n),*y=dt_read(q,&m);int ok=n==m&&!memcmp(x,y,n);free(x);free(y);return ok;}
static int fingerprint(const char*leaf,int value){char p[4400],needle[80];path(p,leaf);size_t n;char*s=dt_read(p,&n);if(cx_fmt(needle,sizeof needle,"  imm r0, %d\n",value))die("fingerprint");char*m=strstr(s,"value:\n");if(!m)m=strstr(s,"main:\n");int ok=m&&strstr(m,needle);free(s);return ok;}
int main(int argc,char**argv){int multi=argc==6&&!strcmp(argv[5],"--multi");if((argc!=5&&!multi)||!realpath(argv[1],root)||!realpath(argv[3],dut)||argv[2][0]!='/'||cx_fmt(out,sizeof out,"%s",argv[2]))die("usage ROOT NEW_ABS_OUT DUT MODELS [--multi]");char models[4096],model_before[65],model_after[65];if(!realpath(argv[4],models)||setenv("UNISA_CONTAINER",models,1))die("explicit models");hash(models,model_before);printf("MODELS\tpath=%s\tsha256=%s\n",models,model_before);const char*native=tn_self();if(!native||strncmp(native,"osx/",4)){puts("NOT_RUN\tDRIVER_DEFAULT_TAPE\tosx-host-required");return 3;}if(mkdir(out,0700))die("new output directory");size_t dn;char*d=dt_read(dut,&dn);if(dn<4)die("DUT identity");shell=memcmp(d,"\xcf\xfa\xed\xfe",4)!=0;if(!shell){if(dn<32||d[12]!=2||d[13]||d[14]||d[15])die("native DUT must be MH_EXECUTE");if((unsigned char)d[4]==12&&!d[5]&&!d[6]&&d[7]==1)native="osx/arm64";else if(d[4]==7&&!d[5]&&!d[6]&&d[7]==1)native="osx/x86_64";else die("native DUT CPU");}free(d);char before[65],after[65];hash(dut,before);printf("DUT\tpath=%s\tsha256=%s\thost=%s\tdut_target=%s\tx64_execution=%s\n",dut,before,tn_self(),native,!shell&&!strcmp(native,"osx/x86_64")?(!strcmp(tn_self(),"osx/arm64")?"translated-MachO":"native"):"NOT_RUN");
const char*body="#if defined(__APPLE__) && defined(__aarch64__)\n#define FP 5\n#elif defined(__APPLE__) && defined(__x86_64__)\n#define FP 9\n#elif defined(__linux__) && defined(__x86_64__)\n#define FP 10\n#else\n#define FP 99\n#endif\n";char source[1024];if(cx_fmt(source,sizeof source,"%s%s",body,multi?"int value(void){return FP;}\n":"int main(void){return FP;}\n"))die("source bound");save("value.c",source,strlen(source));char first[4400],second[4400];path(first,"value.c");const char*extra=0;if(multi){const char*maintext="extern int value(void); int main(void){return value();}\n";save("main.c",maintext,strlen(maintext));path(first,"main.c");path(second,"value.c");extra=second;}
ck(call("bare",0,first,extra,"bare.tape")==0,"bare-S-accepts");ck(call("native",native,first,extra,"native.tape")==0,"explicit-native-accepts");ck(same("bare.tape","native.tape"),"bare-equals-explicit-native-complete-tape");ck(fingerprint("bare.tape",!strcmp(native,"osx/arm64")?5:9),"bare-platform-predefines-use-current-osx-slice");
if(!multi){ck(call("x64","osx/x86_64",first,0,"x64.tape")==0,"explicit-osx-x64-accepts");ck(fingerprint("x64.tape",9),"explicit-osx-x64-macro-fingerprint");ck(call("bare-s",0,first,0,"bare.s")==0&&same("bare.tape","bare.s"),"bare-dot-s-remains-tape");int rc=call("explicit-s","osx/arm64",first,0,"refused.s");char p[4400];path(p,"explicit-s.stderr");size_t en;char*err=dt_read(p,&en);const char*why="unisacc: error: assembly text (-S -b ... -o FILE.s) is written for Linux targets in this version (Mach-O and COFF text: 0.0.19); the target was osx/arm64\n";ck(rc==1&&en==strlen(why)&&!memcmp(err,why,en),"explicit-osx-dot-s-exact-refusal");free(err);path(p,"refused.s");struct stat st;errno=0;int z=lstat(p,&st);if(z&&errno!=ENOENT)die("refused output existence");ck(z&&errno==ENOENT,"refusal-creates-no-output");}
hash(models,model_after);ck(!strcmp(model_before,model_after),"MODELS-unchanged");hash(dut,after);ck(!strcmp(before,after),"DUT-unchanged");printf("DRIVER_DEFAULT_TAPE\tchecks=%d\tfailed=%d\tmode=%s\n",checks,failed,multi?"multi":"single");return failed?1:0;}
