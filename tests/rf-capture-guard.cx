/* Entry guard: a set UNISACC_RF_CAPTURE is refused by name before compile.
   Unset still compiles. Args: ROOT PRODUCT. An ELF product gets
   --models ROOT/unisacc.com. An APE product is started with sh.
   Not a suite batch. No raw libc: sys, text, and process only. */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use cxlib.netpack
static int fail(const char *s) { sy_eprintf("rf-capture-guard: %s\n", s); return 2; }
static int elf_file(const char *path) {
    unsigned char b[4];
    int fd = sy_open_read(path);
    int elf = 0;
    if (fd >= 0 && sy_read_full(fd, b, 4) == 0)
        elf = b[0] == 127 && b[1] == 'E' && b[2] == 'L' && b[3] == 'F';
    if (fd >= 0) sy_close(fd);
    return elf;
}
int main(int argc, char **argv) {
    char root[4096], product[4096], dir[4400], bound[4400], src[4400], obj[4400], models[4400], why[1200];
    char *v[16];
    char *env_set[] = {"UNISACC_RF_CAPTURE=1", 0};
    char *env_empty[] = {"UNISACC_RF_CAPTURE=", 0};
    const char *code = "int main(void){return 1;}\n";
    const char *want = "INTERFACE_ERROR resource-capture-not-migrated\n";
    np_result r;
    int n, elf, fd, failed = 0;
    long cn;
    if (argc != 3) return 2;
    if (sy_realpath(argv[1], root, (int)sizeof root) < 0) return fail("root");
    if (sy_realpath(argv[2], product, (int)sizeof product) < 0) return fail("product");
    if (sy_env("UNISACC_RF_CAPTURE")) return fail("parent already sets UNISACC_RF_CAPTURE");
    if (cx_fmt(dir, sizeof dir, "/tmp/rfcap-%d", sy_pid())) return fail("path");
    if (sy_mkdir(dir, 0700)) return fail("mkdir");
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", root)) return fail("path");
    if (cx_fmt(src, sizeof src, "%s/t.c", dir)) return fail("path");
    if (cx_fmt(obj, sizeof obj, "%s/t.o", dir)) return fail("path");
    if (cx_fmt(models, sizeof models, "%s/unisacc.com", root)) return fail("path");
    cn = tx_len(code, 64);
    fd = sy_open_new(src, 0600);
    if (fd < 0 || cn < 0 || sy_write_all(fd, code, cn) || sy_close(fd)) return fail("fixture");
    elf = elf_file(product);
    n = 0;
    v[n++] = bound; v[n++] = "20";
    if (!elf) v[n++] = "sh";
    v[n++] = product;
    if (elf) { v[n++] = "--models"; v[n++] = models; }
    v[n++] = "-c"; v[n++] = "-funit"; v[n++] = "-b"; v[n++] = "lnx/x86_64";
    v[n++] = src; v[n++] = "-o"; v[n++] = obj; v[n] = 0;
    if (np_run(v, root, env_set, 8, &r, why, sizeof why)) return fail(why);
    if (!(r.rc == 2 && r.outn == 0 && tx_same(r.err, (long)r.errn, want, tx_len(want, 80)) && sy_exists(obj) == 0)) {
        sy_eprintf("FAIL set rc=%d out=%ld err=%ld\n", r.rc, (long)r.outn, (long)r.errn);
        if (r.errn) sy_write_all(2, r.err, (long)r.errn);
        failed++;
    } else sy_printf("PASS\tset\trc=2\n");
    np_free(&r);
    if (np_run(v, root, env_empty, 8, &r, why, sizeof why)) return fail(why);
    if (!(r.rc == 2 && r.outn == 0 && tx_same(r.err, (long)r.errn, want, tx_len(want, 80)) && sy_exists(obj) == 0)) {
        sy_eprintf("FAIL empty rc=%d out=%ld err=%ld\n", r.rc, (long)r.outn, (long)r.errn);
        if (r.errn) sy_write_all(2, r.err, (long)r.errn);
        failed++;
    } else sy_printf("PASS\tempty\trc=2\n");
    np_free(&r);
    if (np_run(v, root, 0, 22, &r, why, sizeof why)) return fail(why);
    if (!(r.rc == 0 && sy_exists(obj) == 1 && tx_find(r.err, (long)r.errn, "resource-capture-not-migrated", 30) < 0)) {
        sy_eprintf("FAIL unset rc=%d out=%ld err=%ld\n", r.rc, (long)r.outn, (long)r.errn);
        if (r.errn) sy_write_all(2, r.err, (long)r.errn);
        failed++;
    } else sy_printf("PASS\tunset\trc=0\n");
    np_free(&r);
    sy_printf("RF_CAPTURE_GUARD\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
