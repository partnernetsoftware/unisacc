/* tests/check-literal.cx -- NN-NF ratchet: bare integer immediates in net actions.
 *
 *   sh ./unisacc.com tests/check-literal.cx [-- --check | --write | --count FILE]
 *
 * A "result" table holds decisions and mechanism; a domain value belongs in a fact,
 * referenced as ["constant","NAME"].  Counted: the last argument of CMPI, LDI, ALUI
 * and A64I when it is an integer other than 0 or 1.  tests/literal.tsv only goes
 * down: --check fails naming each file above its row, or a new file above 0. */
/* --check --files PATH... counts only named discovered result tables; baseline
 * or checker changes retain a complete scan. No output-only filtering. */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use text.text
static char *slurp(const char *p) {
    FILE *f = fopen(p, "rb"); size_t cap = 1 << 25, n; char *b;
    if (!f) return 0;
    b = malloc(cap); if (!b) { fclose(f); return 0; }
    n = fread(b, 1, cap - 1, f); fclose(f); b[n] = 0; return b;
}
static int is_op(const char *s) {
    return !strncmp(s, "\"CMPI\"", 6) || !strncmp(s, "\"LDI\"", 5) || !strncmp(s, "\"ALUI\"", 6) || !strncmp(s, "\"A64I\"", 6);
}
/* s points at the op inside one [...] action with no nested array before its end. */
static int action_counts(const char *s) {
    const char *end = s, *p;
    while (*end && *end != ']' && *end != '[' && *end != '\n') end++;
    if (*end != ']') return 0;
    p = end;
    while (p > s && (p[-1] == ' ')) p--;
    const char *q = p;
    while (q > s && q[-1] >= '0' && q[-1] <= '9') q--;
    if (q == p) return 0;
    if (q > s && q[-1] == '-') return 1;
    if (q > s && q[-1] != ',' && q[-1] != ' ') return 0;
    return !(p - q == 1 && (*q == '0' || *q == '1'));
}
static int count_file(const char *path) {
    char *t = slurp(path), *line; int c = 0;
    if (!t) return -1;
    for (line = t; line && *line; ) {
        char *nl = strchr(line, '\n'), *p;
        if (nl) *nl = 0;
        if (*line != '#') for (p = line; *p; p++) if (p[0] == '[' && is_op(p + 1) && action_counts(p + 1)) c++;
        line = nl ? nl + 1 : 0;
    }
    free(t); return c;
}
static int ends(const char *s, const char *x) { size_t a = strlen(s), b = strlen(x); return a >= b && !strcmp(s + a - b, x); }
static int baseline(const char *t, const char *path) {
    size_t n = strlen(path); const char *p = t;
    while (p && *p) {
        if (!strncmp(p, path, n) && p[n] == '\t') return atoi(p + n + 1);
        p = strchr(p, '\n'); if (p) p++;
    }
    return 0;
}
int main(int argc, char **argv) {
    int write = argc > 1 && !strcmp(argv[1], "--write"), bad = 0, total = 0;
    if (argc == 3 && !strcmp(argv[1], "--count")) { printf("LITERAL\t%d\n", count_file(argv[2])); return 0; }
    int scoped = argc >= 4 && !strcmp(argv[1], "--check") && !strcmp(argv[2], "--files"), full = !scoped, scanned = 0;
    if (!scoped && (argc > 2 || (argc == 2 && !write && strcmp(argv[1], "--check")))) { fputs("usage: check-literal.cx --check [--files PATH...]|--write|--count FILE\n", stderr); return 2; }
    /* Missing old paths from deletion/rename require the original full discovery. */
    for (int i = 3; scoped && i < argc; i++) if (access(argv[i], F_OK) || !strcmp(argv[i], "tests/literal.tsv") || !strcmp(argv[i], "tests/check-literal.cx")) full = 1;
    char *old = slurp("tests/literal.tsv"); FILE *o = 0;
    if (!old && !write) { fputs("LITERAL\tno baseline\n", stderr); return 2; }
    if (write) { o = fopen("tests/literal.tsv", "wb"); if (!o) return 2; fputs("# path\tcount\n", o); }
    DIR *e = opendir("exec"); struct dirent *de; static char names[512][300]; int nn = 0;
    if (!e) return 2;
    while ((de = readdir(e))) {
        char dir[300]; DIR *d; struct dirent *f;
        if (de->d_name[0] == '.' || cx_fmt(dir, sizeof dir, "exec/%s", de->d_name)) continue;
        d = opendir(dir); if (!d) continue;
        while ((f = readdir(d))) if (ends(f->d_name, "-result.tsv") && nn < 512 && !cx_fmt(names[nn], 300, "%s/%s", dir, f->d_name)) nn++;
        closedir(d);
    }
    closedir(e);
    qsort(names, (size_t)nn, 300, (int (*)(const void *, const void *))strcmp);
    for (int i = 0; i < nn; i++) {
        if (!full) { int selected = 0; for (int j = 3; j < argc; j++) if (!strcmp(names[i], argv[j])) selected = 1; if (!selected) continue; }
        scanned++;
        int c = count_file(names[i]); if (c < 0) return 2;
        total += c;
        if (write) { if (c) fprintf(o, "%s\t%d\n", names[i], c); }
        else if (c > baseline(old, names[i])) { printf("FAIL\t%s\t%d above %d\n", names[i], c, baseline(old, names[i])); bad++; }
    }
    if (o) fclose(o);
    printf("LITERAL\tfiles=%d\ttotal=%d\tstatus=%s\n", scanned, total, bad ? "FAIL" : "PASS");
    return bad ? 1 : 0;
}
