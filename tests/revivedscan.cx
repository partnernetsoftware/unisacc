#!/usr/bin/env -S unisacc.com -run
/* revivedscan.cx -- run every probe a knownfail list excuses and report the ones that now agree (0.0.25 P2), ported
   from tests/revivedscan.py (2026-10-22, the owner's direction: the toolchain moves off Python).
   0.0.24 lost a queue round to this: a front-end fix made a_externarr and the unary-plus probe agree, both were still
   listed in ccrun.knownwrong, and the release queue reported them as REVIVED (red) at 161/568.  This checks only the
   excused probes, so it is cheap enough to run on every front-end edit:
     sh ./unisacc.com -run tests/revivedscan.cx              scan; exit 1 when an entry is revived (drop it from the list)
     sh ./unisacc.com -run tests/revivedscan.cx -- --changed scan only when HEAD~1..worktree touches unisa/front or src/front_*
   Run from the repository root (ROOT is the working directory).  Python-route lists run `python3 -m unisa run`
   (PYTHONPATH defaults to ROOT); product lists run ./unisacc.com -run.  Each probe is bounded by tests/bound 15 and a
   20 s watchdog (142, no output, past it); the reference is the system cc.  Other arguments are ignored, as the .py
   ignores them.  The lists are read as UTF-8 with Python's splitlines/strip/split whitespace rules. */
#include <cx.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <fcntl.h>
#include <unistd.h>
#include <errno.h>
#include <dirent.h>

extern char **environ;
static char ROOT[4096];
static const char *LISTS[][2] = { { "tests/pyfront.knownfail", "python" }, { "tests/ccrun.knownwrong", "python" },
                                  { "tests/difftest.knownfail", "python" }, { "tests/difftest.com.knownfail", "product" },
                                  { "tests/product-refusals.knownfail", "product" } };
static char TD[4096];

/* one UTF-8 code point at s[i] (byte length in *l); -1 when the bytes are not valid UTF-8 */
static int cp_at(const unsigned char *s, size_t n, size_t i, int *l) {
    unsigned c = s[i], cp; int need, k;
    if (c < 0x80) { *l = 1; return (int)c; }
    if (c >= 0xC2 && c <= 0xDF) need = 1; else if (c >= 0xE0 && c <= 0xEF) need = 2; else if (c >= 0xF0 && c <= 0xF4) need = 3; else return -1;
    if (i + need >= n) return -1;
    cp = c & (0x3F >> need);
    for (k = 1; k <= need; k++) { if ((s[i + k] & 0xC0) != 0x80) return -1; cp = (cp << 6) | (s[i + k] & 0x3F); }
    if ((need == 2 && cp < 0x800) || (need == 3 && (cp < 0x10000 || cp > 0x10FFFF)) || (cp >= 0xD800 && cp <= 0xDFFF)) return -1;
    *l = need + 1; return (int)cp;
}
/* Python str.isspace */
static int pyspace(int c) {
    return (c >= 0x09 && c <= 0x0D) || (c >= 0x1C && c <= 0x20) || c == 0x85 || c == 0xA0 || c == 0x1680
        || (c >= 0x2000 && c <= 0x200A) || c == 0x2028 || c == 0x2029 || c == 0x202F || c == 0x205F || c == 0x3000;
}
/* Python str.splitlines boundaries */
static int pybreak(int c) { return c == '\n' || c == '\r' || c == 0x0B || c == 0x0C || c == 0x1C || c == 0x1D || c == 0x1E || c == 0x85 || c == 0x2028 || c == 0x2029; }

static void rmtree(const char *d) {
    DIR *dp = opendir(d); struct dirent *e; char p[8192]; struct stat st;
    if (dp) {
        while ((e = readdir(dp))) {
            if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
            snprintf(p, sizeof p, "%s/%s", d, e->d_name);
            if (lstat(p, &st) == 0 && S_ISDIR(st.st_mode)) rmtree(p); else unlink(p);
        }
        closedir(dp);
    }
    rmdir(d);
}
static void die(const char *fmt, const char *a) {   /* the .py's uncaught exception: stdout so far, a message, rc 1 */
    fflush(stdout); fprintf(stderr, fmt, a); fputc('\n', stderr);
    if (TD[0]) rmtree(TD);
    exit(1);
}

/* subprocess.run(ARGV, cwd=CWD, capture_output=True, timeout=T): stdout into *out, stderr discarded; the exit code, or
   -N for signal N; past T seconds (T > 0) the child gets SIGKILL and the result is 142 with no output */
static int runp(char *const argv[], const char *cwd, int t, int quiet_err, char **out, size_t *len) {
    char tmp[4200]; int fd, st = 0, rc; long ticks = (long)t * 100; pid_t pid, w; FILE *f;
    const char *base = getenv("TMPDIR"); if (!base || !*base) base = "/tmp";
    snprintf(tmp, sizeof tmp, "%s/revivedscan-outXXXXXX", base);
    if ((fd = mkstemp(tmp)) < 0) die("revivedscan: cannot create a capture file under %s", base);
    fflush(stdout); fflush(stderr);
    pid = fork();
    if (pid < 0) { close(fd); unlink(tmp); die("revivedscan: fork failed for %s", argv[0]); }
    if (pid == 0) {
        if (cwd && chdir(cwd) != 0) _exit(127);
        dup2(fd, 1); close(fd);
        if (quiet_err) { int nf = open("/dev/null", O_WRONLY); if (nf >= 0) { dup2(nf, 2); close(nf); } }
        execvp(argv[0], argv); _exit(127);
    }
    close(fd);
    for (;;) {
        w = waitpid(pid, &st, WNOHANG);
        if (w == pid) { rc = WIFEXITED(st) ? WEXITSTATUS(st) : WIFSIGNALED(st) ? -WTERMSIG(st) : 1; break; }
        if (w < 0) { rc = -1; break; }
        if (t > 0 && ticks-- <= 0) { kill(pid, SIGKILL); waitpid(pid, &st, 0); unlink(tmp); if (out) { *out = 0; *len = 0; } return 142; }
        usleep(10000);
    }
    f = fopen(tmp, "rb");
    if (f) { char *b = _cx_slurp(f, len); fclose(f); if (out) *out = b; else free(b); }
    else if (out) { *out = 0; *len = 0; }
    unlink(tmp);
    return rc;
}

/* run(cmd, cwd, t=15): tests/bound 15 CMD..., watchdog t + 5 */
static int bounded(char **cmd, int n, char **out, size_t *len) {
    char *a[16], bound[4200]; int i, k = 0;
    snprintf(bound, sizeof bound, "%s/tests/bound", ROOT);
    a[k++] = bound; a[k++] = "15";
    for (i = 0; i < n; i++) a[k++] = cmd[i];
    a[k] = 0;
    return runp(a, TD, 20, 1, out, len);
}

static int ncps(const char *s) { int n = 0; for (; *s; s++) if (((unsigned char)*s & 0xC0) != 0x80) n++; return n; }

static int changed_touches_front(void) {
    char *a[] = { "git", "diff", "--name-only", "HEAD~1", 0 }, *out = 0; size_t n = 0, i = 0; int hit = 0;
    runp(a, ROOT, 0, 1, &out, &n);   /* capture_output: git's stderr is captured and dropped too */
    if (!out) return 0;
    while (i < n) {   /* str.split(): runs of Unicode whitespace separate the paths */
        int l, c = cp_at((unsigned char *)out, n, i, &l); size_t s;
        if (c < 0) die("revivedscan: %s", "git diff output is not UTF-8");
        if (pyspace(c)) { i += l; continue; }
        s = i;
        while (i < n) { c = cp_at((unsigned char *)out, n, i, &l); if (c < 0) die("revivedscan: %s", "git diff output is not UTF-8"); if (pyspace(c)) break; i += l; }
        if ((i - s >= 12 && !memcmp(out + s, "unisa/front/", 12)) || (i - s >= 10 && !memcmp(out + s, "src/front_", 10))) hit = 1;
    }
    free(out);
    return hit;
}

int main(int argc, char **argv) {
    int i, li, checked = 0, revived = 0;
    for (i = 1; i < argc; i++) if (!strcmp(argv[i], "--changed")) break;
    if (getcwd(ROOT, sizeof ROOT) == 0) return 2;
    if (!getenv("PYTHONPATH")) {   /* os.environ.setdefault: every child (cc, git, the probes) inherits it */
        char **e; int k = 0; size_t m = strlen(ROOT) + 12;
        while (environ[k]) k++;
        e = malloc((k + 2) * sizeof *e); memcpy(e, environ, k * sizeof *e);
        e[k] = malloc(m); snprintf(e[k], m, "PYTHONPATH=%s", ROOT); e[k + 1] = 0;
        environ = e;   /* the carried libc's setenv does not reach exec's environment; environ does */
    }
    if (i < argc && !changed_touches_front()) { printf("revivedscan: no front-end change since HEAD~1; nothing to scan\n"); return 0; }
    {   const char *base = getenv("TMPDIR"); if (!base || !*base) base = "/tmp";
        snprintf(TD, sizeof TD, "%s/revivedscan-XXXXXX", base);
        if (!mkdtemp(TD)) { TD[0] = 0; die("revivedscan: cannot create a temporary directory under %s", base); } }
    for (li = 0; li < 5; li++) {
        const char *path = LISTS[li][0]; int python = !strcmp(LISTS[li][1], "python");
        char lp[4200], *text; size_t n = 0, p = 0;
        snprintf(lp, sizeof lp, "%s/%s", ROOT, path);
        if (!(text = cx_read(lp, &n))) die("revivedscan: cannot read %s", lp);
        while (p < n) {   /* splitlines: one line [ls, le) */
            size_t ls = p, le, q, ts, te; int l, c, first = -1;
            for (;;) {
                if (p >= n) { le = p; break; }
                c = cp_at((unsigned char *)text, n, p, &l); if (c < 0) die("revivedscan: %s is not UTF-8", lp);
                if (pybreak(c)) { le = p; p += l; if (c == '\r' && p < n && text[p] == '\n') p++; break; }
                p += l;
            }
            /* first non-space code point, then the first whitespace-separated token */
            for (q = ls; q < le; q += l) { c = cp_at((unsigned char *)text, n, q, &l); if (!pyspace(c)) { first = c; break; } }
            if (first < 0 || first == '#') continue;
            ts = q; for (te = ts; te < le; te += l) { c = cp_at((unsigned char *)text, n, te, &l); if (pyspace(c)) break; }
            {   char name[2048], src[8192], dir[8192], exe[8192], *slash, *want = 0, *got = 0; size_t wl = 0, gl = 0; int wrc, grc;
                struct stat st;
                snprintf(name, sizeof name, "%.*s", (int)(te - ts), text + ts);
                if (strlen(name) >= 2 && !strcmp(name + strlen(name) - 2, ".c")) name[strlen(name) - 2] = 0;
                /* ROOT / 'tests/c' / (name + '.c'); an absolute name replaces the base, as pathlib does */
                if (name[0] == '/') snprintf(src, sizeof src, "%s.c", name); else snprintf(src, sizeof src, "%s/tests/c/%s.c", ROOT, name);
                if (stat(src, &st) != 0) { if (errno == ENOENT) continue; die("revivedscan: cannot stat %s", src); }
                snprintf(dir, sizeof dir, "%s", src); slash = strrchr(dir, '/'); if (slash == dir) dir[1] = 0; else if (slash) *slash = 0;
                if (name[0] == '/') snprintf(exe, sizeof exe, "%s", name); else snprintf(exe, sizeof exe, "%s/%s", TD, name);
                {   char *a[] = { "cc", "-w", "-I", dir, "-o", exe, src, 0 };
                    if (runp(a, 0, 0, 1, 0, 0)) continue; }
                {   char *c1[] = { exe }; wrc = bounded(c1, 1, &want, &wl); }
                if (python) { char *c2[] = { "python3", "-m", "unisa", "run", src, "--drive", "built" }; grc = bounded(c2, 7, &got, &gl); }
                else { char com[4200]; char *c2[] = { com, "-run", src }; snprintf(com, sizeof com, "%s/unisacc.com", ROOT); grc = bounded(c2, 3, &got, &gl); }
                checked++;
                if (grc == wrc && gl == wl && (!wl || !memcmp(got, want, wl))) {
                    int pad = 40 - ncps(name);
                    revived++;
                    printf("  REVIVED %s%*s now agrees -- drop it from %s\n", name, pad > 0 ? pad : 0, "", path);
                }
                free(want); free(got);
            }
        }
        free(text);
    }
    printf("revivedscan  excused probes run %d   revived %d\n", checked, revived);
    rmtree(TD);
    return revived ? 1 : 0;
}
