#!/usr/bin/env unisacc.com
/* Native argv-preserving plan importer and bounded development runner.
 * No result cache. Existing oracle commands (including Python) are preserved.
 * PLAN_NUL CATALOG_TSV OUTDIR [--list|--unit ID|--module NAME]
 * [--jobs 1..4] [--limit 1..55]. Default action is list.
 * Execution requires --parent-container-unset or --parent-container-value VALUE;
 * this explicitly restores the caller state outside the default-run container.
 */
#include <sys/time.h>
typedef struct {char *id,**av,*module,*layer;int ac,selected,bound,rc;pid_t pid;double start;char hash[65];} Unit;
static Unit U[20000];static int N,MF=-1;static char *OUT;static char PH[65],CH[65];static int PARENT_MODE;static char *PARENT_BIND;
static void die(const char*s){fprintf(stderr,"suite: %s\n",s);exit(2);}
static void *mem(size_t n){void*p=malloc(n?n:1);if(!p)die("allocation");return p;}
static void checked(int f,const char*p,size_t n){while(n){ssize_t k=write(f,p,n);if(k>0){p+=k;n-=k;}else if(k<0&&errno==EINTR)continue;else die("write");}}
static char *load(const char*p,size_t*n){struct stat st;char*b;if(stat(p,&st)||!S_ISREG(st.st_mode))die("input is not regular readable file");b=cx_read(p,n);if(!b)die("read");return b;}
static void hashfile(const char*p,char*h){size_t n;char*b=load(p,&n);cx_sha256_hex(b,n,h);free(b);}
static int number(const char*p,int max){int n=0;if(!*p)die("empty decimal");while(*p){if(*p<'0'||*p>'9')die("invalid decimal");if(n>max/10)die("decimal out of range");n=n*10+*p++-'0';if(n>max)die("decimal out of range");}return n;}
static void field(const char*p){if(!*p)die("empty identity field");while(*p){unsigned char c=*p++;if(c<33||c>126)die("invalid identity field");}}
static char *token(char*b,size_t n,size_t*pos){char*p;if(*pos>=n)die("truncated plan");p=b+*pos;while(*pos<n&&b[*pos])(*pos)++;if(*pos==n)die("unterminated plan token");(*pos)++;return p;}
static void plan(char*b,size_t n){size_t pos=0,at;int i,j;char*count;while(pos<n){if(N==20000)die("too many units");U[N].id=token(b,n,&pos);field(U[N].id);for(i=0;i<N;i++)if(!strcmp(U[i].id,U[N].id))die("duplicate plan ID");count=token(b,n,&pos);U[N].ac=number(count,4096);if(!U[N].ac)die("empty command");U[N].av=mem((U[N].ac+1)*sizeof(char*));at=pos;for(j=0;j<U[N].ac;j++)U[N].av[j]=token(b,n,&pos);U[N].av[j]=0;if(!*U[N].av[0])die("empty executable");cx_sha256_hex(b+at,pos-at,U[N].hash);N++;}if(!N)die("empty plan");}
static char *line(char*b,size_t n,size_t*pos){size_t at=*pos;if(at>=n)die("missing catalog line");while(*pos<n&&b[*pos]!='\n'){if(!b[*pos])die("NUL in catalog");(*pos)++;}if(*pos==n)die("catalog requires final newline");b[(*pos)++]=0;return b+at;}
static void catalog(char*b,size_t n){size_t pos=0;char*p,*a,*c;int i,k,rows=0;p=line(b,n,&pos);if(strncmp(p,"#plan_sha256\t",13)||strcmp(p+13,PH))die("catalog plan SHA mismatch");p=line(b,n,&pos);if(strncmp(p,"#units\t",7)||number(p+7,20000)!=N)die("catalog count mismatch");while(pos<n){p=line(b,n,&pos);a=strchr(p,'\t');if(!a)die("catalog columns");*a++=0;c=strchr(a,'\t');if(!c||strchr(c+1,'\t'))die("catalog columns");*c++=0;field(p);field(a);field(c);k=-1;for(i=0;i<N;i++)if(!strcmp(U[i].id,p))k=i;if(k<0)die("unknown catalog ID");if(U[k].bound)die("duplicate catalog ID");U[k].bound=1;U[k].module=a;U[k].layer=c;rows++;}if(rows!=N)die("missing catalog ID");}
static char *path(int i,const char*s){char*b=mem(strlen(OUT)+strlen(s)+40);sprintf(b,"%s/%05d.%s",OUT,i+1,s);return b;}
static int exclusive(const char*p){int f=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC,0600);if(f<0)die("exclusive output create");return f;}
static void save(const char*p,const char*s,size_t n){int f=exclusive(p);checked(f,s,n);if(fsync(f)||close(f))die("output close");}
static double now(void){struct timeval t;if(gettimeofday(&t,0))die("clock");return (double)t.tv_sec+(double)t.tv_usec/1000000.0;}
static int assignment(const char*p){int i=0;if(!((*p>='A'&&*p<='Z')||(*p>='a'&&*p<='z')||*p=='_'))return 0;while(p[i]&&p[i]!='='){if(!((p[i]>='A'&&p[i]<='Z')||(p[i]>='a'&&p[i]<='z')||(p[i]>='0'&&p[i]<='9')||p[i]=='_'))return 0;i++;}return p[i]=='=';}
static void quote(const char*p){const unsigned char*s=(const unsigned char*)p;putchar('"');while(*s){if(*s=='"'||*s=='\\'){putchar('\\');putchar(*s);}else if(*s>=32&&*s<127)putchar(*s);else printf("\\x%02x",*s);s++;}putchar('"');}
static void launch(int i,int limit){char lim[20];char**a;int j,at=0,fo,fe;Unit*u=&U[i];size_t bytes=0;char*raw,*p;for(j=0;j<u->ac;j++)bytes+=strlen(u->av[j])+1;raw=mem(bytes);p=raw;for(j=0;j<u->ac;j++){size_t z=strlen(u->av[j])+1;memcpy(p,u->av[j],z);p+=z;}save(path(i,"argv.nul"),raw,bytes);free(raw);a=mem((u->ac+10)*sizeof(char*));sprintf(lim,"%d",limit);a[at++]="tests/bound";a[at++]=lim;a[at++]="env";a[at++]="-u";a[at++]="UNISA_CONTAINER";if(PARENT_MODE==2)a[at++]=PARENT_BIND;if(assignment(u->av[0]))a[at++]="env";for(j=0;j<u->ac;j++)a[at++]=u->av[j];a[at]=0;fo=exclusive(path(i,"stdout"));fe=exclusive(path(i,"stderr"));u->start=now();u->pid=fork();if(u->pid<0)die("fork");if(!u->pid){if(dup2(fo,1)<0||dup2(fe,2)<0)_exit(126);close(fo);close(fe);if(MF>=0)close(MF);execvp(a[0],a);_exit(127);}if(close(fo)||close(fe))die("log close");free(a);}
static void unchanged(const char*p,const char*c){char h[65];hashfile(p,h);if(strcmp(h,c))die("input changed during run");}
typedef struct {int pred,next;} Edge;
static Edge *EDGES;static int NE,ECAP,HEAD[20000],COLOR[20000],STATE[20000],AUTO[20000];
static char *GRAPH,*ORDER;static char GH[65],OH[65];static int INDEPENDENT;
static int idof(const char*p){int i;for(i=0;i<N;i++)if(!strcmp(U[i].id,p))return i;die("unknown graph ID");return -1;}
static void visit(int i){int e;if(COLOR[i]==1)die("dependency cycle");if(COLOR[i]==2)return;COLOR[i]=1;for(e=HEAD[i];e>=0;e=EDGES[e].next)visit(EDGES[e].pred);COLOR[i]=2;}
static void closure(int i){int e,k;for(e=HEAD[i];e>=0;e=EDGES[e].next){k=EDGES[e].pred;if(!U[k].selected){U[k].selected=1;AUTO[k]=1;closure(k);}}}
static void graph(char*b,size_t n){size_t pos=0;char*p,*a,*c;int i,k,e;for(i=0;i<N;i++)HEAD[i]=-1;p=line(b,n,&pos);if(strncmp(p,"#plan_sha256\t",13)||strcmp(p+13,PH))die("graph plan SHA mismatch");p=line(b,n,&pos);if(strncmp(p,"#order_sha256\t",14)||strlen(p+14)!=64)die("graph order SHA format");for(i=0;i<64;i++)if(!((p[14+i]>='0'&&p[14+i]<='9')||(p[14+i]>='a'&&p[14+i]<='f')))die("graph order SHA format");memcpy(OH,p+14,65);p=line(b,n,&pos);if(strncmp(p,"#nodes\t",7)||number(p+7,20000)!=N)die("graph node count mismatch");while(pos<n){p=line(b,n,&pos);a=strchr(p,'\t');if(!a)die("graph columns");*a++=0;c=strchr(a,'\t');if(!c||strchr(c+1,'\t')||strcmp(p,"edge"))die("graph columns");*c++=0;i=idof(a);k=idof(c);for(e=HEAD[i];e>=0;e=EDGES[e].next)if(EDGES[e].pred==k)die("duplicate graph edge");if(NE==200000)die("too many graph edges");if(NE==ECAP){ECAP=ECAP?ECAP*2:128;EDGES=realloc(EDGES,ECAP*sizeof(Edge));if(!EDGES)die("edge allocation");}EDGES[NE].pred=k;EDGES[NE].next=HEAD[i];HEAD[i]=NE++;}for(i=0;i<N;i++)visit(i);}
/* 0=waiting, 1=ready, 2=blocked by a permanently failed predecessor. */
static int ready(int i){int e,k,waiting=0;for(e=HEAD[i];e>=0;e=EDGES[e].next){k=EDGES[e].pred;if(STATE[k]==3||(STATE[k]==2&&U[k].rc))return 2;if(STATE[k]!=2)waiting=1;}return waiting?0:1;}
static void blocked(int i){char row[4096];int z;STATE[i]=3;z=snprintf(row,sizeof row,"%s\t%s\t%s\tBLOCKED\t-\t-\t%s\n",U[i].id,U[i].module,U[i].layer,U[i].hash);if(z<0||(size_t)z>=sizeof row)die("blocked result overflow");checked(MF,row,z);save(path(i,"rc"),"-\n",2);save(path(i,"elapsed"),"-\n",2);save(path(i,"blocked"),"failed predecessor; command not launched\n",strlen("failed predecessor; command not launched\n"));printf("BLOCKED\t%s\trc=-\n",U[i].id);fflush(stdout);}
int main(int argc,char**argv){size_t pn,cn,gn;char *pb,*cb,*gb,*unit=0,*module=0;int list=0,jobs=1,limit=55,i,j,chosen=0,original=0,active=0,done=0,failed=0,nblocked=0,testpass=0,prepared=0,executed=0,st;pid_t pid;char row[4096],*result;struct stat sb;
 if(argc<4)die("usage PLAN CATALOG OUT [--list|--unit ID|--module NAME] [--graph GRAPH --order ORDER|--independent] [--jobs 1..4] [--limit 1..55] [--parent-container-unset|--parent-container-value VALUE]");OUT=argv[3];for(i=4;i<argc;i++){if(!strcmp(argv[i],"--list")){if(list)die("duplicate list");list=1;}else if(!strcmp(argv[i],"--unit")){if(unit||module||i+1==argc)die("unit selection");unit=argv[++i];}else if(!strcmp(argv[i],"--module")){if(unit||module||i+1==argc)die("module selection");module=argv[++i];}else if(!strcmp(argv[i],"--jobs")){if(++i==argc)die("jobs value");jobs=number(argv[i],4);if(!jobs)die("jobs range");}else if(!strcmp(argv[i],"--limit")){if(++i==argc)die("limit value");limit=number(argv[i],55);if(!limit)die("limit range");}else if(!strcmp(argv[i],"--parent-container-unset")){if(PARENT_MODE)die("duplicate parent container mode");PARENT_MODE=1;}else if(!strcmp(argv[i],"--parent-container-value")){size_t z;if(PARENT_MODE||++i==argc)die("parent container value");PARENT_MODE=2;z=strlen(argv[i])+17;PARENT_BIND=mem(z);snprintf(PARENT_BIND,z,"UNISA_CONTAINER=%s",argv[i]);}else if(!strcmp(argv[i],"--graph")){if(GRAPH||INDEPENDENT||++i==argc)die("graph selection");GRAPH=argv[i];}else if(!strcmp(argv[i],"--order")){if(ORDER||++i==argc)die("order selection");ORDER=argv[i];}else if(!strcmp(argv[i],"--independent")){if(INDEPENDENT||GRAPH)die("independent selection");INDEPENDENT=1;}else die("unknown option");}
 if((GRAPH&&!ORDER)||(ORDER&&!GRAPH))die("--graph and --order must be paired");if(!unit&&!module)list=1;pb=load(argv[1],&pn);cb=load(argv[2],&cn);cx_sha256_hex(pb,pn,PH);cx_sha256_hex(cb,cn,CH);plan(pb,pn);catalog(cb,cn);for(i=0;i<N;i++)HEAD[i]=-1;if(GRAPH){gb=load(GRAPH,&gn);cx_sha256_hex(gb,gn,GH);graph(gb,gn);{char h[65];hashfile(ORDER,h);if(strcmp(h,OH))die("graph order SHA mismatch");}}
 for(i=0;i<N;i++){U[i].selected=(!unit&&!module)||(unit&&!strcmp(unit,U[i].id))||(module&&!strcmp(module,U[i].module));if(U[i].selected)original++;}if(!original)die("empty selection");for(i=0;i<N;i++)if(U[i].selected)closure(i);for(i=0;i<N;i++)if(U[i].selected)chosen++;
 if(list){for(i=0;i<N;i++)if(U[i].selected){printf("%s\t%s\t%s\t%s\t",U[i].id,U[i].module,U[i].layer,AUTO[i]?"dependency":"selected");for(j=0;j<U[i].ac;j++){if(j)putchar(' ');quote(U[i].av[j]);}putchar('\n');}printf("LIST selected=%d auto_added=%d total=%d executed=0\n",chosen,chosen-original,N);unchanged(argv[1],PH);unchanged(argv[2],CH);if(GRAPH){unchanged(GRAPH,GH);unchanged(ORDER,OH);}return 0;}
 if(!PARENT_MODE)die("execution requires explicit parent container state");if(!GRAPH&&!INDEPENDENT)die("execution requires --graph or explicit --independent");if(!strcmp(OUT,"-"))die("execution needs new output directory");if(!stat(OUT,&sb)||errno!=ENOENT)die("output directory must be new");if(mkdir(OUT,0700))die("mkdir output");result=mem(strlen(OUT)+40);sprintf(result,"%s/identity.tsv",OUT);j=snprintf(row,sizeof row,"plan_sha256\t%s\ncatalog_sha256\t%s\ngraph_sha256\t%s\norder_sha256\t%s\nindependent\t%d\nselected\t%d\nauto_added\t%d\njobs\t%d\nlimit\t%d\n",PH,CH,GRAPH?GH:"-",GRAPH?OH:"-",INDEPENDENT,chosen,chosen-original,jobs,limit);save(result,row,j);sprintf(result,"%s/results.tsv",OUT);MF=exclusive(result);checked(MF,"id\tmodule\tlayer\tstatus\trc\telapsed_seconds\targv_sha256\n",strlen("id\tmodule\tlayer\tstatus\trc\telapsed_seconds\targv_sha256\n"));
 while(done<chosen){int progress;do{progress=0;for(i=0;i<N;i++)if(U[i].selected&&!STATE[i]){int r=ready(i);if(r==2){blocked(i);nblocked++;done++;progress=1;}else if(r==1&&active<jobs){launch(i,limit);STATE[i]=1;active++;executed++;progress=1;}}}while(progress);if(done==chosen)break;if(!active)die("dependency scheduler made no progress");do{pid=waitpid(-1,&st,0);}while(pid<0&&errno==EINTR);if(pid<0)die("waitpid");for(i=0;i<N;i++)if(STATE[i]==1&&U[i].pid==pid)break;if(i==N)die("unknown child");U[i].rc=WIFEXITED(st)?WEXITSTATUS(st):(WIFSIGNALED(st)?128+WTERMSIG(st):255);{double elapsed=now()-U[i].start;const char*status=U[i].rc?"FAIL":(!strcmp(U[i].layer,"prepare")?"PREPARED":"PASS");j=snprintf(row,sizeof row,"%s\t%s\t%s\t%s\t%d\t%.6f\t%s\n",U[i].id,U[i].module,U[i].layer,status,U[i].rc,elapsed,U[i].hash);if(j<0||(size_t)j>=sizeof row)die("result overflow");checked(MF,row,j);printf("%s\t%s\trc=%d\t%.6fs\n",status,U[i].id,U[i].rc,elapsed);fflush(stdout);j=snprintf(row,sizeof row,"%d\n",U[i].rc);save(path(i,"rc"),row,j);j=snprintf(row,sizeof row,"%.6f\n",elapsed);save(path(i,"elapsed"),row,j);if(U[i].rc)failed++;else if(!strcmp(U[i].layer,"prepare"))prepared++;else testpass++;}U[i].pid=0;STATE[i]=2;active--;done++;}
 unchanged(argv[1],PH);unchanged(argv[2],CH);if(GRAPH){unchanged(GRAPH,GH);unchanged(ORDER,OH);}if(fsync(MF)||close(MF))die("results close");j=snprintf(row,sizeof row,"selected\t%d\ndisposed\t%d\nexecuted\t%d\ntest_pass\t%d\nprepared\t%d\nfailed\t%d\nblocked\t%d\n",chosen,done,executed,testpass,prepared,failed,nblocked);sprintf(result,"%s/summary.tsv",OUT);save(result,row,j);unchanged(argv[1],PH);unchanged(argv[2],CH);if(GRAPH){unchanged(GRAPH,GH);unchanged(ORDER,OH);}sprintf(result,"%s/completion.tsv",OUT);j=snprintf(row,sizeof row,"plan_sha256\t%s\ncatalog_sha256\t%s\ngraph_sha256\t%s\norder_sha256\t%s\nselected\t%d\ndisposed\t%d\nexecuted\t%d\ntest_pass\t%d\nprepared\t%d\nfailed\t%d\nblocked\t%d\n",PH,CH,GRAPH?GH:"-",GRAPH?OH:"-",chosen,done,executed,testpass,prepared,failed,nblocked);save(result,row,j);printf("DONE executed=%d test_pass=%d prepared=%d failed=%d blocked=%d\n",executed,testpass,prepared,failed,nblocked);return failed||nblocked||!executed?1:0;
}
