#!/usr/bin/env unisacc.com
/* Read-only NUL-plan classifier; commands remain exclusively in RAW_PLAN.
 * name\0argc\0argv0\0...argv(argc-1)\0; empty arguments stay byte-exact.
 * Two TSV binding headers, then id/module/layer. Unmatched/ambiguous names
 * fall back to integration and are listed in stdout (never invented tests).
 * RAW NEW_TSV | --check RAW TSV; NEW_TSV must not exist. */
typedef struct {char*id;size_t argc;char**argv;const char*module,*layer;int fallback;} Unit;
typedef struct {char*raw;size_t bytes,n,cap;Unit*u;char sha[65];} Plan;
static void fail(const char*s){fprintf(stderr,"catalog REFUSED %s\n",s);exit(2);}
static void emit(int f,const char*s,size_t n){while(n){ssize_t k=write(f,s,n);if(k>0){s+=k;n-=k;}else if(k<0&&errno==EINTR)continue;else fail("write");}}
static void say(const char*s){emit(1,s,strlen(s));}
static int safe(const char*s){const unsigned char*p=(const unsigned char*)s;if(!*p)return 0;for(;*p;p++)if(*p<32||*p==127)return 0;return 1;}
static char*field(Plan*p,size_t*at){char*s,*z;if(*at>=p->bytes)fail("truncated field");s=p->raw+*at;z=memchr(s,0,p->bytes-*at);if(!z)fail("unterminated field");*at=z-p->raw+1;return s;}
static size_t decimal(const char*s){size_t n=0;const unsigned char*p=(const unsigned char*)s;if(!*p)fail("empty count");for(;*p;p++){unsigned d=*p-'0';if(d>9||n>((size_t)-1-d)/10)fail("invalid/overflow count");n=n*10+d;}return n;}
static int glob(const char*p,const char*s){if(!*p)return !*s;if(*p=='*'){do{if(glob(p+1,s))return 1;}while(*s++);return 0;}return *s&&*p==*s&&glob(p+1,s+1);}
static int matches(const char*list,const char*s){const char*p=list;char w[128];while(*p){size_t n=0;while(*p==' ')p++;while(*p&&*p!=' '){if(n+1>=sizeof w)fail("rule token");w[n++]=*p++;}w[n]=0;if(n&&glob(w,s))return 1;}return 0;}
static int token(const char*s,const char*t){size_t n=strlen(t);const char*p=s;while((p=strstr(p,t))){if((p==s||p[-1]=='-')&&(!p[n]||p[n]=='-'))return 1;p++;}return 0;}
static void classify(Unit*u){
 static const char*mods[]={"e2","e1","e3","e4","prune","lower","enc","elf"};
 static const char*rules[]={
 "exec-pp-* exec-pploc exec-macros pptruth shared-e2-* rowcov-pp* prevheaders pp-leaf-seal*",
 "exec-lex* exec-f1-sidecar strconvert-* rowcov-lex* lex-e1-seal*",
 "exec-parse* exec-unit* exec-diag exec-errors* exec-f1-attributes exec-*warn* exec-neg exec-e3self* exec-decimal* rowcov-parse2* seed-construct-parse2 seedparse2* middle-flow-e3*",
 "exec-e4* opt-e4-seal*",
 "exec-prune* prune-seal*",
 "exec-lower exec-armlower* exec-winlower exec-lowdata exec-sparse rowcov-lower* middle-flow-lower*",
 "exec-e5* exec-arm exec-sha exec-asm* rowcov-enc*",
 "exec-elf* exec-armelf exec-mach* exec-x86win exec-armwin exec-pe* elf-seal*"};
 static const char*nets[]={"pp","lex","isel","abi","combo","binsel","prec","opinfo","peep","parse","type","scope","reloc","op","irsel","tyinfo","pfconv","regmap","enc",0};
 static char netmods[19][40];const char*s=u->id;int i,hits=0,chosen=-1;
 if(!strncmp(s,"com-",4))s+=4;u->module="integration";u->layer="integration";u->fallback=0;
 if(matches("hostcheck host-triple-* nativeboot-* crossnative windows-* winposix fat-host* darwin-*",s)){u->module="platform";u->layer="platform";}
 else if(matches("identity-* c99-ledger decision-ledger zeropython* ledgercheck finite-template dsl-ops manifest-entries-* script-inventory* subtract-safety* cxinclude glossarycheck* safedel-* deletecheck* deletemut-* progress freezecheck* revivedscan facts-export publish-order gate-infra gate-layers native-stamp tsv-build-account pipeline-cache docs kernel source-layout front-bounds bound* fresh-order* seed-metadata modelbenchcheck package-footer ape-version proc-enum qprefix full-signature referee-* stagelog exittable h1source seedmemory* attemptchain c99precheck rulingwait namedrefuse checkrun commitgate queuestart* queuetimeout gatesummary observation gqalive queuetimer docedit whyrerun draftfetch draftguard",s)){u->module="infra";u->layer="infra";}
 else if(matches("difftest* csmithdiff* corpus* ccrun* closure* bigclosure* stages* exec-chain* exec-native-* exec-formats* exec-multi-* multi fb12-multi realprog luatests* sqlspeed* minicon apps-* comboot-*",s)){}
 else{
  for(i=0;i<8;i++)if(matches(rules[i],s)){hits++;chosen=i;}
  for(i=0;nets[i];i++){char pat[64];snprintf(pat,sizeof pat,"net-%s net-%s-*",nets[i],nets[i]);if(matches(pat,s)){snprintf(netmods[i],sizeof netmods[i],"net-%s",nets[i]);hits++;chosen=8+i;}}
  if(hits==1){u->module=chosen<8?mods[chosen]:netmods[chosen-8];u->layer="unit";}else u->fallback=1;
 }
 /* An unclassified name may inherit only an exact known script owner.
  * Distinct e3/lower hits or explicit cross-flow owners remain integration. */
 if(u->fallback){
  static const char*e3owners[]={"exec/parse2/librarytypedreadercheck.sh",
   "exec/parse2/librarycallsitecheck.sh","exec/parse2/libraryfunctionimportscheck.sh",
   "tests/librarycallbacke3check.sh",0};
  static const char*lowerowners[]={"exec/lower/librarytypedcheck.sh",
   "exec/lower/librarycallsitecheck.sh","exec/lower/librarydatacheck.sh",
   "tests/librarycallbacklowercheck.sh",0};
  int e3hit=0,lowerhit=0,cross=0,j;size_t a;
  if(!strcmp(u->id,"suite-tools-native")){u->module="infra";u->layer="infra";u->fallback=0;}
  else{
   for(a=0;a<u->argc;a++){const char*arg=u->argv[a];if(!strncmp(arg,"./",2))arg+=2;
    for(j=0;e3owners[j];j++)if(!strcmp(arg,e3owners[j]))e3hit=1;
    for(j=0;lowerowners[j];j++)if(!strcmp(arg,lowerowners[j]))lowerhit=1;
    if(!strcmp(arg,"tests/librarycallbackwiringcheck.sh")||!strcmp(arg,"tests/librarycallbackauthcheck.sh"))cross=1;
   }
   if(!cross&&e3hit!=lowerhit){u->module=e3hit?"e3":"lower";u->layer="unit";u->fallback=0;}
  }
 }
 if(token(s,"prepare")||token(s,"prep"))u->layer="prepare";
}
static Plan parse(const char*path){Plan p={0};size_t at=0,i;struct stat st;if(lstat(path,&st)||!S_ISREG(st.st_mode))fail("plan not regular");p.raw=cx_read(path,&p.bytes);if(!p.raw||p.bytes!=(size_t)st.st_size||!p.bytes)fail("plan read/empty");cx_sha256_hex(p.raw,p.bytes,p.sha);
 while(at<p.bytes){Unit u={0};char*c;u.id=field(&p,&at);if(!safe(u.id))fail("unsafe/empty ID");for(i=0;i<p.n;i++)if(!strcmp(p.u[i].id,u.id))fail("duplicate ID");c=field(&p,&at);u.argc=decimal(c);if(!u.argc||u.argc>p.bytes-at)fail("zero/impossible argc");u.argv=malloc(u.argc*sizeof *u.argv);if(!u.argv)fail("argv allocation");for(i=0;i<u.argc;i++)u.argv[i]=field(&p,&at);if(!u.argv[0][0])fail("empty executable");classify(&u);if(p.n==p.cap){p.cap=p.cap?p.cap*2:128;p.u=realloc(p.u,p.cap*sizeof *p.u);if(!p.u)fail("unit allocation");}p.u[p.n++]=u;
 }if(!p.n)fail("empty plan");return p;}
static char*line(char**at,char*end){char*s=*at,*nl;if(s>=end)fail("missing line");nl=memchr(s,'\n',end-s);if(!nl)fail("missing final newline");*nl=0;*at=nl+1;return s;}
static void verify(Plan*p,const char*path){size_t n,i,rows=0;char*s=cx_read(path,&n),*at,*end,*l,*tab,*layer;int*seen;char expect[96];if(!s||memchr(s,0,n))fail("catalog read/NUL");at=s;end=s+n;snprintf(expect,sizeof expect,"#plan_sha256\t%s",p->sha);if(strcmp(line(&at,end),expect))fail("SHA binding");snprintf(expect,sizeof expect,"#units\t%lu",(unsigned long)p->n);if(strcmp(line(&at,end),expect))fail("count binding");seen=calloc(p->n,sizeof *seen);if(!seen)fail("coverage allocation");
 while(at<end){l=line(&at,end);tab=strchr(l,'\t');if(!tab)fail("fields");*tab++=0;layer=strchr(tab,'\t');if(!layer)fail("fields");*layer++=0;if(strchr(layer,'\t')||!safe(l)||!safe(tab)||!safe(layer))fail("unsafe/extra fields");for(i=0;i<p->n;i++)if(!strcmp(p->u[i].id,l))break;if(i==p->n||seen[i]++)fail("unknown/duplicate catalog ID");if(strcmp(p->u[i].module,tab)||strcmp(p->u[i].layer,layer))fail("classification mismatch");rows++;}
 if(rows!=p->n)fail("missing IDs");for(i=0;i<p->n;i++)if(!seen[i])fail("missing ID");free(seen);free(s);}
static void report(Plan*p){size_t i,j,fallbacks=0;char out[256];for(i=0;i<p->n;i++){int first=1;size_t count=0;for(j=0;j<i;j++)if(!strcmp(p->u[i].module,p->u[j].module))first=0;if(first){for(j=0;j<p->n;j++)if(!strcmp(p->u[i].module,p->u[j].module))count++;snprintf(out,sizeof out,"module\t%s\t%lu\n",p->u[i].module,(unsigned long)count);say(out);}}
 for(i=0;i<p->n;i++){int first=1;size_t count=0;for(j=0;j<i;j++)if(!strcmp(p->u[i].layer,p->u[j].layer))first=0;if(first){for(j=0;j<p->n;j++)if(!strcmp(p->u[i].layer,p->u[j].layer))count++;snprintf(out,sizeof out,"layer\t%s\t%lu\n",p->u[i].layer,(unsigned long)count);say(out);}}
 for(i=0;i<p->n;i++)if(p->u[i].fallback){say("fallback\t");say(p->u[i].id);say("\n");fallbacks++;}snprintf(out,sizeof out,"units\t%lu\nfallbacks\t%lu\nplan_sha256\t%s\n",(unsigned long)p->n,(unsigned long)fallbacks,p->sha);say(out);}
int main(int argc,char**argv){Plan p;int check=0,f;size_t i;char h[128];if(argc==4&&!strcmp(argv[1],"--check")){check=1;argv++;argc--;}if(argc!=3)fail("usage RAW NEW_TSV | --check RAW TSV");p=parse(argv[1]);if(check){verify(&p,argv[2]);report(&p);return 0;}
 f=open(argv[2],O_WRONLY|O_CREAT|O_EXCL,0600);if(f<0)fail("new output exists/inaccessible");snprintf(h,sizeof h,"#plan_sha256\t%s\n#units\t%lu\n",p.sha,(unsigned long)p.n);emit(f,h,strlen(h));for(i=0;i<p.n;i++){emit(f,p.u[i].id,strlen(p.u[i].id));emit(f,"\t",1);emit(f,p.u[i].module,strlen(p.u[i].module));emit(f,"\t",1);emit(f,p.u[i].layer,strlen(p.u[i].layer));emit(f,"\n",1);}if(fsync(f)||close(f))fail("close");verify(&p,argv[2]);report(&p);return 0;}
