#!/usr/bin/env unisacc.com
/* Behavioral suite-tool regression only: no compiler corpus or producer.
 * Ordinary main reuses one fixture-local compiled runner after full input/artifact
 * verification; fail-fast and auxiliary tools retain default-run execution.
 * Run from root under tests/bound55. Children use bound8 (plus the existing
 * cleanup reserve); fresh /tmp fixtures use the existing safedel contract. */
#include <sys/time.h>
static char SC_DIR[256];static int SC_SEQ,SC_CHECKS,SC_INPUTS_UNVERIFIED;static double SC_START;
static void sc_write(int f,const char*s,size_t n){while(n){ssize_t k=write(f,s,n);if(k>0){s+=k;n-=k;}else if(k<0&&errno==EINTR)continue;else exit(2);}}
static char*sc_path(const char*s){size_t n=strlen(SC_DIR)+strlen(s)+2;char*p=malloc(n);if(!p)exit(2);snprintf(p,n,"%s/%s",SC_DIR,s);return p;}
static double sc_now(void){struct timeval t;if(gettimeofday(&t,0))exit(2);return t.tv_sec+t.tv_usec/1000000.0;}
static int sc_child(char**a,const char*out,const char*err){pid_t p,w;int st,f=-1,e=-1;if(out){f=open(out,O_WRONLY|O_CREAT|O_EXCL,0600);e=open(err,O_WRONLY|O_CREAT|O_EXCL,0600);if(f<0||e<0)exit(2);}p=fork();if(p<0)exit(2);if(!p){if(f>=0){if(dup2(f,1)<0||dup2(e,2)<0)_exit(126);close(f);close(e);}execvp(a[0],a);_exit(127);}if(f>=0){close(f);close(e);}do{w=waitpid(p,&st,0);}while(w<0&&errno==EINTR);if(w!=p)return 255;return WIFEXITED(st)?WEXITSTATUS(st):WIFSIGNALED(st)?128+WTERMSIG(st):255;}
static int sc_clean(void){int rc;char*a[]={"tests/bound","8","sh","./unisacc.com","tests/safedel.cx","--","--purge","--",SC_DIR,0};if(!*SC_DIR)return 0;/* Never execute rejected inputs to clean an integrity failure. Same loaded deletion guard. */if(SC_INPUTS_UNVERIFIED)rc=cx_rmtree(SC_DIR);else rc=sc_child(a,0,0);if(!rc)*SC_DIR=0;return rc;}
static void sc_no(const char*s){fprintf(stderr,"suite-check FAIL %s (fixture %s)\n",s,SC_DIR);sc_clean();exit(1);}
static void sc_ok(int yes,const char*s){if(!yes)sc_no(s);SC_CHECKS++;}
static void sc_put(const char*p,const char*s,size_t n){int f=open(p,O_WRONLY|O_CREAT|O_EXCL,0600);if(f<0)sc_no("exclusive fixture");sc_write(f,s,n);if(close(f))sc_no("fixture close");}
static char*sc_load(const char*p){size_t n;char*s=cx_read(p,&n);if(!s||strlen(s)!=n)sc_no("fixture text read");return s;}
static void sc_absent(const char*p){struct stat st;if(!lstat(p,&st)||errno!=ENOENT)sc_no("unexpected file/inspection failure");SC_CHECKS++;}
static void sc_has(const char*p,const char*s){char*b=sc_load(p);sc_ok(strstr(b,s)!=0,s);free(b);}
static int sc_call(char**a){char n[64];int rc;snprintf(n,sizeof n,"step-%02d.stdout",++SC_SEQ);{char*out=sc_path(n);snprintf(n,sizeof n,"step-%02d.stderr",SC_SEQ);rc=sc_child(a,out,sc_path(n));}if(sc_now()-SC_START>47)sc_no("selftest time budget");return rc;}
typedef struct {char*s;size_t n,cap;} ScBuf;
static void sc_add(ScBuf*b,const char*s,size_t n){if(b->n+n+1>b->cap){b->cap=(b->n+n+1)*2;b->s=realloc(b->s,b->cap);if(!b->s)exit(2);}memcpy(b->s+b->n,s,n);b->n+=n;b->s[b->n]=0;}
static void sc_record(ScBuf*b,const char*id,int argc,const char**argv){char count[32];int i;sc_add(b,id,strlen(id)+1);snprintf(count,sizeof count,"%d",argc);sc_add(b,count,strlen(count)+1);for(i=0;i<argc;i++)sc_add(b,argv[i],strlen(argv[i])+1);}
/* Measured hot path: this fixture compiles run.cx once, never across invocations.
 * Every execution checks code inputs and the owned artifact, not prior results. */
static char *SC_RUN_TOOL,*SC_MACHINE;static char SC_RUN_ID[65],SC_RUN_SHA[65];static int SC_ID_SEQ,SC_COMPILER_PINNED;static char SC_COMPILER_SHA[65],SC_SIDECAR_SHA[65];
static void sc_compiler_hash(const char*p,char h[65]){struct stat st;size_t n;char*s;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<=0)sc_no(p);s=cx_read(p,&n);if(!s||n!=(size_t)st.st_size)sc_no(p);cx_sha256_hex(s,n,h);free(s);}
static void sc_compiler_guard(void){char h[65];if(!SC_COMPILER_PINNED)sc_no("compiler identity not pinned");sc_compiler_hash("unisacc.com",h);if(strcmp(h,SC_COMPILER_SHA))sc_no("compiler SHA changed before dependency plan");sc_compiler_hash("unisacc.com.build.json",h);if(strcmp(h,SC_SIDECAR_SHA))sc_no("compiler sidecar SHA changed before dependency plan");}
static int sc_name_cmp(const void*a,const void*b){return strcmp(*(char*const*)a,*(char*const*)b);}
static void sc_file_id(ScBuf*b,const char*p){struct stat st;size_t n;char h[65],meta[128],*s;if(lstat(p,&st)||!S_ISREG(st.st_mode))sc_no("runner input not regular");s=cx_read(p,&n);if(!s||n!=(size_t)st.st_size)sc_no("runner input read");cx_sha256_hex(s,n,h);free(s);snprintf(meta,sizeof meta,"%lu:%lu:%llu",(unsigned long)st.st_mode,(unsigned long)st.st_uid,(unsigned long long)n);sc_add(b,p,strlen(p)+1);sc_add(b,meta,strlen(meta)+1);sc_add(b,h,65);}
/* cx_walk skips symlinks and inspection failures; identity must reject them instead. */
static void sc_header_tree(ScBuf*b,const char*p){DIR*d;struct dirent*e;char**names=0;size_t n=0,i;struct stat st;if(lstat(p,&st))sc_no("header inspection");if(S_ISREG(st.st_mode)){sc_file_id(b,p);return;}if(!S_ISDIR(st.st_mode))sc_no("header symlink/special input");sc_add(b,p,strlen(p)+1);d=opendir(p);if(!d)sc_no("header directory read");errno=0;while((e=readdir(d))){if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;names=realloc(names,(n+1)*sizeof*names);if(!names)sc_no("header list allocation");size_t z=strlen(p)+strlen(e->d_name)+2;names[n]=malloc(z);if(!names[n])sc_no("header path allocation");snprintf(names[n++],z,"%s/%s",p,e->d_name);errno=0;}if(errno||closedir(d))sc_no("header enumeration");qsort(names,n,sizeof*names,sc_name_cmp);for(i=0;i<n;i++){sc_header_tree(b,names[i]);free(names[i]);}free(names);}
static void sc_runner_identity(char hash[65]){sc_compiler_guard();ScBuf b={0};char label[80],*out,*err,*plan,*line,*end;int units=0;const char*recipe[]={"fixture-runner-v1","tests/bound","8","sh","./unisacc.com","-o",SC_RUN_TOOL,"tests/suite/run.cx"};size_t i;for(i=0;i<sizeof recipe/sizeof*recipe;i++)sc_add(&b,recipe[i],strlen(recipe[i])+1);sc_add(&b,SC_MACHINE,strlen(SC_MACHINE)+1);sc_file_id(&b,"unisacc.com");sc_file_id(&b,"unisacc.com.build.json");sc_header_tree(&b,"include");
 snprintf(label,sizeof label,"runner-plan-%02d.stdout",++SC_ID_SEQ);out=sc_path(label);snprintf(label,sizeof label,"runner-plan-%02d.stderr",SC_ID_SEQ);err=sc_path(label);{char*a[]={"tests/bound","8","sh","./unisacc.com","-cx-plan","tests/suite/run.cx",0};if(sc_child(a,out,err))sc_no("runner dependency plan");}
 plan=sc_load(out);sc_add(&b,plan,strlen(plan)+1);line=plan;while(*line){char*t,*u,*v;end=strchr(line,'\n');if(!end)end=line+strlen(line);if(end==line)sc_no("empty runner plan row");t=memchr(line,'\t',end-line);if(!t||t==line)sc_no("runner plan index");for(u=line;u<t;u++)if(*u<'0'||*u>'9')sc_no("runner plan index syntax");u=t+1;v=memchr(u,'\t',end-u);if(!v)v=end;if(v==u)sc_no("runner plan source path");char saved=*v;*v=0;sc_file_id(&b,u);*v=saved;units++;line=*end?end+1:end;}free(plan);if(!units)sc_no("empty runner dependency closure");
 {size_t count=0,j;char**env=0;while(environ[count])count++;env=malloc(count*sizeof*env);if(count&&!env)sc_no("runner environment allocation");for(j=0;j<count;j++)env[j]=environ[j];qsort(env,count,sizeof*env,sc_name_cmp);for(j=0;j<count;j++)sc_add(&b,env[j],strlen(env[j])+1);free(env);}
 cx_sha256_hex(b.s,b.n,hash);free(b.s);if(sc_now()-SC_START>47)sc_no("selftest time budget");}
static void sc_runner_material(char h[65]){struct stat st;size_t n;char*s;if(lstat(SC_RUN_TOOL,&st)||!S_ISREG(st.st_mode)||st.st_uid!=getuid()||st.st_size<=0||!(st.st_mode&0111)||access(SC_RUN_TOOL,X_OK))sc_no("runner missing/owner/type/execute integrity");s=cx_read(SC_RUN_TOOL,&n);if(!s||n!=(size_t)st.st_size)sc_no("runner artifact read");cx_sha256_hex(s,n,h);free(s);}
static void sc_runner_verify(void){char id[65],actual[65];SC_INPUTS_UNVERIFIED=1;sc_runner_identity(id);if(strcmp(id,SC_RUN_ID))sc_no("runner build inputs changed");sc_runner_material(actual);if(strcmp(actual,SC_RUN_SHA))sc_no("runner bytes changed");SC_INPUTS_UNVERIFIED=0;}
static void sc_runner_prepare(void){char id[65];if(SC_COMPILER_PINNED)sc_no("duplicate runner preparation");SC_INPUTS_UNVERIFIED=1;sc_compiler_hash("unisacc.com",SC_COMPILER_SHA);sc_compiler_hash("unisacc.com.build.json",SC_SIDECAR_SHA);SC_COMPILER_PINNED=1;SC_RUN_TOOL=sc_path("run-tool");{char*a[]={"tests/bound","8","uname","-s","-m",0};if(sc_child(a,sc_path("runner-machine.stdout"),sc_path("runner-machine.stderr")))sc_no("runner machine identity");SC_MACHINE=sc_load(sc_path("runner-machine.stdout"));}sc_runner_identity(SC_RUN_ID);{char*a[]={"tests/bound","8","sh","./unisacc.com","-o",SC_RUN_TOOL,"tests/suite/run.cx",0};if(sc_child(a,sc_path("runner-build.stdout"),sc_path("runner-build.stderr")))sc_no("runner construction");}sc_runner_identity(id);if(strcmp(id,SC_RUN_ID))sc_no("runner inputs changed during construction");sc_runner_material(SC_RUN_SHA);if(sc_now()-SC_START>47)sc_no("selftest time budget");SC_INPUTS_UNVERIFIED=0;}

static int sc_run(const char*plan,const char*cat,const char*out,const char*selector,const char*value,const char*graph,const char*order,int container){char*a[32];int n=0;sc_runner_verify();a[n++]="tests/bound";a[n++]="8";a[n++]=SC_RUN_TOOL;a[n++]=(char*)plan;a[n++]=(char*)cat;a[n++]=(char*)out;a[n++]=(char*)selector;a[n++]=(char*)value;a[n++]="--graph";a[n++]=(char*)graph;a[n++]="--order";a[n++]=(char*)order;a[n++]="--jobs";a[n++]="2";a[n++]="--limit";a[n++]=!strcmp(selector,"--module")?"1":"2";a[n++]=container?"--parent-container-value":"--parent-container-unset";if(container)a[n++]="suite-parent-value";a[n]=0;return sc_call(a);}
/* Separate fail-fast regression budget: three tiny runner calls, no producers. */
static int sc_ff_run(const char*plan,const char*cat,const char*out,const char*graph,const char*order,int jobs,const char*layer){char*a[32];int n=0;a[n++]="tests/bound";a[n++]="8";a[n++]="sh";a[n++]="./unisacc.com";a[n++]="tests/suite/run.cx";a[n++]="--";a[n++]=(char*)plan;a[n++]=(char*)cat;a[n++]=(char*)out;a[n++]="--module";a[n++]="fixture";if(graph){a[n++]="--graph";a[n++]=(char*)graph;a[n++]="--order";a[n++]=(char*)order;}else a[n++]="--independent";if(layer){a[n++]="--layer";a[n++]=(char*)layer;}a[n++]="--jobs";a[n++]=jobs==1?"1":"2";a[n++]="--limit";a[n++]="3";a[n++]="--parent-container-unset";a[n++]="--fail-fast";a[n]=0;return sc_call(a);}
static void sc_ff_materials(const char*dir,int first){int i,j;char name[128];const char*ext[]={"argv.nul","stdout","stderr"};for(i=first;i<=5;i++){for(j=0;j<3;j++){snprintf(name,sizeof name,"%s/%05d.%s",dir,i,ext[j]);sc_absent(sc_path(name));}snprintf(name,sizeof name,"%s/%05d.rc",dir,i);{char*s=sc_load(sc_path(name));sc_ok(!strcmp(s,"-\n"),"unstarted rc is unavailable");free(s);}snprintf(name,sizeof name,"%s/%05d.elapsed",dir,i);{char*s=sc_load(sc_path(name));sc_ok(!strcmp(s,"-\n"),"unstarted elapsed is unavailable");free(s);}}}
static int sc_failfast(void){ScBuf raw={0};char pattern[]="/tmp/unisacc-suite-failfast-XXXXXX";char *plan,*cat,*order,*graph,*drained,*sentinel,*ma,*mb,*s;char ph[65],oh[65],row[2048];const char*av[5];int n,rc;SC_START=sc_now();if(!mkdtemp(pattern))return 2;snprintf(SC_DIR,sizeof SC_DIR,"%s",pattern);plan=sc_path("plan.nul");cat=sc_path("catalog.tsv");order=sc_path("order.json");graph=sc_path("graph.tsv");drained=sc_path("drained");sentinel=sc_path("sentinel");ma=sc_path("a-started");mb=sc_path("b-started");
 av[0]="/bin/sh";av[1]="-c";av[2]="exit 7";sc_record(&raw,"fail",3,av);av[2]="sleep 1; printf drained > \"$1\"; printf drained";av[3]="fixture";av[4]=drained;sc_record(&raw,"running",5,av);av[2]="printf started > \"$1\"";av[4]=sentinel;sc_record(&raw,"sentinel",5,av);av[4]=ma;sc_record(&raw,"a",5,av);av[4]=mb;sc_record(&raw,"b",5,av);sc_put(plan,raw.s,raw.n);cx_sha256_hex(raw.s,raw.n,ph);s="{\"after\":{\"a\":[\"fail\"],\"b\":[\"a\"]}}\n";sc_put(order,s,strlen(s));cx_sha256_hex(s,strlen(s),oh);n=snprintf(row,sizeof row,"#plan_sha256\t%s\n#units\t5\nfail\tfixture\tunit\nrunning\tfixture\tunit\nsentinel\tfixture\tunit\na\tfixture\tprepare\nb\tfixture\tprepare\n",ph);sc_put(cat,row,n);n=snprintf(row,sizeof row,"#plan_sha256\t%s\n#order_sha256\t%s\n#nodes\t5\nedge\ta\tfail\nedge\tb\ta\n",ph,oh);sc_put(graph,row,n);
 sc_ok(sc_ff_run(plan,cat,sc_path("jobs1"),0,0,1,0)==1,"fail-fast jobs1 returns failure");sc_has(sc_path("jobs1/results.tsv"),"fail\tfixture\tunit\tFAIL\t7\t");sc_has(sc_path("jobs1/results.tsv"),"sentinel\tfixture\tunit\tNOT_RUN\t-\t-\t");sc_has(sc_path("jobs1/summary.tsv"),"selected\t5\ndisposed\t5\nexecuted\t1\ntest_pass\t0\nprepared\t0\nfailed\t1\nblocked\t0\nnot_run\t4\n");sc_has(sc_path("jobs1/completion.tsv"),"selected\t5\ndisposed\t5\nexecuted\t1\ntest_pass\t0\nprepared\t0\nfailed\t1\nblocked\t0\nnot_run\t4\n");sc_ff_materials("jobs1",2);sc_absent(drained);sc_absent(sentinel);sc_absent(ma);sc_absent(mb);
 sc_ok(sc_ff_run(plan,cat,sc_path("jobs2"),graph,order,2,0)==1,"fail-fast jobs2 returns failure");sc_has(sc_path("jobs2/results.tsv"),"fail\tfixture\tunit\tFAIL\t7\t");sc_has(sc_path("jobs2/results.tsv"),"running\tfixture\tunit\tPASS\t0\t");sc_has(sc_path("jobs2/results.tsv"),"a\tfixture\tprepare\tBLOCKED\t-\t-\t");sc_has(sc_path("jobs2/results.tsv"),"b\tfixture\tprepare\tBLOCKED\t-\t-\t");sc_has(sc_path("jobs2/results.tsv"),"sentinel\tfixture\tunit\tNOT_RUN\t-\t-\t");sc_has(sc_path("jobs2/summary.tsv"),"selected\t5\ndisposed\t5\nexecuted\t2\ntest_pass\t1\nprepared\t0\nfailed\t1\nblocked\t2\nnot_run\t1\n");sc_has(sc_path("jobs2/completion.tsv"),"selected\t5\ndisposed\t5\nexecuted\t2\ntest_pass\t1\nprepared\t0\nfailed\t1\nblocked\t2\nnot_run\t1\n");sc_has(sc_path("jobs2/00002.stdout"),"drained");sc_has(drained,"drained");sc_has(sc_path("jobs2/00001.rc"),"7\n");sc_has(sc_path("jobs2/00002.rc"),"0\n");sc_ff_materials("jobs2",3);sc_absent(sentinel);sc_absent(ma);sc_absent(mb);
 sc_ok(sc_ff_run(plan,cat,sc_path("layer"),graph,order,1,"prepare")==1,"layer filter restores failed predecessor from another layer");sc_has(sc_path("layer/identity.tsv"),"auto_added\t1\n");sc_has(sc_path("layer/results.tsv"),"fail\tfixture\tunit\tFAIL\t7\t");sc_has(sc_path("layer/results.tsv"),"a\tfixture\tprepare\tBLOCKED\t-\t-\t");sc_has(sc_path("layer/results.tsv"),"b\tfixture\tprepare\tBLOCKED\t-\t-\t");sc_has(sc_path("layer/summary.tsv"),"selected\t3\ndisposed\t3\nexecuted\t1\ntest_pass\t0\nprepared\t0\nfailed\t1\nblocked\t2\nnot_run\t0\n");sc_has(sc_path("layer/completion.tsv"),"selected\t3\ndisposed\t3\nexecuted\t1\ntest_pass\t0\nprepared\t0\nfailed\t1\nblocked\t2\nnot_run\t0\n");sc_ff_materials("layer",4);sc_absent(sc_path("layer/00002.argv.nul"));sc_absent(sc_path("layer/00002.stdout"));sc_absent(sc_path("layer/00002.stderr"));sc_absent(sc_path("layer/00003.argv.nul"));sc_absent(sc_path("layer/00003.stdout"));sc_absent(sc_path("layer/00003.stderr"));sc_absent(sentinel);sc_absent(ma);sc_absent(mb);
 rc=sc_clean();if(rc){fprintf(stderr,"suite-check fail-fast cleanup refused rc%d\n",rc);return 1;}sc_absent(pattern);n=snprintf(row,sizeof row,"suite-check fail-fast PASS checks=%d cases=3\n",SC_CHECKS);sc_write(1,row,n);return 0;}
int main(int argc,char**argv){ScBuf raw={0};char *plan,*cat,*order,*graph,*marker,*forbidden,*out,*s,*p,*q,*badgraph,*badorder;size_t n;char pattern[]="/tmp/unisacc-suite-check-XXXXXX";const char*av[5];int rc;(void)argv;if(argc==2&&!strcmp(argv[1],"--fail-fast"))return sc_failfast();if(argc!=1){fprintf(stderr,"usage: unisacc.com tests/suite/check.cx\n");return 2;}SC_START=sc_now();if(!mkdtemp(pattern))return 2;snprintf(SC_DIR,sizeof SC_DIR,"%s",pattern);sc_runner_prepare();
 plan=sc_path("plan.nul");cat=sc_path("catalog.tsv");order=sc_path("order.json");graph=sc_path("graph.tsv");marker=sc_path("prepared");forbidden=sc_path("forbidden");
 av[0]="/bin/sh";av[1]="-c";av[2]="printf ready > \"$1\"";av[3]="fixture";av[4]=marker;sc_record(&raw,"exec-prepare-suite",5,av);
 av[2]="test \"$(cat \"$1\")\" = ready || exit 9; printf '%s:%s' \"\x24{UNISA_CONTAINER+x}\" \"\x24{UNISA_CONTAINER-}\"";sc_record(&raw,"suite-consumer",5,av);
 av[2]="exit 3";sc_record(&raw,"exec-prepare-fails",3,av);
 av[2]="printf forbidden > \"$1\"";av[4]=forbidden;sc_record(&raw,"suite-blocked",5,av);
 av[2]="exit 77";sc_record(&raw,"exec-e4-rc77",3,av);
 av[0]="/bin/sleep";av[1]="5";sc_record(&raw,"exec-e4-rc142",2,av);sc_put(plan,raw.s,raw.n);
 s="{\"after\":{\"suite-consumer\":\"exec-prepare-suite\",\"suite-blocked\":\"exec-prepare-fails\"}}\n";sc_put(order,s,strlen(s));
 {char*a[]={"tests/bound","8","sh","./unisacc.com","tests/suite/catalog.cx","--",plan,cat,0};sc_ok(sc_call(a)==0,"catalog fixture generation");}
 {char*a[]={"tests/bound","8","sh","./unisacc.com","tests/suite/graph.cx","--",plan,order,graph,0};sc_ok(sc_call(a)==0,"graph fixture generation");}
 {char*a[]={"tests/bound","8","sh","./unisacc.com","tests/suite/prepdecl.cx","--","--check","tests/prepgroups.json",0};sc_ok(sc_call(a)==0,"43 preparation groups validate without execution");sc_has(sc_path("step-03.stdout"),"groups\t43\nsteps\t193\n");}
 out=sc_path("success-unset");sc_ok(sc_run(plan,cat,out,"--unit","suite-consumer",graph,order,0)==0,"dependency success");sc_has(sc_path("success-unset/identity.tsv"),"auto_added\t1\n");sc_has(sc_path("success-unset/summary.tsv"),"test_pass\t1\nprepared\t1\nfailed\t0\nblocked\t0\n");s=sc_load(sc_path("success-unset/results.tsv"));p=strstr(s,"exec-prepare-suite\t");q=strstr(s,"suite-consumer\t");sc_ok(p&&q&&p<q,"predecessor completed before consumer");sc_ok(strstr(s,"\tPREPARED\t0\t")&&strstr(s,"\tPASS\t0\t"),"PREPARED distinct from PASS");free(s);s=sc_load(sc_path("success-unset/00002.stdout"));sc_ok(!strcmp(s,":"),"parent UNISA_CONTAINER unset restored");free(s);
 out=sc_path("success-value");sc_ok(sc_run(plan,cat,out,"--unit","suite-consumer",graph,order,1)==0,"dependency explicit-parent success");s=sc_load(sc_path("success-value/00002.stdout"));sc_ok(!strcmp(s,"x:suite-parent-value"),"parent UNISA_CONTAINER value restored");free(s);
 out=sc_path("blocked");sc_ok(sc_run(plan,cat,out,"--unit","suite-blocked",graph,order,0)==1,"nonzero predecessor blocks consumer");sc_has(sc_path("blocked/summary.tsv"),"executed\t1\ntest_pass\t0\nprepared\t0\nfailed\t1\nblocked\t1\n");sc_has(sc_path("blocked/results.tsv"),"\tBLOCKED\t-\t-\t");sc_absent(forbidden);sc_absent(sc_path("blocked/00004.stdout"));sc_absent(sc_path("blocked/00004.stderr"));sc_absent(sc_path("blocked/00004.argv.nul"));
 out=sc_path("real-nonzero");sc_ok(sc_run(plan,cat,out,"--module","e4",graph,order,0)==1,"rc77 and real watchdog timeout fail");sc_has(sc_path("real-nonzero/00005.rc"),"77\n");sc_has(sc_path("real-nonzero/00006.rc"),"142\n");sc_has(sc_path("real-nonzero/summary.tsv"),"test_pass\t0\nprepared\t0\nfailed\t2\nblocked\t0\n");
 badgraph=sc_path("bad-graph.tsv");s=cx_read(graph,&n);if(!s)sc_no("graph read");p=strstr(s,"#plan_sha256\t");if(!p)sc_no("graph header");p+=13;*p=*p=='0'?'1':'0';sc_put(badgraph,s,n);free(s);out=sc_path("bad-graph-run");sc_ok(sc_run(plan,cat,out,"--unit","suite-consumer",badgraph,order,0)==2,"wrong graph plan binding rejected");sc_absent(out);
 badorder=sc_path("bad-order.json");s="{\"after\":{}}\n";sc_put(badorder,s,strlen(s));out=sc_path("bad-order-run");sc_ok(sc_run(plan,cat,out,"--unit","suite-consumer",graph,badorder,0)==2,"wrong order binding rejected");sc_absent(out);
 rc=sc_clean();if(rc){fprintf(stderr,"suite-check cleanup refused rc%d\n",rc);return 1;}sc_absent(pattern);{char msg[128];int z=snprintf(msg,sizeof msg,"suite-check PASS checks=%d cases=7\n",SC_CHECKS);sc_write(1,msg,z);}return 0;}
