#pragma unisa use text.text
/* aluiwidth.cx -- ALUI width ratchet (AUDIT-DUP, 2026-11-05). ALUI is 32-bit arithmetic
   (cx/core/alu.cx core_alu32); a "mul" by a constant >= 65536 or by a ["constant",...] name,
   or a "shl" by >= 16, is where a 64-bit offset can be truncated (al64-fix.patch moved two
   such sites to A64I). Per exec/<dir>/<name>-result.tsv the count of such actions is compared
   with tests/aluiwidth.tsv; counts only go down. Report-only in spirit: no site is rejected
   for being wide, only for being new.
     sh ./unisacc.com -run tests/aluiwidth.cx -- --check | --write */
/* --check --files PATH... scans only named result tables. Changes to manifests,
   facts, or this ratchet/baseline retain a full scan because bindings are shared. */
#define BASELINE "tests/aluiwidth.tsv"
#define MAXR 512

typedef struct { char path[256]; int count; int used; } Row;
static Row rows[MAXR];
static int nrows;

static long num(const char *s, long n, long *i) {
    long v = 0; int any = 0;
    while (*i < n && s[*i] >= '0' && s[*i] <= '9') { v = v * 10 + (s[*i] - '0'); (*i)++; any = 1; }
    return any ? v : -1;
}

/* A ["constant",NAME] operand is judged by its value: the manifests next to the table bind NAME=RHS
   (bind column, rows/template/table/let ops of the table's stem) and RHS is looked up in the facts files
   named in that row (`=RHS<TAB>int<TAB>V` or `RHS<TAB>V`).  Every binding found must resolve to a number;
   one that does not (no binding, a computed @ref/$ value, a missing fact) counts as the worst case.
   No value is stored here: the manifests and exec/facts are the one source. */
#define WORST 0x7fffffffffffffffL
typedef struct { char name[64]; long v; } Bind;
static Bind bnd[512];
static int nbnd;
static void bind_put(const char *s, long n, long v) {
    int q;
    if (n <= 0 || n >= 64) return;
    for (q = 0; q < nbnd; q++) if ((long)tx_len(bnd[q].name, 64) == n && tx_prefix(bnd[q].name, 64, s, n)) { if (v > bnd[q].v) bnd[q].v = v; return; }
    if (nbnd == 512) return;
    { long k; for (k = 0; k < n; k++) bnd[nbnd].name[k] = s[k]; bnd[nbnd].name[n] = 0; }
    bnd[nbnd++].v = v;
}
static long bind_get(const char *s, long n) {
    int q;
    for (q = 0; q < nbnd; q++) if ((long)tx_len(bnd[q].name, 64) == n && tx_prefix(bnd[q].name, 64, s, n)) return bnd[q].v;
    return WORST;
}
static int word(char c) { return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_'; }
/* RHS in one facts file: `=RHS\tint\tV` or `RHS\tV`; WORST when absent. */
static long fact_value(const char *fact, long fn, const char *rhs, long rn) {
    char path[300]; size_t n, i = 0; char *b; long v = WORST;
    if (fn <= 0 || fn > 200 || cx_fmt(path, sizeof path, "exec/facts/%.*s.tsv", (int)fn, fact)) return WORST;
    b = cx_read(path, &n); if (!b) return WORST;
    while (i < n && v == WORST) {
        size_t e = i, s = i; long at;
        while (e < n && b[e] != '\n') e++;
        if (b[s] == '=') s++;
        if (e - s > (size_t)rn && tx_prefix(b + s, (long)(e - s), rhs, rn) && b[s + rn] == '\t') {
            at = (long)(s + rn + 1);
            if (b[i] == '=') { if (tx_prefix(b + at, (long)e - at, "int\t", 4)) at += 4; else at = (long)e; }
            { long neg = at < (long)e && b[at] == '-'; if (neg) at++; v = num(b, (long)e, &at); if (v >= 0 && at == (long)e) v = neg ? -v : v; else v = WORST; }
        }
        i = e + 1;
    }
    free(b); return v;
}
/* Bindings of stem STEM from every exec/DIR/ *-manifest.tsv. */
static void load_binds(const char *dir, long dn, const char *stem, long sn) {
    char pat[400], *list = 0, *rec, *end; size_t ln = 0;
    nbnd = 0;
    if (cx_fmt(pat, sizeof pat, "git ls-files -z -- 'exec/%.*s/*-manifest.tsv'", (int)dn, dir) || cx_run_timeout(pat, 50, &list, &ln) != 0 || !list) return;
    for (rec = list, end = list + ln; rec < end; rec += strlen(rec) + 1) {
        size_t n, i = 0; char *b = *rec ? cx_read(rec, &n) : 0;
        if (!b) continue;
        while (i < n) {
            size_t e = i, f[10], nf = 1, k; f[0] = i;
            while (e < n && b[e] != '\n') { if (b[e] == '\t' && nf < 10) f[nf++] = e + 1; e++; }
            if (nf >= 8 && b[i] != '#' && (long)((nf > 2 ? f[2] - 1 : e) - f[1]) == sn && tx_prefix(b + f[1], sn, stem, sn)) {
                size_t be = nf > 8 ? f[8] - 1 : e, fe = f[5] - 1, p = f[7];
                while (p < be) {
                    size_t q = p, eq, r;
                    while (q < be && b[q] != ',') q++;
                    for (eq = p; eq < q && b[eq] != '='; eq++) {}
                    if (eq < q) {
                        long v = WORST; int plain = 1;
                        for (r = eq + 1; r < q; r++) if (!word(b[r])) plain = 0;
                        if (plain && q > eq + 1) {
                            size_t a = f[4];
                            while (a < fe && v == WORST) {
                                size_t z = a; while (z < fe && b[z] != '+') z++;
                                if (!(z - a == 1 && b[a] == '-')) v = fact_value(b + a, (long)(z - a), b + eq + 1, (long)(q - eq - 1));
                                a = z + 1;
                            }
                        }
                        bind_put(b + p, (long)(eq - p), v);
                    }
                    p = q + 1;
                }
            }
            k = e; i = k + 1;
        }
        free(b);
    }
    free(list);
}

/* Count ["ALUI","mul"|"shl",A,B,K] with a wide K in one result table. */
static int count_wide(const char *s, long n) {
    static const char pat[] = "[\"ALUI\",\"";
    long i; int c = 0;
    for (i = 0; i + 10 < n; i++) {
        long j, k, commas = 0; int mul, shl;
        if (s[i] != '[' || !tx_prefix(s + i, n - i, pat, 9)) continue;
        j = i + 9;
        mul = tx_prefix(s + j, n - j, "mul\"", 4); shl = tx_prefix(s + j, n - j, "shl\"", 4);
        if (!mul && !shl) continue;
        j += 4;
        for (k = j; k < n && commas < 3; k++) {          /* skip ,"dst",A, to the fourth operand */
            if (s[k] == '[') { int d = 1; k++; while (k < n && d) { if (s[k] == '[') d++; else if (s[k] == ']') d--; k++; } k--; }
            else if (s[k] == ',') commas++;
            else if (s[k] == ']' || s[k] == '\n') break;
        }
        if (commas < 3 || k >= n) continue;
        if (tx_prefix(s + k, n - k, "[\"constant\",\"", 13)) {
            long a = k + 13, z = a;
            while (z < n && s[z] != '"') z++;
            if (mul && bind_get(s + a, z - a) >= 65536) c++;
            continue;
        }
        {   long at = k, v = num(s, n, &at);
            if (v >= 0 && ((mul && v >= 65536) || (shl && v >= 16))) c++; }
    }
    return c;
}

/* STRIDE bound to 16 (narrow), BIG bound to 70000 (wide, the negative control), NOPE unbound (worst case),
   plus literal shl 16 and mul 67108864: 4 wide. */
static int self_check(void) {
    static const char t[] = "a\tb\t*\tc\t[[\"ALUI\",\"mul\",\"x\",\"y\",[\"constant\",\"STRIDE\"]],[\"ALUI\",\"shl\",\"x\",\"y\",16],"
                            "[\"ALUI\",\"mul\",\"x\",\"y\",8],[\"ALUI\",\"add\",\"x\",\"y\",70000],[\"ALUI\",\"mul\",\"x\",\"y\",67108864],[\"A64I\",\"mul\",\"x\",\"y\",[\"constant\",\"S\"]],"
                            "[\"ALUI\",\"mul\",\"x\",\"y\",[\"constant\",\"BIG\"]],[\"ALUI\",\"mul\",\"x\",\"y\",[\"constant\",\"NOPE\"]]]\n";
    int c;
    nbnd = 0; bind_put("STRIDE", 6, 16); bind_put("BIG", 3, 70000);
    c = count_wide(t, (long)sizeof t - 1);
    nbnd = 0;
    return c == 4;
}

static int load_baseline(void) {
    size_t n, i = 0; char *b = cx_read(BASELINE, &n);
    if (!b) { fprintf(stderr, "aluiwidth: cannot read %s (run --write once)\n", BASELINE); return -1; }
    while (i < n) {
        size_t e = i; while (e < n && b[e] != '\n') e++;
        if (e > i && b[i] != '#') {
            size_t t = i; long at;
            while (t < e && b[t] != '\t') t++;
            if (t == e || t - i >= 256 || nrows == MAXR) { fprintf(stderr, "aluiwidth: bad row\n"); free(b); return -1; }
            { size_t k; for (k = i; k < t; k++) rows[nrows].path[k - i] = b[k]; rows[nrows].path[t - i] = 0; }
            at = (long)t + 1; rows[nrows].count = (int)num(b, (long)e, &at);
            if (rows[nrows].count < 0) { fprintf(stderr, "aluiwidth: bad count\n"); free(b); return -1; }
            nrows++;
        }
        i = e + 1;
    }
    free(b); return 0;
}

int main(int argc, char **argv) {
    char *list = 0, *rec, *end; size_t ln = 0; int check, files = 0, total = 0, base_total = 0, over = 0, under = 0, k, rc;
    int scoped = argc >= 4 && tx_eqz(argv[1], "--check") && tx_eqz(argv[2], "--files"), full = !scoped;
    if (!scoped && (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write")))) {
        fprintf(stderr, "usage: aluiwidth.cx --check [--files PATH...] | --write\n"); return 2;
    }
    /* Missing old paths from deletion/rename require the original full discovery. */
    for (k = 3; scoped && k < argc; k++) if (access(argv[k], F_OK) || !tx_prefixz(argv[k], "exec/", 5) || !tx_suffix(argv[k], tx_len(argv[k], 4096), "-result.tsv", 11)) full = 1;
    if (!self_check()) { fprintf(stderr, "aluiwidth: self-check failed\n"); return 2; }
    check = tx_eqz(argv[1], "--check");
    if (check && load_baseline() < 0) return 2;
    rc = cx_run("git ls-files -z -- 'exec/*-result.tsv'", &list, &ln);
    if (rc != 0 || !list) { fprintf(stderr, "aluiwidth: git ls-files failed (rc %d)\n", rc); return 2; }
    {   char *out = 0; size_t olen = 0, ocap = 0;
        static const char head[] = "# tests/aluiwidth.tsv -- written by tests/aluiwidth.cx --write.\n"
                                   "# ALUI mul by a value >= 65536 (a [\"constant\",...] name by its bound value, unresolved = worst case), or shl >= 16 (32-bit; may truncate a 64-bit offset).\n"
                                   "# Counts only go down. A missing row is held at 0.\n# path\tcount\n";
        if (!check) { out = malloc(ocap = sizeof head + 400 * 300); if (!out) return 2; for (olen = 0; head[olen]; olen++) out[olen] = head[olen]; }
        for (rec = list, end = list + ln; rec < end; rec += strlen(rec) + 1) {
            size_t n; char *src; int c;
            if (!*rec) continue;
            if (!full) { int selected = 0; for (k = 3; k < argc; k++) if (tx_eqz(rec, argv[k])) selected = 1; if (!selected) continue; }
            src = cx_read(rec, &n);
            {   const char *d = rec + 5, *sl = d, *st, *se;   /* exec/DIR/STEM-result.tsv */
                while (*sl && *sl != '/') sl++;
                st = *sl ? sl + 1 : sl; se = st; while (*se) se++;
                if (se - st > 11) load_binds(d, (long)(sl - d), st, (long)(se - st - 11)); else nbnd = 0; }
            c = src ? count_wide(src, (long)n) : 0;
            free(src); files++; total += c;
            if (check) {
                Row *r = 0; int q;
                for (q = 0; q < nrows; q++) if (tx_eqz(rows[q].path, rec)) r = &rows[q];
                if (r) r->used = 1;
                if (c > (r ? r->count : 0)) { printf("aluiwidth: %s has %d wide ALUI, baseline %d\n", rec, c, r ? r->count : 0); over++; }
                else if (r && c < r->count) under++;
            } else if (c > 0) {
                char line[300]; int w = 0;
                if (cx_fmt(line, sizeof line, "%s\t%d\n", rec, c) || olen + sizeof line >= ocap) return 2;
                while (line[w]) out[olen++] = line[w++];
            }
        }
        free(list);
        if (!check) {
            if (cx_write(BASELINE, out, olen)) { fprintf(stderr, "aluiwidth: cannot write %s\n", BASELINE); return 2; }
            free(out);
            printf("aluiwidth: wrote %s: %d tables, %d wide ALUI\n", BASELINE, files, total);
            return 0;
        }
    }
    for (k = 0; k < nrows; k++) if (full || rows[k].used) base_total += rows[k].count;
    printf("aluiwidth: %s: %d tables, %d wide ALUI (baseline %d); %d above baseline, %d below (--write ratchets down)\n",
           over ? "FAIL" : "ok", files, total, base_total, over, under);
    return over ? 1 : 0;
}
