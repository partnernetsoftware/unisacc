/* Installed-product RI unsupported-route refusal oracle; not full RI.
 * ROOT PRODUCT_COM NEW_OUTDIR. PRODUCT_COM must be ROOT/unisacc.com.
 * Object/run capture and tape-ledger-on-object must refuse before output. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
static char root[4096],work[4096],bound[4200],com[4200],src[4400];
static char cap_tape[4400],cap_obj[4400],cap_run[4400],obj[4400],obj2[4400];
static int assertions,failures;
static const char *msg_obj=
 "unisacc: INTERFACE_ERROR resource-route-unsupported lnx/x86_64/object/O0 (strict and capture cover tape and image routes only)\n";
static const char *msg_run=
 "unisacc: INTERFACE_ERROR resource-route-unsupported lnx/x86_64/run/O0 (strict and capture cover tape and image routes only)\n";
static void die(const char *s){fprintf(stderr,"ri-route-refuse: REFUSE %s\n",s);exit(2);}
static void copy_fit(char *dst, size_t cap, const char *src){size_t i=0;if(cap==0)die("copy-bound");while(src[i]&&i+1<cap){dst[i]=src[i];i++;}if(src[i])die("copy-bound");dst[i]=0;}
static void ck(int ok,const char *s){assertions++;if(!ok){failures++;fprintf(stderr,"FAIL\t%s\n",s);}else printf("PASS\t%s\n",s);}
static void path(char *o,size_t cap,const char *a,const char *b){int n=snprintf(o,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path");}
static void saved(const char *p,const void *s,size_t n){int f=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC,0600);size_t at=0;if(f<0)die(p);while(at<n){ssize_t k=write(f,(char *)s+at,n-at);if(k<0&&errno==EINTR)continue;if(k<=0)die("write");at+=(size_t)k;}if(close(f))die("close");}
static void sha_file(const char *p,char hex[65]){size_t n;char *s=cx_read(p,&n);if(!s)die(p);cx_sha256_hex(s,n,hex);free(s);}
static np_result runv(char **v,const char *cwd,const char **env,int sec,const char *name){
 char why[1024],op[4400],ep[4400];np_result r;int z;
 if(np_run(v,cwd,env,sec,&r,why,sizeof why))die(why);
 z=snprintf(op,sizeof op,"%s/%s.stdout",work,name);if(z<0||(size_t)z>=sizeof op)die("out");
 z=snprintf(ep,sizeof ep,"%s/%s.stderr",work,name);if(z<0||(size_t)z>=sizeof ep)die("err");
 saved(op,r.out,r.outn);saved(ep,r.err,r.errn);return r;}
static int err_ok(const np_result *r){return !r->errn;}
static int missing(const char *p){struct stat st;errno=0;if(!lstat(p,&st))return 0;if(errno!=ENOENT)die("stat");return 1;}
static int dir_empty(const char *d){
 DIR *dp=opendir(d);struct dirent *e;if(!dp)die("opendir");
 while((e=readdir(dp))){if(tx_eq(e->d_name, ".", 1L << 20)||tx_eq(e->d_name, "..", 1L << 20))continue;closedir(dp);return 0;}
 closedir(dp);return 1;}
static int file_has(const char *p,const char *needle){size_t n;char *s=cx_read(p,&n);int ok=s&&strstr(s,needle);free(s);return ok;}
static int pref(char **v,int sec){int n=0;v[n++]=bound;v[n++]=sec<=12?"12":"15";v[n++]="sh";v[n++]=com;return n;}
static int exact_err(const np_result *r,const char *msg){
 size_t n=strlen(msg);return r->errn==(int)n&&r->errn>0&&!memcmp(r->err,msg,n);}
int main(int argc,char **argv){
 char before[65],after[65],envbuf[4600];
 if(argc!=4||!realpath(argv[1],root)||argv[2][0]!='/'||argv[3][0]!='/'||strstr(argv[3],".."))
  die("usage ROOT PRODUCT_COM ABS_OUT");
 {char expected[4200];path(expected,sizeof expected,root,"unisacc.com");if(!tx_eq(argv[2], expected, 1L << 20))die("installed-product-required");}
 if(unsetenv("UNISACC_RR_TIME")||unsetenv("UNISACC_RF_CAPTURE")||unsetenv("UNISA_ATTRIBUTES")||setenv("UNISACC_RUN_CACHE","0",1))die("clean-environment");
 copy_fit(com,sizeof com,argv[2]);copy_fit(work,sizeof work,argv[3]);
 if(mkdir(work,0700))die("mkdir");
 path(bound,sizeof bound,root,"tools/bound");
 path(src,sizeof src,work,"probe.c");
 {const char *s="int main(void){return 7;}\n";saved(src,s,strlen(s));}
 path(cap_tape,sizeof cap_tape,work,"cap-tape");
 path(cap_obj,sizeof cap_obj,work,"cap-obj");
 path(cap_run,sizeof cap_run,work,"cap-run");
 path(obj,sizeof obj,work,"probe.o");
 path(obj2,sizeof obj2,work,"probe2.o");
 if(mkdir(cap_tape,0700)||mkdir(cap_obj,0700)||mkdir(cap_run,0700))die("mkdir-cap");
 sha_file(com,before);
 /* P1 tape capture still works */
 {{int zn=snprintf(envbuf,sizeof envbuf,"UNISACC_RF_CAPTURE=%s",cap_tape);if(zn<0||(size_t)zn>=sizeof envbuf)die("capture-env");}
  const char *adds[]={envbuf,"UNISA_JOBS=1",0};char *v[24];int n=pref(v,15);
  v[n++]="-O0";v[n++]="-b";v[n++]="lnx/x86_64";v[n++]="-S";v[n++]=src;v[n++]="-o";v[n++]="-";v[n]=0;
  np_result r=runv(v,root,adds,18,"prod-capture-tape");
  ck(!r.rc&&err_ok(&r)&&r.outn>0,"ri.route.tape-capture-rc0");
  {char led[4400];path(led,sizeof led,cap_tape,"resources.tsv");
   ck(file_has(led,"e3:lnx/x86_64/tape/O0"),"ri.route.tape-ledger-stage");}
  np_free(&r);}
 /* N1 object capture refuse */
 {{int zn=snprintf(envbuf,sizeof envbuf,"UNISACC_RF_CAPTURE=%s",cap_obj);if(zn<0||(size_t)zn>=sizeof envbuf)die("capture-env");}
  const char *adds[]={envbuf,"UNISA_JOBS=1",0};char *v[24];int n=pref(v,12);
  v[n++]="-O0";v[n++]="-b";v[n++]="lnx/x86_64";v[n++]="-c";v[n++]="-funit";v[n++]=src;v[n++]="-o";v[n++]=obj;v[n]=0;
  np_result r=runv(v,root,adds,14,"prod-refuse-object-capture");
  ck(r.rc==2&&!r.outn&&exact_err(&r,msg_obj),"ri.route.object-capture-exact-refuse");
  ck(dir_empty(cap_obj),"ri.route.object-capture-no-ledger");
  ck(missing(obj),"ri.route.object-capture-no-output");
  np_free(&r);}
 /* N2 run capture refuse */
 {{int zn=snprintf(envbuf,sizeof envbuf,"UNISACC_RF_CAPTURE=%s",cap_run);if(zn<0||(size_t)zn>=sizeof envbuf)die("capture-env");}
  const char *adds[]={envbuf,"UNISA_JOBS=1",0};char *v[24];int n=pref(v,12);
  v[n++]="-O0";v[n++]="-b";v[n++]="lnx/x86_64";v[n++]="-run";v[n++]=src;v[n]=0;
  np_result r=runv(v,root,adds,14,"prod-refuse-run-capture");
  ck(r.rc==2&&!r.outn&&exact_err(&r,msg_run),"ri.route.run-capture-exact-refuse");
  ck(dir_empty(cap_run),"ri.route.run-capture-no-ledger");
  np_free(&r);}
 /* N3 strict tape ledger cannot authorize object route */
 {const char *adds[]={"UNISA_JOBS=1",0};char *v[28];int n=pref(v,12);
  v[n++]="--strict-resource-flow";v[n++]="--resource-ledger";v[n++]=cap_tape;
  v[n++]="-O0";v[n++]="-b";v[n++]="lnx/x86_64";v[n++]="-c";v[n++]="-funit";v[n++]=src;v[n++]="-o";v[n++]=obj2;v[n]=0;
  np_result r=runv(v,root,adds,14,"prod-refuse-object-strict-on-tape");
  ck(r.rc==2&&!r.outn&&exact_err(&r,msg_obj),"ri.route.object-strict-on-tape-exact-refuse");
  ck(missing(obj2),"ri.route.object-strict-on-tape-no-output");
  np_free(&r);}
 sha_file(com,after);
 ck(tx_eq(before, after, 1L << 20),"candidate-unchanged");
 puts("NOT_CLAIMED\tobject-run-route-support-full-RI-formats-foreign-hosts");
 printf("RI_ROUTE_REFUSE\tassertions=%d\tfailed=%d\tscope=installed-product-object-run-unsupported-not-full-RI\n",assertions,failures);
 return failures?1:0;}
