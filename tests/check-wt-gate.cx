/* tests/check-wt-gate.cx -- the wt gate in tools/all-waves.cx is live.
 *
 *   sh ./unisacc.com tests/check-wt-gate.cx [--] ROOT SESSION_PARENT
 *
 * SESSION_PARENT must be a directory under ROOT/out that the caller owns (the batch registration
 * passes {out}, which run-batch binds to its own output directory).  Taking it as an argument keeps
 * this source free of an "out/" literal, so the outdep ratchet stays at its baseline: the check
 * never reads an undeclared out/ residual, it only creates a fresh session below the caller's dir.
 *
 * The harness digest covers tests/, tools/ and cx/ only, so a batch that writes src/, include/,
 * exec/, kernel/, seed/ or a shared path under ROOT/out was invisible to every gate.  all-waves now
 * takes `git status --porcelain` before and after a wave; a moved shared path makes the whole wave
 * UNKNOWN.  This check proves that path is live, in three steps:
 *   1) a clean wave (two ordinary batches) comes back with identity=STABLE and no WT_CHANGED line;
 *   2) a wave containing tests/cases/wtprobe-batch.cx (which writes ROOT/src/_wt_probe.cx) prints
 *      WT_CHANGED with that exact path, and every receipt in the wave is UNKNOWN;
 *   3) the probe's file is removed afterwards, leaving the tree as it was.
 * Step 2 is the negative control: without the gate the probe's wave would have been PASS.
 * Exit 0 when all three hold, 1 otherwise, 2 on usage/IO. */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use cxlib.netpack
#pragma unisa use mem.bytes
#pragma unisa use text.text

static char g_root[4096], g_tab[4400], g_keep[4400], g_aw[4400];
static int asserts, failed, g_need_restore;
static char g_w[4400];
static void cleanup_scratch(void) {
    /* every exit path (pass, fail, REFUSE) removes this run's own scratch directory */
    if (g_w[0]) { char c[4600]; if (!cx_fmt(c, sizeof c, "rm -rf '%s'", g_w)) (void)system(c); g_w[0] = 0; }
}
static void die(const char *s) { fprintf(stderr, "check-wt-gate: REFUSE %s errno=%d\n", s, errno); cleanup_scratch(); exit(2); }
static void restore_batches(void) {
    size_t kn = 0; char *kb;
    if (!g_need_restore) return;
    kb = cx_read(g_keep, &kn);
    if (kb) { (void)cx_write(g_tab, kb, kn); free(kb); }
    g_need_restore = 0;
}
static void ck(int ok, const char *what, const char *detail) {
    asserts++;
    if (!ok) failed++;
    printf("%s\t%s%s%s\n", ok ? "PASS" : "FAIL", what, detail && *detail ? "\t" : "", detail ? detail : "");
}
/* run one command in ROOT and return its stdout as a NUL-terminated buffer (caller frees). */
static char *run(const char *args, int *rc) {
    char cmd[9000];
    char *v[] = {"sh", "-c", cmd, 0};
    np_result r = {0};
    char why[512] = {0};
    char *out;
    if (cx_fmt(cmd, sizeof cmd, "%s", args)) die("cmd");
    if (np_run(v, g_root, 0, 120, &r, why, sizeof why)) die(why);
    *rc = r.rc;
    out = calloc(1, r.outn + 1);
    if (!out) die("alloc");
    if (r.outn) mm_copy(out, r.outn + 1, r.out, r.outn);
    np_free(&r);
    return out;
}
static int has(const char *s, const char *want) {
    size_t n, w, i;
    if (!s) return 0;
    n = strlen(s); w = strlen(want);
    for (i = 0; i + w <= n; i++) if (!memcmp(s + i, want, w)) return 1;
    return 0;
}
int main(int argc, char **argv) {
    char w[4400], sess_parent[4400], *o, *probe;
    int rc, a = argc >= 2 && tx_eqz(argv[1], "--") ? 2 : 1, m_clean, m_probe;
    if (argc != a + 3) die("usage: ROOT SESSION_PARENT clean|probe");
    m_clean = tx_eqz(argv[a + 2], "clean");
    m_probe = tx_eqz(argv[a + 2], "probe");
    if (!m_clean && !m_probe) die("usage: mode must be clean or probe");
    if (!realpath(argv[a], g_root)) die("root");
    if (!realpath(argv[a + 1], sess_parent)) {
        /* run-batch hands {out}, a directory it owns; create it when this is the first batch there. */
        if (mkdir(argv[a + 1], 0700) && errno != EEXIST) die("session parent");
        if (!realpath(argv[a + 1], sess_parent)) die("session parent");
    }
    {   const char *td = getenv("TMPDIR");
        /* a run killed by its bound never reaches atexit: sweep this check's own stale scratch first --
           only wtgate-* directories older than 10 minutes that no live process names or sits in */
        {   char sw[9000];
            if (cx_fmt(sw, sizeof sw, "for d in $(find '%s' -maxdepth 1 -type d -name 'wtgate-*' -mmin +10 2>/dev/null); do pgrep -f -- \"$d\" >/dev/null 2>&1 && continue; ls -l /proc/[0-9]*/cwd 2>/dev/null | grep -qF -- \"$d\" && continue; rm -rf -- \"$d\"; done", td && td[0] ? td : "/tmp")) die("cmd");
            (void)system(sw); }
        if (cx_fmt(w, sizeof w, "%s/wtgate-XXXXXX", td && td[0] ? td : "/tmp") || !mkdtemp(w)) die("scratch");
        if (cx_fmt(g_w, sizeof g_w, "%s", w)) die("scratch");
        atexit(cleanup_scratch); }

    /* all-waves in -run mode demands a native run-batch beside itself: build both natives once, scratch-local.
       The probe clone of step 2 is made in the same parallel step (it only reads .git); the product launcher
       is not tracked, so the clone gets its own copy of ROOT's.  rc: 3 = a native build failed, 4 = clone failed. */
    {   char a[9000];
        char cl[4600] = "true", cpl[4600] = "true";
        if (m_probe && (cx_fmt(cl, sizeof cl, "git clone --local %s %s/pr", g_root, w) || cx_fmt(cpl, sizeof cpl, "cp ./unisacc.com %s/pr/unisacc.com", w))) die("cmd");
        if (cx_fmt(a, sizeof a, "mkdir -p %s/nat && { sh ./unisacc.com tests/run-batch.cx -o %s/nat/run-batch & p1=$!; { %s; } >/dev/null 2>&1 & p2=$!; sh ./unisacc.com tools/all-waves.cx -o %s/nat/all-waves; r=$?; wait $p1 || r=3; [ $r = 0 ] || r=3; wait $p2 || r=4; [ $r != 0 ] || %s || r=4; exit $r; }", w, w, cl, w, cpl)) die("cmd");
        o = run(a, &rc);
        free(o);
        if (rc == 4) die("local clone");
        if (rc != 0) die("native executors"); }
    if (cx_fmt(g_aw, sizeof g_aw, "%s/nat/all-waves", w)) die("paths");

    /* 1) a wave without the probe: STABLE, no WT_CHANGED (mode clean) */
    if (m_clean) {   char a[9000];
        if (cx_fmt(a, sizeof a, "./tools/bound 55 %s init %s %s/s1 ./unisacc.com - >/dev/null && ./tools/bound 55 %s wave %s %s/s1 --light cx-cell cx-target", g_aw, g_root, sess_parent, g_aw, g_root, sess_parent)) die("cmd");
        o = run(a, &rc);
        ck(rc == 0, "clean-wave-exit-0", "");
        ck(has(o, "identity=STABLE") && !has(o, "WT_CHANGED"), "clean-wave-no-wt-change", "");
        free(o); }

    /* 2) negative control: mutate batches only inside a local clone, never the session tree */
    if (m_probe) {   char a[9000], pr[4400], ptab[4400];
        const char *row = "wtprobe\tIMPLEMENTED\tcontract\ttests/cases/wtprobe-batch.cx\tSOURCE\tlnx/x86_64\t55\t-\ttests/cases/wtprobe-batch.cx\t-\tcontract.core-opkinds\trc0:WTPROBE\tproduct\tdaily\n";
        size_t bn = 0, kn0 = 0;
        char *body, *live;
        int inserted = 0;
        if (cx_fmt(g_keep, sizeof g_keep, "%s/batches.keep", w) || cx_fmt(g_tab, sizeof g_tab, "%s/tests/batches.tsv", g_root) || cx_fmt(pr, sizeof pr, "%s/pr", w) || cx_fmt(ptab, sizeof ptab, "%s/tests/batches.tsv", pr)) die("paths");
        live = cx_read(g_tab, &kn0);
        if (!live) die("batches read");
        if (cx_write(g_keep, live, kn0)) { free(live); die("keep write"); }
        /* the clone was made alongside the native builds above */
        body = cx_read(ptab, &bn);
        if (!body) { free(live); die("pr batches"); }
        {   size_t at = 0, cap = bn + strlen(row) + 1;
            char *outb = calloc(1, cap);
            if (!outb) { free(body); free(live); die("alloc"); }
            while (at < bn) {
                size_t e = at;
                while (e < bn && body[e] != '\n') e++;
                if (e + 1 <= bn) mm_copy(outb + strlen(outb), cap - strlen(outb), body + at, e - at + 1);
                if (!inserted && e - at > 9 && !memcmp(body + at, "cx-target\t", 10)) {
                    mm_copy(outb + strlen(outb), cap - strlen(outb), row, strlen(row));
                    inserted = 1;
                }
                at = e + 1;
            }
            if (!inserted) { free(outb); free(body); free(live); die("no cx-target row"); }
            if (cx_write(ptab, outb, strlen(outb))) { free(outb); free(body); free(live); die("pr batches write"); }
            free(outb); }
        free(body);
        if (cx_fmt(a, sizeof a, "mkdir -p %s/out && ./tools/bound 55 %s init %s %s/out/s2 %s/unisacc.com - >/dev/null && ./tools/bound 55 %s wave %s %s/out/s2 --light wtprobe cx-cell", pr, g_aw, pr, pr, pr, g_aw, pr, pr)) { free(live); die("cmd"); }
        probe = run(a, &rc);
        {   size_t tn = 0; char *tb = cx_read(g_tab, &tn);
            ck(tb && tn == kn0 && !memcmp(live, tb, kn0), "batches-sha-unchanged", "");
            free(tb); }
        free(live);
        ck(has(probe, "WT_CHANGED\tpaths=1\t?? src/_wt_probe.cx"), "probe-wave-reports-the-written-path", "");
        ck(has(probe, "reason=identity-changed-during-wave") && has(probe, "unknown=2"), "probe-wave-all-receipts-unknown", "");
        ck(has(probe, "changed=worktree-changed-during-wave"), "probe-wave-names-the-gate", "");
        free(probe);
        ck(1, "table-restored", ""); }

    /* 3) the tree is clean again */
    if (m_probe) {   char a[9000];
        if (cx_fmt(a, sizeof a, "git -C . status --porcelain -- src/_wt_probe.cx")) die("cmd");
        o = run(a, &rc);
        ck(rc == 0 && (!o || !o[0]), "probe-file-removed", "");
        free(o); }
    cleanup_scratch();
    printf("WT_GATE\tassertions=%d\tfailed=%d\n", asserts, failed);
    return failed ? 1 : 0;
}
