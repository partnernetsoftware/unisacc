/* host-cell.cx -- one host reports its own candidate cell, or says it did not run.
 *
 *   sh ./unisacc.com tests/host-cell.cx -- ROOT CANDIDATE_SHA
 *
 * CANDIDATE_SHA is the caller's explicit expected pp_product_digest(ROOT), in strict
 * lowercase hex.  On a host this product builds for, the file is hashed here and
 * compared: PASS or MISMATCH (rc 0 / 1).  The product version is read from the one
 * authority, ROOT/release/candidate.tsv, outside the source SID (F-v2).
 * On any other host the same line is printed with status=NOT_RUN and a reason, and
 * the exit code is 3 -- a host that did not run is never PASS.
 * ROOT and CANDIDATE_SHA are mandatory; no sidecar supplies an implicit candidate.
 * The actual product is hashed before the host gate; a foreign-host digest mismatch is
 * refused (rc 2), so NOT_RUN cannot hide a wrong binding. Linux keeps MISMATCH (rc 1).
 * Malformed arguments are a refusal (rc 2), not NOT_RUN.
 * Line: HOST_CELL<TAB>HOST<TAB>sha=<64hex><TAB>version=<...><TAB>status=<...> */
#pragma unisa use cxlib.productpkg
#pragma unisa use cxlib.releaseversion
#pragma unisa use mem.bytes
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.hostid
#pragma unisa use text.text
static char hc_root[4096];
static void hc_die(const char *s) { fprintf(stderr, "host-cell: REFUSE %s errno=%d\n", s, errno); exit(2); }
static int hc_hex64(const char *s) {
    int i;
    if (!s || strlen(s) != 64) return 0;
    for (i = 0; i < 64; i++) if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f'))) return 0;
    return s[64] == 0;
}
/* F-v2 release identity is metadata, not a retired PRODUCT_VERSION source row. */
static void hc_version(char *out, int cap) {
    char p[4400], version[24];
    if (snprintf(p, sizeof p, "%s/release/candidate.tsv", hc_root) >= (int)sizeof p) hc_die("path-bound");
    if (rv_load(p, version)) hc_die("release-version");
    size_t n = strlen(version);
    if (n >= (size_t)cap) hc_die("version-cap");
    if (mm_copy(out, cap, version, n + 1)) hc_die("version-copy");
}
int main(int argc, char **argv) {
    char expect[65], got[65];
    if (argc != 3) hc_die("explicit ROOT and CANDIDATE_SHA required");
    if (!hc_hex64(argv[2])) hc_die("sha must be 64 lowercase hex");
    if (!realpath(argv[1], hc_root)) hc_die("canonical root");
    memcpy(expect, argv[2], sizeof expect);
    if (pp_product_digest(hc_root, got)) hc_die("product-digest");
#if defined(__linux__) && defined(__x86_64__)
    {
        char ver[64];
        hc_version(ver, (int)sizeof ver);
        printf("HOST_CELL\tlnx/x86_64\tsha=%s\tversion=%s\texpected=%s\tstatus=%s\n", got, ver, expect,
               strcmp(got, expect) ? "MISMATCH" : "PASS");
        return strcmp(got, expect) ? 1 : 0;
    }
#else
    if (strcmp(got, expect)) hc_die("candidate-digest-mismatch");
    printf("HOST_CELL\t%s\tsha=%s\tversion=UNMEASURED\texpected=%s\tstatus=NOT_RUN\treason=no-native-build-for-this-host\n",
           tn_self() ? tn_self() : "UNKNOWN", got, expect);
    return 3;
#endif
}
