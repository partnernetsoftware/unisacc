/* Working-tree and index tool line ratchet; TOTAL is a report header after migration. */
#pragma unisa use cxlib.toolsloc
int main(int argc,char **argv){
    int index=0,mode=0;
    for(int i=1;i<argc;i++){
        if(!strcmp(argv[i],"--staged"))index=1;
        else if(!strcmp(argv[i],"--check"))mode=0;
        else if(!strcmp(argv[i],"--write"))mode=1;
        else if(!strcmp(argv[i],"--init"))mode=2;
        else if(!strcmp(argv[i],"--selftest")){
            const char *samples[]={"","x","x\n","x\ny","\n\n","x\r\ny"};long expected[]={0,1,1,2,2,2};
            for(int k=0;k<6;k++)if(tl_lines(samples[k],strlen(samples[k]))!=expected[k])return tl_bad("selftest line-count boundary");
            if(!tl_cli("int main (void){return 0;}",26)||tl_cli("/* int main() */",16))return tl_bad("selftest CLI boundary");
            {const char *yes[]={"/* #pragma unisa module fake */\nint main(void){return 0;}","const char *s=\"#pragma unisa module fake\";\nint main(void){return 0;}"};const char *no[]={"int Xmain(void){return 0;}","int v2main(void){return 0;}","#pragma unisa module real\nint main(void){return 0;}"};for(int k=0;k<2;k++)if(!tl_cli(yes[k],strlen(yes[k])))return tl_bad("selftest comment/string module text masks CLI");for(int k=0;k<3;k++)if(tl_cli(no[k],strlen(no[k])))return tl_bad("selftest identifier/module boundary");}
            printf("toolsloc: selftest ok: LF, final fragment and CLI boundaries\nTOOLSLOC\n");return 0;
        }
        else return tl_bad("usage: --check | --write | --init | --selftest [--staged]");
    }
    return tl_run(index,mode);
}
