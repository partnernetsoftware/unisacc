/* Historical entry point: line counts are a report, never a limit.
 * The retired baseline is intentionally never read or written. */
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use mem.heap
int main(int argc, char **argv) {
    char *out = 0; size_t n = 0; int rc;
    if (argc > 2 || (argc == 2 && !tx_eqz(argv[1], "--check"))) {
        fprintf(stderr, "toolsloc: retired; use tools/tool-inventory.cx -- --recent N (no baseline writes)\n");
        return 2;
    }
    rc = cx_run_timeout("sh ./unisacc.com tools/tool-inventory.cx -- --recent 0", 50, &out, &n);
    if (out) { fwrite(out, 1, n, stdout); mm_free(out); }
    if (rc == 0) printf("TOOLSLOC\n");
    return rc;
}
