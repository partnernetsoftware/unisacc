#include <cx.h>
#include <stdint.h>
/* Dynamic-C verdicts; native model runner and Python are observation tools.
   No product API/complete platform qualification is claimed. */
static uint64_t u64(const unsigned char*p){uint64_t n=0;for(int i=0;i<8;i++)n|=(uint64_t)p[i]<<(8*i);return n;}
static unsigned u32(const unsigned char*p){return(unsigned)p[0]|(unsigned)p[1]<<8|(unsigned)p[2]<<16|(unsigned)p[3]<<24;}
static int puthex(const char*p,const char*h){if(!strcmp(h,"-"))return cx_write(p,"",0);size_t n=strlen(h);if(n%2)return 1;unsigned char*b=malloc(n/2+1);if(!b)return 1;for(size_t i=0;i<n;i+=2){unsigned v;if(sscanf(h+i,"%2x",&v)!=1)return 1;b[i/2]=v;}int rc=cx_write(p,b,n/2);free(b);return rc;}
static int same(const char*a,const char*b){size_t n,m;char*x=cx_read(a,&n),*y=cx_read(b,&m);int ok=x&&y&&n==m&&!memcmp(x,y,n);free(x);free(y);return ok;}
static int frame(const unsigned char*p,size_t n,int*ids){
 if(n<20||memcmp(p,"UNILOW1\n",8))return 1;uint64_t z=u64(p+8);unsigned c=u32(p+16);
 if(z>n-20||c>(n-20-z)/20||n!=20+z+20*c)return 1;uint64_t end=0;
 for(unsigned i=0;i<c;i++){const unsigned char*r=p+20+z+20*i;uint64_t off=u64(r);unsigned id=u32(r+12);
  if(u32(r+8)!=1||off<end||off>=z||p[20+off]!='0'||id<256||id>=4352||u32(r+16))return 1;
  end=off+1;ids[id-256]++;}
 return 0;
}
static int pack(const unsigned char*p,size_t n,const unsigned char**data,size_t*dn){
 if(n<32||memcmp(p,"USLOWP2\n",8))return 1;uint64_t a=u64(p+8),b=u64(p+16),c=u64(p+24);
 if(a>n-32||b>n-32-a||c!=n-32-a-b)return 1;
 int full[4096],parts[4096];memset(full,0,sizeof full);memset(parts,0,sizeof parts);
 if(frame(p+32,(size_t)a,full)||frame(p+32+a,(size_t)b,parts)||frame(p+32+a+b,(size_t)c,parts))return 1;
 for(int i=0;i<4096;i++)if(full[i]!=parts[i])return 1;
 *data=p+32+a+b;*dn=(size_t)c;return 0;
}
int main(int argc,char**argv){
 if(argc!=2)return 2;size_t ln;char*l=cx_read("tests/librarydata-cases.tsv",&ln);if(!l)return 2;
 char p[10][4096],cmd[24000];const char*names[]={"input","contract","selection","expected","baseline","oracle","oracle.err","out","err","replay"};
 for(int i=0;i<10;i++)snprintf(p[i],4096,"%s/%s",argv[1],names[i]);int count=0;
 for(char*s=l;*s;){char*e=strchr(s,'\n');if(!e)return 2;*e=0;if(*s!='#'){
  char*f[10];f[0]=s;int k=1;for(char*q=s;*q;q++)if(*q=='\t'){*q=0;if(k==10)return 2;f[k++]=q+1;}if(k!=10)return 2;
  for(int i=0;i<3;i++)if(puthex(p[i],f[i+1]))return 2;if(puthex(p[3],f[6])||puthex(p[4],f[9]))return 2;
  snprintf(cmd,sizeof cmd,"python3 -c 'import sys;from unisa.librarydatalower import fragment;regs={\"r0\":\"x0\",\"r1\":\"x1\"} if int(sys.argv[4])==2 else {\"r0\":\"rax\",\"r1\":\"rdi\"};sys.stdout.buffer.write(fragment(open(sys.argv[1]).read(),open(sys.argv[2],\"rb\").read(),open(sys.argv[3],\"rb\").read(),regs,int(sys.argv[4])))' '%s' '%s' '%s' %s >'%s' 2>'%s'",p[0],p[1],p[2],f[7],p[5],p[6]);
  int ref=cx_run_timeout(cmd,3,0,0);size_t rn,ren;char*r=cx_read(p[5],&rn),*re=cx_read(p[6],&ren);if(!r||!re)return 2;
  if(ref!=atoi(f[4])||(ref&&(rn||!strstr(re,f[5])))||(!ref&&!same(p[5],p[3]))){printf("CONTRACT_RED %s live-reference\n",f[0]);return 1;}free(r);free(re);
  for(int fmt=0;fmt<2;fmt++){
   snprintf(cmd,sizeof cmd,"env UNISA_OBSERVATION_PROVIDER=A '%s/runner' '%s/model.%s.%s' '%s' '%s' '%s' >'%s' 2>'%s'",argv[1],argv[1],f[8],fmt?"net":"tbl",p[0],p[1],p[2],p[7],p[8]);
   int rc=cx_run_timeout(cmd,3,0,0);size_t n,en;unsigned char*b=(unsigned char*)cx_read(p[7],&n);char*err=cx_read(p[8],&en);if(!b||!err)return 2;
   if(rc!=ref||(rc&&(n||!strstr(err,f[5])))){printf("CONTRACT_RED %s %s rc=%d %s\n",f[0],fmt?"net":"tbl",rc,err);return 1;}
   if(rc&&(strstr(f[5],"readonly-write")||strstr(f[5],"not covered"))&&(!strstr(err,"256")||!strstr(err,"hostvalue"))){printf("CONTRACT_RED %s ID/name\n",f[0]);return 1;}
   if(!rc){const unsigned char*data;size_t dn;if(pack(b,n,&data,&dn))return 1;size_t exn;char*ex=cx_read(p[3],&exn);if(!ex||dn!=exn||memcmp(data,ex,dn)){printf("CONTRACT_RED %s data/span\n",f[0]);return 1;}free(ex);
    if(strcmp(f[9],"-")&&!same(p[7],p[4])){printf("CONTRACT_RED %s legal baseline bytes\n",f[0]);return 1;}
    snprintf(cmd,sizeof cmd,"cd /var/tmp && env TMPDIR=/var/tmp UNISA_OBSERVATION_PROVIDER=B '%s/runner' '%s/model.%s.%s' '%s' '%s' '%s' >'%s' 2>'%s'",argv[1],argv[1],f[8],fmt?"net":"tbl",p[0],p[1],p[2],p[9],p[8]);if(cx_run_timeout(cmd,3,0,0)||!same(p[7],p[9])){printf("CONTRACT_RED %s cwd/env\n",f[0]);return 1;}}
   free(b);free(err);
  }count++;
 }s=e+1;}free(l);printf("librarydata-model: %d live-reference fixtures; tbl/net; exact spans/coverage; legacy bytes; cwd/env\n",count);return count==39?0:1;
}
