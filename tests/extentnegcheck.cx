#!/usr/bin/env -S unisacc.com -run
/* extentnegcheck.cx PRODUCT: tape data-extent refusal domain, target lnx/x86_64
   (research/c43-lower-refusal-domain-proposal.md family 2; cases from
   exec/lower/sparsecheck.py, which pairs only the model executors).
   Control: a sparse 610000200-byte virtual region with one stored byte is
   accepted by product and Python reference, images byte-identical (4097 B ELF).
   Negatives (single .bss 2147483648; cumulative 2000000000+1000000000): the
   product refuses rc1, empty stdout, no output file, stderr names
   "not covered: tape data directive".  The Python reference ACCEPTS both today
   (rc0): that divergence is registered here on purpose, same discipline as the
   tapecheck underscore registrations -- if the reference starts refusing, this
   leaf goes red and the registration is revisited, never silently widened. */
#include <cx.h>
static char D[4096], P[4096];
static int checks;
static char *slurp(const char *name, size_t *n) {
    char path[8192];snprintf(path,sizeof path,"%s/%s",D,name);return cx_read(path,n);
}
static int put(const char *name, const char *body) {
    char path[8192];snprintf(path,sizeof path,"%s/%s",D,name);
    return cx_write(path,body,strlen(body));
}
/* expect_rc 0: accept, image written.  expect_rc 1: named refusal, no image. */
static int product(const char *name, const char *tape, int expect_rc) {
    char cmd[16384],*out=0,*err=0;size_t on=0,en=0;int rc,ok;
    snprintf(cmd,sizeof cmd,"%s'%s' '%s/%s' -b lnx/x86_64 -o '%s/%s.img' 2>'%s/%s.err'",
        strstr(P,".com") ? "sh " : "",P,D,tape,D,name,D,name);
    rc=cx_run_timeout(cmd,15,&out,&on);
    { char e[8192];snprintf(e,sizeof e,"%s.err",name);err=slurp(e,&en); }
    if (expect_rc==0) {
        char img[8192],*b;size_t bn=0;
        snprintf(img,sizeof img,"%s.img",name);b=slurp(img,&bn);
        ok=rc==0 && on==0 && b && bn>0;
        free(b);
    } else {
        char img[16384];struct stat st;
        snprintf(img,sizeof img,"%s/%s.img",D,name);
        ok=rc==1 && on==0 && stat(img,&st)!=0 &&
           err && strstr(err,"not covered: tape data directive");
    }
    printf("extent %-20s %s\n",name,ok ? "pass" : "FAIL");
    if(!ok)fprintf(stderr,"rc=%d stdout(%zu)=%s stderr=%s\n",rc,on,out?out:"",err?err:"<missing>");
    free(out);free(err);checks++;return !ok;
}
/* expect_rc is today's registered reference behaviour, not an endorsement. */
static int reference(const char *name, const char *tape, int expect_rc) {
    char cmd[16384],*out=0;size_t on=0;int rc,ok;
    snprintf(cmd,sizeof cmd,"python3 -m unisa compile '%s/%s' --from-tape -o '%s/%s.py.img' --target lnx/x86_64 --drive built >/dev/null 2>'%s/%s.py.err'",
        D,tape,D,name,D,name);
    rc=cx_run_timeout(cmd,25,&out,&on);
    ok=expect_rc==0 ? rc==0 : rc!=0;
    printf("extent %-20s %s\n",name,ok ? "pass" : "FAIL");
    if(!ok){char e[8192],*err;size_t en;snprintf(e,sizeof e,"%s.py.err",name);err=slurp(e,&en);
        fprintf(stderr,"rc=%d stderr=%s\n",rc,err?err:"<missing>");free(err);}
    free(out);checks++;return ok?0:1;
}
int main(int argc,char **argv) {
    char own[]="/tmp/extentXXXXXX",cwd[4096],ha[65],*a,*b;size_t an,bn;int bad=0;
    if(argc!=2)return 2;
    if(!getcwd(cwd,sizeof cwd) || !mkdtemp(own))return 2;
    snprintf(D,sizeof D,"%s",own);
    if(argv[1][0]=='/')snprintf(P,sizeof P,"%s",argv[1]);else snprintf(P,sizeof P,"%s/%s",cwd,argv[1]);
    if(strchr(P,39)||strchr(D,39))return 2;
    if(put("ctl.tape",".bss huge 610000000\n.str text \"x\\x00\"\n.bss tail 17\n.str final \"\"\n_start:\n  ret\n") ||
       put("one.tape",".bss a 2147483648\n_start:\n  ret\n") ||
       put("sum.tape",".bss a 2000000000\n.bss b 1000000000\n_start:\n  ret\n"))return 2;
    bad+=product("control",        "ctl.tape",0);
    bad+=product("neg-single",     "one.tape",1);
    bad+=product("neg-cumulative", "sum.tape",1);
    bad+=reference("control-ref",       "ctl.tape",0);
    bad+=reference("neg-single-ref",    "one.tape",0);   /* registered reference acceptance */
    bad+=reference("neg-cumulative-ref","sum.tape",0);   /* registered reference acceptance */
    /* The accepted control must mean the same thing in both implementations. */
    a=slurp("control.img",&an);b=slurp("control-ref.py.img",&bn);
    if(a&&b&&an==bn&&!memcmp(a,b,an)){
        cx_sha256_hex(a,an,ha);
        printf("extent %-20s pass (%zu B sha256 %.16s)\n","control-bytes",an,ha);checks++;
    } else { printf("extent %-20s FAIL (%zu vs %zu B)\n","control-bytes",a?an:0,b?bn:0);bad++; }
    free(a);free(b);
    printf("extent checks %d bad %d\n",checks,bad);
    return bad?1:0;
}
