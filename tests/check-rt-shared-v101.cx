/* check-rt-shared-v101.cx -- cross-unit shared runtime state checks for v0.0.101.
 * Note: after editing include/ or exec/facts/, run tools/derive.cx -- --write before rebuilding dev-product and running this check.
 * Usage: sh ./unisacc.com tests/check-rt-shared-v101.cx -- [PRODUCT_APE] */
#pragma unisa use sys.fs
#pragma unisa use text.text

static int rv_n;
static int rv_failed;

static void rv_ck(int ok, const char *what) {
    rv_n++;
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", what);
    if (!ok) rv_failed++;
}

static int rv_write_file(const char *p, const char *s) {
    FILE *f;
    size_t n;
    f = fopen(p, "wb");
    if (!f) return -1;
    n = strlen(s);
    if (n > 0 && fwrite(s, 1, n, f) != n) { fclose(f); return -1; }
    fclose(f);
    return 0;
}

static char *rv_read_all(const char *p, size_t *out_n) {
    FILE *f;
    long sz;
    char *b;
    size_t nr;
    *out_n = 0;
    f = fopen(p, "rb");
    if (!f) return 0;
    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return 0; }
    sz = ftell(f);
    if (sz < 0 || fseek(f, 0, SEEK_SET) != 0) { fclose(f); return 0; }
    b = (char *)malloc((size_t)sz + 1);
    if (!b) { fclose(f); return 0; }
    nr = sz > 0 ? fread(b, 1, (size_t)sz, f) : 0;
    fclose(f);
    b[nr] = 0;
    *out_n = nr;
    return b;
}

static int rv_contains(const char *path, const char *needle) {
    char *buf;
    size_t n;
    size_t nl;
    size_t i;
    int found;
    buf = rv_read_all(path, &n);
    if (!buf) return 0;
    nl = strlen(needle);
    found = 0;
    if (n >= nl) {
        i = 0;
        while (i <= n - nl) {
            if (memcmp(buf + i, needle, nl) == 0) { found = 1; break; }
            i++;
        }
    }
    free(buf);
    return found;
}

static int rv_compile_link_run(const char *ape, const char *dir, const char *tag, const char *u1_src, const char *u2_src) {
    char p1[4096];
    char p2[4096];
    char o1[4096];
    char o2[4096];
    char bin[4096];
    char out[4096];
    char cmd[8192];
    int rc;
    cx_fmt(p1, sizeof p1, "%s/%s_u1.c", dir, tag);
    cx_fmt(p2, sizeof p2, "%s/%s_u2.c", dir, tag);
    cx_fmt(o1, sizeof o1, "%s/%s_u1.o", dir, tag);
    cx_fmt(o2, sizeof o2, "%s/%s_u2.o", dir, tag);
    cx_fmt(bin, sizeof bin, "%s/%s.bin", dir, tag);
    cx_fmt(out, sizeof out, "%s/%s.out", dir, tag);
    if (rv_write_file(p1, u1_src) != 0 || rv_write_file(p2, u2_src) != 0) return -1;
    cx_fmt(cmd, sizeof cmd, "sh \"%s\" -I include -c -funit -b lnx/x86_64 -DRT_UNIT -o \"%s\" \"%s\" >/dev/null 2>&1", ape, o1, p1);
    if (system(cmd) != 0) return -1;
    cx_fmt(cmd, sizeof cmd, "sh \"%s\" -I include -c -funit -b lnx/x86_64 -DRT_EXTERN -o \"%s\" \"%s\" >/dev/null 2>&1", ape, o2, p2);
    if (system(cmd) != 0) return -1;
    cx_fmt(cmd, sizeof cmd, "sh \"%s\" -b lnx/x86_64 -o \"%s\" \"%s\" \"%s\" >/dev/null 2>&1", ape, bin, o1, o2);
    if (system(cmd) != 0) return -1;
    cx_fmt(cmd, sizeof cmd, "\"%s\" >\"%s\" 2>&1", bin, out);
    rc = system(cmd);
    return WIFEXITED(rc) ? WEXITSTATUS(rc) : -1;
}

int main(int argc, char **argv) {
    const char *ape;
    char dir[256];
    char outp[4096];
    char cmd[4096];
    int rc;

    ape = (argc > 1 && argv[1][0]) ? argv[1] : "./unisacc.com";
    cx_fmt(dir, sizeof dir, "/tmp/chk-rt101-%d", getpid());
    mkdir(dir, 0700);

    /* C1: errno + strtok (with static array initializer) + srand/rand */
    rc = rv_compile_link_run(ape, dir, "c1",
        "#include <stdio.h>\n#include <errno.h>\n#include <string.h>\n#include <stdlib.h>\n"
        "static char s_buf[32] = \"alpha,beta\";\n"
        "int set_s(void) { errno = 42; strtok(s_buf, \",\"); srand(12345); return rand(); }\n",
        "#include <stdio.h>\n#include <errno.h>\n#include <string.h>\n#include <stdlib.h>\n"
        "int set_s(void);\n"
        "int main(void) { int r1 = set_s(); char *t = strtok(0, \",\"); srand(12345); int r2 = rand(); "
        "printf(\"ERRNO=%d TOK=%s RAND_EQ=%d\\n\", errno, t ? t : \"NULL\", r1 == r2 ? 1 : 0); return 0; }\n");
    cx_fmt(outp, sizeof outp, "%s/c1.out", dir);
    rv_ck(rc == 0 && rv_contains(outp, "ERRNO=42 TOK=beta RAND_EQ=1"), "C1-errno-strtok-rand");

    /* C2: atexit LIFO via exit(0) */
    rc = rv_compile_link_run(ape, dir, "c2",
        "#include <stdio.h>\n#include <stdlib.h>\n"
        "static void cb1(void) { puts(\"CB1\"); }\n"
        "void reg1(void) { atexit(cb1); }\n",
        "#include <stdio.h>\n#include <stdlib.h>\n"
        "void reg1(void);\n"
        "static void cb2(void) { puts(\"CB2\"); }\n"
        "int main(void) { reg1(); atexit(cb2); exit(0); }\n");
    cx_fmt(outp, sizeof outp, "%s/c2.out", dir);
    rv_ck(rc == 0 && rv_contains(outp, "CB2\nCB1\n"), "C2-atexit-lifo-exit");

    /* C3: atexit LIFO via main return */
    rc = rv_compile_link_run(ape, dir, "c3",
        "#include <stdio.h>\n#include <stdlib.h>\n"
        "static void cb1(void) { puts(\"CB1\"); }\n"
        "void reg1(void) { atexit(cb1); }\n",
        "#include <stdio.h>\n#include <stdlib.h>\n"
        "void reg1(void);\n"
        "static void cb2(void) { puts(\"CB2\"); }\n"
        "int main(void) { reg1(); atexit(cb2); return 0; }\n");
    cx_fmt(outp, sizeof outp, "%s/c3.out", dir);
    rv_ck(rc == 0 && rv_contains(outp, "CB2\nCB1\n"), "C3-atexit-main-ret");

    /* C4: u1 malloc -> u2 free -> u2 malloc */
    rc = rv_compile_link_run(ape, dir, "c4",
        "#include <stdio.h>\n#include <stdlib.h>\n"
        "void *u1_alloc(void) { char *p = (char *)malloc(64); if (p) p[0] = 'K'; return p; }\n",
        "#include <stdio.h>\n#include <stdlib.h>\n"
        "void *u1_alloc(void);\n"
        "int main(void) { char *p = (char *)u1_alloc(); if (!p || p[0] != 'K') return 1; free(p); "
        "char *q = (char *)malloc(64); if (!q) return 2; q[0] = 'M'; printf(\"OK=%c\\n\", q[0]); free(q); return 0; }\n");
    cx_fmt(outp, sizeof outp, "%s/c4.out", dir);
    rv_ck(rc == 0 && rv_contains(outp, "OK=M"), "C4-malloc-free-cross");

    /* C5: header static function address inequality across units (pin current behavior) */
    rc = rv_compile_link_run(ape, dir, "c5",
        "#include <stdio.h>\n#include <string.h>\n"
        "void *u1_strcmp_ptr(void) { return (void *)strcmp; }\n",
        "#include <stdio.h>\n#include <string.h>\n"
        "void *u1_strcmp_ptr(void);\n"
        "int main(void) { void *p1 = u1_strcmp_ptr(); void *p2 = (void *)strcmp; "
        "printf(\"EQ=%d\\n\", p1 == p2 ? 1 : 0); return 0; }\n");
    cx_fmt(outp, sizeof outp, "%s/c5.out", dir);
    rv_ck(rc == 0 && rv_contains(outp, "EQ=0"), "C5-static-fn-addr-pin");

    /* C6: entry-build path (-ftrim-libc + -DRT_UNIT on u1 that does not call setenv/strtok/rand/gmtime) */
    {
        char p1[4096]; char p2[4096]; char o1[4096]; char o2[4096]; char bin[4096]; char out[4096]; char c6[8192];
        int rc6;
        cx_fmt(p1, sizeof p1, "%s/c6_u1.c", dir); cx_fmt(p2, sizeof p2, "%s/c6_u2.c", dir);
        cx_fmt(o1, sizeof o1, "%s/c6_u1.o", dir); cx_fmt(o2, sizeof o2, "%s/c6_u2.o", dir);
        cx_fmt(bin, sizeof bin, "%s/c6.bin", dir); cx_fmt(out, sizeof out, "%s/c6.out", dir);
        rv_write_file(p1, "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <time.h>\nint u2_run(void);\nint main(void) { return u2_run(); }\n");
        rv_write_file(p2, "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <time.h>\nint u2_run(void) { setenv(\"U_V101\", \"ok\", 1); srand(7); (void)rand(); time_t t = 0; (void)gmtime(&t); char b[16] = \"a,b\"; strtok(b, \",\"); printf(\"C6_OK=%s\\n\", getenv(\"U_V101\")); return 0; }\n");
        rc6 = 0;
        cx_fmt(c6, sizeof c6, "sh \"%s\" -I include -c -funit -ftrim-libc -b lnx/x86_64 -DRT_UNIT -o \"%s\" \"%s\" >/dev/null 2>&1", ape, o1, p1);
        if (system(c6) != 0) rc6 = -1;
        cx_fmt(c6, sizeof c6, "sh \"%s\" -I include -c -funit -b lnx/x86_64 -DRT_EXTERN -o \"%s\" \"%s\" >/dev/null 2>&1", ape, o2, p2);
        if (rc6 == 0 && system(c6) != 0) rc6 = -1;
        cx_fmt(c6, sizeof c6, "sh \"%s\" -b lnx/x86_64 -o \"%s\" \"%s\" \"%s\" >/dev/null 2>&1", ape, bin, o1, o2);
        if (rc6 == 0 && system(c6) != 0) rc6 = -1;
        if (rc6 == 0) {
            cx_fmt(c6, sizeof c6, "\"%s\" >\"%s\" 2>&1", bin, out);
            rc6 = system(c6);
            rc6 = WIFEXITED(rc6) ? WEXITSTATUS(rc6) : -1;
        }
        rv_ck(rc6 == 0 && rv_contains(out, "C6_OK=ok"), "C6-ftrim-rt-unit-all-shared");
    }

    cx_fmt(cmd, sizeof cmd, "rm -rf \"%s\"", dir);
    system(cmd);
    printf("RT_SHARED_V101_CHECK\tassertions=%d\tfailed=%d\n", rv_n, rv_failed);
    return rv_failed ? 1 : 0;
}
