/* Material-only separation of the original Mach-O check. Default-run.
 * Install byte-identically as tests/machophase.cx with cxlib/seedprep.cx.
 * --prepare emits PREPARED only. --check executes the complete original oracle.
 * Caller retains the original39 hard outer bound. No cached verdict.
 * Original external reference programs remain dependencies; the existing
 * seedprep interpreter resolver supplies the executable bound in the identity. */
#include <cx.h>
#include <fcntl.h>
#include <sys/file.h>
#include "cxlib/seedprep.cx"
static void mc_no(const char*s){fprintf(stderr,"MACHOPHASE NEED_PREPARE/REFUSED %s\n",s);exit(75);}
static void mc_ck(int b,const char*s){if(!b)mc_no(s);}
static char*mc_hash(const char*p){char h[65];mc_ck(!sp_sha_file(p,h),p);return sp_xstrdup(h);}
static char*mc_dirname(const char*p){char*b=sp_xstrdup(p),*q=strrchr(b,'/');if(q)*q=0;else strcpy(b,".");return b;}
static int mc_absent(const char*p){struct stat s;if(!lstat(p,&s))return 0;mc_ck(errno==ENOENT,"nonENOENT filesystem error");return 1;}
static void mc_regular(const char*p,int executable){struct stat s;mc_ck(!lstat(p,&s)&&S_ISREG(s.st_mode)&&s.st_uid==getuid()&&(!executable||(s.st_mode&0111)),"regular owner artifact/seal required");}
static void mc_directory(const char*p){struct stat s;mc_ck(!lstat(p,&s)&&S_ISDIR(s.st_mode)&&s.st_uid==getuid()&&!(s.st_mode&0077),"private owner nonsymlink directory required");}
static void mc_newfile(const char*p,const char*b){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW,0600);mc_ck(fd>=0,"new seal only");size_t n=strlen(b);mc_ck(write(fd,b,n)==(ssize_t)n&&!fsync(fd)&&!close(fd),"seal write/fsync");}
static void mc_exact(const char*p,const char*b){mc_regular(p,0);size_t n;char*t=sp_must_read(p,&n);mc_ck(n==strlen(b)&&!memcmp(t,b,n),"seal/basis mismatch");}
static void mc_sourcepins(void){mc_ck(!strcmp(mc_hash("exec/enc/machocheck.sh"),"b6248e9fffba7a1041860d41fc47da8d95741b240832a9c5bf98d56bab24c4c3"),"original shell SHA");mc_ck(!strcmp(mc_hash("exec/enc/machocheck.py"),"8f6749307e2ec0b069c1f8548baac4a99ce50781ee86e2c56f287650a975c8e2"),"original complete checker SHA");}
static const char*MC_ACTORS[]={"exec/enc/machocheck.sh","exec/enc/machocheck.py","exec/build/gen.py","exec/c/tbl.py","exec/c/run.c","tests/enc/tins.py","tests/bound","tests/bound.c","tests/cxbin","tests/safedel.cx",0};
static char*mc_basis(const char*arch){mc_sourcepins();sp_json*b=sp_jnew(SP_JOBJ),*actors,*edges,*rs,*env=sp_jnew(SP_JOBJ);sp_actor_closure(MC_ACTORS,&actors,&edges);sp_oset(b,"schema",sp_jstr("macho-original-material-v1"));sp_oset(b,"arch",sp_jstr(arch));sp_oset(b,"sources",sp_jstr(sp_source_digest()));sp_oset(b,"actors",actors);sp_oset(b,"edges",edges);char*cc=sp_which("cc"),*flags[]={"-O2",0};mc_ck(cc!=0,"cc missing");mc_ck(!sp_cc_read_set(cc,"exec/c/run.c",flags,&rs),"CC/header readset");sp_oset(b,"cc_readset",rs);sp_oset(b,"interpreter_path",sp_jstr(sp_python()));sp_oset(b,"interpreter_sha256",sp_jstr(mc_hash(sp_python())));sp_oset(b,"driver_sha",sp_jstr(mc_hash(__FILE__)));char*module=sp_pjoin(mc_dirname(__FILE__),"cxlib/seedprep.cx");mc_ck(!strcmp(mc_hash(module),"8e438bc78e31851d0b8f6fb88da3ea6b27b033a21bafd890572ed6e3d5cf0363"),"reviewed seedprep module SHA");sp_oset(b,"module_sha",sp_jstr(mc_hash(module)));sp_oset(b,"recipe",sp_jstr("original pinned shell cc/gen/table recipe and complete original checker; unchanged arguments"));extern char**environ;for(int i=0;environ[i];i++){char*q=strchr(environ[i],'=');if(q&&strncmp(environ[i],"UNISACC_BOUND_DEADLINE_MONO=",strlen("UNISACC_BOUND_DEADLINE_MONO=")))sp_osetn(env,environ[i],q-environ[i],sp_jstr(q+1));}sp_oset(b,"environment_except_outer_deadline",env);sp_buf out={0,0,0};sp_jdump(&out,b,0,1);char h[65];cx_sha256_hex(out.s,out.n,h);return sp_xstrdup(h);}
static char*mc_sealtext(const char*dir,const char*name,const char*basis){char*p=sp_pjoin(dir,name);mc_regular(p,!strcmp(name,"run"));struct stat s;mc_ck(!lstat(p,&s),"artifact stat");char*b=sp_xmalloc(256);snprintf(b,256,"%s %s %lld\n",basis,mc_hash(p),(long long)s.st_size);return b;}
static void mc_valid(const char*dir,const char*basis){mc_exact(sp_pjoin(dir,"basis"),basis);const char*n[]={"run","d.json","d.tbl"};for(int i=0;i<3;i++)mc_exact(sp_cat(sp_pjoin(dir,n[i]),".seal"),mc_sealtext(dir,n[i],basis));mc_exact(sp_pjoin(dir,"prepared"),"PREPARED material only; no verdict\n");}
static int mc_child(char**argv){pid_t p=fork();mc_ck(p>=0,"fork");if(!p){unsetenv("UNISA_CONTAINER");execvp(argv[0],argv);_exit(127);}int st;pid_t w;do{w=waitpid(p,&st,0);}while(w<0&&errno==EINTR);mc_ck(w==p,"wait");return WIFEXITED(st)?WEXITSTATUS(st):128+WTERMSIG(st);}
int main(int ac,char**av){if(ac!=2|| (strcmp(av[1],"--prepare")&&strcmp(av[1],"--check"))){fputs("usage: machophase.cx --prepare|--check (ARCH defaults arm64; x86_64 also accepted; caller bound39)\n",stderr);return ac==2&&!strcmp(av[1],"--help")?0:2;}const char*arch=getenv("ARCH");if(!arch||!*arch)arch="arm64";mc_ck(!strcmp(arch,"arm64")||!strcmp(arch,"x86_64"),"original ARCH must be arm64/x86_64");const char*deadline=getenv("UNISACC_BOUND_DEADLINE_MONO");mc_ck(deadline&&*deadline,"real outer native watchdog required");unsetenv("UNISA_CONTAINER");sp_init("tests/machophase.cx");int prepare=!strcmp(av[1],"--prepare");char*basis=mc_basis(arch);const char*base="out/machophase-materials";if(mc_absent(base)){mc_ck(prepare,"material root missing");mc_ck(!mkdir(base,0700),"new material root");}mc_directory(base);char*dir=sp_pjoin(base,basis);int fresh=mc_absent(dir);if(fresh){mc_ck(prepare,"material key missing");mc_ck(!mkdir(dir,0700),"new material key");}mc_directory(dir);int fd=open(sp_pjoin(dir,"lock"),O_RDWR|O_NONBLOCK|O_NOFOLLOW|(fresh?O_CREAT:0),0600);struct stat ls;mc_ck(fd>=0&&!fstat(fd,&ls)&&S_ISREG(ls.st_mode)&&ls.st_uid==getuid()&&!flock(fd,(prepare?LOCK_EX:LOCK_SH)|LOCK_NB),"material flock busy or invalid");
if(prepare&&fresh){mc_newfile(sp_pjoin(dir,"basis"),basis);char*run[]={"tests/bound","39",sp_which("cc"),"-O2","-o",sp_pjoin(dir,"run"),"exec/c/run.c",0};char*gen[]={"tests/bound","39",(char*)sp_python(),"exec/build/gen.py",!strcmp(arch,"arm64")?"enc/arm":"enc",sp_pjoin(dir,"d.json"),"--macho",0};char*tbl[]={"tests/bound","39",(char*)sp_python(),"exec/c/tbl.py",sp_pjoin(dir,"d.json"),sp_pjoin(dir,"d.tbl"),0};char**cmds[]={run,gen,tbl};const char*names[]={"run","d.json","d.tbl"};for(int i=0;i<3;i++){mc_ck(mc_absent(sp_pjoin(dir,names[i])),"output already exists; no repair");int rc=mc_child(cmds[i]);if(rc)return rc;mc_ck(!strcmp(basis,mc_basis(arch)),"construction input drift");mc_newfile(sp_cat(sp_pjoin(dir,names[i]),".seal"),mc_sealtext(dir,names[i],basis));}mc_newfile(sp_pjoin(dir,"prepared"),"PREPARED material only; no verdict\n");}
mc_valid(dir,basis);if(prepare){printf("PREPARED key=%s (material only; no verdict)\n",basis);return 0;}char*cmd[]={"tests/bound","39",(char*)sp_python(),"exec/enc/machocheck.py",sp_pjoin(dir,"run"),sp_pjoin(dir,"d.tbl"),sp_pjoin(dir,"d.json"),(char*)arch,0};int rc=mc_child(cmd);mc_ck(!strcmp(basis,mc_basis(arch)),"consumer input drift");mc_valid(dir,basis);printf("MACHOPHASE complete original checker arch=%s rc=%d key=%s; no cached verdict\n",arch,rc,basis);return rc;}
