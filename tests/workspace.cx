/* Graph and optional prepared-artifact resume contracts. Root cwd;
 * NEW_OUT [PREPARED_DIR]. NEW_OUT must not exist. */
#pragma unisa use workspace.driver
#pragma unisa use text.text
static int checks,failed;static char work[4096];
static void die(const char *s){fprintf(stderr,"workspace-test: %s errno=%d\n",s,errno);exit(2);}
static void ck(int yes,const char *name){checks++;if(!yes)failed++;printf("%s\tworkspace.%s\n",yes?"PASS":"FAIL",name);fflush(stdout);}
static int run(const char *manifest,const char *label,char **output){char p[4400],log[4400];{if(cx_fmt(p,sizeof p,"%s/%s.tsv",work,label))die("format-bound");}{if(cx_fmt(log,sizeof log,"%s/%s.log",work,label))die("format-bound");}if(cx_write(p,manifest,strlen(manifest)))die("manifest-write");pid_t pid=fork();if(pid<0)die("fork");if(!pid){int fd=open(log,O_CREAT|O_EXCL|O_WRONLY,0600);if(fd<0)_exit(99);dup2(fd,1);dup2(fd,2);close(fd);char resume_out[4400];{if(cx_fmt(resume_out,sizeof resume_out,"%s/%s-cache",work,label))die("format-bound");}char *v[]={"cx-workspace",!strncmp(label,"resume-",7)?"resume":"plan",p,!strncmp(label,"resume-",7)?resume_out:"out/unused","lnx/x86_64",0};int rc=cxw_main(5,v);fflush(stdout);_exit(rc);}int status;if(waitpid(pid,&status,0)!=pid)die("wait");size_t n;*output=cx_read(log,&n);if(!*output)die("read-log");return WIFEXITED(status)?WEXITSTATUS(status):99;}
int main(int argc,char **argv){if((argc!=2&&argc!=3)||strlen(argv[1])>=sizeof work)die("usage NEW_OUT");{if(cx_fmt(work,sizeof work,"%s",argv[1]))die("output-path-bound");}if(mkdir(work,0700))die("exclusive-output");char *out=0;int rc;
const char *valid="CXWORK1\nP\ta\ttools/cx0.cx\ta\tunisacc\t1\nP\tb\ttools/cx0-bundle.cx\tb\tunisacc\t1\nI\ta\timplementation\tentry\ttools/cx0.cx\nI\tb\timplementation\tentry\ttools/cx0-bundle.cx\nD\tb\tnormal\ta\n";
rc=run(valid,"valid",&out);ck(!rc&&strstr(out,"PLAN\ta\t")&&strstr(out,"PLAN\tb\t")&&strstr(out,"PLAN\ta\t")<strstr(out,"PLAN\tb\t"),"dependency-before-consumer");char *first=out;
char text[4000];{if(cx_fmt(text,sizeof text,"%sD\ta\tbuild\tb\n",valid))die("format-bound");}rc=run(text,"cycle",&out);ck(rc==2&&strstr(out,"dependency-cycle"),"normal-build-cycle-refused");free(out);
{if(cx_fmt(text,sizeof text,"%sD\ta\tnormal\tabsent\n",valid))die("format-bound");}rc=run(text,"missing",&out);ck(rc==2&&strstr(out,"missing-package"),"missing-package-refused");free(out);
{if(cx_fmt(text,sizeof text,"%sD\tb\tbuild\ta\n",valid))die("format-bound");}rc=run(text,"duplicate-edge",&out);ck(rc==2&&strstr(out,"duplicate-edge"),"duplicate-edge-refused");free(out);
rc=run("CXWORK1\nP\ta\ttools/cx0.cx\ta\tunisacc\t1\nP\tb\ttools/cx0.cx\tb\tunisacc\t1\n","ownership",&out);ck(rc==2&&strstr(out,"duplicate-package-source"),"duplicate-source-ownership-refused");free(out);
rc=run("CXWORK1\nP\ta\ttools/cx0.cx\ta\tunisacc\t1\n","undeclared",&out);ck(rc==2&&strstr(out,"undeclared-package-source"),"undeclared-source-refused");free(out);
rc=run("CXWORK1\nP\ta\ttools/cx0.cx\ta\tunisacc\t56\n","timeout",&out);ck(rc==2&&strstr(out,"seconds-1-to-55"),"unbounded-child-refused");free(out);
{if(cx_fmt(text,sizeof text,"%sI\ta\ttest\ttest-source\ttests/workspace.cx\n",valid))die("format-bound");}rc=run(text,"test-only",&out);ck(!rc&&tx_eq(first, out, 1L << 20),"test-only-input-does-not-change-build-plan");free(first);free(out);
{if(cx_fmt(text,sizeof text,"%sI\ta\timplementation\tmissing\tout/cx-workspace-no-such-file\n",valid))die("format-bound");}rc=run(text,"missing-file",&out);ck(rc==2&&strstr(out,"missing-input"),"missing-input-refused");free(out);
{if(cx_fmt(text,sizeof text,"%sI\ta\timplementation\tbad-parent\ttools/cx0.cx/child\n",valid))die("format-bound");}rc=run(text,"not-directory",&out);ck(rc==2&&strstr(out,"input-stat")&&!strstr(out,"missing-input"),"enotdir-is-io-failure");free(out);
if(argc==3){size_t an,rn,mn;char file[4400];{if(cx_fmt(file,sizeof file,"%s/cx0-plan",argv[2]))die("format-bound");}char *artifact=cx_read(file,&an);{if(cx_fmt(file,sizeof file,"%s/cx0-plan.receipt",argv[2]))die("format-bound");}char *receipt=cx_read(file,&rn),*manifest=cx_read("cx/workspace/packages.tsv",&mn);if(!artifact||!an||!receipt||!manifest)die("prepared-fixture-read");const char *labels[]={"resume-corrupt","resume-stale","resume-half"};for(int i=0;i<3;i++){char dir[4400];{if(cx_fmt(dir,sizeof dir,"%s/%s-cache",work,labels[i]))die("format-bound");}if(mkdir(dir,0700))die("resume-fixture-directory");if(i!=2){{if(cx_fmt(file,sizeof file,"%s/cx0-plan",dir))die("format-bound");}if(i==0)artifact[an-1]^=1;if(cx_write(file,artifact,an))die("resume-fixture-artifact");if(i==0)artifact[an-1]^=1;}char *key=strstr(receipt,"build\t");char saved=0;if(i==1){if(!key)die("receipt-key");key+=6;saved=*key;*key=*key=='0'?'1':'0';}{if(cx_fmt(file,sizeof file,"%s/cx0-plan.receipt",dir))die("format-bound");}if(cx_write(file,receipt,rn))die("resume-fixture-receipt");if(i==1)*key=saved;rc=run(manifest,labels[i],&out);ck(rc==2&&strstr(out,i==0?"artifact-digest-mismatch":i==1?"stale-build-receipt":"partial-package-without-committed-pair"),i==0?"resume-rejects-corrupt-artifact":i==1?"resume-rejects-stale-build":"resume-rejects-half-commit");free(out);}free(artifact);free(receipt);free(manifest);}
 printf("WORKSPACE\tassertions=%d\tfailed=%d\n",checks,failed);return failed?1:0;}
