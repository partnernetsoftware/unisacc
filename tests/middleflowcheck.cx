#!/usr/bin/env -S unisacc.com -run
/* Measured leaf witness only: explicit complete frames/resources and a shared runner.
   No whole-candidate verdict or reuse permission. */
#include <cx.h>
static int fail(const char*s){fprintf(stderr,"middleflowcheck FAIL: %s\n",s);return 1;}
static int copyfile(const char*a,const char*b){size_t n;char*x=cx_read(a,&n);if(!x)return 1;int rc=cx_write(b,x,n);free(x);return rc!=0;}
static int same(const char*a,const char*b){size_t na,nb;char*x=cx_read(a,&na),*y=cx_read(b,&nb);int eq=x&&y&&na==nb&&!memcmp(x,y,na);free(x);free(y);return eq;}
static int clone(const char*from,const char*to){DIR*d=opendir(from);struct dirent*e;char a[4096],b[4096];if(!d||mkdir(to,0700))return 1;while((e=readdir(d))){if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;snprintf(a,sizeof a,"%s/%s",from,e->d_name);snprintf(b,sizeof b,"%s/%s",to,e->d_name);if(copyfile(a,b))return 1;}closedir(d);return 0;}
static int packet(const char*root){char path[4096],name[1024],want[65],got[65],*b,*p,*e,*v;size_t n,k;unsigned long bytes;int count=0;snprintf(path,sizeof path,"%s/manifest.tsv",root);b=cx_read(path,&n);if(!b)return fail("packet index absent");p=b;while(*p){e=strchr(p,'\n');if(!e)return fail("packet index truncated");*e=0;if(sscanf(p,"%1023s %lu %64s",name,&bytes,want)!=3||name[0]=='/'||strstr(name,".."))return fail("packet record");snprintf(path,sizeof path,"%s/%s",root,name);v=cx_read(path,&k);if(!v)return fail("packet bytes absent");cx_sha256_hex(v,k,got);free(v);if(k!=bytes||strcmp(got,want))return fail("frozen packet changed");count++;p=e+1;}free(b);if(count<20)return fail("packet incomplete");return 0;}
static int ledger(const char*pkg,const char*root){char temp[]="/tmp/middle-ledger-XXXXXX",runner[4096],src[4096],cap[4096],live[4096],frozen[4096],*out;size_t n;int k,rc;
 const char*routes[2][2]={{"capture","e3"},{"capture-lower","lower"}};
 if(!mkdtemp(temp))return fail("ledger temp");snprintf(runner,sizeof runner,"%s/runner",temp);
 char*build[]={"cc","-O2","tests/middleflowrunner.c","exec/c/core.c","-o",runner,0};if(cx_runv_timeout(build,20,0,0))return fail("ledger runner build");
 snprintf(src,sizeof src,"%s/tests/seals/middleflow-step0/accept-source.bytes",root);
 for(k=0;k<2;k++){snprintf(cap,sizeof cap,"%s/%s",temp,routes[k][1]);if(mkdir(cap,0700))return fail("ledger output");
  char*cmd[]={runner,(char*)routes[k][0],(char*)pkg,src,cap,"0",0};rc=cx_runv_timeout(cmd,30,&out,&n);free(out);if(rc)return fail("ledger capture rc");
  snprintf(live,sizeof live,"%s/resources.tsv",cap);snprintf(frozen,sizeof frozen,"%s/tests/seals/middleflow-step0/%s/accept/resources.tsv",root,routes[k][1]);
  if(!same(live,frozen)){printf("middleflowcheck ledger %s: live resources.tsv differs from the sealed ledger (%s)\n",routes[k][1],frozen);return fail("sealed ledger is stale against the live product");}
  printf("middleflowcheck ledger %s: live resources.tsv equals the sealed ledger\n",routes[k][1]);}
 printf("middleflowcheck ledger PASS\n");return 0;}
int main(int argc,char**argv){char cwd[2048],src[4096],base[4096],dir[4096],model[4096],runner[4096],prefix[4096],path[4096],gold[4096],h[65];const char*cases[]={"accept","refuse"};int i,j,rc,want;size_t n;char*b,*out;unsigned char*ma,*mb;size_t na,nb;
 int count=2;char sealed_runner[4096],sealed_data[4096],sealed_model[4096],sealed_out[4096];char temp[]="/tmp/middle-sealed-XXXXXX";char*converted[8];
 if(argc==4&&!strcmp(argv[1],"--ledger"))return ledger(argv[2],argv[3]);
 if(argc==3&&(!strcmp(argv[1],"--sealed-e3")||!strcmp(argv[1],"--sealed-lower"))){int lower=!strcmp(argv[1],"--sealed-lower");if(!realpath(argv[2],sealed_data)||packet(sealed_data)||!mkdtemp(temp))return fail("sealed setup");snprintf(sealed_runner,sizeof sealed_runner,"%s/runner",temp);char*build[]={"cc","-O2","tests/middleflowrunner.c","exec/c/core.c","-o",sealed_runner,0};if(cx_runv_timeout(build,20,0,0))return fail("native witness build");snprintf(sealed_model,sizeof sealed_model,"%s/%s/model.net",sealed_data,lower?"lower":"e3");size_t z=strlen(sealed_data);snprintf(sealed_data+z,sizeof sealed_data-z,"/%s",lower?"lower":"e3");snprintf(sealed_out,sizeof sealed_out,"%s/replay",temp);converted[0]=argv[0];converted[1]=sealed_runner;converted[2]=sealed_data;converted[3]=sealed_model;converted[4]=sealed_model;converted[5]=sealed_out;converted[6]="--accept-only";converted[7]=0;argv=converted;argc=lower?7:6;}
 if(argc==7&&!strcmp(argv[6],"--accept-only"))count=1;else if(argc!=6)return fail("usage RUNNER DATA MODEL_A MODEL_B OUT [--accept-only]");if(!getcwd(cwd,sizeof cwd))return fail("cwd");if(argv[1][0]!='/')return fail("runner must be absolute");snprintf(runner,sizeof runner,"%s",argv[1]);ma=(unsigned char*)cx_read(argv[3],&na);mb=(unsigned char*)cx_read(argv[4],&nb);if(!ma||!mb||na!=nb||memcmp(ma,mb,na))return fail("this experiment requires identical extracted models");cx_sha256_hex(ma,na,h);free(ma);free(mb);printf("middleflowcheck model %s\n",h);
 if(mkdir(argv[5],0700))return fail("OUT must be a new directory");
 for(i=0;i<count;i++){snprintf(src,sizeof src,"%s/%s",argv[2],cases[i]);snprintf(path,sizeof path,"%s/status.txt",src);b=cx_read(path,&n);if(!b)return fail("capture verdict absent");want=atoi(b);free(b);if(want!=i)return fail("capture accept/refuse status mismatch");
 for(j=0;j<4;j++){snprintf(base,sizeof base,"%s/%s-%d",argv[5],cases[i],j);if(clone(src,base))return fail("physical input clone");snprintf(model,sizeof model,"%s/model.net",base);if(copyfile(j%2?argv[4]:argv[3],model))return fail("model clone");snprintf(prefix,sizeof prefix,"%s/result",base);
 if(j<2){setenv("LANG","C",1);setenv("TMPDIR","/tmp/middle-observer-alpha",1);setenv("UNISA_ATTRIBUTES","/nonexistent-alpha",1);}else{setenv("LANG","C.UTF-8",1);setenv("TMPDIR","/tmp/middle-observer-beta",1);setenv("UNISA_ATTRIBUTES","/nonexistent-beta",1);}setenv("UNISA_CONTAINER",j<2?"/absent-A":"/absent-B",1);setenv("UNISA_MAXSTEPS",j<2?"1":"2",1);
 if(chdir(base))return fail("physical cwd");char*cmd[]={runner,"replay",model,base,prefix,0};rc=cx_runv_timeout(cmd,15,&out,&n);if(chdir(cwd))return fail("restore cwd");snprintf(path,sizeof path,"%s.stdout",prefix);if(!out||cx_write(path,out,n))return fail("stdout witness");free(out);if(rc!=want)return fail("stage verdict changed or runner failed; STOP");snprintf(gold,sizeof gold,"%s/output.bytes",src);if(!same(path,gold))return fail("output differs from measured product-stage witness; STOP");snprintf(path,sizeof path,"%s.stderr",prefix);snprintf(gold,sizeof gold,"%s/capture.stderr",src);if(!same(path,gold))return fail("refusal/diagnostic bytes differ; STOP");}
 }
 printf("middleflowcheck PASS: %d cases x 4 variants, expected verdict and stdout/stderr byte-identical across two extracted model sources, physical dirs and environments; measured scope only\n",count);return 0;
}
