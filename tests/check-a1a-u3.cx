/* tests/check-a1a-u3.cx -- A1a U3 pre-red contract check: __builtin_unreachable and __builtin_trap (4 cases).
 *
 *   sh ./unisacc.com tests/check-a1a-u3.cx
 *
 * Positive cases (2):
 *   - u01_unreachable_pos.c: compiled and run, stdout sha256 and exit code match frozen tests/a1a/expect.tsv;
 *   - u02_trap_pos.c: compiled and run, terminated by signal (rc >= 128 per tests/a1a/README.md).
 * Negative cases (2): u03_unreachable_arg_rej.c, u04_trap_value_rej.c -- refused at -c by name (not generic undeclared).
 * Zero gcc calls at runtime. Ends with A1A_U3<TAB>pass=P<TAB>fail=F; exits 0 iff fail == 0. */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.sha
#pragma unisa use sysx.process
#pragma unisa use text.text

static int passed, failed;

static void ck(int ok, const char *name, const char *why) {
    if (ok) passed++; else failed++;
    sy_printf("%s\ta1a.u3.%s\t%s\n", ok ? "PASS" : "FAIL", name, why);
}

static int find_expect(const char *eb, long en, const char *sample, char *sha_out, size_t scap, int *rc_out) {
    long i = 0, sl = (long)tx_len(sample, 128);
    while (i < en) {
        long a = i, b;
        while (i < en && eb[i] != '\n') i++;
        b = i; if (i < en) i++;
        long t1 = a; while (t1 < b && eb[t1] != '\t') t1++;
        if (t1 - a != sl || !tx_prefix(eb + a, sl, sample, sl)) continue;
        long t2 = t1 + 1; while (t2 < b && eb[t2] != '\t') t2++;
        long t3 = t2 + 1; while (t3 < b && eb[t3] != '\t') t3++;
        long t4 = t3 + 1; while (t4 < b && eb[t4] != '\t') t4++;
        long t5 = t4 + 1; while (t5 < b && eb[t5] != '\t') t5++;
        if (t3 <= t2 + 1 || t5 >= b) return 0;
        cx_fmt(sha_out, scap, "%.*s", (int)(t3 - (t2 + 1)), eb + t2 + 1);
        long p = tx_find(eb + t5 + 1, b - (t5 + 1), "gcc_run_rc=", 11);
        if (p < 0) return 0;
        long q = t5 + 1 + p + 11;
        int neg = 0, val = 0;
        if (q < b && eb[q] == '-') { neg = 1; q++; }
        while (q < b && eb[q] >= '0' && eb[q] <= '9') { val = val * 10 + (eb[q] - '0'); q++; }
        *rc_out = neg ? -val : val;
        return 1;
    }
    return 0;
}

static void check_rej(const char *dir, const char *sample) {
    char src[256], obj[4200], why[256];
    cx_fmt(src, sizeof src, "tests/a1a/cases/%s", sample);
    cx_fmt(obj, sizeof obj, "%s/%s.o", dir, sample);
    char *cav[] = {"sh", "./unisacc.com", "-c", src, "-o", obj, 0}; /* lint:allow R1 compiles case with product */
    np_result cr;
    int ok = 0;
    const char *reason = "unimplemented-builtin-arg-check";
    if (np_run(cav, ".", 0, 15, &cr, why, sizeof why) == 0 && cr.rc != 0) {
        const char *msg = (cr.err && cr.errn > 0) ? cr.err : (cr.out ? cr.out : "");
        long ml = (long)(cr.err && cr.errn > 0 ? cr.errn : (cr.out ? cr.outn : 0));
        if (tx_find(msg, ml, "call to undeclared function", 27) < 0) {
            ok = 1;
            reason = "named-reject";
        }
    }
    np_free(&cr);
    ck(ok, sample, reason);
}

int main(void) {
    size_t en = 0;
    char *eb = cx_read("tests/a1a/expect.tsv", &en);
    if (!eb) return 2;
    char dir[4096], bin[4200], want_sha[80], got_sha[80], why[256];
    int want_rc = -1;
    if (cx_fmt(dir, sizeof dir, "%s/a1a-u3-XXXXXX", sy_env_or("TMPDIR", "/tmp")) || !mkdtemp(dir)) { free(eb); return 2; }

    /* u01_unreachable_pos.c */
    if (!find_expect(eb, (long)en, "u01_unreachable_pos.c", want_sha, sizeof want_sha, &want_rc)) {
        ck(0, "u01_unreachable_pos.c", "expect-missing");
    } else {
        cx_fmt(bin, sizeof bin, "%s/u01.bin", dir);
        char *cav[] = {"sh", "./unisacc.com", "tests/a1a/cases/u01_unreachable_pos.c", "-o", bin, 0}; /* lint:allow R1 compiles case */
        np_result cr;
        if (np_run(cav, ".", 0, 15, &cr, why, sizeof why) != 0 || cr.rc != 0) {
            np_free(&cr); ck(0, "u01_unreachable_pos.c", "unimplemented-compile-fail");
        } else {
            np_free(&cr);
            char *rav[] = {bin, 0};
            np_result rr;
            if (np_run(rav, ".", 0, 10, &rr, why, sizeof why) != 0) {
                np_free(&rr); ck(0, "u01_unreachable_pos.c", "run-error");
            } else {
                cx_sha256_hex(rr.out ? rr.out : "", rr.outn, got_sha);
                int ok = (rr.rc == want_rc && tx_eqz(got_sha, want_sha));
                np_free(&rr);
                ck(ok, "u01_unreachable_pos.c", ok ? "match-expect" : "output-or-rc-mismatch");
            }
        }
    }

    /* u02_trap_pos.c: terminated by signal (rc >= 128) */
    {
        cx_fmt(bin, sizeof bin, "%s/u02.bin", dir);
        char *cav[] = {"sh", "./unisacc.com", "tests/a1a/cases/u02_trap_pos.c", "-o", bin, 0}; /* lint:allow R1 compiles case */
        np_result cr;
        if (np_run(cav, ".", 0, 15, &cr, why, sizeof why) != 0 || cr.rc != 0) {
            np_free(&cr); ck(0, "u02_trap_pos.c", "unimplemented-compile-fail");
        } else {
            np_free(&cr);
            char *rav[] = {bin, 0};
            np_result rr;
            if (np_run(rav, ".", 0, 10, &rr, why, sizeof why) != 0) {
                np_free(&rr); ck(0, "u02_trap_pos.c", "run-error");
            } else {
                int ok = (rr.rc >= 128);
                np_free(&rr);
                ck(ok, "u02_trap_pos.c", ok ? "signal-terminated" : "did-not-trap");
            }
        }
    }

    check_rej(dir, "u03_unreachable_arg_rej.c");
    check_rej(dir, "u04_trap_value_rej.c");

    cx_rmtree(dir);
    free(eb);
    sy_printf("A1A_U3\tpass=%d\tfail=%d\n", passed, failed);
    return failed ? 1 : 0;
}
