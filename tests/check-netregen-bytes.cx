/* Preparation is not PASS. Run every case/target shard under tools/bound 55.
 * prepare|case|summary ROOT OLD_PRODUCT NEW_PRODUCT ABS_OUT [CASE TARGET]
 * Explicit products only; identical absolute source paths and flags on both lanes.
 * Comparison of cross-produced images only, never native execution qualification. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
#pragma unisa use compiler.fwdsig
static char root[4096],old[4096],fresh[4096],out[4096];
static char new_models[4096];
static char reference_product[4096];
static const char *names[]={"small","nested","multi","module","boundary"};
static const char *targets[]={"lnx/x86_64","lnx/arm64","osx/x86_64","osx/arm64","win/x86_64","win/arm64"};
/* Fixed, legitimate positive programs, without environment-dependent headers. */
static const char *files[]={"small.c","nested.c","multi.c","other.c","module.cx","leaf.cx","boundary.c"};
static const char *texts[]={
 "const char byte_message[]=\"ABCDEFG\";const char *byte_pointer=byte_message;const char *byte_literal=\"G\";int main(void){return byte_pointer[6]+byte_literal[0]-135;}\n",
 "int main(void){int x=3;{int x=4;{int y=x+2;if(y!=6)return 1;}}return x-3;}\n",
 "extern int lifecycle_state;int helper(int);__attribute__((constructor)) static void begin(void){lifecycle_state=7;}__attribute__((destructor)) static void finish(void){lifecycle_state=0;}int main(void){return helper(9)-17;}\n",
 "int lifecycle_state;int helper(int x){return x+1+lifecycle_state;}\n",
 "#pragma unisa use leaf\nint main(void){return byte_leaf()-7;}\n",
 "#pragma unisa module leaf\nint byte_leaf(void){return 7;}\n",
 "struct Pair{int a;int b;};int main(void){unsigned int x=0xffffffffu;int a[3]={1,2,3};struct Pair p={4,5};return (x>>31)+a[2]+p.b-9;}\n"};
static void die(const char *s){fprintf(stderr,"NETREGEN_BYTES\tREFUSE\t%s\n",s);exit(2);}
static void path(char p[4400],const char *a,const char *b){if(cx_path_join(p,4400,a,b))die("path bound");}
static char *load(const char *p,size_t *n){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>134217728)die("bounded regular input required");char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("input read");return s;}
static void hash(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void save(const char *p,const char *s,size_t n){FILE *f=fopen(p,"wx");if(!f)die("exclusive output required");int bad=fwrite(s,1,n,f)!=n;if(fclose(f)||bad)die("output write");}
static void equal(const char *p,const char *s,size_t n){size_t z;char *b=load(p,&z);int ok=z==n&&!memcmp(b,s,n);free(b);if(!ok)die("material or identity changed");}
static void row(np_buf *b,const char *key,const char *value){np_puts(b,key);np_puts(b,"\t");np_puts(b,value);np_puts(b,"\n");}
static void bound_file(np_buf *b,const char *label,const char *p){char h[65];hash(p,h);row(b,label,p);row(b,"sha256",h);}
static int native_product(const char *p){unsigned char magic[4];FILE *f=fopen(p,"rb");if(!f)die("product open");size_t n=fread(magic,1,sizeof magic,f);int bad=ferror(f);if(fclose(f)||bad)die("product magic read");return n==4&&!memcmp(magic,"\177ELF",4);}
static void fixtures(int create){for(int i=0;i<7;i++){char p[4400];path(p,out,files[i]);if(create)save(p,texts[i],strlen(texts[i]));else equal(p,texts[i],strlen(texts[i]));}}
static np_buf identity(void){np_buf b={0};np_puts(&b,"netregen-bytes-material-v1\nstatus\tPREPARED-no-test-result\n");row(&b,"root",root);row(&b,"out",out);bound_file(&b,"old-product",old);bound_file(&b,"new-product",fresh);char p[4400];path(p,root,"tests/check-netregen-bytes.cx");bound_file(&b,"harness",p);path(p,root,"exec/facts/pp-targets.tsv");bound_file(&b,"target-table",p);
 if(new_models[0])bound_file(&b,"new-models",new_models);
 size_t n;char *s=load(p,&n);/* Match actual target rows, not a substitute local list. */
 int rows=0;for(char *at=s;*at;){char *e=strchr(at,'\n');if(!e)die("target table newline");if(*at!='#'&&e!=at){char expected[100];const char *t=rows<6?targets[rows]:"";const char *slash=strchr(t,'/');if(!slash)die("six targets required");if(cx_fmt(expected,sizeof expected,"%.*s\t%s\t",(int)(slash-t),t,slash+1))die("target row bound");if((size_t)(e-at)<strlen(expected)||memcmp(at,expected,strlen(expected)))die("target table differs");rows++;}at=e+1;}free(s);if(rows!=6)die("six targets required");
 for(int i=0;i<7;i++){path(p,out,files[i]);bound_file(&b,"positive-source",p);}return b;}
static void bind(int create){fixtures(create);np_buf b=identity();char p[4400];path(p,out,"material.tsv");if(create)save(p,b.p,b.n);else equal(p,b.p,b.n);free(b.p);}
static void shardpath(char p[4400],int c,int t,const char *suffix){char leaf[100];if(cx_fmt(leaf,sizeof leaf,"%s-%d.%s",names[c],t,suffix))die("shard path");path(p,out,leaf);}
static np_buf observation(int c,int t){char a[4400],b[4400],ha[65],hb[65];shardpath(a,c,t,"old.image");shardpath(b,c,t,"new.image");size_t an,bn;char *as=load(a,&an),*bs=load(b,&bn);if(!an||an!=bn||memcmp(as,bs,an))die("machine image bytes differ or empty");cx_sha256_hex(as,an,ha);cx_sha256_hex(bs,bn,hb);free(as);free(bs);np_buf r={0};np_puts(&r,"netregen-bytes-observation-v1\n");row(&r,"case",names[c]);row(&r,"target",targets[t]);row(&r,"scope","cross-produced-image-bytes-not-native-execution");row(&r,"old-sha256",ha);row(&r,"new-sha256",hb);char p[4400],h[65];path(p,out,"material.tsv");hash(p,h);row(&r,"material-sha256",h);for(int k=0;k<2;k++){const char *suffix=k?"new.status":"old.status";shardpath(p,c,t,suffix);equal(p,"rc\t0\n",5);bound_file(&r,suffix,p);shardpath(p,c,t,k?"new.argv":"old.argv");bound_file(&r,k?"new-argv":"old-argv",p);shardpath(p,c,t,k?"new.stdout":"old.stdout");bound_file(&r,k?"new-stdout":"old-stdout",p);shardpath(p,c,t,k?"new.stderr":"old.stderr");bound_file(&r,k?"new-stderr":"old-stderr",p);}return r;}
static int compile(int c,int t,int lane){const char *stems[]={"old","new","legacy"};const char *stem=stems[lane];char image[4400],source[4400],other[4400],p[4400],why[512],suffix[80];int file=c==0?0:c==1?1:c==2?2:c==3?4:6;path(source,out,files[file]);path(other,out,"other.c");if(cx_fmt(suffix,sizeof suffix,"%s.image",stem))die("lane suffix");shardpath(image,c,t,suffix);struct stat st;if(!lstat(image,&st)||errno!=ENOENT)die("fresh image required");
 char *v[14];int vn=0;const char *product=lane==2?reference_product:lane?fresh:old;if(!native_product(product))v[vn++]="sh";v[vn++]=(char *)product;if(lane==1&&new_models[0]){v[vn++]="--models";v[vn++]=new_models;}v[vn++]="-b";v[vn++]=(char *)targets[t];v[vn++]="-o";v[vn++]=image;v[vn++]=source;if(c==2)v[vn++]=other;v[vn]=0;np_buf args={0};for(int i=0;v[i];i++){np_puts(&args,v[i]);np_puts(&args,"\n");}if(cx_fmt(suffix,sizeof suffix,"%s.argv",stem))die("lane suffix");shardpath(p,c,t,suffix);save(p,args.p,args.n);free(args.p);
 np_result r={0};int transport=np_run(v,root,0,25,&r,why,sizeof why);if(cx_fmt(suffix,sizeof suffix,"%s.stdout",stem))die("lane suffix");shardpath(p,c,t,suffix);save(p,r.out?r.out:"",r.outn);if(cx_fmt(suffix,sizeof suffix,"%s.stderr",stem))die("lane suffix");shardpath(p,c,t,suffix);save(p,r.err?r.err:"",r.errn);char status[100];if(cx_fmt(status,sizeof status,"rc\t%d\n",transport?-1:r.rc))die("status bound");if(cx_fmt(suffix,sizeof suffix,"%s.status",stem))die("lane suffix");shardpath(p,c,t,suffix);save(p,status,strlen(status));int rejected=r.rc!=0,diagnostic=r.err&&strstr(r.err,"error:"),bad=transport||rejected||diagnostic;np_free(&r);if(transport||(bad&&lane!=2)||(diagnostic&&!rejected))die("compile failed; evidence retained");return rejected;
}
static np_buf reference_identity(void){np_buf b={0};np_puts(&b,"netregen-reference-material-v1\n");char p[4400];path(p,out,"material.tsv");bound_file(&b,"AB-material",p);bound_file(&b,"reference-product",reference_product);return b;}
/* Reference evidence never supplies candidate qualification: A/B stays exact. */
static np_buf reference_observation(int c,int t){
 char p[4400],ha[65],hb[65],hl[65],mh[65];np_buf ab=observation(c,t);shardpath(p,c,t,"observation.tsv");equal(p,ab.p,ab.n);free(ab.p);
 np_buf r={0};np_puts(&r,"netregen-bytes-reference-v1\n");row(&r,"scope","legacy-reference-only;B-equals-A-remains-required");row(&r,"case",names[c]);row(&r,"target",targets[t]);path(p,out,"material.tsv");hash(p,mh);row(&r,"AB-material-sha256",mh);bound_file(&r,"reference-product",reference_product);path(p,root,"tests/check-netregen-bytes.cx");bound_file(&r,"reference-harness",p);
 shardpath(p,c,t,"legacy.status");size_t sn;char *status=load(p,&sn),*end;long rc;if(sn<5||memcmp(status,"rc\t",3))die("legacy status syntax");errno=0;rc=strtol(status+3,&end,10);if(errno||end==status+3||end!=status+sn-1||*end!='\n'||rc<0||rc>255)die("legacy transport or status invalid");free(status);
 const char *suffixes[]={"legacy.argv","legacy.stdout","legacy.stderr","legacy.status"};for(int i=0;i<4;i++){shardpath(p,c,t,suffixes[i]);bound_file(&r,suffixes[i],p);}
 shardpath(p,c,t,"old.image");size_t an;char *a=load(p,&an);cx_sha256_hex(a,an,ha);shardpath(p,c,t,"new.image");hash(p,hb);shardpath(p,c,t,"legacy.image");struct stat st;int present=!lstat(p,&st);if(!present&&errno!=ENOENT)die("legacy image stat");const char *relation="REJECT";if(present){size_t ln;char *l=load(p,&ln);cx_sha256_hex(l,ln,hl);if(!rc){if(!ln)die("legacy accepted empty image");relation=ln==an&&!memcmp(l,a,an)?"SAME":"DIFF";}free(l);}else{if(tx_copy(hl,sizeof hl,"ABSENT",6))die("legacy image marker bound");if(!rc)die("legacy accepted without image");}free(a);
 row(&r,"legacy-image-sha256",hl);row(&r,"A-image-sha256",ha);row(&r,"B-image-sha256",hb);row(&r,"legacy-to-A",relation);
 np_puts(&r,"REFERENCE_SHA\t");np_puts(&r,names[c]);np_puts(&r,"\t");np_puts(&r,targets[t]);np_puts(&r,"\t");np_puts(&r,hl);np_puts(&r,"\t");np_puts(&r,ha);np_puts(&r,"\t");np_puts(&r,hb);np_puts(&r,"\t");np_puts(&r,relation);np_puts(&r,"\tAB_SAME\n");return r;
}
static void fixed_key(const char *name,const char *target,int *c,int *t){*c=-1;*t=-1;for(int i=0;i<5;i++)if(!strcmp(name,names[i]))*c=i;for(int i=0;i<6;i++)if(!strcmp(target,targets[i]))*t=i;if(*c<0||*t<0)die("unknown fixed case or target");}
/* ATTR1/T records are token ordinals, not byte offsets: see
 * runtime.attribute_frame and parse2/attributes-byte.tsv AT.o and CT.ord.
 * Their records stay exact while only payload lengths are rewritten. */
static unsigned long long wire(const unsigned char *p,int n){unsigned long long v=0;for(int i=n-1;i>=0;i--)v=(v<<8)|p[i];return v;}
static void putwire(np_buf *b,unsigned long long v,int n){unsigned char p[8];for(int i=0;i<n;i++){p[i]=(unsigned char)v;v>>=8;}np_put(b,p,n);}
static unsigned long long unit_max;
static void limits(const char *r){char p[4400],h[65];if(!realpath(r,root))die("explicit ROOT required");path(p,root,"exec/facts/limits.tsv");size_t n;char *s=load(p,&n);for(size_t a=0;a<n;){size_t e=a;while(e<n&&s[e]!='\n')e++;if(e-a>=9&&!memcmp(s+a,"UNIT_MAX\t",9)){char *end;unsigned long long v=strtoull(s+a+9,&end,10);if(end==s+a+9||end>=s+e||*end!='\t'||!v||v>2147483647ULL||(unit_max&&unit_max!=v))die("UNIT_MAX fact");unit_max=v;}a=e+1;}free(s);if(!unit_max)die("missing UNIT_MAX fact");hash(p,h);printf("unit-limit-facts\t%s\t%s\n",p,h);}
static int keyword(const unsigned char *s,size_t a,size_t e,const char *word,size_t n){if(e-a<n||memcmp(s+a,word,n))return 0;if(e-a==n)return 1;unsigned char c=s[a+n];return c==' '||c=='\t'||c=='\r';}
static unsigned long long decimal(const unsigned char *s,size_t *at,size_t end){size_t begin=*at;unsigned long long v=0;while(*at<end&&s[*at]>='0'&&s[*at]<='9'){unsigned d=s[(*at)++]-'0';if(v>(2147483647ULL-d)/10)die("unit decimal overflow");v=v*10+d;}if(*at==begin||(*at-begin>1&&s[begin]=='0'))die("noncanonical unit decimal");return v;}
static int hexbyte(unsigned char c){return c>='0'&&c<='9'?c-'0':c>='a'&&c<='f'?c-'a'+10:-1;}
static void position(const unsigned char *s,size_t a,size_t e){size_t p=a+6;unsigned long long unit=decimal(s,&p,e);if(unit>=unit_max||p==e||s[p++]!=' ')die("unit frame id or fields");unsigned long long bytes=decimal(s,&p,e);if(p==e||s[p++]!=':'||bytes>(e-p)/2||2*bytes!=e-p)die("unit filename length");for(;p<e;p+=2){int h=hexbyte(s[p]),l=hexbyte(s[p+1]);if(h<0||l<0||(!h&&!l))die("unit filename hex or NUL");}}
static np_buf project(const unsigned char *s,size_t n,int newer,int depth){np_buf b={0};if(depth>4||!n)die("capture nesting or empty payload");
 if(n>=8&&(!memcmp(s,"USLATTR1",8)||!memcmp(s,"USLATTRT",8))){int one=!memcmp(s,"USLATTR1",8);size_t head,count;if(one){if(n<16)die("ATTR1 header");count=(size_t)wire(s+8,4);if(count>16384||count>(n-16)/5)die("ATTR1 count");head=16+5*count;if(wire(s+12,4)!=n-head)die("ATTR1 payload length");for(size_t i=0;i<count;i++)if(s[16+5*i+4]<1||s[16+5*i+4]>2)die("ATTR1 kind");}else{if(n<16)die("ATTRT header");size_t tn=(size_t)wire(s+8,4);if(tn<4||tn>n-12)die("ATTRT length");count=(size_t)wire(s+12,4);if(count>16384||tn!=4+9*count)die("ATTRT count");head=12+tn;for(size_t i=0;i<count;i++)if(wire(s+16+9*i,4)>=unit_max||s[16+9*i+8]<1||s[16+9*i+8]>2)die("ATTRT unit or kind");}
 np_buf child=project(s+head,n-head,newer,depth+1);if(one){np_put(&b,s,12);putwire(&b,child.n,4);np_put(&b,s+16,head-16);}else np_put(&b,s,head);np_put(&b,child.p,child.n);free(child.p);return b;}
 if(n>=7&&!memcmp(s,"USLFW1\n",7)){unsigned long long at=7,tl,cnt,ccwc;if(fw_side_head(s,n)||us_fw_u64(s,n,&at,&tl)||us_fw_u64(s,n,&at,&cnt)||us_fw_u64(s,n,&at,&ccwc)||fw_side_bad(ccwc,tl,n,at)||cnt>1024)die("FW header");size_t tail=(size_t)(at+tl);unsigned long long end=tail;for(unsigned long long i=0;i<cnt;i++){unsigned long long nl,sl;if(us_fw_u64(s,n,&end,&nl)||!nl||nl>1024||nl>n-end)die("FW slot name");const char *name=(const char *)s+end;end+=nl;if(us_fw_u64(s,n,&end,&sl)||sl>n-end)die("FW slot signature length");USForwardSig sig;if(us_forward_sig_decode(s+end,sl,name,nl,&sig))die("FW slot signature");end+=sl;}if(end!=n)die("FW suffix bytes");np_buf child=project(s+at,(size_t)tl,newer,depth+1);np_put(&b,s,7);putwire(&b,child.n,8);putwire(&b,cnt,8);putwire(&b,ccwc,8);np_put(&b,child.p,child.n);np_put(&b,s+tail,n-tail);free(child.p);return b;}
 if(n>=3&&!memcmp(s,"USL",3))die("unknown or truncated capture envelope");if(memchr(s,0,n)||s[n-1]!='\n')die("text capture NUL or incomplete line");int ended=0;for(size_t a=0;a<n;){size_t e=a;while(e<n&&s[e]!='\n')e++;int skip=0;if(newer&&keyword(s,a,e,".unit",5)){if(a==0&&e-a==7&&!memcmp(s+a,".unit 2",7)){}else{if(e-a<6||s[a+5]!=' ')die("unit frame delimiter");position(s,a,e);skip=1;}}if(newer&&keyword(s,a,e,".end",4)){if(e-a!=4||ended||e+1!=n)die("unique final end required");ended=1;skip=1;}if(!skip)np_put(&b,s+a,e+1-a);a=e+1;}if(newer&&!ended)die("new tape missing final end");return b;}
static int tapecompare(const char *a,const char *b,int pair){char ap[4096],bp[4096],ah[65],bh[65],ph[65],qh[65];if(!realpath(a,ap)||!realpath(b,bp)||!strcmp(ap,bp))die("distinct explicit captures required");size_t an,bn;unsigned char *as=(unsigned char *)load(ap,&an),*bs=(unsigned char *)load(bp,&bn);cx_sha256_hex(as,an,ah);cx_sha256_hex(bs,bn,bh);np_buf p=project(as,an,pair,0),q=project(bs,bn,1,0);cx_sha256_hex(p.p,p.n,ph);cx_sha256_hex(q.p,q.n,qh);printf("%s-capture\t%s\t%s\n%s-capture\t%s\t%s\n%s-projection-sha256\t%s\n%s-projection-sha256\t%s\n",pair?"left-new":"old",ap,ah,pair?"right-new":"new",bp,bh,pair?"left-new":"old",ph,pair?"right-new":"new",qh);int same=p.n==q.n&&!memcmp(p.p,q.p,p.n);free(as);free(bs);free(p.p);free(q.p);if(!same)die("tape semantic bytes or attributes or FW slots differ");printf("NETREGEN_BYTES\t%s\tscope=legal-new-unit-and-final-end-only;token-ordinal-attributes-and-FW-slots-retained\n",pair?"TAPE_PAIR_SAME":"TAPE_SAME");return 0;}
/* opt-frames ROOT RUN NET TABLE ABS_OUT CASE: one existing cases.tsv row per shard.
 * RUN executes the supplied constructed network; this checker never constructs it. */
static np_buf frame_records(const unsigned char *s,size_t n){np_buf b={0};for(size_t a=0;a<n;){size_t e=a;while(e<n&&s[e]!='\n')e++;if(e==n)die("frame record incomplete line");if(keyword(s,a,e,".unit",5))np_put(&b,s+a,e+1-a);a=e+1;}return b;}
static int samebuf(const np_buf *a,const np_buf *b){return a->n==b->n&&(!a->n||!memcmp(a->p,b->p,a->n));}
static void frameleaf(char p[4400],const char *leaf){char dir[4400];if(!*leaf||strpbrk(leaf,"/\\\r\n\t")||strstr(leaf,".."))die("fixture basename");path(dir,root,"tests/opt-frame-transparency");path(p,dir,leaf);}
static int optframes(int argc,char **argv){
 if(argc!=8)die("usage: opt-frames ROOT RUN NET TABLE ABS_OUT CASE");limits(argv[2]);char run[4096],net[4096],table[4096];if(!realpath(argv[3],run)||!realpath(argv[4],net)||!realpath(argv[5],table))die("explicit runner and constructed model required");
 if(argv[6][0]!='/'||strlen(argv[6])>=sizeof out||strpbrk(argv[6],"\r\n\t"))die("absolute output required");if(tx_copy(out,sizeof out,argv[6],strlen(argv[6])))die("absolute output required");if(mkdir(out,0700))die("new output directory required");
 const char *kind=argv[7];int positive=!strcmp(kind,"positive"),label=!strcmp(kind,"negative-label"),negative=!strcmp(kind,"negative-end")||!strcmp(kind,"negative-eof");if(!positive&&!label&&!negative)die("unknown opt frame case");
 char p[4400];frameleaf(p,"cases.tsv");size_t cn;char *cases=load(p,&cn),*selected=0;np_buf evidence={0};bound_file(&evidence,"cases",p);bound_file(&evidence,"runner",run);bound_file(&evidence,"network",net);bound_file(&evidence,"table",table);path(p,root,"tests/check-netregen-bytes.cx");bound_file(&evidence,"harness",p);row(&evidence,"case",kind);
 for(size_t a=0;a<cn;){size_t e=a;while(e<cn&&cases[e]!='\n')e++;if(e==cn)die("cases TSV LF");char *t=memchr(cases+a,'\t',e-a);if(!t)die("cases TSV columns");if((size_t)(t-cases-a)==strlen(kind)&&!memcmp(cases+a,kind,strlen(kind))){if(selected)die("duplicate case");char *u=memchr(t+1,'\t',(size_t)(cases+e-t-1));if(!u||u==t+1)die("cases TSV fixture column");*u=0;selected=t+1;}a=e+1;}
 if(!selected)die("case absent from cases.tsv");char *leaves[2]={selected,0};char *comma=strchr(selected,',');if(comma){*comma=0;leaves[1]=comma+1;if(strchr(leaves[1],','))die("fixture pair bound");}if(positive!=!!leaves[1])die("case fixture arity");
 np_buf projections[2][2]={{{0},{0}},{{0},{0}}};const char *models[]={net,table},*model_names[]={"net","table"};
 for(int i=0;i<(positive?2:1);i++){
  char input[4400],bound[4400];frameleaf(input,leaves[i]);bound_file(&evidence,"input",input);size_t in;unsigned char *source=(unsigned char *)load(input,&in);path(bound,root,"tools/bound");np_buf net_output={0};
  for(int m=0;m<2;m++){
   char leaf[96],why[512];char *v[]={bound,"10",run,(char *)models[m],input,input,0};const char *env[]={"UNISA_ATTRIBUTES=","UNISA_MAXSTEPS=200000000",0};np_result r={0};int transport=np_run(v,root,env,12,&r,why,sizeof why);
   if(cx_fmt(leaf,sizeof leaf,"lane-%d-%s.stdout",i,model_names[m]))die("capture path");path(p,out,leaf);save(p,r.out?r.out:"",r.outn);bound_file(&evidence,"stdout",p);if(cx_fmt(leaf,sizeof leaf,"lane-%d-%s.stderr",i,model_names[m]))die("capture path");path(p,out,leaf);save(p,r.err?r.err:"",r.errn);char status[128];if(cx_fmt(status,sizeof status,"rc\t%d\ntransport\t%d\nresidue\t%d\n",r.rc,transport,r.residue))die("capture status");if(cx_fmt(leaf,sizeof leaf,"lane-%d-%s.status",i,model_names[m]))die("capture path");path(p,out,leaf);save(p,status,strlen(status));
   if(transport||r.residue)die("runner transport or residue; evidence retained");
   if(negative){const char *want="reject: tape truncated\n";if(r.rc!=1||r.outn||r.errn!=strlen(want)||memcmp(r.err,want,r.errn))die("terminator fixture did not explicitly reject without output");}
   else{
    if(r.rc||r.errn||!r.outn)die("positive runner rejected; evidence retained");projections[m][i]=project((unsigned char *)r.out,r.outn,1,0);np_buf before=frame_records(source,in),after=frame_records((unsigned char *)r.out,r.outn);if(!samebuf(&before,&after))die("metadata record sequence changed");free(before.p);free(after.p);
    if(!m)np_put(&net_output,r.out,r.outn);else if(net_output.n!=r.outn||memcmp(net_output.p,r.out,r.outn))die("network and table output bytes differ");
    if(label){const char *keep[]={".unitx:\n",".endx:\n","  .frame 8\n","  store64 [r7+0], r0\n","  load64 r1, [r7+0]\n","  .frame -8\n"};for(int k=0;k<6;k++)if(tx_find(projections[m][i].p,(long)projections[m][i].n,keep[k],(long)strlen(keep[k]))<0)die("real dot label lost or stack window crossed label");}
   }
   np_free(&r);
  }
  free(net_output.p);free(source);
 }
 for(int m=0;m<2;m++){if(positive&&!samebuf(&projections[m][0],&projections[m][1]))die("optimized strict projections differ");for(int i=0;i<2;i++)free(projections[m][i].p);}free(cases);path(p,out,"observation.tsv");save(p,evidence.p,evidence.n);fwrite(evidence.p,1,evidence.n,stdout);free(evidence.p);puts("NETREGEN_BYTES\tOPT_FRAMES_PASS\tscope=one-cases-tsv-row;independent-net-and-table-models;strict-projection;ordered-metadata;unique-final-end;real-dot-labels;explicit-negative-rejection");return 0;
}
static int netregen_main(int argc,char **argv){if(argc>1&&!strcmp(argv[1],"opt-frames"))return optframes(argc,argv);if(argc==5&&(!strcmp(argv[1],"tape")||!strcmp(argv[1],"tape-pair"))){limits(argv[2]);return tapecompare(argv[3],argv[4],!strcmp(argv[1],"tape-pair"));}if(argc<2)die("mode arguments");int ref=!strcmp(argv[1],"reference"),refsum=!strcmp(argv[1],"reference-summary");if(strcmp(argv[1],"prepare")&&strcmp(argv[1],"case")&&strcmp(argv[1],"summary")&&!ref&&!refsum)die("mode arguments");if(argc>=4&&!strcmp(argv[argc-2],"--new-models")){const char *pkg=argv[argc-1];if(pkg[0]!='/'||strlen(pkg)>=sizeof new_models||strpbrk(pkg,"\r\n\t")||!realpath(pkg,new_models))die("explicit absolute new models package required");argc-=2;}if(ref||refsum){if(argc<4||strcmp(argv[argc-2],"--reference-product"))die("explicit --reference-product ABS_LEGACY required");const char *product=argv[argc-1];if(product[0]!='/'||strlen(product)>=sizeof reference_product||strpbrk(product,"\r\n\t")||!realpath(product,reference_product))die("explicit absolute reference product required");argc-=2;}if(argc!=6&&argc!=8)die("usage: prepare|case|summary|reference|reference-summary ROOT A B ABS_OUT [CASE TARGET] [--reference-product ABS_LEGACY] [--new-models ABS_PKG]");if(!realpath(argv[2],root)||!realpath(argv[3],old)||!realpath(argv[4],fresh))die("explicit canonical existing inputs required");if(!strcmp(old,fresh))die("distinct products required");if(argv[5][0]!='/'||strlen(argv[5])>=sizeof out||strpbrk(argv[5],"\r\n\t"))die("absolute output required");if(tx_copy(out,sizeof out,argv[5],strlen(argv[5])))die("absolute output required");
 int prepare=!strcmp(argv[1],"prepare"),run=!strcmp(argv[1],"case"),summary=!strcmp(argv[1],"summary");if(((run||ref)&&argc!=8)||(!(run||ref)&&argc!=6)||(!prepare&&!run&&!summary&&!ref&&!refsum))die("mode arguments");if(prepare){if(mkdir(out,0700))die("new material directory required");bind(1);puts("NETREGEN_BYTES\tPREPARED\tno-test-result\tcases=5\ttargets=6");return 0;}
 bind(0);if(ref){int c,t;fixed_key(argv[6],argv[7],&c,&t);char p[4400];np_buf before=reference_identity();shardpath(p,c,t,"legacy-material.tsv");save(p,before.p,before.n);free(before.p);int rejected=compile(c,t,2);bind(0);np_buf after=reference_identity();equal(p,after.p,after.n);free(after.p);np_buf r=reference_observation(c,t);shardpath(p,c,t,"legacy-observation.tsv");save(p,r.p,r.n);fwrite(r.p,1,r.n,stdout);free(r.p);puts(rejected?"NETREGEN_BYTES\tREFERENCE_REJECT_RECORDED\tnot-candidate-qualification":"NETREGEN_BYTES\tREFERENCE_RECORDED\tnot-candidate-qualification");return 0;}
 if(refsum){puts("REFERENCE_SHA_HEADER\tcase\ttarget\tlegacy-0.0.47-sha256\tA-sha256\tB-sha256\tlegacy-to-A\tB-to-A");for(int c=0;c<5;c++)for(int t=0;t<6;t++){char p[4400];np_buf id=reference_identity();shardpath(p,c,t,"legacy-material.tsv");equal(p,id.p,id.n);free(id.p);np_buf r=reference_observation(c,t);shardpath(p,c,t,"legacy-observation.tsv");equal(p,r.p,r.n);fwrite(r.p,1,r.n,stdout);free(r.p);}bind(0);puts("NETREGEN_BYTES\tREFERENCE_SUMMARY\tshards=30\tqualification=B-equals-A-only;legacy-SAME-DIFF-REJECT-is-reference-only");return 0;}
 if(run){int c,t;fixed_key(argv[6],argv[7],&c,&t);compile(c,t,0);compile(c,t,1);bind(0);np_buf r=observation(c,t);char p[4400];shardpath(p,c,t,"observation.tsv");save(p,r.p,r.n);fwrite(r.p,1,r.n,stdout);free(r.p);puts("NETREGEN_BYTES\tSHARD_SAME");return 0;}
 for(int c=0;c<5;c++)for(int t=0;t<6;t++){np_buf r=observation(c,t);char p[4400];shardpath(p,c,t,"observation.tsv");equal(p,r.p,r.n);fwrite(r.p,1,r.n,stdout);free(r.p);}bind(0);puts("NETREGEN_BYTES\tPASS\tshards=30\tscope=cross-produced-images-only");return 0;}

int main(int argc,char **argv){

 if(argc>1&&!strcmp(argv[1],"batch")){
  if(argc!=10||strcmp(argv[8],"--new-models"))die("batch ROOT OLD_PRODUCT NEW_PRODUCT ABS_OUT CASE TARGET --new-models ABS_PKG");
  char *prep[]={argv[0],"prepare",argv[2],argv[3],argv[4],argv[5],argv[8],argv[9],0};
  int rc=netregen_main(8,prep);if(rc)return rc;
  char *run[]={argv[0],"case",argv[2],argv[3],argv[4],argv[5],argv[6],argv[7],argv[8],argv[9],0};rc=netregen_main(10,run);if(!rc)puts("NETREGEN_SHARD_SAME");return rc;
 }
 return netregen_main(argc,argv);
}
