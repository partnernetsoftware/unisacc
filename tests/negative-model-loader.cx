/* Installed-product package/model-loader refusal oracle on private one-byte-flipped copies.
 * ROOT PRODUCT_COM NEW_ABS_OUT [core|terminal]. PRODUCT_COM must be ROOT/unisacc.com.
 * The embedded P3 package is located from the terminal UNIPKG1 footer (the layout
 * tests/hostseed-controls.cx and tools/package-refresh.cx read; a certificate-carrying APE is
 * refused here, not guessed). Its header, D table and M headers are parsed, and each case flips
 * one byte of a private copy in out/: footer magic/length, package version, a D row of the
 * lnx/x86_64/image/O0 route (name charset, model index, route, duplicate stage, stage name),
 * an M header (codec, CRC) or an M body used by that route. Every case runs
 *   sh COPY ok.c -b lnx/x86_64 -o CASE.bin
 * and requires rc2, empty stdout, exactly "run: <named reason>\n" on stderr and no image; the
 * pristine product then recovers (rc0, image exits 7). A flipped M body of a member that no
 * lnx/x86_64 route references is a control that must still compile (lazy load).
 * terminal: D flips that take the final elf stage out of the image route. The correct outcome is
 * a named refusal with no image (spec: corrupt package input is refused, never a wrong product);
 * the Root7a product writes the lowered target text as the image with rc0, so this set FAILs. */
#pragma unisa use cxlib.netpack
static char root[4096],work[4096],bound[4200],com[4200];
static int assertions,failures;
static void die(const char *s){fprintf(stderr,"negative-model-loader: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void copy_fit(char *dst,size_t cap,const char *src){size_t i=0;if(!cap)die("copy-bound");while(src[i]&&i+1<cap){dst[i]=src[i];i++;}if(src[i])die("copy-bound");dst[i]=0;}
static void ck(int ok,const char *a,const char *b){assertions++;if(!ok)failures++;printf("%s\tnegative-model-loader.%s.%s\n",ok?"PASS":"FAIL",a,b);}
static void path(char *o,size_t cap,const char *a,const char *b){int n=snprintf(o,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path");}
static void saved(const char *name,const void *s,size_t n){char p[4400];path(p,sizeof p,work,name);int f=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);size_t at=0;if(f<0)die("exclusive-write");while(at<n){ssize_t k=write(f,(const char *)s+at,n-at);if(k<0&&errno==EINTR)continue;if(k<=0)die("write");at+=(size_t)k;}if(fsync(f)||close(f))die("close");}
static char *load(const char *p,size_t *n){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<16||st.st_size>67108864)die("regular-product");char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("product-extent");return s;}
static int missing(const char *name){char p[4400];struct stat st;path(p,sizeof p,work,name);errno=0;if(!lstat(p,&st))return 0;if(errno!=ENOENT)die("stat-not-ENOENT");return 1;}
static int regular(const char *name){char p[4400];struct stat st;path(p,sizeof p,work,name);return !lstat(p,&st)&&S_ISREG(st.st_mode)&&st.st_size>0;}
static np_result runv(char **v,const char *label){
 char why[1024],name[256];np_result r;
 if(np_run(v,work,0,25,&r,why,sizeof why))die(why);
 {int zn=snprintf(name,sizeof name,"%s.stdout",label);if(zn<0||(size_t)zn>=sizeof name)die("name");}saved(name,r.out,r.outn);
 {int zn=snprintf(name,sizeof name,"%s.stderr",label);if(zn<0||(size_t)zn>=sizeof name)die("name");}saved(name,r.err,r.errn);return r;}

/* ---- embedded P3 package: "P 3 PM PS NR", PS rows "D route name in out M", PM rows
   "M CLEN RAW CODEC CRC" each followed by CLEN bytes, then NR resources. ---- */
enum{PM=32,PS=1479,MAXF=8};
typedef struct{size_t at,n;} Span;
typedef struct{size_t row;Span f[6];} Row;           /* f[0]="D"/"M", then fields */
static char *ape;static size_t apen,pkg,pkgn;
static Row drow[PS],mrow[PM];static size_t mbody[PM];
static size_t line_end(size_t at){const char *e=memchr(ape+at,'\n',pkg+pkgn-at);if(!e)die("package-line");return (size_t)(e-ape);}
static int fields(size_t at,size_t end,Span *f,int max){int k=0;while(at<end){if(k==max)return -1;size_t s=at;while(at<end&&ape[at]!=' ')at++;if(at==s)return -1;f[k].at=s;f[k].n=at-s;k++;if(at<end)at++;}return k;}
static int is(Span s,const char *lit){return s.n==strlen(lit)&&!memcmp(ape+s.at,lit,s.n);}
static int starts(Span s,const char *lit){size_t l=strlen(lit);return s.n>=l&&!memcmp(ape+s.at,lit,l);}
static long num(Span s){long v=0;if(!s.n||s.n>10)die("package-number");for(size_t i=0;i<s.n;i++){char c=ape[s.at+i];if(c<'0'||c>'9')die("package-digit");v=v*10+(c-'0');}return v;}
static void parse(void){
 if(memcmp(ape+apen-16,"UNIPKG1\n",8))die("terminal-UNIPKG1-footer-required");
 unsigned long long z=0;for(int i=7;i>=0;i--)z=(z<<8)|(unsigned char)ape[apen-8+i];
 if(!z||z>apen-16)die("footer-extent");pkgn=(size_t)z;pkg=apen-16-pkgn;
 Span h[MAXF];size_t end=line_end(pkg);
 if(fields(pkg,end,h,MAXF)!=5||!is(h[0],"P")||!is(h[1],"3")||num(h[2])!=PM||num(h[3])!=PS)die("package-header");
 size_t at=end+1;
 for(int i=0;i<PS;i++){end=line_end(at);drow[i].row=at;if(fields(at,end,drow[i].f,6)!=6||!is(drow[i].f[0],"D")||num(drow[i].f[5])>=PM)die("package-D");at=end+1;}
 for(int i=0;i<PM;i++){end=line_end(at);mrow[i].row=at;if(fields(at,end,mrow[i].f,5)!=5||!is(mrow[i].f[0],"M")||!is(mrow[i].f[3],"1"))die("package-M");
  mbody[i]=end+1;size_t c=(size_t)num(mrow[i].f[1]);if(c<32||c>pkg+pkgn-mbody[i])die("package-M-extent");at=mbody[i]+c;}
}
static int find(const char *route,const char *name){int hit=-1;for(int i=0;i<PS;i++)if(is(drow[i].f[1],route)&&is(drow[i].f[2],name)){if(hit>=0)die("duplicate-D");hit=i;}return hit;}

/* One private copy, one XORed byte; assert it really is a one-byte change of the pristine bytes. */
static void flip_copy(const char *label,size_t off,unsigned char mask,char *copy,size_t cap){
 if(off>=apen||!mask)die("flip-bound");char name[256];{int zn=snprintf(name,sizeof name,"%s.com",label);if(zn<0||(size_t)zn>=sizeof name)die("name");}
 char *b=malloc(apen);if(!b)die("flip-allocation");{size_t k=0;while(k<apen){b[k]=ape[k];k++;}}b[off]^=(char)mask;saved(name,b,apen);free(b);
 path(copy,cap,work,name);size_t n;char *back=cx_read(copy,&n);size_t diff=0,where=0;
 if(!back||n!=apen)die("copy-readback");for(size_t i=0;i<n;i++)if(back[i]!=ape[i]){diff++;where=i;}free(back);
 ck(diff==1&&where==off,label,"one-byte-copy");}
static void recover(const char *label){
 char bin[256],tag[256];{int zn=snprintf(bin,sizeof bin,"rec-%s.bin",label);if(zn<0||(size_t)zn>=sizeof bin)die("bin");}{int zn=snprintf(tag,sizeof tag,"%s-recovery",label);if(zn<0||(size_t)zn>=sizeof tag)die("tag");}
 char *v[]={bound,"20","sh",com,"ok.c","-b","lnx/x86_64","-o",bin,0};
 np_result r=runv(v,tag);ck(!r.rc&&!r.outn&&!r.errn&&regular(bin),label,"recovery-pristine-rc0-image");np_free(&r);
 char exe[4400];path(exe,sizeof exe,work,bin);char *x[]={bound,"10",exe,0};
 {int zn=snprintf(tag,sizeof tag,"%s-recovery-exec",label);if(zn<0||(size_t)zn>=sizeof tag)die("tag");}r=runv(x,tag);ck(r.rc==7&&!r.outn&&!r.errn,label,"recovery-image-exit7");np_free(&r);}
/* reason==0: a control that must still compile and run. */
static void flipcase(const char *label,size_t off,unsigned char mask,const char *reason){
 char copy[4400],bin[256],want[256];flip_copy(label,off,mask,copy,sizeof copy);{int zn=snprintf(bin,sizeof bin,"%s.bin",label);if(zn<0||(size_t)zn>=sizeof bin)die("bin");}
 char *v[]={bound,"20","sh",copy,"ok.c","-b","lnx/x86_64","-o",bin,0};np_result r=runv(v,label);
 if(reason){
  int n=snprintf(want,sizeof want,"run: %s\n",reason);int exact=n>0&&r.errn==(size_t)n&&!memcmp(r.err,want,(size_t)n);
  ck(r.rc==2,label,"rc2");ck(!r.outn,label,"stdout-empty");ck(exact,label,"stderr-named-exact");ck(missing(bin),label,"no-image");
  if(!exact||r.rc!=2){fprintf(stderr,"negative-model-loader: %s rc=%d stderr:\n",label,r.rc);fwrite(r.err,1,r.errn,stderr);}
 }else{
  ck(!r.rc&&!r.outn&&!r.errn&&regular(bin),label,"control-rc0-image");char exe[4400],tag[256];path(exe,sizeof exe,work,bin);char *x[]={bound,"10",exe,0};
  {int zn=snprintf(tag,sizeof tag,"%s-exec",label);if(zn<0||(size_t)zn>=sizeof tag)die("tag");}np_result e=runv(x,tag);ck(e.rc==7&&!e.outn&&!e.errn,label,"control-image-exit7");np_free(&e);
 }
 np_free(&r);recover(label);}

static int allowed(const char *e){size_t n=strlen(e);
 if(!strcmp(e,"ok.c"))return 1;if(n>4&&!strcmp(e+n-4,".com"))return 1;if(n>7&&(!strcmp(e+n-7,".stdout")||!strcmp(e+n-7,".stderr")))return 1;
 return n>8&&!strcmp(e+n-4,".bin")&&(!strncmp(e,"rec-",4)||!strncmp(e,"control-",8));}

int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN negative-model-loader needs Linux/x86_64\n",stderr);return 3;
#endif
 int terminal=argc==5&&!strcmp(argv[4],"terminal"),qprefix=argc==5&&!strcmp(argv[4],"qprefix");
 if((argc!=4&&!(argc==5&&(terminal||qprefix||!strcmp(argv[4],"core"))))||!realpath(argv[1],root)||argv[2][0]!='/'||argv[3][0]!='/'||strstr(argv[3],".."))die("usage ROOT PRODUCT_COM ABS_OUT [core|terminal|qprefix]");
 {char expected[4200];path(expected,sizeof expected,root,"unisacc.com");if(strcmp(argv[2],expected))die("installed-product-required");}
 if(unsetenv("UNISACC_RR_TIME")||unsetenv("UNISACC_RF_CAPTURE")||unsetenv("UNISA_ATTRIBUTES")||setenv("UNISACC_RUN_CACHE","0",1))die("clean-environment");
 copy_fit(com,sizeof com,argv[2]);copy_fit(work,sizeof work,argv[3]);if(mkdir(work,0700))die("new-output-required");
 path(bound,sizeof bound,root,"tools/bound");
 if(qprefix){
  /* Existing unregistered oracle exec/c/qprefixcheck.cx, run unmodified on the installed product:
     8 malformed C-prefix records refused by the production decoder (rc2) and its own decoder, and
     every one of the 32 package Nets re-compacted to equal QA. It builds its loaders with host cc. */
  char entry[4400],sha[65];path(entry,sizeof entry,root,"exec/c/qprefixcheck.cx");size_t n0;char *q=load(entry,&n0);cx_sha256_hex(q,n0,sha);free(q);
  ape=load(com,&apen);char before[65],after[65];cx_sha256_hex(ape,apen,before);free(ape);
  char *v[]={bound,"50","sh",com,entry,"--","--artifact",com,0};char why[1024];np_result r;
  if(np_run(v,root,0,52,&r,why,sizeof why))die(why);saved("qprefix.stdout",r.out,r.outn);saved("qprefix.stderr",r.err,r.errn);
  const char *want="qprefix: tiny execution equal; 8 malformed rejected; chained prefixes accepted; real models 32, saved 0 B; QA exact, runtime memory unchanged\n";
  ck(!r.rc,"qprefix","rc0");ck(!r.errn,"qprefix","stderr-empty");ck(r.outn==strlen(want)&&!memcmp(r.out,want,r.outn),"qprefix","stdout-exact-8-malformed-32-models");np_free(&r);
  size_t n2;char *again=load(com,&n2);cx_sha256_hex(again,n2,after);free(again);ck(!strcmp(before,after),"candidate","unchanged");
  printf("CANDIDATE\tsha256=%s\tqprefixcheck=%s\n",before,sha);
  puts("NOT_CLAIMED\thost-cc-dependency-not-hermetic-qprefix-oracle-only-no-loader-flip");
  printf("NEGATIVE_MODEL_LOADER\tassertions=%d\tfailed=%d\tset=qprefix\n",assertions,failures);return failures?1:0;
 }
 ape=load(com,&apen);char before[65],after[65];cx_sha256_hex(ape,apen,before);parse();
 {const char *s="int main(void){return 7;}\n";saved("ok.c",s,strlen(s));}
 const char *R="lnx/x86_64/image/O0";
 int e2=find(R,"e2"),e1=find(R,"e1"),lower=find(R,"lower"),elf=find(R,"elf");
 ck(e2>=0&&e1>=0&&lower>=0&&elf>=0,"package","image-O0-route-rows");if(failures)die("package-routing");
 int m_e2=(int)num(drow[e2].f[5]),m_lower=(int)num(drow[lower].f[5]);
 ck(m_e2==0,"package","D-image-O0-e2-M0");ck(m_lower==13,"package","D-image-O0-lower-M13");
 int used[PM]={0};for(int i=0;i<PS;i++)if(starts(drow[i].f[1],"lnx/x86_64/"))used[num(drow[i].f[5])]=1;
 int control=-1;for(int i=0;i<PM;i++)if(!used[i]){control=i;break;}
 ck(control>=0&&control!=m_e2&&control!=m_lower,"package","control-member-unreferenced-by-lnx-x86_64");if(failures)die("package-routing");
 recover("baseline");
 Span name=drow[lower].f[2],route=drow[lower].f[1],idx=drow[lower].f[5],e1n=drow[e1].f[2];
 Span codec=mrow[m_lower].f[3],crc=mrow[m_lower].f[4];
 if(!terminal){
  /* footer: magic 'U'->'T'; length bit0 shifts the package start off its 'P' tag */
  flipcase("footer-magic",apen-16,1,"bad or missing package footer");
  flipcase("footer-length",apen-8,1,"bad model tag");
  /* header: version '3'->'7' */
  flipcase("header-version",pkg+2,4,"unknown package version");
  /* D rows of lnx/x86_64/image/O0 */
  flipcase("d-name-charset",name.at,0x40,"bad package name");                 /* lower -> ,ower */
  ck(idx.n==2&&ape[idx.at]=='1',"package","lower-index-two-digit");
  flipcase("d-model-index",idx.at,8,"bad package model index");               /* 13 -> 93 >= 32 */
  flipcase("d-route-format",route.at+11,1,"package format mismatch");         /* image -> hmage: prune.out != elf.in */
  ck(e1n.n==2&&ape[e1n.at+1]=='1',"package","e1-name");
  flipcase("d-duplicate-stage",e1n.at+1,2,"duplicate package stage");         /* e1 -> e3 before e3 */
  flipcase("d-stage-boundary",name.at,1,"unknown package route or stage boundary"); /* lower -> mower */
  /* M header and body of the route's lower member, and its shared first member */
  flipcase("m-header-codec",codec.at,1,"bad compressed model header");         /* codec 1 -> 0 */
  flipcase("m-header-crc",crc.at+crc.n-1,1,"compressed model CRC");             /* last CRC digit +-1 */
  flipcase("m-body-lower",mbody[m_lower]+16,1,"invalid compressed model");
  flipcase("m-body-e2",mbody[m_e2]+16,1,"invalid compressed model");
  char label[64];{int zn=snprintf(label,sizeof label,"control-m%d-body",control);if(zn<0||(size_t)zn>=sizeof label)die("label");}
  flipcase(label,mbody[control]+16,1,0);
 }else{
  Span er=drow[elf].f[1],en=drow[elf].f[2];
  flipcase("terminal-elf-route",er.at+11,1,"unknown package route or stage boundary"); /* elf row leaves image/O0 */
  flipcase("terminal-elf-name",en.at,1,"unknown package route or stage boundary");    /* elf -> dlf */
 }
 {DIR *dp=opendir(work);struct dirent *e;int stray=0;if(!dp)die("opendir");
  while((e=readdir(dp))){if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;
   if(!allowed(e->d_name)){stray++;fprintf(stderr,"negative-model-loader: unexpected output %s\n",e->d_name);}}
  closedir(dp);ck(!stray,"output","no-refused-image-or-stray");}
 size_t n2;char *again=load(com,&n2);cx_sha256_hex(again,n2,after);free(again);free(ape);ck(!strcmp(before,after),"candidate","unchanged");
 printf("CANDIDATE\tsha256=%s\tpackage_offset=%zu\tpackage_length=%zu\tcontrol=M%d\n",before,pkg,pkgn,control);
 puts("NOT_CLAIMED\tcertificate-APE-footer-trailing-data-resource-table-M-clen-raw-other-routes-targets-foreign-hosts-payload-trust");
 printf("NEGATIVE_MODEL_LOADER\tassertions=%d\tfailed=%d\tset=%s\n",assertions,failures,terminal?"terminal":"core");
 return failures?1:0;}
