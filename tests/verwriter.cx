#pragma unisa use text.text
/* verwriter.cx -- one writer per record version tag (AUDIT-DUP, 2026-11-05).
   A record whose first line is "<tag>-vN" (written as np_puts(&b,"<tag>-vN\n")) is an identity:
   two files writing the same tag write two byte forms of one identity, which is how
   source-package-job-v1 came to exist with and without a context row. For every tag the set
   of tracked tools/ cx/ src/ .cx files that write it is compared with tests/verwriter.tsv;
   a new writer for a tag, or a new tag with more than one writer, fails. tests/ files are not
   counted: a test builds its own expected record on purpose. Rows only go away.
     sh ./unisacc.com -run tests/verwriter.cx -- --check
     sh ./unisacc.com -run tests/verwriter.cx -- --write
   Output keeps the ratchet summary shape "verwriter: ok: ..." / "verwriter: FAIL: ...". */
/* --check --files PATH... retains all writers: a selected file can collide with
   any other writer, including a previously single-writer tag absent from baseline. */
#define BASELINE "tests/verwriter.tsv"
#define MAXW 4096

typedef struct { char tag[96]; char path[256]; int used; } Row;
static Row base[MAXW], live[MAXW];
static int nbase, nlive;

static int is_tagc(int c) { return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-'; }

/* Every np_puts(&X,"<tag>-vN\n") in SRC; one (tag,path) row per distinct tag. */
static int scan(const char *path, const char *s, long n) {
    static const char pat[] = "np_puts(&";
    long i;
    for (i = 0; i + 9 < n; i++) {
        long j, t0, t1, k;
        if (s[i] != 'n' || !tx_prefix(s + i, n - i, pat, 9)) continue;
        j = i + 9;
        while (j < n && ((s[j] >= 'a' && s[j] <= 'z') || s[j] == '_' || (s[j] >= '0' && s[j] <= '9'))) j++;
        if (j + 1 >= n || s[j] != ',' || s[j + 1] != '"') continue;
        t0 = j + 2; t1 = t0;
        while (t1 < n && is_tagc(s[t1])) t1++;
        if (t1 + 2 >= n || s[t1] != '\\' || s[t1 + 1] != 'n' || s[t1 + 2] != '"') continue;
        for (k = t1 - 1; k > t0 && s[k] >= '0' && s[k] <= '9'; k--) ;
        if (k <= t0 + 1 || k == t1 - 1 || s[k] != 'v' || s[k - 1] != '-') continue;   /* must end in -vN */
        if (t1 - t0 >= 96) continue;
        {   int r, dup = 0; char tag[96];
            for (r = 0; r < t1 - t0; r++) tag[r] = s[t0 + r];
            tag[t1 - t0] = 0;
            for (r = 0; r < nlive; r++) if (tx_eqz(live[r].path, path) && tx_eqz(live[r].tag, tag)) dup = 1;
            if (dup) continue;
            if (nlive == MAXW) return -1;
            if (cx_fmt(live[nlive].tag, sizeof live[nlive].tag, "%s", tag)) return -1;
            if (cx_fmt(live[nlive].path, sizeof live[nlive].path, "%s", path)) return -1;
            nlive++;
        }
    }
    return 0;
}

static int writers(Row *v, int nv, const char *tag) { int r, c = 0; for (r = 0; r < nv; r++) if (tx_eqz(v[r].tag, tag)) c++; return c; }
static Row *find(Row *v, int nv, const char *tag, const char *path) {
    int r; for (r = 0; r < nv; r++) if (tx_eqz(v[r].tag, tag) && tx_eqz(v[r].path, path)) return &v[r];
    return 0;
}

static int load_baseline(void) {
    size_t n, i = 0; char *b = cx_read(BASELINE, &n);
    if (!b) { fprintf(stderr, "verwriter: cannot read %s (run --write once)\n", BASELINE); return -1; }
    while (i < n) {
        size_t e = i; while (e < n && b[e] != '\n') e++;
        if (e > i && b[i] != '#') {
            size_t t = i; while (t < e && b[t] != '\t') t++;
            if (t == e || t - i >= 96 || e - t - 1 >= 256 || nbase == MAXW) { fprintf(stderr, "verwriter: bad row in %s\n", BASELINE); free(b); return -1; }
            { size_t k; for (k = i; k < t; k++) base[nbase].tag[k - i] = b[k]; base[nbase].tag[t - i] = 0;
              for (k = t + 1; k < e; k++) base[nbase].path[k - t - 1] = b[k]; base[nbase].path[e - t - 1] = 0; }
            nbase++;
        }
        i = e + 1;
    }
    free(b); return 0;
}

/* Must find the two forms it is about and ignore what is not a record tag. */
static int self_check(void) {
    static const char a[] = "np_puts(&b,\"source-package-job-v1\\n\"); np_puts(&o,\"x-v12\\n\"); np_puts(&b,\"plain\\n\"); np_puts(&b,\"v1\\n\"); np_puts(&b,\"job-v1\\n\");";
    int saved = nlive, ok;
    if (scan("SELF", a, (long)sizeof a - 1)) return 0;
    ok = nlive - saved == 3 && writers(live, nlive, "source-package-job-v1") == 1 && writers(live, nlive, "x-v12") == 1 && writers(live, nlive, "job-v1") == 1;
    nlive = saved;
    return ok;
}

int main(int argc, char **argv) {
    char *list = 0, *rec, *end; size_t ln = 0; int check, files = 0, over = 0, under = 0, multi = 0, r, rc;
    int scoped = argc >= 4 && tx_eqz(argv[1], "--check") && tx_eqz(argv[2], "--files");
    if (!scoped && (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write")))) {
        fprintf(stderr, "usage: verwriter.cx --check [--files PATH...] | --write\n"); return 2;
    }
    if (scoped) fprintf(stderr, "verwriter: --files retains full scan (global writer uniqueness)\n");
    if (!self_check()) { fprintf(stderr, "verwriter: self-check failed\n"); return 2; }
    check = tx_eqz(argv[1], "--check");
    if (check && load_baseline() < 0) return 2;
    rc = cx_run("git ls-files -z -- 'tools/*.cx' 'cx/*.cx' 'src/*.cx'", &list, &ln);
    if (rc != 0 || !list) { fprintf(stderr, "verwriter: git ls-files failed (rc %d)\n", rc); return 2; }
    for (rec = list, end = list + ln; rec < end; rec += strlen(rec) + 1) {
        size_t n; char *src;
        if (!*rec) continue;
        src = cx_read(rec, &n);
        if (!src) continue;
        files++;
        if (scan(rec, src, (long)n)) { fprintf(stderr, "verwriter: row bound\n"); free(src); return 2; }
        free(src);
    }
    free(list);
    for (r = 0; r < nlive; r++) if (writers(live, nlive, live[r].tag) > 1 && r == 0 + r) {
        int k, first = 1; for (k = 0; k < r; k++) if (tx_eqz(live[k].tag, live[r].tag)) first = 0;
        if (first) multi++;
    }
    if (!check) {
        char *out = 0; size_t olen = 0, ocap = 0;
        static const char head[] = "# tests/verwriter.tsv -- written by tests/verwriter.cx --write.\n"
                                   "# Record version tags (np_puts \"<tag>-vN\\n\") written by more than one tools/ cx/ src/ file.\n"
                                   "# Rows only go away: a new writer for a tag, or a new multi-writer tag, fails --check.\n# tag\tpath\n";
        out = malloc(ocap = sizeof head + (size_t)nlive * 360); if (!out) return 2;
        for (olen = 0; head[olen]; olen++) out[olen] = head[olen];
        for (r = 0; r < nlive; r++) if (writers(live, nlive, live[r].tag) > 1) {
            int w = 0; char line[400];
            if (cx_fmt(line, sizeof line, "%s\t%s\n", live[r].tag, live[r].path)) return 2;
            while (line[w]) out[olen++] = line[w++];
        }
        if (cx_write(BASELINE, out, olen)) { fprintf(stderr, "verwriter: cannot write %s\n", BASELINE); return 2; }
        free(out);
        printf("verwriter: wrote %s: %d files, %d multi-writer tags\n", BASELINE, files, multi);
        return 0;
    }
    for (r = 0; r < nlive; r++) {
        Row *b;
        if (writers(live, nlive, live[r].tag) < 2) continue;
        b = find(base, nbase, live[r].tag, live[r].path);
        if (b) b->used = 1;
        else { printf("verwriter: %s has writer %s and no baseline row (one writer per record tag)\n", live[r].tag, live[r].path); over++; }
    }
    for (r = 0; r < nbase; r++) if (!base[r].used) under++;
    printf("verwriter: %s: %d files, %d multi-writer tags (baseline rows %d); %d above baseline, %d below (--write ratchets down)\n",
           over ? "FAIL" : "ok", files, multi, nbase, over, under);
    return over ? 1 : 0;
}
