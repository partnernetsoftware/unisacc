/* Small cx suite for gcc_cx.com and clang_cx.com. No unisacc.com.
   From the repo root:
   sh ./gcc_cx.com tests/cxcc/suite.cx -o out/cxcc-suite/suite
   ./out/cxcc-suite/suite
   ./out/cxcc-suite/suite --list
   Units are tests/cxcc/units.tsv. Both drivers run every row.
   refuse: the driver exits non-zero and leaves no binary.
   compile-speed: warm -o of tests/cxhost_main.cx, median of 3.
   Ceilings are 30% under the old medians: gcc <= 268ms, clang <= 227ms.
   nest-header: a header included by -include changes the object.
   wide-pragma: '#pragma  unisa use' with two spaces still expands.
   file-place: __FILE__ and the error line name the .cx path.
*/
enum { CXSU_N = 24, CXSU_NAME = 32, CXSU_PATH = 160 };

static int fails;

struct unit {
    char name[CXSU_NAME];
    char path[CXSU_PATH];
    int refuse;
    int code;
};

static struct unit units[CXSU_N];
static int nunits;

static int write_text(const char *path, const char *text) {
    FILE *f;
    size_t want, n;
    f = fopen(path, "wb");
    if (!f) return -1;
    want = strlen(text);
    n = fwrite(text, 1, want, f);
    if (fclose(f) != 0) return -1;
    return n == want ? 0 : -1;
}

static void note(int ok, const char *name) {
    if (ok) printf("PASS %s\n", name);
    else { printf("FAIL %s\n", name); fails = fails + 1; }
}

static int load_units(const char *path) {
    FILE *f;
    char line[400];
    f = fopen(path, "rb");
    if (!f) { fprintf(stderr, "cxcc suite: cannot read %s\n", path); return -1; }
    while (fgets(line, (int)sizeof line, f)) {
        char *tab, *tab2, *end;
        size_t n;
        long code;
        if (line[0] == '#' || line[0] == '\n' || line[0] == 0) continue;
        n = strlen(line);
        if (n + 1 >= sizeof line && line[n - 1] != '\n') {
            fprintf(stderr, "cxcc suite: line too long in %s\n", path);
            fclose(f);
            return -1;
        }
        if (n > 0 && line[n - 1] == '\n') line[--n] = 0;
        if (n > 0 && line[n - 1] == '\r') line[--n] = 0;
        tab = strchr(line, '\t');
        tab2 = tab ? strchr(tab + 1, '\t') : 0;
        if (!tab || !tab2 || strchr(tab2 + 1, '\t') || tab == line || tab2 == tab + 1 || !tab2[1]) {
            fprintf(stderr, "cxcc suite: bad row %s\n", line);
            fclose(f);
            return -1;
        }
        if (nunits >= CXSU_N) {
            fprintf(stderr, "cxcc suite: too many units\n");
            fclose(f);
            return -1;
        }
        *tab = 0;
        *tab2 = 0;
        if (strlen(line) >= CXSU_NAME || strlen(tab + 1) >= CXSU_PATH) {
            fprintf(stderr, "cxcc suite: name or path too long\n");
            fclose(f);
            return -1;
        }
        {void *cx_kept=memcpy(units[nunits].name, line, strlen(line) + 1);(void)cx_kept;}
        {void *cx_kept=memcpy(units[nunits].path, tab + 1, strlen(tab + 1) + 1);(void)cx_kept;}
        if (!strcmp(tab2 + 1, "refuse")) {
            units[nunits].refuse = 1;
            units[nunits].code = -1;
        } else {
            code = strtol(tab2 + 1, &end, 10);
            if (end == tab2 + 1 || *end || code < 0 || code > 255) {
                fprintf(stderr, "cxcc suite: bad expect %s\n", tab2 + 1);
                fclose(f);
                return -1;
            }
            units[nunits].refuse = 0;
            units[nunits].code = (int)code;
        }
        nunits = nunits + 1;
    }
    if (fclose(f) != 0) return -1;
    if (nunits == 0) { fprintf(stderr, "cxcc suite: no units\n"); return -1; }
    return 0;
}

static int drive(const char *which, const struct unit *u) {
    char cmd[1200];
    char out[240];
    char label[80];
    char *buf = 0;
    size_t n = 0;
    int k, rc, ran, ok;
    k = snprintf(out, sizeof out, "out/cxcc-suite/%s-%s", which, u->name);
    if (k < 0 || k >= (int)sizeof out) return 0;
    unlink(out);
    k = snprintf(cmd, sizeof cmd, "sh ./%s_cx.com %s -o %s", which, u->path, out);
    if (k < 0 || k >= (int)sizeof cmd) return 0;
    rc = cx_run_timeout(cmd, 40, &buf, &n);
    free(buf);
    buf = 0;
    if (u->refuse) ok = rc != 0 && rc != 124 && access(out, F_OK) != 0;
    else if (rc != 0) ok = 0;
    else {
        k = snprintf(cmd, sizeof cmd, "./%s", out);
        if (k < 0 || k >= (int)sizeof cmd) return 0;
        ran = cx_run_timeout(cmd, 10, &buf, &n);
        free(buf);
        ok = ran == u->code;
    }
    k = snprintf(label, sizeof label, "%s %s", which, u->name);
    if (k < 0 || k >= (int)sizeof label) return 0;
    note(ok, label);
    return ok;
}

static int include_fresh(const char *which) {
    char cmd[1400];
    char *buf = 0;
    size_t n = 0;
    int k, rc, ran;
    const char *modp = "out/cxcc-suite/incmod.cx";
    const char *mainp = "out/cxcc-suite/incmain.cx";
    const char *hdr = "out/cxcc-suite/extra.h";
    const char *out = "out/cxcc-suite/incbin";
    if (write_text(modp, "#pragma unisa module incmod\nint cxcc_inc_anchor(void) { return 1; }\n")) return 0;
    if (write_text(mainp, "#pragma unisa use incmod\nint main(void) { return EXTRA_VALUE + cxcc_inc_anchor(); }\n")) return 0;
    if (write_text(hdr, "#define EXTRA_VALUE 7\n")) return 0;
    unlink(out);
    k = snprintf(cmd, sizeof cmd, "sh ./%s_cx.com %s -include %s -o %s", which, mainp, hdr, out);
    if (k < 0 || k >= (int)sizeof cmd) return 0;
    rc = cx_run_timeout(cmd, 40, &buf, &n);
    free(buf);
    buf = 0;
    if (rc != 0) return 0;
    k = snprintf(cmd, sizeof cmd, "./%s", out);
    if (k < 0 || k >= (int)sizeof cmd) return 0;
    ran = cx_run_timeout(cmd, 10, &buf, &n);
    free(buf);
    buf = 0;
    if (ran != 8) return 0;
    if (write_text(hdr, "#define EXTRA_VALUE 11\n")) return 0;
    unlink(out);
    k = snprintf(cmd, sizeof cmd, "sh ./%s_cx.com %s -include %s -o %s", which, mainp, hdr, out);
    if (k < 0 || k >= (int)sizeof cmd) return 0;
    rc = cx_run_timeout(cmd, 40, &buf, &n);
    free(buf);
    buf = 0;
    if (rc != 0) return 0;
    k = snprintf(cmd, sizeof cmd, "./%s", out);
    if (k < 0 || k >= (int)sizeof cmd) return 0;
    ran = cx_run_timeout(cmd, 10, &buf, &n);
    free(buf);
    return ran == 12;
}

static int compile_bin(const char *which, const char *src, const char *extra, const char *out) {
    char cmd[1600];
    int k, rc;
    unlink(out);
    k = snprintf(cmd, sizeof cmd, "sh ./%s_cx.com %s %s -o %s", which, src, extra, out);
    if (k < 0 || k >= (int)sizeof cmd) return -1;
    rc = cx_run_timeout(cmd, 40, 0, 0);
    return rc;
}

static int run_bin(const char *out) {
    char cmd[240];
    int k;
    k = snprintf(cmd, sizeof cmd, "./%s", out);
    if (k < 0 || k >= (int)sizeof cmd) return -1;
    return cx_run_timeout(cmd, 10, 0, 0);
}

static int nest_header(const char *which) {
    const char *dep = "out/cxcc-suite/nestdep.cx";
    const char *mainp = "out/cxcc-suite/nestmain.cx";
    const char *top = "out/cxcc-suite/top.h";
    const char *nested = "out/cxcc-suite/nested.h";
    const char *out = "out/cxcc-suite/nestbin";
    char extra[240];
    int k, rc;
    if (write_text(dep, "#pragma unisa module nestdep\nint nestdep_n(void) { return 1; }\n")) return 0;
    if (write_text(mainp, "#pragma unisa use nestdep\nint main(void) { return REVIEW_VALUE + nestdep_n(); }\n")) return 0;
    if (write_text(top, "#include \"nested.h\"\n")) return 0;
    if (write_text(nested, "#define REVIEW_VALUE 7\n")) return 0;
    k = snprintf(extra, sizeof extra, "-include %s", top);
    if (k < 0 || k >= (int)sizeof extra) return 0;
    rc = compile_bin(which, mainp, extra, out);
    if (rc != 0 || run_bin(out) != 8) return 0;
    if (write_text(nested, "#define REVIEW_VALUE 11\n")) return 0;
    rc = compile_bin(which, mainp, extra, out);
    if (rc != 0) return 0;
    return run_bin(out) == 12;
}

static int wide_pragma(const char *which) {
    const char *dep = "out/cxcc-suite/wsdep.cx";
    const char *mainp = "out/cxcc-suite/wsmain.cx";
    const char *out = "out/cxcc-suite/wsbin";
    int rc;
    if (write_text(dep, "#pragma unisa module wsdep\nint wsdep_n(void) { return 7; }\n")) return 0;
    if (write_text(mainp, "#pragma  unisa use wsdep\nint main(void) { return wsdep_n(); }\n")) return 0;
    rc = compile_bin(which, mainp, "", out);
    if (rc != 0) return 0;
    return run_bin(out) == 7;
}

static int file_place(const char *which) {
    const char *dep = "out/cxcc-suite/iddep.cx";
    const char *src = "out/cxcc-suite/fileid.cx";
    const char *bad = "out/cxcc-suite/filebad.cx";
    const char *out = "out/cxcc-suite/fileidbin";
    const char *errp = "out/cxcc-suite/filebad.err";
    const char *cap = "out/cxcc-suite/fileid.out";
    char cmd[1600];
    char *text = 0;
    size_t n = 0;
    int k, rc;
    if (write_text(dep, "#pragma unisa module iddep\nint iddep_n(void) { return 1; }\n")) return 0;
    if (write_text(src, "#pragma unisa use iddep\nint main(void) { fputs(__FILE__, stdout); return iddep_n() == 1 ? 0 : 2; }\n")) return 0;
    rc = compile_bin(which, src, "", out);
    if (rc != 0) return 0;
    k = snprintf(cmd, sizeof cmd, "./%s >%s", out, cap);
    if (k < 0 || k >= (int)sizeof cmd) return 0;
    if (cx_run_timeout(cmd, 10, 0, 0) != 0) return 0;
    text = cx_read(cap, &n);
    if (!text) return 0;
    rc = n == strlen(src) && memcmp(text, src, n) == 0;
    free(text);
    if (!rc) return 0;
    if (write_text(bad, "#pragma unisa use iddep\nint main(void) { return not_declared_zz(1); }\n")) return 0;
    k = snprintf(cmd, sizeof cmd, "sh ./%s_cx.com %s -o %s >%s 2>&1", which, bad, out, errp);
    if (k < 0 || k >= (int)sizeof cmd) return 0;
    if (cx_run_timeout(cmd, 40, 0, 0) == 0) return 0;
    text = cx_read(errp, &n);
    if (!text) return 0;
    rc = strstr(text, bad) != 0 && strstr(text, ":2:") != 0;
    free(text);
    return rc;
}

static long long median3(long long a, long long b, long long c) {
    long long t;
    if (a > b) { t = a; a = b; b = t; }
    if (b > c) { t = b; b = c; c = t; }
    if (a > b) { t = a; a = b; b = t; }
    return b;
}

static int compile_speed(const char *which, int limit_ms) {
    char cmd[1600];
    char out[80];
    long long sample[3];
    long long med, limit;
    char *buf;
    char *end;
    size_t n;
    int k, t, rc, compile_rc;
    k = snprintf(out, sizeof out, "out/cxcc-suite/perf-%s", which);
    if (k < 0 || k >= (int)sizeof out) return 0;
    k = snprintf(cmd, sizeof cmd, "sh ./%s_cx.com tests/cxhost_main.cx -o %s >/dev/null 2>&1",
                 which, out);
    if (k < 0 || k >= (int)sizeof cmd) return 0;
    if (cx_run_timeout(cmd, 20, 0, 0) != 0) return 0;
    for (t = 0; t < 3; t++) {
        buf = 0;
        n = 0;
        k = snprintf(cmd, sizeof cmd,
            "s=$(date +%%s%%N); sh ./%s_cx.com tests/cxhost_main.cx -o %s >/dev/null 2>&1; "
            "rc=$?; e=$(date +%%s%%N); printf '%%s %%s\\n' \"$rc\" \"$((e-s))\"",
            which, out);
        if (k < 0 || k >= (int)sizeof cmd) return 0;
        rc = cx_run_timeout(cmd, 20, &buf, &n);
        if (rc != 0 || !buf) { free(buf); return 0; }
        compile_rc = (int)strtol(buf, &end, 10);
        if (end == buf || *end != ' ') { free(buf); return 0; }
        sample[t] = strtoll(end + 1, &end, 10);
        free(buf);
        if (compile_rc != 0 || sample[t] < 0) return 0;
    }
    med = median3(sample[0], sample[1], sample[2]);
    limit = (long long)limit_ms * 1000000LL;
    printf("TIME %s compile-speed median=%lldms limit=%dms\n",
           which, med / 1000000LL, limit_ms);
    return med <= limit;
}

int main(int argc, char **argv) {
    int i;
    if (load_units("tests/cxcc/units.tsv") != 0) return 2;
    if (argc > 1 && !strcmp(argv[1], "--list")) {
        for (i = 0; i < nunits; i++) {
            if (units[i].refuse) printf("%s\t%s\trefuse\n", units[i].name, units[i].path);
            else printf("%s\t%s\t%d\n", units[i].name, units[i].path, units[i].code);
        }
        printf("include-bytes\tout/cxcc-suite/extra.h\t8-then-12\n");
        printf("nest-header\tout/cxcc-suite/nested.h\t8-then-12\n");
        printf("wide-pragma\tout/cxcc-suite/wsmain.cx\t7\n");
        printf("file-place\tout/cxcc-suite/fileid.cx\tpath-and-line-2\n");
        printf("compile-speed\ttests/cxhost_main.cx\tgcc<=268ms clang<=227ms\n");
        return 0;
    }
    if (argc > 1) {
        fprintf(stderr, "cxcc suite: usage: suite [--list]\n");
        return 2;
    }
    if (access("gcc_cx.com", F_OK) != 0 || access("clang_cx.com", F_OK) != 0) {
        fprintf(stderr, "cxcc suite: run from the repo root, where gcc_cx.com and clang_cx.com are\n");
        return 2;
    }
    if (cx_run("mkdir -p out/cxcc-suite", 0, 0) != 0) {
        fprintf(stderr, "cxcc suite: cannot make out/cxcc-suite\n");
        return 2;
    }
    for (i = 0; i < nunits; i++) {
        drive("gcc", &units[i]);
        drive("clang", &units[i]);
    }
    note(include_fresh("gcc"), "gcc include-bytes");
    note(include_fresh("clang"), "clang include-bytes");
    note(nest_header("gcc"), "gcc nest-header");
    note(nest_header("clang"), "clang nest-header");
    note(wide_pragma("gcc"), "gcc wide-pragma");
    note(wide_pragma("clang"), "clang wide-pragma");
    note(file_place("gcc"), "gcc file-place");
    note(file_place("clang"), "clang file-place");
    note(compile_speed("gcc", 268), "gcc compile-speed");
    note(compile_speed("clang", 227), "clang compile-speed");
    printf("CXCC units=%d drivers=2 fails=%d\n", nunits, fails);
    return fails ? 1 : 0;
}
