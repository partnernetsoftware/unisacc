#!/usr/bin/env unisacc.com
/* Single-stream development containers, not a release/compiler PASS.
 * Default-run: FILE.cx -- BASE_COM CANDIDATE_PKG NEW_OUTDIR.
 * Strict canonical P3 directory/extents, original compressed M records and all
 * resource records are carried byte-for-byte. No model inflation/construction.
 * model_sha256 is explicitly SHA of compressed payload, not decoded weights.
 * Caller supplies the stream-aware base runner; this tool does not prove its ABI.
 * Metadata schema2 uses stream_units_in_source and per-entry stream_unit;
 * binary P3/UNIPKG1 payload bytes retain their existing contract.
 * Failure leaves a NEW_OUTDIR partial generation for inspection, never deletes.
 */
#include <fcntl.h>
static void fail(const char *s){fprintf(stderr,"stream-pack: REFUSE %s\n",s);exit(2);}
static void *mem(size_t n){void *p=malloc(n?n:1);if(!p)fail("allocation");return p;}
static void put(int fd,const void *v,size_t n){const char *p=v;while(n){ssize_t k=write(fd,p,n);if(k>0){p+=k;n-=(size_t)k;}else if(k<0&&errno==EINTR)continue;else fail("write failed (partial output preserved)");}}
static void saved(const char *path,const void *p,size_t n,int mode){int fd=open(path,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,mode);if(fd<0)fail("exclusive output create");put(fd,p,n);if(fsync(fd)||close(fd))fail("output fsync/close");}
static char *load(const char *p,size_t *n){struct stat s;char *b;if(lstat(p,&s)||!S_ISREG(s.st_mode)||s.st_size<=0||s.st_size>268435456)fail("input must be nonempty bounded regular file, no symlink");b=cx_read(p,n);if(!b||(size_t)s.st_size!=*n)fail("input read/size changed");return b;}
typedef struct{char *route,*name,*in,*out;int idx;} StreamUnit;
typedef struct{size_t at,bytes,data,compressed;unsigned long long raw,crc;} Model;
static char *PK;static size_t PN,POS;static char LINE[2048];
static int line(char **v,int max){size_t s=POS,k;int n=0;if(POS>=PN)fail("missing header line");while(POS<PN&&PK[POS]!='\n'){if(PK[POS]<32||PK[POS]>126)fail("non-ASCII header");POS++;}if(POS>=PN||POS-s>=sizeof LINE)fail("truncated/large header");k=POS-s;memcpy(LINE,PK+s,k);LINE[k]=0;POS++;if(!k||LINE[0]==' '||LINE[k-1]==' ')fail("empty/padded header");v[n++]=LINE;for(s=0;s<k;s++)if(LINE[s]==' '){LINE[s]=0;if(!LINE[s+1]||LINE[s+1]==' '||n==max)fail("bad header spacing/fields");v[n++]=LINE+s+1;}return n;}
static unsigned long long num(const char *s,unsigned long long limit){unsigned long long x=0;int d;if(!*s)fail("empty integer");while(*s){d=*s-'0';if(d<0||d>9||(unsigned long long)d>limit||x>(limit-(unsigned long long)d)/10)fail("integer extent/range");x=x*10+(unsigned)d;s++;}return x;}
static char *word(const char *s){const char *p=s;char *b;if(!*p)fail("empty name");while(*p){if(!((*p>='a'&&*p<='z')||(*p>='A'&&*p<='Z')||(*p>='0'&&*p<='9')||*p=='_'||*p=='-'||*p=='.'||*p=='/'))fail("invalid package name");p++;}b=mem(strlen(s)+1);strcpy(b,s);return b;}
static const char *NAMES[]={"e2","e1","e3","e4","prune","lower","elf"};
int main(int argc,char **argv){char *base,*v[8],*body,*image;size_t bn,resource_at,resource_n,*rk,*rl,base2n,pkg2n;char path[4096],head[512],footer[16],report[8192],basehash[65],pkghash[65],sourcehash[65],reshash[65],modelhash[65],blockhash[65],pkgsha[65],comsha[65],verifyhash[65];int pm,ps,nr,i,j,k,n,selected[7],rfd,used=0;StreamUnit *st;Model *m;size_t outn,hn,ip;unsigned long long len,keylen,datalen;
 if(argc==5&&!strcmp(argv[1],"--")){argc--;argv++;}if(argc!=4)fail("usage BASE_COM CANDIDATE_PKG NEW_OUTDIR");
 base=load(argv[1],&bn);PK=load(argv[2],&PN);cx_sha256_hex(PK,PN,sourcehash);if(PN<2||PK[0]!='P'||PK[1]!=' '){unsigned long long extent=0;int z;char *container=PK;if(PN<16||memcmp(PK+PN-16,"UNIPKG1\n",8))fail("input is neither P3 nor unsigned terminal-footer product");for(z=7;z>=0;z--)extent=(extent<<8)|(unsigned char)PK[PN-8+z];if(!extent||extent>PN-16)fail("product package footer extent");PK=mem((size_t)extent);memcpy(PK,container+PN-16-(size_t)extent,(size_t)extent);free(container);PN=(size_t)extent;}if(bn<64||(!(!memcmp(base,"\177ELF",4))&&memcmp(base,"MZ",2)))fail("base must be a bounded ELF/APE runner");if(bn>=16&&!memcmp(base+bn-16,"UNIPKG1\n",8))fail("base already has a package; supply bare runner");cx_sha256_hex(base,bn,basehash);cx_sha256_hex(PK,PN,pkghash);
 n=line(v,8);if(n!=5||strcmp(v[0],"P")||strcmp(v[1],"3"))fail("requires canonical standalone P3");pm=(int)num(v[2],PN/8);ps=(int)num(v[3],PN/10);nr=(int)num(v[4],PN/5);if(pm<1||ps<1||pm>65536||ps>65536||nr>65536)fail("invalid/oversize counts");st=mem((size_t)ps*sizeof(StreamUnit));m=mem((size_t)pm*sizeof(Model));rk=mem((size_t)nr*sizeof(size_t));rl=mem((size_t)nr*sizeof(size_t));for(k=0;k<7;k++)selected[k]=-1;
 for(i=0;i<ps;i++){n=line(v,8);if(n!=6||strcmp(v[0],"D"))fail("stream fields");st[i].route=word(v[1]);st[i].name=word(v[2]);st[i].in=word(v[3]);st[i].out=word(v[4]);st[i].idx=(int)num(v[5],(unsigned long long)pm-1);
 for(j=i-1;j>=0;j--)if(!strcmp(st[i].route,st[j].route)){if(!strcmp(st[i].name,st[j].name))fail("duplicate route/stream");}
 for(j=i-1;j>=0;j--)if(!strcmp(st[i].route,st[j].route)){if(strcmp(st[j].out,st[i].in))fail("route format mismatch");break;}
 if(!strcmp(st[i].route,"lnx/x86_64/image/O2")){int found=0;for(k=0;k<7;k++)if(!strcmp(st[i].name,NAMES[k])){if(selected[k]>=0)fail("duplicate selected stream");selected[k]=i;found=1;}
 if(!found&&strcmp(st[i].name,"tapecheck"))fail("unexpected selected-route stream");}}
 for(k=0;k<7;k++){if(selected[k]<0)fail("missing selected stream");if(k&&selected[k]<=selected[k-1])fail("selected stream order");for(j=0;j<k;j++)if(st[selected[k]].idx==st[selected[j]].idx)fail("selected streams reuse model index");}
 for(i=0;i<pm;i++){m[i].at=POS;n=line(v,8);if(n!=5||strcmp(v[0],"M"))fail("model header");len=num(v[1],PN);m[i].raw=num(v[2],2147483647);if(!len||!m[i].raw||strcmp(v[3],"1"))fail("compressed model length/codec");m[i].crc=num(v[4],4294967295ULL);if(len>PN-POS)fail("compressed model truncated");m[i].data=POS;m[i].compressed=(size_t)len;POS+=(size_t)len;m[i].bytes=POS-m[i].at;
 for(j=0;j<i;j++)if(m[i].compressed==m[j].compressed&&m[i].raw==m[j].raw&&m[i].crc==m[j].crc&&!memcmp(PK+m[i].data,PK+m[j].data,m[i].compressed))fail("duplicate model block");}
 resource_at=POS;for(i=0;i<nr;i++){n=line(v,8);if(n!=3||strcmp(v[0],"F"))fail("resource header");keylen=num(v[1],PN);datalen=num(v[2],PN);if(!keylen||keylen>PN-POS||datalen>PN-POS-(size_t)keylen)fail("resource truncated");rk[i]=POS;rl[i]=(size_t)keylen;for(j=0;j<i;j++)if(rl[j]==rl[i]&&!memcmp(PK+rk[j],PK+POS,rl[i]))fail("duplicate resource key");POS+=(size_t)keylen+(size_t)datalen;}if(POS!=PN)fail("trailing package bytes");resource_n=PN-resource_at;cx_sha256_hex(PK+resource_at,resource_n,reshash);
 /* Re-read both identities before any output: rejects changed inputs. */
 {char *b=load(argv[1],&base2n);cx_sha256_hex(b,base2n,verifyhash);free(b);if(strcmp(verifyhash,basehash))fail("base changed");b=load(argv[2],&pkg2n);cx_sha256_hex(b,pkg2n,verifyhash);free(b);if(strcmp(verifyhash,sourcehash))fail("package changed");}
 if(mkdir(argv[3],0700))fail("NEW_OUTDIR must not exist and must be creatable");
 used=snprintf(report,sizeof report,"{\n \"schema\":2,\"scope\":\"seven-single-stream-development-containers\",\"release_eligible\":false,\n \"source_package_sha256\":\"%s\",\"base_sha256\":\"%s\",\"resources\":%d,\"resource_section_sha256\":\"%s\",\n \"models_in_source\":%d,\"stream_units_in_source\":%d,\"tapecheck_included\":false,\n \"streams\":[\n",pkghash,basehash,nr,reshash,pm,ps);
 for(k=0;k<7;k++){StreamUnit *s=&st[selected[k]];Model *a=&m[s->idx];int h=snprintf(head,sizeof head,"P 3 1 1 %d\nD stream %s %s %s 0\n",nr,s->name,s->in,s->out);if(h<0||(size_t)h>=sizeof head)fail("output header capacity");hn=(size_t)h;outn=hn+a->bytes+resource_n;body=mem(outn);memcpy(body,head,hn);memcpy(body+hn,PK+a->at,a->bytes);memcpy(body+hn+a->bytes,PK+resource_at,resource_n);cx_sha256_hex(body,outn,pkgsha);cx_sha256_hex(PK+a->data,a->compressed,modelhash);cx_sha256_hex(PK+a->at,a->bytes,blockhash);
 image=mem(bn+outn+16);memcpy(image,base,bn);memcpy(image+bn,body,outn);memcpy(footer,"UNIPKG1\n",8);len=outn;for(j=0;j<8;j++){footer[8+j]=(char)(len&255);len>>=8;}memcpy(image+bn+outn,footer,16);cx_sha256_hex(image,bn+outn+16,comsha);
 if(snprintf(path,sizeof path,"%s/unisacc-stream%d.com",argv[3],k+1)>=(int)sizeof path)fail("output path too long");saved(path,image,bn+outn+16,0700);
 ip=(size_t)snprintf(report+used,sizeof report-(size_t)used,"  %s{\"stream_unit\":\"%s\",\"file\":\"unisacc-stream%d.com\",\"original_model_index\":%d,\"input\":\"%s\",\"output\":\"%s\",\"compressed_model_sha256\":\"%s\",\"original_M_record_sha256\":\"%s\",\"package_sha256\":\"%s\",\"com_sha256\":\"%s\",\"package_bytes\":%lu,\"com_bytes\":%lu}\n",k?",":"",s->name,k+1,s->idx,s->in,s->out,modelhash,blockhash,pkgsha,comsha,(unsigned long)outn,(unsigned long)(bn+outn+16));if(ip>=sizeof report-(size_t)used)fail("receipt capacity");used+=(int)ip;free(image);free(body);}
 if((size_t)used+6>=sizeof report)fail("receipt suffix capacity");memcpy(report+used," ]\n}\n",5);used+=5;
 if(snprintf(path,sizeof path,"%s/streams.json",argv[3])>=(int)sizeof path)fail("receipt path too long");saved(path,report,(size_t)used,0600);rfd=open(argv[3],O_RDONLY|O_DIRECTORY|O_CLOEXEC);if(rfd<0||fsync(rfd)||close(rfd))fail("directory fsync/close");put(1,report,(size_t)used);return 0;}
