/* Frozen-commit ratchet checks for release-run --prepare: check the real replay
 * verdict, the source identity and all fifteen rows against the release evidence.
 * The checker and command are prepared materials. Run the checker on every
 * invocation with inherited output and process group under run-batch's bound. */
#pragma unisa use sys.proc
int main(int argc, char **argv) {
    if (argc != 5 || argv[1][0] != '/' || argv[4][0] != '/') return 2;
    sy_spawn_t opt;
    sy_child_t child;
    sy_exit_t status;
    sy_spawn_init(&opt);
    opt.argv = argv + 1;
    opt.deadline_ms = 55000;
    if (sy_proc_spawn(&opt, &child) || sy_proc_wait(&child, &status)) return 2;
    return sy_exit_code(&status);
}
