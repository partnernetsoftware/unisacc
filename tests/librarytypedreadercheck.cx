#include <cx.h>
#include <stdint.h>
/* Reader-only contract witness. The native executor is observation tooling. */
static int puthex(const char*p,const char*s){if(!strcmp(s,"-"))return cx_write(p,"",0);size_t n=strlen(s);if(n%2)return 1;unsigned char*b=malloc(n/2+1);for(size_t i=0;i<n;i+=2){unsigned v;if(sscanf(s+i,"%2x",&v)!=1)return 1;b[i/2]=v;}int rc=cx_write(p,b,n/2);free(b);return rc;}
static uint64_t word(const char*p){uint64_t n=0;for(int i=0;i<8;i++)n|=(uint64_t)(unsigned char)p[i]<<(8*i);return n;}
static int same(const char*a,const char*b){size_t an,bn;char*x=cx_read(a,&an),*y=cx_read(b,&bn);if(!x||!y)return 2;int rc=an!=bn||memcmp(x,y,an);printf("artifact base=%s bytes=%zu off=%s bytes=%zu byte_equal=%d\n",a,an,b,bn,!rc);free(x);free(y);return rc;}
static int baseline(const char*p){size_t n;char*b=cx_read(p,&n);const char*old="call\tlibrarytypedimports\t-\t-\t-\t-\t-\tstart=$start\t-";const char*rep="rows\tlibrarycontractimports\tmain\t-\t-\t-\t-\tstart=$start\t-";if(!b)return 2;char*q=strstr(b,old);if(!q||strstr(q+strlen(old),old))return 1;size_t pre=q-b,tail=n-pre-strlen(old),nn=pre+strlen(rep)+tail;char*out=malloc(nn+1);out[nn]=0;memcpy(out,b,pre);memcpy(out+pre,rep,strlen(rep));memcpy(out+pre+strlen(rep),q+strlen(old),tail);const char*hook="call\tlibrarytypedwrap\t-\tfact:librarytyped\t-\t-\t-\t-\t-\n";char*h=strstr(out,hook);if(h){size_t off=h-out,hn=strlen(hook);memmove(h,h+hn,nn-off-hn);nn-=hn;}int rc=cx_write(p,out,nn);free(out);free(b);return rc;}
int main(int argc,char**argv){if(argc==6&&!strcmp(argv[1],"--refusal")){size_t on,en;char*o=cx_read(argv[2],&on),*e=cx_read(argv[3],&en);int rc=atoi(argv[4]);int bad=rc!=1||!o||on||!e||!strstr(e,argv[5]);free(o);free(e);if(!bad)puts("parse2base check: named refusal rc1 and empty stdout");return bad;}if(argc==4&&!strcmp(argv[1],"--same"))return same(argv[2],argv[3]);if(argc==3&&!strcmp(argv[1],"--baseline"))return baseline(argv[2]);if(argc!=2)return 2;char path[9][4096],cmd[24576],cases[4096];const char*names[]={"tokens","attributes","contract","selection","mode","oracle","out","err","expected"};for(int i=0;i<9;i++)snprintf(path[i],4096,"%s/%s",argv[1],names[i]);snprintf(cases,4096,"%s/cases.tsv",argv[1]);size_t alln;char*all=cx_read(cases,&alln);if(!all)return 2;int accepted=0,refused=0,checks=0;char*p=all;while(*p){char*end=strchr(p,'\n');if(!end)return 2;*end=0;if(*p=='#'){p=end+1;continue;}char*f[10];f[0]=p;int nf=1;for(char*q=p;*q;q++)if(*q=='\t'){*q=0;if(nf==10)return 2;f[nf++]=q+1;}if(nf!=10)return 2;for(int i=0;i<5;i++)if(puthex(path[i],f[i+1]))return 2;if(puthex(path[8],f[9]))return 2;snprintf(cmd,sizeof cmd,"python3 -m unisa.librarytypedreader '%s' '%s' '%s' '%s' '%s' >'%s' 2>'%s'",path[2],path[3],path[4],f[6],path[0],path[5],path[7]);int rr=cx_run_timeout(cmd,3,0,0);if(rr!=0&&rr!=1){printf("%s oracle %s rc=%d (not refusal)\n",rr==124||rr==142?"HOST_TIMEOUT":"MECHANISM",f[0],rr);return rr==124||rr==142?142:2;}if(rr!=atoi(f[7])){printf("CONTRACT_RED %s oracle rc=%d\n",f[0],rr);return 1;}size_t on,wn;char*ob=cx_read(path[5],&on),*want=cx_read(path[8],&wn);if(!ob||!want)return 2;if(!rr&&(on!=wn||memcmp(ob,want,wn))){printf("CONTRACT_RED %s live/frozen oracle\n",f[0]);return 1;}if(rr&&strstr(f[8],"arity")){size_t ern;char*er=cx_read(path[7],&ern);if(on||!er||!strstr(er,f[8])){free(er);return 1;}free(er);}free(ob);char*first=NULL;size_t firstn=0;for(int pass=0;pass<4;pass++){const char*model=pass%2?"model.tbl":"model.net",*provider=pass>=2?"B":"A";snprintf(cmd,sizeof cmd,"env READER_OBSERVATION_TAG=%s TMPDIR='%s/%s' '%s/runner' '%s/%s' '%s' '%s' '%s' '%s' '%s' %s >'%s' 2>'%s'",provider,argv[1],provider,argv[1],argv[1],model,path[0],path[2],path[3],path[1],path[4],provider,path[6],path[7]);int rc=cx_run_timeout(cmd,3,0,0);if(rc!=0&&rc!=1){printf("%s model %s rc=%d (not refusal)\n",rc==124||rc==142?"HOST_TIMEOUT":"MECHANISM",f[0],rc);return rc==124||rc==142?142:2;}size_t n,en;char*out=cx_read(path[6],&n),*err=cx_read(path[7],&en);if(!out||!err)return 2;if(rc!=atoi(f[7])){printf("CONTRACT_RED %s model rc=%d expected=%s :: %s\n",f[0],rc,f[7],err);return 1;}if(rc){if(n||!strstr(err,f[8])){printf("CONTRACT_RED %s named refusal\n",f[0]);return 1;}}else{if(n<32||memcmp(out,"USTFLOW2",8)||word(out+8)!=n-32||word(out+16)||word(out+24)){printf("CONTRACT_RED %s reader stream framing/old side\n",f[0]);return 1;}if(wn){if(n<32+wn||memcmp(out+n-wn,want,wn)){printf("CONTRACT_RED %s reader metadata wrapper\n",f[0]);return 1;}}else if(strstr(out+32,"  .frame 72\n")||strstr(out+32,".libraryfn")){printf("CONTRACT_RED %s unused/defined emitted wrapper\n",f[0]);return 1;}if(!pass){first=malloc(n);memcpy(first,out,n);firstn=n;}else if(n!=firstn||memcmp(first,out,n)){printf("CONTRACT_RED %s table/net/provider observations differ\n",f[0]);return 1;}}free(out);free(err);checks++;}free(first);free(want);if(atoi(f[7]))refused++;else accepted++;p=end+1;}free(all);if(!accepted||!refused)return 1;printf("librarytypedreader PASS accepted=%d refused=%d observations=%d; reader+overlay narrow witness, lower/binding/P1-P6 unproved\n",accepted,refused,checks);return 0;}
