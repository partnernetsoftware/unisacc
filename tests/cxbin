#!/bin/sh
# cxbin FILE.cx [ARG...] -- run a .cx program through a per-user cache of its compiled binary (2026-10-23).
# `sh unisacc.com -run FILE.cx -- ARG...` compiles on every call (about 3.4 s for tests/shipclassify.cx, whose run
# is 2 ms); the commit path (release/tools/commitgate.sh, release/tools/hooks/pre-commit) calls its classifier on
# every commit and tests/commitgatecheck.sh calls commitgate.sh about thirty times, so the compile is done once per
# (compiler, source, machine): `sh unisacc.com -o BIN FILE.cx`, keyed by the sha256 of unisacc.com (the one beside
# this tests/ directory), FILE.cx and uname -m.  The binary gets ARG... as its argv and the caller's stdin, stdout
# and stderr; its exit status is the result.  Fail closed: a missing FILE.cx or unisacc.com, a cache directory that
# is not ours, or a failed compile is rc 2 with one `cxbin: ...` line on stderr, and nothing is run.
# The cache is ${CXBIN_CACHE:-${TMPDIR:-/tmp}/unisacc-cxbin-UID} (mode 0700; the same trust as tests/bound's).
set -eu
case "$0" in
    */*) directory=${0%/*} ;;
    *) directory=. ;;
esac
here=$(CDPATH= cd -- "$directory" && pwd)
com=$here/../unisacc.com
[ $# -ge 1 ] || { echo 'cxbin: usage: cxbin FILE.cx [ARG...]' >&2; exit 2; }
src=$1; shift
[ -f "$src" ] || { echo "cxbin: no such source: $src" >&2; exit 2; }
[ -f "$com" ] || { echo "cxbin: no compiler: $com" >&2; exit 2; }
if [ -x /usr/bin/openssl ]; then hashcmd=/usr/bin/openssl; else hashcmd=openssl; fi
digest=$({ uname -m; cat "$com" "$src"; } | "$hashcmd" dgst -sha256) || { echo 'cxbin: cannot hash the inputs' >&2; exit 2; }
key=${digest##* }
case "$key" in *[!0123456789abcdef]*|'') echo 'cxbin: invalid cache digest' >&2; exit 2;; esac
cache=${CXBIN_CACHE:-${TMPDIR:-/tmp}/unisacc-cxbin-$(id -u)}
[ -d "$cache" ] || mkdir -m 700 -p "$cache" 2>/dev/null || [ -d "$cache" ] || { echo "cxbin: cannot create $cache" >&2; exit 2; }
{ [ ! -L "$cache" ] && [ -O "$cache" ]; } || { echo "cxbin: $cache is not a directory owned by this user (refused)" >&2; exit 2; }
bin=$cache/$key
if [ ! -x "$bin" ]; then
    temporary=$cache/.$key.$$
    trap 'rm -f "$temporary"' EXIT HUP INT TERM
    # stdin is the caller's (the hook pipes paths to the program): the compile must not read it
    if ! sh "$com" -o "$temporary" "$src" < /dev/null >&2 || [ ! -s "$temporary" ]; then
        echo "cxbin: compiling $src failed" >&2; exit 2
    fi
    chmod 700 "$temporary" && mv -f "$temporary" "$bin" || { echo "cxbin: cannot install $bin" >&2; exit 2; }
    trap - EXIT HUP INT TERM
fi
exec "$bin" "$@"
