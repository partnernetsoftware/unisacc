/* driver-environment.cx -- runs tools/check-driver-environment.cx fresh with CXE_TEST set through env(1),
   because tests/run-batch.cx passes no environment of its own.  The check walks the borrowed process
   environment through cx/driver/environment.cx and needs exactly one CXE_TEST=explicit-value entry.
   The control sets a wrong value and requires the check to fail.  From the repo root:
   sh ./unisacc.com tests/driver-environment.cx */
#pragma unisa use text.text
static int failed;
static void ck(int ok, const char *name) { if (!ok) failed++; printf("%s\tdriver-environment.%s\n", ok ? "PASS" : "FAIL", name); }
static int run(const char *value, char **out, size_t *n) {
    char env[64];
    char *v[] = {"env", env, "sh", "./unisacc.com", "tools/check-driver-environment.cx", 0};
    if (cx_fmt(env, sizeof env, "CXE_TEST=%s", value)) return -1;
    return cx_runv_timeout(v, 50, out, n);
}
int main(void) {
    char *out = 0, *bad = 0;
    size_t n = 0, bn = 0;
    int rc = run("explicit-value", &out, &n), brc = run("wrong", &bad, &bn);
    ck(rc == 0 && out && tx_find(out, (long)n, "marker=1\tfailed=0", 17) >= 0, "marker-seen-once");
    ck(brc == 1 && bad && tx_find(bad, (long)bn, "failed=1", 8) >= 0, "wrong-value-fails");
    printf("DRIVER_ENVIRONMENT\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
