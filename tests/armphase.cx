/* tests/armphase.cx: fixed original ARM oracle phases; only construction materials are cached.
   --all uses fixed jobs4 / original9 phases; caller retains the original40 watchdog.
   --prepare is material-only. No oracle, assertions or reference flags are replaced.
   Original external reference programs remain dependencies; execution uses the
   existing seedprep interpreter resolver bound in the material identity. */
#include <cx.h>
#include <fcntl.h>
#include <sys/file.h>
#include "cxlib/seedprep.cx"
static char*sp_dirname(const char*p){char*r=sp_xstrdup(p),*s=strrchr(r,'/');if(s)*s=0;else strcpy(r,".");return r;}
static char*arm_line(char*s,const char*m){char*found=0,*p=s;while((p=strstr(p,m))){if(p==s||p[-1]=='\n'){if(found)return 0;found=p;}p++;}return found;}
static const char*A_SH="0d3962b183093462769d785addd4c54c57380cc6446f1f2f061b794a45ec0c80",*A_PY="c98a4f8efe0704e03cf3fa386f863ccbd2e0862dd2729054a045ed53efc33114",*A_REAL="53791d3225f31f0f4987b6e492fcd6f1fd5a26fd52af131ed74520138d6790f3";
static const char*A_DIR;
static const char*ASEEDS[]={"exec/enc/armcheck.sh","exec/enc/armcheck.py","exec/enc/realcheck.py","exec/enc/armmemcheck.py","exec/enc/armbranchcheck.py","exec/enc/armintcheck.py","exec/enc/armfpcheck.py","exec/enc/arminputcheck.py","exec/enc/armlayoutcheck.py","tests/checklib.py","tests/enc/tins.py","tests/cxbin","tests/safedel.cx","tests/bound","tests/bound.c",0};
static const char*MARK[]={"        for cmd in cmds:\n","        native_host = sys.platform=='darwin' and platform.machine()=='arm64'\n","        from armmemcheck import check\n","        from armbranchcheck import check as branchcheck\n","        from armintcheck import check as intcheck\n","        from armfpcheck import check as fpcheck\n","        from arminputcheck import check as inputcheck\n","        from armlayoutcheck import check as layoutcheck\n","        if not native_host:\n","if __name__=='__main__': main()\n"};
static const char*ARM_CHECK_PARTS[]={"reference-boundary","memory","branch","integer","fp","input","layout","native","real"};
static char*arm_source;static size_t arm_n,arm_o[12];
static void arm_no(const char*s){fprintf(stderr,"ARM_PHASE REFUSED %s\n",s);exit(75);}static void arm_ck(int x,const char*s){if(!x)arm_no(s);}static char*arm_path(const char*s){return sp_pjoin(A_DIR,s);}static char*arm_hash(const char*p){char h[65];if(sp_sha_file(p,h))arm_no(p);return sp_xstrdup(h);}
static char*arm_pinned(const char*p,const char*h,size_t*n){char*b=sp_must_read(p,n),v[65];cx_sha256_hex(b,*n,v);arm_ck(!strcmp(v,h)&&!memchr(b,0,*n),p);return b;}
static void arm_partition(void){size_t n;arm_pinned("exec/enc/armcheck.sh",A_SH,&n);arm_pinned("exec/enc/realcheck.py",A_REAL,&n);arm_source=arm_pinned("exec/enc/armcheck.py",A_PY,&arm_n);arm_o[0]=0;for(int i=0;i<10;i++){char*p=arm_line(arm_source,MARK[i]);arm_ck(p!=0,"unique full-line partition marker");arm_o[i+1]=p-arm_source;arm_ck(arm_o[i+1]>arm_o[i],"ordered nonempty partition");}arm_o[11]=arm_n;sp_buf b={0,0,0};for(int i=0;i<11;i++)sp_bput(&b,arm_source+arm_o[i],arm_o[i+1]-arm_o[i]);arm_ck(b.n==arm_n&&!memcmp(b.s,arm_source,arm_n),"full original Python reconstruction");char h[65];cx_sha256_hex(b.s,b.n,h);arm_ck(!strcmp(h,A_PY),"reconstruction SHA");}
static char*arm_script(int phase){sp_buf b={0,0,0};sp_bstr(&b,"__file__='exec/enc/armcheck.py'\nimport sys\nsys.path.insert(0,'exec/enc')\n");sp_bput(&b,arm_source,arm_o[1]);if(phase==0)sp_bput(&b,arm_source+arm_o[1],arm_o[2]-arm_o[1]);sp_bput(&b,arm_source+arm_o[2],arm_o[3]-arm_o[2]);int seg=phase==7?9:phase+2;if(phase>0)sp_bput(&b,arm_source+arm_o[seg],arm_o[seg+1]-arm_o[seg]);sp_bput(&b,arm_source+arm_o[10],arm_o[11]-arm_o[10]);return b.s;}
static void arm_inspect(void){printf("shell %s Python %s real %s\n",A_SH,A_PY,A_REAL);for(int i=0;i<11;i++)printf("source_segment %d offset %lu bytes %lu\n",i,(unsigned long)arm_o[i],(unsigned long)(arm_o[i+1]-arm_o[i]));for(int i=0;i<8;i++){char*s=arm_script(i),h[65];cx_sha256_hex(s,strlen(s),h);printf("phase %s script_sha256 %s\n",ARM_CHECK_PARTS[i],h);}puts("coverage original first reference+12rejects / six independent check functions / native tail+nonDarwin SKIP / original realcheck+wc; original phase coverage retained; no execution claimed by inspect");}
static char*arm_basis(void){sp_json*b=sp_jnew(SP_JOBJ),*actors,*edges,*rs,*e=sp_jnew(SP_JOBJ);sp_actor_closure(ASEEDS,&actors,&edges);sp_oset(b,"schema",sp_jstr("armphase-original-models-v2"));sp_oset(b,"sources",sp_jstr(sp_source_digest()));sp_oset(b,"actors",actors);sp_oset(b,"edges",edges);char*cc=sp_which("cc");arm_ck(cc!=0,"cc missing");char*flags[]={"-O2",0};arm_ck(!sp_cc_read_set(cc,"exec/c/run.c",flags,&rs),"cc complete readset");sp_oset(b,"run_compile_readset",rs);sp_oset(b,"interpreter_path",sp_jstr(sp_python()));sp_oset(b,"interpreter_sha256",sp_jstr(arm_hash(sp_python())));sp_oset(b,"driver_sha",sp_jstr(arm_hash(__FILE__)));sp_oset(b,"module_sha",sp_jstr(arm_hash(sp_pjoin(sp_dirname(__FILE__),"cxlib/seedprep.cx"))));sp_oset(b,"recipe",sp_jstr("original pinned shell cc/gen/table recipe; unchanged arguments"));extern char**environ;for(int i=0;environ[i];i++){char*q=strchr(environ[i],'=');if(q&&strncmp(environ[i],"UNISACC_BOUND_DEADLINE_MONO=",strlen("UNISACC_BOUND_DEADLINE_MONO=")))sp_osetn(e,environ[i],q-environ[i],sp_jstr(q+1));}sp_oset(b,"environment_except_outer_deadline",e);sp_buf j={0,0,0};sp_jdump(&j,b,0,1);char h[65];cx_sha256_hex(j.s,j.n,h);return sp_xstrdup(h);}
static void arm_seal(const char*name,const char*basis){char*path=arm_path(name),*seal=sp_cat(path,".seal");struct stat st;arm_ck(!lstat(path,&st)&&S_ISREG(st.st_mode)&&st.st_uid==getuid(),"owned material");char text[256];int z=snprintf(text,sizeof text,"%s %s %lld\n",basis,arm_hash(path),(long long)st.st_size);int fd=open(seal,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW,0600);arm_ck(fd>=0&&write(fd,text,z)==z&&!fsync(fd)&&!close(fd),"new material seal");}
static void arm_valid(const char*name,const char*basis){char*path=arm_path(name),*seal=sp_cat(path,".seal");struct stat st;arm_ck(!lstat(path,&st)&&S_ISREG(st.st_mode)&&st.st_uid==getuid(),"material missing/type");size_t n;char*t=sp_must_read(seal,&n),want[256];snprintf(want,sizeof want,"%s %s %lld\n",basis,arm_hash(path),(long long)st.st_size);arm_ck(n==strlen(want)&&!memcmp(t,want,n),"material SHA/basis seal");}
static volatile sig_atomic_t arm_requested,arm_active_child;
static void arm_signal(int sig){arm_requested=sig;if(arm_active_child>0)kill((pid_t)arm_active_child,SIGTERM);}
static int arm_child(char**cmd){if(arm_requested)return 128+arm_requested;pid_t p=fork();arm_ck(p>=0,"fork");if(!p){signal(SIGTERM,SIG_DFL);signal(SIGINT,SIG_DFL);signal(SIGHUP,SIG_DFL);unsetenv("UNISA_CONTAINER");execvp(cmd[0],cmd);_exit(127);}arm_active_child=p;int s;pid_t w;do{w=waitpid(p,&s,0);}while(w<0&&errno==EINTR);arm_active_child=0;arm_ck(w==p,"wait");return WIFEXITED(s)?WEXITSTATUS(s):128+WTERMSIG(s);}
static const int ARM_ORDER[]={8,6,0,1,2,3,4,5,7}; /* real,layout first; every original phase once */
static int arm_permutation(const int*p){int seen[9]={0};for(int i=0;i<9;i++){if(p[i]<0||p[i]>=9||seen[p[i]])return 0;seen[p[i]]=1;}return 1;}
static int arm_started,arm_finished,arm_peak;
static double arm_now(void){struct timespec t;arm_ck(!clock_gettime(CLOCK_MONOTONIC,&t),"scheduler clock");return t.tv_sec+t.tv_nsec/1e9;}
static int arm_schedule(int(*execute)(int)){
 pid_t live[4]={0,0,0,0};int ids[4]={0,0,0,0},next=0,running=0,red=0;arm_ck(arm_permutation(ARM_ORDER),"exact original9 permutation");arm_started=arm_finished=arm_peak=0;arm_requested=arm_active_child=0;
 void(*oldterm)(int)=signal(SIGTERM,arm_signal);void(*oldint)(int)=signal(SIGINT,arm_signal);void(*oldhup)(int)=signal(SIGHUP,arm_signal);
 while(next<9||running){
  for(int k=0;k<4;k++)if(live[k]){int st;pid_t p=waitpid(live[k],&st,WNOHANG);if(p<0&&errno!=EINTR){red=red?red:1;continue;}if(p>0){int rc=WIFEXITED(st)?WEXITSTATUS(st):128+WTERMSIG(st);printf("ARM_ALL phase=%s rc=%d\n",ARM_CHECK_PARTS[ids[k]],rc);fflush(stdout);live[k]=0;running--;arm_finished++;if(rc&&!red)red=rc;}}
  if(arm_requested&&!red)red=128+arm_requested;if(red)break;
  while(running<4&&next<9&&!arm_requested){int k=0;while(k<4&&live[k])k++;arm_ck(k<4,"available worker slot");sigset_t block,previous;sigemptyset(&block);sigaddset(&block,SIGTERM);sigaddset(&block,SIGINT);sigaddset(&block,SIGHUP);arm_ck(!sigprocmask(SIG_BLOCK,&block,&previous),"fork signal block");fflush(stdout);int phase=ARM_ORDER[next];pid_t p=fork();if(p<0){sigprocmask(SIG_SETMASK,&previous,0);red=1;break;}if(!p){arm_requested=arm_active_child=0;signal(SIGTERM,arm_signal);signal(SIGINT,arm_signal);signal(SIGHUP,arm_signal);sigprocmask(SIG_SETMASK,&previous,0);int rc=execute(phase);fflush(stdout);fflush(stderr);_exit(rc&255);}live[k]=p;ids[k]=phase;next++;running++;arm_started++;if(running>arm_peak)arm_peak=running;arm_ck(!sigprocmask(SIG_SETMASK,&previous,0),"fork signal restore");}
  if(arm_requested&&!red)red=128+arm_requested;if(red)break;if(running)usleep(1000);
 }
 if(red&&running){double term=arm_now()+2.0,hard=term+1.0;for(int k=0;k<4;k++)if(live[k])kill(live[k],SIGTERM);int killed=0;
  while(running&&arm_now()<hard){if(!killed&&arm_now()>=term){for(int k=0;k<4;k++)if(live[k])kill(live[k],SIGKILL);killed=1;}for(int k=0;k<4;k++)if(live[k]){int st;pid_t p=waitpid(live[k],&st,WNOHANG);if(p==live[k]){printf("ARM_ALL drain phase=%s actual_rc=%d\n",ARM_CHECK_PARTS[ids[k]],WIFEXITED(st)?WEXITSTATUS(st):128+WTERMSIG(st));live[k]=0;running--;arm_finished++;}else if(p<0&&errno==ECHILD){live[k]=0;running--;arm_finished++;}}if(running)usleep(1000);}
  if(running){for(int k=0;k<4;k++)if(live[k])kill(live[k],SIGKILL);fprintf(stderr,"ARM_ALL drain incomplete; outer watchdog owns final subtree cleanup\n");}
 }
 signal(SIGTERM,oldterm);signal(SIGINT,oldint);signal(SIGHUP,oldhup);if(red)return red;arm_ck(arm_started==9&&arm_finished==9&&arm_peak<=4,"all9 exactly once jobs4");return 0;
}
static int arm_execute_phase(int phase){
 if(phase==8){char*v[]={"tests/bound","39",(char*)sp_python(),"exec/enc/realcheck.py",arm_path("run"),arm_path("arm.tbl"),"arm64",0};int rc=arm_child(v);if(rc)return rc;char*w[]={"tests/bound","5","wc","-c",arm_path("arm.tbl"),0};return arm_child(w);}
 char*v[]={"tests/bound","39",(char*)sp_python(),"-c",arm_script(phase),arm_path("run"),arm_path("arm.tbl"),arm_path("arm.json"),0};return arm_child(v);
}
static int arm_absent(const char*p){struct stat st;if(!lstat(p,&st))return 0;arm_ck(errno==ENOENT,"nonENOENT filesystem error");return 1;}
static void arm_regular(const char*p){struct stat st;arm_ck(!lstat(p,&st)&&S_ISREG(st.st_mode)&&st.st_uid==getuid(),"regular owner evidence required");}
static void arm_directory(const char*p){struct stat st;arm_ck(!lstat(p,&st)&&S_ISDIR(st.st_mode)&&st.st_uid==getuid()&&!(st.st_mode&0077),"owned0700 nonsymlink material directory");}
static char*arm_key_path(const char*basis){arm_ck(strlen(basis)==64,"basis length");for(int i=0;i<64;i++)arm_ck((basis[i]>='0'&&basis[i]<='9')||(basis[i]>='a'&&basis[i]<='f'),"basis hex");return sp_pjoin("out/armphase-materials",basis);}
static int arm_open_materials(const char*basis,int create){const char*parent="out/armphase-materials";A_DIR=arm_key_path(basis);if(arm_absent(parent)){arm_ck(create,"material parent missing; run --prepare");arm_ck(!mkdir(parent,0700),"new material parent");}arm_directory(parent);int fresh=arm_absent(A_DIR);if(fresh){arm_ck(create,"content-key materials absent; run --prepare");arm_ck(!mkdir(A_DIR,0700),"new content-key directory");}arm_directory(A_DIR);int flags=O_RDWR|O_NONBLOCK|O_NOFOLLOW;if(create)flags|=O_CREAT;int fd=open(arm_path("lock"),flags,0600);struct stat st;arm_ck(fd>=0&&!fstat(fd,&st)&&S_ISREG(st.st_mode)&&st.st_uid==getuid()&&!flock(fd,(create?LOCK_EX:LOCK_SH)|LOCK_NB),"material lock");
 if(fresh){int f=open(arm_path("basis"),O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW,0600);arm_ck(f>=0&&write(f,basis,64)==64&&!fsync(f)&&!close(f),"new basis record");}else{arm_regular(arm_path("basis"));size_t n;char*t=sp_must_read(arm_path("basis"),&n);arm_ck(n==64&&!memcmp(t,basis,n),"existing content-key basis mismatch");}return fd;}
static void arm_check_material(int i,const char*basis){const char*names[]={"run","arm.json","arm.tbl"};arm_regular(sp_cat(arm_path(names[i]),".seal"));arm_valid(names[i],basis);if(i==0)arm_ck(!access(arm_path("run"),X_OK),"run execute permission");}
static int arm_prepare_one(int i,const char*basis){const char*names[]={"run","arm.json","arm.tbl"};char*p=arm_path(names[i]),*seal=sp_cat(p,".seal");if(arm_absent(p)){arm_ck(arm_absent(seal),"stray seal; never repair corrupt data");if(i==2)arm_check_material(1,basis);char*run[]={"tests/bound","39","cc","-O2","-o",arm_path("run"),"exec/c/run.c",0};char*json[]={"tests/bound","39",(char*)sp_python(),"exec/build/gen.py","enc/arm",arm_path("arm.json"),0};char*tbl[]={"tests/bound","39",(char*)sp_python(),"exec/c/tbl.py",arm_path("arm.json"),arm_path("arm.tbl"),0};char**commands[]={run,json,tbl};int rc=arm_child(commands[i]);if(rc)return rc;arm_ck(!strcmp(basis,arm_basis()),"construction readset drift");arm_seal(names[i],basis);}arm_check_material(i,basis);printf("PREPARED %s only (verified content key; no verdict)\n",names[i]);return 0;}
int main(int ac,char**av){if(ac!=2){fputs("usage: tests/armphase.cx --inspect|--prepare|--all|--all-cold|prepare-init|prepare-run|prepare-json|prepare-table|reference-boundary|memory|branch|integer|fp|input|layout|native|real\n",stderr);return 2;}arm_partition();if(!strcmp(av[1],"--inspect")){arm_inspect();arm_ck(arm_permutation(ARM_ORDER),"fixed complete order");puts("fixed jobs4 order real,layout,reference-boundary,memory,branch,integer,fp,input,native");return 0;}
 int all=!strcmp(av[1],"--all")||!strcmp(av[1],"--all-cold"),prepare=!strcmp(av[1],"--prepare"),init=!strcmp(av[1],"prepare-init"),step=-1,phase=-1;const char*steps[]={"prepare-run","prepare-json","prepare-table"};for(int i=0;i<3;i++)if(!strcmp(av[1],steps[i]))step=i;for(int i=0;i<9;i++)if(!strcmp(av[1],ARM_CHECK_PARTS[i]))phase=i;if(!all&&!prepare&&!init&&step<0&&phase<0)return 2;if(all){const char*d=getenv("UNISACC_BOUND_DEADLINE_MONO");arm_ck(d&&*d,"outer native watchdog required for all");}
 unsetenv("UNISA_CONTAINER");sp_init("tests/armphase.cx");char*basis=arm_basis();int create=prepare||init||step>=0||!strcmp(av[1],"--all-cold"),fd=arm_open_materials(basis,create);printf("ARM material_key=%s directory=%s\n",basis,A_DIR);if(init){puts("PREPARED content-key directory only");return 0;}if(step>=0){int rc=arm_prepare_one(step,basis);arm_ck(!strcmp(basis,arm_basis()),"final preparation inputs changed");return rc;}if(prepare||!strcmp(av[1],"--all-cold")){for(int i=0;i<3;i++){int rc=arm_prepare_one(i,basis);if(rc)return rc;}}
 for(int i=0;i<3;i++)arm_check_material(i,basis);if(prepare){arm_ck(!strcmp(basis,arm_basis()),"final complete preparation drift");puts("PREPARED run+original JSON+table; no checker/oracle executed");return 0;}if(create)arm_ck(!flock(fd,LOCK_SH|LOCK_NB),"downgrade reader lock");int rc=all?arm_schedule(arm_execute_phase):arm_execute_phase(phase);arm_ck(!strcmp(basis,arm_basis()),"final consumer input drift");for(int i=0;i<3;i++)arm_check_material(i,basis);if(all)printf("ARM_ALL started=%d completed=%d jobs_peak=%d actual_rc=%d; original9 obligations, no verdict cache\n",arm_started,arm_finished,arm_peak,rc);else printf("ARM_PHASE %s actual_rc=%d\n",ARM_CHECK_PARTS[phase],rc);return rc;}
