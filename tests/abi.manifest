guard	library_mmap/posix	if (!active || length<=0 || (flags&MAP_FIXED)) return -EINVAL;
guard	library_mmap/windows	if(!active || length<=0 || addr<0 || fd || offset || (uint64_t)length>SIZE_MAX || (uintptr_t)addr>UINTPTR_MAX-(size_t)length || (uint64_t)prot>UINT32_MAX || (prot & ~(MEM_RESERVE|MEM_COMMIT|MEM_TOP_DOWN)) || !(prot & (MEM_RESERVE|MEM_COMMIT)) || (uint64_t)flags>UINT32_MAX) { SetLastError(ERROR_INVALID_PARAMETER);return 0; }
guard	library_munmap/posix	if (!active || length<=0 || (uintptr_t)addr>UINTPTR_MAX-(size_t)length) return -EINVAL;
guard	library_munmap/windows	if(!active || addr<=0 || length<0){SetLastError(ERROR_INVALID_PARAMETER);return -1;}
