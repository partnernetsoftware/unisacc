#!/usr/bin/env -S unisacc.com -run
/* resourceflowcheck: S step 1, the explicit-ledger strict resource flow (--strict-resource-flow --resource-ledger DIR)
   on the product, C -> Tape (-S -o), lnx/x86_64.  usage: resourceflowcheck.cx PRODUCT [BASE_PRODUCT]
   Rows: RF-LEGACY (no switch: output byte-identical to BASE_PRODUCT), CAPTURE (fixture building only), RF-POS, RF-ENV,
   RF-MISSING (named refusal, same-named disk file not read), RF-DUP, RF-LENGTH, RF-RESET, RF-ABSENT, RF-EMPTY, RF-LOWER, RF-STAGE.  Every row is a fresh
   process.  Any row that does not hold stops the run (first red).  Verdicts: PASS or FAIL; a missing base product
   makes the LEGACY row UNVERIFIED (rc 77), never a pass.  Measured scope: one program, one route, -S -o. */
#include <cx.h>
#include <dirent.h>
#define EMPTY_SHA "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" /* sha256 of zero bytes */
static int fail(const char *s) { fprintf(stderr, "resourceflowcheck FAIL: %s\n", s); return 1; }
/* sh -c CMD; CMD's exit status is written to a file and read back (cx_run's status is not reliable here) */
static int run_rc(const char *cmd, const char *rcpath) {
    char full[8192], *argv[4], *out; size_t n; char *b;
    snprintf(full, sizeof full, "%s; echo $? > '%s'", cmd, rcpath);
    argv[0] = "/bin/sh"; argv[1] = "-c"; argv[2] = full; argv[3] = 0;
    cx_runv_timeout(argv, 40, &out, &n); free(out);
    b = cx_read(rcpath, &n); if (!b) return -1;
    { int rc = atoi(b); free(b); return rc; }
}
static int same(const char *a, const char *b) { size_t na = 0, nb = 0; char *x = cx_read(a, &na), *y = cx_read(b, &nb); int eq = x && y && na == nb && !memcmp(x, y, na); free(x); free(y); return eq; }
static int size_of(const char *p) { size_t n; char *x = cx_read(p, &n); int z = x ? (int)n : -1; free(x); return z; }
static int has(const char *p, const char *s) { size_t n; char *x = cx_read(p, &n); int h = 0; if (x) { size_t m = strlen(s), i; for (i = 0; i + m <= n; i++) if (!memcmp(x + i, s, m)) { h = 1; break; } } free(x); return h; }
static int copyfile(const char *a, const char *b) { size_t n; char *x = cx_read(a, &n); if (!x) return 1; int rc = cx_write(b, x, n); free(x); return rc != 0; }
static int copydir(const char *from, const char *to) {
    DIR *d = opendir(from); struct dirent *e; char a[4096], b[4096];
    if (!d || mkdir(to, 0700)) return 1;
    while ((e = readdir(d))) {
        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
        snprintf(a, sizeof a, "%s/%s", from, e->d_name); snprintf(b, sizeof b, "%s/%s", to, e->d_name);
        if (copyfile(a, b)) { closedir(d); return 1; }
    }
    closedir(d); return 0;
}
static void row(const char *name, int ok, const char *detail) { printf("%-11s %s %s\n", name, ok ? "PASS" : "FAIL", detail); }
int main(int argc, char **argv) {
    const char *P = argc > 1 ? argv[1] : "./unisacc.com";
    const char *B = argc > 2 ? argv[2] : 0;
    char tmp[] = "/tmp/resourceflow-XXXXXX", cmd[8192], rc[4096], p[4096], p2[4096], w[4096], W[4096];
    int r, bad = 0;
    if (!mkdtemp(tmp)) return fail("temporary directory");
    snprintf(w, sizeof w, "%s/src", tmp); mkdir(w, 0700);
    snprintf(p, sizeof p, "%s/prog.c", w);
    if (cx_write(p, "long main(void){return 42;}\n", 28)) return fail("program write");
    snprintf(W, sizeof W, "%s/work", tmp); mkdir(W, 0700);
    snprintf(rc, sizeof rc, "%s/rc", tmp);
    /* RF-LEGACY: no switch; the default path matches the base product byte for byte */
    /* the default run (no switch) is the reference for every later row */
    snprintf(cmd, sizeof cmd, "cd '%s' && sh '%s' -S prog.c -o '%s/def.tape' > '%s/def.log' 2>&1", w, P, tmp, tmp);
    int dr = run_rc(cmd, rc);
    if (B) {
        snprintf(cmd, sizeof cmd, "cd '%s' && sh '%s' -S prog.c -o '%s/base.tape' > '%s/base.log' 2>&1", w, B, tmp, tmp);
        int br = run_rc(cmd, rc);
        snprintf(p, sizeof p, "%s/base.tape", tmp); snprintf(p2, sizeof p2, "%s/def.tape", tmp);
        int ok = br == 0 && dr == 0 && same(p, p2);
        row("RF-LEGACY", ok, ok ? "default output identical to base" : "default output differs or a run failed");
        if (!ok) bad++;
    } else printf("RF-LEGACY   UNVERIFIED no base product given (rc 77 class; not a pass)\n");
    /* CAPTURE (fixture building only): default answers recorded; the capture must not change the output */
    snprintf(cmd, sizeof cmd, "cd '%s' && UNISACC_RF_CAPTURE='%s/cap' sh '%s' -S prog.c -o '%s/cap.tape' > '%s/cap.log' 2>&1", w, W, P, tmp, tmp);
    snprintf(p, sizeof p, "%s/cap", W); mkdir(p, 0700);
    r = run_rc(cmd, rc);
    snprintf(p, sizeof p, "%s/cap/resources.tsv", W); snprintf(p2, sizeof p2, "%s/def.tape", tmp);
    {   char c1[4096]; snprintf(c1, sizeof c1, "%s/cap.tape", tmp);
        int ok = r == 0 && size_of(p) > 0 && same(c1, p2);
        row("CAPTURE", ok, ok ? "ledger recorded, output unchanged" : "capture failed or changed the output");
        if (!ok) { bad++; printf("first red: stop\n"); goto done; } }
    /* RF-POS: the strict run from the captured ledger reproduces the default output */
    snprintf(cmd, sizeof cmd, "cd '%s' && sh '%s' --strict-resource-flow --resource-ledger '%s/cap' -S prog.c -o '%s/strict.tape' > '%s/strict.log' 2>&1", w, P, W, tmp, tmp);
    r = run_rc(cmd, rc);
    snprintf(p, sizeof p, "%s/strict.tape", tmp); snprintf(p2, sizeof p2, "%s/def.tape", tmp);
    {   int ok = r == 0 && same(p, p2);
        snprintf(cmd, sizeof cmd, "%s/strict.log", tmp);
        ok = ok && size_of(cmd) <= 0;
        row("RF-POS", ok, ok ? "strict output == default, stderr empty" : "strict run differs or is not clean");
        if (!ok) { bad++; printf("first red: stop\n"); goto done; } }
    /* RF-ENV: new working directory, same absolute arguments */
    snprintf(p, sizeof p, "%s/newcwd", tmp); mkdir(p, 0700);
    snprintf(cmd, sizeof cmd, "cd '%s' && sh '%s' --strict-resource-flow --resource-ledger '%s/cap' -S '%s/prog.c' -o '%s/env.tape' > '%s/env.log' 2>&1", p, P, W, w, tmp, tmp);
    r = run_rc(cmd, rc);
    snprintf(p, sizeof p, "%s/env.tape", tmp); snprintf(p2, sizeof p2, "%s/def.tape", tmp);
    {   char elog[4096]; snprintf(elog, sizeof elog, "%s/env.log", tmp);
        int ok = r == 0 && same(p, p2) && size_of(elog) <= 0;
        row("RF-ENV", ok, ok ? "new cwd, same result, stderr empty" : "result depends on the working directory");
        if (!ok) { bad++; printf("first red: stop\n"); goto done; } }
    /* RF-MISSING: a requested row dropped; the run refuses by name, no output, and a same-named disk file is not read */
    snprintf(p, sizeof p, "%s/miss", tmp); { char capd[4096]; snprintf(capd, sizeof capd, "%s/cap", W); copydir(capd, p); }
    snprintf(cmd, sizeof cmd, "awk -F'\\t' 'NR==2{print $1}' '%s/miss/resources.tsv' > '%s/key.txt'", tmp, tmp);
    run_rc(cmd, rc);
    {   char key[1024] = "", line[2048]; size_t n; char *k;
        snprintf(cmd, sizeof cmd, "%s/key.txt", tmp); k = cx_read(cmd, &n);
        if (k) { size_t i = 0; while (i < n && k[i] != '\n' && i < sizeof key - 1) { key[i] = k[i]; i++; } key[i] = 0; free(k); }
        snprintf(line, sizeof line, "%s/miss/resources.tsv", tmp);
        snprintf(cmd, sizeof cmd, "grep -v '^%s\t' '%s' > '%s/miss/r.tmp' && mv '%s/miss/r.tmp' '%s'", key, line, tmp, tmp, line);
        run_rc(cmd, rc);
        snprintf(cmd, sizeof cmd, "cd '%s' && rm -f miss.tape && sh '%s' --strict-resource-flow --resource-ledger '%s/miss' -S prog.c -o miss.tape > '%s/miss.log' 2>&1", w, P, tmp, tmp);
        r = run_rc(cmd, rc);
        snprintf(p, sizeof p, "%s/miss.log", tmp); snprintf(line, sizeof line, "MISSING_EXPLICIT_RESOURCE %s", key);
        snprintf(p2, sizeof p2, "%s/miss.tape", w);
        int ok = r != 0 && has(p, line) && size_of(p) > 0 && size_of(p2) < 0;
        row("RF-MISSING", ok, ok ? "rc nonzero, names the key, no output" : "missing key not refused by name");
        if (!ok) { bad++; printf("first red: stop\n"); goto done; } }
    /* RF-DUP: a key listed twice is a named refusal */
    snprintf(p, sizeof p, "%s/dup", tmp); { char capd[4096]; snprintf(capd, sizeof capd, "%s/cap", W); copydir(capd, p); }
    snprintf(cmd, sizeof cmd, "sed -n 2p '%s/dup/resources.tsv' >> '%s/dup/resources.tsv'", tmp, tmp); run_rc(cmd, rc);
    snprintf(cmd, sizeof cmd, "cd '%s' && sh '%s' --strict-resource-flow --resource-ledger '%s/dup' -S prog.c -o dup.tape > '%s/dup.log' 2>&1", w, P, tmp, tmp);
    r = run_rc(cmd, rc);
    snprintf(p, sizeof p, "%s/dup.log", tmp); snprintf(p2, sizeof p2, "%s/dup.tape", w);
    {   int ok = r == 2 && has(p, "duplicate-resource-key") && size_of(p2) < 0;
        row("RF-DUP", ok, ok ? "rc 2, named, no output" : "duplicate not refused by name");
        if (!ok) { bad++; printf("first red: stop\n"); goto done; } }
    /* RF-LENGTH: the first present row declares one byte more than its blob */
    snprintf(p, sizeof p, "%s/len", tmp); { char capd[4096]; snprintf(capd, sizeof capd, "%s/cap", W); copydir(capd, p); }
    snprintf(cmd, sizeof cmd, "awk -F'\\t' 'BEGIN{OFS=\"\\t\"} NR>1 && $2==1 && !d {$4=$4+1; d=1} {print}' '%s/len/resources.tsv' > '%s/len/r.tmp' && mv '%s/len/r.tmp' '%s/len/resources.tsv'", tmp, tmp, tmp, tmp);
    run_rc(cmd, rc);
    snprintf(cmd, sizeof cmd, "cd '%s' && rm -f '%s/len.tape' && sh '%s' --strict-resource-flow --resource-ledger '%s/len' -S prog.c -o '%s/len.tape' > '%s/len.log' 2>&1", w, tmp, P, tmp, tmp, tmp);
    r = run_rc(cmd, rc);
    snprintf(p, sizeof p, "%s/len.tape", tmp);
    {   int ok = r == 2 && size_of(p) < 0;
        row("RF-LENGTH", ok, ok ? "rc 2, no output" : "length mismatch not refused");
        if (!ok) { bad++; printf("first red: stop\n"); goto done; } }
    /* RF-RESET: strict ok, strict refusal, strict ok again; the third equals the first */
    snprintf(cmd, sizeof cmd, "cd '%s' && sh '%s' --strict-resource-flow --resource-ledger '%s/cap' -S prog.c -o '%s/r1.tape' > /dev/null 2>&1", w, P, W, tmp);
    int a = run_rc(cmd, rc);
    snprintf(cmd, sizeof cmd, "cd '%s' && sh '%s' --strict-resource-flow --resource-ledger '%s/miss' -S prog.c -o '%s/r2.tape' > /dev/null 2>&1", w, P, tmp, tmp);
    int b = run_rc(cmd, rc);
    snprintf(cmd, sizeof cmd, "cd '%s' && sh '%s' --strict-resource-flow --resource-ledger '%s/cap' -S prog.c -o '%s/r3.tape' > /dev/null 2>&1", w, P, W, tmp);
    int c = run_rc(cmd, rc);
    snprintf(p, sizeof p, "%s/r1.tape", tmp); snprintf(p2, sizeof p2, "%s/r3.tape", tmp);
    {   char refused[4096]; snprintf(refused, sizeof refused, "%s/r2.tape", tmp);
        int ok = a == 0 && b != 0 && c == 0 && same(p, p2) && size_of(refused) < 0;
        row("RF-RESET", ok, ok ? "ok, refuse, ok; third equals first" : "reset sequence differs");
        if (!ok) bad++; }
    /* RF-ABSENT (cli/defines; this key does not distinguish): an explicit absent answer is answered, never MISSING; on this key
       the stage gives the default output */
    snprintf(cmd, sizeof cmd, "cp -r '%s/cap' '%s/abs'", W, tmp); run_rc(cmd, rc);
    snprintf(cmd, sizeof cmd, "awk -F'\\t' 'BEGIN{OFS=\"\\t\"} $1==\"00636c692f646566696e6573\"{$2=0;$3=\"-\";$4=0;$5=\"-\"} {print}' '%s/abs/resources.tsv' > '%s/abs/r.tmp' && mv '%s/abs/r.tmp' '%s/abs/resources.tsv'", tmp, tmp, tmp, tmp); run_rc(cmd, rc);
    snprintf(cmd, sizeof cmd, "cd '%s' && sh '%s' --strict-resource-flow --resource-ledger '%s/abs' -S prog.c -o '%s/abs.tape' > '%s/abs.log' 2>&1", w, P, tmp, tmp, tmp); int ab = run_rc(cmd, rc);
    snprintf(p, sizeof p, "%s/abs.log", tmp); snprintf(p2, sizeof p2, "%s/abs.tape", tmp);
    {   char q[4096]; snprintf(q, sizeof q, "%s/def.tape", tmp);
        int ok = ab == 0 && !has(p, "MISSING_EXPLICIT_RESOURCE") && same(p2, q);
        row("RF-ABSENT", ok, ok ? "cli/defines: absent answered, not MISSING, output equals default (this key does not distinguish)" : "cli/defines: absent not answered, or output differs from default");
        if (!ok) bad++; }
    /* RF-EMPTY (cli/defines; this key does not distinguish): the same key present with a zero-length blob is answered, not
       MISSING; on this key it gives the default output too */
    snprintf(cmd, sizeof cmd, "cp -r '%s/cap' '%s/emp' && : > '%s/emp/resource-empty.bytes' && awk -F'\\t' 'BEGIN{OFS=\"\\t\"} $1==\"00636c692f646566696e6573\"{$2=1;$3=\"resource-empty.bytes\";$4=0;$5=\"%s\"} {print}' '%s/emp/resources.tsv' > '%s/emp/r.tmp' && mv '%s/emp/r.tmp' '%s/emp/resources.tsv'", W, tmp, tmp, EMPTY_SHA, tmp, tmp, tmp, tmp); run_rc(cmd, rc);
    snprintf(cmd, sizeof cmd, "cd '%s' && sh '%s' --strict-resource-flow --resource-ledger '%s/emp' -S prog.c -o '%s/empty.tape' > '%s/empty.log' 2>&1", w, P, tmp, tmp, tmp); int em = run_rc(cmd, rc);
    snprintf(p, sizeof p, "%s/empty.log", tmp); snprintf(p2, sizeof p2, "%s/empty.tape", tmp);
    {   char q[4096]; snprintf(q, sizeof q, "%s/def.tape", tmp);
        int ok = em == 0 && !has(p, "MISSING_EXPLICIT_RESOURCE") && !has(p, "INTERFACE_ERROR") && same(p2, q);
        row("RF-EMPTY", ok, ok ? "cli/defines: zero-length answered, not MISSING, output equals default (this key does not distinguish)" : "cli/defines: zero-length refused, misread, or output differs from default");
        if (!ok) bad++; }
    /* RF-LOWER (library/module, lower stage; fixture tests/seals/stagecontract-tape-lower with its frozen lower.net): ABSENT is
       accepted with the fixture output; EMPTY is refused by name (rc 1, not covered); the two outcomes differ. The runner is the
       repo's tests/middleflowrunner.c built with exec/c/core.c, as stagecontractcheck.cx does */
    {   char fx[] = "tests/seals/stagecontract-tape-lower", exp[4096], q[4096];
        snprintf(cmd, sizeof cmd, "cc -std=gnu99 -O2 -w -o '%s/rrunner' tests/middleflowrunner.c exec/c/core.c", tmp); run_rc(cmd, rc);
        snprintf(cmd, sizeof cmd, "cp -r '%s/accept' '%s/lab' && MF_STAGE_ID=lower:lnx/x86_64/image/O0 MF_MODEL_SHA256=$(awk '$1==\"sha256\"{print $2}' '%s/boundary.tsv') '%s/rrunner' replay '%s/lower.net' '%s/lab' '%s/lab' > '%s/lab.out'", fx, tmp, fx, tmp, fx, tmp, tmp, tmp);
        snprintf(q, sizeof q, "%s/lab.rc", tmp);
        int la = run_rc(cmd, q);
        snprintf(cmd, sizeof cmd, "cp -r '%s/accept' '%s/lem' && : > '%s/lem/resource-empty.bytes' && awk -F'\\t' 'BEGIN{OFS=\"\\t\"} $1==\"006c6962726172792f6d6f64756c65\"{$2=1;$3=\"resource-empty.bytes\";$4=0;$5=\"%s\"} {print}' '%s/lem/resources.tsv' > '%s/lem/r.tmp' && mv '%s/lem/r.tmp' '%s/lem/resources.tsv' && MF_STAGE_ID=lower:lnx/x86_64/image/O0 MF_MODEL_SHA256=$(awk '$1==\"sha256\"{print $2}' '%s/boundary.tsv') '%s/rrunner' replay '%s/lower.net' '%s/lem' '%s/lem' > '%s/lem.out'", fx, tmp, tmp, EMPTY_SHA, tmp, tmp, tmp, tmp, fx, tmp, fx, tmp, tmp, tmp);
        snprintf(q, sizeof q, "%s/lem.rc", tmp);
        int le = run_rc(cmd, q);
        snprintf(exp, sizeof exp, "%s/accept/output.bytes", fx);
        snprintf(p, sizeof p, "%s/lab.out", tmp); snprintf(p2, sizeof p2, "%s/lem.stderr", tmp);
        {   char lo[4096];
            snprintf(lo, sizeof lo, "%s/lem.out", tmp);
            int oka = la == 0 && same(p, exp);
            int oke = le == 1 && has(p2, "not covered") && size_of(lo) <= 0;
            int ok = oka && oke && la != le;
            row("RF-LOWER", ok, ok ? "library/module on lower: ABSENT accepted (fixture output), EMPTY refused by name (not covered); outcomes differ" : "lower ABSENT/EMPTY outcomes not as recorded (ABSENT rc0 == fixture output; EMPTY rc1 named not covered)");
            if (!ok) bad++; }
    }
    /* RF-STAGE: a ledger captured from another program must be refused by name (INTERFACE_ERROR, rc 2, no primary output);
       a silent reuse is red, even when the bytes happen to match */
    snprintf(cmd, sizeof cmd, "mkdir -p '%s/w2' '%s/cap2' && printf 'int main(void){return 7;}\\n' > '%s/w2/prog.c' && cd '%s/w2' && UNISACC_RF_CAPTURE='%s/cap2' sh '%s' -S prog.c -o cap2.tape > /dev/null 2>&1", tmp, tmp, tmp, tmp, tmp, P); run_rc(cmd, rc);
    snprintf(cmd, sizeof cmd, "cd '%s' && rm -f '%s/stage.tape' && sh '%s' --strict-resource-flow --resource-ledger '%s/cap2' -S prog.c -o '%s/stage.tape' > '%s/stage.log' 2>&1", w, tmp, P, tmp, tmp, tmp); int sg = run_rc(cmd, rc);
    snprintf(p, sizeof p, "%s/stage.log", tmp); snprintf(p2, sizeof p2, "%s/stage.tape", tmp);
    {   int ok = sg == 2 && size_of(p2) < 0 && has(p, "INTERFACE_ERROR");
        row("RF-STAGE", ok, ok ? "foreign-stage ledger: rc 2, INTERFACE_ERROR named, no primary output" : "foreign-stage ledger silently reused or refused without the interface name; equal bytes do not pass");
        if (!ok) bad++; }
    /* RF-TARGET: the ledger is bound to its run's target; a strict run for another target is a named refusal, no output */
    snprintf(cmd, sizeof cmd, "cd '%s' && rm -f '%s/tgt.tape' && sh '%s' --strict-resource-flow --resource-ledger '%s/cap' -b lnx/arm64 -S prog.c -o '%s/tgt.tape' > '%s/tgt.log' 2>&1", w, tmp, P, W, tmp, tmp); int tg = run_rc(cmd, rc);
    snprintf(p, sizeof p, "%s/tgt.log", tmp); snprintf(p2, sizeof p2, "%s/tgt.tape", tmp);
    {   int ok = tg == 2 && size_of(p2) < 0 && has(p, "INTERFACE_ERROR") && has(p, "resource-identity-mismatch stage");
        row("RF-TARGET", ok, ok ? "ledger from lnx/x86_64 refused for lnx/arm64 by name (rc 2, no output)" : "cross-target ledger not refused by name");
        if (!ok) bad++; }
    /* RF-ROUTE: strict and capture cover the tape route only; another mode is a named refusal, no output */
    snprintf(cmd, sizeof cmd, "cd '%s' && rm -f '%s/route.s' && sh '%s' --strict-resource-flow --resource-ledger '%s/cap' -o '%s/route.s' prog.c > '%s/route.log' 2>&1", w, tmp, P, W, tmp, tmp); int rt = run_rc(cmd, rc);
    snprintf(p, sizeof p, "%s/route.log", tmp); snprintf(p2, sizeof p2, "%s/route.s", tmp);
    {   int ok = rt == 2 && size_of(p2) < 0 && has(p, "resource-route-unsupported");
        row("RF-ROUTE", ok, ok ? "non-tape route refused by name (rc 2, no output)" : "non-tape route not refused by name");
        if (!ok) bad++; }
done:
    printf("resourceflowcheck %s\n", bad ? "FAIL" : "PASS: CAPTURE, RF-POS, RF-ENV, RF-MISSING, RF-DUP, RF-LENGTH, RF-RESET, RF-ABSENT, RF-EMPTY, RF-LOWER, RF-STAGE, RF-TARGET, RF-ROUTE (and RF-LEGACY when a base product is given); measured scope: one program, one route (C -> Tape, -S -o)");
    return bad ? 1 : 0;
}
