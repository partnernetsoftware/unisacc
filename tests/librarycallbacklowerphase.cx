/* Private fixed part1 routing: original bytes/keys/flags/assertions/cleanup.
 * Caller bounds complete default-run at40; no helper binary/verdict cache. */
#include <cx.h>
#define SOURCE "tests/librarycallbacklowercheck.sh"
#define SOURCE_SHA "89ad337ef1898f66826892ebe7e7d3d8019f4a63e97afa4546bdcd0dbc560350"
#define SOURCE_TOTAL 7939
#define PREFIX_BYTES 7497
#define OFF_BYTES 294
#define ON_BYTES 148
static int no(const char*s){fprintf(stderr,"callbacklowerphase refused: %s\n",s);return 2;}
static char*phase_script(const char*s,int part,size_t*n){size_t k=part?ON_BYTES:OFF_BYTES,at=PREFIX_BYTES+(part?OFF_BYTES:0);char*b=malloc(PREFIX_BYTES+k+1);if(!b)return 0;memcpy(b,s,PREFIX_BYTES);memcpy(b+PREFIX_BYTES,s+at,k);*n=PREFIX_BYTES+k;b[*n]=0;return b;}
int main(int argc,char**argv){int part=-1,inspect=0;if(argc==2&&!strcmp(argv[1],"--inspect"))inspect=1;else if(argc==2&&!strcmp(argv[1],"off"))part=0;else if(argc==2&&!strcmp(argv[1],"on"))part=1;else return no("off|on|--inspect");
 size_t n;char*s=cx_read(SOURCE,&n),h[65];if(!s||n!=SOURCE_TOTAL||memchr(s,0,n))return no("fixed source read/length/NUL");cx_sha256_hex(s,n,h);if(strcmp(h,SOURCE_SHA))return no("fixed source SHA changed");
 if(PREFIX_BYTES+OFF_BYTES+ON_BYTES!=SOURCE_TOTAL||s[PREFIX_BYTES-1]!='\n'||s[PREFIX_BYTES+OFF_BYTES-1]!='\n'||s[n-1]!='\n')return no("fixed complete line partition");
 char*rebuilt=malloc(n+1);if(!rebuilt)return no("allocation");memcpy(rebuilt,s,PREFIX_BYTES);memcpy(rebuilt+PREFIX_BYTES,s+PREFIX_BYTES,OFF_BYTES);memcpy(rebuilt+PREFIX_BYTES+OFF_BYTES,s+PREFIX_BYTES+OFF_BYTES,ON_BYTES);rebuilt[n]=0;cx_sha256_hex(rebuilt,n,h);if(memcmp(rebuilt,s,n)||strcmp(h,SOURCE_SHA))return no("partition does not reconstruct exact original");
 if(inspect){size_t an,bn;char*a=phase_script(s,0,&an),*b=phase_script(s,1,&bn),ah[65],bh[65];if(!a||!b)return no("allocation");cx_sha256_hex(a,an,ah);cx_sha256_hex(b,bn,bh);printf("callbacklowerphase partition verified source=%s prefix=%d off=%d on=%d total=%zu; off2calls/on1call; shared prefix repeats complete seals and original cleanup; NOT PASS\nscript_off_sha256=%s\nscript_on_sha256=%s\n",SOURCE_SHA,PREFIX_BYTES,OFF_BYTES,ON_BYTES,n,ah,bh);return 0;}
 size_t scriptn;char*script=phase_script(s,part,&scriptn);if(!script)return no("allocation");
 printf("callbacklowerphase part1/%s original-source=%s; fresh verdict execution, joint coverage only\n",argv[1],SOURCE_SHA);fflush(stdout);
 char*av[]={"env","-u","UNISA_CONTAINER","sh","-c",script,SOURCE,"--require-cached","1",0};execvp(av[0],av);return no("exec env/sh");}
