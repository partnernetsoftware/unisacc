#pragma unisa use sys.hostid
/* Execute one validated registry row. No PASS cache or preparation shortcut. */
#pragma unisa use sys.sha
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.testplan
#pragma unisa use cxlib.productpkg
#pragma unisa use text.text
typedef struct {char name[128],path[4096];int supplied,kind;} Material;
typedef struct {char id[128],implementation[32],source[1024],mode[32],platform[32],budget[16],materials[4608],entry[2048],args[4096],expect[128],headers[16];int found,source_present;} Selected;
static Selected selected;
static Material material[32];static int nmaterial;
static char root[4096],parent[4096],work[4400],candidate[4400];
static void die(const char *s){fprintf(stderr,"run-batch: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char *out,size_t cap,const char *a,const char *b){int n=snprintf(out,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path bound");}
static void copy(char *out,size_t cap,const char *s){size_t n=strlen(s);if(n>=cap)die("field bound");memcpy(out,s,n+1);}
/* UNISACC_TABLES names the table directory (default tests).  A check that registers fixtures points it at a
   private copy, so its fixture rows never meet another lane's registration; the run of every batch then reads
   the same copy.  Absolute paths are used as given, relative ones are joined to the repository root. */
static const char *tdir(void){const char *e=getenv("UNISACC_TABLES");return e&&*e?e:"tests";}
static void table_path(char *out,size_t cap,const char *name){
    const char *td=tdir();
    if(td[0]=='/'){if(cx_fmt(out,cap,"%s/%s",td,name))die("path bound");return;}
    {   char rel[4400];if(cx_fmt(rel,sizeof rel,"%s/%s",td,name))die("path bound");path(out,cap,root,rel);}
}
static int within(const char *p,const char *base){size_t n=strlen(base);return !strncmp(p,base,n)&&(!p[n]||p[n]=='/');}
static void batch(const tp_batch_view *v,void *opaque){(void)opaque;if(!tx_eqz(v->id, selected.id))return;if(selected.found++)die("duplicate selected batch");
 copy(selected.implementation,sizeof selected.implementation,v->implementation);copy(selected.source,sizeof selected.source,v->source);copy(selected.mode,sizeof selected.mode,v->mode);copy(selected.platform,sizeof selected.platform,v->platform);copy(selected.budget,sizeof selected.budget,v->budget);copy(selected.materials,sizeof selected.materials,v->materials);copy(selected.entry,sizeof selected.entry,v->entry);copy(selected.args,sizeof selected.args,v->args);copy(selected.expect,sizeof selected.expect,v->expect);copy(selected.headers,sizeof selected.headers,v->headers);selected.source_present=v->source_present;}
static void coverage(const tp_coverage_view *v,void *opaque){(void)v;(void)opaque;}
static char *read_regular(const char *p,size_t *n){struct stat st;errno=0;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>268435456)die("regular input required");char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("input read extent");return s;}
/* The candidate is ~5 MB and every batch digests it twice; the software
   primitive runs at ~9 MB/s, the kernel's AF_ALG at ~55 MB/s. Use AF_ALG for
   large inputs and keep the software path as the fallback, same shape as
   src/runcache.cx's rc_hex_file. */
static void digest(const char *p,char h[65]){size_t n;char *s=read_regular(p,&n);if(n<65536||sy_sha256_hex(s,(long)n,h)!=0)cx_sha256_hex(s,n,h);free(s);}
/* "unchanged" means the whole product: the member set under the split layout, the file itself
   under an APE. Hashing root/unisacc.com alone was blind to the megabyte package (findings in
   the 2026-11-02 structural findings). */
static void product_digest(const char *r,char h[65]){if(pp_product_digest(r,h))die("product identity");}
static void parse_materials(void){const char *at=selected.materials;tp_material_decl d;int rc;while((rc=tp_material_next(&at,&d))>0){if(nmaterial==32)die("material inventory");Material *m=&material[nmaterial];copy(m->name,sizeof m->name,d.name);m->kind=d.kind;nmaterial++;}if(rc<0)die("material inventory");}
static void supplied(int argc,char **argv){if(argc-4!=nmaterial)die("material argument count");for(int i=4;i<argc;i++){char *eq=strchr(argv[i],'=');if(!eq||eq==argv[i]||!eq[1]||strchr(eq+1,'='))die("material assignment");size_t n=(size_t)(eq-argv[i]);int found=-1;for(int j=0;j<nmaterial;j++)if(strlen(material[j].name)==n&&!memcmp(material[j].name,argv[i],n)){found=j;break;}if(found<0||material[found].supplied)die("unknown or duplicate material");Material *m=material+found;if(!tp_material_value(m->kind,eq+1))die("material typed value");if(m->kind==2)copy(m->path,sizeof m->path,eq+1);else{struct stat st;errno=0;if(lstat(eq+1,&st))die(errno==ENOENT?"material path absent":"material path stat");if(!S_ISREG(st.st_mode)&&!S_ISDIR(st.st_mode))die("material path kind");if(!realpath(eq+1,m->path)||!tx_eqz(eq+1, m->path))die("material canonical path");}m->supplied=1;}for(int i=0;i<nmaterial;i++)if(!material[i].supplied)die("missing material");}
static const char *binding(const char *s,size_t n){if(n==4&&!memcmp(s,"root",4))return root;if(n==3&&!memcmp(s,"out",3))return work;if(n==9&&!memcmp(s,"candidate",9))return candidate;for(int i=0;i<nmaterial;i++)if(strlen(material[i].name)==n&&!memcmp(s,material[i].name,n))return material[i].path;die("unbound placeholder");return 0;}
static void expand(const char *token,char out[4400]){if(token[0]!='{'){copy(out,4400,token);return;}const char *end=strchr(token,'}');if(!end)die("placeholder end");size_t n=(size_t)(end-token-1);const char *base=binding(token+1,n);if(!end[1])copy(out,4400,base);else if(end[1]=='/'&&end[2]){if(tp_material_kind(selected.materials,token+1,n)==2)die("sha256 material has path suffix");path(out,4400,base,end+2);}else die("placeholder suffix");}
static int marker(const char *p,size_t n,const char *want){size_t at=0,wn=strlen(want);int count=0;while(at<n){size_t end=at;while(end<n&&p[end]!='\n')end++;if(end-at>=wn&&!memcmp(p+at,want,wn)&&(end-at==wn||p[at+wn]=='\t'))count++;at=end<n?end+1:end;}return count;}
/* Keep the historical Linux label route; add only the Darwin arm64 host. */
static int batch_platform_allowed(const char *p){
 if(tx_eqz(p,"lnx/x86_64"))return 1;
 const char *host=tn_self();
 return host&&tx_eqz(host,"osx/arm64")&&tx_eqz(p,host);
}
int main(int argc,char **argv){
 if(argc<4){fputs("usage: ROOT ABS_OUT_PARENT BATCH_ID [material=ABS_PATH ...]\n",stderr);return 2;}
 if(argv[1][0]!='/'||argv[2][0]!='/'||!realpath(argv[1],root)||!realpath(argv[2],parent)||!tx_eqz(argv[1], root)||!tx_eqz(argv[2], parent))die("canonical root and output parent");
 char outbase[4400],registry[4400],coverage_path[4400],why[1200];path(outbase,sizeof outbase,root,"out");char canonical[4096];if(!realpath(outbase,canonical)||!within(parent,canonical)||tx_eqz(parent, canonical))die("output parent must be below root/out");
 copy(selected.id,sizeof selected.id,argv[3]);table_path(registry,sizeof registry,"batches.tsv");table_path(coverage_path,sizeof coverage_path,"coverage.tsv");size_t rn,cn;char *r=read_regular(registry,&rn),*c=read_regular(coverage_path,&cn);tp_summary summary;tp_observer observer={batch,coverage,0};int rc=tp_visit(root,r,rn,c,cn,&observer,&summary,why,sizeof why);free(r);free(c);if(rc)die(why);if(selected.found!=1||!tx_eqz(selected.implementation, "IMPLEMENTED")||!selected.source_present)die("batch not implemented or source missing");
 if(!batch_platform_allowed(selected.platform))die("batch requires another native host");if(!tx_eqz(selected.headers, "product")&&!tx_eqz(selected.headers, "tree"))die("batch headers source");int seconds=atoi(selected.budget);if(seconds<1||seconds>90)die("batch budget");parse_materials();supplied(argc,argv);
 path(candidate,sizeof candidate,root,"unisacc.com");char before[65],after[65];product_digest(root,before);path(work,sizeof work,parent,selected.id);struct stat prior;errno=0;if(!lstat(work,&prior)||errno!=ENOENT)die("exclusive output path");
 char entry[4400];if(tx_eqz(selected.mode, "SOURCE"))path(entry,sizeof entry,root,selected.entry);else expand(selected.entry,entry);size_t en;char *source=read_regular(entry,&en);free(source);
 char storage[64][4400],*args[72];int na=0;char incflag[4400];args[na++]="sh";args[na++]=candidate;
 /* product: the packaged candidate's own embedded headers, nothing from the checkout.
    tree: the include-layout/carried-header checks need the tree they inspect, so ROOT/include
    is passed explicitly and no longer found implicitly by looking under the cwd. */
 if(tx_eqz(selected.headers, "tree")){if(cx_fmt(incflag,sizeof incflag,"-I%s/include",root))die("path bound");args[na++]=incflag;}
 args[na++]=entry;args[na++]="--";int argbase=na;
 if(!tx_eqz(selected.args, "-")){const char *at=selected.args;while(*at){const char *end=strchr(at,';');size_t n=end?(size_t)(end-at):strlen(at);if(na>=69||!n||n>=sizeof storage[0])die("argument bound");char token[4400];memcpy(token,at,n);token[n]=0;expand(token,storage[na-argbase]);args[na]=storage[na-argbase];na++;if(!end)break;at=end+1;}}
 if(np_subreaper()<0)fprintf(stderr,"run-batch: no child-subreaper\n");   /* orphans of a killed tree land here, not on init */
 args[na]=0;np_result result={0};char reason[1200];int transport=np_run(args,root,0,seconds>3?seconds-2:seconds,&result,reason,sizeof reason);
 /* a killed tree's orphans are our children once np_subreaper ran; np_run does not reap them (that would steal a
    caller's children), and a zombie here would be skipped by the residue scan, so reap before judging */
 if(transport){int st;while(waitpid(-1,&st,WNOHANG)>0);}
 /* The after-hash waits for the reap: an orphan that outlived its tree could still be writing the
    product, and hashing before it is gone would read a half-written member as "unchanged". The
    batch's budget also gives back two seconds so the hash and the reap fit inside the window. */
 product_digest(root,after);
 if(result.outn)fwrite(result.out,1,result.outn,stdout);if(result.errn)fwrite(result.err,1,result.errn,stderr);
 int ok=!transport&&!result.rc&&tx_eqz(before, after)&&!strncmp(selected.expect,"rc0:",4)&&marker(result.out,result.outn,selected.expect+4)==1;
 /* the batch's own bound expired: not a verdict, never PASS; the process group was killed and it must rerun */
 int timed_out=transport&&!strncmp(reason,"subprocess.TimeoutExpired",25)&&result.residue==0;   /* a survivor is a FAIL, not UNKNOWN */
 printf("BATCH_HEADERS\t%s\t%s\n",selected.id,selected.headers);
 printf("BATCH_RUN\tid=%s\tstatus=%s\trc=%d\ttransport=%d\tmarker=%s\tcandidate=%s\theaders=%s\tscope=actual-one-batch-no-cached-result\n",selected.id,ok?"PASS":timed_out?"UNKNOWN":"FAIL",result.rc,transport,selected.expect+4,before,selected.headers);
 if(transport)fprintf(stderr,"run-batch: child transport %s\n",reason);np_free(&result);return ok?0:timed_out?3:1;
}
