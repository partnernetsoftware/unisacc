#pragma unisa use sys.hostid
/* Execute one validated registry row. No PASS cache or preparation shortcut. */
#pragma unisa use sys.sha
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.testplan
#pragma unisa use cxlib.productpkg
#pragma unisa use text.text
#pragma unisa use cxlib.tlibpkg
#pragma unisa use sys.time
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use sys.io
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
typedef struct {char name[128],path[4096],given[4096],sha[65];int supplied,kind,linked;} Material;
typedef struct {char id[128],implementation[32],source[1024],mode[32],platform[32],budget[16],materials[4608],entry[2048],args[4096],expect[128],headers[16];int found,source_present;} Selected;
static Selected selected;
static Material material[32];static int nmaterial;
static char root[4096],parent[4096],work[4400],candidate[4400];
static void die(const char *s){fprintf(stderr,"run-batch: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char *out,size_t cap,const char *a,const char *b){int n=snprintf(out,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path bound");}
static void copy(char *out,size_t cap,const char *s){size_t n=strlen(s);if(n>=cap)die("field bound");memcpy(out,s,n+1);}
/* UNISACC_TABLES names the table directory (default tests).  A check that registers fixtures points it at a
   private copy, so its fixture rows never meet another lane's registration; the run of every batch then reads
   the same copy.  Absolute paths are used as given, relative ones are joined to the repository root. */
static const char *tdir(void){const char *e=getenv("UNISACC_TABLES");return e&&*e?e:"tests";}
static void table_path(char *out,size_t cap,const char *name){
    const char *td=tdir();
    if(td[0]=='/'){if(cx_fmt(out,cap,"%s/%s",td,name))die("path bound");return;}
    {   char rel[4400];if(cx_fmt(rel,sizeof rel,"%s/%s",td,name))die("path bound");path(out,cap,root,rel);}
}
static int within(const char *p,const char *base){size_t n=strlen(base);return !strncmp(p,base,n)&&(!p[n]||p[n]=='/');}
static void batch(const tp_batch_view *v,void *opaque){(void)opaque;if(!tx_eqz(v->id, selected.id))return;if(selected.found++)die("duplicate selected batch");
 copy(selected.implementation,sizeof selected.implementation,v->implementation);copy(selected.source,sizeof selected.source,v->source);copy(selected.mode,sizeof selected.mode,v->mode);copy(selected.platform,sizeof selected.platform,v->platform);copy(selected.budget,sizeof selected.budget,v->budget);copy(selected.materials,sizeof selected.materials,v->materials);copy(selected.entry,sizeof selected.entry,v->entry);copy(selected.args,sizeof selected.args,v->args);copy(selected.expect,sizeof selected.expect,v->expect);copy(selected.headers,sizeof selected.headers,v->headers);selected.source_present=v->source_present;}
static void coverage(const tp_coverage_view *v,void *opaque){(void)v;(void)opaque;}
static char *read_regular(const char *p,size_t *n){struct stat st;errno=0;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>268435456)die("regular input required");char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("input read extent");return s;}
/* The candidate is ~5 MB and every batch digests it twice; the software
   primitive runs at ~9 MB/s, the kernel's AF_ALG at ~55 MB/s. Use AF_ALG for
   large inputs and keep the software path as the fallback, same shape as
   src/runcache.cx's rc_hex_file. */
static void digest(const char *p,char h[65]){size_t n;char *s=read_regular(p,&n);if(n<65536||sy_sha256_hex(s,(long)n,h)!=0)cx_sha256_hex(s,n,h);free(s);}
/* "unchanged" means the whole product: the member set under the split layout, the file itself
   under an APE. Hashing root/unisacc.com alone was blind to the megabyte package (findings in
   the 2026-11-02 structural findings). */
/* A dev-product candidate (tools/dev-product.cx: an sh launcher, receipt.tsv and its member files) is taken only with
   --candidate ABS_DIR.  Its identity is the receipt checked against the disk: every member (entry, pkg, nets_pkg) a
   regular non-link file whose sha256 equals the receipt's, the receipt's product digest recomputed from them, and the
   launcher byte-equal to the text dev-product writes for exactly those paths.  Any absent or differing member is a
   named refusal that lists the members; nothing is cached, both digests are recomputed before and after the run. */
static char devdir[4096];
static int dev_field(const char *s,size_t n,const char *key,char *a,size_t acap,char *b,size_t bcap){size_t at=0,kn=strlen(key);int found=0;while(at<n){size_t end=at;while(end<n&&s[end]!='\n')end++;if(end-at>kn&&!memcmp(s+at,key,kn)&&s[at+kn]=='\t'){const char *f=s+at+kn+1,*e=s+end,*t=memchr(f,'\t',(size_t)(e-f));size_t an=(size_t)((t?t:e)-f);if(found++||an>=acap||mm_copy(a,(long)acap,f,(long)an))return -1;a[an]=0;if(b){size_t bn;if(!t)return -1;bn=(size_t)(e-t-1);if(bn>=bcap||memchr(t+1,'\t',bn)||mm_copy(b,(long)bcap,t+1,(long)bn))return -1;b[bn]=0;}else if(t)return -1;}at=end<n?end+1:end;}return found==1?0:-1;}
static void bad_add(char *bad,size_t cap,const char *name,const char *p,const char *why){size_t n=strlen(bad);if(cx_fmt(bad+n,cap-n,"%s%s=%s:%s",n?",":"",name,p,why))die("candidate member list bound");}
static void dev_member(const char *name,const char *p,const char *want,char got[65],char *bad,size_t cap){struct stat st;const char *why=0;got[0]=0;errno=0;if(p[0]!='/')why="not-absolute";else if(lstat(p,&st))why=errno==ENOENT?"absent":"stat";else if(!S_ISREG(st.st_mode))why="not-regular";else{digest(p,got);if(!tx_eqz(got,want))why="sha-mismatch";}if(why)bad_add(bad,cap,name,p,why);}
static int dev_launcher(const char *bytes,size_t n,const char *pkg,const char *entry){
 char want[13000];
 if(cx_fmt(want,sizeof want,"#!/bin/sh\n# NOT_RELEASE dev-product-v1 scope=LOCAL (tools/dev-product.cx); lnx/x86_64 only\nexport UNISA_CONTAINER='%s' UNISACC_LOCAL=1\nif [ x${UNISACC_E3CACHE+x} = x ]; then export UNISACC_CACHE_DIR=\"${DEV_PRODUCT_CACHE:-%s/runcache}\"; else unset UNISACC_CACHE_DIR; fi\nexec '%s' \"$@\"\n",pkg,devdir,entry))die("candidate launcher bound");
 if(n==strlen(want) && !memcmp(bytes,want,n))return 1;
 /* Previously sealed candidates retain their original launcher identity. */
 if(cx_fmt(want,sizeof want,"#!/bin/sh\n# NOT_RELEASE dev-product-v1 scope=LOCAL (tools/dev-product.cx); lnx/x86_64 only\nexec env UNISA_CONTAINER='%s' UNISACC_LOCAL=1 UNISACC_CACHE_DIR=\"${DEV_PRODUCT_CACHE:-%s/runcache}\" '%s' \"$@\"\n",pkg,devdir,entry))die("candidate launcher bound");
 return n==strlen(want) && !memcmp(bytes,want,n);
}
static void dev_digest(char h[65]){char rp[4400],lp[4400],ep[4096],es[80],pp[4096],ps[80],np[4096],ns[80],lq[4096],fin[80],k[80],sc[80],eg[65],pg[65],ng[65],lg[65],bad[16384]="";size_t rn,ln;
 path(rp,sizeof rp,devdir,"receipt.tsv");path(lp,sizeof lp,devdir,"unisacc.com");char *r=read_regular(rp,&rn);
 if(rn<24||memcmp(r,"NOT_RELEASE\tdev-product-v1\n",27)||dev_field(r,rn,"entry",ep,sizeof ep,es,sizeof es)||dev_field(r,rn,"pkg",pp,sizeof pp,ps,sizeof ps)||dev_field(r,rn,"nets_pkg",np,sizeof np,ns,sizeof ns)||dev_field(r,rn,"product",lq,sizeof lq,fin,sizeof fin)||dev_field(r,rn,"scope",sc,sizeof sc,0,0)||!tx_eqz(sc,"LOCAL"))die("candidate receipt shape");
 dev_member("entry",ep,es,eg,bad,sizeof bad);dev_member("pkg",pp,ps,pg,bad,sizeof bad);dev_member("nets_pkg",np,ns,ng,bad,sizeof bad);
 {char want[13000],fh[65];struct stat st;errno=0;if(!tx_eqz(lq,lp))dev_member("product",lq,"-",fh,bad,sizeof bad);else if(lstat(lp,&st)||!S_ISREG(st.st_mode))dev_member("launcher",lp,"-",fh,bad,sizeof bad);else{char *l=read_regular(lp,&ln);if(!dev_launcher(l,ln,pp,ep))bad_add(bad,sizeof bad,"launcher",lp,"text-mismatch");cx_sha256_hex(l,ln,lg);free(l);}
  if(cx_fmt(want,sizeof want,"%s\n%s\n",es,ps))die("candidate digest bound");cx_sha256_hex(want,strlen(want),fh);if(!tx_eqz(fh,fin))bad_add(bad,sizeof bad,"product",lq,"receipt-digest-mismatch");}
 free(r);if(bad[0]){fprintf(stderr,"run-batch: REFUSE candidate members %s (members: launcher entry pkg nets_pkg) errno=0\n",bad);exit(2);}
 if(cx_fmt(k,sizeof k,"%s","dev-product-v1"))die("fmt");{char text[400];if(cx_fmt(text,sizeof text,"%s\nlauncher\t%s\nentry\t%s\npkg\t%s\nnets_pkg\t%s\n",k,lg,eg,pg,ng))die("candidate digest bound");cx_sha256_hex(text,strlen(text),h);}}
static void product_digest(const char *r,char h[65]){if(devdir[0]){dev_digest(h);return;}if(pp_product_digest(r,h))die("product identity");}
/* A material given as a symbolic link is taken as its resolved target, which must be a regular file: a dangling
   link, a loop (ELOOP, any number of hops) or a link to a directory or special file is a named refusal.  The
   target's sha256 is recorded at intake and recomputed after the run; a change is a refusal, never a PASS.
   A material given as a non-link keeps the original contract (regular file or directory, its own realpath). */
static void link_material(Material *m,const char *given){struct stat st;copy(m->given,sizeof m->given,given);errno=0;if(!realpath(given,m->path)){if(errno==ELOOP)die("material link loop");if(errno==ENOENT)die("material link dangling");die("material link unresolved");}errno=0;if(lstat(m->path,&st))die("material link target stat");if(!S_ISREG(st.st_mode))die("material link target kind");digest(m->path,m->sha);m->linked=1;fprintf(stderr,"run-batch: material %s link=%s target=%s sha256=%s\n",m->name,given,m->path,m->sha);}
static void link_materials_unchanged(void){for(int i=0;i<nmaterial;i++)if(material[i].linked){struct stat st;char h[65];errno=0;if(lstat(material[i].path,&st)||!S_ISREG(st.st_mode)){fprintf(stderr,"run-batch: material %s target=%s no longer a regular file\n",material[i].name,material[i].path);die("material identity changed");}digest(material[i].path,h);if(!tx_eqz(h,material[i].sha)){fprintf(stderr,"run-batch: material %s target=%s sha256 intake=%s now=%s\n",material[i].name,material[i].path,material[i].sha,h);die("material identity changed");}}}
static void parse_materials(void){const char *at=selected.materials;tp_material_decl d;int rc;while((rc=tp_material_next(&at,&d))>0){if(nmaterial==32)die("material inventory");Material *m=&material[nmaterial];copy(m->name,sizeof m->name,d.name);m->kind=d.kind;nmaterial++;}if(rc<0)die("material inventory");}
static void supplied(int argc,char **argv){if(argc-4!=nmaterial)die("material argument count");for(int i=4;i<argc;i++){char *eq=strchr(argv[i],'=');if(!eq||eq==argv[i]||!eq[1]||strchr(eq+1,'='))die("material assignment");size_t n=(size_t)(eq-argv[i]);int found=-1;for(int j=0;j<nmaterial;j++)if(strlen(material[j].name)==n&&!memcmp(material[j].name,argv[i],n)){found=j;break;}if(found<0||material[found].supplied)die("unknown or duplicate material");Material *m=material+found;if(!tp_material_value(m->kind,eq+1))die("material typed value");if(m->kind==2)copy(m->path,sizeof m->path,eq+1);else{struct stat st;errno=0;if(lstat(eq+1,&st))die(errno==ENOENT?"material path absent":"material path stat");if(S_ISLNK(st.st_mode))link_material(m,eq+1);else{if(!S_ISREG(st.st_mode)&&!S_ISDIR(st.st_mode))die("material path kind");if(!realpath(eq+1,m->path)||!tx_eqz(eq+1, m->path))die("material canonical path");}}m->supplied=1;}for(int i=0;i<nmaterial;i++)if(!material[i].supplied)die("missing material");}
/* {candidate-root}: the tested product root (ROOT/unisacc.com is the product under test): the --candidate directory
   when given, else the repo root.  {root} always stays the repo root.  tests/batch-product-inputs.tsv requires an id row. */
static const char *binding(const char *s,size_t n){if(n==4&&!memcmp(s,"root",4))return root;if(n==3&&!memcmp(s,"out",3))return work;if(n==9&&!memcmp(s,"candidate",9))return candidate;if(n==14&&!memcmp(s,"candidate-root",14))return devdir[0]?devdir:root;for(int i=0;i<nmaterial;i++)if(strlen(material[i].name)==n&&!memcmp(s,material[i].name,n))return material[i].path;die("unbound placeholder");return 0;}
static void expand(const char *token,char out[4400]){if(token[0]!='{'){copy(out,4400,token);return;}const char *end=strchr(token,'}');if(!end)die("placeholder end");size_t n=(size_t)(end-token-1);const char *base=binding(token+1,n);if(!end[1])copy(out,4400,base);else if(end[1]=='/'&&end[2]){if(tp_material_kind(selected.materials,token+1,n)==2)die("sha256 material has path suffix");path(out,4400,base,end+2);}else die("placeholder suffix");}
static int marker(const char *p,size_t n,const char *want){size_t at=0,wn=strlen(want);int count=0;while(at<n){size_t end=at;while(end<n&&p[end]!='\n')end++;if(end-at>=wn&&!memcmp(p+at,want,wn)&&(end-at==wn||p[at+wn]=='\t'))count++;at=end<n?end+1:end;}return count;}
/* Shadow telemetry for complete, forwarded stdout records. Child counters are not receipts. */
static int pass_lines(const char *p,size_t n){
 static const char prefix[]="PASS\t";
 int count=0;size_t at=0;
 while(at<n){
  const char *end=memchr(p+at,'\n',n-at);
  if(!end)break;
  if((size_t)(end-(p+at))>=sizeof prefix-1&&!memcmp(p+at,prefix,sizeof prefix-1))count++;
  at=(size_t)(end-p)+1;
 }
 return count;
}
/* Keep the historical Linux label route; add only the Darwin arm64 host. */
static int batch_platform_allowed(const char *p){
 if(tx_eqz(p,"lnx/x86_64"))return 1;
 const char *host=tn_self();
 return host&&tx_eqz(host,"osx/arm64")&&tx_eqz(p,host);
}
/* Linking from the tlib kit.  An entry that build/tlib-prep.tsv lists (admitted by tools/tlib-admit.cx: same stdout,
   stderr and exit code as the source build, and faster) is linked from the kit's packages (tools/tlib.cx prep) and the
   image is run with the batch's arguments, in place of `product ENTRY -- ARGS`.  Anything that goes wrong here, the
   kit being absent or stale, a refused link, a release-chain environment, a bound hit: the batch then runs
   the original way. Kit construction belongs to the separate preparation phase; no batch rebuilds it.
   A failed prep reports its actual transport, exit status and diagnostic. */
static int tlib_listed(const char *rel){
 char p[4400];size_t n=0;long i,e,off,len;int hit=0;
 path(p,sizeof p,root,"build/tlib-prep.tsv");
 char *t=cx_read(p,&n);if(!t)return 0;
 for(i=0;i<(long)n&&!hit;i=e+1){e=i;while(e<(long)n&&t[e]!='\n')e++;if(e>i&&t[i]!='#'&&!tx_field(t+i,e-i,'\t',0,&off,&len)&&tx_same(t+i+off,len,rel,(long)strlen(rel)))hit=1;}
 free(t);return hit;
}
static const char *tlib_why=0;   /* set only when a listed entry was attempted and fell back to source */
static int tlib_rc=0;
static int tlib_mode;   /* 1 a prepared kit linked the image, 0 source fallback; construction is separate */
static int tlib_image(const char *entry,char *img,size_t cap){
 char bound[4400],tool[4400],kitdir[4400];
 if(tp_prep_forbidden()||!tlib_listed(selected.entry))return 0;
 if(tp_kit_dir(root,kitdir,sizeof kitdir)){tlib_why="path";return 0;}
 if(cx_fmt(bound,sizeof bound,"%s/tools/bound",root)||cx_fmt(tool,sizeof tool,"%s/tlib-prep",kitdir)){tlib_why="path";return 0;}
 if(cx_fmt(img,cap,"%s/.tlibimg-%s-%d",parent,selected.id,(int)sy_pid())){tlib_why="path";return 0;}
 int present=sy_is_reg(tool);
 if(present!=1){tlib_rc=present==-ENOENT?7:present<0?-present:2;tlib_why=present==-ENOENT?"kit-missing":present<0?"kit-stat-failed":"kit-not-regular";return 0;}
 char *v[]={bound,"20",tool,"prep",(char *)entry,"-o",img,"--root",root,0},why[400];np_result r={0};
 int transport=np_run(v,root,0,22,&r,why,sizeof why);tlib_rc=transport?-1:r.rc;
 int good=!transport&&!r.rc&&!r.residue&&sy_is_reg(img)==1;
 if(!good){
  tlib_why=transport?"link-transport":r.rc||r.residue?"link-failed":"link-missing-output";
  sy_eprintf("run-batch: tlib-attempt phase=prep rc=%d transport=%d residue=%d\n",r.rc,transport,r.residue);
  if(r.errn)sy_write_all(2,r.err,(long)r.errn);
  if(transport)sy_eprintf("run-batch: tlib-transport %s\n",why);
 }
 np_free(&r);if(good){tlib_mode=1;return 1;}
 (void)sy_unlink(img);return 0;
}
static int policy_failed,policy_checks;
static void policy_check(int good,const char *name){
 policy_checks++;if(!good)policy_failed++;sy_printf("%s\tbatch-tlib-policy.%s\n",good?"PASS":"FAIL",name);
}
/* These controls invoke the same optional-link path as a real batch, against
   an exclusive cache. Native true/false stand in only for the prep executable;
   they cannot construct a kit or supply any test verdict. */
static int tlib_controls(const char *root_arg,const char *out){
 if(sy_realpath(root_arg,root,sizeof root)<0||sy_mkdir(out,0700)||cx_fmt(parent,sizeof parent,"%s",out)||tp_prep_forbidden())die("tlib policy control prerequisites");
 char p[4400],entry[4400],cache[4400],tool[4600],kit[4400],image[4400];size_t n=0;
 path(p,sizeof p,root,"build/tlib-prep.tsv");char *table=cx_read(p,&n);if(!table)die("tlib policy table");
 for(size_t at=0;at<n&&!selected.entry[0];){size_t end=at;while(end<n&&table[end]!='\n')end++;long off,len;
  if(end>at&&table[at]!='#'&&!tx_field(table+at,(long)(end-at),'\t',0,&off,&len)&&len>0&&len<(long)sizeof selected.entry){
   if(mm_copy(selected.entry,sizeof selected.entry,table+at+off,len))die("tlib policy entry");selected.entry[len]=0;
  }at=end+1;
 }
 mm_free(table);if(!selected.entry[0])die("listed tlib entry required");
 copy(selected.id,sizeof selected.id,"policy");path(entry,sizeof entry,root,selected.entry);path(cache,sizeof cache,out,"cache");
 if(sy_setenv("UNISACC_TLIB_CACHE",cache,1))die("tlib policy environment");
 int rc=tlib_image(entry,image,sizeof image);
 policy_check(!rc&&tlib_rc==7&&tlib_why&&tx_eqz(tlib_why,"kit-missing"),"missing-kit-source-fallback");
 policy_check(sy_is_reg(cache)==-ENOENT,"missing-kit-not-created");
 path(p,sizeof p,out,"blocked-cache");if(cx_write(p,"x",1)||sy_setenv("UNISACC_TLIB_CACHE",p,1))die("tlib policy blocked cache");
 tlib_why=0;tlib_rc=0;rc=tlib_image(entry,image,sizeof image);
 policy_check(!rc&&tlib_rc==ENOTDIR&&tlib_why&&tx_eqz(tlib_why,"kit-stat-failed"),"ENOTDIR-is-not-absence");
 policy_check(sy_is_reg(p)==1,"blocked-cache-not-rebuilt");
 if(sy_setenv("UNISACC_TLIB_CACHE",cache,1)||tp_kit_dir(root,kit,sizeof kit)||sy_mkdir_all(kit,0700)||cx_fmt(tool,sizeof tool,"%s/tlib-prep",kit))die("tlib policy private kit");
 char *bytes=cx_read("/bin/false",&n);if(!bytes||n>1048576||cx_write(tool,bytes,n)||sy_chmod(tool,0755))die("tlib policy native false");mm_free(bytes);
 tlib_why=0;tlib_rc=0;rc=tlib_image(entry,image,sizeof image);
 policy_check(!rc&&tlib_rc==1&&tlib_why&&tx_eqz(tlib_why,"link-failed"),"prep-exit-code-preserved");
 if(cx_fmt(p,sizeof p,"%s/kit.tsv",kit))die("tlib policy receipt path");
 policy_check(sy_is_reg(p)==-ENOENT,"failed-prep-does-not-construct-kit");
 bytes=cx_read("/bin/true",&n);if(!bytes||n>1048576||cx_write(tool,bytes,n)||sy_chmod(tool,0755))die("tlib policy native true");mm_free(bytes);
 tlib_why=0;tlib_rc=0;rc=tlib_image(entry,image,sizeof image);
 policy_check(!rc&&tlib_rc==0&&tlib_why&&tx_eqz(tlib_why,"link-missing-output"),"rc0-without-image-not-accepted");
 policy_check(sy_is_reg(image)==-ENOENT,"missing-image-not-invented");
 if(sy_unlink(tool)||sy_mkdir(tool,0700))die("tlib policy directory prep");
 tlib_why=0;tlib_rc=0;rc=tlib_image(entry,image,sizeof image);
 policy_check(!rc&&tlib_rc==2&&tlib_why&&tx_eqz(tlib_why,"kit-not-regular"),"directory-prep-refused");
 if(sy_setenv("UNISACC_CTOR","c",1))die("tlib policy chain marker");tlib_why=0;tlib_rc=0;rc=tlib_image(entry,image,sizeof image);
 policy_check(!rc&&!tlib_why,"chain-environment-skips-optional-kit");
 sy_printf("BATCH_TLIB_POLICY\tchecks=%d\tfailed=%d\tno-kit-construction\n",policy_checks,policy_failed);return policy_failed?1:0;
}
int main(int argc,char **argv){
 if(argc==4&&tx_eqz(argv[1],"--tlib-controls"))return tlib_controls(argv[2],argv[3]);
 if(argc>=3&&tx_eqz(argv[1],"--candidate")){if(argv[2][0]!='/'||!realpath(argv[2],devdir)||!tx_eqz(argv[2],devdir))die("canonical candidate directory");argv[2]=argv[0];argv+=2;argc-=2;}
 if(argc<4){fputs("usage: [--candidate ABS_DEV_PRODUCT_DIR] ROOT ABS_OUT_PARENT BATCH_ID [material=ABS_PATH ...]\n",stderr);return 2;}
 if(argv[1][0]!='/'||argv[2][0]!='/'||!realpath(argv[1],root)||!realpath(argv[2],parent)||!tx_eqz(argv[1], root)||!tx_eqz(argv[2], parent))die("canonical root and output parent");
 char outbase[4400],registry[4400],coverage_path[4400],why[1200];path(outbase,sizeof outbase,root,"out");char canonical[4096];int out_ok=realpath(outbase,canonical)&&within(parent,canonical)&&!tx_eqz(parent, canonical);char tmpc[4096],tmpbase[4400];int tmp_ok=0;if(sy_tmpdir()&&realpath(sy_tmpdir(),tmpc)&&!cx_fmt(tmpbase,sizeof tmpbase,"%s/unisacc-affected-",tmpc))tmp_ok=!strncmp(parent,tmpbase,strlen(tmpbase));if(!out_ok&&!tmp_ok)die("output parent must be below root/out or tmpdir/unisacc-affected-");
 copy(selected.id,sizeof selected.id,argv[3]);table_path(registry,sizeof registry,"batches.tsv");table_path(coverage_path,sizeof coverage_path,"coverage.tsv");size_t rn,cn;char *r=read_regular(registry,&rn),*c=read_regular(coverage_path,&cn);tp_summary summary;tp_observer observer={batch,coverage,0};int rc=tp_visit(root,r,rn,c,cn,&observer,&summary,why,sizeof why);free(r);free(c);if(rc)die(why);if(selected.found!=1||!tx_eqz(selected.implementation, "IMPLEMENTED")||!selected.source_present)die("batch not implemented or source missing");
 if(!batch_platform_allowed(selected.platform))die("batch requires another native host");if(!tx_eqz(selected.headers, "product")&&!tx_eqz(selected.headers, "tree"))die("batch headers source");int seconds=atoi(selected.budget);if(seconds<1||seconds>90)die("batch budget");parse_materials();supplied(argc,argv);
 if(devdir[0])path(candidate,sizeof candidate,devdir,"unisacc.com");else path(candidate,sizeof candidate,root,"unisacc.com");char before[65],after[65];product_digest(root,before);path(work,sizeof work,parent,selected.id);struct stat prior;errno=0;if(!lstat(work,&prior)||errno!=ENOENT)die("exclusive output path");   /* lint:allow R1-product candidate is the product this batch runs (args[na++]=candidate below); ROOT/unisacc.com is the entry contract, not a second name */
 char entry[4400];if(tx_eqz(selected.mode, "SOURCE"))path(entry,sizeof entry,root,selected.entry);else expand(selected.entry,entry);size_t en;char *source=read_regular(entry,&en);free(source);
 char storage[64][4400],*args[72];int na=0;char incflag[4400];args[na++]="sh";args[na++]=candidate;
 /* product: the packaged candidate's own embedded headers, nothing from the checkout.
    tree: the include-layout/carried-header checks need the tree they inspect, so ROOT/include
    is passed explicitly and no longer found implicitly by looking under the cwd. */
 if(tx_eqz(selected.headers, "tree")){if(cx_fmt(incflag,sizeof incflag,"-I%s/include",root))die("path bound");args[na++]=incflag;}
 args[na++]=entry;args[na++]="--";int argbase=na;
 if(!tx_eqz(selected.args, "-")){const char *at=selected.args;while(*at){const char *end=strchr(at,';');size_t n=end?(size_t)(end-at):strlen(at);if(na>=69||!n||n>=sizeof storage[0])die("argument bound");char token[4400];memcpy(token,at,n);token[n]=0;expand(token,storage[na-argbase]);args[na]=storage[na-argbase];na++;if(!end)break;at=end+1;}}
 if(np_subreaper()<0)fprintf(stderr,"run-batch: no child-subreaper\n");   /* orphans of a killed tree land here, not on init */
 args[na]=0;np_result result={0};char reason[1200];long t_prep=sy_now_ms(),t_link,t_run,t_hash;
 /* a listed entry runs as its tlib-linked image; the link time comes out of the batch's own budget */
 char timg[4400];long tl0=sy_now_ms();long t_lib=tl0;char **run_args=args;char *targs[72];int via_tlib=0;
 if(tx_eqz(selected.mode,"SOURCE")&&tx_eqz(selected.headers,"product")&&tlib_image(entry,timg,sizeof timg)){
  int k=0,i;targs[k++]=timg;for(i=argbase;i<na;i++)targs[k++]=args[i];targs[k]=0;run_args=targs;via_tlib=1;}
 if(!via_tlib&&tlib_why)fprintf(stderr,"run-batch: tlib=fallback:%d:%s\n",tlib_rc,tlib_why);
 /* 链接时间从批的断言预算里扣(原判定保留:不改判定,只做落盘)。实测 affected-tool budget=25 时 link 吃 25 秒,
    预算被压到 1 秒,批本体 0.8 秒就跑完仍判 UNKNOWN(transport=-1) —— 这是 DSG-CPU4 要改的排队语义,不在本次范围。 */
 {long spent=(sy_now_ms()-tl0)/1000;seconds=spent>=seconds-3?3:(int)(seconds-spent);}
 t_link=sy_now_ms();int transport=np_run(run_args,root,0,seconds>3?seconds-2:seconds,&result,reason,sizeof reason);
 t_run=sy_now_ms();
 if(via_tlib){(void)sy_unlink(timg);fprintf(stderr,"run-batch: entry linked from the tlib kit\nrun-batch: tlib=linked\n");}
 /* a killed tree's orphans are our children once np_subreaper ran; np_run does not reap them (that would steal a
    caller's children), and a zombie here would be skipped by the residue scan, so reap before judging */
 if(transport){int st;while(waitpid(-1,&st,WNOHANG)>0);}
 /* The after-hash waits for the reap: an orphan that outlived its tree could still be writing the
    product, and hashing before it is gone would read a half-written member as "unchanged". The
    batch's budget also gives back two seconds so the hash and the reap fit inside the window. */
 product_digest(root,after);link_materials_unchanged();
 if(result.outn)fwrite(result.out,1,result.outn,stdout);if(result.errn)fwrite(result.err,1,result.errn,stderr);
 int ok=!transport&&!result.rc&&tx_eqz(before, after)&&!strncmp(selected.expect,"rc0:",4)&&marker(result.out,result.outn,selected.expect+4)==1;
 /* the batch's own bound expired: not a verdict, never PASS; the process group was killed and it must rerun */
 int timed_out=transport&&!strncmp(reason,"subprocess.TimeoutExpired",25)&&result.residue==0;   /* a survivor is a FAIL, not UNKNOWN */
 char assertions[24]="UNMEASURED";
 if(!transport&&cx_fmt(assertions,sizeof assertions,"%d",pass_lines(result.out,result.outn)))die("assertion count bound");
 printf("BATCH_HEADERS\t%s\t%s\n",selected.id,selected.headers);
 printf("BATCH_RUN\tid=%s\tstatus=%s\trc=%d\ttransport=%d\tmarker=%s\tcandidate=%s\theaders=%s\tscope=actual-one-batch-no-cached-result\tassertions=%s\n",selected.id,ok?"PASS":timed_out?"UNKNOWN":"FAIL",result.rc,transport,selected.expect+4,before,selected.headers,assertions);
 /* 分相毫秒,仅给 tools/batch-cost.cx 汇总,不参与判定:
   link = 已准备 kit 的 tlib 链接,run = 批本体执行,norm = 收尾(产品前后摘要与清理)。
   kit=hot|cold 表示链接走的 kit 路径;fallback 表示该 entry 不在 build/tlib-prep.tsv 或不满足产品/tree 条件。 */
 {long now=sy_now_ms(),link=t_link-t_lib,run=t_run-t_link,norm=now-t_run;
  printf("BATCH_TIMING\tid=%s\tprep_ms=%ld\tlink_ms=%ld\trun_ms=%ld\tnorm_ms=%ld\ttotal_ms=%ld\tkit=%s\n",
         selected.id,t_lib-t_prep,link,run,norm,now-t_prep,via_tlib?(tlib_mode==2?"cold":"hot"):"fallback");
  /* P9 实测耗时事实表(只增,只记观测;任何门不得读它判通过或跳过执行,读者 tools/batch-timing.cx):
     UNISACC_BATCH_TIMES 覆盖路径,值 off 不记;夹具(UNISACC_TABLES 已设)不写真表,除非显式给了路径。 */
  {const char *bt=sy_env("UNISACC_BATCH_TIMES"),*tt=sy_env("UNISACC_TABLES"),*home=sy_env("HOME");char tp[4400],ln[512],ld[32]="-";size_t ln_n=0;char *la;
   if(!(bt&&*bt)&&!(tt&&*tt)&&home&&*home&&!cx_fmt(tp,sizeof tp,"%s/.cache/unisacc",home)){(void)sy_mkdir(tp,0755);if(cx_fmt(tp,sizeof tp,"%s/.cache/unisacc/batch-times.tsv",home))tp[0]=0;}
   else if(bt&&*bt&&!tx_eqz(bt,"off")){if(cx_fmt(tp,sizeof tp,"%s",bt))tp[0]=0;}else tp[0]=0;
   la=tp[0]?cx_read("/proc/loadavg",&ln_n):0;if(la){size_t i=0;while(i<ln_n&&i<sizeof ld-1&&la[i]!=' '){ld[i]=la[i];i++;}ld[i]=0;mm_free(la);}
   if(tp[0]&&!cx_fmt(ln,sizeof ln,"%ld\t%s\t%s\t%ld\t%ld\t%s\t%s\trun-batch\n",sy_wall_s(),selected.id,ok?"PASS":timed_out?"UNKNOWN":"FAIL",now-t_prep,run,via_tlib?(tlib_mode==2?"cold":"hot"):"fallback",ld))
    (void)sy_append_file(tp,ln,tx_len(ln,512),0644);}}
 if(transport)fprintf(stderr,"run-batch: child transport %s\n",reason);np_free(&result);return ok?0:timed_out?3:1;
}
