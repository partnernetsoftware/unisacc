/* Execute one validated registry row. No PASS cache or preparation shortcut. */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.testplan
#pragma unisa use text.text
typedef struct {char name[128],path[4096];int supplied,kind;} Material;
typedef struct {char id[128],implementation[32],source[1024],mode[32],platform[32],budget[16],materials[4608],entry[2048],args[4096],expect[128];int found,source_present;} Selected;
static Selected selected;
static Material material[32];static int nmaterial;
static char root[4096],parent[4096],work[4400],candidate[4400];
static void die(const char *s){fprintf(stderr,"run-batch: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char *out,size_t cap,const char *a,const char *b){int n=snprintf(out,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path bound");}
static void copy(char *out,size_t cap,const char *s){size_t n=strlen(s);if(n>=cap)die("field bound");memcpy(out,s,n+1);}
static int within(const char *p,const char *base){size_t n=strlen(base);return !strncmp(p,base,n)&&(!p[n]||p[n]=='/');}
static void batch(const tp_batch_view *v,void *opaque){(void)opaque;if(!tx_eq(v->id, selected.id, 1L << 20))return;if(selected.found++)die("duplicate selected batch");
 copy(selected.implementation,sizeof selected.implementation,v->implementation);copy(selected.source,sizeof selected.source,v->source);copy(selected.mode,sizeof selected.mode,v->mode);copy(selected.platform,sizeof selected.platform,v->platform);copy(selected.budget,sizeof selected.budget,v->budget);copy(selected.materials,sizeof selected.materials,v->materials);copy(selected.entry,sizeof selected.entry,v->entry);copy(selected.args,sizeof selected.args,v->args);copy(selected.expect,sizeof selected.expect,v->expect);selected.source_present=v->source_present;}
static void coverage(const tp_coverage_view *v,void *opaque){(void)v;(void)opaque;}
static char *read_regular(const char *p,size_t *n){struct stat st;errno=0;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>268435456)die("regular input required");char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("input read extent");return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=read_regular(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void parse_materials(void){const char *at=selected.materials;tp_material_decl d;int rc;while((rc=tp_material_next(&at,&d))>0){if(nmaterial==32)die("material inventory");Material *m=&material[nmaterial];copy(m->name,sizeof m->name,d.name);m->kind=d.kind;nmaterial++;}if(rc<0)die("material inventory");}
static void supplied(int argc,char **argv){if(argc-4!=nmaterial)die("material argument count");for(int i=4;i<argc;i++){char *eq=strchr(argv[i],'=');if(!eq||eq==argv[i]||!eq[1]||strchr(eq+1,'='))die("material assignment");size_t n=(size_t)(eq-argv[i]);int found=-1;for(int j=0;j<nmaterial;j++)if(strlen(material[j].name)==n&&!memcmp(material[j].name,argv[i],n)){found=j;break;}if(found<0||material[found].supplied)die("unknown or duplicate material");Material *m=material+found;if(!tp_material_value(m->kind,eq+1))die("material typed value");if(m->kind==2)copy(m->path,sizeof m->path,eq+1);else{struct stat st;errno=0;if(lstat(eq+1,&st))die(errno==ENOENT?"material path absent":"material path stat");if(!S_ISREG(st.st_mode)&&!S_ISDIR(st.st_mode))die("material path kind");if(!realpath(eq+1,m->path)||!tx_eq(eq+1, m->path, 1L << 20))die("material canonical path");}m->supplied=1;}for(int i=0;i<nmaterial;i++)if(!material[i].supplied)die("missing material");}
static const char *binding(const char *s,size_t n){if(n==4&&!memcmp(s,"root",4))return root;if(n==3&&!memcmp(s,"out",3))return work;if(n==9&&!memcmp(s,"candidate",9))return candidate;for(int i=0;i<nmaterial;i++)if(strlen(material[i].name)==n&&!memcmp(s,material[i].name,n))return material[i].path;die("unbound placeholder");return 0;}
static void expand(const char *token,char out[4400]){if(token[0]!='{'){copy(out,4400,token);return;}const char *end=strchr(token,'}');if(!end)die("placeholder end");size_t n=(size_t)(end-token-1);const char *base=binding(token+1,n);if(!end[1])copy(out,4400,base);else if(end[1]=='/'&&end[2]){if(tp_material_kind(selected.materials,token+1,n)==2)die("sha256 material has path suffix");path(out,4400,base,end+2);}else die("placeholder suffix");}
static int marker(const char *p,size_t n,const char *want){size_t at=0,wn=strlen(want);int count=0;while(at<n){size_t end=at;while(end<n&&p[end]!='\n')end++;if(end-at>=wn&&!memcmp(p+at,want,wn)&&(end-at==wn||p[at+wn]=='\t'))count++;at=end<n?end+1:end;}return count;}
int main(int argc,char **argv){
 if(argc<4){fputs("usage: ROOT ABS_OUT_PARENT BATCH_ID [material=ABS_PATH ...]\n",stderr);return 2;}
 if(argv[1][0]!='/'||argv[2][0]!='/'||!realpath(argv[1],root)||!realpath(argv[2],parent)||!tx_eq(argv[1], root, 1L << 20)||!tx_eq(argv[2], parent, 1L << 20))die("canonical root and output parent");
 char outbase[4400],registry[4400],coverage_path[4400],why[1200];path(outbase,sizeof outbase,root,"out");char canonical[4096];if(!realpath(outbase,canonical)||!within(parent,canonical)||tx_eq(parent, canonical, 1L << 20))die("output parent must be below root/out");
 copy(selected.id,sizeof selected.id,argv[3]);path(registry,sizeof registry,root,"tests/batches.tsv");path(coverage_path,sizeof coverage_path,root,"tests/coverage.tsv");size_t rn,cn;char *r=read_regular(registry,&rn),*c=read_regular(coverage_path,&cn);tp_summary summary;tp_observer observer={batch,coverage,0};int rc=tp_visit(root,r,rn,c,cn,&observer,&summary,why,sizeof why);free(r);free(c);if(rc)die(why);if(selected.found!=1||!tx_eq(selected.implementation, "IMPLEMENTED", 1L << 20)||!selected.source_present)die("batch not implemented or source missing");
 if(!tx_eq(selected.platform, "lnx/x86_64", 1L << 20))die("batch requires another native host");int seconds=atoi(selected.budget);if(seconds<1||seconds>55)die("batch budget");parse_materials();supplied(argc,argv);
 path(candidate,sizeof candidate,root,"unisacc.com");char before[65],after[65];digest(candidate,before);path(work,sizeof work,parent,selected.id);struct stat prior;errno=0;if(!lstat(work,&prior)||errno!=ENOENT)die("exclusive output path");
 char entry[4400];if(tx_eq(selected.mode, "SOURCE", 1L << 20))path(entry,sizeof entry,root,selected.entry);else expand(selected.entry,entry);size_t en;char *source=read_regular(entry,&en);free(source);
 char storage[64][4400],*args[72];int na=0;args[na++]="sh";args[na++]=candidate;args[na++]=entry;args[na++]="--";
 if(!tx_eq(selected.args, "-", 1L << 20)){const char *at=selected.args;while(*at){const char *end=strchr(at,';');size_t n=end?(size_t)(end-at):strlen(at);if(na>=69||!n||n>=sizeof storage[0])die("argument bound");char token[4400];memcpy(token,at,n);token[n]=0;expand(token,storage[na-4]);args[na]=storage[na-4];na++;if(!end)break;at=end+1;}}
 args[na]=0;np_result result={0};char reason[1200];int transport=np_run(args,root,0,seconds,&result,reason,sizeof reason);digest(candidate,after);
 if(result.outn)fwrite(result.out,1,result.outn,stdout);if(result.errn)fwrite(result.err,1,result.errn,stderr);
 int ok=!transport&&!result.rc&&tx_eq(before, after, 1L << 20)&&!strncmp(selected.expect,"rc0:",4)&&marker(result.out,result.outn,selected.expect+4)==1;
 /* the batch's own bound expired: not a verdict, never PASS; the process group was killed and it must rerun */
 int timed_out=transport&&!strncmp(reason,"subprocess.TimeoutExpired",25);
 printf("BATCH_RUN\tid=%s\tstatus=%s\trc=%d\ttransport=%d\tmarker=%s\tcandidate=%s\tscope=actual-one-batch-no-cached-result\n",selected.id,ok?"PASS":timed_out?"UNKNOWN":"FAIL",result.rc,transport,selected.expect+4,before);
 if(transport)fprintf(stderr,"run-batch: child transport %s\n",reason);np_free(&result);return ok?0:timed_out?3:1;
}
