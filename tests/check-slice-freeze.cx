/* tests/check-slice-freeze.cx -- fixtures for tools/slice-freeze.cx.
 *   sh ./unisacc.com tests/check-slice-freeze.cx -- --prepare ABS_OUT
 *   sh ./unisacc.com tests/check-slice-freeze.cx -- ABS_OUT
 * Run from the private root. Preparation supplies native tools, never a verdict;
 * consumption builds fresh git fixtures below ABS_OUT and keeps every assertion.
 *   hit=0                     a commit outside the frozen surface exits 0 with hit=0
 *   NO_CASE                   a hit without a case for a hit-row batch
 *   NO_APPROVAL               a case but no ledger SLICE-CHANGE row naming cc
 *   enforce rc1 / advisory 0  the same red case in both modes
 *   SLICE_DRIFT               an undeclared target's receipt sha changed
 *   AFFECTED                  a declared target's sha may change
 *   UNMEASURED                a missing receipt is never ok
 *   ok                        case + approval + unchanged shas exits 0 in enforce
 *   list refusals             an unknown batch id and a glob matching nothing are refused
 *   six target receipts       sha-only sl-* receipts infer all six targets through the real CLI
 *   release snapshot          real release-build p3 entry freezes APE/split products before usage */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.productpkg
#pragma unisa use mem.bytes
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use cxlib.runnerprep

#define CK_P 4400
static char root[CK_P], work[CK_P];
static int checks, failed;

static void die(const char *a) { fprintf(stderr, "check-slice-freeze: %s\n", a); exit(2); }
static void ck(int ok, const char *n) { checks++; if (!ok) failed++; printf("%s\tslice-freeze.%s\n", ok ? "PASS" : "FAIL", n); }
static void cp(char *d, size_t cap, const char *s, size_t n) {
    size_t i = 0; if (!cap) return;
    while (i + 1 < cap && i < n && s[i]) { d[i] = s[i]; i++; }
    if (i < n && s[i]) while (i && ((d[i] & 0xC0) == 0x80)) i--;
    d[i] = 0;
}
/* write TEXT to DIR/NAME (created) */
static void put(const char *dir, const char *name, const char *text) {
    char p[CK_P]; int fd; const char *s = text; size_t n = strlen(text), at = 0;
    if (cx_fmt(p, sizeof p, "%s/%s", dir, name)) die("path");
    fd = open(p, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
    if (fd < 0) die("open");
    while (at < n) { ssize_t z = write(fd, s + at, n - at); if (z <= 0) die("write"); at += (size_t)z; }
    if (close(fd)) die("close");
}
/* run ARGV in DIRW; stdout+stderr into OUT; the exit code */
static int run(const char *cwd, char **v, char *out, size_t cap) {
    np_result r; char why[400]; int rc;
    if (np_run(v, cwd, 0, 55, &r, why, sizeof why)) { cp(out, cap, why, strlen(why)); return -1; }
    { size_t n = r.outn < cap - 1 ? r.outn : cap - 1, i;
      for (i = 0; i < n; i++) out[i] = r.out[i];
      out[n] = 0;
      if (r.errn && n + r.errn + 1 < cap) { for (i = 0; i < r.errn; i++) out[n + i] = r.err[i]; out[n + r.errn] = 0; } }
    rc = r.rc; np_free(&r); return rc;
}
/* git in DIRW with ARGS; returns rc */
static int git(const char *cwd, const char *a1, const char *a2, const char *a3) {
    char out[4096]; char *v[] = {(char *)"git", (char *)a1, (char *)a2, (char *)a3, 0};
    return run(cwd, v, out, sizeof out);
}
static int commit_all(const char *cwd, const char *msg) {
    char out[4096]; char *v[] = {(char *)"git", (char *)"add", (char *)"-A", 0};
    char *c[] = {(char *)"git", (char *)"-c", (char *)"user.email=f@x", (char *)"-c", (char *)"user.name=f",
                 (char *)"commit", (char *)"-qm", (char *)msg, 0};
    if (run(cwd, v, out, sizeof out) != 0) return 1;
    return run(cwd, c, out, sizeof out) == 0 ? 0 : 1;
}
/* the tool, run from FIX with the given extra args */
static int tool(const char *fix, char **extra, char *out, size_t cap) {
    char sf[CK_P]; char *v[24]; int n = 0, i;
    if (cx_fmt(sf, sizeof sf, "%s/slice-freeze.elf", work)) die("path");
    v[n++] = sf;
    for (i = 0; extra[i] && n < 23; i++) v[n++] = extra[i];
    v[n] = 0;
    return run(fix, v, out, cap);
}
/* a receipt directory RECEIPTS/sl-NAME with a receipt holding TARGET and SHA */
static void receipt(const char *receipts, const char *leaf, const char *target, const char *sha) {
    char d[CK_P], line[600];
    if (cx_fmt(d, sizeof d, "%s/%s", receipts, leaf) || sy_mkdir(d, 0755)) die("receipt dir");
    if (cx_fmt(line, sizeof line, "target\t%s\nsha\t%s\n", target, sha)) die("line");
    put(d, "receipt.txt", line);
}
/* BASE fixture: a git repo with the list, a batches table and a frozen file */
static void base_repo(const char *fix) {
    put(fix, "frozen.txt", "a\n");
    put(fix, "keep.txt", "k\n");
    put(fix, "win.txt", "w\n");
    { char d[CK_P]; if (cx_fmt(d, sizeof d, "%s/tests", fix) || sy_mkdir(d, 0755)) die("tests dir"); }
    { char d[CK_P]; if (cx_fmt(d, sizeof d, "%s/tests/cases", fix) || sy_mkdir(d, 0755)) die("cases dir");
      if (cx_fmt(d, sizeof d, "%s/agentwork", fix) || sy_mkdir(d, 0755)) die("work dir"); }
    put(fix, "tests/slice-freeze.tsv",
        "# path_glob\ttargets\tbatches\tnote\n"
        "frozen.txt\tlnx/x86_64\tdemo-batch\tfixture surface\n"
        "win.txt\twin/x86_64,win/arm64\tdemo-batch\twin surface\n");
    put(fix, "tests/batches.tsv",
        "id\timplementation\tlayer\tsource\tmode\tplatform\tbudget_seconds\tmaterials\tentry\targs\tcoverage\texpect\theaders\n"
        "demo-batch\tIMPLEMENTED\tcontract\ttests/cases/demo.cx\tSOURCE\tlnx/x86_64\t55\t-\ttests/cases/demo.cx\t-\tcontract.demo\trc0:DEMO\tproduct\n");
    put(fix, "tests/cases/demo.cx", "int main(void){return 0;}\n");
    put(fix, "agentwork/ledger.tsv", "时间\tid\t事件\tcommit\t证据\t角色/模型\n");
    if (git(fix, "init", "-q", ".") ) die("git init");
    if (commit_all(fix, "base")) die("git base commit");
}
/* Exercise release-build's real dispatcher. Deliberately omit package arguments:
   the p3 usage refusal happens only AFTER rb_freeze completes, without building. */
static int release_freeze(const char *fix, char *out, size_t cap) {
    char exe[CK_P];
    char *v[] = {exe, "p3", (char *)fix, 0};
    if (cx_fmt(exe, sizeof exe, "%s/release-build.elf", work)) die("path");
    return run(root, v, out, cap);
}
static int same_file(const char *a, const char *b) {
    size_t an = 0, bn = 0;
    char *ab = cx_read(a, &an), *bb = cx_read(b, &bn);
    int same = ab && bb && an == bn && memcmp(ab, bb, an) == 0;
    free(ab); free(bb); return same;
}
static void release_snapshots(void) {
    char d[CK_P], dev[CK_P], snap[CK_P], a[CK_P], b[CK_P], out[32768], rev[80];
    int mode, rc;
    /* Prepared native tools are inputs; all release dispatcher assertions still run. */
    for (mode = 0; mode < 5; mode++) {
        int failed_before = failed;
        if (cx_fmt(d, sizeof d, "%s/release-%d", work, mode) || sy_mkdir(d, 0755)) die("release dir");
        put(d, "tracked.txt", "snapshot source\n");
        if (git(d, "init", "-q", ".") || commit_all(d, "snapshot")) die("release git");
        if (cx_fmt(a, sizeof a, "%s/out", d) || sy_mkdir(a, 0755)) die("release out");
        { char *v[] = {"git", "rev-parse", "HEAD", 0};
          if (run(d, v, rev, sizeof rev)) die("release rev"); rev[10] = 0; }
        if (cx_fmt(snap, sizeof snap, "%s/release-snap-%s", a, rev)) die("release snap");
        put(d, "unisacc.com.build.json", "{\n  \"epoch\": 47, \"retained\": \"exact bytes\"\n}\n");
        if (!mode) {
            size_t n = 0; char *pkg = pp_read_package(root, &n);
            /* A runnable shell prefix plus the installed footer-backed package.
               Prefixing preserves the footer's end-relative package span. */
            const char *prefix = "#!/bin/sh\nexit 0\n";
            size_t pn = strlen(prefix); char *ape;
            if (!pkg) die("ape package");
            ape = malloc(pn + n); if (!ape) die("ape allocation");
            if (mm_copy(ape, (long)(pn + n), prefix, (long)pn) ||
                mm_copy(ape + pn, (long)n, pkg, (long)n)) die("ape copy");
            if (cx_fmt(a, sizeof a, "%s/unisacc.com", d) || cx_write(a, ape, pn + n)) die("ape fixture");
            free(ape); free(pkg);
            if (strcmp(pp_layout_name(pp_layout(d)), "ape")) die("ape fixture layout");
        } else {
            size_t n = 0; char *bytes;
            put(d, "unisacc.com", "#!/bin/sh\nexec \"$(dirname \"$0\")/unisacc.com.dev/entry.elf\" \"$@\"\n");
            if (cx_fmt(dev, sizeof dev, "%s/unisacc.com.dev", d) || sy_mkdir(dev, 0755)) die("split dir");
            if (mode != 3) {
                if (cx_fmt(a, sizeof a, "%s/unisacc.com.dev/entry.elf", root)) die("entry source");
                struct stat entry_stat;
                if (lstat(a, &entry_stat)) {
                    int entry_error = errno;
                    if (entry_error != ENOENT) {
                        fprintf(stderr, "entry source stat path=%s errno=%d\n", a, entry_error);
                        die("entry source stat");
                    }
                    /* An APE root has no split entry. Copy the executable this
                       check just built; the fixture only compares its bytes. */
                    if (cx_fmt(a, sizeof a, "%s/release-build.elf", work)) die("entry fallback path");
                    if (lstat(a, &entry_stat)) {
                        fprintf(stderr, "entry fallback stat path=%s errno=%d\n", a, errno);
                        die("entry fallback stat");
                    }
                }
                bytes = cx_read(a, &n);
                if (!bytes || cx_fmt(a, sizeof a, "%s/entry.elf", dev) || cx_write(a, bytes, n) || sy_chmod(a, 0755)) die("entry fixture");
                free(bytes);
            }
            bytes = pp_read_package(root, &n);
            if (!bytes || cx_fmt(a, sizeof a, "%s/p3-package.bin", dev) || cx_write(a, bytes, n)) die("split package");
            free(bytes);
            if (mode >= 2) {
                put(d, "ape-receipt.txt", "NOT_RELEASE\nentry\tunisacc.com.dev/entry.elf\npackage\tunisacc.com.dev/p3-package.bin\nextra\tunisacc.com.dev/resource.bin\n");
                if (mode != 4) put(dev, "resource.bin", "receipt resource bytes\n");
            }
        }
        rc = release_freeze(d, out, sizeof out);
        put(d, "release-output.txt", out);
        { char status[80];
          if (cx_fmt(status, sizeof status, "rc=%d\n", rc)) die("release status");
          put(d, "release-status.txt", status); }
        if (mode >= 3) {
            if (cx_fmt(a, sizeof a, "%s/.release-rev", snap) ||
                cx_fmt(b, sizeof b, "%s/unisacc.com.build.json", snap)) die("refusal path");
            ck(rc > 0 && sy_exists(a) == 1 && sy_exists(b) == 0,
               mode == 3 ? "release.missing-entry-refused" : "release.missing-receipt-member-refused");
            if (failed != failed_before) fprintf(stderr, "release fixture=%s rc=%d\n%s\n", d, rc, out);
            continue;
        }
        { const char *members[] = {"unisacc.com", "unisacc.com.build.json", "unisacc.com.dev/entry.elf", "unisacc.com.dev/p3-package.bin", "unisacc.com.dev/resource.bin"};
          int i, count = mode == 0 ? 2 : mode == 1 ? 4 : 5, same = 1;
          for (i = 0; i < count; i++) {
              if (cx_fmt(a, sizeof a, "%s/%s", d, members[i]) || cx_fmt(b, sizeof b, "%s/%s", snap, members[i])) die("member path");
              if (!same_file(a, b)) same = 0;
          }
          ck(rc == 1 && same, mode == 0 ? "release.ape-bytes-and-build-record" : mode == 1 ? "release.split-bytes-and-build-record" : "release.receipt-bytes-and-build-record"); }
        if (!mode) {
            if (cx_fmt(a, sizeof a, "%s/unisacc.com.dev", snap)) die("ape dev path");
            ck(sy_exists(a) == 0, "release.ape-no-fake-dev");
        }
        if (failed != failed_before) fprintf(stderr, "release fixture=%s rc=%d\n%s\n", d, rc, out);
    }
}
static int field_is(const char *line, long n, int field, const char *want) {
    long at, len;
    return !tx_field(line, n, '\t', field, &at, &len) &&
           len == (long)strlen(want) && !memcmp(line + at, want, (size_t)len);
}
static void six_target_receipts(void) {
    const char *leaves[] = {"sl-lnx", "sl-lnx-arm64", "sl-osx-x86_64", "sl-osx-arm64", "sl-win-x86_64", "sl-win-arm64"};
    const char *targets[] = {"lnx/x86_64", "lnx/arm64", "osx/x86_64", "osx/arm64", "win/x86_64", "win/arm64"};
    char d[CK_P], head[CK_P], base[CK_P], p[CK_P], out[32768], status[80];
    int seen[6] = {0}, i, j, rc, valid = 1, rows = 0;
    long at = 0, n;
    if (cx_fmt(d, sizeof d, "%s/six-targets", work) || sy_mkdir(d, 0755)) die("six targets dir");
    base_repo(d);
    put(d, "frozen.txt", "changed\n");
    put(d, "tests/cases/demo.cx", "int main(void){return 1;}\n");
    put(d, "agentwork/ledger.tsv", "时间\tid\t事件\tcommit\t证据\t角色/模型\n"
        "2026-11-06T00:00\t-\tSLICE-CHANGE\tabc\tA all frozen.txt\tcc omp-go\n");
    if (commit_all(d, "hit with case and approval")) die("six targets commit");
    if (cx_fmt(head, sizeof head, "%s/head", d) || sy_mkdir(head, 0755) ||
        cx_fmt(base, sizeof base, "%s/base", d) || sy_mkdir(base, 0755)) die("six targets receipts");
    for (i = 0; i < 6; i++) {
        if (cx_fmt(p, sizeof p, "%s/%s", head, leaves[i]) || sy_mkdir(p, 0755)) die("head receipt");
        put(p, "receipt.txt", i == 0 ? "sha\t2222\n" : "sha\t1111\n");
        if (cx_fmt(p, sizeof p, "%s/%s", base, leaves[i]) || sy_mkdir(p, 0755)) die("base receipt");
        put(p, "receipt.txt", "sha\t1111\n");
    }
    { char *v[] = {"check", "HEAD~1", "HEAD", "--receipts", head, "--baseline", base, "--mode", "enforce", 0};
      rc = tool(d, v, out, sizeof out); }
    put(d, "slice-output.txt", out);
    if (cx_fmt(status, sizeof status, "rc=%d\n", rc)) die("six targets status");
    put(d, "slice-status.txt", status);
    n = (long)strlen(out);
    while (at < n) {
        long end = at;
        while (end < n && out[end] != '\n') end++;
        if (field_is(out + at, end - at, 0, "SLICE_BYTES")) {
            int found = 0;
            rows++;
            for (j = 0; j < 6; j++) {
                if (!field_is(out + at, end - at, 1, targets[j])) continue;
                found = 1; seen[j]++;
                if (!field_is(out + at, end - at, 2, j == 0 ? "AFFECTED" : "ok") ||
                    !field_is(out + at, end - at, 3, "1111") ||
                    !field_is(out + at, end - at, 4, j == 0 ? "2222" : "1111")) valid = 0;
            }
            if (!found) valid = 0;
        }
        at = end + 1;
    }
    for (i = 0; i < 6; i++) if (seen[i] != 1) valid = 0;
    valid = valid && rc == 0 && rows == 6;
    ck(valid, "slugs.six-target-receipt-contract");
    if (!valid) fprintf(stderr, "six targets fixture=%s rc=%d\n%s\n", d, rc, out);
}
int main(int argc, char **argv) {
    char out[1 << 15], fix[CK_P], before[4096], after[4096], rdir[CK_P], bdir[CK_P];
    int prepare = argc == 3 && !strcmp(argv[1], "--prepare");
    if (argc != 2 && !prepare) die("usage ABS_OUT | --prepare ABS_OUT");
    if (sy_realpath(".", root, (int)sizeof root) < 0) die("cwd");
    const char *dest = argv[prepare ? 2 : 1];
    if (dest[0] != '/' || cx_fmt(work, sizeof work, "%s", dest)) die("absolute output required");
    if (prepare) {
        char exe[CK_P], why[512]; int reused;
        if (sy_mkdir(work, 0700) && sy_exists(work) != 1) die("prepare directory");
        if (rn_prepare(root, "tools/slice-freeze.cx", work, exe, sizeof exe, &reused, why, sizeof why)) die(why);
        char alias[CK_P];
        if (cx_fmt(alias, sizeof alias, "%s/slice-freeze.elf", work)) die("slice prepared path");
        if (sy_exists(alias)==1 && sy_unlink(alias)) die("slice old prepared link");
        if (sy_symlink(exe, alias)) die("slice prepared link");
        if (rn_prepare(root, "tools/release-build.cx", work, exe, sizeof exe, &reused, why, sizeof why)) die(why);
        if (cx_fmt(alias, sizeof alias, "%s/release-build.elf", work)) die("release prepared path");
        if (sy_exists(alias)==1 && sy_unlink(alias)) die("release old prepared link");
        if (sy_symlink(exe, alias)) die("release prepared link");
        return 0;
    }
    { char prepared[CK_P], exe[CK_P], alias[CK_P];
    { char expected[CK_P], alias[CK_P], actual[CK_P], why[512]; int reused;
      const char *sources[]={"tools/slice-freeze.cx","tools/release-build.cx"};
      const char *names[]={"slice-freeze.elf","release-build.elf"};
      for(int i=0;i<2;i++) {
          if(rn_prepare(root,sources[i],work,expected,sizeof expected,&reused,why,sizeof why)) die(why);
          if(cx_fmt(alias,sizeof alias,"%s/%s",work,names[i]) || !realpath(alias,actual) || strcmp(actual,expected)) die("prepared native identity mismatch; prepare again");
      }
    }
      if (cx_fmt(prepared,sizeof prepared,"%s",work) || cx_fmt(work,sizeof work,"%s/run-%d",prepared,sy_pid()) || sy_mkdir(work,0700)) die("consumer directory");
      const char *names[]={"slice-freeze.elf","release-build.elf"};
      for(int i=0;i<2;i++) { if(cx_fmt(exe,sizeof exe,"%s/%s",prepared,names[i]) || cx_fmt(alias,sizeof alias,"%s/%s",work,names[i]) || sy_exists(exe)!=1 || sy_symlink(exe,alias)) die("prepared native missing"); }
    }
    { char *v[] = {(char *)"git", (char *)"status", (char *)"--short", 0}; run(root, v, before, sizeof before); }
    /* Preparation is separate and never a test verdict. */
    /* 1: hit=0 */
    { char d[CK_P];
      if (cx_fmt(d, sizeof d, "%s/hit0", work) || sy_mkdir(d, 0755)) die("dir");
      base_repo(d);
      put(d, "keep.txt", "k2\n");
      if (commit_all(d, "outside")) die("commit");
      { char *a[] = {(char *)"check", (char *)"HEAD~1", (char *)"HEAD", 0};
        ck(tool(d, a, out, sizeof out) == 0 && strstr(out, "hit=0"), "hit0.rc0"); } }
    /* 2: NO_CASE + NO_APPROVAL, advisory 0 then enforce 1 */
    { char d[CK_P];
      if (cx_fmt(d, sizeof d, "%s/redcase", work) || sy_mkdir(d, 0755)) die("dir");
      base_repo(d);
      put(d, "frozen.txt", "b\n");
      if (commit_all(d, "touch frozen")) die("commit");
      { char *a[] = {(char *)"check", (char *)"HEAD~1", (char *)"HEAD", 0};
        int rc = tool(d, a, out, sizeof out);
        ck(rc == 0 && strstr(out, "SLICE_HIT\tfrozen.txt") != 0, "hit.one-line");
        ck(strstr(out, "case=NO_CASE") && strstr(out, "approval=NO_APPROVAL"), "red.both-missing");
        ck(strstr(out, "SLICE_FREEZE_WOULD_FAIL") != 0, "advisory.would-fail-line");
        { char *e[] = {(char *)"check", (char *)"HEAD~1", (char *)"HEAD", (char *)"--mode", (char *)"enforce", 0};
          ck(tool(d, e, out, sizeof out) == 1, "enforce.rc1"); } }
      /* 3: add a case for the hit batch + a cc approval -> ok (bytes unmeasured, no receipts) */
      put(d, "tests/cases/demo.cx", "int main(void){return 1;}\n");
      put(d, "agentwork/ledger.tsv", "时间\tid\t事件\tcommit\t证据\t角色/模型\n"
          "2026-11-06T00:00\t-\tSLICE-CHANGE\tabc\tA all frozen.txt\tcc omp-go\n");
      if (commit_all(d, "case+approval")) die("commit");
      { char *e[] = {(char *)"check", (char *)"HEAD~2", (char *)"HEAD", (char *)"--mode", (char *)"enforce", 0};
        int rc = tool(d, e, out, sizeof out);
        ck(strstr(out, "case=ok") != 0, "case.ok");
        ck(strstr(out, "approval=ok") != 0, "approval.ok");
        ck(rc == 1 && strstr(out, "bytes=UNMEASURED"), "bytes.unmeasured-not-pass"); } }
    /* 4: receipts -- DRIFT on an undeclared target, AFFECTED on a declared one */
    { char d[CK_P];
      if (cx_fmt(d, sizeof d, "%s/receipts", work) || sy_mkdir(d, 0755)) die("dir");
      base_repo(d);
      if (cx_fmt(rdir, sizeof rdir, "%s/r-head", d) || sy_mkdir(rdir, 0755)) die("dir");
      if (cx_fmt(bdir, sizeof bdir, "%s/r-base", d) || sy_mkdir(bdir, 0755)) die("dir");
      receipt(rdir, "sl-lnx", "lnx/x86_64", "1111"); receipt(bdir, "sl-lnx", "lnx/x86_64", "1111");
      receipt(rdir, "sl-win-x86_64", "win/x86_64", "2222"); receipt(bdir, "sl-win-x86_64", "win/x86_64", "9999");
      put(d, "frozen.txt", "c\n");
      if (commit_all(d, "touch again")) die("commit");
      { char *a[] = {(char *)"check", (char *)"HEAD~1", (char *)"HEAD", (char *)"--receipts", rdir,
                     (char *)"--baseline", bdir, (char *)"--mode", (char *)"enforce", 0};
        int rc = tool(d, a, out, sizeof out);
        ck(strstr(out, "SLICE_BYTES\tlnx/x86_64\tAFFECTED") != 0, "bytes.declared-affected");
        ck(strstr(out, "SLICE_BYTES\twin/x86_64\tDRIFT") != 0, "bytes.drift-detected");
        ck(rc == 1, "bytes.drift-not-ok"); }
      /* 5: a missing receipt is UNMEASURED, never ok */
      { char d2[CK_P], r2[CK_P];
        if (cx_fmt(d2, sizeof d2, "%s/missing", work) || sy_mkdir(d2, 0755)) die("dir");
        if (cx_fmt(r2, sizeof r2, "%s/r-none", d2) || sy_mkdir(r2, 0755)) die("dir");
        receipt(r2, "sl-lnx", "lnx/x86_64", "1111");
        { char m[CK_P]; if (cx_fmt(m, sizeof m, "%s/sl-win-x86_64", r2) || sy_mkdir(m, 0755)) die("dir"); }
        { char *a[] = {(char *)"check", (char *)"HEAD~1", (char *)"HEAD", (char *)"--receipts", r2,
                       (char *)"--baseline", bdir, 0};
          int rc = tool(d, a, out, sizeof out);
          ck(rc == 0 && strstr(out, "bytes=UNMEASURED"), "receipt.missing-unmeasured"); } } }
    /* 6: list refusals -- unknown batch, glob matching nothing */
    { char d[CK_P];
      if (cx_fmt(d, sizeof d, "%s/badlist", work) || sy_mkdir(d, 0755)) die("dir");
      base_repo(d);
      put(d, "tests/slice-freeze.tsv",
          "# path_glob\ttargets\tbatches\tnote\nfrozen.txt\tall\tno-such-batch\tfixture\n");
      if (commit_all(d, "bad batch")) die("commit");
      { char *l[] = {(char *)"list", 0}; ck(tool(d, l, out, sizeof out) == 2, "list.unknown-batch-refused"); }
      put(d, "tests/slice-freeze.tsv",
          "# path_glob\ttargets\tbatches\tnote\nno/such/file.tsv\tall\tdemo-batch\tfixture\n");
      if (commit_all(d, "bad glob")) die("commit");
      { char *l[] = {(char *)"list", 0}; ck(tool(d, l, out, sizeof out) == 2, "list.glob-matching-nothing-refused"); } }
    release_snapshots();
    six_target_receipts();
    { char *v[] = {(char *)"git", (char *)"status", (char *)"--short", 0}; run(root, v, after, sizeof after); }
    ck(strcmp(before, after) == 0, "repo.untouched");
    fprintf(stderr, "check-slice-freeze: retained fixtures=%s\n", work);
    printf("CHECK_SLICE_FREEZE\tchecks=%d\tfailed=%d\n", checks, failed);
    return failed ? 1 : 0;
}
