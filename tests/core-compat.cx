/* ROOT. Default-run module contract only: exact source eligibility and receipt
 * bytes, not rebuilt product/runtime behavior or archived PASS evidence.
 * Inputs stay on disk unchanged; all negative mutations are private memory. */
#pragma unisa use cxlib.corecompat
#pragma unisa use text.text
static int assertions,failures;
static const char *baseline="6845345a6d2a38bd97221eaf657970f755b69226e4670aab8d624711ea5d24d1";
static const char *oldcopy="    memcpy(t->entries[t->n].b,b,n); t->entries[t->n].n=n;";
static const char *guard="    if(n)memcpy(t->entries[t->n].b,b,n); t->entries[t->n].n=n;";
static void die(const char *s){fprintf(stderr,"core-compat: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void ck(int ok,const char *name){assertions++;if(!ok)failures++;printf("%s\tcore-compat.%s\n",ok?"PASS":"FAIL",name);}
static char *load(const char *root,const char *rel,size_t *n){char p[4400];int z=snprintf(p,sizeof p,"%s/%s",root,rel);struct stat st;if(z<0||(size_t)z>=sizeof p||lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>16777216)die("regular bounded input");char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("input extent");return s;}
static char *replace(const char *s,size_t n,const char *from,const char *to,size_t *outn){size_t fn=strlen(from),tn=strlen(to);const char *at=strstr(s,from);if(!at||strstr(at+1,from))die("unique mutation anchor");size_t prefix=(size_t)(at-s);char *b=malloc(n-fn+tn+1);if(!b)die("mutation allocation");memcpy(b,s,prefix);memcpy(b+prefix,to,tn);memcpy(b+prefix+tn,at+fn,n-prefix-fn);*outn=n-fn+tn;b[*outn]=0;return b;}
static void reject(const char *s,size_t n,const char *from,const char *to,const char *name){size_t z;char *b=replace(s,n,from,to,&z);ck(cc_kind(b,z)==-1,name);free(b);}
int main(int argc,char **argv){
 char root[4096];if(argc!=2||!realpath(argv[1],root))die("usage ROOT");size_t n,hn,on;char *s=load(root,"archive/reference-c/exec/c/core.c",&n),*helper=load(root,"tools/cxlib/corecompat.cx",&hn);char current[65],helper_sha[65],h[65];cx_sha256_hex(s,n,current);cx_sha256_hex(helper,hn,helper_sha);
 printf("SOURCE\tcore=%s\tcompat-helper=%s\n",current,helper_sha);ck(cc_kind(s,n)==1,"current-exact-guard-approved-one");
 char *old=replace(s,n,guard,oldcopy,&on);cx_sha256_hex(old,on,h);ck(tx_eq(h, baseline, 1L << 20),"reverse-is-pinned-full-old-file");ck(cc_kind(old,on)==0,"reverse-approved-zero-not-guarded");
 char *b=malloc(n+strlen(guard)+2);if(!b)die("mutation allocation");memcpy(b,s,n);b[0]=(char)(b[0]^1);ck(cc_kind(b,n)==-1,"side-byte-refused");memcpy(b,s,n);memcpy(b+n,guard,strlen(guard));b[n+strlen(guard)]='\n';ck(cc_kind(b,n+strlen(guard)+1)==-1,"duplicate-guard-refused");free(b);
 reject(s,n,guard,"","deleted-copy-line-refused");
 reject(s,n,"if(n)memcpy(t->entries[t->n].b,b,n)","if(1)memcpy(t->entries[t->n].b,b,n)","unconditional-guard-refused");
 reject(s,n,"if(n)memcpy(t->entries[t->n].b,b,n)","if(n>0)memcpy(t->entries[t->n].b,b,n)","equivalent-spelling-still-refused");
 reject(s,n,"t->entries[t->n].b=core_alloc(0,(size_t)n+1);","t->entries[t->n].b=core_alloc(0,(size_t)n+2);","allocation-n-plus-one-contract-refused");
 reject(s,n,"t->cap=t->cap ? t->cap*2 : 64;","t->cap=t->cap ? t->cap*2 : 65;","initial-capacity-refused");
 reject(s,n,"t->cap=t->cap ? t->cap*2 : 64;","t->cap=t->cap ? t->cap*3 : 64;","capacity-growth-refused");
 b=malloc(n+1);if(!b)die("mutation allocation");memcpy(b,s,n);b[n]=0;ck(cc_kind(b,n+1)==-1,"extra-NUL-byte-refused");free(b);ck(cc_kind(s,n-1)==-1,"truncation-refused");
 np_buf receipt={0},expected={0};cc_receipt(&receipt,current,helper_sha);np_puts(&expected,"core-source-compat\tcore-badd-empty-copy-guard-v1\t");np_puts(&expected,baseline);np_puts(&expected,"\t");np_puts(&expected,current);np_puts(&expected,"\ncompat-tool\t");np_puts(&expected,helper_sha);np_puts(&expected,"\n");ck(receipt.n==expected.n&&!memcmp(receipt.p,expected.p,expected.n),"exact-receipt-binds-full-current-and-helper-SHA");
 size_t again_n;char *again=load(root,"archive/reference-c/exec/c/core.c",&again_n);ck(n==again_n&&!memcmp(s,again,n),"core-physically-reread-unchanged");free(again);again=load(root,"tools/cxlib/corecompat.cx",&again_n);ck(hn==again_n&&!memcmp(helper,again,hn),"helper-physically-reread-unchanged");free(again);
 free(receipt.p);free(expected.p);free(old);free(helper);free(s);puts("NOT_CLAIMED\tpackage-refresh-execution-product-rebuild-runtime-safety-or-general-ABI-equivalence");puts("TIMING\tstartup_construction_loading_output_validation_cold_hot=UNMEASURED");printf("CORE_COMPAT\tassertions=%d\tfailed=%d\tscope=one-pinned-full-file-source-transition\n",assertions,failures);return failures?1:0;
}
