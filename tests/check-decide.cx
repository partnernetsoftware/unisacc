/* tests/check-decide.cx -- a decision table and its generated net rows agree, key by key. */
#pragma unisa use cxlib.netpack
int main(void) {
    char *v[] = {"sh", "./unisacc.com", "tools/decide-gen.cx", "--", "--check", "weights/arity/arity.tsv", "AR", "AR.ask", "exec/parse2/aritydecide-result.tsv", 0};
    np_result r = {0}; char why[512]; int rc = np_run(v, ".", 0, 40, &r, why, sizeof why);
    if (r.errn) fwrite(r.err, 1, r.errn, stderr);
    if (rc || r.rc) { puts("DECIDE_CHECK\tstatus=FAIL"); np_free(&r); return 1; }
    np_free(&r); puts("DECIDE_CHECK\tstatus=PASS"); return 0;
}
