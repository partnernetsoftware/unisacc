    /* 2026-10-23 unisa/ detach W1-D: the K6 C references seed/unisa_*.c are judged by one runner against frozen tables
       (tests/k6frozen.cx over tests/k6/NAME.tsv; the gate's `for n in ...; do job k6-$n ...` line).  The old per-module
       harnesses (unisa-NAME, tests/unisa*check.sh; three of them declared here, the rest hand entries) are dropped. */
    {
        static const char *const k6[] = { "bits", "hostabi", "peversion", "padded", "zdata", "linalg", "libneed", "uns1",
            "catalog", "fp", "tape", "tapebin", "tapebin-shape", "image-fat", "image-elf", "image-macho", "image-pe", "ape",
            "vm", "emit-arm-nwmem", 0 };
        int j;
        for (j = 0; k6[j]; j++) {
            char old[64], name[64], src[64], lit[2048]; size_t c;
            snprintf(old, sizeof old, "unisa-%s", k6[j]); snprintf(name, sizeof name, "k6-%s", k6[j]);
            snprintf(src, sizeof src, "%s", k6[j]);
            for (c = 0; src[c]; c++) if (src[c] == '-') src[c] = '_';
            if (ogetn(suites, old, strlen(old))) { odel(suites, old, strlen(old)); changed(old, "dropped"); }
            snprintf(lit, sizeof lit, "{\n"
                "'command': ['tests/bound', '58', 'sh', './tests/cxbin', 'tests/k6frozen.cx', '%s'],\n"
                "'files': ['tests/k6frozen.cx', 'tests/cxlib/pytempfile.cx', 'tests/k6/%s.tsv', 'seed/unisa_%s.c',\n"
                "'tests/cxbin', 'tests/bound', 'tests/bound.c', 'unisacc.com'%s]}", k6[j], k6[j], src,
                strcmp(k6[j], "tapebin-shape") ? ""
                    : ", 'docs/tapebin-v1.shape.tsv', 'docs/tapebin-v1.records.tsv', 'src/tapebin_shape.inc'");
            oset(suites, name, pylit(lit));
        }
        changed("k6-frozen", "declared k6-* (dropped unisa-* K6 harness entries)");
    }
