        if (uses) { J *ls[2] = {files, pylit("['tests/cxlib/libffiprovider.cx']")}, *g = oget(unit, "guards"); if (!g) { g = jnew(JOBJ); oset(unit, "guards", g); } oset(unit, "files", sorted_union(ls, 2));
