    /* DRAFT callable scopes: inherit every original checker and producer input. */
    { J *wire = jcopy(need(suites, "lib-callable-model")), *var = oget(suites, "lib-callable-variadic-model"), *prep = need(suites, "exec-chain-model-prepare");
      if (!var) var = need(suites, "lib-callable-variadic-model-promoted"); var = jcopy(var);
