    /* Each original producer step is independently scheduled. Every step keeps
       its former group's complete conservative declaration, never a smaller slice. */
    {   static const char *owners[] = { "exec/parse2/librarytypedreadercheck.sh", "exec/parse2/librarycallsitecheck.sh",
            "exec/lower/librarytypedcheck.sh", "exec/lower/librarycallsitecheck.sh", "exec/lower/librarydatacheck.sh",
            "tests/librarycallbacke3check.sh", "tests/librarycallbacklowercheck.sh", "tests/librarycallbackwiringcheck.sh",
            "tests/librarycallbackauthcheck.sh", 0 };
        static const char *fields[] = { "files", "trees", "tools" };
        char *a[] = { "sh", "tests/gate.sh", "--plan", 0 }; size_t n;
        char *raw = run(a, 55, &n, 1);
        J *jobs = parse_gate_plan(raw, n), *groups = need(jload("tests/prepgroups.json"), "groups");
        J *active = jnew(JOBJ), *groupnames = jnew(JOBJ), *steps = jnew(JOBJ), *pgl = jnew(JARR), *ls[2];
        int g, j, r, z, count = 0;
        apush(pgl, jstr("tests/prepgroups.json")); apush(pgl, jstr("tests/suite/prepdecl.cx"));
        apush(pgl, jstr("tests/cxlib/pyjson.cx"));
        if (groups->t != JARR) die("prepgroups groups is not a list", 0);
        for (i = 0; i < jobs->n; i++) {
            J *nm = need(jobs->v[i], "name");
            osetn(active, nm->s, nm->sn, need(jobs->v[i], "command"));
        }
        for (g = 0; g < groups->n; g++) {
            J *nm = need(groups->v[g], "name");
            if (nm->t != JSTR || ogetn(groupnames, nm->s, nm->sn)) die("duplicate or invalid preparation group", 0);
            osetn(groupnames, nm->s, nm->sn, groups->v[g]);
        }
        for (g = 0; g < groups->n; g++) {
            J *row = groups->v[g], *nm = need(row, "name"), *members = need(row, "members"), *base, *entry, *guards;
            J **fl; int ex = 0; char *groupname = xstrndup(nm->s, nm->sn);
            if (members->t != JARR || !members->n) die("empty or invalid preparation members", groupname);
            base = ogetn(suites, nm->s, nm->sn);
            if (!base) { J *first = need(members->v[0], "step"); base = ogetn(suites, first->s, first->sn); }
            if (base && base->t != JOBJ) die("invalid inherited preparation declaration", groupname);
            entry = base ? jcopy(base) : jnew(JOBJ);
            if (truthy(oget(entry, "family"))) die("preparation-owner-family-needs-flattening", groupname);
            ex = truthy(oget(entry, "executable_inputs"));
            guards = oget(entry, "guards");
            if (guards && guards->t != JOBJ) die("guards is not a dict", groupname);
            guards = guards ? jcopy(guards) : jnew(JOBJ);
            fl = xmalloc((size_t)(members->n + 1) * sizeof *fl);
            for (r = 0; r < 3; r++) {
                fl[0] = oget(entry, fields[r]);
                for (j = 0; j < members->n; j++) {
                    J *ow = need(members->v[j], "declaration_owner"), *owner;
                    if (ow->t != JSTR || !(owner = ogetn(suites, ow->s, ow->sn))) die("preparation-declaration-owner-missing", groupname);
                    if (owner->t != JOBJ || truthy(oget(owner, "family"))) die("preparation-owner-family-needs-flattening", groupname);
                    fl[j + 1] = oget(owner, fields[r]);
                }
                oset(entry, fields[r], sorted_union(fl, members->n + 1));
            }
            for (j = 0; j < members->n; j++) {
                J *ow = need(members->v[j], "declaration_owner"), *owner = need(suites, ow->s), *guard = oget(owner, "guards");
                if (truthy(oget(owner, "executable_inputs"))) ex = 1;
                if (!guard) continue;
                if (guard->t != JOBJ) die("guards is not a dict", groupname);
                for (z = 0; z < guard->n; z++) {
                    J *prev = ogetn(guards, guard->k[z], guard->kn[z]);
                    if (prev && !jeq(prev, guard->v[z])) die("preparation-owner-guard-conflict", groupname);
                    osetn(guards, guard->k[z], guard->kn[z], guard->v[z]);
                }
            }
            oset(entry, "executable_inputs", jnew(ex ? JTRUE : JFALSE));
            ls[0] = oget(entry, "files"); ls[1] = pgl; oset(entry, "files", sorted_union(ls, 2));
            for (r = 0; r < pgl->n; r++) {
                size_t size; char hex[65], *bytes = cx_read(pgl->v[r]->s, &size);
                if (!bytes) die("cannot read preparation declaration input", pgl->v[r]->s);
                cx_sha256_hex(bytes, size, hex); free(bytes); oset(guards, pgl->v[r]->s, jstr(hex));
            }
            oset(entry, "guards", guards);
            for (j = 0; j < members->n; j++) {
                J *member = members->v[j], *step = need(member, "step"), *command = need(member, "argv"), *actual, *unit;
                if (step->t != JSTR || command->t != JARR || !command->n || ogetn(steps, step->s, step->sn) || ogetn(groupnames, step->s, step->sn))
                    die("duplicate or invalid preparation step", groupname);
                for (z = 0; z < command->n; z++) if (command->v[z]->t != JSTR) die("member argv is not str", groupname);
                actual = ogetn(active, step->s, step->sn);
                if (!actual || !jeq(actual, command)) die("preparation-command-mismatch", step->s);
                osetn(steps, step->s, step->sn, member);
                unit = jcopy(entry); oset(unit, "command", jcopy(command)); osetn(suites, step->s, step->sn, unit); count++;
            }
            if (ogetn(suites, nm->s, nm->sn)) odel(suites, nm->s, nm->sn);
            free(fl); free(groupname);
        }
        ls[0] = oget(need(suites, "gate-layers"), "files"); ls[1] = pgl;
        oset(need(suites, "gate-layers"), "files", sorted_union(ls, 2));
        /* Preserve consumer declarations; update only their already-prepared argv. */
        for (i = 0; i < jobs->n; i++) {
            J *job = jobs->v[i], *name = need(job, "name"), *argvj = need(job, "command"); int matches = 0, req = 0;
            if (ogetn(steps, name->s, name->sn)) continue;
            for (r = 0; owners[r] && !matches; r++) for (j = 0; j < argvj->n; j++) {
                J *x = argvj->v[j]; const char *s = x->s; size_t sn = x->sn;
                if (sn >= 2 && s[0] == '.' && s[1] == '/') { s += 2; sn -= 2; }
                if (sn == strlen(owners[r]) && !memcmp(s, owners[r], sn)) { matches = 1; break; }
            }
            if (matches && ogetn(suites, name->s, name->sn)) {
                for (j = 0; j < argvj->n; j++) if (jstreq(argvj->v[j], "--require-cached")) req = 1;
                if (req) oset(ogetn(suites, name->s, name->sn), "command", argvj);
            }
        }
        if (oget(suites, "exec-prepare-reader-typed")) odel(suites, "exec-prepare-reader-typed", strlen("exec-prepare-reader-typed"));
        if (oget(suites, "exec-prepare-reader-base-reference")) odel(suites, "exec-prepare-reader-base-reference", strlen("exec-prepare-reader-base-reference"));
        if (groups->n != 43 || count != 197) die("preparation member inventory changed", 0);
    }
    changed("prep-member-units", "declared197 preparation argv with complete group readsets; reader typed and base reference split into bounded units");
    /* Fixed part1 partition: inherit every original consumer input and tool. */
    { J *original = need(suites, "exec-librarycallbacklower-model-1"), *ls[2];
      const char *parts[] = {"off", "on"};
      for (int phase = 0; phase < 2; phase++) {
        J *unit = jcopy(original); char name[96];
        ls[0] = need(unit, "files"); ls[1] = pylit("['tests/librarycallbacklowerphase.cx']");
        oset(unit, "files", sorted_union(ls, 2));
        J *command = pylit("['sh', './unisacc.com', 'tests/librarycallbacklowerphase.cx', '--']");
        apush(command, jstr(parts[phase])); oset(unit, "command", command);
        snprintf(name, sizeof name, "exec-librarycallbacklower-model-1-%s", parts[phase]);
        oset(suites, name, unit);
      }
      odel(suites, "exec-librarycallbacklower-model-1", strlen("exec-librarycallbacklower-model-1"));
    }
    changed("callback-lower-part1-scopes", "off/on inherit complete original part1 readset and execute fresh original verdict blocks");
    {   static const char *phases[] = {"gen", "c-json", "p-json", "tbl", "net", "runner", 0};
        J *consumer = need(suites, "exec-libraryfunctionimports-model"), *ls[2];
        ls[0] = oget(consumer, "files"); ls[1] = pylit("['tests/cxbin', 'tests/safedel.cx']");
        oset(consumer, "files", sorted_union(ls, 2));
        ls[0] = oget(consumer, "tools"); ls[1] = pylit("['cat', 'mv', 'rmdir', 'openssl', 'uname', 'id', 'chmod']");
        oset(consumer, "tools", sorted_union(ls, 2));
        if (oget(suites, "exec-libraryfunctionimports-prepare")) odel(suites, "exec-libraryfunctionimports-prepare", strlen("exec-libraryfunctionimports-prepare"));
        for (i = 0; phases[i]; i++) {
            char name[128], flag[64]; J *prep = jcopy(consumer), *cmd = jnew(JARR);
            snprintf(name, sizeof name, "exec-libraryfunctionimports-prepare-%s", phases[i]);
            snprintf(flag, sizeof flag, "--prepare-%s", phases[i]);
            apush(cmd, jstr("./exec/parse2/libraryfunctionimportscheck.sh")); apush(cmd, jstr(flag));
            oset(prep, "command", cmd); oset(suites, name, prep);
        }
        oset(consumer, "command", pylit("['./exec/parse2/libraryfunctionimportscheck.sh', '--require-cached']"));
    }
    changed("libraryfunctionimports-preparation", "cloned complete consumer declaration for six atomic preparation phases");
    oset(suites, "suite-tools-native", pylit("{'command': ['tests/bound', '55', 'sh', './unisacc.com', 'tests/suite/check.cx'], 'files': ['tests/suite/check.cx', 'tests/suite/run.cx', 'tests/suite/catalog.cx', 'tests/suite/graph.cx', 'tests/suite/prepdecl.cx', 'tests/cxlib/pyjson.cx', 'tests/prepgroups.json', 'tests/safedel.cx', 'tests/bound', 'tests/bound.c', 'tests/bound.py', 'unisacc.com', 'unisacc.com.build.json'], 'trees': ['include'], 'executable_inputs': True, 'tools': ['sleep', 'cat', 'mkdir', 'rm', 'mv', 'rmdir', 'chmod', 'uname', 'sh']}"));
    { J *unit = jcopy(need(suites, "suite-tools-native"));
      oset(unit, "command", pylit("['tests/bound', '55', 'sh', './unisacc.com', 'tests/suite/check.cx', '--', '--fail-fast']"));
      oset(suites, "tools-suite-failfast-run", unit);
    }
    /* 0.0.44 (cc ruling): fixed declarations the derivation does not produce.  The two hard-coded declarations above
       (gate-layers, gate-select) omit files their gates read; they are added here from one table, never by a branch.
       Appended in table order; existing order and all other suites are untouched. */
    {   static const char *extra[][3] = { { "gate-layers", "tests/checklib.py", 0 }, { "gate-select", ".gitignore", "tests/checklib.py" } };
        for (k = 0; k < 2; k++) {
            J *files = need(need(suites, extra[k][0]), "files");
            if (files->t != JARR) die("files is not a list", extra[k][0]);
            for (i = 1; i < 3 && extra[k][i]; i++) { J *x = jstr(extra[k][i]); if (!lhas(files, x)) apush(files, x); }
        }
    }

    /* F3 fixtures execute these real guard files inside their private trees. */
    {   static const char *extra[][12] = {
            { "bound", "tests/linuxcleanupcheck.sh", "tests/fixturecopy.sh", "tests/linuxcleanup-files.tsv", "tests/linux.sh", "tests/cxbin", "tests/safedel.cx", "include/cx.h", "include/unisa_sha256.h", "include/unisa_safedel.h", 0 },
            { "pipeline-cache", "tests/fixturecopy.sh", "tests/pipelinecache-files.tsv", "tests/cxbin", "tests/safedel.cx", "include/cx.h", "include/unisa_sha256.h", "include/unisa_safedel.h", 0 }
        };
