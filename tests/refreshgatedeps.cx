    { J *paths = pylit("['tests/cxlib/libffiprovider.cx', 'tests/cxlib/pyjson.cx', 'tests/cxlib/runtimecopy.cx', 'tests/cxlib/pyrun.cx', 'tests/cxlib/pytempfile.cx', 'tests/cxlib/callbackgraph.cx', 'tests/cxlib/callbackcheck.cx', 'tests/cxlib/libnative.cx', 'tests/librarytypednativecheck.cx', 'tests/librarysig2nativecheck.cx', 'tests/libraryvariadicnativecheck.cx', 'tests/librarycallablevariadicnativecheck.cx', 'tests/librarycallbacknativecheck.cx', 'tests/librarycallbackforwardcheck.cx', 'tests/librarycallbackoutcomecheck.cx', 'tests/libunisaccexportcheck.cx']"), *hs = head_shas(paths);
      const char *names[] = {"lib-typed-native", "lib-sig2-native", "lib-variadic-native", "lib-callable-variadic-native", "lib-callback-native", "lib-callback-forward", "lib-callback-outcome", "lib-native-exports", "lib-module-exports", "lib-typed-rosetta", "lib-sig2-rosetta", "lib-variadic-native-rosetta", "lib-callable-variadic-native-rosetta", "lib-callback-native-rosetta", "lib-callback-forward-rosetta", "lib-callback-outcome-rosetta"};
      for (int k = 0; k < 16; k++) { J *u = need(suites,names[k]), *ls[2] = {need(u,"files"),paths}, *g = need(u,"guards"); oset(u,"files",sorted_union(ls,2)); for(int f=0;f<hs->n;f++) oset(g,hs->k[f],jcopy(hs->v[f])); }
    }
    changed("native-shared-pic-provider", "all nine host and seven Rosetta scopes retain original assertions with actual provider/module guards");
    jdump(&tb, d, 0); bputc(&tb, '\n');
    if (cx_write("tests/gatedeps.json", tb.b, tb.n)) die("cannot write", "tests/gatedeps.json");
    {   char **sa = xmalloc((size_t)(treeset->n + 5) * sizeof *sa); size_t n; char *s, *e;
        sa[0] = "git"; sa[1] = "status"; sa[2] = "--porcelain"; sa[3] = "--";
        for (t = 0; t < treeset->n; t++) sa[4 + t] = treeset->v[t]->s;
        sa[4 + treeset->n] = 0;
        s = run(sa, 60, &n, 0);
        e = s + n;
        while (s < e && (*s == ' ' || (*s >= '\t' && *s <= '\r'))) s++;          /* str.strip() */
        while (e > s && (e[-1] == ' ' || (e[-1] >= '\t' && e[-1] <= '\r'))) e--;
        *e = 0;
        printf("gatedeps: reviewed stamps from %s; changed %s\n", strcmp(REF, "HEAD") ? "the index" : "HEAD",
               NCHANGED ? (bputc(&CHANGED, ']'), CHANGED.b) : "none");
        if (*s && !strcmp(REF, "HEAD")) printf("gatedeps: note -- uncommitted changes under reviewed trees are NOT in the stamp:\n%s\n", s);
    }
    (void)root;
    return 0;
}
