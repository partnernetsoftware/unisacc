    /* Complete original eighteen-tool prepare remains a validation barrier. */
    { J *base = need(suites, "lib-union-scalar-prepare");
      const char *groups[] = {"int8,float4", "double8,mixed2", "mixed3,mixed-reordered"};
      for (int g = 0; g < 3; g++) { char name[80], cmd[400]; J *unit = jcopy(base);
        snprintf(name, sizeof name, "lib-union-scalar-prepare-group%d", g + 1);
        snprintf(cmd, sizeof cmd, "['sh', './tests/cxbin', 'tests/libraryunionscalarcheck.cx', '--prepare', '--cases', '%s', '--pressures', 'plain,gp9,fp9', '--sanitize']", groups[g]);
        oset(unit, "command", pylit(cmd)); oset(suites, name, unit);
