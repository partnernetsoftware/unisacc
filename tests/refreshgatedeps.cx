    {
        J *native = pylit("['tests/gatecanon-native', 'tests/gatecanon_native.c', 'tests/cxlib/gatecanon.cx', 'tests/cxlib/pyjson.cx', 'include/cx.h', 'include/unisa_sha256.h', 'include/unisa_safedel.h']");
