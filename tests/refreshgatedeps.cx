      oset(unit, "files", sorted_union(ls, 2));
      oset(unit, "command", pylit("['sh', './unisacc.com', 'tests/librarycontextcheck.cx', '--', '--package', '{MODEL_COM}']"));
      ls[0] = oget(unit, "tools"); if (!ls[0]) ls[0] = jnew(JARR);
      ls[1] = pylit("['cc', 'sh']"); oset(unit, "tools", sorted_union(ls, 2));
      J *guards = need(unit, "guards"), *hs = head_shas(pylit("['tests/librarycontextcheck.cx']"));
      oset(guards, "tests/librarycontextcheck.cx", need(hs, "tests/librarycontextcheck.cx"));
    }
    changed("library-context-provider", "original oracle with Linux LIBRARY_PATH PIC provider facade");
    /* Fixed pairs inherit the complete original oracle readset/tools. */
    { J *base = oget(suites, "target-package");
      if (!base) base = need(suites, "target-package-1");
      for (int part = 1; part <= 3; part++) {
        char name[64], command[256]; J *unit = jcopy(base), *ls[2];
        snprintf(name, sizeof name, "target-package-%d", part);
        snprintf(command, sizeof command, "['sh', './unisacc.com', 'tests/targetpackagephase.cx', '--', '%d', '{MODEL_COM}']", part);
        oset(unit, "command", pylit(command));
        ls[0] = need(unit, "files"); ls[1] = pylit("['tests/targetpackagephase.cx', 'unisacc.com', 'unisacc.com.build.json']");
        oset(unit, "files", sorted_union(ls, 2));
        J *guards = need(unit, "guards"), *hs = head_shas(pylit("['tests/targetpackagephase.cx', 'tests/targetpackagecheck.py']"));
        oset(guards, "tests/targetpackagephase.cx", need(hs, "tests/targetpackagephase.cx"));
        oset(guards, "tests/targetpackagecheck.py", need(hs, "tests/targetpackagecheck.py"));
        oset(suites, name, unit);
      }
      if (oget(suites, "target-package")) odel(suites, "target-package", strlen("target-package"));
    }
    changed("target-package-pairs", "three pairs preserve original closure oracle and global negatives");
    /* Reuse attested model bytes; preserve both complete preparation and oracle inputs. */
    { J *unit = need(suites, "lib-callback-source-graph"), *prep = need(suites, "exec-chain-model-prepare"), *ls[3];
      ls[0] = need(unit, "files"); ls[1] = need(prep, "files");
