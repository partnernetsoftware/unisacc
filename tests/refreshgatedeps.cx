        {   J *fresh = pylit("head_shas(['tests/tapebinproduct.cx', 'tests/cxlib/tapebinfix.cx', 'tests/tapebin-expected.tsv', 'tests/fixtures/tapebin/frozen.tsv'])");
            for (i = 0; i < fresh->n; i++) osetn(tbg, fresh->k[i], fresh->kn[i], fresh->v[i]); }
        for (i = 0; i < tbg->n; i++) { int r; for (r = 0; refkeys[r]; r++) if (strlen(refkeys[r]) == tbg->kn[i] && !memcmp(refkeys[r], tbg->k[i], tbg->kn[i])) { osetn(refg, tbg->k[i], tbg->kn[i], tbg->v[i]); break; } }
        env_set("tb_trees", pylit("['examples', 'exec', 'include', 'iterate', 'kernel', 'seed', 'src', 'tests/c', 'unisa', 'weights']"));
        env_set("tb_guards", tbg); env_set("ref_guards", refg);
        for (i = 0; i < suites->n; ) {
            if (startswith(suites->k[i], suites->kn[i], "com-tapebin-")) { char *nm = xstrndup(suites->k[i], suites->kn[i]); odel(suites, nm, strlen(nm)); changed(nm, "dropped"); free(nm); }
            else i++;
