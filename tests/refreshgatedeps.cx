      ls[0] = oget(unit, "tools"); if (!ls[0]) ls[0] = jnew(JARR);
      ls[1] = oget(prep, "tools"); if (!ls[1]) ls[1] = jnew(JARR); oset(unit, "tools", sorted_union(ls, 2));
