        static const char *refkeys[] = { "tests/bound", "tests/bound.c", "tests/bound.py", "tests/build_ref.sh",
                                         "tests/export_ref.sh", "tests/reffoot.h", "tests/refshim.h", "unisacc.c", 0 };
        static const char *names[] = { "com-tapebin-six", "com-tapebin-cover", "com-tapebin-1", "com-tapebin-2",
                                       "com-tapebin-3", "com-tapebin-4", "com-tapebin-5", "com-tapebin-6", 0 };
