      const char *parts[] = {"wire", "var-promoted", "var-wire", "var-native"};
      for (int p = 0; p < 4; p++) { J *unit = jcopy(p ? var : wire), *ls[3]; char command[256];
        ls[0] = need(unit, "files"); ls[1] = need(prep, "files");
        ls[2] = pylit("['tests/modelcallablephase.cx', 'tests/modelcallablewirecheck.sh', 'tests/modelcallablevarwirecheck.sh', 'tests/modelcallablewirecheck.py', 'tests/modelcallablevarwirecheck.py', 'tests/modelvariadiccallcheck.py', 'tests/execchainprepared.cx', 'tests/cxlib/seedprep.cx', 'tests/cxbin', 'tests/gateorder.json', 'unisacc.com', 'unisacc.com.build.json']");
        oset(unit, "files", sorted_union(ls, 3));
        ls[0] = need(unit, "trees"); ls[1] = need(prep, "trees"); oset(unit, "trees", sorted_union(ls, 2));
        ls[0] = oget(unit, "tools"); if (!ls[0]) ls[0] = jnew(JARR); ls[1] = oget(prep, "tools"); if (!ls[1]) ls[1] = jnew(JARR); oset(unit, "tools", sorted_union(ls, 2));
        J *guards = need(unit, "guards"), *pg = need(prep, "guards"); for (int j = 0; j < pg->n; j++) oset(guards, pg->k[j], jcopy(pg->v[j]));
        J *hs = head_shas(pylit("['tests/modelcallablephase.cx']")); oset(guards, "tests/modelcallablephase.cx", need(hs, "tests/modelcallablephase.cx"));
        snprintf(command, sizeof command, "['sh', './unisacc.com', 'tests/modelcallablephase.cx', '--', '%s']", parts[p]); oset(unit, "command", pylit(command)); oset(suites, names[p], unit);
      }
      if (oget(suites, "lib-callable-variadic-model")) odel(suites, "lib-callable-variadic-model", strlen("lib-callable-variadic-model"));
    }
