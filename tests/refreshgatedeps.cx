    { J *unit = jcopy(need(suites, "lib-union-composite-prepare"));
      oset(suites, "lib-union-composite-runtime-ready", unit);
      const char *names[] = {"lib-union-composite-direct-1", "lib-union-composite-direct-2", "lib-union-composite-direct-3", "lib-union-composite-callback-1", "lib-union-composite-callback-2", "lib-union-composite-callback-3"};
      /* Original complete argv is a prefix on Linux/x64, unchanged elsewhere.
