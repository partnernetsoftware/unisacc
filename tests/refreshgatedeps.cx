        J *entry = pylit("{'command': ['tests/bound', '58', 'sh', './unisacc.com', '-run', 'tests/freshordercheck.cx', '--'], 'files': ['tests/freshordercheck.cx', 'tests/freshorderhook.h', 'tests/freshorder.tsv', 'tests/bound', 'tests/bound.c', 'tests/bound.py', 'unisacc.com', 'unisacc.com.build.json'], 'trees': ['exec', 'seed', 'include', 'weights', 'iterate'], 'executable_inputs': True, 'tools': ['cc', 'sh']}");
