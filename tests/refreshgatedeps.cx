    oset(suites, "boundnested-4", pylit("{'command': ['sh', './tests/cxbin', 'tests/boundnested.cx', '.', '--gate', '--only', '7'], 'files': ['tests/bound', 'tests/bound.py', 'tests/bound.c', 'tests/boundreason.c', 'tests/boundstall_r7g.py', 'tests/boundstall_ledger.sh', 'tests/boundstall_ps_flood_r7g.sh', 'tests/boundstall_ps_stall_r7g.sh', 'tests/boundnested.cx', 'tests/checklib.py', 'tests/cxbin', 'unisacc.com', 'unisacc.com.build.json', 'tests/gate.sh'], 'trees': ['include'], 'tools': ['cc', 'python3', 'sh']}"));
    oset(suites, "boundnested-5", pylit("{'command': ['sh', './tests/cxbin', 'tests/boundnested.cx', '.', '--gate', '--only', '8'], 'files': ['tests/bound', 'tests/bound.py', 'tests/bound.c', 'tests/boundreason.c', 'tests/boundstall_r7g.py', 'tests/boundstall_ledger.sh', 'tests/boundstall_ps_flood_r7g.sh', 'tests/boundstall_ps_stall_r7g.sh', 'tests/boundnested.cx', 'tests/checklib.py', 'tests/cxbin', 'unisacc.com', 'unisacc.com.build.json', 'tests/gate.sh'], 'trees': ['include'], 'tools': ['cc', 'python3', 'sh']}"));
    oset(suites, "gate-select", pylit("{'command': ['python3', 'tests/gateselectcheck.py'], 'files': ['tests/gateselect.py', 'tests/gateselect.tsv', 'tests/gateselectcheck.py', 'tests/gatedecl.py', 'tests/gatelayers.py', 'tests/stagemap.c', 'tests/gate.sh', 'tests/gateorder.json', 'tests/gatedeps.json', 'tests/bound', 'tests/bound.py', 'tests/bound.c', 'release/derived-map.tsv', 'release/tools/derivedcheck.py', 'kernel/unisa_model.inc', 'release/tools/commitgate.sh', 'tests/stagerun.sh', 'tests/gatequeue.py', 'tests/env_pin.py'], 'tools': ['cc', 'git', 'python3', 'sh']}"));
    oset(suites, "commitgate", pylit("{'command': ['./tests/commitgatecheck.sh'], 'files': ['kernel/unisa_model.inc', 'release/derived-map.tsv', 'release/tools/checkrun.sh', 'release/tools/commitgate.sh', 'release/tools/derivedcheck.py', 'tests/bound', 'tests/bound.c', 'tests/bound.py', 'tests/commitgatecheck.sh', 'tests/shipclassify.cx', 'tests/cxbin', 'tests/gate.sh', 'tests/gatedecl.py', 'tests/gatedeps.json', 'tests/gatelayers.py', 'tests/gateorder.json', 'tests/gateselect.py', 'tests/gateselect.tsv', 'tests/gateselectcheck.py', 'tests/stagemap.c', 'tests/stagerun.sh', 'tests/gatequeue.py', 'tests/env_pin.py', 'unisacc.com'], 'tools': ['bash', 'cc', 'git', 'python3', 'sh', 'sha256sum']}"));

    /* Preparation uses gate.sh's existing argv authority and the same parser as selection; declarations inherit the
       conservative consumer input closure. */
    {   static const char *owners[] = { "exec/parse2/librarytypedreadercheck.sh", "exec/parse2/librarycallsitecheck.sh",
            "exec/lower/librarytypedcheck.sh", "exec/lower/librarycallsitecheck.sh", "exec/lower/librarydatacheck.sh",
            "tests/librarycallbacke3check.sh", "tests/librarycallbacklowercheck.sh", "tests/librarycallbackwiringcheck.sh",
            "tests/librarycallbackauthcheck.sh", 0 };
        char *a[] = { "sh", "tests/gate.sh", "--plan", 0 }; size_t n; char *raw = run(a, 55, &n, 1);
        J *jobs = parse_gate_plan(raw, n), *groups = need(jload("tests/prepgroups.json"), "groups"), *packed = jnew(JOBJ), *gl, *ls[2];
        J *pg = jstr("tests/prepgroups.json"), *pgl = jnew(JARR);
        apush(pgl, pg);
        if (groups->t != JARR) die("prepgroups groups is not a list", 0);
        for (i = 0; i < groups->n; i++) { J *nm = need(groups->v[i], "name"); if (nm->t != JSTR) die("prepgroups name is not a str", 0); osetn(packed, nm->s, nm->sn, groups->v[i]); }
        for (i = 0; i < suites->n; ) {
            int active = 0, j;
            if (startswith(suites->k[i], suites->kn[i], "exec-prepare-"))
                for (j = 0; j < jobs->n && !active; j++) { J *jn = need(jobs->v[j], "name"); active = jn->sn == suites->kn[i] && !memcmp(jn->s, suites->k[i], jn->sn); }
            if (startswith(suites->k[i], suites->kn[i], "exec-prepare-") && !active) odel(suites, xstrndup(suites->k[i], suites->kn[i]), suites->kn[i]);
            else i++;
        }
        gl = need(suites, "gate-layers"); ls[0] = oget(gl, "files"); ls[1] = pgl;
        oset(gl, "files", sorted_union(ls, 2));
        for (i = 0; i < jobs->n; i++) {
            J *job = jobs->v[i], *name = need(job, "name"), *argvj = need(job, "command"); int matches = 0, j, r;
            char *nm = xstrndup(name->s, name->sn);
            for (r = 0; owners[r] && !matches; r++)
                for (j = 0; j < argvj->n; j++) {
                    J *x = argvj->v[j]; const char *s = x->s; size_t sn = x->sn;
                    if (sn >= 2 && s[0] == '.' && s[1] == '/') { s += 2; sn -= 2; }
                    if (sn == strlen(owners[r]) && !memcmp(s, owners[r], sn)) { matches = 1; break; }
                }
            if (startswith(name->s, name->sn, "exec-prepare-")) {
                J *row = ogetn(packed, name->s, name->sn), *members, *expected, *entry, *guards; Buf sc = {0}; int ex = 0;
                static const char *fields[] = { "files", "trees", "tools" };
                char hex[65]; size_t pn; char *pb;
                if (!row || !jeq(need(row, "command"), argvj)) die("preparation-declaration-owner-missing", nm);
                members = need(row, "members");
                if (members->t != JARR) die("members is not a list", nm);
                for (j = 0; j < members->n; j++) {
                    J *mv = need(members->v[j], "argv"); int z;
                    if (mv->t != JARR) die("member argv is not a list", nm);
                    if (j) bputc(&sc, '\n');
                    for (z = 0; z < mv->n; z++) { if (mv->v[z]->t != JSTR) die("member argv is not str", nm); if (z) bputc(&sc, ' '); shquote(&sc, mv->v[z]->s, mv->v[z]->sn); }
                }
                expected = jnew(JARR); apush(expected, jstr("sh")); apush(expected, jstr("-ec")); apush(expected, jstrn(sc.b ? sc.b : "", sc.n));
                if (!jeq(expected, argvj)) die("preparation-command-mismatch", nm);
                {   J **entries = xmalloc((size_t)(members->n + 1) * sizeof *entries), **fl = xmalloc((size_t)(members->n + 2) * sizeof *fl);
                    for (j = 0; j < members->n; j++) {
                        J *ow = need(members->v[j], "declaration_owner");
                        if (ow->t != JSTR) die("declaration_owner is not a str", nm);
                        entries[j] = ogetn(suites, ow->s, ow->sn);
                        if (!entries[j]) die("KeyError", ow->s);
                        if (truthy(oget(entries[j], "executable_inputs"))) ex = 1;
                    }
                    entry = jnew(JOBJ); oset(entry, "command", argvj); oset(entry, "executable_inputs", jnew(ex ? JTRUE : JFALSE));
                    for (r = 0; r < 3; r++) {
                        int z; for (z = 0; z < members->n; z++) fl[z] = oget(entries[z], fields[r]);
                        oset(entry, fields[r], sorted_union(fl, members->n));
                    }
                    ls[0] = oget(entry, "files"); ls[1] = pgl; oset(entry, "files", sorted_union(ls, 2));
                    guards = jnew(JOBJ);
                    for (j = 0; j < members->n; j++) {
                        J *g = oget(entries[j], "guards"); int z;
                        if (truthy(oget(entries[j], "family"))) die("preparation-owner-family-needs-flattening", nm);
                        if (!g) continue;
                        if (g->t != JOBJ) die("guards is not a dict", nm);
                        for (z = 0; z < g->n; z++) {
                            J *prev = ogetn(guards, g->k[z], g->kn[z]);
                            if (prev && !jeq(prev, g->v[z])) { Buf m = {0}; bputs(&m, nm); bputc(&m, ' '); bput(&m, g->k[z], g->kn[z]); die("preparation-owner-guard-conflict", m.b); }
                            osetn(guards, g->k[z], g->kn[z], g->v[z]);
                        }
                    }
                    if (!(pb = cx_read("tests/prepgroups.json", &pn))) die("cannot read", "tests/prepgroups.json");
                    cx_sha256_hex(pb, pn, hex); free(pb);
                    oset(guards, "tests/prepgroups.json", jstr(hex));
                    oset(entry, "guards", guards);
                    osetn(suites, name->s, name->sn, entry);
                    free(entries); free(fl);
                }
                free(sc.b);
            } else if (matches && ogetn(suites, name->s, name->sn)) {
                int req = 0;
                for (j = 0; j < argvj->n; j++) if (jstreq(argvj->v[j], "--require-cached")) req = 1;
                if (req) oset(ogetn(suites, name->s, name->sn), "command", argvj);
            }
            free(nm);
        }
    }
    /* 0.0.44 (cc ruling): fixed declarations the derivation does not produce.  The two hard-coded declarations above
       (gate-layers, gate-select) omit files their gates read; they are added here from one table, never by a branch.
       Appended in table order; existing order and all other suites are untouched. */
    {   static const char *extra[][3] = { { "gate-layers", "tests/checklib.py", 0 }, { "gate-select", ".gitignore", "tests/checklib.py" } };
        for (k = 0; k < 2; k++) {
            J *files = need(need(suites, extra[k][0]), "files");
            if (files->t != JARR) die("files is not a list", extra[k][0]);
            for (i = 1; i < 3 && extra[k][i]; i++) { J *x = jstr(extra[k][i]); if (!lhas(files, x)) apush(files, x); }
        }
    }

    jdump(&tb, d, 0); bputc(&tb, '\n');
    if (cx_write("tests/gatedeps.json", tb.b, tb.n)) die("cannot write", "tests/gatedeps.json");
    {   char **sa = xmalloc((size_t)(treeset->n + 5) * sizeof *sa); size_t n; char *s, *e;
        sa[0] = "git"; sa[1] = "status"; sa[2] = "--porcelain"; sa[3] = "--";
        for (t = 0; t < treeset->n; t++) sa[4 + t] = treeset->v[t]->s;
        sa[4 + treeset->n] = 0;
        s = run(sa, 60, &n, 0);
        e = s + n;
        while (s < e && (*s == ' ' || (*s >= '\t' && *s <= '\r'))) s++;          /* str.strip() */
        while (e > s && (e[-1] == ' ' || (e[-1] >= '\t' && e[-1] <= '\r'))) e--;
        *e = 0;
        printf("gatedeps: reviewed stamps from %s; changed %s\n", strcmp(REF, "HEAD") ? "the index" : "HEAD",
               NCHANGED ? (bputc(&CHANGED, ']'), CHANGED.b) : "none");
        if (*s && !strcmp(REF, "HEAD")) printf("gatedeps: note -- uncommitted changes under reviewed trees are NOT in the stamp:\n%s\n", s);
    }
    (void)root;
    return 0;
}
