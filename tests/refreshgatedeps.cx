    /* Every union mode/consumer inherits the actual shared PIC selector source. */
    { J *hs = head_shas(pylit("['tests/cxlib/libffiprovider.cx', 'tests/libraryunionnativecheck.cx', 'tests/libraryunionscalarcheck.cx']"));
      for (int k = 0; k < suites->n; k++) { J *unit = suites->v[k], *files = oget(unit, "files"); int uses = 0;
        if (!files || files->t != JARR) continue;
        for (int f = 0; f < files->n; f++) if (files->v[f]->t == JSTR && (!strcmp(files->v[f]->s, "tests/libraryunionnativecheck.cx") || !strcmp(files->v[f]->s, "tests/libraryunionscalarcheck.cx"))) uses = 1;
        if (uses) { J *ls[2] = {files, pylit("['tests/cxlib/libffiprovider.cx']")}, *g = oget(unit, "guards"); if (!g) { g = jnew(JOBJ); oset(unit, "guards", g); } oset(unit, "files", sorted_union(ls, 2)); oset(g, "tests/cxlib/libffiprovider.cx", need(hs, "tests/cxlib/libffiprovider.cx"));
          for (int f = 0; f < files->n; f++) if (files->v[f]->t == JSTR && (!strcmp(files->v[f]->s, "tests/libraryunionnativecheck.cx") || !strcmp(files->v[f]->s, "tests/libraryunionscalarcheck.cx"))) oset(g, files->v[f]->s, need(hs, files->v[f]->s)); }
      }
    }
    changed("union-pic-provider", "complete actual provider source guard for all native union and scalar modes");
    { J *hs = head_shas(pylit("['tests/cxlib/libffiprovider.cx', 'tests/libraryunioncompositecheck.cx']"));
      for (int k = 0; k < suites->n; k++) { J *unit = suites->v[k], *files = oget(unit, "files"); int uses = 0;
        if (!files || files->t != JARR) continue;
