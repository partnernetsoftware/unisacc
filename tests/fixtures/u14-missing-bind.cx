/* Compile the requested unit normally, except bind succeeds without an object. */
#pragma unisa use text.text
#pragma unisa use cxlib.procrun

int main(int argc, char **argv) {
    pr_result r;
    if (argc != 5 || !tx_eqz(argv[1], "-c") || !tx_eqz(argv[3], "-o")) return 2;
    if (tx_eqz(argv[2], "src/bind_m1.cx")) return 0;
    char *av[] = {"sh", "./unisacc.com", argv[1], argv[2], argv[3], argv[4], 0}; /* lint:allow R1-product fixture forwards compile */
    int rc = pr_run("u14-fixture-compile", av, 0, 0, 8, &r);
    int result = rc == 0 ? r.rc : 2;
    pr_free(&r);
    return result;
}
