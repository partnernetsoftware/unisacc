/* tests/fixtures/ctor-debt/release-ape-stub.cx -- check-ctor-debt D5 的替身:
 * 被 chain-step pack 以 ROOT/tools/release-ape.cx 身份调起,只回报标记、工作目录与首参,不打包。
 * 临时 ROOT 里没有模块树,所以不写 use,只用隐式运行库。 */
int main(int argc, char **argv) {
    char cwd[4096];
    if (!getcwd(cwd, sizeof cwd)) return 2;
    printf("CTOR_DEBT_PACK_STUB\t%s\t%s\n", cwd, argc > 1 ? argv[1] : "-");
    return 0;
}
