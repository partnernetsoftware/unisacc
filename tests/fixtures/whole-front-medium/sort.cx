#pragma unisa module sort
#pragma unisa use records

typedef int (*medium_compare)(const medium_record *, const medium_record *);

static int helper(unsigned int a, unsigned int b) {
    if (a < b) return -1;
    if (a > b) return 1;
    return 0;
}

int medium_ascending(const medium_record *a, const medium_record *b) {
    return helper(a->key, b->key);
}

int medium_descending(const medium_record *a, const medium_record *b) {
    return helper(b->key, a->key);
}

/* Bottom-up merge: choose the left item on equality, preserving origins.
   Keep the function-pointer callback within one module's semantic type scope. */
void medium_sort(medium_record *a, medium_record *work, unsigned int n,
                 int descending) {
    medium_compare compare = descending ? medium_descending : medium_ascending;
    unsigned int width;
    for (width = 1; width < n; width = width * 2) {
        unsigned int base;
        for (base = 0; base < n; base = base + width * 2) {
            unsigned int mid = base + width;
            unsigned int end = base + width * 2;
            unsigned int left = base;
            unsigned int right;
            unsigned int out;
            if (mid > n) mid = n;
            if (end > n) end = n;
            right = mid;
            for (out = base; out < end; out++) {
                if (left < mid &&
                    (right == end || compare(&a[left], &a[right]) <= 0)) {
                    work[out] = a[left];
                    left++;
                } else {
                    work[out] = a[right];
                    right++;
                }
            }
        }
        for (base = 0; base < n; base++) a[base] = work[base];
    }
}

int medium_ordered(const medium_record *a, unsigned int n, int descending) {
    medium_compare compare = descending ? medium_descending : medium_ascending;
    unsigned int i;
    for (i = 1; i < n; i++) {
        if (compare(&a[i - 1], &a[i]) > 0) return 0;
        if (a[i - 1].key == a[i].key &&
            a[i - 1].origin >= a[i].origin) return 0;
    }
    return 1;
}
