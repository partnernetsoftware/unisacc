#pragma unisa module graph
#pragma unisa use records

static const unsigned int medium_nodes = 32;
static const unsigned int medium_infinity = 1000000;
static const unsigned int medium_steps[3] = {1, 5, 11};

unsigned int medium_graph_nodes(void) { return medium_nodes; }

typedef struct medium_graph_result {
    medium_u64 digest;
    unsigned int diameter;
    unsigned int reachable;
} medium_graph_result;

static unsigned int helper(unsigned int from, unsigned int to) {
    unsigned int k;
    if (from == to) return 0;
    for (k = 0; k < 3; k++) {
        if ((from + medium_steps[k]) % 32 == to)
            return 1 + (from * 7 + k * 3) % 17;
    }
    return medium_infinity;
}

/* Floyd-Warshall is checked independently with 32 single-source Dijkstra runs. */
int medium_graph(medium_graph_result *result) {
    unsigned int paths[32][32];
    unsigned int i;
    unsigned int j;
    unsigned int k;
    result->digest = 0;
    result->diameter = 0;
    result->reachable = 0;
    for (i = 0; i < medium_nodes; i++) {
        for (j = 0; j < medium_nodes; j++) paths[i][j] = helper(i, j);
    }
    for (k = 0; k < medium_nodes; k++) {
        for (i = 0; i < medium_nodes; i++) {
            for (j = 0; j < medium_nodes; j++) {
                unsigned int via = paths[i][k] + paths[k][j];
                if (via < paths[i][j]) paths[i][j] = via;
            }
        }
    }
    for (i = 0; i < medium_nodes; i++) {
        unsigned int distance[32];
        unsigned int used[32];
        for (j = 0; j < medium_nodes; j++) {
            distance[j] = medium_infinity;
            used[j] = 0;
        }
        distance[i] = 0;
        for (k = 0; k < medium_nodes; k++) {
            unsigned int best = medium_nodes;
            unsigned int v;
            for (v = 0; v < medium_nodes; v++) {
                if (!used[v] && (best == medium_nodes ||
                    distance[v] < distance[best])) best = v;
            }
            if (best == medium_nodes) return 0;
            if (distance[best] == medium_infinity) return 0;
            used[best] = 1;
            for (v = 0; v < medium_nodes; v++) {
                unsigned int via = distance[best] + helper(best, v);
                if (via < distance[v]) distance[v] = via;
            }
        }
        if (paths[i][i] != 0) return 0;
        for (j = 0; j < medium_nodes; j++) {
            if (distance[j] != paths[i][j]) return 0;
            if (distance[j] >= medium_infinity) return 0;
            if (distance[j] > result->diameter) result->diameter = distance[j];
            result->reachable++;
            result->digest = result->digest * 65599ULL + distance[j];
        }
    }
    return result->reachable == medium_nodes * medium_nodes;
}
