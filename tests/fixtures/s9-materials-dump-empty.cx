/* tests/fixtures/s9-materials-dump-empty.cx -- a stand-in for `tools/affected.cx -- --materials-dump
 * --prepare-materials` that reports every material as refused, i.e. an empty map.  Used through
 * UNISACC_S9_MATERIALS_DUMP_SEAM so tools/check-s9-nightly.cx can assert that tools/s9-nightly.cx fails
 * by name instead of quietly running the whole tier with no materials (the 0.0.67 state). */
#pragma unisa use text.text

int main(void) {
    /* the same four-column shape, every source '-' with a named reason: what a real dump prints when nothing
       can produce the artefact */
    fputs("MATERIAL\tb1\tstreams\t-\tREFUSED=no-producer=streams\n", stdout);
    fputs("MATERIAL\tb2\tidentity-helper\t-\tREFUSED=no-producer=identity-helper\n", stdout);
    return 0;
}
