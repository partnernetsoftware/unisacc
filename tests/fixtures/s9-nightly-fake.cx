/* tests/fixtures/s9-nightly-fake.cx -- 夹具假 s9,不跑真批次。 */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use cxlib.netpack

static void die(const char *s) { fprintf(stderr, "s9-nightly-fake: %s\n", s); exit(2); }

int main(int argc, char **argv) {
    const char *logp, *fail, *slp, *verb, *arg4;
    FILE *fp;
    if (argc < 2) die("verb");
    verb = argv[1];
    arg4 = argc > 4 ? argv[4] : "";
    logp = getenv("S9_FAKE_LOG");
    if (!logp || !logp[0]) die("S9_FAKE_LOG");
    fp = fopen(logp, "a");
    if (!fp) die("open-log");
    /* 记 verb 与 argv[4..](跳过 ROOT/RUN 路径),tier 透传由此可见 */
    fprintf(fp, "%s", verb);
    for (int i = 4; i < argc; i++) fprintf(fp, " %s", argv[i]);
    fprintf(fp, "\n");
    fclose(fp);
    fail = getenv("S9_FAKE_FAIL");
    slp = getenv("S9_FAKE_SLEEP");
    if (!strcmp(verb, "build")) { printf("BUILD\n"); return 0; }
    if (!strcmp(verb, "init")) { printf("S9 INITIALIZED qualification=NOT_EXECUTED\n"); return 3; }
    if (!strcmp(verb, "prepare")) {
        if (fail && fail[0] && !strcmp(fail, arg4)) { printf("FAIL_PREP\n"); return 2; }
        printf("PREP\n");
        return 0;
    }
    if (!strcmp(verb, "pending") && argc > 3) {   /* S9_FAKE_PAR_N 片 p0..;没有 LEAF.start 的算待跑;S9_FAKE_PAR_ALONE=K 时 pK 为独占片 */
        const char *pn = getenv("S9_FAKE_PAR_N"), *al = getenv("S9_FAKE_PAR_ALONE");
        int total = pn && pn[0] ? atoi(pn) : 0, alone = al && al[0] ? atoi(al) : -1, k, cnt = 0;
        for (k = 0; k < total; k++) {
            char p[4400];
            if (cx_fmt(p, sizeof p, "%s/p%d.start", argv[3], k)) die("path");
            if (sy_exists(p) == 1) continue;
            printf("S9_PENDING\tslice=p%d\ttier=0\talone=%d\theavy=0\tbudget=1\tmaterials=0\tneed=2\n", k, k == alone);
            cnt++;
        }
        printf("S9_PENDING_SUMMARY\tpending=%d\tslices=%d\n", cnt, total);
        return 0;
    }
    if (!strcmp(verb, "step")) {
        size_t n; char *s;
        /* 与真 s9-shards 同合同:必须带 UNISACC_BOUND_DEADLINE_MONO,且剩余在 (0,300.5] 内(单调时钟) */
        {
            const char *dl = getenv("UNISACC_BOUND_DEADLINE_MONO");
            char *e = 0;
            sy_ts_t t;
            double end, left;
            if (!dl) { printf("FAIL supervisor-deadline-required\n"); return 2; }
            end = strtod(dl, &e);
            if (!e || *e || sy_mono(&t)) { printf("FAIL deadline-parse\n"); return 2; }
            left = end - ((double)t.sec + (double)t.nsec / 1e9);
            if (left <= 0 || left > 300.5) { printf("FAIL outer-budget-300\n"); return 2; }
        }
        /* 并发步夹具:step ROOT RUN --slice LEAF 睡 S9_FAKE_PAR_MS 毫秒后在 RUN 下留 LEAF.start 与 LEAF.done;
           S9_FAKE_PAR_NOPROG=LEAF 时该片恒报 STEP_NO_PROGRESS 且不留记录;S9_FAKE_PAR_BAD=LEAF 时该片 rc 2。 */
        if (argc > 5 && !strcmp(argv[4], "--slice")) {
            const char *np = getenv("S9_FAKE_PAR_NOPROG"), *bd = getenv("S9_FAKE_PAR_BAD"), *ms = getenv("S9_FAKE_PAR_MS");
            char p[4400];
            FILE *f;
            if (np && !strcmp(np, argv[5])) { printf("S9\tSTEP_NO_PROGRESS\tslice=%s\treason=budget\tlaunched=0\n", argv[5]); return 4; }
            if (bd && !strcmp(bd, argv[5])) { printf("FAIL fake-bad-slice\n"); return 2; }
            if (cx_fmt(p, sizeof p, "%s/%s.start", argv[3], argv[5])) die("path");
            f = fopen(p, "w"); if (!f) die("start"); fputs("x\n", f); fclose(f);
            sy_sleep_ms(ms && ms[0] ? atoi(ms) : 300);
            if (cx_fmt(p, sizeof p, "%s/%s.done", argv[3], argv[5])) die("path");
            f = fopen(p, "w"); if (!f) die("done"); fputs("x\n", f); fclose(f);
            printf("S9\tSTEP_SLICE\tslice=%s\tstatus=DONE_RECORDED\nS9\tSTEP_PENDING\tunstarted=1\tlive=1\tlaunched=1\n", argv[5]);
            return 3;
        }
        if (slp && slp[0] == '3') sy_sleep_ms(8000);
        {
            const char *m = getenv("S9_FAKE_MODE");
            if (m && !strcmp(m, "nowt")) { printf("S9\tSTEP_FINISHED\tqualification=NOT_DECIDED_HERE\n"); return 3; }   /* 无 S9_WT:无新片,显式完成信号 */
            if (m && !strcmp(m, "quiet")) { printf("S9\tSTEP_PENDING\tunstarted=5\tlive=0\tlaunched=1\n"); return 3; }   /* 无 S9_WT 也无完成信号:不得记完成 */
            if (m && !strcmp(m, "noprog")) { printf("S9\tSTEP_NO_PROGRESS\tunstarted=137\treason=budget\tlaunched=0\n"); return 4; }   /* 有待跑片而未发片 */
            if (m && !strcmp(m, "unk") && argc > 3) {                               /* a 完成, b 有 start 无 done */
                char p[4400];
                const char *names[] = {"a.start", "a.done", "b.start"};
                for (int q = 0; q < 3; q++) {
                    FILE *f;
                    if (cx_fmt(p, sizeof p, "%s/%s", argv[3], names[q])) die("path");
                    f = fopen(p, "w");
                    if (f) { fputs("x\n", f); fclose(f); }
                }
                printf("S9\tUNKNOWN\nS9\tSTEP_FINISHED\tqualification=NOT_DECIDED_HERE\n");
                return 3;
            }
            if (m && !strcmp(m, "alldone") && argc > 3) {                           /* start==done 且仍有 S9_WT */
                char p[4400];
                const char *names[] = {"a.start", "a.done"};
                for (int q = 0; q < 2; q++) {
                    FILE *f;
                    if (cx_fmt(p, sizeof p, "%s/%s", argv[3], names[q])) die("path");
                    f = fopen(p, "w");
                    if (f) { fputs("x\n", f); fclose(f); }
                }
                /* 落到下面通用逻辑: 第 1 步 S9_WT 待续, 第 2 步无 S9_WT 结束 */
            }
        }
        s = cx_read(logp, &n);
        if (s) {
            int steps = 0; size_t i;
            for (i = 0; i + 4 < n; i++) if (s[i] == 's' && s[i + 1] == 't' && s[i + 2] == 'e' && s[i + 3] == 'p') steps++;
            free(s);
            const char *lg = getenv("S9_FAKE_LONG");
            int need = (lg && lg[0]) ? atoi(lg) : 2; /* S9_FAKE_LONG=N: 前 N-1 次 step 均 PENDING,使编排日志超限 */
            if (steps < need) {
                /* LONG 模式: 每步一行约 150 字节状态文本, 使日志快速超限 */
                if (lg && lg[0]) printf("S9_WT\tshard-status-0123456789-0123456789-0123456789-0123456789-0123456789-0123456789-0123456789-0123456789-0123456789\n");
                else printf("S9_WT\tSTEP_FINISHED PENDING\n");
                return 3;
            }
        }
        printf("S9\tSTEP_FINISHED\tqualification=NOT_DECIDED_HERE\nSTEP_DONE\n");
        return 0;
    }
    if (!strcmp(verb, "retry")) { printf("S9\tPENDING\treason=explicit-unknown-retry\n"); return 3; }
    if (!strcmp(verb, "aggregate")) {
        const char *af = getenv("S9_FAKE_AGG_FILE");   /* 设了就把该文件原样当 aggregate stdout */
        if (af && af[0]) {
            FILE *g = fopen(af, "rb");
            char b[1024]; size_t k;
            if (!g) die("agg-file");
            while ((k = fread(b, 1, sizeof b, g)) > 0) fwrite(b, 1, k, stdout);
            fclose(g);
            {   /* S9_FAKE_PART_RC / S9_FAKE_MERGE_RC: 让 --part / --merge 以指定 rc 退出(默认 0) */
                const char *rcs = getenv(!strcmp(arg4, "--merge") ? "S9_FAKE_MERGE_RC" : "S9_FAKE_PART_RC");
                return (rcs && rcs[0]) ? atoi(rcs) : 0;
            }
        }
    }
    if (!strcmp(verb, "aggregate")) { printf("S9 COMMIT_ONLY status=PASS pending=0\n"); return 0; }
    return 2;
}
