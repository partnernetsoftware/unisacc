/* tests/fixtures/s9-nightly-fake.cx -- 夹具假 s9,不跑真批次。 */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use cxlib.netpack

static void die(const char *s) { fprintf(stderr, "s9-nightly-fake: %s\n", s); exit(2); }

int main(int argc, char **argv) {
    const char *logp, *fail, *slp, *verb, *arg4;
    FILE *fp;
    if (argc < 2) die("verb");
    verb = argv[1];
    arg4 = argc > 4 ? argv[4] : "";
    logp = getenv("S9_FAKE_LOG");
    if (!logp || !logp[0]) die("S9_FAKE_LOG");
    fp = fopen(logp, "a");
    if (!fp) die("open-log");
    /* 记 verb 与 argv[4..](跳过 ROOT/RUN 路径),tier 透传由此可见 */
    fprintf(fp, "%s", verb);
    for (int i = 4; i < argc; i++) fprintf(fp, " %s", argv[i]);
    fprintf(fp, "\n");
    fclose(fp);
    fail = getenv("S9_FAKE_FAIL");
    slp = getenv("S9_FAKE_SLEEP");
    if (!strcmp(verb, "build")) { printf("BUILD\n"); return 0; }
    if (!strcmp(verb, "init")) { printf("S9 INITIALIZED qualification=NOT_EXECUTED\n"); return 3; }
    if (!strcmp(verb, "prepare")) {
        if (fail && fail[0] && !strcmp(fail, arg4)) { printf("FAIL_PREP\n"); return 2; }
        printf("PREP\n");
        return 0;
    }
    if (!strcmp(verb, "step")) {
        size_t n; char *s;
        /* 与真 s9-shards 同合同:必须带 UNISACC_BOUND_DEADLINE_MONO,且剩余在 (0,300.5] 内(单调时钟) */
        {
            const char *dl = getenv("UNISACC_BOUND_DEADLINE_MONO");
            char *e = 0;
            sy_ts_t t;
            double end, left;
            if (!dl) { printf("FAIL supervisor-deadline-required\n"); return 2; }
            end = strtod(dl, &e);
            if (!e || *e || sy_mono(&t)) { printf("FAIL deadline-parse\n"); return 2; }
            left = end - ((double)t.sec + (double)t.nsec / 1e9);
            if (left <= 0 || left > 300.5) { printf("FAIL outer-budget-300\n"); return 2; }
        }
        if (slp && slp[0] == '3') sy_sleep_ms(8000);
        {
            const char *m = getenv("S9_FAKE_MODE");
            if (m && !strcmp(m, "nowt")) { printf("STEP_FINISHED\n"); return 3; }   /* 无 S9_WT:无新片 */
            if (m && !strcmp(m, "unk") && argc > 3) {                               /* a 完成, b 有 start 无 done */
                char p[4400];
                const char *names[] = {"a.start", "a.done", "b.start"};
                for (int q = 0; q < 3; q++) {
                    FILE *f;
                    if (cx_fmt(p, sizeof p, "%s/%s", argv[3], names[q])) die("path");
                    f = fopen(p, "w");
                    if (f) { fputs("x\n", f); fclose(f); }
                }
                printf("S9\tUNKNOWN\n");
                return 3;
            }
            if (m && !strcmp(m, "alldone") && argc > 3) {                           /* start==done 且仍有 S9_WT */
                char p[4400];
                const char *names[] = {"a.start", "a.done"};
                for (int q = 0; q < 2; q++) {
                    FILE *f;
                    if (cx_fmt(p, sizeof p, "%s/%s", argv[3], names[q])) die("path");
                    f = fopen(p, "w");
                    if (f) { fputs("x\n", f); fclose(f); }
                }
                /* 落到下面通用逻辑: 第 1 步 S9_WT 待续, 第 2 步无 S9_WT 结束 */
            }
        }
        s = cx_read(logp, &n);
        if (s) {
            int steps = 0; size_t i;
            for (i = 0; i + 4 < n; i++) if (s[i] == 's' && s[i + 1] == 't' && s[i + 2] == 'e' && s[i + 3] == 'p') steps++;
            free(s);
            const char *lg = getenv("S9_FAKE_LONG");
            int need = (lg && lg[0]) ? atoi(lg) : 2; /* S9_FAKE_LONG=N: 前 N-1 次 step 均 PENDING,使编排日志超限 */
            if (steps < need) {
                /* LONG 模式: 每步一行约 150 字节状态文本, 使日志快速超限 */
                if (lg && lg[0]) printf("S9_WT\tshard-status-0123456789-0123456789-0123456789-0123456789-0123456789-0123456789-0123456789-0123456789-0123456789\n");
                else printf("S9_WT\tSTEP_FINISHED PENDING\n");
                return 3;
            }
        }
        printf("STEP_DONE\n");
        return 0;
    }
    if (!strcmp(verb, "retry")) { printf("S9\tPENDING\treason=explicit-unknown-retry\n"); return 3; }
    if (!strcmp(verb, "aggregate")) {
        const char *af = getenv("S9_FAKE_AGG_FILE");   /* 设了就把该文件原样当 aggregate stdout */
        if (af && af[0]) {
            FILE *g = fopen(af, "rb");
            char b[1024]; size_t k;
            if (!g) die("agg-file");
            while ((k = fread(b, 1, sizeof b, g)) > 0) fwrite(b, 1, k, stdout);
            fclose(g);
            {   /* S9_FAKE_PART_RC / S9_FAKE_MERGE_RC: 让 --part / --merge 以指定 rc 退出(默认 0) */
                const char *rcs = getenv(!strcmp(arg4, "--merge") ? "S9_FAKE_MERGE_RC" : "S9_FAKE_PART_RC");
                return (rcs && rcs[0]) ? atoi(rcs) : 0;
            }
        }
    }
    if (!strcmp(verb, "aggregate")) { printf("S9 COMMIT_ONLY status=PASS pending=0\n"); return 0; }
    return 2;
}
