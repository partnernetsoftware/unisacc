#pragma unisa use sys.fs
#pragma unisa use sys.time

/* The registry and shard modes use the intact inventory tool. Only the
   execution of an actual shard is replaced by this timed fixture. */
int main(int argc,char **argv){
    if(argc==4 && !strcmp(argv[1],"--register")){
        char *v[]={"sh","./unisacc.com","tests/inventory.cx","--",argv[1],argv[2],argv[3],0};
        execvp(v[0],v);return 2;
    }
    if(argc==3 && !strcmp(argv[1],"--shards")){
        char *v[]={"sh","./unisacc.com","tests/inventory.cx","--",argv[1],argv[2],0};
        execvp(v[0],v);return 2;
    }
    if(argc!=4 || strcmp(argv[3],"0"))return 2;
    if(sy_exists("tests/cold-slow")==1)sy_sleep_ms(27000);
    puts("TOOLS_COMPILE");return 0;
}
