/* gen_forward_count.cx -- 生成 forward 调用计数夹具: N 个不同 extern 符号各调用一次,
   末尾再加同一符号重复多次(去重应只计一次)。一次性夹具生成器,产物为 .cx 文本夹具。
   sh ./unisacc.com tests/fixtures/forward-count/gen_forward_count.cx -- OUT N */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.fmt

int main(int argc, char **argv) {
    const char *out;
    long n = 0, i;
    FILE *f;
    if (argc < 3) { fprintf(stderr, "usage: gen_forward_count.cx OUT N\n"); return 2; }
    out = argv[1];
    { const char *s = argv[2]; while (*s >= '0' && *s <= '9') { n = n * 10 + (*s - '0'); s++; } }
    if (n <= 0) return 2;
    f = fopen(out, "wb");
    if (!f) { fprintf(stderr, "gen_forward_count: cannot write %s\n", out); return 2; }
    fprintf(f, "/* generated forward-count fixture: %ld distinct extern calls + a repeated-symbol block */\n", n);
    for (i = 1; i <= n; i++) fprintf(f, "extern long f%ld(void);\n", i);
    fprintf(f, "extern long zdup(void);\n");
    fprintf(f, "int main(void) {\n");
    for (i = 1; i <= n; i++) fprintf(f, "  f%ld();\n", i);
    for (i = 0; i < 100; i++) fprintf(f, "  zdup();\n");   /* same symbol 100x -> forwarded once */
    fprintf(f, "  return 0;\n}\n");
    fclose(f);
    printf("GEN_FORWARD_COUNT\t%s\tn=%ld\n", out, n);
    return 0;
}
