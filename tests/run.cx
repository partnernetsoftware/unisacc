/* Run from any cwd: sh /path/unisacc.com /path/tests/run.cx -- --smoke */
#pragma unisa use cases.product
#pragma unisa use cxlib.testplan
static const char *names[]={"function","recursion","fibonacci","struct-array","pointer-mutation","callback","loop-control","short-circuit","memmove","format","format-bytes","parse-integer","parse-tail","allocation","sha256","module-state"};
static const long expected[]={42,720,55,34,17,81,25,0,0,7,0,-123,120,45,0,2};
static int smoke(void){long actual[16];int i,failed=0;
 if(product_count()!=16){fprintf(stderr,"batch shape mismatch\n");return 2;}
 product_values(actual);
 for(i=0;i<16;i++){int ok=actual[i]==expected[i];if(!ok)failed++;printf("%s\tproduct.%s\tactual=%ld\texpected=%ld\n",ok?"PASS":"FAIL",names[i],actual[i],expected[i]);}
 puts("TIMING\texecute_seconds=UNMEASURED\tvalidate_seconds=UNMEASURED");
 puts("TIMING\tcompiler_startup_construction_loading_inference_output=UNMEASURED");
 printf("SMOKE\tassertions=16\tfailed=%d\tscope=local-product-batch\n",failed);
 return failed?1:0;
}
typedef struct {int smoke_rc,smoke_seen,invalid,not_run_batches,not_run_coverage,unresolved;} run_inventory;
static int smoke_id(const char *id){int i;for(i=0;i<16;i++){char expected_id[100];snprintf(expected_id,sizeof expected_id,"product.%s",names[i]);if(!strcmp(id,expected_id))return 1;}return 0;}
static int smoke_mapping(const char *csv){int count=0;while(*csv){const char *end=strchr(csv,',');size_t n=end?(size_t)(end-csv):strlen(csv);char id[128];if(!n||n>=sizeof id)return 0;memcpy(id,csv,n);id[n]=0;if(!smoke_id(id))return 0;count++;if(!end)break;csv=end+1;}return count==16;}
static int smoke_row_valid(const tp_batch_view *v){return !strcmp(v->implementation,"IMPLEMENTED")&&!strcmp(v->source,"tests/run.cx")&&!strcmp(v->entry,v->source)&&!strcmp(v->mode,"SOURCE")&&!strcmp(v->materials,"-")&&!strcmp(v->args,"--smoke")&&!strcmp(v->expect,"rc0:SMOKE")&&smoke_mapping(v->coverage);}
static void inventory_batch(const tp_batch_view *v,void *context){run_inventory *s=context;if(!strcmp(v->id,"smoke")){
 s->smoke_seen=1;int valid=smoke_row_valid(v);
 if(!valid){s->invalid=1;puts("REFUSE\tsmoke-registry-contract\tlocal-observations-do-not-satisfy-this-row");return;}
 printf("BATCH\tsmoke\t%s\tscope=in-process-local-only\tplatform_claim=NOT_QUALIFIED\tdeclared_platform=%s\n",s->smoke_rc?"LOCAL_FAIL":"LOCAL_PASS",v->platform);return;
 }s->not_run_batches++;printf("NOT_RUN\tbatch.%s\timplementation=%s\treason=%s\tplatform=%s\tbudget=%s\tmaterials=%s\tsource_state=%s\n",v->id,v->implementation,!strcmp(v->implementation,"PLANNED")?"PLANNED":strcmp(v->materials,"-")?"UNPREPARED":"not-scheduled",v->platform,v->budget,v->materials,v->source_present?"PRESENT":"MISSING");}
static void inventory_coverage(const tp_coverage_view *v,void *context){run_inventory *s=context;if(strcmp(v->implementation,"IMPLEMENTED")&&strcmp(v->implementation,"IMPLEMENTED_SEPARATE_BATCH")){s->unresolved++;printf("%s\t%s\tmapped=%d\texpected_or_gap=%s\n",v->implementation,v->id,v->mapped,v->expected);return;}
 if(smoke_id(v->id)&&s->smoke_seen&&!s->invalid){printf("COVERAGE\t%s\t%s\timplementation=%s\tscope=in-process-local-only\tplatform_claim=NOT_QUALIFIED\n",v->id,s->smoke_rc?"LOCAL_FAIL":"LOCAL_PASS",v->implementation);return;}
 s->not_run_coverage++;printf("NOT_RUN\t%s\timplementation=%s\timplemented_batch=%d\texpected=%s\n",v->id,v->implementation,v->implemented_batch,v->expected);}
/* --all SESSION: the smoke row contract only; every other batch is judged by the aggregator's receipts. */
static void session_batch(const tp_batch_view *v,void *context){run_inventory *s=context;if(strcmp(v->id,"smoke"))return;s->smoke_seen++;if(!smoke_row_valid(v))s->invalid=1;}
static void session_coverage(const tp_coverage_view *v,void *context){(void)v;(void)context;}
static int line_count(const char *s,size_t n,const char *prefix){size_t pn=strlen(prefix),at=0;int c=0;while(at<n){size_t end=at;while(end<n&&s[end]!='\n')end++;if(end-at>=pn&&!memcmp(s+at,prefix,pn))c++;at=end+1;}return c;}
/* Full execution qualification: in-process smoke plus tests/all-aggregate.cx over one tools/all-waves.cx
   session, run by ROOT/unisacc.com.  rc0 only when metadata is valid, smoke passes and the aggregator
   reports QUALIFIED (every IMPLEMENTED batch has a same-candidate PASS receipt, zero unsatisfied or
   unresolved coverage rows).  Anything else is non-zero with each reason named. */
static int all_session(const char *root,const char *session,char *reg,size_t rn,char *cov,size_t cn){
 char why[600];tp_summary summary;run_inventory inventory={0};int smoke_rc=smoke();tp_observer observer={session_batch,session_coverage,&inventory};
 int rc=tp_visit(root,reg,rn,cov,cn,&observer,&summary,why,sizeof why);free(reg);free(cov);if(rc){fprintf(stderr,"REFUSE\tmetadata-schema\t%s\n",why);return 2;}
 if(inventory.smoke_seen!=1||inventory.invalid){fprintf(stderr,"REFUSE\tsmoke-registry-contract\texpected=one-exact-local-smoke-row\n");return 2;}
 char product[4400],aggregate[4400],r[4096],s[4096];snprintf(product,sizeof product,"%s/unisacc.com",root);snprintf(aggregate,sizeof aggregate,"%s/tests/all-aggregate.cx",root);snprintf(r,sizeof r,"%s",root);snprintf(s,sizeof s,"%s",session);
 char *argv[]={"sh",product,aggregate,"--",r,s,0};char *out=0;size_t on=0;int arc=cx_runv_timeout(argv,50,&out,&on);if(out&&on)fwrite(out,1,on,stdout);
 int qualified=arc==0&&out&&line_count(out,on,"AGGREGATE\tQUALIFIED\t")==1&&line_count(out,on,"AGGREGATE\t")==1;
 printf("ALL\t%s\tmetadata_valid=1\tsmoke=%s\taggregate_rc=%d\taggregate=%s\tsession=%s\tcoverage=%d\timplemented_batches=%d\tunresolved_registry_rows=%d\tqualification=%s\n",qualified&&!smoke_rc?"PASS":"NOT_QUALIFIED",smoke_rc?"LOCAL_FAIL":"LOCAL_PASS",arc,arc==124?"TIMEOUT":!out?"NO_OUTPUT":line_count(out,on,"AGGREGATE\tQUALIFIED\t")==1?"QUALIFIED":line_count(out,on,"AGGREGATE\tREFUSED")?"REFUSED":"NOT_QUALIFIED",session,summary.coverage_rows,summary.implemented_batches,summary.unresolved_coverage,qualified&&!smoke_rc?"FULL_EXECUTION_SESSION":"NOT_QUALIFIED");
 free(out);if(smoke_rc)return smoke_rc;if(!qualified)return arc==2?2:3;return 0;
}
static char *metadata_read(const char *p,const char *kind,size_t *n){struct stat st;errno=0;if(lstat(p,&st)){fprintf(stderr,"REFUSE\tmetadata-io\tkind=%s\tpath=%s\terrno=%d\n",kind,p,errno);return 0;}if(!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>4194304){fprintf(stderr,"REFUSE\tmetadata-file-shape\tkind=%s\tpath=%s\n",kind,p);return 0;}char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size){fprintf(stderr,"REFUSE\tmetadata-read-size\tkind=%s\tpath=%s\n",kind,p);free(s);return 0;}return s;}
int main(int argc,char **argv){int session_mode=argc==3&&!strcmp(argv[1],"--all");if(!session_mode&&(argc!=2||(!strcmp(argv[1],"--smoke")?0:!strcmp(argv[1],"--list")?0:strcmp(argv[1],"--all")))){fprintf(stderr,"usage: --smoke | --all [ABS_SESSION] | --list\n");return 2;}if(!strcmp(argv[1],"--smoke"))return smoke();
 char root[4096],registry_path[4400],coverage_path[4400],why[600];const char *suffix="/tests/run.cx";if(!realpath(argv[0],root)){fprintf(stderr,"REFUSE\tinventory-root-source\terrno=%d\n",errno);return 2;}size_t z=strlen(root),sn=strlen(suffix);if(z<=sn||strcmp(root+z-sn,suffix)){fprintf(stderr,"REFUSE\tinventory-root-layout\texpected=ROOT/tests/run.cx\n");return 2;}root[z-sn]=0;
 snprintf(registry_path,sizeof registry_path,"%s/tests/batches.tsv",root);snprintf(coverage_path,sizeof coverage_path,"%s/tests/coverage.tsv",root);size_t rn,cn;char *reg=metadata_read(registry_path,"batches",&rn),*cov=metadata_read(coverage_path,"coverage",&cn);if(!reg||!cov){free(reg);free(cov);return 2;}
 tp_summary summary;int list=!strcmp(argv[1],"--list"),rc=tp_analyze(root,reg,rn,cov,cn,list,&summary,why,sizeof why);if(rc){fprintf(stderr,"REFUSE\tmetadata-schema\t%s\n",why);free(reg);free(cov);return 2;}
 if(session_mode)return all_session(root,argv[2],reg,rn,cov,cn);
 if(list){printf("PLAN\tmetadata_valid=1\tbatches=%d\timplemented_batches=%d\tplanned_batches=%d\tunprepared_batches=%d\tcoverage=%d\timplemented_coverage=%d\tunresolved=%d\texecuted_batches=0\tqualification=NOT_EXECUTED\n",summary.batches,summary.implemented_batches,summary.planned_batches,summary.unprepared_batches,summary.coverage_rows,summary.implemented_coverage,summary.unresolved_coverage);free(reg);free(cov);return 0;}
 run_inventory inventory={0};inventory.smoke_rc=smoke();tp_observer observer={inventory_batch,inventory_coverage,&inventory};rc=tp_visit(root,reg,rn,cov,cn,&observer,&summary,why,sizeof why);free(reg);free(cov);if(rc){fprintf(stderr,"REFUSE\tmetadata-schema\t%s\n",why);return 2;}if(!inventory.smoke_seen||inventory.invalid){fprintf(stderr,"REFUSE\tsmoke-registry-contract\texpected=one-exact-local-smoke-row\n");return 2;}
 printf("ALL\tNOT_READY\tmetadata_valid=1\tcoverage=%d\timplemented_coverage=%d\tunresolved=%d\tnot_run_batches=%d\tnot_run_coverage=%d\texecuted_local_smoke=1\texecuted_subprocess_batches=0\tqualification=NOT_READY\n",summary.coverage_rows,summary.implemented_coverage,inventory.unresolved,inventory.not_run_batches,inventory.not_run_coverage);return inventory.smoke_rc?inventory.smoke_rc:3;
}
