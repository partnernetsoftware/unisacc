/* Run from any cwd: sh /path/unisacc.com /path/tests/run.cx -- --smoke */
#pragma unisa use cases.product
static const char *names[]={"function","recursion","fibonacci","struct-array","pointer-mutation","callback","loop-control","short-circuit","memmove","format","format-bytes","parse-integer","parse-tail","allocation","sha256","module-state"};
static const long expected[]={42,720,55,34,17,81,25,0,0,7,0,-123,120,45,0,2};
static const char *missing[]={"stream.e2","stream.e1","stream.e3","stream.e4","stream.prune","stream.lower","stream.elf","interfaces","ri","properties","resources","negative","optimization","formats","hosts","bootstrap","library","candidate","phase-timing"};
static const char *separate[]={"pp","lex","parse","type","scope","irsel","enc","reloc","regmap","tyinfo","pfconv","peep","opinfo","prec","binsel","isel","abi","combo"};
static void gaps(int inventory){int i;for(i=0;i<19;i++)printf("NOT_READY\t%s\n",missing[i]);for(i=0;i<18;i++)printf("%s\tnet.%s\n",inventory?"IMPLEMENTED_SEPARATE_BATCH":"NOT_RUN",separate[i]);}
int main(int argc,char **argv){
 long actual[16];int i,failed=0,all=0;
 if(argc!=2){fprintf(stderr,"usage: --smoke | --all | --list\n");return 2;}
 if(!strcmp(argv[1],"--list")){for(i=0;i<16;i++)printf("IMPLEMENTED\tproduct.%s\n",names[i]);gaps(1);return 0;}
 if(!strcmp(argv[1],"--all"))all=1;else if(strcmp(argv[1],"--smoke")){fprintf(stderr,"unknown selection\n");return 2;}
 if(product_count()!=16){fprintf(stderr,"batch shape mismatch\n");return 2;}
 product_values(actual);
 for(i=0;i<16;i++){int ok=actual[i]==expected[i];if(!ok)failed++;printf("%s\tproduct.%s\tactual=%ld\texpected=%ld\n",ok?"PASS":"FAIL",names[i],actual[i],expected[i]);}
 puts("TIMING\texecute_seconds=UNMEASURED\tvalidate_seconds=UNMEASURED");
 puts("TIMING\tcompiler_startup_construction_loading_inference_output=UNMEASURED");
 printf("SMOKE\tassertions=16\tfailed=%d\tscope=local-product-batch\n",failed);
 if(all){gaps(0);puts("ALL\tNOT_READY\tmissing=19\tnot_run=18");return failed?1:3;}
 return failed?1:0;
}
