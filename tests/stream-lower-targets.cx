/* Five foreign output TARGETs observed on the local Linux/x86_64 host.
 * Four independent finite tape oracles per target; no foreign-host claim.
 * The prepared Root7a stream containers are development material, not a
 * replacement for same-candidate source/model proof on a later candidate. */
#pragma unisa use cxlib.netpack
static char root[4096],work[4096],bound[4200],inc[4200],product[4200];
static int checks,failures;
static const char *product_pin="7a0cf28bba67f2394abaf783b886baeafe0687f4590c392dbd8611212a0f5f77";
static const char *source_pin="4d9b8a3a526f340709316f7fb67189603bbd15bcd38dbab5b7997617c505a83e";
typedef struct {const char *target,*dir,*com,*model;} target_row;
static const target_row rows[]={
 {"lnx/arm64","out/c43-cdx-stream-pack-lnx-arm64-01","0271deed96b135b9be95a2e2fdbc44aefd0fdc1202ede388026ece04cef2e8ec","0eb9fb77c5c39d5f74cf5b171121a7adf159ac328bca0f21adf4dd1fe788f053"},
 {"osx/x86_64","out/c43-cdx-stream-pack-osx-x86_64-01","23466ea450377cdba274f54c09e9f0bdf23b7f711675c0ff33ac336c7fac15b0","338a761c6c77f564564d8f8e245814ad2baec36f1e53f5499372006a102924e5"},
 {"osx/arm64","out/c43-cdx-stream-pack-osx-arm64-01","2c06d08cf1e4cb0d178ef6a19056c564ba9141c2bb0574fd035c5582ad92b7c8","f22f353efbc6d0f4108653e03c27bd79b2bb09335c6f7fda70ac2d947cbfca7a"},
 {"win/x86_64","out/c43-cdx-stream-pack-win-x86_64-01","dd623b070edeb82643f130bdf76bb6887265b42417eec25f9dcbec4830f4245c","27493b9c35b09a8082499bb5ffbf6e9ce22c9eaf6397cd4120161f530afe14b7"},
 {"win/arm64","out/c43-cdx-stream-pack-win-arm64-01","84b0245bbe7dd911c0ffcf9aa5bdb6f4999b992192950e7aa5342e71fbdbfe8d","50f771fe324e05ab69b62d09a16a8bf4f1cc4e04adb8a93da92de69c0884fb31"}
};
static void die(const char *s){fprintf(stderr,"stream-lower-targets: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void ck(int ok,const char *name){checks++;if(!ok)failures++;printf("%s\tstream-lower-targets.%s\n",ok?"PASS":"FAIL",name);}
static void path(char *dst,size_t cap,const char *a,const char *b){int n=snprintf(dst,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path-bound");}
static void save(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC,0600);size_t at=0;if(fd<0)die("exclusive-create");while(at<n){ssize_t k=write(fd,s+at,n-at);if(k<0&&errno==EINTR)continue;if(k<=0)die("write");at+=(size_t)k;}if(close(fd))die("close");}
static char *readfile(const char *p,size_t *n){char *s=cx_read(p,n);if(!s)die(p);return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=readfile(p,&n);cx_sha256_hex(s,n,h);free(s);}
static int field(const char *s,const char *key,const char *val){char needle[160];int n=snprintf(needle,sizeof needle,"\"%s\":\"%s\"",key,val);return n>0&&(size_t)n<sizeof needle&&strstr(s,needle)!=0;}
static int lower_field(const char *s,const char *key,const char *val){const char *a=strstr(s,"\"stream_unit\":\"lower\"");const char *e;char item[1200];size_t n;if(!a||(e=strchr(a,'}'))==0)return 0;n=(size_t)(e-a);if(n>=sizeof item)return 0;memcpy(item,a,n);item[n]=0;return field(item,key,val);}
static void line(np_buf *b,const char *s){np_puts(b,s);np_puts(b,"\n");}
static void fmtline(np_buf *b,const char *fmt,const char *a,const char *c,const char *d){char t[400];int n=snprintf(t,sizeof t,fmt,a,c,d);if(n<0||(size_t)n>=sizeof t)die("oracle-bound");line(b,t);}
/* Read each gold row directly, requiring exactly one key. */
static void gold(const char *file,const char *key,const char *arch,char *out,size_t cap){char p[4200];size_t n,at=0;int hits=0;char *s;path(p,sizeof p,root,file);s=readfile(p,&n);
 while(at<n){size_t end=at,k=0,v=0,w=0;while(end<n&&s[end]!='\n')end++;if(end>at&&s[at]!='#'){
  while(at+k<end&&s[at+k]!='\t')k++;v=k+1;while(at+v<end&&s[at+v]!='\t')v++;w=v+1;
  if(at+w<=end&&k==strlen(key)&&!memcmp(s+at,key,k)&&v-k-1==strlen(arch)&&!memcmp(s+at+k+1,arch,v-k-1)){
   size_t len=end-at-w;if(len+1>cap)die("gold-value-bound");memcpy(out,s+at+w,len);out[len]=0;hits++;}}
  at=end+1;}
 free(s);if(hits!=1)die("gold-key-count");}
static void expected_head(np_buf *b,const char *target,int data){char os[8],arch[16],r7[16];const char *slash=strchr(target,'/');size_t k=(size_t)(slash-target);memcpy(os,target,k);os[k]=0;snprintf(arch,sizeof arch,"%s",slash+1);gold("weights/gold/regmap.tsv","r7",arch,r7,sizeof r7);
 fmtline(b,"@target %s",target,"","");line(b,data?"@data 41":"@data -");if(data){line(b,"@sym big 264");line(b,"@sym s 256");}fmtline(b,"@src_os %s",os,"","");line(b,!strcmp(os,"win")?(data?"@data_len 800":"@data_len 776"):(data?"@data_len 192":"@data_len 168"));line(b,!strcmp(os,"win")?"@bss 65536":"@bss 0");line(b,"@relocs -");line(b,"_start:");
 if(!strcmp(os,"win")){line(b,data?"winstdh 448":"winstdh 424");line(b,data?"winargs 328, 336, 544":"winargs 304, 312, 520");if(!strcmp(arch,"arm64"))fmtline(b,"spinit %s, %s",r7,data?"66592":"66568","");else fmtline(b,"spinit %s",r7,"","");}
 else{fmtline(b,"spinit %s",r7,"","");line(b,!strcmp(os,"lnx")?(data?"argsave 328, 336, true":"argsave 304, 312, true"):(data?"argsave 328, 336, false":"argsave 304, 312, false"));}}
static void run_case(const char *bin,const char *tag,const char *input,np_buf *want){char p[4200],why[1024],label[180];np_result r;char *av[]={bound,"12",(char *)bin,p,p,inc,0};const char *env[]={"UNISA_ATTRIBUTES=","UNISA_MAXSTEPS=200000000",0};path(p,sizeof p,work,tag);save(p,input,strlen(input));if(np_run(av,root,(char *const *)env,14,&r,why,sizeof why))die(why);
 snprintf(label,sizeof label,"%s.accept",tag);ck(r.rc==0&&r.errn==0,label);snprintf(label,sizeof label,"%s.target-text-exact",tag);ck(r.outn==want->n&&!memcmp(r.out,want->p,want->n),label);
 if(r.outn!=want->n||memcmp(r.out,want->p,want->n)){char q[4200];path(q,sizeof q,work,"actual.target.text");save(q,r.out,r.outn);}np_free(&r);}
int main(int argc,char **argv){const target_row *x=0;char dir[4200],bin[4200],receipt[4200],h[65],os[8],arch[16],reg[8][16],rel[3][16],tag[100];size_t n;char *json;np_buf b={0};int i;
 if(argc!=4)die("usage TARGET ROOT NEW_OUTDIR");for(i=0;i<5;i++)if(!strcmp(argv[1],rows[i].target))x=&rows[i];if(!x)die("unknown-target");
#if !defined(__linux__) || !defined(__x86_64__)
 puts("NOT_RUN\tlocal Linux/x86_64 host required");return 3;
#endif
 if(!realpath(argv[2],root)||argv[3][0]!='/')die("paths");snprintf(work,sizeof work,"%s",argv[3]);if(mkdir(work,0700))die("new-outdir-required");
 path(bound,sizeof bound,root,"tools/bound");path(inc,sizeof inc,root,"include");path(product,sizeof product,root,"unisacc.com");path(dir,sizeof dir,root,x->dir);path(bin,sizeof bin,dir,"unisacc-stream6.com");path(receipt,sizeof receipt,dir,"streams.json");
 digest(product,h);ck(!strcmp(h,product_pin),"material.product-root7a-pin");digest(bin,h);ck(!strcmp(h,x->com),"material.stream6-com-pin");json=readfile(receipt,&n);ck(field(json,"selected_route",strcat(strcpy(tag,x->target),"/image/O2")),"material.selected-route");ck(field(json,"source_package_sha256",source_pin),"material.source-package-pin");ck(lower_field(json,"original_M_record_sha256",x->model),"material.lower-record-pin");ck(lower_field(json,"com_sha256",x->com),"material.receipt-com-pin");ck(lower_field(json,"input","tape.text")&&lower_field(json,"output","target.text")&&lower_field(json,"file","unisacc-stream6.com"),"material.lower-route-shape");free(json);
 {const char *slash=strchr(x->target,'/');size_t k=(size_t)(slash-x->target);memcpy(os,x->target,k);os[k]=0;snprintf(arch,sizeof arch,"%s",slash+1);}
 for(i=0;i<8;i++){char key[4];snprintf(key,sizeof key,"r%d",i);gold("weights/gold/regmap.tsv",key,arch,reg[i],sizeof reg[i]);}
 gold("weights/gold/reloc.tsv","jmp",arch,rel[0],sizeof rel[0]);gold("weights/gold/reloc.tsv","jz",arch,rel[1],sizeof rel[1]);gold("weights/gold/reloc.tsv","call",arch,rel[2],sizeof rel[2]);
 expected_head(&b,x->target,0);fmtline(&b,"ret form=%s",!strcmp(arch,"arm64")?"arm":"x86","","");run_case(bin,"ret.tape","_start:\n  ret\n",&b);free(b.p);memset(&b,0,sizeof b);
 expected_head(&b,x->target,0);np_buf tape={0};line(&tape,"_start:");for(i=0;i<4;i++){char a[4],c[4];snprintf(a,sizeof a,"r%d",2*i);snprintf(c,sizeof c,"r%d",2*i+1);fmtline(&tape,"  mov %s, %s",a,c,"");fmtline(&b,"mov %s, %s",reg[2*i],reg[2*i+1],"");}line(&tape,"  ret");fmtline(&b,"ret form=%s",!strcmp(arch,"arm64")?"arm":"x86","","");run_case(bin,"registers.tape",tape.p,&b);free(tape.p);free(b.p);memset(&b,0,sizeof b);
 expected_head(&b,x->target,0);fmtline(&b,"jump L1 form=%s reloc=%s",!strcmp(arch,"arm64")?"arm":"x86",rel[0],"");line(&b,"L1:");fmtline(&b,"jumpz %s, L2 form=%s reloc=%s",reg[0],!strcmp(arch,"arm64")?"arm":"x86",rel[1]);line(&b,"L2:");fmtline(&b,"call L3 form=%s reloc=%s",!strcmp(arch,"arm64")?"arm":"x86",rel[2],"");line(&b,"L3:");fmtline(&b,"ret form=%s",!strcmp(arch,"arm64")?"arm":"x86","","");run_case(bin,"relocs.tape","_start:\n  jump L1\nL1:\n  jumpz r0, L2\nL2:\n  call L3\nL3:\n  ret\n",&b);free(b.p);memset(&b,0,sizeof b);
 expected_head(&b,x->target,1);fmtline(&b,"ret form=%s",!strcmp(arch,"arm64")?"arm":"x86","","");run_case(bin,"sparse.tape",".bss big 16\n.str s \"A\"\n_start:\n  ret\n",&b);free(b.p);
 digest(product,h);ck(!strcmp(h,product_pin),"identity.product-stable");digest(bin,h);ck(!strcmp(h,x->com),"identity.stream6-stable");
 printf("STREAM_LOWER_TARGETS\ttarget=%s\tassertions=%d\tfailed=%d\truns=4\tscope=local-four-tape-fixture\n",x->target,checks,failures);
 puts("NOT_CLAIMED\tforeign-host-full-gold-parent-same-candidate-model");return failures?1:0;}
