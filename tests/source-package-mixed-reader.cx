#pragma unisa use cxlib.mixedsnapshot
#pragma unisa use cxlib.mixedprofiles
int main(int argc,char **argv){
 if(argc!=5&&argc!=6){fputs("usage: SOURCE_ROOT PACKAGE_DIR FRESH_SOURCE TOOL_ROOT [EXPECTED_PROFILE]\n",stderr);return 2;}const char *expected=argc==6?argv[5]:"f9-ace3-v1";mp_profile role={0};if(!mp_get(expected,&role)){fputs("MIXED_READER_REFUSE\tunknown-expected-profile\n",stderr);return 2;}mx_result r={0};char why[4096]={0};
 if(mx_verify_snapshot(argv[1],argv[2],argv[3],48,&r,why,sizeof why)){fprintf(stderr,"MIXED_READER_REFUSE\t%s\n",why);return 2;}
 int ok=!strcmp(r.material_profile,expected)&&!strcmp(r.source_root,argv[1])&&!strcmp(r.tool_root,argv[4])&&r.origin_jobs==107&&r.origin_models==34&&r.current_union_jobs==role.current_union_jobs&&r.current_net_models==role.current_models&&r.adopted_net_models==role.adopted_models&&r.origin_physical_reads==(role.origin_context_version==2?1005:1004);
 if(argc==6)printf("MATERIAL\tmode=explicit-profile\texpected-profile=%s\tactual-profile=%s\n",expected,r.material_profile);printf("%s\tmixed-reader.full-origin107-current%d-%dnew%dadopted\n",ok?"PASS":"FAIL",role.current_union_jobs,role.current_models,role.adopted_models);return ok?0:1;
}
