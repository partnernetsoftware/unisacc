#!/usr/bin/env -S unisacc.com -run
/* Host-cc oracle for decimal/hex floating literals and u64 integer tokens.
 * Explicit tools and harness preparation cache only verified constructive
 * artifacts. The consumer always runs a fresh host oracle, --check-net and
 * all166 assertions. Missing/stale/corrupt prepared inputs return75.
 * Recipes and original checker pins, E3 bytes, actors, tool/header readsets,
 * product leaves, host and environment bind the cache; no verdict is cached.
 * Preparation: --prepare --part tools, then --prepare --part harness.
 * Consumer: --require-cached [--evidence ABS_PRIVATE_OUT].
 * Independent C/P parity and original-budget receipts are recorded under
 * research/c43-f4-preparation-evidence; original F4 timeout records remain.
 */
#pragma unisa use cxlib.seedprep

