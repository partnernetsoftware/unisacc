static sp_buf dc_rows = {0,0,0}, dc_commands = {0,0,0};
static int dc_flushed;
static char *dc_flight,*dc_e3,*dc_tcache,*dc_hcache,*dc_base;
static sp_json *dc_common_saved,*dc_tbasis,*dc_hbasis;
static const char *const DC_TOOL_FILES[]={"decimal-run","decimal-tbl","decimal-net",0};
static const char *const DC_HARNESS_FILES[]={"h.json","h.tbl","h.net",0};
static const char *const DC_NO_EXECS[]={0};

