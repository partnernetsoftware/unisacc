static void dc_write(const char *path,const void *bytes,size_t n,int exclusive) {
    int fd=open(path,O_WRONLY|O_CREAT|(exclusive?O_EXCL:O_TRUNC),0600);
    size_t at=0;ssize_t k;
    if(fd<0){fprintf(stderr,"decimalcheck: cannot create %s\n",path);sp_exit(1);}
    while(at<n){k=write(fd,(const char *)bytes+at,n-at);
        if(k<0&&errno==EINTR)continue;
        if(k<=0){close(fd);fprintf(stderr,"decimalcheck: write failed %s\n",path);sp_exit(1);}at+=(size_t)k;}
    if(close(fd)){fprintf(stderr,"decimalcheck: close failed %s\n",path);sp_exit(1);}
}
static void dc_flush(void) {
    if(!dc_ev||dc_flushed)return;
    dc_flushed=1;
    dc_write(sp_pjoin(dc_ev,"cases.tsv"),dc_rows.s,dc_rows.n,1);
    dc_write(sp_pjoin(dc_ev,"commands.jsonl"),dc_commands.s,dc_commands.n,1);
}
static void dc_fail(const char *why) {
    dc_flush();fprintf(stderr,"decimalcheck: %s\n",why);sp_exit(1);
}
static void dc_copy(const char *from,const char *leaf) {
    int in,out;char b[65536];ssize_t n,k;size_t at;char *to;
    if(!dc_ev)return;
    to=sp_pjoin(dc_ev,leaf);in=open(from,O_RDONLY);
    if(in<0)dc_fail("evidence input missing");
    out=open(to,O_WRONLY|O_CREAT|O_EXCL,0600);
    if(out<0){close(in);dc_fail("evidence file exists or cannot be created");}
    for(;;){n=read(in,b,sizeof b);if(n<0&&errno==EINTR)continue;
        if(n<0){close(in);close(out);dc_fail("evidence read failed");}if(!n)break;
        at=0;while(at<(size_t)n){k=write(out,b+at,(size_t)n-at);
            if(k<0&&errno==EINTR)continue;
            if(k<=0){close(in);close(out);dc_fail("evidence copy failed");}at+=(size_t)k;}}
    if(close(in)){close(out);dc_fail("evidence input close failed");}
    if(close(out))dc_fail("evidence output close failed");free(to);
}
static void dc_evidence(const char *p) {
    char *r,*prefix;struct stat st;size_t n;
    if(!p||p[0]!='/')dc_fail("evidence requires an absolute existing private out directory");
    r=sp_realpath_ns(p);prefix=sp_cat(sp_root(),"/out/");n=strlen(prefix);
    if(strcmp(r,p)||strncmp(r,prefix,n)||!r[n]||lstat(r,&st)||
       !S_ISDIR(st.st_mode)||st.st_uid!=geteuid()||(st.st_mode&0077))
        dc_fail("evidence directory must be canonical, owned, mode0700 and under this repo/out");
    free(prefix);dc_ev=r;
}
static void dc_hex(sp_buf *b,const char *s,size_t n) {
    static const char h[]="0123456789abcdef";size_t i;
    for(i=0;i<n;i++){unsigned char c=(unsigned char)s[i];sp_bch(b,h[c>>4]);sp_bch(b,h[c&15]);}
}
static void dc_row(const char *group,int index,const char *model,int rc,
                   const char *out,size_t on,const char *err,size_t en) {
    char number[48];
    if(!dc_ev)return;
    sp_bstr(&dc_rows,group);sp_bch(&dc_rows,'\t');snprintf(number,sizeof number,"%d",index);
    sp_bstr(&dc_rows,number);sp_bch(&dc_rows,'\t');sp_bstr(&dc_rows,model);sp_bch(&dc_rows,'\t');
    snprintf(number,sizeof number,"%d",rc);sp_bstr(&dc_rows,number);sp_bch(&dc_rows,'\t');
    dc_hex(&dc_rows,out,on);sp_bch(&dc_rows,'\t');dc_hex(&dc_rows,err,en);sp_bch(&dc_rows,'\n');
}
static sp_json *dc_int(int x) {
    char b[48];sp_json *j=sp_jnew(SP_JINT);snprintf(b,sizeof b,"%d",x);j->s=sp_xstrdup(b);return j;
}
static int dc_run(const char *label,char **argv,int seconds,char **out,size_t *on,char **err,size_t *en) {
    int rc,i;sp_json *row,*args;sp_buf json={0,0,0};
    if(seconds<1||seconds>55)dc_fail("invalid subprocess budget");
    *out=0;*err=0;*on=0;*en=0;
    rc=sp_spawn(argv,(double)seconds,out,on,err,en);
    if(dc_ev){row=sp_jnew(SP_JOBJ);args=sp_jnew(SP_JARR);
        sp_oset(row,"label",sp_jstr(label));for(i=0;argv[i];i++)sp_apush(args,sp_jstr(argv[i]));
        sp_oset(row,"argv",args);sp_oset(row,"limit",dc_int(seconds));sp_oset(row,"rc",dc_int(rc));
        sp_jdump(&json,row,0,0);sp_bput(&dc_commands,json.s,json.n);sp_bch(&dc_commands,'\n');free(json.s);}
    if(rc<0||rc==142){if(*err&&*en)fwrite(*err,1,*en,stderr);dc_fail("subprocess timeout or signal (not a semantic refusal)");}
    return rc;
}
static char *dc_ok(const char *label,char **argv,int seconds,size_t *n) {
    char *out,*err;size_t on,en;int rc=dc_run(label,argv,seconds,&out,&on,&err,&en);
    if(rc){if(en)fwrite(err,1,en,stderr);free(out);free(err);dc_fail("checked subprocess failed");}
    free(err);if(n)*n=on;return out;
}
static void dc_originals(void) {
    char h[65];
    if(sp_sha_file("exec/parse2/floatconstcheck.py",h)||strcmp(h,DC_ORIGINAL_SHA)||
       sp_sha_file("exec/parse2/floatconstcheck.sh",h)||strcmp(h,DC_SHELL_SHA))
        dc_fail("original checker changed; refresh/review this port before execution");
}
static sp_json *dc_pair(const char *next,int index) {
    sp_json *p=sp_jnew(SP_JARR);sp_apush(p,sp_jstr(next));sp_apush(p,dc_int(index));return p;
}
static sp_json *dc_act1(const char *op,const char *arg) {
    sp_json *a=sp_jnew(SP_JARR);sp_apush(a,sp_jstr(op));if(arg)sp_apush(a,sp_jstr(arg));return a;
}
static void dc_state(sp_json *d,const char *name,const char *next,sp_json *acts) {
    sp_json *seqs=sp_getitem(d,"seqs"),*states=sp_getitem(d,"states"),*row,*s;int i,index;char key[16];
    if(!seqs||seqs->t!=SP_JARR||!states||states->t!=SP_JOBJ)dc_fail("invalid E3 states/seqs");
    index=seqs->n;sp_apush(seqs,acts);row=sp_jnew(SP_JOBJ);
    for(i=0;i<257;i++){snprintf(key,sizeof key,"%d",i);sp_oset(row,key,dc_pair(next,index));}
    s=sp_jnew(SP_JARR);sp_apush(s,sp_jstr("r"));sp_apush(s,row);sp_oset(states,name,s);
}
static void dc_freejson(sp_json *j) {
    int i;if(!j)return;for(i=0;i<j->n;i++){dc_freejson(j->v[i]);free(j->k[i]);}
    free(j->v);free(j->k);free(j->kn);free(j->s);free(j);
}
static void dc_harness(const char *input,const char *output) {
    char *bytes;size_t n,i;sp_json *d,*acts,*a,*seqs,*ret,*states;sp_buf text={0,0,0},compact={0,0,0};int quoted=0,escape=0,k,index;
    bytes=sp_read_file(input,&n);if(!bytes)sp_crash();d=sp_jloads(bytes,n);free(bytes);if(!d)sp_crash();
    if(d->t!=SP_JOBJ)dc_fail("E3 input is not an object");
    acts=sp_jnew(SP_JARR);sp_apush(acts,dc_act1("PUSH","TEST.done"));dc_state(d,"TEST","SPANNUM",acts);
    acts=sp_jnew(SP_JARR);sp_apush(acts,dc_act1("OUTW","tk"));
    for(k=0;k<8;k++){a=sp_jnew(SP_JARR);sp_apush(a,sp_jstr("A64I"));sp_apush(a,sp_jstr("shr"));
        sp_apush(a,sp_jstr("test_byte"));sp_apush(a,sp_jstr("nv"));sp_apush(a,dc_int(k*8));
        sp_apush(acts,a);sp_apush(acts,dc_act1("OUTW","test_byte"));}
    sp_apush(acts,dc_act1("ACCEPT",0));dc_state(d,"TEST.done","HALT",acts);sp_oset(d,"start",sp_jstr("TEST"));
    seqs=sp_getitem(d,"seqs");index=seqs->n;acts=sp_jnew(SP_JARR);sp_apush(acts,dc_act1("POP",0));sp_apush(seqs,acts);
    states=sp_getitem(d,"states");ret=sp_getitem(states,"RET");
    if(!ret||ret->t!=SP_JARR||ret->n!=2||ret->v[1]->t!=SP_JOBJ)dc_fail("E3 RET row unavailable");
    sp_oset(ret->v[1],"TEST.done",dc_pair("TEST.done",index));
    /* seedprep dumps Python ensure_ascii/order; remove only structural whitespace
       to reproduce json.dumps(separators=(',',':')), never whitespace in strings. */
    sp_jdump(&text,d,0,0);
    for(i=0;i<text.n;i++){unsigned char c=(unsigned char)text.s[i];
        if(quoted){sp_bch(&compact,c);if(escape)escape=0;else if(c=='\\')escape=1;else if(c=='"')quoted=0;}
        else if(c=='"'){quoted=1;sp_bch(&compact,c);}
        else if(c!=' '&&c!='\t'&&c!='\r'&&c!='\n')sp_bch(&compact,c);}
    if(quoted||escape)dc_fail("internal compact JSON string state");
    dc_write(output,compact.s,compact.n,0);free(text.s);free(compact.s);dc_freejson(d);
}
static unsigned long long dc_number(const char *s,size_t n,int base) {
    unsigned long long v=0,maximum=~0ULL;size_t i;unsigned d;
    if(!n)dc_fail("empty oracle/integer value");
    for(i=0;i<n;i++){unsigned char c=(unsigned char)s[i];
        if(c>='0'&&c<='9')d=c-'0';else if(c>='a'&&c<='f')d=c-'a'+10;else if(c>='A'&&c<='F')d=c-'A'+10;else dc_fail("non-digit oracle/integer value");
        if(d>=(unsigned)base||v>(maximum-d)/(unsigned)base)dc_fail("oracle/integer overflow");v=v*(unsigned)base+d;}
    return v;
}
static unsigned long long dc_integer(const char *s) {
    size_t n=strlen(s);int base=10;
    while(n&&(s[n-1]=='u'||s[n-1]=='U'||s[n-1]=='l'||s[n-1]=='L'))n--;
    if(n>2&&s[0]=='0'&&(s[1]=='x'||s[1]=='X'))return dc_number(s+2,n-2,16);
    if(n>1&&s[0]=='0')base=8;return dc_number(s,n,base);
}
static unsigned long long dc_le64(const char *s) {
    unsigned long long v=0;int i;for(i=0;i<8;i++)v|=(unsigned long long)(unsigned char)s[i]<<(i*8);return v;
}
static int dc_ws(int c){return c==' '||c=='\t'||c=='\r'||c=='\n'||c=='\v'||c=='\f';}
static int dc_count(const char *const *v){int n=0;while(v[n])n++;return n;}
static void dc_input(const char *path,const char *value) {
    sp_buf b={0,0,0};sp_bstr(&b,value);sp_bch(&b,'\n');dc_write(path,b.s,b.n,0);free(b.s);
}

/* Prepared artifacts, not test results. All mutable staging is under our owned
   flight directory; cache directories publish by atomic rename under one lock. */
static void dc_need(const char *why) {
    dc_flush();fprintf(stderr,"NEED_PREPARE decimal: %s\n",why);sp_exit(75);
}
static void dc_hook(const char *cls,const char *message) {(void)cls;dc_need(message);}
static char *dc_sha(const char *path) {
    char h[65];if(sp_sha_file(path,h))sp_crash();return sp_xstrdup(h);
}
static sp_json *dc_version(char *cc) {
    char *a[]={cc,"--version",0},*o,*e;size_t on,en;int rc;
    sp_json *j=sp_jnew(SP_JOBJ);rc=dc_run("cc-version",a,5,&o,&on,&e,&en);
    if(rc)dc_need("cc version unavailable");
    sp_oset(j,"stdout",sp_jstrn(o,on));sp_oset(j,"stderr",sp_jstrn(e,en));free(o);free(e);return j;
}
static sp_json *dc_headers(char *which,const char *source,char **flags) {
    sp_json *r,*v;char *actual[20],*resolved[20],*ao,*ae,*bo,*be;size_t an,aen,bn,ben;
    int i,n=0,ar,br;
    if(sp_cc_read_set(which,source,flags,&r))sp_crash();
    actual[n++]="cc";for(i=0;flags[i];i++)actual[n++]=flags[i];
    actual[n++]="-M";actual[n++]="-MT";actual[n++]="__checklib_readset__";actual[n++]=(char *)source;actual[n]=0;
    for(i=0;i<=n;i++)resolved[i]=actual[i];resolved[0]=sp_realpath_ns(which);
    ar=dc_run("headers-actual",actual,55,&ao,&an,&ae,&aen);
    br=dc_run("headers-resolved",resolved,55,&bo,&bn,&be,&ben);
    if(ar||br||an!=bn||aen!=ben||memcmp(ao,bo,an)||memcmp(ae,be,aen))dc_need("literal cc and resolved header scan differ");
    free(ao);free(ae);free(bo);free(be);v=sp_jnew(SP_JARR);
    for(i=0;actual[i];i++)sp_apush(v,sp_jstr(actual[i]));sp_oset(r,"actual_cc_argv",v);return r;
}
static sp_json *dc_basis(void) {
    static const char *const seeds[]={"tests/decimalcheck.cx","tests/cxlib/seedprep.cx",
      "tests/execchainprepared.cx","tests/execchainconsumer.sh","tests/cxbin","tests/safedel.cx",
      "tests/bound","tests/bound.c","exec/parse2/floatconstcheck.py","exec/parse2/floatconstcheck.sh",
      "seed/tbl.c","seed/net.c","seed/json.h","exec/c/run.c","exec/c/core.h",0};
    static const char *const envs[]={"PATH","CC","EXEC_CC","CFLAGS","CPPFLAGS","LDFLAGS","CPATH",
      "C_INCLUDE_PATH","CPLUS_INCLUDE_PATH","OBJC_INCLUDE_PATH","LIBRARY_PATH","COMPILER_PATH",
      "GCC_EXEC_PREFIX","GCC_SPECS","SOURCE_DATE_EPOCH","LD_LIBRARY_PATH","LD_PRELOAD","LD_AUDIT",
      "LANG","LC_ALL","LC_CTYPE","TZ","TMPDIR","TMP","TEMP","PYTHONPATH","PYTHONHOME",
      "PYTHONHASHSEED","PYTHONPYCACHEPREFIX","PYTHONUSERBASE",0};
    static const char *const prefixes[]={"UNISA_","UNISACC_","SEED_","E1","E2","E3","E4","DYLD_",0};
    char *which=sp_which("cc"),*entity,*py;char *rf[]={"-O2",0},*tf[]={"-std=c99","-O2","-w","-Iseed",0};
    sp_json *b=sp_jnew(SP_JOBJ),*actors,*edges,*cc,*rs,*env,*host,*recipes,*r;int i,j;extern char **environ;
    dc_originals();if(!which)dc_need("literal cc missing");entity=sp_realpath_ns(which);
    /* Only known text-only CX/module and standard-import checker enter the
       recursive actor scanner. Shell helpers and actual binary leaves are bound
       separately as raw bytes: never recursively decode product PE as UTF-8. */
    {static const char *const safe_seeds[]={"tests/decimalcheck.cx","tests/cxlib/seedprep.cx","exec/parse2/floatconstcheck.py",0};
      sp_actor_closure(safe_seeds,&actors,&edges);}
    if(!sp_getitem(actors,"tests/decimalcheck.cx")||!sp_getitem(actors,"tests/cxlib/seedprep.cx"))dc_need("actor closure incomplete");
    sp_oset(b,"schema",sp_jstr("decimal-prepared-v2"));sp_oset(b,"sources",sp_jstr(sp_source_digest()));
    sp_oset(b,"e3_sha256",sp_jstr(dc_sha(dc_e3)));sp_oset(b,"actors",actors);sp_oset(b,"actor_edges",edges);
    {sp_json *raw=sp_jnew(SP_JOBJ);for(i=0;seeds[i];i++)sp_oset(raw,seeds[i],sp_jstr(dc_sha(sp_pjoin(sp_root(),seeds[i]))));
      sp_oset(b,"text_actor_bytes",raw);}
    {sp_json *raw=sp_jnew(SP_JOBJ);sp_oset(raw,"unisacc.com",sp_jstr(dc_sha(sp_pjoin(sp_root(),"unisacc.com"))));
      sp_oset(raw,"unisacc.com.build.json",sp_jstr(dc_sha(sp_pjoin(sp_root(),"unisacc.com.build.json"))));
      sp_oset(b,"product_binary_leaves",raw);}
    cc=sp_jnew(SP_JOBJ);sp_oset(cc,"invocation",sp_jstr("cc"));sp_oset(cc,"path_lookup",sp_jstr(which));
    sp_oset(cc,"resolved",sp_jstr(entity));sp_oset(cc,"sha256",sp_jstr(dc_sha(entity)));
    sp_oset(cc,"actual_version",dc_version("cc"));sp_oset(cc,"resolved_version",dc_version(entity));sp_oset(b,"compiler",cc);
    rs=sp_jnew(SP_JOBJ);sp_oset(rs,"runtime",dc_headers(which,"exec/c/run.c",rf));
    sp_oset(rs,"table-tool",dc_headers(which,"seed/tbl.c",tf));sp_oset(rs,"network-tool",dc_headers(which,"seed/net.c",tf));sp_oset(b,"header_readsets",rs);
    recipes=sp_jnew(SP_JOBJ);
    {char *a[]={"cc","-O2","exec/c/run.c","-o","{OUT}/decimal-run",0};r=sp_jnew(SP_JARR);for(i=0;a[i];i++)sp_apush(r,sp_jstr(a[i]));sp_oset(recipes,"runtime",r);}
    {char *a[]={"cc","-std=c99","-O2","-w","-Iseed","seed/tbl.c","-o","{OUT}/decimal-tbl",0};r=sp_jnew(SP_JARR);for(i=0;a[i];i++)sp_apush(r,sp_jstr(a[i]));sp_oset(recipes,"table-tool",r);}
    {char *a[]={"cc","-std=c99","-O2","-w","-Iseed","seed/net.c","-o","{OUT}/decimal-net",0};r=sp_jnew(SP_JARR);for(i=0;a[i];i++)sp_apush(r,sp_jstr(a[i]));sp_oset(recipes,"network-tool",r);}
    sp_oset(recipes,"harness",sp_jstr("original TEST/TEST.done/RET/start rewrite; seed-tbl h.json h.tbl; seed-net h.tbl h.net"));sp_oset(b,"recipes",recipes);
    py=sp_realpath_ns(sp_python());sp_oset(b,"handoff_interpreter_path",sp_jstr(py));sp_oset(b,"handoff_interpreter_sha256",sp_jstr(dc_sha(py)));
    env=sp_jnew(SP_JOBJ);for(i=0;envs[i];i++){const char *v=getenv(envs[i]);sp_oset(env,envs[i],v?sp_jstr(v):sp_jnew(SP_JNULL));}
    for(i=0;environ[i];i++){const char *eq=strchr(environ[i],'=');if(!eq)continue;
      if((size_t)(eq-environ[i])==strlen("UNISACC_BOUND_DEADLINE_MONO")&&!memcmp(environ[i],"UNISACC_BOUND_DEADLINE_MONO",strlen("UNISACC_BOUND_DEADLINE_MONO")))continue;
      for(j=0;prefixes[j];j++)if((size_t)(eq-environ[i])>=strlen(prefixes[j])&&!strncmp(environ[i],prefixes[j],strlen(prefixes[j]))){sp_osetn(env,environ[i],(size_t)(eq-environ[i]),sp_jstr(eq+1));break;}}
    sp_oset(b,"environment",env);host=sp_jnew(SP_JARR);sp_apush(host,sp_jstr(sp_uname_field("-s")));sp_apush(host,sp_jstr(sp_uname_field("-m")));sp_oset(b,"host",host);return b;
}
static sp_json *dc_part_basis(sp_json *common,const char *part,sp_json *tools) {
    sp_json *b=sp_jnew(SP_JOBJ);sp_oset(b,"common",common);sp_oset(b,"sources",sp_getitem(common,"sources"));
    sp_oset(b,"part",sp_jstr(part));if(tools)sp_oset(b,"tool_outputs",tools);return b;
}
static char *dc_keydir(sp_json *basis,const char *prefix) {
    sp_buf j={0,0,0};char h[65];sp_jdump(&j,basis,0,1);cx_sha256_hex(j.s,j.n,h);free(j.s);return sp_pjoin(dc_base,sp_cat(prefix,h));
}
static int dc_valid(const char *cache,sp_json *basis,const char *const *files,const char *const *execs) {
    return sp_valid_manifest(cache,basis,files,execs,"decimal prepared identity/output mismatch")==0;
}
static sp_json *dc_outputs(const char *cache) {
    char *t;size_t n;sp_json *d;t=sp_read_file(sp_pjoin(cache,"manifest.json"),&n);if(!t)sp_crash();
    d=sp_jloads(t,n);free(t);if(!d)sp_crash();return sp_getitem(d,"outputs");
}
static void dc_manifest(const char *dir,sp_json *basis,const char *const *files) {
    sp_json *d=sp_jnew(SP_JOBJ),*o=sp_jnew(SP_JOBJ);sp_buf b={0,0,0};char *m=sp_pjoin(dir,"manifest.json");int i;
    for(i=0;files[i];i++)sp_oset(o,files[i],sp_jstr(dc_sha(sp_pjoin(dir,files[i]))));
    sp_oset(d,"basis",basis);sp_oset(d,"outputs",o);sp_jdump(&b,d,0,1);sp_bch(&b,'\n');dc_write(m,b.s,b.n,1);free(b.s);
    sp_prov_write(m,sp_getitem(basis,"sources")->s);
}
static void dc_publish(char *prepared,char *cache,sp_json *basis,const char *const *files,const char *const *execs) {
    struct stat st;if(!sp_jeq(dc_common_saved,dc_basis()))dc_need("inputs changed during prepare");
    dc_manifest(prepared,basis,files);if(!dc_valid(prepared,basis,files,execs))dc_need("new staging artifacts failed verification");
    if(!lstat(cache,&st)){if(cx_trash(cache))dc_need("old invalid cache guard refusal");}else if(errno!=ENOENT)dc_need("cache lstat failed");
    if(rename(prepared,cache))dc_need("atomic cache install failed");
    if(!dc_valid(cache,basis,files,execs))dc_need("installed cache failed verification");
}
static void dc_cached_copy(const char *cache,const char *name,const char *dest,sp_json *expected,int executable) {
    char *src=sp_pjoin(cache,name),*bytes;size_t n;char h[65];struct stat st;
    if(!expected||sp_verify_cached_file(src,expected,executable))dc_need("cached artifact changed before copy");
    if(!lstat(dest,&st)||errno!=ENOENT)dc_need("materialization destination exists or cannot be inspected");
    bytes=sp_read_file(src,&n);if(!bytes)sp_crash();cx_sha256_hex(bytes,n,h);
    if(strcmp(h,expected->s))dc_need("cached bytes changed while reading");dc_write(dest,bytes,n,1);free(bytes);
    if(executable&&chmod(dest,0755))dc_need("executable copy mode failed");
    if(sp_sha_file(dest,h)||strcmp(h,expected->s))dc_need("materialized bytes differ");free(src);
}
static void dc_prepare_tools(void) {
    char *w=sp_pjoin(dc_flight,"tools-work"),*a[12];if(mkdir(w,0700))dc_need("cannot create tools staging");
    a[0]="cc";a[1]="-O2";a[2]="exec/c/run.c";a[3]="-o";a[4]=sp_pjoin(w,"decimal-run");a[5]=0;free(dc_ok("build-runtime",a,55,0));
    a[0]="cc";a[1]="-std=c99";a[2]="-O2";a[3]="-w";a[4]="-Iseed";a[5]="seed/tbl.c";a[6]="-o";a[7]=sp_pjoin(w,"decimal-tbl");a[8]=0;free(dc_ok("build-table-tool",a,55,0));
    a[5]="seed/net.c";a[7]=sp_pjoin(w,"decimal-net");free(dc_ok("build-network-tool",a,55,0));
    dc_publish(w,dc_tcache,dc_tbasis,DC_TOOL_FILES,DC_TOOL_FILES);
}
static void dc_prepare_harness(void) {
    char *w=sp_pjoin(dc_flight,"harness-work"),*a[5],*h,*t,*n;if(mkdir(w,0700))dc_need("cannot create harness staging");
    if(!dc_valid(dc_tcache,dc_tbasis,DC_TOOL_FILES,DC_TOOL_FILES))dc_need("tools required before harness");
    h=sp_pjoin(w,"h.json");t=sp_pjoin(w,"h.tbl");n=sp_pjoin(w,"h.net");dc_harness(dc_e3,h);
    a[0]=sp_pjoin(dc_tcache,"decimal-tbl");a[1]=h;a[2]=t;a[3]=0;free(dc_ok("table-harness",a,55,0));
    a[0]=sp_pjoin(dc_tcache,"decimal-net");a[1]=t;a[2]=n;free(dc_ok("network-harness",a,55,0));
    if(!dc_valid(dc_tcache,dc_tbasis,DC_TOOL_FILES,DC_TOOL_FILES))dc_need("tools changed during harness prepare");
    dc_publish(w,dc_hcache,dc_hbasis,DC_HARNESS_FILES,DC_NO_EXECS);
}

int main(int argc,char **argv) {
    char *temp,*tmpbase,*hjson,*table,*net,*runtime,*oraclec,*oracle,*input,*out,*err;
    const char *evidence=0,*part=0,*models[]={"h.tbl","h.net"};unsigned long long expected[61];
    sp_buf csrc={0,0,0};size_t on,en,at,begin;int a,j,nvalues,nbad,nintegers,noverflow,rc,prep=0,req=0,checks=0;char *args[16];
    sp_json *to,*ho;struct stat st;
    sp_init(__FILE__);atexit(sp_scratch_remove);if(chdir(sp_root())){sp_throw_os(errno,sp_root());sp_crash();}
    for(a=1;a<argc;a++){
      if(!strcmp(argv[a],"--prepare")&&!prep)prep=1;
      else if(!strcmp(argv[a],"--require-cached")&&!req)req=1;
      else if(!strcmp(argv[a],"--part")&&!part&&a+1<argc)part=argv[++a];
      else if(!strcmp(argv[a],"--evidence")&&!evidence&&a+1<argc)evidence=argv[++a];
      else{fprintf(stderr,"usage: decimalcheck.cx --prepare --part tools|harness OR --require-cached [--evidence PRIVATE_OUT]\n");return 2;}}
    if((prep&&req)||(!prep&&part)||(prep&&evidence)||(part&&strcmp(part,"tools")&&strcmp(part,"harness"))){fprintf(stderr,"decimalcheck: conflicting/invalid modes\n");return 2;}
    if(prep&&!part)part="harness";if(!prep)req=1;dc_originals();if(evidence)dc_evidence(evidence);
    sp_bstr(&dc_rows,"group\tindex\tmodel\trc\tstdout_hex\tstderr_hex\n");
    nvalues=dc_count(dc_values);nbad=dc_count(dc_badvalues);nintegers=dc_count(dc_integers);noverflow=dc_count(dc_overflow);
    if(nvalues!=61||nbad!=10||nintegers!=8||noverflow!=4)dc_fail("case set changed or became empty");
    sp_set_raise_hook(dc_hook);
    {const char *v=getenv("UNISACC_MODEL_CACHE");tmpbase=v?sp_abspath(v):sp_pjoin(sp_gettempdir(),"unisacc-model-cache");}
    dc_base=tmpbase;if(!strcmp(dc_base,"/")||!strcmp(dc_base,sp_root())||(getenv("HOME")&&!strcmp(dc_base,getenv("HOME"))))dc_need("unsafe cache root");
    sp_mkdirs(dc_base);if(lstat(dc_base,&st)||!S_ISDIR(st.st_mode)||st.st_uid!=getuid())dc_need("cache root must be an owned directory");
    dc_flight=sp_xstrdup(sp_mkdtemp_py(dc_base,"decimal-flight-"));
    temp=sp_pjoin(dc_flight,"input");if(mkdir(temp,0700))dc_need("cannot create E3 materialization directory");
    args[0]="sh";args[1]=sp_pjoin(sp_root(),"tests/cxbin");args[2]="tests/execchainprepared.cx";args[3]="--materialize";args[4]=temp;args[5]=0;
    rc=dc_run("materialize-default",args,55,&out,&on,&err,&en);
    if(rc==75){if(on)fwrite(out,1,on,stdout);if(en)fwrite(err,1,en,stderr);free(out);free(err);dc_flush();sp_exit(75);}
    if(rc){if(en)fwrite(err,1,en,stderr);free(out);free(err);dc_need("default E3 handoff not verified");}free(out);free(err);
    dc_e3=sp_pjoin(temp,"e3.json");dc_common_saved=dc_basis();
    dc_tbasis=dc_part_basis(dc_common_saved,"tools",0);dc_tcache=dc_keydir(dc_tbasis,"decimal-tools-");sp_lock(sp_cat(dc_tcache,".lock"));
    if(prep&&!strcmp(part,"tools")){
      if(!dc_valid(dc_tcache,dc_tbasis,DC_TOOL_FILES,DC_TOOL_FILES))dc_prepare_tools();
      if(!dc_valid(dc_tcache,dc_tbasis,DC_TOOL_FILES,DC_TOOL_FILES)||!sp_jeq(dc_common_saved,dc_basis()))dc_need("tools not valid at prepare exit");
      printf("DECIMAL_PREPARED tools %s\n",dc_tcache);sp_scratch_remove();return 0;}
    if(!dc_valid(dc_tcache,dc_tbasis,DC_TOOL_FILES,DC_TOOL_FILES))dc_need("tools absent/stale/corrupt; run explicit tools prepare");
    to=dc_outputs(dc_tcache);dc_hbasis=dc_part_basis(dc_common_saved,"harness",to);dc_hcache=dc_keydir(dc_hbasis,"decimal-harness-");sp_lock(sp_cat(dc_hcache,".lock"));
    if(prep){
      if(!dc_valid(dc_hcache,dc_hbasis,DC_HARNESS_FILES,DC_NO_EXECS))dc_prepare_harness();
      if(!dc_valid(dc_tcache,dc_tbasis,DC_TOOL_FILES,DC_TOOL_FILES)||!dc_valid(dc_hcache,dc_hbasis,DC_HARNESS_FILES,DC_NO_EXECS)||!sp_jeq(dc_common_saved,dc_basis()))dc_need("inputs changed at harness prepare exit");
      printf("DECIMAL_PREPARED harness %s\n",dc_hcache);sp_scratch_remove();return 0;}
    if(!dc_valid(dc_hcache,dc_hbasis,DC_HARNESS_FILES,DC_NO_EXECS))dc_need("harness absent/stale/corrupt; run explicit harness prepare");
    ho=dc_outputs(dc_hcache);temp=sp_pjoin(dc_flight,"consume");if(mkdir(temp,0700))dc_need("cannot create private consume directory");
    hjson=sp_pjoin(temp,"h.json");table=sp_pjoin(temp,"h.tbl");net=sp_pjoin(temp,"h.net");runtime=sp_pjoin(temp,"decimal-run");
    dc_cached_copy(dc_hcache,"h.json",hjson,sp_getitem(ho,"h.json"),0);dc_cached_copy(dc_hcache,"h.tbl",table,sp_getitem(ho,"h.tbl"),0);dc_cached_copy(dc_hcache,"h.net",net,sp_getitem(ho,"h.net"),0);
    dc_cached_copy(dc_tcache,"decimal-run",runtime,sp_getitem(to,"decimal-run"),1);
    if(!dc_valid(dc_tcache,dc_tbasis,DC_TOOL_FILES,DC_TOOL_FILES)||!dc_valid(dc_hcache,dc_hbasis,DC_HARNESS_FILES,DC_NO_EXECS))dc_need("cache changed during consumer materialization");
    sp_set_raise_hook(0);oraclec=sp_pjoin(temp,"oracle.c");oracle=sp_pjoin(temp,"oracle");input=sp_pjoin(temp,"input");
    dc_copy(dc_e3,"e3.json");dc_copy(hjson,"h.json");dc_copy(table,"h.tbl");dc_copy(net,"h.net");
    sp_bstr(&csrc,"#include <stdio.h>\nint main(void){\n");
    for(a=0;a<nvalues;a++){const char *v=dc_values[a];int f=v[strlen(v)-1]=='f';
        sp_bstr(&csrc,"{ union { ");sp_bstr(&csrc,f?"float":"double");sp_bstr(&csrc," f; ");
        sp_bstr(&csrc,f?"unsigned int":"unsigned long long");sp_bstr(&csrc," u; } x; x.f=");sp_bstr(&csrc,v);
        sp_bstr(&csrc,"; printf(\"");sp_bstr(&csrc,f?"%08x":"%016llx");sp_bstr(&csrc,"\\n\",x.u); }\n");}
    sp_bstr(&csrc,"return 0;}\n");dc_write(oraclec,csrc.s,csrc.n,0);free(csrc.s);dc_copy(oraclec,"oracle.c");
    args[0]="cc";args[1]="-w";args[2]=oraclec;args[3]="-o";args[4]=oracle;args[5]=0;free(dc_ok("build-oracle",args,55,0));
    args[0]=oracle;args[1]=0;out=dc_ok("oracle",args,10,&on);
    if(dc_ev)dc_write(sp_pjoin(dc_ev,"expected.txt"),out,on,1);
    a=0;at=0;while(at<on){while(at<on&&dc_ws((unsigned char)out[at]))at++;if(at==on)break;begin=at;
        while(at<on&&!dc_ws((unsigned char)out[at]))at++;
        if(a>=nvalues)dc_fail("too many host oracle values");expected[a++]=dc_number(out+begin,at-begin,16);}
    free(out);if(a!=nvalues)dc_fail("host oracle count differs from case count");
    args[0]=runtime;args[1]="--check-net";args[2]=table;args[3]=net;args[4]=0;free(dc_ok("check-network",args,55,0));
    for(a=0;a<nvalues;a++){dc_input(input,dc_values[a]);
        for(j=0;j<2;j++){args[0]=runtime;args[1]=j?net:table;args[2]=input;args[3]=0;
            rc=dc_run("floating",args,10,&out,&on,&err,&en);dc_row("floating",a,models[j],rc,out,on,err,en);checks++;
            if(rc||on!=9||(unsigned char)out[0]!=105||dc_le64(out+1)!=expected[a]){
                fprintf(stderr,"BAD floating index=%d model=%s rc=%d bytes=%zu\n",a,models[j],rc,on);free(out);free(err);dc_fail("floating bits differ from host cc");}free(out);free(err);}}
    for(a=0;a<nbad;a++){dc_input(input,dc_badvalues[a]);
        for(j=0;j<2;j++){args[0]=runtime;args[1]=j?net:table;args[2]=input;args[3]=0;
            rc=dc_run("reject",args,10,&out,&on,&err,&en);dc_row("reject",a,models[j],rc,out,on,err,en);checks++;
            if(rc!=1||on||!strstr(err,"decimal floating")){free(out);free(err);dc_fail("bad floating value not refused by the converter");}free(out);free(err);}}
    printf("floating bits: %d host-cc expectations, table/network agree; %d rejects each\n",nvalues,nbad);
    for(a=0;a<nintegers+noverflow;a++){const char *v=a<nintegers?dc_integers[a]:dc_overflow[a-nintegers];dc_input(input,v);
        for(j=0;j<2;j++){args[0]=runtime;args[1]=j?net:table;args[2]=input;args[3]=0;
            rc=dc_run("integer",args,10,&out,&on,&err,&en);dc_row(a<nintegers?"integer":"overflow",a<nintegers?a:a-nintegers,models[j],rc,out,on,err,en);checks++;
            if(rc||on!=9){free(out);free(err);dc_fail("integer converter failed or returned wrong length");}
            if(a>=nintegers){if((unsigned char)out[0]!=102){free(out);free(err);dc_fail("overflow integer accepted");}}
            else if((unsigned char)out[0]!=101||dc_le64(out+1)!=dc_integer(v)){free(out);free(err);dc_fail("integer value/kind differs");}
            free(out);free(err);}}
    if(checks!=166)dc_fail("case/model coverage incomplete");dc_originals();
    sp_set_raise_hook(dc_hook);
    if(!sp_jeq(dc_common_saved,dc_basis())||!dc_valid(dc_tcache,dc_tbasis,DC_TOOL_FILES,DC_TOOL_FILES)||!dc_valid(dc_hcache,dc_hbasis,DC_HARNESS_FILES,DC_NO_EXECS))dc_need("identity/artifacts changed during consumer assertions");
    sp_set_raise_hook(0);
    printf("integer constants: %d exact values; %d overflow tokens rejected; table/network agree\n",nintegers,noverflow);
    dc_flush();sp_scratch_remove();return 0;
}
