/* Product contract: complete sizeof postfix operands, including argument,
 * relational and arithmetic contexts. Scope: Linux/x86_64 LP64 (fixed C ABI
 * widths are independent oracles). Default-run must return 0 and print
 * SIZEOF_INDEXED_POSTFIX; this is pending until measured against a candidate. */
typedef struct {char word[5];} InnerName;
typedef struct {char name[32];char grid[2][3];InnerName inner;long *pointer;} NameRow;
static NameRow names[2];
static NameRow *pointers[2];
static int effects;
static int next_index(void){effects++;return 0;}
static NameRow *next_rows(void){effects++;return names;}
static int width32(unsigned long n){return n==32?7:1;}
static int scalar(void){effects++;return 19;}
static int (*callbacks[2])(void);
int main(void){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("SIZEOF_INDEXED_POSTFIX NOT_RUN requires Linux/x86_64 LP64\n",stderr);return 3;
#endif
 if(sizeof(long)!=8||sizeof(void *)!=8)return 3;
 int index=0;NameRow local[2];NameRow *p=names;char (*row)[3]=names[0].grid;
 pointers[0]=names;callbacks[0]=scalar;
 unsigned long actual[18];unsigned long expected[18]={32,32,32,32,32,6,3,1,5,8,8,3,32,32,4,4,8,8};
 actual[0]=sizeof names[index].name;
 actual[1]=sizeof(names[index].name);
 actual[2]=sizeof local[index].name;
 actual[3]=sizeof pointers[index]->name;
 actual[4]=sizeof(p[index].name);
 actual[5]=sizeof names[index].grid;
 actual[6]=sizeof names[index].grid[1];
 actual[7]=sizeof names[index].grid[1][2];
 actual[8]=sizeof names[index].inner.word;
 actual[9]=sizeof names[index].pointer;
 actual[10]=sizeof(names[index].name+0);
 actual[11]=sizeof row[index];
 actual[12]=sizeof names[index++].name;
 actual[13]=sizeof pointers[index++]->name;
 actual[14]=sizeof callbacks[index++]();
 actual[15]=sizeof index++;
 actual[16]=sizeof p++;
 actual[17]=sizeof row++;
 for(int i=0;i<18;i++)if(actual[i]!=expected[i]){printf("SIZEOF_INDEXED_POSTFIX_FAIL index=%d got=%lu expected=%lu\n",i,actual[i],expected[i]);return 1;}
 if(sizeof index--!=4||sizeof p--!=8||sizeof row--!=8)return 7;
 if(sizeof callbacks[index--]() !=4||sizeof pointers[index--]->name!=32)return 8;
 if(index||p!=names||row!=names[0].grid||effects)return 2;
 if(width32(sizeof names[next_index()].name)!=7)return 3;
 if(width32(sizeof next_rows()[next_index()].name)!=7)return 4;
 if(!(sizeof names[index].name==32&&sizeof names[index].grid[0]==3))return 5;
 if(sizeof names[index].name+1!=33||effects)return 6;
 puts("SIZEOF_INDEXED_POSTFIX");return 0;
}
