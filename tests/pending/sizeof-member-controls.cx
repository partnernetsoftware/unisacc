/* Pending product regression: C99 sizeof must keep terminal array members,
   while pointer-to-array objects and array arithmetic remain pointer-sized. */
int printf(const char *, ...);
typedef struct Row { char op[24]; char fields[13][24]; } Row;
static Row global_rows[2];
static Row global_one;
static char (*global_pointer)[24];

int main(void) {
    Row local_rows[2];
    Row local_one;
    Row *p = &global_one;
    char (*pointer)[24] = &global_one.op;
    unsigned long v[12];
    unsigned long want[12] = {24,24,24,24,24,24,24,8,8,24,1,8};
    v[0] = sizeof(global_rows[0].op);
    v[1] = sizeof(global_one.op);
    v[2] = sizeof(local_rows[0].op);
    v[3] = sizeof(local_one.op);
    v[4] = sizeof(p->op);
    v[5] = sizeof ((Row *)0)->op;
    v[6] = sizeof(global_rows[0].fields[0]);
    v[7] = sizeof(global_pointer);
    v[8] = sizeof(pointer);
    v[9] = sizeof(*pointer);
    v[10] = sizeof(global_rows[0].op[0]);
    v[11] = sizeof(global_rows[0].op + 0);
    for (int i = 0; i < 12; i++) if (v[i] != want[i]) {
        printf("SIZEOF_MEMBER_CONTROL_FAIL index=%d actual=%lu expected=%lu\n", i, v[i], want[i]);
        return 1;
    }
    puts("SIZEOF_MEMBER_CONTROL_PASS");
    return 0;
}
