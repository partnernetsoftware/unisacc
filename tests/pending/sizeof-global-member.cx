/* C99 sizeof on an array member of a static array of structs must retain
 * the array type.  The installed 0.0.43 development Root7a reports 8 for
 * sizeof rows[0].op although op is char[24].  Keep this red until a rebuilt
 * candidate returns all four expected extents. */
int printf(const char *, ...);
typedef struct { char op[24]; char fields[13][24]; } Row;
static Row rows[87];

int main(void) {
    unsigned long direct = (unsigned long)sizeof(rows[0].op);
    unsigned long nested = (unsigned long)sizeof(rows[0].fields[0]);
    unsigned long whole = (unsigned long)sizeof(rows[0]);
    unsigned long array = (unsigned long)sizeof(rows);
    int ok = direct == 24 && nested == 24 && whole == 336 && array == 87 * 336;
    printf("SIZEOF_GLOBAL_MEMBER direct=%lu nested=%lu row=%lu array=%lu status=%s\n",
           direct, nested, whole, array, ok ? "PASS" : "FAIL");
    return ok ? 0 : 1;
}
