/* ROOT PRODUCT [PACKAGE]: actual default-run compilations and pp-only bounds;
 * no cached verdict. All11 cases retain child bound5/transport6 and outer55;
 * summed child ceilings do not promise worst-case completion inside55.
 * Generated C/header fixtures exercise physical source coordinates across
 * forced and nested includes. This runner itself has no handwritten include. */
#pragma unisa use cxlib.netpack
static void die(const char *s){fprintf(stderr,"pp-header-locations: %s errno=%d\n",s,errno);exit(2);}
static void save(const char *p,const char *s){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW,0600);if(fd<0)die("exclusive fixture");size_t n=strlen(s),at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("fixture write");at+=(size_t)z;}if(close(fd))die("fixture close");}
int main(int argc,char **argv){if(argc!=3&&argc!=4)return 2;char root[4096],product[4096];if(!realpath(argv[1],root)||!realpath(argv[2],product))die("root/product");char dir[4400],bound[4400];snprintf(dir,sizeof dir,"%s/out/hl-XXXXXX",root);if(!mkdtemp(dir))die("temporary directory");snprintf(bound,sizeof bound,"%s/tools/bound",root);
const char *names[]={"plain","LF","CRLF","two-LF","two-CRLF","macro-line","nested-LF","nested-CRLF","immutable-baseline"};
const char *heads[]={"#define V 3\n", "#define V 1 \\\n +2\n", "#define V 1 \\\r\n +2\r\n", "#define V 1 \\\n +1 \\\n +1\n", "#define V 1 \\\r\n +1 \\\r\n +1\r\n", "#define V 1 \\\n +2\n#define HLINE __LINE__\n", "#define V 1 \\\n +2\n", "#define V 1 \\\r\n +2\r\n", "#define V 1 \\\n +1 \\\n +1\nint hline = __LINE__; const char *hfile = __FILE__;\n#define LATE 7 \\\n +8\n"};
int lines[]={2,3,3,4,4,4,3,3,4};int failed=0;
for(int c=0;c<9;c++){char header[4600],inner[4600],source[4600],text[16000];snprintf(header,sizeof header,"%s/%s.h",dir,names[c]);snprintf(inner,sizeof inner,"%s/%s-inner.h",dir,names[c]);snprintf(source,sizeof source,"%s/%s.c",dir,names[c]);
if(c==8)snprintf(text,sizeof text,"%s",heads[c]);else snprintf(text,sizeof text,"%sint hline = %s; const char *hfile = __FILE__;\n",heads[c],c==5?"HLINE":"__LINE__");if(c==6||c==7){save(inner,text);snprintf(text,sizeof text,"#include \"%s\"\nint outer_line = __LINE__; const char *outer_file = __FILE__;\n",inner);}save(header,text);
snprintf(text,sizeof text,"int main(void) { const char *s=__FILE__,*want=\"%s\",*hwant=\"%s\"; int i=0; while(s[i]&&want[i]&&s[i]==want[i])i++; if(s[i]!=want[i]||__LINE__!=1||hline!=%d||V!=3)return 1; i=0; while(hfile[i]&&hwant[i]&&hfile[i]==hwant[i])i++; if(hfile[i]!=hwant[i])return 2; %s return 0; }\n",source,(c==6||c==7)?inner:header,lines[c],(c==6||c==7)?"if(outer_line!=2)return 3;":"");save(source,text);
char *v[14];int n=0;v[n++]=bound;v[n++]="5";v[n++]="sh";v[n++]=product;if(argc==4){v[n++]="--models";v[n++]=argv[3];}v[n++]="-include";v[n++]=header;v[n++]=source;v[n]=0;np_result r={0};char why[1024];if(np_run(v,root,0,6,&r,why,sizeof why))die(why);int ok=r.rc==0&&!r.outn&&!r.errn;if(!ok&&r.errn)fwrite(r.err,1,r.errn,stderr);printf("%s\t%s\trc=%d\n",ok?"PASS":"FAIL",names[c],r.rc);failed+=!ok;np_free(&r);}

/* Capacity is a pp-only check: no .cx prelude, no E3 expression growth. */
for(int capcase=0;capcase<2;capcase++){int joins=4096+capcase;char header[4600],source[4600];snprintf(header,sizeof header,"%s/capacity%d.h",dir,joins);snprintf(source,sizeof source,"%s/capacity%d.c",dir,joins);const char *one="/* x\\\n y */\n";size_t unit=strlen(one),size=(size_t)joins*unit;char *body=malloc(size+1);if(!body)die("capacity fixture allocation");for(int j=0;j<joins;j++)memcpy(body+(size_t)j*unit,one,unit);body[size]=0;save(header,body);free(body);save(source,"int capacity_line = __LINE__;\n");
char *v[14];int n=0;v[n++]=bound;v[n++]="5";v[n++]="sh";v[n++]=product;if(argc==4){v[n++]="--models";v[n++]=argv[3];}v[n++]="-E";v[n++]="-include";v[n++]=header;v[n++]=source;v[n]=0;np_result r={0};char why[1024];if(np_run(v,root,0,6,&r,why,sizeof why))die(why);int ok=0;if(!capcase){const char *gold="intcapacity_line=1;";size_t at=0;ok=r.rc==0&&!r.errn;for(size_t j=0;j<r.outn;j++){unsigned char c=(unsigned char)r.out[j];if(c==' '||c=='\t'||c=='\n'||c=='\r'||c=='\v'||c=='\f')continue;if(!gold[at]||c!=(unsigned char)gold[at]){ok=0;break;}at++;}if(gold[at])ok=0;}else{const char *reason="unisacc: model driver: not covered: more than 4096 continuation lines in headers\n";ok=r.rc==2&&!r.outn&&r.errn==strlen(reason)&&!memcmp(r.err,reason,r.errn);}if(!ok&&r.errn)fwrite(r.err,1,r.errn,stderr);printf("%s\tcapacity%d\trc=%d\n",ok?"PASS":"FAIL",joins,r.rc);failed+=!ok;np_free(&r);}

printf("PP_HEADER_LOCATIONS\tcases=11\tfailed=%d\tfixtures=%s\n",failed,dir);return failed?1:0;}
