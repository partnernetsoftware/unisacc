/* A standalone native image and default-run share exactly this module input. */
#pragma unisa use cases.optimization
#pragma unisa use text.text
int main(int argc,char **argv){
 long values[14];int input,i;
 if(argc!=2)return 2;
 if(tx_eqz(argv[1], "7"))input=7;else if(tx_eqz(argv[1], "11"))input=11;else return 2;
 if(optimization_count()!=14)return 3;
 optimization_values(input,values);
 for(i=0;i<14;i++)printf("%d\t%ld\n",i,values[i]);
 return 0;
}
