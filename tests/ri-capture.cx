/* Linux/x86_64 actual C capture substrate; not a CX executor rewrite.
 * ROOT MATERIAL NEW_ABS_OUT. Caller must use tools/bound 55.
 * Native material is prepared separately; no compilation or verdict cache. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
static char root[4096],material[4096],work[4096],bound[4400],product[4400],tool[4400],image[4400];
static int assertions,failures;
static void die(const char *s){fprintf(stderr,"ri-capture: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void join(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path bound");}
static void ck(int ok,const char *s){assertions++;if(!ok)failures++;printf("%s\tri-capture.%s\n",ok?"PASS":"FAIL",s);}
static void digest(char h[65]){struct stat st,after;if(lstat(image,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>16777216)die("native regular image");int fd=open(image,O_RDONLY|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK);if(fd<0||fstat(fd,&after)||st.st_dev!=after.st_dev||st.st_ino!=after.st_ino||st.st_size!=after.st_size)die("native descriptor identity");size_t n=(size_t)st.st_size,at=0;char *s=malloc(n+1);if(!s)die("native allocation");while(at<n){ssize_t z=read(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("native extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&after)||st.st_dev!=after.st_dev||st.st_ino!=after.st_ino||st.st_size!=after.st_size;int closed=close(fd);if(z||bad||closed)die("native changed while reading");cx_sha256_hex(s,n,h);free(s);}
static void save(const char *name,const char *bytes,size_t n){char p[4400];join(p,work,name);int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive evidence");size_t at=0;while(at<n){ssize_t z=write(fd,bytes+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("evidence write");at+=(size_t)z;}if(close(fd))die("evidence close");}
static np_result call(char **v,int seconds,const char *label){char why[1024],name[160],rc[40];if(unsetenv("UNISACC_RF_CAPTURE"))die("clear ambient capture");np_result r;if(np_run(v,root,0,seconds,&r,why,sizeof why))die(why);snprintf(name,sizeof name,"%s.stdout",label);save(name,r.out,r.outn);snprintf(name,sizeof name,"%s.stderr",label);save(name,r.err,r.errn);int n=snprintf(rc,sizeof rc,"rc\t%d\n",r.rc);snprintf(name,sizeof name,"%s.status",label);save(name,rc,(size_t)n);return r;}
static void verify(const char *label){char *v[]={bound,"18","sh",product,tool,"--","--verify-native",root,material,"tests/cases/ri-fetch.cx",0};np_result r=call(v,18,label);const char *tail="VERIFIED\tri-material\tno-test-result\n";size_t n=strlen(tail);int ok=!r.rc&&!r.errn&&r.outn>=n&&!memcmp(r.out+r.outn-n,tail,n);ck(ok,label);if(!ok){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("native material verification failed");}np_free(&r);}
static np_result run(const char *mode,int seconds){char dir[4400],limit[16];join(dir,work,mode);snprintf(limit,sizeof limit,"%d",seconds);char *v[]={bound,limit,image,(char *)mode,dir,0};return call(v,seconds+2,mode);}
static void positive(const char *mode,int count,const char *rows){np_buf b={0};np_puts(&b,rows);char summary[100];snprintf(summary,sizeof summary,"RI_FETCH\tassertions=%d\tfailed=0\n",count);np_puts(&b,summary);np_result r=run(mode,2);ck(!r.rc&&!r.errn&&r.outn==b.n&&!memcmp(r.out,b.p,b.n),mode);free(b.p);np_free(&r);}
static void negative(const char *mode,int seconds,const char *reason){np_result r=run(mode,seconds);ck(r.rc==2&&!r.outn&&r.errn==strlen(reason)&&!memcmp(r.err,reason,r.errn),mode);np_free(&r);}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN ri-capture requires Linux/x86_64\n",stderr);return 3;
#endif
 if(argc!=4||!realpath(argv[1],root)||!realpath(argv[2],material)||argv[3][0]!='/'||strlen(argv[3])>=sizeof work)die("usage ROOT MATERIAL NEW_ABS_OUT");strcpy(work,argv[3]);if(mkdir(work,0700))die("new private output required");join(bound,root,"tools/bound");join(product,root,"unisacc.com");join(tool,root,"tools/ri-material.cx");join(image,material,"runtime-native");
 verify("material-before");char before[65],after[65];digest(before);printf("NATIVE\tsha256=%s\n",before);
 positive("nonempty",4,"PASS\tri-fetch.capture-rejects-nonempty\nPASS\tri-fetch.sentinel-preserved\nPASS\tri-fetch.nonempty-no-ledger\nPASS\tri-fetch.nonempty-guard-cleaned\n");
 positive("repeat",4,"PASS\tri-fetch.changed-answer-still-returned\nPASS\tri-fetch.SC2-keeps-equal-and-changing-events\nPASS\tri-fetch.SC2-independent-event-byte-gold\nPASS\tri-fetch.SC2-never-first-wins-map\n");
 positive("legacy-empty",2,"PASS\tri-fetch.legacy-empty-supported\nPASS\tri-fetch.legacy-empty-guard-cleaned\n");
 positive("busy",3,"PASS\tri-fetch.busy-initializer-rejected\nPASS\tri-fetch.foreign-guard-preserved\nPASS\tri-fetch.busy-no-ledger\n");
 positive("session-reset",2,"PASS\tri-fetch.new-session-count-reset\nPASS\tri-fetch.new-session-records-own-event\n");
 positive("fifo",3,"PASS\tri-fetch.FIFO-quick-named-refusal\nPASS\tri-fetch.FIFO-not-replaced\nPASS\tri-fetch.FIFO-guard-released\n");
 negative("write-failure",2,"run: INTERFACE_ERROR capture-target-exists resource-000.bytes\n");
 negative("open-failure",2,"run: INTERFACE_ERROR capture-file-write resource-000.bytes\n");
 negative("flush-failure",2,"run: INTERFACE_ERROR capture-file-write resource-000.bytes\n");
 negative("close-failure",2,"run: INTERFACE_ERROR capture-file-write resource-000.bytes\n");
 negative("append-failure",2,"run: INTERFACE_ERROR capture-ledger-write\n");
 negative("no-session",2,"run: INTERFACE_ERROR capture-session-not-initialized\n");
 negative("quota",8,"run: INTERFACE_ERROR capture-capacity-exceeded\n");
 digest(after);ck(tx_eqz(before, after),"native-unchanged");verify("material-after");
 puts("NOT_CLAIMED\tfull-model-route-P3-loading-foreign-hosts-or-general-memory-safety");puts("TIMING\tstartup_construction_loading_inference_output_validation_cold_hot=UNMEASURED");printf("RI_CAPTURE\tassertions=%d\tfailed=%d\tfixture-positive-assertions=18\tfatal-cases=7\n",assertions,failures);return failures?1:0;
}
