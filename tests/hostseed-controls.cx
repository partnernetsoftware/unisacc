/* ROOT CTX MODELS PAYLOAD G1 G2 G3 NEW_ABS_OUT CASE_ID; caller bound55.
 * Exactly one target command (bound20, including default-run compilation).
 * Source identity controls each bound8: explicit child budgets total36s.
 * No compiler/model/host reconstruction. Original materials are read only;
 * writable-step probes target exact private generation copies, not originals.
 * parent-receipt-builder-field copies all 13 G1 leaves, changes only the
 * private wrap receipt's builder hash to 64 zeroes, then requests invalid-probe.
 * Canonical parent admission must reject before creating any new stage. This
 * is a current-tool negative contract, not historical construction evidence.
 * No compiler executes for invalid-probe. Every case is independent.
 */
#pragma unisa use cxlib.netpack
static char root[4096],ctx[4096],models[4096],payload[4096],gen[3][4096],work[4096],bound[4400],product[4400],tool[4400],parent_test[4400],identity[4400],self[4096],ccpath[4096],probe[4400],copydir[4400];
static char raw_source[65];static int assertions,failures;
static const char *files[]={"slice-win-x86_64","slice-lnx-x86_64","slice-lnx-arm64","slice-osx-x86_64","slice-osx-arm64","unisacc-seed.com"};
static const char *steps[]={"slice-win/x86_64","slice-lnx/x86_64","slice-lnx/arm64","slice-osx/x86_64","slice-osx/arm64","wrap"};
static const char *cases[]={"duplicate-generation","swapped-generations","wrong-payload","raw-models","wrong-native-builder","wrong-parent","duplicate-step","parent-receipt-builder-field"};
static const char *reasons[]={"three distinct generations required","receipt-bytes-mismatch","fixed-P3-payload-not-current-declared-input","models-must-be-complete-terminal-P3-product","native-builder-must-be-context-HOST","receipt-bytes-mismatch","exclusive-output-required","receipt-bytes-mismatch"};
static void die(const char *s){fprintf(stderr,"hostseed-controls: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path bound");}
static void ck(int ok,const char *s){assertions++;if(!ok)failures++;printf("%s\thostseed-controls.%s\n",ok?"PASS":"FAIL",s);}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input absent":"input stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>134217728)die("bounded regular input");int fd=open(p,O_RDONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC);if(fd<0||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)die("input descriptor");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("read extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||bad||closed)die("input changed");s[*n]=0;return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void write_new(const char *p,const char *s,size_t n,int mode){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,mode);if(fd<0)die("exclusive private output");struct stat st;if(fstat(fd,&st)||!S_ISREG(st.st_mode)||fchmod(fd,(mode_t)mode))die("private output descriptor");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("private output write");at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("private output close");}
static void save(const char *name,const char *s,size_t n){char p[4400];path(p,work,name);write_new(p,s,n,0600);}
static void row(np_buf *b,const char *k,const char *v){np_puts(b,k);np_puts(b,"\t");np_puts(b,v);np_puts(b,"\n");}
static void equal_record(const char *p,const np_buf *b){size_t n;char *s=load(p,&n);int ok=n==b->n&&!memcmp(s,b->p,n);free(s);if(!ok)die("baseline exact receipt mismatch; target not run");}
/* One bounded extraction only, for the already hashed external CC path.
 * All original receipt bytes are subsequently checked canonically below. */
static void context_cc(void){char p[4400];path(p,ctx,"context.tsv");size_t n;char *s=load(p,&n);if(memchr(s,0,n))die("baseline context wire");char *at=strstr(s,"\ncc\t");if(!at||strstr(at+1,"\ncc\t"))die("baseline unique CC path");at+=4;char *end=strchr(at,'\n');if(!end||end==at||(size_t)(end-at)>=sizeof ccpath)die("baseline CC extent");memcpy(ccpath,at,(size_t)(end-at));ccpath[end-at]=0;if(ccpath[0]!='/'||strpbrk(ccpath,"\r\t"))die("baseline CC absolute path");free(s);}
/* Validate positive source/material consistency in memory first. Otherwise an
 * unrelated pre-existing receipt error could fake a generic mismatch control.
 * This checks bytes and parent bindings, not historical process execution. */
static void baseline(void){char p[4400],h[65],cs[65],vs[65],hs[65],is[65],ih[65],ts[65],ps[65],ms[65],chs[65],hostr[65],hostpath[4400];context_cc();digest(product,ps);digest(models,ms);if(strcmp(ps,ms))die("baseline MODELS is not current full product");digest(ccpath,cs);path(p,ctx,"cc.version");digest(p,vs);path(p,ctx,"identity-helper");digest(p,ih);digest(identity,is);digest(tool,ts);np_buf b={0};np_puts(&b,"hostseed-ident-v1\n");row(&b,"source",raw_source);row(&b,"cc",ccpath);row(&b,"cc-sha",cs);row(&b,"cc-version-sha",vs);row(&b,"helper",ih);row(&b,"helper-source",is);row(&b,"flags","-std=c99 -D_POSIX_C_SOURCE=200809L -O2 -w");row(&b,"measurement-bootstrap",ps);row(&b,"measurement-bootstrap-kind","installed-APE-source-measurement-only");row(&b,"tool",ts);row(&b,"CC-subtools-and-system-libraries","DECLARED-HOST-DEPENDENCIES-NOT-INDEPENDENTLY-HASHED");path(p,ctx,"context.tsv");equal_record(p,&b);cx_sha256_hex(b.p,b.n,chs);free(b.p);b=(np_buf){0};path(hostpath,ctx,"HOST");digest(hostpath,hs);np_puts(&b,"hostseed-host-v1\n");row(&b,"source",raw_source);row(&b,"context",chs);row(&b,"cc",cs);row(&b,"cc-version",vs);row(&b,"flags","-O2 -Wall -Wextra");row(&b,"artifact",hs);row(&b,"core","C-core-no-UNISA_CORE_BLOB-no-ASM-defines");path(p,ctx,"host.tsv");equal_record(p,&b);cx_sha256_hex(b.p,b.n,hostr);free(b.p);
 size_t mn,pn;char *mb=load(models,&mn),*pb=load(payload,&pn);unsigned long long extent=0;if(mn<16||memcmp(mb+mn-16,"UNIPKG1\n",8))die("baseline terminal product required");for(int i=7;i>=0;i--)extent=(extent<<8)|(unsigned char)mb[mn-8+i];if(extent!=pn||extent>mn-16||pn<4||memcmp(pb,"P 3 ",4)||memcmp(mb+mn-16-pn,pb,pn))die("baseline payload differs from actual product");free(mb);free(pb);char ph[65];digest(payload,ph);
 for(int g=0;g<3;g++){char builder[4400],parent[4400],bh[65],parh[65],stsha[65];if(!g){strcpy(builder,hostpath);path(parent,ctx,"host.tsv");}else{path(builder,gen[g-1],"unisacc-seed.com");path(parent,gen[g-1],"unisacc-seed.com.hostseed.tsv");}digest(builder,bh);digest(parent,parh);b=(np_buf){0};np_puts(&b,"hostseed-stage-v1\n");row(&b,"source",raw_source);row(&b,"context",chs);row(&b,"host-receipt",hostr);row(&b,"builder-kind",g?"ape":"native");row(&b,"builder",builder);row(&b,"builder-sha",bh);row(&b,"parent-receipt",parent);row(&b,"parent-receipt-sha",parh);row(&b,"models",models);row(&b,"models-sha",ms);row(&b,"payload",payload);row(&b,"payload-sha",ph);row(&b,"payload-trust","NN-and-ASM-kernel-binary-inputs-NOT-source-rebuilt");row(&b,"slice-flags","-O2");row(&b,"wrap-flags","default-run-seed/ape.c-no-APE_ZLIB");path(p,gen[g],"stage.tsv");equal_record(p,&b);cx_sha256_hex(b.p,b.n,stsha);free(b.p);for(int i=0;i<6;i++){path(p,gen[g],files[i]);size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);char num[40];snprintf(num,sizeof num,"%lu",(unsigned long)n);b=(np_buf){0};np_puts(&b,"hostseed-artifact-v1\n");row(&b,"stage-context",stsha);row(&b,"step",steps[i]);row(&b,"artifact",h);row(&b,"bytes",num);row(&b,"builder",bh);row(&b,"parent-receipt",parh);row(&b,"source",raw_source);char receipt[160];snprintf(receipt,sizeof receipt,"%s.hostseed.tsv",files[i]);path(p,gen[g],receipt);equal_record(p,&b);free(b.p);}}
}
typedef struct {char *line;} Entry;static Entry entries[2048];static int nentries;
static void entry(const char *p,const char *label){if(nentries==2048)die("manifest capacity");struct stat st;if(lstat(p,&st))die("manifest stat");char h[65],text[5000];if(S_ISDIR(st.st_mode))strcpy(h,"-");else{if(!S_ISREG(st.st_mode))die("manifest special input");digest(p,h);}int n=snprintf(text,sizeof text,"%s\t%s\t%o\t%s\n",S_ISDIR(st.st_mode)?"DIR":"FILE",label,(unsigned)(st.st_mode&07777),h);if(n<0||(size_t)n>=sizeof text)die("manifest row");entries[nentries++].line=strdup(text);if(!entries[nentries-1].line)die("manifest allocation");}
static void walk(const char *base,const char *relative,const char *label){char p[4400],id[4400];if(*relative){path(p,base,relative);path(id,label,relative);}else{strcpy(p,base);strcpy(id,label);}entry(p,id);struct stat st;if(lstat(p,&st))die("manifest stat");if(!S_ISDIR(st.st_mode))return;DIR *d=opendir(p);if(!d)die("manifest directory");for(;;){errno=0;struct dirent *e=readdir(d);if(!e){int saved=errno,closed=closedir(d);if(saved||closed)die("manifest directory close");break;}if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;if(strpbrk(e->d_name,"\t\r\n"))die("manifest unclean name");char next[4400];if(*relative)path(next,relative,e->d_name);else{if(strlen(e->d_name)>=sizeof next)die("manifest name");strcpy(next,e->d_name);}walk(base,next,label);}}
static int compare_entry(const void *a,const void *b){return strcmp(((const Entry *)a)->line,((const Entry *)b)->line);}
static np_buf manifest(void){nentries=0;walk(ctx,"","CTX");for(int i=0;i<3;i++){char label[8];snprintf(label,sizeof label,"G%d",i+1);walk(gen[i],"",label);}const char *paths[]={models,payload,product,tool,parent_test,identity,self,ccpath,bound};const char *names[]={"MODELS","PAYLOAD","ROOT_PRODUCT","TOOL","PARENT_TEST","IDENTITY_SOURCE","CONTROL_SOURCE","CC_BINARY","WATCHDOG"};for(int i=0;i<9;i++)entry(paths[i],names[i]);qsort(entries,(size_t)nentries,sizeof *entries,compare_entry);np_buf b={0};np_puts(&b,"hostseed-controls-original-inventory-v1\n");for(int i=0;i<nentries;i++){np_puts(&b,entries[i].line);free(entries[i].line);entries[i].line=0;}return b;}
static void source_identity(char h[65],const char *label){if(unsetenv("UNISACC_RF_CAPTURE")||unsetenv("UNISA_ATTRIBUTES"))die("clear ambient state");char *v[]={bound,"8","sh",product,identity,"--",root,0};char why[1024],name[100];np_result r;if(np_run(v,root,0,10,&r,why,sizeof why))die(why);snprintf(name,sizeof name,"%s.stdout",label);save(name,r.out,r.outn);snprintf(name,sizeof name,"%s.stderr",label);save(name,r.err,r.errn);char status[40];int status_n=snprintf(status,sizeof status,"rc\t%d\n",r.rc);snprintf(name,sizeof name,"%s.status",label);save(name,status,(size_t)status_n);int ok=!r.rc&&!r.errn&&r.outn==65&&r.out[64]=='\n';if(ok){memcpy(h,r.out,64);h[64]=0;for(int i=0;i<64;i++)if(!((h[i]>='0'&&h[i]<='9')||(h[i]>='a'&&h[i]<='f')))ok=0;}np_free(&r);if(!ok)die("source identity prerequisite");}
static void clone_generation(int which){path(copydir,work,"generation-copy");if(mkdir(copydir,0700))die("new private generation copy");char p[4400],q[4400],name[160];int copied=0;for(int i=-1;i<12;i++){int mode=0600;if(i<0)strcpy(name,"stage.tsv");else{int f=i/2;if(i&1)snprintf(name,sizeof name,"%s.hostseed.tsv",files[f]);else{strcpy(name,files[f]);mode=0700;}}path(p,gen[which],name);size_t n;char *s=load(p,&n);path(q,copydir,name);write_new(q,s,n,mode);size_t z;char *b=load(q,&z);if(z!=n||memcmp(b,s,n))die("private generation copy bytes");free(b);free(s);copied++;}ck(copied==13,"private-generation-exact-13-leaf-copy");}
static void mutate_private_builder(void){
 char p[4400];path(p,copydir,"unisacc-seed.com.hostseed.tsv");size_t n;char *s=load(p,&n);if(memchr(s,0,n))die("private receipt wire");const char *needle="\nbuilder\t";char *at=strstr(s,needle);if(!at||strstr(at+1,needle))die("private unique builder field");at+=strlen(needle);if((size_t)(at-s)+65>n||at[64]!='\n')die("private builder extent");for(int i=0;i<64;i++)if(!((at[i]>='0'&&at[i]<='9')||(at[i]>='a'&&at[i]<='f')))die("private builder hash");char original[64];memcpy(original,at,64);memset(at,'0',64);if(!memcmp(original,at,64))die("private mutation must change builder");
 /* Only overwrite this process's exact private copy, without following links,
  * changing its extent, or touching any original generation/receipt. */
 struct stat a,b;if(lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<0||(size_t)a.st_size!=n)die("private mutation stat");int fd=open(p,O_WRONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC);if(fd<0||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)die("private mutation descriptor");size_t offset=(size_t)(at-s);if(lseek(fd,(off_t)offset,SEEK_SET)!=(off_t)offset)die("private mutation seek");size_t done=0;while(done<64){ssize_t z=write(fd,at+done,64-done);if(z<0&&errno==EINTR)continue;if(z<=0)die("private mutation write");done+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("private mutation close");size_t after_n;char *after=load(p,&after_n);ck(after_n==n&&!memcmp(s,after,n),"private-wrap-only-builder-field-changed-to-64-zeroes");free(after);free(s);
}
static np_buf private_manifest(void){nentries=0;walk(copydir,"","PRIVATE");qsort(entries,(size_t)nentries,sizeof *entries,compare_entry);np_buf b={0};np_puts(&b,"hostseed-controls-private-generation-v1\n");for(int i=0;i<nentries;i++){np_puts(&b,entries[i].line);free(entries[i].line);entries[i].line=0;}return b;}
static int missing(const char *p){struct stat st;errno=0;if(!lstat(p,&st))return 0;if(errno!=ENOENT)die("probe existence IO");return 1;}
static int named_reason(const np_result *r,int which){char prefix[350];int n=snprintf(prefix,sizeof prefix,"%s: REFUSE %s errno=",which?"hostseed-step":"hostseed-chain",reasons[which]);if(n<0||(size_t)n>=sizeof prefix||r->errn<(size_t)n+2||memcmp(r->err,prefix,(size_t)n))return 0;size_t at=(size_t)n;if(r->err[at]=='-')at++;size_t start=at;while(at<r->errn&&r->err[at]>='0'&&r->err[at]<='9')at++;return at>start&&at+1==r->errn&&r->err[at]=='\n';}
static int within(const char *p,const char *base){size_t n=strlen(base);return !strncmp(p,base,n)&&(!p[n]||p[n]=='/');}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN hostseed-controls requires Linux/x86_64\n",stderr);return 3;
#endif
 if(argc!=10||!realpath(argv[1],root)||!realpath(argv[2],ctx)||!realpath(argv[3],models)||!realpath(argv[4],payload)||argv[8][0]!='/'||strlen(argv[8])>=sizeof work||!realpath(__FILE__,self))die("usage ROOT CTX MODELS PAYLOAD G1 G2 G3 NEW_ABS_OUT CASE_ID");for(int i=0;i<3;i++)if(!realpath(argv[5+i],gen[i]))die("generation realpath");if(!strcmp(gen[0],gen[1])||!strcmp(gen[0],gen[2])||!strcmp(gen[1],gen[2]))die("three distinct original generations required");int which=-1;for(int i=0;i<(int)(sizeof cases/sizeof *cases);i++)if(!strcmp(argv[9],cases[i]))which=i;if(which<0)die("unknown CASE_ID");char parent[4096],base[4096],leaf[4096];strcpy(parent,argv[8]);char *slash=strrchr(parent,'/');if(!slash||!slash[1]||!strcmp(slash+1,".")||!strcmp(slash+1,".."))die("output leaf");strcpy(leaf,slash+1);if(slash==parent)slash[1]=0;else *slash=0;if(!realpath(parent,base))die("output parent");int z=snprintf(work,sizeof work,"%s%s%s",base,!strcmp(base,"/")?"":"/",leaf);if(z<0||(size_t)z>=sizeof work||within(work,ctx)||within(work,gen[0])||within(work,gen[1])||within(work,gen[2])||strpbrk(work,"\t\r\n"))die("output aliases original input");if(mkdir(work,0700))die("new output required");path(bound,root,"tools/bound");path(product,root,"unisacc.com");path(tool,root,"tools/hostseed-step.cx");path(parent_test,root,"tests/hostseed-chain.cx");path(identity,root,"seed/ident.c");path(probe,work,"must-stay-absent");source_identity(raw_source,"source-before");baseline();ck(1,"baseline-canonical-source-context-and-all-parent-receipts");np_buf before=manifest();save("original-before.tsv",before.p,before.n);np_buf private_before={0};if(which>=5){clone_generation(which==5?1:0);if(which==7)mutate_private_builder();private_before=private_manifest();save("private-before.tsv",private_before.p,private_before.n);}
 char wrong_payload[4400],builder[4400];path(wrong_payload,root,"src/version.h");path(builder,ctx,"HOST");char *v[20];int n=0;v[n++]=bound;v[n++]="20";v[n++]="sh";v[n++]=product;v[n++]=which?tool:parent_test;v[n++]="--";
 if(which==0){v[n++]=root;v[n++]=ctx;v[n++]=models;v[n++]=payload;v[n++]=gen[0];v[n++]=gen[0];v[n++]=gen[2];v[n++]=probe;}
 else if(which<=3){v[n++]="--verify-chain";v[n++]=root;v[n++]=ctx;v[n++]=which==3?payload:models;v[n++]=which==2?wrong_payload:payload;v[n++]=gen[0];v[n++]=which==1?gen[2]:gen[1];v[n++]=which==1?gen[1]:gen[2];}
 else{v[n++]=root;v[n++]=ctx;v[n++]=(which==5||which==7)?"ape":"native";if(which==5)path(builder,gen[1],"unisacc-seed.com");if(which==7)path(builder,copydir,"unisacc-seed.com");v[n++]=which==4?models:builder;v[n++]=models;v[n++]=payload;v[n++]=(which==4||which==7)?probe:copydir;v[n++]=(which==4||which==7)?"invalid-probe":which==5?"wrap":"slice-lnx/x86_64";}v[n]=0;np_buf command={0};for(int i=0;v[i];i++){char name[32];snprintf(name,sizeof name,"arg-%d",i);row(&command,name,v[i]);}save("target.argv.tsv",command.p,command.n);free(command.p);if(unsetenv("UNISACC_RF_CAPTURE")||unsetenv("UNISA_ATTRIBUTES"))die("clear ambient state");char why[1024];np_result result;if(np_run(v,root,0,22,&result,why,sizeof why))die(why);save("target.stdout",result.out,result.outn);save("target.stderr",result.err,result.errn);char status[40];z=snprintf(status,sizeof status,"rc\t%d\n",result.rc);save("target.status",status,(size_t)z);ck(result.rc==2,"target-rc2");ck(!result.outn,"target-empty-stdout");ck(named_reason(&result,which),"target-exact-named-reason");np_free(&result);ck(missing(probe),"rejected-new-stage-or-parent-output-never-created");char after_source[65];source_identity(after_source,"source-after");ck(!strcmp(raw_source,after_source),"full-raw-source-unchanged");np_buf after=manifest();save("original-after.tsv",after.p,after.n);ck(before.n==after.n&&!memcmp(before.p,after.p,before.n),"all-original-context-generations-receipts-artifacts-inputs-tools-unchanged");free(before.p);free(after.p);if(which>=5){np_buf private_after=private_manifest();save("private-after.tsv",private_after.p,private_after.n);ck(private_before.n==private_after.n&&!memcmp(private_before.p,private_after.p,private_before.n),"private-generation-rejected-without-changes");free(private_before.p);free(private_after.p);}baseline();ck(1,"baseline-canonical-after");puts("NOT_CLAIMED\thermetic-host-toolchain-NN-or-ASM-source-reconstruction-historical-execution-proof-or-full-N22");puts("TIMING\tstartup_loading_validation_output_cold_hot=UNMEASURED");printf("HOSTSEED_CONTROLS\tcase=%s\tassertions=%d\tfailed=%d\ttarget-commands=1\n",cases[which],assertions,failures);return failures?1:0;
}
