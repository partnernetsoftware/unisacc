#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
/* run-tmpfile.cx -- the tmpfile -run launch (cx/sys/runlaunch.cx rl_tmpfile_exec) on a slice that
   is not a tmpfile slice (run_launch of exec/facts/pp-targets.tsv is tmpfile for osx/* and win/*).
   There it must not execute anything: its spawn helper is the -ENOSYS branch, so a lnx memfd
   slice carries no process-spawn code and never runs the image.
   A probe staged in OUT (inside ROOT, so cxroot.tsv resolves sys.*) calls it twice:
   1. TMPDIR=OUT/ok writable: status 1, named "cannot execute from TMPDIR ... (errno 38)", OUT/ok empty.
   2. TMPDIR=OUT/ro mode 0500: status 1 with the named "cannot make a directory" error, nothing left.
   The executing path is checked on osx by the candidate-native run cell.
   sh ./unisacc.com tests/run-tmpfile.cx -- ROOT OUT   prints RUN_TMPFILE<TAB>ok=2<TAB>failed=0 */

static const char probe[] =
    "#pragma unisa use sys.io\n#pragma unisa use sys.env\n#pragma unisa use sys.fs\n#pragma unisa use sys.proc\n#pragma unisa use sys.runlaunch\n"
    "static int empty(const char *d) {\n"
    "    char c[512], o[64]; char *av[4]; int cut = 0; int sy_run(char **, char *, int, int *);\n"
    "    cx_fmt(c, sizeof c, \"ls -A %s\", d); av[0] = \"sh\"; av[1] = \"-c\"; av[2] = c; av[3] = 0;\n"
    "    return sy_run(av, o, sizeof o, &cut) == 0 && o[0] == 0;\n}\n"
    "static int one(const char *d, const char *sub, int mode) {\n"
    "    unsigned char img[16] = {0x7f, 'E', 'L', 'F'}; char *av[] = {\"x\", 0}; char t[1024]; int rc, ok;\n"
    "    cx_fmt(t, sizeof t, \"%s/%s\", d, sub); sy_mkdir(t, 0700); sy_chmod(t, mode); sy_setenv(\"TMPDIR\", t, 1);\n"
    "    rc = rl_tmpfile_exec(img, (long)sizeof img, av); sy_printf(\"case\\t%s\\trc=%d\\n\", sub, rc);\n"
    "    ok = rc == 1 && empty(t); sy_chmod(t, 0700); sy_rmdir(t); return ok;\n}\n"
    "int main(int argc, char **argv) {\n"
    "    int ok;\n"
    "    if (argc != 2) return 2;\n"
    "    ok = one(argv[1], \"ok\", 0700) + one(argv[1], \"ro\", 0500);\n"
    "    sy_printf(\"RUN_TMPFILE\\tok=%d\\tfailed=%d\\n\", ok, 2 - ok);\n"
    "    return ok != 2;\n}\n";

int main(int argc, char **argv) {
    char com[1100], p[1100];
    char *av[] = {"/bin/sh", com, p, "--", 0, 0};
    int pid, rc;
    if (argc != 3) { sy_eprintf("usage: run-tmpfile.cx -- ROOT OUT\n"); return 2; }
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", argv[1]) || cx_fmt(p, sizeof p, "%s/probe.cx", argv[2])) return 2;
    sy_mkdir(argv[2], 0700);
    av[4] = argv[2];
    rc = cx_write(p, probe, sizeof probe - 1) ? -EIO : 0;
    pid = rc ? rc : sy_spawn_inherit(av, -1);
    rc = pid < 0 ? pid : sy_wait(pid, 0);
    sy_unlink(p);
    return rc != 0;
}
