/* Finite standalone origin-verifier gate, not current NN construction/PASS.
 * ROOT CAPROOT LOGICAL_PC VERIFIER_ELF VERIFIER_PROFILE NEW_WORK
 * CAPROOT is the captured logical ROOT (capsule/root), not its parent.
 * All private fixtures are EXCL-created and frozen before snapshots start.
 * Caller55: helpers4x4 + positive2x10 + refusal6x2 =48 child seconds.
 * Expiry remains a failure; no retry, reconstruction, result cache or reseal.
 * NOT_COVERED: DAG leaf/status corruption, extra-empty directory, execution
 * bit changes, parent symlink and normal-v1 alias refusal. No broad PASS.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelsha

static char root[4096],caproot[4096],pc[4096],elf[4096],profile[4096],work[4096],bound[4400],helper[4400];
static int assertions,failures,guard_count;
typedef struct {char path[4400],sha[65];size_t bytes;mode_t mode;} Guard;
static Guard guards[40];
static const char *origin_sid="329cdb7077891074f638634dc7abdcd59ee39c368ad6ba1c2fcf867c3c63de2e";
static const char *current_sid="0d59237f3250b59514a55ff529c77b665033e5feb71061f6fcaded0c7ef925c0";
static const char *spec="407f5ef7bd8cf0b65d1086db12b36ab6e19627dc8a0ed5f2e4002df8eae22442";
static void die(const char *s){fprintf(stderr,"origin-package: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void ck(int yes,const char *s){assertions++;if(!yes)failures++;printf("%s\t%s\n",yes?"PASS":"FAIL",s);}
static void path(char *p,size_t n,const char *a,const char *b){int z=snprintf(p,n,"%s/%s",a,b);if(z<0||(size_t)z>=n)die("path-bound");}
static int within(const char *p,const char *base){size_t n=strlen(base);return !strcmp(p,base)||(!strncmp(p,base,n)&&p[n]=='/');}
static void canonical(const char *p){char actual[4400];if(!p||p[0]!='/'||strpbrk(p,"\r\n\t")||strlen(p)>=4096||!realpath(p,actual)||strcmp(actual,p))die("canonical-input-required");}
static void hash(const void *s,size_t n,char out[65]){if(n>=65536){int rc=ks_sha256_hex(s,n,out);if(rc){fprintf(stderr,"kernelsha rc=%d\n",rc);die("kernelsha-failure");}}else cx_sha256_hex(s,n,out);}
static char *load(const char *p,size_t *n,char sha[65]){canonical(p);struct stat a,b;if(lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC);if(fd<0||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_mode!=b.st_mode||a.st_size!=b.st_size)die("input-descriptor");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("input-extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_mode!=b.st_mode||a.st_size!=b.st_size;int cl=close(fd);if(z||bad||cl)die("input-changed-or-close");s[*n]=0;hash(s,*n,sha);return s;}
static void save(const char *name,const void *s,size_t n){char p[4400];path(p,sizeof p,work,name);int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-output");size_t at=0;while(at<n){ssize_t z=write(fd,(const char *)s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("output-write");at+=(size_t)z;}if(close(fd))die("output-close");}
static void evidence(const char *label,const np_result *r){char name[160],status[40];snprintf(name,sizeof name,"%s.stdout",label);save(name,r->out,r->outn);snprintf(name,sizeof name,"%s.stderr",label);save(name,r->err,r->errn);snprintf(name,sizeof name,"%s.status",label);int n=snprintf(status,sizeof status,"rc\t%d\n",r->rc);save(name,status,(size_t)n);}
static void guard(const char *p){if(guard_count==40)die("guard-bound");Guard *g=&guards[guard_count++];if(strlen(p)>=sizeof g->path)die("guard-path");strcpy(g->path,p);char *s=load(p,&g->bytes,g->sha);free(s);struct stat st;if(lstat(p,&st))die("guard-stat");g->mode=st.st_mode;}
static void guard_path(const char *a,const char *b){char p[4400];path(p,sizeof p,a,b);guard(p);}
static void guards_after(void){for(int i=0;i<guard_count;i++){Guard *g=&guards[i];size_t n;char h[65];char *s=load(g->path,&n,h);free(s);struct stat st;if(lstat(g->path,&st))die("guard-after-stat");if(n!=g->bytes||strcmp(h,g->sha)||st.st_mode!=g->mode)die("guard-content-or-mode-changed");}ck(1,"all-declared-original-and-private-input-identities-unchanged");}
static void field(const char *s,size_t n,const char *key,char *out,size_t cap){char needle[100];snprintf(needle,sizeof needle,"\n%s\t",key);if(!n||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))die("record-wire");const char *a=strstr(s,needle);if(!a||strstr(a+1,needle))die("unique-field");a+=strlen(needle);const char *e=strchr(a,'\n');if(!e||e==a||(size_t)(e-a)>=cap||memchr(a,'\t',(size_t)(e-a)))die("field-bound");memcpy(out,a,(size_t)(e-a));out[e-a]=0;}
static void map(const char *logical,char physical[4400]){if(!within(logical,root))die("logical-input-outside-root");int n=snprintf(physical,4400,"%s%s",caproot,logical+strlen(root));if(n<0||n>=4400)die("mapping-bound");canonical(physical);}
static void altered_profile(const char *s,size_t n,const char *key,const char *name){char needle[100];snprintf(needle,sizeof needle,"\n%s\t",key);char *copy=malloc(n+1);if(!copy)die("allocation");memcpy(copy,s,n+1);char *a=strstr(copy,needle);if(!a||strstr(a+1,needle))die("profile-mutation-field");a+=strlen(needle);if(strlen(a)<65||a[64]!='\n')die("profile-mutation-hash-shape");a[0]=a[0]=='0'?'1':'0';save(name,copy,n);free(copy);}
static void identity(const char *input,const char *expected,const char *label){char *v[]={bound,"4",helper,(char *)input,0};np_result r={0};char why[1024];if(np_run(v,root,0,4,&r,why,sizeof why)){fprintf(stderr,"%s\n",why);die("identity-transport");}evidence(label,&r);int ok=!r.rc&&!r.errn&&r.outn==65&&!memcmp(r.out,expected,64)&&r.out[64]=='\n';ck(ok,label);np_free(&r);if(!ok)die("fresh-source-identity-mismatch");}
static np_result snapshot(const char *snapshot_root,const char *logical_pc,const char *sid,const char *profile_path,int seconds,const char *label){char secs[16];snprintf(secs,sizeof secs,"%d",seconds);char *v[]={bound,secs,elf,"--snapshot",root,root,(char *)snapshot_root,(char *)logical_pc,(char *)sid,(char *)profile_path,0};np_result r={0};char why[1024];if(np_run(v,root,0,seconds,&r,why,sizeof why)){fprintf(stderr,"%s\n",why);die("snapshot-transport");}evidence(label,&r);return r;}
static const char *keys[]={"status","logical-root","snapshot-root","logical-package","physical-package","current-verifier-root","execution-profile-path","executing-elf-path","origin-spec","executing-verifier","executing-elf","execution-profile","execution-closure","mapping-witness","execution-reads","origin-source","artifact","manifest","receipt","witness","epoch-artifact","epoch-record","epoch-path","producer","foundation","verifier","digest-module","jobs","models","physical-reads","elapsed-ns","wrapper-physical-reads"};
typedef struct {char value[32][4096];} Report;
static int hex64(const char *s){if(strlen(s)!=64)return 0;for(int i=0;i<64;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;return 1;}
static long long number(const char *s){if(!*s)return -1;long long n=0;for(;*s;s++){if(*s<'0'||*s>'9'||n>(LLONG_MAX-(*s-'0'))/10)return -1;n=n*10+*s-'0';}return n;}
static int parse(const np_result *r,Report *out){const char *schema="source-origin-snapshot-v1\n";size_t sn=strlen(schema);if(r->rc||r->errn||r->outn<sn||r->outn>65536||memcmp(r->out,schema,sn)||memchr(r->out,0,r->outn)||memchr(r->out,'\r',r->outn)||r->out[r->outn-1]!='\n')return 0;const char *p=r->out+sn,*end=r->out+r->outn;for(int i=0;i<32;i++){const char *e=memchr(p,'\n',(size_t)(end-p));size_t k=strlen(keys[i]);if(!e||(size_t)(e-p)<=k+1||memcmp(p,keys[i],k)||p[k]!='\t')return 0;size_t n=(size_t)(e-p-k-1);if(n>=4096||memchr(p+k+1,'\t',n))return 0;memcpy(out->value[i],p+k+1,n);out->value[i][n]=0;p=e+1;}return p==end;}
static void positive(const char *label,Report *out){np_result r=snapshot(caproot,pc,origin_sid,profile,10,label);int ok=parse(&r,out);ck(ok,"positive-exact-ordered-machine-protocol");np_free(&r);if(!ok)die("positive-report");char physical[4400],p[4400],h[65];size_t n;map(pc,physical);ck(!strcmp(out->value[0],"VERIFIED-origin-DAG-not-current-construction-no-test-result")&&!strcmp(out->value[1],root)&&!strcmp(out->value[2],caproot)&&!strcmp(out->value[3],pc)&&!strcmp(out->value[4],physical)&&!strcmp(out->value[5],root)&&!strcmp(out->value[6],profile)&&!strcmp(out->value[7],elf),"positive-explicit-logical-physical-executor-paths");ck(!strcmp(out->value[8],spec)&&!strcmp(out->value[15],origin_sid)&&!strcmp(out->value[9],out->value[25]),"positive-origin-spec-source-distinct-current-verifier");char *s=load(elf,&n,h);free(s);ck(!strcmp(out->value[10],h),"positive-actual-executor-ELF-hash");s=load(profile,&n,h);free(s);ck(!strcmp(out->value[11],h),"positive-actual-profile-hash");path(p,sizeof p,root,"tools/cxlib/sourcepackage.cx");s=load(p,&n,h);free(s);ck(!strcmp(out->value[9],h),"positive-actual-current-SP-module-hash");path(p,sizeof p,physical,"compiler.pkg");s=load(p,&n,h);free(s);ck(!strcmp(out->value[16],h),"positive-actual-captured-package-hash");ck(!strcmp(out->value[17],guards[14].sha)&&!strcmp(out->value[18],guards[15].sha),"positive-full-model-input-and-package-receipt-hashes");ck(!strcmp(out->value[23],"dd6f5e6068289d04346f202035fb1ae3c84a10e254630c7ba5a650c7a06deb46")&&!strcmp(out->value[24],"9c2e71ef2094773bcada4c27a39871f3d0f5947555eb3ebe338aaddf203427ba")&&!strcmp(out->value[26],"8ad60f9004f98b6bd68397668e1c6feabe468bb5be4b5ec9aedc4494aa541e31"),"positive-origin-producer-foundation-and-crypto-specification");map(out->value[22],p);s=load(p,&n,h);free(s);int epoch_ok=!strcmp(out->value[20],h);char epoch_record[4400];int ez=snprintf(epoch_record,sizeof epoch_record,"%s.build.json",p);if(ez<0||(size_t)ez>=sizeof epoch_record)die("epoch-record-path");s=load(epoch_record,&n,h);free(s);ck(epoch_ok&&!strcmp(out->value[21],h),"positive-actual-origin-epoch-raw-and-original-record");int hashes[]={8,9,10,11,12,13,15,16,17,18,19,20,21,23,24,25,26};ok=1;for(int i=0;i<17;i++)if(!hex64(out->value[hashes[i]]))ok=0;ck(ok,"positive-complete-hash-fields");ck(!strcmp(out->value[27],"107")&&!strcmp(out->value[28],"34")&&!strcmp(out->value[29],"1004")&&number(out->value[14])>0&&number(out->value[31])>0&&number(out->value[30])>0&&number(out->value[30])<=10000000000LL,"positive-full-DAG-and-separate-execution-reads-within-bound");}
static int errno_line(const char **p,const char *end){if(*p<end&&**p=='-')(*p)++;const char *start=*p;while(*p<end&&**p>='0'&&**p<='9')(*p)++;if(*p==start||*p>=end||**p!='\n')return 0;(*p)++;return 1;}
static int refused(const np_result *r,const char *reason,int child){if(r->rc!=2||r->outn||!r->errn||memchr(r->err,0,r->errn))return 0;char prefix[500];int n=snprintf(prefix,sizeof prefix,child?"source-origin-verify: REFUSE source-package-snapshot-refused: sourcepackage: REFUSE %s errno=":"source-origin-verify: REFUSE %s errno=",reason);if(n<0||(size_t)n>=sizeof prefix||r->errn<(size_t)n||memcmp(r->err,prefix,(size_t)n))return 0;const char *p=r->err+n,*end=r->err+r->errn;if(!errno_line(&p,end))return 0;if(child){const char *suffix=" errno=";size_t k=strlen(suffix);if((size_t)(end-p)<k||memcmp(p,suffix,k))return 0;p+=k;if(!errno_line(&p,end))return 0;}return p==end;}
static void negative(const char *snapshot_root,const char *logical_pc,const char *sid,const char *profile_path,const char *label,const char *reason,int child){np_result r=snapshot(snapshot_root,logical_pc,sid,profile_path,2,label);int ok=refused(&r,reason,child);ck(ok,label);np_free(&r);if(!ok)die("negative-specific-return-stream-and-reason");}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
fputs("NOT_RUN origin-package requires Linux/x86_64/LP64\n",stderr);return 3;
#else
if(argc!=7||sizeof(long)!=8||sizeof(void *)!=8)die("usage ROOT CAPROOT LOGICAL_PC VERIFIER_ELF VERIFIER_PROFILE NEW_WORK");
char *dest[]={root,caproot,pc,elf,profile};for(int i=0;i<5;i++){canonical(argv[i+1]);strcpy(dest[i],argv[i+1]);}if(!within(caproot,root)||!within(pc,root)||!within(elf,root)||!within(profile,root)||within(elf,caproot)||within(profile,caproot))die("explicit-namespace-roles");
if(strlen(argv[6])>=sizeof work||argv[6][0]!='/'||strpbrk(argv[6],"\r\n\t"))die("absolute-new-work");strcpy(work,argv[6]);if(!within(work,root)||within(work,caproot))die("private-work-must-be-current-root-outside-capsule");char parent[4096];strcpy(parent,work);char *slash=strrchr(parent,'/');if(!slash||slash==parent||!slash[1]||!strcmp(slash+1,".")||!strcmp(slash+1,".."))die("new-work-leaf");*slash=0;canonical(parent);struct stat st;errno=0;if(!lstat(work,&st)||errno!=ENOENT)die("new-work-must-be-ENOENT");if(mkdir(work,0700))die("exclusive-new-work");canonical(work);path(bound,sizeof bound,root,"tools/bound");
char p[4400],mappedpc[4400],ctx[4096],mappedctx[4400],record_sha[65];size_t n;map(pc,mappedpc);path(p,sizeof p,mappedpc,"context.tsv");char *s=load(p,&n,record_sha);field(s,n,"source-context",ctx,sizeof ctx);free(s);map(ctx,mappedctx);path(helper,sizeof helper,mappedctx,"identity-helper");
guard_path(root,"unisacc.com");guard_path(root,"unisacc.com.build.json");guard_path(caproot,"unisacc.com");guard_path(caproot,"unisacc.com.build.json");guard_path(root,"tools/source-origin-verify.cx");guard_path(root,"tools/cxlib/sourcepackage.cx");guard_path(root,"tools/cxlib/netpack.cx");guard_path(root,"tools/cxlib/kernelsha.cx");guard_path(root,"tools/bound");guard_path(root,"tools/bound.c");guard(helper);guard_path(caproot,"seed/ident.c");guard_path(mappedctx,"context.tsv");guard_path(mappedpc,"context.tsv");guard_path(mappedpc,"model-inputs.tsv");guard_path(mappedpc,"package.tsv");guard(elf);guard(profile);
char capsule[4096];strcpy(capsule,caproot);slash=strrchr(capsule,'/');if(!slash||slash==capsule)die("capsule-parent");*slash=0;guard_path(capsule,"SEALED.tsv");
s=load(profile,&n,record_sha);char saved_bootstrap[4096],saved_record[4400];field(s,n,"bootstrap",saved_bootstrap,sizeof saved_bootstrap);guard(saved_bootstrap);int bz=snprintf(saved_record,sizeof saved_record,"%s.build.json",saved_bootstrap);if(bz<0||(size_t)bz>=sizeof saved_record)die("bootstrap-record-path");guard(saved_record);altered_profile(s,n,"driver-sha","altered-profile.tsv");altered_profile(s,n,"bootstrap-record-sha","wrong-record-profile.tsv");free(s);char altered[4400],wrongrecord[4400],empty[4400],dotpc[4400],outside[4400];path(altered,sizeof altered,work,"altered-profile.tsv");path(wrongrecord,sizeof wrongrecord,work,"wrong-record-profile.tsv");path(empty,sizeof empty,work,"empty-snapshot");if(mkdir(empty,0700))die("exclusive-empty-snapshot");guard(altered);guard(wrongrecord);int z=snprintf(dotpc,sizeof dotpc,"%s/./out",root);if(z<0||(size_t)z>=sizeof dotpc)die("dotpc-bound");strcpy(outside,"/tmp/unisacc-origin-outside-logical-root");
/* Record the saved helper's source and executable separately from the two
 * actual source trees it scans. Reusing this measured reader is not a claim
 * that it was rebuilt from either tree or that its old SID receipt is fresh. */
char helper_hash[65],helper_source_hash[65];size_t hn;char *hs=load(helper,&hn,helper_hash);free(hs);path(p,sizeof p,caproot,"seed/ident.c");hs=load(p,&hn,helper_source_hash);free(hs);path(p,sizeof p,mappedctx,"context.tsv");hs=load(p,&hn,record_sha);char declared_helper[65],declared_helper_source[65];field(hs,hn,"identity-helper",declared_helper,sizeof declared_helper);field(hs,hn,"identity-source",declared_helper_source,sizeof declared_helper_source);free(hs);if(strcmp(helper_hash,declared_helper)||strcmp(helper_source_hash,declared_helper_source))die("actual-origin-helper-and-source-vs-context");char scope[16000];int scope_n=snprintf(scope,sizeof scope,"origin-package-test-scope-v1\nhelper\t%s\nhelper-sha\t%s\nhelper-source\t%s/seed/ident.c\nhelper-source-sha\t%s\norigin-input-root\t%s\ncurrent-input-root\t%s\norigin-source-expected\t%s\ncurrent-source-expected\t%s\nmaximum-child-seconds\t48\nNOT_COVERED\tDAG-leaf-status-extra-directory-executebit-parent-symlink-normal-v1-alias\n",helper,helper_hash,caproot,helper_source_hash,caproot,root,origin_sid,current_sid);if(scope_n<0||(size_t)scope_n>=sizeof scope)die("scope-bound");save("scope.tsv",scope,(size_t)scope_n);
/* No fixture writes follow this point; evidence has separate unique names. */
identity(caproot,origin_sid,"origin-source-before");identity(root,current_sid,"current-source-before");
Report before,after;positive("positive-before",&before);
negative(caproot,pc,origin_sid,altered,"altered-current-driver-profile","profile-wrapper-source-hash",0);
char wrong[65];strcpy(wrong,origin_sid);wrong[0]=wrong[0]=='0'?'1':'0';negative(caproot,pc,wrong,profile,"wrong-fresh-origin-source","receipt-bytes-mismatch",1);
negative(empty,pc,origin_sid,profile,"empty-snapshot-no-live-fallback","origin-physical-not-canonical",1);
negative(caproot,dotpc,origin_sid,profile,"noncanonical-logical-package","origin-dot-component",1);
negative(caproot,outside,origin_sid,profile,"outside-logical-root-package","origin-path-outside-logical-root",1);
negative(caproot,pc,origin_sid,wrongrecord,"wrong-saved-bootstrap-record-profile","origin-execution-profile-identity",1);
positive("positive-after",&after);int equal=1;for(int i=0;i<32;i++)if(i!=30&&strcmp(before.value[i],after.value[i]))equal=0;ck(equal,"recovery-all-identity-mapping-canonical-count-fields-equal");
identity(caproot,origin_sid,"origin-source-after");identity(root,current_sid,"current-source-after");guards_after();DIR *d=opendir(empty);if(!d)die("empty-fixture-after-opendir");int entries=0;for(;;){errno=0;struct dirent *e=readdir(d);if(!e){int error=errno,rc=closedir(d);if(error||rc)die("empty-fixture-after-readdir");break;}if(strcmp(e->d_name,".")&&strcmp(e->d_name,".."))entries++;}ck(!entries,"empty-snapshot-remains-empty-no-writes");
printf("NOT_COVERED\tDAG-leaf-status-extra-directory-executebit-parent-symlink-normal-v1-alias\n");printf("ORIGIN_PACKAGE\t%d\t%d\tfinite-origin-consistency-only-no-current-construction-qualification\n",assertions,failures);return failures?1:0;
#endif
}
