#!/usr/bin/env -S unisacc.com -run
/* 0.0.35 K0: cx_runv_timeout (argv, no shell; exit, timeout, missing program) and cx_walk; 0.0.43: cx_read */

static int cnt(const char *p, void *c) { (void)p; ++*(int *)c; return 0; }
int main(void) {
    char *o; size_t n; int bad = 0, k = 0;
    char *a1[] = {"echo", "a b;$x", 0}, *a2[] = {"false", 0}, *a3[] = {"sleep", "5", 0}, *a4[] = {"/nonexistent", 0};
    if (cx_runv_timeout(a1, 5, &o, &n) || strcmp(o, "a b;$x\n")) bad |= 1;   /* no shell expansion */
    if (cx_runv_timeout(a2, 5, 0, 0) != 1) bad |= 2;
    if (cx_runv_timeout(a3, 1, 0, 0) != 124) bad |= 4;
    if (cx_runv_timeout(a4, 1, 0, 0) != 127) bad |= 8;
    if (cx_walk("include/sys", cnt, &k) || k < 5) bad |= 16;
    if (cx_walk("/nonexistent", cnt, &k) != -1) bad |= 32;
    if (cx_read("include/sys", &n) != 0 || n != 0) bad |= 64;            /* a directory is an error (0.0.43) */
    if (!(o = cx_read("include/cx.h", &n)) || n < 100 || strncmp(o, "/* cx.h", 7)) bad |= 128;
    free(o);
    {   FILE *held[8]; int i, failed = 0;
        for (i = 0; i < 8; i++) {
            held[i] = fopen("include/cx.h", "rb");
            if (!held[i]) failed = 1;
            else fgetc(held[i]);
        }
        o = cx_read("include/sys", &n);
        if (o || n != 0) failed = 1;
        free(o);
        o = cx_read("include/cx.h", &n);
        if (!o || n < 100 || strncmp(o, "/* cx.h", 7)) failed = 1;
        free(o);
        for (i = 0; i < 8; i++) if (held[i]) fclose(held[i]);
        if (failed) bad |= 64;
    }
    printf("k0 bad=%d files=%d\n", bad, k); return bad;
}
