/* ROOT GEN SOURCE_PKG LEGACY_PROBE. Outer55, Linux/x86_64-LP64 bootstrap
 * mechanism only. Two source-candidate physical endpoint validations bracket
 * three exact API-schema/BOM refusals. The legacy fixture is an exact read-only
 * copy of the three saved P7 leaves, not newly constructed or qualified NN.
 * Failure must clear the entire supplied result. No installer, writes, copied
 * material, signature, cached PASS or historical-execution claim.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.rebuildcontext
static int sc_assertions,sc_failures;
static const char *sc_current="329cdb7077891074f638634dc7abdcd59ee39c368ad6ba1c2fcf867c3c63de2e";
static void sc_die(const char *s){fprintf(stderr,"candidate-schema: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void sc_check(int ok,const char *label){sc_assertions++;if(!ok)sc_failures++;printf("%s\t%s\n",ok?"PASS":"FAIL",label);}
static void sc_part(int ok,const char *label,const char *part){char s[200];int n=snprintf(s,sizeof s,"%s.%s",label,part);if(n<0||(size_t)n>=sizeof s)sc_die("label-bound");sc_check(ok,s);}
static void sc_path(char *p,size_t cap,const char *base,const char *leaf){int n=snprintf(p,cap,"%s/%s",base,leaf);if(n<0||(size_t)n>=cap)sc_die("path-bound");}
static int sc_hex(const char *h){if(strlen(h)!=64)return 0;for(int i=0;i<64;i++)if(!((h[i]>='0'&&h[i]<='9')||(h[i]>='a'&&h[i]<='f')))return 0;return 1;}
static char *sc_read(const char *p,size_t *n,char hash[65]){
    struct stat a,b;if(lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>8388608)sc_die("regular-bounded-fixture");
    int fd=open(p,O_RDONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC);if(fd<0)sc_die("fixture-open");
    if(fstat(fd,&b)||!S_ISREG(b.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size){close(fd);sc_die("fixture-descriptor");}
    *n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s){close(fd);sc_die("allocation");}
    size_t at=0;int bad=0;
    while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){bad=1;break;}at+=(size_t)z;}
    char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);
    if(z||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)bad=1;
    if(close(fd))bad=1;if(bad){free(s);sc_die("fixture-extent-or-close");}
    s[*n]=0;cx_sha256_hex(s,*n,hash);return s;
}
static void sc_record_source(const char *s,size_t n,char source_out[65]){
    const char *key="\n  \"sources_sha256\": \"";size_t k=strlen(key);
    if(memchr(s,0,n)||np_count(s,n,key,k)!=1)sc_die("fixture-source-field");
    const char *at=strstr(s,key)+k;
    if((size_t)(at-s)>n||n-(size_t)(at-s)<65||at[64]!='\"')sc_die("fixture-source-field-extent");
    memcpy(source_out,at,64);source_out[64]=0;if(!sc_hex(source_out))sc_die("fixture-source-field-hex");
}
static rb_result sc_positive(const char *root_arg,const char *gen,const char *pkg,const char *builder,const char *raw,const char *record,const char *old_source,const char *label){
    rb_result out;memset(&out,0xa5,sizeof out);char why[2048];memset(why,'!',sizeof why);
    int rc=rb_verify_candidate(root_arg,gen,pkg,builder,&out,why,sizeof why);
    sc_part(rc==0,label,"actual-candidate-admission");
    if(rc){if(memchr(why,0,sizeof why))fprintf(stderr,"%s\n",why);sc_die("positive-candidate-api");}
    sc_part(!why[0],label,"empty-success-reason");
    sc_part(!strcmp(out.source,sc_current),label,"fresh-current-Source329");
    if(strcmp(out.source,sc_current)||!strcmp(out.bootstrap_record_source,out.source))sc_die("historical-bootstrap-contract-not-applicable");
    sc_part(out.package_kind==2,label,"source-package-v1-kind");
    sc_part(out.source_jobs==107&&out.source_models==34,label,"complete-DAG-107-jobs-34-models");
    sc_part(!strcmp(out.bootstrap,raw)&&!strcmp(out.root_product,raw),label,"actual-root-is-generation-builder");
    sc_part(!strcmp(out.bootstrap_record_source,old_source)&&strcmp(out.bootstrap_record_source,out.source)!=0,label,"original-builder-source-is-historical");
    sc_part(!strcmp(out.builder_record,record),label,"v2-builder-original-record-digest");
    sc_part(!strcmp(out.package_epoch_artifact,raw)&&!strcmp(out.package_epoch_record,record),label,"package-epoch-raw-and-original-record");
    sc_part(!strcmp(out.package_epoch_source,old_source),label,"package-epoch-original-source");
    sc_part(sc_hex(out.product)&&sc_hex(out.package),label,"candidate-and-prepared-package-digests");
    sc_part(sc_hex(out.kernel_context)&&sc_hex(out.product_context)&&sc_hex(out.witness),label,"v2-context-and-observation-witness");
    sc_part(out.source_physical_reads>0&&out.physical_reads>0&&out.files>0,label,"fresh-physical-observations");
    sc_part(out.source_elapsed_ns>0,label,"independently-measured-source-snapshot");
    printf("CANDIDATE\t%s\tproduct=%s\tpackage=%s\tcontext=%s\twitness=%s\tsource_reads=%d\tsource_ns=%lld\n",label,out.product,out.package,out.product_context,out.witness,out.source_physical_reads,out.source_elapsed_ns);
    return out;
}
static int sc_zero(const rb_result *r){const unsigned char *p=(const unsigned char *)r;for(size_t i=0;i<sizeof *r;i++)if(p[i])return 0;return 1;}
static int sc_reason(const char *why,const char *reason,const char *path){
    char prefix[1400];int n=snprintf(prefix,sizeof prefix,"%s path=%s errno=",reason,path);
    if(n<0||(size_t)n>=sizeof prefix||strncmp(why,prefix,(size_t)n))return 0;
    const char *p=why+n;if(*p=='-')p++;const char *start=p;
    while(*p>='0'&&*p<='9')p++;return p!=start&&!*p;
}
static void sc_negative(const char *r,const char *gen,const char *pkg,const char *builder,int candidate,const char *label,const char *reason,const char *error_path){
    rb_result out;memset(&out,0xa5,sizeof out);char why[2048];memset(why,'!',sizeof why);
    int rc=candidate?rb_verify_candidate(r,gen,pkg,builder,&out,why,sizeof why):rb_verify_legacy_candidate(r,gen,pkg,builder,&out,why,sizeof why);
    sc_part(rc==-1,label,"explicit-refusal");
    int terminated=memchr(why,0,sizeof why)!=0;
    sc_part(terminated&&sc_reason(why,reason,error_path),label,"exact-reason-path-and-numeric-errno");
    sc_part(sc_zero(&out),label,"whole-result-cleared-including-padding");
    if(terminated)printf("REFUSAL\t%s\t%s\n",label,why);
}
static void sc_same(const rb_result *a,const rb_result *b){
    const char *av[]={a->source,a->bootstrap,a->bootstrap_record_source,a->product,a->package,a->kernel_context,a->product_context,a->witness,a->root_product,a->root_native,a->native_receipt,a->package_epoch_artifact,a->package_epoch_record,a->package_epoch_source,a->builder_record};
    const char *bv[]={b->source,b->bootstrap,b->bootstrap_record_source,b->product,b->package,b->kernel_context,b->product_context,b->witness,b->root_product,b->root_native,b->native_receipt,b->package_epoch_artifact,b->package_epoch_record,b->package_epoch_source,b->builder_record};
    const char *names[]={"source","builder-raw","builder-record-source","candidate-raw","prepared-package","kernel-context","v2-product-context","complete-witness","root-raw","root-native","native-receipt","package-epoch-raw","package-epoch-record","package-epoch-source","builder-record"};
    for(int i=0;i<15;i++)sc_part(!strcmp(av[i],bv[i]),"recovery",names[i]);
    sc_check(a->package_kind==b->package_kind&&a->source_jobs==b->source_jobs&&a->source_models==b->source_models&&a->model_inputs==b->model_inputs,"recovery.package-kind-and-logical-domains");
    sc_check(a->source_physical_reads==b->source_physical_reads&&a->physical_reads==b->physical_reads&&a->files==b->files&&a->retained_hits==b->retained_hits&&a->retained_bytes==b->retained_bytes,"recovery.physical-and-retention-counts");
    sc_check(a->root_has_native==b->root_has_native&&a->has_native==b->has_native&&a->has_product_record==b->has_product_record,"recovery.optional-metadata-presence");
}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
    fprintf(stderr,"NOT_RUN candidate-schema requires Linux/x86_64-LP64\n");return 3;
#else
    if(argc!=5||sizeof(long)!=8||sizeof(void *)!=8)sc_die("usage ROOT GEN SOURCE_PKG LEGACY_PROBE (Linux/x86_64-LP64)");
    char r[4096],gen[4096],pkg[4096],legacy[4096],reference[4400],paths[11][4400],hashes[11][65],old_source[65],old_template[4400];
    if(!realpath(argv[1],r)||!realpath(argv[2],gen)||!realpath(argv[3],pkg)||!realpath(argv[4],legacy)||!strcmp(pkg,legacy))sc_die("distinct-explicit-material-roots");
    if(strlen(pkg)>1023||strlen(legacy)>1023)sc_die("exact-reason-path-bound");
    sc_path(reference,sizeof reference,r,"out/c43-native-package-12");
    sc_path(paths[0],sizeof paths[0],r,"unisacc.com");
    sc_path(paths[1],sizeof paths[1],r,"unisacc.com.build.json");
    sc_path(paths[2],sizeof paths[2],r,"out/c43-u64-checkpoint-01/bootstrap.com");
    int n=snprintf(paths[3],sizeof paths[3],"%s.build.json",paths[2]);if(n<0||(size_t)n>=sizeof paths[3])sc_die("checkpoint-record-path");
    const char *leaves[]={"compiler.pkg","package.tsv","model-inputs.tsv"};
    for(int i=0;i<3;i++){sc_path(paths[4+i],sizeof paths[4+i],legacy,leaves[i]);sc_path(paths[7+i],sizeof paths[7+i],reference,leaves[i]);}
    /* The kernel template the old BOM pins as unisa/ckernel.py (row 1042) has been exec/kernel/body.c since
       2026-10-30 (unisa/ is archived): input 10 is the current template file, and the legacy API, reading
       row 1042, now meets an absent file (file-io, errno 2) where it used to meet a changed digest. */
    sc_path(paths[10],sizeof paths[10],r,"exec/kernel/body.c");
    sc_path(old_template,sizeof old_template,r,"unisa/ckernel.py");
    for(int i=0;i<11;i++){
        size_t bytes;char *s=sc_read(paths[i],&bytes,hashes[i]);
        if(i==1)sc_record_source(s,bytes,old_source);
        if(i==5){const char *p="PREPARED\tpackage-refresh\tno-test-result\n";sc_check(bytes>=strlen(p)&&!memcmp(s,p,strlen(p)),"actual-legacy-package-refresh-receipt-header");}
        if(i==6){
            sc_check(np_count(s,bytes,"\n",1)==1241,"actual-old-complete-1241-row-BOM-retained");
            const char *key="unisa/ckernel.py\t";
            const char *old_row="unisa/ckernel.py\tdb184ffec27565ad0a6d725d49710e7818af7d8e686fb642b67c862b88503aa3\n";
            const char *core_key="kernel/unisa_core.c\t";
            char *template_row=strstr(s,old_row),*core_row=strstr(s,core_key);
            sc_check(np_count(s,bytes,key,strlen(key))==1&&np_count(s,bytes,old_row,strlen(old_row))==1&&template_row&&(template_row==s||template_row[-1]=='\n'),"old-BOM.unique-template-path-and-pinned-old-hash");
            sc_check(template_row&&np_count(s,(size_t)(template_row-s),"\n",1)+1==1042,"old-BOM.template-is-row1042");
            sc_check(core_row&&np_count(s,bytes,core_key,strlen(core_key))==1&&(core_row==s||core_row[-1]=='\n')&&np_count(s,(size_t)(core_row-s),"\n",1)+1==1115,"old-BOM.kernel-core-is-unique-row1115");
            sc_check(template_row&&core_row&&template_row<core_row,"old-BOM.template-change-precedes-generated-core");
        }
        if(i==10){
            sc_check(!strcmp(hashes[i],"483dd021e7adb34fa0d9128c5048c8a3030409585f13ffeca1ae9e41054e4e8e"),"current-template.fixed-new-full-file-hash");
            sc_check(strcmp(hashes[i],"db184ffec27565ad0a6d725d49710e7818af7d8e686fb642b67c862b88503aa3")!=0,"current-template.differs-from-old-BOM-hash");
        }
        free(s);
    }
    if(!strcmp(old_source,sc_current))sc_die("historical-bootstrap-contract-not-applicable-current-source-root");
    if(strcmp(hashes[0],hashes[2])||strcmp(hashes[1],hashes[3]))sc_die("checkpoint-must-match-real-root-raw-and-original-record");
    for(int i=0;i<3;i++){char label[100];snprintf(label,sizeof label,"legacy-probe.%s.exact-saved-P7-bytes",leaves[i]);sc_check(!strcmp(hashes[4+i],hashes[7+i]),label);if(strcmp(hashes[4+i],hashes[7+i]))sc_die("probe-is-not-the-real-old-three-leaf-material");}
    pid_t caller=getpid();
    rb_result initial=sc_positive(r,gen,pkg,paths[0],hashes[0],hashes[1],old_source,"source-before");
    sc_check(!strcmp(initial.package,hashes[4]),"same-P3-bytes-do-not-imply-same-package-schema-or-BOM");
    sc_negative(r,gen,pkg,paths[0],0,"legacy-API-refuses-source-package-schema","legacy-candidate-preinstall-requires-package-refresh",pkg);
    sc_negative(r,gen,legacy,paths[0],1,"source-API-refuses-real-P7-schema","candidate-preinstall-requires-source-package-v1",legacy);
    sc_negative(r,gen,legacy,paths[0],0,"legacy-API-evaluates-real-old-BOM","file-io",old_template);
    sc_check(getpid()==caller,"parent-survives-all-schema-and-BOM-refusals");
    rb_result final=sc_positive(r,gen,pkg,paths[0],hashes[0],hashes[1],old_source,"source-after");
    sc_same(&initial,&final);
    for(int i=0;i<11;i++){size_t bytes;char h[65],label[110];char *s=sc_read(paths[i],&bytes,h);free(s);if(i==10)snprintf(label,sizeof label,"current-template.full-file-hash-unchanged");else snprintf(label,sizeof label,"input-%d-root-checkpoint-probe-or-old-material-unchanged",i);sc_check(!strcmp(h,hashes[i]),label);}
    puts("SCOPE\tinvalid-old-1241-row-BOM-probe;disjoint-source-and-P7-candidate-APIs;initial-historical-bootstrap;unsigned-consistency-not-historical-execution;not-positive-legacy-qualification-selfhost-N22-NN-or-new-candidate-functional-PASS");
    puts("TIMING\tsource_snapshot_ns=reported-per-endpoint;other-phases=UNMEASURED;outer55-and-API-budgets-unchanged;no-installer-or-root-writes");
    printf("CANDIDATE_SCHEMA\tassertions=%d\tfailed=%d\n",sc_assertions,sc_failures);
    int failed=sc_failures?1:0;if(fflush(stdout)||ferror(stdout))return 2;return failed;
#endif
}
