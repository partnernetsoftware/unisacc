#!/usr/bin/env -S unisacc.com -run
/* sourcenamecheck.cx PRODUCT: the fixed logical source name, as RULED
   (plans/v0.0.43.md, cc 2026-10-14: the core sees the command-line spelling,
   like gcc; the physical directory is not an input).  The step-0 record is
   tests/sourcelabelcheck.cx (ungated); this leaf is the ruling's verdict.
   The same source sits at DIRA/src/probe.c and DIRB/src/probe.c and is
   compiled as the relative spelling "src/probe.c" from each directory:
   - the -S tape text is byte-identical across the two directories;
   - -run prints __FILE__ as exactly "src/probe.c" in both;
   - a syntax-error probe's diagnostic names "src/probe.c" with the same bytes
     on both sides (no physical directory leaks);
   - a quoted include beside the file resolves in both (same -S bytes).
   An absolute spelling is the user's own explicit input: __FILE__ then prints
   that absolute path verbatim. */
static char DA[4096], DB[4096], P[4096];
static int checks, bad;
static int note(const char *name, int ok) {
    printf("srcname %-18s %s\n",name,ok ? "pass" : "FAIL");
    checks++;if(!ok)bad++;return !ok;
}
static int put(const char *dir, const char *name, const char *body) {
    char path[8192];snprintf(path,sizeof path,"%s/%s",dir,name);
    return cx_write(path,body,strlen(body));
}
/* run PRODUCT from DIR on the relative spelling; capture stdout, stderr to DIR/err */
static int run_in(const char *dir, const char *args, char **out, size_t *on) {
    char cmd[16384];
    snprintf(cmd,sizeof cmd,"cd '%s' && %s'%s' %s 2>err",dir,
        strstr(P,".com") ? "sh " : "",P,args);
    return cx_run_timeout(cmd,15,out,on);
}
static char *readd(const char *dir, const char *name, size_t *n) {
    char path[8192];snprintf(path,sizeof path,"%s/%s",dir,name);return cx_read(path,n);
}
/* both directories agree byte for byte on (rc, stdout, stderr) */
static int agree(const char *name, const char *args, int wantrc,
                 char **keepout, size_t *keepn) {
    char *oa=0,*ob=0,*ea,*eb;size_t na=0,nb=0,ena=0,enb=0;int ra,rb,ok;
    ra=run_in(DA,args,&oa,&na);ea=readd(DA,"err",&ena);
    rb=run_in(DB,args,&ob,&nb);eb=readd(DB,"err",&enb);
    ok=ra==wantrc&&rb==wantrc&&na==nb&&(!na||!memcmp(oa,ob,na))&&
       ena==enb&&(!ena||!memcmp(ea,eb,ena));
    if(note(name,ok))fprintf(stderr,"rcA=%d rcB=%d outA(%zu) outB(%zu) errA=%s errB=%s\n",
        ra,rb,na,nb,ea?ea:"",eb?eb:"");
    if(keepout&&ok){*keepout=oa;*keepn=na;oa=0;}
    free(oa);free(ob);free(ea);free(eb);return !ok;
}
int main(int argc,char **argv) {
    char owna[]="/tmp/srcnameaXXXXXX",ownb[]="/tmp/srcnamebXXXXXX",cwd[4096],cmd[16384];
    char *o=0;size_t n=0;int i;
    static const char FILEPROBE[]="#include <stdio.h>\nint main(void){puts(__FILE__);return 0;}\n";
    static const char BADPROBE[]="int main(void){return (;}\n";
    static const char INCPROBE[]="#include \"rel.h\"\nint main(void){return REL==4?0:9;}\n";
    if(argc!=2)return 2;
    if(!getcwd(cwd,sizeof cwd)||!mkdtemp(owna)||!mkdtemp(ownb))return 2;
    snprintf(DA,sizeof DA,"%s",owna);snprintf(DB,sizeof DB,"%s",ownb);
    if(argv[1][0]=='/')snprintf(P,sizeof P,"%s",argv[1]);else snprintf(P,sizeof P,"%s/%s",cwd,argv[1]);
    if(strchr(P,39)||strchr(DA,39)||strchr(DB,39))return 2;
    { const char *d[]={DA,DB,0};
      for(i=0;d[i];i++){
        char sub[8192];snprintf(sub,sizeof sub,"%s/src",d[i]);
        if(mkdir(sub,0700))return 2;
        if(put(d[i],"src/probe.c",FILEPROBE)||put(d[i],"src/bad.c",BADPROBE)||
           put(d[i],"src/inc.c",INCPROBE)||put(d[i],"src/rel.h","#define REL 4\n"))return 2;
      } }
    /* the logical name is the spelling: identical across physical directories */
    agree("file-S","src/probe.c -S -o -",0,NULL,NULL);
    agree("file-run","src/probe.c -run",0,&o,&n);
    note("file-spelling",o&&n==12&&!memcmp(o,"src/probe.c\n",12));free(o);o=0;
    agree("diag","src/bad.c -o out.bin",1,NULL,NULL);
    { char *e=readd(DA,"err",&n);
      note("diag-spelling",e&&strstr(e,"src/bad.c:1:")&&!strstr(e,DA));free(e); }
    agree("quoted-include","src/inc.c -S -o -",0,NULL,NULL);
    agree("inc-run","src/inc.c -run",0,NULL,NULL);
    /* an absolute spelling is explicit user input and prints verbatim */
    snprintf(cmd,sizeof cmd,"%s'%s' '%s/src/probe.c' -run 2>/dev/null",
        strstr(P,".com") ? "sh " : "",P,DA);
    { char want[8192];int rc=cx_run_timeout(cmd,15,&o,&n);
      snprintf(want,sizeof want,"%s/src/probe.c\n",DA);
      note("absolute-verbatim",rc==0&&o&&n==strlen(want)&&!memcmp(o,want,n));free(o); }
    printf("srcname checks %d bad %d\n",checks,bad);
    return bad?1:0;
}
