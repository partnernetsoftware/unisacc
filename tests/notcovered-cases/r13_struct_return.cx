struct a { int x; int y; };
static struct a g;
static struct a mk(int x){ struct a r; r.x=x; r.y=x+1; return r; }
static struct a gg(void){ return g; }
static struct a tern(int c){ struct a r; r.x=1; r.y=2; return c ? r : g; }
int main(void){ struct a v = mk(3); g.x=9; printf("%d %d %d\n", v.x+v.y, gg().x, tern(0).x); return 0; }
