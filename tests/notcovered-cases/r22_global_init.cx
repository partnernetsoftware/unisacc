struct a { int x; const char *n; int arr[2]; };
static int base[4] = {1,2,3,4};
static int *gp = &base[2];
static struct a tab[] = { {1, "one", {1,2}}, { .x = 2, .n = "two" } };
static const char *names[] = { "a", "bb", "ccc" };
static int (*fp)(const char *, ...) = 0;
int main(void){ printf("%d %d %s %d\n", *gp, tab[1].x, names[2], (int)(sizeof tab / sizeof tab[0])); return fp ? 1 : 0; }
