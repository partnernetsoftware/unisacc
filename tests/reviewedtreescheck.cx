#!/usr/bin/env -S unisacc.com -run
/* reviewedtreescheck.cx -- the reviewed_trees check (0.0.43) in C, ported from tests/reviewedtreescheck.py (2026-10-22,
   the owner's direction: the toolchain moves off Python).  The compilercheck family's reviewed-tree snapshots must equal
   what its trees hash to.  The snapshot is derived from the tree contents (tests/refresh_gatedeps.py computes the same
   thing from a HEAD archive); a commit that changes one of these trees must carry the refreshed snapshot, so the
   derived-consistency map routes exec/, src/ and unisa/ changes here (release/derived-map.tsv).  Read-only; runs in the
   directory it is given (the working tree by default, or a clean export): recomputes each snapshot with the refresher's
   rule and exits 1, naming the tree, when the declared value differs; exit 0 when every snapshot matches.
   usage: sh ./unisacc.com -run tests/reviewedtreescheck.cx -- [ROOT]        (later arguments are ignored, as in the .py)
   The rule, exactly as the Python one computes it:
     ROOT = Path(ROOT).resolve()   (posixpath.realpath, non-strict: a missing component is kept as written)
     for each family (JSON order) with a truthy reviewed_trees object, for each TREE in it:
       files = every entry under ROOT/TREE (Path.rglob('*'): no descent into symlinked directories) that is a regular
               file after following symlinks, kept when TREE is in all_files_trees or its suffix (3.14 rule: the name
               without leading dots, from its last dot) is in inventory_suffixes, and no excluded_dirs entry X has
               ROOT/X equal to it or among its (lexical) parents;
       stamp = sha256(json.dumps({relpath: [st_mode, sha256(content)]}, sort_keys=True))  -- keys sorted by code point,
               non-ASCII escaped \uXXXX (names that are not UTF-8 decode with surrogateescape, as os.fsdecode does).
   Any failure the Python raises (missing or malformed gatedeps.json, a key it subscripts, an unreadable file, ...) is
   exit 1 with a one-line message on stderr instead of a traceback, and nothing on stdout. */

static void die(const char *what, const char *arg) {
    fprintf(stderr, "reviewed_trees: error: %s%s%s\n", what, arg ? ": " : "", arg ? arg : ""); exit(1);
}

/* growable byte buffer, always NUL-terminated */
typedef struct { char *b; size_t n, cap; } Buf;
static void bput(Buf *x, const void *s, size_t n) {
    if (x->n + n + 1 > x->cap) { x->cap = (x->n + n + 1) * 2 + 64; x->b = realloc(x->b, x->cap); if (!x->b) die("out of memory", 0); }
    memcpy(x->b + x->n, s, n); x->n += n; x->b[x->n] = 0;
}
static void bputs(Buf *x, const char *s) { bput(x, s, strlen(s)); }
static void bputc(Buf *x, int c) { char ch = (char)c; bput(x, &ch, 1); }
static char *xstrdup(const char *s) {                  /* not strdup: the carried libc has none, -run would forward it */
    size_t n = strlen(s) + 1; char *d = malloc(n); if (!d) die("out of memory", 0); memcpy(d, s, n); return d;
}

/* ---------- strict UTF-8 (Python's decoder: no overlongs, no surrogates, nothing past U+10FFFF) ---------- */
/* length of the well-formed sequence at s[i] (0 when none starts there); its code point in *cp */
static int utf8_at(const unsigned char *s, size_t n, size_t i, unsigned *cp) {
    unsigned c = s[i], lo = 0x80, hi = 0xBF; int need, k;
    if (c < 0x80) { *cp = c; return 1; }
    if (c >= 0xC2 && c <= 0xDF) need = 1;
    else if (c >= 0xE0 && c <= 0xEF) { need = 2; if (c == 0xE0) lo = 0xA0; if (c == 0xED) hi = 0x9F; }
    else if (c >= 0xF0 && c <= 0xF4) { need = 3; if (c == 0xF0) lo = 0x90; if (c == 0xF4) hi = 0x8F; }
    else return 0;
    if (i + (size_t)need >= n) return 0;                /* truncated */
    *cp = c & (0x3F >> need);
    for (k = 1; k <= need; k++) {
        unsigned b = s[i + k];
        if (k == 1 ? (b < lo || b > hi) : (b < 0x80 || b > 0xBF)) return 0;
        *cp = (*cp << 6) | (b & 0x3F);
    }
    return need + 1;
}
static int utf8_valid(const char *s, size_t n) {
    size_t i = 0; unsigned cp; int l;
    while (i < n) { if (!(l = utf8_at((const unsigned char *)s, n, i, &cp))) return 0; i += l; }
    return 1;
}
/* os.fsdecode: UTF-8 with surrogateescape -- a byte that starts no well-formed sequence becomes U+DC00+byte */
static unsigned *fsdecode(const char *s, size_t n, size_t *len) {
    unsigned *v = malloc((n + 1) * sizeof *v), cp; size_t i = 0, k = 0; int l;
    if (!v) die("out of memory", 0);
    while (i < n) {
        l = utf8_at((const unsigned char *)s, n, i, &cp);
        if (l) { v[k++] = cp; i += l; } else { v[k++] = 0xDC00 + (unsigned char)s[i]; i++; }
    }
    *len = k; return v;
}
static void wtf8(Buf *x, unsigned c) {                  /* a code point (lone surrogates included) as bytes */
    char t[4];
    if (c < 0x80) { t[0] = (char)c; bput(x, t, 1); }
    else if (c < 0x800) { t[0] = (char)(0xC0 | c >> 6); t[1] = (char)(0x80 | (c & 0x3F)); bput(x, t, 2); }
    else if (c < 0x10000) { t[0] = (char)(0xE0 | c >> 12); t[1] = (char)(0x80 | (c >> 6 & 0x3F)); t[2] = (char)(0x80 | (c & 0x3F)); bput(x, t, 3); }
    else { t[0] = (char)(0xF0 | c >> 18); t[1] = (char)(0x80 | (c >> 12 & 0x3F)); t[2] = (char)(0x80 | (c >> 6 & 0x3F)); t[3] = (char)(0x80 | (c & 0x3F)); bput(x, t, 4); }
}

/* ---------- json.loads (Python's strict scanner; objects keep first-insertion order, a repeated key keeps the last value) ---------- */
enum { JNULL, JFALSE, JTRUE, JNUM, JSTR, JARR, JOBJ };
typedef struct J J;
struct J { int t, zero; char *s; size_t sn; J **v; char **k; size_t *kn; int n, cap; };
static const unsigned char *jp, *je;
static void jerr(const char *what) { die("tests/gatedeps.json is not valid JSON", what); }
static void jws(void) { while (jp < je && (*jp == ' ' || *jp == '\t' || *jp == '\n' || *jp == '\r')) jp++; }
static J *jnew(int t) { J *j = calloc(1, sizeof *j); if (!j) die("out of memory", 0); j->t = t; return j; }
static int hexv(int c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1; }
static int hex4(const unsigned char *p, unsigned *v) {
    int i, h; *v = 0;
    if (je - p < 4) return 0;
    for (i = 0; i < 4; i++) { if ((h = hexv(p[i])) < 0) return 0; *v = *v << 4 | (unsigned)h; }
    return 1;
}
static void jstring(Buf *o) {                           /* jp just past the opening quote */
    for (;;) {
        unsigned c;
        if (jp >= je) jerr("unterminated string");
        c = *jp;
        if (c == '"') { jp++; return; }
        if (c < 0x20) jerr("invalid control character in string");
        if (c != '\\') { bputc(o, (int)c); jp++; continue; }
        if (++jp >= je) jerr("unterminated string");
        switch (*jp) {
        case '"': bputc(o, '"'); jp++; break;
        case '\\': bputc(o, '\\'); jp++; break;
        case '/': bputc(o, '/'); jp++; break;
        case 'b': bputc(o, '\b'); jp++; break;
        case 'f': bputc(o, '\f'); jp++; break;
        case 'n': bputc(o, '\n'); jp++; break;
        case 'r': bputc(o, '\r'); jp++; break;
        case 't': bputc(o, '\t'); jp++; break;
        case 'u':
            if (!hex4(jp + 1, &c)) jerr("invalid \\uXXXX escape");
            jp += 5;
            if (c >= 0xD800 && c <= 0xDBFF && je - jp > 6 && jp[0] == '\\' && jp[1] == 'u') {
                unsigned c2;
                if (!hex4(jp + 2, &c2)) jerr("invalid \\uXXXX escape");
                if (c2 >= 0xDC00 && c2 <= 0xDFFF) { c = 0x10000 + ((c - 0xD800) << 10) + (c2 - 0xDC00); jp += 6; }
            }
            wtf8(o, c); break;
        default: jerr("invalid \\escape");
        }
    }
}
static int lit(const char *w) { size_t n = strlen(w); if ((size_t)(je - jp) >= n && !memcmp(jp, w, n)) { jp += n; return 1; } return 0; }
static J *jvalue(void);
static void jadd(J *a, J *v, char *k, size_t kn) {
    int i;
    if (k) for (i = 0; i < a->n; i++) if (a->kn[i] == kn && !memcmp(a->k[i], k, kn)) { a->v[i] = v; free(k); return; }
    if (a->n == a->cap) {
        a->cap = a->cap ? a->cap * 2 : 8;
        a->v = realloc(a->v, a->cap * sizeof *a->v); a->k = realloc(a->k, a->cap * sizeof *a->k); a->kn = realloc(a->kn, a->cap * sizeof *a->kn);
        if (!a->v || !a->k || !a->kn) die("out of memory", 0);
    }
    a->v[a->n] = v; a->k[a->n] = k; a->kn[a->n] = kn; a->n++;
}
static J *jvalue(void) {
    J *j; const unsigned char *s = jp;
    if (jp >= je) jerr("expecting value");
    switch (*jp) {
    case '"': { Buf o = {0}; jp++; bput(&o, "", 0); jstring(&o); j = jnew(JSTR); j->s = o.b; j->sn = o.n; j->zero = o.n == 0; return j; }
    case '{':
        j = jnew(JOBJ); jp++; jws();
        if (jp < je && *jp == '}') { jp++; j->zero = 1; return j; }
        for (;;) {
            Buf k = {0}; J *v;
            if (jp >= je || *jp != '"') jerr("expecting property name enclosed in double quotes");
            jp++; bput(&k, "", 0); jstring(&k); jws();
            if (jp >= je || *jp != ':') jerr("expecting ':' delimiter");
            jp++; jws(); v = jvalue(); jadd(j, v, k.b, k.n); jws();
            if (jp < je && *jp == '}') { jp++; return j; }
            if (jp >= je || *jp != ',') jerr("expecting ',' delimiter");
            jp++; jws();
        }
    case '[':
        j = jnew(JARR); jp++; jws();
        if (jp < je && *jp == ']') { jp++; j->zero = 1; return j; }
        for (;;) {
            jadd(j, jvalue(), 0, 0); jws();
            if (jp < je && *jp == ']') { jp++; return j; }
            if (jp >= je || *jp != ',') jerr("expecting ',' delimiter");
            jp++; jws();
        }
    case 'n': if (lit("null")) { j = jnew(JNULL); j->zero = 1; return j; } break;
    case 't': if (lit("true")) return jnew(JTRUE); break;
    case 'f': if (lit("false")) { j = jnew(JFALSE); j->zero = 1; return j; } break;
    case 'N': if (lit("NaN")) return jnew(JNUM); break;
    case 'I': if (lit("Infinity")) return jnew(JNUM); break;
    }
    if (*jp == '-' && lit("-Infinity")) return jnew(JNUM);
    if (*jp == '-' || (*jp >= '0' && *jp <= '9')) {   /* -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][-+]?[0-9]+)? */
        int isfloat = 0; char tmp[512]; size_t n;
        if (*jp == '-') jp++;
        if (jp >= je || *jp < '0' || *jp > '9') { jp = s; jerr("expecting value"); }
        if (*jp == '0') jp++; else while (jp < je && *jp >= '0' && *jp <= '9') jp++;
        if (je - jp > 1 && *jp == '.' && jp[1] >= '0' && jp[1] <= '9') { isfloat = 1; jp++; while (jp < je && *jp >= '0' && *jp <= '9') jp++; }
        if (jp < je && (*jp == 'e' || *jp == 'E')) {
            const unsigned char *q = jp + 1;
            if (q < je && (*q == '+' || *q == '-')) q++;
            if (q < je && *q >= '0' && *q <= '9') { isfloat = 1; while (q < je && *q >= '0' && *q <= '9') q++; jp = q; }
        }
        j = jnew(JNUM); n = (size_t)(jp - s);
        if (!isfloat) { size_t i; j->zero = 1; for (i = 0; i < n; i++) if (s[i] >= '1' && s[i] <= '9') j->zero = 0; }
        else if (n < sizeof tmp) { memcpy(tmp, s, n); tmp[n] = 0; j->zero = strtod(tmp, 0) == 0.0; }
        else { size_t i; j->zero = 1; for (i = 0; i < n && s[i] != 'e' && s[i] != 'E'; i++) if (s[i] >= '1' && s[i] <= '9') j->zero = 0; }
        return j;
    }
    jerr("expecting value"); return 0;
}
static J *jget(J *o, const char *k) {                   /* o[k] for an object; 0 when absent */
    int i; size_t n = strlen(k);
    for (i = 0; i < o->n; i++) if (o->kn[i] == n && !memcmp(o->k[i], k, n)) return o->v[i];
    return 0;
}
static int jstreq(J *v, const char *s, size_t n) { return v->t == JSTR && v->sn == n && !memcmp(v->s, s, n); }
/* Python's `needle in hay` for a str needle: list elements, dict keys, or a substring of a str */
static int py_in(const char *s, size_t n, J *hay, const char *key) {
    int i;
    if (hay->t == JARR) { for (i = 0; i < hay->n; i++) if (jstreq(hay->v[i], s, n)) return 1; return 0; }
    if (hay->t == JOBJ) { for (i = 0; i < hay->n; i++) if (hay->kn[i] == n && !memcmp(hay->k[i], s, n)) return 1; return 0; }
    if (hay->t == JSTR) {
        size_t j; if (!n) return 1;
        for (j = 0; j + n <= hay->sn; j++) if (!memcmp(hay->s + j, s, n)) return 1;
        return 0;
    }
    die("argument of `in` is not iterable", key); return 0;
}

/* ---------- paths ---------- */
/* os.path.realpath(P), non-strict, as Python 3.14's posixpath implements it (Path.resolve()) */
static char MARK[1];
typedef struct { char **v; int n, cap; } Stack;
static void spush(Stack *s, char *p) {
    if (s->n == s->cap) { s->cap = s->cap ? s->cap * 2 : 64; s->v = realloc(s->v, s->cap * sizeof *s->v); if (!s->v) die("out of memory", 0); }
    s->v[s->n++] = p;
}
static int push_parts(Stack *st, const char *p) {      /* p.split('/')[::-1] pushed; the part count */
    int n = 0, i; const char *a = p, *e; char **tmp = 0;
    for (;;) {
        e = strchr(a, '/'); if (!e) e = a + strlen(a);
        tmp = realloc(tmp, (n + 1) * sizeof *tmp); if (!tmp) die("out of memory", 0);
        tmp[n] = malloc((size_t)(e - a) + 1); if (!tmp[n]) die("out of memory", 0);
        memcpy(tmp[n], a, (size_t)(e - a)); tmp[n][e - a] = 0; n++;
        if (!*e) break;
        a = e + 1;
    }
    for (i = n - 1; i >= 0; i--) spush(st, tmp[i]);
    free(tmp); return n;
}
static char *py_realpath(const char *fn) {
    Stack rest = {0}; char **sk = 0, **sv = 0; int ns = 0, parts, i; char *path, cwd[8192];
    parts = push_parts(&rest, fn);
    if (fn[0] == '/') path = xstrdup("/");
    else { if (!getcwd(cwd, sizeof cwd)) die("cannot get the current directory", 0); path = xstrdup(cwd); }
    while (parts) {
        char *name = rest.v[--rest.n], *np; struct stat st; char tgt[8192]; ssize_t tl; size_t pl;
        if (name == MARK) {
            char *link = rest.v[--rest.n];
            for (i = 0; i < ns; i++) if (!strcmp(sk[i], link)) { sv[i] = xstrdup(path); break; }
            continue;
        }
        parts--;
        if (!*name || !strcmp(name, ".")) continue;
        if (!strcmp(name, "..")) { char *sl = strrchr(path, '/'); *sl = 0; if (!path[0]) { free(path); path = xstrdup("/"); } continue; }
        pl = strlen(path); np = malloc(pl + strlen(name) + 2); if (!np) die("out of memory", 0);
        if (!strcmp(path, "/")) sprintf(np, "/%s", name); else sprintf(np, "%s/%s", path, name);
        if (lstat(np, &st) != 0 || !S_ISLNK(st.st_mode)) { free(path); path = np; continue; }
        for (i = 0; i < ns; i++) if (!strcmp(sk[i], np)) break;
        if (i < ns) { free(path); path = xstrdup(sv[i] ? sv[i] : np); continue; }
        tl = readlink(np, tgt, sizeof tgt - 1);
        if (tl < 0) { free(path); path = np; continue; }
        tgt[tl] = 0;
        if (tgt[0] == '/') { free(path); path = xstrdup("/"); }
        sk = realloc(sk, (ns + 1) * sizeof *sk); sv = realloc(sv, (ns + 1) * sizeof *sv); if (!sk || !sv) die("out of memory", 0);
        sk[ns] = np; sv[ns] = 0; ns++;
        spush(&rest, np); spush(&rest, MARK);
        parts += push_parts(&rest, tgt);
    }
    return path;
}
/* str(Path(base) / s): an absolute s replaces base ('//' alone stays an anchor); empty and '.' parts drop, '..' stays */
static char *py_join(const char *base, const char *s, size_t sn) {
    Buf o = {0}; size_t i = 0, a;
    if (sn >= 2 && s[0] == '/' && s[1] == '/' && (sn == 2 || s[2] != '/')) { bputs(&o, "//"); i = 2; }
    else if (sn && s[0] == '/') { bputs(&o, "/"); i = 1; }
    else bputs(&o, base);
    while (i <= sn) {
        a = i; while (i < sn && s[i] != '/') i++;
        if (i > a && !(i - a == 1 && s[a] == '.')) { if (o.b[o.n - 1] != '/') bputc(&o, '/'); bput(&o, s + a, i - a); }
        i++;
    }
    return o.b;
}

/* ---------- one tree's snapshot ---------- */
typedef struct { char *rel; size_t rn; unsigned *cp; size_t cn; unsigned mode; char hex[65]; } Ent;
static Ent *ents; static int nents, capents;
static char *R;
static J *ENTRY;
static const char *TREE; static size_t TREEN;

static int ent_cmp(const void *x, const void *y) {
    const Ent *a = x, *b = y; size_t i;
    for (i = 0; i < a->cn && i < b->cn; i++) if (a->cp[i] != b->cp[i]) return a->cp[i] < b->cp[i] ? -1 : 1;
    return a->cn < b->cn ? -1 : a->cn > b->cn;
}
static int excluded(const char *q, const char *x, size_t xn) {   /* (R / x) == q or (R / x) in q.parents */
    char *X; size_t n; int r;
    if (memchr(x, 0, xn)) return 0;                     /* a NUL never appears in a path from the walk */
    X = py_join(R, x, xn); n = strlen(X);
    r = !strcmp(X, "/") || !strcmp(q, X) || (!strncmp(q, X, n) && q[n] == '/');
    free(X); return r;
}
static void consider(const char *q) {                   /* q is a regular file (after symlinks) found under the tree */
    J *aft, *ex; const char *name, *suf, *d; int keep, i;
    if (!(aft = jget(ENTRY, "all_files_trees"))) die("KeyError", "all_files_trees");
    keep = py_in(TREE, TREEN, aft, "all_files_trees");
    if (!keep) {
        J *inv = jget(ENTRY, "inventory_suffixes");
        name = strrchr(q, '/'); name = name ? name + 1 : q;
        while (*name == '.') name++;                    /* 3.14 PurePath.suffix: name.lstrip('.') from its last dot */
        d = strrchr(name, '.'); suf = d ? d : "";
        if (!inv) die("KeyError", "inventory_suffixes");
        keep = py_in(suf, strlen(suf), inv, "inventory_suffixes");
    }
    if (!keep) return;
    if ((ex = jget(ENTRY, "excluded_dirs"))) {          /* any() is lazy: an element after a match is never looked at */
        if (ex->t == JARR) { for (i = 0; i < ex->n; i++) { if (ex->v[i]->t != JSTR) die("excluded_dirs entry is not a str", 0); if (excluded(q, ex->v[i]->s, ex->v[i]->sn)) return; } }
        else if (ex->t == JOBJ) { for (i = 0; i < ex->n; i++) if (excluded(q, ex->k[i], ex->kn[i])) return; }
        else if (ex->t == JSTR) {                       /* a str iterates its characters */
            size_t j = 0; unsigned cp; int l;
            while (j < ex->sn) { l = utf8_at((const unsigned char *)ex->s, ex->sn, j, &cp); if (!l) l = 1; if (excluded(q, ex->s + j, (size_t)l)) return; j += (size_t)l; }
        } else die("excluded_dirs is not iterable", 0);
    }
    {   Ent *e; size_t rl = strlen(R), len; char *buf; struct stat st; const char *rel;
        if (!strcmp(R, "/")) { if (q[0] != '/' || (q[1] == '/' && q[2] != '/')) die("path is not under the root", q); rel = q + 1; }
        else { if (strncmp(q, R, rl) || q[rl] != '/') die("path is not under the root", q); rel = q + rl + 1; }
        if (!(buf = cx_read(q, &len))) die("cannot read", q);
        if (stat(q, &st)) die("cannot stat", q);
        if (nents == capents) { capents = capents ? capents * 2 : 1024; ents = realloc(ents, capents * sizeof *ents); if (!ents) die("out of memory", 0); }
        e = &ents[nents++];
        e->rel = xstrdup(rel); e->rn = strlen(rel); e->cp = fsdecode(e->rel, e->rn, &e->cn);
        e->mode = (unsigned)st.st_mode; cx_sha256_hex(buf, len, e->hex); free(buf);
    }
}
/* Path(root).rglob('*'): every entry of root and of each real (not symlinked) directory below it */
static void walk(const char *root) {
    Stack dirs = {0};
    spush(&dirs, xstrdup(root));
    while (dirs.n) {
        char *dir = dirs.v[--dirs.n]; DIR *dh = opendir(dir); struct dirent *de; size_t dl = strlen(dir);
        if (dh) {
            while ((de = readdir(dh))) {
                char *p; struct stat st;
                if (!strcmp(de->d_name, ".") || !strcmp(de->d_name, "..")) continue;
                p = malloc(dl + strlen(de->d_name) + 2); if (!p) die("out of memory", 0);
                if (dl && dir[dl - 1] == '/') sprintf(p, "%s%s", dir, de->d_name); else sprintf(p, "%s/%s", dir, de->d_name);
                if (lstat(p, &st) == 0 && S_ISDIR(st.st_mode)) { spush(&dirs, p); continue; }
                if (stat(p, &st) == 0 && S_ISREG(st.st_mode)) consider(p);
                free(p);
            }
            closedir(dh);
        }
        free(dir);
    }
    free(dirs.v);
}
static void escape(Buf *o, const unsigned *cp, size_t n) {   /* json.dumps of a str, ensure_ascii */
    size_t i; char t[16];
    bputc(o, '"');
    for (i = 0; i < n; i++) {
        unsigned c = cp[i];
        if (c == '"') bputs(o, "\\\""); else if (c == '\\') bputs(o, "\\\\");
        else if (c == '\n') bputs(o, "\\n"); else if (c == '\r') bputs(o, "\\r"); else if (c == '\t') bputs(o, "\\t");
        else if (c == '\b') bputs(o, "\\b"); else if (c == '\f') bputs(o, "\\f");
        else if (c >= ' ' && c <= '~') bputc(o, (int)c);
        else if (c < 0x10000) { sprintf(t, "\\u%04x", c); bputs(o, t); }
        else { unsigned v = c - 0x10000; sprintf(t, "\\u%04x\\u%04x", 0xD800 | (v >> 10), 0xDC00 | (v & 0x3FF)); bputs(o, t); }
    }
    bputc(o, '"');
}
static void stamp(const char *tree, size_t tn, char hex[65]) {
    char *root; Buf o = {0}; int i;
    if (memchr(tree, 0, tn)) die("embedded null byte in tree", 0);
    TREE = tree; TREEN = tn; nents = 0;
    root = py_join(R, tree, tn);
    walk(root); free(root);
    if (nents > 1) qsort(ents, (size_t)nents, sizeof *ents, ent_cmp);
    bputc(&o, '{');
    for (i = 0; i < nents; i++) {
        char t[64];
        if (i) bputs(&o, ", ");
        escape(&o, ents[i].cp, ents[i].cn);
        sprintf(t, ": [%u, \"", ents[i].mode); bputs(&o, t); bputs(&o, ents[i].hex); bputs(&o, "\"]");
        free(ents[i].rel); free(ents[i].cp);
    }
    bputc(&o, '}');
    cx_sha256_hex(o.b, o.n, hex); free(o.b);
}

int main(int argc, char **argv) {
    char *gp, *text; size_t tl; J *d, *fams; Buf bad = {0}; int nbad = 0, f, t;
    R = py_realpath(argc > 1 ? argv[1] : ".");
    gp = py_join(R, "tests/gatedeps.json", 19);
    if (!(text = cx_read(gp, &tl))) die("cannot read", gp);
    if (!utf8_valid(text, tl)) die("tests/gatedeps.json is not UTF-8", 0);
    jp = (const unsigned char *)text; je = jp + tl;
    jws(); d = jvalue(); jws();
    if (jp != je) jerr("extra data");
    if (d->t != JOBJ) die("tests/gatedeps.json is not an object", 0);
    if (!(fams = jget(d, "families"))) die("KeyError", "families");
    if (fams->t != JOBJ) die("families is not an object", 0);
    for (f = 0; f < fams->n; f++) {
        J *rt;
        ENTRY = fams->v[f];
        if (ENTRY->t != JOBJ) die("family entry is not an object", fams->k[f]);
        rt = jget(ENTRY, "reviewed_trees");
        if (!rt || rt->zero) continue;                  /* entry.get('reviewed_trees') or {} */
        if (rt->t != JOBJ) die("reviewed_trees is not an object", fams->k[f]);
        for (t = 0; t < rt->n; t++) {
            char hex[65];
            stamp(rt->k[t], rt->kn[t], hex);
            if (!jstreq(rt->v[t], hex, 64)) {
                if (nbad++) bputs(&bad, ", ");
                bput(&bad, fams->k[f], fams->kn[f]); bputc(&bad, '/'); bput(&bad, rt->k[t], rt->kn[t]);
            }
        }
    }
    if (nbad) {
        fputs("reviewed_trees: stale snapshot(s), refresh with tests/refresh_gatedeps.py in the same commit: ", stdout);
        fwrite(bad.b, 1, bad.n, stdout); fputc('\n', stdout);
        return 1;
    }
    printf("reviewed_trees: every snapshot matches its tree (%d families)\n", fams->n);
    return 0;
}
