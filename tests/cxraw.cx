#!/usr/bin/env -S unisacc.com -run
/* cxraw.cx -- layering ratchet (plans/cx-layers.md): per tracked .cx file outside the
   bottom layer, direct calls of libc/POSIX memory, string, file, process and environment
   functions (malloc, memcpy, strlen, open, read, fork, getenv, ... see raw_name below).
   Upper layers are to reach those only through the bottom packages; the bottom layer is
   the path prefixes listed in tests/cxraw-layers.tsv and is not counted.
   Comments and string or character literals do not count.  The count only goes down;
   a new upper-layer .cx with no row is held at 0.  The scanner self-check counts the
   fixed sample below: malloc( in a comment and "memcpy(" in a string must not count,
   the strlen call must, so the sample counts exactly 1.  This checker is itself a
   test-layer tool with its own baseline row like any other upper-layer file.
   usage, from the repo root:
     sh ./unisacc.com -run tests/cxraw.cx -- --check
     sh ./unisacc.com -run tests/cxraw.cx -- --write
*/
#define BASELINE "tests/cxraw.tsv"
#define LAYERS "tests/cxraw-layers.tsv"
#define MAXROWS 4096
#define CAP 65536
#pragma unisa use text.text
#pragma unisa use mem.arena
/* Itself an upper-layer tool: byte strings via text, buffers from one process-lifetime arena. */
static int arena;
static char *keep(const char *s, long n) {
    char *p = ar_dup(arena, s, n);
    if (!p) { fprintf(stderr, "cxraw: out of memory\n"); exit(2); }
    return p;
}

static const char cxraw_sample[] = "/* malloc( */ x = \"memcpy(\"; n = strlen (s); y = 'm';\n";
static char *bottom[64];
static int nbottom;

typedef struct { char *path; int count; int used; } Row;
static Row rows[MAXROWS];
static int nrows;

static int is_id(int c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || (c >= '0' && c <= '9');
}
static int is_start(int c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}
static int name_is(const char *s, size_t n, const char *w) {
    return tx_same(s, (long)n, w, tx_len(w, CAP));
}
static const char *raw_names[] = {
    "malloc", "calloc", "realloc", "free", "strdup", "strndup",
    "memcpy", "memmove", "memset", "memcmp", "memchr",
    "strlen", "strcpy", "strncpy", "strcat", "strncat", "strcmp", "strncmp", "strchr", "strrchr", "strstr",
    "fopen", "fdopen", "fclose", "fread", "fwrite", "fseek", "ftell", "fgets", "fflush",
    "open", "openat", "close", "read", "write", "lseek", "pread", "pwrite", "stat", "fstat", "lstat",
    "mmap", "munmap", "mprotect", "unlink", "rename", "mkdir", "rmdir", "opendir", "readdir", "closedir",
    "fork", "vfork", "execve", "execv", "execvp", "waitpid", "pipe", "dup", "dup2", "kill", "posix_spawn", "posix_spawnp",
    "getenv", "setenv", "unsetenv", "clock_gettime", "nanosleep", 0};
static int unbounded(const char *s, size_t n) {
    int k;
    for (k = 0; raw_names[k]; k++) if (name_is(s, n, raw_names[k])) return 1;
    return 0;
}
static int load_layers(void) {
    size_t n, i = 0, e; char *b = cx_read(LAYERS, &n);
    if (!b) { fprintf(stderr, "cxraw: cannot read %s\n", LAYERS); return -1; }
    while (i < n) {
        e = i; while (e < n && b[e] != '\n') e++;
        if (e < n) b[e] = 0;
        if (e > i && b[i] != '#') {
            if (nbottom == 64 || b[e - 1] != '/' && tx_find(b + i, (long)(e - i), ".cx", 3) < 0) { fprintf(stderr, "cxraw: %s: bad prefix '%s'\n", LAYERS, b + i); return -1; }
            bottom[nbottom++] = b + i;
        }
        i = e + 1;
    }
    return 0;
}
static int is_bottom(const char *p) {
    int k;
    for (k = 0; k < nbottom; k++) if (tx_prefix(p, tx_len(p, CAP), bottom[k], tx_len(bottom[k], CAP))) return 1;
    return 0;
}

static int count_calls(const char *b, size_t n) {
    size_t i = 0;
    int c = 0, mode = 0;
    (void)cxraw_sample;
    while (i < n) {
        char ch = b[i];
        if (mode == 1) {
            if (ch == '\n') mode = 0;
            i++;
            continue;
        }
        if (mode == 2) {
            if (ch == '*' && i + 1 < n && b[i + 1] == '/') { mode = 0; i += 2; continue; }
            i++;
            continue;
        }
        if (mode == 3 || mode == 4) {
            if (ch == '\\' && i + 1 < n) { i += 2; continue; }
            if ((mode == 3 && ch == '"') || (mode == 4 && ch == '\'')) mode = 0;
            i++;
            continue;
        }
        if (ch == '/' && i + 1 < n && b[i + 1] == '/') { mode = 1; i += 2; continue; }
        if (ch == '/' && i + 1 < n && b[i + 1] == '*') { mode = 2; i += 2; continue; }
        if (ch == '"') { mode = 3; i++; continue; }
        if (ch == '\'') { mode = 4; i++; continue; }
        if (is_start((unsigned char)ch) && (i == 0 || !is_id((unsigned char)b[i - 1]))) {
            size_t a = i;
            size_t j;
            i++;
            while (i < n && is_id((unsigned char)b[i])) i++;
            j = i;
            while (j < n && (b[j] == ' ' || b[j] == '\t' || b[j] == '\n' || b[j] == '\r' || b[j] == '\f' || b[j] == '\v')) j++;
            if (j < n && b[j] == '(' && unbounded(b + a, i - a)) c++;
            continue;
        }
        i++;
    }
    return c;
}

static int load_baseline(void) {
    size_t n, i = 0, e, t; char *b = cx_read(BASELINE, &n);
    if (!b) { fprintf(stderr, "cxraw: cannot read %s (run --write once)\n", BASELINE); return -1; }
    while (i < n) {
        e = i; while (e < n && b[e] != '\n') e++;
        if (e < n) b[e] = 0;
        if (e > i && b[e - 1] == '\r') b[e - 1] = 0;
        if (e > i && b[i] != '#') {
            char *line = b + i, *tab, *end; long v, off = tx_chr(line, (long)(e - i), '\t');
            tab = off < 0 ? 0 : line + off;
            if (!tab || nrows == MAXROWS) { fprintf(stderr, "cxraw: %s: bad row '%s'\n", BASELINE, line); return -1; }
            *tab = 0; v = strtol(tab + 1, &end, 10);
            if (end == tab + 1 || *end || v < 0) { fprintf(stderr, "cxraw: %s: bad count for %s\n", BASELINE, line); return -1; }
            t = (size_t)off; rows[nrows].path = keep(line, (long)t);
            rows[nrows].count = (int)v; rows[nrows].used = 0; nrows++;
        }
        i = e + 1;
    }
    return 0;                          /* b lives for the process */
}

static Row *find_row(const char *path) {
    int k;
    for (k = 0; k < nrows; k++) if (tx_eq(rows[k].path, path, CAP)) return &rows[k];
    return 0;
}

static int append(char **buf, size_t *len, size_t *cap, const char *s) {
    long n = tx_len(s, CAP); char *t; size_t i;
    if (n < 0) return -1;
    if (*len + (size_t)n + 1 > *cap) {   /* grow by copying into a larger arena block; the old one stays in the arena */
        size_t c = (*len + (size_t)n + 1) * 2;
        t = ar_alloc(arena, (long)c);
        if (!t) return -1;
        for (i = 0; i < *len; i++) t[i] = (*buf)[i];
        *buf = t; *cap = c;
    }
    for (i = 0; i <= (size_t)n; i++) (*buf)[*len + i] = s[i];
    *len += (size_t)n; return 0;
}

/* One `git ls-files -s -z` record, "MODE SHA STAGE<TAB>PATH": the path, or 0 for a tracked symlink
   (mode 120000), whose target is counted once under its own tracked path. */
static char *ls_path(char *rec) {
    static const char link[] = "120000 ";
    int k;
    for (k = 0; link[k] && rec[k] == link[k]; k++) ;
    if (!link[k]) return 0;
    while (*rec && *rec != '\t') rec++;
    return *rec ? rec + 1 : 0;
}

int main(int argc, char **argv) {
    char *list = 0, *cdup = 0, *rec, *p, *end, *out = 0, line[4200]; size_t ln = 0, cl = 0, olen = 0, ocap = 0;
    int check, files = 0, total = 0, over = 0, under = 0, base_total = 0, k, rc;
    arena = ar_new(1L << 32);
    if (!arena) { fprintf(stderr, "cxraw: cannot create the arena\n"); return 2; }
    if (argc != 2 || (!tx_eq(argv[1], "--check", CAP) && !tx_eq(argv[1], "--write", CAP))) {
        fprintf(stderr, "usage: cxraw.cx --check | --write   (from the repo root)\n"); return 2;
    }
    if (count_calls(cxraw_sample, sizeof cxraw_sample - 1) != 1) {
        fprintf(stderr, "cxraw: scanner self-check failed\n");
        return 2;
    }
    check = tx_eq(argv[1], "--check", CAP);
    if (load_layers() < 0) return 2;
    rc = cx_run("git rev-parse --show-cdup", &cdup, &cl);
    if (rc != 0 || !cdup || cl > 1) { fprintf(stderr, "cxraw: run from the repo root\n"); return 2; }
    if (check && load_baseline() < 0) return 2;
    rc = cx_run("git ls-files -s -z -- '*.cx' ':(exclude)archive/'", &list, &ln);   /* archive/ is reference-only */
    if (rc != 0 || !list) { fprintf(stderr, "cxraw: git ls-files failed (rc %d)\n", rc); return 2; }
    if (!check) {
        append(&out, &olen, &ocap, "# tests/cxraw.tsv -- written by tests/cxraw.cx --write.\n");
        append(&out, &olen, &ocap, "# Direct libc/POSIX calls in upper-layer .cx (bottom prefixes: tests/cxraw-layers.tsv).\n");
        append(&out, &olen, &ocap, "# Rows only for counts above 0. Counts only go down (plans/cx-layers.md).\n");
        append(&out, &olen, &ocap, "# path\tcalls\n");
    }
    for (rec = list, end = list + ln; rec < end; rec += tx_len(rec, (long)(end - rec)) + 1) {
        size_t n; char *src; int c; Row *r;
        if (tx_len(rec, (long)(end - rec)) < 0) break;
        if (!(p = ls_path(rec)) || !*p || is_bottom(p)) continue;
        src = cx_read(p, &n);                /* process-lifetime buffer */
        c = src ? count_calls(src, n) : 0;
        files++; total += c;
        if (check) {
            r = find_row(p);
            if (r) r->used = 1;
            if (c > (r ? r->count : 0)) {
                if (r) printf("cxraw: %s has %d calls, baseline %d\n", p, c, r->count);
                else printf("cxraw: %s has %d calls and no baseline row (a new .cx must have 0)\n", p, c);
                over++;
            } else if (r && c < r->count) under++;
        } else if (c > 0) {
            if (cx_fmt(line, sizeof line, "%s\t%d\n", p, c)) { fprintf(stderr, "cxraw: path too long: %s\n", p); return 2; }
            if (append(&out, &olen, &ocap, line) < 0) { fprintf(stderr, "cxraw: out of memory\n"); return 2; }
        }
    }
    if (!check) {
        if (cx_write(BASELINE, out, olen) != 0) { fprintf(stderr, "cxraw: cannot write %s\n", BASELINE); return 2; }
        printf("cxraw: wrote %s: %d .cx files, %d calls\n", BASELINE, files, total);
        return 0;
    }
    for (k = 0; k < nrows; k++) {
        base_total += rows[k].count;
        if (!rows[k].used) printf("cxraw: stale row %s (not a tracked .cx; --write drops it)\n", rows[k].path);
    }
    printf("cxraw: %s: %d .cx files, %d calls (baseline %d); %d above baseline, %d below (--write ratchets down)\n",
           over ? "FAIL" : "ok", files, total, base_total, over, under);
    return over ? 1 : 0;
}
