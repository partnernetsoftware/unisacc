# Programs in c-testsuite that this compiler is not trying to pass, one per
# line: <id> <reason>.  They are counted separately; a knownfail that starts
# PASSING is a failure, so the list cannot rot.
00206  #pragma push_macro/pop_macro is a GCC/MSVC extension, not C99
00104  needs unsigned conversion: `(int32_t)-1 != 0xffffffff` is false in C99, true here
