/* ROOT RUNTIME_MAT NEW_ABS_OUT CASE. One case, caller bound 55.
 * Two re-executions of this actual ELF at bound 18; no successful compile/seal.
 * Controls material eligibility only, never NN execution or cached PASS. */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.riflowmaterial
#pragma unisa use text.text
static char root[4096],mat[4096],work[4096],copydir[4400],product[4400],bound[4400],selfpath[128],selfhash[65];
static const char *leaves[]={"runtime.c","material.tsv","flow-native","flow-native.pending.tsv","flow-native.tsv"};
static int assertions,failures;
static void die(const char *s){fprintf(stderr,"ri-flow-controls: %s errno=%d\n",s,errno);exit(2);}
static void ck(int ok,const char *s){assertions++;if(!ok)failures++;printf("%s\tri-flow-controls.%s\n",ok?"PASS":"FAIL",s);}
static void path(char *p,const char *a,const char *b){int z=snprintf(p,4400,"%s/%s",a,b);if(z<0||z>=4400)die("path bound");}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input absent":"input stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)die("bounded regular input");int fd=open(p,O_RDONLY|O_NONBLOCK|O_NOFOLLOW|O_CLOEXEC);if(fd<0)die("input open");if(fstat(fd,&b)||!S_ISREG(b.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size){close(fd);die("input identity");}*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s){close(fd);die("allocation");}size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);free(s);die("input extent");}at+=(size_t)z;}char c;ssize_t z;do{z=read(fd,&c,1);}while(z<0&&errno==EINTR);int changed=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||changed||closed){free(s);die("input changed or close");}s[*n]=0;return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void put(const char *p,const char *s,size_t n,int fresh,int mode){int fd=open(p,O_WRONLY|O_CLOEXEC|O_NOFOLLOW|(fresh?(O_CREAT|O_EXCL):O_TRUNC),mode);if(fd<0)die("private write open");if(fchmod(fd,(mode_t)mode)){close(fd);die("private output mode");}size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("private write");}at+=(size_t)z;}if(close(fd))die("private close");}
static int inside(const char *p,const char *d){size_t n=strlen(d);return !strncmp(p,d,n)&&(!p[n]||p[n]=='/');}
static void newout(const char *arg){if(arg[0]!='/'||strlen(arg)>=sizeof work||strpbrk(arg,"\r\n\t"))die("absolute new output");char tmp[4096],parent[4096];strcpy(tmp,arg);char *slash=strrchr(tmp,'/');if(!slash||!slash[1]||tx_eqz(slash+1, ".")||tx_eqz(slash+1, ".."))die("output leaf");char leaf[4096];strcpy(leaf,slash+1);if(slash==tmp)slash[1]=0;else *slash=0;if(!realpath(tmp,parent))die("output parent");int z=snprintf(work,sizeof work,"%s%s%s",parent,strcmp(parent,"/")?"/":"",leaf);if(z<0||(size_t)z>=sizeof work||inside(work,mat))die("output overlaps original");if(mkdir(work,0700))die("fresh output required");}
static void states(const char *dir,char h[5][65],int present[5]){for(int i=0;i<5;i++){char p[4400];struct stat st;path(p,dir,leaves[i]);errno=0;if(lstat(p,&st)){if(errno!=ENOENT)die("state stat");present[i]=0;h[i][0]=0;}else{present[i]=1;digest(p,h[i]);}}}
/* proc's executable link deliberately follows the kernel's live image binding;
 * realpath would produce an unusable '(deleted)' memfd name. It is not an input
 * file lookup. Hash the opened executable, never copy it to a cache pathname. */
static void own_image(char h[65]){int fd=open("/proc/self/exe",O_RDONLY|O_CLOEXEC);struct stat a,b;if(fd<0)die("live executable unavailable");if(fstat(fd,&a)||!S_ISREG(a.st_mode)||a.st_size<64||a.st_size>16777216){close(fd);die("live executable extent");}size_t n=(size_t)a.st_size,at=0;char *s=malloc(n);if(!s){close(fd);die("image allocation");}while(at<n){ssize_t z=read(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);free(s);die("live executable read");}at+=(size_t)z;}char c;ssize_t z;do{z=read(fd,&c,1);}while(z<0&&errno==EINTR);int changed=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||changed||closed){free(s);die("live executable changed");}cx_sha256_hex(s,n,h);free(s);}
static void bind_self(void){int z=snprintf(selfpath,sizeof selfpath,"/proc/%ld/exe",(long)getpid());if(z<0||(size_t)z>=sizeof selfpath)die("live executable path bound");struct stat a,b;if(stat("/proc/self/exe",&a)||stat(selfpath,&b)||!S_ISREG(a.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)die("live executable path identity");own_image(selfhash);}
static int profile_child(int argc,char **argv){if(argc!=6)return 2;char actual[65];own_image(actual);if(!tx_eqz(actual, argv[5]))die("child executable differs from parent");char h[65];size_t n;int compile=!strcmp(argv[2],"compile"),seal=!strcmp(argv[2],"seal");if(!compile&&!seal&&!tx_eqz(argv[2], "--verify-native"))return 2;int rc=compile?rfm_compile(argv[3],argv[4],h,&n):seal?rfm_seal(argv[3],argv[4],h,&n):rfm_verify_native(argv[3],argv[4],h,&n);if(rc)return 2;printf("%s\tri-flow-native\tartifact=%s\tbytes=%lu\tflags=%s\t%sno-test-result\n",compile?"COMPILED":seal?"PREPARED":"VERIFIED",h,(unsigned long)n,rfm_flags(),compile?"pending-only\t":"");return 0;}
static np_result invoke(const char *action,const char *dir,const char *label){if(unsetenv("UNISACC_RF_CAPTURE")||unsetenv("UNISA_ATTRIBUTES"))die("clear ambient resources");
 /* /proc/self/exe passed to bound would resolve to bound itself. The still
  * running parent keeps /proc/PARENT/exe and its anonymous image alive. */
 char *v[]={bound,"18",selfpath,"--profile-child",(char *)action,root,(char *)dir,selfhash,0};np_result r;char why[1400],p[4400],name[100],status[100];int error=np_run(v,root,0,20,&r,why,sizeof why);int z=error?snprintf(status,sizeof status,"rc\tUNAVAILABLE\nrunner_error\t1\n"):snprintf(status,sizeof status,"rc\t%d\nrunner_error\t0\n",r.rc);if(z<0||(size_t)z>=sizeof status)die("status extent");snprintf(name,sizeof name,"%s.status",label);path(p,work,name);put(p,status,(size_t)z,1,0600);snprintf(name,sizeof name,"%s.stdout",label);path(p,work,name);put(p,r.out,r.outn,1,0600);snprintf(name,sizeof name,"%s.stderr",label);path(p,work,name);put(p,r.err,r.errn,1,0600);if(error){snprintf(name,sizeof name,"%s.error",label);path(p,work,name);put(p,why,strlen(why),1,0600);np_free(&r);die(why);}return r;}
static int accepted(np_result *r,const char *h,size_t n){char gold[512];int z=snprintf(gold,sizeof gold,"VERIFIED\tri-flow-native\tartifact=%s\tbytes=%lu\tflags=-O2 -b lnx/x86_64 -o -\tno-test-result\n",h,(unsigned long)n);return z>0&&(size_t)z<sizeof gold&&!r->rc&&!r->errn&&r->outn==(size_t)z&&!memcmp(r->out,gold,r->outn);}
static int named(np_result *r,const char *reason,int closure){np_buf b={0};if(closure){np_puts(&b,"changed closure input: ");np_puts(&b,root);np_puts(&b,"/exec/c/core.h\n");}np_puts(&b,"ri-flow-material: REFUSE ");np_puts(&b,reason);np_puts(&b," errno=");int ok=r->errn>b.n+1&&!memcmp(r->err,b.p,b.n)&&r->err[r->errn-1]=='\n';if(ok)for(size_t i=b.n;i+1<r->errn;i++)if(r->err[i]<'0'||r->err[i]>'9')ok=0;free(b.p);return ok;}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN ri-flow-controls requires Linux/x86_64\n",stderr);return 3;
#endif
 if(argc>1&&tx_eqz(argv[1], "--profile-child"))return profile_child(argc,argv);
 if(argc!=5||!realpath(argv[1],root)||!realpath(argv[2],mat))return 2;
 const char *cases[]={"valid","unsealed","elf-flip","pending-flip","final-flip","closure-field","old-v1","recompile","reseal"};int kind=-1;for(int i=0;i<9;i++)if(tx_eqz(argv[4], cases[i]))kind=i;if(kind<0)return 2;
 newout(argv[3]);path(copydir,work,"copy");if(mkdir(copydir,0700))die("private clone directory");path(product,root,"unisacc.com");path(bound,root,"tools/bound");bind_self();printf("EXECUTION_IMAGE\tsha256=%s\tmode=live-parent-proc-exe-no-recompilation\n",selfhash);
 char original[5][65],post[5][65],bootstrap[65],after[65],from[4400],to[4400];int exists0[5],exists1[5];states(mat,original,exists0);for(int i=0;i<5;i++)if(!exists0[i])die("sealed original prerequisite");digest(product,bootstrap);path(from,mat,"flow-native");size_t image_n;char *image=load(from,&image_n);free(image);
 np_result base=invoke("--verify-native",mat,"original");int good=accepted(&base,original[2],image_n);ck(good,"sealed-original-verified");if(!good){if(base.errn)fwrite(base.err,1,base.errn,stderr);np_free(&base);die("original verification prerequisite");}np_free(&base);
 for(int i=0;i<5;i++){size_t n;path(from,mat,leaves[i]);path(to,copydir,leaves[i]);char *s=load(from,&n),h[65];cx_sha256_hex(s,n,h);if(!tx_eqz(h, original[i]))die("original changed while copying");put(to,s,n,1,i==2?0700:0600);free(s);}
 const char *reason="profile phase receipt mismatch",*action="--verify-native";
 if(kind==1||kind==6){path(to,copydir,leaves[4]);if(unlink(to))die("remove private final");reason=kind==1?"input absent":"profile phase receipt mismatch";}
 if(kind>=2&&kind<=4){int i=kind==2?2:kind==3?3:4;path(to,copydir,leaves[i]);size_t n;char *s=load(to,&n);if(n<65)die("mutation extent");s[kind==2?n-1:0]^=1;put(to,s,n,0,i==2?0700:0600);free(s);}
 if(kind==5){path(to,copydir,"material.tsv");size_t n;char *s=load(to,&n);const char *tag="\nexec/c/core.h\t";char *at=strstr(s,tag);if(!at||strstr(at+1,tag))die("unique closure field");at+=strlen(tag);if((size_t)(at-s)+64>=n)die("closure field extent");*at=*at=='0'?'1':'0';put(to,s,n,0,0600);free(s);reason="nine-input C closure changed";}
 /* A former single-step receipt is deliberately ineligible even beside real ELF.
  * It carries no trusted former result and cannot create a v2 final receipt. */
 if(kind==6){path(to,copydir,leaves[3]);const char *old="ri-flow-native-v1\nstatus\tPREPARED\n";put(to,old,strlen(old),0,0600);action="seal";}
 if(kind==7){action="compile";reason="compile requires absent profile outputs";}
 if(kind==8){action="seal";reason="seal refuses existing final receipt";}
 char mutated[5][65];int present[5];states(copydir,mutated,present);np_result r=invoke(action,copydir,"control");if(!kind)ck(accepted(&r,original[2],image_n),"valid-clone-verified");else{ck(r.rc==2,"rejected-rc2");ck(!r.outn,"rejected-empty-stdout");ck(named(&r,reason,kind==5),"exact-named-refusal");}np_free(&r);
 states(copydir,post,exists1);for(int i=0;i<5;i++){char label[100];snprintf(label,sizeof label,"private-%s-not-overwritten",leaves[i]);ck(present[i]==exists1[i]&&(!present[i]||tx_eqz(mutated[i], post[i])),label);}
 states(mat,post,exists1);for(int i=0;i<5;i++){char label[100];snprintf(label,sizeof label,"original-%s-unchanged",leaves[i]);ck(exists1[i]&&tx_eqz(original[i], post[i]),label);}digest(product,after);ck(tx_eqz(bootstrap, after),"raw-root-unchanged");
 puts("TIMING\tstartup_read_verify_output_cold_hot=UNMEASURED");printf("RI_FLOW_CONTROLS\tcase=%s\tassertions=%d\tfailed=%d\tscope=private-profile-eligibility-no-NN-execution\n",argv[4],assertions,failures);return failures?1:0;
}
