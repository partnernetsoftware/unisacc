/* CX-W-7 candidate: host gcc_cx/clang_cx -run behavior. Run from the repo root:
   sh ./unisacc.com tests/cx-host-run.cx
   Builds the two host drivers from tools/cxcc.cx, then runs the same matrix on
   each. Prints PASS/FAIL lines and CX_HOST_RUN<TAB>failed=N. Candidate only:
   it does not mark CX-W-7 effective, install anything, or claim Windows/macOS. */
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use sys.poll
#pragma unisa use mem.heap

static int failed;
static void ck(int ok, const char *name) {
    if (ok) sy_printf("PASS\t%s\n", name);
    else { sy_printf("FAIL\t%s\n", name); failed++; }
}

static int has(const char *s, size_t n, const char *w) {
    size_t wn = tx_len(w, 1L << 20), i;
    if (!s || wn > n) return 0;
    for (i = 0; i + wn <= n; i++) if (tx_same(s + i, (long)wn, w, (long)wn)) return 1;
    return 0;
}

static int write_text(const char *path, const char *text) {
    return cx_write(path, text, (size_t)tx_len(text, 1L << 20));
}

static void fixture(const char *dir) {
    char p[1024];
    tx_snprintf(p, sizeof p, "%s/plain.cx", dir);
    write_text(p, "int main(void) { printf(\"plain\\n\"); return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/helper.cx", dir);
    write_text(p, "#pragma unisa module helper\nint helper_value(void) { return 42; }\n");
    tx_snprintf(p, sizeof p, "%s/mod.cx", dir);
    write_text(p, "#pragma unisa use helper\nint main(void) { printf(\"helper=%d\\n\", helper_value()); return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/args.cx", dir);
    write_text(p, "int main(int argc, char **argv) { int i; for (i = 0; i < argc; i++) printf(\"[%d]=<%s>\\n\", i, argv[i]); return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/envio.cx", dir);
    write_text(p, "int main(void) { char b[64]; char c[256]; if (getcwd(c, sizeof c)) printf(\"cwd=%s\\n\", c); printf(\"env=%s\\n\", getenv(\"W7_ENV\") ? getenv(\"W7_ENV\") : \"missing\"); if (fgets(b, sizeof b, stdin)) printf(\"stdin=%s\", b); fprintf(stderr, \"err-line\\n\"); return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/exit7.cx", dir);
    write_text(p, "int main(void) { return 7; }\n");
    tx_snprintf(p, sizeof p, "%s/exit143.cx", dir);
    write_text(p, "int main(void) { return 143; }\n");
    tx_snprintf(p, sizeof p, "%s/sig15.cx", dir);
    write_text(p, "int main(void) { raise(15); return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/barrier.cx", dir);
    write_text(p, "int main(int argc, char **argv) { char tmp[512]; FILE *f; int i; if (argc < 3) return 3; snprintf(tmp, sizeof tmp, \"%s.tmp.%ld\", argv[1], (long)getpid()); f = fopen(tmp, \"w\"); if (!f) return 4; if (fprintf(f, \"[0]=<%s>\", argv[0]) < 0 || fclose(f) != 0) { remove(tmp); return 4; } if (argc > 4 && strcmp(argv[4], \"nopublish\") == 0) remove(tmp); else if (rename(tmp, argv[1]) != 0) { remove(tmp); return 6; } if (argc > 5) { snprintf(tmp, sizeof tmp, \"%s.tmp.%ld\", argv[5], (long)getpid()); f = fopen(tmp, \"w\"); if (!f) return 4; if (fprintf(f, \"[0]=<%s>\", argv[0]) < 0 || fclose(f) != 0) { remove(tmp); return 4; } if (rename(tmp, argv[5]) != 0) { remove(tmp); return 6; } } for (i = 0; i < (argc > 3 ? atoi(argv[3]) : 2000); i++) { if (access(argv[2], 0) == 0) return 0; usleep(10000); } return 5; }\n");
    tx_snprintf(p, sizeof p, "%s/unk.cx", dir);
    write_text(p, "#pragma unisa nonsense\nint main(void) { return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/unkuse.cx", dir);
    write_text(p, "#pragma unisa use helper\n#pragma unisa nonsense\nint main(void) { return helper_value(); }\n");
    tx_snprintf(p, sizeof p, "%s/wrongstem.cx", dir);
    write_text(p, "#pragma unisa module wrong\nint main(void) { return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/modonly.cx", dir);
    write_text(p, "#pragma unisa module modonly\nint modonly_value(void) { return 5; }\n");
    tx_snprintf(p, sizeof p, "%s/modconsumer.cx", dir);
    write_text(p, "#pragma unisa use modonly\nint main(void) { return modonly_value(); }\n");
    tx_snprintf(p, sizeof p, "%s/late.cx", dir);
    write_text(p, "int x;\n#pragma unisa use helper\nint main(void) { return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/cond.cx", dir);
    write_text(p, "#if 0\n#pragma unisa use helper\n#endif\nint main(void) { return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/cmt1.cx", dir);
    write_text(p, "#pragma/**/ unisa nonsense\nint main(void) { return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/cmt2.cx", dir);
    write_text(p, "#/**/pragma unisa nonsense\nint main(void) { return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/cmtu.cx", dir);
    write_text(p, "#pragma/**/ unisa use helper\n#pragma unisa nonsense\nint main(void) { return helper_value(); }\n");
    tx_snprintf(p, sizeof p, "%s/cmt3.cx", dir);
    write_text(p, "int x; /*\n*/ #pragma unisa nonsense\nint main(void) { return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/cmt4.cx", dir);
    write_text(p, "/*\n#pragma unisa nonsense\n*/\nint main(void) { return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/cmt5.cx", dir);
    write_text(p, "int main(void) { char *s = \"#pragma unisa nonsense\"; (void)s; return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/splice1.cx", dir);
    write_text(p, "#\\\npragma unisa nonsense\nint main(void) { return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/splice2.cx", dir);
    write_text(p, "#pragma \\\nunisa nonsense\nint main(void) { return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/bad.cx", dir);
    write_text(p, "int main(void) { this is not C\n");
    tx_snprintf(p, sizeof p, "%s/declare.cx", dir);
    write_text(p, "int declared(void);\n");
    tx_snprintf(p, sizeof p, "%s/rsp.txt", dir);
    { char body[512]; tx_snprintf(body, sizeof body, "-o %s/rsp-out\n", dir); write_text(p, body); }
}

static int runv(char **v, char **out, size_t *n) { return cx_runv_timeout(v, 20, out, n); }
static int runsh(const char *cmd, char **out, size_t *n) { return cx_run_timeout(cmd, 30, out, n); }

/* 1 when the temp executable named in "[0]=<path>" and its parent directory are gone. */
static int gone_temp(const char *o, size_t n) {
    char p[1024], q[1024];
    size_t i, b = 0, e = 0;
    for (i = 0; i + 4 < n; i++) if (o[i] == '[' && o[i + 1] == '0' && o[i + 2] == ']' && o[i + 3] == '=') { b = i + 4; break; }
    if (!b) return 0;
    if (o[b] == '<') b++;
    e = b;
    while (e < n && o[e] != '>' && o[e] != '\n') e++;
    if (e - b + 1 >= sizeof p) return 0;
    for (i = 0; i < e - b; i++) p[i] = o[b + i];
    p[e - b] = 0;
    for (i = 0; p[i]; i++) if (p[i] == '/') b = i;
    if (!b) return 0;
    for (i = 0; i < b; i++) q[i] = p[i];
    q[b] = 0;
    return sy_exists(p) == 0 && sy_exists(q) == 0;
}

static int temp_path_ok(const char *q) {
    size_t n = (size_t)tx_len(q, 1L << 20), i;
    if (n != 24) return 0;
    if (!tx_prefix(q, (long)n, "/tmp/cxcc-run", 13)) return 0;
    if (!tx_suffix(q, (long)n, "/prog", 5)) return 0;
    for (i = 13; i < 19; i++) if (q[i] == '/') return 0;
    return 1;
}

static void clean_temp_record(const char *file, int *clean) {
    char *x; size_t n; long p, e; char q[512], d[512]; size_t k, j;
    x = cx_read(file, &n);
    if (!x) { *clean = 0; return; }
    p = tx_find(x, (long)n, "[0]=<", 5);
    if (p < 0) { mm_free(x); *clean = 0; return; }
    p += 5; e = p;
    while (e < (long)n && x[e] != '>') e++;
    if (e >= (long)n || e - p + 1 >= (long)sizeof q) { mm_free(x); *clean = 0; return; }
    for (k = 0; k < (size_t)(e - p); k++) q[k] = x[p + (long)k];
    q[e - p] = 0;
    mm_free(x);
    if (!temp_path_ok(q)) { *clean = 0; return; }
    if (sy_unlink(q) != 0) { int e = sy_exists(q); if (e != 0) *clean = 0; }
    k = 0;
    for (j = 0; q[j]; j++) if (q[j] == '/') k = j;
    if (k == 0) { *clean = 0; return; }
    for (j = 0; j < k; j++) d[j] = q[j];
    d[k] = 0;
    if (sy_rmdir(d) != 0) { int e = sy_exists(d); if (e != 0) *clean = 0; }
}

static void drain_fd(int fd) {
    char b[256];
    long budget = 65536;
    if (fd < 0) return;
    while (budget > 0 && sy_readable(fd, 0) > 0) {
        long n = sy_read(fd, b, sizeof b);
        if (n <= 0) break;
        budget -= n;
    }
    sy_close(fd);
}

static void snooze(long ms) { (void)sy_poll(0, 0, ms); }
static int time_before(long deadline) { long n = sy_now_ms(); return n < 0 ? -1 : (n < deadline); }

static int wait_terminal(int pid, long deadline, int *code, int *sig, int *err) {
    int ex = 0, cd = 0, sg = 0;
    long r, now;
    if (err) *err = 0;
    for (;;) {
        now = sy_now_ms();
        if (now < 0) { if (err) *err = (int)now; return -1; }
        if (now >= deadline) break;
        r = sy_wait_status(pid, 1, &ex, &cd, &sg);
        if (r > 0) { if (code) *code = cd; if (sig) *sig = sg; return 1; }
        if (r < 0) { if (err) *err = (int)r; return -1; }
        snooze(20);
    }
    return 0;
}

static int path_state(const char *p) {
    int e = sy_exists(p);
    return e;   /* 1 present, 0 absent, negative I/O error */
}

static int dispose_pid(int pid, int *term_rc, int *kill_rc, int *wait_rc) {
    int p, w = -1;
    if (term_rc) *term_rc = -1;
    if (kill_rc) *kill_rc = -1;
    if (wait_rc) *wait_rc = -1;
    if (pid <= 0) return 0;
    p = (int)sy_getpgid(pid);
    if (term_rc) *term_rc = (p == pid) ? sy_killpg(p, 15) : sy_signal(pid, 15);
    w = wait_terminal(pid, sy_now_ms() + 2000, 0, 0, 0);
    if (w == 0) {
        if (kill_rc) *kill_rc = (p == pid) ? sy_killpg(p, 9) : sy_signal(pid, 9);
        w = wait_terminal(pid, sy_now_ms() + 2000, 0, 0, 0);
    }
    if (wait_rc) *wait_rc = w;
    return w == 1;
}

static void coordinator_spawn_failure(const char *drv, const char *tag, const char *dir, int bad_first) {
    char r1[256], gate[256], bad[256];
    int o1 = -1, e1 = -1, o2 = -1, e2 = -1, pid1, pid2, pg1, g, s, clean = 1;
    tx_snprintf(r1, sizeof r1, "%s/sr1-%s-%d", dir, tag, bad_first);
    tx_snprintf(gate, sizeof gate, "%s/sgate-%s-%d", dir, tag, bad_first);
    tx_snprintf(bad, sizeof bad, "%s/no-such-driver-%s-%d", dir, tag, bad_first);
    ck(path_state(r1) == 0 && path_state(gate) == 0, "spawn-failure-paths-fresh");
    { char src[256]; tx_snprintf(src, sizeof src, "%s/barrier.cx", dir);
      char *v1[] = {bad_first ? bad : (char *)drv, "-run", src, "--", r1, gate, "2000", 0};
      char *v2[] = {bad_first ? (char *)drv : bad, "-run", src, "--", r1, gate, "2000", 0};
      pid1 = sy_spawn_pipe(v1, 0, 8, &o1, &e1);
      pid2 = sy_spawn_pipe(v2, 0, 8, &o2, &e2);
    }
    ck(bad_first ? (pid1 < 0 && pid2 > 0) : (pid1 > 0 && pid2 < 0), "spawn-failure-side");
    { int live = pid1 > 0 ? pid1 : pid2;
      long dl = sy_now_ms() + 3000;
      while (time_before(dl) > 0 && path_state(r1) != 1) snooze(20);
      ck(path_state(r1) == 1, "spawn-failure-path");
      if (live > 0) {
          int p = (int)sy_getpgid(live), tr = -1, kr = -1, wr = -1;
          ck(p == live, "spawn-failure-pgid");
          ck(dispose_pid(live, &tr, &kr, &wr), "spawn-failure-reaped");
          ck(tr == 0, "spawn-failure-term");
          ck(sy_killpg(p, 0) == -ESRCH, "spawn-failure-group-gone");
          sy_printf("SPAWNFAIL\ttr=%d kr=%d wr=%d\n", tr, kr, wr);
      }
    }
    drain_fd(o1); drain_fd(e1); drain_fd(o2); drain_fd(e2);
    clean_temp_record(r1, &clean);
    ck(clean == 1 && path_state(gate) == 0, "spawn-failure-clean");
}

static int temp_record_gone(const char *file) {
    char *x; size_t n; long p, e; char q[512]; size_t k;
    x = cx_read(file, &n);
    if (!x) return 0;
    p = tx_find(x, (long)n, "[0]=<", 5);
    if (p < 0) { mm_free(x); return 0; }
    p += 5; e = p;
    while (e < (long)n && x[e] != '>') e++;
    if (e >= (long)n || e - p + 1 >= (long)sizeof q) { mm_free(x); return 0; }
    for (k = 0; k < (size_t)(e - p); k++) q[k] = x[p + (long)k];
    q[e - p] = 0;
    mm_free(x);
    return temp_path_ok(q) && path_state(q) == 0;
}

static void coordinator_case(const char *drv, const char *tag, const char *dir) {
    char r1[256], r2[256], gate[256], f2[256];
    int o1 = -1, e1 = -1, o2 = -1, e2 = -1, pid1, pid2, pg1 = -1, pg2 = -1;
    int badpg, timeout = 1, expired = 0, k1 = -99, k2 = -99, s1 = 0, s2 = 0;
    int c1 = -1, c2 = -1, sg1 = -1, sg2 = -1, er1 = 0, er2 = 0;
    int g1 = 2, g2 = 2, clean = 1, fr1, fr2, fg, seen1 = 0, seen2 = 0, seenf = 0;
    long deadline;
    tx_snprintf(r1, sizeof r1, "%s/cr1-%s", dir, tag);
    tx_snprintf(r2, sizeof r2, "%s/cr2-%s", dir, tag);
    tx_snprintf(gate, sizeof gate, "%s/cgate-%s", dir, tag);
    tx_snprintf(f2, sizeof f2, "%s/cf2-%s", dir, tag);
    fr1 = path_state(r1); fr2 = path_state(r2); fg = path_state(gate); seenf = path_state(f2);
    ck(fr1 == 0 && fr2 == 0 && fg == 0 && seenf == 0, "coordinator-paths-fresh");
    { char src[256]; tx_snprintf(src, sizeof src, "%s/barrier.cx", dir);
      char *v1[] = {(char *)drv, "-run", src, "--", r1, gate, "2000", 0};
      char *v2[] = {(char *)drv, "-run", src, "--", r2, gate, "2000", "nopublish", f2, 0};
      pid1 = sy_spawn_pipe(v1, 0, 8, &o1, &e1);
      pid2 = sy_spawn_pipe(v2, 0, 8, &o2, &e2);
    }
    if (pid1 <= 0 || pid2 <= 0) {
        long pg;
        ck(0, "coordinator-spawn");
        if (pid1 > 0) {
            pg = sy_getpgid(pid1);
            if (pg == (long)pid1) sy_killpg((int)pg, 15); else sy_signal(pid1, 15);
            { int w = wait_terminal(pid1, sy_now_ms() + 2000, 0, 0, 0); if (w == 0) { if (pg == (long)pid1) sy_killpg((int)pg, 9); else sy_signal(pid1, 9); wait_terminal(pid1, sy_now_ms() + 2000, 0, 0, 0); } }
        }
        if (pid2 > 0) {
            pg = sy_getpgid(pid2);
            if (pg == (long)pid2) sy_killpg((int)pg, 15); else sy_signal(pid2, 15);
            { int w = wait_terminal(pid2, sy_now_ms() + 2000, 0, 0, 0); if (w == 0) { if (pg == (long)pid2) sy_killpg((int)pg, 9); else sy_signal(pid2, 9); wait_terminal(pid2, sy_now_ms() + 2000, 0, 0, 0); } }
        }
        if (o1 >= 0) sy_close(o1); if (e1 >= 0) sy_close(e1);
        if (o2 >= 0) sy_close(o2); if (e2 >= 0) sy_close(e2);
        return;
    }
    pg1 = (int)sy_getpgid(pid1);
    pg2 = (int)sy_getpgid(pid2);
    badpg = !(pg1 == pid1 && pg2 == pid2);
    { long t0 = sy_now_ms();
      deadline = t0 + 5000;
      int lived = 1, dual = 0;
      while (time_before(deadline) > 0) {
          int e;
          if (!seen1) { e = path_state(r1); if (e == 1) seen1 = 1; else if (e < 0) break; }
          if (!seen2) { e = path_state(r2); if (e == 1) seen2 = 1; else if (e < 0) break; }
          if (!seenf) { e = path_state(f2); if (e == 1) seenf = 1; else if (e < 0) break; }
          /* Dual-ready is r1+f2, not r1+r2. Do not end the wait when those two appear. */
          if (seen1 && seenf && badpg == 0) {
              dual = 1;
              if (sy_killpg(pg1, 0) != 0 || sy_killpg(pg2, 0) != 0) lived = 0;
          }
          if (seen1 && seen2) break;
          snooze(20);
      }
      expired = (sy_now_ms() >= t0 + 5000);
      timeout = 0;
      if (badpg == 0 && expired && dual && lived && seen1 && seenf && !seen2
          && path_state(r2) == 0
          && sy_killpg(pg1, 0) == 0 && sy_killpg(pg2, 0) == 0)
          timeout = 1;
    }
    if (timeout == 1) {
        k1 = sy_killpg(pg1, 15);
        k2 = sy_killpg(pg2, 15);
    } else if (badpg != 0) {
        k1 = sy_signal(pid1, 15);
        k2 = sy_signal(pid2, 15);
    } else {
        k1 = sy_signal(pid1, 15);
        k2 = sy_signal(pid2, 15);
    }
    deadline = sy_now_ms() + 5000;
    s1 = wait_terminal(pid1, deadline, &c1, &sg1, &er1);
    s2 = wait_terminal(pid2, deadline, &c2, &sg2, &er2);
    if (s1 == 0) {
        int kr = (badpg == 0) ? sy_killpg(pg1, 9) : sy_signal(pid1, 9);
        s1 = wait_terminal(pid1, sy_now_ms() + 3000, &c1, &sg1, &er1);
        if (kr != 0 && s1 != 1) er1 = kr;
    }
    if (s2 == 0) {
        int kr = (badpg == 0) ? sy_killpg(pg2, 9) : sy_signal(pid2, 9);
        s2 = wait_terminal(pid2, sy_now_ms() + 3000, &c2, &sg2, &er2);
        if (kr != 0 && s2 != 1) er2 = kr;
    }
    if (badpg == 0) {
        int r = sy_killpg(pg1, 0);
        g1 = (r == -ESRCH) ? 0 : (r == 0 ? 1 : 2);
        r = sy_killpg(pg2, 0);
        g2 = (r == -ESRCH) ? 0 : (r == 0 ? 1 : 2);
    }
    drain_fd(o1); drain_fd(e1); drain_fd(o2); drain_fd(e2);
    clean_temp_record(r1, &clean);
    clean_temp_record(f2, &clean);
    ck(timeout == 1 && expired, "coordinator-timeout");
    ck(badpg == 0, "coordinator-pgid");
    ck(k1 == 0 && k2 == 0, "coordinator-kill");
    ck(s1 == 1 && s2 == 1 && er1 == 0 && er2 == 0, "coordinator-reaped");
    ck(g1 == 0 && g2 == 0, "coordinator-groups-gone");
    ck(clean == 1, "coordinator-controller-clean");
    ck(path_state(gate) == 0, "coordinator-no-gate");
    sy_printf("COORD\tc1=%d sg1=%d c2=%d sg2=%d\n", c1, sg1, c2, sg2);
}

/* Positive: both publications (r1 and r2) appear before the deadline. Open the gate and let them exit. Not a timeout. */
static void coordinator_release_case(const char *drv, const char *tag, const char *dir) {
    char r1[256], r2[256], gate[256];
    int o1 = -1, e1 = -1, o2 = -1, e2 = -1, pid1, pid2, pg1 = -1, pg2 = -1;
    int seen1 = 0, seen2 = 0, s1 = 0, s2 = 0, c1 = -1, c2 = -1, er1 = 0, er2 = 0;
    long deadline, t0;
    tx_snprintf(r1, sizeof r1, "%s/rr1-%s", dir, tag);
    tx_snprintf(r2, sizeof r2, "%s/rr2-%s", dir, tag);
    tx_snprintf(gate, sizeof gate, "%s/rgate-%s", dir, tag);
    ck(path_state(r1) == 0 && path_state(r2) == 0 && path_state(gate) == 0, "release-paths-fresh");
    { char src[256]; tx_snprintf(src, sizeof src, "%s/barrier.cx", dir);
      char *v1[] = {(char *)drv, "-run", src, "--", r1, gate, "2000", 0};
      char *v2[] = {(char *)drv, "-run", src, "--", r2, gate, "2000", 0};
      pid1 = sy_spawn_pipe(v1, 0, 8, &o1, &e1);
      pid2 = sy_spawn_pipe(v2, 0, 8, &o2, &e2);
    }
    if (pid1 <= 0 || pid2 <= 0) {
        ck(0, "coordinator-release");
        if (pid1 > 0) { int p = (int)sy_getpgid(pid1), w; if (p == pid1) (void)sy_killpg(p, 15); else (void)sy_signal(pid1, 15); w = wait_terminal(pid1, sy_now_ms() + 2000, 0, 0, 0); if (w == 0) { if (p == pid1) (void)sy_killpg(p, 9); else (void)sy_signal(pid1, 9); wait_terminal(pid1, sy_now_ms() + 2000, 0, 0, 0); } }
        if (pid2 > 0) { int p = (int)sy_getpgid(pid2), w; if (p == pid2) (void)sy_killpg(p, 15); else (void)sy_signal(pid2, 15); w = wait_terminal(pid2, sy_now_ms() + 2000, 0, 0, 0); if (w == 0) { if (p == pid2) (void)sy_killpg(p, 9); else (void)sy_signal(pid2, 9); wait_terminal(pid2, sy_now_ms() + 2000, 0, 0, 0); } }
        drain_fd(o1); drain_fd(e1); drain_fd(o2); drain_fd(e2);
        return;
    }
    pg1 = (int)sy_getpgid(pid1);
    pg2 = (int)sy_getpgid(pid2);
    t0 = sy_now_ms();
    deadline = t0 + 5000;
    while (time_before(deadline) > 0 && !(seen1 && seen2)) {
        int e;
        if (!seen1) { e = path_state(r1); if (e == 1) seen1 = 1; else if (e < 0) break; }
        if (!seen2) { e = path_state(r2); if (e == 1) seen2 = 1; else if (e < 0) break; }
        snooze(20);
    }
    if (seen1 && seen2 && sy_now_ms() < t0 + 5000 && pg1 == pid1 && pg2 == pid2
        && sy_killpg(pg1, 0) == 0 && sy_killpg(pg2, 0) == 0 && write_text(gate, "go\n") == 0) {
        s1 = wait_terminal(pid1, sy_now_ms() + 5000, &c1, 0, &er1);
        s2 = wait_terminal(pid2, sy_now_ms() + 5000, &c2, 0, &er2);
        if (s1 == 0) { if (pg1 == pid1) (void)sy_killpg(pg1, 9); else (void)sy_signal(pid1, 9); s1 = wait_terminal(pid1, sy_now_ms() + 2000, &c1, 0, &er1); }
        if (s2 == 0) { if (pg2 == pid2) (void)sy_killpg(pg2, 9); else (void)sy_signal(pid2, 9); s2 = wait_terminal(pid2, sy_now_ms() + 2000, &c2, 0, &er2); }
        ck(s1 == 1 && s2 == 1 && c1 == 0 && c2 == 0 && er1 == 0 && er2 == 0, "coordinator-release");
        ck(sy_killpg(pg1, 0) == -ESRCH && sy_killpg(pg2, 0) == -ESRCH, "coordinator-release-gone");
    } else {
        ck(0, "coordinator-release");
        if (pg1 == pid1) sy_killpg(pg1, 9); else sy_signal(pid1, 9);
        if (pg2 == pid2) sy_killpg(pg2, 9); else sy_signal(pid2, 9);
        wait_terminal(pid1, sy_now_ms() + 2000, 0, 0, 0);
        wait_terminal(pid2, sy_now_ms() + 2000, 0, 0, 0);
    }
    if (o1 >= 0) sy_close(o1); if (e1 >= 0) sy_close(e1);
    if (o2 >= 0) sy_close(o2); if (e2 >= 0) sy_close(e2);
    ck(temp_record_gone(r1) && temp_record_gone(r2), "coordinator-release-clean");
}

static void matrix(const char *drv, const char *tag, const char *cc, const char *dir) {
    char p[1024], q[1024], r[1024], cmd[4096];
    char *o = 0; size_t n = 0; int rc;
    char *v[16];
    char name[128];

    tx_snprintf(name, sizeof name, "%s.no-use", tag);
    v[0] = (char *)drv; v[1] = "-run"; tx_snprintf(p, sizeof p, "%s/plain.cx", dir); v[2] = p; v[3] = 0;
    o = 0; n = 0; rc = runv(v, &o, &n);
    ck(rc == 0 && has(o, n, "plain"), name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.use", tag);
    v[0] = (char *)drv; v[1] = "-run"; tx_snprintf(p, sizeof p, "%s/mod.cx", dir); v[2] = p; v[3] = 0;
    o = 0; n = 0; rc = runv(v, &o, &n);
    ck(rc == 0 && has(o, n, "helper=42"), name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.args", tag);
    v[0] = (char *)drv; v[1] = "-run"; tx_snprintf(p, sizeof p, "%s/args.cx", dir); v[2] = p; v[3] = "--";
    v[4] = ""; v[5] = "a b"; v[6] = "q\"x"; v[7] = "back\\slash"; v[8] = "--"; v[9] = "-o";
    v[10] = "-run"; v[11] = "@file"; v[12] = 0;
    o = 0; n = 0; rc = runv(v, &o, &n);
    ck(rc == 0 && has(o, n, "[1]=<>") && has(o, n, "[2]=<a b>") && has(o, n, "[3]=<q\"x>") &&
       has(o, n, "[4]=<back\\slash>") && has(o, n, "[5]=<-->") && has(o, n, "[6]=<-o>") &&
       has(o, n, "[7]=<-run>") && has(o, n, "[8]=<@file>"), name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.exit7", tag);
    v[0] = (char *)drv; v[1] = "-run"; tx_snprintf(p, sizeof p, "%s/exit7.cx", dir); v[2] = p; v[3] = 0;
    o = 0; n = 0; rc = runv(v, &o, &n);
    ck(rc == 7, name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.exit143-no-signal-line", tag);
    tx_snprintf(cmd, sizeof cmd, "%s -run %s/exit143.cx >%s/e141.out 2>%s/e141.err", drv, dir, dir, dir);
    rc = runsh(cmd, 0, 0);
    tx_snprintf(p, sizeof p, "%s/e141.err", dir);
    o = cx_read(p, &n);
    ck(rc == 143 && o && n == 0, name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.sig15-line", tag);
    tx_snprintf(cmd, sizeof cmd, "%s -run %s/sig15.cx >%s/s15.out 2>%s/s15.err", drv, dir, dir, dir);
    rc = runsh(cmd, 0, 0);
    tx_snprintf(p, sizeof p, "%s/s15.err", dir);
    o = cx_read(p, &n);
    tx_snprintf(q, sizeof q, "%s_cx: program killed by signal 15\n", tag);
    ck(rc == 143 && o && n == (size_t)tx_len(q, 1L << 20) &&
       tx_same(o, (long)n, q, tx_len(q, 1L << 20)), name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.env-io-cwd", tag);
    tx_snprintf(cmd, sizeof cmd, "printf 'stdin-line\\n' | W7_ENV=env-ok %s -run %s/envio.cx >%s/env.out 2>%s/env.err", drv, dir, dir, dir);
    rc = runsh(cmd, 0, 0);
    tx_snprintf(p, sizeof p, "%s/env.out", dir);
    o = cx_read(p, &n);
    ck(rc == 0 && has(o, n, "env=env-ok") && has(o, n, "stdin=stdin-line") && has(o, n, "cwd="), name);
    mm_free(o);
    tx_snprintf(p, sizeof p, "%s/env.err", dir);
    o = cx_read(p, &n);
    ck(o && has(o, n, "err-line"), "env-io-stderr");
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.compile-fail-clean", tag);
    tx_snprintf(cmd, sizeof cmd, "%s -run %s/bad.cx 2>&1", drv, dir);
    o = 0; n = 0; rc = runsh(cmd, &o, &n);
    ck(rc != 0 && rc != 2 && has(o, n, "error"), name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.conflicts", tag);
    { int ok = 1;
      char out[256], rsp[256];
      const char *fixed[][2] = {
        {"-c", "-c"}, {"-E", "-E"}, {"-S", "-S"}, {"-shared", "-shared"}
      };
      size_t k;
      tx_snprintf(out, sizeof out, "%s/conflict-out", dir);
      tx_snprintf(rsp, sizeof rsp, "%s/rsp-out", dir);
      if (sy_exists(out) != 0 || sy_exists(rsp) != 0) ok = 0;
      for (k = 0; k < 5 + sizeof fixed / sizeof fixed[0]; k++) {
        if (k == 0) tx_snprintf(cmd, sizeof cmd, "%s -run -o %s %s/plain.cx 2>&1", drv, out, dir);
        else if (k == 1) tx_snprintf(cmd, sizeof cmd, "%s -run -o%s %s/plain.cx 2>&1", drv, out, dir);
        else if (k == 2) tx_snprintf(cmd, sizeof cmd, "%s -run -Wl,--output=%s %s/plain.cx 2>&1", drv, out, dir);
        else if (k == 3) tx_snprintf(cmd, sizeof cmd, "%s -run -Xlinker --output=%s %s/plain.cx 2>&1", drv, out, dir);
        else if (k == 4) tx_snprintf(cmd, sizeof cmd, "%s -run @%s/rsp.txt %s/plain.cx 2>&1", drv, dir, dir);
        else tx_snprintf(cmd, sizeof cmd, "%s -run %s %s/plain.cx 2>&1", drv, fixed[k - 5][0], dir);
        o = 0; n = 0; rc = runsh(cmd, &o, &n);
        if (rc != 2) ok = 0;
        if (k == 0 || k == 1) { if (!has(o, n, "output override")) ok = 0; }
        else if (k == 2 || k == 3) { if (!has(o, n, "linker options")) ok = 0; }
        else if (k == 4) { if (!has(o, n, "response files")) ok = 0; }
        else if (!has(o, n, fixed[k - 5][1])) ok = 0;
        mm_free(o);
      }
      if (sy_exists(out) != 0 || sy_exists(rsp) != 0) ok = 0;
      ck(ok, name);
    }

    tx_snprintf(name, sizeof name, "%s.pragma-unknown-no-use", tag);
    { char f[256], o2[256];
      tx_snprintf(f, sizeof f, "%s/unk.cx", dir);
      tx_snprintf(o2, sizeof o2, "%s/pu1.out", dir);
      tx_snprintf(cmd, sizeof cmd, "%s %s -o %s 2>&1; echo W7RC:$?", drv, f, o2);
      o = 0; n = 0; rc = runsh(cmd, &o, &n);
      ck(rc == 0 && !tx_suffix(o, (long)n, "W7RC:0\n", 7) &&
         has(o, n, "unknown unisa pragma") && sy_exists(o2) == 0, name);
      mm_free(o);
    }
    tx_snprintf(name, sizeof name, "%s.pragma-unknown-with-use", tag);
    { char f[256], o2[256];
      tx_snprintf(f, sizeof f, "%s/unkuse.cx", dir);
      tx_snprintf(o2, sizeof o2, "%s/pu2.out", dir);
      tx_snprintf(cmd, sizeof cmd, "%s %s -o %s 2>&1; echo W7RC:$?", drv, f, o2);
      o = 0; n = 0; rc = runsh(cmd, &o, &n);
      ck(rc == 0 && !tx_suffix(o, (long)n, "W7RC:0\n", 7) &&
         has(o, n, "unknown unisa pragma") && sy_exists(o2) == 0, name);
      mm_free(o);
    }
    tx_snprintf(name, sizeof name, "%s.pragma-module-stem", tag);
    { char f[256], o2[256];
      tx_snprintf(f, sizeof f, "%s/wrongstem.cx", dir);
      tx_snprintf(o2, sizeof o2, "%s/pu3.out", dir);
      tx_snprintf(cmd, sizeof cmd, "%s %s -o %s 2>&1; echo W7RC:$?", drv, f, o2);
      o = 0; n = 0; rc = runsh(cmd, &o, &n);
      ck(rc == 0 && !tx_suffix(o, (long)n, "W7RC:0\n", 7) &&
         has(o, n, "is not the file stem") && sy_exists(o2) == 0, name);
      mm_free(o);
    }
    tx_snprintf(name, sizeof name, "%s.pragma-module-object", tag);
    { char f[256], o2[256]; char *vv[6];
      tx_snprintf(f, sizeof f, "%s/modonly.cx", dir);
      tx_snprintf(o2, sizeof o2, "%s/pu4.o", dir);
      vv[0] = (char *)drv; vv[1] = "-c"; vv[2] = f; vv[3] = "-o"; vv[4] = o2; vv[5] = 0;
      o = 0; n = 0; rc = runv(vv, &o, &n);
      ck(rc == 0 && sy_exists(o2) == 1, name);
      mm_free(o);
    }
    tx_snprintf(name, sizeof name, "%s.pragma-module-consumer", tag);
    { char f[256], o2[256]; char *vv[6];
      tx_snprintf(f, sizeof f, "%s/modconsumer.cx", dir);
      tx_snprintf(o2, sizeof o2, "%s/pu4.bin", dir);
      vv[0] = (char *)drv; vv[1] = f; vv[2] = "-o"; vv[3] = o2; vv[4] = 0;
      o = 0; n = 0; rc = runv(vv, &o, &n);
      ck(rc == 0 && sy_exists(o2) == 1, name);
      mm_free(o);
      { char *xv[2]; xv[0] = o2; xv[1] = 0; o = 0; n = 0; rc = runv(xv, &o, &n); ck(rc == 5, "pragma-module-consumer-runs"); mm_free(o); }
    }
    tx_snprintf(name, sizeof name, "%s.pragma-after-declaration", tag);
    { char f[256], o2[256];
      tx_snprintf(f, sizeof f, "%s/late.cx", dir);
      tx_snprintf(o2, sizeof o2, "%s/pu5.out", dir);
      tx_snprintf(cmd, sizeof cmd, "%s %s -o %s 2>&1; echo W7RC:$?", drv, f, o2);
      o = 0; n = 0; rc = runsh(cmd, &o, &n);
      ck(rc == 0 && !tx_suffix(o, (long)n, "W7RC:0\n", 7) &&
         has(o, n, "after first declaration") && sy_exists(o2) == 0, name);
      mm_free(o);
    }
    tx_snprintf(name, sizeof name, "%s.pragma-conditional", tag);
    { char f[256], o2[256];
      tx_snprintf(f, sizeof f, "%s/cond.cx", dir);
      tx_snprintf(o2, sizeof o2, "%s/pu6.out", dir);
      tx_snprintf(cmd, sizeof cmd, "%s %s -o %s 2>&1; echo W7RC:$?", drv, f, o2);
      o = 0; n = 0; rc = runsh(cmd, &o, &n);
      ck(rc == 0 && !tx_suffix(o, (long)n, "W7RC:0\n", 7) &&
         has(o, n, "inside conditional") && sy_exists(o2) == 0, name);
      mm_free(o);
    }

    { const char *cf[] = {"cmt1.cx", "cmt2.cx", "cmtu.cx"};
      const char *cn[] = {"pragma-comment-before-unisa", "pragma-comment-after-hash", "pragma-comment-with-use"};
      int ci;
      for (ci = 0; ci < 3; ci++) {
        char f[256], o2[256];
        tx_snprintf(name, sizeof name, "%s.%s", tag, cn[ci]);
        tx_snprintf(f, sizeof f, "%s/%s", dir, cf[ci]);
        tx_snprintf(o2, sizeof o2, "%s/pc%d.out", dir, ci);
        tx_snprintf(cmd, sizeof cmd, "%s %s -o %s 2>&1; echo W7RC:$?", drv, f, o2);
        o = 0; n = 0; rc = runsh(cmd, &o, &n);
        ck(rc == 0 && !tx_suffix(o, (long)n, "W7RC:0\n", 7) &&
           has(o, n, "unknown unisa pragma") && sy_exists(o2) == 0, name);
        mm_free(o);
      }
    }

    { const char *cf[] = {"cmt3.cx", "cmt4.cx", "cmt5.cx"};
      const char *cn[] = {"pragma-after-cross-line-comment", "pragma-inside-block-comment", "pragma-in-string"};
      int ci;
      for (ci = 0; ci < 3; ci++) {
        char f[256], o2[256];
        tx_snprintf(name, sizeof name, "%s.%s", tag, cn[ci]);
        tx_snprintf(f, sizeof f, "%s/%s", dir, cf[ci]);
        tx_snprintf(o2, sizeof o2, "%s/pd%d.out", dir, ci);
        tx_snprintf(cmd, sizeof cmd, "%s %s -o %s 2>&1; echo W7RC:$?", drv, f, o2);
        o = 0; n = 0; rc = runsh(cmd, &o, &n);
        if (ci == 0) ck(rc == 0 && !tx_suffix(o, (long)n, "W7RC:0\n", 7) && has(o, n, "after first declaration") && sy_exists(o2) == 0, name);
        else ck(rc == 0 && tx_suffix(o, (long)n, "W7RC:0\n", 7) && sy_exists(o2) == 1, name);
        mm_free(o);
      }
    }

    { const char *cf[] = {"splice1.cx", "splice2.cx"};
      const char *cn[] = {"pragma-splice-hash", "pragma-splice-unisa"};
      int ci;
      for (ci = 0; ci < 2; ci++) {
        char f[256], o2[256];
        tx_snprintf(name, sizeof name, "%s.%s", tag, cn[ci]);
        tx_snprintf(f, sizeof f, "%s/%s", dir, cf[ci]);
        tx_snprintf(o2, sizeof o2, "%s/ps%d.out", dir, ci);
        tx_snprintf(cmd, sizeof cmd, "%s %s -o %s 2>&1; echo W7RC:$?", drv, f, o2);
        o = 0; n = 0; rc = runsh(cmd, &o, &n);
        ck(rc == 0 && !tx_suffix(o, (long)n, "W7RC:0\n", 7) &&
           has(o, n, "unknown unisa pragma") && sy_exists(o2) == 0, name);
        mm_free(o);
      }
    }

    tx_snprintf(name, sizeof name, "%s.two-sources", tag);
    tx_snprintf(cmd, sizeof cmd, "%s -run %s/plain.cx %s/exit7.cx 2>&1", drv, dir, dir);
    o = 0; n = 0; rc = runsh(cmd, &o, &n);
    ck(rc == 2 && has(o, n, "one .cx main file"), name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.include-values", tag);
    v[0] = (char *)drv; v[1] = "-run"; v[2] = "-include"; tx_snprintf(p, sizeof p, "%s/declare.cx", dir); v[3] = p;
    tx_snprintf(q, sizeof q, "-I%s", dir); v[4] = q; tx_snprintf(r, sizeof r, "%s/plain.cx", dir); v[5] = r; v[6] = 0;
    o = 0; n = 0; rc = runv(v, &o, &n);
    ck(rc == 0 && has(o, n, "plain"), name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.oFILE-and-I-value", tag);
    tx_snprintf(cmd, sizeof cmd, "%s -run -oZ -I %s/inc.cx %s/plain.cx 2>&1", drv, dir, dir);
    o = 0; n = 0; rc = runsh(cmd, &o, &n);
    ck(rc == 2 && has(o, n, "output override"), name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.fake-compiler-cleanup", tag);
    { char fd[256], script[1024], mark[256], body[1024];
      tx_snprintf(fd, sizeof fd, "%s/fake-%s", dir, cc);
      tx_snprintf(script, sizeof script, "%s/%s", fd, cc);
      tx_snprintf(mark, sizeof mark, "%s/fake-%s.mark", dir, cc);
      { char c[512]; tx_snprintf(c, sizeof c, "mkdir -p %s", fd); runsh(c, 0, 0); }
      tx_snprintf(body, sizeof body,
        "#!/bin/sh\n[ -n \"$STARTED\" ] && printf started > \"$STARTED\"\nout=\nprev=\nfor a in \"$@\"; do\n"
        "  if [ \"$prev\" = \"-o\" ]; then out=$a; fi\n"
        "  case $a in -o*) out=${a#-o};; esac\n  prev=$a\ndone\n"
        "[ -n \"$out\" ] && printf x > \"$out\"\nprintf '%%s\\n' \"$out\" > \"$MARK\"\nexit 9\n");
      write_text(script, body);
      sy_chmod(script, 0755);
      tx_snprintf(cmd, sizeof cmd, "MARK=%s PATH=%s:$PATH %s -run %s/plain.cx >/dev/null 2>&1; echo W7RC:$?", mark, fd, drv, dir);
      o = 0; n = 0; rc = runsh(cmd, &o, &n);
      ck(rc == 0 && tx_suffix(o, (long)n, "W7RC:9\n", 7), name);
      mm_free(o);
      o = cx_read(mark, &n);
      { char parent[256]; size_t i, b = 0;
        for (i = 0; o && i < n && o[i] != '\n'; i++) { if (o[i] == '/') b = i; }
        if (o && b > 1 && b < sizeof parent) {
          for (i = 0; i < b; i++) parent[i] = o[i];
          parent[b] = 0;
          o[b] = 0;
          ck(sy_exists(o) == 0 && sy_exists(parent) == 0, "fake-compiler-target-gone");
        } else ck(0, "fake-compiler-target-gone");
      }
      mm_free(o);
    }

    tx_snprintf(name, sizeof name, "%s.response-as-option-value", tag);
    { char fd[256], script[1024], started[256];
      tx_snprintf(fd, sizeof fd, "%s/fake-%s", dir, cc);
      tx_snprintf(script, sizeof script, "%s/%s", fd, cc);
      tx_snprintf(started, sizeof started, "%s/fake-%s.started", dir, cc);
      tx_snprintf(cmd, sizeof cmd,
                  "STARTED=%s MARK=%s.mark2 PATH=%s:$PATH %s -run -I @%s/rsp.txt %s/plain.cx 2>&1; echo W7RC:$?",
                  started, started, fd, drv, dir, dir);
      o = 0; n = 0; rc = runsh(cmd, &o, &n);
      ck(rc == 0 && has(o, n, "response file") && tx_suffix(o, (long)n, "W7RC:2\n", 7) &&
         sy_exists(started) == 0, name);
      mm_free(o);
      tx_snprintf(cmd, sizeof cmd,
                  "STARTED=%s MARK=%s.mark3 PATH=%s:$PATH %s -run -include @%s/rsp.txt %s/plain.cx 2>&1; echo W7RC:$?",
                  started, started, fd, drv, dir, dir);
      o = 0; n = 0; rc = runsh(cmd, &o, &n);
      ck(rc == 0 && has(o, n, "response file") && tx_suffix(o, (long)n, "W7RC:2\n", 7) &&
         sy_exists(started) == 0, "response-as-include-value");
      mm_free(o);
    }

    tx_snprintf(name, sizeof name, "%s.concurrent-barrier-clean", tag);
    { char r1[256], r2[256], gate[256];
      tx_snprintf(r1, sizeof r1, "%s/w7r1-%s", dir, tag);
      tx_snprintf(r2, sizeof r2, "%s/w7r2-%s", dir, tag);
      tx_snprintf(gate, sizeof gate, "%s/w7gate-%s", dir, tag);
      ck(sy_exists(r1) == 0 && sy_exists(r2) == 0 && sy_exists(gate) == 0, "barrier-paths-fresh");
      tx_snprintf(cmd, sizeof cmd,
        "( setsid -w %s -run %s/barrier.cx -- %s %s >%s/c1.out 2>%s/c1.err ) & a=$!; "
        "( setsid -w %s -run %s/barrier.cx -- %s %s >%s/c2.out 2>%s/c2.err ) & b=$!; "
        "n=0; while [ ! -f %s ] || [ ! -f %s ]; do n=$((n+1)); [ $n -gt 200 ] && break; kill -0 $a 2>/dev/null && kill -0 $b 2>/dev/null || break; sleep 0.1; done; "
        "ok=0; if [ $n -le 200 ] && [ -f %s ] && [ -f %s ] && kill -0 $a 2>/dev/null && kill -0 $b 2>/dev/null; then "
        "  : > %s; ok=1; else kill -TERM $a $b 2>/dev/null; fi; "
        "wait $a; e1=$?; wait $b; e2=$?; echo W7R1:$e1; echo W7R2:$e2; echo W7OK:$ok",
        drv, dir, r1, gate, dir, dir, drv, dir, r2, gate, dir, dir, r1, r2, r1, r2, gate);
      o = 0; n = 0; rc = runsh(cmd, &o, &n);
      { size_t on = n; char *a = cx_read(r1, &n); size_t an = n; char *b;
        n = 0; b = cx_read(r2, &n); size_t bn = n;
        ck(rc == 0 && tx_suffix(o, (long)on, "W7R1:0\nW7R2:0\nW7OK:1\n", 21) &&
           a && b && an > 1 && bn > 1 && !(an == bn && tx_same(a, (long)an, b, (long)bn)) &&
           gone_temp(a, an) && gone_temp(b, bn), name);
        mm_free(a); mm_free(b); }
      mm_free(o);
    }

    tx_snprintf(name, sizeof name, "%s.barrier-one-side-timeout", tag);
    { char r1[256], gate[256];
      tx_snprintf(r1, sizeof r1, "%s/w7one-%s", dir, tag);
      tx_snprintf(gate, sizeof gate, "%s/w7oneg-%s", dir, tag);
      ck(sy_exists(r1) == 0 && sy_exists(gate) == 0, "one-side-paths-fresh");
      tx_snprintf(cmd, sizeof cmd,
        "( setsid -w %s -run %s/barrier.cx -- %s %s 100 >%s/one.out 2>%s/one.err ) & a=$!; "
        "n=0; while kill -0 $a 2>/dev/null && [ $n -lt 200 ]; do n=$((n+1)); sleep 0.1; done; "
        "wait $a; e1=$?; echo W7R1:$e1; echo W7OK:0",
        drv, dir, r1, gate, dir, dir);
      o = 0; n = 0; rc = runsh(cmd, &o, &n);
      { size_t on = n; char *a = cx_read(r1, &n); size_t an = n;
        ck(rc == 0 && tx_suffix(o, (long)on, "W7R1:5\nW7OK:0\n", 14) &&
           sy_exists(gate) == 0 && a && an > 1 && gone_temp(a, an), name);
        mm_free(a); }
      mm_free(o);
    }

    coordinator_case(drv, tag, dir);
    coordinator_spawn_failure(drv, tag, dir, 0);
    coordinator_spawn_failure(drv, tag, dir, 1);
    coordinator_release_case(drv, tag, dir);

    tx_snprintf(name, sizeof name, "%s.old-o", tag);
    v[0] = (char *)drv; tx_snprintf(p, sizeof p, "%s/plain.cx", dir); v[1] = p;
    tx_snprintf(q, sizeof q, "%s/old.out", dir); v[2] = "-o"; v[3] = q; v[4] = 0;
    o = 0; n = 0; rc = runv(v, &o, &n);
    ck(rc == 0 && sy_exists(q) == 1, name);
    mm_free(o);
}

static int build_driver(const char *cc, const char *cmd, const char *dir, char *bin, size_t cap) {
    char mod[256], o1[256], o2[256], o3[256], src[256];
    char *v[16];
    char *o = 0; size_t n = 0; int rc;
    tx_snprintf(mod, sizeof mod, "%s/cxmod.o", dir);
    tx_snprintf(o1, sizeof o1, "%s/cxcc.o", dir);
    tx_snprintf(o2, sizeof o2, "%s/cxproc.o", dir);
    tx_snprintf(o3, sizeof o3, "%s/main.o", dir);
    tx_snprintf(bin, cap, "%s/%s_cx", dir, cmd);
    v[0] = (char *)cc; v[1] = "-std=c99"; v[2] = "-Werror=implicit-function-declaration";
    v[3] = "-include"; v[4] = "stdlib.h"; v[5] = "-c"; v[6] = "src/cxmod.c"; v[7] = "-o"; v[8] = mod; v[9] = 0;
    if (runv(v, &o, &n) != 0) { if (o) sy_write_all(2, o, (long)n); mm_free(o); return -1; }
    mm_free(o); o = 0;
    v[0] = (char *)cc; v[1] = "-std=c99"; v[2] = "-Werror=implicit-function-declaration";
    v[3] = "-include"; v[4] = "include/cx.h"; v[5] = "-x"; v[6] = "c"; v[7] = "-c";
    v[8] = "tools/cxcc.cx"; v[9] = "-o"; v[10] = o1; v[11] = 0;
    if (runv(v, &o, &n) != 0) { if (o) sy_write_all(2, o, (long)n); mm_free(o); return -1; }
    mm_free(o); o = 0;
    v[8] = "tools/cxproc.cx"; v[10] = o2;
    if (runv(v, &o, &n) != 0) { if (o) sy_write_all(2, o, (long)n); mm_free(o); return -1; }
    mm_free(o); o = 0;
    tx_snprintf(src, sizeof src, "tools/%s.cx", cmd);
    v[8] = src; v[10] = o3;
    if (runv(v, &o, &n) != 0) { if (o) sy_write_all(2, o, (long)n); mm_free(o); return -1; }
    mm_free(o); o = 0;
    v[0] = (char *)cc; v[1] = "-std=c99"; v[2] = "-o"; v[3] = bin;
    v[4] = mod; v[5] = o1; v[6] = o2; v[7] = o3; v[8] = 0;
    rc = runv(v, &o, &n);
    if (rc != 0 && o) sy_write_all(2, o, (long)n);
    mm_free(o);
    return rc == 0 ? 0 : -1;
}

int main(void) {
    char dir[256];
    char *o = 0; size_t n = 0;
    int rc;
    char gbin[256], cbin[256];
    { int tryn, made = 0;
      for (tryn = 0; tryn < 100 && !made; tryn++) {
          int rc2;
          tx_snprintf(dir, sizeof dir, "out/cx-host-run-%ld-%d", (long)sy_pid(), tryn);
          rc2 = sy_mkdir(dir, 0700);
          if (rc2 == 0) made = 1;
          else if (rc2 != -EEXIST) break;
      }
      ck(made, "exclusive-test-directory");
      if (!made) { sy_printf("CX_HOST_RUN\tfailed=%d\n", failed + 1); return 1; }
    }
    fixture(dir);
    rc = build_driver("gcc", "gcc_cx", dir, gbin, sizeof gbin);
    ck(rc == 0, "build-gcc-driver");
    rc = build_driver("clang", "clang_cx", dir, cbin, sizeof cbin);
    ck(rc == 0, "build-clang-driver");
    if (sy_exists(gbin) == 1 && sy_exists(cbin) == 1) {
        matrix(gbin, "gcc", "gcc", dir);
        matrix(cbin, "clang", "clang", dir);
    } else ck(0, "drivers-present");
    sy_printf("CX_HOST_RUN\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
