/* CX-W-7 candidate: host gcc_cx/clang_cx -run behavior. Run from the repo root:
   sh ./unisacc.com tests/cx-host-run.cx
   Builds the two host drivers from tools/cxcc.cx, then runs the same matrix on
   each. Prints PASS/FAIL lines and CX_HOST_RUN<TAB>failed=N. Candidate only:
   it does not mark CX-W-7 effective, install anything, or claim Windows/macOS. */
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use mem.heap

static int failed;
static void ck(int ok, const char *name) {
    if (ok) sy_printf("PASS\t%s\n", name);
    else { sy_printf("FAIL\t%s\n", name); failed++; }
}

static int has(const char *s, size_t n, const char *w) {
    size_t wn = tx_len(w, 1L << 20), i;
    if (!s || wn > n) return 0;
    for (i = 0; i + wn <= n; i++) if (tx_same(s + i, (long)wn, w, (long)wn)) return 1;
    return 0;
}

static int write_text(const char *path, const char *text) {
    return cx_write(path, text, (size_t)tx_len(text, 1L << 20));
}

static void fixture(const char *dir) {
    char p[1024];
    tx_snprintf(p, sizeof p, "%s/plain.cx", dir);
    write_text(p, "int main(void) { printf(\"plain\\n\"); return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/helper.cx", dir);
    write_text(p, "#pragma unisa module helper\nint helper_value(void) { return 42; }\n");
    tx_snprintf(p, sizeof p, "%s/mod.cx", dir);
    write_text(p, "#pragma unisa use helper\nint main(void) { printf(\"helper=%d\\n\", helper_value()); return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/args.cx", dir);
    write_text(p, "int main(int argc, char **argv) { int i; for (i = 0; i < argc; i++) printf(\"[%d]=<%s>\\n\", i, argv[i]); return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/envio.cx", dir);
    write_text(p, "int main(void) { char b[64]; char c[256]; if (getcwd(c, sizeof c)) printf(\"cwd=%s\\n\", c); printf(\"env=%s\\n\", getenv(\"W7_ENV\") ? getenv(\"W7_ENV\") : \"missing\"); if (fgets(b, sizeof b, stdin)) printf(\"stdin=%s\", b); fprintf(stderr, \"err-line\\n\"); return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/exit7.cx", dir);
    write_text(p, "int main(void) { return 7; }\n");
    tx_snprintf(p, sizeof p, "%s/exit143.cx", dir);
    write_text(p, "int main(void) { return 143; }\n");
    tx_snprintf(p, sizeof p, "%s/sig15.cx", dir);
    write_text(p, "int main(void) { raise(15); return 0; }\n");
    tx_snprintf(p, sizeof p, "%s/bad.cx", dir);
    write_text(p, "int main(void) { this is not C\n");
    tx_snprintf(p, sizeof p, "%s/declare.cx", dir);
    write_text(p, "int declared(void);\n");
    tx_snprintf(p, sizeof p, "%s/rsp.txt", dir);
    write_text(p, "-o out/should-not-exist\n");
}

static int runv(char **v, char **out, size_t *n) { return cx_runv_timeout(v, 20, out, n); }
static int runsh(const char *cmd, char **out, size_t *n) { return cx_run_timeout(cmd, 30, out, n); }

/* 1 when the temp executable named in "[0]=<path>" and its parent directory are gone. */
static int gone_temp(const char *o, size_t n) {
    char p[1024], q[1024];
    size_t i, b = 0, e = 0;
    for (i = 0; i + 4 < n; i++) if (o[i] == '[' && o[i + 1] == '0' && o[i + 2] == ']' && o[i + 3] == '=') { b = i + 4; break; }
    if (!b) return 0;
    if (o[b] == '<') b++;
    e = b;
    while (e < n && o[e] != '>' && o[e] != '\n') e++;
    if (e - b + 1 >= sizeof p) return 0;
    for (i = 0; i < e - b; i++) p[i] = o[b + i];
    p[e - b] = 0;
    for (i = 0; p[i]; i++) if (p[i] == '/') b = i;
    if (!b) return 0;
    for (i = 0; i < b; i++) q[i] = p[i];
    q[b] = 0;
    return sy_exists(p) == 0 && sy_exists(q) == 0;
}

static void matrix(const char *drv, const char *tag, const char *cc, const char *dir) {
    char p[1024], q[1024], r[1024], cmd[4096];
    char *o = 0; size_t n = 0; int rc;
    char *v[16];
    char name[128];

    tx_snprintf(name, sizeof name, "%s.no-use", tag);
    v[0] = (char *)drv; v[1] = "-run"; tx_snprintf(p, sizeof p, "%s/plain.cx", dir); v[2] = p; v[3] = 0;
    o = 0; n = 0; rc = runv(v, &o, &n);
    ck(rc == 0 && has(o, n, "plain"), name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.use", tag);
    v[0] = (char *)drv; v[1] = "-run"; tx_snprintf(p, sizeof p, "%s/mod.cx", dir); v[2] = p; v[3] = 0;
    o = 0; n = 0; rc = runv(v, &o, &n);
    ck(rc == 0 && has(o, n, "helper=42"), name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.args", tag);
    v[0] = (char *)drv; v[1] = "-run"; tx_snprintf(p, sizeof p, "%s/args.cx", dir); v[2] = p; v[3] = "--";
    v[4] = ""; v[5] = "a b"; v[6] = "q\"x"; v[7] = "back\\slash"; v[8] = "--"; v[9] = "-o";
    v[10] = "-run"; v[11] = "@file"; v[12] = 0;
    o = 0; n = 0; rc = runv(v, &o, &n);
    ck(rc == 0 && has(o, n, "[1]=<>") && has(o, n, "[2]=<a b>") && has(o, n, "[3]=<q\"x>") &&
       has(o, n, "[4]=<back\\slash>") && has(o, n, "[5]=<-->") && has(o, n, "[6]=<-o>") &&
       has(o, n, "[7]=<-run>") && has(o, n, "[8]=<@file>"), name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.exit7", tag);
    v[0] = (char *)drv; v[1] = "-run"; tx_snprintf(p, sizeof p, "%s/exit7.cx", dir); v[2] = p; v[3] = 0;
    o = 0; n = 0; rc = runv(v, &o, &n);
    ck(rc == 7, name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.exit143-no-signal-line", tag);
    tx_snprintf(cmd, sizeof cmd, "%s -run %s/exit143.cx >%s/e141.out 2>%s/e141.err", drv, dir, dir, dir);
    rc = runsh(cmd, 0, 0);
    tx_snprintf(p, sizeof p, "%s/e141.err", dir);
    o = cx_read(p, &n);
    ck(rc == 143 && o && n == 0, name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.sig15-line", tag);
    tx_snprintf(cmd, sizeof cmd, "%s -run %s/sig15.cx >%s/s15.out 2>%s/s15.err", drv, dir, dir, dir);
    rc = runsh(cmd, 0, 0);
    tx_snprintf(p, sizeof p, "%s/s15.err", dir);
    o = cx_read(p, &n);
    tx_snprintf(q, sizeof q, "program killed by signal 15");
    { int nl = 0; size_t i; for (i = 0; o && i < n; i++) if (o[i] == '\n') nl++;
      ck(rc == 143 && o && has(o, n, q) && nl == 1, name); }
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.env-io-cwd", tag);
    tx_snprintf(cmd, sizeof cmd, "printf 'stdin-line\\n' | W7_ENV=env-ok %s -run %s/envio.cx >%s/env.out 2>%s/env.err", drv, dir, dir, dir);
    rc = runsh(cmd, 0, 0);
    tx_snprintf(p, sizeof p, "%s/env.out", dir);
    o = cx_read(p, &n);
    ck(rc == 0 && has(o, n, "env=env-ok") && has(o, n, "stdin=stdin-line") && has(o, n, "cwd="), name);
    mm_free(o);
    tx_snprintf(p, sizeof p, "%s/env.err", dir);
    o = cx_read(p, &n);
    ck(o && has(o, n, "err-line"), "env-io-stderr");
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.compile-fail-clean", tag);
    tx_snprintf(cmd, sizeof cmd, "%s -run %s/bad.cx 2>&1", drv, dir);
    o = 0; n = 0; rc = runsh(cmd, &o, &n);
    ck(rc != 0 && rc != 2 && has(o, n, "error"), name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.conflicts", tag);
    { int ok = 1;
      char out[256];
      const char *fixed[][2] = {
        {"-c", "-c"}, {"-E", "-E"}, {"-S", "-S"}, {"-shared", "-shared"}
      };
      size_t k;
      tx_snprintf(out, sizeof out, "%s/conflict-out", dir);
      if (sy_exists(out) == 1) ok = 0;
      for (k = 0; k < 5 + sizeof fixed / sizeof fixed[0]; k++) {
        if (k == 0) tx_snprintf(cmd, sizeof cmd, "%s -run -o %s %s/plain.cx 2>&1", drv, out, dir);
        else if (k == 1) tx_snprintf(cmd, sizeof cmd, "%s -run -o%s %s/plain.cx 2>&1", drv, out, dir);
        else if (k == 2) tx_snprintf(cmd, sizeof cmd, "%s -run -Wl,--output=%s %s/plain.cx 2>&1", drv, out, dir);
        else if (k == 3) tx_snprintf(cmd, sizeof cmd, "%s -run -Xlinker %s/plain.cx 2>&1", drv, dir);
        else if (k == 4) tx_snprintf(cmd, sizeof cmd, "%s -run @%s/rsp.txt %s/plain.cx 2>&1", drv, dir, dir);
        else tx_snprintf(cmd, sizeof cmd, "%s -run %s %s/plain.cx 2>&1", drv, fixed[k - 5][0], dir);
        o = 0; n = 0; rc = runsh(cmd, &o, &n);
        if (rc != 2) ok = 0;
        if (k == 0 || k == 1) { if (!has(o, n, "output override")) ok = 0; }
        else if (k == 2 || k == 3) { if (!has(o, n, "linker options")) ok = 0; }
        else if (k == 4) { if (!has(o, n, "response files")) ok = 0; }
        else if (!has(o, n, fixed[k - 5][1])) ok = 0;
        mm_free(o);
      }
      if (sy_exists(out) == 1) ok = 0;
      ck(ok, name);
    }

    tx_snprintf(name, sizeof name, "%s.two-sources", tag);
    tx_snprintf(cmd, sizeof cmd, "%s -run %s/plain.cx %s/exit7.cx 2>&1", drv, dir, dir);
    o = 0; n = 0; rc = runsh(cmd, &o, &n);
    ck(rc == 2 && has(o, n, "one .cx main file"), name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.include-values", tag);
    v[0] = (char *)drv; v[1] = "-run"; v[2] = "-include"; tx_snprintf(p, sizeof p, "%s/declare.cx", dir); v[3] = p;
    tx_snprintf(q, sizeof q, "-I%s", dir); v[4] = q; tx_snprintf(r, sizeof r, "%s/plain.cx", dir); v[5] = r; v[6] = 0;
    o = 0; n = 0; rc = runv(v, &o, &n);
    ck(rc == 0 && has(o, n, "plain"), name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.oFILE-and-I-value", tag);
    tx_snprintf(cmd, sizeof cmd, "%s -run -oZ -I %s/inc.cx %s/plain.cx 2>&1", drv, dir, dir);
    o = 0; n = 0; rc = runsh(cmd, &o, &n);
    ck(rc == 2 && has(o, n, "output override"), name);
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.fake-compiler-cleanup", tag);
    { char fd[256], script[1024], mark[256], body[1024];
      tx_snprintf(fd, sizeof fd, "%s/fake-%s", dir, cc);
      tx_snprintf(script, sizeof script, "%s/%s", fd, cc);
      tx_snprintf(mark, sizeof mark, "%s/fake-%s.mark", dir, cc);
      { char c[512]; tx_snprintf(c, sizeof c, "mkdir -p %s", fd); runsh(c, 0, 0); }
      tx_snprintf(body, sizeof body,
        "#!/bin/sh\n[ -n \"$STARTED\" ] && printf started > \"$STARTED\"\nout=\nprev=\nfor a in \"$@\"; do\n"
        "  if [ \"$prev\" = \"-o\" ]; then out=$a; fi\n"
        "  case $a in -o*) out=${a#-o};; esac\n  prev=$a\ndone\n"
        "[ -n \"$out\" ] && printf x > \"$out\"\nprintf '%%s\\n' \"$out\" > \"$MARK\"\nexit 9\n");
      write_text(script, body);
      sy_chmod(script, 0755);
      tx_snprintf(cmd, sizeof cmd, "MARK=%s PATH=%s:$PATH %s -run %s/plain.cx >/dev/null 2>&1; echo W7RC:$?", mark, fd, drv, dir);
      o = 0; n = 0; rc = runsh(cmd, &o, &n);
      ck(rc == 0 && tx_suffix(o, (long)n, "W7RC:9\n", 7), name);
      mm_free(o);
      o = cx_read(mark, &n);
      { char parent[256]; size_t i, b = 0;
        for (i = 0; o && i < n && o[i] != '\n'; i++) { if (o[i] == '/') b = i; }
        if (o && b > 1 && b < sizeof parent) {
          for (i = 0; i < b; i++) parent[i] = o[i];
          parent[b] = 0;
          o[b] = 0;
          ck(sy_exists(o) == 0 && sy_exists(parent) == 0, "fake-compiler-target-gone");
        } else ck(0, "fake-compiler-target-gone");
      }
      mm_free(o);
    }

    tx_snprintf(name, sizeof name, "%s.response-as-option-value", tag);
    { char fd[256], script[1024], started[256];
      tx_snprintf(fd, sizeof fd, "%s/fake-%s", dir, cc);
      tx_snprintf(script, sizeof script, "%s/%s", fd, cc);
      tx_snprintf(started, sizeof started, "%s/fake-%s.started", dir, cc);
      tx_snprintf(cmd, sizeof cmd,
                  "STARTED=%s MARK=%s.mark2 PATH=%s:$PATH %s -run -I @%s/rsp.txt %s/plain.cx 2>&1; echo W7RC:$?",
                  started, started, fd, drv, dir, dir);
      o = 0; n = 0; rc = runsh(cmd, &o, &n);
      ck(rc == 0 && has(o, n, "response file") && tx_suffix(o, (long)n, "W7RC:2\n", 7) &&
         sy_exists(started) == 0, name);
      mm_free(o);
      tx_snprintf(cmd, sizeof cmd,
                  "STARTED=%s MARK=%s.mark3 PATH=%s:$PATH %s -run -include @%s/rsp.txt %s/plain.cx 2>&1; echo W7RC:$?",
                  started, started, fd, drv, dir, dir);
      o = 0; n = 0; rc = runsh(cmd, &o, &n);
      ck(rc == 0 && has(o, n, "response file") && tx_suffix(o, (long)n, "W7RC:2\n", 7) &&
         sy_exists(started) == 0, "response-as-include-value");
      mm_free(o);
    }

    tx_snprintf(name, sizeof name, "%s.concurrency-clean", tag);
    tx_snprintf(cmd, sizeof cmd,
             "( %s -run %s/args.cx -- one >%s/c1.out 2>/dev/null ) & a=$!; "
             "( %s -run %s/args.cx -- two >%s/c2.out 2>/dev/null ) & b=$!; "
             "wait $a; r1=$?; wait $b; r2=$?; echo $r1:$r2",
             drv, dir, dir, drv, dir, dir);
    o = 0; n = 0; rc = runsh(cmd, &o, &n);
    { size_t on = n; char *a, *b; size_t an = 0, bn = 0;
      tx_snprintf(p, sizeof p, "%s/c1.out", dir);
      a = cx_read(p, &an);
      tx_snprintf(q, sizeof q, "%s/c2.out", dir); b = cx_read(q, &bn);
      ck(rc == 0 && has(o, on, "0:0") && a && b && has(a, an, "<one>") && has(b, bn, "<two>") &&
         gone_temp(a, an) && gone_temp(b, bn), name);
      mm_free(a); mm_free(b); }
    mm_free(o);

    tx_snprintf(name, sizeof name, "%s.old-o", tag);
    v[0] = (char *)drv; tx_snprintf(p, sizeof p, "%s/plain.cx", dir); v[1] = p;
    tx_snprintf(q, sizeof q, "%s/old.out", dir); v[2] = "-o"; v[3] = q; v[4] = 0;
    o = 0; n = 0; rc = runv(v, &o, &n);
    ck(rc == 0 && sy_exists(q) == 1, name);
    mm_free(o);
}

static int build_driver(const char *cc, const char *cmd, const char *dir, char *bin, size_t cap) {
    char mod[256], o1[256], o2[256], o3[256], src[256];
    char *v[16];
    char *o = 0; size_t n = 0; int rc;
    tx_snprintf(mod, sizeof mod, "%s/cxmod.o", dir);
    tx_snprintf(o1, sizeof o1, "%s/cxcc.o", dir);
    tx_snprintf(o2, sizeof o2, "%s/cxproc.o", dir);
    tx_snprintf(o3, sizeof o3, "%s/main.o", dir);
    tx_snprintf(bin, cap, "%s/%s_cx", dir, cmd);
    v[0] = (char *)cc; v[1] = "-std=c99"; v[2] = "-Werror=implicit-function-declaration";
    v[3] = "-include"; v[4] = "stdlib.h"; v[5] = "-c"; v[6] = "src/cxmod.c"; v[7] = "-o"; v[8] = mod; v[9] = 0;
    if (runv(v, &o, &n) != 0) { if (o) sy_write_all(2, o, (long)n); mm_free(o); return -1; }
    mm_free(o); o = 0;
    v[0] = (char *)cc; v[1] = "-std=c99"; v[2] = "-Werror=implicit-function-declaration";
    v[3] = "-include"; v[4] = "include/cx.h"; v[5] = "-x"; v[6] = "c"; v[7] = "-c";
    v[8] = "tools/cxcc.cx"; v[9] = "-o"; v[10] = o1; v[11] = 0;
    if (runv(v, &o, &n) != 0) { if (o) sy_write_all(2, o, (long)n); mm_free(o); return -1; }
    mm_free(o); o = 0;
    v[8] = "tools/cxproc.cx"; v[10] = o2;
    if (runv(v, &o, &n) != 0) { if (o) sy_write_all(2, o, (long)n); mm_free(o); return -1; }
    mm_free(o); o = 0;
    tx_snprintf(src, sizeof src, "tools/%s.cx", cmd);
    v[8] = src; v[10] = o3;
    if (runv(v, &o, &n) != 0) { if (o) sy_write_all(2, o, (long)n); mm_free(o); return -1; }
    mm_free(o); o = 0;
    v[0] = (char *)cc; v[1] = "-std=c99"; v[2] = "-o"; v[3] = bin;
    v[4] = mod; v[5] = o1; v[6] = o2; v[7] = o3; v[8] = 0;
    rc = runv(v, &o, &n);
    if (rc != 0 && o) sy_write_all(2, o, (long)n);
    mm_free(o);
    return rc == 0 ? 0 : -1;
}

int main(void) {
    char dir[256];
    char *o = 0; size_t n = 0;
    int rc;
    char gbin[256], cbin[256];
    { int tryn, made = 0;
      for (tryn = 0; tryn < 100 && !made; tryn++) {
          int rc2;
          tx_snprintf(dir, sizeof dir, "out/cx-host-run-%ld-%d", (long)sy_pid(), tryn);
          rc2 = sy_mkdir(dir, 0700);
          if (rc2 == 0) made = 1;
          else if (rc2 != -EEXIST) break;
      }
      ck(made, "exclusive-test-directory");
      if (!made) { sy_printf("CX_HOST_RUN\tfailed=%d\n", failed + 1); return 1; }
    }
    fixture(dir);
    rc = build_driver("gcc", "gcc_cx", dir, gbin, sizeof gbin);
    ck(rc == 0, "build-gcc-driver");
    rc = build_driver("clang", "clang_cx", dir, cbin, sizeof cbin);
    ck(rc == 0, "build-clang-driver");
    if (sy_exists(gbin) == 1 && sy_exists(cbin) == 1) {
        matrix(gbin, "gcc", "gcc", dir);
        matrix(cbin, "clang", "clang", dir);
    } else ck(0, "drivers-present");
    sy_printf("CX_HOST_RUN\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
