@target lnx/x86_64
@data -
@sym __argvv 256
@src_os lnx
@data_len 32936
@bss 0
@relocs -
_start:
spinit rsp
argsave 33072, 33080, true
call __init form=x86 reloc=rel32
setreg rax, mem 33072 role=argc
.lea rdi, __argvv
imm rsi, 0
__argv_top:
slt64 rdx, rsi, rax form=x86
jumpz rdx, __argv_done form=x86 reloc=rel32
argvget rcx, rsi, 33080
imm r8, 8
mul64 r8, rsi, r8 form=x86
add64 r8, rdi, r8 form=x86
store64 r8, 0, rcx form=x86
imm r8, 1
add64 rsi, rsi, r8 form=x86
jump __argv_top form=x86 reloc=rel32
__argv_done:
call main form=x86 reloc=rel32
jump __main_ret form=x86 reloc=rel32
main:
push r9
mov r9, rsp
.frame 0
imm rax, 7
.frame 8
.st rsp, 0, rax, 4
.ld rax, rsp, 0, 4
.frame -8
jump __unisacc_R1 form=x86 reloc=rel32
imm rax, 0
__unisacc_R1:
mov rsp, r9
pop r9
ret form=x86
__init:
ret form=x86
__main_ret:
setmem 33024, rax
setreg rax, imm 60 role=sysno
setreg rdi, mem 33024 role=arg0
setreg rsi, imm 0 role=arg1
setreg rdx, imm 0 role=arg2
gate form=syscall gate=syscall carry=false winapi=ExitProcess catop=exit sysno='60 retconv='none winimp='none ret=rax hstd=33192 written=33216 scr0=33024 scr1=33032
