/* Native Darwin harness controls; each run constructs its own tiny registry. */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.productpkg
#pragma unisa use sys.hostid
#pragma unisa use sys.time
static char rp_root[4096],rp_work[4096],rp_fixture[4400],rp_parent[4400],rp_runner[4400];
static long long rp_deadline;static int rp_checks,rp_failed;
static void rp_die(const char *s){fprintf(stderr,"runner-platform: %s; retained=%s\n",s,rp_work);exit(2);}
static void rp_ck(int v,const char *s){rp_checks++;rp_failed+=!v;printf("%s\t%s\n",v?"PASS":"FAIL",s);}
static void rp_path(char *p,size_t cap,const char *a,const char *b){if(snprintf(p,cap,"%s/%s",a,b)>=(int)cap)rp_die("path bound");}
static void rp_put(const char *p,const char *s){if(cx_write(p,s,strlen(s)))rp_die("write");}
static np_result rp_run(char **v){long long left=rp_deadline-sy_now_ms();if(left<1000)rp_die("45second runtime deadline");int seconds=(int)(left/1000);if(seconds>15)seconds=15;np_result r={0};char why[500]={0};if(np_run(v,rp_root,0,seconds,&r,why,sizeof why)||r.residue){fprintf(stderr,"%s\n",why);rp_die("child transport");}return r;}
static int rp_marker(const char *s,size_t n,const char *want){int count=0;size_t k=strlen(want);for(size_t at=0;at<n;){size_t end=at;while(end<n&&s[end]!='\n')end++;if(end-at>=k&&!memcmp(s+at,want,k))count++;at=end+1;}return count==1;}
static void rp_case(const char *id,int accept,const char *hash){char *v[]={rp_runner,rp_fixture,rp_parent,(char *)id,0};np_result r=rp_run(v);rp_ck(r.rc==(accept?0:2),id);if(accept){char expected[240];if(cx_fmt(expected,sizeof expected,"BATCH_RUN\tid=%s\tstatus=PASS\trc=0\ttransport=0\tmarker=PLATFORM_TINY\tcandidate=%s\theaders=product\tscope=actual-one-batch-no-cached-result",id,hash))rp_die("expected bound");rp_ck(r.out&&rp_marker(r.out,r.outn,expected),"PASS binds actual product and unique terminal status");rp_ck(r.out&&strstr(r.out,"PLATFORM_TINY\n"),"tiny fixture actually executes");}else{rp_ck(r.err&&strstr(r.err,"batch requires another native host")&&(!r.out||!strstr(r.out,"BATCH_RUN")),"foreign host rejected before execution");char p[4600];rp_path(p,sizeof p,rp_parent,id);struct stat st;int rc=lstat(p,&st),e=errno;if(rc&&e!=ENOENT)rp_die("rejected path stat");rp_ck(rc&&e==ENOENT,"foreign host creates no batch output");}np_free(&r);}
int main(int argc,char **argv){if(argc>2){fputs("usage: runner-platform [ROOT]\n",stderr);return 2;}const char *host=tn_self();if(!host||strcmp(host,"osx/arm64")){printf("RUNNER_PLATFORM\tstatus=NOT_RUN\thost=%s\trequired=osx/arm64\n",host?host:"UNKNOWN");return 3;}if(!realpath(argc==2?argv[1]:".",rp_root))rp_die("root");rp_deadline=sy_now_ms()+45000;char temp[]="/tmp/runner-platform-XXXXXX";if(!mkdtemp(temp)||!realpath(temp,rp_work))rp_die("physical temporary directory");char before[65],after[65],copied[65],com[4400],source[4400],p[4600];if(pp_product_digest(rp_root,before))rp_die("product identity before");rp_path(rp_runner,sizeof rp_runner,rp_work,"run-batch");rp_path(com,sizeof com,rp_root,"unisacc.com");rp_path(source,sizeof source,rp_root,"tests/run-batch.cx");char *compile[]={"sh",com,"-o",rp_runner,source,0};np_result build=rp_run(compile);if(build.rc){if(build.errn)fwrite(build.err,1,build.errn,stderr);rp_die("current harness compilation");}np_free(&build);rp_path(rp_fixture,sizeof rp_fixture,rp_work,"root");if(mkdir(rp_fixture,0700)||pp_copy_product(rp_root,rp_fixture))rp_die("fixture product");if(pp_product_digest(rp_fixture,copied))rp_die("copied product identity");rp_ck(!strcmp(before,copied),"fixture uses complete identical installed product");rp_path(p,sizeof p,rp_fixture,"tests");if(mkdir(p,0700))rp_die("tests directory");rp_path(p,sizeof p,rp_fixture,"out");if(mkdir(p,0700))rp_die("out directory");rp_path(rp_parent,sizeof rp_parent,p,"session");if(mkdir(rp_parent,0700))rp_die("session directory");rp_path(p,sizeof p,rp_fixture,"tests/tiny.cx");rp_put(p,"int main(void){puts(\"PLATFORM_TINY\");return 0;}\n");rp_path(p,sizeof p,rp_fixture,"tests/coverage.tsv");rp_put(p,"id\tlayer\timplementation\texpected_or_gap\tsource\nplatform.fixture\tinterfaces\tIMPLEMENTED_SEPARATE_BATCH\tplatform consistency fixture only\ttests/tiny.cx\n");np_buf reg={0};np_puts(&reg,"id\timplementation\tlayer\tsource\tmode\tplatform\tbudget_seconds\tmaterials\tentry\targs\tcoverage\texpect\theaders\n");const char *ids[]={"darwin","linux","win-arm","intel","win-x64"},*platforms[]={"osx/arm64","lnx/x86_64","win/arm64","osx/x86_64","win/x86_64"};for(int i=0;i<5;i++){char row[800];if(cx_fmt(row,sizeof row,"%s\tIMPLEMENTED\tinterfaces\ttests/tiny.cx\tSOURCE\t%s\t12\t-\ttests/tiny.cx\t-\tplatform.fixture\trc0:PLATFORM_TINY\tproduct\n",ids[i],platforms[i]))rp_die("registry row bound");np_puts(&reg,row);}rp_path(p,sizeof p,rp_fixture,"tests/batches.tsv");if(cx_write(p,reg.p,reg.n))rp_die("fixture registry");free(reg.p);for(int i=0;i<5;i++)rp_case(ids[i],i<2,before);if(pp_product_digest(rp_root,after))rp_die("product identity after");rp_ck(!strcmp(before,after),"installed product unchanged");printf("RUNNER_PLATFORM\tassertions=%d\tfailed=%d\thost=%s\tcandidate=%s\tscope=synthetic-harness-contract\tretained=%s\n",rp_checks,rp_failed,host,before,rp_work);return rp_failed?1:0;}
