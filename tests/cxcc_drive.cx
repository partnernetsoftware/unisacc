/* Drives tools/gcc_cx.cx and tools/clang_cx.cx. No second resolver. */
static int fails;

static int write_text(const char *path, const char *text) {
    FILE *f;
    size_t want, n;
    f = fopen(path, "wb");
    if (!f) return -1;
    want = strlen(text);
    n = fwrite(text, 1, want, f);
    if (fclose(f) != 0) return -1;
    return n == want ? 0 : -1;
}

/* A warm -include must see a changed header. The value is the sum of the
   macro and the module anchor, so an old object would keep the old sum. */
static int include_fresh(const char *which) {
    char cmd[1400];
    char *buf = 0;
    size_t n = 0;
    int k, rc, ran;
    const char *modp = "out/cxcc-drive/incmod.cx";
    const char *mainp = "out/cxcc-drive/incmain.cx";
    const char *hdr = "out/cxcc-drive/extra.h";
    const char *out = "out/cxcc-drive/incbin";
    if (write_text(modp, "#pragma unisa module incmod\nint cxcc_inc_anchor(void) { return 1; }\n")) return 0;
    if (write_text(mainp, "#pragma unisa use incmod\nint main(void) { return EXTRA_VALUE + cxcc_inc_anchor(); }\n")) return 0;
    if (write_text(hdr, "#define EXTRA_VALUE 7\n")) return 0;
    unlink(out);
    k = snprintf(cmd, sizeof cmd,
                 "sh ./unisacc.com -run tools/%s_cx.cx -- %s -include %s -o %s",
                 which, mainp, hdr, out);
    if (k < 0 || k >= (int)sizeof cmd) return 0;
    rc = cx_run_timeout(cmd, 40, &buf, &n);
    free(buf);
    buf = 0;
    if (rc != 0) return 0;
    k = snprintf(cmd, sizeof cmd, "./%s", out);
    if (k < 0 || k >= (int)sizeof cmd) return 0;
    ran = cx_run_timeout(cmd, 10, &buf, &n);
    free(buf);
    buf = 0;
    if (ran != 8) return 0;
    if (write_text(hdr, "#define EXTRA_VALUE 11\n")) return 0;
    unlink(out);
    k = snprintf(cmd, sizeof cmd,
                 "sh ./unisacc.com -run tools/%s_cx.cx -- %s -include %s -o %s",
                 which, mainp, hdr, out);
    if (k < 0 || k >= (int)sizeof cmd) return 0;
    rc = cx_run_timeout(cmd, 40, &buf, &n);
    free(buf);
    buf = 0;
    if (rc != 0) return 0;
    k = snprintf(cmd, sizeof cmd, "./%s", out);
    if (k < 0 || k >= (int)sizeof cmd) return 0;
    ran = cx_run_timeout(cmd, 10, &buf, &n);
    free(buf);
    return ran == 12;
}

static void note(int ok, const char *name) {
    if (ok) printf("PASS %s\n", name);
    else { printf("FAIL %s\n", name); fails = fails + 1; }
}

static int drive(const char *which, const char *src, const char *out, int want) {
    char cmd[1100];
    char *buf = 0;
    size_t n = 0;
    int k, rc, ran;
    unlink(out);
    k = snprintf(cmd, sizeof cmd, "sh ./unisacc.com -run tools/%s_cx.cx -- %s -o %s", which, src, out);
    if (k < 0 || k >= (int)sizeof cmd) return 0;
    rc = cx_run_timeout(cmd, 40, &buf, &n);
    free(buf);
    buf = 0;
    if (want < 0) return rc != 0 && rc != 124 && access(out, F_OK) != 0;
    if (rc != 0) return 0;
    k = snprintf(cmd, sizeof cmd, "./%s", out);
    if (k < 0 || k >= (int)sizeof cmd) return 0;
    ran = cx_run_timeout(cmd, 10, &buf, &n);
    free(buf);
    return ran == want;
}

int main(void) {
    if (cx_run("mkdir -p out/cxcc-drive", 0, 0) != 0) {
        printf("FAIL mkdir\n");
        return 1;
    }
    note(drive("gcc", "tests/cxhost_main.cx", "out/cxcc-drive/gcc-host", 42), "gcc cxhost 42");
    note(drive("clang", "tests/cxhost_main.cx", "out/cxcc-drive/clang-host", 42), "clang cxhost 42");
    note(drive("gcc", "tests/cxcc_missing.cx", "out/cxcc-drive/gcc-miss", -1), "gcc missing");
    note(drive("clang", "tests/cxcc_missing.cx", "out/cxcc-drive/clang-miss", -1), "clang missing");
    note(drive("gcc", "tests/cxcycle/ping.cx", "out/cxcc-drive/gcc-cycle", -1), "gcc cycle");
    note(drive("clang", "tests/cxcycle/ping.cx", "out/cxcc-drive/clang-cycle", -1), "clang cycle");
    note(drive("gcc", "tests/cxstd_unknown.cx", "out/cxcc-drive/gcc-std", -1), "gcc std.absent");
    note(drive("clang", "tests/cxstd_unknown.cx", "out/cxcc-drive/clang-std", -1), "clang std.absent");
    note(drive("gcc", "tests/cxpriv_bad.cx", "out/cxcc-drive/gcc-bad", -1), "gcc file-local");
    note(drive("clang", "tests/cxpriv_bad.cx", "out/cxcc-drive/clang-bad", -1), "clang file-local");
    note(drive("gcc", "tests/cxpriv_ok.cx", "out/cxcc-drive/gcc-ok", 42), "gcc export");
    note(drive("clang", "tests/cxpriv_ok.cx", "out/cxcc-drive/clang-ok", 42), "clang export");
    note(drive("gcc", "tests/cxcc_one.cx", "out/cxcc-drive/gcc-one", 5), "gcc one-unit");
    note(drive("clang", "tests/cxcc_one.cx", "out/cxcc-drive/clang-one", 5), "clang one-unit");
    note(drive("gcc", "tests/cxcc_shebang.cx", "out/cxcc-drive/gcc-bang", 3), "gcc shebang");
    note(drive("clang", "tests/cxcc_shebang.cx", "out/cxcc-drive/clang-bang", 3), "clang shebang");
    note(include_fresh("gcc"), "gcc include-bytes");
    note(include_fresh("clang"), "clang include-bytes");
    printf("CXCC fails=%d\n", fails);
    return fails ? 1 : 0;
}
