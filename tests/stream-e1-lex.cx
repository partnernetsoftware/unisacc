/* E1 lexing domain on the registered streams material (lnx/x86_64, unisacc-stream2.com pin 68f08deb).
 * ROOT STREAM_DIR NEW_OUTDIR MODE, MODE one of:
 *   --tokens    token-line format, typed spelling, offsets, non-zero UNIPP1 maps, marks, positive lexing,
 *               lex.tsv 144 keys, lexword 15 words, parse.tsv tok domain + typekw, label/transport determinism
 *   --bytes     lexcls.tsv 257 rows: byte class and __attribute__ look-ahead (attws) per byte, eof
 *   --refusals  E1 envelope/lexer/capacity/input refusals by declared name, each followed by exact recovery
 * Inputs are hand-built UNIPP1.  Expected bytes are hand oracles from exec/lex control tables
 * (entry/number/literal/ident/location/f1 tables) and weights/gold lex, lexcls, lexword, parse tok and
 * iterate/kernel/typekw.tsv, which are read at run time to bind each fragment to its gold key.  Product
 * output is never an oracle.  Timing phases are UNMEASURED. */
#pragma unisa use cxlib.netpack
#pragma unisa use cases.stream_pin
#pragma unisa use text.text
#define E "\001"
static char root[4096],streams[4096],work[4096],bound[4200],inc[4200],product[4200],e1bin[4200];
static char label_a[4200],label_b[4200];
static const char *e1_pin="68f08debe54118109ddaaadf5c1e0345ad785788e372a50022e1e0c4f41b4b24";
static int assertions,failures,unverified,seq;
static const char *cname[12]={"ws","nl","A","d","q","sq","slash","star","punct","eof","other","dot"};
static int bcls[257],battws[257];
static char ytab[12][12][12];
static char *tokdom[128];static int ntokdom;
static char *typekw[64];static int ntypekw;
static const char *MALF="not covered: malformed preprocessing locations";
static const char *BADCH="unexpected character";
static const char *NOQ="missing terminating '\"' character";
static const char *NOSQ="missing terminating ' character";

static void die(const char *s){fprintf(stderr,"stream-e1-lex: %s\n",s);exit(2);}
static void check(int ok,const char *s){assertions++;if(!ok)failures++;printf("%s\t%s\n",ok?"PASS":"FAIL",s);}
static void checkf(int ok,const char *a,const char *b){char t[400];int z=snprintf(t,sizeof t,"%s.%s",a,b);if(z<0||(size_t)z>=sizeof t)die("label");check(ok,t);}
static void path(char *out,size_t cap,const char *dir,const char *name){int n=snprintf(out,cap,"%s/%s",dir,name);if(n<0||(size_t)n>=cap)die("path");}
static void saved(const char *p,const void *s,size_t n){int f=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC,0600);size_t at=0;if(f<0)die("exclusive-create");while(at<n){ssize_t k=write(f,(const char *)s+at,n-at);if(k<0&&errno==EINTR)continue;if(k<=0)die("write");at+=(size_t)k;}if(close(f))die("close");}
static char *loaded(const char *p,size_t *n){char *s=cx_read(p,n);if(!s)die(p);return s;}
static void digest(const char *p,char *hex){size_t n;char *s=loaded(p,&n);cx_sha256_hex(s,n,hex);free(s);}
static unsigned le(const unsigned char *p){return (unsigned)p[0]|(unsigned)p[1]<<8|(unsigned)p[2]<<16|(unsigned)p[3]<<24;}
static void put32(np_buf *b,unsigned v){char c[4];c[0]=(char)(v&255u);c[1]=(char)((v>>8)&255u);c[2]=(char)((v>>16)&255u);c[3]=(char)((v>>24)&255u);np_put(b,c,4);}
static int has(const char *h,size_t hn,const char *needle){size_t k=strlen(needle),i;if(!k)return 1;if(hn<k)return 0;for(i=0;i+k<=hn;i++)if(!memcmp(h+i,needle,k))return 1;return 0;}

/* ---- gold tables (oracle source, read-only) ---- */
static int cidx(const char *s,size_t n){int i;for(i=0;i<12;i++)if(strlen(cname[i])==n&&!memcmp(cname[i],s,n))return i;return -1;}
static int split(const char *s,size_t n,const char **f,size_t *fl,int max){int k=0;size_t at=0;while(k<max){size_t e=at;while(e<n&&s[e]!='\t')e++;f[k]=s+at;fl[k]=e-at;k++;if(e>=n)break;at=e+1;}return k;}
static int fis(const char *f,size_t fl,const char *w){return strlen(w)==fl&&!memcmp(f,w,fl);}
static void load_gold(void){
 char p[4200];size_t n,at,e;char *s;int i,j,rows=0;const char *f[260];size_t fl[260];
 for(i=0;i<257;i++){bcls[i]=-1;battws[i]=-1;}
 path(p,sizeof p,root,"weights/gold/lexcls.tsv");s=loaded(p,&n);at=0;
 while(at<n){e=at;while(e<n&&s[e]!='\n')e++;
  if(e>at&&s[at]!='#'){int k=split(s+at,e-at,f,fl,8);
   if(k!=3)die("lexcls row shape");
   if(!fis(f[0],fl[0],"b")){int b=0;size_t q;
    if(fis(f[0],fl[0],"eof"))b=256;else{if(!fl[0]||fl[0]>3)die("lexcls byte");for(q=0;q<fl[0];q++){if(f[0][q]<'0'||f[0][q]>'9')die("lexcls byte digit");b=b*10+(f[0][q]-'0');}if(b>255)die("lexcls byte range");}
    if(bcls[b]>=0)die("lexcls duplicate");bcls[b]=cidx(f[1],fl[1]);if(bcls[b]<0)die("lexcls class");
    battws[b]=fis(f[2],fl[2],"yes")?1:fis(f[2],fl[2],"no")?0:-1;if(battws[b]<0)die("lexcls attws");rows++;}}
  at=e+1;}
 free(s);if(rows!=257)die("lexcls row count");
 path(p,sizeof p,root,"weights/gold/lex.tsv");s=loaded(p,&n);at=0;rows=0;
 for(i=0;i<12;i++)for(j=0;j<12;j++)ytab[i][j][0]=0;
 while(at<n){e=at;while(e<n&&s[e]!='\n')e++;
  if(e>at&&s[at]!='#'){int k=split(s+at,e-at,f,fl,8);
   if(k!=3)die("lex row shape");
   if(!fis(f[0],fl[0],"c")){int c=cidx(f[0],fl[0]),pk=cidx(f[1],fl[1]);if(c<0||pk<0||fl[2]==0||fl[2]>=12||ytab[c][pk][0])die("lex row key");{unsigned char *cxb_d=(unsigned char *)(ytab[c][pk]);const unsigned char *cxb_s=(const unsigned char *)(f[2]);size_t cxb_n=(size_t)(fl[2]),cxb_i;for(cxb_i=0;cxb_i<cxb_n;cxb_i++)cxb_d[cxb_i]=cxb_s[cxb_i];};ytab[c][pk][fl[2]]=0;rows++;}}
  at=e+1;}
 free(s);if(rows!=144)die("lex row count");
 path(p,sizeof p,root,"weights/gold/parse.tsv");s=loaded(p,&n);at=0;
 while(at<n){e=at;while(e<n&&s[e]!='\n')e++;
  if(e-at>11&&!memcmp(s+at,"#field\ttok\t",11)){int k=split(s+at,e-at,f,fl,200);if(k<7||k-2>128)die("parse tok shape");
   for(i=2;i<k;i++){tokdom[ntokdom]=malloc(fl[i]+1);if(!tokdom[ntokdom])die("alloc");{unsigned char *cxb_d=(unsigned char *)(tokdom[ntokdom]);const unsigned char *cxb_s=(const unsigned char *)(f[i]);size_t cxb_n=(size_t)(fl[i]),cxb_i;for(cxb_i=0;cxb_i<cxb_n;cxb_i++)cxb_d[cxb_i]=cxb_s[cxb_i];};tokdom[ntokdom][fl[i]]=0;ntokdom++;}}
  at=e+1;}
 free(s);if(ntokdom!=68)die("parse tok domain size");
 if(!tx_eqz(tokdom[0], "eof")||!tx_eqz(tokdom[1], "type")||!tx_eqz(tokdom[2], "id")||!tx_eqz(tokdom[3], "num")||!tx_eqz(tokdom[4], "str"))die("parse tok prefix");
 path(p,sizeof p,root,"iterate/kernel/typekw.tsv");s=loaded(p,&n);at=0;
 while(at<n){e=at;while(e<n&&s[e]!='\n')e++;
  if(e-at>3&&!memcmp(s+at,"kw\t",3)){size_t l=e-at-3;if(ntypekw>=64)die("typekw size");typekw[ntypekw]=malloc(l+1);if(!typekw[ntypekw])die("alloc");{unsigned char *cxb_d=(unsigned char *)(typekw[ntypekw]);const unsigned char *cxb_s=(const unsigned char *)(s+at+3);size_t cxb_n=(size_t)(l),cxb_i;for(cxb_i=0;cxb_i<cxb_n;cxb_i++)cxb_d[cxb_i]=cxb_s[cxb_i];};typekw[ntypekw][l]=0;ntypekw++;}
  at=e+1;}
 free(s);if(ntypekw<1)die("typekw empty");}

/* ---- UNIPP1 input and expected token lines ---- */
typedef struct {unsigned forced,autoc;int ns;unsigned spl[4];int ni;unsigned iline[2],ilines[2];const char *iname[2];} ppmap;
static void pp_build(np_buf *b,const char *text,size_t tn,const ppmap *m){int i;
 np_put(b,"UNIPP1\0",7);put32(b,(unsigned)tn);put32(b,m?m->forced:0);put32(b,m?m->autoc:0);put32(b,m?(unsigned)m->ns:0);put32(b,m?(unsigned)m->ni:0);
 if(m){for(i=0;i<m->ns;i++)put32(b,m->spl[i]);for(i=0;i<m->ni;i++){put32(b,m->iline[i]);put32(b,m->ilines[i]);put32(b,(unsigned)strlen(m->iname[i]));np_puts(b,m->iname[i]);}}
 np_put(b,text,tn);}
typedef struct {np_buf b;int n;} toks;
static void tk(toks *t,unsigned off,const char *s,size_t sn){np_put(&t->b,"@",1);put32(&t->b,off);np_put(&t->b,"\n",1);np_put(&t->b,s,sn);np_put(&t->b,"\n",1);t->n++;}
static void tks(toks *t,unsigned off,const char *s){tk(t,off,s,strlen(s));}
static void tk_end(toks *t,unsigned off){tk(t,off,"eof",3);np_putll(&t->b,t->n);np_puts(&t->b," tokens\n");}
/* spec: "OFF:TOKEN" entries separated by \001; OFF is relative to BASE */
static void want_spec(toks *t,unsigned base,const char *spec){const char *s=spec;
 while(*s){unsigned off=0;const char *q;if(*s<'0'||*s>'9')die("spec offset");while(*s>='0'&&*s<='9'){off=off*10+(unsigned)(*s-'0');s++;}if(*s!=':')die("spec colon");s++;q=s;while(*s&&*s!='\001')s++;tk(t,base+off,q,(size_t)(s-q));if(*s)s++;}}
/* join fragments with one LF */
static void jf(np_buf *txt,toks *w,const char *src,size_t sn,const char *spec){if(txt->n)np_put(txt,"\n",1);{unsigned base=(unsigned)txt->n;np_put(txt,src,sn);want_spec(w,base,spec);}}
static void tfree(toks *t){free(t->b.p);t->b.p=0;t->b.n=t->b.cap=0;t->n=0;}

/* ---- running stream2 ---- */
static np_result run_argv(const char *tag,const char *input,const char *label,const char *attr,const char *stdin_file){
 char leaf[300],outp[4400],errp[4400],envattr[4500],why[1024];np_result r;int z,save=-1;
 z=snprintf(envattr,sizeof envattr,"UNISA_ATTRIBUTES=%s",attr?attr:"");if(z<0||(size_t)z>=sizeof envattr)die("env");
 {char *v[]={bound,"12",e1bin,(char *)input,(char *)label,inc,0};const char *env[]={envattr,"UNISA_MAXSTEPS=200000000",0};
  if(stdin_file){int fd=open(stdin_file,O_RDONLY|O_CLOEXEC);save=dup(0);if(fd<0||save<0||dup2(fd,0)<0)die("stdin redirect");close(fd);}
  z=np_run(v,root,(char *const *)env,14,&r,why,sizeof why);
  if(stdin_file){if(dup2(save,0)<0)die("stdin restore");close(save);}
  if(z)die(why);}
 z=snprintf(leaf,sizeof leaf,"%03d-%s.stdout",seq,tag);if(z<0||(size_t)z>=sizeof leaf)die("leaf");path(outp,sizeof outp,work,leaf);
 z=snprintf(leaf,sizeof leaf,"%03d-%s.stderr",seq,tag);if(z<0||(size_t)z>=sizeof leaf)die("leaf");path(errp,sizeof errp,work,leaf);
 saved(outp,r.out,r.outn);saved(errp,r.err,r.errn);return r;}
static void input_path(char *out,size_t cap,const char *tag){char leaf[300];int z=snprintf(leaf,sizeof leaf,"%03d-%s.pp",seq,tag);if(z<0||(size_t)z>=sizeof leaf)die("leaf");path(out,cap,work,leaf);}
static np_result run_pp(const char *tag,const char *pp,size_t n,const char *attr,const char *label,int via_stdin){
 char in[4400];seq++;input_path(in,sizeof in,tag);saved(in,pp,n);
 if(via_stdin)return run_argv(tag,"-",label,attr,in);
 return run_argv(tag,in,label,attr,0);}

static void show_diff(const char *name,const unsigned char *got,size_t gn,const unsigned char *want,size_t wn){
 size_t i=0,a,k;while(i<gn&&i<wn&&got[i]==want[i])i++;a=i>24?i-24:0;
 printf("DIFF\t%s\tat=%lu\tgot_len=%lu\twant_len=%lu\tgot=",name,(unsigned long)i,(unsigned long)gn,(unsigned long)wn);
 for(k=a;k<gn&&k<i+40;k++){unsigned c=got[k];if(c>=32&&c<127&&c!='\\')putchar((int)c);else printf("\\x%02x",c);}
 printf("\twant=");for(k=a;k<wn&&k<i+40;k++){unsigned c=want[k];if(c>=32&&c<127&&c!='\\')putchar((int)c);else printf("\\x%02x",c);}putchar('\n');}
/* exact accept: rc0, empty stderr, USLATTR1 with exactly the hand marks, UNITOK1 exact echo, exact token lines */
static void accept_check(const char *name,np_result *r,const char *pp,size_t ppn,toks *want,const unsigned *marks,int nm){
 const unsigned char *o=(const unsigned char *)r->out,*pay=0,*tl=0;size_t on=r->outn,tln=0;unsigned cnt=0,pl=0;int frame,recs,echo,ok,i;
 checkf(r->rc==0&&r->errn==0,name,"accept-rc0-empty-stderr");
 if(r->errn)printf("STDERR\t%s\t%.*s\n",name,(int)(r->errn>200?200:r->errn),r->err);
 frame=on>=16&&!memcmp(o,"USLATTR1",8);if(frame){cnt=le(o+8);pl=le(o+12);frame=cnt<=1000000u&&16+(size_t)cnt*5+(size_t)pl==on;}
 recs=frame&&cnt==(unsigned)nm;for(i=0;recs&&i<nm;i++)recs=le(o+16+5*(size_t)i)==marks[2*i]&&o[16+5*(size_t)i+4]==marks[2*i+1];
 checkf(frame&&recs,name,"uslattr1-marks-exact");
 if(frame)pay=o+16+(size_t)cnt*5;
 echo=frame&&pl>=12&&!memcmp(pay,"UNITOK1\0",8)&&le(pay+8)==(unsigned)ppn&&12+ppn<=(size_t)pl&&!memcmp(pay+12,pp,ppn);
 checkf(echo,name,"unitok1-echo-exact");
 if(echo){tl=pay+12+ppn;tln=(size_t)pl-12-ppn;}
 ok=echo&&tln==want->b.n&&!memcmp(tl,want->b.p,tln);
 checkf(ok,name,"token-lines-exact");
 if(!ok&&echo)show_diff(name,tl,tln,(const unsigned char *)want->b.p,want->b.n);}
static void refuse_check(const char *name,np_result *r,const char *needle){
 checkf(r->rc>0&&r->rc<124,name,"refuse-rc-nonzero-not-signal-or-timeout");
 checkf(r->outn==0,name,"refuse-empty-stdout");
 checkf(r->errn&&has(r->err,r->errn,needle),name,"refuse-declared-name");
 if(!(r->errn&&has(r->err,r->errn,needle)))printf("STDERR\t%s\trc=%d\t%.*s\n",name,r->rc,(int)(r->errn>200?200:r->errn),r->err?r->err:"");}
static void accept_text(const char *name,const char *text,size_t tn,const ppmap *m,toks *want){
 np_buf pp={0};np_result r;pp_build(&pp,text,tn,m);r=run_pp(name,pp.p,pp.n,0,label_a,0);accept_check(name,&r,pp.p,pp.n,want,0,0);np_free(&r);free(pp.p);}
static void refuse_text(const char *name,const char *text,size_t tn,const char *needle){
 np_buf pp={0};np_result r;pp_build(&pp,text,tn,0);r=run_pp(name,pp.p,pp.n,0,label_a,0);refuse_check(name,&r,needle);np_free(&r);free(pp.p);}

/* ---- plain hand oracle ---- */
static const char *PLAIN="int main(void){return 7;}\n";
static void plain_want(toks *w){tks(w,0,"type=int");tks(w,4,"id=main");tks(w,8,"(");tks(w,9,"type=void");tks(w,13,")");tks(w,14,"{");tks(w,15,"return");tks(w,22,"num=7");tks(w,23,";");tks(w,24,"}");tk_end(w,26);}
static void recover(const char *after){char name[300];toks w={{0},0};int z=snprintf(name,sizeof name,"%s.recovery",after);if(z<0||(size_t)z>=sizeof name)die("label");plain_want(&w);accept_text(name,PLAIN,strlen(PLAIN),0,&w);tfree(&w);}

/* ---- lex.tsv 144 keys: hand fragments; byte0 has class c, byte1 class peek (or end of text for eof) ---- */
typedef struct {const char *c,*peek,*y,*src,*want;} krow;
static const krow K[]={
 {"ws","ws","skip","  x","2:id=x"},{"ws","nl","skip"," \nx","2:id=x"},{"ws","A","skip"," a","1:id=a"},{"ws","d","skip"," 1","1:num=1"},
 {"ws","q","skip"," \"s\";","1:str=\"s\"" E "4:;"},{"ws","sq","skip"," 's'","1:num='s'"},{"ws","slash","skip"," /x","1:/" E "2:id=x"},
 {"ws","star","skip"," *x","1:*" E "2:id=x"},{"ws","punct","skip"," +x","1:+" E "2:id=x"},{"ws","eof","skip"," ",""},
 {"ws","other","skip"," @","!unexpected character"},{"ws","dot","skip"," .x","1:." E "2:id=x"},
 {"nl","ws","nl","\n x","2:id=x"},{"nl","nl","nl","\n\nx","2:id=x"},{"nl","A","nl","\na","1:id=a"},{"nl","d","nl","\n1","1:num=1"},
 {"nl","q","nl","\n\"s\";","1:str=\"s\"" E "4:;"},{"nl","sq","nl","\n's'","1:num='s'"},{"nl","slash","nl","\n/x","1:/" E "2:id=x"},
 {"nl","star","nl","\n*x","1:*" E "2:id=x"},{"nl","punct","nl","\n+x","1:+" E "2:id=x"},{"nl","eof","nl","\n",""},
 {"nl","other","nl","\n@","!unexpected character"},{"nl","dot","nl","\n.x","1:." E "2:id=x"},
 {"A","ws","ident","a x","0:id=a" E "2:id=x"},{"A","nl","ident","a\nx","0:id=a" E "2:id=x"},{"A","A","ident","ab","0:id=ab"},{"A","d","ident","a1","0:id=a1"},
 {"A","q","ident","a\"s\";","0:id=a" E "1:str=\"s\"" E "4:;"},{"A","sq","ident","a's'","0:id=a" E "1:num='s'"},
 {"A","slash","ident","a/x","0:id=a" E "1:/" E "2:id=x"},{"A","star","ident","a*x","0:id=a" E "1:*" E "2:id=x"},
 {"A","punct","ident","a+x","0:id=a" E "1:+" E "2:id=x"},{"A","eof","ident","a","0:id=a"},{"A","other","ident","a@","!unexpected character"},
 {"A","dot","ident","a.x","0:id=a" E "1:." E "2:id=x"},
 {"d","ws","num","1 x","0:num=1" E "2:id=x"},{"d","nl","num","1\nx","0:num=1" E "2:id=x"},{"d","A","num","1u","0:num=1u"},{"d","d","num","12","0:num=12"},
 {"d","q","num","1\"s\";","0:num=1" E "1:str=\"s\"" E "4:;"},{"d","sq","num","1's'","0:num=1" E "1:num='s'"},
 {"d","slash","num","1/x","0:num=1" E "1:/" E "2:id=x"},{"d","star","num","1*x","0:num=1" E "1:*" E "2:id=x"},
 {"d","punct","num","1+x","0:num=1" E "1:+" E "2:id=x"},{"d","eof","num","1","0:num=1"},{"d","other","num","1@","!unexpected character"},
 {"d","dot","num","1.5","0:num=1.5"},
 {"q","ws","str","\" \";","0:str=\" \"" E "3:;"},{"q","nl","str","\"\n\";","!missing terminating '\"' character"},{"q","A","str","\"a\";","0:str=\"a\"" E "3:;"},
 {"q","d","str","\"1\";","0:str=\"1\"" E "3:;"},{"q","q","str","\"\";","0:str=\"\"" E "2:;"},{"q","sq","str","\"'\";","0:str=\"'\"" E "3:;"},
 {"q","slash","str","\"/\";","0:str=\"/\"" E "3:;"},{"q","star","str","\"*\";","0:str=\"*\"" E "3:;"},{"q","punct","str","\"+\";","0:str=\"+\"" E "3:;"},
 {"q","eof","str","\"","!missing terminating '\"' character"},{"q","other","str","\"@\";","0:str=\"@\"" E "3:;"},{"q","dot","str","\".\";","0:str=\".\"" E "3:;"},
 {"sq","ws","charlit","' '","0:num=' '"},{"sq","nl","charlit","'\n'","!missing terminating ' character"},{"sq","A","charlit","'a'","0:num='a'"},{"sq","d","charlit","'1'","0:num='1'"},
 {"sq","q","charlit","'\"'","0:num='\"'"},{"sq","sq","charlit","''","!empty character constant"},{"sq","slash","charlit","'/'","0:num='/'"},{"sq","star","charlit","'*'","0:num='*'"},
 {"sq","punct","charlit","'+'","0:num='+'"},{"sq","eof","charlit","'","!missing terminating ' character"},{"sq","other","charlit","'@'","0:num='@'"},
 {"sq","dot","charlit","'.'","0:num='.'"},
