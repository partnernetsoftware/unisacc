 {"star","q","op","*\"s\";","0:*" E "1:str=\"s\"" E "4:;"},{"star","sq","op","*'s'","0:*" E "1:num='s'"},{"star","slash","op","*/x","0:*" E "1:/" E "2:id=x"},
 {"star","star","op","**x","0:*" E "1:*" E "2:id=x"},{"star","punct","op","*=x","0:*=" E "2:id=x"},{"star","eof","op","*","0:*"},
 {"star","other","op","*@","!unexpected character"},{"star","dot","op","*.x","0:*" E "1:." E "2:id=x"},
 {"punct","ws","op","; x","0:;" E "2:id=x"},{"punct","nl","op","{\nx","0:{" E "2:id=x"},{"punct","A","op","-x","0:-" E "1:id=x"},{"punct","d","op","(1","0:(" E "1:num=1"},
 {"punct","q","op",",\"s\";","0:," E "1:str=\"s\"" E "4:;"},{"punct","sq","op","='s'","0:=" E "1:num='s'"},{"punct","slash","op","!/x","0:!" E "1:/" E "2:id=x"},
 {"punct","star","op","&*x","0:&" E "1:*" E "2:id=x"},{"punct","punct","op","++x","0:++" E "2:id=x"},{"punct","eof","op","}","0:}"},
 {"punct","other","op","~@","!unexpected character"},{"punct","dot","op","[.x","0:[" E "1:." E "2:id=x"},
 {"dot","ws","op",". x","0:." E "2:id=x"},{"dot","nl","op",".\nx","0:." E "2:id=x"},{"dot","A","op",".x","0:." E "1:id=x"},{"dot","d","num",".5","0:num=.5"},
 {"dot","q","op",".\"s\";","0:." E "1:str=\"s\"" E "4:;"},{"dot","sq","op",".'s'","0:." E "1:num='s'"},{"dot","slash","op","./x","0:." E "1:/" E "2:id=x"},
 {"dot","star","op",".*x","0:." E "1:*" E "2:id=x"},{"dot","punct","op",".+x","0:." E "1:+" E "2:id=x"},{"dot","eof","op",".","0:."},
