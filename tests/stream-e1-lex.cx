 {"slash","q","op","/\"s\";","0:/" E "1:str=\"s\"" E "4:;"},{"slash","sq","op","/'s'","0:/" E "1:num='s'"},{"slash","slash","linecmt","//x",""},
 {"slash","star","cmt","/*x*/",""},{"slash","punct","op","/=x","0:/=" E "2:id=x"},{"slash","eof","op","/","0:/"},{"slash","other","op","/@","!unexpected character"},
 {"slash","dot","op","/.x","0:/" E "1:." E "2:id=x"},
