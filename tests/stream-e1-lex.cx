static int is_punct_tok(const char *s,size_t n){int i;for(i=5;i<ntokdom;i++){const char *t=tokdom[i];if(strlen(t)==n&&!memcmp(t,s,n)&&!((t[0]>='a'&&t[0]<='z')||t[0]=='_'))return 1;}return 0;}
/* first expected token must agree with the gold y of the key */
static int y_consistent(const krow *k){const char *w=k->want,*y=k->y;size_t tl;const char *t,*e;
 if(w[0]=='!'){if(tx_eqz(y, "bad"))return tx_eqz(w+1, BADCH);if(tx_eqz(y, "str"))return tx_eqz(w+1, NOQ);if(tx_eqz(y, "charlit"))return tx_eqz(w+1, NOSQ)||(tx_eqz(k->peek, "sq")&&tx_eqz(w+1, "empty character constant"));return tx_eqz(k->peek, "other")&&tx_eqz(w+1, BADCH);}
 if(tx_eqz(y, "cmt")||tx_eqz(y, "linecmt"))return w[0]==0;
 if(tx_eqz(y, "skip")||tx_eqz(y, "nl"))return !(w[0]=='0'&&w[1]==':');
 if(!(w[0]=='0'&&w[1]==':'))return 0;t=w+2;e=t;while(*e&&*e!='\001')e++;tl=(size_t)(e-t);
 if(tx_eqz(y, "ident"))return tl>3&&!memcmp(t,"id=",3);
 if(tx_eqz(y, "num"))return tl>4&&!memcmp(t,"num=",4)&&t[4]!='\'';
 if(tx_eqz(y, "str"))return tl>4&&!memcmp(t,"str=\"",5);
 if(tx_eqz(y, "charlit"))return tl>4&&!memcmp(t,"num='",5);
 if(tx_eqz(y, "op"))return is_punct_tok(t,tl);
 return 0;}
static void mode_lex144(void){
 int seen[12][12],i,j,nk=(int)(sizeof K/sizeof K[0]),table_ok=1,ycons=1;np_buf txt={0};toks w={{0},0};char name[200];
 for(i=0;i<12;i++)for(j=0;j<12;j++)seen[i][j]=0;
 for(i=0;i<nk;i++){int c=cidx(K[i].c,strlen(K[i].c)),p=cidx(K[i].peek,strlen(K[i].peek));size_t sl=strlen(K[i].src);
  int ok=c>=0&&p>=0&&c!=9&&tx_eqz(ytab[c][p], K[i].y)&&sl>=1&&bcls[(unsigned char)K[i].src[0]]==c&&(p==9?sl==1:(sl>=2&&bcls[(unsigned char)K[i].src[1]]==p));
  if(ok)seen[c][p]++;else{table_ok=0;printf("TABLE\tlex144\t%s.%s\tgold_y=%s\trow_y=%s\n",K[i].c,K[i].peek,(c>=0&&p>=0)?ytab[c][p]:"?",K[i].y);}
  if(!y_consistent(&K[i])){ycons=0;printf("YCONS\tlex144\t%s.%s\n",K[i].c,K[i].peek);}}
 for(j=0;j<12;j++)seen[9][j]++;/* c=eof row: one observable, the empty-text run below */
 for(i=0;i<12;i++)for(j=0;j<12;j++)if(seen[i][j]!=1){table_ok=0;printf("TABLE\tlex144\tkey %s.%s seen=%d\n",cname[i],cname[j],seen[i][j]);}
 check(table_ok,"lex144.table-binds-all-144-gold-keys-and-lexcls-classes");
 check(ycons,"lex144.expected-first-token-agrees-with-gold-y");
 /* one joined run for every key whose peek byte stays in-stream and whose text is accepted */
 for(i=0;i<nk;i++)if(!tx_eqz(K[i].peek, "eof")&&K[i].want[0]!='!')jf(&txt,&w,K[i].src,strlen(K[i].src),K[i].want);
 np_put(&txt,"\n",1);tk_end(&w,(unsigned)txt.n);accept_text("lex144.joined-in-stream-keys",txt.p,txt.n,0,&w);free(txt.p);tfree(&w);
 /* separate runs: end-of-text peek and refusals */
 for(i=0;i<nk;i++){if(tx_eqz(K[i].peek, "eof")||K[i].want[0]=='!'){int z=snprintf(name,sizeof name,"lex144.%s.%s",K[i].c,K[i].peek);if(z<0||(size_t)z>=sizeof name)die("label");
  if(K[i].want[0]=='!')refuse_text(name,K[i].src,strlen(K[i].src),K[i].want+1);
  else{toks x={{0},0};want_spec(&x,0,K[i].want);tk_end(&x,(unsigned)strlen(K[i].src));accept_text(name,K[i].src,strlen(K[i].src),0,&x);tfree(&x);}}}
 {toks x={{0},0};tk_end(&x,0);accept_text("lex144.eof.all-peek-empty-text",0,0,0,&x);tfree(&x);}}

/* ---- --tokens mode ---- */
typedef struct {const char *src,*want;} frag;
static void frag_case(const char *name,const frag *fs,int n,const ppmap *m){np_buf txt={0};toks w={{0},0};int i;
 for(i=0;i<n;i++)jf(&txt,&w,fs[i].src,strlen(fs[i].src),fs[i].want);np_put(&txt,"\n",1);tk_end(&w,(unsigned)txt.n);
 accept_text(name,txt.p,txt.n,m,&w);free(txt.p);tfree(&w);}
