 {"other","ws","bad","@ x","!unexpected character"},{"other","nl","bad","$\nx","!unexpected character"},{"other","A","bad","#a","!unexpected character"},
 /* Backslash has its own UCN scanner; use an ordinary bad byte for this gold class. */
 {"other","d","bad","`1","!unexpected character"},{"other","q","bad","@\"s\"","!unexpected character"},{"other","sq","bad","\x7f's'","!unexpected character"},
 {"other","slash","bad","\x80/x","!unexpected character"},{"other","star","bad","\xff*x","!unexpected character"},{"other","punct","bad","\x1b+x","!unexpected character"},
