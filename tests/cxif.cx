#pragma unisa use text.text
#!/usr/bin/env -S unisacc.com -run
/* cxif.cx -- check the CXIF v0 text that -cx-interface already prints.
   The grammar is the generator in src/cxmod.c: one banner, a matching
   include guard, then type text and function prototypes, then #endif.
   A prototype has no body. static names are absent. This file does not
   change the compiler and does not add effect, layout, or ownership fields.
   usage, from the repo root:
     sh ./unisacc.com -run tests/cxif.cx -- --fixtures
     sh ./unisacc.com -run tests/cxif.cx -- --check FILE STEM */

#define CXIF_LINES 256
#define CXIF_NEED 8

static int fails;
static char logb[8000];
static size_t logn;

static void addlog(const char *s) {
    size_t n = strlen(s);
    printf("%s\n", s);
    if (logn + n + 2 < sizeof logb) {
        {void *cx_kept=memcpy(logb + logn, s, n);(void)cx_kept;}
        logn += n;
        logb[logn++] = '\n';
        logb[logn] = 0;
    }
}

static void fail(const char *s) { fails++; addlog(s); }

static int hex16(const char *s) {
    int i;
    for (i = 0; i < 16; i++) {
        char c = s[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 0;
    }
    return 1;
}

static int is_id0(int c) { return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_'; }
static int is_id(int c) { return is_id0(c) || (c >= '0' && c <= '9'); }

static int has_ident(const char *s, const char *name) {
    size_t n = strlen(name), i = 0;
    while (s[i]) {
        if (is_id0((unsigned char)s[i])) {
            size_t k = i;
            while (is_id((unsigned char)s[k])) k++;
            if (k - i == n && !memcmp(s + i, name, n)) return 1;
            i = k;
        } else i++;
    }
    return 0;
}

static int line_is(const char *s, const char *want) { return tx_eq(s, want, 1L << 20); }

static int lines_have(char **lines, int n, const char *name) {
    int i;
    for (i = 0; i < n; i++) if (has_ident(lines[i], name)) return 1;
    return 0;
}

/* 0 grammar holds. Reasons are logged. stem is the file stem. */
static int check_text(char *text, const char *stem, const char **need, int nneed, const char **ban, int nban) {
    char *lines[CXIF_LINES], guard[128], msg[240];
    int n = 0, i, depth = 0, body;
    char *p = text;
    fails = 0; logn = 0; logb[0] = 0;
    while (*p && n < CXIF_LINES) {
        lines[n++] = p;
        while (*p && *p != '\n') p++;
        if (*p == '\n') { *p = 0; p++; }
    }
    if (*p) { fail("cxif: too many lines"); return fails; }
    while (n > 0 && !lines[n - 1][0]) n--;
    if (n < 4) { fail("cxif: short text"); return fails; }
    {
        const char *pre = "/* CXIF v0 module ";
        size_t pl = strlen(pre), sl = strlen(stem);
        char *s = lines[0];
        if (strncmp(s, pre, pl) || strncmp(s + pl, stem, sl) || strncmp(s + pl + sl, " src-sha256 ", 12)) {
            fail("cxif: banner is not CXIF v0 for this stem");
            return fails;
        }
        s += pl + sl + 12;
        if (!hex16(s) || strcmp(s + 16, " -- generated, do not edit */")) {
            fail("cxif: banner sha or trailer");
            return fails;
        }
        if (cx_fmt(guard, sizeof guard, "CXIF_%s_%.16s", stem, s) < 0) { fail("cxif: guard"); return fails; }
    }
    if (cx_fmt(msg, sizeof msg, "#ifndef %s", guard) < 0 || !line_is(lines[1], msg)) { fail("cxif: ifndef guard"); return fails; }
    if (cx_fmt(msg, sizeof msg, "#define %s", guard) < 0 || !line_is(lines[2], msg)) { fail("cxif: define guard"); return fails; }
    if (!line_is(lines[n - 1], "#endif")) { fail("cxif: missing endif"); return fails; }
    body = 0;
    for (i = 3; i < n - 1; i++) {
        const char *s = lines[i];
        int j;
        if (s[0] == '#') { fail("cxif: directive in body"); continue; }
        if (has_ident(s, "static")) { fail("cxif: body is not a declaration"); }
        for (j = 0; s[j]; j++) {
            if (s[j] == '{') depth++;
            if (s[j] == '}') { depth--; if (depth < 0) fail("cxif: brace"); }
            if (s[j] == ')' && (s[j + 1] == '{' || (s[j + 1] == ' ' && s[j + 2] == '{'))) fail("cxif: function body");
        }
        if (s[0]) body = 1;
    }
    if (depth != 0) fail("cxif: unbalanced braces");
    if (!body) fail("cxif: empty body");
    for (i = 0; i < nneed; i++) if (!lines_have(lines, n, need[i])) {
        cx_fmt(msg, sizeof msg, "cxif: missing %s", need[i]); fail(msg);
    }
    for (i = 0; i < nban; i++) if (lines_have(lines, n, ban[i])) {
        cx_fmt(msg, sizeof msg, "cxif: forbidden %s", ban[i]); fail(msg);
    }
    if (!fails) addlog("cxif: ok");
    return fails;
}

static int live(const char *path, const char *stem, const char **need, int nneed, const char **ban, int nban) {
    char cmd[512], *out = 0; size_t n = 0; int rc;
    if (cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com -cx-interface %s", path) < 0) return -1;
    rc = cx_run(cmd, &out, &n);
    if (rc != 0 || !out) {
        fprintf(stderr, "cxif: -cx-interface %s rc %d\n", path, rc);
        free(out);
        return -1;
    }
    rc = check_text(out, stem, need, nneed, ban, nban);
    free(out);
    return rc;
}

static int expect_live(const char *path, const char *stem, const char **need, int nneed, const char **ban, int nban) {
    int rc = live(path, stem, need, nneed, ban, nban);
    if (rc != 0) { fprintf(stderr, "cxif: live %s rc %d\n%s", path, rc, logb); return 1; }
    printf("cxif: fixture %s matched\n", path);
    return 0;
}

static int expect_text(const char *label, const char *text, const char *stem, const char *needle) {
    char *copy = malloc(strlen(text) + 1);
    int rc;
    if (!copy) return 1;
    {void *cx_kept=memcpy(copy, text, strlen(text) + 1);(void)cx_kept;}
    rc = check_text(copy, stem, 0, 0, 0, 0);
    free(copy);
    if (rc <= 0 || !strstr(logb, needle)) {
        fprintf(stderr, "cxif: text %s rc %d\n%s", label, rc, logb);
        return 1;
    }
    printf("cxif: fixture %s matched\n", label);
    return 0;
}

static int at_root(void) {
    char *cdup = 0; size_t cl = 0; int rc = cx_run("git rev-parse --show-cdup", &cdup, &cl);
    int bad = rc != 0 || !cdup || cl > 1;
    free(cdup);
    if (bad) fprintf(stderr, "cxif: run from the repo root\n");
    return bad ? -1 : 0;
}

int main(int argc, char **argv) {
    const char *mark_need[] = {"pack_extra", "pack_mark"};
    const char *mark_ban[] = {"pack_hide"};
    const char *box_need[] = {"box_point", "box_id", "box_make"};
    const char *box_ban[] = {"box_hide"};
    const char *good =
        "/* CXIF v0 module mark src-sha256 0123456789abcdef -- generated, do not edit */\n"
        "#ifndef CXIF_mark_0123456789abcdef\n"
        "#define CXIF_mark_0123456789abcdef\n"
        "int pack_mark(int n);\n"
        "#endif\n";
    const char *bad_end =
        "/* CXIF v0 module mark src-sha256 0123456789abcdef -- generated, do not edit */\n"
        "#ifndef CXIF_mark_0123456789abcdef\n"
        "#define CXIF_mark_0123456789abcdef\n"
        "int pack_mark(int n);\n";
    const char *bad_body =
        "/* CXIF v0 module mark src-sha256 0123456789abcdef -- generated, do not edit */\n"
        "#ifndef CXIF_mark_0123456789abcdef\n"
        "#define CXIF_mark_0123456789abcdef\n"
        "int pack_mark(int n) { n = n; }\n"
        "#endif\n";
    const char *bad_static =
        "/* CXIF v0 module mark src-sha256 0123456789abcdef -- generated, do not edit */\n"
        "#ifndef CXIF_mark_0123456789abcdef\n"
        "#define CXIF_mark_0123456789abcdef\n"
        "static int pack_mark(int n);\n"
        "#endif\n";
    const char *bad_ver =
        "/* CXIF v1 module mark src-sha256 0123456789abcdef -- generated, do not edit */\n"
        "#ifndef CXIF_mark_0123456789abcdef\n"
        "#define CXIF_mark_0123456789abcdef\n"
        "int pack_mark(int n);\n"
        "#endif\n";
    int bad = 0;
    if (at_root()) return 2;
    if (argc == 4 && tx_eq(argv[1], "--check", 1L << 20)) {
        const char *need[] = {0};
        int rc = live(argv[2], argv[3], need, 0, need, 0);
        return rc < 0 ? 2 : rc > 0 ? 1 : 0;
    }
    if (argc == 2 && tx_eq(argv[1], "--fixtures", 1L << 20)) {
        bad += expect_live("tests/cxpack/ok/mark.cx", "mark", mark_need, 2, mark_ban, 1);
        bad += expect_live("tests/cxif/box.cx", "box", box_need, 3, box_ban, 1);
        bad += expect_text("missing-endif", bad_end, "mark", "cxif: missing endif");
        bad += expect_text("function-body", bad_body, "mark", "cxif: function body");
        bad += expect_text("static-name", bad_static, "mark", "cxif: body is not a declaration");
        bad += expect_text("wrong-version", bad_ver, "mark", "cxif: banner is not CXIF v0");
        {
            char *copy = malloc(strlen(good) + 1);
            int rc;
            if (!copy) return 1;
            {void *cx_kept=memcpy(copy, good, strlen(good) + 1);(void)cx_kept;}
            rc = check_text(copy, "mark", mark_need + 1, 1, mark_ban, 1);
            free(copy);
            if (rc != 0) { fprintf(stderr, "cxif: banner-ok rc %d\n%s", rc, logb); bad++; }
            else printf("cxif: fixture banner-ok matched\n");
        }
        if (bad) return 1;
        printf("cxif: fixtures ok\n");
        return 0;
    }
    fprintf(stderr, "usage: cxif.cx --check FILE STEM | --fixtures\n");
    return 2;
}
