/* Always validate source bytes and every row against compiled derived data. */
#pragma unisa use cxlib.metadata
#pragma unisa use cxlib.seedparts
int main(int argc,char **argv){md_table *t;size_t i;if(argc!=2){fputs("usage: metadatalist.cx TSV\n",stderr);return 2;}t=md_load(argv[1]);
 if(strcmp(t->source_sha256,scp_source_sha256())||t->n!=scp_count()){fputs("metadata: generated module is stale\n",stderr);return 2;}
 for(i=0;i<t->n;i++)if(strcmp(t->names[i],scp_name(i))||t->automatic[i]!=scp_auto(i)){fputs("metadata: generated row differs\n",stderr);return 2;}
 md_list(t);return 0;}
