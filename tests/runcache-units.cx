/* runcache-units.cx -- 20-unit default-run cache vs {candidate}.
   usage: sh ./unisacc.com tests/runcache-units.cx -- NEW_OUT CANDIDATE
   Second run must store nothing (hit). Changing one unit must store again (miss). */
#pragma unisa use text.text
#pragma unisa use sys.fs

#define CAP 65536
static int checks, failed;
static char work[2048], cache[2200], src[2200], names[20][2300], prints[4][CAP];

static void die(const char *s) { fprintf(stderr, "runcache-units: %s\n", s); exit(2); }
static void ck(int yes, const char *name) {
    checks++;
    if (!yes) failed++;
    printf("%s\truncache-units.%s\n", yes ? "PASS" : "FAIL", name);
}
static int same(const char *a, const char *b) { return tx_eq(a, b, CAP); }

typedef struct { char *p; long n; } Print;
static int print_one(const char *file, void *ctx) {
    Print *f = ctx;
    sy_stat_t st;
    char row[2400];
    long k;
    if (sy_stat(file, &st)) return -1;
    if (cx_fmt(row, sizeof row, "%s %ld\n", file, st.ino)) return -1;
    k = tx_len(row, sizeof row);
    if (f->n + k >= CAP) return -1;
    tx_copy(f->p + f->n, CAP - f->n, row, k);
    f->n += k;
    return 0;
}
static const char *fingerprint(int slot) {
    Print f = {prints[slot], 0};
    prints[slot][0] = 0;
    if (cx_walk(cache, print_one, &f)) die("cache-walk");
    return prints[slot];
}

static int run_units(const char *cand, char **outp) {
    char envc[2300], *v[40], *out = 0;
    size_t n = 0;
    int k = 0, i, rc;
    if (cx_fmt(envc, sizeof envc, "UNISACC_E3CACHE=%s", cache)) die("env");
    v[k++] = "env";
    v[k++] = envc;
    v[k++] = (char *)cand;
    for (i = 0; i < 20; i++) v[k++] = names[i];
    v[k++] = "--";
    v[k] = 0;
    rc = cx_runv_timeout(v, 55, &out, &n);
    if (outp) *outp = out ? out : "";
    return rc;
}

int main(int argc, char **argv) {
    char path[2300], body[256];
    FILE *fp;
    int i;
    char *out = 0;
    if (argc != 3) die("usage: NEW_OUT CANDIDATE");
    if (cx_fmt(work, sizeof work, "%s", argv[1])) die("path");
    if (sy_mkdir(work, 0700)) die("NEW_OUT");
    if (cx_fmt(cache, sizeof cache, "%s/cache", work) || sy_mkdir(cache, 0700)) die("cache");
    if (cx_fmt(src, sizeof src, "%s/src", work) || sy_mkdir(src, 0700)) die("src");
    for (i = 0; i < 19; i++) {
        if (cx_fmt(names[i], 2300, "%s/u%d.c", src, i)) die("path");
        if (cx_fmt(body, sizeof body, "int f%d(void){return %d;}\n", i, i)) die("fmt");
        if (cx_write(names[i], body, (size_t)tx_len(body, sizeof body))) die("write");
    }
    if (cx_fmt(names[19], 2300, "%s/main.c", src)) die("path");
    {   static const char mainsrc[] = "int f0(void);int f18(void);int main(void){return f0()+f18();}\n";
        if (cx_write(names[19], mainsrc, sizeof mainsrc - 1)) die("write"); }
    /* main returns f0()+f18() = 0+18: the program's exit status must be exactly 18 */
    ck(run_units(argv[2], &out) == 18, "cold-rc");
    ck(fingerprint(0)[0] != 0, "cold-stores");
    ck(run_units(argv[2], &out) == 18, "hot-rc");
    /* snapshot the tree once into slot 1 and compare with the saved cold snapshot in prints[0];
       calling fingerprint(0) again here would resample and overwrite the cold baseline */
    fingerprint(1);
    ck(same(prints[0], prints[1]), "hot-stores-nothing");
    if (cx_fmt(body, sizeof body, "int f5(void){return 50;}\n")) die("fmt");
    if (cx_write(names[5], body, (size_t)tx_len(body, sizeof body))) die("rewrite");
    /* f5 is not called by main, so the exit status stays 18 while the source key changes */
    ck(run_units(argv[2], &out) == 18, "changed-rc");
    /* snapshot once into slot 2 and compare with the saved hot snapshot in prints[1] */
    fingerprint(2);
    ck(!same(prints[1], prints[2]), "changed-stores");
    printf("RUNCACHE_UNITS\tassertions=%d\tfailed=%d\n", checks, failed);
    return failed ? 1 : 0;
}
