/* Real release-build dispatcher fixtures; fake images test orchestration only. */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.productpkg
#pragma unisa use sys.time
#pragma unisa use mem.bytes
static char wd_root[4096],wd_work[4096],wd_fix[4096],wd_tool[4096],wd_ctor[4096],wd_pkg[4096];
static int wd_checks,wd_bad;
static void wd_die(const char *s){fprintf(stderr,"whole-o-deadline: %s; retained=%s\n",s,wd_work);exit(2);}
static void wd_ck(int v,const char *s){wd_checks++;wd_bad+=!v;printf("%s\t%s\n",v?"PASS":"FAIL",s);}
static void wd_path(char *p,const char *a,const char *b){if(snprintf(p,4096,"%s/%s",a,b)>=4096)wd_die("path");}
static void wd_write(const char *p,const char *s){if(cx_write(p,s,strlen(s)))wd_die("write");}
static char *wd_read(const char *p,size_t *n){char *b=cx_read(p,n);if(!b)wd_die(p);return b;}
static np_result wd_run(char **v,const char *cwd,int sec){np_result r={0};char why[400]={0};if(np_run(v,cwd,0,sec,&r,why,sizeof why)||r.residue){fprintf(stderr,"%s\n",why);wd_die("child transport");}return r;}
static void wd_ok(char **v,const char *cwd,int sec){np_result r=wd_run(v,cwd,sec);if(r.rc){fprintf(stderr,"%.*s",(int)r.errn,r.err?r.err:"");wd_die("prepare child");}np_free(&r);}
static int wd_missing(const char *p){struct stat s;if(!lstat(p,&s))return 0;if(errno!=ENOENT)wd_die("stat failure");return 1;}
static void wd_compile(const char *src,const char *exe,int sec){char com[4096];wd_path(com,wd_root,"unisacc.com");char *v[]={"sh",com,"-o",(char *)exe,(char *)src,0};wd_ok(v,wd_root,sec);}
static char wd_sources[44][256];
static void wd_static(void){char p[4096];size_t n;wd_path(p,wd_root,"tools/release-build.cx");char *b=wd_read(p,&n);wd_ck(strstr(b,"#define RB_WHOLE_DEADLINE_MS 60000")!=0,"default ceiling is60000ms");char *f=strstr(b,"static long rb_whole_deadline(void)"),*e=f?strstr(f,"\n}"):0;wd_ck(f&&e&&strstr(f,"ms < 1 || ms > RB_WHOLE_DEADLINE_MS")&&strstr(f,"if (*p ||")&&strstr(f,"return RB_WHOLE_DEADLINE_MS;"),"invalid and above-ceiling override fall back to default");char *a=strstr(b,"rb_whole_src[RB_WHOLE_SRC] = {"),*z=a?strstr(a,"};"):0;int count=0;if(a&&z)for(char *q=a;q<z;q++)if(*q=='"'){char *t=strchr(q+1,'"');if(!t||t>=z||count==44||t-q-1>=256)wd_die("source array");mm_copy(wd_sources[count], t-q-1, q+1, t-q-1);wd_sources[count++][t-q-1]=0;q=t;}wd_ck(count==44,"actual whole-o source array has44roots");if(count!=44)wd_die("source count");free(b);}
static void wd_case(const char *mode,const char *budget,int timeout){char out[4096],image[4096],p[4096],rev[100],snap[4096];wd_path(out,wd_fix,mode);if(mkdir(out,0700))wd_die("case directory");char *v[]={"env",0,0,0,wd_tool,"slice",wd_fix,wd_pkg,out,"--target","osx/arm64",0};char ev1[4200],ev2[100],ev3[100];(cx_fmt(ev1, sizeof ev1, "UNISACC_CTOR=%s", wd_ctor) ? exit(2) : (void)0);(cx_fmt(ev2, sizeof ev2, "UNISACC_RB_WHOLE_MS=%s", budget) ? exit(2) : (void)0);(cx_fmt(ev3, sizeof ev3, "WHOLE_FAKE_MODE=%s", mode) ? exit(2) : (void)0);v[1]=ev1;v[2]=ev2;v[3]=ev3;long long before=sy_now_ms();np_result r=wd_run(v,wd_root,8);long long elapsed=sy_now_ms()-before;wd_path(image,out,"slice-osx-arm64");wd_ck(timeout?r.rc==1:r.rc==0,timeout?"short deadline actually rejects":"fast constructor succeeds");wd_ck(elapsed<8000,"case remains below8seconds");wd_ck(timeout?(r.out&&strstr(r.out,"timeout after 1500ms")&&r.err&&strstr(r.err,"whole-o timeout")):(r.out&&strstr(r.out,"target=osx/arm64")&&strstr(r.out,"rc=0")),"dispatcher emits expected terminal status");np_free(&r);
char *gv[]={"git","rev-parse","HEAD",0};r=wd_run(gv,wd_fix,3);if(r.rc||r.outn<40)wd_die("fixture rev");mm_copy(rev, 40, r.out, 40);rev[40]=0;np_free(&r);(cx_fmt(snap, sizeof snap, "%s/out/release-snap-%.10s", wd_fix, rev) ? exit(2) : (void)0);
(cx_fmt(p, sizeof p, "%s.argv", image) ? exit(2) : (void)0);size_t n;char *args=wd_read(p,&n),*q=args;char expected[8192];(cx_fmt(expected, sizeof expected, "CWD\t%s\nCONTAINER\t%s\nARGC\t49\nARG\t-b\nARG\tosx/arm64\nARG\t-o\nARG\t%s\n", snap, wd_pkg, image) ? exit(2) : (void)0);int equal=!strncmp(q,expected,strlen(expected));q+=equal?strlen(expected):0;for(int i=0;i<44&&equal;i++){(cx_fmt(expected, sizeof expected, "ARG\t%s/%s\n", snap, wd_sources[i]) ? exit(2) : (void)0);size_t k=strlen(expected);if(strncmp(q,expected,k))equal=0;else q+=k;}wd_ck(equal&&!*q,"complete ordered44argv physical cwd and exact container");free(args);
if(timeout){wd_ck(wd_missing(image),"timeout removes partial image");wd_path(p,out,"receipt.txt");wd_ck(wd_missing(p),"timeout publishes no success receipt");(cx_fmt(p, sizeof p, "%s.pids", image) ? exit(2) : (void)0);char *b=wd_read(p,&n);int pid=0,child=0,group=0;if(sscanf(b,"%d %d %d",&pid,&child,&group)!=3)wd_die("pid evidence");free(b);int gone=0;for(int i=0;i<30;i++){errno=0;int a=kill(pid,0),ae=errno;errno=0;int c=kill(child,0),ce=errno;errno=0;int g=kill(-group,0),ge=errno;if(a==-1&&ae==ESRCH&&c==-1&&ce==ESRCH&&g==-1&&ge==ESRCH){gone=1;break;}usleep(20000);}wd_ck(gone,"constructor child and process group gone after reap");}
else{char *img=wd_read(image,&n),h[65];cx_sha256_hex(img,n,h);wd_ck(n==strlen("whole-fixture-image\n")&&!memcmp(img,"whole-fixture-image\n",n),"success image is actual constructor output");free(img);wd_path(p,out,"receipt.txt");char *rec=wd_read(p,&n);(cx_fmt(expected, sizeof expected, "sha\t%s\n", h) ? exit(2) : (void)0);wd_ck(strstr(rec,"route\twhole-o\n")&&strstr(rec,"target\tosx/arm64\n")&&strstr(rec,"bytes\t20\n")&&strstr(rec,expected)&&strstr(rec,"rc\t0\n"),"success receipt binds actual target SHA and bytes");free(rec);}}
int main(void){if(!realpath(".",wd_root))wd_die("root");char temp[]="/tmp/whole-o-deadline-XXXXXX";if(!mkdtemp(temp)||!realpath(temp,wd_work))wd_die("physical temp");wd_static();wd_path(wd_tool,wd_work,"release-build");char src[4096];wd_path(src,wd_root,"tools/release-build.cx");wd_compile(src,wd_tool,35);wd_path(wd_ctor,wd_work,"fake-ctor");wd_path(src,wd_work,"fake.cx");wd_write(src,
"int main(int argc,char **argv){if(argc!=49)return 3;char p[8192],cwd[4096];if(!getcwd(cwd,sizeof cwd))return 4;snprintf(p,sizeof p,\"%s.argv\",argv[4]);FILE *f=fopen(p,\"w\");if(!f)return 5;fprintf(f,\"CWD\\t%s\\nCONTAINER\\t%s\\nARGC\\t%d\\n\",cwd,getenv(\"UNISA_CONTAINER\"),argc);for(int i=1;i<argc;i++)fprintf(f,\"ARG\\t%s\\n\",argv[i]);fclose(f);f=fopen(argv[4],\"w\");if(!f)return 6;fputs(\"whole-fixture-image\\n\",f);fclose(f);if(!strcmp(getenv(\"WHOLE_FAKE_MODE\"),\"timeout\")){int child=fork();if(child<0)return 7;if(!child){for(int i=0;i<200;i++)usleep(100000);return 0;}snprintf(p,sizeof p,\"%s.pids\",argv[4]);f=fopen(p,\"w\");if(!f)return 8;fprintf(f,\"%d %d %d\\n\",getpid(),child,getpgrp());fclose(f);for(int i=0;i<200;i++)usleep(100000);}return 0;}\n");wd_compile(src,wd_ctor,12);wd_path(wd_fix,wd_work,"fixture");if(mkdir(wd_fix,0700))wd_die("fixture mkdir");char *init[]={"git","init","-q",0};wd_ok(init,wd_fix,3);wd_path(src,wd_fix,"tracked.txt");wd_write(src,"fixture\n");char *add[]={"git","add","tracked.txt",0};wd_ok(add,wd_fix,3);char *commit[]={"git","-c","user.name=fixture","-c","user.email=fixture@invalid","commit","-qm","fixture",0};wd_ok(commit,wd_fix,3);if(pp_copy_product(wd_root,wd_fix))wd_die("product copy");char from[4096];wd_path(from,wd_root,"unisacc.com.build.json");size_t n;char *b=wd_read(from,&n);wd_path(src,wd_fix,"unisacc.com.build.json");if(cx_write(src,b,n))wd_die("record copy");free(b);wd_path(src,wd_fix,"out");if(mkdir(src,0700))wd_die("out mkdir");wd_path(wd_pkg,wd_work,"input.pkg");wd_write(wd_pkg,"fixture-container\n");wd_case("timeout","1500",1);wd_case("success","5000",0);printf("WHOLE_O_DEADLINE_CHECK\tchecks=%d\tfailed=%d\tretained=%s\n",wd_checks,wd_bad,wd_work);return wd_bad?1:0;}
