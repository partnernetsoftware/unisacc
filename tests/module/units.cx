#pragma unisa use compiler.cxmod
#pragma unisa use runtime.routestep
#pragma unisa use runtime.stagehandoff
#pragma unisa use runtime.holdframe
#pragma unisa use text.fmt
int dv_expand(int *, const char **, int);
int dv_fwd_splice(const char *, int, const char **, unsigned char **, long *, char *, int);
int hs_cxm_rd(char *, char *, int);
int hs_cxm_wr(char *, char *, int);
int hs_cxm_say(int, char *, int);
void hs_cxm_sha(char *, int, char *);

static char names[129][32];
static char *paths[129];
static const char *sources[129];
int main(void) {
    FILE *table; char line[128], expected[32], forward[32], why[128]; int n, i, failed = 0;
    unsigned char *out; long outn;
    if (cxm_bind(hs_cxm_rd, hs_cxm_wr, hs_cxm_say, hs_cxm_sha, "/tmp")) return 2;
    for (i = 0; i < 129; i++) { tx_snprintf(names[i], sizeof names[i], "unit%d.c", i); paths[i] = names[i]; sources[i] = names[i]; }
    table = fopen("tests/module/boundary.tsv", "r"); if (!table || !fgets(line, sizeof line, table)) return 2;
    while (fgets(line, sizeof line, table)) {
        int plan, expand, count, ok;
        if (sscanf(line, "%d %31s %31s", &n, expected, forward) != 3 || n < 1 || n > 129) return 2;
        cxm_set_funit(0); plan = cxm_plan(paths, n); count = n; expand = dv_expand(&count, sources, 0);
        ok = n <= DV_MAXU ? !plan && cxm_count() == n && !expand && count == n : plan && expand;
        printf("%s\tunits-%d\tcxmod=%d\tdriveplan=%d\tcount=%d\n", ok ? "PASS" : "FAIL", n, plan, expand, count);
        if (!ok) failed++;
        if (n >= 127) {
            unsigned char frame[8] = {4,0,0,0,0,0,0,0};
            int rc, admitted = !strcmp(forward, "accept");
            if (hf_keep(frame, 8, 0, 0)) return 2;
            sources[1] = "/nonexistent-module-unit-stub.c";
            why[0] = 0; out = 0; outn = 0;
            rc = dv_fwd_splice("lnx/x86_64", n + 1, sources, &out, &outn, why, sizeof why);
            ok = admitted ? rc == 5 : rc == 1 && !strcmp(why, "forwarding stub");
            printf("%s\tforward-original-%d\tstatus=%d\n", ok ? "PASS" : "FAIL", n, rc);
            if (!ok) failed++;
        }
    }
    fclose(table);
    sources[0] = "tests/module/root.cx"; n = 1;
    i = dv_expand(&n, sources, 0);
    if (i || n != 2 || !strstr(sources[1], "tests/module/leaf.cx")) { puts("FAIL\tuse-expansion"); failed++; }
    else puts("PASS\tuse-expansion");
    sources[0] = "tests/module/root.cx"; n = 1;
    i = dv_expand(&n, sources, 1);
    if (i || n != 1) { puts("FAIL\tuse-funit"); failed++; }
    else puts("PASS\tuse-funit");
    out = 0; outn = 0; why[0] = 0;
    i = dv_fwd_splice("lnx/x86_64", 2, sources, &out, &outn, why, sizeof why);
    if (i != 1 || strcmp(why, "forwarding stub") || out || outn) { puts("FAIL\tforwarding-missing-frame"); failed++; }
    else puts("PASS\tforwarding-missing-frame");
    /* one module file reached through a directory symlink and through its real directory is one module:
       text identity (no canonical-path callback) refuses it as exported by both, the bound host callback
       (dv_expand -> cxm_bind_real(hs_cxm_real)) plans it as main + one module. */
    {
        char base[64] = "/tmp/module-units-XXXXXX", p[160], q[160], mainp[160]; FILE *f; char *one[1]; int made = 0;
        if (mkdtemp(base)) {
            tx_snprintf(p, sizeof p, "%s/real", base); tx_snprintf(q, sizeof q, "%s/link", base);
            if (!mkdir(p, 0700) && !symlink("real", q)) {
                tx_snprintf(p, sizeof p, "%s/real/env.cx", base); f = fopen(p, "w");
                if (f) { fputs("#pragma unisa module env\nint me_same(void){return 3;}\n", f); made = !fclose(f); }
                tx_snprintf(mainp, sizeof mainp, "%s/main.cx", base); f = made ? fopen(mainp, "w") : 0; made = 0;
                if (f) { fputs("#pragma unisa use real.env\n#pragma unisa use link.env\nint main(void){return me_same();}\n", f); made = !fclose(f); }
            }
        }
        if (!made) { puts("FAIL\tsymlink-fixture"); failed++; }
        else {
            one[0] = mainp; cxm_bind_real(0); cxm_set_funit(0);
            i = cxm_plan(one, 1);
            if (!i) { puts("FAIL\tsymlink-text-identity-refused"); failed++; } else puts("PASS\tsymlink-text-identity-refused");
            sources[0] = mainp; n = 1;
            i = dv_expand(&n, sources, 0);
            if (i || n != 2) { printf("FAIL\tsymlink-one-module\trc=%d\tunits=%d\n", i, n); failed++; } else puts("PASS\tsymlink-one-module");
        }
        /* two lexical entries of one module merge only when their own use names resolve to the same files
           beside both entries (cxm_deps_same, as cx/cx0/plan.cx): a dependency beside the shared directory
           is accepted, a dependency neither entry has beside it (package root on both sides) is refused. */
        if (made) {
            made = 0;
            tx_snprintf(p, sizeof p, "%s/real/dep.cx", base); f = fopen(p, "w");
            if (f) { fputs("#pragma unisa module dep\nint md_v(void){return 4;}\n", f); made = !fclose(f); }
            tx_snprintf(p, sizeof p, "%s/real/env2.cx", base); f = made ? fopen(p, "w") : 0; made = 0;
            if (f) { fputs("#pragma unisa module env2\n#pragma unisa use dep\nint me2_same(void){return md_v();}\n", f); made = !fclose(f); }
            tx_snprintf(p, sizeof p, "%s/pkdir", base); made = made && !mkdir(p, 0700);
            tx_snprintf(p, sizeof p, "%s/pkdir/leaf.cx", base); f = made ? fopen(p, "w") : 0; made = 0;
            if (f) { fputs("#pragma unisa module leaf\nint pl_v(void){return 5;}\n", f); made = !fclose(f); }
            tx_snprintf(p, sizeof p, "%s/cxroot.tsv", base); f = made ? fopen(p, "w") : 0; made = 0;
            if (f) { fputs("CXROOT1\nR\tpk\tpkdir\n", f); made = !fclose(f); }
            tx_snprintf(p, sizeof p, "%s/real/env3.cx", base); f = made ? fopen(p, "w") : 0; made = 0;
            if (f) { fputs("#pragma unisa module env3\n#pragma unisa use pk.leaf\nint me3_same(void){return pl_v();}\n", f); made = !fclose(f); }
            tx_snprintf(mainp, sizeof mainp, "%s/main2.cx", base); f = made ? fopen(mainp, "w") : 0; made = 0;
            if (f) { fputs("#pragma unisa use real.env2\n#pragma unisa use link.env2\nint main(void){return me2_same();}\n", f); made = !fclose(f); }
            tx_snprintf(q, sizeof q, "%s/main3.cx", base); f = made ? fopen(q, "w") : 0; made = 0;
            if (f) { fputs("#pragma unisa use real.env3\n#pragma unisa use link.env3\nint main(void){return me3_same();}\n", f); made = !fclose(f); }
            tx_snprintf(p, sizeof p, "%s/main4.cx", base); f = made ? fopen(p, "w") : 0; made = 0;
            if (f) { fputs("#pragma unisa use real.env3\nint main(void){return me3_same();}\n", f); made = !fclose(f); }
            if (!made) { puts("FAIL\tsymlink-deps-fixture"); failed++; }
            else {
                sources[0] = mainp; n = 1; i = dv_expand(&n, sources, 0);
                if (i || n != 3) { printf("FAIL\tsymlink-deps-beside-merged\trc=%d\tunits=%d\n", i, n); failed++; } else puts("PASS\tsymlink-deps-beside-merged");
                sources[0] = p; n = 1; i = dv_expand(&n, sources, 0);
                if (i || n != 3) { printf("FAIL\tsymlink-deps-root-single-entry\trc=%d\tunits=%d\n", i, n); failed++; } else puts("PASS\tsymlink-deps-root-single-entry");
                sources[0] = q; n = 1; i = dv_expand(&n, sources, 0);
                if (!i) { printf("FAIL\tsymlink-deps-root-two-entries-refused\tunits=%d\n", n); failed++; } else puts("PASS\tsymlink-deps-root-two-entries-refused");
            }
        }
    }
    /* a real tool whose modules are reached both through tools/cxlib/sys -> cx/sys and through the package
       root, with their own use dependencies resolved by the package root on both sides, must keep planning */
    sources[0] = "tools/osx-sentinel.cx"; n = 1;
    i = dv_expand(&n, sources, 1);
    if (i || n != 1) { printf("FAIL\tsymlink-root-deps-funit\trc=%d\tunits=%d\n", i, n); failed++; } else puts("PASS\tsymlink-root-deps-funit");
    sources[0] = "tools/osx-sentinel.cx"; n = 1;
    i = dv_expand(&n, sources, 0);
    if (i || n < 2) { printf("FAIL\tsymlink-root-deps-plan\trc=%d\tunits=%d\n", i, n); failed++; } else { printf("PASS\tsymlink-root-deps-plan\tunits=%d\n", n); }
    printf("MODULE_UNITS\tfailed=%d\n", failed); return failed ? 1 : 0;
}
