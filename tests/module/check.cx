#pragma unisa use sys.proc
#pragma unisa use cxlib.netpack
static int run(char **args) {
    np_result r = {0}; char why[512]; int rc;
    rc = np_run(args, ".", 0, 48, &r, why, sizeof why);
    if (r.outn) fwrite(r.out, 1, r.outn, stdout);
    if (r.errn) fwrite(r.err, 1, r.errn, stderr);
    if (rc) fprintf(stderr, "module-units: %s\n", why);
    rc = rc || r.rc; np_free(&r); return rc;
}
int main(void) {
    char *units[] = {"sh", "./unisacc.com", "tests/module/units.cx", "src/driveunits.cx", "src/driveplan.cx", "src/host.cx", 0};
    char *lint[] = {"sh", "./unisacc.com", "tools/check-unit-limit.cx", 0};
    {
        char *negative[] = {"sh", "./unisacc.com", "tools/check-unit-limit.cx", "--", "tests/module/limit-negative.txt", 0};
        np_result r = {0}; char why[512]; int rc = np_run(negative, ".", 0, 10, &r, why, sizeof why);
        if (rc || r.rc != 1 || !r.out || !strstr(r.out, "violations=5") || !r.err || !strstr(r.err, "limit-negative.txt:5")) {
            np_free(&r); fputs("FAIL\tunit-limit-negative\n", stderr); return 1;
        }
        np_free(&r); puts("PASS\tunit-limit-negative");
    }
    if (run(units) || run(lint)) return 1;
    puts("MODULE_UNITS_CHECK\tstatus=PASS"); return 0;
}
