/* Native material; each batch invokes one mode in a fresh process. */
int module_units_plan(void);
int module_units_forward(void);
int main(int argc, char **argv) {
    if (argc != 2) return 2;
    if (!strcmp(argv[1], "plan")) return module_units_plan();
    if (!strcmp(argv[1], "forward")) return module_units_forward();
    return 2;
}
