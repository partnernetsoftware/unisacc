#!/usr/bin/env -S unisacc.com -run
/* seedmatrixprepared.cx -- prepared constructors/graphs for the shared seed matrix; the include-free port of
   tests/seedmatrixprepared.py (2026-10-23).  The original matrix comparisons remain consumers.  Same modes, same
   stdout/stderr lines, same rc:
     sh ./unisacc.com -run tests/seedmatrixprepared.cx -- --prepare                       (rc 0: HIT or PREPARED)
     sh ./unisacc.com -run tests/seedmatrixprepared.cx -- --require-cached --unit NAME    (NAME in SHARED below)
   --require-cached never constructs: a missing/stale/corrupt preparation is NEED_PREPARE on stderr, rc 75 (also
   when unisacc.com fails its build record).  --prepare builds seed/net.c and seed/tbl.c with unisacc.com
   (-fno-trim-libc) and every SHARED graph with python3 GENERATOR, inside a 55 s budget, under an flock on
   CACHE.lock, then writes manifest.json and its provenance record (manifest.json.build.json) and renames the work
   tree to CACHE = ${UNISACC_MODEL_CACHE:-TMPDIR/unisacc-model-cache}/seed-matrix-KEY.  The consumer re-runs
   exec/c/tbl.py and exec/c/net.py (python3) against the cached seed-tbl/seed-net within 20 s and byte-compares.
   The Python constructors are the system under test and are invoked, not reimplemented.
   Ported here (C, no Python): exec/c/provenance.py (source_digest = exec/pipeline/models.py closure + asm, verify,
   write), tests/actorclosure.py (actor_closure, its Python import scan by a tokenizer instead of ast), checklib's
   verify_cached_file, and Python's json loads/dumps for the basis, manifest and records (sort_keys, ensure_ascii,
   indent=2; JSONDecodeError texts).  KEY = sha256(json.dumps(basis, sort_keys=True)); basis is the .py's except
   that the actor seed naming this program is tests/seedmatrixprepared.cx (so the .cx and the .py never share a
   preparation key: they are different producers), and the closure asserts {this file, tests/bound.c} where the
   .py asserted {tests/actorclosure.py, tests/bound.c}.  Compile with -DSELF_SEED='"tests/seedmatrixprepared.py"'
   (or edit SELF_SEED) to reproduce the .py's key byte for byte (that is how parity was measured).
   SHARED is copied from tests/seedconstructmatrix.cx (an actor seed since both .py were retired, 2026-10-23, so
   editing it there invalidates the preparation; keep the two in step).  ROOT is the parent of this file's
   directory (__FILE__, resolved against the working directory: every caller runs from the repository root).  "python3" is the first python3 on PATH
   (sys.executable; the basis records its realpath and sha256).
   Differences from the .py: argparse texts name prog seedmatrixprepared.cx (same width, same wrapping); an
   uncaught exception prints only the traceback's last line (RuntimeError / AssertionError /
   subprocess.TimeoutExpired / OSError subclasses, same text and reprs), rc 1; a timed-out step's whole process
   group is killed (Python killed the child only); floats inside a build record are re-dumped by Python's repr
   rules (records carry only ints); sha256 digests of the closure, python3, the product and the cache go through
   `openssl dgst -sha256` when it is on PATH (see ossl_batch; the in-process fallback gives the same digests).
   Headers below are ones the cx prelude does not yet provide (CX1 in flight; errno comes with the prelude):
   time.h (clock_gettime), fcntl.h (open, O_* flags, FD_CLOEXEC), sys/file.h (flock: the same lock as the .py's
   fcntl.flock on CACHE.lock). */
#include <time.h>
#include <fcntl.h>
#include <sys/file.h>

#ifndef SELF_SEED
#define SELF_SEED "tests/seedmatrixprepared.cx"
#endif
#define PROG "seedmatrixprepared.cx"
#define PATHN 4096

typedef struct { const char *name, *script; const char *flags[6]; } Spec;
static const Spec SHARED[] = {                 /* tests/seedconstructmatrix.cx SHARED */
    {"e2", "exec/build/gen.py", {"pp", "--shared-predefines", 0}},
    {"e1", "exec/build/gen.py", {"lex", "--typed", 0}},
    {"e3", "exec/build/gen.py", {"parse2", 0}},
    {"e4", "exec/build/gen.py", {"opt", "--o2", 0}},
    {"o1", "exec/build/gen.py", {"opt", 0}},
    {"prune", "exec/build/gen.py", {"prune", 0}},
    {"nativeabi", "exec/build/gen.py", {"nativeabi", 0}},
    {0, 0, {0}} };
static const char *SEEDS[] = { SELF_SEED, "tests/seedconstructmatrix.cx", "tests/bound", "tests/bound.py",
    "exec/c/provenance.py", "seed/net.c", "seed/tbl.c", 0 };
static const char *ENVKEYS[] = { "PATH", "PYTHONPATH", "PYTHONHASHSEED", "LANG", "LC_ALL", "LD_LIBRARY_PATH",
    "LD_PRELOAD", "LD_AUDIT", "UNISA_ABLATE", "SOURCE_DATE_EPOCH", 0 };

static char ROOT[PATHN], PY[PATHN], TD[PATHN];
static double DEADLINE;

/* ---------- growable buffer ---------- */
typedef struct { char *s; size_t n, cap; } Buf;
static void bput(Buf *b, const char *s, size_t n) {
    if (b->n + n + 1 > b->cap) {
        size_t c = b->cap ? b->cap : 256; char *t;
        while (b->n + n + 1 > c) c *= 2;
        if (!(t = realloc(b->s, c))) { fprintf(stderr, "MemoryError\n"); exit(1); }
        b->s = t; b->cap = c;
    }
    memcpy(b->s + b->n, s, n); b->n += n; b->s[b->n] = 0;
}
static void bstr(Buf *b, const char *s) { bput(b, s, strlen(s)); }
static void bch(Buf *b, int c) { char ch = (char)c; bput(b, &ch, 1); }
static const char *bget(Buf *b) { return b->s ? b->s : ""; }
static void *xmalloc(size_t n) { void *p = malloc(n ? n : 1); if (!p) { fprintf(stderr, "MemoryError\n"); exit(1); } return p; }
static char *xstrndup(const char *s, size_t n) { char *d = xmalloc(n + 1); memcpy(d, s, n); d[n] = 0; return d; }
static char *xstrdup(const char *s) { return xstrndup(s, strlen(s)); }
static char *cat(const char *a, const char *b) { Buf x = {0, 0, 0}; bstr(&x, a); bstr(&x, b); return x.s ? x.s : xstrdup(""); }

/* ---------- scratch tree (tempfile.TemporaryDirectory) and uncaught exceptions ---------- */
static void rmtree(const char *p) {
    struct stat s; DIR *d; struct dirent *e;
    if (lstat(p, &s)) return;
    if (S_ISDIR(s.st_mode)) {
        if ((d = opendir(p))) {
            while ((e = readdir(d))) {
                char *q;
                if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
                q = xmalloc(strlen(p) + strlen(e->d_name) + 2); sprintf(q, "%s/%s", p, e->d_name); rmtree(q); free(q);
            }
            closedir(d);
        }
        rmdir(p);
    } else unlink(p);
}
/* the traceback's last line on stderr, rc 1; the TemporaryDirectory is removed first */
static void raise_line(const char *line) {
    fflush(stdout);
    if (TD[0]) { rmtree(TD); TD[0] = 0; }
    fprintf(stderr, "%s\n", line); fflush(stderr); exit(1);
}
static void need(const char *reason) {
    fflush(stdout);
    if (TD[0]) { rmtree(TD); TD[0] = 0; }
    fprintf(stderr, "NEED_PREPARE seed matrix: %s\n", reason); fflush(stderr); exit(75);
}

/* ---------- Python reprs ---------- */
/* repr(str) (bytes >= 0x80 kept: printable non-ASCII stays literal) and repr(bytes) (BYTES=1) */
static void brepr(Buf *b, const char *s, size_t n, int bytes) {
    size_t i; char q = '\'', t[8]; int sq = 0, dq = 0;
    for (i = 0; i < n; i++) { if (s[i] == '\'') sq = 1; else if (s[i] == '"') dq = 1; }
    if (sq && !dq) q = '"';
    if (bytes) bstr(b, "b");
    bput(b, &q, 1);
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)s[i];
        if (c == '\\' || c == (unsigned char)q) { t[0] = '\\'; t[1] = (char)c; bput(b, t, 2); }
        else if (c == '\t') bstr(b, "\\t");
        else if (c == '\n') bstr(b, "\\n");
        else if (c == '\r') bstr(b, "\\r");
        else if (c < 0x20 || c == 0x7f || (bytes && c >= 0x80)) { snprintf(t, sizeof t, "\\x%02x", c); bstr(b, t); }
        else bput(b, (const char *)&c, 1);
    }
    bput(b, &q, 1);
}
static void bargs(Buf *b, char **argv, int list) {   /* repr(tuple) / repr(list) of str */
    int i; bstr(b, list ? "[" : "(");
    for (i = 0; argv[i]; i++) { if (i) bstr(b, ", "); brepr(b, argv[i], strlen(argv[i]), 0); }
    if (i == 1 && !list) bstr(b, ",");
    bstr(b, list ? "]" : ")");
}
static void bfloat(Buf *b, double x) {           /* repr(float): shortest round-trip, Python's notation */
    char t[64], dig[32], out[96]; int p, e, nd, i, k = 0;
    if (x != x) { bstr(b, "NaN"); return; }
    if (x > 1.7976931348623157e308 || x < -1.7976931348623157e308) { bstr(b, x > 0 ? "Infinity" : "-Infinity"); return; }
    for (p = 1; p <= 17; p++) { snprintf(t, sizeof t, "%.*e", p - 1, x); if (strtod(t, 0) == x) break; }
    { char *m = t, *ep = strchr(t, 'e'); nd = 0;
      if (*m == '-') { out[k++] = '-'; m++; }
      for (; m < ep; m++) if (*m != '.') dig[nd++] = *m;
      dig[nd] = 0; e = atoi(ep + 1); }
    while (nd > 1 && dig[nd - 1] == '0') dig[--nd] = 0;
    if (e >= -4 && e < 16) {
        if (e < 0) { out[k++] = '0'; out[k++] = '.'; for (i = 0; i < -e - 1; i++) out[k++] = '0'; for (i = 0; i < nd; i++) out[k++] = dig[i]; }
        else {
            for (i = 0; i <= e; i++) out[k++] = i < nd ? dig[i] : '0';
            out[k++] = '.';
            if (nd > e + 1) for (i = e + 1; i < nd; i++) out[k++] = dig[i]; else out[k++] = '0';
        }
        out[k] = 0;
    } else {
        out[k++] = dig[0];
        if (nd > 1) { out[k++] = '.'; for (i = 1; i < nd; i++) out[k++] = dig[i]; }
        out[k] = 0; snprintf(out + k, sizeof out - k, "e%c%02d", e < 0 ? '-' : '+', e < 0 ? -e : e);
    }
    bstr(b, out);
}

/* ---------- exceptions that valid() and verify() catch: class + str(e) ---------- */
static const char *EXC = 0; static Buf EMSG = {0, 0, 0};
static int throw_(const char *cls, const char *msg) { EXC = cls; EMSG.n = 0; bstr(&EMSG, msg); return -1; }
static const char *oserr_class(int e) {
    return e == ENOENT ? "FileNotFoundError" : e == EACCES || e == EPERM ? "PermissionError" : e == EISDIR ? "IsADirectoryError"
         : e == ENOTDIR ? "NotADirectoryError" : e == EEXIST ? "FileExistsError" : "OSError";
}
static int throw_os(int e, const char *path) {     /* OSError(errno, strerror, filename) */
    Buf m = {0, 0, 0}; char t[32];
    snprintf(t, sizeof t, "[Errno %d] ", e); bstr(&m, t); bstr(&m, strerror(e)); bstr(&m, ": "); brepr(&m, path, strlen(path), 0);
    throw_(oserr_class(e), m.s); free(m.s); return -1;
}
static void crash(void) {                          /* re-raise the pending exception uncaught */
    Buf m = {0, 0, 0}; bstr(&m, EXC); if (EMSG.n) { bstr(&m, ": "); bstr(&m, bget(&EMSG)); } raise_line(m.s);
}
static int is_os(void) { return EXC && (strstr(EXC, "Error") && (!strcmp(EXC, "OSError") || !strcmp(EXC, "FileNotFoundError")
    || !strcmp(EXC, "PermissionError") || !strcmp(EXC, "IsADirectoryError") || !strcmp(EXC, "NotADirectoryError") || !strcmp(EXC, "FileExistsError"))); }
static int is_value(void) { return EXC && (!strcmp(EXC, "ValueError") || !strcmp(EXC, "json.decoder.JSONDecodeError") || !strcmp(EXC, "UnicodeDecodeError")); }

/* ---------- files ---------- */
static char *read_file(const char *path, size_t *len) {   /* open(path, 'rb').read(); NULL + exception on error */
    struct stat s; int fd; Buf b = {0, 0, 0}; char tmp[65536]; ssize_t k;
    if ((fd = open(path, O_RDONLY)) < 0) { throw_os(errno, path); return 0; }
    if (fstat(fd, &s) == 0 && S_ISDIR(s.st_mode)) { close(fd); throw_os(EISDIR, path); return 0; }
    for (;;) {
        k = read(fd, tmp, sizeof tmp);
        if (k < 0) { if (errno == EINTR) continue; { int e = errno; close(fd); free(b.s); throw_os(e, path); return 0; } }
        if (k == 0) break;
        bput(&b, tmp, (size_t)k);
    }
    close(fd);
    if (!b.s) b.s = xstrdup("");
    *len = b.n; return b.s;
}
/* Speed: code from unisacc hashes at about 8 MB/s, and the basis hashes the python3 executable (often >100 MB)
   and the source closure (~1800 files, 12 MB) three times.  So digests go through `openssl dgst -sha256 FILE...`
   (as tests/cxbin does) when it is there, many files per call; any doubt (no openssl, rc != 0, a line count or
   digest that does not parse) falls back to the in-process sha256 over read(), which raises the exact OSError. */
static int spawn(char **argv, double limit, char **out, size_t *outn, char **err, size_t *errn);
static int SPAWN_SOFT, NO_OPENSSL;
static int hexv(int c);
static int ossl_batch(char **paths, int n, unsigned char *md) {   /* 0 when every digest came from openssl */
    char **argv, *o = 0, *e = 0, *p; size_t on = 0, en = 0; int i, k = 0, rc;
    if (NO_OPENSSL || n <= 0) return -1;
    argv = xmalloc((size_t)(n + 4) * sizeof *argv);
    argv[0] = "openssl"; argv[1] = "dgst"; argv[2] = "-sha256";
    for (i = 0; i < n; i++) argv[3 + i] = paths[i];
    argv[3 + n] = 0;
    SPAWN_SOFT = 1; rc = spawn(argv, 50, &o, &on, &e, &en); SPAWN_SOFT = 0;
    free(argv); free(e);
    if (rc == -2000) NO_OPENSSL = 1;
    if (rc != 0) { free(o); return -1; }
    for (p = o; *p && k <= n; ) {
        char *nl = strchr(p, '\n'); size_t l = nl ? (size_t)(nl - p) : strlen(p); int j, ok = l >= 64;
        if (l && p[l - 1] == '\r') l--;
        ok = l >= 64;
        for (j = 0; ok && j < 64; j++) if (hexv((unsigned char)p[l - 64 + j]) < 0) ok = 0;
        if (!ok || (l > 64 && p[l - 65] != ' ' && p[l - 65] != '=')) { free(o); return -1; }
        if (k < n) for (j = 0; j < 32; j++) md[k * 32 + j] = (unsigned char)(hexv((unsigned char)p[l - 64 + 2 * j]) * 16 + hexv((unsigned char)p[l - 63 + 2 * j]));
        k++;
        if (!nl) break;
        p = nl + 1;
    }
    free(o);
    return k == n ? 0 : -1;
}
static int sha_file(const char *path, char hex[65]) {    /* hashlib.sha256(read_bytes()).hexdigest() */
    size_t n; char *d; struct stat s; unsigned char md[32]; int i;
    if (stat(path, &s) == 0 && S_ISREG(s.st_mode) && s.st_size >= 1048576 && access(path, R_OK) == 0) {
        char *one[1]; one[0] = (char *)path;
        if (ossl_batch(one, 1, md) == 0) { for (i = 0; i < 32; i++) sprintf(hex + 2 * i, "%02x", md[i]); hex[64] = 0; return 0; }
    }
    if (!(d = read_file(path, &n))) return -1;
    cx_sha256_hex(d, n, hex); free(d); return 0;
}
static char *must_read(const char *path, size_t *n) { char *d = read_file(path, n); if (!d) crash(); return d; }

/* ---------- UTF-8 (str as Python sees it) ---------- */
static int utf8_at(const unsigned char *s, size_t n, size_t i, unsigned *cp, int surr) {
    unsigned c = s[i], lo = 0x80, hi = 0xBF; int nd, k;
    if (c < 0x80) { *cp = c; return 1; }
    if (c >= 0xC2 && c <= 0xDF) nd = 1;
    else if (c >= 0xE0 && c <= 0xEF) { nd = 2; if (c == 0xE0) lo = 0xA0; if (c == 0xED && !surr) hi = 0x9F; }
    else if (c >= 0xF0 && c <= 0xF4) { nd = 3; if (c == 0xF0) lo = 0x90; if (c == 0xF4) hi = 0x8F; }
    else return 0;
    if (i + (size_t)nd >= n) return 0;
    *cp = c & (0x3F >> nd);
    for (k = 1; k <= nd; k++) {
        unsigned b = s[i + k];
        if (k == 1 ? (b < lo || b > hi) : (b < 0x80 || b > 0xBF)) return 0;
        *cp = (*cp << 6) | (b & 0x3F);
    }
    return nd + 1;
}
/* bytes.decode('utf-8') strictness: 0, or -1 with UnicodeDecodeError's text (CPython's error ranges) */
static int utf8_check(const char *s0, size_t n) {
    const unsigned char *s = (const unsigned char *)s0; size_t i = 0; unsigned cp;
    while (i < n) {
        int l = utf8_at(s, n, i, &cp, 0), nd = 0, k; unsigned c = s[i], lo = 0x80, hi = 0xBF; const char *why; Buf m = {0, 0, 0}; char t[96];
        if (l) { i += l; continue; }
        if (c >= 0xC2 && c <= 0xDF) nd = 1;
        else if (c >= 0xE0 && c <= 0xEF) { nd = 2; if (c == 0xE0) lo = 0xA0; if (c == 0xED) hi = 0x9F; }
        else if (c >= 0xF0 && c <= 0xF4) { nd = 3; if (c == 0xF0) lo = 0x90; if (c == 0xF4) hi = 0x8F; }
        if (!nd) { k = 0; why = "invalid start byte"; }
        else {
            for (k = 0; k < nd && i + 1 + k < n; k++) {
                unsigned b = s[i + 1 + k];
                if (k == 0 ? (b < lo || b > hi) : (b < 0x80 || b > 0xBF)) break;
            }
            why = (k < nd && i + 1 + k >= n) ? "unexpected end of data" : "invalid continuation byte";
        }
        if (k == 0) snprintf(t, sizeof t, "'utf-8' codec can't decode byte 0x%02x in position %lu: ", c, (unsigned long)i);
        else snprintf(t, sizeof t, "'utf-8' codec can't decode bytes in position %lu-%lu: ", (unsigned long)i, (unsigned long)(i + k));
        bstr(&m, t); bstr(&m, why); throw_("UnicodeDecodeError", m.s); free(m.s); return -1;
    }
    return 0;
}
/* Path.read_text(): strict UTF-8, universal newlines */
static char *read_text(const char *path, size_t *len) {
    size_t n, i, k = 0; char *d = read_file(path, &n);
    if (!d) return 0;
    if (utf8_check(d, n)) { free(d); return 0; }
    for (i = 0; i < n; i++) {
        if (d[i] == '\r') { d[k++] = '\n'; if (i + 1 < n && d[i + 1] == '\n') i++; }
        else d[k++] = d[i];
    }
    d[k] = 0; *len = k; return d;
}

/* ---------- JSON value model (Python dict/list/str/int/float/bool/None) ---------- */
enum { JNULL, JFALSE, JTRUE, JINT, JFLOAT, JSTR, JARR, JOBJ };
typedef struct J J;
struct J { int t; char *s; size_t sn; double f; J **v; char **k; size_t *kn; int n, cap; };
static J *jnew(int t) { J *j = calloc(1, sizeof *j); if (!j) { fprintf(stderr, "MemoryError\n"); exit(1); } j->t = t; return j; }
static J *jstrn(const char *s, size_t n) { J *j = jnew(JSTR); j->s = xstrndup(s, n); j->sn = n; return j; }
static J *jstr(const char *s) { return jstrn(s, strlen(s)); }
static void jgrow(J *a) {
    if (a->n < a->cap) return;
    a->cap = a->cap ? a->cap * 2 : 8;
    a->v = realloc(a->v, a->cap * sizeof *a->v); a->k = realloc(a->k, a->cap * sizeof *a->k); a->kn = realloc(a->kn, a->cap * sizeof *a->kn);
    if (!a->v || !a->k || !a->kn) { fprintf(stderr, "MemoryError\n"); exit(1); }
}
static void apush(J *a, J *v) { jgrow(a); a->v[a->n] = v; a->k[a->n] = 0; a->kn[a->n] = 0; a->n++; }
static int ofind(J *o, const char *k, size_t kn) {
    int i; for (i = 0; i < o->n; i++) if (o->kn[i] == kn && !memcmp(o->k[i], k, kn)) return i;
    return -1;
}
static void osetn(J *o, const char *k, size_t kn, J *v) {   /* d[k] = v: a repeated key keeps its first place */
    int i = ofind(o, k, kn);
    if (i >= 0) { o->v[i] = v; return; }
    jgrow(o); o->v[o->n] = v; o->k[o->n] = xstrndup(k, kn); o->kn[o->n] = kn; o->n++;
}
static void oset(J *o, const char *k, J *v) { osetn(o, k, strlen(k), v); }
static const char *pytype(J *j) {
    static const char *n[] = { "NoneType", "bool", "bool", "int", "float", "str", "list", "dict" };
    return n[j->t];
}
/* j[key] for a str key: KeyError / TypeError as Python raises them */
static J *getitem(J *j, const char *key) {
    Buf m = {0, 0, 0}; int i;
    if (j->t == JOBJ) {
        if ((i = ofind(j, key, strlen(key))) >= 0) return j->v[i];
        brepr(&m, key, strlen(key), 0); throw_("KeyError", m.s); free(m.s); return 0;
    }
    if (j->t == JARR) throw_("TypeError", "list indices must be integers or slices, not str");
    else if (j->t == JSTR) throw_("TypeError", "string indices must be integers, not 'str'");
    else { bstr(&m, "'"); bstr(&m, pytype(j)); bstr(&m, "' object is not subscriptable"); throw_("TypeError", m.s); free(m.s); }
    return 0;
}
/* Python == between JSON-born values (1 == 1.0 == True) */
static int numval(J *j, double *d) {
    if (j->t == JTRUE) { *d = 1; return 1; } if (j->t == JFALSE) { *d = 0; return 1; }
    if (j->t == JINT) { *d = strtod(j->s, 0); return 1; } if (j->t == JFLOAT) { *d = j->f; return 1; }
    return 0;
}
static int jeq(J *a, J *b) {
    double x, y; int i, k;
    if (a->t == JINT && b->t == JINT) return !strcmp(a->s, b->s);
    if (numval(a, &x) && numval(b, &y)) return x == y;
    if (a->t != b->t) return 0;
    switch (a->t) {
    case JNULL: return 1;
    case JSTR: return a->sn == b->sn && !memcmp(a->s, b->s, a->sn);
    case JARR: if (a->n != b->n) return 0; for (i = 0; i < a->n; i++) if (!jeq(a->v[i], b->v[i])) return 0; return 1;
    case JOBJ:
        if (a->n != b->n) return 0;
        for (i = 0; i < a->n; i++) { if ((k = ofind(b, a->k[i], a->kn[i])) < 0 || !jeq(a->v[i], b->v[k])) return 0; }
        return 1;
    }
    return 0;
}

/* json.dumps: ensure_ascii; a str's undecodable byte is its surrogateescape \udcXX */
static void jescape(Buf *o, const char *s0, size_t n) {
    const unsigned char *s = (const unsigned char *)s0; size_t i = 0; char t[16];
    bch(o, '"');
    while (i < n) {
        unsigned c; int l = utf8_at(s, n, i, &c, 1);
        if (l) i += l; else { c = 0xDC00 + s[i]; i++; }
        if (c == '"') bstr(o, "\\\""); else if (c == '\\') bstr(o, "\\\\");
        else if (c == '\n') bstr(o, "\\n"); else if (c == '\r') bstr(o, "\\r"); else if (c == '\t') bstr(o, "\\t");
        else if (c == '\b') bstr(o, "\\b"); else if (c == '\f') bstr(o, "\\f");
        else if (c >= ' ' && c <= '~') bch(o, (int)c);
        else if (c < 0x10000) { sprintf(t, "\\u%04x", c); bstr(o, t); }
        else { unsigned v = c - 0x10000; sprintf(t, "\\u%04x\\u%04x", 0xD800 | (v >> 10), 0xDC00 | (v & 0x3FF)); bstr(o, t); }
    }
    bch(o, '"');
}
static J *kcmp_o;
static int kcmp(const void *a, const void *b) {   /* sort_keys: str order of the keys (code point = UTF-8 byte order) */
    int x = *(const int *)a, y = *(const int *)b; size_t lx = kcmp_o->kn[x], ly = kcmp_o->kn[y];
    int r = memcmp(kcmp_o->k[x], kcmp_o->k[y], lx < ly ? lx : ly);
    return r ? r : (lx < ly ? -1 : lx > ly);
}
static int *sorted_keys(J *o) {
    int *ix = xmalloc((size_t)(o->n ? o->n : 1) * sizeof *ix), i;
    for (i = 0; i < o->n; i++) ix[i] = i;
    kcmp_o = o; if (o->n) qsort(ix, (size_t)o->n, sizeof *ix, kcmp);
    return ix;
}
static void indent_to(Buf *o, int level) { int i; bch(o, '\n'); for (i = 0; i < level * 2; i++) bch(o, ' '); }
/* json.dumps(j, sort_keys=True) (INDENT=0) or json.dumps(j, indent=2, sort_keys=True) (INDENT=1) */
static void jdump(Buf *o, J *j, int indent, int level) {
    int i, *ix;
    switch (j->t) {
    case JNULL: bstr(o, "null"); break;
    case JTRUE: bstr(o, "true"); break;
    case JFALSE: bstr(o, "false"); break;
    case JINT: bstr(o, j->s); break;
    case JFLOAT: bfloat(o, j->f); break;
    case JSTR: jescape(o, j->s, j->sn); break;
    case JARR:
        if (!j->n) { bstr(o, "[]"); break; }
        bch(o, '[');
        for (i = 0; i < j->n; i++) {
            if (i) bstr(o, indent ? "," : ", ");
            if (indent) indent_to(o, level + 1);
            jdump(o, j->v[i], indent, level + 1);
        }
        if (indent) indent_to(o, level);
        bch(o, ']'); break;
    case JOBJ:
        if (!j->n) { bstr(o, "{}"); break; }
        ix = sorted_keys(j); bch(o, '{');
        for (i = 0; i < j->n; i++) {
            if (i) bstr(o, indent ? "," : ", ");
            if (indent) indent_to(o, level + 1);
            jescape(o, j->k[ix[i]], j->kn[ix[i]]); bstr(o, ": ");
            jdump(o, j->v[ix[i]], indent, level + 1);
        }
        if (indent) indent_to(o, level);
        bch(o, '}'); free(ix); break;
    }
}

/* json.loads (CPython's C scanner, its JSONDecodeError texts and positions) */
typedef struct { const char *s; size_t n; } JP;
static int jfail(JP *p, const char *msg, size_t pos) {
    size_t i, ch = 0, line = 1, lastnl_ch = 0; int seen = 0; Buf m = {0, 0, 0}; char t[96];
    for (i = 0; i < pos && i < p->n; i++) {
        unsigned char c = (unsigned char)p->s[i];
        if ((c & 0xC0) == 0x80) continue;
        if (c == '\n') { line++; lastnl_ch = ch; seen = 1; }
        ch++;
    }
    snprintf(t, sizeof t, ": line %lu column %lu (char %lu)", (unsigned long)line,
             (unsigned long)(seen ? ch - lastnl_ch : ch + 1), (unsigned long)ch);
    bstr(&m, msg); bstr(&m, t); throw_("json.decoder.JSONDecodeError", m.s); free(m.s); return -1;
}
static size_t jws(JP *p, size_t i) { while (i < p->n && (p->s[i] == ' ' || p->s[i] == '\t' || p->s[i] == '\n' || p->s[i] == '\r')) i++; return i; }
static int hexv(int c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1; }
static int hex4(JP *p, size_t i, unsigned *v) {
    int k, h; *v = 0;
    for (k = 0; k < 4; k++) { if (i + k >= p->n || (h = hexv((unsigned char)p->s[i + k])) < 0) return 0; *v = *v * 16 + (unsigned)h; }
    return 1;
}
static void put_cp(Buf *b, unsigned c) {        /* \udcXX (XX >= 80) is kept as the raw byte (surrogateescape) */
    char t[4];
    if (c >= 0xDC80 && c <= 0xDCFF) { bch(b, (int)(c - 0xDC00)); return; }
    if (c < 0x80) { t[0] = (char)c; bput(b, t, 1); }
    else if (c < 0x800) { t[0] = (char)(0xC0 | c >> 6); t[1] = (char)(0x80 | (c & 0x3F)); bput(b, t, 2); }
    else if (c < 0x10000) { t[0] = (char)(0xE0 | c >> 12); t[1] = (char)(0x80 | (c >> 6 & 0x3F)); t[2] = (char)(0x80 | (c & 0x3F)); bput(b, t, 3); }
    else { t[0] = (char)(0xF0 | c >> 18); t[1] = (char)(0x80 | (c >> 12 & 0x3F)); t[2] = (char)(0x80 | (c >> 6 & 0x3F)); t[3] = (char)(0x80 | (c & 0x3F)); bput(b, t, 4); }
}
static int jstring(JP *p, size_t end, J **out, size_t *next_out) {   /* END is just past the opening quote */
    size_t begin = end - 1, next; Buf b = {0, 0, 0}; unsigned c = 0;
    for (;;) {
        c = 0;
        for (next = end; next < p->n; next++) {
            c = (unsigned char)p->s[next];
            if (c == '"' || c == '\\') break;
            if (c <= 0x1f) { free(b.s); return jfail(p, "Invalid control character at", next); }
        }
        if (!(c == '"' || c == '\\')) { free(b.s); return jfail(p, "Unterminated string starting at", begin); }
        bput(&b, p->s + end, next - end);
        if (c == '"') { end = next + 1; break; }
        next++;
        if (next == p->n) { free(b.s); return jfail(p, "Unterminated string starting at", begin); }
        c = (unsigned char)p->s[next];
        if (c != 'u') {
            end = next + 1;
            switch (c) {
            case '"': case '\\': case '/': break;
            case 'b': c = '\b'; break; case 'f': c = '\f'; break; case 'n': c = '\n'; break;
            case 'r': c = '\r'; break; case 't': c = '\t'; break;
            default: free(b.s); return jfail(p, "Invalid \\escape", end - 2);
            }
            bch(&b, (int)c);
        } else {
            unsigned v, v2;
            next++; end = next + 4;
            if (end >= p->n) { free(b.s); return jfail(p, "Invalid \\uXXXX escape", next - 1); }
            if (!hex4(p, next, &v)) { free(b.s); return jfail(p, "Invalid \\uXXXX escape", end - 5); }
            if (v >= 0xD800 && v <= 0xDBFF && end + 6 < p->n && p->s[end] == '\\' && p->s[end + 1] == 'u') {
                if (!hex4(p, end + 2, &v2)) { free(b.s); return jfail(p, "Invalid \\uXXXX escape", end + 1); }
                if (v2 >= 0xDC00 && v2 <= 0xDFFF) { v = 0x10000 + (((v - 0xD800) << 10) | (v2 - 0xDC00)); end += 6; }
            }
            put_cp(&b, v);
        }
    }
    *out = jstrn(b.s ? b.s : "", b.n); free(b.s); *next_out = end; return 0;
}
static int jvalue(JP *p, size_t i, J **out, size_t *next);
static int jvalue(JP *p, size_t i, J **out, size_t *next) {
    char c;
    if (i >= p->n) return jfail(p, "Expecting value", i);
    c = p->s[i];
    if (c == '"') return jstring(p, i + 1, out, next);
    if (c == '{') {
        J *o = jnew(JOBJ), *k, *v; size_t comma;
        i = jws(p, i + 1);
        if (i < p->n && p->s[i] == '}') { *out = o; *next = i + 1; return 0; }
        for (;;) {
            if (i >= p->n || p->s[i] != '"') return jfail(p, "Expecting property name enclosed in double quotes", i);
            if (jstring(p, i + 1, &k, &i)) return -1;
            i = jws(p, i);
            if (i >= p->n || p->s[i] != ':') return jfail(p, "Expecting ':' delimiter", i);
            i = jws(p, i + 1);
            if (jvalue(p, i, &v, &i)) return -1;
            osetn(o, k->s, k->sn, v);
            i = jws(p, i);
            if (i < p->n && p->s[i] == '}') { *out = o; *next = i + 1; return 0; }
            if (i >= p->n || p->s[i] != ',') return jfail(p, "Expecting ',' delimiter", i);
            comma = i; i = jws(p, i + 1);
            if (i < p->n && p->s[i] == '}') return jfail(p, "Illegal trailing comma before end of object", comma);
        }
    }
    if (c == '[') {
        J *a = jnew(JARR), *v; size_t comma;
        i = jws(p, i + 1);
        if (i < p->n && p->s[i] == ']') { *out = a; *next = i + 1; return 0; }
        for (;;) {
            if (jvalue(p, i, &v, &i)) return -1;
            apush(a, v);
            i = jws(p, i);
            if (i < p->n && p->s[i] == ']') { *out = a; *next = i + 1; return 0; }
            if (i >= p->n || p->s[i] != ',') return jfail(p, "Expecting ',' delimiter", i);
            comma = i; i = jws(p, i + 1);
            if (i < p->n && p->s[i] == ']') return jfail(p, "Illegal trailing comma before end of array", comma);
        }
    }
#define KW(w, T) if (p->n - i >= sizeof w - 1 && !memcmp(p->s + i, w, sizeof w - 1)) { *out = jnew(T); *next = i + sizeof w - 1; return 0; }
    KW("null", JNULL) KW("true", JTRUE) KW("false", JFALSE)
#undef KW
    if (p->n - i >= 3 && !memcmp(p->s + i, "NaN", 3)) { *out = jnew(JFLOAT); (*out)->f = 0.0 / 0.0; *next = i + 3; return 0; }
    if (p->n - i >= 8 && !memcmp(p->s + i, "Infinity", 8)) { *out = jnew(JFLOAT); (*out)->f = 1e308 * 10; *next = i + 8; return 0; }
    if (p->n - i >= 9 && !memcmp(p->s + i, "-Infinity", 9)) { *out = jnew(JFLOAT); (*out)->f = -1e308 * 10; *next = i + 9; return 0; }
    {   /* number */
        size_t s = i, j = i; int isf = 0; char *txt;
        if (j < p->n && p->s[j] == '-') j++;
        if (j < p->n && p->s[j] >= '1' && p->s[j] <= '9') { while (j < p->n && p->s[j] >= '0' && p->s[j] <= '9') j++; }
        else if (j < p->n && p->s[j] == '0') j++;
        else return jfail(p, "Expecting value", s);
        if (j + 1 < p->n && p->s[j] == '.' && p->s[j + 1] >= '0' && p->s[j + 1] <= '9') {
            j += 2; isf = 1; while (j < p->n && p->s[j] >= '0' && p->s[j] <= '9') j++;
        }
        if (j < p->n && (p->s[j] == 'e' || p->s[j] == 'E')) {
            size_t e = j + 1;
            if (e < p->n && (p->s[e] == '+' || p->s[e] == '-')) e++;
            if (e < p->n && p->s[e] >= '0' && p->s[e] <= '9') { while (e < p->n && p->s[e] >= '0' && p->s[e] <= '9') e++; j = e; isf = 1; }
        }
        txt = xstrndup(p->s + s, j - s);
        if (isf) { *out = jnew(JFLOAT); (*out)->f = strtod(txt, 0); free(txt); }
        else {
            *out = jnew(JINT);
            if (!strcmp(txt, "-0")) { free(txt); txt = xstrdup("0"); }
            (*out)->s = txt;
        }
        *next = j; return 0;
    }
}
static J *jloads(const char *s, size_t n) {          /* NULL + JSONDecodeError */
    JP p; J *v; size_t i;
    p.s = s; p.n = n;
    if (n >= 3 && !memcmp(s, "\xEF\xBB\xBF", 3)) { jfail(&p, "Unexpected UTF-8 BOM (decode using utf-8-sig)", 0); return 0; }
    if (jvalue(&p, jws(&p, 0), &v, &i)) return 0;
    i = jws(&p, i);
    if (i != n) { jfail(&p, "Extra data", i); return 0; }
    return v;
}

/* ---------- pathlib/os.path spellings ---------- */
static char *ppath(const char *s) {               /* str(Path(s)): drop empty and '.' parts */
    Buf b = {0, 0, 0}; const char *p = s, *e; int parts = 0;
    if (s[0] == '/') { if (s[1] == '/' && s[2] != '/') bstr(&b, "//"); else bstr(&b, "/"); }
    while (*p) {
        while (*p == '/') p++;
        if (!*p) break;
        e = p; while (*e && *e != '/') e++;
        if (!(e - p == 1 && *p == '.')) {
            if (parts++ || (b.n && b.s[b.n - 1] != '/')) bch(&b, '/');
            bput(&b, p, (size_t)(e - p));
        }
        p = e;
    }
    if (!b.n) bstr(&b, ".");
    return b.s;
}
static char *pjoin(const char *a, const char *b) {  /* str(Path(a) / b) for a relative b */
    if (!strcmp(a, ".")) return ppath(b);
    { Buf x = {0, 0, 0}; char *r; bstr(&x, a); if (x.n && x.s[x.n - 1] != '/') bch(&x, '/'); bstr(&x, b); r = ppath(x.s); free(x.s); return r; }
}
static char *normpath(const char *s) {             /* os.path.normpath */
    char **st = xmalloc((strlen(s) + 2) * sizeof *st); int n = 0, i, init = 0; const char *p = s, *e; Buf b = {0, 0, 0};
    if (!*s) return xstrdup(".");
    if (s[0] == '/') init = (s[1] == '/' && s[2] != '/') ? 2 : 1;
    while (*p) {
        while (*p == '/') p++;
        if (!*p) break;
        e = p; while (*e && *e != '/') e++;
        if (e - p == 1 && *p == '.') { p = e; continue; }
        if (e - p == 2 && p[0] == '.' && p[1] == '.') {
            if ((!init && (!n || !strcmp(st[n - 1], ".."))) ) st[n++] = xstrdup("..");
            else if (n) n--;
            p = e; continue;
        }
        st[n++] = xstrndup(p, (size_t)(e - p)); p = e;
    }
    for (i = 0; i < init; i++) bch(&b, '/');
    for (i = 0; i < n; i++) { if (i) bch(&b, '/'); bstr(&b, st[i]); }
    if (!b.n) bstr(&b, ".");
    free(st); return b.s;
}
static char *abspath(const char *s) {
    char cwd[PATHN];
    if (s[0] == '/') return normpath(s);
    if (!getcwd(cwd, sizeof cwd)) raise_line("OSError: getcwd failed");
    { char *t = cat(cwd, "/"), *u = cat(t, s), *r = normpath(u); free(t); free(u); return r; }
}
/* os.path.realpath(p, strict=False): symlinks resolved part by part, a missing part kept as spelled */
static char *realpath_ns(const char *p) {
    char **rest = 0; int nr = 0, cap = 0, links = 0; Buf path = {0, 0, 0}; char cwd[PATHN];
#define PUSHPARTS(str) do { const char *q_ = (str), *e_; int c_ = 0, k_; char **tmp_; \
        for (e_ = q_; ; e_++) { if (*e_ == '/' || !*e_) c_++; if (!*e_) break; } \
        if (nr + c_ > cap) { cap = (nr + c_) * 2 + 8; rest = realloc(rest, (size_t)cap * sizeof *rest); } \
        tmp_ = xmalloc((size_t)c_ * sizeof *tmp_); k_ = 0; \
        for (;;) { e_ = q_; while (*e_ && *e_ != '/') e_++; tmp_[k_++] = xstrndup(q_, (size_t)(e_ - q_)); if (!*e_) break; q_ = e_ + 1; } \
        while (k_) rest[nr++] = tmp_[--k_]; free(tmp_); } while (0)
    if (p[0] == '/') bstr(&path, "/");
    else { if (!getcwd(cwd, sizeof cwd)) raise_line("OSError: getcwd failed"); bstr(&path, cwd); }
    PUSHPARTS(p);
    while (nr) {
        char *name = rest[--nr], *np, lk[PATHN]; struct stat s; ssize_t k;
        if (!*name || !strcmp(name, ".")) { free(name); continue; }
        if (!strcmp(name, "..")) {
            char *sl = strrchr(path.s, '/');
            path.n = sl ? (size_t)(sl - path.s) : 0; if (!path.n) path.n = 1; path.s[path.n] = 0;
            free(name); continue;
        }
        np = path.n == 1 && path.s[0] == '/' ? cat("/", name) : cat(path.s, "/");
        if (!(path.n == 1 && path.s[0] == '/')) { char *t = cat(np, name); free(np); np = t; }
        free(name);
        if (lstat(np, &s) != 0 || !S_ISLNK(s.st_mode) || ++links > 40 || (k = readlink(np, lk, sizeof lk - 1)) < 0) {
            path.n = 0; bstr(&path, np); free(np); continue;
        }
        lk[k] = 0; free(np);
        if (lk[0] == '/') { path.n = 0; bstr(&path, "/"); }
        PUSHPARTS(lk);
    }
#undef PUSHPARTS
    free(rest); return path.s;
}

/* ---------- provenance.source_digest() (exec/pipeline/models.py closure + exec/c/asm/*.S) ---------- */
typedef struct { char **v; int n, cap; } Vec;
static void vpush(Vec *v, char *s) { if (v->n == v->cap) { v->cap = v->cap ? v->cap * 2 : 64; v->v = realloc(v->v, (size_t)v->cap * sizeof *v->v); if (!v->v) exit(1); } v->v[v->n++] = s; }
static int vhas(Vec *v, const char *s) { int i; for (i = 0; i < v->n; i++) if (!strcmp(v->v[i], s)) return 1; return 0; }
static int partcmp(const void *a, const void *b) {   /* key=relative_to(ROOT).parts */
    const unsigned char *x = *(const unsigned char *const *)a, *y = *(const unsigned char *const *)b;
    for (;; x++, y++) {
        unsigned cx = *x == '/' ? 0 : *x + 1u, cy = *y == '/' ? 0 : *y + 1u;
        if (!*x && !*y) return 0;
        if (!*x) return -1; if (!*y) return 1;
        if (cx != cy) return cx < cy ? -1 : 1;
    }
}
static int strpcmp(const void *a, const void *b) { return strcmp(*(char *const *)a, *(char *const *)b); }
static void rglob(const char *rel, Vec *out) {    /* Path.rglob('*'): no descent into symlinked directories */
    char *abs = cat(ROOT, "/"), *a2 = cat(abs, rel); DIR *d = opendir(a2); struct dirent *e;
    free(abs);
    if (!d) { free(a2); return; }
    while ((e = readdir(d))) {
        char *r; struct stat s;
        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
        r = xmalloc(strlen(rel) + strlen(e->d_name) + 2); sprintf(r, "%s/%s", rel, e->d_name);
        { char *full = cat(ROOT, "/"), *f2 = cat(full, r); free(full);
          if (lstat(f2, &s) == 0 && S_ISDIR(s.st_mode)) rglob(r, out);
          free(f2); }
        vpush(out, r);
    }
    closedir(d); free(a2);
}
static const char *suffix_of(const char *name) {   /* PurePath.suffix */
    const char *dot = strrchr(name, '.'); size_t l = strlen(name);
    if (!dot || dot == name || (size_t)(dot - name) == l - 1) return "";
    return dot;
}
static int is_file_abs(const char *abs) { struct stat s; return stat(abs, &s) == 0 && S_ISREG(s.st_mode); }
/* h.update(rel + b'\0'); h.update(bytes.fromhex(digest(path))) for every REL in order */
static void add_digests(Buf *h, Vec *rels) {
    int i, c, k; unsigned char *md = xmalloc((size_t)(rels->n ? rels->n : 1) * 32); char **abs = xmalloc((size_t)(rels->n ? rels->n : 1) * sizeof *abs);
    for (i = 0; i < rels->n; i++) abs[i] = pjoin(ROOT, rels->v[i]);
    for (c = 0; c < rels->n; c += 256) {
        int m = rels->n - c < 256 ? rels->n - c : 256;
        if (ossl_batch(abs + c, m, md + (size_t)c * 32) == 0) continue;
        for (k = c; k < c + m; k++) { size_t n; char *d = must_read(abs[k], &n); cx_sha256(d, n, md + (size_t)k * 32); free(d); }
    }
    for (i = 0; i < rels->n; i++) { bput(h, rels->v[i], strlen(rels->v[i]) + 1); bput(h, (const char *)md + (size_t)i * 32, 32); free(abs[i]); }
    free(abs); free(md);
}
static char *source_digest(void) {
    static const char *dirs[] = { "exec", "unisa", "src", "kernel", "include", "weights", "seed", 0 };
    static const char *seedkeep[] = { "tbl.c", "net.c", "json.h", "gen.c", "facts.h", "ident.c", "blob.c", "sha256.h", "pack.c",
        "compilerpack.c", "ape.c", 0 };
    static const char *sufs[] = { ".py", ".c", ".h", ".inc", ".tsv", ".json", ".sh", 0 };
    Buf h = {0, 0, 0}; Vec todo = {0, 0, 0}; int di, i, k; char hex[65];
    for (di = 0; dirs[di]; di++) {
        Vec all = {0, 0, 0};
        rglob(dirs[di], &all);
        if (all.n) qsort(all.v, (size_t)all.n, sizeof *all.v, partcmp);
        for (i = 0; i < all.n; i++) {
            char *r = all.v[i], *name = strrchr(r, '/') + 1, *abs; const char *suf = suffix_of(name); int nparts = 1, keep, probes = 0;
            const char *q; size_t stemlen = strlen(name) - strlen(suf);
            for (q = r; *q; q++) if (*q == '/') nparts++;
            if (!strcmp(dirs[di], "seed")) { keep = 0; for (k = 0; seedkeep[k]; k++) if (!strcmp(name, seedkeep[k])) keep = 1; if (!keep) continue; }
            if (!strcmp(dirs[di], "exec") && (!strcmp(suf, ".sh") || !strcmp(suf, ".py")) && stemlen >= 5 && !memcmp(name + stemlen - 5, "check", 5)) continue;
            {   /* 'probes' in rel[:-1] */
                const char *p = r, *e;
                while (p < name) { e = strchr(p, '/'); if ((size_t)(e - p) == 6 && !memcmp(p, "probes", 6)) probes = 1; p = e + 1; }
            }
            if (probes && (!strcmp(suf, ".c") || !strcmp(suf, ".h"))) continue;
            if (!strncmp(r, "exec/build/", 11) && (nparts > 3 || strcmp(suf, ".py"))) continue;
            keep = 0; for (k = 0; sufs[k]; k++) if (!strcmp(suf, sufs[k])) keep = 1;
            if (!keep) continue;
            abs = pjoin(ROOT, r);
            if (is_file_abs(abs)) vpush(&todo, xstrdup(r));
            free(abs);
        }
        for (i = 0; i < all.n; i++) free(all.v[i]);
        free(all.v);
    }
    vpush(&todo, xstrdup("iterate/kernel/typekw.tsv"));
    {   /* sorted((ROOT / 'exec/c/asm').glob('*.S')) */
        Vec v = {0, 0, 0}; char *dir = pjoin(ROOT, "exec/c/asm"); DIR *d = opendir(dir); struct dirent *e;
        if (d) {
            while ((e = readdir(d))) {
                size_t l = strlen(e->d_name);
                if (l >= 2 && !strcmp(e->d_name + l - 2, ".S")) vpush(&v, cat("exec/c/asm/", e->d_name));
            }
            closedir(d);
        }
        if (v.n) qsort(v.v, (size_t)v.n, sizeof *v.v, partcmp);
        for (i = 0; i < v.n; i++) vpush(&todo, v.v[i]);
        free(v.v); free(dir);
    }
    add_digests(&h, &todo);
    for (i = 0; i < todo.n; i++) free(todo.v[i]);
    free(todo.v);
    cx_sha256_hex(h.s, h.n, hex); free(h.s);
    return xstrdup(hex);
}

/* ---------- tests/actorclosure.py actor_closure(ROOT, seeds) ---------- */
typedef struct { char *name, *digest; Vec kids; } Actor;
static Actor *ACT; static int NACT, CAPACT;
static Vec *KIDS;                                  /* children of the actor being scanned (a set) */
static void local(const char *cand) {             /* local(candidate) */
    char *r = realpath_ns(cand); size_t rl = strlen(ROOT); struct stat s;
    if (!(strncmp(r, ROOT, rl) == 0 && (r[rl] == '/' || r[rl] == 0))) {
        Buf m = {0, 0, 0}; bstr(&m, "ValueError: "); brepr(&m, r, strlen(r), 0); bstr(&m, " is not in the subpath of ");
        brepr(&m, ROOT, rl, 0); raise_line(m.s);
    }
    if (stat(r, &s) != 0) {
        if (errno == ENOENT) { free(r); return; }
        throw_os(errno, r); crash();
    }
    if (S_ISREG(s.st_mode) && r[rl] == '/' && !vhas(KIDS, r + rl + 1)) vpush(KIDS, xstrdup(r + rl + 1));
    free(r);
}
static int isname(int c) { return c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c >= 0x80; }
static int isrunc(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '.' || c == '/' || c == '-'; }
static int ispyws(int c) { return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' || c == '\v' || (c >= 0x1c && c <= 0x1f); }
/* Python tokens for the import scan: N name, O operator char, L logical newline */
typedef struct { char t; size_t a, b; } Tok;
static size_t skip_string(const char *s, size_t n, size_t i, int fmt);
static size_t skip_fexpr(const char *s, size_t n, size_t i) {   /* inside {...} of an f-string, I past '{' */
    int depth = 0;
    while (i < n) {
        unsigned char c = (unsigned char)s[i];
        if (c == '\'' || c == '"') { i = skip_string(s, n, i, 0); continue; }
        if (isname(c)) {
            size_t j = i; while (j < n && isname((unsigned char)s[j])) j++;
            if (j < n && (s[j] == '\'' || s[j] == '"') && j - i <= 2) {
                size_t k; int f = 0, ok = 1;
                for (k = i; k < j; k++) { if (!strchr("rRbBuUfFtT", s[k])) ok = 0; if (strchr("fFtT", s[k])) f = 1; }
                if (ok) { i = skip_string(s, n, j, f); continue; }
            }
            i = j; continue;
        }
        if (c == '(' || c == '[' || c == '{') depth++;
        else if (c == ')' || c == ']') depth--;
        else if (c == '}') { if (depth-- == 0) return i + 1; }
        i++;
    }
    return i;
}
static size_t skip_string(const char *s, size_t n, size_t i, int fmt) {   /* I at the opening quote */
    char q = s[i]; int triple = i + 2 < n && s[i + 1] == q && s[i + 2] == q;
    i += triple ? 3 : 1;
    while (i < n) {
        char c = s[i];
        if (c == '\\') { i += 2; continue; }
        if (fmt && c == '{') { if (i + 1 < n && s[i + 1] == '{') { i += 2; continue; } i = skip_fexpr(s, n, i + 1); continue; }
        if (c == q) {
            if (!triple) return i + 1;
            if (i + 2 < n && s[i + 1] == q && s[i + 2] == q) return i + 3;
        }
        if (c == '\n' && !triple) return i + 1;
        i++;
    }
    return n;
}
static Tok *py_tokens(const char *s, size_t n, int *count) {
    Tok *t = 0; int nt = 0, cap = 0, depth = 0; size_t i = 0;
#define TPUSH(T, A, B) do { if (nt == cap) { cap = cap ? cap * 2 : 256; t = realloc(t, (size_t)cap * sizeof *t); } t[nt].t = (T); t[nt].a = (A); t[nt].b = (B); nt++; } while (0)
    while (i < n) {
        unsigned char c = (unsigned char)s[i];
        if (c == '#') { while (i < n && s[i] != '\n') i++; continue; }
        if (c == '\\' && i + 1 < n && (s[i + 1] == '\n' || s[i + 1] == '\r')) { i += 2; continue; }
        if (c == '\n') { if (!depth) TPUSH('L', i, i + 1); i++; continue; }
        if (c == ' ' || c == '\t' || c == '\r' || c == '\f') { i++; continue; }
        if (c == '\'' || c == '"') { i = skip_string(s, n, i, 0); TPUSH('S', i, i); continue; }
        if (isname(c)) {
            size_t j = i; while (j < n && isname((unsigned char)s[j])) j++;
            if (j < n && (s[j] == '\'' || s[j] == '"') && j - i <= 2 && !(c >= '0' && c <= '9')) {
                size_t k; int f = 0, ok = 1;
                for (k = i; k < j; k++) { if (!strchr("rRbBuUfFtT", s[k])) ok = 0; if (strchr("fFtT", s[k])) f = 1; }
                if (ok) { i = skip_string(s, n, j, f); TPUSH('S', i, i); continue; }
            }
            TPUSH('N', i, j); i = j; continue;
        }
        if (c == '(' || c == '[' || c == '{') depth++;
        else if ((c == ')' || c == ']' || c == '}') && depth) depth--;
        TPUSH('O', i, i + 1); i++;
    }
#undef TPUSH
    *count = nt; return t;
}
static int tok_is(const char *s, Tok *k, const char *w) { return k->t == 'N' && k->b - k->a == strlen(w) && !memcmp(s + k->a, w, k->b - k->a); }
static int tok_op(const char *s, Tok *k, char c) { return k->t == 'O' && s[k->a] == c; }
static void import_module(const char *dir, const char *module) {   /* local(base/target.py); local(base/target/__init__.py) */
    static const char *searches[] = { "tests", "exec/c", "exec/pipeline", "", 0 };
    char *target = xstrdup(module), *p; int b;
    for (p = target; *p; p++) if (*p == '.') *p = '/';
    for (b = -1; b < 0 || searches[b]; b++) {
        const char *base = b < 0 ? dir : searches[b]; char *bd = *base ? pjoin(ROOT, base) : xstrdup(ROOT), *x, *y;
        x = cat(target, ".py"); y = pjoin(bd, x); local(y); free(x); free(y);
        x = cat(target, "/__init__.py"); y = pjoin(bd, x); local(y); free(x); free(y);
        free(bd);
    }
    free(target);
}
static void scan_python(const char *dir, const char *s, size_t n) {
    int nt, i, j; Tok *t = py_tokens(s, n, &nt);
    for (i = 0; i < nt; i++) {
        if (!tok_is(s, &t[i], "import")) continue;
        /* ImportFrom: 'from' [dots] [dotted name] 'import' */
        j = i - 1;
        while (j >= 0 && (tok_op(s, &t[j], '.') || (t[j].t == 'N' && !tok_is(s, &t[j], "from")))) j--;
        if (j >= 0 && tok_is(s, &t[j], "from")) {
            Buf m = {0, 0, 0}; int k;
            for (k = j + 1; k < i; k++) if (t[k].t == 'N') { if (m.n) bch(&m, '.'); bput(&m, s + t[k].a, t[k].b - t[k].a); }
            if (m.n) import_module(dir, m.s);
            free(m.s); continue;
        }
        /* Import: dotted [as NAME] (, dotted [as NAME])* */
        j = i + 1;
        while (j < nt && t[j].t == 'N') {
            Buf m = {0, 0, 0};
            bput(&m, s + t[j].a, t[j].b - t[j].a); j++;
            while (j + 1 < nt && tok_op(s, &t[j], '.') && t[j + 1].t == 'N') { bch(&m, '.'); bput(&m, s + t[j + 1].a, t[j + 1].b - t[j + 1].a); j += 2; }
            import_module(dir, m.s); free(m.s);
            if (j + 1 < nt && tok_is(s, &t[j], "as") && t[j + 1].t == 'N') j += 2;
            if (j < nt && tok_op(s, &t[j], ',')) j++; else break;
        }
    }
    /* literal tests paths: ['"](tests/[A-Za-z0-9_./-]+)['"] */
    { size_t p = 0;
      while (p < n) {
          if ((s[p] == '\'' || s[p] == '"') && p + 6 < n && !memcmp(s + p + 1, "tests/", 6)) {
              size_t e = p + 7; while (e < n && isrunc((unsigned char)s[e])) e++;
              if (e > p + 7 && e < n && (s[e] == '\'' || s[e] == '"')) {
                  char *ref = xstrndup(s + p + 1, e - p - 1), *c = pjoin(ROOT, ref); local(c); free(c); free(ref); p = e + 1; continue;
              }
          }
          p++;
      } }
    free(t);
}
static void scan_shell(const char *dir, const char *s, size_t n) {
    /* \$(?:\{)?(R|ROOT|_LIB_R|here)(?:\})?(?:["'])?/([A-Za-z0-9_./-]+) */
    static const char *vars[] = { "R", "ROOT", "_LIB_R", "here", 0 };
    size_t p = 0;
    while (p < n) {
        int done = 0, br, v, cb, qt;
        if (s[p] != '$') { p++; continue; }
        for (br = 1; br >= 0 && !done; br--) {
            size_t q = p + 1;
            if (br) { if (q < n && s[q] == '{') q++; else continue; }
            for (v = 0; vars[v] && !done; v++) {
                size_t l = strlen(vars[v]), q2;
                if (q + l > n || memcmp(s + q, vars[v], l)) continue;
                for (cb = 1; cb >= 0 && !done; cb--) {
                    q2 = q + l;
                    if (cb) { if (q2 < n && s[q2] == '}') q2++; else continue; }
                    for (qt = 1; qt >= 0 && !done; qt--) {
                        size_t q3 = q2, e;
                        if (qt) { if (q3 < n && (s[q3] == '"' || s[q3] == '\'')) q3++; else continue; }
                        if (q3 >= n || s[q3] != '/') continue;
                        e = q3 + 1; while (e < n && isrunc((unsigned char)s[e])) e++;
                        if (e == q3 + 1) continue;
                        { char *ref = xstrndup(s + q3 + 1, e - q3 - 1), *base = !strcmp(vars[v], "here") ? pjoin(ROOT, dir) : xstrdup(ROOT), *c = pjoin(base, ref);
                          local(c); free(c); free(base); free(ref); }
                        p = e; done = 1;
                    }
                }
            }
        }
        if (!done) p++;
    }
}
static void scan_c(const char *dir, const char *s, size_t n) {
    /* ^\s*#\s*include\s*"([^"\n]+)"  (re.M) */
    size_t p = 0;
    while (p < n) {
        size_t q = p, e;
        if (!(p == 0 || s[p - 1] == '\n')) { p++; continue; }
        while (q < n && ispyws((unsigned char)s[q])) q++;
        if (q < n && s[q] == '#') {
            q++; while (q < n && ispyws((unsigned char)s[q])) q++;
            if (q + 7 <= n && !memcmp(s + q, "include", 7)) {
                q += 7; while (q < n && ispyws((unsigned char)s[q])) q++;
                if (q < n && s[q] == '"') {
                    e = q + 1; while (e < n && s[e] != '"' && s[e] != '\n') e++;
                    if (e > q + 1 && e < n && s[e] == '"') {
                        char *ref = xstrndup(s + q + 1, e - q - 1), *base = pjoin(ROOT, dir), *c;
                        if (ref[0] == '/') c = ppath(ref); else c = pjoin(base, ref);
                        local(c); free(c); free(base); free(ref); p = e + 1; continue;
                    }
                }
            }
        }
        p++;
    }
}
static int actor_find(const char *name) { int i; for (i = 0; i < NACT; i++) if (!strcmp(ACT[i].name, name)) return i; return -1; }
static int actcmp(const void *a, const void *b) { return strcmp(((const Actor *)a)->name, ((const Actor *)b)->name); }
static void actor_closure(void) {
    Vec pending = {0, 0, 0}; int i;
    for (i = 0; i < NACT; i++) { int k; for (k = 0; k < ACT[i].kids.n; k++) free(ACT[i].kids.v[k]); free(ACT[i].kids.v); free(ACT[i].name); free(ACT[i].digest); }
    NACT = 0;
    for (i = 0; SEEDS[i]; i++) vpush(&pending, xstrdup(SEEDS[i]));
    while (pending.n) {
        char *name = pending.v[--pending.n], *path, hex[65], *dir, *slash, *base; const char *suf; size_t n; char *data; Actor *a;
        if (actor_find(name) >= 0) { free(name); continue; }
        path = pjoin(ROOT, name); data = must_read(path, &n);
        if (NACT == CAPACT) { CAPACT = CAPACT ? CAPACT * 2 : 32; ACT = realloc(ACT, (size_t)CAPACT * sizeof *ACT); }
        a = &ACT[NACT++]; memset(a, 0, sizeof *a); a->name = name;
        cx_sha256_hex(data, n, hex); a->digest = xstrdup(hex);
        KIDS = &a->kids;
        if (utf8_check(data, n)) crash();          /* text=data.decode() */
        dir = xstrdup(name); slash = strrchr(dir, '/'); if (slash) *slash = 0; else { free(dir); dir = xstrdup("."); }
        base = strrchr(path, '/'); base = base ? base + 1 : path;
        suf = suffix_of(base);
        if (!strcmp(suf, ".py")) scan_python(strcmp(dir, ".") ? dir : "", data, n);
        else if (!strcmp(suf, ".sh") || !strcmp(base, "bound")) scan_shell(dir, data, n);
        else if (!strcmp(suf, ".c") || !strcmp(suf, ".h")) scan_c(dir, data, n);
        a = &ACT[NACT - 1];
        if (a->kids.n) qsort(a->kids.v, (size_t)a->kids.n, sizeof *a->kids.v, strpcmp);
        for (i = 0; i < a->kids.n; i++) vpush(&pending, xstrdup(a->kids.v[i]));
        free(dir); free(path); free(data);
    }
    free(pending.v);
    if (NACT) qsort(ACT, (size_t)NACT, sizeof *ACT, actcmp);
}
static J *actors_json(void) { J *o = jnew(JOBJ); int i; for (i = 0; i < NACT; i++) oset(o, ACT[i].name, jstr(ACT[i].digest)); return o; }
static J *edges_json(void) {
    J *o = jnew(JOBJ); int i, k;
    for (i = 0; i < NACT; i++) { J *l = jnew(JARR); for (k = 0; k < ACT[i].kids.n; k++) apush(l, jstr(ACT[i].kids.v[k])); oset(o, ACT[i].name, l); }
    return o;
}

/* ---------- provenance.verify(path): 0 + record, or -1 with SystemExit('product freshness: PATH: E') ---------- */
static char *SRC_NOW;                              /* the last source_digest() */
static int verify_inner(const char *path, J **rec) {
    size_t n; char *txt, *bj = cat(path, ".build.json"), hex[65]; J *r, *v; struct stat s; double d;
    txt = read_text(bj, &n); free(bj);
    if (!txt) return -1;
    r = jloads(txt, n); free(txt);
    if (!r) return -1;
    if (!(v = getitem(r, "schema"))) return -1;
    if (!(numval(v, &d) && d == 1)) return throw_("ValueError", "product inputs changed; rebuild with make com");
    if (!(v = getitem(r, "sources_sha256"))) return -1;
    free(SRC_NOW); SRC_NOW = source_digest();
    if (!(v->t == JSTR && !strcmp(v->s, SRC_NOW) && v->sn == strlen(SRC_NOW))) return throw_("ValueError", "product inputs changed; rebuild with make com");
    if (!(v = getitem(r, "artifact_sha256"))) return -1;
    if (sha_file(path, hex)) return -1;
    if (!(v->t == JSTR && v->sn == 64 && !strcmp(v->s, hex))) return throw_("ValueError", "artifact differs from its build record");
    if (!(v = getitem(r, "bytes"))) return -1;
    if (stat(path, &s)) return throw_os(errno, path);
    if (!(numval(v, &d) && d == (double)s.st_size && (v->t != JINT || strtod(v->s, 0) == (double)s.st_size))) return throw_("ValueError", "artifact differs from its build record");
    *rec = r; return 0;
}
static int verify(const char *path, J **rec) {
    if (verify_inner(path, rec) == 0) return 0;
    if (is_os() || is_value() || !strcmp(EXC, "KeyError") || !strcmp(EXC, "TypeError")) {
        Buf m = {0, 0, 0}; bstr(&m, "product freshness: "); bstr(&m, path); bstr(&m, ": "); bstr(&m, bget(&EMSG));
        throw_("SystemExit", m.s); free(m.s);
    }
    return -1;
}

/* ---------- run(deadline, *args): subprocess.run(args, cwd=ROOT, capture_output=True, timeout=min(50, remaining)) ---------- */
static double now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (double)t.tv_sec + (double)t.tv_nsec / 1e9; }
static int tmpfd(void) {
    const char *d = getenv("TMPDIR"); char *p; int fd;
    if (!d || !*d) d = "/tmp";
    p = cat(d, "/seed-matrix-capXXXXXX"); fd = mkstemp(p);
    if (fd < 0) { free(p); p = xstrdup("/tmp/seed-matrix-capXXXXXX"); fd = mkstemp(p); }
    if (fd < 0) raise_line("OSError: cannot capture a child's output");
    unlink(p); free(p); return fd;
}
/* spawn ARGV in ROOT; stdout captured into *OUT (when OUT), stderr captured into *ERR (when ERR) or inherited.
   Returns the Popen returncode (negative N for signal N); -1000 on timeout; raises when it cannot start. */
static int spawn(char **argv, double limit, char **out, size_t *outn, char **err, size_t *errn) {
    int of = tmpfd(), ef = err ? tmpfd() : -1, pp[2], e = 0, st = 0, rc; pid_t pid, w; ssize_t k; double start;
    fflush(stdout); fflush(stderr);
    if (pipe(pp)) raise_line("OSError: pipe failed");
    fcntl(pp[1], F_SETFD, FD_CLOEXEC);
    pid = fork();
    if (pid < 0) raise_line("OSError: fork failed");
    if (pid == 0) {
        setpgid(0, 0); close(pp[0]);
        dup2(of, 1); if (ef >= 0) dup2(ef, 2); close(of); if (ef >= 0) close(ef);
        if (chdir(ROOT)) { e = errno; if (write(pp[1], &e, sizeof e) < 0) {} _exit(127); }
        execvp(argv[0], argv);
        e = errno; if (write(pp[1], &e, sizeof e) < 0) {} _exit(127);
    }
    close(pp[1]);
    k = read(pp[0], &e, sizeof e); close(pp[0]);
    if (k == (ssize_t)sizeof e) {                  /* the child never ran: Popen raises */
        waitpid(pid, &st, 0); close(of); if (ef >= 0) close(ef);
        if (SPAWN_SOFT) return -2000;
        throw_os(e, argv[0]); crash();
    }
    start = now();
    for (;;) {
        w = waitpid(pid, &st, WNOHANG);
        if (w == pid) { rc = WIFSIGNALED(st) ? -WTERMSIG(st) : WEXITSTATUS(st); break; }
        if (w < 0) raise_line("ChildProcessError: waitpid failed");
        if (now() - start >= limit) { kill(-pid, SIGKILL); kill(pid, SIGKILL); waitpid(pid, &st, 0); rc = -1000; break; }
        usleep(10000);
    }
    {   Buf b = {0, 0, 0}; char tmp[65536];
        if (out) { lseek(of, 0, SEEK_SET); while ((k = read(of, tmp, sizeof tmp)) > 0) bput(&b, tmp, (size_t)k); *out = b.s ? b.s : xstrdup(""); *outn = b.n; }
        close(of);
        if (ef >= 0) { Buf c = {0, 0, 0}; lseek(ef, 0, SEEK_SET); while ((k = read(ef, tmp, sizeof tmp)) > 0) bput(&c, tmp, (size_t)k); *err = c.s ? c.s : xstrdup(""); *errn = c.n; close(ef); }
    }
    return rc;
}
static void run(char **argv) {
    double remaining = DEADLINE - now(), limit; int rc; char *e = 0, *o = 0; size_t en = 0, on = 0; Buf m = {0, 0, 0};
    if (remaining <= 0) raise_line("RuntimeError: seed matrix exceeded 55 s");
    limit = remaining < 50 ? remaining : 50;
    rc = spawn(argv, limit, &o, &on, &e, &en);
    free(o);
    if (rc == -1000) {
        bstr(&m, "subprocess.TimeoutExpired: Command '"); bargs(&m, argv, 0); bstr(&m, "' timed out after ");
        if (remaining < 50) bfloat(&m, limit); else bstr(&m, "50");
        bstr(&m, " seconds"); raise_line(m.s);
    }
    if (rc) {   /* RuntimeError(f"{args}: rc={p.returncode}: {p.stderr[-1000:]!r}") */
        char t[32];
        bstr(&m, "RuntimeError: "); bargs(&m, argv, 0);
        snprintf(t, sizeof t, ": rc=%d: ", rc); bstr(&m, t);
        brepr(&m, en > 1000 ? e + en - 1000 : e, en > 1000 ? 1000 : en, 1);
        raise_line(m.s);
    }
    free(e);
}

/* ---------- provenance.write(path, expected) ---------- */
static void prov_write(const char *path, const char *expected) {
    char *cur = source_digest(), hex[65], *out = 0, *dest, *tmp; size_t on = 0; J *rec, *set; struct stat s; int rc, i;
    char *git[] = {"git", "rev-parse", "HEAD", 0}; Buf j = {0, 0, 0}; extern char **environ;
    if (strcmp(cur, expected)) raise_line("product inputs changed during packaging");   /* SystemExit(str): rc 1 */
    rec = jnew(JOBJ);
    oset(rec, "schema", jnew(JINT)); rec->v[0]->s = xstrdup("1");
    oset(rec, "sources_sha256", jstr(cur));
    if (sha_file(path, hex)) crash();
    oset(rec, "artifact_sha256", jstr(hex));
    if (stat(path, &s)) { throw_os(errno, path); crash(); }
    { J *b = jnew(JINT); char t[32]; snprintf(t, sizeof t, "%lld", (long long)s.st_size); b->s = xstrdup(t); oset(rec, "bytes", b); }
    rc = spawn(git, 5, &out, &on, 0, 0);
    if (rc == -1000) raise_line("subprocess.TimeoutExpired: Command '['git', 'rev-parse', 'HEAD']' timed out after 5 seconds");
    if (rc) {
        Buf m = {0, 0, 0}; char t[64];
        if (rc < 0) snprintf(t, sizeof t, "died with <Signals.%s: %d>.", rc == -9 ? "SIGKILL" : rc == -15 ? "SIGTERM" : "SIG?", -rc);
        else snprintf(t, sizeof t, "returned non-zero exit status %d.", rc);
        bstr(&m, "subprocess.CalledProcessError: Command '"); bargs(&m, git, 1); bstr(&m, "' "); bstr(&m, t); raise_line(m.s);
    }
    if (utf8_check(out, on)) crash();
    { size_t a = 0, b = on; while (a < b && ispyws((unsigned char)out[a])) a++; while (b > a && ispyws((unsigned char)out[b - 1])) b--;
      oset(rec, "commit", jstrn(out + a, b - a)); }
    set = jnew(JOBJ);
    for (i = 0; environ[i]; i++) {
        char *eq = strchr(environ[i], '=');
        if (!eq) continue;
        if (!strncmp(environ[i], "E1", 2) || !strncmp(environ[i], "E2", 2) || !strncmp(environ[i], "E3", 2) || !strncmp(environ[i], "E4", 2)
            || !strncmp(environ[i], "PYTHONHASHSEED", 14)) {
            if ((size_t)(eq - environ[i]) < 2 || (!strncmp(environ[i], "PYTHONHASHSEED", 14) && eq - environ[i] < 14)) continue;
            osetn(set, environ[i], (size_t)(eq - environ[i]), jstr(eq + 1));
        }
    }
    oset(rec, "settings", set);
    jdump(&j, rec, 1, 0); bch(&j, '\n');
    dest = cat(path, ".build.json"); tmp = cat(dest, ".tmp");
    if (cx_write(tmp, j.s, j.n)) { throw_os(errno ? errno : EIO, tmp); crash(); }
    if (rename(tmp, dest)) { throw_os(errno, tmp); crash(); }
    free(j.s); free(dest); free(tmp); free(cur); free(out);
}

/* ---------- verify_cached_file(path, expected, executable) ---------- */
static int verify_cached_file(const char *path, J *h, int executable) {
    struct stat s; char hex[65]; Buf m = {0, 0, 0}; size_t i; int ok = 1;
    if (lstat(path, &s)) return throw_os(errno, path);
    if (!S_ISREG(s.st_mode) || s.st_size == 0) { bstr(&m, "cached artifact is not a nonempty regular file: "); bstr(&m, path); throw_("ValueError", m.s); free(m.s); return -1; }
    if (h->t != JSTR || h->sn != 64) ok = 0;
    else for (i = 0; i < 64; i++) if (!((h->s[i] >= '0' && h->s[i] <= '9') || (h->s[i] >= 'a' && h->s[i] <= 'f'))) ok = 0;
    if (!ok) { bstr(&m, "cached artifact has invalid digest: "); bstr(&m, path); throw_("ValueError", m.s); free(m.s); return -1; }
    if (executable && (!(s.st_mode & 0111) || access(path, X_OK) != 0)) { bstr(&m, "cached artifact is not executable: "); bstr(&m, path); throw_("ValueError", m.s); free(m.s); return -1; }
    if (sha_file(path, hex)) return -1;
    if (strcmp(hex, h->s)) { bstr(&m, "cached artifact SHA mismatch: "); bstr(&m, path); throw_("ValueError", m.s); free(m.s); return -1; }
    return 0;
}

/* ---------- valid() ---------- */
static const char *REQUIRED[] = { "e1.json", "e2.json", "e3.json", "e4.json", "nativeabi.json", "o1.json", "prune.json",
    "seed-net", "seed-tbl", 0 };
static char *CACHE, *KEY; static J *BASIS; static int PREPARE;
static int valid_inner(void) {
    char *m = pjoin(CACHE, "manifest.json"), *txt; size_t n; J *rec, *doc, *b, *outs; int i, k;
    if (verify(m, &rec)) { free(m); return -1; }
    txt = read_text(m, &n);
    if (!txt) { free(m); return -1; }
    free(m);
    if (!(doc = jloads(txt, n))) { free(txt); return -1; }
    free(txt);
    if (!(b = getitem(doc, "basis"))) return -1;
    if (!jeq(b, BASIS)) return throw_("ValueError", "role/output set mismatch");
    if (!(outs = getitem(doc, "outputs"))) return -1;
    {   /* set(doc['outputs']) != required */
        int same = 1, cnt = 0;
        if (outs->t == JOBJ || outs->t == JARR) {
            if (outs->t == JARR) for (i = 0; i < outs->n; i++) if (outs->v[i]->t == JARR || outs->v[i]->t == JOBJ) {
                Buf e = {0, 0, 0}; bstr(&e, "unhashable type: '"); bstr(&e, pytype(outs->v[i])); bstr(&e, "'"); throw_("TypeError", e.s); free(e.s); return -1; }
            for (i = 0; i < outs->n; i++) {
                const char *key = outs->t == JOBJ ? outs->k[i] : outs->v[i]->s; size_t kl = outs->t == JOBJ ? outs->kn[i] : outs->v[i]->sn; int hit = -1, dup = 0;
                if (outs->t == JARR && outs->v[i]->t != JSTR) { same = 0; continue; }
                for (k = 0; REQUIRED[k]; k++) if (strlen(REQUIRED[k]) == kl && !memcmp(REQUIRED[k], key, kl)) hit = k;
                if (hit < 0) { same = 0; continue; }
                for (k = 0; k < i; k++) {
                    const char *k2 = outs->t == JOBJ ? outs->k[k] : outs->v[k]->s; size_t l2 = outs->t == JOBJ ? outs->kn[k] : outs->v[k]->sn;
                    if ((outs->t == JOBJ || outs->v[k]->t == JSTR) && l2 == kl && !memcmp(k2, key, kl)) dup = 1;
                }
                if (!dup) cnt++;
            }
            for (k = 0; REQUIRED[k]; k++) {}   /* k = len(required) */
            if (cnt != k) same = 0;
        } else if (outs->t == JSTR) same = 0;
        else { Buf e = {0, 0, 0}; bstr(&e, "'"); bstr(&e, pytype(outs)); bstr(&e, "' object is not iterable"); throw_("TypeError", e.s); free(e.s); return -1; }
        if (!same) return throw_("ValueError", "role/output set mismatch");
        if (outs->t == JARR) { throw_("AttributeError", "'list' object has no attribute 'items'"); crash(); }
    }
    for (i = 0; i < outs->n; i++) {
        char *nm = xstrndup(outs->k[i], outs->kn[i]), *f = pjoin(CACHE, nm);
        int ex = !strcmp(nm, "seed-net") || !strcmp(nm, "seed-tbl");
        if (verify_cached_file(f, outs->v[i], ex)) { free(nm); free(f); return -1; }
        free(nm); free(f);
    }
    (void)rec; return 0;
}
static int valid(void) {
    if (valid_inner() == 0) return 1;
    if (!strcmp(EXC, "SystemExit") || !strcmp(EXC, "FileNotFoundError") || is_value() || !strcmp(EXC, "KeyError") || !strcmp(EXC, "TypeError")) {
        if (!PREPARE) {
            Buf m = {0, 0, 0};
            bstr(&m, "该 key 无有效准备（源或 actor 闭包变了，或产物缺坏）: "); bstr(&m, KEY); bstr(&m, "; "); bstr(&m, bget(&EMSG));
            need(m.s);
        }
        return 0;
    }
    crash(); return 0;
}

/* ---------- argparse ---------- */
static void usage(FILE *f) {
    fprintf(f, "usage: " PROG " [-h] [--prepare] [--require-cached]\n"
               "                             [--unit {e2,e1,e3,e4,o1,prune,nativeabi}]\n");
}
static void arg_error(const char *msg) { usage(stderr); fprintf(stderr, PROG ": error: %s\n", msg); exit(2); }
static void help(void) {
    usage(stdout);
    printf("\noptions:\n  -h, --help            show this help message and exit\n  --prepare\n  --require-cached\n"
           "  --unit {e2,e1,e3,e4,o1,prune,nativeabi}\n");
    exit(0);
}
static int unit_index(const char *v) { int i; for (i = 0; SHARED[i].name; i++) if (!strcmp(SHARED[i].name, v)) return i; return -1; }
static int optional_like(const char *a) {          /* argparse classifies A as an option string ('O') */
    if (a[0] != '-' || !a[1]) return 0;
    if (!strcmp(a, "--")) return 0;
    if (a[1] == '.' || (a[1] >= '0' && a[1] <= '9')) {   /* negative-number-like: positional (no such options here) */
        const char *p = a + 1; int digits = 0, dot = 0;
        for (; *p; p++) { if (*p >= '0' && *p <= '9') digits = 1; else if (*p == '.' && !dot) dot = 1; else break; }
        if (!*p && digits) return 0;
    }
    if (strchr(a, ' ') && !strchr(a, '=')) return 0;
    return 1;
}
static const char *LONGS[] = { "--help", "--prepare", "--require-cached", "--unit", 0 };
static const char *DISPLAY[] = { "-h/--help", "--prepare", "--require-cached", "--unit" };
static int parse_args(int argc, char **argv, int *prep, int *req, const char **unit) {
    Buf extras = {0, 0, 0}; int i, only_pos = 0;
    *prep = *req = 0; *unit = 0;
    for (i = 1; i < argc; i++) {
        const char *a = argv[i], *eq, *explicit = 0; int opt = -1, k, matches = 0; char *head;
        if (only_pos || !optional_like(a)) {
            if (!strcmp(a, "--")) only_pos = 1;
            if (extras.n) bch(&extras, ' '); bstr(&extras, a); continue;
        }
        eq = strchr(a, '=');
        head = eq ? xstrndup(a, (size_t)(eq - a)) : xstrdup(a);
        if (!strcmp(a, "-h")) opt = 0;
        else for (k = 0; LONGS[k]; k++) if (!strcmp(a, LONGS[k])) opt = k;
        if (opt < 0 && eq) {
            if (!strcmp(head, "-h")) opt = 0;
            else for (k = 0; LONGS[k]; k++) if (!strcmp(head, LONGS[k])) opt = k;
            if (opt >= 0) explicit = eq + 1;
        }
        if (opt < 0 && a[1] == '-') {             /* unique prefix of a long option */
            Buf m = {0, 0, 0};
            for (k = 0; LONGS[k]; k++) if (!strncmp(LONGS[k], head, strlen(head))) { matches++; opt = k; }
            if (matches > 1) {
                bstr(&m, "ambiguous option: "); bstr(&m, a); bstr(&m, " could match ");
                for (k = 0, matches = 0; LONGS[k]; k++) if (!strncmp(LONGS[k], head, strlen(head))) { if (matches++) bstr(&m, ", "); bstr(&m, LONGS[k]); }
                arg_error(m.s);
            }
            if (opt >= 0 && eq) explicit = eq + 1;
        }
        if (opt < 0 && a[1] != '-' && a[1] == 'h') {   /* -hX: short -h with attached text */
            opt = 0;
            if (a[2] == '-') explicit = a + 2;
            else if (a[2] != '=') explicit = 0;    /* -hx, -hh: help */
        }
        free(head);
        if (opt < 0) { if (extras.n) bch(&extras, ' '); bstr(&extras, a); continue; }
        if (opt <= 2 && explicit) {
            Buf m = {0, 0, 0}; bstr(&m, "argument "); bstr(&m, DISPLAY[opt]); bstr(&m, ": ignored explicit argument ");
            brepr(&m, explicit, strlen(explicit), 0); arg_error(m.s);
        }
        if (opt == 0) help();
        if (opt == 1) { *prep = 1; continue; }
        if (opt == 2) { *req = 1; continue; }
        {   const char *v = explicit;
            if (!v) {
                if (i + 1 >= argc || optional_like(argv[i + 1]) || !strcmp(argv[i + 1], "--")) arg_error("argument --unit: expected one argument");
                v = argv[++i];
            }
            if (unit_index(v) < 0) {
                Buf m = {0, 0, 0}; int s;
                bstr(&m, "argument --unit: invalid choice: "); brepr(&m, v, strlen(v), 0); bstr(&m, " (choose from ");
                for (s = 0; SHARED[s].name; s++) { if (s) bstr(&m, ", "); brepr(&m, SHARED[s].name, strlen(SHARED[s].name), 0); }
                bstr(&m, ")"); arg_error(m.s);
            }
            *unit = v;
        }
    }
    if (extras.n) { Buf m = {0, 0, 0}; bstr(&m, "unrecognized arguments: "); bstr(&m, extras.s); arg_error(m.s); }
    return 0;
}

/* ---------- tempfile ---------- */
static char *gettempdir(void) {
    static const char *envs[] = { "TMPDIR", "TEMP", "TMP", 0 }, *dflt[] = { "/tmp", "/var/tmp", "/usr/tmp", 0 };
    int i; struct stat s;
    for (i = 0; i < 7; i++) {
        const char *d = i < 3 ? getenv(envs[i]) : i < 6 ? dflt[i - 3] : ".";
        char *a;
        if (!d || !*d) continue;
        a = abspath(d);
        if (stat(a, &s) == 0 && S_ISDIR(s.st_mode) && access(a, W_OK | X_OK) == 0) return a;
        free(a);
    }
    raise_line("FileNotFoundError: [Errno 2] No usable temporary directory found in ['/tmp', '/var/tmp', '/usr/tmp']");
    return 0;
}
static void mkdtemp_py(const char *dir, const char *prefix) {   /* tempfile.mkdtemp(prefix, dir): an absolute name */
    static const char al[] = "abcdefghijklmnopqrstuvwxyz0123456789_"; int tries, k; unsigned char r[8]; FILE *u = fopen("/dev/urandom", "rb");
    char *base = abspath(dir);
    for (tries = 0; tries < 100; tries++) {
        Buf p = {0, 0, 0};
        if (!u || fread(r, 1, 8, u) != 8) for (k = 0; k < 8; k++) r[k] = (unsigned char)(rand() ^ (int)getpid() ^ tries);
        bstr(&p, base); if (strcmp(base, "/")) bch(&p, '/'); bstr(&p, prefix);
        for (k = 0; k < 8; k++) bch(&p, al[r[k] % 37]);
        if (mkdir(p.s, 0700) == 0) { snprintf(TD, sizeof TD, "%s", p.s); free(p.s); if (u) fclose(u); free(base); return; }
        if (errno != EEXIST) { throw_os(errno, p.s); crash(); }
        free(p.s);
    }
    raise_line("FileExistsError: [Errno 17] No usable temporary directory name found");
}
static void mkdirs(const char *p) {                /* Path.mkdir(parents=True, exist_ok=True) */
    struct stat s; char *c = xstrdup(p), *q;
    for (q = c + 1; *q; q++) if (*q == '/') { *q = 0; if (stat(c, &s) != 0) mkdir(c, 0777); *q = '/'; }
    if (mkdir(c, 0777) != 0) {
        int e = errno;
        if (!(e == EEXIST && stat(c, &s) == 0 && S_ISDIR(s.st_mode))) { throw_os(e, c); crash(); }
    }
    free(c);
}

static void find_python(void) {                  /* sys.executable: the python3 the gate's PATH names */
    const char *path = getenv("PATH"), *p, *e; char cand[PATHN];
    snprintf(PY, sizeof PY, "python3");
    for (p = path ? path : ""; *p; p = *e ? e + 1 : e) {
        size_t l; e = strchr(p, ':'); if (!e) e = p + strlen(p);
        l = (size_t)(e - p);
        snprintf(cand, sizeof cand, "%.*s/python3", (int)(l ? l : 1), l ? p : ".");
        if (access(cand, X_OK) == 0 && is_file_abs(cand)) {
            if (cand[0] != '/') { char *a = abspath(cand); snprintf(PY, sizeof PY, "%s", a); free(a); return; }
            snprintf(PY, sizeof PY, "%s", cand); return;
        }
    }
}
static char *uname_field(const char *flag) {
    char *argv[] = {"uname", (char *)flag, 0}, *o = 0; size_t n = 0;
    if (spawn(argv, 5, &o, &n, 0, 0) != 0) raise_line("OSError: uname failed");
    while (n && (o[n - 1] == '\n' || o[n - 1] == '\r')) o[--n] = 0;
    return o;
}

/* the generator step (one SHARED spec into WORK/NAME.json) */
static void generate(const Spec *s, const char *work) {
    char *a[16], *out = xmalloc(strlen(work) + strlen(s->name) + 8); int k = 0, f;
    sprintf(out, "%s/%s.json", work, s->name);
    a[k++] = PY; a[k++] = (char *)s->script; a[k++] = out;
    for (f = 0; s->flags[f]; f++) a[k++] = (char *)s->flags[f];
    a[k] = 0; run(a); free(out);
}
static int same_file(const char *a, const char *b) {
    size_t na, nb; char *x = must_read(a, &na), *y = must_read(b, &nb); int r = na == nb && !memcmp(x, y, na);
    free(x); free(y); return r;
}

int main(int argc, char **argv) {
    int prep, req, i, lockfd; const char *unit; char here[PATHN], *slash, *product, *product_sha, *sources, *pyreal, hex[65], *base;
    J *record, *basis, *env, *specs, *host, *flags; Buf canon = {0, 0, 0};
    parse_args(argc, argv, &prep, &req, &unit);
    if (prep == req || (prep && unit) || (req && !unit)) arg_error("choose --prepare or --require-cached --unit NAME");
    PREPARE = prep;
    /* ROOT = Path(__file__).resolve().parents[1] */
    snprintf(here, sizeof here, "%s", __FILE__);
    slash = strrchr(here, '/');
    if (slash) *slash = 0; else snprintf(here, sizeof here, ".");
    { char *t = cat(here, "/.."), *r = realpath_ns(t); snprintf(ROOT, sizeof ROOT, "%s", r); free(t); free(r); }
    find_python();
    product = pjoin(ROOT, "unisacc.com");
    if (verify(product, &record)) { if (!strcmp(EXC, "SystemExit")) need(bget(&EMSG)); crash(); }
    actor_closure();
    if (actor_find("tests/bound.c") < 0 || actor_find(SELF_SEED) < 0) raise_line("AssertionError");
    sources = source_digest();
    if (sha_file(product, hex)) crash();
    product_sha = xstrdup(hex);
    pyreal = realpath_ns(PY);
    if (sha_file(pyreal, hex)) crash();
    basis = jnew(JOBJ);
    oset(basis, "schema", jstr("seed-matrix-shared-v1"));
    oset(basis, "sources", jstr(sources));
    oset(basis, "actors", actors_json());
    oset(basis, "actor_edges", edges_json());
    oset(basis, "product_sha256", jstr(product_sha));
    oset(basis, "product_record", record);
    oset(basis, "python", jstr(pyreal));
    oset(basis, "python_sha256", jstr(hex));
    host = jnew(JARR); apush(host, jstr(uname_field("-s"))); apush(host, jstr(uname_field("-m")));
    oset(basis, "host", host);
    specs = jnew(JARR);
    for (i = 0; SHARED[i].name; i++) {
        J *sp = jnew(JARR), *fl = jnew(JARR); int f;
        apush(sp, jstr(SHARED[i].name)); apush(sp, jstr(SHARED[i].script));
        for (f = 0; SHARED[i].flags[f]; f++) apush(fl, jstr(SHARED[i].flags[f]));
        apush(sp, fl); apush(specs, sp);
    }
    oset(basis, "specs", specs);
    flags = jnew(JARR); apush(flags, jstr("-fno-trim-libc")); oset(basis, "flags", flags);
    env = jnew(JOBJ);
    for (i = 0; ENVKEYS[i]; i++) { const char *v = getenv(ENVKEYS[i]); oset(env, ENVKEYS[i], v ? jstr(v) : jnew(JNULL)); }
    oset(basis, "environment", env);
    BASIS = basis;
    jdump(&canon, basis, 0, 0);
    cx_sha256_hex(canon.s, canon.n, hex); KEY = xstrdup(hex);
    { const char *mc = getenv("UNISACC_MODEL_CACHE");
      if (mc) base = ppath(mc); else { char *t = gettempdir(), *u = cat(t, "/unisacc-model-cache"); base = ppath(u); free(t); free(u); } }
    { char *t = cat("seed-matrix-", KEY); CACHE = pjoin(base, t); free(t); }
    if (prep) {
        char *lockp = cat(CACHE, ".lock"), *work, *m; Buf man = {0, 0, 0}; J *doc, *outs; struct stat s;
        mkdirs(base);
        if ((lockfd = open(lockp, O_WRONLY | O_CREAT | O_APPEND, 0666)) < 0) { throw_os(errno, lockp); crash(); }
        while (flock(lockfd, LOCK_EX) != 0 && errno == EINTR) {}
        if (valid()) { printf("seed matrix prepare HIT %s\n", KEY); return 0; }
        mkdtemp_py(base, "seed-matrix-prepare-");
        work = xstrdup(TD);
        DEADLINE = now() + 55;
        for (i = 0; i < 2; i++) {
            const char *nm = i ? "tbl" : "net"; char *src = xmalloc(32), *o = xmalloc(strlen(work) + 16);
            char *a[8];
            sprintf(src, "seed/%s.c", nm); sprintf(o, "%s/seed-%s", work, nm);
            a[0] = "sh"; a[1] = product; a[2] = "-fno-trim-libc"; a[3] = src; a[4] = "-o"; a[5] = o; a[6] = 0;
            run(a); free(src); free(o);
        }
        for (i = 0; SHARED[i].name; i++) generate(&SHARED[i], work);
        { char *now_src = source_digest(); if (strcmp(now_src, sources)) raise_line("AssertionError"); free(now_src); }
        {   /* assert actor_closure(ROOT, seeds) == (actors, edges) */
            J *a0, *e0; Buf x = {0, 0, 0}, y = {0, 0, 0};
            a0 = getitem(basis, "actors"); e0 = getitem(basis, "actor_edges");
            actor_closure();
            jdump(&x, a0, 0, 0); jdump(&x, e0, 0, 0);
            { J *a1 = actors_json(), *e1 = edges_json(); jdump(&y, a1, 0, 0); jdump(&y, e1, 0, 0); }
            if (x.n != y.n || memcmp(x.s, y.s, x.n)) raise_line("AssertionError");
            free(x.s); free(y.s);
        }
        if (sha_file(product, hex)) crash();
        if (strcmp(hex, product_sha)) raise_line("AssertionError");
        m = pjoin(work, "manifest.json");
        doc = jnew(JOBJ); outs = jnew(JOBJ);
        oset(doc, "basis", basis);
        for (i = 0; REQUIRED[i]; i++) { char *f = pjoin(work, REQUIRED[i]); if (sha_file(f, hex)) crash(); oset(outs, REQUIRED[i], jstr(hex)); free(f); }
        oset(doc, "outputs", outs);
        jdump(&man, doc, 0, 0); bch(&man, '\n');
        if (cx_write(m, man.s, man.n)) { throw_os(errno ? errno : EIO, m); crash(); }
        prov_write(m, sources);
        if (stat(CACHE, &s) == 0) rmtree(CACHE);
        if (rename(work, CACHE)) { throw_os(errno, work); crash(); }
        TD[0] = 0;
        if (!valid()) raise_line("AssertionError");
        printf("seed matrix PREPARED %s\n", KEY);
        return 0;
    }
    valid();   /* All validation precedes any subprocess; no construction on miss/corruption. */
    {
        const char *name = unit; char *td, *graph, *table, *ctable, *py, *c, *seedtbl, *seednet, *t; struct stat s;
        char *tmpd = gettempdir();
        mkdtemp_py(tmpd, "seed-matrix-consume-"); free(tmpd);
        td = TD; DEADLINE = now() + 20;
        t = cat(name, ".json"); graph = pjoin(CACHE, t); free(t);
        table = xmalloc(strlen(td) + strlen(name) + 16); sprintf(table, "%s/%s.tbl", td, name);
        ctable = xmalloc(strlen(td) + strlen(name) + 16); sprintf(ctable, "%s/%s.c.tbl", td, name);
        py = xmalloc(strlen(td) + strlen(name) + 16); sprintf(py, "%s/%s.py.net", td, name);
        c = xmalloc(strlen(td) + strlen(name) + 16); sprintf(c, "%s/%s.c.net", td, name);
        seedtbl = pjoin(CACHE, "seed-tbl"); seednet = pjoin(CACHE, "seed-net");
        { char *a[] = {PY, "exec/c/tbl.py", graph, table, 0}; run(a); }
        { char *a[] = {seedtbl, graph, ctable, 0}; run(a); }
        if (!same_file(table, ctable)) { Buf m = {0, 0, 0}; bstr(&m, "AssertionError: shared/"); bstr(&m, name); bstr(&m, ": seed/tbl.c table differs from exec/c/tbl.py"); raise_line(m.s); }
        printf("SEED_MATRIX_UNIT "); { Buf j = {0, 0, 0}; J *a = jnew(JARR); apush(a, jstr(name)); apush(a, jstr("table-exact")); jdump(&j, a, 0, 0); printf("%s\n", j.s); free(j.s); }
        fflush(stdout);
        { char *a[] = {PY, "exec/c/net.py", table, py, 0}; run(a); }
        { char *a[] = {seednet, table, c, 0}; run(a); }
        if (!same_file(py, c)) { Buf m = {0, 0, 0}; bstr(&m, "AssertionError: shared/"); bstr(&m, name); bstr(&m, ": first differing network byte"); raise_line(m.s); }
        printf("SEED_MATRIX_UNIT "); { Buf j = {0, 0, 0}; J *a = jnew(JARR); apush(a, jstr(name)); apush(a, jstr("network-exact")); jdump(&j, a, 0, 0); printf("%s\n", j.s); free(j.s); }
        fflush(stdout);
        if (stat(c, &s)) { throw_os(errno, c); crash(); }
        printf("seed matrix shared/%s: byte-identical tables and networks; %lld\n", name, (long long)s.st_size);
        fflush(stdout);
        rmtree(TD); TD[0] = 0;
    }
    return 0;
}
