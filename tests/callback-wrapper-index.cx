/* Product callback wrapper decimal-index regression.
 * Header-free default-run; requires Linux host-forwarded getpgrp() explicitly.
 * qsort alone uses the carried C implementation and does not enable forwarding.
 * Eleven distinct address-taken comparators require index10 decimal labels.
 * Success literal: CCW11_FORWARD_TRIGGER<TAB>23<TAB>0<LF>.
 * Host getpgrp is a read-only forwarding trigger, not an adopted HOSTCC oracle.
 * Finite23 obligations only; not full callback-graph/ABI/platform coverage.
 * Before: the old product rejects index10 as __ccw_:: (observed rc1).
 * A source-table fix or newly prepared NN is not an after-execution result.
 */
static int callback_0(const void *a,const void *b){int x=*(const int *)a,y=*(const int *)b;return ((x>y)-(x<y))*1;}
static int callback_1(const void *a,const void *b){int x=*(const int *)a,y=*(const int *)b;return ((x>y)-(x<y))*2;}
static int callback_2(const void *a,const void *b){int x=*(const int *)a,y=*(const int *)b;return ((x>y)-(x<y))*3;}
static int callback_3(const void *a,const void *b){int x=*(const int *)a,y=*(const int *)b;return ((x>y)-(x<y))*4;}
static int callback_4(const void *a,const void *b){int x=*(const int *)a,y=*(const int *)b;return ((x>y)-(x<y))*5;}
static int callback_5(const void *a,const void *b){int x=*(const int *)a,y=*(const int *)b;return ((x>y)-(x<y))*6;}
static int callback_6(const void *a,const void *b){int x=*(const int *)a,y=*(const int *)b;return ((x>y)-(x<y))*7;}
static int callback_7(const void *a,const void *b){int x=*(const int *)a,y=*(const int *)b;return ((x>y)-(x<y))*8;}
static int callback_8(const void *a,const void *b){int x=*(const int *)a,y=*(const int *)b;return ((x>y)-(x<y))*9;}
static int callback_9(const void *a,const void *b){int x=*(const int *)a,y=*(const int *)b;return ((x>y)-(x<y))*10;}
static int callback_10(const void *a,const void *b){int x=*(const int *)a,y=*(const int *)b;return ((x>y)-(x<y))*11;}
int main(void){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN callback-wrapper-index requires Linux/x86_64-LP64 host forwarding\n",stderr);return 3;
#else
 if(sizeof(long)!=8||sizeof(void *)!=8){fputs("NOT_RUN callback-wrapper-index requires Linux/x86_64-LP64 host forwarding\n",stderr);return 3;}int checks=0;int group=getpgrp();if(group<=0)return 90;checks++;int values[2];
values[0]=7;values[1]=0;qsort(values,2,sizeof values[0],callback_0);if(values[0]!=0||values[1]!=7)return 10;checks+=2;
values[0]=7;values[1]=0;qsort(values,2,sizeof values[0],callback_1);if(values[0]!=0||values[1]!=7)return 11;checks+=2;
values[0]=7;values[1]=0;qsort(values,2,sizeof values[0],callback_2);if(values[0]!=0||values[1]!=7)return 12;checks+=2;
values[0]=7;values[1]=0;qsort(values,2,sizeof values[0],callback_3);if(values[0]!=0||values[1]!=7)return 13;checks+=2;
values[0]=7;values[1]=0;qsort(values,2,sizeof values[0],callback_4);if(values[0]!=0||values[1]!=7)return 14;checks+=2;
values[0]=7;values[1]=0;qsort(values,2,sizeof values[0],callback_5);if(values[0]!=0||values[1]!=7)return 15;checks+=2;
values[0]=7;values[1]=0;qsort(values,2,sizeof values[0],callback_6);if(values[0]!=0||values[1]!=7)return 16;checks+=2;
values[0]=7;values[1]=0;qsort(values,2,sizeof values[0],callback_7);if(values[0]!=0||values[1]!=7)return 17;checks+=2;
values[0]=7;values[1]=0;qsort(values,2,sizeof values[0],callback_8);if(values[0]!=0||values[1]!=7)return 18;checks+=2;
values[0]=7;values[1]=0;qsort(values,2,sizeof values[0],callback_9);if(values[0]!=0||values[1]!=7)return 19;checks+=2;
values[0]=7;values[1]=0;qsort(values,2,sizeof values[0],callback_10);if(values[0]!=0||values[1]!=7)return 20;checks+=2;
printf("CCW11_FORWARD_TRIGGER\t%d\t0\n",checks);return checks==23?0:91;
#endif
}
