/* ROOT PREPARED_PP_MATERIAL NEW_ABS_OUT. One precise regression, caller55.
 * Two actual material verify children20 + final source observation8 =48s
 * explicit maxima, unmeasured until the parent runs this frozen draft.
 * Changes a private valid NN's W2 and its unsigned receipt SHA together.
 * No construction or inference: recipe eligibility is the tested contract. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
static char root[4096],mat[4096],work[4096],copydir[4400],product[4400],bound[4400],tool[4400],ident[4400],self[4096];
static const char *leaves[]={"pp.weights","pp-observe.cx","material.tsv"};
static int assertions,failures;
static void die(const char *s){fprintf(stderr,"pp-gold-controls: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void ck(int ok,const char *s){assertions++;if(!ok)failures++;printf("%s\tpp-gold-controls.%s\n",ok?"PASS":"FAIL",s);}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input-absent":"input-stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_CLOEXEC|O_NONBLOCK|O_NOFOLLOW);if(fd<0)die("input-open");if(fstat(fd,&b)||!S_ISREG(b.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size){close(fd);die("input-descriptor");}*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s){close(fd);die("allocation");}size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);free(s);die("input-extent");}at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||bad||closed){free(s);die("input-changed-or-close");}s[*n]=0;return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void put(const char *p,const char *s,size_t n,int fresh){int fd=open(p,O_WRONLY|O_CLOEXEC|O_NOFOLLOW|(fresh?(O_CREAT|O_EXCL):O_TRUNC),0600);if(fd<0)die("private-output-open");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("private-output-write");}at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("private-output-close");}
static void save(const char *name,const char *s,size_t n){char p[4400];path(p,work,name);put(p,s,n,1);}
static int inside(const char *p,const char *base){size_t n=strlen(base);return !strncmp(p,base,n)&&(!p[n]||p[n]=='/');}
static void newout(const char *arg){if(arg[0]!='/'||strlen(arg)>=sizeof work||strpbrk(arg,"\r\n\t"))die("absolute-new-output");char tmp[4096],base[4096],leaf[4096];strcpy(tmp,arg);char *slash=strrchr(tmp,'/');if(!slash||!slash[1]||tx_eq(slash+1, ".", 1L << 20)||tx_eq(slash+1, "..", 1L << 20))die("new-output-leaf");strcpy(leaf,slash+1);if(slash==tmp)slash[1]=0;else *slash=0;if(!realpath(tmp,base))die("output-parent");int n=snprintf(work,sizeof work,"%s%s%s",base,strcmp(base,"/")?"/":"",leaf);if(n<0||(size_t)n>=sizeof work||inside(work,mat)||mkdir(work,0700))die("fresh-output-outside-original-material");}
static np_result call(char **v,int seconds,const char *label){if(unsetenv("UNISACC_RF_CAPTURE")||unsetenv("UNISA_ATTRIBUTES"))die("clear-ambient-resources");np_result r;char why[1400],name[100],status[100];int error=np_run(v,root,0,seconds+2,&r,why,sizeof why);int n=error?snprintf(status,sizeof status,"rc\tUNAVAILABLE\nrunner_error\t1\n"):snprintf(status,sizeof status,"rc\t%d\nrunner_error\t0\n",r.rc);if(n<0||(size_t)n>=sizeof status)die("status-extent");snprintf(name,sizeof name,"%s.status",label);save(name,status,(size_t)n);snprintf(name,sizeof name,"%s.stdout",label);save(name,r.out,r.outn);snprintf(name,sizeof name,"%s.stderr",label);save(name,r.err,r.errn);np_buf args={0};for(int i=0;v[i];i++){char key[40];snprintf(key,sizeof key,"arg-%d\t",i);np_puts(&args,key);np_puts(&args,v[i]);np_puts(&args,"\n");}snprintf(name,sizeof name,"%s.argv.tsv",label);save(name,args.p,args.n);free(args.p);if(error){snprintf(name,sizeof name,"%s.error",label);save(name,why,strlen(why));np_free(&r);die(why);}return r;}
static np_result verify(const char *label){char *v[]={bound,"20","sh",product,tool,"--","--verify",root,copydir,0};return call(v,20,label);}
/* Only the unique complete line's 64 hex bytes are mutable. */
static char *hash_field(char *s,size_t n,const char *key){if(memchr(s,0,n)||!n||s[n-1]!='\n')die("receipt-wire");char tag[100];int z=snprintf(tag,sizeof tag,"\n%s\t",key);if(z<0||(size_t)z>=sizeof tag)die("receipt-field-key");char *p=strstr(s,tag);if(!p||strstr(p+1,tag))die("unique-receipt-field");p+=strlen(tag);if((size_t)(p-s)+64>=n||p[64]!='\n')die("receipt-field-extent");for(int i=0;i<64;i++)if(!((p[i]>='0'&&p[i]<='9')||(p[i]>='a'&&p[i]<='f')))die("receipt-field-hex");return p;}
static int named(const np_result *r){const char *p="pp-gold-material: REFUSE canonical-six-cube-unit-class-or-weight-mismatch errno=";size_t n=strlen(p);if(r->errn<=n+1||memcmp(r->err,p,n)||r->err[r->errn-1]!='\n')return 0;for(size_t i=n;i+1<r->errn;i++)if(r->err[i]<'0'||r->err[i]>'9')return 0;return 1;}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN pp-gold-controls requires Linux/x86_64 LP64\n",stderr);return 3;
#endif
 if(argc!=4||sizeof(long)!=8||!realpath(argv[1],root)||!realpath(argv[2],mat)||!realpath(__FILE__,self))die("usage-ROOT-MATERIAL-NEW-ABS-OUT");newout(argv[3]);path(copydir,work,"copy");if(mkdir(copydir,0700))die("private-clone-directory");path(product,root,"unisacc.com");path(bound,root,"tools/bound");path(tool,root,"tools/pp-gold-material.cx");path(ident,root,"seed/ident.c");
 const char *deps[]={"unisacc.com","tools/pp-gold-material.cx","weights/gold/pp.tsv","exec/kernel/body.c","tools/cxlib/netpack.cx","seed/ident.c","tools/bound"};char watched[11][4400],before[11][65],after[65],p[4400],q[4400];for(int i=0;i<7;i++)path(watched[i],root,deps[i]);strcpy(watched[7],self);for(int i=0;i<3;i++)path(watched[i+8],mat,leaves[i]);for(int i=0;i<11;i++){digest(watched[i],before[i]);printf("INPUT\t%s\tsha256=%s\n",watched[i],before[i]);}
 for(int i=0;i<3;i++){size_t n;char h[65];path(p,mat,leaves[i]);path(q,copydir,leaves[i]);char *s=load(p,&n);cx_sha256_hex(s,n,h);if(strcmp(h,before[i+8]))die("original-changed-while-cloning");put(q,s,n,1);free(s);}
 np_result r=verify("clone-valid");const char *gold="VERIFIED\tpp-gold-material\tno-test-result\n";int good=!r.rc&&!r.errn&&r.outn==strlen(gold)&&!memcmp(r.out,gold,r.outn);ck(good,"actual-private-clone-verified");if(!good){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("valid-clone-prerequisite");}np_free(&r);
 size_t rn;path(p,copydir,"material.tsv");char *receipt=load(p,&rn);char *sid=hash_field(receipt,rn,"source");char source_id[65];memcpy(source_id,sid,64);source_id[64]=0;char *field=hash_field(receipt,rn,"pp.weights");if(memcmp(field,before[8],64))die("baseline-receipt-weight-hash");
 size_t wn;path(q,copydir,"pp.weights");char *w=load(q,&wn);const unsigned char first[7]={0,0,0,0,0,1,0};int valid=wn==142&&!memcmp(w+96,"\6\0\0\0",4)&&!memcmp(w+100,first,sizeof first);ck(valid,"private-mutation-is-valid-first-unit-W2-only");if(!valid){free(receipt);free(w);die("valid-private-W2-precondition");}w[105]=2;w[106]=0;char changed_hash[65];cx_sha256_hex(w,wn,changed_hash);ck(strcmp(changed_hash,before[8])!=0,"private-weight-full-SHA-differs");put(q,w,wn,0);free(w);
 memcpy(field,changed_hash,64);put(p,receipt,rn,0);free(receipt);char mutated[3][65];for(int i=0;i<3;i++){path(p,copydir,leaves[i]);digest(p,mutated[i]);}ck(tx_eq(mutated[0], changed_hash, 1L << 20),"private-receipt-and-actual-weight-SHA-synchronized");ck(tx_eq(mutated[1], before[9], 1L << 20),"private-observer-unchanged");
 /* The baseline contract requires W2=1; W2=2 remains a valid NN candidate
  * for the separate actual-infer sensitivity test, not a malformed NN. */
 r=verify("self-consistent-noncanonical");ck(r.rc==2,"noncanonical-recipe-rc2");ck(!r.outn,"noncanonical-recipe-empty-stdout");ck(named(&r),"exact-canonical-recipe-reason");if(r.errn&&!named(&r))fwrite(r.err,1,r.errn,stderr);np_free(&r);
 for(int i=0;i<3;i++){path(p,copydir,leaves[i]);digest(p,after);char label[100];snprintf(label,sizeof label,"private-mutated-%s-not-overwritten",leaves[i]);ck(tx_eq(mutated[i], after, 1L << 20),label);}
 char *v[]={bound,"8","sh",product,ident,"--",root,0};r=call(v,8,"source-after");ck(!r.rc&&!r.errn&&r.outn==65&&r.out[64]=='\n'&&!memcmp(r.out,source_id,64),"fresh-final-full-source-matches-material-SID");np_free(&r);
 for(int i=0;i<11;i++){digest(watched[i],after);char label[100];snprintf(label,sizeof label,"original-input-%d-unchanged",i);ck(tx_eq(before[i], after, 1L << 20),label);}
 puts("BOUNDARY\tvalid-private-W2-2-rejected-as-fixed-baseline-recipe-only;actual-infer-sensitivity-is-separate-pp-constructed-evidence");puts("NOT_CLAIMED\tNN-inference-new-material-construction-atomic-snapshot-or-global-Python-independence");puts("TIMING\tstartup_loading_validation_output_cold_hot=UNMEASURED");printf("PP_GOLD_CONTROLS\tassertions=%d\tfailed=%d\tscope=one-self-consistent-unsigned-receipt-noncanonical-weight-control\n",assertions,failures);return failures?1:0;
}
