/* Linux/x86_64 actual C lookup consumers; synthetic PK is lookup-only.
 * ROOT MATERIAL NEW_ABS_OUT. Caller tools/bound 55.
 * NULL,0 has an active memcpy hook plus owned-slot/growth/nonempty contracts. */
#pragma unisa use cxlib.netpack
static char root[4096],material[4096],work[4096],bound[4400],product[4400],tool[4400],image[4400];
static int assertions,failures;
static void die(const char *s){fprintf(stderr,"ri-consumers: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void join(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path bound");}
static void ck(int ok,const char *s){assertions++;if(!ok)failures++;printf("%s\tri-consumers.%s\n",ok?"PASS":"FAIL",s);}
static void digest(char h[65]){struct stat st,after;if(lstat(image,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>16777216)die("native regular image");int fd=open(image,O_RDONLY|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK);if(fd<0||fstat(fd,&after)||st.st_dev!=after.st_dev||st.st_ino!=after.st_ino||st.st_size!=after.st_size)die("native descriptor identity");size_t n=(size_t)st.st_size,at=0;char *s=malloc(n+1);if(!s)die("native allocation");while(at<n){ssize_t z=read(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("native extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&after)||st.st_dev!=after.st_dev||st.st_ino!=after.st_ino||st.st_size!=after.st_size;int closed=close(fd);if(z||bad||closed)die("native changed while reading");cx_sha256_hex(s,n,h);free(s);}
static void save(const char *name,const char *bytes,size_t n){char p[4400];join(p,work,name);int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive evidence");size_t at=0;while(at<n){ssize_t z=write(fd,bytes+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("evidence write");at+=(size_t)z;}if(close(fd))die("evidence close");}
static np_result call(char **v,int seconds,const char *label){char why[1024],name[160],rc[40];if(unsetenv("UNISACC_RF_CAPTURE"))die("clear ambient capture");np_result r;if(np_run(v,root,0,seconds,&r,why,sizeof why))die(why);snprintf(name,sizeof name,"%s.stdout",label);save(name,r.out,r.outn);snprintf(name,sizeof name,"%s.stderr",label);save(name,r.err,r.errn);int n=snprintf(rc,sizeof rc,"rc\t%d\n",r.rc);snprintf(name,sizeof name,"%s.status",label);save(name,rc,(size_t)n);return r;}
static void verify(const char *label){char *v[]={bound,"18","sh",product,tool,"--","--verify-native",root,material,"tests/cases/ri-consumers.cx",0};np_result r=call(v,18,label);const char *tail="VERIFIED\tri-material\tno-test-result\n";size_t n=strlen(tail);int ok=!r.rc&&!r.errn&&r.outn>=n&&!memcmp(r.out+r.outn-n,tail,n);ck(ok,label);if(!ok){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("native material verification failed");}np_free(&r);}
static np_result run(const char *mode){char dir[4400];join(dir,work,mode);char *v[]={bound,"2",image,(char *)mode,dir,0};return call(v,4,mode);}
static void positive(const char *mode,int count,const char *rows){np_buf b={0};np_puts(&b,rows);np_puts(&b,"NOT_CLAIMED\tP3-loading-full-model-route-capture-errors-foreign-hosts-or-general-memory-safety\nTIMING\tstartup_loading_lookup_output_validation_cold_hot=UNMEASURED\n");char summary[250];snprintf(summary,sizeof summary,"RI_CONSUMERS\tmode=%s\tassertions=%d\tfailed=0\tscope=actual-C-consumer-lookup-and-SC1-snapshot-map\n",mode,count);np_puts(&b,summary);np_result r=run(mode);ck(!r.rc&&!r.errn&&r.outn==b.n&&!memcmp(r.out,b.p,b.n),mode);free(b.p);np_free(&r);}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN ri-consumers requires Linux/x86_64\n",stderr);return 3;
#endif
 if(argc!=4||!realpath(argv[1],root)||!realpath(argv[2],material)||argv[3][0]!='/'||strlen(argv[3])>=sizeof work)die("usage ROOT MATERIAL NEW_ABS_OUT");strcpy(work,argv[3]);if(mkdir(work,0700))die("new private output required");join(bound,root,"tools/bound");join(product,root,"unisacc.com");join(tool,root,"tools/ri-material.cx");join(image,material,"runtime-native");
 verify("material-before");char before[65],after[65];digest(before);printf("NATIVE\tsha256=%s\n",before);
 positive("precedence",6,"PASS\tri-consumers.precedence.RI-over-RES-and-disk\nPASS\tri-consumers.precedence.RES-over-disk\nPASS\tri-consumers.precedence.disk-owned-by-caller\nPASS\tri-consumers.precedence.missing-clears-output\nPASS\tri-consumers.precedence.RES-empty-shadows-disk-nonempty\nPASS\tri-consumers.precedence.disk-empty-still-present\n");
 positive("blob-cache",12,"PASS\tri-consumers.blob.zero-is-reserved-owned-slot\nPASS\tri-consumers.blob.RI-opaque-binary-key-and-value\nPASS\tri-consumers.cache.owns-query-key-copy\nPASS\tri-consumers.blob.owns-borrowed-RI-value-copy\nPASS\tri-consumers.cache.repeated-present-keeps-id-and-slots\nPASS\tri-consumers.blob.RES-distinguishes-bytes-after-NUL\nPASS\tri-consumers.cache.key-length-is-significant\nPASS\tri-consumers.blob.absent-is-zero\nPASS\tri-consumers.cache.repeated-absent-keeps-cache-and-blob-count\nPASS\tri-consumers.blob.present-empty-is-positive-owned-slot\nPASS\tri-consumers.cache.repeated-empty-keeps-positive-id\nPASS\tri-consumers.cache.explicit-owned-storage-clear\n");
 positive("snapshot-map",17,"PASS\tri-consumers.snapshot.valid-resigned-ABSENT-row-retained\nPASS\tri-consumers.snapshot.MISSING-is-not-ABSENT-row\nPASS\tri-consumers.snapshot.PRESENT-shadows-all-lower-providers\nPASS\tri-consumers.snapshot.EMPTY-shadows-nonempty-lower-providers\nPASS\tri-consumers.snapshot.opaque-binary-key-and-value\nPASS\tri-consumers.snapshot.absent-control-RI-exists\nPASS\tri-consumers.snapshot.ABSENT-masks-RI\nPASS\tri-consumers.snapshot.absent-control-RES-exists\nPASS\tri-consumers.snapshot.ABSENT-masks-RES\nPASS\tri-consumers.snapshot.absent-control-disk-exists\nPASS\tri-consumers.snapshot.ABSENT-masks-disk\nPASS\tri-consumers.snapshot.MISSING-falls-back-to-RI\nPASS\tri-consumers.snapshot.MISSING-falls-back-to-RES\nPASS\tri-consumers.snapshot.MISSING-falls-back-to-disk\nPASS\tri-consumers.snapshot.core-consumer-empty-versus-absent-id\nPASS\tri-consumers.snapshot.loaded-map-explicitly-cleared\nPASS\tri-consumers.snapshot.resigned-SC2-refused-as-map-and-empty-clearable\n");
 positive("strict-map",5,"PASS\tri-consumers.strict.SC1-PRESENT-is-only-source\nPASS\tri-consumers.strict.SC1-EMPTY-masks-lower-nonempty\nPASS\tri-consumers.strict.SC1-ABSENT-masks-lower-present\nPASS\tri-consumers.strict.missing-key-really-unlisted\nPASS\tri-consumers.strict.owned-ledger-cleared\n");
 np_result empty=run("null0");const char *empty_gold="PASS\tri-consumers.null0.empty-still-occupies-positive-slot\nPASS\tri-consumers.null0.empty-keeps-separate-owned-allocation\nPASS\tri-consumers.null0.nonempty-copy-unchanged\nPASS\tri-consumers.null0.grows-before-slot-write-and-preserves-values\nPASS\tri-consumers.null0.all-owned-slots-cleared\nRI_NULL0\tassertions=5\tfailed=0\n";ck(!empty.rc&&!empty.errn&&empty.outn==strlen(empty_gold)&&!memcmp(empty.out,empty_gold,empty.outn),"null0");np_free(&empty);
 np_result r=run("strict-missing");const char *reason="run: MISSING_EXPLICIT_RESOURCE 6d697373696e67\n";ck(r.rc==2,"strict-missing.rc2");ck(!r.outn&&r.errn==strlen(reason)&&!memcmp(r.err,reason,r.errn),"strict-missing.empty-stdout-exact-reason");np_free(&r);
 digest(after);ck(!strcmp(before,after),"native-unchanged");verify("material-after");puts("NOT_CLAIMED\tP3-loading-full-model-route-capture-errors-foreign-hosts-or-general-memory-safety");puts("TIMING\tstartup_construction_loading_inference_output_validation_cold_hot=UNMEASURED");printf("RI_CONSUMER_RUNNER\tassertions=%d\tfailed=%d\tfixture-positive-assertions=45\tstrict-missing-checks=2\n",assertions,failures);return failures?1:0;
}
