#!/usr/bin/env unisacc.com
/* PE test-side routing only; no verdict/material cache.
 * Caller bounds the complete default-run invocation at the unchanged41 budget.
 * Original commands, flags, assertions, environment/deadline and cleanup survive.
 * Both phases repeat runtime/encoder setup; no prepared material or verdict cache.
 * The original path is sh-c's $0, so its two-level ROOT lookup remains correct.
 * Forwarding still runs all three original cases and may itself exceed41.
 */
#define PE_SOURCE "./exec/enc/pecheck.sh"
#define PE_SHA "222bc2bc030cc7a9328dfc6706128acd81638c1878a574ff60bc468a1480a5bd"
/* First marker is a unique complete line suffix. Its end, not its start,
 * bounds setup: no new interpreter command is embedded in this adapter.
 * The complete source SHA pins the preceding original interpreter bytes too. */
static const char *const MARKERS[] = {
    "exec/c/tbl.py \"$T/arm.json\" \"$T/arm.tbl\"\n",
    "b ./tests/build_ref.sh \"$T/ref.c\" \"$T/ref\"\n"
};
static const char *const PARTS[] = { "base", "forward" };
/* A common setup; B original PE structural/real-image checks;
 * C original fresh reference + lower construction + ALL forwarding checks.
 * A+B+C reconstructs the complete original; base=A+B, forward=A+C. */
static const int SELECT[2][3] = { {1,1,0}, {1,0,1} };
static int emit(const char *s) {
    size_t n=strlen(s);while(n){ssize_t k=write(1,s,n);
        if(k>0){s+=k;n-=(size_t)k;}
        else if(k<0&&errno==EINTR)continue;else return 1;}return 0;
}
static int fail(const char *why) {
    fprintf(stderr,"pephase: FAIL %s\n",why); return 1;
}
int main(int argc,char **argv) {
    char *source,*marker[2],*line,*rebuilt,*script,*command[5];
    char hex[65];size_t n,offsets[4],lens[3],cursor,total;
    int i,part=-1;
    if(argc!=2)return fail("usage: pephase.cx base|forward");
    for(i=0;i<2;i++)if(!strcmp(argv[1],PARTS[i]))part=i;
    if(part<0)return fail("unknown phase");
    source=cx_read(PE_SOURCE,&n);
    if(!source)return fail("cannot read original source");
    if(!n||n>16384||memchr(source,0,n))return fail("source length/NUL");
    cx_sha256_hex(source,n,hex);
    if(strcmp(hex,PE_SHA))return fail("original source SHA changed");
    for(i=0;i<2;i++){
        marker[i]=strstr(source,MARKERS[i]);
        if(!marker[i]||strstr(marker[i]+1,MARKERS[i]))
            return fail("missing/ambiguous exact marker");
        if(i&&marker[i]<=marker[i-1])return fail("marker order");
    }
    if(marker[1]!=source&&marker[1][-1]!='\n')return fail("reference marker not full line");
    line=marker[0];while(line>source&&line[-1]!='\n')line--;
    if(line==marker[0])return fail("table marker lacks original command prefix");
    offsets[0]=0;
    offsets[1]=(size_t)(marker[0]-source)+strlen(MARKERS[0]);
    offsets[2]=(size_t)(marker[1]-source);
    offsets[3]=n;
    rebuilt=malloc(n+1);if(!rebuilt)return fail("allocation");
    cursor=0;
    for(i=0;i<3;i++){
        if(offsets[i+1]<=offsets[i])return fail("empty/out-of-order block");
        lens[i]=offsets[i+1]-offsets[i];
        memcpy(rebuilt+cursor,source+offsets[i],lens[i]);cursor+=lens[i];
    }
    rebuilt[cursor]=0;cx_sha256_hex(rebuilt,cursor,hex);
    if(cursor!=n||memcmp(rebuilt,source,n)||strcmp(hex,PE_SHA))
        return fail("A+B+C does not reconstruct entire original");
    if(SELECT[0][0]!=1||SELECT[1][0]!=1||
       SELECT[0][1]!=1||SELECT[1][1]!=0||
       SELECT[0][2]!=0||SELECT[1][2]!=1)
        return fail("invalid exact phase partition");
    total=0;for(i=0;i<3;i++)if(SELECT[part][i])total+=lens[i];
    if(!total||total>n)return fail("selected script size");
    script=malloc(total+1);if(!script)return fail("allocation");
    cursor=0;for(i=0;i<3;i++)if(SELECT[part][i]){
        memcpy(script+cursor,source+offsets[i],lens[i]);cursor+=lens[i];
    }
    script[cursor]=0;if(cursor!=total)return fail("selection length");
    free(rebuilt);free(source);
    if(emit("pephase ")||emit(PARTS[part])||emit(" original-sha " PE_SHA "\n"))
        return fail("progress output failed");
    command[0]="sh";command[1]="-c";command[2]=script;
    command[3]=PE_SOURCE;command[4]=0;
    execvp(command[0],command);free(script);return fail("exec sh failed");
}
