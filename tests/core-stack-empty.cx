/* core-stack-empty.cx -- negative contract of cx/core/stack.cx: popping an empty value stack must reach
   core_host_panic, not return.  tools/check-core-stack-empty.cx makes the panic hook print its message and
   exit 37, and returns 1 if the pop ever comes back.  This wrapper runs it fresh and requires exactly that
   exit and message.  Run from the repo root:  sh ./unisacc.com tests/core-stack-empty.cx */
#pragma unisa use text.text
int main(void) {
    char *out = 0;
    size_t n = 0;
    int rc = cx_run("sh ./unisacc.com tools/check-core-stack-empty.cx 2>&1", &out, &n);
    int ok_rc = rc == 37;
    int ok_msg = out && tx_find(out, (long)n, "pop of an empty stack", 21) >= 0;
    printf("%s\tcore-stack-empty.panic-exit-37\trc=%d\n", ok_rc ? "PASS" : "FAIL", rc);
    printf("%s\tcore-stack-empty.panic-message\n", ok_msg ? "PASS" : "FAIL");
    printf("CORE_STACK_EMPTY\tfailed=%d\n", !ok_rc + !ok_msg);
    return ok_rc && ok_msg ? 0 : 1;
}
