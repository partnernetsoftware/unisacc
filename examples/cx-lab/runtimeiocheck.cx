#!/usr/bin/env -S unisacc.com -run
/* examples/cx-lab/runtimeiocheck.cx -- lab experiment, not part of the product.
 *
 * A .cx port of tests/runtimeiocheck.py: build a 65539-byte binary fixture (bytes 0..255
 * repeating, so it exercises CRLF/DOS-EOF bytes too), compile the real tests/runtimeiobytes.c
 * (read-only reference, untouched) twice -- once plain, once under ASan/UBSan -- run each
 * against the fixture, and check the exact expected line came back with nothing on stderr.
 * Dependency: archive/testing-c43-legacy/tests/runtimeiobytes.c (moved there when tests/ was
 * archived) and archive/reference-c/exec/c/run.c (it includes it); if either is missing the
 * check refuses with a named message, rc 2, not FAIL.
 * Writes bytes.bin, native, sanitised and runtimeio.tsv under $CXLAB_OUT (default
 * ${TMPDIR:-/tmp}/cx-lab-out); never inside the repository.
 *
 * Run from the repo root:  ./unisacc.com -run examples/cx-lab/runtimeiocheck.cx
 */
#pragma unisa use cxlab
#pragma unisa use sys.fs
#pragma unisa use text.text

#define FIXLEN 65539
#define SRC "archive/testing-c43-legacy/tests/runtimeiobytes.c"
static const char *WANT = "binary IO: 65539 bytes preserved\n";

int main(void) {
    unsigned char fixture[FIXLEN];
    int i, ok_all = 1;
    FILE *f;
    char od[512], fx[640], tsv[640];
    char *variants[2][2] = {
        {"native", ""},
        {"sanitised", "-fsanitize=address,undefined -fno-sanitize-recover=all"},
    };

    for (i = 0; i < FIXLEN; i++) fixture[i] = (unsigned char)(i % 256);

    if (sy_access(SRC, 4) != 0 || sy_access("archive/reference-c/exec/c/run.c", 4) != 0)
        return printf("runtimeiocheck: REFUSE missing dependency %s or archive/reference-c/exec/c/run.c (run from the repo root)\n", SRC), 2;
    cxlab_outdir(od, sizeof od);
    if (cx_fmt(fx, sizeof fx, "%s/bytes.bin", od)) fx[0] = 0;
    if (cx_write(fx, fixture, FIXLEN) != 0) {
        printf("runtimeiocheck: could not write the fixture\n"); return 1;
    }

    if (cx_fmt(tsv, sizeof tsv, "%s/runtimeio.tsv", od)) tsv[0] = 0;
    f = fopen(tsv, "wb");
    if (!f) { printf("runtimeiocheck: cannot open %s\n", tsv); return 1; }
    fprintf(f, "variant\tbuild_rc\trun_rc\tstdout_ok\n");

    for (i = 0; i < 2; i++) {
        char build_argv_buf[256];
        char *build_argv[16];
        char exe[64], *out; size_t n; int bn = 0, rc, stdout_ok;

        if (cx_fmt(exe, sizeof exe, "%s/%s", od, variants[i][0])) exe[0] = 0;
        build_argv[bn++] = "cc"; build_argv[bn++] = "-O2";
        if (variants[i][1][0]) {
            strcpy(build_argv_buf, variants[i][1]);
            {
                char *p = strtok(build_argv_buf, " ");
                while (p) { build_argv[bn++] = p; p = strtok(0, " "); }
            }
        }
        /* the archived source includes "../exec/c/run.c"; run.c now lives in archive/reference-c/exec/c */
        build_argv[bn++] = "-I"; build_argv[bn++] = "archive/reference-c/exec";
        build_argv[bn++] = "-I"; build_argv[bn++] = "exec/c"; /* core.h and the other headers run.c pulls in */
        build_argv[bn++] = SRC;
        build_argv[bn++] = "-o"; build_argv[bn++] = exe;
        build_argv[bn] = 0;

        rc = cx_runv_timeout(build_argv, 30, &out, &n); /* cc is a plain Mach-O/ELF, execvp works */
        free(out);
        if (rc != 0) {
            fprintf(f, "%s\t%d\t-\t0\n", variants[i][0], rc);
            printf("runtimeiocheck: %-10s build failed rc=%d -- REFUSE: legacy runtimeiobytes.c cannot be built by plain cc "
                   "(archived run.c needs cxcodec_*/cd_* symbols, now in .cx); binary IO NOT checked, not PASS, not FAIL\n",
                   variants[i][0], rc);
            return 2;
        }

        {
            char runcmd[1400];
            if (cx_fmt(runcmd, sizeof runcmd, "%s %s 2>&1", exe, fx)) runcmd[0] = 0;
            rc = cx_run_timeout(runcmd, 10, &out, &n); /* 2>&1: stderr must come back empty too */
            stdout_ok = out && strcmp(out, WANT) == 0;
            printf("runtimeiocheck: %-10s run_rc=%d stdout_ok=%d\n", variants[i][0], rc, stdout_ok);
            fprintf(f, "%s\t0\t%d\t%d\n", variants[i][0], rc, stdout_ok);
            if (rc != 0 || !stdout_ok) ok_all = 0;
            free(out);
        }
    }
    fclose(f);

    printf("runtimeiocheck: %s\n", ok_all ? "PASS" : "FAIL");
    return ok_all ? 0 : 1;
}
