#!/usr/bin/env -S unisacc.com -run
/* examples/cx-lab/time_run.cx -- lab experiment, not part of the product.
 *
 * A .cx port of examples/run-speed/time_run.py's core idea: time a few `unisacc.com`
 * invocations, take the median of a few repeats, write name/rc/seconds to a TSV.  Trimmed down
 * (fewer probes, smaller inputs) since this is a rewrite-style exercise, not a replacement for
 * that script.  Unlike examples/cx-lab/lex_table.cx, shelling out here is the actual point: the
 * thing being measured IS the external unisacc.com process, so cx_run_timeout (cx.h) is the
 * right tool, not a shortcut around doing the work in cx.
 *
 * The timing/median pair used to be local to this file; once lex_table.cx wanted the same
 * "run it N times, keep the middle" shape for its own checks, both moved to cxlab.h so neither
 * script carries its own copy.
 *
 * Reads examples/cx-lab/sample.c and (read-only) examples/run-speed/empty.c and printf_hi.c;
 * writes only under examples/cx-lab/out/.  Touches no file outside this lab.
 *
 * Run from the repo root:  ./unisacc.com -run examples/cx-lab/time_run.cx
 */
#include "cxlab.h"

#define REPEATS 3
#define TMO 20

int main(void) {
    FILE *f;
    int rc;
    double dt;

    system("mkdir -p examples/cx-lab/out");
    f = fopen("examples/cx-lab/out/times.tsv", "wb");
    if (!f) { printf("time_run: cannot open out/times.tsv\n"); return 1; }
    fprintf(f, "name\trc\tseconds\n");

    dt = cxlab_timed_median("./unisacc.com --version", REPEATS, TMO, &rc);
    printf("%-18s rc=%d %7.3fs\n", "version", rc, dt);
    fprintf(f, "version\t%d\t%.3f\n", rc, dt);

    dt = cxlab_timed_median("./unisacc.com -run examples/run-speed/empty.c", REPEATS, TMO, &rc);
    printf("%-18s rc=%d %7.3fs\n", "run empty", rc, dt);
    fprintf(f, "run_empty\t%d\t%.3f\n", rc, dt);

    dt = cxlab_timed_median("./unisacc.com -run examples/run-speed/printf_hi.c", REPEATS, TMO, &rc);
    printf("%-18s rc=%d %7.3fs\n", "run printf_hi", rc, dt);
    fprintf(f, "run_printf_hi\t%d\t%.3f\n", rc, dt);

    dt = cxlab_timed_median("./unisacc.com -run examples/cx-lab/sample.c", REPEATS, TMO, &rc);
    printf("%-18s rc=%d %7.3fs\n", "run sample", rc, dt);
    fprintf(f, "run_sample\t%d\t%.3f\n", rc, dt);

    dt = cxlab_timed_median("./unisacc.com -E examples/cx-lab/sample.c >/dev/null", REPEATS, TMO, &rc);
    printf("%-18s rc=%d %7.3fs\n", "E sample", rc, dt);
    fprintf(f, "E_sample\t%d\t%.3f\n", rc, dt);

    dt = cxlab_timed_median("./unisacc.com -c -o examples/cx-lab/out/sample.o examples/cx-lab/sample.c", REPEATS, TMO, &rc);
    printf("%-18s rc=%d %7.3fs\n", "c sample", rc, dt);
    fprintf(f, "c_sample\t%d\t%.3f\n", rc, dt);

    fclose(f);
    printf("time_run: wrote examples/cx-lab/out/times.tsv\n");
    return 0;
}
