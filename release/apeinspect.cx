/* release/apeinspect.cx -- inspect bounded APE package/certificate extents; does not authenticate
 * signatures.  The native form of release/apeinspect.py (archived at
 * archive/reference-py/release/apeinspect.py), output byte for byte the same:
 *
 *   sh ./unisacc.com release/apeinspect.cx -- FILE...
 *
 * prints one JSON list (indent 2, keys in the Python order) with, per file, the file size, the
 * UNIPKG1 footer and package extents, the PE security-directory (certificate table) extent, the
 * footer padding, the file and package sha256 and "authentication": "not_checked".  A file that
 * is not a well-formed APE prints "PATH: REASON" on stderr and exits 1, as the Python argparse exit
 * did.  The checks themselves are ape_inspect in release/ci/apecore.cx, shared with the
 * windows-signing gate release/ci/validate-manifest.cx. */
#pragma unisa use ci.apecore

/* json.dumps of a path given as UTF-8 bytes (ensure_ascii: \uXXXX, surrogate pairs above U+FFFF;
   a byte that is not UTF-8 is a lone surrogate U+DC80..U+DCFF, as Python's filesystem decoding). */
static void ai_json_str(const char *s) {
    const unsigned char *p = (const unsigned char *)s;
    putchar('"');
    while (*p) {
        unsigned c = *p, cp = 0;
        int need = 0, k;
        if (c == '"' || c == '\\') { putchar('\\'); putchar((int)c); p++; continue; }
        if (c == '\n') { fputs("\\n", stdout); p++; continue; }
        if (c == '\r') { fputs("\\r", stdout); p++; continue; }
        if (c == '\t') { fputs("\\t", stdout); p++; continue; }
        if (c == '\b') { fputs("\\b", stdout); p++; continue; }
        if (c == '\f') { fputs("\\f", stdout); p++; continue; }
        if (c < 0x20 || c == 0x7f) { printf("\\u%04x", c); p++; continue; }
        if (c < 0x80) { putchar((int)c); p++; continue; }
        if ((c & 0xe0) == 0xc0) { need = 1; cp = c & 0x1f; }
        else if ((c & 0xf0) == 0xe0) { need = 2; cp = c & 0x0f; }
        else if ((c & 0xf8) == 0xf0) { need = 3; cp = c & 0x07; }
        for (k = 1; need && k <= need; k++) {
            if ((p[k] & 0xc0) != 0x80) { need = 0; break; }
            cp = (cp << 6) | (p[k] & 0x3f);
        }
        if (!need || (need == 1 && cp < 0x80) || (need == 2 && cp < 0x800) || (need == 3 && (cp < 0x10000 || cp > 0x10ffff)) ||
            (cp >= 0xd800 && cp <= 0xdfff)) {
            printf("\\u%04x", 0xdc00 + c); p++; continue;
        }
        if (cp >= 0x10000) { cp -= 0x10000; printf("\\u%04x\\u%04x", 0xd800 + (cp >> 10), 0xdc00 + (cp & 0x3ff)); }
        else printf("\\u%04x", cp);
        p += need + 1;
    }
    putchar('"');
}

/* Checks one file; on a malformed one prints "PATH: REASON" on stderr and exits 1. */
static void ai_inspect(const char *path, ape_info_t *r) {
    size_t sz;
    const char *why = 0;
    const unsigned char *b = (const unsigned char *)cx_read(path, &sz);
    if (!b) { fprintf(stderr, "%s: cannot read\n", path); exit(1); }
    if (ape_inspect(b, (long)sz, r, &why) != 0) { fprintf(stderr, "%s: %s\n", path, why); exit(1); }
}

int main(int argc, char **argv) {
    static ape_info_t res[1024];
    int i;
    if (argc < 2 || argc > 1025) { fprintf(stderr, "usage: apeinspect.cx FILE... (at most 1024)\n"); return 2; }
    for (i = 1; i < argc; i++) ai_inspect(argv[i], &res[i - 1]);   /* all checked before any output, as in the Python */
    printf("[");
    for (i = 1; i < argc; i++) {
        ape_info_t *r = &res[i - 1];
        printf("%s\n  {\n    \"path\": ", i > 1 ? "," : "");
        ai_json_str(argv[i]);
        printf(",\n    \"file_size\": %ld,\n    \"footer_offset\": %ld,\n    \"package_offset\": %ld,\n    \"package_length\": %ld,\n"
               "    \"certificate_offset\": %ld,\n    \"certificate_length\": %ld,\n    \"padding\": %ld,\n"
               "    \"sha256\": \"%s\",\n    \"package_sha256\": \"%s\",\n    \"authentication\": \"not_checked\"\n  }",
               r->size, r->footer, r->footer - r->length, r->length, r->cert, r->certlen, r->padding, r->sha, r->psha);
    }
    printf("\n]\n");
    return 0;
}
