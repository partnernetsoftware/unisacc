/* Read-only release rehearsal. ROOT TABLE NEW_OUT OLD_APE DRAFT.
 * TABLE is the single candidate source; no uploads or release edits.
 * NEW_OUT must be absolute and absent. Every child is bounded; stdout/stderr/rc are retained. */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.releasecandidate
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.sig
#pragma unisa use text.text
#pragma unisa use text.fmt
static char root[4096],out[4096];
static const char *role[]={"ape","package","win-arm64","record"};
static RcCandidate candidate;
static void die(const char *s){sy_eprintf("C47_READBACK REFUSED %s\n",s);sy_exit(1);}
static void join(char *p,size_t cap,const char *dir,const char *file){if(cx_fmt(p,cap,"%s/%s",dir,file))die("path");}
static void save(const char *label,const char *suffix,const char *b,size_t n){char p[4400];if(cx_fmt(p,sizeof p,"%s/%s.%s",out,label,suffix))die("receipt path");int fd=sy_open_new(p,0600);if(fd<0)die("receipt create");int rc=sy_write_all(fd,b,(long)n),closed=sy_close(fd);if(rc||closed)die("receipt write");}
static np_result command(const char *label,char **v,const char *cwd,int bound){np_result r={0};char why[1024],status[64];if(np_run(v,cwd,0,bound,&r,why,sizeof why))die(why);save(label,"stdout",r.out,r.outn);save(label,"stderr",r.err,r.errn);int n=tx_snprintf(status,sizeof status,"rc=%d residue=%d\n",r.rc,r.residue);if(n<0||n>=(int)sizeof status)die("status length");save(label,"status",status,(size_t)n);if(r.outn&&sy_write_all(1,r.out,(long)r.outn))die("stdout");if(r.errn&&sy_write_all(2,r.err,(long)r.errn))die("stderr");if(r.rc||r.residue)die(label);sy_printf("READBACK_STEP %s PASS\n",label);return r;}
static void run(const char *label,char **v,const char *cwd,int bound){np_result r=command(label,v,cwd,bound);np_free(&r);}
int main(int argc,char **argv){
    char download[4400],layout[4400],p[4600],exe[4400],tool[4400],table[4096],why[1024],query[1024],version[128];int i;
    if(argc!=6)die("usage: ROOT TABLE NEW_OUT OLD_APE true|false");
    if(sy_realpath(argv[1],root,sizeof root)<0||sy_realpath(argv[2],table,sizeof table)<0||argv[3][0]!='/'||(!tx_eqz(argv[5],"true")&&!tx_eqz(argv[5],"false")))die("arguments");
    if(rcand_load(table,&candidate,why,sizeof why))die(why);
    if(cx_fmt(out,sizeof out,"%s",argv[3]))die("output path");int made=sy_mkdir(out,0700);if(made){sy_eprintf("NEW_OUT: %s\n",sy_strerror(made));die("NEW_OUT creation");}
    join(download,sizeof download,out,"download");join(layout,sizeof layout,out,"layout");
    if(cx_fmt(query,sizeof query,"if .tagName == \"%s\" and .isDraft == %s and .isPrerelease == false and .targetCommitish == \"%s\" then . else error(\"release metadata mismatch\") end",candidate.tag,argv[5],candidate.commit))die("metadata query");
    char *metadata[]={"gh","release","view",candidate.tag,"--repo",candidate.repo,"--json","tagName,isDraft,isPrerelease,targetCommitish","--jq",query,0};run("metadata",metadata,root,15);
    if(tx_eqz(argv[5],"false")){char endpoint[512];if(cx_fmt(endpoint,sizeof endpoint,"repos/%s/git/ref/tags/%s",candidate.repo,candidate.tag))die("tag path");char *v[]={"gh","api",endpoint,"--jq",".object.sha",0};np_result r=command("tag",v,root,15);if(r.outn!=41||!tx_same(r.out,40,candidate.commit,40)||r.out[40]!='\n')die("tag commit");np_free(&r);}
    char *fetch[]={"gh","release","download",candidate.tag,"--repo",candidate.repo,"--dir",download,"--pattern",candidate.name[0],"--pattern",candidate.name[1],"--pattern",candidate.name[2],"--pattern",candidate.name[3],0};run("download",fetch,root,25);
    if(rcand_verify(&candidate,download,4,why,sizeof why))die(why);
    char *hashes[]={"sha256sum","--",candidate.name[0],candidate.name[1],candidate.name[2],candidate.name[3],0};np_result hr=command("asset-sha",hashes,download,10);long pos=0;for(i=0;i<4;i++){char expected[384];int len=tx_snprintf(expected,sizeof expected,"%s  %s\n",candidate.sha[i],candidate.name[i]);if(len<0||len>=(int)sizeof expected||pos+len>(long)hr.outn||!tx_same(hr.out+pos,len,expected,len))die(role[i]);pos+=len;sy_printf("READBACK_SHA %s %s\n",candidate.name[i],candidate.sha[i]);}if(pos!=(long)hr.outn)die("asset SHA rows");np_free(&hr);
    join(exe,sizeof exe,root,"unisacc.com");join(p,sizeof p,download,candidate.name[0]);
    char *ver[]={"sh",p,"--version",0};np_result r=command("version",ver,root,10);int n=tx_snprintf(version,sizeof version,"unisacc %s\n",candidate.version);if(n<0||(size_t)n>=sizeof version||!tx_same(r.out,(long)r.outn,version,n))die("version mismatch");np_free(&r);
    join(tool,sizeof tool,root,"tools/chain-step.cx");char *smoke[]={"sh",exe,tool,"--","smoke",p,0};run("smoke",smoke,root,45);
    join(tool,sizeof tool,root,"tools/check-run-comm.cx");char *comm[]={"sh",exe,tool,"--",root,p,argv[4],0};run("comm",comm,root,45);
    join(tool,sizeof tool,root,"tools/release-layout.cx");char *generate[]={"sh",exe,tool,"--","--candidate",table,download,layout,0};run("layout-generate",generate,root,45);
    char *check[]={"sh",exe,tool,"--","--candidate",table,"--check",layout,0};run("layout-check",check,root,45);
    char *sums[]={"sha256sum","--check",candidate.name[6],0};run("checksums",sums,layout,10);
    char *members[]={"unzip","-Z1",candidate.name[5],0};r=command("zip-members",members,layout,10);const char *expected="slice-win-arm64\npkg.bin\nrun.cmd\nREADME-win-arm64.txt\n";if(!tx_same(r.out,(long)r.outn,expected,tx_len(expected,128)))die("zip members");np_free(&r);
    sy_printf("C47_1_READBACK PASS expected_draft=%s tag=%s version=%s commit=%s output=%s\n",argv[5],candidate.tag,candidate.version,candidate.commit,out);return 0;
}
