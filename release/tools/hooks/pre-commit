#!/bin/bash
# pre-commit (0.0.40-prep, 机房主任 18:33; local install only: release/tools/install_hooks.sh).  A commit whose
# staged changes touch the shipping closure (tests/freezecheck.py product(), or unisacc.c) must come through
# release/tools/commitgate.sh, which marks its own git commit with UNISACC_COMMITGATE_RUN=1.  Other commits
# (docs, research, plans, tests) pass.  Renames are split (--no-renames) so a shipping source moved out is seen.
# The marker is a local convention, not enforcement: it can be set by hand.  Emergency bypass: UNISACC_COMMITGATE_SKIP=1 (logged to stderr).
set -o pipefail
[ "${UNISACC_COMMITGATE_RUN:-}" = 1 ] && exit 0
R=$(git rev-parse --show-toplevel) || exit 1
ship=$(git diff --cached --no-renames --name-only -z | python3 -c '
import sys; sys.path.insert(0, sys.argv[1] + "/tests")
from freezecheck import product
print(" ".join(p for p in sys.stdin.read().split("\0") if p and (p == "unisacc.c" or product(p))))' "$R") \
  || { echo "pre-commit: cannot classify staged paths; refusing (fail closed)" >&2; exit 1; }
[ -z "$ship" ] && exit 0
if [ "${UNISACC_COMMITGATE_SKIP:-}" = 1 ]; then
  echo "pre-commit: UNISACC_COMMITGATE_SKIP=1 -- shipping paths committed WITHOUT commitgate: $ship" >&2; exit 0
fi
echo "pre-commit: shipping paths must be committed through release/tools/commitgate.sh --suite <covering suite>: $ship" >&2
exit 1
