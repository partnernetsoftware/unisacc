/* fields.cx -- split a TSV line, trim, parse numbers, format: the text half of a script.
 *   sh ./unisacc.com skills/unisacc-cx/examples/fields.cx
 * tx_field borrows (offset,len) from the input -- no copy, no strtok, no global state. */
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use text.num
#pragma unisa use text.fmt

int main(void) {
    const char *row = "alpha\t 42 \tbeta";
    long n = tx_len(row, 256), k = tx_fields(row, n, '\t'), i, off, len, toff, tlen, v;
    char tmp[64], line[128];
    sy_printf("fields=%ld\n", k);
    for (i = 0; i < k; i++) {
        tx_field(row, n, '\t', i, &off, &len);
        tx_trim(row + off, len, &toff, &tlen);
        tx_copy(tmp, sizeof tmp, row + off + toff, tlen);
        if (tx_strtol_r(tmp, 0, 10, &v) == 0) tx_snprintf(line, sizeof line, "[%ld] int %ld", i, v);
        else tx_snprintf(line, sizeof line, "[%ld] str %s", i, tmp);
        sy_puts(line);
    }
    sy_printf("prefix=%d contains=%d\n", tx_prefix(row, n, "alp", 3), tx_contains(row, n, "beta", 4));
    return 0;
}
