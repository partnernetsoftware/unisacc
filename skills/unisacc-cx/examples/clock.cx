/* clock.cx -- wall clock, monotonic ms, strftime: time without <time.h>.
 *   TZ=UTC sh ./unisacc.com skills/unisacc-cx/examples/clock.cx
 * The epoch value is fixed so the output is reproducible; sy_now_ms is only shown as a delta. */
#pragma unisa use sys.io
#pragma unisa use sys.time

int main(void) {
    char out[64]; long t0 = sy_now_ms(), t1;
    if (sy_local_fmt(out, sizeof out, "%Y-%m-%d %H:%M:%S", 1700000000L) < 0) return 1;
    sy_puts(out);
    sy_sleep_ms(20);
    t1 = sy_now_ms();
    sy_printf("slept>=20ms: %d\n", t1 - t0 >= 20);
    sy_printf("wall_s>1.7e9: %d\n", sy_wall_s() > 1700000000L);
    return 0;
}
