/* use_kv.cx -- consume the kv module: handles, refusal of stale handles, no pointers cross the boundary.
 *   sh ./unisacc.com skills/unisacc-cx/examples/use_kv.cx */
#pragma unisa use sys.io
#pragma unisa use kv

int main(void) {
    long v = 0;
    int h = kv_put("answer", 42), h2 = kv_put("other", 7);
    sy_printf("live=%d get=%d v=%ld\n", kv_count(), kv_get(h, &v), v);
    sy_printf("drop=%d get_after_drop=%d live=%d\n", kv_drop(h), kv_get(h, &v), kv_count());
    sy_printf("drop_twice=%d\n", kv_drop(h));
    sy_printf("reuse_slot_new_handle_differs=%d\n", kv_put("again", 1) != h);
    sy_printf("other_still=%d\n", kv_get(h2, &v) == 0 && v == 7);
    return 0;
}
