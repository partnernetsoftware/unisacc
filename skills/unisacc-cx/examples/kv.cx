/* kv.cx -- a module with private state and generation-checked handles (the recommended shape).
 * Consumers `#pragma unisa use kv` (this file sits beside them); nothing here is reachable
 * except the four kv_* functions.  A stale handle (after kv_drop) is refused, not dereferenced. */
#pragma unisa module kv
#pragma unisa use mem.bytes
#pragma unisa use text.text

#define KV_SLOTS 8
typedef struct { int gen; char key[32]; long val; } kv_slot;
static kv_slot kv_tab[KV_SLOTS];                    /* module-private: not exported, not addressable */

/* a handle is slot*256 + generation; 0 is never valid */
int kv_put(const char *key, long val) {
    int i;
    for (i = 0; i < KV_SLOTS; i++) if (kv_tab[i].gen == 0 || (kv_tab[i].gen & 1) == 0) {
        kv_tab[i].gen = (kv_tab[i].gen | 1) + 2 * (kv_tab[i].gen != 0);  /* odd = live, bumps on reuse */
        if (kv_tab[i].gen > 250) { kv_tab[i].gen = 0; return -1; }         /* slot retired at the gen cap */
        tx_copy(kv_tab[i].key, sizeof kv_tab[i].key, key, tx_len(key, 31));
        kv_tab[i].val = val;
        return i * 256 + kv_tab[i].gen;
    }
    return -1;                                       /* full: a refusal, not a silent overwrite */
}
static kv_slot *kv_live(int h) {
    int i = h / 256, g = h % 256;
    if (h <= 0 || i >= KV_SLOTS || kv_tab[i].gen != g || (g & 1) == 0) return 0;
    return &kv_tab[i];
}
int kv_get(int h, long *out) { kv_slot *s = kv_live(h); if (!s) return -1; *out = s->val; return 0; }
int kv_drop(int h) { kv_slot *s = kv_live(h); if (!s) return -1; s->gen += 1; return 0; }  /* even = dead */
int kv_count(void) { int i, n = 0; for (i = 0; i < KV_SLOTS; i++) n += (kv_tab[i].gen & 1); return n; }
