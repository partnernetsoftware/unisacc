/* subprocess.cx -- run a child with argv (no shell), capture stdout, read the exit code.
 *   sh ./unisacc.com skills/unisacc-cx/examples/subprocess.cx
 * sy_run captures up to CAP bytes (cut=1 when truncated) and returns the exit code or -errno;
 * cx_runv_timeout adds a wall-clock limit (124 on timeout, whole process group killed). */
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use mem.heap

int main(void) {
    char out[256]; int cut = 0, rc; char *o = 0; size_t n = 0;
    char *echo[] = {"printf", "a\\tb\\n", 0};
    char *fail[] = {"sh", "-c", "exit 7", 0};
    char *slow[] = {"sleep", "5", 0};
    rc = sy_run(echo, out, sizeof out, &cut);
    sy_printf("echo rc=%d cut=%d out=[%s]\n", rc, cut, out);
    rc = sy_run(fail, out, sizeof out, &cut);
    sy_printf("fail rc=%d\n", rc);
    rc = cx_runv_timeout(slow, 1, &o, &n);
    sy_printf("slow rc=%d (124 = timeout)\n", rc);
    mm_free(o);
    return 0;
}
