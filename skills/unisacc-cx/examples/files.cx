/* files.cx -- write, stat, read back, remove: the file half of a script.
 *   sh ./unisacc.com skills/unisacc-cx/examples/files.cx -- DIR
 * Writes DIR/note.txt, prints its size/kind and the first line, then deletes exactly that file. */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use mem.heap
#pragma unisa use text.text

int main(int argc, char **argv) {
    char path[4096]; sy_stat_t st; size_t n = 0; char *b; long off, len;
    if (argc != 2) { sy_eprintf("usage: files.cx DIR\n"); return 2; }
    if (cx_path_join(path, sizeof path, argv[1], "note.txt")) return 2;
    if (cx_write(path, "first line\nsecond line\n", 23)) { sy_eprintf("cannot write %s\n", path); return 1; }
    if (sy_stat(path, &st) < 0) return 1;
    sy_printf("exists=%d size=%ld kind=%c\n", sy_exists(path), st.size, st.kind);
    b = cx_read(path, &n);                      /* whole file, malloc'd, NUL-terminated */
    if (!b) return 1;
    if (tx_field(b, (long)n, '\n', 0, &off, &len) == 0) sy_printf("line0=%.*s\n", (int)len, b + off);
    mm_free(b);
    sy_printf("unlink=%d exists=%d\n", sy_unlink(path), sy_exists(path));
    return 0;
}
