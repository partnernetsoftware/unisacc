/* hash.cx -- sha256 of a string, two providers: L0 sys.sha (kernel AF_ALG when present) and pure-cx crypto.
 *   sh ./unisacc.com skills/unisacc-cx/examples/hash.cx -- TEXT */
#pragma unisa use sys.io
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use crypto.sha256

int main(int argc, char **argv) {
    char a[65], b[65]; long n;
    if (argc != 2) return 2;
    n = tx_len(argv[1], 1L << 20);
    if (sy_sha256_hex(argv[1], n, a) < 0) return 1;
    if (cs_sha256_hex(argv[1], n, b) < 0) return 1;
    sy_printf("sys.sha    %s\n", a);
    sy_printf("crypto     %s\n", b);
    sy_printf("same=%d\n", tx_eqz(a, b));
    return 0;
}
