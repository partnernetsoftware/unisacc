/* env.cx -- environment variables and the working directory.
 *   SKILL_DEMO=1 sh ./unisacc.com skills/unisacc-cx/examples/env.cx
 * Prints SKILL_DEMO (or a fallback) and whether the cwd ends in a slash-free name. */
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use text.text

int main(void) {
    char cwd[4096];
    const char *v = sy_env_or("SKILL_DEMO", "unset");
    sy_printf("SKILL_DEMO=%s\n", v);
    sy_printf("MISSING_VAR is null: %d\n", sy_env("SKILL_DEMO_MISSING_XYZ") == 0);
    if (sy_cwd(cwd, sizeof cwd) < 0) return 1;
    sy_printf("cwd is absolute: %d\n", cwd[0] == '/');
    return 0;
}
