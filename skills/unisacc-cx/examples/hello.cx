/* hello.cx -- argv, stdin, exit code: the three things every script needs.
 *   sh ./unisacc.com skills/unisacc-cx/examples/hello.cx -- NAME...   < stdin
 * Prints one line per argument, then the byte count of stdin; exits 3 when no argument was given. */
#pragma unisa use sys.io
#pragma unisa use sys.fs

int main(int argc, char **argv) {
    char buf[4096];
    long n, total = 0, i;
    for (i = 1; i < argc; i++) sy_printf("hello, %s\n", argv[i]);
    while ((n = sy_read(0, buf, sizeof buf)) > 0) total += n;
    sy_printf("stdin bytes=%ld\n", total);
    if (argc < 2) { sy_eprintf("hello: no argument\n"); return 3; }
    return 0;
}
