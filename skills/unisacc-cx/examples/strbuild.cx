/* strbuild.cx -- String (text.build): an opaque growable string builder, join/append/cstr.
 *   sh ./unisacc.com skills/unisacc-cx/examples/strbuild.cx
 * Gap note: a unit that uses both mem.grow and text.build is refused by the installed 0.0.44
 * product ("mm_alloc exported by both heap and mem.heap"); keep them in separate units. */
#pragma unisa use sys.io
#pragma unisa use text.build

int main(void) {
    sb *s = sb_new();
    const char *parts[] = {"x", "y", "z"};
    int i;
    sb_join(s, parts, 3, ", ");
    sb_puts(s, " -> ");
    for (i = 0; i < 3; i++) sb_putc(s, 'a' + i);
    sy_printf("%s (%ld bytes)\n", sb_cstr(s), sb_len(s));
    sb_truncate(s, 7);
    sy_printf("truncated: %s\n", sb_cstr(s));
    sb_clear(s);
    sy_printf("cleared len=%ld\n", sb_len(s));
    sb_free(s);
    return 0;
}
