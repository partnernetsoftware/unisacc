/* vec.cx -- Vec<u8> (mem.grow) and &[u8] (mem.slice): owned buffer, borrowed view, move semantics.
 *   sh ./unisacc.com skills/unisacc-cx/examples/vec.cx
 * Every operation is bounds-checked and returns 0 / -1; a failed call leaves the buffer unchanged. */
#pragma unisa use sys.io
#pragma unisa use mem.grow
#pragma unisa use mem.slice

int main(void) {
    mg_buf a, b; ms_slice s, sub; int c = 0;
    mg_init(&a); mg_init(&b);
    mg_append(&a, "hello world", 11);
    mg_push(&a, '!');
    s = ms_of(&a);                                   /* borrow: pointer+length, no copy, no ownership */
    sy_printf("len=%ld cap>=len=%d\n", ms_len(&s), a.cap >= a.len);
    sy_printf("at(6,5)=%d sub=%.*s\n", ms_at(&s, 6, 5, &sub), (int)sub.n, (const char *)sub.p);
    sy_printf("at(6,99)=%d (refused, sub untouched)\n", ms_at(&s, 6, 99, &sub));
    mg_pop(&a, &c);
    sy_printf("pop=%c len=%ld\n", c, a.len);
    mg_move(&b, &a);                                 /* Rust assignment: b owns the block, a is empty */
    sy_printf("after move a.len=%ld b.len=%ld a.data_null=%d\n", a.len, b.len, a.data == 0);
    mg_free(&a);                                     /* no-op on a moved-from buffer (CX-O-3) */
    mg_free(&b);
    sy_printf("after free b.len=%ld\n", b.len);
    return 0;
}
