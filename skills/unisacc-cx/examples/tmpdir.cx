/* tmpdir.cx -- a private scratch directory without mkdtemp, removed by exact paths only.
 *   sh ./unisacc.com skills/unisacc-cx/examples/tmpdir.cx
 * mkdir is atomic: -EEXIST means someone else owns that name, try the next; no pid in the name
 * (pids are reused and collide across sessions), no wildcard rm. */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use text.fmt

int main(void) {
    char dir[4096], f[4096]; int i, rc = -1; long seed = sy_now_ms();
    const char *base = sy_env_or("TMPDIR", "/tmp");
    for (i = 0; i < 100 && rc < 0; i++) {
        tx_snprintf(dir, sizeof dir, "%s/skill-cx-%lx-%d", base, seed, i);
        rc = sy_mkdir(dir, 0700);
        if (rc < 0 && rc != -17 /* EEXIST */) { sy_eprintf("mkdir: %s\n", sy_strerror(-rc)); return 1; }
    }
    if (rc < 0) return 1;
    if (cx_path_join(f, sizeof f, dir, "a.txt") || cx_write(f, "x\n", 2)) return 1;
    sy_printf("made dir=%d file=%d\n", sy_exists(dir), sy_exists(f));
    sy_unlink(f); sy_rmdir(dir);                     /* exact paths, no glob */
    sy_printf("cleaned dir=%d\n", sy_exists(dir));
    return 0;
}
